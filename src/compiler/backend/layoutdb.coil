; src/compiler/backend/layoutdb.coil — one source of truth for runtime type layout.

(module coil.compiler.layoutdb)
(import "coil.primitive" :as primitive)
(import "coil.alloc" :as alloc :use *)
(import "coil.result" :use *)
(import "coil.slice" :use *)
(import "coil.str" :use *)
(import "coil.arraylist" :use *)
(import "coil.hashmap" :use *)
(import "coil.io" :use *)
(import "coil.control" :use *)
(import "coil.try" :use *)
(import "coil.mem" :use [f64-bits bits->f64])
(import "coil.reader" :use [Diag])
(import "coil.compiler.ast" :use *)

; The consumers used to have four copies of these records and of every algorithm
; below. Backend state now owns one LayoutDb; ABI classification remains backend-
; specific, but ordinary size/alignment/offset questions cannot drift.
(defstruct LayoutStruct
  [(name (slice u8))
   (fields (ptr (ArrayList Field)))
   (layout Layout)
   (size i64)
   (align i64)
   (offsets (ArrayList i64))])

(defstruct LayoutSum
  [(name (slice u8))
   (variants (ptr (ArrayList Variant)))
   (words i64)])

;;; A direct-mapped memo in front of a name-keyed map, indexed by the address
;;; of the name's bytes: the same type name is looked up from the same AST
;;; string over and over. A hit is checked against the whole name, so a reused
;;; address can only miss.
(defstruct NameMemo [(key (slice u8)) (owner i64) (val i64)])

(const NAME-MEMO-SLOTS 1024)

(defn name-memo-new [(a (dyn Allocator))] (-> (ArrayList NameMemo))
  (let [(mut xs) (ArrayList::new [NameMemo] a)]
    (extend-zeroed! (mut xs) NAME-MEMO-SLOTS)
    xs))

(defn name-memo-slot [(xs (ptr (ArrayList NameMemo))) (name (slice u8))]
  (-> (ptr NameMemo))
  (let [p (primitive/cast i64 (data name))
        h (^ (^ (>> p 3) (>> p 12)) (len name))]
    (elem xs (& h (- NAME-MEMO-SLOTS 1)))))

(defn name-memo-hit? [(m (ptr NameMemo)) (name (slice u8))] (-> bool)
  (and (> (len name) 0) (= (.key m) name)))

(defstruct LayoutDb
  [(a (dyn Allocator))
   (owner (slice u8))
   (word_bytes i64)
   (sum_word_bytes i64)
   (structs (ArrayList LayoutStruct))
   (sums (ArrayList LayoutSum))
   (struct_idx (HashMap (slice u8) i64))
   (sum_idx (HashMap (slice u8) i64))
   (struct_memo (ArrayList NameMemo))
   (sum_memo (ArrayList NameMemo))
   ; field and variant names, with the struct or sum as `owner`
   (field_memo (ArrayList NameMemo))
   (variant_memo (ArrayList NameMemo))])

(defn layout-fail [(db (ptr LayoutDb)) (msg (slice u8))] (-> i64)
  (print-str (stderr) (.owner db))
  (print-str (stderr) ": ")
  (print-str (stderr) msg)
  (write-byte (stderr) (: 10 u8))
  (abort)
  0)

(defn layout-fail2 [(db (ptr LayoutDb)) (msg (slice u8)) (what (slice u8))]
  (-> i64)
  (print-str (stderr) (.owner db))
  (print-str (stderr) ": ")
  (print-str (stderr) msg)
  (print-str (stderr) what)
  (write-byte (stderr) (: 10 u8))
  (abort)
  0)

(defn layout-round-up [(n i64) (a i64)] (-> i64)
  (primitive/imul (primitive/idiv (primitive/iadd n (primitive/isub a 1)) a) a))

(defn layout-align8 [(n i64)] (-> i64)
  (layout-round-up n 8))

; Fixed vectors reserve a power-of-two allocation size. For example <3 x i32>
; has twelve payload bytes but occupies sixteen bytes in an array or aggregate.
; Using twelve for either size or alignment overlaps its next LLVM field.
(defn layout-vector-bytes [(payload i64)] (-> i64)
  (let [(mut bytes) 1]
    (loop (if (>= (load bytes) payload) (break) (set! bytes (* (load bytes) 2))))
    (load bytes)))

; The payload of a vector of N lanes of ELEM. A mask, `(vec bool N)`, packs its
; lanes one bit each, lane i at bit i%8 of byte i/8 (LLVM's <N x i1> in memory),
; on every backend.
(defn layout-vector-payload [(db (ptr LayoutDb)) (elem (ptr Type)) (n i64)]
  (-> i64)
  (match (load elem)
    (TBool [] (primitive/idiv (primitive/iadd n 7) 8))
    (_ (primitive/imul (size db elem) n))))

; A slice is emitted as LLVM's ordinary `{ptr, i64}` aggregate. Its alignment is
; therefore the greater of pointer and length alignment, and its size includes
; any tail padding required by that alignment. In particular wasm32 uses a
; 16-byte, 8-aligned slice rather than the unpadded 12-byte field sum.
(defn layout-slice-align [(db (ptr LayoutDb))] (-> i64)
  (if (> (.word_bytes db) 8) (.word_bytes db) 8))

(defn layout-slice-size [(db (ptr LayoutDb))] (-> i64)
  (layout-round-up (primitive/iadd (.word_bytes db) 8) (layout-slice-align db)))

;;; A backend that works a bit field in one 64-bit register reaches a field of
;;; a wider backing through the 64-bit window holding it; the parser keeps each
;;; such field inside one 64-bit word. The window is that word, moved down to
;;; end at the backing's last byte when the word runs past it (a u96's high
;;; word is its bytes 4..11). Returns the window's byte offset and rebases the
;;; field's low bit and the backing to the window; a backing of 64 bits or less
;;; is its own window.
(defn bits-window! [(lowp (ptr i64)) (backp (ptr i64))] (-> i64)
  (let [low (load lowp)
        back (load backp)]
    (if (<= back 64)
        0
        (let [word (primitive/imul (primitive/idiv low 64) 8)
              last (primitive/isub (primitive/idiv back 8) 8)
              wb (if (< word last) word last)]
          (store! lowp (primitive/isub low (primitive/imul wb 8)))
          (store! backp 64)
          wb))))

(defn layout-at [T] [(xs (ptr (ArrayList T))) (i i64)] (-> (ptr T))
  (primitive/index (load (field xs data)) i))

(impl LayoutDb
  ; Build all nominal entries first, then sum payload sizes, then struct layouts
  ; in dependency order. No receiver means construction is explicitly qualified.
  (new [(a (dyn Allocator))
        (mp (ptr Program))
        (owner (slice u8))
        (word-bytes i64)
        (sum-word-bytes i64)]
    (-> LayoutDb)
    (let [db (primitive/alloc-stack LayoutDb)]
      (set! (.a db) a)
      (set! (.owner db) owner)
      (set! (.word_bytes db) word-bytes)
      (set! (.sum_word_bytes db) sum-word-bytes)
      (set! (.structs db) (ArrayList::new [LayoutStruct] a))
      (set! (.sums db) (ArrayList::new [LayoutSum] a))
      (set! (.struct_idx db) (HashMap::new [(slice u8) i64] a (keyops)))
      (set! (.sum_idx db) (HashMap::new [(slice u8) i64] a (keyops)))
      (set! (.struct_memo db) (name-memo-new a))
      (set! (.sum_memo db) (name-memo-new a))
      (set! (.field_memo db) (name-memo-new a))
      (set! (.variant_memo db) (name-memo-new a))
      (let [ss (load (field mp structs))
            n (len (load ss))
            (mut i) 0]
        (loop (if (>= (load i) n)
                  (break)
                  (do
                    (let [sd (layout-at [StructDef] ss (load i))
                          e (primitive/alloc-stack LayoutStruct)]
                      (set! (.name e) (.name sd))
                      (set! (.fields e) (load (field sd fields)))
                      (set! (.layout e) (.layout sd))
                      (set! (.size e) 0)
                      (set! (.align e) 1)
                      (set! (.offsets e) (ArrayList::new [i64] a))
                      (set! (mut (.struct_idx db))
                            (.name e)
                            (load i))
                      (push! (mut (.structs db)) (load e)))
                    (set! i (primitive/iadd (load i) 1))))))
      (let [ss (load (field mp sums))
            n (len (load ss))
            (mut i) 0]
        (loop (if (>= (load i) n)
                  (break)
                  (do
                    (let [sd (layout-at [SumDef] ss (load i))
                          e (primitive/alloc-stack LayoutSum)]
                      (set! (.name e) (.name sd))
                      (set! (.variants e) (load (field sd variants)))
                      (set! (.words e) 0)
                      (set! (mut (.sum_idx db))
                            (.name e)
                            (load i))
                      (push! (mut (.sums db)) (load e)))
                    (set! i (primitive/iadd (load i) 1))))))
      (let [n (len (.sums db))
            (mut i) 0]
        (loop (if (>= (load i) n)
                  (break)
                  (do
                    (let [e (layout-at [LayoutSum] (field db sums) (load i))]
                      (set! (.words e)
                            (sum-words db (load (field e variants)))))
                    (set! i (primitive/iadd (load i) 1))))))
      (compute-struct-layouts! db)
      (load db)))

  (struct-index [(db (ptr LayoutDb)) (name (slice u8))]
    (-> i64)
    (let [m (name-memo-slot (field db struct_memo) name)]
      (if (name-memo-hit? m name)
          (.val m)
          (match (get (.struct_idx db) name)
            (Some [i] (do (set! (.key m) name) (set! (.val m) i) i))
            (None [] -1)))))

  (sum-index [(db (ptr LayoutDb)) (name (slice u8))]
    (-> i64)
    (let [m (name-memo-slot (field db sum_memo) name)]
      (if (name-memo-hit? m name)
          (.val m)
          (match (get (.sum_idx db) name)
            (Some [i] (do (set! (.key m) name) (set! (.val m) i) i))
            (None [] -1)))))

  (struct-at [(db (ptr LayoutDb)) (i i64)]
    (-> (ptr LayoutStruct))
    (layout-at [LayoutStruct] (field db structs) i))

  (sum-at [(db (ptr LayoutDb)) (i i64)]
    (-> (ptr LayoutSum))
    (layout-at [LayoutSum] (field db sums) i))

  (size [(db (ptr LayoutDb)) (t (ptr Type))]
    (-> i64)
    (match (load t)
      (TInt [bits _s]
            (cond (<= bits 8) 1
                  (<= bits 16) 2
                  (<= bits 32) 4
                  (<= bits 64) 8
                  ; i128 and u128 are 16 bytes, 16-aligned, as C's __int128
                  (<= bits 128) 16
                  :else
                    (layout-fail db
                                 "integers wider than 128 bits have no layout")))
      (TFloat [bits] (primitive/idiv bits 8))
      (TBool [] 1)
      (TVoid [] (layout-fail db "size on void"))
      (TConst [_]
              (layout-fail db
                           "generic constant argument reached runtime layout"))
      (TPtr [_] (.word_bytes db))
      (TRef [_ _] (.word_bytes db))
      (TFn [_ _ _] (.word_bytes db))
      (TNever [] (.word_bytes db))
      (TError [] (.word_bytes db))
      (TArray [elem n-extent]
              (let [n (extent-value n-extent)]
                (primitive/imul (size db elem) n)))
      (TSlice [_] (layout-slice-size db))
      (TVec [elem n]
            (layout-vector-bytes (layout-vector-payload db
                                                        elem
                                                        (extent-value n))))
      (TStruct [name]
               (let [si (struct-index db name)]
                 (if (>= si 0)
                     (.size (struct-at db si))
                     (let [su (sum-index db name)]
                       (if (>= su 0)
                           (primitive/imul (.sum_word_bytes db)
                                           (primitive/iadd 1
                                                           (.words (sum-at db
                                                                           su))))
                           (layout-fail2 db "unknown nominal type: " name))))))
      (TApp [_ _]
            (layout-fail db
                         "generic type reached layout after monomorphization"))
      (TCode [] (layout-fail db "Code reached runtime layout"))
      (TCodeBuilder []
                    (layout-fail db "CodeBuilder reached runtime layout"))
      (TExternRef [] (layout-fail db "externref reached native layout"))))

  (align [(db (ptr LayoutDb)) (t (ptr Type))]
    (-> i64)
    (match (load t)
      (TInt [bits _s]
            (cond (<= bits 8) 1
                  (<= bits 16) 2
                  (<= bits 32) 4
                  (<= bits 64) 8
                  (<= bits 128) 16
                  :else
                    (layout-fail db
                                 "integers wider than 128 bits have no layout")))
      (TFloat [bits] (primitive/idiv bits 8))
      (TBool [] 1)
      (TVoid [] (layout-fail db "align on void"))
      (TConst [_]
              (layout-fail db
                           "generic constant argument reached runtime layout"))
      (TPtr [_] (.word_bytes db))
      (TRef [_ _] (.word_bytes db))
      (TFn [_ _ _] (.word_bytes db))
      (TNever [] (.word_bytes db))
      (TError [] (.word_bytes db))
      (TArray [elem _n] (align db elem))
      (TSlice [_] (layout-slice-align db))
      (TVec [elem n]
            (layout-vector-bytes (layout-vector-payload db
                                                        elem
                                                        (extent-value n))))
      (TStruct [name]
               (let [si (struct-index db name)]
                 (if (>= si 0)
                     (.align (struct-at db si))
                     (if (>= (sum-index db name) 0)
                         (.sum_word_bytes db)
                         (layout-fail2 db "unknown nominal type: " name)))))
      (TApp [_ _]
            (layout-fail db
                         "generic type reached layout after monomorphization"))
      (TCode [] (layout-fail db "Code reached runtime layout"))
      (TCodeBuilder []
                    (layout-fail db "CodeBuilder reached runtime layout"))
      (TExternRef [] (layout-fail db "externref reached native layout"))))

  (field-offset [(db (ptr LayoutDb)) (si i64) (fi i64)]
    (-> i64)
    (get (.offsets (struct-at db si)) fi))

  (field-number [(db (ptr LayoutDb)) (si i64) (name (slice u8))]
    (-> i64)
    (let [m (name-memo-slot (field db field_memo) name)]
      (if (and (name-memo-hit? m name) (= (.owner m) si))
          (.val m)
          (let [fi (field-number-scan db si name)]
            (set! (.key m) name)
            (set! (.owner m) si)
            (set! (.val m) fi)
            fi))))

  (field-number-scan [(db (ptr LayoutDb)) (si i64) (name (slice u8))]
    (-> i64)
    (let [fs (load (field (struct-at db si) fields))
          n (len (load fs))
          (mut i) 0
          (mut found) -1]
      (loop (if (>= (load i) n)
                (break)
                (do
                  (when (= (load (field (layout-at [Field]
                                                   fs
                                                   (load i))
                                        name))
                           name)
                    (store! found (load i))
                    (break))
                  (set! i (primitive/iadd (load i) 1)))))
      (when (< (load found) 0)
        (layout-fail2 db "no such field: " name))
      (load found)))

  (variant-number [(db (ptr LayoutDb)) (su i64) (name (slice u8))]
    (-> i64)
    (let [m (name-memo-slot (field db variant_memo) name)]
      (if (and (name-memo-hit? m name) (= (.owner m) su))
          (.val m)
          (let [vi (variant-number-scan db su name)]
            (set! (.key m) name)
            (set! (.owner m) su)
            (set! (.val m) vi)
            vi))))

  (variant-number-scan [(db (ptr LayoutDb)) (su i64) (name (slice u8))]
    (-> i64)
    (let [vs (load (field (sum-at db su) variants))
          n (len (load vs))
          (mut i) 0
          (mut found) -1]
      (loop (if (>= (load i) n)
                (break)
                (do
                  (when (= (load (field (layout-at [Variant]
                                                   vs
                                                   (load i))
                                        name))
                           name)
                    (store! found (load i))
                    (break))
                  (set! i (primitive/iadd (load i) 1)))))
      (when (< (load found) 0)
        (layout-fail2 db "no such variant: " name))
      (load found)))

  ; Conservative SUM PAYLOAD sizing. Each field occupies an 8-byte-rounded
  ; region, matching LLVM's [words x i64] payload representation.
  (type-bytes [(db (ptr LayoutDb)) (t (ptr Type))]
    (-> i64)
    (match (load t)
      ; An integer occupies its storage size, not its bit width rounded to
      ; bytes: a u24 is four bytes, so (array u24 100) in a payload is 400.
      (TInt [_ _] (size db t))
      (TFloat [bits] (primitive/idiv bits 8))
      (TBool [] 1)
      (TConst [_]
              (layout-fail db
                           "generic constant argument reached runtime layout"))
      (TPtr [_] (.word_bytes db))
      (TRef [_ _] (.word_bytes db))
      (TFn [_ _ _] (.word_bytes db))
      (TNever [] (.word_bytes db))
      (TError [] (.word_bytes db))
      (TArray [elem n-extent]
              (let [n (extent-value n-extent)]
                (primitive/imul (type-bytes db elem) n)))
      (TSlice [_] (layout-slice-size db))
      (TVec [elem n]
            (layout-vector-bytes (layout-vector-payload db
                                                        elem
                                                        (extent-value n))))
      (TStruct [name]
               (let [si (struct-index db name)]
                 (if (>= si 0)
                     (let [e (struct-at db si)
                           fs (load (field e fields))
                           base (fields-bytes db fs)]
                       (match (.layout e)
                         ; fields at the offsets written, in at least :size bytes
                         (LExplicit [offs user-size _]
                                    (let [(mut most) base]
                                      (for [i 0 (len (load fs))]
                                        (let [end
                                                (primitive/iadd (get (load offs)
                                                                     i)
                                                                (type-bytes db
                                                                            (field (layout-at [Field]
                                                                                              fs
                                                                                              i)
                                                                                   ty)))]
                                          (when (> end (load most))
                                            (set! most end)
                                            0)))
                                      (match user-size
                                        (Some [n]
                                              (when (> n (load most))
                                                (set! most n)
                                                0))
                                        (None [] 0))
                                      (load most)))
                         (LBits [backing _]
                                (let [bytes (primitive/idiv backing 8)]
                                  (if (> bytes base) bytes base)))
                         (LAligned [forced] (layout-round-up base forced))
                         (_ base)))
                     (let [su (sum-index db name)]
                       (if (>= su 0)
                           (primitive/imul (.sum_word_bytes db)
                                           (primitive/iadd 1
                                                           (sum-words db
                                                                      (load (field (sum-at db
                                                                                           su)
                                                                                   variants)))))
                           (layout-fail2 db
                                         "type-bytes: unknown nominal "
                                         name))))))
      (TVoid [] (layout-fail db "type-bytes on void"))
      (TApp [_ _] (layout-fail db "type-bytes on generic type"))
      (TCode [] (layout-fail db "type-bytes on Code"))
      (TCodeBuilder [] (layout-fail db "type-bytes on CodeBuilder"))
      (TExternRef [] (layout-fail db "type-bytes on externref"))))

  (sum-words [(db (ptr LayoutDb)) (variants (ptr (ArrayList Variant)))]
    (-> i64)
    (let [(mut best) 0]
      (for [vi 0 (len (load variants))]
        (let [total
                (fields-bytes db
                              (load (field (layout-at [Variant] variants vi)
                                           fields)))]
          (when (> total (load best)) (store! best total) 0)))
      (primitive/idiv (primitive/iadd (load best)
                                      (primitive/isub (.sum_word_bytes db)
                                                      1))
                      (.sum_word_bytes db))))

  ; Conservative bytes for fields laid out one after another, as a variant's
  ; payload or a C struct places them: at least their natural layout, which
  ; each field's 8-byte-rounded region covers until a field is aligned past 8
  ; (an i128 after an i8 starts at 16).
  (fields-bytes [(db (ptr LayoutDb)) (fs (ptr (ArrayList Field)))]
    (-> i64)
    (let [(mut rounded) 0
          (mut off) 0
          (mut most-align) 1]
      (for [i 0 (len (load fs))]
        (let [ft (field (layout-at [Field] fs i) ty)
              bytes (type-bytes db ft)
              a (early-align db ft)]
          (set! rounded (primitive/iadd (load rounded) (layout-align8 bytes)))
          (set! off (primitive/iadd (layout-round-up (load off) a) bytes))
          (when (> a (load most-align)) (set! most-align a) 0)))
      (let [natural (layout-round-up (load off) (load most-align))]
        (if (> natural (load rounded)) natural (load rounded)))))

  ; A type's alignment before struct layouts are computed (they wait for the
  ; sums' payload sizes): what compute-one-struct! will decide.
  (early-align [(db (ptr LayoutDb)) (t (ptr Type))]
    (-> i64)
    (match (load t)
      (TArray [elem _] (early-align db elem))
      (TStruct [name]
               (let [si (struct-index db name)]
                 (if (< si 0)
                     (align db t)
                     (let [e (struct-at db si)
                           fs (load (field e fields))
                           (mut most) 1]
                       (for [i 0 (len (load fs))]
                         (let [a
                                 (early-align db
                                              (field (layout-at [Field] fs i)
                                                     ty))]
                           (when (> a (load most)) (set! most a) 0)))
                       (match (.layout e)
                         (LBits [backing _] (primitive/idiv backing 8))
                         (LPacked [] 1)
                         (LExplicit [_ _ user-align]
                                    (if (> user-align 0) user-align 1))
                         (LAligned [forced]
                                   (if (> forced (load most))
                                       forced
                                       (load most)))
                         (_ (load most)))))))
      (_ (align db t))))

  (natural-offset [(db (ptr LayoutDb)) (fs (ptr (ArrayList Field))) (fi i64)]
    (-> i64)
    (let [(mut i) 0
          (mut off) 0
          (mut result) -1]
      (loop (if (> (load i) fi)
                (break)
                (do
                  (let [ft
                          (field (layout-at [Field] fs (load i))
                                 ty)
                        a (align db ft)]
                    (set! off (layout-round-up (load off) a))
                    (when (= (load i) fi)
                      (store! result (load off))
                      0)
                    (set! off
                          (primitive/iadd (load off) (size db ft))))
                  (set! i (primitive/iadd (load i) 1)))))
      (load result)))

  (natural-layout! [(db (ptr LayoutDb)) (si i64)]
    (-> i64)
    (let [e (struct-at db si)
          fs (load (field e fields))
          nf (len (load fs))
          (mut off) 0
          (mut max-align) 1
          (mut i) 0]
      (loop (if (>= (load i) nf)
                (break)
                (do
                  (let [ft
                          (field (layout-at [Field] fs (load i))
                                 ty)
                        a
                          (match (load ft)
                            (TCode []
                                   (layout-fail2 db
                                                 "Code reached runtime layout in struct: "
                                                 (.name e)))
                            (TCodeBuilder []
                                          (layout-fail2 db
                                                        "CodeBuilder reached runtime layout in struct: "
                                                        (.name e)))
                            (_ (align db ft)))]
                    (when (> a (load max-align))
                      (store! max-align a))
                    (set! off (layout-round-up (load off) a))
                    (push! (mut (.offsets e)) (load off))
                    (set! off
                          (primitive/iadd (load off)
                                          (size db ft))))
                  (set! i (primitive/iadd (load i) 1)))))
      (set! (.align e) (load max-align))
      (set! (.size e)
            (layout-round-up (load off) (load max-align)))
      0))

  (compute-one-struct! [(db (ptr LayoutDb)) (si i64)]
    (-> i64)
    (let [e (struct-at db si)
          fs (load (field e fields))
          nf (len (load fs))]
      (match (.layout e)
        (LayoutWritten [_ _]
                       (panic "layout: struct '{}' is laid out before its :layout is decided"
                              (.name e)))
        (LBits [backing _offs]
               (do
                 (set! (.size e) (primitive/idiv backing 8))
                 (set! (.align e) (primitive/idiv backing 8))
                 0))
        (LExplicit [offs user-size user-align]
                   (do
                     (let [(mut max-end) 0
                           (mut i) 0]
                       (loop (if (>= (load i) nf)
                                 (break)
                                 (do
                                   (let [end
                                           (primitive/iadd (get (load offs)
                                                                (load i))
                                                           (size db
                                                                 (field (layout-at [Field]
                                                                                   fs
                                                                                   (load i))
                                                                        ty)))]
                                     (when (> end
                                              (load max-end))
                                       (store! max-end end)))
                                   (set! i
                                         (primitive/iadd (load i)
                                                         1)))))
                       (set! (.size e)
                             (match user-size
                               (Some [n]
                                     (if (> n (load max-end))
                                         n
                                         (load max-end)))
                               (None [] (load max-end))))
                       (set! (.align e)
                             (if (> user-align
                                    0)
                                 user-align
                                 1))
                       (let [(mut i) 0]
                         (loop (if (>= (load i) nf)
                                   (break)
                                   (do
                                     (push! (mut (.offsets e))
                                            (get (load offs)
                                                 (load i)))
                                     (set! i
                                           (primitive/iadd (load i)
                                                           1)))))))
                     0))
        (LPacked []
                 (do
                   (let [(mut off) 0
                         (mut i) 0]
                     (loop (if (>= (load i) nf)
                               (break)
                               (do
                                 (push! (mut (.offsets e))
                                        (load off))
                                 (set! off
                                       (primitive/iadd (load off)
                                                       (size db
                                                             (field (layout-at [Field]
                                                                               fs
                                                                               (load i))
                                                                    ty))))
                                 (set! i
                                       (primitive/iadd (load i)
                                                       1)))))
                     (set! (.size e) (load off))
                     (set! (.align e) 1))
                   0))
        (LAligned [forced]
                  (do
                    (natural-layout! db si)
                    (when (> forced (load (field e align)))
                      (store! (field e
                                     align)
                              forced))
                    (set! (.size e)
                          (layout-round-up (.size e)
                                           (.align e)))
                    0))
        (LC [] (natural-layout! db si)))))

  (type-ready? [(db (ptr LayoutDb)) (t (ptr Type)) (done (mut (ArrayList i64)))]
    (-> bool)
    (match (load t)
      (TStruct [name]
               (let [si (struct-index db name)]
                 (if (>= si 0)
                     (= (get (load done) si)
                        1)
                     true)))
      (TArray [elem _n] (type-ready? db elem (mut done)))
      (TVec [elem _n] (type-ready? db elem (mut done)))
      (_ true)))

  (struct-ready? [(db (ptr LayoutDb)) (si i64) (done (mut (ArrayList i64)))]
    (-> bool)
    (let [fs (load (field (struct-at db si) fields))
          nf (len (load fs))
          (mut i) 0
          (mut ready) true]
      (loop (if (>= (load i) nf)
                (break)
                (do
                  (when (not (type-ready? db
                                          (field (layout-at [Field]
                                                            fs
                                                            (load i))
                                                 ty)
                                          (mut done)))
                    (store! ready false))
                  (set! i (primitive/iadd (load i) 1)))))
      (load ready)))

  (compute-struct-layouts! [(db (ptr LayoutDb))]
    (-> i64)
    (let [n (len (.structs db))
          (mut done) (ArrayList::new [i64] (.a db))
          (mut i) 0]
      (loop (if (>= (load i) n)
                (break)
                (do
                  (push! (mut done) 0)
                  (set! i (primitive/iadd (load i) 1)))))
      (let [(mut pass) 0]
        (loop (if (>= (load pass) (primitive/iadd n 1))
                  (break)
                  (do
                    (let [(mut si) 0
                          (mut all-done) true]
                      (loop (if (>= (load si) n)
                                (break)
                                (do
                                  (when (= (get (load done)
                                                (load si))
                                           0)
                                    (if (struct-ready? db
                                                       (load si)
                                                       (mut done))
                                        (do
                                          (compute-one-struct! db
                                                               (load si))
                                          (set! (mut done)
                                                (load si)
                                                1))
                                        (store! all-done
                                                false)))
                                  (set! si
                                        (primitive/iadd (load si)
                                                        1)))))
                      (when (load all-done) (break)))
                    (set! pass
                          (primitive/iadd (load pass) 1))))))
      (let [(mut si) 0]
        (loop (if (>= (load si) n)
                  (break)
                  (do
                    (when (= (get (load done)
                                  (load si))
                             0)
                      (layout-fail2 db
                                    "struct layout cycle at "
                                    (load (field (struct-at db
                                                            (load si))
                                                 name))))
                    (set! si
                          (primitive/iadd (load si) 1))))))
      0)))

; ---- constant expressions ---------------------------------------------------
; A `def`'s value and a static assertion's condition are folded with no code run:
; literals, `sizeof` and the other questions about a type, numeric casts,
; arithmetic, comparisons and `if`. The operators they call are inlined into those
; forms first (assert_fold). Each backend, and the bytecode interpreter, folds them
; here with its own answers to the layout questions, so a value means the same
; wherever it is laid out, and answers for the target the program is built for.

;;; The layout questions a constant expression asks, answered for the target being
;;; compiled for.
(deftrait ConstLayout [Self]
  (const-size [(self (ptr Self)) (t (ptr Type))] (-> i64))
  (const-align [(self (ptr Self)) (t (ptr Type))] (-> i64))
  ;; The offset of the field FNAME of the struct T, or None when T is not a
  ;; struct with that field.
  (const-offset [(self (ptr Self)) (t (ptr Type)) (fname (slice u8))]
    (-> (Option i64))))

(impl ConstLayout LayoutDb
  (const-size [(self (ptr LayoutDb)) (t (ptr Type))] (-> i64)
    (size self t))
  (const-align [(self (ptr LayoutDb)) (t (ptr Type))] (-> i64)
    (align self t))
  (const-offset [(self (ptr LayoutDb)) (t (ptr Type)) (fname (slice u8))]
    (-> (Option i64))
    (match (load t)
      (TStruct [name]
               (let [si (struct-index self name)
                     fi (if (< si 0) -1 (field-number self si fname))]
                 (if (< fi 0) (None [i64]) (Some (field-offset self si fi)))))
      (_ (None [i64])))))

;;; A constant expression's value. An integer is the 64-bit pattern of its value
;;; held `bits` wide, sign- or zero-extended past that as `signed` says; `bits` is
;;; 0 for a literal, which takes the width of what it meets. A float is rounded to
;;; `bits` wide.
(defsum Folded
  (FoldedInt [(v i64) (bits i64) (signed bool)])
  (FoldedFloat [(v f64) (bits i64)]))

(defn const-error [(e (ptr Expr)) (msg (slice u8))] (-> Diag)
  (Diag :lo (.lo e) :hi (.hi e) :msg msg :source (.source e) :ctxt (.ctxt e)))

;;; The width an integer is computed at: its own, or 64 for a literal.
(defn const-width [(bits i64)] (-> i64)
  (if (= bits 0) 64 bits))

;;; X shifted right N bits, zeros shifted in.
(defn const-lshr [(x i64) (n i64)] (-> i64)
  (primitive/cast i64 (>> (primitive/cast u64 x) (primitive/cast u64 n))))

;;; The low W bits, all ones; W is at most 64.
(defn const-mask [(w i64)] (-> i64)
  (if (>= w 64) -1 (- (<< 1 w) 1)))

;;; V held BITS wide: its low bits, sign- or zero-extended.
(defn const-wrap [(v i64) (bits i64) (signed bool)] (-> i64)
  (if (or (= bits 0) (>= bits 64))
      v
      (let [low (& v (const-mask bits))]
        (if (and signed (!= (& low (<< 1 (- bits 1))) 0))
            (| low (^ (const-mask bits) -1))
            low))))

(defn const-int [(v i64) (bits i64) (signed bool)] (-> Folded)
  (FoldedInt :v (const-wrap v bits signed) :bits bits :signed signed))

(defn const-bool [(b bool)] (-> Folded)
  (FoldedInt :v (if b 1 0) :bits 1 :signed false))

;;; F rounded to a float BITS wide.
(defn const-round [(f f64) (bits i64)] (-> f64)
  (if (= bits 32) (cast f64 (cast f32 f)) f))

;;; The integer V, signed as SIGNED says, as a float BITS wide: rounded once, from
;;; the integer itself.
(defn const-int->float [(v i64) (signed bool) (bits i64)] (-> f64)
  (cond (and signed (= bits 32)) (cast f64 (cast f32 v))
        signed (cast f64 v)
        (= bits 32) (cast f64 (cast f32 (primitive/cast u64 v)))
        :else (cast f64 (primitive/cast u64 v))))

;;; 2 to the power N, exactly, as a float.
(defn const-pow2 [(n i64)] (-> f64)
  (let [(mut p) 1.0]
    (for [_ 0 n] (set! p (* (load p) 2.0)))
    (load p)))

;;; The float F as an integer BITS wide, toward zero, when its integer part fits.
(defn const-float->int [(e (ptr Expr)) (f f64) (bits i64) (signed bool)]
  (-> (Result Folded Diag))
  (let [w (const-width bits)
        lo (if signed (- 0.0 (const-pow2 (- w 1))) 0.0)
        hi (if signed (const-pow2 (- w 1)) (const-pow2 w))]
    ; NaN fails both comparisons
    (if (not (and (> f (- lo 1.0)) (< f hi)))
        (Err (const-error e
                          "this float does not fit the integer type it is cast to, so the cast has no value"))
        (Ok (const-int (if (and (not signed) (>= w 64))
                           (primitive/cast i64 (cast u64 f))
                           (cast i64 f))
                       bits
                       signed)))))

(defn const-cast [(e (ptr Expr)) (ty Type) (v Folded)]
  (-> (Result Folded Diag))
  (match ty
    (TInt [bits signed]
          (if (> bits 64)
              (Err (const-error e
                                "a constant expression is folded at most 64 bits wide; (comptime …) computes a wider value"))
              (match v
                (FoldedInt [x _ _] (Ok (const-int x bits signed)))
                (FoldedFloat [f _] (const-float->int e f bits signed)))))
    (TFloat [bits]
            (Ok (FoldedFloat :v
                              (match v
                                (FoldedInt [x _ s] (const-int->float x s bits))
                                (FoldedFloat [f _] (const-round f bits)))
                            :bits bits)))
    (_ (Err (const-error e "a cast to a type that is not a number is not a constant expression")))))

;;; Does the W-bit operation OP (15 add, 16 sub, 17 mul) on X and Y overflow?
(defn const-overflows [(op i64) (x i64) (y i64) (w i64) (signed bool)] (-> bool)
  (if (< w 64)
      ; X and Y are at most 32 bits wide, so the exact result fits 64
      (let [exact (cond (= op 15) (+ x y) (= op 16) (- x y) :else (* x y))]
        (!= (const-wrap exact w signed) exact))
      (cond (= op 15)
              (let [sum (primitive/iadd x y)]
                (if signed
                    (< (& (^ x sum) (^ y sum)) 0)
                    (< (primitive/cast u64 sum) (primitive/cast u64 x))))
            (= op 16)
              (if signed
                  (< (& (^ x y) (^ x (primitive/isub x y))) 0)
                  (< (primitive/cast u64 x) (primitive/cast u64 y)))
            (not signed)
              (and (!= x 0) (!= (primitive/udiv (primitive/imul x y) x) y))
            (= x 0) false
            ; MIN * -1 overflows the division that would check it
            (= x -1) (= y (<< 1 63))
            :else (!= (/ (primitive/imul x y) x) y))))

;;; The high 64 bits of the 128-bit product of X and Y.
(defn const-mulhi64 [(x i64) (y i64) (signed bool)] (-> i64)
  (let [m32 (const-mask 32)
        x0 (& x m32)
        x1 (const-lshr x 32)
        y0 (& y m32)
        y1 (const-lshr y 32)
        p00 (primitive/imul x0 y0)
        p01 (primitive/imul x0 y1)
        p10 (primitive/imul x1 y0)
        p11 (primitive/imul x1 y1)
        mid (primitive/iadd (primitive/iadd (const-lshr p00 32) (& p01 m32))
                            (& p10 m32))
        hi (primitive/iadd (primitive/iadd p11 (const-lshr p01 32))
                           (primitive/iadd (const-lshr p10 32)
                                           (const-lshr mid 32)))]
    (if signed
        (primitive/isub (primitive/isub hi (if (< x 0) y 0)) (if (< y 0) x 0))
        hi)))

(defn const-int-binary [(e (ptr Expr))
                        (op i64)
                        (x i64)
                        (xbits i64)
                        (xsigned bool)
                        (y i64)
                        (ybits i64)
                        (ysigned bool)] (-> (Result Folded Diag))
  (let [bits (if (!= xbits 0) xbits ybits)
        signed (cond (and (!= xbits 0) (!= ybits 0)) (and xsigned ysigned)
                     (!= xbits 0) xsigned
                     (!= ybits 0) ysigned
                     :else true)
        w (const-width bits)
        ux (& x (const-mask w))
        uy (& y (const-mask w))
        least (const-wrap (<< 1 (- w 1)) w true)
        divides (or (= op 3) (= op 4) (= op 5) (= op 6))]
    (cond (and divides (= y 0))
            (Err (const-error e "this constant expression divides by zero"))
          (and (or (= op 3) (= op 4)) signed (= x least) (= y -1))
            (Err (const-error e
                              "this constant expression divides the least value of its type by -1, which overflows"))
          (and (or (= op 10) (= op 11)) (or (< uy 0) (>= uy w)))
            (Err (const-error e
                              "this constant expression shifts by its type's width or more"))
          (and (= op 14) (= w 64))
            (Ok (const-int (const-mulhi64 x y signed) bits signed))
          (>= op 15)
            (Ok (const-bool (const-overflows op x y w signed)))
          :else
            (Ok (const-int (cond (= op 0) (primitive/iadd x y)
                                 (= op 1) (primitive/isub x y)
                                 (= op 2) (primitive/imul x y)
                                 ; `/` and `%` read their signedness off the type
                                 (= op 3) (if signed (/ x y) (primitive/udiv ux uy))
                                 (= op 4) (if signed (% x y) (primitive/urem ux uy))
                                 (= op 5) (primitive/udiv ux uy)
                                 (= op 6) (primitive/urem ux uy)
                                 (= op 7) (& x y)
                                 (= op 8) (| x y)
                                 (= op 9) (^ x y)
                                 (= op 10) (<< x uy)
                                 (= op 11) (if signed (>> x uy) (const-lshr ux uy))
                                 (= op 12)
                                   (let [r (% uy w)]
                                     (if (= r 0)
                                         ux
                                         (| (<< ux r) (const-lshr ux (- w r)))))
                                 (= op 13)
                                   (let [r (% uy w)]
                                     (if (= r 0)
                                         ux
                                         (| (const-lshr ux r) (<< ux (- w r)))))
                                 ; the high half of a narrower product, which 64 bits hold
                                 :else (>> (* x y) w))
                           bits
                           signed)))))

(defn const-float-binary [(e (ptr Expr)) (op i64) (x f64) (y f64) (bits i64)]
  (-> (Result Folded Diag))
  (if (> op 3)
      (Err (const-error e "this operation is not one on floats"))
      (Ok (FoldedFloat :v
                        (const-round (cond (= op 0) (+ x y)
                                           (= op 1) (- x y)
                                           (= op 2) (* x y)
                                           :else (/ x y))
                                     bits)
                      :bits bits))))

(defn const-binary [(e (ptr Expr)) (op i64) (x Folded) (y Folded)]
  (-> (Result Folded Diag))
  (match x
    (FoldedInt [xv xb xs]
              (match y
                (FoldedInt [yv yb ys] (const-int-binary e op xv xb xs yv yb ys))
                (FoldedFloat [_ _]
                            (Err (const-error e "this operation mixes an integer and a float")))))
    (FoldedFloat [xv xb]
                (match y
                  (FoldedFloat [yv yb] (const-float-binary e op xv yv (if (> xb yb) xb yb)))
                  (FoldedInt [_ _ _]
                            (Err (const-error e "this operation mixes an integer and a float")))))))

(defn const-compare [(e (ptr Expr)) (op i64) (x Folded) (y Folded)]
  (-> (Result Folded Diag))
  (match x
    (FoldedInt [xv xb xs]
              (match y
                (FoldedInt [yv yb ys]
                          (let [unsigned (or (and (!= xb 0) (not xs)) (and (!= yb 0) (not ys)))]
                            (Ok (const-bool (if unsigned
                                                (let [l (primitive/cast u64 xv)
                                                      r (primitive/cast u64 yv)]
                                                  (cond (= op 0) (< l r)
                                                        (= op 1) (<= l r)
                                                        (= op 2) (> l r)
                                                        (= op 3) (>= l r)
                                                        (= op 4) (= l r)
                                                        :else (!= l r)))
                                                (cond (= op 0) (< xv yv)
                                                      (= op 1) (<= xv yv)
                                                      (= op 2) (> xv yv)
                                                      (= op 3) (>= xv yv)
                                                      (= op 4) (= xv yv)
                                                      :else (!= xv yv)))))))
                (FoldedFloat [_ _]
                            (Err (const-error e "this comparison mixes an integer and a float")))))
    (FoldedFloat [xv _]
                (match y
                  (FoldedFloat [yv _]
                              (Ok (const-bool (cond (= op 0) (< xv yv)
                                                    (= op 1) (<= xv yv)
                                                    (= op 2) (> xv yv)
                                                    (= op 3) (>= xv yv)
                                                    (= op 4) (= xv yv)
                                                    :else (!= xv yv)))))
                  (FoldedInt [_ _ _]
                            (Err (const-error e "this comparison mixes an integer and a float")))))))

;;; OP (0 not, 1 clz, 2 ctz, 3 popcount, 4 bswap) of V, held BITS wide.
(defn const-unary [(e (ptr Expr)) (op i64) (v i64) (bits i64) (signed bool)]
  (-> (Result Folded Diag))
  (let [w (const-width bits)
        u (& v (const-mask w))]
    (cond (= op 0) (Ok (const-int (^ v -1) bits signed))
          (and (= op 4) (!= (% w 8) 0))
            (Err (const-error e "a byte swap needs a whole number of bytes"))
          :else
            (let [(mut n) 0]
              (cond (= op 1)
                      (block :done
                        (for [i 0 w]
                          (when (!= (& (const-lshr u (- (- w 1) i)) 1) 0)
                            (break :done 0))
                          (set! n (+ (load n) 1))))
                    (= op 2)
                      (block :done
                        (for [i 0 w]
                          (when (!= (& (const-lshr u i) 1) 0) (break :done 0))
                          (set! n (+ (load n) 1))))
                    (= op 3)
                      (for [i 0 w]
                        (set! n (+ (load n) (& (const-lshr u i) 1))))
                    :else
                      (for [i 0 (/ w 8)]
                        (set! n
                              (| (load n)
                                 (<< (& (const-lshr u (* i 8)) 255)
                                     (- (- w 8) (* i 8)))))))
              (Ok (const-int (load n) bits signed))))))

;;; The value of the constant expression E, its layout questions answered by
;;; LAYOUT.
(defn const-eval [(layout (dyn ConstLayout)) (e (ptr Expr))]
  (-> (Result Folded Diag))
  (try (match (.kind e)
         (EInt [v] (Ok (FoldedInt :v v :bits 0 :signed true)))
         (EBool [b] (Ok (const-bool b)))
         (EFloat [bits] (Ok (FoldedFloat :v (bits->f64 bits) :bits 64)))
         (ESizeOf [ty]
                  (let [(mut t) ty]
                    (Ok (FoldedInt :v (const-size layout (mut t)) :bits 64 :signed true))))
         (EAlignOf [ty]
                   (let [(mut t) ty]
                     (Ok (FoldedInt :v (const-align layout (mut t)) :bits 64 :signed true))))
         (EOffsetOf [ty fname]
                    (let [(mut t) ty]
                      (match (const-offset layout (mut t) fname)
                        (Some [off] (Ok (FoldedInt :v off :bits 64 :signed true)))
                        (None []
                              (Err (const-error e "offsetof names a field of a struct, and this is not one"))))))
         (ECast [ty inner] (const-cast e ty (try! (const-eval layout inner))))
         (EBin [op l r]
               (const-binary e op (try! (const-eval layout l)) (try! (const-eval layout r))))
         (ECmp [op l r]
               (const-compare e op (try! (const-eval layout l)) (try! (const-eval layout r))))
         (EIf [c t f]
              (match (try! (const-eval layout c))
                (FoldedInt [v _ _] (if (!= v 0) (const-eval layout t) (const-eval layout f)))
                (FoldedFloat [_ _]
                            (Err (const-error c "an if's condition is a bool, and this is a float")))))
         (EIntUnary [op inner]
                    (match (try! (const-eval layout inner))
                      (FoldedInt [v bits signed] (const-unary e op v bits signed))
                      (FoldedFloat [_ _]
                                  (Err (const-error e "this operation is one on integers, and this is a float")))))
         ; an argument an inlined operator reads, and its read
         (ESpillRef [inner] (const-eval layout inner))
         (ELoad [inner]
                (match (.kind inner)
                  (ESpillRef [value] (const-eval layout value))
                  (_ (Err (const-error e "a read of memory is not a constant expression")))))
         ; the branch a checked operation fails in
         (EDo [_]
              (Err (const-error e
                                "this constant expression fails a check when it is computed: an operation in it overflows, divides by zero or shifts too far")))
         (ECall [_ _ _]
                (Err (const-error e "a function call is not a constant expression; (comptime …) computes one")))
         (_ (Err (const-error e "this is not a constant expression; (comptime …) computes one"))))))

;;; Is E a static value's scalar that is computed (arithmetic, a comparison, an
;;; `if`, a question about a type, or a numeric cast of one), so that a writer lays
;;; out its folded value (`const-eval`)? Literals are written as they are. A wide
;;; literal, and a cast of one to an integer wider than 64 bits, is extended by the
;;; writer itself.
(defn const-computed? [(e (ptr Expr))] (-> bool)
  (match (.kind e)
    (EBin [_ _ _] true)
    (ECmp [_ _ _] true)
    (EIf [_ _ _] true)
    (EIntUnary [_ inner] (not (const-wide-literal? inner)))
    (ESizeOf [_] true)
    (EAlignOf [_] true)
    (EOffsetOf [_ _] true)
    (ECast [ty inner]
           (match ty
             (TInt [bits _] (and (<= bits 64) (not (const-wide-literal? inner))))
             (TFloat [_] true)
             (_ false)))
    (_ false)))

;;; Is E a literal wider than 64 bits, as the checker leaves one?
(defn const-wide-literal? [(e (ptr Expr))] (-> bool)
  (match (.kind e)
    (EWideInt [_ _ _ _ _] true)
    (ECast [ty inner]
           (match ty (TInt [_ _] (const-wide-literal? inner)) (_ false)))
    (EIntUnary [op inner] (and (= op 0) (const-wide-literal? inner)))
    (_ false)))

;;; V as a float.
(defn folded-f64 [(v Folded)] (-> f64)
  (match v
    (FoldedFloat [x _] x)
    (FoldedInt [x _ s] (const-int->float x s 64))))

;;; The bits a static of the scalar type T holds for V: a float type's IEEE bits,
;;; or an integer's value, which the writer truncates to T's width.
(defn folded-bits [(v Folded) (t (ptr Type))] (-> i64)
  (let [f (folded-f64 v)]
    (match (load t)
      (TFloat [bits]
              (if (= bits 32)
                  (let [(mut narrow) (cast f32 f)]
                    (cast i64 (load (cast (ptr u32) (mut narrow)))))
                  (f64-bits f)))
      (_ (match v (FoldedInt [x _ _] x) (FoldedFloat [x _] (f64-bits x)))))))

;;; Does V extend past its width with its sign bit (an integer of a signed type)?
(defn folded-signed? [(v Folded)] (-> bool)
  (match v (FoldedInt [_ _ s] s) (FoldedFloat [_ _] false)))

;;; Is V, a condition, true?
(defn folded-true? [(v Folded)] (-> bool)
  (match v (FoldedInt [x _ _] (!= x 0)) (FoldedFloat [x _] (!= x 0.0))))
