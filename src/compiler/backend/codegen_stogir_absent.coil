;;; The interface of coil.compiler.codegen_stogir in a compiler that has no
;;; Stogir backend: one hosted on a machine the Stogir library generates no
;;; code for (the wasm compiler). The library chooses its backend when the
;;; program embedding it is compiled and cannot be compiled for such a machine,
;;; so that compiler carries this module instead (stogir_select/host-pick).
;;;
;;; `available?` is false, and `--backend stogir` is refused with `unavailable`
;;; before any code generation starts (pipeline native-backend-target-ok?,
;;; codegen_tpde tl-build-mobj); no other backend is used in its place. Every other function has the signature of its namesake and
;;; stops the compiler with a clear message if it is ever reached.
(module coil.compiler.codegen_stogir_absent)
(import "coil.alloc" :use [Allocator malloc-allocator])
(import "coil.compiler.parser" :use [sconcat3])
(import "coil.compiler.metastate" :use [host-arch-str])
(import "coil.arraylist" :use [ArrayList])
(import "coil.cc" :as cc)
(import "tpde.cir" :as cir)
(import "tpde.asm" :as asm)
(import "coil.compiler.macho" :use [MTextData])

(extern terminate :as "exit" :cc (cc/C) [i32] (-> never))

;;; Why this compiler has no Stogir backend: one sentence, without a newline.
(defn unavailable [(a (dyn Allocator))] (-> (slice u8))
  (sconcat3 a
            "this compiler was built for "
            (host-arch-str)
            "; the stogir backend is available only in aarch64 and x86-64 builds"))

(defn absent [(what (slice u8))] (-> never)
  (eprintln "stogir: {}: {}" what (unavailable (malloc-allocator)))
  (terminate 1))

;;; Whether this compiler has a Stogir backend.
(defn available? [] (-> bool) false)

;;; No machine: nothing equals it.
(defn native-arch [] (-> (slice u8)) "")

(defn native-os [] (-> (slice u8)) "")

(defstruct Module [(unused i64)])
(defstruct Preparation [(unused i64)])
(defstruct Planning [(unused i64)])
(defstruct Emission [(unused i64)])
;; The field codegen_tpde sets on a pool it started.
(defstruct Pool [(helping bool)])
(defstruct Settings [(unused i64)])

(defn settings-read [] (-> Settings)
  (absent "settings-read"))

(defn generation-threads [] (-> i64)
  (absent "generation-threads"))

(defn verify-native! [(module (ptr Module)) (ta (ptr asm/Asm))] (-> void)
  (absent "verify-native!"))

(defn settings-key [(a (dyn Allocator)) (settings Settings)] (-> (slice u8))
  (absent "settings-key"))

(defn seal-native! [(module (ptr Module)) (ta (ptr asm/Asm))] (-> void)
  (absent "seal-native!"))

(defn release-emission-body! [(module (ptr Module)) (symbol u32)] (-> void)
  (absent "release-emission-body!"))

(defn release-emission-body-untimed! [(module (ptr Module)) (symbol u32)] (-> void)
  (absent "release-emission-body-untimed!"))

(defn reference-symbols! [(module (ptr Module)) (f (ptr cir/Func)) (symbol u32) (references (mut (ArrayList u32)))] (-> bool)
  (absent "reference-symbols!"))

(defn prepared-index [(module (ptr Module)) (f (ptr cir/Func)) (symbol u32)] (-> i64)
  (absent "prepared-index"))

(defn prepare-emission-body! [(module (ptr Module)) (f (ptr cir/Func)) (ta (ptr asm/Asm)) (symbol u32) (level i32)] (-> void)
  (absent "prepare-emission-body!"))

(defn preparation-submit! [(preparation (ptr Preparation)) (f (ptr cir/Func)) (symbol u32) (never bool) (always bool)] (-> void)
  (absent "preparation-submit!"))

(defn preparation-start [(module (ptr Module)) (ta (ptr asm/Asm)) (capacity i64) (threads i64)] (-> (ptr Preparation))
  (absent "preparation-start"))

(defn preparation-finish! [(preparation (ptr Preparation))] (-> void)
  (absent "preparation-finish!"))

(defn precompile-native-leaves! [(module (ptr Module)) (funcs (slice (ptr cir/Func))) (symbols (slice u32)) (ta (ptr asm/Asm)) (text-data (ptr (ArrayList MTextData))) (level i32) (threads i64)] (-> void)
  (absent "precompile-native-leaves!"))

(defn pool-submit! [(pool (ptr Pool)) (argument (ptr i8))] (-> i64)
  (absent "pool-submit!"))

(defn pool-start [(run (fnptr (cc/C) [(ptr i8)] (ptr i8))) (capacity i64) (threads i64)] (-> (ptr Pool))
  (absent "pool-start"))

(defn pool-finish! [(pool (ptr Pool))] (-> void)
  (absent "pool-finish!"))

(defn pool-await! [(pool (ptr Pool)) (index i64)] (-> void)
  (absent "pool-await!"))

(defn planning-start [(module (ptr Module)) (ta (ptr asm/Asm)) (level i32) (capacity i64) (threads i64)] (-> (ptr Planning))
  (absent "planning-start"))

(defn planning-run! [(planning (ptr Planning))] (-> void)
  (absent "planning-run!"))

(defn planning-finish! [(planning (ptr Planning))] (-> void)
  (absent "planning-finish!"))

(defn planning-commit! [(planning (ptr Planning)) (f (ptr cir/Func)) (symbol u32) (references (mut (ArrayList u32)))] (-> bool)
  (absent "planning-commit!"))

(defn planning-add! [(planning (ptr Planning)) (f (ptr cir/Func)) (symbol u32)] (-> void)
  (absent "planning-add!"))

(defn module-release-callees! [(module (ptr Module))] (-> void)
  (absent "module-release-callees!"))

(defn module-prepare! [(module (ptr Module)) (f (ptr cir/Func)) (ta (ptr asm/Asm)) (symbol u32) (never bool) (always bool)] (-> void)
  (absent "module-prepare!"))

(defn module-finish! [(module (ptr Module)) (threads i64)] (-> void)
  (absent "module-finish!"))

(defn module-create [(a (dyn Allocator)) (trace bool)] (-> Module)
  (absent "module-create"))

(defn emission-start! [(e (ptr Emission)) (threads i64)] (-> bool)
  (absent "emission-start!"))

(defn emission-ready? [(module (ptr Module)) (f (ptr cir/Func)) (symbol u32)] (-> bool)
  (absent "emission-ready?"))

(defn emission-merge! [(e (ptr Emission)) (index i64) (text-data (ptr (ArrayList MTextData)))] (-> void)
  (absent "emission-merge!"))

(defn emission-finish! [(e (ptr Emission))] (-> void)
  (absent "emission-finish!"))

(defn emission-create [(module (ptr Module)) (ta (ptr asm/Asm)) (level i32)] (-> (ptr Emission))
  (absent "emission-create"))

(defn emission-add! [(e (ptr Emission)) (f (ptr cir/Func)) (symbol u32)] (-> i64)
  (absent "emission-add!"))

(defn compile-with-module! [(f (ptr cir/Func)) (ta (ptr asm/Asm)) (symbol u32) (text-data (ptr (ArrayList MTextData))) (optimization i32) (module (ptr Module))] (-> void)
  (absent "compile-with-module!"))

(defn begin-native! [(module (ptr Module)) (ta (ptr asm/Asm))] (-> void)
  (absent "begin-native!"))
