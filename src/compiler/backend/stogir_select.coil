;;; Which Stogir adapter a compiler carries. The Stogir library generates code
;;; for the machine the program embedding it is compiled for, AArch64 or
;;; x86-64, and cannot be compiled for any other. A compiler hosted elsewhere
;;; (the wasm compiler) carries coil.compiler.codegen_stogir_absent, which has
;;; the same interface and refuses the backend.
(module coil.compiler.stogir_select)
(import "coil.primitive" :as primitive)

;;; `present` in a compiler built for a machine Stogir has a backend for,
;;; `absent` in any other. A macro: only the chosen form reaches the program.
(defn host-pick [(present Code) (absent Code)] (-> Code)
  (match (target-arch)
    (Aarch64 [] present)
    (X86_64 [] present)
    (_ absent)))
