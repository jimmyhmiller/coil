; src/compiler/backend/codegen_x64.coil — the native x86-64 backend (zero LLVM).
; Consumes the SAME monomorphized Program as codegen.coil and lowers it
; directly to machine code in an ELF object. codegen.coil (the LLVM backend)
; is the behavioral spec: every lowering decision here mirrors its semantics —
; sum layout {i32 tag, [words x i64] payload}, slice fat pointers {ptr,i64},
; divergence discipline, C ABI (SysV AMD64) at every call.
;
; This is the x86-64 sibling of codegen_a64.coil and deliberately keeps the
; same structure, function names and lowering decisions, so the two can be
; diffed against each other. What genuinely differs:
;   - registers: rbx = slot base (callee-saved, like x28 on arm64); rax/rcx/rdx/
;     rsi/rdi/r8-r11 are caller-saved scratch; xmm0-15 for floats.
;   - the ABI is SysV AMD64, not AAPCS64: eightbyte classification with an
;     INTEGER/SSE merge rule rather than HFA; >16-byte aggregates go in memory;
;     variadic calls must set al = the number of SSE registers used.
;   - x86 is two-address and memory-capable, so many arm64 load/op/store trios
;     collapse into one instruction — but this stays a naive slot machine for
;     the same reason arm64 does: precise DWARF and fast compiles.
;
; Code generation model (debug backend — compile speed over code quality):
;  - every value lives by-value in an rbp-anchored stack slot; rbx = slot base
;  - scratch registers are only live within one expression
;  - one calling convention everywhere: SysV AMD64, incl. the variadic al rule
;
; Frame layout (grows down):     [caller frame | incoming stack args]
;   rbp -> saved rbp                          <- push rbp; mov rsp,rbp
;          saved rbx                          <- push rbx
;          slots (rbx = base, off 0..slotbytes)
;   rsp -> outgoing stack args (outbytes)
; the prologue `sub rsp` and `lea rbx,[rsp+outbytes]` are back-patched once the
; body is emitted and slotbytes/outbytes are known. `alloc-stack-bytes` moves rsp
; further down at run time and hands out the bytes above the outgoing-args area,
; another back-patched `lea [rsp+outbytes]`; `leave` undoes it on return.
(module coil.compiler.codegen_x64)
(import "coil.compiler.native"
        :use
        [GLoop GStr GStatic AVal GScope GCEval mk-aval av-kind av-v av-ty
         gscope-nil gscope-put gscope-get g-last-component ty-is-float
         ty-float-bytes mk-gcev gcev-v gcev-u g-const-cmp slot-new! g-loop-index
         g-bits-info g-const-eval g-const-bin ty-int-info GNil GBind]
        :reexport)
(import "coil.compiler.native"
        :use
        [IrContext ir-lane-av ir-as-unsigned ir-force-unsigned-ty
         ir-icmp-scalar! ir-fcmp-scalar! ir-extend-op! ir-floatconv! ir-value
         ir-lit-vec! ir-value-adv! ir-parse-type]
        :reexport)
(import "coil.compiler.native" :use [ir-bind!] :reexport)
(import "coil.compiler.native" :as native)
(import "coil.compiler.text" :as text)
(import "coil.primitive" :as primitive)
(import "coil.compiler.ir_syntax" :as irs)
(import "coil.compiler.vector_scalar" :use *)
(import "coil.compiler.float_math" :use *)
(import "coil.alloc" :as alloc :use *)
(import "coil.result" :use *)
(import "coil.slice" :use *)
(import "coil.str" :use *)
(import "coil.arraylist" :use *)
(import "coil.hashmap" :use *)
(import "coil.io" :use *)
(import "coil.fs" :as fs)
(import "coil.control" :use *)
(import "coil.mem" :use *)
(import "coil.compiler.ast" :use *)
(import "coil.compiler.wide_ints" :use *)
(import "coil.compiler.parser" :use *)
(import "coil.compiler.layoutdb" :use *)
(import "coil.compiler.x64" :use *)
(import "coil.compiler.mtrace" :as mtr)
(import "coil.compiler.elf" :use *)
(import "coil.compiler.dwarf" :use *)
(import "coil.compiler.debuginfo" :use *)
(import "coil.cc" :as cc)

; file-writing externs; the object file is created with coil.fs's `create-file`
(extern cgx64.write [i32 (ptr i8) isize] (-> isize))  ; C write's fd is int (i32); matches io/cimport write (isize=i64 native, i32 wasm)

(extern cgx64.close [i32] (-> i32))  ; C `close(int?)` returns int, not long — matches ffi.close/cimport.close (return is discarded)

(extern cgx64.exit [i32] (-> void))

; ============================ state ==========================================
(defstruct GSig  ; one callable (function or extern)
  [(name (slice u8))
   (params (ptr (ArrayList Type)))
   (ret Type)
   (variadic bool)
   (symidx i64)
   (shim bool)
   (implsym i64)  ; :shim conventions (trampoline realization)
   (shimregs (ptr (ArrayList i64)))
   (shimret i64)
   ; the convention clobbers rbx or rbp, which hold this frame: its call sites
   ; save and restore both
   (shimsave bool)
   ; an inlined machine-code function's bytes, which its call sites hold in
   ; place of the call; empty for a call
   (inline_code (slice u8))
   ; true for an (extern … :cc (cc/C) …): calls to it cross the C boundary and so
   ; follow the SysV by-value aggregate rules. Coil-to-Coil calls do not — this
   ; backend passes aggregates by pointer internally, same as arm64.
   (isc bool)])

(defstruct Cga
  [(a (dyn Allocator))
   (layouts LayoutDb)
   (sigs (ArrayList GSig))  ; funcs + externs, keyed by name
   ; name -> its first entry in sigs; g-sig-push! keeps it
   (sig_index (HashMap (slice u8) i64))
   (obj EObj)
   (text i64)
   (constsec i64)
   (datasec i64)  ; section ordinals
   (asm XAsm)
   (strs (ArrayList GStr))  ; interned EStr/ECStr globals
   (statics (ArrayList GStatic))  ; runtime defs, each one data symbol
   (nglob i64)  ; g.N counter
   ; ---- per-function state ----
   (frame i64)  ; next free slot offset
   (env (ptr GScope))
   (loops (ArrayList GLoop))
   (terminated bool)
   (retty Type)
   (sretslot i64)  ; slot holding incoming x8, -1 = none
   (epilabel i64)
   (outbytes i64)  ; max outgoing stack-arg bytes of any call
   (outleas (ArrayList i64))  ; offsets of `lea r, [rsp+outbytes]` to patch
   (fnstart i64)  ; text offset of current function start
   ; ---- DWARF collection ----
   (dwtypes DbgTypes)
   (dwfns (ArrayList DwFn))
   (dwvars (ArrayList DwVar))
   (dwevs (ArrayList DwLineEv))
   (dwcursrc i64)
   (dwcurlo i64)
   (convs (ptr (ArrayList Convention)))
   ; ---- self-tail-call state (see emit-tail-self-call!) ----
   (selfname (slice u8))  ; name of the function being emitted
   (tailslots (ptr (ArrayList i64)))  ; its parameter slots, in order
   (tailtys (ptr (ArrayList Type)))  ; and their types
   (entrylabel i64)  ; label bound after parameter intake
   (tailok bool)])  ; the expression being emitted is in TAIL position

; hard error helper — no silent fallbacks anywhere in this backend.
(extern cgx.exit :as "exit" :cc (cc/C) [i32] (-> void))

;;; A program this backend cannot compile -- a feature it does not lower, or an
;;; invariant an earlier stage broke -- ends the compile with a diagnostic and exit
;;; status 1, as the LLVM backend's cg-fail does, never with an abort and a core dump.
(defn cgx-fail [(msg (slice u8))] (-> i64)
  (print-str (stderr) "error: x64 backend: ")
  (print-str (stderr) msg)
  (write-byte (stderr) (: 10 u8))
  (mtr/mtrace-mem-report-once!)
  (cgx.exit (: 1 i32))
  0)

(defn cgx-fail2 [(msg (slice u8)) (what (slice u8))] (-> i64)
  (cgx-fail (sconcat (alloc/malloc-allocator) msg what)))

(defstruct X64NativeErrors [])

(impl native/NativeErrors X64NativeErrors
  (native-fail [(self X64NativeErrors) (message (slice u8))] (-> i64)
    (cgx-fail message))
  (native-fail2 [(self X64NativeErrors) (message (slice u8)) (what (slice u8))]
    (-> i64)
    (cgx-fail2 message what)))

(impl native/ConstantErrors X64NativeErrors
  (native-user-fail [(self X64NativeErrors) (message (slice u8))] (-> i64)
    (g-user-fail message)))

; The view borrows the target's existing layout database, frame cursor and loop
; stack. Mutations therefore remain visible to the target emitter immediately.
(defn native-context [(g (ptr Cga))] (-> (native/NativeContext X64NativeErrors))
  (native/NativeContext
    :a (.a g)
    :layouts (field g layouts)
    :frame (field g frame)
    :loops (field g loops)
    :errors (zeroed X64NativeErrors)))

; ---- shared type layout ----------------------------------------------------
(defn g-struct-idx [(g (ptr Cga)) (name (slice u8))] (-> i64)
  (struct-index (field g layouts) name))

(defn g-sum-idx [(g (ptr Cga)) (name (slice u8))] (-> i64)
  (sum-index (field g layouts) name))

(defn g-sig-idx [(g (ptr Cga)) (name (slice u8))] (-> i64)
  (match (get (.sig_index g) name)
    (Some [index] index)
    (None [] -1)))

;;; Append E to sigs. A name already there keeps answering with its first entry.
(defn g-sig-push! [(g (ptr Cga)) (e GSig)] (-> i64)
  (when (< (g-sig-idx g (.name e)) 0)
    (set! (mut (.sig_index g)) (.name e) (len (.sigs g)))
    0)
  (push! (mut (.sigs g)) e)
  0)

(defn ty-align [(g (ptr Cga)) (t (ptr Type))] (-> i64)
  (align (field g layouts) t))

(defn ty-size [(g (ptr Cga)) (t (ptr Type))] (-> i64)
  (size (field g layouts) t))

(defn g-field-off [(g (ptr Cga)) (si i64) (fi i64)] (-> i64)
  (field-offset (field g layouts) si fi))

(defn g-field-idx [(g (ptr Cga)) (si i64) (name (slice u8))] (-> i64)
  (field-number (field g layouts) si name))

(defn g-type-bytes [(g (ptr Cga)) (t (ptr Type))] (-> i64)
  (type-bytes (field g layouts) t))

(defn g-sum-words-def [(g (ptr Cga)) (variants (ptr (ArrayList Variant)))]
  (-> i64)
  (sum-words (field g layouts) variants))

(defn g-natural-off [(g (ptr Cga)) (fields (ptr (ArrayList Field))) (fi i64)]
  (-> i64)
  (natural-offset (field g layouts) fields fi))

(defn g-variant-idx [(g (ptr Cga)) (su i64) (name (slice u8))] (-> i64)
  (variant-number (field g layouts) su name))

(defn g-register-types! [(g (ptr Cga)) (mp (ptr Program))] (-> i64)
  (set! (.layouts g) (LayoutDb::new (.a g) mp "cgx64" 8 8))
  0)

; ============================ program registration ===========================
; extern "io.write" links against C symbol "write" (last dot component; ELF adds no underscore).

; The assembly-level name of a Coil/C symbol. Mach-O prefixes every C symbol
; with an underscore; ELF does NOT — `main` is `main`, `write` is `write`. So
; unlike codegen_a64's g-mangle this is the identity, and it stays a named
; function purely so the two backends line up call-site for call-site.
(defn g-mangle [(g (ptr Cga)) (nm (slice u8))] (-> (slice u8))
  nm)

; the C symbol a function is exported under, or None. Mirrors codegen.coil's
; cg-export-find: an (export-c …) entry pins the function's public symbol. On this
; AAPCS64-native backend no thunk is needed — the function itself is emitted under
; this symbol with external linkage (see g-register-sigs!). ExportC.symbol is always
; Some by codegen time (check.coil fills the default bare-name symbol when :as is
; omitted).
; A name this unit publishes for other units to `declare` and link against.
(defn g-unit-export? [(mp (ptr Program)) (name (slice u8))] (-> bool)
  (let [ue (load (field mp unit_exports))
        n (len (load ue))
        (mut r) false]
    (for [i 0 n] (when (= (get (load ue) i) name) (set! r true) 0) 0)
    (load r)))

;;; The function a `fnptr-of` names: a function with a by-value C entry is pointed
;;; at through its thunk, whose `c` signature takes the structs by value as the
;;; pointer's type says.
(defn g-fnptr-target [(g (ptr Cga)) (name (slice u8))] (-> (slice u8))
  (let [thunk (export-c-thunk-name (.a g) name)]
    (if (>= (g-sig-idx g thunk) 0) thunk name)))

(defn g-export-c-sym [(mp (ptr Program)) (name (slice u8))]
  (-> (Option (slice u8)))
  (let [es (load (field mp exports))
        n (len (load es))
        (mut r) (None [(slice u8)])]
    (for [i 0 n]
      (when (= (.name (xal-at [ExportC] es i))
               name)
        (set! r (.symbol (xal-at [ExportC] es i)))
        (break)))
    (load r)))

; register every extern + func as a GSig with a Mach-O symbol.
(defn g-register-sigs! [(g (ptr Cga)) (mp (ptr Program))] (-> i64)
  (let [es (load (field mp externs))
        n (len (load es))
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (let [ed (xal-at [Extern] es (load i))
                      ; A symbol this program defines is not an undefined import: the
                      ; extern is bound to that definition once the functions are registered.
                      sym
                        (match (export-c-interposer mp (extern-link-name ed))
                          (Some [_] -1)
                          (None []
                                (eobj-add-sym! (mut (.obj g))
                                               (g-mangle g
                                                         (extern-link-name ed))
                                               0
                                               0
                                               true)))
                      (mut e) (zeroed GSig)]
                  (set! (.name e)
                        (.name ed))
                  (set! (.params e)
                        (load (field ed params)))
                  (set! (.ret e)
                        (.ret ed))
                  (set! (.variadic e)
                        (.variadic ed))
                  (set! (.symidx e)
                        sym)
                  (set! (.shim e)
                        false)
                  (set! (.implsym e)
                        -1)
                  (set! (.shimregs e)
                        (box-al [i64]
                                (.a g)
                                (ArrayList::new [i64]
                                                (.a g))))
                  (set! (.shimret e)
                        0)
                  (set! (.isc e)
                        true)
                  ; duplicate extern declarations across modules are expected; keep the first
                  (when (< (g-sig-idx g (.name ed))
                           0)
                    (g-sig-push! g e)))
                (set! i (primitive/iadd (load i) 1))))))
  (let [fs (load (field mp funcs))
        n (len (load fs))
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (let [fd (xal-at [Func] fs (load i))
                      expsym (g-export-c-sym mp (.name fd))
                      ; an exported function is emitted directly under its C symbol with
                      ; external linkage; otherwise the mangled Coil name, external only
                      ; for a program's main (a unit has no process entry) and for a
                      ; name this unit publishes for other units.
                      ext
                        (or (and (not (.unit_build mp)) (= (.name fd) "main"))
                            (match expsym (Some [s] true) (None [] false))
                            (g-unit-export? mp (.name fd)))
                      symname (match expsym (Some [s] s) (None [] (.name fd)))
                      ; A `declare`d function has no body here: another unit's
                      ; object defines it. Register it the way an extern is
                      ; registered, undefined and external, so a call becomes a
                      ; relocation the linker resolves.
                      sym
                        (if (.declared fd)
                            (eobj-add-sym! (mut (.obj g))
                                           (g-mangle g symname)
                                           0
                                           0
                                           true)
                            (eobj-add-sym! (mut (.obj g))
                                           (g-mangle g symname)
                                           (.text g)
                                           0
                                           ext))
                      (mut ptys) (ArrayList::new [Type] (.a g))
                      (mut e) (zeroed GSig)]
                  (let [ps (load (field fd params))
                        np (len (load ps))
                        (mut j) 0]
                    (loop (if (>= (load j) np)
                              (break)
                              (do
                                (push! (mut ptys)
                                       (.ty (xal-at [Param] ps (load j))))
                                (set! j (primitive/iadd (load j) 1))))))
                  (set! (.name e)
                        (.name fd))
                  (set! (.params e)
                        (box-al [Type] (.a g) (load ptys)))
                  (set! (.ret e)
                        (.ret fd))
                  (set! (.variadic e)
                        false)
                  (set! (.symidx e)
                        sym)
                  (set! (.shim e)
                        false)
                  (set! (.implsym e)
                        -1)
                  (set! (.shimregs e)
                        (box-al [i64]
                                (.a g)
                                (ArrayList::new [i64]
                                                (.a g))))
                  (set! (.shimret e)
                        0)
                  (set! (.isc e)
                        false)
                  ; a :shim-convention function is realized as <name>__impl + trampoline
                  (let [ci (g-conv-idx g (cc-identity (.cc fd)))]
                    (when (>= ci 0)
                      (match (.lowering (xal-at [Convention]
                                                (load (field g convs))
                                                ci))
                        (LShim []
                               (let [cv
                                       (xal-at [Convention]
                                               (load (field g convs))
                                               ci)
                                     (mut regs) (ArrayList::new [i64] (.a g))
                                     prs (load (field cv params))
                                     npr (len (load prs))]
                                 (for [j 0 npr]
                                   (push! (mut regs)
                                          (g-parse-xreg g
                                                        (get (load prs)
                                                             j))))
                                 (set! (.shim e)
                                       true)
                                 (set! (.shimregs e)
                                       (box-al [i64]
                                               (.a g)
                                               (load regs)))
                                 (set! (.shimret e)
                                       (match (.ret cv)
                                         (Some [r] (g-parse-xreg g r))
                                         (None [] 0)))
                                 (set! (.shimsave e)
                                       (g-shim-clobbers-frame? g cv))
                                 (set! (.inline_code e)
                                       (g-inline-machine-code g fd))
                                 ; machine code is the Coil-named symbol itself:
                                 ; it has no __impl and no trampoline
                                 (set! (.implsym e)
                                       (match (func-machine-code fd)
                                         (Some [_] -1)
                                         (None []
                                               (eobj-add-sym! (mut (.obj g))
                                                              (g-mangle g
                                                                        (text/format (.a g)
                                                                                     "{}__impl"
                                                                                     (.name fd)))
                                                              (.text g)
                                                              0
                                                              false))))
                                 0))
                        (LNative [_] 0)
                        (LReset [] 0)
                        (LowerWritten [_]
                                      (panic "codegen: convention '{}' was never resolved"
                                             (cc-identity (.cc fd)))))))
                  (g-sig-push! g e))
                (set! i (primitive/iadd (load i) 1))))))

  ; Bind each interposed extern to the function that defines its symbol. The
  ; extern keeps its own declared signature, as any extern does.
  (for i (range 0 (len (load (field mp externs))))
    (let [ed (xal-at [Extern] (load (field mp externs)) i)]
      (match (export-c-interposer mp (extern-link-name ed))
        (Some [fname]
              (let [ei (g-sig-idx g (.name ed))
                    fi (g-sig-idx g fname)]
                (when (or (< ei 0) (< fi 0))
                  (cgx-fail2 "extern bound to an exported function that has no signature: "
                             (.name ed)))
                (set! (.symidx (xal-at [GSig] (field g sigs) ei))
                      (.symidx (xal-at [GSig] (field g sigs) fi)))))
        (None [] 0))))
  0)

(defn g-conv-idx [(g (ptr Cga)) (nm (slice u8))] (-> i64)
  (let [cs (load (field g convs))
        n (len (load cs))
        (mut r) -1]
    (for [i 0 n]
      (when (= (.name (xal-at [Convention] cs i))
               nm)
        (set! r i)))
    (load r)))

; Whether a :shim convention lets its callee change rbx (the slot base) or rbp
; (the frame pointer), which its call sites then save around the call. The
; stack pointer cannot be clobbered: nothing could find the frame afterwards.
(defn g-shim-clobbers-frame? [(g (ptr Cga)) (cv (ptr Convention))] (-> bool)
  (let [cl (load (field cv clobber))
        (mut hit) false]
    (for j (range 0 (len (load cl)))
      (let [r (get (load cl) j)]
        (when (= r "rsp")
          (cgx-fail2 "a shim convention cannot clobber the stack pointer: " r))
        (when (or (= r "rbx") (= r "rbp")) (set! hit true))))
    (load hit)))

; The bytes FD's call sites hold in place of a call, for machine code its
; callers inline; else empty.
(defn g-inline-machine-code [(g (ptr Cga)) (fd (ptr Func))] (-> (slice u8))
  (match (func-machine-code fd)
    (Some [code]
          (if (func-machine-code-inlined? fd)
              (slice (load (.bytes code)))
              ""))
    (None [] "")))

; ":shim" conventions pin arguments to named machine registers. On x86-64 the
; names are the architectural ones ("rdi", "r10", ...), NOT arm64's xN — a
; convention written for arm64 must fail loudly here rather than silently pick
; a register with the same number, so an xN name is rejected outright. The
; checker emits the same "not a general-purpose register on the target
; architecture" diagnostic the LLVM backend does for the reverse case.
(defn g-parse-xreg [(g (ptr Cga)) (r (slice u8))] (-> i64)
  ; rbx is the slot base and rbp/rsp are the frame — pinning an argument
  ; to one of them would corrupt the frame mid-call.
  (case r
    "rax" 0
    "rcx" 1
    "rdx" 2
    "rsi" 6
    "rdi" 7
    "r8" 8
    "r9" 9
    "r10" 10
    "r11" 11
    "r12" 12
    "r13" 13
    "r14" 14
    "r15" 15
    (cond (or (= r "rbx") (= r "rbp") (= r "rsp"))
            (cgx-fail2 "shim register collides with backend-reserved registers: "
                       r)
          :else
            (cgx-fail2 "not a general-purpose register on the target architecture: "
                       r))))

; (elf.coil already provides eobj-set-sym! / eobj-set-sym-size!.)

; ============================ frame / slots ==================================
; Slots are rbx-relative. rbx is callee-saved, so it survives calls without any
; save/restore dance around each one, and it is set once in the prologue to
; rsp+outbytes — above the outgoing-argument area, so pushing call arguments
; can never disturb a live slot.

(defn slot-for-ty! [(g (ptr Cga)) (t (ptr Type))] (-> i64)
  (slot-new! (native-context g) (ty-size g t) (ty-align g t)))

; Scratch registers. x86 has far fewer than arm64, and several instructions
; pin specific ones (primitive/idiv wants rdx:rax, variable shifts want cl), so the
; scratch set is deliberately small, explicit, and never live across a call.
(defn x-scratch0 [] (-> i64)
  0)  ; rax — primary temp / return value

(defn x-scratch1 [] (-> i64)
  10)  ; r10 — secondary temp

(defn x-scratch2 [] (-> i64)
  11)  ; r11 — address temp

(defn x-slotbase [] (-> i64)
  3)  ; rbx

; lea reg, [rbx + off] — the address of a slot.
(defn emit-slot-addr! [(g (ptr Cga)) (reg i64) (off i64)] (-> i64)
  (x64-lea! (mut (.asm g)) reg (x-slotbase) off))

; load an int/ptr/bool slot into `reg`, extending per width+signedness.
; Unlike arm64 there is no reach limit: every displacement fits in disp32,
; so the offset never needs to be materialized into a register first.
(defn emit-load-int! [(g (ptr Cga))
                      (reg i64)
                      (base i64)
                      (off i64)
                      (bytes i64)
                      (signed bool)] (-> i64)
  (let [s (field g asm)]
    (cond (= bytes 1)
            (if signed
                (x64-movsx8-rm! (mut s) reg base off)
                (x64-movzx8-rm! (mut s) reg base off))
          (= bytes 2)
            (if signed
                (x64-movsx16-rm! (mut s) reg base off)
                (x64-movzx16-rm! (mut s) reg base off))
          (= bytes 4)
            ; the unsigned form is a plain 32-bit mov: writing a 32-bit register
            ; zero-extends to 64 bits for free.
            (if signed
                (x64-movsx32-rm! (mut s) reg base off)
                (x64-mov32-rm! (mut s) reg base off))
          :else (x64-mov-rm! (mut s) reg base off))))

; store `reg` into a slot, truncating to the slot width.
(defn emit-store-int! [(g (ptr Cga)) (reg i64) (base i64) (off i64) (bytes i64)]
  (-> i64)
  (let [s (field g asm)]
    (cond (= bytes 1) (x64-mov8-mr! (mut s) base off reg)
          (= bytes 2) (x64-mov16-mr! (mut s) base off reg)
          (= bytes 4) (x64-mov32-mr! (mut s) base off reg)
          :else (x64-mov-mr! (mut s) base off reg))))

; float slot <-> xmm register
(defn emit-load-fp! [(g (ptr Cga)) (xreg i64) (base i64) (off i64) (bytes i64)]
  (-> i64)
  (x64-movs-rm! (mut (.asm g)) (= bytes 8) xreg base off))

(defn emit-store-fp! [(g (ptr Cga)) (xreg i64) (base i64) (off i64) (bytes i64)]
  (-> i64)
  (x64-movs-mr! (mut (.asm g)) (= bytes 8) base off xreg))

; is a type an int-like scalar (lives in GPRs)? floats live in xmm.

(defn ty-is-scalar [(t (ptr Type))] (-> bool)
  (match (load t)
    (TInt [_ _] true)
    (TBool [] true)
    (TPtr [_] true)
    (TRef [_ _] true)
    (TFn [_ _ _] true)
    (TNever [] true)
    (TFloat [_] true)
    (TStruct [nm] false)
    (_ false)))

; load an AVal into GPR `reg` (int-like values only).
(defn av-to-x! [(g (ptr Cga)) (av AVal) (reg i64)] (-> i64)
  (let [k (av-kind av)
        (mut t) (av-ty av)]
    (if (or (= k 0) (= k 2))
        (x64-mov-imm! (mut (.asm g)) reg (av-v av))
        (let [(mut bytes) (zeroed i64)
              (mut signed) (zeroed bool)]
          (ty-int-info (mut t) (mut bytes) (mut signed))
          (if (ty-is-float (mut t))
              (emit-load-int! g
                              reg
                              (x-slotbase)
                              (av-v av)
                              (ty-float-bytes (mut t))
                              false)
              (emit-load-int! g reg (x-slotbase) (av-v av) bytes signed))))))

; load an AVal into xmm reg `xreg` (float values only).
(defn av-to-d! [(g (ptr Cga)) (av AVal) (xreg i64)] (-> i64)
  (let [k (av-kind av)
        (mut t) (av-ty av)]
    (if (= k 2)
        ; a float immediate is carried as raw bits: materialize into a GPR and
        ; move the bit pattern across, never through a conversion.
        (do
          (x64-mov-imm! (mut (.asm g)) (x-scratch1) (av-v av))
          (x64-movq-xr! (mut (.asm g)) xreg (x-scratch1))
          0)
        (if (= k 1)
            (emit-load-fp! g
                           xreg
                           (x-slotbase)
                           (av-v av)
                           (ty-float-bytes (mut t)))
            (cgx-fail "av-to-d!: int immediate where float expected")))))

; materialize an AVal into a slot; returns the slot offset.
(defn av-slot! [(g (ptr Cga)) (av AVal)] (-> i64)
  (if (= (av-kind av) 1)
      (av-v av)
      (let [(mut t) (av-ty av)]
        (let [off
                (slot-for-ty! g
                              (mut t))
              size
                (ty-size g
                         (mut t))]
          ; An immediate is an i64. A wider slot (the i128 llvm-ir marker type)
          ; gets the value in its low word and the value's sign extension in
          ; every byte above it, so no byte of the slot is left uninitialized.
          (x64-mov-imm! (mut (.asm g)) (x-scratch0) (av-v av))
          (emit-store-int! g
                           (x-scratch0)
                           (x-slotbase)
                           off
                           (if (> size 8) 8 size))
          (when (> size 8)
            (x64-mov-imm! (mut (.asm g)) (x-scratch0) (if (< (av-v av) 0) -1 0))
            (let [(mut at) 8]
              (while (< at size)
                (let [chunk
                        (cond (>= (- size at) 8) 8
                              (>= (- size at) 4) 4
                              (>= (- size at) 2) 2
                              :else 1)]
                  (emit-store-int! g (x-scratch0) (x-slotbase) (+ off at) chunk)
                  (set! at (+ at chunk))))))
          off))))

; ============================ copies =========================================
; copy `size` bytes between slots (rbx-relative), through a scratch register.
; Unrolled words for small sizes, a byte loop for huge ones — same shape as the
; arm64 backend, so aggregate copies stay comparable between the two.
(defn emit-copy! [(g (ptr Cga)) (dst i64) (src i64) (size i64)] (-> i64)
  (let [s (field g asm)]
    (if (<= size 256)
        (let [(mut k) 0]
          (loop (if (> (primitive/iadd (load k) 8) size)
                    (break)
                    (do
                      (emit-load-int! g
                                      (x-scratch0)
                                      (x-slotbase)
                                      (primitive/iadd src (load k))
                                      8
                                      false)
                      (emit-store-int! g
                                       (x-scratch0)
                                       (x-slotbase)
                                       (primitive/iadd dst (load k))
                                       8)
                      (set! k (primitive/iadd (load k) 8)))))
          (when (<= (primitive/iadd (load k) 4) size)
            (emit-load-int! g
                            (x-scratch0)
                            (x-slotbase)
                            (primitive/iadd src (load k))
                            4
                            false)
            (emit-store-int! g
                             (x-scratch0)
                             (x-slotbase)
                             (primitive/iadd dst (load k))
                             4)
            (set! k (primitive/iadd (load k) 4))
            0)
          (when (<= (primitive/iadd (load k) 2) size)
            (emit-load-int! g
                            (x-scratch0)
                            (x-slotbase)
                            (primitive/iadd src (load k))
                            2
                            false)
            (emit-store-int! g
                             (x-scratch0)
                             (x-slotbase)
                             (primitive/iadd dst (load k))
                             2)
            (set! k (primitive/iadd (load k) 2))
            0)
          (when (<= (primitive/iadd (load k) 1) size)
            (emit-load-int! g
                            (x-scratch0)
                            (x-slotbase)
                            (primitive/iadd src (load k))
                            1
                            false)
            (emit-store-int! g
                             (x-scratch0)
                             (x-slotbase)
                             (primitive/iadd dst (load k))
                             1)
            (set! k (primitive/iadd (load k) 1))
            0)
          0)
        ; big: byte loop. r10 = index, r11 = src addr, rax = scratch byte.
        (do
          (emit-slot-addr! g (x-scratch2) src)
          (x64-mov-imm! (mut s) (x-scratch1) 0)
          (let [ltop (x64-new-label (mut s))
                lend (x64-new-label (mut s))]
            (x64-bind-label! (mut s) ltop)
            (x64-cmp-ri! (mut s) (x-scratch1) size)
            (x64-jcc-label! (mut s) (x64-cc-ge) lend)
            ; rax = src[i]; then store to dst[i] — both addresses are formed by
            ; adding the running index into a scratch address register.
            (x64-mov-rr! (mut s) (x-scratch0) (x-scratch2))
            (x64-add-rr! (mut s) (x-scratch0) (x-scratch1))
            (x64-movzx8-rm! (mut s) (x-scratch0) (x-scratch0) 0)
            (emit-slot-addr! g 2 dst)  ; rdx = &dst
            (x64-add-rr! (mut s) 2 (x-scratch1))
            (x64-mov8-mr! (mut s) 2 0 (x-scratch0))
            (x64-add-ri! (mut s) (x-scratch1) 1)
            (x64-jmp-label! (mut s) ltop)
            (x64-bind-label! (mut s) lend))
          0))))

; copy from a slot to the memory pointed at by `dstreg`.
; The value scratch must not BE `dstreg`: the first load would overwrite the
; destination pointer and every subsequent store would go through garbage
; (this produced a literal `mov %rax,(%rax)`). When the caller hands us the
; primary scratch, move the pointer somewhere safe first.
(defn emit-copy-to-mem! [(g (ptr Cga)) (dstreg0 i64) (src i64) (size i64)]
  (-> i64)
  (let [s (field g asm)
        dstreg
          (if (= dstreg0 (x-scratch0))
              (do (x64-mov-rr! (mut s) (x-scratch2) dstreg0) (x-scratch2))
              dstreg0)
        (mut k) 0]
    (loop (if (> (primitive/iadd (load k) 8) size)
              (break)
              (do
                (emit-load-int! g
                                (x-scratch0)
                                (x-slotbase)
                                (primitive/iadd src (load k))
                                8
                                false)
                (x64-mov-mr! (mut s) dstreg (load k) (x-scratch0))
                (set! k (primitive/iadd (load k) 8)))))
    (when (<= (primitive/iadd (load k) 4) size)
      (emit-load-int! g
                      (x-scratch0)
                      (x-slotbase)
                      (primitive/iadd src (load k))
                      4
                      false)
      (x64-mov32-mr! (mut s) dstreg (load k) (x-scratch0))
      (set! k (primitive/iadd (load k) 4))
      0)
    (when (<= (primitive/iadd (load k) 2) size)
      (emit-load-int! g
                      (x-scratch0)
                      (x-slotbase)
                      (primitive/iadd src (load k))
                      2
                      false)
      (x64-mov16-mr! (mut s) dstreg (load k) (x-scratch0))
      (set! k (primitive/iadd (load k) 2))
      0)
    (when (<= (primitive/iadd (load k) 1) size)
      (emit-load-int! g
                      (x-scratch0)
                      (x-slotbase)
                      (primitive/iadd src (load k))
                      1
                      false)
      (x64-mov8-mr! (mut s) dstreg (load k) (x-scratch0))
      (set! k (primitive/iadd (load k) 1))
      0)
    0))

; copy from the memory pointed at by `srcreg` into a slot. Same aliasing hazard
; as emit-copy-to-mem!: the loaded value would clobber the source pointer.
(defn emit-copy-from-mem! [(g (ptr Cga)) (dst i64) (srcreg0 i64) (size i64)]
  (-> i64)
  (let [s (field g asm)
        srcreg
          (if (= srcreg0 (x-scratch0))
              (do (x64-mov-rr! (mut s) (x-scratch2) srcreg0) (x-scratch2))
              srcreg0)
        (mut k) 0]
    (loop (if (> (primitive/iadd (load k) 8) size)
              (break)
              (do
                (x64-mov-rm! (mut s) (x-scratch0) srcreg (load k))
                (emit-store-int! g
                                 (x-scratch0)
                                 (x-slotbase)
                                 (primitive/iadd dst (load k))
                                 8)
                (set! k (primitive/iadd (load k) 8)))))
    (when (<= (primitive/iadd (load k) 4) size)
      (x64-mov32-rm! (mut s) (x-scratch0) srcreg (load k))
      (emit-store-int! g
                       (x-scratch0)
                       (x-slotbase)
                       (primitive/iadd dst (load k))
                       4)
      (set! k (primitive/iadd (load k) 4))
      0)
    (when (<= (primitive/iadd (load k) 2) size)
      (x64-movzx16-rm! (mut s) (x-scratch0) srcreg (load k))
      (emit-store-int! g
                       (x-scratch0)
                       (x-slotbase)
                       (primitive/iadd dst (load k))
                       2)
      (set! k (primitive/iadd (load k) 2))
      0)
    (when (<= (primitive/iadd (load k) 1) size)
      (x64-movzx8-rm! (mut s) (x-scratch0) srcreg (load k))
      (emit-store-int! g
                       (x-scratch0)
                       (x-slotbase)
                       (primitive/iadd dst (load k))
                       1)
      (set! k (primitive/iadd (load k) 1))
      0)
    0))

; ============================ zeroing ========================================
(defn emit-zero! [(g (ptr Cga)) (dst i64) (size i64)] (-> i64)
  (let [s (field g asm)]
    (x64-mov-imm! (mut s) (x-scratch0) 0)
    (if (<= size 256)
        (let [(mut k) 0]
          (loop (if (> (primitive/iadd (load k) 8) size)
                    (break)
                    (do
                      (emit-store-int! g
                                       (x-scratch0)
                                       (x-slotbase)
                                       (primitive/iadd dst (load k))
                                       8)
                      (set! k (primitive/iadd (load k) 8)))))
          (when (<= (primitive/iadd (load k) 4) size)
            (emit-store-int! g
                             (x-scratch0)
                             (x-slotbase)
                             (primitive/iadd dst (load k))
                             4)
            (set! k (primitive/iadd (load k) 4))
            0)
          (when (<= (primitive/iadd (load k) 2) size)
            (emit-store-int! g
                             (x-scratch0)
                             (x-slotbase)
                             (primitive/iadd dst (load k))
                             2)
            (set! k (primitive/iadd (load k) 2))
            0)
          (when (<= (primitive/iadd (load k) 1) size)
            (emit-store-int! g
                             (x-scratch0)
                             (x-slotbase)
                             (primitive/iadd dst (load k))
                             1)
            (set! k (primitive/iadd (load k) 1))
            0)
          0)
        (do
          (emit-slot-addr! g (x-scratch2) dst)
          (x64-mov-imm! (mut s) (x-scratch1) 0)
          (let [ltop (x64-new-label (mut s))
                lend (x64-new-label (mut s))]
            (x64-bind-label! (mut s) ltop)
            (x64-cmp-ri! (mut s) (x-scratch1) size)
            (x64-jcc-label! (mut s) (x64-cc-ge) lend)
            (x64-mov-rr! (mut s) 2 (x-scratch2))
            (x64-add-rr! (mut s) 2 (x-scratch1))
            (x64-mov8-mr! (mut s) 2 0 (x-scratch0))
            (x64-add-ri! (mut s) (x-scratch1) 1)
            (x64-jmp-label! (mut s) ltop)
            (x64-bind-label! (mut s) lend))
          0))))

; ============================ ABI classification =============================
; SysV AMD64. Classes here are chosen to mirror the arm64 backend's AbiInfo
; shape so the call/param code stays structurally identical, but the MEANING is
; the SysV one:
;   0 = int-like scalar (one GPR)
;   1 = float scalar (one SSE reg)
;   2 = aggregate <= 8 bytes  -> ONE register, whose class is eb0
;   3 = aggregate <= 16 bytes -> TWO registers, classes eb0 and eb1
;   4 = aggregate > 16 bytes  -> MEMORY (passed on the stack; returned via a
;                                hidden pointer in rdi, returned in rax)
; eb0/eb1 are the per-eightbyte classes: 1 = INTEGER, 2 = SSE.
;
; There is no HFA rule on x86-64 (that is an AAPCS64 concept). What replaces it
; is the eightbyte merge: each byte of the aggregate gets a class, bytes are
; merged into 8-byte groups, and INTEGER dominates SSE within a group. So
; `struct {float a,b;}` is ONE eightbyte of class SSE (passed in one xmm as two
; packed floats), while `struct {float a; long b;}` is two eightbytes, SSE then
; INTEGER. Getting this wrong is invisible on simple tests and catastrophic on
; real C interop, which is why the adversarial ABI test exists.
(defstruct AbiInfo [(cls i64) (eb0 i64) (eb1 i64)])

(defn abi-cls [(x AbiInfo)] (-> i64)
  (let [(mut p) (: x AbiInfo)] (.cls p)))

(defn abi-eb0 [(x AbiInfo)] (-> i64)
  (let [(mut p) (: x AbiInfo)] (.eb0 p)))

(defn abi-eb1 [(x AbiInfo)] (-> i64)
  (let [(mut p) (: x AbiInfo)] (.eb1 p)))

(defn mk-abi-scalar [] (-> AbiInfo)
  (AbiInfo
    :cls 0
    :eb0 0
    :eb1 0))

; The SysV class merge for two classes covering the same byte:
; INTEGER (1) dominates SSE (2) dominates NONE (0).
(defn abi-merge [(x i64) (y i64)] (-> i64)
  (cond (or (= x 1) (= y 1)) 1
        (or (= x 2) (= y 2)) 2
        :else 0))

; Walk a type and paint each byte it covers with its class, into `bytes`.
; `base` is the type's byte offset within the enclosing aggregate. This is the
; faithful port of codegen.coil's abi-flatten-type, but driven by the native
; layout tables here rather than by LLVM's.
(defn g-abi-paint! [(g (ptr Cga))
                    (t (ptr Type))
                    (base i64)
                    (bytes (mut (ArrayList i64)))] (-> i64)
  (let [n (len (load bytes))]
    (match (load t)
      (TFloat [bits]
              (let [sz (/ bits 8)]
                (for [i 0 sz]
                  (when (< (primitive/iadd base i) n)
                    (set! (mut bytes)
                          (primitive/iadd base i)
                          (abi-merge (get (load bytes)
                                          (primitive/iadd base
                                                          i))
                                     2))
                    0))
                0))
      (TArray [elem cnt-extent]
              (let [cnt (extent-value cnt-extent)]
                (let [esz (ty-size g elem)]
                  (for [i 0 cnt]
                    (g-abi-paint! g
                                  elem
                                  (primitive/iadd base
                                                  (primitive/imul i
                                                                  esz))
                                  (mut bytes)))
                  0)))
      (TStruct [nm]
               (let [si (g-struct-idx g nm)]
                 (if (>= si 0)
                     (let [fs
                             (load (field (struct-at (field g layouts) si)
                                          fields))
                           nf (len (load fs))]
                       (for [i 0 nf]
                         (g-abi-paint! g
                                       (field (xal-at [Field]
                                                      fs
                                                      i)
                                              ty)
                                       (primitive/iadd base
                                                       (g-field-off g
                                                                    si
                                                                    i))
                                       (mut bytes)))
                       0)
                     ; a sum: tag + payload words, all INTEGER
                     (let [sz (ty-size g t)]
                       (for [i 0 sz]
                         (when (< (primitive/iadd base i) n)
                           (set! (mut bytes)
                                 (primitive/iadd base i)
                                 (abi-merge (get (load bytes)
                                                 (primitive/iadd base
                                                                 i))
                                            1))
                           0))
                       0))))
      ; everything else (ints, bools, pointers, refs, fnptrs, slices) is INTEGER
      (_ (let [sz (ty-size g t)]
           (for [i 0 sz]
             (when (< (primitive/iadd base i) n)
               (set! (mut bytes)
                     (primitive/iadd base i)
                     (abi-merge (get (load bytes)
                                     (primitive/iadd base i))
                                1))
               0))
           0)))))

; class of one eightbyte: merge every painted byte in [lo, lo+8).
(defn g-abi-eightbyte [(bytes (ptr (ArrayList i64))) (lo i64) (size i64)]
  (-> i64)
  (let [(mut i) 0
        (mut c) 0]
    (loop (if (or (>= (load i) 8)
                  (>= (primitive/iadd lo (load i)) size))
              (break)
              (do
                (set! c
                      (abi-merge (load c)
                                 (get (load bytes) (primitive/iadd lo (load i)))))
                (set! i (primitive/iadd (load i) 1)))))
    ; an eightbyte with no painted bytes still occupies a register; treat it as
    ; INTEGER so padding-only tails never silently vanish from the arg list.
    (if (= (load c) 0) 1 (load c))))

(defn g-abi-info [(g (ptr Cga)) (t (ptr Type))] (-> AbiInfo)
  (let [(mut r) (zeroed AbiInfo)]
    (set! (.eb0 r)
          0)
    (set! (.eb1 r)
          0)
    (if (ty-is-scalar t)
        (do
          (set! (.cls r)
                (if (ty-is-float t) 1 0))
          0)
        (let [sz (ty-size g t)]
          (if (> sz 16)
              (do
                (set! (.cls r)
                      4)
                0)
              (let [a (.a g)
                    (mut bytes) (ArrayList::new [i64] a)]
                (for [i 0 sz]
                  (push! (mut bytes) 0))
                (g-abi-paint! g t 0 (mut bytes))
                (set! (.eb0 r)
                      (g-abi-eightbyte (mut bytes) 0 sz))
                (if (<= sz 8)
                    ; an empty struct is class 6: C passes and returns nothing for it
                    (do
                      (set! (.cls r)
                            (if (= sz 0) 6 2))
                      0)
                    (do
                      (set! (.cls r)
                            3)
                      (set! (.eb1 r)
                            (g-abi-eightbyte (mut bytes) 8 sz))
                      0))))))
    r))

; The SysV argument registers, in order.
(defn x-argreg [(i i64)] (-> i64)
  (cond (= i 0) 7  ; rdi
        (= i 1) 6  ; rsi
        (= i 2) 2  ; rdx
        (= i 3) 1  ; rcx
        (= i 4) 8  ; r8
        (= i 5) 9  ; r9
        :else (cgx-fail "x-argreg: more than 6 integer argument registers")))

; ============================ calls ==========================================
; One unified SysV AMD64 call emitter for direct calls (symidx >= 0) and
; indirect calls through a function-pointer AVal (symidx < 0).
; `params` = the callee's declared param types (named args); args beyond that
; are variadic.
;
; The SysV sequence, in the order it must happen:
;   1. classify every argument, assigning integer regs (rdi rsi rdx rcx r8 r9),
;      SSE regs (xmm0-7), or stack slots. An argument that does not fit in the
;      remaining registers goes on the stack — and once one does, ALL later
;      arguments of that class do too.
;   2. write stack arguments to [rsp + n] (the outgoing area rbx sits above).
;   3. load register arguments LAST, so nothing we emit while computing an
;      argument can clobber a register already loaded.
;   4. for a variadic callee, set al = the number of SSE registers used. libc
;      varargs functions read it; getting it wrong corrupts printf("%f").
;   5. call; then spill the return value into a fresh slot.
; `cabi` selects the SysV by-value aggregate rules. It must be true ONLY for
; calls that really cross the C boundary. Internal calls (including dyn
; dispatch, whose trait signatures declare aggregate params BY VALUE while the
; call site passes references) keep this backend's own convention of handing
; aggregates around by pointer, and turning that into a stack copy corrupts the
; callee's view of its arguments.
; A by-value aggregate argument can arrive as the address of its storage: a value
; bound by `let` to a named constructor or another implicit place lowers to a
; pointer. Coil's own aggregate parameters are already pointers by this stage, so
; a non-scalar declared parameter is a C-convention one (an extern, an export-c
; entry or a C function pointer), and a pointer argument for it is that place.
; Pass the aggregate it points at, copied into a slot, as the LLVM backend does.
(defn g-pass-places-by-value! [(g (ptr Cga))
                               (params (ptr (ArrayList Type)))
                               (avs (ptr (ArrayList AVal)))] (-> void)
  (let [n
          (if (< (len (load avs)) (len (load params)))
              (len (load avs))
              (len (load params)))]
    (for [i 0 n]
      (let [(mut pt) (get (load params) i)
            av (get (load avs) i)]
        (when (and (not (ty-is-scalar (mut pt)))
                   (match (av-ty av)
                     (TPtr [_] true)
                     (TRef [_ _] true)
                     (_ false)))
          (let [sz (ty-size g (mut pt))
                slot (slot-for-ty! g (mut pt))]
            (av-to-x! g av (x-scratch0))
            (if (<= sz 8)
                (do
                  (emit-load-from-mem! g (x-scratch1) (x-scratch0) sz)
                  (emit-store-int! g (x-scratch1) (x-slotbase) slot sz)
                  0)
                (emit-copy-from-mem! g slot (x-scratch0) sz))
            (set! avs i (mk-aval 1 slot pt))))))))

(defn emit-call-abi! [(g (ptr Cga))
                      (symidx i64)
                      (fpav (ptr AVal))
                      (params (ptr (ArrayList Type)))
                      (variadic bool)
                      (ret Type)
                      (avs (ptr (ArrayList AVal)))
                      (cabi bool)] (-> AVal)
  (let [s (field g asm)
        a (.a g)
        nargs (len (load avs))
        nparams (len (load params))
        (mut retp)
          (: ret
             Type)]
    (g-pass-places-by-value! g params avs)
    (let [retvoid (match ret (TVoid [] true) (_ false))
          retinfo
            (if retvoid
                (mk-abi-scalar)
                (g-abi-info g
                            (mut retp)))
          resslot
            (if retvoid
                -1
                (slot-for-ty! g
                              (mut retp)))
          ; kinds: 0 int-reg, 1 sse-reg, 2 two-reg pair, 3 stack, 4 indirect(memory),
          ; 5 nothing (an empty struct)
          (mut pkind) (ArrayList::new [i64] a)
          (mut pr0) (ArrayList::new [i64] a)
          ; first register (or stack offset)
          (mut pr1) (ArrayList::new [i64] a)
          ; second register for pairs
          (mut pslot) (ArrayList::new [i64] a)
          (mut gp) 0
          (mut fp) 0
          (mut stk) 0]
      ; a >16B return is passed as a hidden first INTEGER argument (rdi)
      (when (= (abi-cls retinfo) 4) (set! gp 1) 0)
      ; ---- 1. classify
      (let [(mut i) 0]
        (loop (if (>= (load i) nargs)
                  (break)
                  (do
                    (let [av (get (load avs) (load i))
                          (mut t)
                            ; Classify by the callee's DECLARED parameter type, not by
                            ; the argument's own type. Internally this backend hands
                            ; aggregates around as references, so an argument whose
                            ; declared type is a by-value struct arrives here as a
                            ; (ref S) — which would classify as a plain pointer and be
                            ; passed in one register. That is right for AAPCS64 (which
                            ; really does pass >16B indirectly) but WRONG for SysV,
                            ; where the caller must place a COPY on the stack. Beyond
                            ; the declared params the args are variadic, and variadic
                            ; arguments are never by-value aggregates here, so the
                            ; argument's own type is the right answer there.
                            (if (and cabi (< (load i) nparams))
                                (get (load params) (load i))
                                (av-ty av))]
                      (let [info
                              (g-abi-info g
                                          (mut t))
                            cls (abi-cls info)
                            ; A by-value aggregate arrives as a reference, so the
                            ; bytes to copy live at the address the slot HOLDS,
                            ; not in the slot itself.
                            ; the value arrives indirectly whenever the declared
                            ; type is an aggregate but the ARGUMENT is a pointer
                            ; or reference to it (how this backend moves
                            ; aggregates internally).
                            byref
                              (and cabi
                                   (and (>= (abi-cls info)
                                            2)
                                        (match (av-ty av)
                                          (TRef [_m _i] true)
                                          (TPtr [_i2] true)
                                          (_ false))))
                            slot
                              (if byref
                                  (let [tmp
                                          (slot-for-ty! g
                                                        (mut t))]
                                    (av-to-x! g av (x-scratch2))
                                    (emit-copy-from-mem! g
                                                         tmp
                                                         (x-scratch2)
                                                         (ty-size g
                                                                  (mut t)))
                                    tmp)
                                  (av-slot! g av))]
                        (push! (mut pslot) slot)
                        (cond ; ---- an empty struct: not passed at all
                              (= cls 6)
                                (do
                                  (push! (mut pkind) 5)
                                  (push! (mut pr0) 0)
                                  (push! (mut pr1) 0)
                                  0)
                              ; ---- scalar float
                              (= cls 1)
                                (if (< (load fp) 8)
                                    (do
                                      (push! (mut pkind) 1)
                                      (push! (mut pr0) (load fp))
                                      (push! (mut pr1) 0)
                                      (set! fp (primitive/iadd (load fp) 1))
                                      0)
                                    (do
                                      (push! (mut pkind) 3)
                                      (push! (mut pr0) (load stk))
                                      (push! (mut pr1) 0)
                                      (set! stk (primitive/iadd (load stk) 8))
                                      0))
                              ; ---- scalar int/ptr
                              (= cls 0)
                                (if (< (load gp) 6)
                                    (do
                                      (push! (mut pkind) 0)
                                      (push! (mut pr0) (load gp))
                                      (push! (mut pr1) 0)
                                      (set! gp (primitive/iadd (load gp) 1))
                                      0)
                                    (do
                                      (push! (mut pkind) 3)
                                      (push! (mut pr0) (load stk))
                                      (push! (mut pr1) 0)
                                      (set! stk (primitive/iadd (load stk) 8))
                                      0))
                              ; ---- aggregate <= 8B: one register, class from eb0
                              (= cls 2)
                                (let [sse
                                        (= (abi-eb0 info)
                                           2)]
                                  (if (if sse
                                          (< (load fp) 8)
                                          (< (load gp) 6))
                                      (do
                                        (push! (mut pkind) (if sse 1 0))
                                        (push! (mut pr0)
                                               (if sse (load fp) (load gp)))
                                        (push! (mut pr1) 0)
                                        (if sse
                                            (set! fp
                                                  (primitive/iadd (load fp) 1))
                                            (set! gp
                                                  (primitive/iadd (load gp) 1)))
                                        0)
                                      (do
                                        (push! (mut pkind) 3)
                                        (push! (mut pr0) (load stk))
                                        (push! (mut pr1) 0)
                                        (set! stk (primitive/iadd (load stk) 8))
                                        0)))
                              ; ---- aggregate <= 16B: two registers, one per eightbyte
                              (= cls 3)
                                (let [s0
                                        (= (abi-eb0 info)
                                           2)
                                      s1
                                        (= (abi-eb1 info)
                                           2)
                                      needg
                                        (primitive/iadd (if s0 0 1) (if s1 0 1))
                                      needf
                                        (primitive/iadd (if s0 1 0) (if s1 1 0))]
                                  ; both eightbytes must fit, or the whole thing goes on the stack
                                  (if (and (<= (primitive/iadd (load gp) needg)
                                               6)
                                           (<= (primitive/iadd (load fp) needf)
                                               8))
                                      (let [r0 (if s0 (load fp) (load gp))]
                                        (if s0
                                            (set! fp
                                                  (primitive/iadd (load fp) 1))
                                            (set! gp
                                                  (primitive/iadd (load gp) 1)))
                                        (let [r1 (if s1 (load fp) (load gp))]
                                          (if s1
                                              (set! fp
                                                    (primitive/iadd (load fp)
                                                                    1))
                                              (set! gp
                                                    (primitive/iadd (load gp)
                                                                    1)))
                                          ; encode the two classes alongside the two registers:
                                          ; kind 2 means "pair"; the SSE-ness rides in pr0/pr1's
                                          ; high bit so the emit pass knows which file to use.
                                          (push! (mut pkind) 2)
                                          (push! (mut pr0)
                                                 (| r0 (if s0 256 0)))
                                          (push! (mut pr1)
                                                 (| r1 (if s1 256 0)))
                                          0))
                                      ; Both eightbytes go on the stack. This is kind 4
                                      ; (a by-value memory argument of a known size), NOT
                                      ; kind 3 — kind 3 writes a single 8-byte slot, which
                                      ; would leave the callee's second eightbyte reading
                                      ; whatever happened to be on the stack.
                                      (do
                                        (push! (mut pkind) 4)
                                        (push! (mut pr0) (load stk))
                                        (push! (mut pr1) 16)
                                        (set! stk
                                              (primitive/iadd (load stk) 16))
                                        0)))
                              ; ---- > 16B: passed in memory, by value, on the stack
                              :else
                                (let [sz
                                        (ty-size g
                                                 (mut t))
                                      asz
                                        (primitive/imul (/ (primitive/iadd sz
                                                                           7)
                                                           8)
                                                        8)]
                                  (push! (mut pkind) 4)
                                  (push! (mut pr0) (load stk))
                                  (push! (mut pr1) asz)
                                  (set! stk (primitive/iadd (load stk) asz))
                                  0))))
                    (set! i (primitive/iadd (load i) 1))))))
      ; the outgoing area must be big enough for this call, and 16-byte aligned
      ; so the callee sees the ABI's alignment guarantee at its entry.
      (let [need
              (primitive/imul (/ (primitive/iadd (load stk) 15) 16)
                              16)]
        (when (> need (.outbytes g))
          (set! (.outbytes g) need)
          0))
      ; ---- 2. stack arguments first (they may need scratch registers)
      (let [(mut i) 0]
        (loop (if (>= (load i) nargs)
                  (break)
                  (do
                    (let [k (get (load pkind) (load i))
                          off (get (load pr0) (load i))
                          slot (get (load pslot) (load i))]
                      (cond (= k 3)
                              (do
                                (emit-load-int! g
                                                (x-scratch0)
                                                (x-slotbase)
                                                slot
                                                8
                                                false)
                                (x64-mov-mr! (mut s) 4 off (x-scratch0))
                                0)
                            (= k 4)
                              ; by-value memory argument: copy the whole aggregate
                              ; into the outgoing area.
                              (let [sz (get (load pr1) (load i))
                                    (mut j) 0]
                                (loop (if (>= (load j) sz)
                                          (break)
                                          (do
                                            (emit-load-int! g
                                                            (x-scratch0)
                                                            (x-slotbase)
                                                            (primitive/iadd slot
                                                                            (load j))
                                                            8
                                                            false)
                                            (x64-mov-mr! (mut s)
                                                         4
                                                         (primitive/iadd off
                                                                         (load j))
                                                         (x-scratch0))
                                            (set! j (primitive/iadd (load j) 8)))))
                                0)
                            :else 0))
                    (set! i (primitive/iadd (load i) 1))))))
      ; ---- 3. register arguments last
      (let [(mut i) 0]
        (loop (if (>= (load i) nargs)
                  (break)
                  (do
                    (let [k (get (load pkind) (load i))
                          r0 (get (load pr0) (load i))
                          r1 (get (load pr1) (load i))
                          slot (get (load pslot) (load i))
                          av (get (load avs) (load i))
                          (mut t) (av-ty av)]
                      (cond (= k 0)
                              ; a scalar is loaded at its own width; an aggregate
                              ; eightbyte is always a full 8-byte load.
                              (if (ty-is-scalar (mut t))
                                  (let [(mut bytes) (zeroed i64)
                                        (mut signed) (zeroed bool)]
                                    (ty-int-info (mut t)
                                                 (mut bytes)
                                                 (mut signed))
                                    (emit-load-int! g
                                                    (x-argreg r0)
                                                    (x-slotbase)
                                                    slot
                                                    bytes
                                                    signed)
                                    0)
                                  (emit-load-int! g
                                                  (x-argreg r0)
                                                  (x-slotbase)
                                                  slot
                                                  8
                                                  false))
                            (= k 1)
                              (emit-load-fp! g
                                             r0
                                             (x-slotbase)
                                             slot
                                             (if (ty-is-scalar (mut t))
                                                 (ty-float-bytes (mut t))
                                                 8))
                            (= k 2)
                              (do
                                (if (!= (& r0 256)
                                        0)
                                    (emit-load-fp! g
                                                   (& r0 255)
                                                   (x-slotbase)
                                                   slot
                                                   8)
                                    (emit-load-int! g
                                                    (x-argreg (& r0 255))
                                                    (x-slotbase)
                                                    slot
                                                    8
                                                    false))
                                (if (!= (& r1 256)
                                        0)
                                    (emit-load-fp! g
                                                   (& r1 255)
                                                   (x-slotbase)
                                                   (primitive/iadd slot 8)
                                                   8)
                                    (emit-load-int! g
                                                    (x-argreg (& r1 255))
                                                    (x-slotbase)
                                                    (primitive/iadd slot 8)
                                                    8
                                                    false))
                                0)
                            :else 0))
                    (set! i (primitive/iadd (load i) 1))))))
      ; hidden sret pointer goes in rdi, after everything else has been placed
      (when (= (abi-cls retinfo) 4)
        (emit-slot-addr! g 7 resslot)
        0)
      ; ---- 4. variadic: al = number of SSE registers used
      (when variadic (x64-mov-imm! (mut s) (x-scratch0) (load fp)) 0)
      ; ---- 5. the call
      (if (>= symidx 0)
          (let [off (x64-call-rel32! (mut s))]
            (eobj-add-reloc! (mut (.obj g))
                             (.text g)
                             off
                             symidx
                             (r-x86-64-plt32)
                             -4)
            0)
          (do
            ; the target must not be one of the argument registers, and r11 is
            ; the one scratch guaranteed free at a call boundary.
            (av-to-x! g (load fpav) (x-scratch2))
            (x64-call-r! (mut s) (x-scratch2))
            0))
      ; ---- result
      (if retvoid
          (mk-aval 0 0 (TInt 64 true))
          (let [cls (abi-cls retinfo)]
            (cond (= cls 6) (mk-aval 1 resslot ret)
                  ; empty: nothing returned
                  (= cls 0)
                    (do
                      (emit-store-int! g
                                       0
                                       (x-slotbase)
                                       resslot
                                       (ty-size g
                                                (mut retp)))
                      (mk-aval 1 resslot ret))
                  (= cls 1)
                    (do
                      (emit-store-fp! g
                                      0
                                      (x-slotbase)
                                      resslot
                                      (ty-float-bytes (mut retp)))
                      (mk-aval 1 resslot ret))
                  (= cls 2)
                    (do
                      (if (= (abi-eb0 retinfo) 2)
                          (emit-store-fp! g 0 (x-slotbase) resslot 8)
                          (emit-store-int! g
                                           0
                                           (x-slotbase)
                                           resslot
                                           (ty-size g
                                                    (mut retp))))
                      (mk-aval 1 resslot ret))
                  (= cls 3)
                    ; two eightbytes come back in (rax,rdx) / (xmm0,xmm1) / a mix,
                    ; each file numbered independently.
                    (let [s0 (= (abi-eb0 retinfo) 2)
                          s1 (= (abi-eb1 retinfo) 2)
                          rem
                            (primitive/isub (ty-size g
                                                     (mut retp))
                                            8)]
                      (if s0
                          (emit-store-fp! g 0 (x-slotbase) resslot 8)
                          (emit-store-int! g 0 (x-slotbase) resslot 8))
                      (if s1
                          ; second SSE eightbyte is xmm1 if the first was SSE, else xmm0
                          (emit-store-fp! g
                                          (if s0 1 0)
                                          (x-slotbase)
                                          (primitive/iadd resslot 8)
                                          (if (>= rem 8)
                                              8
                                              rem))
                          ; second INTEGER eightbyte is rdx if the first was INTEGER, else rax
                          (emit-store-int! g
                                           (if s0 0 2)
                                           (x-slotbase)
                                           (primitive/iadd resslot 8)
                                           (if (>= rem 8)
                                               8
                                               rem)))
                      (mk-aval 1 resslot ret))
                  :else  ; cls 4: the callee wrote through the hidden pointer
                    (mk-aval 1 resslot ret)))))))

; The internal convention: aggregates travel by pointer, exactly as on arm64.
(defn emit-call! [(g (ptr Cga))
                  (symidx i64)
                  (fpav (ptr AVal))
                  (params (ptr (ArrayList Type)))
                  (variadic bool)
                  (ret Type)
                  (avs (ptr (ArrayList AVal)))] (-> AVal)
  (emit-call-abi! g symidx fpav params variadic ret avs false))

; ============================ globals / strings ==============================
; intern an EStr/ECStr payload as a private const-section global; returns symidx.
; `nul` appends a trailing NUL (ECStr); EStr arrays are exactly the bytes.
(defn g-intern-str! [(g (ptr Cga)) (sv (slice u8)) (nul bool)] (-> i64)
  (let [n (len (.strs g))
        (mut found) -1]
    (for [i 0 n]
      (let [e (xal-at [GStr] (field g strs) i)]
        ; entries are stored with a 1-byte kind prefix (0=str,1=cstr)
        (let [es (.s e)]
          (when (and (= (primitive/cast i64 (get es 0))
                        (if nul (do 1) 0))
                     (= (subslice es 1 (len es)) sv))
            (set! found (.symidx e))
            0))))
    (if (>= (load found) 0)
        (load found)
        (let [a (.a g)
              buf (eobj-sect-buf (mut (.obj g)) (.constsec g))
              off (len (load buf))
              ; ".L" is the ELF convention for a local label the linker may drop
              ; from the final symbol table; "l_" is the Mach-O one.
              nm (sconcat a (if nul ".Lcstr." ".Lstr.") (i64->str a (.nglob g)))]
          (set! (.nglob g) (primitive/iadd (.nglob g) 1))
          (xb-bytes! (mut buf) sv)
          (when nul (xb-u8! (mut buf) 0))
          (let [sym (eobj-add-sym! (mut (.obj g)) nm (.constsec g) off false)
                (mut e) (zeroed GStr)
                (mut tagged) (StrBuf::new a)]
            (push! (mut tagged) (primitive/cast u8 (when nul 1)))
            (push-str! (mut tagged) sv)
            (set! (.s e) (str (load tagged)))
            (set! (.symidx e) sym)
            (push! (mut (.strs g)) e)
            sym)))))

; a zero-initialized global in .data; returns symidx.
(defn g-zero-global! [(g (ptr Cga)) (size i64) (align i64)] (-> i64)
  (let [a (.a g)
        buf (eobj-sect-buf (mut (.obj g)) (.datasec g))]
    (xb-align! (mut buf) (g-data-align! g (if (< align 8) 8 align)))
    (let [off (len (load buf))
          nm (text/format a ".Lg.{}" (i64->str a (.nglob g)))]
      (set! (.nglob g) (primitive/iadd (.nglob g) 1))
      (xb-zeros! (mut buf) size)
      (eobj-add-sym! (mut (.obj g)) nm (.datasec g) off false))))

; Public static storage (`alloc-static … :as "name"`): the named symbol IS the
; storage, globally visible, never a pointer-valued proxy. ELF symbols carry no
; prefix, so the C spelling is the name itself.
(defn g-public-zero-global! [(g (ptr Cga))
                             (name (slice u8))
                             (size i64)
                             (align i64)] (-> i64)
  (let [symbols (field (field g obj) syms)]
    (for i (range 0 (len (load symbols)))
      (let [symbol (xal-at [ESym] symbols i)]
        (when (and (= (.name symbol) name) (!= (.sect symbol) 0))
          (cgx-fail (text/format (.a g)
                                 "duplicate static storage symbol: {}"
                                 name)))))
    (let [buf (eobj-sect-buf (mut (.obj g)) (.datasec g))]
      (xb-align! (mut buf) (g-data-align! g (if (< align 8) 8 align)))
      (let [off (len (load buf))]
        (xb-zeros! (mut buf) size)
        (eobj-add-sym! (mut (.obj g)) name (.datasec g) off true)))))

(defn g-field-ty [(g (ptr Cga)) (si i64) (fi i64)] (-> (ptr Type))
  (field (xal-at [Field] (.fields (struct-at (field g layouts) si)) fi) ty))

;;; Write the link-time constant `e` of type `t` at `off` in data section `sect`:
;;; the initializer of an `alloc-static` (array literals lower to one). Pointers
;;; become absolute relocations the loader or linker resolves.
;;; Write the integer `n`, of type `t`, at `off` in data section `sect`.
(defn g-static-write-int! [(g (ptr Cga))
                           (t (ptr Type))
                           (n i64)
                           (sect i64)
                           (off i64)] (-> i64)
  (let [buf (eobj-sect-buf (mut (.obj g)) sect)
        sz (ty-size g t)]
    (cond (= sz 1) (set! (mut buf) off (cast u8 n))
          (= sz 2)
            (do
              (set! (mut buf) off (cast u8 n))
              (set! (mut buf) (+ off 1) (cast u8 (>> n 8))))
          (= sz 4) (xb-patch-u32! (mut buf) off n)
          :else (xb-patch-u64! (mut buf) off n))
    0))

(defn g-static-write! [(g (ptr Cga))
                       (t (ptr Type))
                       (e (ptr Expr))
                       (sect i64)
                       (off i64)] (-> i64)
  (let [buf (eobj-sect-buf (mut (.obj g)) sect)]
    (match (.kind e)
      (EInt [n] (g-static-write-int! g t n sect off))
      ; A constant integer expression (`(sizeof K)`, arithmetic on constants), as
      ; the LLVM backend folds it.
      (ESizeOf [_]
               (g-static-write-int! g
                                    t
                                    (gcev-v (g-const-eval (native-context g) e))
                                    sect
                                    off))
      (EAlignOf [_]
                (g-static-write-int! g
                                     t
                                     (gcev-v (g-const-eval (native-context g) e))
                                     sect
                                     off))
      (EOffsetOf [_ _]
                 (g-static-write-int! g
                                      t
                                      (gcev-v (g-const-eval (native-context g)
                                                            e))
                                      sect
                                      off))
      (EBin [_ _ _]
            (g-static-write-int! g
                                 t
                                 (gcev-v (g-const-eval (native-context g) e))
                                 sect
                                 off))
      (ECmp [_ _ _]
            (g-static-write-int! g
                                 t
                                 (gcev-v (g-const-eval (native-context g) e))
                                 sect
                                 off))
      (EFloat [bits]
              (do
                (if (= (ty-size g t) 4)
                    (xb-patch-u32! (mut buf) off (f64-bits->f32-bits bits))
                    (xb-patch-u64! (mut buf) off bits))
                0))
      (EBool [v] (do (set! (mut buf) off (cast u8 (if v 1 0))) 0))
      ; A (slice u8) literal: a relocated pointer to NUL-terminated bytes, then
      ; the length -- the layout emit-expr builds for an expression literal.
      (EStr [sv]
            (do
              (eobj-add-reloc! (mut (.obj g))
                               sect
                               off
                               (g-intern-str! g sv true)
                               (r-x86-64-64)
                               0)
              (xb-patch-u64! (mut buf) (+ off 8) (len sv))
              0))
      ; A C string literal: the relocated pointer alone.
      (ECStr [sv]
             (eobj-add-reloc! (mut (.obj g))
                              sect
                              off
                              (g-intern-str! g sv true)
                              (r-x86-64-64)
                              0))
      ; A sum: the i32 tag, then each payload field at its natural offset after
      ; the 8-byte tag word (emit-construct's layout).
      (EConstruct [sum variant args]
                  (let [su (g-sum-idx g sum)]
                    (when (< su 0)
                      (cgx-fail2 "static initializer: unknown sum " sum))
                    (let [vidx (g-variant-idx g su variant)
                          vs
                            (load (field (sum-at (field g layouts) su) variants))
                          vfields (field (xal-at [Variant] vs vidx) fields)]
                      (xb-patch-u32! (mut buf) off vidx)
                      (for i (range 0 (len (load args)))
                        (g-static-write! g
                                         (field (xal-at [Field]
                                                        (load vfields)
                                                        i)
                                                ty)
                                         (xal-at [Expr] args i)
                                         sect
                                         (+ off
                                            8
                                            (g-natural-off g (load vfields) i))))
                      0)))
      (EZeroed [_] 0)
      (ERecordInit [_] 0)
      (EStaticArray [indices items]
                    (match (load t)
                      (TArray [elem _]
                              (do
                                (for i (range 0 (len (load items)))
                                  (g-static-write! g
                                                   elem
                                                   (xal-at [Expr] items i)
                                                   sect
                                                   (+ off
                                                      (* (get (load indices) i)
                                                         (ty-size g elem)))))
                                0))
                      (_ (do
                           (cgx-fail "static :elements requires an array allocation")
                           0))))
      (EFnPtrOf [name0]
                (let [name (g-fnptr-target g name0)
                      si (g-sig-idx g name)]
                  (when (< si 0)
                    (cgx-fail2 "static initializer: unknown function " name))
                  (eobj-add-reloc! (mut (.obj g))
                                   sect
                                   off
                                   (.symidx (xal-at [GSig] (field g sigs) si))
                                   (r-x86-64-64)
                                   0)))
      ; A nested static (a slice field whose backing array is itself an
      ; alloc-static): lay the inner storage down, then point at it.
      (EAlloc [storage ty init symbol]
              (if (!= storage 1)
                  (do
                    (cgx-fail "static initializer: only alloc-static storage is a link-time constant")
                    0)
                  (let [tp (box-type (.a g) ty)
                        sym
                          (match symbol
                            (Some [name]
                                  (g-public-zero-global! g
                                                         name
                                                         (ty-size g tp)
                                                         (ty-align g tp)))
                            (None []
                                  (g-zero-global! g
                                                  (ty-size g tp)
                                                  (ty-align g tp))))
                        ms (xal-at [ESym] (field (field g obj) syms) sym)]
                    (when (!= (cast i64 init) 0)
                      (g-static-write! g tp init (.sect ms) (.off ms)))
                    (eobj-add-reloc! (mut (.obj g))
                                     sect
                                     off
                                     sym
                                     (r-x86-64-64)
                                     0))))
      ; A slice: its data pointer (a nested static the value points into),
      ; then its length.
      (EMakeSlice [data elem len]
                  (do
                    (g-static-write! g
                                     (box-type (.a g)
                                               (TPtr (box-type (.a g) elem)))
                                     data
                                     sect
                                     off)
                    ; the nested write may have grown the buffers: look it up again
                    (let [after (eobj-sect-buf (mut (.obj g)) sect)]
                      (xb-patch-u64! (mut after)
                                     (primitive/iadd off 8)
                                     (extent-value len)))
                    0))
      (ECast [_ inner] (g-static-write! g t inner sect off))
      (ELoad [inner] (g-static-write! g t inner sect off))
      (ELet [_ body]
            (match (load t)
              (TStruct [name]
                       (let [si (g-struct-idx g name)]
                         (when (< si 0)
                           (cgx-fail2 "static initializer: unknown struct "
                                      name))
                         (for i (range 0 (len (load body)))
                           (let [item (xal-at [Expr] body i)
                                 place (static-store-place item)]
                             (if (= (cast i64 place) 0)
                                 (if (static-body-result? body i)
                                     0
                                     (do
                                       (cgx-fail "static initializer: expected a materialized aggregate")
                                       0))
                                 (match (.kind place)
                                   (EField [_ fname]
                                           (let [fi (g-field-idx g si fname)]
                                             (when (< fi 0)
                                               (cgx-fail2 "static initializer: unknown field "
                                                          fname))
                                             (g-static-write! g
                                                              (g-field-ty g
                                                                          si
                                                                          fi)
                                                              (static-store-value item)
                                                              sect
                                                              (+ off
                                                                 (g-field-off g
                                                                              si
                                                                              fi)))))
                                   (_ (do
                                        (cgx-fail "static initializer: a store that is not to a field of the aggregate")
                                        0))))))
                         0))
              (TArray [elem count-extent]
                      (let [count (extent-value count-extent)]
                        (for i (range 0 (len (load body)))
                          (let [store (xal-at [Expr] body i)
                                place (static-store-place store)]
                            (if (= (cast i64 place) 0)
                                (if (static-body-result? body i)
                                    0
                                    (do
                                      (cgx-fail "static initializer: expected a materialized array")
                                      0))
                                (match (.kind place)
                                  (EIndex [_ index]
                                          (match (.kind index)
                                            (EInt [item]
                                                  (if (or (< item 0)
                                                          (>= item count))
                                                      (do
                                                        (cgx-fail "alloc-static initializer: array index is out of bounds")
                                                        0)
                                                      (g-static-write! g
                                                                       elem
                                                                       (static-store-value store)
                                                                       sect
                                                                       (+ off
                                                                          (* item
                                                                             (ty-size g
                                                                                      elem))))))
                                            (_ (do
                                                 (cgx-fail "alloc-static initializer: array index is not constant")
                                                 0))))
                                  (_ (do
                                       (cgx-fail "static initializer: a store that is not to an element of the array")
                                       0))))))
                        0))
              (_ (do
                   (cgx-fail "static initializer: materialized aggregate has the wrong type")
                   0))))
      (_ (do (cgx-fail "static initializer is not a link-time constant") 0)))))

;;; The static of the runtime `def` NAME, or -1.
;;; `align`, after raising the data section's alignment to it: a static aligned
;;; past 8 bytes lands at an aligned offset, which is aligned in memory only if
;;; the section is too.
(defn g-data-align! [(g (ptr Cga)) (align i64)] (-> i64)
  (eobj-sect-align-at-least! (mut (.obj g)) (.datasec g) align)
  align)

(defn g-static-idx [(g (ptr Cga)) (name (slice u8))] (-> i64)
  (let [(mut found) -1]
    (for i (range 0 (len (.statics g)))
      (when (and (< found 0)
                 (= (.name (xal-at [GStatic] (field g statics) i)) name))
        (set! found i)))
    found))

;;; Give every runtime `def` its own local data symbol, initialized with the
;;; def's link-time constant value; `EStaticRef` addresses it.
(defn g-declare-statics! [(g (ptr Cga)) (p (ptr Program))] (-> i64)
  (let [cs (load (field p consts))]
    (for i (range 0 (len (load cs)))
      (let [cp (xal-at [Const] (.consts p) i)]
        (when (.runtime cp)
          (match (.ty cp)
            (None [] (cgx-fail "internal: checked def has no type"))
            (Some [ty]
                  (let [tp (box-type (.a g) ty)
                        symname (text/format (.a g) "coil_def.{}" (.name cp))]
                    (if (.declared cp)
                        ; Another unit defines it: an undefined symbol, loaded through
                        ; a slot (emit-sym-addr!).
                        (let [sym
                                (eobj-add-sym! (mut (.obj g)) symname 0 0 true)]
                          (push! (mut (.statics g))
                                 (GStatic
                                   :name (.name cp)
                                   :ty ty
                                   :symidx sym))
                          0)
                        (let [buf (eobj-sect-buf (mut (.obj g)) (.datasec g))
                              align (ty-align g tp)]
                          (xb-align! (mut buf)
                                     (g-data-align! g (if (< align 8) 8 align)))
                          (let [off (len (load buf))
                                sym
                                  (do
                                    (xb-zeros! (mut buf) (ty-size g tp))
                                    ; Storage this program publishes for other
                                    ; units is external.
                                    (eobj-add-sym! (mut (.obj g))
                                                   symname
                                                   (.datasec g)
                                                   off
                                                   (g-unit-export? p (.name cp))))]
                            (push! (mut (.statics g))
                                   (GStatic
                                     :name (.name cp)
                                     :ty ty
                                     :symidx sym))
                            (g-static-write! g
                                             tp
                                             (field cp value)
                                             (.datasec g)
                                             off)))))))))
      0))
  0)

; reg = address of a symbol. A defined symbol can use a RIP-relative lea.
; An undefined symbol may be preempted by a shared library: a PC32 relocation
; in .text is invalid in a PIE. Keep its absolute relocation in writable .data
; and load the resolved pointer through a local RIP-relative slot. The in-memory
; ELF loader applies both relocation kinds to the same layout.
(defn emit-sym-addr! [(g (ptr Cga)) (reg i64) (symidx i64)] (-> i64)
  (let [s (field g asm)
        sym (xal-at [ESym] (field (field g obj) syms) symidx)]
    (if (= (.sect sym) 0)
        (let [slot (g-zero-global! g 8 8)
              off (.off (xal-at [ESym] (field (field g obj) syms) slot))]
          (eobj-add-reloc! (mut (.obj g))
                           (.datasec g)
                           off
                           symidx
                           (r-x86-64-64)
                           0)
          (x64-mov-rip! (mut s) reg 0)
          (eobj-add-reloc! (mut (.obj g))
                           (.text g)
                           (primitive/isub (x64-off (mut s)) 4)
                           slot
                           (r-x86-64-pc32)
                           -4))
        (do
          (x64-lea-rip! (mut s) reg 0)
          (eobj-add-reloc! (mut (.obj g))
                           (.text g)
                           (primitive/isub (x64-off (mut s)) 4)
                           symidx
                           (r-x86-64-pc32)
                           -4)))
    0))

; store an AVal into a slot (any type).
(defn emit-store-av! [(g (ptr Cga)) (av AVal) (dst i64)] (-> i64)
  (let [(mut t) (av-ty av)]
    (if (ty-is-scalar (mut t))
        (if (ty-is-float (mut t))
            (do
              (av-to-d! g av 0)
              (emit-store-fp! g 0 (x-slotbase) dst (ty-float-bytes (mut t)))
              0)
            (do
              (av-to-x! g av (x-scratch0))
              (emit-store-int! g
                               (x-scratch0)
                               (x-slotbase)
                               dst
                               (ty-size g (mut t)))
              0))
        (emit-copy! g dst (av-slot! g av) (ty-size g (mut t))))))

; pointee type of a TPtr/TRef value
(defn ty-pointee [(t (ptr Type))] (-> Type)
  (match (load t)
    (TPtr [inner] (load inner))
    (TRef [_m inner] (load inner))
    (_ (do (cgx-fail "load/store through a non-pointer") (TInt 64 true)))))

; ============================ expression emission ============================
(defn emit-body [(g (ptr Cga)) (body (ptr (ArrayList Expr)))] (-> AVal)
  (let [n (len (load body))
        (mut last) (mk-aval 0 0 (TInt 64 true))]
    (for [i 0 n]
      (when (.terminated g) (break))
      (set! last (emit-expr g (xal-at [Expr] body i))))
    (load last)))

; The function body: identical to emit-body except the LAST expression is emitted in
; TAIL position. Only the function body may start a tail chain -- a `do` in argument
; position ends in a value that its caller still consumes.
(defn emit-body-tail [(g (ptr Cga)) (body (ptr (ArrayList Expr)))] (-> AVal)
  (let [n (len (load body))
        (mut last) (mk-aval 0 0 (TInt 64 true))]
    (for [i 0 n]
      (when (.terminated g) (break))
      (when (= i (primitive/isub n 1))
        (set! (.tailok g) true)
        0)
      (set! last (emit-expr g (xal-at [Expr] body i))))
    (load last)))

(defn emit-binds [(g (ptr Cga)) (binds (ptr (ArrayList Bind)))] (-> i64)
  (let [n (len (load binds))
        (mut i) 0
        (mut a) (.a g)]
    (loop (if (>= (load i) n)
              (break)
              (do
                (let [b (xal-at [Bind] binds (load i))
                      av (emit-expr g (field b value))]
                  (if (.mutable b)
                      ; mutable: give the value a stable slot and bind the NAME to a
                      ; pointer to it (the checker reads it via (primitive/load name)).
                      (let [(mut t) (av-ty av)]
                        (let [vslot (av-slot! g av)
                              pslot (slot-new! (native-context g) 8 8)]
                          (emit-slot-addr! g (x-scratch0) vslot)
                          (emit-store-int! g (x-scratch0) (x-slotbase) pslot 8)
                          (dw-note-var! g
                                        (.name b)
                                        (mut t)
                                        pslot
                                        true
                                        false
                                        (.source (.value b))
                                        (.lo (.value b)))
                          (set! (.env g)
                                (gscope-put (load a)
                                            (load (field g env))
                                            (.name b)
                                            (mk-aval 1
                                                     pslot
                                                     (TPtr (box-type (load a)
                                                                     (av-ty av))))))
                          0))
                      (do
                        (when (= (av-kind av) 1)
                          (dw-note-bind! g
                                         (.name b)
                                         av
                                         (.source (.value b))
                                         (.lo (.value b))))
                        (set! (.env g)
                              (gscope-put (load a)
                                          (load (field g env))
                                          (.name b)
                                          av))
                        0)))
                (set! i (primitive/iadd (load i) 1))))))
  0)

(defn emit-stmts [(g (ptr Cga)) (body (ptr (ArrayList Expr)))] (-> i64)
  (let [n (len (load body))
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (when (.terminated g) (break))
                (emit-expr g (xal-at [Expr] body (load i)))
                (set! i (primitive/iadd (load i) 1))))))
  0)

; find the target loop index (labeled search from innermost, else innermost).

; ---- memory access through a pointer register -------------------------------
(defn emit-load-from-mem! [(g (ptr Cga)) (reg i64) (addrreg i64) (bytes i64)]
  (-> i64)
  (let [s (field g asm)]
    (cond (= bytes 1) (x64-movzx8-rm! (mut s) reg addrreg 0)
          (= bytes 2) (x64-movzx16-rm! (mut s) reg addrreg 0)
          (= bytes 4) (x64-mov32-rm! (mut s) reg addrreg 0)
          :else (x64-mov-rm! (mut s) reg addrreg 0))))

(defn emit-store-to-mem! [(g (ptr Cga)) (reg i64) (addrreg i64) (bytes i64)]
  (-> i64)
  (let [s (field g asm)]
    (cond (= bytes 1) (x64-mov8-mr! (mut s) addrreg 0 reg)
          (= bytes 2) (x64-mov16-mr! (mut s) addrreg 0 reg)
          (= bytes 4) (x64-mov32-mr! (mut s) addrreg 0 reg)
          :else (x64-mov-mr! (mut s) addrreg 0 reg))))

; Canonicalize a narrow integer in `reg` to its declared width: shift left to
; drop the high garbage, then shift back — arithmetically when signed, so the
; sign bit replicates. Widths of 8/16/32 could use movsx/movzx, but odd widths
; (u2, i3, u7, u11 …) exist in this language and only the shift pair handles
; them, so one uniform path keeps the semantics identical for every width.
(defn emit-canon-int! [(g (ptr Cga)) (reg i64) (bits i64) (signed bool)]
  (-> i64)
  (let [s (field g asm)
        sh (primitive/isub 64 bits)]
    (when (> sh 0)
      (x64-shl-imm! (mut s) reg sh)
      (if signed (x64-sar-imm! (mut s) reg sh) (x64-shr-imm! (mut s) reg sh))
      0)
    0))

(defn emit-int-unary [(g (ptr Cga)) (op i64) (inner (ptr Expr))] (-> AVal)
  (let [av (emit-expr g inner)
        (mut t) (av-ty av)
        s (field g asm)]
    (let [bits (match t (TInt [n _] n) (_ 64))]
      (av-to-x! g av (x-scratch0))
      (if (= op 0)
          (x64-not! (mut s) (x-scratch0))
          (do
            (emit-canon-int! g (x-scratch0) bits false)
            (cond (= op 1)
                    (do
                      (x64-lzcnt! (mut s) (x-scratch0) (x-scratch0))
                      (when (< bits 64)
                        (x64-sub-ri! (mut s)
                                     (x-scratch0)
                                     (primitive/isub 64 bits))))
                  (= op 2)
                    (do
                      (x64-tzcnt! (mut s) (x-scratch0) (x-scratch0))
                      (when (< bits 64)
                        (x64-cmp-ri! (mut s) (x-scratch0) 64)
                        (x64-mov-imm! (mut s) (x-scratch2) bits)
                        (x64-cmovcc! (mut s)
                                     (x64-cc-e)
                                     (x-scratch0)
                                     (x-scratch2))))
                  (= op 3) (x64-popcnt! (mut s) (x-scratch0) (x-scratch0))
                  :else
                    (do
                      (x64-bswap! (mut s) (x-scratch0))
                      (when (< bits 64)
                        (x64-shr-imm! (mut s)
                                      (x-scratch0)
                                      (primitive/isub 64 bits)))))))
      (emit-canon-int! g (x-scratch0) bits (match t (TInt [_ sg] sg) (_ false)))
      (let [slot (slot-for-ty! g (mut t))]
        (emit-store-int! g (x-scratch0) (x-slotbase) slot (ty-size g (mut t)))
        (mk-aval 1 slot (av-ty av))))))

; ---- binary arithmetic ------------------------------------------------------
; x86 is two-address (dst op= src), so the pattern is: lhs into rax, rhs into
; r10, operate into rax, spill. Division is the awkward one: idiv/div take the
; dividend in rdx:rax implicitly and write the quotient to rax and remainder to
; rdx, so rdx must be prepared (cqo for signed, zeroed for unsigned) and the
; divisor must live somewhere that is not rax or rdx — hence r10.
(defn emit-bin [(g (ptr Cga)) (op i64) (lhs (ptr Expr)) (rhs (ptr Expr))]
  (-> AVal)
  (emit-bin-av! g op (emit-expr g lhs) (emit-expr g rhs)))

; AVal-level core of emit-bin, shared with the llvm-ir line interpreter so both
; paths emit the exact same instruction sequences.
(defn emit-bin-av! [(g (ptr Cga)) (op i64) (lav AVal) (rav AVal)] (-> AVal)
  (let [(mut t) (av-ty lav)
        s (field g asm)]
    (if (ty-is-float (mut t))
        ; float ops: 0 add 1 sub 2 mul 3 div 4 rem (via libm fmod)
        (let [fb (ty-float-bytes (mut t))
              dbl (= fb 8)]
          (av-to-d! g lav 0)
          (av-to-d! g rav 1)
          (cond (= op 0) (x64-adds! (mut s) dbl 0 1)
                (= op 1) (x64-subs! (mut s) dbl 0 1)
                (= op 2) (x64-muls! (mut s) dbl 0 1)
                (= op 3) (x64-divs! (mut s) dbl 0 1)
                (= op 4)
                  ; frem: libm fmod(xmm0, xmm1) — the args are already in place,
                  ; and it is a variadic-free call, but al must still be sane.
                  (let [fsym (g-runtime-sym! g (if dbl "fmod" "fmodf"))
                        off
                          (do
                            (x64-mov-imm! (mut s) (x-scratch0) 0)
                            (x64-call-rel32! (mut s)))]
                    (eobj-add-reloc! (mut (.obj g))
                                     (.text g)
                                     off
                                     fsym
                                     (r-x86-64-plt32)
                                     -4)
                    0)
                :else (cgx-fail "unsupported float binary op"))
          (let [slot
                  (slot-for-ty! g
                                (mut t))]
            (emit-store-fp! g 0 (x-slotbase) slot fb)
            (mk-aval 1 slot (av-ty lav))))
        ; integer ops
        (let [signed
                (match t
                  (TInt [_b sg] sg)
                  (_ false))]
          (av-to-x! g lav (x-scratch0))
          (av-to-x! g rav (x-scratch1))
          (cond (= op 0) (x64-add-rr! (mut s) (x-scratch0) (x-scratch1))
                (= op 1) (x64-sub-rr! (mut s) (x-scratch0) (x-scratch1))
                (= op 2) (x64-imul-rr! (mut s) (x-scratch0) (x-scratch1))
                ; signed division: cqo sign-extends rax into rdx:rax first.
                (= op 3)
                  (if signed
                      (do (x64-cqo! (mut s)) (x64-idiv! (mut s) (x-scratch1)))
                      (do
                        (x64-mov-imm! (mut s) 2 0)
                        (x64-div! (mut s) (x-scratch1))))
                ; signed remainder: the result is in rdx, so move it back to rax.
                (= op 4)
                  (do
                    (if signed
                        (do (x64-cqo! (mut s)) (x64-idiv! (mut s) (x-scratch1)))
                        (do
                          (x64-mov-imm! (mut s) 2 0)
                          (x64-div! (mut s) (x-scratch1))))
                    (x64-mov-rr! (mut s) (x-scratch0) 2))
                ; ops 5/6 are the explicitly-unsigned div/rem
                (= op 5)
                  (do
                    (x64-mov-imm! (mut s) 2 0)
                    (x64-div! (mut s) (x-scratch1)))
                (= op 6)
                  (do
                    (x64-mov-imm! (mut s) 2 0)
                    (x64-div! (mut s) (x-scratch1))
                    (x64-mov-rr! (mut s) (x-scratch0) 2))
                (= op 7) (x64-and-rr! (mut s) (x-scratch0) (x-scratch1))
                (= op 8) (x64-or-rr! (mut s) (x-scratch0) (x-scratch1))
                (= op 9) (x64-xor-rr! (mut s) (x-scratch0) (x-scratch1))
                ; variable shifts read the count from cl and nowhere else.
                (= op 10)
                  (do
                    (x64-mov-rr! (mut s) 1 (x-scratch1))
                    (x64-shl-cl! (mut s) (x-scratch0)))
                (= op 11)
                  (do
                    (x64-mov-rr! (mut s) 1 (x-scratch1))
                    (if signed
                        (x64-sar-cl! (mut s) (x-scratch0))
                        (x64-shr-cl! (mut s) (x-scratch0))))
                (= op 12)
                  (let [nbits
                          (match t
                            (TInt [n _] n)
                            (_ 64))]
                    (x64-and-ri! (mut s) (x-scratch1) (primitive/isub nbits 1))
                    (x64-mov-rr! (mut s) (x-scratch2) (x-scratch0))
                    (x64-mov-rr! (mut s) 1 (x-scratch1))
                    (x64-shl-cl! (mut s) (x-scratch0))
                    (x64-neg! (mut s) (x-scratch1))
                    (x64-add-ri! (mut s) (x-scratch1) nbits)
                    (x64-mov-rr! (mut s) 1 (x-scratch1))
                    (x64-shr-cl! (mut s) (x-scratch2))
                    (x64-or-rr! (mut s) (x-scratch0) (x-scratch2)))
                (= op 13)
                  (let [nbits
                          (match t
                            (TInt [n _] n)
                            (_ 64))]
                    (x64-and-ri! (mut s) (x-scratch1) (primitive/isub nbits 1))
                    (x64-mov-rr! (mut s) (x-scratch2) (x-scratch0))
                    (x64-mov-rr! (mut s) 1 (x-scratch1))
                    (x64-shr-cl! (mut s) (x-scratch0))
                    (x64-neg! (mut s) (x-scratch1))
                    (x64-add-ri! (mut s) (x-scratch1) nbits)
                    (x64-mov-rr! (mut s) 1 (x-scratch1))
                    (x64-shl-cl! (mut s) (x-scratch2))
                    (x64-or-rr! (mut s) (x-scratch0) (x-scratch2)))
                (= op 14)
                  (let [nbits
                          (match t
                            (TInt [n _] n)
                            (_ 64))]
                    (x64-mul-wide! (mut s) (x-scratch1) signed)
                    (if (= nbits 64)
                        (x64-mov-rr! (mut s) (x-scratch0) 2)
                        (do
                          (x64-shr-imm! (mut s) (x-scratch0) nbits)
                          (x64-shl-imm! (mut s) 2 (primitive/isub 64 nbits))
                          (x64-or-rr! (mut s) (x-scratch0) 2))))
                (or (= op 15)
                    (= op 16))
                  (let [nbits
                          (match t
                            (TInt [n _] n)
                            (_ 64))]
                    (x64-mov-rr! (mut s) (x-scratch2) (x-scratch0))
                    (if (= op 15)
                        (x64-add-rr! (mut s) (x-scratch0) (x-scratch1))
                        (x64-sub-rr! (mut s) (x-scratch0) (x-scratch1)))
                    (if (= nbits 64)
                        (x64-setcc-bool! (mut s)
                                         (if signed 0 (x64-cc-b))
                                         (x-scratch0))
                        (if signed
                            (do
                              (x64-mov-rr! (mut s) (x-scratch1) (x-scratch0))
                              (emit-canon-int! g (x-scratch1) nbits true)
                              (x64-cmp-rr! (mut s) (x-scratch0) (x-scratch1))
                              (x64-setcc-bool! (mut s) (x64-cc-ne) (x-scratch0)))
                            (do
                              (if (= op 15)
                                  (do
                                    (emit-canon-int! g (x-scratch0) nbits false)
                                    (x64-cmp-rr! (mut s)
                                                 (x-scratch0)
                                                 (x-scratch2)))
                                  (x64-cmp-rr! (mut s)
                                               (x-scratch2)
                                               (x-scratch1)))
                              (x64-setcc-bool! (mut s) (x64-cc-b) (x-scratch0))))))
                (= op 17)
                  (do
                    (x64-mul-wide! (mut s) (x-scratch1) signed)
                    (x64-mov-rr! (mut s) (x-scratch2) (x-scratch0))
                    (match t
                      (TInt [n sg] (emit-canon-int! g (x-scratch2) n sg))
                      (_ 0))
                    (x64-cmp-rr! (mut s) (x-scratch0) (x-scratch2))
                    (x64-setcc-bool! (mut s) (x64-cc-ne) (x-scratch1))
                    (if signed
                        (x64-sar-imm! (mut s) (x-scratch2) 63)
                        (x64-mov-imm! (mut s) (x-scratch2) 0))
                    (x64-cmp-rr! (mut s) 2 (x-scratch2))
                    (x64-setcc-bool! (mut s) (x64-cc-ne) (x-scratch0))
                    (x64-or-rr! (mut s) (x-scratch0) (x-scratch1)))
                :else (cgx-fail "unknown integer binary op"))
          (unless (>= op 15)
            (match t
              (TInt [bits sg] (emit-canon-int! g (x-scratch0) bits sg))
              (_ 0)))
          (let [outty
                  (if (>= op 15)
                      (TBool)
                      t)
                (mut outp) outty]
            (let [slot (slot-for-ty! g (mut outp))]
              (emit-store-int! g
                               (x-scratch0)
                               (x-slotbase)
                               slot
                               (ty-size g (mut outp)))
              (mk-aval 1 slot outty)))))))

; ---- comparisons ------------------------------------------------------------
; cmp sets the flags; setcc materializes a 0/1 byte; movzx widens it. The
; signed/unsigned distinction lives entirely in the condition code, and getting
; it wrong is the classic silent miscompile (the arm64 gate proved its teeth by
; catching exactly that), so the two families are spelled out separately.
(defn emit-cmp [(g (ptr Cga)) (op i64) (lhs (ptr Expr)) (rhs (ptr Expr))]
  (-> AVal)
  (emit-cmp-av! g op (emit-expr g lhs) (emit-expr g rhs)))

; AVal-level core of emit-cmp, shared with the llvm-ir line interpreter.
(defn emit-cmp-av! [(g (ptr Cga)) (op i64) (lav AVal) (rav AVal)] (-> AVal)
  (let [(mut t) (av-ty lav)
        s (field g asm)]
    (if (ty-is-float (mut t))
        ; ucomis sets CF/ZF/PF; unordered (NaN) sets PF. The ordered predicates
        ; must therefore also require PF clear, or a NaN compares as "equal".
        (let [dbl
                (= (ty-float-bytes (mut t))
                   8)]
          (av-to-d! g lav 0)
          (av-to-d! g rav 1)
          ; OEQ/ONE compare in the natural operand order; the inequalities below
          ; re-issue the compare with whichever order lets them use a/ae.
          (x64-ucomis! (mut s) dbl 0 1)
          (cond ; OEQ: equal AND ordered  -> sete && setnp
                (= op 4)
                  (do
                    (x64-setcc-bool! (mut s) (x64-cc-e) (x-scratch0))
                    (x64-setcc-bool! (mut s) (x64-cc-np) (x-scratch1))
                    (x64-and-rr! (mut s) (x-scratch0) (x-scratch1))
                    0)
                ; ONE: not-equal AND ordered -> setne && setnp
                (= op 5)
                  (do
                    (x64-setcc-bool! (mut s) (x64-cc-ne) (x-scratch0))
                    (x64-setcc-bool! (mut s) (x64-cc-np) (x-scratch1))
                    (x64-and-rr! (mut s) (x-scratch0) (x-scratch1))
                    0)
                ; The ordered inequalities. An UNORDERED compare (either operand
                ; NaN) leaves CF=ZF=PF=1, which makes `b` and `be` TRUE — so
                ; `setb` for OLT would answer true for NaN < 1.0, which is wrong:
                ; every ordered predicate must be false when unordered. Only `a`
                ; and `ae` are false in the unordered case, so OLT/OLE are emitted
                ; with the OPERANDS SWAPPED and tested with a/ae instead:
                ;     a  <  b   ==   b  >  a   -> ucomis b, a ; seta
                ;     a  <= b   ==   b >= a    -> ucomis b, a ; setae
                ; (the compare above put lhs in xmm0 and rhs in xmm1, so the swap
                ; is just which register goes first in the ucomis.)
                :else
                  (do
                    (if (or (= op 0)
                            (= op 1))
                        (x64-ucomis! (mut s) dbl 1 0)
                        (x64-ucomis! (mut s) dbl 0 1))
                    (x64-setcc-bool! (mut s)
                                     (cond (= op 0) (x64-cc-a)
                                           (= op 1) (x64-cc-ae)
                                           (= op 2) (x64-cc-a)
                                           :else (x64-cc-ae))
                                     (x-scratch0))
                    0))
          (let [slot (slot-new! (native-context g) 8 8)]
            (emit-store-int! g (x-scratch0) (x-slotbase) slot 1)
            (mk-aval 1 slot (TBool))))
        (let [signed
                (match t
                  (TInt [_b sg] sg)
                  (TBool [] false)
                  (_ true))]
          (av-to-x! g lav (x-scratch0))
          (av-to-x! g rav (x-scratch1))
          (x64-cmp-rr! (mut s) (x-scratch0) (x-scratch1))
          (x64-setcc-bool! (mut s)
                           (cond (= op 0) (if signed (x64-cc-l) (x64-cc-b))
                                 (= op 1) (if signed (x64-cc-le) (x64-cc-be))
                                 (= op 2) (if signed (x64-cc-g) (x64-cc-a))
                                 (= op 3) (if signed (x64-cc-ge) (x64-cc-ae))
                                 (= op 4) (x64-cc-e)
                                 :else (x64-cc-ne))
                           (x-scratch0))
          (let [slot (slot-new! (native-context g) 8 8)]
            (emit-store-int! g (x-scratch0) (x-slotbase) slot 1)
            (mk-aval 1 slot (TBool)))))))

;; ---- self-tail-call optimization ------------------------------------------
;; Without this a self-recursive tail call is a real `call`, so a tail-recursive
;; function consumes a frame per iteration and dies of stack exhaustion where the
;; LLVM backend (musttail) and the arm64 backend (the same jump as here) run it in
;; constant space.
;;
;; Eligible when the callee is the function being emitted and the arity matches its
;; recorded parameter slots. Anything else falls back to a normal call, so the
;; optimization can only ever be skipped, never misapplied.
(defn tail-self-callable? [(g (ptr Cga))
                           (func (slice u8))
                           (args (ptr (ArrayList Expr)))] (-> bool)
  (and (> (len (.selfname g)) 0)
       (and (= func (.selfname g))
            (= (len (load args))
               (len (load (load (field g tailslots))))))))

; Evaluate the arguments into FRESH slots first, then copy those into the parameter
; slots, then jump. The two phases are not an optimization detail: `(f b a)` swapping
; its arguments would otherwise overwrite the first parameter before the second
; argument had read it.
(defn emit-tail-self-call! [(g (ptr Cga)) (args (ptr (ArrayList Expr)))]
  (-> AVal)
  (let [n (len (load args))
        (mut tmps) (ArrayList::new [i64] (.a g))]
    (for [i 0 n]
      (let [av (emit-expr g (xal-at [Expr] args i))
            (mut t) (get (load (load (field g tailtys))) i)
            ts (slot-for-ty! g (mut t))]
        (emit-store-av! g av ts)
        (push! (mut tmps) ts)))
    (for [i 0 n]
      (let [(mut t) (get (load (load (field g tailtys))) i)]
        (emit-copy! g
                    (get (load (load (field g tailslots))) i)
                    (get tmps i)
                    (ty-size g (mut t)))))
    (x64-jmp-label! (mut (.asm g)) (.entrylabel g))
    ; the jump never falls through, so the surrounding `if`/body treats this arm as
    ; terminated and emits no result store -- the same path `break` already used.
    (set! (.terminated g) true)
    (mk-aval 0 0 (TInt 64 true))))

; `if` is the one construct that propagates tail position: both branches of a tail
; `if` are themselves in tail position; the CONDITION never is.
(defn emit-if [(g (ptr Cga)) (cnd (ptr Expr)) (thn (ptr Expr)) (els (ptr Expr))]
  (-> AVal)
  (emit-if-tail g cnd thn els false))

(defn emit-if-tail [(g (ptr Cga))
                    (cnd (ptr Expr))
                    (thn (ptr Expr))
                    (els (ptr Expr))
                    (am-tail bool)] (-> AVal)
  (let [cav (emit-expr g cnd)
        s (field g asm)
        lelse (x64-new-label (mut (.asm g)))
        lend (x64-new-label (mut (.asm g)))]
    (av-to-x! g cav (x-scratch0))
    (do
      (x64-test-rr! (mut (.asm g)) (x-scratch0) (x-scratch0))
      (x64-jcc-label! (mut (.asm g)) (x64-cc-e) lelse))
    (set! (.tailok g) am-tail)
    (let [thnav (emit-expr g thn)
          thnterm (.terminated g)
          (mut rslot) -1
          (mut rty) (TInt 64 true)]
      (unless thnterm
        (let [(mut tt) (av-ty thnav)]
          (set! rslot (slot-for-ty! g (mut tt)))
          (set! rty (av-ty thnav))
          (emit-store-av! g thnav (load rslot)))
        (x64-jmp-label! (mut (.asm g)) lend)
        0)
      (set! (.terminated g) false)
      (x64-bind-label! (mut (.asm g)) lelse)
      (set! (.tailok g) am-tail)
      (let [elsav (emit-expr g els)
            elsterm (.terminated g)]
        (unless elsterm
          (let [(mut et) (av-ty elsav)]
            (when (< (load rslot) 0)
              (set! rslot (slot-for-ty! g (mut et)))
              (set! rty (av-ty elsav))
              0)
            (emit-store-av! g elsav (load rslot)))
          0)
        (x64-bind-label! (mut (.asm g)) lend)
        (set! (.terminated g) (and thnterm elsterm))
        (if (>= (load rslot) 0)
            (mk-aval 1 (load rslot) (load rty))
            (mk-aval 0 0 (TInt 64 true)))))))

(defn emit-loop [(g (ptr Cga))
                 (label (Option (slice u8)))
                 (body (ptr (ArrayList Expr)))] (-> AVal)
  (let [s (field g asm)
        contlabel (x64-new-label (mut (.asm g)))
        breaklabel (x64-new-label (mut (.asm g)))
        gl (primitive/alloc-stack GLoop)]
    (set! (.label gl) label)
    (set! (.contlabel gl) contlabel)
    (set! (.breaklabel gl) breaklabel)
    (set! (.resslot gl) -1)
    (set! (.resty gl) (TInt 64 true))
    (set! (.has_res gl) false)
    (push! (mut (.loops g)) (load gl))
    (x64-bind-label! (mut (.asm g)) contlabel)
    (emit-stmts g body)
    (unless (.terminated g)
      (x64-jmp-label! (mut (.asm g)) contlabel)
      0)
    ; pop the loop frame and read its break results
    (let [n (len (.loops g))
          fin (get (.loops g) (primitive/isub n 1))
          fp (primitive/alloc-stack GLoop)]
      (set! fp fin)
      (set! (.len (.loops g)) (primitive/isub n 1))
      (x64-bind-label! (mut (.asm g)) breaklabel)
      (if (.has_res fp)
          (do
            (set! (.terminated g) false)
            (mk-aval 1 (.resslot fp) (.resty fp)))
          (do
            (set! (.terminated g) true)
            (mk-aval 0 0 (TInt 64 true)))))))

(defn emit-break [(g (ptr Cga))
                  (label (Option (slice u8)))
                  (value (Option (ptr Expr)))] (-> AVal)
  (if (.terminated g)
      (mk-aval 0 0 (TInt 64 true))
      (let [av
              (match value
                (Some [ve] (emit-expr g ve))
                (None [] (mk-aval 0 0 (TInt 64 true))))
            li (g-loop-index (native-context g) label)
            lp (xal-at [GLoop] (field g loops) li)]
        (when (< (.resslot lp) 0)
          (let [(mut t) (av-ty av)]
            (set! (.resslot lp) (slot-for-ty! g (mut t)))
            (set! (.resty lp) (av-ty av))
            (set! (.has_res lp) true))
          0)
        (emit-store-av! g av (.resslot lp))
        (x64-jmp-label! (mut (.asm g)) (.breaklabel lp))
        (set! (.terminated g) true)
        (mk-aval 0 0 (TInt 64 true)))))

; ---- casts ------------------------------------------------------------------
; The awkward corner on x86-64 is UNSIGNED 64-bit <-> float: the hardware only
; has signed conversions (cvtsi2sd / cvttsd2si operate on a signed i64), so a
; u64 whose top bit is set has to be handled explicitly rather than fed
; straight to the instruction. Both directions below do that, and both are
; exercised by the int-edges gate.
(defn emit-cast [(g (ptr Cga)) (t Type) (inner (ptr Expr))] (-> AVal)
  (emit-cast-av! g t (emit-expr g inner)))

; AVal-level core of emit-cast, shared with the llvm-ir line interpreter.
(defn emit-cast-av! [(g (ptr Cga)) (t Type) (av AVal)] (-> AVal)
  (let [(mut st) (av-ty av)
        (mut dt)
          (: t
             Type)
        s (field g asm)]
    (match t
      (TInt [dbits dsigned]
            (if (ty-is-float (mut st))
                ; float -> int, truncating toward zero.
                (let [dbl
                        (= (ty-float-bytes (mut st))
                           8)
                      slot
                        (slot-for-ty! g
                                      (mut dt))]
                  (av-to-d! g av 0)
                  (if (and (not dsigned) (>= dbits 64))
                      ; u64 target: values below 2^63 convert directly;
                      ; at or above it, subtract 2^63, convert, and put
                      ; the bit back. cvttsd2si would otherwise saturate
                      ; to 0x8000000000000000 for the whole upper half.
                      (let [lbig (x64-new-label (mut s))
                            ldone (x64-new-label (mut s))]
                        ; xmm1 = (double)2^63, built as 2^62 + 2^62 so the
                        ; constant itself only ever passes through a SIGNED
                        ; conversion (2^63 has no signed i64 representation).
                        (x64-mov-imm64! (mut s)
                                        (x-scratch1)
                                        4611686018427387904)
                        (x64-cvtsi2s! (mut s) dbl 1 (x-scratch1))
                        (x64-adds! (mut s) dbl 1 1)
                        (x64-ucomis! (mut s) dbl 0 1)
                        (x64-jcc-label! (mut s) (x64-cc-ae) lbig)
                        (x64-cvtts2si! (mut s) dbl (x-scratch0) 0)
                        (x64-jmp-label! (mut s) ldone)
                        (x64-bind-label! (mut s) lbig)
                        (x64-subs! (mut s) dbl 0 1)
                        (x64-cvtts2si! (mut s) dbl (x-scratch0) 0)
                        (x64-mov-imm64! (mut s)
                                        (x-scratch1)
                                        -9223372036854775808)
                        (x64-xor-rr! (mut s) (x-scratch0) (x-scratch1))
                        (x64-bind-label! (mut s) ldone)
                        0)
                      (do
                        (x64-cvtts2si! (mut s) dbl (x-scratch0) 0)
                        (emit-canon-int! g (x-scratch0) dbits dsigned)
                        0))
                  (emit-store-int! g
                                   (x-scratch0)
                                   (x-slotbase)
                                   slot
                                   (ty-size g
                                            (mut dt)))
                  (mk-aval 1 slot t))
                ; int/ptr -> int: canonicalize to the destination width
                (let [slot
                        (slot-for-ty! g
                                      (mut dt))]
                  (av-to-x! g av (x-scratch0))
                  (emit-canon-int! g (x-scratch0) dbits dsigned)
                  (emit-store-int! g
                                   (x-scratch0)
                                   (x-slotbase)
                                   slot
                                   (ty-size g
                                            (mut dt)))
                  (mk-aval 1 slot t))))
      (TFloat [dbits]
              (let [ddbl (= dbits 64)
                    slot
                      (slot-for-ty! g
                                    (mut dt))]
                (if (ty-is-float (mut st))
                    (do
                      (av-to-d! g av 0)
                      ; cvts2s' prefix names the SOURCE width
                      (unless (= (ty-float-bytes (mut st))
                                 (/ dbits 8))
                        (x64-cvts2s! (mut s)
                                     (= (ty-float-bytes (mut st))
                                        8)
                                     0
                                     0))
                      (emit-store-fp! g
                                      0
                                      (x-slotbase)
                                      slot
                                      (/ dbits 8))
                      0)
                    ; int -> float, signedness of the SOURCE
                    (let [ssigned
                            (match st
                              (TInt [_b sg] sg)
                              (_ true))
                          sbits
                            (match st
                              (TInt [b _sg] b)
                              (_ 64))]
                      (av-to-x! g av (x-scratch0))
                      (if (and (not ssigned) (>= sbits 64))
                          ; u64 source: if the top bit is clear the signed
                          ; conversion is already exact. Otherwise halve
                          ; (with the low bit preserved so nothing rounds
                          ; away), convert, and double back.
                          (let [lbig (x64-new-label (mut s))
                                ldone (x64-new-label (mut s))]
                            (x64-cmp-ri! (mut s) (x-scratch0) 0)
                            (x64-jcc-label! (mut s) (x64-cc-l) lbig)
                            (x64-cvtsi2s! (mut s) ddbl 0 (x-scratch0))
                            (x64-jmp-label! (mut s) ldone)
                            (x64-bind-label! (mut s) lbig)
                            (x64-mov-rr! (mut s) (x-scratch1) (x-scratch0))
                            (x64-shr-imm! (mut s) (x-scratch1) 1)
                            (x64-mov-rr! (mut s) (x-scratch2) (x-scratch0))
                            (x64-and-ri! (mut s) (x-scratch2) 1)
                            (x64-or-rr! (mut s) (x-scratch1) (x-scratch2))
                            (x64-cvtsi2s! (mut s) ddbl 0 (x-scratch1))
                            (x64-adds! (mut s) ddbl 0 0)
                            (x64-bind-label! (mut s) ldone)
                            0)
                          (do (x64-cvtsi2s! (mut s) ddbl 0 (x-scratch0)) 0))
                      (emit-store-fp! g
                                      0
                                      (x-slotbase)
                                      slot
                                      (/ dbits 8))
                      0))
                (mk-aval 1 slot t)))
      (_  ; ptr / fnptr targets: bit-identical 8-byte move
         (let [slot
                 (slot-for-ty! g
                               (mut dt))]
           (av-to-x! g av (x-scratch0))
           (emit-store-int! g (x-scratch0) (x-slotbase) slot 8)
           (mk-aval 1 slot t))))))

(defn emit-construct [(g (ptr Cga))
                      (sum (slice u8))
                      (variant (slice u8))
                      (args (ptr (ArrayList Expr)))] (-> AVal)
  (let [su (g-sum-idx g sum)]
    (when (< su 0)
      (cgx-fail2 "construct of unknown sum: " sum))
    (let [vidx (g-variant-idx g su variant)
          (mut sumty) (TStruct sum)]
      (let [slot
              (slot-for-ty! g
                            (mut sumty))
            vs (load (field (sum-at (field g layouts) su) variants))
            vfields (load (field (xal-at [Variant] vs vidx) fields))
            n (len (load args))]
        ; tag (i32 at offset 0)
        (x64-mov-imm! (mut (.asm g)) (x-scratch0) vidx)
        (emit-store-int! g (x-scratch0) (x-slotbase) slot 4)
        ; payload fields at their natural offsets within the variant struct
        (for [i 0 n]
          (let [av (emit-expr g (xal-at [Expr] args i))
                off (g-natural-off g vfields i)]
            (emit-store-av-at! g
                               av
                               (primitive/iadd (primitive/iadd slot 8)
                                               off))))
        (mk-aval 1 slot (TStruct sum))))))

; store an AVal at an absolute slot byte offset (may be unaligned-in-slot for
; sub-slot fields — offsets are still 1/2/4/8-aligned by construction).
(defn emit-store-av-at! [(g (ptr Cga)) (av AVal) (dst i64)] (-> i64)
  (let [(mut t) (av-ty av)]
    (if (ty-is-scalar (mut t))
        (do
          (av-to-x! g av (x-scratch0))
          (emit-store-int! g (x-scratch0) (x-slotbase) dst (ty-size g (mut t)))
          0)
        (emit-copy! g dst (av-slot! g av) (ty-size g (mut t))))))

(defn g-runtime-sym! [(g (ptr Cga)) (nm (slice u8))] (-> i64)
  (let [n (len (.syms (.obj g)))
        (mut r) -1]
    (for [i 0 n]
      (when (= (.name (xal-at [ESym]
                              (field (field g obj) syms)
                              i))
               nm)
        (set! r i)))
    (if (>= (load r) 0)
        (load r)
        (eobj-add-sym! (mut (.obj g)) nm 0 0 true))))

; memory load/store with a dynamic address register (widths 1/2/4/8)
(defn emit-match [(g (ptr Cga)) (scrut (ptr Expr)) (arms (ptr (ArrayList Arm)))]
  (-> AVal)
  (let [sav (emit-expr g scrut)
        (mut t) (av-ty sav)
        s (field g asm)
        a (.a g)]
    (let [borrowed
            (match t
              (TPtr [inner] (match (load inner) (TStruct [_] true) (_ false)))
              (_ false))
          sumname
            (match t
              (TStruct [nm] nm)
              (TPtr [inner] (match (load inner) (TStruct [nm] nm) (_ "")))
              (_ ""))
          su (g-sum-idx g sumname)]
      (when (< su 0)
        (cgx-fail2 "match on non-sum: " sumname))
      (let [sslot (av-slot! g sav)
            vs (load (field (sum-at (field g layouts) su) variants))
            narms (len (load arms))
            ; a trailing `(_ …)` arm is the fallthrough, so it gets a label but no
            ; comparison — the chain jumps to it instead of trapping.
            ncases (if (arms-have-wildcard arms) (primitive/isub narms 1) narms)
            lend (x64-new-label (mut (.asm g)))
            (mut armlabels) (ArrayList::new [i64] a)
            (mut rslot) -1
            (mut rty) (TInt 64 true)
            (mut anylive) false]
        ; tag -> x9, then the compare/branch chain
        (if borrowed
            (do
              (emit-load-int! g (x-scratch2) (x-slotbase) sslot 8 false)
              (emit-load-from-mem! g (x-scratch0) (x-scratch2) 4))
            (emit-load-int! g (x-scratch0) (x-slotbase) sslot 4 false))
        (let [(mut i) 0]
          (loop (if (>= (load i) narms)
                    (break)
                    (do
                      (let [arm (xal-at [Arm] arms (load i))
                            lab (x64-new-label (mut (.asm g)))]
                        (push! (mut armlabels) lab)
                        (unless (>= (load i) ncases)
                          (let [vidx
                                  (g-variant-idx g
                                                 su
                                                 (.variant arm))]
                            (x64-mov-imm! (mut (.asm g)) (x-scratch1) vidx)
                            (x64-cmp-rr! (mut s) (x-scratch0) (x-scratch1))
                            (x64-jcc-label! (mut (.asm g)) (x64-cc-e) lab))))
                      (set! i (primitive/iadd (load i) 1))))))
        ; no arm matched: the catch-all if there is one, else unreachable
        (if (= ncases narms)
            (x64-ud2! (mut s))
            (x64-jmp-label! (mut (.asm g)) (get (load armlabels) ncases)))
        ; arms
        (let [(mut i) 0]
          (loop (if (>= (load i) narms)
                    (break)
                    (do
                      (let [arm (xal-at [Arm] arms (load i))
                            ; the catch-all binds nothing, so `vfields` is never read;
                            ; variant 0 just keeps the lookup in range.
                            vidx
                              (if (>= (load i) ncases)
                                  0
                                  (g-variant-idx g su (.variant arm)))
                            vfields
                              (load (field (xal-at [Variant] vs vidx) fields))
                            saved (load (field g env))]
                        (x64-bind-label! (mut (.asm g))
                                         (get (load armlabels) (load i)))
                        (set! (.terminated g) false)
                        ; bind payload fields BY VALUE into fresh slots
                        (let [binds (load (field arm binds))
                              nb (len (load binds))
                              (mut j) 0]
                          (loop (if (>= (load j) nb)
                                    (break)
                                    (do
                                      (let [fty
                                              (.ty (xal-at [Field]
                                                           vfields
                                                           (load j)))
                                            (mut ftp) fty]
                                        (let [foff
                                                (g-natural-off g
                                                               vfields
                                                               (load j))
                                              bname (get (load binds) (load j))
                                              borrowed-binding
                                                (and borrowed
                                                     (starts-with bname
                                                                  "$match.ref."))]
                                          (if borrowed-binding
                                              (let [bslot
                                                      (slot-new! (native-context g)
                                                                 8
                                                                 8)]
                                                (emit-load-int! g
                                                                (x-scratch0)
                                                                (x-slotbase)
                                                                sslot
                                                                8
                                                                false)
                                                (x64-add-ri! (mut s)
                                                             (x-scratch0)
                                                             (primitive/iadd 8
                                                                             foff))
                                                (emit-store-int! g
                                                                 (x-scratch0)
                                                                 (x-slotbase)
                                                                 bslot
                                                                 8)
                                                (set! (.env g)
                                                      (gscope-put a
                                                                  (load (field g
                                                                               env))
                                                                  bname
                                                                  (mk-aval 1
                                                                           bslot
                                                                           (TPtr (box-type a
                                                                                           fty))))))
                                              (let [bslot
                                                      (slot-for-ty! g (mut ftp))]
                                                (if borrowed
                                                    (do
                                                      (emit-load-int! g
                                                                      (x-scratch0)
                                                                      (x-slotbase)
                                                                      sslot
                                                                      8
                                                                      false)
                                                      (x64-add-ri! (mut s)
                                                                   (x-scratch0)
                                                                   (primitive/iadd 8
                                                                                   foff))
                                                      (emit-copy-from-mem! g
                                                                           bslot
                                                                           (x-scratch0)
                                                                           (ty-size g
                                                                                    (mut ftp))))
                                                    (emit-copy! g
                                                                bslot
                                                                (primitive/iadd (primitive/iadd sslot
                                                                                                8)
                                                                                foff)
                                                                (ty-size g
                                                                         (mut ftp))))
                                                (set! (.env g)
                                                      (gscope-put a
                                                                  (load (field g
                                                                               env))
                                                                  bname
                                                                  (mk-aval 1
                                                                           bslot
                                                                           fty)))))))
                                      (set! j (primitive/iadd (load j) 1))))))
                        (let [bav (emit-expr g (field arm body))]
                          (set! (.env g) saved)
                          (unless (.terminated g)
                            (when (< (load rslot) 0)
                              (let [(mut bt) (av-ty bav)]
                                (set! rslot (slot-for-ty! g (mut bt)))
                                (set! rty (av-ty bav)))
                              0)
                            (emit-store-av! g bav (load rslot))
                            (set! anylive true)
                            (x64-jmp-label! (mut (.asm g)) lend)
                            0)))
                      (set! i (primitive/iadd (load i) 1))))))
        (x64-bind-label! (mut (.asm g)) lend)
        (if (load anylive)
            (do
              (set! (.terminated g) false)
              (mk-aval 1 (load rslot) (load rty)))
            (do
              (set! (.terminated g) true)
              (mk-aval 0 0 (TInt 64 true))))))))

(defn emit-call-named [(g (ptr Cga))
                       (func (slice u8))
                       (args (ptr (ArrayList Expr)))] (-> AVal)
  (let [si (g-sig-idx g func)]
    (when (< si 0)
      (cgx-fail2 "call to unknown function: " func))
    (let [e (xal-at [GSig] (field g sigs) si)
          (mut avs) (ArrayList::new [AVal] (.a g))
          n (len (load args))
          (mut dummy) (zeroed AVal)]
      (for [i 0 n]
        (push! (mut avs) (emit-expr g (xal-at [Expr] args i))))
      (set! dummy
            (mk-aval 0 0 (TInt 64 true)))
      (if (.shim e)
          ; register-constrained call: args in the convention's registers,
          ; result read back from its return register.
          (let [s (field g asm)
                regs (load (field e shimregs))
                (mut slots) (ArrayList::new [i64] (.a g))
                (mut j) 0]
            (loop (if (>= (load j) n)
                      (break)
                      (do
                        (push! (mut slots)
                               (av-slot! g (get (load avs) (load j))))
                        (set! j (primitive/iadd (load j) 1)))))
            (set! j 0)
            (loop (if (>= (load j) n)
                      (break)
                      (do
                        (emit-load-int! g
                                        (get (load regs) (load j))
                                        (x-slotbase)
                                        (get (load slots) (load j))
                                        8
                                        false)
                        (set! j (primitive/iadd (load j) 1)))))
            ; two pushes keep the stack's alignment
            (when (.shimsave e)
              (x64-push! (mut s) (x-slotbase))
              (x64-push! (mut s) 5))
            (if (> (len (.inline_code e)) 0)
                (for k (range 0 (len (.inline_code e)))
                  (x64-b! (mut s) (primitive/cast i64 (get (.inline_code e) k))))
                (let [coff (x64-call-rel32! (mut s))]
                  (eobj-add-reloc! (mut (.obj g))
                                   (.text g)
                                   coff
                                   (.symidx e)
                                   (r-x86-64-plt32)
                                   -4)))
            (when (.shimsave e)
              (x64-pop! (mut s) 5)
              (x64-pop! (mut s) (x-slotbase)))
            (let [(mut retp) (.ret e)]
              (if (match (.ret e) (TVoid [] true) (_ false))
                  (mk-aval 0 0 (TInt 64 true))
                  (let [slot (slot-for-ty! g (mut retp))]
                    (emit-store-int! g
                                     (.shimret e)
                                     (x-slotbase)
                                     slot
                                     (ty-size g (mut retp)))
                    (mk-aval 1 slot (.ret e))))))
          ; an extern call crosses the C boundary, so it takes the SysV
          ; by-value aggregate rules; a Coil-to-Coil call does not.
          (emit-call-abi! g
                          (.symidx e)
                          (mut dummy)
                          (load (field e params))
                          (.variadic e)
                          (.ret e)
                          (box-al [AVal] (.a g) (load avs))
                          (.isc e))))))

(defn emit-bitget [(g (ptr Cga)) (p (ptr Expr)) (fname (slice u8))] (-> AVal)
  (let [av (emit-expr g p)
        (mut t) (av-ty av)
        s (field g asm)]
    (let [(mut pt) (ty-pointee (mut t))]
      (match pt
        (TStruct [nm]
                 (let [(mut low) (zeroed i64)
                       (mut width) (zeroed i64)
                       (mut signed) (zeroed bool)
                       (mut back) (zeroed i64)]
                   (g-bits-info (native-context g)
                                nm
                                fname
                                (mut low)
                                (mut width)
                                (mut signed)
                                (mut back))
                   (av-to-x! g av (x-scratch0))
                   (let [wb (bits-window! (mut low) (mut back))]
                     (when (> wb 0) (x64-add-ri! (mut s) (x-scratch0) wb) 0))
                   (emit-load-from-mem! g
                                        (x-scratch0)
                                        (x-scratch0)
                                        (/ back 8))
                   (when (> low
                            0)
                     (x64-shr-imm! (mut s)
                                   (x-scratch0)
                                   low))
                   ; mask/sign-extend to the field width via a shift pair:
                   ; left to drop the high bits, then right — arithmetically
                   ; when the field is signed so the sign bit replicates.
                   (when (< width
                            64)
                     (x64-shl-imm! (mut s)
                                   (x-scratch0)
                                   (primitive/isub 64
                                                   width))
                     (if signed
                         (x64-sar-imm! (mut s)
                                       (x-scratch0)
                                       (primitive/isub 64
                                                       width))
                         (x64-shr-imm! (mut s)
                                       (x-scratch0)
                                       (primitive/isub 64
                                                       width)))
                     0)
                   (let [fty
                           (if (= width
                                  1)
                               (TBool)
                               (TInt width
                                     signed))
                         (mut ftp) fty]
                     (let [slot (slot-for-ty! g (mut ftp))]
                       (emit-store-int! g
                                        (x-scratch0)
                                        (x-slotbase)
                                        slot
                                        (ty-size g (mut ftp)))
                       (mk-aval 1 slot fty)))))
        (_ (do
             (cgx-fail "bit-get through non-struct pointer")
             (mk-aval 0 0 (TInt 64 true))))))))

(defn emit-bitset [(g (ptr Cga))
                   (p (ptr Expr))
                   (fname (slice u8))
                   (val (ptr Expr))] (-> AVal)
  (let [pav (emit-expr g p)
        vav (emit-expr g val)
        (mut t) (av-ty pav)
        s (field g asm)]
    (let [(mut pt) (ty-pointee (mut t))]
      (match pt
        (TStruct [nm]
                 (let [(mut low) (zeroed i64)
                       (mut width) (zeroed i64)
                       (mut signed) (zeroed bool)
                       (mut back) (zeroed i64)]
                   (g-bits-info (native-context g)
                                nm
                                fname
                                (mut low)
                                (mut width)
                                (mut signed)
                                (mut back))
                   ; r11 = container address, r10 = the container word,
                   ; rax/rcx = the mask and value temporaries. The container
                   ; address must survive the whole sequence, so it lives in
                   ; r11 (never touched by the mask arithmetic below).
                   (av-to-x! g pav (x-scratch2))
                   (let [wb (bits-window! (mut low) (mut back))]
                     (when (> wb 0) (x64-add-ri! (mut s) (x-scratch2) wb) 0))
                   (emit-load-from-mem! g
                                        (x-scratch1)
                                        (x-scratch2)
                                        (/ back 8))
                   (let [fieldmask
                           (if (>= width
                                   64)
                               -1
                               (primitive/isub (<< 1 width)
                                               1))]
                     ; rax = ~(fieldmask << low); clear the field in place
                     (x64-mov-imm! (mut s)
                                   (x-scratch0)
                                   (<< fieldmask low))
                     (x64-not! (mut s) (x-scratch0))
                     (x64-and-rr! (mut s) (x-scratch1) (x-scratch0))
                     ; rcx = (value & fieldmask) << low
                     (av-to-x! g vav 1)
                     (x64-mov-imm! (mut s) (x-scratch0) fieldmask)
                     (x64-and-rr! (mut s) 1 (x-scratch0))
                     (when (> low
                              0)
                       (x64-shl-imm! (mut s)
                                     1
                                     low))
                     (x64-or-rr! (mut s) (x-scratch1) 1)
                     (emit-store-to-mem! g
                                         (x-scratch1)
                                         (x-scratch2)
                                         (/ back 8))
                     vav)))
        (_ (do
             (cgx-fail "bit-set through non-struct pointer")
             (mk-aval 0 0 (TInt 64 true))))))))

(defn emit-make-dyn [(g (ptr Cga))
                     (ds (slice u8))
                     (_vt (slice u8))
                     (methods (ptr (ArrayList (slice u8))))
                     (inner (ptr Expr))] (-> AVal)
  (let [a (.a g)
        buf (eobj-sect-buf (mut (.obj g)) (.datasec g))]
    ; the vtable: one 8-byte relocated function pointer per method
    (xb-align! (mut buf) 8)
    (let [vtoff (len (load buf))
          nm (text/format a "l_vtable.{}" (i64->str a (.nglob g)))]
      (set! (.nglob g) (primitive/iadd (.nglob g) 1))
      (let [n (len (load methods))
            (mut i) 0]
        (loop (if (>= (load i) n)
                  (break)
                  (do
                    (let [mnm (get (load methods) (load i))
                          msi (g-sig-idx g mnm)]
                      (when (< msi 0)
                        (cgx-fail2 "make-dyn: unknown method " mnm))
                      ; a vtable slot is an absolute 64-bit pointer to the method,
                      ; so it takes an R_X86_64_64 with a zero addend.
                      (eobj-add-reloc! (mut (.obj g))
                                       (.datasec g)
                                       (len (load buf))
                                       (.symidx (xal-at [GSig]
                                                        (field g sigs)
                                                        msi))
                                       (r-x86-64-64)
                                       0)
                      (xb-u64! (mut buf) 0))
                    (set! i (primitive/iadd (load i) 1))))))
      (let [vtsym (eobj-add-sym! (mut (.obj g)) nm (.datasec g) vtoff false)
            iav (emit-expr g inner)
            slot (slot-new! (native-context g) 16 8)]
        ; dyn object { data, vtable } by value
        (av-to-x! g iav (x-scratch0))
        (emit-store-int! g (x-scratch0) (x-slotbase) slot 8)
        (emit-sym-addr! g (x-scratch0) vtsym)
        (emit-store-int! g (x-scratch0) (x-slotbase) (primitive/iadd slot 8) 8)
        (mk-aval 1 slot (TStruct ds))))))

(defn emit-dyn-dispatch [(g (ptr Cga))
                         (_ds (slice u8))
                         (_vt (slice u8))
                         (mi i64)
                         (_cc (slice u8))
                         (params (ptr (ArrayList Type)))
                         (ret Type)
                         (recv (ptr Expr))
                         (args (ptr (ArrayList Expr)))] (-> AVal)
  (let [a (.a g)
        rav (emit-expr g recv)
        rslot (av-slot! g rav)
        ; fnptr = vtable[mi]
        fpslot (slot-new! (native-context g) 8 8)
        dataslot (slot-new! (native-context g) 8 8)]
    ; data ptr
    (emit-load-int! g (x-scratch0) (x-slotbase) rslot 8 false)
    (emit-store-int! g (x-scratch0) (x-slotbase) dataslot 8)
    ; vtable -> method fnptr
    (emit-load-int! g
                    (x-scratch0)
                    (x-slotbase)
                    (primitive/iadd rslot 8)
                    8
                    false)
    (x64-mov-rm! (mut (.asm g)) (x-scratch0) (x-scratch0) (primitive/imul mi 8))
    (emit-store-int! g (x-scratch0) (x-slotbase) fpslot 8)
    ; assemble [data, args...] and the full param list [ptr, params...]
    (let [(mut avs) (ArrayList::new [AVal] a)
          (mut ptys) (ArrayList::new [Type] a)
          (mut fpav) (zeroed AVal)]
      (push! (mut ptys) (TPtr (box-type a (TInt 8 true))))
      (let [np (len (load params))
            (mut i) 0]
        (loop (if (>= (load i) np)
                  (break)
                  (do
                    (push! (mut ptys) (get (load params) (load i)))
                    (set! i (primitive/iadd (load i) 1))))))
      (push! (mut avs) (mk-aval 1 dataslot (TPtr (box-type a (TInt 8 true)))))
      (let [na (len (load args))
            (mut i) 0]
        (loop (if (>= (load i) na)
                  (break)
                  (do
                    (push! (mut avs)
                           (emit-expr g (xal-at [Expr] args (load i))))
                    (set! i (primitive/iadd (load i) 1))))))
      (set! fpav
            (mk-aval 1
                     fpslot
                     (TFn
                       :cc (cc-c)
                       :params (box-al [Type] a (load ptys))
                       :ret (box-type a ret))))
      (emit-call! g
                  -1
                  (mut fpav)
                  (box-al [Type] a (load ptys))
                  false
                  ret
                  (box-al [AVal] a (load avs))))))

; parse a (possibly negative) decimal integer token — llvm-ir literals.
; TAIL POSITION is CONSUMED here. Every entry to emit-expr clears the flag into a
; local, so a construct that does not explicitly re-arm it cannot leak tail-ness to
; its children. `if` re-arms it for its two branches.
(defn emit-expr [(g (ptr Cga)) (e (ptr Expr))] (-> AVal)
  (dw-note-span! g e)
  (let [am-tail (.tailok g)]
    (set! (.tailok g) false)
    (match (.kind e)
      (EIf [cnd thn els] (emit-if-tail g cnd thn els am-tail))
      (ECall [func targs args]
             (if (and am-tail (tail-self-callable? g func args))
                 (emit-tail-self-call! g args)
                 (emit-expr-rest g e)))
      ; a never-returning self call in tail position is a jump too (ast.coil,
      ; diverging-call)
      (EDo [_]
           (match (diverging-call e)
             (Some [call]
                   (match (.kind call)
                     (ECall [func _ args]
                            (if (and am-tail (tail-self-callable? g func args))
                                (emit-tail-self-call! g args)
                                (emit-expr-rest g e)))
                     (_ (emit-expr-rest g e))))
             (None [] (emit-expr-rest g e))))
      (_ (emit-expr-rest g e)))))

(defn emit-expr-rest [(g (ptr Cga)) (e (ptr Expr))] (-> AVal)
  (match (.kind e)
    (EAnonFn [_ _] (do (abort) (zeroed AVal)))
    (EDefer [_ _]
            (do
              (cgx-fail "a (defer …) region reached the backend before ownership elaboration lowered it")
              (zeroed AVal)))
    (EBracketCall [_ _ _ _]
                  (do
                    (cgx-fail "a bracket call reached the backend before resolution chose its reading")
                    (zeroed AVal)))
    (EFnPtrInst [_ _]
                (do
                  (cgx-fail "a generic function's pointer reached the backend unspecialized")
                  (zeroed AVal)))
    (EInt [v] (mk-aval 0 v (TInt 64 true)))
    (EWideInt [_ _ _ _ text]
              (do
                (cgx-fail2 "128-bit integers are not supported by the x64 backend yet; build with the LLVM backend: "
                           text)
                (zeroed AVal)))
    (EFloat [bits] (mk-aval 2 bits (TFloat 64)))
    (EBool [b] (mk-aval 0 (when b 1) (TBool)))
    (EStr [sv]
          (let [sym
                  (g-intern-str! g sv true)  ; NUL-terminate the backing bytes (slice len below is separate)
                a (.a g)
                slot (slot-new! (native-context g) 16 8)]
            (emit-sym-addr! g (x-scratch0) sym)
            (emit-store-int! g (x-scratch0) (x-slotbase) slot 8)
            (x64-mov-imm! (mut (.asm g)) (x-scratch0) (len sv))
            (emit-store-int! g
                             (x-scratch0)
                             (x-slotbase)
                             (primitive/iadd slot 8)
                             8)
            (mk-aval 1 slot (TSlice (box-type a (TInt 8 false))))))
    (ECStr [sv]
           (let [sym (g-intern-str! g sv true)
                 a (.a g)
                 slot (slot-new! (native-context g) 8 8)]
             (emit-sym-addr! g (x-scratch0) sym)
             (emit-store-int! g (x-scratch0) (x-slotbase) slot 8)
             (mk-aval 1 slot (TPtr (box-type a (TInt 8 true))))))
    (EVar [name]
          (match (gscope-get (load (field g env)) name)
            (Some [av] av)
            (None []
                  (do
                    (cgx-fail2 "unbound variable: " name)
                    (mk-aval 0 0 (TInt 64 true))))))
    (EZeroed [t]
             (let [(mut tp) t]
               (let [slot (slot-for-ty! g (mut tp))]
                 (emit-zero! g slot (ty-size g (mut tp)))
                 (mk-aval 1 slot t))))
    (ERecordInit [t]
                 (let [(mut tp) t]
                   (let [slot (slot-for-ty! g (mut tp))]
                     (emit-zero! g slot (ty-size g (mut tp)))
                     (mk-aval 1 slot t))))
    (EBorrow [_m place] (emit-expr g place))
    (ESpillRef [inner]
               (let [av (emit-expr g inner)
                     a (.a g)
                     vslot (av-slot! g av)
                     pslot (slot-new! (native-context g) 8 8)]
                 (emit-slot-addr! g (x-scratch0) vslot)
                 (emit-store-int! g (x-scratch0) (x-slotbase) pslot 8)
                 (mk-aval 1 pslot (TPtr (box-type a (av-ty av))))))
    (EMovePlace [_]
                (do
                  (cgx-fail "EMovePlace survived monomorphization (compiler bug)")
                  (mk-aval 0 0 (TInt 64 true))))
    (ELet [binds body]
          (let [saved (load (field g env))
                first-var (len (.dwvars g))]
            (emit-binds g binds)
            (let [r (emit-body g body)
                  here (x64-off (mut (.asm g)))]
              ; the let's locals go out of scope here
              (for v (range first-var (len (.dwvars g)))
                (let [dv (xal-at [DwVar] (field g dwvars) v)]
                  (when (< (.end dv) 0) (set! (.end dv) here))))
              (set! (.env g) saved)
              r)))
    (EDo [body] (emit-body g body))
    (ECleanup [body cleanups]
              (let [result (emit-expr g body)]
                (emit-body g cleanups)
                result))
    (EBin [op lhs rhs] (emit-bin g op lhs rhs))
    (ECmp [op lhs rhs] (emit-cmp g op lhs rhs))
    (EIntUnary [op inner] (emit-int-unary g op inner))
    (EIf [cnd thn els] (emit-if g cnd thn els))
    (ELoop [label body] (emit-loop g label body))
    (EBreak [label value] (emit-break g label value))
    (EContinue [label]
               (do
                 (let [li (g-loop-index (native-context g) label)]
                   (x64-jmp-label! (mut (.asm g))
                                   (.contlabel (xal-at [GLoop]
                                                       (field g
                                                              loops)
                                                       li)))
                   (set! (.terminated g) true))
                 (mk-aval 0 0 (TInt 64 true))))
    (ECall [func _targs args] (emit-call-named g func args))
    (ENamedCall [_func _targs _names _args]
                (do
                  (cgx-fail "named constructor call survived type checking")
                  (mk-aval 0 0 (TInt 64 true))))
    (ECallPtr [fp args]
              (let [(mut fpav) (emit-expr g fp)]
                (let [(mut t) (av-ty fpav)]
                  (match t
                    (TFn [_cc params ret]
                         (let [(mut avs) (ArrayList::new [AVal] (.a g))
                               n (len (load args))]
                           (for [i 0 n]
                             (push! (mut avs)
                                    (emit-expr g
                                               (xal-at [Expr]
                                                       args
                                                       i))))
                           (emit-call! g
                                       -1
                                       (mut fpav)
                                       params
                                       false
                                       (load ret)
                                       (box-al [AVal] (.a g) (load avs)))))
                    (_ (do
                         (cgx-fail "call-ptr on non-fnptr value")
                         (mk-aval 0 0 (TInt 64 true))))))))
    (EAlloc [storage t init symbol]
            (let [a (.a g)
                  (mut tp) t]
              (if (or (= storage 0)
                      (= storage 3))
                  ; stack: a per-function-execution frame slot
                  (let [slot
                          (slot-for-ty! g
                                        (mut tp))
                        pslot (slot-new! (native-context g) 8 8)]
                    (emit-slot-addr! g (x-scratch0) slot)
                    (emit-store-int! g (x-scratch0) (x-slotbase) pslot 8)
                    (mk-aval 1 pslot (TPtr (box-type a t))))
                  (if (= storage 2)
                      ; heap: call malloc(size)
                      ; ELF/Linux libc symbols carry no leading underscore
                      ; (that is the Mach-O convention), and the size argument
                      ; goes in rdi under SysV.
                      (let [msym (g-runtime-sym! g "malloc")
                            slot (slot-new! (native-context g) 8 8)]
                        (x64-mov-imm! (mut (.asm g))
                                      7
                                      (ty-size g
                                               (mut tp)))
                        (let [coff (x64-call-rel32! (mut (.asm g)))]
                          (eobj-add-reloc! (mut (.obj g))
                                           (.text g)
                                           coff
                                           msym
                                           (r-x86-64-plt32)
                                           -4))
                        (emit-store-int! g 0 (x-slotbase) slot 8)
                        (mk-aval 1 slot (TPtr (box-type a t))))
                      ; static: one persistent data symbol per allocation site,
                      ; laid down with its link-time constant initializer.
                      (let [sym
                              (match symbol
                                (Some [name]
                                      (g-public-zero-global! g
                                                             name
                                                             (ty-size g
                                                                      (mut tp))
                                                             (ty-align g
                                                                       (mut tp))))
                                (None []
                                      (g-zero-global! g
                                                      (ty-size g
                                                               (mut tp))
                                                      (ty-align g
                                                                (mut tp)))))
                            ms (xal-at [ESym] (field (field g obj) syms) sym)
                            pslot (slot-new! (native-context g) 8 8)]
                        (when (!= (primitive/cast i64 init) 0)
                          (g-static-write! g
                                           (mut tp)
                                           init
                                           (.sect ms)
                                           (.off ms)))
                        (emit-sym-addr! g (x-scratch0) sym)
                        (emit-store-int! g (x-scratch0) (x-slotbase) pslot 8)
                        (mk-aval 1 pslot (TPtr (box-type a t))))))))
    (EAccessorField [p fname]
                    (emit-expr g
                               (box-expr (.a g)
                                         (expr-at e (EField p fname)))))
    (EField [p fname]
            (let [av (emit-expr g p)
                  a (.a g)
                  (mut t) (av-ty av)]
              (let [(mut pt) (ty-pointee (mut t))]
                (match pt
                  (TStruct [nm]
                           (let [si (g-struct-idx g nm)]
                             (when (< si 0)
                               (cgx-fail2 "field access on non-struct: " nm))
                             (let [fi (g-field-idx g si fname)
                                   off (g-field-off g si fi)
                                   fty
                                     (.ty (xal-at [Field]
                                                  (load (field (struct-at (field g
                                                                                 layouts)
                                                                          si)
                                                               fields))
                                                  fi))
                                   slot (slot-new! (native-context g) 8 8)]
                               (av-to-x! g av (x-scratch0))
                               (if (<= off 4095)
                                   (x64-add-ri! (mut (.asm g)) (x-scratch0) off)
                                   (do
                                     (x64-mov-imm! (mut (.asm g))
                                                   (x-scratch1)
                                                   off)
                                     (x64-add-rr! (mut (.asm g))
                                                  (x-scratch0)
                                                  (x-scratch1))
                                     0))
                               (emit-store-int! g
                                                (x-scratch0)
                                                (x-slotbase)
                                                slot
                                                8)
                               (mk-aval 1 slot (TPtr (box-type a fty))))))
                  (_ (do
                       (cgx-fail "field access through non-struct pointer")
                       (mk-aval 0 0 (TInt 64 true))))))))
    (ELoad [inner]
           (let [av (emit-expr g inner)
                 a (.a g)
                 (mut t) (av-ty av)]
             (let [(mut pt) (ty-pointee (mut t))]
               (let [sz (ty-size g (mut pt))
                     slot (slot-for-ty! g (mut pt))]
                 (av-to-x! g av (x-scratch0))
                 (if (<= sz 8)
                     (do
                       (emit-load-from-mem! g (x-scratch1) (x-scratch0) sz)
                       (emit-store-int! g (x-scratch1) (x-slotbase) slot sz)
                       0)
                     (emit-copy-from-mem! g slot (x-scratch0) sz))
                 (mk-aval 1 slot pt)))))
    (EStore [p val]
            (let [pav (emit-expr g p)
                  vav (emit-expr g val)
                  (mut t) (av-ty vav)]
              (let [sz
                      (ty-size g
                               (mut t))]
                (if (ty-is-scalar (mut t))
                    (do
                      (av-to-x! g vav (x-scratch1))
                      (av-to-x! g pav (x-scratch0))
                      (emit-store-to-mem! g (x-scratch1) (x-scratch0) sz)
                      0)
                    (do
                      (av-to-x! g pav (x-scratch0))
                      (emit-copy-to-mem! g (x-scratch0) (av-slot! g vav) sz)
                      0))
                ; std-12: store! yields unit (canonical i64 0), matching its checked type.
                (mk-aval 0 0 (TInt 64 true)))))
    (EInitStore [p val]
                (let [pav (emit-expr g p)
                      vav (emit-expr g val)
                      (mut t) (av-ty vav)]
                  (let [sz (ty-size g (mut t))]
                    (if (ty-is-scalar (mut t))
                        (do
                          (av-to-x! g vav (x-scratch1))
                          (av-to-x! g pav (x-scratch0))
                          (emit-store-to-mem! g (x-scratch1) (x-scratch0) sz)
                          0)
                        (do
                          (av-to-x! g pav (x-scratch0))
                          (emit-copy-to-mem! g (x-scratch0) (av-slot! g vav) sz)
                          0))
                    (mk-aval 0 0 (TInt 64 true)))))
    (EIndex [p idx]
            (let [pav (emit-expr g p)
                  iav (emit-expr g idx)
                  a (.a g)
                  (mut t) (av-ty pav)]
              (let [(mut pt) (ty-pointee (mut t))]
                ; pointer-to-array indexes elements of the array; otherwise the pointee
                (let [(mut ep) (zeroed Type)]
                  (match pt
                    (TArray [elem _n] (set! ep (load elem)))
                    (_ (set! ep pt)))
                  (let [esz (ty-size g (mut ep))
                        slot (slot-new! (native-context g) 8 8)]
                    (av-to-x! g pav (x-scratch0))
                    (av-to-x! g iav (x-scratch1))
                    (x64-mov-imm! (mut (.asm g)) (x-scratch2) esz)
                    (do
                      (x64-imul-rr! (mut (.asm g)) (x-scratch1) (x-scratch2))
                      (x64-add-rr! (mut (.asm g)) (x-scratch0) (x-scratch1))
                      0)
                    (emit-store-int! g (x-scratch0) (x-slotbase) slot 8)
                    (mk-aval 1 slot (TPtr (box-type a ep))))))))
    (ECast [t inner] (emit-cast g t inner))
    (ESizeOf [t]
             (let [(mut tp) t] (mk-aval 0 (ty-size g (mut tp)) (TInt 64 true))))
    (EAlignOf [t]
              (let [(mut tp) t]
                (mk-aval 0 (ty-align g (mut tp)) (TInt 64 true))))
    (EOffsetOf [t fname]
               (let [(mut tp) t]
                 (match t
                   (TStruct [nm]
                            (let [si (g-struct-idx g nm)]
                              (when (< si 0)
                                (cgx-fail2 "offset-of on non-struct: " nm))
                              (mk-aval 0
                                       (g-field-off g
                                                    si
                                                    (g-field-idx g si fname))
                                       (TInt 64 true))))
                   (_ (do
                        (cgx-fail "offset-of on non-struct type")
                        (mk-aval 0 0 (TInt 64 true)))))))
    (EFree [inner]
           (let [av (emit-expr g inner)
                 fsym (g-runtime-sym! g "free")]
             ; SysV passes the pointer in rdi, not x0.
             (av-to-x! g av 7)
             (let [coff (x64-call-rel32! (mut (.asm g)))]
               (eobj-add-reloc! (mut (.obj g))
                                (.text g)
                                coff
                                fsym
                                (r-x86-64-plt32)
                                -4))
             (mk-aval 0 0 (TInt 64 true))))
    (EConstruct [sum variant args] (emit-construct g sum variant args))
    (EMatch [scrut arms] (emit-match g scrut arms))
    (EFnPtrOf [name0]
              (let [name (g-fnptr-target g name0)
                    si (g-sig-idx g name)]
                (when (< si 0)
                  (cgx-fail2 "fnptr-of unknown function: " name))
                (let [e (xal-at [GSig] (field g sigs) si)
                      slot (slot-new! (native-context g) 8 8)]
                  (emit-sym-addr! g (x-scratch0) (.symidx e))
                  (emit-store-int! g (x-scratch0) (x-slotbase) slot 8)
                  (mk-aval 1
                           slot
                           (TFn
                             :cc (cc-c)
                             :params (load (field e params))
                             :ret
                               (box-type (.a g)
                                         (.ret e)))))))
    (EBitGet [p fname] (emit-bitget g p fname))
    (EBitSet [p fname val] (emit-bitset g p fname val))
    (ELlvmIr [result args body] (emit-llvmir g result args body))
    (EIntrinsic [op result args] (emit-intrinsic g op result args))
    (EVector [op result types args]
             (let [a (.a g)
                   saved (.env g)
                   (mut values) (ArrayList::new [AVal] a)]
               ; Evaluate all operands in the caller's environment before binding any
               ; generated names. This makes the scalar fallback hygienic and once-only.
               (for [i 0 (len (load args))]
                 (push! (mut values) (emit-expr g (elem args i))))
               (for [i 0 (len (load args))]
                 (set! (.env g)
                       (gscope-put a
                                   (.env g)
                                   (vs-argument-name a i)
                                   (get (load values) i))))
               (let [lowered
                       (match (scalarize-vector a op (box-type a result) types)
                         (Ok [expr] expr)
                         (Err [d]
                              (do
                                (let [diag d] (cgx-fail (.msg diag)))
                                (mk-expr (EInt 0) -1 -1 -1 0))))
                     value (emit-expr g (box-expr a lowered))]
                 (set! (.env g) saved)
                 value)))
    (EMakeDyn [ds vt methods inner] (emit-make-dyn g ds vt methods inner))
    (EDynDispatch [dc]
                  (let [ds (.dyn_struct dc)
                        vt (.vtable_struct dc)
                        mi (.method_index dc)
                        cc (.cc dc)
                        params (.params dc)
                        ret (.ret dc)
                        recv (.recv dc)
                        args (.args dc)]
                    (emit-dyn-dispatch g ds vt mi cc params ret recv args)))
    (EStaticRef [name]
                (let [si (g-static-idx g name)]
                  (if (< si 0)
                      (do
                        (cgx-fail2 "static-ref references an unknown def: "
                                   name)
                        (mk-aval 0 0 (TInt 64 true)))
                      (let [st (xal-at [GStatic] (field g statics) si)
                            slot (slot-new! (native-context g) 8 8)]
                        (emit-sym-addr! g (x-scratch0) (.symidx st))
                        (emit-store-int! g (x-scratch0) (x-slotbase) slot 8)
                        (mk-aval 1 slot (TPtr (box-type (.a g) (.ty st))))))))
    (EErase [_t _i]
            (do
              (cgx-fail "EErase reached codegen (checker bug)")
              (mk-aval 0 0 (TInt 64 true))))
    (ETraitCall [_a _b _c _d]
                (do
                  (cgx-fail "ETraitCall reached codegen (mono bug)")
                  (mk-aval 0 0 (TInt 64 true))))
    (EComptime [_]
               (do
                 (cgx-fail "EComptime reached codegen")
                 (mk-aval 0 0 (TInt 64 true))))
    (EAscribe [_t _i]
              (do
                (cgx-fail "EAscribe reached codegen (checker should have lowered (: v t) to its coerced value)")
                (mk-aval 0 0 (TInt 64 true))))
    (EPattern [pattern-op _t _i pattern-index]
              (do
                (cgx-fail "EPattern reached codegen (checker should have lowered (: v t) to its coerced value)")
                (mk-aval 0 0 (TInt 64 true))))
    (EArrayLit [_]
               (do
                 (cgx-fail "EArrayLit reached codegen (checker bug)")
                 (mk-aval 0 0 (TInt 64 true))))
    (EStaticArray [_ _]
                  (do
                    (cgx-fail "static :elements escaped its allocation initializer")
                    (mk-aval 0 0 (TInt 64 true))))
    (EMakeSlice [data elem len]
                (let [dv (emit-expr g data)
                      a (.a g)
                      slot (slot-new! (native-context g) 16 8)]
                  (av-to-x! g dv (x-scratch0))
                  (emit-store-int! g (x-scratch0) (x-slotbase) slot 8)
                  (x64-mov-imm! (mut (.asm g)) (x-scratch0) (extent-value len))
                  (emit-store-int! g
                                   (x-scratch0)
                                   (x-slotbase)
                                   (primitive/iadd slot 8)
                                   8)
                  (mk-aval 1 slot (TSlice (box-type a elem)))))
    (ETypeQuery [_q _t]
                (do
                  (cgx-fail "ETypeQuery reached codegen")
                  (mk-aval 0 0 (TInt 64 true))))
    (EConstParam [_ _]
                 (do
                   (cgx-fail "unspecialized value parameter reached codegen (compiler bug)")
                   (mk-aval 0 0 (TInt 64 true))))
    (EFieldMeta [_m _t _i]
                (do
                  (cgx-fail "EFieldMeta reached codegen")
                  (mk-aval 0 0 (TInt 64 true))))
    (EFieldIndex [_t _n]
                 (do
                   (cgx-fail "EFieldIndex reached codegen")
                   (mk-aval 0 0 (TInt 64 true))))
    (EQuote [_]
            (do
              (cgx-fail "EQuote reached codegen")
              (mk-aval 0 0 (TInt 64 true))))
    (ECodeOp [_o _a]
             (do
               (cgx-fail "ECodeOp reached codegen")
               (mk-aval 0 0 (TInt 64 true))))
    (EQuasi [_]
            (do
              (cgx-fail "EQuasi reached codegen")
              (mk-aval 0 0 (TInt 64 true))))))

; lazily-declared runtime symbols (malloc/free used by EAlloc heap / EFree).

;; A type's DwTy index (debuginfo.coil's shared translation), or -1.
(defn dw-ty-of! [(g (ptr Cga)) (t (ptr Type))] (-> i64)
  (dbg-ty-of! (field g dwtypes) (field g layouts) (.a g) t))

; record a line-table row if the source position moved
(defn dw-note-var! [(g (ptr Cga))
                    (name (slice u8))
                    (t (ptr Type))
                    (slot i64)
                    (indirect bool)
                    (param bool)
                    (src i64)
                    (lo i64)] (-> i64)
  (let [ti (if (dbg-name? name) (dw-ty-of! g t) -1)]
    (unless (or (< ti 0)
                (< src 0)
                (< lo 0))
      (let [(mut v) (zeroed DwVar)]
        (set! (.name v)
              name)
        (set! (.tyidx v)
              ti)
        (set! (.slot v)
              slot)
        (set! (.indirect v)
              indirect)
        (set! (.param v)
              param)
        (set! (.source v)
              src)
        (set! (.lo v)
              lo)
        ; a local is live from here (its initializer has been emitted); a
        ; parameter is live for the whole function
        (set! (.start v)
              (if param -1 (x64-off (mut (.asm g)))))
        (set! (.end v)
              -1)
        (push! (mut (.dwvars g))
               v)
        0))))

(defn dw-note-bind! [(g (ptr Cga))
                     (name (slice u8))
                     (av AVal)
                     (src i64)
                     (lo i64)] (-> i64)
  (let [n (len name)
        (mut t) (av-ty av)]
    (unless (and (>= n 5)
                 (= (subslice name (primitive/isub n 5) n) ".slot"))
      (let [slotname (text/format (.a g) "{}.slot" name)]
        (match (gscope-get (load (field g env)) slotname)
          (Some [_sl]
                ; mut variable: value lives behind the pointer
                (match t
                  (TPtr [inner]
                        (dw-note-var! g name inner (av-v av) true false src lo))
                  (_ (dw-note-var! g
                                   name
                                   (mut t)
                                   (av-v av)
                                   false
                                   false
                                   src
                                   lo))))
          (None []
                (dw-note-var! g
                              name
                              (mut t)
                              (av-v av)
                              false
                              false
                              src
                              lo)))))))

; record a variable/parameter DIE for the current function
(defn dw-note-span! [(g (ptr Cga)) (e (ptr Expr))] (-> i64)
  (let [src (.source e)
        lo (.lo e)]
    (unless (or (< src 0)
                (< lo 0)
                (and (= src (.dwcursrc g))
                     (= lo
                        (.dwcurlo g))))
      (let [(mut ev) (zeroed DwLineEv)]
        (set! (.textoff ev) (x64-off (mut (.asm g))))
        (set! (.source ev) src)
        (set! (.lo ev) lo)
        (set! (.pe ev) false)
        (push! (mut (.dwevs g)) ev)
        (set! (.dwcursrc g) src)
        (set! (.dwcurlo g) lo)
        0))))

; DWARF note for a let bind. `(mut x)` desugars to `x.slot` (the alloc) plus
; `x` (a pointer to it): skip the internal `.slot` name and describe `x` as an
; indirect variable of the POINTEE type (location: fbreg off, deref).

(defstruct X64IrErrors [])

(impl irs/IrErrors X64IrErrors
  (ir-error [(self X64IrErrors) (message (slice u8)) (token (slice u8))]
    (-> i64)
    (cgx-fail2 message token)))

(defn str->i64 [(s (slice u8))] (-> i64)
  (irs/integer (zeroed X64IrErrors) s))

(defn ir-tokens [(a (dyn Allocator)) (line (slice u8))]
  (-> (ptr (ArrayList (slice u8))))
  (irs/tokenize a line))

; parse a (possibly negative) plain-decimal float token — llvm-ir literals
; (`<float 0.0, float 1.0, ...>`). The corpus never uses exponents, so a small
; hand-rolled parser avoids pulling in an extra `extern strtod` declaration
; that would collide with the one other modules already link in (gotcha:
; extern decls aren't deduped across modules).
(defn str->f64 [(s (slice u8))] (-> f64)
  (irs/floating (zeroed X64IrErrors) s))

; aggregate element info for extractvalue/insertvalue: given the agg type and
; element index, produce (offset, element type).
(defn ir-agg-elem [(g (ptr Cga)) (t (ptr Type)) (idx i64) (offp (ptr i64))]
  (-> Type)
  (match (load t)
    (TSlice [elem]
            (if (= idx 0)
                (do (set! offp 0) (TPtr elem))
                (do (set! offp 8) (TInt 64 true))))
    (TStruct [nm]
             (let [si (g-struct-idx g nm)]
               (when (< si 0)
                 (cgx-fail2 "llvm-ir: extract from unknown struct " nm))
               (set! offp (g-field-off g si idx))
               (.ty (xal-at [Field]
                            (load (field (struct-at (field g
                                                           layouts)
                                                    si)
                                         fields))
                            idx))))
    (_ (do
         (cgx-fail "llvm-ir: extract/insert on unsupported aggregate")
         (TInt 64 true)))))

; bind an SSA name to a value in the llvm-ir line interpreter's environment.

; i128 (our synthetic 16-byte TSlice blob) only supports eq/ne, via a plain
; 16-byte memory compare — nothing in the corpus needs an ordered i128 compare.
(defn ir-icmp-i128! [(g (ptr Cga)) (pred (slice u8)) (lav AVal) (rav AVal)]
  (-> AVal)
  (unless (or (= pred "eq") (= pred "ne"))
    (cgx-fail2 "llvm-ir: unsupported i128 icmp predicate (only eq/ne supported): "
               pred))
  (let [ls (av-slot! g lav)
        rs (av-slot! g rav)
        s (field g asm)]
    (emit-load-int! g (x-scratch0) (x-slotbase) ls 8 false)
    (emit-load-int! g (x-scratch1) (x-slotbase) rs 8 false)
    (x64-xor-rr! (mut s) (x-scratch0) (x-scratch1))
    (emit-load-int! g (x-scratch1) (x-slotbase) (primitive/iadd ls 8) 8 false)
    (emit-load-int! g (x-scratch2) (x-slotbase) (primitive/iadd rs 8) 8 false)
    (x64-xor-rr! (mut s) (x-scratch1) (x-scratch2))
    (x64-or-rr! (mut s) (x-scratch0) (x-scratch1))
    (x64-cmp-ri! (mut s) (x-scratch0) 0)
    (x64-setcc-bool! (mut s)
                     (if (= pred "eq") (x64-cc-e) (x64-cc-ne))
                     (x-scratch0))
    (let [slot (slot-new! (native-context g) 8 8)]
      (emit-store-int! g (x-scratch0) (x-slotbase) slot 1)
      (mk-aval 1 slot (TBool)))))

; branch-free select on values ≤8 bytes (scalar, or one vector lane): blend
; the raw bits of `aav`/`bav` by `maskav` (0/1) sign-extended to all-0s/all-1s.
; av-to-x!/emit-store-int! already move floats by raw bit pattern, so this
; works uniformly for int and float lanes without a separate float path.
(defn ir-select-blend! [(g (ptr Cga)) (maskav AVal) (aav AVal) (bav AVal)]
  (-> AVal)
  (let [(mut t) (av-ty aav)
        s (field g asm)]
    (let [sz
            (ty-size g
                     (mut t))]
      (av-to-x! g maskav (x-scratch0))
      (x64-neg! (mut s) (x-scratch0))
      ; 0/1 -> 0x0/0xFFFF...FFFF
      (av-to-x! g aav (x-scratch1))
      (av-to-x! g bav (x-scratch2))
      (x64-and-rr! (mut s) (x-scratch1) (x-scratch0))
      (x64-not! (mut s) (x-scratch0))
      (x64-and-rr! (mut s) (x-scratch2) (x-scratch0))
      (x64-or-rr! (mut s) (x-scratch1) (x-scratch2))
      (let [slot
              (slot-for-ty! g
                            (mut t))]
        (emit-store-int! g (x-scratch1) (x-slotbase) slot sz)
        (mk-aval 1
                 slot
                 t)))))

; sext of a REAL narrow int (e.g. sext i8 to i32) is just emit-cast-av!'s
; ordinary int/int path — ir-parse-type marks every int token signed, so it
; already sign-extends correctly from the container's own sign bit. But
; `sext i1 x to iN` (the 0/-1 mask idiom `greater`/icmp-derived masks use) is
; different: our i1 values are TBool bytes holding a plain 0/1, read
; UNSIGNED by convention (see emit-cmp's TBool signedness arm) — correct for
; zext (i1 true -> 1), but a byte-level sign-extend of that same byte (sign
; bit = bit 7, which is 0) would wrongly give +1, not LLVM's -1. The actual
; LLVM semantics — "replicate the sign bit of a *1-bit* signed value" — has
; no direct hardware byte-level operation; implement it directly as the
; two's-complement negation of the 0/1 value (negate(1)=-1, negate(0)=0),
; which is exactly equivalent.
(defn ir-sext-bool! [(g (ptr Cga)) (av AVal) (dstty Type)] (-> AVal)
  (let [s (field g asm)]
    (av-to-x! g av (x-scratch0))
    (x64-neg! (mut s) (x-scratch0))
    (match dstty
      (TInt [bits _]
            (do
              (emit-canon-int! g (x-scratch0) bits true)
              (let [(mut dtp) (: dstty Type)]
                (let [slot (slot-for-ty! g (mut dtp))]
                  (emit-store-int! g
                                   (x-scratch0)
                                   (x-slotbase)
                                   slot
                                   (ty-size g (mut dtp)))
                  (mk-aval 1 slot dstty)))))
      (_ (do
           (cgx-fail "llvm-ir: sext from i1 to a non-integer type")
           (mk-aval 0 0 dstty))))))

; shufflevector's <N x i32> mask: either `zeroinitializer` (all N indices 0,
; i.e. a splat) or an explicit `<i32 IDX0, i32 IDX1, ...>` literal. Indices
; are always compile-time-known integer literals in the corpus (never a
; %name), so this reads them straight off the token stream rather than
; building a runtime AVal — much simpler than indirecting through a register
; per lane.
(defn ir-shuffle-mask! [(a (dyn Allocator))
                        (toks (ptr (ArrayList (slice u8))))
                        (tokp (ptr i64))
                        (n i64)]
  (-> (ptr (ArrayList i64)))
  (irs/read-mask a (zeroed X64IrErrors) toks tokp n))

; copy `bytes` between a raw pointer (register `addrreg`, offset from 0) and a
; frame slot, chunked in ≤8-byte pieces. Generalizes emit-load-from-mem!/
; emit-store-to-mem! (which only handle bytes ∈ {1,2,4,8}) to the aggregate
; sizes the plain (non-atomic) llvm-ir load/store lines need, e.g. <16 x i8>
; or <4 x double> (32 bytes). Uses x-scratch1 as its transfer register, never
; x-scratch0 — callers load the address into x-scratch0, and reusing that
; register here would silently corrupt the address after the first chunk.
(defn ir-load-mem-any! [(g (ptr Cga)) (dst i64) (addrreg i64) (bytes i64)]
  (-> i64)
  (let [(mut off) 0]
    (loop (if (>= (load off) bytes)
              (break)
              (let [rem (primitive/isub bytes (load off))
                    chunk
                      (cond (>= rem 8) 8
                            (>= rem 4) 4
                            (>= rem 2) 2
                            :else 1)]
                (emit-load-int! g (x-scratch1) addrreg (load off) chunk false)
                (emit-store-int! g
                                 (x-scratch1)
                                 (x-slotbase)
                                 (primitive/iadd dst (load off))
                                 chunk)
                (set! off (primitive/iadd (load off) chunk)))))
    0))

(defn ir-store-mem-any! [(g (ptr Cga)) (addrreg i64) (src i64) (bytes i64)]
  (-> i64)
  (let [(mut off) 0]
    (loop (if (>= (load off) bytes)
              (break)
              (let [rem (primitive/isub bytes (load off))
                    chunk
                      (cond (>= rem 8) 8
                            (>= rem 4) 4
                            (>= rem 2) 2
                            :else 1)]
                (emit-load-int! g
                                (x-scratch1)
                                (x-slotbase)
                                (primitive/iadd src (load off))
                                chunk
                                false)
                (emit-store-int! g (x-scratch1) addrreg (load off) chunk)
                (set! off (primitive/iadd (load off) chunk)))))
    0))

; Alias metadata and volatility need no extra native instructions here: this
; emitter preserves each scalar access and its order without an optimizing pass.
; Emit one width-matched access; volatility does not imply a memory barrier.
(defn emit-scalar-memory [(g (ptr Cga))
                          (result Type)
                          (args (ptr (ArrayList Expr)))
                          (store bool)] (-> AVal)
  (if store
      (let [pav (emit-expr g (xal-at [Expr] args 0))
            vav (emit-expr g (xal-at [Expr] args 1))
            (mut t) (av-ty vav)]
        (let [sz (ty-size g (mut t))]
          (av-to-x! g vav (x-scratch1))
          (av-to-x! g pav (x-scratch0))
          (emit-store-to-mem! g (x-scratch1) (x-scratch0) sz)
          (mk-aval 0 0 (TInt 64 true))))
      (let [pav (emit-expr g (xal-at [Expr] args 0))
            (mut t) (: result Type)]
        (let [sz (ty-size g (mut t))
              slot (slot-for-ty! g (mut t))]
          (av-to-x! g pav (x-scratch0))
          (emit-load-from-mem! g (x-scratch1) (x-scratch0) sz)
          (emit-store-int! g (x-scratch1) (x-slotbase) slot sz)
          (mk-aval 1 slot result)))))

; A compiler-implemented primitive (EIntrinsic). Machine code is emitted as its
; function, never as an expression.
(defn emit-intrinsic [(g (ptr Cga))
                      (op Intrinsic)
                      (result Type)
                      (args (ptr (ArrayList Expr)))] (-> AVal)
  (match op
    (IStackBytes []
                 (let [s (field g asm)
                       nav (emit-expr g (xal-at [Expr] args 0))
                       slot (slot-new! (native-context g) 8 8)]
                   ; round the byte count up to 16 (the call alignment), move rsp down by
                   ; it, and hand out the bytes just above the outgoing-args area
                   (av-to-x! g nav (x-scratch0))
                   (x64-add-ri! (mut s) (x-scratch0) 15)
                   (x64-and-ri! (mut s) (x-scratch0) -16)
                   (x64-sub-rr! (mut s) 4 (x-scratch0))
                   (push! (mut (.outleas g)) (x64-off (mut s)))
                   (x64-lea32! (mut s) (x-scratch0) 4 0)
                   (emit-store-int! g (x-scratch0) (x-slotbase) slot 8)
                   (mk-aval 1 slot result)))
    (IVolatileLoad [] (emit-scalar-memory g result args false))
    (IAliasLoad [] (emit-scalar-memory g result args false))
    (IVolatileStore [] (emit-scalar-memory g result args true))
    (IAliasStore [] (emit-scalar-memory g result args true))
    (IFence []
            (let [s (field g asm)]
              ; mfence
              (x64-b! (mut s) 15)
              (x64-b! (mut s) 174)
              (x64-b! (mut s) 240)
              (mk-aval 0 0 (TInt 64 true))))
    (ILinkerAddress [symbol]
                    (let [sym
                            (eobj-add-sym! (mut (.obj g))
                                           (g-mangle g symbol)
                                           0
                                           0
                                           true)
                          slot (slot-new! (native-context g) 8 8)]
                      (emit-sym-addr! g (x-scratch0) sym)
                      (emit-store-int! g (x-scratch0) (x-slotbase) slot 8)
                      (mk-aval 1 slot result)))
    (_ (do
         (cgx-fail "codegen: machine-code outside a machine-code function (checker bug)")
         (mk-aval 0 0 result)))))

(defn emit-llvmir [(g (ptr Cga))
                   (result Type)
                   (args (ptr (ArrayList Expr)))
                   (body (slice u8))] (-> AVal)
  (let [frame (primitive/alloc-stack (IrContext Cga))]
    (store! frame (IrContext :g g :inputs (zeroed native/IrInputs)))
    (native/lower-ir! frame result args body)))

; per-lane float op over vector slots: op 0 add, 1 sub, 2 mul.

; vector float binop, lane by lane. Scalarizing keeps the IEEE result exact and
; identical to the LLVM backend's, which is what the corpus gate compares.
(defn emit-vec-fbin! [(g (ptr Cga))
                      (op i64)
                      (dst i64)
                      (asrc i64)
                      (bsrc i64)
                      (lanes i64)
                      (lb i64)] (-> i64)
  (let [s (field g asm)
        dbl (= lb 8)]
    (for [k 0 lanes]
      (emit-load-fp! g
                     0
                     (x-slotbase)
                     (primitive/iadd asrc
                                     (primitive/imul k lb))
                     lb)
      (emit-load-fp! g
                     1
                     (x-slotbase)
                     (primitive/iadd bsrc
                                     (primitive/imul k lb))
                     lb)
      (cond (= op 0) (x64-adds! (mut s) dbl 0 1)
            (= op 1) (x64-subs! (mut s) dbl 0 1)
            (= op 2) (x64-muls! (mut s) dbl 0 1)
            :else (x64-divs! (mut s) dbl 0 1))
      (emit-store-fp! g
                      0
                      (x-slotbase)
                      (primitive/iadd dst
                                      (primitive/imul k lb))
                      lb))
    0))

(defn emit-ir-line! [(irctx (ptr (IrContext Cga)))
                     (retp (ptr AVal))
                     (donep (ptr bool))
                     (line (slice u8))] (-> i64)
  (let [g (.g irctx)
        envp (.envp (field irctx inputs))
        result (.result (field irctx inputs))]
    (let [a (.a g)
          s (field g asm)
          toks (ir-tokens a line)
          ntk (len (load toks))]
      (unless (= ntk 0)
        (let [t0 (get (load toks) 0)]
          (cond (= t0 "declare") 0
                ; hoisted intrinsic declaration — the ops lower structurally
                ; `call void @llvm.trap()` then `unreachable`: stop at a trap instruction.
                (and (= t0 "call")
                     (and (>= ntk 3) (= (get (load toks) 2) "@llvm.trap")))
                  (do (x64-ud2! (mut s)) 0)
                (= t0 "unreachable") (do (set! donep true) 0)
                (= t0 "ret")
                  (let [(mut tokp) 1]
                    (let [rt (ir-parse-type irctx toks (mut tokp))
                          av
                            (ir-value irctx
                                      (load envp)
                                      (get (load toks) tokp)
                                      rt)]
                      (set! retp (mk-aval (av-kind av) (av-v av) result))
                      (set! donep true)
                      0))
                (= t0 "store")  ; store atomic TYPE VAL, ptr PTR seq_cst, align N
                  (if (and (>= ntk 7)
                           (= (get (load toks) 1) "atomic"))
                      (let [(mut tokp) 2]
                        (let [vt (ir-parse-type irctx toks (mut tokp))
                              vav
                                (ir-value irctx
                                          (load envp)
                                          (get (load toks)
                                               tokp)
                                          vt)
                              pav
                                (ir-value irctx
                                          (load envp)
                                          (get (load toks)
                                               (primitive/iadd tokp
                                                               2))
                                          (TPtr (box-type a (TInt 8 true))))]
                          ; a seq_cst store is an xchg: implicitly locked, so it
                          ; both stores and carries the full barrier.
                          (av-to-x! g vav (x-scratch1))
                          (av-to-x! g pav (x-scratch0))
                          (x64-xchg-mr! (mut s) (x-scratch0) 0 (x-scratch1))
                          0))
                      ; plain (non-atomic) form: store TYPE VAL, ptr PTR, align N
                      (let [(mut tokp) 1]
                        (let [vt (ir-parse-type irctx toks (mut tokp))
                              (mut vtp) vt
                              vav
                                (ir-value irctx
                                          (load envp)
                                          (get (load toks)
                                               tokp)
                                          vt)]
                          (set! tokp
                                (primitive/iadd tokp
                                                2))
                          ; skip VAL, "ptr"
                          (let [pav
                                  (ir-value irctx
                                            (load envp)
                                            (get (load toks)
                                                 tokp)
                                            (TPtr (box-type a (TInt 8 true))))]
                            (av-to-x! g pav (x-scratch0))
                            (ir-store-mem-any! g
                                               (x-scratch0)
                                               (av-slot! g vav)
                                               (ty-size g
                                                        (mut vtp)))))))
                (and (>= ntk 3)
                     (= (primitive/cast i64 (get t0 0)) 37))
                  (let [op (get (load toks) 2)
                        instruction
                          (native/IrInstruction
                            :allocator a
                            :environment envp
                            :tokens toks
                            :name t0
                            :opcode op)]
                    ; %old = atomicrmw SUB ptr PTR, TYPE VAL seq_cst
                    ; %r = cmpxchg ptr PTR, TYPE EXP, TYPE NEW seq_cst seq_cst
                    ; %v = load atomic TYPE, ptr PTR seq_cst, align N
                    ; %v = insertelement <N x T> AGG, ET EV, i32 K
                    ; %x = extractelement <N x T> V, IDXTY IDX
                    ; %r = shufflevector <M x T> V0, <M x T> V1, <N x i32> MASK
                    ; %r = bitcast SRCTY V to DSTTY
                    ; %r = icmp PRED TY V0, V1
                    ; %r = fcmp PRED TY V0, V1
                    ; %r = select CONDTY C, TY V0, TY V1
                    ; %r = OP SRCTY V to DSTTY
                    ; %r = OP SRCTY V to DSTTY
                    ; %r = OP TY V0, V1
                    ; %r = OP TY V0, V1 (scalar only)
                    ; %r = getelementptr ELEMTY, ptr BASE, IDXTY IDX
                    (case op
                      "extractvalue"
                        (native/ir-extract-value! irctx instruction)
                      "insertvalue" (native/ir-insert-value! irctx instruction)
                      "atomicrmw"
                        (let [sub (get (load toks) 3)
                              pav
                                (ir-value irctx
                                          (load envp)
                                          (get (load toks) 5)
                                          (TPtr (box-type a (TInt 8 true))))
                              (mut tokp) 6]
                          (let [vt (ir-parse-type irctx toks (mut tokp))
                                vav
                                  (ir-value irctx
                                            (load envp)
                                            (get (load toks) tokp)
                                            vt)
                                (mut vtp) vt]
                            (av-to-x! g pav (x-scratch0))
                            (av-to-x! g vav (x-scratch1))
                            (case sub
                              "add" 0
                              "sub" (do (x64-neg! (mut s) (x-scratch1)) 0)
                              "xchg" 0
                              (cgx-fail2 "llvm-ir: unsupported atomicrmw op: "
                                         sub))
                            ; both xchg and xadd return the OLD value in the

                            ; source register, so the value is copied into r11

                            ; and r11 is what gets read back afterwards.
                            (if (= sub "xchg")
                                (do
                                  (x64-mov-rr! (mut s)
                                               (x-scratch2)
                                               (x-scratch1))
                                  (x64-xchg-mr! (mut s)
                                                (x-scratch0)
                                                0
                                                (x-scratch2)))
                                (do
                                  (x64-mov-rr! (mut s)
                                               (x-scratch2)
                                               (x-scratch1))
                                  (x64-lock-xadd! (mut s)
                                                  (x-scratch0)
                                                  0
                                                  (x-scratch2))))
                            (let [slot (slot-for-ty! g (mut vtp))]
                              (emit-store-int! g
                                               (x-scratch2)
                                               (x-slotbase)
                                               slot
                                               (ty-size g (mut vtp)))
                              (set! envp
                                    (gscope-put a
                                                (load envp)
                                                t0
                                                (mk-aval 1 slot vt)))
                              0)))
                      "cmpxchg"
                        (let [pav
                                (ir-value irctx
                                          (load envp)
                                          (get (load toks) 4)
                                          (TPtr (box-type a (TInt 8 true))))
                              (mut tokp) 5]
                          (let [et (ir-parse-type irctx toks (mut tokp))
                                eav
                                  (ir-value irctx
                                            (load envp)
                                            (get (load toks) tokp)
                                            et)]
                            (set! tokp (primitive/iadd tokp 1))
                            (let [nt (ir-parse-type irctx toks (mut tokp))
                                  nav
                                    (ir-value irctx
                                              (load envp)
                                              (get (load toks) tokp)
                                              nt)]
                              ; cmpxchg PINS rax as the expected value and

                              ; overwrites it with the old value, so neither

                              ; the pointer nor the new value may live there:

                              ; rcx = pointer, rax = expected, r11 = new.
                              (av-to-x! g pav 1)
                              (av-to-x! g nav (x-scratch2))
                              (av-to-x! g eav 0)
                              (x64-mov-rr! (mut s) (x-scratch1) 0)
                              ; keep the expected value to compare after
                              (x64-lock-cmpxchg! (mut s) 1 0 (x-scratch2))
                              ; pair {old, success}: old at +0, success bit at +8.

                              ; rax now holds the OLD value either way.
                              (let [slot (slot-new! (native-context g) 16 8)]
                                (emit-store-int! g 0 (x-slotbase) slot 8)
                                (x64-cmp-rr! (mut s) 0 (x-scratch1))
                                (x64-setcc-bool! (mut s) (x64-cc-e) 2)
                                (emit-store-int! g
                                                 2
                                                 (x-slotbase)
                                                 (primitive/iadd slot 8)
                                                 8)
                                (set! envp
                                      (gscope-put a
                                                  (load envp)
                                                  t0
                                                  (mk-aval 1
                                                           slot
                                                           (TSlice (box-type a
                                                                             et)))))
                                0))))
                      "load"
                        (if (= (get (load toks) 3) "atomic")
                            (let [(mut tokp) 4]
                              (let [vt (ir-parse-type irctx toks (mut tokp))
                                    (mut vtp) vt]
                                ; skip the "ptr" token
                                (let [pav
                                        (ir-value irctx
                                                  (load envp)
                                                  (get (load toks)
                                                       (primitive/iadd tokp 1))
                                                  (TPtr (box-type a
                                                                  (TInt 8 true))))]
                                  (av-to-x! g pav (x-scratch0))
                                  (x64-mov-rm! (mut s)
                                               (x-scratch1)
                                               (x-scratch0)
                                               0)
                                  ; x86 loads are acquire
                                  (let [slot (slot-for-ty! g (mut vtp))]
                                    (emit-store-int! g
                                                     (x-scratch1)
                                                     (x-slotbase)
                                                     slot
                                                     (ty-size g (mut vtp)))
                                    (set! envp
                                          (gscope-put a
                                                      (load envp)
                                                      t0
                                                      (mk-aval 1 slot vt)))
                                    0))))
                            ; plain (non-atomic) form: load TYPE, ptr PTR, align N
                            (let [(mut tokp) 3]
                              (let [vt (ir-parse-type irctx toks (mut tokp))
                                    (mut vtp) vt]
                                (set! tokp (primitive/iadd tokp 1))
                                ; skip "ptr"
                                (let [pav
                                        (ir-value irctx
                                                  (load envp)
                                                  (get (load toks) tokp)
                                                  (TPtr (box-type a
                                                                  (TInt 8 true))))]
                                  (av-to-x! g pav (x-scratch0))
                                  (let [dslot (slot-for-ty! g (mut vtp))]
                                    (ir-load-mem-any! g
                                                      dslot
                                                      (x-scratch0)
                                                      (ty-size g (mut vtp)))
                                    (ir-bind! irctx
                                              envp
                                              t0
                                              (mk-aval 1 dslot vt)))))))
                      "insertelement"
                        (let [(mut tokp) 3]
                          (let [vty (ir-parse-type irctx toks (mut tokp))
                                aggtk (get (load toks) tokp)]
                            (set! tokp (primitive/iadd tokp 1))
                            (let [aggav (ir-value irctx (load envp) aggtk vty)
                                  elty (ir-parse-type irctx toks (mut tokp))
                                  eav
                                    (ir-value irctx
                                              (load envp)
                                              (get (load toks) tokp)
                                              elty)
                                  k
                                    (str->i64 (get (load toks)
                                                   (primitive/iadd tokp 2)))
                                  (mut vtp) vty
                                  (mut etp) elty]
                              (let [lb (ty-size g (mut etp))
                                    dslot (slot-for-ty! g (mut vtp))]
                                (emit-copy! g
                                            dslot
                                            (av-slot! g aggav)
                                            (ty-size g (mut vtp)))
                                (av-to-d! g eav 0)
                                (emit-store-fp! g
                                                0
                                                (x-slotbase)
                                                (primitive/iadd dslot
                                                                (primitive/imul k
                                                                                lb))
                                                lb)
                                (set! envp
                                      (gscope-put a
                                                  (load envp)
                                                  t0
                                                  (mk-aval 1 dslot vty)))
                                0))))
                      "extractelement"
                        (let [(mut tokp) 3]
                          (let [vty (ir-parse-type irctx toks (mut tokp))
                                vav (ir-value-adv! irctx toks (mut tokp) vty)
                                idxty (ir-parse-type irctx toks (mut tokp))
                                idxav
                                  (ir-value-adv! irctx toks (mut tokp) idxty)]
                            (match vty
                              (TVec [elemp _]
                                    (let [lb (ty-size g elemp)
                                          dslot (slot-for-ty! g elemp)]
                                      ; address of lane IDX = slot base + IDX * lane bytes,

                                      ; in scratch0 (ir-load-mem-any! uses scratch1)
                                      (emit-slot-addr! g
                                                       (x-scratch0)
                                                       (av-slot! g vav))
                                      (av-to-x! g idxav (x-scratch1))
                                      (x64-mov-imm! (mut s) (x-scratch2) lb)
                                      (x64-imul-rr! (mut s)
                                                    (x-scratch1)
                                                    (x-scratch2))
                                      (x64-add-rr! (mut s)
                                                   (x-scratch0)
                                                   (x-scratch1))
                                      (ir-load-mem-any! g dslot (x-scratch0) lb)
                                      (ir-bind! irctx
                                                envp
                                                t0
                                                (mk-aval 1 dslot (load elemp)))))
                              (_ (cgx-fail "llvm-ir: extractelement on non-vector")))))
                      "shufflevector"
                        (native/ir-shuffle-vector! irctx instruction)
                      (cond (or (= op "fadd")
                                (= op "fsub")
                                (= op "fmul")
                                (= op "fdiv"))
                              (let [(mut tokp) 3
                                    opn
                                      (cond (= op "fadd") 0
                                            (= op "fsub") 1
                                            (= op "fmul") 2
                                            :else 3)]
                                (let [vty (ir-parse-type irctx toks (mut tokp))
                                      aav
                                        (ir-value-adv! irctx
                                                       toks
                                                       (mut tokp)
                                                       vty)
                                      bav
                                        (ir-value-adv! irctx
                                                       toks
                                                       (mut tokp)
                                                       vty)
                                      (mut vtp) vty]
                                  (match vty
                                    (TVec [elem lanes]
                                          (let [lb (ty-size g elem)
                                                dslot (slot-for-ty! g (mut vtp))]
                                            (emit-vec-fbin! g
                                                            opn
                                                            dslot
                                                            (av-slot! g aav)
                                                            (av-slot! g bav)
                                                            (extent-value lanes)
                                                            lb)
                                            (set! envp
                                                  (gscope-put a
                                                              (load envp)
                                                              t0
                                                              (mk-aval 1
                                                                       dslot
                                                                       vty)))
                                            0))
                                    (TFloat [bits]
                                            (let [dbl (= bits 64)
                                                  dslot
                                                    (slot-for-ty! g (mut vtp))]
                                              (av-to-d! g aav 0)
                                              (av-to-d! g bav 1)
                                              (cond (= opn 0)
                                                      (x64-adds! (mut s)
                                                                 dbl
                                                                 0
                                                                 1)
                                                    (= opn 1)
                                                      (x64-subs! (mut s)
                                                                 dbl
                                                                 0
                                                                 1)
                                                    (= opn 2)
                                                      (x64-muls! (mut s)
                                                                 dbl
                                                                 0
                                                                 1)
                                                    :else
                                                      (x64-divs! (mut s)
                                                                 dbl
                                                                 0
                                                                 1))
                                              (emit-store-fp! g
                                                              0
                                                              (x-slotbase)
                                                              dslot
                                                              (/ bits 8))
                                              (set! envp
                                                    (gscope-put a
                                                                (load envp)
                                                                t0
                                                                (mk-aval 1
                                                                         dslot
                                                                         vty)))
                                              0))
                                    (_ (cgx-fail "llvm-ir: float op on unsupported type")))))
                            (= op "bitcast")
                              (native/ir-bitcast! irctx instruction)
                            (= op "icmp")
                              (let [pred (get (load toks) 3)
                                    (mut tokp) 4]
                                (let [ty (ir-parse-type irctx toks (mut tokp))
                                      lav
                                        (ir-value-adv! irctx toks (mut tokp) ty)]
                                  (let [rav
                                          (ir-value-adv! irctx
                                                         toks
                                                         (mut tokp)
                                                         ty)]
                                    (match ty
                                      (TVec [elemp lanes]
                                            (let [lb (ty-size g elemp)
                                                  maskty
                                                    (fixed-vec (box-type a
                                                                         (TBool))
                                                               (extent-value lanes))
                                                  (mut masktp) maskty]
                                              (let [dslot
                                                      (slot-for-ty! g
                                                                    (mut masktp))]
                                                (for [k 0 (extent-value lanes)]
                                                  (let [bav
                                                          (ir-icmp-scalar! irctx
                                                                           pred
                                                                           (ir-lane-av irctx
                                                                                       lav
                                                                                       k
                                                                                       (load elemp)
                                                                                       lb)
                                                                           (ir-lane-av irctx
                                                                                       rav
                                                                                       k
                                                                                       (load elemp)
                                                                                       lb))]
                                                    (emit-load-int! g
                                                                    (x-scratch1)
                                                                    (x-slotbase)
                                                                    (av-slot! g
                                                                              bav)
                                                                    1
                                                                    false)
                                                    (emit-store-int! g
                                                                     (x-scratch1)
                                                                     (x-slotbase)
                                                                     (primitive/iadd dslot
                                                                                     k)
                                                                     1)))
                                                (ir-bind! irctx
                                                          envp
                                                          t0
                                                          (mk-aval 1
                                                                   dslot
                                                                   maskty)))))
                                      (TSlice [_]
                                              (ir-bind! irctx
                                                        envp
                                                        t0
                                                        (ir-icmp-i128! g
                                                                       pred
                                                                       lav
                                                                       rav)))
                                      (_ (ir-bind! irctx
                                                   envp
                                                   t0
                                                   (ir-icmp-scalar! irctx
                                                                    pred
                                                                    lav
                                                                    rav)))))))
                            (= op "fcmp")
                              (let [pred (get (load toks) 3)
                                    (mut tokp) 4]
                                (let [ty (ir-parse-type irctx toks (mut tokp))
                                      lav
                                        (ir-value-adv! irctx toks (mut tokp) ty)]
                                  (let [rav
                                          (ir-value-adv! irctx
                                                         toks
                                                         (mut tokp)
                                                         ty)]
                                    (match ty
                                      (TVec [elemp lanes]
                                            (let [lb (ty-size g elemp)
                                                  maskty
                                                    (fixed-vec (box-type a
                                                                         (TBool))
                                                               (extent-value lanes))
                                                  (mut masktp) maskty]
                                              (let [dslot
                                                      (slot-for-ty! g
                                                                    (mut masktp))]
                                                (for [k 0 (extent-value lanes)]
                                                  (let [bav
                                                          (ir-fcmp-scalar! irctx
                                                                           pred
                                                                           (ir-lane-av irctx
                                                                                       lav
                                                                                       k
                                                                                       (load elemp)
                                                                                       lb)
                                                                           (ir-lane-av irctx
                                                                                       rav
                                                                                       k
                                                                                       (load elemp)
                                                                                       lb))]
                                                    (emit-load-int! g
                                                                    (x-scratch1)
                                                                    (x-slotbase)
                                                                    (av-slot! g
                                                                              bav)
                                                                    1
                                                                    false)
                                                    (emit-store-int! g
                                                                     (x-scratch1)
                                                                     (x-slotbase)
                                                                     (primitive/iadd dslot
                                                                                     k)
                                                                     1)))
                                                (ir-bind! irctx
                                                          envp
                                                          t0
                                                          (mk-aval 1
                                                                   dslot
                                                                   maskty)))))
                                      (_ (ir-bind! irctx
                                                   envp
                                                   t0
                                                   (ir-fcmp-scalar! irctx
                                                                    pred
                                                                    lav
                                                                    rav)))))))
                            (= op "select")
                              (native/ir-select! irctx instruction)
                            (or (= op "sext") (= op "zext") (= op "trunc"))
                              (native/ir-extend-instruction! irctx instruction)
                            (or (= op "fptosi")
                                (= op "fptoui")
                                (= op "sitofp")
                                (= op "uitofp")
                                (= op "fptrunc")
                                (= op "fpext"))
                              (native/ir-convert-instruction! irctx instruction)
                            (or (= op "and")
                                (= op "or")
                                (= op "xor")
                                (= op "add")
                                (= op "sub")
                                (= op "mul")
                                (= op "shl"))
                              (native/ir-binary-instruction! irctx instruction)
                            (or (= op "sdiv")
                                (= op "udiv")
                                (= op "srem")
                                (= op "urem"))
                              (native/ir-divide-instruction! irctx instruction)
                            (= op "getelementptr")
                              (let [(mut tokp) 3]
                                (let [elemty
                                        (ir-parse-type irctx toks (mut tokp))
                                      (mut elemtp) elemty]
                                  (set! tokp (primitive/iadd tokp 1))
                                  ; skip "ptr"
                                  (let [baseav
                                          (ir-value-adv! irctx
                                                         toks
                                                         (mut tokp)
                                                         (TPtr (box-type a
                                                                         (TInt 8
                                                                               true))))
                                        idxty
                                          (ir-parse-type irctx toks (mut tokp))
                                        esz (ty-size g (mut elemtp))]
                                    (match idxty
                                      (TVec [ielemp lanes]
                                            (let [idxav
                                                    (ir-value-adv! irctx
                                                                   toks
                                                                   (mut tokp)
                                                                   idxty)
                                                  ielb (ty-size g ielemp)
                                                  ptrty
                                                    (fixed-vec (box-type a
                                                                         (TPtr (box-type a
                                                                                         elemty)))
                                                               (extent-value lanes))
                                                  (mut ptp) ptrty]
                                              (let [dslot
                                                      (slot-for-ty! g (mut ptp))]
                                                (av-to-x! g baseav (x-scratch0))
                                                (for [k 0 (extent-value lanes)]
                                                  (av-to-x! g
                                                            (ir-lane-av irctx
                                                                        idxav
                                                                        k
                                                                        (load ielemp)
                                                                        ielb)
                                                            (x-scratch1))
                                                  (x64-mov-imm! (mut s)
                                                                (x-scratch2)
                                                                esz)
                                                  (x64-imul-rr! (mut s)
                                                                (x-scratch1)
                                                                (x-scratch2))
                                                  (x64-add-rr! (mut s)
                                                               (x-scratch1)
                                                               (x-scratch0))
                                                  (emit-store-int! g
                                                                   (x-scratch1)
                                                                   (x-slotbase)
                                                                   (primitive/iadd dslot
                                                                                   (primitive/imul k
                                                                                                   8))
                                                                   8))
                                                (ir-bind! irctx
                                                          envp
                                                          t0
                                                          (mk-aval 1
                                                                   dslot
                                                                   ptrty)))))
                                      (_ (let [idxav
                                                 (ir-value-adv! irctx
                                                                toks
                                                                (mut tokp)
                                                                idxty)]
                                           (av-to-x! g baseav (x-scratch0))
                                           (av-to-x! g idxav (x-scratch1))
                                           (x64-mov-imm! (mut s)
                                                         (x-scratch2)
                                                         esz)
                                           (x64-imul-rr! (mut s)
                                                         (x-scratch1)
                                                         (x-scratch2))
                                           (x64-add-rr! (mut s)
                                                        (x-scratch1)
                                                        (x-scratch0))
                                           (let [slot
                                                   (slot-new! (native-context g)
                                                              8
                                                              8)]
                                             (emit-store-int! g
                                                              (x-scratch1)
                                                              (x-slotbase)
                                                              slot
                                                              8)
                                             (ir-bind! irctx
                                                       envp
                                                       t0
                                                       (mk-aval 1
                                                                slot
                                                                (TPtr (box-type a
                                                                                elemty))))))))))
                                0)
                            (= op "call") (emit-ir-call! irctx toks t0 line)
                            :else (cgx-fail2 "llvm-ir: unsupported op: " op))))
                :else (cgx-fail2 "llvm-ir: unsupported line: " line)))))))

; intrinsic calls: @llvm.fma.v4f32 and @llvm.vector.reduce.fadd.v4f32
; IEEE minimum/maximum of xmm0 and xmm1 into xmm0. SSE2 has no instruction for
; it (minss/maxss return the second operand for NaN and for equal zeros), so:
; unordered -> xmm0+xmm1 (a quiet NaN); equal -> OR (minimum: -0 wins) or AND
; (maximum: +0 wins) of the bit patterns; otherwise the lesser/greater operand.
(defn emit-float-minmax! [(g (ptr Cga)) (dbl bool) (maximum bool)] (-> i64)
  (let [s (field g asm)
        lnan (x64-new-label (mut (.asm g)))
        leq (x64-new-label (mut (.asm g)))
        lother (x64-new-label (mut (.asm g)))
        lend (x64-new-label (mut (.asm g)))]
    (x64-ucomis! (mut s) dbl 0 1)
    (x64-jcc-label! (mut s) (x64-cc-p) lnan)
    (x64-jcc-label! (mut s) (x64-cc-e) leq)
    ; minimum takes xmm1 when xmm0 > xmm1; maximum when xmm0 < xmm1
    (x64-jcc-label! (mut s) (if maximum (x64-cc-b) (x64-cc-a)) lother)
    (x64-jmp-label! (mut s) lend)
    (x64-bind-label! (mut s) lother)
    (x64-movs-rr! (mut s) dbl 0 1)
    (x64-jmp-label! (mut s) lend)
    (x64-bind-label! (mut s) leq)
    (x64-movq-rx! (mut s) (x-scratch0) 0)
    (x64-movq-rx! (mut s) (x-scratch1) 1)
    (if maximum
        (x64-and-rr! (mut s) (x-scratch0) (x-scratch1))
        (x64-or-rr! (mut s) (x-scratch0) (x-scratch1)))
    (x64-movq-xr! (mut s) 0 (x-scratch0))
    (x64-jmp-label! (mut s) lend)
    (x64-bind-label! (mut s) lnan)
    (x64-adds! (mut s) dbl 0 1)
    (x64-bind-label! (mut s) lend)
    0))

; A scalar float math intrinsic (src/compiler/backend/float_math.coil), `tokp` at the
; callee: `sqrtss`/`sqrtsd` and an inline minimum/maximum, otherwise a call to
; the libm function of the same meaning (SSE2 has no rounding instruction).
(defn emit-ir-float-math! [(irctx (ptr (IrContext Cga)))
                           (toks (ptr (ArrayList (slice u8))))
                           (tokp (ptr i64))
                           (t0 (slice u8))
                           (rty Type)
                           (fi FloatIntrinsic)] (-> i64)
  (let [g (.g irctx)
        envp (.envp (field irctx inputs))]
    (let [s (field g asm)
          fb (/ (.bits fi) 8)
          dbl (= (.bits fi) 64)
          (mut rtp)
            (: rty
               Type)]
      (set! tokp (primitive/iadd (load tokp) 2))
      ; skip callee, "("
      (for [i 0 (.arity fi)]
        (let [at (ir-parse-type irctx toks tokp)
              av (ir-value-adv! irctx toks tokp at)]
          (av-to-d! g av i)))
      (match (.op fi)
        (FloatSqrt [] (x64-sqrts! (mut s) dbl 0 0))
        (FloatMinimum [] (emit-float-minmax! g dbl false))
        (FloatMaximum [] (emit-float-minmax! g dbl true))
        ; the operands are already in xmm0..xmm2, where the SysV convention wants
        ; them; al = 0 vector registers for a (hypothetically) variadic callee
        (_ (let [fsym (g-runtime-sym! g (.libm fi))
                 off
                   (do
                     (x64-mov-imm! (mut s) (x-scratch0) 0)
                     (x64-call-rel32! (mut s)))]
             (eobj-add-reloc! (mut (.obj g))
                              (.text g)
                              off
                              fsym
                              (r-x86-64-plt32)
                              -4)
             0)))
      (let [slot
              (slot-for-ty! g
                            (mut rtp))]
        (emit-store-fp! g 0 (x-slotbase) slot fb)
        (ir-bind! irctx envp t0 (mk-aval 1 slot rty))))))

(defn emit-ir-call! [(irctx (ptr (IrContext Cga)))
                     (toks (ptr (ArrayList (slice u8))))
                     (t0 (slice u8))
                     (line (slice u8))] (-> i64)
  (let [g (.g irctx)
        envp (.envp (field irctx inputs))]
    (let [a (.a g)
          s (field g asm)
          (mut tokp) 3]
      (let [rty (ir-parse-type irctx toks (mut tokp))
            callee
              (get (load toks)
                   tokp)]
        (match (float-intrinsic callee)
          (Some [fi]
                (emit-ir-float-math! irctx toks (mut tokp) t0 rty fi))
          (None []
                ; ( $t0 $0 $t1 $1 $t2 $2 ) -> per-lane single-rounding fmadd
                ; ( float 0.0 $t0 $0 ) -> strict sequential reduce from 0.0
                ; ( $ret $0 ) -> per-lane sqrtss/sqrtsd
                ; ( <N x ptr> PTRS, i32 ALIGN, <N x i1> MASK, <N x T> PASSTHRU )
                ; per-lane: mask[k] ? *ptrs[k] : passthru[k]. Scoped to
                ; the exact shape `heights` uses — no gather instruction
                ; on this backend, so this is a straight-line per-lane
                ; branch.
                (case callee
                  "@llvm.fma.v4f32"
                    (let [(mut rtp) rty]
                      (set! tokp (primitive/iadd tokp 2))
                      ; skip "("
                      (let [t1 (ir-parse-type irctx toks (mut tokp))
                            aav
                              (ir-value irctx
                                        (load envp)
                                        (get (load toks) tokp)
                                        t1)]
                        (set! tokp (primitive/iadd tokp 1))
                        (let [t2 (ir-parse-type irctx toks (mut tokp))
                              bav
                                (ir-value irctx
                                          (load envp)
                                          (get (load toks) tokp)
                                          t2)]
                          (set! tokp (primitive/iadd tokp 1))
                          (let [t3 (ir-parse-type irctx toks (mut tokp))
                                cav
                                  (ir-value irctx
                                            (load envp)
                                            (get (load toks) tokp)
                                            t3)]
                            (match rty
                              (TVec [elem lanes]
                                    (let [lb (ty-size g elem)
                                          asrc (av-slot! g aav)
                                          bsrc (av-slot! g bav)
                                          csrc (av-slot! g cav)
                                          dslot (slot-for-ty! g (mut rtp))]
                                      (for [k 0 (extent-value lanes)]
                                        (emit-load-fp! g
                                                       0
                                                       (x-slotbase)
                                                       (primitive/iadd asrc
                                                                       (primitive/imul k
                                                                                       lb))
                                                       lb)
                                        (emit-load-fp! g
                                                       1
                                                       (x-slotbase)
                                                       (primitive/iadd bsrc
                                                                       (primitive/imul k
                                                                                       lb))
                                                       lb)
                                        (emit-load-fp! g
                                                       2
                                                       (x-slotbase)
                                                       (primitive/iadd csrc
                                                                       (primitive/imul k
                                                                                       lb))
                                                       lb)
                                        ; SSE2 lacks a fused instruction. libm preserves the

                                        ; required single rounding; multiply then add does not.

                                        ; The three arguments are already in xmm0..xmm2.
                                        (let [symbol
                                                (g-runtime-sym! g
                                                                (if (= lb 4)
                                                                    "fmaf"
                                                                    "fma"))
                                              offset (x64-call-rel32! (mut s))]
                                          (eobj-add-reloc! (mut (.obj g))
                                                           (.text g)
                                                           offset
                                                           symbol
                                                           (r-x86-64-plt32)
                                                           -4))
                                        (emit-store-fp! g
                                                        0
                                                        (x-slotbase)
                                                        (primitive/iadd dslot
                                                                        (primitive/imul k
                                                                                        lb))
                                                        lb))
                                      (set! envp
                                            (gscope-put a
                                                        (load envp)
                                                        t0
                                                        (mk-aval 1 dslot rty)))
                                      0))
                              (_ (cgx-fail "llvm-ir: fma on non-vector")))))))
                  "@llvm.vector.reduce.fadd.v4f32"
                    (let [(mut rtp) rty]
                      (set! tokp (primitive/iadd tokp 2))
                      ; skip "("
                      (ir-parse-type irctx toks (mut tokp))
                      ; float
                      (unless (= (get (load toks) tokp) "0.0")
                        (cgx-fail2 "llvm-ir: reduce.fadd start must be 0.0: "
                                   line))
                      (set! tokp (primitive/iadd tokp 1))
                      (let [vt (ir-parse-type irctx toks (mut tokp))
                            vav
                              (ir-value irctx
                                        (load envp)
                                        (get (load toks) tokp)
                                        vt)]
                        (match vt
                          (TVec [elem lanes]
                                (let [lb (ty-size g elem)
                                      src (av-slot! g vav)
                                      dslot (slot-for-ty! g (mut rtp))]
                                  ; s0 = +0.0 (all-zero bits)
                                  (x64-xorps! (mut s) 0 0)
                                  (for [k 0 (extent-value lanes)]
                                    (emit-load-fp! g
                                                   1
                                                   (x-slotbase)
                                                   (primitive/iadd src
                                                                   (primitive/imul k
                                                                                   lb))
                                                   lb)
                                    (x64-adds! (mut s) (= lb 8) 0 1))
                                  (emit-store-fp! g 0 (x-slotbase) dslot lb)
                                  (set! envp
                                        (gscope-put a
                                                    (load envp)
                                                    t0
                                                    (mk-aval 1 dslot rty)))
                                  0))
                          (_ (cgx-fail "llvm-ir: reduce on non-vector")))))
                  "@llvm.sqrt.v4f32"
                    (let [(mut rtp) rty]
                      (set! tokp (primitive/iadd tokp 2))
                      ; skip callee, "("
                      (let [at (ir-parse-type irctx toks (mut tokp))
                            aav (ir-value-adv! irctx toks (mut tokp) at)]
                        (match rty
                          (TVec [elem lanes]
                                (let [lb (ty-size g elem)
                                      dbl (= lb 8)
                                      src (av-slot! g aav)
                                      dslot (slot-for-ty! g (mut rtp))]
                                  (for [k 0 (extent-value lanes)]
                                    (emit-load-fp! g
                                                   0
                                                   (x-slotbase)
                                                   (primitive/iadd src
                                                                   (primitive/imul k
                                                                                   lb))
                                                   lb)
                                    (x64-sqrts! (mut s) dbl 0 0)
                                    (emit-store-fp! g
                                                    0
                                                    (x-slotbase)
                                                    (primitive/iadd dslot
                                                                    (primitive/imul k
                                                                                    lb))
                                                    lb))
                                  (ir-bind! irctx envp t0 (mk-aval 1 dslot rty))))
                          (_ (cgx-fail "llvm-ir: sqrt on non-vector")))))
                  "@llvm.masked.gather.v4i8.v4p0"
                    (let [(mut rtp) rty]
                      (set! tokp (primitive/iadd tokp 2))
                      ; skip callee, "("
                      (let [ptrsty (ir-parse-type irctx toks (mut tokp))
                            ptrsav (ir-value-adv! irctx toks (mut tokp) ptrsty)]
                        (ir-parse-type irctx toks (mut tokp))
                        (set! tokp
                              ; i32 (immarg align)
                              (primitive/iadd tokp 1))
                        ; skip its literal
                        (let [maskty (ir-parse-type irctx toks (mut tokp))
                              maskav
                                (ir-value-adv! irctx toks (mut tokp) maskty)
                              passty (ir-parse-type irctx toks (mut tokp))
                              passav
                                (ir-value-adv! irctx toks (mut tokp) passty)]
                          (match rty
                            (TVec [relemp lanes]
                                  (let [relb (ty-size g relemp)
                                        dslot (slot-for-ty! g (mut rtp))]
                                    (for [k 0 (extent-value lanes)]
                                      (av-to-x! g
                                                (ir-lane-av irctx
                                                            maskav
                                                            k
                                                            (TBool)
                                                            1)
                                                (x-scratch0))
                                      (let [lfalse
                                              (x64-new-label (mut (.asm g)))
                                            lend (x64-new-label (mut (.asm g)))]
                                        (x64-test-rr! (mut (.asm g))
                                                      (x-scratch0)
                                                      (x-scratch0))
                                        (x64-jcc-label! (mut (.asm g))
                                                        (x64-cc-e)
                                                        lfalse)
                                        (av-to-x! g
                                                  (ir-lane-av irctx
                                                              ptrsav
                                                              k
                                                              (TPtr (box-type a
                                                                              (TInt 8
                                                                                    true)))
                                                              8)
                                                  (x-scratch1))
                                        (emit-load-int! g
                                                        (x-scratch2)
                                                        (x-scratch1)
                                                        0
                                                        relb
                                                        false)
                                        (emit-store-int! g
                                                         (x-scratch2)
                                                         (x-slotbase)
                                                         (primitive/iadd dslot
                                                                         (primitive/imul k
                                                                                         relb))
                                                         relb)
                                        (x64-jmp-label! (mut (.asm g)) lend)
                                        (x64-bind-label! (mut (.asm g)) lfalse)
                                        (emit-copy! g
                                                    (primitive/iadd dslot
                                                                    (primitive/imul k
                                                                                    relb))
                                                    (primitive/iadd (av-slot! g
                                                                              passav)
                                                                    (primitive/imul k
                                                                                    relb))
                                                    relb)
                                        (x64-bind-label! (mut (.asm g)) lend)))
                                    (ir-bind! irctx
                                              envp
                                              t0
                                              (mk-aval 1 dslot rty))))
                            (_ (cgx-fail "llvm-ir: masked.gather on non-vector result"))))))
                  (cgx-fail2 "llvm-ir: unsupported intrinsic: " callee))))))))

; ============================ function emission ==============================
; Frame, in the order the prologue builds it:
;     push rbp            ; rbp chain intact => backtraces work with no eh_frame
;     mov  rsp, rbp
;     push rbx            ; rbx is callee-saved and holds the slot base
;     sub  rsp, total     ; patched once slotbytes/outbytes are known
;     lea  rbx, [rsp+out] ; slots start above the outgoing-argument area
; SysV requires rsp ≡ 0 (mod 16) at every CALL. At function entry the call
; instruction has already pushed the return address, so rsp ≡ 8. `push rbp`
; brings it to 0 and `push rbx` back to 8 — an ODD number of pushes — so the
; frame subtraction must be 8 (mod 16), not a multiple of 16, to land back on
; 0. Getting this wrong does not fault here: it faults deep inside libc, when
; something like printf executes a movaps against a misaligned stack.
;
; Incoming stack arguments live at [rbp+16] and up: +0 is the saved rbp, +8 the
; return address.
; A machine-code function is its bytes at its symbol, then a return unless it
; never returns: no frame, no parameter intake, and a :shim convention's
; callers already put the arguments where the bytes read them.
(defn emit-machine-code-func! [(g (ptr Cga))
                               (fd (ptr Func))
                               (code MachineCodeBody)] (-> i64)
  (compiler-work! "emit" (.name fd))
  (match (machine-code-target-error (.a g)
                                    (.name fd)
                                    (.arch code)
                                    "x86_64")
    (Some [message]
          (cgx-fail (text/format (.a g) "codegen: {} (checker bug)" message)))
    (None [] 0))
  (let [s (field g asm)
        si (g-sig-idx g (.name fd))
        bytes (load (.bytes code))]
    (when (< si 0)
      (cgx-fail2 "emit-func!: unregistered function " (.name fd)))
    (eobj-set-sym! (mut (.obj g))
                   (.symidx (xal-at [GSig] (field g sigs) si))
                   (.text g)
                   (x64-off (mut s)))
    (for i (range 0 (len bytes))
      (x64-b! (mut s) (primitive/cast i64 (get bytes i))))
    (when (func-machine-code-returns? fd)
      (x64-ret! (mut s)))
    0))

(defn emit-func! [(g (ptr Cga)) (fd (ptr Func))] (-> i64)
  (match (func-machine-code fd)
    (Some [code] (emit-machine-code-func! g fd code))
    (None [] (emit-coil-func! g fd))))

(defn emit-coil-func! [(g (ptr Cga)) (fd (ptr Func))] (-> i64)
  (set! (.selfname g) (.name fd))
  (set! (.tailok g) false)
  (set! (.tailslots g)
        (box! (.a g) (ArrayList i64) (ArrayList::new [i64] (.a g))))
  (set! (.tailtys g)
        (box! (.a g) (ArrayList Type) (ArrayList::new [Type] (.a g))))
  (set! (.entrylabel g) (x64-new-label (mut (.asm g))))
  (set! (.frame g) 0)
  (set! (.dwcursrc g) -1)
  (set! (.dwcurlo g) -1)
  (set! (.env g) (gscope-nil (.a g)))
  (set! (.len (.loops g)) 0)
  (set! (.terminated g) false)
  (set! (.retty g) (.ret fd))
  (set! (.sretslot g) -1)
  (set! (.outbytes g) 0)
  (set! (.outleas g) (ArrayList::new [i64] (.a g)))
  (let [s (field g asm)
        a (.a g)
        si (g-sig-idx g (.name fd))]
    (when (< si 0)
      (cgx-fail2 "emit-func!: unregistered function " (.name fd)))
    (eobj-set-sym! (mut (.obj g))
                   (if (.shim (xal-at [GSig] (field g sigs) si))
                       (.implsym (xal-at [GSig] (field g sigs) si))
                       (.symidx (xal-at [GSig] (field g sigs) si)))
                   (.text g)
                   (x64-off (mut s)))
    (set! (.fnstart g) (x64-off (mut s)))
    (when (>= (.source fd) 0)
      (let [(mut ev) (zeroed DwLineEv)]
        (set! (.textoff ev) (x64-off (mut s)))
        (set! (.source ev) (.source fd))
        (set! (.lo ev)
              (if (< (.lo fd) 0)
                  0
                  (do
                    (.lo fd))))
        (set! (.pe ev) false)
        (push! (mut (.dwevs g)) ev)
        (set! (.dwcursrc g) (.source fd))
        (set! (.dwcurlo g) (.lo ev))
        0))
    (let [dwvarlo (len (.dwvars g))
          dwfnlo (.lo fd)
          dwfnsrc (.source fd)]
      ; ---- prologue
      (x64-push! (mut s) 5)  ; push rbp
      (x64-mov-rr! (mut s) 5 4)  ; mov rsp, rbp
      (x64-push! (mut s) (x-slotbase))  ; push rbx
      (let [p1 (x64-off (mut s))]
        ; two placeholders, patched below: `sub rsp, imm32` (7 bytes) and
        ; `lea rbx, [rsp+imm32]` (8 bytes). Both are emitted at their maximum
        ; width so the patch never has to move code.
        (x64-sub-ri32! (mut s) 4 0)
        (x64-lea32! (mut s) (x-slotbase) 4 0)
        (let [(mut retp) (.ret fd)]
          (let [retvoid (match (.ret fd) (TVoid [] true) (_ false))
                retinfo
                  (if retvoid
                      (mk-abi-scalar)
                      (g-abi-info g
                                  (mut retp)))]
            ; incoming hidden sret pointer (rdi) for a >16B return
            (when (= (abi-cls retinfo) 4)
              (let [ss (slot-new! (native-context g) 8 8)]
                (emit-store-int! g 7 (x-slotbase) ss 8)
                (set! (.sretslot g) ss))
              0)
            (let [ps (load (field fd params))
                  np (len (load ps))
                  (mut gp) (if (= (abi-cls retinfo) 4) 1 0)
                  (mut fp) 0
                  (mut stk) 0
                  (mut i) 0]
              (loop (if (>= (load i) np)
                        (break)
                        (do
                          (let [prm (xal-at [Param] ps (load i))
                                t (field prm ty)
                                info (g-abi-info g t)
                                cls (abi-cls info)
                                slot (slot-for-ty! g t)
                                sz (ty-size g t)
                                _tailrec
                                  (do
                                    (push! (load (field g tailslots)) slot)
                                    (push! (load (field g tailtys)) (load t))
                                    0)]
                            (cond (= cls 6)
                                    0  ; an empty struct: nothing arrives
                                  ; ---- int-like scalar
                                  (= cls 0)
                                    (if (< (load gp) 6)
                                        (do
                                          (emit-store-int! g
                                                           (x-argreg (load gp))
                                                           (x-slotbase)
                                                           slot
                                                           sz)
                                          (set! gp (primitive/iadd (load gp) 1))
                                          0)
                                        (do
                                          (emit-load-int! g
                                                          (x-scratch0)
                                                          5
                                                          (primitive/iadd 16
                                                                          (load stk))
                                                          8
                                                          false)
                                          (emit-store-int! g
                                                           (x-scratch0)
                                                           (x-slotbase)
                                                           slot
                                                           sz)
                                          (set! stk
                                                (primitive/iadd (load stk) 8))
                                          0))
                                  ; ---- float scalar
                                  (= cls 1)
                                    (if (< (load fp) 8)
                                        (do
                                          (emit-store-fp! g
                                                          (load fp)
                                                          (x-slotbase)
                                                          slot
                                                          (ty-float-bytes t))
                                          (set! fp (primitive/iadd (load fp) 1))
                                          0)
                                        (do
                                          (emit-load-int! g
                                                          (x-scratch0)
                                                          5
                                                          (primitive/iadd 16
                                                                          (load stk))
                                                          8
                                                          false)
                                          (emit-store-int! g
                                                           (x-scratch0)
                                                           (x-slotbase)
                                                           slot
                                                           sz)
                                          (set! stk
                                                (primitive/iadd (load stk) 8))
                                          0))
                                  ; ---- aggregate <= 8B, one register of class eb0
                                  (= cls 2)
                                    (let [sse
                                            (= (abi-eb0 info)
                                               2)]
                                      (if (if sse
                                              (< (load fp)
                                                 8)
                                              (< (load gp)
                                                 6))
                                          (do
                                            (if sse
                                                (emit-store-fp! g
                                                                (load fp)
                                                                (x-slotbase)
                                                                slot
                                                                8)
                                                (emit-store-int! g
                                                                 (x-argreg (load gp))
                                                                 (x-slotbase)
                                                                 slot
                                                                 8))
                                            (if sse
                                                (set! fp
                                                      (primitive/iadd (load fp)
                                                                      1))
                                                (set! gp
                                                      (primitive/iadd (load gp)
                                                                      1)))
                                            0)
                                          (do
                                            (emit-load-int! g
                                                            (x-scratch0)
                                                            5
                                                            (primitive/iadd 16
                                                                            (load stk))
                                                            8
                                                            false)
                                            (emit-store-int! g
                                                             (x-scratch0)
                                                             (x-slotbase)
                                                             slot
                                                             8)
                                            (set! stk
                                                  (primitive/iadd (load stk)
                                                                  8))
                                            0)))
                                  ; ---- aggregate <= 16B, one register per eightbyte
                                  (= cls 3)
                                    (let [s0
                                            (= (abi-eb0 info)
                                               2)
                                          s1
                                            (= (abi-eb1 info)
                                               2)
                                          needg
                                            (primitive/iadd (if s0 0 1)
                                                            (if s1 0 1))
                                          needf
                                            (primitive/iadd (if s0 1 0)
                                                            (if s1 1 0))]
                                      (if (and (<= (primitive/iadd (load gp)
                                                                   needg)
                                                   6)
                                               (<= (primitive/iadd (load fp)
                                                                   needf)
                                                   8))
                                          (do
                                            (if s0
                                                (do
                                                  (emit-store-fp! g
                                                                  (load fp)
                                                                  (x-slotbase)
                                                                  slot
                                                                  8)
                                                  (set! fp
                                                        (primitive/iadd (load fp)
                                                                        1))
                                                  0)
                                                (do
                                                  (emit-store-int! g
                                                                   (x-argreg (load gp))
                                                                   (x-slotbase)
                                                                   slot
                                                                   8)
                                                  (set! gp
                                                        (primitive/iadd (load gp)
                                                                        1))
                                                  0))
                                            (if s1
                                                (do
                                                  (emit-store-fp! g
                                                                  (load fp)
                                                                  (x-slotbase)
                                                                  (primitive/iadd slot
                                                                                  8)
                                                                  8)
                                                  (set! fp
                                                        (primitive/iadd (load fp)
                                                                        1))
                                                  0)
                                                (do
                                                  (emit-store-int! g
                                                                   (x-argreg (load gp))
                                                                   (x-slotbase)
                                                                   (primitive/iadd slot
                                                                                   8)
                                                                   8)
                                                  (set! gp
                                                        (primitive/iadd (load gp)
                                                                        1))
                                                  0))
                                            0)
                                          (do
                                            (emit-load-int! g
                                                            (x-scratch0)
                                                            5
                                                            (primitive/iadd 16
                                                                            (load stk))
                                                            8
                                                            false)
                                            (emit-store-int! g
                                                             (x-scratch0)
                                                             (x-slotbase)
                                                             slot
                                                             8)
                                            (emit-load-int! g
                                                            (x-scratch0)
                                                            5
                                                            (primitive/iadd 24
                                                                            (load stk))
                                                            8
                                                            false)
                                            (emit-store-int! g
                                                             (x-scratch0)
                                                             (x-slotbase)
                                                             (primitive/iadd slot
                                                                             8)
                                                             8)
                                            (set! stk
                                                  (primitive/iadd (load stk)
                                                                  16))
                                            0)))
                                  ; ---- > 16B: the caller placed a copy on the stack;
                                  ; copy it into this function's own slot.
                                  :else
                                    (let [asz
                                            (primitive/imul (/ (primitive/iadd sz
                                                                               7)
                                                               8)
                                                            8)
                                          (mut kk) 0]
                                      (loop (if (>= (load kk) asz)
                                                (break)
                                                (do
                                                  (emit-load-int! g
                                                                  (x-scratch0)
                                                                  5
                                                                  (primitive/iadd 16
                                                                                  (primitive/iadd (load stk)
                                                                                                  (load kk)))
                                                                  8
                                                                  false)
                                                  (emit-store-int! g
                                                                   (x-scratch0)
                                                                   (x-slotbase)
                                                                   (primitive/iadd slot
                                                                                   (load kk))
                                                                   8)
                                                  (set! kk
                                                        (primitive/iadd (load kk)
                                                                        8)))))
                                      (set! stk (primitive/iadd (load stk) asz))
                                      0))
                            (dw-note-var! g
                                          (.name prm)
                                          t
                                          slot
                                          false
                                          true
                                          (.source fd)
                                          (.lo fd))
                            (set! (.env g)
                                  (gscope-put a
                                              (load (field g env))
                                              (.name prm)
                                              (mk-aval 1 slot (load t)))))
                          (set! i (primitive/iadd (load i) 1))))))
            ; ---- prologue complete: the prologue_end row, so a debugger's
            ; breakpoint lands after the parameters are spilled and frame
            ; variables are valid.
            (when (>= (.source fd) 0)
              (let [(mut ev) (zeroed DwLineEv)]
                (set! (.textoff ev) (x64-off (mut s)))
                (set! (.source ev) (.source fd))
                (set! (.lo ev)
                      (if (< (.lo fd) 0)
                          0
                          (do
                            (.lo fd))))
                (set! (.pe ev) true)
                (push! (mut (.dwevs g)) ev)
                0))
            ; ---- body. The entry label sits AFTER parameter intake, so a self-tail
            ; call jumps here: the frame, the incoming-argument registers and the
            ; spill code are all already done, and re-running them would be wrong.
            (x64-bind-label! (mut (.asm g)) (.entrylabel g))
            (let [bav (emit-body-tail g (load (field fd body)))]
              (unless (.terminated g)
                (unless retvoid
                  (let [cls (abi-cls retinfo)]
                    (cond (= cls 6) 0
                          ; an empty struct: nothing to return
                          (= cls 0) (av-to-x! g bav 0)
                          (= cls 1) (av-to-d! g bav 0)
                          (= cls 2)
                            (if (= (abi-eb0 retinfo) 2)
                                (emit-load-fp! g
                                               0
                                               (x-slotbase)
                                               (av-slot! g bav)
                                               8)
                                (emit-load-int! g
                                                0
                                                (x-slotbase)
                                                (av-slot! g bav)
                                                (ty-size g
                                                         (mut retp))
                                                false))
                          (= cls 3)  ; two eightbytes leave in (rax,rdx) / (xmm0,xmm1)
                            ; / a mix, each file numbered independently.
                            (let [bs (av-slot! g bav)
                                  s0 (= (abi-eb0 retinfo) 2)
                                  s1 (= (abi-eb1 retinfo) 2)]
                              (if s0
                                  (emit-load-fp! g 0 (x-slotbase) bs 8)
                                  (emit-load-int! g 0 (x-slotbase) bs 8 false))
                              (if s1
                                  (emit-load-fp! g
                                                 (if s0 1 0)
                                                 (x-slotbase)
                                                 (primitive/iadd bs 8)
                                                 8)
                                  (emit-load-int! g
                                                  (if s0 0 2)
                                                  (x-slotbase)
                                                  (primitive/iadd bs 8)
                                                  8
                                                  false))
                              0)
                          :else
                            ; cls 4: copy into *sret, and SysV also
                            ; requires the pointer to come back in rax.
                            (do
                              (emit-load-int! g
                                              (x-scratch2)
                                              (x-slotbase)
                                              (.sretslot g)
                                              8
                                              false)
                              (emit-copy-to-mem! g
                                                 (x-scratch2)
                                                 (av-slot! g bav)
                                                 (ty-size g
                                                          (mut retp)))
                              (emit-load-int! g
                                              0
                                              (x-slotbase)
                                              (.sretslot g)
                                              8
                                              false)
                              0))))
                0)
              ; ---- epilogue: restore rbx from just below rbp, then leave/ret.
              (x64-mov-rm! (mut s) (x-slotbase) 5 -8)
              (x64-leave! (mut s))
              (x64-ret! (mut s))
              ; ---- resolve labels, patch the frame size
              (x64-resolve-fixups! (mut s))
              (let [slotbytes
                      (primitive/imul (/ (primitive/iadd (.frame g)
                                                         15)
                                         16)
                                      16)
                    out (.outbytes g)
                    ; two pushes precede this, so rsp is 8 (mod 16) here; add the
                    ; odd 8 to bring it back to 0 for the callees.
                    total (primitive/iadd (primitive/iadd slotbytes out) 8)]
                ; every slot is addressed as rbx + disp32
                (when (> total 2147483647)
                  (g-user-fail "stack frame exceeds 2 GiB, the reach of x86-64's 32-bit displacements"))
                (x64-patch-sub-ri32! (mut s) p1 total)
                (x64-patch-lea32! (mut s) (primitive/iadd p1 7) out)
                (for [k 0 (len (.outleas g))]
                  (x64-patch-lea32! (mut s) (get (.outleas g) k) out))
                (let [(mut df) (zeroed DwFn)]
                  (set! (.name df) (.name fd))
                  (set! (.symidx df)
                        (.symidx (xal-at [GSig]
                                         (field g
                                                sigs)
                                         si)))
                  (set! (.source df)
                        (if (< dwfnsrc 0) 0 (do dwfnsrc)))
                  (set! (.lo df)
                        (if (< dwfnlo 0) 0 (do dwfnlo)))
                  (set! (.textoff df) (.fnstart g))
                  (set! (.len df)
                        (primitive/isub (x64-off (mut s))
                                        (.fnstart g)))
                  (set! (.slotbytes df) slotbytes)
                  (set! (.varlo df) dwvarlo)
                  (set! (.varhi df) (len (.dwvars g)))
                  (push! (mut (.dwfns g)) df))
                ; :shim: the Coil-named symbol is a trampoline that moves the
                ; convention's registers into the C argument registers, calls
                ; __impl, and moves rax back into the convention's return register.
                (when (.shim (xal-at [GSig] (field g sigs) si))
                  (let [e (xal-at [GSig] (field g sigs) si)
                        regs (load (field e shimregs))
                        nr (len (load regs))]
                    (eobj-set-sym! (mut (.obj g))
                                   (.symidx e)
                                   (.text g)
                                   (x64-off (mut s)))
                    (x64-push! (mut s) 5)
                    (x64-mov-rr! (mut s) 5 4)
                    ; through the stack: moved one at a time, a convention
                    ; taking (rsi rdi) would overwrite rdi before reading it
                    (for j (range 0 nr)
                      (x64-push! (mut s) (get (load regs) j)))
                    (for k (range 0 nr)
                      (x64-pop! (mut s) (x-argreg (- (- nr 1) k))))
                    (let [coff (x64-call-rel32! (mut s))]
                      (eobj-add-reloc! (mut (.obj g))
                                       (.text g)
                                       coff
                                       (.implsym e)
                                       (r-x86-64-plt32)
                                       -4))
                    (when (!= (.shimret e) 0)
                      (x64-mov-rr! (mut s) (.shimret e) 0))
                    (x64-leave! (mut s))
                    (x64-ret! (mut s))
                    0))
                0)))))))
  0)

; compile-time constant evaluation for (static-assert ...): a faithful port of
; codegen.coil's const-eval, with LLVM size/align/offset queries replaced by
; this backend's own layout tables — which give the same natural-layout answers.

(defn g-user-fail [(msg (slice u8))] (-> i64)
  (let [w (stderr)]
    (print-str w "error: ")
    (print-str w msg)
    (write-byte w (: 10 u8))
    (cgx64.exit (: 1 i32))
    0))

(defn g-eval-asserts! [(g (ptr Cga)) (mp (ptr Program))] (-> i64)
  (let [asserts (load (field mp asserts))
        n (len (load asserts))
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (let [sa (xal-at [StaticAssert] asserts (load i))]
                  (when (= (gcev-v (g-const-eval (native-context g)
                                                 (field sa cnd)))
                           0)
                    (let [w (stderr)]
                      (print-str w "error: static assertion failed: ")
                      (print-str w (.msg sa))
                      (write-byte w (: 10 u8))
                      (cgx64.exit (: 1 i32))
                      0)))
                (set! i (primitive/iadd (load i) 1))))))
  0)

; ============================ driver =========================================
; Build the program's ELF object IN MEMORY. Serializing it to a file (the AOT
; path) is a thin wrapper over this, so the codegen happens exactly once, here.
(defn cgx64-build-eobj [(a (dyn Allocator))
                        (mp (ptr Program))
                        (mainpath (slice u8))
                        (compdir (slice u8))
                        (paths (ptr (ArrayList (slice u8))))
                        (texts (ptr (ArrayList (slice u8))))
                        (emit-dwarf bool)] (-> EObj)
  (let [g (primitive/alloc-stack Cga)]
    (set! (.a g) a)
    (set! (.sigs g) (ArrayList::new [GSig] a))
    (set! (.sig_index g) (HashMap::new [(slice u8) i64] a (keyops)))
    (set! (.obj g) (eobj-new a))
    (set! (.asm g) (xasm-new a))
    (set! (.strs g) (ArrayList::new [GStr] a))
    (set! (.statics g) (ArrayList::new [GStatic] a))
    (set! (.nglob g) 0)
    (set! (.loops g) (ArrayList::new [GLoop] a))
    (set! (.env g) (gscope-nil a))
    (set! (.frame g) 0)
    (set! (.terminated g) false)
    (set! (.sretslot g) -1)
    (set! (.outbytes g) 0)
    (set! (.outleas g) (ArrayList::new [i64] a))
    (set! (.fnstart g) 0)
    (set! (.retty g) (TInt 64 true))
    (set! (.epilabel g) 0)
    (set! (.dwtypes g) (dbg-types-new a))
    (set! (.dwfns g) (ArrayList::new [DwFn] a))
    (set! (.dwvars g) (ArrayList::new [DwVar] a))
    (set! (.dwevs g) (ArrayList::new [DwLineEv] a))
    (set! (.dwcursrc g) -1)
    (set! (.dwcurlo g) -1)
    (set! (.convs g) (load (field mp conventions)))
    ; sections: ordinals are 1-based in push order.
    (set! (.text g)
          (eobj-add-sect! (mut (.obj g))
                          ".text"
                          16
                          (sht-progbits)
                          (| (shf-alloc) (shf-execinstr))))
    (set! (.constsec g)
          (eobj-add-sect! (mut (.obj g)) ".rodata" 8 (sht-progbits) (shf-alloc)))
    (set! (.datasec g)
          (eobj-add-sect! (mut (.obj g))
                          ".data"
                          8
                          (sht-progbits)
                          (| (shf-alloc) (shf-write))))
    ; without this the linker gives the whole program an executable stack
    (eobj-mark-nonexec-stack! (mut (.obj g)))
    ; A by-value STRUCT parameter reaches a Coil function by reference on this
    ; backend, so an export that takes one gets a thunk: it receives the C
    ; arguments by value and calls the function, which stays internal. Codegen
    ; works on a copy of the program with the thunks added and the exports
    ; renamed to them; the caller's program is left as it was.
    (let [thunks (export-c-thunks a mp)
          (mut with-thunks) (load mp)
          mp (cast (ptr Program) (mut with-thunks))]
      (unless (= (len thunks) 0)
        (let [(mut funcs) (ArrayList::new [Func] a)
              (mut exports) (ArrayList::new [ExportC] a)]
          (for f (load (.funcs mp)) (push! (mut funcs) f))
          (for f thunks (push! (mut funcs) f))
          (for i (range 0 (len (load (.exports mp))))
            (let [e (xal-at [ExportC] (.exports mp) i)
                  (mut copy) (load e)]
              (when (export-c-needs-thunk? e)
                (set! (.name copy) (export-c-thunk-name a (.name e))))
              ; An unpublished entry is reached only through fnptr-of, so its
              ; thunk is not exported.
              (when (.published e) (push! (mut exports) copy))
              0))
          (set! (.funcs with-thunks) (box! a (ArrayList Func) (load funcs)))
          (set! (.exports with-thunks)
                (box! a (ArrayList ExportC) (load exports)))))
      (g-register-types! g mp)
      (g-eval-asserts! g mp)
      ; integers wider than 64 bits have no x64 lowering yet: refuse a program
      ; that runs one rather than drop their high words
      (let [(mut ws) (wide-scan-new a mp)
            reached (reachable-funcs (mut ws))]
        (match (first-wide-func (mut ws) (box-al [(slice u8)] a reached))
          (Some [name]
                (do (cgx-fail (wide-int-unsupported a "x64 backend" name)) 0))
          (None [] 0)))
      (g-register-sigs! g mp)
      (g-declare-statics! g mp)
      (let [fs (load (field mp funcs))
            n (len (load fs))
            (mut i) 0]
        (loop (if (>= (load i) n)
                  (break)
                  (do
                    ; A declaration has no body to emit; its object is linked.
                    (unless (.declared (xal-at [Func] fs (load i)))
                      (emit-func! g (xal-at [Func] fs (load i)))
                      0)
                    (set! i (primitive/iadd (load i) 1))))))
      ; move the emitted code into .text
      (xb-bytes! (mut (eobj-sect-buf (mut (.obj g)) (.text g)))
                 (slice (.buf (.asm g))))
      ; ---- DWARF
      (when emit-dwarf
        (let [ltmp
                (eobj-add-sym! (mut (.obj g))
                               ".Ltext0"
                               (.text g)
                               0
                               false)
              dw
                (dw-build! a
                           mainpath
                           compdir
                           paths
                           texts
                           (field (field g dwtypes) tys)
                           (mut (.dwfns g))
                           (mut (.dwvars g))
                           (mut (.dwevs g))
                           (len (.buf (.asm g)))
                           ltmp
                           ; DWARF register 6 is rbp on x86-64.
                           6
                           ; A slot at offset k lives at rbx+k, and
                           ;   rbx = rsp + outbytes = (rbp - 8 - total) + outbytes
                           ; where total = slotbytes + outbytes + 8. So
                           ;   rbx + k = rbp - 16 - slotbytes + k
                           ; and dwarf.coil computes  k - (bias + slotbytes),
                           ; which is exactly right with bias = 16.
                           16)
              ; debug sections are not SHF_ALLOC: they exist in the file but are
              ; never loaded into the process image.
              sline
                (eobj-add-sect! (mut (.obj g))
                                ".debug_line"
                                1
                                (sht-progbits)
                                0)
              sinfo
                (eobj-add-sect! (mut (.obj g))
                                ".debug_info"
                                1
                                (sht-progbits)
                                0)
              sabbr
                (eobj-add-sect! (mut (.obj g))
                                ".debug_abbrev"
                                1
                                (sht-progbits)
                                0)
              sstr
                (eobj-add-sect! (mut (.obj g))
                                ".debug_str"
                                1
                                (sht-progbits)
                                0)]
          (xb-bytes! (mut (eobj-sect-buf (mut (.obj g)) sline))
                     (slice (load (load (field dw
                                               line)))))
          (xb-bytes! (mut (eobj-sect-buf (mut (.obj g)) sinfo))
                     (slice (load (load (field dw
                                               info)))))
          (xb-bytes! (mut (eobj-sect-buf (mut (.obj g)) sabbr))
                     (slice (load (load (field dw
                                               abbrev)))))
          (xb-bytes! (mut (eobj-sect-buf (mut (.obj g)) sstr))
                     (slice (load (load (field dw
                                               strs)))))
          ; Unlike the Mach-O path (where debug sections carry no relocations
          ; and ld64's debug map does the translation), ELF debug sections hold
          ; REAL relocations against .text: an absolute 64-bit address whose
          ; addend is the text offset the emitter recorded.
          (let [rl (load (field dw relocs))
                nr (len (load rl))
                (mut i) 0]
            (loop (if (>= (load i) nr)
                      (break)
                      (do
                        (let [r (xal-at [DwReloc] rl (load i))
                              sect
                                (if (= (.sect r)
                                       1)
                                    sinfo
                                    sline)
                              buf (eobj-sect-buf (mut (.obj g)) sect)
                              ; the emitter left the text offset in the slot; it
                              ; becomes the relocation's addend and the slot is
                              ; zeroed so the linker writes the final address.
                              addend
                                (| (primitive/cast i64
                                                   (get (load buf)
                                                        (.off r)))
                                   (<< (primitive/cast i64
                                                       (get (load buf)
                                                            (primitive/iadd (.off r)
                                                                            1)))
                                       8)
                                   (<< (primitive/cast i64
                                                       (get (load buf)
                                                            (primitive/iadd (.off r)
                                                                            2)))
                                       16)
                                   (<< (primitive/cast i64
                                                       (get (load buf)
                                                            (primitive/iadd (.off r)
                                                                            3)))
                                       24))]
                          (eobj-add-reloc! (mut (.obj g))
                                           sect
                                           (.off r)
                                           ltmp
                                           (r-x86-64-64)
                                           addend))
                        (set! i (primitive/iadd (load i) 1))))))))
      (.obj g))))

; serialize a built object to disk — the AOT path.
(defn cgx64-build-object [(a (dyn Allocator))
                          (mp (ptr Program))
                          (objpath (ptr i8))
                          (mainpath (slice u8))
                          (compdir (slice u8))
                          (paths (ptr (ArrayList (slice u8))))
                          (texts (ptr (ArrayList (slice u8))))
                          (emit-dwarf bool)] (-> i64)
  (let [(mut o) (cgx64-build-eobj a mp mainpath compdir paths texts emit-dwarf)
        bytes (elf-write (mut o))
        fd (fs/create-file objpath 420)]
    (when (< fd 0) (cgx-fail "cannot create object file"))
    (let [total (len (load bytes))
          (mut off) 0]
      (loop (if (>= (load off) total)
                (break)
                (do
                  (let [wrote
                          (cgx64.write (primitive/cast i32 fd)
                                       (primitive/cast (ptr i8)
                                                       (index (data (slice (load bytes)))
                                                              (load off)))
                                       (primitive/cast isize
                                                       (primitive/isub total
                                                                       (load off))))]
                    (when (<= wrote 0)
                      (cgx-fail "object write failed"))
                    (set! off
                          (primitive/iadd (load off) (primitive/cast i64 wrote))))))))
    (cgx64.close (primitive/cast i32 fd))
    0))

(defn native-lowering-allocator [(g (ptr Cga))] (-> (dyn Allocator))
  (.a g))

(native/implement-lowering (IrContext Cga)
                           [[lowering-inputs :inputs]
                            [lowering-allocator native-lowering-allocator]
                            [lowering-fail cgx-fail :static]
                            [lowering-fail2 cgx-fail2 :static]
                            [lowering-size ty-size]
                            [lowering-type-slot slot-for-ty!]
                            [lowering-value-slot av-slot!]
                            [lowering-copy emit-copy!]
                            [lowering-cast emit-cast-av!]
                            [lowering-sext-bool ir-sext-bool!]
                            [lowering-compare emit-cmp-av!]
                            [lowering-zero emit-zero!]
                            [lowering-store emit-store-av-at!]
                            [lowering-expression emit-expr]
                            [lowering-ir-line emit-ir-line! :frame]
                            [lowering-aggregate-element ir-agg-elem]
                            [lowering-select ir-select-blend!]
                            [lowering-binary emit-bin-av!]])
