; src/compiler/backend/codegen_tpde.coil — the tpde backend: mono Program -> CIR -> tpde.
;
; Lowers the monomorphized Program (sum layout {i32 tag, payload at 8}, slices
; {ptr,i64}, as layoutdb.coil lays them out) into CIR, the SSA IR of the tpde package (vendored at src/compiler/tpde),
; one function at a time, and compiles each with tpde's single-pass register
; allocator into arm64 code (AAPCS64), or for an x86_64 target into x86-64 code
; (System V, classified as codegen_x64.coil does; a Mach-O x86-64 object).
;
; Values: a scalar (an integer up to 128 bits, float, bool or pointer) is an SSA
; value, integers kept extended to 64 bits from their width (the native
; module's container invariant). An aggregate is a place: the address of private storage
; (value semantics: loads and copies snapshot it).
;
; SSA construction is Braun et al.'s, on the fly: a stack slot the checker made
; for a mutable local (`alloc stack`) whose address is only ever loaded from or
; stored to becomes a CIR variable (`promotable-allocs!` decides before
; lowering); the rest stay stack slots.
;
; Module data -- signatures, statics, strings, vtables -- is laid out by
; native_module.coil into its MObj; tpde contributes the text section and
; its relocations, merged into that MObj (`tl-merge!`) and written by macho.coil.
(module coil.compiler.codegen_tpde)
(import "coil.primitive" :as primitive)
(import "coil.alloc" :as alloc :use *)
(import "coil.result" :use *)
(import "coil.slice" :use *)
(import "coil.str" :use *)
(import "coil.arraylist" :use *)
(import "coil.hashmap" :use *)
(import "coil.io" :use *)
(import "coil.fs" :as fs)
(import "coil.control" :use *)
(import "coil.mem" :use *)
(import "coil.compiler.ast" :use *)
(import "coil.compiler.parser" :use *)
(import "coil.compiler.a64" :use [al-at b-align! b-bytes! b-u64!])
(import "coil.compiler.dwarf" :use [DwTy DwFn DwVar DwLineEv DwInc DwOut dw-inc-new dw-inc-fn! dw-inc-finish! dw-inc-free!])
(import "coil.compiler.debuginfo" :use *)
(import "coil.mem" :use [f64-bits])
(import "coil.compiler.layoutdb" :use *)
(import "coil.compiler.macho" :use *)
(import "coil.compiler.native_module" :use *)
(import "coil.compiler.vector_scalar" :use *)
(import "coil.compiler.float_math" :use *)
(import "coil.compiler.trace" :as tr)
(import "coil.compiler.codegen_tpde_ir" :as tir)
(import "coil.compiler.comptime" :use [target-arch-str])
(import "coil.atomic" :as atomic)
(import "coil.thread" :use [Thread ThreadConfig])
(import "coil.cc" :as cc)
(import "coil.time" :use [monotonic-now])
(import "tpde.cir" :as cir)
(import "tpde.cir.adaptor")
(import "tpde.cir.a64" :as isel)
(import "tpde.core" :as tcore)
(import "tpde.asm" :as tasm)
(import "tpde.buf" :as tbuf)
(import "tpde.a64.enc" :as enc)
(import "tpde.x64.enc" :as xenc)
(import "tpde.x64" :as xtpde)

(extern cgtpde.write :as "write" [i32 (ptr i8) isize] (-> isize))
(extern cgtpde.getenv :as "getenv" [(ptr i8)] (-> (ptr i8)))
(extern cgtpde.atol :as "atol" [(ptr i8)] (-> i64))
;; microseconds, for COIL_TPDE_STATS
(defn ticks [] (-> i64)
  (match (monotonic-now) (Ok [t] (+ (* (.sec t) 1000000) (/ (.nsec t) 1000))) (Err [_] 0)))

(extern cgtpde.close :as "close" [i32] (-> i32))
(extern cgtpde.memchr :as "memchr" [(ptr u8) i32 usize] (-> (ptr u8)))

; ============================ state ==========================================

; kind: 0 scalar SSA value, 1 place (address of an aggregate), 2 nothing,
; 3 a promoted slot: `v` is its CIR variable, `ty` the slot's element type
(defstruct TV [(kind i64) (v u32) (ty Type)])

(defstruct TBind [(name (slice u8)) (tv TV)])

(defstruct TLoop
  [(label (Option (slice u8)))
   (head u32)
   (exit u32)
   (resvar u32)
   (reskind i64)
   (resty Type)
   (has-res bool)])

(defstruct PBind [(name (slice u8)) (key u64)])

;;; A slot of the promotion table: EAlloc node -> escaped. Slots of another
;;; function's generation are empty, so starting a function clears nothing.
(defstruct AllocSlot [(key u64) (escaped bool) (gen u32)])

(defstruct Tl
  [(g (ptr Cga))
   (a (dyn Allocator))
   (f (ptr cir/Func))
   (c (ptr (tcore/Compiler cir/Func)))
   (ta (ptr tasm/Asm))
   (env (ArrayList TBind))
   (loops (ArrayList TLoop))
   ; EAlloc node address -> the slot escapes (false: promotable)
   (allocs (ArrayList AllocSlot))
   (alloc-gen u32)
   (alloc-count i64)
   ; MObj symbol -> tpde symbol (NONE until mirrored)
   (sym-map (ArrayList u32))
   (tsym-mobj (ArrayList i64))
   (fd (ptr Func))
   (retty Type)
   (retinfo AbiInfo)
   (sret u32)
   (terminated bool)
   (tailok bool)
   (inline-depth i64)
   (selfname (slice u8))
   ; compiled functions: (MObj symbol, tpde symbol)
   (defined (ArrayList i64))
   ; reused operand lists of tl-emit-call and tl-runtime-call (cir/call!
   ; copies them; a list per call was most of the lowering's allocation)
   (call-args (ArrayList u32))
   (call-flags (ArrayList u32))
   (call-rts (ArrayList u8))
   (rt-args (ArrayList u32))
   (rt-flags (ArrayList u32))
   (rt-rts (ArrayList u8))
   ; the promotion scan's scope stack
   (penv (ArrayList PBind))
   (prof-repeat i64)  ; COIL_TPDE_PROFILE_REPEAT: extra compiles per function
   (prof-lower-repeat i64)  ; COIL_TPDE_PROFILE_LOWER: extra lowerings per function
   ; tl-abi-info's memo, by struct index
   (abi-cache (ArrayList AbiInfo))
   (abi-known (ArrayList bool))
   (x64 bool)  ; x86-64 (System V) rather than arm64 (AAPCS64)
   ; ---- debug info (`dbg`), see "debug info" below. The lowering side owns
   ; dw-vars (the function's variables: `slot` is its stack slot's alloca
   ; ordinal, `start`/`end` debug mark ids), dw-var-extra (the byte offset into
   ; that slot) and dbg-shadow (a promoted variable's shadow slot, by CIR
   ; variable); they travel to the compiling side in the function's Job.
   (dbg bool)
   (dw-vars (ArrayList DwVar))
   (dw-var-extra (ArrayList i64))
   ; each variable's SSA value when it has one (NONE otherwise), and the
   ; values whose locations compiling samples (a tracked variable's `slot`
   ; is its index here)
   (dw-var-val (ArrayList u32))
   (dw-track (ArrayList u32))
   (dbg-shadow (ArrayList u32))
   ; the function's debug frame: one stack slot holding every shadow slot
   ; (NONE until the first), and its size so far
   (dbg-frame u32)
   (dbg-frame-size i64)
   ; (SSA value, shadow offset) pairs of the function's scalar shadows
   (dbg-vslots (ArrayList i64))
   ; the source line the instructions are attributed to: its source and byte
   ; range (a row is recorded where the line changes)
   (dbg-cur-src i64)
   (dbg-line-lo i64)
   (dbg-texts (ptr (ArrayList (slice u8))))
   ; dw-ty-of!'s memo by type identity (see dbg-ty)
   (dbg-ty-keys (ArrayList u64))
   (dbg-ty-vals (ArrayList i64))
   ; the compiling side's: the DWARF it encodes function by function, and its
   ; scratch list of a function's rows
   (dwinc DwInc)
   (dw-evs (ArrayList DwLineEv))
   ; instruction -> code offset of the marked ones, -1 elsewhere
   (inst-off (ArrayList i64))
   (text-base i64)
   (stats bool)  ; COIL_TPDE_STATS: count and time the phases
   (stat-funcs i64)
   (stat-vals i64)
   (stat-insts i64)
   (stat-blocks i64)
   (stat-ops i64)
   (stat-cand i64)
   (t-lower i64)
   (t-compile i64)
   (t-dwarf i64)])

(defn tl-fail [(msg (slice u8))] (-> never)
  (cga-fail msg)
  (abort))

(defn none32 [] (-> u32) (cir/none))
(defn u32-of [(x i64)] (-> u32) (primitive/cast u32 x))
(defn i64-of [(x u32)] (-> i64) (primitive/cast i64 x))

(defn tv-s [(v u32) (ty Type)] (-> TV) (TV :kind 0 :v v :ty ty))
(defn tv-p [(v u32) (ty Type)] (-> TV) (TV :kind 1 :v v :ty ty))
(defn tv-none [] (-> TV) (TV :kind 2 :v (none32) :ty (TVoid)))
(defn i64t [] (-> Type) (TInt 64 true))

(defn box-ty [(tl (ptr Tl)) (t Type)] (-> (ptr Type)) (box-type (.a tl) t))

; ============================ types ==========================================

(defn wide? [(t (ptr Type))] (-> bool)
  (match (load t) (TInt [bits _] (> bits 64)) (_ false)))

;;; Scalar for this backend: the native module's scalars plus integers up to 128 bits.
(defn tl-scalar? [(t (ptr Type))] (-> bool)
  (or (ty-is-scalar t) (wide? t)))

;;; The CIR type of a scalar Coil type (-1 for aggregates and void).
(defn tl-cty [(t (ptr Type))] (-> i64)
  (match (load t)
    (TInt [bits _] (if (> bits 64) cir/T-I128 cir/T-I64))
    (TBool [] cir/T-I64)
    (TFloat [bits] (if (= bits 32) cir/T-F32 cir/T-F64))
    (TPtr [_] cir/T-I64)
    (TRef [_ _] cir/T-I64)
    (TFn [_ _ _] cir/T-I64)
    (TNever [] cir/T-I64)
    (_ -1)))

(defn ty-void? [(t (ptr Type))] (-> bool)
  (match (load t) (TVoid [] true) (TNever [] false) (_ false)))

(defn int-bits [(t (ptr Type))] (-> i64)
  (match (load t) (TInt [bits _] bits) (TBool [] 1) (_ 64)))

(defn int-signed? [(t (ptr Type))] (-> bool)
  (match (load t) (TInt [_ sg] sg) (TBool [] false) (_ true)))

;;; Bytes a scalar occupies in memory (1/2/4/8/16).
(defn scalar-bytes [(tl (ptr Tl)) (t (ptr Type))] (-> i64)
  (match (load t)
    (TInt [bits _] (cond (<= bits 8) 1 (<= bits 16) 2 (<= bits 32) 4 (<= bits 64) 8 :else 16))
    (TBool [] 1)
    (TFloat [bits] (/ bits 8))
    (_ 8)))

(defn tsize [(tl (ptr Tl)) (t (ptr Type))] (-> i64) (ty-size (.g tl) t))
(defn talign [(tl (ptr Tl)) (t (ptr Type))] (-> i64) (ty-align (.g tl) t))

; ============================ CIR emission ===================================

(defn f [(tl (ptr Tl))] (-> (ptr cir/Func)) (.f tl))

;;; Make sure instructions have an open block: after a terminator, code goes to
;;; a fresh block no branch reaches.
(defn open! [(tl (ptr Tl))] (-> void)
  (when (cir/terminated? (.f tl))
    (let [b (cir/new-block! (.f tl))]
      (cir/set-block! (.f tl) b))))

(defn iconst [(tl (ptr Tl)) (v i64)] (-> u32) (cir/iconst! (.f tl) v))
(defn op1 [(tl (ptr Tl)) (op i64) (ty i64) (a u32) (imm i64) (imm2 i64)] (-> u32)
  (open! tl) (cir/op1! (.f tl) op ty a imm imm2))
(defn op2 [(tl (ptr Tl)) (op i64) (ty i64) (a u32) (b u32) (imm i64) (imm2 i64)] (-> u32)
  (open! tl) (cir/op2! (.f tl) op ty a b imm imm2))
(defn op3 [(tl (ptr Tl)) (op i64) (ty i64) (a u32) (b u32) (c u32) (imm i64) (imm2 i64)] (-> u32)
  (open! tl) (cir/op3! (.f tl) op ty a b c imm imm2))

(defn sym-val [(tl (ptr Tl)) (mobj-sym i64)] (-> u32)
  (cir/sym! (.f tl) (tl-sym tl mobj-sym) 0))

(defn new-slot [(tl (ptr Tl)) (t (ptr Type))] (-> u32)
  (cir/alloca! (.f tl) (tsize tl t) (talign tl t)))

(defn new-slot-bytes [(tl (ptr Tl)) (size i64) (align i64)] (-> u32)
  (cir/alloca! (.f tl) size align))

(defn addi [(tl (ptr Tl)) (p u32) (off i64)] (-> u32)
  (if (= off 0) p (op1 tl cir/OP-ADDI cir/T-I64 p off 0)))

;;; Canonicalize an integer result to its type's width and signedness.
(defn canon [(tl (ptr Tl)) (v u32) (t (ptr Type))] (-> u32)
  (match (load t)
    (TInt [bits sg]
          (if (< bits 64)
              (op1 tl (if sg cir/OP-SEXT cir/OP-ZEXT) cir/T-I64 v bits 0)
              v))
    (_ v)))

(defn load-scalar [(tl (ptr Tl)) (p u32) (off i64) (t (ptr Type))] (-> u32)
  (open! tl)
  (cir/load-mem! (.f tl) (tl-cty t) p off (scalar-bytes tl t) (int-signed? t)))

(defn store-scalar [(tl (ptr Tl)) (p u32) (off i64) (v u32) (t (ptr Type))] (-> void)
  (open! tl)
  (cir/store-mem! (.f tl) p v off (scalar-bytes tl t))
  0)

(defn memcpy [(tl (ptr Tl)) (dst u32) (src u32) (n i64)] (-> void)
  (when (> n 0)
    (open! tl)
    (when (> n isel/INLINE-COPY-MAX) (set! (.has-calls (.f tl)) true))
    (cir/op2! (.f tl) cir/OP-MEMCPY cir/T-VOID dst src n 0))
  0)

(defn memzero [(tl (ptr Tl)) (dst u32) (n i64)] (-> void)
  (when (> n 0)
    (open! tl)
    (when (> n isel/INLINE-COPY-MAX) (set! (.has-calls (.f tl)) true))
    (cir/op1! (.f tl) cir/OP-MEMZERO cir/T-VOID dst n 0))
  0)

;;; Store / load exactly `n` (1, 2, 4, 8) bytes, zero-extending on load.
(defn store-n [(tl (ptr Tl)) (p u32) (off i64) (v u32) (n i64)] (-> void)
  (open! tl)
  (cir/store-mem! (.f tl) p v off n)
  0)

(defn load-n [(tl (ptr Tl)) (p u32) (off i64) (n i64)] (-> u32)
  (open! tl)
  (cir/load-mem! (.f tl) cir/T-I64 p off n false))

;;; A load of `n` (1..8) bytes zero-extended, from loads of 4, 2 and 1 bytes.
(defn load-bytes [(tl (ptr Tl)) (p u32) (off i64) (n i64)] (-> u32)
  (if (or (= n 1) (= n 2) (= n 4) (= n 8))
      (do (open! tl) (cir/load-mem! (.f tl) cir/T-I64 p off n false))
      (let [(mut acc) (none32)
            (mut o) 0]
        (for chunk [4 2 1]
          (while (>= (- n o) chunk)
            (open! tl)
            (let [part (cir/load-mem! (.f tl) cir/T-I64 p (+ off o) chunk false)
                  sh (if (= o 0) part (op2 tl cir/OP-SHL cir/T-I64 part (iconst tl (* o 8)) 0 0))]
              (set! acc (if (= acc (none32)) sh (op2 tl cir/OP-OR cir/T-I64 acc sh 0 0))))
            (set! o (+ o chunk))))
        acc)))

;;; A store of the low `n` (1..8) bytes of `v`.
(defn store-bytes [(tl (ptr Tl)) (p u32) (off i64) (v u32) (n i64)] (-> void)
  (if (or (= n 1) (= n 2) (= n 4) (= n 8))
      (do (open! tl) (cir/store-mem! (.f tl) p v off n) 0)
      (let [(mut o) 0]
        (for chunk [4 2 1]
          (while (>= (- n o) chunk)
            (let [part (if (= o 0) v (op2 tl cir/OP-LSHR cir/T-I64 v (iconst tl (* o 8)) 0 0))]
              (open! tl)
              (cir/store-mem! (.f tl) p part (+ off o) chunk))
            (set! o (+ o chunk))))
        0)))

; ============================ values =========================================

;;; The SSA value of a scalar TV.
(defn scalar [(tl (ptr Tl)) (tv TV)] (-> u32)
  (cond (= (.kind tv) 0) (.v tv)
        (= (.kind tv) 1)
          (let [(mut t) (.ty tv)] (load-scalar tl (.v tv) 0 (mut t)))
        :else (iconst tl 0)))

;;; The address of a TV's value: a place as is, a scalar spilled to a new slot.
(defn place [(tl (ptr Tl)) (tv TV)] (-> u32)
  (if (= (.kind tv) 1)
      (.v tv)
      (let [(mut t) (.ty tv)
            s (new-slot tl (mut t))]
        (when (= (.kind tv) 0) (store-scalar tl s 0 (.v tv) (mut t)))
        s)))

;;; Store a TV of any type at `p + off`.
(defn store-tv [(tl (ptr Tl)) (p u32) (off i64) (tv TV)] (-> void)
  (let [(mut t) (.ty tv)]
    (cond (= (.kind tv) 2) 0
          (tl-scalar? (mut t)) (store-scalar tl p off (scalar tl tv) (mut t))
          :else (memcpy tl (addi tl p off) (.v tv) (tsize tl (mut t)))))
  0)

;;; A private copy of an aggregate TV (value semantics); scalars as they are.
(defn snapshot [(tl (ptr Tl)) (tv TV)] (-> TV)
  (let [(mut t) (.ty tv)]
    (if (and (= (.kind tv) 1) (not (tl-scalar? (mut t))))
        (let [s (new-slot tl (mut t))]
          (memcpy tl s (.v tv) (tsize tl (mut t)))
          (tv-p s (.ty tv)))
        tv)))

;;; A TV for a value of type `t` stored at `p` (scalars load, aggregates copy).
(defn read-at [(tl (ptr Tl)) (p u32) (off i64) (t Type)] (-> TV)
  (let [(mut tt) t]
    (if (tl-scalar? (mut tt))
        (tv-s (load-scalar tl p off (mut tt)) t)
        (let [s (new-slot tl (mut tt))]
          (memcpy tl s (addi tl p off) (tsize tl (mut tt)))
          (tv-p s t)))))

; ============================ symbols ========================================

;;; The tpde symbol mirroring MObj symbol `m`.
(defn tl-sym [(tl (ptr Tl)) (m i64)] (-> u32)
  (when (>= m (len (.sym-map tl)))
    (for _ (range (len (.sym-map tl)) (+ m 1)) (push! (mut (.sym-map tl)) (none32))))
  (let [have (get (.sym-map tl) m)]
    (if (!= have (none32))
        have
        (let [ms (al-at [MSym] (field (field (.g tl) obj) syms) m)
              t (if (= (.sect ms) 0)
                    (tasm/sym-add-undef! (.ta tl) "" (: 1 u8))
                    (tasm/sym-add-def! (.ta tl) "" -2 0 0 (: 1 u8)))]
          (set! (mut (.sym-map tl)) m t)
          (while (< (len (.tsym-mobj tl)) (+ (i64-of t) 1)) (push! (mut (.tsym-mobj tl)) -1))
          (set! (mut (.tsym-mobj tl)) (i64-of t) m)
          t))))

;;; The System V classification (codegen_x64's g-abi-info), in native_module's
;;; AbiInfo: class 0 integer scalar, 1 float scalar, 2 one eightbyte, 3 two,
;;; 4 MEMORY, 6 empty. For classes 2 and 3 the eightbytes' classes (1
;;; INTEGER, 2 SSE) are kept in `hfa_n` and `hfa_bits`, which on arm64 are 0
;;; for these classes (INTEGER).
(defn sysv-merge [(x i64) (y i64)] (-> i64)
  (cond (or (= x 1) (= y 1)) 1 (or (= x 2) (= y 2)) 2 :else 0))

;;; Paint each byte `t` covers (at `base`) with its class.
(defn sysv-paint! [(g (ptr Cga)) (t (ptr Type)) (base i64) (bytes (mut (ArrayList i64)))] (-> void)
  (match (load t)
    (TFloat [bits] (sysv-fill! (mut bytes) base (/ bits 8) 2))
    (TArray [et cnt]
            (let [esz (ty-size g et)]
              (for i (range 0 (extent-value cnt)) (sysv-paint! g et (+ base (* i esz)) (mut bytes)))))
    (TStruct [nm]
             (let [si (g-struct-idx g nm)]
               (if (>= si 0)
                   (let [fs (load (field (struct-at (field g layouts) si) fields))]
                     (for i (range 0 (len (load fs)))
                       (sysv-paint! g (field (elem fs i) ty) (+ base (g-field-off g si i)) (mut bytes))))
                   ; a sum: tag and payload words, all INTEGER
                   (sysv-fill! (mut bytes) base (ty-size g t) 1))))
    (_ (sysv-fill! (mut bytes) base (ty-size g t) 1))))

(defn sysv-fill! [(bytes (mut (ArrayList i64))) (base i64) (n i64) (cls i64)] (-> void)
  (for i (range base (+ base n))
    (when (< i (len bytes)) (set! (mut bytes) i (sysv-merge (get bytes i) cls)))))

;;; The class of the eightbyte at `lo`; one of padding only is INTEGER.
(defn sysv-eightbyte [(bytes (ptr (ArrayList i64))) (lo i64) (size i64)] (-> i64)
  (let [(mut c) 0]
    (for i (range lo (if (< (+ lo 8) size) (+ lo 8) size))
      (set! c (sysv-merge c (get (load bytes) i))))
    (if (= c 0) 1 c)))

(defn sysv-info [(g (ptr Cga)) (t (ptr Type))] (-> AbiInfo)
  (let [(mut r) (mk-abi-scalar)]
    (if (ty-is-scalar t)
        (set! (.cls r) (if (ty-is-float t) 1 0))
        (let [sz (ty-size g t)]
          (if (> sz 16)
              (set! (.cls r) 4)
              (let [(mut bytes) (ArrayList::new [i64] (malloc-allocator))]
                (extend-zeroed! (mut bytes) sz)
                (sysv-paint! g t 0 (mut bytes))
                (set! (.hfa_n r) (sysv-eightbyte (mut bytes) 0 sz))
                (cond (= sz 0) (set! (.cls r) 6)
                      (<= sz 8) (set! (.cls r) 2)
                      :else (do (set! (.cls r) 3)
                                (set! (.hfa_bits r) (sysv-eightbyte (mut bytes) 8 sz))))
                (free! (mut bytes))))))
    r))

(defn tl-abi-info-raw [(tl (ptr Tl)) (t (ptr Type))] (-> AbiInfo)
  (if (.x64 tl) (sysv-info (.g tl) t) (g-abi-info (.g tl) t)))

;;; Eightbyte `j` (0 or 1) of a class 2/3 aggregate is SSE (System V only).
(defn eb-sse? [(info AbiInfo) (j i64)] (-> bool)
  (= (if (= j 0) (abi-hfa-n info) (abi-hfa-bits info)) 2))

;;; The CIR type of eightbyte `j`, `n` bytes of it used.
(defn eb-cty [(info AbiInfo) (j i64) (n i64)] (-> i64)
  (cond (not (eb-sse? info j)) cir/T-I64 (<= n 4) cir/T-F32 :else cir/T-F64))

;;; Load / store eightbyte `j` (`n` bytes at `off`) as its CIR type.
(defn eb-load [(tl (ptr Tl)) (p u32) (info AbiInfo) (j i64) (off i64) (n i64)] (-> u32)
  (if (eb-sse? info j)
      (let [(mut ft) (if (<= n 4) (TFloat 32) (TFloat 64))] (load-scalar tl p off (mut ft)))
      (load-bytes tl p off n)))

(defn eb-store [(tl (ptr Tl)) (p u32) (info AbiInfo) (j i64) (off i64) (v u32) (n i64)] (-> void)
  (if (eb-sse? info j)
      (let [(mut ft) (if (<= n 4) (TFloat 32) (TFloat 64))] (store-scalar tl p off v (mut ft)))
      (store-bytes tl p off v n)))

;;; A class 3 aggregate's first-part flags: a group of two, mixed when its
;;; eightbytes are in different register banks.
(defn pair-flags [(info AbiInfo)] (-> u32)
  (| (group-flags 1) (if (= (eb-sse? info 0) (eb-sse? info 1)) (: 0 u32) cir/AF-MIXED)))

(defn hi-bytes [(sz i64)] (-> i64) (if (>= (- sz 8) 8) 8 (- sz 8)))

;;; The ABI classification, remembered per struct: a struct's class
;;; walks its fields, and the same few structs are passed at most calls.
(defn tl-abi-info [(tl (ptr Tl)) (t (ptr Type))] (-> AbiInfo)
  (match (load t)
    (TStruct [nm]
             (let [si (g-struct-idx (.g tl) nm)]
               (if (< si 0)
                   (tl-abi-info-raw tl t)
                   (do
                     (when (>= si (len (.abi-known tl)))
                       (extend-zeroed! (mut (.abi-known tl)) (- (+ si 1) (len (.abi-known tl))))
                       (extend-zeroed! (mut (.abi-cache tl)) (- (+ si 1) (len (.abi-cache tl)))))
                     (if (get (.abi-known tl) si)
                         (get (.abi-cache tl) si)
                         (let [info (tl-abi-info-raw tl t)]
                           (set! (mut (.abi-cache tl)) si info)
                           (set! (mut (.abi-known tl)) si true)
                           info))))))
    (_ (tl-abi-info-raw tl t))))

; ============================ debug info =====================================
; DWARF for tpde (on by default; dwarf.coil's records and writer). A source
; position is packed into a CIR location: (source + 1) << 40 | byte offset.
;
; Variables live in registers that change, so each one the debugger shows
; also has a shadow stack slot: binding a variable stores its value there and
; every assignment to a promoted variable stores again, so the slot always
; holds the current value, while reads stay in registers. A variable already
; in memory (a stack slot, an aggregate's private storage) is described where
; it is, and a place reached through a pointer by a slot holding the pointer.
; A variable whose value is an address in the frame is described as that
; address (frame base + offset) rather than stored: storing it would make the
; frame's address escape, which turns off tail calls. One that is not a fixed
; offset in the frame is not described.

(defn dbg-loc [(src i64) (lo i64)] (-> u64)
  (| (<< (primitive/cast u64 (+ src 1)) (: 40 u64)) (primitive/cast u64 lo)))

;;; The ordinal of alloca `v` in the function's allocas (cir/alloca! keeps it).
(defn alloca-ordinal [(tl (ptr Tl)) (v u32)] (-> i64)
  (i64-of (.next (cir/val (.f tl) v))))

;;; Whether `e` is the checker's binding of a mutable local `name`: the
;;; address of `name.slot`, after its initializing store.
(defn mutable-local-expr? [(e (ptr Expr)) (name (slice u8))] (-> bool)
  (match (.kind e)
    (EDo [body]
         (let [n (len (load body))]
           (and (> n 0)
                (match (.kind (elem body (- n 1)))
                  (EVar [v] (and (= (len v) (+ (len name) 5)) (= (subslice v 0 (len name)) name)
                                 (= (subslice v (len name) (len v)) ".slot")))
                  (_ false)))))
    (_ false)))

;;; If `v` is a stack slot's address (an alloca plus constant offsets): the
;;; alloca's ordinal and the offset; else (-1, 0).
(defn frame-slot-of [(tl (ptr Tl)) (v u32)] (-> (array i64 2))
  (let [f (.f tl)
        b (cir/addr-base f v)]
    (if (= (primitive/cast i64 (.op (cir/val f b))) cir/OP-ALLOCA)
        [(alloca-ordinal tl b) (cir/addr-off f v 0)]
        [-1 0])))

;;; A shadow slot for a value of type `t`, holding `v` from here on: its
;;; offset in the debug frame (one stack slot per function, sized when the
;;; function is lowered: fewer slots for the compiler to place).
(defn dbg-shadow-new [(tl (ptr Tl)) (t Type) (v u32)] (-> i64)
  (let [(mut tt) t
        al (talign tl (mut tt))
        off (& (+ (.dbg-frame-size tl) (- al 1)) (- 0 al))]
    (when (= (.dbg-frame tl) (none32)) (set! (.dbg-frame tl) (new-slot-bytes tl 8 16)))
    (set! (.dbg-frame-size tl) (+ off (tsize tl (mut tt))))
    (store-scalar tl (.dbg-frame tl) off v (mut tt))
    off))

;;; The shadow slot holding SSA value `v` (made on first use).
(defn dbg-value-slot [(tl (ptr Tl)) (t Type) (v u32)] (-> i64)
  (let [(mut k) 0 (mut hit) -1]
    (while (and (< hit 0) (< k (len (.dbg-vslots tl))))
      (when (= (get (.dbg-vslots tl) k) (primitive/cast i64 v)) (set! hit (get (.dbg-vslots tl) (+ k 1))))
      (set! k (+ k 2)))
    (if (>= hit 0)
        hit
        (let [off (dbg-shadow-new tl t v)]
          (push! (mut (.dbg-vslots tl)) (primitive/cast i64 v))
          (push! (mut (.dbg-vslots tl)) off)
          off))))

;;; A shadow slot's offset without storing to it yet.
(defn dbg-shadow-reserve [(tl (ptr Tl)) (t Type)] (-> i64)
  (let [(mut tt) t
        al (talign tl (mut tt))
        off (& (+ (.dbg-frame-size tl) (- al 1)) (- 0 al))]
    (when (= (.dbg-frame tl) (none32)) (set! (.dbg-frame tl) (new-slot-bytes tl 8 16)))
    (set! (.dbg-frame-size tl) (+ off (tsize tl (mut tt))))
    off))

;;; Whether every function keeps its debug frame: set when `-g` asks for debugging
;;; (driver.coil), rather than for the debug info native builds carry by default.
(defn tpde-debug-frames-cell [] (-> (ptr bool))
  (primitive/alloc-static bool))

(defn set-tpde-debug-frames! [(on bool)] (-> i64)
  (set! (tpde-debug-frames-cell) on)
  0)

;;; Give the debug frame its final size; or, in a leaf with no other stack
;;; slot, drop it with the variables it holds. Such a function would otherwise
;;; need no frame at all, and the frame was what debug info cost: setting one
;;; up in every small leaf made prop_bench 75% slower. Its lines stay. Under
;;; `-g` the frame stays, so a parameter is visible after its last use.
(defn dbg-frame-close! [(tl (ptr Tl))] (-> void)
  (let [f (.f tl)
        fr (.dbg-frame tl)]
    (when (!= fr (none32))
      (if (and (not (load (tpde-debug-frames-cell)))
               (= (len (.allocas (load f))) 1) (not (.has-dynamic-alloca (load f))) (not (cir/calls-anything? f)))
          (do (cir/drop-alloca! f fr)
              ; what the frame held: parameters are tracked instead (no
              ; store, so no frame); promoted variables are not described
              (let [(mut k) 0]
                (for i (range 0 (len (.dw-vars tl)))
                  (let [dv (get (.dw-vars tl) i)
                        val (get (.dw-var-val tl) i)
                        in-frame (and (not (.loclist dv)) (not (.cst dv)) (not (.addr dv)))]
                    (when (or (not in-frame) (!= val (none32)))
                      (let [(mut nd) dv]
                        (when in-frame
                          (set! (.loclist nd) true)
                          (set! (.slot nd) (len (.dw-track tl)))
                          (push! (mut (.dw-track tl)) val))
                        (set! (mut (.dw-vars tl)) k nd)
                        (set! (mut (.dw-var-extra tl)) k (if in-frame 0 (get (.dw-var-extra tl) i)))
                        (set! (mut (.dw-var-val tl)) k val)
                        (set! k (+ k 1))))))
                (set! (.len (.dw-vars tl)) k)
                (set! (.len (.dw-var-extra tl)) k)
                (set! (.len (.dw-var-val tl)) k))
              (set! (.dbg-frame tl) (none32)))
          (set! (.imm (cir/val f fr)) (if (< (.dbg-frame-size tl) 8) 8 (.dbg-frame-size tl)))))))

;;; Attribute the instructions made from here on to the line of `lo` in
;;; source `src`: a new position only when no newline lies between it and the
;;; last one (lowering needs no line table: the encoding stage builds them).
(defn dbg-at! [(tl (ptr Tl)) (src i64) (lo i64)] (-> void)
  (let [last (.dbg-line-lo tl)]
    (unless (and (= src (.dbg-cur-src tl)) (= lo last))
      (if (and (= src (.dbg-cur-src tl)) (< src (len (load (.dbg-texts tl))))
               (no-newline? (get (load (.dbg-texts tl)) src) (if (< lo last) lo last) (if (< lo last) last lo)))
          (when (< lo last)
            ; an earlier column on the same line: still that line
            (set! (.dbg-line-lo tl) lo))
          (do (set! (.dbg-cur-src tl) src)
              (set! (.dbg-line-lo tl) lo)
              (cir/set-loc! (.f tl) (dbg-loc src lo)))))))

(defn no-newline? [(text (slice u8)) (a i64) (b i64)] (-> bool)
  (or (>= a b) (> b (len text))
      (= (primitive/cast i64 (cgtpde.memchr (index (data text) a) (: 10 i32) (primitive/cast usize (- b a)))) 0)))

;;; A 64-bit structural hash of a type (0: not hashed, look it up), for
;;; dbg-ty's memo. A struct is hashed by its name's bytes, so equal types hash
;;; alike wherever mono boxed them.
(defn mix [(h u64) (x u64)] (-> u64) (* (^ h x) (: 0x100000001B3 u64)))

(defn ty-identity [(t (ptr Type))] (-> u64)
  (do
    (match (load t)
      (TInt [bits sg] (mix (: 1 u64) (| (<< (primitive/cast u64 bits) (: 1 u64)) (if sg (: 1 u64) (: 0 u64)))))
      (TBool [] (: 2 u64))
      (TFloat [bits] (mix (: 3 u64) (primitive/cast u64 bits)))
      (TPtr [inner] (let [h (ty-identity inner)] (if (= h (: 0 u64)) h (mix (: 4 u64) h))))
      (TRef [_m inner] (let [h (ty-identity inner)] (if (= h (: 0 u64)) h (mix (: 4 u64) h))))
      (TSlice [elem] (let [h (ty-identity elem)] (if (= h (: 0 u64)) h (mix (: 6 u64) h))))
      (TStruct [nm]
               (let [(mut h) (: 0xcbf29ce484222325 u64)]
                 (for i (range 0 (len nm)) (set! h (mix h (primitive/cast u64 (get nm i)))))
                 (mix h (: 7 u64))))
      (_ (: 0 u64)))))

(const DBG-TY-MEMO 4096)

;;; dw-ty-of! through a direct-mapped memo: most variables have one of a few
;;; types, and rendering a type's name to look it up was most of describing a
;;; variable.
(defn dbg-ty [(tl (ptr Tl)) (t (ptr Type))] (-> i64)
  (let [k (ty-identity t)]
    (if (= k (: 0 u64))
        (dw-ty-of! (.g tl) t)
        (let [h (primitive/cast i64 (& (^ (^ k (>> k (: 17 u64))) (>> k (: 31 u64))) (: 4095 u64)))]
          (when (= (len (.dbg-ty-keys tl)) 0)
            (extend-zeroed! (mut (.dbg-ty-keys tl)) DBG-TY-MEMO)
            (extend-zeroed! (mut (.dbg-ty-vals tl)) DBG-TY-MEMO))
          (if (= (get (.dbg-ty-keys tl) h) k)
              (get (.dbg-ty-vals tl) h)
              (let [ti (dw-ty-of! (.g tl) t)]
                (set! (mut (.dbg-ty-keys tl)) h k)
                (set! (mut (.dbg-ty-vals tl)) h ti)
                ti))))))

(defn dbg-var! [(tl (ptr Tl)) (name (slice u8)) (t Type) (ordinal i64) (extra i64) (indirect bool) (param bool)
                (src i64) (lo i64)] (-> void)
  (dbg-var-at! tl name t ordinal extra indirect false param src lo))

;;; `addr`: the variable is the slot's address itself (see DwVar).
(defn dbg-var-at! [(tl (ptr Tl)) (name (slice u8)) (t Type) (ordinal i64) (extra i64) (indirect bool) (addr bool)
                   (param bool) (src i64) (lo i64)] (-> void)
  (dbg-var-full! tl name t ordinal extra indirect addr param src lo false false 0 (none32)))

;;; A variable the compiler's placement describes: `v` is tracked (its
;;; location sampled at every row), the variable a location list over it.
(defn dbg-var-tracked! [(tl (ptr Tl)) (name (slice u8)) (t Type) (v u32) (indirect bool) (param bool)
                        (src i64) (lo i64)] (-> void)
  (let [k (len (.dw-track tl))]
    (push! (mut (.dw-track tl)) v)
    (dbg-var-full! tl name t k 0 indirect false param src lo true false 0 v)))

(defn dbg-var-full! [(tl (ptr Tl)) (name (slice u8)) (t Type) (slot i64) (extra i64) (indirect bool) (addr bool)
                     (param bool) (src i64) (lo i64) (loclist bool) (cst bool) (cval i64) (val u32)] (-> void)
  (let [(mut tt) t
        ti (dbg-ty tl (mut tt))]
    (when (and (>= ti 0) (>= slot 0) (not (.terminated tl)))
      (open! tl)
      (push! (mut (.dw-vars tl))
             (DwVar :name name :tyidx ti :slot slot :indirect indirect :param param :source src :lo lo
                    ; a local comes into scope here (its value is stored)
                    :start (if param -1 (primitive/cast i64 (cir/dbg-mark! (.f tl)))) :end -1 :addr addr
                    :loclist loclist :cst cst :cval cval))
      (push! (mut (.dw-var-extra tl)) extra)
      (push! (mut (.dw-var-val tl)) val)
      0)))

;;; Describe a binding of `name` to `tv` (a parameter when `param`).
(defn dbg-bind! [(tl (ptr Tl)) (name (slice u8)) (tv TV) (param bool) (src i64) (lo i64) (value (ptr Expr))] (-> void)
  (when (and (.dbg tl) (not (.terminated tl)) (>= src 0) (>= lo 0) (dbg-name? name))
    (open! tl)
    (let [f (.f tl)
          k (.kind tv)]
      (cond
        (= k 3)
          ; a promoted variable: one shadow slot per CIR variable, which
          ; tl-store keeps current
          (let [var (i64-of (.v tv))]
            (while (<= (len (.dbg-shadow tl)) var) (push! (mut (.dbg-shadow tl)) (none32)))
            (when (= (get (.dbg-shadow tl) var) (none32))
              ; the value this block gave it (just initialized, as a rule);
              ; reading it from elsewhere would search predecessors and could
              ; add phis, so then the next assignment fills the slot
              (let [cur (cir/lookup-def f (.v tv) (.cur (load f)))]
                (set! (mut (.dbg-shadow tl)) var
                      (u32-of (if (= cur (none32)) (dbg-shadow-reserve tl (.ty tv)) (dbg-shadow-new tl (.ty tv) cur))))))
            (dbg-var! tl name (.ty tv) (alloca-ordinal tl (.dbg-frame tl)) (i64-of (get (.dbg-shadow tl) var))
                      false param src lo))
        (= k 0)
          (if (cir/frame-derived? f (.v tv))
              ; a mutable local's name is the address of its slot
              (match (.ty tv)
                (TPtr [inner]
                      (let [fs (frame-slot-of tl (.v tv))]
                        (when (>= (get fs 0) 0)
                          (if (and (!= (primitive/cast i64 value) 0) (mutable-local-expr? value name))
                              (dbg-var! tl name (load inner) (get fs 0) (get fs 1) false param src lo)
                              ; another address in the frame (an aggregate's
                              ; storage): described as that address
                              (dbg-var-at! tl name (.ty tv) (get fs 0) (get fs 1) false true param src lo)))))
                (_ 0))
              (cond
                ; a parameter in a shadow slot: always visible (its value
                ; kept, should the frame it needs be dropped, for tracking)
                param
                  (let [off (dbg-value-slot tl (.ty tv) (.v tv))]
                    (dbg-var-full! tl name (.ty tv) (alloca-ordinal tl (.dbg-frame tl)) off false false param src lo
                                   false false 0 (.v tv)))
                ; a constant is its value
                (and (= (primitive/cast i64 (.op (cir/val f (.v tv)))) cir/OP-CONST)
                     (= (primitive/cast i64 (.ty (cir/val f (.v tv)))) cir/T-I64))
                  (dbg-var-full! tl name (.ty tv) 0 0 false false param src lo false true (.imm (cir/val f (.v tv))) (none32))
                ; an immutable local: where the compiler keeps it
                :else (dbg-var-tracked! tl name (.ty tv) (.v tv) false param src lo)))
        (= k 1)
          (let [fs (frame-slot-of tl (.v tv))]
            (cond
              (>= (get fs 0) 0) (dbg-var! tl name (.ty tv) (get fs 0) (get fs 1) false param src lo)
              (and param (not (cir/frame-derived? f (.v tv))))
                (let [off (dbg-shadow-new tl (i64t) (.v tv))]
                  (dbg-var-full! tl name (.ty tv) (alloca-ordinal tl (.dbg-frame tl)) off true false param src lo
                                 false false 0 (.v tv)))
              ; an immutable place through a pointer: where the pointer is
              (not (cir/frame-derived? f (.v tv)))
                (dbg-var-tracked! tl name (.ty tv) (.v tv) true param src lo)
              :else 0))
        :else 0))
    0))

;;; An assignment to promoted variable `var`: keep its shadow slot current.
(defn dbg-assigned! [(tl (ptr Tl)) (var u32) (t Type) (v u32)] (-> void)
  (when (.dbg tl)
    (let [vi (i64-of var)]
      (when (and (< vi (len (.dbg-shadow tl))) (!= (get (.dbg-shadow tl) vi) (none32)))
        (let [(mut tt) t] (store-scalar tl (.dbg-frame tl) (i64-of (get (.dbg-shadow tl) vi)) v (mut tt)))))))

;;; The let's locals, the variables its bindings made ([first, hi)), go out of
;;; scope here. (Those of lets nested in its body ended at their own ends:
;;; scanning them again made deep nesting quadratic.)
(defn dbg-scope-end! [(tl (ptr Tl)) (first i64) (hi i64)] (-> void)
  (when (and (.dbg tl) (< first hi) (not (.terminated tl)))
    (let [(mut any) false]
      (for v (range first hi) (when (< (.end (elem (mut (.dw-vars tl)) v)) 0) (set! any true)))
      (when any
        (open! tl)
        (let [id (primitive/cast i64 (cir/dbg-mark! (.f tl)))]
          (for v (range first hi)
            (let [dv (elem (mut (.dw-vars tl)) v)]
              (when (< (.end dv) 0) (set! (.end dv) id)))))))))

; ============================ scopes =========================================

(defn bind! [(tl (ptr Tl)) (name (slice u8)) (tv TV)] (-> void)
  (push! (mut (.env tl)) (TBind :name name :tv tv)))

;;; Name equality, rejecting on the length and first byte before comparing.
(defn name= [(a (slice u8)) (b (slice u8))] (-> bool)
  (let [n (len a)]
    (and (= n (len b))
         (or (= n 0)
             (and (= (get a 0) (get b 0)) (= a b))))))

(defn lookup [(tl (ptr Tl)) (name (slice u8))] (-> (Option TV))
  (let [(mut i) (- (len (.env tl)) 1)]
    (block :found
      (while (>= i 0)
        (let [b (al-at [TBind] (field tl env) i)]
          (when (name= (.name b) name) (return-from :found (Some (.tv b)))))
        (set! i (- i 1)))
      (None))))

(defn scope-mark [(tl (ptr Tl))] (-> i64) (len (.env tl)))
(defn scope-pop! [(tl (ptr Tl)) (mark i64)] (-> void) (set! (.len (.env tl)) mark))

; ============================ promotion pre-pass ============================
; A candidate is an `alloc stack` of a scalar bound by a let, directly or
; through `(do (init-store (var S) v) (var S))`. Any use of its name other than
; as the address of a load or store escapes it.


;; ---- the promotion table ----

(defn allocs-home [(tl (ptr Tl)) (k u64)] (-> i64)
  (& (primitive/cast i64 (>> (* k (: 0x9E3779B97F4A7C15 u64)) (: 32 u64))) (- (len (.allocs tl)) 1)))

;;; 1 escaped, 0 promotable, -1 never seen in this function.
(defn allocs-get [(tl (ptr Tl)) (k u64)] (-> i64)
  (if (= (len (.allocs tl)) 0)
      -1
      (let [gen (.alloc-gen tl)
            mask (- (len (.allocs tl)) 1)
            (mut i) (allocs-home tl k)]
        (block :found
          (while (= (.gen (get (.allocs tl) i)) gen)
            (let [sl (get (.allocs tl) i)]
              (when (= (.key sl) k) (return-from :found (if (.escaped sl) 1 0))))
            (set! i (& (+ i 1) mask)))
          -1))))

(defn allocs-put! [(tl (ptr Tl)) (k u64) (escaped bool)] (-> void)
  (let [gen (.alloc-gen tl)
        mask (- (len (.allocs tl)) 1)
        (mut i) (allocs-home tl k)]
    (while (and (= (.gen (get (.allocs tl) i)) gen) (!= (.key (get (.allocs tl) i)) k))
      (set! i (& (+ i 1) mask)))
    (let [sl (elem (mut (.allocs tl)) i)]
      (when (!= (.gen sl) gen) (set! (.alloc-count tl) (+ (.alloc-count tl) 1)))
      (set! (.key sl) k)
      (set! (.escaped sl) escaped)
      (set! (.gen sl) gen))))

(defn allocs-set! [(tl (ptr Tl)) (k u64) (escaped bool)] (-> void)
  (when (>= (* (+ (.alloc-count tl) 1) 2) (len (.allocs tl)))
    (let [gen (.alloc-gen tl)
          old (len (.allocs tl))
          (mut live) (ArrayList::new [AllocSlot] (.a tl))]
      (for i (range 0 old)
        (let [sl (get (.allocs tl) i)] (when (= (.gen sl) gen) (push! (mut live) sl))))
      (extend-zeroed! (mut (.allocs tl)) (if (= old 0) 64 old))
      (for i (range 0 (len (.allocs tl))) (set! (.gen (elem (mut (.allocs tl)) i)) (: 0 u32)))
      (set! (.alloc-count tl) 0)
      (for i (range 0 (len live))
        (let [sl (get live i)] (allocs-put! tl (.key sl) (.escaped sl))))))
  (allocs-put! tl k escaped))

;;; Forget the previous function's promotion decisions.
(defn allocs-reset! [(tl (ptr Tl))] (-> void)
  (set! (.alloc-count tl) 0)
  (set! (.alloc-gen tl) (+ (.alloc-gen tl) (: 1 u32)))
  (when (= (.alloc-gen tl) (: 0 u32))
    (for i (range 0 (len (.allocs tl))) (set! (.gen (elem (mut (.allocs tl)) i)) (: 0 u32)))
    (set! (.alloc-gen tl) (: 1 u32))))

(defn scan-lookup [(env (ptr (ArrayList PBind))) (name (slice u8))] (-> u64)
  (let [(mut i) (- (len (load env)) 1)]
    (block :found
      (while (>= i 0)
        (let [b (get (load env) i)]
          (when (name= (.name b) name) (return-from :found (.key b))))
        (set! i (- i 1)))
      (: 0 u64))))

(defn scan-escape! [(tl (ptr Tl)) (env (ptr (ArrayList PBind))) (name (slice u8))] (-> void)
  (let [k (scan-lookup env name)]
    (when (!= k (: 0 u64)) (allocs-set! tl k true))))

;; The candidate a binding's value makes the name stand for, or 0.
(defn scan-bind-key [(tl (ptr Tl)) (env (ptr (ArrayList PBind))) (e (ptr Expr))] (-> u64)
  (match (.kind e)
    (EAlloc [storage t _init _sym]
            (if (and (or (= storage 0) (= storage 3)) (let [(mut tt) t] (tl-scalar? (mut tt))))
                (let [k (primitive/cast u64 e)]
                  (when (< (allocs-get tl k) 0) (allocs-set! tl k false))
                  k)
                (: 0 u64)))
    (EDo [body]
         (let [n (len (load body))]
           (if (= n 0)
               (: 0 u64)
               (match (.kind (elem body (- n 1)))
                 (EVar [nm] (scan-lookup env nm))
                 (_ (: 0 u64))))))
    (_ (: 0 u64))))

(defn scan-list! [(tl (ptr Tl)) (env (ptr (ArrayList PBind))) (xs (ptr (ArrayList Expr)))] (-> void)
  (for i (range 0 (len (load xs))) (scan! tl env (elem xs i))))

;; Visit a load/store address: a bare name is not an escape.
(defn scan-addr! [(tl (ptr Tl)) (env (ptr (ArrayList PBind))) (p (ptr Expr))] (-> void)
  (match (.kind p)
    (EVar [_] 0)
    (_ (do (scan! tl env p) 0))))

(defn scan-do-body! [(tl (ptr Tl)) (env (ptr (ArrayList PBind))) (body (ptr (ArrayList Expr)))] (-> void)
  ; the alias form's trailing (var S) is the binding's value, not an escape
  (let [n (len (load body))]
    (for i (range 0 n)
      (let [e (elem body i)]
        (if (and (= i (- n 1)) (match (.kind e) (EVar [_] true) (_ false)))
            0
            (scan! tl env e))))))

(defn scan! [(tl (ptr Tl)) (env (ptr (ArrayList PBind))) (e (ptr Expr))] (-> void)
  (match (.kind e)
    (EVar [nm] (scan-escape! tl env nm))
    (ELoad [inner] (scan-addr! tl env inner))
    (EStore [p v] (do (scan-addr! tl env p) (scan! tl env v)))
    (EInitStore [p v] (do (scan-addr! tl env p) (scan! tl env v)))
    (ELet [binds body] (scan-let! tl env binds body 0))
    (EMatch [scrut arms]
            (do (scan! tl env scrut)
                (for i (range 0 (len (load arms)))
                  (let [arm (al-at [Arm] arms i)
                        mark (len (load env))
                        binds (load (field arm binds))]
                    (when (> mark 0)
                      (for j (range 0 (len (load binds)))
                        (push! env (PBind :name (get (load binds) j) :key (: 0 u64)))))
                    (scan! tl env (field arm body))
                    (set! (.len env) mark)))
                0))
    (EBin [_ l r] (do (scan! tl env l) (scan! tl env r) 0))
    (ECmp [_ l r] (do (scan! tl env l) (scan! tl env r) 0))
    (EIntUnary [_ x] (scan! tl env x))
    (EIf [c t el] (do (scan! tl env c) (scan! tl env t) (scan! tl env el) 0))
    (EDo [body] (scan-list! tl env body))
    (ECall [_ _ args] (scan-list! tl env args))
    (ECallPtr [fp args] (do (scan! tl env fp) (scan-list! tl env args) 0))
    (EField [p _] (scan! tl env p))
    (EAccessorField [p _] (scan! tl env p))
    (EIndex [p i] (do (scan! tl env p) (scan! tl env i) 0))
    (ECast [_ x] (scan! tl env x))
    (EBorrow [_ p] (scan! tl env p))
    (ESpillRef [x] (scan! tl env x))
    (EBitGet [p _] (scan! tl env p))
    (EBitSet [p _ v] (do (scan! tl env p) (scan! tl env v) 0))
    (EFree [x] (scan! tl env x))
    (EFnPtrOf [_] 0)
    (ELoop [_ body] (scan-list! tl env body))
    (EBreak [_ v] (match v (Some [x] (scan! tl env x)) (None [] 0)))
    (ELlvmIr [_ args _] (scan-list! tl env args))
    (EIntrinsic [_ _ args] (scan-list! tl env args))
    (EVector [_ _ _ args] (scan-list! tl env args))
    (EConstruct [_ _ args] (scan-list! tl env args))
    (EMakeDyn [_ _ _ x] (scan! tl env x))
    (EDynDispatch [dc] (do (scan! tl env (.recv dc)) (scan-list! tl env (.args dc)) 0))
    (ECleanup [b cs] (do (scan! tl env b) (scan-list! tl env cs) 0))
    (EMakeSlice [d _ _] (scan! tl env d))
    (EAlloc [_ _ init _] (if (!= (primitive/cast i64 init) 0) (scan! tl env init) 0))
    (_ 0)))

(defn scan-let! [(tl (ptr Tl)) (env (ptr (ArrayList PBind))) (binds (ptr (ArrayList Bind))) (body (ptr (ArrayList Expr))) (start i64)] (-> void)
  (let [mark (len (load env))]
    (for i (range start (len (load binds)))
      (let [b (al-at [Bind] binds i)
            v (field b value)
            alias-do (match (.kind v) (EDo [_] true) (_ false))]
        (if alias-do
            (match (.kind v) (EDo [body] (scan-do-body! tl env body)) (_ 0))
            (scan! tl env v))
        (let [k (if (.mutable b) (: 0 u64) (scan-bind-key tl env v))]
          ; env holds nothing until the first candidate: only a name
          ; shadowing one needs recording
          (when (or (!= k (: 0 u64)) (> (len (load env)) 0))
            (push! env (PBind :name (.name b) :key k))))))
    (scan-list! tl env body)
    (set! (.len env) mark)))

;;; Whether `e` is an EAlloc a let could promote that no scan has seen yet.
(defn fresh-candidate? [(tl (ptr Tl)) (e (ptr Expr))] (-> bool)
  (match (.kind e)
    (EAlloc [storage t _init _sym]
            (and (or (= storage 0) (= storage 3))
                 (< (allocs-get tl (primitive/cast u64 e)) 0)
                 (let [(mut tt) t] (tl-scalar? (mut tt)))))
    (_ false)))

;;; The promotion scan runs lazily, from the first let that binds a candidate,
;;; over that let's scope: a name is visible only there, so its escapes are too.
;;; The scan also decides every candidate nested in the scope, so a nested let
;;; finds its candidates seen and scans nothing. Functions without candidates
;;; (four in five in the compiler) are not scanned at all.
(defn scan-let-lazily! [(tl (ptr Tl)) (binds (ptr (ArrayList Bind))) (body (ptr (ArrayList Expr)))] (-> void)
  (let [n (len (load binds))]
    (block :found
      (for i (range 0 n)
        (let [b (al-at [Bind] binds i)]
          (when (and (not (.mutable b)) (fresh-candidate? tl (field b value)))
            (clear! (mut (.penv tl)))
            (scan-let! tl (cast (ptr (ArrayList PBind)) (mut (.penv tl))) binds body i)
            (return-from :found 0))))
      0)))

(defn promotable? [(tl (ptr Tl)) (e (ptr Expr))] (-> bool)
  (= (allocs-get tl (primitive/cast u64 e)) 0))

; ============================ expressions ====================================

(defn tl-body [(tl (ptr Tl)) (body (ptr (ArrayList Expr)))] (-> TV)
  (let [n (len (load body))
        (mut last) (tv-s (iconst tl 0) (i64t))]
    (block :done
      (for i (range 0 n)
        (when (.terminated tl) (return-from :done 0))
        (set! last (tl-expr tl (elem body i))))
      0)
    last))

;; A body whose last expression is in tail position.
(defn tl-body-tail [(tl (ptr Tl)) (body (ptr (ArrayList Expr))) (tail bool)] (-> TV)
  (let [n (len (load body))
        (mut last) (tv-s (iconst tl 0) (i64t))]
    (block :done
      (for i (range 0 n)
        (when (.terminated tl) (return-from :done 0))
        (when (and tail (= i (- n 1))) (set! (.tailok tl) true))
        (set! last (tl-expr tl (elem body i))))
      0)
    last))

(defn tl-stmts [(tl (ptr Tl)) (body (ptr (ArrayList Expr)))] (-> void)
  (block :done
    (for i (range 0 (len (load body)))
      (when (.terminated tl) (return-from :done 0))
      (tl-expr tl (elem body i)))
    0))

;;; Tail position is consumed on entry.
(defn tl-expr [(tl (ptr Tl)) (e (ptr Expr))] (-> TV)
  (let [tail (.tailok tl)]
    (set! (.tailok tl) false)
    ; an inlined callee's code keeps its call site's position
    (when (and (.dbg tl) (= (.inline-depth tl) 0) (>= (.source e) 0) (>= (.lo e) 0))
      (dbg-at! tl (.source e) (.lo e)))
    (match (.kind e)
      (EIf [cnd thn els] (tl-if tl cnd thn els tail))
      (ECall [func _targs args] (tl-call-named tl func args tail))
      ; a never-returning call in tail position is a jump too when it can be
      ; one: the checker follows it with an empty loop (ast.coil,
      ; diverging-call), which the call and loop lower to otherwise
      (EDo [body]
           (match (if tail (diverging-call e) (None [(ptr Expr)]))
             (Some [call]
                   (match (.kind call)
                     (ECall [func _targs args]
                            (if (tail-jump? tl func)
                                (tl-call-named tl func args true)
                                (tl-body-tail tl body tail)))
                     (_ (tl-body-tail tl body tail))))
             (None [] (tl-body-tail tl body tail))))
      (ELet [binds body] (tl-let tl binds body tail))
      (_ (tl-expr-rest tl e)))))

(defn tl-let [(tl (ptr Tl)) (binds (ptr (ArrayList Bind))) (body (ptr (ArrayList Expr))) (tail bool)] (-> TV)
  (scan-let-lazily! tl binds body)
  (let [mark (scope-mark tl)
        dbg-first (len (.dw-vars tl))]
    (block :binds
      (for i (range 0 (len (load binds)))
        (when (.terminated tl) (return-from :binds 0))
        (let [b (al-at [Bind] binds i)
              tv (tl-expr tl (field b value))]
          (if (.mutable b)
              ; a stable slot, and the name is a pointer to it
              (let [(mut t) (.ty tv)
                    s (new-slot tl (mut t))]
                (store-tv tl s 0 tv)
                (bind! tl (.name b) (tv-s s (TPtr (box-ty tl (.ty tv)))))
                (when (.dbg tl)
                  (dbg-var! tl (.name b) (.ty tv) (alloca-ordinal tl s) 0 false false
                            (.source (.value b)) (.lo (.value b)))))
              (do (bind! tl (.name b) tv)
                  (dbg-bind! tl (.name b) tv false (.source (.value b)) (.lo (.value b)) (field b value))))))
      0)
    (let [dbg-hi (len (.dw-vars tl))
          r (tl-body-tail tl body tail)]
      (dbg-scope-end! tl dbg-first dbg-hi)
      (scope-pop! tl mark)
      r)))

(defn tl-expr-rest [(tl (ptr Tl)) (e (ptr Expr))] (-> TV)
  (match (.kind e)
    (EInt [v] (tv-s (iconst tl v) (i64t)))
    (EWideInt [_ lo hi _ _] (tv-s (cir/const! (.f tl) cir/T-I128 (primitive/cast u64 lo) (primitive/cast u64 hi)) (TInt 128 true)))
    (EFloat [bits] (tv-s (cir/const! (.f tl) cir/T-F64 (primitive/cast u64 bits) (: 0 u64)) (TFloat 64)))
    (EBool [b] (tv-s (iconst tl (if b 1 0)) (TBool)))
    (EStr [sv]
          (let [sym (g-intern-str! (.g tl) sv true)
                s (new-slot-bytes tl 16 8)]
            (store-n tl s 0 (sym-val tl sym) 8)
            (store-n tl s 8 (iconst tl (len sv)) 8)
            (tv-p s (TSlice (box-ty tl (TInt 8 false))))))
    (ECStr [sv]
           (let [sym (g-intern-str! (.g tl) sv true)]
             (tv-s (sym-val tl sym) (TPtr (box-ty tl (TInt 8 true))))))
    (EVar [name]
          (match (lookup tl name)
            (Some [tv] tv)
            (None [] (tl-fail (sconcat (.a tl) "tpde: unbound variable: " name)))))
    (EZeroed [t] (tl-zeroed tl t))
    (ERecordInit [t] (tl-zeroed tl t))
    (EBorrow [_m p] (tl-addr-of tl (tl-expr tl p)))
    (ESpillRef [inner]
               (let [tv (tl-expr tl inner)
                     (mut t) (.ty tv)]
                 (tv-s (place tl tv) (TPtr (box-ty tl (.ty tv))))))
    (ECleanup [body cleanups]
              (let [r (tl-expr tl body)
                    r2 (snapshot tl r)]
                (tl-stmts tl cleanups)
                r2))
    (EBin [op lhs rhs] (tl-bin tl op (tl-expr tl lhs) (tl-expr tl rhs)))
    (ECmp [op lhs rhs] (tl-cmp tl op (tl-expr tl lhs) (tl-expr tl rhs)))
    (EIntUnary [op inner] (tl-int-unary tl op (tl-expr tl inner)))
    (ELoop [label body] (tl-loop tl label body))
    (EBreak [label value] (tl-break tl label value))
    (EContinue [label]
               (let [li (tl-loop-index tl label)
                     lp (al-at [TLoop] (field tl loops) li)]
                 (open! tl)
                 (cir/br! (.f tl) (.head lp))
                 (set! (.terminated tl) true)
                 (tv-none)))
    (ECallPtr [fp args] (tl-call-ptr tl fp args false))
    (EAlloc [storage t init symbol] (tl-alloc tl e storage t init symbol))
    (EAccessorField [p fname] (tl-field tl (tl-expr tl p) fname))
    (EField [p fname] (tl-field tl (tl-expr tl p) fname))
    (ELoad [inner] (tl-load tl (tl-expr tl inner)))
    (EStore [p val] (tl-store tl (tl-expr tl p) (tl-expr tl val)))
    (EInitStore [p val] (tl-store tl (tl-expr tl p) (tl-expr tl val)))
    (EIndex [p idx] (tl-index tl (tl-expr tl p) (tl-expr tl idx)))
    (ECast [t inner] (tl-cast tl t (tl-expr tl inner)))
    (ESizeOf [t] (let [(mut tp) t] (tv-s (iconst tl (tsize tl (mut tp))) (i64t))))
    (EAlignOf [t] (let [(mut tp) t] (tv-s (iconst tl (talign tl (mut tp))) (i64t))))
    (EOffsetOf [t fname]
               (match t
                 (TStruct [nm]
                          (let [si (g-struct-idx (.g tl) nm)]
                            (tv-s (iconst tl (g-field-off (.g tl) si (g-field-idx (.g tl) si fname))) (i64t))))
                 (_ (tl-fail "offset-of on non-struct type"))))
    (EFree [inner]
           (let [v (scalar tl (tl-expr tl inner))]
             (tl-runtime-call tl "_free" v (none32) cir/T-VOID)
             (tv-s (iconst tl 0) (i64t))))
    (EConstruct [sum variant args] (tl-construct tl sum variant args))
    (EMatch [scrut arms] (tl-match tl scrut arms))
    (EFnPtrOf [name0]
              (let [name (g-fnptr-target (.g tl) name0)
                    si (g-sig-idx (.g tl) name)]
                (when (< si 0) (tl-fail (sconcat (.a tl) "fnptr-of unknown function: " name)))
                (let [sig (al-at [GSig] (field (.g tl) sigs) si)]
                  (tv-s (sym-val tl (.symidx sig))
                        (TFn :cc (cc-c) :params (load (field sig params)) :ret (box-ty tl (.ret sig)))))))
    (EBitGet [p fname] (tl-bitget tl p fname))
    (EBitSet [p fname val] (tl-bitset tl p fname val))
    (ELlvmIr [result args body] (tir/tl-llvmir tl result args body))
    (EIntrinsic [op result args] (tl-intrinsic tl op result args))
    (EVector [op result types args]
             (let [a (.a tl)
                   mark (scope-mark tl)
                   (mut values) (ArrayList::new [TV] a)]
               (for i (range 0 (len (load args)))
                 (push! (mut values) (tl-expr tl (elem args i))))
               (for i (range 0 (len (load args)))
                 (bind! tl (vs-argument-name a i) (get values i)))
               (let [lowered (match (scalarize-vector a op (box-ty tl result) types)
                               (Ok [expr] expr)
                               (Err [d] (let [diag d] (tl-fail (.msg diag)))))
                     v (tl-expr tl (box-expr a lowered))]
                 (scope-pop! tl mark)
                 v)))
    (EMakeDyn [ds vt methods inner] (tl-make-dyn tl ds vt methods inner))
    (EDynDispatch [dc] (tl-dyn-dispatch tl dc))
    (EStaticRef [name]
                (let [si (g-static-idx (.g tl) name)]
                  (when (< si 0) (tl-fail (sconcat (.a tl) "static-ref references an unknown def: " name)))
                  (let [st (al-at [GStatic] (field (.g tl) statics) si)]
                    (tv-s (sym-val tl (.symidx st)) (TPtr (box-ty tl (.ty st)))))))
    (EMakeSlice [data elem n]
                (let [dv (scalar tl (tl-expr tl data))
                      s (new-slot-bytes tl 16 8)]
                  (store-n tl s 0 dv 8)
                  (store-n tl s 8 (iconst tl (extent-value n)) 8)
                  (tv-p s (TSlice (box-ty tl elem)))))
    (_ (tl-fail "tpde: unsupported expression reached the backend"))))

(defn tl-zeroed [(tl (ptr Tl)) (t Type)] (-> TV)
  (let [(mut tp) t]
    (if (tl-scalar? (mut tp))
        (let [ct (tl-cty (mut tp))]
          (tv-s (cir/const! (.f tl) ct (: 0 u64) (: 0 u64)) t))
        (let [s (new-slot tl (mut tp))]
          (memzero tl s (tsize tl (mut tp)))
          (tv-p s t)))))

;;; The address a borrow yields: a place's address, a pointer as is, a scalar
;;; spilled (a promoted slot cannot be borrowed: the pre-pass ruled that out).
(defn tl-addr-of [(tl (ptr Tl)) (tv TV)] (-> TV)
  (cond (= (.kind tv) 3) (tl-fail "tpde: borrow of a promoted local (pre-pass bug)")
        :else tv))

; ---- memory ----

(defn pointee [(tl (ptr Tl)) (tv TV)] (-> Type)
  (let [(mut t) (.ty tv)] (ty-pointee (mut t))))

(defn tl-load [(tl (ptr Tl)) (ptv TV)] (-> TV)
  (if (= (.kind ptv) 3)
      (do (open! tl) (tv-s (cir/use-var! (.f tl) (.v ptv)) (.ty ptv)))
      (let [pt (pointee tl ptv)]
        (read-at tl (scalar tl ptv) 0 pt))))

(defn tl-store [(tl (ptr Tl)) (ptv TV) (vtv TV)] (-> TV)
  (if (= (.kind ptv) 3)
      (let [(mut t) (.ty ptv)]
        (open! tl)
        (let [v (coerce-scalar tl (scalar tl vtv) (.ty vtv) (.ty ptv))]
          (cir/def-var! (.f tl) (.v ptv) v)
          (dbg-assigned! tl (.v ptv) (.ty ptv) v))
        (tv-s (iconst tl 0) (i64t)))
      (let [p (scalar tl ptv)
            pt (pointee tl ptv)
            (mut ptt) pt]
        (if (tl-scalar? (mut ptt))
            (store-scalar tl p 0 (coerce-scalar tl (scalar tl vtv) (.ty vtv) pt) (mut ptt))
            (when (!= (.kind vtv) 2)
              (memcpy tl p (.v vtv) (tsize tl (mut ptt)))
              0))
        (tv-s (iconst tl 0) (i64t)))))

;;; A scalar stored into a slot of type `to`: the representation only changes
;;; between I64 and I128 (a narrow literal stored into a wide integer).
(defn coerce-scalar [(tl (ptr Tl)) (v u32) (from Type) (to Type)] (-> u32)
  (let [(mut ft) from (mut tt) to
        fc (tl-cty (mut ft))
        tc (tl-cty (mut tt))]
    (cond (= fc tc) v
          (and (= tc cir/T-I128) (= fc cir/T-I64))
            (op1 tl (if (int-signed? (mut ft)) cir/OP-SEXT cir/OP-ZEXT) cir/T-I128 v 64 0)
          (and (= tc cir/T-I64) (= fc cir/T-I128)) (op1 tl cir/OP-LO cir/T-I64 v 0 0)
          :else v)))

(defn tl-field [(tl (ptr Tl)) (ptv TV) (fname (slice u8))] (-> TV)
  (let [pt (pointee tl ptv)]
    (match pt
      (TStruct [nm]
               (let [si (g-struct-idx (.g tl) nm)]
                 (when (< si 0) (tl-fail (sconcat (.a tl) "field access on non-struct: " nm)))
                 (let [fi (g-field-idx (.g tl) si fname)
                       off (g-field-off (.g tl) si fi)
                       fty (.ty (al-at [Field] (load (field (struct-at (field (.g tl) layouts) si) fields)) fi))]
                   (tv-s (addi tl (scalar tl ptv) off) (TPtr (box-ty tl fty))))))
      (_ (tl-fail "field access through non-struct pointer")))))

(defn tl-index [(tl (ptr Tl)) (ptv TV) (itv TV)] (-> TV)
  (let [pt (pointee tl ptv)
        (mut ep) (match pt (TArray [elem _n] (load elem)) (_ pt))
        esz (tsize tl (mut ep))
        p (scalar tl ptv)
        i (scalar tl itv)]
    (tv-s (if (const-int? tl i)
              (addi tl p (* (const-val tl i) esz))
              (op2 tl cir/OP-PTRADD cir/T-I64 p i esz 0))
          (TPtr (box-ty tl ep)))))

(defn const-int? [(tl (ptr Tl)) (v u32)] (-> bool)
  (= (primitive/cast i64 (.op (cir/val (.f tl) v))) cir/OP-CONST))
(defn const-val [(tl (ptr Tl)) (v u32)] (-> i64) (.imm (cir/val (.f tl) v)))

(defn tl-alloc [(tl (ptr Tl)) (e (ptr Expr)) (storage i64) (t Type) (init (ptr Expr)) (symbol (Option (slice u8)))] (-> TV)
  (let [(mut tp) t]
    (cond
      (and (or (= storage 0) (= storage 3)) (promotable? tl e))
        (let [ct (tl-cty (mut tp))
              var (cir/new-var! (.f tl) ct)]
          (open! tl)
          ; uninitialized reads are UB; the variable starts at zero
          (cir/def-var! (.f tl) var (cir/const! (.f tl) ct (: 0 u64) (: 0 u64)))
          (TV :kind 3 :v var :ty t))
      (or (= storage 0) (= storage 3))
        (tv-s (new-slot tl (mut tp)) (TPtr (box-ty tl t)))
      (= storage 2)
        (let [p (tl-runtime-call tl "_malloc" (iconst tl (tsize tl (mut tp))) (none32) cir/T-I64)]
          (tv-s p (TPtr (box-ty tl t))))
      :else
        (let [g (.g tl)
              sym (match symbol
                    (Some [name] (g-public-zero-global! g name (tsize tl (mut tp)) (talign tl (mut tp))))
                    (None [] (g-zero-global! g (tsize tl (mut tp)) (talign tl (mut tp)))))
              ms (al-at [MSym] (field (field g obj) syms) sym)]
          (when (!= (primitive/cast i64 init) 0)
            (g-static-write! g (mut tp) init (.sect ms) (.off ms))
            0)
          (tv-s (sym-val tl sym) (TPtr (box-ty tl t)))))))

;;; A call to a one-argument runtime function returning type `rty`.
(defn tl-rt-call1 [(tl (ptr Tl)) (name (slice u8)) (x u32) (rty i64)] (-> u32)
  (tl-runtime-call tl name x (none32) rty))

;;; A call to a C runtime function of one or two pointer/integer arguments.
(defn tl-runtime-call [(tl (ptr Tl)) (name (slice u8)) (a0 u32) (a1 u32) (rty i64)] (-> u32)
  (let [sym (tl-sym tl (g-runtime-sym! (.g tl) name))
        _ (clear! (mut (.rt-args tl)))
        _ (clear! (mut (.rt-flags tl)))
        _ (clear! (mut (.rt-rts tl)))]
    (push! (mut (.rt-args tl)) a0)
    (push! (mut (.rt-flags tl)) (: 0 u32))
    (when (!= a1 (none32)) (push! (mut (.rt-args tl)) a1) (push! (mut (.rt-flags tl)) (: 0 u32)))
    (when (!= rty cir/T-VOID) (push! (mut (.rt-rts tl)) (primitive/cast u8 rty)))
    (open! tl)
    (cir/call! (.f tl) sym (none32) (cast (ptr (ArrayList u32)) (mut (.rt-args tl))) (cast (ptr (ArrayList u32)) (mut (.rt-flags tl)))
               (cast (ptr (ArrayList u8)) (mut (.rt-rts tl))) false)))

; ---- arithmetic ----

(defn fp-type? [(t (ptr Type))] (-> bool) (match (load t) (TFloat [_] true) (_ false)))

(defn tl-bin [(tl (ptr Tl)) (op i64) (l TV) (r TV)] (-> TV)
  (let [(mut t) (.ty l)
        a (scalar tl l)
        b (coerce-scalar tl (scalar tl r) (.ty r) (.ty l))]
    (if (fp-type? (mut t))
        (let [ct (tl-cty (mut t))]
          (if (= op 4)
              ; frem: libm fmod(f)
              (let [sym (tl-sym tl (g-runtime-sym! (.g tl) (if (= ct cir/T-F32) "_fmodf" "_fmod")))
                    (mut args) (ArrayList::new [u32] (.a tl))
                    (mut flags) (ArrayList::new [u32] (.a tl))
                    (mut rts) (ArrayList::new [u8] (.a tl))]
                (push! (mut args) a) (push! (mut args) b)
                (push! (mut flags) (: 0 u32)) (push! (mut flags) (: 0 u32))
                (push! (mut rts) (primitive/cast u8 ct))
                (open! tl)
                (tv-s (cir/call! (.f tl) sym (none32) (cast (ptr (ArrayList u32)) (mut args)) (cast (ptr (ArrayList u32)) (mut flags))
                                 (cast (ptr (ArrayList u8)) (mut rts)) false)
                      (.ty l)))
              (tv-s (op2 tl (case op 0 cir/OP-FADD 1 cir/OP-FSUB 2 cir/OP-FMUL cir/OP-FDIV) ct a b 0 0) (.ty l))))
        (let [signed (int-signed? (mut t))
              bits (int-bits (mut t))
              ct (if (wide? (mut t)) cir/T-I128 cir/T-I64)]
          (cond
            (and (>= op 15) (= ct cir/T-I128)) (tv-s (overflow128 tl op a b bits signed) (TBool))
            (>= op 15)
              (tv-s (op2 tl (case op 15 cir/OP-ADDO 16 cir/OP-SUBO cir/OP-MULO) cir/T-I64 a b bits (if signed 1 0)) (TBool))
            (and (= op 14) (= ct cir/T-I128)) (tv-s (canon128 tl (mulhi128 tl a b signed) bits signed) (.ty l))
            (= op 14) (tv-s (mulhi tl a b bits signed (mut t)) (.ty l))
            (and (= ct cir/T-I128) (or (= op 12) (= op 13))) (tv-s (canon128 tl (rot128 tl a b (= op 12) bits) bits signed) (.ty l))
            :else
              (let [cop (case op
                          0 cir/OP-ADD 1 cir/OP-SUB 2 cir/OP-MUL
                          3 (if signed cir/OP-SDIV cir/OP-UDIV)
                          4 (if signed cir/OP-SREM cir/OP-UREM)
                          5 cir/OP-UDIV 6 cir/OP-UREM
                          7 cir/OP-AND 8 cir/OP-OR 9 cir/OP-XOR
                          10 cir/OP-SHL
                          11 (if signed cir/OP-ASHR cir/OP-LSHR)
                          12 cir/OP-ROTL
                          cir/OP-ROTR)
                    bv (if (and (= ct cir/T-I128) (or (= op 10) (= op 11) (= op 12) (= op 13)))
                           b
                           b)
                    v (op2 tl cop ct a bv (if (or (= op 12) (= op 13)) bits 0) 0)]
                (when (and (= ct cir/T-I128) (or (= cop cir/OP-SDIV) (= cop cir/OP-UDIV) (= cop cir/OP-SREM) (= cop cir/OP-UREM)))
                  (set! (.has-calls (.f tl)) true))
                (tv-s (canon tl v (mut t)) (.ty l))))))))

;; Whether a 128-bit-container add/sub/mul of width `bits` overflows.
(defn overflow128 [(tl (ptr Tl)) (op i64) (a u32) (b u32) (bits i64) (signed bool)] (-> u32)
  (let [zero (cir/const! (.f tl) cir/T-I128 (: 0 u64) (: 0 u64))
        r (op2 tl (case op 15 cir/OP-ADD 16 cir/OP-SUB cir/OP-MUL) cir/T-I128 a b 0 0)
        wide (cond
               (= op 15)
                 (if signed
                     (op2 tl cir/OP-ICMP cir/T-I64
                          (op2 tl cir/OP-AND cir/T-I128 (op2 tl cir/OP-XOR cir/T-I128 a r 0 0) (op2 tl cir/OP-XOR cir/T-I128 b r 0 0) 0 0)
                          zero cir/P-SLT 0)
                     (op2 tl cir/OP-ICMP cir/T-I64 r a cir/P-ULT 0))
               (= op 16)
                 (if signed
                     (op2 tl cir/OP-ICMP cir/T-I64
                          (op2 tl cir/OP-AND cir/T-I128 (op2 tl cir/OP-XOR cir/T-I128 a b 0 0) (op2 tl cir/OP-XOR cir/T-I128 a r 0 0) 0 0)
                          zero cir/P-SLT 0)
                     (op2 tl cir/OP-ICMP cir/T-I64 a b cir/P-ULT 0))
               :else
                 (let [hi (mulhi128 tl a b signed)
                       want (if signed (op2 tl cir/OP-ASHR cir/T-I128 r (iconst tl 127) 0 0) zero)]
                   (op2 tl cir/OP-ICMP cir/T-I64 hi want cir/P-NE 0)))]
    (if (>= bits 128)
        wide
        (op2 tl cir/OP-OR cir/T-I64 wide (op2 tl cir/OP-ICMP cir/T-I64 (canon128 tl r bits signed) r cir/P-NE 0) 0 0))))

;; Rotate a 128-bit-container integer of `bits` (≤ 128) by n mod bits.
(defn rot128 [(tl (ptr Tl)) (x0 u32) (n0 u32) (left bool) (bits i64)] (-> u32)
  (let [w (iconst tl bits)
        n64 (op1 tl cir/OP-LO cir/T-I64 n0 0 0)
        ; n mod bits on the low word (bits is a positive width)
        q (op2 tl cir/OP-UDIV cir/T-I64 n64 w 0 0)
        n (op2 tl cir/OP-SUB cir/T-I64 n64 (op2 tl cir/OP-MUL cir/T-I64 q w 0 0) 0 0)
        ; the value zero-extended to its width
        x (if (< bits 128)
              (let [sh (iconst tl (- 128 bits))]
                (op2 tl cir/OP-LSHR cir/T-I128 (op2 tl cir/OP-SHL cir/T-I128 x0 sh 0 0) sh 0 0))
              x0)
        back (op2 tl cir/OP-SUB cir/T-I64 w n 0 0)
        a (op2 tl (if left cir/OP-SHL cir/OP-LSHR) cir/T-I128 x (op1 tl cir/OP-ZEXT cir/T-I128 n 64 0) 0 0)
        b (op2 tl (if left cir/OP-LSHR cir/OP-SHL) cir/T-I128 x (op1 tl cir/OP-ZEXT cir/T-I128 back 64 0) 0 0)
        r (op2 tl cir/OP-OR cir/T-I128 a b 0 0)
        z (op2 tl cir/OP-ICMP cir/T-I64 n (iconst tl 0) cir/P-EQ 0)]
    (op3 tl cir/OP-SELECT cir/T-I128 z x r 0 0)))

;; The high 128 bits of a 128x128 product, from 64-bit partial products; the
;; signed form subtracts the operands' sign corrections.
(defn mulhi128 [(tl (ptr Tl)) (a u32) (b u32) (signed bool)] (-> u32)
  (let [a0 (op1 tl cir/OP-LO cir/T-I64 a 0 0)
        a1 (op1 tl cir/OP-HI cir/T-I64 a 0 0)
        b0 (op1 tl cir/OP-LO cir/T-I64 b 0 0)
        b1 (op1 tl cir/OP-HI cir/T-I64 b 0 0)
        p00h (op2 tl cir/OP-UMULH cir/T-I64 a0 b0 0 0)
        p01l (op2 tl cir/OP-MUL cir/T-I64 a0 b1 0 0)
        p01h (op2 tl cir/OP-UMULH cir/T-I64 a0 b1 0 0)
        p10l (op2 tl cir/OP-MUL cir/T-I64 a1 b0 0 0)
        p10h (op2 tl cir/OP-UMULH cir/T-I64 a1 b0 0 0)
        p11l (op2 tl cir/OP-MUL cir/T-I64 a1 b1 0 0)
        p11h (op2 tl cir/OP-UMULH cir/T-I64 a1 b1 0 0)
        mid (op2 tl cir/OP-ADD cir/T-I128
                 (op2 tl cir/OP-ADD cir/T-I128 (op1 tl cir/OP-ZEXT cir/T-I128 p00h 64 0) (op1 tl cir/OP-ZEXT cir/T-I128 p01l 64 0) 0 0)
                 (op1 tl cir/OP-ZEXT cir/T-I128 p10l 64 0) 0 0)
        carry (op2 tl cir/OP-LSHR cir/T-I128 mid (iconst tl 64) 0 0)
        p11 (op2 tl cir/OP-PAIR cir/T-I128 p11l p11h 0 0)
        hi (op2 tl cir/OP-ADD cir/T-I128
                (op2 tl cir/OP-ADD cir/T-I128 p11 (op1 tl cir/OP-ZEXT cir/T-I128 p01h 64 0) 0 0)
                (op2 tl cir/OP-ADD cir/T-I128 (op1 tl cir/OP-ZEXT cir/T-I128 p10h 64 0) carry 0 0) 0 0)]
    (if (not signed)
        hi
        (let [zero (cir/const! (.f tl) cir/T-I128 (: 0 u64) (: 0 u64))
              an (op2 tl cir/OP-ICMP cir/T-I64 a1 (iconst tl 0) cir/P-SLT 0)
              bn (op2 tl cir/OP-ICMP cir/T-I64 b1 (iconst tl 0) cir/P-SLT 0)
              ca (op3 tl cir/OP-SELECT cir/T-I128 an b zero 0 0)
              cb (op3 tl cir/OP-SELECT cir/T-I128 bn a zero 0 0)]
          (op2 tl cir/OP-SUB cir/T-I128 (op2 tl cir/OP-SUB cir/T-I128 hi ca 0 0) cb 0 0)))))

;; The high bits of the full product: for 64 bits smulh/umulh, else the
;; product shifted right by the width.
(defn mulhi [(tl (ptr Tl)) (a u32) (b u32) (bits i64) (signed bool) (t (ptr Type))] (-> u32)
  (if (= bits 64)
      (op2 tl (if signed cir/OP-SMULH cir/OP-UMULH) cir/T-I64 a b 0 0)
      (let [lo (op2 tl cir/OP-MUL cir/T-I64 a b 0 0)
            hi (op2 tl (if signed cir/OP-SMULH cir/OP-UMULH) cir/T-I64 a b 0 0)
            l2 (op2 tl cir/OP-LSHR cir/T-I64 lo (iconst tl bits) 0 0)
            h2 (op2 tl cir/OP-SHL cir/T-I64 hi (iconst tl (- 64 bits)) 0 0)]
        (canon tl (op2 tl cir/OP-OR cir/T-I64 l2 h2 0 0) t))))

(defn icmp-pred [(op i64) (signed bool)] (-> i64)
  (case op
    0 (if signed cir/P-SLT cir/P-ULT)
    1 (if signed cir/P-SLE cir/P-ULE)
    2 (if signed cir/P-SGT cir/P-UGT)
    3 (if signed cir/P-SGE cir/P-UGE)
    4 cir/P-EQ
    cir/P-NE))

(defn tl-cmp [(tl (ptr Tl)) (op i64) (l TV) (r TV)] (-> TV)
  (let [(mut t) (.ty l)
        a (scalar tl l)
        b (coerce-scalar tl (scalar tl r) (.ty r) (.ty l))]
    (if (fp-type? (mut t))
        (tv-s (op2 tl cir/OP-FCMP cir/T-I64 a b
                   (case op 0 cir/F-OLT 1 cir/F-OLE 2 cir/F-OGT 3 cir/F-OGE 4 cir/F-OEQ cir/F-ONE) 0)
              (TBool))
        (tv-s (op2 tl cir/OP-ICMP cir/T-I64 a b (icmp-pred op (int-signed? (mut t))) 0) (TBool)))))

(defn tl-int-unary [(tl (ptr Tl)) (op i64) (tv TV)] (-> TV)
  (let [(mut t) (.ty tv)
        v (scalar tl tv)
        bits (int-bits (mut t))
        ct (if (wide? (mut t)) cir/T-I128 cir/T-I64)]
    (if (= ct cir/T-I128)
        (tv-s (int-unary128 tl op v (mut t)) (.ty tv))
        (tv-s (canon tl (case op
                          0 (op1 tl cir/OP-NOT ct v 0 0)
                          1 (op1 tl cir/OP-CLZ ct v bits 0)
                          2 (op1 tl cir/OP-CTZ ct v bits 0)
                          3 (op1 tl cir/OP-POPCNT ct v bits 0)
                          (op1 tl cir/OP-BSWAP ct v bits 0))
                     (mut t))
              (.ty tv)))))

;; 128-bit not/clz/ctz/popcount/bswap through the two halves.
(defn int-unary128 [(tl (ptr Tl)) (op i64) (v u32) (t (ptr Type))] (-> u32)
  (if (= op 0)
      (op1 tl cir/OP-NOT cir/T-I128 v 0 0)
      (let [lo (op1 tl cir/OP-LO cir/T-I64 v 0 0)
            hi (op1 tl cir/OP-HI cir/T-I64 v 0 0)]
        (cond
          (= op 1) ; clz = hi != 0 ? clz(hi) : 64 + clz(lo)
            (let [ch (op1 tl cir/OP-CLZ cir/T-I64 hi 64 0)
                  cl (op2 tl cir/OP-ADD cir/T-I64 (op1 tl cir/OP-CLZ cir/T-I64 lo 64 0) (iconst tl 64) 0 0)
                  z (op2 tl cir/OP-ICMP cir/T-I64 hi (iconst tl 0) cir/P-EQ 0)]
              (op1 tl cir/OP-ZEXT cir/T-I128 (op3 tl cir/OP-SELECT cir/T-I64 z cl ch 0 0) 64 0))
          (= op 2)
            (let [cl (op1 tl cir/OP-CTZ cir/T-I64 lo 64 0)
                  ch (op2 tl cir/OP-ADD cir/T-I64 (op1 tl cir/OP-CTZ cir/T-I64 hi 64 0) (iconst tl 64) 0 0)
                  z (op2 tl cir/OP-ICMP cir/T-I64 lo (iconst tl 0) cir/P-EQ 0)]
              (op1 tl cir/OP-ZEXT cir/T-I128 (op3 tl cir/OP-SELECT cir/T-I64 z ch cl 0 0) 64 0))
          (= op 3)
            (op1 tl cir/OP-ZEXT cir/T-I128
                 (op2 tl cir/OP-ADD cir/T-I64 (op1 tl cir/OP-POPCNT cir/T-I64 lo 64 0) (op1 tl cir/OP-POPCNT cir/T-I64 hi 64 0) 0 0)
                 64 0)
          :else
            (op2 tl cir/OP-PAIR cir/T-I128 (op1 tl cir/OP-BSWAP cir/T-I64 hi 64 0) (op1 tl cir/OP-BSWAP cir/T-I64 lo 64 0) 0 0)))))

(defn tl-cast [(tl (ptr Tl)) (t Type) (tv TV)] (-> TV)
  (let [(mut st) (.ty tv)
        (mut dt) t
        v (scalar tl tv)
        sc (tl-cty (mut st))
        dc (tl-cty (mut dt))]
    (match t
      (TInt [dbits dsigned]
            (cond
              (fp-type? (mut st))
                (if (= dc cir/T-I128)
                    (tv-s (canon128 tl (tl-rt-call1 tl (sconcat (.a tl)
                                                              (if dsigned "___fix" "___fixuns")
                                                              (if (= sc cir/T-F32) "sfti" "dfti"))
                                                    v cir/T-I128)
                                    dbits dsigned)
                          t)
                    (let [w (if (<= dbits 32) 32 64)
                          r (op1 tl (if dsigned cir/OP-FPTOSI cir/OP-FPTOUI) cir/T-I64 v w 0)]
                      (tv-s (canon tl r (mut dt)) t)))
              (= dc cir/T-I128)
                (if (= sc cir/T-I128)
                    (tv-s (canon128 tl v dbits dsigned) t)
                    (tv-s (canon128 tl (op1 tl (if (int-signed? (mut st)) cir/OP-SEXT cir/OP-ZEXT) cir/T-I128 v 64 0) dbits dsigned) t))
              (= sc cir/T-I128)
                (tv-s (canon tl (op1 tl cir/OP-LO cir/T-I64 v 0 0) (mut dt)) t)
              :else (tv-s (canon tl v (mut dt)) t)))
      (TFloat [dbits]
              (let [dct (if (= dbits 32) cir/T-F32 cir/T-F64)]
                (cond
                  (fp-type? (mut st))
                    (tv-s (cond (= sc dct) v
                                (= dct cir/T-F64) (op1 tl cir/OP-FPEXT dct v 0 0)
                                :else (op1 tl cir/OP-FPTRUNC dct v 0 0))
                          t)
                  (= sc cir/T-I128)
                    (tv-s (tl-rt-call1 tl (sconcat (.a tl)
                                                 (if (int-signed? (mut st)) "___floatti" "___floatunti")
                                                 (if (= dct cir/T-F32) "sf" "df"))
                                       v dct)
                          t)
                  :else (tv-s (op1 tl (if (int-signed? (mut st)) cir/OP-SITOFP cir/OP-UITOFP) dct v 0 0) t))))
      (TBool [] (tv-s (op2 tl cir/OP-ICMP cir/T-I64 v (iconst tl 0) cir/P-NE 0) t))
      (_ (tv-s (if (= sc cir/T-I128) (op1 tl cir/OP-LO cir/T-I64 v 0 0) v) t)))))

;; Canonicalize an I128 to `bits` (no-op at 128).
(defn canon128 [(tl (ptr Tl)) (v u32) (bits i64) (signed bool)] (-> u32)
  (if (>= bits 128)
      v
      (let [sh (iconst tl (- 128 bits))
            l (op2 tl cir/OP-SHL cir/T-I128 v sh 0 0)]
        (op2 tl (if signed cir/OP-ASHR cir/OP-LSHR) cir/T-I128 l sh 0 0))))

; ---- control flow ----

;; A merge variable for branch results: scalars by value, places by address.
(defstruct Merge [(var u32) (kind i64) (ty Type) (has bool)])

(defn merge-new [] (-> Merge) (Merge :var (none32) :kind 2 :ty (TVoid) :has false))

(defn merge-add! [(tl (ptr Tl)) (m (mut Merge)) (tv TV)] (-> void)
  (when (!= (.kind tv) 2)
    (when (not (.has m))
      (set! (.has m) true)
      (set! (.kind m) (if (= (.kind tv) 3) 0 (.kind tv)))
      (set! (.ty m) (.ty tv))
      (let [(mut t) (.ty tv)]
        (set! (.var m) (cir/new-var! (.f tl) (if (= (.kind m) 1) cir/T-I64 (tl-cty (mut t)))))))
    (open! tl)
    (if (= (.kind m) 1)
        (do (set! (.frame-escapes (.f tl)) true)
            (cir/def-var! (.f tl) (.var m) (place tl tv)))
        (cir/def-var! (.f tl) (.var m) (coerce-scalar tl (scalar tl tv) (.ty tv) (.ty m)))))
  0)

(defn merge-result [(tl (ptr Tl)) (m Merge)] (-> TV)
  (if (not (.has m))
      (tv-s (iconst tl 0) (i64t))
      (TV :kind (.kind m) :v (cir/use-var! (.f tl) (.var m)) :ty (.ty m))))

(defn tl-if [(tl (ptr Tl)) (cnd (ptr Expr)) (thn (ptr Expr)) (els (ptr Expr)) (tail bool)] (-> TV)
  (let [c (scalar tl (tl-expr tl cnd))]
    (if (.terminated tl)
        (tv-none)
        (let [fp (.f tl)
              tb (cir/new-block! fp)
              eb (cir/new-block! fp)
              mb (cir/new-block! fp)
              (mut m) (merge-new)]
          (open! tl)
          (cir/condbr! fp c tb eb)
          (cir/seal! fp tb)
          (cir/seal! fp eb)
          (cir/set-block! fp tb)
          (set! (.tailok tl) tail)
          (let [tv1 (tl-expr tl thn)
                t1 (.terminated tl)]
            (when (not t1)
              (merge-add! tl (mut m) tv1)
              (open! tl)
              (cir/br! fp mb))
            (set! (.terminated tl) false)
            (cir/set-block! fp eb)
            (set! (.tailok tl) tail)
            (let [tv2 (tl-expr tl els)
                  t2 (.terminated tl)]
              (when (not t2)
                (merge-add! tl (mut m) tv2)
                (open! tl)
                (cir/br! fp mb))
              (cir/seal! fp mb)
              (cir/set-block! fp mb)
              (set! (.terminated tl) (and t1 t2))
              (if (.terminated tl) (tv-none) (merge-result tl m))))))))

(defn tl-loop-index [(tl (ptr Tl)) (label (Option (slice u8)))] (-> i64)
  (let [n (len (.loops tl))]
    (match label
      (None [] (if (= n 0) (do (tl-fail "break/continue outside a loop") 0) (- n 1)))
      (Some [want]
            (let [(mut i) (- n 1)]
              (block :found
                (while (>= i 0)
                  (match (.label (al-at [TLoop] (field tl loops) i))
                    (Some [have] (when (= have want) (return-from :found i)))
                    (None [] 0))
                  (set! i (- i 1)))
                (tl-fail (sconcat (.a tl) "no such loop label: " want))))))))

(defn tl-loop [(tl (ptr Tl)) (label (Option (slice u8))) (body (ptr (ArrayList Expr)))] (-> TV)
  (let [fp (.f tl)
        head (cir/new-block! fp)
        exit (cir/new-block! fp)]
    (open! tl)
    (cir/br! fp head)
    (cir/set-block! fp head)
    (push! (mut (.loops tl)) (TLoop :label label :head head :exit exit :resvar (none32) :reskind 2 :resty (TVoid) :has-res false))
    (tl-stmts tl body)
    (when (not (.terminated tl))
      (open! tl)
      (cir/br! fp head))
    (cir/seal! fp head)
    (let [lp (get (.loops tl) (- (len (.loops tl)) 1))]
      (pop! (mut (.loops tl)))
      (cir/seal! fp exit)
      (cir/set-block! fp exit)
      (if (.has-res lp)
          (do (set! (.terminated tl) false)
              (if (= (.resvar lp) (none32))
                  (tv-s (iconst tl 0) (i64t))
                  (TV :kind (.reskind lp) :v (cir/use-var! fp (.resvar lp)) :ty (.resty lp))))
          (do (set! (.terminated tl) true)
              (tv-none))))))

(defn tl-break [(tl (ptr Tl)) (label (Option (slice u8))) (value (Option (ptr Expr)))] (-> TV)
  (if (.terminated tl)
      (tv-none)
      (let [tv (match value
                 (Some [ve] (tl-expr tl ve))
                 (None [] (tv-s (iconst tl 0) (i64t))))]
        (if (.terminated tl)
            (tv-none)
            (let [li (tl-loop-index tl label)
                  lp (al-at [TLoop] (field tl loops) li)]
              (set! (.has-res lp) true)
              (when (!= (.kind tv) 2)
                (when (= (.resvar lp) (none32))
                  (let [k (if (= (.kind tv) 3) 0 (.kind tv))
                        (mut t) (.ty tv)]
                    (set! (.reskind lp) k)
                    (set! (.resty lp) (.ty tv))
                    (set! (.resvar lp) (cir/new-var! (.f tl) (if (= k 1) cir/T-I64 (tl-cty (mut t)))))))
                (open! tl)
                (if (= (.reskind lp) 1)
                    (do (set! (.frame-escapes (.f tl)) true)
                        (cir/def-var! (.f tl) (.resvar lp) (place tl tv)))
                    (cir/def-var! (.f tl) (.resvar lp) (coerce-scalar tl (scalar tl tv) (.ty tv) (.resty lp)))))
              (open! tl)
              (cir/br! (.f tl) (.exit lp))
              (set! (.terminated tl) true)
              (tv-none))))))

; ---- sums ----

(defn tl-construct [(tl (ptr Tl)) (sum (slice u8)) (variant (slice u8)) (args (ptr (ArrayList Expr)))] (-> TV)
  (let [g (.g tl)
        su (g-sum-idx g sum)]
    (when (< su 0) (tl-fail (sconcat (.a tl) "construct of unknown sum: " sum)))
    (let [vidx (g-variant-idx g su variant)
          (mut sumty) (TStruct sum)
          s (new-slot tl (mut sumty))
          vs (load (field (sum-at (field g layouts) su) variants))
          vfields (load (field (al-at [Variant] vs vidx) fields))]
      (store-n tl s 0 (iconst tl vidx) 4)
      (for i (range 0 (len (load args)))
        (let [tv (tl-expr tl (elem args i))
              off (g-natural-off g vfields i)]
          (store-tv tl s (+ 8 off) tv)))
      (tv-p s (TStruct sum)))))

(defn tl-match [(tl (ptr Tl)) (scrut (ptr Expr)) (arms (ptr (ArrayList Arm)))] (-> TV)
  (let [g (.g tl)
        a (.a tl)
        stv (tl-expr tl scrut)
        (mut t) (.ty stv)
        borrowed (match t (TPtr [inner] (match (load inner) (TStruct [_] true) (_ false))) (_ false))
        sumname (match t
                  (TStruct [nm] nm)
                  (TPtr [inner] (match (load inner) (TStruct [nm] nm) (_ "")))
                  (_ ""))
        su (g-sum-idx g sumname)]
    (when (< su 0) (tl-fail (sconcat a "match on non-sum: " sumname)))
    (let [base (if borrowed (scalar tl stv) (place tl stv))
          vs (load (field (sum-at (field g layouts) su) variants))
          narms (len (load arms))
          ncases (if (arms-have-wildcard arms) (- narms 1) narms)
          fp (.f tl)
          tag (load-n tl base 0 4)
          (mut blocks) (ArrayList::new [u32] a)
          (mut vals) (ArrayList::new [u64] a)
          (mut tgts) (ArrayList::new [u32] a)
          mb (cir/new-block! fp)
          (mut m) (merge-new)
          (mut anylive) false]
      (for i (range 0 narms) (push! (mut blocks) (cir/new-block! fp)))
      (for i (range 0 ncases)
        (let [arm (al-at [Arm] arms i)
              vidx (g-variant-idx g su (.variant arm))
              (mut dup) false]
          ; the first arm for a variant wins
          (for j (range 0 (len vals)) (when (= (get vals j) (primitive/cast u64 vidx)) (set! dup true)))
          (unless dup
            (push! (mut vals) (primitive/cast u64 vidx))
            (push! (mut tgts) (get blocks i)))))
      (let [default (if (= ncases narms) (cir/new-block! fp) (get blocks ncases))]
        (open! tl)
        (cir/switch! fp tag default (cast (ptr (ArrayList u64)) (mut vals)) (cast (ptr (ArrayList u32)) (mut tgts)))
        (for i (range 0 narms) (cir/seal! fp (get blocks i)))
        (when (= ncases narms)
          (cir/seal! fp default)
          (cir/set-block! fp default)
          (cir/unreachable! fp)))
      (for i (range 0 narms)
        (let [arm (al-at [Arm] arms i)
              vidx (if (>= i ncases) 0 (g-variant-idx g su (.variant arm)))
              vfields (load (field (al-at [Variant] vs vidx) fields))
              mark (scope-mark tl)]
          (cir/set-block! fp (get blocks i))
          (set! (.terminated tl) false)
          (let [binds (load (field arm binds))]
            (for j (range 0 (len (load binds)))
              (let [fty (.ty (al-at [Field] vfields j))
                    foff (g-natural-off g vfields j)
                    bname (get (load binds) j)]
                (if (and borrowed (starts-with bname "$match.ref."))
                    (bind! tl bname (tv-s (addi tl base (+ 8 foff)) (TPtr (box-ty tl fty))))
                    (bind! tl bname (read-at tl base (+ 8 foff) fty))))))
          (let [btv (tl-expr tl (field arm body))]
            (scope-pop! tl mark)
            (unless (.terminated tl)
              (merge-add! tl (mut m) btv)
              (set! anylive true)
              (open! tl)
              (cir/br! fp mb)))))
      (cir/seal! fp mb)
      (cir/set-block! fp mb)
      (if anylive
          (do (set! (.terminated tl) false) (merge-result tl m))
          (do (set! (.terminated tl) true) (tv-none))))))

; ---- bit structs ----

(defn tl-bitget [(tl (ptr Tl)) (p (ptr Expr)) (fname (slice u8))] (-> TV)
  (let [ptv (tl-expr tl p)
        pt (pointee tl ptv)]
    (match pt
      (TStruct [nm]
               (let [(mut low) (zeroed i64) (mut width) (zeroed i64) (mut signed) (zeroed bool) (mut back) (zeroed i64)]
                 (g-bits-info (.g tl) nm fname (mut low) (mut width) (mut signed) (mut back))
                 (let [wb (bits-window! (mut low) (mut back))
                       addr (addi tl (scalar tl ptv) wb)
                       w (load-bytes tl addr 0 (/ back 8))
                       sh (if (> low 0) (op2 tl cir/OP-LSHR cir/T-I64 w (iconst tl low) 0 0) w)
                       v (if (< width 64) (op1 tl (if signed cir/OP-SEXT cir/OP-ZEXT) cir/T-I64 sh width 0) sh)]
                   (tv-s v (if (= width 1) (TBool) (TInt width signed))))))
      (_ (tl-fail "bit-get through non-struct pointer")))))

(defn tl-bitset [(tl (ptr Tl)) (p (ptr Expr)) (fname (slice u8)) (val (ptr Expr))] (-> TV)
  (let [ptv (tl-expr tl p)
        vtv (tl-expr tl val)
        pt (pointee tl ptv)]
    (match pt
      (TStruct [nm]
               (let [(mut low) (zeroed i64) (mut width) (zeroed i64) (mut signed) (zeroed bool) (mut back) (zeroed i64)]
                 (g-bits-info (.g tl) nm fname (mut low) (mut width) (mut signed) (mut back))
                 (let [wb (bits-window! (mut low) (mut back))
                       addr (addi tl (scalar tl ptv) wb)
                       nbytes (/ back 8)
                       w (load-bytes tl addr 0 nbytes)
                       fieldmask (if (>= width 64) -1 (- (<< 1 width) 1))
                       cleared (op2 tl cir/OP-AND cir/T-I64 w (iconst tl (^ (<< fieldmask low) -1)) 0 0)
                       vm (op2 tl cir/OP-AND cir/T-I64 (scalar tl vtv) (iconst tl fieldmask) 0 0)
                       vs (if (> low 0) (op2 tl cir/OP-SHL cir/T-I64 vm (iconst tl low) 0 0) vm)
                       nw (op2 tl cir/OP-OR cir/T-I64 cleared vs 0 0)]
                   (store-bytes tl addr 0 nw nbytes)
                   vtv)))
      (_ (tl-fail "bit-set through non-struct pointer")))))

; ---- intrinsics ----

(defn tl-intrinsic [(tl (ptr Tl)) (op Intrinsic) (result Type) (args (ptr (ArrayList Expr)))] (-> TV)
  (match op
    (IStackBytes []
                 (let [n (scalar tl (tl-expr tl (elem args 0)))]
                   (set! (.has-dynamic-alloca (.f tl)) true)
                   (tv-s (op1 tl cir/OP-DYNALLOCA cir/T-I64 n 16 0) result)))
    (IVolatileLoad [] (tl-load tl (tl-expr tl (elem args 0))))
    (IAliasLoad [] (tl-load tl (tl-expr tl (elem args 0))))
    (IVolatileStore [] (tl-store tl (tl-expr tl (elem args 0)) (tl-expr tl (elem args 1))))
    (IAliasStore [] (tl-store tl (tl-expr tl (elem args 0)) (tl-expr tl (elem args 1))))
    (IFence [] (do (open! tl) (cir/op0! (.f tl) cir/OP-FENCE cir/T-VOID 0 0) (tv-s (iconst tl 0) (i64t))))
    (ILinkerAddress [symbol]
                    (let [sym (mobj-add-sym! (mut (.obj (.g tl))) (g-mangle (.g tl) symbol) 0 0 true)]
                      (tv-s (sym-val tl sym) result)))
    (_ (tl-fail "codegen: machine-code outside a machine-code function (checker bug)"))))

; ---- trait objects ----

(defn tl-make-dyn [(tl (ptr Tl)) (ds (slice u8)) (_vt (slice u8)) (methods (ptr (ArrayList (slice u8)))) (inner (ptr Expr))] (-> TV)
  (let [g (.g tl)
        a (.a tl)
        buf (mobj-sect-buf (mut (.obj g)) (.datasec g))]
    (b-align! (mut buf) 8)
    (let [vtoff (len (load buf))
          nm (sconcat a "l_vtable." (i64->str a (.nglob g)))]
      (set! (.nglob g) (+ (.nglob g) 1))
      (for i (range 0 (len (load methods)))
        (let [mnm (get (load methods) i)
              msi (g-sig-idx g mnm)]
          (when (< msi 0) (tl-fail (sconcat a "make-dyn: unknown method " mnm)))
          (mobj-add-reloc! (mut (.obj g)) (.datasec g) (len (load buf))
                           (.symidx (al-at [GSig] (field g sigs) msi)) (reloc-unsigned) false 3)
          (b-u64! (mut buf) 0)))
      (let [vtsym (mobj-add-sym! (mut (.obj g)) nm (.datasec g) vtoff false)
            iv (scalar tl (tl-expr tl inner))
            s (new-slot-bytes tl 16 8)]
        (store-n tl s 0 iv 8)
        (store-n tl s 8 (sym-val tl vtsym) 8)
        (tv-p s (TStruct ds))))))

(defn tl-dyn-dispatch [(tl (ptr Tl)) (dc (ptr DynCall))] (-> TV)
  (let [a (.a tl)
        rtv (tl-expr tl (.recv dc))
        r (place tl rtv)
        data (load-n tl r 0 8)
        vt (load-n tl r 8 8)
        fnp (load-n tl vt (* (.method_index dc) 8) 8)
        (mut ptys) (ArrayList::new [Type] a)
        (mut tvs) (ArrayList::new [TV] a)]
    (push! (mut ptys) (TPtr (box-ty tl (TInt 8 true))))
    (for i (range 0 (len (load (.params dc))))
      (push! (mut ptys) (get (load (.params dc)) i)))
    (push! (mut tvs) (tv-s data (TPtr (box-ty tl (TInt 8 true)))))
    (for i (range 0 (len (load (.args dc))))
      (push! (mut tvs) (tl-expr tl (elem (.args dc) i))))
    (tl-emit-call tl (none32) fnp (box-al [Type] a (load ptys)) false (.ret dc) (box-al [TV] a (load tvs)) false)))

; ============================ calls ==========================================

(defn ret-void? [(t (ptr Type))] (-> bool) (match (load t) (TVoid [] true) (_ false)))

;;; CIR argument flags and values for one call argument per AAPCS64 (Apple).
(defn push-arg! [(tl (ptr Tl)) (args (mut (ArrayList u32))) (flags (mut (ArrayList u32))) (v u32) (fl u32)] (-> void)
  (push! (mut args) v)
  (push! (mut flags) fl))

(defn group-flags [(remaining i64)] (-> u32) (<< (u32-of remaining) (: 16 u32)))

;;; Lower one argument TV of type t to CIR arguments.
;;; The C size of a narrow integer argument (Apple packs stack arguments at
;;; it), and for a parameter (`incoming`) its signedness: one that arrives on
;;; the stack is loaded extended from that size.
(defn narrow-arg-flags [(tl (ptr Tl)) (t (ptr Type)) (incoming bool)] (-> u32)
  (match (load t)
    (TInt [bits sg]
          (if (< bits 64)
              (| (cir/af-size (tsize tl t))
                 (if (and incoming sg) (u32-of (| cir/AF-SEXT bits)) (: 0 u32)))
              (: 0 u32)))
    (TBool [] (cir/af-size 1))
    (_ (: 0 u32))))

(defn lower-arg! [(tl (ptr Tl)) (args (mut (ArrayList u32))) (flags (mut (ArrayList u32))) (tv TV) (variadic bool)] (-> void)
  (let [g (.g tl)
        (mut t) (.ty tv)
        info (tl-abi-info tl (mut t))
        cls (abi-cls info)
        vf (if variadic cir/AF-VARIADIC (: 0 u32))]
    (cond
      (= cls 6) 0
      (or (= cls 0) (= cls 1))
        (do (push-arg! tl (mut args) (mut flags) (scalar tl tv) (| vf (narrow-arg-flags tl (mut t) false))) 0)
      (wide? (mut t)) (do (push-arg! tl (mut args) (mut flags) (scalar tl tv) vf) 0)
      (= cls 2)
        (do (push-arg! tl (mut args) (mut flags) (eb-load tl (place tl tv) info 0 0 (tsize tl (mut t))) vf) 0)
      (= cls 3)
        (let [p (place tl tv)
              sz (tsize tl (mut t))
              lo (eb-load tl p info 0 0 8)
              hi (eb-load tl p info 1 8 (hi-bytes sz))]
          (push-arg! tl (mut args) (mut flags) lo (| vf (pair-flags info)))
          (push-arg! tl (mut args) (mut flags) hi vf)
          0)
      (.x64 tl)
        ; MEMORY: tpde copies the aggregate onto the stack
        (do (push-arg! tl (mut args) (mut flags) (place tl tv) (| vf (cir/af-byval (tsize tl (mut t))))) 0)
      (= cls 5)
        (let [p (place tl tv)
              hn (abi-hfa-n info)
              lb (/ (abi-hfa-bits info) 8)
              ft (if (= lb 4) (TFloat 32) (TFloat 64))]
          (for j (range 0 hn)
            (let [(mut ftt) ft]
              (push-arg! tl (mut args) (mut flags) (load-scalar tl p (* j lb) (mut ftt))
                         (| vf (if variadic (: 0 u32) (group-flags (- (- hn j) 1)))))))
          0)
      :else
        ; indirect: a private copy, passed by address
        (let [cp (new-slot tl (mut t))]
          (memcpy tl cp (place tl tv) (tsize tl (mut t)))
          (set! (.frame-escapes (.f tl)) true)
          (push-arg! tl (mut args) (mut flags) cp vf)
          0))))

;;; A by-value aggregate parameter given a pointer: pass what it points at.
(defn by-value-arg [(tl (ptr Tl)) (pt Type) (tv TV)] (-> TV)
  (let [(mut ptt) pt
        (mut at) (.ty tv)]
    (if (and (not (tl-scalar? (mut ptt)))
             (match at (TPtr [_] true) (TRef [_ _] true) (_ false)))
        (tv-p (scalar tl tv) pt)
        tv)))

;;; Emit a call: `sym` (a MObj symbol) or the pointer value `fnp`. Returns the
;;; result TV per the return class.
(defn tl-emit-call [(tl (ptr Tl)) (sym u32) (fnp u32) (params (ptr (ArrayList Type))) (variadic bool) (ret Type)
                    (tvs (ptr (ArrayList TV))) (tail bool)] (-> TV)
  (let [g (.g tl)
        a (.a tl)
        nargs (len (load tvs))
        nparams (len (load params))
        (mut rt) ret
        retvoid (ret-void? (mut rt))
        retinfo (if retvoid (mk-abi-scalar) (tl-abi-info tl (mut rt)))
        rcls (if retvoid -1 (abi-cls retinfo))
        _ (clear! (mut (.call-args tl)))
        _ (clear! (mut (.call-flags tl)))
        _ (clear! (mut (.call-rts tl)))
        sret-slot (if (= rcls 4) (new-slot tl (mut rt)) (none32))]
    (when (= rcls 4)
      (push-arg! tl (mut (.call-args tl)) (mut (.call-flags tl)) sret-slot cir/AF-SRET))
    (for i (range 0 nargs)
      (let [tv0 (get (load tvs) i)
            tv (if (< i nparams) (by-value-arg tl (get (load params) i) tv0) tv0)]
        (lower-arg! tl (mut (.call-args tl)) (mut (.call-flags tl)) tv (>= i nparams))))
    ; result types
    (cond
      (or retvoid (= rcls 4) (= rcls 6)) 0
      (or (= rcls 0) (= rcls 1)) (push! (mut (.call-rts tl)) (primitive/cast u8 (tl-cty (mut rt))))
      (wide? (mut rt)) (push! (mut (.call-rts tl)) (primitive/cast u8 cir/T-I128))
      (= rcls 2) (push! (mut (.call-rts tl)) (primitive/cast u8 (eb-cty retinfo 0 (tsize tl (mut rt)))))
      (= rcls 3) (do (push! (mut (.call-rts tl)) (primitive/cast u8 (eb-cty retinfo 0 8)))
                     (push! (mut (.call-rts tl)) (primitive/cast u8 (eb-cty retinfo 1 (hi-bytes (tsize tl (mut rt)))))))
      (= rcls 5) (for j (range 0 (abi-hfa-n retinfo))
                   (push! (mut (.call-rts tl)) (primitive/cast u8 (if (= (abi-hfa-bits retinfo) 32) cir/T-F32 cir/T-F64))))
      :else 0)
    (open! tl)
    (let [c (cir/call! (.f tl) (if (= sym (none32)) (none32) (tl-sym tl (i64-of sym))) fnp
                       (cast (ptr (ArrayList u32)) (mut (.call-args tl))) (cast (ptr (ArrayList u32)) (mut (.call-flags tl)))
                       (cast (ptr (ArrayList u8)) (mut (.call-rts tl))) tail)]
      (when tail (set! (.terminated tl) true))
      (cond
        tail (tv-none)
        retvoid (tv-s (iconst tl 0) (i64t))
        (= rcls 4) (tv-p sret-slot ret)
        (= rcls 6) (tv-p (new-slot-bytes tl 1 1) ret)
        (wide? (mut rt)) (tv-s c ret)
        (= rcls 0) (tv-s (canon tl c (mut rt)) ret)
        (= rcls 1) (tv-s c ret)
        :else
          (let [s (new-slot tl (mut rt))
                sz (tsize tl (mut rt))]
            (cond
              (= rcls 2) (eb-store tl s retinfo 0 0 c sz)
              (= rcls 3) (do (eb-store tl s retinfo 0 0 c 8)
                             (eb-store tl s retinfo 1 8 (cir/call-result (.f tl) c 1) (hi-bytes sz)))
              :else (let [lb (/ (abi-hfa-bits retinfo) 8)
                          ft (if (= lb 4) (TFloat 32) (TFloat 64))]
                      (for j (range 0 (abi-hfa-n retinfo))
                        (let [(mut ftt) ft]
                          (store-scalar tl s (* j lb) (cir/call-result (.f tl) c j) (mut ftt))))
                      0))
            (tv-p s ret))))))

;; Whether two signatures lower to the same CIR shape (the musttail rule).
(defn same-scalar-type? [(tl (ptr Tl)) (x (ptr Type)) (y (ptr Type))] (-> bool)
  (let [cx (tl-cty x) cy (tl-cty y)]
    (and (>= cx 0) (= cx cy)
         (match (load x)
           (TInt [bx _] (match (load y) (TInt [by _] (= bx by)) (_ false)))
           (TBool [] (match (load y) (TBool [] true) (_ false)))
           (_ true)))))

(defn tail-callable? [(tl (ptr Tl)) (sig (ptr GSig))] (-> bool)
  (let [fd (.fd tl)
        ps (load (field sig params))
        fps (load (field fd params))
        (mut ok) (and (not (.variadic sig)) (not (.shim sig)) (= (len (.inline_code sig)) 0)
                      (= (len (load ps)) (len (load fps))))]
    (when ok
      (let [(mut r1) (.ret sig) (mut r2) (.ret fd)
            v1 (ret-void? (mut r1)) v2 (ret-void? (mut r2))]
        (set! ok (or (and v1 v2) (and (not v1) (not v2) (same-scalar-type? tl (mut r1) (mut r2))))))
      (for i (range 0 (len (load ps)))
        (when ok
          (let [(mut p1) (get (load ps) i)
                (mut p2) (.ty (al-at [Param] fps i))]
            (set! ok (same-scalar-type? tl (mut p1) (mut p2)))))))
    ok))

;;; Whether a call to FUNC in tail position is emitted as a jump.
(defn tail-jump? [(tl (ptr Tl)) (func (slice u8))] (-> bool)
  (let [g (.g tl)
        si (g-sig-idx g func)]
    (if (< si 0)
        false
        (let [sig (al-at [GSig] (field g sigs) si)]
          (and (not (tl-leaf-inline? tl sig)) (tail-callable? tl sig))))))

(defn tl-call-named [(tl (ptr Tl)) (func (slice u8)) (args (ptr (ArrayList Expr))) (tail bool)] (-> TV)
  (let [g (.g tl)
        si (g-sig-idx g func)]
    (when (< si 0) (tl-fail (sconcat (.a tl) "call to unknown function: " func)))
    (let [sig (al-at [GSig] (field g sigs) si)
          (mut tvs) (ArrayList::new [TV] (.a tl))]
      (reserve! (mut tvs) (len (load args)))
      (block :args
        (for i (range 0 (len (load args)))
          (push! (mut tvs) (tl-expr tl (elem args i)))
          (when (.terminated tl) (return-from :args 0)))
        0)
      (cond
        (.terminated tl) (tv-none)
        (tl-leaf-inline? tl sig) (tl-leaf-inline tl sig (cast (ptr (ArrayList TV)) (mut tvs)))
        (.shim sig) (tl-shim-call tl sig (cast (ptr (ArrayList TV)) (mut tvs)))
        :else
          (let [t (and tail (tail-callable? tl sig))]
            (tl-emit-call tl (u32-of (.symidx sig)) (none32) (load (field sig params)) (.variadic sig) (.ret sig)
                          (cast (ptr (ArrayList TV)) (mut tvs)) t))))))

;;; A register named by a :shim convention.
(defn shim-reg [(tl (ptr Tl)) (r (slice u8))] (-> i64)
  (cond (>= (x86-gpr-num r) 0) (x86-gpr-num r)
        (or (= r "lr") (= r "x30")) 30
        (or (= r "fp") (= r "x29")) 29
        (and (> (len r) 1) (= (get r 0) #\x)) (str->i64 (subslice r 1 (len r)))
        :else (tl-fail (sconcat (.a tl) "tpde: unsupported :shim register " r))))

;;; The convention of a :shim function and its clobbered registers.
(defn shim-clobber-mask [(tl (ptr Tl)) (fd (ptr Func))] (-> u64)
  (let [g (.g tl)
        ci (g-conv-idx g (cc-identity (.cc fd)))
        (mut mask) (: 0 u64)]
    (when (>= ci 0)
      (let [cv (al-at [Convention] (load (field g convs)) ci)
            cl (load (field cv clobber))]
        (for j (range 0 (len (load cl)))
          (set! mask (| mask (<< (: 1 u64) (primitive/cast u64 (shim-reg tl (get (load cl) j)))))))))
    mask))

(defn tl-shim-call [(tl (ptr Tl)) (sig (ptr GSig)) (tvs (ptr (ArrayList TV)))] (-> TV)
  (let [a (.a tl)
        fd (load (field sig func))
        regs (load (field sig shimregs))
        (mut args) (ArrayList::new [u32] a)
        (mut rs) (ArrayList::new [u32] a)
        (mut rt) (.ret sig)
        void (ret-void? (mut rt))
        inline (> (len (.inline_code sig)) 0)]
    (for i (range 0 (len (load tvs)))
      (push! (mut args) (scalar tl (get (load tvs) i)))
      (push! (mut rs) (u32-of (get (load regs) i))))
    (open! tl)
    (let [v (cir/shimcall! (.f tl)
                           (if inline (none32) (tl-sym tl (.symidx sig)))
                           (cast (ptr (ArrayList u32)) (mut args))
                           (cast (ptr (ArrayList u32)) (mut rs))
                           (if void (: 255 u32) (u32-of (.shimret sig)))
                           (shim-clobber-mask tl fd)
                           (if inline (.inline_code sig) "")
                           (if void cir/T-VOID cir/T-I64))]
      (if void (tv-s (iconst tl 0) (i64t)) (tv-s (canon tl v (mut rt)) (.ret sig))))))

;;; The trampoline a :shim function with a Coil body is reached through: move
;;; the convention's registers into the C argument registers, call __impl, and
;;; move x0 into the convention's return register.
(defn tl-shim-trampoline! [(tl (ptr Tl)) (sig (ptr GSig)) (impl-tsym u32) (tsym u32)] (-> void)
  (if (.x64 tl) (tl-shim-trampoline-x64! tl sig impl-tsym tsym) (tl-shim-trampoline-a64! tl sig impl-tsym tsym)))

(defn rb [(x i64)] (-> u8) (primitive/cast u8 x))

;;; x86-64: push rbp (rsp is then 16-byte aligned), push the convention's
;;; registers and pop them into the System V argument registers (any
;;; permutation), call __impl, move rax into the return register.
(defn tl-shim-trampoline-x64! [(tl (ptr Tl)) (sig (ptr GSig)) (impl-tsym u32) (tsym u32)] (-> void)
  (let [ta (.ta tl)
        text (tasm/sect-buf ta tasm/SEC-TEXT)
        start (.len (load text))
        regs (load (field sig shimregs))
        nr (len (load regs))]
    (xenc/push! text (rb 5))
    (xenc/mov-rr! text true (rb 5) (rb 4))
    (for j (range 0 nr) (xenc/push! text (rb (get (load regs) j))))
    (for k (range 0 nr) (xenc/pop! text (xtpde/gp-arg-reg (u32-of (- (- nr 1) k)))))
    (tasm/reloc! ta tasm/SEC-TEXT (+ (.len (load text)) 1) impl-tsym tasm/R-PLT32 0)
    (xenc/call32! text 0)
    (when (!= (.shimret sig) 0)
      (xenc/mov-rr! text true (rb (.shimret sig)) (rb 0)))
    (xenc/pop! text (rb 5))
    (xenc/ret! text)
    (tasm/sym-def! ta tsym tasm/SEC-TEXT start (- (.len (load text)) start))))

(defn tl-shim-trampoline-a64! [(tl (ptr Tl)) (sig (ptr GSig)) (impl-tsym u32) (tsym u32)] (-> void)
  (let [ta (.ta tl)
        text (tasm/sect-buf ta tasm/SEC-TEXT)
        start (.len (load text))
        regs (load (field sig shimregs))
        nr (len (load regs))]
    (tbuf/emit32! text (enc/stp-x-pre (: 29 u32) (: 30 u32) (: 31 u32) -16))
    (tbuf/emit32! text (enc/mov-sp (: 29 u32) (: 31 u32)))
    (for j (range 0 nr)
      (tbuf/emit32! text (enc/stp-x-pre (u32-of (get (load regs) j)) (: 31 u32) (: 31 u32) -16)))
    (for k (range 0 nr)
      (tbuf/emit32! text (enc/ldp-x-post (u32-of (- (- nr 1) k)) (: 31 u32) (: 31 u32) 16)))
    (tasm/reloc! ta tasm/SEC-TEXT (.len (load text)) impl-tsym tasm/R-BRANCH26 0)
    (tbuf/emit32! text (enc/bl 0))
    (when (!= (.shimret sig) 0)
      (tbuf/emit32! text (enc/mov-reg true (u32-of (.shimret sig)) (: 0 u32))))
    (tbuf/emit32! text (enc/ldp-x-post (: 29 u32) (: 30 u32) (: 31 u32) 16))
    (tbuf/emit32! text (enc/ret))
    (tasm/sym-def! ta tsym tasm/SEC-TEXT start (- (.len (load text)) start))))

(defn tl-leaf-inline? [(tl (ptr Tl)) (sig (ptr GSig))] (-> bool)
  (let [fd (load (field sig func))]
    (if (or (= (primitive/cast i64 fd) 0)
            (match (.inline_policy sig) (Some [(Always)] false) (_ true))
            (>= (.inline-depth tl) 16)
            (= (.name fd) (.selfname tl)))
        false
        (let [ps (load (field fd params))
              (mut ok) (tl-scalar? (field fd ret))]
          (for i (range 0 (len (load ps)))
            (unless (tl-scalar? (field (elem ps i) ty)) (set! ok false)))
          (and ok (g-leaf-inline-body? fd))))))

(defn tl-leaf-inline [(tl (ptr Tl)) (sig (ptr GSig)) (tvs (ptr (ArrayList TV)))] (-> TV)
  (let [fd (load (field sig func))
        ps (load (field fd params))
        mark (scope-mark tl)]
    (for i (range 0 (len (load ps)))
      (bind! tl (.name (elem ps i)) (get (load tvs) i)))
    (set! (.inline-depth tl) (+ (.inline-depth tl) 1))
    (let [r (tl-expr tl (elem (load (field fd body)) 0))]
      (set! (.inline-depth tl) (- (.inline-depth tl) 1))
      (scope-pop! tl mark)
      r)))

(defn tl-call-ptr [(tl (ptr Tl)) (fp (ptr Expr)) (args (ptr (ArrayList Expr))) (tail bool)] (-> TV)
  (let [fptv (tl-expr tl fp)
        (mut t) (.ty fptv)]
    (match t
      (TFn [_cc params ret]
           (let [(mut tvs) (ArrayList::new [TV] (.a tl))]
             (reserve! (mut tvs) (len (load args)))
             (for i (range 0 (len (load args)))
               (push! (mut tvs) (tl-expr tl (elem args i))))
             (tl-emit-call tl (none32) (scalar tl fptv) params false (load ret) (cast (ptr (ArrayList TV)) (mut tvs)) false)))
      (_ (tl-fail "call-ptr on non-fnptr value")))))

; ============================ functions ======================================

;;; Lower one function's parameters to CIR arguments and bindings.
(defn tl-params! [(tl (ptr Tl)) (fd (ptr Func))] (-> void)
  (let [g (.g tl)
        fp (.f tl)
        ps (load (field fd params))]
    (when (= (abi-cls (.retinfo tl)) 4)
      (set! (.sret tl) (cir/arg! fp cir/T-I64 true)))
    (for i (range 0 (len (load ps)))
      (let [prm (elem ps i)
            t (field prm ty)
            info (tl-abi-info tl t)
            cls (abi-cls info)]
        (cond
          (= cls 6) (bind! tl (.name prm) (tv-p (new-slot-bytes tl 1 1) (load t)))
          (wide? t) (bind! tl (.name prm) (tv-s (cir/arg! fp cir/T-I128 false) (load t)))
          (or (= cls 0) (= cls 1))
            (let [v (cir/arg-flagged! fp (tl-cty t) false (narrow-arg-flags tl t true))]
              ; C callers extend narrow arguments to 32 bits only
              (bind! tl (.name prm) (tv-s (canon tl v t) (load t))))
          (= cls 2)
            (let [sz (tsize tl t)
                  v (cir/arg! fp (eb-cty info 0 sz) false)
                  s (new-slot tl t)]
              (eb-store tl s info 0 0 v sz)
              (bind! tl (.name prm) (tv-p s (load t))))
          (= cls 3)
            (let [sz (tsize tl t)
                  lo (cir/arg-flagged! fp (eb-cty info 0 8) false (pair-flags info))
                  hi (cir/arg! fp (eb-cty info 1 (hi-bytes sz)) false)
                  s (new-slot tl t)]
              (eb-store tl s info 0 0 lo 8)
              (eb-store tl s info 1 8 hi (hi-bytes sz))
              (bind! tl (.name prm) (tv-p s (load t))))
          (.x64 tl)
            ; MEMORY: the copy the caller put on the stack
            (bind! tl (.name prm) (tv-p (cir/arg-flagged! fp cir/T-I64 false (cir/af-byval (tsize tl t))) (load t)))
          (= cls 5)
            (let [hn (abi-hfa-n info)
                  lb (/ (abi-hfa-bits info) 8)
                  ft (if (= lb 4) (TFloat 32) (TFloat 64))
                  s (new-slot tl t)]
              (for j (range 0 hn)
                (let [(mut ftt) ft
                      v (cir/arg-flagged! fp (tl-cty (mut ftt)) false (group-flags (- (- hn j) 1)))]
                  (store-scalar tl s (* j lb) v (mut ftt))))
              (bind! tl (.name prm) (tv-p s (load t))))
          :else
            ; indirect: the caller's private copy
            (bind! tl (.name prm) (tv-p (cir/arg! fp cir/T-I64 false) (load t))))))))

(defn tl-return! [(tl (ptr Tl)) (tv TV)] (-> void)
  (let [fp (.f tl)
        (mut rt) (.retty tl)
        rcls (abi-cls (.retinfo tl))]
    (open! tl)
    (cond
      (ret-void? (mut rt)) (cir/ret0! fp)
      (wide? (mut rt)) (cir/ret1! fp (coerce-scalar tl (scalar tl tv) (.ty tv) (.retty tl)))
      (or (= rcls 0) (= rcls 1)) (cir/ret1! fp (coerce-scalar tl (scalar tl tv) (.ty tv) (.retty tl)))
      (= rcls 6) (cir/ret0! fp)
      (= rcls 4)
        (do (memcpy tl (.sret tl) (place tl tv) (tsize tl (mut rt)))
            (open! tl)
            ; System V returns the sret pointer in rax
            (if (.x64 tl) (cir/ret1! fp (.sret tl)) (cir/ret0! fp)))
      :else
        (let [p (place tl tv)
              sz (tsize tl (mut rt))
              (mut vals) (ArrayList::new [u32] (.a tl))]
          (cond
            (= rcls 2) (push! (mut vals) (eb-load tl p (.retinfo tl) 0 0 sz))
            (= rcls 3) (do (push! (mut vals) (eb-load tl p (.retinfo tl) 0 0 8))
                           (push! (mut vals) (eb-load tl p (.retinfo tl) 1 8 (hi-bytes sz))))
            :else (let [info (.retinfo tl)
                        lb (/ (abi-hfa-bits info) 8)
                        ft (if (= lb 4) (TFloat 32) (TFloat 64))]
                    (for j (range 0 (abi-hfa-n info))
                      (let [(mut ftt) ft]
                        (push! (mut vals) (load-scalar tl p (* j lb) (mut ftt)))))))
          (open! tl)
          (cir/ret! fp (cast (ptr (ArrayList u32)) (mut vals)))))
    0))

;;; Lower and compile one Coil function.
(defn tl-sig [(tl (ptr Tl)) (fd (ptr Func))] (-> (ptr GSig))
  (let [g (.g tl)
        si (g-sig-idx g (.name fd))]
    (when (< si 0) (tl-fail (sconcat (.a tl) "tpde: unregistered function " (.name fd))))
    (al-at [GSig] (field g sigs) si)))

;;; Lower `fd` into the current CIR function, (.f tl).
(defn tl-func-lower! [(tl (ptr Tl)) (fd (ptr Func))] (-> void)
  (let [fp (.f tl)
        stats (.stats tl)
        t1 (if stats (ticks) 0)]
    (for _ (range 0 (.prof-lower-repeat tl)) (tl-lower-func! tl fd))
    (tl-lower-func! tl fd)
    (cir/finish! fp)
    (when stats
      (set! (.t-lower tl) (+ (.t-lower tl) (- (ticks) t1)))
      (set! (.stat-funcs tl) (+ (.stat-funcs tl) 1))
      (set! (.stat-vals tl) (+ (.stat-vals tl) (len (.values (load fp)))))
      (set! (.stat-insts tl) (+ (.stat-insts tl) (len (.insts (load fp)))))
      (set! (.stat-blocks tl) (+ (.stat-blocks tl) (len (.blocks (load fp)))))
      (set! (.stat-ops tl) (+ (.stat-ops tl) (len (.operands (load fp))))))))

; ---- jobs ----
; Lowering (AST to CIR) and compiling (CIR to machine code) are a pipeline: the
; backend thread lowers function i+1 while a second thread compiles function
; i. A job is everything the compiling side needs, so that it touches nothing
; of the lowering side's: its CIR function, its tpde symbols (made by the
; lowering side), and for a machine-code function the bytes. Jobs are compiled
; in submission order, so the object is the same as compiling serially.

(const JOB-COMPILE 0)
(const JOB-MACHINE-CODE 1)
(const JOB-STOP 2)

(defstruct Job
  [(kind i64)
   (fd (ptr Func))
   (fp (ptr cir/Func))
   (sig (ptr GSig))
   ; the symbol the code defines; a :shim function's body is its __impl and
   ; `tramp` the Coil name, its trampoline (else NONE)
   (tsym u32)
   (tramp u32)
   (code MachineCodeBody)
   ; debug info: the function and its variables, from the lowering side
   (dfn DwFn)
   (dvars (ArrayList DwVar))
   (dextra (ArrayList i64))
   ; and what compiling it recorded, for the encoding stage
   (drows (ArrayList u64))
   (dmarks (ArrayList u64))
   (dallocas (ArrayList i64))
   (dtrack (ArrayList u32))
   (dlocs (ArrayList u64))
   ; 1 from submission until the compiling side is done with it
   (state i64)])

;;; The encoding stage, after a function compiled: its variables' frame
;;; offsets and scope ranges from what compiling recorded, its line rows, and
;;; then its DWARF, encoded now (the functions arrive in text order).
(defn dbg-encode! [(tl (ptr Tl)) (j (ptr Job))] (-> void)
  (let [df (field j dfn)
        fstart (.textoff df)
        allocas (.dallocas j)
        marks (.dmarks j)
        rows (.drows j)
        mask40 (- (<< (: 1 u64) (: 40 u64)) (: 1 u64))
        mi (.mark-insts (load (.fp j)))]
    (while (< (len (.inst-off tl)) (i64-of (cir/value-count (.fp j)))) (push! (mut (.inst-off tl)) -1))
    (for i (range 0 (/ (len marks) 2))
      (set! (mut (.inst-off tl)) (primitive/cast i64 (get marks (* i 2))) (primitive/cast i64 (get marks (+ (* i 2) 1)))))
    (for v (range 0 (len (.dvars j)))
      (let [dv (elem (mut (.dvars j)) v)]
        ; a frame slot's offset (a tracked variable's slot is its value's index)
        (unless (or (.loclist dv) (.cst dv))
          (set! (.slot dv) (+ (get allocas (.slot dv)) (get (.dextra j) v))))
        (when (>= (.start dv) 0) (set! (.start dv) (mark-off tl mi (.start dv))))
        (when (>= (.end dv) 0) (set! (.end dv) (mark-off tl mi (.end dv))))))
    (for i (range 0 (/ (len marks) 2))
      (set! (mut (.inst-off tl)) (primitive/cast i64 (get marks (* i 2))) -1))
    ; the entry maps to the defn; the first row after it ends the prologue
    (clear! (mut (.dw-evs tl)))
    (push! (mut (.dw-evs tl)) (DwLineEv :textoff fstart :source (.source df) :lo (.lo df) :pe false))
    (for r (range 0 (/ (len rows) 2))
      (let [off (primitive/cast i64 (get rows (* r 2)))
            loc (get rows (+ (* r 2) 1))]
        (push! (mut (.dw-evs tl))
               (DwLineEv :textoff (if (< off fstart) fstart off)
                         :source (- (primitive/cast i64 (>> loc (: 40 u64))) 1)
                         :lo (primitive/cast i64 (& loc mask40)) :pe (= r 0)))))
    (dw-inc-fn! (cast (ptr DwInc) (mut (.dwinc tl))) df (field j dvars) (cast (ptr (ArrayList DwLineEv)) (mut (.dw-evs tl)))
                (field j dlocs))))

;;; The code offset of debug mark `id`: of the instruction it marks (-1 when
;;; none followed or it was not compiled: the scope runs to the end).
(defn mark-off [(tl (ptr Tl)) (mi (ArrayList u32)) (id i64)] (-> i64)
  (let [inst (get mi id)]
    (if (= inst (none32)) -1 (get (.inst-off tl) (i64-of inst)))))

(defn job-run! [(tl (ptr Tl)) (j (ptr Job))] (-> void)
  (let [ta (.ta tl)]
    (if (= (.kind j) JOB-MACHINE-CODE)
        (let [text (tasm/sect-buf ta tasm/SEC-TEXT)
              start (.len (load text))
              bytes (load (.bytes (.code j)))]
          (for i (range 0 (len bytes)) (tbuf/emit8! text (get bytes i)))
          (when (func-machine-code-returns? (.fd j))
            (if (.x64 tl) (tbuf/emit8! text (: 0xC3 u8)) (tbuf/emit32! text (: 0xD65F03C0 u32))))
          (tasm/sym-def! ta (.tsym j) tasm/SEC-TEXT start (- (.len (load text)) start)))
        (let [c (.c tl)
              stats (.stats tl)
              t3 (if stats (ticks) 0)]
          (tcore/set-adaptor! c (.fp j))
          ; the values whose locations debug info samples
          (when (.dbg tl)
            (clear! (mut (.dbg-track c)))
            (for v (.dtrack j) (push! (mut (.dbg-track c)) v)))
          (for _ (range 0 (.prof-repeat tl)) (isel/compile! c (.tsym j)))
          (unless (isel/compile! c (.tsym j))
            (tl-fail (sconcat (malloc-allocator) "tpde: failed to compile " (.name (.fd j)))))
          (when (.dbg tl)
            ; what the encoding stage needs: the Compiler moves on
            (let [sy (tasm/sym-at ta (.tsym j))]
              (set! (.textoff (.dfn j)) (.off sy))
              (set! (.len (.dfn j)) (.size sy)))
            (clear! (mut (.drows j)))
            (clear! (mut (.dmarks j)))
            (clear! (mut (.dallocas j)))
            (for r (.dbg-rows (load c)) (push! (mut (.drows j)) r))
            (for m (.dbg-marks (load c)) (push! (mut (.dmarks j)) m))
            (for o (.dbg-allocas (load c)) (push! (mut (.dallocas j)) o))
            (clear! (mut (.dlocs j)))
            (for l (.dbg-locs (load c)) (push! (mut (.dlocs j)) l)))
          (when stats (set! (.t-compile tl) (+ (.t-compile tl) (- (ticks) t3))))
          (when (!= (.tramp j) (none32)) (tl-shim-trampoline! tl (.sig j) (.tsym j) (.tramp j)))))))

;;; The ring of jobs between the two sides. A slot's `state` is 1 from
;;; submission until the compiling side is done with it; both sides spin on it
;;; (yielding when it takes a while) since each is busy nearly all the time
;;; and a wakeup per function cost more than the overlap gained.
(defstruct Pipe
  [(tl (ptr Tl))
   (jobs (ArrayList Job))
   ; next slot the lowering side fills, and the compiling side takes
   (head i64)
   (tail i64)
   (threaded bool)
   (thread Thread)
   ; debug info: a third stage, encoding each compiled function's DWARF on
   ; its own thread (slot state 2 between compiling and it)
   (dbg bool)
   (dthreaded bool)
   (dtail i64)
   (dthread Thread)])

(extern cgtpde.sched-yield :as "sched_yield" [] (-> i32))

(defn pipe-slot [(p (ptr Pipe)) (i i64)] (-> (ptr Job)) (elem (mut (.jobs p)) i))

;;; Wait until the slot's state is `want`.
(defn job-await [(j (ptr Job)) (want i64)] (-> void)
  (let [(mut spins) 0]
    (while (!= (atomic/read (field j state)) want)
      (set! spins (+ spins 1))
      (when (> spins 64) (cgtpde.sched-yield)))))

(defn compile-thread-entry [(arg (ptr i8))] (-> (ptr i8))
  (let [p (primitive/cast (ptr Pipe) arg)
        n (len (.jobs p))]
    (block :done
      (loop
        (let [j (pipe-slot p (.tail p))]
          (job-await j 1)
          (when (= (.kind j) JOB-STOP)
            (when (.dthreaded p) (atomic/store (field j state) 2))
            (return-from :done 0))
          (job-run! (.tl p) j)
          ; with no encoding thread, encode here
          (when (and (.dbg p) (not (.dthreaded p))) (job-encode! (.tl p) j))
          (atomic/store (field j state) (if (.dthreaded p) 2 0))
          (set! (.tail p) (% (+ (.tail p) 1) n)))))
    (primitive/cast (ptr i8) 0)))

(defn dwarf-thread-entry [(arg (ptr i8))] (-> (ptr i8))
  (let [p (primitive/cast (ptr Pipe) arg)
        n (len (.jobs p))]
    (block :done
      (loop
        (let [j (pipe-slot p (.dtail p))]
          (job-await j 2)
          (when (= (.kind j) JOB-STOP) (return-from :done 0))
          (job-encode! (.tl p) j)
          (atomic/store (field j state) 0)
          (set! (.dtail p) (% (+ (.dtail p) 1) n)))))
    (primitive/cast (ptr i8) 0)))

(defn job-encode! [(tl (ptr Tl)) (j (ptr Job))] (-> void)
  (when (= (.kind j) JOB-COMPILE)
    (let [t4 (if (.stats tl) (ticks) 0)]
      (dbg-encode! tl j)
      (when (.stats tl) (set! (.t-dwarf tl) (+ (.t-dwarf tl) (- (ticks) t4)))))))

;;; The slot the next job goes in, once the compiling side is done with it.
(defn pipe-claim [(p (ptr Pipe))] (-> (ptr Job))
  (let [j (pipe-slot p (.head p))]
    (when (.threaded p) (job-await j 0))
    j))

;;; Hand the claimed slot over (or, serially, run it now).
(defn pipe-submit! [(p (ptr Pipe)) (j (ptr Job))] (-> void)
  (if (.threaded p)
      (atomic/store (field j state) 1)
      (do (job-run! (.tl p) j)
          (when (.dbg p) (job-encode! (.tl p) j))))
  (set! (.head p) (% (+ (.head p) 1) (len (.jobs p)))))

(defn pipe-start! [(p (ptr Pipe)) (tl (ptr Tl)) (threaded bool)] (-> void)
  (set! (.tl p) tl)
  (set! (.head p) 0)
  (set! (.tail p) 0)
  (set! (.dtail p) 0)
  (set! (.dbg p) (.dbg tl))
  (set! (.dthreaded p) false)
  (set! (.threaded p) false)
  (set! (.jobs p) (ArrayList::new [Job] (.a tl)))
  (for i (range 0 (if threaded 8 1))
    (push! (mut (.jobs p))
           (Job :kind JOB-COMPILE :fd (primitive/cast (ptr Func) 0)
                :fp (if (= i 0) (.f tl) (box! (.a tl) cir/Func (cir/Func::new)))
                :sig (primitive/cast (ptr GSig) 0) :tsym (none32) :tramp (none32)
                :code (zeroed MachineCodeBody)
                :dfn (zeroed DwFn) :dvars (ArrayList::new [DwVar] (malloc-allocator))
                :dextra (ArrayList::new [i64] (malloc-allocator))
                :drows (ArrayList::new [u64] (malloc-allocator)) :dmarks (ArrayList::new [u64] (malloc-allocator))
                :dallocas (ArrayList::new [i64] (malloc-allocator))
                :dtrack (ArrayList::new [u32] (malloc-allocator)) :dlocs (ArrayList::new [u64] (malloc-allocator))
                :state 0)))
  (when threaded
    (tasm/share! (.ta tl))
    ; the encoding thread first: the compiling one reads `dthreaded` from its
    ; first job on
    (set! (.dthreaded p)
          (and (.dbg p)
               (= (Thread::spawn-configured (field p dthread) (fnptr-of dwarf-thread-entry)
                                            (primitive/cast (ptr i8) p) (ThreadConfig::new 8388608 -1))
                  (: 0 i32))))
    (set! (.threaded p)
          (= (Thread::spawn-configured (field p thread) (fnptr-of compile-thread-entry)
                                       (primitive/cast (ptr i8) p) (ThreadConfig::new 67108864 -1))
             (: 0 i32)))
    (when (and (.dthreaded p) (not (.threaded p)))
      ; serial after all: stop the encoding thread
      (let [j (pipe-slot p 0)]
        (set! (.kind j) JOB-STOP)
        (atomic/store (field j state) 2)
        (Thread::join (field p dthread))
        (set! (.kind j) JOB-COMPILE)
        (atomic/store (field j state) 0)
        (set! (.dthreaded p) false)))
    0))

(defn pipe-finish! [(p (ptr Pipe))] (-> void)
  (when (.threaded p)
    (let [j (pipe-claim p)]
      (set! (.kind j) JOB-STOP)
      (pipe-submit! p j))
    (Thread::join (field p thread))
    (when (.dthreaded p) (Thread::join (field p dthread)))
    0))

;;; Lower `fd` and queue it for compiling.
(defn tl-func! [(tl (ptr Tl)) (p (ptr Pipe)) (fd (ptr Func))] (-> void)
  (compiler-work! "emit" (.name fd))
  (let [j (pipe-claim p)
        sig (tl-sig tl fd)
        msym (if (.shim sig) (.implsym sig) (.symidx sig))
        tsym (tl-sym tl msym)]
    (set! (.f tl) (.fp j))
    (tl-func-lower! tl fd)
    (when (.dbg tl)
      ; the code offsets come from compiling (dbg-encode!)
      (set! (.dfn j) (DwFn :name (.name fd) :symidx (i64-of tsym) :source (if (< (.source fd) 0) 0 (.source fd))
                           :lo (if (< (.lo fd) 0) 0 (.lo fd)) :textoff 0 :len 0 :slotbytes 0
                           :varlo 0 :varhi (len (.dw-vars tl))))
      ; the job takes the lists (the encoding stage only edits them in place),
      ; and lowering goes on with the job's old ones
      (let [vs (.dvars j) xs (.dextra j) ts (.dtrack j)]
        (set! (.dvars j) (.dw-vars tl))
        (set! (.dextra j) (.dw-var-extra tl))
        (set! (.dtrack j) (.dw-track tl))
        (set! (.dw-vars tl) vs)
        (set! (.dw-var-extra tl) xs)
        (set! (.dw-track tl) ts)))
    (push! (mut (.defined tl)) msym)
    (push! (mut (.defined tl)) (i64-of tsym))
    (set! (.kind j) JOB-COMPILE)
    (set! (.fd j) fd)
    (set! (.sig j) sig)
    (set! (.tsym j) tsym)
    (set! (.tramp j) (none32))
    (when (.shim sig)
      (let [tramp (tl-sym tl (.symidx sig))]
        (set! (.tramp j) tramp)
        (push! (mut (.defined tl)) (.symidx sig))
        (push! (mut (.defined tl)) (i64-of tramp))))
    (pipe-submit! p j)))

;;; A machine-code function: its bytes, then a return unless it never returns.
(defn tl-machine-code-func! [(tl (ptr Tl)) (p (ptr Pipe)) (fd (ptr Func)) (code MachineCodeBody)] (-> void)
  (compiler-work! "emit" (.name fd))
  (match (machine-code-target-error (.a tl) (.name fd) (.arch code) (if (.x64 tl) "x86_64" "aarch64"))
    (Some [message] (tl-fail (sconcat3 (.a tl) "codegen: " message " (checker bug)")))
    (None [] 0))
  (let [j (pipe-claim p)
        sig (tl-sig tl fd)
        tsym (tl-sym tl (.symidx sig))]
    (push! (mut (.defined tl)) (.symidx sig))
    (push! (mut (.defined tl)) (i64-of tsym))
    (set! (.kind j) JOB-MACHINE-CODE)
    (set! (.fd j) fd)
    (set! (.sig j) sig)
    (set! (.tsym j) tsym)
    (set! (.tramp j) (none32))
    (set! (.code j) code)
    (pipe-submit! p j)))

;;; Lower `fd`'s body to CIR (not yet finished).
(defn tl-lower-func! [(tl (ptr Tl)) (fd (ptr Func))] (-> void)
  (let [g (.g tl)
        fp (.f tl)]
    (cir/reset! fp (.name fd))
    (clear! (mut (.env tl)))
    (clear! (mut (.loops tl)))
    (allocs-reset! tl)
    (set! (.fd tl) fd)
    (set! (.retty tl) (.ret fd))
    (let [(mut rt) (.ret fd)]
      (set! (.retinfo tl) (if (ret-void? (mut rt)) (mk-abi-scalar) (tl-abi-info tl (mut rt)))))
    (set! (.sret tl) (none32))
    (set! (.terminated tl) false)
    (set! (.tailok tl) false)
    (set! (.inline-depth tl) 0)
    (set! (.selfname tl) (.name fd))
    (let [entry (cir/new-block! fp)]
      (cir/set-block! fp entry)
      (cir/seal! fp entry))
    (tl-params! tl fd)
    (when (.dbg tl)
      (clear! (mut (.dw-vars tl)))
      (clear! (mut (.dw-var-extra tl)))
      (clear! (mut (.dw-var-val tl)))
      (clear! (mut (.dw-track tl)))
      (clear! (mut (.dbg-shadow tl)))
      (set! (.dbg-frame tl) (none32))
      (set! (.dbg-frame-size tl) 0)
      (clear! (mut (.dbg-vslots tl)))
      (set! (.dbg-cur-src tl) -1)
      (let [ps (load (field fd params))]
        (for i (range 0 (len (load ps)))
          (let [prm (elem ps i)]
            (match (lookup tl (.name prm))
              (Some [tv] (dbg-bind! tl (.name prm) tv true (.source fd) (.lo fd) (primitive/cast (ptr Expr) 0)))
              (None [] 0))))))
    (let [r (tl-body-tail tl (load (field fd body)) true)]
      (unless (.terminated tl) (tl-return! tl r)))
    (when (.dbg tl) (dbg-frame-close! tl))
    (when (not (cir/terminated? fp)) (cir/unreachable! fp))))

; ============================ the module =====================================

;;; Move tpde's text, constants, symbols and relocations into the MObj.
(defn tl-merge! [(tl (ptr Tl))] (-> void)
  (let [g (.g tl)
        a (.a tl)
        ta (.ta tl)
        text (tasm/sect-buf ta tasm/SEC-TEXT)
        tconst (tasm/sect-buf ta tasm/SEC-CONST)
        textbuf (mobj-sect-buf (mut (.obj g)) (.text g))
        ; x86-64: tpde aligns functions to 16 within its text
        _ (when (.x64 tl) (b-align! (mut textbuf) 16) (mobj-sect-align-at-least! (mut (.obj g)) (.text g) 4))
        text-base (len (load textbuf))
        _ (set! (.text-base tl) text-base)]
    ; x86-64 Mach-O addends are implicit: in the relocated field
    (when (.x64 tl)
      (for i (range 0 (len (.relocs (load ta))))
        (let [r (get (.relocs (load ta)) i)]
          (when (and (!= (.addend r) 0) (!= (.kind r) tasm/R-ABS64))
            (tbuf/patch32! text (.off r) (primitive/cast u32 (.addend r)))))))
    (b-bytes! (mut textbuf) (tbuf/as-slice text))
    ; tpde's own constants go to the const section
    (let [cbuf (mobj-sect-buf (mut (.obj g)) (.constsec g))]
      (b-align! (mut cbuf) 16)
      (mobj-sect-align-at-least! (mut (.obj g)) (.constsec g) 4)
      (let [const-base (len (load cbuf))]
        (b-bytes! (mut cbuf) (tbuf/as-slice tconst))
        ; map every tpde symbol to a MObj one
        (for i (range 0 (i64-of (tasm/sym-count ta)))
          (while (< (len (.tsym-mobj tl)) (+ i 1)) (push! (mut (.tsym-mobj tl)) -1))
          (when (< (get (.tsym-mobj tl) i) 0)
            (let [s (tasm/sym-at ta (u32-of i))]
              (cond
                (= (.sect s) tasm/SEC-CONST)
                  (set! (mut (.tsym-mobj tl)) i
                        (mobj-add-sym! (mut (.obj g)) (sconcat a "l_tpde." (i64->str a i)) (.constsec g) (+ const-base (.off s)) false))
                :else
                  ; a runtime function tpde calls (memcpy, __divti3, ...)
                  (let [(mut name) ""]
                    (for k (range 0 (len (.rt-names (load ta))))
                      (when (= (get (.rt-syms (load ta)) k) (u32-of i)) (set! name (get (.rt-names (load ta)) k))))
                    (set! (mut (.tsym-mobj tl)) i (g-runtime-sym! g (sconcat a "_" name))))))))))
    ; functions tpde defined
    (let [n (/ (len (.defined tl)) 2)]
      (for k (range 0 n)
        (let [m (get (.defined tl) (* k 2))
              t (get (.defined tl) (+ (* k 2) 1))
              s (tasm/sym-at ta (u32-of t))]
          (mobj-set-sym! (mut (.obj g)) m (.text g) (+ text-base (.off s))))))
    ; relocations
    (for i (range 0 (len (.relocs (load ta))))
      (let [r (get (.relocs (load ta)) i)
            msym (get (.tsym-mobj tl) (i64-of (.sym r)))
            k (primitive/cast i64 (.kind r))
            ; x86-64: X86_64_RELOC_BRANCH / SIGNED / GOT_LOAD / UNSIGNED
            rtype (if (.x64 tl)
                      (case k 7 2 6 1 8 3 0)
                      (case k 0 (reloc-branch26) 1 (reloc-page21) 2 (reloc-pageoff12) 3 (reloc-got-load-page21) 4 (reloc-got-load-pageoff12) (reloc-unsigned)))
            pcrel (if (.x64 tl) (!= k 5) (or (= k 0) (= k 1) (= k 3)))
            ln (if (= k 5) 3 2)]
        (when (!= (.sect r) tasm/SEC-TEXT) (tl-fail "tpde: relocation outside the text section"))
        (mobj-add-reloc! (mut (.obj g)) (.text g) (+ text-base (.off r)) msym rtype pcrel ln)))))


;;; The native module's setup: signatures, layouts, statics, export thunks. The returned Cga's
;;; `program` is the program functions are emitted from (thunks included).
(defn tl-module-setup! [(a (dyn Allocator)) (mp0 (ptr Program))] (-> (ptr Cga))
  (let [g (box! a Cga (zeroed Cga))]
    (set! (.a g) a)
    (set! (.program g) mp0)
    (set! (.sigs g) (ArrayList::new [GSig] a))
    (set! (.sig_index g) (HashMap::new [(slice u8) i64] a (keyops)))
    (set! (.sig_memo g) (ArrayList::new [NameMemo] a))  ; unused until registration ends
    (set! (.unit_export_index g) (HashMap::new [(slice u8) bool] a (keyops-borrowed)))
    (set! (.export_symbol_index g) (HashMap::new [(slice u8) (slice u8)] a (keyops-borrowed)))
    (for [i 0 (len (load (.unit_exports mp0)))]
      (set! (mut (.unit_export_index g)) (get (load (.unit_exports mp0)) i) true))
    (for [i 0 (len (load (.exports mp0)))]
      (let [e (elem (.exports mp0) i)]
        (unless (contains? (.export_symbol_index g) (.name e))
          (match (.symbol e)
            (Some [symbol] (set! (mut (.export_symbol_index g)) (.name e) symbol))
            (None [] 0)))))
    (set! (.spec_names g) (HashMap::new [(slice u8) bool] a (keyops)))
    (set! (.obj g) (mobj-new a))
    (set! (.strs g) (ArrayList::new [GStr] a))
    (set! (.str_index g) (HashMap::new [(slice u8) i64] a (keyops)))
    (set! (.statics g) (ArrayList::new [GStatic] a))
    (set! (.nglob g) 0)
    (set! (.nstatic g) 0)
    (set! (.dwtypes g) (dbg-types-new a))
    (set! (.convs g) (load (field mp0 conventions)))
    (set! (.text g) (mobj-add-sect! (mut (.obj g)) "__TEXT" "__text" 2 2147484672))
    (set! (.constsec g) (mobj-add-sect! (mut (.obj g)) "__TEXT" "__const" 3 0))
    (set! (.datasec g) (mobj-add-sect! (mut (.obj g)) "__DATA" "__data" 3 0))
    (let [thunks (export-c-thunks a mp0)
          mp (box! a Program (load mp0))]
      (unless (= (len thunks) 0)
        (let [(mut funcs) (ArrayList::new [Func] a)]
          (for f (load (.funcs mp)) (push! (mut funcs) f))
          (for f thunks (push! (mut funcs) f))
          (set! (.funcs mp) (box! a (ArrayList Func) (load funcs))))
        (for i (range 0 (len (load (.exports mp))))
          (let [e (elem (.exports mp) i)]
            (when (export-c-needs-thunk? e)
              (match (g-export-c-sym g (.name e))
                (Some [symbol]
                      (remove! (mut (.export_symbol_index g)) (.name e))
                      (when (.published e)
                        (set! (mut (.export_symbol_index g)) (export-c-thunk-name a (.name e)) symbol)
                        0))
                (None [] 0))))))
      (g-register-types! g mp)
      (g-eval-asserts! g mp)
      (g-register-sigs! g mp)
      ; sig_index is final now: memoize its lookups from here on
      (set! (.sig_memo g) (name-memo-new (.a g)))
      (g-declare-statics! g mp)
      (set! (.program g) mp)
      g)))

;;; Finish the DWARF the compiling side encoded: the types, and the sections.
(defn tl-emit-dwarf! [(tl (ptr Tl)) (paths (ptr (ArrayList (slice u8))))] (-> void)
  (let [g (.g tl)
        t0 (ticks)
        dw (dw-inc-finish! (cast (ptr DwInc) (mut (.dwinc tl))) paths (field (field g dwtypes) tys)
                           (len (load (mobj-sect-buf (mut (.obj g)) (.text g)))) (.a tl))]
    (mobj-add-sym! (mut (.obj g)) "ltmp0" (.text g) 0 false)
    (g-add-dwarf-sections! g dw)
    (when (.stats tl)
      (eprintln "tpde: dwarf {} types, finished in {}us" (len (.tys (.dwtypes g))) (- (ticks) t0)))
    0))

(defn cgtpde-build-mobj [(a (dyn Allocator)) (mp (ptr Program)) (mainpath (slice u8)) (compdir (slice u8))
                         (paths (ptr (ArrayList (slice u8)))) (texts (ptr (ArrayList (slice u8)))) (emit-dwarf bool)] (-> MObj)
  (let [t-setup0 (ticks)
        g (tl-module-setup! a mp)
        t-setup (- (ticks) t-setup0)
        (mut ta) (tasm/Asm::new)
        tap (cast (ptr tasm/Asm) (mut ta))
        (mut fn) (cir/Func::new)
        fnp (cast (ptr cir/Func) (mut fn))
        x64 (= (target-arch-str) "x86_64")
        (mut c) (tcore/Compiler::new [cir/Func] fnp tap (if x64 tcore/ARCH-X64 tcore/ARCH-A64))
        (mut tl) (zeroed Tl)]
    (set! (.x64 tl) x64)
    (set! (.dbg tl) emit-dwarf)
    (set! (.debug c) (.dbg tl))
    (set! (.dw-vars tl) (ArrayList::new [DwVar] a))
    (set! (.dw-var-extra tl) (ArrayList::new [i64] a))
    (set! (.dw-var-val tl) (ArrayList::new [u32] a))
    (set! (.dw-track tl) (ArrayList::new [u32] a))
    (set! (.dbg-shadow tl) (ArrayList::new [u32] a))
    (set! (.dbg-texts tl) texts)
    (set! (.dbg-ty-keys tl) (ArrayList::new [u64] a))
    (set! (.dbg-vslots tl) (ArrayList::new [i64] a))
    (set! (.dbg-ty-vals tl) (ArrayList::new [i64] a))
    ; the compiling thread grows these: not the (single-threaded) arena
    (set! (.dw-evs tl) (ArrayList::new [DwLineEv] (malloc-allocator)))
    (set! (.inst-off tl) (ArrayList::new [i64] (malloc-allocator)))
    (when (.dbg tl)
      (let [t0 (ticks)]
        (set! (.dwinc tl) (dw-inc-new (malloc-allocator) mainpath compdir texts (if x64 6 29) 0))
        (when (!= (primitive/cast i64 (cgtpde.getenv c"COIL_TPDE_STATS")) 0) (eprintln "tpde: dwarf setup {}us ({} sources)" (- (ticks) t0) (len (load texts))))))
    (set! (.g tl) g)
    (set! (.a tl) a)
    (set! (.f tl) fnp)
    (set! (.c tl) (cast (ptr (tcore/Compiler cir/Func)) (mut c)))
    (set! (.ta tl) tap)
    (set! (.env tl) (ArrayList::new [TBind] a))
    (set! (.loops tl) (ArrayList::new [TLoop] a))
    (set! (.allocs tl) (ArrayList::new [AllocSlot] a))
    (set! (.alloc-gen tl) (: 1 u32))
    (set! (.sym-map tl) (ArrayList::new [u32] a))
    (set! (.tsym-mobj tl) (ArrayList::new [i64] a))
    (set! (.defined tl) (ArrayList::new [i64] a))
    (set! (.call-args tl) (ArrayList::new [u32] a))
    (set! (.penv tl) (ArrayList::new [PBind] a))
    (set! (.abi-cache tl) (ArrayList::new [AbiInfo] a))
    (set! (.abi-known tl) (ArrayList::new [bool] a))
    (let [r (cgtpde.getenv c"COIL_TPDE_PROFILE_REPEAT")]
      (set! (.prof-repeat tl) (if (= (primitive/cast i64 r) 0) 0 (cgtpde.atol r))))
    (set! (.stats tl) (!= (primitive/cast i64 (cgtpde.getenv c"COIL_TPDE_STATS")) 0))
    (let [r (cgtpde.getenv c"COIL_TPDE_PROFILE_LOWER")]
      (set! (.prof-lower-repeat tl) (if (= (primitive/cast i64 r) 0) 0 (cgtpde.atol r))))
    (set! (.call-flags tl) (ArrayList::new [u32] a))
    (set! (.call-rts tl) (ArrayList::new [u8] a))
    (set! (.rt-args tl) (ArrayList::new [u32] a))
    (set! (.rt-flags tl) (ArrayList::new [u32] a))
    (set! (.rt-rts tl) (ArrayList::new [u8] a))
    (let [tlp (cast (ptr Tl) (mut tl))
          (mut pipe) (zeroed Pipe)
          pp (cast (ptr Pipe) (mut pipe))
          span (tr/span-begin "backend.tpde-functions")
          fs (load (field (.program g) funcs))]
      (pipe-start! pp tlp (= (primitive/cast i64 (cgtpde.getenv c"COIL_TPDE_SERIAL")) 0))
      (let [names? (!= (primitive/cast i64 (cgtpde.getenv c"COIL_TPDE_NAMES")) 0)]
        (for i (range 0 (len (load fs)))
          (let [fd (al-at [Func] fs i)]
            (unless (.declared fd)
              (when names? (eprintln "tpde[{}] {}" i (.name fd)))
              (match (func-machine-code fd)
                (Some [code] (tl-machine-code-func! tlp pp fd code))
                (None [] (tl-func! tlp pp fd)))
              0)))
        (pipe-finish! pp))
      (tr/span-end span)
      (when (!= (primitive/cast i64 (cgtpde.getenv c"COIL_TPDE_STATS")) 0)
        (eprintln "tpde: {} functions, {} values, {} insts, {} blocks, {} operands"
                  (.stat-funcs tlp) (.stat-vals tlp) (.stat-insts tlp) (.stat-blocks tlp) (.stat-ops tlp))
        ; mach ticks are 1/24 us on Apple silicon
        (eprintln "tpde: lower {}us compile {}us dwarf {}us" (.t-lower tlp)
                  (.t-compile tlp) (.t-dwarf tlp)))
      (let [t-merge0 (ticks)]
        (tl-merge! tlp)
        (when (.dbg tlp)
          (let [span (tr/span-begin "backend.tpde-dwarf")]
            (tl-emit-dwarf! tlp paths)
            (tr/span-end span)))
        (when (!= (primitive/cast i64 (cgtpde.getenv c"COIL_TPDE_STATS")) 0)
          (eprintln "tpde: module setup {}us merge {}us" t-setup (- (ticks) t-merge0))))
      (tl-free! tlp pp))
    (.obj g)))

;;; Release what tpde allocated for the build: the merge copied the code,
;;; constants and DWARF into the MObj, and symbol names are the MObj's or
;;; static. (Lists in the build's allocator go with it; a REPL builds many
;;; times in one process, so nothing here may outlive the build.)
(defn tl-free! [(tl (ptr Tl)) (p (ptr Pipe))] (-> void)
  (tasm/asm-free! (.ta tl))
  (tcore/compiler-free! (.c tl))
  (for i (range 0 (len (.jobs p)))
    (let [j (pipe-slot p i)]
      (cir/func-free! (.fp j))
      (free! (mut (.dvars j)))
      (free! (mut (.dextra j)))
      (free! (mut (.drows j)))
      (free! (mut (.dmarks j)))
      (free! (mut (.dallocas j)))
      (free! (mut (.dtrack j)))
      (free! (mut (.dlocs j)))))
  ; (the jobs swap their lists with these: either allocator's)
  (free! (mut (.dw-vars tl)))
  (free! (mut (.dw-var-extra tl)))
  (free! (mut (.dw-track tl)))
  (free! (mut (.dw-evs tl)))
  (free! (mut (.inst-off tl)))
  (when (.dbg tl) (dw-inc-free! (cast (ptr DwInc) (mut (.dwinc tl)))))
  0)

(defn cgtpde-build-object [(a (dyn Allocator)) (mp (ptr Program)) (objpath (ptr i8)) (mainpath (slice u8)) (compdir (slice u8))
                           (paths (ptr (ArrayList (slice u8)))) (texts (ptr (ArrayList (slice u8)))) (emit-dwarf bool)] (-> i64)
  (let [(mut o) (cgtpde-build-mobj a mp mainpath compdir paths texts emit-dwarf)
        t0 (ticks)
        bytes (if (= (target-arch-str) "x86_64") (macho-write-x64 (mut o)) (macho-write (mut o)))
        t1 (ticks)
        fd (fs/create-file objpath 420)]
    (set! (native-last-needs-curl-cell)
          (mobj-references-undefined? (mut o) (native-probe-name a "_curl_easy_" "init")))
    (set! (native-last-needs-llvm-cell)
          (mobj-references-undefined? (mut o) (native-probe-name a "_LLVMGetDefault" "TargetTriple")))
    (when (!= (primitive/cast i64 (cgtpde.getenv c"COIL_TPDE_STATS")) 0)
      (eprintln "tpde: macho-write {}us probes {}us" (- t1 t0) (- (ticks) t1)))
    (when (< fd 0) (cga-fail "cannot create object file"))
    (let [total (len (load bytes))
          (mut off) 0]
      (while (< off total)
        (let [wrote (cgtpde.write (primitive/cast i32 fd)
                                  (primitive/cast (ptr i8) (index (data (slice (load bytes))) off))
                                  (primitive/cast isize (- total off)))]
          (when (<= wrote 0) (cga-fail "object write failed"))
          (set! off (+ off (primitive/cast i64 wrote))))))
    (cgtpde.close (primitive/cast i32 fd))
    0))
