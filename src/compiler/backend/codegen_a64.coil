; src/compiler/backend/codegen_a64.coil — the native AArch64 backend (zero LLVM).
; Consumes the SAME monomorphized Program as codegen.coil and lowers it
; directly to machine code in a Mach-O object. codegen.coil (the LLVM
; backend) is the behavioral spec: every lowering decision here mirrors its
; semantics — sum layout {i32 tag, [words x i64] payload}, slice fat pointers
; {ptr,i64}, divergence discipline, C ABI (AAPCS64) at every call.
;
; Code generation model (debug backend — compile speed over code quality):
;  - every value lives by-value in an fp-anchored stack slot; x28 = slot base
;  - scratch registers x9-x15 / d0-d7 are only live within one expression
;  - one calling convention everywhere: AAPCS64 (Apple), incl. variadic rule
;
; Frame layout (grows down):     [caller frame | incoming stack args]
;   x29 -> saved x29,x30                      <- stp x29,x30,[sp,#-16]!
;          saved x28 (+8 pad)                 <- str x28,[sp,#-16]!
;          slots (x28 = base, off 0..slotbytes)
;   sp  -> outgoing stack args (outbytes)
; The prologue's frame subtraction and `x28 = sp + outbytes` are back-patched once
; the body is emitted and slotbytes/outbytes are known. `alloc-stack-bytes` moves
; sp further down at run time; the outgoing-args area stays at the bottom, so the
; bytes it returns start at sp + outbytes, another back-patched sum (`OutFix`).
; The epilogue restores sp from x29, so no dynamic allocation needs undoing.
(module coil.compiler.codegen_a64)
(import "coil.compiler.native"
        :use
        [GLoop GStr GStatic AVal GScope GCEval mk-aval av-kind av-v av-ty
         gscope-nil gscope-put gscope-get g-last-component ty-is-float
         ty-float-bytes mk-gcev gcev-v gcev-u g-const-cmp slot-new! g-loop-index
         g-bits-info g-const-eval g-const-bin ty-int-info GNil GBind]
        :reexport)
(import "coil.compiler.native"
        :use
        [IrContext ir-lane-av ir-as-unsigned ir-force-unsigned-ty ir-extend-op!
         ir-floatconv! ir-value ir-lit-vec! ir-value-adv! ir-parse-type]
        :reexport)
(import "coil.compiler.native" :use [ir-bind!] :reexport)
(import "coil.compiler.native" :as native)
(import "coil.compiler.text" :as text)
(import "coil.primitive" :as primitive)
(import "coil.compiler.ir_syntax" :as irs)
(import "coil.compiler.vector_scalar" :use *)
(import "coil.compiler.float_math" :use *)
(import "coil.compiler.unit_state" :use *)

(defstruct Cga64UnitState
  [(curl bool) (llvm bool)])

(defn cga64-unit-state-cell [] (-> (ptr (ptr Cga64UnitState)))
  (primitive/alloc-static (ptr Cga64UnitState)))

(defn cga64-unit-state [] (-> (ptr Cga64UnitState))
  (let [p (load (cga64-unit-state-cell))]
    (if (= (primitive/cast i64 p) 0) (primitive/alloc-static Cga64UnitState) p)))

(defn cga64-unit-bind! [(next (ptr Cga64UnitState))] (-> (ptr Cga64UnitState))
  (let [prior (cga64-unit-state)]
    (set! (cga64-unit-state-cell) next)
    prior))

(import "coil.alloc" :as alloc :use *)
(import "coil.result" :use *)
(import "coil.slice" :use *)
(import "coil.str" :use *)
(import "coil.arraylist" :use *)
(import "coil.hashmap" :use *)
(import "coil.io" :use *)
(import "coil.fs" :as fs)
(import "coil.control" :use *)
(import "coil.mem" :use *)
(import "coil.compiler.ast" :use *)
(import "coil.compiler.parser" :use *)
(import "coil.compiler.layoutdb" :use *)
(import "coil.compiler.a64" :use *)
(import "coil.compiler.macho" :use *)
(import "coil.compiler.dwarf" :use *)
(import "coil.compiler.debuginfo" :use *)
(import "coil.compiler.mtrace" :as mtr)
(import "coil.compiler.trace" :as tr)
(import "coil.cc" :as cc)

; file-writing externs; the object file is created with coil.fs's `create-file`
(extern cga64.write [i32 (ptr i8) isize] (-> isize))  ; C write's fd is int (i32); matches io/cimport write (isize=i64 native, i32 wasm)

(extern cga64.close [i32] (-> i32))  ; C `close(int?)` returns int, not long — matches ffi.close/cimport.close (return is discarded)

(extern cga64.exit [i32] (-> void))

; ============================ state ==========================================
(defstruct GSig  ; one callable (function or extern)
  [(name (slice u8))
   (params (ptr (ArrayList Type)))
   (ret Type)
   (variadic bool)
   (symidx i64)
   (shim bool)
   (implsym i64)  ; :shim conventions (trampoline realization)
   (shimregs (ptr (ArrayList i64)))
   (shimret i64)
   ; the convention clobbers x28 or x29, which hold this frame: its call sites
   ; save and restore both
   (shimsave bool)
   ; an inlined machine-code function's bytes, which its call sites hold in
   ; place of the call; empty for a call
   (inline_code (slice u8))
   (func (ptr Func))
   (inline_policy (Option InlinePolicy))])

; A two-instruction `rd = sp + outbytes` whose immediate is patched once the
; function's outgoing-args size is known.
(defstruct OutFix [(off i64) (rd i64)])

(defstruct Cga
  [(a (dyn Allocator))
   (program (ptr Program))
   (layouts LayoutDb)
   (sigs (ArrayList GSig))  ; funcs + externs, keyed by name
   (sig_index (HashMap (slice u8) i64))
   (sig_memo (ArrayList NameMemo))  ; layoutdb's name memo in front of sig_index
   ; These are immutable declaration views for one codegen run. Indexing them
   ; once avoids an O(functions x exports) signature-registration pass.
   (unit_export_index (HashMap (slice u8) bool))
   (export_symbol_index (HashMap (slice u8) (slice u8)))
   ; Names mono generated from a generic or a trait impl: a static cell inside
   ; one is emitted as a weak external definition, one per program across
   ; units (the LLVM backend's weak_odr). See codegen.coil Cg.spec_names.
   (spec_names (HashMap (slice u8) bool))
   (obj MObj)
   (text i64)
   (constsec i64)
   (datasec i64)  ; section ordinals
   (asm Asm)
   (strs (ArrayList GStr))  ; interned EStr/ECStr globals
   (str_index (HashMap (slice u8) i64))  ; tagged content -> symidx of `strs`
   (statics (ArrayList GStatic))
   (nglob i64)  ; g.N counter
   (nstatic i64)  ; stable alloc-static ordinal within the current function
   ; ---- per-function state ----
   (frame i64)  ; next free slot offset
   (env (ptr GScope))
   (loops (ArrayList GLoop))
   (terminated bool)
   (retty Type)
   (sretslot i64)  ; slot holding incoming x8, -1 = none
   (epilabel i64)
   (outbytes i64)  ; max outgoing stack-arg bytes of any call
   (outfixes (ArrayList OutFix))  ; every `rd = sp + outbytes` to patch
   (fnstart i64)  ; text offset of current function start
   ; ---- self-tail-call state (see emit-tail-self-call!) ----
   (selfname (slice u8))  ; name of the function being emitted
   (tailslots (ptr (ArrayList i64)))  ; its parameter slots, in order
   (tailtys (ptr (ArrayList Type)))  ; and their types
   (entrylabel i64)  ; label bound after parameter intake
   (tailok bool)  ; the expression being emitted is in TAIL position
   (inline_depth i64)
   ; ---- DWARF collection ----
   (dwtypes DbgTypes)
   (dwfns (ArrayList DwFn))
   (dwvars (ArrayList DwVar))
   (dwevs (ArrayList DwLineEv))
   (dwcursrc i64)
   (dwcurlo i64)
   (convs (ptr (ArrayList Convention)))])

; hard error helper — no silent fallbacks anywhere in this backend.
(extern cga.exit :as "exit" :cc (cc/C) [i32] (-> void))

;;; A program this backend cannot compile -- a feature it does not lower, or an
;;; invariant an earlier stage broke -- ends the compile with a diagnostic and exit
;;; status 1, as the LLVM backend's cg-fail does, never with an abort and a core dump.
(defn cga-fail [(msg (slice u8))] (-> i64)
  (print-str (stderr) "error: arm64 backend: ")
  (print-str (stderr) msg)
  (write-byte (stderr) (: 10 u8))
  (mtr/mtrace-mem-report-once!)
  (cga.exit (: 1 i32))
  0)

(defn cga-fail2 [(msg (slice u8)) (what (slice u8))] (-> i64)
  (cga-fail (sconcat (alloc/malloc-allocator) msg what)))

(defstruct Arm64NativeErrors [])

(impl native/NativeErrors Arm64NativeErrors
  (native-fail [(self Arm64NativeErrors) (message (slice u8))] (-> i64)
    (cga-fail message))
  (native-fail2 [(self Arm64NativeErrors)
                 (message (slice u8))
                 (what (slice u8))] (-> i64)
    (cga-fail2 message what)))

(impl native/ConstantErrors Arm64NativeErrors
  (native-user-fail [(self Arm64NativeErrors) (message (slice u8))] (-> i64)
    (g-user-fail message)))

; The view borrows the target's existing layout database, frame cursor and loop
; stack. Mutations therefore remain visible to the target emitter immediately.
(defn native-context [(g (ptr Cga))]
  (-> (native/NativeContext Arm64NativeErrors))
  (native/NativeContext
    :a (.a g)
    :layouts (field g layouts)
    :frame (field g frame)
    :loops (field g loops)
    :errors (zeroed Arm64NativeErrors)))

; ---- shared type layout ----------------------------------------------------
(defn g-struct-idx [(g (ptr Cga)) (name (slice u8))] (-> i64)
  (struct-index (field g layouts) name))

(defn g-sum-idx [(g (ptr Cga)) (name (slice u8))] (-> i64)
  (sum-index (field g layouts) name))

(defn g-sig-idx [(g (ptr Cga)) (name (slice u8))] (-> i64)
  (if (= (len (.sig_memo g)) 0)
      (match (get (.sig_index g) name) (Some [index] index) (None [] -1))
      (let [m (name-memo-slot (field g sig_memo) name)]
        (if (name-memo-hit? m name)
            (.val m)
            (match (get (.sig_index g) name)
              (Some [index]
                    (do (set! (.key m) name) (set! (.val m) index) index))
              (None [] -1))))))

(defn ty-align [(g (ptr Cga)) (t (ptr Type))] (-> i64)
  (align (field g layouts) t))

(defn ty-size [(g (ptr Cga)) (t (ptr Type))] (-> i64)
  (size (field g layouts) t))

(defn g-field-off [(g (ptr Cga)) (si i64) (fi i64)] (-> i64)
  (field-offset (field g layouts) si fi))

(defn g-field-idx [(g (ptr Cga)) (si i64) (name (slice u8))] (-> i64)
  (field-number (field g layouts) si name))

(defn g-field-ty [(g (ptr Cga)) (si i64) (fi i64)] (-> (ptr Type))
  (field (al-at [Field]
                (load (field (al-at [StructDef]
                                    (load (field (.program g) structs))
                                    si)
                             fields))
                fi)
         ty))

(defn g-type-bytes [(g (ptr Cga)) (t (ptr Type))] (-> i64)
  (type-bytes (field g layouts) t))

(defn g-sum-words-def [(g (ptr Cga)) (variants (ptr (ArrayList Variant)))]
  (-> i64)
  (sum-words (field g layouts) variants))

(defn g-natural-off [(g (ptr Cga)) (fields (ptr (ArrayList Field))) (fi i64)]
  (-> i64)
  (natural-offset (field g layouts) fields fi))

(defn g-variant-idx [(g (ptr Cga)) (su i64) (name (slice u8))] (-> i64)
  (variant-number (field g layouts) su name))

(defn g-register-types! [(g (ptr Cga)) (mp (ptr Program))] (-> i64)
  (set! (.layouts g) (LayoutDb::new (.a g) mp "cga64" 8 8))
  0)

; ============================ program registration ===========================
; extern "io.write" links against C symbol "_write" (last dot component).

(defn g-mangle [(g (ptr Cga)) (nm (slice u8))] (-> (slice u8))
  (text/format (.a g) "_{}" nm))

; the C symbol a function is exported under, or None. Mirrors codegen.coil's
; cg-export-find: an (export-c …) entry pins the function's public symbol. On this
; AAPCS64-native backend no thunk is needed — the function itself is emitted under
; this symbol with external linkage (see g-register-sigs!). ExportC.symbol is always
; Some by codegen time (check.coil fills the default bare-name symbol when :as is
; omitted).
; A name this unit publishes for other units to `declare` and link against.
(defn g-unit-export? [(g (ptr Cga)) (name (slice u8))] (-> bool)
  (contains? (.unit_export_index g) name))

;;; The function a `fnptr-of` names: a function with a by-value C entry is pointed
;;; at through its thunk, whose `c` signature takes the structs by value as the
;;; pointer's type says.
(defn g-fnptr-target [(g (ptr Cga)) (name (slice u8))] (-> (slice u8))
  (let [thunk (export-c-thunk-name (.a g) name)]
    (if (>= (g-sig-idx g thunk) 0) thunk name)))

(defn g-export-c-sym [(g (ptr Cga)) (name (slice u8))] (-> (Option (slice u8)))
  (get (.export_symbol_index g) name))

; register every extern + func as a GSig with a Mach-O symbol.
(defn g-register-sigs! [(g (ptr Cga)) (mp (ptr Program))] (-> i64)
  (let [origins (load (field mp mono_origins))]
    (for [k 0 (len (load origins))]
      (set! (mut (.spec_names g))
            (.generated (elem origins k))
            true)
      0))
  (let [es (load (field mp externs))
        n (len (load es))
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (let [ed (al-at [Extern] es (load i))
                      ; A symbol this program defines is not an undefined import: the
                      ; extern is bound to that definition once the functions are registered.
                      sym
                        (match (export-c-interposer mp (extern-link-name ed))
                          (Some [_] -1)
                          (None []
                                (mobj-add-sym! (mut (.obj g))
                                               (g-mangle g
                                                         (extern-link-name ed))
                                               0
                                               0
                                               true)))
                      (mut e) (zeroed GSig)]
                  (set! (.name e)
                        (.name ed))
                  (set! (.params e)
                        (load (field ed params)))
                  (set! (.ret e)
                        (.ret ed))
                  (set! (.variadic e)
                        (.variadic ed))
                  (set! (.symidx e)
                        sym)
                  (set! (.shim e)
                        false)
                  (set! (.implsym e)
                        -1)
                  (set! (.shimregs e)
                        (box-al [i64]
                                (.a g)
                                (ArrayList::new [i64]
                                                (.a g))))
                  (set! (.shimret e)
                        0)
                  (set! (.func e)
                        (primitive/cast (ptr Func) 0))
                  (set! (.inline_policy e)
                        (None))
                  ; duplicate extern declarations across modules are expected; keep the first
                  (when (< (g-sig-idx g (.name ed))
                           0)
                    (push! (mut (.sigs g))
                           e)
                    (set! (mut (.sig_index g))
                          (.name ed)
                          (primitive/isub (len (.sigs g)) 1))
                    0))
                (set! i (primitive/iadd (load i) 1))))))
  (let [fs (load (field mp funcs))
        n (len (load fs))
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (let [fd (al-at [Func] fs (load i))
                      expsym (g-export-c-sym g (.name fd))
                      ; an exported function is emitted directly under its C symbol with
                      ; external linkage; otherwise the mangled Coil name, external only
                      ; for a program's main (a unit has no process entry) and for a
                      ; name this unit publishes for other units.
                      ext
                        (or (and (not (.unit_build mp)) (= (.name fd) "main"))
                            (match expsym (Some [s] true) (None [] false))
                            (g-unit-export? g (.name fd)))
                      symname (match expsym (Some [s] s) (None [] (.name fd)))
                      ; A `declare`d function has no body here: another unit's
                      ; object defines it. Register it the way an extern is
                      ; registered, undefined and external, so a call becomes a
                      ; relocation the linker resolves.
                      sym
                        (if (.declared fd)
                            (mobj-add-sym! (mut (.obj g))
                                           (g-mangle g symname)
                                           0
                                           0
                                           true)
                            (mobj-add-sym! (mut (.obj g))
                                           (g-mangle g symname)
                                           (.text g)
                                           0
                                           ext))
                      (mut ptys) (ArrayList::new [Type] (.a g))
                      (mut e) (zeroed GSig)]
                  (let [ps (load (field fd params))
                        np (len (load ps))
                        (mut j) 0]
                    (loop (if (>= (load j) np)
                              (break)
                              (do
                                (push! (mut ptys)
                                       (.ty (al-at [Param] ps (load j))))
                                (set! j (primitive/iadd (load j) 1))))))
                  (set! (.name e)
                        (.name fd))
                  (set! (.params e)
                        (box-al [Type] (.a g) (load ptys)))
                  (set! (.ret e)
                        (.ret fd))
                  (set! (.variadic e)
                        false)
                  (set! (.symidx e)
                        sym)
                  (set! (.shim e)
                        false)
                  (set! (.implsym e)
                        -1)
                  (set! (.shimregs e)
                        (box-al [i64]
                                (.a g)
                                (ArrayList::new [i64]
                                                (.a g))))
                  (set! (.shimret e)
                        0)
                  (set! (.func e)
                        fd)
                  (set! (.inline_policy e)
                        (func-inline-policy fd))
                  ; a :shim-convention function is realized as <name>__impl + trampoline
                  (let [ci (g-conv-idx g (cc-identity (.cc fd)))]
                    (when (>= ci 0)
                      (match (.lowering (al-at [Convention]
                                               (load (field g convs))
                                               ci))
                        (LShim []
                               (let [cv
                                       (al-at [Convention]
                                              (load (field g convs))
                                              ci)
                                     (mut regs) (ArrayList::new [i64] (.a g))
                                     prs (load (field cv params))
                                     npr (len (load prs))]
                                 (for [j 0 npr]
                                   (push! (mut regs)
                                          (g-parse-xreg g
                                                        (get (load prs)
                                                             j))))
                                 (set! (.shim e)
                                       true)
                                 (set! (.shimregs e)
                                       (box-al [i64]
                                               (.a g)
                                               (load regs)))
                                 (set! (.shimret e)
                                       (match (.ret cv)
                                         (Some [r] (g-parse-xreg g r))
                                         (None [] 0)))
                                 (set! (.shimsave e)
                                       (g-shim-clobbers-frame? g cv))
                                 (set! (.inline_code e)
                                       (g-inline-machine-code g fd))
                                 ; machine code is the Coil-named symbol itself:
                                 ; it has no __impl and no trampoline
                                 (set! (.implsym e)
                                       (match (func-machine-code fd)
                                         (Some [_] -1)
                                         (None []
                                               (mobj-add-sym! (mut (.obj g))
                                                              (g-mangle g
                                                                        (text/format (.a g)
                                                                                     "{}__impl"
                                                                                     (.name fd)))
                                                              (.text g)
                                                              0
                                                              false))))
                                 0))
                        (LNative [_] 0)
                        (LReset [] 0)
                        (LowerWritten [_]
                                      (panic "codegen: convention '{}' was never resolved"
                                             (cc-identity (.cc fd)))))))
                  (push! (mut (.sigs g))
                         e)
                  (set! (mut (.sig_index g))
                        (.name fd)
                        (primitive/isub (len (.sigs g)) 1)))
                (set! i (primitive/iadd (load i) 1))))))

  ; Bind each interposed extern to the function that defines its symbol. The
  ; extern keeps its own declared signature, as any extern does.
  (for i (range 0 (len (load (field mp externs))))
    (let [ed (al-at [Extern] (load (field mp externs)) i)]
      (match (export-c-interposer mp (extern-link-name ed))
        (Some [fname]
              (let [ei (g-sig-idx g (.name ed))
                    fi (g-sig-idx g fname)]
                (when (or (< ei 0) (< fi 0))
                  (cga-fail2 "extern bound to an exported function that has no signature: "
                             (.name ed)))
                (set! (.symidx (al-at [GSig] (field g sigs) ei))
                      (.symidx (al-at [GSig] (field g sigs) fi)))))
        (None [] 0))))
  0)

(defn g-conv-idx [(g (ptr Cga)) (nm (slice u8))] (-> i64)
  (let [cs (load (field g convs))
        n (len (load cs))
        (mut r) -1]
    (for [i 0 n]
      (when (= (.name (al-at [Convention] cs i))
               nm)
        (set! r i)))
    (load r)))

; Whether a :shim convention lets its callee change x28 (the slot base) or x29
; (the frame pointer), which its call sites then save around the call. The
; stack pointer cannot be clobbered: nothing could find the frame afterwards.
(defn g-shim-clobbers-frame? [(g (ptr Cga)) (cv (ptr Convention))] (-> bool)
  (let [cl (load (field cv clobber))
        (mut hit) false]
    (for j (range 0 (len (load cl)))
      (let [r (get (load cl) j)]
        (when (= r "sp")
          (cga-fail2 "a shim convention cannot clobber the stack pointer: " r))
        (when (or (= r "x28") (= r "x29") (= r "fp")) (set! hit true))))
    (load hit)))

; The bytes FD's call sites hold in place of a call, for machine code its
; callers inline; else empty.
(defn g-inline-machine-code [(g (ptr Cga)) (fd (ptr Func))] (-> (slice u8))
  (match (func-machine-code fd)
    (Some [code]
          (if (func-machine-code-inlined? fd)
              (slice (load (.bytes code)))
              ""))
    (None [] "")))

; An x86-64 GPR name -> its number, or -1. The tpde backend lays out x86-64
; modules with this file's machinery; the checker validated the names for the
; target, so an x86 name only reaches here when targeting x86-64.
(defn x86-gpr-num [(r (slice u8))] (-> i64)
  (case r
    "rax" 0
    "rcx" 1
    "rdx" 2
    "rbx" 3
    "rsp" 4
    "rbp" 5
    "rsi" 6
    "rdi" 7
    "r8" 8
    "r9" 9
    "r10" 10
    "r11" 11
    "r12" 12
    "r13" 13
    "r14" 14
    "r15" 15
    -1))

; "x20" -> 20 (shim conventions name GPRs as xN; validated by the checker)
(defn g-parse-xreg [(g (ptr Cga)) (r (slice u8))] (-> i64)
  (if (>= (x86-gpr-num r) 0)
      ; rsp and rbp hold the frame; r11 is tpde's scratch register
      (if (or (= r "rsp") (= r "rbp") (= r "r11"))
          (cga-fail2 "shim register collides with backend-reserved registers: "
                     r)
          (x86-gpr-num r))
      (if (or (= r "lr") (= r "x30"))
          30
          (if (!= (primitive/cast i64 (get r 0)) 120)
              (cga-fail2 "shim register is not an x-register: " r)
              (let [v (str->i64 (subslice r 1 (len r)))]
                (if (or (>= v 28)
                        (and (>= v 16)
                             (<= v 17)))
                    (cga-fail2 "shim register collides with backend-reserved registers: "
                               r)
                    v))))))

; set a defined symbol's section offset once known (function start / global).
(defn mobj-set-sym! [(o (ptr MObj)) (idx i64) (sect i64) (off i64)] (-> i64)
  (let [sp (al-at [MSym] (field o syms) idx)]
    (set! (.sect sp) sect)
    (set! (.off sp) off)
    0))

; ============================ frame / slots ==================================

(defn slot-for-ty! [(g (ptr Cga)) (t (ptr Type))] (-> i64)
  (slot-new! (native-context g) (ty-size g t) (ty-align g t)))

; x28 + off into `reg` (single add when the offset fits imm12).
(defn emit-slot-addr! [(g (ptr Cga)) (reg i64) (off i64)] (-> i64)
  (let [s (field g asm)]
    (if (<= off 4095)
        (a64-w! (mut s) (a64-add-imm reg 28 off))
        (do
          (a64-mov-imm! (mut s) reg off)
          (a64-w! (mut s) (a64-add-reg reg 28 reg))
          0))))

; `rd = sp + outbytes`: two placeholder adds, patched with the function's final
; outgoing-args size (up to 24 bits) after its body is emitted.
(defn emit-out-addr! [(g (ptr Cga)) (rd i64)] (-> i64)
  (let [s (field g asm)]
    (push! (mut (.outfixes g)) (OutFix :off (a64-off (mut s)) :rd rd))
    (a64-w! (mut s) (a64-add-imm-lsl12 rd 31 0))
    (a64-w! (mut s) (a64-add-imm rd rd 0))))

; `rd = base + off` for any base (31 = sp) and any non-negative offset: the loads
; and stores below fall back to this when the offset is past their immediate.
(defn emit-base-addr! [(g (ptr Cga)) (rd i64) (base i64) (off i64)] (-> i64)
  (let [s (field g asm)]
    (if (<= off 4095)
        (a64-w! (mut s) (a64-add-imm rd base off))
        (do
          (a64-mov-imm! (mut s) rd off)
          (a64-w! (mut s) (a64-add-ext rd base rd))))))

; str x`reg`, [sp + off]: a whole 8-byte outgoing stack slot.
(defn emit-sp-str-x! [(g (ptr Cga)) (reg i64) (off i64)] (-> i64)
  (emit-store-int! g reg 31 off 8))

; Copy exactly `n` bytes from [sbase + soff] to [dbase + doff] through x9, widest
; chunks first, so a packed stack argument never writes past its own bytes.
(defn emit-copy-exact! [(g (ptr Cga))
                        (dbase i64)
                        (doff i64)
                        (sbase i64)
                        (soff i64)
                        (n i64)] (-> i64)
  (let [(mut k) 0]
    (loop (if (>= k n)
              (break)
              (let [left (- n k)
                    w (cond (>= left 8) 8 (>= left 4) 4 (>= left 2) 2 :else 1)]
                (emit-load-int! g 9 sbase (+ soff k) w false)
                (emit-store-int! g 9 dbase (+ doff k) w)
                (set! k (+ k w)))))
    0))

;;; A register-class aggregate's stack alignment: 8-byte words, or 16 when the
;;; type itself is 16-aligned.
(defn a64-aggregate-stack-align [(g (ptr Cga)) (t (ptr Type))] (-> i64)
  (if (>= (ty-align g t) 16) 16 8))

; Apple AArch64 stack placement for a NAMED argument: scalars and each float of
; a homogeneous float aggregate at their natural size and alignment (an i32
; takes 4 bytes), other aggregates in 8-byte-aligned words (16 when the type is
; 16-aligned). Variadic arguments do not come here: they take 8-byte slots.
; Returns the argument's offset and advances `stk` past it.
(defn a64-named-stack-place! [(stk (ptr i64)) (size i64) (align i64)] (-> i64)
  (let [off (* (/ (+ (load stk) (- align 1)) align) align)]
    (set! stk (+ off size))
    off))

; can a scaled-u12 load/store reach offset `off` at scale `sz`?
(defn ldst-fits [(off i64) (sz i64)] (-> bool)
  (and (= (primitive/urem off sz) 0)
       (<= (/ off sz) 4095)))

; load an int/ptr/bool slot into x-reg `reg`, extending per width+signedness.
; base register `base` (usually 28).
(defn emit-load-int! [(g (ptr Cga))
                      (reg i64)
                      (base i64)
                      (off i64)
                      (bytes i64)
                      (signed bool)] (-> i64)
  (let [s (field g asm)]
    (cond (= bytes 1)
            (if (ldst-fits off 1)
                (a64-w! (mut s)
                        (if signed
                            (a64-ldrsb-x reg base off)
                            (a64-ldr-b reg base off)))
                (do
                  (emit-base-addr! g 16 base off)
                  (a64-w! (mut s)
                          (if signed
                              (a64-ldrsb-x reg 16 0)
                              (a64-ldr-b reg 16 0)))))
          (= bytes 2)
            (if (ldst-fits off 2)
                (a64-w! (mut s)
                        (if signed
                            (a64-ldrsh-x reg base off)
                            (a64-ldr-h reg base off)))
                (do
                  (emit-base-addr! g 16 base off)
                  (a64-w! (mut s)
                          (if signed
                              (a64-ldrsh-x reg 16 0)
                              (a64-ldr-h reg 16 0)))))
          (= bytes 4)
            (if (ldst-fits off 4)
                (a64-w! (mut s)
                        (if signed
                            (a64-ldrsw-x reg base off)
                            (a64-ldr-w reg base off)))
                (do
                  (emit-base-addr! g 16 base off)
                  (a64-w! (mut s)
                          (if signed
                              (a64-ldrsw-x reg 16 0)
                              (a64-ldr-w reg 16 0)))))
          (ldst-fits off 8) (a64-w! (mut s) (a64-ldr-x reg base off))
          :else
            (do
              (emit-base-addr! g 16 base off)
              (a64-w! (mut s) (a64-ldr-x reg 16 0))))))

; store x-reg `reg` into a slot, truncating to the slot width.
(defn emit-store-int! [(g (ptr Cga)) (reg i64) (base i64) (off i64) (bytes i64)]
  (-> i64)
  (let [s (field g asm)]
    (cond (= bytes 1)
            (if (ldst-fits off 1)
                (a64-w! (mut s) (a64-str-b reg base off))
                (do
                  (emit-base-addr! g 16 base off)
                  (a64-w! (mut s) (a64-str-b reg 16 0))))
          (= bytes 2)
            (if (ldst-fits off 2)
                (a64-w! (mut s) (a64-str-h reg base off))
                (do
                  (emit-base-addr! g 16 base off)
                  (a64-w! (mut s) (a64-str-h reg 16 0))))
          (= bytes 4)
            (if (ldst-fits off 4)
                (a64-w! (mut s) (a64-str-w reg base off))
                (do
                  (emit-base-addr! g 16 base off)
                  (a64-w! (mut s) (a64-str-w reg 16 0))))
          (ldst-fits off 8) (a64-w! (mut s) (a64-str-x reg base off))
          :else
            (do
              (emit-base-addr! g 16 base off)
              (a64-w! (mut s) (a64-str-x reg 16 0))))))

; float slot <-> d/s register
(defn emit-load-fp! [(g (ptr Cga)) (dreg i64) (base i64) (off i64) (bytes i64)]
  (-> i64)
  (let [s (field g asm)]
    (if (= bytes 4)
        (if (ldst-fits off 4)
            (a64-w! (mut s) (a64-ldr-s dreg base off))
            (do
              (emit-base-addr! g 16 base off)
              (a64-w! (mut s) (a64-ldr-s dreg 16 0))))
        (if (ldst-fits off 8)
            (a64-w! (mut s) (a64-ldr-d dreg base off))
            (do
              (emit-base-addr! g 16 base off)
              (a64-w! (mut s) (a64-ldr-d dreg 16 0)))))))

(defn emit-store-fp! [(g (ptr Cga)) (dreg i64) (base i64) (off i64) (bytes i64)]
  (-> i64)
  (let [s (field g asm)]
    (if (= bytes 4)
        (if (ldst-fits off 4)
            (a64-w! (mut s) (a64-str-s dreg base off))
            (do
              (emit-base-addr! g 16 base off)
              (a64-w! (mut s) (a64-str-s dreg 16 0))))
        (if (ldst-fits off 8)
            (a64-w! (mut s) (a64-str-d dreg base off))
            (do
              (emit-base-addr! g 16 base off)
              (a64-w! (mut s) (a64-str-d dreg 16 0)))))))

; is a type an int-like scalar (lives in x regs)? floats live in d/s.

(defn ty-is-scalar [(t (ptr Type))] (-> bool)
  (match (load t)
    ; an integer wider than 64 bits lives in memory (see ty-wide-int?)
    (TInt [bits _] (<= bits 64))
    (TBool [] true)
    (TPtr [_] true)
    (TRef [_ _] true)
    (TFn [_ _ _] true)
    (TNever [] true)
    (TFloat [_] true)
    (TStruct [nm] false)
    (_ false)))

; load an AVal into x-reg `reg` (int-like values only).
(defn av-to-x! [(g (ptr Cga)) (av AVal) (reg i64)] (-> i64)
  (let [k (av-kind av)
        (mut t) (av-ty av)]
    (when (and (= k 1) (ty-wide-int? (mut t)))
      (cga-fail "internal: a 128-bit integer read into one register")
      0)
    (if (or (= k 0)
            (= k 2))
        (a64-mov-imm! (mut (.asm g)) reg (av-v av))
        ; raw f64 bits as int
        (let [(mut bytes) (zeroed i64)
              (mut signed) (zeroed bool)]
          (ty-int-info (mut t) (mut bytes) (mut signed))
          (if (ty-is-float (mut t))
              (emit-load-int! g
                              reg
                              28
                              (av-v av)
                              (ty-float-bytes (mut t))
                              false)
              (emit-load-int! g reg 28 (av-v av) bytes signed))))))

; load an AVal into fp reg `dreg` (float values only).
(defn av-to-d! [(g (ptr Cga)) (av AVal) (dreg i64)] (-> i64)
  (let [k (av-kind av)
        (mut t) (av-ty av)]
    (if (= k 2)
        (do
          (a64-mov-imm! (mut (.asm g)) 16 (av-v av))
          (a64-w! (mut (.asm g)) (a64-fmov-x-to-fp dreg 16))
          0)
        (if (= k 1)
            (emit-load-fp! g dreg 28 (av-v av) (ty-float-bytes (mut t)))
            (cga-fail "av-to-d!: int immediate where float expected")))))

; materialize an AVal into a slot; returns the slot offset.
(defn av-slot! [(g (ptr Cga)) (av AVal)] (-> i64)
  (if (= (av-kind av) 1)
      (av-v av)
      (let [(mut t) (av-ty av)]
        (let [off
                (slot-for-ty! g
                              (mut t))
              size
                (ty-size g
                         (mut t))]
          ; An immediate is an i64. A wider slot (the i128 llvm-ir marker type)
          ; gets the value in its low word and the value's sign extension in
          ; every byte above it, so no byte of the slot is left uninitialized.
          (a64-mov-imm! (mut (.asm g)) 9 (av-v av))
          (emit-store-int! g 9 28 off (if (> size 8) 8 size))
          (when (> size 8)
            (a64-mov-imm! (mut (.asm g)) 9 (if (< (av-v av) 0) -1 0))
            (let [(mut at) 8]
              (while (< at size)
                (let [chunk
                        (cond (>= (- size at) 8) 8
                              (>= (- size at) 4) 4
                              (>= (- size at) 2) 2
                              :else 1)]
                  (emit-store-int! g 9 28 (+ off at) chunk)
                  (set! at (+ at chunk))))))
          off))))

; copy `size` bytes between slots (x28-relative), through x9 (+x16/x17 for
; big-offset addressing). Unrolled words for small sizes, byte loop for huge.
(defn emit-copy! [(g (ptr Cga)) (dst i64) (src i64) (size i64)] (-> i64)
  (let [s (field g asm)]
    (if (<= size 256)
        (let [(mut k) 0]
          (loop (if (>= (primitive/iadd (load k) 8) (primitive/iadd size 1))
                    (break)
                    (do
                      (emit-load-int! g
                                      9
                                      28
                                      (primitive/iadd src (load k))
                                      8
                                      false)
                      (emit-store-int! g 9 28 (primitive/iadd dst (load k)) 8)
                      (set! k (primitive/iadd (load k) 8)))))
          ; remainder: 4/2/1 byte chunks
          (when (<= (primitive/iadd (load k) 4) size)
            (emit-load-int! g 9 28 (primitive/iadd src (load k)) 4 false)
            (emit-store-int! g 9 28 (primitive/iadd dst (load k)) 4)
            (set! k (primitive/iadd (load k) 4))
            0)
          (when (<= (primitive/iadd (load k) 2) size)
            (emit-load-int! g 9 28 (primitive/iadd src (load k)) 2 false)
            (emit-store-int! g 9 28 (primitive/iadd dst (load k)) 2)
            (set! k (primitive/iadd (load k) 2))
            0)
          (when (<= (primitive/iadd (load k) 1) size)
            (emit-load-int! g 9 28 (primitive/iadd src (load k)) 1 false)
            (emit-store-int! g 9 28 (primitive/iadd dst (load k)) 1)
            (set! k (primitive/iadd (load k) 1))
            0)
          0)
        ; big: byte loop  x10=i, x11=srcbase, x12=dstbase
        (do
          (emit-slot-addr! g 11 src)
          (emit-slot-addr! g 12 dst)
          (a64-mov-imm! (mut s) 10 0)
          (a64-mov-imm! (mut s) 13 size)
          (let [ltop (a64-new-label (mut s))
                lend (a64-new-label (mut s))]
            (a64-bind-label! (mut s) ltop)
            (a64-w! (mut s) (a64-cmp-reg 10 13))
            (a64-bcond-label! (mut s) (cond-ge) lend)
            (a64-w! (mut s) (a64-ldst-roff 0 0 1 9 11 10))  ; ldrb x9,[x11,x10]
            (a64-w! (mut s) (a64-ldst-roff 0 0 0 9 12 10))  ; strb x9,[x12,x10]
            (a64-w! (mut s) (a64-add-imm 10 10 1))
            (a64-b-label! (mut s) ltop)
            (a64-bind-label! (mut s) lend))
          0))))

; copy `size` bytes from a slot to memory addressed by x-reg `dstreg`, and the
; reverse. Byte loops via register-offset addressing (x10 idx, x9 data).
; NOTE: the data register is x14 — callers pass the ADDRESS in x9.
; slot -> slot, both x28-relative. 8-byte chunks then a byte tail, so an odd size
; (a packed struct) is copied correctly rather than rounded.
(defn emit-copy-slot! [(g (ptr Cga)) (dst i64) (src i64) (size i64)] (-> i64)
  (let [(mut k) 0]
    (loop (if (> (primitive/iadd (load k) 8) size)
              (break)
              (do
                (emit-load-int! g 14 28 (primitive/iadd src (load k)) 8 false)
                (emit-store-int! g 14 28 (primitive/iadd dst (load k)) 8)
                (set! k (primitive/iadd (load k) 8)))))
    (loop (if (>= (load k) size)
              (break)
              (do
                (emit-load-int! g 14 28 (primitive/iadd src (load k)) 1 false)
                (emit-store-int! g 14 28 (primitive/iadd dst (load k)) 1)
                (set! k (primitive/iadd (load k) 1)))))
    0))

(defn emit-copy-to-mem! [(g (ptr Cga)) (dstreg i64) (src i64) (size i64)]
  (-> i64)
  (let [s (field g asm)]
    (if (<= size 64)
        (let [(mut k) 0]
          (loop (if (>= (primitive/iadd (load k) 8) (primitive/iadd size 1))
                    (break)
                    (do
                      (emit-load-int! g
                                      14
                                      28
                                      (primitive/iadd src (load k))
                                      8
                                      false)
                      (a64-w! (mut s) (a64-str-x 14 dstreg (load k)))
                      (set! k (primitive/iadd (load k) 8)))))
          (when (<= (primitive/iadd (load k) 4) size)
            (emit-load-int! g 14 28 (primitive/iadd src (load k)) 4 false)
            (a64-w! (mut s) (a64-str-w 14 dstreg (load k)))
            (set! k (primitive/iadd (load k) 4))
            0)
          (when (<= (primitive/iadd (load k) 2) size)
            (emit-load-int! g 14 28 (primitive/iadd src (load k)) 2 false)
            (a64-w! (mut s) (a64-str-h 14 dstreg (load k)))
            (set! k (primitive/iadd (load k) 2))
            0)
          (when (<= (primitive/iadd (load k) 1) size)
            (emit-load-int! g 14 28 (primitive/iadd src (load k)) 1 false)
            (a64-w! (mut s) (a64-str-b 14 dstreg (load k)))
            (set! k (primitive/iadd (load k) 1))
            0)
          0)
        (do
          (emit-slot-addr! g 11 src)
          (a64-mov-imm! (mut s) 10 0)
          (a64-mov-imm! (mut s) 13 size)
          (let [ltop (a64-new-label (mut s))
                lend (a64-new-label (mut s))]
            (a64-bind-label! (mut s) ltop)
            (a64-w! (mut s) (a64-cmp-reg 10 13))
            (a64-bcond-label! (mut s) (cond-ge) lend)
            (a64-w! (mut s) (a64-ldst-roff 0 0 1 14 11 10))
            (a64-w! (mut s) (a64-ldst-roff 0 0 0 14 dstreg 10))
            (a64-w! (mut s) (a64-add-imm 10 10 1))
            (a64-b-label! (mut s) ltop)
            (a64-bind-label! (mut s) lend))
          0))))

; NOTE: the data register is x14 — callers pass the ADDRESS in x9.
(defn emit-copy-from-mem! [(g (ptr Cga)) (dst i64) (srcreg i64) (size i64)]
  (-> i64)
  (let [s (field g asm)]
    (if (<= size 64)
        (let [(mut k) 0]
          (loop (if (>= (primitive/iadd (load k) 8) (primitive/iadd size 1))
                    (break)
                    (do
                      (a64-w! (mut s) (a64-ldr-x 14 srcreg (load k)))
                      (emit-store-int! g 14 28 (primitive/iadd dst (load k)) 8)
                      (set! k (primitive/iadd (load k) 8)))))
          (when (<= (primitive/iadd (load k) 4) size)
            (a64-w! (mut s) (a64-ldr-w 14 srcreg (load k)))
            (emit-store-int! g 14 28 (primitive/iadd dst (load k)) 4)
            (set! k (primitive/iadd (load k) 4))
            0)
          (when (<= (primitive/iadd (load k) 2) size)
            (a64-w! (mut s) (a64-ldr-h 14 srcreg (load k)))
            (emit-store-int! g 14 28 (primitive/iadd dst (load k)) 2)
            (set! k (primitive/iadd (load k) 2))
            0)
          (when (<= (primitive/iadd (load k) 1) size)
            (a64-w! (mut s) (a64-ldr-b 14 srcreg (load k)))
            (emit-store-int! g 14 28 (primitive/iadd dst (load k)) 1)
            (set! k (primitive/iadd (load k) 1))
            0)
          0)
        (do
          (emit-slot-addr! g 12 dst)
          (a64-mov-imm! (mut s) 10 0)
          (a64-mov-imm! (mut s) 13 size)
          (let [ltop (a64-new-label (mut s))
                lend (a64-new-label (mut s))]
            (a64-bind-label! (mut s) ltop)
            (a64-w! (mut s) (a64-cmp-reg 10 13))
            (a64-bcond-label! (mut s) (cond-ge) lend)
            (a64-w! (mut s) (a64-ldst-roff 0 0 1 14 srcreg 10))
            (a64-w! (mut s) (a64-ldst-roff 0 0 0 14 12 10))
            (a64-w! (mut s) (a64-add-imm 10 10 1))
            (a64-b-label! (mut s) ltop)
            (a64-bind-label! (mut s) lend))
          0))))

; ============================ zeroing ========================================
(defn emit-zero! [(g (ptr Cga)) (dst i64) (size i64)] (-> i64)
  (let [s (field g asm)]
    (if (<= size 256)
        (let [(mut k) 0]
          (loop (if (>= (primitive/iadd (load k) 8) (primitive/iadd size 1))
                    (break)
                    (do
                      (emit-store-int! g 31 28 (primitive/iadd dst (load k)) 8)  ; str xzr
                      (set! k (primitive/iadd (load k) 8)))))
          (when (<= (primitive/iadd (load k) 4) size)
            (emit-store-int! g 31 28 (primitive/iadd dst (load k)) 4)
            (set! k (primitive/iadd (load k) 4))
            0)
          (when (<= (primitive/iadd (load k) 2) size)
            (emit-store-int! g 31 28 (primitive/iadd dst (load k)) 2)
            (set! k (primitive/iadd (load k) 2))
            0)
          (when (<= (primitive/iadd (load k) 1) size)
            (emit-store-int! g 31 28 (primitive/iadd dst (load k)) 1)
            (set! k (primitive/iadd (load k) 1))
            0)
          0)
        (do
          (emit-slot-addr! g 12 dst)
          (a64-mov-imm! (mut s) 10 0)
          (a64-mov-imm! (mut s) 13 size)
          (let [ltop (a64-new-label (mut s))
                lend (a64-new-label (mut s))]
            (a64-bind-label! (mut s) ltop)
            (a64-w! (mut s) (a64-cmp-reg 10 13))
            (a64-bcond-label! (mut s) (cond-ge) lend)
            (a64-w! (mut s) (a64-ldst-roff 0 0 0 31 12 10))  ; strb wzr,[x12,x10]
            (a64-w! (mut s) (a64-add-imm 10 10 1))
            (a64-b-label! (mut s) ltop)
            (a64-bind-label! (mut s) lend))
          0))))

; ============================ ABI classification =============================
; classes: 0 = int-like scalar (x reg), 1 = float scalar (d/s reg),
;          2 = aggregate <= 8B (one x reg), 3 = aggregate <= 16B (x pair),
;          4 = aggregate > 16B (indirect), 5 = HFA (hfa_n regs of hfa_bits)
(defstruct AbiInfo [(cls i64) (hfa_n i64) (hfa_bits i64)])

; HFA walk: count uniform float leaves; returns leaf count or -1 (not an HFA).
; bitsp receives the leaf width. Mirrors abi-hfa in codegen.coil.
(defn g-hfa-walk [(g (ptr Cga)) (t (ptr Type)) (bitsp (ptr i64))] (-> i64)
  (match (load t)
    (TFloat [bits]
            (if (= (load bitsp) 0)
                (do (set! bitsp bits) 1)
                (if (= (load bitsp) bits) 1 -1)))
    (TArray [elem n-extent]
            (let [n (extent-value n-extent)]
              (let [inner (g-hfa-walk g elem bitsp)]
                (if (< inner 0)
                    -1
                    (primitive/imul inner n)))))
    (TStruct [nm]
             (let [si (g-struct-idx g nm)]
               (if (< si 0)
                   -1
                   (g-hfa-walk-record g si bitsp))))
    (_ -1)))

; Count a record's distinct float storage groups. Explicit-layout records from
; cimport are just as ABI-visible as natural C layouts. Equal-offset fields are
; union alternatives: they must agree on the float width and contribute the
; largest alternative, rather than being counted twice. This mirrors the LLVM
; backend's abi-hfa-walk-record.
(defn g-hfa-walk-record [(g (ptr Cga))
                         (si i64)
                         (bitsp (ptr i64))] (-> i64)
  (let [fs (load (field (struct-at (field g layouts) si) fields))
        positions (primitive/alloc-stack (array i64 4))
        sizes (primitive/alloc-stack (array i64 4))
        (mut groups) 0
        (mut total) 0
        (mut ok) true]
    (for [i 0 (len (load fs))]
      (when (load ok)
        (let [part
                (g-hfa-walk g
                            (field (al-at [Field] fs i) ty)
                            bitsp)]
          (if (< part 0)
              (set! ok false)
              (when (> part 0)
                (let [offset (field-offset (field g layouts) si i)
                      (mut group) -1]
                  (for [j 0 (load groups)]
                    (when (= (load (index positions j)) offset)
                      (set! group j)
                      0)
                    0)
                  (if (= (load group) -1)
                      (if (= (load groups) 4)
                          (set! ok false)
                          (do
                            (set! group (load groups))
                            (set! groups (primitive/iadd (load groups) 1))
                            (set! (index positions (load group))
                                  offset)
                            (set! (index sizes (load group)) 0)
                            0))
                      0)
                  (when (load ok)
                    (let [prior (load (index sizes (load group)))]
                      (when (> part prior)
                        (set! total
                              (primitive/iadd (load total)
                                              (primitive/isub part prior)))
                        (set! (index sizes (load group)) part)
                        0))
                    (when (> (load total) 4)
                      (set! ok false)
                      0)
                    0))))
          0))
      0)
    (if (load ok) (load total) -1)))

(defn g-abi-info [(g (ptr Cga)) (t (ptr Type))] (-> AbiInfo)
  (let [(mut r) (zeroed AbiInfo)]
    (set! (.hfa_n r)
          0)
    (set! (.hfa_bits r)
          0)
    (if (ty-is-scalar t)
        (do
          (set! (.cls r)
                (if (ty-is-float t) (do 1) 0))
          0)
        (let [(mut bitsp) 0]
          (let [hn
                  (g-hfa-walk g
                              t
                              (mut bitsp))]
            (if (and (>= hn 1)
                     (<= hn 4))
                (do
                  (set! (.cls r)
                        5)
                  (set! (.hfa_n r)
                        hn)
                  (set! (.hfa_bits r)
                        bitsp)
                  0)
                (let [sz (ty-size g t)]
                  (if (<= sz 8)
                      ; an empty struct is class 6: C passes and returns nothing for it
                      (do
                        (set! (.cls r)
                              (if (= sz 0) 6 2))
                        0)
                      (if (<= sz 16)
                          (do
                            (set! (.cls r)
                                  3)
                            0)
                          (do
                            (set! (.cls r)
                                  4)
                            0))))))))
    r))

(defn abi-cls [(x AbiInfo)] (-> i64)
  (let [(mut p) (: x AbiInfo)] (.cls p)))

(defn abi-hfa-n [(x AbiInfo)] (-> i64)
  (let [(mut p) (: x AbiInfo)] (.hfa_n p)))

(defn abi-hfa-bits [(x AbiInfo)] (-> i64)
  (let [(mut p) (: x AbiInfo)] (.hfa_bits p)))

(defn mk-abi-scalar [] (-> AbiInfo)
  (AbiInfo
    :cls 0
    :hfa_n 0
    :hfa_bits 0))

; ============================ calls ==========================================
; A by-value aggregate argument can arrive as the address of its storage: a value
; bound by `let` to a named constructor or another implicit place lowers to a
; pointer. Coil's own aggregate parameters are already pointers by this stage, so
; a non-scalar declared parameter is a C-convention one (an extern, an export-c
; entry or a C function pointer), and a pointer argument for it is that place.
; Pass the aggregate it points at, copied into a slot, as the LLVM backend does.
; Classifying the pointer instead sent its address in the struct's register.
(defn g-pass-places-by-value! [(g (ptr Cga))
                               (params (ptr (ArrayList Type)))
                               (avs (ptr (ArrayList AVal)))] (-> void)
  (let [n
          (if (< (len (load avs)) (len (load params)))
              (len (load avs))
              (len (load params)))]
    (for [i 0 n]
      (let [(mut pt) (get (load params) i)
            av (get (load avs) i)]
        (when (and (not (ty-is-scalar (mut pt)))
                   (match (av-ty av)
                     (TPtr [_] true)
                     (TRef [_ _] true)
                     (_ false)))
          (let [sz (ty-size g (mut pt))
                slot (slot-for-ty! g (mut pt))]
            (av-to-x! g av 9)
            (if (<= sz 8)
                (do
                  (emit-load-from-mem! g 10 9 sz)
                  (emit-store-int! g 10 28 slot sz)
                  0)
                (emit-copy-from-mem! g slot 9 sz))
            (set! avs i (mk-aval 1 slot pt))))))))

; One unified AAPCS64 (Apple) call emitter for direct calls (symidx >= 0),
; and indirect calls through a function-pointer AVal (symidx < 0).
; `params` = the callee's declared param types (named args); args beyond that
; are variadic (Apple: on the stack, 8-byte slots).
(defn emit-call! [(g (ptr Cga))
                  (symidx i64)
                  (fpav (ptr AVal))
                  (params (ptr (ArrayList Type)))
                  (variadic bool)
                  (ret Type)
                  (avs (ptr (ArrayList AVal)))] (-> AVal)
  (let [s (field g asm)
        a (.a g)
        nargs (len (load avs))
        nparams (len (load params))
        (mut retp)
          (: ret
             Type)]
    (g-pass-places-by-value! g params avs)
    ; ---- return classification
    (let [retvoid (match ret (TVoid [] true) (_ false))
          retinfo
            (if retvoid
                (mk-abi-scalar)
                (g-abi-info g
                            (mut retp)))
          ; indirect result slot (also the result home for by-value agg returns)
          resslot
            (if retvoid
                -1
                (slot-for-ty! g
                              (mut retp)))
          ; ---- plan: parallel lists per arg
          ; kinds: 0 xreg, 1 dreg, 2 xpair, 3 variadic stack slot, 4 indirect-xreg,
          ; 5 hfa-dregs, 6 indirect-stack, 7 named stack arg (exactly psize bytes),
          ; 8 nothing (an empty struct)
          (mut pkind) (ArrayList::new [i64] a)
          (mut pa) (ArrayList::new [i64] a)
          ; xreg#/dreg#/stack off
          (mut pslot) (ArrayList::new [i64] a)
          ; source slot (materialized)
          (mut psize) (ArrayList::new [i64] a)
          ; bytes a kind-7 argument occupies
          (mut gp) 0
          (mut fp) 0
          (mut stk) 0]
      ; classify every arg
      (let [(mut i) 0]
        (loop (if (>= (load i) nargs)
                  (break)
                  (do
                    (let [av (get (load avs) (load i))
                          (mut t) (av-ty av)]
                      ; psize is only pushed by kind-7 args; pad it to this arg's index
                      (loop (if (>= (len psize) (load i))
                                (break)
                                (push! (mut psize) 0)))
                      (let [vararg (>= (load i) nparams)
                            info
                              (g-abi-info g
                                          (mut t))
                            cls (abi-cls info)]
                        (cond (= cls 6)  ; an empty struct is not passed at all
                                (do
                                  (push! (mut pkind) 8)
                                  (push! (mut pa) 0)
                                  (push! (mut pslot) 0)
                                  0)
                              vararg
                                ; Apple variadic: every anonymous arg goes on the stack (8B granule)
                                (if (>= cls 2)
                                    (if (= cls 4)
                                        ; >16 bytes: by reference, as for a named arg, but the
                                        ; pointer to the copy takes the 8-byte stack slot
                                        (let [sz
                                                (ty-size g
                                                         (mut t))
                                              cp
                                                (slot-new! (native-context g)
                                                           sz
                                                           (ty-align g
                                                                     (mut t)))]
                                          (emit-copy! g cp (av-slot! g av) sz)
                                          (push! (mut pkind) 6)
                                          (set! stk
                                                (primitive/imul (/ (primitive/iadd (load stk)
                                                                                   7)
                                                                   8)
                                                                8))
                                          (push! (mut pa) (load stk))
                                          (push! (mut pslot) cp)
                                          (set! stk
                                                (primitive/iadd (load stk) 8))
                                          0)
                                        (do
                                          (push! (mut pkind) 3)
                                          (set! stk
                                                (primitive/imul (/ (primitive/iadd (load stk)
                                                                                   7)
                                                                   8)
                                                                8))
                                          (push! (mut pa) (load stk))
                                          (push! (mut pslot) (av-slot! g av))
                                          (set! stk
                                                (primitive/iadd (load stk)
                                                                (primitive/imul (/ (primitive/iadd (ty-size g
                                                                                                            (mut t))
                                                                                                   7)
                                                                                   8)
                                                                                8)))
                                          0))
                                    (do
                                      (push! (mut pkind) 3)
                                      (set! stk
                                            (primitive/imul (/ (primitive/iadd (load stk)
                                                                               7)
                                                               8)
                                                            8))
                                      (push! (mut pa) (load stk))
                                      (push! (mut pslot) (av-slot! g av))
                                      (set! stk (primitive/iadd (load stk) 8))
                                      0))
                              (= cls 0)
                                (if (< (load gp) 8)
                                    (do
                                      (push! (mut pkind) 0)
                                      (push! (mut pa) (load gp))
                                      (push! (mut pslot) (av-slot! g av))
                                      (set! gp (primitive/iadd (load gp) 1))
                                      0)
                                    (let [sz
                                            (ty-size g
                                                     (mut t))]
                                      (push! (mut pkind) 7)
                                      (push! (mut pa)
                                             (a64-named-stack-place! (mut stk)
                                                                     sz
                                                                     sz))
                                      (push! (mut pslot) (av-slot! g av))
                                      (push! (mut psize) sz)
                                      0))
                              (= cls 1)
                                (if (< (load fp) 8)
                                    (do
                                      (push! (mut pkind) 1)
                                      (push! (mut pa) (load fp))
                                      (push! (mut pslot) (av-slot! g av))
                                      (set! fp (primitive/iadd (load fp) 1))
                                      0)
                                    (let [sz (ty-float-bytes (mut t))]
                                      (push! (mut pkind) 7)
                                      (push! (mut pa)
                                             (a64-named-stack-place! (mut stk)
                                                                     sz
                                                                     sz))
                                      (push! (mut pslot) (av-slot! g av))
                                      (push! (mut psize) sz)
                                      0))
                              (= cls 2)
                                (if (< (load gp) 8)
                                    (do
                                      (push! (mut pkind) 0)
                                      (push! (mut pa) (load gp))
                                      (push! (mut pslot) (av-slot! g av))
                                      (set! gp (primitive/iadd (load gp) 1))
                                      0)
                                    (do
                                      (push! (mut pkind) 7)
                                      (push! (mut pa)
                                             (a64-named-stack-place! (mut stk)
                                                                     8
                                                                     (a64-aggregate-stack-align g
                                                                                                (mut t))))
                                      (push! (mut pslot) (av-slot! g av))
                                      (push! (mut psize)
                                             (ty-size g
                                                      (mut t)))
                                      0))
                              (= cls 3)
                                ; a 16-aligned composite starts at an even register
                                (let [gp0
                                        (if (>= (ty-align g
                                                          (mut t))
                                                16)
                                            (* (/ (+ (load gp) 1) 2) 2)
                                            (load gp))]
                                  (if (<= gp0 6)
                                      (do
                                        (push! (mut pkind) 2)
                                        (push! (mut pa) gp0)
                                        (push! (mut pslot) (av-slot! g av))
                                        (set! gp (primitive/iadd gp0 2))
                                        0)
                                      (do
                                        (push! (mut pkind) 7)
                                        (push! (mut pa)
                                               (a64-named-stack-place! (mut stk)
                                                                       16
                                                                       (a64-aggregate-stack-align g
                                                                                                  (mut t))))
                                        (push! (mut pslot) (av-slot! g av))
                                        (push! (mut psize)
                                               (ty-size g
                                                        (mut t)))
                                        (set! gp 8)
                                        0)))
                              (= cls 5)
                                (if (<= (primitive/iadd (load fp)
                                                        (abi-hfa-n info))
                                        8)
                                    (do
                                      (push! (mut pkind) 5)
                                      (push! (mut pa)
                                             (| (<< (abi-hfa-n info) 8)
                                                (<< (abi-hfa-bits info) 16)
                                                (load fp)))
                                      (push! (mut pslot) (av-slot! g av))
                                      (set! fp
                                            (primitive/iadd (load fp)
                                                            (abi-hfa-n info)))
                                      0)
                                    ; on the stack an HFA is its floats, each at its own
                                    ; natural alignment
                                    (let [lb (/ (abi-hfa-bits info) 8)
                                          n (* (abi-hfa-n info) lb)]
                                      (push! (mut pkind) 7)
                                      (push! (mut pa)
                                             (a64-named-stack-place! (mut stk)
                                                                     n
                                                                     lb))
                                      (push! (mut pslot) (av-slot! g av))
                                      (push! (mut psize) n)
                                      (set! fp 8)
                                      0))
                              :else
                                ; cls 4: indirect — copy to a fresh slot, pass its address
                                (let [sz
                                        (ty-size g
                                                 (mut t))
                                      cp
                                        (slot-new! (native-context g)
                                                   sz
                                                   (ty-align g
                                                             (mut t)))]
                                  (emit-copy! g cp (av-slot! g av) sz)
                                  (if (< (load gp) 8)
                                      (do
                                        (push! (mut pkind) 4)
                                        (push! (mut pa) (load gp))
                                        (push! (mut pslot) cp)
                                        (set! gp (primitive/iadd (load gp) 1))
                                        0)
                                      (do
                                        (push! (mut pkind) 6)
                                        (set! stk
                                              (primitive/imul (/ (primitive/iadd (load stk)
                                                                                 7)
                                                                 8)
                                                              8))
                                        (push! (mut pa) (load stk))
                                        (push! (mut pslot) cp)
                                        (set! stk (primitive/iadd (load stk) 8))
                                        0)))))
                      (set! i (primitive/iadd (load i) 1))))))
        ; grow the outgoing-args area
        (let [stk16
                (primitive/imul (/ (primitive/iadd (load stk) 15) 16)
                                16)]
          (when (> stk16 (.outbytes g))
            (set! (.outbytes g) stk16)
            0))
        ; ---- execute the plan: stack args first (x9 scratch), then registers
        (let [(mut i) 0]
          (loop (if (>= (load i) nargs)
                    (break)
                    (do
                      (let [k (get (load pkind) (load i))
                            off (get (load pa) (load i))
                            slot (get (load pslot) (load i))
                            av (get (load avs) (load i))
                            (mut t) (av-ty av)]
                        (if (= k 3)
                            ; stack: copy ty-size bytes (scalars: one word) to [sp+off]
                            (let [sz
                                    (ty-size g
                                             (mut t))]
                              (if (<= sz 8)
                                  (do
                                    (emit-load-int! g 9 28 slot sz false)
                                    (emit-sp-str-x! g 9 off)
                                    0)
                                  ; aggregate on stack: word-copy slot -> [sp+off..]
                                  (let [(mut kk) 0]
                                    (loop (if (>= (load kk) sz)
                                              (break)
                                              (do
                                                (emit-load-int! g
                                                                9
                                                                28
                                                                (primitive/iadd slot
                                                                                (load kk))
                                                                8
                                                                false)
                                                (emit-sp-str-x! g
                                                                9
                                                                (primitive/iadd off
                                                                                (load kk)))
                                                (set! kk
                                                      (primitive/iadd (load kk)
                                                                      8)))))
                                    0)))
                            (cond (= k 6)
                                    (do
                                      (emit-slot-addr! g 9 slot)
                                      (emit-sp-str-x! g 9 off)
                                      0)
                                  (= k 7)
                                    (emit-copy-exact! g
                                                      31
                                                      off
                                                      28
                                                      slot
                                                      (get psize (load i)))
                                  :else 0)))
                      (set! i (primitive/iadd (load i) 1))))))
        ; register args (loaded last so scratch use above cannot clobber them)
        (let [(mut i) 0]
          (loop (if (>= (load i) nargs)
                    (break)
                    (do
                      (let [k (get (load pkind) (load i))
                            n (get (load pa) (load i))
                            slot (get (load pslot) (load i))
                            av (get (load avs) (load i))
                            (mut t) (av-ty av)]
                        (cond (= k 0)
                                (let [(mut bytes) (zeroed i64)
                                      (mut signed) (zeroed bool)]
                                  (ty-int-info (mut t)
                                               (mut bytes)
                                               (mut signed))
                                  (if (ty-is-scalar (mut t))
                                      (emit-load-int! g
                                                      n
                                                      28
                                                      slot
                                                      bytes
                                                      signed)
                                      ; cls-2 aggregate in one x reg: load its (<=8) bytes
                                      (emit-load-int! g
                                                      n
                                                      28
                                                      slot
                                                      (ty-size g
                                                               (mut t))
                                                      false)))
                              (= k 1)
                                (emit-load-fp! g
                                               n
                                               28
                                               slot
                                               (ty-float-bytes (mut t)))
                              (= k 2)
                                (do
                                  (emit-load-int! g n 28 slot 8 false)
                                  (let [rem
                                          (primitive/isub (ty-size g
                                                                   (mut t))
                                                          8)]
                                    (emit-load-int! g
                                                    (primitive/iadd n 1)
                                                    28
                                                    (primitive/iadd slot 8)
                                                    (if (>= rem
                                                            8)
                                                        8
                                                        rem)
                                                    false))
                                  0)
                              (= k 4) (emit-slot-addr! g n slot)
                              (= k 5)
                                (let [hn (& (>> n 8) 255)
                                      bits (& (>> n 16) 255)
                                      base (& n 255)
                                      lb (/ bits 8)]
                                  (for [j 0 hn]
                                    (emit-load-fp! g
                                                   (primitive/iadd base
                                                                   j)
                                                   28
                                                   (primitive/iadd slot
                                                                   (primitive/imul j
                                                                                   lb))
                                                   lb))
                                  0)
                              :else 0))
                      (set! i (primitive/iadd (load i) 1))))))
        ; sret pointer in x8
        (when (= (abi-cls retinfo) 4)
          (emit-slot-addr! g 8 resslot)
          0)
        ; ---- the call
        (if (>= symidx 0)
            (do
              (mobj-add-reloc! (mut (.obj g))
                               (.text g)
                               (a64-off (mut s))
                               symidx
                               (reloc-branch26)
                               true
                               2)
              (a64-w! (mut s) (a64-bl-raw))
              0)
            (do
              (av-to-x! g (load fpav) 17)
              (a64-w! (mut s) (a64-blr 17))
              0))
        ; ---- result
        (if retvoid
            (mk-aval 0 0 (TInt 64 true))
            (let [cls (abi-cls retinfo)]
              (cond (= cls 0)
                      (do
                        (emit-store-int! g
                                         0
                                         28
                                         resslot
                                         (ty-size g
                                                  (mut retp)))
                        (mk-aval 1 resslot ret))
                    (= cls 1)
                      (do
                        (emit-store-fp! g
                                        0
                                        28
                                        resslot
                                        (ty-float-bytes (mut retp)))
                        (mk-aval 1 resslot ret))
                    (= cls 2)
                      (do
                        (emit-store-int! g
                                         0
                                         28
                                         resslot
                                         (ty-size g
                                                  (mut retp)))
                        (mk-aval 1 resslot ret))
                    (= cls 3)
                      (do
                        (emit-store-int! g 0 28 resslot 8)
                        (let [rem
                                (primitive/isub (ty-size g
                                                         (mut retp))
                                                8)]
                          (emit-store-int! g
                                           1
                                           28
                                           (primitive/iadd resslot 8)
                                           (if (>= rem 8)
                                               8
                                               rem)))
                        (mk-aval 1 resslot ret))
                    (= cls 5)
                      (let [hn (abi-hfa-n retinfo)
                            lb (/ (abi-hfa-bits retinfo) 8)]
                        (for [j 0 hn]
                          (emit-store-fp! g
                                          j
                                          28
                                          (primitive/iadd resslot
                                                          (primitive/imul j
                                                                          lb))
                                          lb))
                        (mk-aval 1 resslot ret))
                    :else  ; cls 4: already written through x8; cls 6: nothing to read
                      (mk-aval 1 resslot ret))))))))

; ============================ globals / strings ==============================
; intern an EStr/ECStr payload as a private const-section global; returns symidx.
; `nul` appends a trailing NUL (ECStr); EStr arrays are exactly the bytes.
(defn g-intern-str! [(g (ptr Cga)) (sv (slice u8)) (nul bool)] (-> i64)
  ; dedup exact (content, nul) pairs: entries are keyed by the content behind a
  ; 1-byte kind prefix (0=str,1=cstr). A hash index, not a scan of `strs`: the
  ; scan was quadratic and a quarter of the tpde backend's time on the compiler.
  (let [a (.a g)
        (mut tagged) (StrBuf::new a)]
    (push! (mut tagged) (primitive/cast u8 (when nul 1)))
    (push-str! (mut tagged) sv)
    (let [key (str (load tagged))]
      (match (get (.str_index g) key)
        (Some [sym] sym)
        (None []
              (let [buf (mobj-sect-buf (mut (.obj g)) (.constsec g))
                    off (len (load buf))
                    nm
                      (sconcat a
                               (if nul "l_cstr." "l_str.")
                               (i64->str a (.nglob g)))]
                (set! (.nglob g) (primitive/iadd (.nglob g) 1))
                (b-bytes! (mut buf) sv)
                (when nul (b-u8! (mut buf) 0))
                (let [sym
                        (mobj-add-sym! (mut (.obj g))
                                       nm
                                       (.constsec g)
                                       off
                                       false)
                      (mut e) (zeroed GStr)]
                  (set! (.s e) key)
                  (set! (.symidx e) sym)
                  (push! (mut (.strs g)) e)
                  (set! (mut (.str_index g)) key sym)
                  sym)))))))

; a zero-initialized global in __data; returns symidx.
;;; The data section a static of `size` bytes lives in. Statics of 1 MiB and more
;;; (a sparse `:elements` array is mostly holes) each get a section of their own,
;;; filled once at their exact size. Appended to the shared __data buffer they
;;; regrew it, and each outgrown copy stayed in the compilation arena: a program
;;; with 28 MB of such arrays cost this backend over 100 MB.
(defn g-static-sect! [(g (ptr Cga)) (size i64) (align i64)] (-> i64)
  (if (< size 1048576)
      ; A static aligned past the section's 8 bytes -- a 32-aligned struct --
      ; lands at an aligned offset, which is aligned in memory only if the
      ; section is too: it was 8-aligned, and such a static was misaligned
      ; whenever the statics before it moved the section's placement.
      (do
        (mobj-sect-align-at-least! (mut (.obj g))
                                   (.datasec g)
                                   (g-align-log2 (if (< align 8) 8 align)))
        (.datasec g))
      (mobj-add-sect! (mut (.obj g))
                      "__DATA"
                      (text/format (.a g)
                                   "__coil_big{}"
                                   (i64->str (.a g) (len (.sects (.obj g)))))
                      (g-align-log2 (if (< align 8)
                                        8
                                        align))
                      0)))

(defn g-align-log2 [(align i64)] (-> i64)
  (let [(mut n) 0]
    (while (< (<< 1 n) align) (set! n (+ n 1)))
    n))

(defn g-zero-global! [(g (ptr Cga)) (size i64) (align i64)] (-> i64)
  (let [a (.a g)
        sect (g-static-sect! g size align)
        buf (mobj-sect-buf (mut (.obj g)) sect)]
    (b-align! (mut buf) (if (< align 8) 8 align))
    (let [off (len (load buf))
          nm
            (text/format a
                         "repl_static.{}.{}"
                         (.selfname g)
                         (i64->str a (.nstatic g)))]
      (set! (.nglob g) (primitive/iadd (.nglob g) 1))
      (set! (.nstatic g) (primitive/iadd (.nstatic g) 1))
      (b-zeros! (mut buf) size)
      ; A cell inside a generic instantiation is one per program: every unit
      ; that instantiates the generic defines it, weak, and the linker keeps
      ; one. A concrete function's cell stays local to the unit that owns it.
      ; Both carry the platform's symbol prefix, like every other symbol this
      ; backend emits, so an LLVM-built object and an arm64-built one name the
      ; same cell the same way and the linker can merge them.
      (if (contains? (.spec_names g)
                     (.selfname g))
          (mobj-add-weak-sym! (mut (.obj g)) (g-mangle g nm) sect off)
          (mobj-add-sym! (mut (.obj g)) (g-mangle g nm) sect off false)))))

(defn g-named-zero-global! [(g (ptr Cga))
                            (name (slice u8))
                            (size i64)
                            (align i64)] (-> i64)
  (let [sect (g-static-sect! g size align)
        buf (mobj-sect-buf (mut (.obj g)) sect)]
    (b-align! (mut buf) (if (< align 8) 8 align))
    (let [off (len (load buf))]
      (b-zeros! (mut buf) size)
      (mobj-add-sym! (mut (.obj g)) name sect off false))))

; Public static storage uses the target's C spelling and participates in normal
; native linking. It is the storage itself, never a pointer-valued proxy.
(defn g-public-zero-global! [(g (ptr Cga))
                             (name (slice u8))
                             (size i64)
                             (align i64)] (-> i64)
  (let [native-name (g-mangle g name)
        symbols (field (field g obj) syms)]
    (for [i 0 (len (.sigs g))]
      (let [signature (al-at [GSig] (field g sigs) i)
            symbol (al-at [MSym] symbols (.symidx signature))]
        (when (= (.name symbol) native-name)
          (g-user-fail (text/format (.a g)
                                    "static storage conflicts with function symbol: {}"
                                    name))
          0))
      0)
    (for [i 0 (len (load symbols))]
      (let [symbol (al-at [MSym] symbols i)]
        (when (and (= (.name symbol) native-name) (!= (.sect symbol) 0))
          (g-user-fail (text/format (.a g)
                                    "duplicate static storage symbol: {}"
                                    name))
          0))
      0)
    (let [sect (g-static-sect! g size align)
          buf (mobj-sect-buf (mut (.obj g)) sect)]
      (b-align! (mut buf) (if (< align 8) 8 align))
      (let [off (len (load buf))]
        (b-zeros! (mut buf) size)
        (mobj-add-sym! (mut (.obj g)) native-name sect off true)))))

(defn g-static-idx [(g (ptr Cga)) (name (slice u8))] (-> i64)
  (let [n (len (.statics g))
        (mut i) 0
        (mut found) -1]
    (loop (if (or (>= (load i) n) (>= (load found) 0))
              (break)
              (do
                (when (= (.name (al-at [GStatic] (field g statics) (load i)))
                         name)
                  (set! found (load i))
                  0)
                (set! i (primitive/iadd (load i) 1)))))
    (load found)))

;;; Write the integer `n`, of type `t`, at `off` in data section `sect`.
(defn g-static-write-int! [(g (ptr Cga))
                           (t (ptr Type))
                           (n i64)
                           (sect i64)
                           (off i64)] (-> i64)
  (let [buf (mobj-sect-buf (mut (.obj g)) sect)
        sz (ty-size g t)]
    (cond (= sz 1) (set! (mut buf) off (primitive/cast u8 n))
          (= sz 2)
            (do
              (set! (mut buf) off (primitive/cast u8 n))
              (set! (mut buf)
                    (primitive/iadd off 1)
                    (primitive/cast u8 (>> n 8)))
              0)
          (= sz 4) (b-patch-u32! (mut buf) off n)
          (= sz 8) (b-patch-u64! (mut buf) off n)
          ; a wide integer: the value and its sign extension
          :else
            (do
              (b-patch-u64! (mut buf) off n)
              (b-patch-u64! (mut buf) (primitive/iadd off 8) (if (< n 0) -1 0))))))

;;; Write a link-time constant of type `t` at `off` in data section `sect`.
(defn g-static-write! [(g (ptr Cga))
                       (t (ptr Type))
                       (e (ptr Expr))
                       (sect i64)
                       (off i64)] (-> i64)
  (let [buf (mobj-sect-buf (mut (.obj g)) sect)]
    (match (.kind e)
      (EInt [n] (g-static-write-int! g t n sect off))
      ; A constant integer expression (`(sizeof K)`, arithmetic on constants), as
      ; the LLVM backend folds it.
      (ESizeOf [_]
               (g-static-write-int! g
                                    t
                                    (gcev-v (g-const-eval (native-context g) e))
                                    sect
                                    off))
      (EAlignOf [_]
                (g-static-write-int! g
                                     t
                                     (gcev-v (g-const-eval (native-context g) e))
                                     sect
                                     off))
      (EOffsetOf [_ _]
                 (g-static-write-int! g
                                      t
                                      (gcev-v (g-const-eval (native-context g)
                                                            e))
                                      sect
                                      off))
      (EBin [_ _ _]
            (g-static-write-int! g
                                 t
                                 (gcev-v (g-const-eval (native-context g) e))
                                 sect
                                 off))
      (ECmp [_ _ _]
            (g-static-write-int! g
                                 t
                                 (gcev-v (g-const-eval (native-context g) e))
                                 sect
                                 off))
      (EWideInt [_ lo hi _ _]
                (do
                  (b-patch-u64! (mut buf) off lo)
                  (b-patch-u64! (mut buf) (primitive/iadd off 8) hi)))
      (EFloat [bits]
              (if (= (ty-size g t) 4)
                  (b-patch-u32! (mut buf) off (f64-bits->f32-bits bits))
                  (b-patch-u64! (mut buf) off bits)))
      (EBool [v] (set! (mut buf) off (primitive/cast u8 (when v 1))))
      ; A (slice u8) literal: a relocated pointer to NUL-terminated bytes, then
      ; the length, the same layout emit-expr builds for an expression literal.
      (EStr [sv]
            (do
              (mobj-add-reloc! (mut (.obj g))
                               sect
                               off
                               (g-intern-str! g sv true)
                               (reloc-unsigned)
                               false
                               3)
              (b-patch-u64! (mut buf) (primitive/iadd off 8) (len sv))))
      ; A C string literal: the relocated pointer alone.
      (ECStr [sv]
             (mobj-add-reloc! (mut (.obj g))
                              sect
                              off
                              (g-intern-str! g sv true)
                              (reloc-unsigned)
                              false
                              3))
      ; A sum: the i32 tag, then each payload field at its natural offset in the
      ; variant, after the 8-byte tag word (emit-construct's layout).
      (EConstruct [sum variant args]
                  (let [su (g-sum-idx g sum)]
                    (when (< su 0)
                      (cga-fail2 "def initializer: unknown sum " sum))
                    (let [vidx (g-variant-idx g su variant)
                          vs
                            (load (field (sum-at (field g layouts) su) variants))
                          vfields (field (al-at [Variant] vs vidx) fields)]
                      (b-patch-u32! (mut buf) off vidx)
                      (for [i 0 (len (load args))]
                        (g-static-write! g
                                         (field (al-at [Field] (load vfields) i)
                                                ty)
                                         (al-at [Expr] args i)
                                         sect
                                         (primitive/iadd (primitive/iadd off 8)
                                                         (g-natural-off g
                                                                        (load vfields)
                                                                        i))))
                      0)))
      (EZeroed [_] 0)
      (ERecordInit [_] 0)
      (EStaticArray [indices items]
                    (match (load t)
                      (TArray [elem _]
                              (do
                                (for [i 0 (len (load items))]
                                  (g-static-write! g
                                                   elem
                                                   (al-at [Expr] items i)
                                                   sect
                                                   (+ off
                                                      (* (get (load indices) i)
                                                         (ty-size g elem))))
                                  0)
                                0))
                      (_ (cga-fail "static :elements requires an array allocation"))))
      (EFnPtrOf [name0]
                (let [name (g-fnptr-target g name0)
                      si (g-sig-idx g name)]
                  (when (< si 0)
                    (cga-fail2 "def initializer: unknown function " name))
                  (mobj-add-reloc! (mut (.obj g))
                                   sect
                                   off
                                   (.symidx (al-at [GSig] (field g sigs) si))
                                   (reloc-unsigned)
                                   false
                                   3)))
      (EAlloc [storage ty init symbol]
              (if (!= storage 1)
                  (cga-fail "def initializer: only alloc-static storage is a link-time constant")
                  (let [tp (box-type (.a g) ty)
                        sym
                          (match symbol
                            (Some [name]
                                  (g-public-zero-global! g
                                                         name
                                                         (ty-size g tp)
                                                         (ty-align g tp)))
                            (None []
                                  (g-zero-global! g
                                                  (ty-size g tp)
                                                  (ty-align g tp))))
                        ms (al-at [MSym] (field (field g obj) syms) sym)]
                    (when (!= (primitive/cast i64 init) 0)
                      (g-static-write! g tp init (.sect ms) (.off ms))
                      0)
                    (mobj-add-reloc! (mut (.obj g))
                                     sect
                                     off
                                     sym
                                     (reloc-unsigned)
                                     false
                                     3))))
      ; A slice: its data pointer (a nested static the value points into),
      ; then its length.
      (EMakeSlice [data elem len]
                  (do
                    (g-static-write! g
                                     (box-type (.a g)
                                               (TPtr (box-type (.a g) elem)))
                                     data
                                     sect
                                     off)
                    ; the nested write may have grown the buffers: look it up again
                    (let [after (mobj-sect-buf (mut (.obj g)) sect)]
                      (b-patch-u64! (mut after)
                                    (primitive/iadd off 8)
                                    (extent-value len)))
                    0))
      (ECast [_ inner] (g-static-write! g t inner sect off))
      (ELoad [inner] (g-static-write! g t inner sect off))
      (ELet [_ body]
            (match (load t)
              (TStruct [name]
                       (let [si (g-struct-idx g name)]
                         (when (< si 0)
                           (cga-fail2 "def initializer: unknown struct " name))
                         (for [i 0 (len (load body))]
                           (let [item (al-at [Expr] body i)
                                 place (static-store-place item)]
                             (if (= (primitive/cast i64 place) 0)
                                 (if (static-body-result? body i)
                                     0
                                     (cga-fail "def initializer: expected a materialized aggregate"))
                                 (match (.kind place)
                                   (EField [_ fname]
                                           (let [fi (g-field-idx g si fname)]
                                             (when (< fi 0)
                                               (cga-fail2 "def initializer: unknown field "
                                                          fname))
                                             (g-static-write! g
                                                              (g-field-ty g
                                                                          si
                                                                          fi)
                                                              (static-store-value item)
                                                              sect
                                                              (primitive/iadd off
                                                                              (g-field-off g
                                                                                           si
                                                                                           fi)))))
                                   (_ (cga-fail "def initializer: a store that is not to a field of the aggregate"))))))
                         0))
              (TArray [elem count-extent]
                      (let [count (extent-value count-extent)]
                        (do
                          (for [i 0 (len (load body))]
                            (let [store (al-at [Expr] body i)
                                  place (static-store-place store)]
                              (if (= (primitive/cast i64 place) 0)
                                  (if (static-body-result? body i)
                                      0
                                      (cga-fail "def initializer: expected a materialized array"))
                                  (match (.kind place)
                                    (EIndex [_ index]
                                            (match (.kind index)
                                              (EInt [item]
                                                    (if (or (< item 0)
                                                            (>= item count))
                                                        (cga-fail "alloc-static initializer: array index is out of bounds")
                                                        (g-static-write! g
                                                                         elem
                                                                         (static-store-value store)
                                                                         sect
                                                                         (primitive/iadd off
                                                                                         (primitive/imul item
                                                                                                         (ty-size g
                                                                                                                  elem))))))
                                              (_ (cga-fail "alloc-static initializer: array index is not constant"))))
                                    (_ (cga-fail "def initializer: a store that is not to an element of the array"))))))
                          0)))
              (_ (cga-fail "def initializer: materialized aggregate has the wrong type"))))
      (_ (cga-fail "def initializer is not a link-time constant")))))

(defn g-declare-statics! [(g (ptr Cga)) (p (ptr Program))] (-> i64)
  (let [cs (load (field p consts))]
    (for [i 0 (len (load cs))]
      (let [cp (elem cs i)]
        (when (.runtime cp)
          (match (.ty cp)
            (None [] (cga-fail "internal: checked def has no type"))
            (Some [ty]
                  (let [tp (box-type (.a g) ty)
                        ; The C spelling, as the LLVM backend names it, so storage
                        ; one unit defines is the symbol another declares.
                        symname
                          (g-mangle g
                                    (text/format (.a g)
                                                 "coil_def.{}"
                                                 (.name cp)))
                        sym
                          (if (.declared cp)
                              ; Another unit defines it: an undefined symbol,
                              ; addressed through the GOT (emit-sym-addr!).
                              (mobj-add-sym! (mut (.obj g)) symname 0 0 true)
                              (g-named-zero-global! g
                                                    symname
                                                    (ty-size g tp)
                                                    (ty-align g tp)))
                        (mut st) (zeroed GStatic)]
                    ; Storage this program publishes for other units is external.
                    (when (and (not (.declared cp))
                               (g-unit-export? g (.name cp)))
                      (set! (.ext (al-at [MSym] (field (field g obj) syms) sym))
                            true)
                      0)
                    (set! (.name st)
                          (.name cp))
                    (set! (.ty st)
                          ty)
                    (set! (.symidx st)
                          sym)
                    (push! (mut (.statics g))
                           st)
                    (let [ms (al-at [MSym] (field (field g obj) syms) sym)]
                      ; Include the concrete outer type in nested alloc-static
                      ; identity. A full-source replacement may legally change a
                      ; def's signature; its new Var must not reuse the old
                      ; signature's cell merely because the public name matches.
                      (set! (.selfname g)
                            (match ty
                              (TStruct [tn]
                                       (sconcat (.a g)
                                                (.name cp)
                                                (text/format (.a g) ".{}" tn)))
                              (_ (.name cp))))
                      (set! (.nstatic g) 0)
                      (unless (.declared cp)
                        (g-static-write! g
                                         tp
                                         (field cp value)
                                         (.sect ms)
                                         (.off ms))
                        0)))))
          0)))
    0))

; reg = address of symbol (adrp+add with PAGE21/PAGEOFF12 relocs)
(defn emit-sym-addr! [(g (ptr Cga)) (reg i64) (symidx i64)] (-> i64)
  (let [s (field g asm)]
    (let [sym (al-at [MSym] (field (field g obj) syms) symidx)]
      (if (or (= (.sect sym) 0)
              (starts-with (.name sym) "repl_static.")
              (starts-with (.name sym) "_repl_static."))
          (do
            ; Undefined symbols and persistent reload cells are addressed through
            ; a GOT slot.  Besides satisfying ld for dylib symbols, this keeps a
            ; new JIT image's ADRP local even when the stable cell itself belongs
            ; to an older mapping more than 4 GiB away.
            (mobj-add-reloc! (mut (.obj g))
                             (.text g)
                             (a64-off (mut s))
                             symidx
                             (reloc-got-load-page21)
                             true
                             2)
            (a64-w! (mut s) (a64-adrp reg))
            (mobj-add-reloc! (mut (.obj g))
                             (.text g)
                             (a64-off (mut s))
                             symidx
                             (reloc-got-load-pageoff12)
                             false
                             2)
            (a64-w! (mut s) (a64-ldr-x reg reg 0)))
          (do
            (mobj-add-reloc! (mut (.obj g))
                             (.text g)
                             (a64-off (mut s))
                             symidx
                             (reloc-page21)
                             true
                             2)
            (a64-w! (mut s) (a64-adrp reg))
            (mobj-add-reloc! (mut (.obj g))
                             (.text g)
                             (a64-off (mut s))
                             symidx
                             (reloc-pageoff12)
                             false
                             2)
            (a64-w! (mut s) (a64-add-imm reg reg 0)))))
    0))

; store an AVal into a slot (any type).
(defn emit-store-av! [(g (ptr Cga)) (av AVal) (dst i64)] (-> i64)
  (let [(mut t) (av-ty av)]
    (if (ty-is-scalar (mut t))
        (do
          (av-to-x! g av 9)
          (emit-store-int! g 9 28 dst (ty-size g (mut t)))
          0)
        (emit-copy! g dst (av-slot! g av) (ty-size g (mut t))))))

; pointee type of a TPtr/TRef value
(defn ty-pointee [(t (ptr Type))] (-> Type)
  (match (load t)
    (TPtr [inner] (load inner))
    (TRef [_m inner] (load inner))
    (_ (do (cga-fail "load/store through a non-pointer") (TInt 64 true)))))

; ============================ expression emission ============================
(defn emit-body [(g (ptr Cga)) (body (ptr (ArrayList Expr)))] (-> AVal)
  (let [n (len (load body))
        (mut last) (mk-aval 0 0 (TInt 64 true))]
    (for [i 0 n]
      (when (.terminated g) (break))
      (set! last (emit-expr g (al-at [Expr] body i))))
    (load last)))

; The function body: identical to emit-body except the LAST expression is emitted in
; TAIL position. Only the function body may start a tail chain — a `do` in argument
; position ends in a value that its caller still consumes.
(defn emit-body-tail [(g (ptr Cga)) (body (ptr (ArrayList Expr)))] (-> AVal)
  (let [n (len (load body))
        (mut last) (mk-aval 0 0 (TInt 64 true))]
    (for [i 0 n]
      (when (.terminated g) (break))
      (when (= i (primitive/isub n 1))
        (set! (.tailok g) true)
        0)
      (set! last (emit-expr g (al-at [Expr] body i))))
    (load last)))

(defn emit-binds [(g (ptr Cga)) (binds (ptr (ArrayList Bind)))] (-> i64)
  (let [n (len (load binds))
        (mut i) 0
        (mut a) (.a g)]
    (loop (if (>= (load i) n)
              (break)
              (do
                (let [b (al-at [Bind] binds (load i))
                      av (emit-expr g (field b value))]
                  (if (.mutable b)
                      ; mutable: give the value a stable slot and bind the NAME to a
                      ; pointer to it (the checker reads it via (primitive/load name)).
                      (let [(mut t) (av-ty av)]
                        (let [vslot (av-slot! g av)
                              pslot (slot-new! (native-context g) 8 8)]
                          (emit-slot-addr! g 9 vslot)
                          (emit-store-int! g 9 28 pslot 8)
                          (dw-note-var! g
                                        (.name b)
                                        (mut t)
                                        pslot
                                        true
                                        false
                                        (.source (.value b))
                                        (.lo (.value b)))
                          (set! (.env g)
                                (gscope-put (load a)
                                            (load (field g env))
                                            (.name b)
                                            (mk-aval 1
                                                     pslot
                                                     (TPtr (box-type (load a)
                                                                     (av-ty av))))))
                          0))
                      (do
                        (when (= (av-kind av) 1)
                          (dw-note-bind! g
                                         (.name b)
                                         av
                                         (.source (.value b))
                                         (.lo (.value b))))
                        (set! (.env g)
                              (gscope-put (load a)
                                          (load (field g env))
                                          (.name b)
                                          av))
                        0)))
                (set! i (primitive/iadd (load i) 1))))))
  0)

(defn emit-stmts [(g (ptr Cga)) (body (ptr (ArrayList Expr)))] (-> i64)
  (let [n (len (load body))
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (when (.terminated g) (break))
                (emit-expr g (al-at [Expr] body (load i)))
                (set! i (primitive/iadd (load i) 1))))))
  0)

; find the target loop index (labeled search from innermost, else innermost).

; TAIL POSITION is CONSUMED here. Every entry to emit-expr clears the flag into a
; local, so a construct that does not explicitly re-arm it cannot leak tail-ness to
; its children — the failure that would matter (compiling a NON-tail call as a jump)
; is structurally impossible rather than a thing to remember. `if` re-arms it for its
; two branches, which is the only propagation the reported case needs.
(defn emit-expr [(g (ptr Cga)) (e (ptr Expr))] (-> AVal)
  (dw-note-span! g e)
  (let [am-tail (.tailok g)]
    (set! (.tailok g) false)
    (match (.kind e)
      (EIf [cnd thn els] (emit-if-tail g cnd thn els am-tail))
      (ECall [func targs args]
             (if (and am-tail (tail-self-callable? g func args))
                 (emit-tail-self-call! g args)
                 (emit-call-named g func args)))
      ; a never-returning self call in tail position is a jump too (ast.coil,
      ; diverging-call)
      (EDo [_]
           (match (diverging-call e)
             (Some [call]
                   (match (.kind call)
                     (ECall [func _ args]
                            (if (and am-tail (tail-self-callable? g func args))
                                (emit-tail-self-call! g args)
                                (emit-expr-rest g e)))
                     (_ (emit-expr-rest g e))))
             (None [] (emit-expr-rest g e))))
      (_ (emit-expr-rest g e)))))

(defn emit-expr-rest [(g (ptr Cga)) (e (ptr Expr))] (-> AVal)
  (match (.kind e)
    (EAnonFn [_ _] (do (abort) (zeroed AVal)))
    (EDefer [_ _]
            (do
              (cga-fail "a (defer …) region reached the backend before ownership elaboration lowered it")
              (zeroed AVal)))
    (EBracketCall [_ _ _ _]
                  (do
                    (cga-fail "a bracket call reached the backend before resolution chose its reading")
                    (zeroed AVal)))
    (EFnPtrInst [_ _]
                (do
                  (cga-fail "a generic function's pointer reached the backend unspecialized")
                  (zeroed AVal)))
    (EInt [v] (mk-aval 0 v (TInt 64 true)))
    (EWideInt [_ lo hi _ _] (emit-wide-literal! g lo hi))
    (EFloat [bits] (mk-aval 2 bits (TFloat 64)))
    (EBool [b] (mk-aval 0 (when b 1) (TBool)))
    (EStr [sv]
          (let [sym
                  (g-intern-str! g sv true)  ; NUL-terminate the backing bytes (slice len below is separate)
                a (.a g)
                slot (slot-new! (native-context g) 16 8)]
            (emit-sym-addr! g 9 sym)
            (emit-store-int! g 9 28 slot 8)
            (a64-mov-imm! (mut (.asm g)) 9 (len sv))
            (emit-store-int! g 9 28 (primitive/iadd slot 8) 8)
            (mk-aval 1 slot (TSlice (box-type a (TInt 8 false))))))
    (ECStr [sv]
           (let [sym (g-intern-str! g sv true)
                 a (.a g)
                 slot (slot-new! (native-context g) 8 8)]
             (emit-sym-addr! g 9 sym)
             (emit-store-int! g 9 28 slot 8)
             (mk-aval 1 slot (TPtr (box-type a (TInt 8 true))))))
    (EVar [name]
          (match (gscope-get (load (field g env)) name)
            (Some [av] av)
            (None []
                  (do
                    (cga-fail2 "unbound variable: " name)
                    (mk-aval 0 0 (TInt 64 true))))))
    (EZeroed [t]
             (let [(mut tp) t]
               (let [slot (slot-for-ty! g (mut tp))]
                 (emit-zero! g slot (ty-size g (mut tp)))
                 (mk-aval 1 slot t))))
    (ERecordInit [t]
                 (let [(mut tp) t]
                   (let [slot (slot-for-ty! g (mut tp))]
                     (emit-zero! g slot (ty-size g (mut tp)))
                     (mk-aval 1 slot t))))
    (EBorrow [_m place] (emit-expr g place))
    (ESpillRef [inner]
               (let [av (emit-expr g inner)
                     a (.a g)
                     vslot (av-slot! g av)
                     pslot (slot-new! (native-context g) 8 8)]
                 (emit-slot-addr! g 9 vslot)
                 (emit-store-int! g 9 28 pslot 8)
                 (mk-aval 1 pslot (TPtr (box-type a (av-ty av))))))
    (EMovePlace [_]
                (do
                  (cga-fail "EMovePlace survived monomorphization (compiler bug)")
                  (mk-aval 0 0 (TInt 64 true))))
    (ELet [binds body]
          (let [saved (load (field g env))
                first-var (len (.dwvars g))]
            (emit-binds g binds)
            (let [r (emit-body g body)
                  here (a64-off (mut (.asm g)))]
              ; the let's locals go out of scope here
              (for v (range first-var (len (.dwvars g)))
                (let [dv (al-at [DwVar] (field g dwvars) v)]
                  (when (< (.end dv) 0) (set! (.end dv) here))))
              (set! (.env g) saved)
              r)))
    (EDo [body] (emit-body g body))
    (ECleanup [body cleanups]
              (let [result (emit-expr g body)]
                (emit-body g cleanups)
                result))
    (EBin [op lhs rhs] (emit-bin g op lhs rhs))
    (ECmp [op lhs rhs] (emit-cmp g op lhs rhs))
    (EIntUnary [op inner] (emit-int-unary g op inner))
    (EIf [cnd thn els] (emit-if g cnd thn els))
    (ELoop [label body] (emit-loop g label body))
    (EBreak [label value] (emit-break g label value))
    (EContinue [label]
               (do
                 (let [li (g-loop-index (native-context g) label)]
                   (a64-b-label! (mut (.asm g))
                                 (.contlabel (al-at [GLoop]
                                                    (field g
                                                           loops)
                                                    li)))
                   (set! (.terminated g) true))
                 (mk-aval 0 0 (TInt 64 true))))
    (ECall [func _targs args] (emit-call-named g func args))
    (ENamedCall [_func _targs _names _args]
                (do
                  (cga-fail "named constructor call survived type checking")
                  (mk-aval 0 0 (TInt 64 true))))
    (ECallPtr [fp args]
              (let [(mut fpav) (emit-expr g fp)]
                (let [(mut t) (av-ty fpav)]
                  (match t
                    (TFn [_cc params ret]
                         (let [(mut avs) (ArrayList::new [AVal] (.a g))
                               n (len (load args))]
                           (for [i 0 n]
                             (push! (mut avs)
                                    (emit-expr g
                                               (al-at [Expr]
                                                      args
                                                      i))))
                           (emit-call! g
                                       -1
                                       (mut fpav)
                                       params
                                       false
                                       (load ret)
                                       (box-al [AVal] (.a g) (load avs)))))
                    (_ (do
                         (cga-fail "call-ptr on non-fnptr value")
                         (mk-aval 0 0 (TInt 64 true))))))))
    (EAlloc [storage t init symbol]
            (let [a (.a g)
                  (mut tp) t]
              (if (or (= storage 0)
                      (= storage 3))
                  ; stack: a per-function-execution frame slot
                  (let [slot
                          (slot-for-ty! g
                                        (mut tp))
                        pslot (slot-new! (native-context g) 8 8)]
                    (emit-slot-addr! g 9 slot)
                    (emit-store-int! g 9 28 pslot 8)
                    (mk-aval 1 pslot (TPtr (box-type a t))))
                  (if (= storage 2)
                      ; heap: call malloc(size)
                      (let [msym (g-runtime-sym! g "_malloc")
                            slot (slot-new! (native-context g) 8 8)]
                        (a64-mov-imm! (mut (.asm g))
                                      0
                                      (ty-size g
                                               (mut tp)))
                        (mobj-add-reloc! (mut (.obj g))
                                         (.text g)
                                         (a64-off (mut (.asm g)))
                                         msym
                                         (reloc-branch26)
                                         true
                                         2)
                        (a64-w! (mut (.asm g)) (a64-bl-raw))
                        (emit-store-int! g 0 28 slot 8)
                        (mk-aval 1 slot (TPtr (box-type a t))))
                      ; static: one persistent data symbol per allocation site.
                      ; The checked initializer is a link-time constant; use the
                      ; same aggregate/relocation writer as top-level definitions.
                      (let [sym
                              (match symbol
                                (Some [name]
                                      (g-public-zero-global! g
                                                             name
                                                             (ty-size g
                                                                      (mut tp))
                                                             (ty-align g
                                                                       (mut tp))))
                                (None []
                                      (g-zero-global! g
                                                      (ty-size g
                                                               (mut tp))
                                                      (ty-align g
                                                                (mut tp)))))
                            ms (al-at [MSym] (field (field g obj) syms) sym)
                            pslot (slot-new! (native-context g) 8 8)]
                        (when (!= (primitive/cast i64 init) 0)
                          (g-static-write! g
                                           (mut tp)
                                           init
                                           (.sect ms)
                                           (.off ms))
                          0)
                        (emit-sym-addr! g 9 sym)
                        (emit-store-int! g 9 28 pslot 8)
                        (mk-aval 1 pslot (TPtr (box-type a t))))))))
    (EAccessorField [p fname]
                    (emit-expr g
                               (box-expr (.a g)
                                         (expr-at e (EField p fname)))))
    (EField [p fname]
            (let [av (emit-expr g p)
                  a (.a g)
                  (mut t) (av-ty av)]
              (let [(mut pt) (ty-pointee (mut t))]
                (match pt
                  (TStruct [nm]
                           (let [si (g-struct-idx g nm)]
                             (when (< si 0)
                               (cga-fail2 "field access on non-struct: " nm))
                             (let [fi (g-field-idx g si fname)
                                   off (g-field-off g si fi)
                                   fty
                                     (.ty (al-at [Field]
                                                 (load (field (struct-at (field g
                                                                                layouts)
                                                                         si)
                                                              fields))
                                                 fi))
                                   slot (slot-new! (native-context g) 8 8)]
                               (av-to-x! g av 9)
                               (if (<= off 4095)
                                   (a64-w! (mut (.asm g)) (a64-add-imm 9 9 off))
                                   (do
                                     (a64-mov-imm! (mut (.asm g)) 10 off)
                                     (a64-w! (mut (.asm g))
                                             (a64-add-reg 9 9 10))
                                     0))
                               (emit-store-int! g 9 28 slot 8)
                               (mk-aval 1 slot (TPtr (box-type a fty))))))
                  (_ (do
                       (cga-fail "field access through non-struct pointer")
                       (mk-aval 0 0 (TInt 64 true))))))))
    (ELoad [inner]
           (let [av (emit-expr g inner)
                 a (.a g)
                 (mut t) (av-ty av)]
             (let [(mut pt) (ty-pointee (mut t))]
               (let [sz (ty-size g (mut pt))
                     slot (slot-for-ty! g (mut pt))]
                 (av-to-x! g av 9)
                 (if (<= sz 8)
                     (do
                       (emit-load-from-mem! g 10 9 sz)
                       (emit-store-int! g 10 28 slot sz)
                       0)
                     (emit-copy-from-mem! g slot 9 sz))
                 (mk-aval 1 slot pt)))))
    (EStore [p val]
            (let [pav (emit-expr g p)
                  vav (emit-expr g val)
                  (mut t) (av-ty vav)]
              (let [sz
                      (ty-size g
                               (mut t))]
                (if (ty-is-scalar (mut t))
                    (do
                      (av-to-x! g vav 10)
                      (av-to-x! g pav 9)
                      (emit-store-to-mem! g 10 9 sz)
                      0)
                    (do
                      (av-to-x! g pav 9)
                      (emit-copy-to-mem! g 9 (av-slot! g vav) sz)
                      0))
                ; std-12: store! yields unit (canonical i64 0), matching its checked type.
                (mk-aval 0 0 (TInt 64 true)))))
    (EInitStore [p val]
                (let [pav (emit-expr g p)
                      vav (emit-expr g val)
                      (mut t) (av-ty vav)]
                  (let [sz (ty-size g (mut t))]
                    (if (ty-is-scalar (mut t))
                        (do
                          (av-to-x! g vav 10)
                          (av-to-x! g pav 9)
                          (emit-store-to-mem! g 10 9 sz)
                          0)
                        (do
                          (av-to-x! g pav 9)
                          (emit-copy-to-mem! g 9 (av-slot! g vav) sz)
                          0))
                    (mk-aval 0 0 (TInt 64 true)))))
    (EIndex [p idx]
            (let [pav (emit-expr g p)
                  iav (emit-expr g idx)
                  a (.a g)
                  (mut t) (av-ty pav)]
              (let [(mut pt) (ty-pointee (mut t))]
                ; pointer-to-array indexes elements of the array; otherwise the pointee
                (let [(mut ep) (zeroed Type)]
                  (match pt
                    (TArray [elem _n] (set! ep (load elem)))
                    (_ (set! ep pt)))
                  (let [esz (ty-size g (mut ep))
                        slot (slot-new! (native-context g) 8 8)]
                    (av-to-x! g pav 9)
                    (av-to-x! g iav 10)
                    (a64-mov-imm! (mut (.asm g)) 11 esz)
                    (a64-w! (mut (.asm g)) (a64-madd 9 10 11 9))
                    (emit-store-int! g 9 28 slot 8)
                    (mk-aval 1 slot (TPtr (box-type a ep))))))))
    (ECast [t inner] (emit-cast g t inner))
    (ESizeOf [t]
             (let [(mut tp) t] (mk-aval 0 (ty-size g (mut tp)) (TInt 64 true))))
    (EAlignOf [t]
              (let [(mut tp) t]
                (mk-aval 0 (ty-align g (mut tp)) (TInt 64 true))))
    (EOffsetOf [t fname]
               (let [(mut tp) t]
                 (match t
                   (TStruct [nm]
                            (let [si (g-struct-idx g nm)]
                              (when (< si 0)
                                (cga-fail2 "offset-of on non-struct: " nm))
                              (mk-aval 0
                                       (g-field-off g
                                                    si
                                                    (g-field-idx g si fname))
                                       (TInt 64 true))))
                   (_ (do
                        (cga-fail "offset-of on non-struct type")
                        (mk-aval 0 0 (TInt 64 true)))))))
    (EFree [inner]
           (let [av (emit-expr g inner)
                 fsym (g-runtime-sym! g "_free")]
             (av-to-x! g av 0)
             (mobj-add-reloc! (mut (.obj g))
                              (.text g)
                              (a64-off (mut (.asm g)))
                              fsym
                              (reloc-branch26)
                              true
                              2)
             (a64-w! (mut (.asm g)) (a64-bl-raw))
             (mk-aval 0 0 (TInt 64 true))))
    (EConstruct [sum variant args] (emit-construct g sum variant args))
    (EMatch [scrut arms] (emit-match g scrut arms))
    (EFnPtrOf [name0]
              (let [name (g-fnptr-target g name0)
                    si (g-sig-idx g name)]
                (when (< si 0)
                  (cga-fail2 "fnptr-of unknown function: " name))
                (let [e (al-at [GSig] (field g sigs) si)
                      slot (slot-new! (native-context g) 8 8)]
                  (emit-sym-addr! g 9 (.symidx e))
                  (emit-store-int! g 9 28 slot 8)
                  (mk-aval 1
                           slot
                           (TFn
                             :cc (cc-c)
                             :params (load (field e params))
                             :ret
                               (box-type (.a g)
                                         (.ret e)))))))
    (EBitGet [p fname] (emit-bitget g p fname))
    (EBitSet [p fname val] (emit-bitset g p fname val))
    (ELlvmIr [result args body] (emit-llvmir g result args body))
    (EIntrinsic [op result args] (emit-intrinsic g op result args))
    (EVector [op result types args]
             (let [a (.a g)
                   saved (.env g)
                   (mut values) (ArrayList::new [AVal] a)]
               ; Evaluate all operands in the caller's environment before binding any
               ; generated names. This makes the scalar fallback hygienic and once-only.
               (for [i 0 (len (load args))]
                 (push! (mut values) (emit-expr g (al-at [Expr] args i))))
               (for [i 0 (len (load args))]
                 (set! (.env g)
                       (gscope-put a
                                   (.env g)
                                   (vs-argument-name a i)
                                   (get (load values) i))))
               (let [lowered
                       (match (scalarize-vector a op (box-type a result) types)
                         (Ok [expr] expr)
                         (Err [d]
                              (do
                                (let [diag d] (cga-fail (.msg diag)))
                                (mk-expr (EInt 0) -1 -1 -1 0))))
                     value (emit-expr g (box-expr a lowered))]
                 (set! (.env g) saved)
                 value)))
    (EMakeDyn [ds vt methods inner] (emit-make-dyn g ds vt methods inner))
    (EDynDispatch [dc]
                  (let [ds (.dyn_struct dc)
                        vt (.vtable_struct dc)
                        mi (.method_index dc)
                        cc (.cc dc)
                        params (.params dc)
                        ret (.ret dc)
                        recv (.recv dc)
                        args (.args dc)]
                    (emit-dyn-dispatch g ds vt mi cc params ret recv args)))
    (EStaticRef [name]
                (let [si (g-static-idx g name)]
                  (if (< si 0)
                      (do
                        (cga-fail2 "static-ref references an unknown def: "
                                   name)
                        (mk-aval 0 0 (TInt 64 true)))
                      (let [st (al-at [GStatic] (field g statics) si)
                            slot (slot-new! (native-context g) 8 8)]
                        (emit-sym-addr! g 9 (.symidx st))
                        (emit-store-int! g 9 28 slot 8)
                        (mk-aval 1 slot (TPtr (box-type (.a g) (.ty st))))))))
    (EErase [_t _i]
            (do
              (cga-fail "EErase reached codegen (checker bug)")
              (mk-aval 0 0 (TInt 64 true))))
    (ETraitCall [_a _b _c _d]
                (do
                  (cga-fail "ETraitCall reached codegen (mono bug)")
                  (mk-aval 0 0 (TInt 64 true))))
    (EComptime [_]
               (do
                 (cga-fail "EComptime reached codegen")
                 (mk-aval 0 0 (TInt 64 true))))
    (EAscribe [_t _i]
              (do
                (cga-fail "EAscribe reached codegen (checker should have lowered (: v t) to its coerced value)")
                (mk-aval 0 0 (TInt 64 true))))
    (EPattern [pattern-op _t _i pattern-index]
              (do
                (cga-fail "EPattern reached codegen (checker should have lowered (: v t) to its coerced value)")
                (mk-aval 0 0 (TInt 64 true))))
    (EArrayLit [_]
               (do
                 (cga-fail "EArrayLit reached codegen (checker bug)")
                 (mk-aval 0 0 (TInt 64 true))))
    (EStaticArray [_ _]
                  (do
                    (cga-fail "static :elements escaped its allocation initializer")
                    (mk-aval 0 0 (TInt 64 true))))
    (EMakeSlice [data elem len]
                (let [dv (emit-expr g data)
                      a (.a g)
                      slot (slot-new! (native-context g) 16 8)]
                  (av-to-x! g dv 9)
                  (emit-store-int! g 9 28 slot 8)
                  (a64-mov-imm! (mut (.asm g)) 9 (extent-value len))
                  (emit-store-int! g 9 28 (primitive/iadd slot 8) 8)
                  (mk-aval 1 slot (TSlice (box-type a elem)))))
    (ETypeQuery [_q _t]
                (do
                  (cga-fail "ETypeQuery reached codegen")
                  (mk-aval 0 0 (TInt 64 true))))
    (EConstParam [_ _]
                 (do
                   (cga-fail "unspecialized value parameter reached codegen (compiler bug)")
                   (mk-aval 0 0 (TInt 64 true))))
    (EFieldMeta [_m _t _i]
                (do
                  (cga-fail "EFieldMeta reached codegen")
                  (mk-aval 0 0 (TInt 64 true))))
    (EFieldIndex [_t _n]
                 (do
                   (cga-fail "EFieldIndex reached codegen")
                   (mk-aval 0 0 (TInt 64 true))))
    (EQuote [_]
            (do
              (cga-fail "EQuote reached codegen")
              (mk-aval 0 0 (TInt 64 true))))
    (ECodeOp [_o _a]
             (do
               (cga-fail "ECodeOp reached codegen")
               (mk-aval 0 0 (TInt 64 true))))
    (EQuasi [_]
            (do
              (cga-fail "EQuasi reached codegen")
              (mk-aval 0 0 (TInt 64 true))))))

; lazily-declared runtime symbols (malloc/free used by EAlloc heap / EFree).
(defn g-runtime-sym! [(g (ptr Cga)) (nm (slice u8))] (-> i64)
  (let [n (len (.syms (.obj g)))
        (mut r) -1]
    (for [i 0 n]
      (when (= (.name (al-at [MSym]
                             (field (field g obj) syms)
                             i))
               nm)
        (set! r i)))
    (if (>= (load r) 0)
        (load r)
        (mobj-add-sym! (mut (.obj g)) nm 0 0 true))))

; memory load/store with a dynamic address register (widths 1/2/4/8)
(defn emit-load-from-mem! [(g (ptr Cga)) (reg i64) (addrreg i64) (bytes i64)]
  (-> i64)
  (let [s (field g asm)]
    (cond (= bytes 1) (a64-w! (mut s) (a64-ldr-b reg addrreg 0))
          (= bytes 2) (a64-w! (mut s) (a64-ldr-h reg addrreg 0))
          (= bytes 4) (a64-w! (mut s) (a64-ldr-w reg addrreg 0))
          :else (a64-w! (mut s) (a64-ldr-x reg addrreg 0)))))

(defn emit-store-to-mem! [(g (ptr Cga)) (reg i64) (addrreg i64) (bytes i64)]
  (-> i64)
  (let [s (field g asm)]
    (cond (= bytes 1) (a64-w! (mut s) (a64-str-b reg addrreg 0))
          (= bytes 2) (a64-w! (mut s) (a64-str-h reg addrreg 0))
          (= bytes 4) (a64-w! (mut s) (a64-str-w reg addrreg 0))
          :else (a64-w! (mut s) (a64-str-x reg addrreg 0)))))

; canonicalize x-reg `reg` to exact iN width semantics (the container invariant:
; slots always hold values sign/zero-extended from bit N-1).
(defn emit-canon-int! [(g (ptr Cga)) (reg i64) (bits i64) (signed bool)]
  (-> i64)
  (let [s (field g asm)]
    (cond (= bits 64) 0
          (= bits 8)
            (a64-w! (mut s) (if signed (a64-sxtb reg reg) (a64-uxtb reg reg)))
          (= bits 16)
            (a64-w! (mut s) (if signed (a64-sxth reg reg) (a64-uxth reg reg)))
          (= bits 32)
            (a64-w! (mut s) (if signed (a64-sxtw reg reg) (a64-mov32 reg reg)))
          :else
            (let [sh (primitive/isub 64 bits)]
              (a64-w! (mut s) (a64-lsl-imm reg reg sh))
              (a64-w! (mut s)
                      (if signed
                          (a64-asr-imm reg reg sh)
                          (a64-lsr-imm reg reg sh)))
              0))))

(defn emit-int-unary [(g (ptr Cga)) (op i64) (inner (ptr Expr))] (-> AVal)
  (let [av (emit-expr g inner)
        (mut t) (av-ty av)
        s (field g asm)]
    (if (ty-wide-int? (mut t))
        (emit-int-unary-wide! g op av (mut t))
        (let [bits (match t (TInt [n _] n) (_ 64))]
          (av-to-x! g av 9)
          (if (= op 0)
              (a64-w! (mut s) (a64-mvn-reg 9 9))
              (do
                (emit-canon-int! g 9 bits false)
                (cond (= op 1)
                        (do
                          (a64-w! (mut s) (a64-clz 9 9))
                          (when (< bits 64)
                            (a64-mov-imm! (mut s) 10 (primitive/isub 64 bits))
                            (a64-w! (mut s) (a64-sub-reg 9 9 10))))
                      (= op 2)
                        (do
                          (a64-w! (mut s) (a64-cmp-imm 9 0))
                          (a64-w! (mut s) (a64-rbit 9 9))
                          (a64-w! (mut s) (a64-clz 9 9))
                          (a64-mov-imm! (mut s) 10 bits)
                          (a64-w! (mut s) (a64-csel 9 10 9 0)))
                      (= op 3)
                        (do
                          (a64-w! (mut s) (a64-lsr-imm 10 9 1))
                          (a64-mov-imm! (mut s) 11 0x5555555555555555)
                          (a64-w! (mut s) (a64-and-reg 10 10 11))
                          (a64-w! (mut s) (a64-sub-reg 9 9 10))
                          (a64-mov-imm! (mut s) 11 0x3333333333333333)
                          (a64-w! (mut s) (a64-and-reg 10 9 11))
                          (a64-w! (mut s) (a64-lsr-imm 9 9 2))
                          (a64-w! (mut s) (a64-and-reg 9 9 11))
                          (a64-w! (mut s) (a64-add-reg 9 9 10))
                          (a64-w! (mut s) (a64-lsr-imm 10 9 4))
                          (a64-w! (mut s) (a64-add-reg 9 9 10))
                          (a64-mov-imm! (mut s) 11 0x0f0f0f0f0f0f0f0f)
                          (a64-w! (mut s) (a64-and-reg 9 9 11))
                          (a64-w! (mut s) (a64-lsr-imm 10 9 8))
                          (a64-w! (mut s) (a64-add-reg 9 9 10))
                          (a64-w! (mut s) (a64-lsr-imm 10 9 16))
                          (a64-w! (mut s) (a64-add-reg 9 9 10))
                          (a64-w! (mut s) (a64-lsr-imm 10 9 32))
                          (a64-w! (mut s) (a64-add-reg 9 9 10))
                          (a64-mov-imm! (mut s) 11 127)
                          (a64-w! (mut s) (a64-and-reg 9 9 11)))
                      :else
                        (do
                          (a64-w! (mut s) (a64-rev 9 9))
                          (when (< bits 64)
                            (a64-w! (mut s)
                                    (a64-lsr-imm 9 9 (primitive/isub 64 bits))))))))
          (emit-canon-int! g 9 bits (match t (TInt [_ sg] sg) (_ false)))
          (let [slot (slot-for-ty! g (mut t))]
            (emit-store-int! g 9 28 slot (ty-size g (mut t)))
            (mk-aval 1 slot (av-ty av)))))))

; ---- integers wider than a register ----------------------------------------
; An i128 or u128 (any width from 65 to 128 bits) lives in a 16-byte slot, low
; word first, and is passed and returned as a 16-byte composite: an even
; register pair, as AAPCS64 passes __int128. Arithmetic works on register
; pairs (lo, hi); a width under 128 keeps its high word canonical, sign- or
; zero-extended from the width, as narrower integers keep their register.
; Division, and conversion to and from floats, call compiler-rt's helpers.

(defn ty-wide-int? [(t (ptr Type))] (-> bool)
  (match (load t) (TInt [bits _] (> bits 64)) (_ false)))

(defn wide-bits [(t (ptr Type))] (-> i64)
  (match (load t) (TInt [bits _] bits) (_ 128)))

(defn wide-signed? [(t (ptr Type))] (-> bool)
  (match (load t) (TInt [_ signed] signed) (_ false)))

;;; Load the wide integer `av` into registers `lo` and `hi`. An immediate's high
;;; word is its sign.
(defn wide-to-x! [(g (ptr Cga)) (av AVal) (lo i64) (hi i64)] (-> i64)
  (let [s (field g asm)]
    (if (= (av-kind av) 1)
        (do
          (emit-load-int! g lo 28 (av-v av) 8 false)
          (emit-load-int! g hi 28 (+ (av-v av) 8) 8 false))
        (do
          (a64-mov-imm! (mut s) lo (av-v av))
          (a64-mov-imm! (mut s) hi (if (< (av-v av) 0) -1 0))))))

;;; Keep the high word canonical for a width under 128 bits.
(defn wide-canon! [(g (ptr Cga)) (t (ptr Type)) (hi i64)] (-> i64)
  (let [bits (wide-bits t)]
    (when (< bits 128) (emit-canon-int! g hi (- bits 64) (wide-signed? t)) 0)
    0))

;;; Store (`lo`, `hi`), canonical for `t`, into a fresh slot of type `t`.
(defn wide-result! [(g (ptr Cga)) (t (ptr Type)) (lo i64) (hi i64)] (-> AVal)
  (wide-canon! g t hi)
  (let [slot (slot-for-ty! g t)]
    (emit-store-int! g lo 28 slot 8)
    (emit-store-int! g hi 28 (+ slot 8) 8)
    (mk-aval 1 slot (load t))))

;;; Store the bool in `reg` into a fresh slot.
(defn wide-bool-result! [(g (ptr Cga)) (reg i64)] (-> AVal)
  (let [slot (slot-new! (native-context g) 8 8)]
    (emit-store-int! g reg 28 slot 1)
    (mk-aval 1 slot (TBool))))

;;; Call the C function `name` (a compiler-rt helper); its arguments are in
;;; place and its result comes back in x0/x1 or d0.
(defn wide-call! [(g (ptr Cga)) (name (slice u8))] (-> i64)
  (let [s (field g asm)
        sym (g-runtime-sym! g name)]
    (mobj-add-reloc! (mut (.obj g))
                     (.text g)
                     (a64-off (mut s))
                     sym
                     (reloc-branch26)
                     true
                     2)
    (a64-w! (mut s) (a64-bl-raw))
    0))

;;; (rlo, rhi) = (lo, hi) << n, for n in 0..127, without branches.
(defn wide-shl! [(g (ptr Cga)) (lo i64) (hi i64) (n i64) (rlo i64) (rhi i64)]
  (-> i64)
  (let [s (field g asm)]
    (a64-w! (mut s) (a64-lslv 13 hi n))  ; hi << (n mod 64)
    (a64-w! (mut s) (a64-mvn-reg 14 n))  ; 63 - n, mod 64
    (a64-w! (mut s) (a64-lsr-imm 15 lo 1))
    (a64-w! (mut s) (a64-lsrv 15 15 14))  ; lo >> (64 - n), 0 when n = 0
    (a64-w! (mut s) (a64-orr-reg 13 13 15))
    (a64-w! (mut s) (a64-lslv 14 lo n))  ; lo << (n mod 64)
    (a64-mov-imm! (mut s) 15 64)
    (a64-w! (mut s) (a64-tst-reg n 15))
    (a64-w! (mut s) (a64-csel rhi 14 13 (cond-ne)))
    (a64-w! (mut s) (a64-csel rlo 31 14 (cond-ne)))
    0))

;;; (rlo, rhi) = (lo, hi) >> n for n in 0..127: arithmetic when `signed`.
(defn wide-shr! [(g (ptr Cga))
                 (lo i64)
                 (hi i64)
                 (n i64)
                 (signed bool)
                 (rlo i64)
                 (rhi i64)] (-> i64)
  (let [s (field g asm)]
    (a64-w! (mut s) (a64-lsrv 13 lo n))  ; lo >> (n mod 64)
    (a64-w! (mut s) (a64-mvn-reg 14 n))
    (a64-w! (mut s) (a64-lsl-imm 15 hi 1))
    (a64-w! (mut s) (a64-lslv 15 15 14))  ; hi << (64 - n), 0 when n = 0
    (a64-w! (mut s) (a64-orr-reg 13 13 15))
    (a64-w! (mut s) (if signed (a64-asrv 14 hi n) (a64-lsrv 14 hi n)))
    (if signed
        (a64-w! (mut s) (a64-asr-imm 15 hi 63))
        (a64-w! (mut s) (a64-mov-reg 15 31)))
    (a64-mov-imm! (mut s) 12 64)
    (a64-w! (mut s) (a64-tst-reg n 12))
    (a64-w! (mut s) (a64-csel rlo 14 13 (cond-ne)))
    (a64-w! (mut s) (a64-csel rhi 15 14 (cond-ne)))
    0))

;;; (rlo, rhi) = the high 128 bits of the unsigned 256-bit product of (alo, ahi)
;;; and (blo, bhi). Uses x0-x7 and x15; the inputs survive.
(defn wide-umulhi! [(g (ptr Cga))
                    (alo i64)
                    (ahi i64)
                    (blo i64)
                    (bhi i64)
                    (rlo i64)
                    (rhi i64)] (-> i64)
  (let [s (field g asm)]
    ; partial products: a0b0 (only its high word matters), a0b1, a1b0, a1b1
    (a64-w! (mut s) (a64-umulh 0 alo blo))  ; x0 = hi(a0b0)
    (a64-w! (mut s) (a64-mul 1 alo bhi))  ; x1 = lo(a0b1)
    (a64-w! (mut s) (a64-umulh 2 alo bhi))  ; x2 = hi(a0b1)
    (a64-w! (mut s) (a64-mul 3 ahi blo))  ; x3 = lo(a1b0)
    (a64-w! (mut s) (a64-umulh 4 ahi blo))  ; x4 = hi(a1b0)
    (a64-w! (mut s) (a64-mul 5 ahi bhi))  ; x5 = lo(a1b1)
    (a64-w! (mut s) (a64-umulh 6 ahi bhi))  ; x6 = hi(a1b1)
    ; word 1: x0 + x1 + x3, its carries (0..2) into x7
    (a64-w! (mut s) (a64-adds-reg 0 0 1))
    (a64-w! (mut s) (a64-cset 7 (cond-hs)))
    (a64-w! (mut s) (a64-adds-reg 0 0 3))
    (a64-w! (mut s) (a64-cset 15 (cond-hs)))
    (a64-w! (mut s) (a64-add-reg 7 7 15))
    ; word 2: x5 + x2 + x4 + x7, carries into word 3: x6
    (a64-w! (mut s) (a64-adds-reg 5 5 2))
    (a64-w! (mut s) (a64-adc 6 6 31))
    (a64-w! (mut s) (a64-adds-reg 5 5 4))
    (a64-w! (mut s) (a64-adc 6 6 31))
    (a64-w! (mut s) (a64-adds-reg rlo 5 7))
    (a64-w! (mut s) (a64-adc rhi 6 31))
    0))

(defn emit-bin-wide! [(g (ptr Cga))
                      (op i64)
                      (lav AVal)
                      (rav AVal)
                      (t (ptr Type))] (-> AVal)
  (let [s (field g asm)
        signed (wide-signed? t)
        bits (wide-bits t)]
    (cond ; division and remainder: compiler-rt, (x0, x1) by (x2, x3)
          (and (>= op 3) (<= op 6))
            (do
              (wide-to-x! g lav 0 1)
              (wide-to-x! g rav 2 3)
              (wide-call! g
                          (cond (= op 3) (if signed "___divti3" "___udivti3")
                                (= op 4) (if signed "___modti3" "___umodti3")
                                (= op 5) "___udivti3"
                                :else "___umodti3"))
              (wide-result! g t 0 1))
          ; signed multiply overflow: the magnitude of the product must reach no
          ; further than 2^127 - 1, or 2^127 for a negative product
          (and (= op 17) signed)
            (do
              (wide-to-x! g lav 9 10)
              (wide-to-x! g rav 11 12)
              (a64-w! (mut s) (a64-asr-imm 13 10 63))
              (a64-w! (mut s) (a64-asr-imm 14 12 63))
              (a64-w! (mut s) (a64-eor-reg 8 13 14))  ; -1 when the product is negative
              (a64-w! (mut s) (a64-eor-reg 9 9 13))  ; |a|
              (a64-w! (mut s) (a64-eor-reg 10 10 13))
              (a64-w! (mut s) (a64-subs-reg 9 9 13))
              (a64-w! (mut s) (a64-sbc 10 10 13))
              (a64-w! (mut s) (a64-eor-reg 11 11 14))  ; |b|
              (a64-w! (mut s) (a64-eor-reg 12 12 14))
              (a64-w! (mut s) (a64-subs-reg 11 11 14))
              (a64-w! (mut s) (a64-sbc 12 12 14))
              (wide-umulhi! g 9 10 11 12 2 3)
              (a64-w! (mut s) (a64-umulh 13 9 11))  ; low 128 bits of |a| |b|
              (a64-w! (mut s) (a64-madd 13 9 12 13))
              (a64-w! (mut s) (a64-madd 13 10 11 13))
              (a64-w! (mut s) (a64-mul 14 9 11))
              (a64-w! (mut s) (a64-orr-reg 2 2 3))  ; any high bits overflow
              (a64-w! (mut s) (a64-cmp-imm 2 0))
              (a64-w! (mut s) (a64-cset 2 (cond-ne)))
              (a64-w! (mut s) (a64-lsr-imm 3 13 63))  ; so does bit 127 ...
              (a64-mov-imm! (mut s) 4 (<< 1 63))
              (a64-w! (mut s) (a64-eor-reg 4 13 4))
              (a64-w! (mut s) (a64-orr-reg 4 4 14))
              (a64-w! (mut s) (a64-cmp-imm 4 0))
              (a64-w! (mut s) (a64-cset 4 (cond-eq)))  ; ... unless the magnitude is 2^127
              (a64-w! (mut s) (a64-and-reg 4 4 8))  ; and the product negative
              (a64-mov-imm! (mut s) 5 1)
              (a64-w! (mut s) (a64-eor-reg 4 4 5))
              (a64-w! (mut s) (a64-and-reg 3 3 4))
              (a64-w! (mut s) (a64-orr-reg 9 2 3))
              (when (< bits 128)
                ; overflowing the narrower width: the wrapped product changes when
                ; canonicalized
                (wide-to-x! g lav 10 11)
                (wide-to-x! g rav 12 13)
                (a64-w! (mut s) (a64-umulh 14 10 12))
                (a64-w! (mut s) (a64-madd 14 10 13 14))
                (a64-w! (mut s) (a64-madd 14 11 12 14))
                (a64-w! (mut s) (a64-mov-reg 15 14))
                (emit-canon-int! g 15 (- bits 64) true)
                (a64-w! (mut s) (a64-cmp-reg 15 14))
                (a64-w! (mut s) (a64-cset 10 (cond-ne)))
                (a64-w! (mut s) (a64-orr-reg 9 9 10))
                0)
              (wide-bool-result! g 9))
          :else
            (do
              (wide-to-x! g lav 9 10)
              (wide-to-x! g rav 11 12)
              (cond (= op 0)
                      (do
                        (a64-w! (mut s) (a64-adds-reg 9 9 11))
                        (a64-w! (mut s) (a64-adc 10 10 12))
                        (wide-result! g t 9 10))
                    (= op 1)
                      (do
                        (a64-w! (mut s) (a64-subs-reg 9 9 11))
                        (a64-w! (mut s) (a64-sbc 10 10 12))
                        (wide-result! g t 9 10))
                    (= op 2)
                      (do
                        (a64-w! (mut s) (a64-umulh 13 9 11))
                        (a64-w! (mut s) (a64-madd 13 9 12 13))  ; + lo(a0 b1)
                        (a64-w! (mut s) (a64-madd 13 10 11 13))  ; + lo(a1 b0)
                        (a64-w! (mut s) (a64-mul 9 9 11))
                        (wide-result! g t 9 13))
                    (= op 7)
                      (do
                        (a64-w! (mut s) (a64-and-reg 9 9 11))
                        (a64-w! (mut s) (a64-and-reg 10 10 12))
                        (wide-result! g t 9 10))
                    (= op 8)
                      (do
                        (a64-w! (mut s) (a64-orr-reg 9 9 11))
                        (a64-w! (mut s) (a64-orr-reg 10 10 12))
                        (wide-result! g t 9 10))
                    (= op 9)
                      (do
                        (a64-w! (mut s) (a64-eor-reg 9 9 11))
                        (a64-w! (mut s) (a64-eor-reg 10 10 12))
                        (wide-result! g t 9 10))
                    ; shifts take the amount's low word, as the narrower widths take
                    ; the register's low bits
                    (= op 10)
                      (do (wide-shl! g 9 10 11 9 10) (wide-result! g t 9 10))
                    (= op 11)
                      (do
                        (wide-shr! g 9 10 11 signed 9 10)
                        (wide-result! g t 9 10))
                    (or (= op 12) (= op 13))
                      (if (!= bits 128)
                          (do
                            (cga-fail "rotating an integer of a width between 65 and 127 bits is not supported by the arm64 backend")
                            (zeroed AVal))
                          ; rotate by r = n mod 128: (x << r) | (x >> ((128 - r) mod 128)),
                          ; which is x itself when r is 0
                          (do
                            (a64-mov-imm! (mut s) 13 127)
                            (a64-w! (mut s) (a64-and-reg 11 11 13))  ; r
                            (a64-mov-imm! (mut s) 13 128)
                            (a64-w! (mut s) (a64-sub-reg 12 13 11))
                            (a64-mov-imm! (mut s) 13 127)
                            (a64-w! (mut s) (a64-and-reg 12 12 13))  ; (128 - r) mod 128
                            ; rotl: left by r, right by 128 - r; rotr the other way
                            (let [left (if (= op 12) 11 12)
                                  right (if (= op 12) 12 11)]
                              (a64-w! (mut s) (a64-mov-reg 6 left))
                              (a64-w! (mut s) (a64-mov-reg 7 right))
                              (wide-shl! g 9 10 6 2 3)
                              (wide-shr! g 9 10 7 false 4 5)
                              (a64-w! (mut s) (a64-orr-reg 9 2 4))
                              (a64-w! (mut s) (a64-orr-reg 10 3 5))
                              (wide-result! g t 9 10))))
                    (= op 14)
                      (if (!= bits 128)
                          (do
                            (cga-fail "the high half of a product of integers between 65 and 127 bits is not supported by the arm64 backend")
                            (zeroed AVal))
                          (do
                            (wide-umulhi! g 9 10 11 12 2 3)
                            (when signed
                              ; signed high half: subtract b when a < 0 and a when b < 0
                              (a64-w! (mut s) (a64-asr-imm 13 10 63))
                              (a64-w! (mut s) (a64-and-reg 14 11 13))
                              (a64-w! (mut s) (a64-and-reg 15 12 13))
                              (a64-w! (mut s) (a64-subs-reg 2 2 14))
                              (a64-w! (mut s) (a64-sbc 3 3 15))
                              (a64-w! (mut s) (a64-asr-imm 13 12 63))
                              (a64-w! (mut s) (a64-and-reg 14 9 13))
                              (a64-w! (mut s) (a64-and-reg 15 10 13))
                              (a64-w! (mut s) (a64-subs-reg 2 2 14))
                              (a64-w! (mut s) (a64-sbc 3 3 15))
                              0)
                            (wide-result! g t 2 3)))
                    (or (= op 15) (= op 16))
                      (do
                        (a64-w! (mut s)
                                (if (= op 15)
                                    (a64-adds-reg 9 9 11)
                                    (a64-subs-reg 9 9 11)))
                        (a64-w! (mut s)
                                (if (= op 15)
                                    (a64-adcs 10 10 12)
                                    (a64-sbcs 10 10 12)))
                        (if (= bits 128)
                            (a64-w! (mut s)
                                    (a64-cset 9
                                              (cond (and (= op 15) signed)
                                                      6  ; vs
                                                    signed 6
                                                    (= op 15) (cond-hs)
                                                    :else (cond-lo))))
                            (do
                              ; the result overflows the width when canonicalizing changes it
                              (a64-w! (mut s) (a64-mov-reg 13 10))
                              (emit-canon-int! g 13 (- bits 64) signed)
                              (a64-w! (mut s) (a64-cmp-reg 13 10))
                              (a64-w! (mut s) (a64-cset 9 (cond-ne)))
                              0))
                        (wide-bool-result! g 9))
                    (= op 17)
                      ; unsigned multiply overflow: a product of 128-bit factors overflows
                      ; when its high 128 bits are not zero
                      (do
                        (wide-umulhi! g 9 10 11 12 2 3)
                        (a64-w! (mut s) (a64-orr-reg 2 2 3))
                        (a64-w! (mut s) (a64-cmp-imm 2 0))
                        (a64-w! (mut s) (a64-cset 2 (cond-ne)))
                        (when (< bits 128)
                          (a64-w! (mut s) (a64-umulh 13 9 11))
                          (a64-w! (mut s) (a64-madd 13 9 12 13))
                          (a64-w! (mut s) (a64-madd 13 10 11 13))
                          (a64-w! (mut s) (a64-mov-reg 14 13))
                          (emit-canon-int! g 14 (- bits 64) false)
                          (a64-w! (mut s) (a64-cmp-reg 14 13))
                          (a64-w! (mut s) (a64-cset 3 (cond-ne)))
                          (a64-w! (mut s) (a64-orr-reg 2 2 3))
                          0)
                        (wide-bool-result! g 2))
                    :else
                      (do
                        (cga-fail "unknown integer binary op")
                        (zeroed AVal)))))))

;;; Compare wide integers: 0 lt, 1 le, 2 gt, 3 ge, 4 eq, 5 ne.
(defn emit-cmp-wide! [(g (ptr Cga))
                      (op i64)
                      (lav AVal)
                      (rav AVal)
                      (t (ptr Type))] (-> AVal)
  (let [s (field g asm)
        signed (wide-signed? t)]
    (wide-to-x! g lav 9 10)
    (wide-to-x! g rav 11 12)
    (if (>= op 4)
        (do
          (a64-w! (mut s) (a64-eor-reg 13 9 11))
          (a64-w! (mut s) (a64-eor-reg 14 10 12))
          (a64-w! (mut s) (a64-orr-reg 13 13 14))
          (a64-w! (mut s) (a64-cmp-imm 13 0))
          (a64-w! (mut s) (a64-cset 9 (if (= op 4) (cond-eq) (cond-ne)))))
        ; the flags of a - b decide lt and ge; le and gt take those of b - a
        (let [swap (or (= op 1) (= op 2))]
          (if swap
              (do
                (a64-w! (mut s) (a64-cmp-reg 11 9))
                (a64-w! (mut s) (a64-sbcs 31 12 10)))
              (do
                (a64-w! (mut s) (a64-cmp-reg 9 11))
                (a64-w! (mut s) (a64-sbcs 31 10 12))))
          (a64-w! (mut s)
                  (a64-cset 9
                            (cond (or (= op 0) (= op 2))
                                    (if signed (cond-lt) (cond-lo))
                                  :else (if signed (cond-ge) (cond-hs)))))))
    (wide-bool-result! g 9)))

;;; Integer unary operations on wide integers: 0 not, 1 clz, 2 ctz, 3 popcount,
;;; 4 bswap. A count is of the type's own width.
(defn emit-int-unary-wide! [(g (ptr Cga)) (op i64) (av AVal) (t (ptr Type))]
  (-> AVal)
  (let [s (field g asm)
        bits (wide-bits t)]
    (wide-to-x! g av 9 10)
    (cond (= op 0)
            (do
              (a64-w! (mut s) (a64-mvn-reg 9 9))
              (a64-w! (mut s) (a64-mvn-reg 10 10))
              (wide-result! g t 9 10))
          :else
            (do
              ; count the bits of the value as an unsigned number of its width
              (when (< bits 128) (emit-canon-int! g 10 (- bits 64) false) 0)
              (cond (= op 1)
                      ; clz = hi != 0 ? clz(hi) : 64 + clz(lo), less the bits above the width
                      (do
                        (a64-w! (mut s) (a64-clz 11 10))
                        (a64-w! (mut s) (a64-clz 12 9))
                        (a64-w! (mut s) (a64-add-imm 12 12 64))
                        (a64-w! (mut s) (a64-cmp-imm 10 0))
                        (a64-w! (mut s) (a64-csel 9 12 11 (cond-eq)))
                        (when (< bits 128)
                          (a64-w! (mut s) (a64-sub-imm 9 9 (- 128 bits)))
                          0)
                        (a64-w! (mut s) (a64-mov-reg 10 31))
                        (wide-result! g t 9 10))
                    (= op 2)
                      ; ctz = lo != 0 ? ctz(lo) : 64 + ctz(hi), and the width for zero
                      (do
                        (a64-w! (mut s) (a64-rbit 11 9))
                        (a64-w! (mut s) (a64-clz 11 11))
                        (a64-w! (mut s) (a64-rbit 12 10))
                        (a64-w! (mut s) (a64-clz 12 12))
                        (a64-w! (mut s) (a64-add-imm 12 12 64))
                        (a64-w! (mut s) (a64-cmp-imm 9 0))
                        (a64-w! (mut s) (a64-csel 11 12 11 (cond-eq)))
                        (a64-w! (mut s) (a64-orr-reg 13 9 10))
                        (a64-w! (mut s) (a64-cmp-imm 13 0))
                        (a64-mov-imm! (mut s) 14 bits)
                        (a64-w! (mut s) (a64-csel 9 14 11 (cond-eq)))
                        (a64-w! (mut s) (a64-mov-reg 10 31))
                        (wide-result! g t 9 10))
                    (= op 3)
                      ; popcount of each word, by the same SWAR steps as a 64-bit one
                      (do
                        (wide-popcount-word! g 9)
                        (wide-popcount-word! g 10)
                        (a64-w! (mut s) (a64-add-reg 9 9 10))
                        (a64-w! (mut s) (a64-mov-reg 10 31))
                        (wide-result! g t 9 10))
                    :else
                      (if (!= bits 128)
                          (do
                            (cga-fail "byte-swapping an integer between 65 and 127 bits is not supported by the arm64 backend")
                            (zeroed AVal))
                          (do
                            (a64-w! (mut s) (a64-rev 11 10))
                            (a64-w! (mut s) (a64-rev 12 9))
                            (wide-result! g t 11 12))))))))

;;; reg = the number of set bits in reg (x13-x15 are scratch).
(defn wide-popcount-word! [(g (ptr Cga)) (reg i64)] (-> i64)
  (let [s (field g asm)]
    (a64-w! (mut s) (a64-lsr-imm 13 reg 1))
    (a64-mov-imm! (mut s) 14 0x5555555555555555)
    (a64-w! (mut s) (a64-and-reg 13 13 14))
    (a64-w! (mut s) (a64-sub-reg reg reg 13))
    (a64-mov-imm! (mut s) 14 0x3333333333333333)
    (a64-w! (mut s) (a64-and-reg 13 reg 14))
    (a64-w! (mut s) (a64-lsr-imm reg reg 2))
    (a64-w! (mut s) (a64-and-reg reg reg 14))
    (a64-w! (mut s) (a64-add-reg reg reg 13))
    (a64-w! (mut s) (a64-lsr-imm 13 reg 4))
    (a64-w! (mut s) (a64-add-reg reg reg 13))
    (a64-mov-imm! (mut s) 14 0x0f0f0f0f0f0f0f0f)
    (a64-w! (mut s) (a64-and-reg reg reg 14))
    (a64-w! (mut s) (a64-lsr-imm 13 reg 8))
    (a64-w! (mut s) (a64-add-reg reg reg 13))
    (a64-w! (mut s) (a64-lsr-imm 13 reg 16))
    (a64-w! (mut s) (a64-add-reg reg reg 13))
    (a64-w! (mut s) (a64-lsr-imm 13 reg 32))
    (a64-w! (mut s) (a64-add-reg reg reg 13))
    (a64-mov-imm! (mut s) 14 127)
    (a64-w! (mut s) (a64-and-reg reg reg 14))
    0))

;;; A cast to or from a wide integer (`dt` the target).
(defn emit-cast-wide! [(g (ptr Cga)) (dt (ptr Type)) (av AVal)] (-> AVal)
  (let [s (field g asm)
        (mut st) (: (av-ty av) Type)]
    (cond ; wide -> wide: the same bits, canonical for the target
          (and (ty-wide-int? (mut st))
               (ty-wide-int? dt))
            (do (wide-to-x! g av 9 10) (wide-result! g dt 9 10))
          ; float -> wide: compiler-rt, signedness of the target
          (ty-is-float (mut st))
            (let [single (= (ty-float-bytes (mut st)) 4)
                  signed (wide-signed? dt)]
              (av-to-d! g av 0)
              (wide-call! g
                          (cond (and single signed) "___fixsfti"
                                single "___fixunssfti"
                                signed "___fixdfti"
                                :else "___fixunsdfti"))
              (wide-result! g dt 0 1))
          ; narrower int, bool or pointer -> wide: extend by the source's signedness
          (ty-wide-int? dt)
            (let [ssigned (match st (TInt [_ sg] sg) (_ false))]
              (av-to-x! g av 9)
              (if ssigned
                  (a64-w! (mut s) (a64-asr-imm 10 9 63))
                  (a64-w! (mut s) (a64-mov-reg 10 31)))
              (wide-result! g dt 9 10))
          ; wide -> float: compiler-rt, signedness of the source
          (ty-is-float dt)
            (let [single (= (ty-float-bytes dt) 4)
                  signed (wide-signed? (mut st))
                  slot (slot-for-ty! g dt)]
              (wide-to-x! g av 0 1)
              (wide-call! g
                          (cond (and single signed) "___floattisf"
                                single "___floatuntisf"
                                signed "___floattidf"
                                :else "___floatuntidf"))
              (emit-store-fp! g 0 28 slot (ty-float-bytes dt))
              (mk-aval 1 slot (load dt)))
          ; wide -> narrower int, bool or pointer: the low word, canonical for the target
          :else
            (let [slot (slot-for-ty! g dt)]
              (wide-to-x! g av 9 10)
              (match (load dt)
                (TInt [bits signed] (emit-canon-int! g 9 bits signed))
                (TBool []
                       (do
                         (a64-w! (mut s) (a64-orr-reg 9 9 10))
                         (a64-w! (mut s) (a64-cmp-imm 9 0))
                         (a64-w! (mut s) (a64-cset 9 (cond-ne)))))
                (_ 0))
              (emit-store-int! g 9 28 slot (ty-size g dt))
              (mk-aval 1 slot (load dt))))))

;;; A wide literal's bits in a fresh slot.
(defn emit-wide-literal! [(g (ptr Cga)) (lo i64) (hi i64)] (-> AVal)
  (let [s (field g asm)
        (mut t) (TInt 128 true)]
    (a64-mov-imm! (mut s) 9 lo)
    (a64-mov-imm! (mut s) 10 hi)
    (wide-result! g (mut t) 9 10)))

; ---- arithmetic -------------------------------------------------------------
(defn emit-bin [(g (ptr Cga)) (op i64) (lhs (ptr Expr)) (rhs (ptr Expr))]
  (-> AVal)
  (emit-bin-av! g op (emit-expr g lhs) (emit-expr g rhs)))

; AVal-level core of emit-bin, shared with the llvm-ir line interpreter so both
; paths emit the exact same instruction sequences.
(defn emit-bin-av! [(g (ptr Cga)) (op i64) (lav AVal) (rav AVal)] (-> AVal)
  (let [(mut t) (av-ty lav)
        s (field g asm)]
    (if (ty-wide-int? (mut t))
        (emit-bin-wide! g op lav rav (mut t))
        (if (ty-is-float (mut t))
            ; float ops: 0 add 1 sub 2 mul 3 div 4 rem(unsupported)
            (let [fb (ty-float-bytes (mut t))
                  fty (unless (= fb 4) 1)]
              (av-to-d! g lav 0)
              (av-to-d! g rav 1)
              (cond (= op 0) (a64-w! (mut s) (a64-fadd fty 0 0 1))
                    (= op 1) (a64-w! (mut s) (a64-fsub fty 0 0 1))
                    (= op 2) (a64-w! (mut s) (a64-fmul fty 0 0 1))
                    (= op 3) (a64-w! (mut s) (a64-fdiv fty 0 0 1))
                    (= op 4)  ; frem: libm fmod(d0,d1) — args are already in d0/d1
                      (let [fsym
                              (g-runtime-sym! g
                                              (if (= fb 4)
                                                  "_fmodf"
                                                  "_fmod"))]
                        (mobj-add-reloc! (mut (.obj g))
                                         (.text g)
                                         (a64-off (mut s))
                                         fsym
                                         (reloc-branch26)
                                         true
                                         2)
                        (a64-w! (mut s) (a64-bl-raw)))
                    :else (cga-fail "unsupported float binary op"))
              (let [slot
                      (slot-for-ty! g
                                    (mut t))]
                (emit-store-fp! g 0 28 slot fb)
                (mk-aval 1 slot (av-ty lav))))
            ; integer ops
            (let [signed
                    (match t
                      (TInt [_b sg] sg)
                      (_ false))]
              (av-to-x! g lav 9)
              (av-to-x! g rav 10)
              (cond (= op 0) (a64-w! (mut s) (a64-add-reg 9 9 10))
                    (= op 1) (a64-w! (mut s) (a64-sub-reg 9 9 10))
                    (= op 2) (a64-w! (mut s) (a64-mul 9 9 10))
                    (= op 3)
                      (a64-w! (mut s)
                              (if signed (a64-sdiv 9 9 10) (a64-udiv 9 9 10)))
                    (= op 4)  ; rem: q = div(a,b); r = a - q*b   (msub x9, x11, x10, x9)
                      (do
                        (a64-w! (mut s)
                                (if signed
                                    (a64-sdiv 11 9 10)
                                    (a64-udiv 11 9 10)))
                        (a64-w! (mut s) (a64-msub 9 11 10 9)))
                    (= op 5) (a64-w! (mut s) (a64-udiv 9 9 10))
                    (= op 6)
                      (do
                        (a64-w! (mut s) (a64-udiv 11 9 10))
                        (a64-w! (mut s) (a64-msub 9 11 10 9)))
                    (= op 7) (a64-w! (mut s) (a64-and-reg 9 9 10))
                    (= op 8) (a64-w! (mut s) (a64-orr-reg 9 9 10))
                    (= op 9) (a64-w! (mut s) (a64-eor-reg 9 9 10))
                    (= op 10) (a64-w! (mut s) (a64-lslv 9 9 10))
                    (= op 11)
                      (a64-w! (mut s)
                              (if signed (a64-asrv 9 9 10) (a64-lsrv 9 9 10)))
                    (= op 12)
                      (let [nbits
                              (match t
                                (TInt [n _] n)
                                (_ 64))]
                        (a64-mov-imm! (mut s) 12 nbits)
                        (a64-w! (mut s) (a64-udiv 11 10 12))
                        (a64-w! (mut s) (a64-msub 10 11 12 10))
                        (a64-w! (mut s) (a64-lslv 11 9 10))
                        (a64-w! (mut s) (a64-sub-reg 12 12 10))
                        (a64-w! (mut s) (a64-lsrv 12 9 12))
                        (a64-w! (mut s) (a64-orr-reg 9 11 12)))
                    (= op 13)
                      (let [nbits
                              (match t
                                (TInt [n _] n)
                                (_ 64))]
                        (a64-mov-imm! (mut s) 12 nbits)
                        (a64-w! (mut s) (a64-udiv 11 10 12))
                        (a64-w! (mut s) (a64-msub 10 11 12 10))
                        (a64-w! (mut s) (a64-lsrv 11 9 10))
                        (a64-w! (mut s) (a64-sub-reg 12 12 10))
                        (a64-w! (mut s) (a64-lslv 12 9 12))
                        (a64-w! (mut s) (a64-orr-reg 9 11 12)))
                    (= op 14)
                      (do
                        (a64-w! (mut s) (a64-mul 11 9 10))
                        (a64-w! (mut s)
                                (if signed
                                    (a64-smulh 12 9 10)
                                    (a64-umulh 12 9 10)))
                        (if (= (match t
                                 (TInt [n _] n)
                                 (_ 64))
                               64)
                            (a64-w! (mut s) (a64-orr-reg 9 12 31))
                            (let [nbits
                                    (match t
                                      (TInt [n _] n)
                                      (_ 64))]
                              (a64-w! (mut s) (a64-lsr-imm 11 11 nbits))
                              (a64-w! (mut s)
                                      (a64-lsl-imm 12
                                                   12
                                                   (primitive/isub 64 nbits)))
                              (a64-w! (mut s) (a64-orr-reg 9 11 12)))))
                    (= op 15)
                      (let [nbits
                              (match t
                                (TInt [n _] n)
                                (_ 64))]
                        (if (= nbits 64)
                            (do
                              (a64-w! (mut s) (a64-adds-reg 9 9 10))
                              (a64-w! (mut s) (a64-cset 9 (if signed 6 2))))
                            (do
                              (a64-w! (mut s) (a64-add-reg 11 9 10))
                              (a64-w! (mut s) (a64-orr-reg 12 11 31))
                              (emit-canon-int! g 12 nbits signed)
                              (if signed
                                  (do
                                    (a64-w! (mut s) (a64-cmp-reg 11 12))
                                    (a64-w! (mut s) (a64-cset 9 1)))
                                  (do
                                    (a64-w! (mut s) (a64-cmp-reg 12 9))
                                    (a64-w! (mut s) (a64-cset 9 3)))))))
                    (= op 16)
                      (let [nbits
                              (match t
                                (TInt [n _] n)
                                (_ 64))]
                        (if (= nbits 64)
                            (do
                              (a64-w! (mut s) (a64-subs-reg 9 9 10))
                              (a64-w! (mut s) (a64-cset 9 (if signed 6 3))))
                            (if signed
                                (do
                                  (a64-w! (mut s) (a64-sub-reg 11 9 10))
                                  (a64-w! (mut s) (a64-orr-reg 12 11 31))
                                  (emit-canon-int! g 12 nbits true)
                                  (a64-w! (mut s) (a64-cmp-reg 11 12))
                                  (a64-w! (mut s) (a64-cset 9 1)))
                                (do
                                  (a64-w! (mut s) (a64-cmp-reg 9 10))
                                  (a64-w! (mut s) (a64-cset 9 3))))))
                    (= op 17)
                      (do
                        (a64-w! (mut s) (a64-mul 11 9 10))
                        (a64-w! (mut s)
                                (if signed
                                    (a64-smulh 12 9 10)
                                    (a64-umulh 12 9 10)))
                        (a64-w! (mut s) (a64-orr-reg 13 11 31))
                        (match t
                          (TInt [n sg] (emit-canon-int! g 13 n sg))
                          (_ 0))
                        (a64-w! (mut s) (a64-cmp-reg 11 13))
                        (a64-w! (mut s) (a64-cset 14 1))
                        (if signed
                            (a64-w! (mut s) (a64-asr-imm 13 13 63))
                            (a64-mov-imm! (mut s) 13 0))
                        (a64-w! (mut s) (a64-cmp-reg 12 13))
                        (a64-w! (mut s) (a64-cset 9 1))
                        (a64-w! (mut s) (a64-orr-reg 9 9 14)))
                    :else (cga-fail "unknown integer binary op"))
              (unless (>= op 15)
                (match t
                  (TInt [bits sg] (emit-canon-int! g 9 bits sg))
                  (_ 0)))
              (let [outty
                      (if (>= op 15)
                          (TBool)
                          t)
                    (mut outp) outty]
                (let [slot (slot-for-ty! g (mut outp))]
                  (emit-store-int! g 9 28 slot (ty-size g (mut outp)))
                  (mk-aval 1 slot outty))))))))

(defn emit-cmp [(g (ptr Cga)) (op i64) (lhs (ptr Expr)) (rhs (ptr Expr))]
  (-> AVal)
  (emit-cmp-av! g op (emit-expr g lhs) (emit-expr g rhs)))

; AVal-level core of emit-cmp, shared with the llvm-ir line interpreter.
(defn emit-cmp-av! [(g (ptr Cga)) (op i64) (lav AVal) (rav AVal)] (-> AVal)
  (let [(mut t) (av-ty lav)
        s (field g asm)]
    (if (ty-wide-int? (mut t))
        (emit-cmp-wide! g op lav rav (mut t))
        (if (ty-is-float (mut t))
            ; float: ordered predicates. 0 lt->mi 1 le->ls 2 gt->gt 3 ge->ge 4 eq->eq 5 one
            (let [fty
                    (unless (= (ty-float-bytes (mut t))
                               4)
                      1)]
              (av-to-d! g lav 0)
              (av-to-d! g rav 1)
              (a64-w! (mut s) (a64-fcmp fty 0 1))
              (if (= op 5)
                  ; ONE = ordered and not-equal: (ne && vc)
                  (do
                    (a64-w! (mut s) (a64-cset 9 (cond-ne)))
                    (a64-w! (mut s) (a64-cset 10 (cond-vc)))
                    (a64-w! (mut s) (a64-and-reg 9 9 10))
                    0)
                  (do
                    (a64-w! (mut s)
                            (a64-cset 9
                                      (cond (= op 0) (cond-mi)
                                            (= op 1) (cond-ls)
                                            (= op 2) (cond-gt)
                                            (= op 3) (cond-ge)
                                            :else (cond-eq))))
                    0))
              (let [slot (slot-new! (native-context g) 8 8)]
                (emit-store-int! g 9 28 slot 1)
                (mk-aval 1 slot (TBool))))
            (let [signed
                    (match t
                      (TInt [_b sg] sg)
                      (TBool [] false)
                      (_ true))]
              (av-to-x! g lav 9)
              (av-to-x! g rav 10)
              (a64-w! (mut s) (a64-cmp-reg 9 10))
              (a64-w! (mut s)
                      (a64-cset 9
                                (cond (= op 0) (if signed (cond-lt) (cond-lo))
                                      (= op 1) (if signed (cond-le) (cond-ls))
                                      (= op 2) (if signed (cond-gt) (cond-hi))
                                      (= op 3) (if signed (cond-ge) (cond-hs))
                                      (= op 4) (cond-eq)
                                      :else (cond-ne))))
              (let [slot (slot-new! (native-context g) 8 8)]
                (emit-store-int! g 9 28 slot 1)
                (mk-aval 1 slot (TBool))))))))

; ---- control flow -----------------------------------------------------------
; ---- self-tail-call optimization ------------------------------------------
; Without this the arm64 backend turns every self-recursive tail call into a real
; BL, so a tail-recursive function consumes a frame per iteration and dies of stack
; exhaustion where the LLVM backend — which does this — runs it in constant space.
; That is a plain miscompile-by-omission at RUNTIME (`coil build --backend arm64`
; segfaults on a program LLVM runs fine), and comptime inherits it because the
; comptime thunk is built by THIS backend: the reported "runaway comptime crashes
; the compiler" was this, not a comptime defect.
;
; Eligible when the callee is the function being emitted, the arity matches its
; recorded parameter slots, and every parameter was spilled to a slot (the ordinary
; case — recorded during intake). Anything else falls back to a normal call, so the
; optimization can only ever be skipped, never misapplied.
(defn tail-self-callable? [(g (ptr Cga))
                           (func (slice u8))
                           (args (ptr (ArrayList Expr)))] (-> bool)
  (and (> (len (.selfname g)) 0)
       (and (= func (.selfname g))
            (= (len (load args))
               (len (load (load (field g tailslots))))))))

; Evaluate the arguments into FRESH slots first, then copy those into the parameter
; slots, then jump. The two phases are not an optimization detail: `(f b a)` swapping
; its arguments would otherwise overwrite the first parameter before the second
; argument had read it.
(defn emit-tail-self-call! [(g (ptr Cga)) (args (ptr (ArrayList Expr)))]
  (-> AVal)
  (let [n (len (load args))
        tmps
          (box! (.a g)
                (ArrayList i64)
                (zeroed (ArrayList i64)))
        (mut i) 0]
    (set! tmps (ArrayList::new [i64] (.a g)))
    (loop (if (>= (load i) n)
              (break)
              (do
                (let [av (emit-expr g (al-at [Expr] args (load i)))
                      (mut t) (get (load (load (field g tailtys))) (load i))]
                  (let [ts (slot-for-ty! g (mut t))]
                    (emit-store-av! g av ts)
                    (push! tmps ts)))
                (set! i (primitive/iadd (load i) 1)))))
    (set! i 0)
    (loop (if (>= (load i) n)
              (break)
              (do
                (let [(mut t) (get (load (load (field g tailtys))) (load i))]
                  (let [dst (get (load (load (field g tailslots))) (load i))
                        src (get (load tmps) (load i))
                        sz (ty-size g (mut t))]
                    (emit-copy-slot! g dst src sz)))
                (set! i (primitive/iadd (load i) 1)))))
    (a64-b-label! (mut (.asm g)) (.entrylabel g))
    ; the jump never falls through, so the surrounding `if`/body treats this arm as
    ; terminated and emits no result store — the same path `break` already used.
    (set! (.terminated g) true)
    (mk-aval 0 0 (TInt 64 true))))

; `if` is the one construct that propagates tail position: both branches of a tail
; `if` are themselves in tail position; the CONDITION never is.
(defn emit-if-tail [(g (ptr Cga))
                    (cnd (ptr Expr))
                    (thn (ptr Expr))
                    (els (ptr Expr))
                    (am-tail bool)] (-> AVal)
  (let [cav (emit-expr g cnd)
        s (field g asm)
        lelse (a64-new-label (mut (.asm g)))
        lend (a64-new-label (mut (.asm g)))]
    (av-to-x! g cav 9)
    (a64-cbz-label! (mut (.asm g)) 9 lelse)
    (set! (.tailok g) am-tail)
    (let [thnav (emit-expr g thn)
          thnterm (.terminated g)
          (mut rslot) -1
          (mut rty) (TInt 64 true)]
      (unless thnterm
        (let [(mut tt) (av-ty thnav)]
          (set! rslot (slot-for-ty! g (mut tt)))
          (set! rty (av-ty thnav))
          (emit-store-av! g thnav (load rslot)))
        (a64-b-label! (mut (.asm g)) lend)
        0)
      (set! (.terminated g) false)
      (a64-bind-label! (mut (.asm g)) lelse)
      (set! (.tailok g) am-tail)
      (let [elsav (emit-expr g els)
            elsterm (.terminated g)]
        (unless elsterm
          (let [(mut et) (av-ty elsav)]
            (when (< (load rslot) 0)
              (set! rslot (slot-for-ty! g (mut et)))
              (set! rty (av-ty elsav))
              0)
            (emit-store-av! g elsav (load rslot)))
          0)
        (a64-bind-label! (mut (.asm g)) lend)
        (set! (.terminated g) (and thnterm elsterm))
        (if (>= (load rslot) 0)
            (mk-aval 1 (load rslot) (load rty))
            (mk-aval 0 0 (TInt 64 true)))))))

(defn emit-if [(g (ptr Cga)) (cnd (ptr Expr)) (thn (ptr Expr)) (els (ptr Expr))]
  (-> AVal)
  (let [cav (emit-expr g cnd)
        s (field g asm)
        lelse (a64-new-label (mut (.asm g)))
        lend (a64-new-label (mut (.asm g)))]
    (av-to-x! g cav 9)
    (a64-cbz-label! (mut (.asm g)) 9 lelse)
    (let [thnav (emit-expr g thn)
          thnterm (.terminated g)
          (mut rslot) -1
          (mut rty) (TInt 64 true)]
      (unless thnterm
        (let [(mut tt) (av-ty thnav)]
          (set! rslot (slot-for-ty! g (mut tt)))
          (set! rty (av-ty thnav))
          (emit-store-av! g thnav (load rslot)))
        (a64-b-label! (mut (.asm g)) lend)
        0)
      (set! (.terminated g) false)
      (a64-bind-label! (mut (.asm g)) lelse)
      (let [elsav (emit-expr g els)
            elsterm (.terminated g)]
        (unless elsterm
          (let [(mut et) (av-ty elsav)]
            (when (< (load rslot) 0)
              (set! rslot (slot-for-ty! g (mut et)))
              (set! rty (av-ty elsav))
              0)
            (emit-store-av! g elsav (load rslot)))
          0)
        (a64-bind-label! (mut (.asm g)) lend)
        (set! (.terminated g) (and thnterm elsterm))
        (if (>= (load rslot) 0)
            (mk-aval 1 (load rslot) (load rty))
            (mk-aval 0 0 (TInt 64 true)))))))

(defn emit-loop [(g (ptr Cga))
                 (label (Option (slice u8)))
                 (body (ptr (ArrayList Expr)))] (-> AVal)
  (let [s (field g asm)
        contlabel (a64-new-label (mut (.asm g)))
        breaklabel (a64-new-label (mut (.asm g)))
        gl (primitive/alloc-stack GLoop)]
    (set! (.label gl) label)
    (set! (.contlabel gl) contlabel)
    (set! (.breaklabel gl) breaklabel)
    (set! (.resslot gl) -1)
    (set! (.resty gl) (TInt 64 true))
    (set! (.has_res gl) false)
    (push! (mut (.loops g)) (load gl))
    (a64-bind-label! (mut (.asm g)) contlabel)
    (emit-stmts g body)
    (unless (.terminated g)
      (a64-b-label! (mut (.asm g)) contlabel)
      0)
    ; pop the loop frame and read its break results
    (let [n (len (.loops g))
          fin (get (.loops g) (primitive/isub n 1))
          fp (primitive/alloc-stack GLoop)]
      (set! fp fin)
      (set! (.len (.loops g)) (primitive/isub n 1))
      (a64-bind-label! (mut (.asm g)) breaklabel)
      (if (.has_res fp)
          (do
            (set! (.terminated g) false)
            (mk-aval 1 (.resslot fp) (.resty fp)))
          (do
            (set! (.terminated g) true)
            (mk-aval 0 0 (TInt 64 true)))))))

(defn emit-break [(g (ptr Cga))
                  (label (Option (slice u8)))
                  (value (Option (ptr Expr)))] (-> AVal)
  (if (.terminated g)
      (mk-aval 0 0 (TInt 64 true))
      (let [av
              (match value
                (Some [ve] (emit-expr g ve))
                (None [] (mk-aval 0 0 (TInt 64 true))))
            li (g-loop-index (native-context g) label)
            lp (al-at [GLoop] (field g loops) li)]
        (when (< (.resslot lp) 0)
          (let [(mut t) (av-ty av)]
            (set! (.resslot lp) (slot-for-ty! g (mut t)))
            (set! (.resty lp) (av-ty av))
            (set! (.has_res lp) true))
          0)
        (emit-store-av! g av (.resslot lp))
        (a64-b-label! (mut (.asm g)) (.breaklabel lp))
        (set! (.terminated g) true)
        (mk-aval 0 0 (TInt 64 true)))))

; ---- casts ------------------------------------------------------------------
(defn emit-cast [(g (ptr Cga)) (t Type) (inner (ptr Expr))] (-> AVal)
  (emit-cast-av! g t (emit-expr g inner)))

; AVal-level core of emit-cast, shared with the llvm-ir line interpreter.
(defn emit-cast-av! [(g (ptr Cga)) (t Type) (av AVal)] (-> AVal)
  (let [(mut st) (av-ty av)
        (mut dt)
          (: t
             Type)
        s (field g asm)]
    (if (or (ty-wide-int? (mut st)) (ty-wide-int? (mut dt)))
        (emit-cast-wide! g (mut dt) av)
        (match t
          (TInt [dbits dsigned]
                (if (ty-is-float (mut st))
                    ; float -> int (toward zero), signedness of the TARGET
                    (let [fty
                            (unless (= (ty-float-bytes (mut st))
                                       4)
                              1)
                          slot
                            (slot-for-ty! g
                                          (mut dt))]
                      (av-to-d! g av 0)
                      (a64-w! (mut s)
                              (if dsigned
                                  (a64-fcvtzs fty 9 0)
                                  (a64-fcvtzu fty 9 0)))
                      (emit-store-int! g
                                       9
                                       28
                                       slot
                                       (ty-size g
                                                (mut dt)))
                      (mk-aval 1 slot t))
                    ; int/ptr -> int: source-extended load, canonicalize to dest width
                    (let [slot
                            (slot-for-ty! g
                                          (mut dt))]
                      (av-to-x! g av 9)
                      (emit-canon-int! g 9 dbits dsigned)
                      (emit-store-int! g
                                       9
                                       28
                                       slot
                                       (ty-size g
                                                (mut dt)))
                      (mk-aval 1 slot t))))
          (TFloat [dbits]
                  (let [dfty (unless (= dbits 32) 1)
                        slot
                          (slot-for-ty! g
                                        (mut dt))]
                    (if (ty-is-float (mut st))
                        (do
                          (av-to-d! g av 0)
                          (unless (= (ty-float-bytes (mut st))
                                     (/ dbits 8))
                            (if (= dbits 64)
                                (a64-w! (mut s) (a64-fcvt-s-to-d 0 0))
                                (a64-w! (mut s) (a64-fcvt-d-to-s 0 0))))
                          (emit-store-fp! g 0 28 slot (/ dbits 8))
                          0)
                        ; int -> float, signedness of the SOURCE
                        (let [ssigned
                                (match st
                                  (TInt [_b sg] sg)
                                  (_ true))]
                          (av-to-x! g av 9)
                          (a64-w! (mut s)
                                  (if ssigned
                                      (a64-scvtf dfty 0 9)
                                      (a64-ucvtf dfty 0 9)))
                          (emit-store-fp! g 0 28 slot (/ dbits 8))
                          0))
                    (mk-aval 1 slot t)))
          (_  ; ptr / fnptr targets: bit-identical 8-byte move
             (let [slot
                     (slot-for-ty! g
                                   (mut dt))]
               (av-to-x! g av 9)
               (emit-store-int! g 9 28 slot 8)
               (mk-aval 1 slot t)))))))

; ---- sums -------------------------------------------------------------------
(defn emit-construct [(g (ptr Cga))
                      (sum (slice u8))
                      (variant (slice u8))
                      (args (ptr (ArrayList Expr)))] (-> AVal)
  (let [su (g-sum-idx g sum)]
    (when (< su 0)
      (cga-fail2 "construct of unknown sum: " sum))
    (let [vidx (g-variant-idx g su variant)
          (mut sumty) (TStruct sum)]
      (let [slot
              (slot-for-ty! g
                            (mut sumty))
            vs (load (field (sum-at (field g layouts) su) variants))
            vfields (load (field (al-at [Variant] vs vidx) fields))
            n (len (load args))]
        ; tag (i32 at offset 0)
        (a64-mov-imm! (mut (.asm g)) 9 vidx)
        (emit-store-int! g 9 28 slot 4)
        ; payload fields at their natural offsets within the variant struct
        (for [i 0 n]
          (let [av (emit-expr g (al-at [Expr] args i))
                off (g-natural-off g vfields i)]
            (emit-store-av-at! g
                               av
                               (primitive/iadd (primitive/iadd slot 8)
                                               off))))
        (mk-aval 1 slot (TStruct sum))))))

; store an AVal at an absolute slot byte offset (may be unaligned-in-slot for
; sub-slot fields — offsets are still 1/2/4/8-aligned by construction).
(defn emit-store-av-at! [(g (ptr Cga)) (av AVal) (dst i64)] (-> i64)
  (let [(mut t) (av-ty av)]
    (if (ty-is-scalar (mut t))
        (do
          (av-to-x! g av 9)
          (emit-store-int! g 9 28 dst (ty-size g (mut t)))
          0)
        (emit-copy! g dst (av-slot! g av) (ty-size g (mut t))))))

(defn emit-match [(g (ptr Cga)) (scrut (ptr Expr)) (arms (ptr (ArrayList Arm)))]
  (-> AVal)
  (let [sav (emit-expr g scrut)
        (mut t) (av-ty sav)
        s (field g asm)
        a (.a g)]
    (let [borrowed
            (match t
              (TPtr [inner] (match (load inner) (TStruct [_] true) (_ false)))
              (_ false))
          sumname
            (match t
              (TStruct [nm] nm)
              (TPtr [inner] (match (load inner) (TStruct [nm] nm) (_ "")))
              (_ ""))
          su (g-sum-idx g sumname)]
      (when (< su 0)
        (cga-fail2 "match on non-sum: " sumname))
      (let [sslot (av-slot! g sav)
            vs (load (field (sum-at (field g layouts) su) variants))
            narms (len (load arms))
            ; a trailing `(_ …)` arm is the fallthrough, so it gets a label but no
            ; comparison — the chain branches to it instead of trapping.
            ncases (if (arms-have-wildcard arms) (primitive/isub narms 1) narms)
            lend (a64-new-label (mut (.asm g)))
            (mut armlabels) (ArrayList::new [i64] a)
            (mut rslot) -1
            (mut rty) (TInt 64 true)
            (mut anylive) false]
        ; tag -> x9, then the compare/branch chain
        (if borrowed
            (do
              (emit-load-int! g 11 28 sslot 8 false)
              (emit-load-from-mem! g 9 11 4))
            (emit-load-int! g 9 28 sslot 4 false))
        (let [(mut i) 0]
          (loop (if (>= (load i) narms)
                    (break)
                    (do
                      (let [arm (al-at [Arm] arms (load i))
                            lab (a64-new-label (mut (.asm g)))]
                        (push! (mut armlabels) lab)
                        (unless (>= (load i) ncases)
                          (let [vidx
                                  (g-variant-idx g
                                                 su
                                                 (.variant arm))]
                            (a64-mov-imm! (mut (.asm g)) 10 vidx)
                            (a64-w! (mut s) (a64-cmp-reg 9 10))
                            (a64-bcond-label! (mut (.asm g)) (cond-eq) lab))))
                      (set! i (primitive/iadd (load i) 1))))))
        ; no arm matched: the catch-all if there is one, else unreachable
        (if (= ncases narms)
            (a64-w! (mut s) (a64-brk 61680))
            (a64-b-label! (mut (.asm g)) (get (load armlabels) ncases)))
        ; arms
        (let [(mut i) 0]
          (loop (if (>= (load i) narms)
                    (break)
                    (do
                      (let [arm (al-at [Arm] arms (load i))
                            ; the catch-all binds nothing, so `vfields` is never read;
                            ; variant 0 just keeps the lookup in range.
                            vidx
                              (if (>= (load i) ncases)
                                  0
                                  (g-variant-idx g su (.variant arm)))
                            vfields
                              (load (field (al-at [Variant] vs vidx) fields))
                            saved (load (field g env))]
                        (a64-bind-label! (mut (.asm g))
                                         (get (load armlabels) (load i)))
                        (set! (.terminated g) false)
                        ; bind payload fields BY VALUE into fresh slots
                        (let [binds (load (field arm binds))
                              nb (len (load binds))
                              (mut j) 0]
                          (loop (if (>= (load j) nb)
                                    (break)
                                    (do
                                      (let [fty
                                              (.ty (al-at [Field]
                                                          vfields
                                                          (load j)))
                                            (mut ftp) fty]
                                        (let [foff
                                                (g-natural-off g
                                                               vfields
                                                               (load j))
                                              bname (get (load binds) (load j))
                                              borrowed-binding
                                                (and borrowed
                                                     (starts-with bname
                                                                  "$match.ref."))]
                                          (if borrowed-binding
                                              (let [bslot
                                                      (slot-new! (native-context g)
                                                                 8
                                                                 8)]
                                                (emit-load-int! g
                                                                9
                                                                28
                                                                sslot
                                                                8
                                                                false)
                                                (a64-w! (mut s)
                                                        (a64-add-imm 9
                                                                     9
                                                                     (primitive/iadd 8
                                                                                     foff)))
                                                (emit-store-int! g 9 28 bslot 8)
                                                (set! (.env g)
                                                      (gscope-put a
                                                                  (load (field g
                                                                               env))
                                                                  bname
                                                                  (mk-aval 1
                                                                           bslot
                                                                           (TPtr (box-type a
                                                                                           fty))))))
                                              (let [bslot
                                                      (slot-for-ty! g (mut ftp))]
                                                (if borrowed
                                                    (do
                                                      (emit-load-int! g
                                                                      9
                                                                      28
                                                                      sslot
                                                                      8
                                                                      false)
                                                      (a64-w! (mut s)
                                                              (a64-add-imm 9
                                                                           9
                                                                           (primitive/iadd 8
                                                                                           foff)))
                                                      (emit-copy-from-mem! g
                                                                           bslot
                                                                           9
                                                                           (ty-size g
                                                                                    (mut ftp))))
                                                    (emit-copy! g
                                                                bslot
                                                                (primitive/iadd (primitive/iadd sslot
                                                                                                8)
                                                                                foff)
                                                                (ty-size g
                                                                         (mut ftp))))
                                                (set! (.env g)
                                                      (gscope-put a
                                                                  (load (field g
                                                                               env))
                                                                  bname
                                                                  (mk-aval 1
                                                                           bslot
                                                                           fty)))))))
                                      (set! j (primitive/iadd (load j) 1))))))
                        (let [bav (emit-expr g (field arm body))]
                          (set! (.env g) saved)
                          (unless (.terminated g)
                            (when (< (load rslot) 0)
                              (let [(mut bt) (av-ty bav)]
                                (set! rslot (slot-for-ty! g (mut bt)))
                                (set! rty (av-ty bav)))
                              0)
                            (emit-store-av! g bav (load rslot))
                            (set! anylive true)
                            (a64-b-label! (mut (.asm g)) lend)
                            0)))
                      (set! i (primitive/iadd (load i) 1))))))
        (a64-bind-label! (mut (.asm g)) lend)
        (if (load anylive)
            (do
              (set! (.terminated g) false)
              (mk-aval 1 (load rslot) (load rty)))
            (do
              (set! (.terminated g) true)
              (mk-aval 0 0 (TInt 64 true))))))))

; ---- named calls ------------------------------------------------------------
(defn g-leaf-inline-body? [(fd (ptr Func))] (-> bool)
  (let [body (load (field fd body))]
    (if (not (= (len (load body)) 1))
        false
        ; These nodes cannot redirect caller control flow or introduce lexical
        ; cleanup. They cover the core Always wrappers (numeric primitives and
        ; the callable-value trampoline) without pretending to be a general AST
        ; inliner.
        (match (.kind (elem body 0))
          (EBin [_ _ _] true)
          (ECmp [_ _ _] true)
          (EIntUnary [_ _] true)
          (ECast [_ _] true)
          (ECallPtr [_ _] true)
          (_ false)))))

(defn g-leaf-inline-candidate? [(g (ptr Cga)) (sig (ptr GSig))] (-> bool)
  (let [fd (load (field sig func))]
    (if (or (= (primitive/cast i64 fd) 0)
            (match (.inline_policy sig) (Some [(Always)] false) (_ true))
            (>= (.inline_depth g) 16)
            (= (.name fd) (.selfname g)))
        false
        (let [ps (load (field fd params))
              np (len (load ps))
              (mut i) 0
              (mut scalar) (ty-is-scalar (field fd ret))]
          (loop (if (or (>= (load i) np) (not (load scalar)))
                    (break)
                    (do
                      (unless (ty-is-scalar (field (elem ps (load i))
                                                   ty))
                        (set! scalar false)
                        0)
                      (set! i (primitive/iadd (load i) 1)))))
          (and (load scalar) (g-leaf-inline-body? fd))))))

(defn emit-leaf-inline [(g (ptr Cga))
                        (sig (ptr GSig))
                        (avs (ptr (ArrayList AVal)))] (-> AVal)
  (let [fd (load (field sig func))
        saved (load (field g env))
        ps (load (field fd params))
        np (len (load ps))]
    (for [i 0 np]
      (let [p (elem ps i)]
        (set! (.env g)
              (gscope-put (.a g)
                          (load (field g env))
                          (.name p)
                          (get (load avs) i)))))
    (set! (.inline_depth g) (primitive/iadd (.inline_depth g) 1))
    (let [answer (emit-expr g (elem (load (field fd body)) 0))]
      (set! (.inline_depth g) (primitive/isub (.inline_depth g) 1))
      (set! (.env g) saved)
      answer)))

(defn emit-call-named [(g (ptr Cga))
                       (func (slice u8))
                       (args (ptr (ArrayList Expr)))] (-> AVal)
  (let [si (g-sig-idx g func)]
    (when (< si 0)
      (cga-fail2 "call to unknown function: " func))
    (let [e (al-at [GSig] (field g sigs) si)
          (mut avs) (ArrayList::new [AVal] (.a g))
          n (len (load args))
          (mut dummy) (zeroed AVal)]
      (for [i 0 n]
        (push! (mut avs) (emit-expr g (al-at [Expr] args i))))
      (set! dummy
            (mk-aval 0 0 (TInt 64 true)))
      (if (g-leaf-inline-candidate? g e)
          (emit-leaf-inline g e (box-al [AVal] (.a g) (load avs)))
          (if (.shim e)
              ; register-constrained call: args in the convention's registers,
              ; result read back from its return register.
              (let [s (field g asm)
                    regs (load (field e shimregs))
                    (mut slots) (ArrayList::new [i64] (.a g))
                    (mut j) 0]
                (loop (if (>= (load j) n)
                          (break)
                          (do
                            (push! (mut slots)
                                   (av-slot! g (get (load avs) (load j))))
                            (set! j (primitive/iadd (load j) 1)))))
                (set! j 0)
                (loop (if (>= (load j) n)
                          (break)
                          (do
                            (emit-load-int! g
                                            (get (load regs) (load j))
                                            28
                                            (get (load slots) (load j))
                                            8
                                            false)
                            (set! j (primitive/iadd (load j) 1)))))
                (when (.shimsave e)
                  (a64-w! (mut s) (a64-stp-pre 28 29 31 -16)))
                (if (> (len (.inline_code e)) 0)
                    (for k (range 0 (len (.inline_code e)))
                      (b-u8! (mut (.buf s))
                             (primitive/cast i64 (get (.inline_code e) k))))
                    (do
                      (mobj-add-reloc! (mut (.obj g))
                                       (.text g)
                                       (a64-off (mut s))
                                       (.symidx e)
                                       (reloc-branch26)
                                       true
                                       2)
                      (a64-w! (mut s) (a64-bl-raw))))
                (when (.shimsave e)
                  (a64-w! (mut s) (a64-ldp-post 28 29 31 16)))
                (let [(mut retp) (.ret e)]
                  (if (match (.ret e) (TVoid [] true) (_ false))
                      (mk-aval 0 0 (TInt 64 true))
                      (let [slot (slot-for-ty! g (mut retp))]
                        (emit-store-int! g
                                         (.shimret e)
                                         28
                                         slot
                                         (ty-size g (mut retp)))
                        (mk-aval 1 slot (.ret e))))))
              (emit-call! g
                          (.symidx e)
                          (mut dummy)
                          (load (field e params))
                          (.variadic e)
                          (.ret e)
                          (box-al [AVal] (.a g) (load avs))))))))

; ---- bit-struct access --------------------------------------------------------
; layout info for a bit-struct: backing width + per-field low-bit offsets.

(defn emit-bitget [(g (ptr Cga)) (p (ptr Expr)) (fname (slice u8))] (-> AVal)
  (let [av (emit-expr g p)
        (mut t) (av-ty av)
        s (field g asm)]
    (let [(mut pt) (ty-pointee (mut t))]
      (match pt
        (TStruct [nm]
                 (let [(mut low) (zeroed i64)
                       (mut width) (zeroed i64)
                       (mut signed) (zeroed bool)
                       (mut back) (zeroed i64)]
                   (g-bits-info (native-context g)
                                nm
                                fname
                                (mut low)
                                (mut width)
                                (mut signed)
                                (mut back))
                   (av-to-x! g av 9)
                   (let [wb (bits-window! (mut low) (mut back))]
                     (when (> wb 0) (a64-w! (mut s) (a64-add-imm 9 9 wb)) 0))
                   (emit-load-from-mem! g
                                        9
                                        9
                                        (/ back 8))
                   (when (> low
                            0)
                     (a64-w! (mut s)
                             (a64-lsr-imm 9
                                          9
                                          low)))
                   ; mask/sign-extend to the field width via shift pairs
                   (when (< width
                            64)
                     (a64-w! (mut s)
                             (a64-lsl-imm 9
                                          9
                                          (primitive/isub 64
                                                          width)))
                     (a64-w! (mut s)
                             (if signed
                                 (a64-asr-imm 9
                                              9
                                              (primitive/isub 64
                                                              width))
                                 (a64-lsr-imm 9
                                              9
                                              (primitive/isub 64
                                                              width))))
                     0)
                   (let [fty
                           (if (= width
                                  1)
                               (TBool)
                               (TInt width
                                     signed))
                         (mut ftp) fty]
                     (let [slot (slot-for-ty! g (mut ftp))]
                       (emit-store-int! g 9 28 slot (ty-size g (mut ftp)))
                       (mk-aval 1 slot fty)))))
        (_ (do
             (cga-fail "bit-get through non-struct pointer")
             (mk-aval 0 0 (TInt 64 true))))))))

(defn emit-bitset [(g (ptr Cga))
                   (p (ptr Expr))
                   (fname (slice u8))
                   (val (ptr Expr))] (-> AVal)
  (let [pav (emit-expr g p)
        vav (emit-expr g val)
        (mut t) (av-ty pav)
        s (field g asm)]
    (let [(mut pt) (ty-pointee (mut t))]
      (match pt
        (TStruct [nm]
                 (let [(mut low) (zeroed i64)
                       (mut width) (zeroed i64)
                       (mut signed) (zeroed bool)
                       (mut back) (zeroed i64)]
                   (g-bits-info (native-context g)
                                nm
                                fname
                                (mut low)
                                (mut width)
                                (mut signed)
                                (mut back))
                   (av-to-x! g pav 9)
                   (let [wb (bits-window! (mut low) (mut back))]
                     (when (> wb 0) (a64-w! (mut s) (a64-add-imm 9 9 wb)) 0))
                   ; x9 = container address
                   (emit-load-from-mem! g
                                        10
                                        9
                                        (/ back 8))
                   ; x10 = container
                   ; x11 = ~(fieldmask << low)
                   (let [fieldmask
                           (if (>= width
                                   64)
                               -1
                               (primitive/isub (<< 1 width)
                                               1))]
                     (a64-mov-imm! (mut s)
                                   11
                                   (<< fieldmask low))
                     (a64-w! (mut s) (a64-mvn-reg 11 11))
                     (a64-w! (mut s) (a64-and-reg 10 10 11))
                     ; x12 = (value & fieldmask) << low
                     (av-to-x! g vav 12)
                     (a64-mov-imm! (mut s) 13 fieldmask)
                     (a64-w! (mut s) (a64-and-reg 12 12 13))
                     (when (> low
                              0)
                       (a64-w! (mut s)
                               (a64-lsl-imm 12
                                            12
                                            low)))
                     (a64-w! (mut s) (a64-orr-reg 10 10 12))
                     (emit-store-to-mem! g
                                         10
                                         9
                                         (/ back 8))
                     vav)))
        (_ (do
             (cga-fail "bit-set through non-struct pointer")
             (mk-aval 0 0 (TInt 64 true))))))))

; ---- trait objects ----------------------------------------------------------
(defn emit-make-dyn [(g (ptr Cga))
                     (ds (slice u8))
                     (_vt (slice u8))
                     (methods (ptr (ArrayList (slice u8))))
                     (inner (ptr Expr))] (-> AVal)
  (let [a (.a g)
        buf (mobj-sect-buf (mut (.obj g)) (.datasec g))]
    ; the vtable: one 8-byte relocated function pointer per method
    (b-align! (mut buf) 8)
    (let [vtoff (len (load buf))
          nm (text/format a "l_vtable.{}" (i64->str a (.nglob g)))]
      (set! (.nglob g) (primitive/iadd (.nglob g) 1))
      (let [n (len (load methods))
            (mut i) 0]
        (loop (if (>= (load i) n)
                  (break)
                  (do
                    (let [mnm (get (load methods) (load i))
                          msi (g-sig-idx g mnm)]
                      (when (< msi 0)
                        (cga-fail2 "make-dyn: unknown method " mnm))
                      (mobj-add-reloc! (mut (.obj g))
                                       (.datasec g)
                                       (len (load buf))
                                       (.symidx (al-at [GSig]
                                                       (field g sigs)
                                                       msi))
                                       (reloc-unsigned)
                                       false
                                       3)
                      (b-u64! (mut buf) 0))
                    (set! i (primitive/iadd (load i) 1))))))
      (let [vtsym (mobj-add-sym! (mut (.obj g)) nm (.datasec g) vtoff false)
            iav (emit-expr g inner)
            slot (slot-new! (native-context g) 16 8)]
        ; dyn object { data, vtable } by value
        (av-to-x! g iav 9)
        (emit-store-int! g 9 28 slot 8)
        (emit-sym-addr! g 9 vtsym)
        (emit-store-int! g 9 28 (primitive/iadd slot 8) 8)
        (mk-aval 1 slot (TStruct ds))))))

(defn emit-dyn-dispatch [(g (ptr Cga))
                         (_ds (slice u8))
                         (_vt (slice u8))
                         (mi i64)
                         (_cc (slice u8))
                         (params (ptr (ArrayList Type)))
                         (ret Type)
                         (recv (ptr Expr))
                         (args (ptr (ArrayList Expr)))] (-> AVal)
  (let [a (.a g)
        rav (emit-expr g recv)
        rslot (av-slot! g rav)
        ; fnptr = vtable[mi]
        fpslot (slot-new! (native-context g) 8 8)
        dataslot (slot-new! (native-context g) 8 8)]
    ; data ptr
    (emit-load-int! g 9 28 rslot 8 false)
    (emit-store-int! g 9 28 dataslot 8)
    ; vtable -> method fnptr
    (emit-load-int! g 9 28 (primitive/iadd rslot 8) 8 false)
    (a64-w! (mut (.asm g)) (a64-ldr-x 9 9 (primitive/imul mi 8)))
    (emit-store-int! g 9 28 fpslot 8)
    ; assemble [data, args...] and the full param list [ptr, params...]
    (let [(mut avs) (ArrayList::new [AVal] a)
          (mut ptys) (ArrayList::new [Type] a)
          (mut fpav) (zeroed AVal)]
      (push! (mut ptys) (TPtr (box-type a (TInt 8 true))))
      (let [np (len (load params))
            (mut i) 0]
        (loop (if (>= (load i) np)
                  (break)
                  (do
                    (push! (mut ptys) (get (load params) (load i)))
                    (set! i (primitive/iadd (load i) 1))))))
      (push! (mut avs) (mk-aval 1 dataslot (TPtr (box-type a (TInt 8 true)))))
      (let [na (len (load args))
            (mut i) 0]
        (loop (if (>= (load i) na)
                  (break)
                  (do
                    (push! (mut avs) (emit-expr g (al-at [Expr] args (load i))))
                    (set! i (primitive/iadd (load i) 1))))))
      (set! fpav
            (mk-aval 1
                     fpslot
                     (TFn
                       :cc (cc-c)
                       :params (box-al [Type] a (load ptys))
                       :ret (box-type a ret))))
      (emit-call! g
                  -1
                  (mut fpav)
                  (box-al [Type] a (load ptys))
                  false
                  ret
                  (box-al [AVal] a (load avs))))))

; parse a (possibly negative) plain-decimal float token — llvm-ir literals
; (`<float 0.0, float 1.0, ...>`). The corpus never uses exponents, so a small
; hand-rolled parser avoids pulling in an extra `extern strtod` declaration
; that would collide with the one other modules already link in (gotcha:
; extern decls aren't deduped across modules).
(defn str->f64 [(s (slice u8))] (-> f64)
  (irs/floating (zeroed Arm64IrErrors) s))

; parse a (possibly negative) decimal integer token — llvm-ir literals.
(defstruct Arm64IrErrors [])

(impl irs/IrErrors Arm64IrErrors
  (ir-error [(self Arm64IrErrors) (message (slice u8)) (token (slice u8))]
    (-> i64)
    (cga-fail2 message token)))

(defn str->i64 [(s (slice u8))] (-> i64)
  (irs/integer (zeroed Arm64IrErrors) s))

; ============================ inline LLVM-IR subset ==========================
; The corpus' (primitive/llvm-ir ...) bodies are straight-line SSA — no control flow, no
; phi (verified inventory: slice/atomic/simd/mmio helpers). We lower them
; structurally. Anything outside the implemented subset is a HARD ERROR that
; prints the offending line.

; tokenizer: split on whitespace and commas; '{', '}', '<', '>' self-delimit.
(defn ir-tokens [(a (dyn Allocator)) (line (slice u8))]
  (-> (ptr (ArrayList (slice u8))))
  (irs/tokenize a line))

; aggregate element info for extractvalue/insertvalue: given the agg type and
; element index, produce (offset, element type).
(defn ir-agg-elem [(g (ptr Cga)) (t (ptr Type)) (idx i64) (offp (ptr i64))]
  (-> Type)
  (match (load t)
    (TSlice [elem]
            (if (= idx 0)
                (do (set! offp 0) (TPtr elem))
                (do (set! offp 8) (TInt 64 true))))
    (TStruct [nm]
             (let [si (g-struct-idx g nm)]
               (when (< si 0)
                 (cga-fail2 "llvm-ir: extract from unknown struct " nm))
               (set! offp (g-field-off g si idx))
               (.ty (al-at [Field]
                           (load (field (struct-at (field g
                                                          layouts)
                                                   si)
                                        fields))
                           idx))))
    (_ (do
         (cga-fail "llvm-ir: extract/insert on unsupported aggregate")
         (TInt 64 true)))))

; shufflevector's <N x i32> mask: either `zeroinitializer` (all N indices 0,
; i.e. a splat) or an explicit `<i32 IDX0, i32 IDX1, ...>` literal. Indices
; are always compile-time-known integer literals in the corpus (never a
; %name), so this reads them straight off the token stream rather than
; building a runtime AVal — much simpler than indirecting through a register
; per lane.
(defn ir-shuffle-mask! [(a (dyn Allocator))
                        (toks (ptr (ArrayList (slice u8))))
                        (tokp (ptr i64))
                        (n i64)]
  (-> (ptr (ArrayList i64)))
  (irs/read-mask a (zeroed Arm64IrErrors) toks tokp n))

; bind an SSA name to a value in the llvm-ir line interpreter's environment.

; i128 (our synthetic 16-byte TSlice blob) only supports eq/ne, via a plain
; 16-byte memory compare — nothing in the corpus needs an ordered i128 compare.
(defn ir-icmp-i128! [(g (ptr Cga)) (pred (slice u8)) (lav AVal) (rav AVal)]
  (-> AVal)
  (unless (or (= pred "eq") (= pred "ne"))
    (cga-fail2 "llvm-ir: unsupported i128 icmp predicate (only eq/ne supported): "
               pred))
  (let [ls (av-slot! g lav)
        rs (av-slot! g rav)
        s (field g asm)]
    (emit-load-int! g 9 28 ls 8 false)
    (emit-load-int! g 10 28 rs 8 false)
    (a64-w! (mut s) (a64-eor-reg 9 9 10))
    (emit-load-int! g 11 28 (primitive/iadd ls 8) 8 false)
    (emit-load-int! g 12 28 (primitive/iadd rs 8) 8 false)
    (a64-w! (mut s) (a64-eor-reg 11 11 12))
    (a64-w! (mut s) (a64-orr-reg 9 9 11))
    (a64-w! (mut s) (a64-cmp-imm 9 0))
    (a64-w! (mut s) (a64-cset 9 (if (= pred "eq") (cond-eq) (cond-ne))))
    (let [slot (slot-new! (native-context g) 8 8)]
      (emit-store-int! g 9 28 slot 1)
      (mk-aval 1 slot (TBool)))))

; branch-free select on values ≤8 bytes (scalar, or one vector lane): blend
; the raw bits of `aav`/`bav` by `maskav` (0/1) sign-extended to all-0s/all-1s.
; av-to-x!/emit-store-int! already move floats by raw bit pattern, so this
; works uniformly for int and float lanes without a separate float path.
(defn ir-select-blend! [(g (ptr Cga)) (maskav AVal) (aav AVal) (bav AVal)]
  (-> AVal)
  (let [(mut t) (av-ty aav)
        s (field g asm)]
    (let [sz
            (ty-size g
                     (mut t))]
      (av-to-x! g maskav 9)
      (a64-w! (mut s) (a64-neg 9 9))
      ; 0/1 -> 0x0/0xFFFF...FFFF
      (av-to-x! g aav 10)
      (av-to-x! g bav 11)
      (a64-w! (mut s) (a64-and-reg 10 10 9))
      (a64-w! (mut s) (a64-mvn-reg 12 9))
      (a64-w! (mut s) (a64-and-reg 11 11 12))
      (a64-w! (mut s) (a64-orr-reg 10 10 11))
      (let [slot
              (slot-for-ty! g
                            (mut t))]
        (emit-store-int! g 10 28 slot sz)
        (mk-aval 1
                 slot
                 t)))))

; sext of a REAL narrow int (e.g. sext i8 to i32) is just emit-cast-av!'s
; ordinary int/int path — ir-parse-type marks every int token signed, so it
; already sign-extends correctly from the container's own sign bit. But
; `sext i1 x to iN` (the 0/-1 mask idiom `greater`/`icmp`-derived masks use)
; is different: our i1 values are TBool bytes holding a plain 0/1, read
; UNSIGNED by convention (see emit-cmp's `(TBool [] false)` arm) — correct
; for zext (i1 true -> 1), but a byte-level sign-extend of that same byte
; (sign bit = bit 7, which is 0) would wrongly give +1, not LLVM's -1. The
; actual LLVM semantics — "replicate the sign bit of a *1-bit* signed value"
; — has no direct hardware byte-level operation; implement it directly as
; the two's-complement negation of the 0/1 value (negate(1)=-1, negate(0)=0),
; which is exactly equivalent.
(defn ir-sext-bool! [(g (ptr Cga)) (av AVal) (dstty Type)] (-> AVal)
  (let [s (field g asm)]
    (av-to-x! g av 9)
    (a64-w! (mut s) (a64-neg 9 9))
    (match dstty
      (TInt [bits _]
            (do
              (emit-canon-int! g 9 bits true)
              (let [(mut dtp) (: dstty Type)]
                (let [slot (slot-for-ty! g (mut dtp))]
                  (emit-store-int! g 9 28 slot (ty-size g (mut dtp)))
                  (mk-aval 1 slot dstty)))))
      (_ (do
           (cga-fail "llvm-ir: sext from i1 to a non-integer type")
           (mk-aval 0 0 dstty))))))

; copy `bytes` between a raw pointer (register `addrreg`, offset from 0) and a
; frame slot, chunked in ≤8-byte pieces. Generalizes emit-load-from-mem!/
; emit-store-to-mem! (which only handle bytes ∈ {1,2,4,8}) to the aggregate
; sizes the plain (non-atomic) llvm-ir load/store lines need, e.g. <16 x i8>
; or <4 x double> (32 bytes).
(defn ir-load-mem-any! [(g (ptr Cga)) (dst i64) (addrreg i64) (bytes i64)]
  (-> i64)
  (let [(mut off) 0]
    (loop (if (>= (load off) bytes)
              (break)
              (let [rem (primitive/isub bytes (load off))
                    chunk
                      (cond (>= rem 8) 8
                            (>= rem 4) 4
                            (>= rem 2) 2
                            :else 1)]
                (emit-load-int! g 10 addrreg (load off) chunk false)
                (emit-store-int! g 10 28 (primitive/iadd dst (load off)) chunk)
                (set! off (primitive/iadd (load off) chunk)))))
    0))

(defn ir-store-mem-any! [(g (ptr Cga)) (addrreg i64) (src i64) (bytes i64)]
  (-> i64)
  (let [(mut off) 0]
    (loop (if (>= (load off) bytes)
              (break)
              (let [rem (primitive/isub bytes (load off))
                    chunk
                      (cond (>= rem 8) 8
                            (>= rem 4) 4
                            (>= rem 2) 2
                            :else 1)]
                (emit-load-int! g
                                10
                                28
                                (primitive/iadd src (load off))
                                chunk
                                false)
                (emit-store-int! g 10 addrreg (load off) chunk)
                (set! off (primitive/iadd (load off) chunk)))))
    0))

; Alias metadata and volatility need no extra native instructions here: this
; emitter preserves each scalar access and its order without an optimizing pass.
; Emit one width-matched access; volatility does not imply a memory barrier.
(defn emit-scalar-memory [(g (ptr Cga))
                          (result Type)
                          (args (ptr (ArrayList Expr)))
                          (store bool)] (-> AVal)
  (if store
      (let [pav (emit-expr g (al-at [Expr] args 0))
            vav (emit-expr g (al-at [Expr] args 1))
            (mut t) (av-ty vav)]
        (let [sz (ty-size g (mut t))]
          (av-to-x! g vav 10)
          (av-to-x! g pav 9)
          (emit-store-to-mem! g 10 9 sz)
          (mk-aval 0 0 (TInt 64 true))))
      (let [pav (emit-expr g (al-at [Expr] args 0))
            (mut t) (: result Type)]
        (let [sz (ty-size g (mut t))
              slot (slot-for-ty! g (mut t))]
          (av-to-x! g pav 9)
          (emit-load-from-mem! g 10 9 sz)
          (emit-store-int! g 10 28 slot sz)
          (mk-aval 1 slot result)))))

; A compiler-implemented primitive (EIntrinsic). Machine code is emitted as its
; function, never as an expression.
(defn emit-intrinsic [(g (ptr Cga))
                      (op Intrinsic)
                      (result Type)
                      (args (ptr (ArrayList Expr)))] (-> AVal)
  (match op
    (IStackBytes []
                 (let [s (field g asm)
                       nav (emit-expr g (al-at [Expr] args 0))
                       slot (slot-new! (native-context g) 8 8)]
                   ; round the byte count up to 16 (sp alignment), move sp down by it,
                   ; and hand out the bytes just above the outgoing-args area
                   (av-to-x! g nav 9)
                   (a64-w! (mut s) (a64-add-imm 9 9 15))
                   (a64-w! (mut s) (a64-lsr-imm 9 9 4))
                   (a64-w! (mut s) (a64-lsl-imm 9 9 4))
                   (a64-w! (mut s) (a64-sub-ext 31 31 9))
                   (emit-out-addr! g 9)
                   (emit-store-int! g 9 28 slot 8)
                   (mk-aval 1 slot result)))
    (IVolatileLoad [] (emit-scalar-memory g result args false))
    (IAliasLoad [] (emit-scalar-memory g result args false))
    (IVolatileStore [] (emit-scalar-memory g result args true))
    (IAliasStore [] (emit-scalar-memory g result args true))
    (IFence []
            (let [s (field g asm)]
              ; dmb ish
              (a64-w! (mut s) 3573758911)
              (mk-aval 0 0 (TInt 64 true))))
    (ILinkerAddress [symbol]
                    (let [sym
                            (mobj-add-sym! (mut (.obj g))
                                           (g-mangle g symbol)
                                           0
                                           0
                                           true)
                          slot (slot-new! (native-context g) 8 8)]
                      (emit-sym-addr! g 9 sym)
                      (emit-store-int! g 9 28 slot 8)
                      (mk-aval 1 slot result)))
    (_ (do
         (cga-fail "codegen: machine-code outside a machine-code function (checker bug)")
         (mk-aval 0 0 result)))))

(defn emit-llvmir [(g (ptr Cga))
                   (result Type)
                   (args (ptr (ArrayList Expr)))
                   (body (slice u8))] (-> AVal)
  (let [frame (primitive/alloc-stack (IrContext Cga))]
    (store! frame (IrContext :g g :inputs (zeroed native/IrInputs)))
    (native/lower-ir! frame result args body)))

; Emit add/subtract/multiply/divide on FP registers 0 and 1.
(defn ir-float-op! [(g (ptr Cga)) (op i64) (bits i64)] (-> i64)
  (let [s (field g asm)
        fty (unless (= bits 32) 1)]
    (cond (= op 0) (a64-w! (mut s) (a64-fadd fty 0 0 1))
          (= op 1) (a64-w! (mut s) (a64-fsub fty 0 0 1))
          (= op 2) (a64-w! (mut s) (a64-fmul fty 0 0 1))
          :else (a64-w! (mut s) (a64-fdiv fty 0 0 1)))))

(defn ir-load-float! [(g (ptr Cga)) (reg i64) (src i64) (size i64)] (-> i64)
  (emit-load-fp! g reg 28 src size))

(defn ir-store-float! [(g (ptr Cga)) (reg i64) (dst i64) (size i64)] (-> i64)
  (emit-store-fp! g reg 28 dst size))

; one line of the inline-IR subset. Sets *donep and *retp on `ret`.
(defn emit-ir-line! [(irctx (ptr (IrContext Cga)))
                     (retp (ptr AVal))
                     (donep (ptr bool))
                     (line (slice u8))] (-> i64)
  (let [g (.g irctx)
        envp (.envp (field irctx inputs))
        result (.result (field irctx inputs))]
    (let [a (.a g)
          s (field g asm)
          toks (ir-tokens a line)
          ntk (len (load toks))]
      (unless (= ntk 0)
        (let [t0 (get (load toks) 0)]
          (cond (= t0 "declare") 0
                ; hoisted intrinsic declaration — the ops lower structurally
                ; `call void @llvm.trap()` then `unreachable`: stop at a trap instruction.
                (and (= t0 "call")
                     (and (>= ntk 3) (= (get (load toks) 2) "@llvm.trap")))
                  (do (a64-w! (mut s) (a64-brk 1)) 0)
                (= t0 "unreachable") (do (set! donep true) 0)
                (= t0 "ret")
                  (let [(mut tokp) 1]
                    (let [rt (ir-parse-type irctx toks (mut tokp))
                          av
                            (ir-value irctx
                                      (load envp)
                                      (get (load toks) tokp)
                                      rt)]
                      (set! retp (mk-aval (av-kind av) (av-v av) result))
                      (set! donep true)
                      0))
                (= t0 "store")  ; store atomic TYPE VAL, ptr PTR seq_cst, align N
                  (if (and (>= ntk 7)
                           (= (get (load toks) 1) "atomic"))
                      (let [(mut tokp) 2]
                        (let [vt (ir-parse-type irctx toks (mut tokp))
                              vav
                                (ir-value irctx
                                          (load envp)
                                          (get (load toks) tokp)
                                          vt)
                              pav
                                (ir-value irctx
                                          (load envp)
                                          (get (load toks)
                                               (primitive/iadd tokp 2))
                                          (TPtr (box-type a (TInt 8 true))))]
                          (av-to-x! g vav 10)
                          (av-to-x! g pav 9)
                          (a64-w! (mut s) (a64-stlr 10 9))
                          0))
                      ; plain (non-atomic) form: store TYPE VAL, ptr PTR, align N
                      (let [(mut tokp) 1]
                        (let [vt (ir-parse-type irctx toks (mut tokp))
                              (mut vtp) vt
                              vav
                                (ir-value irctx
                                          (load envp)
                                          (get (load toks)
                                               tokp)
                                          vt)]
                          (set! tokp
                                (primitive/iadd tokp
                                                2))
                          ; skip VAL, "ptr"
                          (let [pav
                                  (ir-value irctx
                                            (load envp)
                                            (get (load toks)
                                                 tokp)
                                            (TPtr (box-type a (TInt 8 true))))]
                            (av-to-x! g pav 9)
                            (ir-store-mem-any! g
                                               9
                                               (av-slot! g vav)
                                               (ty-size g
                                                        (mut vtp)))))))
                (and (>= ntk 3)
                     (= (primitive/cast i64 (get t0 0)) 37))
                  (let [op (get (load toks) 2)
                        instruction
                          (native/IrInstruction
                            :allocator a
                            :environment envp
                            :tokens toks
                            :name t0
                            :opcode op)]
                    ; %old = atomicrmw SUB ptr PTR, TYPE VAL seq_cst
                    ; %r = cmpxchg ptr PTR, TYPE EXP, TYPE NEW seq_cst seq_cst
                    ; %v = load atomic TYPE, ptr PTR seq_cst, align N
                    ; %v = insertelement <N x T> AGG, ET EV, i32 K
                    ; %x = extractelement <N x T> V, IDXTY IDX
                    ; %r = shufflevector <M x T> V0, <M x T> V1, <N x i32> MASK
                    ; %r = bitcast SRCTY V to DSTTY
                    ; %r = icmp PRED TY V0, V1
                    ; %r = fcmp PRED TY V0, V1
                    ; %r = select CONDTY C, TY V0, TY V1
                    ; %r = OP SRCTY V to DSTTY
                    ; %r = OP SRCTY V to DSTTY
                    ; %r = OP TY V0, V1
                    ; %r = OP TY V0, V1 (scalar only)
                    ; %r = getelementptr ELEMTY, ptr BASE, IDXTY IDX
                    (case op
                      "extractvalue"
                        (native/ir-extract-value! irctx instruction)
                      "insertvalue" (native/ir-insert-value! irctx instruction)
                      "atomicrmw"
                        (let [sub (get (load toks) 3)
                              pav
                                (ir-value irctx
                                          (load envp)
                                          (get (load toks) 5)
                                          (TPtr (box-type a (TInt 8 true))))
                              (mut tokp) 6]
                          (let [vt (ir-parse-type irctx toks (mut tokp))
                                vav
                                  (ir-value irctx
                                            (load envp)
                                            (get (load toks) tokp)
                                            vt)
                                (mut vtp) vt]
                            (av-to-x! g pav 9)
                            (av-to-x! g vav 10)
                            (case sub
                              "add" 0
                              "sub" (do (a64-w! (mut s) (a64-neg 10 10)) 0)
                              "xchg" 0
                              (cga-fail2 "llvm-ir: unsupported atomicrmw op: "
                                         sub))
                            (if (= sub "xchg")
                                (a64-w! (mut s) (a64-swpal 10 11 9))
                                (a64-w! (mut s) (a64-ldaddal 10 11 9)))
                            (let [slot (slot-for-ty! g (mut vtp))]
                              (emit-store-int! g
                                               11
                                               28
                                               slot
                                               (ty-size g (mut vtp)))
                              (set! envp
                                    (gscope-put a
                                                (load envp)
                                                t0
                                                (mk-aval 1 slot vt)))
                              0)))
                      "cmpxchg"
                        (let [pav
                                (ir-value irctx
                                          (load envp)
                                          (get (load toks) 4)
                                          (TPtr (box-type a (TInt 8 true))))
                              (mut tokp) 5]
                          (let [et (ir-parse-type irctx toks (mut tokp))
                                eav
                                  (ir-value irctx
                                            (load envp)
                                            (get (load toks) tokp)
                                            et)]
                            (set! tokp (primitive/iadd tokp 1))
                            (let [nt (ir-parse-type irctx toks (mut tokp))
                                  nav
                                    (ir-value irctx
                                              (load envp)
                                              (get (load toks) tokp)
                                              nt)]
                              (av-to-x! g pav 9)
                              (av-to-x! g eav 10)
                              ; expected (in/out)
                              (av-to-x! g nav 11)
                              ; new
                              (a64-w! (mut s) (a64-mov-reg 12 10))
                              ; original expected
                              (a64-w! (mut s) (a64-casal 10 11 9))
                              ; pair {old, success}: old at +0, success bit at +8
                              (let [slot (slot-new! (native-context g) 16 8)]
                                (emit-store-int! g 10 28 slot 8)
                                (a64-w! (mut s) (a64-cmp-reg 10 12))
                                (a64-w! (mut s) (a64-cset 13 (cond-eq)))
                                (emit-store-int! g
                                                 13
                                                 28
                                                 (primitive/iadd slot 8)
                                                 8)
                                (set! envp
                                      (gscope-put a
                                                  (load envp)
                                                  t0
                                                  (mk-aval 1
                                                           slot
                                                           (TSlice (box-type a
                                                                             et)))))
                                0))))
                      "load"
                        (if (= (get (load toks) 3) "atomic")
                            (let [(mut tokp) 4]
                              (let [vt (ir-parse-type irctx toks (mut tokp))
                                    (mut vtp) vt]
                                ; skip the "ptr" token
                                (let [pav
                                        (ir-value irctx
                                                  (load envp)
                                                  (get (load toks)
                                                       (primitive/iadd tokp 1))
                                                  (TPtr (box-type a
                                                                  (TInt 8 true))))]
                                  (av-to-x! g pav 9)
                                  (a64-w! (mut s) (a64-ldar 10 9))
                                  (let [slot (slot-for-ty! g (mut vtp))]
                                    (emit-store-int! g
                                                     10
                                                     28
                                                     slot
                                                     (ty-size g (mut vtp)))
                                    (set! envp
                                          (gscope-put a
                                                      (load envp)
                                                      t0
                                                      (mk-aval 1 slot vt)))
                                    0))))
                            ; plain (non-atomic) form: load TYPE, ptr PTR, align N
                            (let [(mut tokp) 3]
                              (let [vt (ir-parse-type irctx toks (mut tokp))
                                    (mut vtp) vt]
                                (set! tokp (primitive/iadd tokp 1))
                                ; skip "ptr"
                                (let [pav
                                        (ir-value irctx
                                                  (load envp)
                                                  (get (load toks) tokp)
                                                  (TPtr (box-type a
                                                                  (TInt 8 true))))]
                                  (av-to-x! g pav 9)
                                  (let [dslot (slot-for-ty! g (mut vtp))]
                                    (ir-load-mem-any! g
                                                      dslot
                                                      9
                                                      (ty-size g (mut vtp)))
                                    (ir-bind! irctx
                                              envp
                                              t0
                                              (mk-aval 1 dslot vt)))))))
                      "insertelement"
                        (native/ir-insert-element! irctx instruction)
                      "extractelement"
                        (let [(mut tokp) 3]
                          (let [vty (ir-parse-type irctx toks (mut tokp))
                                vav (ir-value-adv! irctx toks (mut tokp) vty)
                                idxty (ir-parse-type irctx toks (mut tokp))
                                idxav
                                  (ir-value-adv! irctx toks (mut tokp) idxty)]
                            (match vty
                              (TVec [elemp _]
                                    (let [lb (ty-size g elemp)
                                          dslot (slot-for-ty! g elemp)]
                                      ; address of lane IDX = slot base + IDX * lane bytes
                                      (emit-slot-addr! g 9 (av-slot! g vav))
                                      (av-to-x! g idxav 10)
                                      (a64-mov-imm! (mut s) 11 lb)
                                      (a64-w! (mut s) (a64-madd 9 10 11 9))
                                      (ir-load-mem-any! g dslot 9 lb)
                                      (ir-bind! irctx
                                                envp
                                                t0
                                                (mk-aval 1 dslot (load elemp)))))
                              (_ (cga-fail "llvm-ir: extractelement on non-vector")))))
                      "shufflevector"
                        (native/ir-shuffle-vector! irctx instruction)
                      (cond (or (= op "fadd")
                                (= op "fsub")
                                (= op "fmul")
                                (= op "fdiv"))
                              (native/ir-float-instruction! irctx instruction)
                            (= op "bitcast")
                              (native/ir-bitcast! irctx instruction)
                            (= op "icmp")
                              (native/ir-compare-instruction! irctx instruction)
                            (= op "fcmp")
                              (native/ir-compare-instruction! irctx instruction)
                            (= op "select")
                              (native/ir-select! irctx instruction)
                            (or (= op "sext") (= op "zext") (= op "trunc"))
                              (native/ir-extend-instruction! irctx instruction)
                            (or (= op "fptosi")
                                (= op "fptoui")
                                (= op "sitofp")
                                (= op "uitofp")
                                (= op "fptrunc")
                                (= op "fpext"))
                              (native/ir-convert-instruction! irctx instruction)
                            (or (= op "and")
                                (= op "or")
                                (= op "xor")
                                (= op "add")
                                (= op "sub")
                                (= op "mul")
                                (= op "shl"))
                              (native/ir-binary-instruction! irctx instruction)
                            (or (= op "sdiv")
                                (= op "udiv")
                                (= op "srem")
                                (= op "urem"))
                              (native/ir-divide-instruction! irctx instruction)
                            (= op "getelementptr")
                              (native/ir-gep! irctx instruction)
                            (= op "call") (emit-ir-call! irctx toks t0 line)
                            :else (cga-fail2 "llvm-ir: unsupported op: " op))))
                :else (cga-fail2 "llvm-ir: unsupported line: " line)))))))

; A scalar float math intrinsic (src/compiler/backend/float_math.coil), `tokp` at the
; callee: `fsqrt`/`fabs`/`frint*`/`fmadd`/`fmin`/`fmax` where the ISA has the
; operation, otherwise a call to the libm function of the same meaning.
(defn emit-ir-float-math! [(irctx (ptr (IrContext Cga)))
                           (toks (ptr (ArrayList (slice u8))))
                           (tokp (ptr i64))
                           (t0 (slice u8))
                           (rty Type)
                           (fi FloatIntrinsic)] (-> i64)
  (let [g (.g irctx)
        envp (.envp (field irctx inputs))]
    (let [a (.a g)
          s (field g asm)
          fb (/ (.bits fi) 8)
          fty (if (= (.bits fi) 32) 0 1)
          (mut rtp)
            (: rty
               Type)]
      (set! tokp (primitive/iadd (load tokp) 2))
      ; skip callee, "("
      (for [i 0 (.arity fi)]
        (let [at (ir-parse-type irctx toks tokp)
              av (ir-value-adv! irctx toks tokp at)]
          (av-to-d! g av i)))
      (match (.op fi)
        (FloatSqrt [] (a64-w! (mut s) (a64-fsqrt fty 0 0)))
        (FloatAbs [] (a64-w! (mut s) (a64-fp1 fty 1 0 0)))
        (FloatRoundEven [] (a64-w! (mut s) (a64-fp1 fty 8 0 0)))
        (FloatCeil [] (a64-w! (mut s) (a64-fp1 fty 9 0 0)))
        (FloatFloor [] (a64-w! (mut s) (a64-fp1 fty 10 0 0)))
        (FloatTrunc [] (a64-w! (mut s) (a64-fp1 fty 11 0 0)))
        (FloatRound [] (a64-w! (mut s) (a64-fp1 fty 12 0 0)))
        (FloatFma [] (a64-w! (mut s) (a64-fmadd fty 0 0 1 2)))
        (FloatMinimum [] (a64-w! (mut s) (a64-fmin fty 0 0 1)))
        (FloatMaximum [] (a64-w! (mut s) (a64-fmax fty 0 0 1)))
        ; the operands are already in d0..d2, where the C convention wants them
        (_ (let [fsym (g-runtime-sym! g (text/format a "_{}" (.libm fi)))]
             (mobj-add-reloc! (mut (.obj g))
                              (.text g)
                              (a64-off (mut s))
                              fsym
                              (reloc-branch26)
                              true
                              2)
             (a64-w! (mut s) (a64-bl-raw)))))
      (let [slot
              (slot-for-ty! g
                            (mut rtp))]
        (emit-store-fp! g 0 28 slot fb)
        (ir-bind! irctx envp t0 (mk-aval 1 slot rty))))))

; intrinsic calls: @llvm.fma.v4f32 and @llvm.vector.reduce.fadd.v4f32
(defn emit-ir-call! [(irctx (ptr (IrContext Cga)))
                     (toks (ptr (ArrayList (slice u8))))
                     (t0 (slice u8))
                     (line (slice u8))] (-> i64)
  (let [g (.g irctx)
        envp (.envp (field irctx inputs))]
    (let [a (.a g)
          s (field g asm)
          (mut tokp) 3]
      (let [rty (ir-parse-type irctx toks (mut tokp))
            callee
              (get (load toks)
                   tokp)]
        (match (float-intrinsic callee)
          (Some [fi]
                (emit-ir-float-math! irctx toks (mut tokp) t0 rty fi))
          (None []
                ; ( $t0 $0 $t1 $1 $t2 $2 ) -> per-lane single-rounding fmadd
                ; ( float 0.0 $t0 $0 ) -> strict sequential reduce from 0.0
                ; ( $ret $0 ) -> per-lane fsqrt
                ; ( <N x ptr> PTRS, i32 ALIGN, <N x i1> MASK, <N x T> PASSTHRU )
                ; per-lane: mask[k] ? *ptrs[k] : passthru[k]. Scoped to the
                ; exact shape `heights` uses — no real gather instruction on
                ; this backend, so this is a straight-line per-lane branch.
                (case callee
                  "@llvm.fma.v4f32"
                    (let [(mut rtp) rty]
                      (set! tokp (primitive/iadd tokp 2))
                      ; skip "("
                      (let [t1 (ir-parse-type irctx toks (mut tokp))
                            aav
                              (ir-value irctx
                                        (load envp)
                                        (get (load toks) tokp)
                                        t1)]
                        (set! tokp (primitive/iadd tokp 1))
                        (let [t2 (ir-parse-type irctx toks (mut tokp))
                              bav
                                (ir-value irctx
                                          (load envp)
                                          (get (load toks) tokp)
                                          t2)]
                          (set! tokp (primitive/iadd tokp 1))
                          (let [t3 (ir-parse-type irctx toks (mut tokp))
                                cav
                                  (ir-value irctx
                                            (load envp)
                                            (get (load toks) tokp)
                                            t3)]
                            (match rty
                              (TVec [elem lanes]
                                    (let [lb (ty-size g elem)
                                          fty (unless (= lb 4) 1)
                                          asrc (av-slot! g aav)
                                          bsrc (av-slot! g bav)
                                          csrc (av-slot! g cav)
                                          dslot (slot-for-ty! g (mut rtp))]
                                      (for [k 0 (extent-value lanes)]
                                        (emit-load-fp! g
                                                       0
                                                       28
                                                       (primitive/iadd asrc
                                                                       (primitive/imul k
                                                                                       lb))
                                                       lb)
                                        (emit-load-fp! g
                                                       1
                                                       28
                                                       (primitive/iadd bsrc
                                                                       (primitive/imul k
                                                                                       lb))
                                                       lb)
                                        (emit-load-fp! g
                                                       2
                                                       28
                                                       (primitive/iadd csrc
                                                                       (primitive/imul k
                                                                                       lb))
                                                       lb)
                                        (a64-w! (mut s) (a64-fmadd fty 0 0 1 2))
                                        (emit-store-fp! g
                                                        0
                                                        28
                                                        (primitive/iadd dslot
                                                                        (primitive/imul k
                                                                                        lb))
                                                        lb))
                                      (set! envp
                                            (gscope-put a
                                                        (load envp)
                                                        t0
                                                        (mk-aval 1 dslot rty)))
                                      0))
                              (_ (cga-fail "llvm-ir: fma on non-vector")))))))
                  "@llvm.vector.reduce.fadd.v4f32"
                    (let [(mut rtp) rty]
                      (set! tokp (primitive/iadd tokp 2))
                      ; skip "("
                      (ir-parse-type irctx toks (mut tokp))
                      ; float
                      (unless (= (get (load toks) tokp) "0.0")
                        (cga-fail2 "llvm-ir: reduce.fadd start must be 0.0: "
                                   line))
                      (set! tokp (primitive/iadd tokp 1))
                      (let [vt (ir-parse-type irctx toks (mut tokp))
                            vav
                              (ir-value irctx
                                        (load envp)
                                        (get (load toks) tokp)
                                        vt)]
                        (match vt
                          (TVec [elem lanes]
                                (let [lb (ty-size g elem)
                                      fty (unless (= lb 4) 1)
                                      src (av-slot! g vav)
                                      dslot (slot-for-ty! g (mut rtp))]
                                  ; s0 = +0.0 (all-zero bits)
                                  (a64-w! (mut s)
                                          (if (= lb 4)
                                              (a64-fmov-w-to-fp 0 31)
                                              (a64-fmov-x-to-fp 0 31)))
                                  (for [k 0 (extent-value lanes)]
                                    (emit-load-fp! g
                                                   1
                                                   28
                                                   (primitive/iadd src
                                                                   (primitive/imul k
                                                                                   lb))
                                                   lb)
                                    (a64-w! (mut s) (a64-fadd fty 0 0 1)))
                                  (emit-store-fp! g 0 28 dslot lb)
                                  (set! envp
                                        (gscope-put a
                                                    (load envp)
                                                    t0
                                                    (mk-aval 1 dslot rty)))
                                  0))
                          (_ (cga-fail "llvm-ir: reduce on non-vector")))))
                  "@llvm.sqrt.v4f32"
                    (let [(mut rtp) rty]
                      (set! tokp (primitive/iadd tokp 2))
                      ; skip callee, "("
                      (let [at (ir-parse-type irctx toks (mut tokp))
                            aav (ir-value-adv! irctx toks (mut tokp) at)]
                        (match rty
                          (TVec [elem lanes]
                                (let [lb (ty-size g elem)
                                      fty (unless (= lb 4) 1)
                                      src (av-slot! g aav)
                                      dslot (slot-for-ty! g (mut rtp))]
                                  (for [k 0 (extent-value lanes)]
                                    (emit-load-fp! g
                                                   0
                                                   28
                                                   (primitive/iadd src
                                                                   (primitive/imul k
                                                                                   lb))
                                                   lb)
                                    (a64-w! (mut s) (a64-fsqrt fty 0 0))
                                    (emit-store-fp! g
                                                    0
                                                    28
                                                    (primitive/iadd dslot
                                                                    (primitive/imul k
                                                                                    lb))
                                                    lb))
                                  (ir-bind! irctx envp t0 (mk-aval 1 dslot rty))))
                          (_ (cga-fail "llvm-ir: sqrt on non-vector")))))
                  "@llvm.masked.gather.v4i8.v4p0"
                    (let [(mut rtp) rty]
                      (set! tokp (primitive/iadd tokp 2))
                      ; skip "("
                      (let [ptrsty (ir-parse-type irctx toks (mut tokp))
                            ptrsav (ir-value-adv! irctx toks (mut tokp) ptrsty)]
                        (ir-parse-type irctx toks (mut tokp))
                        (set! tokp
                              ; i32 (immarg align)
                              (primitive/iadd tokp 1))
                        ; skip its literal
                        (let [maskty (ir-parse-type irctx toks (mut tokp))
                              maskav
                                (ir-value-adv! irctx toks (mut tokp) maskty)
                              passty (ir-parse-type irctx toks (mut tokp))
                              passav
                                (ir-value-adv! irctx toks (mut tokp) passty)]
                          (match rty
                            (TVec [relemp lanes]
                                  (let [relb (ty-size g relemp)
                                        dslot (slot-for-ty! g (mut rtp))]
                                    (for [k 0 (extent-value lanes)]
                                      (av-to-x! g
                                                (ir-lane-av irctx
                                                            maskav
                                                            k
                                                            (TBool)
                                                            1)
                                                9)
                                      (let [lfalse
                                              (a64-new-label (mut (.asm g)))
                                            lend (a64-new-label (mut (.asm g)))]
                                        (a64-cbz-label! (mut (.asm g)) 9 lfalse)
                                        (av-to-x! g
                                                  (ir-lane-av irctx
                                                              ptrsav
                                                              k
                                                              (TPtr (box-type a
                                                                              (TInt 8
                                                                                    true)))
                                                              8)
                                                  10)
                                        (emit-load-int! g 11 10 0 relb false)
                                        (emit-store-int! g
                                                         11
                                                         28
                                                         (primitive/iadd dslot
                                                                         (primitive/imul k
                                                                                         relb))
                                                         relb)
                                        (a64-b-label! (mut (.asm g)) lend)
                                        (a64-bind-label! (mut (.asm g)) lfalse)
                                        (emit-copy! g
                                                    (primitive/iadd dslot
                                                                    (primitive/imul k
                                                                                    relb))
                                                    (primitive/iadd (av-slot! g
                                                                              passav)
                                                                    (primitive/imul k
                                                                                    relb))
                                                    relb)
                                        (a64-bind-label! (mut (.asm g)) lend)))
                                    (ir-bind! irctx
                                              envp
                                              t0
                                              (mk-aval 1 dslot rty))))
                            (_ (cga-fail "llvm-ir: masked.gather on non-vector result"))))))
                  (cga-fail2 "llvm-ir: unsupported intrinsic: " callee))))))))

; ============================ static asserts =================================
; faithful port of codegen.coil const-eval (LLVM size/align/offset queries
; replaced by this backend's own layout — same natural-layout answers).

(defn g-user-fail [(msg (slice u8))] (-> i64)
  (let [w (stderr)]
    (print-str w "error: ")
    (print-str w msg)
    (write-byte w (: 10 u8))
    (cga64.exit (: 1 i32))
    0))

(defn g-eval-asserts! [(g (ptr Cga)) (mp (ptr Program))] (-> i64)
  (let [asserts (load (field mp asserts))
        n (len (load asserts))
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (let [sa (al-at [StaticAssert] asserts (load i))]
                  (when (= (gcev-v (g-const-eval (native-context g)
                                                 (field sa cnd)))
                           0)
                    (let [w (stderr)]
                      (print-str w "error: static assertion failed: ")
                      (print-str w (.msg sa))
                      (write-byte w (: 10 u8))
                      (cga64.exit (: 1 i32))
                      0)))
                (set! i (primitive/iadd (load i) 1))))))
  0)

; ============================ function emission ==============================
; A machine-code function is its bytes at its symbol, then a return unless it
; never returns: no frame, no parameter intake, and a :shim convention's
; callers already put the arguments where the bytes read them.
(defn emit-machine-code-func! [(g (ptr Cga))
                               (fd (ptr Func))
                               (code MachineCodeBody)] (-> i64)
  (compiler-work! "emit" (.name fd))
  (match (machine-code-target-error (.a g)
                                    (.name fd)
                                    (.arch code)
                                    "aarch64")
    (Some [message]
          (cga-fail (text/format (.a g) "codegen: {} (checker bug)" message)))
    (None [] 0))
  (let [s (field g asm)
        si (g-sig-idx g (.name fd))
        bytes (load (.bytes code))]
    (when (< si 0)
      (cga-fail2 "emit-func!: unregistered function " (.name fd)))
    (mobj-set-sym! (mut (.obj g))
                   (.symidx (al-at [GSig] (field g sigs) si))
                   (.text g)
                   (a64-off (mut s)))
    (for i (range 0 (len bytes))
      (b-u8! (mut (.buf s)) (primitive/cast i64 (get bytes i))))
    (when (func-machine-code-returns? fd)
      (a64-w! (mut s) (a64-ret)))
    0))

(defn emit-func! [(g (ptr Cga)) (fd (ptr Func))] (-> i64)
  (match (func-machine-code fd)
    (Some [code] (emit-machine-code-func! g fd code))
    (None [] (emit-coil-func! g fd))))

(defn emit-coil-func! [(g (ptr Cga)) (fd (ptr Func))] (-> i64)
  (compiler-work! "emit" (.name fd))
  ; reset per-function state
  (set! (.frame g) 0)
  (set! (.dwcursrc g) -1)
  (set! (.dwcurlo g) -1)
  (set! (.env g) (gscope-nil (.a g)))
  (set! (.len (.loops g)) 0)
  (set! (.terminated g) false)
  (set! (.retty g) (.ret fd))
  (set! (.sretslot g) -1)
  (set! (.outbytes g) 0)
  (set! (.outfixes g) (ArrayList::new [OutFix] (.a g)))
  (set! (.nstatic g) 0)
  ; self-tail-call state, fresh per function
  (set! (.selfname g) (.name fd))
  (set! (.tailok g) false)
  (set! (.inline_depth g) 0)
  (set! (.tailslots g)
        (box! (.a g)
              (ArrayList i64)
              (ArrayList::new [i64] (.a g))))
  (set! (.tailtys g)
        (box! (.a g)
              (ArrayList Type)
              (ArrayList::new [Type] (.a g))))
  (set! (.entrylabel g) (a64-new-label (mut (.asm g))))
  (let [s (field g asm)
        a (.a g)
        si (g-sig-idx g (.name fd))]
    (when (< si 0)
      (cga-fail2 "emit-func!: unregistered function " (.name fd)))
    ; pin the symbol to the function start (a :shim function's BODY is the
    ; __impl symbol; the Coil name gets the trampoline emitted afterwards)
    (mobj-set-sym! (mut (.obj g))
                   (if (.shim (al-at [GSig] (field g sigs) si))
                       (.implsym (al-at [GSig] (field g sigs) si))
                       (.symidx (al-at [GSig] (field g sigs) si)))
                   (.text g)
                   (a64-off (mut s)))
    (set! (.fnstart g) (a64-off (mut s)))
    ; line row at the function entry (its defn line) — the prologue-end row
    ; after param intake then tells lldb where breakpoints should land
    (when (>= (.source fd) 0)
      (let [(mut ev) (zeroed DwLineEv)]
        (set! (.textoff ev) (a64-off (mut s)))
        (set! (.source ev) (.source fd))
        (set! (.lo ev)
              (if (< (.lo fd) 0)
                  0
                  (do
                    (.lo fd))))
        (set! (.pe ev) false)
        (push! (mut (.dwevs g)) ev)
        (set! (.dwcursrc g) (.source fd))
        (set! (.dwcurlo g) (.lo ev))
        0))
    (let [dwvarlo (len (.dwvars g))
          dwfnlo (.lo fd)
          dwfnsrc (.source fd)]
      ; ---- prologue (frame sizes patched at the end)
      (a64-w! (mut s) (a64-stp-pre 29 30 31 -16))
      (a64-w! (mut s) (a64-mov-sp 29 31))
      ; save x28 (16B for alignment)
      (a64-w! (mut s) (a64-ldstp 3 0 28 31 31 -2))  ; stp x28, xzr, [sp, #-16]!
      (let [p1 (a64-off (mut s))]
        ; x16 = frame size (48 bits); sub sp, sp, x16
        (a64-w! (mut s) (a64-movz 16 0 0))
        (a64-w! (mut s) (a64-movk 16 0 1))
        (a64-w! (mut s) (a64-movk 16 0 2))
        (a64-w! (mut s) (a64-sub-ext 31 31 16))
        (emit-out-addr! g 28)  ; x28 = sp + outbytes
        ; ---- parameter intake (mirror of the emit-call! plan)
        (let [(mut retp) (.ret fd)]
          (let [retvoid (match (.ret fd) (TVoid [] true) (_ false))
                retinfo
                  (if retvoid
                      (mk-abi-scalar)
                      (g-abi-info g
                                  (mut retp)))]
            ; incoming sret pointer
            (when (= (abi-cls retinfo) 4)
              (let [ss (slot-new! (native-context g) 8 8)]
                (emit-store-int! g 8 28 ss 8)
                (set! (.sretslot g) ss))
              0)
            (let [ps (load (field fd params))
                  np (len (load ps))
                  (mut gp) 0
                  (mut fp) 0
                  (mut stk) 0
                  (mut i) 0]
              (loop (if (>= (load i) np)
                        (break)
                        (do
                          (let [prm (al-at [Param] ps (load i))
                                t (field prm ty)
                                info (g-abi-info g t)
                                cls (abi-cls info)
                                slot (slot-for-ty! g t)
                                sz (ty-size g t)
                                _tailrec
                                  (do
                                    (push! (load (field g tailslots)) slot)
                                    (push! (load (field g tailtys)) (load t))
                                    0)]
                            ; stack-passed params sit at x29 + 16 + off, placed by the
                            ; same Apple rules the caller used (a64-named-stack-place!)
                            (cond (= cls 6)
                                    0  ; an empty struct: nothing arrives
                                  (= cls 0)
                                    (if (< (load gp) 8)
                                        (do
                                          (emit-store-int! g
                                                           (load gp)
                                                           28
                                                           slot
                                                           (if (ty-is-scalar t)
                                                               sz
                                                               (if (> sz
                                                                      8)
                                                                   8
                                                                   sz)))
                                          (set! gp (primitive/iadd (load gp) 1))
                                          0)
                                        (let [off
                                                (a64-named-stack-place! (mut stk)
                                                                        sz
                                                                        sz)]
                                          (emit-copy-exact! g
                                                            28
                                                            slot
                                                            29
                                                            (+ 16 off)
                                                            sz)))
                                  (= cls 1)
                                    (if (< (load fp) 8)
                                        (do
                                          (emit-store-fp! g
                                                          (load fp)
                                                          28
                                                          slot
                                                          (ty-float-bytes t))
                                          (set! fp (primitive/iadd (load fp) 1))
                                          0)
                                        (let [fb (ty-float-bytes t)
                                              off
                                                (a64-named-stack-place! (mut stk)
                                                                        fb
                                                                        fb)]
                                          (emit-copy-exact! g
                                                            28
                                                            slot
                                                            29
                                                            (+ 16 off)
                                                            fb)))
                                  (= cls 2)
                                    (if (< (load gp) 8)
                                        (do
                                          (emit-store-int! g
                                                           (load gp)
                                                           28
                                                           slot
                                                           8)
                                          (set! gp (primitive/iadd (load gp) 1))
                                          0)
                                        (let [off
                                                (a64-named-stack-place! (mut stk)
                                                                        8
                                                                        (a64-aggregate-stack-align g
                                                                                                   t))]
                                          (emit-copy-exact! g
                                                            28
                                                            slot
                                                            29
                                                            (+ 16 off)
                                                            sz)))
                                  (= cls 3)
                                    (let [gp0
                                            (if (>= (ty-align g t)
                                                    16)
                                                (* (/ (+ (load gp) 1) 2) 2)
                                                (load gp))]
                                      (if (<= gp0 6)
                                          (do
                                            (emit-store-int! g gp0 28 slot 8)
                                            (emit-store-int! g
                                                             (primitive/iadd gp0
                                                                             1)
                                                             28
                                                             (primitive/iadd slot
                                                                             8)
                                                             8)
                                            (set! gp (primitive/iadd gp0 2))
                                            0)
                                          (let [off
                                                  (a64-named-stack-place! (mut stk)
                                                                          16
                                                                          (a64-aggregate-stack-align g
                                                                                                     t))]
                                            (emit-copy-exact! g
                                                              28
                                                              slot
                                                              29
                                                              (+ 16 off)
                                                              sz)
                                            (set! gp 8)
                                            0)))
                                  (= cls 5)
                                    (let [hn (abi-hfa-n info)
                                          lb (/ (abi-hfa-bits info) 8)]
                                      (if (<= (primitive/iadd (load fp) hn)
                                              8)
                                          (do
                                            (let [(mut j) 0]
                                              (loop (if (>= (load j) hn)
                                                        (break)
                                                        (do
                                                          (emit-store-fp! g
                                                                          (primitive/iadd (load fp)
                                                                                          (load j))
                                                                          28
                                                                          (primitive/iadd slot
                                                                                          (primitive/imul (load j)
                                                                                                          lb))
                                                                          lb)
                                                          (set! j
                                                                (primitive/iadd (load j)
                                                                                1))))))
                                            (set! fp
                                                  (primitive/iadd (load fp)
                                                                  hn))
                                            0)
                                          (let [off
                                                  (a64-named-stack-place! (mut stk)
                                                                          (* hn
                                                                             lb)
                                                                          lb)]
                                            (emit-copy-exact! g
                                                              28
                                                              slot
                                                              29
                                                              (+ 16 off)
                                                              (* hn lb))
                                            (set! fp 8)
                                            0)))
                                  ; cls 4: pointer to a caller-made copy — copy it in
                                  (< (load gp) 8)
                                    (do
                                      (a64-w! (mut s) (a64-mov-reg 9 (load gp)))
                                      (emit-copy-from-mem! g slot 9 sz)
                                      (set! gp (primitive/iadd (load gp) 1))
                                      0)
                                  :else
                                    (let [off
                                            (a64-named-stack-place! (mut stk)
                                                                    8
                                                                    8)]
                                      (emit-load-int! g 9 29 (+ 16 off) 8 false)
                                      (emit-copy-from-mem! g slot 9 sz)
                                      0))
                            (dw-note-var! g
                                          (.name prm)
                                          t
                                          slot
                                          false
                                          true
                                          (.source fd)
                                          (.lo fd))
                            (set! (.env g)
                                  (gscope-put a
                                              (load (field g env))
                                              (.name prm)
                                              (mk-aval 1 slot (load t)))))
                          (set! i (primitive/iadd (load i) 1))))))
            ; ---- prologue is complete: mark it for the line table so lldb
            ; stops AFTER params are spilled (frame vars valid from here)
            (when (>= (.source fd) 0)
              (let [(mut ev) (zeroed DwLineEv)]
                (set! (.textoff ev) (a64-off (mut s)))
                (set! (.source ev) (.source fd))
                (set! (.lo ev)
                      (if (< (.lo fd) 0)
                          0
                          (do
                            (.lo fd))))
                (set! (.pe ev) true)
                (push! (mut (.dwevs g)) ev)
                0))
            ; ---- body. The entry label sits AFTER parameter intake, so a self-tail
            ; call jumps here: the frame, the incoming-argument registers and the
            ; spill code are all already done, and re-running them would be wrong.
            (a64-bind-label! (mut (.asm g)) (.entrylabel g))
            (let [bav (emit-body-tail g (load (field fd body)))]
              (unless (.terminated g)
                (unless  ; ---- return value per ABI class
                  retvoid
                  (let [cls (abi-cls retinfo)]
                    (cond (= cls 6) 0
                          ; an empty struct: nothing to return
                          (= cls 0) (av-to-x! g bav 0)
                          (= cls 1) (av-to-d! g bav 0)
                          (= cls 2)
                            (emit-load-int! g
                                            0
                                            28
                                            (av-slot! g bav)
                                            (ty-size g
                                                     (mut retp))
                                            false)
                          (= cls 3)
                            (let [bs (av-slot! g bav)]
                              (emit-load-int! g 0 28 bs 8 false)
                              (emit-load-int! g
                                              1
                                              28
                                              (primitive/iadd bs 8)
                                              8
                                              false))
                          (= cls 5)
                            (let [bs (av-slot! g bav)
                                  hn (abi-hfa-n retinfo)
                                  lb (/ (abi-hfa-bits retinfo) 8)]
                              (for [j 0 hn]
                                (emit-load-fp! g
                                               j
                                               28
                                               (primitive/iadd bs
                                                               (primitive/imul j
                                                                               lb))
                                               lb))
                              0)
                          :else
                            ; cls 4: copy into *sret
                            (do
                              (emit-load-int! g
                                              9
                                              28
                                              (.sretslot g)
                                              8
                                              false)
                              (emit-copy-to-mem! g
                                                 9
                                                 (av-slot! g bav)
                                                 (ty-size g
                                                          (mut retp)))
                              0))))
                0)
              ; ---- epilogue
              (a64-w! (mut s) (a64-sub-imm 16 29 16))
              ; x16 = x29 - 16 (saved x28)
              (a64-w! (mut s) (a64-ldr-x 28 16 0))
              (a64-w! (mut s) (a64-add-imm 31 29 0))
              ; sp = x29
              (a64-w! (mut s) (a64-ldp-post 29 30 31 16))
              (a64-w! (mut s) (a64-ret))
              ; ---- resolve labels, patch frame sizes
              (a64-resolve-fixups! (mut s))
              (let [slotbytes
                      (primitive/imul (/ (primitive/iadd (.frame g)
                                                         15)
                                         16)
                                      16)
                    out (.outbytes g)
                    total (primitive/iadd slotbytes out)]
                ; AArch64 user address space is 48 bits: a larger frame could
                ; never be mapped, so it is a limit of the machine, not of us.
                (when (> total 281474976710655)
                  (g-user-fail "stack frame exceeds the 48-bit AArch64 address space"))
                (when (> out 16777215)
                  (g-user-fail "a call's stack arguments exceed 16 MiB"))
                (for [k 0 3]
                  (b-patch-u32! (mut (.buf s))
                                (primitive/iadd p1 (primitive/imul k 4))
                                (if (= k 0)
                                    (a64-movz 16 (& total 65535) 0)
                                    (a64-movk 16
                                              (& (>> total
                                                     (primitive/imul k
                                                                     16))
                                                 65535)
                                              k))))
                (for [k 0 (len (.outfixes g))]
                  (let [fx (get (.outfixes g) k)]
                    (b-patch-u32! (mut (.buf s))
                                  (.off fx)
                                  (a64-add-imm-lsl12 (.rd fx)
                                                     31
                                                     (& (>> out 12) 4095)))
                    (b-patch-u32! (mut (.buf s))
                                  (primitive/iadd (.off fx) 4)
                                  (a64-add-imm (.rd fx)
                                               (.rd fx)
                                               (& out 4095)))))
                ; record the function for DWARF
                (let [(mut df) (zeroed DwFn)]
                  (set! (.name df) (.name fd))
                  (set! (.symidx df)
                        (.symidx (al-at [GSig]
                                        (field g
                                               sigs)
                                        si)))
                  (set! (.source df)
                        (if (< dwfnsrc 0) 0 (do dwfnsrc)))
                  (set! (.lo df)
                        (if (< dwfnlo 0) 0 (do dwfnlo)))
                  (set! (.textoff df) (.fnstart g))
                  (set! (.len df)
                        (primitive/isub (a64-off (mut s))
                                        (.fnstart g)))
                  (set! (.slotbytes df) slotbytes)
                  (set! (.varlo df) dwvarlo)
                  (set! (.varhi df) (len (.dwvars g)))
                  (push! (mut (.dwfns g)) df))
                ; :shim: the Coil-named symbol is a trampoline that moves the
                ; convention's registers into the C argument registers, calls
                ; __impl, and moves x0 back into the convention's return register.
                (when (.shim (al-at [GSig] (field g sigs) si))
                  (let [e (al-at [GSig] (field g sigs) si)
                        regs (load (field e shimregs))
                        nr (len (load regs))]
                    (mobj-set-sym! (mut (.obj g))
                                   (.symidx e)
                                   (.text g)
                                   (a64-off (mut s)))
                    (a64-w! (mut s) (a64-stp-pre 29 30 31 -16))
                    (a64-w! (mut s) (a64-mov-sp 29 31))
                    ; through the stack: moved one at a time, a convention
                    ; taking (x1 x0) would overwrite x0 before reading it
                    (for j (range 0 nr)
                      (a64-w! (mut s)
                              (a64-stp-pre (get (load regs) j) 31 31 -16)))
                    (for k (range 0 nr)
                      (a64-w! (mut s) (a64-ldp-post (- (- nr 1) k) 31 31 16)))
                    (mobj-add-reloc! (mut (.obj g))
                                     (.text g)
                                     (a64-off (mut s))
                                     (.implsym e)
                                     (reloc-branch26)
                                     true
                                     2)
                    (a64-w! (mut s) (a64-bl-raw))
                    (when (!= (.shimret e) 0)
                      (a64-w! (mut s) (a64-mov-reg (.shimret e) 0)))
                    (a64-w! (mut s) (a64-ldp-post 29 30 31 16))
                    (a64-w! (mut s) (a64-ret))
                    0))
                0)))))))
  0)

; ============================ driver =========================================
; Build the program's Mach-O object IN MEMORY. Serializing it to a file (the AOT
; path) and loading it straight into executable memory (jit.coil, the comptime and
; metaprogram path) are both thin wrappers over this — the codegen happens once,
; here, so the two paths can never drift.
(defn cga64-build-mobj [(a (dyn Allocator))
                        (mp (ptr Program))
                        (mainpath (slice u8))
                        (compdir (slice u8))
                        (paths (ptr (ArrayList (slice u8))))
                        (texts (ptr (ArrayList (slice u8))))
                        (emit-dwarf bool)] (-> MObj)
  (let [g (primitive/alloc-stack Cga)]
    (set! (.a g) a)
    (set! (.program g) mp)
    (set! (.sigs g) (ArrayList::new [GSig] a))
    (set! (.sig_index g) (HashMap::new [(slice u8) i64] a (keyops)))
    (set! (.sig_memo g) (ArrayList::new [NameMemo] a))  ; unused until registration ends
    (set! (.unit_export_index g)
          (HashMap::new [(slice u8) bool] a (keyops-borrowed)))
    (set! (.export_symbol_index g)
          (HashMap::new [(slice u8) (slice u8)] a (keyops-borrowed)))
    (for [i 0 (len (load (.unit_exports mp)))]
      (set! (mut (.unit_export_index g)) (get (load (.unit_exports mp)) i) true))
    (for [i 0 (len (load (.exports mp)))]
      (let [e (elem (.exports mp) i)]
        ; Match the former ordered lookup: the first declaration wins.
        (unless (contains? (.export_symbol_index g)
                           (.name e))
          (match (.symbol e)
            (Some [symbol]
                  (set! (mut (.export_symbol_index g)) (.name e) symbol))
            (None [] 0)))))
    (set! (.spec_names g) (HashMap::new [(slice u8) bool] a (keyops)))
    (set! (.obj g) (mobj-new a))
    (set! (.asm g) (asm-new a))
    (set! (.strs g) (ArrayList::new [GStr] a))
    (set! (.str_index g) (HashMap::new [(slice u8) i64] a (keyops)))
    (set! (.statics g) (ArrayList::new [GStatic] a))
    (set! (.nglob g) 0)
    (set! (.nstatic g) 0)
    (set! (.loops g) (ArrayList::new [GLoop] a))
    (set! (.env g) (gscope-nil a))
    (set! (.frame g) 0)
    (set! (.terminated g) false)
    (set! (.sretslot g) -1)
    (set! (.outbytes g) 0)
    (set! (.outfixes g) (ArrayList::new [OutFix] a))
    (set! (.fnstart g) 0)
    (set! (.retty g) (TInt 64 true))
    (set! (.epilabel g) 0)
    (set! (.dwtypes g) (dbg-types-new a))
    (set! (.dwfns g) (ArrayList::new [DwFn] a))
    (set! (.dwvars g) (ArrayList::new [DwVar] a))
    (set! (.dwevs g) (ArrayList::new [DwLineEv] a))
    (set! (.dwcursrc g) -1)
    (set! (.dwcurlo g) -1)
    (set! (.convs g) (load (field mp conventions)))
    (set! (.inline_depth g) 0)
    ; sections: ordinals are 1-based in push order
    (set! (.text g)
          (mobj-add-sect! (mut (.obj g)) "__TEXT" "__text" 2 2147484672))
    (set! (.constsec g) (mobj-add-sect! (mut (.obj g)) "__TEXT" "__const" 3 0))
    (set! (.datasec g) (mobj-add-sect! (mut (.obj g)) "__DATA" "__data" 3 0))
    ; (export-c …): an exported function is emitted directly under its C symbol with
    ; external linkage (g-register-sigs! below) — no thunk needed for scalar/pointer
    ; params or struct returns. A by-value STRUCT parameter reaches a Coil function
    ; by reference on this backend, so such an export gets a thunk: it receives the
    ; C arguments by value and calls the function, which stays internal.
    (let [thunks (export-c-thunks a mp)
          ; codegen works on a copy of the program with the thunks added; the
          ; caller's program (which a JIT session retains) is left as it was
          (mut with-thunks) (load mp)
          mp (cast (ptr Program) (mut with-thunks))]
      (unless (= (len thunks) 0)
        (let [(mut funcs) (ArrayList::new [Func] a)]
          (for f (load (.funcs mp)) (push! (mut funcs) f))
          (for f thunks (push! (mut funcs) f))
          (set! (.funcs with-thunks) (box! a (ArrayList Func) (load funcs))))
        (for i (range 0 (len (load (.exports mp))))
          (let [e (elem (.exports mp) i)]
            (when (export-c-needs-thunk? e)
              (match (g-export-c-sym g (.name e))
                (Some [symbol]
                      (remove! (mut (.export_symbol_index g)) (.name e))
                      ; An unpublished entry is reached only through fnptr-of,
                      ; so its thunk keeps a local symbol.
                      (when (.published e)
                        (set! (mut (.export_symbol_index g))
                              (export-c-thunk-name a (.name e))
                              symbol)
                        0))
                (None [] 0))))))
      (let [span (tr/span-begin "jit.codegen.register-types")]
        (g-register-types! g mp)
        (tr/span-end span))
      (let [span (tr/span-begin "jit.codegen.asserts")]
        (g-eval-asserts! g mp)
        (tr/span-end span))
      (let [span (tr/span-begin "jit.codegen.register-sigs")]
        (g-register-sigs! g mp)
        ; sig_index is final now: memoize its lookups from here on
        (set! (.sig_memo g) (name-memo-new (.a g)))
        (tr/span-end span))
      (let [span (tr/span-begin "jit.codegen.declare-statics")]
        (g-declare-statics! g mp)
        (tr/span-end span))
      ; emit every function
      (let [span (tr/span-begin "jit.codegen.functions")
            fs (load (field mp funcs))
            n (len (load fs))]
        (for [i 0 n]
          ; A declaration has no body to emit; its object is linked.
          (unless (.declared (al-at [Func] fs i))
            (emit-func! g (al-at [Func] fs i))
            0))
        (tr/span-end span))
      ; move the code into the __text section and serialize
      (b-bytes! (mut (mobj-sect-buf (mut (.obj g)) (.text g)))
                (slice (.buf (.asm g))))
      ; ---- DWARF (on for a normal build; a metaprogram dylib passes emit-dwarf=false —
      ; it needs no debug info and has no registered source paths/texts to describe).
      (when emit-dwarf
        (g-emit-dwarf! g
                       mainpath
                       compdir
                       paths
                       texts
                       (field (field g dwtypes) tys)
                       (field g dwfns)
                       (field g dwvars)
                       (field g dwevs)
                       (len (.buf (.asm g)))
                       29
                       16))
      (.obj g))))

;;; Serialize the DWARF records as __DWARF sections of the MObj, with the
;;; __text section relocations dsymutil needs (shared by codegen_tpde). `fbreg`
;;; and `fbbias` are dw-build!'s frame base register and slot bias.
(defn g-emit-dwarf! [(g (ptr Cga))
                     (mainpath (slice u8))
                     (compdir (slice u8))
                     (paths (ptr (ArrayList (slice u8))))
                     (texts (ptr (ArrayList (slice u8))))
                     (tys (ptr (ArrayList DwTy)))
                     (fns (ptr (ArrayList DwFn)))
                     (vars (ptr (ArrayList DwVar)))
                     (evs (ptr (ArrayList DwLineEv)))
                     (textlen i64)
                     (fbreg i64)
                     (fbbias i64)] (-> i64)
  (let [ltmp
          (mobj-add-sym! (mut (.obj g))
                         "ltmp0"
                         (.text g)
                         0
                         false)
        dw
          (dw-build! (.a g)
                     mainpath
                     compdir
                     paths
                     texts
                     tys
                     fns
                     vars
                     evs
                     textlen
                     ltmp
                     fbreg
                     fbbias)]
    (g-add-dwarf-sections! g dw)))

;;; Add built DWARF (`dw`) to the MObj as __DWARF sections, with the __text
;;; section relocations dsymutil needs.
(defn g-add-dwarf-sections! [(g (ptr Cga)) (dw (ptr DwOut))] (-> i64)
  (let [dbgattr 33554432
        sline
          (mobj-add-sect! (mut (.obj g))
                          "__DWARF"
                          "__debug_line"
                          0
                          dbgattr)
        sinfo
          (mobj-add-sect! (mut (.obj g))
                          "__DWARF"
                          "__debug_info"
                          0
                          dbgattr)
        sabbr
          (mobj-add-sect! (mut (.obj g))
                          "__DWARF"
                          "__debug_abbrev"
                          0
                          dbgattr)
        sstr
          (mobj-add-sect! (mut (.obj g))
                          "__DWARF"
                          "__debug_str"
                          0
                          dbgattr)]
    (b-bytes! (mut (mobj-sect-buf (mut (.obj g)) sline))
              (slice (load (load (field dw
                                        line)))))
    (b-bytes! (mut (mobj-sect-buf (mut (.obj g)) sinfo))
              (slice (load (load (field dw
                                        info)))))
    (b-bytes! (mut (mobj-sect-buf (mut (.obj g)) sabbr))
              (slice (load (load (field dw
                                        abbrev)))))
    (b-bytes! (mut (mobj-sect-buf (mut (.obj g)) sstr))
              (slice (load (load (field dw
                                        strs)))))
    ; location lists (tpde's), offsets relative to the CU's base: no relocations
    (when (> (len (load (.loc (load dw)))) 0)
      (let [sloc
              (mobj-add-sect! (mut (.obj g)) "__DWARF" "__debug_loc" 0 dbgattr)]
        (b-bytes! (mut (mobj-sect-buf (mut (.obj g)) sloc))
                  (slice (load (.loc (load dw)))))))
    (let [rl (load (field dw relocs))
          nr (len (load rl))
          (mut i) 0]
      (loop (if (>= (load i) nr)
                (break)
                (do
                  (let [r (al-at [DwReloc] rl (load i))]
                    ; a SECTION reloc targeting __text (negative sym = -(section ordinal),
                    ; r_extern=0 in the writer) — clang's Mach-O DWARF scheme, the one dsymutil
                    ; relocates per-function via the debug map.
                    (mobj-add-reloc! (mut (.obj g))
                                     (if (= (.sect r)
                                            1)
                                         sinfo
                                         sline)
                                     (.off r)
                                     (primitive/isub 0
                                                     (.text g))
                                     (reloc-unsigned)
                                     false
                                     3))
                  (set! i (primitive/iadd (load i) 1)))))))
  0)

; serialize a built object to disk — the AOT path.
(defn cga64-last-needs-curl-cell [] (-> (ptr bool))
  (field (cga64-unit-state) curl))

(defn cga64-last-needs-llvm-cell [] (-> (ptr bool))
  (field (cga64-unit-state) llvm))

(defn cga64-last-needs-curl? [] (-> bool)
  (load (cga64-last-needs-curl-cell)))

(defn cga64-last-needs-llvm? [] (-> bool)
  (load (cga64-last-needs-llvm-cell)))

(defn cga64-probe-name [(a (dyn Allocator))
                        (left (slice u8))
                        (right (slice u8))] (-> (slice u8))
  (let [(mut b) (ArrayList::new [u8] a)]
    (b-bytes! (mut b) left)
    (b-bytes! (mut b) right)
    (slice (load b))))

(defn cga64-build-object [(a (dyn Allocator))
                          (mp (ptr Program))
                          (objpath (ptr i8))
                          (mainpath (slice u8))
                          (compdir (slice u8))
                          (paths (ptr (ArrayList (slice u8))))
                          (texts (ptr (ArrayList (slice u8))))
                          (emit-dwarf bool)] (-> i64)
  (let [(mut o) (cga64-build-mobj a mp mainpath compdir paths texts emit-dwarf)
        bytes (macho-write (mut o))
        fd (fs/create-file objpath 420)]
    ; Preserve link requirements while the relocation graph is still in memory.
    ; The build driver can consume these facts without reading and decoding the
    ; just-written object.  Exact names intentionally remain split so the
    ; compiler's own object does not acquire the complete probe strings.
    (set! (cga64-last-needs-curl-cell)
          (mobj-references-undefined? (mut o)
                                      (cga64-probe-name a "_curl_easy_" "init")))
    (set! (cga64-last-needs-llvm-cell)
          (mobj-references-undefined? (mut o)
                                      (cga64-probe-name a
                                                        "_LLVMGetDefault"
                                                        "TargetTriple")))
    (when (< fd 0) (cga-fail "cannot create object file"))
    (let [total (len (load bytes))
          (mut off) 0]
      (loop (if (>= (load off) total)
                (break)
                (do
                  (let [wrote
                          (cga64.write (primitive/cast i32 fd)
                                       (primitive/cast (ptr i8)
                                                       (index (data (slice (load bytes)))
                                                              (load off)))
                                       (primitive/cast isize
                                                       (primitive/isub total
                                                                       (load off))))]
                    (when (<= wrote 0)
                      (cga-fail "object write failed"))
                    (set! off
                          (primitive/iadd (load off) (primitive/cast i64 wrote))))))))
    (cga64.close (primitive/cast i32 fd))
    0))

; ============================ DWARF collection ===============================
; rendered, memo-stable name for a type's DIE

; type -> DwTy index, or -1 when we deliberately don't describe it (sums,
; fnptrs, vecs, non-C struct layouts — mirrors the DI-type policy:
; never a wrong type).

;; A type's DwTy index (debuginfo.coil's shared translation), or -1.
(defn dw-ty-of! [(g (ptr Cga)) (t (ptr Type))] (-> i64)
  (dbg-ty-of! (field g dwtypes) (field g layouts) (.a g) t))

; record a line-table row if the source position moved
(defn dw-note-span! [(g (ptr Cga)) (e (ptr Expr))] (-> i64)
  (let [src (.source e)
        lo (.lo e)]
    (unless (or (< src 0)
                (< lo 0)
                (and (= src (.dwcursrc g))
                     (= lo
                        (.dwcurlo g))))
      (let [(mut ev) (zeroed DwLineEv)]
        (set! (.textoff ev) (a64-off (mut (.asm g))))
        (set! (.source ev) src)
        (set! (.lo ev) lo)
        (set! (.pe ev) false)
        (push! (mut (.dwevs g)) ev)
        (set! (.dwcursrc g) src)
        (set! (.dwcurlo g) lo)
        0))))

; DWARF note for a let bind. `(mut x)` desugars to `x.slot` (the alloc) plus
; `x` (a pointer to it): skip the internal `.slot` name and describe `x` as an
; indirect variable of the POINTEE type (location: fbreg off, deref).
(defn dw-note-bind! [(g (ptr Cga))
                     (name (slice u8))
                     (av AVal)
                     (src i64)
                     (lo i64)] (-> i64)
  (let [n (len name)
        (mut t) (av-ty av)]
    (unless (and (>= n 5)
                 (= (subslice name (primitive/isub n 5) n) ".slot"))
      (let [slotname (text/format (.a g) "{}.slot" name)]
        (match (gscope-get (load (field g env)) slotname)
          (Some [_sl]
                ; mut variable: value lives behind the pointer
                (match t
                  (TPtr [inner]
                        (dw-note-var! g name inner (av-v av) true false src lo))
                  (_ (dw-note-var! g
                                   name
                                   (mut t)
                                   (av-v av)
                                   false
                                   false
                                   src
                                   lo))))
          (None []
                (dw-note-var! g
                              name
                              (mut t)
                              (av-v av)
                              false
                              false
                              src
                              lo)))))))

; record a variable/parameter DIE for the current function
(defn dw-note-var! [(g (ptr Cga))
                    (name (slice u8))
                    (t (ptr Type))
                    (slot i64)
                    (indirect bool)
                    (param bool)
                    (src i64)
                    (lo i64)] (-> i64)
  (let [ti (if (dbg-name? name) (dw-ty-of! g t) -1)]
    (unless (or (< ti 0)
                (< src 0)
                (< lo 0))
      (let [(mut v) (zeroed DwVar)]
        (set! (.name v)
              name)
        (set! (.tyidx v)
              ti)
        (set! (.slot v)
              slot)
        (set! (.indirect v)
              indirect)
        (set! (.param v)
              param)
        (set! (.source v)
              src)
        (set! (.lo v)
              lo)
        ; a local is live from here (its initializer has been emitted); a
        ; parameter is live for the whole function
        (set! (.start v)
              (if param -1 (a64-off (mut (.asm g)))))
        (set! (.end v)
              -1)
        (push! (mut (.dwvars g))
               v)
        0))))

(defn ir-store-mask-lane! [(g (ptr Cga)) (av AVal) (dst i64)] (-> i64)
  (emit-load-int! g 9 28 (av-slot! g av) 1 false)
  (emit-store-int! g 9 28 dst 1))

(defn ir-address-base! [(g (ptr Cga)) (av AVal)] (-> i64)
  (av-to-x! g av 9)
  9)

(defn ir-address-offset! [(g (ptr Cga))
                          (base i64)
                          (index AVal)
                          (scale i64)
                          (preserve bool)] (-> i64)
  (let [s (field g asm)
        result (if preserve 12 base)]
    (av-to-x! g index 10)
    (a64-mov-imm! (mut s) 11 scale)
    (a64-w! (mut s) (a64-madd result 10 11 base))
    result))

(defn ir-store-word! [(g (ptr Cga)) (reg i64) (slot i64)] (-> i64)
  (emit-store-int! g reg 28 slot 8))

(defn ir-frame-slot! [(g (ptr Cga)) (size i64) (align i64)] (-> i64)
  (slot-new! (native-context g) size align))

(defn native-lowering-allocator [(g (ptr Cga))] (-> (dyn Allocator))
  (.a g))

(native/implement-lowering (IrContext Cga)
                           [[lowering-inputs :inputs]
                            [lowering-allocator native-lowering-allocator]
                            [lowering-fail cga-fail :static]
                            [lowering-fail2 cga-fail2 :static]
                            [lowering-size ty-size]
                            [lowering-type-slot slot-for-ty!]
                            [lowering-value-slot av-slot!]
                            [lowering-copy emit-copy!]
                            [lowering-cast emit-cast-av!]
                            [lowering-sext-bool ir-sext-bool!]
                            [lowering-compare emit-cmp-av!]
                            [lowering-wide-compare ir-icmp-i128!]
                            [lowering-store-mask-lane ir-store-mask-lane!]
                            [lowering-zero emit-zero!]
                            [lowering-store emit-store-av-at!]
                            [lowering-expression emit-expr]
                            [lowering-ir-line emit-ir-line! :frame]
                            [lowering-aggregate-element ir-agg-elem]
                            [lowering-select ir-select-blend!]
                            [lowering-binary emit-bin-av!]
                            [lowering-value-float av-to-d!]
                            [lowering-load-float ir-load-float!]
                            [lowering-store-float ir-store-float!]
                            [lowering-float-op ir-float-op!]
                            [lowering-address-base ir-address-base!]
                            [lowering-address-offset ir-address-offset!]
                            [lowering-store-word ir-store-word!]
                            [lowering-frame-slot ir-frame-slot!]])
