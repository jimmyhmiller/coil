; src/compiler/jit.coil — load an arm64 MObj into executable memory, in-process.
;
; The compiled comptime/metaprogram engines used to reach native code the long way
; round: serialize the MObj to a .o, fork `cc -dynamiclib`, dlopen the result. This
; module skips all three. It lays the object's sections into one mmap'd region,
; resolves symbols (defined ones by section+offset, undefined ones via dlsym against
; the compiler process itself), applies the four arm64 relocations this backend
; emits, then flips the text pages to R+X and invalidates the icache.
;
; LAYOUT: every __TEXT section first, then the veneer area, then a page boundary,
; then everything else. Only the text half becomes read-execute — __DATA stays
; writable, because Coil globals (alloc-static) live there and comptime code may
; store through them. One region rather than two keeps text and data within adrp's
; +/-4GB page-delta range by construction.
;
; VENEERS. A bl/b carries a signed 26-bit word offset: +/-128MB. Symbols resolved
; through dlsym (libc, and the host hooks a metaprogram calls back into) live
; wherever dyld put them, routinely gigabytes away, so a direct BRANCH26 to one
; would silently truncate and jump into nothing. Every undefined symbol that is the
; target of a branch therefore gets a 5-instruction absolute-jump veneer inside our
; own text, and the branch is retargeted to it. x16 (IP0) is the ABI's
; inter-procedural scratch register, so clobbering it at a call boundary is safe.
;
; __DWARF sections are not loaded (nothing executes debug info) and their
; relocations — which target section ordinals rather than symbol indices — are
; skipped. The metaprogram object builder passes emit-dwarf=false anyway.
;
; RELOCATIONS. Only the four the backend emits are handled; anything else is a
; hard error rather than a silent no-op, because a skipped fixup would produce code
; that jumps to a wild address.
;   BRANCH26   (pcrel) bl/b            imm26 = (S - P) >> 2, range-checked
;   PAGE21     (pcrel) adrp            imm21 = page(S) - page(P), split lo/hi
;   PAGEOFF12         add :lo12:       imm12 = S & 0xfff
;   UNSIGNED          8-byte pointer   *loc = S + <existing addend>
; GOT_LOAD_PAGE21/PAGEOFF12 are intentionally delegated to the real linker. The
; compact JIT image has no indirect-symbol table or GOT, and its caller already
; retries objects containing unavailable external-address relocations via ld.
; PAGEOFF12 is emitted at exactly one site (codegen_a64.coil emit-sym-addr!, always
; adrp+add with a zero immediate), so there is no load/store scaling case to handle.
(module jit)
(import "coil.primitive" :as primitive)

(import "coil.alloc" :as alloc :use *)
(import "coil.result" :use *)
(import "coil.slice" :use *)
(import "coil.str" :use *)
(import "coil.arraylist" :use *)
(import "coil.control" :use *)
(import "a64" :use *)  ; al-at, a64-movz/movk
(import "macho" :use *)  ; MObj/MSect/MSym/MReloc, reloc-*

(extern mmap :cc c [(ptr i8) i64 i32 i32 i32 i64] (-> (ptr i8)))
(extern munmap :cc c [(ptr i8) i64] (-> i32))
(extern mprotect :cc c [(ptr i8) i64 i32] (-> i32))
(extern dlsym :cc c [(ptr i8) (ptr i8)] (-> (ptr i8)))

(defn prot-rw [] (-> i64)
  3)  ; PROT_READ|PROT_WRITE
(defn prot-rx [] (-> i64)
  5)  ; PROT_READ|PROT_EXEC
(defn map-priv [] (-> i64)
  4098)  ; MAP_PRIVATE|MAP_ANON (0x0002|0x1000)
(defn page-size [] (-> i64)
  16384)  ; arm64 macOS; only ever rounds UP, so a
; 4K-page host stays correct.
(defn veneer-bytes [] (-> i64)
  20)  ; movz + movk*3 + br
(defn branch26-max [] (-> i64)
  134217728)  ; +/-128MB

; br x16 — same encoding family as blr/ret, with op=0 and rn=16.
(defn jit-br-x16 [] (-> i64)
  (primitive/ior (primitive/ishl 107 25) (primitive/ior (primitive/ishl 31 16) (primitive/ishl 16 5))))

; dlsym(RTLD_DEFAULT, …) — search every image already loaded in this process, which
; is how a comptime thunk reaches libc and how a metaprogram reaches the host hooks
; the compiler exports. RTLD_DEFAULT is (void*)-2 on macOS.
(defn jit-rtld-default [] (-> (ptr i8))
  (primitive/cast (ptr i8) -2))

; Darwin's explicit i-cache flush after writing JIT pages, resolved dynamically:
; the symbol does not exist on ELF hosts (this JIT emits arm64 and never runs
; there — x86 additionally has a coherent i-cache), and a plain extern would
; leave the Linux link with an undefined reference.
(defn jit-icache-invalidate [(base (ptr i8)) (n i64)] (-> i64)
  (let [f (dlsym (jit-rtld-default) c"sys_icache_invalidate")]
    (unless (= (primitive/cast i64 f) (primitive/cast i64 0))
      (primitive/call-ptr (primitive/cast (fnptr c [(ptr i8) i64] i64) f) base n))))

(defstruct JitSym
  [(name (slice u8))
   (addr (ptr i8))
   ; Base mapping which owns `addr`, or null for a process-wide dlsym. Imported
   ; symbols retain their original owner across generation chains.
   (owner (ptr i8))])
(defstruct JitImage
  [(base (ptr i8))  ; start of the mapping
   (size i64)  ; total mapped bytes
   (syms (ArrayList JitSym))])

; Mach-O symbols carry a leading underscore.  Keep the test explicit here: the
; reload namespace is compiler-owned, and only those definitions may retain an
; address from an older image.
(defn jit-reload-static? [(name (slice u8))] (-> bool)
  (or (starts-with name "repl_static.")
      (starts-with name "_repl_static.")))

(defn jit-syms-lookup [(syms (ptr (ArrayList JitSym))) (name (slice u8))] (-> (ptr i8))
  (let [n (al-len [JitSym] (load syms))
        (mut i) 0
        (mut r) (primitive/cast (ptr i8) 0)]
    (loop (if (>= (load i) n)
              (break)
              (do
                (let [sy (al-at [JitSym] syms (load i))]
                  (when (= (load (field sy name)) name)
                    (store! r (load (field sy addr)))
                    (break)))
                (set! i (primitive/iadd (load i) 1)))))
    (load r)))

(defn jit-symbol-body [(name (slice u8))] (-> (slice u8))
  (if (and (> (slice-len name) (primitive/cast i64 0))
           (= (primitive/cast i64 (slice-get name 0)) (primitive/cast i64 #\_)))
      (subslice name 1 (slice-len name))
      name))

(defn jit-symbol-leaf [(name (slice u8))] (-> (slice u8))
  (let [body (jit-symbol-body name)
        n (slice-len body)
        (mut start) 0
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (when (= (primitive/cast i64 (slice-get body (load i)))
                         (primitive/cast i64 #\.))
                  (store! start (primitive/iadd (load i) 1))
                  0)
                (store! i (primitive/iadd (load i) 1)))))
    (subslice body (load start) n)))

; An ordinary extern declaration carries a source-level leaf while JIT-defined
; Coil functions retain their qualified module symbol. Resolve a leaf against a
; prior image only when it identifies exactly one address. Process-wide dlsym is
; tried first, so a real C symbol can never be shadowed by this fallback.
(defn jit-syms-lookup-unique-leaf [(syms (ptr (ArrayList JitSym)))
                                   (name (slice u8))] (-> (ptr i8))
  (let [wanted (jit-symbol-leaf name)
        n (al-len [JitSym] (load syms))
        (mut i) 0
        (mut result) (primitive/cast (ptr i8) 0)
        (mut ambiguous) false]
    (loop (if (or (load ambiguous) (>= (load i) n))
              (break)
              (do
                (let [symbol (al-at [JitSym] syms (load i))]
                  (when (= (jit-symbol-leaf (load (field symbol name))) wanted)
                    (let [address (load (field symbol addr))]
                      (if (= (primitive/cast i64 (load result)) 0)
                          (store! result address)
                          (when (!= (primitive/cast i64 (load result))
                                    (primitive/cast i64 address))
                            (store! ambiguous true)
                            0)))
                    0))
                (store! i (primitive/iadd (load i) 1)))))
    (if (load ambiguous) (primitive/cast (ptr i8) 0) (load result))))

(defn jit-syms-owner-of-address [(syms (ptr (ArrayList JitSym)))
                                  (address (ptr i8))] (-> (ptr i8))
  (let [n (al-len [JitSym] (load syms))
        (mut i) 0
        (mut owner) (primitive/cast (ptr i8) 0)]
    (loop (if (>= (load i) n)
              (break)
              (let [symbol (al-at [JitSym] syms (load i))]
                (if (= (primitive/cast i64 (load (field symbol addr)))
                       (primitive/cast i64 address))
                    (do (store! owner (load (field symbol owner))) (break))
                    (store! i (primitive/iadd (load i) 1))))))
    (load owner)))

(defn jit-align-up [(v i64) (al i64)] (-> i64)
  (primitive/imul (primitive/idiv (primitive/iadd v (primitive/isub al 1)) al) al))

; str.coil's str-concat, minus the Option — this module deliberately depends only on
; the small libraries (sconcat lives in parser.coil, which has no business here).
(defn jit-cat [(a (dyn Allocator)) (x (slice u8)) (y (slice u8))] (-> (slice u8))
  (match (str-concat a x y) (Some [s] s) (None [] x)))

(defn jit-not [(m i64)] (-> i64)
  (primitive/ixor m -1))

; ---- little-endian byte access ------------------------------------------------
; Done a byte at a time, in i64 throughout, so there is no width or alignment
; question at the patch sites.
(defn jit-ld32 [(p (ptr u8))] (-> i64)
  (primitive/ior (primitive/ior (primitive/cast i64 (load (primitive/index p 0)))
                                (primitive/ishl (primitive/cast i64 (load (primitive/index p 1))) 8))
                 (primitive/ior (primitive/ishl (primitive/cast i64 (load (primitive/index p 2))) 16)
                                (primitive/ishl (primitive/cast i64 (load (primitive/index p 3))) 24))))

(defn jit-st32! [(p (ptr u8)) (v i64)] (-> i64)
  (do
    (set! (primitive/index p 0) (primitive/cast u8 (primitive/iand v 255)))
    (set! (primitive/index p 1) (primitive/cast u8 (primitive/iand (primitive/ishr v 8) 255)))
    (set! (primitive/index p 2) (primitive/cast u8 (primitive/iand (primitive/ishr v 16) 255)))
    (set! (primitive/index p 3) (primitive/cast u8 (primitive/iand (primitive/ishr v 24) 255)))
    0))

(defn jit-ld64 [(p (ptr u8))] (-> i64)
  (primitive/ior (jit-ld32 p) (primitive/ishl (jit-ld32 (primitive/index p 4)) 32)))

(defn jit-st64! [(p (ptr u8)) (v i64)] (-> i64)
  (do
    (jit-st32! p (primitive/iand v 4294967295))
    (jit-st32! (primitive/index p 4) (primitive/ishr v 32))
    0))

; ---- why a load failed --------------------------------------------------------
; ONE of the failures is recoverable, and the caller has to be able to tell which.
;
; The in-memory loader resolves an undefined symbol with `dlsym(RTLD_DEFAULT)`, so it
; can only reach code already inside the compiler process. A program that links a native
; library (`--link-flag -lfoo`, or a static archive via `-Wl,-force_load`) has symbols
; that are, by construction, NOT in this process — and there is nothing the loader can do
; about it, because a `.a` cannot be dlopen'd at all. That case is not an error, it is
; "this object needs a real link", and comptime_eval retries it through the dylib path,
; which already links with the program's own `--link-flag`s.
;
; Every OTHER jit-load failure is a compiler bug and must stay fatal. Hence the split
; field rather than a message prefix the two sides could drift apart on.
(defstruct JitErr [(msg (slice u8)) (undefined_external (slice u8))])
(defn jit-err [(msg (slice u8))] (-> JitErr)
  (let [p (primitive/alloc-stack JitErr)]
    (set! (.msg p) msg)
    (set! (.undefined_external p) "")
    (load p)))
(defn jit-undef-err [(a (dyn Allocator)) (name (slice u8))] (-> JitErr)
  (let [p (primitive/alloc-stack JitErr)]
    (set! (.msg p) (jit-cat a (jit-cat a "jit: undefined symbol '" name) "' is not present in the compiler process"))
    (set! (.undefined_external p) name)
    (load p)))
(defn jit-err-undefined-external? [(e (ptr JitErr))] (-> bool)
  (> (slice-len [u8] (.undefined_external e)) (primitive/cast i64 0)))

; a section is loaded unless it is debug info
(defn jit-loadable? [(s (ptr MSect))] (-> bool)
  (not (= (.segname s) "__DWARF")))

(defn jit-is-text? [(s (ptr MSect))] (-> bool)
  (= (.segname s) "__TEXT"))

; NUL-terminate a name for dlsym, dropping the leading '_' the Mach-O symbol
; carries (codegen_a64.coil:434 adds it; the C symbol libc knows has no underscore).
(defn jit-sym-cstr [(a (dyn Allocator)) (name (slice u8))] (-> (ptr i8))
  (let [raw
          (if (and (> (slice-len name) (primitive/cast i64 0))
                   (= (primitive/cast i64 (slice-get name 0)) (primitive/cast i64 #\_)))
              (subslice name 1 (slice-len name))
              name)
        n (slice-len raw)
        buf (slice-data (match (alloc [u8] a (primitive/iadd n 1)) (Some [s] s) (None [] (do (oom-at c"compiler jit" -1) (alloc/alloc-slice-new (primitive/cast (ptr u8) 0) 0)))))
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (set! (primitive/index buf (load i)) (load (primitive/index (slice-data raw) (load i))))
                (set! i (primitive/iadd (load i) 1)))))
    (set! (primitive/index buf n) (primitive/cast u8 0))
    (primitive/cast (ptr i8) buf)))

; write an absolute-jump veneer to `tgt` at `vp`
(defn jit-emit-veneer! [(vp (ptr u8)) (tgt i64)] (-> i64)
  (do
    (jit-st32! (primitive/index vp 0) (a64-movz 16 (primitive/iand tgt 65535) 0))
    (jit-st32! (primitive/index vp 4) (a64-movk 16 (primitive/iand (primitive/ishr tgt 16) 65535) 1))
    (jit-st32! (primitive/index vp 8) (a64-movk 16 (primitive/iand (primitive/ishr tgt 32) 65535) 2))
    (jit-st32! (primitive/index vp 12) (a64-movk 16 (primitive/iand (primitive/ishr tgt 48) 65535) 3))
    (jit-st32! (primitive/index vp 16) (jit-br-x16))
    0))

; ---- apply one relocation ------------------------------------------------------
; loc = the fixup address, tgt = the resolved target address (already redirected to
; a veneer where one was needed).
(defn jit-patch! [(loc (ptr u8)) (tgt (ptr i8)) (rtype i64)] (-> (Result i64 (slice u8)))
  (let [p (primitive/cast i64 loc)
        (mut s) (primitive/cast i64 tgt)]
    (cond (= rtype (reloc-branch26))
            (let [w (jit-ld32 loc)
                  delta (primitive/isub (load s) p)]
              (if (or (>= delta (branch26-max))
                      (< delta (primitive/isub 0 (branch26-max))))
                  (Err [i64 (slice u8)] "jit: branch target out of range even after veneering (compiler bug)")
                  (let [imm (primitive/iand (primitive/ishr delta 2) 67108863)]  ; 0x3ffffff
                    (jit-st32! loc (primitive/ior (primitive/iand w (jit-not 67108863)) imm))
                    (Ok [i64 (slice u8)] 0))))
          (or (= rtype (reloc-page21)) (= rtype (reloc-got-load-page21)))
            (let [w (jit-ld32 loc)
                  delta (primitive/isub (primitive/iand (load s) (jit-not 4095)) (primitive/iand p (jit-not 4095)))
                  imm (primitive/ishr delta 12)]
              ; adrp carries a signed 21-bit PAGE count: +/-4GB. Taking the ADDRESS of
              ; an undefined symbol (rather than calling it) could land outside that,
              ; and the veneer trick does not apply — a veneer redirects a branch, not
              ; an address computation. Fail loudly; reaching this means the fix is a
              ; GOT-style indirection, not a wider mask.
              (if (or (> imm (primitive/cast i64 1048575)) (< imm (primitive/cast i64 -1048576)))
                  (Err [i64 (slice u8)] "jit: adrp page offset out of +/-4GB range for an in-memory symbol")
                  (let [immlo (primitive/iand imm 3)
                        immhi (primitive/iand (primitive/ishr imm 2) 524287)  ; 0x7ffff
                        keep
                          (primitive/iand w (jit-not (primitive/ior (primitive/ishl 3 29) (primitive/ishl 524287 5))))]
                    (jit-st32! loc
                               (primitive/ior keep (primitive/ior (primitive/ishl immlo 29) (primitive/ishl immhi 5))))
                    (Ok [i64 (slice u8)] 0))))
          (= rtype (reloc-pageoff12))
            (let [w (jit-ld32 loc)
                  imm (primitive/iand (load s) 4095)]
              (jit-st32! loc
                         (primitive/ior (primitive/iand w (jit-not (primitive/ishl 4095 10))) (primitive/ishl imm 10)))
              (Ok [i64 (slice u8)] 0))
          (= rtype (reloc-got-load-pageoff12))
            (let [w (jit-ld32 loc)
                  byteoff (primitive/iand (load s) 4095)]
              (if (!= (primitive/iand byteoff 7) 0)
                  (Err [i64 (slice u8)] "jit: unaligned 64-bit GOT slot (compiler bug)")
                  (let [imm (primitive/ishr byteoff 3)]
                    (jit-st32! loc
                               (primitive/ior
                                 (primitive/iand w (jit-not (primitive/ishl 4095 10)))
                                 (primitive/ishl imm 10)))
                    (Ok [i64 (slice u8)] 0))))
          (= rtype (reloc-unsigned))
            (do
              (jit-st64! loc (primitive/iadd (load s) (jit-ld64 loc)))
              (Ok [i64 (slice u8)] 0))
          :else (Err [i64 (slice u8)] "jit: unhandled arm64 relocation type in the in-memory loader"))))

; ---- the loader ----------------------------------------------------------------
(defn jit-load-reusing [(a (dyn Allocator)) (o (mut MObj)) (prior (ptr JitImage))] (-> (Result JitImage JitErr))
  (block :jit
           (let [nsect (al-len [MSect] (load (field o sects)))
                 nsym (al-len [MSym] (load (field o syms)))
                 nrel (al-len [MReloc] (load (field o relocs)))
                 offs (slice-data (match (alloc [i64] a (if (> nsect (primitive/cast i64 0)) nsect 1)) (Some [s] s) (None [] (do (oom-at c"compiler jit" -1) (alloc/alloc-slice-new (primitive/cast (ptr i64) 0) 0)))))
                 vidx (slice-data (match (alloc [i64] a (if (> nsym (primitive/cast i64 0)) nsym 1)) (Some [s] s) (None [] (do (oom-at c"compiler jit" -1) (alloc/alloc-slice-new (primitive/cast (ptr i64) 0) 0)))))
                 gidx (slice-data (match (alloc [i64] a (if (> nsym (primitive/cast i64 0)) nsym 1)) (Some [s] s) (None [] (do (oom-at c"compiler jit" -1) (alloc/alloc-slice-new (primitive/cast (ptr i64) 0) 0)))))
                 addrs (slice-data (match (alloc [(ptr i8)] a (if (> nsym (primitive/cast i64 0)) nsym 1)) (Some [s] s) (None [] (do (oom-at c"compiler jit" -1) (alloc/alloc-slice-new (primitive/cast (ptr (ptr i8)) 0) 0)))))
                 (mut cur) 0
                 (mut nven) 0
                 (mut ngot) 0
                 (mut i) 0]

             ; nothing placed, nothing veneered yet
             (store! i 0)
             (loop (if (>= (load i) nsect)
                       (break)
                       (do (store! (primitive/index offs (load i)) -1) (store! i (primitive/iadd (load i) 1)))))
             (store! i 0)
             (loop (if (>= (load i) nsym)
                       (break)
                       (do
                         (store! (primitive/index vidx (load i)) -1)
                         (store! (primitive/index gidx (load i)) -1)
                         (store! i (primitive/iadd (load i) 1)))))

             ; One local 8-byte slot per symbol referenced through GOT relocations.
             ; PAGE21 and PAGEOFF12 for the same symbol share the slot.
             (store! i 0)
             (loop (if (>= (load i) nrel)
                       (break)
                       (do
                         (let [r (al-at [MReloc] (field o relocs) (load i))
                               sym (.sym r)]
                           (when (and (or (= (.rtype r) (reloc-got-load-page21))
                                          (= (.rtype r) (reloc-got-load-pageoff12)))
                                      (< (load (primitive/index gidx sym)) 0))
                             (store! (primitive/index gidx sym) (load ngot))
                             (store! ngot (primitive/iadd (load ngot) 1))))
                         (store! i (primitive/iadd (load i) 1)))))

             ; plan a veneer for every undefined symbol that something branches to
             (store! i 0)
             (loop (if (>= (load i) nrel)
                       (break)
                       (do
                         (let [r (al-at [MReloc] (field o relocs) (load i))
                               sym (load (field r sym))]
                           (when (and (= (load (field r rtype)) (reloc-branch26))
                                      (and (>= sym (primitive/cast i64 0)) (< sym nsym)))
                             (let [sy (al-at [MSym] (field o syms) sym)]
                               (when (and (= (load (field sy sect)) (primitive/cast i64 0))
                                          (< (load (primitive/index vidx sym)) (primitive/cast i64 0)))
                                 (store! (primitive/index vidx sym) (load nven))
                                 (store! nven (primitive/iadd (load nven) 1))))))
                         (store! i (primitive/iadd (load i) 1)))))

             ; pass 1 — __TEXT sections, in order
             (store! i 0)
             (loop (if (>= (load i) nsect)
                       (break)
                       (do
                         (let [s (al-at [MSect] (field o sects) (load i))]
                           (when (and (jit-loadable? s) (jit-is-text? s))
                             (store! cur
                                     (jit-align-up (load cur)
                                                   (primitive/ishl 1
                                                                   (load (field s
                                                                                align)))))
                             (store! (primitive/index offs (load i)) (load cur))
                             (store! cur
                                     (primitive/iadd (load cur)
                                                     (al-len [u8]
                                                             (load (field s
                                                                          buf)))))))
                         (store! i (primitive/iadd (load i) 1)))))

             ; the veneer area sits at the end of text, so it is covered by the same R+X flip
             (store! cur (jit-align-up (load cur) 4))
             (let [venbase (load cur)]
               (store! cur (primitive/iadd (load cur) (primitive/imul (load nven) (veneer-bytes))))

               ; the text/data boundary is a page boundary: mprotect works in whole pages,
               ; and making a data page executable (or a text page writable) defeats W^X.
               (let [textsz (jit-align-up (load cur) (page-size))]
                 (store! cur textsz)

                 ; pass 2 — everything else that is loadable
                 (store! i 0)
                 (loop (if (>= (load i) nsect)
                           (break)
                           (do
                             (let [s (al-at [MSect] (field o sects) (load i))]
                               (when (and (jit-loadable? s) (not (jit-is-text? s)))
                                 (store! cur
                                         (jit-align-up (load cur)
                                                       (primitive/ishl 1
                                                                       (load (field s
                                                                                    align)))))
                                 (store! (primitive/index offs (load i)) (load cur))
                                 (store! cur
                                         (primitive/iadd (load cur)
                                                         (al-len [u8]
                                                                 (load (field s
                                                                              buf)))))))
                             (store! i (primitive/iadd (load i) 1)))))

                 (store! cur (jit-align-up (load cur) 8))
                 (let [gotbase (load cur)]
                   (store! cur (primitive/iadd (load cur) (primitive/imul (load ngot) 8)))
                 (let [total (jit-align-up (if (> (load cur) (primitive/cast i64 0)) (load cur) 1) (page-size))
                       base
                         (mmap (primitive/cast (ptr i8) 0)
                               total
                               (primitive/cast i32 (prot-rw))
                               (primitive/cast i32 (map-priv))
                               (primitive/cast i32 -1)
                               0)]
                   (when (or (= (primitive/cast i64 base) (primitive/cast i64 0))
                             (= (primitive/cast i64 base) (primitive/cast i64 -1)))
                     (break :jit (Err [JitImage JitErr] (jit-err "jit: mmap of the comptime image failed"))))

                   ; copy each placed section in
                   (store! i 0)
                   (loop (if (>= (load i) nsect)
                             (break)
                             (do
                               (let [off (load (primitive/index offs (load i)))]
                                 (when (>= off (primitive/cast i64 0))
                                   (let [s (al-at [MSect] (field o sects) (load i))
                                         src (slice-data (al-slice [u8] (load (field s buf))))
                                         n (al-len [u8] (load (field s buf)))
                                         dst (primitive/cast (ptr u8) (primitive/index base off))
                                         (mut k) 0]
                                     (loop (if (>= (load k) n)
                                               (break)
                                               (do
                                                 (store! (primitive/index dst (load k))
                                                         (load (primitive/index src (load k))))
                                                 (store! k (primitive/iadd (load k) 1))))))))
                               (store! i (primitive/iadd (load i) 1)))))

                   ; resolve every symbol to a final address
                   (let [(mut syms) (al-new [JitSym] a)]
                     (store! i 0)
                     (loop (if (>= (load i) nsym)
                               (break)
                               (do
                                 (let [sy (al-at [MSym] (field o syms) (load i))
                                       sect (load (field sy sect))]
                                   (if (= sect (primitive/cast i64 0))
                                       ; undefined: it must already be somewhere in this process
                                       (let [process-fp
                                               (dlsym (jit-rtld-default)
                                                      (jit-sym-cstr a (load (field sy name))))
                                             fp
                                               (if (or (!= (primitive/cast i64 process-fp) 0)
                                                       (= (primitive/cast i64 prior) 0))
                                                   process-fp
                                                   (jit-syms-lookup-unique-leaf
                                                     (field prior syms)
                                                     (load (field sy name))))]
                                         (when (= (primitive/cast i64 fp) (primitive/cast i64 0))
                                           (munmap base total)
                                           (break :jit (Err [JitImage JitErr] (jit-undef-err a (load (field sy name))))))
                                         (store! (primitive/index addrs (load i)) fp)
                                         ; Carry the resolved import into the new
                                         ; image's namespace so the next small
                                         ; generation can link through this one.
                                         (let [js (primitive/alloc-stack JitSym)]
                                           (store! (field js name) (load (field sy name)))
                                           (store! (field js addr) fp)
                                           (store! (field js owner)
                                             (if (or (= (primitive/cast i64 prior) 0)
                                                     (!= (primitive/cast i64 process-fp) 0))
                                                 (primitive/cast (ptr i8) 0)
                                                 (jit-syms-owner-of-address
                                                   (field prior syms) fp)))
                                           (al-push! [JitSym] (mut syms) (load js))))
                                       (let [old
                                               (if (and (!= (primitive/cast i64 prior) 0)
                                                        (jit-reload-static? (load (field sy name))))
                                                   (jit-syms-lookup (field prior syms) (load (field sy name)))
                                                   (primitive/cast (ptr i8) 0))
                                             off (load (primitive/index offs (primitive/isub sect 1)))]
                                         (when (< off (primitive/cast i64 0))
                                           (munmap base total)
                                           (break :jit
                                                    (Err [JitImage JitErr]
                                                         (jit-err (jit-cat a
                                                                           (jit-cat a
                                                                                    "jit: symbol '"
                                                                                    (load (field sy name)))
                                                                           "' lives in a section that was not loaded")))))
                                         (let [ad
                                                 (if (!= (primitive/cast i64 old) 0)
                                                     old
                                                     (primitive/index base
                                                                      (primitive/iadd off (load (field sy off)))))]
                                           (store! (primitive/index addrs (load i)) ad)
                                           (let [js (primitive/alloc-stack JitSym)]
                                             (store! (field js name) (load (field sy name)))
                                             (store! (field js addr) ad)
                                             (store! (field js owner)
                                               (if (!= (primitive/cast i64 old) 0)
                                                   (jit-syms-owner-of-address
                                                     (field prior syms) old)
                                                   base))
                                             (al-push! [JitSym] (mut syms) (load js)))))))
                                 (store! i (primitive/iadd (load i) 1)))))

                     ; GOT entries contain final addresses but live inside this
                     ; image, so every ADRP targets a nearby page.
                     (store! i 0)
                     (loop (if (>= (load i) nsym)
                               (break)
                               (do
                                 (let [gi (load (primitive/index gidx (load i)))]
                                   (when (>= gi 0)
                                     (jit-st64! (primitive/cast (ptr u8)
                                                  (primitive/index base
                                                    (primitive/iadd gotbase (primitive/imul gi 8))))
                                                (primitive/cast i64 (load (primitive/index addrs (load i)))))))
                                 (store! i (primitive/iadd (load i) 1)))))

                     ; emit the veneers now that the far addresses are known
                     (store! i 0)
                     (loop (if (>= (load i) nsym)
                               (break)
                               (do
                                 (let [v (load (primitive/index vidx (load i)))]
                                   (when (>= v (primitive/cast i64 0))
                                     (jit-emit-veneer! (primitive/cast (ptr u8)
                                                                       (primitive/index base
                                                                                        (primitive/iadd venbase
                                                                                                        (primitive/imul v
                                                                                                                        (veneer-bytes)))))
                                                       (primitive/cast i64 (load (primitive/index addrs (load i)))))))
                                 (store! i (primitive/iadd (load i) 1)))))

                     ; apply relocations
                     (store! i 0)
                     (loop (if (>= (load i) nrel)
                               (break)
                               (do
                                 (let [r (al-at [MReloc] (field o relocs) (load i))
                                       rsect (load (field r sect))
                                       sym (load (field r sym))]
                                   ; DWARF fixups encode a negative section ordinal in `sym`; those
                                   ; sections are never loaded, so there is nothing to patch.
                                   (unless (or (< sym (primitive/cast i64 0)) (>= sym nsym))
                                     (let [soff (load (primitive/index offs (primitive/isub rsect 1)))]
                                       (unless (< soff (primitive/cast i64 0))
                                         (let [loc
                                                 (primitive/cast (ptr u8)
                                                                 (primitive/index base
                                                                                  (primitive/iadd soff
                                                                                                  (load (field r
                                                                                                               off)))))
                                               v (load (primitive/index vidx sym))
                                               rt (load (field r rtype))
                                               gi (load (primitive/index gidx sym))
                                               tgt
                                                 (if (or (= rt (reloc-got-load-page21))
                                                         (= rt (reloc-got-load-pageoff12)))
                                                     (primitive/index base
                                                       (primitive/iadd gotbase (primitive/imul gi 8)))
                                                     (if (and (>= v (primitive/cast i64 0))
                                                              (= rt (reloc-branch26)))
                                                         (primitive/index base
                                                                          (primitive/iadd venbase
                                                                                          (primitive/imul v (veneer-bytes))))
                                                         (load (primitive/index addrs sym))))]
                                           (match (jit-patch! loc tgt (load (field r rtype)))
                                             (Err [m]
                                                  (do
                                                    (munmap base total)
                                                    (return-from :jit (Err [JitImage JitErr] (jit-err m)))))
                                             (Ok [_] 0)))))))
                                 (store! i (primitive/iadd (load i) 1)))))

                     ; text becomes read-execute; data stays writable
                     (when (> textsz (primitive/cast i64 0))
                       (when (!= (primitive/cast i64 (mprotect base textsz (primitive/cast i32 (prot-rx))))
                                 (primitive/cast i64 0))
                         (munmap base total)
                         (break :jit
                                  (Err [JitImage JitErr]
                                       (jit-err "jit: mprotect of the comptime text pages failed"))))
                       (jit-icache-invalidate base textsz))

                     (let [img (primitive/alloc-stack JitImage)]
                       (store! (field img base) base)
                       (store! (field img size) total)
                       (store! (field img syms) (load syms))
                       (Ok [JitImage JitErr] (load img)))))))))))

(defn jit-load [(a (dyn Allocator)) (o (mut MObj))] (-> (Result JitImage JitErr))
  (jit-load-reusing a (mut o) (primitive/cast (ptr JitImage) 0)))

; look a symbol up in a loaded image; null when absent. Accepts the C name either
; with or without the Mach-O leading underscore.
(defn jit-lookup [(img (ptr JitImage)) (name (slice u8))] (-> (ptr i8))
  (let [n (al-len [JitSym] (.syms img))
        (mut i) 0
        (mut r) (primitive/cast (ptr i8) 0)]
    (loop (if (>= (load i) n)
              (break)
              (do
                (let [sy (al-at [JitSym] (field img syms) (load i))
                      nm (.name sy)]
                  (when (or (= nm name)
                            (and (and (> (slice-len nm) (primitive/cast i64 0))
                                      (= (primitive/cast i64 (slice-get nm 0)) (primitive/cast i64 #\_)))
                                 (= (subslice nm 1 (slice-len nm)) name)))
                    (store! r (load (field sy addr)))
                    (break)))
                (set! i (primitive/iadd (load i) 1)))))
    (load r)))

; release an image. Only safe once nothing can call into it again.
(defn jit-free! [(img (ptr JitImage))] (-> i64)
  (do
    (when (!= (primitive/cast i64 (load (field img base))) (primitive/cast i64 0))
      (primitive/cast i64 (munmap (load (field img base)) (load (field img size)))))
    (set! (.base img) (primitive/cast (ptr i8) 0))
    0))
