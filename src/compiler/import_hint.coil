(module coil.compiler.import_hint)

;;; The names a module that is not loaded makes public, read from its source text
;;; LEXICALLY, for the hint an unknown name gets ("'sm-new' is defined in module
;;; 'coil.prop.stateful'; import it with …"). It runs only on that error path and
;;; never invokes the reader: reading a file after the entry is parsed would
;;; disturb the reader's node identities, which later staged-macro bookkeeping
;;; depends on (see namespace-declared-module in loader.coil).
;;;
;;; A module with an `(export …)` list makes public the names its lists give. One
;;; without makes public the name of each top-level definition form, a sum's
;;; variants and a trait's methods. What its macros or metaprograms would generate
;;; is not visible here; a loaded module's declaration table answers for those.
(import "coil.alloc" :use *)
(import "coil.arraylist" :use *)
(import "coil.slice" :use *)
(import "coil.compiler.parser" :use [sconcat])

(defn ih-byte [(text (slice u8)) (i i64)] (-> i64)
  (cast i64 (get text i)))

(defn ih-space? [(c i64)] (-> bool)
  (or (= c 32) (= c 9) (= c 10) (= c 13) (= c 44)))

(defn ih-open? [(c i64)] (-> bool)
  (or (= c 40) (= c 91) (= c 123)))

(defn ih-close? [(c i64)] (-> bool)
  (or (= c 41) (= c 93) (= c 125)))

;; Ends a token: whitespace, a bracket, a string's quote or a comment.
(defn ih-delimiter? [(c i64)] (-> bool)
  (or (ih-space? c) (ih-open? c) (ih-close? c) (= c 34) (= c 59)))

;; The first byte at or after I that is not whitespace or inside a `;` comment.
(defn ih-skip-space [(text (slice u8)) (i i64)] (-> i64)
  (let [n (len text)
        (mut j) i]
    (loop
      (cond (>= j n) (break)
            (ih-space? (ih-byte text j)) (set! j (+ j 1))
            (= (ih-byte text j) 59)
              (loop (if (or (>= j n) (= (ih-byte text j) 10)) (break) (set! j (+ j 1))))
            :else (break)))
    j))

;; The end of the string whose opening quote is at I, past its closing quote.
(defn ih-string-end [(text (slice u8)) (i i64)] (-> i64)
  (let [n (len text)
        (mut j) (+ i 1)]
    (loop
      (cond (>= j n) (break)
            (= (ih-byte text j) 92) (set! j (+ j 2))
            (= (ih-byte text j) 34) (do (set! j (+ j 1)) (break))
            :else (set! j (+ j 1))))
    (if (> j n) n j)))

;; The end of the token at I. A character literal (`\(`, `#\(`) takes the byte
;; after its backslash whatever it is.
(defn ih-token-end [(text (slice u8)) (i i64)] (-> i64)
  (let [n (len text)
        (mut j) (cond (= (ih-byte text i) 92) (+ i 2)
                      (and (= (ih-byte text i) 35) (< (+ i 1) n) (= (ih-byte text (+ i 1)) 92)) (+ i 3)
                      :else i)]
    (loop (if (or (>= j n) (ih-delimiter? (ih-byte text j))) (break) (set! j (+ j 1))))
    (if (> j n) n j)))

;; The end of the datum at I (which is not whitespace): a whole bracketed form,
;; a string, or a token. Always past I.
(defn ih-datum-end [(text (slice u8)) (i i64)] (-> i64)
  (let [n (len text)
        c (ih-byte text i)]
    (cond (ih-open? c)
            (let [(mut depth) 1
                  (mut j) (+ i 1)]
              (loop
                (set! j (ih-skip-space text j))
                (cond (or (>= j n) (= depth 0)) (break)
                      (ih-open? (ih-byte text j)) (do (set! depth (+ depth 1)) (set! j (+ j 1)))
                      (ih-close? (ih-byte text j)) (do (set! depth (- depth 1)) (set! j (+ j 1)))
                      (= (ih-byte text j) 34) (set! j (ih-string-end text j))
                      :else (set! j (ih-past text j (ih-token-end text j)))))
              j)
          (= c 34) (ih-string-end text i)
          :else (ih-past text i (ih-token-end text i)))))

;; END, or one past I when the token there is empty (a stray byte), so a scan
;; always moves.
(defn ih-past [(text (slice u8)) (i i64) (end i64)] (-> i64)
  (if (> end i) end (+ i 1)))

;; The token at I, or "" when I starts a bracket or a string.
(defn ih-token-at [(text (slice u8)) (i i64)] (-> (slice u8))
  (if (or (>= i (len text)) (ih-delimiter? (ih-byte text i)))
      ""
      (subslice [u8] text i (ih-token-end text i))))

;; A token that names something: not a keyword, a number or a character.
(defn ih-name? [(t (slice u8))] (-> bool)
  (and (> (len t) 0)
       (let [c (cast i64 (get t 0))]
         (not (or (= c 58) (= c 92) (= c 35) (and (>= c 48) (<= c 57)))))))

(defn ih-definition-head? [(head (slice u8))] (-> bool)
  (or (= head "defn") (= head "defn*") (= head "defstruct") (= head "defsum")
      (= head "deftrait") (= head "const") (= head "def") (= head "extern")
      (= head "defalias") (= head "defcc") (= head "declare")))

(defn ih-add! [(a (dyn Allocator)) (out (mut (ArrayList (slice u8)))) (name (slice u8))] (-> i64)
  (when (ih-name? name) (push! (mut out) (sconcat a name "")) 0)
  0)

;; The heads of the bracketed elements of the form whose head ends at I, up to
;; its close: a sum's variants, a trait's methods. Every other element is skipped.
(defn ih-element-heads! [(a (dyn Allocator))
                         (text (slice u8))
                         (i i64)
                         (out (mut (ArrayList (slice u8))))] (-> i64)
  (let [n (len text)
        (mut j) i]
    (loop
      (set! j (ih-skip-space text j))
      (cond (or (>= j n) (ih-close? (ih-byte text j))) (break)
            (= (ih-byte text j) 40)
              (do
                (ih-add! a (mut out) (ih-token-at text (ih-skip-space text (+ j 1))))
                (set! j (ih-datum-end text j)))
            :else (set! j (ih-datum-end text j))))
    0))

;; The names of the export list whose head ends at I, up to its close.
(defn ih-export-names! [(a (dyn Allocator))
                        (text (slice u8))
                        (i i64)
                        (out (mut (ArrayList (slice u8))))] (-> i64)
  (let [n (len text)
        (mut j) i]
    (loop
      (set! j (ih-skip-space text j))
      (cond (or (>= j n) (ih-close? (ih-byte text j))) (break)
            (or (ih-open? (ih-byte text j)) (= (ih-byte text j) 34)) (set! j (ih-datum-end text j))
            :else
              (do
                (ih-add! a (mut out) (ih-token-at text j))
                (set! j (ih-datum-end text j)))))
    0))

;;; The names the module whose source is TEXT makes public, copied into A.
(defn lexical-public-names [(a (dyn Allocator)) (text (slice u8))] (-> (ptr (ArrayList (slice u8))))
  (let [n (len text)
        (mut exported) (ArrayList::new [(slice u8)] a)
        (mut defined) (ArrayList::new [(slice u8)] a)
        (mut listed) false
        (mut i) 0]
    (loop
      (set! i (ih-skip-space text i))
      (when (>= i n) (break))
      (when (= (ih-byte text i) 40)
        (let [at (ih-skip-space text (+ i 1))
              head (ih-token-at text at)
              after (+ at (len head))]
          (cond (= head "export")
                  (do (set! listed true) (ih-export-names! a text after (mut exported)))
                (ih-definition-head? head)
                  (let [name-at (ih-skip-space text after)
                        name (ih-token-at text name-at)]
                    (ih-add! a (mut defined) name)
                    (when (or (= head "defsum") (= head "deftrait"))
                      (ih-element-heads! a text (+ name-at (len name)) (mut defined))
                      0)
                    0)
                :else 0)))
      (set! i (ih-datum-end text i)))
    (box! a (ArrayList (slice u8)) (if listed (load exported) (load defined)))))
