; src/compiler/elf.coil — ELF64 relocatable object (ET_REL) writer for the

; x86-64 backend. Zero dependencies: composes the object file byte-by-byte.
;
; This is the ELF sibling of macho.coil and keeps the SAME caller-facing model,
; so codegen_x64.coil reads like codegen_a64.coil:
;   - the caller builds sections (byte buffers), a symbol list and a relocation
;     list, then `elf-write` lays out and serializes the object;
;   - symbols reference sections by ORDINAL (1-based, in push order; 0 = undefined);
;   - relocations reference symbols by index into the caller's symbol list; the
;     writer sorts symbols (locals first, as ELF requires) and remaps the
;     relocation symbol numbers.
;
; Where ELF genuinely differs from Mach-O, and the code has to care:
;   - Symbol order is not a convention but a hard rule: every LOCAL symbol must
;     precede every GLOBAL one, and sh_info of .symtab records the boundary.
;     A linker rejects the object otherwise.
;   - Relocations are RELA (explicit addend), in per-section `.rela.NAME`
;     sections, each of which needs its own section header — so section headers
;     are generated, not fixed.
;   - Index 0 of both the section table and the symbol table is a reserved null
;     entry, so all real indices are shifted by one.
;   - Debug sections carry REAL relocations here (unlike the arm64/Mach-O path,
;     which uses section-relative addresses and lets ld64's debug map translate).
(module coil.compiler.elf)
(import "coil.primitive" :as primitive)
(import "coil.alloc" :as alloc :use *)
(import "coil.result" :use *)
(import "coil.slice" :use *)
(import "coil.str" :use *)
(import "coil.arraylist" :use *)
(import "coil.io" :use *)
(import "coil.control" :use *)
(import "coil.compiler.x64" :use *)

; ---- x86-64 relocation types (the r_type field of r_info) ----
(defn r-x86-64-64 [] (-> i64)
  1)  ; S + A, 64-bit absolute

(defn r-x86-64-pc32 [] (-> i64)
  2)  ; S + A - P, 32-bit pc-relative

(defn r-x86-64-plt32 [] (-> i64)
  4)  ; L + A - P; for call/jmp, the linker relaxes it to pc32 when it can

(defn r-x86-64-32 [] (-> i64)
  10)  ; S + A, 32-bit zero-extended

(defn r-x86-64-32s [] (-> i64)
  11)  ; S + A, 32-bit sign-extended

; ---- section header types / flags ----
(defn sht-progbits [] (-> i64)
  1)

(defn sht-symtab [] (-> i64)
  2)

(defn sht-strtab [] (-> i64)
  3)

(defn sht-rela [] (-> i64)
  4)

(defn sht-nobits [] (-> i64)
  8)

(defn shf-write [] (-> i64)
  1)

(defn shf-alloc [] (-> i64)
  2)

(defn shf-execinstr [] (-> i64)
  4)

(defstruct ESect
  [(name (slice u8))  ; ".text", ".rodata", ".debug_info", ...
   (buf (ArrayList u8))
   (align i64)  ; byte alignment (not a log2 exponent — ELF stores it directly)
   (stype i64)  ; SHT_*
   (flags i64)  ; SHF_*
   (shndx i64)  ; filled in during layout: this section's index in the header table
   (relndx i64)])  ; index of its .rela section, or 0 if it has no relocations

(defstruct ESym
  [(name (slice u8))
   (sect i64)  ; 1-based section ordinal; 0 = undefined
   (off i64)  ; value: offset within that section
   (ext bool)  ; global (visible to the linker) vs local
   (isfunc bool)  ; STT_FUNC vs STT_OBJECT — lets the linker/gdb see functions
   (size i64)])  ; st_size; 0 when unknown/irrelevant

(defstruct EReloc
  [(sect i64)  ; section ordinal the fixup lives in (1-based)
   (off i64)  ; byte offset of the fixup within that section
   (sym i64)  ; caller symbol index
   (rtype i64)  ; R_X86_64_*
   (addend i64)])  ; the explicit RELA addend

(defstruct EObj
  [(sects (ArrayList ESect))
   (syms (ArrayList ESym))
   (relocs (ArrayList EReloc))
   (a (dyn Allocator))])

(defn eobj-new [(a (dyn Allocator))] (-> EObj)
  (let [p (primitive/alloc-stack EObj)]
    (set! (.sects p) (al-new [ESect] a))
    (set! (.syms p) (al-new [ESym] a))
    (set! (.relocs p) (al-new [EReloc] a))
    (set! (.a p) a)
    (load p)))

; Mark the object as NOT needing an executable stack. On Linux an object with
; no `.note.GNU-stack` section makes the linker fall back to an executable
; stack for the whole program (and warn about it) — a real security
; regression, not just noise. The section is empty and unallocated; its mere
; presence, with no SHF_EXECINSTR, is the declaration. Every object the backend
; emits should call this.
(defn eobj-mark-nonexec-stack! [(o (mut EObj))] (-> i64)
  (eobj-add-sect! (mut o) ".note.GNU-stack" 1 (sht-progbits) 0)
  0)

; add a section; returns its 1-based ordinal.
(defn eobj-add-sect! [(o (mut EObj)) (name (slice u8)) (align i64) (stype i64) (flags i64)] (-> i64)
  (let [s (primitive/alloc-stack ESect)]
    (set! (.name s) name)
    (set! (.buf s) (al-new [u8] (.a o)))
    (set! (.align s) align)
    (set! (.stype s) stype)
    (set! (.flags s) flags)
    (set! (.shndx s) 0)
    (set! (.relndx s) 0)
    (push! (mut (.sects o)) (load s))
    (len (.sects o))))

; add a symbol; returns its caller index (what relocations refer to).
(defn eobj-add-sym! [(o (mut EObj)) (name (slice u8)) (sect i64) (off i64) (ext bool)] (-> i64)
  (let [s (primitive/alloc-stack ESym)]
    (set! (.name s) name)
    (set! (.sect s) sect)
    (set! (.off s) off)
    (set! (.ext s) ext)
    (set! (.isfunc s) false)
    (set! (.size s) 0)
    (push! (mut (.syms o)) (load s))
    (primitive/isub (len (.syms o)) 1)))

; same, but marks the symbol STT_FUNC with a size (so the linker and gdb both
; see a real function rather than an anonymous address).
(defn eobj-add-func-sym! [(o (mut EObj)) (name (slice u8)) (sect i64) (off i64) (ext bool) (size i64)] (-> i64)
  (let [idx (eobj-add-sym! (mut o) name sect off ext)
        sp (xal-at [ESym] (field o syms) idx)]
    (set! (.isfunc sp) true)
    (set! (.size sp) size)
    idx))

(defn eobj-add-reloc! [(o (mut EObj)) (sect i64) (off i64) (sym i64) (rtype i64) (addend i64)] (-> i64)
  (let [r (primitive/alloc-stack EReloc)]
    (set! (.sect r) sect)
    (set! (.off r) off)
    (set! (.sym r) sym)
    (set! (.rtype r) rtype)
    (set! (.addend r) addend)
    (push! (mut (.relocs o)) (load r))
    0))

(defn eobj-sect-buf [(o (mut EObj)) (ord i64)] (-> (ptr (ArrayList u8)))
  (field (xal-at [ESect] (field o sects) (primitive/isub ord 1)) buf))

(defn eobj-sect-len [(o (mut EObj)) (ord i64)] (-> i64)
  (len (.buf (xal-at [ESect] (field o sects) (primitive/isub ord 1)))))

; patch an existing symbol (used when a function's address/size is only known
; after its body has been emitted).
(defn eobj-set-sym! [(o (ptr EObj)) (idx i64) (sect i64) (off i64)] (-> i64)
  (let [sp (xal-at [ESym] (field o syms) idx)]
    (set! (.sect sp) sect)
    (set! (.off sp) off)
    0))

(defn eobj-set-sym-size! [(o (ptr EObj)) (idx i64) (size i64)] (-> i64)
  (set! (.size (xal-at [ESym] (field o syms) idx)) size)
  0)

(defn ealign-up [(v i64) (align i64)] (-> i64)
  (if (<= align (primitive/cast i64 1))
      v
      (let [rem (primitive/urem v align)]
        (if (= rem (primitive/cast i64 0)) v (primitive/iadd v (primitive/isub align rem))))))

; ---- string table helper: append a NUL-terminated string, return its offset ----
(defn estr-add! [(b (mut (ArrayList u8))) (s (slice u8))] (-> i64)
  (let [off (len (load b))]
    (xb-bytes! (mut b) s)
    (push! (mut b) (primitive/cast u8 0))
    off))

; ============================ serialization ==================================
; Layout: ELF header | section contents (each aligned) | section header table.
; Sections in the header table, in order:
;   0            null
;   1..n         the caller's sections, in push order
;   then         one .rela.NAME per section that has relocations
;   then         .symtab, .strtab, .shstrtab
(defn elf-write [(o (mut EObj))] (-> (ptr (ArrayList u8)))
  (let [a (.a o)
        nsect (len (.sects o))
        nsym (len (.syms o))
        nrel (len (.relocs o))
        ; ---- symbol permutation: ELF requires every local before every global.
        ; order[i] = caller index of the i-th symtab entry (after the null entry);
        ; perm[caller] = symtab index (already including the +1 for the null entry).
        (mut order) (al-new [i64] a)
        (mut perm) (al-new [i64] a)
        (mut nlocal) 0]
    (let [(mut i) 0]
      (loop (if (>= (load i) nsym)
                (break)
                (do (push! (mut perm) 0) (set! i (primitive/iadd (load i) 1))))))
    ; pass 1: locals (anything not marked ext, including section-relative temps)
    (let [(mut i) 0]
      (loop (if (>= (load i) nsym)
                (break)
                (do
                  (let [sp (xal-at [ESym] (field o syms) (load i))]
                    (unless (load (field sp ext))
                      (set! (mut perm) (load i) (primitive/iadd (len (load order)) 1))
                      (push! (mut order) (load i))
                      (store! nlocal (primitive/iadd (load nlocal) 1))
                      0))
                  (set! i (primitive/iadd (load i) 1))))))
    ; pass 2: globals (defined and undefined alike — ELF does not separate them,
    ; an undefined symbol is simply one with st_shndx = SHN_UNDEF)
    (let [(mut i) 0]
      (loop (if (>= (load i) nsym)
                (break)
                (do
                  (let [sp (xal-at [ESym] (field o syms) (load i))]
                    (when (load (field sp ext))
                      (set! (mut perm) (load i) (primitive/iadd (len (load order)) 1))
                      (push! (mut order) (load i))
                      0))
                  (set! i (primitive/iadd (load i) 1))))))

    ; ---- group relocations by section, so each gets one .rela.NAME ----
    ; relcount[s] = how many relocations land in section ordinal s+1
    (let [(mut relcount) (al-new [i64] a)]
      (let [(mut i) 0]
        (loop (if (>= (load i) nsect)
                  (break)
                  (do (push! (mut relcount) 0) (set! i (primitive/iadd (load i) 1))))))
      (let [(mut i) 0]
        (loop (if (>= (load i) nrel)
                  (break)
                  (do
                    (let [rp (xal-at [EReloc] (field o relocs) (load i))
                          si (primitive/isub (.sect rp) 1)]
                      (set! (mut relcount) si (primitive/iadd (get (load relcount) si) 1)))
                    (set! i (primitive/iadd (load i) 1))))))

      ; ---- assign section-header indices ----
      ; 0 is the null entry; the caller's sections follow in push order.
      (let [(mut nsh) 1]
        (let [(mut i) 0]
          (loop (if (>= (load i) nsect)
                    (break)
                    (do
                      (set! (.shndx (xal-at [ESect] (field o sects) (load i))) (load nsh))
                      (set! nsh (primitive/iadd (load nsh) 1))
                      (set! i (primitive/iadd (load i) 1))))))
        ; then a .rela.NAME for each section that actually has relocations
        (let [(mut i) 0]
          (loop (if (>= (load i) nsect)
                    (break)
                    (do
                      (when (> (get (load relcount) (load i)) (primitive/cast i64 0))
                        (store! (field (xal-at [ESect] (field o sects) (load i)) relndx) (load nsh))
                        (store! nsh (primitive/iadd (load nsh) 1))
                        0)
                      (set! i (primitive/iadd (load i) 1))))))
        (let [symtab-ndx (load nsh)
              strtab-ndx (primitive/iadd (load nsh) 1)
              shstrtab-ndx (primitive/iadd (load nsh) 2)
              total-sh (primitive/iadd (load nsh) 3)
              ; ---- build .shstrtab (section name strings) ----
              (mut shstr) (al-new [u8] a)
              (mut shname-off) (al-new [i64] a)
              (mut relname-off) (al-new [i64] a)]
          (push! (mut shstr) (primitive/cast u8 0))  ; index 0 is the empty name
          (let [(mut i) 0]
            (loop (if (>= (load i) nsect)
                      (break)
                      (do
                        (let [sp (xal-at [ESect] (field o sects) (load i))]
                          (push! (mut shname-off) (estr-add! (mut shstr) (.name sp)))
                          ; ".rela" + the section's own name
                          (if (> (get (load relcount) (load i)) (primitive/cast i64 0))
                              (let [off (len (load shstr))]
                                (xb-bytes! (mut shstr) ".rela")
                                (xb-bytes! (mut shstr) (.name sp))
                                (push! (mut shstr) (primitive/cast u8 0))
                                (push! (mut relname-off) off))
                              (push! (mut relname-off) 0)))
                        (set! i (primitive/iadd (load i) 1))))))
          (let [symtab-name (estr-add! (mut shstr) ".symtab")
                strtab-name (estr-add! (mut shstr) ".strtab")
                shstrtab-name (estr-add! (mut shstr) ".shstrtab")
                ; ---- build .strtab + the symbol table body ----
                (mut strtab) (al-new [u8] a)
                (mut symtab) (al-new [u8] a)]
            (push! (mut strtab) (primitive/cast u8 0))
            ; the reserved null symbol
            (xb-zeros! (mut symtab) 24)
            (let [(mut i) 0]
              (loop (if (>= (load i) (len (load order)))
                        (break)
                        (do
                          (let [sp (xal-at [ESym] (field o syms) (get (load order) (load i)))
                                nameoff (estr-add! (mut strtab) (.name sp))
                                ; st_info = (bind << 4) | type; bind 1 = GLOBAL, type 2 = FUNC
                                bind (if (.ext sp) 1 0)
                                sty (if (.isfunc sp) 2 0)
                                shndx
                                  (if (= (.sect sp) (primitive/cast i64 0))
                                      0
                                      (.shndx (xal-at [ESect]
                                                      (field o sects)
                                                      (primitive/isub (.sect sp) 1))))]
                            (xb-u32! (mut symtab) nameoff)
                            (xb-u8! (mut symtab) (primitive/ior (primitive/ishl bind 4) sty))
                            (xb-u8! (mut symtab) 0)  ; st_other (default visibility)
                            (xb-u16! (mut symtab) shndx)
                            (xb-u64! (mut symtab) (.off sp))  ; st_value
                            (xb-u64! (mut symtab) (.size sp)))
                          (set! i (primitive/iadd (load i) 1))))))

            ; ---- lay out file offsets ----
            ; the ELF header is 64 bytes; section contents follow, each aligned.
            (let [(mut out) (al-new [u8] a)
                  (mut soff) (al-new [i64] a)
                  (mut pos) 64]
              ; section contents
              (let [(mut i) 0]
                (loop (if (>= (load i) nsect)
                          (break)
                          (do
                            (let [sp (xal-at [ESect] (field o sects) (load i))]
                              (set! pos (ealign-up (load pos) (.align sp)))
                              (push! (mut soff) (load pos))
                              ; SHT_NOBITS (.bss) occupies no file space
                              (unless (= (load (field sp stype)) (sht-nobits))
                                (store! pos
                                        (primitive/iadd (load pos)
                                                        (len (load (field sp
                                                                          buf)))))
                                0))
                            (set! i (primitive/iadd (load i) 1))))))
              ; .rela sections (8-byte aligned, 24 bytes per entry)
              (let [(mut reloff) (al-new [i64] a)
                    (mut i) 0]
                (loop (if (>= (load i) nsect)
                          (break)
                          (do
                            (if (> (get (load relcount) (load i)) (primitive/cast i64 0))
                                (do
                                  (set! pos (ealign-up (load pos) 8))
                                  (push! (mut reloff) (load pos))
                                  (set! pos
                                        (primitive/iadd (load pos)
                                                        (primitive/imul (get (load relcount) (load i)) 24))))
                                (push! (mut reloff) 0))
                            (set! i (primitive/iadd (load i) 1)))))
                (set! pos (ealign-up (load pos) 8))
                (let [symtab-off (load pos)]
                  (set! pos (primitive/iadd (load pos) (len (load symtab))))
                  (let [strtab-off (load pos)]
                    (set! pos (primitive/iadd (load pos) (len (load strtab))))
                    (let [shstrtab-off (load pos)]
                      (set! pos (primitive/iadd (load pos) (len (load shstr))))
                      (set! pos (ealign-up (load pos) 8))
                      (let [shoff (load pos)]

                        ; ================= emit the ELF header =================
                        (xb-u8! (mut out) 127)  ; \x7f;ELF
                        (xb-u8! (mut out) 69)
                        (xb-u8! (mut out) 76)
                        (xb-u8! (mut out) 70)
                        (xb-u8! (mut out) 2)  ; EI_CLASS = ELFCLASS64
                        (xb-u8! (mut out) 1)  ; EI_DATA  = ELFDATA2LSB
                        (xb-u8! (mut out) 1)  ; EI_VERSION
                        (xb-u8! (mut out) 0)  ; EI_OSABI = SYSV
                        (xb-zeros! (mut out) 8)  ; EI_ABIVERSION + padding
                        (xb-u16! (mut out) 1)  ; e_type = ET_REL
                        (xb-u16! (mut out) 62)  ; e_machine = EM_X86_64
                        (xb-u32! (mut out) 1)  ; e_version
                        (xb-u64! (mut out) 0)  ; e_entry (none in a .o)
                        (xb-u64! (mut out) 0)  ; e_phoff
                        (xb-u64! (mut out) shoff)
                        (xb-u32! (mut out) 0)  ; e_flags
                        (xb-u16! (mut out) 64)  ; e_ehsize
                        (xb-u16! (mut out) 0)  ; e_phentsize
                        (xb-u16! (mut out) 0)  ; e_phnum
                        (xb-u16! (mut out) 64)  ; e_shentsize
                        (xb-u16! (mut out) total-sh)
                        (xb-u16! (mut out) shstrtab-ndx)

                        ; ================= section contents =================
                        (let [(mut i) 0]
                          (loop (if (>= (load i) nsect)
                                    (break)
                                    (do
                                      (let [sp (xal-at [ESect] (field o sects) (load i))]
                                        (unless (= (load (field sp stype)) (sht-nobits))
                                          (xb-zeros! (mut out)
                                                     (primitive/isub (get (load soff) (load i))
                                                                     (len (load out))))
                                          (xb-bytes! (mut out) (al-slice [u8] (load (field sp buf))))
                                          0))
                                      (set! i (primitive/iadd (load i) 1))))))

                        ; ================= .rela sections =================
                        (let [(mut si) 0]
                          (loop (if (>= (load si) nsect)
                                    (break)
                                    (do
                                      (when (> (get (load relcount) (load si)) (primitive/cast i64 0))
                                        (xb-zeros! (mut out)
                                                   (primitive/isub (get (load reloff) (load si))
                                                                   (len (load out))))
                                        ; emit every relocation belonging to this section
                                        (let [(mut i) 0]
                                          (loop (if (>= (load i) nrel)
                                                    (break)
                                                    (do
                                                      (let [rp (xal-at [EReloc] (field o relocs) (load i))]
                                                        (when (= (primitive/isub (load (field rp
                                                                                              sect))
                                                                                 1)
                                                                 (load si))
                                                          (xb-u64! (mut out) (load (field rp off)))
                                                          ; r_info = (sym << 32) | type
                                                          (xb-u32! (mut out) (load (field rp rtype)))
                                                          (xb-u32! (mut out)
                                                                   (get (load perm) (load (field rp sym))))
                                                          (xb-u64! (mut out) (load (field rp addend)))
                                                          0))
                                                      (store! i (primitive/iadd (load i) 1))))))
                                        0)
                                      (set! si (primitive/iadd (load si) 1))))))

                        ; ================= symtab / strtab / shstrtab =================
                        (xb-zeros! (mut out) (primitive/isub symtab-off (len (load out))))
                        (xb-bytes! (mut out) (al-slice [u8] (load symtab)))
                        (xb-bytes! (mut out) (al-slice [u8] (load strtab)))
                        (xb-bytes! (mut out) (al-slice [u8] (load shstr)))

                        ; ================= section header table =================
                        (xb-zeros! (mut out) (primitive/isub shoff (len (load out))))
                        ; [0] the reserved null section header
                        (xb-zeros! (mut out) 64)
                        ; [1..n] the caller's sections
                        (let [(mut i) 0]
                          (loop (if (>= (load i) nsect)
                                    (break)
                                    (do
                                      (let [sp (xal-at [ESect] (field o sects) (load i))]
                                        (xb-u32! (mut out) (get (load shname-off) (load i)))
                                        (xb-u32! (mut out) (.stype sp))
                                        (xb-u64! (mut out) (.flags sp))
                                        (xb-u64! (mut out) 0)  ; sh_addr (unbound in a .o)
                                        (xb-u64! (mut out) (get (load soff) (load i)))
                                        (xb-u64! (mut out) (len (.buf sp)))
                                        (xb-u32! (mut out) 0)  ; sh_link
                                        (xb-u32! (mut out) 0)  ; sh_info
                                        (xb-u64! (mut out) (.align sp))
                                        (xb-u64! (mut out) 0))  ; sh_entsize
                                      (set! i (primitive/iadd (load i) 1))))))
                        ; [.rela.NAME] one per section that has relocations
                        (let [(mut i) 0]
                          (loop (if (>= (load i) nsect)
                                    (break)
                                    (do
                                      (when (> (get (load relcount) (load i)) (primitive/cast i64 0))
                                        (let [sp (xal-at [ESect] (field o sects) (load i))]
                                          (xb-u32! (mut out) (get (load relname-off) (load i)))
                                          (xb-u32! (mut out) (sht-rela))
                                          (xb-u64! (mut out) 0)  ; sh_flags (not SHF_ALLOC in a .o)
                                          (xb-u64! (mut out) 0)  ; sh_addr
                                          (xb-u64! (mut out) (get (load reloff) (load i)))
                                          (xb-u64! (mut out)
                                                   (primitive/imul (get (load relcount) (load i)) 24))
                                          (xb-u32! (mut out) symtab-ndx)  ; sh_link -> .symtab
                                          (xb-u32! (mut out) (load (field sp shndx)))  ; sh_info -> target
                                          (xb-u64! (mut out) 8)
                                          (xb-u64! (mut out) 24))  ; sh_entsize
                                        0)
                                      (set! i (primitive/iadd (load i) 1))))))
                        ; [.symtab] — sh_info is the index of the FIRST global symbol,
                        ; i.e. the count of locals including the null entry.
                        (xb-u32! (mut out) symtab-name)
                        (xb-u32! (mut out) (sht-symtab))
                        (xb-u64! (mut out) 0)
                        (xb-u64! (mut out) 0)
                        (xb-u64! (mut out) symtab-off)
                        (xb-u64! (mut out) (len (load symtab)))
                        (xb-u32! (mut out) strtab-ndx)  ; sh_link -> .strtab
                        (xb-u32! (mut out) (primitive/iadd (load nlocal) 1))  ; sh_info
                        (xb-u64! (mut out) 8)
                        (xb-u64! (mut out) 24)  ; sh_entsize
                        ; [.strtab]
                        (xb-u32! (mut out) strtab-name)
                        (xb-u32! (mut out) (sht-strtab))
                        (xb-u64! (mut out) 0)
                        (xb-u64! (mut out) 0)
                        (xb-u64! (mut out) strtab-off)
                        (xb-u64! (mut out) (len (load strtab)))
                        (xb-u32! (mut out) 0)
                        (xb-u32! (mut out) 0)
                        (xb-u64! (mut out) 1)
                        (xb-u64! (mut out) 0)
                        ; [.shstrtab]
                        (xb-u32! (mut out) shstrtab-name)
                        (xb-u32! (mut out) (sht-strtab))
                        (xb-u64! (mut out) 0)
                        (xb-u64! (mut out) 0)
                        (xb-u64! (mut out) shstrtab-off)
                        (xb-u64! (mut out) (len (load shstr)))
                        (xb-u32! (mut out) 0)
                        (xb-u32! (mut out) 0)
                        (xb-u64! (mut out) 1)
                        (xb-u64! (mut out) 0)

                        (box! a (ArrayList u8) (load out))))))))))))))
