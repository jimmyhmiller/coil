; src/compiler/driver.coil — self-host Coil compiler DRIVER (CLI dispatch +
; pipeline orchestration + object emit/link), shared by both compiler builds:
;   * src/compiler/main.coil      — full compiler (LLVM + native arm64 backends)
;   * src/compiler/main_a64.coil  — LLVM-free build (native arm64 backend only)
; This module is backend-AGNOSTIC: it never imports codegen.coil / normalize.coil
; (the LLVM backend). The two LLVM entry points (`build` via LLVM, `emit-ir`) and
; `__normalize` are injected as function pointers by the top file (see driver-main),
; so a build that omits the LLVM backend simply passes hard-error stubs and never
; references libLLVM. The native backend, tpde (build-native-program), is always here.
; Imports resolve relative to CWD = repo root; ALWAYS build from repo root.
(module coil.compiler.driver)
(import "coil.compiler.cli_base" :use *)
(import "coil.compiler.cli_project" :use *)
(import "coil.compiler.pipeline" :use *)
(import "coil.compiler.session" :use *)
(import "coil.compiler.repl_terminal" :use *)
(import "coil.compiler.cli_fix" :use *)
(import "coil.compiler.cli_test" :use *)
(import "coil.compiler.cli_run" :use *)
(import "coil.compiler.cli_build" :use *)
(import "coil.compiler.cli_doc" :use *)
(import "coil.compiler.cli_units" :use *)
(import "coil.compiler.large_pages" :as large-pages)
(import "coil.primitive" :as primitive)
(import "coil.temp" :as temp)
(import "coil.compiler.unit_state" :use *)
(import "coil.alloc" :as alloc :use *)
(import "coil.result" :use *)
(import "coil.slice" :use *)

; coil.reader also exports a parse-int (it accepts a leading `+`), which the flag
; parsers below use; coil.str's is reached as str/parse-int.
(import "coil.str" :as str :use * :exclude [parse-int])
(import "coil.arraylist" :use *)
(import "coil.avec" :use [AVec avec-at avec-edit avec-new avec-to-list])
(import "coil.hashmap" :use *)
(import "coil.pmap" :use *)
(import "coil.io" :use *)
(import "coil.os" :as os)
(import "coil.fs" :as fs)
(import "coil.control" :use *)
(import "coil.try" :use *)
(import "coil.scratch" :as scratch)
(import "coil.compiler.env" :use *)

; sibling selfhost modules import by bare name (resolved relative to this file's
; dir), matching the convention in codegen.coil/check.coil/etc. Only the top-level
; entry files (main.coil / main_a64.coil) use CWD-relative "src/compiler/…" paths.
(import "coil.compiler.ffi" :use *)
(import "coil.compiler.guide" :use *)  ; `coil guide` — the language reference (generated from docs/reference/LANGUAGE_GUIDE.md)

(import "coil.reader" :use *)
(import "coil.compiler.update" :as updater)
(import "coil.project" :use *)
(import "coil.compiler.ast" :use *)
(import "coil.compiler.astdump" :use *)
(import "coil.compiler.parser" :use *)
(import "coil.compiler.loader" :use *)
(import "coil.compiler.stdlib_manifest" :use *)
(import "coil.compiler.resolve" :use *)
(import "coil.compiler.check" :use *)
(import "coil.compiler.mono" :use *)
(import "coil.compiler.phase_split" :use *)
(import "coil.compiler.name_sort" :use *)
(import "coil.compiler.diag" :use *)
(import "coil.compiler.trace" :as tr)
(import "coil.compiler.mtrace" :as mtr)  ; COIL_MTRACE=mem binds the root arena's byte counter here

(import "coil.compiler.metastate" :use *)
(import "coil.compiler.closure" :use *)
(import "coil.compiler.metaengine" :use *)
(import "coil.compiler.expander" :use *)
