; src/compiler/driver.coil — self-host Coil compiler DRIVER (CLI dispatch +
; pipeline orchestration + object emit/link), shared by both compiler builds:
;   * src/compiler/main.coil      — full compiler (LLVM + native arm64 backends)
;   * src/compiler/main_a64.coil  — LLVM-free build (native arm64 backend only)
; This module is backend-AGNOSTIC: it never imports codegen.coil / normalize.coil
; (the LLVM backend). The two LLVM entry points (`build` via LLVM, `emit-ir`) and
; `__normalize` are injected as function pointers by the top file (see driver-main),
; so a build that omits the LLVM backend simply passes hard-error stubs and never
; references libLLVM. The native arm64 backend (build-arm64-program) is always here.
; Imports resolve relative to CWD = repo root; ALWAYS build from repo root.
(module driver)
(import "coil.primitive" :as primitive)

(import "coil.alloc" :as alloc :use *)
(import "coil.result" :use *)
(import "coil.slice" :use *)
(import "coil.str" :use *)
(import "coil.arraylist" :use *)
(import "coil.hashmap" :use *)
(import "coil.io" :use *)
(import "coil.os" :as os)
(import "coil.time" :as time)  ; wall-now-ms — a clock the wasm module already imports  ; fork/waitpid — `balance` checks candidates in a child
(import "coil.control" :use *)
(import "coil.try" :use *)
; sibling selfhost modules import by bare name (resolved relative to this file's
; dir), matching the convention in codegen.coil/check.coil/etc. Only the top-level
; entry files (main.coil / main_a64.coil) use CWD-relative "src/compiler/…" paths.
(import "ffi" :use *)
(import "guide" :use *)  ; `coil guide` — the language reference (generated from docs/reference/LANGUAGE_GUIDE.md)
(import "coil.reader" :use *)
(import "ast" :use *)
(import "astdump" :use *)
(import "parser" :use *)
(import "loader" :use *)
(import "cimport" :as ci)
(import "embedded_stdlib" :use *)
(import "resolve" :use *)
(import "check" :use *)
(import "mono" :use *)
(import "diag" :use *)
(import "trace" :as tr)
(import "comptime" :use *)
(import "metaengine" :use *)
(import "expander" :use *)
(import "cga64" :use *)
(import "interp" :use *)  ; `coil interp` — additive bytecode interpreter (guarded; never in the compile path)
(import "wasm" :use *)
(import "cgwasm" :use *)  ; native wasm64 (memory64) backend, no LLVM
(import "cgx64" :use *)  ; native x86-64 (ELF) backend, no LLVM
(import "rules" :as fmtr)  ; the `coil fmt` formatter (qualified to avoid name clashes)
(import "balance" :as bal)  ; `coil balance` — delimiter repair, same reason for the alias
(import "formedit" :as fed)  ; `coil edit` — form-addressed edits
; The operation constants come in unqualified: a `const` is not reachable through the
; `:as` alias, and spelling them as bare integers here would silently decouple them
; from their definitions.
(import "formedit" :use [OP-REPLACE OP-BEFORE OP-AFTER OP-DELETE OP-SHOW OP-LIST])

; ============================ `coil doc` ====================================
; Render a module's documented surface as markdown. A doc is a `;;` comment block
; directly above a definition (`ct-doc-at`, the same rule `(primitive/code-doc NODE)` uses at
; comptime) — so the docs live in the source, in one place, and nothing can drift.

; Is this the head symbol of a definition worth documenting?
(defn doc-kind-of [(head (slice u8))] (-> (slice u8))
  (cond (= head "defn") "fn"
        (= head "defstruct") "struct"
        (= head "defsum") "sum"
        (= head "deftrait") "trait"
        (= head "defcc") "convention"
        (= head "defprimitive") "primitive"
        (= head "const") "const"
        (= head "extern") "extern"
        ""))

; The signature to show: for a `defn`, everything up to and including the `(-> …)`
; return form (the header, without the body); for anything else, the whole form.
; Both are SOURCE TEXT, so what you read is what was written.
(defn doc-sig [(a (ptr Allocator)) (src (slice u8)) (form Sexp) (is-fn bool)] (-> (slice u8))
  (let [items (sx-items form)
        n (sx-len items)
        lo (sx-lo form)
        (mut end) (sx-hi form)]
    (if (not is-fn)
        (subslice [u8] src lo (load end))
        (let [(mut i) 1
              (mut found) false]
          (loop (if (or (load found) (>= (load i) n))
                    (break)
                    (do
                      (let [c (sx-at items (load i))]
                        (when (= (sx-tag c) (primitive/cast i64 6))
                          ; a list …
                          (let [ci (sx-items c)]
                            (when (and (>= (sx-len ci) (primitive/cast i64 1))
                                       (and (= (sx-tag (sx-at ci 0)) (primitive/cast i64 2))
                                            (= (sx-sval (sx-at ci 0)) "->")))
                              (store! end (sx-hi c))
                              (store! found true)))))
                      (store! i (primitive/iadd (load i) 1)))))
          (if (load found)
              (sconcat a (subslice [u8] src lo (load end)) ")")
              (subslice [u8] src lo (sx-hi form)))))))

(defn doc-cmd [(a (ptr Allocator)) (target (slice u8)) (show-all bool)] (-> i64)
  (let [disk (read-file a (str->cstr a target))
        bundled-file (embedded-file-for-namespace target)
        src
          (if (> (str-len disk) (primitive/cast i64 0))
              disk
              (if (= target "coil.core")
                  (embedded-prelude)
                  (if (> (str-len bundled-file) (primitive/cast i64 0)) (bundled-text a bundled-file) "")))
        w (stdout)]
    (if (= (str-len src) (primitive/cast i64 0))
        (do
          (ps (stderr) "error: no file or bundled namespace named '")
          (ps (stderr) target)
          (ps (stderr) "'\n")
          1)
        (match (read-all a src 0)
          (Err [d] (let [dp (alloc/stack Diag)] (store! dp d) (dump-error (stderr) dp) 1))
          (Ok [forms]
              (do
                (let [n (sx-len forms)
                      (mut i) 0
                      (mut shown) 0]
                  ; the module header, if the file declares one
                  (loop (if (>= (load i) n)
                            (break)
                            (do
                              (let [f (sx-at forms (load i))]
                                (when (= (sx-tag f) (primitive/cast i64 6))
                                  (let [items (sx-items f)]
                                    (when (and (>= (sx-len items) (primitive/cast i64 2))
                                               (and (= (sx-tag (sx-at items 0)) (primitive/cast i64 2))
                                                    (= (sx-sval (sx-at items 0)) "module")))
                                      (ps w "# ")
                                      (ps w (sx-sval (sx-at items 1)))
                                      (wb w 10)
                                      (wb w 10)
                                      0))))
                              (store! i (primitive/iadd (load i) 1)))))
                  (store! i 0)
                  (loop (if (>= (load i) n)
                            (break)
                            (do
                              (let [f (sx-at forms (load i))]
                                (when (= (sx-tag f) (primitive/cast i64 6))
                                  (let [items (sx-items f)]
                                    (when (>= (sx-len items) (primitive/cast i64 2))
                                      (let [h (sx-at items 0)]
                                        (when (= (sx-tag h) (primitive/cast i64 2))
                                          (let [kind (doc-kind-of (sx-sval h))]
                                            (when (> (str-len kind) (primitive/cast i64 0))
                                              (let [doc (ct-doc-at a src (sx-lo f))]
                                                (when (or show-all (> (str-len doc) (primitive/cast i64 0)))
                                                  (store! shown (primitive/iadd (load shown) 1))
                                                  (ps w "## ")
                                                  (ps w (sx-sval (sx-at items 1)))
                                                  (ps w "  *(")
                                                  (ps w kind)
                                                  (ps w ")*")
                                                  (wb w 10)
                                                  (wb w 10)
                                                  (ps w "```lisp")
                                                  (wb w 10)
                                                  (ps w (doc-sig a src f (= (sx-sval h) "defn")))
                                                  (wb w 10)
                                                  (ps w "```")
                                                  (wb w 10)
                                                  (wb w 10)
                                                  (when (> (str-len doc) (primitive/cast i64 0))
                                                    (ps w doc)
                                                    (wb w 10)
                                                    (wb w 10))
                                                  0))))))))))
                              (store! i (primitive/iadd (load i) 1)))))
                  (when (= (load shown) (primitive/cast i64 0))
                    (ps (stderr) "note: no `;;` doc comments in ")
                    (ps (stderr) target)
                    (ps (stderr) " — a doc is a `;;` block directly above a definition\n")
                    0))
                0))))))

(defn dump-ast-program [(a (ptr Allocator)) (src (slice u8))] (-> i64)
  (let [bout (alloc/stack BufferedOutput)
        w (buffered-output-writer bout (stdout))]
    (match (read-all a src 0)
      (Err [d] (let [dp (alloc/stack Diag)] (store! dp d) (dump-error w dp)))
      (Ok [forms]
          (match (parse-program a forms)
            (Err [d] (let [dp (alloc/stack Diag)] (store! dp d) (dump-error w dp)))
            (Ok [prog] (let [pp (alloc/stack Program)] (store! pp prog) (d-program w pp a))))))
    (buffered-output-flush bout))
  0)

; ============================ file IO + entry ===============================
(defn dump-mono-program [(a (ptr Allocator)) (src (slice u8)) (cwd (slice u8))] (-> i64)
  (let [bout (alloc/stack BufferedOutput)
        w (buffered-output-writer bout (stdout))
        s (alloc/stack LS)
        (mut rc) 0]
    (ls-init! (mut s) a)
    (store! (field s srccount) 1)
    (register-source! (mut s) "<source>" src)
    (match (read-all a src 0)
      (Err [d] (let [dp (alloc/stack Diag)] (store! dp d) (dump-error w dp) (store! rc 1)))
      (Ok [forms]
          (do
            (namespace-index-build! (mut s))
            (load-program (mut s) (prepend-uses a (mut s) forms) cwd)
            (if (ls-err? (mut s))
                (let [dp (alloc/stack Diag)]
                  (store! dp (load (field s loaderr)))
                  (dump-error w dp)
                  (store! rc 1))
                (match (expand-stage3 (mut s))
                  (Err [d] (let [dp (alloc/stack Diag)] (store! dp d) (dump-error w dp) (store! rc 1)))
                  (Ok [_]
                      (match (run-transforms-and-check a (mut s))
                        (Err [d] (let [dp (alloc/stack Diag)] (store! dp d) (dump-error w dp) (store! rc 1)))
                        (Ok [cp]
                            (do
                              (drop-code-funcs a cp)
                              (match (monomorphize a cp)
                                (Err [d]
                                     (let [dp (alloc/stack Diag)]
                                       (store! dp d)
                                       (dump-error w dp)
                                       (store! rc 1)))
                                (Ok [mp] (do (sort-mono-program a mp) (d-program w mp a)))))))))))))
    (buffered-output-flush bout)
    (load rc)))

; dump-checked: read -> load -> resolve -> check -> checked Program dump (NO mono).
(defn dump-checked-program [(a (ptr Allocator)) (src (slice u8)) (cwd (slice u8))] (-> i64)
  (let [bout (alloc/stack BufferedOutput)
        w (buffered-output-writer bout (stdout))
        s (alloc/stack LS)
        (mut rc) 0]
    (ls-init! (mut s) a)
    (store! (field s srccount) 1)
    (register-source! (mut s) "<source>" src)
    (match (read-all a src 0)
      (Err [d] (let [dp (alloc/stack Diag)] (store! dp d) (dump-error w dp) (store! rc 1)))
      (Ok [forms]
          (do
            (namespace-index-build! (mut s))
            (load-program (mut s) (prepend-uses a (mut s) forms) cwd)
            (if (ls-err? (mut s))
                (let [dp (alloc/stack Diag)]
                  (store! dp (load (field s loaderr)))
                  (dump-error w dp)
                  (store! rc 1))
                (match (expand-stage3 (mut s))
                  (Err [d] (let [dp (alloc/stack Diag)] (store! dp d) (dump-error w dp) (store! rc 1)))
                  (Ok [_]
                      (match (run-transforms-and-check a (mut s))
                        (Err [d] (let [dp (alloc/stack Diag)] (store! dp d) (dump-error w dp) (store! rc 1)))
                        (Ok [cp] (d-program w cp a)))))))))
    (buffered-output-flush bout)
    (load rc)))

; dump-resolved: read -> load -> resolve -> resolved Program dump.
(defn dump-resolved-program [(a (ptr Allocator)) (src (slice u8)) (cwd (slice u8))] (-> i64)
  (let [bout (alloc/stack BufferedOutput)
        w (buffered-output-writer bout (stdout))
        s (alloc/stack LS)]
    (ls-init! (mut s) a)
    (store! (field s srccount) 1)
    (register-source! (mut s) "<source>" src)
    (match (read-all a src 0)
      (Err [d] (let [dp (alloc/stack Diag)] (store! dp d) (dump-error w dp)))
      (Ok [forms]
          (do
            (namespace-index-build! (mut s))
            (load-program (mut s) (prepend-uses a (mut s) forms) cwd)
            (if (ls-err? (mut s))
                (let [dp (alloc/stack Diag)]
                  (store! dp (load (field s loaderr)))
                  (dump-error w dp))
                (match (resolve-program a (mut s) true false)
                  (Err [d] (let [dp (alloc/stack Diag)] (store! dp d) (dump-error w dp)))
                  (Ok [prog] (d-program w prog a)))))))
    (buffered-output-flush bout))
  0)

; dump-read: raw read -> canonical Sexp forms (reader oracle). sx-node's
; @source:lo:hi:ctxt is byte-identical to the standalone reader dumper for raw
; single-file input (source=0, ctxt=0, no dummy spans).
(defn dump-read-program [(a (ptr Allocator)) (src (slice u8))] (-> i64)
  (let [bout (alloc/stack BufferedOutput)
        w (buffered-output-writer bout (stdout))]
    (match (read-all a src 0)
      (Err [d] (let [dp (alloc/stack Diag)] (store! dp d) (dump-error w dp)))
      (Ok [forms]
          (let [(mut i) 0
                n (al-len [Sexp] (load forms))]
            (loop (if (>= (load i) n)
                      (break)
                      (do
                        (when (> (load i) (primitive/cast i64 0)) (wb w 10))
                        (let [child (alloc/stack Sexp)]
                          (store! child (al-get [Sexp] (load forms) (load i)))
                          (sx-node w child))
                        (store! i (primitive/iadd (load i) 1))))))))
    (buffered-output-flush bout))
  0)

; ---- loader-dump helpers ported verbatim from src/compiler/loader.coil ----
; (imp-elem/exp-elem/d-strs/d-opt-str/dstr already defined above.)
(defn alias-key [(x Alias)] (-> (slice u8))
  (let [p (alloc/stack Alias)] (store! p x) (load (field p alias))))
(defn alias-tgt [(x Alias)] (-> (slice u8))
  (let [p (alloc/stack Alias)] (store! p x) (load (field p target))))
(defn use-tgt [(x Use)] (-> (slice u8))
  (let [p (alloc/stack Use)] (store! p x) (load (field p target))))
(defn use-spec [(x Use)] (-> UseSpec)
  (let [p (alloc/stack Use)] (store! p x) (load (field p spec))))

; selection-sort a COPY of a slice list ascending by str-cmp.
(defn sorted-strs [(a (ptr Allocator)) (l (ptr (ArrayList (slice u8))))] (-> (ptr (ArrayList (slice u8))))
  (let [n (al-len [(slice u8)] (load l))
        (mut c) (al-new [(slice u8)] a)
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (al-push! (mut c) (al-get [(slice u8)] (load l) (load i)))
                (store! i (primitive/iadd (load i) 1)))))
    (let [(mut p) 0]
      (loop (if (>= (load p) n)
                (break)
                (do
                  (let [(mut m) (load p)
                        (mut q) (primitive/iadd (load p) 1)]
                    (loop (if (>= (load q) n)
                              (break)
                              (do
                                (when (str-lt (al-get [(slice u8)] (load c) (load q))
                                              (al-get [(slice u8)] (load c) (load m)))
                                  (store! m (load q)))
                                (store! q (primitive/iadd (load q) 1)))))
                    (let [tp (al-get [(slice u8)] (load c) (load p))
                          tm (al-get [(slice u8)] (load c) (load m))]
                      (al-set! (mut c) (load p) tm)
                      (al-set! (mut c) (load m) tp)))
                  (store! p (primitive/iadd (load p) 1))))))
    (let [bp (unwrap-ptr [(ArrayList (slice u8))] (create [(ArrayList (slice u8))] a))]
      (store! bp (load c))
      bp)))

; sorted index permutation of 0..n by the parallel key strings (selection sort).
(defn sort-idx [(a (ptr Allocator)) (keys (ptr (ArrayList (slice u8))))] (-> (ptr (ArrayList i64)))
  (let [n (al-len [(slice u8)] (load keys))
        (mut idx) (al-new [i64] a)
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do (al-push! (mut idx) (load i)) (store! i (primitive/iadd (load i) 1)))))
    (let [(mut p) 0]
      (loop (if (>= (load p) n)
                (break)
                (do
                  (let [(mut m) (load p)
                        (mut q) (primitive/iadd (load p) 1)]
                    (loop (if (>= (load q) n)
                              (break)
                              (do
                                (when (str-lt (al-get [(slice u8)]
                                                      (load keys)
                                                      (al-get [i64] (load idx) (load q)))
                                              (al-get [(slice u8)]
                                                      (load keys)
                                                      (al-get [i64] (load idx) (load m))))
                                  (store! m (load q)))
                                (store! q (primitive/iadd (load q) 1)))))
                    (let [tp (al-get [i64] (load idx) (load p))
                          tm (al-get [i64] (load idx) (load m))]
                      (al-set! (mut idx) (load p) tm)
                      (al-set! (mut idx) (load m) tp)))
                  (store! p (primitive/iadd (load p) 1))))))
    (let [bp (unwrap-ptr [(ArrayList i64)] (create [(ArrayList i64)] a))]
      (store! bp (load idx))
      bp)))

; `(aliases [(al "k" "v") …]) (uses [(use "t" SPEC) …]) (reexports [...])`.
(defn d-modimports [(w (ptr Writer)) (a (ptr Allocator)) (m (mut ModImports))] (-> i64)
  (ps w "(aliases [")
  (let [na (al-len [Alias] (load (field m aliases)))
        (mut keys) (al-new [(slice u8)] a)
        (mut i) 0]
    (loop (if (>= (load i) na)
              (break)
              (do
                (al-push! (mut keys)
                          (alias-key (al-get [Alias] (load (field m aliases)) (load i))))
                (store! i (primitive/iadd (load i) 1)))))
    (let [kp (unwrap-ptr [(ArrayList (slice u8))] (create [(ArrayList (slice u8))] a))]
      (store! kp (load keys))
      (let [idx (sort-idx a kp)
            (mut j) 0]
        (loop (if (>= (load j) na)
                  (break)
                  (do
                    (when (> (load j) (primitive/cast i64 0)) (wb w 32))
                    (let [e
                            (al-get [Alias]
                                    (load (field m aliases))
                                    (al-get [i64] (load idx) (load j)))]
                      (ps w "(al ")
                      (dstr w (alias-key e))
                      (wb w 32)
                      (dstr w (alias-tgt e))
                      (wb w 41))
                    (store! j (primitive/iadd (load j) 1))))))))
  (ps w "]) (uses [")
  (let [nu (al-len [Use] (load (field m uses)))
        (mut i) 0]
    (loop (if (>= (load i) nu)
              (break)
              (do
                (when (> (load i) (primitive/cast i64 0)) (wb w 32))
                (let [u (al-get [Use] (load (field m uses)) (load i))]
                  (ps w "(use ")
                  (dstr w (use-tgt u))
                  (wb w 32)
                  (match (use-spec u)
                    (UAll [] (ps w "(all)"))
                    (UNames [names] (do (ps w "(names ") (d-strs w names) (wb w 41))))
                  (wb w 41))
                (store! i (primitive/iadd (load i) 1))))))
  (ps w "]) (reexports ")
  (let [rp (unwrap-ptr [(ArrayList (slice u8))] (create [(ArrayList (slice u8))] a))]
    (store! rp (load (field m reexports)))
    (d-strs w rp))
  (wb w 41))

; dump-load: read -> load -> canonical loaded-forms/imports/exports dump.
(defn dump-loaded [(w (ptr Writer)) (a (ptr Allocator)) (s (mut LS))] (-> i64)
  (ps w "(forms")
  (let [n (al-len [TaggedForm] (load (field s out)))
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (ps w " (tf ")
                (let [tf (alloc/stack TaggedForm)]
                  (store! tf (al-get [TaggedForm] (load (field s out)) (load i)))
                  (d-opt-str w (load (field tf module)))
                  (wb w 32)
                  (let [fp (alloc/stack Sexp)]
                    (store! fp (load (field tf form)))
                    (sx-node w fp)))
                (wb w 41)
                (store! i (primitive/iadd (load i) 1))))))
  (wb w 41)
  (wb w 10)
  (ps w "(imports")
  (let [n (al-len [ImpEntry] (load (field s imports)))
        (mut keys) (al-new [(slice u8)] a)
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (al-push! (mut keys) (load (field (imp-elem (mut s) (load i)) name)))
                (store! i (primitive/iadd (load i) 1)))))
    (let [kp (unwrap-ptr [(ArrayList (slice u8))] (create [(ArrayList (slice u8))] a))]
      (store! kp (load keys))
      (let [idx (sort-idx a kp)
            (mut j) 0]
        (loop (if (>= (load j) n)
                  (break)
                  (do
                    (let [e (imp-elem (mut s) (al-get [i64] (load idx) (load j)))]
                      (ps w " (mod ")
                      (dstr w (load (field e name)))
                      (wb w 32)
                      (d-modimports w a (mut (field e imp)))
                      (wb w 41))
                    (store! j (primitive/iadd (load j) 1))))))))
  (wb w 41)
  (wb w 10)
  (ps w "(exports")
  (let [n (al-len [ExpEntry] (load (field s exports)))
        (mut keys) (al-new [(slice u8)] a)
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (al-push! (mut keys) (load (field (exp-elem (mut s) (load i)) name)))
                (store! i (primitive/iadd (load i) 1)))))
    (let [kp (unwrap-ptr [(ArrayList (slice u8))] (create [(ArrayList (slice u8))] a))]
      (store! kp (load keys))
      (let [idx (sort-idx a kp)
            (mut j) 0]
        (loop (if (>= (load j) n)
                  (break)
                  (do
                    (let [e (exp-elem (mut s) (al-get [i64] (load idx) (load j)))
                          namesp (unwrap-ptr [(ArrayList (slice u8))] (create [(ArrayList (slice u8))] a))]
                      (store! namesp (load (field e names)))
                      (ps w " (mod ")
                      (dstr w (load (field e name)))
                      (wb w 32)
                      (d-strs w (sorted-strs a namesp))
                      (wb w 41))
                    (store! j (primitive/iadd (load j) 1))))))))
  (wb w 41)
  0)

(defn dump-load-program [(a (ptr Allocator)) (src (slice u8)) (cwd (slice u8))] (-> i64)
  (let [bout (alloc/stack BufferedOutput)
        w (buffered-output-writer bout (stdout))
        s (alloc/stack LS)]
    (ls-init! (mut s) a)
    (store! (field s srccount) 1)
    (register-source! (mut s) "<source>" src)
    (match (read-all a src 0)
      (Err [d] (let [dp (alloc/stack Diag)] (store! dp d) (dump-error w dp)))
      (Ok [forms]
          (do
            (namespace-index-build! (mut s))
            (load-program (mut s) (prepend-uses a (mut s) forms) cwd)
            (dump-loaded w a (mut s)))))
    (buffered-output-flush bout))
  0)

; A standalone byte-exact smoke for the 6 new d-expr arms (run: `<bin> __smoke`).
; Each line must match exactly what would emit for the same node.
(defn smoke [(a (ptr Allocator))] (-> i64)
  (let [w (stdout)]
    ; (staticref@1:2 "foo")
    (let [e (alloc/stack Expr)] (store! e (mk-expr (EStaticRef "foo") 1 2 0 0)) (d-expr w e))
    (wb w 10)
    ; (spillref@5:6 (eint@3:4 7))
    (let [inner (box-expr a (mk-expr (EInt 7) 3 4 0 0))
          e (alloc/stack Expr)]
      (store! e (mk-expr (ESpillRef inner) 5 6 0 0))
      (d-expr w e))
    (wb w 10)
    ; (construct@9:10 "Opt" "Some" [(eint@7:8 9)])
    (let [(mut xs) (al-new [Expr] a)]
      (al-push! (mut xs) (mk-expr (EInt 9) 7 8 0 0))
      (let [args (box-al [Expr] a (load xs))
            e (alloc/stack Expr)]
        (store! e
                (mk-expr (EConstruct
                           :sum "Opt"
                           :variant "Some"
                           :args args)
                         9
                         10
                         0
                         0))
        (d-expr w e)))
    (wb w 10)
    ; (traitcall@11:12 "Eq" "eq" "T" [])
    (let [args (box-al [Expr] a (al-new [Expr] a))
          e (alloc/stack Expr)]
      (store! e
              (mk-expr (ETraitCall
                         :trait_name "Eq"
                         :method "eq"
                         :self_tp "T"
                         :args args)
                       11
                       12
                       0
                       0))
      (d-expr w e))
    (wb w 10)
    ; (makedyn@13:14 "Dyn" "VT" ["m0" "m1"] (var@15:16 "x"))
    (let [(mut ms) (al-new [(slice u8)] a)]
      (al-push! (mut ms) "m0")
      (al-push! (mut ms) "m1")
      (let [methods (box-al [(slice u8)] a (load ms))
            inner (box-expr a (mk-expr (EVar "x") 15 16 0 0))
            e (alloc/stack Expr)]
        (store! e
                (mk-expr (EMakeDyn
                           :dyn_struct "Dyn"
                           :vtable_struct "VT"
                           :methods methods
                           :inner inner)
                         13
                         14
                         0
                         0))
        (d-expr w e)))
    (wb w 10)
    ; (dyndispatch@17:18 "Dyn" "VT" 2 "c" [] void (var@19:20 "r") [])
    (let [params (box-al [Type] a (al-new [Type] a))
          args (box-al [Expr] a (al-new [Expr] a))
          recv (box-expr a (mk-expr (EVar "r") 19 20 0 0))
          e (alloc/stack Expr)]
      (store! e
              (mk-expr (EDynDispatch
                         :dyn_struct "Dyn"
                         :vtable_struct "VT"
                         :method_index 2
                         :cc "c"
                         :params params
                         :ret (TVoid)
                         :recv recv
                         :args args)
                       17
                       18
                       0
                       0))
      (d-expr w e))
    (wb w 10)
    ; ---- ty-str byte-exact checks ----
    (let [t (alloc/stack Type)] (store! t (TInt 64 true)) (ps w (ty-str a t)))
    (wb w 10)  ; i64
    (let [t (alloc/stack Type)] (store! t (TInt 8 false)) (ps w (ty-str a t)))
    (wb w 10)  ; u8
    (let [t (alloc/stack Type)] (store! t (TPtr (box-type a (TInt 8 false)))) (ps w (ty-str a t)))
    (wb w 10)  ; (ptr u8)
    (let [t (alloc/stack Type)] (store! t (TRef true (box-type a (TStruct "Foo")))) (ps w (ty-str a t)))
    (wb w 10)  ; (mut Foo)
    (let [(mut ps2) (al-new [Type] a)]
      (al-push! (mut ps2) (TInt 64 true))
      (al-push! (mut ps2) (TInt 64 true))
      (let [t (alloc/stack Type)]
        (store! t (TApp "Pair" (box-al [Type] a (load ps2))))
        (ps w (ty-str a t))))
    (wb w 10)  ; (Pair i64 i64)
    (let [(mut ps3) (al-new [Type] a)]
      (al-push! (mut ps3) (TPtr (box-type a (TInt 8 true))))
      (let [t (alloc/stack Type)]
        (store! t
                (TFn
                  :cc "c"
                  :params (box-al [Type] a (load ps3))
                  :ret (box-type a (TInt 64 true))))
        (ps w (ty-str a t))))
    (wb w 10)  ; (fnptr c [(ptr i8)] i64)
    0))

; ============================ codegen (the frontier) =========================
; (3496 lines): monomorphized Program -> LLVM module, built via the
; LLVM-C FFI surface above. FAITHFUL, call-for-call port of `compile_for_dbg` with
; dbg=None (every debug-info path skipped). The corpus has no shims / no struct-by-
; value C ABI, so ABI classification is deferred (a struct-by-value extern hard-errors).

; ---- Tv: a lowered (value, Coil type) pair
; ── CLI-applied metaprograms: `--use PATH` imports a module (which self-registers
; its (checker …)/(transform …)) WITHOUT editing the source — so you can run a linter
; optionally: `coil run app.coil --use myproject.lint`.
(defstruct UsesBox [(init i64) (lst (ptr (ArrayList (slice u8))))])
(defn uses-box [] (-> (ptr UsesBox))
  (alloc/static UsesBox))
(defn cli-uses [] (-> (ptr (ArrayList (slice u8))))
  (let [b (uses-box)]
    (when (= (load (field b init)) (primitive/cast i64 0))
      (store! (field b lst) (unwrap-ptr [(ArrayList (slice u8))] (create [(ArrayList (slice u8))] (malloc-allocator))))
      (store! (load (field b lst)) (al-new [(slice u8)] (malloc-allocator)))
      (store! (field b init) 1)
      0)
    (load (field b lst))))
(defn cli-use-add [(p (slice u8))] (-> i64)
  (al-push! (cli-uses) p)
  0)
(defn is-module-form [(s (ptr Sexp))] (-> bool)
  (and (= (sx-tag (load s)) (primitive/cast i64 6))
       (let [it (sx-items (load s))]
         (and (>= (sx-len it) (primitive/cast i64 1))
              (and (= (sx-tag (sx-at it 0)) (primitive/cast i64 2)) (= (sx-sval (sx-at it 0)) "module"))))))
(defn is-import-form [(s (ptr Sexp))] (-> bool)
  (and (= (sx-tag (load s)) (primitive/cast i64 6))
       (let [it (sx-items (load s))]
         (and (>= (sx-len it) (primitive/cast i64 1))
              (and (= (sx-tag (sx-at it 0)) (primitive/cast i64 2)) (= (sx-sval (sx-at it 0)) "import"))))))

(defn forms-have-import? [(forms (ptr (ArrayList Sexp)))] (-> bool)
  (let [n (al-len [Sexp] (load forms))
        (mut i) 0
        (mut found) false]
    (loop (if (or (load found) (>= (load i) n))
              (break)
              (do
                (when (is-import-form (al-elem [Sexp] forms (load i))) (store! found true) 0)
                (store! i (primitive/iadd (load i) 1)))))
    (load found)))

; A module name for an entry file that declares none: its own basename with the
; extension dropped and anything that is not a name character folded to `_`.
(defn entry-module-name [(a (ptr Allocator)) (path (slice u8))] (-> (slice u8))
  (let [base (basename path)
        n (slice-len [u8] base)
        stop (if (d-ends-with? base ".coil") (primitive/isub n (primitive/cast i64 5)) n)
        (mut b) (sb-new a)
        (mut i) 0]
    (loop (if (>= (load i) stop)
              (break)
              (let [c (primitive/cast i64 (slice-get [u8] base (load i)))]
                (if (or (and (>= c (primitive/cast i64 97)) (<= c (primitive/cast i64 122)))
                        (or (and (>= c (primitive/cast i64 65)) (<= c (primitive/cast i64 90)))
                            (or (and (>= c (primitive/cast i64 48)) (<= c (primitive/cast i64 57)))
                                (or (= c (primitive/cast i64 45)) (= c (primitive/cast i64 95))))))
                    (sb-push-byte! (mut b) (primitive/cast u8 c))
                    (sb-push-byte! (mut b) (primitive/cast u8 95)))
                (store! i (primitive/iadd (load i) 1)))))
    (if (= (slice-len [u8] (sb-str (load b))) (primitive/cast i64 0)) "app" (sb-str (load b)))))

; prepend `(import "PATH" :use *)` forms (one per --use) ahead of the entry forms,
; read as their own synthetic source so entry-file diagnostics keep exact spans.
;
; Also synthesizes a `(module …)` for the ENTRY file when it declares none and
; something imports. Imports are qualified against the current module, so a
; module-less file that imported anything was refused outright. That constraint is
; real for an IMPORTED file — its namespace is how anyone names it — but the entry is
; named on the command line and imported by nobody, so the requirement bought nothing.
; It cost a confusing error, and `coil test` / `--debug-checks` inject imports of their
; own, so the diagnostic pointed at `<cli-use>`: a file the user never wrote.
;
; A file with no module and no imports is untouched and still compiles as it always
; did, so the ONLY programs whose behaviour changes here are ones that were previously
; rejected.
(defn prepend-uses [(a (ptr Allocator)) (s (mut LS)) (forms (ptr (ArrayList Sexp)))] (-> (ptr (ArrayList Sexp)))
  (let [uses (cli-uses)
        nu (al-len [(slice u8)] (load uses))
        nf0 (al-len [Sexp] (load forms))
        hasmod0 (if (> nf0 (primitive/cast i64 0)) (is-module-form (al-elem [Sexp] forms 0)) false)
        need-module
          (and (not hasmod0)
               (or (> nu (primitive/cast i64 0)) (forms-have-import? forms)))]
    (if (and (= nu (primitive/cast i64 0)) (not need-module))
        forms
        (let [(mut src)
                (if need-module
                    (sconcat3 a
                              "(module "
                              (entry-module-name a
                                                 (load (field (al-elem [Source] (field s sources) 0) name)))
                              ")")
                    "")
              (mut k) 0]
          (loop (if (>= (load k) nu)
                    (break)
                    (do
                      (store! src
                              (sconcat a
                                       (load src)
                                       (sconcat3 a
                                                 "(import \""
                                                 (al-get [(slice u8)]
                                                         (load uses)
                                                         (load k))
                                                 "\" :use *)")))
                      (store! k (primitive/iadd (load k) 1)))))
          (let [sid (load (field s srccount))
                _b (store! (field s srccount) (primitive/iadd sid 1))
                _r (register-source! (mut s) "<cli-use>" (load src))]
            (match (read-all a (load src) sid)
              (Err [d] forms)
              (Ok [ifs]
                  (let [(mut out) (al-new [Sexp] a)
                        ni (al-len [Sexp] (load ifs))
                        nf (al-len [Sexp] (load forms))
                        hasmod (if (> nf (primitive/cast i64 0)) (is-module-form (al-elem [Sexp] forms 0)) false)
                        (mut j) 0
                        (mut m) 0]
                    ; keep a leading (module …) first, then the CLI imports, then the rest
                    (when hasmod (al-push! (mut out) (al-get [Sexp] (load forms) 0)) (store! j 1))
                    (loop (if (>= (load m) ni)
                              (break)
                              (do
                                (al-push! (mut out) (al-get [Sexp] (load ifs) (load m)))
                                (store! m (primitive/iadd (load m) 1)))))
                    (loop (if (>= (load j) nf)
                              (break)
                              (do
                                (al-push! (mut out) (al-get [Sexp] (load forms) (load j)))
                                (store! j (primitive/iadd (load j) 1)))))
                    (box-al [Sexp] a (load out))))))))))
(defn run-pipeline [(a (ptr Allocator))
                    (src (slice u8))
                    (cwd (slice u8))
                    (w (ptr Writer))
                    (path (slice u8))
                    (srcpaths (ptr (ArrayList (slice u8))))
                    (srctexts (ptr (ArrayList (slice u8))))] (-> (Option (ptr Program)))
  (let [s (alloc/stack LS)]
    (ls-init! (mut s) a)
    (store! (field s srccount) 1)
    (register-source! (mut s) path src)
    (match (read-all a src 0)
      (Err [d] (do (report-diag w (mut s) d) (None [(ptr Program)])))
      (Ok [forms]
          ; file-relative imports (tool-1): the entry file's own relative imports
          ; resolve against ITS directory, not the process CWD (nested imports already
          ; use each imported file's incdir). `cwd` stays for DWARF comp_dir only.
          (do
            (let [load-span (tr/span-begin "frontend.load")]
              (namespace-index-build! (mut s))
              (load-program (mut s) (prepend-uses a (mut s) forms) (dirname path))
              (tr/span-end load-span))
            (if (ls-err? (mut s))
                (do (report-diag w (mut s) (load (field s loaderr))) (None [(ptr Program)]))
                (let [expand-span (tr/span-begin "frontend.expand")
                      expand-result (expand-stage3 (mut s))
                      _expand-end (tr/span-end expand-span)]
                  (match expand-result
                    (Err [d] (do (report-diag w (mut s) d) (None [(ptr Program)])))
                    (Ok [_]
                        ; transforms (fixpoint) + authoritative resolve + typecheck, one step
                        (let [check-span (tr/span-begin "frontend.transforms-and-check")
                              check-result (run-transforms-and-check a (mut s))
                              _check-end (tr/span-end check-span)]
                          (match check-result
                            (Err [d] (do (report-check-diags w (mut s) d) (None [(ptr Program)])))
                            (Ok [cp]
                                (let [checker-span (tr/span-begin "frontend.registered-checkers")
                                      checker-result (run-registered-checkers a (mut s) cp)
                                      _checker-end (tr/span-end checker-span)]
                                  (match checker-result  ; semantic checkers: read the authoritative checked program
                                    (Err [d] (do (report-diag w (mut s) d) (None [(ptr Program)])))
                                    (Ok [_]
                                        (do
                                          (drop-code-funcs a cp)
                                          (let [mono-span (tr/span-begin "frontend.monomorphize")
                                                mono-result (monomorphize a cp)
                                                _mono-end (tr/span-end mono-span)]
                                            (match mono-result
                                              (Err [d] (do (report-diag w (mut s) d) (None [(ptr Program)])))
                                              (Ok [mp]
                                                  (do
                                                    (sort-mono-program a mp)
                                                    ; export the source registry (for DWARF)
                                                    (let [ns (al-len [Source] (load (field s sources)))
                                                          (mut i) 0]
                                                      (loop (if (>= (load i) ns)
                                                                (break)
                                                                (do
                                                                  (let [sp
                                                                          (al-elem [Source]
                                                                                   (field s sources)
                                                                                   (load i))]
                                                                    (al-push! (mut srcpaths)
                                                                              (load (field sp name)))
                                                                    (al-push! (mut srctexts)
                                                                              (load (field sp text))))
                                                                  (store! i (primitive/iadd (load i) 1))))))
                                                    (Some mp)))))))))))))))))))))

; `check` / `build -o /dev/null`: run the SAME front-end `build` runs before codegen
; (read -> load -> expand -> transforms -> typecheck -> monomorphize) but emit NO object.
; Returns 1 when the program compiles cleanly through mono, 0 (with a located diagnostic
; already reported to stderr) otherwise. Because this reuses run-pipeline verbatim, a
; program that `check`s clean is one `build` would only ever fail to LINK, never to
; compile. Signature is the mode-3 dump-fn shape so it runs on the big stack. (diag-12)
(defn check-src-program [(a (ptr Allocator)) (src (slice u8)) (cwd (slice u8)) (path (slice u8))] (-> i64)
  (let [w (stderr)
        (mut sp0) (al-new [(slice u8)] a)
        (mut st0) (al-new [(slice u8)] a)]
    (match (run-pipeline a src cwd w path (mut sp0) (mut st0))
      (Some [_] 1)
      (None [] 0))))

; `interp <file>`: run the SAME front-end as `build` (read -> load -> expand ->
; transforms -> typecheck -> monomorphize), then INTERPRET the mono'd Program with
; the bytecode VM (interp.coil) instead of emitting an object. `main`'s i64 return
; IS the process exit code; the program's stdout goes to real stdout via libc FFI.
; Signature is the mode-3 dump-fn shape so it runs on the big stack (the VM
; recurses per call frame). On a compile error the diagnostic is already reported
; and this returns 1. (ADDITIVE — the compile pipeline is byte-unchanged.)
(defn interp-src-program [(a (ptr Allocator)) (src (slice u8)) (cwd (slice u8)) (path (slice u8))] (-> i64)
  (let [w (stderr)
        (mut sp0) (al-new [(slice u8)] a)
        (mut st0) (al-new [(slice u8)] a)]
    (match (run-pipeline a src cwd w path (mut sp0) (mut st0))
      (Some [mp] (interp-program a mp))
      (None [] 1))))

; The LLVM entry points (dump-ir-program / build-object / build-ir-program) live in
; src/compiler/main.coil and are injected here as function pointers (see driver-main /
; DumpCtx), so this module carries no LLVM dependency.

; arm64 native backend: mono Program -> Mach-O object, no LLVM anywhere.
(defn build-arm64-program [(a (ptr Allocator)) (src (slice u8)) (cwd (slice u8)) (obj-cstr (ptr i8)) (path (slice u8))] (-> i64)
  (let [w (stderr)
        (mut sp0) (al-new [(slice u8)] a)
        (mut st0) (al-new [(slice u8)] a)]
    (match (run-pipeline a src cwd w path (mut sp0) (mut st0))
      (Some [mp]
            (do
              (cga64-build-object a
                                  mp
                                  obj-cstr
                                  path
                                  cwd
                                  (box-al [(slice u8)] a (load sp0))
                                  (box-al [(slice u8)] a (load st0))
                                  true)
              1))
      (None [] 0))))

; x86-64 native backend: mono Program -> ELF object, no LLVM anywhere.
(defn build-x64-program [(a (ptr Allocator)) (src (slice u8)) (cwd (slice u8)) (obj-cstr (ptr i8)) (path (slice u8))] (-> i64)
  (let [w (stderr)
        (mut sp0) (al-new [(slice u8)] a)
        (mut st0) (al-new [(slice u8)] a)]
    (match (run-pipeline a src cwd w path (mut sp0) (mut st0))
      (Some [mp]
            (do
              (cgx64-build-object a
                                  mp
                                  obj-cstr
                                  path
                                  cwd
                                  (box-al [(slice u8)] a (load sp0))
                                  (box-al [(slice u8)] a (load st0))
                                  true)
              1))
      (None [] 0))))

; native wasm64 backend: mono Program -> a FINAL memory64 wasm module (no LLVM, no
; linker, no finalizer step). The module bytes are written straight to `obj-cstr`,
; which build-cmd points at the -o output path for --backend wasm.
(defn build-wasm-program [(a (ptr Allocator)) (src (slice u8)) (cwd (slice u8)) (obj-cstr (ptr i8)) (path (slice u8))] (-> i64)
  (let [w (stderr)
        (mut sp0) (al-new [(slice u8)] a)
        (mut st0) (al-new [(slice u8)] a)]
    (match (run-pipeline a src cwd w path (mut sp0) (mut st0))
      (Some [mp] (do (d-write-file a (cstr->slice obj-cstr) (wcg-build-module a mp (wasm-side-module?))) 1))
      (None [] 0))))

; Context handed to the pipeline thread (the C entry takes a single (ptr i8) arg).
; `mode` 0 = emit-ir (print IR to stdout); 1 = build (emit object to `obj`).
; `triple` = the `--target` override cstr (null = host default) for cross-compiling.
; `ok` is the pipeline result the thread writes back so the caller (main / build-cmd)
; can HALT and exit nonzero on a compile error —, where a failed
; `build_executable_*` / `emit_ir` returns Err and `main` prints + exits FAILURE
; BEFORE any link step. 1 = pipeline succeeded, 0 = a diagnostic was reported.
;
; `build-fn` / `emitir-fn` are the LLVM-backend entry points, injected by the top
; file (main.coil supplies the real ones; main_a64.coil supplies hard-error stubs).
; dump-thread-entry calls through them for modes 1/0, so the LLVM backend is fully
; decoupled from this module. Their signatures mirror the (removed) build-ir-program
; and dump-ir-program.
(defstruct DumpCtx
  [(a (ptr Allocator))
   (src (slice u8))
   (cwd (slice u8))
   (mode i64)
   (obj (ptr i8))
   (triple (ptr i8))
   (path (slice u8))
   (ok i64)
   (build-fn (fnptr c [(ptr Allocator) (slice u8) (slice u8) (ptr i8) (ptr i8) (slice u8)] i64))
   (emitir-fn (fnptr c [(ptr Allocator) (slice u8) (slice u8) (ptr i8) (slice u8)] i64))
   ; mode 3 (a debug dump: dump-read/ast/load/expand/resolved/checked/mono).
   ; The dump functions differ in arity, so each is adapted to this one
   ; (a src cwd path) -> i64 shape by a `-w` wrapper (see below); the thread
   ; calls whichever wrapper was stored. Dumps run the SAME recursive passes
   ; as build, so they must share the big stack, not overflow the 8 MiB main.
   (dump-fn (fnptr c [(ptr Allocator) (slice u8) (slice u8) (slice u8)] i64))])

; pthread start_routine: unpack the context and run the real pipeline on the
; big-stack thread so the recursive passes (parser/checker/codegen/comptime) don't
; overflow the default ~8MB stack.
(defn dump-thread-entry [(arg (ptr i8))] (-> (ptr i8))
  (let [ctx (primitive/cast (ptr DumpCtx) arg)
        r
          (cond (= (load (field ctx mode)) (primitive/cast i64 3))
                  (primitive/call-ptr (load (field ctx dump-fn))
                                      (load (field ctx a))
                                      (load (field ctx src))
                                      (load (field ctx cwd))
                                      (load (field ctx path)))
                (= (load (field ctx mode)) (primitive/cast i64 4))
                  (build-wasm-program (load (field ctx a))
                                      (load (field ctx src))
                                      (load (field ctx cwd))
                                      (load (field ctx obj))
                                      (load (field ctx path)))
                (= (load (field ctx mode)) (primitive/cast i64 2))
                  (build-arm64-program (load (field ctx a))
                                       (load (field ctx src))
                                       (load (field ctx cwd))
                                       (load (field ctx obj))
                                       (load (field ctx path)))
                (= (load (field ctx mode)) (primitive/cast i64 5))
                  (build-x64-program (load (field ctx a))
                                     (load (field ctx src))
                                     (load (field ctx cwd))
                                     (load (field ctx obj))
                                     (load (field ctx path)))
                (= (load (field ctx mode)) (primitive/cast i64 1))
                  (primitive/call-ptr (load (field ctx build-fn))
                                      (load (field ctx a))
                                      (load (field ctx src))
                                      (load (field ctx cwd))
                                      (load (field ctx obj))
                                      (load (field ctx triple))
                                      (load (field ctx path)))
                :else
                  (primitive/call-ptr (load (field ctx emitir-fn))
                                      (load (field ctx a))
                                      (load (field ctx src))
                                      (load (field ctx cwd))
                                      (load (field ctx triple))
                                      (load (field ctx path))))]
    (store! (field ctx ok) r)
    ; release the main thread if it is servicing metaprogram calls (COIL_META_MAIN=1)
    (main-svc-finish!)
    (primitive/cast (ptr i8) 0)))

; Run the (emit-ir or build) pipeline on a 512 MiB pthread, given a fully-populated
; DumpCtx. Shared by the `emit-ir` and `build` subcommands.
(defn run-on-big-stack [(ctx (ptr DumpCtx))] (-> i64)
  ; WASM-hosted build: no pthread. The sandbox is single-threaded and the shadow
  ; stack is already the module's whole reserved stack, so run the pipeline inline
  ; (dump-thread-entry writes ctx.ok exactly as the spawned thread would). Covers both
  ; the side-module (meta-wasm-active?) and interpreter (wasm-sandbox?) wasm entries.
  (if (or (meta-wasm-active?) (wasm-sandbox?))
      (do (dump-thread-entry (primitive/cast (ptr i8) ctx)) (load (field ctx ok)))
      (let [attr (alloc/stack (array i8 64))
            tid (alloc/stack (ptr i8))]
        (pthread_attr_init (primitive/cast (ptr i8) attr))
        ; 512 MiB. The 2 MiB floor that justified 32 MiB was measured on HAND-WRITTEN
        ; source, where nesting is shallow because a human wrote it. Macro-generated code
        ; is the case that measurement missed: `cond` expands to nested ifs, so an
        ; 800-clause dispatch table is 800 levels deep, and the pipeline recurses per level
        ; at ~75 KB a level (entry-block allocas — see cg-entry-alloca). At 32 MiB that
        ; ran out at ~450 levels and died with a bare signal and zero output.
        ; This is virtual reservation, not committed memory: pages fault in on use, so the
        ; ceiling costs nothing until a deep program actually needs it. parse-depth-limit
        ; (parser.coil) sits well under the cliff this buys, so a too-deep program gets a
        ; located diagnostic rather than a crash.
        (pthread_attr_setstacksize (primitive/cast (ptr i8) attr) (worker-stack-size))
        (pthread_attr_setguardsize (primitive/cast (ptr i8) attr) (worker-guard-size))
        ; COIL_META_MAIN=1: this (the MAIN) thread services metaprogram calls while
        ; the pipeline runs — AppKit metaprograms need the real main thread. The loop
        ; is a no-op when the service was never initialized.
        (when (meta-main?) (main-svc-init!))
        (pthread_create (primitive/cast (ptr i8) tid)
                        (primitive/cast (ptr i8) attr)
                        (primitive/fnptr-of dump-thread-entry)
                        (primitive/cast (ptr i8) ctx))
        (pthread_attr_destroy (primitive/cast (ptr i8) attr))
        (main-svc-loop)
        (pthread_join (load tid) (primitive/cast (ptr i8) 0))
        ; the thread wrote its pipeline result (1 ok / 0 failed) into ctx.ok.
        (load (field ctx ok)))))

; ---- debug dumps on the big stack -------------------------------------------
; `coil expand` / the `dump-*` debug commands run the SAME recursive front-end
; (reader/parser/loader/resolve/check/mono/expand) as `build`, so they overflow the
; default ~8 MiB MAIN thread on deeply-nested (macro-generated) input that `build`
; compiles fine on the big stack. Route them through the identical run-on-big-stack /
; DumpCtx mechanism. The dump functions differ in arity; each `-w` wrapper adapts one
; to the uniform (a src cwd path) -> i64 shape the thread invokes (mode 3). Every dump
; returns 0 and prints its own diagnostics, so this exit code is 0 on success.
(defn dump-read-w [(a (ptr Allocator)) (src (slice u8)) (cwd (slice u8)) (path (slice u8))] (-> i64)
  (dump-read-program a src))
(defn dump-ast-w [(a (ptr Allocator)) (src (slice u8)) (cwd (slice u8)) (path (slice u8))] (-> i64)
  (dump-ast-program a src))
; file-relative imports (tool-1): the base for the entry file's own relative
; imports is ITS directory (dirname path), not the process CWD.
(defn dump-load-w [(a (ptr Allocator)) (src (slice u8)) (cwd (slice u8)) (path (slice u8))] (-> i64)
  (dump-load-program a src (dirname path)))
(defn expand-src-w [(a (ptr Allocator)) (src (slice u8)) (cwd (slice u8)) (path (slice u8))] (-> i64)
  (expand-src-program a src (dirname path) path))
(defn dump-expand-w [(a (ptr Allocator)) (src (slice u8)) (cwd (slice u8)) (path (slice u8))] (-> i64)
  (dump-expand-program a src (dirname path)))
(defn dump-resolved-w [(a (ptr Allocator)) (src (slice u8)) (cwd (slice u8)) (path (slice u8))] (-> i64)
  (dump-resolved-program a src (dirname path)))
(defn dump-checked-w [(a (ptr Allocator)) (src (slice u8)) (cwd (slice u8)) (path (slice u8))] (-> i64)
  (dump-checked-program a src (dirname path)))
(defn dump-mono-w [(a (ptr Allocator)) (src (slice u8)) (cwd (slice u8)) (path (slice u8))] (-> i64)
  (dump-mono-program a src (dirname path)))

; Populate a mode-3 DumpCtx and run the chosen dump wrapper on the big-stack pthread.
(defn run-dump-on-big-stack [(a (ptr Allocator))
                             (src (slice u8))
                             (cwd (slice u8))
                             (path (slice u8))
                             (dfn (fnptr c [(ptr Allocator) (slice u8) (slice u8) (slice u8)] i64))] (-> i64)
  (let [ctx (alloc/stack DumpCtx)]
    (store! (field ctx a) a)
    (store! (field ctx src) src)
    (store! (field ctx cwd) cwd)
    (store! (field ctx path) path)
    (store! (field ctx mode) 3)
    (store! (field ctx obj) (primitive/cast (ptr i8) 0))
    (store! (field ctx triple) (primitive/cast (ptr i8) 0))
    (store! (field ctx ok) 0)
    (store! (field ctx dump-fn) dfn)
    (run-on-big-stack ctx)))

; The intermediate object path for output `out`
; `out_path.with_extension("o")`: REPLACE the final path-component extension with
; `o` (`a.out` -> `a.o`, `foo.coil` -> `foo.o`), or APPEND `.o` when the basename
; has none (`foo` -> `foo.o`). A `.` in a parent directory doesn't count; a leading
; dot (`.foo`) is not an extension. This keeps the `.o` name — hence any linker
; diagnostic that prints it — for ANY `-o`.
(defn obj-path [(a (ptr Allocator)) (out (slice u8))] (-> (slice u8))
  (let [n (slice-len out)
        (mut slash) -1
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (when (= (primitive/cast i64 (slice-get out (load i))) (primitive/cast i64 47))
                  (store! slash (load i)))
                (store! i (primitive/iadd (load i) 1)))))
    (let [(mut dot) -1
          (mut j) (primitive/iadd (load slash) 1)]
      (loop (if (>= (load j) n)
                (break)
                (do
                  (when (= (primitive/cast i64 (slice-get out (load j))) (primitive/cast i64 46))
                    (store! dot (load j)))
                  (store! j (primitive/iadd (load j) 1)))))
      (let [(mut sb) (sb-new a)]
        (if (> (load dot) (primitive/iadd (load slash) 1))
            (do (sb-push-str! (mut sb) (subslice out 0 (load dot))) (sb-push-str! (mut sb) ".o"))
            (do (sb-push-str! (mut sb) out) (sb-push-str! (mut sb) ".o")))
        (sb-str (load sb))))))

(defn wasm-target? [(triple (ptr i8))] (-> bool)
  (if (= (primitive/cast i64 triple) (primitive/cast i64 0))
      false
      (let [s (cstr->slice triple)]
        (or (starts-with s "wasm32-") (starts-with s "wasm64-")))))

; ---- reading a source file the user named ------------------------------------
; `read-file` maps ENOENT to "" — right for the loader's disk-first/embedded-module
; probing, WRONG for a path a user typed. An empty program compiles clean to an object
; with no `main`, so a mistyped filename surfaced as an arm64 linker error about `_main`
; that named neither the file nor the mistake — and `fmt --write` on a missing path
; FABRICATED the file. `read-file-opt` already separates "missing" from "empty" and its
; own comment says so; this is the one door every user-supplied path goes through.
; `rc` is the process exit code for a missing file: 1 for build/emit (what clang
; does), 2 for `fmt --check`, where 1 already means "this file is not formatted"
; and a CI gate must be able to tell that apart from a broken invocation.
(defn read-src-rc [(a (ptr Allocator)) (path (ptr i8)) (rc i64)] (-> (slice u8))
  (match (read-file-opt a path)
    (Some [s] s)
    (None []
          (let [w (stderr)]
            (ps w "error: no such file: '")
            (ps w (cstr->slice path))
            (ps w "'")
            (wb w 10)
            (exit (primitive/cast i32 rc))
            ""))))

(defn read-src [(a (ptr Allocator)) (path (ptr i8))] (-> (slice u8))
  (read-src-rc a path 1))

; ---- child exit status ------------------------------------------------------
; `system` returns a raw wait(2) status, NOT an exit code. The low 7 bits hold the
; terminating signal (0 when the child exited normally); the exit code sits in the
; high byte. Reading only the high byte — (st/256)&255 — yields 0 for EVERY signal
; death, so a child that segfaulted reported success. These two are the one place
; that decodes a wait status; every call site goes through them.
(defn wait-signal [(st i64)] (-> i64)
  (unless (< st (primitive/cast i64 0)) (primitive/iand st 127)))

(defn wait-code [(st i64)] (-> i64)
  (if (< st (primitive/cast i64 0))
      127  ; system() itself failed (no shell / fork failed)
      (let [sig (wait-signal st)]
        (if (!= sig (primitive/cast i64 0))
            (primitive/iadd 128 sig)  ; killed by a signal: 128+signo, as a shell reports
            (primitive/iand (primitive/udiv st 256) 255)))))

(defn signal-name [(sig i64)] (-> (slice u8))
  (cond (= sig (primitive/cast i64 2)) "SIGINT"
        (= sig (primitive/cast i64 3)) "SIGQUIT"
        (= sig (primitive/cast i64 4)) "SIGILL"
        (= sig (primitive/cast i64 5)) "SIGTRAP"
        (= sig (primitive/cast i64 6)) "SIGABRT"
        (= sig (primitive/cast i64 8)) "SIGFPE"
        (= sig (primitive/cast i64 9)) "SIGKILL"
        (= sig (primitive/cast i64 10)) "SIGBUS"
        (= sig (primitive/cast i64 11)) "SIGSEGV"
        (= sig (primitive/cast i64 13)) "SIGPIPE"
        (= sig (primitive/cast i64 15)) "SIGTERM"
        ""))

; A signal death is otherwise invisible: the child prints nothing and the status is
; just a number. Say it out loud, naming what died.
(defn wait-report [(st i64) (what (slice u8))] (-> i64)
  (let [sig (wait-signal st)]
    (unless (= sig (primitive/cast i64 0))
      (let [w (stderr)
            nm (signal-name sig)]
        (ps w what)
        (ps w " terminated by signal ")
        (dump-dec w sig)
        (unless (= (slice-len [u8] nm) (primitive/cast i64 0)) (ps w " (") (ps w nm) (ps w ")") 0)
        (wb w 10)
        0))))

; ---- argv scanning ----------------------------------------------------------
; Every subcommand used to read the filename as literally argv[2], so
; `coil build -o out in.coil` — the universal Unix order — missed the file entirely,
; fell through to project mode, and reported "no Coil.toml" while never mentioning the
; file the user had just passed. The parse loop's fallthrough silently skipped anything
; it did not recognise, so a typo'd `--taget` was indistinguishable from success.
; One table, one scanner: flags are position-independent and unknown ones are errors.
(extern opendir :cc c [(ptr i8)] (-> (ptr i8)))
(extern closedir :cc c [(ptr i8)] (-> i32))
(extern setenv :cc c [(ptr i8) (ptr i8) i32] (-> i32))

; ---- the debug-checks / sanitizer build mode (mem-2 · mem-6 · mem-7 · mem-8) ----
; `--debug-checks` turns on the library-level safety checks (slice bounds,
; poison-on-free). The checks run inside MACROS that branch on `(primitive/debug-checks?)` —
; a comptime code op (comptime.coil) read at expansion time — so the driver flips the
; host-side cell here, BEFORE expansion runs, exactly like the target arch. Off by
; default: the guard macro then expands to the plain unchecked op (zero cost).
; --debug-checks also auto-applies the bundled stack-return lint (mem-8): the driver
; --uses it, so its (checker …) runs over the program — no explicit import needed. Off,
; the module is never loaded (zero cost). `cli-use-add` is idempotent-enough here (the
; flag is scanned once), and prepend-uses turns it into (import "coil.stacklint" :use *).
(defn enable-debug-checks! [] (-> i64)
  (set-debug-checks! 1)
  (cli-use-add "coil.stacklint")
  (cli-use-add "coil.lint.allocator")
  0)

; The one-switch development profile. Keep the individual flags available for
; focused use, but make the safe default discoverable and reproducible.
(defn enable-debug-runtime! [] (-> i64)
  (enable-debug-checks!)
  (select-sanitizer! 1 "address")
  (cli-use-add "coil.debug-runtime")
  0)

; Select exactly one sanitizer. ASan, TSan, and MSan use incompatible process-wide
; runtimes; UBSan is kept exclusive too so every artifact has one reproducible mode.
(defn select-sanitizer! [(mode i64) (name (slice u8))] (-> i64)
  (let [old (sanitize-mode)]
    (if (or (= old (primitive/cast i64 0)) (= old mode))
        (set-sanitize-mode! mode)
        (do
          (ps (stderr) "error: sanitizer modes cannot be combined; already selected one before --sanitize=")
          (ps (stderr) name)
          (wb (stderr) 10)
          (exit 1)
          0))))

(defn sanitizer-flag? [(arg (slice u8))] (-> bool)
  (or (= arg "--sanitize=address")
      (or (= arg "--sanitize=thread")
          (or (= arg "--sanitize=memory")
              (= arg "--sanitize=undefined")))))
(defn apply-sanitizer-flag! [(arg (slice u8))] (-> i64)
  (cond (= arg "--sanitize=address") (select-sanitizer! 1 "address")
        (= arg "--sanitize=thread") (select-sanitizer! 2 "thread")
        (= arg "--sanitize=memory") (select-sanitizer! 3 "memory")
        :else (select-sanitizer! 4 "undefined")))

(defn sanitize-address? [] (-> bool)
  (sanitize-address-on?))
(defn sanitizer? [] (-> bool)
  (!= (sanitize-mode) (primitive/cast i64 0)))
(defn sanitizer-link-flag [] (-> (slice u8))
  (cond (= (sanitize-mode) (primitive/cast i64 1)) "-fsanitize=address"
        (= (sanitize-mode) (primitive/cast i64 2)) "-fsanitize=thread"
        (= (sanitize-mode) (primitive/cast i64 3)) "-fsanitize=memory"
        :else "-fsanitize=undefined"))
(defn debug-checks? [] (-> bool)
  (debug-checks-on?))

; `--quiet` — drop build's "wrote <path>" line, and nothing else.
;
; `run` and `test` drive `build` as a subprocess purely to obtain a temp executable,
; so that line names a path the user never asked for and never sees again. They used
; to hide it by redirecting the whole build to /dev/null — which also discarded
; everything a METAPROGRAM prints while it compiles. A transform reporting what it
; rewrote is exactly the output you reach for `run` to see, and it went to the same
; place as the noise. Suppress the one line at its source instead; diagnostics were
; always on stderr and are unaffected either way.
(defstruct QuietFlag [(v i64)])
(defn quiet-cell [] (-> (ptr QuietFlag))
  (alloc/static QuietFlag))
(defn set-quiet! [(on bool)] (-> i64)
  (store! (field (quiet-cell) v) (if on (do 1) 0))
  0)
(defn quiet? [] (-> bool)
  (!= (load (field (quiet-cell) v)) (primitive/cast i64 0)))

; `-O0`/`-O1`/`-O2`/`-O3` — the LLVM optimization level, default 3. The cell itself
; lives in metaengine.coil (which the metaprogram dylib cache key needs and which
; both this module and main.coil import); only the CLI spelling is here.
(defn opt-flag? [(arg (slice u8))] (-> bool)
  (or (= arg "-O0") (or (= arg "-O1") (or (= arg "-O2") (= arg "-O3")))))
(defn apply-opt-flag! [(arg (slice u8))] (-> i64)
  (set-opt-level! (primitive/isub (primitive/cast i64 (slice-get arg 2)) 48)))
; `--meta-opt=<0|1|2|3>` — the same knob for metaprogram objects only. Unset, they
; follow -O. A bad level is a usage error, not a silent default.
(defn meta-opt-flag? [(arg (slice u8))] (-> bool)
  (starts-with arg "--meta-opt="))
(defn apply-meta-opt-flag! [(arg (slice u8))] (-> i64)
  (let [v (subslice arg 11 (slice-len arg))]
    (if (or (!= (slice-len v) (primitive/cast i64 1))
            (or (< (primitive/cast i64 (slice-get v 0)) (primitive/cast i64 48))
                (> (primitive/cast i64 (slice-get v 0)) (primitive/cast i64 51))))
        (let [w (stderr)]
          (ps w "error: --meta-opt= expects 0, 1, 2 or 3, got '")
          (ps w v)
          (ps w "'")
          (wb w 10)
          (exit 1)
          0)
        (set-meta-opt-level! (primitive/isub (primitive/cast i64 (slice-get v 0)) 48)))))

; A link flag we must NEVER pass to the metaprogram dylib link: an instrumentation
; flag on the dylib gets dlopen'd into the compiler and aborts it ("interceptors are
; not working … loaded too late"). Frameworks/libraries the program links are kept.
(defn meta-unsafe-flag? [(f (slice u8))] (-> bool)
  (or (starts-with f "-fsanitize")
      (starts-with f "-fno-sanitize")))

; The program's link flags, minus any that would poison the compiler when applied to
; the metaprogram dylib it dlopen's (mem-7). Frameworks/-l libraries are preserved.
; ---- duplicate link inputs -------------------------------------------------
; Declaring a link input in Coil.toml AND passing it as `--link-flag` used to be the
; only way to make both `coil build <file>` and `coil test` work, because the
; explicit-file build ignored the manifest. It no longer does, so the two sources
; combine — and a repeated `-Wl,-force_load,X` force-loads the same archive twice, so
; every symbol in it collides WITH ITSELF. The linker then reports
;
;   duplicate symbol '_x' in:
;       libX.a[3](000000.o)
;       libX.a[3](000000.o)
;
; naming the same object on both sides, which gives no hint that a repeated flag is
; the cause. Bare `.o`/`.a` inputs duplicate the same way.
;
; `-l<name>` is deliberately NOT deduped: repeating a library is the standard way to
; resolve circular static archives (`-la -lb -la`). `-framework` is deduped as a PAIR
; for the same reason — dropping the bare token would turn `-framework A -framework B`
; into `-framework A B`.
(defn link-dedupable? [(f (slice u8))] (-> bool)
  (or (starts-with f "-Wl,-force_load,")
      (or (d-ends-with? f ".o") (d-ends-with? f ".a"))))

; Compare link inputs by REALPATH, not by spelling. The duplication that prompted
; this arrives as two different spellings of one file — a relative path in Coil.toml
; and an absolute one from a script — and that is exactly the case the linker cannot
; collapse itself: given one path twice it warns and ignores the repeat, but given two
; spellings it force-loads the file twice and every symbol collides. An unresolvable
; path falls back to its literal text.
(defn link-dedupe-key [(a (ptr Allocator)) (f (slice u8))] (-> (slice u8))
  (if (starts-with f "-Wl,-force_load,")
      (let [p (subslice [u8] f (slice-len [u8] "-Wl,-force_load,") (slice-len [u8] f))]
        (match (m-realpath a p)
          (Some [rp] (sconcat a "-Wl,-force_load," rp))
          (None [] f)))
      (match (m-realpath a f) (Some [rp] rp) (None [] f))))

(defn strs-has? [(xs (ptr (ArrayList (slice u8)))) (v (slice u8))] (-> bool)
  (let [n (al-len [(slice u8)] (load xs))
        (mut i) 0
        (mut found) false]
    (loop (if (or (load found) (>= (load i) n))
              (break)
              (do
                (when (= (al-get [(slice u8)] (load xs) (load i)) v) (store! found true) 0)
                (store! i (primitive/iadd (load i) 1)))))
    (load found)))

(defn dedupe-link-flags [(a (ptr Allocator)) (flags (ArrayList (slice u8)))] (-> (ptr (ArrayList (slice u8))))
  (let [(mut out) (al-new [(slice u8)] a)
        seen (unwrap-ptr [(ArrayList (slice u8))] (create [(ArrayList (slice u8))] a))
        n (al-len [(slice u8)] flags)
        (mut i) 0]
    (store! seen (al-new [(slice u8)] a))
    (loop (if (>= (load i) n)
              (break)
              (let [f (al-get [(slice u8)] flags (load i))]
                (if (and (= f "-framework") (< (primitive/iadd (load i) 1) n))
                    (let [nm (al-get [(slice u8)] flags (primitive/iadd (load i) 1))
                          key (sconcat3 a "-framework " nm "")]
                      (unless (strs-has? seen key)
                        (al-push! seen key)
                        (al-push! (mut out) f)
                        (al-push! (mut out) nm)
                        0)
                      (store! i (primitive/iadd (load i) 2))
                      0)
                    (do
                      (if (link-dedupable? f)
                          (let [key (link-dedupe-key a f)]
                            (unless (strs-has? seen key)
                              (al-push! seen key)
                              (al-push! (mut out) f)
                              0))
                          (al-push! (mut out) f))
                      (store! i (primitive/iadd (load i) 1))
                      0)))))
    (box-al [(slice u8)] a (load out))))

(defn filter-meta-link-flags [(a (ptr Allocator)) (flags (ArrayList (slice u8)))] (-> (ptr (ArrayList (slice u8))))
  (let [(mut out) (al-new [(slice u8)] a)
        (mut i) 0
        n (al-len [(slice u8)] flags)]
    (loop (if (>= (load i) n)
              (break)
              (do
                (let [f (al-get [(slice u8)] flags (load i))]
                  (unless (meta-unsafe-flag? f) (al-push! (mut out) f)))
                (store! i (primitive/iadd (load i) 1)))))
    ; the metaprogram dylib link is where this bit first: the peer report was
    ; `metaengine: linking the metaprogram dylib failed`, not the program link.
    (dedupe-link-flags a (load out))))

(defn is-flag? [(arg (slice u8))] (-> bool)
  (and (>= (slice-len [u8] arg) (primitive/cast i64 1))
       (= (slice-get [u8] arg 0) (primitive/cast u8 45))))  ; '-'

(defn dash-l? [(arg (slice u8))] (-> bool)  ; -l<lib>
  (and (>= (slice-len [u8] arg) (primitive/cast i64 2))
       (and (= (slice-get [u8] arg 0) (primitive/cast u8 45))
            (= (slice-get [u8] arg 1) (primitive/cast u8 108)))))  ; 'l'

; --wasm-stack-size=<MiB>: set the wasm shadow-stack reservation (see wasm.coil).
; Self-contained '='-form, so the scanner treats it as one token.
(defn apply-wasm-stack-flag! [(arg (slice u8))] (-> i64)
  (let [val (subslice [u8] arg 18 (slice-len [u8] arg))]  ; after "--wasm-stack-size="
    (match (parse-int val)
      (Some [mib]
            (if (<= mib (primitive/cast i64 0))
                (let [w (stderr)] (ps w "error: --wasm-stack-size needs a positive MiB value") (wb w 10) (exit 1) 0)
                (set-wasm-stack-size! (primitive/imul mib 1048576))))
      (None [] (let [w (stderr)] (ps w "error: --wasm-stack-size=<MiB> not a number") (wb w 10) (exit 1) 0)))))

; flags that consume the NEXT argv entry — the scanner must step over both.
(defn flag-takes-value? [(arg (slice u8))] (-> bool)
  (cond (= arg "-o") true
        (= arg "--link-flag") true
        (= arg "--target") true
        (= arg "--use") true
        (= arg "--emit-header") true
        (= arg "--backend") true
        false))

(defn flag-known? [(arg (slice u8))] (-> bool)
  (cond (flag-takes-value? arg) true
        (dash-l? arg) true
        (= arg "--lib") true
        (= arg "--shared") true
        (= arg "-g") true
        (= arg "--debug") true
        (= arg "--debug-checks") true
        (= arg "--debug-runtime") true
        (sanitizer-flag? arg) true
        (opt-flag? arg) true
        (meta-opt-flag? arg) true
        (= arg "--wasm-side-module") true
        (= arg "--quiet") true
        (starts-with arg "--wasm-stack-size=") true
        false))

; `coil test`'s own value-taking flags. Deliberately NOT folded into
; flag-takes-value?: that table is the BUILD flag set, and teaching it --suite/--jobs
; would make both silently legal on `coil build`. Without this, `coil test --suite
; integration` would read `integration` as the file positional.
(defn test-flag-takes-value? [(arg (slice u8))] (-> bool)
  (or (= arg "--suite") (or (= arg "--jobs") (flag-takes-value? arg))))

(defn test-file-idx [(argc i32) (argv (ptr (ptr i8))) (start i64)] (-> i64)
  (let [(mut i) start
        (mut r) 0]
    (loop (if (>= (load i) (primitive/cast i64 argc))
              (break)
              (let [arg (cstr->slice (load (primitive/index argv (load i))))]
                (if (= arg "--")
                    (break)
                    (if (is-flag? arg)
                        (do
                          (store! i (primitive/iadd (load i) (if (test-flag-takes-value? arg) 2 1)))
                          0)
                        (do (store! r (load i)) (break)))))))
    (load r)))

; index of the first positional at/after `start`, or 0 if there is none.
; Stops at `--` (run's program args are not our positionals).
(defn argv-file-idx [(argc i32) (argv (ptr (ptr i8))) (start i64)] (-> i64)
  (let [(mut i) start
        (mut r) 0]
    (loop (if (>= (load i) (primitive/cast i64 argc))
              (break)
              (let [arg (cstr->slice (load (primitive/index argv (load i))))]
                (if (= arg "--")
                    (break)
                    (if (is-flag? arg)
                        (do (store! i (primitive/iadd (load i) (if (flag-takes-value? arg) 2 1))) 0)
                        (do (store! r (load i)) (break)))))))
    (load r)))

; the `--target <triple>` value anywhere in argv, or null (host default).
(defn argv-triple [(argc i32) (argv (ptr (ptr i8)))] (-> (ptr i8))
  (let [(mut i) 2
        (mut r) (primitive/cast (ptr i8) 0)]
    (loop (if (>= (load i) (primitive/cast i64 argc))
              (break)
              (do
                (when (and (= (cstr->slice (load (primitive/index argv (load i)))) "--target")
                           (< (primitive/iadd (load i) 1) (primitive/cast i64 argc)))
                  (store! r (load (primitive/index argv (primitive/iadd (load i) 1))))
                  (break))
                (store! i (primitive/iadd (load i) 1)))))
    (load r)))

; `--link-flag X` / `-lfoo` straight off argv, for the meta/comptime link.
;
; A comptime expression that reaches native code is linked into a dylib with the SAME
; flags the program links (metaengine::me-link-flags-str), which is the only way a
; comptime fold can call into a library the compiler process does not itself contain.
; `build-cmd` sets those flags as part of its own argument parsing — but `check`,
; `emit-ir` and the `dump-*` commands accept `--link-flag` and had no equivalent step,
; so the flag was silently ignored and exactly those commands failed on a program
; `build` compiles fine. Setting it centrally at dispatch fixes all of them at once;
; build-cmd's own call runs later and wins, keeping its sanitizer filtering.
(defn set-meta-link-flags-from-argv! [(a (ptr Allocator)) (argc i32) (argv (ptr (ptr i8)))] (-> i64)
  (let [(mut flags) (al-new [(slice u8)] a)
        (mut i) 2]
    (loop (if (>= (load i) (primitive/cast i64 argc))
              (break)
              (let [arg (cstr->slice (load (primitive/index argv (load i))))]
                (cond (= arg "--") (break)
                      (and (= arg "--link-flag") (< (primitive/iadd (load i) 1) (primitive/cast i64 argc)))
                        (do
                          (al-push! (mut flags)
                                    (cstr->slice (load (primitive/index argv (primitive/iadd (load i) 1)))))
                          (store! i (primitive/iadd (load i) 2))
                          0)
                      (and (starts-with arg "-l") (> (slice-len [u8] arg) (primitive/cast i64 2)))
                        (do (al-push! (mut flags) arg) (store! i (primitive/iadd (load i) 1)) 0)
                      :else (do (store! i (primitive/iadd (load i) 1)) 0)))))
    (when (> (al-len [(slice u8)] (load flags)) (primitive/cast i64 0))
      (set-meta-link-flags! (filter-meta-link-flags a (load flags)))
      0))
  0)

; reject an unrecognised flag instead of skipping it. `fidx` is the positional the
; caller already claimed as its file; anything else non-flag is a stray argument.
(defn argv-reject-unknown [(argc i32) (argv (ptr (ptr i8))) (start i64) (fidx i64)] (-> i64)
  (let [(mut i) start]
    (loop (if (>= (load i) (primitive/cast i64 argc))
              (break)
              (let [arg (cstr->slice (load (primitive/index argv (load i))))]
                (cond (= arg "--") (break)
                      (= (load i) fidx) (do (store! i (primitive/iadd (load i) 1)) 0)
                      (is-flag? arg)
                        (if (flag-known? arg)
                            (do
                              (store! i (primitive/iadd (load i) (if (flag-takes-value? arg) 2 1)))
                              0)
                            (let [w (stderr)]
                              (ps w "error: unknown flag '")
                              (ps w arg)
                              (ps w "'")
                              (wb w 10)
                              (exit 1)
                              0))
                      :else
                        (let [w (stderr)]
                          (ps w "error: unexpected argument '")
                          (ps w arg)
                          (ps w "'")
                          (wb w 10)
                          (exit 1)
                          0))))))
  0)

(defn dir? [(path (ptr i8))] (-> bool)
  (let [d (opendir path)]
    (if (= (primitive/cast i64 d) (primitive/cast i64 0)) false (do (closedir d) true))))
; The arch component of a triple = the text before the first '-' (`x86_64` of
; `x86_64-apple-macosx11.0.0`). Empty triple would be caught by the null guard first.
(defn triple-arch [(triple (ptr i8))] (-> (slice u8))
  (let [s (cstr->slice triple)
        n (slice-len [u8] s)
        (mut i) 0]
    (loop (if (or (>= (load i) n)
                  (= (primitive/cast i64 (slice-get [u8] s (load i))) (primitive/cast i64 45)))
              (break)
              (store! i (primitive/iadd (load i) 1))))
    (subslice [u8] s 0 (load i))))

; A `--target <triple>` whose object arch differs from the host's. The host `cc`
; defaults to producing arm64 Mach-O, so linking such an object raw dies with
; `found architecture 'x86_64', required arm64`. The fix is to pass `-arch <arch>`
; to the link step (macOS `cc` cross-links every slice its SDK carries), which this
; predicate gates. A wasm32 target never touches `cc` (wasm-link-object finalizes it
; in-process) and a null triple is the host default — neither needs `-arch`.
(defn native-cross-target? [(triple (ptr i8))] (-> bool)
  (if (or (= (primitive/cast i64 triple) (primitive/cast i64 0)) (wasm-target? triple))
      false
      (let [arch (triple-arch triple)]
        (not (or (= arch "arm64") (= arch "aarch64"))))))

; `-g` packaging (Mach-O): the DWARF lives in the kept `<out>.o`; `ld` records a debug
; map into the executable pointing at it. `dsymutil` gathers a `<out>.dSYM` next to the
; exe from that map + the .o's DWARF, which is what lldb loads. Best-effort: a failure
; (e.g. no dsymutil) is a warning — the DWARF is still in the .o. The arm64 backend now
; emits the __text-relative address RELOCATIONS dsymutil needs (without them it printed
; "No valid relocations found. Skipping." and produced an empty dSYM — tool-11).
(defn run-dsymutil [(a (ptr Allocator)) (out (slice u8))] (-> i64)
  ; ELF has no debug map / dSYM: the DWARF is linked into the executable itself and
  ; debuggers read it directly, so on a Linux host there is nothing to gather.
  (unless (me-host-linux?)
    (let [(mut db) (sb-new a)]
      (sb-push-str! (mut db) "dsymutil ")
      (sb-push-str! (mut db) out)
      (let [drc (primitive/cast i64 (system (str->cstr a (sb-str (load db)))))]
        (when (!= drc (primitive/cast i64 0))
          (ps (stderr) "warning: dsymutil failed; debug info stays in ")
          (ps (stderr) out)
          (ps (stderr) ".o\n")
          0)))))

; `build <file> -o <out> [--link-flag X]...` : emit `<out>.o` then link it into a
; native executable with `cc <out>.o -o <out> <link-flags...>`. Mirrors the
; `coil build` argv handling + link step.
(defn object-needs-curl? [(a (ptr Allocator)) (obj (slice u8))] (-> bool)
  (let [(mut cmd) (sb-new a)]
    (sb-push-str! (mut cmd) "nm -u ")
    (m-shell-quoted! (mut cmd) obj)
    (sb-push-str! (mut cmd) " 2>/dev/null | grep -q curl_easy_init")
    (= (wait-code (primitive/cast i64 (system (str->cstr a (sb-str (load cmd)))))) (primitive/cast i64 0))))

(defn bundled-curl-archive [(a (ptr Allocator)) (self (slice u8))] (-> (slice u8))
  (let [arch (if (me-host-linux?) "x86_64-linux" "arm64-macos")]
    (cat3-d a (cat3-d a (dirname (m-resolve-self a self)) "/native/curl/") (cat3-d a arch "/libcurl.a"))))

(defn append-bundled-curl! [(a (ptr Allocator))
                            (cmd (mut StrBuf))
                            (self (slice u8))
                            (obj (slice u8))] (-> i64)
  (when (object-needs-curl? a obj)
    (let [archive (bundled-curl-archive a self)
          fd (open (str->cstr a archive) 0)]
      (when (< (primitive/cast i64 fd) (primitive/cast i64 0))
        (ps (stderr) "error: http_client.coil needs Coil's bundled libcurl; run scripts/native/build-curl.sh\n")
        (exit 1)
        0)
      (close fd)
      (sb-push-str! (mut cmd) " ")
      (m-shell-quoted! (mut cmd) archive)
      (let [dir (dirname archive)]
        (sb-push-str! (mut cmd) " ")
        (m-shell-quoted! (mut cmd) (cat3-d a dir "/libmbedtls.a"))
        (sb-push-str! (mut cmd) " ")
        (m-shell-quoted! (mut cmd) (cat3-d a dir "/libmbedx509.a"))
        (sb-push-str! (mut cmd) " ")
        (m-shell-quoted! (mut cmd) (cat3-d a dir "/libmbedcrypto.a")))
      (if (me-host-linux?)
          (sb-push-str! (mut cmd) " -lpthread -Wl,--gc-sections")
          (sb-push-str! (mut cmd)
                        " -framework CoreFoundation -framework SystemConfiguration -lz -Wl,-dead_strip"))))
  0)

(defn build-cmd [(a (ptr Allocator))
                 (argc i32)
                 (argv (ptr (ptr i8)))
                 (build-fn (fnptr c [(ptr Allocator) (slice u8) (slice u8) (ptr i8) (ptr i8) (slice u8)] i64))
                 (emitir-fn (fnptr c [(ptr Allocator) (slice u8) (slice u8) (ptr i8) (slice u8)] i64))
                 (default-backend i64)] (-> i64)
  (let [fidx (argv-file-idx argc argv 2)
        _rej (argv-reject-unknown argc argv 2 fidx)
        file (load (primitive/index argv fidx))
        (mut outp) (primitive/cast (ptr i8) 0)
        (mut flags) (al-new [(slice u8)] a)
        (mut backend) default-backend
        (mut trip) (primitive/cast (ptr i8) 0)
        (mut libmode) 0  ; 0 = executable, 1 = --lib (.a), 2 = --shared (.dylib)
        (mut ehdr) (None [(slice u8)])
        (mut wantg) false  ; -g/--debug requested: gather a .dSYM after linking
        (mut i) 2]
    ; second pass: --lib / --shared / --emit-header <h> / -g (DWARF via the arm64
    ; debug backend, which always emits DWARF).
    (let [(mut j) 2]
      (loop (if (>= (load j) (primitive/cast i64 argc))
                (break)
                (do
                  (let [arg (cstr->slice (load (primitive/index argv (load j))))]
                    (cond (= arg "--lib") (store! libmode 1)
                          (= arg "--shared") (store! libmode 2)
                          (or (= arg "-g") (= arg "--debug")) (do (store! backend 2) (store! wantg true) 0)
                          (= arg "--debug-checks") (enable-debug-checks!)
                          (= arg "--debug-runtime") (enable-debug-runtime!)
                          (= arg "--quiet") (set-quiet! true)
                          (sanitizer-flag? arg) (apply-sanitizer-flag! arg)
                          (opt-flag? arg) (apply-opt-flag! arg)
                          (meta-opt-flag? arg) (apply-meta-opt-flag! arg)
                          (starts-with arg "--wasm-stack-size=") (apply-wasm-stack-flag! arg)
                          (and (< (primitive/iadd (load j) 1) (primitive/cast i64 argc))
                               (= arg "--emit-header"))
                            (do
                              (store! ehdr
                                      (Some (cstr->slice (load (primitive/index argv
                                                                                (primitive/iadd (load j)
                                                                                                1))))))
                              0)
                          :else 0))
                  (store! j (primitive/iadd (load j) 1))))))
    ; parse -o / --link-flag / -l<lib> / --backend / --target from argv[3..].
    (loop (if (>= (load i) (primitive/cast i64 argc))
              (break)
              (do
                (let [arg (cstr->slice (load (primitive/index argv (load i))))]
                  (cond (= arg "-o")
                          (do
                            (store! outp
                                    (load (primitive/index argv
                                                           (primitive/iadd (load i) 1))))
                            (store! i (primitive/iadd (load i) 2))
                            0)
                        (= arg "--link-flag")
                          (do
                            (al-push! (mut flags)
                                      (cstr->slice (load (primitive/index argv
                                                                          (primitive/iadd (load i)
                                                                                          1)))))
                            (store! i (primitive/iadd (load i) 2))
                            0)
                        (= arg "--target")
                          (do
                            (store! trip
                                    (load (primitive/index argv
                                                           (primitive/iadd (load i) 1))))
                            (store! i (primitive/iadd (load i) 2))
                            0)
                        (= arg "--use")
                          (do
                            (cli-use-add (cstr->slice (load (primitive/index argv
                                                                             (primitive/iadd (load i)
                                                                                             1)))))
                            (store! i (primitive/iadd (load i) 2))
                            0)
                        (and (>= (slice-len [u8] arg) (primitive/cast i64 2))
                             (and (= (slice-get [u8] arg 0) (primitive/cast u8 45))
                                  (= (slice-get [u8] arg 1) (primitive/cast u8 108))))
                          (do (al-push! (mut flags) arg) (store! i (primitive/iadd (load i) 1)) 0)
                        ; -l<lib>
                        (= arg "--backend")
                          (do
                            (let [bn
                                    (cstr->slice (load (primitive/index argv
                                                                        (primitive/iadd (load i) 1))))]
                              (if (= bn "arm64")
                                  (store! backend 2)
                                  (if (= bn "wasm")
                                      (store! backend 4)  ; native wasm64 (memory64) backend
                                      (if (or (= bn "x64") (= bn "x86_64"))
                                          (store! backend 5)  ; native x86-64 (ELF) backend
                                          (store! backend 1)))))
                            (store! i (primitive/iadd (load i) 2))
                            0)
                        (= arg "--wasm-side-module")
                          (do (set-wasm-side-module! true) (store! i (primitive/iadd (load i) 1)) 0)
                        :else (do (store! i (primitive/iadd (load i) 1)) 0))))))
    ; a usage mistake is exit 1, not SIGABRT — abort here made `coil build f.coil`
    ; look like the compiler had panicked, and any CI reporting on signals agreed.
    (when (= (primitive/cast i64 (load outp)) (primitive/cast i64 0))
      (ps (stderr) "error: build: missing -o <out>\n")
      (exit 1)
      0)
    ; `-o /dev/null` is the classic "just tell me if it compiles" idiom. There is no
    ; writable object destination, and handing it to codegen abends with a bare
    ; `LLVMTargetMachineEmitToFile ... Operation not permitted` (SIGABRT). Route it to the
    ; compile-check path instead — the full front-end, no object, located errors, exit 0
    ; on success — and `exit` before the pipeline/link machinery ever runs. (diag-12)
    (when (= (cstr->slice (load outp)) "/dev/null")
      (ps (stderr) "note: -o /dev/null: compile-check only, no object written\n")
      (set-target-arch! (load trip))
      (set-meta-link-flags! (filter-meta-link-flags a (load flags)))
      (exit (primitive/cast i32
                            (when (= (run-dump-on-big-stack a
                                                            (read-src a file)
                                                            (cwd-slice a)
                                                            (cstr->slice file)
                                                            (primitive/fnptr-of check-src-program))
                                     (primitive/cast i64 0))
                              1)))
      0)
    ; Sanitizers need the LLVM backend (the native arm64 backend emits
    ; Mach-O directly, with no instrumentation pass) — reject the combination loudly
    ; rather than silently produce an UNinstrumented binary. When accepted, the
    ; program is instrument-LINKED with -fsanitize=address; the meta-link filter keeps
    ; that flag off the compiler's own metaprogram dylib (mem-7).
    (when (sanitizer?)
      (if (!= (load backend) (primitive/cast i64 1))
          (do
            (ps (stderr)
                "error: --sanitize requires the LLVM backend (not --backend arm64, -g, or the LLVM-free compiler)\n")
            (exit 1)
            0)
          (do
            (when (and (= (sanitize-mode) (primitive/cast i64 3)) (not (me-host-linux?)))
              (ps (stderr)
                  "error: --sanitize=memory is supported only on Linux (this LLVM has no Darwin MSan runtime)\n")
              (exit 1)
              0)
            (al-push! (mut flags) (sanitizer-link-flag)))))
    (let [out-slice (cstr->slice (load outp))
          obj-slice (obj-path a out-slice)]
      ; the native wasm backend emits a FINAL module (no link step), so it writes
      ; straight to the -o path; every other backend writes an intermediate <out>.o.
      (let [obj-cstr (str->cstr a (if (= (load backend) (primitive/cast i64 4)) out-slice obj-slice))
            ctx (alloc/stack DumpCtx)]
        (store! (field ctx a) a)
        (store! (field ctx src) (read-src a file))
        (store! (field ctx cwd) (cwd-slice a))
        (store! (field ctx path) (cstr->slice file))
        (store! (field ctx mode) (load backend))
        (store! (field ctx obj) obj-cstr)
        (store! (field ctx triple) (load trip))
        (set-target-arch! (load trip))
        (store! (field ctx ok) 0)
        (store! (field ctx build-fn) build-fn)
        (store! (field ctx emitir-fn) emitir-fn)
        ; metaprogram dylibs link the SAME flags as the program (FFI frameworks) —
        ; MINUS sanitizer flags, which would abort the compiler once the dylib is
        ; dlopen'd into it ("interceptors … loaded too late"). (mem-7)
        (set-meta-link-flags! (filter-meta-link-flags a (load flags)))
        ; HALT on a compile error: run-on-big-stack returns 0 when the pipeline
        ; reported a diagnostic — it was already printed;
        ; return FAILURE (1) BEFORE the link step so no spurious `cc: no such
        ; file` / undefined-symbol junk is ever emitted.
        (if (= (run-on-big-stack ctx) (primitive/cast i64 0))
            1
            ; native wasm backend: the module written by build-wasm-program IS the final
            ; artifact — no cc/ar/finalizer step. Report and stop.
            (if (= (load backend) (primitive/cast i64 4))
                (do (unless (quiet?) (let [w (stdout)] (ps w "wrote ") (ps w out-slice) (wb w 10)) 0) 0)
                ; final step depends on libmode: exe = `cc obj -o out flags`,
                ; static = `ar rcs out obj`, shared = `cc -dynamiclib obj -o out flags`.
                (let [(mut cmdsb) (sb-new a)]
                  (if (= (load libmode) (primitive/cast i64 1))
                      (do
                        (sb-push-str! (mut cmdsb) "ar rcs ")
                        (sb-push-str! (mut cmdsb) out-slice)
                        (sb-push-str! (mut cmdsb) " ")
                        (sb-push-str! (mut cmdsb) obj-slice)
                        0)
                      (do
                        (sb-push-str! (mut cmdsb)
                                      (if (= (load libmode) (primitive/cast i64 2))
                                          (me-dylib-link-cmd)
                                          (if (sanitizer?)
                                              ; LLVM's ASan pass and runtime must be the
                                              ; same version. `cc` is Apple clang on macOS
                                              ; even when Coil is linked to Homebrew LLVM.
                                              ; llvm-config names the matching toolchain.
                                              "\"$(llvm-config --bindir)/clang\" "
                                              "cc ")))
                        ; cross-target: the object's arch differs from the host cc's default
                        ; (arm64), so pass `-arch <arch>` — otherwise ld dies with
                        ; `found architecture '<arch>', required arm64` (xcompile). wasm never
                        ; reaches here; a null/host triple is not a cross-target. `-arch` is a
                        ; Mach-O-toolchain flag: on an ELF host it is not passed (cross-LINKING
                        ; there needs a cross toolchain the driver does not orchestrate).
                        (when (and (native-cross-target? (load trip)) (not (me-host-linux?)))
                          (sb-push-str! (mut cmdsb) "-arch ")
                          (sb-push-str! (mut cmdsb) (triple-arch (load trip)))
                          (sb-push-str! (mut cmdsb) " ")
                          0)
                        (sb-push-str! (mut cmdsb) obj-slice)
                        (sb-push-str! (mut cmdsb) " -o ")
                        (sb-push-str! (mut cmdsb) out-slice)
                        (let [linkflags (dedupe-link-flags a (load flags))
                              (mut k) 0
                              nf (al-len [(slice u8)] (load linkflags))]
                          (loop (if (>= (load k) nf)
                                    (break)
                                    (do
                                      (sb-push-str! (mut cmdsb) " ")
                                      (sb-push-str! (mut cmdsb)
                                                    (al-get [(slice u8)] (load linkflags) (load k)))
                                      (store! k (primitive/iadd (load k) 1))))))
                        (append-bundled-curl! a
                                              (mut cmdsb)
                                              (cstr->slice (load (primitive/index argv 0)))
                                              obj-slice)
                        ; The x86-64 backend lowers `frem` to a libm fmod/fmodf call
                        ; (SSE has no remainder instruction, and the LLVM backend
                        ; expands frem itself). glibc keeps those in libm, which cc
                        ; does not link by default — so this build needs -lm. It is
                        ; harmless when nothing references it.
                        (when (= (load backend) (primitive/cast i64 5)) (sb-push-str! (mut cmdsb) " -lm") 0)
                        0))
                  (let [rc
                          (if (wasm-target? (load trip))
                              (wasm-link-object a obj-cstr out-slice)
                              (primitive/cast i64 (system (str->cstr a (sb-str (load cmdsb))))))]
                    (if (!= rc (primitive/cast i64 0))
                        (let [w (stderr)
                              code (wait-code rc)]
                          (wait-report rc "linker")
                          (ps w "error: linker/ar failed with exit status: ")
                          (dump-dec w code)
                          (wb w 10)
                          ; The linker's own "Undefined symbols" list says WHAT is missing
                          ; and never how to supply it, which reliably reads as a compiler
                          ; fault rather than a missing link input. Name the two ways.
                          (ps w "note: if those symbols come from a native library, declare it in Coil.toml\n")
                          (ps w "      [link] flags = [\"-Wl,-force_load,path/to/lib.a\", \"-framework\", \"Foo\"]\n")
                          (ps w "      (applied to `coil build`, `coil run` and `coil test` alike), or pass\n")
                          (ps w "      --link-flag on the command line.\n")
                          1)
                        (do
                          (unless (quiet?) (let [w (stdout)] (ps w "wrote ") (ps w out-slice) (wb w 10)) 0)
                          ; -g on a native executable: gather the .dSYM (the .o is kept).
                          (when (and (load wantg)
                                     (and (not (wasm-target? (load trip)))
                                          (= (load libmode) (primitive/cast i64 0))))
                            (run-dsymutil a out-slice))
                          (match ehdr
                            (Some [h] (cheader-program a (read-src a file) (dirname (cstr->slice file)) (Some h)))
                            (None [] 0))))))))))))

; ============================ cheader (export-c → C header) =================
; Port of — the inverse of cimport: emit a C header (prototypes +
; typedef structs) for a program's (export-c …) set.

(defn ch-cname [(a (ptr Allocator)) (qualified (slice u8))] (-> (slice u8))
  (let [n (slice-len [u8] qualified)
        (mut cut) 0
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (when (= (slice-get [u8] qualified (load i)) (primitive/cast u8 46))
                  (store! cut (primitive/iadd (load i) 1)))
                (store! i (primitive/iadd (load i) 1)))))
    (let [(mut out) (sb-new a)
          (mut k) (load cut)]
      (loop (if (>= (load k) n)
                (break)
                (do
                  (let [c (slice-get [u8] qualified (load k))]
                    (sb-push-byte! (mut out) (if (= c (primitive/cast u8 45)) (primitive/cast u8 95) c)))
                  (store! k (primitive/iadd (load k) 1)))))
      (sb-str (load out)))))

(defn ch-ctype [(a (ptr Allocator)) (t Type) (is-return bool)] (-> (Result (slice u8) (slice u8)))
  (match t
    (TInt [bits signed]
          (if (or (= bits (primitive/cast i64 8))
                  (or (= bits (primitive/cast i64 16))
                      (or (= bits (primitive/cast i64 32)) (= bits (primitive/cast i64 64)))))
              (Ok (cat3-d a (if signed "int" "uint") (cat3-d a (i64->str a bits) "_t")))
              (Err (cat3-d a
                           "cheader: i"
                           (cat3-d a (i64->str a bits) " has no standard C type (use 8/16/32/64-bit)")))))
    (TFloat [bits] (Ok (if (= bits (primitive/cast i64 32)) "float" "double")))
    (TBool [] (Ok "bool"))
    (TVoid [] (if is-return (Ok "void") (Err "cheader: void has no C representation")))
    (TPtr [inner]
          (match (ch-ctype a (load inner) false) (Ok [s] (Ok (cat3-d a s " *"))) (Err [e] (Err e))))
    (TStruct [name] (Ok (ch-cname a name)))
    (_ (Err "cheader: type has no C representation"))))

(defn ch-find-struct [(p (ptr Program)) (name (slice u8))] (-> (ptr StructDef))
  (let [ss (load (field p structs))
        n (al-len [StructDef] ss)
        (mut i) 0
        (mut r) (primitive/cast (ptr StructDef) 0)]
    (loop (if (>= (load i) n)
              (break)
              (do
                (when (= (load (field (al-elem [StructDef] ss (load i)) name)) name)
                  (store! r (al-elem [StructDef] ss (load i)))
                  (break))
                (store! i (primitive/iadd (load i) 1)))))
    (load r)))

; collect reachable structs (dependency-first): by-value fields recurse before the
; containing struct; pointer fields only need the forward decl.
(defn ch-collect [(a (ptr Allocator))
                  (t Type)
                  (p (ptr Program))
                  (order (ptr (ArrayList (slice u8))))
                  (seen (ptr (HashMap (slice u8) i64)))] (-> i64)
  (match t
    (TStruct [name]
             (match (hm-get [(slice u8) i64] (load seen) name)
               (Some [_] 0)
               (None []
                     (do
                       (hm-put! [(slice u8) i64] seen name 1)
                       (let [sd (ch-find-struct p name)]
                         (unless (= (primitive/cast i64 sd) (primitive/cast i64 0))
                           (let [fs (load (field sd fields))
                                 n (al-len [Field] fs)
                                 (mut i) 0]
                             (loop (if (>= (load i) n)
                                       (break)
                                       (do
                                         (match (load (field (al-elem [Field]
                                                                      fs
                                                                      (load i))
                                                             ty))
                                           (TPtr [_] 0)
                                           (TArray [elem _]
                                                   (ch-collect a (load elem) p order seen))
                                           (_ (ch-collect a
                                                          (load (field (al-elem [Field]
                                                                                fs
                                                                                (load i))
                                                                       ty))
                                                          p
                                                          order
                                                          seen)))
                                         (store! i (primitive/iadd (load i) 1))))))))
                       (al-push! [(slice u8)] order name)
                       0))))
    (TPtr [inner] (ch-collect a (load inner) p order seen))
    (TArray [inner _] (ch-collect a (load inner) p order seen))
    (_ 0)))

(defn ch-render-struct [(a (ptr Allocator)) (sd (ptr StructDef))] (-> (Result (slice u8) (slice u8)))
  (let [tag (ch-cname a (load (field sd name)))
        attr
          (match (load (field sd layout))
            (LPacked [] " __attribute__((__packed__))")
            (LC [] "")
            (LAligned [_] "")
            (_ "BAD"))]
    (if (= attr "BAD")
        (Err (cat3-d a
                     "cheader: struct '"
                     (cat3-d a
                             tag
                             "' has an :explicit/:bits layout the header generator can't emit; export a :c-layout struct")))
        (let [(mut out) (sb-new a)
              (mut err) (None [(slice u8)])]
          (sb-push-str! (mut out) (cat3-d a (cat3-d a "struct" attr) (cat3-d a " " (cat3-d a tag " {\n"))))
          (let [fs (load (field sd fields))
                n (al-len [Field] fs)
                (mut i) 0]
            (loop (if (>= (load i) n)
                      (break)
                      (let [fp (al-elem [Field] fs (load i))
                            fn2 (ch-cname a (load (field fp name)))]
                        (match (load (field fp ty))
                          (TArray [elem k]
                                  (match (ch-ctype a (load elem) false)
                                    (Err [e] (do (store! err (Some e)) (break)))
                                    (Ok [ct]
                                        (sb-push-str! (mut out)
                                                      (cat3-d a
                                                              (cat3-d a "    " ct)
                                                              (cat3-d a
                                                                      " "
                                                                      (cat3-d a
                                                                              fn2
                                                                              (cat3-d a
                                                                                      "["
                                                                                      (cat3-d a
                                                                                              (i64->str a k)
                                                                                              "];\n")))))))))
                          (_ (match (ch-ctype a (load (field fp ty)) false)
                               (Err [e] (do (store! err (Some e)) (break)))
                               (Ok [ct]
                                   (sb-push-str! (mut out)
                                                 (cat3-d a
                                                         (cat3-d a "    " ct)
                                                         (cat3-d a " " (cat3-d a fn2 ";\n"))))))))
                        (store! i (primitive/iadd (load i) 1)))))
            (match (load err)
              (Some [e] (Err e))
              (None [] (do (sb-push-str! (mut out) "};\n") (Ok (sb-str (load out)))))))))))

; Render the full C header for the program's exports (Result text/err).
(defn cheader-render [(a (ptr Allocator)) (p (ptr Program))] (-> (Result (slice u8) (slice u8)))
  (let [order (box a (ArrayList (slice u8)) (al-new [(slice u8)] a))
        seen (box a (HashMap (slice u8) i64) (hm-new [(slice u8) i64] a (str-keyops)))
        es (load (field p exports))
        ne (al-len [ExportC] es)
        (mut protos) (sb-new a)
        (mut err) (None [(slice u8)])
        (mut i) 0]
    ; collect structs + build prototypes
    (loop (if (>= (load i) ne)
              (break)
              (let [ep (al-elem [ExportC] es (load i))
                    sym
                      (match (load (field ep symbol))
                        (Some [s] s)
                        (None [] (load (field ep name))))
                    fp (ch-find-func p (load (field ep name)))]
                (if (= (primitive/cast i64 fp) (primitive/cast i64 0))
                    (do
                      (store! err
                              (Some (cat3-d a
                                            "cheader: exported function not found: "
                                            (load (field ep name)))))
                      (break))
                    (do
                      (ch-collect a (load (field fp ret)) p order seen)
                      (let [ps (load (field ep params))
                            np (al-len [Type] ps)
                            (mut j) 0]
                        (loop (if (>= (load j) np)
                                  (break)
                                  (do
                                    (ch-collect a (al-get [Type] ps (load j)) p order seen)
                                    (store! j (primitive/iadd (load j) 1))))))
                      (match (ch-ctype a (load (field fp ret)) true)
                        (Err [e] (do (store! err (Some e)) (break)))
                        (Ok [rt]
                            (do
                              (sb-push-str! (mut protos) rt)
                              (sb-push-str! (mut protos) " ")
                              (sb-push-str! (mut protos) sym)
                              (sb-push-str! (mut protos) "(")
                              (let [ps (load (field ep params))
                                    np (al-len [Type] ps)
                                    (mut j) 0]
                                (when (= np (primitive/cast i64 0)) (sb-push-str! (mut protos) "void"))
                                (loop (if (>= (load j) np)
                                          (break)
                                          (match (ch-ctype a (al-get [Type] ps (load j)) false)
                                            (Err [e] (do (store! err (Some e)) (break)))
                                            (Ok [pt]
                                                (do
                                                  (when (> (load j) (primitive/cast i64 0))
                                                    (sb-push-str! (mut protos) ", "))
                                                  (sb-push-str! (mut protos) pt)
                                                  (store! j (primitive/iadd (load j) 1))))))))
                              (sb-push-str! (mut protos) ");\n"))))))))
      (store! i (primitive/iadd (load i) 1)))
    (match (load err)
      (Some [e] (Err e))
      (None []
            (let [(mut out) (sb-new a)
                  no (al-len [(slice u8)] (load order))]
              (sb-push-str! (mut out)
                            "/* Generated by `coil cheader`. */\n#pragma once\n#include <stdint.h>\n#include <stdbool.h>\n\n#ifdef __cplusplus\nextern \"C\" {\n#endif\n\n")
              (if (> no (primitive/cast i64 0))
                  (let [(mut k) 0
                        (mut serr) (None [(slice u8)])]
                    (loop (if (>= (load k) no)
                              (break)
                              (let [tag (ch-cname a (al-get [(slice u8)] (load order) (load k)))]
                                (sb-push-str! (mut out)
                                              (cat3-d a
                                                      (cat3-d a "typedef struct " tag)
                                                      (cat3-d a " " (cat3-d a tag ";\n"))))
                                (store! k (primitive/iadd (load k) 1)))))
                    (sb-push-str! (mut out) "\n")
                    (store! k 0)
                    (loop (if (>= (load k) no)
                              (break)
                              (match (ch-render-struct a
                                                       (ch-find-struct p
                                                                       (al-get [(slice u8)]
                                                                               (load order)
                                                                               (load k))))
                                (Err [e] (do (store! serr (Some e)) (break)))
                                (Ok [sbody]
                                    (do
                                      (sb-push-str! (mut out) sbody)
                                      (sb-push-str! (mut out) "\n")
                                      (store! k (primitive/iadd (load k) 1)))))))
                    (match (load serr)
                      (Some [e] (Err [(slice u8) (slice u8)] e))
                      (None []
                            (do
                              (sb-push-str! (mut out) (sb-str (load protos)))
                              (sb-push-str! (mut out) "\n#ifdef __cplusplus\n}\n#endif\n")
                              (Ok (sb-str (load out)))))))
                  (do
                    (sb-push-str! (mut out) (sb-str (load protos)))
                    (sb-push-str! (mut out) "\n#ifdef __cplusplus\n}\n#endif\n")
                    (Ok (sb-str (load out))))))))))

(defn ch-find-func [(p (ptr Program)) (name (slice u8))] (-> (ptr Func))
  (let [fs (load (field p funcs))
        n (al-len [Func] fs)
        (mut i) 0
        (mut r) (primitive/cast (ptr Func) 0)]
    (loop (if (>= (load i) n)
              (break)
              (do
                (when (= (load (field (al-elem [Func] fs (load i)) name)) name)
                  (store! r (al-elem [Func] fs (load i)))
                  (break))
                (store! i (primitive/iadd (load i) 1)))))
    (load r)))

; run the pipeline to a checked Program, render its C header, write to `out`
; (Some file) or stdout (None). Returns 0 on success, 1 on error.
(defn cheader-program [(a (ptr Allocator)) (src (slice u8)) (cwd (slice u8)) (out (Option (slice u8)))] (-> i64)
  (let [s (alloc/stack LS)]
    (ls-init! (mut s) a)
    (store! (field s srccount) 1)
    (register-source! (mut s) "<source>" src)
    (match (read-all a src 0)
      (Err [d] (let [dp (alloc/stack Diag)] (store! dp d) (dump-error (stderr) dp) 1))
      (Ok [forms]
          (do
            (namespace-index-build! (mut s))
            (load-program (mut s) (prepend-uses a (mut s) forms) cwd)
            (if (ls-err? (mut s))
                (let [dp (alloc/stack Diag)]
                  (store! dp (load (field s loaderr)))
                  (dump-error (stderr) dp)
                  1)
                (match (resolve-program a (mut s) true false)
                  (Err [d] (let [dp (alloc/stack Diag)] (store! dp d) (dump-error (stderr) dp) 1))
                  (Ok [prog]
                      (match (check-program a prog (mut s))
                        (Err [d] (let [dp (alloc/stack Diag)] (store! dp d) (dump-error (stderr) dp) 1))
                        (Ok [cp]
                            (match (cheader-render a cp)
                              (Err [e] (do (ps (stderr) "error: ") (ps (stderr) e) (wb (stderr) 10) 1))
                              (Ok [hdr]
                                  (match out
                                    (None [] (do (ps (stdout) hdr) 0))
                                    (Some [o]
                                          (do
                                            (d-write-file a o hdr)
                                            (let [w (stdout)] (ps w "wrote ") (ps w o) (wb w 10))
                                            0)))))))))))))))

; ============================ Coil.toml manifest ============================
; `coil build` / `coil run` with no source file read ./Coil.toml and expand it
; into the flags the CLI already accepts. Deliberately
; tiny: a line-based reader for the project sections below.

(defn m-ws? [(c u8)] (-> bool)
  (or (= c (primitive/cast u8 32))
      (or (= c (primitive/cast u8 9))
          (or (= c (primitive/cast u8 10)) (= c (primitive/cast u8 13))))))
(defn m-trim [(s (slice u8))] (-> (slice u8))
  (let [n (slice-len [u8] s)
        (mut lo) 0
        (mut hi) n]
    (loop (if (and (< (load lo) (load hi))
                   (m-ws? (slice-get [u8] s (load lo))))
              (store! lo (primitive/iadd (load lo) 1))
              (break)))
    (loop (if (and (< (load lo) (load hi))
                   (m-ws? (slice-get [u8] s (primitive/isub (load hi) 1))))
              (store! hi (primitive/isub (load hi) 1))
              (break)))
    (subslice [u8] s (load lo) (load hi))))
(defn m-unquote [(s (slice u8))] (-> (slice u8))
  (let [n (slice-len [u8] s)]
    (if (and (>= n (primitive/cast i64 2))
             (and (= (slice-get [u8] s 0) (primitive/cast u8 34))
                  (= (slice-get [u8] s (primitive/isub n 1)) (primitive/cast u8 34))))
        (subslice [u8] s 1 (primitive/isub n 1))
        s)))

; lines of a text (split on \n).
(defn m-lines [(a (ptr Allocator)) (text (slice u8))] (-> (ptr (ArrayList (slice u8))))
  (let [out (box a (ArrayList (slice u8)) (al-new [(slice u8)] a))
        n (slice-len [u8] text)
        (mut start) 0
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (when (= (slice-get [u8] text (load i)) (primitive/cast u8 10))
                  (al-push! [(slice u8)] out (subslice [u8] text (load start) (load i)))
                  (store! start (primitive/iadd (load i) 1))
                  0)
                (store! i (primitive/iadd (load i) 1)))))
    (when (< (load start) n)
      (al-push! [(slice u8)] out (subslice [u8] text (load start) n)))
    out))

; append the string elements of a TOML array literal `["a", "b"]` to `dst`.
; Commas inside a quoted string belong to that element (notably linker flags such
; as `-Wl,-force_load,archive.a`).  Honor backslash escapes while deciding whether
; a quote closes the string; m-unquote deliberately leaves the contents otherwise
; untouched for the downstream command-line builder.
(defn m-parse-array [(a (ptr Allocator)) (val (slice u8)) (dst (ptr (ArrayList (slice u8))))] (-> i64)
  (let [n (slice-len [u8] val)
        inner (if (>= n (primitive/cast i64 2)) (subslice [u8] val 1 (primitive/isub n 1)) val)  ; strip [ ]
        (mut start) 0
        (mut j) 0
        (mut quoted) false
        (mut escaped) false
        m (slice-len [u8] inner)]
    (loop (if (> (load j) m)
              (break)
              (if (or (= (load j) m)
                      (and (not (load quoted))
                           (= (slice-get [u8] inner (load j)) (primitive/cast u8 44))))  ; unquoted ',' or end
                  (let [piece (m-trim (subslice [u8] inner (load start) (load j)))]
                    (when (> (slice-len [u8] piece) (primitive/cast i64 0))
                      (al-push! [(slice u8)] dst (m-unquote piece)))
                    (store! start (primitive/iadd (load j) 1))
                    (store! j (primitive/iadd (load j) 1)))
                  (let [c (slice-get [u8] inner (load j))]
                    (if (load quoted)
                        (if (load escaped)
                            (store! escaped false)
                            (if (= c (primitive/cast u8 92))
                                (store! escaped true)
                                (when (= c (primitive/cast u8 34)) (store! quoted false) 0)))
                        (when (= c (primitive/cast u8 34)) (store! quoted true) 0))
                    (store! j (primitive/iadd (load j) 1))))))
    0))

; Strict manifest validation (tool-12): the reader knows exactly six sections
; and a fixed key set per non-dependency section. A typo'd section/key is a
; LOCATED hard error, not a silent no-op.
(defn m-known-section? [(s (slice u8))] (-> bool)
  (or (= s "package")
      (or (= s "dependencies")
          (or (= s "build")
              (or (= s "link")
                  (or (= s "cc")
                      (or (= s "run")
                          (or (= s "test")
                              (or (= s "lint")
                                  (or (= s "metaprograms") (= s "native-dependencies")))))))))))
; `[test.suites.<name>]` is the one nested section the reader understands. The header
; text arrives verbatim, so the suite name is whatever follows the prefix.
(defn m-suite-section? [(s (slice u8))] (-> bool)
  (starts-with s "test.suites."))
(defn m-suite-section-name [(s (slice u8))] (-> (slice u8))
  (subslice [u8] s (slice-len [u8] "test.suites.") (slice-len [u8] s)))
; Suite names reach `--suite` and the [opt-in] listing, so keep them to the identifier
; shape a shell and a human both read without quoting.
(defn m-suite-name? [(s (slice u8))] (-> bool)
  (let [n (slice-len [u8] s)
        (mut ok) (> n (primitive/cast i64 0))
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (let [c (slice-get [u8] s (load i))]
                (unless (or (and (>= c (primitive/cast u8 97)) (<= c (primitive/cast u8 122)))
                            (or (and (>= c (primitive/cast u8 65)) (<= c (primitive/cast u8 90)))
                                (or (and (>= c (primitive/cast u8 48)) (<= c (primitive/cast u8 57)))
                                    (or (= c (primitive/cast u8 45)) (= c (primitive/cast u8 95))))))
                  (store! ok false)
                  0)
                (store! i (primitive/iadd (load i) 1)))))
    (load ok)))

(defn m-err [(a (ptr Allocator)) (lineno i64) (msg (slice u8))] (-> i64)
  (let [w (stderr)]
    (ps w "error: Coil.toml:")
    (ps w (i64->str a lineno))
    (ps w ": ")
    (ps w msg)
    (wb w 10)
    (exit 1)
    0))
(defn m-bad-key [(a (ptr Allocator)) (lineno i64) (section (slice u8)) (key (slice u8))] (-> i64)
  (m-err a lineno (cat3-d a "unknown key '" (cat3-d a key (cat3-d a "' in [" (cat3-d a section "] section"))))))

(defstruct ManifestDep
  [(name (slice u8))
   (path (slice u8))
   (git (slice u8))
   (sha (slice u8))
   (resolved (slice u8))
   (line i64)])

(defstruct ManifestNativeDep [(name (slice u8)) (pkg (slice u8)) (line i64)])

(defn m-parse-native-dep [(a (ptr Allocator))
                          (dst (ptr (ArrayList ManifestNativeDep)))
                          (name (slice u8))
                          (val (slice u8))
                          (ln i64)] (-> i64)
  (match (m-dep-field val "pkg-config")
    (Some [pkg]
          (do
            (unless (and (m-dep-name? name) (m-shell-value? pkg))
              (m-err a ln "invalid native dependency name or pkg-config package"))
            (let [d (alloc/stack ManifestNativeDep)]
              (store! (field d name) name)
              (store! (field d pkg) pkg)
              (store! (field d line) ln)
              (al-push! [ManifestNativeDep] dst (load d)))
            0))
    (None [] (m-err a ln "native dependency must specify { pkg-config = \"package\" }"))))

(defn m-dep-name? [(s (slice u8))] (-> bool)
  (let [n (slice-len s)
        (mut i) 0
        (mut ok) (> n (primitive/cast i64 0))]
    (loop (if (or (not (load ok)) (>= (load i) n))
              (break)
              (let [c (primitive/cast i64 (slice-get s (load i)))]
                (if (or (and (>= c (primitive/cast i64 97)) (<= c (primitive/cast i64 122)))
                        (or (and (>= c (primitive/cast i64 65)) (<= c (primitive/cast i64 90)))
                            (or (and (>= c (primitive/cast i64 48)) (<= c (primitive/cast i64 57)))
                                (or (= c (primitive/cast i64 45)) (= c (primitive/cast i64 95))))))
                    (store! i (primitive/iadd (load i) 1))
                    (store! ok false)))))
    (load ok)))

(defn m-sha? [(s (slice u8))] (-> bool)
  (let [n (slice-len s)
        (mut i) 0
        (mut ok) (or (= n (primitive/cast i64 40)) (= n (primitive/cast i64 64)))]
    (loop (if (or (not (load ok)) (>= (load i) n))
              (break)
              (let [c (primitive/cast i64 (slice-get s (load i)))]
                (if (or (and (>= c (primitive/cast i64 48)) (<= c (primitive/cast i64 57)))
                        (or (and (>= c (primitive/cast i64 97)) (<= c (primitive/cast i64 102)))
                            (and (>= c (primitive/cast i64 65)) (<= c (primitive/cast i64 70)))))
                    (store! i (primitive/iadd (load i) 1))
                    (store! ok false)))))
    (load ok)))

; Shell commands below single-quote dependency values. Reject the only bytes that
; could terminate that quoting (or split a command) instead of trying to invent a
; second escaping language inside the deliberately-small manifest reader.
(defn m-shell-value? [(s (slice u8))] (-> bool)
  (let [n (slice-len s)
        (mut i) 0
        (mut ok) true]
    (loop (if (or (not (load ok)) (>= (load i) n))
              (break)
              (let [c (primitive/cast i64 (slice-get s (load i)))]
                (if (or (= c (primitive/cast i64 0))
                        (or (= c (primitive/cast i64 10))
                            (or (= c (primitive/cast i64 13)) (= c (primitive/cast i64 39)))))
                    (store! ok false)
                    (store! i (primitive/iadd (load i) 1))))))
    (load ok)))

; Look up one `key = "value"` in a dependency's inline table. Dependency URLs
; and paths may contain '='; only the first one in each comma-delimited field is
; structural.
(defn m-dep-field [(val (slice u8)) (wanted (slice u8))] (-> (Option (slice u8)))
  (let [n (slice-len val)
        inner
          (if (and (>= n (primitive/cast i64 2))
                   (and (= (primitive/cast i64 (slice-get val 0)) (primitive/cast i64 123))
                        (= (primitive/cast i64 (slice-get val (primitive/isub n 1))) (primitive/cast i64 125))))
              (subslice val 1 (primitive/isub n 1))
              val)
        m (slice-len inner)
        (mut start) 0
        (mut j) 0
        (mut out) (None [(slice u8)])]
    (loop (if (or (> (load j) m) (match (load out) (Some [_] true) (None [] false)))
              (break)
              (if (or (= (load j) m)
                      (= (primitive/cast i64 (slice-get inner (load j))) (primitive/cast i64 44)))
                  (let [piece (m-trim (subslice inner (load start) (load j)))
                        eq (m-index piece (primitive/cast u8 61))]
                    (when (>= eq (primitive/cast i64 0))
                      (let [key (m-trim (subslice piece 0 eq))
                            fieldval (m-unquote (m-trim (subslice piece (primitive/iadd eq 1) (slice-len piece))))]
                        (when (= key wanted) (store! out (Some fieldval)))))
                    (store! start (primitive/iadd (load j) 1))
                    (store! j (primitive/iadd (load j) 1)))
                  (store! j (primitive/iadd (load j) 1)))))
    (load out)))

(defn m-validate-dep-fields [(a (ptr Allocator)) (ln i64) (val (slice u8))] (-> i64)
  (let [n (slice-len val)
        inner (subslice val 1 (primitive/isub n 1))
        m (slice-len inner)
        (mut start) 0
        (mut j) 0]
    (loop (if (> (load j) m)
              (break)
              (if (or (= (load j) m)
                      (= (primitive/cast i64 (slice-get inner (load j))) (primitive/cast i64 44)))
                  (let [piece (m-trim (subslice inner (load start) (load j)))
                        eq (m-index piece (primitive/cast u8 61))]
                    (if (< eq (primitive/cast i64 0))
                        (m-err a ln "dependency fields must use key = \"value\"")
                        (let [key (m-trim (subslice piece 0 eq))]
                          (unless (or (= key "path") (or (= key "git") (= key "sha")))
                            (m-err a ln (cat3-d a "unknown dependency field '" (cat3-d a key "'"))))))
                    (store! start (primitive/iadd (load j) 1))
                    (store! j (primitive/iadd (load j) 1)))
                  (store! j (primitive/iadd (load j) 1)))))
    0))

(defn m-parse-dep [(a (ptr Allocator))
                   (deps (ptr (ArrayList ManifestDep)))
                   (name (slice u8))
                   (val (slice u8))
                   (ln i64)] (-> i64)
  (unless (m-dep-name? name)
    (m-err a ln "dependency names may contain only letters, digits, '-' and '_'"))
  (let [nd (al-len [ManifestDep] (load deps))
        (mut di) 0]
    (loop (if (>= (load di) nd)
              (break)
              (let [old (al-get [ManifestDep] (load deps) (load di))]
                (when (= (load (field old name)) name)
                  (m-err a ln (cat3-d a "duplicate dependency '" (cat3-d a name "'"))))
                (store! di (primitive/iadd (load di) 1))))))
  (let [n (slice-len val)
        table
          (and (>= n (primitive/cast i64 2))
               (and (= (primitive/cast i64 (slice-get val 0)) (primitive/cast i64 123))
                    (= (primitive/cast i64 (slice-get val (primitive/isub n 1))) (primitive/cast i64 125))))
        (mut path) ""
        (mut git) ""
        (mut sha) ""]
    (if table
        (do
          (m-validate-dep-fields a ln val)
          (match (m-dep-field val "path") (Some [v] (store! path v)) (None [] 0))
          (match (m-dep-field val "git") (Some [v] (store! git v)) (None [] 0))
          (match (m-dep-field val "sha") (Some [v] (store! sha v)) (None [] 0))
          0)
        (store! path (m-unquote val)))
    (let [has-path (> (slice-len (load path)) (primitive/cast i64 0))
          has-git (> (slice-len (load git)) (primitive/cast i64 0))
          has-sha (> (slice-len (load sha)) (primitive/cast i64 0))]
      (unless (or (and has-path (and (not has-git) (not has-sha)))
                  (and (not has-path) (and has-git has-sha)))
        (m-err a ln "dependency must specify either path, or git together with sha"))
      (when (and has-sha (not (m-sha? (load sha))))
        (m-err a ln "git dependency sha must be a full 40- or 64-digit hexadecimal object id"))
      (unless (and (m-shell-value? (load path))
                   (and (m-shell-value? (load git)) (m-shell-value? (load sha))))
        (m-err a ln "dependency values cannot contain quotes or newlines"))
      (let [d (alloc/stack ManifestDep)]
        (store! (field d name) name)
        (store! (field d path) (load path))
        (store! (field d git) (load git))
        (store! (field d sha) (load sha))
        (store! (field d resolved) "")
        (store! (field d line) ln)
        (al-push! [ManifestDep] deps (load d))))
    0))

; A named test suite, declared as `[test.suites.<name>]`. Suites exist so a project
; can own tests that must NOT run on a bare `coil test` — live integration tests that
; hit a network service, tests that cost money, tests that take minutes. Membership is
; opt-OUT: a suite runs by default unless it declares `default = false`. That keeps
; `coil test` meaning "run the tests" for the ordinary project while giving the
; expensive suite exactly one line to hide behind.
;
; `roots-declared` records whether the suite named its own roots. A declared root that
; does not exist is a configuration error; the implicit `tests` fallback is not, because
; the compiler guessed it and a project without a tests/ directory is legitimate.
(defstruct ManifestSuite
  [(name (slice u8))
   (roots (ptr (ArrayList (slice u8))))
   (suffixes (ptr (ArrayList (slice u8))))
   (is-default bool)
   (roots-declared bool)
   (line i64)])

(defn m-new-suite [(a (ptr Allocator)) (name (slice u8)) (ln i64)] (-> (ptr ManifestSuite))
  (let [s (box a ManifestSuite (primitive/zeroed ManifestSuite))]
    (store! (field s name) name)
    (store! (field s roots)
            (let [g (unwrap-ptr [(ArrayList (slice u8))] (create [(ArrayList (slice u8))] a))]
              (store! g (al-new [(slice u8)] a))
              g))
    (store! (field s suffixes)
            (let [g (unwrap-ptr [(ArrayList (slice u8))] (create [(ArrayList (slice u8))] a))]
              (store! g (al-new [(slice u8)] a))
              g))
    (store! (field s is-default) true)
    (store! (field s roots-declared) false)
    (store! (field s line) ln)
    s))

; The suite with this name, or null. Suite counts are tiny (a handful at most), so a
; linear scan is the whole lookup structure.
(defn m-find-suite [(suites (ptr (ArrayList (ptr ManifestSuite)))) (name (slice u8))] (-> (ptr ManifestSuite))
  (let [(mut r) (primitive/cast (ptr ManifestSuite) 0)
        (mut i) 0]
    (loop (if (>= (load i) (al-len [(ptr ManifestSuite)] (load suites)))
              (break)
              (let [s (al-get [(ptr ManifestSuite)] (load suites) (load i))]
                (if (= (load (field s name)) name)
                    (do (store! r s) (break))
                    (store! i (primitive/iadd (load i) 1))))))
    (load r)))

; Append `v` unless it is already present. Used to fold every suite's suffixes into the
; one list `lint` consults to decide whether a path is a test file.
(defn m-push-unique! [(dst (ptr (ArrayList (slice u8)))) (v (slice u8))] (-> i64)
  (let [(mut found) false
        (mut i) 0]
    (loop (if (>= (load i) (al-len [(slice u8)] (load dst)))
              (break)
              (if (= (al-get [(slice u8)] (load dst) (load i)) v)
                  (do (store! found true) (break))
                  (store! i (primitive/iadd (load i) 1)))))
    (unless (load found) (al-push! [(slice u8)] dst v) 0)
    0))

(defstruct Manifest
  [(name (slice u8))
   (entry (slice u8))
   (out (slice u8))
   (target (slice u8))
   (has-target bool)
   (debug bool)
   (source-roots (ptr (ArrayList (slice u8))))
   (exclude (ptr (ArrayList (slice u8))))
   (frameworks (ptr (ArrayList (slice u8))))
   (libs (ptr (ArrayList (slice u8))))
   (flags (ptr (ArrayList (slice u8))))
   (search-paths (ptr (ArrayList (slice u8))))
   (objects (ptr (ArrayList (slice u8))))
   (rargs (ptr (ArrayList (slice u8))))
   (sources (ptr (ArrayList (slice u8))))
   (include-dirs (ptr (ArrayList (slice u8))))
   (ccflags (ptr (ArrayList (slice u8))))
   ; line of `[test].roots`, so the synthesized "default" suite can locate its errors
   (test-roots-line i64)
   (test-roots (ptr (ArrayList (slice u8))))
   (test-suffixes (ptr (ArrayList (slice u8))))
   (suites (ptr (ArrayList (ptr ManifestSuite))))
   (lint-rules (ptr (ArrayList (slice u8))))
   ; `[metaprograms] use` — namespaces loaded ahead of the entry file for every
   ; command that COMPILES this project, exactly as `--use` does on the command
   ; line. A dependency's resolved root is already on COIL_NAMESPACE_ROOTS
   ; (m-emit-dep-env), so a library can ship a transform and a consumer switches
   ; it on with one manifest line.
   (metaprograms (ptr (ArrayList (slice u8))))
   (native-deps (ptr (ArrayList ManifestNativeDep)))
   (deps (ptr (ArrayList ManifestDep)))])

(defn parse-manifest [(a (ptr Allocator)) (text (slice u8))] (-> (ptr Manifest))
  (let [m (box a Manifest (primitive/zeroed Manifest))]
    (store! (field m name) "")
    (store! (field m entry) "")
    (store! (field m out) "")
    (store! (field m target) "")
    (store! (field m has-target) false)
    (store! (field m debug) false)
    (store! (field m source-roots)
            (let [$g11760 (unwrap-ptr [(ArrayList (slice u8))] (create [(ArrayList (slice u8))] a))]
              (store! $g11760 (al-new [(slice u8)] a))
              $g11760))
    (store! (field m exclude)
            (let [$g11761 (unwrap-ptr [(ArrayList (slice u8))] (create [(ArrayList (slice u8))] a))]
              (store! $g11761 (al-new [(slice u8)] a))
              $g11761))
    (store! (field m frameworks)
            (let [$g11762 (unwrap-ptr [(ArrayList (slice u8))] (create [(ArrayList (slice u8))] a))]
              (store! $g11762 (al-new [(slice u8)] a))
              $g11762))
    (store! (field m libs)
            (let [$g11763 (unwrap-ptr [(ArrayList (slice u8))] (create [(ArrayList (slice u8))] a))]
              (store! $g11763 (al-new [(slice u8)] a))
              $g11763))
    (store! (field m flags)
            (let [$g11764 (unwrap-ptr [(ArrayList (slice u8))] (create [(ArrayList (slice u8))] a))]
              (store! $g11764 (al-new [(slice u8)] a))
              $g11764))
    (store! (field m search-paths)
            (let [$g11765 (unwrap-ptr [(ArrayList (slice u8))] (create [(ArrayList (slice u8))] a))]
              (store! $g11765 (al-new [(slice u8)] a))
              $g11765))
    (store! (field m objects)
            (let [$g11766 (unwrap-ptr [(ArrayList (slice u8))] (create [(ArrayList (slice u8))] a))]
              (store! $g11766 (al-new [(slice u8)] a))
              $g11766))
    (store! (field m rargs)
            (let [$g11767 (unwrap-ptr [(ArrayList (slice u8))] (create [(ArrayList (slice u8))] a))]
              (store! $g11767 (al-new [(slice u8)] a))
              $g11767))
    (store! (field m sources)
            (let [$g11768 (unwrap-ptr [(ArrayList (slice u8))] (create [(ArrayList (slice u8))] a))]
              (store! $g11768 (al-new [(slice u8)] a))
              $g11768))
    (store! (field m include-dirs)
            (let [$g11769 (unwrap-ptr [(ArrayList (slice u8))] (create [(ArrayList (slice u8))] a))]
              (store! $g11769 (al-new [(slice u8)] a))
              $g11769))
    (store! (field m ccflags)
            (let [$g11770 (unwrap-ptr [(ArrayList (slice u8))] (create [(ArrayList (slice u8))] a))]
              (store! $g11770 (al-new [(slice u8)] a))
              $g11770))
    (store! (field m test-roots)
            (let [$g11771 (unwrap-ptr [(ArrayList (slice u8))] (create [(ArrayList (slice u8))] a))]
              (store! $g11771 (al-new [(slice u8)] a))
              $g11771))
    (store! (field m test-suffixes)
            (let [$g11772 (unwrap-ptr [(ArrayList (slice u8))] (create [(ArrayList (slice u8))] a))]
              (store! $g11772 (al-new [(slice u8)] a))
              $g11772))
    (store! (field m suites)
            (let [$g11776
                    (unwrap-ptr [(ArrayList (ptr ManifestSuite))]
                                (create [(ArrayList (ptr ManifestSuite))] a))]
              (store! $g11776 (al-new [(ptr ManifestSuite)] a))
              $g11776))
    (store! (field m lint-rules)
            (let [$g11773 (unwrap-ptr [(ArrayList (slice u8))] (create [(ArrayList (slice u8))] a))]
              (store! $g11773 (al-new [(slice u8)] a))
              $g11773))
    (store! (field m metaprograms)
            (let [$g11777 (unwrap-ptr [(ArrayList (slice u8))] (create [(ArrayList (slice u8))] a))]
              (store! $g11777 (al-new [(slice u8)] a))
              $g11777))
    (store! (field m native-deps)
            (let [$g11774 (unwrap-ptr [(ArrayList ManifestNativeDep)] (create [(ArrayList ManifestNativeDep)] a))]
              (store! $g11774 (al-new [ManifestNativeDep] a))
              $g11774))
    (store! (field m deps)
            (let [$g11775 (unwrap-ptr [(ArrayList ManifestDep)] (create [(ArrayList ManifestDep)] a))]
              (store! $g11775 (al-new [ManifestDep] a))
              $g11775))
    (let [lines (m-lines a text)
          (mut section) ""
          (mut suite) (primitive/cast (ptr ManifestSuite) 0)
          (mut i) 0
          n (al-len [(slice u8)] (load lines))]
      (loop (if (>= (load i) n)
                (break)
                (let [line (m-trim (al-get [(slice u8)] (load lines) (load i)))]
                  (unless (or (= (slice-len [u8] line) (primitive/cast i64 0))
                              (= (slice-get [u8] line 0) (primitive/cast u8 35)))
                    ; blank/#
                    (if (= (slice-get [u8] line 0) (primitive/cast u8 91))  ; [section]
                        (let [sec (m-trim (subslice [u8] line 1 (primitive/isub (slice-len [u8] line) 1)))
                              ln (primitive/iadd (load i) 1)]
                          (unless (or (m-known-section? sec) (m-suite-section? sec))
                            (m-err a
                                   ln
                                   (cat3-d a
                                           "unknown section ["
                                           (cat3-d a
                                                   sec
                                                   "] (known: package, dependencies, native-dependencies, build, link, cc, run, test, test.suites.<name>, lint, metaprograms)"))))
                          (if (m-suite-section? sec)
                              (let [sname (m-suite-section-name sec)]
                                (unless (m-suite-name? sname)
                                  (m-err a
                                         ln
                                         (cat3-d a
                                                 "invalid test suite name '"
                                                 (cat3-d a
                                                         sname
                                                         "' (letters, digits, '-' and '_' only)"))))
                                ; `--suite all` means every suite, so a suite may not claim the word.
                                (when (= sname "all")
                                  (m-err a ln "test suite name 'all' is reserved for `coil test --suite all`"))
                                (when (= sname "default")
                                  (m-err a
                                         ln
                                         "test suite name 'default' is reserved for the bare [test] section"))
                                (unless (= (primitive/cast i64 (m-find-suite (load (field m suites)) sname))
                                           (primitive/cast i64 0))
                                  (m-err a
                                         ln
                                         (cat3-d a "duplicate test suite [test.suites." (cat3-d a sname "]"))))
                                (let [s (m-new-suite a sname ln)]
                                  (al-push! [(ptr ManifestSuite)] (load (field m suites)) s)
                                  (store! suite s))
                                0)
                              (store! suite (primitive/cast (ptr ManifestSuite) 0)))
                          (store! section sec)
                          0)
                        (let [eq (m-index line (primitive/cast u8 61))]  ; key = value
                          (unless (< eq (primitive/cast i64 0))
                            (let [key (m-trim (subslice [u8] line 0 eq))
                                  val (m-trim (subslice [u8] line (primitive/iadd eq 1) (slice-len [u8] line)))
                                  ln (primitive/iadd (load i) 1)]
                              (cond (= (load section) "package")
                                      (if (= key "name")
                                          (do (store! (field m name) (m-unquote val)) 0)
                                          (if (= key "entry")
                                              (do (store! (field m entry) (m-unquote val)) 0)
                                              (if (= key "source-roots")
                                                  (do
                                                    (m-parse-array a
                                                                   val
                                                                   (load (field m source-roots)))
                                                    0)
                                                  (if (= key "exclude")
                                                      (do
                                                        (m-parse-array a
                                                                       val
                                                                       (load (field m exclude)))
                                                        0)
                                                      (m-bad-key a ln (load section) key)))))
                                    (= (load section) "dependencies") (m-parse-dep a (load (field m deps)) key val ln)
                                    (= (load section) "native-dependencies")
                                      (m-parse-native-dep a (load (field m native-deps)) key val ln)
                                    (= (load section) "build")
                                      (cond (= key "out") (do (store! (field m out) (m-unquote val)) 0)
                                            (= key "target")
                                              (do
                                                (store! (field m target) (m-unquote val))
                                                (store! (field m has-target) true)
                                                0)
                                            (= key "debug") (do (store! (field m debug) (= val "true")) 0)
                                            :else (m-bad-key a ln (load section) key))
                                    (= (load section) "link")
                                      (cond (= key "frameworks")
                                              (do
                                                (m-parse-array a val (load (field m frameworks)))
                                                0)
                                            (= key "libs") (do (m-parse-array a val (load (field m libs))) 0)
                                            (= key "search-paths")
                                              (do
                                                (m-parse-array a val (load (field m search-paths)))
                                                0)
                                            (= key "objects") (do (m-parse-array a val (load (field m objects))) 0)
                                            (= key "flags") (do (m-parse-array a val (load (field m flags))) 0)
                                            :else (m-bad-key a ln (load section) key))
                                    (= (load section) "cc")
                                      (if (= key "sources")
                                          (do (m-parse-array a val (load (field m sources))) 0)
                                          (if (= key "flags")
                                              (do (m-parse-array a val (load (field m ccflags))) 0)
                                              (if (= key "include-dirs")
                                                  (do
                                                    (m-parse-array a
                                                                   val
                                                                   (load (field m include-dirs)))
                                                    0)
                                                  (m-bad-key a ln (load section) key))))
                                    (= (load section) "run")
                                      (if (= key "args")
                                          (do (m-parse-array a val (load (field m rargs))) 0)
                                          (m-bad-key a ln (load section) key))
                                    (= (load section) "test")
                                      (cond (= key "roots")
                                              (do
                                                (m-parse-array a val (load (field m test-roots)))
                                                (store! (field m test-roots-line) ln)
                                                0)
                                            (= key "suffixes")
                                              (do
                                                (m-parse-array a val (load (field m test-suffixes)))
                                                0)
                                            :else (m-bad-key a ln (load section) key))
                                    (m-suite-section? (load section))
                                      (let [s (load suite)]
                                        (cond (= key "roots")
                                                (do
                                                  (m-parse-array a val (load (field s roots)))
                                                  (store! (field s roots-declared) true)
                                                  ; relocate the suite to its roots key: a
                                                  ; bad root is reported where it is written,
                                                  ; not at the section header above it.
                                                  (store! (field s line) ln)
                                                  0)
                                              (= key "suffixes") (do (m-parse-array a val (load (field s suffixes))) 0)
                                              (= key "default")
                                                (do
                                                  (unless (or (= val "true") (= val "false"))
                                                    (m-err a
                                                           ln
                                                           (cat3-d a
                                                                   "test suite '"
                                                                   (cat3-d a
                                                                           (load (field s name))
                                                                           (cat3-d a
                                                                                   "': default must be true or false, got '"
                                                                                   (cat3-d a val "'"))))))
                                                  (store! (field s is-default) (= val "true"))
                                                  0)
                                              :else (m-bad-key a ln (load section) key)))
                                    (= (load section) "lint")
                                      (if (= key "rules")
                                          (do (m-parse-array a val (load (field m lint-rules))) 0)
                                          (m-bad-key a ln (load section) key))
                                    (= (load section) "metaprograms")
                                      (if (= key "use")
                                          (do (m-parse-array a val (load (field m metaprograms))) 0)
                                          (m-bad-key a ln (load section) key))
                                    :else
                                      (m-err a
                                             ln
                                             (cat3-d a
                                                     "key '"
                                                     (cat3-d a
                                                             key
                                                             "' appears before any [section] header")))))))))
                  (store! i (primitive/iadd (load i) 1)))))
      (m-resolve-suites a m)
      m)))

; Fold the manifest's test configuration into the final suite list.
;
;   * a bare [test] section becomes the suite named "default" — that is what keeps every
;     existing manifest working unchanged;
;   * a manifest with NO test configuration at all still gets that default suite, so
;     `coil test` keeps discovering tests/*_test.coil without any manifest opt-in;
;   * a manifest that declares only named suites gets exactly those.
;
; Every suite is then filled in with the defaults the bare runner used to apply at
; discovery time, so nothing downstream has to ask "was this configured?" again. The
; union of all suffixes is republished into test-suffixes because `lint` uses that list
; to recognize a test file, and a file in a non-default suite is still a test file.
(defn m-resolve-suites [(a (ptr Allocator)) (m (ptr Manifest))] (-> i64)
  (let [named (load (field m suites))
        n-roots (al-len [(slice u8)] (load (field m test-roots)))
        n-suffixes (al-len [(slice u8)] (load (field m test-suffixes)))
        resolved
          (unwrap-ptr [(ArrayList (ptr ManifestSuite))]
                      (create [(ArrayList (ptr ManifestSuite))] a))]
    (store! resolved (al-new [(ptr ManifestSuite)] a))
    (when (or (> n-roots (primitive/cast i64 0))
              (or (> n-suffixes (primitive/cast i64 0))
                  (= (al-len [(ptr ManifestSuite)] (load named)) (primitive/cast i64 0))))
      (let [d (m-new-suite a "default" (load (field m test-roots-line)))
            (mut i) 0
            (mut j) 0]
        (store! (field d roots-declared) (> n-roots (primitive/cast i64 0)))
        (loop (if (>= (load i) n-roots)
                  (break)
                  (do
                    (al-push! [(slice u8)]
                              (load (field d roots))
                              (al-get [(slice u8)] (load (field m test-roots)) (load i)))
                    (store! i (primitive/iadd (load i) 1)))))
        (loop (if (>= (load j) n-suffixes)
                  (break)
                  (do
                    (al-push! [(slice u8)]
                              (load (field d suffixes))
                              (al-get [(slice u8)] (load (field m test-suffixes)) (load j)))
                    (store! j (primitive/iadd (load j) 1)))))
        (al-push! [(ptr ManifestSuite)] resolved d))
      0)
    (let [(mut i) 0]
      (loop (if (>= (load i) (al-len [(ptr ManifestSuite)] (load named)))
                (break)
                (do
                  (al-push! [(ptr ManifestSuite)]
                            resolved
                            (al-get [(ptr ManifestSuite)] (load named) (load i)))
                  (store! i (primitive/iadd (load i) 1))))))
    (store! (field m suites) resolved)
    (let [(mut i) 0]
      (loop (if (>= (load i) (al-len [(ptr ManifestSuite)] (load resolved)))
                (break)
                (let [s (al-get [(ptr ManifestSuite)] (load resolved) (load i))
                      (mut j) 0]
                  (when (= (al-len [(slice u8)] (load (field s roots))) (primitive/cast i64 0))
                    (al-push! [(slice u8)] (load (field s roots)) "tests")
                    0)
                  (when (= (al-len [(slice u8)] (load (field s suffixes))) (primitive/cast i64 0))
                    (al-push! [(slice u8)] (load (field s suffixes)) "_test.coil")
                    0)
                  (loop (if (>= (load j) (al-len [(slice u8)] (load (field s suffixes))))
                            (break)
                            (do
                              (m-push-unique! (load (field m test-suffixes))
                                              (al-get [(slice u8)] (load (field s suffixes)) (load j)))
                              (store! j (primitive/iadd (load j) 1)))))
                  (store! i (primitive/iadd (load i) 1))))))
    0))

(defn m-index [(s (slice u8)) (b u8)] (-> i64)
  (let [n (slice-len [u8] s)
        (mut i) 0
        (mut r) -1]
    (loop (if (>= (load i) n)
              (break)
              (if (= (slice-get [u8] s (load i)) b)
                  (do (store! r (load i)) (break))
                  (store! i (primitive/iadd (load i) 1)))))
    (load r)))

(defn m-shell-quoted! [(b (mut StrBuf)) (s (slice u8))] (-> i64)
  (sb-push-str! (mut b) "'")
  (sb-push-str! (mut b) s)
  (sb-push-str! (mut b) "'")
  0)

(defn m-realpath [(a (ptr Allocator)) (path (slice u8))] (-> (Option (slice u8)))
  (let [buf (unwrap-ptr [i8] (raw-alloc a 4096 1))
        r (realpath (str->cstr a path) buf)]
    (if (= (primitive/cast i64 r) (primitive/cast i64 0)) (None [(slice u8)]) (Some (cstr->slice buf)))))

; Shells are allowed to preserve the command name (just `coil`) in argv[0] after
; locating the executable through PATH. Resource paths must therefore resolve the
; command the same way instead of treating argv[0] as relative to the caller's cwd.
(defn m-resolve-self [(a (ptr Allocator)) (self (slice u8))] (-> (slice u8))
  (match (m-realpath a self)
    (Some [p] p)
    (None []
          (if (>= (m-index self (primitive/cast u8 47)) (primitive/cast i64 0))
              self
              (let [path-p (getenv c"PATH")]
                (if (= (primitive/cast i64 path-p) (primitive/cast i64 0))
                    self
                    (let [path (cstr->slice path-p)
                          n (slice-len [u8] path)
                          (mut lo) 0
                          (mut found) self]
                      (loop (if (> (load lo) n)
                                (break)
                                (let [(mut hi) (load lo)]
                                  (loop (if (or (>= (load hi) n)
                                                (= (slice-get [u8] path (load hi)) (primitive/cast u8 58)))
                                            (break)
                                            (store! hi (primitive/iadd (load hi) 1))))
                                  (let [dir (subslice [u8] path (load lo) (load hi))
                                        candidate
                                          (if (= (slice-len [u8] dir) (primitive/cast i64 0))
                                              (cat3-d a "./" self)
                                              (cat3-d a (cat3-d a dir "/") self))]
                                    (if (= (primitive/cast i64 (access (str->cstr a candidate) 1))
                                           (primitive/cast i64 0))
                                        (match (m-realpath a candidate)
                                          (Some [p] (do (store! found p) (break)))
                                          (None [] 0))
                                        0))
                                  (store! lo (primitive/iadd (load hi) 1)))))
                      (load found))))))))

; Resolve path dependencies and materialize immutable Git checkouts. Each Git SHA
; gets its own cache directory, so changing a pin never mutates another resolved
; dependency. Existing checkouts are forced back to the requested commit, making
; dirty tracked cache state irrelevant to builds.
(defn m-prepare-deps [(a (ptr Allocator)) (m (ptr Manifest))] (-> i64)
  (let [deps (load (field m deps))
        n (al-len [ManifestDep] (load deps))
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (let [(mut d) (al-get [ManifestDep] (load deps) (load i))]
                (if (> (slice-len (load (field d path))) (primitive/cast i64 0))
                    (match (m-realpath a (load (field d path)))
                      (Some [p] (store! (field d resolved) p))
                      (None []
                            (m-err a
                                   (load (field d line))
                                   (cat3-d a
                                           "dependency '"
                                           (cat3-d a (load (field d name)) "' path does not exist")))))
                    (let [cache
                            (cat3-d a
                                    ".coil/deps/"
                                    (cat3-d a
                                            (load (field d name))
                                            (cat3-d a "-" (load (field d sha)))))
                          (mut cmd) (sb-new a)]
                      (sb-push-str! (mut cmd) "mkdir -p '.coil/deps' && if [ -d ")
                      (m-shell-quoted! (mut cmd) (cat3-d a cache "/.git"))
                      (sb-push-str! (mut cmd) " ]; then git -C ")
                      (m-shell-quoted! (mut cmd) cache)
                      (sb-push-str! (mut cmd) " checkout --detach --force ")
                      (m-shell-quoted! (mut cmd) (load (field d sha)))
                      (sb-push-str! (mut cmd) "; else git clone --no-checkout ")
                      (m-shell-quoted! (mut cmd) (load (field d git)))
                      (sb-push-str! (mut cmd) " ")
                      (m-shell-quoted! (mut cmd) cache)
                      (sb-push-str! (mut cmd) " && git -C ")
                      (m-shell-quoted! (mut cmd) cache)
                      (sb-push-str! (mut cmd) " checkout --detach ")
                      (m-shell-quoted! (mut cmd) (load (field d sha)))
                      (sb-push-str! (mut cmd) "; fi")
                      (let [rc (primitive/cast i64 (system (str->cstr a (sb-str (load cmd)))))]
                        (unless (= (wait-code rc) (primitive/cast i64 0))
                          (m-err a
                                 (load (field d line))
                                 (cat3-d a
                                         "could not fetch dependency '"
                                         (cat3-d a (load (field d name)) "' at requested sha")))))
                      (match (m-realpath a cache)
                        (Some [p] (store! (field d resolved) p))
                        (None []
                              (m-err a
                                     (load (field d line))
                                     (cat3-d a
                                             "dependency cache for '"
                                             (cat3-d a (load (field d name)) "' is unavailable")))))))
                (al-set! [ManifestDep] deps (load i) (load d))
                (store! i (primitive/iadd (load i) 1)))))
    0))

; Prefix the recursive build/run command with exact environment mappings consumed
; by loader.coil. `env 'NAME=value'` also supports dependency names containing '-'.
; The COIL_NAMESPACE_ROOTS value for this manifest: the configured source roots
; (default `src:tests`), then every resolved dependency root. Shared by the
; subprocess path (m-emit-dep-env, which passes it through `env`) and the direct
; path (apply-project-manifest!, which setenv's it), so a dependency namespace
; resolves identically whether you typed `coil build` or `coil build src/main.coil`.
; Roots that do not exist are OMITTED. The namespace index shells a `find` over this
; list, and a project without a tests/ directory — or one whose entry sits beside
; Coil.toml rather than under src/ — made that `find` print
; `find: tests: No such file or directory` on every single command. A missing root
; contributes nothing to the index either way, and the entry file's own directory is
; appended by namespace-index-build! regardless, so nothing becomes unreachable.
(defn m-namespace-roots [(a (ptr Allocator)) (m (ptr Manifest))] (-> (slice u8))
  (let [deps (load (field m deps))
        n (al-len [ManifestDep] (load deps))
        configured (m-effective-roots a m)
        (mut roots) (sb-new a)
        (mut emitted) 0
        (mut i) 0]
    (let [(mut r) 0]
      (loop (if (>= (load r) (al-len [(slice u8)] configured))
                (break)
                (do
                  (let [root (al-get [(slice u8)] configured (load r))]
                    (when (dir? (str->cstr a root))
                      (when (> (load emitted) (primitive/cast i64 0)) (sb-push-str! (mut roots) ":") 0)
                      (sb-push-str! (mut roots) root)
                      (store! emitted (primitive/iadd (load emitted) 1))
                      0))
                  (store! r (primitive/iadd (load r) 1))))))
    (loop (if (>= (load i) n)
              (break)
              (do
                (when (> (load emitted) (primitive/cast i64 0)) (sb-push-str! (mut roots) ":") 0)
                (sb-push-str! (mut roots)
                              (load (field (al-elem [ManifestDep] deps (load i)) resolved)))
                (store! emitted (primitive/iadd (load emitted) 1))
                (store! i (primitive/iadd (load i) 1)))))
    (sb-str (load roots))))

(defn m-emit-dep-env [(a (ptr Allocator)) (b (mut StrBuf)) (m (ptr Manifest))] (-> i64)
  (let [deps (load (field m deps))
        n (al-len [ManifestDep] (load deps))
        (mut i) 0]
    (sb-push-str! (mut b) "env ")
    (m-shell-quoted! (mut b) (cat3-d a "COIL_NAMESPACE_ROOTS=" (m-namespace-roots a m)))
    (sb-push-str! (mut b) " ")
    (store! i 0)
    (loop (if (>= (load i) n)
              (break)
              (let [d (al-get [ManifestDep] (load deps) (load i))]
                (m-shell-quoted! (mut b)
                                 (cat3-d a
                                         "COIL_DEP_"
                                         (cat3-d a
                                                 (load (field d name))
                                                 (cat3-d a "=" (load (field d resolved))))))
                (sb-push-str! (mut b) " ")
                (store! i (primitive/iadd (load i) 1)))))
    0))

; Append the manifest's `[metaprograms] use` list as `--use <ns>` flags. Every
; project command that reaches a compile emits these, so a declared transform runs
; on `build`, `run`, `check` and `test` alike rather than only where someone
; remembered to retype the flag. Order is manifest order: transforms compose, and
; the one written first sees the original program.
;
; These go on the SUBPROCESS command line rather than into cli-uses directly
; because project commands re-exec `<self> build …`; the child re-reads the same
; manifest, so passing them explicitly keeps the child's view identical to what
; the user could have typed by hand.
; The in-process counterpart of m-emit-uses, for commands that run the pipeline
; themselves (lint) instead of re-exec'ing `<self> build`.
(defn m-add-manifest-uses [(m (ptr Manifest))] (-> i64)
  (let [ns (load (field m metaprograms))
        (mut i) 0
        n (al-len [(slice u8)] ns)]
    (loop (if (>= (load i) n)
              (break)
              (do
                (cli-use-add (al-get [(slice u8)] ns (load i)))
                (store! i (primitive/iadd (load i) 1))))))
  0)

(defn m-emit-uses [(a (ptr Allocator)) (b (mut StrBuf)) (m (ptr Manifest))] (-> i64)
  (let [ns (load (field m metaprograms))
        (mut i) 0
        n (al-len [(slice u8)] ns)]
    (loop (if (>= (load i) n)
              (break)
              (do
                (sb-push-str! (mut b) " --use ")
                (m-shell-quoted! (mut b) (al-get [(slice u8)] ns (load i)))
                (store! i (primitive/iadd (load i) 1))))))
  0)

; append the manifest's link flags to a command string builder, each as
; `--link-flag <token>` (frameworks -> two tokens, libs -> -lX, then raw flags).
(defn m-emit-link [(a (ptr Allocator)) (b (mut StrBuf)) (m (ptr Manifest))] (-> i64)
  (let [fw (load (field m frameworks))
        (mut i) 0
        nf (al-len [(slice u8)] fw)]
    (loop (if (>= (load i) nf)
              (break)
              (do
                (sb-push-str! (mut b) " --link-flag -framework --link-flag ")
                (sb-push-str! (mut b) (al-get [(slice u8)] fw (load i)))
                (store! i (primitive/iadd (load i) 1))))))
  (let [lb (load (field m libs))
        (mut i) 0
        nl (al-len [(slice u8)] lb)]
    (loop (if (>= (load i) nl)
              (break)
              (do
                (sb-push-str! (mut b) " --link-flag -l")
                (sb-push-str! (mut b) (al-get [(slice u8)] lb (load i)))
                (store! i (primitive/iadd (load i) 1))))))
  (let [fl (load (field m flags))
        (mut i) 0
        nx (al-len [(slice u8)] fl)]
    (loop (if (>= (load i) nx)
              (break)
              (do
                (sb-push-str! (mut b) " --link-flag ")
                (sb-push-str! (mut b) (al-get [(slice u8)] fl (load i)))
                (store! i (primitive/iadd (load i) 1))))))
  (let [sp (load (field m search-paths))
        (mut i) 0
        n (al-len [(slice u8)] sp)]
    (loop (if (>= (load i) n)
              (break)
              (do
                (sb-push-str! (mut b) " --link-flag -L --link-flag ")
                (sb-push-str! (mut b) (al-get [(slice u8)] sp (load i)))
                (store! i (primitive/iadd (load i) 1))))))
  (let [ob (load (field m objects))
        (mut i) 0
        n (al-len [(slice u8)] ob)]
    (loop (if (>= (load i) n)
              (break)
              (do
                (sb-push-str! (mut b) " --link-flag ")
                (sb-push-str! (mut b) (al-get [(slice u8)] ob (load i)))
                (store! i (primitive/iadd (load i) 1))))))
  (let [nd (load (field m native-deps))
        (mut i) 0
        n (al-len [ManifestNativeDep] (load nd))]
    (loop (if (>= (load i) n)
              (break)
              (let [d (al-elem [ManifestNativeDep] nd (load i))]
                (sb-push-str! (mut b) " $(pkg-config --libs-only-l ")
                (m-shell-quoted! (mut b) (load (field d pkg)))
                (sb-push-str! (mut b) ") $(pkg-config --libs-only-L --libs-only-other ")
                (m-shell-quoted! (mut b) (load (field d pkg)))
                (sb-push-str! (mut b) " | awk '{for(i=1;i<=NF;i++) printf \"--link-flag %s \", $i}')")
                (store! i (primitive/iadd (load i) 1))))))
  0)

; Explicit-file commands inside a project use the same namespace boundary as
; project mode. Previously they ignored Coil.toml and recursively indexed the cwd,
; so ignored scratch files could collide with real modules after import migration.
; The project manifest THIS process is compiling under, or null when there is none
; (no Coil.toml, or a parent project command already applied it). build-cmd and
; run-cmd consult it to apply the same configuration a project command would.
(defstruct ProjectManifestCell [(m (ptr Manifest))])
(defn project-manifest-cell [] (-> (ptr ProjectManifestCell))
  (alloc/static ProjectManifestCell))
(defn project-manifest [] (-> (ptr Manifest))
  (load (field (project-manifest-cell) m)))
(defn project-manifest? [] (-> bool)
  (!= (primitive/cast i64 (project-manifest)) (primitive/cast i64 0)))

; Apply ./Coil.toml to THIS process when a file was named directly inside a project.
;
; `coil build src/main.coil` used to be a bare compile of one file: no dependency
; roots, no [link], no [cc], no [metaprograms]. That made an ordinary
; `(import "somedep.lib")` fail with "namespace not found" in a project where
; `coil build` resolved it fine — the manifest was reachable only through the
; project subcommands, which pass their configuration to a `<self> build <entry> …`
; child. Naming the file yourself is not a request for a different compile.
;
; A SET COIL_NAMESPACE_ROOTS is the signal that a parent project command already
; configured us (m-emit-dep-env puts it in the child's env). In that case this is a
; no-op and the parent's flags stand — which is what keeps configuration from being
; applied twice, and duplicate [cc] sources from becoming duplicate-symbol errors.
(defn apply-project-manifest! [(a (ptr Allocator))] (-> i64)
  (let [key (str->cstr a "COIL_NAMESPACE_ROOTS")]
    (when (= (primitive/cast i64 (getenv key)) (primitive/cast i64 0))
      (let [text (read-file a (str->cstr a "Coil.toml"))]
        (when (> (slice-len [u8] text) (primitive/cast i64 0))
          (let [m (parse-manifest a text)
                deps (load (field m deps))
                (mut i) 0]
            ; Resolve dependencies BEFORE reading their roots — m-namespace-roots
            ; reads each dep's `resolved` path, which m-prepare-deps is what fills in.
            (m-prepare-deps a m)
            (setenv key (str->cstr a (m-namespace-roots a m)) 1)
            ; Commands that compile IN THIS PROCESS (`check <file>`, the dump
            ; stages) get the declared metaprograms here; the ones that re-exec a
            ; child receive them as `--use` from m-emit-uses instead.
            (m-add-manifest-uses m)
            (loop (if (>= (load i) (al-len [ManifestDep] (load deps)))
                      (break)
                      (let [d (al-get [ManifestDep] (load deps) (load i))]
                        (setenv (str->cstr a (cat3-d a "COIL_DEP_" (load (field d name))))
                                (str->cstr a (load (field d resolved)))
                                1)
                        (store! i (primitive/iadd (load i) 1)))))
            (store! (field (project-manifest-cell) m) m)
            0))
        0))
    0))

(defn namespace-using-command? [(sub (slice u8))] (-> bool)
  (cond (= sub "build") true
        (= sub "run") true
        (= sub "check") true
        (= sub "test") true
        (= sub "fuzz") true
        (= sub "verify") true
        (= sub "lint") true
        (= sub "emit-obj") true
        (= sub "emit-ir") true
        (= sub "dump-ir") true
        (= sub "dump-read") true
        (= sub "dump-ast") true
        (= sub "dump-load") true
        (= sub "dump-resolved") true
        (= sub "dump-checked") true
        (= sub "dump-expand") true
        (= sub "dump-mono") true
        (= sub "expand") true
        (= sub "interp") true
        :else false))

(defn m-prepare-native-deps [(a (ptr Allocator)) (m (ptr Manifest))] (-> i64)
  (let [nd (load (field m native-deps))
        (mut i) 0
        n (al-len [ManifestNativeDep] (load nd))]
    (loop (if (>= (load i) n)
              (break)
              (let [d (al-elem [ManifestNativeDep] nd (load i))
                    (mut cmd) (sb-new a)]
                (sb-push-str! (mut cmd) "pkg-config --exists ")
                (m-shell-quoted! (mut cmd) (load (field d pkg)))
                (let [rc (wait-code (primitive/cast i64 (system (str->cstr a (sb-str (load cmd))))))]
                  (when (!= rc (primitive/cast i64 0))
                    (ps (stderr) "error: native dependency '")
                    (ps (stderr) (load (field d name)))
                    (ps (stderr) "' was not found by pkg-config\n")
                    (exit 1)
                    0))
                (store! i (primitive/iadd (load i) 1)))))
    0))

; `coil build`/`coil run` with no file: read Coil.toml, build the equivalent
; `<self> build|run <entry> …` command, and run it (propagating exit).
; Native inputs are real build artifacts: never dirty the source tree, reuse an
; object while its compiler-generated depfile remains current, and stop before the
; Coil link when the C compiler fails.
(defn m-native-key [(a (ptr Allocator)) (m (ptr Manifest)) (src (slice u8))] (-> i64)
  (let [(mut h) (str-hash src)
        cf (load (field m ccflags))
        inc (load (field m include-dirs))
        (mut i) 0]
    (loop (if (>= (load i) (al-len [(slice u8)] cf))
              (break)
              (do
                (store! h
                        (primitive/ixor (load h)
                                        (str-hash (al-get [(slice u8)] cf (load i)))))
                (store! i (primitive/iadd (load i) 1)))))
    (store! i 0)
    (loop (if (>= (load i) (al-len [(slice u8)] inc))
              (break)
              (do
                (store! h
                        (primitive/ixor (load h)
                                        (str-hash (al-get [(slice u8)] inc (load i)))))
                (store! i (primitive/iadd (load i) 1)))))
    (when (load (field m has-target))
      (store! h (primitive/ixor (load h) (str-hash (load (field m target)))))
      0)
    (when (load (field m debug))
      (store! h (primitive/ixor (load h) 2147483647))
      0)
    (load h)))

(defn d-ends-with? [(s (slice u8)) (suffix (slice u8))] (-> bool)
  (let [n (slice-len [u8] s)
        m (slice-len [u8] suffix)]
    (and (>= n m) (= (subslice [u8] s (primitive/isub n m) n) suffix))))

(defn m-cc-sources [(a (ptr Allocator)) (b (mut StrBuf)) (m (ptr Manifest))] (-> i64)
  (let [srcs (load (field m sources))
        (mut i) 0
        ns (al-len [(slice u8)] srcs)]
    (loop (if (>= (load i) ns)
              (break)
              (let [src (al-get [(slice u8)] srcs (load i))
                    dir (cat3-d a ".coil/build/native/" (i64->str a (m-native-key a m src)))
                    obj (cat3-d a dir "/source.o")
                    dep (cat3-d a dir "/source.d")
                    ccv (cat3-d a dir "/compiler-version")
                    tmpobj (cat3-d a obj (cat3-d a "." (i64->str a (primitive/cast i64 (getpid)))))
                    tmpdep (cat3-d a dep (cat3-d a "." (i64->str a (primitive/cast i64 (getpid)))))
                    (mut cc) (sb-new a)]
                (let [(mut mk) (sb-new a)]
                  (sb-push-str! (mut mk) "mkdir -p ")
                  (m-shell-quoted! (mut mk) dir)
                  (let [mrc (primitive/cast i64 (system (str->cstr a (sb-str (load mk)))))]
                    (when (!= (wait-code mrc) (primitive/cast i64 0))
                      (ps (stderr) "error: cannot create native build directory\n")
                      (exit 1)
                      0)))
                (sb-push-str! (mut cc) "if [ ! -f ")
                (m-shell-quoted! (mut cc) obj)
                (sb-push-str! (mut cc) " ] || [ ! -f ")
                (m-shell-quoted! (mut cc) dep)
                (sb-push-str! (mut cc) " ] || ! make -q -f ")
                (m-shell-quoted! (mut cc) dep)
                (sb-push-str! (mut cc) " ")
                (m-shell-quoted! (mut cc) obj)
                (sb-push-str! (mut cc) " >/dev/null 2>&1 || ! clang --version | head -1 | cmp -s - ")
                (m-shell-quoted! (mut cc) ccv)
                (sb-push-str! (mut cc) "; then clang -MMD -MF ")
                (m-shell-quoted! (mut cc) tmpdep)
                (sb-push-str! (mut cc) " -MT ")
                (m-shell-quoted! (mut cc) obj)
                (sb-push-str! (mut cc) " -c ")
                (m-shell-quoted! (mut cc) src)
                (sb-push-str! (mut cc) " -o ")
                (m-shell-quoted! (mut cc) tmpobj)
                (let [incs (load (field m include-dirs))
                      (mut j) 0
                      nj (al-len [(slice u8)] incs)]
                  (loop (if (>= (load j) nj)
                            (break)
                            (do
                              (sb-push-str! (mut cc) " -I")
                              (m-shell-quoted! (mut cc) (al-get [(slice u8)] incs (load j)))
                              (store! j (primitive/iadd (load j) 1))))))
                (let [cf (load (field m ccflags))
                      (mut k) 0
                      nk (al-len [(slice u8)] cf)]
                  (loop (if (>= (load k) nk)
                            (break)
                            (do
                              (sb-push-str! (mut cc) " ")
                              (sb-push-str! (mut cc) (al-get [(slice u8)] cf (load k)))
                              (store! k (primitive/iadd (load k) 1))))))
                (let [nd (load (field m native-deps))
                      (mut k) 0
                      nk (al-len [ManifestNativeDep] (load nd))]
                  (loop (if (>= (load k) nk)
                            (break)
                            (let [d (al-elem [ManifestNativeDep] nd (load k))]
                              (sb-push-str! (mut cc) " $(pkg-config --cflags ")
                              (m-shell-quoted! (mut cc) (load (field d pkg)))
                              (sb-push-str! (mut cc) ")")
                              (store! k (primitive/iadd (load k) 1))))))
                (sb-push-str! (mut cc) " && mv ")
                (m-shell-quoted! (mut cc) tmpobj)
                (sb-push-str! (mut cc) " ")
                (m-shell-quoted! (mut cc) obj)
                (sb-push-str! (mut cc) " && mv ")
                (m-shell-quoted! (mut cc) tmpdep)
                (sb-push-str! (mut cc) " ")
                (m-shell-quoted! (mut cc) dep)
                (sb-push-str! (mut cc) " && clang --version | head -1 > ")
                (m-shell-quoted! (mut cc) ccv)
                (sb-push-str! (mut cc) "; fi")
                (let [crc (primitive/cast i64 (system (str->cstr a (sb-str (load cc)))))]
                  (when (!= (wait-code crc) (primitive/cast i64 0))
                    (wait-report crc "C compiler")
                    (exit (primitive/cast i32 (if (= (wait-code crc) (primitive/cast i64 0)) 1 (wait-code crc))))
                    0))
                (sb-push-str! (mut b) " --link-flag ")
                (sb-push-str! (mut b) obj)
                (store! i (primitive/iadd (load i) 1))))))
  0)

; Forward the user's own CLI flags into the sub-invocation. Project mode used to drop
; every flag on the floor and report success: `coil build --target wasm32-unknown-unknown`
; printed `wrote mp`, exited 0, and produced a native Mach-O. The manifest's own flags are
; emitted first, so a flag the user typed lands later on the command line and wins
; (build-cmd keeps the last -o/--target it sees).
; `skip` is the index of the entry positional the caller already placed on the
; command line (0 when there is none). Without it, `coil build src/main.coil`
; inside a project would forward the file a second time and the child would reject
; it as a stray argument.
(defn m-forward-flags [(a (ptr Allocator)) (b (mut StrBuf)) (argc i32) (argv (ptr (ptr i8))) (skip i64)] (-> i64)
  (let [(mut i) 2]
    (loop (if (>= (load i) (primitive/cast i64 argc))
              (break)
              (let [arg (cstr->slice (load (primitive/index argv (load i))))]
                (if (= arg "--")
                    (break)
                    (if (= (load i) skip)
                        (do (store! i (primitive/iadd (load i) 1)) 0)
                        (do
                          (sb-push-str! (mut b) " ")
                          (sb-push-str! (mut b) arg)
                          (store! i (primitive/iadd (load i) 1))
                          0)))))))
  0)

; `fidx` is the argv index of a file the user named explicitly, or 0 for a plain
; project command. Naming a file inside a project takes this same path — the project
; configuration is identical, only the entry differs — so `coil build src/main.coil`
; and `coil build` compile under the same dependencies, link inputs and metaprograms.
; With an explicit entry the manifest's `[build] out` is NOT applied: `-o` stays
; required there, as it always was, instead of silently writing the package binary.
(defn manifest-cmd [(a (ptr Allocator)) (sub (slice u8)) (argc i32) (argv (ptr (ptr i8))) (fidx i64)] (-> i64)
  (let [self (cstr->slice (load (primitive/index argv 0)))
        text (read-file a (str->cstr a "Coil.toml"))]
    (if (= (slice-len [u8] text) (primitive/cast i64 0))
        (do (ps (stderr) "error: no Coil.toml in the current directory (pass a <file> to build directly)\n") 1)
        (let [m (parse-manifest a text)
              explicit (!= fidx (primitive/cast i64 0))
              entry
                (if explicit
                    (cstr->slice (load (primitive/index argv fidx)))
                    (if (> (slice-len [u8] (load (field m entry))) (primitive/cast i64 0))
                        (load (field m entry))
                        "src/main.coil"))
              out
                (if (> (slice-len [u8] (load (field m out))) (primitive/cast i64 0))
                    (load (field m out))
                    (load (field m name)))
              (mut b) (sb-new a)]
          (m-prepare-deps a m)
          (m-prepare-native-deps a m)
          (m-emit-dep-env a (mut b) m)
          (sb-push-str! (mut b) self)
          (sb-push-str! (mut b) " ")
          (sb-push-str! (mut b) sub)
          (sb-push-str! (mut b) " ")
          (m-shell-quoted! (mut b) entry)
          (when (and (= sub "build") (not explicit))
            (sb-push-str! (mut b) " -o ")
            (sb-push-str! (mut b) out)
            0)
          (m-emit-uses a (mut b) m)
          (m-emit-link a (mut b) m)
          (m-cc-sources a (mut b) m)
          (when (load (field m has-target))
            (sb-push-str! (mut b) " --target ")
            (sb-push-str! (mut b) (load (field m target)))
            0)
          (when (load (field m debug)) (sb-push-str! (mut b) " -g") 0)
          (m-forward-flags a (mut b) argc argv fidx)
          ; run: forward CLI args after `--`, else the manifest's [run] args.
          ;
          ; ONLY what follows `--` is a program argument. This loop used to append
          ; every argv element that was not the literal `--`, so the build flags
          ; before it were forwarded a SECOND time as program args: `coil run --use
          ; httptap -- tui` handed the program `["--use" "httptap" "tui"]`, and a
          ; program that dispatches on argv[1] saw `--use` instead of `tui`.
          ; m-forward-flags above is what puts those flags on the build line; they
          ; have no business past the `--`. (Single-file run-cmd always did this.)
          (when (= sub "run")
            (let [(mut i) 2
                  (mut sawdd) false]
              (sb-push-str! (mut b) " --")
              (loop (if (>= (load i) (primitive/cast i64 argc))
                        (break)
                        (do
                          (if (load sawdd)
                              (do
                                (sb-push-str! (mut b) " ")
                                (sb-push-str! (mut b)
                                              (cstr->slice (load (primitive/index argv (load i)))))
                                0)
                              (if (= (cstr->slice (load (primitive/index argv (load i)))) "--")
                                  (do (store! sawdd true) 0)
                                  0))
                          (store! i (primitive/iadd (load i) 1)))))
              (when (not (load sawdd))
                (let [ra (load (field m rargs))
                      (mut k) 0
                      nr (al-len [(slice u8)] ra)]
                  (loop (if (>= (load k) nr)
                            (break)
                            (do
                              (sb-push-str! (mut b) " ")
                              (sb-push-str! (mut b) (al-get [(slice u8)] ra (load k)))
                              (store! k (primitive/iadd (load k) 1)))))))))
          (let [rc (primitive/cast i64 (system (str->cstr a (sb-str (load b)))))]
            (wait-report rc "program")
            (wait-code rc))))))

; manifest mode = `build`/`run` with no file ANYWHERE in argv — not merely "argv[2]
; starts with a dash", which made `coil build -o out in.coil` look like a project build.
(defn manifest-mode? [(argc i32) (argv (ptr (ptr i8)))] (-> bool)
  (= (argv-file-idx argc argv 2) (primitive/cast i64 0)))

; Start a shell `find` over the project-owned Coil files. Callers append the
; action (`-print0 | ...`). Defaults intentionally cover only src/ and tests/;
; generated artifacts under .coil/ never enter formatting or linting.
; The roots this project's sources live under: the manifest's `source-roots`, or the
; conventional `src`/`tests` when it declares none.
(defn m-effective-roots [(a (ptr Allocator)) (m (ptr Manifest))] (-> (ptr (ArrayList (slice u8))))
  (let [declared (load (field m source-roots))]
    (if (> (al-len [(slice u8)] declared) (primitive/cast i64 0))
        declared
        (let [g (unwrap-ptr [(ArrayList (slice u8))] (create [(ArrayList (slice u8))] a))]
          (store! g (al-new [(slice u8)] a))
          (al-push! g "src")
          (al-push! g "tests")
          g))))

; Emit `find <roots…> -type f -name '*.coil' [! -path …]`, listing ONLY roots that
; exist. `src tests` is a convention, not a promise that both are present, and a
; project without a tests/ directory made `find` fail: it printed
; `find: tests: No such file or directory` on every project command, and
; project-lint-cmd returned that failure having linted NOTHING — which `coil verify`
; then hit first, since it chains `lint &&`.
;
; Returns the number of roots emitted. 0 means there is nothing to search at all,
; and the caller must skip the command rather than run a `find` with no paths —
; that would silently walk the current directory instead.
(defn m-source-find! [(a (ptr Allocator)) (b (mut StrBuf)) (m (ptr Manifest))] (-> i64)
  (let [roots (m-effective-roots a m)
        excludes (load (field m exclude))
        (mut live) 0
        (mut i) 0]
    (sb-push-str! (mut b) "find ")
    (loop (if (>= (load i) (al-len [(slice u8)] roots))
              (break)
              (do
                (let [root (al-get [(slice u8)] roots (load i))]
                  (when (dir? (str->cstr a root))
                    (when (> (load live) (primitive/cast i64 0)) (sb-push-str! (mut b) " ") 0)
                    (m-shell-quoted! (mut b) root)
                    (store! live (primitive/iadd (load live) 1))
                    0))
                (store! i (primitive/iadd (load i) 1)))))
    (sb-push-str! (mut b) " -type f -name '*.coil'")
    (let [(mut k) 0]
      (loop (if (>= (load k) (al-len [(slice u8)] excludes))
                (break)
                (do
                  (sb-push-str! (mut b) " ! -path ")
                  (m-shell-quoted! (mut b) (al-get [(slice u8)] excludes (load k)))
                  (store! k (primitive/iadd (load k) 1))))))
    (load live)))

; The CLI entry, parameterized by the backend hooks the top file injects:
;   build-fn     — LLVM `build` (mode 1); a64 build passes a hard-error stub
;   emitir-fn    — `emit-ir` / `dump-ir` (mode 0); a64 build passes a hard-error stub
;   normalize-fn — `__normalize` debug subcommand; a64 build passes a hard-error stub
;   default-backend — 1 (LLVM) for the full build, 2 (arm64) for the LLVM-free build
; The top file's `main` just forwards argc/argv here with its fn-ptrs.

; `run <file> [--link-flag X]... [--backend arm64] [-- prog args...]` : build the
; file to a temp executable, exec it with the forwarded args, propagate its exit
; code. `coil run` is build then exec.
(defn run-cmd [(a (ptr Allocator)) (argc i32) (argv (ptr (ptr i8)))] (-> i64)
  ; `run` reuses the working `build` subcommand as a subprocess (self = argv[0]):
  ;   <self> build <file> -o /tmp/coil-run-<pid> <flags-before-'--'> then exec it with
  ; the args after `--`. Robust — no duplication of the build/link pipeline.
  (let [self (cstr->slice (load (primitive/index argv 0)))
        file (cstr->slice (load (primitive/index argv 2)))
        runpath (cat3-d a "/tmp/coil-run-" (i64->str a (primitive/cast i64 (getpid))))
        (mut b) (sb-new a)
        (mut progargs) (sb-new a)
        (mut i) 3
        (mut inargs) false]
    (sb-push-str! (mut b) self)
    (sb-push-str! (mut b) " build ")
    (sb-push-str! (mut b) file)
    (sb-push-str! (mut b) " -o ")
    (sb-push-str! (mut b) runpath)
    ; --quiet, not `>/dev/null`: the only build output worth hiding here is the
    ; "wrote /tmp/coil-run-<pid>" line. Redirecting the whole stream also swallowed
    ; whatever a metaprogram printed while compiling. Placed BEFORE the user's own
    ; flags so a value-taking flag they left dangling cannot consume it.
    (sb-push-str! (mut b) " --quiet")
    (loop (if (>= (load i) (primitive/cast i64 argc))
              (break)
              (let [arg (cstr->slice (load (primitive/index argv (load i))))]
                (if (load inargs)
                    (do
                      (sb-push-str! (mut progargs) " ")
                      (sb-push-str! (mut progargs) arg)
                      (store! i (primitive/iadd (load i) 1))
                      0)
                    (if (= arg "--")
                        (do (store! inargs true) (store! i (primitive/iadd (load i) 1)) 0)
                        (do
                          (sb-push-str! (mut b) " ")
                          (sb-push-str! (mut b) arg)
                          (store! i (primitive/iadd (load i) 1))
                          0))))))
    (let [brc (primitive/cast i64 (system (str->cstr a (sb-str (load b)))))]
      (if (!= brc (primitive/cast i64 0))
          ; the BUILD failed. A build that died by signal (a runaway comptime, a deep
          ; macro expansion) also decoded to 0 here, so `run` reported success without
          ; ever running anything.
          (do
            (wait-report brc "compiler")
            (let [c (wait-code brc)] (if (= c (primitive/cast i64 0)) 1 c)))
          ; `exec` forces system()'s shell to replace itself with the program, so the
          ; raw wait status (and thus a signal death) reaches wait-report unmasked.
          ; Without it some shells (Linux dash among them) fork, swallow the signal
          ; into exit 128+n, and print their own message instead of ours.
          (let [runcmd (sconcat a "exec " (cat3-d a runpath (sb-str (load progargs))))
                rrc (primitive/cast i64 (system (str->cstr a runcmd)))]
            (wait-report rrc "program")
            (unlink (str->cstr a runpath))
            (wait-code rrc))))))

; `coil test <file> [flags]` — the project test runner (tool-12). Builds the file with
; src/stdlib/assert.coil auto-loaded (`--use`, so `deftest`/`assert`/`assert-eq` need NO import),
; then RUNS it. assert.coil's `(transform …)` discovers every `(deftest …)` and synthesizes
; a `main` that runs each test in a forked child; the process exit is 0 iff all pass, 1 if
; any test fails. Like `run`, it reuses the `build` subcommand as a subprocess so there is
; no second copy of the build/link pipeline. Flags after the file (e.g. `--backend arm64`,
; `-l<lib>`) are forwarded to the build.
; Flags that belong to the TEST RUNNER, not to the build.
;
; `coil test` builds a program and then runs it, so a flag on the command line is
; ambiguous between the two. These go to the program: they are `coil.prop`'s knobs
; (`--cases`, `--seed`, …), read from the runner's own argv. Everything else is
; still forwarded to `coil build`, which is where `--sanitize=address`,
; `--debug-checks` and the rest belong.
;
; They are listed rather than pattern-matched so an unknown flag still reaches the
; build and gets its existing "unknown flag" diagnostic, instead of being silently
; passed to a program that will ignore it.
(defn test-runner-flag? [(arg (slice u8))] (-> bool)
  (cond (= arg "--cases") true
        (= arg "--seed") true
        (= arg "--size") true
        (= arg "--shrink") true
        (= arg "--max-rejects") true
        (= arg "--timeout") true
        (= arg "--candidate-timeout") true
        (= arg "--arena") true
        (= arg "--fuzz") true
        (= arg "--target-steps") true
        :else false))

;; The bare ones, which take no value.
(defn test-runner-switch? [(arg (slice u8))] (-> bool)
  (cond (= arg "--verbose") true
        (= arg "--alloc-tracked") true
        (= arg "--no-fork") true
        :else false))

(defn test-cleanup [(a (ptr Allocator)) (outdir (slice u8))] (-> i64)
  ; A runner is an invocation-local executable, not a cache entry. Remove the whole
  ; directory so partial objects from a failed build cannot accumulate either.
  (let [(mut cmd) (sb-new a)]
    (sb-push-str! (mut cmd) "rm -rf -- ")
    (m-shell-quoted! (mut cmd) outdir)
    (wait-code (primitive/cast i64 (system (str->cstr a (sb-str (load cmd))))))))

; ---------------------------------------------------------------- `coil fuzz`
;
; `coil test` with a feedback loop: the same file, the same `defprop`s, built with
; EDGE AND COMPARISON INSTRUMENTATION so the runner can tell which inputs reached
; somewhere new and what values the program was looking for.
;
; Why this is a build of its own rather than a flag on `coil test`. Coil emits its
; own objects, so there is no point in the normal pipeline where clang could
; instrument the program — `--sanitize=…` reaches only the link step, which is why
; it buys ASan's allocator interception and no instrumentation at all. `emit-ir`
; already produces complete, linkable IR for the whole program, so the instrumented
; build is: emit IR, hand it to clang with `-fsanitize-coverage`, link. That is what
; this command does, and it is the only reason it shells out differently.
;
; The callbacks clang's instrumentation calls are ordinary Coil functions in
; `coil.prop.cov`, so nothing else about the program changes: the same source, built
; the ordinary way, defines those symbols and never calls them.

;; The instrumentation ignorelist. Written per invocation rather than kept in the
;; tree because it names implementation modules, and a stale copy would silently
;; stop excluding one of them.
;;
;; The coverage callbacks MUST be excluded or `cov-guard` is instrumented with a
;; call to itself. The rest of `coil.prop` is excluded for signal: the engine
;; executes far more branches and comparisons than the code under test, and
;; instrumenting it fills the edge map with the generator's own control flow and the
;; comparison table with loop counters. `[*]` applies to every instrumentation kind
;; rather than only the two used today.
(defn fuzz-write-ignorelist [(a (ptr Allocator)) (path (slice u8))] (-> i64)
  (let [(mut cmd) (sb-new a)]
    (sb-push-str! (mut cmd) "printf '[*]\\nfun:coil.prop.*\\nfun:coil.arraylist.*\\nfun:coil.alloc.*\\n' > ")
    (m-shell-quoted! (mut cmd) path)
    (wait-code (primitive/cast i64 (system (str->cstr a (sb-str (load cmd))))))))

;; `coil fuzz <file.coil> [-n N] [--cases N] [--seed N] [--no-run] [--keep]`
(defn fuzz-cmd [(a (ptr Allocator)) (argc i32) (argv (ptr (ptr i8)))] (-> i64)
  (let [self (cstr->slice (load (primitive/index argv 0)))
        fidx (argv-file-idx argc argv 2)]
    (if (= fidx (primitive/cast i64 0))
        (do
          (ps (stderr) "usage: coil fuzz <file.coil> [-n ITERATIONS] [--cases N] [--seed N]\n")
          (exit 2)
          2)
        (let [file (cstr->slice (load (primitive/index argv fidx)))
              text (read-file a (str->cstr a "Coil.toml"))
              project (> (slice-len [u8] text) (primitive/cast i64 0))
              m (if project (parse-manifest a text) (primitive/cast (ptr Manifest) 0))
              outdir
                (cat3-d a
                        ".coil/build/fuzz/"
                        (i64->str a (primitive/ixor (str-hash file) (primitive/cast i64 (getpid)))))
              ir (cat3-d a outdir "/program.ll")
              ignore (cat3-d a outdir "/sancov-ignore.txt")
              out (cat3-d a outdir "/fuzz-runner")
              (mut iters) "100000"
              (mut cases) ""
              (mut seed) ""
              (mut norun) false
              (mut keep) false]
          (let [(mut i) 2]
            (loop (if (>= (load i) (primitive/cast i64 argc))
                      (break)
                      (let [arg (cstr->slice (load (primitive/index argv (load i))))]
                        (cond (= (load i) fidx) (do (store! i (primitive/iadd (load i) 1)) 0)
                              (or (= arg "-n") (= arg "--iterations"))
                                (do
                                  (when (>= (primitive/iadd (load i) 1) (primitive/cast i64 argc))
                                    (ps (stderr) "error: -n needs a count\n")
                                    (exit 2)
                                    0)
                                  (store! iters
                                          (cstr->slice (load (primitive/index argv (primitive/iadd (load i) 1)))))
                                  (store! i (primitive/iadd (load i) 2))
                                  0)
                              (= arg "--cases")
                                (do
                                  (store! cases
                                          (cstr->slice (load (primitive/index argv (primitive/iadd (load i) 1)))))
                                  (store! i (primitive/iadd (load i) 2))
                                  0)
                              (= arg "--seed")
                                (do
                                  (store! seed
                                          (cstr->slice (load (primitive/index argv (primitive/iadd (load i) 1)))))
                                  (store! i (primitive/iadd (load i) 2))
                                  0)
                              (= arg "--no-run") (do (store! norun true) (store! i (primitive/iadd (load i) 1)) 0)
                              (= arg "--keep") (do (store! keep true) (store! i (primitive/iadd (load i) 1)) 0)
                              :else (do (store! i (primitive/iadd (load i) 1)) 0)))))
            (let [(mut mk) (sb-new a)]
              (sb-push-str! (mut mk) "mkdir -p ")
              (m-shell-quoted! (mut mk) outdir)
              (when (!= (wait-code (primitive/cast i64 (system (str->cstr a (sb-str (load mk))))))
                        (primitive/cast i64 0))
                (exit 1)
                0))
            (fuzz-write-ignorelist a ignore)
            ; 1. IR for the whole program, with the test transform loaded so the
            ;    `defprop`s get a `main` to run them.
            (let [(mut b) (sb-new a)]
              (when project (m-prepare-deps a m) (m-emit-dep-env a (mut b) m) 0)
              (sb-push-str! (mut b) self)
              (sb-push-str! (mut b) " emit-ir ")
              (sb-push-str! (mut b) file)
              (sb-push-str! (mut b) " --use coil.assert > ")
              (m-shell-quoted! (mut b) ir)
              (let [rc (wait-code (primitive/cast i64 (system (str->cstr a (sb-str (load b))))))]
                (if (!= rc (primitive/cast i64 0))
                    (do (unless (load keep) (test-cleanup a outdir) 0) (if (= rc (primitive/cast i64 0)) 1 rc))
                    ; 2. Instrument and link. `llvm-config --bindir` names the clang
                    ;    matching the LLVM this compiler was built against; a mismatched
                    ;    clang is the usual cause of a sanitizer runtime that will not
                    ;    link. -O1 deliberately: at higher levels more branches become
                    ;    branchless selects, and a branch with no block of its own has
                    ;    no edge for the search to discover.
                    (let [(mut c) (sb-new a)]
                      (sb-push-str! (mut c)
                                    "\"$(llvm-config --bindir)/clang\" -fsanitize-coverage=trace-pc-guard,trace-cmp -fsanitize-coverage-ignorelist=")
                      (m-shell-quoted! (mut c) ignore)
                      (sb-push-str! (mut c) " -O1 -Wno-override-module ")
                      (m-shell-quoted! (mut c) ir)
                      (sb-push-str! (mut c) " -o ")
                      (m-shell-quoted! (mut c) out)
                      (when project (m-emit-link a (mut c) m) 0)
                      (let [crc (wait-code (primitive/cast i64 (system (str->cstr a (sb-str (load c))))))]
                        (if (!= crc (primitive/cast i64 0))
                            (do
                              (ps (stderr) "error: instrumented build failed (is clang on PATH via llvm-config?)\n")
                              (unless (load keep) (test-cleanup a outdir) 0)
                              crc)
                            (if (load norun)
                                (do
                                  (let [w (stdout)] (ps w "wrote ") (ps w out) (wb w 10))
                                  0)
                                ; 3. Run it, handing the runner its knobs as FLAGS — the
                                ;    same ones `coil test` forwards, read from the
                                ;    runner's own argv via coil.args.
                                (let [(mut r) (sb-new a)]
                                  (m-shell-quoted! (mut r) out)
                                  (sb-push-str! (mut r) " --fuzz ")
                                  (sb-push-str! (mut r) (load iters))
                                  (sb-push-str! (mut r) " --verbose")
                                  (when (> (slice-len [u8] (load cases)) (primitive/cast i64 0))
                                    (sb-push-str! (mut r) " --cases ")
                                    (sb-push-str! (mut r) (load cases))
                                    0)
                                  (when (> (slice-len [u8] (load seed)) (primitive/cast i64 0))
                                    (sb-push-str! (mut r) " --seed ")
                                    (sb-push-str! (mut r) (load seed))
                                    0)
                                  (let [rrc (primitive/cast i64 (system (str->cstr a (sb-str (load r)))))]
                                    (wait-report rrc "fuzz runner")
                                    (let [code (wait-code rrc)]
                                      (unless (load keep) (test-cleanup a outdir) 0)
                                      code)))))))))))))))

(defn test-cmd [(a (ptr Allocator)) (argc i32) (argv (ptr (ptr i8)))] (-> i64)
  (let [self (cstr->slice (load (primitive/index argv 0)))
        fidx (test-file-idx argc argv 2)]
    (if (or (= fidx (primitive/cast i64 0))
            (and (> (slice-len [u8] (read-file a (str->cstr a "Coil.toml"))) (primitive/cast i64 0))
                 (not (d-ends-with? (cstr->slice (load (primitive/index argv fidx))) ".coil"))))
        (project-test-cmd a argc argv)
        (let [file (cstr->slice (load (primitive/index argv fidx)))
              text (read-file a (str->cstr a "Coil.toml"))
              project (> (slice-len [u8] text) (primitive/cast i64 0))
              m (if project (parse-manifest a text) (primitive/cast (ptr Manifest) 0))
              (mut norun) false
              (mut runner-args) (sb-new a)
              outdir
                (cat3-d a
                        ".coil/build/test/"
                        (i64->str a (primitive/ixor (str-hash file) (primitive/cast i64 (getpid)))))
              out (cat3-d a outdir "/test-runner")
              (mut b) (sb-new a)]
          (let [(mut mk) (sb-new a)]
            (sb-push-str! (mut mk) "mkdir -p ")
            (m-shell-quoted! (mut mk) outdir)
            (let [rc (primitive/cast i64 (system (str->cstr a (sb-str (load mk)))))]
              (when (!= (wait-code rc) (primitive/cast i64 0)) (exit 1) 0)))
          (when project
            (m-prepare-deps a m)
            (m-prepare-native-deps a m)
            (m-emit-dep-env a (mut b) m)
            0)
          (sb-push-str! (mut b) self)
          (sb-push-str! (mut b) " build ")
          (sb-push-str! (mut b) file)
          (sb-push-str! (mut b) " -o ")
          (m-shell-quoted! (mut b) out)
          (sb-push-str! (mut b) " --use coil.assert --quiet")
          (when project
            (m-emit-uses a (mut b) m)
            (m-emit-link a (mut b) m)
            (m-cc-sources a (mut b) m)
            (when (load (field m has-target))
              (sb-push-str! (mut b) " --target ")
              (sb-push-str! (mut b) (load (field m target)))
              0)
            0)
          ; forward remaining flags (skip the file positional and stop at `--`).
          (let [(mut i) 2]
            (loop (if (>= (load i) (primitive/cast i64 argc))
                      (break)
                      (let [arg (cstr->slice (load (primitive/index argv (load i))))]
                        (if (= arg "--")
                            (break)
                            (if (= (load i) fidx)
                                (do (store! i (primitive/iadd (load i) 1)) 0)
                                (if (= arg "-o")
                                    (do
                                      (ps (stderr) "error: coil test owns its output path; -o is not supported\n")
                                      (exit 2)
                                      0)
                                    (if (= arg "--no-run")
                                        (do
                                          (store! norun true)
                                          (store! i (primitive/iadd (load i) 1))
                                          0)
                                        (if (test-runner-switch? arg)
                                            (do
                                              (sb-push-str! (mut runner-args) " ")
                                              (sb-push-str! (mut runner-args) arg)
                                              (store! i (primitive/iadd (load i) 1))
                                              0)
                                            (if (test-runner-flag? arg)
                                                (do
                                                  (sb-push-str! (mut runner-args) " ")
                                                  (sb-push-str! (mut runner-args) arg)
                                                  (when (< (primitive/iadd (load i) 1) (primitive/cast i64 argc))
                                                    (sb-push-str! (mut runner-args) " ")
                                                    (sb-push-str! (mut runner-args)
                                                                  (cstr->slice (load (primitive/index argv
                                                                                                      (primitive/iadd (load i)
                                                                                                                      1)))))
                                                    0)
                                                  (store! i (primitive/iadd (load i) 2))
                                                  0)
                                                (do
                                                  (sb-push-str! (mut b) " ")
                                                  (sb-push-str! (mut b) arg)
                                                  (store! i (primitive/iadd (load i) 1))
                                                  0)))))))))))
          (let [brc (primitive/cast i64 (system (str->cstr a (sb-str (load b)))))]
            (if (!= brc (primitive/cast i64 0))
                ; the BUILD failed (compile error already on stderr, or a build signal death).
                (do
                  (wait-report brc "compiler")
                  (let [c (wait-code brc)]
                    (test-cleanup a outdir)
                    (if (= c (primitive/cast i64 0)) 1 c)))
                (if (load norun)
                    (do (test-cleanup a outdir) 0)
                    (let [(mut run) (sb-new a)]
                      (sb-push-str! (mut run) "exec ")
                      (m-shell-quoted! (mut run) out)
                      (sb-push-str! (mut run) (sb-str (load runner-args)))
                      (let [rrc (primitive/cast i64 (system (str->cstr a (sb-str (load run)))))]
                        (wait-report rrc "test runner")
                        (let [rc (wait-code rrc)]
                          (test-cleanup a outdir)
                          rc))))))))))

(defn test-wanted? [(want (ptr (ArrayList (slice u8)))) (name (slice u8))] (-> bool)
  (let [(mut found) false
        (mut i) 0]
    (loop (if (>= (load i) (al-len [(slice u8)] (load want)))
              (break)
              (if (= (al-get [(slice u8)] (load want) (load i)) name)
                  (do (store! found true) (break))
                  (store! i (primitive/iadd (load i) 1)))))
    (load found)))

; True once the manifest declares a suite of its own. The synthesized "default" suite
; does not count: a project that never wrote [test.suites.…] should not start seeing
; suite headers in `coil test --list`.
(defn test-has-named-suites? [(suites (ptr (ArrayList (ptr ManifestSuite))))] (-> bool)
  (let [(mut found) false
        (mut i) 0]
    (loop (if (>= (load i) (al-len [(ptr ManifestSuite)] (load suites)))
              (break)
              (if (= (load (field (al-get [(ptr ManifestSuite)] (load suites) (load i)) name)) "default")
                  (store! i (primitive/iadd (load i) 1))
                  (do (store! found true) (break)))))
    (load found)))

(defn test-print-suite-names [(w (ptr Writer)) (suites (ptr (ArrayList (ptr ManifestSuite))))] (-> i64)
  (let [(mut i) 0]
    (loop (if (>= (load i) (al-len [(ptr ManifestSuite)] (load suites)))
              (break)
              (do
                (when (> (load i) (primitive/cast i64 0)) (ps w ", ") 0)
                (ps w (load (field (al-get [(ptr ManifestSuite)] (load suites) (load i)) name)))
                (store! i (primitive/iadd (load i) 1))))))
  0)

; Which suites this invocation runs. No `--suite` means the default set — that is the
; whole point of the feature: `coil test` runs what a contributor should run without
; thinking, and an expensive suite waits to be asked for by name. `--suite all` takes
; every declared suite regardless of its `default`.
;
; Unknown names are rejected before anything is discovered or built. A typo that
; silently selected nothing would report success having run no tests, which is the one
; failure mode a test runner must never have.
(defn test-select-suites [(a (ptr Allocator)) (m (ptr Manifest)) (want (ptr (ArrayList (slice u8))))] (-> (ptr (ArrayList (ptr ManifestSuite))))
  (let [suites (load (field m suites))
        out
          (unwrap-ptr [(ArrayList (ptr ManifestSuite))]
                      (create [(ArrayList (ptr ManifestSuite))] a))
        (mut want-all) false
        (mut i) 0]
    (store! out (al-new [(ptr ManifestSuite)] a))
    (loop (if (>= (load i) (al-len [(slice u8)] (load want)))
              (break)
              (let [wname (al-get [(slice u8)] (load want) (load i))]
                (if (= wname "all")
                    (store! want-all true)
                    (when (= (primitive/cast i64 (m-find-suite suites wname)) (primitive/cast i64 0))
                      (ps (stderr) "error: unknown test suite '")
                      (ps (stderr) wname)
                      (ps (stderr) "' (known: ")
                      (test-print-suite-names (stderr) suites)
                      (ps (stderr) ")\n")
                      (exit 2)
                      0))
                (store! i (primitive/iadd (load i) 1)))))
    (let [(mut k) 0]
      (loop (if (>= (load k) (al-len [(ptr ManifestSuite)] (load suites)))
                (break)
                (let [s (al-get [(ptr ManifestSuite)] (load suites) (load k))]
                  (when (if (= (al-len [(slice u8)] (load want)) (primitive/cast i64 0))
                            (load (field s is-default))
                            (or (load want-all) (test-wanted? want (load (field s name)))))
                    (al-push! [(ptr ManifestSuite)] out s)
                    0)
                  (store! k (primitive/iadd (load k) 1))))))
    out))

; Append `find <roots> -type f '(' -name '*<suffix>' … ')' [-path '*sel*']` for one suite.
; Returns 0 if the suite contributed nothing because every root is absent.
;
; A root the manifest NAMED must exist: a typo'd root would otherwise discover no files
; and report a green run. A root the compiler GUESSED (the implicit `tests`) is allowed
; to be missing, because a project with no tests directory is legitimate.
(defn test-emit-find! [(a (ptr Allocator))
                       (cmd (mut StrBuf))
                       (s (ptr ManifestSuite))
                       (selector (slice u8))] (-> i64)
  (let [roots (load (field s roots))
        suffixes (load (field s suffixes))
        (mut live) 0
        (mut r) 0]
    (loop (if (>= (load r) (al-len [(slice u8)] (load roots)))
              (break)
              (let [root (al-get [(slice u8)] (load roots) (load r))]
                (if (dir? (str->cstr a root))
                    (store! live (primitive/iadd (load live) 1))
                    (when (load (field s roots-declared))
                      ; located like every other manifest error, so the fix is one jump away.
                      (ps (stderr) "error: Coil.toml:")
                      (ps (stderr) (i64->str a (load (field s line))))
                      (ps (stderr) ": test suite '")
                      (ps (stderr) (load (field s name)))
                      (ps (stderr) "': root '")
                      (ps (stderr) root)
                      (ps (stderr) "' does not exist\n")
                      (exit 2)
                      0))
                (store! r (primitive/iadd (load r) 1)))))
    (if (= (load live) (primitive/cast i64 0))
        0
        (do
          (sb-push-str! (mut cmd) "find ")
          (let [(mut i) 0
                (mut emitted) 0]
            (loop (if (>= (load i) (al-len [(slice u8)] (load roots)))
                      (break)
                      (let [root (al-get [(slice u8)] (load roots) (load i))]
                        (when (dir? (str->cstr a root))
                          (when (> (load emitted) (primitive/cast i64 0)) (sb-push-str! (mut cmd) " ") 0)
                          (m-shell-quoted! (mut cmd) root)
                          (store! emitted (primitive/iadd (load emitted) 1))
                          0)
                        (store! i (primitive/iadd (load i) 1))))))
          (sb-push-str! (mut cmd) " -type f '(' ")
          (let [(mut j) 0]
            (loop (if (>= (load j) (al-len [(slice u8)] (load suffixes)))
                      (break)
                      (do
                        (when (> (load j) (primitive/cast i64 0)) (sb-push-str! (mut cmd) " -o ") 0)
                        (sb-push-str! (mut cmd) "-name ")
                        (m-shell-quoted! (mut cmd)
                                         (cat3-d a "*" (al-get [(slice u8)] (load suffixes) (load j))))
                        (store! j (primitive/iadd (load j) 1))))))
          (sb-push-str! (mut cmd) " ')' ")
          ; the filename selector narrows whatever the suites already chose.
          (when (> (slice-len [u8] selector) (primitive/cast i64 0))
            (sb-push-str! (mut cmd) "-path ")
            (m-shell-quoted! (mut cmd) (cat3-d a "*" (cat3-d a selector "*")))
            (sb-push-str! (mut cmd) " ")
            0)
          1))))

; No-argument test mode discovers independent test roots and lets xargs coordinate
; binaries. Each child comes back through the explicit-file path above, so it gets
; the same manifest inheritance and per-deftest fork isolation — and so an explicit
; `coil test <file>` runs regardless of which suite, if any, claims that file. xargs
; maps any child failure to 123; present the ordinary test failure status 1 to callers.
(defn project-test-cmd [(a (ptr Allocator)) (argc i32) (argv (ptr (ptr i8)))] (-> i64)
  (let [self (cstr->slice (load (primitive/index argv 0)))
        text (read-file a (str->cstr a "Coil.toml"))]
    (if (= (slice-len [u8] text) (primitive/cast i64 0))
        (do (ps (stderr) "error: no Coil.toml in the current directory\n") 1)
        (let [m (parse-manifest a text)
              want (unwrap-ptr [(ArrayList (slice u8))] (create [(ArrayList (slice u8))] a))
              (mut jobs) 1
              (mut list) false
              (mut norun) false
              (mut selector) ""
              (mut i) 2]
          (store! want (al-new [(slice u8)] a))
          (loop (if (>= (load i) (primitive/cast i64 argc))
                    (break)
                    (let [arg (cstr->slice (load (primitive/index argv (load i))))]
                      (cond (= arg "--suite")
                              (do
                                (when (>= (primitive/iadd (load i) 1) (primitive/cast i64 argc))
                                  (ps (stderr) "error: --suite needs a suite name\n")
                                  (exit 2)
                                  0)
                                (al-push! [(slice u8)]
                                          want
                                          (cstr->slice (load (primitive/index argv
                                                                              (primitive/iadd (load i) 1)))))
                                (store! i (primitive/iadd (load i) 2))
                                0)
                            (= arg "--list")
                              (do
                                (store! list true)
                                (store! i (primitive/iadd (load i) 1))
                                0)
                            (= arg "--no-run")
                              (do
                                (store! norun true)
                                (store! i (primitive/iadd (load i) 1))
                                0)
                            (= arg "--jobs")
                              (do
                                (when (>= (primitive/iadd (load i) 1) (primitive/cast i64 argc))
                                  (ps (stderr) "error: --jobs needs a positive count\n")
                                  (exit 2)
                                  0)
                                (match (parse-int (cstr->slice (load (primitive/index argv
                                                                                      (primitive/iadd (load i)
                                                                                                      1)))))
                                  (Some [n]
                                        (if (> n (primitive/cast i64 0))
                                            (store! jobs n)
                                            (do (ps (stderr) "error: --jobs needs a positive count\n") (exit 2) 0)))
                                  (None [] (do (ps (stderr) "error: --jobs needs a positive count\n") (exit 2) 0)))
                                (store! i (primitive/iadd (load i) 2))
                                0)
                            (is-flag? arg)
                              (do
                                (ps (stderr) "error: unknown project test flag '")
                                (ps (stderr) arg)
                                (ps (stderr) "'\n")
                                (exit 2)
                                0)
                            :else
                              (do
                                (store! selector arg)
                                (store! i (primitive/iadd (load i) 1))
                                0)))))
          ; Discovery is a SIBLING of the argument loop, not part of its body. When it
          ; sat inside, every flag past the first re-ran the whole discovery: `coil test
          ; --list --jobs 2` listed once with the default job count and again with 2.
          (let [chosen (test-select-suites a m want)
                n-chosen (al-len [(ptr ManifestSuite)] (load chosen))
                ; grouping only earns its weight once a manifest actually declares
                ; suites; a project that never heard of them sees the flat list it
                ; always saw.
                grouped (and (load list) (test-has-named-suites? (load (field m suites))))
                (mut cmd) (sb-new a)
                (mut emitted) 0
                (mut k) 0]
            (when (= n-chosen (primitive/cast i64 0))
              (ps (stdout) "no test suites selected\n")
              (exit 0)
              0)
            ; Each suite contributes one `find`; the group feeds a single sort so the
            ; whole run stays one sorted stream no matter how many suites are in play.
            (sb-push-str! (mut cmd) "{ ")
            (loop (if (>= (load k) n-chosen)
                      (break)
                      (let [s (al-get [(ptr ManifestSuite)] (load chosen) (load k))
                            (mut one) (sb-new a)]
                        (when (= (test-emit-find! a (mut one) s (load selector)) (primitive/cast i64 1))
                          (when grouped
                            (sb-push-str! (mut cmd) "echo ")
                            (m-shell-quoted! (mut cmd)
                                             (cat3-d a
                                                     (load (field s name))
                                                     (if (load (field s is-default)) ":" " [opt-in]:")))
                            (sb-push-str! (mut cmd) "; ")
                            0)
                          (sb-push-str! (mut cmd) (sb-str (load one)))
                          (if (load list)
                              (if grouped
                                  (sb-push-str! (mut cmd) "-print | LC_ALL=C sort | sed 's/^/  /'; ")
                                  (sb-push-str! (mut cmd) "-print; "))
                              (sb-push-str! (mut cmd) "-print0; "))
                          (store! emitted (primitive/iadd (load emitted) 1))
                          0)
                        (store! k (primitive/iadd (load k) 1)))))
            (sb-push-str! (mut cmd) "}")
            (if (= (load emitted) (primitive/cast i64 0))
                ; every selected suite's roots are absent — nothing to discover, and
                ; nothing was configured wrongly (declared roots are checked above).
                (if (load list) 0 (do (ps (stdout) "all test suites passed\n") 0))
                (do
                  (cond grouped 0
                        (load list) (sb-push-str! (mut cmd) " | LC_ALL=C sort")
                        :else
                          (do
                            ; -u so overlapping suite roots cannot run one file twice.
                            (sb-push-str! (mut cmd) " | LC_ALL=C sort -zu | xargs -0 -r -n 1 -P ")
                            (sb-push-str! (mut cmd) (i64->str a (load jobs)))
                            (sb-push-str! (mut cmd) " ")
                            (m-shell-quoted! (mut cmd) self)
                            (sb-push-str! (mut cmd) " test")
                            (when (load norun) (sb-push-str! (mut cmd) " --no-run") 0)))
                  (let [rc (wait-code (primitive/cast i64 (system (str->cstr a (sb-str (load cmd))))))]
                    (if (load list)
                        rc
                        (if (= rc (primitive/cast i64 0))
                            (do (ps (stdout) "all test suites passed\n") 0)
                            (do
                              (ps (stderr) "one or more test suites failed\n")
                              (if (= rc (primitive/cast i64 123)) 1 rc))))))))))))

(defn check-one [(a (ptr Allocator)) (path (ptr i8)) (triple (ptr i8))] (-> i64)
  (set-target-arch! triple)
  (when (= (run-dump-on-big-stack a
                                  (read-src a path)
                                  (cwd-slice a)
                                  (cstr->slice path)
                                  (primitive/fnptr-of check-src-program))
           (primitive/cast i64 0))
    1))

(defn project-check-cmd [(a (ptr Allocator)) (argc i32) (argv (ptr (ptr i8)))] (-> i64)
  (let [self (cstr->slice (load (primitive/index argv 0)))
        text (read-file a (str->cstr a "Coil.toml"))]
    (if (= (slice-len [u8] text) (primitive/cast i64 0))
        (do (ps (stderr) "error: no Coil.toml in the current directory\n") 1)
        (let [m (parse-manifest a text)
              entry
                (if (> (slice-len [u8] (load (field m entry))) (primitive/cast i64 0))
                    (load (field m entry))
                    "src/main.coil")
              tests-only
                (and (>= (primitive/cast i64 argc) (primitive/cast i64 4))
                     (and (= (cstr->slice (load (primitive/index argv 2))) "--target")
                          (= (cstr->slice (load (primitive/index argv 3))) "tests")))
              (mut cmd) (sb-new a)]
          (m-prepare-deps a m)
          (unless tests-only
            ; A project check deliberately performs the final project link. That is
            ; what validates native objects/libraries in addition to instantiating
            ; the entry graph; its artifact is compiler-owned and never the package
            ; output named by [build].
            (sb-push-str! (mut cmd) "mkdir -p '.coil/build/check' && ")
            (m-shell-quoted! (mut cmd) self)
            (sb-push-str! (mut cmd) " build -o '.coil/build/check/project' ")
            (sb-push-str! (mut cmd) " && ")
            0)
          (m-shell-quoted! (mut cmd) self)
          (sb-push-str! (mut cmd) " test --no-run")
          (wait-code (primitive/cast i64 (system (str->cstr a (sb-str (load cmd))))))))))

(defn verify-cmd [(a (ptr Allocator)) (argc i32) (argv (ptr (ptr i8)))] (-> i64)
  (let [self (cstr->slice (load (primitive/index argv 0)))
        text (read-file a (str->cstr a "Coil.toml"))]
    (if (= (slice-len [u8] text) (primitive/cast i64 0))
        (do (ps (stderr) "error: no Coil.toml in the current directory\n") 1)
        (do
          ; Parsing first makes manifest validation a distinct, early verification phase.
          (parse-manifest a text)
          (let [(mut cmd) (sb-new a)]
            (m-shell-quoted! (mut cmd) self)
            (sb-push-str! (mut cmd) " fmt --check && ")
            (m-shell-quoted! (mut cmd) self)
            (sb-push-str! (mut cmd) " lint && ")
            (m-shell-quoted! (mut cmd) self)
            (sb-push-str! (mut cmd) " check && ")
            (m-shell-quoted! (mut cmd) self)
            (sb-push-str! (mut cmd) " test")
            (wait-code (primitive/cast i64 (system (str->cstr a (sb-str (load cmd)))))))))))

; small local concat (avoid depending on cimport's cat3).
(defn cat3-d [(a (ptr Allocator)) (x (slice u8)) (y (slice u8))] (-> (slice u8))
  (match (str-concat a x y) (Some [s] s) (None [] x)))

; ---- file output + project scaffold (new) ----------------------------------
; externs are global C symbols; these coincide harmlessly with cimport.coil's.
(extern fopen :cc c [(ptr i8) (ptr i8)] (-> (ptr i8)))
(extern fwrite :cc c [(ptr i8) i64 i64 (ptr i8)] (-> i64))
(extern fclose :cc c [(ptr i8)] (-> i32))
(extern getpid :cc c [] (-> i32))

(defn d-write-file [(a (ptr Allocator)) (path (slice u8)) (content (slice u8))] (-> i64)
  (let [f (fopen (str->cstr a path) (str->cstr a "wb"))]
    (if (= (primitive/cast i64 f) (primitive/cast i64 0))
        (do (ps (stderr) "error: cannot write ") (ps (stderr) path) (wb (stderr) 10) 1)
        (do
          (fwrite (primitive/cast (ptr i8) (slice-data [u8] content)) 1 (slice-len [u8] content) f)
          (fclose f)
          0))))

; Final Wasm linking is a Coil binary transformation, not a child process.
(defn wasm-link-object [(a (ptr Allocator)) (obj-path (ptr i8)) (out-path (slice u8))] (-> i64)
  (match (wasm-finalize a (read-file a obj-path))
    (Ok [module] (d-write-file a out-path module))
    (Err [why] (do (ps (stderr) why) (wb (stderr) 10) 1))))

; `fmt [--check|--write] <file>` — the Coil source formatter (src/compiler/formatter/rules.coil). Prints
; the formatted source, or with --write rewrites the file, or with --check exits 1 if
; the file isn't already formatted. Width 120, Clojure indentation conventions.
; exit codes follow gofmt/black: 0 clean, 1 unformatted (--check), 2 error. `--check`
; must distinguish "your file is unformatted" from "your invocation is broken", or a CI
; gate cannot tell a real violation from a typo'd path.
(defn fmt-one [(a (ptr Allocator)) (pathc (ptr i8)) (check bool) (write bool)] (-> i64)
  (if (dir? pathc)
      (let [w (stderr)]
        (ps w "error: '")
        (ps w (cstr->slice pathc))
        (ps w "' is a directory")
        (wb w 10)
        2)
      (let [src (read-src-rc a pathc 2)
            out (fmtr/format-src a src 120)
            same (= src out)]
        (if check
            (unless same (ps (stderr) "not formatted: ") (ps (stderr) (cstr->slice pathc)) (wb (stderr) 10) 1)
            (if write
                (unless same (d-write-file a (cstr->slice pathc) out))
                (do (ps (stdout) out) 0))))))

; ============================ `coil balance` ================================
; Repair unbalanced ()/[] — the companion to `fmt` for source that will not read at
; all. See src/compiler/formatter/balance.coil for what it will and will not do; the
; short version is that it only ever inserts a missing closer or deletes an
; unambiguous stray one, never moves a delimiter, and refuses anything indentation
; does not settle. Exit codes match `fmt`: 0 balanced, 1 unbalanced under --check,
; 2 error or refusal.
; Does this candidate source pass the front end?
;
; Diagnostics are silenced and the collectors reset around the attempt, because a
; candidate that fails is the POINT — it is how a wrong nesting is detected — and its
; errors belong to a hypothesis, not to the user. Same arrangement `lint --fix` uses to
; try a round and revert it.
; Like `check-src-program`, but reporting into a null writer. `set-diag-quiet` alone is
; not enough: the pipeline also writes located diagnostics to the writer it is handed,
; and `check-src-program` hands it stderr — so a rejected candidate printed its errors
; over the user's terminal, which reads as though `balance` had failed when in fact it
; was working exactly as designed.
(defn check-src-quiet [(a (ptr Allocator)) (src (slice u8)) (cwd (slice u8)) (path (slice u8))] (-> i64)
  (let [w (null-writer)
        (mut sp0) (al-new [(slice u8)] a)
        (mut st0) (al-new [(slice u8)] a)]
    (match (run-pipeline a src cwd w path (mut sp0) (mut st0))
      (Some [_] 1)
      (None [] 0))))

; ---- ~/.coil/balance-log.jsonl ---------------------------------------------
; One line per `coil balance` run, appended locally. Nothing is transmitted anywhere,
; and no source text is recorded — a path, an outcome, a cause, and four counters.
;
; It exists because the aggregate numbers from the mutation corpus describe damage
; that a script invented, and the refusals that actually matter are the ones hit on
; real half-edited files. Which cause dominates there decides what to fix next, and
; guessing at that from a synthetic benchmark is how tools get tuned for the wrong
; population. Read it with `coil balance --stats`, or with jq for the full picture.
;
; Set COIL_BALANCE_LOG=0 to turn it off. A write that fails is ignored: a repair tool
; must never fail because its bookkeeping did.
(extern mkdir :cc c [(ptr i8) i32] (-> i32))

(defn stats-enabled? [(a (ptr Allocator))] (-> bool)
  (let [off (getenv (str->cstr a "COIL_BALANCE_LOG"))
        home (getenv (str->cstr a "HOME"))]
    (if (= (primitive/cast i64 home) (primitive/cast i64 0))
        false
        (if (= (primitive/cast i64 off) (primitive/cast i64 0))
            true
            (!= (cstr->slice off) "0")))))

(defn stats-path [(a (ptr Allocator))] (-> (slice u8))
  (let [h (getenv (str->cstr a "HOME"))
        (mut b) (sb-new a)]
    (if (= (primitive/cast i64 h) (primitive/cast i64 0))
        ""
        (do
          (sb-push-str! (mut b) (cstr->slice h))
          (sb-push-str! (mut b) "/.coil")
          (native-only (mkdir (str->cstr a (sb-str (load b))) (primitive/cast i32 493)) 0)
          (sb-push-str! (mut b) "/balance-log.jsonl")
          (sb-str (load b))))))

; A path may contain a quote or a backslash, and one unescaped byte would make every
; later line unparseable to anything reading the file as JSON.
(defn json-str! [(b (mut StrBuf)) (s (slice u8))] (-> i64)
  (let [n (slice-len s)
        (mut i) 0]
    (sb-push-byte! (mut b) (primitive/cast u8 34))
    (loop (if (>= (load i) n)
              (break)
              (let [c (primitive/cast i64 (slice-get s (load i)))]
                (cond (or (= c 34) (= c 92))
                        (do
                          (sb-push-byte! (mut b) (primitive/cast u8 92))
                          (sb-push-byte! (mut b) (primitive/cast u8 c))
                          0)
                      (< c 32) (sb-push-byte! (mut b) (primitive/cast u8 32))
                      :else (sb-push-byte! (mut b) (primitive/cast u8 c)))
                (store! i (primitive/iadd (load i) 1))
                0)))
    (sb-push-byte! (mut b) (primitive/cast u8 34))
    0))

; `dump-dec` writes to a Writer; the log builds a StrBuf, so this is the same
; conversion done by hand rather than routed through an io buffer for four small ints.
(defn sb-push-dec! [(b (mut StrBuf)) (n i64)] (-> i64)
  (if (< n (primitive/cast i64 0))
      (do (sb-push-byte! (mut b) (primitive/cast u8 45)) (sb-push-dec! (mut b) (primitive/isub 0 n)))
      (do
        (when (>= n (primitive/cast i64 10)) (sb-push-dec! (mut b) (primitive/udiv n 10)) 0)
        (sb-push-byte! (mut b) (primitive/cast u8 (primitive/iadd (primitive/urem n 10) 48)))
        0)))

(defn stats-log! [(a (ptr Allocator))
                  (path (slice u8))
                  (outcome (slice u8))
                  (cause (slice u8))
                  (tried i64)
                  (matches i64)
                  (guessed i64)
                  (capped bool)] (-> i64)
  (if (not (stats-enabled? a))
      0
      (let [lp (stats-path a)]
        (if (= lp "")
            0
            (let [(mut b) (sb-new a)]
              (sb-push-str! (mut b) "{\"t\":")
              ; A clock that cannot be read is not a reason to lose the record: stamp 0
              ; and keep the line, since the outcome and cause are what get counted.
              (sb-push-dec! (mut b)
                            (try (let [ms (try-or! (time/wall-now-ms) 0)] (primitive/udiv ms 1000))))
              (sb-push-str! (mut b) ",\"cmd\":\"balance\",\"path\":")
              (json-str! (mut b) path)
              (sb-push-str! (mut b) ",\"outcome\":")
              (json-str! (mut b) outcome)
              (sb-push-str! (mut b) ",\"cause\":")
              (json-str! (mut b) cause)
              (sb-push-str! (mut b) ",\"tried\":")
              (sb-push-dec! (mut b) tried)
              (sb-push-str! (mut b) ",\"matches\":")
              (sb-push-dec! (mut b) matches)
              (sb-push-str! (mut b) ",\"guessed\":")
              (sb-push-dec! (mut b) guessed)
              (sb-push-str! (mut b) ",\"capped\":")
              (sb-push-str! (mut b) (if capped "true" "false"))
              (sb-push-str! (mut b) "}\n")
              (let [f (fopen (str->cstr a lp) (str->cstr a "ab"))]
                (if (= (primitive/cast i64 f) (primitive/cast i64 0))
                    0
                    (do
                      (fwrite (primitive/cast (ptr i8) (slice-data (sb-str (load b))))
                              1
                              (slice-len (sb-str (load b)))
                              f)
                      (fclose f)
                      0))))))))

; Check one candidate IN A FORKED CHILD, and read the verdict from its exit status.
;
; Not an optimisation — a hard requirement. A front-end run allocates its whole world
; (imports, AST, types, mono) into the allocator it is handed and never frees any of
; it, and `run-on-big-stack` reserves a 512 MiB worker stack per call. In-process that
; is fine ONCE and ruinous in a loop: checking a few dozen candidates this way grew a
; single `coil balance` to tens of gigabytes of resident memory. Forking makes the OS
; the deallocator, so peak memory is one compile no matter how many are tried.
;
; `coil test` forks per test for the same reason plus isolation; this is that pattern.
;; Expands to `body` on a native target and to `false` on wasm.
;;
;; This has to be decided at COMPILE time, not at runtime. On the wasm target an
;; `extern … :cc c` that is declared but never defined becomes a required host import,
;; so merely REFERENCING fork makes every embedder of the wasm compiler supply an
;; `env.fork` that cannot mean anything — the module validates and then dies at
;; instantiate with "function import requires a callable". A runtime guard would not
;; help, because the reference would still be there. Compiling the path out removes
;; the reference, and with it the import.
;;
;; `false` is also the honest ANSWER on wasm: there is no fork, so no candidate can be
;; verified — and `candidate-checks?` already treats "cannot verify" as a refusal
;; rather than falling back to the unbounded in-process run this exists to avoid. So
;; `coil balance` on a wasm-hosted compiler degrades to the indentation-only answer,
;; which is exactly what `--no-typecheck` gives.
(defn if-can-fork [(body Code)] (-> Code)
  (native-only body `false))

;; `body` on a native target, `alt` on wasm — the general form of the rule above.
;;
;; Worth stating once, because it caught three separate imports in this file: on wasm
;; an `extern … :cc c` that is declared but never defined becomes a REQUIRED host
;; import, and a reference is enough to create one. Whether the call can ever execute
;; is irrelevant; a runtime guard does not help. Every embedder of the wasm compiler
;; then has to supply the capability, so a name referenced here is a line in a contract
;; with people who will never call it.
(defn native-only [(body Code) (alt Code)] (-> Code)
  (if (primitive/code-eq (primitive/target-os) `wasm) alt body))

(defn candidate-checks? [(a (ptr Allocator)) (src (slice u8)) (path (slice u8))] (-> bool)
  (if-can-fork (let [stp (alloc/stack i32)
                     pid (os/fork)]
                 (cond ; Fork failed. Report "cannot verify" rather than falling back to an in-process
                       ; run: the fallback is exactly the unbounded path this exists to avoid, and an
                       ; unverified candidate must never be written.
                       (< pid (primitive/cast i32 0)) false
                       (= pid (primitive/cast i32 0))
                         (do
                           (sug-reset)
                           (diag-reset)
                           (set-diag-quiet true)
                           (os/_exit (primitive/cast i32
                                                     (if (= (run-dump-on-big-stack a
                                                                                   src
                                                                                   (cwd-slice a)
                                                                                   path
                                                                                   (primitive/fnptr-of check-src-quiet))
                                                            1)
                                                         0
                                                         1)))
                           false)
                       :else
                         (do
                           (os/waitpid pid stp 0)
                           (= (wait-code (primitive/cast i64 (load stp))) (primitive/cast i64 0)))))))

; Ask the type checker which balancing is Coil.
;
; Indentation cannot separate two balancings of the same LINE, and cannot tell a stray
; closer from a missing opener, because in both cases the bytes are identical and both
; readings parse. Semantics can: moving a closer changes an arity, a binding position,
; or a body. So enumerate the single-character repairs that balance and take the first
; that compiles — `balance-candidates` puts the indentation-derived answer first, so
; the usual case costs one compile and confirms what indentation already said.
;
; Returns the accepted text and how many candidates were tried, or an empty slice when
; none compiled. None compiling is the ordinary state of a file being edited, not a
; failure: the caller falls back to the indentation answer and says so.
; How much verification a repair needs depends on how much of it was guessed.
;
; `primary-ok` is whether the INDENTATION-derived answer compiles. When indentation
; genuinely derived that answer — every closer placed at a line boundary the layout
; forced — and the type checker then accepts it, two independent signals agree and
; that is enough. On the mutation corpus every mis-nested repair failed to compile,
; so an answer indentation derived AND semantics accepts is about as pinned down as a
; delimiter can be.
;
; When indentation only GUESSED (a closer belonging somewhere inside a line, where
; every position balances), agreement proves much less: the guess may compile by luck
; while another placement compiles too. Those need `matches` to be exactly 1 — the
; guessed reading must be the only well-typed one in the whole candidate set.
;
; Counting stops at 2, since ambiguity is proven by the second match and nothing after
; it changes the answer.
(defstruct Adjudged
  [(text (slice u8)) (tried i64) (matches i64) (capped bool) (has-primary bool) (primary-ok bool)])

(defn adjudicate [(a (ptr Allocator)) (src (slice u8)) (path (slice u8)) (adj (ptr Adjudged))] (-> i64)
  (let [cs (alloc/stack bal/Cands)
        (mut i) 0]
    (bal/balance-candidates a src 24 cs)
    (let [cands (load (field cs texts))
          n (al-len [(slice u8)] cands)]
      (store! (field adj text) "")
      (store! (field adj tried) 0)
      (store! (field adj matches) 0)
      (store! (field adj capped) (load (field cs capped)))
      (store! (field adj has-primary) false)
      (store! (field adj primary-ok) false)
      ; Candidate 0 is the indentation answer when `balance-src` produced one; it is
      ; absent only when indentation declined outright.
      (match (bal/balance-src a src false)
        (bal/BFixed [_ _ _ _ _] (store! (field adj has-primary) true))
        (bal/BClean [] 0)
        (bal/BRefused [_ _ _ _] 0))
      (loop (if (or (>= (load i) n) (>= (load (field adj matches)) (primitive/cast i64 2)))
                (break)
                (do
                  (store! (field adj tried) (primitive/iadd (load (field adj tried)) 1))
                  (when (candidate-checks? a (al-get [(slice u8)] cands (load i)) path)
                    (when (= (load (field adj matches)) (primitive/cast i64 0))
                      (store! (field adj text) (al-get [(slice u8)] cands (load i)))
                      0)
                    (when (and (= (load i) (primitive/cast i64 0)) (load (field adj has-primary)))
                      (store! (field adj primary-ok) true)
                      0)
                    (store! (field adj matches) (primitive/iadd (load (field adj matches)) 1))
                    0)
                  (store! i (primitive/iadd (load i) 1))
                  ; A DERIVED answer that compiles needs no alternatives: indentation
                  ; placed every closer at a boundary the layout forced, and semantics
                  ; agreed. Stopping here makes the ordinary repair exactly one compile
                  ; instead of one per candidate.
                  (when (and (load (field adj primary-ok)) (= (load (field cs guessed)) (primitive/cast i64 0)))
                    (store! i n)
                    0))))
      0)))

(defn balance-one [(a (ptr Allocator)) (pathc (ptr i8)) (check bool) (write bool) (strict bool) (use-check bool)] (-> i64)
  (if (dir? pathc)
      (let [w (stderr)]
        (ps w "error: '")
        (ps w (cstr->slice pathc))
        (ps w "' is a directory")
        (wb w 10)
        2)
      (let [path (cstr->slice pathc)
            src (read-src-rc a pathc 2)
            adj (alloc/stack Adjudged)
            ; The checker only earns its cost when there is damage to resolve and a
            ; result to produce; `--check` just answers whether the file balances.
            consult (and use-check (not check))]
        (match (bal/balance-src a src strict)
          (bal/BClean []
                      (do
                        (unless check (stats-log! a path "clean" "" 0 0 0 false) 0)
                        (if (or check write) 0 (do (ps (stdout) src) 0))))
          (bal/BRefused [rcode why line col]
                        (if check
                            1
                            (do
                              (when consult (adjudicate a src path adj) 0)
                              (if consult
                                  (balance-adjudicated a path adj write 0 true rcode why line col)
                                  (balance-refusal path why line col)))))
          (bal/BFixed [text ins del guessed guess-line]
                      (if check
                          (let [w (stderr)]
                            (ps w "unbalanced: ")
                            (ps w path)
                            (wb w 10)
                            1)
                          (if consult
                              (do
                                (adjudicate a src path adj)
                                (balance-adjudicated a path adj write guessed false "" "" 0 0))
                              ; --no-typecheck: the indentation answer, unverified. This
                              ; is the one mode that can still produce a file that reads
                              ; and means something else, so it says which closers were
                              ; not derived rather than presenting all of them as facts.
                              (do
                                (when (> guessed 0)
                                  (let [w (stderr)]
                                    (ps w "note: ")
                                    (ps w path)
                                    (ps w ": ")
                                    (dump-dec w guessed)
                                    (ps w
                                        " closer(s) placed inside a single line, where indentation cannot say where they belong; first at line ")
                                    (dump-dec w guess-line)
                                    (wb w 10))
                                  0)
                                (stats-log! a path "repaired" "no-typecheck" 0 0 guessed false)
                                (balance-emit a path text write)))))))))

; Write only a repair the type checker endorses, at the strength its derivation needs.
;
; A DERIVED answer that compiles is written: indentation and semantics agreed, by
; different means. A GUESSED one is written only if it is the only well-typed reading
; in the whole candidate set. Everything else refuses — because the alternative is a
; file that reads, compiles, and quietly does something other than what it says, and
; that costs more to find than any refusal costs to work around.
(defn balance-adjudicated [(a (ptr Allocator))
                           (path (slice u8))
                           (adj (ptr Adjudged))
                           (write bool)
                           (guessed i64)
                           (had-refusal bool)
                           (rcode (slice u8))
                           (why (slice u8))
                           (line i64)
                           (col i64)] (-> i64)
  (let [m (load (field adj matches))
        tried (load (field adj tried))
        derived (and (load (field adj primary-ok)) (= guessed 0))
        w (stderr)]
    (cond derived
            (do
              (when had-refusal
                (balance-note path "resolved by the type checker, which indentation could not" 0)
                0)
              (stats-log! a path "repaired" "derived" tried m guessed false)
              (balance-emit a path (load (field adj text)) write))
          ; BEFORE the uniqueness test, not after: a capped enumeration is INCOMPLETE, so
          ; "exactly one of the candidates compiled" says nothing about the ones never
          ; generated. Testing uniqueness first let a truncated set look decisive, which is
          ; precisely how the last two divergences got written.
          (load (field adj capped))
            (do
              (stats-log! a path "refused" "capped" tried m guessed true)
              (ps w "error: ")
              (ps w path)
              (ps w
                  ": too many possible balancings to check them all, so none can be shown to be the only one that compiles")
              (wb w 10)
              2)
          (= m 1)
            (do
              (balance-note path
                            "indentation could not place this; the type checker did, as the only reading that compiles"
                            0)
              (stats-log! a path "repaired" "adjudicated" tried m guessed false)
              (balance-emit a path (load (field adj text)) write))
          (>= m 2)
            (do
              (stats-log! a path "refused" "ambiguous-compile" tried m guessed false)
              (ps w "error: ")
              (ps w path)
              (ps w
                  ": indentation cannot place the missing delimiter, and several placements all compile; refusing rather than picking one")
              (wb w 10)
              2)
          ; Indentation's own cause is more specific than "nothing compiled", so when it
          ; had one, that is what gets counted.
          had-refusal
            (do
              (stats-log! a path "refused" rcode tried m guessed false)
              (balance-refusal path why line col))
          :else
            (do
              (stats-log! a path "refused" "none-compile" tried m guessed false)
              (ps w "error: ")
              (ps w path)
              (ps w
                  ": no way of balancing this file compiles, so the delimiters cannot be placed by meaning; fix the other errors first, or use --no-typecheck for the indentation-only answer")
              (wb w 10)
              2))))

(defn balance-emit [(a (ptr Allocator)) (path (slice u8)) (text (slice u8)) (write bool)] (-> i64)
  (if write (d-write-file a path text) (do (ps (stdout) text) 0)))

; ---- `coil balance --stats` ------------------------------------------------
; Counts `"cause":"…"` occurrences rather than parsing JSON, which is honest here
; because this program is the only writer of the file and escapes every value it
; emits. jq gives the full picture; this answers the one question worth asking often:
; which cause is actually costing you repairs.
(defn count-substr [(hay (slice u8)) (needle (slice u8))] (-> i64)
  (let [n (slice-len hay)
        m (slice-len needle)
        (mut i) 0
        (mut c) 0]
    (loop (if (or (= m (primitive/cast i64 0)) (> (primitive/iadd (load i) m) n))
              (break)
              (do
                (when (= (subslice hay (load i) (primitive/iadd (load i) m)) needle)
                  (store! c (primitive/iadd (load c) 1))
                  0)
                (store! i (primitive/iadd (load i) 1)))))
    (load c)))

(defn stats-row [(w (ptr Writer)) (label (slice u8)) (n i64) (total i64)] (-> i64)
  (when (> n 0)
    (ps w "  ")
    (ps w label)
    (let [pad (primitive/isub 22 (slice-len label))
          (mut k) 0]
      (loop (if (>= (load k) pad) (break) (do (wb w 32) (store! k (primitive/iadd (load k) 1))))))
    (dump-dec w n)
    (when (> total 0)
      (ps w "  (")
      (dump-dec w (primitive/udiv (primitive/imul n 100) total))
      (ps w "%)"))
    (wb w 10)
    0)
  0)

(defn cause-count [(log (slice u8)) (a (ptr Allocator)) (name (slice u8))] (-> i64)
  (let [(mut b) (sb-new a)]
    (sb-push-str! (mut b) "\"cause\":\"")
    (sb-push-str! (mut b) name)
    (sb-push-str! (mut b) "\"")
    (count-substr log (sb-str (load b)))))

(defn balance-stats-cmd [(a (ptr Allocator))] (-> i64)
  (let [lp (stats-path a)
        w (stdout)]
    (if (= lp "")
        (do (ps (stderr) "error: no HOME, so there is no ~/.coil to read\n") 2)
        (let [log (read-file a (str->cstr a lp))]
          (if (= (slice-len [u8] log) (primitive/cast i64 0))
              (do
                (ps w "no runs recorded yet at ")
                (ps w lp)
                (wb w 10)
                0)
              (let [runs (count-substr log "{\"t\":")
                    repaired (count-substr log "\"outcome\":\"repaired\"")
                    refused (count-substr log "\"outcome\":\"refused\"")
                    clean (count-substr log "\"outcome\":\"clean\"")
                    damaged (primitive/iadd repaired refused)]
                (ps w "coil balance — ")
                (dump-dec w runs)
                (ps w " runs recorded in ")
                (ps w lp)
                (wb w 10)
                (wb w 10)
                (stats-row w "already balanced" clean runs)
                (stats-row w "repaired" repaired runs)
                (stats-row w "refused" refused runs)
                (when (> damaged 0)
                  (wb w 10)
                  (ps w "of the ")
                  (dump-dec w damaged)
                  (ps w " damaged files, how each was decided:")
                  (wb w 10)
                  (stats-row w "derived" (cause-count log a "derived") damaged)
                  (stats-row w "adjudicated" (cause-count log a "adjudicated") damaged)
                  (stats-row w "no-typecheck" (cause-count log a "no-typecheck") damaged)
                  (wb w 10)
                  (ps w "why the refusals happened:")
                  (wb w 10)
                  (stats-row w "none-compile" (cause-count log a "none-compile") refused)
                  (stats-row w "ambiguous-compile" (cause-count log a "ambiguous-compile") refused)
                  (stats-row w "capped" (cause-count log a "capped") refused)
                  (stats-row w "surplus-ambiguous" (cause-count log a "surplus-ambiguous") refused)
                  (stats-row w "mismatch" (cause-count log a "mismatch") refused)
                  (stats-row w "move-required" (cause-count log a "move-required") refused)
                  (stats-row w "inside-line" (cause-count log a "inside-line") refused)
                  (stats-row w "no-place" (cause-count log a "no-place") refused)
                  (stats-row w "over-fire" (cause-count log a "over-fire") refused)
                  (stats-row w "underflow" (cause-count log a "underflow") refused)
                  (stats-row w "indent-disagree" (cause-count log a "indent-disagree") refused)
                  (stats-row w "unterminated-string" (cause-count log a "unterminated-string") refused)
                  (stats-row w "internal" (cause-count log a "internal") refused)
                  0)
                0))))))

; `line` of 0 means the message stands alone; otherwise it is appended.
(defn balance-note [(path (slice u8)) (msg (slice u8)) (line i64)] (-> i64)
  (let [w (stderr)]
    (ps w "note: ")
    (ps w path)
    (ps w ": ")
    (ps w msg)
    (when (> line 0) (dump-dec w line) 0)
    (wb w 10)
    0))

(defn balance-refusal [(path (slice u8)) (why (slice u8)) (line i64) (col i64)] (-> i64)
  (let [w (stderr)]
    (ps w "error: ")
    (ps w why)
    (wb w 10)
    (ps w "  --> ")
    (ps w path)
    (wb w 58)
    (dump-dec w line)
    (wb w 58)
    (dump-dec w col)
    (wb w 10)
    2))

(defn balance-cmd [(a (ptr Allocator)) (argc i32) (argv (ptr (ptr i8)))] (-> i64)
  (let [(mut check) false
        (mut write) false
        (mut strict) false
        (mut stats) false
        (mut use-check) true
        (mut nfiles) 0
        (mut rc) 0
        (mut i) 2]
    (loop (if (>= (load i) (primitive/cast i64 argc))
              (break)
              (do
                (let [arg (cstr->slice (load (primitive/index argv (load i))))]
                  (when (is-flag? arg)
                    (cond (= arg "--stats") (store! stats true)
                          (= arg "--check") (store! check true)
                          (= arg "--write") (store! write true)
                          (= arg "--strict") (store! strict true)
                          (= arg "--no-typecheck") (store! use-check false)
                          :else
                            (let [w (stderr)]
                              (ps w "error: unknown flag '")
                              (ps w arg)
                              (ps w "'")
                              (wb w 10)
                              (exit 2)
                              0))))
                (store! i (primitive/iadd (load i) 1)))))
    (store! i 2)
    (loop (if (>= (load i) (primitive/cast i64 argc))
              (break)
              (do
                (let [arg (cstr->slice (load (primitive/index argv (load i))))]
                  (unless (is-flag? arg)
                    (store! nfiles (primitive/iadd (load nfiles) 1))
                    (let [r
                            (balance-one a
                                         (load (primitive/index argv (load i)))
                                         (load check)
                                         (load write)
                                         (load strict)
                                         (load use-check))]
                      (when (> r (load rc)) (store! rc r) 0))))
                (store! i (primitive/iadd (load i) 1)))))
    (cond (load stats) (balance-stats-cmd a)
          (= (load nfiles) (primitive/cast i64 0))
            (do
              (ps (stderr)
                  "usage: coil balance [--check|--write] [--strict] [--no-typecheck] <file.coil>...\n       coil balance --stats\n")
              2)
          :else (load rc))))

; ============================== `coil edit` =================================
; Edit a whole FORM instead of a range of text. A text patch can straddle a delimiter
; and leave the file unreadable; naming a form and supplying a replacement form cannot,
; because the replacement is read and rejected unless it is complete and balanced, and
; the splice lands on the form's own boundaries. See src/compiler/formatter/formedit.coil.
(defn read-stdin-all [(a (ptr Allocator))] (-> (slice u8))
  (let [buf (unwrap-ptr [i8] (raw-alloc a 65536 1))
        (mut bytes) (al-new [u8] a)]
    (loop (let [n (read 0 buf 65536)]
            (if (<= n (primitive/cast i64 0))
                (break)
                (let [(mut i) 0]
                  (loop (if (>= (load i) n)
                            (break)
                            (do
                              (al-push! (mut bytes) (primitive/cast u8 (load (primitive/index buf (load i)))))
                              (store! i (primitive/iadd (load i) 1)))))))))
    (al-slice [u8] (load bytes))))

(defn edit-cmd [(a (ptr Allocator)) (argc i32) (argv (ptr (ptr i8)))] (-> i64)
  (let [(mut ins) (al-new [(slice u8)] a)
        (mut addr) ""
        (mut path) ""
        (mut op) OP-REPLACE
        (mut write) false
        (mut nfiles) 0
        (mut i) 2]
    (loop (if (>= (load i) (primitive/cast i64 argc))
              (break)
              (let [arg (cstr->slice (load (primitive/index argv (load i))))
                    nextv
                      (if (< (primitive/iadd (load i) 1) (primitive/cast i64 argc))
                          (cstr->slice (load (primitive/index argv (primitive/iadd (load i) 1))))
                          "")]
                (cond (= arg "--form") (do (store! addr nextv) (store! i (primitive/iadd (load i) 1)) 0)
                      (= arg "--in") (do (al-push! (mut ins) nextv) (store! i (primitive/iadd (load i) 1)) 0)
                      (= arg "--replace") (store! op OP-REPLACE)
                      (= arg "--insert-before") (store! op OP-BEFORE)
                      (= arg "--insert-after") (store! op OP-AFTER)
                      (= arg "--delete") (store! op OP-DELETE)
                      (= arg "--show") (store! op OP-SHOW)
                      (= arg "--list") (store! op OP-LIST)
                      (= arg "--write") (store! write true)
                      (is-flag? arg)
                        (let [w (stderr)]
                          (ps w "error: unknown flag '")
                          (ps w arg)
                          (ps w "'")
                          (wb w 10)
                          (exit 2)
                          0)
                      :else (do (store! path arg) (store! nfiles (primitive/iadd (load nfiles) 1)) 0))
                (store! i (primitive/iadd (load i) 1))
                0)))
    (if (or (!= (load nfiles) (primitive/cast i64 1))
            (and (= (load addr) "") (!= (load op) OP-LIST)))
        (do
          (ps (stderr)
              "usage: coil edit <file.coil> [--in ADDR]... --form ADDR [--replace|--insert-before|--insert-after|--delete|--show] [--write]\n")
          2)
        (let [src (read-src-rc a (str->cstr a (load path)) 2)
              needs-text
                (and (!= (load op) OP-DELETE)
                     (and (!= (load op) OP-SHOW) (!= (load op) OP-LIST)))
              content (if needs-text (read-stdin-all a) "")]
          (match (fed/edit-src a src (load ins) (load addr) (load op) content)
            (fed/EText [text]
                       (if (or (= (load op) OP-SHOW)
                               (or (= (load op) OP-LIST) (not (load write))))
                           (do (ps (stdout) text) 0)
                           (d-write-file a (load path) text)))
            (fed/ENotFound [listing]
                           (let [w (stderr)]
                             (ps w "error: no form matches that address. This file contains:")
                             (wb w 10)
                             (ps w listing)
                             1))
            (fed/EAmbiguous [listing n]
                            (let [w (stderr)]
                              (ps w "error: that address matches ")
                              (dump-dec w n)
                              (ps w " forms; add items to narrow it:")
                              (wb w 10)
                              (ps w listing)
                              1))
            (fed/EBadInput [why]
                           (let [w (stderr)]
                             (ps w "error: ")
                             (ps w why)
                             (wb w 10)
                             2)))))))

; Formats EVERY file given, not just argv[2]: `coil fmt --write src/*.coil` silently
; formatted one file and reported success, and under --check silently gated a fraction
; of what was asked. Flags may appear anywhere.
(defn fmt-cmd [(a (ptr Allocator)) (argc i32) (argv (ptr (ptr i8)))] (-> i64)
  (let [(mut check) false
        (mut write) false
        (mut nfiles) 0
        (mut rc) 0
        (mut i) 2]
    ; pass 1: flags, wherever they sit
    (loop (if (>= (load i) (primitive/cast i64 argc))
              (break)
              (do
                (let [arg (cstr->slice (load (primitive/index argv (load i))))]
                  (when (is-flag? arg)
                    (if (= arg "--check")
                        (do (store! check true) 0)
                        (if (= arg "--write")
                            (do (store! write true) 0)
                            (let [w (stderr)]
                              (ps w "error: unknown flag '")
                              (ps w arg)
                              (ps w "'")
                              (wb w 10)
                              (exit 2)
                              0)))))
                (store! i (primitive/iadd (load i) 1)))))
    ; pass 2: every positional, keeping the worst exit code
    (store! i 2)
    (loop (if (>= (load i) (primitive/cast i64 argc))
              (break)
              (do
                (let [arg (cstr->slice (load (primitive/index argv (load i))))]
                  (unless (is-flag? arg)
                    (store! nfiles (primitive/iadd (load nfiles) 1))
                    (let [r
                            (fmt-one a
                                     (load (primitive/index argv (load i)))
                                     (load check)
                                     (load write))]
                      (when (> r (load rc)) (store! rc r) 0))))
                (store! i (primitive/iadd (load i) 1)))))
    (if (= (load nfiles) (primitive/cast i64 0))
        (let [(mut cmd) (sb-new a)
              live
                (let [text (read-file a (str->cstr a "Coil.toml"))]
                  (if (= (slice-len [u8] text) (primitive/cast i64 0))
                      (do (ps (stderr) "usage: coil fmt [--check|--write] <file.coil>...\n") (exit 2) 0)
                      (m-source-find! a (mut cmd) (parse-manifest a text))))]
          ; No source root on disk: no files to format, and a pathless `find` would
          ; walk the working directory instead.
          (if (= live (primitive/cast i64 0))
              0
              (do
                (sb-push-str! (mut cmd) " -print0 2>/dev/null | xargs -0 -r ")
                (m-shell-quoted! (mut cmd) (cstr->slice (load (primitive/index argv 0))))
                (sb-push-str! (mut cmd) " fmt")
                (when (load check) (sb-push-str! (mut cmd) " --check") 0)
                (when (load write) (sb-push-str! (mut cmd) " --write") 0)
                (wait-code (primitive/cast i64 (system (str->cstr a (sb-str (load cmd)))))))))
        (load rc))))

; ============================ `coil lint` ===================================
; Run the registered checkers and, with `--fix`, apply the rewrites they proposed
; to the source on disk. `--use` already means "load this metaprogram without
; editing the source", so a rule set is opt-in per invocation:
;
;   coil lint app.coil --use myproject.condlint            report + `help: try:` lines
;   coil lint app.coil --use myproject.condlint --diff     show the patch, write nothing
;   coil lint app.coil --use myproject.condlint --fix      apply it
;
; A plain `coil build` NEVER writes to your source. Only this command does, and it
; is the only caller that reads the suggestion table at all. See docs/archive/AUTOFIX.md.

; One rewrite of one file's byte range. `text` is the already-rendered replacement.
(defstruct LintEdit [(source i64) (lo i64) (hi i64) (text (slice u8))])
; What one file looked like before the round that is currently being applied — the
; whole undo buffer, because a round that fails to compile is reverted wholesale.
(defstruct LintSaved [(path (slice u8)) (text (slice u8))])

; Syntax/preflight lints run on the entry file immediately after reading it. They
; intentionally precede import loading, name resolution, macro expansion and type
; checking, so they can repair source whose module graph is not currently loadable.
(defn prelint-module-in-text [(a (ptr Allocator)) (text (slice u8))] (-> (Option (slice u8)))
  (try (let [forms (try-or! (read-all a text 0) (None [(slice u8)]))] (declared-module forms))))

(defn prelint-legacy-import? [(name (slice u8))] (-> bool)
  (or (>= (dep-slash name) (primitive/cast i64 0)) (d-ends-with? name ".coil")))

(defn prelint-alloc-op? [(name (slice u8))] (-> bool)
  (or (= name "alloc-stack")
      (or (= name "alloc-static")
          (or (= name "alloc-heap")
              (or (= name "stack")
                  (or (= name "static")
                      (= name "heap")))))))

(defn prelint-primitive-op? [(name (slice u8))] (-> bool)
  (or (= name "iand")
      (or (= name "ior")
          (or (= name "ixor")
              (or (= name "ishl")
                  (or (= name "ishr")
                      (or (= name "udiv")
                          (or (= name "urem")
                              (or (= name "fcmp-eq")
                                  (or (= name "fcmp-ne")
                                      (or (= name "fcmp-lt")
                                          (or (= name "fcmp-le")
                                              (or (= name "fcmp-gt")
                                                  (= name "fcmp-ge"))))))))))))))

(defn prelint-legacy-op [(a (ptr Allocator))
                         (name (slice u8))
                         (alloc-alias (slice u8))
                         (primitive-alias (slice u8))] (-> (slice u8))
  (cond (= name "icmp-eq") "="
        (= name "icmp-ne") "!="
        (= name "icmp-lt") "<"
        (= name "icmp-le") "<="
        (= name "icmp-gt") ">"
        (= name "icmp-ge") ">="
        (= name "iadd") "+"
        (= name "isub") "-"
        (= name "imul") "*"
        (= name "idiv") "/"
        (= name "irem") "%"
        (= name "alloc-stack") (sconcat a alloc-alias "/stack")
        (= name "alloc-static") (sconcat a alloc-alias "/static")
        (= name "alloc-heap") (sconcat a alloc-alias "/heap")
        (= name "stack") (sconcat a alloc-alias "/stack")
        (= name "static") (sconcat a alloc-alias "/static")
        (= name "heap") (sconcat a alloc-alias "/heap")
        (prelint-primitive-op? name) (sconcat a primitive-alias (sconcat a "/" name))
        ""))

; `stack`, `static` and `heap` are ordinary words, and this pass is syntax-blind: it
; rewrites the head of ANY list, with no idea whether that list is a call. Two shapes
; are not calls and must be left alone.
;
; A `defstruct`/`defsum` body is a vector of BINDERS — `(name Type)` pairs. The walk
; descends into KVec, so `(defstruct VM [(stack (array i64 16384)) …])` had its FIELD
; rewritten to `alloc/stack`, renaming it and breaking every `(field vm stack)` in the
; program. src/apps/clox and src/apps/chip8 both shipped uncompilable that way.
(defn prelint-binder-form? [(name (slice u8))] (-> bool)
  (or (= name "defstruct") (= name "defsum")))

; And the ambient allocator always takes exactly one argument, so any other arity is
; some other function that merely shares the name: `(heap)` — a zero-arg accessor for
; a bump arena — became `(alloc/heap …)`, a fresh one-byte allocation, and the arena
; SIGBUS'd at run time (src/experiments/gc-dialect/arena.coil). The hyphenated
; `alloc-stack`/`alloc-static`/`alloc-heap` spellings are unambiguous and unaffected.
(defn prelint-bare-alloc-name? [(name (slice u8))] (-> bool)
  (or (= name "stack") (or (= name "static") (= name "heap"))))

(defn prelint-op-edits! [(a (ptr Allocator))
                         (out (mut (ArrayList LintEdit)))
                         (f (ptr Sexp))
                         (alloc-alias (slice u8))
                         (primitive-alias (slice u8))
                         (needs-alloc (mut bool))
                         (needs-primitive (mut bool))] (-> i64)
  (match (load (field f kind))
    (KList [items]
           (let [n (al-len [Sexp] (load items))
                 hname
                   (if (> n (primitive/cast i64 0))
                       (match (l-sym-name (al-elem [Sexp] items 0))
                         (Some [h] h)
                         (None [] ""))
                       "")]
             (if (prelint-binder-form? hname)
                 0
                 (do
                   (let [(mut i) (primitive/isub n 1)]
                     (loop (if (< (load i) (primitive/cast i64 0))
                               (break)
                               (do
                                 (prelint-op-edits! a
                                                    (mut out)
                                                    (al-elem [Sexp] items (load i))
                                                    alloc-alias
                                                    primitive-alias
                                                    (mut needs-alloc)
                                                    (mut needs-primitive))
                                 (store! i (primitive/isub (load i) 1))))))
                   (when (and (> n (primitive/cast i64 0))
                              (not (and (prelint-bare-alloc-name? hname)
                                        (!= n (primitive/cast i64 2)))))
                     (let [head (al-elem [Sexp] items 0)
                           replacement (prelint-legacy-op a hname alloc-alias primitive-alias)]
                       (when (> (slice-len [u8] replacement) (primitive/cast i64 0))
                         (when (prelint-alloc-op? hname) (store! needs-alloc true) 0)
                         (when (prelint-primitive-op? hname) (store! needs-primitive true) 0)
                         (let [e (alloc/stack LintEdit)]
                           (store! (field e source) 0)
                           (store! (field e lo) (sx-lo (load head)))
                           (store! (field e hi) (sx-hi (load head)))
                           (store! (field e text) replacement)
                           (al-push! (mut out) (load e)))
                         0))
                     0)
                   0))))
    (KVec [items]
          (let [(mut i) (primitive/isub (al-len [Sexp] (load items)) 1)]
            (loop (if (< (load i) (primitive/cast i64 0))
                      (break)
                      (do
                        (prelint-op-edits! a
                                           (mut out)
                                           (al-elem [Sexp] items (load i))
                                           alloc-alias
                                           primitive-alias
                                           (mut needs-alloc)
                                           (mut needs-primitive))
                        (store! i (primitive/isub (load i) 1)))))))
    (KInt [_] 0)
    (KFloat [_] 0)
    (KSym [_] 0)
    (KKw [_] 0)
    (KStr [_] 0)
    (KCStr [_] 0)))

; Resolve using the pre-refactor rules solely to discover the target file's declared
; namespace for an autofix. Normal compilation never calls this compatibility path.
(defn prelint-legacy-target [(a (ptr Allocator)) (source-path (slice u8)) (old (slice u8))] (-> (Option (slice u8)))
  (let [candidate (path-join a (dirname source-path) old)
        buf (unwrap-ptr [i8] (raw-alloc a 4096 1))
        rp (realpath (str->cstr a candidate) buf)]
    (if (!= (primitive/cast i64 rp) (primitive/cast i64 0))
        (prelint-module-in-text a (read-file a buf))
        (let [cwd-rp (realpath (str->cstr a old) buf)]
          ; Older projects commonly mixed file-relative and invocation-relative
          ; paths. The migration pass understands both historical spellings even
          ; though neither remains legal after it rewrites the import.
          (if (!= (primitive/cast i64 cwd-rp) (primitive/cast i64 0))
              (prelint-module-in-text a (read-file a buf))
              (match (resolve-dependency a old)
                (Some [dep]
                      (let [dp (alloc/stack Resolved)]
                        (store! dp dep)
                        (prelint-module-in-text a (load (field dp text)))))
                (None []
                      (let [bn (basename old)]
                        (if (bundled? bn)
                            (prelint-module-in-text a (bundled-text a bn))
                            (None [(slice u8)]))))))))))

(defn prelint-form-import-alias [(f (ptr Sexp)) (target (slice u8))] (-> (Option (slice u8)))
  (match (l-list-head f)
    (Some [h]
          (if (= h "import")
              (let [items (l-as-list f)
                    n (al-len [Sexp] (load items))]
                (if (>= n (primitive/cast i64 4))
                    (match (l-as-str (al-elem [Sexp] items 1))
                      (Some [module]
                            (if (= module target)
                                (match (load (field (al-elem [Sexp] items 2) kind))
                                  (KKw [kw]
                                       (if (= kw "as")
                                           (l-sym-name (al-elem [Sexp] items 3))
                                           (None [(slice u8)])))
                                  (KInt [_] (None [(slice u8)]))
                                  (KFloat [_] (None [(slice u8)]))
                                  (KSym [_] (None [(slice u8)]))
                                  (KStr [_] (None [(slice u8)]))
                                  (KCStr [_] (None [(slice u8)]))
                                  (KList [_] (None [(slice u8)]))
                                  (KVec [_] (None [(slice u8)])))
                                (None [(slice u8)])))
                      (None [] (None [(slice u8)])))
                    (None [(slice u8)])))
              (None [(slice u8)])))
    (None [] (None [(slice u8)]))))

(defn prelint-import-alias [(forms (ptr (ArrayList Sexp))) (target (slice u8))] (-> (Option (slice u8)))
  (let [n (al-len [Sexp] (load forms))
        (mut i) 0
        (mut found) (None [(slice u8)])]
    (loop (if (>= (load i) n)
              (break)
              (match (prelint-form-import-alias (al-elem [Sexp] forms (load i)) target)
                (Some [alias] (do (store! found (Some alias)) (break)))
                (None [] (store! i (primitive/iadd (load i) 1))))))
    (load found)))

; A handwritten C declaration can opt into authoritative header validation with
; `:header "..."`. When Clang can import that symbol selectively, replace the
; declaration with the equivalent one-symbol cimport. This both prevents ABI drift
; (notably fixed-vs-variadic declarations) and guarantees the replacement does not
; expose unrelated declarations from the header.
(defn prelint-extern-header-edit [(a (ptr Allocator)) (f (ptr Sexp))] (-> (Option LintEdit))
  (match (l-list-head f)
    (Some [head]
          (if (= head "extern")
              (let [items (l-as-list f)
                    n (al-len [Sexp] (load items))]
                (if (>= n (primitive/cast i64 4))
                    (match (l-sym-name (al-elem [Sexp] items 1))
                      (None [] (None [LintEdit]))
                      (Some [name]
                            (let [(mut i) 2
                                  (mut header) ""]
                              (loop (if (>= (primitive/iadd (load i) 1) n)
                                        (break)
                                        (match (load (field (al-elem [Sexp] items (load i)) kind))
                                          (KKw [kw]
                                               (if (= kw "header")
                                                   (do
                                                     (match (l-as-str (al-elem [Sexp] items (primitive/iadd (load i) 1)))
                                                       (Some [h] (store! header h))
                                                       (None [] 0))
                                                     (break))
                                                   (store! i (primitive/iadd (load i) 1))))
                                          (_ (store! i (primitive/iadd (load i) 1))))))
                              (if (= (slice-len [u8] (load header)) (primitive/cast i64 0))
                                  (None [LintEdit])
                                  (let [names (box a (ArrayList (slice u8)) (al-new [(slice u8)] a))]
                                    (al-push! [(slice u8)] names name)
                                    (try (let [generated
                                                 (try-or! (ci/cimport-header-use a (load header) "" names true)
                                                          (None [LintEdit]))]
                                           (if (match (str-find generated (sconcat3 a "(extern " name " "))
                                                 (Some [_] true)
                                                 (None [] false))
                                               (let [e (alloc/stack LintEdit)]
                                                 (store! (field e source) 0)
                                                 (store! (field e lo) (sx-lo (load f)))
                                                 (store! (field e hi) (sx-hi (load f)))
                                                 (store! (field e text)
                                                         (sconcat3 a
                                                                   "(cimport \""
                                                                   (load header)
                                                                   (sconcat3 a "\" :use [" name "])")))
                                                 (Some (load e)))
                                               (None [LintEdit])))))))))
                    (None [LintEdit])))
              (None [LintEdit])))
    (None [] (None [LintEdit]))))

(defn prelint-import-edits [(a (ptr Allocator)) (path (slice u8)) (src (slice u8))] (-> (ptr (ArrayList LintEdit)))
  (let [(mut out) (al-new [LintEdit] a)]
    (try (let [forms
                 (try-or! (read-all a src 0)
                          (box-al [LintEdit] a (load out)))]
           (do
             (let [alloc-import (prelint-import-alias forms "coil.alloc")
                   primitive-import (prelint-import-alias forms "coil.primitive")
                   alloc-alias (match alloc-import (Some [alias] alias) (None [] "alloc"))
                   primitive-alias (match primitive-import (Some [alias] alias) (None [] "primitive"))
                   (mut needs-alloc) false
                   (mut needs-primitive) false]
               ; Operation edits cover the whole file in descending source order.
               ; Import declarations are at the beginning, so append their edits after.
               (let [(mut i) (primitive/isub (al-len [Sexp] (load forms)) 1)]
                 (loop (if (< (load i) (primitive/cast i64 0))
                           (break)
                           (do
                             (prelint-op-edits! a
                                                (mut out)
                                                (al-elem [Sexp] forms (load i))
                                                alloc-alias
                                                primitive-alias
                                                (mut needs-alloc)
                                                (mut needs-primitive))
                             (store! i (primitive/isub (load i) 1))))))
               (let [(mut i) (primitive/isub (al-len [Sexp] (load forms)) 1)]
                 ; Reverse source order is already the order lint-apply requires.
                 (loop (if (< (load i) (primitive/cast i64 0))
                           (break)
                           (do
                             (let [f (al-elem [Sexp] forms (load i))]
                               (match (prelint-extern-header-edit a f)
                                 (Some [e] (al-push! (mut out) e))
                                 (None [] 0))
                               (match (l-list-head f)
                                 (Some [h]
                                       (when (= h "import")
                                         (let [items (l-as-list f)]
                                           (when (>= (al-len [Sexp] (load items)) (primitive/cast i64 2))
                                             (let [arg (al-elem [Sexp] items 1)]
                                               (match (l-as-str arg)
                                                 (Some [old]
                                                       (when (prelint-legacy-import? old)
                                                         (match (prelint-legacy-target a path old)
                                                           (Some [name]
                                                                 (let [e (alloc/stack LintEdit)]
                                                                   (store! (field e source) 0)
                                                                   (store! (field e lo) (sx-lo (load arg)))
                                                                   (store! (field e hi) (sx-hi (load arg)))
                                                                   (store! (field e text) (sconcat3 a "\"" name "\""))
                                                                   (al-push! (mut out) (load e))))
                                                           (None [] 0))
                                                         0))
                                                 (None [] 0)))
                                             0))
                                         0))
                                 (None [] 0)))
                             (store! i (primitive/isub (load i) 1))))))
               ; Add every required owner import in the same preflight transaction as
               ; its call-head rewrites. Insert after `(module …)` so a failed retry
               ; still rolls the whole source file back byte-for-byte.
               (let [(mut imports) ""]
                 (when (and (load needs-alloc)
                            (match alloc-import (Some [_] false) (None [] true)))
                   (store! imports (sconcat a (load imports) "\n(import \"coil.alloc\" :as alloc)"))
                   0)
                 (when (and (load needs-primitive)
                            (match primitive-import (Some [_] false) (None [] true)))
                   (store! imports (sconcat a (load imports) "\n(import \"coil.primitive\" :as primitive)"))
                   0)
                 (when (> (slice-len [u8] (load imports)) (primitive/cast i64 0))
                   (when (> (al-len [Sexp] (load forms)) (primitive/cast i64 0))
                     (let [e (alloc/stack LintEdit)
                           at (sx-hi (load (al-elem [Sexp] forms 0)))]
                       (store! (field e source) 0)
                       (store! (field e lo) at)
                       (store! (field e hi) at)
                       (store! (field e text) (load imports))
                       (al-push! (mut out) (load e)))
                     0)
                   0))
               (box-al [LintEdit] a (load out))))))))

; Return 0 when semantic linting may continue, 1 when unfixed preflight findings
; remain, and 2 when --fix is refused by the dirty-tree guard.
(defn prelint-run [(a (ptr Allocator)) (path (slice u8)) (fix bool) (diff bool) (allow-dirty bool)] (-> i64)
  (let [src (read-file a (str->cstr a path))
        edits (prelint-import-edits a path src)
        n (al-len [LintEdit] (load edits))]
    (if (= n (primitive/cast i64 0))
        0
        (do
          (let [(mut i) 0]
            (loop (if (>= (load i) n)
                      (break)
                      (do
                        (let [e (al-elem [LintEdit] edits (load i))]
                          (ps (stderr) path)
                          (ps (stderr) ":")
                          (ps (stderr) (i64->str a (lint-line-of src (load (field e lo)))))
                          (if (match (str-find (load (field e text)) "(cimport ")
                                (Some [_] true)
                                (None [] false))
                              (ps (stderr)
                                  ": warning: handwritten extern duplicates a C header declaration; use selective cimport to prevent ABI drift\n")
                              (if (= (primitive/cast i64
                                                     (slice-get [u8]
                                                                src
                                                                (load (field e lo))))
                                     (primitive/cast i64 34))
                                  (ps (stderr)
                                      ": warning: import paths are no longer supported; import the declared namespace instead\n")
                                  (ps (stderr)
                                      ": warning: legacy metal operation has a clean coil.core replacement\n")))
                          (when diff (lint-print-diff a (stdout) path src e) 0))
                        (store! i (primitive/iadd (load i) 1)))))
            (if (not fix)
                1
                (if (and (not allow-dirty) (lint-dirty? a path))
                    (do
                      (ps (stderr) "error: ")
                      (ps (stderr) path)
                      (ps (stderr) " has uncommitted changes; commit them or pass --allow-dirty\n")
                      2)
                    (do
                      (d-write-file a path (lint-apply a src edits 0))
                      (ps (stderr) "fixed ")
                      (ps (stderr) path)
                      (wb (stderr) 10)
                      0))))))))

; A round is thrown away rather than half-applied, so it must be possible to put
; every file back exactly as it was.
(defn lint-restore [(a (ptr Allocator)) (saved (ptr (ArrayList LintSaved)))] (-> i64)
  (let [n (al-len [LintSaved] (load saved))
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (let [sp (al-elem [LintSaved] saved (load i))]
                  (d-write-file a
                                (load (field sp path))
                                (load (field sp text))))
                (store! i (primitive/iadd (load i) 1)))))
    0))

; Every suggestion the last analysis recorded, rendered and sorted so they can be
; spliced back-to-front. Overlapping edits (an outer form and something inside it
; both rewritten) cannot both be applied to the same text: the first wins and the
; rest are dropped for THIS round — the next round finds them again on re-analysis.
; Sort key: file ascending, then offset DESCENDING. Equal offsets keep discovery
; order, which puts the OUTER form first — the walker reports a form before anything
; inside it — so when two nested rewrites collide the wider one is the one that lands.
(defn lint-edit-before? [(x LintEdit) (y LintEdit)] (-> bool)
  (let [xp (alloc/stack LintEdit)
        yp (alloc/stack LintEdit)]
    (store! xp x)
    (store! yp y)
    (if (!= (load (field xp source)) (load (field yp source)))
        (< (load (field xp source)) (load (field yp source)))
        (> (load (field xp lo)) (load (field yp lo))))))

(defn lint-edits [(a (ptr Allocator)) (verbose bool)] (-> (ptr (ArrayList LintEdit)))
  (let [n (sug-count)
        (mut out) (al-new [LintEdit] a)
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (let [sp (alloc/stack Suggestion)
                      e (alloc/stack LintEdit)]
                  (store! sp (sug-at (load i)))
                  (let [src (sug-file-text (load (field sp source)))
                        lo (load (field sp lo))
                        hi (load (field sp hi))
                        txt (sug-render a (load sp))]
                    ; A fix that would delete one of the author's comments is downgraded
                    ; to advice: the `help: try:` line still stands, but nothing is
                    ; written. Said out loud, because a silently skipped fix reads as
                    ; "there was nothing to do".
                    (if (sug-drops-comment? src lo hi txt)
                        (let [w (stderr)]
                          (when verbose
                            (ps w "note: ")
                            (ps w (sug-file-name (load (field sp source))))
                            (ps w ":")
                            (ps w (i64->str a (lint-line-of src lo)))
                            (ps w ": not applying this fix — it would drop a comment; make the change by hand")
                            (wb w 10)
                            0)
                          0)
                        (do
                          (store! (field e source) (load (field sp source)))
                          (store! (field e lo) lo)
                          (store! (field e hi) hi)
                          (store! (field e text) txt)
                          (al-push! (mut out) (load e))
                          0))))
                (store! i (primitive/iadd (load i) 1)))))
    ; stable insertion sort — the list is one round's worth of findings, never large
    (let [m (al-len [LintEdit] (load out))
          (mut p) 1]
      (loop (if (>= (load p) m)
                (break)
                (do
                  (let [cur (alloc/stack LintEdit)
                        (mut q) (primitive/isub (load p) 1)]
                    (store! cur (al-get [LintEdit] (load out) (load p)))
                    (loop (if (< (load q) (primitive/cast i64 0))
                              (break)
                              (let [pv (alloc/stack LintEdit)]
                                (store! pv (al-get [LintEdit] (load out) (load q)))
                                (if (lint-edit-before? (load pv) (load cur))
                                    (break)
                                    (do
                                      (al-set! (mut out) (primitive/iadd (load q) 1) (load pv))
                                      (store! q (primitive/isub (load q) 1)))))))
                    (al-set! (mut out) (primitive/iadd (load q) 1) (load cur)))
                  (store! p (primitive/iadd (load p) 1)))))
      0)
    (box-al [LintEdit] a (load out))))

; Apply the edits for source `sid` to `src`, skipping any that overlap one already
; taken. Edits arrive sorted by descending `lo`, so each splice leaves the offsets of
; the ones still to come untouched. Returns the rewritten text (== `src` if nothing applied).
(defn lint-apply [(a (ptr Allocator)) (src (slice u8)) (edits (ptr (ArrayList LintEdit))) (sid i64)] (-> (slice u8))
  (let [n (al-len [LintEdit] (load edits))
        (mut out) src
        (mut floor) (slice-len [u8] src)  ; lowest offset already rewritten
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (let [ep (al-elem [LintEdit] edits (load i))]
                  (when (and (= (load (field ep source)) sid)
                             (and (<= (load (field ep hi)) (load floor))
                                  (and (>= (load (field ep lo)) (primitive/cast i64 0))
                                       (<= (load (field ep hi)) (slice-len [u8] (load out))))))
                    (store! out
                            (sconcat3 a
                                      (subslice [u8]
                                                (load out)
                                                0
                                                (load (field ep lo)))
                                      (load (field ep text))
                                      (subslice [u8]
                                                (load out)
                                                (load (field ep hi))
                                                (slice-len [u8] (load out)))))
                    (store! floor (load (field ep lo)))
                    0))
                (store! i (primitive/iadd (load i) 1)))))
    (load out)))

; The distinct source ids the pending edits touch, in first-seen order.
(defn lint-edit-sources [(a (ptr Allocator)) (edits (ptr (ArrayList LintEdit)))] (-> (ptr (ArrayList i64)))
  (let [n (al-len [LintEdit] (load edits))
        (mut out) (al-new [i64] a)
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (let [sid (load (field (al-elem [LintEdit] edits (load i)) source))
                      m (al-len [i64] (load out))
                      (mut seen) false
                      (mut j) 0]
                  (loop (if (>= (load j) m)
                            (break)
                            (if (= (al-get [i64] (load out) (load j)) sid)
                                (do (store! seen true) (break))
                                (store! j (primitive/iadd (load j) 1)))))
                  (unless (load seen) (al-push! (mut out) sid) 0))
                (store! i (primitive/iadd (load i) 1)))))
    (box-al [i64] a (load out))))

; 1-based line number of byte `off`, and how many lines the range [lo,hi) spans —
; the two numbers a unified-diff hunk header is made of.
(defn lint-line-of [(src (slice u8)) (off i64)] (-> i64)
  (let [n (slice-len [u8] src)
        cap (if (> off n) n off)
        (mut i) 0
        (mut line) 1]
    (loop (if (>= (load i) cap)
              (break)
              (do
                (when (= (primitive/cast i64 (slice-get [u8] src (load i))) (primitive/cast i64 10))
                  (store! line (primitive/iadd (load line) 1)))
                (store! i (primitive/iadd (load i) 1)))))
    (load line)))

; Start of the line containing `off`, and end of the line containing `off` (exclusive
; of the newline) — a hunk replaces WHOLE lines, so a fix inside a line still produces
; a patch a human (or `git apply`) can read.
(defn lint-line-start [(src (slice u8)) (off i64)] (-> i64)
  (let [(mut i) off]
    (loop (if (or (<= (load i) (primitive/cast i64 0))
                  (= (primitive/cast i64 (slice-get [u8] src (primitive/isub (load i) 1))) (primitive/cast i64 10)))
              (break)
              (store! i (primitive/isub (load i) 1))))
    (load i)))
(defn lint-line-end [(src (slice u8)) (off i64)] (-> i64)
  (let [n (slice-len [u8] src)
        (mut i) (if (> off n) n off)]
    (loop (if (or (>= (load i) n)
                  (= (primitive/cast i64 (slice-get [u8] src (load i))) (primitive/cast i64 10)))
              (break)
              (store! i (primitive/iadd (load i) 1))))
    (load i)))

; Print `text` as diff body lines, each prefixed with `mark`.
(defn lint-diff-lines [(w (ptr Writer)) (mark i64) (text (slice u8))] (-> i64)
  (let [n (slice-len [u8] text)
        (mut i) 0
        (mut count) 0]
    (loop (if (>= (load i) n)
              (break)
              (let [e (lint-line-end text (load i))]
                (wb w mark)
                (ps w (subslice [u8] text (load i) e))
                (wb w 10)
                (store! count (primitive/iadd (load count) 1))
                (store! i (primitive/iadd e 1)))))
    (load count)))

; A unified diff of one edit. Deliberately ZERO context lines: the exact bytes that
; change are known, so a hunk is stated rather than recovered by a diff algorithm.
; The result still applies with `git apply --unidiff-zero`.
(defn lint-print-diff [(a (ptr Allocator)) (w (ptr Writer)) (path (slice u8)) (src (slice u8)) (e (ptr LintEdit))] (-> i64)
  (let [lo (load (field e lo))
        hi (load (field e hi))
        ls (lint-line-start src lo)
        le (lint-line-end src hi)
        old (subslice [u8] src ls le)
        new (sconcat3 a (subslice [u8] src ls lo) (load (field e text)) (subslice [u8] src hi le))]
    (ps w "--- a/")
    (ps w path)
    (wb w 10)
    (ps w "+++ b/")
    (ps w path)
    (wb w 10)
    (let [oldn (lint-count-lines old)
          newn (lint-count-lines new)
          start (lint-line-of src ls)]
      (ps w "@@ -")
      (ps w (i64->str a start))
      (ps w ",")
      (ps w (i64->str a oldn))
      (ps w " +")
      (ps w (i64->str a start))
      (ps w ",")
      (ps w (i64->str a newn))
      (ps w " @@")
      (wb w 10))
    (lint-diff-lines w 45 old)
    (lint-diff-lines w 43 new)
    0))

(defn lint-count-lines [(text (slice u8))] (-> i64)
  (let [n (slice-len [u8] text)
        (mut i) 0
        (mut c) 1]
    (loop (if (>= (load i) n)
              (break)
              (do
                (when (= (primitive/cast i64 (slice-get [u8] text (load i))) (primitive/cast i64 10))
                  (store! c (primitive/iadd (load c) 1)))
                (store! i (primitive/iadd (load i) 1)))))
    (load c)))

; The undo button for an autofix is `git checkout`, so insist the button exists:
; refuse to rewrite a TRACKED file that has uncommitted changes. A file git does not
; track — including every file outside a repository — has no baseline to compare
; against and is allowed through; the guard is about not burying edits you have not
; committed, not about forbidding new files.
;
; A path containing a single quote cannot be passed to the shell safely, so it is
; reported as untracked rather than quoted wrong.
(defn lint-shell-safe? [(path (slice u8))] (-> bool)
  (let [n (slice-len [u8] path)
        (mut i) 0
        (mut ok) true]
    (loop (if (>= (load i) n)
              (break)
              (if (= (primitive/cast i64 (slice-get [u8] path (load i))) (primitive/cast i64 39))
                  (do (store! ok false) (break))
                  (store! i (primitive/iadd (load i) 1)))))
    (load ok)))

(defn lint-git-status [(a (ptr Allocator)) (cmd (slice u8)) (path (slice u8))] (-> i64)
  (wait-code (primitive/cast i64
                             (system (str->cstr a (sconcat3 a cmd (sconcat3 a "'" path "'") " >/dev/null 2>&1"))))))

(defn lint-dirty? [(a (ptr Allocator)) (path (slice u8))] (-> bool)
  (if (or (not (lint-shell-safe? path))
          (!= (lint-git-status a "git ls-files --error-unmatch -- " path) (primitive/cast i64 0)))
      false
      ; untracked / not a repo
      (!= (lint-git-status a "git diff --quiet HEAD -- " path) (primitive/cast i64 0))))

(defn lint-round-limit [] (-> i64)
  8)

(defn lint-usage [] (-> i64)
  (ps (stderr) "usage: coil lint <file.coil> [--use <namespace>]... [--fix|--diff] [--allow-dirty]\n")
  2)

(defn lint-cmd [(a (ptr Allocator)) (argc i32) (argv (ptr (ptr i8)))] (-> i64)
  (let [(mut fix) false
        (mut diff) false
        (mut allow-dirty) false
        (mut pathc) (primitive/cast (ptr i8) 0)
        (mut i) 2]
    (loop (if (>= (load i) (primitive/cast i64 argc))
              (break)
              (let [arg (cstr->slice (load (primitive/index argv (load i))))]
                (cond (= arg "--fix")
                        (do
                          (store! fix true)
                          (store! i (primitive/iadd (load i) 1))
                          0)
                      (= arg "--diff")
                        (do
                          (store! diff true)
                          (store! i (primitive/iadd (load i) 1))
                          0)
                      (= arg "--allow-dirty")
                        (do
                          (store! allow-dirty true)
                          (store! i (primitive/iadd (load i) 1))
                          0)
                      (= arg "--use")
                        (do
                          (when (>= (primitive/iadd (load i) 1) (primitive/cast i64 argc))
                            (ps (stderr) "error: --use needs a path\n")
                            (exit 2)
                            0)
                          (cli-use-add (cstr->slice (load (primitive/index argv
                                                                           (primitive/iadd (load i)
                                                                                           1)))))
                          (store! i (primitive/iadd (load i) 2))
                          0)
                      (is-flag? arg)
                        (do
                          (ps (stderr) "error: unknown flag '")
                          (ps (stderr) arg)
                          (ps (stderr) "'")
                          (wb (stderr) 10)
                          (exit 2)
                          0)
                      :else
                        (do
                          (store! pathc (load (primitive/index argv (load i))))
                          (store! i (primitive/iadd (load i) 1))
                          0)))))
    ; One explicit standard profile owns every mechanically safe bundled fix.
    ; Additional project/policy checkers remain opt-in through --use.
    (cli-use-add "coil.lint.default")
    (if (= (primitive/cast i64 (load pathc)) (primitive/cast i64 0))
        (project-lint-cmd a argc argv (load fix) (load diff) (load allow-dirty))
        (lint-run a (load pathc) (load fix) (load diff) (load allow-dirty)))))

(defn project-lint-cmd [(a (ptr Allocator))
                        (argc i32)
                        (argv (ptr (ptr i8)))
                        (fix bool)
                        (diff bool)
                        (allow-dirty bool)] (-> i64)
  (block :project-lint
           (let [text (read-file a (str->cstr a "Coil.toml"))]
             (if (= (slice-len [u8] text) (primitive/cast i64 0))
                 (lint-usage)
                 (let [m (parse-manifest a text)
                       list-path
                         (sconcat3 a
                                   "/tmp/coil-project-lint-files-"
                                   (i64->str a (primitive/cast i64 (getpid)))
                                   "")
                       (mut cmd) (sb-new a)]
                   (m-prepare-deps a m)
                   ; No source root exists — nothing to lint, which is success, not a
                   ; failure to report.
                   (when (= (m-source-find! a (mut cmd) m) (primitive/cast i64 0))
                     (return-from :project-lint 0)
                     0)
                   (sb-push-str! (mut cmd) " -print 2>/dev/null > ")
                   (m-shell-quoted! (mut cmd) list-path)
                   (let [find-rc (wait-code (primitive/cast i64 (system (str->cstr a (sb-str (load cmd))))))]
                     (when (!= find-rc (primitive/cast i64 0)) (return-from :project-lint find-rc) 0))
                   (store! cmd (sb-new a))
                   (m-emit-dep-env a (mut cmd) m)
                   (m-shell-quoted! (mut cmd) (cstr->slice (load (primitive/index argv 0))))
                   (sb-push-str! (mut cmd) " __project-lint-all")
                   (when fix (sb-push-str! (mut cmd) " --fix") 0)
                   (when diff (sb-push-str! (mut cmd) " --diff") 0)
                   (when allow-dirty (sb-push-str! (mut cmd) " --allow-dirty") 0)
                   (sb-push-str! (mut cmd) " ")
                   (m-shell-quoted! (mut cmd) list-path)
                   (let [rc (wait-code (primitive/cast i64 (system (str->cstr a (sb-str (load cmd))))))]
                     (unlink (str->cstr a list-path))
                     (if (= rc (primitive/cast i64 123)) 1 rc)))))))

; Lint one aggregate module graph. Each project file contributes exactly one module
; to this graph, so a diagnostic in a shared dependency is rendered once rather than
; once for every source file that imports it. Syntax preflight still visits each file
; individually because it must repair legacy imports before the graph can load.
(defn project-lint-test-path? [(suffixes (ptr (ArrayList (slice u8)))) (path (slice u8))] (-> bool)
  (if (= (al-len [(slice u8)] (load suffixes)) (primitive/cast i64 0))
      (d-ends-with? path "_test.coil")
      (let [(mut found) false
            (mut i) 0]
        (loop (if (>= (load i) (al-len [(slice u8)] (load suffixes)))
                  (break)
                  (do
                    (when (d-ends-with? path (al-get [(slice u8)] (load suffixes) (load i)))
                      (store! found true)
                      0)
                    (store! i (primitive/iadd (load i) 1)))))
        (load found))))

(defn project-lint-all-cmd [(a (ptr Allocator)) (argc i32) (argv (ptr (ptr i8)))] (-> i64)
  (block :project-lint-all
           (let [list-path (cstr->slice (load (primitive/index argv (primitive/isub (primitive/cast i64 argc) 1))))
                 paths (read-file a (str->cstr a list-path))
                 manifest (parse-manifest a (read-file a (str->cstr a "Coil.toml")))
                 rules (load (field manifest lint-rules))
                 suffixes (load (field manifest test-suffixes))
                 root-path
                   (sconcat3 a
                             "/tmp/coil-project-lint-root-"
                             (i64->str a (primitive/cast i64 (getpid)))
                             ".coil")
                 (mut root) (sb-new a)
                 (mut tests) (al-new [(slice u8)] a)
                 (mut originals) (al-new [LintSaved] a)
                 (mut fix) false
                 (mut diff) false
                 (mut allow-dirty) false
                 (mut rc) 0
                 (mut r) 0
                 (mut i) 2
                 (mut lo) 0
                 n (slice-len [u8] paths)]
             (loop (if (>= (load i) (primitive/isub (primitive/cast i64 argc) 1))
                       (break)
                       (let [arg (cstr->slice (load (primitive/index argv (load i))))]
                         (when (= arg "--fix") (store! fix true) 0)
                         (when (= arg "--diff") (store! diff true) 0)
                         (when (= arg "--allow-dirty") (store! allow-dirty true) 0)
                         (store! i (primitive/iadd (load i) 1)))))
             (cli-use-add "coil.assert")
             (loop (if (>= (load r) (al-len [(slice u8)] rules))
                       (break)
                       (do
                         (cli-use-add (al-get [(slice u8)] rules (load r)))
                         (store! r (primitive/iadd (load r) 1)))))
             ; lint reads the EXPANDED program, so a declared transform has to be
             ; loaded here too — otherwise the linter analyses source the compiler
             ; never sees, and reports on code the transform was about to rewrite.
             (m-add-manifest-uses manifest)
             (sb-push-str! (mut root) "(module coil-project-lint-root)\n(import \"coil.assert\" :use *)\n")
             (store! i 0)
             (loop (if (> (load lo) n)
                       (break)
                       (do
                         (store! i (load lo))
                         (loop (if (or (>= (load i) n)
                                       (= (primitive/cast i64 (slice-get [u8] paths (load i))) (primitive/cast i64 10)))
                                   (break)
                                   (store! i (primitive/iadd (load i) 1))))
                         (when (> (load i) (load lo))
                           (let [path (subslice paths (load lo) (load i))
                                 before (read-file a (str->cstr a path))
                                 pre-rc
                                   (prelint-run a
                                                path
                                                (load fix)
                                                (load diff)
                                                (load allow-dirty))]
                             (when (load fix)
                               (let [sv (alloc/stack LintSaved)]
                                 (store! (field sv path) path)
                                 (store! (field sv text) before)
                                 (al-push! (mut originals) (load sv)))
                               0)
                             (when (!= pre-rc (primitive/cast i64 0)) (store! rc pre-rc) 0)
                             (match (prelint-module-in-text a (read-file a (str->cstr a path)))
                               (Some [name]
                                     (if (project-lint-test-path? suffixes path)
                                         (al-push! (mut tests) path)
                                         (do
                                           (sb-push-str! (mut root) "(import \"")
                                           (sb-push-str! (mut root) name)
                                           (sb-push-str! (mut root) "\")\n"))))
                               (None [] 0)))
                           0)
                         (if (>= (load i) n)
                             (store! lo (primitive/iadd n 1))
                             (store! lo (primitive/iadd (load i) 1))))))
             ; Unfixed preflight findings make the aggregate graph unloadable. They were
             ; already reported once at their owning files, so do not add loader noise.
             (when (!= (load rc) (primitive/cast i64 0))
               (when (load fix) (lint-restore a (box-al [LintSaved] a (load originals))) 0)
               (return-from :project-lint-all (load rc))
               0)
             (d-write-file a root-path (sb-str (load root)))
             (store! rc
                     (lint-run a
                               (str->cstr a root-path)
                               (load fix)
                               (load diff)
                               (load allow-dirty)))
             (unlink (str->cstr a root-path))
             ; Test macros are entry-module scoped, so check each test once only after
             ; the shared source graph is clean. Imported source errors cannot multiply.
             (when (= (load rc) (primitive/cast i64 0))
               (store! i 0)
               (loop (if (>= (load i) (al-len [(slice u8)] (load tests)))
                         (break)
                         (do
                           (let [test-rc
                                   (lint-run a
                                             (str->cstr a
                                                        (al-get [(slice u8)] (load tests) (load i)))
                                             (load fix)
                                             (load diff)
                                             (load allow-dirty))]
                             (when (!= test-rc (primitive/cast i64 0)) (store! rc test-rc) 0))
                           (store! i (primitive/iadd (load i) 1)))))
               0)
             (when (and (load fix) (!= (load rc) (primitive/cast i64 0)))
               (lint-restore a (box-al [LintSaved] a (load originals)))
               (ps (stderr) "error: project lint fixes did not produce a clean project — all changes reverted\n")
               0)
             (load rc))))

(defn project-lint-one-cmd [(a (ptr Allocator)) (argc i32) (argv (ptr (ptr i8)))] (-> i64)
  (let [text (read-file a (str->cstr a "Coil.toml"))
        path (cstr->slice (load (primitive/index argv (primitive/isub (primitive/cast i64 argc) 1))))
        (mut fix) false
        (mut diff) false
        (mut allow-dirty) false
        (mut i) 2]
    (loop (if (>= (load i) (primitive/isub (primitive/cast i64 argc) 1))
              (break)
              (let [arg (cstr->slice (load (primitive/index argv (load i))))]
                (when (= arg "--fix") (store! fix true) 0)
                (when (= arg "--diff") (store! diff true) 0)
                (when (= arg "--allow-dirty") (store! allow-dirty true) 0)
                (store! i (primitive/iadd (load i) 1)))))
    (let [m (parse-manifest a text)
          rules (load (field m lint-rules))
          suffixes (load (field m test-suffixes))
          (mut is-test) false
          (mut r) 0]
      (loop (if (>= (load r) (al-len [(slice u8)] rules))
                (break)
                (do
                  (cli-use-add (al-get [(slice u8)] rules (load r)))
                  (store! r (primitive/iadd (load r) 1)))))
      (m-add-manifest-uses m)
      (if (= (al-len [(slice u8)] suffixes) (primitive/cast i64 0))
          (store! is-test (d-ends-with? path "_test.coil"))
          (let [(mut s) 0]
            (loop (if (>= (load s) (al-len [(slice u8)] suffixes))
                      (break)
                      (do
                        (when (d-ends-with? path (al-get [(slice u8)] suffixes (load s)))
                          (store! is-test true)
                          0)
                        (store! s (primitive/iadd (load s) 1)))))))
      (when (load is-test) (cli-use-add "coil.assert") 0)
      (lint-run a (str->cstr a path) (load fix) (load diff) (load allow-dirty)))))

; The apply loop: analyse, edit, re-analyse — a fixpoint with a fuel guard, the same
; shape as macro expansion and the transform loop. Level-1 gate: after a round the
; program must still read, resolve and typecheck; if it doesn't, the WHOLE round is
; reverted, so the working tree is always at least as valid as it started.
(defn lint-run [(a (ptr Allocator)) (pathc (ptr i8)) (fix bool) (diff bool) (allow-dirty bool)] (-> i64)
  (block :lint-done
           (let [w (stderr)
                 path (cstr->slice pathc)
                 cwd (cwd-slice a)
                 original (read-file a pathc)
                 (mut rc) (prelint-run a path fix diff allow-dirty)]
             ; A syntax preflight may have rewritten legacy imports. An unfixed finding is
             ; intentionally terminal: the ordinary loader rejects it, and running that
             ; pipeline would only add a redundant hard error after the actionable warning.
             (when (!= (load rc) (primitive/cast i64 0)) (return-from :lint-done (load rc)) 0)
             ; PHASE 1 — apply to a fixpoint, quietly. Each round's analysis is also the
             ; previous round's gate: if the program stopped compiling, WE broke it, so the
             ; whole round goes back and nothing else is attempted.
             (when fix (store! rc (lint-fix-loop a pathc path cwd allow-dirty)))
             ; PHASE 2 — one analysis with output. This is the report: what the checkers say
             ; about the file as it now stands, with a `help: try:` line under anything still
             ; fixable. `--diff` renders its patch from the same pass.
             (if (= (load rc) (primitive/cast i64 2))
                 (load rc)
                 (do
                   (set-diag-quiet false)
                   (sug-reset)
                   (diag-reset)
                   (let [src (read-src a pathc)
                         ok (run-dump-on-big-stack a src cwd path (primitive/fnptr-of check-src-program))]
                     (if (= ok (primitive/cast i64 0))
                         (store! rc 1)
                         ; Collect in every mode, not just --diff: `lint-edits` is what says a
                         ; fix cannot be applied, and a `help: try:` line with no such note
                         ; would read as "--fix will do this for you" when it will not.
                         (let [es (lint-edits a true)] (when diff (lint-print-patch a es)))))
                   ; Preflight edits used to escape the semantic transaction. If a
                   ; migrated file still does not compile, restore the exact input so
                   ; --fix never leaves a project in a worse or half-migrated state.
                   (when (and fix
                              (and (!= (load rc) (primitive/cast i64 0))
                                   (not (= original (read-file a pathc)))))
                     (d-write-file a path original)
                     (ps w "error: preflight fixes did not produce a compiling file — all changes reverted\n")
                     0)
                   (load rc))))))

; Rewrite until nothing changes: a fuel-guarded fixpoint, the same shape as macro
; expansion and the transform loop. Returns 0, 1 (broken / did not settle) or 2
; (refused because a file has uncommitted changes).
(defn lint-fix-loop [(a (ptr Allocator))
                     (pathc (ptr i8))
                     (path (slice u8))
                     (cwd (slice u8))
                     (allow-dirty bool)] (-> i64)
  (let [w (stderr)
        (mut saved) (al-new [LintSaved] a)
        (mut applied) false
        (mut rounds) 0
        (mut rc) 0]
    (set-diag-quiet true)
    (loop (do
            (sug-reset)
            (diag-reset)
            (let [src (read-src a pathc)
                  ok (run-dump-on-big-stack a src cwd path (primitive/fnptr-of check-src-program))]
              ; The program does not compile. Before the first edit that is simply the
              ; state of the file — phase 2 will say so. After one it means a fix we
              ; applied is at fault, so the round is put back exactly as it was.
              (when (= ok (primitive/cast i64 0))
                (when (load applied)
                  (lint-restore a (box-al [LintSaved] a (load saved)))
                  (ps w "error: a suggested fix produced code that does not compile — round reverted")
                  (wb w 10)
                  (store! rc 1)
                  0)
                (break))
              (let [edits (lint-edits a (= (load rounds) (primitive/cast i64 0)))
                    nedits (al-len [LintEdit] (load edits))]
                (when (= nedits (primitive/cast i64 0)) (break))
                (let [srcs (lint-edit-sources a edits)
                      ns (al-len [i64] (load srcs))
                      (mut k) 0
                      (mut wrote) false]
                  (store! saved (al-new [LintSaved] a))
                  (loop (if (>= (load k) ns)
                            (break)
                            (do
                              (let [sid (al-get [i64] (load srcs) (load k))
                                    fpath (sug-file-name sid)
                                    ftext (sug-file-text sid)
                                    out (lint-apply a ftext edits sid)]
                                (unless (or (= (slice-len [u8] fpath) (primitive/cast i64 0)) (= out ftext))
                                  (if (and (not allow-dirty) (lint-dirty? a fpath))
                                      (do
                                        (ps w "error: ")
                                        (ps w fpath)
                                        (ps w " has uncommitted changes; commit them or pass --allow-dirty")
                                        (wb w 10)
                                        (store! rc 2)
                                        0)
                                      (let [sv (alloc/stack LintSaved)]
                                        (store! (field sv path) fpath)
                                        (store! (field sv text) ftext)
                                        (al-push! (mut saved) (load sv))
                                        (d-write-file a fpath out)
                                        (ps w "fixed ")
                                        (ps w fpath)
                                        (wb w 10)
                                        (store! wrote true)
                                        0))))
                              (store! k (primitive/iadd (load k) 1)))))
                  (when (= (load rc) (primitive/cast i64 2)) (break))
                  (when (not (load wrote)) (break))
                  (store! applied true)
                  (store! rounds (primitive/iadd (load rounds) 1))
                  ; Fuel exhaustion is a real outcome and is reported, not swallowed: it
                  ; means two rules disagree and keep undoing each other.
                  (when (>= (load rounds) (lint-round-limit))
                    (ps w "error: --fix did not settle after ")
                    (ps w (i64->str a (lint-round-limit)))
                    (ps w " rounds — two rules are probably undoing each other")
                    (wb w 10)
                    (store! rc 1)
                    (break)))))))
    (set-diag-quiet false)
    (load rc)))

; Print the patch every pending edit would make, grouped by file. Writes nothing.
(defn lint-print-patch [(a (ptr Allocator)) (edits (ptr (ArrayList LintEdit)))] (-> i64)
  (let [srcs (lint-edit-sources a edits)
        ns (al-len [i64] (load srcs))
        (mut k) 0]
    (loop (if (>= (load k) ns)
              (break)
              (do
                (let [sid (al-get [i64] (load srcs) (load k))]
                  (lint-diff-file a (stdout) (sug-file-name sid) (sug-file-text sid) edits sid))
                (store! k (primitive/iadd (load k) 1)))))
    0))

; Print every pending edit for one file as a diff hunk.
(defn lint-diff-file [(a (ptr Allocator))
                      (w (ptr Writer))
                      (path (slice u8))
                      (src (slice u8))
                      (edits (ptr (ArrayList LintEdit)))
                      (sid i64)] (-> i64)
  (let [n (al-len [LintEdit] (load edits))
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (let [ep (al-elem [LintEdit] edits (load i))]
                  (when (= (load (field ep source)) sid)
                    (lint-print-diff a w path src ep)))
                (store! i (primitive/iadd (load i) 1)))))
    0))

; `new <name>` — scaffold Coil.toml + src/main.coil.
(defn new-cmd [(a (ptr Allocator)) (argc i32) (argv (ptr (ptr i8)))] (-> i64)
  (if (< (primitive/cast i64 argc) (primitive/cast i64 3))
      (do (ps (stderr) "usage: coil new <name>\n") 1)
      (let [name (cstr->slice (load (primitive/index argv 2)))]
        (system (str->cstr a (cat3-d a "mkdir -p " (cat3-d a name "/src"))))
        (d-write-file a
                      (cat3-d a name "/Coil.toml")
                      (cat3-d a "[package]\nname  = \"" (cat3-d a name "\"\nentry = \"src/main.coil\"\n")))
        (d-write-file a
                      (cat3-d a name "/src/main.coil")
                      "(module app)\n\n(defn main [] (-> i64)\n  42)\n")
        (let [w (stdout)] (ps w "created ") (ps w name) (ps w "/ — cd in and `coil run`\n") 0))))

; `emit-obj <file> [-o out.o] [--target T] [--backend arm64]` — build the object,
; no link. Mirrors build-cmd's pipeline minus the cc step.
(defn emit-obj-cmd [(a (ptr Allocator))
                    (argc i32)
                    (argv (ptr (ptr i8)))
                    (build-fn (fnptr c [(ptr Allocator) (slice u8) (slice u8) (ptr i8) (ptr i8) (slice u8)] i64))
                    (emitir-fn (fnptr c [(ptr Allocator) (slice u8) (slice u8) (ptr i8) (slice u8)] i64))
                    (default-backend i64)] (-> i64)
  (let [file (load (primitive/index argv 2))
        (mut outp) (primitive/cast (ptr i8) 0)
        (mut backend) default-backend
        (mut trip) (primitive/cast (ptr i8) 0)
        (mut i) 3]
    (loop (if (>= (load i) (primitive/cast i64 argc))
              (break)
              (let [arg (cstr->slice (load (primitive/index argv (load i))))]
                (cond (= arg "-o")
                        (do
                          (store! outp
                                  (load (primitive/index argv
                                                         (primitive/iadd (load i) 1))))
                          (store! i (primitive/iadd (load i) 2))
                          0)
                      (= arg "--target")
                        (do
                          (store! trip
                                  (load (primitive/index argv
                                                         (primitive/iadd (load i) 1))))
                          (store! i (primitive/iadd (load i) 2))
                          0)
                      (= arg "--backend")
                        (do
                          (let [bn
                                  (cstr->slice (load (primitive/index argv
                                                                      (primitive/iadd (load i)
                                                                                      1))))]
                            (if (= bn "arm64")
                                (store! backend 2)
                                (if (or (= bn "x64") (= bn "x86_64"))
                                    (store! backend 5)
                                    (store! backend 1))))
                          (store! i (primitive/iadd (load i) 2))
                          0)
                      :else (do (store! i (primitive/iadd (load i) 1)) 0)))))
    ; `emit-obj -o /dev/null`: no writable object destination — route to compile-check
    ; rather than abending in codegen. (diag-12)
    (when (and (!= (primitive/cast i64 (load outp)) (primitive/cast i64 0))
               (= (cstr->slice (load outp)) "/dev/null"))
      (ps (stderr) "note: -o /dev/null: compile-check only, no object written\n")
      (set-target-arch! (load trip))
      (exit (primitive/cast i32
                            (when (= (run-dump-on-big-stack a
                                                            (read-src a file)
                                                            (cwd-slice a)
                                                            (cstr->slice file)
                                                            (primitive/fnptr-of check-src-program))
                                     (primitive/cast i64 0))
                              1)))
      0)
    (let [out-slice
            (if (= (primitive/cast i64 (load outp)) (primitive/cast i64 0))
                (obj-path a (cstr->slice file))
                (cstr->slice (load outp)))
          obj-cstr (str->cstr a out-slice)
          ctx (alloc/stack DumpCtx)]
      (store! (field ctx a) a)
      (store! (field ctx src) (read-src a file))
      (store! (field ctx cwd) (cwd-slice a))
      (store! (field ctx path) (cstr->slice file))
      (store! (field ctx mode) (load backend))
      (store! (field ctx obj) obj-cstr)
      (store! (field ctx triple) (load trip))
      (set-target-arch! (load trip))
      (store! (field ctx ok) 0)
      (store! (field ctx build-fn) build-fn)
      (store! (field ctx emitir-fn) emitir-fn)
      (if (= (run-on-big-stack ctx) (primitive/cast i64 0))
          1
          (let [w (stdout)] (ps w "wrote ") (ps w out-slice) (wb w 10) 0)))))

; ============================ repl ==========================================
; A subprocess REPL. Top-level definitions accumulate as SOURCE; a value
; expression is TYPE-CHECKED in-process (a throwaway `(defn __repl_probe [] (-> i64)
; (do EXPR 0))` probe reusing the real front-end pipeline) so the printer is dispatched on the
; expression's actual inferred type — %ld/%lu for an int, %g for a float,
; true/false for a bool, the raw bytes for a (slice u8), an address for a
; pointer — instead of the old blanket `(primitive/cast i64 EXPR)`, which silently
; TRUNCATED floats (`(/ 1.0 2.0)` printed 0) and could not print bools or
; strings at all. A well-typed expr is compiled and run as a tiny program via
; `self run`, and the temp file is REMOVED afterward (it used to leak on every
; call). A type error is rendered against the user's OWN input line via the same
; span renderer the compiler uses, and nothing is written to /tmp. `:help`,
; `:type EXPR`, and `:quit` meta-commands are handled ahead of the reader.

(defn repl-head? [(s (slice u8)) (h (slice u8))] (-> bool)
  (starts-with s h))
(defn repl-is-def? [(s (slice u8))] (-> bool)
  (or (repl-head? s "(defn")
      (or (repl-head? s "(defstruct")
          (or (repl-head? s "(defsum")
              (or (repl-head? s "(def ")
                  (or (repl-head? s "(def(")
                      (or (repl-head? s "(import")
                          (or (repl-head? s "(extern")
                              (or (repl-head? s "(deftrait")
                                  (or (repl-head? s "(definst")
                                      (or (repl-head? s "(const")
                                          (or (repl-head? s "(export-c")
                                              (or (repl-head? s "(defcc")
                                                  (repl-head? s "(derive"))))))))))))))

; read one line from fd 0 (byte at a time); None at EOF with no data.
(defn repl-read-line [(a (ptr Allocator)) (buf (ptr i8))] (-> (Option (slice u8)))
  (let [(mut out) (sb-new a)
        (mut got) false]
    (loop (let [n (read 0 buf 1)]
            (if (<= n (primitive/cast i64 0))
                (break)
                (do
                  (store! got true)
                  (if (= (load buf) (primitive/cast i8 10))
                      (break)
                      (sb-push-byte! (mut out) (primitive/cast u8 (load buf))))))))
    (if (load got) (Some (sb-str (load out))) (None [(slice u8)]))))

; The front-end preamble every REPL probe/run program shares.
(defn repl-preamble [] (-> (slice u8))
  "(module replsession)\n(extern printf :cc c [(ptr i8) ...] (-> i32))\n")

; Local fat-pointer accessors so the string printer needs no stdlib import (the
; run program is otherwise self-contained). Byte-identical to src/stdlib/slice.coil's
; slice-len / slice-data llvm-ir, and accepted by BOTH backends.
(defn repl-str-helpers [] (-> (slice u8))
  "(defn __repl_slen [(s (slice u8))] (-> i64) (primitive/llvm-ir i64 [s] \"%l = extractvalue $t0 $0, 1\nret $ret %l\"))\n(defn __repl_sdat [(s (slice u8))] (-> (ptr u8)) (primitive/llvm-ir (ptr u8) [s] \"%d = extractvalue $t0 $0, 0\nret $ret %d\"))\n")

; name == nm, or a module-qualified name ending in ".<nm>" (the resolver prefixes
; every function with its module, so `__repl_probe` becomes `replsession.__repl_probe`).
(defn repl-name-eq? [(name (slice u8)) (nm (slice u8))] (-> bool)
  (if (= name nm)
      true
      (let [nl (slice-len [u8] name)
            ml (slice-len [u8] nm)]
        (if (<= nl ml)
            false
            (and (= (primitive/cast i64
                                    (slice-get [u8]
                                               name
                                               (primitive/isub (primitive/isub nl ml) 1)))
                    (primitive/cast i64 46))  ; the '.'
                 (= (subslice [u8] name (primitive/isub nl ml) nl) nm))))))
(defn repl-func-find [(prog (ptr Program)) (nm (slice u8))] (-> (ptr Func))
  (let [fs (load (field prog funcs))
        n (al-len [Func] (load fs))
        (mut i) 0
        (mut r) (primitive/cast (ptr Func) 0)]
    (loop (if (>= (load i) n)
              (break)
              (do
                (when (repl-name-eq? (load (field (al-elem [Func] fs (load i)) name))
                                     nm)
                  (store! r (al-elem [Func] fs (load i)))
                  (break))
                (store! i (primitive/iadd (load i) 1)))))
    (load r)))

; nid of the user's expression node inside the `(defn __repl_probe [] (-> i64)
; (do <EXPR> 0))` probe, so its checker-recorded type can be read back from the S2
; type map. A do-block (unlike a let-bind or const) checks <EXPR> in RUNTIME context
; through do-synth — so user defns resolve and a void statement is allowed — and
; never rewrites the node, so its parse-time nid is preserved. 0 = not found.
(defn repl-probe-nid [(cp (ptr Program))] (-> i64)
  (let [fp (repl-func-find cp "__repl_probe")]
    (unless (= (primitive/cast i64 fp) (primitive/cast i64 0))
      (let [body (load (field fp body))]
        (unless (= (al-len [Expr] (load body)) (primitive/cast i64 0))
          (match (load (field (al-elem [Expr] body 0) kind))
            (EDo [dbody]
                 (unless (= (al-len [Expr] (load dbody)) (primitive/cast i64 0))
                   (load (field (al-elem [Expr] dbody 0) nid))))
            (EInt [$g8653] 0)
            (EStr [$g8654] 0)
            (ECStr [$g8655] 0)
            (EVar [$g8656] 0)
            (EZeroed [$g8657] 0)
            (EBorrow [$g8658 $g8659] 0)
            (ELet [$g8660 $g8661] 0)
            (EBin [$g8662 $g8663 $g8664] 0)
            (ENot [$g8665] 0)
            (EFloat [$g8666] 0)
            (EBool [$g8667] 0)
            (ECmp [$g8668 $g8669 $g8670] 0)
            (EIf [$g8671 $g8672 $g8673] 0)
            (ECall [$g8674 $g8675 $g8676] 0)
            (ENamedCall [$g8674n $g8675n $g8676n $g8677n] 0)
            (EAlloc [$g8677 $g8678] 0)
            (EField [$g8679 $g8680] 0)
            (ELoad [$g8681] 0)
            (EStore [$g8682 $g8683] 0)
            (EIndex [$g8684 $g8685] 0)
            (ECast [$g8686 $g8687] 0)
            (ESizeOf [$g8688] 0)
            (EAlignOf [$g8689] 0)
            (EOffsetOf [$g8690 $g8691] 0)
            (EBitGet [$g8692 $g8693] 0)
            (EBitSet [$g8694 $g8695 $g8696] 0)
            (EFree [$g8697] 0)
            (EErase [$g8698 $g8699] 0)
            (EMatch [$g8700 $g8701] 0)
            (EFnPtrOf [$g8702] 0)
            (ECallPtr [$g8703 $g8704] 0)
            (ELoop [$g8705 $g8706] 0)
            (EBreak [$g8707 $g8708] 0)
            (EContinue [$g8709] 0)
            (ELlvmIr [$g8710 $g8711 $g8712] 0)
            (ETypeQuery [$g8713 $g8714] 0)
            (EFieldMeta [$g8715 $g8716 $g8717] 0)
            (EFieldIndex [$g8718 $g8719] 0)
            (EQuote [$g8720] 0)
            (ECodeOp [$g8721 $g8722] 0)
            (EQuasi [$g8723] 0)
            (EComptime [$g8724] 0)
            (EAscribe [$g8725 $g8726] 0)
            (ESpillRef [$g8727] 0)
            (EConstruct [$g8728 $g8729 $g8730] 0)
            (ETraitCall [$g8731 $g8732 $g8733 $g8734] 0)
            (EDynDispatch [$g8735 $g8736 $g8737 $g8738 $g8739 $g8740 $g8741 $g8742] 0)
            (EMakeDyn [$g8743 $g8744 $g8745 $g8746] 0)
            (EStaticRef [$g8747] 0)))))))

; Strip the internal probe function's context prefix ("in '…__repl_probe': " /
; "function '…__repl_probe': ") so a REPL error names only the user's expression.
(defn repl-clean-msg [(m (slice u8))] (-> (slice u8))
  (let [p1 "in 'replsession.__repl_probe': "
        p2 "function 'replsession.__repl_probe': "]
    (if (starts-with m p1)
        (subslice [u8] m (slice-len [u8] p1) (slice-len [u8] m))
        (if (starts-with m p2)
            (subslice [u8] m (slice-len [u8] p2) (slice-len [u8] m))
            m))))

; Render a check/parse diagnostic against the user's INPUT line: when the span
; lands inside the embedded expr (offset >= base), re-anchor it to a source that
; is only the user's line, so the frame shows exactly what they typed (mirrors
; report-diag's `error: <msg>` + framed `-->`). Otherwise fall back to the probe.
(defn repl-report [(a (ptr Allocator)) (s (mut LS)) (d Diag) (base i64) (uinput (slice u8))] (-> i64)
  (let [w (stderr)
        dp (alloc/stack Diag)]
    (store! dp d)
    (let [src (load (field dp source))
          lo (load (field dp lo))
          hi (load (field dp hi))
          ctxt (load (field dp ctxt))
          ulen (slice-len [u8] uinput)
          msg (repl-clean-msg (load (field dp msg)))]
      (if (and (= src (primitive/cast i64 0))
               (and (= ctxt (primitive/cast i64 0))
                    (and (>= lo base) (<= lo (primitive/iadd base ulen)))))
          (let [uid (al-len [Source] (load (field s sources)))
                _r (register-source! (mut s) "<repl>" uinput)
                nlo (primitive/isub lo base)
                nhi
                  (primitive/isub (if (> hi (primitive/iadd base ulen))
                                      (primitive/iadd base ulen)
                                      hi)
                                  base)]
            (ps w "error: ")
            (unless (render-frame w (mut s) uid nlo nhi msg "-->") (ps w msg))
            (wb w 10)
            0)
          (report-diag w (mut s) d)))))

; Read back the probe expr's checker-recorded type from the S2 type map. (Factored
; out of repl-infer-type to keep every function's paren nesting shallow — the
; bootstrap seed's recursive-descent reader has a bounded parse stack.)
(defn repl-typemap-lookup [(cp (ptr Program))] (-> (Option Type))
  (match (type-map-lookup (repl-probe-nid cp))
    (Some [ty] (Some ty))
    (None [] (do (ps (stderr) "error: the REPL could not infer the expression's type\n") (None [Type])))))

; Macro-expand + transform + resolve/check an already-LOADED probe (s), then read
; back the inferred type. Errors render mapped to the user's line.
(defn repl-check-loaded [(a (ptr Allocator)) (s (mut LS)) (base i64) (uinput (slice u8))] (-> (Option Type))
  (match (expand-stage3 (mut s))
    (Err [d] (do (repl-report a (mut s) d base uinput) (None [Type])))
    (Ok [_]
        (match (run-transforms-and-check a (mut s))
          (Err [d] (do (repl-report a (mut s) d base uinput) (None [Type])))
          (Ok [cp] (repl-typemap-lookup cp))))))

; Type-check `<defs> (defn __repl_probe [] (-> i64) (do <uinput> 0))` in-process
; through the SAME front-end run-pipeline uses (read -> load -> macro-expand ->
; transforms -> resolve+check), so macros/derives/the prelude behave exactly as in
; a real build AND the expr is checked in RUNTIME context (user defns resolve; a
; do-block admits a void statement), and return the checker-inferred type of
; <uinput> (read back from the S2 type map by the expr's node id). On ANY pipeline
; error, render it mapped to the user's line and return None — the caller then
; writes nothing to disk.
(defn repl-infer-type [(a (ptr Allocator)) (defs (slice u8)) (uinput (slice u8))] (-> (Option Type))
  (let [prefix (sconcat a (repl-preamble) (sconcat a defs "(defn __repl_probe [] (-> i64) (do\n"))
        probe (sconcat a prefix (sconcat a uinput "\n0))\n"))
        base (slice-len [u8] prefix)
        s (alloc/stack LS)]
    (ls-init! (mut s) a)
    (store! (field s srccount) 1)
    (register-source! (mut s) "<repl>" probe)
    (match (read-all a probe 0)
      (Err [d] (do (repl-report a (mut s) d base uinput) (None [Type])))
      (Ok [forms]
          (do
            (namespace-index-build! (mut s))
            (load-program (mut s) (prepend-uses a (mut s) forms) (cwd-slice a))
            (if (ls-err? (mut s))
                (do
                  (repl-report a (mut s) (load (field s loaderr)) base uinput)
                  (None [Type]))
                (repl-check-loaded a (mut s) base uinput)))))))

; (slice u8)? — the string type, so it prints as raw bytes.
(defn repl-slice-u8? [(tp (ptr Type))] (-> bool)
  (if (= (type-tag tp) (primitive/cast i64 8))
      (let [el (t-inner tp)]
        (and (= (type-tag el) (primitive/cast i64 0))
             (and (= (t-int-bits el) (primitive/cast i64 8)) (not (t-int-signed el)))))
      false))

; Write `<preamble><helpers><defs>(defn main [] (-> i64) <body>)`, run it via
; `self run`, then REMOVE the temp file (the old REPL leaked it every call).
(defn repl-emit-run [(a (ptr Allocator))
                     (self (slice u8))
                     (defs (slice u8))
                     (helpers (slice u8))
                     (body (slice u8))] (-> i64)
  (let [prog
          (sconcat a
                   (repl-preamble)
                   (sconcat a
                            helpers
                            (sconcat a defs (sconcat a "(defn main [] (-> i64) " (sconcat a body ")\n")))))]
    (d-write-file a "/tmp/coil-repl-eval.coil" prog)
    (system (str->cstr a (cat3-d a self " run /tmp/coil-repl-eval.coil")))
    (unlink (str->cstr a "/tmp/coil-repl-eval.coil"))
    0))

(defn repl-unsupported [(a (ptr Allocator)) (tp (ptr Type))] (-> i64)
  (let [w (stderr)]
    (ps w "; the REPL has no printer for a value of type ")
    (ps w (ty-str a tp))
    (ps w " — bind it with (def name …) or wrap it in your own printf.\n")
    0))

; Build the printer around the user's expr text, dispatched on the inferred type,
; and run it. Never fabricate an answer: a type with no faithful printer says so.
(defn repl-run [(a (ptr Allocator)) (self (slice u8)) (defs (slice u8)) (uinput (slice u8)) (ty Type)] (-> i64)
  (let [tp (alloc/stack Type)]
    (store! tp ty)
    (let [tag (type-tag tp)]
      (cond (= tag (primitive/cast i64 0))  ; any int
              (repl-emit-run a
                             self
                             defs
                             ""
                             (sconcat a
                                      (if (t-int-signed tp)
                                          "(do (printf c\"%ld\\n\" (primitive/cast i64 "
                                          "(do (printf c\"%lu\\n\" (primitive/cast u64 ")
                                      (sconcat a uinput ")) 0)")))
            (= tag (primitive/cast i64 1))  ; float
              (repl-emit-run a
                             self
                             defs
                             ""
                             (sconcat a "(do (printf c\"%g\\n\" (primitive/cast f64 " (sconcat a uinput ")) 0)")))
            (= tag (primitive/cast i64 2))  ; bool
              (repl-emit-run a
                             self
                             defs
                             ""
                             (sconcat a
                                      "(do (if "
                                      (sconcat a uinput " (printf c\"true\\n\") (printf c\"false\\n\")) 0)")))
            (= tag (primitive/cast i64 4))  ; pointer -> address
              (repl-emit-run a
                             self
                             defs
                             ""
                             (sconcat a
                                      "(do (printf c\"0x%lx\\n\" (primitive/cast i64 "
                                      (sconcat a uinput ")) 0)")))
            (or (= tag (primitive/cast i64 3)) (= tag (primitive/cast i64 12)))  ; void / never -> statement (no print)
              (repl-emit-run a self defs "" (sconcat a "(do " (sconcat a uinput " 0)")))
            (and (= tag (primitive/cast i64 8)) (repl-slice-u8? tp))  ; (slice u8) -> the bytes
              (repl-emit-run a
                             self
                             defs
                             (repl-str-helpers)
                             (sconcat a
                                      "(let [__v "
                                      (sconcat a
                                               uinput
                                               "] (do (printf c\"%.*s\\n\" (primitive/cast i32 (__repl_slen __v)) (__repl_sdat __v)) 0))")))
            :else (repl-unsupported a tp)))))

; Evaluate a value expression: infer its type, then print it faithfully.
(defn repl-eval [(a (ptr Allocator)) (self (slice u8)) (defs (slice u8)) (expr (slice u8))] (-> i64)
  (match (repl-infer-type a defs expr)
    (None [] 0)  ; error already rendered; nothing written to /tmp
    (Some [ty] (repl-run a self defs expr ty))))

; `:type EXPR` — print the inferred type without running anything.
(defn repl-type-cmd [(a (ptr Allocator)) (defs (slice u8)) (expr (slice u8))] (-> i64)
  (match (repl-infer-type a defs expr)
    (None [] 0)
    (Some [ty]
          (let [tp (alloc/stack Type)
                w (stdout)]
            (store! tp ty)
            (ps w (ty-str a tp))
            (wb w 10)
            0))))

(defn repl-help-text [] (-> (slice u8))
  "commands:
  :help, :h          this message
  :type EXPR         print the inferred type of EXPR (does not run it)
  :quit, :q          exit (Ctrl-D also works)
define with (defn …)/(def …)/(defstruct …)/(import …); they persist. Any other
line is a value expression: it is type-checked and its result is printed.
")

(defn repl-cmd [(a (ptr Allocator)) (argv (ptr (ptr i8)))] (-> i64)
  (let [self (cstr->slice (load (primitive/index argv 0)))
        (mut defs) (sb-new a)
        buf (unwrap-ptr [i8] (raw-alloc a 4 1))]
    (ps (stdout)
        "coil repl — evaluate an expr (printed by type), or (defn …)/(def …) to define. :help, Ctrl-D to exit.\n")
    (loop (ps (stdout) "coil> ")
      (match (repl-read-line a buf)
        (None [] (break))
        (Some [line]
              (let [t (m-trim line)]
                (cond (= (slice-len [u8] t) (primitive/cast i64 0)) 0
                      (or (= t ":quit") (= t ":q")) (break)
                      (or (= t ":help") (= t ":h")) (do (ps (stdout) (repl-help-text)) 0)
                      (repl-head? t ":type ")
                        (repl-type-cmd a
                                       (sb-str (load defs))
                                       (m-trim (subslice [u8] t 6 (slice-len [u8] t))))
                      (repl-head? t ":") (do (ps (stderr) "; unknown command; :help for help\n") 0)
                      (and (repl-is-def? t) (not (repl-head? t "(module")))
                        (do
                          (if (repl-head? t "(def ")  ; (def name v) is repl sugar for a coil (const …)
                              (do
                                (sb-push-str! (mut defs) "(const ")
                                (sb-push-str! (mut defs) (subslice [u8] t 5 (slice-len [u8] t)))
                                0)
                              (sb-push-str! (mut defs) t))
                          (sb-push-byte! (mut defs) (primitive/cast u8 10))
                          (ps (stdout) "; ok\n")
                          0)
                      :else (repl-eval a self (sb-str (load defs)) t))))))
    (ps (stdout) "\n")
    0))

; `cheader <file.coil> [-o out.h]` — generate the C header for export-c.
(defn cheader-cmd [(a (ptr Allocator)) (argc i32) (argv (ptr (ptr i8)))] (-> i64)
  (if (< (primitive/cast i64 argc) (primitive/cast i64 3))
      (do (ps (stderr) "usage: coil cheader <file.coil> [-o out.h]\n") 1)
      (let [file (load (primitive/index argv 2))
            (mut outp) (None [(slice u8)])
            (mut i) 3]
        (loop (if (>= (load i) (primitive/cast i64 argc))
                  (break)
                  (do
                    (if (and (< (primitive/iadd (load i) 1) (primitive/cast i64 argc))
                             (= (cstr->slice (load (primitive/index argv (load i)))) "-o"))
                        (do
                          (store! outp
                                  (Some (cstr->slice (load (primitive/index argv
                                                                            (primitive/iadd (load i)
                                                                                            1))))))
                          (store! i (primitive/iadd (load i) 2))
                          0)
                        (do (store! i (primitive/iadd (load i) 1)) 0)))))
        (cheader-program a (read-src a file) (dirname (cstr->slice file)) (load outp)))))

; `coil` (no args) / `coil --help` / `-h` / `help`. Lists only what driver-main
; actually dispatches — an unimplemented command in here is a lie the CLI tells.
(defn usage-text [] (-> (slice u8))
  "coil — the Coil compiler

usage: coil <command> [args]

Build & run
  run   <file.coil> [flags] [-- args...]   build to a temp exe, run it, propagate its exit code
  run                                      build+run the ./Coil.toml project
  build <file.coil> -o <out> [flags]       build a native executable
  build                                    build the ./Coil.toml project
  check <file.coil> [flags]                typecheck/compile only — no object, exit 0 if it compiles
  check                                    check every configured project target
  test  [selector] [--suite NAME]         discover and run project test suites
  test  <file.coil> [flags]                run every (deftest …) in a forked child
  fuzz  <file.coil> [-n N]                 run its (defprop …) under coverage guidance
  verify                                   fmt, lint, check, build native inputs, and test
  new   <name>                             scaffold Coil.toml + src/main.coil
  repl                                     interactive session
  fmt   [--check|--write] [files...]       format files or project sources
  balance [--check|--write] <files...>     repair unbalanced ()/[] so a file reads again
  edit  <file.coil> --form ADDR [op]       replace/insert/delete a whole form by name
  lint  [file.coil] [--fix|--diff]         run checkers on a file or project

Artifacts
  emit-obj <file.coil> [-o <out.o>]        build the object file, no link
  emit-ir  <file.coil>                     print normalized textual LLVM IR
  dump-ir  <file.coil>                     alias of emit-ir
  cheader  <file.coil>                     print a C header for (export-c ...) functions
  cimport  <header.h>                      generate Coil bindings from a C header

Reference
  guide                                    the full language guide
  doc   <file.coil>                        markdown for the module's `;;`-documented surface
  namespaces                               list bundled standard-library namespaces
  namespace <name|file.coil>               list every definition, including available docs
  --version, -V                            print the version
  --help, -h                               this message

Common flags (build / run / emit-obj)
  -o <out>              output path (required by `build`)
  -O0 / -O1 / -O2 / -O3 LLVM optimization level (default -O3; LLVM backend only)
  --meta-opt=<n>        -O level for METAPROGRAM objects only (default: follow -O)
                        -O0 builds ~6x faster and runs much slower — for iterating,
                        not for anything you intend to run. -O1 costs the built
                        program almost nothing and still builds ~1.5x faster.
  --target <triple>     cross-compile (e.g. wasm32-unknown-unknown, x86_64-apple-macosx11.0.0)
  --backend arm64       use the native arm64 backend instead of LLVM
  -g, --debug           emit DWARF debug info (implies the arm64 backend)
  --debug-checks        bounds, collection, allocator, and stack-return checks
  --sanitize=address    AddressSanitizer (invalid address/use-after-free)
  --sanitize=thread     ThreadSanitizer (data races)
  --sanitize=memory     MemorySanitizer (Linux-only uninitialized reads)
  --sanitize=undefined  undefined integer/divide/shift operations
  --debug-runtime       enable debug checks and AddressSanitizer together
  -l<name>              link a library (e.g. -lm)
  --link-flag <flag>    pass a raw flag to the linker
  --lib / --shared      build a static (.a) / shared (.dylib) library
  --emit-header <h>     also write a C header
  --use <namespace>     load a metaprogram namespace
  --quiet               suppress the `wrote <path>` line (run/test pass this)

Pipeline stage dumps (for debugging the compiler itself), each <file.coil>
  dump-read      the reader's s-expressions
  dump-ast       the parsed AST
  dump-load      the AST with imports resolved
  expand         macro-expanded source
  dump-expand    the expanded AST
  dump-resolved  after name resolution
  dump-checked   after type checking
  dump-mono      after monomorphization
")

; ---- per-subcommand help ----------------------------------------------------
; `coil fmt --help` printed one byte and exited 0; `coil run --help` tried to build a
; project and complained about a missing Coil.toml. `<cmd> --help` is a reflex, and an
; empty response reads as a broken binary.
(defn common-flags-text [] (-> (slice u8))
  "Flags (may appear before or after <file.coil>)
  -o <out>              output path (required by `build`)
  --target <triple>     cross-compile (e.g. wasm32-unknown-unknown)
  --backend arm64       use the native arm64 backend instead of LLVM
  -g, --debug           emit DWARF debug info (implies the arm64 backend)
  --debug-checks        enable zero-cost-when-off runtime safety checks
  --sanitize=address    instrument with LLVM AddressSanitizer
  --sanitize=thread     instrument with LLVM ThreadSanitizer
  --sanitize=memory     instrument with LLVM MemorySanitizer (Linux only)
  --sanitize=undefined  check undefined integer/divide/shift operations
  --debug-runtime       enable debug checks and AddressSanitizer together
  -l<name>              link a library (e.g. -lm)
  --link-flag <flag>    pass a raw flag to the linker
  --lib / --shared      build a static (.a) / shared (.dylib) library
  --emit-header <h>     also write a C header
  --use <namespace>     load a metaprogram namespace
  --quiet               suppress the `wrote <path>` line (run/test pass this)
")

; `coil --version` used to print `unknown command '--version'` and the usage text, so
; the one question every adopter asks first — "which Coil?" — had no answer at all.
;
; A STATIC string, deliberately. Baking the git commit in at build time was the obvious
; alternative and is worse twice over: version.coil would sit in main.coil's import
; closure, so every commit would churn the `full` snapshot, and a stamp taken from a
; dirty tree LIES about what the binary contains — which is exactly the trap
; SEED_VERSION set when it recorded a commit the seed was not built from. Bump this by
; hand when cutting a release.
(defn version-text [] (-> (slice u8))
  "coil 0.1.0\n")

(defn wants-help? [(argc i32) (argv (ptr (ptr i8)))] (-> bool)
  (let [(mut i) 2
        (mut r) false]
    (loop (if (>= (load i) (primitive/cast i64 argc))
              (break)
              (let [arg (cstr->slice (load (primitive/index argv (load i))))]
                (if (= arg "--")
                    (break)
                    (if (or (= arg "--help") (= arg "-h"))
                        (do (store! r true) (break))
                        (do (store! i (primitive/iadd (load i) 1)) 0))))))
    (load r)))

(defn sub-usage [(sub (slice u8))] (-> i64)
  (let [w (stdout)]
    (cond (= sub "build")
            (do
              (ps w "usage: coil build <file.coil> -o <out> [flags]\n")
              (ps w "       coil build [flags]                    build the ./Coil.toml project\n\n")
              (ps w (common-flags-text))
              0)
          (= sub "run")
            (do
              (ps w "usage: coil run <file.coil> [flags] [-- args...]\n")
              (ps w "       coil run [flags] [-- args...]         build+run the ./Coil.toml project\n\n")
              (ps w
                  "Builds to a temp exe, runs it, and propagates its exit code — 128+signo if it\ndies by a signal.\n\n")
              (ps w (common-flags-text))
              0)
          (= sub "test")
            (do
              (ps w "usage: coil test [selector] [--suite NAME]... [--list|--no-run] [--jobs N]\n")
              (ps w "       coil test <file.coil> [flags]\n\n")
              (ps w "Property flags go to the RUNNER, everything else to the build:\n")
              (ps w "  --cases N --seed N --size N --shrink N --max-rejects N --timeout N\n")
              (ps w "  --arena BYTES --verbose --alloc-tracked --no-fork\n")
              (ps w "e.g. `coil test tests/p_test.coil --cases 100000 --seed 42 --verbose`.\n")
              (ps w "See `coil fuzz --help` for the coverage-guided search.\n\n")
              (ps w "Auto-loads src/stdlib/assert.coil (so `deftest`/`assert`/`assert-eq` need no import),\n")
              (ps w "discovers every (deftest …), and runs each in a FORKED child so one failing or\n")
              (ps w "crashing test never stops the suite. Exit: 0 iff all pass, 1 if any fails.\n\n")
              (ps w "Suites are declared as [test.suites.<name>] in Coil.toml, each with its own\n")
              (ps w "`roots` and `suffixes`. A suite runs on a bare `coil test` unless it declares\n")
              (ps w "`default = false` — that is how a slow or costly integration suite stays out of\n")
              (ps w "the everyday run until it is asked for by name.\n\n")
              (ps w "  --suite NAME   run this suite (repeatable); `--suite all` runs every suite\n")
              (ps w "  --list         print what would run, grouped by suite\n")
              (ps w "  selector       narrow to paths containing this substring, after suite selection\n\n")
              (ps w "A named file always runs, whichever suite does or does not claim it.\n\n")
              (ps w (common-flags-text))
              0)
          (= sub "fuzz")
            (do
              (ps w "usage: coil fuzz <file.coil> [-n ITERATIONS] [--cases N] [--seed N] [--no-run] [--keep]\n\n")
              (ps w "Runs the file's (defprop …) properties as `coil test` does, then keeps going\n")
              (ps w "with a COVERAGE-GUIDED search: mutate an input, keep it if it reached a basic\n")
              (ps w "block nothing has reached yet, and use the operands of failed comparisons to\n")
              (ps w "decide what to mutate it to. A bug behind a magic value or several nested\n")
              (ps w "conditions is reachable this way and effectively is not by sampling.\n\n")
              (ps w "The build differs from `coil test`: the program is emitted as LLVM IR and\n")
              (ps w "instrumented by clang (-fsanitize-coverage=trace-pc-guard,trace-cmp), because\n")
              (ps w "Coil emits its own objects and there is otherwise no point at which the\n")
              (ps w "instrumentation could be inserted. Requires the LLVM toolchain that\n")
              (ps w "`llvm-config --bindir` names.\n\n")
              (ps w "  -n, --iterations N   mutation iterations after generation (default 100000)\n")
              (ps w "      --cases N        random cases to generate first, seeding the corpus\n")
              (ps w "      --seed N         fix the seed; a failure report prints the one to reuse\n")
              (ps w "      --no-run         build the instrumented binary and stop\n")
              (ps w "      --keep           keep the build directory (the IR is in program.ll)\n\n")
              (ps w "A finding is an ordinary counterexample: minimized by the same shrinker and\n")
              (ps w "saved to .coil/pbt/, so the next plain `coil test` replays it immediately.\n")
              0)
          (= sub "verify")
            (do
              (ps w "usage: coil verify\n\n")
              (ps w "Validates Coil.toml, checks formatting, runs project lint rules, checks every\n")
              (ps w "configured target graph, builds native inputs, and runs all tests.\n")
              0)
          (= sub "lint")
            (do
              (ps w "usage: coil lint [file.coil] [--use <namespace>]... [--fix|--diff] [--allow-dirty]\n\n")
              (ps w "  (default)      report what the registered checkers say, plus a `help: try:`\n")
              (ps w "                 line for every fix they propose\n")
              (ps w "  --diff         print the patch those fixes would make; write nothing\n")
              (ps w "  --fix          apply them, re-analysing to a fixpoint (max 8 rounds)\n")
              (ps w "  --allow-dirty  allow --fix on a file with uncommitted changes\n\n")
              (ps w "The standard safe-fix profile runs automatically; --use adds project or policy\n")
              (ps w "rules. A round that produces code which does not compile is REVERTED, so\n")
              (ps w "--fix can never leave the tree worse than it found it. A plain `coil build`\n")
              (ps w "never writes to your source; only this command does.\n")
              0)
          (= sub "edit")
            (do
              (ps w "usage: coil edit <file.coil> [--in ADDR]... --form ADDR OP [--write]\n\n")
              (ps w "  --form ADDR       the form to act on: 'defn parse-args', 'impl Show Point'\n")
              (ps w "  --in ADDR         descend into this form first (repeatable, outermost first)\n")
              (ps w "  --replace         replace it with the forms on stdin (default)\n")
              (ps w "  --insert-before   insert stdin's forms before it (top-level only)\n")
              (ps w "  --insert-after    insert stdin's forms after it (top-level only)\n")
              (ps w "  --delete          remove it\n")
              (ps w "  --show            print it, change nothing\n")
              (ps w "  --list            list the addressable forms (needs no --form)\n")
              (ps w "  --write           rewrite the file (default: print the result)\n\n")
              (ps w "Edits a whole FORM rather than a range of text. A text patch can straddle a\n")
              (ps w "delimiter and leave a file that will not read; this cannot, because the\n")
              (ps w "replacement is rejected unless it is complete and balanced and the splice\n")
              (ps w "lands on the form's own boundaries.\n\n")
              (ps w "An address is a form's leading items, read as Coil, matched item by item, so\n")
              (ps w "layout inside an item does not matter. Matching is a PREFIX: `defn` names\n")
              (ps w "every defn and reports them, which is how you find the address you want.\n")
              (ps w "Nesting uses --in rather than a path separator because `/` is an ordinary\n")
              (ps w "character in a Coil symbol.\n\n")
              (ps w "Replacement text is read from stdin. Its first line is spliced at the form's\n")
              (ps w "own indentation, so write it unindented and indent the rest to suit.\n\n")
              (ps w "Exit: 0 done, 1 address not found or ambiguous, 2 bad input.\n")
              0)
          (= sub "balance")
            (do
              (ps w "usage: coil balance [--check|--write] [--strict] [--no-typecheck] <file.coil>...\n\n")
              (ps w "  (default)      print repaired source to stdout\n")
              (ps w "  --write        repair each file in place\n")
              (ps w "  --check        exit 1 if any file's delimiters do not balance\n")
              (ps w "  --strict       refuse a closer whose position indentation cannot determine\n")
              (ps w "  --no-typecheck decide from indentation alone, without compiling candidates\n")
              (ps w "  --stats        summarise ~/.coil/balance-log.jsonl and exit\n\n")
              (ps w "Repairs ()/[] in source that will not read. Where a missing closer goes is\n")
              (ps w "decided by indentation, scoped to the one top-level form that is damaged: a\n")
              (ps w "form that already balances is copied out byte-for-byte and never analysed.\n\n")
              (ps w "It only ever INSERTS a missing closer or DELETES an unmistakable stray one\n")
              (ps w "(a closer in column 0), and never moves a delimiter — so a repair cannot\n")
              (ps w "rearrange code that was already correct. A surplus closer elsewhere, a `)`\n")
              (ps w "against a `[`, or a form needing both an insert and a delete is REPORTED\n")
              (ps w "with its location rather than guessed at.\n\n")
              (ps w "Where indentation runs out — a closer belonging somewhere INSIDE a line, or\n")
              (ps w "a surplus closer that could equally be a missing opener — the TYPE CHECKER\n")
              (ps w "decides: the balancings are enumerated and the one that compiles is kept.\n")
              (ps w "Usually that is the indentation answer and it costs one compile to confirm.\n")
              (ps w "When nothing compiles (an ordinary state for a file mid-edit) the indentation\n")
              (ps w "answer stands and says so. --no-typecheck skips this entirely.\n\n")
              (ps w "A closer that neither could settle is still placed but counted in a `note:`,\n")
              (ps w "naming the line to check; --strict refuses those instead.\n\n")
              (ps w "Every run appends one line to ~/.coil/balance-log.jsonl — a path, an outcome,\n")
              (ps w "a cause and four counters. Nothing is sent anywhere and no source text is\n")
              (ps w "recorded; it exists so the refusals you actually hit can be counted, rather\n")
              (ps w "than inferred from a synthetic corpus. COIL_BALANCE_LOG=0 turns it off.\n\n")
              (ps w "Exit: 0 balanced, 1 unbalanced (--check), 2 error or refusal.\n")
              0)
          (= sub "fmt")
            (do
              (ps w "usage: coil fmt [--check|--write] [file.coil...]\n\n")
              (ps w "  (default)   print formatted source to stdout\n")
              (ps w "  --write     rewrite each file in place\n")
              (ps w "  --check     exit 1 if any file is not formatted\n\n")
              (ps w "Every file given is formatted. Exit: 0 clean, 1 unformatted, 2 error.\n")
              0)
          (= sub "check")
            (do
              (ps w "usage: coil check [<file.coil>] [flags]\n\n")
              (ps w "Runs the full front-end (typecheck + monomorphize) WITHOUT emitting an object\n")
              (ps w "or linking. Exit: 0 if it compiles, 1 with a located diagnostic if not.\n")
              (ps w "`build -o /dev/null` routes here too.\n\n")
              (ps w (common-flags-text))
              0)
          (= sub "new") (do (ps w "usage: coil new <name>\n\nScaffolds <name>/Coil.toml and <name>/src/main.coil.\n") 0)
          (= sub "doc")
            (do
              (ps w "usage: coil doc <file.coil>\n\n")
              (ps w "Prints markdown for every definition carrying a `;;` doc comment: its name,\n")
              (ps w "signature, and the doc. A doc comment is a run of lines starting with `;;`\n")
              (ps w "DIRECTLY above the definition — a single `;` stays an ordinary comment, so\n")
              (ps w "documenting something is opt-in. The same rule backs `(primitive/code-doc NODE)` at\n")
              (ps w "comptime, so doc tooling can be written as a library metaprogram.\n")
              0)
          (= sub "namespaces")
            (do (ps w "usage: coil namespaces\n\nLists the namespaces bundled into this compiler.\n") 0)
          (= sub "namespace")
            (do
              (ps w
                  "usage: coil namespace <name|file.coil>\n\nLists every definition and signature in a namespace; `;;` docs are included when present.\n")
              0)
          (= sub "emit-obj")
            (do
              (ps w
                  "usage: coil emit-obj <file.coil> [-o <out.o>]\n\nBuilds the object file without linking.\n\n")
              (ps w (common-flags-text))
              0)
          ; `--target` was accepted here long before it was documented, so the help
          ; text actively misled: it read as though cross-emission were impossible,
          ; which is exactly the wrong thing to believe when the Linux bootstrap
          ; artifacts have gone stale and this command is how you rebuild one.
          (= sub "emit-ir")
            (do
              (ps w "usage: coil emit-ir <file.coil> [--target <triple>]\n\n")
              (ps w "Prints normalized textual LLVM IR on stdout; diagnostics go to stderr,\n")
              (ps w "so `coil emit-ir f.coil > f.ll` writes IR and nothing else.\n\n")
              (ps w "  --target <triple>   emit for another platform rather than the host\n")
              (ps w "                      (e.g. x86_64-unknown-linux-gnu). Also selects what\n")
              (ps w "                      `(target-os)` answers, so per-platform constants fold\n")
              (ps w "                      for the TARGET.\n")
              0)
          (= sub "cheader")
            (do (ps w "usage: coil cheader <file.coil>\n\nPrints a C header for (export-c ...) functions.\n") 0)
          (= sub "cimport") (do (ps w "usage: coil cimport <header.h>\n\nGenerates Coil bindings from a C header.\n") 0)
          (do (ps w (usage-text)) 0))))

; argv[2] for the commands that take a <file>. Missing => NULL, and every caller
; feeds it straight to read-file/cstr->slice, so guard once here rather than
; segfaulting on `coil dump-ast` with no argument.
(defn need-file [(argc i32) (argv (ptr (ptr i8))) (sub (slice u8))] (-> (ptr i8))
  (let [fidx (argv-file-idx argc argv 2)]
    (if (= fidx (primitive/cast i64 0))
        (do
          (ps (stderr) "usage: coil ")
          (ps (stderr) sub)
          (ps (stderr) " <file.coil>\n")
          (exit 1)
          (primitive/cast (ptr i8) 0))
        (load (primitive/index argv fidx)))))

(defn driver-main [(argc i32)
                   (argv (ptr (ptr i8)))
                   (build-fn (fnptr c [(ptr Allocator) (slice u8) (slice u8) (ptr i8) (ptr i8) (slice u8)] i64))
                   (emitir-fn (fnptr c [(ptr Allocator) (slice u8) (slice u8) (ptr i8) (slice u8)] i64))
                   (normalize-fn (fnptr c [(ptr Allocator) (slice u8)] i64))
                   (cimport-fn (fnptr c [(ptr Allocator) i32 (ptr (ptr i8))] i64))
                   (default-backend i64)] (-> i64)
  ; argv[1] is NULL when argc < 2 — read it unguarded and `coil` with no args
  ; segfaults in cstr->slice before dispatch ever runs.
  ;
  ; THE ROOT ALLOCATOR. Every subcommand below is handed this one `a`, and the whole
  ; pipeline threads it, so this binding decides how the compiler allocates. A bump
  ; allocator is the right shape: AST nodes live until the process exits and almost
  ; nothing is individually freed, which is precisely the lifetime an arena is for.
  ;
  ; Measured on `build src/compiler/main.coil` (51k-line import closure), 15 paired runs
  ; alternating binaries with COIL_STDLIB_DIR pinned so both compile the SAME source (each
  ; binary embeds its own src/stdlib/*.coil, so without pinning the two sides are not compiling
  ; the same input — that artifact produced two wrong findings before it was caught; see
  ; docs/reference/ALLOCATION.md): -30 ms median, faster in 12 of 15 pairs, and 1044 -> 1021 MiB of
  ; peak RSS. The compiler already retained essentially everything it allocated, so
  ; dropping `free` costs no memory and malloc's per-block bookkeeping is what goes away.
  ;
  ; The region is 1 GiB because the win scales with how much of the workload it covers —
  ; a self-build allocates ~1 GB, and at 256 MiB the same change measured SLOWER than
  ; malloc, since an overflowing allocation pays the failed bump AND the malloc. 2 GiB and
  ; a strict 4 GiB arena measure the same as 1 GiB, so there is nothing past it to win.
  ; The reservation is lazy: `check` on a two-line file has the same 44 MiB RSS and the
  ; same 20 ms wall time as the malloc build, so small invocations are not taxed.
  ;
  ; `overflow-arena-allocator`, not `arena-allocator`, because this allocator is never
  ; reset and outlives a single compile — `repl-cmd` reuses it across every evaluation.
  ; A strict arena aborts once its region is spent; this one degrades to malloc.
  (let [a (overflow-arena-allocator 1073741824)
        sub
          (if (< (primitive/cast i64 argc) (primitive/cast i64 2))
              ""
              (cstr->slice (load (primitive/index argv 1))))
        namespace-ready
          (if (namespace-using-command? sub)
              (apply-project-manifest! a)
              0)
        ; Every command that accepts `--link-flag`/`-lfoo` gets them applied to the
        ; comptime/metaprogram link, not just `build`. build-cmd sets its own filtered
        ; list afterwards and wins.
        meta-link-ready (set-meta-link-flags-from-argv! a argc argv)]
    (cond (or (= sub "") (or (= sub "--help") (or (= sub "-h") (= sub "help")))) (do (ps (stdout) (usage-text)) 0)
          ; `<cmd> --help` before any dispatch, so it never reaches a parser that would
          ; reject it as an unknown flag or try to build a project.
          (wants-help? argc argv) (sub-usage sub)
          (= sub "__smoke") (smoke a)
          (= sub "__project-lint-one") (project-lint-one-cmd a argc argv)
          (= sub "__project-lint-all") (project-lint-all-cmd a argc argv)
          (or (= sub "--version") (or (= sub "-V") (= sub "version"))) (do (ps (stdout) (version-text)) 0)
          (= sub "guide") (do (ps (stdout) (guide-text)) 0)
          (= sub "namespaces") (do (ps (stdout) (embedded-namespaces)) 0)
          (= sub "doc") (doc-cmd a (cstr->slice (need-file argc argv sub)) false)
          (= sub "namespace") (doc-cmd a (cstr->slice (need-file argc argv sub)) true)
          (= sub "__normalize")
            (let [path (need-file argc argv sub)
                  src (read-src a path)]
              (primitive/call-ptr normalize-fn a src))
          (= sub "cimport") (primitive/call-ptr cimport-fn a argc argv)
          (= sub "repl") (repl-cmd a argv)
          ; Three cases, in order: no file at all (the project's own entry); a file
          ; named inside a project that has not been configured yet (same project
          ; build, different entry); and everything else — a lone file, or the child
          ; a project command already handed its configuration to.
          (= sub "run")
            (if (manifest-mode? argc argv)
                (manifest-cmd a "run" argc argv 0)
                (if (project-manifest?)
                    (manifest-cmd a "run" argc argv (argv-file-idx argc argv 2))
                    (run-cmd a argc argv)))
          (= sub "test") (test-cmd a argc argv)
          (= sub "fuzz") (fuzz-cmd a argc argv)
          (= sub "verify") (verify-cmd a argc argv)
          (or (= sub "fmt") (= sub "lint"))
            (if (= sub "lint")
                (lint-cmd a argc argv)
                (fmt-cmd a argc argv))
          (= sub "balance") (balance-cmd a argc argv)
          (= sub "edit") (edit-cmd a argc argv)
          (= sub "new") (new-cmd a argc argv)
          (= sub "emit-obj") (emit-obj-cmd a argc argv build-fn emitir-fn default-backend)
          (= sub "cheader") (cheader-cmd a argc argv)
          (= sub "build")
            (if (manifest-mode? argc argv)
                (manifest-cmd a "build" argc argv 0)
                (if (project-manifest?)
                    (manifest-cmd a "build" argc argv (argv-file-idx argc argv 2))
                    (build-cmd a
                               argc
                               argv
                               build-fn
                               emitir-fn
                               default-backend)))
          ; `check <file>`: typecheck/compile through mono, emit NO object. Exit 0 on a
          ; clean compile, 1 with a located diagnostic on failure. (diag-12)
          (= sub "check")
            (let [fidx (argv-file-idx argc argv 2)]
              (if (= fidx (primitive/cast i64 0))
                  (project-check-cmd a argc argv)
                  (check-one a (load (primitive/index argv fidx)) (argv-triple argc argv))))
          ; `interp <file>`: run through mono, then interpret. main's i64 return is
          ; the process exit code (returned straight from the big-stack pipeline).
          (= sub "interp")
            (let [path (need-file argc argv sub)]
              (set-target-arch! (argv-triple argc argv))
              ; hand the program its own argc/argv: argv[0] = the source file, then
              ; any extra command-line args (everything after `interp <file>`).
              (set-interp-args (primitive/cast i64
                                               (primitive/isub (primitive/cast i64 argc)
                                                               2))
                               (primitive/cast i64 (primitive/index argv 2)))
              (run-dump-on-big-stack a
                                     (read-src a path)
                                     (cwd-slice a)
                                     (cstr->slice path)
                                     (primitive/fnptr-of interp-src-program)))
          (= sub "dump-read")
            (let [path (need-file argc argv sub)]
              (run-dump-on-big-stack a
                                     (read-src a path)
                                     (cwd-slice a)
                                     (cstr->slice path)
                                     (primitive/fnptr-of dump-read-w)))
          (= sub "dump-ast")
            (let [path (need-file argc argv sub)]
              (run-dump-on-big-stack a
                                     (read-src a
                                               path)
                                     (cwd-slice a)
                                     (cstr->slice path)
                                     (primitive/fnptr-of dump-ast-w)))
          (= sub "dump-load")
            (let [path (need-file argc argv sub)]
              (run-dump-on-big-stack a
                                     (read-src a
                                               path)
                                     (cwd-slice a)
                                     (cstr->slice path)
                                     (primitive/fnptr-of dump-load-w)))
          (= sub "expand")
            (let [path
                    (need-file argc
                               argv
                               sub)]
              (set-target-arch! (argv-triple argc
                                             argv))
              (run-dump-on-big-stack a
                                     (read-src a
                                               path)
                                     (cwd-slice a)
                                     (cstr->slice path)
                                     (primitive/fnptr-of expand-src-w)))
          (= sub "dump-expand")
            (let [path
                    (need-file argc
                               argv
                               sub)]
              (set-target-arch! (argv-triple argc
                                             argv))
              (run-dump-on-big-stack a
                                     (read-src a
                                               path)
                                     (cwd-slice a)
                                     (cstr->slice path)
                                     (primitive/fnptr-of dump-expand-w)))
          (= sub "dump-resolved")
            (let [path
                    (need-file argc
                               argv
                               sub)]
              ; Apply --target like dump-expand does. Without this the flag is parsed
              ; and dropped: `target-os-str` sees an unset cell and falls back to the
              ; HOST probe, so `(target-os)`-selected code (coil.os's errno accessor,
              ; reached from io.coil by every staged printer) followed whoever ran the
              ; dump. That made these frontend stages host-dependent, which is exactly
              ; what they claim not to be.
              (set-target-arch! (argv-triple argc
                                             argv))
              (run-dump-on-big-stack a
                                     (read-src a
                                               path)
                                     (cwd-slice a)
                                     (cstr->slice path)
                                     (primitive/fnptr-of dump-resolved-w)))
          (= sub "dump-checked")
            (let [path
                    (need-file argc
                               argv
                               sub)]
              ; Apply --target like dump-expand does. Without this the flag is parsed
              ; and dropped: `target-os-str` sees an unset cell and falls back to the
              ; HOST probe, so `(target-os)`-selected code (coil.os's errno accessor,
              ; reached from io.coil by every staged printer) followed whoever ran the
              ; dump. That made these frontend stages host-dependent, which is exactly
              ; what they claim not to be.
              (set-target-arch! (argv-triple argc
                                             argv))
              (run-dump-on-big-stack a
                                     (read-src a
                                               path)
                                     (cwd-slice a)
                                     (cstr->slice path)
                                     (primitive/fnptr-of dump-checked-w)))
          (= sub "dump-mono")
            (let [path
                    (need-file argc
                               argv
                               sub)]
              ; Apply --target like dump-expand does. Without this the flag is parsed
              ; and dropped: `target-os-str` sees an unset cell and falls back to the
              ; HOST probe, so `(target-os)`-selected code (coil.os's errno accessor,
              ; reached from io.coil by every staged printer) followed whoever ran the
              ; dump. That made these frontend stages host-dependent, which is exactly
              ; what they claim not to be.
              (set-target-arch! (argv-triple argc
                                             argv))
              (run-dump-on-big-stack a
                                     (read-src a
                                               path)
                                     (cwd-slice a)
                                     (cstr->slice path)
                                     (primitive/fnptr-of dump-mono-w)))
          ; fallthrough = emit-ir / dump-ir. Anything else is a typo, not an
          ; alias for emit-ir — report it instead of compiling argv[2] (NULL).
          (not (or (= sub "emit-ir")
                   (= sub "dump-ir")))
            (do
              (ps (stderr)
                  "coil: unknown command '")
              (ps (stderr)
                  sub)
              (ps (stderr)
                  "'\n\n")
              (ps (stderr)
                  (usage-text))
              1)
          :else
            (let [path
                    (need-file argc
                               argv
                               sub)
                  ctx (alloc/stack DumpCtx)
                  (mut trip)
                    (primitive/cast (ptr i8)
                                    0)
                  (mut i) 3]
              ; parse `--target <triple>` from argv[3..] (cross-compile override).
              (loop (if (>= (load i)
                            (primitive/cast i64
                                            argc))
                        (break)
                        (if (and (< (primitive/iadd (load i)
                                                    1)
                                    (primitive/cast i64
                                                    argc))
                                 (= (cstr->slice (load (primitive/index argv
                                                                        (load i))))
                                    "--target"))
                            (do
                              (store! trip
                                      (load (primitive/index argv
                                                             (primitive/iadd (load i)
                                                                             1))))
                              (store! i
                                      (primitive/iadd (load i)
                                                      2))
                              0)
                            ; `--use`, as `build` accepts it. Without this the flag
                            ; parsed as an unknown argument and was skipped, so
                            ; `emit-ir --use coil.assert` produced IR for a file of
                            ; tests with NO `main` — the transform that synthesizes
                            ; one is registered by loading the module, and the
                            ; module was never loaded. `coil fuzz` builds through
                            ; this path, so the omission made it emit a program
                            ; that could not link.
                            (if (= (cstr->slice (load (primitive/index argv (load i)))) "--use")
                                (do
                                  (when (>= (primitive/iadd (load i) 1) (primitive/cast i64 argc))
                                    (ps (stderr) "error: --use needs a namespace\n")
                                    (exit 2)
                                    0)
                                  (cli-use-add (cstr->slice (load (primitive/index argv
                                                                                   (primitive/iadd (load i) 1)))))
                                  (store! i (primitive/iadd (load i) 2))
                                  0)
                                (do
                                  (store! i
                                          (primitive/iadd (load i)
                                                          1))
                                  0)))))
              (store! (field ctx a) a)
              (store! (field ctx src)
                      (read-src a
                                path))
              (store! (field ctx cwd) (cwd-slice a))
              (store! (field ctx path) (cstr->slice path))
              (store! (field ctx mode) 0)
              (store! (field ctx obj)
                      (primitive/cast (ptr i8)
                                      0))
              (store! (field ctx triple) (load trip))
              (set-target-arch! (load trip))
              (store! (field ctx ok) 0)
              (store! (field ctx build-fn) build-fn)
              (store! (field ctx emitir-fn) emitir-fn)
              ; emit-ir: exit FAILURE (1) if the pipeline reported a diagnostic,
              ; `report(emit_ir(...))` returning ExitCode::FAILURE.
              (when (= (run-on-big-stack ctx) (primitive/cast i64 0))
                1)))))  ;; ===== GRAFTED FROM expander.coil: comptime interpreter + expand-stage3 driver =====))))))))
