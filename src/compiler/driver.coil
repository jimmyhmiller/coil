(extern rmdir :cc (cc/C) [(ptr i8)] (-> i32))

; ============================ `coil doc` ====================================
; Render a module's documented surface as markdown. A doc is a `;;;` comment block
; directly above a definition (`ct-doc-at`, the same rule `(primitive/code-doc NODE)` uses at
; comptime) — so the docs live in the source, in one place, and nothing can drift.

; Multiword guide searches require every term, but tolerate ordinary English
; endings on long words (`conversion` finds `converts`). This is intentionally
; not used for namespace identifiers, where exact substrings are predictable.
(defn guide-query-match? [(hay (slice u8)) (query (slice u8))] (-> bool)
  (let [n (len query)
        (mut start) 0
        (mut i) 0
        (mut ok) true]
    (loop (if (or (not (load ok)) (> (load i) n))
              (break)
              (if (or (= (load i) n)
                      (= (primitive/cast i64 (get query (load i)))
                         32))
                  (do
                    (when (> (load i) (load start))
                      (let [word (subslice [u8] query (load start) (load i))
                            wn (len word)
                            probe
                              (if (>= wn 8)
                                  (subslice [u8] word 0 (primitive/isub wn 4))
                                  word)]
                        (unless (ref-contains-ci? hay probe)
                          (set! ok false)
                          0)))
                    (set! start (primitive/iadd (load i) 1))
                    (set! i (primitive/iadd (load i) 1)))
                  (set! i (primitive/iadd (load i) 1)))))
    (load ok)))

(defn guide-query-word-count [(query (slice u8))] (-> i64)
  (let [n (len query)
        (mut i) 0
        (mut in-word) false
        (mut count) 0]
    (loop (if (>= (load i) n)
              (break)
              (let [space
                      (= (primitive/cast i64 (get query (load i)))
                         32)]
                (if space
                    (set! in-word false)
                    (unless (load in-word)
                      (set! count (primitive/iadd (load count) 1))
                      (set! in-word true)
                      0))
                (set! i (primitive/iadd (load i) 1)))))
    (load count)))

(defn guide-stop-word? [(word (slice u8))] (-> bool)
  (or (= word "a")
      (= word "an")
      (= word "and")
      (= word "or")
      (= word "the")
      (= word "to")
      (= word "for")))

(defn guide-broad-topic? [(topic (slice u8))] (-> bool)
  (or (= topic "tour") (= topic "project") (= topic "gotchas")))

(defn guide-meta-has? [(meta (slice u8)) (probe (slice u8))] (-> bool)
  (let [n (len meta)
        pn (len probe)
        (mut start) 0
        (mut i) 0
        (mut found) false]
    (loop (if (or (load found) (> (load i) n))
              (break)
              (if (or (= (load i) n)
                      (= (primitive/cast i64 (get meta (load i)))
                         32))
                  (do
                    (when (>= (primitive/isub (load i) (load start)) pn)
                      (when (ref-contains-ci? (subslice [u8]
                                                        meta
                                                        (load start)
                                                        (primitive/iadd (load start)
                                                                        pn))
                                              probe)
                        (set! found true)
                        0))
                    (set! start (primitive/iadd (load i) 1))
                    (set! i (primitive/iadd (load i) 1)))
                  (set! i (primitive/iadd (load i) 1)))))
    (load found)))

; Rank a topic primarily by curated metadata coverage. Body hits only break ties;
; they cannot make a broad survey section outrank the focused topic that explicitly
; owns a concept.
(defn guide-topic-query-rank [(topic (slice u8)) (query (slice u8))] (-> i64)
  (let [meta (guide-topic-search-text topic)
        body (guide-topic-text topic)
        n (len query)
        (mut start) 0
        (mut i) 0
        (mut metadata-hits) 0
        (mut body-hits) 0]
    (loop (if (> (load i) n)
              (break)
              (if (or (= (load i) n)
                      (= (primitive/cast i64 (get query (load i)))
                         32))
                  (do
                    (when (> (load i) (load start))
                      (let [word (subslice [u8] query (load start) (load i))
                            wn (len word)
                            probe
                              (if (>= wn 8)
                                  (subslice [u8] word 0 (primitive/isub wn 4))
                                  word)]
                        (unless (guide-stop-word? word)
                          (when (guide-meta-has? meta probe)
                            (set! metadata-hits
                                  (primitive/iadd (load metadata-hits) 1))
                            0)
                          (when (ref-contains-ci? body probe)
                            (set! body-hits (primitive/iadd (load body-hits) 1))
                            0)
                          0)))
                    (set! start (primitive/iadd (load i) 1))
                    (set! i (primitive/iadd (load i) 1)))
                  (set! i (primitive/iadd (load i) 1)))))
    (if (or (= (load metadata-hits) 0)
            (and (<= (load metadata-hits) 2)
                 (guide-broad-topic? topic)))
        0
        (primitive/iadd (primitive/imul (load metadata-hits) 100)
                        (load body-hits)))))

; A deliberately small typo score for topic suggestions: unmatched suffix plus
; length difference. Topic names are short and distinctive, and this ranks the
; common one-edit failures (`testt`, `struct`, `operatorr`) correctly without
; carrying a general edit-distance implementation in the compiler driver.
(defn guide-topic-score [(want (slice u8)) (candidate (slice u8))] (-> i64)
  (let [wn (len want)
        cn (len candidate)
        lim (if (< wn cn) wn cn)
        (mut common) 0]
    (loop (if (or (>= (load common) lim)
                  (!= (ref-lower-byte (get want (load common)))
                      (ref-lower-byte (get candidate (load common)))))
              (break)
              (set! common (primitive/iadd (load common) 1))))
    (primitive/iadd (primitive/isub lim (load common))
                    (if (> wn cn) (primitive/isub wn cn) (primitive/isub cn wn)))))

(defn guide-suggest [(topic (slice u8))] (-> i64)
  (let [names (guide-topic-names)
        n (len names)
        (mut start) 0
        (mut i) 0
        (mut best1) ""
        (mut best2) ""
        (mut best3) ""
        (mut score1) 1000000
        (mut score2) 1000000
        (mut score3) 1000000]
    (loop (if (> (load i) n)
              (break)
              (if (or (= (load i) n)
                      (= (primitive/cast i64 (get names (load i)))
                         10))
                  (do
                    (when (> (load i) (load start))
                      (let [name (subslice [u8] names (load start) (load i))
                            score (guide-topic-score topic name)]
                        (if (< score (load score1))
                            (do
                              (set! score3 (load score2))
                              (set! best3 (load best2))
                              (set! score2 (load score1))
                              (set! best2 (load best1))
                              (set! score1 score)
                              (set! best1 name))
                            (if (< score (load score2))
                                (do
                                  (set! score3 (load score2))
                                  (set! best3 (load best2))
                                  (set! score2 score)
                                  (set! best2 name))
                                (when (< score (load score3))
                                  (set! score3 score)
                                  (set! best3 name)
                                  0)))))
                    (set! start (primitive/iadd (load i) 1))
                    (set! i (primitive/iadd (load i) 1)))
                  (set! i (primitive/iadd (load i) 1)))))
    (ps (stderr) "\nClosest topics:\n")
    (when (> (len (load best1)) 0)
      (ps (stderr) "  ")
      (ps (stderr) (load best1))
      (wb (stderr) 10)
      0)
    (when (> (len (load best2)) 0)
      (ps (stderr) "  ")
      (ps (stderr) (load best2))
      (wb (stderr) 10)
      0)
    (when (> (len (load best3)) 0)
      (ps (stderr) "  ")
      (ps (stderr) (load best3))
      (wb (stderr) 10)
      0)
    0))

(defn guide-heading-title [(paragraph (slice u8))] (-> (slice u8))
  (let [n (len paragraph)
        (mut lo) 0
        (mut hi) 0]
    (loop (if (and (< (load lo) n)
                   (or (= (primitive/cast i64 (get paragraph (load lo)))
                          35)
                       (= (primitive/cast i64 (get paragraph (load lo)))
                          32)))
              (set! lo (primitive/iadd (load lo) 1))
              (break)))
    (set! hi (load lo))
    (loop (if (or (>= (load hi) n)
                  (= (primitive/cast i64 (get paragraph (load hi)))
                     10))
              (break)
              (set! hi (primitive/iadd (load hi) 1))))
    (subslice [u8] paragraph (load lo) (load hi))))

(defn guide-search-topic-excerpts [(topic (slice u8)) (query (slice u8))]
  (-> i64)
  (let [text (guide-topic-text topic)
        n (len text)
        w (stdout)
        (mut start) 0
        (mut i) 0
        (mut heading) topic
        (mut last-heading) ""
        (mut shown) 0]
    (loop (if (or (>= (load i) n) (>= (load shown) 2))
              (break)
              (if (and (= (primitive/cast i64 (get text (load i)))
                          10)
                       (< (primitive/iadd (load i) 1) n)
                       (= (primitive/cast i64
                                          (get text (primitive/iadd (load i) 1)))
                          10))
                  (let [paragraph (subslice [u8] text (load start) (load i))
                        plen (len paragraph)
                        is-heading
                          (and (> plen 0)
                               (= (primitive/cast i64 (get paragraph 0))
                                  35))]
                    (if is-heading
                        (set! heading (guide-heading-title paragraph))
                        (when (and (> plen 0)
                                   (guide-query-match? paragraph query))
                          (when (!= (load heading) (load last-heading))
                            (ps w "### ")
                            (ps w (load heading))
                            (wb w 10)
                            (wb w 10)
                            (set! last-heading (load heading))
                            0)
                          (ps w paragraph)
                          (wb w 10)
                          (wb w 10)
                          (set! shown (primitive/iadd (load shown) 1))
                          0))
                    (set! i (primitive/iadd (load i) 2))
                    (set! start (load i)))
                  (set! i (primitive/iadd (load i) 1)))))
    (when (and (< (load shown) 2) (< (load start) n))
      (let [paragraph (subslice [u8] text (load start) n)]
        (when (guide-query-match? paragraph query)
          (when (!= (load heading) (load last-heading))
            (ps w "### ")
            (ps w (load heading))
            (wb w 10)
            (wb w 10)
            (set! last-heading (load heading))
            0)
          (ps w paragraph)
          (wb w 10)
          (wb w 10)
          (set! shown (primitive/iadd (load shown) 1))
          0)))
    (load shown)))

; Search is a topic router first. Models commonly submit a bag of concepts, so
; ranking is based on coverage across each topic's curated vocabulary rather than
; requiring every word to occur in one paragraph. One/two-term searches also get
; at most two excerpts from the best topic; broader searches stay recommendation-only.
(defn guide-search-ranked [(query (slice u8))] (-> i64)
  (let [count (guide-topic-count)
        (mut i) 0
        (mut best1) ""
        (mut best2) ""
        (mut best3) ""
        (mut score1) 0
        (mut score2) 0
        (mut score3) 0]
    (loop (if (>= (load i) count)
              (break)
              (let [topic (guide-topic-name-at (load i))
                    score (guide-topic-query-rank topic query)]
                (if (> score (load score1))
                    (do
                      (set! score3 (load score2))
                      (set! best3 (load best2))
                      (set! score2 (load score1))
                      (set! best2 (load best1))
                      (set! score1 score)
                      (set! best1 topic))
                    (if (> score (load score2))
                        (do
                          (set! score3 (load score2))
                          (set! best3 (load best2))
                          (set! score2 score)
                          (set! best2 topic))
                        (when (> score (load score3))
                          (set! score3 score)
                          (set! best3 topic)
                          0)))
                (set! i (primitive/iadd (load i) 1)))))
    (if (= (load score1) 0)
        (do
          (ps (stderr) "No guide topics matched: ")
          (ps (stderr) query)
          (wb (stderr) 10)
          (ps (stderr) "Run `coil guide` to list topics.\n")
          1)
        (let [w (stdout)]
          (ps w
              (if (= (load score2) 0)
                  "Best topic:\n"
                  "Best topics:\n"))
          (ps w "  ")
          (ps w (load best1))
          (ps w " — ")
          (ps w (guide-topic-description (load best1)))
          (wb w 10)
          (when (> (load score2) 0)
            (ps w "  ")
            (ps w (load best2))
            (ps w " — ")
            (ps w (guide-topic-description (load best2)))
            (wb w 10)
            0)
          (when (> (load score3) 0)
            (ps w "  ")
            (ps w (load best3))
            (ps w " — ")
            (ps w (guide-topic-description (load best3)))
            (wb w 10)
            0)
          (ps w "\nRun:\n  coil guide ")
          (ps w (load best1))
          (when (> (load score2) 0)
            (ps w " ")
            (ps w (load best2))
            0)
          (when (> (load score3) 0)
            (ps w " ")
            (ps w (load best3))
            0)
          (wb w 10)
          (when (<= (guide-query-word-count query) 2)
            (ps w "\nRelevant excerpts:\n\n")
            (guide-search-topic-excerpts (load best1) query)
            0)
          0))))

(defn guide-key-seen? [(seen (ptr (ArrayList (slice u8)))) (key (slice u8))]
  (-> bool)
  (let [n (len (load seen))
        (mut i) 0
        (mut found) false]
    (loop (if (or (load found) (>= (load i) n))
              (break)
              (if (= (get (load seen) (load i)) key)
                  (set! found true)
                  (set! i (primitive/iadd (load i) 1)))))
    (load found)))

(defn guide-print-topic-fragments [(a (dyn Allocator))
                                   (seen (mut (ArrayList (slice u8))))
                                   (topic (slice u8))] (-> i64)
  (let [keys (guide-topic-fragment-keys topic)
        n (len keys)
        (mut start) 0
        (mut i) 0]
    (loop (if (> (load i) n)
              (break)
              (if (or (= (load i) n)
                      (= (primitive/cast i64 (get keys (load i)))
                         10))
                  (do
                    (when (> (load i) (load start))
                      (let [key (subslice [u8] keys (load start) (load i))]
                        (unless (guide-key-seen? (mut seen) key)
                          (push! (mut seen) key)
                          (ps (stdout) (guide-fragment-text key))
                          0)))
                    (set! start (primitive/iadd (load i) 1))
                    (set! i (primitive/iadd (load i) 1)))
                  (set! i (primitive/iadd (load i) 1)))))
    0))

(defn guide-topics-cmd [(a (dyn Allocator))
                        (argc i32)
                        (argv (ptr (ptr i8)))] (-> i64)
  (let [n (primitive/cast i64 argc)
        (mut i) 2
        (mut valid) true]
    ; Validate every topic before printing, so one typo never yields partial output.
    (loop (if (or (not (load valid)) (>= (load i) n))
              (break)
              (let [raw (from-cstr (load (index argv (load i))))]
                (when (= (len (guide-canonical-topic raw))
                         0)
                  (ps (stderr) "error: unknown guide topic: ")
                  (ps (stderr) raw)
                  (wb (stderr) 10)
                  (guide-suggest raw)
                  (ps (stderr) "\nRun `coil guide` to list topics.\n")
                  (set! valid false)
                  0)
                (set! i (primitive/iadd (load i) 1)))))
    (if (not (load valid))
        1
        (let [(mut seen) (ArrayList::new [(slice u8)] a)]
          (set! i 2)
          (loop (if (>= (load i) n)
                    (break)
                    (do
                      (guide-print-topic-fragments a
                                                   (mut seen)
                                                   (guide-canonical-topic (from-cstr (load (index argv
                                                                                                  (load i))))))
                      (set! i (primitive/iadd (load i) 1)))))
          0))))

(defn guide-cmd [(a (dyn Allocator)) (argc i32) (argv (ptr (ptr i8)))] (-> i64)
  (let [n (primitive/cast i64 argc)]
    (cond (= n 2) (do (ps (stdout) (guide-toc-text)) 0)
          (and (= n 3)
               (= (from-cstr (load (index argv 2))) "--all"))
            (do (ps (stdout) (guide-text)) 0)
          (and (= n 4)
               (= (from-cstr (load (index argv 2))) "--search"))
            (let [query (from-cstr (load (index argv 3)))]
              (if (= (len query) 0)
                  (do
                    (ps (stderr) "error: guide search text must not be empty\n")
                    1)
                  (guide-search-ranked query)))
          (and (= n 3)
               (= (from-cstr (load (index argv 2))) "--search"))
            (do (ps (stderr) "usage: coil guide --search <text>\n") 1)
          (>= n 3) (guide-topics-cmd a argc argv)
          (do
            (ps (stderr)
                "usage: coil guide [<topic> [topic...]]|--search <text>|--all\n")
            1))))

; ============================ file IO + entry ===============================
;;; Report a stage dump's failure the way every dump does: as an `(error …)`
;;; node on the dump's own output.
(defn dump-failed [(w (ptr Writer)) (d Diag)] (-> i64)
  (let [(mut dp) d] (dump-error w (mut dp)))
  1)

;;; Run the front end a stage dump shares with `check`, as far as loading the
;;; program, or through expansion when EXPAND: the entry file PATH read as a
;;; compile reads it (a configured reader included), loaded with everything it
;;; imports from where PATH is. Every dump runs this one front, so they agree
;;; with `check` and with each other about what the program is. False, with the
;;; failure dumped to W, when a step failed.
(defn dump-front! [(a (dyn Allocator))
                   (s (mut LS))
                   (w (ptr Writer))
                   (src (slice u8))
                   (cwd (slice u8))
                   (path (slice u8))
                   (expand bool)] (-> bool)
  (ls-init! (mut s) a)
  (set! (.srccount s) 1)
  (register-source! (mut s) path src)
  (match (initial-read a (mut s) src path cwd)
    (InitialReadError [d] (do (dump-failed w d) false))
    (InitialForms [forms reader-state definition-module]
                  (do
                    (frontend-load! a
                                    (mut s)
                                    src
                                    path
                                    forms
                                    reader-state
                                    definition-module)
                    (cond (ls-err? (mut s))
                            (do (dump-failed w (.loaderr s)) false)
                          (not expand) true
                          :else
                            (match (frontend-expand! a (mut s))
                              (Err [d] (do (dump-failed w d) false))
                              (Ok [_] true)))))))

;;; `coil dump-ast`: the primitive parser's view of the source as written --
;;; no loading or expansion, so `defn*`/`let*` forms, not the binding macros (see
;;; docs/design/DESTRUCTURING_AND_BINDING_MACROS.md). Nonzero when the source
;;; does not read or parse: the error was dumped and the status said success.
(defn dump-ast-program [(a (dyn Allocator)) (src (slice u8))] (-> i64)
  (let [(mut bout) (zeroed BufferedOutput)
        w (BufferedOutput::init (mut bout) (stdout))
        rc
          (match (read-all a src 0)
            (Err [d] (dump-failed w d))
            (Ok [forms]
                (match (parse-program a forms)
                  (Err [d] (dump-failed w d))
                  (Ok [prog] (let [(mut pp) prog] (d-program w (mut pp) a) 0)))))]
    (flush (mut bout))
    rc))

;;; The stages `coil dump-STAGE` prints, in pipeline order.
(defsum DumpStage
  (DumpLoad [])
  (DumpExpand [])
  (DumpHygiene [])
  (DumpResolved [])
  (DumpChecked [])
  (DumpMono []))

;;; Dump the program PATH holds as of STAGE. 0 when the program got through
;;; STAGE and was dumped; 1, with the failure dumped in its place, when a step
;;; up to and including STAGE failed. A later stage's failure is not this one's:
;;; the hygiene view runs the transforms, not the type check after them.
(defn dump-stage-program [(a (dyn Allocator))
                          (src (slice u8))
                          (cwd (slice u8))
                          (path (slice u8))
                          (stage DumpStage)] (-> i64)
  (let [(mut bout) (zeroed BufferedOutput)
        w (BufferedOutput::init (mut bout) (stdout))
        s (primitive/alloc-stack LS)
        rc
          (if (not (dump-front! a
                                (mut s)
                                w
                                src
                                cwd
                                path
                                (match stage (DumpLoad [] false) (_ true))))
              1
              (match stage
                (DumpLoad [] (do (dump-loaded w a (mut s)) 0))
                (DumpExpand [] (do (d-expanded w a (mut s)) 0))
                (DumpHygiene []
                             (match (run-transforms a (mut s))
                               (Err [d] (dump-failed w d))
                               (Ok [_] (do (d-hygiene w (mut s)) 0))))
                (DumpResolved []
                              (match (resolve-program a (mut s) true false)
                                (Err [d] (dump-failed w d))
                                (Ok [prog] (do (d-program w prog a) 0))))
                (DumpChecked []
                             (match (run-transforms-and-check a (mut s))
                               (Err [d] (dump-failed w d))
                               (Ok [cp] (do (d-program w cp a) 0))))
                (DumpMono []
                          (match (run-transforms-and-check a (mut s))
                            (Err [d] (dump-failed w d))
                            (Ok [cp]
                                (do
                                  (drop-code-funcs a cp)
                                  (match (monomorphize a cp (staged-instances))
                                    (Err [d] (dump-failed w d))
                                    (Ok [mp]
                                        (do
                                          (sort-mono-program a mp)
                                          (d-program w mp a)
                                          0)))))))))]
    (flush (mut bout))
    rc))

; dump-read: raw read -> canonical Sexp forms (reader oracle). sx-node's
; @source:lo:hi:ctxt is byte-identical to the standalone reader dumper for raw
; single-file input (source=0, ctxt=0, no dummy spans).
(defn dump-read-program [(a (dyn Allocator)) (src (slice u8))] (-> i64)
  (let [(mut bout) (zeroed BufferedOutput)
        w (BufferedOutput::init (mut bout) (stdout))
        rc
          (match (read-all a src 0)
            (Err [d] (dump-failed w d))
            (Ok [forms]
                (let [(mut i) 0
                      n (len (load forms))]
                  (loop (if (>= (load i) n)
                            (break)
                            (do
                              (when (> (load i) 0) (wb w 10))
                              (let [(mut child) (get (load forms) (load i))]
                                (sx-node w (mut child)))
                              (set! i (primitive/iadd (load i) 1)))))
                  0)))]
    (flush (mut bout))
    rc))

; ---- loader-dump helpers ported verbatim from src/compiler/frontend/loader.coil ----
; (imp-elem/exp-elem/d-strs/d-opt-str/dstr already defined above.)
(defn alias-key [(x Alias)] (-> (slice u8))
  (let [(mut p) (: x Alias)] (.alias p)))

(defn alias-tgt [(x Alias)] (-> (slice u8))
  (let [(mut p) (: x Alias)] (.target p)))

(defn use-tgt [(x Use)] (-> (slice u8))
  (let [(mut p) (: x Use)] (.target p)))

(defn use-spec [(x Use)] (-> UseSpec)
  (let [(mut p) (: x Use)] (.spec p)))

; selection-sort a COPY of a slice list ascending by cmp.
(defn sorted-strs [(a (dyn Allocator)) (l (ptr (ArrayList (slice u8))))]
  (-> (ptr (ArrayList (slice u8))))
  (let [n (len (load l))
        (mut c) (ArrayList::new [(slice u8)] a)
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (push! (mut c) (get (load l) (load i)))
                (set! i (primitive/iadd (load i) 1)))))
    (let [(mut p) 0]
      (loop (if (>= (load p) n)
                (break)
                (do
                  (let [(mut m) (load p)
                        (mut q) (primitive/iadd (load p) 1)]
                    (loop (if (>= (load q) n)
                              (break)
                              (do
                                (when (str-lt (get (load c) (load q))
                                              (get (load c) (load m)))
                                  (set! m (load q)))
                                (set! q (primitive/iadd (load q) 1)))))
                    (let [tp (get (load c) (load p))
                          tm (get (load c) (load m))]
                      (set! (mut c) (load p) tm)
                      (set! (mut c) (load m) tp)))
                  (set! p (primitive/iadd (load p) 1))))))
    (box! a (ArrayList (slice u8)) (load c))))

; sorted index permutation of 0..n by the parallel key strings (selection sort).
(defn sort-idx [(a (dyn Allocator)) (keys (ptr (ArrayList (slice u8))))]
  (-> (ptr (ArrayList i64)))
  (let [n (len (load keys))
        (mut idx) (ArrayList::new [i64] a)
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (push! (mut idx) (load i))
                (set! i (primitive/iadd (load i) 1)))))
    (let [(mut p) 0]
      (loop (if (>= (load p) n)
                (break)
                (do
                  (let [(mut m) (load p)
                        (mut q) (primitive/iadd (load p) 1)]
                    (loop (if (>= (load q) n)
                              (break)
                              (do
                                (when (str-lt (get (load keys)
                                                   (get (load idx) (load q)))
                                              (get (load keys)
                                                   (get (load idx) (load m))))
                                  (set! m (load q)))
                                (set! q (primitive/iadd (load q) 1)))))
                    (let [tp (get (load idx) (load p))
                          tm (get (load idx) (load m))]
                      (set! (mut idx) (load p) tm)
                      (set! (mut idx) (load m) tp)))
                  (set! p (primitive/iadd (load p) 1))))))
    (box! a (ArrayList i64) (load idx))))

; `(aliases [(al "k" "v") …]) (uses [(use "t" SPEC) …]) (reexports [(use "t" SPEC) …])`.
(defn d-modimports [(w (ptr Writer)) (a (dyn Allocator)) (m (mut ModImports))]
  (-> i64)
  (ps w "(aliases [")
  (let [na (len (.aliases m))
        (mut keys) (ArrayList::new [(slice u8)] a)
        (mut i) 0]
    (loop (if (>= (load i) na)
              (break)
              (do
                (push! (mut keys) (alias-key (get (.aliases m) (load i))))
                (set! i (primitive/iadd (load i) 1)))))
    (let [kp
            (box! a
                  (ArrayList (slice u8))
                  (zeroed (ArrayList (slice u8))))]
      (set! kp (load keys))
      (let [idx (sort-idx a kp)
            (mut j) 0]
        (loop (if (>= (load j) na)
                  (break)
                  (do
                    (when (> (load j) 0) (wb w 32))
                    (let [e (get (.aliases m) (get (load idx) (load j)))]
                      (ps w "(al ")
                      (dstr w (alias-key e))
                      (wb w 32)
                      (dstr w (alias-tgt e))
                      (wb w 41))
                    (set! j (primitive/iadd (load j) 1))))))))
  (ps w "]) (uses [")
  (d-use-list w (.uses m))
  (ps w "]) (reexports [")
  (d-use-list w (.reexports m))
  (ps w "])")
  0)

(defn d-use-list [(w (ptr Writer)) (us (ref (ArrayList Use)))] (-> i64)
  (for [i 0 (len us)]
    (when (> i 0) (wb w 32))
    (let [u (get us i)]
      (ps w "(use ")
      (dstr w (use-tgt u))
      (wb w 32)
      (match (use-spec u)
        (UAll [] (ps w "(all)"))
        (UNames [names]
                (do (ps w "(names ") (d-strs w names) (wb w 41))))
      (wb w 41))
    0)
  0)

; dump-load: read -> load -> canonical loaded-forms/imports/exports dump.
(defn dump-loaded [(w (ptr Writer)) (a (dyn Allocator)) (s (mut LS))] (-> i64)
  (ps w "(forms")
  (let [n (len (.out s))
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (ps w " (tf ")
                (let [tf (primitive/alloc-stack TaggedForm)]
                  (set! tf (get (.out s) (load i)))
                  (d-opt-str w (.module tf))
                  (wb w 32)
                  (let [(mut fp) (.form tf)] (sx-node w (mut fp))))
                (wb w 41)
                (set! i (primitive/iadd (load i) 1))))))
  (wb w 41)
  (wb w 10)
  (ps w "(imports")
  (let [n (len (.imports s))
        (mut keys) (ArrayList::new [(slice u8)] a)
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (push! (mut keys) (.name (avec-at (.imports s) (load i))))
                (set! i (primitive/iadd (load i) 1)))))
    (let [kp
            (box! a
                  (ArrayList (slice u8))
                  (zeroed (ArrayList (slice u8))))]
      (set! kp (load keys))
      (let [idx (sort-idx a kp)
            (mut j) 0]
        (loop (if (>= (load j) n)
                  (break)
                  (do
                    (let [e (avec-at (.imports s) (get (load idx) (load j)))]
                      (ps w " (mod ")
                      (dstr w (.name e))
                      (wb w 32)
                      (d-modimports w a (mut (.imp e)))
                      (wb w 41))
                    (set! j (primitive/iadd (load j) 1))))))))
  (wb w 41)
  (wb w 10)
  (ps w "(exports")
  (let [n (len (.exports s))
        (mut keys) (ArrayList::new [(slice u8)] a)
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (push! (mut keys) (.name (avec-at (.exports s) (load i))))
                (set! i (primitive/iadd (load i) 1)))))
    (let [kp
            (box! a
                  (ArrayList (slice u8))
                  (zeroed (ArrayList (slice u8))))]
      (set! kp (load keys))
      (let [idx (sort-idx a kp)
            (mut j) 0]
        (loop (if (>= (load j) n)
                  (break)
                  (do
                    (let [e (avec-at (.exports s) (get (load idx) (load j)))
                          namesp
                            (box! a
                                  (ArrayList (slice u8))
                                  (zeroed (ArrayList (slice u8))))]
                      (set! namesp (.names e))
                      (ps w " (mod ")
                      (dstr w (.name e))
                      (wb w 32)
                      (d-strs w (sorted-strs a namesp))
                      (wb w 41))
                    (set! j (primitive/iadd (load j) 1))))))))
  (wb w 41)
  0)

; A standalone byte-exact smoke for the 6 new d-expr arms (run: `<bin> __smoke`).
; Each line must match exactly what would emit for the same node.
(defn smoke [(a (dyn Allocator))] (-> i64)
  (let [w (stdout)]
    ; (staticref@1:2 "foo")
    (let [e (primitive/alloc-stack Expr)]
      (set! e (mk-expr (EStaticRef "foo") 1 2 0 0))
      (d-expr w e))
    (wb w 10)
    ; (spillref@5:6 (eint@3:4 7))
    (let [inner (box-expr a (mk-expr (EInt 7) 3 4 0 0))
          e (primitive/alloc-stack Expr)]
      (set! e (mk-expr (ESpillRef inner) 5 6 0 0))
      (d-expr w e))
    (wb w 10)
    ; (construct@9:10 "Opt" "Some" [(eint@7:8 9)])
    (let [(mut xs) (ArrayList::new [Expr] a)]
      (push! (mut xs) (mk-expr (EInt 9) 7 8 0 0))
      (let [args (box-al [Expr] a (load xs))
            e (primitive/alloc-stack Expr)]
        (set! e
              (mk-expr (EConstruct
                         :sum "Opt"
                         :variant "Some"
                         :args args)
                       9
                       10
                       0
                       0))
        (d-expr w e)))
    (wb w 10)
    ; (traitcall@11:12 "Eq" "eq" "T" [])
    (let [args (box-al [Expr] a (ArrayList::new [Expr] a))
          e (primitive/alloc-stack Expr)]
      (set! e
            (mk-expr (ETraitCall
                       :trait_name "Eq"
                       :method "eq"
                       :self_tp "T"
                       :args args)
                     11
                     12
                     0
                     0))
      (d-expr w e))
    (wb w 10)
    ; (makedyn@13:14 "Dyn" "VT" ["m0" "m1"] (var@15:16 "x"))
    (let [(mut ms) (ArrayList::new [(slice u8)] a)]
      (push! (mut ms) "m0")
      (push! (mut ms) "m1")
      (let [methods (box-al [(slice u8)] a (load ms))
            inner (box-expr a (mk-expr (EVar "x") 15 16 0 0))
            e (primitive/alloc-stack Expr)]
        (set! e
              (mk-expr (EMakeDyn
                         :dyn_struct "Dyn"
                         :vtable_struct "VT"
                         :methods methods
                         :inner inner)
                       13
                       14
                       0
                       0))
        (d-expr w e)))
    (wb w 10)
    ; (dyndispatch@17:18 "Dyn" "VT" 2 "coil.cc.C" [] void (var@19:20 "r") [])
    (let [params (box-al [Type] a (ArrayList::new [Type] a))
          args (box-al [Expr] a (ArrayList::new [Expr] a))
          recv (box-expr a (mk-expr (EVar "r") 19 20 0 0))
          e (primitive/alloc-stack Expr)]
      (set! e
            (mk-expr (EDynDispatch (box! a
                                         DynCall
                                         (DynCall
                                           :dyn_struct "Dyn"
                                           :vtable_struct "VT"
                                           :method_index 2
                                           :cc (c-convention)
                                           :params params
                                           :ret (TVoid)
                                           :recv recv
                                           :args args)))
                     17
                     18
                     0
                     0))
      (d-expr w e))
    (wb w 10)
    ; ---- ty-str byte-exact checks ----
    (let [(mut t) (TInt 64 true)] (ps w (ty-str a (mut t))))
    (wb w 10)  ; i64
    (let [(mut t) (TInt 8 false)] (ps w (ty-str a (mut t))))
    (wb w 10)  ; u8
    (let [(mut t) (TPtr (box-type a (TInt 8 false)))] (ps w (ty-str a (mut t))))
    (wb w 10)  ; (ptr u8)
    (let [(mut t) (TRef true (box-type a (TStruct "Foo")))]
      (ps w (ty-str a (mut t))))
    (wb w 10)  ; (mut Foo)
    (let [(mut ps2) (ArrayList::new [Type] a)]
      (push! (mut ps2) (TInt 64 true))
      (push! (mut ps2) (TInt 64 true))
      (let [(mut t) (TApp "Pair" (box-al [Type] a (load ps2)))]
        (ps w (ty-str a (mut t)))))
    (wb w 10)  ; (Pair i64 i64)
    (let [(mut ps3) (ArrayList::new [Type] a)]
      (push! (mut ps3) (TPtr (box-type a (TInt 8 true))))
      (let [(mut t)
              (TFn
                :cc (cc-c)
                :params (box-al [Type] a (load ps3))
                :ret (box-type a (TInt 64 true)))]
        (ps w (ty-str a (mut t)))))
    (wb w 10)  ; (fnptr (cc/C) [(ptr i8)] i64)
    0))

; ============================ codegen (the frontier) =========================
; (3496 lines): monomorphized Program -> LLVM module, built via the
; LLVM-C FFI surface above. FAITHFUL, call-for-call port of `compile_for_dbg` with
; dbg=None (every debug-info path skipped). The corpus has no shims / no struct-by-
; value C ABI, so ABI classification is deferred (a struct-by-value extern hard-errors).

; ---- Tv: a lowered (value, Coil type) pair
(defn generated-unit-count [] (-> i64)
  (let [c (load (generated-unit-collector-cell))]
    (if (= (primitive/cast i64 c) 0) 0 (len (.units c)))))

(defn apply-reader-artifact-flag! [(a (dyn Allocator))
                                   (argc i32)
                                   (argv (ptr (ptr i8)))] (-> i64)
  (let [(mut i) 2]
    (loop (if (>= (load i) (primitive/cast i64 argc)) (break) 0)
      (let [arg (from-cstr (load (index argv (load i))))]
        (when (= arg "--") (break))
        (when (= arg "--reader-artifact")
          (when (or (>= (+ (load i) 1) (primitive/cast i64 argc))
                    (> (len (.reader_artifact (driver-unit-state))) 0))
            (ps (stderr)
                "error: --reader-artifact expects exactly one artifact directory\n")
            (exit 1))
          (set! (.reader_artifact (driver-unit-state))
                (sconcat a
                         (from-cstr (load (index argv (+ (load i) 1))))
                         ""))
          0)
        (set! i (+ (load i) (if (flag-takes-value? arg) 2 1))))))
  0)

;; These are frontend semantics as well as object-emission options. Apply them
;; before command dispatch so check/inspection and build normalize identically.
(defn apply-common-compile-flags! [(argc i32) (argv (ptr (ptr i8)))] (-> i64)
  (let [(mut i) 2]
    (loop (if (>= (load i) (primitive/cast i64 argc)) (break) 0)
      (let [arg (from-cstr (load (index argv (load i))))]
        (when (= arg "--") (break))
        (cond (opt-flag? arg) (apply-opt-flag! arg)
              (meta-opt-flag? arg) (apply-meta-opt-flag! arg)
              (sanitizer-flag? arg) (apply-sanitizer-flag! arg)
              (jit-flag? arg) (apply-jit-flag! arg)
              (= arg "--debug-checks") (enable-debug-checks!)
              (= arg "--single-module") (set-single-module! true)
              :else 0)
        (set! i (+ (load i) (if (flag-takes-value? arg) 2 1))))))
  0)

; ============================ build-unit (prebuilt units) ===================
; `coil build-unit ENTRY.coil -o DIR`: compile ENTRY's module ahead of time.
; DIR receives `interface.coil` (see unit.coil: what a consumer reads in place
; of the module), `unit.o` (one object defining every concrete function of the
; module under its Coil symbol) and `unit.dylib`/`unit.so` (the same code as a
; shared library, so a metaprogram compiled in-process can call it). A consumer
; names the directory with `--unit DIR`.

(defn set-unit-build-obj! [(fp (fnptr (cc/C)
                                      [(ref (dyn Allocator))
                                       (ptr Program)
                                       (ptr i8)]
                                      i64))] (-> i64)
  (let [b (unit-build-box)] (set! (.fp b) fp) (set! (.isset b) 1) 0))

; ---- backend-matched units -------------------------------------------------
; Can this executable emit a unit object for BACKEND? LLVM needs the LLVM unit
; builder, which the LLVM-free compilers do not link; the native wasm backend
; emits whole modules, never a linkable object.
(defn unit-backend-buildable? [(backend i64)] (-> bool)
  (cond (= backend 1) (!= (.isset (unit-build-box)) 0)
        (native-backend? backend) true
        :else false))

; The backend this invocation compiles with: `--backend NAME`, read exactly as
; build-cmd reads it, else the executable's default (LLVM for the full compiler,
; arm64 or x64 for the LLVM-free ones).
(defn argv-backend [(argc i32) (argv (ptr (ptr i8))) (default-backend i64)]
  (-> i64)
  (let [(mut backend) default-backend
        (mut i) 2]
    (loop (if (>= (load i) (primitive/cast i64 argc)) (break) 0)
      (let [arg (from-cstr (load (index argv (load i))))]
        (when (= arg "--") (break))
        (when (and (= arg "--backend")
                   (< (+ (load i) 1) (primitive/cast i64 argc)))
          (set! backend
                (backend-arg "coil"
                             (from-cstr (load (index argv (+ (load i) 1))))
                             true))
          0)
        (set! i (+ (load i) 1))))
    (load backend)))

; The backend a unit's key says emitted its object ("llvm", "arm64", "x64"), or
; "" when there is no key or it predates keys recording a backend.
(defn unit-recorded-backend [(a (dyn Allocator)) (dir (slice u8))]
  (-> (slice u8))
  (unit-key-field a dir "backend "))

; The coil.jit implementation a unit's key says it was built for ("llvm" or
; "tpde"). A key from before the choice existed was built for llvm, the only one.
(defn unit-recorded-jit [(a (dyn Allocator)) (dir (slice u8))] (-> (slice u8))
  (let [found (unit-key-field a dir "jit ")]
    (if (= (len found) 0) "llvm" found)))

; The rest of the line of DIR's unit.key that starts with LABEL, or "".
(defn unit-key-field [(a (dyn Allocator)) (dir (slice u8)) (label (slice u8))]
  (-> (slice u8))
  (let [lines
          (split a
                 (read-file a (to-cstr a (path-join a dir "unit.key")))
                 "\n")
        n (len label)
        (mut found) ""]
    (for [i 0 (len (load lines))]
      (let [line (get (load lines) i)]
        (when (and (> (len line) n) (= (subslice line 0 n) label))
          (set! found (subslice line n (len line)))
          0))
      0)
    (load found)))

; `--unit DIR`, repeatable: read DIR/interface.coil in place of its module's
; source, link DIR/unit.o, and load DIR/unit.dylib into this process so a
; metaprogram compiled here can call what the unit defines. Registered on the
; command's loader state directly (the command scope was entered before argv
; was read) and on the driver state, from which every later compilation unit's
; configuration copies it.
(defn register-unit-dir! [(a (dyn Allocator))
                          (dir (slice u8))
                          (units (mut (ArrayList PrebuiltUnit)))
                          (strict bool)] (-> i64)
  (if (and (unit-backend-compatible? a dir strict)
           (unit-jit-compatible? a dir strict))
      (register-unit-files! a dir (mut units) strict)
      0))

; A unit links only into a build for the coil.jit implementation it was built
; for: a module may expand differently for each (`primitive/jit-implementation`),
; and the coil.jit unit itself links LLVM for one and not the other. Refused as
; unit-backend-compatible? refuses another backend's unit.
(defn unit-jit-compatible? [(a (dyn Allocator))
                            (dir (slice u8))
                            (strict bool)] (-> bool)
  (let [want (jit-implementation-name (jit-implementation))]
    (cond (!= (access (to-cstr a (path-join a dir "unit.key")) 0)
              (: 0 i32))
            true
          (= (unit-recorded-jit a dir) want) true
          (not strict) false
          :else
            (let [w (stderr)]
              (ps w "error: --unit ")
              (ps w dir)
              (ps w ": built for --jit=")
              (ps w (unit-recorded-jit a dir))
              (ps w ", but this build uses --jit=")
              (ps w want)
              (wb w 10)
              (ps w "  rebuild it: coil build-unit ENTRY.coil -o ")
              (ps w dir)
              (ps w " --jit=")
              (ps w want)
              (wb w 10)
              (exit 1)
              false))))

; A unit links only into a build by the backend that emitted it. An explicit
; `--unit` from another backend (or from a coil that did not record one) is a
; hard error naming both backends and the rebuild; a unit made available
; implicitly (COIL_UNITS) that does not match is skipped, so its module compiles
; from source. A directory that is not a unit at all is left to
; register-unit-files!, which reports that case itself.
(defn unit-backend-compatible? [(a (dyn Allocator))
                                (dir (slice u8))
                                (strict bool)] (-> bool)
  (let [want (unit-backend-name (.consumer_backend (driver-unit-state)))
        have (unit-recorded-backend a dir)]
    (cond (!= (access (to-cstr a (path-join a dir "unit.key")) 0)
              (: 0 i32))
            true
          (= have want) true
          (not strict) false
          :else
            (let [w (stderr)]
              (ps w "error: --unit ")
              (ps w dir)
              (if (= (len have) 0)
                  (ps w
                      ": the unit does not record the backend that built it (an older coil wrote it)\n")
                  (do
                    (ps w ": built with the ")
                    (ps w have)
                    (ps w " backend, but this build uses ")
                    (ps w want)
                    (wb w 10)
                    0))
              (ps w
                  "  a unit's object follows its backend's calling convention, so it only links into a build by that backend\n")
              (ps w "  rebuild it: coil build-unit ENTRY.coil -o ")
              (ps w dir)
              (ps w " --backend ")
              (ps w want)
              (wb w 10)
              (exit 1)
              false))))

(defn register-unit-files! [(a (dyn Allocator))
                            (dir (slice u8))
                            (units (mut (ArrayList PrebuiltUnit)))
                            (strict bool)] (-> i64)
  (let [iface-path (path-join a dir "interface.coil")
        obj (path-join a dir "unit.o")
        dylib (path-join a dir (sconcat a "unit" (me-dylib-ext)))]
    (if (or (!= (access (to-cstr a iface-path) 0) (: 0 i32))
            (!= (access (to-cstr a obj) 0) (: 0 i32)))
        (if strict
            (do
              (ps (stderr) "error: --unit ")
              (ps (stderr) dir)
              (ps (stderr)
                  ": not a prebuilt unit (expected interface.coil and unit.o, as `coil build-unit` writes)\n")
              (exit 1)
              1)
            0)  ; a manifest-cached unit that is not there yet: fall back to source
        (let [text (read-src a (to-cstr a iface-path))]
          (match (read-all a text 0)
            (Err [d]
                 (let [(mut dp) d]
                   (ps (stderr) "error: --unit ")
                   (ps (stderr) dir)
                   (ps (stderr) ": interface.coil does not read:\n")
                   (dump-error (stderr) (mut dp))
                   (exit 1)
                   1))
            (Ok [forms]
                (match (declared-module forms)
                  (None []
                        (do
                          (ps (stderr) "error: --unit ")
                          (ps (stderr) dir)
                          (ps (stderr) ": interface.coil declares no module\n")
                          (exit 1)
                          1))
                  (Some [ns]
                        (do
                          ; RTLD_NOW | RTLD_GLOBAL: the symbols must be visible to
                          ; every image loaded after, including a metaprogram dylib
                          ; linked with undefined references to them.
                          (when (= (access (to-cstr a dylib) 0)
                                   (: 0 i32))
                            (when (= (primitive/cast i64
                                                     (dlopen (to-cstr a dylib)
                                                             (if (me-host-linux?)
                                                                 258
                                                                 10)))
                                     0)
                              (ps (stderr) "error: --unit ")
                              (ps (stderr) dir)
                              (ps (stderr) ": could not load ")
                              (ps (stderr) dylib)
                              (ps (stderr) " into the compiler\n")
                              ; The undefined symbol the loader tripped over is
                              ; ONLY in dlerror(); without it this reads as "the
                              ; file is bad" when the real fault is the host not
                              ; exporting what the unit left undefined.
                              (let [why (dlerror)]
                                (unless (= (primitive/cast i64 why)
                                           0)
                                  (ps (stderr) "  ")
                                  (ps (stderr) (from-cstr why))
                                  (wb (stderr) 10)
                                  0))
                              (exit 1))
                            0)
                          (push! (mut units)
                                 (PrebuiltUnit :module
                                               ns
                                               :dir
                                               dir
                                               :object
                                               obj
                                               :dylib
                                               dylib
                                               ; An explicit `--unit` links unconditionally; a
                                               ; unit made available (COIL_UNITS, the shipped
                                               ; coil.jit) links only when its module is imported.
                                               :used
                                               strict
                                               :pending
                                               false
                                               :backend
                                               (.consumer_backend (driver-unit-state))
                                               :source
                                               (Resolved
                                                 :text text
                                                 :incdir dir
                                                 :disp
                                                   (sconcat3 a "<unit:" ns ">"))))
                          1)))))))))

; ---- the shipped coil.jit units ---------------------------------------------
; The toolchain provides one coil.jit unit PER BACKEND AND PER IMPLEMENTATION
; (`--jit=`) beside its library,
; `<prefix>/lib/coil/units/<backend>/jit-<implementation>/coil.compiler.jit_api`,
; each emitted by its own backend. `dev.py install` warms the default backend's
; llvm unit; any other is built the first time a program built that way imports
; coil.jit, and is linked from then on. Only in an installed layout -- in a checkout the compiler
; sources are what is being edited, and a stale unit must never shadow them
; (unit-fresh-for? re-hashes every recorded source, so an edited installed
; source makes the unit stale too).
(defn shipped-unit-dir [(a (dyn Allocator)) (ns (slice u8)) (backend i64)]
  (-> (slice u8))
  (let [layout (stdlib-layout a)]
    (if (not (stdlib-installed? layout))
        ""
        (shipped-unit-path a
                           (path-join a (dirname (.libs layout)) "units")
                           ns
                           backend))))

; ROOT/<backend>/jit-<implementation>/NS: one unit per backend and per coil.jit
; implementation, so building for one never replaces the other's.
(defn shipped-unit-path [(a (dyn Allocator))
                         (root (slice u8))
                         (ns (slice u8))
                         (backend i64)] (-> (slice u8))
  (path-join a
             (path-join a
                        (path-join a root (unit-backend-name backend))
                        (sconcat a
                                 "jit-"
                                 (jit-implementation-name (jit-implementation))))
             ns))

; Where an on-demand shipped unit goes when the installed library is not
; writable (a system-wide install): `$XDG_CACHE_HOME/coil`, else `~/.cache/coil`,
; again by backend. "" when neither variable is set.
(defn user-unit-dir [(a (dyn Allocator)) (ns (slice u8)) (backend i64)]
  (-> (slice u8))
  (let [xdg (unit-getenv c"XDG_CACHE_HOME")
        home (unit-getenv c"HOME")
        root
          (cond (!= (primitive/cast i64 xdg) 0)
                  (path-join a (from-cstr xdg) "coil")
                (!= (primitive/cast i64 home) 0)
                  (path-join a (from-cstr home) ".cache/coil")
                :else "")]
    (if (= (len root) 0)
        ""
        (shipped-unit-path a (path-join a root "units") ns backend))))

; An on-demand unit is written beside the library when the install is writable
; (the usual per-user install), and into the user cache otherwise.
(defn shipped-unit-build-dir [(a (dyn Allocator))
                              (lib-dir (slice u8))
                              (user-dir (slice u8))] (-> (slice u8))
  (let [libroot (dirname (dirname (dirname (dirname lib-dir))))]  ; <prefix>/lib/coil
    (if (or (= (access (to-cstr a libroot) 2) (: 0 i32))
            (= (len user-dir) 0))
        lib-dir
        user-dir)))

; Every consumer optimization level shares one shipped unit, built at -O3. (The
; SDK must never be built at -O0, where LLVM rejects its guaranteed tail calls.)
(const SHIPPED-UNIT-OPT 3)

; Commands whose output the shipped unit's object is linked into. Only these
; build a missing unit, and only once a program actually imports coil.jit; every
; other command uses a unit that is already built and otherwise reads the SDK's
; source, exactly as a toolchain without units would.
(defn unit-links-program? [(sub (slice u8))] (-> bool)
  (cond (= sub "build") true
        (= sub "run") true
        (= sub "test") true
        (= sub "fuzz") true
        (= sub "verify") true
        (= sub "emit-obj") true
        :else false))

; Whether this build's own namespace roots contain the toolchain's SDK sources.
; Such a program IS the toolchain -- a compiler candidate built against a staged
; layout whose library is the checkout being edited -- so it compiles those
; sources; a unit made from them must never stand in for them.
(defn unit-sdk-in-roots? [(a (dyn Allocator))] (-> bool)
  (let [layout (stdlib-layout a)
        env (unit-getenv c"COIL_NAMESPACE_ROOTS")]
    (if (= (primitive/cast i64 env) 0)
        false
        (match (m-realpath a (.sdk layout))
          (None [] false)
          (Some [sdk]
                (let [dirs (split a (from-cstr env) ":")
                      (mut found) false]
                  (for [i 0 (len (load dirs))]
                    (match (m-realpath a (get (load dirs) i))
                      (Some [p] (when (= p sdk) (set! found true) 0))
                      (None [] 0))
                    0)
                  (load found)))))))

; Make the shipped coil.jit unit for this build's backend available, as a PENDING
; entry that the loader realizes on the first import of the SDK (see
; realize-shipped-unit!): the built unit if it is fresh, otherwise -- for a command
; that links programs -- one built then. Nothing is decided here: a fresh unit is
; one whose recorded sources (the whole compiler, about 10 MB) and this compiler's
; binary still hash the same, and its dylib is loaded into the process, so deciding
; at startup made every command -- `--version`, `fmt`, a build that never imports
; coil.jit -- pay for both. `build-unit` compiles modules into units and never
; links one; a cross-target build would need the SDK for that target, which the
; toolchain does not provide; a build of the toolchain itself compiles the SDK
; it is editing (unit-sdk-in-roots?): all of them keep reading the SDK's source.
; The unit stands in for the SDK's own compiler/jit_api.coil, which a build reads
; only through the bundled library mapping. With that off (COIL_STDLIB=0) the
; compiler's modules come from the namespace roots, and the unit would replace one
; of them with the installed toolchain's version.
(defn register-shipped-units! [(a (dyn Allocator))
                               (units (mut (ArrayList PrebuiltUnit)))
                               (sub (slice u8))
                               (targeted bool)] (-> i64)
  (let [backend (.consumer_backend (driver-unit-state))
        ns "coil.compiler.jit_api"
        (mut named) false]
    (for [i 0 (len (load units))]
      (when (= (.module (get (load units) i)) ns) (set! named true)))
    (when (and (not named)
               (and (bundled-stdlib-enabled? a)
                    (unit-backend-buildable? backend))
               (and (not targeted)
                    (and (not (= sub "build-unit"))
                         (not (unit-sdk-in-roots? a)))))
      (let [lib-dir (shipped-unit-dir a ns backend)]
        (when (> (len lib-dir) 0)
          (set! (.builds (shipped-unit-policy)) (unit-links-program? sub))
          (push! (mut units)
                 (PrebuiltUnit
                   :module ns
                   :dir lib-dir
                   :object ""
                   :dylib ""
                   :used false
                   :pending true
                   :backend backend
                   :source
                     (Resolved
                       :text ""
                       :incdir ""
                       :disp "")))
          0)
        0)
      0)
    0))

;;; Whether this command may build a missing shipped unit (unit-links-program? of
;;; its subcommand), set when the pending entry is registered and read when the
;;; loader realizes it.
(defstruct ShippedUnitPolicy [(builds bool)])

(defn shipped-unit-policy [] (-> (ptr ShippedUnitPolicy))
  (primitive/alloc-static ShippedUnitPolicy))

; The builder the loader calls on the first import of a pending shipped unit
; (loader.coil prebuilt-realize!): the fresh unit beside the library, else the
; fresh one in the user cache, else -- for a command that links programs -- one
; built now. On success the entry becomes an ordinary registered unit; otherwise
; it stays pending with its `dir` cleared, so a later import of the SDK does not
; hash the sources again, and the SDK compiles from source.
(defn realize-shipped-unit! [(entry (ptr PrebuiltUnit))] (-> i64)
  (let [a (malloc-allocator)
        ns (.module entry)
        lib-dir (.dir entry)
        backend (.backend entry)]
    (when (> (len lib-dir) 0)
      (set! (.dir entry) "")
      (let [user-dir (user-unit-dir a ns backend)
            dir
              (cond (unit-fresh-for? a lib-dir backend SHIPPED-UNIT-OPT) lib-dir
                    (unit-fresh-for? a user-dir backend SHIPPED-UNIT-OPT)
                      user-dir
                    (.builds (shipped-unit-policy))
                      (let [out (shipped-unit-build-dir a lib-dir user-dir)]
                        (if (build-shipped-unit! a ns out backend) out ""))
                    :else "")]
        ; unit-fresh-for? has matched the unit's backend against this build's.
        ; register-unit-dir! would check it again against the driver state the
        ; loader runs under here, which is the compilation's, not the command's,
        ; and refuses the unit.
        (when (> (len dir) 0)
          (let [(mut built) (ArrayList::new [PrebuiltUnit] a)]
            (register-unit-files! a dir (mut built) false)
            (when (> (len (load built)) 0)
              (set! entry (get (load built) 0))
              (set! (.backend entry) backend)
              0)
            0))
        0))
    0))

; Remove a unit directory: exactly the files build-unit writes, then the directory.
(defn unit-dir-remove! [(a (dyn Allocator)) (dir (slice u8))] (-> i64)
  (unlink (to-cstr a (path-join a dir "interface.coil")))
  (unlink (to-cstr a (path-join a dir "unit.cexports")))
  (unlink (to-cstr a (path-join a dir "unit.o")))
  (unlink (to-cstr a (path-join a dir "unit.dylib")))
  (unlink (to-cstr a (path-join a dir "unit.so")))
  (unlink (to-cstr a (path-join a dir "unit.key")))
  (unlink (to-cstr a (path-join a dir "unit.sources")))
  (rmdir (to-cstr a dir))
  0)

; The synthesized test runner marks each isolated test process. If a test runs
; another `coil`, that invocation must discover the manifest in its own cwd.
; Preserve ordinary user knobs such as COIL_CC and COIL_TRACE while removing
; only the project configuration published by the parent compiler.
(defn reset-inherited-test-project-env! [(a (dyn Allocator))] (-> i64)
  (let [marker (unit-getenv c"COIL_TEST_CHILD")]
    (if (= (primitive/cast i64 marker) 0)
        0
        (let [names (split a (shipped-unit-isolated-vars) " ")
              envp (os/spawn-envp)
              (mut deps) (ArrayList::new [(slice u8)] a)
              (mut kept) (ArrayList::new [(ptr i8)] a)
              (mut i) 0]
          ; Collect names before mutating libc's environment. Some libcs move
          ; their environment pointer array when unsetenv removes an entry.
          (unless (= (primitive/cast i64 envp) 0)
            (loop (let [entryp (load (index envp (load i)))]
                    (if (= (primitive/cast i64 entryp) 0)
                        (break)
                        (let [entry (from-cstr entryp)]
                          (match (find entry "=")
                            (None [] 0)
                            (Some [end]
                                  (let [name (subslice entry 0 end)]
                                    (let [(mut project?)
                                            (or (= name "COIL_TEST_CHILD")
                                                (starts-with name "COIL_DEP_"))]
                                      (when (starts-with name "COIL_DEP_")
                                        (push! (mut deps) (sconcat a name ""))
                                        0)
                                      (for [j 0 (len (load names))]
                                        (when (= name (get (load names) j))
                                          (set! project? true)
                                          0)
                                        0)
                                      (unless (load project?)
                                        (push! (mut kept) (to-cstr a entry))
                                        0)))))
                          (set! i (+ (load i) 1))))))
            0)
          (push! (mut kept) (primitive/cast (ptr i8) 0))
          (os/publish-envp! (.data (load kept)))
          (unsetenv c"COIL_TEST_CHILD")
          (for [j 0 (len (load names))]
            (unsetenv (to-cstr a (get (load names) j)))
            0)
          (for [j 0 (len (load deps))]
            (unsetenv (to-cstr a (get (load deps) j)))
            0)
          0))))

; Run `coil build-unit ENTRY -o OUT --backend B -O3 --quiet` as a child, from
; OUT's parent directory (which holds no manifest) and with every project
; variable removed from the environment for the duration of the spawn, so a
; consumer's manifest, readers, metaprograms or prebuilt dependencies can never
; shape the toolchain's unit. Returns the child's exit code.
(defn spawn-shipped-unit-build! [(a (dyn Allocator))
                                 (entry (slice u8))
                                 (out (slice u8))
                                 (backend i64)] (-> i64)
  (let [prior-cwd (sconcat a (cwd-slice a) "")
        names (split a (shipped-unit-isolated-vars) " ")
        (mut saved) (ArrayList::new [(slice u8)] a)]
    (for [i 0 (len (load names))]
      (let [nm (to-cstr a (get (load names) i))]
        (push! (mut saved) (unit-env-copy a nm))
        (unsetenv nm)
        0)
      0)
    (let [rc
            (try (let [_ (try-or! (os/change-dir a (dirname out)) 1)]
                   (let [(mut args) (ArrayList::new [(slice u8)] a)]
                     (push! (mut args) (self-command-path a))
                     (push! (mut args) "build-unit")
                     (push! (mut args) entry)
                     (push! (mut args) "-o")
                     (push! (mut args) out)
                     (push! (mut args) "--backend")
                     (push! (mut args) (unit-backend-name backend))
                     (push! (mut args)
                            (sconcat a "-O" (i64->str a SHIPPED-UNIT-OPT)))
                     (push! (mut args)
                            (sconcat a
                                     "--jit="
                                     (jit-implementation-name (jit-implementation))))
                     (push! (mut args) "--quiet")
                     (wait-code (spawn-wait a (load args))))))]
      (match (os/change-dir a prior-cwd) (_ 0))
      (for [i 0 (len (load names))]
        (unit-env-restore! a
                           (to-cstr a (get (load names) i))
                           (get (load saved) i))
        0)
      rc)))

; Compile the toolchain's SDK module NS into DIR as a unit for BACKEND. The first
; use is slow -- the SDK is the compiler -- and every later build links the
; result. The child writes a private directory that is then renamed into place,
; so no build ever reads half a unit. Two first uses racing (parallel `coil test`
; jobs) each build; a finished fresh unit is never replaced, so the loser's copy
; is simply discarded.
(defn build-shipped-unit! [(a (dyn Allocator))
                           (ns (slice u8))
                           (dir (slice u8))
                           (backend i64)] (-> bool)
  (let [layout (stdlib-layout a)
        prefix "coil.compiler."
        w (stderr)]
    (if (not (and (> (len ns) (len prefix))
                  (= (subslice ns 0 (len prefix)) prefix)))
        (do
          (ps w "error: no shipped source for unit ")
          (ps w ns)
          (wb w 10)
          false)
        (let [entry
                (path-join a
                           (.sdk layout)
                           (sconcat a
                                    (subslice ns (len prefix) (len ns))
                                    ".coil"))
              tmp (temp-sibling-or-exit dir)]
          (unit-mkdirs! a (dirname dir))
          (ps w "note: building coil.jit for the ")
          (ps w (unit-backend-name backend))
          (ps w " backend (first use; later builds reuse it)\n")
          (let [rc (spawn-shipped-unit-build! a entry tmp backend)]
            (if (or (!= rc 0)
                    (not (unit-fresh-for? a tmp backend SHIPPED-UNIT-OPT)))
                (do
                  (temp/remove! tmp)
                  (ps w
                      "note: could not build the coil.jit unit; compiling coil.jit from source\n")
                  false)
                (do
                  (unless (unit-fresh-for? a dir backend SHIPPED-UNIT-OPT)
                    ; replace a stale unit (an older compiler or edited sources)
                    (unit-dir-remove! a dir)
                    (rename (to-cstr a tmp) (to-cstr a dir))
                    0)
                  ; still here when another build installed its unit first
                  (temp/remove! tmp)
                  (unit-fresh-for? a dir backend SHIPPED-UNIT-OPT))))))))

; `--unit DIR`, repeatable, plus every directory in COIL_UNITS (colon-separated,
; set by the manifest's prebuilt dependencies): read DIR/interface.coil in place
; of its module's source, link DIR/unit.o, and load DIR/unit.dylib so a
; metaprogram compiled here can call what the unit defines. A `--unit` dir that
; is not a unit, or that another backend built, is a hard error; a COIL_UNITS dir
; that is missing or mismatched falls back to source. Also registers the shipped
; coil.jit unit and the loader's builder for a pending one.
(defn apply-unit-flags! [(a (dyn Allocator))
                         (argc i32)
                         (argv (ptr (ptr i8)))
                         (sub (slice u8))] (-> i64)
  (set-lazy-unit-builder! (fnptr-of realize-shipped-unit!))
  (set-package-registry-builder! (fnptr-of build-package-registry))
  (let [(mut units) (ArrayList::new [PrebuiltUnit] a)
        env (unit-getenv c"COIL_UNITS")]
    (unless (= (primitive/cast i64 env) 0)
      (let [dirs (split a (from-cstr env) ":")]
        (for [i 0 (len (load dirs))]
          (let [dir (get (load dirs) i)]
            (when (> (len dir) 0)
              (register-unit-dir! a dir (mut units) false)
              0))
          0)))
    (let [(mut i) 2]
      (loop (if (>= (load i) (primitive/cast i64 argc)) (break) 0)
        (let [arg (from-cstr (load (index argv (load i))))]
          (when (= arg "--") (break))
          (when (= arg "--unit")
            (when (>= (+ (load i) 1) (primitive/cast i64 argc))
              (ps (stderr)
                  "error: --unit expects a directory written by `coil build-unit`\n")
              (exit 1))
            (register-unit-dir! a
                                (from-cstr (load (index argv
                                                        (+ (load i)
                                                           1))))
                                (mut units)
                                true)
            0)
          (set! i (+ (load i) 1)))))
    ; Last, so a unit the command line or the manifest already names for the
    ; SDK module replaces the shipped one instead of being linked beside it.
    (register-shipped-units! a
                             (mut units)
                             sub
                             (argv-has-flag? argc argv "--target"))
    (when (> (len (load units)) 0)
      (let [boxed (box-al [PrebuiltUnit] a (load units))]
        (set! (.units (driver-unit-state)) boxed)
        (set! (.prebuilt (loader-unit-state)) boxed))
      0)
    0))

;; ---- the library state ----------------------------------------------------------
;; Every program loads the prelude and what it imports, and expanding that library
;; is most of what compiling a small program costs. The toolchain keeps the
;; compiler state of a program that loads only the library -- an Env, saved by its
;; Persist derive -- and a compile builds on it as a `coil.jit` submission builds on
;; its session: the library's sources, declarations, checked bodies and facts are
;; the state's, and only what the entry file adds is read, expanded and checked.
;; The metaprograms the library's macros were compiled into are process state and
;; are not kept; a compile builds again the few it calls.
;;
;; A state is used only when it is current: written by this toolchain for this
;; target (`env-load`), and every library file it holds reads the same as the file
;; beside this compiler now. Otherwise the compile starts from nothing, as one
;; always could. Nothing builds a state on demand or writes into the toolchain:
;; `coil build-library-state` does, run by install, the candidate build and the
;; rebootstraps.

; ---- the built-in lint profile, prebuilt ---------------------------------------
; Compiling coil.lint.default and everything it imports is most of what a small
; `coil lint` costs, and it is the same work every time: the profile is toolchain
; code, not the application's. It is kept as a checker profile (artifact_provider):
; the checkers compiled into one native image, rebuilt when this compiler or any
; source the profile was compiled from changes. A command that finds it fresh
; loads the image; one that does not builds it first, in a child that compiles
; the profile as if no project were involved, and compiles it in process only
; when no profile can be kept or built.

; Compile only the configured checker graph, then execute those actual Coil
; metaprograms over a separately loaded raw project graph. Application code never
; enters the metaprogram compiler and is never duplicated into 20+ expansion
; generations. This is the generic project-lint runtime—not a rule fast path.
(defn interp-src-program [(a (dyn Allocator))
                          (src (slice u8))
                          (cwd (slice u8))
                          (path (slice u8))] (-> i64)
  (let [w (stderr)
        _narrow (set! (narrow-int-backend-cell) "interpreter")
        (mut sp0) (ArrayList::new [(slice u8)] a)
        (mut st0) (ArrayList::new [(slice u8)] a)]
    (match (run-pipeline a src cwd w path (mut sp0) (mut st0))
      (Some [mp] (interp-program a mp))
      (None [] 1))))

; ---- debug dumps on the big stack -------------------------------------------
; `coil expand` / the `dump-*` debug commands run the SAME recursive front-end
; (reader/parser/loader/resolve/check/mono/expand) as `build`, so they overflow the
; default ~8 MiB MAIN thread on deeply-nested (macro-generated) input that `build`
; compiles fine on the big stack. Route them through the identical run-on-big-stack /
; DumpCtx mechanism. The dump functions differ in arity; each `-w` wrapper adapts one
; to the uniform (a src cwd path) -> i64 shape the thread invokes (mode 3). Every dump
; returns 0 and prints its own diagnostics, so this exit code is 0 on success.
(defn dump-read-w [(a (dyn Allocator))
                   (src (slice u8))
                   (cwd (slice u8))
                   (path (slice u8))] (-> i64)
  (dump-read-program a src))

(defn dump-ast-w [(a (dyn Allocator))
                  (src (slice u8))
                  (cwd (slice u8))
                  (path (slice u8))] (-> i64)
  (dump-ast-program a src))

; file-relative imports (tool-1): the base for the entry file's own relative
; imports is ITS directory (dirname path), not the process CWD.
(defn dump-load-w [(a (dyn Allocator))
                   (src (slice u8))
                   (cwd (slice u8))
                   (path (slice u8))] (-> i64)
  (dump-stage-program a src cwd path (DumpLoad)))

(defn expand-src-w [(a (dyn Allocator))
                    (src (slice u8))
                    (cwd (slice u8))
                    (path (slice u8))] (-> i64)
  (expand-src-program a src (dirname path) path))

(defn dump-expand-w [(a (dyn Allocator))
                     (src (slice u8))
                     (cwd (slice u8))
                     (path (slice u8))] (-> i64)
  (dump-stage-program a src cwd path (DumpExpand)))

(defn dump-hygiene-w [(a (dyn Allocator))
                      (src (slice u8))
                      (cwd (slice u8))
                      (path (slice u8))] (-> i64)
  (dump-stage-program a src cwd path (DumpHygiene)))

(defn dump-resolved-w [(a (dyn Allocator))
                       (src (slice u8))
                       (cwd (slice u8))
                       (path (slice u8))] (-> i64)
  (dump-stage-program a src cwd path (DumpResolved)))

(defn dump-checked-w [(a (dyn Allocator))
                      (src (slice u8))
                      (cwd (slice u8))
                      (path (slice u8))] (-> i64)
  (dump-stage-program a src cwd path (DumpChecked)))

(defn dump-mono-w [(a (dyn Allocator))
                   (src (slice u8))
                   (cwd (slice u8))
                   (path (slice u8))] (-> i64)
  (dump-stage-program a src cwd path (DumpMono)))

; ---- reading a source file the user named ------------------------------------
; ---- child exit status ------------------------------------------------------
; ---- argv scanning ----------------------------------------------------------
; Every subcommand used to read the filename as literally argv[2], so
; `coil build -o out in.coil` — the universal Unix order — missed the file entirely,
; fell through to project mode, and reported "no Coil.toml" while never mentioning the
; file the user had just passed. The parse loop's fallthrough silently skipped anything
; it did not recognise, so a typo'd `--taget` was indistinguishable from success.
; One table, one scanner: flags are position-independent and unknown ones are errors.

; ---- the debug-checks / sanitizer build mode (mem-2 · mem-6 · mem-7) ----
; ---- "you built a file of tests" --------------------------------------------
; The program's link flags, minus any that would poison the compiler when applied to
; the metaprogram dylib it dlopen's (mem-7). Frameworks/-l libraries are preserved.
; ---- duplicate link inputs -------------------------------------------------
;;; Reject a value-taking option that ends the command line. Every subcommand's
;;; own scanner read argv[i+1] unchecked, so `coil build x.coil -o` segfaulted
;;; instead of saying what was missing. Arguments after `--` belong to the program.
(defn require-option-values! [(argc i32) (argv (ptr (ptr i8)))] (-> void)
  (let [n (cast i64 argc)]
    (block :scan
      (for i (range 1 n)
        (let [arg (from-cstr (load (index argv i)))]
          (when (= arg "--") (return-from :scan 0))
          (when (and (flag-takes-value? arg) (>= (+ i 1) n))
            (ps (stderr) "error: option '")
            (ps (stderr) arg)
            (ps (stderr) "' requires a value\n")
            (exit 2))))
      0)))

;;; Move the first positional argument (the file or module to run) to argv[2],
;;; shifting the flags that preceded it right. `coil run --backend llvm x.coil`
;;; then reads exactly like `coil run x.coil --backend llvm` to every scanner that
;;; takes argv[2] as the target.
(defn argv-file-first! [(argc i32) (argv (ptr (ptr i8)))] (-> void)
  (let [idx (argv-file-idx argc argv 2)]
    (when (> idx 2)
      (let [file (load (index argv idx))]
        (for k (range 0 (- idx 2))
          (let [j (- idx k)]
            (set! (index argv j) (load (index argv (- j 1))))))
        (set! (index argv 2) file)))))

; Macro diagnostics are frontend-wide rather than build-only flags. Publish them
; once before dispatch so check, build, run, dumps, tests, and project re-entry all
; observe the same controls. Project child commands inherit the environment.
(defn apply-macro-debug-flags! [(a (dyn Allocator))
                                (argc i32)
                                (argv (ptr (ptr i8)))] (-> i64)
  (let [option-count (argv-option-count argc argv)
        (mut i) 2]
    (loop (if (>= (load i) (primitive/cast i64 option-count))
              (break)
              (let [arg (from-cstr (load (index argv (load i))))]
                (cond (= arg "--trace-macros")
                        (do
                          (setenv c"COIL_TRACE_MACROS" c"*" 1)
                          (set! i (primitive/iadd (load i) 1))
                          0)
                      (or (= arg "--trace-macro")
                          (= arg "--macro-expansion-limit"))
                        (if (>= (primitive/iadd (load i) 1)
                                (primitive/cast i64 option-count))
                            (let [w (stderr)]
                              (ps w "error: ")
                              (ps w arg)
                              (ps w " requires a value\n")
                              (exit 1)
                              0)
                            (let [value
                                    (from-cstr (load (index argv
                                                            (primitive/iadd (load i)
                                                                            1))))]
                              (if (= arg "--trace-macro")
                                  (setenv c"COIL_TRACE_MACROS"
                                          (to-cstr a value)
                                          1)
                                  (match (parse-int value)
                                    (Some [n]
                                          (if (> n 0)
                                              (setenv c"COIL_MACRO_EXPANSION_LIMIT"
                                                      (to-cstr a value)
                                                      1)
                                              (let [w (stderr)]
                                                (ps w
                                                    "error: --macro-expansion-limit requires a positive integer\n")
                                                (exit 1)
                                                0)))
                                    (None []
                                          (let [w (stderr)]
                                            (ps w
                                                "error: --macro-expansion-limit requires a positive integer\n")
                                            (exit 1)
                                            0))))
                              (set! i (primitive/iadd (load i) 2))
                              0))
                      :else (do (set! i (primitive/iadd (load i) 1)) 0))))))
  0)

; Register a `--test-roots-file <path>` from argv, for the subcommands that compile in
; this process. `check` is the one that needs it: a project check loads every selected
; test file as an extra root of ONE program (load-test-roots!) instead of running a
; front end per file, and without this the flag was parsed off the command line as a
; known value-taking flag and then dropped, so the roots never loaded and the check
; passed by examining nothing.
(defn argv-apply-test-roots! [(argc i32) (argv (ptr (ptr i8)))] (-> i64)
  (let [option-count (argv-option-count argc argv)
        (mut i) 2]
    (loop (if (>= (primitive/iadd (load i) 1) (primitive/cast i64 option-count))
              (break)
              (if (= (from-cstr (load (index argv (load i))))
                     "--test-roots-file")
                  (do
                    (set-test-roots-file! (from-cstr (load (index argv
                                                                  (primitive/iadd (load i)
                                                                                  1)))))
                    (set! i (primitive/iadd (load i) 2))
                    0)
                  (set! i (primitive/iadd (load i) 1))))))
  0)

; the `--target <triple>` value anywhere in argv, or null (host default).
;;; `--target wasm32` (or wasm64) names the same target as wasm32-unknown-unknown.
;;; Spell it so in argv, once, before anything reads it: every reader of the
;;; triple (layout, the wasm linker, target questions) then agrees, where a bare
;;; one built a module whose statics were laid out for a 64-bit pointer.
(defn normalize-wasm-target-argv! [(argc i32) (argv (ptr (ptr i8)))] (-> i64)
  (for [i 2 (- (primitive/cast i64 argc) 1)]
    (when (= (from-cstr (load (index argv i))) "--target")
      (let [t (from-cstr (load (index argv (+ i 1))))]
        (cond (= t "wasm32")
                (set! (index argv (+ i 1)) c"wasm32-unknown-unknown")
              (= t "wasm64")
                (set! (index argv (+ i 1)) c"wasm64-unknown-unknown")
              :else 0)
        0)))
  0)

; `--link-flag X` / `-lfoo` straight off argv, for the meta/comptime link.
;
; A comptime expression that reaches native code is linked into a dylib with the SAME
; flags the program links (metaengine::me-link-flags-str), which is the only way a
; metaprogram can call into a library the compiler process does not itself contain.
; `build-cmd` sets those flags as part of its own argument parsing — but `check`,
; `emit-ir` and the `dump-*` commands accept `--link-flag` and had no equivalent step,
; so the flag was silently ignored and exactly those commands failed on a program
; `build` compiles fine. Setting it centrally at dispatch fixes all of them at once;
; build-cmd's own call runs later and wins, keeping its sanitizer filtering.
(defn set-meta-link-flags-from-argv! [(a (dyn Allocator))
                                      (argc i32)
                                      (argv (ptr (ptr i8)))] (-> i64)
  (let [(mut flags) (ArrayList::new [(slice u8)] a)
        (mut i) 2]
    (loop (if (>= (load i) (primitive/cast i64 argc))
              (break)
              (let [arg (from-cstr (load (index argv (load i))))]
                (cond (= arg "--") (break)
                      (and (= arg "--runtime-link-flag")
                           (< (primitive/iadd (load i) 1)
                              (primitive/cast i64 argc)))
                        (do (set! i (primitive/iadd (load i) 2)) 0)
                      (and (= arg "--link-flag")
                           (< (primitive/iadd (load i) 1)
                              (primitive/cast i64 argc)))
                        (do
                          (push! (mut flags)
                                 (from-cstr (load (index argv
                                                         (primitive/iadd (load i)
                                                                         1)))))
                          (set! i (primitive/iadd (load i) 2))
                          0)
                      (and (starts-with arg "-l")
                           (> (len arg) 2))
                        (do
                          (push! (mut flags) arg)
                          (set! i (primitive/iadd (load i) 1))
                          0)
                      :else (do (set! i (primitive/iadd (load i) 1)) 0)))))
    (when (> (len (load flags)) 0)
      (set-meta-link-flags! (filter-meta-link-flags a (load flags)))
      0))
  0)

; ===================== dependency-package link inputs ========================
; ============================ cheader (export-c → C header) =================
; The inverse of cimport: emit a C header (prototypes + typedef structs) for a
; program's (export-c …) set. The header must compile as C and as C++, and
; describe exactly the layout the compiled definitions have.

; ============================ Coil.toml manifest ============================
;;; Apply the command line's `--jit=`, the last one before any `--`, if it has one.
(defn apply-argv-jit-flag! [(argc i32) (argv (ptr (ptr i8)))] (-> i64)
  (let [(mut i) 2]
    (while (< i (primitive/cast i64 argc))
      (let [arg (from-cstr (load (index argv i)))]
        (cond (= arg "--") (set! i (primitive/cast i64 argc))
              (jit-flag? arg) (do (apply-jit-flag! arg) (set! i (+ i 1)))
              :else (set! i (+ i 1)))))
    0))

;;; Does the command line, before any `--`, say `--jit=`?
(defn argv-jit-flag? [(argc i32) (argv (ptr (ptr i8)))] (-> bool)
  (let [(mut i) 2
        (mut found) false]
    (while (< i (primitive/cast i64 argc))
      (let [arg (from-cstr (load (index argv i)))]
        (cond (= arg "--") (set! i (primitive/cast i64 argc))
              (jit-flag? arg) (do (set! found true) (set! i (+ i 1)))
              :else (set! i (+ i 1)))))
    (load found)))

; ============================ workspace members ============================
; Apply ./Coil.toml to THIS process when a file was named directly inside a project.
;
; `coil build src/main.coil` used to be a bare compile of one file: no dependency
; roots, no [link], no [cc], no [metaprograms]. That made an ordinary
; `(import "somedep.lib")` fail with "namespace not found" in a project where
; `coil build` resolved it fine — the manifest was reachable only through the
; project subcommands, which pass their configuration to a `<self> build <entry> …`
; child. Naming the file yourself is not a request for a different compile.
;
; A SET COIL_NAMESPACE_ROOTS is the signal that a parent project command already
; configured us (m-emit-dep-env puts it in the child's env). In that case this is a
; no-op and the parent's flags stand — which is what keeps configuration from being
; applied twice, and duplicate [cc] sources from becoming duplicate-symbol errors.
; The entry file of a dependency package: its Coil.toml `entry`, resolved against
; the package root. "" when the package has no manifest or names no entry.
(defn dep-entry-path [(a (dyn Allocator)) (root (slice u8))] (-> (slice u8))
  (let [toml (path-join a root "Coil.toml")]
    (if (!= (access (to-cstr a toml) 0) (: 0 i32))
        ""
        (let [dm (parse-manifest a (read-file a (to-cstr a toml)))]
          (if (= (len (.entry dm)) 0) "" (path-join a root (.entry dm)))))))

(defn build-dependency-unit [(a (dyn Allocator))
                             (root (slice u8))
                             (entry (slice u8))
                             (dir (slice u8))] (-> i64)
  (block
    :build
      (let [prior-cwd (sconcat a (cwd-slice a) "")
            prior-roots (unit-env-copy a c"COIL_NAMESPACE_ROOTS")
            prior-excludes (unit-env-copy a c"COIL_NAMESPACE_EXCLUDES")
            prior-readers (unit-env-copy a c"COIL_READERS")
            prior-map (unit-env-copy a c"COIL_MODULE_MAP")
            prior-providers (unit-env-copy a c"COIL_MANIFEST_PROVIDERS")
            prior-manifest (unit-env-copy a c"COIL_MANIFEST_PATH")
            prior-package (unit-env-copy a c"COIL_PACKAGE_NAME")
            prior-links (load (meta-link-box))
            prior-uses (load (field (driver-unit-state) uses))
            (mut rc) 1]
        (match (os/change-dir a root)
          (Err [_] (return-from :build 1))
          (Ok [_]
              (let [dm (parse-manifest a (read-file a c"Coil.toml"))]
                (m-prepare-deps a dm)
                (setenv c"COIL_NAMESPACE_ROOTS"
                        (to-cstr a (m-namespace-roots a dm))
                        1)
                (setenv c"COIL_NAMESPACE_EXCLUDES"
                        (to-cstr a (m-excludes-env a dm))
                        1)
                (setenv c"COIL_READERS"
                        (to-cstr a
                                 (m-mappings-env a
                                                 (load (field dm readers))))
                        1)
                (setenv c"COIL_MODULE_MAP"
                        (to-cstr a
                                 (m-mappings-env a
                                                 (load (field dm modules))))
                        1)
                (setenv c"COIL_MANIFEST_PROVIDERS"
                        (to-cstr a
                                 (m-mappings-env a
                                                 (load (field dm
                                                              manifest-providers))))
                        1)
                (setenv c"COIL_MANIFEST_PATH" c"Coil.toml" 1)
                (setenv c"COIL_PACKAGE_NAME" (to-cstr a (.name dm)) 1)
                (m-add-manifest-uses dm)
                (set-meta-link-flags! (m-unit-link-flags a dm))
                (let [state (driver-unit-state)]
                  (set! (.unit_out state) dir)
                  ; Built by the consuming build's own backend: a unit only ever
                  ; links into a build by the backend that emitted it.
                  (set! (.unit_backend state) (.consumer_backend state)))
                (set! rc
                      (run-dump-on-big-stack a
                                             (read-src a
                                                       (to-cstr a entry))
                                             (dirname entry)
                                             entry
                                             (fnptr-of build-unit-render)))
                (set! (.unit_out (driver-unit-state)) ""))))
        (match (os/change-dir a prior-cwd) (_ 0))
        (unit-env-restore! a c"COIL_NAMESPACE_ROOTS" prior-roots)
        (unit-env-restore! a c"COIL_NAMESPACE_EXCLUDES" prior-excludes)
        (unit-env-restore! a c"COIL_READERS" prior-readers)
        (unit-env-restore! a c"COIL_MODULE_MAP" prior-map)
        (unit-env-restore! a c"COIL_MANIFEST_PROVIDERS" prior-providers)
        (unit-env-restore! a c"COIL_MANIFEST_PATH" prior-manifest)
        (unit-env-restore! a c"COIL_PACKAGE_NAME" prior-package)
        (set! (meta-link-box) prior-links)
        (set! (.uses (driver-unit-state)) prior-uses)
        (load rc))))

; Build a unit for every `prebuilt = true` dependency into `.coil/units/<name>`,
; skipping one already fresh, and publish the directories in COIL_UNITS so the
; consumer (this process or its child) reads each interface in place of the
; dependency's source and links its object. A dependency that cannot be prebuilt
; -- no entry, or an export a unit cannot express -- is left to compile from
; source with a note, never a hard failure.
(defn ensure-prebuilt-units! [(a (dyn Allocator)) (m (ptr Manifest))] (-> i64)
  (let [deps (load (field m deps))
        (mut dirs) ""
        (mut any) false]
    (for [i 0 (len (load deps))]
      (let [d (elem deps i)]
        (when (.prebuilt d)
          (set! any true)
          (let [root (.resolved d)]
            (if (= (len root) 0)
                (do
                  (ps (stderr) "note: prebuilt dependency '")
                  (ps (stderr) (.name d))
                  (ps (stderr) "' is not resolved; compiling it from source\n")
                  0)
                (let [entry (dep-entry-path a root)]
                  (if (= (len entry) 0)
                      (do
                        (ps (stderr) "note: prebuilt dependency '")
                        (ps (stderr) (.name d))
                        (ps (stderr)
                            "' has no Coil.toml entry; compiling it from source\n")
                        0)
                      (let [backend (.consumer_backend (driver-unit-state))
                            bdir
                              (path-join a
                                         ".coil/units"
                                         (unit-backend-name backend))
                            dir (path-join a bdir (.name d))]
                        (fs/make-dir (to-cstr a ".coil") 493)
                        (fs/make-dir (to-cstr a ".coil/units")
                                     493)
                        (fs/make-dir (to-cstr a bdir) 493)
                        (fs/make-dir (to-cstr a dir) 493)
                        (let [dirabs
                                (match (m-realpath a dir)
                                  (Some [p] p)
                                  (None [] dir))
                              (mut ok) (unit-backend-buildable? backend)]
                          (unless (load ok)
                            (ps (stderr) "note: prebuilt dependency '")
                            (ps (stderr) (.name d))
                            (ps (stderr) "' cannot be prebuilt for the ")
                            (ps (stderr) (unit-backend-name backend))
                            (ps (stderr) " backend; compiling it from source\n")
                            0)
                          (unless (or (not (load ok))
                                      (unit-fresh-for? a
                                                       dir
                                                       backend
                                                       (opt-level)))
                            (let [rc (build-dependency-unit a root entry dirabs)]
                              (unless (= rc 0)
                                (set! ok false)
                                (ps (stderr) "note: prebuilt dependency '")
                                (ps (stderr) (.name d))
                                (ps (stderr)
                                    "' could not be prebuilt; compiling it from source\n")
                                0)))
                          (when (load ok)
                            (set! dirs
                                  (if (= (len (load dirs)) 0)
                                      dirabs
                                      (sconcat3 a (load dirs) ":" dirabs)))
                            0))
                        0)))))
          0))
      0)
    (when (and (load any) (> (len (load dirs)) 0))
      (setenv (to-cstr a "COIL_UNITS") (to-cstr a (load dirs)) 1)
      0)
    0))

;;; Each SEP-separated entry of TEXT that is a relative path, made absolute under ROOT.
(defn m-absolute-entries [(a (dyn Allocator))
                          (root (slice u8))
                          (text (slice u8))
                          (sep u8)] (-> (slice u8))
  (let [(mut out) (StrBuf::new a)
        n (len text)
        (mut lo) 0]
    (for i (range 0 (+ n 1))
      (when (or (= i n) (= (get text i) sep))
        (let [entry (subslice text lo i)]
          (when (> lo 0) (push! (mut out) sep))
          (if (or (= (len entry) 0) (= (get entry 0) #\/))
              (push-str! (mut out) entry)
              (push-str! (mut out) (sconcat3 a root "/" entry))))
        (set! lo (+ i 1))))
    (str out)))

;;; Publish the environment the workspace root's fan-out gives a member child, so a
;;; command run from inside the member's own directory resolves the other members
;;; and its own `<workspace>.<package>` namespace instead of compiling it as a
;;; standalone package.
(defn apply-enclosing-workspace! [(a (dyn Allocator)) (root (slice u8))]
  (-> void)
  (let [here (cwd-slice a)]
    (when (= (chdir (to-cstr a root)) 0)
      (let [m (parse-manifest a (read-file a (to-cstr a "Coil.toml")))]
        (m-prepare-deps a m)
        (let [roots (m-absolute-entries a root (m-namespace-roots a m) #\:)
              excludes
                (m-absolute-entries a
                                    root
                                    (m-workspace-excludes-env a m)
                                    #\newline)
              packages (m-workspace-packages a m)]
          (chdir (to-cstr a here))
          (setenv (to-cstr a "COIL_NAMESPACE_ROOTS") (to-cstr a roots) 1)
          (setenv (to-cstr a "COIL_NAMESPACE_EXCLUDES")
                  (to-cstr a excludes)
                  1)
          (setenv (to-cstr a "COIL_WORKSPACE_PACKAGES")
                  (to-cstr a packages)
                  1)
          (setenv (to-cstr a "COIL_STDLIB")
                  (if (.language-stdlib m) c"1" c"0")
                  1)
          (setenv (to-cstr a "COIL_STDLIB_PROFILE")
                  (to-cstr a (.language-stdlib-profile m))
                  1)
          (setenv (to-cstr a "COIL_PRELUDE")
                  (to-cstr a (.language-prelude m))
                  1)
          (setenv (to-cstr a "COIL_CORE_PROVIDERS")
                  (to-cstr a
                           (m-name-list-env a
                                            (load (field m
                                                         language-core-providers))))
                  1))))))  ;;; The packages of a prepared project manifest (`manifest` is its absolute path):

;;; the project itself, its workspace members, and every dependency, each with
;;; its source roots, its own Coil.toml ("" for a bare directory of modules) and
;;; its entry. A reader is handed the manifest of the package owning its file.
(defn m-package-contexts [(a (dyn Allocator))
                          (m (ptr Manifest))
                          (manifest (slice u8))]
  (-> (ptr (ArrayList PackageContext)))
  (let [dir (dirname manifest)
        out (box-al [PackageContext] a (ArrayList::new [PackageContext] a))
        own-roots (box-al [(slice u8)] a (ArrayList::new [(slice u8)] a))
        roots (m-effective-roots a m dir)]
    (for [i 0 (len (load roots))]
      (match (m-realpath a (path-join a dir (get (load roots) i)))
        (Some [p] (push! own-roots p))
        (None [] 0))
      0)
    ; A package that declares no existing root keeps its modules beside its manifest.
    (when (= (len (load own-roots)) 0) (push! own-roots dir) 0)
    (push! out
           (PackageContext
             :roots own-roots
             :manifest (sconcat a manifest "")
             :entry (if (= (len (.entry m)) 0) "" (path-join a dir (.entry m)))
             :dependency false
             :excludes
               (box-al [(slice u8)]
                       a
                       (config-lines a (m-excludes-env-at a m dir)))))
    (when (m-workspace? m)
      (let [members (split a (m-member-dirs a m) "\n")]
        (for [i 0 (len (load members))]
          (let [member (get (load members) i)]
            (when (and (> (len member) 0) (dir? (to-cstr a member)))
              (match (m-realpath a member)
                (Some [p]
                      (let [mr
                              (box-al [(slice u8)]
                                      a
                                      (ArrayList::new [(slice u8)] a))]
                        (push! mr p)
                        (let [mm
                                (parse-manifest a
                                                (read-file a
                                                           (to-cstr a
                                                                    (path-join a
                                                                               p
                                                                               "Coil.toml"))))]
                          (push! out
                                 (PackageContext
                                   :roots mr
                                   :manifest (path-join a p "Coil.toml")
                                   :entry (dep-entry-path a p)
                                   :dependency false
                                   :excludes
                                     (box-al [(slice u8)]
                                             a
                                             (config-lines a
                                                           (m-excludes-env-at a
                                                                              mm
                                                                              p))))))))
                (None [] 0))
              0))
          0))
      0)
    (let [deps (load (field m deps))]
      (for [i 0 (len (load deps))]
        (let [d (elem deps i)
              root (.resolved d)]
          (when (> (len root) 0)
            (let [toml (path-join a root "Coil.toml")
                  has (= (access (to-cstr a toml) 0) (: 0 i32))]
              (push! out
                     (PackageContext
                       :roots
                         (let [copy
                                 (box-al [(slice u8)]
                                         a
                                         (ArrayList::new [(slice u8)] a))]
                           (for [j 0 (len (load (.roots d)))]
                             (push! copy
                                    (match (m-realpath a
                                                       (get (load (.roots d)) j))
                                      (Some [canonical] canonical)
                                      (None []
                                            (sconcat a
                                                     (get (load (.roots d)) j)
                                                     ""))))
                             0)
                           copy)
                       :manifest (if has toml "")
                       :entry (dep-entry-path a root)
                       :dependency true
                       :excludes (.excludes d))))
            0))
        0))
    out))

;;; The loader's package-registry builder, for a process that did not prepare the
;;; project itself (a child the driver spawned with the project's environment).
;;; Prepares the manifest from its own directory, as `coil` in that directory would.
(defn build-package-registry [(manifest (slice u8))]
  (-> (ptr (ArrayList PackageContext)))
  (let [a (malloc-allocator)
        prior (sconcat a (cwd-slice a) "")
        dir (dirname manifest)]
    (try (let [_
                 (try-or! (os/change-dir a dir)
                          (box-al [PackageContext]
                                  a
                                  (ArrayList::new [PackageContext] a)))]
           (let [m (parse-manifest a (read-file a (to-cstr a manifest)))]
             (m-prepare-deps a m)
             (let [pkgs (m-package-contexts a m manifest)]
               (match (os/change-dir a prior) (_ 0))
               pkgs))))))

(defn apply-project-manifest! [(a (dyn Allocator))
                               (argc i32)
                               (argv (ptr (ptr i8)))] (-> i64)
  (let [key (to-cstr a "COIL_NAMESPACE_ROOTS")]
    ; A member of an enclosing workspace compiles inside it, as the workspace root's
    ; fan-out runs it: the workspace's environment, then the member's own manifest
    ; within it (m-emit-dep-env does the same for a member child).
    (when (= (primitive/cast i64 (unit-getenv key)) 0)
      (let [member
              (match (enclosing-workspace-root a)
                (Some [root] (do (apply-enclosing-workspace! a root) true))
                (None [] false))
            text (read-file a (to-cstr a "Coil.toml"))]
        (when (> (len text) 0)
          (let [m (parse-manifest a text)
                _profile (m-select-profile! a argc argv m)
                deps (load (field m deps))
                (mut i) 0]
            ; Resolve dependencies BEFORE reading their roots — m-namespace-roots
            ; reads each dep's `resolved` path, which m-prepare-deps is what fills in.
            (m-prepare-deps a m)
            (match (m-realpath a "Coil.toml")
              (Some [manifest]
                    (package-registry-put! manifest
                                           (m-package-contexts (malloc-allocator)
                                                               m
                                                               manifest)))
              (None [] 0))
            (when (m-workspace? m)
              (setenv (to-cstr a "COIL_WORKSPACE_PACKAGES")
                      (to-cstr a (m-workspace-packages a m))
                      1)
              0)
            (setenv key
                    (to-cstr a
                             (if member
                                 (m-roots-with-deps a
                                                    (from-cstr (unit-getenv key))
                                                    m)
                                 (m-namespace-roots a m)))
                    1)
            (setenv (to-cstr a "COIL_NAMESPACE_EXCLUDES")
                    (to-cstr a (m-excludes-env a m))
                    1)
            (setenv (to-cstr a "COIL_READERS")
                    (to-cstr a (m-mappings-env a (load (field m readers))))
                    1)
            (setenv (to-cstr a "COIL_MODULE_MAP")
                    (to-cstr a (m-mappings-env a (load (field m modules))))
                    1)
            (setenv (to-cstr a "COIL_MANIFEST_PROVIDERS")
                    (to-cstr a
                             (m-mappings-env a
                                             (load (field m
                                                          manifest-providers))))
                    1)
            (setenv (to-cstr a "COIL_MANIFEST_PATH") c"Coil.toml" 1)
            (setenv (to-cstr a "COIL_PACKAGE_NAME") (to-cstr a (.name m)) 1)
            ; The workspace owns the compilation universe its members share.
            (unless member
              (setenv (to-cstr a "COIL_STDLIB")
                      (to-cstr a (if (.language-stdlib m) "1" "0"))
                      1)
              (setenv (to-cstr a "COIL_STDLIB_PROFILE")
                      (to-cstr a (.language-stdlib-profile m))
                      1)
              (setenv (to-cstr a "COIL_PRELUDE")
                      (to-cstr a (.language-prelude m))
                      1)
              (setenv (to-cstr a "COIL_CORE_PROVIDERS")
                      (to-cstr a
                               (m-name-list-env a
                                                (load (field m
                                                             language-core-providers))))
                      1)
              0)
            (reset-implicit-prelude-cache!)
            ; the manifest's choice, unless the command line made its own; before
            ; the prebuilt dependencies, whose units are built for one
            (when (and (> (len (.jit m)) 0) (not (argv-jit-flag? argc argv)))
              (apply-jit-flag! (m-jit-flag a m))
              0)
            (ensure-prebuilt-units! a m)
            ; Commands that compile IN THIS PROCESS (`check <file>`, the dump
            ; stages) get the declared metaprograms here; the ones that re-exec a
            ; child receive them as `--use` from m-emit-uses instead.
            (m-add-manifest-uses m)
            (when (.debug-checks m) (enable-debug-checks!) 0)
            (when (.single-module m) (set-single-module! true) 0)
            (loop (if (>= (load i) (len (load deps)))
                      (break)
                      (let [d (get (load deps) (load i))]
                        (setenv (to-cstr a
                                         (cat3-d a
                                                 "COIL_DEP_"
                                                 (.name d)))
                                (to-cstr a (.resolved d))
                                1)
                        (set! i (primitive/iadd (load i) 1)))))
            (set! (.m (project-manifest-cell)) m)
            0))
        0))
    0))

;;; `--profile NAME` names a [profile.NAME] of the project's Coil.toml, so outside a
;;; project it means nothing; say so rather than ignore it. A child of a project
;;; command (COIL_NAMESPACE_ROOTS set) received the profile's settings as flags.
(defn check-profile-flag! [(a (dyn Allocator)) (argc i32) (argv (ptr (ptr i8)))]
  (-> i64)
  (when (and (argv-has-flag? argc argv "--profile")
             (and (= (primitive/cast i64 (unit-getenv c"COIL_NAMESPACE_ROOTS"))
                     0)
                  (= (len (read-file a c"Coil.toml")) 0)))
    (ps (stderr)
        "error: --profile selects a [profile.NAME] from Coil.toml, and there is no Coil.toml here\n")
    (exit 2)
    0)
  0)

(defn namespace-using-command? [(sub (slice u8))] (-> bool)
  (cond (= sub "build") true
        (= sub "build-provider") true
        (= sub "build-unit") true
        (= sub "run") true
        (= sub "check") true
        (= sub "test") true
        (= sub "fuzz") true
        (= sub "verify") true
        (= sub "lint") true
        (= sub "emit-obj") true
        (= sub "emit-ir") true
        (= sub "dump-ir") true
        (= sub "dump-read") true
        (= sub "dump-ast") true
        (= sub "dump-load") true
        (= sub "dump-resolved") true
        (= sub "dump-checked") true
        (= sub "dump-expand") true
        (= sub "dump-hygiene") true
        (= sub "dump-mono") true
        (= sub "expand") true
        (= sub "interp") true
        :else false))

; Build the ordinary CLI argv for a manifest-backed build without serializing it
; through a shell and starting a second copy of the compiler.  The manifest is
; already parsed and applied by driver-main before dispatch; build-cmd is the same
; implementation the old child reached.  Keep native C/pkg-config projects on the
; existing command path for now because m-cc-sources-as is also the owner of their
; incremental object-build transaction, not merely an argv formatter.
(defn manifest-argv-push! [(a (dyn Allocator))
                           (args (ptr (ArrayList (ptr i8))))
                           (value (slice u8))] (-> i64)
  (push! [(ptr i8)] args (to-cstr a value))
  0)

(defn manifest-argv-link! [(a (dyn Allocator))
                           (args (ptr (ArrayList (ptr i8))))
                           (value (slice u8))] (-> i64)
  (manifest-argv-push! a args "--runtime-link-flag")
  (manifest-argv-push! a args value)
  0)

;;; Create the directory the package executable goes in, as an artifact's is.
(defn m-ensure-exe-dir! [(a (dyn Allocator)) (exe (slice u8))] (-> i64)
  (let [dir (dirname exe)]
    (native-only (unit-mkdirs! a dir) 0)
    (unless (dir? (to-cstr a dir))
      (ps (stderr) "error: could not create the directory `")
      (ps (stderr) dir)
      (ps (stderr) "` for the package executable\n")
      (exit 1)
      0))
  0)

; A manifest supplies its conventional output through a synthesized `-o`, so
; build-cmd correctly treats the path as exact and does not create its parents.
; The former subprocess path created these directories before invoking build;
; preserve that ownership in the in-process path rather than teaching arbitrary
; user-authored `-o some/missing/dir/file` to create directories implicitly.
; Whether `coil build` can run the manifest's build in this process instead of
; re-exec'ing a `<self> build` child. The child exists for the manifest features
; whose implementation lives in the command layer: workspace fan-out, secondary
; artifacts, and the root package's own C sources and native providers, which are
; prepared before the compile. A dependency package's C sources are compiled by
; that same command layer, so they keep the child path too; its native providers
; do not, because the build itself consults them once it knows what it loaded.
(defn manifest-build-in-process? [(m (ptr Manifest))] (-> bool)
  (and (not (m-workspace? m))
       (and (= (len (load (field m artifacts))) 0)
            (and (= (len (load (field m sources))) 0)
                 (and (= (len (load (field m native-deps))) 0)
                      (not (m-dep-packages-have-sources? m)))))))

(defn m-dep-packages-have-sources? [(m (ptr Manifest))] (-> bool)
  (let [pkgs (load (field m dep-packages))
        (mut any) false]
    (for [i 0 (len pkgs)]
      (when (> (len (load (.sources (.link (get (load pkgs) i))))) 0)
        (set! any true)
        0)
      0)
    (load any)))

;;; The manifest's compile configuration as CLI arguments, in the order a
;;; manifest-backed `build` gives them: link inputs, dependency packages, target,
;;; optimization and debug info. `build` and `run` read the same manifest, so they
;;; must not drift.
(defn manifest-config-argv! [(a (dyn Allocator))
                             (args (ptr (ArrayList (ptr i8))))
                             (m (ptr Manifest))] (-> i64)
  (let [fw (load (field m frameworks))]
    (for [i 0 (len fw)]
      (manifest-argv-link! a args "-framework")
      (manifest-argv-link! a args (get fw i))
      0))
  (let [lb (load (field m libs))]
    (for [i 0 (len lb)]
      (manifest-argv-link! a args (sconcat a "-l" (get lb i)))
      0))
  (let [fl (load (field m flags))]
    (for [i 0 (len fl)]
      (manifest-argv-link! a args (get fl i))
      0))
  (let [sp (load (field m search-paths))]
    (for [i 0 (len sp)]
      (manifest-argv-link! a args "-L")
      (manifest-argv-link! a args (get sp i))
      0))
  (let [ob (load (field m objects))]
    (for [i 0 (len ob)]
      (manifest-argv-link! a args (get ob i))
      0))
  ; Dependency packages travel as `--dep-*` arguments, exactly as they do on a
  ; child build's command line, and this build selects the ones its compilation
  ; loads.
  (let [dep-args (m-dep-package-args a m)]
    (for [i 0 (len (load dep-args))]
      (let [x (elem dep-args i)]
        (manifest-argv-push! a args (.flag x))
        (manifest-argv-push! a args (.value x)))
      0))
  (when (.has-target m)
    (manifest-argv-push! a args "--target")
    (manifest-argv-push! a args (.target m))
    0)
  (when (> (len (.optimization m)) 0)
    (manifest-argv-push! a
                         args
                         (sconcat a "-O" (.optimization m)))
    0)
  (when (.debug m) (manifest-argv-push! a args "-g") 0)
  0)

(defn manifest-build-argv [(a (dyn Allocator))
                           (argc i32)
                           (argv (ptr (ptr i8)))
                           (fidx i64)
                           (m (ptr Manifest))] (-> (ptr (ArrayList (ptr i8))))
  (let [args (box! a (ArrayList (ptr i8)) (ArrayList::new [(ptr i8)] a))
        explicit (!= fidx 0)
        entry
          (if explicit
              (from-cstr (load (index argv fidx)))
              (m-entry-file a m))]
    (push! [(ptr i8)] args (load (index argv 0)))
    (manifest-argv-push! a args "build")
    (manifest-argv-push! a args entry)
    ; Without `-o`, a build goes where the manifest says the package executable
    ; goes, or to a named file under its own name.
    (unless (argv-has-flag? argc argv "-o")
      (m-select-profile! a argc argv m)
      (let [exe (m-exe-path a m explicit entry)]
        (m-ensure-exe-dir! a exe)
        (manifest-argv-push! a args "-o")
        (manifest-argv-push! a args exe))
      0)
    (manifest-config-argv! a args m)
    ; User flags come last and therefore retain their documented precedence over
    ; manifest defaults.  The positional entry has already been inserted once, and
    ; the profile has already been applied.
    (let [(mut i) 2]
      (loop (if (>= (load i) (primitive/cast i64 argc))
                (break)
                (if (= (load i) fidx)
                    (set! i (primitive/iadd (load i) 1))
                    (if (= (from-cstr (load (index argv (load i))))
                           "--profile")
                        (set! i (primitive/iadd (load i) 2))
                        (do
                          (push! [(ptr i8)]
                                 args
                                 (load (index argv (load i))))
                          (set! i (primitive/iadd (load i) 1))))))))
    args))

;;; The argv of a manifest-backed `run`, for run-cmd in this process: the entry,
;;; the manifest's configuration, the user's own flags after it so they win, and
;;; the program's arguments after `--`, each one exactly as the user's shell
;;; passed it (or the manifest's `[run] args` when there is no `--`). run-cmd builds
;;; in a child that inherits the configuration apply-project-manifest! put in this
;;; process's environment; the transforms and checks it applied in-process are
;;; passed as flags.
(defn manifest-run-argv [(a (dyn Allocator))
                         (argc i32)
                         (argv (ptr (ptr i8)))
                         (fidx i64)
                         (m (ptr Manifest))] (-> (ptr (ArrayList (ptr i8))))
  (let [args (box! a (ArrayList (ptr i8)) (ArrayList::new [(ptr i8)] a))
        entry
          (if (!= fidx 0)
              (from-cstr (load (index argv fidx)))
              (m-entry-file a m))
        (mut i) 2
        (mut program) false]
    (m-select-profile! a argc argv m)
    (push! [(ptr i8)] args (load (index argv 0)))
    (manifest-argv-push! a args "run")
    (manifest-argv-push! a args entry)
    (manifest-config-argv! a args m)
    (let [ns (load (field m metaprograms))]
      (for [k 0 (len ns)]
        (manifest-argv-push! a args "--use")
        (manifest-argv-push! a args (get ns k))
        0))
    (let [rs (load (field m readers))]
      (for [k 0 (len rs)]
        (manifest-argv-push! a args "--use")
        (manifest-argv-push! a args (.value (elem rs k)))
        0))
    (when (.debug-checks m) (manifest-argv-push! a args "--debug-checks") 0)
    (when (.single-module m) (manifest-argv-push! a args "--single-module") 0)
    ; before the command line's own flags, so a `--jit=` there wins
    (when (> (len (.jit m)) 0) (manifest-argv-push! a args (m-jit-flag a m)) 0)
    (loop (if (>= (load i) (primitive/cast i64 argc))
              (break)
              (let [arg (from-cstr (load (index argv (load i))))]
                (cond (load program)
                        (do
                          (push! [(ptr i8)] args (load (index argv (load i))))
                          (set! i (+ (load i) 1)))
                      (= arg "--")
                        (do
                          (manifest-argv-push! a args "--")
                          (set! program true)
                          (set! i (+ (load i) 1)))
                      (= (load i) fidx) (set! i (+ (load i) 1))
                      (= arg "--profile") (set! i (+ (load i) 2))
                      :else
                        (do
                          (push! [(ptr i8)] args (load (index argv (load i))))
                          (set! i (+ (load i) 1)))))))
    (unless (load program)
      (manifest-argv-push! a args "--")
      (let [ra (load (field m rargs))]
        (for [k 0 (len ra)]
          (manifest-argv-push! a args (get ra k))
          0)))
    args))

; manifest mode = `build`/`run` with no file ANYWHERE in argv — not merely "argv[2]
; starts with a dash", which made `coil build -o out in.coil` look like a project build.
(defn manifest-mode? [(argc i32) (argv (ptr (ptr i8)))] (-> bool)
  (= (argv-file-idx argc argv 2) 0))

; A workspace configures files it owns, not every absolute fixture a command happens
; to name while its shell is inside the workspace. Package manifests retain their
; historical behavior; the ownership boundary is needed specifically at a workspace
; root, where test harnesses commonly invoke the compiler on files under /tmp.
(defn workspace-owns-invocation? [(a (dyn Allocator))
                                  (argc i32)
                                  (argv (ptr (ptr i8)))] (-> bool)
  (let [text (read-file a (to-cstr a "Coil.toml"))]
    (if (= (len text) 0)
        true
        (let [m (parse-manifest a text)
              fidx (argv-file-idx argc argv 2)]
          (if (or (not (m-workspace? m)) (= fidx 0))
              true
              (match (m-realpath a
                                 (from-cstr (load (index argv fidx))))
                (Some [path] (starts-with path (sconcat a (cwd-slice a) "/")))
                (None [] false)))))))

; The reason a dlopen failed. A unit's shared library is linked with undefined
; references on purpose, so the failure that matters names a symbol, and the
; name appears nowhere else.
(extern dlerror :cc (cc/C) [] (-> (ptr i8)))

(defn code-main-file? [(a (dyn Allocator)) (argc i32) (argv (ptr (ptr i8)))]
  (-> bool)
  (if (< (primitive/cast i64 argc) 3)
      false
      (match (read-file-opt a (load (index argv 2)))
        (None [] false)
        (Some [src]
              (try (let [forms (try-or! (read-all a src -1) false)]
                     (let [n (len (load forms))
                           (mut i) 0
                           (mut r) false]
                       (loop (if (>= (load i) n)
                                 (break)
                                 (if (code-main-form? (elem forms
                                                            (load i)))
                                     (do (store! r true) (break))
                                     (store! i (primitive/iadd (load i) 1)))))
                       (load r))))))))

; ---------------------------------------------------------------- `coil fuzz`
;
; `coil test` with a feedback loop: the same file, the same `defprop`s, built with
; EDGE AND COMPARISON INSTRUMENTATION so the runner can tell which inputs reached
; somewhere new and what values the program was looking for, and run as a
; supervised CAMPAIGN (coil.prop.runner's `fuzz-campaign`, coil.prop.fuzz) instead
; of a fixed number of cases.
;
; Why this is a build of its own rather than a flag on `coil test`. SanitizerCoverage
; is a clang instrumentation pass, and Coil's own pipeline has no point at which to
; run it. `emit-ir` already produces complete, linkable IR for the whole program, so
; the instrumented build is: emit IR, hand it to clang with `-fsanitize-coverage`,
; link. Under `--sanitize=address` the IR carries `sanitize_address` on every
; function (emit-ir honours the flag), and clang's `-fsanitize=address` runs the
; ASan pass over it in the same step.
;
; The callbacks clang's instrumentation calls are ordinary Coil functions in
; `coil.prop.cov`, so nothing else about the program changes: the same source, built
; the ordinary way, defines those symbols and never calls them.

(defn check-one [(a (dyn Allocator)) (path (ptr i8)) (triple (ptr i8))] (-> i64)
  (set-target-arch! triple)
  (when (= (run-dump-on-big-stack a
                                  (read-src a path)
                                  (cwd-slice a)
                                  (from-cstr path)
                                  (fnptr-of check-src-program))
           0)
    1))

; ---- file output + project scaffold (new) ----------------------------------
; ---- ~/.coil/balance-log.jsonl ---------------------------------------------
; ---- `coil balance --stats` ------------------------------------------------
; ============================ `coil lint` ===================================
; Run the registered checkers and, with `--fix`, apply the rewrites they proposed
; to the source on disk. `--use` already means "load this metaprogram without
; editing the source", so a rule set is opt-in per invocation:
;
;   coil lint app.coil --use myproject.condlint            report + `help: try:` lines
;   coil lint app.coil --use myproject.condlint --diff     show the patch, write nothing
;   coil lint app.coil --use myproject.condlint --fix      apply it
;
; A plain `coil build` NEVER writes to your source. Only this command does, and it
; is the only caller that reads the suggestion table at all. See docs/archive/AUTOFIX.md.

; ============================ repl ==========================================
;;; Capture this working directory's manifest into an unstarted session.
;;; Configuration belongs to the session; this never writes process environment
;;; variables. Native dependency building remains the embedding host's job.
;;; ---- a session's environment: the program it runs in -----------------------
; `coil` (no args) / `coil --help` / `-h` / `help`. Lists only what driver-main
; actually dispatches — an unimplemented command in here is a lie the CLI tells.
(defn usage-text [] (-> (slice u8))
  "coil — the Coil compiler

usage: coil <command> [args]

Build & run
  run   <file.coil> [flags] [-- args...]   build to a temp exe, run it, propagate its exit code
  run                                      build+run the ./Coil.toml project
  build <file.coil> [-o <out>] [flags]     build a native executable
  build                                    build the ./Coil.toml project
  install [--root DIR]                     install this package to a user-wide bin directory
  update [--rollback]                      install the configured binary toolchain atomically
  check <file.coil> [flags]                typecheck/compile only — no object, exit 0 if it compiles
  check                                    check every configured project target
  test  [selector] [--suite NAME]         discover and run project test suites
  test  <file.coil> [--filter TEXT]...     run matching tests in isolated processes
  fuzz  <file.coil> [-n N]                 run its (defprop …) under coverage guidance
  verify                                   fmt, lint, check, build native inputs, and test
  new   <name>                             scaffold Coil.toml + src/main.coil
  repl                                     interactive session
  fmt   [--check|--write] [--width N] [files...]  format files or project sources
  balance [--check|--write] <files...>     repair unbalanced ()/[] so a file reads again
  lint  [file.coil]... [--fix|--diff]      check --all-files --use coil.lint.default

Artifacts
  emit-obj <file.coil> [-o <out.o>]        build the object file, no link
  emit-ir  <file.coil>                     print normalized textual LLVM IR
  dump-ir  <file.coil>                     alias of emit-ir
  cheader  <file.coil>                     print a C header for (export-c ...) functions
  build-unit <file.coil> -o <dir>          compile a module ahead of time: an interface + one object
                                           (consume it with --unit <dir> on build/run/check)
  cimport  <header.h>                      generate Coil bindings from a C header

Reference
  cheatsheet                               a short practical language reference
  guide [topic|--search text|--all]        focused language reference lookup
  doc   <file.coil>                        markdown for the module's `;;;`-documented surface
  namespaces                               list bundled standard-library namespaces
  namespace <name|file.coil>               list every definition, including available docs
  --version, -V                            print the version
  --print-stdlib-path                      print the standard-library source directory
  --help, -h                               this message

Common flags (build / run / emit-obj)
  -o <out>              exact output path (default: build/release/<name>)
  --release             select the default optimized, no-symbols profile
  -O0 / -O1 / -O2 / -O3 LLVM optimization level (default -O3; LLVM backend only)
  --meta-opt=<n>        -O level for METAPROGRAM objects only (default: follow -O)
                        -O0 builds ~6x faster and runs much slower — for iterating,
                        not for anything you intend to run. -O1 costs the built
                        program almost nothing and still builds ~1.5x faster.
  --single-module       optimize as one LLVM module on one thread, not eight in
                        parallel: about 3x slower to build, code about 12% faster
  --target <triple>     cross-compile (e.g. wasm32-unknown-unknown, x86_64-apple-macosx11.0.0)
  --backend arm64       use the native arm64 backend instead of LLVM
  -g, --debug           emit DWARF and use build/debug/ (implies arm64)
  --debug-checks        bounds, collection, allocator, and stack-return checks
  --sanitize=address    AddressSanitizer (invalid address/use-after-free)
  --sanitize=thread     ThreadSanitizer (data races)
  --sanitize=memory     MemorySanitizer (Linux-only uninitialized reads)
  --sanitize=undefined  undefined integer/divide/shift operations
  --debug-runtime       enable debug checks and AddressSanitizer together
  --jit=llvm|tpde       coil.jit with tpde and LLVM ORC (default), or tpde alone,
                        which links no libLLVM
  -l<name>              link a library (e.g. -lm)
  --link-flag <flag>    pass a raw flag to the linker
  --lib / --shared      build a static (.a) / shared (.dylib) library
  --emit-header <h>     also write a C header
  --emit-state <path>   also save the compiler state, which a session in the
                        program continues from (jit-session-adopt!)
  --use <namespace>     load a metaprogram namespace
  --quiet               suppress the `wrote <path>` line (run/test pass this)

Pipeline stage dumps (for debugging the compiler itself), each <file.coil>
  dump-read      the reader's s-expressions
  dump-ast       the source as the primitive parser reads it (defn*, let*)
  dump-load      the AST with imports resolved
  expand         macro-expanded source
  dump-expand    the expanded AST
  dump-hygiene   expanded syntax with lexical scope/origin metadata
  dump-resolved  after name resolution
  dump-checked   after type checking
  dump-mono      after monomorphization
")

;;; `coil NAME` for a command that is a program of its own, as git runs git-NAME: the
;;; binary beside this one, so a toolchain's tools are that toolchain's, then PATH.
;;; It replaces this process, so its exit status is the command's.
(defn run-tool [(a (dyn Allocator))
                (argc i32)
                (argv (ptr (ptr i8)))
                (name (slice u8))] (-> i64)
  (let [program (sconcat a "coil-" name)
        beside (path-join a (dirname (self-command-path a)) program)
        path (if (= (access (to-cstr a beside) 1) 0) beside program)
        (mut args) (ArrayList::new [(ptr i8)] a)]
    (push! (mut args) (to-cstr a path))
    (for [i 2 (primitive/cast i64 argc)]
      (push! (mut args) (load (index argv i))))
    (push! (mut args) (primitive/cast (ptr i8) 0))
    (native-only (os/execvp (to-cstr a path) (load (field args data))) 0)
    (ps (stderr) "error: cannot run `coil ")
    (ps (stderr) name)
    (ps (stderr) "`: no ")
    (ps (stderr) program)
    (ps (stderr) " beside ")
    (ps (stderr) (self-command-path a))
    (ps (stderr) " or on PATH\n")
    2))

;;; Does this `coil check` go through check-fix-cmd: over all of a project's files, or
;;; applying what its checkers suggest?
(defn check-fixing? [(argc i32) (argv (ptr (ptr i8)))] (-> bool)
  (or (argv-has-flag? argc argv "--fix")
      (or (argv-has-flag? argc argv "--diff")
          (argv-has-flag? argc argv "--all-files"))))

; ---- per-subcommand help ----------------------------------------------------
; `coil fmt --help` printed one byte and exited 0; `coil run --help` tried to build a
; project and complained about a missing Coil.toml. `<cmd> --help` is a reflex, and an
; empty response reads as a broken binary.
;;; common-flags-text minus its `-o <out>` line, for commands that own the output
;;; path themselves.
(defn common-flags-text-without-output [] (-> (slice u8))
  (let [text (common-flags-text)
        marker "  -o <out>"]
    (match (find text marker)
      (None [] text)
      (Some [start]
            (match (find-from text "\n" start)
              (None [] (subslice text 0 start))
              (Some [end]
                    (sconcat (unit-allocator)
                             (subslice text 0 start)
                             (subslice text (+ end 1) (len text)))))))))

(defn common-flags-text [] (-> (slice u8))
  "Flags (may appear before or after <file.coil>)
  -o <out>              output path (default: build/release/<source-or-package-name>)
  --release             select the default optimized, no-symbols profile
  --target <triple>     cross-compile (e.g. wasm32-unknown-unknown)
  --backend arm64       use the native arm64 backend instead of LLVM
  -g, --debug           emit DWARF and use build/debug/ (implies arm64)
  --debug-checks        enable zero-cost-when-off runtime safety checks
  --sanitize=address    instrument with LLVM AddressSanitizer
  --sanitize=thread     instrument with LLVM ThreadSanitizer
  --sanitize=memory     instrument with LLVM MemorySanitizer (Linux only)
  --sanitize=undefined  check undefined integer/divide/shift operations
  --debug-runtime       enable debug checks and AddressSanitizer together
  --jit=llvm|tpde       coil.jit with tpde and LLVM ORC (default), or tpde alone,
                        which links no libLLVM
  -l<name>              link a library (e.g. -lm)
  --link-flag <flag>    pass a raw flag to the linker
  --lib / --shared      build a static (.a) / shared (.dylib) library
  --emit-header <h>     also write a C header
  --emit-state <path>   also save the compiler state, which a session in the
                        program continues from (jit-session-adopt!)
  --use <namespace>     load a metaprogram namespace
  --quiet               suppress the `wrote <path>` line (run/test pass this)
")

; `coil --version` used to print `unknown command '--version'` and the usage text, so
; the one question every adopter asks first — "which Coil?" — had no answer at all.
;
; A STATIC string, deliberately. Baking the git commit in at build time was the obvious
; alternative and is worse twice over: version.coil would sit in main.coil's import
; closure, so every commit would churn the `full` snapshot, and a stamp taken from a
; dirty tree LIES about what the binary contains — which is exactly the trap
; SEED_VERSION set when it recorded a commit the seed was not built from. Bump this by
; hand when cutting a release.
(defn version-text [] (-> (slice u8))
  "coil 0.1.0\n")

;;; `coil 0.1.0`, plus the commit and date the build recorded in `<binary>.toolchain`
;;; (written beside the binary by every build and install, never compiled in; the
;;; stamp says `dirty` itself when the tree had uncommitted changes).
(defn print-version! [(a (dyn Allocator))] (-> void)
  (let [w (stdout)
        base (version-text)]
    (match (read-file-opt a
                          (to-cstr a
                                   (sconcat a
                                            (self-command-path a)
                                            ".toolchain")))
      (None [] (ps w base))
      (Some [stamp]
            (let [(mut commit) ""
                  (mut date) ""
                  (mut dirty) false]
              (for line (split a stamp "\n")
                (cond (starts-with line "commit ")
                        (set! commit
                              (subslice line
                                        7
                                        (if (< (len line) 19) (len line) 19)))
                      (starts-with line "date ")
                        (set! date
                              (subslice line
                                        5
                                        (if (< (len line) 15) (len line) 15)))
                      (= line "dirty") (set! dirty true)
                      :else 0))
              (if (= (len commit) 0)
                  (ps w base)
                  (do
                    (ps w (subslice base 0 (- (len base) 1)))
                    (ps w " (commit ")
                    (ps w commit)
                    (when (> (len date) 0) (ps w ", ") (ps w date))
                    (when dirty (ps w ", dirty"))
                    (ps w ")\n"))))))))

(defn wants-help? [(argc i32) (argv (ptr (ptr i8)))] (-> bool)
  (let [(mut i) 2
        (mut r) false]
    (loop (if (>= (load i) (primitive/cast i64 argc))
              (break)
              (let [arg (from-cstr (load (index argv (load i))))]
                (if (= arg "--")
                    (break)
                    (if (or (= arg "--help") (= arg "-h"))
                        (do (set! r true) (break))
                        (do (set! i (primitive/iadd (load i) 1)) 0))))))
    (load r)))

(defn sub-usage [(sub (slice u8))] (-> i64)
  (let [w (stdout)]
    (cond (= sub "guide")
            (do
              (ps w
                  "usage: coil guide [<topic> [topic...]]|--search <text>|--all\n\n")
              (ps w
                  "With no arguments, lists compact guide topics. A topic prints only its\n")
              (ps w
                  "relevant reference section; any number of topics may be combined. --search\n")
              (ps w
                  "ranks relevant topics and gives excerpts for narrow queries;\n")
              (ps w "--all prints the complete language guide.\n")
              0)
          (= sub "update") (do (ps w (updater/update-usage)) 0)
          (= sub "build")
            (do
              (ps w "usage: coil build <file.coil> [-o <out>] [flags]\n")
              (ps w
                  "       coil build [flags]                    build the ./Coil.toml project\n\n")
              (ps w (common-flags-text))
              0)
          (= sub "run")
            (do
              (ps w "usage: coil run <file.coil> [flags] [-- args...]\n")
              (ps w
                  "       coil run [flags] [-- args...]         build+run the ./Coil.toml project\n\n")
              (ps w
                  "Builds to a temp exe, runs it, and propagates its exit code — 128+signo if it\ndies by a signal.\n\n")
              (ps w
                  "  --run-in DIR   start the program in DIR (a project run starts it where you\n                 typed the command, even when it builds in another directory)\n\n")
              (ps w (common-flags-text))
              0)
          (= sub "test")
            (do
              (ps w
                  "usage: coil test [selector]... [--suite NAME]... [--list|--no-run] [--jobs N]\n")
              (ps w
                  "       coil test <file.coil> [--filter TEXT]... [--list] [flags]\n\n")
              (ps w
                  "Property flags go to the RUNNER, everything else to the build:\n")
              (ps w
                  "  --cases N --seed N --size N --shrink N --max-rejects N --timeout N\n")
              (ps w "  --arena BYTES --verbose --alloc-tracked --no-fork\n")
              (ps w
                  "e.g. `coil test tests/p_test.coil --cases 100000 --seed 42 --verbose`.\n")
              (ps w
                  "See `coil fuzz --help` for the coverage-guided search.\n\n")
              (ps w
                  "Auto-loads src/stdlib/assert.coil (so `deftest`/`assert`/`assert-eq` need no import),\n")
              (ps w
                  "discovers every (deftest …), and runs each in its OWN process so one failing or\n")
              (ps w
                  "crashing test never stops the suite. Exit: 0 iff all pass, 1 if any fails.\n\n")
              (ps w
                  "For a named file, --filter TEXT selects test names by substring (repeatable, OR),\n")
              (ps w
                  "and --list prints exactly that selected set without spawning test processes.\n\n")
              (ps w
                  "Suites are declared as [test.suites.<name>] in Coil.toml, each with its own\n")
              (ps w
                  "`roots` and `suffixes`. A suite runs on a bare `coil test` unless it declares\n")
              (ps w
                  "`default = false` — that is how a slow or costly integration suite stays out of\n")
              (ps w "the everyday run until it is asked for by name.\n\n")
              (ps w
                  "  --suite NAME   run this suite (repeatable); `--suite all` runs every suite\n")
              (ps w "  --list         print what would run, grouped by suite\n")
              (ps w
                  "  selector       narrow to paths containing this substring, after suite selection;\n                 with several, a file runs when its path contains any of them\n\n")
              (ps w
                  "A named file always runs, whichever suite does or does not claim it.\n\n")
              ; The runner owns its executable's path; `coil test` rejects -o.
              (ps w (common-flags-text-without-output))
              0)
          (= sub "fuzz")
            (do
              (ps w "usage: coil fuzz <file.coil> [options]\n\n")
              (ps w
                  "Runs a COVERAGE-GUIDED FUZZING CAMPAIGN against each of the file's (defprop …)\n")
              (ps w
                  "properties. The program is built with clang's SanitizerCoverage; worker processes\n")
              (ps w
                  "mutate a corpus of inputs, keep every input that reaches new code (or reaches it a\n")
              (ps w
                  "new number of times), and steer mutations with the values failed comparisons\n")
              (ps w
                  "wanted. Inputs are the generators' choice sequences, so every mutant is a valid\n")
              (ps w
                  "value of the property's argument types: elements are deleted, repeated and spliced\n")
              (ps w "between inputs as whole values, never as bytes.\n\n")
              (ps w
                  "A failure — false, a crash, an AddressSanitizer report, or an input that runs past\n")
              (ps w
                  "--input-timeout — is minimized by the ordinary shrinker and saved to .coil/pbt/, so\n")
              (ps w
                  "a plain `coil test` replays it first from then on. The corpus is saved as it grows,\n")
              (ps w
                  "in .coil/fuzz/<property>/corpus/, and the next campaign starts from it.\n\n")
              (ps w
                  "  --time SECS          campaign length per property (default 60; 0 = until stopped)\n")
              (ps w
                  "  -n, --iterations N   stop each worker after N mutated inputs instead\n")
              (ps w
                  "  --jobs N             worker processes per property, sharing one corpus (default 1)\n")
              (ps w
                  "  --sanitize=address   build with AddressSanitizer; every generated value gets its\n")
              (ps w
                  "                       own allocation so an overrun is caught\n")
              (ps w
                  "  --input-timeout SECS an input running longer is reported as a hang (default 10)\n")
              (ps w
                  "  --debug-checks       build with bounds and allocation checks (see coil help build)\n")
              (ps w
                  "  --arena BYTES        per-case arena for generated values (default 8 MiB)\n")
              (ps w
                  "  --filter SUBSTR      only properties whose name contains SUBSTR\n")
              (ps w
                  "  --size N             size budget for generated values (default 256)\n")
              (ps w
                  "  --cases N            random cases each worker generates before mutating (default 200)\n")
              (ps w "  --seed N             seed for generation and mutation\n")
              (ps w
                  "  --corpus DIR         read and grow this corpus instead of the default\n")
              (ps w
                  "  --fuzz-dir DIR       root for campaign files (default .coil/fuzz)\n")
              (ps w
                  "  --minimize-corpus    replay the corpus, keep only entries that add coverage, stop\n")
              (ps w
                  "  --status-every SECS  status line interval (default 10; 0 = off)\n")
              (ps w
                  "  --no-run             build the instrumented binary and stop\n")
              (ps w
                  "  --keep               keep the build directory (the IR is in program.ll)\n\n")
              (ps w
                  "Requires the LLVM toolchain that `llvm-config --bindir` names.\n")
              0)
          (= sub "verify")
            (do
              (ps w "usage: coil verify\n\n")
              (ps w
                  "Validates Coil.toml, checks formatting, runs project lint rules, typechecks\n")
              (ps w
                  "every configured target graph, links the package (which is what validates\n")
              (ps w
                  "[link]/[cc] — `check` alone never links), and runs all tests.\n")
              0)
          (= sub "lint")
            (do
              (ps w
                  "`coil lint` is `coil check --all-files --use coil.lint.default`.\n\n")
              (ps w
                  "usage: coil lint [file.coil]... [--use <namespace>]... [--target <triple>] [--lint-param KEY=VALUE]... [--fix|--diff] [--max-analyses N] [--verbose]\n\n")
              (ps w
                  "  (default)      report what the registered checkers say, plus a `help: try:`\n")
              (ps w "                 line for every fix they propose\n")
              (ps w
                  "  --use RULE     load an additional project or policy checker\n")
              (ps w
                  "  --target T     check the program for target triple T instead of the host\n")
              (ps w
                  "  --lint-param   pass a rule-scoped KEY=VALUE string to loaded checkers\n")
              (ps w
                  "  --diff         preview the complete --fix fixpoint; write nothing\n")
              (ps w
                  "  --fix          apply them, re-analysing to a fixpoint\n")
              (ps w
                  "  --max-analyses N\n                 stop --fix/--diff after N analyses (default 64)\n")
              (ps w
                  "  --verbose      print a line as each analysis finishes: what it was for, how long it took\n")
              (ps w
                  "The standard safe-fix profile runs automatically; --use adds project or policy\n")
              (ps w
                  "rules. A round that produces code which does not compile is REVERTED, so\n")
              (ps w
                  "--fix can never leave the tree worse than it found it. A plain `coil build`\n")
              (ps w "never writes to your source; only this command does.\n")
              0)
          (= sub "balance")
            (do
              (ps w
                  "usage: coil balance [--check|--write] [--strict] <file.coil>...\n\n")
              (ps w "  (default)      print repaired source to stdout\n")
              (ps w "  --write        repair each file in place\n")
              (ps w
                  "  --check        exit 1 if any file's delimiters do not balance\n")
              (ps w
                  "  --strict       refuse a closer whose position indentation cannot determine\n")
              (ps w
                  "  --stats        summarise ~/.coil/balance-log.jsonl and exit\n\n")
              (ps w
                  "Repairs ()/[] in source that will not read. Where a missing closer goes is\n")
              (ps w
                  "decided by indentation, scoped to the one top-level form that is damaged: a\n")
              (ps w
                  "form that already balances is copied out byte-for-byte and never analysed.\n\n")
              (ps w
                  "It only ever INSERTS a missing closer or DELETES an unmistakable stray one\n")
              (ps w
                  "(a closer in column 0), and never moves a delimiter — so a repair cannot\n")
              (ps w
                  "rearrange code that was already correct. A surplus closer elsewhere, a `)`\n")
              (ps w
                  "against a `[`, or a form needing both an insert and a delete is REPORTED\n")
              (ps w "with its location rather than guessed at.\n\n")
              (ps w
                  "Balance is structural: it never requires the damaged program to typecheck.\n")
              (ps w
                  "When indentation identifies a plausible item boundary, that repair is emitted\n")
              (ps w
                  "directly; remaining parser, resolver, or type errors belong to their own tools.\n")
              (ps w
                  "--strict refuses a position that indentation alone cannot determine.\n\n")
              (ps w
                  "Every run appends one line to ~/.coil/balance-log.jsonl — a path, an outcome,\n")
              (ps w
                  "a cause and four counters. Nothing is sent anywhere and no source text is\n")
              (ps w
                  "recorded; it exists so the refusals you actually hit can be counted, rather\n")
              (ps w
                  "than inferred from a synthetic corpus. COIL_BALANCE_LOG=0 turns it off.\n\n")
              (ps w
                  "Exit: 0 balanced, 1 unbalanced (--check), 2 error or refusal.\n")
              0)
          (= sub "fmt")
            (do
              (ps w
                  "usage: coil fmt [--check|--write] [--width N] [file.coil...|-]\n\n")
              (ps w "  (default)   print formatted source to stdout\n")
              (ps w "  --write     rewrite each file in place\n")
              (ps w "  --check     exit 1 if any input is not formatted\n")
              (ps w "  --width N   format to N columns (default: 80)\n\n")
              (ps w
                  "Pass - to format standard input. With no input paths, fmt formats the current\n")
              (ps w
                  "project's sources. --write cannot be used with standard input.\n\n")
              (ps w
                  "Every file given is formatted. Exit: 0 clean, 1 unformatted, 2 error.\n")
              0)
          (= sub "check")
            (do
              (ps w "usage: coil check [<file.coil>] [flags]\n\n")
              (ps w
                  "Runs the full front-end (typecheck, semantic checkers, monomorphize) WITHOUT\n")
              (ps w
                  "emitting an object or linking. Exit: 0 if it compiles, 1 with a located\n")
              (ps w
                  "diagnostic if not. `build -o /dev/null` routes here too.\n\n")
              (ps w
                  "With no file, in a project: the same front end over the [package] entry graph\n")
              (ps w
                  "and over every test file `coil test` would select. Nothing is codegen'd,\n")
              (ps w
                  "linked, or run — use `build` to validate [link]/[cc], `test` to run tests, or\n")
              (ps w
                  "`verify` for fmt + lint + check + build + test in one go.\n\n")
              (ps w
                  "Applying what the checkers suggest:\n")
              (ps w
                  "  --all-files        every source of the project, not only what its entry reaches\n")
              (ps w
                  "  --diff             print the fixes as a patch; writes nothing\n")
              (ps w
                  "  --fix              apply them, keeping only what compiles (implies --all-files\n")
              (ps w "                     in a project)\n")
              (ps w
                  "  --max-analyses N   stop after N analyses of the program (default 64)\n")
              (ps w "  --lint-param K=V   a value for a checker to read\n\n")
              (ps w (common-flags-text))
              0)
          (= sub "new")
            (do
              (ps w
                  "usage: coil new <name>\n\nScaffolds <name>/Coil.toml and <name>/src/main.coil.\n")
              0)
          (= sub "install")
            (do
              (ps w "usage: coil install [--root DIR]\n\n")
              (ps w
                  "Builds the current package and installs its executable as <root>/bin/<package-name>.\n")
              (ps w
                  "The root is --root DIR, then COIL_INSTALL_ROOT, then ~/.local.\n")
              0)
          (= sub "doc")
            (do
              (ps w "usage: coil doc <file.coil>\n\n")
              (ps w
                  "Prints markdown for every definition carrying a `;;;` doc comment: its name,\n")
              (ps w
                  "signature, and the doc. A doc comment is a run of lines starting with `;;;`\n")
              (ps w
                  "DIRECTLY above the definition — a single `;` stays an ordinary comment, so\n")
              (ps w
                  "documenting something is opt-in. The same rule backs `(primitive/code-doc NODE)` at\n")
              (ps w
                  "comptime, so doc tooling can be written as a library metaprogram.\n")
              0)
          (= sub "namespaces")
            (do
              (ps w
                  "usage: coil namespaces\n\nLists the namespaces bundled into this compiler.\n")
              0)
          (= sub "namespace")
            (do
              (ps w
                  "usage: coil namespace <name|file.coil> [--name <definition>|--search <text>]\n\nLists every definition and signature in a namespace; `;;;` docs are included when present.\n")
              0)
          (= sub "emit-obj")
            (do
              (ps w
                  "usage: coil emit-obj <file.coil> [-o <out.o>]\n\nBuilds the object file without linking.\n\n")
              (ps w (common-flags-text))
              0)
          ; `--target` was accepted here long before it was documented, so the help
          ; text actively misled: it read as though cross-emission were impossible,
          ; which is exactly the wrong thing to believe when the Linux bootstrap
          ; artifacts have gone stale and this command is how you rebuild one.
          (= sub "emit-ir")
            (do
              (ps w "usage: coil emit-ir <file.coil> [--target <triple>]\n\n")
              (ps w
                  "Prints normalized textual LLVM IR on stdout; diagnostics go to stderr,\n")
              (ps w
                  "so `coil emit-ir f.coil > f.ll` writes IR and nothing else.\n\n")
              (ps w
                  "  --target <triple>   emit for another platform rather than the host\n")
              (ps w
                  "                      (e.g. x86_64-unknown-linux-gnu). Also selects what\n")
              (ps w
                  "                      `(target-os)` answers, so per-platform constants fold\n")
              (ps w "                      for the TARGET.\n")
              0)
          (= sub "cheader")
            (do
              (ps w
                  "usage: coil cheader <file.coil>\n\nPrints a C header for (export-c ...) functions.\n")
              0)
          (= sub "cimport")
            (do
              (ps w
                  "usage: coil cimport <header.h>\n\nGenerates Coil bindings from a C header.\n")
              0)
          (do (ps w (usage-text)) 0))))

; argv[2] for the commands that take a <file>. Missing => NULL, and every caller
; feeds it straight to read-file/from-cstr, so guard once here rather than
; segfaulting on `coil dump-ast` with no argument.
(defn need-file [(argc i32) (argv (ptr (ptr i8))) (sub (slice u8))]
  (-> (ptr i8))
  (let [fidx (argv-file-idx argc argv 2)]
    (if (= fidx 0)
        (do
          (ps (stderr) "usage: coil ")
          (ps (stderr) sub)
          (ps (stderr) " <file.coil>\n")
          (exit 1)
          (primitive/cast (ptr i8) 0))
        (load (index argv fidx)))))

; ---- entering a project ------------------------------------------------------

;;; Whether `sub` works on the project in the current directory: every command that
;;; reads ./Coil.toml, and so follows a `[project] path` there.
(defn project-command? [(sub (slice u8))] (-> bool)
  (or (namespace-using-command? sub)
      (= sub "fmt")
      (= sub "install")
      (= sub "repl")))

;;; The directory a `[project] path` in `dir`'s Coil.toml points at, or None when
;;; that Coil.toml is missing or is a package or workspace.
(defn project-pointer [(a (dyn Allocator)) (dir (slice u8))]
  (-> (Option (slice u8)))
  (let [text (read-file a (to-cstr a (path-join a dir "Coil.toml")))]
    (if (= (len text) 0)
        (None [(slice u8)])
        (let [m (parse-manifest a text)]
          (if (= (len (.project-path m)) 0)
              (None [(slice u8)])
              (Some (path-join a dir (.project-path m))))))))

;;; A `[project] path` names a package or a workspace: a directory with a Coil.toml
;;; of its own that is not another pointer.
(defn require-project-target! [(a (dyn Allocator))
                               (from (slice u8))
                               (to (slice u8))] (-> i64)
  (let [w (stderr)
        text (read-file a (to-cstr a (path-join a to "Coil.toml")))]
    (when (= (len text) 0)
      (ps w "error: ")
      (ps w (path-join a from "Coil.toml"))
      (ps w ": [project] path '")
      (ps w to)
      (ps w "' has no Coil.toml")
      (wb w 10)
      (exit 1))
    (when (> (len (.project-path (parse-manifest a text))) 0)
      (ps w "error: ")
      (ps w (path-join a from "Coil.toml"))
      (ps w ": [project] path '")
      (ps w to)
      (ps w "' is another [project] pointer; name the package it points at")
      (wb w 10)
      (exit 1))
    0))

;;; `coil run DIR`, `coil build DIR` and `coil check DIR` mean the project in DIR, and
;;; a Coil.toml holding only `[project] path = "DIR"` means the same for every
;;; project command run beside it. Either way the command runs in DIR, while it is
;;; still the command the user typed where they stand: invocation-argv reads its
;;; paths from there and starts a `run`'s program there. The DIR argument is dropped,
;;; which leaves the no-path form every project command already handles. A
;;; directory with no Coil.toml is not a project and is left alone, so it reaches the
;;; "is a directory" error instead of changing anything.
(defn enter-project! [(argc i32) (argv (ptr (ptr i8)))]
  (-> (ptr (ArrayList (ptr i8))))
  (let [a (malloc-allocator)
        sub (if (>= argc 2) (from-cstr (load (index argv 1))) "")
        didx
          (if (or (= sub "run") (= sub "build") (= sub "check"))
              (let [idx (argv-file-idx argc argv 2)]
                (if (and (> idx 0)
                         (and (dir? (load (index argv idx)))
                              (= (access (to-cstr a
                                                  (path-join a
                                                             (from-cstr (load (index argv
                                                                                     idx)))
                                                             "Coil.toml"))
                                         0)
                                 0)))
                    idx
                    0))
              0)
        named (if (> didx 0) (from-cstr (load (index argv didx))) ".")
        target
          (if (or (> didx 0) (project-command? sub))
              (match (project-pointer a named)
                (Some [to] (do (require-project-target! a named to) to))
                (None [] (if (> didx 0) named "")))
              "")]
    (if (= (len target) 0)
        (let [out (box! a (ArrayList (ptr i8)) (ArrayList::new [(ptr i8)] a))]
          (for i (range 0 (primitive/cast i64 argc))
            (push! out (load (index argv i))))
          (push! out (primitive/cast (ptr i8) 0))
          out)
        (let [entered (invocation-argv a sub argc argv didx (cwd-slice a))]
          (set! (.entered (entered-project-cell)) true)
          (when (!= (chdir (to-cstr a target)) 0)
            (ps (stderr) "error: cannot enter '")
            (ps (stderr) target)
            (ps (stderr) "'")
            (wb (stderr) 10)
            (exit 1))
          entered))))

;;; ---- the interpreted metaprogram engine -------------------------------------
;;; Every compiler entry registers the engine through these, so COIL_META_INTERP=1
;;; means one thing in every build: the LLVM compiler, the LLVM-free ones and the
;;; coil.jit SDK interpret each metaprogram and metaprogram (interp.coil) instead
;;; of compiling it. metaengine.coil::meta-interp-engine-selected refuses a request
;;; that no entry registered, rather than running another engine in its place.

(defn driver-main [(argc i32)
                   (argv (ptr (ptr i8)))
                   (build-fn (fnptr (cc/C)
                                    [(ref (dyn Allocator))
                                     (slice u8)
                                     (slice u8)
                                     (ptr i8)
                                     (ptr i8)
                                     (slice u8)]
                                    i64))
                   (emitir-fn (fnptr (cc/C)
                                     [(ref (dyn Allocator))
                                      (slice u8)
                                      (slice u8)
                                      (ptr i8)
                                      (slice u8)]
                                     i64))
                   (normalize-fn (fnptr (cc/C)
                                        [(ref (dyn Allocator)) (slice u8)]
                                        i64))
                   (cimport-fn (fnptr (cc/C)
                                      [(ref (dyn Allocator)) i32 (ptr (ptr i8))]
                                      i64))
                   (repl-fn (fnptr (cc/C)
                                   [(ref (dyn Allocator)) (ptr (ptr i8))]
                                   i64))
                   (default-backend i64)] (-> i64)
  (let [_entry (entry-config-save! (malloc-allocator))
        ; `coil build --emit-state` compiles in a session, which is above the
        ; pipeline that dispatches to it
        _state (set! (.compile (state-build)) (fnptr-of state-build-program))
        entered (enter-project! argc argv)]
    (driver-main-in (primitive/cast i32 (- (len (load entered)) 1))
                    (load (field entered data))
                    build-fn
                    emitir-fn
                    normalize-fn
                    cimport-fn
                    repl-fn
                    default-backend)))

(defn driver-main-in [(argc i32)
                      (argv (ptr (ptr i8)))
                      (build-fn (fnptr (cc/C)
                                       [(ref (dyn Allocator))
                                        (slice u8)
                                        (slice u8)
                                        (ptr i8)
                                        (ptr i8)
                                        (slice u8)]
                                       i64))
                      (emitir-fn (fnptr (cc/C)
                                        [(ref (dyn Allocator))
                                         (slice u8)
                                         (slice u8)
                                         (ptr i8)
                                         (slice u8)]
                                        i64))
                      (normalize-fn (fnptr (cc/C)
                                           [(ref (dyn Allocator)) (slice u8)]
                                           i64))
                      (cimport-fn (fnptr (cc/C)
                                         [(ref (dyn Allocator))
                                          i32
                                          (ptr (ptr i8))]
                                         i64))
                      (repl-fn (fnptr (cc/C)
                                      [(ref (dyn Allocator)) (ptr (ptr i8))]
                                      i64))
                      (default-backend i64)] (-> i64)
  ; argv[1] is NULL when argc < 2 — read it unguarded and `coil` with no args
  ; segfaults in from-cstr before dispatch ever runs.
  ;
  ; THE ROOT ALLOCATOR. Every subcommand below is handed this one `a`, and the whole
  ; pipeline threads it, so this binding decides how the compiler allocates. A bump
  ; allocator is the right shape: AST nodes live until the process exits and almost
  ; nothing is individually freed, which is precisely the lifetime an arena is for.
  ;
  ; Measured on `build src/compiler/main.coil` (51k-line import closure), 15 paired runs
  ; alternating binaries. Both sides must compile the SAME library — back when each
  ; binary embedded its own copy of src/stdlib that took pinning, and forgetting it
  ; produced two wrong findings before anyone noticed (see docs/reference/ALLOCATION.md);
  ; now the library is one directory on disk, so the pinning is structural:
  ; -30 ms median, faster in 12 of 15 pairs, and 1044 -> 1021 MiB of
  ; peak RSS. The compiler already retained essentially everything it allocated, so
  ; dropping `free` costs no memory and malloc's per-block bookkeeping is what goes away.
  ;
  ; A fixed 1 GiB root bump region made whole-project lint touch the entire reservation
  ; and then spill into untracked malloc blocks. Use the segmented growable arena: it
  ; keeps bump allocation, grows with actual demand, and gives compiler passes a parent
  ; whose segments can eventually be released/reset as their lifetimes become explicit.
  (require-option-values! argc argv)
  ; `--timings` is a process-wide diagnostic, not a per-command option: turn it
  ; on before any phase begins so no span is missed. Arguments after `--` belong
  ; to the program being run.
  (block :timings-scan
    (for i (range 2 (cast i64 argc))
      (let [arg (from-cstr (load (index argv i)))]
        (when (= arg "--") (return-from :timings-scan 0))
        (when (= arg "--timings")
          (tr/timings-enable!)
          (return-from :timings-scan 0))))
    0)
  (let [(mut root-arena) (zeroed scratch/ScratchArena)
        _root-init
          (scratch/ScratchArena::init-with-capacity (mut root-arena)
                                                    (large-pages/compiler-scratch-for "root")
                                                    1048576)
        seed-a (allocator (mut root-arena))
        seed-meta-opt (load (meta-opt-box))
        root-config
          (box! seed-a CompilationUnitConfig (compilation-unit-config seed-a))
        command-scope (primitive/alloc-stack CompilationUnitSession)
        a
          (compilation-unit-enter! command-scope
                                   root-config
                                   (primitive/cast (ptr (ArrayList VirtualSource))
                                                   0)
                                   true
                                   "unit.command")
        ; This is the command's pre-argv scope, not a normalized generated owner.
        ; Preserve an unset --meta-opt so a later -O flag remains its default.
        _meta-opt-policy (set! (meta-opt-box) seed-meta-opt)
        ; Manifest/argv normalization happens below. Freeze policy separately at
        ; each generated-program boundary, after those options have been applied.
        _mutable-command-policy
          (set! (.environment (.allocation command-scope))
                (primitive/cast (ptr (ArrayList UnitEnvironment)) 0))
        ; COIL_MTRACE=mem: lend the root arena's monotonic byte counter to
        ; mtrace so expand-macro can attribute allocation per metaprogram.
        _mem-meter
          (when (mtr/mtrace-mem?)
            (mtr/mtrace-mem-bind! (primitive/cast (ptr i8)
                                                  (field command-scope arena))
                                  (fnptr-of driver-mem-src))
            0)
        ; Which command was run is what locates the standard library (loader.coil:
        ; find-stdlib-layout!), so publish it before anything can load a module.
        _self
          (set-self-command! (if (< (primitive/cast i64 argc)
                                    1)
                                 ""
                                 (from-cstr (load (index argv 0)))))
        sub
          (if (< (primitive/cast i64 argc) 2)
              ""
              (from-cstr (load (index argv 1))))
        _test-project-env (reset-inherited-test-project-env! a)
        _wasm-triple (normalize-wasm-target-argv! argc argv)
        ; The backend this invocation compiles with, known before any unit is
        ; built or registered: the manifest's prebuilt dependencies and the
        ; shipped coil.jit unit are both built by, and only linked into, it.
        _consumer-backend
          (do
            (set! (.consumer_backend (driver-unit-state))
                  (argv-backend argc argv default-backend))
            ; a wasm-hosted compiler emitting arm64 or x64 code with no --target
            ; builds for the machine it runs on (metastate.coil, native-default-cell)
            (let [b (.consumer_backend (driver-unit-state))]
              (set! (.on (native-default-cell))
                    (and (or (= (host-arch-str) "wasm32")
                             (= (host-arch-str) "wasm64"))
                         (native-backend? b))))
            0)
        ; before any unit is registered: a unit links only into a build for its
        ; coil.jit implementation (unit-jit-compatible?)
        _consumer-jit (apply-argv-jit-flag! argc argv)
        namespace-span (tr/span-begin "driver.manifest")
        namespace-ready
          (if (and (namespace-using-command? sub)
                   (workspace-owns-invocation? a argc argv))
              (apply-project-manifest! a argc argv)
              0)
        _namespace-end (tr/span-end namespace-span)
        _profile-flag (check-profile-flag! a argc argv)
        _macro-debug (apply-macro-debug-flags! a argc argv)
        _reader-artifact (apply-reader-artifact-flag! a argc argv)
        _units (apply-unit-flags! a argc argv sub)
        _compile-policy
          (when (namespace-using-command? sub)
            (apply-common-compile-flags! argc argv)
            0)
        ; Every command that accepts `--link-flag`/`-lfoo` gets them applied to the
        ; metaprogram link, not just `build`. build-cmd sets its own filtered
        ; list afterwards and wins.
        meta-link-ready (set-meta-link-flags-from-argv! a argc argv)]
    (let [command-result
            (cond (or (= sub "") (= sub "--help") (= sub "-h") (= sub "help"))
                    (do (ps (stdout) (usage-text)) 0)
                  ; `<cmd> --help` before any dispatch, so it never reaches a parser that would
                  ; reject it as an unknown flag or try to build a project.
                  (wants-help? argc argv) (sub-usage sub)
                  (= sub "__smoke") (smoke a)
                  (or (= sub "--version") (= sub "-V") (= sub "version"))
                    (do (print-version! a) 0)
                  (= sub "--print-stdlib-path")
                    (let [layout (stdlib-layout a)]
                      (if (stdlib-missing? layout)
                          (stdlib-not-found a "coil.core")
                          (do (ps (stdout) (.libs layout)) (wb (stdout) 10) 0)))
                  (= sub "cheatsheet") (do (ps (stdout) (cheatsheet-text)) 0)
                  (= sub "guide") (guide-cmd a argc argv)
                  ; A sandboxed compiler has no network transport, and replacing
                  ; the toolchain it runs inside is the host's job.
                  (= sub "update")
                    (native-only (updater/update-cmd a argc argv)
                                 (do
                                   (ps (stderr)
                                       "error: `coil update` is not available in the WebAssembly-hosted compiler\n")
                                   1))
                  (= sub "build-provider") (build-provider-cmd a argc argv)
                  (= sub "build-unit") (build-unit-cmd a argc argv)
                  (= sub "build-lint-profile")
                    (build-lint-profile-cmd a argc argv)
                  (= sub "build-library-state")
                    (build-library-state-cmd a argc argv)
                  (= sub "namespaces") (do (ps (stdout) (stdlib-namespaces)) 0)
                  (= sub "doc")
                    (doc-cmd a
                             (from-cstr (need-file argc argv sub))
                             false
                             ""
                             "")
                  (= sub "namespace") (namespace-cmd a argc argv)
                  (= sub "__normalize")
                    (let [path (need-file argc argv sub)
                          src (read-src a path)]
                      (call-ptr normalize-fn a src))
                  (= sub "cimport") (call-ptr cimport-fn a argc argv)
                  (= sub "repl") (call-ptr repl-fn a argv)
                  ; Three cases, in order: no file at all (the project's own entry); a file
                  ; named inside a project that has not been configured yet (same project
                  ; build, different entry); and everything else — a lone file, or the child
                  ; a project command already handed its configuration to.
                  (= sub "run")
                    (let [project
                            (do
                              (argv-file-first! argc argv)
                              (or (manifest-mode? argc argv)
                                  (project-manifest?)))
                          fidx
                            (if (manifest-mode? argc argv)
                                0
                                (argv-file-idx argc argv 2))]
                      (cond (not project) (run-file-cmd a argc argv)
                            ; As for build: the manifest is applied to this process, so
                            ; run its entry here with the argv a child would have had.
                            (and (project-manifest?)
                                 (and (manifest-build-in-process? (project-manifest))
                                      (or (!= fidx 0)
                                          (not (m-library-package? a
                                                                   (project-manifest))))))
                              (let [direct-argv
                                      (manifest-run-argv a
                                                         argc
                                                         argv
                                                         fidx
                                                         (project-manifest))]
                                (run-file-cmd a
                                              (primitive/cast i32
                                                              (len (load direct-argv)))
                                              (load (field direct-argv data))))
                            :else (manifest-cmd a "run" argc argv fidx "")))
                  (= sub "test") (test-cmd a argc argv)
                  (= sub "fuzz") (fuzz-cmd a argc argv)
                  (= sub "verify") (verify-cmd a argc argv)
                  (or (= sub "fmt")
                      (or (= sub "lint")
                          (and (= sub "check") (check-fixing? argc argv))))
                    (if (and (not (and (= sub "fmt")
                                       (argv-has-flag? argc argv "-")))
                             (and (manifest-mode? argc argv)
                                  (and (project-manifest?)
                                       (m-workspace? (project-manifest)))))
                        (workspace-fanout a
                                          sub
                                          (resolve-command-path a
                                                                (from-cstr (load (index argv
                                                                                        0))))
                                          (project-manifest)
                                          argc
                                          argv)
                        (cond (= sub "lint") (check-fix-cmd a argc argv true)
                              (= sub "check") (check-fix-cmd a argc argv false)
                              :else (run-tool a argc argv "fmt")))
                  (= sub "balance") (run-tool a argc argv "balance")
                  (= sub "new") (new-cmd a argc argv)
                  (= sub "install") (install-cmd a argc argv)
                  ; emit-obj-cmd reads its file from argv[2]: put it there, and
                  ; stop with the usage when there is none.
                  (= sub "emit-obj")
                    (do
                      (argv-file-first! argc argv)
                      (need-file argc argv sub)
                      (emit-obj-cmd a
                                    argc
                                    argv
                                    build-fn
                                    emitir-fn
                                    default-backend))
                  (= sub "cheader") (cheader-cmd a argc argv)
                  (= sub "build")
                    (if (manifest-mode? argc argv)
                        (if (and (project-manifest?)
                                 (manifest-build-in-process? (project-manifest))
                                 (not (m-library-package? a (project-manifest))))
                            (let [direct-argv
                                    (manifest-build-argv a
                                                         argc
                                                         argv
                                                         0
                                                         (project-manifest))]
                              (build-cmd a
                                         (primitive/cast i32
                                                         (len (load direct-argv)))
                                         (load (field direct-argv data))
                                         build-fn
                                         emitir-fn
                                         default-backend))
                            (manifest-cmd a "build" argc argv 0 ""))
                        (if (project-manifest?)
                            (if (and (manifest-build-in-process? (project-manifest))
                                     (or (!= (argv-file-idx argc argv 2) 0)
                                         (not (m-library-package? a
                                                                  (project-manifest)))))
                                (let [file-idx (argv-file-idx argc argv 2)
                                      direct-argv
                                        (manifest-build-argv a
                                                             argc
                                                             argv
                                                             (argv-file-idx argc
                                                                            argv
                                                                            2)
                                                             (project-manifest))]
                                  (build-cmd a
                                             (primitive/cast i32
                                                             (len (load direct-argv)))
                                             (load (field direct-argv data))
                                             build-fn
                                             emitir-fn
                                             default-backend))
                                (manifest-cmd a
                                              "build"
                                              argc
                                              argv
                                              (argv-file-idx argc argv 2)
                                              ""))
                            (build-cmd a
                                       argc
                                       argv
                                       build-fn
                                       emitir-fn
                                       default-backend)))
                  ; `check <file>`: typecheck/compile through mono, emit NO object. Exit 0 on a
                  ; clean compile, 1 with a located diagnostic on failure. (diag-12)
                  (= sub "check")
                    (let [fidx (argv-file-idx argc argv 2)
                          ; As `build` does: a misspelled flag is an error, not a
                          ; silently different check.
                          _rej
                            (argv-reject-unknown (argv-option-count argc argv)
                                                 argv
                                                 2
                                                 fidx)]
                      (if (= fidx 0)
                          (project-check-cmd a argc argv)
                          (do
                            (reader-invocation-set! a argc argv fidx)
                            ; `--use`, as `build` accepts it. A project check hands its test
                            ; files --use coil.test-runner plus the manifest's metaprograms this
                            ; way; without the flag they were dropped and every `deftest`
                            ; failed to resolve.
                            (argv-apply-uses! argc argv)
                            ; A project check hands its whole selected test corpus over as extra
                            ; roots of the entry's own program; see project-check-cmd.
                            (argv-apply-test-roots! argc argv)
                            (check-one a
                                       (load (index argv fidx))
                                       (argv-triple argc argv)))))
                  ; `interp <file>`: run through mono, then interpret. main's i64 return is
                  ; the process exit code (returned straight from the big-stack pipeline).
                  (= sub "interp")
                    (let [path (need-file argc argv sub)]
                      (set-target-arch! (argv-triple argc argv))
                      ; hand the program its own argc/argv: argv[0] = the source file, then
                      ; any extra command-line args (everything after `interp <file>`).
                      (set-interp-args (primitive/cast i64
                                                       (primitive/isub (primitive/cast i64
                                                                                       argc)
                                                                       2))
                                       (primitive/cast i64
                                                       (index argv 2)))
                      (run-dump-on-big-stack a
                                             (read-src a path)
                                             (cwd-slice a)
                                             (from-cstr path)
                                             (fnptr-of interp-src-program)))
                  (= sub "dump-read")
                    (let [path (need-file argc argv sub)]
                      (run-dump-on-big-stack a
                                             (read-src a path)
                                             (cwd-slice a)
                                             (from-cstr path)
                                             (fnptr-of dump-read-w)))
                  (= sub "dump-ast")
                    (let [path (need-file argc argv sub)]
                      (run-dump-on-big-stack a
                                             (read-src a
                                                       path)
                                             (cwd-slice a)
                                             (from-cstr path)
                                             (fnptr-of dump-ast-w)))
                  (= sub "dump-load")
                    (let [path (need-file argc argv sub)]
                      (run-dump-on-big-stack a
                                             (read-src a
                                                       path)
                                             (cwd-slice a)
                                             (from-cstr path)
                                             (fnptr-of dump-load-w)))
                  (= sub "expand")
                    (let [path
                            (need-file argc
                                       argv
                                       sub)]
                      (set-target-arch! (argv-triple argc
                                                     argv))
                      (run-dump-on-big-stack a
                                             (read-src a
                                                       path)
                                             (cwd-slice a)
                                             (from-cstr path)
                                             (fnptr-of expand-src-w)))
                  (= sub "dump-expand")
                    (let [path
                            (need-file argc
                                       argv
                                       sub)]
                      (set-target-arch! (argv-triple argc
                                                     argv))
                      (run-dump-on-big-stack a
                                             (read-src a
                                                       path)
                                             (cwd-slice a)
                                             (from-cstr path)
                                             (fnptr-of dump-expand-w)))
                  (= sub "dump-hygiene")
                    (let [path (need-file argc argv sub)]
                      (set-target-arch! (argv-triple argc argv))
                      (run-dump-on-big-stack a
                                             (read-src a path)
                                             (cwd-slice a)
                                             (from-cstr path)
                                             (fnptr-of dump-hygiene-w)))
                  (= sub "dump-resolved")
                    (let [path
                            (need-file argc
                                       argv
                                       sub)]
                      ; Apply --target like dump-expand does. Without this the flag is parsed
                      ; and dropped: `target-os-str` sees an unset cell and falls back to the
                      ; HOST probe, so `(target-os)`-selected code (coil.os's errno accessor,
                      ; reached from io.coil by every staged printer) followed whoever ran the
                      ; dump. That made these frontend stages host-dependent, which is exactly
                      ; what they claim not to be.
                      (set-target-arch! (argv-triple argc
                                                     argv))
                      (run-dump-on-big-stack a
                                             (read-src a
                                                       path)
                                             (cwd-slice a)
                                             (from-cstr path)
                                             (fnptr-of dump-resolved-w)))
                  (= sub "dump-checked")
                    (let [path
                            (need-file argc
                                       argv
                                       sub)]
                      ; Apply --target like dump-expand does. Without this the flag is parsed
                      ; and dropped: `target-os-str` sees an unset cell and falls back to the
                      ; HOST probe, so `(target-os)`-selected code (coil.os's errno accessor,
                      ; reached from io.coil by every staged printer) followed whoever ran the
                      ; dump. That made these frontend stages host-dependent, which is exactly
                      ; what they claim not to be.
                      (set-target-arch! (argv-triple argc
                                                     argv))
                      (run-dump-on-big-stack a
                                             (read-src a
                                                       path)
                                             (cwd-slice a)
                                             (from-cstr path)
                                             (fnptr-of dump-checked-w)))
                  (= sub "dump-mono")
                    (let [path
                            (need-file argc
                                       argv
                                       sub)]
                      ; Apply --target like dump-expand does. Without this the flag is parsed
                      ; and dropped: `target-os-str` sees an unset cell and falls back to the
                      ; HOST probe, so `(target-os)`-selected code (coil.os's errno accessor,
                      ; reached from io.coil by every staged printer) followed whoever ran the
                      ; dump. That made these frontend stages host-dependent, which is exactly
                      ; what they claim not to be.
                      (set-target-arch! (argv-triple argc
                                                     argv))
                      (run-dump-on-big-stack a
                                             (read-src a
                                                       path)
                                             (cwd-slice a)
                                             (from-cstr path)
                                             (fnptr-of dump-mono-w)))
                  ; fallthrough = emit-ir / dump-ir. Anything else is a typo, not an
                  ; alias for emit-ir — report it instead of compiling argv[2] (NULL).
                  (not (or (= sub "emit-ir")
                           (= sub "dump-ir")))
                    (do
                      (ps (stderr)
                          "coil: unknown command '")
                      (ps (stderr)
                          sub)
                      (ps (stderr)
                          "'\n\n")
                      (ps (stderr)
                          (usage-text))
                      1)
                  :else
                    (let [path
                            (need-file argc
                                       argv
                                       sub)
                          (mut ctx) (zeroed DumpCtx)
                          (mut trip)
                            (primitive/cast (ptr i8)
                                            0)
                          (mut i) 2]
                      ; Options may precede the source file. Scan from argv[2],
                      ; as need-file does, so --target and --use apply in either order.
                      (loop (if (>= (load i)
                                    (primitive/cast i64
                                                    argc))
                                (break)
                                (if (and (< (primitive/iadd (load i)
                                                            1)
                                            (primitive/cast i64
                                                            argc))
                                         (= (from-cstr (load (index argv
                                                                    (load i))))
                                            "--target"))
                                    (do
                                      (set! trip
                                            (load (index argv
                                                         (primitive/iadd (load i)
                                                                         1))))
                                      (set! i
                                            (primitive/iadd (load i)
                                                            2))
                                      0)
                                    ; `--use`, as `build` accepts it. Without this the flag
                                    ; parsed as an unknown argument and was skipped, so
                                    ; emit-ir --use coil.test-runner produced IR for a file of
                                    ; tests with NO `main` — the transform that synthesizes
                                    ; one is registered by loading the module, and the
                                    ; module was never loaded. `coil fuzz` builds through
                                    ; this path, so the omission made it emit a program
                                    ; that could not link.
                                    (if (= (from-cstr (load (index argv
                                                                   (load i))))
                                           "--use")
                                        (do
                                          (when (>= (primitive/iadd (load i) 1)
                                                    (primitive/cast i64 argc))
                                            (ps (stderr)
                                                "error: --use needs a namespace\n")
                                            (exit 2)
                                            0)
                                          (cli-use-add (from-cstr (load (index argv
                                                                               (primitive/iadd (load i)
                                                                                               1)))))
                                          (set! i (primitive/iadd (load i) 2))
                                          0)
                                        (do
                                          (set! i
                                                (primitive/iadd (load i)
                                                                1))
                                          0)))))
                      (set! (.a ctx)
                            a)
                      (set! (.src ctx)
                            (read-src a
                                      path))
                      (set! (.cwd ctx)
                            (cwd-slice a))
                      (set! (.path ctx)
                            (from-cstr path))
                      (set! (.mode ctx)
                            0)
                      (set! (.obj ctx)
                            (primitive/cast (ptr i8)
                                            0))
                      (set! (.triple ctx)
                            (load trip))
                      (set! (.self ctx)
                            (from-cstr (load (index argv 0))))
                      (set-target-arch! (load trip))
                      (set! (.ok ctx)
                            0)
                      (set! (.build-fn ctx)
                            build-fn)
                      (set! (.emitir-fn ctx)
                            emitir-fn)
                      ; emit-ir: exit FAILURE (1) if the pipeline reported a diagnostic,
                      ; `report(emit_ir(...))` returning ExitCode::FAILURE.
                      (when (= (run-on-big-stack (mut ctx))
                               0)
                        1)))]
      (compilation-unit-leave! command-scope)
      (close! (mut root-arena))
      command-result)))

;;; ---- what an edit changed ---------------------------------------------------
;;; A definition is stale when something it observed while it was checked no
;;; longer holds: a callee's interface, a type's layout, a constant's value, a
;;; macro's expansion, a generic's body, what an alias names, or that a name exists
;;; at all. The readers recorded in `DepBase` say who observed a name; these say
;;; whether the observation changed. Some changes carry on: a struct holding a
;;; changed type by value has a new layout itself, a function returning one by
;;; value has a new interface, a constant computed from a changed constant has a
;;; new value. Those are followed to a fixpoint, so a reader two steps away from
;;; the edit (`(.x (.p q))` through `Q`'s field `p`) is found.

;;; ---- compiler states as values --------------------------------------------------
;;; A published state is never written again, so it can be held, built on any number of times, and released in any order, with no
;;; notion of which one is "current". These operations are that, for checked-only
;;; sessions: a client that wants to know whether an edit still type checks, or to
;;; compare two edits of one base, needs nothing else from the compiler.
