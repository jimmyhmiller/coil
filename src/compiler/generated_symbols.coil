(module coil.compiler.generated_symbols)
(import "coil.primitive" :as p)
(import "coil.alloc" :use *)
(import "coil.arraylist" :use *)
(import "coil.hashmap" :as hm)
(import "coil.str" :use *)
(import "coil.slice" :use *)
(import "coil.result" :use *)
(import "coil.reader" :use [Diag])
(import "coil.compiler.parser" :use [derr sconcat sconcat3])

;; One ownership directory is shared by all generated source units.
;; Signatures are validated by their respective concrete interface adapters;
;; linkage ownership must never be duplicated in a backend-specific registry.
(defstruct SymbolOwners
  [(a (dyn Allocator)) (owners (hm/HashMap (slice u8) (slice u8)))])

(defn owners-new [(a (dyn Allocator))] (-> (ptr SymbolOwners))
  (box! a SymbolOwners (SymbolOwners :a a
    :owners (hm/hm-new [(slice u8) (slice u8)] a (str-keyops)))))

(defn owner-of [(owners (ptr SymbolOwners)) (symbol (slice u8))] (-> (Option (slice u8)))
  (hm/hm-get (.owners owners) symbol))

;; Preflight the whole claim before mutation. A failed batch cannot reserve the
;; prefix of its symbols and interfere with a later accepted/retried unit.
(defn owners-claim! [(owners (ptr SymbolOwners)) (module (slice u8))
                      (symbols (ptr (ArrayList (slice u8))))] (-> (Result i64 Diag))
  (block :claim
    (for [i 0 (len (load symbols))]
      (let [symbol (get (load symbols) i)]
        (match (owner-of owners symbol)
          (Some [prior]
            (unless (= prior module)
              (return-from :claim (Err [i64 Diag]
                (derr (sconcat3 (.a owners) "interface symbol '" symbol
                  (sconcat3 (.a owners) "' already has a different generated-module owner: '" prior "'")))))) 0)
          (None [] 0))) 0)
    (for [i 0 (len (load symbols))]
      (let [symbol (get (load symbols) i)]
        (match (owner-of owners symbol)
          (Some [_] 0)
          (None [] (hm/hm-put! (mut (.owners owners)) symbol (sconcat (.a owners) module ""))))) 0)
    (Ok [i64 Diag] 0)))

(defn owners-release! [(owners (ptr SymbolOwners)) (module (slice u8))
                        (symbols (ptr (ArrayList (slice u8))))] (-> i64)
  (for [i 0 (len (load symbols))]
    (let [symbol (get (load symbols) i)]
      (match (owner-of owners symbol)
        (Some [prior]
          (when (= prior module) (hm/hm-remove! (mut (.owners owners)) symbol) 0))
        (None [] 0))) 0) 0)
