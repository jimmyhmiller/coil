; src/compiler/expander.coil — self-host Coil compiler, expander module.
(module expander)
(import "coil.primitive" :as primitive)

(import "coil.alloc" :as alloc :use *)
(import "coil.result" :use *)
(import "coil.slice" :use *)
(import "coil.str" :use *)
(import "coil.arraylist" :use *)
(import "coil.io" :use *)
(import "coil.control" :use *)
(import "coil.try" :use *)
(import "ast" :use *)
(import "mtrace" :use *)
(import "ctval" :use *)  ; CtVal / EnvBind / CtCtx (was reached via comptime.coil)
(import "astdump" :use *)
(import "check" :use *)
(import "comptime" :use *)
(import "diag" :use *)
(import "loader" :use *)
(import "parser" :use *)
(import "coil.reader" :use *)
(import "resolve" :use *)
(import "metaengine" :use *)
(import "coil.hashmap" :use *)  ; the macro-name index (macros-has?)
(import "coil.scratch" :as scratch)
(import "trace" :as tr)

(defn defn-name-of [(f (ptr Sexp))] (-> (Option (slice u8)))
  (if (!= (sx-tag (load f)) (primitive/cast i64 6))
      (None [(slice u8)])
      (let [it (sx-items (load f))]
        (if (< (sx-len it) (primitive/cast i64 2))
            (None [(slice u8)])
            (if (and (= (sx-tag (sx-at it 0)) (primitive/cast i64 2))
                     (and (= (sx-sval (sx-at it 0)) "defn") (= (sx-tag (sx-at it 1)) (primitive/cast i64 2))))
                (Some (sx-sval (sx-at it 1)))
                (None [(slice u8)]))))))
(defn qualify-name [(a (ptr Allocator)) (n (slice u8)) (m (Option (slice u8)))] (-> (slice u8))
  (match m (Some [md] (sconcat3 a md "." n)) (None [] n)))

;; Push the method names a `(deftrait Name [Self] (m [params] ret) …)` declares.
;;
;; They belong in `module_fns` for exactly the reason `defn` names do: that list is
;; what referential hygiene consults, and a name missing from it is left BARE in a
;; macro template — so it binds wherever the expansion lands rather than where the
;; macro was written.
;;
;; Trait methods were omitted, so every operator (`=`, `<`, `+`, …) escaped hygiene
;; and could be captured by the caller. `coil.assert` was the casualty: `assert-eq`
;; expands to `(if (= x y) …)`, and in a module defining its own `=` that became the
;; CALLER's `=`, so `(assert-eq 1 999)` passed and the suite reported green while
;; asserting nothing. docs/design/TRAIT_METHOD_HYGIENE.md has the analysis;
;; tests/compiler/hygiene/ has the reproductions and two controls.
;;
;; This decides only WHICH NAME a template means — a property of where the code was
;; written, which is what lexical scope requires. It does not touch WHICH IMPL runs:
;; the checker still selects that from the argument's type, so `(= my-point other)`
;; keeps finding `impl Eq Point`.
(defn trait-method-names-into! [(f (ptr Sexp))
                                (out (ptr SBox))
                                (m (Option (slice u8)))
                                (a (ptr Allocator))] (-> i64)
  (when (= (sx-tag (load f)) (primitive/cast i64 6))
    (let [it (sx-items (load f))]
      (when (and (>= (sx-len it) (primitive/cast i64 3))
                 (and (= (sx-tag (sx-at it 0)) (primitive/cast i64 2))
                      (= (sx-sval (sx-at it 0)) "deftrait")))
        ; `(deftrait Name [Self …] :requires […] (method [params] (-> ret)) …)`.
        ; A method is a trailing LIST whose head is a symbol; the type-parameter
        ; vector and any keyword arguments fail that shape test on their own.
        (let [n (sx-len it)
              (mut i) 2]
          (loop (if (>= (load i) n)
                    (break)
                    (do
                      (let [e (sx-at it (load i))]
                        (when (and (= (sx-tag e) (primitive/cast i64 6))
                                   (> (sx-len (sx-items e)) (primitive/cast i64 0)))
                          (let [h (sx-at (sx-items e) 0)]
                            (when (= (sx-tag h) (primitive/cast i64 2))
                              (al-push! (mut (field out items))
                                        (qualify-name a (sx-sval h) m))
                              0))
                          0))
                      (store! i (primitive/iadd (load i) 1)))))))
      0))
  0)
(defn is-comptime-defn [(f (ptr Sexp))
                        (module (Option (slice u8)))
                        (comptime (ptr (ArrayList (slice u8))))
                        (a (ptr Allocator))] (-> bool)
  (match (defn-name-of f)
    (None [] false)
    (Some [n] (set-contains comptime (qualify-name a n module)))))
; ── the macro-name index ─────────────────────────────────────────────────────
; `resolve-macro` asks "is this head a macro?" for EVERY list head in the program, and
; answered it by scanning every macro name in the program with `str-eq` — O(heads ×
; macros), the same quadratic shape `resolve` had for definition names. Index the set.
;
; Two guards keep it honest. It records the list's ADDRESS and LENGTH and rebuilds if
; either differs, which covers a second list being asked about mid-run. And it is
; INVALIDATED at the top of every `run-expand`, which covers the one a pointer test
; cannot see: the allocator handing a fresh list the address of a dead one. A stale hit
; here would treat an ordinary call as a macro, so neither guard is optional.
(defstruct MacIdx
  [(src (ptr (ArrayList (slice u8)))) (len i64) (built i64) (m (HashMap (slice u8) i64))])
(defn mac-idx [] (-> (ptr MacIdx))
  (alloc/static MacIdx))
(defn macros-index-reset! [] (-> i64)
  (mac-memo-reset!)
  (let [ix (mac-idx)]
    (set! (.built ix) 0)
    (set! (.src ix) (primitive/cast (ptr (ArrayList (slice u8))) 0))
    (set! (.len ix) -1)
    0))
(defn macros-index-build! [(ix (ptr MacIdx)) (lst (ptr (ArrayList (slice u8))))] (-> i64)
  (let [a (malloc-allocator)
        n (al-len [(slice u8)] (load lst))
        (mut i) 0]
    (set! (.m ix) (hm-new [(slice u8) i64] a (str-keyops)))
    (loop (if (>= (load i) n)
              (break)
              (do
                (hm-put! [(slice u8) i64]
                         (mut (.m ix))
                         (al-get [(slice u8)] (load lst) (load i))
                         (load i))
                (set! i (primitive/iadd (load i) 1)))))
    (set! (.src ix) lst)
    (set! (.len ix) n)
    (set! (.built ix) 1)
    0))
(defn macros-has? [(macros (ptr (ArrayList (slice u8)))) (q (slice u8))] (-> bool)
  (let [ix (mac-idx)]
    (if (= (primitive/cast i64 macros) (primitive/cast i64 0))
        false
        (do
          (when (or (= (load (field ix built)) (primitive/cast i64 0))
                    (or (!= (primitive/cast i64 (load (field ix src))) (primitive/cast i64 macros))
                        (!= (load (field ix len)) (al-len [(slice u8)] (load macros)))))
            (macros-index-build! ix macros))
          (match (hm-get [(slice u8) i64] (.m ix) q)
            (Some [_] true)
            (None [] false))))))

(defn macro-exported [(impb (ptr (ArrayList ImpEntry)))
                      (macros (ptr (ArrayList (slice u8))))
                      (expb (ptr (ArrayList ExpEntry)))
                      (module (slice u8))
                      (name (slice u8))
                      (a (ptr Allocator))
                      (depth i64)] (-> (Option (slice u8)))
  (if (or (>= depth (primitive/cast i64 64))
          (not (exports-check expb module name)))
      (None [(slice u8)])
      (let [q (sconcat3 a module "." name)]
        (if (macros-has? macros q)
            (Some q)
            (let [ie (imports-find impb module)]
              (if (= (primitive/cast i64 ie) (primitive/cast i64 0))
                  (None [(slice u8)])
                  (let [rs (field (field ie imp) reexports)
                        n (al-len [(slice u8)] (load rs))
                        (mut i) 0
                        (mut out) (None [(slice u8)])]
                    (loop (if (>= (load i) n)
                              (break)
                              (match (macro-exported impb
                                                     macros
                                                     expb
                                                     (al-get [(slice u8)] (load rs) (load i))
                                                     name
                                                     a
                                                     (primitive/iadd depth 1))
                                (Some [hit] (do (set! out (Some hit)) (break)))
                                (None [] (set! i (primitive/iadd (load i) 1))))))
                    (load out))))))))

(defn macro-use-match [(impb (ptr (ArrayList ImpEntry)))
                       (impe (ptr ImpEntry))
                       (macros (ptr (ArrayList (slice u8))))
                       (expb (ptr (ArrayList ExpEntry)))
                       (head (slice u8))
                       (a (ptr Allocator))] (-> (Option (slice u8)))
  (let [uses (field (field impe imp) uses)
        n (al-len [Use] (load uses))
        (mut i) 0
        (mut r) (None [(slice u8)])]
    (loop (if (>= (load i) n)
              (break)
              (do
                (let [up (alloc/stack Use)]
                  (set! up (al-get [Use] (load uses) (load i)))
                  (let [target (.target up)]
                    (match (use-refers up head)
                      (None [] 0)
                      (Some [exported]
                            (match (macro-exported impb macros expb target exported a 0)
                              (Some [hit] (do (set! r (Some hit)) (break)))
                              (None [] 0))))))
                (set! i (primitive/iadd (load i) 1)))))
    (load r)))
(defn macro-reexport-match [(core (ptr ImpEntry))
                            (macros (ptr (ArrayList (slice u8))))
                            (expb (ptr (ArrayList ExpEntry)))
                            (head (slice u8))
                            (a (ptr Allocator))] (-> (Option (slice u8)))
  (let [res (field (field core imp) reexports)
        n (al-len [(slice u8)] (load res))
        (mut i) 0
        (mut r) (None [(slice u8)])]
    (loop (if (>= (load i) n)
              (break)
              (do
                (let [target (al-get [(slice u8)] (load res) (load i))
                      q (sconcat3 a target "." head)]
                  (when (and (exports-check expb target head) (macros-has? macros q))
                    (store! r (Some q))
                    (break)))
                (set! i (primitive/iadd (load i) 1)))))
    (load r)))
; ── the macro-resolution memo ────────────────────────────────────────────────
; `expand-calls-list` asks `resolve-macro` about EVERY list head in the program, and the
; answer costs an allocation before it can even be looked up: the bare-name path builds
; `module.head` with sconcat3, then hashes and compares it. Heads repeat constantly
; (`if`, `let`, `do`, `store!`…), and for one module the answer is a pure function of the
; head — the macro set, imports and exports are all fixed for the duration of a run.
;
; So it is memoised per module, keyed on the head alone, which removes the concatenation
; entirely and leaves one hash of a short string. "" encodes "not a macro", so negative
; answers — the overwhelming majority — are cached too. The memo is dropped when the
; module changes and, with the macro index, at the top of every `run-expand`.
(defstruct MacMemo [(mod (slice u8)) (valid i64) (m (HashMap (slice u8) (slice u8)))])
(defn mac-memo [] (-> (ptr MacMemo))
  (alloc/static MacMemo))
(defn mac-memo-reset! [] (-> i64)
  (set! (.valid (mac-memo)) 0)
  0)
(defn resolve-macro [(head (slice u8))
                     (module (Option (slice u8)))
                     (macros (ptr (ArrayList (slice u8))))
                     (impb (ptr (ArrayList ImpEntry)))
                     (expb (ptr (ArrayList ExpEntry)))
                     (a (ptr Allocator))] (-> (Option (slice u8)))
  (let [mk (match module (Some [m] m) (None [] ""))
        mm (mac-memo)]
    (when (or (= (load (field mm valid)) (primitive/cast i64 0))
              (not (= (load (field mm mod)) mk)))
      (store! (field mm m) (hm-new [(slice u8) (slice u8)] (malloc-allocator) (str-keyops)))
      (store! (field mm mod) mk)
      (store! (field mm valid) 1))
    (match (hm-get [(slice u8) (slice u8)] (.m mm) head)
      (Some [hit] (if (= (slice-len [u8] hit) (primitive/cast i64 0)) (None [(slice u8)]) (Some hit)))
      (None []
            (let [r (resolve-macro-uncached head module macros impb expb a)]
              (hm-put! [(slice u8) (slice u8)]
                       (mut (.m mm))
                       head
                       (match r (Some [q] q) (None [] "")))
              r)))))

(defn resolve-macro-uncached [(head (slice u8))
                              (module (Option (slice u8)))
                              (macros (ptr (ArrayList (slice u8))))
                              (impb (ptr (ArrayList ImpEntry)))
                              (expb (ptr (ArrayList ExpEntry)))
                              (a (ptr Allocator))] (-> (Option (slice u8)))
  (let [sl (find-slash head)]
    (if (>= sl (primitive/cast i64 0))
        ; alias/name
        (let [alias (subslice head 0 sl)
              rest (subslice head (primitive/iadd sl 1) (slice-len head))]
          (match module
            (None [] (None [(slice u8)]))
            (Some [m]
                  (let [impe (imports-find impb m)]
                    (if (= (primitive/cast i64 impe) (primitive/cast i64 0))
                        (None [(slice u8)])
                        (match (alias-target impe alias)
                          (None [] (None [(slice u8)]))
                          (Some [target]
                                (macro-exported impb macros expb target rest a 0))))))))
        ; A leading dot is part of a bare syntax name (`..`, or a reserved
        ; `.field` accessor), not evidence that the head is module-qualified.
        (if (and (has-dot head)
                 (not (= (primitive/cast i64 (slice-get head 0)) (primitive/cast i64 46))))
            (if (macros-has? macros head) (Some head) (None [(slice u8)]))
            ; bare
            (let [own (qualify-name a head module)]
              (if (macros-has? macros own)
                  (Some own)
                  (let [mname (match module (Some [m] m) (None [] ""))
                        impe (imports-find impb mname)
                        r1
                          (if (= (primitive/cast i64 impe) (primitive/cast i64 0))
                              (None [(slice u8)])
                              (macro-use-match impb impe macros expb head a))]
                    (match r1
                      (Some [q] (Some q))
                      (None []
                            (if (= mname "coil.core")
                                (None [(slice u8)])
                                ; core is the last tier here too, and under the same refer
                                ; rules as any `:use` — so `(import "coil.core" :use [])`
                                ; takes `when`/`for`/`cond` out of scope as macros, not just
                                ; as names.
                                (match (core-refers impe head)
                                  (None [] (None [(slice u8)]))
                                  (Some [exported]
                                        (let [core (imports-find impb "coil.core")]
                                          (if (= (primitive/cast i64 core) (primitive/cast i64 0))
                                              (None [(slice u8)])
                                              ; Direct definitions in coil.core are ambient too,
                                              ; not only names it reexports from imported modules.
                                              ; This lets core own macros such as `cond` itself.
                                              (macro-exported impb macros expb "coil.core" exported a 0)))))))))))))))
; Positive hygiene scopes carry their definition module independently of source
; spans. An empty module denotes a fresh lexical identifier, which cannot name a
; macro by spelling. Unscoped source/use-site syntax resolves in the current module.
(defn macro-module-of [(head Sexp) (fallback (Option (slice u8)))] (-> (Option (slice u8)))
  (if (> (sx-hyg head) (primitive/cast i64 0))
      (let [m (sx-hmod head)]
        (if (= (slice-len [u8] m) (primitive/cast i64 0))
            (None [(slice u8)])
            (Some m)))
      fallback))
; Tag every macro-synthesized (dummy-span) node with the expansion `ctxt`, located
; at the call site. Non-dummy nodes (template literals, ~unquote-spliced caller
; code) keep their own span. Faithful.
(defn stamp-expansion [(s (ptr Sexp)) (source i64) (lo i64) (hi i64) (ctxt i64)] (-> i64)
  (when (< (sx-lo (load s)) (primitive/cast i64 0))
    (store! (field s source) source)
    (store! (field s lo) lo)
    (store! (field s hi) hi)
    (store! (field s ctxt) ctxt)
    0)
  (let [tg (sx-tag (load s))]
    (when (or (= tg (primitive/cast i64 6)) (= tg (primitive/cast i64 7)))
      (let [items (sx-items (load s))
            n (sx-len items)
            (mut i) 0]
        (loop (if (>= (load i) n)
                  (break)
                  (do
                    (stamp-expansion (al-elem [Sexp] items (load i)) source lo hi ctxt)
                    (store! i (primitive/iadd (load i) 1))))))))
  0)
; Find a function by name in `p` (for a macro's def-site span). Null if absent.
(defn find-func-ptr [(p (ptr Program)) (name (slice u8))] (-> (ptr Func))
  (let [fs (load (field p funcs))
        n (al-len [Func] (load fs))
        (mut i) 0
        (mut r) (primitive/cast (ptr Func) 0)]
    (loop (if (>= (load i) n)
              (break)
              (do
                (when (= (func-name (al-get [Func] (load fs) (load i))) name)
                  (store! r (al-elem [Func] fs (load i)))
                  (break))
                (set! i (primitive/iadd (load i) 1)))))
    (load r)))
(defn mk-expansion [(name (slice u8))
                    (cs i64)
                    (cl i64)
                    (ch i64)
                    (cc i64)
                    (ds i64)
                    (dl i64)
                    (dh i64)
                    (dc i64)
                    (parent i64)] (-> Expansion)
  (let [p (alloc/stack Expansion)]
    (set! (.macro_name p) name)
    (set! (.call_source p) cs)
    (set! (.call_lo p) cl)
    (set! (.call_hi p) ch)
    (set! (.call_ctxt p) cc)
    (set! (.def_source p) ds)
    (set! (.def_lo p) dl)
    (set! (.def_hi p) dh)
    (set! (.def_ctxt p) dc)
    (set! (.parent p) parent)
    (load p)))
(defn merge-structs-gen [(sub (ptr Program)) (gen (ptr (ArrayList StructDef))) (a (ptr Allocator))] (-> (ptr (ArrayList StructDef)))
  (let [base (load (field sub structs))
        nb (al-len [StructDef] (load base))
        (mut out) (al-new [StructDef] a)
        (mut i) 0]
    (loop (if (>= (load i) nb)
              (break)
              (do
                (al-push! (mut out) (al-get [StructDef] (load base) (load i)))
                (set! i (primitive/iadd (load i) 1)))))
    (let [ng (al-len [StructDef] (load gen))
          (mut j) 0]
      (loop (if (>= (load j) ng)
                (break)
                (do
                  (let [g (al-elem [StructDef] gen (load j))
                        gname (.name g)
                        (mut found) false
                        (mut k) 0]
                    (loop (if (>= (load k) nb)
                              (break)
                              (do
                                (when (= (load (field (al-elem [StructDef]
                                                               base
                                                               (load k))
                                                      name))
                                         gname)
                                  (store! found true)
                                  (break))
                                (set! k (primitive/iadd (load k) 1)))))
                    (unless (load found) (al-push! (mut out) (load g)) 0))
                  (set! j (primitive/iadd (load j) 1))))))
    (box-al [StructDef] a (load out))))
(defn merge-sums-gen [(sub (ptr Program)) (gen (ptr (ArrayList SumDef))) (a (ptr Allocator))] (-> (ptr (ArrayList SumDef)))
  (let [base (load (field sub sums))
        nb (al-len [SumDef] (load base))
        (mut out) (al-new [SumDef] a)
        (mut i) 0]
    (loop (if (>= (load i) nb)
              (break)
              (do
                (al-push! (mut out) (al-get [SumDef] (load base) (load i)))
                (set! i (primitive/iadd (load i) 1)))))
    (let [ng (al-len [SumDef] (load gen))
          (mut j) 0]
      (loop (if (>= (load j) ng)
                (break)
                (do
                  (let [g (al-elem [SumDef] gen (load j))
                        gname (.name g)
                        (mut found) false
                        (mut k) 0]
                    (loop (if (>= (load k) nb)
                              (break)
                              (do
                                (when (= (load (field (al-elem [SumDef]
                                                               base
                                                               (load k))
                                                      name))
                                         gname)
                                  (store! found true)
                                  (break))
                                (set! k (primitive/iadd (load k) 1)))))
                    (unless (load found) (al-push! (mut out) (load g)) 0))
                  (set! j (primitive/iadd (load j) 1))))))
    (box-al [SumDef] a (load out))))
(defn all-variant-names [(sums (ptr (ArrayList SumDef))) (a (ptr Allocator))] (-> (ptr (ArrayList (slice u8))))
  (let [n (al-len [SumDef] (load sums))
        (mut out) (al-new [(slice u8)] a)
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (let [vs (load (field (al-elem [SumDef] sums (load i)) variants))
                      nv (al-len [Variant] (load vs))
                      (mut j) 0]
                  (loop (if (>= (load j) nv)
                            (break)
                            (do
                              (al-push! (mut out)
                                        (.name (al-elem [Variant] vs (load j))))
                              (set! j (primitive/iadd (load j) 1))))))
                (set! i (primitive/iadd (load i) 1)))))
    (box-al [(slice u8)] a (load out))))
(defn module-of [(name (slice u8))] (-> (Option (slice u8)))
  (let [n (slice-len name)
        (mut i) (primitive/isub n 1)
        (mut at) -1]
    (loop (if (< (load i) (primitive/cast i64 0))
              (break)
              (do
                (when (and (< (load at) (primitive/cast i64 0))
                           (= (primitive/cast i64 (slice-get name (load i))) (primitive/cast i64 46)))
                  (store! at (load i)))
                (set! i (primitive/isub (load i) 1)))))
    (if (< (load at) (primitive/cast i64 0)) (None [(slice u8)]) (Some (subslice name 0 (load at))))))
; Anything escaping a macro invocation WITHOUT a span of its own gets the macro call
; site stamped on it. `error` — the diagnostic the whole stdlib uses (derive, match) —
; takes only a message and so can never carry a span; the same went for macro arity
; errors, while the byte-identical error for an ordinary function is perfectly located.
; `report` DOES take a node and produces a better span, so a located diag is left alone
; (derr builds lo = -1; that is the "unlocated" marker).
(defn stamp-call-site [(d Diag) (node Sexp)] (-> Diag)
  (if (>= (.lo d) (primitive/cast i64 0))
      d
      (dwspan d (sx-source node) (sx-lo node) (sx-hi node) (sx-ctxt node))))

;; ── the expansion arena (docs/design/META_MEMORY.md phase 3) ──────────────────
;; COIL_META_ARENA=1: every metaprogram invocation runs against its own scratch
;; arena — the engine context's allocator IS that arena, for the interpreter ops
;; and the native mh-* callbacks alike — and exactly one value survives it: the
;; returned Code, deep-copied out (structure AND string payloads) before the
;; arena's segments are released. Peak memory becomes the expansion's working
;; set, not its allocation history. =poison additionally fills the segments with
;; 0xDD before release, so a missed alias fails loudly instead of heisenbug-ly.
;;
;; Staging is NOT inside the arena: stage-one-macro! allocates from the global
;; stage-box, so engine entries and the quote registry keep their own lifetime.
;; Warnings/reports/fixes recorded from inside an expansion are owned at their
;; sinks (ct-own-str / ct-own-sexp in comptime.coil).
(defstruct EmArenaMode [(v i64) (init i64)])
(defn em-arena-mode-box [] (-> (ptr EmArenaMode)) (alloc/static EmArenaMode))
(defn em-arena-mode [] (-> i64)
  ; DEFAULT ON (docs/design/META_MEMORY.md phase 6): every expansion runs in
  ; its own arena and one value survives it. COIL_META_ARENA=0 opts out (the
  ; escape hatch while the default bakes); =poison fills segments with 0xDD on
  ; release so a missed alias fails loudly.
  (let [b (em-arena-mode-box)]
    (when (= (load (field b init)) (primitive/cast i64 0))
      (store! (field b init) 1)
      (let [v (getenv c"COIL_META_ARENA")]
        (store! (field b v)
                (if (= (primitive/cast i64 v) 0)
                    1
                    (let [s (mt--cstr v)]
                      (cond (= s "0") 0
                            (= s "off") 0
                            (= s "poison") 2
                            :else 1)))))
      0)
    (.v b)))

(defn em-poison-arena! [(ar (ptr scratch/ScratchArena))] (-> i64)
  (let [(mut seg) (load (field ar current))]
    (loop (if (= (primitive/cast i64 (load seg)) (primitive/cast i64 0))
              (break)
              (do
                (let [d (load (field (load seg) data))
                      n (.off (load seg))
                      (mut i) 0]
                  (loop (if (>= (load i) n)
                            (break)
                            (do (set! (primitive/index d (load i)) (primitive/cast i8 221))
                                (set! i (primitive/iadd (load i) 1))))))
                (set! seg (load (field (load seg) previous))))))
    0))

;; Per-metaprogram memory attribution (COIL_MTRACE=mem): without the arena,
;; difference the root arena's monotonic byte counter across the invocation —
;; the delta includes nested expansions, the cost this metaprogram CAUSES. With
;; the arena, the arena's own total is exact per invocation.
(defn expand-macro [(sub (ptr Program))
                    (fn-name (slice u8))
                    (margs (ptr (ArrayList Sexp)))
                    (allfns (ptr (ArrayList (slice u8))))
                    (genstructs (ptr (ArrayList StructDef)))
                    (gensums (ptr (ArrayList SumDef)))
                    (impb (ptr (ArrayList ImpEntry)))
                    (expb (ptr (ArrayList ExpEntry)))
                    (a (ptr Allocator))] (-> (Result Sexp Diag))
  (if (= (em-arena-mode) (primitive/cast i64 0))
      (if (not (mtrace-mem?))
          (expand-macro-run sub fn-name margs allfns genstructs gensums impb expb a)
          (let [before (mtrace-mem-now)
                r (expand-macro-run sub fn-name margs allfns genstructs gensums impb expb a)]
            (mtrace-mem-record! fn-name (primitive/isub (mtrace-mem-now) before))
            r))
      (let [ar (alloc/stack scratch/ScratchArena)
            _init (scratch/scratch-init-with-cap ar (malloc-allocator) 262144)
            aa (scratch/scratch-allocator ar)
            r (expand-macro-run sub fn-name margs allfns genstructs gensums impb expb aa)
            out (match r
                  (Ok [sx]
                      (let [sp (alloc/stack Sexp)]
                        (set! sp sx)
                        (Ok [Sexp Diag] (ct-own-sexp sp))))
                  (Err [d]
                       (let [dp (alloc/stack Diag)]
                         (set! dp d)
                         (set! (.msg dp) (ct-own-str (.msg dp)))
                         (Err [Sexp Diag] (load dp)))))]
        (when (mtrace-mem?)
          (mtrace-mem-record! fn-name (scratch/scratch-total ar))
          0)
        (when (= (em-arena-mode) (primitive/cast i64 2)) (em-poison-arena! ar) 0)
        (scratch/scratch-close! ar)
        out)))

(defn expand-macro-run [(sub (ptr Program))
                        (fn-name (slice u8))
                        (margs (ptr (ArrayList Sexp)))
                        (allfns (ptr (ArrayList (slice u8))))
                        (genstructs (ptr (ArrayList StructDef)))
                        (gensums (ptr (ArrayList SumDef)))
                        (impb (ptr (ArrayList ImpEntry)))
                        (expb (ptr (ArrayList ExpEntry)))
                        (a (ptr Allocator))] (-> (Result Sexp Diag))
  ;; Record which metaprogram is executing, so a comptime error raised deep in
  ;; the interpreter can name it. Without this the diagnostic points at the
  ;; module's import line and names nothing — see mtrace.coil.
  (mtrace-set-current! fn-name)
  (let [smap (merge-structs-gen sub genstructs a)
        sumap (merge-sums-gen sub gensums a)
        cx (alloc/stack CtCtx)
        callee (prog-fn-find sub fn-name)]
    (set! (.a cx) a)
    (set! (.fns cx) (load (field sub funcs)))
    (set! (.structs cx) smap)
    (set! (.sums cx) sumap)
    (set! (.variants cx) (all-variant-names (load (field sub sums)) a))
    (set! (.traits cx) (load (field sub traits)))
    (set! (.fuel cx) 50000000)
    (set! (.depth cx) 0)
    (set! (.gensym cx) 0)
    (set! (.qmodule cx) (module-of fn-name))
    (set! (.module_fns cx) allfns)
    (set! (.qimports cx)
          (match (module-of fn-name)
            (Some [m]
                  (let [ie (imports-find impb m)]
                    (if (= (primitive/cast i64 ie) (primitive/cast i64 0))
                        (primitive/cast (ptr ModImports) 0)
                        (field ie imp))))
            (None [] (primitive/cast (ptr ModImports) 0))))
    (set! (.qexports cx) expb)
    (set! (.prog cx) (primitive/cast (ptr Program) 0))  ; macro context: no comptime fold here
    (if (= (primitive/cast i64 callee) (primitive/cast i64 0))
        (Err [Sexp Diag] (derr (sconcat3 a "macro '" fn-name "' not found")))
        (let [pparams (load (field callee params))
              np (al-len [Param] (load pparams))
              na (al-len [Sexp] (load margs))
              (mut env) (al-new [EnvBind] a)]
          (if (.macro_variadic callee)
              (if (< na (primitive/isub np 1))
                  (Err [Sexp Diag]
                       (derr (sconcat a
                                      (sconcat a
                                               (sconcat a
                                                        (sconcat3 a "macro '" fn-name "' expects at least ")
                                                        (i64->str a (primitive/isub np 1)))
                                               " args, got ")
                                      (i64->str a na))))
                  (do
                    (let [(mut k) 0]
                      (loop (if (>= (load k) (primitive/isub np 1))
                                (break)
                                (do
                                  (let [eb (alloc/stack EnvBind)]
                                    (set! (.name eb)
                                          (.name (al-elem [Param]
                                                          pparams
                                                          (load k))))
                                    (set! (.val eb) (CCode (al-get [Sexp] (load margs) (load k))))
                                    (al-push! (mut env) (load eb)))
                                  (set! k (primitive/iadd (load k) 1)))))
                      (let [(mut rest) (al-new [Sexp] a)
                            (mut r) (primitive/isub np 1)]
                        (loop (if (>= (load r) na)
                                  (break)
                                  (do
                                    (al-push! (mut rest) (al-get [Sexp] (load margs) (load r)))
                                    (set! r (primitive/iadd (load r) 1)))))
                        (let [eb (alloc/stack EnvBind)]
                          (set! (.name eb)
                                (.name (al-elem [Param]
                                                pparams
                                                (primitive/isub np 1))))
                          (set! (.val eb) (CCode (mk-sexp (KList (box-al [Sexp] a (load rest))) -1 -1)))
                          (al-push! (mut env) (load eb))))
                      (finish-macro callee (box-al [EnvBind] a (load env)) cx a fn-name))))
              (if (!= np na)
                  (Err [Sexp Diag]
                       (derr (sconcat a
                                      (sconcat a
                                               (sconcat a (sconcat3 a "macro '" fn-name "' expects ") (i64->str a np))
                                               " args, got ")
                                      (i64->str a na))))
                  (do
                    (let [(mut k) 0]
                      (loop (if (>= (load k) np)
                                (break)
                                (do
                                  (let [eb (alloc/stack EnvBind)]
                                    (set! (.name eb)
                                          (.name (al-elem [Param]
                                                          pparams
                                                          (load k))))
                                    (set! (.val eb) (CCode (al-get [Sexp] (load margs) (load k))))
                                    (al-push! (mut env) (load eb)))
                                  (set! k (primitive/iadd (load k) 1)))))
                      (finish-macro callee (box-al [EnvBind] a (load env)) cx a fn-name)))))))))
(defn finish-macro [(callee (ptr Func))
                    (env (ptr (ArrayList EnvBind)))
                    (cx (ptr CtCtx))
                    (a (ptr Allocator))
                    (fn-name (slice u8))] (-> (Result Sexp Diag))
  ; The compiled engine is THE macro engine (the tree-walking interpreter is gone —
  ; decision 7). The env (param -> CCode arg, variadic already packed) IS the
  ; argument list. A miss stages this qual on demand (pruned closure -> standalone
  ; check -> additive engine build); a macro that cannot be staged is a hard error.
  ; `callee` stays in the signature for the call sites' sake — the body itself now
  ; lives only in the engine's compiled form.
  (let [e (meta-engine-entry fn-name)]
    (if (!= (primitive/cast i64 e) (primitive/cast i64 0))
        (meta-engine-run-env a e cx env)
        (match (stage-one-macro! fn-name)
          (None []
                (let [e2 (meta-engine-entry fn-name)]
                  (if (!= (primitive/cast i64 e2) (primitive/cast i64 0))
                      (meta-engine-run-env a e2 cx env)
                      (Err [Sexp Diag]
                           (derr (sconcat3 a "macro '" fn-name "' staged but is missing from the engine (compiler bug)"))))))
          ; Report the REASON staging failed, not merely that it did. The inner diagnostic
          ; is about the macro's own pruned closure, so it names the real problem; without
          ; it the user gets an opaque line pointing at an innocent call site in a module
          ; that has nothing to do with the cause.
          (Some [d] (Err [Sexp Diag] (stage-fail-diag a d fn-name)))))))
; The staging failure with its inner reason attached, keeping the inner diagnostic's own
; span when it has one — that span points into the macro's closure, which is where the fix
; is.
(defn stage-fail-diag [(a (ptr Allocator)) (d Diag) (fn-name (slice u8))] (-> Diag)
  (let [dp (alloc/stack Diag)]
    (set! dp d)
    (set! (.msg dp)
          (sconcat a
                   (sconcat3 a "macro '" fn-name "' could not be compiled into the metaprogram engine: ")
                   (.msg dp)))
    (load dp)))
; A macro-BODY error comes back with a dummy span — the code-op derrs (`str-bytes
; expects a string`, `error …`, arity mismatches) carry none, so it renders as a bare
; internal message that names, e.g., `str-bytes`, with no source. Point it at the macro
; CALL SITE `node` and name the calling macro, so it reads as a located `in expansion of
; macro 'X': …` underlined at the call. A diag that ALREADY has a real span (e.g. a
; located `(primitive/report …)`, or a typecheck error on the expanded output) is left untouched.
(defn locate-macro-err [(a (ptr Allocator)) (d Diag) (node (ptr Sexp)) (fn-name (slice u8))] (-> Diag)
  (let [dp (alloc/stack Diag)]
    (set! dp d)
    (if (>= (.lo dp) (primitive/cast i64 0))
        (load dp)
        (do
          (set! (.source dp) (sx-source (load node)))
          (set! (.lo dp) (sx-lo (load node)))
          (set! (.hi dp) (sx-hi (load node)))
          (set! (.ctxt dp) (sx-ctxt (load node)))
          (set! (.msg dp)
                (sconcat a
                         (sconcat3 a "in expansion of macro '" fn-name "': ")
                         (.msg dp)))
          (load dp)))))
(defstruct ExpEnv
  [(macros (ptr (ArrayList (slice u8))))
   (comptime (ptr (ArrayList (slice u8))))
   (sub (ptr Program))
   (impb (ptr (ArrayList ImpEntry)))
   (expb (ptr (ArrayList ExpEntry)))
   ; THE SYNTACTIC ENVIRONMENT: names bound at this point in the walk, innermost
   ; last. Used as a stack — a scope records the length on entry and truncates back
   ; to it on exit, so no allocation per scope and no scope-tree to maintain.
   (bound (ptr (ArrayList (slice u8))))
   (a (ptr Allocator))])

; Is `nm` bound by an enclosing binding form? Scanned from the END so an inner
; binding wins, though for a membership test the direction only affects speed.
(defn benv-bound? [(env (ptr ExpEnv)) (nm (slice u8))] (-> bool)
  (let [xs (load (field env bound))
        (mut i) (al-len [(slice u8)] (load xs))
        (mut found) false]
    (loop (if (or (load found) (<= (load i) (primitive/cast i64 0)))
              (break)
              (do
                (set! i (primitive/isub (load i) 1))
                (when (= (al-get [(slice u8)] (load xs) (load i)) nm) (store! found true) 0))))
    (load found)))
(defn benv-mark [(env (ptr ExpEnv))] (-> i64)
  (al-len [(slice u8)] (load (field env bound))))
(defn benv-push! [(env (ptr ExpEnv)) (nm (slice u8))] (-> i64)
  (al-push! (load (field env bound)) nm)
  0)
(defn benv-reset! [(env (ptr ExpEnv)) (mark i64)] (-> i64)
  (set! (.len (load (field env bound))) mark)
  0)

; The plain symbol a binder position names: `x` -> "x"; `(mut x)` -> "x";
; `(x Type)` (a parameter or field) -> "x"; "" for anything else.
(defn binder-name [(bp Sexp)] (-> (slice u8))
  (let [tg (sx-tag bp)]
    (if (= tg (primitive/cast i64 2))
        (sx-sval bp)
        (if (= tg (primitive/cast i64 6))
            (let [it (sx-items bp)]
              (if (and (>= (sx-len it) (primitive/cast i64 1))
                       (= (sx-tag (sx-at it 0)) (primitive/cast i64 2)))
                  (let [h (sx-sval (sx-at it 0))]
                    (if (and (= h "mut") (>= (sx-len it) (primitive/cast i64 2)))
                        (binder-name (sx-at it 1))
                        h))
                  ""))
            ""))))

; Bind every name a `[…]` binder vector introduces. `kind` 0 = a `let`-shaped vector
; (NAME INIT NAME INIT …), so only even positions bind; 1 = a parameter/field vector,
; where every element binds.
(defn benv-bind-vec! [(env (ptr ExpEnv)) (items (ptr (ArrayList Sexp))) (kind i64)] (-> i64)
  (let [n (sx-len items)
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (when (or (= kind (primitive/cast i64 1))
                          (= (primitive/irem (load i) 2) (primitive/cast i64 0)))
                  (let [nm (binder-name (sx-at items (load i)))]
                    (when (> (slice-len [u8] nm) (primitive/cast i64 0)) (benv-push! env nm) 0))
                  0)
                (set! i (primitive/iadd (load i) 1)))))
    0))
; (include-str is resolved at LOAD time now — see loader.coil expand-includes-in-form.)
; ---- binder positions -------------------------------------------------------
; A parameter, field or payload vector ESTABLISHES names; it is not a call, and
; nothing inside it is. `expand-calls` is a flat walk with no grammar knowledge, so it
; happily looked up element 0 of `(scope (ArrayList i64))` — a FIELD declaration — in
; the global macro table, found coil.control's `scope`, and expanded it. The author
; then got a diagnostic about a form they never wrote:
;
;   (defstruct S [(scope (ArrayList i64))])   ; error: scope: first argument must be a :label
;   (defn f [(scope i64)] (-> i64) scope)     ; same
;   (defsum V (Case [(scope i64)]))           ; same
;
; Real special forms were always fine as binder names, because the PARSER is
; syntax-directed and only treats them specially while parsing an expression. Macros
; had no such protection: every one of the 21 names coil.control re-exports into the
; prelude (`when` `unless` `case` `while` `for` `block` `scope` `defer` `all` `any` …)
; was unusable as a field or parameter name anywhere in the language.
;
; This is the binder half of docs/design/BINDING_AND_SHADOWING.md. The other half —
; a local binding shadowing a macro in HEAD position, `(let [when 5] (when 1 2))` —
; needs a syntactic environment threaded through the walk and is still open.
(defn is-arrow-form [(f (ptr Sexp))] (-> bool)
  (and (= (sx-tag (load f)) (primitive/cast i64 6))
       (let [it (sx-items (load f))]
         (and (>= (sx-len it) (primitive/cast i64 1))
              (and (= (sx-tag (sx-at it 0)) (primitive/cast i64 2))
                   (= (sx-sval (sx-at it 0)) "->"))))))

; Heads whose own children include binder vectors.
(defn def-form-head? [(h (slice u8))] (-> bool)
  (or (= h "defn")
      (or (= h "defstruct")
          (or (= h "defsum") (or (= h "deftrait") (= h "impl"))))))

; Heads whose children are MEMBER forms — `(Variant [payload…])`,
; `(method [params…] (-> R) body…)` — carrying binder vectors one level deeper.
(defn def-member-head? [(h (slice u8))] (-> bool)
  (or (= h "defsum") (or (= h "deftrait") (= h "impl"))))

(defn sx-head-name [(items (ptr (ArrayList Sexp)))] (-> (slice u8))
  (if (and (>= (sx-len items) (primitive/cast i64 1))
           (= (sx-tag (sx-at items 0)) (primitive/cast i64 2)))
      (sx-sval (sx-at items 0))
      ""))

; Copy a definition form's children, leaving every binder vector byte-identical and
; expanding everything else. `member` walks one extra level for defsum variants and
; trait/impl methods.
(defn expand-def-list [(items (ptr (ArrayList Sexp)))
                       (member bool)
                       (module (Option (slice u8)))
                       (env (ptr ExpEnv))
                       (allfns (ptr (ArrayList (slice u8))))
                       (gs (ptr (ArrayList StructDef)))
                       (gu (ptr (ArrayList SumDef)))
                       (depth (ptr i64))
                       (ls (mut LS))] (-> (Result (ptr (ArrayList Sexp)) Diag))
  (let [a (load (field env a))
        n (sx-len items)
        ; the parameter scope ENDS with the definition; without this the params of one
        ; defn would still be bound while walking the next one
        mark (benv-mark env)
        (mut out) (al-new [Sexp] a)
        (mut i) 0
        (mut errf) (None [Diag])]
    (loop (if (or (diag-some? (load errf)) (>= (load i) n))
              (break)
              (do
                (let [child (al-elem [Sexp] items (load i))
                      tg (sx-tag (load child))]
                  (cond ; a binder vector: verbatim, never expanded — and its names bind
                        ; for everything after it, so a parameter named after a macro wins
                        ; in the body too, not just inside the vector.
                        (and (> (load i) (primitive/cast i64 0)) (= tg (primitive/cast i64 7)))
                          (do
                            (al-push! (mut out) (load child))
                            (benv-bind-vec! env (sx-items (load child)) 1)
                            0)
                        ; a member form (variant / method): recurse one level with the
                        ; same rule, so its own params or payload vector is protected too
                        (and (and member (> (load i) (primitive/cast i64 0)))
                             (= tg (primitive/cast i64 6)))
                          (match (expand-def-list (sx-items (load child))
                                                  false
                                                  module
                                                  env
                                                  allfns
                                                  gs
                                                  gu
                                                  depth
                                                  (mut ls))
                            (Err [d] (do (store! errf (Some d)) 0))
                            (Ok [inner]
                                (do (al-push! (mut out) (mk-sexp-src (KList inner) child)) 0)))
                        :else
                          (match (expand-calls child module env allfns gs gu depth (mut ls))
                            (Err [d] (do (store! errf (Some d)) 0))
                            (Ok [r] (do (al-push! (mut out) r) 0)))))
                (set! i (primitive/iadd (load i) 1)))))
    (benv-reset! env mark)
    (match (load errf)
      (Some [d] (Err [(ptr (ArrayList Sexp)) Diag] d))
      (None [] (Ok [(ptr (ArrayList Sexp)) Diag] (box-al [Sexp] a (load out)))))))

; `(match SCRUT (Variant [b…] body…) …)`: each arm's bind vector scopes over THAT
; arm's body and nothing else. `match` is a special form, so unlike `for` — which is a
; macro and gets this for free once its expansion's `let` is walked — the arms are
; never seen by any binding form and their names never entered the environment.
;
; The arm HEAD is a pattern, not a call: `(Wrap [v] …)` names a variant. It is left
; unexpanded for the same reason a parameter list is, so a variant sharing a macro's
; name cannot be rewritten out from under the author.
(defn expand-match-form [(items (ptr (ArrayList Sexp)))
                         (module (Option (slice u8)))
                         (env (ptr ExpEnv))
                         (allfns (ptr (ArrayList (slice u8))))
                         (gs (ptr (ArrayList StructDef)))
                         (gu (ptr (ArrayList SumDef)))
                         (depth (ptr i64))
                         (ls (mut LS))] (-> (Result (ptr (ArrayList Sexp)) Diag))
  (let [a (load (field env a))
        n (sx-len items)
        (mut out) (al-new [Sexp] a)
        (mut i) 0
        (mut errf) (None [Diag])]
    (loop (if (or (diag-some? (load errf)) (>= (load i) n))
              (break)
              (do
                (let [child (al-elem [Sexp] items (load i))]
                  (if (< (load i) (primitive/cast i64 2))
                      ; element 0 is `match`, element 1 the scrutinee — outer scope
                      (if (= (load i) (primitive/cast i64 0))
                          (do (al-push! (mut out) (load child)) 0)
                          (match (expand-calls child module env allfns gs gu depth (mut ls))
                            (Err [d] (do (set! errf (Some d)) 0))
                            (Ok [r] (do (al-push! (mut out) r) 0))))
                      ; an arm: (Variant [binds…] body…), or the catch-all (_ body…),
                      ; which binds nothing and so has no bind vector to skip over —
                      ; without that exception a body that happens to BE a vector
                      ; literal would be mistaken for one.
                      (let [it (sx-items (load child))
                            arm?
                              (and (= (sx-tag (load child)) (primitive/cast i64 6))
                                   (and (not (= (sx-head-name it) "_"))
                                        (and (>= (sx-len it) (primitive/cast i64 2))
                                             (= (sx-tag (sx-at it 1)) (primitive/cast i64 7)))))]
                        (if (not arm?)
                            (match (expand-calls child module env allfns gs gu depth (mut ls))
                              (Err [d] (do (set! errf (Some d)) 0))
                              (Ok [r] (do (al-push! (mut out) r) 0)))
                            (let [mark (benv-mark env)
                                  an (sx-len it)
                                  (mut aout) (al-new [Sexp] a)
                                  (mut j) 0]
                              (al-push! (mut aout) (sx-at it 0))
                              (al-push! (mut aout) (sx-at it 1))
                              (benv-bind-vec! env (sx-items (sx-at it 1)) 1)
                              (set! j 2)
                              (loop (if (or (diag-some? (load errf)) (>= (load j) an))
                                        (break)
                                        (do
                                          (match (expand-calls (al-elem [Sexp] it (load j))
                                                               module
                                                               env
                                                               allfns
                                                               gs
                                                               gu
                                                               depth
                                                               (mut ls))
                                            (Err [d] (do (set! errf (Some d)) 0))
                                            (Ok [r] (do (al-push! (mut aout) r) 0)))
                                          (set! j (primitive/iadd (load j) 1)))))
                              (benv-reset! env mark)
                              (al-push! (mut out) (mk-sexp-src (KList (box-al [Sexp] a (load aout))) child))
                              0)))))
                (set! i (primitive/iadd (load i) 1)))))
    (match (load errf)
      (Some [d] (Err [(ptr (ArrayList Sexp)) Diag] d))
      (None [] (Ok [(ptr (ArrayList Sexp)) Diag] (box-al [Sexp] a (load out)))))))

; `(let [n init …] body…)`: walk the binder vector in the OUTER scope, then bind its
; names and walk the body under them.
(defn expand-let-form [(items (ptr (ArrayList Sexp)))
                       (module (Option (slice u8)))
                       (env (ptr ExpEnv))
                       (allfns (ptr (ArrayList (slice u8))))
                       (gs (ptr (ArrayList StructDef)))
                       (gu (ptr (ArrayList SumDef)))
                       (depth (ptr i64))
                       (ls (mut LS))] (-> (Result (ptr (ArrayList Sexp)) Diag))
  (let [a (load (field env a))
        n (sx-len items)
        (mut out) (al-new [Sexp] a)
        (mut i) 0
        (mut errf) (None [Diag])]
    (loop (if (or (diag-some? (load errf)) (>= (load i) n))
              (break)
              (do
                (let [child (al-elem [Sexp] items (load i))]
                  (match (expand-calls child module env allfns gs gu depth (mut ls))
                    (Err [d] (do (set! errf (Some d)) 0))
                    (Ok [r] (do (al-push! (mut out) r) 0)))
                  ; the binder vector is element 1; everything after it is body
                  (when (and (= (load i) (primitive/cast i64 1))
                             (= (sx-tag (load child)) (primitive/cast i64 7)))
                    (benv-bind-vec! env (sx-items (load child)) 0)
                    0))
                (set! i (primitive/iadd (load i) 1)))))
    (match (load errf)
      (Some [d] (Err [(ptr (ArrayList Sexp)) Diag] d))
      (None [] (Ok [(ptr (ArrayList Sexp)) Diag] (box-al [Sexp] a (load out)))))))

(defn expand-calls-list [(items (ptr (ArrayList Sexp)))
                         (module (Option (slice u8)))
                         (env (ptr ExpEnv))
                         (allfns (ptr (ArrayList (slice u8))))
                         (gs (ptr (ArrayList StructDef)))
                         (gu (ptr (ArrayList SumDef)))
                         (depth (ptr i64))
                         (ls (mut LS))] (-> (Result (ptr (ArrayList Sexp)) Diag))
  (let [a (load (field env a))
        n (sx-len items)
        (mut out) (al-new [Sexp] a)
        (mut i) 0
        (mut errf) (None [Diag])]
    (loop (if (or (diag-some? (load errf)) (>= (load i) n))
              (break)
              (do
                (match (expand-calls (al-elem [Sexp] items (load i)) module env allfns gs gu depth (mut ls))
                  (Err [d] (do (set! errf (Some d)) 0))
                  (Ok [r] (do (al-push! (mut out) r) 0)))
                (set! i (primitive/iadd (load i) 1)))))
    (match (load errf)
      (Some [d] (Err [(ptr (ArrayList Sexp)) Diag] d))
      (None [] (Ok [(ptr (ArrayList Sexp)) Diag] (box-al [Sexp] a (load out)))))))
; The "re-expand the expansion result" step is an explicit LOOP (primitive/store! cur +
; repeat), not self-recursion: it guarantees constant stack for expansion chains
; without leaning on musttail, whose AArch64 lowering is at the mercy of the
; inliner (a second caller of expand-macro made LLVM refuse the marked call).
(defn expand-calls [(s (ptr Sexp))
                    (module (Option (slice u8)))
                    (env (ptr ExpEnv))
                    (allfns (ptr (ArrayList (slice u8))))
                    (gs (ptr (ArrayList StructDef)))
                    (gu (ptr (ArrayList SumDef)))
                    (depth (ptr i64))
                    (ls (mut LS))] (-> (Result Sexp Diag))
  (let [a (load (field env a))
        (mut cur) s]
    (loop (let [tg (sx-tag (load (load cur)))]
            (if (= tg (primitive/cast i64 6))
                (let [items (sx-items (load (load cur)))
                      ; TIER 2 of the Clojure tiering (BINDING_AND_SHADOWING.md): a
                      ; LOCAL BEATS A MACRO in head position. Coil is a Lisp-1 —
                      ; `(let [when 5] when)` was already 5 — but `(let [when 5]
                      ; (when 1 2))` still expanded the macro, so one name meant two
                      ; things in one scope depending on position. Consulting the
                      ; syntactic environment BEFORE the macro table settles it: a
                      ; bound name is not a macro reference, so this becomes an
                      ; attempt to call 5, which is the error Scheme and Clojure both
                      ; give. Special forms are unaffected — they never reach the
                      ; macro table, which is why `(let [if 5] (if a b c))` already
                      ; worked and still does.
                      hp (if (>= (sx-len items) (primitive/cast i64 1))
                             (sx-at items 0)
                             (sx-sym ""))
                      headq
                        (if (and (>= (sx-len items) (primitive/cast i64 1))
                                 (and (= (sx-tag hp) (primitive/cast i64 2))
                                      (if (and (= (sx-hyg hp) (primitive/cast i64 0))
                                               (benv-bound? env (sx-sval hp)))
                                          (do
                                            (shadow-note! (sx-source (load (load cur))) (sx-lo (load (load cur))))
                                            false)
                                          true)))
                            (resolve-macro (sx-sval hp)
                                           (macro-module-of hp module)
                                           (load (field env macros))
                                           (load (field env impb))
                                           (load (field env expb))
                                           a)
                            (None [(slice u8)]))]
                  (match headq
                    (Some [q]
                          (do
                            (set! depth (primitive/iadd (load depth) 1))
                            (if (> (load depth) (primitive/cast i64 100000))
                                (break (Err [Sexp Diag] (derr "macro expansion did not terminate")))
                                (match (expand-macro (load (field env sub))
                                                     q
                                                     (rest-from a items 1)
                                                     allfns
                                                     gs
                                                     gu
                                                     (load (field env impb))
                                                     (load (field env expb))
                                                     a)
                                  (Err [d]
                                       (break (Err [Sexp Diag]
                                                   (stamp-call-site d (load (load cur))))))
                                  (Ok [outs]
                                      (let [op (box-sexp a outs)
                                            dfp (find-func-ptr (load (field env sub)) q)
                                            have-def (!= (primitive/cast i64 dfp) (primitive/cast i64 0))
                                            def-src (if have-def (.source dfp) -1)
                                            def-lo (if have-def (.lo dfp) -1)
                                            def-hi (if have-def (.hi dfp) -1)
                                            def-ctxt (when have-def (load (field dfp ctxt)))
                                            exp
                                              (mk-expansion q
                                                            (sx-source (load (load cur)))
                                                            (sx-lo (load (load cur)))
                                                            (sx-hi (load (load cur)))
                                                            (sx-ctxt (load (load cur)))
                                                            def-src
                                                            def-lo
                                                            def-hi
                                                            def-ctxt
                                                            (sx-ctxt (load (load cur))))
                                            ctxt (add-expansion! (mut ls) exp)]
                                        (stamp-expansion op
                                                         (sx-source (load (load cur)))
                                                         (sx-lo (load (load cur)))
                                                         (sx-hi (load (load cur)))
                                                         ctxt)
                                        (set! cur op)
                                        0))))))
                    (None []
                          (let [hn (sx-head-name items)]
                            (if (= hn "match")
                                (break (let [r (expand-match-form items module env allfns gs gu depth (mut ls))]
                                         (match r
                                           (Err [d] (Err [Sexp Diag] d))
                                           (Ok [outitems]
                                               (Ok [Sexp Diag] (mk-sexp-src (KList outitems) (load cur)))))))
                                (if (= hn "let")
                                    ; `(let [n init …] body…)` — the names bind for the
                                    ; body. Bound AFTER the vector is walked, because the
                                    ; inits are expressions in the OUTER scope: in
                                    ; `(let [when (when a b)] …)` the initialiser's `when`
                                    ; is still the macro. Sequential-scope refinements
                                    ; (an init seeing earlier names in the same vector)
                                    ; would need per-pair marks; this is the conservative
                                    ; direction — it under-binds rather than over-binds,
                                    ; so it can only leave a macro expanding where a local
                                    ; should have won, never the reverse.
                                    (break (let [mark (benv-mark env)
                                                 r (expand-let-form items module env allfns gs gu depth (mut ls))]
                                             (benv-reset! env mark)
                                             (match r
                                               (Err [d] (Err [Sexp Diag] d))
                                               (Ok [outitems]
                                                   (Ok [Sexp Diag] (mk-sexp-src (KList outitems) (load cur)))))))
                                    (if (def-form-head? hn)
                                        (break (match (expand-def-list items
                                                                       (def-member-head? hn)
                                                                       module
                                                                       env
                                                                       allfns
                                                                       gs
                                                                       gu
                                                                       depth
                                                                       (mut ls))
                                                 (Err [d] (Err [Sexp Diag] d))
                                                 (Ok [outitems]
                                                     (Ok [Sexp Diag] (mk-sexp-src (KList outitems) (load cur))))))
                                        (break (match (expand-calls-list items module env allfns gs gu depth (mut ls))
                                                 (Err [d] (Err [Sexp Diag] d))
                                                 (Ok [outitems]
                                                     (Ok [Sexp Diag] (mk-sexp-src (KList outitems) (load cur)))))))))))))
                (if (= tg (primitive/cast i64 7))
                    (break (match (expand-calls-list (sx-items (load (load cur)))
                                                     module
                                                     env
                                                     allfns
                                                     gs
                                                     gu
                                                     depth
                                                     (mut ls))
                             (Err [d] (Err [Sexp Diag] d))
                             (Ok [outitems] (Ok [Sexp Diag] (mk-sexp-src (KVec outitems) (load cur))))))
                    (break (Ok [Sexp Diag] (load (load cur))))))))))
(defn expand-top-form [(f (ptr Sexp))
                       (module (Option (slice u8)))
                       (env (ptr ExpEnv))
                       (allfns (ptr (ArrayList (slice u8))))
                       (gs (ptr (ArrayList StructDef)))
                       (gu (ptr (ArrayList SumDef)))
                       (depth (ptr i64))
                       (ls (mut LS))] (-> (Result Sexp Diag))
  (if (or (is-meta-form f)
          (is-comptime-defn f
                            module
                            (load (field env comptime))
                            (load (field env a))))
      (Ok [Sexp Diag] (load f))
      (expand-calls f module env allfns gs gu depth (mut ls))))
(defn qualify-structdefs! [(p (ptr Program)) (module (Option (slice u8))) (gs (ptr SBoxStruct)) (a (ptr Allocator))] (-> i64)
  (let [ss (load (field p structs))
        n (al-len [StructDef] (load ss))
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (let [sd (alloc/stack StructDef)]
                  (set! sd (al-get [StructDef] (load ss) (load i)))
                  (set! (.name sd) (qualify-name a (.name sd) module))
                  (al-push! (mut (.items gs)) (load sd)))
                (set! i (primitive/iadd (load i) 1))))))
  0)
(defn qualify-sumdefs! [(p (ptr Program)) (module (Option (slice u8))) (gu (ptr SBoxSum)) (a (ptr Allocator))] (-> i64)
  (let [ss (load (field p sums))
        n (al-len [SumDef] (load ss))
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (let [sd (alloc/stack SumDef)]
                  (set! sd (al-get [SumDef] (load ss) (load i)))
                  (set! (.name sd) (qualify-name a (.name sd) module))
                  (al-push! (mut (.items gu)) (load sd)))
                (set! i (primitive/iadd (load i) 1))))))
  0)
(defn register-generated-decl [(form (ptr Sexp))
                               (module (Option (slice u8)))
                               (gs (ptr SBoxStruct))
                               (gu (ptr SBoxSum))
                               (a (ptr Allocator))] (-> (Option Diag))
  (if (!= (sx-tag (load form)) (primitive/cast i64 6))
      (None [Diag])
      (let [it (sx-items (load form))]
        (if (or (< (sx-len it) (primitive/cast i64 1)) (!= (sx-tag (sx-at it 0)) (primitive/cast i64 2)))
            (None [Diag])
            (let [head (sx-sval (sx-at it 0))]
              (if (not (or (= head "defstruct") (= head "defsum")))
                  (None [Diag])
                  (let [single (unwrap-ptr [(ArrayList Sexp)] (create [(ArrayList Sexp)] a))
                        (mut sl) (al-new [Sexp] a)]
                    (al-push! (mut sl) (load form))
                    (set! single (load sl))
                    (match (parse-program a single)
                      (Err [d] (Some d))
                      (Ok [p]
                          (let [pp (box-program a p)]
                            (qualify-structdefs! pp module gs a)
                            (qualify-sumdefs! pp module gu a)
                            (None [Diag])))))))))))
(defn box-program [(a (ptr Allocator)) (p Program)] (-> (ptr Program))
  (box a Program p))
(defstruct SBoxStruct [(items (ArrayList StructDef))])
(defstruct SBoxSum [(items (ArrayList SumDef))])
(defstruct SBoxTF [(items (ArrayList TaggedForm))])
(defn code-sig-funcs [(p (ptr Program)) (a (ptr Allocator))] (-> (ptr (ArrayList (slice u8))))
  (let [fs (load (field p funcs))
        n (al-len [Func] (load fs))
        (mut out) (al-new [(slice u8)] a)
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (let [fp (al-elem [Func] fs (load i))]
                  (when (and (type-is-code (field fp ret))
                             (all-params-code (load (field fp params))))
                    (al-push! (mut out) (load (field fp name)))
                    0))
                (set! i (primitive/iadd (load i) 1)))))
    (box-al [(slice u8)] a (load out))))
(defn all-params-code [(ps (ptr (ArrayList Param)))] (-> bool)
  (let [n (al-len [Param] (load ps))
        (mut i) 0
        (mut r) true]
    (loop (if (or (not (load r)) (>= (load i) n))
              (break)
              (do
                (unless (type-is-code (field (al-elem [Param] ps (load i)) ty))
                  (store! r false)
                  0)
                (set! i (primitive/iadd (load i) 1)))))
    (load r)))
(defn all-defn-names [(out-forms (ptr (ArrayList TaggedForm))) (a (ptr Allocator))] (-> (ptr SBox))
  (let [sb (unwrap-ptr [SBox] (create [SBox] a))
        n (al-len [TaggedForm] (load out-forms))
        (mut i) 0]
    (set! (.items sb) (al-new [(slice u8)] a))
    (loop (if (>= (load i) n)
              (break)
              (do
                (let [tf (al-elem [TaggedForm] out-forms (load i))
                      fp (field tf form)]
                  (match (defn-name-of fp)
                    (Some [nm]
                          (al-push! (mut (.items sb))
                                    (qualify-name a nm (.module tf))))
                    (None [] 0))
                  ; Trait methods are callable names too, and hygiene reads this list.
                  (trait-method-names-into! fp sb (.module tf) a))
                (set! i (primitive/iadd (load i) 1)))))
    ; This is the ONLY place a module_fns list is born, so it is the one place that
    ; can guarantee comptime's set index never outlives the list it indexed — even if
    ; the allocator hands this fresh list the address of a dead one.
    sb))
; ── the DEFINITION-TIME EXPANSION TOWER ──────────────────────────────────────
; A metaprogram body may CALL MACROS (`when`, `try!`, `fmt`, …). The rule is
; TYPE-DIRECTED (tests/metaprogramming/compile-and-run/README.md): a call to a
; Code-signature function whose arguments all typecheck as Code is an ordinary
; FUNCTION call (passing code values — cond-arms' recursion); one whose arguments
; do NOT is surface syntax, expanded AT DEFINITION TIME. No second judgment is
; implemented: the sub-program CHECK is the judge. When it rejects the sub-program
; AT a macro-headed call form (its diag spans exactly the call), that is the rule
; firing — expand that one call, re-resolve, re-check, to a fixpoint. A program
; whose sub-check passes first try (all previously-valid programs) pays nothing.
(defstruct TowerCx
  [(a (ptr Allocator))
   (dlo i64)
   (dhi i64)
   (dsrc i64)
   (macroctx (ptr Program))
   (quals (ptr (ArrayList (slice u8))))
   (allfns (ptr (ArrayList (slice u8))))
   (impb (ptr (ArrayList ImpEntry)))
   (expb (ptr (ArrayList ExpEntry)))
   (module (Option (slice u8)))
   (hit i64)
   (depth i64)])

; expand ONE macro call at `node` (already known macro-headed), mirroring
; expand-calls' invoke + expansion-record + span-stamp exactly
(defn tower-expand-call [(tc (ptr TowerCx)) (s (mut LS)) (node (ptr Sexp)) (q (slice u8))] (-> (Result Sexp Diag))
  (let [a (load (field tc a))
        items (sx-items (load node))
        gs (box-al [StructDef] a (al-new [StructDef] a))
        gu (box-al [SumDef] a (al-new [SumDef] a))]
    (match (expand-macro (load (field tc macroctx))
                         q
                         (rest-from a items 1)
                         (load (field tc allfns))
                         gs
                         gu
                         (load (field tc impb))
                         (load (field tc expb))
                         a)
      (Err [d] (Err [Sexp Diag] (stamp-call-site d (load node))))
      (Ok [outs]
          (let [op (box-sexp a outs)
                dfp (find-func-ptr (load (field tc macroctx)) q)
                have-def (!= (primitive/cast i64 dfp) (primitive/cast i64 0))
                def-src (if have-def (.source dfp) -1)
                def-lo (if have-def (.lo dfp) -1)
                def-hi (if have-def (.hi dfp) -1)
                def-ctxt (when have-def (load (field dfp ctxt)))
                exp
                  (mk-expansion q
                                (sx-source (load node))
                                (sx-lo (load node))
                                (sx-hi (load node))
                                (sx-ctxt (load node))
                                def-src
                                def-lo
                                def-hi
                                def-ctxt
                                (sx-ctxt (load node)))
                ctxt (add-expansion! (mut s) exp)]
            (stamp-expansion op
                             (sx-source (load node))
                             (sx-lo (load node))
                             (sx-hi (load node))
                             ctxt)
            ; The expansion can itself be macro-headed at the same source span.
            ; Consume that outer-to-inner chain now instead of rebuilding and
            ; rechecking the complete program once per layer.
            (if (>= (.depth tc) (primitive/cast i64 64))
                (Err [Sexp Diag]
                     (derr "metaprogram definition-time expansion exceeded 64 nested macro layers"))
                (do
                  (set! (.depth tc) (primitive/iadd (.depth tc) 1))
                  (set! (.hit tc) 0)
                  (match (tower-rewrite tc (mut s) op)
                    (Err [d] (Err [Sexp Diag] d))
                    (Ok [expanded]
                        (do
                          (set! (.depth tc) (primitive/isub (.depth tc) 1))
                          (set! (.hit tc) 1)
                          (Ok [Sexp Diag] expanded)))))))))))

; Rewrite one call per nested branch, OUTERMOST first. A macro call that CONTAINS
; the diag span owns that syntax wholesale — `(when (not b) …)` must expand before
; its `(not b)` argument does, or the inner expansion lands as a non-Code value in
; the outer macro's Code-typed argument slot and the round wedges. Independent
; sibling branches/forms are safe to batch in the same generation.
(defn tower-rewrite [(tc (ptr TowerCx)) (s (mut LS)) (node (ptr Sexp))] (-> (Result Sexp Diag))
  (try (do
         (let [a (load (field tc a))
               tg (sx-tag (load node))]
           (if (not (or (= tg (primitive/cast i64 6)) (= tg (primitive/cast i64 7))))
               (Ok [Sexp Diag] (load node))
               (let [items (sx-items (load node))
                     n (sx-len items)
                     contains
                       (and (= (sx-source (load node)) (load (field tc dsrc)))
                            (and (>= (sx-lo (load node)) (primitive/cast i64 0))
                                 (and (<= (sx-lo (load node)) (load (field tc dlo)))
                                      (>= (sx-hi (load node)) (load (field tc dhi))))))
                     headq
                       (if (and contains
                                (and (= tg (primitive/cast i64 6))
                                     (and (>= n (primitive/cast i64 1))
                                          (= (sx-tag (sx-at items 0)) (primitive/cast i64 2)))))
                           (resolve-macro (sx-sval (sx-at items 0))
                                          (macro-module-of (sx-at items 0) (load (field tc module)))
                                          (load (field tc quals))
                                          (load (field tc impb))
                                          (load (field tc expb))
                                          a)
                           (None [(slice u8)]))]
                 (match headq
                   (Some [q] (tower-expand-call tc (mut s) node q))
                   (None []
                         (let [(mut any) false
                               (mut xs) (al-new [Sexp] a)
                               (mut i) 0]
                           (loop (if (>= (load i) n)
                                     (break)
                                     (do
                                       (store! (field tc hit) 0)
                                       (let [r
                                               (try! (tower-rewrite tc
                                                                    (mut s)
                                                                    (al-elem [Sexp] items (load i))))]
                                         (if (!= (load (field tc hit)) (primitive/cast i64 0))
                                             (do (store! any true) (al-push! (mut xs) r) 0)
                                             (al-push! (mut xs) (sx-at items (load i)))))
                                       (store! i (primitive/iadd (load i) 1)))))
                           (if (load any)
                               (do
                                 (store! (field tc hit) 1)
                                 (Ok [Sexp Diag]
                                     (mk-sexp-src (if (= tg (primitive/cast i64 7))
                                                      (KVec (box-al [Sexp] a (load xs)))
                                                      (KList (box-al [Sexp] a (load xs))))
                                                  node)))
                               (Ok [Sexp Diag] (load node))))))))))))

; ── the PARSE-LEVEL tower trigger ────────────────────────────────────────────
; A macro call whose arguments are not expression syntax at all — objc's
; (msg (ptr i8) recv sel [CGRect i64] …) with its naked type vectors — makes the
; whole enclosing defn UNPARSEABLE, so the tolerant resolve skips it and the
; check-driven tower never sees a diagnostic. This is the type-directed rule's
; syntactic BASE CASE: a macro-headed call that does not even parse as an
; expression cannot be a function call — expand it. Applied OUTERMOST-first,
; only inside defns the tolerant resolve skipped (zero cost when everything
; parses), never inside quote/quasiquote templates.
(defn tower-unparseable? [(a (ptr Allocator)) (node (ptr Sexp))] (-> bool)
  (match (parse-expr a (load node)) (Err [d] true) (Ok [e] false)))
; BATCHED: expand EVERY unparseable macro-headed call in the subtree (outermost
; per nesting) in one pass, so a defn full of them converges in one round.
(defn tower-parse-rewrite [(tc (ptr TowerCx)) (s (mut LS)) (node (ptr Sexp))] (-> (Result Sexp Diag))
  (try (do
         (let [a (load (field tc a))
               tg (sx-tag (load node))]
           (if (not (or (= tg (primitive/cast i64 6)) (= tg (primitive/cast i64 7))))
               (Ok [Sexp Diag] (load node))
               (let [items (sx-items (load node))
                     n (sx-len items)
                     head
                       (if (and (= tg (primitive/cast i64 6))
                                (and (>= n (primitive/cast i64 1))
                                     (= (sx-tag (sx-at items 0)) (primitive/cast i64 2))))
                           (sx-sval (sx-at items 0))
                           "")]
                 (if (or (= head "quote") (= head "quasiquote"))
                     (Ok [Sexp Diag] (load node))
                     (match (if (= head "")
                                (None [(slice u8)])
                                (resolve-macro head
                                               (macro-module-of (sx-at items 0) (load (field tc module)))
                                               (load (field tc quals))
                                               (load (field tc impb))
                                               (load (field tc expb))
                                               a))
                       (Some [q]
                             (if (tower-unparseable? a node)
                                 (tower-expand-call tc (mut s) node q)
                                 (tower-parse-kids tc (mut s) node)))
                       (None [] (tower-parse-kids tc (mut s) node))))))))))
(defn tower-parse-kids [(tc (ptr TowerCx)) (s (mut LS)) (node (ptr Sexp))] (-> (Result Sexp Diag))
  (try (do
         (let [a (load (field tc a))
               tg (sx-tag (load node))
               items (sx-items (load node))
               n (sx-len items)
               (mut any) false
               (mut xs) (al-new [Sexp] a)
               (mut i) 0
               (mut before) 0]
           (loop (if (>= (load i) n)
                     (break)
                     (do
                       (store! before (load (field tc hit)))
                       (let [r (try! (tower-parse-rewrite tc (mut s) (al-elem [Sexp] items (load i))))]
                         (if (!= (load (field tc hit)) (load before))
                             (do (store! any true) (al-push! (mut xs) r) 0)
                             (al-push! (mut xs) (sx-at items (load i)))))
                       (store! i (primitive/iadd (load i) 1)))))
           (if (load any)
               (Ok [Sexp Diag]
                   (mk-sexp-src (if (= tg (primitive/cast i64 7))
                                    (KVec (box-al [Sexp] a (load xs)))
                                    (KList (box-al [Sexp] a (load xs))))
                                node))
               (Ok [Sexp Diag] (load node)))))))
; Is this raw (pre-parse) form a Code-signature defn — i.e. a METAPROGRAM whose
; body may legitimately contain unparseable macro syntax (objc `msg`)? Judged on
; the Sexp: (defn NAME [(p Code)…& (r Code)] (-> Code) …).
(defn raw-code-sig? [(f (ptr Sexp))] (-> bool)
  (if (!= (sx-tag (load f)) (primitive/cast i64 6))
      false
      (let [it (sx-items (load f))
            n (sx-len it)]
        (if (or (< n (primitive/cast i64 4))
                (not (and (= (sx-tag (sx-at it 0)) (primitive/cast i64 2)) (= (sx-sval (sx-at it 0)) "defn"))))
            false
            (let [pi
                    (if (= (sx-tag (sx-at it 2)) (primitive/cast i64 7))
                        2
                        (if (and (> n (primitive/cast i64 4)) (= (sx-tag (sx-at it 3)) (primitive/cast i64 7))) 3 -1))]
              (if (or (< pi (primitive/cast i64 0))
                      (!= pi (primitive/cast i64 2)))
                  false
                  ; generic metaprograms don't exist; [T] first = not one
                  (let [params (sx-items (sx-at it 2))
                        np (sx-len params)
                        reti 3]
                    (if (>= reti n)
                        false
                        (let [r (sx-at it reti)
                              retok
                                (and (= (sx-tag r) (primitive/cast i64 6))
                                     (and (= (sx-len (sx-items r)) (primitive/cast i64 2))
                                          (and (= (sx-tag (sx-at (sx-items r) 0)) (primitive/cast i64 2))
                                               (and (= (sx-sval (sx-at (sx-items r) 0)) "->")
                                                    (and (= (sx-tag (sx-at (sx-items r) 1)) (primitive/cast i64 2))
                                                         (= (sx-sval (sx-at (sx-items r) 1)) "Code"))))))]
                          (if (not retok)
                              false
                              (let [(mut i) 0
                                    (mut ok) true]
                                (loop (if (or (not (load ok)) (>= (load i) np))
                                          (break)
                                          (do
                                            (let [p (sx-at params (load i))]
                                              (unless (or (and (= (sx-tag p) (primitive/cast i64 2))
                                                               (= (sx-sval p) "&"))
                                                          (and (= (sx-tag p) (primitive/cast i64 6))
                                                               (and (= (sx-len (sx-items p)) (primitive/cast i64 2))
                                                                    (and (= (sx-tag (sx-at (sx-items p)
                                                                                           1))
                                                                            (primitive/cast i64 2))
                                                                         (= (sx-sval (sx-at (sx-items p) 1)) "Code")))))
                                                (store! ok false)
                                                0))
                                            (set! i (primitive/iadd (load i) 1)))))
                                (load ok))))))))))))
; recover ONE skipped defn (batched inside it); shared by both triggers
(defn tower-recover-form! [(tc (ptr TowerCx)) (s (mut LS)) (tf (ptr TaggedForm))] (-> (Result i64 Diag))
  (try (do
         (store! (field tc module) (load (field tf module)))
         (let [nf (try! (tower-parse-rewrite tc (mut s) (field tf form)))]
           (when (!= (load (field tc hit)) (primitive/cast i64 0))
             (store! (field tf form) nf)
             0)
           (Ok [i64 Diag] (load (field tc hit)))))))
; trigger (a): a skipped defn whose RAW signature is Code-shaped IS a metaprogram
; — recover it eagerly (nothing else will ever name it in a diagnostic).
; Skipped ORDINARY defns (the compiler's own try/block/return-from bodies have
; never parsed pre-expansion) are left alone unless trigger (b) demands them.
(defn tower-parse-pass [(tc (ptr TowerCx))
                        (s (mut LS))
                        (sub-forms (ptr (ArrayList TaggedForm)))
                        (macroctx (ptr Program))] (-> (Result i64 Diag))
  (try (do
         (let [a (load (field tc a))
               n (al-len [TaggedForm] (load sub-forms))
               (mut i) 0]
           (loop (if (>= (load i) n)
                     (break)
                     (do
                       (let [tf (al-elem [TaggedForm] sub-forms (load i))]
                         (match (defn-name-of (field tf form))
                           (None [] 0)
                           (Some [nm]
                                 (let [q (qualify-name a nm (load (field tf module)))]
                                   (unless (or (!= (primitive/cast i64 (prog-fn-find macroctx q))
                                                   (primitive/cast i64 0))
                                               (not (raw-code-sig? (field tf form))))
                                     (match (tower-recover-form! tc (mut s) tf)
                                       (Ok [$g1254] $g1254)
                                       (Err [$g1255] (break :try (Err $g1255))))
                                     0)))))
                       (store! i (primitive/iadd (load i) 1)))))
           (Ok [i64 Diag] (load (field tc hit)))))))
; trigger (b): the sub-check failed with a call to a name that matches a SKIPPED
; defn (a metaprogram reached an ordinary helper whose body has macro syntax) —
; recover that helper on demand.
(defn tower-find-head-at [(tc (ptr TowerCx)) (node (ptr Sexp))] (-> (Option (slice u8)))
  (let [tg (sx-tag (load node))]
    (if (not (or (= tg (primitive/cast i64 6)) (= tg (primitive/cast i64 7))))
        (None [(slice u8)])
        (let [items (sx-items (load node))
              n (sx-len items)]
          (if (and (= tg (primitive/cast i64 6))
                   (and (= (sx-lo (load node)) (.dlo tc))
                        (and (= (sx-hi (load node)) (.dhi tc))
                             (and (= (sx-source (load node)) (.dsrc tc))
                                  (and (>= n (primitive/cast i64 1))
                                       (= (sx-tag (sx-at items 0)) (primitive/cast i64 2)))))))
              (Some (sx-sval (sx-at items 0)))
              (let [(mut i) 0
                    (mut r) (None [(slice u8)])]
                (loop (if (>= (load i) n)
                          (break)
                          (do
                            (match (tower-find-head-at tc (al-elem [Sexp] items (load i)))
                              (Some [h] (do (set! r (Some h)) (break)))
                              (None [] 0))
                            (set! i (primitive/iadd (load i) 1)))))
                (load r)))))))
(defn tower-recover-called [(tc (ptr TowerCx))
                            (s (mut LS))
                            (sub-forms (ptr (ArrayList TaggedForm)))
                            (macroctx (ptr Program))] (-> (Result i64 Diag))
  (try (do
         (let [a (load (field tc a))
               n (al-len [TaggedForm] (load sub-forms))
               (mut headn) (None [(slice u8)])
               (mut i) 0]
           (loop (if (>= (load i) n)
                     (break)
                     (do
                       (match (tower-find-head-at tc
                                                  (field (al-elem [TaggedForm] sub-forms (load i)) form))
                         (Some [h] (do (store! headn (Some h)) (break)))
                         (None [] 0))
                       (store! i (primitive/iadd (load i) 1)))))
           (match (load headn)
             (None [] (Ok [i64 Diag] 0))
             (Some [h]
                   (let [(mut j) 0]
                     (loop (if (>= (load j) n)
                               (break)
                               (do
                                 (let [tf (al-elem [TaggedForm] sub-forms (load j))]
                                   (match (defn-name-of (field tf form))
                                     (None [] 0)
                                     (Some [nm]
                                           (unless (or (not (= nm h))
                                                       (!= (primitive/cast i64
                                                                           (prog-fn-find macroctx
                                                                                         (qualify-name a
                                                                                                       nm
                                                                                                       (load (field tf
                                                                                                                    module)))))
                                                           (primitive/cast i64 0)))
                                             (match (tower-recover-form! tc (mut s) tf)
                                               (Ok [$g1256] $g1256)
                                               (Err [$g1257] (break :try (Err $g1257))))
                                             0))))
                                 (store! j (primitive/iadd (load j) 1)))))
                     (Ok [i64 Diag] (load (field tc hit))))))))))
(defn mk-tower-cx [(s (mut LS))
                   (sub-forms (ptr (ArrayList TaggedForm)))
                   (macroctx (ptr Program))
                   (quals (ptr (ArrayList (slice u8))))
                   (a (ptr Allocator))
                   (dlo i64)
                   (dhi i64)
                   (dsrc i64)] (-> (ptr TowerCx))
  (let [tc (unwrap-ptr [TowerCx] (create [TowerCx] a))
        allfns (all-defn-names sub-forms a)
        impb (unwrap-ptr [(ArrayList ImpEntry)] (create [(ArrayList ImpEntry)] a))
        expb (unwrap-ptr [(ArrayList ExpEntry)] (create [(ArrayList ExpEntry)] a))]
    (set! impb (.imports s))
    (set! expb (.exports s))
    (set! (.a tc) a)
    (set! (.dlo tc) dlo)
    (set! (.dhi tc) dhi)
    (set! (.dsrc tc) dsrc)
    (set! (.macroctx tc) macroctx)
    (set! (.quals tc) quals)
    (set! (.allfns tc) (field allfns items))
    (set! (.impb tc) impb)
    (set! (.expb tc) expb)
    (set! (.module tc) (None [(slice u8)]))
    (set! (.hit tc) 0)
    (set! (.depth tc) 0)
    tc))
(defn stage3-parse-recover [(s (mut LS))
                            (sub-forms (ptr (ArrayList TaggedForm)))
                            (macroctx (ptr Program))
                            (quals (ptr (ArrayList (slice u8))))
                            (a (ptr Allocator))] (-> (Result i64 Diag))
  (let [tc (mk-tower-cx (mut s) sub-forms macroctx quals a -2 -2 -2)]
    (tower-parse-pass tc (mut s) sub-forms macroctx)))

(defn tower-pass [(tc (ptr TowerCx)) (s (mut LS)) (sub-forms (ptr (ArrayList TaggedForm)))] (-> (Result i64 Diag))
  (try (do
         (let [n (al-len [TaggedForm] (load sub-forms))
               (mut any) false
               (mut i) 0]
           (loop (if (>= (load i) n)
                     (break)
                     (do
                       (let [tf (al-elem [TaggedForm] sub-forms (load i))]
                         (store! (field tc module) (load (field tf module)))
                         (store! (field tc hit) 0)
                         (let [nf (try! (tower-rewrite tc (mut s) (field tf form)))]
                           (when (!= (load (field tc hit)) (primitive/cast i64 0))
                             (store! any true)
                             (store! (field tf form) nf)
                             0)))
                       (store! i (primitive/iadd (load i) 1)))))
           (store! (field tc hit) (if (load any) 1 0))
           (Ok [i64 Diag] (load (field tc hit)))))))

; ---- LAZY per-qual macro STAGING (interp deletion step 5, Phase B) ----------------
; The engine is grown ON DEMAND: stage3-round only RECORDS the round's sub-forms in
; a box (free), and the first time finish-macro misses a qual — which for almost
; every program is NEVER, and for the bootstrap is exactly the two dbg-slice-*
; tower expansions — stage-one-macro! builds THAT qual's pruned closure
; (impls/consts dropped, see closure-funcs-pruned), checks it standalone, and
; compiles it into the engine additively. An eager prepass was measured 2.7x slower
; cold across the corpus (one dylib per qual per file, ~20x the cc forks) for zero
; benefit on programs whose batch check passes round 0 — i.e. nearly all of them.
; The private resolve of the recorded sub-forms happens once per round, only on the
; first miss, so its check-program passes never touch the Program the batch path
; checks (closure-subprogram bodies are SHARED — see INTERP_DELETION.md Landmines).
(defstruct StageBox
  [(isset i64)
   (resolved i64)
   (sub-forms (ptr (ArrayList TaggedForm)))
   (imports (ArrayList ImpEntry))
   (exports (ArrayList ExpEntry))
   (primitive_defs (ArrayList PrimitiveDef))
   (primitive_aliases (ArrayList PrimitiveAlias))
   (mctx (ptr Program))
   (a (ptr Allocator))])
(defn stage-box [] (-> (ptr StageBox))
  (alloc/static StageBox))
(defn stage-box-set! [(s (mut LS)) (sub-forms (ptr (ArrayList TaggedForm))) (a (ptr Allocator))] (-> i64)
  (let [b (stage-box)]
    (set! (.sub-forms b) sub-forms)
    (set! (.imports b) (.imports s))
    (set! (.exports b) (.exports s))
    (set! (.primitive_defs b) (.primitive_defs s))
    (set! (.primitive_aliases b) (.primitive_aliases s))
    (set! (.a b) a)
    (set! (.resolved b) 0)
    (set! (.mctx b) (primitive/cast (ptr Program) 0))
    (set! (.isset b) 1)
    0))
; resolve the recorded forms once per round (memoized until the next stage-box-set!)
(defn stage-box-mctx [] (-> (ptr Program))
  (let [b (stage-box)]
    (if (= (.isset b) (primitive/cast i64 0))
        (primitive/cast (ptr Program) 0)
        (if (!= (.resolved b) (primitive/cast i64 0))
            (load (field b mctx))
            (let [a (load (field b a))
                  subls (alloc/stack LS)]
              (set! (.a subls) a)
              (set! (.out subls) (load (load (field b sub-forms))))
              (set! (.loaded subls) (al-new [(slice u8)] a))
              (set! (.readpaths subls) (al-new [(slice u8)] a))
              (set! (.readmods subls) (al-new [(slice u8)] a))
              (set! (.imports subls) (.imports b))
              (set! (.exports subls) (.exports b))
              (set! (.primitive_defs subls) (.primitive_defs b))
              (set! (.primitive_aliases subls) (.primitive_aliases b))
              (set! (.resolved b) 1)
              (match (resolve-program a (mut subls) false true)
                (Err [d]
                     (do
                       (set! (.mctx b) (primitive/cast (ptr Program) 0))
                       (primitive/cast (ptr Program) 0)))
                (Ok [mctx] (do (set! (.mctx b) mctx) mctx))))))))
; stage exactly one qual: pruned closure -> standalone check -> additive engine
; build. (None) = staged; (Some d) = could not stage, and `d` says WHY.
(defn stage-one-macro! [(q (slice u8))] (-> (Option Diag))
  (let [mctx (stage-box-mctx)]
    (if (= (primitive/cast i64 mctx) (primitive/cast i64 0))
        (Some (derr "the metaprogram staging context is not initialized (compiler bug)"))
        (let [a (load (field (stage-box) a))
              (mut seedl) (al-new [(slice u8)] a)]
          (al-push! (mut seedl) q)
          (let [seeds (meta-shim-seeds a mctx (box-al [(slice u8)] a (load seedl)))
                wanted (closure-funcs-pruned mctx seeds a)
                sub (closure-subprogram-pruned mctx wanted a)
                checkls (alloc/stack LS)
                (mut squal) (al-new [(slice u8)] a)]
            (al-push! (mut squal) q)
            (set! (.a checkls) a)
            (set! (.out checkls) (al-new [TaggedForm] a))
            (set! (.loaded checkls) (al-new [(slice u8)] a))
            (set! (.readpaths checkls) (al-new [(slice u8)] a))
            (set! (.readmods checkls) (al-new [(slice u8)] a))
            (set! (.imports checkls) (al-new [ImpEntry] a))
            (set! (.exports checkls) (al-new [ExpEntry] a))
            (set! (.primitive_defs checkls) (al-new [PrimitiveDef] a))
            (set! (.primitive_aliases checkls) (al-new [PrimitiveAlias] a))
            (set! (.check_diags checkls) (box-al [Diag] a (al-new [Diag] a)))
            (set! (.resolve_diags checkls) (primitive/cast (ptr (ArrayList Diag)) 0))
            (set! (.resolve_poisoned checkls) (primitive/cast (ptr (ArrayList (slice u8))) 0))
            ; Both failure arms used to bind the diagnostic and drop it on the floor,
            ; returning a bare `false`. The caller then reported only "could not be
            ; compiled into the metaprogram engine", pointed at whichever call site
            ; happened to trigger staging — so the one fact needed to fix it, WHY the
            ; standalone check or the engine build rejected the closure, never reached
            ; the user. Carry it out instead.
            ; The closure check is a SCRATCH pass: it must not disturb the
            ; authoritative S0-S3 semantic maps, which are still serving
            ; type-of/code-decl/binding-of when staging happens lazily inside
            ; a metaprogram invocation (e.g. a code->code main staged at
            ; `coil run` invoke time). Snapshot around it.
            (let [snap (alloc/stack SemMapsSnap)]
              (sem-maps-save snap)
              (let [ck (check-program a sub (mut checkls))]
                (sem-maps-restore snap)
                (match ck
                  (Ok [checked]
                      (match (meta-engine-setup a checked (box-al [(slice u8)] a (load squal)))
                        (Some [d] (Some d))
                        (None [] (None [Diag]))))
                  (Err [d] (Some d))))))))))

; `defderive` has to become ordinary Code-signed defns BEFORE stage3 discovers
; macros with `code-sig-funcs`.  It is syntax sugar only: the emitted
; `register-derive` is the sole act that makes either generated function a
; deriver.  Their names are intentionally arbitrary implementation details.
(defn defderive-form? [(f (ptr Sexp))] (-> bool)
  (and (= (sx-tag (load f)) (primitive/cast i64 6))
       (let [it (sx-items (load f))]
         (and (>= (sx-len it) (primitive/cast i64 2))
              (and (= (sx-tag (sx-at it 0)) (primitive/cast i64 2))
                   (= (sx-sval (sx-at it 0)) "defderive"))))))
(defn defderive-arm [(it (ptr (ArrayList Sexp))) (name (slice u8))] (-> (ptr Sexp))
  (let [n (sx-len it)
        (mut i) 2
        (mut out) (primitive/cast (ptr Sexp) 0)]
    (loop (if (>= (load i) n)
              (break)
              (do
                (let [x (al-elem [Sexp] it (load i))]
                  (when (and (= (sx-tag (load x)) (primitive/cast i64 6))
                             (let [xs (sx-items (load x))]
                               (and (>= (sx-len xs) (primitive/cast i64 2))
                                    (and (= (sx-tag (sx-at xs 0)) (primitive/cast i64 2))
                                         (= (sx-sval (sx-at xs 0)) name)))))
                    (store! out x)
                    (break)))
                (set! i (primitive/iadd (load i) 1)))))
    (load out)))
(defn defderive-push! [(out (ptr (ArrayList TaggedForm)))
                       (module (Option (slice u8)))
                       (form Sexp)] (-> i64)
  (let [tf (alloc/stack TaggedForm)]
    (set! (.form tf) form)
    (set! (.module tf) module)
    (al-push! [TaggedForm] out (load tf))
    0))
;; `[T]` in an arm is intentionally concise; the desugared comptime function
;; takes the corresponding `[(T Code)]` parameter vector.
(defn defderive-params [(a (ptr Allocator)) (arm (ptr Sexp))] (-> Sexp)
  (let [xs (sx-items (load arm))
        raw (sx-at xs 1)
        ps (sx-items raw)
        n (sx-len ps)
        (mut out) (al-new [Sexp] a)
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (if (and (= (sx-tag (sx-at ps (load i))) (primitive/cast i64 2))
                       (= (sx-sval (sx-at ps (load i))) "&"))
                  (do
                    (al-push! (mut out) (sx-sym "&"))
                    (let [(mut p) (al-new [Sexp] a)]
                      (al-push! (mut p) (sx-at ps (primitive/iadd (load i) 1)))
                      (al-push! (mut p) (sx-sym "Code"))
                      (al-push! (mut out) (sx-mklist (box-al [Sexp] a (load p)))))
                    (set! i (primitive/iadd (load i) 2)))
                  (let [(mut p) (al-new [Sexp] a)]
                    (al-push! (mut p) (sx-at ps (load i)))
                    (al-push! (mut p) (sx-sym "Code"))
                    (al-push! (mut out) (sx-mklist (box-al [Sexp] a (load p))))
                    (set! i (primitive/iadd (load i) 1))))))
    (mk-sexp (KVec (box-al [Sexp] a (load out))) -1 -1)))
(defn defderive-desugar! [(s (mut LS))] (-> (Option Diag))
  (let [a (load (field s a))
        old (box-al [TaggedForm] a (.out s))
        (mut out) (al-new [TaggedForm] a)
        n (al-len [TaggedForm] (load old))
        (mut i) 0
        (mut errf) (None [Diag])]
    (loop (if (or (diag-some? (load errf)) (>= (load i) n))
              (break)
              (do
                (let [tf (al-elem [TaggedForm] old (load i))
                      f (field tf form)]
                  (if (not (defderive-form? f))
                      (al-push! (mut out) (load tf))
                      (let [it (sx-items (load f))]
                        (if (or (!= (sx-tag (sx-at it 1)) (primitive/cast i64 2))
                                (< (sx-len it) (primitive/cast i64 3)))
                            (set! errf
                                  (Some (derr "defderive: expected (defderive Trait (struct [T] BODY...) (sum [T] BODY...))")))
                            (let [trait (sx-sval (sx-at it 1))
                                  sa (defderive-arm it "struct")
                                  ua (defderive-arm it "sum")]
                              (if (and (= (primitive/cast i64 sa) (primitive/cast i64 0))
                                       (= (primitive/cast i64 ua) (primitive/cast i64 0)))
                                  (set! errf (Some (derr "defderive: needs at least one struct or sum arm")))
                                  (let [sn (sconcat a "__derive_struct_" trait)
                                        un (sconcat a "__derive_sum_" trait)
                                        owner (match (.module tf) (Some [m] m) (None [] ""))
                                        qsn (if (= owner "") sn (sconcat3 a owner "." sn))
                                        qun (if (= owner "") un (sconcat3 a owner "." un))]
                                    (when (!= (primitive/cast i64 sa) (primitive/cast i64 0))
                                      (let [xs (sx-items (load sa))
                                            (mut ds) (al-new [Sexp] a)
                                            m (sx-len xs)
                                            (mut j) 2]
                                        (al-push! (mut ds) (sx-sym "defn"))
                                        (al-push! (mut ds) (sx-sym sn))
                                        (al-push! (mut ds) (defderive-params a sa))
                                        (let [(mut ret) (al-new [Sexp] a)]
                                          (al-push! (mut ret) (sx-sym "->"))
                                          (al-push! (mut ret) (sx-sym "Code"))
                                          (al-push! (mut ds) (sx-mklist (box-al [Sexp] a (load ret)))))
                                        (loop (if (>= (load j) m)
                                                  (break)
                                                  (do
                                                    (al-push! (mut ds) (sx-at xs (load j)))
                                                    (store! j (primitive/iadd (load j) 1)))))
                                        (defderive-push! (mut out)
                                                         (load (field tf module))
                                                         (sx-mklist (box-al [Sexp] a (load ds))))))
                                    (when (!= (primitive/cast i64 ua) (primitive/cast i64 0))
                                      (let [xs (sx-items (load ua))
                                            (mut ds) (al-new [Sexp] a)
                                            m (sx-len xs)
                                            (mut j) 2]
                                        (al-push! (mut ds) (sx-sym "defn"))
                                        (al-push! (mut ds) (sx-sym un))
                                        (al-push! (mut ds) (defderive-params a ua))
                                        (let [(mut ret) (al-new [Sexp] a)]
                                          (al-push! (mut ret) (sx-sym "->"))
                                          (al-push! (mut ret) (sx-sym "Code"))
                                          (al-push! (mut ds) (sx-mklist (box-al [Sexp] a (load ret)))))
                                        (loop (if (>= (load j) m)
                                                  (break)
                                                  (do
                                                    (al-push! (mut ds) (sx-at xs (load j)))
                                                    (store! j (primitive/iadd (load j) 1)))))
                                        (defderive-push! (mut out)
                                                         (load (field tf module))
                                                         (sx-mklist (box-al [Sexp] a (load ds))))))
                                    (let [(mut rs) (al-new [Sexp] a)]
                                      (al-push! (mut rs) (sx-sym "register-derive"))
                                      (al-push! (mut rs) (sx-sym trait))
                                      (when (!= (primitive/cast i64 sa) (primitive/cast i64 0))
                                        (al-push! (mut rs) (mk-sexp (KKw "struct") -1 -1))
                                        (al-push! (mut rs) (sx-sym qsn)))
                                      (when (!= (primitive/cast i64 ua) (primitive/cast i64 0))
                                        (al-push! (mut rs) (mk-sexp (KKw "sum") -1 -1))
                                        (al-push! (mut rs) (sx-sym qun)))
                                      (defderive-push! (mut out)
                                                       (.module tf)
                                                       (sx-mklist (box-al [Sexp] a (load rs))))))))))))
                (set! i (primitive/iadd (load i) 1)))))
    (match (load errf)
      (Some [d] (Some d))
      (None [] (do (set! (.out s) (load out)) (None [Diag]))))))

(defn expand-stage3 [(s (mut LS))] (-> (Result i64 Diag))
  (let [a (load (field s a))
        (mut errf) (defderive-desugar! (mut s))]
    (match (load errf)
      (Some [d] (Err [i64 Diag] d))
      (None []
            (let [out-forms (box-al [TaggedForm] a (.out s))
                  original-metas (tower-meta-snapshot a out-forms)]
              ; the macro context is the WHOLE program (tolerant resolve skips the
              ; not-yet-expanded top-level macro calls), in a FRESH form list: the shim and
              ; the tower replace sub-program entries; s.out must stay untouched.
              (match (meta-sub-forms a (mut s) out-forms)
                (Err [d] (Err [i64 Diag] d))
                (Ok [sub-forms]
                    (stage3-round (mut s)
                                  sub-forms
                                  a
                                  0
                                  (al-len [TaggedForm] (load out-forms))
                                  original-metas))))))))

; After the tower rewrote metaprogram-body macro calls in the SUB list, mirror
; those forms back into s.out (index-aligned 1:1 for the first n entries — the sub
; list is a copy of s.out, plus the shim appended at the END). The main program's
; authoritative check sees metaprogram bodies too (they are only dropped before
; mono), so they must be the EXPANDED ones there as well. Value-identical for
; every form the tower didn't touch.
(defn tower-sync-out! [(s (mut LS)) (sub-forms (ptr (ArrayList TaggedForm)))] (-> i64)
  (set! (.out s) (load sub-forms))
  0)

; Snapshot the authoritative prefix without sharing the ArrayList buffer. Engine
; setup re-enters lazy staging and may overwrite both its temporary subprogram and
; s.out; this stable copy is restored after that nested compilation returns.
(defn tower-clone-sexp [(a (ptr Allocator)) (x (ptr Sexp))] (-> Sexp)
  (let [tag (sx-tag (load x))]
    (if (or (= tag (primitive/cast i64 6)) (= tag (primitive/cast i64 7)))
        (let [items (sx-items (load x))
              n (sx-len items)
              (mut out) (al-new [Sexp] a)
              (mut i) 0]
          (loop (if (>= (load i) n)
                    (break)
                    (do
                      (al-push! (mut out) (tower-clone-sexp a (al-elem [Sexp] items (load i))))
                      (set! i (primitive/iadd (load i) 1)))))
          (mk-sexp-src (if (= tag (primitive/cast i64 6))
                           (KList (box-al [Sexp] a (load out)))
                           (KVec (box-al [Sexp] a (load out))))
                       x))
        (load x))))

(defn tower-snapshot [(a (ptr Allocator))
                      (sub-forms (ptr (ArrayList TaggedForm)))
                      (n i64)] (-> (ptr (ArrayList TaggedForm)))
  (let [(mut out) (al-new [TaggedForm] a)
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (let [src (al-elem [TaggedForm] sub-forms (load i))
                      dst (alloc/stack TaggedForm)]
                  (set! (.form dst) (tower-clone-sexp a (field src form)))
                  (set! (.module dst) (.module src))
                  (al-push! (mut out) (load dst)))
                (set! i (primitive/iadd (load i) 1)))))
    (box-al [TaggedForm] a (load out))))

(defn tower-meta-snapshot [(a (ptr Allocator))
                           (forms (ptr (ArrayList TaggedForm)))] (-> (ptr (ArrayList TaggedForm)))
  (let [(mut out) (al-new [TaggedForm] a)
        n (al-len [TaggedForm] (load forms))
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (let [src (al-elem [TaggedForm] forms (load i))]
                  (when (is-meta-form (field src form))
                    (let [dst (alloc/stack TaggedForm)]
                      (store! (field dst form) (tower-clone-sexp a (field src form)))
                      (store! (field dst module) (load (field src module)))
                      (al-push! (mut out) (load dst)))
                    0))
                (set! i (primitive/iadd (load i) 1)))))
    (box-al [TaggedForm] a (load out))))

(defn tower-capture-metas! [(a (ptr Allocator))
                            (forms (ptr (ArrayList TaggedForm)))
                            (metas (ptr (ArrayList TaggedForm)))] (-> i64)
  (when (= (al-len [TaggedForm] (load metas)) (primitive/cast i64 0))
    (let [n (al-len [TaggedForm] (load forms))
          (mut i) 0]
      (loop (if (>= (load i) n)
                (break)
                (do
                  (let [src (al-elem [TaggedForm] forms (load i))]
                    (when (is-meta-form (field src form))
                      (let [dst (alloc/stack TaggedForm)]
                        (store! (field dst form) (tower-clone-sexp a (field src form)))
                        (store! (field dst module) (load (field src module)))
                        (al-push! [TaggedForm] metas (load dst)))
                      0))
                  (store! i (primitive/iadd (load i) 1))))))
    0)
  0)

(defn tower-restore-metas! [(s (mut LS))
                            (metas (ptr (ArrayList TaggedForm)))] (-> i64)
  (let [a (load (field s a))
        old (box-al [TaggedForm] a (.out s))
        (mut out) (al-new [TaggedForm] a)
        no (al-len [TaggedForm] (load old))
        (mut j) 0
        n (al-len [TaggedForm] (load metas))
        (mut i) 0]
    (loop (if (>= (load j) no)
              (break)
              (do
                (let [tf (al-elem [TaggedForm] old (load j))]
                  (unless (is-meta-form (field tf form))
                    (al-push! (mut out) (load tf))
                    0))
                (set! j (primitive/iadd (load j) 1)))))
    (loop (if (>= (load i) n)
              (break)
              (do
                (al-push! (mut out) (al-get [TaggedForm] (load metas) (load i)))
                (set! i (primitive/iadd (load i) 1)))))
    (set! (.out s) (load out))
    0))

(defn stage3-round [(s (mut LS))
                    (sub-forms (ptr (ArrayList TaggedForm)))
                    (a (ptr Allocator))
                    (round i64)
                    (nmain i64)
                    (original-metas (ptr (ArrayList TaggedForm)))] (-> (Result i64
                                                                               Diag))
  (tower-capture-metas! a sub-forms original-metas)
  ; Each failed tower generation builds a complete tolerant Program and checked
  ; closure. Those are generation-local. Keeping them in the compiler's root arena
  ; retained every failed generation until process exit. A segmented scratch arena
  ; lets retry paths release the entire generation in O(number-of-segments).
  (let [work (alloc/stack scratch/ScratchArena)
        _work-init (scratch/scratch-init-with-cap work (malloc-allocator) 1048576)
        wa (scratch/scratch-allocator work)
        subls (alloc/stack LS)]
    (set! (.a subls) wa)
    (set! (.out subls) (load sub-forms))
    (set! (.loaded subls) (al-new [(slice u8)] wa))
    (set! (.readpaths subls) (al-new [(slice u8)] wa))
    (set! (.readmods subls) (al-new [(slice u8)] wa))
    (set! (.imports subls) (.imports s))
    (set! (.exports subls) (.exports s))
    (set! (.primitive_defs subls) (.primitive_defs s))
    (set! (.primitive_aliases subls) (.primitive_aliases s))
    (match (resolve-program wa (mut subls) false true)
      (Err [d] (Err [i64 Diag] d))
      (Ok [macroctx]
          (let [quals (code-sig-funcs macroctx wa)]
            ; record this round's forms for the LAZY stager: finish-macro stages a
            ; qual on its first miss (see stage-one-macro!). Recording is free; the
            ; per-round refresh keeps the convergence property (a qual unstageable in
            ; round N often stages in round N+1, after the tower expanded a call in
            ; one of its callees).
            (when (meta-compiled?) (stage-box-set! (mut s) sub-forms a))
            (if (= (al-len [(slice u8)] (load quals)) (primitive/cast i64 0))
                (Ok [i64 Diag] 0)
                ; PARSE-level tower: a defn the tolerant resolve SKIPPED may contain a
                ; macro call whose arguments are not expression syntax (objc `msg`
                ; type vectors) — expand it and re-resolve before anything else.
                (match (stage3-parse-recover (mut s) sub-forms macroctx quals a)
                  (Err [d] (Err [i64 Diag] d))
                  (Ok [phit]
                      (if (!= phit (primitive/cast i64 0))
                          (if (>= round (primitive/cast i64 64))
                              (Err [i64 Diag]
                                   (derr "metaprogram definition-time expansion did not reach a fixpoint after 64 rounds"))
                              (let [_release (scratch/scratch-close! work)
                                    rr (stage3-round (mut s) sub-forms a (primitive/iadd round 1) nmain original-metas)]
                                rr))
                          ; the closure seeds gain the shim functions under the compiled engine:
                          ; lowering creates calls to them AFTER this walk runs.
                          (let [seeds (if (meta-compiled?) (meta-shim-seeds wa macroctx quals) quals)
                                wanted (closure-funcs macroctx seeds wa)
                                sub (closure-subprogram macroctx wanted wa)
                                checkls (alloc/stack LS)]
                            (set! (.a checkls) wa)
                            (set! (.out checkls) (al-new [TaggedForm] wa))
                            (set! (.loaded checkls) (al-new [(slice u8)] wa))
                            (set! (.readpaths checkls) (al-new [(slice u8)] wa))
                            (set! (.readmods checkls) (al-new [(slice u8)] wa))
                            (set! (.imports checkls) (al-new [ImpEntry] wa))
                            (set! (.exports checkls) (al-new [ExpEntry] wa))
                            (set! (.primitive_defs checkls) (al-new [PrimitiveDef] wa))
                            (set! (.primitive_aliases checkls) (al-new [PrimitiveAlias] wa))
                            ; this LS checks a closure sub-program WITHOUT a resolve pass, so the
                            ; poison list must be nulled or func-poisoned? reads garbage.
                            (set! (.check_diags checkls) (box-al [Diag] wa (al-new [Diag] wa)))
                            (set! (.resolve_diags checkls) (primitive/cast (ptr (ArrayList Diag)) 0))
                            (set! (.resolve_poisoned checkls) (primitive/cast (ptr (ArrayList (slice u8))) 0))
                            (match (check-program wa sub (mut checkls))
                              (Ok [checked]
                                  ; Snapshot only the successful generation. Taking
                                  ; this full-program copy at function entry retained
                                  ; one copy in every recursive tower frame (often
                                  ; 15+ copies and several GiB) even though failures
                                  ; immediately recurse and never consume it.
                                  (let [tower-out (tower-snapshot a sub-forms nmain)]
                                    ; compiled engine: lower + build + dlopen the metaprogram dylib
                                    ; ONCE; finish-macro then routes every entry through it.
                                    (match (if (meta-compiled?) (meta-engine-setup a checked quals) (None [Diag]))
                                      (Some [d] (Err [i64 Diag] d))
                                      (None []
                                            (do
                                              (when (> round (primitive/cast i64 0))
                                                (tower-sync-out! (mut s) tower-out))
                                              (match (run-expand (mut s) quals wanted checked a)
                                                (Err [d] (Err [i64 Diag] d))
                                                (Ok [_]
                                                    (do
                                                      (tower-restore-metas! (mut s) original-metas)
                                                      (Ok [i64 Diag] 0)))))))))
                              (Err [d]
                                   ; the tower: if the check rejected the sub-program AT a
                                   ; macro-headed call form, expand that call and go again; if it
                                   ; rejected a call to a SKIPPED defn, recover that defn.
                                   (if (>= round (primitive/cast i64 64))
                                       (Err [i64 Diag]
                                            (derr "metaprogram definition-time expansion did not reach a fixpoint after 64 rounds"))
                                       (let [dp (alloc/stack Diag)]
                                         (set! dp d)
                                         (let [tc
                                                 (mk-tower-cx (mut s)
                                                              sub-forms
                                                              macroctx
                                                              quals
                                                              a
                                                              (.lo dp)
                                                              (.hi dp)
                                                              (.source dp))]
                                           (match (tower-pass tc (mut s) sub-forms)
                                             (Err [d2] (Err [i64 Diag] d2))
                                             (Ok [hit]
                                                 (match (if (= hit (primitive/cast i64 0))
                                                            (tower-recover-called tc (mut s) sub-forms macroctx)
                                                            (Ok [i64 Diag] hit))
                                                   (Err [d3] (Err [i64 Diag] d3))
                                                   (Ok [hit2]
                                                       (if (= hit2 (primitive/cast i64 0))
                                                           (Err [i64 Diag] d)  ; a real error — surface it untouched
                                                           ; the let defeats self-tail-call elimination (musttail
                                                           ; rejects this frame); depth is bounded by the 64-round cap
                                                           (let [_release (scratch/scratch-close! work)
                                                                 rr
                                                                   (stage3-round (mut s)
                                                                                 sub-forms
                                                                                 a
                                                                                 (primitive/iadd round 1)
                                                                                 nmain
                                                                                 original-metas)]
                                                             rr)))))))))))))))))))))
; ── whole-program CHECKERS ───────────────────────────────────────────────────
; `(checker FN)` registers FN — a [(prog Code)] -> Code function — to be run once,
; after expansion, over the WHOLE program (all top-level forms as one Code list).
; A checker VETOES compilation by calling `error`; its returned Code is ignored.
; FN is Code-signed so the existing macro machinery already type-checks it; we just
; invoke it here via expand-macro with the program as its single argument.
(defn is-checker-form [(f (ptr Sexp))] (-> bool)
  (and (= (sx-tag (load f)) (primitive/cast i64 6))
       (let [it (sx-items (load f))]
         (and (or (= (sx-len it) (primitive/cast i64 2)) (= (sx-len it) (primitive/cast i64 4)))
              (and (= (sx-tag (sx-at it 0)) (primitive/cast i64 2)) (= (sx-sval (sx-at it 0)) "checker"))))))

; `(checker FN :phase before-expand)` and `(transform FN :phase before-expand)`
; are syntax-phase registrations. The unqualified two-item forms retain their
; existing semantic behavior. Keep this deliberately exact: accepting arbitrary
; options here would silently turn a misspelled phase into a different pipeline.
(defn before-expand-registration? [(f (ptr Sexp))] (-> bool)
  (and (= (sx-tag (load f)) (primitive/cast i64 6))
       (let [it (sx-items (load f))]
         (and (= (sx-len it) (primitive/cast i64 4))
              (and (and (= (sx-tag (sx-at it 2)) (primitive/cast i64 3))
                        (= (sx-sval (sx-at it 2)) "phase"))
                   (and (= (sx-tag (sx-at it 3)) (primitive/cast i64 2))
                        (= (sx-sval (sx-at it 3)) "before-expand")))))))
(defn read-registration? [(f (ptr Sexp))] (-> bool)
  (and (= (sx-tag (load f)) (primitive/cast i64 6))
       (let [it (sx-items (load f))]
         (and (= (sx-len it) (primitive/cast i64 4))
              (and (and (= (sx-tag (sx-at it 2)) (primitive/cast i64 3))
                        (= (sx-sval (sx-at it 2)) "phase"))
                   (and (= (sx-tag (sx-at it 3)) (primitive/cast i64 2))
                        (= (sx-sval (sx-at it 3)) "read")))))))

(defsum ReadProviderResult
  (ReadDefault [])
  (ReadForms [(form Sexp)])
  (ReadFailed [(diag Diag)]))

(defn run-read-provider-named [(a (ptr Allocator))
                               (s (mut LS))
                               (checked (ptr Program))
                               (name (slice u8))
                               (context Sexp)] (-> ReadProviderResult)
  (let [allfns (all-defn-names (box-al [TaggedForm] a (.out s)) a)
        gs (unwrap-ptr [SBoxStruct] (create [SBoxStruct] a))
        gu (unwrap-ptr [SBoxSum] (create [SBoxSum] a))
        (mut args) (al-new [Sexp] a)]
    (set! (.items gs) (al-new [StructDef] a))
    (set! (.items gu) (al-new [SumDef] a))
    (al-push! (mut args) context)
    (match (expand-macro checked
                         name
                         (box-al [Sexp] a (load args))
                         (field allfns items)
                         (field gs items)
                         (field gu items)
                         (field s imports)
                         (field s exports)
                         a)
      (Err [d] (ReadFailed d))
      (Ok [out] (ReadForms out)))))

;; Invoke the one read provider registered by a separately compiled setup graph.
;; The provider receives one Code context and returns either `(do FORM ...)` or a
;; single form. More than one provider is ambiguous: wrappers belong inside the
;; provider function itself, where ordinary Coil composition can express them.
(defn run-read-provider [(a (ptr Allocator))
                         (s (mut LS))
                         (checked (ptr Program))
                         (context Sexp)] (-> ReadProviderResult)
  (let [n (al-len [TaggedForm] (.out s))
        (mut found) ""
        (mut duplicate) false]
    (for [i 0 n]
      (let [tf (al-elem [TaggedForm] (field s out) i)]
        (when (read-registration? (field tf form))
          (let [items (sx-items (load (field tf form)))
                local (sx-sval (sx-at items 1))
                module (match (load (field tf module)) (Some [m] m) (None [] ""))
                qualified (if (= module "") local (sconcat3 a module "." local))]
            (if (= (load found) "") (store! found qualified) (store! duplicate true)))
          0)))
    (if (load duplicate)
        (ReadFailed (derr "read phase: compiler setup registered more than one read provider"))
        (if (= (load found) "")
            (ReadDefault)
            (run-read-provider-named a (mut s) checked (load found) context)))))
; group the flat tagged forms into one record per module `(name form…)`, so a
; checker is handed the program AS MODULES and decides which to look at. Imports
; are loaded depth-first, so a module's tagged forms need not be contiguous: the
; entry module can be interrupted by every dependency it imports. Grouping only
; contiguous runs silently split that namespace and made later runs lose module
; declarations such as `(import "coil.scheme" ...)`.
(defn opt-mod-name [(m (Option (slice u8)))] (-> (slice u8))
  (match m (Some [s] s) (None [] "")))
(defn build-modules [(a (ptr Allocator)) (forms (ptr (ArrayList TaggedForm)))] (-> Sexp)
  (let [nf (al-len [TaggedForm] (load forms))
        (mut mods) (al-new [Sexp] a)
        (mut i) 0]
    (loop (if (>= (load i) nf)
              (break)
              (do
                (let [tf (al-elem [TaggedForm] forms (load i))
                      nm (opt-mod-name (.module tf))
                      (mut dst) (primitive/cast (ptr (ArrayList Sexp)) 0)
                      (mut j) 0]
                  (loop (if (>= (load j) (al-len [Sexp] (load mods)))
                            (break)
                            (let [items (sx-items (al-get [Sexp] (load mods) (load j)))]
                              (if (= (sx-sval (sx-at items 0)) nm)
                                  (do (set! dst items) (break))
                                  (set! j (primitive/iadd (load j) 1))))))
                  (when (= (primitive/cast i64 (load dst)) (primitive/cast i64 0))
                    (let [(mut fresh) (al-new [Sexp] a)]
                      (al-push! (mut fresh) (sx-sym nm))
                      (store! dst (box-al [Sexp] a (load fresh)))
                      (al-push! (mut mods) (mk-sexp (KList (load dst)) -1 -1)))
                    0)
                  (al-push! (load dst) (.form tf)))
                (set! i (primitive/iadd (load i) 1)))))
    (mk-sexp (KList (box-al [Sexp] a (load mods))) -1 -1)))
; Every source file that DEFINES a checker, by id. A checker is registered under its
; qualified name (`ifcombine.lint-combine-ifs`), so the module that owns it is the part
; before the last dot; any form tagged with that module names the file it came from.
; `cop-record-fix` uses the set to refuse a fix that would rewrite the rules the run is
; being driven by — see the note there for why that corrupts a file rather than merely
; being odd.
(defn checker-owns? [(checkers (ptr (ArrayList (slice u8)))) (m (slice u8))] (-> bool)
  (let [nc (al-len [(slice u8)] (load checkers))
        (mut i) 0
        (mut r) false]
    (loop (if (>= (load i) nc)
              (break)
              (if (starts-with (al-get [(slice u8)] (load checkers) (load i))
                               (sconcat (malloc-allocator) m "."))
                  (do (set! r true) (break))
                  (set! i (primitive/iadd (load i) 1)))))
    (load r)))

(defn mark-rule-sources [(checkers (ptr (ArrayList (slice u8)))) (forms (ptr (ArrayList TaggedForm)))] (-> i64)
  (rule-src-reset)
  (let [nf (al-len [TaggedForm] (load forms))
        (mut i) 0]
    (loop (if (>= (load i) nf)
              (break)
              (do
                (let [tf (al-elem [TaggedForm] forms (load i))]
                  (match (.module tf)
                    (None [] 0)
                    (Some [m]
                          (when (checker-owns? checkers m)
                            (rule-src-add (sx-source (load (field tf form))))))))
                (set! i (primitive/iadd (load i) 1))))))
  0)

(defn run-checkers [(checkers (ptr (ArrayList (slice u8))))
                    (checked (ptr Program))
                    (forms (ptr (ArrayList TaggedForm)))
                    (allfns (ptr SBox))
                    (gs (ptr SBoxStruct))
                    (gu (ptr SBoxSum))
                    (impb (ptr (ArrayList ImpEntry)))
                    (expb (ptr (ArrayList ExpEntry)))
                    (a (ptr Allocator))] (-> (Option Diag))
  (let [nc (al-len [(slice u8)] (load checkers))]
    (if (= nc (primitive/cast i64 0))
        (None [Diag])
        ; hand the checker the program as a LIST OF MODULES: ((name form…) …) — it owns
        ; the loop and decides which modules to look at.
        (let [_rs (mark-rule-sources checkers forms)
              proglist (build-modules a forms)
              (mut margs) (al-new [Sexp] a)]
          (al-push! (mut margs) proglist)
          (let [(mut j) 0
                (mut err) (None [Diag])
                margsb (box-al [Sexp] a (load margs))]
            (loop (if (or (diag-some? (load err)) (>= (load j) nc))
                      (break)
                      (do
                        (let [checker-name (al-get [(slice u8)] (load checkers) (load j))
                              checker-span (tr/span-begin checker-name)]
                          (match (expand-macro checked
                                               checker-name
                                               margsb
                                               (field allfns items)
                                               (field gs items)
                                               (field gu items)
                                               impb
                                               expb
                                               a)
                            (Err [d] (do (set! err (Some d)) 0))
                            (Ok [_] 0))
                          (tr/span-end checker-span))
                        (set! j (primitive/iadd (load j) 1)))))
            (load err))))))
; ── deferred CHECKER registry ────────────────────────────────────────────────
; Checkers are SEMANTIC: they run after the whole program is resolved + typechecked,
; so they read the compiler's authoritative output (real qualified names, real
; signatures) via the semantic model — not a parallel resolver. run-expand collects
; the checker names + the compiled metaprogram closure here; run-registered-checkers
; (invoked from run-pipeline after frontend-check) sets the semantic model and runs them.
(defstruct CheckerReg
  [(active i64)
   (precheckers (ptr (ArrayList (slice u8))))
   (checkers (ptr (ArrayList (slice u8))))
   (semtx (ptr (ArrayList (slice u8))))
   (checked (ptr Program))
   (allfns (ptr SBox))
   (gs (ptr SBoxStruct))
   (gu (ptr SBoxSum))])
(defstruct CheckerRegBox [(init i64) (reg CheckerReg)])
(defn checker-reg-box [] (-> (ptr CheckerRegBox))
  (alloc/static CheckerRegBox))
(defn register-checkers [(precheckers (ptr (ArrayList (slice u8))))
                         (checkers (ptr (ArrayList (slice u8))))
                         (semtx (ptr (ArrayList (slice u8))))
                         (checked (ptr Program))
                         (allfns (ptr SBox))
                         (gs (ptr SBoxStruct))
                         (gu (ptr SBoxSum))] (-> i64)
  (let [b (checker-reg-box)
        r (field b reg)]
    (set! (.active r) 1)
    (set! (.precheckers r) precheckers)
    (set! (.checkers r) checkers)
    (set! (.semtx r) semtx)
    (set! (.checked r) checked)
    (set! (.allfns r) allfns)
    (set! (.gs r) gs)
    (set! (.gu r) gu)
    (set! (.init b) 1)
    0))
; Run the registered checkers over the authoritative checked Program `cp`. Called
; from run-pipeline AFTER frontend-check. Always sets the semantic model (so
; `code-decl` reads real work) and drains collected warnings/errors.
(defn run-registered-checkers [(a (ptr Allocator)) (s (mut LS)) (cp (ptr Program))] (-> (Result i64 Diag))
  (set-sem-model cp)
  (let [b (checker-reg-box)]
    (if (= (.init b) (primitive/cast i64 0))
        (Ok [i64 Diag] 0)
        (let [r (field b reg)]
          (if (= (.active r) (primitive/cast i64 0))
              (Ok [i64 Diag] 0)
              (let [forms (box-al [TaggedForm] a (.out s))
                    impb (unwrap-ptr [(ArrayList ImpEntry)] (create [(ArrayList ImpEntry)] a))
                    expb (unwrap-ptr [(ArrayList ExpEntry)] (create [(ArrayList ExpEntry)] a))]
                (set! impb (.imports s))
                (set! expb (.exports s))
                (match (run-checkers (load (field r checkers))
                                     (load (field r checked))
                                     forms
                                     (load (field r allfns))
                                     (load (field r gs))
                                     (load (field r gu))
                                     impb
                                     expb
                                     a)
                  (Some [d] (do (drain-warnings (mut s)) (Err [i64 Diag] d)))
                  (None []
                        (do
                          (drain-warnings (mut s))
                          (if (> (diag-errs) (primitive/cast i64 0))
                              (Err [i64 Diag] (derr "compilation failed: checker reported error(s) above"))
                              (Ok [i64 Diag] 0)))))))))))

; Invoke ONE Code-signed entry (a code->code `main`) with explicit arguments,
; exactly as a registered checker is invoked: the same metaprogram context the
; run-expand pre-scan registered, the same expand-macro boundary (arena,
; promotion, lazy staging via finish-macro), the same warning drain. This is
; the whole engine side of `coil run` on a code->code program — see
; docs/design/RUN_METAPROGRAMS.md.
(defn run-code-main [(a (ptr Allocator))
                     (s (mut LS))
                     (cp (ptr Program))
                     (qual (slice u8))
                     (margs (ptr (ArrayList Sexp)))] (-> (Result Sexp Diag))
  (set-sem-model cp)
  (let [b (checker-reg-box)]
    (if (= (.init b) (primitive/cast i64 0))
        (Err [Sexp Diag] (derr "code->code run: the metaprogram context was not registered (compiler bug)"))
        (let [r (field b reg)
              impb (unwrap-ptr [(ArrayList ImpEntry)] (create [(ArrayList ImpEntry)] a))
              expb (unwrap-ptr [(ArrayList ExpEntry)] (create [(ArrayList ExpEntry)] a))]
          (set! impb (.imports s))
          (set! expb (.exports s))
          (let [res (expand-macro (load (field r checked))
                                  qual
                                  margs
                                  (field (load (field r allfns)) items)
                                  (field (load (field r gs)) items)
                                  (field (load (field r gu)) items)
                                  impb
                                  expb
                                  a)]
            (drain-warnings (mut s))
            res)))))

; Project lint compiles the checker graph separately from the target graph. The
; registered functions above are still the ordinary Coil metaprograms; this path
; merely supplies their target Code without expanding and retaining an application
; the size of the whole project.
(defn project-code-macros [(a (ptr Allocator))
                           (forms (ptr (ArrayList TaggedForm)))] (-> (ptr (ArrayList (slice u8))))
  (let [(mut out) (al-new [(slice u8)] a)
        n (al-len [TaggedForm] (load forms))
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (let [tf (al-elem [TaggedForm] forms (load i))]
                  (when (raw-code-sig? (field tf form))
                    (match (defn-name-of (field tf form))
                      (Some [name]
                            (al-push! (mut out) (qualify-name a name (load (field tf module)))))
                      (None [] 0))
                    0))
                (set! i (primitive/iadd (load i) 1)))))
    (box-al [(slice u8)] a (load out))))

(defn project-code-macro-index [(a (ptr Allocator))
                                (macros (ptr (ArrayList (slice u8))))] (-> (ptr (HashMap (slice u8) bool)))
  (let [(mut out) (hm-new [(slice u8) bool] a (str-keyops))
        n (al-len [(slice u8)] (load macros))
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (hm-put! [(slice u8) bool]
                         (mut out)
                         (decl-simple-name (al-get [(slice u8)] (load macros) (load i)))
                         true)
                (set! i (primitive/iadd (load i) 1)))))
    (box a (HashMap (slice u8) bool) (load out))))

(defn project-mark-generated! [(node (ptr Sexp))] (-> i64)
  (set! (.ctxt node) 1)
  (let [tg (sx-tag (load node))]
    (when (or (= tg (primitive/cast i64 6)) (= tg (primitive/cast i64 7)))
      (let [items (sx-items (load node))
            n (sx-len items)
            (mut i) 0]
        (loop (if (>= (load i) n)
                  (break)
                  (do
                    (project-mark-generated! (al-elem [Sexp] items (load i)))
                    (store! i (primitive/iadd (load i) 1))))))
      0))
  0)

; Mark authored syntax that sits underneath a macro call. A normal expanded graph
; carries this fact in Sexp.ctxt; reproducing the provenance bit from the registered
; Code signatures lets semantic checkers keep using `code-macro?` without forcing
; expansion of unrelated application code.
(defn project-mark-macro-scopes! [(a (ptr Allocator))
                                  (node (ptr Sexp))
                                  (module (Option (slice u8)))
                                  (macros (ptr (ArrayList (slice u8))))
                                  (macro-index (ptr (HashMap (slice u8) bool)))
                                  (impb (ptr (ArrayList ImpEntry)))
                                  (expb (ptr (ArrayList ExpEntry)))] (-> i64)
  (let [tg (sx-tag (load node))]
    (when (or (= tg (primitive/cast i64 6)) (= tg (primitive/cast i64 7)))
      (let [items (sx-items (load node))
            n (sx-len items)
            head
              (if (and (= tg (primitive/cast i64 6))
                       (and (> n 0) (= (sx-tag (sx-at items 0)) (primitive/cast i64 2))))
                  (sx-sval (sx-at items 0))
                  "")]
        (if (or (= head "quote") (= head "quasiquote"))
            0
            (match (if (or (= head "")
                           (not (match (hm-get [(slice u8) bool]
                                               (load macro-index)
                                               (decl-simple-name head))
                                  (Some [_] true)
                                  (None [] false))))
                       (None [(slice u8)])
                       (resolve-macro head module macros impb expb a))
              (Some [_]
                    (macro-call-record (sx-nid (load node))))
              (None []
                    (let [(mut i) 0]
                      (loop (if (>= (load i) n)
                                (break)
                                (do
                                  (project-mark-macro-scopes! a
                                                              (al-elem [Sexp] items (load i))
                                                              module
                                                              macros
                                                              macro-index
                                                              impb
                                                              expb)
                                  (store! i (primitive/iadd (load i) 1))))))))))
      0))
  0)

(defn run-project-registered-checkers [(a (ptr Allocator))
                                       (s (mut LS))
                                       (cp (ptr Program))] (-> (Result i64 Diag))
  (let [b (checker-reg-box)]
    (if (= (.init b) (primitive/cast i64 0))
        (Ok [i64 Diag] 0)
        (let [r (field b reg)
              forms (box-al [TaggedForm] a (.out s))
              impb (unwrap-ptr [(ArrayList ImpEntry)] (create [(ArrayList ImpEntry)] a))
              expb (unwrap-ptr [(ArrayList ExpEntry)] (create [(ArrayList ExpEntry)] a))]
          (set! impb (.imports s))
          (set! expb (.exports s))
          (set-cli-sources (field s sources))
          (set-sem-model cp)
          (macro-call-reset)
          (let [macros (project-code-macros a forms)
                macro-index (project-code-macro-index a macros)
                n (al-len [TaggedForm] (load forms))
                (mut i) 0]
            (loop (if (>= (load i) n)
                      (break)
                      (do
                        (let [tf (al-elem [TaggedForm] forms (load i))]
                          (project-mark-macro-scopes! a
                                                      (field tf form)
                                                      (.module tf)
                                                      macros
                                                      macro-index
                                                      impb
                                                      expb))
                        (set! i (primitive/iadd (load i) 1)))))
            0)
          ; Syntax-phase checkers see the untouched authored forms.
          (let [(mut err)
                  (run-checkers (load (field r precheckers))
                                (load (field r checked))
                                forms
                                (load (field r allfns))
                                (load (field r gs))
                                (load (field r gu))
                                impb
                                expb
                                a)]
            (when (not (diag-some? (load err)))
              (store! err
                      (run-checkers (load (field r checkers))
                                    (load (field r checked))
                                    forms
                                    (load (field r allfns))
                                    (load (field r gs))
                                    (load (field r gu))
                                    impb
                                    expb
                                    a))
              0)
            (drain-warnings (mut s))
            (match (load err)
              (Some [d] (Err [i64 Diag] d))
              (None []
                    (if (> (diag-errs) 0)
                        (Err [i64 Diag] (derr "compilation failed: checker reported error(s) above"))
                        (Ok [i64 Diag] 0)))))))))
; Two tagged-form lists are equal iff their forms are structurally equal (spans
; ignored) — the fixpoint test for the semantic-transform loop.
(defn forms-equal [(xs (ptr (ArrayList TaggedForm))) (ys (ptr (ArrayList TaggedForm)))] (-> bool)
  (let [nx (al-len [TaggedForm] (load xs))
        ny (al-len [TaggedForm] (load ys))]
    (if (!= nx ny)
        false
        (let [(mut i) 0
              (mut ok) true]
          (loop (if (or (not (load ok)) (>= (load i) nx))
                    (break)
                    (do
                      (when (not (sexp-eq (load (field (al-elem [TaggedForm] xs (load i)) form))
                                          (load (field (al-elem [TaggedForm] ys (load i)) form))))
                        (store! ok false)
                        0)
                      (set! i (primitive/iadd (load i) 1)))))
          (load ok)))))
; ── TRANSFORMS: whole-program rewrites that run to a fixpoint ────────────────
; There is ONE kind of transform (`(transform FN)`). It is SEMANTIC: each round it
; reads the authoritative checked program (via the semantic model) to decide its
; rewrite. But it TOLERATES a program that does not yet typecheck — then the model is
; empty (`code-decl` → `:unresolved`) and the transform rewrites syntactically until
; the program becomes valid (e.g. a desugaring that introduces the very ops that make
; it typecheck). The AUTHORITATIVE strict check happens once, after the fixpoint.
(defn diag-before [(x Diag) (y Diag)] (-> bool)
  (if (< (.source x) (.source y))
      true
      (if (> (.source x) (.source y))
          false
          (<= (.lo x) (.lo y)))))

; merge the recoverable resolve errors into check_diags, in source order, so the build
; path's one renderer shows every diagnostic from both phases with an `N errors` summary.
(defn merge-resolve-diags [(a (ptr Allocator)) (s (mut LS))] (-> i64)
  (let [rd (load (field s resolve_diags))
        cd (load (field s check_diags))
        nr (al-len [Diag] rd)
        nc (al-len [Diag] cd)
        (mut out) (al-new [Diag] a)
        (mut ri) 0
        (mut ci) 0]
    ; each list is already in source order within itself; classic two-list merge.
    (loop (if (and (< (load ri) nr) (< (load ci) nc))
              (let [dr (al-get [Diag] rd (load ri))
                    dc (al-get [Diag] cd (load ci))]
                (if (diag-before dr dc)
                    (do (al-push! (mut out) dr) (set! ri (primitive/iadd (load ri) 1)) 0)
                    (do (al-push! (mut out) dc) (set! ci (primitive/iadd (load ci) 1)) 0)))
              (break)))
    (loop (if (< (load ri) nr)
              (do
                (al-push! (mut out) (al-get [Diag] rd (load ri)))
                (set! ri (primitive/iadd (load ri) 1))
                0)
              (break)))
    (loop (if (< (load ci) nc)
              (do
                (al-push! (mut out) (al-get [Diag] cd (load ci)))
                (set! ci (primitive/iadd (load ci) 1))
                0)
              (break)))
    (set! (load (field s check_diags)) (load out))
    0))

; ---- (meta …) on the COMPILED engine (interp deletion step 4) ---------------------
; Mirrors comptime.coil::elaborate-metas / run-metas, but the generator sub-program
; is built at the PRE-CHECK form level — metashim forms injected via meta-sub-forms,
; exactly like the macro engine — and each meta expression is wrapped as a synthetic
; zero-parameter Code-returning entry (`coil.meta.<elaboration>.<i>`) that meta-engine-setup
; compiles and meta-engine-run-env executes as native code. Result handling (splice
; a returned `(do …)`, else push the form) and the final splice + strict re-resolve
; + check are byte-for-byte the interpreter path's semantics.
(defn meta-elaboration-id [] (-> i64)
  (let [p (alloc/static i64)
        n (primitive/iadd (load p) 1)]
    (set! p n)
    n))
(defn elaborate-metas-compiled [(a (ptr Allocator)) (s (mut LS))] (-> (Result (ptr Program) Diag))
  (try (do
         (let [out-forms (box-al [TaggedForm] a (load (field s out)))
               sub-forms (try! (meta-sub-forms a (mut s) out-forms))
               subls (alloc/stack LS)]
           (store! (field subls a) a)
           (store! (field subls out) (load sub-forms))
           (store! (field subls loaded) (al-new [(slice u8)] a))
           (store! (field subls readpaths) (al-new [(slice u8)] a))
           (store! (field subls readmods) (al-new [(slice u8)] a))
           (store! (field subls imports) (load (field s imports)))
           (store! (field subls exports) (load (field s exports)))
           (store! (field subls primitive_defs) (load (field s primitive_defs)))
           (store! (field subls primitive_aliases) (load (field s primitive_aliases)))
           (match (resolve-program a (mut subls) false true)
             (Err [d] (Err [(ptr Program) Diag] d))
             (Ok [mctx]
                 (let [ms (load (field mctx metas))
                       nmet (al-len [Expr] (load ms))
                       eid (meta-elaboration-id)
                       (mut names) (al-new [(slice u8)] a)
                       (mut i) 0]
                   ; one synthetic entry per (meta …) expression
                   (loop (if (>= (load i) nmet)
                             (break)
                             (do
                               (let [f (alloc/stack Func)
                                     fname
                                       (sconcat3 a
                                                 "coil.meta."
                                                 (i64->str a eid)
                                                 (sconcat a "." (i64->str a (load i))))]
                                 (store! (field f name) fname)
                                 (store! (field f type_params) (box-al [(slice u8)] a (al-new [(slice u8)] a)))
                                 (store! (field f bounds) (box-al [Bound] a (al-new [Bound] a)))
                                 (store! (field f cc) "c")
                                 (store! (field f annotations) (box-al [Annotation] a (al-new [Annotation] a)))
                                 (store! (field f params) (box-al [Param] a (al-new [Param] a)))
                                 (store! (field f ret) (TCode))
                                 (let [(mut bl) (al-new [Expr] a)]
                                   (al-push! (mut bl) (al-get [Expr] (load ms) (load i)))
                                   (store! (field f body) (box-al [Expr] a (load bl))))
                                 (store! (field f macro_variadic) false)
                                 (store! (field f lo) -1)
                                 (store! (field f hi) -1)
                                 (store! (field f source) -1)
                                 (store! (field f ctxt) 0)
                                 (al-push! (mut (load (field mctx funcs))) (load f))
                                 (al-push! (mut names) fname))
                               (store! i (primitive/iadd (load i) 1)))))
                   (let [qb (box-al [(slice u8)] a (load names))
                         seeds (meta-shim-seeds a mctx qb)
                         wanted (closure-funcs mctx seeds a)
                         sub (closure-subprogram mctx wanted a)
                         checkls (alloc/stack LS)]
                     (store! (field checkls a) a)
                     (store! (field checkls out) (al-new [TaggedForm] a))
                     (store! (field checkls loaded) (al-new [(slice u8)] a))
                     (store! (field checkls readpaths) (al-new [(slice u8)] a))
                     (store! (field checkls readmods) (al-new [(slice u8)] a))
                     (store! (field checkls imports) (al-new [ImpEntry] a))
                     (store! (field checkls exports) (al-new [ExpEntry] a))
                     (store! (field checkls primitive_defs) (al-new [PrimitiveDef] a))
                     (store! (field checkls primitive_aliases) (al-new [PrimitiveAlias] a))
                     (store! (field checkls check_diags) (box-al [Diag] a (al-new [Diag] a)))
                     (store! (field checkls resolve_diags) (primitive/cast (ptr (ArrayList Diag)) 0))
                     (store! (field checkls resolve_poisoned) (primitive/cast (ptr (ArrayList (slice u8))) 0))
                     (let [checked (try! (check-program a sub (mut checkls)))]
                       (match (meta-engine-setup a checked qb)
                         (Some [d] (Err [(ptr Program) Diag] d))
                         (None []
                               ; run each entry; cx mirrors run-metas' (the metahost shims read it)
                               (let [cx (alloc/stack CtCtx)
                                     meta-modules (meta-form-modules (mut s) a)
                                     (mut gen) (al-new [Sexp] a)
                                     (mut genmods) (al-new [(Option (slice u8))] a)
                                     (mut j) 0
                                     (mut errf) (None [Diag])]
                                 (store! (field cx a) a)
                                 (store! (field cx fns) (load (field checked funcs)))
                                 (store! (field cx structs) (load (field checked structs)))
                                 (store! (field cx sums) (load (field checked sums)))
                                 (store! (field cx variants) (all-variant-names (load (field checked sums)) a))
                                 (store! (field cx traits) (load (field checked traits)))
                                 (store! (field cx fuel) 50000000)
                                 (store! (field cx depth) 0)
                                 (store! (field cx gensym) 0)
                                 (store! (field cx qmodule) (None [(slice u8)]))
                                 (store! (field cx module_fns) (primitive/cast (ptr (ArrayList (slice u8))) 0))
                                 (store! (field cx qimports) (primitive/cast (ptr ModImports) 0))
                                 (store! (field cx qexports) (primitive/cast (ptr (ArrayList ExpEntry)) 0))
                                 (store! (field cx prog) checked)
                                 (loop (if (or (diag-some? (load errf))
                                               (>= (load j) nmet))
                                           (break)
                                           (do
                                             (let [md (al-get [(Option (slice u8))]
                                                              (load meta-modules)
                                                              (load j))
                                                   _qm (store! (field cx qmodule) md)
                                                   e
                                                     (meta-engine-entry (al-get [(slice u8)]
                                                                                (load qb)
                                                                                (load j)))]
                                               (if (= (primitive/cast i64 e) (primitive/cast i64 0))
                                                   (do
                                                     (store! errf
                                                             (Some (derr "meta: entry missing from the metaprogram engine (compiler bug)")))
                                                     0)
                                                   (match (meta-engine-run-env a
                                                                               e
                                                                               cx
                                                                               (box-al [EnvBind]
                                                                                       a
                                                                                       (al-new [EnvBind] a)))
                                                     (Err [d] (do (store! errf (Some d)) 0))
                                                     (Ok [sexp]
                                                         (let [sp (box-sexp a sexp)]
                                                         ; a returned `(do …)` splices its items — TRANSITIVELY, since a
                                                         ; generator built out of macros bundles at each layer
                                                         (if (do-bundle? sp)
                                                             (let [(mut flat) (al-new [Sexp] a)
                                                                   md
                                                                     (al-get [(Option (slice u8))]
                                                                             (load meta-modules)
                                                                             (load j))
                                                                   (mut k) 0]
                                                               (splice-do-into! (mut flat) sp)
                                                               (let [m (al-len [Sexp] (load flat))]
                                                                 (loop (if (>= (load k) m)
                                                                           (break)
                                                                           (do
                                                                             (al-push! (mut gen)
                                                                                       (al-get [Sexp]
                                                                                               (load flat)
                                                                                               (load k)))
                                                                             (al-push! (mut genmods) md)
                                                                             (store! k
                                                                                     (primitive/iadd (load k)
                                                                                                     1))))))
                                                               0)
                                                             (do
                                                               (al-push! (mut gen) sexp)
                                                               (al-push! (mut genmods)
                                                                         (al-get [(Option (slice u8))]
                                                                                 (load meta-modules)
                                                                                 (load j)))
                                                               0)))))))
                                             (store! j (primitive/iadd (load j) 1)))))
                                 (match (load errf)
                                   (Some [d] (Err [(ptr Program) Diag] d))
                                   (None []
                                         (do
                                           (splice-metas (mut s)
                                                         (box-al [Sexp] a (load gen))
                                                         (box-al [(Option (slice u8))] a (load genmods))
                                                         a)
                                           (match (resolve-program a (mut s) true false)
                                             (Err [d] (Err [(ptr Program) Diag] d))
                                             (Ok [prog2] (check-strict-resolved a (mut s) prog2))))))))))))))))))

; Finish an authoritative strict resolve. Body-resolution errors are recoverable so
; resolve-program can diagnose several functions in one pass; it marks those bodies
; poisoned and records their diagnostics in LS. Every strict entry path must merge
; that sink after checking. The meta-elaboration path used to call check-program
; directly and silently discarded it, allowing callers of a poisoned/omitted helper
; to reach codegen as `unknown callable`.
(defn check-strict-resolved [(a (ptr Allocator))
                             (s (mut LS))
                             (prog (ptr Program))] (-> (Result (ptr Program) Diag))
  (let [cres (check-program a prog (mut s))
        nrd (al-len [Diag] (load (field s resolve_diags)))]
    (if (= nrd (primitive/cast i64 0))
        cres
        (do
          (merge-resolve-diags a (mut s))
          (Err [(ptr Program) Diag]
               (al-get [Diag] (load (field s check_diags)) 0))))))

(defn strict-resolve-check [(a (ptr Allocator)) (s (mut LS))] (-> (Result (ptr Program) Diag))
  ; Meta elaboration performs its own tolerant resolve to build the generator
  ; context, then an authoritative strict resolve after splicing. Do not resolve
  ; the whole program once before that merely to rediscover the metas the loader
  ; has already recorded.
  (if (ls-has-meta (mut s))
      (elaborate-metas-compiled a (mut s))
      (match (resolve-program a (mut s) true false)
        ; a FATAL resolve error (parse / signature / struct / sum) aborts as before.
        (Err [d] (Err [(ptr Program) Diag] d))
        (Ok [prog] (check-strict-resolved a (mut s) prog)))))
; Best-effort resolve+check for the model: swallow errors, returning None on failure.
; Reset the collected check diagnostics so a failed attempt never pollutes the final
; (authoritative) error report.
(defn try-resolve-check [(a (ptr Allocator)) (s (mut LS))] (-> (Option (ptr Program)))
  (set! (load (field s check_diags)) (al-new [Diag] a))
  (match (strict-resolve-check a (mut s))
    (Err [d] (None [(ptr Program)]))
    (Ok [cp] (Some cp))))
; The transform fixpoint. Returns Ok(0) when the program stabilizes (final forms left
; in s.out for the caller's strict check), or Err on a transform error / non-fixpoint.
(defn run-transform-fixpoint [(a (ptr Allocator)) (s (mut LS)) (r (ptr CheckerReg))] (-> (Result i64 Diag))
  (let [(mut iters) 0
        (mut out) (Ok [i64 Diag] 0)
        (mut done) false]
    (loop (if (load done)
              (break)
              (do
                (match (try-resolve-check a (mut s)) (Some [cp] (set-sem-model cp)) (None [] (clear-sem-model)))
                (let [forms (box-al [TaggedForm] a (.out s))
                      impb (unwrap-ptr [(ArrayList ImpEntry)] (create [(ArrayList ImpEntry)] a))
                      expb (unwrap-ptr [(ArrayList ExpEntry)] (create [(ArrayList ExpEntry)] a))]
                  (set! impb (.imports s))
                  (set! expb (.exports s))
                  (match (run-transformers (load (field r semtx))
                                           (load (field r checked))
                                           forms
                                           (load (field r allfns))
                                           (load (field r gs))
                                           (load (field r gu))
                                           impb
                                           expb
                                           a)
                    (Err [d] (do (set! out (Err [i64 Diag] d)) (set! done true) 0))
                    (Ok [newforms]
                        (if (forms-equal newforms forms)
                            (do (mtrace-note "fixpoint reached — output stopped changing")
                                (set! done true) 0)
                            (if (>= (load iters) (primitive/cast i64 16))
                                (do
                                  (mtrace-note "ROUND LIMIT: a transform keeps rewriting its own output — it is not a fixed point")
                                  (set! out
                                        (Err [i64 Diag]
                                             (derr "transform: did not reach a fixpoint after 16 rounds")))
                                  (set! done true)
                                  0)
                                (do
                                  (set! (.out s) (load newforms))
                                  (set! iters (primitive/iadd (load iters) 1))
                                  0)))))))))
    (load out)))
; Resolve + typecheck the program, running the transform fixpoint first if any
; transforms are registered. This is the pipeline's authoritative resolve+check.
(defn run-transforms-and-check [(a (ptr Allocator)) (s (mut LS))] (-> (Result (ptr Program) Diag))
  (let [b (checker-reg-box)
        has-tx
          (if (= (.init b) (primitive/cast i64 0))
              false
              (> (al-len [(slice u8)] (load (field (field b reg) semtx))) (primitive/cast i64 0)))]
    (if (not has-tx)
        (strict-resolve-check a (mut s))
        (match (run-transform-fixpoint a (mut s) (field b reg))
          (Err [d] (Err [(ptr Program) Diag] d))
          (Ok [_] (strict-resolve-check a (mut s)))))))
; ── whole-program TRANSFORMERS ───────────────────────────────────────────────
; `(transform FN)` registers FN — a [(prog Code)] -> Code function — run once after
; expansion over the WHOLE program; FN returns the rewritten program and it REPLACES
; the program. The pipeline re-resolves + re-typechecks to a fixpoint.
;
; MODULE-SHAPED (symmetric with checkers): FN is handed the program AS MODULES —
; `((name form…) (name2 form…) …)`, one record per module (head = module-name
; symbol, rest = its top-level forms) — and returns the SAME shape. Because each
; returned module names itself, a transform may ADD or REMOVE forms freely (a GC
; dialect emits a `trace-T` per type; a desugarer rewrites in place): every form in
; a returned module record is tagged with that module. Order within the program is
; irrelevant (the whole program is resolved together), so emitted forms may go
; anywhere in their module. FN must be idempotent — it runs each fixpoint round.
; A representative source id per module (captured from the input) is stamped onto
; freshly-built forms so `(primitive/code-from-user? …)` classifies generated code correctly.
(defstruct ModRep [(name (slice u8)) (source i64) (lo i64) (hi i64)])
(defn mod-reps [(a (ptr Allocator)) (forms (ptr (ArrayList TaggedForm)))] (-> (ptr (ArrayList ModRep)))
  (let [nf (al-len [TaggedForm] (load forms))
        (mut out) (al-new [ModRep] a)
        (mut i) 0]
    (loop (if (>= (load i) nf)
              (break)
              (do
                (let [tf (al-elem [TaggedForm] forms (load i))
                      nm (opt-mod-name (.module tf))
                      (mut seen) false
                      (mut j) 0
                      nout (al-len [ModRep] (load out))]
                  (loop (if (>= (load j) nout)
                            (break)
                            (do
                              (when (= (load (field (al-elem [ModRep] out (load j)) name)) nm)
                                (store! seen true)
                                0)
                              (set! j (primitive/iadd (load j) 1)))))
                  (unless (load seen)
                    (let [mr (alloc/stack ModRep)
                          fp (field tf form)]
                      (store! (field mr name) nm)
                      (store! (field mr source) (sx-source (load fp)))
                      (store! (field mr lo) (sx-lo (load fp)))
                      (store! (field mr hi) (sx-hi (load fp)))
                      (al-push! (mut out) (load mr))
                      0)))
                (set! i (primitive/iadd (load i) 1)))))
    (box-al [ModRep] a (load out))))
(defn mod-rep-find [(reps (ptr (ArrayList ModRep))) (nm (slice u8))] (-> (ptr ModRep))
  (let [n (al-len [ModRep] (load reps))
        (mut i) 0
        (mut r) (primitive/cast (ptr ModRep) 0)]
    (loop (if (>= (load i) n)
              (break)
              (do
                (when (= (load (field (al-elem [ModRep] reps (load i)) name)) nm)
                  (store! r (al-elem [ModRep] reps (load i)))
                  (break))
                (set! i (primitive/iadd (load i) 1)))))
    (load r)))
; module-name symbol -> Option tag ("" = the no-module top level -> None)
(defn mod-name->opt [(nm (slice u8))] (-> (Option (slice u8)))
  (if (= (slice-len nm) (primitive/cast i64 0)) (None [(slice u8)]) (Some nm)))

; append one module record `(name form…)` to `out`; err into errf on a bad shape
(defn append-module-forms! [(a (ptr Allocator))
                            (out (ptr (ArrayList TaggedForm)))
                            (rec (ptr Sexp))
                            (reps (ptr (ArrayList ModRep)))
                            (errf (ptr (Option Diag)))] (-> i64)
  (if (not (or (= (sx-tag (load rec)) (primitive/cast i64 6)) (= (sx-tag (load rec)) (primitive/cast i64 7))))
      (do (set! errf (Some (derr "transform: each module must be a list (name form…)"))) 0)
      (let [items (sx-items (load rec))
            ni (sx-len items)]
        (if (or (= ni (primitive/cast i64 0)) (!= (sx-tag (sx-at items 0)) (primitive/cast i64 2)))
            (do (set! errf (Some (derr "transform: a module record's head must be its name symbol"))) 0)
            (let [nmname (sx-sval (sx-at items 0))
                  tag (mod-name->opt nmname)
                  rep (mod-rep-find reps nmname)
                  (mut k) 1]
              (loop (if (>= (load k) ni)
                        (break)
                        (do
                          (let [fp (box-sexp a (sx-at items (load k)))
                                tf (alloc/stack TaggedForm)]
                            ; freshly-built forms carry dummy spans — stamp them with the
                            ; module's representative source so `(primitive/code-from-user? …)` works
                            (when (and (< (sx-lo (load fp)) (primitive/cast i64 0))
                                       (!= (primitive/cast i64 rep) (primitive/cast i64 0)))
                              (stamp-expansion fp
                                               (load (field rep source))
                                               (load (field rep lo))
                                               (load (field rep hi))
                                               0))
                            (set! (.form tf) (load fp))
                            (set! (.module tf) tag)
                            (al-push! [TaggedForm] out (load tf)))
                          (set! k (primitive/iadd (load k) 1)))))
              0)))))
; rebuild the tagged-form list from a returned `((name form…) …)` module list
(defn forms-from-modules [(a (ptr Allocator)) (modlist (ptr (ArrayList Sexp))) (reps (ptr (ArrayList ModRep)))] (-> (Result (ptr (ArrayList TaggedForm))
                                                                                                                            Diag))
  (let [nm (al-len [Sexp] (load modlist))
        outbox (unwrap-ptr [(ArrayList TaggedForm)] (create [(ArrayList TaggedForm)] a))
        errbox (alloc/stack (Option Diag))
        (mut i) 0]
    (set! outbox (al-new [TaggedForm] a))
    (set! errbox (None [Diag]))
    (loop (if (or (diag-some? (load errbox)) (>= (load i) nm))
              (break)
              (do
                (append-module-forms! a outbox (al-elem [Sexp] modlist (load i)) reps errbox)
                (set! i (primitive/iadd (load i) 1)))))
    (match (load errbox)
      (Some [d] (Err [(ptr (ArrayList TaggedForm)) Diag] d))
      (None [] (Ok [(ptr (ArrayList TaggedForm)) Diag] outbox)))))
(defn is-transform-form [(f (ptr Sexp))] (-> bool)
  (and (= (sx-tag (load f)) (primitive/cast i64 6))
       (let [it (sx-items (load f))]
         (and (or (= (sx-len it) (primitive/cast i64 2)) (= (sx-len it) (primitive/cast i64 4)))
              (and (= (sx-tag (sx-at it 0)) (primitive/cast i64 2)) (= (sx-sval (sx-at it 0)) "transform"))))))
; ── (register-derive Trait :struct FN :sum FN) ───────────────────────────────
; The explicit link from a trait to the functions that derive it. `defderive` is
; sugar that writes one of these; writing it yourself is supported and is the only
; other way to make a function a deriver — there is deliberately no spelling of a
; plain `defn` that has the same effect.
;
; Discovered in the same pre-scan as `checker`/`transform`, and for the same
; reason: it declares something the rest of the compilation depends on, so it is
; read off the loaded source before any of that compilation runs.
(defn is-register-derive-form [(f (ptr Sexp))] (-> bool)
  (and (= (sx-tag (load f)) (primitive/cast i64 6))
       (let [it (sx-items (load f))]
         (and (>= (sx-len it) (primitive/cast i64 2))
              (and (= (sx-tag (sx-at it 0)) (primitive/cast i64 2))
                   (= (sx-sval (sx-at it 0)) "register-derive"))))))
;; The symbol following `:struct` / `:sum`, or "" when that arm is absent. A
;; keyword's `sval` carries no colon, so `key` is "struct"/"sum".
(defn regd-arm [(it (ptr (ArrayList Sexp))) (key (slice u8))] (-> (slice u8))
  (let [n (sx-len it)
        (mut i) 2
        (mut out) ""]
    (loop (if (>= (primitive/iadd (load i) 1) n)
              (break)
              (do
                (when (and (= (sx-tag (sx-at it (load i))) (primitive/cast i64 3))
                           (and (= (sx-sval (sx-at it (load i))) key)
                                (= (sx-tag (sx-at it (primitive/iadd (load i) 1))) (primitive/cast i64 2))))
                  (store! out (sx-sval (sx-at it (primitive/iadd (load i) 1))))
                  0)
                (set! i (primitive/iadd (load i) 2)))))
    (load out)))
;; Resolve one arm to its QUALIFIED name. "" in, "" out (the arm is absent, which
;; is legal); a name that does not resolve is an error rather than a silently
;; dropped arm — that would turn into "trait has no deriver for sums" much later,
;; pointing at the use site instead of at the typo.
(defn regd-resolve [(raw (slice u8))
                    (module (Option (slice u8)))
                    (macros (ptr (ArrayList (slice u8))))
                    (impb (ptr (ArrayList ImpEntry)))
                    (expb (ptr (ArrayList ExpEntry)))
                    (a (ptr Allocator))
                    (okf (mut bool))] (-> (slice u8))
  (if (= raw "")
      ""
      (match (resolve-macro raw module macros impb expb a)
        (Some [q] q)
        (None [] (do (set! okf false) "")))))
(defn register-derive-form! [(f (ptr Sexp))
                             (module (Option (slice u8)))
                             (macros (ptr (ArrayList (slice u8))))
                             (impb (ptr (ArrayList ImpEntry)))
                             (expb (ptr (ArrayList ExpEntry)))
                             (a (ptr Allocator))] (-> (Option Diag))
  (let [it (sx-items (load f))]
    (if (!= (sx-tag (sx-at it 1)) (primitive/cast i64 2))
        (Some (derr "register-derive: expected (register-derive Trait :struct FN :sum FN)"))
        (let [trait (sx-sval (sx-at it 1))
              (mut ok) true
              astruct (regd-resolve (regd-arm it "struct") module macros impb expb a (mut ok))
              asum (regd-resolve (regd-arm it "sum") module macros impb expb a (mut ok))]
          (cond (not (load ok))
                  (Some (derr "register-derive: each arm must name a [(T Code)] -> Code function in scope"))
                (and (= astruct "") (= asum ""))
                  (Some (derr "register-derive: needs at least one of :struct FN / :sum FN"))
                :else (derive-reg-put! trait astruct asum (match module (Some [m] m) (None [] ""))))))))
;; Is this form a `(do …)` bundle — the shape a macro returns when it produces
;; more than one top-level form?
(defn do-bundle? [(s (ptr Sexp))] (-> bool)
  (and (= (sx-tag (load s)) (primitive/cast i64 6))
       (let [it (sx-items (load s))]
         (and (>= (sx-len it) (primitive/cast i64 1))
              (and (= (sx-tag (sx-at it 0)) (primitive/cast i64 2)) (= (sx-sval (sx-at it 0)) "do"))))))
;; Append `s` to `out` as top-level forms, flattening `do` bundles ALL THE WAY DOWN.
;;
;; One level is not enough as soon as macros compose. `(derive Eq Hash T)` builds a
;; `do` of two deriver calls, and a deriver that emits both a function and an impl
;; returns a `do` of its own — so the result is `(do (do …) (do …))`, and splicing
;; one level handed the parser an inner `(do …)` as a top-level form: "unknown
;; top-level form 'do'". Nothing about that is specific to derive; any macro over
;; macros hits it, which is why the fix belongs here rather than in `derive`.
(defn splice-do-into! [(out (ptr (ArrayList Sexp))) (s (ptr Sexp))] (-> i64)
  (if (do-bundle? s)
      (let [it (sx-items (load s))
            n (sx-len it)
            (mut k) 1]
        (loop (if (>= (load k) n)
                  (break)
                  (do
                    (splice-do-into! out (al-elem [Sexp] it (load k)))
                    (set! k (primitive/iadd (load k) 1)))))
        0)
      (do (al-push! [Sexp] out (load s)) 0)))
(defn unpack-do [(s (ptr Sexp)) (a (ptr Allocator))] (-> (ptr (ArrayList Sexp)))
  (let [(mut out) (al-new [Sexp] a)]
    (if (do-bundle? s)
        (let [it (sx-items (load s))
              n (sx-len it)
              (mut k) 1]
          (loop (if (>= (load k) n)
                    (break)
                    (do
                      (splice-do-into! (mut out) (al-elem [Sexp] it (load k)))
                      (set! k (primitive/iadd (load k) 1))))))
        (al-push! (mut out) (load s)))
    (box-al [Sexp] a (load out))))
(defn run-transformers [(transformers (ptr (ArrayList (slice u8))))
                        (checked (ptr Program))
                        (forms (ptr (ArrayList TaggedForm)))
                        (allfns (ptr SBox))
                        (gs (ptr SBoxStruct))
                        (gu (ptr SBoxSum))
                        (impb (ptr (ArrayList ImpEntry)))
                        (expb (ptr (ArrayList ExpEntry)))
                        (a (ptr Allocator))] (-> (Result (ptr (ArrayList TaggedForm)) Diag))
  (let [nt (al-len [(slice u8)] (load transformers))]
    (if (= nt (primitive/cast i64 0))
        (Ok [(ptr (ArrayList TaggedForm)) Diag] forms)
        (let [(mut cur) forms
              (mut ti) 0
              (mut errf) (None [Diag])]
          (loop (if (or (diag-some? (load errf)) (>= (load ti) nt))
                    (break)
                    (do
                      (let [reps (mod-reps a (load cur))
                            proglist (build-modules a (load cur))  ; ((name form…) …)
                            txname (al-get [(slice u8)] (load transformers) (load ti))
                            (mut margs) (al-new [Sexp] a)]
                        (al-push! (mut margs) proglist)
                        (mtrace-enter txname (load ti) (al-len [TaggedForm] (load cur)))
                        (match (expand-macro checked
                                             txname
                                             (box-al [Sexp] a (load margs))
                                             (field allfns items)
                                             (field gs items)
                                             (field gu items)
                                             impb
                                             expb
                                             a)
                          (Err [d] (do (mtrace-error txname (load ti)) (set! errf (Some d)) 0))
                          (Ok [outs]
                              ; A transform returns its module records `do`-wrapped.
                              ; Anything else is one record, so returning the argument
                              ; unchanged fails the head-must-be-a-name check below —
                              ; the identity transform is the shape that catches this.
                              (let [modlist (unpack-do (box-sexp a outs) a)]
                                (match (forms-from-modules a modlist reps)
                                  (Err [d] (do (mtrace-error txname (load ti)) (set! errf (Some d)) 0))
                                  (Ok [newforms]
                                      (do
                                        (mtrace-leave txname (load ti)
                                                      (not (forms-equal newforms (load cur))))
                                        (set! cur newforms)
                                        0)))))))
                      (set! ti (primitive/iadd (load ti) 1)))))
          (match (load errf)
            (Some [d] (Err [(ptr (ArrayList TaggedForm)) Diag] d))
            (None [] (Ok [(ptr (ArrayList TaggedForm)) Diag] (load cur))))))))
; ═══════════ Staged metacompilation (docs/design/STAGED_METACOMPILATION.md) ═══════════
;
; A before-expand transform may return, among its output forms:
;
;   (stage MARKER FORM…)     a phase-program increment: FORM… compile as an
;                            ISOLATED program (they never enter the runtime
;                            program) whose [Code…] -> Code entries install
;                            additively into the metaprogram engine;
;   (MARKER ENTRY ARG…)      a request: run staged ENTRY on ARG… during this
;                            expansion; the promoted result splices in place and
;                            re-enters the transform fixpoint (language
;                            resumption).
;
; MARKER is an opaque symbol the transform mints (a gensym): requests are
; recognized by declared-marker lookup, never by name inference, so quoted
; syntax and same-spelled runtime data stay data. Stage state is CUMULATIVE
; (increment N compiles with increments 1..N-1; redefinition across increments
; is a hard error) and compilation-scoped (markers route across modules).
(defn stage-declaration? [(f (ptr Sexp))] (-> bool)
  (match (l-list-head f)
    (Some [h] (= h "stage"))
    (None [] false)))

; An owning copy of `s` in `a` — stage compilation works in a disposable arena,
; so anything that outlives it (signatures, diagnostics) copies its bytes out.
(defn stage-own-str [(a (ptr Allocator)) (s (slice u8))] (-> (slice u8))
  (sconcat a s ""))

(defn stage-name-local-start [(name (slice u8)) (i i64)] (-> i64)
  (if (>= i (slice-len name)) 0
    (let [rest (stage-name-local-start name (+ i 1))]
      (if (= (subslice name i (+ i 1)) ".") (+ i 1) rest))))

(defn stage-name-local [(name (slice u8))] (-> (slice u8))
  (subslice name (stage-name-local-start name 0) (slice-len name)))

(defn stage-local-name-declared? [(name (slice u8))
                                  (declared (ptr (ArrayList (slice u8))))
                                  (i i64) (n i64)] (-> bool)
  (if (>= i n) false
    (if (= (stage-name-local name)
           (stage-name-local (al-get [(slice u8)] (load declared) i)))
        true
      (stage-local-name-declared? name declared (+ i 1) n))))

;; Entry points are the functions the stage increments themselves declared, not
;; "every Code-signed function the resolved phase program can see" (the ambient
;; core macros are in that program too, and are not stage entries).
(defn stage-declared-names [(names (ptr (ArrayList (slice u8))))
                            (declared (ptr (ArrayList (slice u8))))
                            (a (ptr Allocator))] (-> (ptr (ArrayList (slice u8))))
  (let [(mut out) (al-new [(slice u8)] a)
        n (al-len [(slice u8)] (load names))
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (let [name (al-get [(slice u8)] (load names) (load i))]
                  (when (stage-local-name-declared? name declared 0
                          (al-len [(slice u8)] (load declared)))
                    (al-push! (mut out) name)
                    0))
                (set! i (+ (load i) 1)))))
    (box-al [(slice u8)] a (load out))))

;; "Cumulative" must not mean accidental shadowing: a name a later increment
;; introduces again is a hard error, not a silent redefinition.
(defn stage-form-name-conflict [(forms (ptr (ArrayList TaggedForm)))
                                (defined (ptr (ArrayList (slice u8))))
                                (a (ptr Allocator))] (-> (Option (slice u8)))
  (let [n (al-len [TaggedForm] (load forms))
        (mut i) 0
        (mut found) (None [(slice u8)])]
    (loop (if (or (not (opt-str-none? (load found))) (>= (load i) n))
              (break)
              (do
                (let [tf (al-elem [TaggedForm] forms (load i))]
                  (match (defn-name-of (field tf form))
                    (None [] 0)
                    (Some [name]
                      (let [qual (qualify-name a name (.module tf))]
                        (when (set-contains defined qual)
                          (set! found (Some qual))
                          0)))))
                (set! i (+ (load i) 1)))))
    (load found)))

(defn stage-record-form-names! [(forms (ptr (ArrayList TaggedForm)))
                                (defined (mut (ArrayList (slice u8))))
                                (a (ptr Allocator))] (-> i64)
  (let [n (al-len [TaggedForm] (load forms))
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (let [tf (al-elem [TaggedForm] forms (load i))]
                  (match (defn-name-of (field tf form))
                    (None [] 0)
                    (Some [name]
                      (al-push! (mut defined)
                                (qualify-name a name (.module tf))))))
                (set! i (+ (load i) 1)))))
    0))

;; A `(stage MARKER FORM...)` body is a SEPARATE compilation unit -- it carries
;; its own imports and its entry names are a protocol that request sites name by
;; string -- not a template splice. Referential hygiene would otherwise resolve
;; every symbol in it against the TRANSFORM's module, which is wrong in both
;; directions: `(defn pick-entry ...)` was registered as
;; `staged_pick_test.$scope47@staged_pick$pick-entry`, so it matched no request
;; and the stage looked like it declared no entry at all; and a call to one of
;; the stage's OWN imports (`syntax-object-from-code` from coil.scheme.phase)
;; resolved against the transform module, which never imported it, and failed as
;; undefined. Strip the context over the whole body -- exactly what
;; `syntax->datum` does for a single identifier (hyg 0, no module, origin 5, the
;; sanctioned "explicit context removal" state that unscoped-datum linkage
;; checking accepts).
(defn stage-datum-sexp [(a (ptr Allocator)) (s Sexp)] (-> Sexp)
  (let [tg (sx-tag s)]
    (if (or (= tg (primitive/cast i64 6))
            (or (= tg (primitive/cast i64 7)) (= tg (primitive/cast i64 8))))
        (let [n (code-node-len s)
              (mut out) (al-new [Sexp] a)
              (mut i) 0]
          (loop (if (>= (load i) n)
                    (break)
                    (do
                      (al-push! (mut out) (stage-datum-sexp a (code-node-at s (load i))))
                      (set! i (primitive/iadd (load i) 1)))))
          ;; A KView is FLATTENED to a KList, for the same reason sexp-own-into
          ;; flattens one: the view borrows a backing list this copy does not own.
          (let [p (alloc/stack Sexp)]
            (set! p s)
            (set! (.kind p) (if (= tg (primitive/cast i64 7))
                                (KVec (box-al [Sexp] a (load out)))
                                (KList (box-al [Sexp] a (load out)))))
            (set! (.nid p) (next-nid))
            (load p)))
      (if (= tg (primitive/cast i64 2))
          (let [p (alloc/stack Sexp)]
            (set! p s)
            (set! (.hyg p) 0)
            (set! (.hmod p) "")
            (set! (.horigin p) 5)
            (set! (.nid p) (next-nid))
            (load p))
        s))))

;; Split transform output into runtime forms and isolated stage forms. Stage
;; children retain the declaration's module tag. The declaration's MARKER (its
;; first child) is recorded; only lists headed by a declared marker are ever
;; treated as phase requests.
(defn split-stage-declarations! [(a (ptr Allocator))
                                 (forms (ptr (ArrayList TaggedForm)))
                                 (runtime (mut (ArrayList TaggedForm)))
                                 (staged (mut (ArrayList TaggedForm)))
                                 (markers (mut (ArrayList (slice u8))))]
                                (-> (Option Diag))
  (let [n (al-len [TaggedForm] (load forms))
        (mut i) 0
        (mut errf) (None [Diag])]
    (loop (if (or (diag-some? (load errf)) (>= (load i) n))
              (break)
              (let [tf (al-elem [TaggedForm] forms (load i))
                    f (field tf form)]
                (if (stage-declaration? f)
                    (let [items (sx-items (load f))
                          m (sx-len items)
                          (mut j) 2]
                      (if (or (< m (primitive/cast i64 2))
                              (!= (sx-tag (sx-at items 1)) (primitive/cast i64 2)))
                          (set! errf
                                (Some (stamp-call-site
                                        (derr "stage: expected (stage MARKER FORM...), with a symbol marker")
                                        (load f))))
                          (do
                            (let [marker (sx-sval (sx-at items 1))]
                              (unless (set-contains (mut markers) marker)
                                (al-push! (mut markers) marker)
                                0))
                            (loop (if (>= (load j) m)
                                      (break)
                                      (let [out (alloc/stack TaggedForm)]
                                        (set! (.form out) (stage-datum-sexp a (sx-at items (load j))))
                                        (set! (.module out) (.module tf))
                                        (al-push! (mut staged) (load out))
                                        (set! j (+ (load j) 1))))))))
                    (al-push! (mut runtime) (load tf)))
                (set! i (+ (load i) 1)))))
    (load errf)))

;; The expansion context a staged request runs against: the checked metaprogram
;; program plus the installed stage entry signatures. An independent funcs array
;; keeps that augmentation out of the baseline program used by transforms,
;; checkers, and the runtime resolve.
(defn stage-expansion-context [(base (ptr Program)) (a (ptr Allocator))] (-> (ptr Program))
  (let [out (unwrap-ptr [Program] (create [Program] a))
        src (load (field base funcs))
        n (al-len [Func] (load src))
        (mut funcs) (al-new [Func] a)
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (al-push! (mut funcs) (al-get [Func] (load src) (load i)))
                (set! i (+ (load i) 1)))))
    (set! (.annotation_defs out) (.annotation_defs base))
    (set! (.conventions out) (.conventions base))
    (set! (.structs out) (.structs base))
    (set! (.sums out) (.sums base))
    (set! (.externs out) (.externs base))
    (set! (.funcs out) (box-al [Func] a (load funcs)))
    (set! (.asserts out) (.asserts base))
    (set! (.consts out) (.consts base))
    (set! (.traits out) (.traits base))
    (set! (.impls out) (.impls base))
    (set! (.metas out) (.metas base))
    (set! (.exports out) (.exports base))
    out))

;; The native engine owns the executable body; expansion retains only this
;; callable interface. Stage entries admitted by code-sig-funcs are [Code…] ->
;; Code, so reconstructing that type avoids retaining any pointer-bearing
;; resolved Type representation from the disposable stage-work arena.
(defn stable-stage-signature [(a (ptr Allocator)) (src (ptr Func))] (-> Func)
  (let [out (alloc/stack Func)
        ps (load (field src params))
        n (al-len [Param] (load ps))
        (mut stable-ps) (al-new [Param] a)
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (let [p (al-elem [Param] ps (load i))
                      q (alloc/stack Param)]
                  (set! (.name q) (stage-own-str a (.name p)))
                  (set! (.ty q) (TCode))
                  (al-push! (mut stable-ps) (load q)))
                (set! i (+ (load i) 1)))))
    (set! (.name out) (stage-own-str a (.name src)))
    (set! (.type_params out) (box-al [(slice u8)] a (al-new [(slice u8)] a)))
    (set! (.bounds out) (box-al [Bound] a (al-new [Bound] a)))
    (set! (.cc out) (stage-own-str a (.cc src)))
    (set! (.annotations out) (box-al [Annotation] a (al-new [Annotation] a)))
    (set! (.params out) (box-al [Param] a (load stable-ps)))
    (set! (.ret out) (TCode))
    (set! (.body out) (box-al [Expr] a (al-new [Expr] a)))
    (set! (.macro_variadic out) (.macro_variadic src))
    (set! (.lo out) (.lo src))
    (set! (.hi out) (.hi src))
    (set! (.source out) (.source src))
    (set! (.ctxt out) (.ctxt src))
    (load out)))

;; A stage-compilation diagnostic crosses the same lifetime boundary as a
;; successful signature: its message must not point into the closed arena.
(defn stable-stage-diag [(a (ptr Allocator)) (d Diag)] (-> Diag)
  (let [out (alloc/stack Diag)]
    (store! out d)
    (set! (.msg out) (stage-own-str a (.msg out)))
    (load out)))

(defn install-stage-signatures! [(dst (ptr Program)) (stage (ptr Program))
                                 (installed (ptr (ArrayList (slice u8))))
                                 (declared (ptr (ArrayList (slice u8))))
                                 (a (ptr Allocator))] (-> (ptr (ArrayList (slice u8))))
  (let [quals (stage-declared-names (code-sig-funcs stage a) declared a)
        n (al-len [(slice u8)] (load quals))
        (mut added) (al-new [(slice u8)] a)
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (let [name (al-get [(slice u8)] (load quals) (load i))]
                  (unless (set-contains installed name)
                    (let [f (prog-fn-find stage name)]
                      (when (!= (primitive/cast i64 f) (primitive/cast i64 0))
                        (let [stable (stable-stage-signature a f)]
                          (al-push! (mut (load (field dst funcs))) stable)
                          (al-push! (mut added) (.name (prog-fn-find dst name))))
                        0))))
                (set! i (+ (load i) 1)))))
    (box-al [(slice u8)] a (load added))))

;; Compile the CUMULATIVE stage program (every increment declared so far) as an
;; isolated program, and install its declared entries additively into the
;; metaprogram engine. `stable-a` owns everything that outlives the call (engine
;; entries, quote registry — meta-engine-setup allocates from it); `a` is the
;; disposable stage-work arena. The stage program gets fresh loader tables: its
;; declarations may have been generated by a transform after the entry program's
;; loader ran, so it must not rely on (or mutate) the entry program's tables.
(defn compile-stage-declarations [(stable-a (ptr Allocator))
                                  (a (ptr Allocator))
                                  (s (mut LS))
                                  (forms (ptr (ArrayList TaggedForm)))
                                  (declared (ptr (ArrayList (slice u8))))]
                                 (-> (Result (ptr Program) Diag))
  (let [stage-ls (alloc/stack LS)]
    (ls-init! (mut stage-ls) a)
    (set! (.imports stage-ls) (al-new [ImpEntry] a))
    (set! (.exports stage-ls) (al-new [ExpEntry] a))
    (set! (.primitive_defs stage-ls) (al-new [PrimitiveDef] a))
    (set! (.primitive_aliases stage-ls) (al-new [PrimitiveAlias] a))
    (let [npd (al-len [PrimitiveDef] (.primitive_defs s))
          (mut pdi) 0]
      (loop (if (>= (load pdi) npd)
                (break)
                (do
                  (al-push! (mut (field stage-ls primitive_defs))
                            (al-get [PrimitiveDef] (.primitive_defs s) (load pdi)))
                  (set! pdi (+ (load pdi) 1))))))
    (let [npa (al-len [PrimitiveAlias] (.primitive_aliases s))
          (mut pai) 0]
      (loop (if (>= (load pai) npa)
                (break)
                (do
                  (al-push! (mut (field stage-ls primitive_aliases))
                            (al-get [PrimitiveAlias] (.primitive_aliases s) (load pai)))
                  (set! pai (+ (load pai) 1))))))
    (set! (.srccount stage-ls) (.srccount s))
    (set! (.sources stage-ls) (.sources s))
    (set! (.expansions stage-ls) (.expansions s))
    (set! (.namespace_names stage-ls) (.namespace_names s))
    (set! (.namespace_paths stage-ls) (.namespace_paths s))
    ;; Imported libraries depend on the ambient core program: copy its forms
    ;; into the isolated source set. Core's own Code-signed macros never become
    ;; stage entries (stage-declared-names filters to declared names), but they
    ;; stay available while the stage program's code goes through ordinary
    ;; expansion.
    (let [parent-forms (box-al [TaggedForm] a (load (field s out)))
          np (al-len [TaggedForm] (load parent-forms))
          (mut pi) 0]
      (loop (if (>= (load pi) np)
                (break)
                (do
                  (let [tf (al-elem [TaggedForm] parent-forms (load pi))]
                    (match (.module tf)
                      (Some [m]
                        (when (= m "coil.core")
                          (al-push! (mut (field stage-ls out)) (load tf))
                          0))
                      (None [] 0)))
                  (set! pi (+ (load pi) 1))))))
    (let [nf (al-len [TaggedForm] (load forms))
          (mut fi) 0]
      (loop (if (>= (load fi) nf)
                (break)
                (do
                  (al-push! (mut (field stage-ls out))
                            (al-get [TaggedForm] (load forms) (load fi)))
                  (set! fi (+ (load fi) 1))))))
    ;; A stage may import ordinary libraries whose implementations use macros.
    ;; Run the normal definition-time expansion tower before extracting the
    ;; closure; otherwise those calls reach checking as raw Code-macro calls.
    (let [initial-source (box-al [TaggedForm] a (load (field stage-ls out)))]
      (rebuild-transformed-declarations! (mut stage-ls) initial-source))
    (match (expand-stage3 (mut stage-ls))
      (Err [d] (Err [(ptr Program) Diag] d))
      (Ok [_]
        (do
          ;; Import loading appends newly loaded library modules through
          ;; stage-ls.out; rebuild so THEIR import declarations are processed.
          ;; This must happen BEFORE the metashim joins: rebuild resets the
          ;; importer records, and the shim's imports are registered directly by
          ;; meta-sub-forms rather than through forms it returns.
          (rebuild-transformed-declarations!
            (mut stage-ls)
            (box-al [TaggedForm] a (load (field stage-ls out))))
          (imp-entry (mut stage-ls) "metashim")
          (let [stage-source (box-al [TaggedForm] a (load (field stage-ls out)))]
            (match (meta-sub-forms a (mut stage-ls) stage-source)
              (Err [d] (Err [(ptr Program) Diag] d))
              (Ok [subforms]
                (do
                  (set! (.out stage-ls) (load subforms))
                  (match (resolve-program a (mut stage-ls) false true)
                    (Err [d] (Err [(ptr Program) Diag] d))
                    (Ok [ctx]
                      (let [quals (stage-declared-names (code-sig-funcs ctx a) declared a)]
                        (if (= (al-len [(slice u8)] (load quals)) (primitive/cast i64 0))
                            ;; A poisoned entry has no callable signature, but the
                            ;; resolver already recorded the concrete reason; do
                            ;; not hide it behind the generic symptom.
                            (let [rds (load (field stage-ls resolve_diags))]
                              (if (and (!= (primitive/cast i64 rds) (primitive/cast i64 0))
                                       (> (al-len [Diag] (load rds)) (primitive/cast i64 0)))
                                  (Err [(ptr Program) Diag] (al-get [Diag] (load rds) 0))
                                  (Err [(ptr Program) Diag]
                                       (derr "stage: expected a declared [Code ...] -> Code entry; no stage entry resolved"))))
                            (let [seeds (meta-shim-seeds a ctx quals)
                                  wanted (closure-funcs ctx seeds a)
                                  sub (closure-subprogram ctx wanted a)
                                  checkls (alloc/stack LS)]
                              (set! (.a checkls) a)
                              (set! (.out checkls) (al-new [TaggedForm] a))
                              (set! (.loaded checkls) (al-new [(slice u8)] a))
                              (set! (.readpaths checkls) (al-new [(slice u8)] a))
                              (set! (.readmods checkls) (al-new [(slice u8)] a))
                              (set! (.imports checkls) (al-new [ImpEntry] a))
                              (set! (.exports checkls) (al-new [ExpEntry] a))
                              (set! (.primitive_defs checkls) (al-new [PrimitiveDef] a))
                              (set! (.primitive_aliases checkls) (al-new [PrimitiveAlias] a))
                              (set! (.check_diags checkls) (box-al [Diag] a (al-new [Diag] a)))
                              (set! (.resolve_diags checkls) (primitive/cast (ptr (ArrayList Diag)) 0))
                              (set! (.resolve_poisoned checkls) (primitive/cast (ptr (ArrayList (slice u8))) 0))
                              ;; The stage check is a SCRATCH pass over a private
                              ;; LS; snapshot the S0-S3 maps around it, exactly as
                              ;; stage-one-macro! does (check-program resets them
                              ;; at entry, and the semantic model may still be
                              ;; serving an outer invocation).
                              ;; Unlike stage-one-macro!'s closure — whose Expr
                              ;; bodies are SHARED with the authoritative program,
                              ;; so restored maps still cover them — the stage
                              ;; program's nodes are fresh, and metalower's
                              ;; ml-node-type reads the type map. Engine setup
                              ;; therefore runs INSIDE the snapshot window, on the
                              ;; maps this check just populated.
                              (let [snap (alloc/stack SemMapsSnap)]
                                (sem-maps-save snap)
                                (match (check-program a sub (mut checkls))
                                  (Err [d]
                                    (do (sem-maps-restore snap)
                                        (Err [(ptr Program) Diag] d)))
                                  (Ok [checked]
                                    (let [setup (meta-engine-setup stable-a checked quals)]
                                      (sem-maps-restore snap)
                                      (match setup
                                        (Some [d] (Err [(ptr Program) Diag] d))
                                        (None [] (Ok [(ptr Program) Diag] ctx)))))))))))))))))))))

;; Stage markers denote executable syntax. A declaration's name, parameter
;; vector, cc metadata, and return type are syntax/type data, not expression
;; positions; walking them as arbitrary calls would let an unrelated marker
;; named `path` reinterpret `(path (slice u8))` in a defn signature as a staged
;; invocation. Preserve the declaration prefix; begin discovery at the body.
(defn stage-marker-body-start [(items (ptr (ArrayList Sexp)))] (-> i64)
  (if (or (= (sx-len items) 0)
          (!= (sx-tag (sx-at items 0)) (primitive/cast i64 2)))
      0
      (let [h (sx-sval (sx-at items 0))]
        (if (= h "defn")
            (if (and (> (sx-len items) 3)
                     (and (= (sx-tag (sx-at items 2)) (primitive/cast i64 3))
                          (= (sx-sval (sx-at items 2)) "cc")))
                6
                4)
            0))))

(defn stage-entry-find [(raw (slice u8))
                        (module (Option (slice u8)))
                        (quals (ptr (ArrayList (slice u8))))
                        (a (ptr Allocator))] (-> (Option (slice u8)))
  (let [name (if (has-dot raw) raw (qualify-name a raw module))]
    (if (set-contains quals name) (Some name) (None [(slice u8)]))))

(defn expand-stage-marker-items [(a (ptr Allocator))
                                 (items (ptr (ArrayList Sexp)))
                                 (module (Option (slice u8)))
                                 (phasectx (ptr Program))
                                 (quals (ptr (ArrayList (slice u8))))
                                 (markers (ptr (ArrayList (slice u8))))
                                 (impb (ptr (ArrayList ImpEntry)))
                                 (expb (ptr (ArrayList ExpEntry)))
                                 (allfns (ptr SBox))
                                 (gs (ptr SBoxStruct))
                                 (gu (ptr SBoxSum))
                                 (depth (mut i64))]
                                (-> (Result (ptr (ArrayList Sexp)) Diag))
  (let [n (sx-len items)
        start (stage-marker-body-start items)
        (mut out) (al-new [Sexp] a)
        (mut i) 0
        (mut errf) (None [Diag])]
    (loop (if (>= (load i) start)
              (break)
              (do (al-push! (mut out) (sx-at items (load i)))
                  (set! i (+ (load i) 1)))))
    (loop (if (or (diag-some? (load errf)) (>= (load i) n))
              (break)
              (do
                (match (expand-stage-markers a (al-elem [Sexp] items (load i))
                                             module phasectx quals markers impb expb
                                             allfns gs gu (mut depth))
                  (Err [d] (set! errf (Some d)))
                  (Ok [item] (al-push! (mut out) item)))
                (set! i (+ (load i) 1)))))
    (match (load errf)
      (Some [d] (Err [(ptr (ArrayList Sexp)) Diag] d))
      (None [] (Ok [(ptr (ArrayList Sexp)) Diag] (box-al [Sexp] a (load out)))))))

;; Walk arbitrary transform output looking ONLY for lists headed by a declared
;; marker. Everything else is copied structurally: the compiler does not guess
;; which list heads are calls, quoted data, binders, or a guest language's
;; different syntax — the transform owns those decisions, and therefore also
;; owns guest-language scope and hygiene.
(defn expand-stage-markers [(a (ptr Allocator))
                            (form (ptr Sexp))
                            (module (Option (slice u8)))
                            (phasectx (ptr Program))
                            (quals (ptr (ArrayList (slice u8))))
                            (markers (ptr (ArrayList (slice u8))))
                            (impb (ptr (ArrayList ImpEntry)))
                            (expb (ptr (ArrayList ExpEntry)))
                            (allfns (ptr SBox))
                            (gs (ptr SBoxStruct))
                            (gu (ptr SBoxSum))
                            (depth (mut i64))] (-> (Result Sexp Diag))
  (let [tag (sx-tag (load form))]
    (if (or (= tag (primitive/cast i64 6)) (= tag (primitive/cast i64 7)))
        (let [items (sx-items (load form))
              quoted
                (and (= tag (primitive/cast i64 6))
                     (and (> (sx-len items) (primitive/cast i64 0))
                          (and (= (sx-tag (sx-at items 0)) (primitive/cast i64 2))
                               (= (sx-sval (sx-at items 0)) "quote"))))
              marker
                (and (= tag (primitive/cast i64 6))
                     (and (> (sx-len items) (primitive/cast i64 0))
                          (and (= (sx-tag (sx-at items 0)) (primitive/cast i64 2))
                               (set-contains markers (sx-sval (sx-at items 0))))))]
          ;; A stage marker inside quoted syntax is data, not an invocation:
          ;; transforms use quoted values as persistent state between fixpoint
          ;; rounds, and descending into either violates the generic rule.
          (if quoted
              (Ok [Sexp Diag] (load form))
              (if marker
                  (if (< (sx-len items) (primitive/cast i64 2))
                      (Err [Sexp Diag]
                           (stamp-call-site
                             (derr "stage invocation: expected (MARKER ENTRY ARG...)")
                             (load form)))
                      (if (not (or (= (sx-tag (sx-at items 1)) (primitive/cast i64 2))
                                   (= (sx-tag (sx-at items 1)) (primitive/cast i64 4))))
                          (Err [Sexp Diag]
                               (stamp-call-site
                                 (derr "stage invocation: ENTRY must be a symbol or string")
                                 (load form)))
                          (let [raw (sx-sval (sx-at items 1))]
                            (match (stage-entry-find raw module quals a)
                              (None []
                                (Err [Sexp Diag]
                                     (stamp-call-site
                                       (derr (sconcat3 a "stage invocation: entry '" raw
                                                       "' is not available in this phase"))
                                       (load form))))
                              (Some [entry]
                                (do
                                  (set! depth (+ (load depth) 1))
                                  (if (> (load depth) (primitive/cast i64 100000))
                                      (Err [Sexp Diag]
                                           (stamp-call-site
                                             (derr "stage invocation expansion did not terminate")
                                             (load form)))
                                      (match (expand-macro phasectx entry (rest-from a items 2)
                                                           (field allfns items)
                                                           (field gs items)
                                                           (field gu items)
                                                           impb expb a)
                                        (Err [d]
                                          (Err [Sexp Diag] (stamp-call-site d (load form))))
                                        (Ok [out]
                                          ;; A stage may explicitly request another
                                          ;; staged computation in its result.
                                          ;; Re-enter only for a declared marker,
                                          ;; never for an ordinary list head.
                                          (expand-stage-markers a (box-sexp a out)
                                                                module phasectx quals markers
                                                                impb expb allfns gs gu
                                                                (mut depth)))))))))))
                  (match (expand-stage-marker-items a items module phasectx quals markers
                                                    impb expb allfns gs gu (mut depth))
                    (Err [d] (Err [Sexp Diag] d))
                    (Ok [out]
                      (Ok [Sexp Diag]
                          (if (= tag (primitive/cast i64 7))
                              (mk-sexp-src (KVec out) form)
                              (mk-sexp-src (KList out) form))))))))
        (Ok [Sexp Diag] (load form)))))

;; Execute only explicit phase requests, then return their raw Code to the
;; syntax-transform fixpoint. Ordinary Coil expansion and Coil hygienization do
;; not run at this boundary: a Scheme transformer's output may be Scheme syntax,
;; which must re-enter Scheme lowering on the next round (language resumption).
(defn expand-staged-calls [(a (ptr Allocator))
                           (forms (ptr (ArrayList TaggedForm)))
                           (phasectx (ptr Program))
                           (quals (ptr (ArrayList (slice u8))))
                           (markers (ptr (ArrayList (slice u8))))
                           (impb (ptr (ArrayList ImpEntry)))
                           (expb (ptr (ArrayList ExpEntry)))]
                          (-> (Result (ptr (ArrayList TaggedForm)) Diag))
  (let [allfns (all-defn-names forms a)
        gs (unwrap-ptr [SBoxStruct] (create [SBoxStruct] a))
        gu (unwrap-ptr [SBoxSum] (create [SBoxSum] a))
        result (unwrap-ptr [SBoxTF] (create [SBoxTF] a))
        (mut depthv) 0
        (mut errf) (None [Diag])
        (mut i) 0
        n (al-len [TaggedForm] (load forms))]
    (set! (.items gs) (al-new [StructDef] a))
    (set! (.items gu) (al-new [SumDef] a))
    (set! (.items result) (al-new [TaggedForm] a))
    (loop (if (or (diag-some? (load errf)) (>= (load i) n))
              (break)
              (do
                (let [tf (al-elem [TaggedForm] forms (load i))
                      module (.module tf)]
                  (match (expand-stage-markers a (field tf form) module
                                               phasectx quals markers impb expb
                                               allfns gs gu
                                               (mut depthv))
                    (Err [d] (set! errf (Some d)))
                    (Ok [outf]
                        (do-produced (box-sexp a outf) module result gs gu
                                     allfns a (mut errf)))))
                (set! i (+ (load i) 1)))))
    (match (load errf)
      (Some [d] (Err [(ptr (ArrayList TaggedForm)) Diag] d))
      (None [] (Ok [(ptr (ArrayList TaggedForm)) Diag]
                   (field result items))))))

; print all collected `(primitive/warn …)` diagnostics (located, non-fatal) to stderr, each
; followed by the `help: try: …` line of any `(primitive/suggest …)` that produced it.
(defn drain-warnings [(s (mut LS))] (-> i64)
  (let [w (stderr)
        a (load (field s a))
        lst (warn-list)
        n (unless (diag-quiet?) (al-len [Diag] (load lst)))
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (render-diag w (mut s) (al-get [Diag] (load lst) (load i)))
                (wb w 10)
                (sug-print-help w a (load i))
                (set! i (primitive/iadd (load i) 1)))))
    0))

; Run syntax-phase transforms to a fixpoint, then syntax-phase checkers once. No
; resolve/typecheck is attempted here: these metaprograms intentionally see the
; author's raw forms, and semantic reflection therefore observes an empty model.
(defn run-before-expand [(transformers (ptr (ArrayList (slice u8))))
                         (checkers (ptr (ArrayList (slice u8))))
                         (checked (ptr Program))
                         (forms (ptr (ArrayList TaggedForm)))
                         (allfns (ptr SBox))
                         (gs (ptr SBoxStruct))
                         (gu (ptr SBoxSum))
                         (impb (ptr (ArrayList ImpEntry)))
                         (expb (ptr (ArrayList ExpEntry)))
                         (s (mut LS))
                         (a (ptr Allocator))] (-> (Result (ptr (ArrayList TaggedForm)) Diag))
  (clear-sem-model)
  (let [(mut cur) forms
        phasectx (stage-expansion-context checked a)
        (mut stage-quals) (al-new [(slice u8)] a)
        (mut stage-markers) (al-new [(slice u8)] a)
        (mut staged-forms) (al-new [TaggedForm] a)
        (mut staged-defs) (al-new [(slice u8)] a)
        (mut iters) 0
        (mut done) false
        (mut errf) (None [Diag])]
    (loop (if (or (load done) (diag-some? (load errf)))
              (break)
              (match (run-transformers transformers checked (load cur) allfns gs gu impb expb a)
                (Err [d] (do (set! errf (Some d)) 0))
                (Ok [next]
                  (let [(mut runtime) (al-new [TaggedForm] a)
                        (mut staged) (al-new [TaggedForm] a)
                        (mut round) next
                        (mut stage-progress) false]
                    (match (split-stage-declarations! a next (mut runtime) (mut staged)
                                                      (mut stage-markers))
                      (Some [d] (set! errf (Some d)))
                      (None []
                        (do
                          (when (> (al-len [TaggedForm] (load staged)) (primitive/cast i64 0))
                            (set! stage-progress true)
                            (match (stage-form-name-conflict
                                     (box-al [TaggedForm] a (load staged))
                                     (box-al [(slice u8)] a (load staged-defs)) a)
                              (Some [name]
                                (set! errf
                                      (Some (derr (sconcat3 a "stage: definition '" name
                                                            "' was introduced more than once")))))
                              (None []
                                (do
                                  ;; Stage declarations join the CUMULATIVE phase
                                  ;; program: later increments and later rounds
                                  ;; may call the entries earlier ones installed.
                                  (stage-record-form-names!
                                    (box-al [TaggedForm] a (load staged))
                                    (mut staged-defs) a)
                                  (let [ns (al-len [TaggedForm] (load staged))
                                        (mut si) 0]
                                    (loop (if (>= (load si) ns)
                                              (break)
                                              (do
                                                (al-push! (mut staged-forms)
                                                          (al-get [TaggedForm] (load staged) (load si)))
                                                (set! si (+ (load si) 1))))))
                                  ;; The stage compilation allocates from the
                                  ;; durable allocator for now: a disposable
                                  ;; per-increment arena needs a completed
                                  ;; ownership audit first (the engine image
                                  ;; shares mono/interp structure with the
                                  ;; checked graph — the branch's "premature
                                  ;; freeing created dangling registries" trap).
                                  ;; Mainline stage3 makes the same trade on its
                                  ;; success round.
                                  (match (compile-stage-declarations
                                           a a (mut s)
                                           (box-al [TaggedForm] a (load staged-forms))
                                           (box-al [(slice u8)] a (load staged-defs)))
                                    (Err [d]
                                      (do
                                        (set! errf (Some (stable-stage-diag a d)))
                                        0))
                                    (Ok [stagectx]
                                      (let [new-quals (install-stage-signatures!
                                                        phasectx stagectx
                                                        (box-al [(slice u8)] a (load stage-quals))
                                                        (box-al [(slice u8)] a (load staged-defs))
                                                        a)
                                            nq (al-len [(slice u8)] (load new-quals))
                                            (mut qi) 0]
                                        (loop (if (>= (load qi) nq)
                                                  (break)
                                                  (do
                                                    (al-push! (mut stage-quals)
                                                              (al-get [(slice u8)] (load new-quals) (load qi)))
                                                    (set! qi (+ (load qi) 1)))))
                                        0)))
                                  0)))
                            0)
                          (unless (diag-some? (load errf))
                            (if (= (al-len [(slice u8)] (load stage-quals)) (primitive/cast i64 0))
                                (set! round (box-al [TaggedForm] a (load runtime)))
                                (match (expand-staged-calls
                                         a
                                         (box-al [TaggedForm] a (load runtime))
                                         phasectx
                                         (box-al [(slice u8)] a (load stage-quals))
                                         (box-al [(slice u8)] a (load stage-markers))
                                         impb expb)
                                  (Err [d] (set! errf (Some d)))
                                  (Ok [expanded] (set! round expanded)))))
                          0)))
                    (unless (diag-some? (load errf))
                      (if (forms-equal (load cur) (load round))
                          (set! done true)
                          ;; A round that declared a stage may legitimately need
                          ;; further rounds (macro-defining-macros consume one
                          ;; round per dependency layer); those count against a
                          ;; wider cap than plain transform non-convergence.
                          (if (and (>= (load iters) (primitive/cast i64 16))
                                   (not (load stage-progress)))
                              (set! errf
                                    (Some (derr "before-expand transform: did not reach a fixpoint after 16 rounds")))
                              (if (>= (load iters) (primitive/cast i64 64))
                                  (set! errf
                                        (Some (derr "before-expand staging: did not reach a fixpoint after 64 rounds")))
                                  (do
                                    (set! cur (load round))
                                    ;; Staged results may add defns; the hygiene
                                    ;; name index must see them.
                                    (let [fresh (all-defn-names (load cur) a)]
                                      (set! (.items allfns) (.items fresh)))
                                    (set! iters (primitive/iadd (load iters) 1))
                                    0)))))
                    0)))))
    (match (load errf)
      (Some [d] (Err [(ptr (ArrayList TaggedForm)) Diag] d))
      (None []
            (match (run-checkers checkers checked (load cur) allfns gs gu impb expb a)
              (Some [d] (Err [(ptr (ArrayList TaggedForm)) Diag] d))
              (None []
                    (if (> (diag-errs) (primitive/cast i64 0))
                        (Err [(ptr (ArrayList TaggedForm)) Diag]
                             (derr "compilation failed: checker reported error(s) above"))
                        (Ok [(ptr (ArrayList TaggedForm)) Diag] (load cur)))))))))

;; A before-expand transform returns the authoritative module form list and may
;; add or remove imports/exports. The loader indexed the pre-transform program,
;; so rebuild those declaration tables before ordinary expansion/resolution.
;; Imported source files are already memoized; process-import repeats only the
;; importer-specific alias/:use/:reexport bookkeeping.
(defn rebuild-transformed-declarations! [(s (mut LS))
                                         (forms (ptr (ArrayList TaggedForm)))] (-> i64)
  (let [a (load (field s a))
        n (al-len [TaggedForm] (load forms))
        (mut i) 0]
    (set! (.imports s) (al-new [ImpEntry] a))
    (set! (.exports s) (al-new [ExpEntry] a))
    ;; Establish every module and its direct exports before resolving imports.
    ;; The flattened form order is not a dependency order, and `:reexport`
    ;; needs the imported module's export table even when that module appears
    ;; later in the stream.
    (loop (if (or (>= (load i) n) (ls-err? (mut s)))
              (break)
              (let [tf (al-elem [TaggedForm] forms (load i))
                    f (field tf form)
                    cur (.module tf)]
                (match cur (Some [m] (do (imp-entry (mut s) m) 0)) (None [] 0))
                (match (l-list-head f)
                  (Some [h]
                    (when (= h "export") (handle-export (mut s) f cur)))
                  (None [] 0))
                (set! i (primitive/iadd (load i) 1)))))
    (set! i 0)
    (loop (if (or (>= (load i) n) (ls-err? (mut s)))
              (break)
              (let [tf (al-elem [TaggedForm] forms (load i))
                    f (field tf form)
                    cur (.module tf)]
                (match (l-list-head f)
                  (Some [h]
                    (when (= h "import") (process-import (mut s) f "" cur)))
                  (None [] 0))
                (set! i (primitive/iadd (load i) 1)))))
    0))

(defn run-expand [(s (mut LS))
                  (macros (ptr (ArrayList (slice u8))))
                  (comptime (ptr (ArrayList (slice u8))))
                  (checked (ptr Program))
                  (a (ptr Allocator))] (-> (Result i64 Diag))
  (macros-index-reset!)  ; a new run may not inherit the last one's index
  (derive-reg-reset!)  ; nor the last one's derive registrations
  (let [(mut out-forms) (box-al [TaggedForm] a (.out s))
        impb (unwrap-ptr [(ArrayList ImpEntry)] (create [(ArrayList ImpEntry)] a))
        expb (unwrap-ptr [(ArrayList ExpEntry)] (create [(ArrayList ExpEntry)] a))
        env (alloc/stack ExpEnv)
        allfns (all-defn-names (load out-forms) a)
        gs (unwrap-ptr [SBoxStruct] (create [SBoxStruct] a))
        gu (unwrap-ptr [SBoxSum] (create [SBoxSum] a))
        result (unwrap-ptr [SBoxTF] (create [SBoxTF] a))
        (mut checkers) (al-new [(slice u8)] a)
        (mut transformers) (al-new [(slice u8)] a)
        (mut pre-checkers) (al-new [(slice u8)] a)
        (mut pre-transformers) (al-new [(slice u8)] a)
        (mut i) 0
        (mut errf) (None [Diag])
        (mut depthv) 0]
    (set! impb (.imports s))
    (set! expb (.exports s))
    (set-cli-sources (field s sources))  ; expose source names to (primitive/code-file …) in checkers
    (set! (.items gs) (al-new [StructDef] a))
    (set! (.items gu) (al-new [SumDef] a))
    (set! (.items result) (al-new [TaggedForm] a))
    (set! (.macros env) macros)
    (set! (.comptime env) comptime)
    (set! (.sub env) checked)
    (set! (.impb env) impb)
    (set! (.expb env) expb)
    (set! (.bound env)
          (box a (ArrayList (slice u8)) (al-new [(slice u8)] a)))
    (set! (.a env) a)
    ; Registrations are declarations of the compilation pipeline, so discover them
    ; from the loaded source before running any of it. A macro/transform cannot
    ; retroactively generate a before-expand registration.
    (loop (if (or (diag-some? (load errf))
                  (>= (load i) (al-len [TaggedForm] (load (load out-forms)))))
              (break)
              (do
                (let [tf (alloc/stack TaggedForm)]
                  (set! tf (al-get [TaggedForm] (load (load out-forms)) (load i)))
                  (let [module (.module tf)]
                    (cond (is-register-derive-form (field tf form))
                            (match (register-derive-form! (field tf form) module macros impb expb a)
                              (Some [d] (store! errf (Some d)))
                              (None [] 0))
                          (is-checker-form (field tf form))
                            (if (and (= (sx-len (sx-items (load (field tf form)))) (primitive/cast i64 4))
                                     (not (before-expand-registration? (field tf form))))
                                (store! errf (Some (derr "checker: expected `:phase before-expand`")))
                                (match (resolve-macro (sx-sval (sx-at (sx-items (load (field tf form))) 1))
                                                      module
                                                      macros
                                                      impb
                                                      expb
                                                      a)
                                  (Some [q]
                                        (if (before-expand-registration? (field tf form))
                                            (al-push! (mut pre-checkers) q)
                                            (al-push! (mut checkers) q)))
                                  (None []
                                        (store! errf
                                                (Some (derr "checker: FN must be a [(prog Code)] -> Code function in scope"))))))
                          (is-transform-form (field tf form))
                            (if (and (= (sx-len (sx-items (load (field tf form)))) (primitive/cast i64 4))
                                     (not (or (before-expand-registration? (field tf form))
                                              (read-registration? (field tf form)))))
                                (store! errf (Some (derr "transform: expected `:phase before-expand`")))
                                (match (resolve-macro (sx-sval (sx-at (sx-items (load (field tf form))) 1))
                                                      module
                                                      macros
                                                      impb
                                                      expb
                                                      a)
                                  (Some [q]
                                        (unless (read-registration? (field tf form))
                                          (if (before-expand-registration? (field tf form))
                                              (al-push! (mut pre-transformers) q)
                                              (al-push! (mut transformers) q))
                                          0))
                                  (None []
                                        (store! errf
                                                (Some (derr "transform: FN must be a [(prog Code)] -> Code function in scope"))))))
                          :else 0)))
                (set! i (primitive/iadd (load i) 1)))))
    (match (load errf)
      (Some [d] (Err [i64 Diag] d))
      (None []
            (match (run-before-expand (box-al [(slice u8)] a (load pre-transformers))
                                      (box-al [(slice u8)] a (load pre-checkers))
                                      checked
                                      (load out-forms)
                                      allfns
                                      gs
                                      gu
                                      impb
                                      expb
                                      (mut s)
                                      a)
              (Err [d] (do (drain-warnings (mut s)) (Err [i64 Diag] d)))
              (Ok [raw]
                  (do
                    (set! out-forms raw)
                    (rebuild-transformed-declarations! (mut s) raw)
                    (set! impb (.imports s))
                    (set! expb (.exports s))
                    ; A syntax transform may add/remove definitions; refresh the name
                    ; set used for hygiene before expanding its result.
                    (let [fresh (all-defn-names raw a)]
                      (set! (.items allfns) (.items fresh)))
                    (set! i 0)
                    (loop (if (or (diag-some? (load errf))
                                  (>= (load i) (al-len [TaggedForm] (load raw))))
                              (break)
                              (do
                                (let [tf (alloc/stack TaggedForm)]
                                  (set! tf (al-get [TaggedForm] (load raw) (load i)))
                                  (let [module (.module tf)]
                                    ; Registration forms configure the compiler and
                                    ; are never part of the runtime program.
                                    (if (or (is-checker-form (field tf form))
                                            (or (is-transform-form (field tf form))
                                                (is-register-derive-form (field tf form))))
                                        0
                                        (match (expand-top-form (field tf form)
                                                                module
                                                                env
                                                                (field allfns items)
                                                                (field gs items)
                                                                (field gu items)
                                                                (mut depthv)
                                                                (mut s))
                                          (Err [d] (set! errf (Some d)))
                                          (Ok [outf]
                                              (do-produced (box-sexp a outf) module result gs gu allfns a (mut errf)))))))
                                (set! i (primitive/iadd (load i) 1)))))
                    (match (load errf)
                      (Some [d] (Err [i64 Diag] d))
                      (None []
                            (do
                              (set! (.out s) (.items result))
                              (register-checkers (box-al [(slice u8)] a (load pre-checkers))
                                                 (box-al [(slice u8)] a (load checkers))
                                                 (box-al [(slice u8)] a (load transformers))
                                                 checked
                                                 allfns
                                                 gs
                                                 gu)
                              (Ok [i64 Diag] 0)))))))))))
(defn do-produced [(outf (ptr Sexp))
                   (module (Option (slice u8)))
                   (result (ptr SBoxTF))
                   (gs (ptr SBoxStruct))
                   (gu (ptr SBoxSum))
                   (allfns (ptr SBox))
                   (a (ptr Allocator))
                   (errf (mut (Option Diag)))] (-> i64)
  (let [(mut produced) (al-new [Sexp] a)]
    (splice-do-into! (mut produced) outf)
    (let [np (al-len [Sexp] (load produced))
          (mut j) 0]
      (loop (if (or (diag-some? (load errf)) (>= (load j) np))
                (break)
                (do
                  (let [form (al-elem [Sexp] produced (load j))]
                    (match (register-generated-decl form module gs gu a)
                      (Some [d] (do (set! errf (Some d)) 0))
                      (None []
                            (do
                              (match (defn-name-of form)
                                (Some [nm] (al-push! (mut (.items allfns)) (qualify-name a nm module)))
                                (None [] 0))
                              (let [tf (alloc/stack TaggedForm)]
                                (set! (.form tf) (load form))
                                (set! (.module tf) module)
                                (al-push! (mut (.items result)) (load tf))
                                0)))))
                  (set! j (primitive/iadd (load j) 1)))))))
  0)
(defn d-expanded [(w (ptr Writer)) (a (ptr Allocator)) (s (mut LS))] (-> i64)
  (ps w "(forms")
  (let [n (al-len [TaggedForm] (.out s))
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (ps w " (tf ")
                (let [tf (alloc/stack TaggedForm)]
                  (set! tf (al-get [TaggedForm] (.out s) (load i)))
                  (d-opt-str w (.module tf))
                  (wb w 32)
                  (let [fp (alloc/stack Sexp)]
                    (set! fp (.form tf))
                    (sx-node w fp)))
                (wb w 41)
                (set! i (primitive/iadd (load i) 1))))))
  (wb w 41)
  0)
(defn d-hygiene [(w (ptr Writer)) (s (mut LS))] (-> i64)
  (ps w "(forms")
  (let [n (al-len [TaggedForm] (.out s)) (mut i) 0]
    (loop (if (>= (load i) n) (break)
              (do
                (ps w " (tf ")
                (let [tf (al-elem [TaggedForm] (field s out) (load i))]
                  (d-opt-str w (.module tf))
                  (wb w 32)
                  (sx-hnode w (field tf form)))
                (wb w 41)
                (set! i (primitive/iadd (load i) 1))))))
  (wb w 41)
  0)
(defn dump-hygiene-program [(a (ptr Allocator)) (src (slice u8)) (cwd (slice u8))] (-> i64)
  (let [bout (alloc/stack BufferedOutput)
        w (buffered-output-writer bout (stdout))
        s (alloc/stack LS)
        (mut rc) 0]
    (ls-init! (mut s) a)
    (set! (.srccount s) 1)
    (register-source! (mut s) "<source>" src)
    (match (read-all a src 0)
      (Err [d] (let [dp (alloc/stack Diag)] (set! dp d) (dump-error w dp) (set! rc 1)))
      (Ok [forms]
          (do (namespace-index-build! (mut s))
              (load-program (mut s) forms cwd)
              (if (ls-err? (mut s))
                  (let [dp (alloc/stack Diag)] (set! dp (.loaderr s)) (dump-error w dp) (set! rc 1))
                  (match (expand-stage3 (mut s))
                    (Err [d] (let [dp (alloc/stack Diag)] (set! dp d) (dump-error w dp) (set! rc 1)))
                    (Ok [_]
                        (do
                          ; Include transform-produced syntax in the audit view.
                          (match (run-transforms-and-check a (mut s))
                            (Err [d]
                                 (let [dp (alloc/stack Diag)]
                                   (set! dp d)
                                   (dump-error w dp)
                                   (set! rc 1)))
                            (Ok [_] (d-hygiene w (mut s)))))))))))
    (buffered-output-flush bout)
    (load rc)))
(defn dump-expand-program [(a (ptr Allocator)) (src (slice u8)) (cwd (slice u8))] (-> i64)
  (let [bout (alloc/stack BufferedOutput)
        w (buffered-output-writer bout (stdout))
        s (alloc/stack LS)]
    (ls-init! (mut s) a)
    (set! (.srccount s) 1)
    (register-source! (mut s) "<source>" src)
    (match (read-all a src 0)
      (Err [d] (let [dp (alloc/stack Diag)] (set! dp d) (dump-error w dp)))
      (Ok [forms]
          (do
            ; the project/dependency namespace index, exactly as the driver's pipeline
            ; entries build it — without this an import of a project namespace resolves
            ; under `check`/`build` but not under `expand`.
            (namespace-index-build! (mut s))
            (load-program (mut s) forms cwd)
            (match (expand-stage3 (mut s))
              (Err [d] (let [dp (alloc/stack Diag)] (set! dp d) (dump-error w dp)))
              (Ok [_] (d-expanded w a (mut s)))))))
    (buffered-output-flush bout))
  0)

; ── `coil expand FILE` — the program AS SOURCE after macros AND transforms ────
; Reprints the user file's top-level forms once every macro has expanded and every
; registered transform has rewritten the program (the state a checker/mono sees),
; so a metaprogram's effect is directly readable. An Sexp → source pretty-printer.
(defn sx-atom-text [(w (ptr Writer)) (a (ptr Allocator)) (x Sexp)] (-> i64)
  (let [tg (sx-tag x)]
    (cond (= tg (primitive/cast i64 0)) (ps w (i64->str a (sx-ival x)))
          (= tg (primitive/cast i64 2)) (ps w (sx-sval x))
          (= tg (primitive/cast i64 3)) (do (wb w 58) (ps w (sx-sval x)) 0)
          (= tg (primitive/cast i64 4)) (do (wb w 34) (ps w (sx-sval x)) (wb w 34) 0)
          (= tg (primitive/cast i64 5)) (do (wb w 99) (wb w 34) (ps w (sx-sval x)) (wb w 34) 0)
          :else (do (ps w "<") (ps w (i64->str a tg)) (ps w ">") 0))))
; rendered inline width of a node — used to decide whether to break a list
(defn sx-width [(a (ptr Allocator)) (x Sexp)] (-> i64)
  (let [tg (sx-tag x)]
    (cond (= tg (primitive/cast i64 0)) (slice-len (i64->str a (sx-ival x)))
          (= tg (primitive/cast i64 2)) (slice-len (sx-sval x))
          (= tg (primitive/cast i64 3)) (primitive/iadd 1 (slice-len (sx-sval x)))
          (= tg (primitive/cast i64 4)) (primitive/iadd 2 (slice-len (sx-sval x)))
          (= tg (primitive/cast i64 5)) (primitive/iadd 3 (slice-len (sx-sval x)))
          (or (= tg (primitive/cast i64 6)) (= tg (primitive/cast i64 7)))
            (let [items (sx-items x)
                  n (sx-len items)
                  (mut wsum) 2
                  (mut i) 0]
              (loop (if (>= (load i) n)
                        (break)
                        (do
                          (store! wsum
                                  (primitive/iadd (primitive/iadd (load wsum)
                                                                  (when (> (load i) (primitive/cast i64 0))
                                                                    1))
                                                  (sx-width a (sx-at items (load i)))))
                          (store! i (primitive/iadd (load i) 1)))))
              (load wsum))
          :else 3)))
(defn sx-emit [(w (ptr Writer)) (a (ptr Allocator)) (x Sexp) (col i64)] (-> i64)
  (let [tg (sx-tag x)]
    (if (not (or (= tg (primitive/cast i64 6)) (= tg (primitive/cast i64 7))))
        (sx-atom-text w a x)
        (let [items (sx-items x)
              n (sx-len items)
              open (if (= tg (primitive/cast i64 7)) 91 40)
              close (if (= tg (primitive/cast i64 7)) 93 41)]
          (if (= n (primitive/cast i64 0))
              (do (wb w open) (wb w close) 0)
              ; inline if it fits within the line budget from the current column
              (if (<= (primitive/iadd col (sx-width a x)) (primitive/cast i64 92))
                  (do
                    (wb w open)
                    (let [(mut i) 0]
                      (loop (if (>= (load i) n)
                                (break)
                                (do
                                  (when (> (load i) (primitive/cast i64 0)) (wb w 32))
                                  (sx-emit w a (sx-at items (load i)) 0)
                                  (set! i (primitive/iadd (load i) 1))))))
                    (wb w close)
                    0)
                  (do
                    (wb w open)
                    (sx-emit w a (sx-at items 0) (primitive/iadd col 1))
                    (let [(mut i) 1]
                      (loop (if (>= (load i) n)
                                (break)
                                (do
                                  (wb w 10)
                                  (let [(mut j) 0]
                                    (loop (if (>= (load j) (primitive/iadd col 2))
                                              (break)
                                              (do (wb w 32) (set! j (primitive/iadd (load j) 1))))))
                                  (sx-emit w a (sx-at items (load i)) (primitive/iadd col 2))
                                  (set! i (primitive/iadd (load i) 1))))))
                    (wb w close)
                    0)))))))
(defn expand-src-program [(a (ptr Allocator)) (src (slice u8)) (cwd (slice u8)) (path (slice u8))] (-> i64)
  (let [w (stdout)
        s (alloc/stack LS)]
    (ls-init! (mut s) a)
    (set! (.srccount s) 1)
    (register-source! (mut s) path src)  ; real path -> code-from-user? true
    ; A macro/expansion failure is a real error: route it through the SAME located
    ; diagnostic printer build/run use (report-diag, on stderr) and exit non-zero.
    ; Nothing goes to stdout on failure — `coil expand` is a debugger, not a liar.
    (match (read-all a src 0)
      (Err [d] (do (report-diag (stderr) (mut s) d) 1))
      (Ok [forms]
          (do
            (namespace-index-build! (mut s))
            (load-program (mut s) forms cwd)
            (if (ls-err? (mut s))
                (do (report-diag (stderr) (mut s) (.loaderr s)) 1)
                (match (expand-stage3 (mut s))
                  (Err [d] (do (report-diag (stderr) (mut s) d) 1))
                  (Ok [_]
                      ; run the transform fixpoint (mutates s.out to the rewritten program);
                      ; print regardless of whether the final strict check passes.
                      (do
                        (match (run-transforms-and-check a (mut s)) (Err [d] 0) (Ok [_] 0))
                        (let [out (field s out)
                              n (al-len [TaggedForm] (load out))
                              (mut i) 0]
                          (loop (if (>= (load i) n)
                                    (break)
                                    (do
                                      (let [tf (al-elem [TaggedForm] out (load i))
                                            fp (field tf form)]
                                        ; the file's OWN top-level forms are source 0
                                        (when (= (sx-source (load fp)) (primitive/cast i64 0))
                                          (sx-emit w a (load fp) 0)
                                          (wb w 10)
                                          (wb w 10)
                                          0))
                                      (set! i (primitive/iadd (load i) 1)))))
                          0))))))))))
