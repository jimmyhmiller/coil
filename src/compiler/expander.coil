; src/compiler/expander.coil — self-host Coil compiler, expander module.

(module coil.compiler.expander)
(import "coil.compiler.retained_heap" :as retained-heap)
(import "coil.primitive" :as primitive)
(import "coil.compiler.unit_state" :use *)

(defstruct ExpanderUnitState
  [(macro_index MacIdx)
   (macro_memo MacMemo)
   (expansion_arena EmArenaPool)
   (arena_mode EmArenaMode)
   (stages StageBox)
   (checkers CheckerRegBox)
   (elaboration_id i64)
   ; Every qualified name the program being expanded declares, so a bare macro
   ; head can yield to a module's own function of that name. Set by run-expand.
   (declared DeclaredNames)
   ; The written form of each metaprogram call the tower has not judged yet
   ; (see `tower-defer-call!`). Keyed by node id, which this unit numbers.
   (written_calls WrittenCalls)
   ; Every trait the program being expanded declares, by qualified name, so a
   ; trait named at expansion time (`register-derive`, `derive`) resolves to one
   ; declaration. Set wherever derive registrations are read.
   (traits DeclaredTraits)
   ; the macro-call settings read from the environment, once per expansion
   (macro_config MacroConfig)])

(defstruct MacroConfig [(ready bool) (limit i64) (trace (ptr i8))])

(defstruct WrittenCalls [(ready bool) (calls (HashMap i64 Sexp))])

(defstruct DeclaredNames [(ready bool) (names (HashMap (slice u8) bool))])

;;; The traits the expansion knows: those the program's forms declare, those
;;; macros have generated so far, and, in a session, the traits its earlier
;;; submissions declared (PARENT, their declaration table, or null).
(defstruct DeclaredTraits
  [(init bool)
   (ready bool)
   (names (HashMap (slice u8) bool))
   (parent (ptr (ArrayList DefEntry)))])

(defn expander-unit-state-cell [] (-> (ptr (ptr ExpanderUnitState)))
  (primitive/alloc-static (ptr ExpanderUnitState)))

(defn expander-unit-state [] (-> (ptr ExpanderUnitState))
  (let [active (load (expander-unit-state-cell))]
    (if (= (primitive/cast i64 active) 0)
        (primitive/alloc-static ExpanderUnitState)
        active)))

(defn expander-unit-bind! [(next (ptr ExpanderUnitState))] (-> (ptr ExpanderUnitState))
  (let [prior (expander-unit-state)]
    (set! (expander-unit-state-cell) next)
    (macro-config-reset!)
    prior))

(import "coil.alloc" :as alloc :use *)
(import "coil.result" :use *)
(import "coil.slice" :use *)
(import "coil.str" :use *)
(import "coil.arraylist" :use *)
(import "coil.io" :use *)
(import "coil.control" :use *)
(import "coil.try" :use *)
(import "coil.compiler.ast" :use *)
(import "coil.compiler.mtrace" :use *)
(import "coil.compiler.ctval" :use *)  ; CtVal / EnvBind / CtCtx (was reached via comptime.coil)

(import "coil.compiler.astdump" :use *)
(import "coil.compiler.check" :use *)
(import "coil.compiler.comptime" :use *)
(import "coil.compiler.sem_base" :use [sem-no-base])
(import "coil.compiler.diag" :use *)
(import "coil.compiler.loader" :use *)
(import "coil.compiler.parser" :use *)
(import "coil.reader" :use *)
(import "coil.compiler.resolve" :use *)
(import "coil.compiler.metaengine" :use *)
(import "coil.hashmap" :use *)  ; the macro-name index (macros-has?)

(import "coil.scratch" :as scratch)
(import "coil.cc" :as cc)
(import "coil.compiler.trace" :as tr)
(import "coil.compiler.checked_base" :as checkedbase)
(import "coil.compiler.dep_index" :as deps)
(import "coil.phase" :as phase)

(defn defn-name-of [(f (ptr Sexp))] (-> (Option (slice u8)))
  (if (!= (sx-tag (load f)) 6)
      (None [(slice u8)])
      (let [it (sx-items (load f))]
        (if (< (sx-len it) 2)
            (None [(slice u8)])
            (if (and (= (sx-tag (sx-at it 0)) 2)
                     (and (= (sx-sval (sx-at it 0)) "defn*")
                          (= (sx-tag (sx-at it 1)) 2)))
                (Some (sx-sval (sx-at it 1)))
                (None [(slice u8)]))))))

(defn source-defn-name-of [(f (ptr Sexp))] (-> (Option (slice u8)))
  (if (and (= (sx-tag (load f)) 6)
           (and (>= (sx-len (sx-items (load f))) 2)
                (= (sx-head-name (sx-items (load f))) "defn")))
      (let [name (sx-at (sx-items (load f)) 1)]
        (if (= (sx-tag name) 2) (Some (sx-sval name)) (None [(slice u8)])))
      (defn-name-of f)))

(defn qualify-name [(a (dyn Allocator)) (n (slice u8)) (m (Option (slice u8)))] (-> (slice u8))
  (match m (Some [md] (sconcat3 a md "." n)) (None [] n)))

;;; Push the method names a `(deftrait Name [Self] (m [params] ret) …)` declares.
;;;
;;; They belong in `module_fns` for exactly the reason `defn` names do: that list is
;;; what referential hygiene consults, and a name missing from it is left BARE in a
;;; macro template — so it binds wherever the expansion lands rather than where the
;;; macro was written.
;;;
;;; Trait methods were omitted, so every operator (`=`, `<`, `+`, …) escaped hygiene
;;; and could be captured by the caller. `coil.assert` was the casualty: `assert-eq`
;;; expands to `(if (= x y) …)`, and in a module defining its own `=` that became the
;;; CALLER's `=`, so `(assert-eq 1 999)` passed and the suite reported green while
;;; asserting nothing. docs/design/TRAIT_METHOD_HYGIENE.md has the analysis;
;;; tests/meta/hygiene_identity.coil and hygiene_capture.coil test both directions.
;;;
;;; This decides only WHICH NAME a template means — a property of where the code was
;;; written, which is what lexical scope requires. It does not touch WHICH IMPL runs:
;;; the checker still selects that from the argument's type, so `(= my-point other)`
;;; keeps finding `impl Eq Point`.
(defn trait-method-names-into! [(f (ptr Sexp))
                                (out (ptr SBox))
                                (m (Option (slice u8)))
                                (a (dyn Allocator))] (-> i64)
  (when (= (sx-tag (load f)) 6)
    (let [it (sx-items (load f))]
      (when (and (>= (sx-len it) 3)
                 (and (= (sx-tag (sx-at it 0)) 2)
                      (= (sx-sval (sx-at it 0)) "deftrait")))
        ; `(deftrait Name [Self …] :requires […] (method [params] (-> ret)) …)`.
        ; A method is a trailing LIST whose head is a symbol; the type-parameter
        ; vector and any keyword arguments fail that shape test on their own.
        (let [n (sx-len it)
              (mut i) 2]
          (loop (if (>= (load i) n)
                    (break)
                    (do
                      (let [e (sx-at it (load i))]
                        (when (and (= (sx-tag e) 6)
                                   (> (sx-len (sx-items e))
                                      0))
                          (let [h (sx-at (sx-items e) 0)]
                            (when (= (sx-tag h) 2)
                              (push! (mut (field out items))
                                     (qualify-name a (sx-sval h) m))
                              0))
                          0))
                      (store! i (primitive/iadd (load i) 1)))))))
      0))
  0)

(defn is-comptime-defn [(f (ptr Sexp))
                        (module (Option (slice u8)))
                        (comptime (ptr (ArrayList (slice u8))))
                        (a (dyn Allocator))] (-> bool)
  (match (defn-name-of f)
    (None [] false)
    (Some [n] (set-contains comptime (qualify-name a n module)))))

; ── the macro-name index ─────────────────────────────────────────────────────
; `resolve-macro` asks "is this head a macro?" for EVERY list head in the program, and
; answered it by scanning every macro name in the program with `=` — O(heads ×
; macros), the same quadratic shape `resolve` had for definition names. Index the set.
;
; Two guards keep it honest. It records the list's ADDRESS and LENGTH and rebuilds if
; either differs, which covers a second list being asked about mid-run. And it is
; INVALIDATED at the top of every `run-expand`, which covers the one a pointer test
; cannot see: the allocator handing a fresh list the address of a dead one. A stale hit
; here would treat an ordinary call as a macro, so neither guard is optional.
(defstruct MacIdx
  [(src (ptr (ArrayList (slice u8))))
   (len i64)
   (built i64)
   (m (HashMap (slice u8) i64))
   (arena_ready i64)
   (arena scratch/ScratchArena)])

(defn macro-cache-arena-release [(raw (ptr i8))] (-> i64)
  (close! (primitive/cast (ptr scratch/ScratchArena) raw)))

; `defalias` names a macro or a reflected type exactly as it names any other
; declaration, but both are looked up before a declaration table exists.
(defn macro-aliases-collect! [(s (mut LS)) (forms (ptr (ArrayList TaggedForm)))] (-> i64)
  (decl-aliases-reset!)
  (mac-memo-reset!)
  (for [i 0 (len (load forms))]
    (let [tf (elem forms i)
          f (field tf form)]
      ; Reflection on a macro argument qualifies its spelling by source module.
      (match (.module tf)
        (Some [m] (src-mod-record (sx-source (load f)) m))
        (None [] 0))
      ; A retired alias binds to itself first, so the parent's binding below
      ; never applies to this submission.
      (when (and (= (sx-tag (load f)) 6)
                 (= (sx-len (sx-items (load f))) 2))
        (let [it (sx-items (load f))]
          (when (and (= (sx-head-name it) "retire-alias") (= (sx-tag (sx-at it 1)) 2))
            (decl-alias-put! (match (.module tf) (Some [m] m) (None [] ""))
                              (sx-sval (sx-at it 1))
                              (sx-sval (sx-at it 1))))
          ; A retired macro's compiled entry is not this submission's to expand
          ; through, even when the submission defines a macro of the same name.
          (when (and (= (sx-head-name it) "retire-defn") (= (sx-tag (sx-at it 1)) 2))
            (meta-engine-forget-inherited!
              (match (.module tf)
                (Some [m] (if (= m "") (sx-sval (sx-at it 1)) (sconcat3 (.a s) m "." (sx-sval (sx-at it 1)))))
                (None [] (sx-sval (sx-at it 1)))))
            0)))
      (when (and (= (sx-tag (load f)) 6)
                 (= (sx-len (sx-items (load f))) 3))
        (let [it (sx-items (load f))]
          (when (and (= (sx-head-name it) "defalias")
                     (and (= (sx-tag (sx-at it 1)) 2) (= (sx-tag (sx-at it 2)) 2)))
            (decl-alias-put! (match (.module tf) (Some [m] m) (None [] ""))
                              (sx-sval (sx-at it 1))
                              (sx-sval (sx-at it 2))))))))
  (let [parent (.parent s)]
    (unless (= (primitive/cast i64 parent) 0)
      (let [ws (semantic-workspace (mut parent))
            table (.declaration_table ws)]
        (unless (= (primitive/cast i64 table) 0)
          (for [i 0 (len (load table))]
            (let [entry (elem table i)
                  pairs (field (field entry defs) aliases)]
              (for [j 0 (/ (len (load pairs)) 2)]
                (decl-alias-put! (.module entry)
                                  (get (load pairs) (* j 2))
                                  (get (load pairs) (+ (* j 2) 1))))))))))
  0)

(defn mac-idx [] (-> (ptr MacIdx))
  (field (expander-unit-state) macro_index))

;;; Forget the last run's macro index, and with it the names that run's program
;;; declared (`declared-names-set!`): both live in that run's allocator. A lint
;;; target's arena is freed after its round, while the profile's unit state, and
;;; so these records, are kept for the next round. A record that survived it
;;; pointed into freed memory, and the next round's macro lookup probed a
;;; reused hash table that never answered.
(defn macros-index-reset! [] (-> i64)
  (mac-memo-reset!)
  (set! (.ready (field (expander-unit-state) declared)) false)
  (declared-traits-forget!)
  (let [ix (mac-idx)]
    (set! (.built ix) 0)
    (set! (.src ix) (primitive/cast (ptr (ArrayList (slice u8))) 0))
    (set! (.len ix) -1)
    0))

(defn macros-index-build! [(ix (ptr MacIdx)) (lst (ptr (ArrayList (slice u8))))] (-> i64)
  (let [n (len (load lst))
        (mut i) 0]
    (if (= (.arena_ready ix) 0)
        (do
          (scratch/ScratchArena::init-with-capacity (field ix arena) (retained-heap/compiler-scratch-parent) 65536)
          (unit-resource! (primitive/cast (ptr i8) (field ix arena))
                          (primitive/fnptr-of macro-cache-arena-release))
          (set! (.arena_ready ix) 1))
        (reset! (field ix arena)))
    (let [a (allocator (field ix arena))]
      (set! (.m ix) (HashMap::new [(slice u8) i64] a (keyops)))
      (loop (if (>= (load i) n)
                (break)
                (do
                  (set! (mut (.m ix)) (get (load lst) (load i)) (load i))
                  (set! i (primitive/iadd (load i) 1))))))
    (set! (.src ix) lst)
    (set! (.len ix) n)
    (set! (.built ix) 1)
    0))

(defn macros-has? [(macros (ptr (ArrayList (slice u8)))) (q (slice u8))] (-> bool)
  (let [ix (mac-idx)]
    (if (= (primitive/cast i64 macros) 0)
        false
        (do
          (when (or (= (load (field ix built)) 0)
                    (or (!= (primitive/cast i64 (load (field ix src)))
                            (primitive/cast i64 macros))
                        (!= (load (field ix len)) (len (load macros)))))
            (macros-index-build! ix macros))
          (match (get (.m ix) q)
            (Some [_] true)
            (None [] false))))))

; ── names resolved at expansion time ─────────────────────────────────────────
; A macro head, the trait a `register-derive` or a `derive` names, and the type a
; metaprogram reflects on are each a name written in some module, and each means
; what that module's scope makes it mean: the module's own declaration, then a
; `:use` import, then ambient core under the module's refer of it. The
; declaration table `resolve` reads does not exist while macros expand, so these
; are answered from the expansion's own records of what the program declares,
; one namespace each. No tier compares a last segment: a name that is not in
; scope in its module names nothing.

;;; The declarations a name is resolved among: the program's compile-time
;;; functions (MACROS), its traits, the structs and sums a metaprogram can
;;; reflect on, or their variants. CX is the reflecting metaprogram's context,
;;; whose traits count as declared too; null for a trait outside reflection.
;;; Each is a namespace of its own.
(defsum NameSpace
  (MacroNames [(macros (ptr (ArrayList (slice u8))))])
  (TraitNames [(cx (ptr CtCtx))])
  (TypeNames [(cx (ptr CtCtx))])
  (VariantNames [(cx (ptr CtCtx))])
  ;;; The constructors of coil.phase.Phase, which a registration's `:phase` names.
  (PhaseNames []))

;;; Does the qualified name Q denote a declaration in SPACE?
(defn space-has? [(space (ptr NameSpace)) (q (slice u8))] (-> bool)
  (match (load space)
    (MacroNames [macros] (macros-has? macros q))
    (TraitNames [cx]
      (or (trait-declared? q)
          (and (!= (primitive/cast i64 cx) 0)
               (!= (primitive/cast i64 (ct-trait-find cx q)) 0))))
    (TypeNames [cx] (ct-type-declared? cx q))
    (VariantNames [cx] (!= (primitive/cast i64 (ct-variant-sum cx q)) 0))
    (PhaseNames [] (match (phase-named q) (Some [_] true) (None [] false)))))

;;; The coil.phase.Phase whose constructor's qualified name is Q.
(defn phase-named [(q (slice u8))] (-> (Option phase/Phase))
  (cond (= q "coil.phase.BeforeExpand") (Some (phase/BeforeExpand))
        (= q "coil.phase.AfterExpand") (Some (phase/AfterExpand))
        (= q "coil.phase.Ownership") (Some (phase/Ownership))
        (= q "coil.phase.Read") (Some (phase/Read))
        :else (None [phase/Phase])))

(defn macro-space? [(space (ptr NameSpace))] (-> bool)
  (match (load space)
    (MacroNames [_] true)
    (_ false)))

(defn space-none [] (-> (Result (Option (slice u8)) Diag))
  (Ok [(Option (slice u8)) Diag] (None [(slice u8)])))

(defn space-some [(q (slice u8))] (-> (Result (Option (slice u8)) Diag))
  (Ok [(Option (slice u8)) Diag] (Some q)))

;;; What MODULE publishes as NAME in SPACE: its own declaration, or one a reexport
;;; edge passes on under that name.
(defn space-exported [(impb (ptr (ArrayList ImpEntry)))
                      (space (ptr NameSpace))
                      (expb (ptr (ArrayList ExpEntry)))
                      (module (slice u8))
                      (name (slice u8))
                      (a (dyn Allocator))
                      (depth i64)] (-> (Option (slice u8)))
  (if (or (>= depth 64)
          (not (exports-check expb module name)))
      (None [(slice u8)])
      (let [q (decl-alias-target (sconcat3 a module "." name))]
        (if (space-has? space q)
            (Some q)
            (let [ie (imports-find impb module)]
              (if (= (primitive/cast i64 ie) 0)
                  (None [(slice u8)])
                  ; The same edge rule as `resolve-exported`: an edge republishes
                  ; only what its import refers.
                  (let [rs (field (field ie imp) reexports)
                        n (len (load rs))
                        (mut i) 0
                        (mut out) (None [(slice u8)])]
                    (loop (if (>= (load i) n)
                              (break)
                              (let [edge (elem rs (load i))]
                                (match (match (use-refers edge name)
                                         (Some [exported]
                                               (space-exported impb
                                                               space
                                                               expb
                                                               (.target edge)
                                                               exported
                                                               a
                                                               (primitive/iadd depth 1)))
                                         (None [] (None [(slice u8)])))
                                  (Some [hit] (do (set! out (Some hit)) (break)))
                                  (None [] (set! i (primitive/iadd (load i) 1)))))))
                    (load out))))))))

; Ordered ambient core, the expansion's half of `resolve-core-ordered`: a
; provider replaces an ambient MACRO — `when`, `assert-eq`, `println` — and not
; merely an ambient function. Resolving only within the owner is what makes the
; override total: otherwise the macro tier would walk past a provider holding a
; plain function and expand the very macro that was overridden.
(defn space-core-ordered [(impb (ptr (ArrayList ImpEntry)))
                          (space (ptr NameSpace))
                          (expb (ptr (ArrayList ExpEntry)))
                          (prelude (slice u8))
                          (name (slice u8))
                          (asking (slice u8))
                          (a (dyn Allocator))] (-> (Option (slice u8)))
  (let [owner (core-contribution-owner name asking)]
    (if (> (len owner) 0)
        (space-exported impb space expb owner name a 1)
        (space-exported impb space expb prelude name a 0))))

;;; The `:use` tier: what HEAD names through one of the `:use` imports of IMPE's
;;; module. A macro takes the first import that supplies it. A trait or a type
;;; that two `:use`d modules supply as different declarations is ambiguous, as
;;; `resolve-use` reports it.
(defn space-use-match [(impb (ptr (ArrayList ImpEntry)))
                       (impe (ptr ImpEntry))
                       (space (ptr NameSpace))
                       (expb (ptr (ArrayList ExpEntry)))
                       (head (slice u8))
                       (a (dyn Allocator))] (-> (Result (Option (slice u8)) Diag))
  (let [uses (field (field impe imp) uses)
        macro? (macro-space? space)]
    (block :done
      (let [(mut r) (None [(slice u8)])
            (mut first-target) ""]
        (for [i 0 (len (load uses))]
          (let [up (elem uses i)
                target (.target up)]
            (match (use-refers up head)
              (None [] 0)
              (Some [exported]
                (match (space-exported impb space expb target exported a 0)
                  (None [] 0)
                  (Some [hit]
                    (match (load r)
                      (None []
                        (do
                          (when macro?
                            (source-route-record! (.name impe) head 6 target exported hit)
                            (break :done (space-some hit)))
                          (set! r (Some hit))
                          (set! first-target target)
                          0))
                      (Some [prior]
                        (do
                          (unless (or (= prior hit) (= (load first-target) target))
                            (break :done
                                   (Err [(Option (slice u8)) Diag]
                                        (derr (use-ambig-msg a (.name impe) head (load first-target) target)))))
                          0)))))))))
        (Ok [(Option (slice u8)) Diag] (load r))))))

;;; What HEAD, written in MODULE, names in SPACE: `(Some q)`, or None when nothing
;;; in scope there declares it. `alias/Name` goes through the import that alias
;;; names, a qualified name stands for itself (or its `defalias` target), and a
;;; bare name is the module's own declaration, then a `:use` import's, then
;;; ambient core's. A macro head yields to a function of the module's own of that
;;; name, which shadows it. The error is an ambiguity between `:use` imports.
(defn resolve-in-space [(head (slice u8))
                        (module (Option (slice u8)))
                        (space (ptr NameSpace))
                        (impb (ptr (ArrayList ImpEntry)))
                        (expb (ptr (ArrayList ExpEntry)))
                        (a (dyn Allocator))] (-> (Result (Option (slice u8)) Diag))
  (let [sl (find-slash head)
        macro? (macro-space? space)]
    (if (>= sl 0)
        ; alias/name
        (let [alias (subslice head 0 sl)
              rest (subslice head (primitive/iadd sl 1) (len head))]
          (match module
            (None [] (space-none))
            (Some [m]
                  (let [impe (imports-find impb m)]
                    (cond
                      ; A module may name its own declarations by its full name.
                      (and (not macro?) (= alias m))
                        (let [own (decl-alias-target (sconcat3 a m "." rest))]
                          (if (space-has? space own) (space-some own) (space-none)))
                      (= (primitive/cast i64 impe) 0) (space-none)
                      :else
                        (match (match (alias-target impe alias)
                                 (Some [t] (Some t))
                                 ; An imported module's full name qualifies it
                                 ; whatever alias the import gave it.
                                 (None [] (if macro? (None [(slice u8)]) (imported-module impe alias))))
                          (None [] (space-none))
                          (Some [target]
                                (match (space-exported impb space expb target rest a 0)
                                  (Some [q]
                                    (do (when macro? (source-route-record! m head 6 target rest q) 0)
                                        (space-some q)))
                                  (None [] (space-none))))))))))
        ; A leading dot is part of a bare syntax name (`..`, or a reserved
        ; `.field` accessor), not evidence that the head is module-qualified.
        (if (and (has-dot head)
                 (not (= (primitive/cast i64 (get head 0))
                         46)))
            (let [q (decl-alias-target head)]
              (if (space-has? space q) (space-some q) (space-none)))
            ; bare
            (let [own (decl-alias-target (qualify-name a head module))]
              (cond
                (space-has? space own) (space-some own)
                ; The module's own non-macro definition shadows every imported and
                ; ambient macro of that name, as it shadows imported names.
                (and macro? (declared-name? own)) (space-none)
                :else
                  (let [mname (match module (Some [m] m) (None [] ""))
                        impe (imports-find impb mname)
                        used
                          (if (= (primitive/cast i64 impe) 0)
                              (space-none)
                              (space-use-match impb impe space expb head a))]
                    (match used
                      (Err [d] (Err [(Option (slice u8)) Diag] d))
                      (Ok [r1]
                        (match r1
                          (Some [q] (space-some q))
                          (None []
                                (let [prelude (implicit-prelude-name a)]
                                  (if (= mname prelude)
                                      (space-none)
                                      ; core is the last tier here too, and under the same refer
                                      ; rules as any `:use` — so `(import "coil.core" :use [])`
                                      ; takes `when`/`for`/`cond` out of scope as macros, not just
                                      ; as names.
                                      (match (core-refers impe head)
                                        (None [] (space-none))
                                        (Some [exported]
                                              (if (= (primitive/cast i64 (imports-find impb prelude))
                                                     0)
                                                  (space-none)
                                                  ; Direct definitions in coil.core are ambient too,
                                                  ; not only names it reexports from imported modules.
                                                  ; This lets core own macros such as `cond` itself.
                                                  (match (space-core-ordered impb
                                                                             space
                                                                             expb
                                                                             prelude
                                                                             exported
                                                                             mname
                                                                             a)
                                                    (Some [q] (space-some q))
                                                    (None [] (space-none)))))))))))))))))))

;;; The trait SPELLED names where MODULE wrote it: its qualified name, or None
;;; when no trait of that name is in scope there. CX, when not null, is the
;;; reflecting metaprogram's context (see NameSpace).
(defn resolve-trait-ref [(spelled (slice u8))
                         (module (Option (slice u8)))
                         (cx (ptr CtCtx))
                         (impb (ptr (ArrayList ImpEntry)))
                         (expb (ptr (ArrayList ExpEntry)))
                         (a (dyn Allocator))] (-> (Result (Option (slice u8)) Diag))
  (let [space (primitive/alloc-stack NameSpace)]
    (store! space (TraitNames cx))
    (resolve-in-space spelled module space impb expb a)))

;;; The variant SPELLED names where MODULE wrote it, among the sums CX sees.
(defn resolve-variant-ref [(spelled (slice u8))
                           (module (Option (slice u8)))
                           (cx (ptr CtCtx))
                           (impb (ptr (ArrayList ImpEntry)))
                           (expb (ptr (ArrayList ExpEntry)))
                           (a (dyn Allocator))] (-> (Result (Option (slice u8)) Diag))
  (let [space (primitive/alloc-stack NameSpace)]
    (store! space (VariantNames cx))
    (resolve-in-space spelled module space impb expb a)))

;;; The struct or sum SPELLED names where MODULE wrote it, among those CX sees.
(defn resolve-type-ref [(spelled (slice u8))
                        (module (Option (slice u8)))
                        (cx (ptr CtCtx))
                        (impb (ptr (ArrayList ImpEntry)))
                        (expb (ptr (ArrayList ExpEntry)))
                        (a (dyn Allocator))] (-> (Result (Option (slice u8)) Diag))
  (let [space (primitive/alloc-stack NameSpace)]
    (store! space (TypeNames cx))
    (resolve-in-space spelled module space impb expb a)))


; ── the macro-resolution memo ────────────────────────────────────────────────
; `expand-calls-list` asks `resolve-macro` about EVERY list head in the program, and the
; answer costs an allocation before it can even be looked up: the bare-name path builds
; `module.head` with sconcat3, then hashes and compares it. Heads repeat constantly
; (`if`, `let`, `do`, `store!`…), and for one module the answer is a pure function of the
; head — the macro set, imports and exports are all fixed for the duration of a run.
;
; So it is memoised per module, keyed on the head alone, which removes the concatenation
; entirely and leaves one hash of a short string. "" encodes "not a macro", so negative
; answers — the overwhelming majority — are cached too. The memo is dropped when the
; module changes and, with the macro index, at the top of every `run-expand`.
;;; What `resolve-macro` answered, by module and spelling, for one macro list:
;;; the answer depends on that list and on the module's imports, not on which
;;; module asked last. MACROS and MACROS-LEN identify the list.
(defstruct MacMemo
  [(valid i64)
   (m (HashMap (slice u8) (slice u8)))
   (arena_ready i64)
   (arena scratch/ScratchArena)
   (macros (ptr (ArrayList (slice u8))))
   (macros_len i64)
   (key StrBuf)])

(defn mac-memo [] (-> (ptr MacMemo))
  (field (expander-unit-state) macro_memo))

(defn mac-memo-reset! [] (-> i64)
  (set! (.valid (mac-memo)) 0)
  0)

;;; Record the program's declared names for `declared-name?`.
(defn declared-names-set! [(names (ptr SBox)) (a (dyn Allocator))] (-> i64)
  (let [d (field (expander-unit-state) declared)
        (mut m) (HashMap::new [(slice u8) bool] a (keyops))]
    (for [i 0 (len (.items names))]
      (set! (mut m) (get (.items names) i) true))
    (set! (.names d) (load m))
    (set! (.ready d) true)
    0))

;;; Does the program declare `q` (a qualified name)?
(defn declared-name? [(q (slice u8))] (-> bool)
  (let [d (field (expander-unit-state) declared)]
    (and (.ready d) (match (get (.names d) q) (Some [_] true) (None [] false)))))

;;; The expansion's trait record. Its table is the unit's, emptied and refilled
;;; by every `declared-traits-collect!`.
(defn declared-traits [] (-> (ptr DeclaredTraits))
  (let [d (field (expander-unit-state) traits)]
    (unless (.init d)
      (set! (.names d) (HashMap::new [(slice u8) bool] (unit-allocator) (keyops)))
      (set! (.init d) true)
      0)
    d))

;;; Forget the last run's traits; the session table they read may be gone.
(defn declared-traits-forget! [] (-> i64)
  (let [d (field (expander-unit-state) traits)]
    (set! (.ready d) false)
    (set! (.parent d) (primitive/cast (ptr (ArrayList DefEntry)) 0))
    0))

(defn declared-trait-add! [(q (slice u8))] (-> i64)
  (set! (mut (.names (declared-traits))) q true)
  0)

;;; Add the trait a `(deftrait Name …)` form declares in MODULE, looking inside
;;; `do` bundles.
(defn trait-names-into! [(fp (ptr Sexp)) (module (Option (slice u8))) (a (dyn Allocator))] (-> i64)
  (when (= (sx-tag (load fp)) 6)
    (let [items (sx-items (load fp))
          head (sx-head-name items)]
      (cond (= head "do")
              (do (for [i 1 (sx-len items)]
                    (trait-names-into! (elem items i) module a))
                  0)
            (and (= head "deftrait")
                 (and (> (sx-len items) 1) (= (sx-tag (sx-at items 1)) 2)))
              (declared-trait-add! (qualify-name a (sx-sval (sx-at items 1)) module))
            :else 0)))
  0)

;;; Record the traits FORMS declare, replacing the last record, and the
;;; declaration table of S's session parent, which answers for the traits the
;;; session's earlier submissions declared.
(defn declared-traits-collect! [(s (mut LS)) (forms (ptr (ArrayList TaggedForm)))] (-> i64)
  (let [d (declared-traits)
        a (.a s)]
    (clear! (mut (.names d)))
    (for [i 0 (len (load forms))]
      (let [tf (elem forms i)]
        (trait-names-into! (field tf form) (.module tf) a)))
    (let [parent (.parent s)]
      (set! (.parent d)
            (if (= (primitive/cast i64 parent) 0)
                (primitive/cast (ptr (ArrayList DefEntry)) 0)
                (.declaration_table (semantic-workspace (mut parent))))))
    (set! (.ready d) true)
    0))

(defn table-declares-trait? [(table (ptr (ArrayList DefEntry))) (q (slice u8))] (-> bool)
  (if (= (primitive/cast i64 table) 0)
      false
      (let [entry (table-find table (module-prefix q))]
        (and (!= (primitive/cast i64 entry) 0)
             (defs-has? entry 2 (after-last-dot q))))))

;;; Does the program being expanded declare the trait Q (a qualified name)?
(defn trait-declared? [(q (slice u8))] (-> bool)
  (let [d (declared-traits)]
    (and (.ready d)
         (or (match (get (.names d) q) (Some [_] true) (None [] false))
             (table-declares-trait? (.parent d) q)))))

(defn resolve-macro [(head (slice u8))
                     (module (Option (slice u8)))
                     (macros (ptr (ArrayList (slice u8))))
                     (impb (ptr (ArrayList ImpEntry)))
                     (expb (ptr (ArrayList ExpEntry)))
                     (a (dyn Allocator))] (-> (Option (slice u8)))
  (let [mk (match module (Some [m] m) (None [] ""))
        mm (mac-memo)]
    (when (or (= (load (field mm valid)) 0)
              (or (!= (primitive/cast i64 (.macros mm)) (primitive/cast i64 macros))
                  (!= (.macros_len mm) (len (load macros)))))
      (if (= (.arena_ready mm) 0)
          (do
            (scratch/ScratchArena::init-with-capacity (field mm arena) (retained-heap/compiler-scratch-parent) 65536)
            (unit-resource! (primitive/cast (ptr i8) (field mm arena))
                            (primitive/fnptr-of macro-cache-arena-release))
            (set! (.arena_ready mm) 1))
          (reset! (field mm arena)))
      (store! (field mm m)
              (HashMap::new [(slice u8) (slice u8)]
                            (allocator (field mm arena))
                            (keyops)))
      (set! (.key mm) (StrBuf::new (allocator (field mm arena))))
      (set! (.macros mm) macros)
      (set! (.macros_len mm) (len (load macros)))
      (store! (field mm valid) 1))
    ; MODULE, a byte no module or spelling holds, then HEAD
    (set! (.len (field (field mm key) bytes)) 0)
    (push-str! (mut (.key mm)) mk)
    (push! (mut (.key mm)) (: 1 u8))
    (push-str! (mut (.key mm)) head)
    (match (get (.m mm) (str (.key mm)))
      (Some [hit]
            (if (= (len hit) 0)
                (None [(slice u8)])
                (Some hit)))
      (None []
            (let [r (resolve-macro-uncached head module macros impb expb a)]
              ; String-key maps copy their keys into the map allocator. Returned
              ; names can escape into derive registrations, so keep values unit-owned.
              (set! (mut (.m mm))
                    (str (.key mm))
                    (match r (Some [q] (ct-own-str q)) (None [] "")))
              r)))))

(defn resolve-macro-uncached [(head (slice u8))
                              (module (Option (slice u8)))
                              (macros (ptr (ArrayList (slice u8))))
                              (impb (ptr (ArrayList ImpEntry)))
                              (expb (ptr (ArrayList ExpEntry)))
                              (a (dyn Allocator))] (-> (Option (slice u8)))
  (let [space (primitive/alloc-stack NameSpace)]
    (store! space (MacroNames macros))
    ; A macro is the first `:use` import's that supplies it, so there is no
    ; ambiguity to report.
    (match (resolve-in-space head module space impb expb a)
      (Ok [r] r)
      (Err [_] (None [(slice u8)])))))

; Positive hygiene scopes carry their definition module independently of source
; spans. An empty module denotes a fresh lexical identifier, which cannot name a
; macro by spelling. Unscoped source/use-site syntax resolves in the current module.
(defn macro-module-of [(head Sexp) (fallback (Option (slice u8)))] (-> (Option (slice u8)))
  (if (> (sx-hyg head) 0)
      (let [m (sx-hmod head)]
        (if (= (len m) 0)
            (None [(slice u8)])
            (Some m)))
      fallback))

; Tag every macro-synthesized (dummy-span) node with the expansion `ctxt`, located
; at the call site. Non-dummy nodes (template literals, ~unquote-spliced caller
; code) keep their own span. Faithful.
(defn stamp-expansion [(s (ptr Sexp)) (source i64) (lo i64) (hi i64) (ctxt i64)] (-> i64)
  (when (< (sx-lo (load s)) 0)
    (store! (field s source) source)
    (store! (field s lo) lo)
    (store! (field s hi) hi)
    (store! (field s ctxt) ctxt)
    0)
  (let [tg (sx-tag (load s))]
    (when (or (= tg 6) (= tg 7))
      (let [items (sx-items (load s))
            n (sx-len items)
            (mut i) 0]
        (loop (if (>= (load i) n)
                  (break)
                  (do
                    (stamp-expansion (elem items (load i))
                                     source
                                     lo
                                     hi
                                     ctxt)
                    (store! i (primitive/iadd (load i) 1))))))))
  0)

; Find a function by name in `p` (for a macro's def-site span). Null if absent.
(defn find-func-ptr [(p (ptr Program)) (name (slice u8))] (-> (ptr Func))
  (let [fs (load (field p funcs))
        n (len (load fs))
        (mut i) 0
        (mut r) (primitive/cast (ptr Func) 0)]
    (loop (if (>= (load i) n)
              (break)
              (do
                (when (= (func-name (get (load fs) (load i))) name)
                  (store! r (elem fs (load i)))
                  (break))
                (set! i (primitive/iadd (load i) 1)))))
    (load r)))

(defn mk-expansion [(name (slice u8))
                    (cs i64)
                    (cl i64)
                    (ch i64)
                    (cc i64)
                    (ds i64)
                    (dl i64)
                    (dh i64)
                    (dc i64)
                    (parent i64)] (-> Expansion)
  (let [p (primitive/alloc-stack Expansion)]
    (set! (.macro_name p) name)
    (set! (.call_source p) cs)
    (set! (.call_lo p) cl)
    (set! (.call_hi p) ch)
    (set! (.call_ctxt p) cc)
    (set! (.def_source p) ds)
    (set! (.def_lo p) dl)
    (set! (.def_hi p) dh)
    (set! (.def_ctxt p) dc)
    (set! (.parent p) parent)
    (load p)))

(defn module-of [(name (slice u8))] (-> (Option (slice u8)))
  (let [n (len name)
        (mut i) (primitive/isub n 1)
        (mut at) -1]
    (loop (if (< (load i) 0)
              (break)
              (do
                (when (and (< (load at) 0)
                           (= (primitive/cast i64 (get name (load i)))
                              46))
                  (store! at (load i)))
                (set! i (primitive/isub (load i) 1)))))
    (if (< (load at) 0)
        (None [(slice u8)])
        (Some (subslice name 0 (load at))))))

; Anything escaping a macro invocation WITHOUT a span of its own gets the macro call
; site stamped on it. `error` — the diagnostic the whole stdlib uses (derive, match) —
; takes only a message and so can never carry a span; the same went for macro arity
; errors, while the byte-identical error for an ordinary function is perfectly located.
; `report` DOES take a node and produces a better span, so a located diag is left alone
; (derr builds lo = -1; that is the "unlocated" marker).
(defn stamp-call-site [(d Diag) (node Sexp)] (-> Diag)
  (if (>= (.lo d) 0)
      d
      (dwspan d (sx-source node) (sx-lo node) (sx-hi node) (sx-ctxt node))))

;;; ── the expansion arena (docs/design/META_MEMORY.md phase 3) ──────────────────
;;; COIL_META_ARENA=1: every metaprogram invocation runs against its own scratch
;;; arena — the engine context's allocator IS that arena, for the interpreter ops
;;; and the native mh-* callbacks alike — and exactly one value survives it: the
;;; returned Code, deep-copied out (structure AND string payloads) before the
;;; arena's segments are released. Peak memory becomes the expansion's working
;;; set, not its allocation history. =poison additionally fills the segments with
;;; 0xDD before release, so a missed alias fails loudly instead of heisenbug-ly.
;;;
;;; Staging is NOT inside the arena: stage-one-macro! allocates from the global
;;; stage-box, so engine entries and the quote registry keep their own lifetime.
;;; Warnings/reports/fixes recorded from inside an expansion are owned at their
;;; sinks (ct-own-str / ct-own-sexp in comptime.coil).
(defstruct EmArenaMode [(v i64) (init i64)])

(defstruct EmArenaPool
  [(arena scratch/ScratchArena)
   (initialized i64)
   (busy i64)])

(defn em-arena-pool [] (-> (ptr EmArenaPool))
  (field (expander-unit-state) expansion_arena))

(defn em-arena-mode-box [] (-> (ptr EmArenaMode))
  (field (expander-unit-state) arena_mode))

(defn em-arena-mode [] (-> i64)
  ; DEFAULT ON (docs/design/META_MEMORY.md phase 6): every expansion runs in
  ; its own arena and one value survives it. COIL_META_ARENA=0 opts out (the
  ; escape hatch while the default bakes); =poison fills segments with 0xDD on
  ; release so a missed alias fails loudly.
  (let [b (em-arena-mode-box)]
    (when (= (load (field b init)) 0)
      (store! (field b init) 1)
      (let [v (unit-getenv c"COIL_META_ARENA")]
        (store! (field b v)
                (if (= (primitive/cast i64 v) 0)
                    1
                    (let [s (mt--cstr v)]
                      (cond (= s "0") 0
                            (= s "off") 0
                            (= s "poison") 2
                            :else 1)))))
      0)
    (.v b)))

(defn em-poison-arena! [(ar (ptr scratch/ScratchArena))] (-> i64)
  (let [(mut seg) (load (field ar current))]
    (loop (if (= (primitive/cast i64 (load seg)) 0)
              (break)
              (do
                (let [d (load (field (load seg) data))
                      n (.off (load seg))
                      (mut i) 0]
                  (loop (if (>= (load i) n)
                            (break)
                            (do
                              (set! (primitive/index d (load i))
                                    (primitive/cast i8 221))
                              (set! i (primitive/iadd (load i) 1))))))
                (set! seg (load (field (load seg) previous))))))
    0))

; Promote only storage owned by one invocation arena. Unquoted macro arguments
; already belong to the surrounding expansion tree; deep-copying them on every
; nested invocation turns a linear syntax chain into quadratic retained data.
(defn promote-sexp-metadata [(a (dyn Allocator))
                             (ar (ptr scratch/ScratchArena))
                             (value Sexp)] (-> Sexp)
  (let [out (primitive/alloc-stack Sexp)]
    (set! out value)
    ; A borrowed node may have a retained kind payload but hygiene metadata
    ; assembled by this invocation. That metadata must cross the same boundary.
    (when (owns-address? ar
            (primitive/cast (ptr i8) (data (.hmod out))))
      (set! (.hmod out) (sexp-own-str-into a (.hmod out))) 0)
    (load out)))

(defn promote-sexp-from-arena [(a (dyn Allocator))
                               (ar (ptr scratch/ScratchArena))
                               (x (ptr Sexp))] (-> Sexp)
  (let [tg (sx-tag (load x))]
    (promote-sexp-metadata a ar
    (if (or (= tg 6) (= tg 7))
        (let [items (sx-items (load x))]
          (if (not (owns-address? ar
                                  (primitive/cast (ptr i8)
                                                  items)))
              (load x)
              (let [n (sx-len items)
                    (mut out) (ArrayList::new [Sexp] a)
                    (mut i) 0]
                (loop (if (>= (load i) n)
                          (break)
                          (do
                            (let [child (elem items (load i))]
                              (push! (mut out)
                                     (promote-sexp-from-arena a ar child)))
                            (store! i (primitive/iadd (load i) 1)))))
                (mk-sexp-src (if (= tg 7)
                                 (KVec (box-al [Sexp] a (load out)))
                                 (KList (box-al [Sexp] a (load out))))
                             x))))
        (if (= tg 8)
            (let [n (code-node-len (load x))
                  (mut out) (ArrayList::new [Sexp] a)
                  (mut i) 0]
              (loop (if (>= (load i) n)
                        (break)
                        (do
                          (let [child (primitive/alloc-stack Sexp)]
                            (store! child (code-node-at (load x) (load i)))
                            (push! (mut out)
                                   (promote-sexp-from-arena a ar child)))
                          (store! i (primitive/iadd (load i) 1)))))
              (mk-sexp-src (KList (box-al [Sexp] a (load out))) x))
            (if (or (= tg 2)
                    (or (= tg 3)
                        (or (= tg 4)
                            (= tg 5))))
                (let [value (sx-sval (load x))]
                  (if (owns-address? ar
                                     (primitive/cast (ptr i8)
                                                     (data value)))
                      (let [owned (sexp-own-str-into a value)]
                        (mk-sexp-src (cond (= tg 2)
                                             (KSym owned)
                                           (= tg 3)
                                             (KKw owned)
                                           (= tg 4)
                                             (KStr owned)
                                           :else (KCStr owned))
                                     x))
                      (load x)))
                (load x)))))))

;;; Per-metaprogram memory attribution (COIL_MTRACE=mem): without the arena,
;;; difference the root arena's monotonic byte counter across the invocation —
;;; the delta includes nested expansions, the cost this metaprogram CAUSES. With
;;; the arena, the arena's own total is exact per invocation.
;;; Besides the macro it expands, a call reads the name it spelled, qualified in
;;; the MODULE the head resolved in: an alias of that name is what led to the
;;; macro, and a definition of it in that module would capture the call.
(defn expand-macro-at [(node Sexp) (sub (ptr Program))
                    (fn-name (slice u8))
                    (module (Option (slice u8)))
                    (margs (ptr (ArrayList Sexp)))
                    (allfns (ptr (ArrayList (slice u8))))
                    (genstructs (ptr (ArrayList StructDef)))
                    (gensums (ptr (ArrayList SumDef)))
                    (impb (ptr (ArrayList ImpEntry)))
                    (expb (ptr (ArrayList ExpEntry)))
                    (a (dyn Allocator))
                    (code-session-state (ptr i8))
                        (expansions (ptr (ArrayList Expansion)))] (-> (Result Sexp Diag))
  (dependency-macro-record! node fn-name)
  (let [items (sx-items node)]
    (when (and (>= (sx-len items) 1) (= (sx-tag (sx-at items 0)) 2))
      (let [head (sx-sval (sx-at items 0))]
        (unless (or (has-dot head) (>= (find-slash head) 0))
          (match module
            (Some [_] (dependency-macro-record! node (qualify-name a head module)))
            (None [] 0))
          0))
      0))
  (let [site (macro-call-site-enter! node)
        result (expand-macro sub fn-name margs allfns genstructs gensums impb expb a code-session-state expansions)]
    (macro-call-site-restore! site)
    result))

(defn expand-macro [(sub (ptr Program))
                    (fn-name (slice u8))
                    (margs (ptr (ArrayList Sexp)))
                    (allfns (ptr (ArrayList (slice u8))))
                    (genstructs (ptr (ArrayList StructDef)))
                    (gensums (ptr (ArrayList SumDef)))
                    (impb (ptr (ArrayList ImpEntry)))
                    (expb (ptr (ArrayList ExpEntry)))
                    (a (dyn Allocator))
                    (code-session-state (ptr i8))
                        (expansions (ptr (ArrayList Expansion)))] (-> (Result Sexp Diag))
  (if (= (em-arena-mode) 0)
      (if (not (mtrace-mem?))
          (let [sug0 (sug-count)
                r
                  (expand-macro-run sub
                                    fn-name
                                    margs
                                    allfns
                                    genstructs
                                    gensums
                                    impb
                                    expb
                                    a
                                    code-session-state expansions)]
            (sug-freeze-from! a sug0)
            r)
          (let [before (mtrace-mem-now)
                sug0 (sug-count)
                r
                  (expand-macro-run sub
                                    fn-name
                                    margs
                                    allfns
                                    genstructs
                                    gensums
                                    impb
                                    expb
                                    a
                                    code-session-state expansions)]
            (sug-freeze-from! a sug0)
            (mtrace-mem-record! fn-name
                                (primitive/isub (mtrace-mem-now) before)
                                0
                                0
                                0)
            r))
      (let [fallback (primitive/alloc-stack scratch/ScratchArena)
            pool (em-arena-pool)
            pooled (= (load (field pool busy)) 0)
            ar (if pooled (field pool arena) fallback)
            _init
              (if pooled
                  (do
                    (when (= (load (field pool initialized)) 0)
                      (scratch/ScratchArena::init-with-capacity ar
                                                                (retained-heap/compiler-scratch-parent)
                                                                262144)
                      (store! (field pool initialized) 1)
                      0)
                    (store! (field pool busy) 1)
                    0)
                  (do (scratch/ScratchArena::init fallback (retained-heap/compiler-scratch-parent)) 0))
            aa (allocator ar)
            total-before (total ar)
            reserved-before (reserved-total ar)
            sug0 (sug-count)
            r
              (expand-macro-run sub
                                fn-name
                                margs
                                allfns
                                genstructs
                                gensums
                                impb
                                expb
                                aa
                                code-session-state expansions)
            _freeze (sug-freeze-from! aa sug0)
            out
              (match r
                (Ok [sx]
                    (let [sp (primitive/alloc-stack Sexp)]
                      (set! sp sx)
                      ; Own the result in the expansion walk's allocator. The walk
                      ; may itself be disposable; promoting every invocation
                      ; straight to malloc retains all intermediate syntax until
                      ; process exit.
                      (Ok [Sexp Diag] (promote-sexp-from-arena a ar sp))))
                (Err [d]
                     (let [dp (primitive/alloc-stack Diag)]
                       (set! dp d)
                       (set! (.msg dp) (sexp-own-str-into a (.msg dp)))
                       (Err [Sexp Diag] (load dp)))))]
        (when (mtrace-mem?)
          (mtrace-mem-record! fn-name
                              (primitive/isub (total ar)
                                              total-before)
                              (primitive/isub (reserved-total ar)
                                              reserved-before)
                              (live ar)
                              (peak ar))
          0)
        (when (= (em-arena-mode) 2)
          (em-poison-arena! ar)
          0)
        (if pooled
            (do
              (recycle! ar)
              (store! (field pool busy) 0)
              0)
            (close! ar))
        out)))

(defn expand-macro-run [(sub (ptr Program))
                        (fn-name (slice u8))
                        (margs (ptr (ArrayList Sexp)))
                        (allfns (ptr (ArrayList (slice u8))))
                        (genstructs (ptr (ArrayList StructDef)))
                        (gensums (ptr (ArrayList SumDef)))
                        (impb (ptr (ArrayList ImpEntry)))
                        (expb (ptr (ArrayList ExpEntry)))
                        (a (dyn Allocator))
                        (code-session-state (ptr i8))
                        (expansions (ptr (ArrayList Expansion)))] (-> (Result Sexp Diag))
  ;; Record which metaprogram is executing, so a comptime error raised deep in
  ;; the interpreter can name it. Without this the diagnostic points at the
  ;; module's import line and names nothing — see mtrace.coil.
  (mtrace-set-current! fn-name)
  (let [cx (primitive/alloc-stack CtCtx)
        callee (prog-fn-find sub fn-name)]
    (set! (.a cx) a)
    (set! (.fns cx) (load (field sub funcs)))
    (set! (.structs cx) (load (field sub structs)))
    (set! (.sums cx) (load (field sub sums)))
    (set! (.gen_structs cx) genstructs)
    (set! (.gen_sums cx) gensums)
    (set! (.traits cx) (load (field sub traits)))
    (set! (.fuel cx) 50000000)
    (set! (.depth cx) 0)
    (set! (.gensym cx) 0)
    (set! (.qmodule cx) (module-of fn-name))
    (set! (.module_fns cx) allfns)
    (set! (.qimports cx)
          (match (module-of fn-name)
            (Some [m]
                  (let [ie (imports-find impb m)]
                    (if (= (primitive/cast i64 ie) 0)
                        (primitive/cast (ptr ModImports) 0)
                        (field ie imp))))
            (None [] (primitive/cast (ptr ModImports) 0))))
    (set! (.qexports cx) expb)
    (set! (.all_imports cx) impb)
    (set! (.all_exports cx) expb)
    (set! (.prog cx) (primitive/cast (ptr Program) 0))  ; macro context: no comptime fold here
    (set! (.code_session_state cx) code-session-state)
    (set! (.expansions cx) expansions)
    (if (= (primitive/cast i64 callee) 0)
        (Err [Sexp Diag] (derr (sconcat3 a "macro '" fn-name "' not found")))
        (let [pparams (load (field callee params))
              np (len (load pparams))
              na (len (load margs))
              (mut env) (ArrayList::new [EnvBind] a)]
          (if (.macro_variadic callee)
              (if (< na (primitive/isub np 1))
                  (Err [Sexp Diag]
                       (derr (sconcat a
                                      (sconcat a
                                               (sconcat a
                                                        (sconcat3 a
                                                                  "macro '"
                                                                  fn-name
                                                                  "' expects at least ")
                                                        (i64->str a
                                                                  (primitive/isub np
                                                                                  1)))
                                               " args, got ")
                                      (i64->str a na))))
                  (do
                    (let [(mut k) 0]
                      (loop (if (>= (load k) (primitive/isub np 1))
                                (break)
                                (do
                                  (let [eb (primitive/alloc-stack EnvBind)]
                                    (set! (.name eb)
                                          (.name (elem pparams
                                                       (load k))))
                                    (set! (.val eb)
                                          (CCode (get (load margs) (load k))))
                                    (push! (mut env) (load eb)))
                                  (set! k (primitive/iadd (load k) 1)))))
                      (let [(mut rest) (ArrayList::new [Sexp] a)
                            (mut r) (primitive/isub np 1)]
                        (loop (if (>= (load r) na)
                                  (break)
                                  (do
                                    (push! (mut rest)
                                           (get (load margs) (load r)))
                                    (set! r (primitive/iadd (load r) 1)))))
                        (let [eb (primitive/alloc-stack EnvBind)]
                          (set! (.name eb)
                                (.name (elem pparams
                                             (primitive/isub np 1))))
                          (set! (.val eb)
                                (CCode (mk-sexp (KList (box-al [Sexp]
                                                               a
                                                               (load rest)))
                                                -1
                                                -1)))
                          (push! (mut env) (load eb))))
                      (finish-macro callee
                                    (box-al [EnvBind] a (load env))
                                    cx
                                    a
                                    fn-name))))
              (if (!= np na)
                  (Err [Sexp Diag]
                       (derr (sconcat a
                                      (sconcat a
                                               (sconcat a
                                                        (sconcat3 a
                                                                  "macro '"
                                                                  fn-name
                                                                  "' expects ")
                                                        (i64->str a np))
                                               " args, got ")
                                      (i64->str a na))))
                  (do
                    (let [(mut k) 0]
                      (loop (if (>= (load k) np)
                                (break)
                                (do
                                  (let [eb (primitive/alloc-stack EnvBind)]
                                    (set! (.name eb)
                                          (.name (elem pparams
                                                       (load k))))
                                    (set! (.val eb)
                                          (CCode (get (load margs) (load k))))
                                    (push! (mut env) (load eb)))
                                  (set! k (primitive/iadd (load k) 1)))))
                      (finish-macro callee
                                    (box-al [EnvBind] a (load env))
                                    cx
                                    a
                                    fn-name)))))))))

(defn finish-macro [(callee (ptr Func))
                    (env (ptr (ArrayList EnvBind)))
                    (cx (ptr CtCtx))
                    (a (dyn Allocator))
                    (fn-name (slice u8))] (-> (Result Sexp Diag))
  ; The compiled engine is THE macro engine (the tree-walking interpreter is gone —
  ; decision 7). The env (param -> CCode arg, variadic already packed) IS the
  ; argument list. A miss stages this qual on demand (pruned closure -> standalone
  ; check -> additive engine build); a macro that cannot be staged is a hard error.
  ; `callee` stays in the signature for the call sites' sake — the body itself now
  ; lives only in the engine's compiled form.
  (let [e (meta-engine-entry fn-name)]
    (if (!= (primitive/cast i64 e) 0)
        (meta-engine-run-env a e cx env)
        (match (stage-one-macro! fn-name)
          (None []
                (let [e2 (meta-engine-entry fn-name)]
                  (if (!= (primitive/cast i64 e2) 0)
                      (meta-engine-run-env a e2 cx env)
                      (Err [Sexp Diag]
                           (derr (sconcat3 a
                                           "macro '"
                                           fn-name
                                           "' staged but is missing from the engine (compiler bug)"))))))
          ; Report the REASON staging failed, not merely that it did. The inner diagnostic
          ; is about the macro's own pruned closure, so it names the real problem; without
          ; it the user gets an opaque line pointing at an innocent call site in a module
          ; that has nothing to do with the cause.
          (Some [d] (Err [Sexp Diag] (stage-fail-diag a d fn-name)))))))

; The staging failure with its inner reason attached, keeping the inner diagnostic's own
; span when it has one — that span points into the macro's closure, which is where the fix
; is.
(defn stage-fail-diag [(a (dyn Allocator)) (d Diag) (fn-name (slice u8))] (-> Diag)
  (let [dp (primitive/alloc-stack Diag)]
    (set! dp d)
    (set! (.msg dp)
          (sconcat a
                   (sconcat3 a
                             "macro '"
                             fn-name
                             "' could not be compiled into the metaprogram engine: ")
                   (.msg dp)))
    (load dp)))

; A macro-BODY error comes back with a dummy span — the code-op derrs (`str-bytes
; expects a string`, `error …`, arity mismatches) carry none, so it renders as a bare
; internal message that names, e.g., `str-bytes`, with no source. Point it at the macro
; CALL SITE `node` and name the calling macro, so it reads as a located `in expansion of
; macro 'X': …` underlined at the call. A diag that ALREADY has a real span (e.g. a
; located `(primitive/report …)`, or a typecheck error on the expanded output) is left untouched.
(defn locate-macro-err [(a (dyn Allocator))
                        (d Diag)
                        (node (ptr Sexp))
                        (fn-name (slice u8))] (-> Diag)
  (let [dp (primitive/alloc-stack Diag)]
    (set! dp d)
    (if (>= (.lo dp) 0)
        (load dp)
        (do
          (set! (.source dp) (sx-source (load node)))
          (set! (.lo dp) (sx-lo (load node)))
          (set! (.hi dp) (sx-hi (load node)))
          (set! (.ctxt dp) (sx-ctxt (load node)))
          (set! (.msg dp)
                (sconcat a
                         (sconcat3 a "in expansion of macro '" fn-name "': ")
                         (.msg dp)))
          (load dp)))))

(defstruct ExpEnv
  [(macros (ptr (ArrayList (slice u8))))
   (comptime (ptr (ArrayList (slice u8))))
   (sub (ptr Program))
   (impb (ptr (ArrayList ImpEntry)))
   (expb (ptr (ArrayList ExpEntry)))
   ; THE SYNTACTIC ENVIRONMENT: names bound at this point in the walk, innermost
   ; last. Used as a stack — a scope records the length on entry and truncates back
   ; to it on exit, so no allocation per scope and no scope-tree to maintain.
   (bound (ptr (ArrayList (slice u8))))
   (a (dyn Allocator))])

; Is `nm` bound by an enclosing binding form? Scanned from the END so an inner
; binding wins, though for a membership test the direction only affects speed.
(defn benv-bound? [(env (ptr ExpEnv)) (nm (slice u8))] (-> bool)
  (let [xs (load (field env bound))
        (mut i) (len (load xs))
        (mut found) false]
    (loop (if (or (load found) (<= (load i) 0))
              (break)
              (do
                (set! i (primitive/isub (load i) 1))
                (when (= (get (load xs) (load i)) nm) (store! found true) 0))))
    (load found)))

(defn benv-mark [(env (ptr ExpEnv))] (-> i64)
  (len (load (field env bound))))

(defn benv-push! [(env (ptr ExpEnv)) (nm (slice u8))] (-> i64)
  (push! (load (field env bound)) nm)
  0)

(defn benv-reset! [(env (ptr ExpEnv)) (mark i64)] (-> i64)
  (set! (.len (load (field env bound))) mark)
  0)

; The lexical identity a binder establishes, including its hygiene scope.
; `(mut x)` and `(x Type)` name x; non-binder syntax returns an empty key.
(defn binder-name [(a (dyn Allocator)) (bp Sexp)] (-> (slice u8))
  (let [tg (sx-tag bp)]
    (if (= tg 2)
        (lexical-name a bp)
        (if (= tg 6)
            (let [it (sx-items bp)]
              (if (and (>= (sx-len it) 1)
                       (= (sx-tag (sx-at it 0)) 2))
                  (let [h (sx-sval (sx-at it 0))]
                    (if (and (= h "mut")
                             (>= (sx-len it) 2))
                        (binder-name a (sx-at it 1))
                        (lexical-name a (sx-at it 0))))
                  ""))
            ""))))

; Bind every name a `[…]` binder vector introduces. `kind` 0 = a `let`-shaped vector
; (NAME INIT NAME INIT …), so only even positions bind; 1 = a parameter/field vector,
; where every element binds.
(defn benv-bind-vec! [(env (ptr ExpEnv))
                      (items (ptr (ArrayList Sexp)))
                      (kind i64)] (-> i64)
  (let [n (sx-len items)
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (when (or (= kind 1)
                          (= (primitive/irem (load i) 2) 0))
                  (let [nm (binder-name (.a env) (sx-at items (load i)))]
                    (when (> (len nm) 0)
                      (benv-push! env nm)
                      0))
                  0)
                (set! i (primitive/iadd (load i) 1)))))
    0))

; (include-str is resolved at LOAD time now — see loader.coil expand-includes-in-form.)
; ---- binder positions -------------------------------------------------------
; A parameter, field or payload vector ESTABLISHES names; it is not a call, and
; nothing inside it is. `expand-calls` is a flat walk with no grammar knowledge, so it
; happily looked up element 0 of `(scope (ArrayList i64))` — a FIELD declaration — in
; the global macro table, found coil.control's `scope`, and expanded it. The author
; then got a diagnostic about a form they never wrote:
;
;   (defstruct S [(scope (ArrayList i64))])   ; error: scope: first argument must be a :label
;   (defn f [(scope i64)] (-> i64) scope)     ; same
;   (defsum V (Case [(scope i64)]))           ; same
;
; Real special forms were always fine as binder names, because the PARSER is
; syntax-directed and only treats them specially while parsing an expression. Macros
; had no such protection: every one of the 21 names coil.control re-exports into the
; prelude (`when` `unless` `case` `while` `for` `block` `scope` `defer` `all` `any` …)
; was unusable as a field or parameter name anywhere in the language.
;
; This is the binder half of docs/design/BINDING_AND_SHADOWING.md. The other half —
; a local binding shadowing a macro in HEAD position, `(let [when 5] (when 1 2))` —
; needs a syntactic environment threaded through the walk and is still open.
(defn is-arrow-form [(f (ptr Sexp))] (-> bool)
  (and (= (sx-tag (load f)) 6)
       (let [it (sx-items (load f))]
         (and (>= (sx-len it) 1)
              (and (= (sx-tag (sx-at it 0)) 2)
                   (= (sx-sval (sx-at it 0)) "->"))))))

; Heads whose own children include binder vectors.
(defn def-form-head? [(h (slice u8))] (-> bool)
  (or (or (= h "defn*") (or (= h "fn*") (= h "declare")))
      (or (= h "defstruct")
          (or (= h "defsum") (or (= h "deftrait") (= h "impl"))))))

; Heads whose children are MEMBER forms — `(Variant [payload…])`,
; `(method [params…] (-> R) body…)` — carrying binder vectors one level deeper.
(defn def-member-head? [(h (slice u8))] (-> bool)
  (or (= h "defsum") (or (= h "deftrait") (= h "impl"))))

(defn sx-head-name [(items (ptr (ArrayList Sexp)))] (-> (slice u8))
  (if (and (>= (sx-len items) 1)
           (= (sx-tag (sx-at items 0)) 2))
      (sx-sval (sx-at items 0))
      ""))

; Copy a definition form's children, leaving every binder vector byte-identical and
; expanding everything else. `member` walks one extra level for defsum variants and
; trait/impl methods.
(defn expand-def-list [(items (ptr (ArrayList Sexp)))
                       (member bool)
                       (module (Option (slice u8)))
                       (env (ptr ExpEnv))
                       (allfns (ptr (ArrayList (slice u8))))
                       (gs (ptr (ArrayList StructDef)))
                       (gu (ptr (ArrayList SumDef)))
                       (depth (ptr i64))
                       (ls (mut LS))] (-> (Result (ptr (ArrayList Sexp)) Diag))
  (let [a (.a env)
        n (sx-len items)
        ; the parameter scope ENDS with the definition; without this the params of one
        ; defn would still be bound while walking the next one
        mark (benv-mark env)
        (mut out) (ArrayList::new [Sexp] a)
        (mut i) 0
        (mut errf) (None [Diag])]
    (loop (if (or (diag-some? (load errf)) (>= (load i) n))
              (break)
              (do
                (let [child (elem items (load i))
                      tg (sx-tag (load child))]
                  (cond ; a binder vector: verbatim, never expanded — and its names bind
                        ; for everything after it, so a parameter named after a macro wins
                        ; in the body too, not just inside the vector.
                        (and (> (load i) 0)
                             (= tg 7))
                          (do
                            (push! (mut out) (load child))
                            (benv-bind-vec! env (sx-items (load child)) 1)
                            0)
                        ; Methods use the same library parameter normalizer as defn.
                        ; A temporary primitive declaration supplies binder traversal;
                        ; remove only its head before returning to the impl parser.
                        (and (= (sx-head-name items) "impl")
                             (impl-method-form? (Some (load child))))
                          (let [(mut call-items) (ArrayList::new [Sexp] a)]
                            (push! (mut call-items)
                                   (sx-sym "coil.binding.normalize-method"))
                            (push! (mut call-items) (load child))
                            (match (expand-calls (box-sexp a
                                                           (mk-sexp-src (KList (box-al [Sexp]
                                                                                       a
                                                                                       (load call-items)))
                                                                        child))
                                                 module
                                                 env
                                                 allfns
                                                 gs
                                                 gu
                                                 depth
                                                 (mut ls))
                              (Err [d] (do (set! errf (Some d)) 0))
                              (Ok [declaration]
                                  (do
                                    (push! (mut out)
                                           (mk-sexp-src (KList (rest-from a
                                                                          (sx-items declaration)
                                                                          1))
                                                        child))
                                    0))))
                        ; a member form (variant / method): recurse one level with the
                        ; same rule, so its own params or payload vector is protected too
                        (and (and member (> (load i) 0))
                             (= tg 6))
                          (match (expand-def-list (sx-items (load child))
                                                  false
                                                  module
                                                  env
                                                  allfns
                                                  gs
                                                  gu
                                                  depth
                                                  (mut ls))
                            (Err [d] (do (store! errf (Some d)) 0))
                            (Ok [inner]
                                (do
                                  (push! (mut out)
                                         (mk-sexp-src (KList inner) child))
                                  0)))
                        :else
                          (match (expand-calls child
                                               module
                                               env
                                               allfns
                                               gs
                                               gu
                                               depth
                                               (mut ls))
                            (Err [d] (do (store! errf (Some d)) 0))
                            (Ok [r] (do (push! (mut out) r) 0)))))
                (set! i (primitive/iadd (load i) 1)))))
    (benv-reset! env mark)
    (match (load errf)
      (Some [d] (Err [(ptr (ArrayList Sexp)) Diag] d))
      (None [] (Ok [(ptr (ArrayList Sexp)) Diag] (box-al [Sexp] a (load out)))))))

; A runtime `def` has no binder vector. Its optional type is syntax and must be
; copied verbatim; only the initializer is an expression subject to expansion.
(defn expand-runtime-def-list [(items (ptr (ArrayList Sexp)))
                               (module (Option (slice u8)))
                               (env (ptr ExpEnv))
                               (allfns (ptr (ArrayList (slice u8))))
                               (gs (ptr (ArrayList StructDef)))
                               (gu (ptr (ArrayList SumDef)))
                               (depth (ptr i64))
                               (ls (mut LS))] (-> (Result (ptr (ArrayList Sexp))
                                                          Diag))
  ; (def NAME [:key value …] [TYPE] VALUE). Annotation values and the
  ; initializer are expressions; the name, the keys and the type are syntax.
  ; Pairs are recognized exactly as `parse-runtime-def` does: a keyword with
  ; its value, while an item remains after the pair.
  (try (let [a (.a env)
             n (sx-len items)
             (mut out) (ArrayList::new [Sexp] a)
             (mut i) 2]
         (when (< n 3)
           ; Let the parser issue the canonical arity diagnostic.
           (return-from :try (Ok [(ptr (ArrayList Sexp)) Diag] items)))
         (push! (mut out) (sx-at items 0))
         (push! (mut out) (sx-at items 1))
         (loop (if (and (< (+ (load i) 2) n)
                        (= (sx-tag (sx-at items (load i))) 3))
                   (do
                     (push! (mut out) (sx-at items (load i)))
                     (push! (mut out)
                            (try! (expand-calls (elem items (+ (load i) 1))
                                                module
                                                env
                                                allfns
                                                gs
                                                gu
                                                depth
                                                (mut ls))))
                     (set! i (+ (load i) 2)))
                   (break)))
         (let [init-index (primitive/isub n 1)]
           (for [k (load i) init-index]
             (push! (mut out) (sx-at items k)))
           (push! (mut out)
                  (try! (expand-calls (elem items init-index)
                                      module
                                      env
                                      allfns
                                      gs
                                      gu
                                      depth
                                      (mut ls))))
           (Ok [(ptr (ArrayList Sexp)) Diag] (box-al [Sexp] a (load out)))))))

; `(match SCRUT (Variant [b…] body…) …)`: each arm's bind vector scopes over THAT
; arm's body and nothing else. `match` is a special form, so unlike `for` — which is a
; macro and gets this for free once its expansion's `let` is walked — the arms are
; never seen by any binding form and their names never entered the environment.
;
; The arm HEAD is a pattern, not a call: `(Wrap [v] …)` names a variant. It is left
; unexpanded for the same reason a parameter list is, so a variant sharing a macro's
; name cannot be rewritten out from under the author.
(defn expand-match-form [(items (ptr (ArrayList Sexp)))
                         (module (Option (slice u8)))
                         (env (ptr ExpEnv))
                         (allfns (ptr (ArrayList (slice u8))))
                         (gs (ptr (ArrayList StructDef)))
                         (gu (ptr (ArrayList SumDef)))
                         (depth (ptr i64))
                         (ls (mut LS))] (-> (Result (ptr (ArrayList Sexp)) Diag))
  (let [a (.a env)
        n (sx-len items)
        (mut out) (ArrayList::new [Sexp] a)
        (mut i) 0
        (mut errf) (None [Diag])]
    (loop (if (or (diag-some? (load errf)) (>= (load i) n))
              (break)
              (do
                (let [child (elem items (load i))]
                  (if (< (load i) 2)
                      ; element 0 is `match`, element 1 the scrutinee — outer scope
                      (if (= (load i) 0)
                          (do (push! (mut out) (load child)) 0)
                          (match (expand-calls child
                                               module
                                               env
                                               allfns
                                               gs
                                               gu
                                               depth
                                               (mut ls))
                            (Err [d] (do (set! errf (Some d)) 0))
                            (Ok [r] (do (push! (mut out) r) 0))))
                      ; an arm: (Variant [patterns…] body…), or the catch-all (_ body…),
                      ; which binds nothing and so has no bind vector to skip over —
                      ; without that exception a body that happens to BE a vector
                      ; literal would be mistaken for one.
                      (let [it (sx-items (load child))
                            arm?
                              (and (= (sx-tag (load child))
                                      6)
                                   (and (not (= (sx-head-name it) "_"))
                                        (and (>= (sx-len it)
                                                 2)
                                             (= (sx-tag (sx-at it 1))
                                                7))))]
                        (if (not arm?)
                            (match (expand-calls child
                                                 module
                                                 env
                                                 allfns
                                                 gs
                                                 gu
                                                 depth
                                                 (mut ls))
                              (Err [d] (do (set! errf (Some d)) 0))
                              (Ok [r] (do (push! (mut out) r) 0)))
                            (let [normalized-result
                                    (normalize-match-arm-once child
                                                              env
                                                              allfns
                                                              gs
                                                              gu
                                                              depth
                                                              (mut ls))]
                              (match normalized-result
                                (Err [d] (do (set! errf (Some d)) 0))
                                (Ok [normalized]
                                    (let [nit (sx-items normalized)
                                          mark (benv-mark env)
                                          an (sx-len nit)
                                          (mut aout) (ArrayList::new [Sexp] a)
                                          (mut j) 0]
                                      (push! (mut aout) (sx-at nit 0))
                                      (push! (mut aout) (sx-at nit 1))
                                      (benv-bind-vec! env
                                                      (sx-items (sx-at nit 1))
                                                      1)
                                      (set! j 2)
                                      (loop (if (or (diag-some? (load errf))
                                                    (>= (load j) an))
                                                (break)
                                                (do
                                                  (match (expand-calls (elem nit
                                                                             (load j))
                                                                       module
                                                                       env
                                                                       allfns
                                                                       gs
                                                                       gu
                                                                       depth
                                                                       (mut ls))
                                                    (Err [d]
                                                         (do
                                                           (set! errf (Some d))
                                                           0))
                                                    (Ok [r]
                                                        (do
                                                          (push! (mut aout) r)
                                                          0)))
                                                  (set! j
                                                        (primitive/iadd (load j)
                                                                        1)))))
                                      (benv-reset! env mark)
                                      (push! (mut out)
                                             (mk-sexp-src (KList (box-al [Sexp]
                                                                         a
                                                                         (load aout)))
                                                          child))
                                      0))))))))
                (set! i (primitive/iadd (load i) 1)))))
    (match (load errf)
      (Some [d] (Err [(ptr (ArrayList Sexp)) Diag] d))
      (None [] (Ok [(ptr (ArrayList Sexp)) Diag] (box-al [Sexp] a (load out)))))))

; Traversal preserves the authored expression's identity. Macro replacement
; itself still creates fresh nodes; walking its children is not a new expression.
(defn traversed-sexp [(kind SexpKind) (source (ptr Sexp))] (-> Sexp)
  (let [out (primitive/alloc-stack Sexp)]
    (set! out (load source))
    (set! (.kind out) kind)
    (load out)))

; Primitive bindings are sequential. Binder syntax is never a call.
(defn expand-let-bindings [(node (ptr Sexp))
                           (module (Option (slice u8)))
                           (env (ptr ExpEnv))
                           (allfns (ptr (ArrayList (slice u8))))
                           (gs (ptr (ArrayList StructDef)))
                           (gu (ptr (ArrayList SumDef)))
                           (depth (ptr i64))
                           (ls (mut LS))] (-> (Result Sexp Diag))
  (try (let [a (.a env)
             pairs (sx-items (load node))
             n (sx-len pairs)
             (mut out) (ArrayList::new [Sexp] a)
             (mut i) 0]
         (loop (if (>= (load i) n)
                   (break)
                   (do
                     (push! (mut out) (sx-at pairs (load i)))
                     (when (< (+ (load i) 1) n)
                       (push! (mut out)
                              (try! (expand-calls (elem pairs
                                                        (+ (load i) 1))
                                                  module
                                                  env
                                                  allfns
                                                  gs
                                                  gu
                                                  depth
                                                  (mut ls)))))
                     (let [name (binder-name a (sx-at pairs (load i)))]
                       (when (> (len name) 0) (benv-push! env name)))
                     (set! i (+ (load i) 2)))))
         (Ok (traversed-sexp (KVec (box-al [Sexp] a (load out))) node)))))

(defn expand-let-form [(items (ptr (ArrayList Sexp)))
                       (module (Option (slice u8)))
                       (env (ptr ExpEnv))
                       (allfns (ptr (ArrayList (slice u8))))
                       (gs (ptr (ArrayList StructDef)))
                       (gu (ptr (ArrayList SumDef)))
                       (depth (ptr i64))
                       (ls (mut LS))] (-> (Result (ptr (ArrayList Sexp)) Diag))
  (try (let [a (.a env)
             n (sx-len items)
             (mut out) (ArrayList::new [Sexp] a)
             (mut i) 0]
         (loop (if (>= (load i) n)
                   (break)
                   (do
                     (let [child (elem items (load i))]
                       (push! (mut out)
                              (try! (if (and (= (load i) 1)
                                             (= (sx-tag (load child)) 7))
                                        (expand-let-bindings child
                                                             module
                                                             env
                                                             allfns
                                                             gs
                                                             gu
                                                             depth
                                                             (mut ls))
                                        (expand-calls child
                                                      module
                                                      env
                                                      allfns
                                                      gs
                                                      gu
                                                      depth
                                                      (mut ls))))))
                     (set! i (+ (load i) 1)))))
         (Ok (box-al [Sexp] a (load out))))))

(defn expand-calls-list [(items (ptr (ArrayList Sexp)))
                         (module (Option (slice u8)))
                         (env (ptr ExpEnv))
                         (allfns (ptr (ArrayList (slice u8))))
                         (gs (ptr (ArrayList StructDef)))
                         (gu (ptr (ArrayList SumDef)))
                         (depth (ptr i64))
                         (ls (mut LS))] (-> (Result (ptr (ArrayList Sexp)) Diag))
  (let [a (.a env)
        n (sx-len items)
        (mut out) (ArrayList::new [Sexp] a)
        (mut i) 0
        (mut errf) (None [Diag])]
    (loop (if (or (diag-some? (load errf)) (>= (load i) n))
              (break)
              (do
                (match (expand-calls (elem items (load i))
                                     module
                                     env
                                     allfns
                                     gs
                                     gu
                                     depth
                                     (mut ls))
                  (Err [d] (do (set! errf (Some d)) 0))
                  (Ok [r]
                      (do
                        (push! (mut out) r)
                        ; A type one form of a `(do …)` declares is visible to the
                        ; forms after it.
                        (register-sibling-declaration! r module gs gu a))))
                (set! i (primitive/iadd (load i) 1)))))
    (match (load errf)
      (Some [d] (Err [(ptr (ArrayList Sexp)) Diag] d))
      (None [] (Ok [(ptr (ArrayList Sexp)) Diag] (box-al [Sexp] a (load out)))))))

; The "re-expand the expansion result" step is an explicit LOOP (primitive/store! cur +
; repeat), not self-recursion: it guarantees constant stack for expansion chains
; without leaning on musttail, whose AArch64 lowering is at the mercy of the
; inliner (a second caller of expand-macro made LLVM refuse the marked call).
;;; COIL_MACRO_EXPANSION_LIMIT and COIL_TRACE_MACROS, read when the first macro
;;; call of an expansion asks: each call read them with getenv, a scan of the
;;; whole environment, twice per macro call.
(defn macro-config [] (-> (ptr MacroConfig))
  (let [c (field (expander-unit-state) macro_config)]
    (unless (.ready c)
      (set! c (MacroConfig :ready true
                           :limit (macro-expansion-limit-read)
                           :trace (unit-getenv c"COIL_TRACE_MACROS")))
      0)
    c))

(defn macro-config-reset! [] (-> i64)
  (set! (.ready (field (expander-unit-state) macro_config)) false)
  (meta-main-reset!)
  0)

(defn macro-expansion-limit [] (-> i64)
  (.limit (macro-config)))

(defn macro-expansion-limit-read [] (-> i64)
  (let [p (unit-getenv c"COIL_MACRO_EXPANSION_LIMIT")]
    (if (= (primitive/cast i64 p) 0)
        0
        (let [s (from-cstr p)
              n (len s)
              (mut i) 0
              (mut v) 0
              (mut ok) (> n 0)]
          (loop (if (or (not (load ok)) (>= (load i) n))
                    (break)
                    (let [c (primitive/cast i64 (get s (load i)))]
                      (if (or (< c 48) (> c 57))
                          (store! ok false)
                          (do
                            (store! v
                                    (primitive/iadd (primitive/imul (load v) 10)
                                                    (primitive/isub c 48)))
                            (store! i (primitive/iadd (load i) 1))
                            0)))))
          (if (and (load ok) (> (load v) 0)) (load v) 0)))))

(defn trace-macro-call [(q (slice u8)) (total i64) (chain i64)] (-> i64)
  (let [p (.trace (macro-config))]
    (when (!= (primitive/cast i64 p) 0)
      (let [wanted (from-cstr p)]
        (when (or (= wanted "*") (= wanted q))
          (let [w (stderr)]
            (ps w "macro-expand  total=")
            (dump-dec w total)
            (ps w "  chain=")
            (dump-dec w chain)
            (ps w "  macro=")
            (ps w q)
            (wb w 10)
            0))
        0))
    0))

(defn expand-template [(node (ptr Sexp))
                       (quote-depth i64)
                       (module (Option (slice u8)))
                       (env (ptr ExpEnv))
                       (allfns (ptr (ArrayList (slice u8))))
                       (gs (ptr (ArrayList StructDef)))
                       (gu (ptr (ArrayList SumDef)))
                       (depth (ptr i64))
                       (ls (mut LS))] (-> (Result Sexp Diag))
  (try (let [tag (sx-tag (load node))]
         (if (not (or (= tag 6) (= tag 7)))
             (Ok [Sexp Diag] (load node))
             (let [items (sx-items (load node))
                   head (if (= tag 6) (sx-head-name items) "")
                   escape (or (= head "unquote") (= head "unquote-splicing"))
                   next-depth
                     (if (= head "quasiquote")
                         (+ quote-depth 1)
                         (if escape (- quote-depth 1) quote-depth))
                   (mut output) (ArrayList::new [Sexp] (.a env))]
               (for [i 0 (sx-len items)]
                 (let [child (elem items i)]
                   (push! (mut output)
                          (try! (if (and escape (= quote-depth 1) (> i 0))
                                    (expand-calls child
                                                  module
                                                  env
                                                  allfns
                                                  gs
                                                  gu
                                                  depth
                                                  (mut ls))
                                    (expand-template child
                                                     next-depth
                                                     module
                                                     env
                                                     allfns
                                                     gs
                                                     gu
                                                     depth
                                                     (mut ls)))))))
               (Ok [Sexp Diag]
                   (traversed-sexp (if (= tag 6)
                                       (KList (box-al [Sexp]
                                                      (.a env)
                                                      (load output)))
                                       (KVec (box-al [Sexp]
                                                     (.a env)
                                                     (load output))))
                                   node)))))))

(defn expand-calls [(s (ptr Sexp))
                    (module (Option (slice u8)))
                    (env (ptr ExpEnv))
                    (allfns (ptr (ArrayList (slice u8))))
                    (gs (ptr (ArrayList StructDef)))
                    (gu (ptr (ArrayList SumDef)))
                    (depth (ptr i64))
                    (ls (mut LS))] (-> (Result Sexp Diag))
  (let [a (.a env)
        (mut cur) s
        (mut chain-depth) 0]
    (loop (let [current (load cur)
                head
                  (if (= (sx-tag (load current)) 6)
                      (sx-head-name (sx-items (load current)))
                      "")]
            (when (= head "quote") (break (Ok [Sexp Diag] (load current))))
            (when (= head "quasiquote")
              (break (expand-template current
                                      0
                                      module
                                      env
                                      allfns
                                      gs
                                      gu
                                      depth
                                      (mut ls)))))
      (when (is-comptime-defn (load cur) module (.comptime env) a)
        (break (Ok [Sexp Diag] (load (load cur)))))
      (let [tg (sx-tag (load (load cur)))]
        (if (= tg 6)
            (let [items (sx-items (load (load cur)))
                  ; TIER 2 of the Clojure tiering (BINDING_AND_SHADOWING.md): a
                  ; LOCAL BEATS A MACRO in head position. Coil is a Lisp-1 —
                  ; `(let [when 5] when)` was already 5 — but `(let [when 5]
                  ; (when 1 2))` still expanded the macro, so one name meant two
                  ; things in one scope depending on position. Consulting the
                  ; syntactic environment BEFORE the macro table settles it: a
                  ; bound name is not a macro reference, so this becomes an
                  ; attempt to call 5, which is the error Scheme and Clojure both
                  ; give. Special forms are unaffected — they never reach the
                  ; macro table, which is why `(let [if 5] (if a b c))` already
                  ; worked and still does.
                  hp
                    (if (>= (sx-len items) 1)
                        (sx-at items 0)
                        (sx-sym ""))
                  headq
                    (if (and (>= (sx-len items) 1)
                             (and (= (sx-tag hp) 2)
                                  (if (benv-bound? env (lexical-name a hp))
                                      (do
                                        ; Carry the lexical decision on syntax, not a
                                        ; span shared by unrelated generated calls.
                                        (let [annotated
                                                (box-sexp a (load (load cur)))]
                                          (set! (.hflags annotated)
                                                (primitive/ior (.hflags annotated)
                                                               2))
                                          (set! cur annotated))
                                        false)
                                      true)))
                        (resolve-macro (sx-sval hp)
                                       (macro-module-of hp module)
                                       (load (field env macros))
                                       (load (field env impb))
                                       (load (field env expb))
                                       a)
                        (None [(slice u8)]))]
              (match headq
                (Some [q]
                      (do
                        (source-macro-answer! hp q)
                        (set! depth (primitive/iadd (load depth) 1))
                        (set! chain-depth
                              (primitive/iadd (load chain-depth) 1))
                        (trace-macro-call q (load depth) (load chain-depth))
                        (let [limit (macro-expansion-limit)]
                          (if (and (> limit 0) (> (load depth) limit))
                              (break (Err [Sexp Diag]
                                          (stamp-call-site (derr (sconcat a
                                                                          "macro expansion budget exhausted while expanding `"
                                                                          (sconcat3 a
                                                                                    q
                                                                                    "`; total expansions="
                                                                                    (sconcat3 a
                                                                                              (i64->str a
                                                                                                        (load depth))
                                                                                              ", current expansion-chain depth="
                                                                                              (i64->str a
                                                                                                        (load chain-depth))))))
                                                           (load (load cur)))))
                              (match (expand-macro-at (load (load cur)) (load (field env sub))
                                                   q
                                                   (macro-module-of hp module)
                                                   (rest-from a items 1)
                                                   allfns
                                                   gs
                                                   gu
                                                   (load (field env impb))
                                                   (load (field env expb))
                                                   a
                                                   (load (field ls
                                                                code_session_state)) (field ls expansions))
                                (Err [d]
                                     (break (Err [Sexp Diag]
                                                 (stamp-call-site d
                                                                  (load (load cur))))))
                                (Ok [outs]
                                    (let [op (box-sexp a outs)]
                                      (if (sexp-eq (load (load cur)) outs)
                                          (break (Err [Sexp Diag]
                                                      (stamp-call-site (derr (sconcat a
                                                                                      "macro expansion cycle: `"
                                                                                      (sconcat3 a
                                                                                                q
                                                                                                "` reproduced the identical invocation syntax; total expansions="
                                                                                                (i64->str a
                                                                                                          (load depth)))))
                                                                       (load (load cur)))))
                                          0)
                                      (let [dfp
                                              (find-func-ptr (load (field env
                                                                          sub))
                                                             q)
                                            have-def
                                              (!= (primitive/cast i64 dfp)
                                                  0)
                                            def-src
                                              (if have-def (.source dfp) -1)
                                            def-lo (if have-def (.lo dfp) -1)
                                            def-hi (if have-def (.hi dfp) -1)
                                            def-ctxt
                                              (when have-def
                                                (load (field dfp ctxt)))
                                            exp
                                              (mk-expansion q
                                                            (sx-source (load (load cur)))
                                                            (sx-lo (load (load cur)))
                                                            (sx-hi (load (load cur)))
                                                            (sx-ctxt (load (load cur)))
                                                            def-src
                                                            def-lo
                                                            def-hi
                                                            def-ctxt
                                                            (sx-ctxt (load (load cur))))
                                            ctxt (add-expansion! (mut ls) exp)]
                                        (stamp-expansion op
                                                         (sx-source (load (load cur)))
                                                         (sx-lo (load (load cur)))
                                                         (sx-hi (load (load cur)))
                                                         ctxt)
                                        (set! cur op)
                                        0))))))))
                (None []
                      (let [hn (sx-head-name items)]
                        (if (and (= hn "match") (match-has-refutable-arm? items))
                            ; Rewrite the whole match, then expand what it became.
                            (match (lower-refutable-match (load (load cur))
                                                          env
                                                          allfns
                                                          gs
                                                          gu
                                                          depth
                                                          (mut ls))
                              (Err [d] (break (Err [Sexp Diag] d)))
                              (Ok [rewritten] (do (set! cur (box-sexp a rewritten)) 0)))
                        (if (= hn "match")
                            (break (let [r
                                           (expand-match-form items
                                                              module
                                                              env
                                                              allfns
                                                              gs
                                                              gu
                                                              depth
                                                              (mut ls))]
                                     (match r
                                       (Err [d] (Err [Sexp Diag] d))
                                       (Ok [outitems]
                                           (Ok [Sexp Diag]
                                               (traversed-sexp (KList outitems)
                                                               (load cur)))))))
                            (if (= hn "let*")
                                ; Bind each pair before expanding the next initializer.
                                (break (let [mark (benv-mark env)
                                             r
                                               (expand-let-form items
                                                                module
                                                                env
                                                                allfns
                                                                gs
                                                                gu
                                                                depth
                                                                (mut ls))]
                                         (benv-reset! env mark)
                                         (match r
                                           (Err [d] (Err [Sexp Diag] d))
                                           (Ok [outitems]
                                               (Ok [Sexp Diag]
                                                   (traversed-sexp (KList outitems)
                                                                   (load cur)))))))
                                (if (= hn "def")
                                    (break (match (expand-runtime-def-list items
                                                                           module
                                                                           env
                                                                           allfns
                                                                           gs
                                                                           gu
                                                                           depth
                                                                           (mut ls))
                                             (Err [d] (Err [Sexp Diag] d))
                                             (Ok [outitems]
                                                 (Ok [Sexp Diag]
                                                     (traversed-sexp (KList outitems)
                                                                     (load cur))))))
                                    (if (def-form-head? hn)
                                        (break (match (expand-def-list items
                                                                       (def-member-head? hn)
                                                                       module
                                                                       env
                                                                       allfns
                                                                       gs
                                                                       gu
                                                                       depth
                                                                       (mut ls))
                                                 (Err [d]
                                                      (Err [Sexp Diag] d))
                                                 (Ok [outitems]
                                                     (Ok [Sexp Diag]
                                                         (traversed-sexp (KList outitems)
                                                                         (load cur))))))
                                        (break (match (expand-calls-list items
                                                                         module
                                                                         env
                                                                         allfns
                                                                         gs
                                                                         gu
                                                                         depth
                                                                         (mut ls))
                                                 (Err [d]
                                                      (Err [Sexp Diag] d))
                                                 (Ok [outitems]
                                                     (Ok [Sexp Diag]
                                                         (traversed-sexp (KList outitems)
                                                                         (load cur)))))))))))))))
            (if (= tg 7)
                (break (match (expand-calls-list (sx-items (load (load cur)))
                                                 module
                                                 env
                                                 allfns
                                                 gs
                                                 gu
                                                 depth
                                                 (mut ls))
                         (Err [d] (Err [Sexp Diag] d))
                         (Ok [outitems]
                             (Ok [Sexp Diag]
                                 (traversed-sexp (KVec outitems) (load cur))))))
                (break (Ok [Sexp Diag] (load (load cur))))))))))

; Forms understood directly by parse_program. Every other list in definition
; position is a macro call: top-level extensibility is provided by macros, not by
; silently teaching the parser new heads.
(defn top-level-core-form? [(head (slice u8))] (-> bool)
  (cond (= head "do") true
        (= head "defcc") true
        (= head "defannotation") true
        (= head "defalias") true
        (= head "retire-alias") true
        (= head "retire-trait") true
        (= head "retire-impl") true
        (= head "retire-inherent") true
        (retire-definition-kind? head) true
        (= head "defstruct") true
        (= head "defsum") true
        (= head "defn*") true
        (= head "declare") true
        (= head "extern") true
        (= head "export-c") true
        (= head "static-assert") true
        (= head "const") true
        (= head "def") true
        (= head "deftrait") true
        (= head "defdyn-marker") true
        (= head "import") true
        (= head "export") true
        (= head "reader-provider") true
        (= head "impl") true
        (= head "meta") true
        :else false))

;;; The error for the first authored struct, sum or trait definition that takes
;;; a built-in type's name (see definition-type-name), or None. The parser
;;; refuses every such definition, but this runs before metaprograms are staged:
;;; a function whose signature mentions `Code` may be compiled as a metaprogram
;;; candidate ahead of the module's own declarations, and would report a
;;; confusing type error about the built-in type first.
(defn reserved-type-definition [(a (dyn Allocator))
                                (forms (ptr (ArrayList TaggedForm)))] (-> (Option Diag))
  (block :found
    (for [i 0 (len (load forms))]
      (let [f (field (elem forms i) form)]
        (when (= (sx-tag (load f)) 6)
          (let [items (sx-items (load f))
                head (sx-head-name items)]
            (when (and (or (= head "defstruct") (or (= head "defsum") (= head "deftrait")))
                       (and (> (sx-len items) 1) (= (sx-tag (sx-at items 1)) 2)))
              (match (definition-type-name a
                                           (sx-at items 1)
                                           (cond (= head "defstruct") "struct"
                                                 (= head "defsum") "sum"
                                                 :else "trait"))
                (Err [d] (break :found (Some (dwspan d
                                                     (sx-source (load f))
                                                     (sx-lo (load f))
                                                     (sx-hi (load f))
                                                     (sx-ctxt (load f))))))
                (Ok [_] 0)))
            0))))
    (None [Diag])))

(defn expand-top-form [(f (ptr Sexp))
                       (module (Option (slice u8)))
                       (env (ptr ExpEnv))
                       (allfns (ptr (ArrayList (slice u8))))
                       (gs (ptr (ArrayList StructDef)))
                       (gu (ptr (ArrayList SumDef)))
                       (depth (ptr i64))
                       (ls (mut LS))] (-> (Result Sexp Diag))
  (if (or (is-meta-form f)
          (is-comptime-defn f
                            module
                            (load (field env comptime))
                            (.a env)))
      (Ok [Sexp Diag] (load f))
      ; A macro call in definition position must fail while it is still syntax.
      ; Leaving an out-of-scope macro untouched hands it to parse-program, which
      ; can only call it an "unknown top-level form" and may no longer retain the
      ; authored call-site span after transforms have rebuilt the form list.
      (if (and (= (sx-tag (load f)) 6)
               (let [items (sx-items (load f))]
                 (and (> (sx-len items) 0)
                      (= (sx-tag (sx-at items 0)) 2))))
          (let [items (sx-items (load f))
                head (sx-at items 0)
                raw (sx-sval head)]
            (match (resolve-macro raw
                                  (macro-module-of head module)
                                  (load (field env macros))
                                  (load (field env impb))
                                  (load (field env expb))
                                  (.a env))
              (Some [_] (expand-calls f module env allfns gs gu depth (mut ls)))
              (None []
                    (if (top-level-core-form? raw)
                        (expand-calls f module env allfns gs gu depth (mut ls))
                        (Err [Sexp Diag]
                             (dwspan (derr (sconcat3 (.a env)
                                                     "top-level macro '"
                                                     raw
                                                     "' is not in scope here; import the module that defines it"))
                                     (sx-source head)
                                     (sx-lo head)
                                     (sx-hi head)
                                     (sx-ctxt head)))))))
          (expand-calls f module env allfns gs gu depth (mut ls)))))

(defn generated-struct-known? [(gs (ptr (ArrayList StructDef))) (name (slice u8))] (-> bool)
  (let [(mut found) false]
    (for [i 0 (len (load gs))]
      (when (= (.name (elem gs i)) name) (set! found true) (break))
      0)
    (load found)))

(defn generated-sum-known? [(gu (ptr (ArrayList SumDef))) (name (slice u8))] (-> bool)
  (let [(mut found) false]
    (for [i 0 (len (load gu))]
      (when (= (.name (elem gu i)) name) (set! found true) (break))
      0)
    (load found)))

;;; Record FORM's struct or sum declaration, if it is one, in the generated-type
;;; lists a later sibling's macro expansion reflects on. A declaration that does
;;; not parse is left out; the authoritative parse reports it at the form itself.
(defn register-sibling-declaration! [(form Sexp)
                                     (module (Option (slice u8)))
                                     (gs (ptr (ArrayList StructDef)))
                                     (gu (ptr (ArrayList SumDef)))
                                     (a (dyn Allocator))] (-> i64)
  (let [hd (if (= (sx-tag form) 6) (sx-head-name (sx-items form)) "")]
    (when (= hd "deftrait")
      (trait-names-into! (box-sexp a form) module a))
    (when (or (= hd "defstruct") (= hd "defsum"))
      ; The record lands in GS or GU, which outlive this expansion: parse it with
      ; the allocator of the list it lands in, not A, or its fields and variants
      ; are freed while the list still holds it.
      (let [owner (if (= hd "defstruct") (.alc (load gs)) (.alc (load gu)))
            gsb (box! owner SBoxStruct (primitive/zeroed SBoxStruct))
            gub (box! owner SBoxSum (primitive/zeroed SBoxSum))]
        (set! (.items gsb) (load gs))
        (set! (.items gub) (load gu))
        (register-generated-decl (box-sexp owner form) module gsb gub owner)
        (store! gs (.items gsb))
        (store! gu (.items gub))
        0))
    0))

(defn qualify-structdefs! [(p (ptr Program))
                           (module (Option (slice u8)))
                           (gs (ptr SBoxStruct))
                           (a (dyn Allocator))] (-> i64)
  (let [ss (load (field p structs))
        n (len (load ss))
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (let [sd (primitive/alloc-stack StructDef)]
                  (set! sd (get (load ss) (load i)))
                  (set! (.name sd) (qualify-name a (.name sd) module))
                  (unless (generated-struct-known? (field gs items) (.name sd))
                    (push! (mut (.items gs)) (load sd))
                    0))
                (set! i (primitive/iadd (load i) 1))))))
  0)

(defn qualify-sumdefs! [(p (ptr Program))
                        (module (Option (slice u8)))
                        (gu (ptr SBoxSum))
                        (a (dyn Allocator))] (-> i64)
  (let [ss (load (field p sums))
        n (len (load ss))
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (let [sd (primitive/alloc-stack SumDef)]
                  (set! sd (get (load ss) (load i)))
                  (set! (.name sd) (qualify-name a (.name sd) module))
                  (unless (generated-sum-known? (field gu items) (.name sd))
                    (push! (mut (.items gu)) (load sd))
                    0))
                (set! i (primitive/iadd (load i) 1))))))
  0)

(defn register-generated-decl [(form (ptr Sexp))
                               (module (Option (slice u8)))
                               (gs (ptr SBoxStruct))
                               (gu (ptr SBoxSum))
                               (a (dyn Allocator))] (-> (Option Diag))
  (if (!= (sx-tag (load form)) 6)
      (None [Diag])
      (let [it (sx-items (load form))]
        (if (or (< (sx-len it) 1)
                (!= (sx-tag (sx-at it 0)) 2))
            (None [Diag])
            (let [head (sx-sval (sx-at it 0))]
              (when (= head "deftrait")
                (trait-names-into! form module a))
              (if (not (or (= head "defstruct") (= head "defsum")))
                  (None [Diag])
                  (let [single
                          (box! a
                                (ArrayList Sexp)
                                (primitive/zeroed (ArrayList Sexp)))
                        (mut sl) (ArrayList::new [Sexp] a)]
                    (push! (mut sl) (load form))
                    (set! single (load sl))
                    (match (parse-program a single)
                      (Err [d] (Some d))
                      (Ok [p]
                          (let [pp (box-program a p)]
                            (qualify-structdefs! pp module gs a)
                            (qualify-sumdefs! pp module gu a)
                            (None [Diag])))))))))))

(defn box-program [(a (dyn Allocator)) (p Program)] (-> (ptr Program))
  (box! a Program p))

(defstruct SBoxStruct [(items (ArrayList StructDef))])

(defstruct SBoxSum [(items (ArrayList SumDef))])

(defstruct SBoxTF [(items (ArrayList TaggedForm))])

; Checked environments contain lifted trait methods as ordinary functions.
; Their Code signatures do not make them syntax macros. Use the same identities
; as the checker rather than guessing from a mangled name's spelling.
(defn trait-method-identities [(p (ptr Program)) (a (dyn Allocator))]
                               (-> (HashMap (slice u8) i64))
  (let [(mut names) (HashMap::new [(slice u8) i64] a (keyops))]
    (unless (= (primitive/cast i64 (.impls p)) 0)
      (for [i 0 (len (load (.impls p)))]
        (let [im (elem (.impls p) i)]
          (match (.kind im)
            (InherentImpl [] 0)
            (TraitImpl [trait]
              (let [key (impl-mangle-key a (field im self_type) (.type_params im))]
                (for [j 0 (len (load (.methods im)))]
                  (set! (mut names) (tmfn a trait key (.name (elem (.methods im) j))) 0)) 0))))) 0)
    (load names)))

(defn code-sig-funcs-except [(p (ptr Program))
                             (excluded (ptr (ArrayList (slice u8))))
                             (a (dyn Allocator))] (-> (ptr (ArrayList (slice u8))))
  (let [fs (load (field p funcs))
        n (len (load fs))
        methods (trait-method-identities p a)
        (mut out) (ArrayList::new [(slice u8)] a)
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (let [fp (elem fs (load i))]
                  (when (and (not (set-contains excluded (load (field fp name))))
                             (and (not (contains? methods (.name fp)))
                                  (and (type-is-code (field fp ret))
                                       (all-params-code (load (field fp params))))))
                    (push! (mut out) (load (field fp name)))
                    0))
                (set! i (primitive/iadd (load i) 1)))))
    (box-al [(slice u8)] a (load out))))

;;; Does a type hold compile-time syntax (Code or CodeBuilder)?
(defn type-is-compile-time-syntax [(t (ptr Type))] (-> bool)
  (match (load t) (TCode [] true) (TCodeBuilder [] true) (_ false)))

;;; The closure seeds for metaprogram staging: `quals` (the Code→Code macros) plus
;;; every other function whose signature takes or returns Code or CodeBuilder. Such a
;;; function can only run at compile time whatever else it returns, so its body is
;;; metaprogram code: a Code→Code call in it with Code arguments is an ordinary
;;; call, left for the tower to judge, never an eager macro expansion.
(defn compile-time-seeds [(p (ptr Program))
                          (quals (ptr (ArrayList (slice u8))))
                          (excluded (ptr (ArrayList (slice u8))))
                          (a (dyn Allocator))] (-> (ptr (ArrayList (slice u8))))
  (let [methods (trait-method-identities p a)
        (mut out) (ArrayList::new [(slice u8)] a)]
    (for [i 0 (len (load quals))] (push! (mut out) (get (load quals) i)))
    (for [i 0 (len (load (load (field p funcs))))]
      (let [fp (elem (load (field p funcs)) i)
            name (.name fp)
            (mut code) (type-is-compile-time-syntax (field fp ret))]
        (for [j 0 (len (load (load (field fp params))))]
          (when (type-is-compile-time-syntax (field (elem (load (field fp params)) j) ty))
            (set! code true)))
        (when (and code
                   (and (not (set-contains excluded name))
                        (and (not (contains? methods name))
                             (not (set-contains quals name)))))
          (push! (mut out) name)
          0)))
    (box-al [(slice u8)] a (load out))))

(defn code-sig-funcs [(p (ptr Program)) (a (dyn Allocator))] (-> (ptr (ArrayList (slice u8))))
  (code-sig-funcs-except p (box-al [(slice u8)] a (ArrayList::new [(slice u8)] a)) a))

(defn persist-names [(names (ptr (ArrayList (slice u8))))
                     (a (dyn Allocator))] (-> (ptr (ArrayList (slice u8))))
  (let [n (len (load names))
        (mut out) (ArrayList::new [(slice u8)] a)
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                ; The resolved Program and its qualified names belong to a stage-round
                ; scratch arena. StageBox outlives that arena, so retain both the list
                ; and every name in the caller's arena.
                (push! (mut out) (sconcat a (get (load names) (load i)) ""))
                (set! i (primitive/iadd (load i) 1)))))
    (box-al [(slice u8)] a (load out))))

(defn all-params-code [(ps (ptr (ArrayList Param)))] (-> bool)
  (let [n (len (load ps))
        (mut i) 0
        (mut r) true]
    (loop (if (or (not (load r)) (>= (load i) n))
              (break)
              (do
                (unless (type-is-code (field (elem ps (load i)) ty))
                  (store! r false)
                  0)
                (set! i (primitive/iadd (load i) 1)))))
    (load r)))

(defn declaration-names-into! [(fp (ptr Sexp))
                               (sb (ptr SBox))
                               (module (Option (slice u8)))
                               (a (dyn Allocator))] (-> i64)
  (if (and (= (sx-tag (load fp)) 6)
           (and (> (sx-len (sx-items (load fp))) 0)
                (and (= (sx-tag (sx-at (sx-items (load fp)) 0))
                        2)
                     (= (sx-sval (sx-at (sx-items (load fp)) 0)) "do"))))
      (let [items (sx-items (load fp))
            (mut i) 1]
        (loop (if (>= (load i) (sx-len items))
                  (break)
                  (do
                    (declaration-names-into! (elem items (load i))
                                             sb
                                             module
                                             a)
                    (set! i (+ (load i) 1)))))
        0)
      (do
        (match (defn-name-of fp)
          (Some [nm] (push! (mut (.items sb)) (qualify-name a nm module)))
          (None [] 0))
        (trait-method-names-into! fp sb module a))))

(defn all-defn-names [(out-forms (ptr (ArrayList TaggedForm)))
                      (a (dyn Allocator))] (-> (ptr SBox))
  (let [sb (box! a SBox (primitive/zeroed SBox))
        n (len (load out-forms))
        (mut i) 0]
    (set! (.items sb) (ArrayList::new [(slice u8)] a))
    (loop (if (>= (load i) n)
              (break)
              (do
                (let [tf (elem out-forms (load i))
                      fp (field tf form)]
                  (declaration-names-into! fp sb (.module tf) a))
                (set! i (primitive/iadd (load i) 1)))))
    ; This is the ONLY place a module_fns list is born, so it is the one place that
    ; can guarantee comptime's set index never outlives the list it indexed — even if
    ; the allocator hands this fresh list the address of a dead one.
    sb))

;;; `all-defn-names` of the tower's sub-forms, kept while they are unchanged. The
;;; tower builds a context for every diagnostic it recovers, and each context
;;; needs the program's declared names: rebuilding them qualified one string at
;;; a time per diagnostic was the tower's largest allocation. A rewrite bumps the
;;; form's revision, and form ids are never reused in a process, so the forms'
;;; count with their ids and revisions summed says whether the names still hold.
(defstruct DefnNamesMemo
  [(ready bool)
   (forms i64)
   (count i64)
   (stamp i64)
   (names (ptr SBox))
   (arena scratch/ScratchArena)])

(defn defn-names-memo [] (-> (ptr DefnNamesMemo))
  (primitive/alloc-static DefnNamesMemo))

(defn all-defn-names-memo [(out-forms (ptr (ArrayList TaggedForm)))] (-> (ptr SBox))
  (let [m (defn-names-memo)
        n (len (load out-forms))
        (mut stamp) 0]
    (for [i 0 n]
      (let [tf (elem out-forms i)]
        (set! stamp (+ (* (load stamp) 31) (+ (.form_id tf) (* (.revision tf) 1000003))))))
    (unless (and (.ready m)
                 (and (= (.forms m) (primitive/cast i64 out-forms))
                      (and (= (.count m) n) (= (.stamp m) (load stamp)))))
      (if (.ready m)
          (reset! (field m arena))
          (scratch/ScratchArena::init-with-capacity (field m arena) (retained-heap/compiler-scratch-parent) 65536))
      (set! (.names m) (all-defn-names out-forms (allocator (field m arena))))
      (set! (.forms m) (primitive/cast i64 out-forms))
      (set! (.count m) n)
      (set! (.stamp m) (load stamp))
      (set! (.ready m) true)
      0)
    (.names m)))

; ── the DEFINITION-TIME EXPANSION TOWER ──────────────────────────────────────
; A metaprogram body may CALL MACROS (`when`, `try!`, `fmt`, …). The rule is
; TYPE-DIRECTED (docs/design/COMPILE_AND_RUN.md): a call to a
; Code-signature function whose arguments all typecheck as Code is an ordinary
; FUNCTION call (passing code values — cond-arms' recursion); one whose arguments
; do NOT is surface syntax, expanded AT DEFINITION TIME. No second judgment is
; implemented: the sub-program CHECK is the judge. When it rejects the sub-program
; at a macro-headed call form -- the diagnostic spans the call or one of its
; arguments -- that is the rule firing: expand that one call, re-resolve,
; re-check, to a fixpoint. A rejection deeper inside an argument that holds
; another macro use does not judge the outer call; that use expands first (see
; `written-calls`). A program whose sub-check passes first try (all
; previously-valid programs) pays nothing.
(defstruct TowerCx
  [(a (dyn Allocator))
   (dlo i64)
   (dhi i64)
   (dsrc i64)
   (macroctx (ptr Program))
   (quals (ptr (ArrayList (slice u8))))
   (allfns (ptr (ArrayList (slice u8))))
   (impb (ptr (ArrayList ImpEntry)))
   (expb (ptr (ArrayList ExpEntry)))
   (module (Option (slice u8)))
   (hit i64)
   (depth i64)
   ; Structs and sums declared by forms this tower has walked so far. A later
   ; sibling -- `(derive … T)` after the `(defsum T …)` of the same `(do …)` a
   ; macro produced -- reflects on them; the tolerant context skipped that whole
   ; `do`, which does not parse until its macro calls are expanded.
   (gen_structs (ptr (ArrayList StructDef)))
   (gen_sums (ptr (ArrayList SumDef)))])

; A parsed parent span encloses every parsed child span from the same source.
; Diagnostic-directed tower recovery can therefore skip a disjoint subtree
; without walking it. Generated parents with absent/cross-source spans remain
; conservative and are traversed normally.
(defn tower-disjoint-from-diag? [(tc (ptr TowerCx)) (node (ptr Sexp))] (-> bool)
  (let [source (sx-source (load node))
        lo (sx-lo (load node))
        hi (sx-hi (load node))]
    (and (= source (.dsrc tc))
         (and (>= lo 0)
              (or (< hi (.dlo tc))
                  (> lo (.dhi tc)))))))

; ── calls the tower has not judged yet ──────────────────────────────────────
; Which reading a Code-signature call in a metaprogram body takes depends on its
; arguments' types, and a check that fails INSIDE an argument has not decided
; them: `(f (let [y `(a)] y))` is a call, since the `let` is Code, while
; `(when (let [n (count)] (> n 1)) x)` is a macro use, since that `let` is bool.
; Both fail the check at a name inside the `let`, so the outer call's reading is
; known only once the `let` is expanded. The tower expands the inner use first
; and leaves the outer call for the next check to judge.
;
; A macro receives its arguments as they were written, though. So before the
; tower rewrites anything inside an undecided call it records the call's
; written form here, under the call's node id; a rewrite of the call carries the
; record to the rebuilt node; and when the call is finally expanded as a macro
; use, the written form is what expands. A call that turns out to be a function
; call keeps its rewritten arguments: they are expressions, expanded as such.
(defn written-calls [] (-> (ptr WrittenCalls))
  (let [w (field (expander-unit-state) written_calls)]
    (unless (.ready w)
      (set! (.calls w) (HashMap::new [i64 Sexp] (unit-allocator) (i64-keyops)))
      (set! (.ready w) true))
    w))

;;; Record NODE's written form before the tower rewrites inside it. False when
;;; the node has no id to record it under.
(defn tower-defer-call! [(a (dyn Allocator)) (node (ptr Sexp))] (-> bool)
  (let [id (sx-node-id (load node))
        w (written-calls)]
    (if (= id 0)
        false
        (do
          (match (get (.calls w) id)
            (Some [_] 0)
            (None [] (do (set! (mut (.calls w)) id (tower-clone-sexp a node)) 0)))
          true))))

;;; A tower rewrite rebuilt OLD as NEW; NEW is the same call, so it keeps OLD's
;;; written form.
(defn tower-rebuilt! [(old (ptr Sexp)) (new (ptr Sexp))] (-> i64)
  (let [w (written-calls)]
    (when (> (len (.calls w)) 0)
      (match (get (.calls w) (sx-node-id (load old)))
        (Some [written] (do (set! (mut (.calls w)) (sx-node-id (load new)) written) 0))
        (None [] 0)))
    0))

;;; The call as written, when NODE is a rewrite of a call the tower left undecided.
(defn tower-written-call [(a (dyn Allocator)) (node (ptr Sexp))] (-> (ptr Sexp))
  (let [w (written-calls)]
    (if (= (len (.calls w)) 0)
        node
        (match (get (.calls w) (sx-node-id (load node)))
          (Some [written] (box-sexp a written))
          (None [] node)))))

;;; Does the check's diagnostic in TC settle that the macro-headed call NODE is a
;;; macro use? It does when it is about the call itself: it spans the call, or one
;;; of its arguments that is not a macro use of its own (such an argument is a
;;; Code-returning call, so a diagnostic there is about that call). And a call with
;;; an argument that can never be Code -- a number, string, keyword or vector
;;; literal -- is not a function call whatever the diagnostic says.
(defn tower-call-owns-diag? [(tc (ptr TowerCx)) (node (ptr Sexp))] (-> bool)
  (let [items (sx-items (load node))
        n (sx-len items)]
    (or (tower-spans-diag? tc node)
        (block :owned
          (for [i 1 n]
            (let [arg (elem items i)
                  tag (sx-tag (load arg))]
              (when (or (and (tower-spans-diag? tc arg) (not (tower-macro-headed? tc arg)))
                        (or (= tag 0) (= tag 1) (= tag 3) (= tag 4) (= tag 5) (= tag 7)
                            (and (= tag 2)
                                 (or (= (sx-sval (load arg)) "true")
                                     (= (sx-sval (load arg)) "false")))))
                (break :owned true))))
          false))))

(defn tower-spans-diag? [(tc (ptr TowerCx)) (node (ptr Sexp))] (-> bool)
  (and (= (sx-source (load node)) (.dsrc tc))
       (= (sx-lo (load node)) (.dlo tc))
       (= (sx-hi (load node)) (.dhi tc))))

(defn tower-macro-headed? [(tc (ptr TowerCx)) (node (ptr Sexp))] (-> bool)
  (and (= (sx-tag (load node)) 6)
       (let [items (sx-items (load node))]
         (and (>= (sx-len items) 1)
              (= (sx-tag (sx-at items 0)) 2)
              (match (resolve-macro (sx-sval (sx-at items 0))
                                    (macro-module-of (sx-at items 0) (.module tc))
                                    (.quals tc)
                                    (.impb tc)
                                    (.expb tc)
                                    (.a tc))
                (Some [_] true)
                (None [] false))))))

; expand ONE macro call at `node` (already known macro-headed), mirroring
; expand-calls' head answer + invoke + expansion-record + span-stamp exactly. The
; head answer is what makes the call an authored reference: a top-level macro call
; the tower expands never reaches expand-calls as a call again.
(defn tower-expand-call [(tc (ptr TowerCx))
                         (s (mut LS))
                         (node (ptr Sexp))
                         (q (slice u8))] (-> (Result Sexp Diag))
  (tower-expand-written tc (mut s) (tower-written-call (.a tc) node) q))

(defn tower-expand-written [(tc (ptr TowerCx))
                            (s (mut LS))
                            (node (ptr Sexp))
                            (q (slice u8))] (-> (Result Sexp Diag))
  (let [a (.a tc)
        items (sx-items (load node))
        gs (.gen_structs tc)
        gu (.gen_sums tc)]
    (source-macro-answer! (sx-at items 0) q)
    (let [expand-span (tr/span-begin q)
          expand-result
            (expand-macro-at (load node) (load (field tc macroctx))
                          q
                          (macro-module-of (sx-at items 0) (load (field tc module)))
                          (rest-from a items 1)
                          (load (field tc allfns))
                          gs
                          gu
                          (load (field tc impb))
                          (load (field tc expb))
                          a
                          (load (field s code_session_state)) (field s expansions))
          _expand-end (tr/span-end expand-span)]
      (match expand-result
        (Err [d] (Err [Sexp Diag] (stamp-call-site d (load node))))
        (Ok [outs]
            (let [op (box-sexp a outs)
                  dfp (find-func-ptr (load (field tc macroctx)) q)
                  have-def (!= (primitive/cast i64 dfp) 0)
                  def-src (if have-def (.source dfp) -1)
                  def-lo (if have-def (.lo dfp) -1)
                  def-hi (if have-def (.hi dfp) -1)
                  def-ctxt (when have-def (load (field dfp ctxt)))
                  exp
                    (mk-expansion q
                                  (sx-source (load node))
                                  (sx-lo (load node))
                                  (sx-hi (load node))
                                  (sx-ctxt (load node))
                                  def-src
                                  def-lo
                                  def-hi
                                  def-ctxt
                                  (sx-ctxt (load node)))
                  ctxt (add-expansion! (mut s) exp)]
              (stamp-expansion op
                               (sx-source (load node))
                               (sx-lo (load node))
                               (sx-hi (load node))
                               ctxt)
              ; Consume exactly the call justified by this checker diagnostic.
              ; Every descendant of the expansion is stamped with the outer call's
              ; span for provenance. Reusing the old diagnostic recursively would
              ; therefore mistake an ordinary Code-valued call copied from a macro
              ; branch for another rejected macro call. A genuine outer-to-inner
              ; macro chain is diagnosed by the next checked generation.
              (set! (.hit tc) 1)
              (Ok [Sexp Diag] (load op))))))))

; Rewrite one call per nested branch, OUTERMOST first. A macro call that CONTAINS
; the diag span owns that syntax wholesale — `(when (not b) …)` must expand before
; its `(not b)` argument does, or the inner expansion lands as a non-Code value in
; the outer macro's Code-typed argument slot and the round wedges. Independent
; sibling branches/forms are safe to batch in the same generation.
(defn tower-template-rewrite [(tc (ptr TowerCx))
                              (s (mut LS))
                              (node (ptr Sexp))
                              (depth i64)
                              (parse-only bool)] (-> (Result Sexp Diag))
  (try (let [tag (sx-tag (load node))]
         (if (not (or (= tag 6) (= tag 7)))
             (Ok [Sexp Diag] (load node))
             (let [items (sx-items (load node))
                   head (if (= tag 6) (sx-head-name items) "")
                   escape (or (= head "unquote") (= head "unquote-splicing"))
                   next-depth
                     (if (= head "quasiquote")
                         (+ depth 1)
                         (if escape (- depth 1) depth))
                   (mut output) (primitive/zeroed (ArrayList Sexp))
                   (mut changed) false]
               (for [i 0 (sx-len items)]
                 (set! (.hit tc) 0)
                 (let [child (elem items i)
                       next
                         (try! (if (and escape (= depth 1) (> i 0))
                                   (if parse-only
                                       (tower-parse-rewrite tc (mut s) child)
                                       (tower-rewrite tc (mut s) child))
                                   (tower-template-rewrite tc
                                                           (mut s)
                                                           child
                                                           next-depth
                                                           parse-only)))]
                   (if (!= (.hit tc) 0)
                       (do
                         (unless (load changed)
                           (set! output (ArrayList::new [Sexp] (.a tc)))
                           (for [j 0 i]
                             (push! (mut output) (sx-at items j))
                             0))
                         (push! (mut output) next)
                         (set! changed true)
                         0)
                       (when (load changed)
                         (push! (mut output) next)
                         0))))
               (set! (.hit tc) (if (load changed) 1 0))
               (Ok [Sexp Diag]
                   (if (load changed)
                       (mk-sexp-src (if (= tag 6)
                                        (KList (box-al [Sexp]
                                                       (.a tc)
                                                       (load output)))
                                        (KVec (box-al [Sexp]
                                                      (.a tc)
                                                      (load output))))
                                    node)
                       (load node))))))))

; Quoted templates are data. Only active unquotes are executable expressions;
; generated provenance can give the entire template the same diagnostic span.
(defn tower-rewrite [(tc (ptr TowerCx)) (s (mut LS)) (node (ptr Sexp))] (-> (Result Sexp
                                                                                    Diag))
  (let [head
          (if (= (sx-tag (load node)) 6)
              (sx-head-name (sx-items (load node)))
              "")]
    (if (= head "quote")
        (Ok [Sexp Diag] (load node))
        (if (= head "quasiquote")
            (tower-template-rewrite tc (mut s) node 0 false)
            (tower-rewrite-code tc (mut s) node)))))

(defn tower-rewrite-code [(tc (ptr TowerCx)) (s (mut LS)) (node (ptr Sexp))] (-> (Result Sexp
                                                                                         Diag))
  (try (do
         (let [a (load (field tc a))
               tg (sx-tag (load node))]
           (if (not (or (= tg 6)
                        (= tg 7)))
               (Ok [Sexp Diag] (load node))
               (if (tower-disjoint-from-diag? tc node)
                   (Ok [Sexp Diag] (load node))
                   (let [items (sx-items (load node))
                         n (sx-len items)
                         contains
                           (and (= (sx-source (load node))
                                   (load (field tc dsrc)))
                                (and (>= (sx-lo (load node))
                                         0)
                                     (and (<= (sx-lo (load node))
                                              (load (field tc dlo)))
                                          (>= (sx-hi (load node))
                                              (load (field tc dhi))))))
                         headq
                           (if (and contains
                                    (and (= tg 6)
                                         (and (>= n 1)
                                              (= (sx-tag (sx-at items 0))
                                                 2))))
                               (resolve-macro (sx-sval (sx-at items 0))
                                              (macro-module-of (sx-at items 0)
                                                               (load (field tc
                                                                            module)))
                                              (load (field tc quals))
                                              (load (field tc impb))
                                              (load (field tc expb))
                                              a)
                               (None [(slice u8)]))]
                     (match headq
                       (Some [q]
                             (if (tower-call-owns-diag? tc node)
                                 (tower-expand-call tc (mut s) node q)
                                 (tower-rewrite-undecided tc (mut s) node q)))
                       (None [] (tower-rewrite-kids tc (mut s) node))))))))))

; The check failed inside an argument of the macro-headed NODE, at another macro
; use: expand that use first and leave NODE for the next check to judge (see
; `written-calls`). If nothing inside NODE can be expanded, or expanding it fails,
; NODE is the macro use the diagnostic is about.
(defn tower-rewrite-undecided [(tc (ptr TowerCx))
                               (s (mut LS))
                               (node (ptr Sexp))
                               (q (slice u8))] (-> (Result Sexp Diag))
  (if (not (tower-defer-call! (.a tc) node))
      (tower-expand-call tc (mut s) node q)
      (match (tower-rewrite-kids tc (mut s) node)
        (Ok [r] (if (= (.hit tc) 0)
                    (tower-expand-call tc (mut s) node q)
                    (Ok [Sexp Diag] r)))
        (Err [_] (do (set! (.hit tc) 0) (tower-expand-call tc (mut s) node q))))))

(defn tower-rewrite-kids [(tc (ptr TowerCx)) (s (mut LS)) (node (ptr Sexp))] (-> (Result Sexp Diag))
  (try (let [a (.a tc)
             tg (sx-tag (load node))
             items (sx-items (load node))
             n (sx-len items)
             (mut any) false
             (mut xs) (primitive/zeroed (ArrayList Sexp))]
         (for [i 0 n]
           (set! (.hit tc) 0)
           (let [r (try! (tower-rewrite tc (mut s) (elem items i)))]
             (if (!= (.hit tc) 0)
                 (do
                   (unless any
                     (set! xs (ArrayList::new [Sexp] a))
                     (for [j 0 i] (push! (mut xs) (sx-at items j))))
                   (set! any true)
                   (push! (mut xs) r))
                 (when any (push! (mut xs) (sx-at items i))))))
         (set! (.hit tc) (if any 1 0))
         (if any
             (let [rebuilt (primitive/alloc-stack Sexp)]
               (set! rebuilt (mk-sexp-src (if (= tg 7)
                                              (KVec (box-al [Sexp] a xs))
                                              (KList (box-al [Sexp] a xs)))
                                          node))
               (tower-rebuilt! node rebuilt)
               (Ok [Sexp Diag] (load rebuilt)))
             (Ok [Sexp Diag] (load node))))))

; ── the PARSE-LEVEL tower trigger ────────────────────────────────────────────
; A macro call whose arguments are not expression syntax at all — objc's
; (msg (ptr i8) recv sel [CGRect i64] …) with its naked type vectors — makes the
; whole enclosing defn UNPARSEABLE, so the tolerant resolve skips it and the
; check-driven tower never sees a diagnostic. This is the type-directed rule's
; syntactic BASE CASE: a macro-headed call that does not even parse as an
; expression cannot be a function call — expand it. A call that fails to parse
; only inside a macro use one of its arguments holds is not that case: the inner
; use is (`tower-parse-undecided`). Applied OUTERMOST-first,
; only inside defns the tolerant resolve skipped (zero cost when everything
; parses). Quoted data is preserved; active unquotes remain executable.
(defn tower-unparseable? [(a (dyn Allocator)) (node (ptr Sexp))] (-> bool)
  (match (parse-expr a (load node)) (Err [d] true) (Ok [e] false)))

; BATCHED: expand EVERY unparseable macro-headed call in the subtree (outermost
; per nesting) in one pass, so a defn full of them converges in one round.
; Each recursive result reports its own change bit; parents accumulate siblings.
(defn tower-parse-rewrite [(tc (ptr TowerCx)) (s (mut LS)) (node (ptr Sexp))] (-> (Result Sexp
                                                                                          Diag))
  (try (do
         (let [a (load (field tc a))
               tg (sx-tag (load node))]
           (if (not (or (= tg 6)
                        (= tg 7)))
               (Ok [Sexp Diag] (load node))
               (let [items (sx-items (load node))
                     n (sx-len items)
                     head
                       (if (and (= tg 6)
                                (and (>= n 1)
                                     (= (sx-tag (sx-at items 0))
                                        2)))
                           (sx-sval (sx-at items 0))
                           "")]
                 (if (or (= head "quote") (= head "quasiquote"))
                     (if (= head "quote")
                         (Ok [Sexp Diag] (load node))
                         (tower-template-rewrite tc (mut s) node 0 true))
                     (match (if (= head "")
                                (None [(slice u8)])
                                (resolve-macro head
                                               (macro-module-of (sx-at items 0)
                                                                (load (field tc
                                                                             module)))
                                               (load (field tc quals))
                                               (load (field tc impb))
                                               (load (field tc expb))
                                               a))
                       (Some [q]
                             (match (parse-expr a (load node))
                               (Ok [_] (tower-parse-kids tc (mut s) node))
                               (Err [d]
                                    (if (tower-failure-in-macro-use? tc node d)
                                        (tower-parse-undecided tc (mut s) node q)
                                        (tower-expand-call tc (mut s) node q)))))
                       (None []
                             ; A `match` whose arms destructure, `(Some [[a b]] …)`,
                             ; or refute, `(0 …)`, is syntax only once its arms are
                             ; normalized, as the main walk does in
                             ; `expand-match-form`. Left alone, the defn holding it
                             ; never parses, misses the metaprogram closure, and is
                             ; then expanded as a runtime function, where every call
                             ; to a Code helper in it reads as a macro use.
                             (if (and (= head "match")
                                      (and (tower-match-normalizes? items)
                                           (tower-unparseable? a node)))
                                 (let [normalized (try! (tower-normalize-match tc (mut s) node))
                                       r (try! (tower-parse-rewrite tc (mut s) (box-sexp a normalized)))]
                                   (set! (.hit tc) 1)
                                   (Ok [Sexp Diag] r))
                                 (tower-parse-kids tc (mut s) node)))))))))))

;;; Normalize a `match`'s arms for the tower as `expand-match-form` does for the
;;; main walk: a match with a refutable arm is lowered whole, and an arm with a
;;; structured payload pattern gets its `let*` prologue. Its body is left as written.
(defn tower-normalize-match [(tc (ptr TowerCx)) (s (mut LS)) (node (ptr Sexp))] (-> (Result Sexp Diag))
  (try (let [a (load (field tc a))
             env (primitive/alloc-stack ExpEnv)
             depth (primitive/alloc-stack i64)
             items (sx-items (load node))]
         (set! (.macros env) (load (field tc quals)))
         (set! (.comptime env) (box-al [(slice u8)] a (ArrayList::new [(slice u8)] a)))
         (set! (.sub env) (load (field tc macroctx)))
         (set! (.impb env) (load (field tc impb)))
         (set! (.expb env) (load (field tc expb)))
         (set! (.bound env) (box-al [(slice u8)] a (ArrayList::new [(slice u8)] a)))
         (set! (.a env) a)
         (store! depth (.depth tc))
         (if (match-has-refutable-arm? items)
             (lower-refutable-match (load node)
                                    env
                                    (load (field tc allfns))
                                    (.gen_structs tc)
                                    (.gen_sums tc)
                                    depth
                                    (mut s))
             (let [(mut out) (ArrayList::new [Sexp] a)]
               (for [i 0 (sx-len items)]
                 (let [arm (elem items i)]
                   (if (and (>= i 2) (match-arm-destructures? (load arm)))
                       (push! (mut out)
                              (try! (normalize-match-arm-once arm
                                                              env
                                                              (load (field tc allfns))
                                                              (.gen_structs tc)
                                                              (.gen_sums tc)
                                                              depth
                                                              (mut s))))
                       (push! (mut out) (load arm)))))
               (Ok [Sexp Diag] (mk-sexp-src (KList (box-al [Sexp] a (load out))) node)))))))

;;; Does normalizing this `match` change it: has it a refutable arm, or an arm
;;; whose payload pattern is structured? One that fails to parse for another
;;; reason, such as an arm with no bind vector, is left to the check to report.
(defn tower-match-normalizes? [(items (ptr (ArrayList Sexp)))] (-> bool)
  (or (match-has-refutable-arm? items)
      (block :structured
        (for [i 2 (sx-len items)]
          (when (match-arm-destructures? (load (elem items i)))
            (break :structured true)))
        false)))

;;; Is this `(Variant [patterns…] body…)` arm's pattern vector more than names?
(defn match-arm-destructures? [(arm Sexp)] (-> bool)
  (and (= (sx-tag arm) 6)
       (let [it (sx-items arm)]
         (and (>= (sx-len it) 2)
              (!= (sx-head-name it) "_")
              (= (sx-tag (sx-at it 1)) 7)
              (block :structured
                (for [j 0 (sx-len (sx-items (sx-at it 1)))]
                  (unless (= (sx-tag (sx-at (sx-items (sx-at it 1)) j)) 2)
                    (break :structured true)))
                false)))))

;;; Is the parse failure D of the macro-headed NODE inside one of the macro uses
;;; NODE's arguments hold? Then NODE itself may be expression syntax -- a function
;;; call whose argument is a macro use -- and the inner use is the one the base
;;; case is about.
(defn tower-failure-in-macro-use? [(tc (ptr TowerCx)) (node (ptr Sexp)) (d Diag)] (-> bool)
  (and (= (.source d) (sx-source (load node)))
       (>= (.lo d) 0)
       (let [items (sx-items (load node))]
         (block :found
           (for [i 1 (sx-len items)]
             (when (tower-macro-use-holds? tc (elem items i) node d)
               (break :found true)))
           false))))

(defn tower-macro-use-holds? [(tc (ptr TowerCx)) (x (ptr Sexp)) (outer (ptr Sexp)) (d Diag)] (-> bool)
  (let [tag (sx-tag (load x))]
    (and (or (= tag 6) (= tag 7))
         (= (sx-source (load x)) (.source d))
         (>= (sx-lo (load x)) 0)
         (<= (sx-lo (load x)) (.lo d))
         (>= (sx-hi (load x)) (.hi d))
         (let [items (sx-items (load x))
               head (if (= tag 6) (sx-head-name items) "")]
           (and (not (or (= head "quote") (= head "quasiquote")))
                (or (and (tower-macro-headed? tc x)
                         (not (and (= (sx-lo (load x)) (sx-lo (load outer)))
                                   (= (sx-hi (load x)) (sx-hi (load outer))))))
                    (block :found
                      (for [i 0 (sx-len items)]
                        (when (tower-macro-use-holds? tc (elem items i) outer d)
                          (break :found true)))
                      false)))))))

; The macro-headed NODE does not parse only because a macro use inside one of its
; arguments does not: expand that use first and leave NODE for the check to judge,
; as `tower-rewrite-undecided` does.
(defn tower-parse-undecided [(tc (ptr TowerCx))
                             (s (mut LS))
                             (node (ptr Sexp))
                             (q (slice u8))] (-> (Result Sexp Diag))
  (if (not (tower-defer-call! (.a tc) node))
      (tower-expand-call tc (mut s) node q)
      (match (tower-parse-kids tc (mut s) node)
        (Ok [r] (if (= (.hit tc) 0)
                    (tower-expand-call tc (mut s) node q)
                    (Ok [Sexp Diag] r)))
        (Err [_] (do (set! (.hit tc) 0) (tower-expand-call tc (mut s) node q))))))

(defn tower-parse-kids [(tc (ptr TowerCx)) (s (mut LS)) (node (ptr Sexp))] (-> (Result Sexp
                                                                                       Diag))
  (try (do
         (let [a (load (field tc a))
               tg (sx-tag (load node))
               items (sx-items (load node))
               n (sx-len items)
               (mut any) false
               (mut xs) (primitive/zeroed (ArrayList Sexp))
               (mut i) 0]
           (loop (if (>= (load i) n)
                     (break)
                     (do
                       (store! (field tc hit) 0)
                       (let [r
                               (try! (tower-parse-rewrite tc
                                                          (mut s)
                                                          (elem items
                                                                (load i))))]
                         (if (!= (load (field tc hit)) 0)
                             (do
                               (unless (load any)
                                 (set! xs (ArrayList::new [Sexp] a))
                                 (for [j 0 (load i)]
                                   (push! (mut xs) (sx-at items j))
                                   0))
                               (store! any true)
                               (push! (mut xs) r)
                               0)
                             (when (load any)
                               (push! (mut xs) (sx-at items (load i)))
                               0)))
                       (store! i (primitive/iadd (load i) 1)))))
           (store! (field tc hit) (if (load any) 1 0))
           (if (load any)
               (let [rebuilt (primitive/alloc-stack Sexp)]
                 (set! rebuilt (mk-sexp-src (if (= tg 7)
                                                (KVec (box-al [Sexp] a (load xs)))
                                                (KList (box-al [Sexp] a (load xs))))
                                            node))
                 (tower-rebuilt! node rebuilt)
                 (Ok [Sexp Diag] (load rebuilt)))
               (Ok [Sexp Diag] (load node)))))))

; Is this raw (pre-parse) form a Code-signature defn — i.e. a METAPROGRAM whose
; body may legitimately contain unparseable macro syntax (objc `msg`)? Judged on
; the Sexp: (defn NAME [(p Code)…& (r Code)] (-> Code) …).
; Source-only CLI entry classification also accepts the public macro spelling.
; Declaration discovery calls raw-code-sig? after normalization, never this path.
(defn source-code-sig? [(f (ptr Sexp))] (-> bool)
  (code-signature-form? f true))

(defn raw-code-sig? [(f (ptr Sexp))] (-> bool)
  (code-signature-form? f false))

(defn code-signature-parameter? [(p Sexp)] (-> bool)
  (if (= (sx-tag p) 2)
      (= (sx-sval p) "&")
      (if (= (sx-tag p) 6)
          (let [items (sx-items p)
                n (sx-len items)
                ti
                  (if (= n 2)
                      1
                      (if (and (= n 3)
                               (and (= (sx-tag (sx-at items 0)) 3)
                                    (= (sx-sval (sx-at items 0)) "positional")))
                          2
                          -1))]
            (and (>= ti 0) (code-type-form? (sx-at items ti))))
          false)))

(defn code-signature-form? [(f (ptr Sexp)) (public bool)] (-> bool)
  (if (!= (sx-tag (load f)) 6)
      false
      (let [it (sx-items (load f))
            n (sx-len it)]
        (if (or (< n 4)
                (not (and (= (sx-tag (sx-at it 0)) 2)
                          (or (= (sx-sval (sx-at it 0)) "defn*")
                              (and public (= (sx-sval (sx-at it 0)) "defn"))))))
            false
            (let [pi
                    (if (= (sx-tag (sx-at it 2)) 7)
                        2
                        (if (and (> n 4)
                                 (= (sx-tag (sx-at it 3))
                                    7))
                            3
                            -1))]
              (if (or (< pi 0)
                      (!= pi 2))
                  false
                  ; generic metaprograms don't exist; [T] first = not one
                  (let [params (sx-items (sx-at it 2))
                        np (sx-len params)
                        reti 3]
                    (if (>= reti n)
                        false
                        (let [r (sx-at it reti)
                              retok
                                (and (= (sx-tag r) 6)
                                     (and (= (sx-len (sx-items r))
                                             2)
                                          (and (= (sx-tag (sx-at (sx-items r) 0))
                                                  2)
                                               (and (= (sx-sval (sx-at (sx-items r)
                                                                       0))
                                                       "->")
                                                    (code-type-form? (sx-at (sx-items r) 1))))))]
                          (if (not retok)
                              false
                              (let [(mut i) 0
                                    (mut ok) true]
                                (loop (if (or (not (load ok)) (>= (load i) np))
                                          (break)
                                          (do
                                            (let [p (sx-at params (load i))]
                                              (unless (code-signature-parameter? p)
                                                (store! ok false)
                                                0))
                                            (set! i (primitive/iadd (load i) 1)))))
                                (load ok))))))))))))

; recover ONE skipped defn (batched inside it); shared by both triggers
(defn tower-recover-form! [(tc (ptr TowerCx))
                           (s (mut LS))
                           (tf (ptr TaggedForm))] (-> (Result i64 Diag))
  (try (do
         (store! (field tc module) (load (field tf module)))
         (let [nf (try! (tower-parse-rewrite tc (mut s) (field tf form)))]
           (when (!= (load (field tc hit)) 0)
             (tagged-rewrite! tf nf)
             0)
           (Ok [i64 Diag] (load (field tc hit)))))))

; trigger (a): a skipped defn whose RAW signature is Code-shaped IS a metaprogram
; — recover it eagerly (nothing else will ever name it in a diagnostic).
; Skipped ORDINARY defns (the compiler's own try/block/return-from bodies have
; never parsed pre-expansion) are left alone unless trigger (b) demands them.
(defn tower-declaration-rewrite [(tc (ptr TowerCx))
                                 (s (mut LS))
                                 (node (ptr Sexp))
                                 (declarations-only bool)] (-> (Result Sexp
                                                                       Diag))
  (let [a (.a tc)]
    (set! (.hit tc) 0)
    (if (do-bundle? node)
        (let [items (sx-items (load node))
              (mut out) (ArrayList::new [Sexp] a)
              (mut i) 1
              (mut any) false
              (mut failure) (None [Diag])]
          (push! (mut out) (sx-at items 0))
          (loop (if (>= (load i) (sx-len items))
                    (break)
                    (do
                      (let [child (elem items (load i))]
                        (match (tower-declaration-rewrite tc
                                                          (mut s)
                                                          child
                                                          declarations-only)
                          (Ok [next]
                              (do
                                (push! (mut out) next)
                                (when (!= (.hit tc) 0) (set! any true))
                                ; A later sibling may reflect on this declaration.
                                (register-sibling-declaration! next
                                                               (.module tc)
                                                               (.gen_structs tc)
                                                               (.gen_sums tc)
                                                               a)))
                          (Err [d]
                               (do
                                 (set! failure (Some d))
                                 (push! (mut out) (load child))
                                 0))))
                      (set! i (+ (load i) 1)))))
          (if (load any)
              (do
                (set! (.hit tc) 1)
                (Ok [Sexp Diag]
                    (mk-sexp-src (KList (box-al [Sexp] a (load out))) node)))
              (match (load failure)
                (Some [d] (Err [Sexp Diag] d))
                (None [] (Ok [Sexp Diag] (load node))))))
        (match (defn-name-of node)
          (Some [name]
                (if (and (not declarations-only)
                         (and (raw-code-sig? node)
                              (let [found (prog-fn-find (.macroctx tc)
                                                        (qualify-name a name (.module tc)))]
                                ; skipped, or left unparsed and found not to parse
                                (or (= (primitive/cast i64 found) 0)
                                    (lazy-body-failed? found)))))
                    (tower-parse-rewrite tc (mut s) node)
                    (Ok [Sexp Diag] (load node))))
          (None []
                (if (= (sx-tag (load node)) 6)
                    (let [items (sx-items (load node))
                          head (sx-head-name items)]
                      ; `()` has no head, so there is no macro to look for and no
                      ; first element to find its module from.
                      (if (= (sx-len items) 0)
                        (Err [Sexp Diag]
                             (diag-at-form node "`()` is not a top-level form: a form needs a head"))
                      (if (top-level-core-form? head)
                          (Ok [Sexp Diag] (load node))
                          (match (resolve-macro head
                                                (macro-module-of (sx-at items 0)
                                                                 (.module tc))
                                                (.quals tc)
                                                (.impb tc)
                                                (.expb tc)
                                                a)
                            ; A declaration call that fails here is left as written
                            ; for run-expand, which expands every top-level form in
                            ; program order after the before-expand transforms and
                            ; reports the same failure there. Reporting it from the
                            ; tower put it ahead of every error run-expand owns:
                            ; an out-of-scope macro call (the `None` arm below)
                            ; whose missing declaration is what made this call fail.
                            (Some [q] (match (tower-expand-call tc (mut s) node q)
                                        (Ok [out] (Ok [Sexp Diag] out))
                                        (Err [_] (Ok [Sexp Diag] (load node)))))
                            (None [] (Ok [Sexp Diag] (load node)))))))
                    (Ok [Sexp Diag] (load node))))))))

(defn tower-parse-pass [(tc (ptr TowerCx))
                        (s (mut LS))
                        (sub-forms (ptr (ArrayList TaggedForm)))
                        (macroctx (ptr Program))
                        (declarations-only bool)] (-> (Result i64 Diag))
  (let [(mut i) 0
        (mut any) false
        (mut failure) (None [Diag])]
    (loop (if (>= (load i) (len (load sub-forms)))
              (break)
              (do
                (let [form (elem sub-forms (load i))]
                  (set! (.module tc) (.module form))
                  (match (tower-declaration-rewrite tc
                                                    (mut s)
                                                    (field form form)
                                                    declarations-only)
                    (Ok [next]
                        (do
                          (when (!= (.hit tc) 0)
                            (tagged-rewrite! form next)
                            (set! any true))
                          0))
                    (Err [d] (do (set! failure (Some d)) 0))))
                (set! i (+ (load i) 1)))))
    (if (load any)
        (Ok [i64 Diag] 1)
        (if declarations-only
            (Ok [i64 Diag] 0)
            (match (load failure)
              (Some [d] (Err [i64 Diag] d))
              (None [] (Ok [i64 Diag] 0)))))))

; trigger (b): the sub-check failed with a call to a name that matches a SKIPPED
; defn (a metaprogram reached an ordinary helper whose body has macro syntax) —
; recover that helper on demand.
(defn tower-find-head-at [(tc (ptr TowerCx)) (node (ptr Sexp))] (-> (Option (slice u8)))
  (let [tg (sx-tag (load node))]
    (if (not (or (= tg 6) (= tg 7)))
        (None [(slice u8)])
        (let [items (sx-items (load node))
              n (sx-len items)]
          (if (and (= tg 6)
                   (and (= (sx-lo (load node)) (.dlo tc))
                        (and (= (sx-hi (load node)) (.dhi tc))
                             (and (= (sx-source (load node)) (.dsrc tc))
                                  (and (>= n 1)
                                       (= (sx-tag (sx-at items 0))
                                          2))))))
              (Some (sx-sval (sx-at items 0)))
              (let [(mut i) 0
                    (mut r) (None [(slice u8)])]
                (loop (if (>= (load i) n)
                          (break)
                          (do
                            (match (tower-find-head-at tc
                                                       (elem items
                                                             (load i)))
                              (Some [h] (do (set! r (Some h)) (break)))
                              (None [] 0))
                            (set! i (primitive/iadd (load i) 1)))))
                (load r)))))))

(defn tower-recover-called [(tc (ptr TowerCx))
                            (s (mut LS))
                            (sub-forms (ptr (ArrayList TaggedForm)))
                            (macroctx (ptr Program))] (-> (Result i64 Diag))
  (try (do
         (let [a (load (field tc a))
               n (len (load sub-forms))
               (mut headn) (None [(slice u8)])
               (mut i) 0]
           (loop (if (>= (load i) n)
                     (break)
                     (do
                       (match (tower-find-head-at tc
                                                  (field (elem sub-forms
                                                               (load i))
                                                         form))
                         (Some [h]
                               (do
                                 (store! headn (Some h))
                                 (store! (field tc module)
                                         (load (field (elem sub-forms
                                                            (load i))
                                                      module)))
                                 (break)))
                         (None [] 0))
                       (store! i (primitive/iadd (load i) 1)))))
           (match (load headn)
             (None [] (Ok [i64 Diag] 0))
             (Some [h]
                   (let [target
                           (resolve-macro h
                                          (load (field tc module))
                                          (load (field tc allfns))
                                          (load (field tc impb))
                                          (load (field tc expb))
                                          a)
                         (mut j) 0]
                     (loop (if (>= (load j) n)
                               (break)
                               (do
                                 (let [tf
                                         (elem sub-forms
                                               (load j))]
                                   (match (defn-name-of (field tf form))
                                     (None [] 0)
                                     (Some [nm]
                                           (let [q
                                                   (qualify-name a
                                                                 nm
                                                                 (load (field tf
                                                                              module)))
                                                 matches
                                                   (match target
                                                     (Some [resolved]
                                                           (= q resolved))
                                                     (None []
                                                           (let [slash
                                                                   (dep-slash h)]
                                                             (or (= nm h)
                                                                 (and (>= slash
                                                                          0)
                                                                      (= nm
                                                                         (subslice [u8]
                                                                                   h
                                                                                   (primitive/iadd slash
                                                                                                   1)
                                                                                   (len h))))))))]
                                             (unless (or (not matches)
                                                         (!= (primitive/cast i64
                                                                             (prog-fn-find macroctx
                                                                                           q))
                                                             0))
                                               (match (tower-recover-form! tc
                                                                           (mut s)
                                                                           tf)
                                                 (Ok [value] value)
                                                 (Err [error]
                                                      (break :try (Err error))))
                                               0)))))
                                 (store! j (primitive/iadd (load j) 1)))))
                     (Ok [i64 Diag] (load (field tc hit))))))))))

(defn mk-tower-cx [(s (mut LS))
                   (sub-forms (ptr (ArrayList TaggedForm)))
                   (macroctx (ptr Program))
                   (quals (ptr (ArrayList (slice u8))))
                   (a (dyn Allocator))
                   (names-a (dyn Allocator))
                   (dlo i64)
                   (dhi i64)
                   (dsrc i64)] (-> (ptr TowerCx))
  (mk-tower-cx-with-names (mut s)
                          macroctx
                          quals
                          a
                          (all-defn-names-memo sub-forms)
                          dlo
                          dhi
                          dsrc))

;;; `mk-tower-cx` over a module-function list the caller already computed for the
;;; current declarations of the sub-program.
(defn mk-tower-cx-with-names [(s (mut LS))
                              (macroctx (ptr Program))
                              (quals (ptr (ArrayList (slice u8))))
                              (a (dyn Allocator))
                              (allfns (ptr SBox))
                              (dlo i64)
                              (dhi i64)
                              (dsrc i64)] (-> (ptr TowerCx))
  (let [tc (box! a TowerCx (primitive/zeroed TowerCx))
        impb
          (box! a (ArrayList ImpEntry) (primitive/zeroed (ArrayList ImpEntry)))
        expb
          (box! a (ArrayList ExpEntry) (primitive/zeroed (ArrayList ExpEntry)))]
    (set! impb (.imports s))
    (set! expb (.exports s))
    (set! (.a tc) a)
    (set! (.dlo tc) dlo)
    (set! (.dhi tc) dhi)
    (set! (.dsrc tc) dsrc)
    (set! (.macroctx tc) macroctx)
    (set! (.quals tc) quals)
    (set! (.allfns tc) (field allfns items))
    (set! (.impb tc) impb)
    (set! (.expb tc) expb)
    (set! (.module tc) (None [(slice u8)]))
    (set! (.hit tc) 0)
    (set! (.depth tc) 0)
    (set! (.gen_structs tc) (box-al [StructDef] a (ArrayList::new [StructDef] a)))
    (set! (.gen_sums tc) (box-al [SumDef] a (ArrayList::new [SumDef] a)))
    tc))

(defn stage3-parse-recover [(s (mut LS))
                            (sub-forms (ptr (ArrayList TaggedForm)))
                            (macroctx (ptr Program))
                            (quals (ptr (ArrayList (slice u8))))
                            (a (dyn Allocator))
                            (declarations-only bool)] (-> (Result i64 Diag))
  (let [tc (mk-tower-cx (mut s) sub-forms macroctx quals a a -2 -2 -2)
        (mut i) 0]
    ; Declaration macros can invoke registered derivers before run-expand. Seed
    ; the same registry from declarations visible in this tower generation.
    ; An unresolved arm is retried after its declaration has been normalized;
    ; run-expand remains the authoritative registration diagnostic pass.
    (derive-reg-reset!)
    (declared-traits-collect! (mut s) (field s out))
    (unless (= (primitive/cast i64 (.parent s)) 0)
      (let [registrations (field (.parent s) pipeline_forms)]
        (for [ri 0 (len (load registrations))]
          (let [tf (elem registrations ri)]
            (when (is-register-derive-form (field tf form))
              (register-derive-form! (field tf form)
                                     (.module tf)
                                     quals
                                     (.impb tc)
                                     (.expb tc)
                                     a)
              0))))
      0)
    (loop (if (>= (load i) (len (load sub-forms)))
              (break)
              (let [tf (elem sub-forms (load i))]
                (when (is-register-derive-form (field tf form))
                  (register-derive-form! (field tf form)
                                         (.module tf)
                                         quals
                                         (.impb tc)
                                         (.expb tc)
                                         a)
                  0)
                (set! i (+ (load i) 1)))))
    (tower-parse-pass tc (mut s) sub-forms macroctx declarations-only)))

(defn tower-pass [(tc (ptr TowerCx))
                  (s (mut LS))
                  (sub-forms (ptr (ArrayList TaggedForm)))] (-> (Result i64
                                                                        Diag))
  (try (do
         (let [n (len (load sub-forms))
               (mut any) false
               (mut i) 0]
           (loop (if (>= (load i) n)
                     (break)
                     (do
                       (let [tf (elem sub-forms (load i))]
                         (store! (field tc module) (load (field tf module)))
                         (store! (field tc hit) 0)
                         (let [nf
                                 (try! (tower-rewrite tc
                                                      (mut s)
                                                      (field tf form)))]
                           (when (!= (load (field tc hit))
                                     0)
                             (store! any true)
                             (tagged-rewrite! tf nf)
                             0)))
                       (store! i (primitive/iadd (load i) 1)))))
           (store! (field tc hit) (if (load any) 1 0))
           (Ok [i64 Diag] (load (field tc hit)))))))

; Diagnostic recovery used to traverse every syntax node once per diagnostic.
; Large generated modules make that O(nodes × diagnostics), even though a source
; span can only occur in the handful of top-level forms that contain that source.
; Build this small inverted index once per failed generation and restrict each
; rewrite to the relevant forms. A form is indexed under every source present in
; its tree, so mixed-source macro output remains correct.
(defstruct TowerSourceForm [(source i64) (form-index i64)])

(defn tower-source-form-add! [(entries (ptr (ArrayList TowerSourceForm)))
                              (source i64)
                              (form-index i64)] (-> i64)
  (let [n (len (load entries))
        (mut i) (primitive/isub n 1)
        (mut found) false]
    ; Entries are appended in form order. Only the current form's short suffix
    ; can contain this pair; stop as soon as an older form is reached.
    (loop (if (or (load found) (< (load i) 0))
              (break)
              (let [entry (elem entries (load i))]
                (if (!= (.form-index entry) form-index)
                    (break)
                    (if (= (.source entry) source)
                        (set! found true)
                        (set! i (primitive/isub (load i) 1)))))))
    (unless (load found)
      (let [entry (primitive/alloc-stack TowerSourceForm)]
        (store! (field entry source) source)
        (store! (field entry form-index) form-index)
        (push! entries (load entry)))
      0)
    0))

(defn tower-index-node-sources! [(entries (ptr (ArrayList TowerSourceForm)))
                                 (node (ptr Sexp))
                                 (form-index i64)] (-> i64)
  (tower-source-form-add! entries (sx-source (load node)) form-index)
  (let [tag (sx-tag (load node))]
    (when (or (= tag 6) (= tag 7))
      (let [items (sx-items (load node))
            n (sx-len items)
            (mut i) 0]
        (loop (if (>= (load i) n)
                  (break)
                  (do
                    (tower-index-node-sources! entries
                                               (elem items (load i))
                                               form-index)
                    (store! i (primitive/iadd (load i) 1))))))
      0)
    0))

(defn tower-source-index [(a (dyn Allocator))
                          (sub-forms (ptr (ArrayList TaggedForm)))] (-> (ptr (ArrayList TowerSourceForm)))
  (let [(mut entries) (ArrayList::new [TowerSourceForm] a)
        n (len (load sub-forms))
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (tower-index-node-sources! (mut entries)
                                           (field (elem sub-forms
                                                        (load i))
                                                  form)
                                           (load i))
                (set! i (primitive/iadd (load i) 1)))))
    (box-al [TowerSourceForm] a (load entries))))

(defn tower-pass-indexed [(tc (ptr TowerCx))
                          (s (mut LS))
                          (sub-forms (ptr (ArrayList TaggedForm)))
                          (index (ptr (ArrayList TowerSourceForm)))] (-> (Result i64
                                                                                 Diag))
  (try (do
         (let [n (len (load index))
               (mut i) 0
               (mut any) false
               (mut candidates) 0]
           (loop (if (>= (load i) n)
                     (break)
                     (do
                       (let [entry (elem index (load i))]
                         (when (= (load (field entry source))
                                  (load (field tc dsrc)))
                           (let [tf
                                   (elem sub-forms
                                         (load (field entry form-index)))]
                             (store! candidates
                                     (primitive/iadd (load candidates) 1))
                             (store! (field tc module) (load (field tf module)))
                             (store! (field tc hit) 0)
                             (let [nf
                                     (try! (tower-rewrite tc
                                                          (mut s)
                                                          (field tf form)))]
                               (when (!= (load (field tc hit))
                                         0)
                                 (store! any true)
                                 (tagged-rewrite! tf nf)
                                 0)))
                           0))
                       (store! i (primitive/iadd (load i) 1)))))
           (if (= (load candidates) 0)
               (tower-pass tc (mut s) sub-forms)
               (do
                 (store! (field tc hit) (if (load any) 1 0))
                 (Ok [i64 Diag] (load (field tc hit)))))))))

;;; A failed sub-program check can report many independent macro-headed call
;;; sites. Expand all of them against this generation's resolved macro context
;;; before rebuilding that context. Previously stage3-round used only the first
;;; diagnostic and paid for a whole-program resolve once per call site.
(defn tower-recover-diag-with-names [(s (mut LS))
                          (sub-forms (ptr (ArrayList TaggedForm)))
                          (macroctx (ptr Program))
                          (quals (ptr (ArrayList (slice u8))))
                          (diag (ptr Diag))
                          (source-index (ptr (ArrayList TowerSourceForm)))
                          (a (dyn Allocator))
                          (names-a (dyn Allocator))] (-> (Result i64 Diag))
  (try (let [dp diag
             context-span (tr/span-begin "frontend.expand.recover.context")
             tc
               (mk-tower-cx (mut s)
                            sub-forms
                            macroctx
                            quals
                            a
                            names-a
                            (.lo dp)
                            (.hi dp)
                            (.source dp))
             _context-end (tr/span-end context-span)
             pass-span (tr/span-begin "frontend.expand.recover.pass")
             ; End each span before propagating an error: an early return from
             ; inside a span leaves it open, and every later span then nests
             ; under it in the --timings table.
             passed (tower-pass-indexed tc (mut s) sub-forms source-index)
             _pass-end (tr/span-end pass-span)
             hit (try! passed)
             called-span (tr/span-begin "frontend.expand.recover.called")
             called
               (if (= hit 0)
                   (tower-recover-called tc (mut s) sub-forms macroctx)
                   (Ok [i64 Diag] hit))
             _called-end (tr/span-end called-span)
             hit2 (try! called)]
         (Ok [i64 Diag] hit2))))

(defn tower-recover-diag [(s (mut LS))
                          (sub-forms (ptr (ArrayList TaggedForm)))
                          (macroctx (ptr Program))
                          (quals (ptr (ArrayList (slice u8))))
                          (diag (ptr Diag))
                          (source-index (ptr (ArrayList TowerSourceForm)))
                          (a (dyn Allocator))] (-> (Result i64 Diag))
  (let [names-work (primitive/alloc-stack scratch/ScratchArena)
        _names-init (scratch/ScratchArena::init-with-capacity names-work
                                                               (retained-heap/compiler-scratch-parent)
                                                               65536)
        result (tower-recover-diag-with-names (mut s)
                                             sub-forms
                                             macroctx
                                             quals
                                             diag
                                             source-index
                                             a
                                             (allocator names-work))]
    (match result
      (Ok [hit]
          (do
            (close! names-work)
            (Ok [i64 Diag] hit)))
      (Err [d]
           (let [owned (primitive/alloc-stack Diag)]
             (set! owned d)
             (set! (.msg owned) (sconcat a (.msg owned) ""))
             (close! names-work)
             (Err [i64 Diag] (load owned)))))))

(defn tower-pass-diags [(s (mut LS))
                        (sub-forms (ptr (ArrayList TaggedForm)))
                        (macroctx (ptr Program))
                        (quals (ptr (ArrayList (slice u8))))
                        (diags (ptr (ArrayList Diag)))
                        (a (dyn Allocator))] (-> (Result i64 Diag))
  ; The source-to-form index is read only by this diagnostic pass. Rebuilding
  ; it for every failed tower generation must not retain its backing storage
  ; in the compilation's persistent semantic arena.
  (let [index-work (primitive/alloc-stack scratch/ScratchArena)
        _index-init (scratch/ScratchArena::init-with-capacity index-work
                                                              (retained-heap/compiler-scratch-parent)
                                                              65536)
        index-a (allocator index-work)
        n (len (load diags))
        source-index (tower-source-index index-a sub-forms)
        (mut i) 0
        (mut any) false
        (mut failure) (None [Diag])]
      (loop (if (>= (load i) n)
                (break)
                (do
                  (match (tower-recover-diag (mut s)
                                             sub-forms
                                             macroctx
                                             quals
                                             (elem diags (load i))
                                             source-index
                                             a)
                    (Ok [hit] (do (when (!= hit 0) (set! any true)) 0))
                    ; Recovering this diagnostic can fail for a reason that is itself
                    ; recoverable: expanding a macro call first stages that macro, and
                    ; the staging check can stop in an unexpanded callee (a `const`
                    ; initializer's macro reached before any function body was
                    ; checked). That failure carries the callee's diagnostic, so
                    ; recover it; the next round then stages the macro.
                    (Err [d]
                         (let [dp (primitive/alloc-stack Diag)]
                           (store! dp d)
                           (match (tower-recover-diag (mut s)
                                                      sub-forms
                                                      macroctx
                                                      quals
                                                      dp
                                                      source-index
                                                      a)
                             (Ok [hit]
                                 (if (!= hit 0)
                                     (do (set! any true) 0)
                                     (do (set! failure (Some d)) 0)))
                             (Err [_] (do (set! failure (Some d)) 0))))))
                  (set! i (primitive/iadd (load i) 1)))))
      (let [result
              (if (load any)
                  (Ok [i64 Diag] 1)
                  (match (load failure)
                    (Some [d] (Err [i64 Diag] d))
                    (None [] (Ok [i64 Diag] 0))))]
        (close! index-work)
        result)))

; ---- LAZY per-qual macro STAGING (interp deletion step 5, Phase B) ----------------
; The engine is grown ON DEMAND: stage3-round only RECORDS the round's sub-forms in
; a box (free), and the first time finish-macro misses a qual — which for almost
; every program is NEVER, and for the bootstrap is exactly the two dbg-slice-*
; tower expansions — stage-one-macro! builds THAT qual's pruned closure
; (impls/consts dropped, see closure-funcs-pruned), checks it standalone, and
; compiles it into the engine additively. An eager prepass was measured 2.7x slower
; cold across the corpus (one dylib per qual per file, ~20x the cc forks) for zero
; benefit on programs whose batch check passes round 0 — i.e. nearly all of them.
; The private resolve of the recorded sub-forms happens once per round, only on the
; first miss, so its check-program passes never touch the Program the batch path
; checks (closure-subprogram bodies are SHARED — see INTERP_DELETION.md Landmines).
(defstruct StageBox
  [(isset i64)
   (resolved i64)
   (sub-forms (ptr (ArrayList TaggedForm)))
   (imports (ArrayList ImpEntry))
   (exports (ArrayList ExpEntry))
   (primitive_defs (ArrayList PrimitiveDef))
   (primitive_aliases (ArrayList PrimitiveAlias))
   (excluded (ptr (ArrayList (slice u8))))
   (mctx (ptr Program))
   ; `(prog-fn-names mctx)`, built on the first staging that needs it; every
   ; qual this generation stages walks the same program's names.
   (mctx_names (ptr FnNames))
   (semantic_workspace (ptr SemanticWorkspaceSlot))
   (semantic_audit (ptr SemanticAudit))
   (a (dyn Allocator))
   ; Quals this generation could not stage, with the reason. Staging a qual
   ; depends only on the generation's resolved context, so a second attempt
   ; repeats the same closure check to the same failure. The tower's local
   ; convergence can reach one unstageable macro at hundreds of call sites.
   (failed_quals (ArrayList (slice u8)))
   (failed_diags (ArrayList Diag))
   (parent (ptr LS))])

(defn stage-box [] (-> (ptr StageBox))
  (field (expander-unit-state) stages))

(defn stage-box-set! [(s (mut LS))
                      (sub-forms (ptr (ArrayList TaggedForm)))
                      (excluded (ptr (ArrayList (slice u8))))
                      (resolved-context (ptr Program))
                      (a (dyn Allocator))] (-> i64)
  (let [b (stage-box)]
    (set! (.parent b) (ls-meta-parent (mut s)))
    (set! (.sub-forms b) sub-forms)
    (set! (.imports b) (.imports s))
    (set! (.exports b) (.exports s))
    (set! (.primitive_defs b) (.primitive_defs s))
    (set! (.primitive_aliases b) (.primitive_aliases s))
    (set! (.semantic_workspace b) (.semantic_workspace s))
    (set! (.semantic_audit b) (.semantic_audit s))
    (set! (.excluded b) excluded)
    (set! (.a b) a)
    (set! (.resolved b) 1)
    (set! (.mctx b) (if (= (primitive/cast i64 resolved-context) 0)
                        resolved-context
                        (with-constant-lengths a resolved-context)))
    (set! (.mctx_names b) (primitive/cast (ptr FnNames) 0))
    (set! (.failed_quals b) (ArrayList::new [(slice u8)] a))
    (set! (.failed_diags b) (ArrayList::new [Diag] a))
    (set! (.isset b) 1)
    0))

(defn stage-box-known-failure [(b (ptr StageBox)) (q (slice u8))] (-> (Option Diag))
  (let [(mut found) (None [Diag])]
    (for [i 0 (len (.failed_quals b))]
      (when (= (get (.failed_quals b) i) q)
        (set! found (Some (get (.failed_diags b) i)))
        0)
      0)
    (load found)))

; resolve the recorded forms once per round (memoized until the next stage-box-set!)
(defn stage-box-mctx [] (-> (ptr Program))
  (let [b (stage-box)]
    (if (= (.isset b) 0)
        (primitive/cast (ptr Program) 0)
        (if (!= (.resolved b) 0)
            (load (field b mctx))
            (let [a (.a b)
                  subls (primitive/alloc-stack LS)]
              (ls-init! (mut subls) a)
              (set! (.parent subls) (.parent b))
              (set! (.out subls) (load (load (field b sub-forms))))
              (set! (.loaded subls) (ArrayList::new [(slice u8)] a))
              (set! (.readpaths subls) (ArrayList::new [(slice u8)] a))
              (set! (.readmods subls) (ArrayList::new [(slice u8)] a))
              (set! (.imports subls) (.imports b))
              (set! (.exports subls) (.exports b))
              (set! (.primitive_defs subls) (.primitive_defs b))
              (set! (.primitive_aliases subls) (.primitive_aliases b))
              (set! (.semantic_workspace subls) (.semantic_workspace b))
              (set! (.semantic_audit subls) (.semantic_audit b))
              (set! (.resolved b) 1)
              (match (resolve-program a (mut subls) false true)
                (Err [d]
                     (do
                       (set! (.mctx b) (primitive/cast (ptr Program) 0))
                       (primitive/cast (ptr Program) 0)))
                (Ok [mctx] (do (set! (.mctx b) (with-constant-lengths a mctx)) (.mctx b)))))))))

;;; The function-name index of the stage box's macro context MCTX.
(defn stage-box-mctx-names [(mctx (ptr Program))] (-> (ptr FnNames))
  (let [b (stage-box)]
    (when (= (primitive/cast i64 (.mctx_names b)) 0)
      (set! (.mctx_names b) (prog-fn-names mctx (.a b)))
      0)
    (.mctx_names b)))

; Stage exactly one qual through the early pruned closure. That closure retains
; foundational trait impls and their method bodies, but deliberately excludes
; application impls whose bodies may still contain definition-time macro calls.
; (None) = staged; (Some d) = could not stage, and `d` says WHY.
(defn stage-one-macro! [(q (slice u8))] (-> (Option Diag))
  ; Staging compiles host code, though a cross build may reach it while the
  ; program's expansion has every target question answering for the target.
  (if (cross-build?)
      (let [target (target-cell-swap! (host-target-cell))
            result (stage-one-macro-cached! q)]
        (target-cell-swap! target)
        result)
      (stage-one-macro-cached! q)))

(defn stage-one-macro-cached! [(q (slice u8))] (-> (Option Diag))
  (let [b (stage-box)]
    (if (= (.isset b) 0)
        (stage-one-macro-uncached! q)
        (match (stage-box-known-failure b q)
          (Some [d] (Some d))
          (None []
                (match (stage-one-macro-uncached! q)
                  (None [] (None [Diag]))
                  (Some [d]
                        (do
                          (push! (mut (.failed_quals b)) (sconcat (.a b) q ""))
                          (push! (mut (.failed_diags b)) d)
                          (Some d)))))))))

(defn stage-one-macro-uncached! [(q (slice u8))] (-> (Option Diag))
  ; An unavailable dependency can make the tower retry this staging operation
  ; in several generations. Its failed closure/checker work is not part of the
  ; accepted program. Keep that work separately owned, retaining it only when
  ; an installed engine can still refer to its checked declarations.
  (let [work (box! (unit-allocator) scratch/ScratchArena
                   (primitive/zeroed scratch/ScratchArena))
        _init (scratch/ScratchArena::init-with-capacity work
                 (retained-heap/compiler-scratch-parent) 65536)
        _own (unit-resource-kinded! (primitive/cast (ptr i8) work)
                (primitive/fnptr-of release-stage3-arena)
                UNIT-RESOURCE-EXPANSION-ARENA)]
    (match (stage-one-macro-work! q (allocator work))
      (None [] (None [Diag]))
      (Some [d]
        (let [owned (primitive/alloc-stack Diag)]
          (set! owned d)
          (set! (.msg owned) (sconcat (.a (stage-box)) (.msg d) ""))
          (close! work)
          (Some (load owned)))))))

(defn stage-one-macro-work! [(q (slice u8)) (a (dyn Allocator))] (-> (Option Diag))
  (let [b (stage-box)
        excluded (load (field b excluded))]
    (if (and (!= (primitive/cast i64 excluded) 0)
             (set-contains excluded q))
        (Some (derr (sconcat3 (.a b)
                              "read-phase entry '"
                              q
                              "' cannot run during definition-time expansion")))
        (let [mctx (stage-box-mctx)]
          (if (= (primitive/cast i64 mctx) 0)
              (Some (derr "the metaprogram staging context is not initialized (compiler bug)"))
              (let [(mut seedl) (ArrayList::new [(slice u8)] a)]
                (push! (mut seedl) q)
                (let [seeds
                        (meta-shim-seeds a
                                         mctx
                                         (box-al [(slice u8)] a (load seedl)))
                      wanted (closure-funcs-pruned mctx (stage-box-mctx-names mctx) seeds a)
                      ; Checking may rewrite expressions and parameter storage.
                      ; Never let a failed scratch check mutate the source context.
                      sub (semantic-clone-program a
                              (closure-subprogram-pruned mctx wanted a))
                      checkls (primitive/alloc-stack LS)
                      (mut squal) (ArrayList::new [(slice u8)] a)]
                  (push! (mut squal) q)
                  (ls-init! (mut checkls) a)
                  (set! (.parent checkls) (.parent b))
                  (set! (.out checkls) (ArrayList::new [TaggedForm] a))
                  (set! (.loaded checkls) (ArrayList::new [(slice u8)] a))
                  (set! (.readpaths checkls) (ArrayList::new [(slice u8)] a))
                  (set! (.readmods checkls) (ArrayList::new [(slice u8)] a))
                  ; The closure's code is the program's, and its trait methods
                  ; are in scope as the program's imports refer them.
                  (set! (.imports checkls) (ls-copy-list [ImpEntry] a (.imports b)))
                  (set! (.exports checkls) (ls-copy-list [ExpEntry] a (.exports b)))
                  (set! (.primitive_defs checkls) (ArrayList::new [PrimitiveDef] a))
                  (set! (.primitive_aliases checkls)
                        (ArrayList::new [PrimitiveAlias] a))
                  (set! (.check_diags checkls)
                        (box-al [Diag] a (ArrayList::new [Diag] a)))
                  (set! (.resolve_diags checkls)
                        (primitive/cast (ptr (ArrayList Diag)) 0))
                  (set! (.resolve_poisoned checkls)
                        (primitive/cast (ptr (ArrayList (slice u8))) 0))
                  ; Both failure arms used to bind the diagnostic and drop it on the floor,
                  ; returning a bare `false`. The caller then reported only "could not be
                  ; compiled into the metaprogram engine", pointed at whichever call site
                  ; happened to trigger staging — so the one fact needed to fix it, WHY the
                  ; standalone check or the engine build rejected the closure, never reached
                  ; the user. Carry it out instead.
                  ; The closure check is a SCRATCH pass: it must not disturb the
                  ; authoritative S0-S3 semantic maps, which are still serving
                  ; type-of/code-decl/binding-of when staging happens lazily inside
                  ; a metaprogram invocation (e.g. a code->code main staged at
                  ; `coil run` invoke time). Snapshot around it.
                  ; Its maps are dead once the engine is built and the
                  ; outer ones are back, so they get an arena of their own.
                  (let [snap (primitive/alloc-stack SemMapsSnap)
                        tables (primitive/alloc-stack scratch/ScratchArena)]
                    (sem-maps-save snap)
                    (scratch/ScratchArena::init-with-capacity tables (retained-heap/compiler-scratch-parent) 65536)
                    (let [prior-tables (sem-tables-allocator-enter! (allocator tables))
                          ck (check-program a sub (mut checkls))
                          _tables (sem-tables-allocator-leave! prior-tables)
                          result
                            (match ck
                              (Ok [checked]
                                  ; Metalowering consumes the types recorded by this
                                  ; scratch check. Build the engine before restoring
                                  ; the authoritative outer maps, just like the full
                                  ; stage and cumulative-stage paths do.
                                  (let [setup
                                          (meta-engine-setup (.a b)
                                                             checked
                                                             (box-al [(slice u8)]
                                                                     a
                                                                     (load squal)))]
                                    (match setup
                                      (Some [d] (Some d))
                                      (None [] (None [Diag])))))
                              (Err [d] (Some d)))]
                      (sem-maps-restore snap)
                      (close! tables)
                      result)))))))))

; `defderive` has to become ordinary Code-signed defns BEFORE stage3 discovers
; macros with `code-sig-funcs`.  It is syntax sugar only: the emitted
; `register-derive` is the sole act that makes either generated function a
; deriver.  Their names are intentionally arbitrary implementation details.
(defn defderive-form? [(f (ptr Sexp))] (-> bool)
  (and (= (sx-tag (load f)) 6)
       (let [it (sx-items (load f))]
         (and (>= (sx-len it) 2)
              (and (= (sx-tag (sx-at it 0)) 2)
                   (= (sx-sval (sx-at it 0)) "defderive"))))))

(defn defderive-arm [(it (ptr (ArrayList Sexp))) (name (slice u8))] (-> (ptr Sexp))
  (let [n (sx-len it)
        (mut i) 2
        (mut out) (primitive/cast (ptr Sexp) 0)]
    (loop (if (>= (load i) n)
              (break)
              (do
                (let [x (elem it (load i))]
                  (when (and (= (sx-tag (load x)) 6)
                             (let [xs (sx-items (load x))]
                               (and (>= (sx-len xs) 2)
                                    (and (= (sx-tag (sx-at xs 0))
                                            2)
                                         (= (sx-sval (sx-at xs 0)) name)))))
                    (store! out x)
                    (break)))
                (set! i (primitive/iadd (load i) 1)))))
    (load out)))

(defn defderive-push! [(out (ptr (ArrayList TaggedForm)))
                       (module (Option (slice u8)))
                       (form Sexp)] (-> i64)
  (push! [TaggedForm] out (mk-tagged form module))
  0)

;;; `[T]` in an arm is intentionally concise; the desugared comptime function
;;; takes the corresponding `[(T Code)]` parameter vector.
(defn defderive-params [(a (dyn Allocator)) (arm (ptr Sexp))] (-> Sexp)
  (let [xs (sx-items (load arm))
        raw (sx-at xs 1)
        ps (sx-items raw)
        n (sx-len ps)
        (mut out) (ArrayList::new [Sexp] a)
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (if (and (= (sx-tag (sx-at ps (load i))) 2)
                       (= (sx-sval (sx-at ps (load i))) "&"))
                  (do
                    (push! (mut out) (sx-sym "&"))
                    (let [(mut p) (ArrayList::new [Sexp] a)]
                      (push! (mut p) (sx-at ps (primitive/iadd (load i) 1)))
                      (push! (mut p) (sx-sym (builtin-code-type-name (TCode))))
                      (push! (mut out) (sx-mklist (box-al [Sexp] a (load p)))))
                    (set! i (primitive/iadd (load i) 2)))
                  (let [(mut p) (ArrayList::new [Sexp] a)]
                    (push! (mut p) (sx-at ps (load i)))
                    (push! (mut p) (sx-sym (builtin-code-type-name (TCode))))
                    (push! (mut out) (sx-mklist (box-al [Sexp] a (load p))))
                    (set! i (primitive/iadd (load i) 1))))))
    (mk-sexp (KVec (box-al [Sexp] a (load out))) -1 -1)))

(defn defderive-desugar! [(s (mut LS))] (-> (Option Diag))
  (let [a (.a s)
        old (box-al [TaggedForm] a (.out s))
        (mut out) (ArrayList::new [TaggedForm] a)
        n (len (load old))
        (mut i) 0
        (mut errf) (None [Diag])]
    (loop (if (or (diag-some? (load errf)) (>= (load i) n))
              (break)
              (do
                (let [tf (elem old (load i))
                      f (field tf form)]
                  (if (not (defderive-form? f))
                      (push! (mut out) (load tf))
                      (let [it (sx-items (load f))]
                        (if (or (!= (sx-tag (sx-at it 1))
                                    2)
                                (< (sx-len it) 3))
                            (set! errf
                                  (Some (derr "defderive: expected (defderive Trait (struct [T] BODY...) (sum [T] BODY...))")))
                            (let [trait (sx-sval (sx-at it 1))
                                  sa (defderive-arm it "struct")
                                  ua (defderive-arm it "sum")]
                              (if (and (= (primitive/cast i64 sa)
                                          0)
                                       (= (primitive/cast i64 ua)
                                          0))
                                  (set! errf
                                        (Some (derr "defderive: needs at least one struct or sum arm")))
                                  (let [sn (sconcat a "__derive_struct_" trait)
                                        un (sconcat a "__derive_sum_" trait)
                                        owner
                                          (match (.module tf)
                                            (Some [m] m)
                                            (None [] ""))
                                        qsn
                                          (if (= owner "")
                                              sn
                                              (sconcat3 a owner "." sn))
                                        qun
                                          (if (= owner "")
                                              un
                                              (sconcat3 a owner "." un))]
                                    (when (!= (primitive/cast i64 sa)
                                              0)
                                      (let [xs (sx-items (load sa))
                                            (mut ds) (ArrayList::new [Sexp] a)
                                            m (sx-len xs)
                                            (mut j) 2]
                                        (push! (mut ds) (sx-sym "defn*"))
                                        (push! (mut ds) (sx-sym sn))
                                        (push! (mut ds) (defderive-params a sa))
                                        (let [(mut ret) (ArrayList::new [Sexp] a)]
                                          (push! (mut ret) (sx-sym "->"))
                                          (push! (mut ret) (sx-sym (builtin-code-type-name (TCode))))
                                          (push! (mut ds)
                                                 (sx-mklist (box-al [Sexp]
                                                                    a
                                                                    (load ret)))))
                                        (loop (if (>= (load j) m)
                                                  (break)
                                                  (do
                                                    (push! (mut ds)
                                                           (sx-at xs (load j)))
                                                    (store! j
                                                            (primitive/iadd (load j)
                                                                            1)))))
                                        (defderive-push! (mut out)
                                                         (load (field tf module))
                                                         (sx-mklist (box-al [Sexp]
                                                                            a
                                                                            (load ds))))))
                                    (when (!= (primitive/cast i64 ua)
                                              0)
                                      (let [xs (sx-items (load ua))
                                            (mut ds) (ArrayList::new [Sexp] a)
                                            m (sx-len xs)
                                            (mut j) 2]
                                        (push! (mut ds) (sx-sym "defn*"))
                                        (push! (mut ds) (sx-sym un))
                                        (push! (mut ds) (defderive-params a ua))
                                        (let [(mut ret) (ArrayList::new [Sexp] a)]
                                          (push! (mut ret) (sx-sym "->"))
                                          (push! (mut ret) (sx-sym (builtin-code-type-name (TCode))))
                                          (push! (mut ds)
                                                 (sx-mklist (box-al [Sexp]
                                                                    a
                                                                    (load ret)))))
                                        (loop (if (>= (load j) m)
                                                  (break)
                                                  (do
                                                    (push! (mut ds)
                                                           (sx-at xs (load j)))
                                                    (store! j
                                                            (primitive/iadd (load j)
                                                                            1)))))
                                        (defderive-push! (mut out)
                                                         (load (field tf module))
                                                         (sx-mklist (box-al [Sexp]
                                                                            a
                                                                            (load ds))))))
                                    (let [(mut rs) (ArrayList::new [Sexp] a)]
                                      (push! (mut rs)
                                             (sx-sym "register-derive"))
                                      (push! (mut rs) (sx-sym trait))
                                      (when (!= (primitive/cast i64 sa)
                                                0)
                                        (push! (mut rs)
                                               (mk-sexp (KKw "struct") -1 -1))
                                        (push! (mut rs) (sx-sym qsn)))
                                      (when (!= (primitive/cast i64 ua)
                                                0)
                                        (push! (mut rs)
                                               (mk-sexp (KKw "sum") -1 -1))
                                        (push! (mut rs) (sx-sym qun)))
                                      (defderive-push! (mut out)
                                                       (.module tf)
                                                       (sx-mklist (box-al [Sexp]
                                                                          a
                                                                          (load rs))))))))))))
                (set! i (primitive/iadd (load i) 1)))))
    (match (load errf)
      (Some [d] (Some d))
      (None [] (do (set! (.out s) (load out)) (None [Diag]))))))

(defn expand-stage3-except-mode [(s (mut LS))
                                 (excluded (ptr (ArrayList (slice u8))))
                                 (exclude-closure bool)] (-> (Result i64 Diag))
  (macro-config-reset!)
  (expand-stage3-resume (mut s)
                        excluded
                        exclude-closure
                        (primitive/cast (ptr (ArrayList TaggedForm)) 0)
                        (primitive/cast (ptr (ArrayList TaggedForm)) 0)))

;;; Seed the tower's working copy from an abandoned generation of stage 3.
;;; PRIOR-AUTHORED is that generation's authored snapshot and PRIOR-NORMALIZED its
;;; working copy, index-aligned. A form of SUB-FORMS (only the first N: the shim
;;; follows them) whose syntax is unchanged takes the prior normalized version,
;;; so the definition-time rewrites the tower already made are not made again.
;;; True when any form was rewritten there.
(defn tower-resume-forms! [(a (dyn Allocator))
                           (sub-forms (ptr (ArrayList TaggedForm)))
                           (n i64)
                           (prior-authored (ptr (ArrayList TaggedForm)))
                           (prior-normalized (ptr (ArrayList TaggedForm)))] (-> bool)
  (let [(mut head) (ArrayList::new [TaggedForm] a)
        (mut rewritten) 0]
    (for [i 0 n]
      (push! (mut head) (get (load sub-forms) i)))
    (reuse-normalized-forms! a (box-al [TaggedForm] a (load head)) prior-authored prior-normalized)
    (for [i 0 n]
      (let [seeded (elem (mut head) i)]
        (when (!= (.revision seeded) (.revision (elem sub-forms i)))
          (set! rewritten (+ (load rewritten) 1))
          0)
        (set! (elem sub-forms i) (load seeded))))
    (tr/count "expand.stage3.resumed-forms" (load rewritten))
    (> (load rewritten) 0)))

;;; Stage 3, resuming from an abandoned generation when PRIOR-AUTHORED is not null
;;; (see `tower-resume-forms!`).
;;; Library modules' compile-time code a stage can link instead of compiling: the
;;; driver installs it (compile-time units, artifact_provider.coil), since this
;;; module cannot reach the artifacts. Run at the start of every stage 3, before
;;; the program is snapshotted: it puts each unit's macros into the engine and a
;;; declaration in place of each function the unit compiled.
(defstruct CtUnitsHook [(isset i64) (fp (fnptr (cc/C) [(ptr LS)] i64))])

(defn ct-units-hook [] (-> (ptr CtUnitsHook))
  (primitive/alloc-static CtUnitsHook))

(defn set-ct-units-hook! [(fp (fnptr (cc/C) [(ptr LS)] i64))] (-> i64)
  (set! (.fp (ct-units-hook)) fp)
  (set! (.isset (ct-units-hook)) 1)
  0)

(defn expand-stage3-resume [(s (mut LS))
                            (excluded (ptr (ArrayList (slice u8))))
                            (exclude-closure bool)
                            (prior-authored (ptr (ArrayList TaggedForm)))
                            (prior-normalized (ptr (ArrayList TaggedForm)))] (-> (Result i64 Diag))
  ; Stage 3 runs top-level macros — every declaration macro such as `defprop` —
  ; before `run-expand` does. Without the source table installed here, a macro's
  ; `(primitive/code-file …)` and `(primitive/code-line …)` of its own arguments
  ; answered "" and 0, so every property failure reported `at :0` and a reproduce
  ; command with no file in it.
  (set-cli-sources (field s sources))
  (if (and (cross-build?) (not (.host_role s)))
    (expand-stage3-cross (mut s) excluded exclude-closure)
  (block :stage3
  (let [a (.a s)
        desugar-span (tr/span-begin "frontend.expand.derive-desugar")
        (mut errf) (defderive-desugar! (mut s))
        _desugar-end (tr/span-end desugar-span)]
    (match (load errf)
      (Some [d] (Err [i64 Diag] d))
      (None []
            ; after the derive desugaring: the definitions it writes are a
            ; module's compile-time code as much as the ones written by hand
            (when (!= (.isset (ct-units-hook)) 0)
              (primitive/call-ptr (.fp (ct-units-hook)) (primitive/cast (ptr LS) (mut s)))
              0)
            (let [out-forms (box-al [TaggedForm] a (.out s))
                  _reserved (match (reserved-type-definition a out-forms)
                              (Some [d] (return-from :stage3 (Err [i64 Diag] d)))
                              (None [] 0))
                  _aliases (macro-aliases-collect! (mut s) out-forms)
                  snapshot-span (tr/span-begin "frontend.expand.meta-snapshot")
                  authored (tower-snapshot-shallow a out-forms (len (load out-forms)))
                  original-metas (tower-meta-snapshot a out-forms)
                  _snapshot-end (tr/span-end snapshot-span)
                  subforms-span (tr/span-begin "frontend.expand.meta-subforms")
                  subforms-result (meta-sub-forms-sharing a (mut s) out-forms)
                  _subforms-end (tr/span-end subforms-span)]
              ; the macro context is the WHOLE program (tolerant resolve skips the
              ; not-yet-expanded top-level macro calls), in a FRESH form list: the shim and
              ; the tower replace sub-program entries; s.out must stay untouched.
              (match subforms-result
                (Err [d] (Err [i64 Diag] d))
                (Ok [sub-forms]
                    (let [resumed
                            (and (!= (primitive/cast i64 prior-authored) 0)
                                 (tower-resume-forms! a
                                                      sub-forms
                                                      (len (load out-forms))
                                                      prior-authored
                                                      prior-normalized))
                          round-span
                            (tr/span-begin "frontend.expand.stage3-rounds")
                          result
                            (stage3-round (mut s)
                                          sub-forms
                                          a
                                          0
                                          (len (load out-forms))
                                          authored
                                          original-metas
                                          excluded
                                          exclude-closure
                                          resumed)
                          _round-end (tr/span-end round-span)]
                      result))))))))))

; ── the host stage of a cross build ───────────────────────────────────────────
; Code that runs inside the compiler -- macros, `(meta …)` generators, transforms
; and checkers -- runs on the host. When the target is the host's own platform,
; one expansion serves both it and the program. In a cross build every target
; question (`target-os`, `target-arch`, the width of `usize`) has two answers,
; so the compiler code is expanded, checked and built in a compilation of its own,
; the HOST TWIN, with those questions answering for the host and its own semantic
; workspace, and the program is expanded for its target and calls into the twin's
; engine. This is the split Rust makes for proc macros and Racket for phases. The
; twin runs ordinary stage 3; it records what the program needs instead of
; expanding the program (`host-stage-record!`).

;;; What the host twin hands the program. Lives as long as the program's
;;; compilation; its workspace is reused by every stage-3 generation.
(defstruct HostStage
  [(done bool)
   (authored (ptr (ArrayList TaggedForm)))
   (normalized (ptr (ArrayList TaggedForm)))
   (quals (ptr (ArrayList (slice u8))))
   (compile_time (ptr (ArrayList (slice u8))))
   ; Every function compile-time code reaches, host-expanded in `normalized`.
   (closure (ptr (ArrayList (slice u8))))
   (checked (ptr Program))
   (semantic_workspace (ptr SemanticWorkspaceSlot))
   (semantic_audit (ptr SemanticAudit))
   ; The program's phase analysis and the forms it left to the host (see
   ; `host-stage-leave!`). Null until the first generation decides.
   (phase (ptr PhaseCx))
   (host_forms (ptr (ArrayList TaggedForm)))
   ; The import and export tables as they were then. The program rebuilds its own
   ; from its forms, which no longer hold those modules' imports and exports.
   (host_imports (ptr (ArrayList ImpEntry)))
   (host_exports (ptr (ArrayList ExpEntry)))])

;;; A semantic workspace for compiling S's code for the host: a form parsed for
;;; the host (a 64-bit `usize`, say) must never be the cached parse the program's
;;; resolve finds for the same form. It compiles the same entry module.
(defn host-workspace-slot [(s (mut LS))] (-> (ptr SemanticWorkspaceSlot))
  (let [a (.a s)
        slot (box! a SemanticWorkspaceSlot (primitive/zeroed SemanticWorkspaceSlot))
        target-ws (semantic-workspace (mut s))
        ; semantic-workspace reads only the slot of the LS it is given.
        holder (primitive/alloc-stack LS)]
    (set! (.owner slot) a)
    (set! (.semantic_workspace holder) slot)
    (let [ws (semantic-workspace (mut holder))]
      (set! (.entry_module ws) (.entry_module target-ws))
      (set! (.unit_entry ws) (.unit_entry target-ws)))
    slot))

;;; S's host stage, made on first use with a workspace of its own that every
;;; stage-3 generation of the twin reuses.
(defn host-stage-of [(s (mut LS))] (-> (ptr HostStage))
  (if (!= (primitive/cast i64 (.host_stage s)) 0)
      (primitive/cast (ptr HostStage) (.host_stage s))
      (let [a (.a s)
            hs (box! a HostStage (primitive/zeroed HostStage))]
        (set! (.semantic_workspace hs) (host-workspace-slot (mut s)))
        (set! (.semantic_audit hs) (box! a SemanticAudit (primitive/zeroed SemanticAudit)))
        (set! (.host_stage s) (primitive/cast (ptr i8) hs))
        hs)))

;;; S's import table with the entries of the modules S left to HS, which the host's
;;; view of the program still holds.
(defn host-imports [(s (mut LS)) (hs (ptr HostStage))] (-> (ArrayList ImpEntry))
  (let [a (.a s)
        (mut out) (ls-copy-list [ImpEntry] a (.imports s))]
    (unless (= (primitive/cast i64 (.host_imports hs)) 0)
      (for [i 0 (len (load (.host_imports hs)))]
        (let [e (elem (.host_imports hs) i)]
          (unless (block :has
                    (for [k 0 (len (load out))]
                      (when (= (.name (elem (mut out) k)) (.name e)) (break :has true)))
                    false)
            (push! (mut out) (load e))
            0)))
      0)
    (load out)))

;;; The same for the export table.
(defn host-exports [(s (mut LS)) (hs (ptr HostStage))] (-> (ArrayList ExpEntry))
  (let [a (.a s)
        (mut out) (ls-copy-list [ExpEntry] a (.exports s))]
    (unless (= (primitive/cast i64 (.host_exports hs)) 0)
      (for [i 0 (len (load (.host_exports hs)))]
        (let [e (elem (.host_exports hs) i)]
          (unless (block :has
                    (for [k 0 (len (load out))]
                      (when (= (.name (elem (mut out) k)) (.name e)) (break :has true)))
                    false)
            (push! (mut out) (load e))
            0)))
      0)
    (load out)))

;;; A host twin of S for one stage-3 run: S's tables, a copy of its forms, and the
;;; host stage's workspace. The copies are new forms: an identity shared with the
;;; program's would let the two workspaces' cached parses stand in for each other.
(defn host-twin [(s (mut LS)) (hs (ptr HostStage))] (-> (ptr LS))
  (let [a (.a s)
        h (box! a LS (load s))
        (mut all) (ls-copy-list [TaggedForm] a (.out s))
        _left (when (!= (primitive/cast i64 (.host_forms hs)) 0)
                (for [i 0 (len (load (.host_forms hs)))]
                  (push! (mut all) (get (load (.host_forms hs)) i)))
                0)
        forms (tower-snapshot a (box-al [TaggedForm] a (load all)) (len (load all)))]
    (for [i 0 (len (load forms))]
      (let [tf (elem forms i)]
        (set! (.form_id tf) (next-form-id))
        (set! (.revision tf) 0)
        (set! (.cached_shape tf) 0)))
    (set! (.out h) (load forms))
    (set! (.imports h) (host-imports (mut s) hs))
    (set! (.exports h) (host-exports (mut s) hs))
    (set! (.pipeline_forms h) (ls-copy-list [TaggedForm] a (.pipeline_forms s)))
    (set! (.semantic_workspace h) (.semantic_workspace hs))
    (set! (.semantic_audit h) (.semantic_audit hs))
    (set! (.host_stage h) (primitive/cast (ptr i8) hs))
    (set! (.host_role h) true)
    (set! (.host_defined h) (primitive/cast (ptr (ArrayList (slice u8))) 0))
    h))

;;; What the twin's stage 3 leaves for the program: its macro engine is already
;;; built (the engine is per compilation), and these are the rest of what the
;;; program's expansion needs.
(defn host-stage-record! [(s (mut LS))
                          (authored (ptr (ArrayList TaggedForm)))
                          (normalized (ptr (ArrayList TaggedForm)))
                          (quals (ptr (ArrayList (slice u8))))
                          (compile-time (ptr (ArrayList (slice u8))))
                          (closure (ptr (ArrayList (slice u8))))
                          (checked (ptr Program))] (-> (Result i64 Diag))
  (let [hs (primitive/cast (ptr HostStage) (.host_stage s))]
    (set! (.authored hs) authored)
    (set! (.normalized hs) normalized)
    (set! (.quals hs) quals)
    (set! (.compile_time hs) compile-time)
    (set! (.closure hs) closure)
    (set! (.checked hs) checked)
    (set! (.done hs) true)
    (Ok [i64 Diag] 0)))

;;; Take back what the twin's run added to tables the program shares: the
;;; expansion and source records its rewritten syntax points into, and the
;;; checked metaprogram environment later stages build on.
(defn host-stage-adopt! [(s (mut LS)) (h (ptr LS))] (-> i64)
  (set! (.expansions s) (.expansions h))
  (set! (.expansion_free_from s) (.expansion_free_from h))
  (set! (.sources s) (.sources h))
  (set! (.srccount s) (.srccount h))
  (set! (.meta_environment s) (.meta_environment h))
  0)

;;; FORMS with each definition named in WHICH replaced by the twin's expansion of
;;; it, under FORMS' own form identity.
(defn host-normalized [(a (dyn Allocator))
                       (authored (ptr (ArrayList TaggedForm)))
                       (hs (ptr HostStage))
                       (which (ptr (ArrayList (slice u8))))] (-> (ptr (ArrayList TaggedForm)))
  (let [(mut host) (HashMap::new [(slice u8) i64] a (keyops))
        normalized (.normalized hs)
        (mut out) (ArrayList::new [TaggedForm] a)]
    (for [i 0 (len (load normalized))]
      (let [tf (elem normalized i)]
        (match (source-defn-name-of (field tf form))
          (Some [n]
                (let [q (qualify-name a n (.module tf))]
                  (when (set-contains which q)
                    (set! (mut host) q i)
                    0)))
          (None [] 0))))
    (for [i 0 (len (load authored))]
      (let [tf (primitive/alloc-stack TaggedForm)]
        (set! tf (get (load authored) i))
        (match (source-defn-name-of (field tf form))
          (Some [n]
                (match (get (load host) (qualify-name a n (.module tf)))
                  (Some [j]
                        (tagged-rewrite! tf (tower-clone-sexp a (field (elem normalized j) form)))
                        0)
                  (None [] 0)))
          (None [] 0))
        (push! (mut out) (load tf))))
    (box-al [TaggedForm] a (load out))))

; ── what a cross build's program leaves to the host ──────────────────────────
; The program holds what can run on its target, but code running inside the
; compiler reaches what the target cannot have: a macro that writes a linker script
; through `coil.fs` while the program is built for bare metal. What only that code
; uses is the twin's alone, as Rust builds a proc macro's dependencies only for the
; host and Racket instantiates a `for-syntax` import only at phase 1. Coil infers
; the phases from the source.
;
; Phase 0 is the program, phase 1 the compiler. A function used at phase P runs at
; P, the body of a compile-time definition (one that takes or returns Code) always
; runs in the compiler, and a quasiquote template moves what it holds one phase
; earlier, since it is code being produced. A compile-time definition that another
; one's body uses is taken as called there, producing code for the program, though
; it may be expanded in place and produce compiler code instead: the type checker
; decides which, and the call can only keep more in the program than it needs.
;
; The program loads every module the build was asked for, every module a name
; used at phase 0 is in, and every import no name uses at all (one for its
; registrations or impls). It keeps every form of those modules but the functions
; compile-time code reaches that name something it does not have. A function
; phase-0 code calls is never one of those; a compile-time definition can be, since
; the program only expands it. What it leaves is the twin's, and the twin of every
; later stage-3 generation gets it back.

;;; A name a symbol can refer to.
(defstruct PhaseTarget [(module (slice u8)) (name (slice u8))])

;;; Why a module is in the program: the form whose phase-0 name brought it in
;;; (-1 when the build asked for it), the name, and whether it was imported for
;;; its effects instead.
(defstruct PhaseReason [(form i64) (name (slice u8)) (effect bool)])

;;; The phase analysis of one cross build's program.
(defstruct PhaseCx
  [(a (dyn Allocator))
   (forms (ptr (ArrayList TaggedForm)))
   (imports (ptr (ArrayList ImpEntry)))
   (entries (HashMap (slice u8) i64))
   ; Each module's index, its forms, the first form's source, and its functions.
   (modules (ptr (ArrayList (slice u8))))
   (module_index (HashMap (slice u8) i64))
   (module_forms (ptr (ArrayList (ArrayList i64))))
   (module_source (HashMap (slice u8) i64))
   (defs (HashMap (slice u8) (ptr (HashMap (slice u8) i64))))
   ; The names of each module with an export list.
   (exported (HashMap (slice u8) (ptr (HashMap (slice u8) bool))))
   ; Per form: its function's qualified name or "", whether that function is a
   ; compile-time definition, whether compile-time code reaches it, and whether it
   ; is used at phase 0 and at phase 1.
   (qnames (ptr (ArrayList (slice u8))))
   (compile_time (ptr (ArrayList bool)))
   (candidate (ptr (ArrayList bool)))
   (used0 (ptr (ArrayList bool)))
   (used1 (ptr (ArrayList bool)))
   (loaded (HashMap (slice u8) bool))
   (reasons (HashMap (slice u8) PhaseReason))
   (work (ptr (ArrayList i64)))
   (targets (ptr (ArrayList PhaseTarget)))])

(defn phase-imports [(cx (ptr PhaseCx)) (m (slice u8))] (-> (Option (ptr ModImports)))
  (match (get (.entries cx) m)
    (Some [k] (Some (field (elem (.imports cx) k) imp)))
    (None [] (None [(ptr ModImports)]))))

(defn phase-def [(cx (ptr PhaseCx)) (m (slice u8)) (name (slice u8))] (-> (Option i64))
  (match (get (.defs cx) m)
    (Some [names] (get (load names) name))
    (None [] (None [i64]))))

;;; Can module TARGET supply EXPORTED to an importer? One with an export list says;
;;; one without may define anything.
(defn phase-exports? [(cx (ptr PhaseCx)) (target (slice u8)) (exported (slice u8))] (-> bool)
  (match (get (.exported cx) target)
    (Some [names] (match (get (load names) exported) (Some [_] true) (None [] false)))
    (None [] true)))

(defn phase-target-push! [(cx (ptr PhaseCx)) (m (slice u8)) (name (slice u8))] (-> i64)
  (push! (.targets cx) (PhaseTarget :module m :name name))
  0)

;;; Fill the targets list with what NAME, a symbol in module M's code, can refer
;;; to: the module before a `/` (an alias, an imported module, or M), M's own
;;; function, or a name an import refers. Locals are not told apart, so a local
;;; spelled like a definition counts as a use of it.
(defn phase-targets! [(cx (ptr PhaseCx)) (m (slice u8)) (name (slice u8))] (-> i64)
  (clear! (.targets cx))
  (let [slash (find-slash name)]
    (if (> slash 0)
        (let [prefix (subslice name 0 slash)
              leaf (subslice name (+ slash 1) (len name))]
          (when (= prefix m) (phase-target-push! cx m leaf))
          (match (phase-imports cx m)
            (None [] 0)
            (Some [imp]
                  (do
                    (for [i 0 (len (.aliases imp))]
                      (let [al (elem (field imp aliases) i)]
                        (when (or (= (.alias al) prefix) (= (.target al) prefix))
                          (phase-target-push! cx (.target al) leaf))))
                    (for [i 0 (len (.uses imp))]
                      (let [u (elem (field imp uses) i)]
                        (when (= (.target u) prefix)
                          (phase-target-push! cx (.target u) leaf))))
                    0))))
        (do
          (when (match (phase-def cx m name) (Some [_] true) (None [] false))
            (phase-target-push! cx m name))
          (match (phase-imports cx m)
            (None [] 0)
            (Some [imp]
                  (do
                    (for [i 0 (len (.uses imp))]
                      (let [u (elem (field imp uses) i)]
                        (match (use-refers u name)
                          (Some [x] (when (phase-exports? cx (.target u) x)
                                      (phase-target-push! cx (.target u) x)))
                          (None [] 0))))
                    (let [core (field imp core)]
                      (when (> (len (.target core)) 0)
                        (match (use-refers core name)
                          (Some [x] (when (phase-exports? cx (.target core) x)
                                      (phase-target-push! cx (.target core) x)))
                          (None [] 0))))
                    0)))))
    0))

(defn phase-use! [(cx (ptr PhaseCx)) (j i64) (p i64)] (-> i64)
  (if (= p 0)
      (unless (get (load (.used0 cx)) j)
        (set! (elem (.used0 cx) j) true)
        (push! (.work cx) (* j 2))
        0)
      (unless (get (load (.used1 cx)) j)
        (set! (elem (.used1 cx) j) true)
        (push! (.work cx) (+ (* j 2) 1))
        0))
  0)

;;; Put module M in the program, because of WHY: all of its forms but the
;;; functions compile-time code reaches are used at phase 0, and so is every
;;; import it names nothing from.
(defn phase-load! [(cx (ptr PhaseCx)) (m (slice u8)) (why PhaseReason)] (-> i64)
  (match (get (.loaded cx) m)
    (Some [_] 0)
    (None []
          (do
            (set! (mut (.loaded cx)) m true)
            (set! (mut (.reasons cx)) m why)
            (match (get (.module_index cx) m)
              (None [] 0)
              (Some [mi]
                    (let [own (elem (.module_forms cx) mi)]
                      (for [k 0 (len (load own))]
                        (let [j (get (load own) k)]
                          (unless (get (load (.candidate cx)) j)
                            (phase-use! cx j 0))))
                      0)))
            (match (phase-imports cx m)
              (None [] 0)
              (Some [imp]
                    (let [named (phase-named-modules cx m)]
                      (when (> (len (.target (field imp core))) 0)
                        (phase-load! cx (.target (field imp core)) (PhaseReason :form -1 :name m :effect true)))
                      (for [i 0 (len (.aliases imp))]
                        (let [t (.target (elem (field imp aliases) i))]
                          (when (match (get (load named) t) (Some [_] false) (None [] true))
                            (phase-load! cx t (PhaseReason :form -1 :name m :effect true)))))
                      (for [i 0 (len (.uses imp))]
                        (let [t (.target (elem (field imp uses) i))]
                          (when (match (get (load named) t) (Some [_] false) (None [] true))
                            (phase-load! cx t (PhaseReason :form -1 :name m :effect true)))))
                      0)))
            0))))

(defn phase-named-walk! [(cx (ptr PhaseCx)) (m (slice u8)) (node Sexp)
                         (named (mut (HashMap (slice u8) bool)))] (-> i64)
  (let [tag (sx-tag node)]
    (cond (phase-declaration-form? node) 0
          (= tag 2)
            (do (phase-targets! cx m (sx-sval node))
                (for [i 0 (len (load (.targets cx)))]
                  (set! (mut named) (.module (get (load (.targets cx)) i)) true))
                0)
          (or (= tag 6) (= tag 7))
            (let [items (sx-items node)]
              (for [i 0 (sx-len items)]
                (phase-named-walk! cx m (sx-at items i) (mut named)))
              0)
          :else 0)))

;;; The modules some name in module M's forms can refer to, at any phase.
(defn phase-named-modules [(cx (ptr PhaseCx)) (m (slice u8))] (-> (ptr (HashMap (slice u8) bool)))
  (let [(mut named) (HashMap::new [(slice u8) bool] (.a cx) (keyops))]
    (match (get (.module_index cx) m)
      (None [] 0)
      (Some [mi]
            (let [own (elem (.module_forms cx) mi)]
              (for [k 0 (len (load own))]
                (phase-named-walk! cx m (load (field (elem (.forms cx) (get (load own) k)) form)) (mut named)))
              0)))
    (box! (.a cx) (HashMap (slice u8) bool) (load named))))

;;; Is NODE a `module`, `import` or `export` form? Its names declare a module's
;;; interface; they use nothing.
(defn phase-declaration-form? [(node Sexp)] (-> bool)
  (and (= (sx-tag node) 6)
       (let [head (sx-head-name (sx-items node))]
         (or (= head "import") (or (= head "export") (= head "module"))))))

;;; A name used at phase P by form J: at phase 0 its module is in the program, and
;;; the function it names, followed through re-exports, is used at P.
(defn phase-reach! [(cx (ptr PhaseCx)) (t PhaseTarget) (p i64) (why PhaseReason) (hops i64)] (-> i64)
  (when (= p 0) (phase-load! cx (.module t) why))
  (match (phase-def cx (.module t) (.name t))
    (Some [j] (phase-use! cx j p))
    (None []
          (when (< hops 16)
            (match (phase-imports cx (.module t))
              (None [] 0)
              (Some [imp]
                    (do
                      (for [i 0 (len (.reexports imp))]
                        (let [e (elem (field imp reexports) i)]
                          (match (use-refers e (.name t))
                            (Some [x] (phase-reach! cx (PhaseTarget :module (.target e) :name x) p why (+ hops 1)))
                            (None [] 0))))
                      0))))))
  0)

;;; Walk NODE of form J, in module M. BODY is the phase its code runs at, DEPTH the
;;; number of templates around NODE.
(defn phase-walk! [(cx (ptr PhaseCx)) (j i64) (m (slice u8)) (node Sexp) (depth i64) (body i64)] (-> i64)
  (let [tag (sx-tag node)]
    (cond (phase-declaration-form? node) 0
          (= tag 2)
            (let [raw (- body depth)
                  p (cond (< raw 0) 0 (> raw 1) 1 :else raw)
                  name (sx-sval node)]
              (phase-targets! cx m name)
              ; Reaching a target refills the list, so take a copy first.
              (let [ts (ls-copy-list [PhaseTarget] (.a cx) (load (.targets cx)))]
                (for [i 0 (len ts)]
                  (phase-reach! cx (get ts i) p (PhaseReason :form j :name name :effect false) 0)))
              0)
          (or (= tag 6) (= tag 7))
            (let [items (sx-items node)
                  head (if (= tag 6) (sx-head-name items) "")
                  inner (cond (or (= head "quasiquote") (= head "quote")) (+ depth 1)
                              (and (> depth 0) (or (= head "unquote") (= head "unquote-splicing")))
                                (- depth 1)
                              :else depth)]
              (for [i 0 (sx-len items)]
                (phase-walk! cx j m (sx-at items i) inner body))
              0)
          :else 0)))

;;; Can every name in NODE, written in module M, be found in the program, given
;;; which forms it KEPT?
(defn phase-resolvable? [(cx (ptr PhaseCx)) (m (slice u8)) (node Sexp) (kept (ptr (ArrayList bool)))] (-> bool)
  (block :done
    (let [tag (sx-tag node)]
      (cond (phase-declaration-form? node) true
            (= tag 2)
              (do (phase-targets! cx m (sx-sval node))
                  (for [i 0 (len (load (.targets cx)))]
                    (let [t (get (load (.targets cx)) i)]
                      (when (match (get (.loaded cx) (.module t)) (Some [_] false) (None [] true))
                        (break :done false))
                      (match (phase-def cx (.module t) (.name t))
                        (Some [k] (unless (get (load kept) k) (break :done false)))
                        (None [] 0))))
                  true)
            (or (= tag 6) (= tag 7))
              (let [items (sx-items node)]
                (for [i 0 (sx-len items)]
                  (unless (phase-resolvable? cx m (sx-at items i) kept)
                    (break :done false)))
                true)
            :else true))))

;;; The analysis context for S's program; COMPILE-TIME and CLOSURE are what the
;;; host twin recorded.
(defn phase-cx [(s (mut LS))
                (compile-time (ptr (ArrayList (slice u8))))
                (closure (ptr (ArrayList (slice u8))))] (-> (ptr PhaseCx))
  (let [a (.a s)
        forms (box-al [TaggedForm] a (.out s))
        n (len (load forms))
        (mut ct) (HashMap::new [(slice u8) bool] a (keyops))
        (mut reached) (HashMap::new [(slice u8) bool] a (keyops))
        cx (box! a PhaseCx (primitive/zeroed PhaseCx))]
    (for [i 0 (len (load compile-time))] (set! (mut ct) (get (load compile-time) i) true))
    (for [i 0 (len (load closure))] (set! (mut reached) (get (load closure) i) true))
    (set! (.a cx) a)
    (set! (.forms cx) forms)
    (set! (.imports cx) (box-al [ImpEntry] a (.imports s)))
    (set! (.entries cx) (HashMap::new [(slice u8) i64] a (keyops)))
    (set! (.modules cx) (box-al [(slice u8)] a (ArrayList::new [(slice u8)] a)))
    (set! (.module_index cx) (HashMap::new [(slice u8) i64] a (keyops)))
    (set! (.module_forms cx) (box-al [(ArrayList i64)] a (ArrayList::new [(ArrayList i64)] a)))
    (set! (.module_source cx) (HashMap::new [(slice u8) i64] a (keyops)))
    (set! (.defs cx) (HashMap::new [(slice u8) (ptr (HashMap (slice u8) i64))] a (keyops)))
    (set! (.exported cx) (HashMap::new [(slice u8) (ptr (HashMap (slice u8) bool))] a (keyops)))
    (set! (.qnames cx) (box-al [(slice u8)] a (ArrayList::new [(slice u8)] a)))
    (set! (.compile_time cx) (box-al [bool] a (ArrayList::new [bool] a)))
    (set! (.candidate cx) (box-al [bool] a (ArrayList::new [bool] a)))
    (set! (.used0 cx) (box-al [bool] a (ArrayList::new [bool] a)))
    (set! (.used1 cx) (box-al [bool] a (ArrayList::new [bool] a)))
    (set! (.loaded cx) (HashMap::new [(slice u8) bool] a (keyops)))
    (set! (.reasons cx) (HashMap::new [(slice u8) PhaseReason] a (keyops)))
    (set! (.work cx) (box-al [i64] a (ArrayList::new [i64] a)))
    (set! (.targets cx) (box-al [PhaseTarget] a (ArrayList::new [PhaseTarget] a)))
    (for [k 0 (len (.imports s))]
      (set! (mut (.entries cx)) (.name (elem (field s imports) k)) k))
    (for [k 0 (len (.exports s))]
      (let [e (elem (field s exports) k)]
        (when (> (len (.names e)) 0)
          (let [names (box! a (HashMap (slice u8) bool) (HashMap::new [(slice u8) bool] a (keyops)))]
            (for [i 0 (len (.names e))]
              (set! names (get (.names e) i) true))
            (set! (mut (.exported cx)) (.name e) names)
            0))))
    (for [i 0 n]
      (let [tf (elem forms i)
            q (match (source-defn-name-of (field tf form))
                (Some [d] (qualify-name a d (.module tf)))
                (None [] ""))
            comp (and (> (len q) 0) (match (get (load ct) q) (Some [_] true) (None [] false)))]
        (push! (.qnames cx) q)
        (push! (.compile_time cx) comp)
        (push! (.candidate cx) (or comp (and (> (len q) 0) (match (get (load reached) q) (Some [_] true) (None [] false)))))
        (push! (.used0 cx) false)
        (push! (.used1 cx) false)
        (match (.module tf)
          (None [] 0)
          (Some [m]
                (do
                  (when (match (get (.module_index cx) m) (Some [_] false) (None [] true))
                    (set! (mut (.module_index cx)) m (len (load (.modules cx))))
                    (set! (mut (.module_source cx)) m (sx-source (load (field tf form))))
                    (push! (.modules cx) m)
                    (push! (.module_forms cx) (ArrayList::new [i64] a))
                    0)
                  (match (get (.module_index cx) m)
                    (Some [mi] (do (push! (elem (.module_forms cx) mi) i) 0))
                    (None [] 0))
                  (match (source-defn-name-of (field tf form))
                    (None [] 0)
                    (Some [d]
                          (let [names (match (get (.defs cx) m)
                                        (Some [names] names)
                                        (None []
                                              (let [fresh (box! a (HashMap (slice u8) i64) (HashMap::new [(slice u8) i64] a (keyops)))]
                                                (set! (mut (.defs cx)) m fresh)
                                                fresh)))]
                            (set! names d i)
                            0)))
                  0)))))
    cx))

;;; Load S's roots into CX: every module no module imports (the modules the build
;;; asked for), the entry module, core's providers, and every module that registers
;;; a pass over the program; then follow what they use.
(defn phase-run! [(s (mut LS)) (cx (ptr PhaseCx))] (-> i64)
  (let [a (.a s)
        root (PhaseReason :form -1 :name "" :effect false)
        (mut imported) (HashMap::new [(slice u8) bool] a (keyops))]
    (for [k 0 (len (.imports s))]
      (let [imp (field (elem (field s imports) k) imp)]
        (for [i 0 (len (.aliases imp))]
          (set! (mut imported) (.target (elem (field imp aliases) i)) true))
        (for [i 0 (len (.uses imp))]
          (set! (mut imported) (.target (elem (field imp uses) i)) true))
        (for [i 0 (len (.reexports imp))]
          (set! (mut imported) (.target (elem (field imp reexports) i)) true))))
    (for [i 0 (len (load (.modules cx)))]
      (let [m (get (load (.modules cx)) i)]
        (when (match (get (load imported) m) (Some [_] false) (None [] true))
          (phase-load! cx m root))))
    (for [k 0 (len (.imports s))]
      (let [m (.name (elem (field s imports) k))]
        (when (match (get (load imported) m) (Some [_] false) (None [] true))
          (phase-load! cx m root))))
    (when (> (len (.entry_module s)) 0)
      (phase-load! cx (.entry_module s) root))
    (for [i 0 (len (.core_declared_modules s))]
      (phase-load! cx (get (.core_declared_modules s) i) root))
    ; Registrations act on the program whether or not a name uses them.
    (for [i 0 (len (load (.forms cx)))]
      (let [tf (elem (.forms cx) i)
            f (field tf form)]
        (when (or (is-register-derive-form f) (or (is-checker-form f) (is-transform-form f)))
          (match (.module tf)
            (Some [m] (phase-load! cx m root))
            (None [] 0)))))
    (loop
      (match (pop! (.work cx))
        (None [] (break))
        (Some [w]
              (let [j (/ w 2)
                    p (- w (* j 2))
                    tf (elem (.forms cx) j)
                    m (match (.module tf) (Some [m] m) (None [] ""))]
                (phase-walk! cx j m (load (field tf form)) 0 (if (get (load (.compile_time cx)) j) 1 p))))))
    0))

;;; Which forms of CX the program keeps: those of loaded modules, minus each
;;; function compile-time code reaches that names something the program does not
;;; have, unless phase-0 code calls it. A compile-time definition is never called
;;; by phase-0 code, only expanded: its expansion needs the twin's definition alone.
(defn phase-kept [(cx (ptr PhaseCx))] (-> (ptr (ArrayList bool)))
  (let [a (.a cx)
        n (len (load (.forms cx)))
        kept (box-al [bool] a (ArrayList::new [bool] a))]
    (for [i 0 n]
      (let [tf (elem (.forms cx) i)]
        (push! kept (match (.module tf)
                      (None [] true)
                      (Some [m] (match (get (.loaded cx) m) (Some [_] true) (None [] false)))))))
    (loop
      (let [(mut changed) false]
        (for [i 0 n]
          (when (and (get (load kept) i)
                     (and (get (load (.candidate cx)) i)
                          (or (get (load (.compile_time cx)) i) (not (get (load (.used0 cx)) i)))))
            (let [tf (elem (.forms cx) i)
                  m (match (.module tf) (Some [m] m) (None [] ""))]
              (unless (phase-resolvable? cx m (load (field tf form)) kept)
                (set! (elem kept i) false)
                (set! changed true)
                0))))
        (unless (load changed) (break))))
    kept))

;;; Why module M is in CX's program, as a clause ("" when the build asked for it).
(defn phase-reason-text [(cx (ptr PhaseCx)) (m (slice u8))] (-> (slice u8))
  (let [a (.a cx)]
    (match (get (.reasons cx) m)
      (None [] "")
      (Some [why]
            (cond (.effect why)
                    (sconcat3 a "`" (.name why) "` imports it and names nothing from it")
                  (< (.form why) 0) ""
                  :else
                    (let [j (.form why)
                          q (get (load (.qnames cx)) j)
                          owner (match (.module (elem (.forms cx) j)) (Some [om] om) (None [] ""))
                          place (cond (get (load (.compile_time cx)) j) (sconcat3 a "a template in `" q "`")
                                      (> (len q) 0) (sconcat3 a "`" q "`")
                                      :else (sconcat3 a "a top-level form of `" owner "`"))]
                      (sconcat3 a place " uses `" (sconcat a (.name why) "` at run time"))))))))

;;; DIAG, for an error inside a module the program holds because of phase-0 code,
;;; with what brought that module in.
(defn phase-explain [(cx (ptr PhaseCx)) (d Diag)] (-> Diag)
  (let [out (primitive/alloc-stack Diag)]
    (set! out d)
    (for [i 0 (len (load (.modules cx)))]
      (let [m (get (load (.modules cx)) i)]
        (when (match (get (.module_source cx) m) (Some [src] (= src (.source out))) (None [] false))
          (let [who (phase-reason-text cx m)]
            (when (> (len who) 0)
              (set! (.msg out)
                    (sconcat3 (.a cx) (.msg out) (sconcat3 (.a cx) "; `" m "` is in the program because ") who))
              0)))))
    (load out)))

;;; With COIL_TRACE_PHASES set, tell stderr what CX left to the host and why each
;;; module that stayed is in the program.
(defn phase-trace [(cx (ptr PhaseCx)) (kept (ptr (ArrayList bool)))] (-> i64)
  (when (!= (primitive/cast i64 (unit-getenv c"COIL_TRACE_PHASES")) 0)
    (let [w (stderr)]
      (for [i 0 (len (load (.modules cx)))]
        (let [m (get (load (.modules cx)) i)]
          (match (get (.loaded cx) m)
            (None [] (do (ps w "phases: module ") (ps w m) (ps w " is the host's\n") 0))
            (Some [_]
                  (let [why (phase-reason-text cx m)]
                    (ps w "phases: module ")
                    (ps w m)
                    (ps w (if (> (len why) 0) " is in the program: " " is in the program: the build asked for it"))
                    (ps w why)
                    (ps w "\n")
                    0)))))
      (for [i 0 (len (load (.forms cx)))]
        (let [tf (elem (.forms cx) i)
              q (get (load (.qnames cx)) i)]
          (when (and (> (len q) 0)
                     (and (not (get (load kept) i))
                          (match (.module tf)
                            (Some [m] (match (get (.loaded cx) m) (Some [_] true) (None [] false)))
                            (None [] false))))
            (ps w "phases: ")
            (ps w q)
            (ps w " is the host's\n")
            0)))
      0))
  0)

;;; In a cross build's first stage-3 generation, leave to the host what only the
;;; compiler's code uses (see above). Later generations keep the decision.
(defn host-stage-leave! [(s (mut LS)) (hs (ptr HostStage))] (-> i64)
  (when (and (= (primitive/cast i64 (.phase hs)) 0)
             (and (!= (primitive/cast i64 (.compile_time hs)) 0)
                  (!= (primitive/cast i64 (.closure hs)) 0)))
    (let [a (.a s)
          cx (phase-cx (mut s) (.compile_time hs) (.closure hs))
          _run (phase-run! (mut s) cx)
          kept (phase-kept cx)
          _trace (phase-trace cx kept)
          (mut program) (ArrayList::new [TaggedForm] a)
          (mut left) (ArrayList::new [TaggedForm] a)
          (mut modules) 0]
      (for [i 0 (len (load (.modules cx)))]
        (when (match (get (.loaded cx) (get (load (.modules cx)) i)) (Some [_] false) (None [] true))
          (set! modules (+ (load modules) 1))
          0))
      (for [i 0 (len (load (.forms cx)))]
        (if (get (load kept) i)
            (push! (mut program) (get (load (.forms cx)) i))
            (push! (mut left) (get (load (.forms cx)) i))))
      (let [(mut defined) (ArrayList::new [(slice u8)] a)]
        (for [i 0 (len (load (.forms cx)))]
          (let [q (get (load (.qnames cx)) i)]
            (when (and (> (len q) 0) (not (get (load kept) i)))
              (push! (mut defined) q)
              0)))
        (set! (.host_defined s) (box-al [(slice u8)] a (load defined))))
      (tr/count "expand.stage3.host-only-modules" (load modules))
      (tr/count "expand.stage3.host-only-forms" (len (load left)))
      (set! (.phase hs) cx)
      (set! (.host_forms hs) (box-al [TaggedForm] a (load left)))
      (set! (.host_imports hs) (box-al [ImpEntry] a (.imports s)))
      (set! (.host_exports hs) (box-al [ExpEntry] a (.exports s)))
      (set! (.out s) (load program))
      0))
  0)

;;; Stage 3 of a cross build: the host twin's stage 3, with every target question
;;; answering for the host, then the program's expansion against the twin's
;;; engine, answering for the target.
(defn expand-stage3-cross [(s (mut LS))
                           (excluded (ptr (ArrayList (slice u8))))
                           (exclude-closure bool)] (-> (Result i64 Diag))
  ; The program and the twin both need the generated definitions.
  (match (defderive-desugar! (mut s))
    (Some [d] (Err [i64 Diag] d))
    (None []
          ; the program's library compile-time code is linked too, before the
          ; twin copies the program: its forms there are the same declarations
          (when (!= (.isset (ct-units-hook)) 0)
            (primitive/call-ptr (.fp (ct-units-hook)) (primitive/cast (ptr LS) (mut s)))
            0)
          (let [hs (host-stage-of (mut s))
                prior-authored (.authored hs)
                prior-normalized (.normalized hs)
                _reset (set! (.done hs) false)
                h (host-twin (mut s) hs)
                target (target-cell-swap! (host-target-cell))
                host-result (expand-stage3-resume (mut h)
                                                  excluded
                                                  exclude-closure
                                                  prior-authored
                                                  prior-normalized)
                _target (target-cell-swap! target)
                _adopt (host-stage-adopt! (mut s) h)]
            (set-cli-sources (field s sources))
            (match host-result
              (Err [d] (Err [i64 Diag] d))
              (Ok [_]
                  (do (host-stage-leave! (mut s) hs)
                      (match (expand-program-against-host! (mut s) hs excluded exclude-closure)
                        (Ok [r] (Ok [i64 Diag] r))
                        (Err [d]
                             (Err [i64 Diag]
                                  (if (= (primitive/cast i64 (.phase hs)) 0)
                                      d
                                      (phase-explain (.phase hs) d))))))))))))

;;; The program's half of a cross build's stage 3: expand it for the target,
;;; invoking the host twin's engine for every macro.
(defn expand-program-against-host! [(s (mut LS))
                                    (hs (ptr HostStage))
                                    (excluded (ptr (ArrayList (slice u8))))
                                    (exclude-closure bool)] (-> (Result i64 Diag))
  (cond (not (.done hs))
          (Err [i64 Diag] (derr "the host stage of a cross build finished without a macro engine (compiler bug)"))
        ; No compile-time definitions: nothing for stage 3 to do, as in a build
        ; for the host.
        (= (len (load (.quals hs))) 0) (Ok [i64 Diag] 0)
        :else
          (let [a (.a s)
                authored (tower-snapshot a (box-al [TaggedForm] a (.out s)) (len (.out s)))
                ; Compile-time definitions are expanded for the host because only
                ; the host runs them; every other definition stays as written, for
                ; the program to expand for its target.
                normalized (host-normalized a authored hs (.compile_time hs))]
            (match (run-expand (mut s)
                               authored
                               normalized
                               (.quals hs)
                               (.compile_time hs)
                               (.checked hs)
                               a)
              (Err [d] (Err [i64 Diag] d))
              (Ok [expanded]
                  (if (= expanded 2)
                      (stage3-restart! (mut s) excluded exclude-closure authored normalized)
                      (Ok [i64 Diag] 0)))))))

;;; Rebuild stage 3 over a program a before-expand transform rewrote, or that
;;; (meta …) output extended, resuming from the abandoned generation's authored
;;; snapshot and working copy. Bounded: a transform that keeps introducing new
;;; compile-time functions is an error.
(defn stage3-restart! [(s (mut LS))
                       (excluded (ptr (ArrayList (slice u8))))
                       (exclude-closure bool)
                       (prior-authored (ptr (ArrayList TaggedForm)))
                       (prior-normalized (ptr (ArrayList TaggedForm)))] (-> (Result i64 Diag))
  (let [cell (stage3-restart-count) a (.a s)]
    (if (>= (load cell) 8)
      (Err [i64 Diag] (derr (sconcat a "before-expand transforms kept introducing compile-time definitions; last: " (load (last-introduced-macro)))))
      (do
        (store! cell (+ (load cell) 1))
        ; The rebuilt program carries its own registration forms; forget the
        ; abandoned generation's copies so each registers once.
        (set! (.pipeline_forms s) (ArrayList::new [TaggedForm] a))
        (let [result (expand-stage3-resume (mut s)
                                           excluded
                                           exclude-closure
                                           prior-authored
                                           prior-normalized)]
          (store! cell (- (load cell) 1))
          result)))))
(defn stage3-restart-count [] (-> (ptr i64)) (primitive/alloc-static i64))
(defn last-introduced-macro [] (-> (ptr (slice u8))) (primitive/alloc-static (slice u8)))

(defn expand-stage3-except [(s (mut LS))
                            (excluded (ptr (ArrayList (slice u8))))] (-> (Result i64
                                                                                 Diag))
  (expand-stage3-except-mode (mut s) excluded false))

(defn expand-stage3-phase-except [(s (mut LS))
                                  (excluded (ptr (ArrayList (slice u8))))] (-> (Result i64
                                                                                       Diag))
  (expand-stage3-except-mode (mut s) excluded true))

(defn expand-stage3 [(s (mut LS))] (-> (Result i64 Diag))
  (let [a (.a s)]
    (expand-stage3-except (mut s)
                          (box-al [(slice u8)] a (ArrayList::new [(slice u8)] a)))))

; After the tower rewrote metaprogram-body macro calls in the SUB list, mirror
; those forms back into s.out (index-aligned 1:1 for the first n entries — the sub
; list is a copy of s.out, plus the shim appended at the END). The main program's
; authoritative check sees metaprogram bodies too (they are only dropped before
; mono), so they must be the EXPANDED ones there as well. Value-identical for
; every form the tower didn't touch.
(defn tower-sync-out! [(s (mut LS)) (sub-forms (ptr (ArrayList TaggedForm)))] (-> i64)
  (set! (.out s) (load sub-forms))
  0)

; Snapshot the authoritative prefix without sharing the ArrayList buffer. Engine
; setup re-enters lazy staging and may overwrite both its temporary subprogram and
; s.out; this stable copy is restored after that nested compilation returns.
(defn tower-clone-sexp [(a (dyn Allocator)) (x (ptr Sexp))] (-> Sexp)
  (let [tag (sx-tag (load x))]
    (if (or (= tag 6) (= tag 7))
        (let [items (sx-items (load x))
              n (sx-len items)
              (mut out) (ArrayList::new [Sexp] a)
              (mut i) 0]
          (reserve! (mut out) n)
          (loop (if (>= (load i) n)
                    (break)
                    (do
                      (push! (mut out)
                             (tower-clone-sexp a
                                               (elem items (load i))))
                      (set! i (primitive/iadd (load i) 1)))))
          (let [copy (primitive/alloc-stack Sexp)]
            (set! copy
                  (mk-sexp-src (if (= tag 6)
                                   (KList (box-al [Sexp] a (load out)))
                                   (KVec (box-al [Sexp] a (load out))))
                               x))
            ; This is a storage/lifetime snapshot, not generated syntax. Preserve
            ; node identity so the semantic workspace recognizes the same form
            ; revision after the tower restores it. Macro/template constructors
            ; continue to allocate fresh node-ids through mk-sexp-src.
            (set! (.node-id copy) (.node-id x))
            (load copy)))
        (load x))))

(defn tower-snapshot [(a (dyn Allocator))
                      (sub-forms (ptr (ArrayList TaggedForm)))
                      (n i64)] (-> (ptr (ArrayList TaggedForm)))
  (let [(mut out) (ArrayList::new [TaggedForm] a)
        (mut i) 0]
    (reserve! (mut out) n)
    (loop (if (>= (load i) n)
              (break)
              (do
                (let [src (elem sub-forms (load i))
                      dst (primitive/alloc-stack TaggedForm)]
                  (set! (.form dst) (tower-clone-sexp a (field src form)))
                  (set! (.module dst) (.module src))
                  (set! (.form_id dst) (.form_id src))
                  (set! (.revision dst) (.revision src))
                  (set! (.cached_shape dst) (.cached_shape src))
                  (push! (mut out) (load dst)))
                (set! i (primitive/iadd (load i) 1)))))
    (box-al [TaggedForm] a (load out))))

;;; The first N forms of SUB-FORMS in a list of their own, sharing their syntax.
;;; The tower never writes into a form's tree: it rewrites a form by building a
;;; new spine down to what changed (tower-rewrite-kids), and an expansion's
;;; provenance stamp writes only nodes that have no span, which authored and
;;; earlier stamped ones all have. What a snapshot must keep stable is the list.
(defn tower-snapshot-shallow [(a (dyn Allocator))
                              (sub-forms (ptr (ArrayList TaggedForm)))
                              (n i64)] (-> (ptr (ArrayList TaggedForm)))
  (let [(mut out) (ArrayList::new [TaggedForm] a)]
    (reserve! (mut out) n)
    (for [i 0 n]
      (push! (mut out) (get (load sub-forms) i))
      0)
    (box-al [TaggedForm] a (load out))))

(defn tower-meta-snapshot [(a (dyn Allocator))
                           (forms (ptr (ArrayList TaggedForm)))] (-> (ptr (ArrayList TaggedForm)))
  (let [(mut out) (ArrayList::new [TaggedForm] a)
        n (len (load forms))
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (let [src (elem forms (load i))]
                  (when (is-meta-form (field src form))
                    (let [dst (primitive/alloc-stack TaggedForm)]
                      (store! (field dst form)
                              (tower-clone-sexp a (field src form)))
                      (store! (field dst module) (load (field src module)))
                      (store! (field dst form_id) (load (field src form_id)))
                      (store! (field dst revision) (load (field src revision)))
                      (store! (field dst cached_shape)
                              (load (field src cached_shape)))
                      (push! (mut out) (load dst)))
                    0))
                (set! i (primitive/iadd (load i) 1)))))
    (box-al [TaggedForm] a (load out))))

(defn tower-capture-metas! [(a (dyn Allocator))
                            (forms (ptr (ArrayList TaggedForm)))
                            (metas (ptr (ArrayList TaggedForm)))] (-> i64)
  (when (= (len (load metas)) 0)
    (let [n (len (load forms))
          (mut i) 0]
      (loop (if (>= (load i) n)
                (break)
                (do
                  (let [src (elem forms (load i))]
                    (when (is-meta-form (field src form))
                      (let [dst (primitive/alloc-stack TaggedForm)]
                        (store! (field dst form)
                                (tower-clone-sexp a (field src form)))
                        (store! (field dst module) (load (field src module)))
                        (store! (field dst form_id) (load (field src form_id)))
                        (store! (field dst revision)
                                (load (field src revision)))
                        (store! (field dst cached_shape)
                                (load (field src cached_shape)))
                        (push! [TaggedForm] metas (load dst)))
                      0))
                  (store! i (primitive/iadd (load i) 1))))))
    0)
  0)

(defn tower-restore-metas! [(s (mut LS))
                            (metas (ptr (ArrayList TaggedForm)))] (-> i64)
  (let [a (.a s)
        old (box-al [TaggedForm] a (.out s))
        (mut out) (ArrayList::new [TaggedForm] a)
        no (len (load old))
        (mut j) 0
        n (len (load metas))
        (mut i) 0]
    (loop (if (>= (load j) no)
              (break)
              (do
                (let [tf (elem old (load j))]
                  (unless (is-meta-form (field tf form))
                    (push! (mut out) (load tf))
                    0))
                (set! j (primitive/iadd (load j) 1)))))
    (loop (if (>= (load i) n)
              (break)
              (do
                (push! (mut out) (get (load metas) (load i)))
                (set! i (primitive/iadd (load i) 1)))))
    (set! (.out s) (load out))
    0))

; ── LOCAL convergence of one rejected function ──────────────────────────────
; A rejected macro call is expanded outermost-first, so a function whose generated
; code nests N macro layers used to need N whole generations: every one resolved and
; checked the complete metaprogram closure again to discover the next layer, while
; the only syntax that changed was that one function's body.
;
; The next generation's verdict on such a function is computable locally. Its check
; depends on its own syntax and on the checker environment: the signatures, types,
; traits and impls of the closure. While a rewrite (a) leaves the form a single
; function with the same qualified signature, or impls whose methods present the
; signatures the closure holds (`tower-probe-impl-method`), (b) calls nothing outside
; the closure and names no trait head the closure did not already select, the next
; generation builds that same environment for it. So re-parse just that form,
; re-check just that function or method against this generation's checker context,
; and expand at the fresh
; diagnostic — the exact diagnostic the next generation would have reported. A fresh
; diagnostic, not the old one reused: expansion output carries the outer call's span,
; so reusing a diagnostic would mistake Code-valued calls copied from a macro branch
; for rejected macro calls.
;
; This only accelerates. When any condition fails, or a diagnostic does not name a
; macro call, the function is left for the next whole generation, which remains the
; sole judge of success and of real errors.
(defn tower-list-empty? [T] [(xs (ptr (ArrayList T)))] (-> bool)
  (or (= (primitive/cast i64 xs) 0)
      (= (len (load xs)) 0)))

;;; Every parse starts from coil.cc's native conventions; only a `defcc` adds more.
(defn tower-default-conventions-only? [(cs (ptr (ArrayList Convention)))] (-> bool)
  (let [(mut only) true]
    (for [i 0 (len (load cs))]
      (unless (native-cc-identity? (conv-name (get (load cs) i))) (set! only false) 0)
      0)
    (load only)))

;;; Does a probed form declare nothing besides functions and impls?
(defn tower-probe-code-only? [(p (ptr Program))] (-> bool)
  (and (tower-list-empty? [AnnotationDef] (load (field p annotation_defs)))
       (tower-default-conventions-only? (load (field p conventions)))
       (tower-list-empty? [StructDef] (load (field p structs)))
       (tower-list-empty? [SumDef] (load (field p sums)))
       (tower-list-empty? [Extern] (load (field p externs)))
       (tower-list-empty? [StaticAssert] (load (field p asserts)))
       (tower-list-empty? [Const] (load (field p consts)))
       (tower-list-empty? [TraitDef] (load (field p traits)))
       (tower-list-empty? [Expr] (load (field p metas)))
       (tower-list-empty? [ExportC] (load (field p exports)))))

;;; The single function a probed form declares, or null when it declares anything
;;; else as well.
(defn tower-probe-single-func [(p (ptr Program))] (-> (ptr Func))
  (if (and (= (len (load (field p funcs))) 1)
           (tower-list-empty? [ImplDef] (load (field p impls)))
           (tower-probe-code-only? p))
      (elem (load (field p funcs)) 0)
      (primitive/cast (ptr Func) 0)))

;;; The name the checker gives method M of impl IP (see `append-impl-methods`).
(defn tower-method-checked-name [(a (dyn Allocator)) (ip (ptr ImplDef)) (m (slice u8))] (-> (slice u8))
  (if (impl-is-trait ip)
      (tmfn a
            (impl-trait-name ip)
            (impl-mangle-key a (field ip self_type) (load (field ip type_params)))
            m)
      (inherent-fn-name a ip m)))

;;; The impl methods of the closure sub-program SUB as the checker sees them,
;;; by checked name, each a copy that carries that name.
(defn tower-closure-methods [(a (dyn Allocator)) (sub (ptr Program))] (-> (ptr (HashMap (slice u8) (ptr Func))))
  (let [(mut methods) (HashMap::new [(slice u8) (ptr Func)] a (keyops-borrowed))]
    (for [ii 0 (len (load (.impls sub)))]
      (let [ip (elem (.impls sub) ii)]
        (for [mi 0 (len (load (.methods ip)))]
          (let [copy (box! a Func (get (load (.methods ip)) mi))]
            (set! (.name copy) (tower-method-checked-name a ip (.name copy)))
            (set! (mut methods) (.name copy) copy)))))
    (box! a (HashMap (slice u8) (ptr Func)) (load methods))))

;;; The function NAME of the closure sub-program SUB as the checker sees it: a
;;; function, or one of METHODS, SUB's impl methods (`tower-closure-methods`).
;;; Null when SUB lacks it.
(defn tower-closure-func [(sub (ptr Program))
                          (methods (ptr (HashMap (slice u8) (ptr Func))))
                          (name (slice u8))] (-> (ptr Func))
  (let [f (prog-fn-find sub name)]
    (if (!= (primitive/cast i64 f) 0)
        f
        (match (get (load methods) name)
          (Some [m] m)
          (None [] (primitive/cast (ptr Func) 0))))))

;;; The method OWNER of the impls a probed form declares, under its checked name,
;;; when the form declares impls and nothing else, and every method of them that
;;; the closure SUB holds (METHODS: its impl methods) presents the checker the
;;; signature it held: the checker
;;; environment the next generation builds for OWNER is then the one this
;;; generation built. A trait impl is in a closure whole, so a method of one that
;;; SUB lacks is a changed impl; an inherent impl's methods are independent
;;; functions, and the closure holds only those something calls. Null otherwise.
(defn tower-probe-impl-method [(a (dyn Allocator))
                               (p (ptr Program))
                               (sub (ptr Program))
                               (methods (ptr (HashMap (slice u8) (ptr Func))))
                               (owner (slice u8))] (-> (ptr Func))
  (if (not (and (tower-list-empty? [Func] (load (field p funcs)))
                (not (tower-list-empty? [ImplDef] (load (field p impls))))
                (tower-probe-code-only? p)))
      (primitive/cast (ptr Func) 0)
      (block :probe
        (let [(mut found) (primitive/cast (ptr Func) 0)]
          (for [ii 0 (len (load (.impls p)))]
            (let [ip (elem (.impls p) ii)]
              (for [mi 0 (len (load (.methods ip)))]
                (let [f (box! a Func (get (load (.methods ip)) mi))
                      name (tower-method-checked-name a ip (.name f))
                      old (tower-closure-func sub methods name)]
                  (set! (.name f) name)
                  (if (= (primitive/cast i64 old) 0)
                      (when (impl-is-trait ip) (break :probe (primitive/cast (ptr Func) 0)))
                      (unless (tower-func-signature-eq? f old)
                        (break :probe (primitive/cast (ptr Func) 0))))
                  (when (= name owner) (set! found f))))))
          (load found)))))

;;; The index of the sub-form that declares F, a function of the closure: the
;;; top-level form whose span holds F's. -1 when none does.
(defn tower-func-form [(sub-forms (ptr (ArrayList TaggedForm))) (f (ptr Func))] (-> i64)
  (if (< (.lo f) 0)
      -1
      (block :found
        (for [k 0 (len (load sub-forms))]
          (let [form (field (elem sub-forms k) form)]
            (when (and (= (sx-source (load form)) (.source f))
                       (<= (sx-lo (load form)) (.lo f))
                       (>= (sx-hi (load form)) (.hi f)))
              (break :found k))))
        -1)))

(defn tower-type-args-eq? [(x (ptr (ArrayList Type))) (y (ptr (ArrayList Type)))] (-> bool)
  (if (or (= (primitive/cast i64 x) 0)
          (= (primitive/cast i64 y) 0))
      (and (tower-list-empty? [Type] x) (tower-list-empty? [Type] y))
      (type-list-eq x y)))

(defn tower-bounds-eq? [(x (ptr (ArrayList Bound))) (y (ptr (ArrayList Bound)))] (-> bool)
  (if (!= (len (load x)) (len (load y)))
      false
      (let [(mut same) true]
        (for [i 0 (len (load x))]
          (let [bx (elem x i)
                by (elem y i)
                tx (load (field bx traits))
                ty (load (field by traits))]
            (if (or (!= (.name bx) (.name by)) (!= (len (load tx)) (len (load ty))))
                (set! same false)
                (for [j 0 (len (load tx))]
                  (let [px (elem tx j)
                        py (elem ty j)]
                    (unless (and (= (.name px) (.name py))
                                 (tower-type-args-eq? (load (field px args))
                                                      (load (field py args))))
                      (set! same false)
                      0))
                  0)))
          0)
        (load same))))

;;; Do two qualified functions present the checker the same signature? Every field
;;; `setup-one-sig` and `check-func` read outside the body is compared.
(defn tower-func-signature-eq? [(x (ptr Func)) (y (ptr Func))] (-> bool)
  (let [px (load (field x params))
        py (load (field y params))]
    (if (not (and (= (.name x) (.name y))
                  (and (cc-same? (.cc x) (.cc y))
                       (and (booleq (.macro_variadic x) (.macro_variadic y))
                            (and (booleq (.declared x) (.declared y))
                                 (and (def-names-equal? (load (field x type_params))
                                                        (load (field y type_params)))
                                      (and (tower-bounds-eq? (load (field x bounds))
                                                             (load (field y bounds)))
                                           (and (type-eq (field x ret) (field y ret))
                                                (= (len (load px))
                                                   (len (load py)))))))))))
        false
        (let [(mut same) true]
          (for [i 0 (len (load px))]
            (let [ax (elem px i)
                  ay (elem py i)]
              (unless (and (= (.name ax) (.name ay))
                           (and (booleq (.positional_only ax) (.positional_only ay))
                                (type-eq (field ax ty) (field ay ty))))
                (set! same false)
                0))
            0)
          (load same)))))

;;; Does this body reach only what the closure already holds? NAMES is the
;;; program's callable universe, WANTED this generation's closure.
(defn tower-probe-reach-known? [(a (dyn Allocator))
                                (fp (ptr Func))
                                (names (ptr FnNames))
                                (wanted (ptr (ArrayList (slice u8))))] (-> bool)
  (let [callees (box! a SBox (primitive/zeroed SBox))
        heads (box! a SBox (primitive/zeroed SBox))
        (mut known) true]
    (set! (.items callees) (ArrayList::new [(slice u8)] a))
    (set! (.items heads) (ArrayList::new [(slice u8)] a))
    (cc-list (load (field fp body)) names callees heads)
    (for [i 0 (len (.items callees))]
      (unless (set-contains wanted (get (.items callees) i))
        (set! known false)
        0)
      0)
    (for [i 0 (len (.items heads))]
      (unless (set-contains wanted
                            (closure-trait-head-key a (get (.items heads) i)))
        (set! known false)
        0)
      0)
    (load known)))

(defn tower-local-form-index [(a (dyn Allocator))
                              (sub-forms (ptr (ArrayList TaggedForm)))] (-> (HashMap (slice u8)
                                                                                     i64))
  (let [(mut index) (HashMap::new [(slice u8) i64] a (keyops))]
    (for [k 0 (len (load sub-forms))]
      (let [tf (elem sub-forms k)]
        (match (defn-name-of (field tf form))
          (Some [nm] (do (set! (mut index) (qualify-name a nm (.module tf)) k) 0))
          (None [] 0))))
    (load index)))

;;; What a probe of one rewritten function concluded.
(defsum TowerProbe
  (ProbeDeclined [])
  (ProbeClean [])
  (ProbeRejected [(diag Diag)]))

;;; What one local step did to the function.
(defsum TowerStep
  (StepStopped [])
  (StepConverged [])
  (StepRewrote []))

;;; One local step for the function in TF: probe its current syntax and, when the
;;; probe is admissible and rejected at a macro call, rewrite it.
;;;
;;; Every side-table entry the probe's qualification and check append borrows WA,
;;; so the step removes them before returning on every path.
(defn tower-local-step [(s (mut LS))
                        (tf (ptr TaggedForm))
                        (old (ptr Func))
                        (sub (ptr Program))
                        (methods (ptr (HashMap (slice u8) (ptr Func))))
                        (names (ptr FnNames))
                        (allfns (ptr SBox))
                        (macroctx (ptr Program))
                        (quals (ptr (ArrayList (slice u8))))
                        (cx (ptr Cx))
                        (wanted (ptr (ArrayList (slice u8))))
                        (bareok (ptr (ArrayList (slice u8))))
                        (shared (ptr ProbeBindings))
                        (wa (dyn Allocator))
                        (a (dyn Allocator))] (-> TowerStep)
  (let [mark (resolution-side-tables-mark)
        verdict
          (match (resolve-form-probe wa (mut s) (field tf form) (.module tf) bareok shared)
            (Err [_]
                 (do (tr/count "expand.tower.local-declined.parse" 1) (ProbeDeclined)))
            (Ok [probe]
                (let [single (tower-probe-single-func probe)
                      fp (if (= (primitive/cast i64 single) 0)
                             (tower-probe-impl-method wa probe sub methods (.name old))
                             single)]
                  (cond (= (primitive/cast i64 fp) 0)
                          (do (tr/count "expand.tower.local-declined.shape" 1)
                              (ProbeDeclined))
                        (not (tower-func-signature-eq? fp old))
                          (do (tr/count "expand.tower.local-declined.signature" 1)
                              (ProbeDeclined))
                        (not (tower-probe-reach-known? wa fp names wanted))
                          (do (tr/count "expand.tower.local-declined.reach" 1)
                              (ProbeDeclined))
                        :else
                          (match (check-func-probe wa cx fp true)
                            (None [] (ProbeClean))
                            (Some [d] (ProbeRejected d)))))))]
    (resolution-side-tables-truncate! mark)
    (match verdict
      (ProbeDeclined [] (StepStopped))
      (ProbeClean [] (StepConverged))
      (ProbeRejected [found]
                     (let [d (primitive/alloc-stack Diag)]
                       (set! d found)
                       (let [tc
                               (mk-tower-cx-with-names (mut s)
                                                       macroctx
                                                       quals
                                                       a
                                                       allfns
                                                       (.lo d)
                                                       (.hi d)
                                                       (.source d))]
                         (set! (.module tc) (.module tf))
                         (set! (.hit tc) 0)
                         (match (tower-rewrite tc (mut s) (field tf form))
                           (Err [_]
                                (do (tr/count "expand.tower.local-declined.expansion-error" 1)
                                    (StepStopped)))
                           (Ok [next]
                               (if (= (.hit tc) 0)
                                   (do (tr/count "expand.tower.local-declined.not-a-macro-call"
                                                 1)
                                       (StepStopped))
                                   (do (tagged-rewrite! tf next) (StepRewrote)))))))))))

;;; Converge every function this generation rejected and the tower rewrote.
;;; REVISIONS holds each sub-form's revision from before that rewrite; OWNERS is the
;;; failed check's per-diagnostic owner list. Returns how many functions converged.
(defn tower-local-converge! [(s (mut LS))
                             (sub-forms (ptr (ArrayList TaggedForm)))
                             (revisions (ptr (ArrayList i64)))
                             (macroctx (ptr Program))
                             (quals (ptr (ArrayList (slice u8))))
                             (cx (ptr Cx))
                             (sub (ptr Program))
                             (wanted (ptr (ArrayList (slice u8))))
                             (bareok (ptr (ArrayList (slice u8))))
                             (owners (ptr (ArrayList (slice u8))))
                             (wa (dyn Allocator))
                             (a (dyn Allocator))] (-> i64)
  (let [n (len (load owners))
        limit (stage3-max-rounds sub-forms)
        (mut prepared) false
        (mut index) (primitive/zeroed (HashMap (slice u8) i64))
        (mut names) (primitive/cast (ptr FnNames) 0)
        (mut methods) (primitive/cast (ptr (HashMap (slice u8) (ptr Func))) 0)
        (mut allfns) (primitive/cast (ptr SBox) 0)
        (mut visited) (ArrayList::new [(slice u8)] wa)
        shared (probe-bindings-new wa)
        (mut probes) 0
        (mut converged) 0]
    (for [i 0 n]
      (let [owner (get (load owners) i)]
        (unless (= owner "")
          (unless (load prepared)
            (set! index (tower-local-form-index wa sub-forms))
            (set! names (prog-fn-names macroctx wa))
            (set! methods (tower-closure-methods wa sub))
            (set! prepared true)
            0)
          ; A function's form is the defn of its name; an impl method's is the
          ; impl form that holds it.
          (let [old (tower-closure-func sub (load methods) owner)
                at (get (load index) owner)
                defn-form (match at (Some [_] true) (None [] false))
                k (match at
                    (Some [k] k)
                    (None []
                          (if (= (primitive/cast i64 old) 0)
                              -1
                              (tower-func-form sub-forms old))))]
            (when (>= k 0)
                  (let [tf (elem sub-forms k)]
                    (when (and (not (set-contains (mut visited) owner))
                               (and (!= (.revision tf) (get (load revisions) k))
                                    (!= (primitive/cast i64 old) 0)))
                      (push! (mut visited) owner)
                      (let [(mut iteration) 0]
                        (loop
                          (when (>= (load iteration) limit) (break))
                          (set! iteration (+ (load iteration) 1))
                          (set! probes (+ (load probes) 1))
                          ; Module functions are read by every expansion; the list is
                          ; built once for the phase and rebuilt only after a rewrite
                          ; renamed a declaration (below).
                          (when (= (primitive/cast i64 (load allfns)) 0)
                            (set! allfns (all-defn-names sub-forms wa))
                            0)
                          (let [step
                                  (tower-local-step (mut s)
                                                    tf
                                                    old
                                                    sub
                                                    (load methods)
                                                    (load names)
                                                    (load allfns)
                                                    macroctx
                                                    quals
                                                    cx
                                                    wanted
                                                    bareok
                                                    shared
                                                    wa
                                                    a)]
                            (match step
                              (StepConverged [] (set! converged (+ (load converged) 1)))
                              (_ 0))
                            (match step
                              (StepRewrote [] 0)
                              (_ (break)))
                            ; A rewrite that renamed the declaration changes the
                            ; module function list; rebuild it before the next step.
                            ; A rewrite inside an impl renames none of its methods.
                            (unless (or (not defn-form)
                                        (match (defn-name-of (field tf form))
                                          (Some [nm] (= (qualify-name wa nm (.module tf)) owner))
                                          (None [] false)))
                              (set! allfns (primitive/cast (ptr SBox) 0))
                              0))))
                      0)
                    0)))
          0)
        0))
    (tr/count "expand.tower.local-probes" (load probes))
    (tr/count "expand.tower.local-converged" (load converged))
    (load converged)))

; How many tower generations definition-time expansion may take before it is
; treated as non-convergent.
;
; Each generation resolves ONE more layer of the macro tower, so the rounds a
; legitimate program needs grow with how many macro-bearing modules it pulls in --
; this is a depth bound, not a complexity bound. A flat 64 was therefore the wrong
; shape: `coil check` on a file importing ~40 stdlib namespaces (the manifest gate's
; own aggregate smoke) needs 69, converges fine at 70, and was rejected at 64 with a
; message claiming it had not converged. It had; the ceiling was just under it.
;
; So the ceiling scales with the program, with the old 64 kept as the floor so small
; programs are unaffected. The cap still exists to stop a genuinely divergent tower,
; which is why this is not simply unbounded.
(defn stage3-max-rounds [(sub-forms (ptr (ArrayList TaggedForm)))] (-> i64)
  (let [n (len (load sub-forms))
        scaled (primitive/iadd 64 n)]
    (if (> scaled 4096) 4096 scaled)))

(defn release-stage3-arena [(raw (ptr i8))] (-> i64)
  (tr/arena-snapshot "expansion.stage3-resource"
                     (primitive/cast (ptr scratch/ScratchArena) raw))
  (close! (primitive/cast (ptr scratch/ScratchArena) raw)))

(defn phase-constant? [(parent (ptr LS)) (name (slice u8))] (-> bool)
  (checkedbase/checked-base-phase-constant?
    (primitive/cast (ptr checkedbase/CheckedBase) (.persistent_checked parent))
    name))

;;; Materialize the retained facade's compact phase segment in generation-local
;;; scratch. Accepted state owns only persistent phase-name tries; every Func,
;;; checker map and declaration table remains the facade's canonical object.
(defn stage3-phase-parent [(a (dyn Allocator)) (parent (ptr LS))] (-> (ptr LS))
  (if (= (primitive/cast i64 parent) 0)
    parent
    (let [view (box! a LS (load parent))
          program (box! a Program (load (.checked parent)))
          (mut functions) (ArrayList::new [Func] a)
          (mut constants) (ArrayList::new [Const] a)]
      (checkedbase/checked-base-phase-functions!
        (primitive/cast (ptr checkedbase/CheckedBase) (.persistent_checked parent))
        (mut functions))
      (set! (.funcs program) (box-al [Func] a (load functions)))
      (checkedbase/checked-base-phase-constants!
        (primitive/cast (ptr checkedbase/CheckedBase) (.persistent_checked parent))
        (.consts (.checked parent)) (mut constants))
      (set! (.consts program) (box-al [Const] a (load constants)))
      (set! (.checked_functions view)
        (HashMap::new [(slice u8) i64] a (keyops-borrowed)))
      (ls-accept-checked! (mut view) program)
      (set! (.meta_environment view) (primitive/cast (ptr LS) 0))
      view)))

;;; Is every compile-time function of MACROCTX linked from a compile-time unit
;;; (a declaration, no body here), and every macro already in the engine? Then
;;; stage 3 compiles nothing: its closure is declarations, and no image is built.
(defn stage3-all-prebuilt? [(macroctx (ptr Program))
                            (quals (ptr (ArrayList (slice u8))))
                            (phase-owned (ptr (ArrayList (slice u8))))
                            (a (dyn Allocator))] (-> bool)
  (and (block :macros
         (for [i 0 (len (load quals))]
           (when (< (meta-engine-entry-index (get (load quals) i)) 0) (break :macros false)))
         true)
       (let [compile-time (compile-time-seeds macroctx quals phase-owned a)]
         (block :bodies
           (for [i 0 (len (load compile-time))]
             (let [f (prog-fn-find macroctx (get (load compile-time) i))]
               (when (or (= (primitive/cast i64 f) 0) (not (.declared f)))
                 (break :bodies false))))
           true))))

;;; The whole-program resolve of the macro tower and of the program's generators,
;;; which read only what their compile-time code reaches. Function bodies stay
;;; unparsed until the closure walk reaches them (resolve.coil, LazyBody), except
;;; where something reads them all: a lint analysis records facts about every
;;; authored node as it is qualified, and the interpreter engine runs from the
;;; macro context.
(defn stage3-resolve [(a (dyn Allocator))
                      (subls (mut LS))
                      (bareok-slot (ptr (ptr (ArrayList (slice u8)))))] (-> (Result (ptr Program) Diag))
  (let [mode (lazy-bodies-mode)
        prior (.on mode)]
    (set! (.on mode) (and (meta-compiled?)
                          (and (not (meta-interp-requested?))
                               (not (.enabled (source-facts))))))
    (let [result (resolve-program-into a (mut subls) false true bareok-slot)]
      (set! (.on mode) prior)
      result)))

;;; Drop from QUALS each macro whose body the closure walk found does not parse:
;;; a tolerant resolve skips such a definition, so it was never a macro there.
(defn drop-unparsed-quals! [(p (ptr Program)) (quals (ptr (ArrayList (slice u8))))] (-> i64)
  (let [(mut kept) 0]
    (for [i 0 (len (load quals))]
      (let [q (get (load quals) i)
            f (prog-fn-find p q)]
        (unless (and (!= (primitive/cast i64 f) 0) (lazy-body-failed? f))
          (store! (elem quals (load kept)) q)
          (set! kept (+ (load kept) 1))
          0)))
    (set! (.len quals) (load kept)))
  0)

(defn stage3-round [(s (mut LS))
                    (sub-forms (ptr (ArrayList TaggedForm)))
                    (a (dyn Allocator))
                    (round i64)
                    (nmain i64)
                    (authored (ptr (ArrayList TaggedForm)))
                    (original-metas (ptr (ArrayList TaggedForm)))
                    (excluded (ptr (ArrayList (slice u8))))
                    (exclude-closure bool)
                    ; SUB-FORMS started from a previous generation's rewrites
                    ; (`tower-resume-forms!`), so even round 0 differs from s.out.
                    (resumed bool)] (-> (Result i64
                                                        Diag))
  (let [capture-span (tr/span-begin "frontend.expand.round.capture-metas")]
    (tower-capture-metas! a sub-forms original-metas)
    (tr/span-end capture-span))
  ; Each failed tower generation builds a complete tolerant Program and checked
  ; closure. Those are generation-local. Keeping them in the compiler's root arena
  ; retained every failed generation until process exit. A segmented scratch arena
  ; lets retry paths release the entire generation in O(number-of-segments).
  ; Successful generations lend checked closure/registry data to the engine and
  ; semantic model, so they cannot close at this function's return. Own them in
  ; the enclosing unit instead. Retry paths can still close early; an arena's close!
  ; is idempotent when the unit later releases its registered resource.
  (let [work
          (box! (unit-allocator)
                scratch/ScratchArena
                (primitive/zeroed scratch/ScratchArena))
        _work-init
          (scratch/ScratchArena::init-with-capacity work (retained-heap/compiler-scratch-parent) 1048576)
        _work-own
          (unit-resource-kinded! (primitive/cast (ptr i8) work)
                                 (primitive/fnptr-of release-stage3-arena)
                                 UNIT-RESOURCE-EXPANSION-ARENA)
        wa (allocator work)
        phase-parent (stage3-phase-parent wa (ls-meta-parent (mut s)))
        subls (primitive/alloc-stack LS)
        bareok-slot (primitive/alloc-stack (ptr (ArrayList (slice u8))))
        cx-slot (primitive/alloc-stack (ptr Cx))]
    (store! bareok-slot (primitive/cast (ptr (ArrayList (slice u8))) 0))
    (store! cx-slot (primitive/cast (ptr Cx) 0))
    ; Resolved state is retained by the compilation workspace and may be used by
    ; nested lazy engine setup. It must not live in the disposable generation
    ; arena; that ownership mismatch was masked by a second root-arena resolve.
    (ls-init! (mut subls) a)
    (set! (.out subls) (load sub-forms))
    (set! (.loaded subls) (ArrayList::new [(slice u8)] a))
    (set! (.readpaths subls) (ArrayList::new [(slice u8)] a))
    (set! (.readmods subls) (ArrayList::new [(slice u8)] a))
    (set! (.imports subls) (.imports s))
    (set! (.exports subls) (.exports s))
    (set! (.primitive_defs subls) (.primitive_defs s))
    (set! (.primitive_aliases subls) (.primitive_aliases s))
    (ls-borrow-semantics! (mut subls) (mut s))
    (set! (.parent subls) phase-parent)
    (let [resolve-span (tr/span-begin "frontend.expand.round.resolve")
          resolve-result
            (stage3-resolve a (mut subls) bareok-slot)
          _resolve-end (tr/span-end resolve-span)]
      (match resolve-result
        (Err [d] (Err [i64 Diag] d))
        (Ok [macroctx]
            ; A later-phase entry owns its transitive helper closure. Otherwise a
            ; Code-signed helper in a reader-provider body is selected as an ordinary
            ; definition-time macro and executes against the body's syntax (`context`)
            ; rather than the invocation-time Code value supplied by the reader.
            (let [phase-owned
                    (if exclude-closure
                        (closure-module-funcs-pruned macroctx excluded wa)
                        excluded)
                  quals (code-sig-funcs-except macroctx phase-owned wa)]
              ; record this round's forms for the LAZY stager: finish-macro stages a
              ; qual on its first miss (see stage-one-macro!). Recording is free; the
              ; per-round refresh keeps the convergence property (a qual unstageable in
              ; round N often stages in round N+1, after the tower expanded a call in
              ; one of its callees).
              (when (meta-compiled?)
                (stage-box-set! (mut s)
                                sub-forms
                                (persist-names phase-owned a)
                                macroctx
                                a))
              (if (= (len (load quals)) 0)
                  (if (.host_role s)
                      (host-stage-record! (mut s)
                                          (primitive/cast (ptr (ArrayList TaggedForm)) 0)
                                          (primitive/cast (ptr (ArrayList TaggedForm)) 0)
                                          quals
                                          (primitive/cast (ptr (ArrayList (slice u8))) 0)
                                          (primitive/cast (ptr (ArrayList (slice u8))) 0)
                                          (primitive/cast (ptr Program) 0))
                      (Ok [i64 Diag] 0))
                  ; PARSE-level tower: a defn the tolerant resolve SKIPPED may contain a
                  ; macro call whose arguments are not expression syntax (objc `msg`
                  ; type vectors) — expand it and re-resolve before anything else.
                  (let [recover-span
                          (tr/span-begin "frontend.expand.round.parse-recover")
                        recover-result
                          (stage3-parse-recover (mut s)
                                                sub-forms
                                                macroctx
                                                quals
                                                a
                                                true)
                        _recover-end (tr/span-end recover-span)]
                    (match recover-result
                      (Err [d] (Err [i64 Diag] d))
                      (Ok [phit]
                          (if (!= phit 0)
                              (if (>= round (stage3-max-rounds sub-forms))
                                  (Err [i64 Diag]
                                       (derr "metaprogram definition-time expansion did not reach a fixpoint"))
                                  (let [release-span
                                          (tr/span-begin "frontend.expand.round.release")
                                        _release (close! work)
                                        _release-end (tr/span-end release-span)
                                        rr
                                          (stage3-round (mut s)
                                                        sub-forms
                                                        a
                                                        (primitive/iadd round 1)
                                                        nmain
                                                        authored
                                                        original-metas
                                                        excluded
                                                        exclude-closure
                                                        resumed)]
                                    rr))
                              ; the closure seeds gain the shim functions under the compiled engine:
                              ; lowering creates calls to them AFTER this walk runs.
                              (let [closure-span
                                      (tr/span-begin "frontend.expand.round.closure")
                                    compile-time (compile-time-seeds macroctx quals phase-owned wa)
                                    ; the shim rides along only into an image this round
                                    ; builds; a program whose compile-time code is all
                                    ; linked from units (stage3-all-prebuilt?) builds none
                                    seeds
                                      (if (and (meta-compiled?)
                                               (not (stage3-all-prebuilt? macroctx quals phase-owned wa)))
                                          (meta-shim-seeds wa macroctx compile-time)
                                          compile-time)
                                    closure-ctx (with-constant-lengths wa macroctx)
                                    wanted (closure-funcs closure-ctx seeds wa)
                                    sub (closure-subprogram closure-ctx wanted wa)
                                    _unparsed (drop-unparsed-quals! macroctx quals)
                                    _closure-end (tr/span-end closure-span)
                                    checkls (primitive/alloc-stack LS)]
                                (ls-init! (mut checkls) wa)
                                (set! (.parent checkls) phase-parent)
                                (set! (.out checkls) (ArrayList::new [TaggedForm] wa))
                                (set! (.loaded checkls)
                                      (ArrayList::new [(slice u8)] wa))
                                (set! (.readpaths checkls)
                                      (ArrayList::new [(slice u8)] wa))
                                (set! (.readmods checkls)
                                      (ArrayList::new [(slice u8)] wa))
                                ; The closure's code is the program's, and its trait
                                ; methods are in scope as the program's imports refer them.
                                (set! (.imports checkls) (ls-copy-list [ImpEntry] wa (.imports s)))
                                (set! (.exports checkls) (ls-copy-list [ExpEntry] wa (.exports s)))
                                (set! (.primitive_defs checkls)
                                      (ArrayList::new [PrimitiveDef] wa))
                                (set! (.primitive_aliases checkls)
                                      (ArrayList::new [PrimitiveAlias] wa))
                                ; this LS checks a closure sub-program WITHOUT a resolve pass, so the
                                ; poison list must be nulled or func-poisoned? reads garbage.
                                (set! (.check_diags checkls)
                                      (box-al [Diag] wa (ArrayList::new [Diag] wa)))
                                (set! (.resolve_diags checkls)
                                      (primitive/cast (ptr (ArrayList Diag)) 0))
                                (set! (.resolve_poisoned checkls)
                                      (primitive/cast (ptr (ArrayList (slice u8)))
                                                      0))
                                ; The closure check's semantic tables belong to this
                                ; generation like the rest of its check. A retry
                                ; puts back the maps from before the check, then
                                ; closes `work`; the last generation keeps both.
                                (let [round-maps (primitive/alloc-stack SemMapsSnap)
                                      _round-maps (sem-maps-save round-maps)
                                      prior-meta (.meta_environment s)
                                      check-span
                                        (tr/span-begin "frontend.expand.round.typecheck")
                                      _closure-size
                                        (tr/count "expand.round.closure.funcs"
                                                  (len (load (field sub funcs))))
                                      _closure-quals
                                        (tr/count "expand.round.closure.quals"
                                                  (len (load quals)))
                                      prior-tables (sem-tables-allocator-enter! wa)
                                      check-result
                                        (check-closure-program-into wa
                                                                    sub
                                                                    (mut checkls)
                                                                    cx-slot)
                                      _tables (sem-tables-allocator-leave! prior-tables)
                                      _check-end (tr/span-end check-span)]
                                  (match check-result
                                    (Ok [checked]
                                        (retain-meta-environment! a (mut s) (mut checkls) checked (mut subls))
                                        ; Do not invoke a skipped macro body until the
                                        ; parsed macro closure has passed its check.
                                        (match (stage3-parse-recover (mut s)
                                                                     sub-forms
                                                                     macroctx
                                                                     quals
                                                                     a
                                                                     false)
                                          (Err [d] (Err [i64 Diag] d))
                                          (Ok [phit]
                                              (if (!= phit 0)
                                                  (if (>= round
                                                          (stage3-max-rounds sub-forms))
                                                      (Err [i64 Diag]
                                                           (derr "metaprogram definition-time expansion did not reach a fixpoint"))
                                                      (do
                                                        ; The environment just retained
                                                        ; is this generation's, in `work`.
                                                        (set! (.meta_environment s) prior-meta)
                                                        (sem-maps-restore round-maps)
                                                        (close! work)
                                                        (stage3-round (mut s)
                                                                      sub-forms
                                                                      a
                                                                      (+ round
                                                                         1)
                                                                      nmain
                                                                      authored
                                                                      original-metas
                                                                      excluded
                                                                      exclude-closure
                                                                      resumed)))
                                                  ; Snapshot only the successful generation. Taking
                                                  ; this full-program copy at function entry retained
                                                  ; one copy in every recursive tower frame (often
                                                  ; 15+ copies and several GiB) even though failures
                                                  ; immediately recurse and never consume it.
                                                  (let [snapshot-span
                                                          (tr/span-begin "frontend.expand.round.snapshot")
                                                        tower-out
                                                          (tower-snapshot-shallow a
                                                                                  sub-forms
                                                                                  nmain)
                                                        _snapshot-end
                                                          (tr/span-end snapshot-span)]
                                                    ; compiled engine: lower + build + dlopen the metaprogram dylib
                                                    ; ONCE; finish-macro then routes every entry through it.
                                                    (let [setup-span
                                                            (tr/span-begin "frontend.expand.round.engine-setup")
                                                          setup-result
                                                            (if (meta-compiled?)
                                                                (meta-engine-setup a
                                                                                   checked
                                                                                   quals)
                                                                (None [Diag]))
                                                          _setup-end
                                                            (tr/span-end setup-span)]
                                                      (match setup-result
                                                        (Some [d]
                                                              (Err [i64 Diag] d))
                                                        (None []
                                                              (if (.host_role s)
                                                                (host-stage-record! (mut s)
                                                                                    authored
                                                                                    tower-out
                                                                                    quals
                                                                                    compile-time
                                                                                    wanted
                                                                                    checked)
                                                              (do
                                                                (when (or (> round
                                                                             0)
                                                                          resumed)
                                                                  (tower-sync-out! (mut s)
                                                                                   tower-out))
                                                                (let [expand-span
                                                                        (tr/span-begin "frontend.expand.round.run-expand")
                                                                      expand-result
                                                                        (run-expand (mut s)
                                                                                    authored
                                                                                    tower-out
                                                                                    quals
                                                                                    wanted
                                                                                    checked
                                                                                    a)
                                                                      _expand-end
                                                                        (tr/span-end expand-span)]
                                                                  (match expand-result
                                                                    (Err [d]
                                                                         (Err [i64
                                                                               Diag]
                                                                              d))
                                                                    (Ok [expanded]
                                                                      (if (= expanded 2)
                                                                        (stage3-restart! (mut s) excluded exclude-closure authored tower-out)
                                                                        (do
                                                                          (let [restore-span
                                                                                  (tr/span-begin "frontend.expand.round.restore-metas")]
                                                                            (tower-restore-metas! (mut s)
                                                                                                  original-metas)
                                                                            (tr/span-end restore-span))
                                                                          (Ok [i64
                                                                               Diag]
                                                                              0))))))))))))))))
                                    (Err [d]
                                         ; the tower: if the check rejected the sub-program AT a
                                         ; macro-headed call form, expand that call and go again; if it
                                         ; rejected a call to a SKIPPED defn, recover that defn.
                                         (if (>= round
                                                 (stage3-max-rounds sub-forms))
                                             (Err [i64 Diag]
                                                  (derr "metaprogram definition-time expansion did not reach a fixpoint"))
                                             (let [revisions
                                                     (let [(mut rs) (ArrayList::new [i64] wa)]
                                                       (for [k 0 (len (load sub-forms))]
                                                         (push! (mut rs)
                                                                (.revision (elem sub-forms
                                                                                 k))))
                                                       (box-al [i64] wa (load rs)))
                                                   recover-span
                                                     (tr/span-begin "frontend.expand.round.recover")
                                                   recover-result
                                                     (tower-pass-diags (mut s)
                                                                       sub-forms
                                                                       macroctx
                                                                       quals
                                                                       (load (field checkls
                                                                                    check_diags))
                                                                       a)
                                                   _recover-end
                                                     (tr/span-end recover-span)]
                                               (match recover-result
                                                 (Err [d2] (Err [i64 Diag] d2))
                                                 (Ok [hit]
                                                     (if (= hit
                                                            0)
                                                         ; A real error — unless the program's own (meta …)
                                                         ; forms would declare what the closure is missing: a
                                                         ; library function a macro calls may read a constant
                                                         ; its module generates (coil.fs's O_CREAT). Run those
                                                         ; generators now and expand again; if they cannot run
                                                         ; yet, the original error stands.
                                                         (if (> (len (load original-metas)) 0)
                                                             (match (elaborate-metas-from-tower! a (mut s) sub-forms)
                                                               (Err [_] (Err [i64 Diag] d))
                                                               (Ok [_] (stage3-restart! (mut s) excluded exclude-closure authored sub-forms)))
                                                             (Err [i64 Diag] d))
                                                         ; the let defeats self-tail-call elimination (musttail
                                                         ; rejects this frame); depth is bounded by the 64-round cap
                                                         (let [local-span
                                                                 (tr/span-begin "frontend.expand.round.local")
                                                               _local
                                                                 (unless (or (= (primitive/cast i64
                                                                                                (load cx-slot))
                                                                                0)
                                                                             (= (primitive/cast i64
                                                                                                (load bareok-slot))
                                                                                0))
                                                                   (tower-local-converge! (mut s)
                                                                                          sub-forms
                                                                                          revisions
                                                                                          macroctx
                                                                                          quals
                                                                                          (load cx-slot)
                                                                                          sub
                                                                                          wanted
                                                                                          (load bareok-slot)
                                                                                          (load (field checkls
                                                                                                       check_diag_owners))
                                                                                          wa
                                                                                          a)
                                                                   0)
                                                               _local-end
                                                                 (tr/span-end local-span)
                                                               release-span
                                                                 (tr/span-begin "frontend.expand.round.release")
                                                               _maps
                                                                 (sem-maps-restore round-maps)
                                                               _release
                                                                 (close! work)
                                                               _release-end
                                                                 (tr/span-end release-span)
                                                               rr
                                                                 (stage3-round (mut s)
                                                                               sub-forms
                                                                               a
                                                                               (primitive/iadd round
                                                                                               1)
                                                                               nmain
                                                                               authored
                                                                               original-metas
                                                                               excluded
                                                                               exclude-closure
                                                                               resumed)]
                                                           rr)))))))))))))))))))))

; ── whole-program CHECKERS ───────────────────────────────────────────────────
; `(checker FN)` registers FN — a [(prog Code)] -> Code function — to be run once,
; after expansion, over the WHOLE program (all top-level forms as one Code list).
; A checker VETOES compilation by calling `error`; its returned Code is ignored.
; FN is Code-signed so the existing macro machinery already type-checks it; we just
; invoke it here via expand-macro with the program as its single argument.
(defn is-checker-form [(f (ptr Sexp))] (-> bool)
  (and (= (sx-tag (load f)) 6)
       (let [it (sx-items (load f))]
         (and (or (= (sx-len it) 2)
                  (= (sx-len it) 4))
              (and (= (sx-tag (sx-at it 0)) 2)
                   (= (sx-sval (sx-at it 0)) "checker"))))))

;;; The phase a `checker` or `transform` registration F names, resolved where it
;;; was written: None for the two-item form, which runs on the checked program.
;;; The `:phase` value is a coil.phase.Phase constructor, `(phase/BeforeExpand)`;
;;; anything else is an error rather than another pipeline.
(defn registration-phase [(f (ptr Sexp))
                          (module (Option (slice u8)))
                          (impb (ptr (ArrayList ImpEntry)))
                          (expb (ptr (ArrayList ExpEntry)))
                          (a (dyn Allocator))] (-> (Result (Option phase/Phase) Diag))
  (let [it (sx-items (load f))
        head (sx-sval (sx-at it 0))
        wrong (derr (sconcat a
                             head
                             ": :phase takes a coil.phase.Phase, such as (phase/BeforeExpand), (phase/AfterExpand), (phase/Ownership) or (phase/Read), with (import \"coil.phase\" :as phase)"))]
    (if (!= (sx-len it) 4)
        (Ok [(Option phase/Phase) Diag] (None [phase/Phase]))
        (let [key (sx-at it 2)
              value (sx-at it 3)]
          (if (not (and (= (sx-tag key) 3)
                        (= (sx-sval key) "phase")
                        (= (sx-tag value) 6)
                        (= (sx-len (sx-items value)) 1)
                        (= (sx-tag (sx-at (sx-items value) 0)) 2)))
              (Err [(Option phase/Phase) Diag] wrong)
              (let [ctor (sx-at (sx-items value) 0)
                    space (primitive/alloc-stack NameSpace)]
                (store! space (PhaseNames))
                (match (resolve-in-space (sx-sval ctor) (macro-module-of ctor module) space impb expb a)
                  (Err [d] (Err [(Option phase/Phase) Diag] d))
                  (Ok [found]
                      (match found
                        (Some [q] (Ok [(Option phase/Phase) Diag] (phase-named q)))
                        (None [] (Err [(Option phase/Phase) Diag] wrong)))))))))))

;;; Whether registration F, written in MODULE, names PHASE. A registration whose
;;; phase does not resolve names none; the registration pass reports it.
(defn registration-in-phase? [(f (ptr Sexp))
                              (module (Option (slice u8)))
                              (impb (ptr (ArrayList ImpEntry)))
                              (expb (ptr (ArrayList ExpEntry)))
                              (a (dyn Allocator))
                              (phase phase/Phase)] (-> bool)
  (match (registration-phase f module impb expb a)
    (Ok [found]
        (match found
          (Some [p]
                (match p
                  (phase/BeforeExpand [] (match phase (phase/BeforeExpand [] true) (_ false)))
                  (phase/AfterExpand [] (match phase (phase/AfterExpand [] true) (_ false)))
                  (phase/Ownership [] (match phase (phase/Ownership [] true) (_ false)))
                  (phase/Read [] (match phase (phase/Read [] true) (_ false)))))
          (None [] false)))
    (Err [_] false)))

(defsum ReadProviderResult
  (ReadDefault [])
  (ReadForms [(form Sexp)])
  (ReadFailed [(diag Diag)]))

; Combine two independently checked semantic-map snapshots without mutating
; either one. Node ids are process-unique, but local binding ids restart at one
; for each check, so the shim's positive ids are offset past the settled graph.
(defn combine-sem-maps [(a (dyn Allocator))
                        (base (ptr SemMapsSnap))
                        (extra (ptr SemMapsSnap))] (-> SemMapsSnap)
  (let [out (primitive/alloc-stack SemMapsSnap)
        (mut ts) (ArrayList::new [TypeMapEntry] a)
        (mut ti) (HashMap::new [i64 i64] a (i64-keyops))
        (mut bs) (ArrayList::new [BindMapEntry] a)
        (mut bi) (HashMap::new [i64 i64] a (i64-keyops))
        (mut rs) (ArrayList::new [ResMapEntry] a)
        (mut ri) (HashMap::new [i64 (slice u8)] a (i64-keyops))]
    (for [i 0 (len (.tlist base))]
      (let [e (get (.tlist base) i)
            ep (primitive/alloc-stack TypeMapEntry)]
        (set! ep e)
        (push! (mut ts) e)
        (set! (mut ti) (.node-id ep) (primitive/isub (len (load ts)) 1)))
      0)
    (for [i 0 (len (.tlist extra))]
      (let [e (get (.tlist extra) i)
            ep (primitive/alloc-stack TypeMapEntry)]
        (set! ep e)
        (push! (mut ts) e)
        (set! (mut ti) (.node-id ep) (primitive/isub (len (load ts)) 1)))
      0)
    (for [i 0 (len (.blist base))]
      (let [e (get (.blist base) i)
            ep (primitive/alloc-stack BindMapEntry)]
        (set! ep e)
        (push! (mut bs) e)
        (set! (mut bi) (.node-id ep) (primitive/isub (len (load bs)) 1)))
      0)
    (for [i 0 (len (.blist extra))]
      (let [src (get (.blist extra) i)
            dst (primitive/alloc-stack BindMapEntry)]
        (set! dst src)
        (when (> (.bid dst) 0)
          (set! (.bid dst) (primitive/iadd (.bnext base) (.bid dst)))
          0)
        (push! (mut bs) (load dst))
        (set! (mut bi) (.node-id dst) (primitive/isub (len (load bs)) 1)))
      0)
    (for [i 0 (len (.rlist base))]
      (let [e (get (.rlist base) i)
            ep (primitive/alloc-stack ResMapEntry)]
        (set! ep e)
        (push! (mut rs) e)
        (set! (mut ri) (.node-id ep) (.name ep)))
      0)
    (for [i 0 (len (.rlist extra))]
      (let [e (get (.rlist extra) i)
            ep (primitive/alloc-stack ResMapEntry)]
        (set! ep e)
        (push! (mut rs) e)
        (set! (mut ri) (.node-id ep) (.name ep)))
      0)
    (set! (.tlist out) (load ts))
    (set! (.tindex out) (load ti))
    (set! (.blist out) (load bs))
    (set! (.bindex out) (load bi))
    (set! (.bnext out) (primitive/iadd (.bnext base) (.bnext extra)))
    (set! (.rlist out) (load rs))
    (set! (.rindex out) (load ri))
    ; The combined maps read through to the authoritative side's base. The extra
    ; side's listed entries were renumbered above; entries it only reads through
    ; to cannot be, so a different base there has no correct combination.
    (unless (or (= (.base extra) (sem-no-base)) (= (.base extra) (.base base)))
      (ps (stderr)
          "error: combine-sem-maps: the extra maps read through to a different persistent base (compiler bug)\n")
      (abort)
      0)
    (set! (.base out) (.base base))
    (load out)))

; Both inputs are already qualified and checked. Merge declarations only; doing a
; source-level resolve here would throw away declarations produced by top-level
; metas, while rechecking the settled Program is invalid after checking has
; normalized its function signatures.
(defn merge-checked-read-programs [(a (dyn Allocator))
                                   (settled (ptr Program))
                                   (shim (ptr Program))] (-> (Result (ptr Program)
                                                                     Diag))
  (let [o (primitive/alloc-stack Out)]
    (init-out o a)
    (match (merge-into (mut o) settled a)
      (Err [d] (Err [(ptr Program) Diag] d))
      (Ok [_]
          (match (merge-into (mut o) shim a)
            (Err [d] (Err [(ptr Program) Diag] d))
            (Ok [_] (Ok [(ptr Program) Diag] (out->program o a))))))))

; Compile the reader against the authoritative checked setup plus a separately
; checked metashim. No provider/import source is reparsed, no macro expansion is
; repeated, and top-level meta effects remain exactly the declarations already in
; AUTHORITATIVE.
(defstruct PreparedReadProgram
  [(program (ptr Program)) (maps (ptr SemMapsSnap))])

(defn prepare-read-program [(a (dyn Allocator))
                            (s (mut LS))
                            (authoritative (ptr Program))
                            (name (slice u8))] (-> (Result PreparedReadProgram
                                                           Diag))
  (let [entry (prog-fn-find authoritative name)]
    (if (= (primitive/cast i64 entry) 0)
        (Err [PreparedReadProgram Diag]
             (derr (sconcat3 a
                             "read phase: provider '"
                             name
                             "' is absent from the settled program")))
        (if (not (and (type-is-code (field entry ret))
                      (all-params-code (load (field entry params)))))
            (Err [PreparedReadProgram Diag]
                 (derr "read phase: provider must take only Code parameters and return Code"))
            (prepare-meta-program a (mut s) authoritative)))))

;;; AUTHORITATIVE, a settled checked program, merged with a separately checked
;;; metashim, and the semantic maps of both: what metalower compiles a native
;;; metaprogram image from. The current semantic maps must be AUTHORITATIVE's.
(defn prepare-meta-program [(a (dyn Allocator))
                            (s (mut LS))
                            (authoritative (ptr Program))] (-> (Result PreparedReadProgram
                                                                       Diag))
  (let [auth-maps (primitive/alloc-stack SemMapsSnap)
        invls (primitive/alloc-stack LS)]
    (sem-maps-save auth-maps)
    (ls-init! (mut invls) a)
    ; Reuse the settled loader tables so metashim's compiler-owned
    ; imports are bookkeeping-only. Its source graph is otherwise empty.
    (set! (.loaded invls) (.loaded s))
    (set! (.readpaths invls) (.readpaths s))
    (set! (.readmods invls) (.readmods s))
    (set! (.imports invls) (.imports s))
    (set! (.exports invls) (.exports s))
    (set! (.primitive_defs invls) (.primitive_defs s))
    (set! (.primitive_aliases invls) (.primitive_aliases s))
    (set! (.srccount invls) (.srccount s))
    (set! (.sources invls) (.sources s))
    (set! (.expansions invls) (.expansions s))
    (set! (.namespace_names invls) (.namespace_names s))
    (set! (.namespace_paths invls) (.namespace_paths s))
    (set! (.entry_module invls) (.entry_module s))
    (match (meta-sub-forms a
                           (mut invls)
                           (box-al [TaggedForm]
                                   a
                                   (ArrayList::new [TaggedForm] a)))
      (Err [d]
           (do
             (sem-maps-restore auth-maps)
             (Err [PreparedReadProgram Diag] d)))
      (Ok [shim-forms]
          (do
            (set! (.out invls) (load shim-forms))
            (match (resolve-program a (mut invls) true false)
              (Err [d]
                   (do
                     (sem-maps-restore auth-maps)
                     (Err [PreparedReadProgram Diag] d)))
              (Ok [shim-resolved]
                  (let [checkls (primitive/alloc-stack LS)]
                    (ls-init! (mut checkls) a)
                    (set! (.imports checkls) (.imports invls))
                    (set! (.exports checkls) (.exports invls))
                    (set! (.primitive_defs checkls)
                          (.primitive_defs invls))
                    (set! (.primitive_aliases checkls)
                          (.primitive_aliases invls))
                    (set! (.entry_module checkls)
                          (.entry_module invls))
                    (match (check-program a
                                          shim-resolved
                                          (mut checkls))
                      (Err [d]
                           (do
                             (sem-maps-restore auth-maps)
                             (Err [PreparedReadProgram Diag] d)))
                      (Ok [shim-checked]
                          (let [shim-maps
                                  (primitive/alloc-stack SemMapsSnap)]
                            (sem-maps-save shim-maps)
                            (sem-maps-restore auth-maps)
                            (match (merge-checked-read-programs a
                                                                authoritative
                                                                shim-checked)
                              (Err [d]
                                   (Err [PreparedReadProgram Diag] d))
                              (Ok [merged]
                                  (Ok (PreparedReadProgram :program
                                                             merged
                                        :maps
                                          (box! a
                                                SemMapsSnap
                                                (combine-sem-maps a
                                                                  auth-maps
                                                                  shim-maps)))))))))))))))))

; Source readers keep their existing setup behavior. Artifact builders consume
; the same prepared program/maps without first constructing a transient image.
(defn prepare-read-entry [(a (dyn Allocator))
                          (s (mut LS))
                          (authoritative (ptr Program))
                          (name (slice u8))] (-> (Result (ptr Program) Diag))
  (match (prepare-read-program a (mut s) authoritative name)
    (Err [d] (Err [(ptr Program) Diag] d))
    (Ok [prepared]
        (let [entry prepared
              saved (primitive/alloc-stack SemMapsSnap)
              (mut quals) (ArrayList::new [(slice u8)] a)]
          (sem-maps-save saved)
          (sem-maps-restore (.maps entry))
          (push! (mut quals) name)
          (let [setup
                  (meta-engine-setup-replace a
                                             (.program entry)
                                             (box-al [(slice u8)]
                                                     a
                                                     (load quals)))]
            (sem-maps-restore saved)
            (match setup
              (Some [d] (Err [(ptr Program) Diag] d))
              (None [] (Ok [(ptr Program) Diag] (.program entry)))))))))

(defn run-read-provider-named [(a (dyn Allocator))
                               (s (mut LS))
                               (checked (ptr Program))
                               (name (slice u8))
                               (context Sexp)] (-> ReadProviderResult)
  (let [prior-optimized-engine (meta-optimized-engine?)
        _optimized-reader (set-meta-optimized-engine! true)
        gs (box! a SBoxStruct (primitive/zeroed SBoxStruct))
        gu (box! a SBoxSum (primitive/zeroed SBoxSum))
        scope (primitive/alloc-stack MetaEngineScope)
        (mut args) (ArrayList::new [Sexp] a)]
    (set! (.items gs) (ArrayList::new [StructDef] a))
    (set! (.items gu) (ArrayList::new [SumDef] a))
    (push! (mut args) context)
    (set! (.open scope) false)
    (meta-engine-scope-enter! scope a)
    (let [cache (load (reader-engine-cache-cell))
          cached (and (!= (primitive/cast i64 cache) 0)
                      (and (.valid cache) (= (.name cache) name)))
          result
            (match (if cached
                       ; The provider was compiled once, by an earlier read in
                       ; this session; install that engine and call it.
                       (do (reader-engine-cache-install! cache)
                           (tr/count "reader.engine-reuses" 1)
                           (Ok [(ptr Program) Diag] checked))
                       (prepare-read-entry a (mut s) checked name))
              (Err [d]
                   (do
                     (meta-engine-scope-leave! scope)
                     (ReadFailed d)))
              (Ok [entry-program]
                  (let [_captured
                          (when (and (not cached)
                                     (and (!= (primitive/cast i64 cache) 0)
                                          (reader-engine-cacheable?)))
                            (reader-engine-cache-capture! cache scope name)
                            (tr/count "reader.engine-builds" 1)
                            0)
                        expanded
                          (match (expand-macro entry-program
                                               name
                                               (box-al [Sexp] a (load args))
                                               (field (prog-fn-names entry-program a) items)
                                               (field gs items)
                                               (field gu items)
                                               (field s imports)
                                               (field s exports)
                                               a
                                               (load (field s
                                                            code_session_state)) (field s expansions))
                            (Err [d] (ReadFailed d))
                            (Ok [out] (ReadForms out)))]
                    (meta-engine-scope-leave! scope)
                    expanded)))]
      (set-meta-optimized-engine! prior-optimized-engine)
      result)))

;;; Invoke the one read provider registered by a separately compiled setup graph.
;;; The provider receives one Code context and returns either `(do FORM ...)` or a
;;; single form. More than one provider is ambiguous: wrappers belong inside the
;;; provider function itself, where ordinary Coil composition can express them.
(defn run-read-provider [(a (dyn Allocator))
                         (s (mut LS))
                         (checked (ptr Program))
                         (context Sexp)] (-> ReadProviderResult)
  (let [n (len (.out s))
        impb (box-al [ImpEntry] a (.imports s))
        expb (box-al [ExpEntry] a (.exports s))
        (mut found) ""
        (mut duplicate) false]
    (for [i 0 n]
      (let [tf (elem (field s out) i)]
        (when (and (or (is-transform-form (field tf form)) (is-checker-form (field tf form)))
                   (registration-in-phase? (field tf form) (.module tf) impb expb a (phase/Read)))
          (let [items (sx-items (load (field tf form)))
                local (sx-sval (sx-at items 1))
                module
                  (match (load (field tf module)) (Some [m] m) (None [] ""))
                qualified (if (= module "") local (sconcat3 a module "." local))]
            (if (= (load found) "")
                (store! found qualified)
                (store! duplicate true)))
          0)))
    (if (load duplicate)
        (ReadFailed (derr "read phase: compiler setup registered more than one read provider"))
        (if (= (load found) "")
            (ReadDefault)
            (run-read-provider-named a (mut s) checked (load found) context)))))

; group the flat tagged forms into one record per module `(name form…)`, so a
; checker is handed the program AS MODULES and decides which to look at. Imports
; are loaded depth-first, so a module's tagged forms need not be contiguous: the
; entry module can be interrupted by every dependency it imports. Grouping only
; contiguous runs silently split that namespace and made later runs lose module
; declarations such as `(import "coil.scheme" ...)`.
(defn opt-mod-name [(m (Option (slice u8)))] (-> (slice u8))
  (match m (Some [s] s) (None [] "")))

;;; The import/export DECLARATIONS for one module, which the loader keeps out of the
;;; checked program. An opt-in checker that lints import syntax cannot see what it is
;;; asked to lint otherwise -- by the time a checker runs, `(import "m" :use *)` has
;;; become resolution state, not a form. Handed to checkers only (`include-source-syntax`),
;;; never to transforms, whose output is the authoritative form list and would then
;;; contain declarations twice.
(defn checker-append-source-forms! [(dst (mut (ArrayList Sexp)))
                                    (module (slice u8))
                                    (impb (ptr (ArrayList ImpEntry)))
                                    (expb (ptr (ArrayList ExpEntry)))] (-> i64)
  ;; The FIRST entry for the module, then stop. These tables are keyed by module
  ;; name, but a name can appear in more than one row -- and appending from every
  ;; matching row is how one wildcard import produced two identical warnings at the
  ;; same span. One module's declarations are recorded once, wherever they are held.
  (let [ni (len (load impb))
        (mut i) 0
        (mut hit) false]
    (loop (if (or (load hit) (>= (load i) ni))
              (break)
              (do
                (let [e (elem impb (load i))]
                  (when (= (.name e) module)
                    (set! hit true)
                    (let [fs (.forms (.imp e))
                          n (len fs)
                          (mut j) 0]
                      (loop (if (>= (load j) n)
                                (break)
                                (do
                                  (push! (mut dst) (get fs (load j)))
                                  (set! j (primitive/iadd (load j) 1))))))))
                (set! i (primitive/iadd (load i) 1))))))
  (let [ne (len (load expb))
        (mut i) 0
        (mut hit) false]
    (loop (if (or (load hit) (>= (load i) ne))
              (break)
              (do
                (let [e (elem expb (load i))]
                  (when (= (.name e) module)
                    (set! hit true)
                    (let [fs (.forms e)
                          n (len fs)
                          (mut j) 0]
                      (loop (if (>= (load j) n)
                                (break)
                                (do
                                  (push! (mut dst) (get fs (load j)))
                                  (set! j (primitive/iadd (load j) 1))))))))
                (set! i (primitive/iadd (load i) 1))))))
  0)

(defn build-modules [(a (dyn Allocator))
                     (forms (ptr (ArrayList TaggedForm)))
                     (impb (ptr (ArrayList ImpEntry)))
                     (expb (ptr (ArrayList ExpEntry)))
                     (include-source-syntax bool)] (-> Sexp)
  (let [nf (len (load forms))
        (mut mods) (ArrayList::new [Sexp] a)
        (mut i) 0]
    (loop (if (>= (load i) nf)
              (break)
              (do
                (let [tf (elem forms (load i))
                      nm (opt-mod-name (.module tf))
                      (mut dst) (primitive/cast (ptr (ArrayList Sexp)) 0)
                      (mut j) 0]
                  (loop (if (>= (load j) (len (load mods)))
                            (break)
                            (let [items (sx-items (get (load mods) (load j)))]
                              (if (= (sx-sval (sx-at items 0)) nm)
                                  (do (set! dst items) (break))
                                  (set! j (primitive/iadd (load j) 1))))))
                  (when (= (primitive/cast i64 (load dst))
                           0)
                    (let [(mut fresh) (ArrayList::new [Sexp] a)]
                      (push! (mut fresh) (sx-sym nm))
                      (when include-source-syntax
                        (checker-append-source-forms! (mut fresh) nm impb expb)
                        0)
                      (store! dst (box-al [Sexp] a (load fresh)))
                      (push! (mut mods) (mk-sexp (KList (load dst)) -1 -1)))
                    0)
                  (push! (load dst) (.form tf)))
                (set! i (primitive/iadd (load i) 1)))))
    (mk-sexp (KList (box-al [Sexp] a (load mods))) -1 -1)))

; Every source file that DEFINES a checker, by id. A checker is registered under its
; qualified name (`ifcombine.lint-combine-ifs`), so the module that owns it is the part
; before the last dot; any form tagged with that module names the file it came from.
; `cop-record-fix` uses the set to refuse a fix that would rewrite the rules the run is
; being driven by — see the note there for why that corrupts a file rather than merely
; being odd.
;;; Is NAME qualified by module M (`M.rest`)? Compared in place: this runs for
;;; every form against every checker on every analysis, and building `M.` for
;;; the comparison put one string per pair in the unit's arena, which a lint
;;; --fix keeps for the whole command.
(defn qualified-in? [(name (slice u8)) (m (slice u8))] (-> bool)
  (and (> (len name) (len m))
       (starts-with name m)
       (= (get name (len m)) #\.)))

(defn checker-owns? [(checkers (ptr (ArrayList (slice u8)))) (m (slice u8))] (-> bool)
  (let [nc (len (load checkers))
        (mut i) 0
        (mut r) false]
    (loop (if (>= (load i) nc)
              (break)
              (if (qualified-in? (get (load checkers) (load i)) m)
                  (do (set! r true) (break))
                  (set! i (primitive/iadd (load i) 1)))))
    (load r)))

(defn mark-rule-sources [(checkers (ptr (ArrayList (slice u8))))
                         (forms (ptr (ArrayList TaggedForm)))] (-> i64)
  (rule-src-reset)
  (let [nf (len (load forms))
        (mut i) 0]
    (loop (if (>= (load i) nf)
              (break)
              (do
                (let [tf (elem forms (load i))]
                  (match (.module tf)
                    (None [] 0)
                    (Some [m]
                          (when (checker-owns? checkers m)
                            (rule-src-add (sx-source (load (field tf form))))))))
                (set! i (primitive/iadd (load i) 1))))))
  0)

;;; `syntax-phase` is what separates the two checker registries: `(checker FN :phase
;;; (phase/BeforeExpand))` runs against the untouched authored forms, plain `(checker FN)`
;;; runs after expansion. Only the syntax phase is shown the import/export
;;; DECLARATIONS -- they are authored syntax, and by the post-expansion run they are
;;; resolution state, not forms. Both registries run over the same form list, so
;;; showing them to both made every finding an import-syntax checker reported appear
;;; exactly twice.
;;; Set while the program is expanded again after meta elaboration
;;; (resolve-meta-output), when the registered checkers have already run.
(defn checkers-quiet [] (-> (ptr bool))
  (primitive/alloc-static bool))

(defn run-checkers [(checkers (ptr (ArrayList (slice u8))))
                    (checked (ptr Program))
                    (forms (ptr (ArrayList TaggedForm)))
                    (allfns (ptr SBox))
                    (gs (ptr SBoxStruct))
                    (gu (ptr SBoxSum))
                    (impb (ptr (ArrayList ImpEntry)))
                    (expb (ptr (ArrayList ExpEntry)))
                    (syntax-phase bool)
                    (a (dyn Allocator))
                    (code-session-state (ptr i8))
                        (expansions (ptr (ArrayList Expansion)))] (-> (Option Diag))
  (let [nc (len (load checkers))]
    (if (or (= nc 0) (load (checkers-quiet)))
        (None [Diag])
        ; hand the checker the program as a LIST OF MODULES: ((name form…) …) — it owns
        ; the loop and decides which modules to look at.
        (let [_rs (mark-rule-sources checkers forms)
              proglist (build-modules a forms impb expb syntax-phase)
              (mut margs) (ArrayList::new [Sexp] a)]
          (push! (mut margs) proglist)
          (let [(mut j) 0
                (mut err) (None [Diag])
                margsb (box-al [Sexp] a (load margs))]
            (loop (if (or (diag-some? (load err)) (>= (load j) nc))
                      (break)
                      (do
                        (let [checker-name (get (load checkers) (load j))
                              _group (sug-begin-group!)
                              checker-span (tr/span-begin checker-name)]
                          (match (expand-macro checked
                                               checker-name
                                               margsb
                                               (field allfns items)
                                               (field gs items)
                                               (field gu items)
                                               impb
                                               expb
                                               a
                                               code-session-state expansions)
                            (Err [d] (do (set! err (Some d)) 0))
                            (Ok [_] 0))
                          (tr/span-end checker-span))
                        (set! j (primitive/iadd (load j) 1)))))
            (load err))))))

; ── deferred CHECKER registry ────────────────────────────────────────────────
; Checkers are SEMANTIC: they run after the whole program is resolved + typechecked,
; so they read the compiler's authoritative output (real qualified names, real
; signatures) via the semantic model — not a parallel resolver. run-expand collects
; the checker names + the compiled metaprogram closure here; run-registered-checkers
; (invoked from run-pipeline after frontend-check) sets the semantic model and runs them.
(defstruct CheckerReg
  [(active i64)
   (precheckers (ptr (ArrayList (slice u8))))
   (checkers (ptr (ArrayList (slice u8))))
   (semtx-once (ptr (ArrayList (slice u8))))
   (semtx (ptr (ArrayList (slice u8))))
   ; The `:phase (phase/AfterExpand)` transforms, which meta output passes through too.
   (posttx (ptr (ArrayList (slice u8))))
   (checked (ptr Program))
   ; Exact definition-time environment retained by run-expand for later meta
   ; output. Recomputing it from checked would promote phase-owned helpers.
   (macros (ptr (ArrayList (slice u8))))
   (comptime (ptr (ArrayList (slice u8))))
   (expanded (ArrayList TaggedForm))
   (allfns (ptr SBox))
   (gs (ptr SBoxStruct))
   (gu (ptr SBoxSum))])

(defstruct CheckerRegBox [(init i64) (reg CheckerReg)])

; A separately compiled lint profile must not rewrite the application's own
; checker modules when its registry temporarily replaces the target registry.
(defn checker-rule-source-ids [(a (dyn Allocator))
                               (reg CheckerReg)
                               (forms (ptr (ArrayList TaggedForm)))] (-> (ptr (ArrayList i64)))
  (let [r (primitive/alloc-stack CheckerReg)
        (mut out) (ArrayList::new [i64] a)]
    (set! r reg)
    (unless (= (.active r) 0)
      (for [i 0 (len (load forms))]
        (let [form (elem forms i)]
          (match (.module form)
            (Some [name]
                  (when (or (checker-owns? (.precheckers r) name)
                            (checker-owns? (.checkers r) name))
                    (push! (mut out) (sx-source (.form form)))
                    0))
            (None [] 0)))
        0)
      0)
    (box-al [i64] a (load out))))

(defn checker-reg-box [] (-> (ptr CheckerRegBox))
  (field (expander-unit-state) checkers))

(defn register-checkers [(precheckers (ptr (ArrayList (slice u8))))
                         (checkers (ptr (ArrayList (slice u8))))
                         (semtx-once (ptr (ArrayList (slice u8))))
                         (semtx (ptr (ArrayList (slice u8))))
                         (checked (ptr Program))
                         (allfns (ptr SBox))
                         (gs (ptr SBoxStruct))
                         (gu (ptr SBoxSum))] (-> i64)
  (let [b (checker-reg-box)
        r (field b reg)]
    (set! (.active r) 1)
    (set! (.precheckers r) precheckers)
    (set! (.checkers r) checkers)
    (set! (.semtx-once r) semtx-once)
    (set! (.semtx r) semtx)
    (set! (.checked r) checked)
    (set! (.allfns r) allfns)
    (set! (.gs r) gs)
    (set! (.gu r) gu)
    (set! (.init b) 1)
    0))

; A split lint compile temporarily compiles the target after the checker graph.
; Preserve the checker engine's complete execution context across that compile.
(defn checker-reg-save [] (-> CheckerReg)
  (.reg (checker-reg-box)))

(defn checker-reg-restore! [(saved CheckerReg)] (-> i64)
  (let [b (checker-reg-box)]
    (set! (.reg b) saved)
    (set! (.init b) 1)
    0))

; Start a nested compiler invocation with no registrations inherited from its
; caller. Imports in that invocation populate the registry normally. The caller
; restores its saved registry when the nested invocation returns.
(defn checker-reg-clear! [] (-> i64)
  (let [b (checker-reg-box)]
    (set! (.reg b) (primitive/zeroed CheckerReg))
    (set! (.init b) 0)
    0))

; Run the registered checkers over the authoritative checked Program `cp`. Called
; from run-pipeline AFTER frontend-check. Always sets the semantic model (so
; `code-decl` reads real work) and drains collected warnings/errors.
(defn set-sem-model-from-loader! [(s LS) (cp (ptr Program))] (-> i64)
  (set-sem-model cp)
  (set-sem-model-checked-base!
    (primitive/cast (ptr checkedbase/CheckedBase) (.persistent_checked s)))
  (set! (.dependency_base (sem-model-box))
    (primitive/cast (ptr deps/DepBase) (.persistent_dependencies s)))
  (let [b (sem-model-box)
        raw (.value (.semantic_workspace s))
        ws (primitive/cast (ptr SemanticWorkspace) raw)]
    (set! (.imports b) (box! (unit-allocator) (ArrayList ImpEntry) (.imports s)))
    (set! (.exports b) (box! (unit-allocator) (ArrayList ExpEntry) (.exports s)))
    (set! (.declarations b)
          (if (and (!= (primitive/cast i64 raw) 0) (.has_declaration_table ws))
              (.declaration_table ws)
              (primitive/cast (ptr (ArrayList DefEntry)) 0)))
    (set! (.checker b) (primitive/cast (ptr Cx) (.checker_context s)))
    (set! (.forms b) (box! (unit-allocator) (ArrayList TaggedForm) (.out s)))
    (set! (.retained b) (box! (unit-allocator) (ArrayList RetainedForm) (.retained_forms s))))
  0)

(defn run-registered-checkers [(a (dyn Allocator))
                               (s (mut LS))
                               (cp (ptr Program))] (-> (Result i64 Diag))
  (set-sem-model-from-loader! s cp)
  (let [b (checker-reg-box)]
    (if (= (.init b) 0)
        (Ok [i64 Diag] 0)
        (let [r (field b reg)]
          (if (= (.active r) 0)
              (Ok [i64 Diag] 0)
              (let [forms (box-al [TaggedForm] a (.out s))
                    impb
                      (box! a
                            (ArrayList ImpEntry)
                            (primitive/zeroed (ArrayList ImpEntry)))
                    expb
                      (box! a
                            (ArrayList ExpEntry)
                            (primitive/zeroed (ArrayList ExpEntry)))]
                (set! impb (.imports s))
                (set! expb (.exports s))
                (match (run-checkers (load (field r checkers))
                                     (load (field r checked))
                                     forms
                                     (load (field r allfns))
                                     (load (field r gs))
                                     (load (field r gu))
                                     impb
                                     expb
                                     false
                                     a
                                     (load (field s code_session_state)) (field s expansions))
                  (Some [d] (do (drain-warnings (mut s)) (Err [i64 Diag] d)))
                  (None []
                        (do
                          (drain-warnings (mut s))
                          (if (> (diag-errs) 0)
                              (Err [i64 Diag]
                                   (derr "compilation failed: checker reported error(s) above"))
                              (Ok [i64 Diag] 0)))))))))))

; Invoke ONE Code-signed entry (a code->code `main`) with explicit arguments,
; exactly as a registered checker is invoked: the same metaprogram context the
; run-expand pre-scan registered, the same expand-macro boundary (arena,
; promotion, lazy staging via finish-macro), the same warning drain. This is
; the whole engine side of `coil run` on a code->code program — see
; docs/design/RUN_METAPROGRAMS.md.
(defn run-code-main [(a (dyn Allocator))
                     (s (mut LS))
                     (cp (ptr Program))
                     (qual (slice u8))
                     (margs (ptr (ArrayList Sexp)))] (-> (Result Sexp Diag))
  (set-sem-model-from-loader! s cp)
  (let [b (checker-reg-box)]
    (if (= (.init b) 0)
        (Err [Sexp Diag]
             (derr "code->code run: the metaprogram context was not registered (compiler bug)"))
        (let [r (field b reg)
              impb
                (box! a
                      (ArrayList ImpEntry)
                      (primitive/zeroed (ArrayList ImpEntry)))
              expb
                (box! a
                      (ArrayList ExpEntry)
                      (primitive/zeroed (ArrayList ExpEntry)))]
          (set! impb (.imports s))
          (set! expb (.exports s))
          (let [res
                  (expand-macro (load (field r checked))
                                qual
                                margs
                                (field (load (field r allfns)) items)
                                (field (load (field r gs)) items)
                                (field (load (field r gu)) items)
                                impb
                                expb
                                a
                                (load (field s code_session_state)) (field s expansions))]
            (drain-warnings (mut s))
            res)))))

; Project lint compiles the checker graph separately from the target graph. The
; registered functions above are still the ordinary Coil metaprograms; this path
; merely supplies their target Code without expanding and retaining an application
; the size of the whole project.
(defn project-code-macros [(a (dyn Allocator))
                           (forms (ptr (ArrayList TaggedForm)))] (-> (ptr (ArrayList (slice u8))))
  (let [(mut out) (ArrayList::new [(slice u8)] a)
        n (len (load forms))
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (let [tf (elem forms (load i))]
                  (when (raw-code-sig? (field tf form))
                    (match (defn-name-of (field tf form))
                      (Some [name]
                            (push! (mut out)
                                   (qualify-name a
                                                 name
                                                 (load (field tf module)))))
                      (None [] 0))
                    0))
                (set! i (primitive/iadd (load i) 1)))))
    (box-al [(slice u8)] a (load out))))

(defn project-code-macro-index [(a (dyn Allocator))
                                (macros (ptr (ArrayList (slice u8))))] (-> (ptr (HashMap (slice u8)
                                                                                         bool)))
  (let [(mut out) (HashMap::new [(slice u8) bool] a (keyops))
        n (len (load macros))
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (set! (mut out)
                      (decl-simple-name (get (load macros) (load i)))
                      true)
                (set! i (primitive/iadd (load i) 1)))))
    (box! a (HashMap (slice u8) bool) (load out))))

(defn project-mark-generated! [(node (ptr Sexp))] (-> i64)
  (set! (.ctxt node) 1)
  (let [tg (sx-tag (load node))]
    (when (or (= tg 6) (= tg 7))
      (let [items (sx-items (load node))
            n (sx-len items)
            (mut i) 0]
        (loop (if (>= (load i) n)
                  (break)
                  (do
                    (project-mark-generated! (elem items (load i)))
                    (store! i (primitive/iadd (load i) 1))))))
      0))
  0)

; Mark authored syntax that sits underneath a macro call. A normal expanded graph
; carries this fact in Sexp.ctxt; reproducing the provenance bit from the registered
; Code signatures lets semantic checkers keep using `code-macro?` without forcing
; expansion of unrelated application code.
(defn project-mark-macro-scopes! [(a (dyn Allocator))
                                  (node (ptr Sexp))
                                  (module (Option (slice u8)))
                                  (macros (ptr (ArrayList (slice u8))))
                                  (macro-index (ptr (HashMap (slice u8) bool)))
                                  (impb (ptr (ArrayList ImpEntry)))
                                  (expb (ptr (ArrayList ExpEntry)))] (-> i64)
  (let [tg (sx-tag (load node))]
    (when (or (= tg 6) (= tg 7))
      (let [items (sx-items (load node))
            n (sx-len items)
            head
              (if (and (= tg 6)
                       (and (> n 0)
                            (= (sx-tag (sx-at items 0)) 2)))
                  (sx-sval (sx-at items 0))
                  "")]
        (if (or (= head "quote") (= head "quasiquote"))
            0
            (do
              (match (if (or (= head "")
                             (not (match (get (load macro-index)
                                              (decl-simple-name head))
                                    (Some [_] true)
                                    (None [] false))))
                         (None [(slice u8)])
                         (resolve-macro head module macros impb expb a))
                (Some [_] (macro-call-record (sx-node-id (load node))))
                (None [] 0))
              (let [(mut i) 0]
                (loop (if (>= (load i) n)
                          (break)
                          (do
                            (project-mark-macro-scopes! a
                                                        (elem items
                                                              (load i))
                                                        module
                                                        macros
                                                        macro-index
                                                        impb
                                                        expb)
                            (store! i (primitive/iadd (load i) 1))))))))))
    0))

(defn run-external-precheckers [(a (dyn Allocator))
                                (s (mut LS))
                                (forms (ptr (ArrayList TaggedForm)))
                                (reg CheckerReg)] (-> (Result i64 Diag))
  (let [r (primitive/alloc-stack CheckerReg)
        impb
          (box! a (ArrayList ImpEntry) (primitive/zeroed (ArrayList ImpEntry)))
        expb
          (box! a (ArrayList ExpEntry) (primitive/zeroed (ArrayList ExpEntry)))]
    (set! r reg)
    (set! impb (.imports s))
    (set! expb (.exports s))
    (set-cli-sources (field s sources))
    (clear-sem-model)
    (match (run-checkers (load (field r precheckers))
                         (load (field r checked))
                         forms
                         (load (field r allfns))
                         (load (field r gs))
                         (load (field r gu))
                         impb
                         expb
                         true
                         a
                         (load (field s code_session_state)) (field s expansions))
      (Some [d] (do (drain-warnings (mut s)) (Err [i64 Diag] d)))
      (None []
            (do
              (drain-warnings (mut s))
              (if (> (diag-errs) 0)
                  (Err [i64 Diag]
                       (derr "compilation failed: checker reported error(s) above"))
                  (Ok [i64 Diag] 0)))))))

(defn run-project-registered-checkers-with-syntax [(a (dyn Allocator))
                                                   (s (mut LS))
                                                   (cp (ptr Program))
                                                   (syntax bool)
                                                   (forms (ptr (ArrayList TaggedForm)))] (-> (Result i64
                                                                                                     Diag))
  (let [b (checker-reg-box)]
    (if (= (.init b) 0)
        (Ok [i64 Diag] 0)
        (let [r (field b reg)
              impb
                (box! a
                      (ArrayList ImpEntry)
                      (primitive/zeroed (ArrayList ImpEntry)))
              expb
                (box! a
                      (ArrayList ExpEntry)
                      (primitive/zeroed (ArrayList ExpEntry)))]
          (set! impb (.imports s))
          (set! expb (.exports s))
          (set-cli-sources (field s sources))
          (set-sem-model-from-loader! s cp)
          (macro-call-reset)
          (let [macros
                  (code-sig-funcs-except cp
                                         (box-al [(slice u8)]
                                                 a
                                                 (ArrayList::new [(slice u8)] a))
                                         a)
                macro-index (project-code-macro-index a macros)
                n (len (load forms))
                (mut i) 0]
            (loop (if (>= (load i) n)
                      (break)
                      (do
                        (let [tf (elem forms (load i))]
                          (project-mark-macro-scopes! a
                                                      (field tf form)
                                                      (.module tf)
                                                      macros
                                                      macro-index
                                                      impb
                                                      expb))
                        (set! i (primitive/iadd (load i) 1)))))
            0)
          ; Syntax-phase checkers see the untouched authored forms. A full target
          ; pipeline can run this phase earlier and request only semantic checkers.
          (let [(mut err)
                  (if syntax
                      (run-checkers (load (field r precheckers))
                                    (load (field r checked))
                                    forms
                                    (load (field r allfns))
                                    (load (field r gs))
                                    (load (field r gu))
                                    impb
                                    expb
                                    true
                                    a
                                    (load (field s code_session_state)) (field s expansions))
                      (None [Diag]))]
            (when (not (diag-some? (load err)))
              (store! err
                      (run-checkers (load (field r checkers))
                                    (load (field r checked))
                                    forms
                                    (load (field r allfns))
                                    (load (field r gs))
                                    (load (field r gu))
                                    impb
                                    expb
                                    false
                                    a
                                    (load (field s code_session_state)) (field s expansions)))
              0)
            (drain-warnings (mut s))
            (match (load err)
              (Some [d] (Err [i64 Diag] d))
              (None []
                    (if (> (diag-errs) 0)
                        (Err [i64 Diag]
                             (derr "compilation failed: checker reported error(s) above"))
                        (Ok [i64 Diag] 0)))))))))

(defn run-project-registered-checkers [(a (dyn Allocator))
                                       (s (mut LS))
                                       (cp (ptr Program))] (-> (Result i64 Diag))
  (run-project-registered-checkers-with-syntax a
                                               (mut s)
                                               cp
                                               true
                                               (box-al [TaggedForm] a (.out s))))

(defn run-project-registered-semantic-checkers [(a (dyn Allocator))
                                                (s (mut LS))
                                                (cp (ptr Program))] (-> (Result i64
                                                                                Diag))
  (run-project-registered-checkers-with-syntax a
                                               (mut s)
                                               cp
                                               false
                                               (box-al [TaggedForm] a (.out s))))

; Source lints use authored syntax with a conservative correspondence to the
; checked revision. Semantic revisions deliberately freshen host node IDs. A
; source node gets a semantic ID only when exactly one checked node has the same
; source interval, node kind and lexical scope. Duplicated macro arguments may
; have several meanings; those remain unknown rather than choosing one.
(defn source-node-key [(a (dyn Allocator)) (node (ptr Sexp))] (-> (slice u8))
  (sconcat3 a
            (i64->str a (.source node))
            ":"
            (sconcat3 a
                      (i64->str a (.lo node))
                      ":"
                      (sconcat3 a
                                (i64->str a (.hi node))
                                ":"
                                (sconcat3 a
                                          (i64->str a (sx-tag (load node)))
                                          ":"
                                          (sconcat3 a
                                                    (i64->str a (.hyg node))
                                                    ":"
                                                    (.hmod node)))))))

(defn index-source-nodes! [(a (dyn Allocator))
                           (node (ptr Sexp))
                           (index (mut (HashMap (slice u8) i64)))] (-> i64)
  (when (and (code-from-user-node? (load node)) (>= (.lo node) 0))
    (let [key (source-node-key a node)]
      (match (get (load index) key)
        (None [] (set! (mut index) key (.node-id node)))
        (Some [old] (unless (= old (.node-id node)) (set! (mut index) key -1)))))
    0)
  (when (or (= (sx-tag (load node)) 6) (= (sx-tag (load node)) 7))
    (let [items (sx-items (load node))]
      (for [i 0 (sx-len items)]
        (index-source-nodes! a (elem items i) (mut index))))
    0)
  0)

(defn join-source-nodes! [(a (dyn Allocator))
                          (node (ptr Sexp))
                          (index (ref (HashMap (slice u8) i64)))] (-> i64)
  (set! (.node-id node)
        (if (code-from-user-node? (load node))
            (match (get index (source-node-key a node))
              (Some [id] id)
              (None [] -1))
            -1))
  (when (or (= (sx-tag (load node)) 6) (= (sx-tag (load node)) 7))
    (let [items (sx-items (load node))]
      (for [i 0 (sx-len items)]
        (join-source-nodes! a (elem items i) index)))
    0)
  0)

(defn run-source-semantic-checkers [(a (dyn Allocator))
                                    (s (mut LS))
                                    (cp (ptr Program))
                                    (authored (ptr (ArrayList TaggedForm)))] (-> (Result i64
                                                                                         Diag))
  (let [work (primitive/alloc-stack scratch/ScratchArena)
        _init (scratch/ScratchArena::init-with-capacity work (retained-heap/compiler-scratch-parent) 65536)
        scratch-a (allocator work)
        (mut index) (HashMap::new [(slice u8) i64] scratch-a (keyops))
        source (tower-snapshot a authored (len (load authored)))]
    (for [i 0 (len (.out s))]
      (index-source-nodes! scratch-a
                           (field (elem (mut (.out s)) i) form)
                           (mut index)))
    (for [i 0 (len (load source))]
      (join-source-nodes! scratch-a
                          (field (elem source i) form)
                          (load index)))
    ; Only numeric node IDs escape the correspondence index. Reclaim its keys
    ; together; region-backed individual key replacement otherwise scans the
    ; entire allocation registry for every duplicate generated source node.
    (close! work)
    (set! (.observing (source-facts)) false)
    (source-view-publish! a (mut s) source)
    (run-project-registered-checkers-with-syntax a (mut s) cp false source)))

; Two tagged-form lists are equal iff their forms are structurally equal (spans
; ignored) — the fixpoint test for the semantic-transform loop.
(defn forms-equal [(xs (ptr (ArrayList TaggedForm)))
                   (ys (ptr (ArrayList TaggedForm)))] (-> bool)
  (let [nx (len (load xs))
        ny (len (load ys))]
    (if (!= nx ny)
        false
        (let [(mut i) 0
              (mut ok) true]
          (loop (if (or (not (load ok)) (>= (load i) nx))
                    (break)
                    (do
                      (when (not (sexp-eq (load (field (elem xs
                                                             (load i))
                                                       form))
                                          (load (field (elem ys
                                                             (load i))
                                                       form))))
                        (store! ok false)
                        0)
                      (set! i (primitive/iadd (load i) 1)))))
          (load ok)))))

; ── TRANSFORMS: whole-program rewrites that run to a fixpoint ────────────────
; There is ONE kind of transform (`(transform FN)`). It is SEMANTIC: each round it
; reads the authoritative checked program (via the semantic model) to decide its
; rewrite. But it TOLERATES a program that does not yet typecheck — then the model is
; empty (`code-decl` → `:unresolved`) and the transform rewrites syntactically until
; the program becomes valid (e.g. a desugaring that introduces the very ops that make
; it typecheck). The AUTHORITATIVE strict check happens once, after the fixpoint.
(defn diag-before [(x Diag) (y Diag)] (-> bool)
  (if (< (.source x) (.source y))
      true
      (if (> (.source x) (.source y))
          false
          (<= (.lo x) (.lo y)))))

; merge the recoverable resolve errors into check_diags, in source order, so the build
; path's one renderer shows every diagnostic from both phases with an `N errors` summary.
(defn merge-resolve-diags [(a (dyn Allocator)) (s (mut LS))] (-> i64)
  (let [rd (load (field s resolve_diags))
        cd (load (field s check_diags))
        nr (len rd)
        nc (len cd)
        (mut out) (ArrayList::new [Diag] a)
        (mut ri) 0
        (mut ci) 0]
    ; each list is already in source order within itself; classic two-list merge.
    (loop (if (and (< (load ri) nr) (< (load ci) nc))
              (let [dr (get rd (load ri))
                    dc (get cd (load ci))]
                (if (diag-before dr dc)
                    (do
                      (push! (mut out) dr)
                      (set! ri (primitive/iadd (load ri) 1))
                      0)
                    (do
                      (push! (mut out) dc)
                      (set! ci (primitive/iadd (load ci) 1))
                      0)))
              (break)))
    (loop (if (< (load ri) nr)
              (do
                (push! (mut out) (get rd (load ri)))
                (set! ri (primitive/iadd (load ri) 1))
                0)
              (break)))
    (loop (if (< (load ci) nc)
              (do
                (push! (mut out) (get cd (load ci)))
                (set! ci (primitive/iadd (load ci) 1))
                0)
              (break)))
    (set! (load (field s check_diags)) (load out))
    0))

; ---- (meta …) on the COMPILED engine (interp deletion step 4) ---------------------
; Mirrors comptime.coil::elaborate-metas / run-metas, but the generator sub-program
; is built at the PRE-CHECK form level — metashim forms injected via meta-sub-forms,
; exactly like the macro engine — and each meta expression is wrapped as a synthetic
; zero-parameter Code-returning entry (`coil.meta.<elaboration>.<i>`) that meta-engine-setup
; compiles and meta-engine-run-env executes as native code. Result handling (splice
; a returned `(do …)`, else push the form) and the final splice + strict re-resolve
; + check are byte-for-byte the interpreter path's semantics.
(defn meta-elaboration-id [] (-> i64)
  (let [p (field (expander-unit-state) elaboration_id)
        n (primitive/iadd (load p) 1)]
    (set! p n)
    n))

;;; Run the program's (meta …) generators and splice what they produce in place
;;; of them, without resolving or checking the result.
;;;
;;; They run as one program, checked before any of them runs. That check fails
;;; when one generator's code reads what another generates: a generator calling
;;; `coil.fs`'s `write-file` needs the `O_CREAT` that coil.fs's own generator
;;; writes. Then every generator that checks on its own runs first, the program is
;;; expanded again with their output, and the rest are tried again; the first
;;; error stands when none can run. The macro tower does the same when a macro's
;;; code needs a generator's output (`elaborate-metas-from-tower!`).
(defn elaborate-metas-into! [(a (dyn Allocator)) (s (mut LS))] (-> (Result i64 Diag))
  (let [ran (primitive/alloc-stack bool)
        none (primitive/cast (ptr (ArrayList TaggedForm)) 0)]
    (store! ran false)
    (match (elaborate-metas-attempt! a (mut s) none -1 ran (primitive/cast (ptr MetaOutput) 0))
      (Ok [r] (Ok [i64 Diag] r))
      (Err [d]
           (if (load ran)
               (Err [i64 Diag] d)
               (match (elaborate-metas-runnable! a (mut s) none)
                 (Err [d2] (Err [i64 Diag] d2))
                 (Ok [progressed]
                     (if (not progressed)
                         (Err [i64 Diag] d)
                         (let [registry (load (checker-reg-box))
                               quiet (checkers-quiet)
                               was-quiet (load quiet)
                               _quiet (store! quiet true)
                               expanded (expand-stage3 (mut s))]
                           (store! quiet was-quiet)
                           (store! (checker-reg-box) registry)
                           (match expanded
                             (Err [d3] (Err [i64 Diag] d3))
                             (Ok [_] (elaborate-metas-into! a (mut s)))))))))))))

;;; The macro tower's run of the program's generators over its working copy
;;; SUB-FORMS, whose definitions it has expanded. When they do not check as one,
;;; the ones that check on their own run, and the tower starts again.
(defn elaborate-metas-from-tower! [(a (dyn Allocator)) (s (mut LS))
                                   (sub-forms (ptr (ArrayList TaggedForm)))] (-> (Result i64 Diag))
  (let [ran (primitive/alloc-stack bool)]
    (store! ran false)
    (match (elaborate-metas-attempt! a (mut s) sub-forms -1 ran (primitive/cast (ptr MetaOutput) 0))
      (Ok [r] (Ok [i64 Diag] r))
      (Err [d]
           (if (load ran)
               (Err [i64 Diag] d)
               (match (elaborate-metas-runnable! a (mut s) sub-forms)
                 (Err [d2] (Err [i64 Diag] d2))
                 (Ok [progressed] (if progressed (Ok [i64 Diag] 0) (Err [i64 Diag] d)))))))))

;;; What generators produced, held back to be spliced together.
(defstruct MetaOutput
  [(gen (ArrayList Sexp))
   (genmods (ArrayList (Option (slice u8))))
   (picked (ArrayList i64))])

;;; Run, one at a time, every generator whose code checks on its own, over
;;; SUB-FORMS (the program's own forms when null), then splice what they produced
;;; in place of them. True when any ran; an error when one failed while running.
(defn elaborate-metas-runnable! [(a (dyn Allocator)) (s (mut LS))
                                 (sub-forms (ptr (ArrayList TaggedForm)))] (-> (Result bool Diag))
  (let [(mut n) 0
        out (box! a MetaOutput (MetaOutput :gen (ArrayList::new [Sexp] a)
                                           :genmods (ArrayList::new [(Option (slice u8))] a)
                                           :picked (ArrayList::new [i64] a)))]
    (for [i 0 (len (.out s))]
      (when (is-meta-form (field (elem (field s out) i) form))
        (set! n (+ (load n) 1))
        0))
    (block :done
      (for [k 0 (load n)]
        (let [ran (primitive/alloc-stack bool)]
          (store! ran false)
          (match (elaborate-metas-attempt! a (mut s) sub-forms k ran out)
            (Ok [_] 0)
            (Err [d] (do (when (load ran) (break :done (Err [bool Diag] d))) 0)))))
      (splice-metas (mut s)
                    (box-al [Sexp] a (.gen out))
                    (box-al [(Option (slice u8))] a (.genmods out))
                    (box-al [i64] a (.picked out))
                    a)
      (Ok [bool Diag] (> (len (.picked out)) 0)))))

;;; One elaboration of generator ONLY, or of all of them when it is -1, over
;;; SUB-FORMS or, when null, the program's own forms. With COLLECT, the output is
;;; added to it instead of spliced.
(defn elaborate-metas-attempt! [(a (dyn Allocator)) (s (mut LS))
                                (sub-forms (ptr (ArrayList TaggedForm)))
                                (only i64)
                                (ran (ptr bool))
                                (collect (ptr MetaOutput))] (-> (Result i64 Diag))
  (cond (!= (primitive/cast i64 sub-forms) 0)
          (elaborate-metas-select! a (mut s) sub-forms (primitive/cast (ptr HostStage) 0) (primitive/zeroed TargetArchCell) only ran collect)
        (and (cross-build?) (!= (primitive/cast i64 (.host_stage s)) 0))
          (elaborate-metas-cross! a (mut s) only ran collect)
        :else
          (match (meta-sub-forms-sharing a (mut s) (box-al [TaggedForm] a (load (field s out))))
            (Err [d] (Err [i64 Diag] d))
            (Ok [own] (elaborate-metas-select! a (mut s) own (primitive/cast (ptr HostStage) 0) (primitive/zeroed TargetArchCell) only ran collect)))))

;;; A cross build's generators are compiler code, so they are built from the host
;;; twin's view of the program, which holds everything compile-time code reaches,
;;; expanded, resolved and checked for the host, including what the program left to
;;; the host and the output of any generator the twin's own macros needed. The
;;; program's `(meta …)` forms take the place of the twin's. Each generator produces
;;; the program's definitions, so it RUNS with target questions answering for the
;;; target.
(defn elaborate-metas-cross! [(a (dyn Allocator)) (s (mut LS)) (only i64) (ran (ptr bool)) (collect (ptr MetaOutput))] (-> (Result i64 Diag))
  (let [hs (primitive/cast (ptr HostStage) (.host_stage s))
        program (tower-snapshot a (box-al [TaggedForm] a (.out s)) (len (.out s)))
        generators (if (= (primitive/cast i64 (.normalized hs)) 0)
                       program
                       (let [(mut forms) (ArrayList::new [TaggedForm] a)
                             twin (tower-snapshot a (.normalized hs) (len (load (.normalized hs))))]
                         (for [i 0 (len (load twin))]
                           (unless (is-meta-form (field (elem twin i) form))
                             (push! (mut forms) (get (load twin) i))
                             0))
                         (for [i 0 (len (load program))]
                           (when (is-meta-form (field (elem program i) form))
                             (push! (mut forms) (get (load program) i))
                             0))
                         (box-al [TaggedForm] a (load forms))))
        target (target-cell-swap! (host-target-cell))
        result (match (meta-sub-forms a (mut s) generators)
                 (Err [d] (Err [i64 Diag] d))
                 (Ok [sub-forms] (elaborate-metas-select! a (mut s) sub-forms hs target only ran collect)))]
    (target-cell-swap! target)
    result))

;;; Run the program's generators over a generator program already assembled (the
;;; program's forms plus the metashim), such as the macro tower's working copy, and
;;; splice what they produce in place of them. With HOST, the program is resolved
;;; in the host stage's workspace and each generator runs with target questions
;;; answering for RUN-AS. ONLY picks one generator (an index among the program's
;;; `(meta …)` forms; -1 runs them all), and with COLLECT the output is added to it
;;; instead of spliced. RAN is set once a generator starts running: a failure
;;; before that changed nothing.
(defn elaborate-metas-select! [(a (dyn Allocator)) (s (mut LS))
                               (sub-forms (ptr (ArrayList TaggedForm)))
                               (host (ptr HostStage))
                               (run-as TargetArchCell)
                               (only i64)
                               (ran (ptr bool))
                               (collect (ptr MetaOutput))] (-> (Result i64 Diag))
  (try (do
         (let [subls (primitive/alloc-stack LS)]
           (ls-init! (mut subls) a)
           (store! (field subls out) (load sub-forms))
           (store! (field subls loaded) (ArrayList::new [(slice u8)] a))
           (store! (field subls readpaths) (ArrayList::new [(slice u8)] a))
           (store! (field subls readmods) (ArrayList::new [(slice u8)] a))
           (store! (field subls imports)
                   (if (= (primitive/cast i64 host) 0) (load (field s imports)) (host-imports (mut s) host)))
           (store! (field subls exports)
                   (if (= (primitive/cast i64 host) 0) (load (field s exports)) (host-exports (mut s) host)))
           (store! (field subls primitive_defs) (load (field s primitive_defs)))
           (store! (field subls primitive_aliases)
                   (load (field s primitive_aliases)))
           (ls-borrow-semantics! (mut subls) (mut s))
           ; A workspace serves one evolving program; these forms are the
           ; program's, compiled for the host, so they get one of their own.
           (when (!= (primitive/cast i64 host) 0)
             (set! (.semantic_workspace subls) (host-workspace-slot (mut s)))
             (set! (.semantic_audit subls) (box! a SemanticAudit (primitive/zeroed SemanticAudit)))
             0)
           (set! (.parent subls) (ls-meta-parent (mut s)))
           (match (stage3-resolve a (mut subls) (primitive/cast (ptr (ptr (ArrayList (slice u8)))) 0))
             (Err [d] (Err [i64 Diag] d))
             (Ok [mctx]
                 (let [ms (load (field mctx metas))
                       nmet (len (load ms))
                       eid (meta-elaboration-id)
                       (mut names) (ArrayList::new [(slice u8)] a)
                       (mut picked) (ArrayList::new [i64] a)
                       (mut i) 0]
                   ; one synthetic entry per (meta …) expression
                   (loop (if (>= (load i) nmet)
                             (break)
                             (do
                               (when (or (< only 0) (= (load i) only))
                               (let [f (primitive/alloc-stack Func)
                                     fname
                                       (sconcat3 a
                                                 "coil.meta."
                                                 (i64->str a eid)
                                                 (sconcat a
                                                          "."
                                                          (i64->str a (load i))))]
                                 (store! (field f name) fname)
                                 (store! (field f type_params)
                                         (box-al [(slice u8)]
                                                 a
                                                 (ArrayList::new [(slice u8)] a)))
                                 (store! (field f bounds)
                                         (box-al [Bound] a (ArrayList::new [Bound] a)))
                                 (store! (field f cc) (cc-c))
                                 (store! (field f annotations)
                                         (box-al [Annotation]
                                                 a
                                                 (ArrayList::new [Annotation] a)))
                                 (store! (field f params)
                                         (box-al [Param] a (ArrayList::new [Param] a)))
                                 (store! (field f ret) (TCode))
                                 (let [(mut bl) (ArrayList::new [Expr] a)]
                                   (push! (mut bl) (get (load ms) (load i)))
                                   (store! (field f body)
                                           (box-al [Expr] a (load bl))))
                                 (store! (field f macro_variadic) false)
                                 (store! (field f lo) -1)
                                 (store! (field f hi) -1)
                                 (store! (field f source) -1)
                                 (store! (field f ctxt) 0)
                                 (store! (field f declared) false)
                                 (store! (field f lazy) (primitive/cast (ptr i8) 0))
                                 (push! (mut (load (field mctx funcs)))
                                        (load f))
                                 (push! (mut names) fname)
                                 (push! (mut picked) (load i)))
                               0)
                               (store! i (primitive/iadd (load i) 1)))))
                   (let [qb (box-al [(slice u8)] a (load names))
                         seeds (meta-shim-seeds a mctx qb)
                         closure-ctx (with-constant-lengths a mctx)
                         wanted (closure-funcs closure-ctx seeds a)
                         sub (closure-subprogram closure-ctx wanted a)
                         checkls (primitive/alloc-stack LS)]
                     (ls-init! (mut checkls) a)
                     (set! (.parent checkls) (ls-meta-parent (mut s)))
                     (store! (field checkls out) (ArrayList::new [TaggedForm] a))
                     (store! (field checkls loaded) (ArrayList::new [(slice u8)] a))
                     (store! (field checkls readpaths) (ArrayList::new [(slice u8)] a))
                     (store! (field checkls readmods) (ArrayList::new [(slice u8)] a))
                     ; The closure's code is the program's, and its trait methods
                     ; are in scope as the program's imports refer them.
                     (store! (field checkls imports) (ls-copy-list [ImpEntry] a (.imports s)))
                     (store! (field checkls exports) (ls-copy-list [ExpEntry] a (.exports s)))
                     (store! (field checkls primitive_defs)
                             (ArrayList::new [PrimitiveDef] a))
                     (store! (field checkls primitive_aliases)
                             (ArrayList::new [PrimitiveAlias] a))
                     (store! (field checkls check_diags)
                             (box-al [Diag] a (ArrayList::new [Diag] a)))
                     (store! (field checkls resolve_diags)
                             (primitive/cast (ptr (ArrayList Diag)) 0))
                     (store! (field checkls resolve_poisoned)
                             (primitive/cast (ptr (ArrayList (slice u8))) 0))
                     (let [checked (try! (check-program a sub (mut checkls)))]
                       (match (meta-engine-setup a checked qb)
                         (Some [d] (Err [i64 Diag] d))
                         (None []
                               ; run each entry; cx mirrors run-metas' (the metahost shims read it)
                               (let [cx (primitive/alloc-stack CtCtx)
                                     meta-modules (meta-form-modules (mut s) a)
                                     meta-forms (meta-form-syntax (mut s) a)
                                     (mut gen) (ArrayList::new [Sexp] a)
                                     (mut genmods)
                                       (ArrayList::new [(Option (slice u8))] a)
                                     (mut j) 0
                                     (mut errf) (None [Diag])]
                                 (store! cx (primitive/zeroed CtCtx))
                                 (store! (field cx a) a)
                                 (store! (field cx fns)
                                         (load (field checked funcs)))
                                 (store! (field cx structs)
                                         (load (field checked structs)))
                                 (store! (field cx sums)
                                         (load (field checked sums)))
                                 (store! (field cx traits)
                                         (load (field checked traits)))
                                 (store! (field cx fuel) 50000000)
                                 (store! (field cx depth) 0)
                                 (store! (field cx gensym) 0)
                                 (store! (field cx qmodule) (None [(slice u8)]))
                                 (store! (field cx module_fns)
                                         (primitive/cast (ptr (ArrayList (slice u8)))
                                                         0))
                                 (store! (field cx qimports)
                                         (primitive/cast (ptr ModImports) 0))
                                 (store! (field cx qexports)
                                         (primitive/cast (ptr (ArrayList ExpEntry))
                                                         0))
                                 (store! (field cx prog) checked)
                                 ; A generator reflects on the program's names as
                                 ; their modules see them.
                                 (store! (field cx all_imports) (primitive/cast (ptr (ArrayList ImpEntry)) (field s imports)))
                                 (store! (field cx all_exports) (primitive/cast (ptr (ArrayList ExpEntry)) (field s exports)))
                                 (store! (field cx code_session_state)
                                         (load (field s code_session_state)))
                                 (store! (field cx expansions) (primitive/cast (ptr (ArrayList Expansion)) (field s expansions)))
                                 (store! ran true)
                                 (loop (if (or (diag-some? (load errf))
                                               (>= (load j) (len (load picked))))
                                           (break)
                                           (do
                                             (let [md
                                                     (get (load meta-modules) (get (load picked) (load j)))
                                                   _qm
                                                     (store! (field cx qmodule)
                                                             md)
                                                   e
                                                     (meta-engine-entry (get (load qb)
                                                                             (load j)))]
                                               (if (= (primitive/cast i64 e)
                                                      0)
                                                   (do
                                                     (store! errf
                                                             (Some (derr "meta: entry missing from the metaprogram engine (compiler bug)")))
                                                     0)
                                                   (match (meta-run-as host
                                                                       run-as
                                                                       a
                                                                       e
                                                                       cx
                                                                       (box-al [EnvBind]
                                                                               a
                                                                               (ArrayList::new [EnvBind]
                                                                                               a)))
                                                     (Err [d]
                                                          (do
                                                            (store! errf
                                                                    (Some d))
                                                            0))
                                                     (Ok [sexp]
                                                         (let [sp
                                                                 (box-sexp a
                                                                           sexp)
                                                               ; generated syntax with no span of its
                                                               ; own is located at the (meta …) form
                                                               mf (get (load meta-forms) (get (load picked) (load j)))
                                                               _stamp (stamp-expansion sp
                                                                                       (sx-source mf)
                                                                                       (sx-lo mf)
                                                                                       (sx-hi mf)
                                                                                       0)
                                                               sexp (load sp)]
                                                           ; a returned `(do …)` splices its items — TRANSITIVELY, since a
                                                           ; generator built out of macros bundles at each layer
                                                           (if (do-bundle? sp)
                                                               (let [(mut flat)
                                                                       (ArrayList::new [Sexp]
                                                                                       a)
                                                                     md
                                                                       (get (load meta-modules) (get (load picked) (load j)))
                                                                     (mut k) 0]
                                                                 (splice-do-into! (mut flat)
                                                                                  sp)
                                                                 (let [m
                                                                         (len (load flat))]
                                                                   (loop (if (>= (load k)
                                                                                 m)
                                                                             (break)
                                                                             (do
                                                                               (push! (mut gen)
                                                                                      (get (load flat)
                                                                                           (load k)))
                                                                               (push! (mut genmods)
                                                                                      md)
                                                                               (store! k
                                                                                       (primitive/iadd (load k)
                                                                                                       1))))))
                                                                 0)
                                                               (do
                                                                 (push! (mut gen)
                                                                        sexp)
                                                                 (push! (mut genmods)
                                                                        (get (load meta-modules) (get (load picked) (load j))))
                                                                 0)))))))
                                             (store! j
                                                     (primitive/iadd (load j) 1)))))
                                 (match (load errf)
                                   (Some [d] (Err [i64 Diag] d))
                                   (None []
                                         (do
                                           (if (= (primitive/cast i64 collect) 0)
                                               (splice-metas (mut s)
                                                             (box-al [Sexp]
                                                                     a
                                                                     (load gen))
                                                             (box-al [(Option (slice u8))]
                                                                     a
                                                                     (load genmods))
                                                             (box-al [i64] a (load picked))
                                                             a)
                                               (do
                                                 (for [g 0 (len (load gen))]
                                                   (push! (mut (.gen collect)) (get (load gen) g))
                                                   (push! (mut (.genmods collect)) (get (load genmods) g)))
                                                 (for [g 0 (len (load picked))]
                                                   (push! (mut (.picked collect)) (get (load picked) g)))
                                                 0))
                                           (Ok [i64 Diag] 0))))))))))))))))

;;; Run meta entry E, with target questions answering for RUN-AS when HOST is set.
(defn meta-run-as [(host (ptr HostStage))
                   (run-as TargetArchCell)
                   (a (dyn Allocator))
                   (e (ptr MEEntry))
                   (cx (ptr CtCtx))
                   (env (ptr (ArrayList EnvBind)))] (-> (Result Sexp Diag))
  (if (= (primitive/cast i64 host) 0)
      (meta-engine-run-env a e cx env)
      (let [prior (target-cell-swap! run-as)
            result (meta-engine-run-env a e cx env)]
        (target-cell-swap! prior)
        result)))

;;; The program's (meta …) forms, in the order meta-form-modules lists them.
(defn meta-form-syntax [(s (mut LS)) (a (dyn Allocator))] (-> (ptr (ArrayList Sexp)))
  (let [(mut out) (ArrayList::new [Sexp] a)]
    (for [i 0 (len (.out s))]
      (let [tf (elem (field s out) i)]
        (when (is-meta-form (field tf form))
          (push! (mut out) (load (field tf form)))
          0)))
    (box-al [Sexp] a (load out))))

;;; Elaborate the metas, then the authoritative strict resolve and check.
(defn elaborate-metas-compiled [(a (dyn Allocator)) (s (mut LS))] (-> (Result (ptr Program)
                                                                              Diag))
  (let [prefix (meta-output-prefix (mut s))]
    (match (elaborate-metas-into! a (mut s))
      (Err [d] (Err [(ptr Program) Diag] d))
      (Ok [_]
          (match (resolve-meta-output a (mut s) prefix)
            (Err [d] (Err [(ptr Program) Diag] d))
            (Ok [prog2] (check-strict-resolved a (mut s) prog2)))))))

; splice-metas retains all non-meta forms as a prefix and appends generated
; syntax. Remember that boundary before elaboration, including an empty suffix.
(defn meta-output-prefix [(s (mut LS))] (-> i64)
  (let [(mut n) 0]
    (for [i 0 (len (.out s))]
      (unless (is-meta-form (field (elem (field s out) i) form))
        (set! n (+ (load n) 1))))
    (load n)))

; These declarations can be expanded using an existing macro environment. Other
; forms may alter imports, registrations or the definition-time tower itself.
; A struct or sum is a declaration like a constant: the expansion records it as
; a sibling for the generated forms after it (do-produced), so a macro there can
; reflect on it. A static assertion declares nothing. One that may involve Code
; is the tower's business and is not local: any symbol naming a Code type makes
; it so, which is conservative (a parameter merely named `Code` counts too).
(defn meta-output-local-form? [(f (ptr Sexp))] (-> bool)
  (match (l-list-head f)
    (Some [h]
      (and (or (= h "const") (or (= h "extern")
                 (or (= h "def") (or (= h "defn")
                   (or (= h "defn*") (or (= h "defstruct")
                     (or (= h "defsum") (= h "static-assert"))))))))
           (not (mentions-code-type-name? f))))
    (None [] false)))

; Reuse the completed expansion's checked closure for ordinary generated
; declarations. Unaffected forms never enter a snapshot, tower or syntax walk.
; The full path remains authoritative when the macro universe or syntax-phase
; pipeline changes; it must see the whole program in those cases. It is also the
; only source of diagnostics: a suffix that fails to expand here falls back, so
; an error is never reported from this shortcut's older compile-time context.
(defn expand-meta-suffix [(a (dyn Allocator)) (s (mut LS)) (prefix i64)]
  (-> bool)
  (let [b (checker-reg-box)
        r (field b reg)
        forms (box-al [TaggedForm] a (.out s))]
    (if (or (= (.init b) 0) (= (.active r) 0))
      false
      (block :fallback
        ; The checked closure belongs to this exact expansion generation. A
        ; semantic rewrite, or an earlier wave that added definitions, can
        ; change helpers and constants even without adding a Code signature.
        ; Keep only a shallow list of identity/revision witnesses, never a
        ; whole-program syntax clone.
        (let [(mut kept) 0]
          (for [i 0 (len (.expanded r))]
            (let [old (elem (field r expanded) i)]
              (unless (is-meta-form (field old form))
                (when (>= (load kept) prefix)
                  (break :fallback false))
                (let [current (elem forms (load kept))]
                  (unless (and (primitive-module-eq? (.module old) (.module current))
                               (and (= (.revision old) (.revision current))
                                    (= (sx-node-id (.form old))
                                       (sx-node-id (.form current)))))
                    (break :fallback false)))
                (set! kept (+ (load kept) 1)))))
          (unless (= (load kept) prefix)
            (break :fallback false)))
        ; A before-expand transform rewrites unexpanded syntax, so meta output
        ; would have to go through it again before expansion. An after-expand
        ; transform runs over the expanded program, meta output included, below.
        (let [impb (box-al [ImpEntry] a (.imports s))
              expb (box-al [ExpEntry] a (.exports s))]
          (for [i 0 (len (.pipeline_forms s))]
            (let [tf (elem (field s pipeline_forms) i)]
              (when (registration-in-phase? (field tf form) (.module tf) impb expb a (phase/BeforeExpand))
                (break :fallback false)))))
        (for [i prefix (len (load forms))]
          (unless (meta-output-local-form? (field (elem forms i) form))
            (break :fallback false)))
        (let [macros (.macros r)
              allfns (all-defn-names forms a)
              gs (box! a SBoxStruct (load (.gs r)))
              gu (box! a SBoxSum (load (.gu r)))
              result (box! a SBoxTF (primitive/zeroed SBoxTF))
              env (primitive/alloc-stack ExpEnv)
              (mut depth) 0
              (mut errf) (None [Diag])]
          ; Sibling declarations are appended while expanding. Keep a failed
          ; attempt from mutating the retained registry's ArrayList buffers.
          (set! (.items gs) (ls-copy-list [StructDef] a (.items gs)))
          (set! (.items gu) (ls-copy-list [SumDef] a (.items gu)))
          (set! (.items result) (ArrayList::new [TaggedForm] a))
          (set! (.macros env) macros)
          (set! (.comptime env) (.comptime r))
          (set! (.sub env) (.checked r))
          (set! (.impb env) (box-al [ImpEntry] a (.imports s)))
          (set! (.expb env) (box-al [ExpEntry] a (.exports s)))
          (set! (.bound env) (box-al [(slice u8)] a (ArrayList::new [(slice u8)] a)))
          (set! (.a env) a)
          (macros-index-reset!)
          (declared-names-set! allfns a)
          (declared-traits-collect! (mut s) forms)
          (for [i 0 prefix]
            (push! (mut (.items result)) (get (load forms) i)))
          (for [i prefix (len (load forms))]
            (let [tf (elem forms i)]
              (match (expand-top-form (field tf form) (.module tf) env
                                     (field allfns items) (field gs items)
                                     (field gu items) (mut depth) (mut s))
                (Err [_] (break :fallback false))
                (Ok [out]
                  (do-produced (box-sexp a out) (.module tf) tf result gs gu
                               allfns a (mut errf)))))
            (match (load errf)
              (Some [_] (break :fallback false))
              (None [] 0)))
          ; A declaration macro can emit new compile-time definitions or pipeline
          ; forms. Restart from the untouched input rather than accepting those
          ; with an engine that predates them.
          (for [i prefix (len (.items result))]
            (unless (meta-output-local-form?
                      (field (elem (field result items) i) form))
              (break :fallback false)))
          ; What the full re-expansion would do last: the after-expand
          ; transforms, over the whole program with the meta output expanded
          ; (they are idempotent, so the part they already rewrote stays as it
          ; is). run-after-expand sets the program to their output.
          (when (= (primitive/cast i64 (.posttx r)) 0)
            (break :fallback false))
          (match (run-after-expand (.posttx r) (.checked r)
                                   (box-al [TaggedForm] a (.items result))
                                   allfns gs gu (.impb env) (.expb env)
                                   (mut s) a)
            (Err [_] (break :fallback false))
            (Ok [_] true)))))))

; Generated meta output is source syntax and can contain declaration/binding
; macros. Normalize it before authoritative parsing, retaining the pipeline.
; The checkers already ran over the authored program in the first expansion, and
; meta output is generated syntax they do not judge: running them again in the
; full re-expansion reported every finding twice in any program with a `(meta …)`
; form. The suffix shortcut runs no checkers.
(defn resolve-meta-output [(a (dyn Allocator)) (s (mut LS)) (prefix i64)]
  (-> (Result (ptr Program) Diag))
  (if (expand-meta-suffix a (mut s) prefix)
      (resolve-program a (mut s) true false)
      (let [registry (load (checker-reg-box))
            quiet (checkers-quiet)
            was-quiet (load quiet)
            _quiet (store! quiet true)
            result (expand-stage3 (mut s))]
        (store! quiet was-quiet)
        (store! (checker-reg-box) registry)
        (match result
          (Err [d] (Err [(ptr Program) Diag] d))
          (Ok [_] (resolve-program a (mut s) true false))))))

; Finish an authoritative strict resolve. Body-resolution errors are recoverable so
; resolve-program can diagnose several functions in one pass; it marks those bodies
; poisoned and records their diagnostics in LS. Every strict entry path must merge
; that sink after checking. The meta-elaboration path used to call check-program
; directly and silently discarded it, allowing callers of a poisoned/omitted helper
; to reach codegen as `unknown callable`.
(defn check-strict-resolved [(a (dyn Allocator))
                             (s (mut LS))
                             (prog (ptr Program))] (-> (Result (ptr Program)
                                                               Diag))
  (let [check-span (tr/span-begin "frontend.check.typecheck")
        cres (check-program-running-lengths a prog (mut s) true)
        _check-end (tr/span-end check-span)
        nrd (len (load (field s resolve_diags)))]
    (if (= nrd 0)
        cres
        (do
          (merge-resolve-diags a (mut s))
          (Err [(ptr Program) Diag]
               (get (load (field s check_diags)) 0))))))

(defn strict-resolve-check [(a (dyn Allocator)) (s (mut LS))] (-> (Result (ptr Program)
                                                                          Diag))
  ; Meta elaboration performs its own tolerant resolve to build the generator
  ; context, then an authoritative strict resolve after splicing. Do not resolve
  ; the whole program once before that merely to rediscover the metas the loader
  ; has already recorded.
  (if (ls-has-meta (mut s))
      (let [meta-span (tr/span-begin "frontend.check.meta-elaboration")
            result (elaborate-metas-compiled a (mut s))
            _meta-end (tr/span-end meta-span)]
        result)
      (let [resolve-span (tr/span-begin "frontend.check.resolve")
            resolved (resolve-program a (mut s) true false)
            _resolve-end (tr/span-end resolve-span)]
        (match resolved
          ; a FATAL resolve error (parse / signature / struct / sum) aborts as before.
          (Err [d] (Err [(ptr Program) Diag] d))
          (Ok [prog] (check-strict-resolved a (mut s) prog))))))

; Best-effort resolve+check for the model: swallow errors, returning None on failure.
; Reset the collected check diagnostics so a failed attempt never pollutes the final
; (authoritative) error report.
;;; Install the semantic model transforms query this round: complete when the
;;; program checks, partial when resolution produced a program but some of it
;;; does not check, none otherwise.
(defn install-transform-model! [(a (dyn Allocator)) (s (mut LS))] (-> i64)
  (match (try-resolve-check a (mut s))
    (None [] (clear-sem-model))
    (Some [cp]
          (let [dgs (load (field s check_diags))]
            ; A partial model is read through the same loader tables as a
            ; complete one (declarations, signatures, forms); only its status
            ; and diagnostics differ.
            (set-sem-model-from-loader! s cp)
            (when (> (len dgs) 0)
              (mark-sem-model-partial! (box-al [Diag] a dgs))
              0)
            (set-sem-model-checked-base!
              (primitive/cast (ptr checkedbase/CheckedBase) (.persistent_checked s)))
            (set! (.dependency_base (sem-model-box))
              (primitive/cast (ptr deps/DepBase) (.persistent_dependencies s)))))))

(defn check-transform-model-resolved [(a (dyn Allocator))
                                      (s (mut LS))
                                      (prog (ptr Program))] (-> (Result (ptr Program) Diag))
  (let [cres (check-program-running-lengths a prog (mut s) false)]
    (when (> (len (load (field s resolve_diags))) 0)
      (merge-resolve-diags a (mut s))
      0)
    cres))

(defn try-resolve-check [(a (dyn Allocator)) (s (mut LS))] (-> (Option (ptr Program)))
  (set! (load (field s check_diags)) (ArrayList::new [Diag] a))
  ; Ownership-elaboration transforms need semantic facts about source that may
  ; intentionally contain repeated affine uses. Build their provisional model
  ; through ordinary resolution/type synthesis only. The final path below the
  ; transform fixpoint still calls strict-resolve-check and therefore reruns every
  ; semantic map plus affine validation and drop elaboration from scratch.
  (let [had-meta (ls-has-meta (mut s))
        prefix (meta-output-prefix (mut s))
        ; Meta elaboration splices its output into the program as it goes. A
        ; provisional attempt that fails must leave the program as it found it:
        ; kept, the half-elaborated forms (metas gone, their output unexpanded)
        ; reached the authoritative check, which reported that instead of the
        ; real error.
        before (box-al [TaggedForm] a (.out s))
        provisional
          (if had-meta
              ; Meta output must be spliced and expanded before the provisional
              ; check. Its strict check would reject a field that a semantic
              ; transform is about to lower, leaving type-of with an empty map.
              (match (elaborate-metas-into! a (mut s))
                (Err [d] (Err [(ptr Program) Diag] d))
                (Ok [_]
                    (match (resolve-meta-output a (mut s) prefix)
                      (Err [d] (Err [(ptr Program) Diag] d))
                      (Ok [prog] (check-transform-model-resolved a (mut s) prog)))))
              (match (resolve-program a (mut s) true false)
                (Err [d] (Err [(ptr Program) Diag] d))
                (Ok [prog] (check-transform-model-resolved a (mut s) prog))))]
    (match provisional
      (Err [d]
           (do (when had-meta (set! (.out s) (load before)) 0)
               (None [(ptr Program)])))
      (Ok [cp] (Some cp)))))

;;; A transform that runs on the expanded program (no `:phase`, or `:phase
;;; (phase/AfterExpand)`) returns forms that are never expanded again, so each must be a
;;; core top-level form. A macro such as `defn` used to reach the parser as an
;;; "unknown top-level form" located at the transform's registration, which named
;;; neither the transform's output nor the rule.
(defn semantic-transform-output-diag [(a (dyn Allocator))
                                      (forms (ptr (ArrayList TaggedForm)))] (-> (Option Diag))
  (block :found
    (for [i 0 (len (load forms))]
      (let [f (field (elem forms i) form)]
        (match (l-list-head f)
          (Some [h]
                (unless (top-level-core-form? h)
                  (break :found
                         (Some (diag-at-form f
                                             (sconcat3 a
                                                       "a transform on the expanded program returned `("
                                                       h
                                                       " …)`; its output is not expanded again, so it must emit core forms (`defn*`, `defstruct`, …), or be registered `:phase (phase/BeforeExpand)`")))))
                0)
          (None [] 0))))
    (None [Diag])))

; The transform fixpoint. Returns Ok(0) when the program stabilizes (final forms left
; in s.out for the caller's strict check), or Err on a transform error / non-fixpoint.
(defn run-transform-fixpoint [(a (dyn Allocator))
                              (s (mut LS))
                              (r (ptr CheckerReg))] (-> (Result i64 Diag))
  (let [(mut iters) 0
        (mut out) (Ok [i64 Diag] 0)
        (mut done) false]
    ;; Single-pass semantic transforms still receive the authoritative model,
    ;; but they do not pay for a second invocation and speculative model merely
    ;; to prove that their declared-complete output is a fixpoint.
    (when (> (len (load (field r semtx-once))) 0)
      (let [model-span (tr/span-begin "frontend.check.transform-once.model")]
        (install-transform-model! a (mut s))
        (tr/span-end model-span))
      (let [forms (box-al [TaggedForm] a (.out s))
            impb
              (box! a
                    (ArrayList ImpEntry)
                    (primitive/zeroed (ArrayList ImpEntry)))
            expb
              (box! a
                    (ArrayList ExpEntry)
                    (primitive/zeroed (ArrayList ExpEntry)))
            transformer-span (tr/span-begin "frontend.check.transform-once.run")]
        (set! impb (.imports s))
        (set! expb (.exports s))
        (let [transform-result
                (run-transformers (load (field r semtx-once))
                                  (load (field r checked))
                                  forms
                                  (load (field r allfns))
                                  (load (field r gs))
                                  (load (field r gu))
                                  impb
                                  expb
                                  a
                                  (load (field s code_session_state)) (field s expansions))
              _transformer-end (tr/span-end transformer-span)]
          (match transform-result
            (Err [d] (do (set! out (Err [i64 Diag] d)) (set! done true) 0))
            (Ok [newforms]
                (match (semantic-transform-output-diag a newforms)
                  (Some [d] (do (set! out (Err [i64 Diag] d)) (set! done true) 0))
                  (None []
                    (do
                      (set! (.out s) (load newforms))
                      (when (= (len (load (field r semtx))) 0)
                        (set! done true)
                        0)
                      0))))))))
    (loop (if (load done)
              (break)
              (do
                (let [model-span
                        (tr/span-begin "frontend.check.transform.model")]
                  (install-transform-model! a (mut s))
                  (tr/span-end model-span))
                (let [forms (box-al [TaggedForm] a (.out s))
                      impb
                        (box! a
                              (ArrayList ImpEntry)
                              (primitive/zeroed (ArrayList ImpEntry)))
                      expb
                        (box! a
                              (ArrayList ExpEntry)
                              (primitive/zeroed (ArrayList ExpEntry)))
                      transformer-span
                        (tr/span-begin "frontend.check.transform.run")]
                  (set! impb (.imports s))
                  (set! expb (.exports s))
                  (let [transform-result
                          (run-transformers (load (field r semtx))
                                            (load (field r checked))
                                            forms
                                            (load (field r allfns))
                                            (load (field r gs))
                                            (load (field r gu))
                                            impb
                                            expb
                                            a
                                            (load (field s code_session_state)) (field s expansions))
                        _transformer-end (tr/span-end transformer-span)]
                    (match transform-result
                      (Err [d]
                           (do (set! out (Err [i64 Diag] d)) (set! done true) 0))
                      (Ok [newforms]
                          (match (semantic-transform-output-diag a newforms)
                           (Some [d] (do (set! out (Err [i64 Diag] d)) (set! done true) 0))
                           (None []
                          (let [equal-span
                                  (tr/span-begin "frontend.check.transform.compare")
                                equal (forms-equal newforms forms)
                                _equal-end (tr/span-end equal-span)]
                            (if equal
                                (do
                                  (mtrace-note "fixpoint reached — output stopped changing")
                                  (set! done true)
                                  0)
                                (if (>= (load iters) 16)
                                    (do
                                      (mtrace-note "ROUND LIMIT: a transform keeps rewriting its own output — it is not a fixed point")
                                      (set! out
                                            (Err [i64 Diag]
                                                 (derr "transform: did not reach a fixpoint after 16 rounds")))
                                      (set! done true)
                                      0)
                                    (do
                                      (set! (.out s) (load newforms))
                                      (set! iters
                                            (primitive/iadd (load iters) 1))
                                      0)))))))))))))
    (load out)))

; Resolve + typecheck the program, running the transform fixpoint first if any
; transforms are registered. This is the pipeline's authoritative resolve+check.
(defn run-transforms-and-check [(a (dyn Allocator)) (s (mut LS))] (-> (Result (ptr Program)
                                                                              Diag))
  (let [b (checker-reg-box)
        has-tx
          (if (= (.init b) 0)
              false
              (or (> (len (load (field (field b reg) semtx-once)))
                     0)
                  (> (len (load (field (field b reg) semtx)))
                     0)))]
    (if (not has-tx)
        (strict-resolve-check a (mut s))
        (let [transform-span (tr/span-begin "frontend.check.transform-fixpoint")
              ; the fixpoint's strict resolves are followed by the authoritative one
              ws (semantic-workspace (mut s))
              final (.final_strict ws)
              _not-final (set! (.final_strict ws) false)
              transformed (run-transform-fixpoint a (mut s) (field b reg))
              _final (set! (.final_strict ws) final)
              _transform-end (tr/span-end transform-span)]
          (match transformed
            (Err [d] (Err [(ptr Program) Diag] d))
            (Ok [_] (strict-resolve-check a (mut s))))))))

; ── whole-program TRANSFORMERS ───────────────────────────────────────────────
; `(transform FN)` registers FN — a [(prog Code)] -> Code function — run once after
; expansion over the WHOLE program; FN returns the rewritten program and it REPLACES
; the program. The pipeline re-resolves + re-typechecks to a fixpoint.
;
; MODULE-SHAPED (symmetric with checkers): FN is handed the program AS MODULES —
; `((name form…) (name2 form…) …)`, one record per module (head = module-name
; symbol, rest = its top-level forms) — and returns the SAME shape. Because each
; returned module names itself, a transform may ADD or REMOVE forms freely (a GC
; dialect emits a `trace-T` per type; a desugarer rewrites in place): every form in
; a returned module record is tagged with that module. Order within the program is
; irrelevant (the whole program is resolved together), so emitted forms may go
; anywhere in their module. FN must be idempotent — it runs each fixpoint round.
; A representative source id per module (captured from the input) is stamped onto
; freshly-built forms so `(primitive/code-from-user? …)` classifies generated code correctly.
; Their context is -1: unlike 0 (authored syntax), it records that the span is only
; a representative location and must never be used for an automatic source edit.
(defstruct ModRep [(name (slice u8)) (source i64) (lo i64) (hi i64)])

(defn mod-reps [(a (dyn Allocator)) (forms (ptr (ArrayList TaggedForm)))] (-> (ptr (ArrayList ModRep)))
  (let [nf (len (load forms))
        (mut out) (ArrayList::new [ModRep] a)
        (mut i) 0]
    (loop (if (>= (load i) nf)
              (break)
              (do
                (let [tf (elem forms (load i))
                      nm (opt-mod-name (.module tf))
                      (mut seen) false
                      (mut j) 0
                      nout (len (load out))]
                  (loop (if (>= (load j) nout)
                            (break)
                            (do
                              (when (= (load (field (elem out
                                                          (load j))
                                                    name))
                                       nm)
                                (store! seen true)
                                0)
                              (set! j (primitive/iadd (load j) 1)))))
                  (unless (load seen)
                    (let [mr (primitive/alloc-stack ModRep)
                          fp (field tf form)]
                      (store! (field mr name) nm)
                      (store! (field mr source) (sx-source (load fp)))
                      (store! (field mr lo) (sx-lo (load fp)))
                      (store! (field mr hi) (sx-hi (load fp)))
                      (push! (mut out) (load mr))
                      0)))
                (set! i (primitive/iadd (load i) 1)))))
    (box-al [ModRep] a (load out))))

(defn mod-rep-find [(reps (ptr (ArrayList ModRep))) (nm (slice u8))] (-> (ptr ModRep))
  (let [n (len (load reps))
        (mut i) 0
        (mut r) (primitive/cast (ptr ModRep) 0)]
    (loop (if (>= (load i) n)
              (break)
              (do
                (when (= (load (field (elem reps (load i)) name))
                         nm)
                  (store! r (elem reps (load i)))
                  (break))
                (set! i (primitive/iadd (load i) 1)))))
    (load r)))

; module-name symbol -> Option tag ("" = the no-module top level -> None)
(defn mod-name->opt [(nm (slice u8))] (-> (Option (slice u8)))
  (if (= (len nm) 0) (None [(slice u8)]) (Some nm)))

; append one module record `(name form…)` to `out`; err into errf on a bad shape
(defn append-module-forms! [(a (dyn Allocator))
                            (out (ptr (ArrayList TaggedForm)))
                            (rec (ptr Sexp))
                            (reps (ptr (ArrayList ModRep)))
                            (errf (ptr (Option Diag)))] (-> i64)
  (if (not (or (= (sx-tag (load rec)) 6)
               (= (sx-tag (load rec)) 7)))
      (do
        (set! errf
              (Some (derr "transform: each module must be a list (name form…)")))
        0)
      (let [items (sx-items (load rec))
            ni (sx-len items)]
        (if (or (= ni 0)
                (!= (sx-tag (sx-at items 0)) 2))
            (do
              (set! errf
                    (Some (derr "transform: a module record's head must be its name symbol")))
              0)
            (let [nmname (sx-sval (sx-at items 0))
                  tag (mod-name->opt nmname)
                  rep (mod-rep-find reps nmname)
                  (mut k) 1]
              (loop (if (>= (load k) ni)
                        (break)
                        (do
                          (let [fp (box-sexp a (sx-at items (load k)))]
                            ; Freshly-built forms carry dummy spans. Give them the module's
                            ; representative source for diagnostics and ownership, but keep
                            ; generated provenance distinct from authored context 0: a checker
                            ; may warn about this code, but must not edit the representative span.
                            (when (and (< (sx-lo (load fp))
                                          0)
                                       (!= (primitive/cast i64 rep)
                                           0))
                              (stamp-expansion fp
                                               (load (field rep source))
                                               (load (field rep lo))
                                               (load (field rep hi))
                                               -1))
                            (push! [TaggedForm] out (mk-tagged (load fp) tag)))
                          (set! k (primitive/iadd (load k) 1)))))
              0)))))

; rebuild the tagged-form list from a returned `((name form…) …)` module list
(defn forms-from-modules [(a (dyn Allocator))
                          (modlist (ptr (ArrayList Sexp)))
                          (reps (ptr (ArrayList ModRep)))] (-> (Result (ptr (ArrayList TaggedForm))
                                                                       Diag))
  (let [nm (len (load modlist))
        outbox
          (box! a
                (ArrayList TaggedForm)
                (primitive/zeroed (ArrayList TaggedForm)))
        errbox (primitive/alloc-stack (Option Diag))
        (mut i) 0]
    (set! outbox (ArrayList::new [TaggedForm] a))
    (set! errbox (None [Diag]))
    (loop (if (or (diag-some? (load errbox)) (>= (load i) nm))
              (break)
              (do
                (append-module-forms! a
                                      outbox
                                      (elem modlist (load i))
                                      reps
                                      errbox)
                (set! i (primitive/iadd (load i) 1)))))
    (match (load errbox)
      (Some [d] (Err [(ptr (ArrayList TaggedForm)) Diag] d))
      (None [] (Ok [(ptr (ArrayList TaggedForm)) Diag] outbox)))))

(defn is-transform-form [(f (ptr Sexp))] (-> bool)
  (and (= (sx-tag (load f)) 6)
       (let [it (sx-items (load f))]
         (and (or (= (sx-len it) 2)
                  (= (sx-len it) 4))
              (and (= (sx-tag (sx-at it 0)) 2)
                   (or (= (sx-sval (sx-at it 0)) "transform")
                       (= (sx-sval (sx-at it 0)) "transform-once")))))))

(defn is-transform-once-form [(f (ptr Sexp))] (-> bool)
  (and (is-transform-form f)
       (= (sx-sval (sx-at (sx-items (load f)) 0)) "transform-once")))

; ── (register-derive Trait :struct FN :sum FN) ───────────────────────────────
; The explicit link from a trait to the functions that derive it. `defderive` is
; sugar that writes one of these; writing it yourself is supported and is the only
; other way to make a function a deriver — there is deliberately no spelling of a
; plain `defn` that has the same effect.
;
; Discovered in the same pre-scan as `checker`/`transform`, and for the same
; reason: it declares something the rest of the compilation depends on, so it is
; read off the loaded source before any of that compilation runs.
(defn is-register-derive-form [(f (ptr Sexp))] (-> bool)
  (and (= (sx-tag (load f)) 6)
       (let [it (sx-items (load f))]
         (and (>= (sx-len it) 2)
              (and (= (sx-tag (sx-at it 0)) 2)
                   (= (sx-sval (sx-at it 0)) "register-derive"))))))

;;; The symbol following `:struct` / `:sum`, or "" when that arm is absent. A
;;; keyword's `sval` carries no colon, so `key` is "struct"/"sum".
(defn regd-arm [(it (ptr (ArrayList Sexp))) (key (slice u8))] (-> (slice u8))
  (let [n (sx-len it)
        (mut i) 2
        (mut out) ""]
    (loop (if (>= (primitive/iadd (load i) 1) n)
              (break)
              (do
                (when (and (= (sx-tag (sx-at it (load i)))
                              3)
                           (and (= (sx-sval (sx-at it (load i))) key)
                                (= (sx-tag (sx-at it
                                                  (primitive/iadd (load i) 1)))
                                   2)))
                  (store! out (sx-sval (sx-at it (primitive/iadd (load i) 1))))
                  0)
                (set! i (primitive/iadd (load i) 2)))))
    (load out)))

;;; Resolve one arm to its QUALIFIED name. "" in, "" out (the arm is absent, which
;;; is legal); a name that does not resolve is an error rather than a silently
;;; dropped arm — that would turn into "trait has no deriver for sums" much later,
;;; pointing at the use site instead of at the typo.
(defn regd-resolve [(raw (slice u8))
                    (module (Option (slice u8)))
                    (macros (ptr (ArrayList (slice u8))))
                    (impb (ptr (ArrayList ImpEntry)))
                    (expb (ptr (ArrayList ExpEntry)))
                    (a (dyn Allocator))
                    (okf (mut bool))] (-> (slice u8))
  (if (= raw "")
      ""
      (match (resolve-macro raw module macros impb expb a)
        (Some [q] q)
        (None [] (do (set! okf false) "")))))

(defn register-derive-form! [(f (ptr Sexp))
                             (module (Option (slice u8)))
                             (macros (ptr (ArrayList (slice u8))))
                             (impb (ptr (ArrayList ImpEntry)))
                             (expb (ptr (ArrayList ExpEntry)))
                             (a (dyn Allocator))] (-> (Option Diag))
  (let [it (sx-items (load f))]
    (if (!= (sx-tag (sx-at it 1)) 2)
        (Some (derr "register-derive: expected (register-derive Trait :struct FN :sum FN)"))
        (let [trait (sx-sval (sx-at it 1))
              (mut ok) true
              astruct
                (regd-resolve (regd-arm it "struct")
                              module
                              macros
                              impb
                              expb
                              a
                              (mut ok))
              asum
                (regd-resolve (regd-arm it "sum")
                              module
                              macros
                              impb
                              expb
                              a
                              (mut ok))]
          (cond (not (load ok))
                  (Some (derr "register-derive: each arm must name a [(T Code)] -> Code function in scope"))
                (and (= astruct "") (= asum ""))
                  (Some (derr "register-derive: needs at least one of :struct FN / :sum FN"))
                :else
                  (derive-reg-put! trait astruct asum module impb expb a))))))

;;; Is this form a `(do …)` bundle — the shape a macro returns when it produces
;;; more than one top-level form?
(defn do-bundle? [(s (ptr Sexp))] (-> bool)
  (and (= (sx-tag (load s)) 6)
       (let [it (sx-items (load s))]
         (and (>= (sx-len it) 1)
              (and (= (sx-tag (sx-at it 0)) 2)
                   (= (sx-sval (sx-at it 0)) "do"))))))

;;; Append `s` to `out` as top-level forms, flattening `do` bundles ALL THE WAY DOWN.
;;;
;;; One level is not enough as soon as macros compose. `(derive Eq Hash T)` builds a
;;; `do` of two deriver calls, and a deriver that emits both a function and an impl
;;; returns a `do` of its own — so the result is `(do (do …) (do …))`, and splicing
;;; one level handed the parser an inner `(do …)` as a top-level form: "unknown
;;; top-level form 'do'". Nothing about that is specific to derive; any macro over
;;; macros hits it, which is why the fix belongs here rather than in `derive`.
(defn splice-do-into! [(out (ptr (ArrayList Sexp))) (s (ptr Sexp))] (-> i64)
  (if (do-bundle? s)
      (let [it (sx-items (load s))
            n (sx-len it)
            (mut k) 1]
        (loop (if (>= (load k) n)
                  (break)
                  (do
                    (splice-do-into! out (elem it (load k)))
                    (set! k (primitive/iadd (load k) 1)))))
        0)
      (do (push! [Sexp] out (load s)) 0)))

(defn unpack-do [(s (ptr Sexp)) (a (dyn Allocator))] (-> (ptr (ArrayList Sexp)))
  (let [(mut out) (ArrayList::new [Sexp] a)]
    (if (do-bundle? s)
        (let [it (sx-items (load s))
              n (sx-len it)
              (mut k) 1]
          (loop (if (>= (load k) n)
                    (break)
                    (do
                      (splice-do-into! (mut out) (elem it (load k)))
                      (set! k (primitive/iadd (load k) 1))))))
        (push! (mut out) (load s)))
    (box-al [Sexp] a (load out))))

;;; A transform's result as module records. It may return the records `do`-wrapped
;;; or as a plain list, the same shape it was handed: `(do (m1 …) (m2 …))`,
;;; `((m1 …) (m2 …))`, and `()` for no modules. A single record `(m1 …)` starts
;;; with its name symbol, so a list whose first element is itself a list is the
;;; plain module-list form.
(defn transform-module-records [(s (ptr Sexp)) (a (dyn Allocator))] (-> (ptr (ArrayList Sexp)))
  (if (and (= (sx-tag (load s)) 6)
           (or (= (sx-len (sx-items (load s))) 0)
               (let [head (sx-at (sx-items (load s)) 0)]
                 (or (= (sx-tag head) 6)
                     (= (sx-tag head) 7)))))
      (let [items (sx-items (load s))
            (mut out) (ArrayList::new [Sexp] a)]
        (for [k 0 (sx-len items)] (push! (mut out) (sx-at items k)))
        (box-al [Sexp] a (load out)))
      (unpack-do s a)))

;;; Whether two syntax trees are the same syntax as carried: equal atoms, and on
;;; every node the same span, provenance and hygiene. Only node ids may differ,
;;; since the metaprogram engine numbers the nodes it hands back itself.
(defn syntax-carried-identical? [(x (ptr Sexp)) (y (ptr Sexp))] (-> bool)
  (let [tx (sx-tag (load x))
        ty (sx-tag (load y))]
    (and (= tx ty)
         (and (and (= (.lo x) (.lo y)) (= (.hi x) (.hi y)))
              (and (and (= (.source x) (.source y)) (= (.ctxt x) (.ctxt y)))
                   (and (and (= (.hyg x) (.hyg y)) (= (.hmod x) (.hmod y)))
                        (and (and (= (.horigin x) (.horigin y)) (= (.hflags x) (.hflags y)))
                             (if (or (= tx 6) (= tx 7))
                                 (let [xs (sx-items (load x))
                                       ys (sx-items (load y))]
                                   (and (= (sx-len xs) (sx-len ys))
                                        (block :all
                                          (for [i 0 (sx-len xs)]
                                            (unless (syntax-carried-identical? (elem xs i) (elem ys i))
                                              (break :all false)))
                                          true)))
                                 (sexp-eq (load x) (load y))))))))))

;;; A transform hands back the whole program, and most of it is what it was given.
;;; A returned form that is carried-identical to a form of the same module in the
;;; input (syntax-carried-identical?) takes that input form's place, with its form
;;; id and revision, so resolution reuses the parse it already holds for it.
;;; Without this every transform made the whole program new source: each later
;;; resolve re-parsed all of it, and meta output could not be expanded on its own
;;; (expand-meta-suffix compares identities). Each input form lends its identity
;;; to one returned form at most.
(defn adopt-unchanged-transform-forms! [(a (dyn Allocator))
                                        (out (ptr (ArrayList TaggedForm)))
                                        (input (ptr (ArrayList TaggedForm)))] (-> i64)
  (let [(mut latest) (HashMap::new [(slice u8) i64] a (keyops))
        previous (box-al [i64] a (ArrayList::new [i64] a))
        taken (box-al [bool] a (ArrayList::new [bool] a))]
    (for [i 0 (len (load input))]
      (let [key (binding-source-key a (elem input i))]
        (push! [i64] previous (match (get (load latest) key) (Some [j] j) (None [] -1)))
        (push! [bool] taken false)
        (set! (mut latest) key i)))
    (for [i 0 (len (load out))]
      (let [form (elem out i)
            (mut candidate)
              (match (get (load latest) (binding-source-key a form)) (Some [j] j) (None [] -1))]
        (loop (if (< (load candidate) 0)
                  (break)
                  (let [j (load candidate)
                        before (elem input j)]
                    (if (and (not (get (load taken) j))
                             (and (primitive-module-eq? (.module form) (.module before))
                                  (syntax-carried-identical? (field form form)
                                                             (field before form))))
                        (do
                          (set! form (load before))
                          (set! (elem taken j) true)
                          (break))
                        (set! candidate (get (load previous) j))))))))
    0))

(defn run-transformers [(transformers (ptr (ArrayList (slice u8))))
                        (checked (ptr Program))
                        (forms (ptr (ArrayList TaggedForm)))
                        (allfns (ptr SBox))
                        (gs (ptr SBoxStruct))
                        (gu (ptr SBoxSum))
                        (impb (ptr (ArrayList ImpEntry)))
                        (expb (ptr (ArrayList ExpEntry)))
                        (a (dyn Allocator))
                        (code-session-state (ptr i8))
                        (expansions (ptr (ArrayList Expansion)))] (-> (Result (ptr (ArrayList TaggedForm))
                                                                   Diag))
  (let [nt (len (load transformers))]
    (if (= nt 0)
        (Ok [(ptr (ArrayList TaggedForm)) Diag] forms)
        (let [(mut cur) forms
              (mut ti) 0
              (mut errf) (None [Diag])]
          (loop (if (or (diag-some? (load errf)) (>= (load ti) nt))
                    (break)
                    (do
                      (let [reps (mod-reps a (load cur))
                            ; a TRANSFORM returns the authoritative form list, so it must
                            ; not be shown declarations it would then emit a second time
                            proglist
                              (build-modules a (load cur) impb expb false)  ; ((name form…) …)
                            txname (get (load transformers) (load ti))
                            (mut margs) (ArrayList::new [Sexp] a)]
                        (push! (mut margs) proglist)
                        (mtrace-enter txname (load ti) (len (load cur)))
                        (match (expand-macro checked
                                             txname
                                             (box-al [Sexp] a (load margs))
                                             (field allfns items)
                                             (field gs items)
                                             (field gu items)
                                             impb
                                             expb
                                             a
                                             code-session-state expansions)
                          (Err [d]
                               (do
                                 (mtrace-error txname (load ti))
                                 ; An error raised inside the transform has no span
                                 ; of its own; say which transform raised it.
                                 (set! errf
                                       (Some (if (< (.lo d) 0)
                                                 (derr (sconcat a
                                                                (sconcat3 a "in transform '" (display-name txname) "': ")
                                                                (.msg d)))
                                                 d)))
                                 0))
                          (Ok [outs]
                              (let [modlist (transform-module-records (box-sexp a outs) a)]
                                (match (forms-from-modules a modlist reps)
                                  (Err [d]
                                       (do
                                         (mtrace-error txname (load ti))
                                         (set! errf (Some d))
                                         0))
                                  (Ok [newforms]
                                      (do
                                        (adopt-unchanged-transform-forms! a newforms (load cur))
                                        (mtrace-leave txname
                                                      (load ti)
                                                      (not (forms-equal newforms
                                                                        (load cur))))
                                        (set! cur newforms)
                                        0)))))))
                      (set! ti (primitive/iadd (load ti) 1)))))
          (match (load errf)
            (Some [d] (Err [(ptr (ArrayList TaggedForm)) Diag] d))
            (None [] (Ok [(ptr (ArrayList TaggedForm)) Diag] (load cur))))))))

; ═══════════ Staged metacompilation (docs/design/STAGED_METACOMPILATION.md) ═══════════
;
; A before-expand transform may return, among its output forms:
;
;   (stage MARKER FORM…)     a phase-program increment: FORM… compile as an
;                            ISOLATED program (they never enter the runtime
;                            program) whose [Code…] -> Code entries install
;                            additively into the metaprogram engine;
;   (MARKER ENTRY ARG…)      a request: run staged ENTRY on ARG… during this
;                            expansion; the promoted result splices in place and
;                            re-enters the transform fixpoint (language
;                            resumption).
;
; MARKER is an opaque symbol the transform mints (a gensym): requests are
; recognized by declared-marker lookup, never by name inference, so quoted
; syntax and same-spelled runtime data stay data. Stage state is CUMULATIVE
; (increment N compiles with increments 1..N-1; redefinition across increments
; is a hard error) and compilation-scoped (markers route across modules).
(defn stage-declaration? [(f (ptr Sexp))] (-> bool)
  (match (l-list-head f)
    (Some [h] (= h "stage"))
    (None [] false)))

; An owning copy of `s` in `a` — stage compilation works in a disposable arena,
; so anything that outlives it (signatures, diagnostics) copies its bytes out.
(defn stage-own-str [(a (dyn Allocator)) (s (slice u8))] (-> (slice u8))
  (sconcat a s ""))

(defn stage-name-local-start [(name (slice u8)) (i i64)] (-> i64)
  (if (>= i (len name))
      0
      (let [rest (stage-name-local-start name (+ i 1))]
        (if (= (subslice name i (+ i 1)) ".") (+ i 1) rest))))

(defn stage-name-local [(name (slice u8))] (-> (slice u8))
  (subslice name (stage-name-local-start name 0) (len name)))

(defn stage-local-name-declared? [(name (slice u8))
                                  (declared (ptr (ArrayList (slice u8))))
                                  (i i64)
                                  (n i64)] (-> bool)
  (if (>= i n)
      false
      (if (= (stage-name-local name)
             (stage-name-local (get (load declared) i)))
          true
          (stage-local-name-declared? name declared (+ i 1) n))))

;;; Entry points are the functions the stage increments themselves declared, not
;;; "every Code-signed function the resolved phase program can see" (the ambient
;;; core macros are in that program too, and are not stage entries).
(defn stage-declared-names [(names (ptr (ArrayList (slice u8))))
                            (declared (ptr (ArrayList (slice u8))))
                            (a (dyn Allocator))] (-> (ptr (ArrayList (slice u8))))
  (let [(mut out) (ArrayList::new [(slice u8)] a)
        n (len (load names))
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (let [name (get (load names) (load i))]
                  (when (stage-local-name-declared? name
                                                    declared
                                                    0
                                                    (len (load declared)))
                    (push! (mut out) name)
                    0))
                (set! i (+ (load i) 1)))))
    (box-al [(slice u8)] a (load out))))

;;; "Cumulative" must not mean accidental shadowing: a name a later increment
;;; introduces again is a hard error, not a silent redefinition.
(defn stage-form-name-conflict [(forms (ptr (ArrayList TaggedForm)))
                                (defined (ptr (ArrayList (slice u8))))
                                (a (dyn Allocator))] (-> (Option (slice u8)))
  (let [n (len (load forms))
        (mut i) 0
        (mut found) (None [(slice u8)])]
    (loop (if (or (not (opt-str-none? (load found))) (>= (load i) n))
              (break)
              (do
                (let [tf (elem forms (load i))]
                  (match (source-defn-name-of (field tf form))
                    (None [] 0)
                    (Some [name]
                          (let [qual (qualify-name a name (.module tf))]
                            (when (set-contains defined qual)
                              (set! found (Some qual))
                              0)))))
                (set! i (+ (load i) 1)))))
    (load found)))

(defn stage-record-form-names! [(forms (ptr (ArrayList TaggedForm)))
                                (defined (mut (ArrayList (slice u8))))
                                (a (dyn Allocator))] (-> i64)
  (let [n (len (load forms))
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (let [tf (elem forms (load i))]
                  (match (source-defn-name-of (field tf form))
                    (None [] 0)
                    (Some [name]
                          (push! (mut defined)
                                 (qualify-name a name (.module tf))))))
                (set! i (+ (load i) 1)))))
    0))

;;; A `(stage MARKER FORM...)` body is a SEPARATE compilation unit -- it carries
;;; its own imports and its entry names are a protocol that request sites name by
;;; string -- not a template splice. Referential hygiene would otherwise resolve
;;; every symbol in it against the TRANSFORM's module, which is wrong in both
;;; directions: `(defn pick-entry ...)` was registered as
;;; `staged_pick_test.$scope47@staged_pick$pick-entry`, so it matched no request
;;; and the stage looked like it declared no entry at all; and a call to one of
;;; the stage's OWN imports (`syntax-object-from-code` from coil.scheme.phase)
;;; resolved against the transform module, which never imported it, and failed as
;;; undefined. Strip the context over the whole body -- exactly what
;;; `syntax->datum` does for a single identifier (hyg 0, no module, origin 5, the
;;; sanctioned "explicit context removal" state that unscoped-datum linkage
;;; checking accepts).
(defn stage-datum-sexp [(a (dyn Allocator)) (s Sexp)] (-> Sexp)
  (let [tg (sx-tag s)]
    (if (or (= tg 6)
            (or (= tg 7) (= tg 8)))
        (let [n (code-node-len s)
              (mut out) (ArrayList::new [Sexp] a)
              (mut i) 0]
          (loop (if (>= (load i) n)
                    (break)
                    (do
                      (push! (mut out)
                             (stage-datum-sexp a (code-node-at s (load i))))
                      (set! i (primitive/iadd (load i) 1)))))
          ;; A KView is FLATTENED to a KList, for the same reason sexp-own-into
          ;; flattens one: the view borrows a backing list this copy does not own.
          (let [p (primitive/alloc-stack Sexp)]
            (set! p s)
            (set! (.kind p)
                  (if (= tg 7)
                      (KVec (box-al [Sexp] a (load out)))
                      (KList (box-al [Sexp] a (load out)))))
            (set! (.node-id p) (next-node-id))
            (load p)))
        (if (= tg 2)
            (let [p (primitive/alloc-stack Sexp)]
              (set! p s)
              (set! (.hyg p) 0)
              (set! (.hmod p) "")
              (set! (.horigin p) 5)
              (set! (.node-id p) (next-node-id))
              (load p))
            s))))

;;; Split transform output into runtime forms and isolated stage forms. Stage
;;; children retain the declaration's module tag. The declaration's MARKER (its
;;; first child) is recorded; only lists headed by a declared marker are ever
;;; treated as phase requests.
(defn split-stage-declarations! [(a (dyn Allocator))
                                 (forms (ptr (ArrayList TaggedForm)))
                                 (runtime (mut (ArrayList TaggedForm)))
                                 (staged (mut (ArrayList TaggedForm)))
                                 (markers (mut (ArrayList (slice u8))))] (-> (Option Diag))
  (let [n (len (load forms))
        (mut i) 0
        (mut errf) (None [Diag])]
    (loop (if (or (diag-some? (load errf)) (>= (load i) n))
              (break)
              (let [tf (elem forms (load i))
                    f (field tf form)]
                (if (stage-declaration? f)
                    (let [items (sx-items (load f))
                          m (sx-len items)
                          (mut j) 2]
                      (if (or (< m 2)
                              (!= (sx-tag (sx-at items 1))
                                  2))
                          (set! errf
                                (Some (stamp-call-site (derr "stage: expected (stage MARKER FORM...), with a symbol marker")
                                                       (load f))))
                          (do
                            (let [marker (sx-sval (sx-at items 1))]
                              (unless (set-contains (mut markers) marker)
                                (push! (mut markers) marker)
                                0))
                            (loop (if (>= (load j) m)
                                      (break)
                                      (let [out
                                              (mk-tagged (stage-datum-sexp a
                                                                           (sx-at items
                                                                                  (load j)))
                                                         (.module tf))]
                                        (push! (mut staged) out)
                                        (set! j (+ (load j) 1))))))))
                    (push! (mut runtime) (load tf)))
                (set! i (+ (load i) 1)))))
    (load errf)))

;;; The expansion context a staged request runs against: the checked metaprogram
;;; program plus the installed stage entry signatures. An independent funcs array
;;; keeps that augmentation out of the baseline program used by transforms,
;;; checkers, and the runtime resolve.
(defn stage-expansion-context [(base (ptr Program)) (a (dyn Allocator))] (-> (ptr Program))
  (let [out (box! a Program (primitive/zeroed Program))
        src (load (field base funcs))
        n (len (load src))
        (mut funcs) (ArrayList::new [Func] a)
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (push! (mut funcs) (get (load src) (load i)))
                (set! i (+ (load i) 1)))))
    (set! (.annotation_defs out) (.annotation_defs base))
    (set! (.conventions out) (.conventions base))
    (set! (.structs out) (.structs base))
    (set! (.sums out) (.sums base))
    (set! (.externs out) (.externs base))
    (set! (.funcs out) (box-al [Func] a (load funcs)))
    (set! (.asserts out) (.asserts base))
    (set! (.consts out) (.consts base))
    (set! (.traits out) (.traits base))
    (set! (.impls out) (.impls base))
    (set! (.metas out) (.metas base))
    (set! (.exports out) (.exports base))
    (set! (.function_abis out) (.function_abis base))
    (set! (.mono_origins out) (.mono_origins base))
    (set! (.mono_trait_uses out) (.mono_trait_uses base))
    (set! (.unit_exports out) (.unit_exports base))
    (set! (.unit_build out) (.unit_build base))
    (set! (.aliases out) (.aliases base))
    (set! (.retirements out) (.retirements base))
    (set! (.retired_functions out) (.retired_functions base))
    out))

;;; The native engine owns the executable body; expansion retains only this
;;; callable interface. Stage entries admitted by code-sig-funcs are [Code…] ->
;;; Code, so reconstructing that type avoids retaining any pointer-bearing
;;; resolved Type representation from the disposable stage-work arena.
(defn stable-stage-signature [(a (dyn Allocator)) (src (ptr Func))] (-> Func)
  (let [out (primitive/alloc-stack Func)
        ps (load (field src params))
        n (len (load ps))
        (mut stable-ps) (ArrayList::new [Param] a)
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (let [p (elem ps (load i))
                      q (primitive/alloc-stack Param)]
                  (set! (.name q) (stage-own-str a (.name p)))
                  (set! (.positional_only q) (.positional_only p))
                  (set! (.ty q) (TCode))
                  (set! (.bid q) (.bid p))
                  (set! (.owned_type q) (primitive/cast (ptr Type) 0))
                  (push! (mut stable-ps) (load q)))
                (set! i (+ (load i) 1)))))
    (set! (.name out) (stage-own-str a (.name src)))
    (set! (.type_params out) (box-al [(slice u8)] a (ArrayList::new [(slice u8)] a)))
    (set! (.bounds out) (box-al [Bound] a (ArrayList::new [Bound] a)))
    (set! (.cc out) (match (.cc src)
                      (CcResolved [q] (CcResolved (stage-own-str a q)))
                      (CcWrittenValue [n] (CcWrittenValue (stage-own-str a n)))
                      (CcWrittenName [n] (CcWrittenName (stage-own-str a n)))))
    (set! (.annotations out) (box-al [Annotation] a (ArrayList::new [Annotation] a)))
    (set! (.params out) (box-al [Param] a (load stable-ps)))
    (set! (.ret out) (TCode))
    (set! (.body out) (box-al [Expr] a (ArrayList::new [Expr] a)))
    (set! (.macro_variadic out) (.macro_variadic src))
    (set! (.declared out) (.declared src))
    (set! (.lazy out) (.lazy src))
    (set! (.lo out) (.lo src))
    (set! (.hi out) (.hi src))
    (set! (.source out) (.source src))
    (set! (.ctxt out) (.ctxt src))
    (load out)))

;;; A stage-compilation diagnostic crosses the same lifetime boundary as a
;;; successful signature: its message must not point into the closed arena.
(defn stable-stage-diag [(a (dyn Allocator)) (d Diag)] (-> Diag)
  (let [out (primitive/alloc-stack Diag)]
    (set! out d)
    (set! (.msg out) (stage-own-str a (.msg out)))
    (load out)))

(defn install-stage-signatures! [(dst (ptr Program))
                                 (stage (ptr Program))
                                 (installed (ptr (ArrayList (slice u8))))
                                 (declared (ptr (ArrayList (slice u8))))
                                 (a (dyn Allocator))] (-> (ptr (ArrayList (slice u8))))
  (let [quals (stage-declared-names (code-sig-funcs stage a) declared a)
        n (len (load quals))
        (mut added) (ArrayList::new [(slice u8)] a)
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (let [name (get (load quals) (load i))]
                  (unless (set-contains installed name)
                    (let [f (prog-fn-find stage name)]
                      (when (!= (primitive/cast i64 f) 0)
                        (let [stable (stable-stage-signature a f)]
                          (push! (mut (load (field dst funcs))) stable)
                          (push! (mut added) (.name (prog-fn-find dst name))))
                        0))))
                (set! i (+ (load i) 1)))))
    (box-al [(slice u8)] a (load added))))

;;; Compile the CUMULATIVE stage program (every increment declared so far) as an
;;; isolated program, and install its declared entries additively into the
;;; metaprogram engine. `stable-a` owns everything that outlives the call (engine
;;; entries, quote registry — meta-engine-setup allocates from it); `a` is the
;;; disposable stage-work arena. The stage program gets fresh loader tables: its
;;; declarations may have been generated by a transform after the entry program's
;;; loader ran, so it must not rely on (or mutate) the entry program's tables.
(defn expand-stage-declarations [(s (mut LS))
                                 (declared (ptr (ArrayList (slice u8))))] (-> (Result i64
                                                                                      Diag))
  (let [registry (load (checker-reg-box))
        expanded (expand-stage3-phase-except (mut s) declared)]
    (set! (checker-reg-box) registry)
    expanded))

;;; A `(stage …)` program runs inside the compiler, so a cross build compiles it
;;; for the host: every target question answers for the host while it is built.
(defn compile-stage-declarations-for-host [(a (dyn Allocator))
                                           (s (mut LS))
                                           (forms (ptr (ArrayList TaggedForm)))
                                           (declared (ptr (ArrayList (slice u8))))] (-> (Result (ptr Program) Diag))
  (if (cross-build?)
      (let [target (target-cell-swap! (host-target-cell))
            result (compile-stage-declarations a a (mut s) forms declared)]
        (target-cell-swap! target)
        result)
      (compile-stage-declarations a a (mut s) forms declared)))

(defn compile-stage-declarations [(stable-a (dyn Allocator))
                                  (a (dyn Allocator))
                                  (s (mut LS))
                                  (forms (ptr (ArrayList TaggedForm)))
                                  (declared (ptr (ArrayList (slice u8))))] (-> (Result (ptr Program)
                                                                                       Diag))
  (let [stage-ls (primitive/alloc-stack LS)]
    (ls-init! (mut stage-ls) a)
    (set! (.imports stage-ls) (ArrayList::new [ImpEntry] a))
    (set! (.exports stage-ls) (ArrayList::new [ExpEntry] a))
    (set! (.primitive_defs stage-ls) (ArrayList::new [PrimitiveDef] a))
    (set! (.primitive_aliases stage-ls) (ArrayList::new [PrimitiveAlias] a))
    (let [npd (len (.primitive_defs s))
          (mut pdi) 0]
      (loop (if (>= (load pdi) npd)
                (break)
                (do
                  (push! (mut (.primitive_defs stage-ls))
                         (get (.primitive_defs s) (load pdi)))
                  (set! pdi (+ (load pdi) 1))))))
    (let [npa (len (.primitive_aliases s))
          (mut pai) 0]
      (loop (if (>= (load pai) npa)
                (break)
                (do
                  (push! (mut (.primitive_aliases stage-ls))
                         (get (.primitive_aliases s) (load pai)))
                  (set! pai (+ (load pai) 1))))))
    (set! (.srccount stage-ls) (.srccount s))
    (set! (.sources stage-ls) (.sources s))
    (set! (.expansions stage-ls) (.expansions s))
    (set! (.namespace_names stage-ls) (.namespace_names s))
    (set! (.namespace_paths stage-ls) (.namespace_paths s))
    ;; Imported libraries depend on the ambient core program: copy its forms
    ;; into the isolated source set. Core's own Code-signed macros never become
    ;; stage entries (stage-declared-names filters to declared names), but they
    ;; stay available while the stage program's code goes through ordinary
    ;; expansion.
    (let [parent-forms (box-al [TaggedForm] a (.out s))
          np (len (load parent-forms))
          (mut pi) 0]
      (loop (if (>= (load pi) np)
                (break)
                (do
                  (let [tf (elem parent-forms (load pi))]
                    (match (.module tf)
                      (Some [m]
                            (when (= m (implicit-prelude-name a))
                              (push! (mut (field stage-ls out)) (load tf))
                              0))
                      (None [] 0)))
                  (set! pi (+ (load pi) 1))))))
    (let [nf (len (load forms))
          (mut fi) 0]
      (loop (if (>= (load fi) nf)
                (break)
                (do
                  (push! (mut (.out stage-ls)) (get (load forms) (load fi)))
                  (set! fi (+ (load fi) 1))))))
    ;; A stage may import ordinary libraries whose implementations use macros.
    ;; Run the normal definition-time expansion tower before extracting the
    ;; closure; otherwise those calls reach checking as raw Code-macro calls.
    (let [initial-source (box-al [TaggedForm] a (.out stage-ls))]
      (rebuild-transformed-declarations! (mut stage-ls) initial-source))
    (match (if (ls-err? (mut stage-ls))
               (Err [i64 Diag] (.loaderr stage-ls))
               (expand-stage-declarations (mut stage-ls) declared))
      (Err [d] (Err [(ptr Program) Diag] d))
      (Ok [_]
          (do
            ;; Import loading appends newly loaded library modules through
            ;; stage-ls.out; rebuild so THEIR import declarations are processed.
            ;; This must happen BEFORE the metashim joins: rebuild resets the
            ;; importer records, and the shim's imports are registered directly by
            ;; meta-sub-forms rather than through forms it returns.
            (rebuild-transformed-declarations! (mut stage-ls)
                                               (box-al [TaggedForm]
                                                       a
                                                       (.out stage-ls)))
            (imp-entry (mut stage-ls) "coil.compiler.metashim")
            (let [stage-source (box-al [TaggedForm] a (.out stage-ls))]
              (match (meta-sub-forms a (mut stage-ls) stage-source)
                (Err [d] (Err [(ptr Program) Diag] d))
                (Ok [subforms]
                    (do
                      (set! (.out stage-ls) (load subforms))
                      (match (resolve-program a (mut stage-ls) false true)
                        (Err [d] (Err [(ptr Program) Diag] d))
                        (Ok [ctx]
                            (let [quals
                                    (stage-declared-names (code-sig-funcs ctx a)
                                                          declared
                                                          a)]
                              (if (= (len (load quals)) 0)
                                  ;; A poisoned entry has no callable signature, but the
                                  ;; resolver already recorded the concrete reason; do
                                  ;; not hide it behind the generic symptom.
                                  (let [rds
                                          (load (field stage-ls resolve_diags))]
                                    (if (and (!= (primitive/cast i64 rds)
                                                 0)
                                             (> (len (load rds))
                                                0))
                                        (Err [(ptr Program) Diag]
                                             (get (load rds) 0))
                                        (Err [(ptr Program) Diag]
                                             (derr "stage: expected a declared [Code ...] -> Code entry; no stage entry resolved"))))
                                  (let [seeds (meta-shim-seeds a ctx quals)
                                        closure-ctx (with-constant-lengths a ctx)
                                        wanted (closure-funcs closure-ctx seeds a)
                                        sub (closure-subprogram closure-ctx wanted a)
                                        checkls (primitive/alloc-stack LS)]
                                    (ls-init! (mut checkls) a)
                                    (set! (.out checkls)
                                          (ArrayList::new [TaggedForm] a))
                                    (set! (.loaded checkls)
                                          (ArrayList::new [(slice u8)] a))
                                    (set! (.readpaths checkls)
                                          (ArrayList::new [(slice u8)] a))
                                    (set! (.readmods checkls)
                                          (ArrayList::new [(slice u8)] a))
                                    ; The stage's code is read under the stage
                                    ; program's own imports.
                                    (set! (.imports checkls)
                                          (ls-copy-list [ImpEntry] a (.imports stage-ls)))
                                    (set! (.exports checkls)
                                          (ls-copy-list [ExpEntry] a (.exports stage-ls)))
                                    (set! (.primitive_defs checkls)
                                          (ArrayList::new [PrimitiveDef] a))
                                    (set! (.primitive_aliases checkls)
                                          (ArrayList::new [PrimitiveAlias] a))
                                    (set! (.check_diags checkls)
                                          (box-al [Diag] a (ArrayList::new [Diag] a)))
                                    (set! (.resolve_diags checkls)
                                          (primitive/cast (ptr (ArrayList Diag))
                                                          0))
                                    (set! (.resolve_poisoned checkls)
                                          (primitive/cast (ptr (ArrayList (slice u8)))
                                                          0))
                                    ;; The stage check is a SCRATCH pass over a private
                                    ;; LS; snapshot the S0-S3 maps around it, exactly as
                                    ;; stage-one-macro! does (check-program resets them
                                    ;; at entry, and the semantic model may still be
                                    ;; serving an outer invocation).
                                    ;; Unlike stage-one-macro!'s closure — whose Expr
                                    ;; bodies are SHARED with the authoritative program,
                                    ;; so restored maps still cover them — the stage
                                    ;; program's nodes are fresh, and metalower's
                                    ;; ml-node-type reads the type map. Engine setup
                                    ;; therefore runs INSIDE the snapshot window, on the
                                    ;; maps this check just populated.
                                    (let [snap
                                            (primitive/alloc-stack SemMapsSnap)]
                                      (sem-maps-save snap)
                                      (match (check-program a sub (mut checkls))
                                        (Err [d]
                                             (do
                                               (sem-maps-restore snap)
                                               (Err [(ptr Program) Diag] d)))
                                        (Ok [checked]
                                            (let [setup
                                                    (meta-engine-setup stable-a
                                                                       checked
                                                                       quals)]
                                              (sem-maps-restore snap)
                                              (match setup
                                                (Some [d]
                                                      (Err [(ptr Program) Diag]
                                                           d))
                                                (None []
                                                      (Ok [(ptr Program) Diag]
                                                          ctx)))))))))))))))))))))

;;; Stage markers denote executable syntax. A declaration's name, parameter
;;; vector, cc metadata, and return type are syntax/type data, not expression
;;; positions; walking them as arbitrary calls would let an unrelated marker
;;; named `path` reinterpret `(path (slice u8))` in a defn signature as a staged
;;; invocation. Preserve the declaration prefix; begin discovery at the body.
(defn stage-marker-body-start [(items (ptr (ArrayList Sexp)))] (-> i64)
  (if (or (= (sx-len items) 0)
          (!= (sx-tag (sx-at items 0)) 2))
      0
      (let [h (sx-sval (sx-at items 0))]
        (if (or (= h "defn") (= h "defn*") (= h "declare"))
            (if (and (> (sx-len items) 3)
                     (and (= (sx-tag (sx-at items 2)) 3)
                          (= (sx-sval (sx-at items 2)) "cc")))
                6
                4)
            0))))

(defn stage-entry-find [(raw (slice u8))
                        (module (Option (slice u8)))
                        (quals (ptr (ArrayList (slice u8))))
                        (a (dyn Allocator))] (-> (Option (slice u8)))
  (let [name (if (has-dot raw) raw (qualify-name a raw module))]
    (if (set-contains quals name) (Some name) (None [(slice u8)]))))

(defn expand-stage-marker-items [(a (dyn Allocator))
                                 (items (ptr (ArrayList Sexp)))
                                 (module (Option (slice u8)))
                                 (phasectx (ptr Program))
                                 (quals (ptr (ArrayList (slice u8))))
                                 (markers (ptr (ArrayList (slice u8))))
                                 (impb (ptr (ArrayList ImpEntry)))
                                 (expb (ptr (ArrayList ExpEntry)))
                                 (allfns (ptr SBox))
                                 (gs (ptr SBoxStruct))
                                 (gu (ptr SBoxSum))
                                 (depth (mut i64))] (-> (Result (ptr (ArrayList Sexp))
                                                                Diag))
  (let [n (sx-len items)
        start (stage-marker-body-start items)
        (mut out) (ArrayList::new [Sexp] a)
        (mut i) 0
        (mut errf) (None [Diag])]
    (loop (if (>= (load i) start)
              (break)
              (do
                (push! (mut out) (sx-at items (load i)))
                (set! i (+ (load i) 1)))))
    (loop (if (or (diag-some? (load errf)) (>= (load i) n))
              (break)
              (do
                (match (expand-stage-markers a
                                             (elem items (load i))
                                             module
                                             phasectx
                                             quals
                                             markers
                                             impb
                                             expb
                                             allfns
                                             gs
                                             gu
                                             (mut depth))
                  (Err [d] (set! errf (Some d)))
                  (Ok [item] (push! (mut out) item)))
                (set! i (+ (load i) 1)))))
    (match (load errf)
      (Some [d] (Err [(ptr (ArrayList Sexp)) Diag] d))
      (None [] (Ok [(ptr (ArrayList Sexp)) Diag] (box-al [Sexp] a (load out)))))))

;;; Walk arbitrary transform output looking ONLY for lists headed by a declared
;;; marker. Everything else is copied structurally: the compiler does not guess
;;; which list heads are calls, quoted data, binders, or a guest language's
;;; different syntax — the transform owns those decisions, and therefore also
;;; owns guest-language scope and hygiene.
(defn expand-stage-markers [(a (dyn Allocator))
                            (form (ptr Sexp))
                            (module (Option (slice u8)))
                            (phasectx (ptr Program))
                            (quals (ptr (ArrayList (slice u8))))
                            (markers (ptr (ArrayList (slice u8))))
                            (impb (ptr (ArrayList ImpEntry)))
                            (expb (ptr (ArrayList ExpEntry)))
                            (allfns (ptr SBox))
                            (gs (ptr SBoxStruct))
                            (gu (ptr SBoxSum))
                            (depth (mut i64))] (-> (Result Sexp Diag))
  (let [tag (sx-tag (load form))]
    (if (or (= tag 6) (= tag 7))
        (let [items (sx-items (load form))
              quoted
                (and (= tag 6)
                     (and (> (sx-len items) 0)
                          (and (= (sx-tag (sx-at items 0))
                                  2)
                               (= (sx-sval (sx-at items 0)) "quote"))))
              marker
                (and (= tag 6)
                     (and (> (sx-len items) 0)
                          (and (= (sx-tag (sx-at items 0))
                                  2)
                               (set-contains markers (sx-sval (sx-at items 0))))))]
          ;; A stage marker inside quoted syntax is data, not an invocation:
          ;; transforms use quoted values as persistent state between fixpoint
          ;; rounds, and descending into either violates the generic rule.
          (if quoted
              (Ok [Sexp Diag] (load form))
              (if marker
                  (if (< (sx-len items) 2)
                      (Err [Sexp Diag]
                           (stamp-call-site (derr "stage invocation: expected (MARKER ENTRY ARG...)")
                                            (load form)))
                      (if (not (or (= (sx-tag (sx-at items 1))
                                      2)
                                   (= (sx-tag (sx-at items 1))
                                      4)))
                          (Err [Sexp Diag]
                               (stamp-call-site (derr "stage invocation: ENTRY must be a symbol or string")
                                                (load form)))
                          (let [raw (sx-sval (sx-at items 1))]
                            (match (stage-entry-find raw module quals a)
                              (None []
                                    (Err [Sexp Diag]
                                         (stamp-call-site (derr (sconcat3 a
                                                                          "stage invocation: entry '"
                                                                          raw
                                                                          "' is not available in this phase"))
                                                          (load form))))
                              (Some [entry]
                                    (do
                                      (set! depth (+ (load depth) 1))
                                      (if (> (load depth)
                                             100000)
                                          (Err [Sexp Diag]
                                               (stamp-call-site (derr "stage invocation expansion did not terminate")
                                                                (load form)))
                                          (match (let [site (macro-call-site-enter! (load form))
                                                       r (expand-macro phasectx
                                                               entry
                                                               (rest-from a
                                                                          items
                                                                          2)
                                                               (field allfns
                                                                      items)
                                                               (field gs items)
                                                               (field gu items)
                                                               impb
                                                               expb
                                                               a
                                                               (primitive/cast (ptr i8)
                                                                               0) (primitive/cast (ptr (ArrayList Expansion)) 0))]
                                                   (macro-call-site-restore! site)
                                                   r)
                                            (Err [d]
                                                 (Err [Sexp Diag]
                                                      (stamp-call-site d
                                                                       (load form))))
                                            (Ok [out]
                                                ;; A stage may explicitly request another
                                                ;; staged computation in its result.
                                                ;; Re-enter only for a declared marker,
                                                ;; never for an ordinary list head.
                                                (expand-stage-markers a
                                                                      (box-sexp a
                                                                                out)
                                                                      module
                                                                      phasectx
                                                                      quals
                                                                      markers
                                                                      impb
                                                                      expb
                                                                      allfns
                                                                      gs
                                                                      gu
                                                                      (mut depth)))))))))))
                  (match (expand-stage-marker-items a
                                                    items
                                                    module
                                                    phasectx
                                                    quals
                                                    markers
                                                    impb
                                                    expb
                                                    allfns
                                                    gs
                                                    gu
                                                    (mut depth))
                    (Err [d] (Err [Sexp Diag] d))
                    (Ok [out]
                        (Ok [Sexp Diag]
                            (if (= tag 7)
                                (traversed-sexp (KVec out) form)
                                (traversed-sexp (KList out) form))))))))
        (Ok [Sexp Diag] (load form)))))

;;; Execute only explicit phase requests, then return their raw Code to the
;;; syntax-transform fixpoint. Ordinary Coil expansion and Coil hygienization do
;;; not run at this boundary: a Scheme transformer's output may be Scheme syntax,
;;; which must re-enter Scheme lowering on the next round (language resumption).
(defn expand-staged-calls [(a (dyn Allocator))
                           (forms (ptr (ArrayList TaggedForm)))
                           (phasectx (ptr Program))
                           (quals (ptr (ArrayList (slice u8))))
                           (markers (ptr (ArrayList (slice u8))))
                           (impb (ptr (ArrayList ImpEntry)))
                           (expb (ptr (ArrayList ExpEntry)))] (-> (Result (ptr (ArrayList TaggedForm))
                                                                          Diag))
  (let [allfns (all-defn-names forms a)
        gs (box! a SBoxStruct (primitive/zeroed SBoxStruct))
        gu (box! a SBoxSum (primitive/zeroed SBoxSum))
        result (box! a SBoxTF (primitive/zeroed SBoxTF))
        (mut depthv) 0
        (mut errf) (None [Diag])
        (mut i) 0
        n (len (load forms))]
    (set! (.items gs) (ArrayList::new [StructDef] a))
    (set! (.items gu) (ArrayList::new [SumDef] a))
    (set! (.items result) (ArrayList::new [TaggedForm] a))
    (loop (if (or (diag-some? (load errf)) (>= (load i) n))
              (break)
              (do
                (let [tf (elem forms (load i))
                      module (.module tf)]
                  (match (expand-stage-markers a
                                               (field tf form)
                                               module
                                               phasectx
                                               quals
                                               markers
                                               impb
                                               expb
                                               allfns
                                               gs
                                               gu
                                               (mut depthv))
                    (Err [d] (set! errf (Some d)))
                    (Ok [outf]
                        (do-produced (box-sexp a outf)
                                     module
                                     tf
                                     result
                                     gs
                                     gu
                                     allfns
                                     a
                                     (mut errf)))))
                (set! i (+ (load i) 1)))))
    (match (load errf)
      (Some [d] (Err [(ptr (ArrayList TaggedForm)) Diag] d))
      (None []
            (Ok [(ptr (ArrayList TaggedForm)) Diag]
                (field result items))))))

; print all collected `(primitive/warn …)` diagnostics (located, non-fatal) to stderr, or
; to the diagnostic sink a JIT session set (`diag-out`), each followed by the
; `help: try: …` line of any `(primitive/suggest …)` that produced it.
(defn drain-warnings [(s (mut LS))] (-> i64)
  (let [w (diag-out)
        a (.a s)
        lst (warn-list)
        b (warn-box)
        n (unless (diag-quiet?) (len (load lst)))
        (mut i) (.drained b)]
    (loop (if (>= (load i) n)
              (break)
              (do
                (render-diag w (mut s) (get (load lst) (load i)))
                (wb w 10)
                (sug-print-help w a (load i))
                (set! i (primitive/iadd (load i) 1)))))
    (set! (.drained b) n)
    0))

; Run syntax-phase transforms to a fixpoint, then syntax-phase checkers once. No
; resolve/typecheck is attempted here: these metaprograms intentionally see the
; author's raw forms, and semantic reflection therefore observes an empty model.
(defn run-before-expand [(transformers (ptr (ArrayList (slice u8))))
                         (checkers (ptr (ArrayList (slice u8))))
                         (checked (ptr Program))
                         (forms (ptr (ArrayList TaggedForm)))
                         (allfns (ptr SBox))
                         (gs (ptr SBoxStruct))
                         (gu (ptr SBoxSum))
                         (impb (ptr (ArrayList ImpEntry)))
                         (expb (ptr (ArrayList ExpEntry)))
                         (s (mut LS))
                         (a (dyn Allocator))] (-> (Result (ptr (ArrayList TaggedForm))
                                                          Diag))
  (clear-sem-model)
  (let [(mut cur) forms
        phasectx (stage-expansion-context checked a)
        (mut stage-quals) (ArrayList::new [(slice u8)] a)
        (mut stage-markers) (ArrayList::new [(slice u8)] a)
        (mut staged-forms) (ArrayList::new [TaggedForm] a)
        (mut staged-defs) (ArrayList::new [(slice u8)] a)
        (mut iters) 0
        (mut done) false
        (mut errf) (None [Diag])]
    (loop (if (or (load done) (diag-some? (load errf)))
              (break)
              (match (run-transformers transformers
                                       checked
                                       (load cur)
                                       allfns
                                       gs
                                       gu
                                       impb
                                       expb
                                       a
                                       (load (field s code_session_state)) (field s expansions))
                (Err [d] (do (set! errf (Some d)) 0))
                (Ok [next]
                    (let [(mut runtime) (ArrayList::new [TaggedForm] a)
                          (mut staged) (ArrayList::new [TaggedForm] a)
                          (mut round) next
                          (mut stage-progress) false]
                      (match (split-stage-declarations! a
                                                        next
                                                        (mut runtime)
                                                        (mut staged)
                                                        (mut stage-markers))
                        (Some [d] (set! errf (Some d)))
                        (None []
                              (do
                                (when (> (len (load staged))
                                         0)
                                  (set! stage-progress true)
                                  (match (stage-form-name-conflict (box-al [TaggedForm]
                                                                           a
                                                                           (load staged))
                                                                   (box-al [(slice u8)]
                                                                           a
                                                                           (load staged-defs))
                                                                   a)
                                    (Some [name]
                                          (set! errf
                                                (Some (derr (sconcat3 a
                                                                      "stage: definition '"
                                                                      name
                                                                      "' was introduced more than once")))))
                                    (None []
                                          (do
                                            ;; Stage declarations join the CUMULATIVE phase
                                            ;; program: later increments and later rounds
                                            ;; may call the entries earlier ones installed.
                                            (stage-record-form-names! (box-al [TaggedForm]
                                                                              a
                                                                              (load staged))
                                                                      (mut staged-defs)
                                                                      a)
                                            (let [ns (len (load staged))
                                                  (mut si) 0]
                                              (loop (if (>= (load si) ns)
                                                        (break)
                                                        (do
                                                          (push! (mut staged-forms)
                                                                 (get (load staged)
                                                                      (load si)))
                                                          (set! si
                                                                (+ (load si) 1))))))
                                            ;; The stage compilation allocates from the
                                            ;; durable allocator for now: a disposable
                                            ;; per-increment arena needs a completed
                                            ;; ownership audit first (the engine image
                                            ;; shares mono/interp structure with the
                                            ;; checked graph — the branch's "premature
                                            ;; freeing created dangling registries" trap).
                                            ;; Mainline stage3 makes the same trade on its
                                            ;; success round.
                                            (match (compile-stage-declarations-for-host a
                                                                                        (mut s)
                                                                                        (box-al [TaggedForm]
                                                                                                a
                                                                                                (load staged-forms))
                                                                                        (box-al [(slice u8)]
                                                                                                a
                                                                                                (load staged-defs)))
                                              (Err [d]
                                                   (do
                                                     (set! errf
                                                           (Some (stable-stage-diag a
                                                                                    d)))
                                                     0))
                                              (Ok [stagectx]
                                                  (let [new-quals
                                                          (install-stage-signatures! phasectx
                                                                                     stagectx
                                                                                     (box-al [(slice u8)]
                                                                                             a
                                                                                             (load stage-quals))
                                                                                     (box-al [(slice u8)]
                                                                                             a
                                                                                             (load staged-defs))
                                                                                     a)
                                                        nq
                                                          (len (load new-quals))
                                                        (mut qi) 0]
                                                    (loop (if (>= (load qi) nq)
                                                              (break)
                                                              (do
                                                                (push! (mut stage-quals)
                                                                       (get (load new-quals)
                                                                            (load qi)))
                                                                (set! qi
                                                                      (+ (load qi)
                                                                         1)))))
                                                    0)))
                                            0)))
                                  0)
                                (unless (diag-some? (load errf))
                                  (if (= (len (load stage-quals))
                                         0)
                                      (set! round
                                            (box-al [TaggedForm]
                                                    a
                                                    (load runtime)))
                                      (match (expand-staged-calls a
                                                                  (box-al [TaggedForm]
                                                                          a
                                                                          (load runtime))
                                                                  phasectx
                                                                  (box-al [(slice u8)]
                                                                          a
                                                                          (load stage-quals))
                                                                  (box-al [(slice u8)]
                                                                          a
                                                                          (load stage-markers))
                                                                  impb
                                                                  expb)
                                        (Err [d] (set! errf (Some d)))
                                        (Ok [expanded] (set! round expanded)))))
                                0)))
                      (unless (diag-some? (load errf))
                        (if (forms-equal (load cur) (load round))
                            (set! done true)
                            ;; A round that declared a stage may legitimately need
                            ;; further rounds (macro-defining-macros consume one
                            ;; round per dependency layer); those count against a
                            ;; wider cap than plain transform non-convergence.
                            (if (and (>= (load iters) 16)
                                     (not (load stage-progress)))
                                (set! errf
                                      (Some (derr "before-expand transform: did not reach a fixpoint after 16 rounds")))
                                (if (>= (load iters) 64)
                                    (set! errf
                                          (Some (derr "before-expand staging: did not reach a fixpoint after 64 rounds")))
                                    (do
                                      (set! cur (load round))
                                      ;; Staged results may add defns; the hygiene
                                      ;; name index must see them.
                                      (let [fresh (all-defn-names (load cur) a)]
                                        (set! (.items allfns) (.items fresh)))
                                      (set! iters
                                            (primitive/iadd (load iters) 1))
                                      0)))))
                      0)))))
    (match (load errf)
      (Some [d] (Err [(ptr (ArrayList TaggedForm)) Diag] d))
      (None []
            ; The before-expand registry also runs here, at the end of the transform
            ; fixpoint loop, and again from run-pipeline over the same forms. Only the
            ; pipeline call is shown the declarations; showing them here too is what
            ; made every import-syntax finding appear twice.
            (match (run-checkers checkers
                                 checked
                                 (load cur)
                                 allfns
                                 gs
                                 gu
                                 impb
                                 expb
                                 false
                                 a
                                 (load (field s code_session_state)) (field s expansions))
              (Some [d] (Err [(ptr (ArrayList TaggedForm)) Diag] d))
              (None []
                    (if (> (diag-errs) 0)
                        (Err [(ptr (ArrayList TaggedForm)) Diag]
                             (derr "compilation failed: checker reported error(s) above"))
                        (Ok [(ptr (ArrayList TaggedForm)) Diag] (load cur)))))))))

;;; A before-expand transform returns the authoritative module form list and may
;;; add or remove imports/exports. The loader indexed the pre-transform program,
;;; so rebuild those declaration tables before ordinary expansion/resolution.
;;; Imported source files are already memoized; process-import repeats only the
;;; importer-specific alias/:use/:reexport bookkeeping.
;;; Process the top-level declaration F, an `export` or an `import` as HEAD says,
;;; when it is one. A top-level `(do …)` is spliced into the forms around it, so the
;;; declarations inside one -- a macro that emits a definition and its export
;;; together -- are top-level too.
(defn rebuild-top-level! [(s (mut LS)) (f (ptr Sexp)) (cur (Option (slice u8))) (head (slice u8))] (-> i64)
  (match (l-list-head f)
    (Some [h]
          (cond (= h head)
                  (if (= head "export")
                      (handle-export (mut s) f cur)
                      (process-import (mut s) f "" cur))
                (do-bundle? f)
                  (let [items (l-as-list f)]
                    (for [k 1 (len (load items))]
                      (rebuild-top-level! (mut s) (elem items k) cur head)
                      0)
                    0)
                :else 0))
    (None [] 0))
  0)

(defn rebuild-transformed-declarations! [(s (mut LS))
                                         (forms (ptr (ArrayList TaggedForm)))] (-> i64)
  (let [a (.a s)
        n (len (load forms))
        (mut i) 0]
    (set! (.imports s)
          (if (= (primitive/cast i64 (.parent s)) 0)
              (ArrayList::new [ImpEntry] a)
              (ls-copy-imports a (.imports (.parent s)))))
    (set! (.exports s)
          (if (= (primitive/cast i64 (.parent s)) 0)
              (ArrayList::new [ExpEntry] a)
              (ls-copy-exports a (.exports (.parent s)))))
    ;; Establish every module and its direct exports before resolving imports.
    ;; The flattened form order is not a dependency order, and `:reexport`
    ;; needs the imported module's export table even when that module appears
    ;; later in the stream.
    (loop (if (or (>= (load i) n) (ls-err? (mut s)))
              (break)
              (let [tf (elem forms (load i))
                    f (field tf form)
                    cur (.module tf)]
                (match cur (Some [m] (do (imp-entry (mut s) m) 0)) (None [] 0))
                (rebuild-top-level! (mut s) f cur "export")
                (set! i (primitive/iadd (load i) 1)))))
    (set! i 0)
    (let [loaded-before (len (.out s))]
      (loop (if (or (>= (load i) n) (ls-err? (mut s)))
                (break)
                (let [tf (elem forms (load i))
                      f (field tf form)
                      cur (.module tf)]
                  (rebuild-top-level! (mut s) f cur "import")
                  (set! i (primitive/iadd (load i) 1)))))
      ; An import the transform added may name a module nothing had loaded:
      ; process-import reads it, and its forms join the program here.
      (for [k loaded-before (len (.out s))]
        (push! [TaggedForm] forms (get (.out s) k))
        0))
    ; Phase-boundary definition contexts are not authored target forms, so the
    ; declaration rebuild cannot rediscover them. Restore their import tables
    ; without adding provider code to the target transform graph.
    (for [j 0 (len (.hygiene_imports s))]
      (let [entry (elem (mut (.hygiene_imports s)) j)]
        (when (= (primitive/cast i64
                                 (imports-find (field s imports) (.name entry)))
                 0)
          (push! (mut (.imports s)) (load entry))
          0))
      0)
    0))

(defn run-after-expand [(transformers (ptr (ArrayList (slice u8))))
                        (checked (ptr Program))
                        (forms (ptr (ArrayList TaggedForm)))
                        (allfns (ptr SBox))
                        (gs (ptr SBoxStruct))
                        (gu (ptr SBoxSum))
                        (impb (ptr (ArrayList ImpEntry)))
                        (expb (ptr (ArrayList ExpEntry)))
                        (s (mut LS))
                        (a (dyn Allocator))] (-> (Result (ptr (ArrayList TaggedForm))
                                                         Diag))
  (if (= (len (load transformers)) 0)
      (do
        (set! (.out s) (load forms))
        (Ok [(ptr (ArrayList TaggedForm)) Diag] forms))
      (match (run-transformers transformers
                               checked
                               forms
                               allfns
                               gs
                               gu
                               impb
                               expb
                               a
                               (load (field s code_session_state)) (field s expansions))
        (Err [d] (Err [(ptr (ArrayList TaggedForm)) Diag] d))
        (Ok [out]
            ; This phase is single-pass: its output becomes the semantic input and
            ; never re-enters macro expansion. Ordinary resolution/typechecking is
            ; therefore the authoritative validation, including for syntax a
            ; transform incorrectly leaves unresolved.
            (do
              (set! (.out s) (load out))
              (rebuild-transformed-declarations! (mut s) out)
              (if (ls-err? (mut s))
                  (Err [(ptr (ArrayList TaggedForm)) Diag] (.loaderr s))
                  (Ok [(ptr (ArrayList TaggedForm)) Diag] out)))))))

; Source transports may locate previously dummy-span generated declarations.
; Named definitions retain module/name identity across that boundary; full syntax
; and lexical identity still decide whether the normalized form can be reused.
(defn binding-source-key [(a (dyn Allocator)) (form (ptr TaggedForm))] (-> (slice u8))
  (sconcat3 a
            (match (.module form) (Some [m] m) (None [] ""))
            ":"
            (match (source-defn-name-of (field form form))
              (Some [name] (sconcat a "definition:" name))
              (None []
                    (sconcat3 a
                              (i64->str a (sx-source (.form form)))
                              ":"
                              (i64->str a (sx-lo (.form form))))))))

(defn source-syntax-equal? [(left (ptr Sexp)) (right (ptr Sexp))] (-> bool)
  (if (not (sexp-eq (load left) (load right)))
      false
      (if (or (!= (sx-hmod (load left)) (sx-hmod (load right)))
              (!= (sx-hyg (load left)) (sx-hyg (load right))))
          false
          (if (or (= (sx-tag (load left)) 6) (= (sx-tag (load left)) 7))
              (let [ls (sx-items (load left))
                    rs (sx-items (load right))
                    (mut equal) true]
                (for [i 0 (sx-len ls)]
                  (unless (source-syntax-equal? (elem ls i)
                                                (elem rs i))
                    (set! equal false)))
                (load equal))
              true))))

(defn reuse-normalized-forms! [(a (dyn Allocator))
                               (forms (ptr (ArrayList TaggedForm)))
                               (authored (ptr (ArrayList TaggedForm)))
                               (normalized (ptr (ArrayList TaggedForm)))] (-> i64)
  ; The tower keeps one slot per original declaration; a generated bundle stays
  ; in that slot. Source origins are not unique (defderive emits several forms
  ; at one location), so keep every candidate rather than overwriting a match.
  (let [(mut original) (HashMap::new [(slice u8) i64] a (keyops))
        (mut previous) (ArrayList::new [i64] a)]
    (for [i 0 (len (load authored))]
      (let [key (binding-source-key a (elem authored i))]
        (push! (mut previous)
               (match (get (load original) key) (Some [j] j) (None [] -1)))
        (set! (mut original) key i)))
    (for [i 0 (len (load forms))]
      (let [form (elem forms i)
            key (binding-source-key a form)
            (mut candidate)
              (match (get (load original) key) (Some [j] j) (None [] -1))]
        (loop (if (< (load candidate) 0)
                  (break)
                  (let [j (load candidate)
                        before (elem authored j)]
                    (if (source-syntax-equal? (field form form)
                                              (field before form))
                        (do (set! form (get (load normalized) j)) (break))
                        (set! candidate (get (load previous) j))))))))
    0))

;;; Does any symbol in NODE name a built-in Code type (`builtin-code-type`)? For a
;;; type form, as in `(Option Code)` or `(mut CodeBuilder)`, that is whether the
;;; type involves Code.
(defn mentions-code-type-name? [(node (ptr Sexp))] (-> bool)
  (cond (= (sx-tag (load node)) 2)
          (some? (builtin-code-type (sx-sval (load node))))
        (or (= (sx-tag (load node)) 6) (= (sx-tag (load node)) 7))
          (block :found
            (let [items (sx-items (load node))]
              (for [k 0 (sx-len items)]
                (when (mentions-code-type-name? (elem items k)) (break :found true))))
            false)
        :else false))

;;; Does a parameter vector or a `(-> T)` return form mention Code in a TYPE?
;;; A parameter is `(name type)` or `(:positional name type)`; its name is not a
;;; type, so a parameter named `Code` mentions nothing.
(defn signature-mentions-code? [(node (ptr Sexp))] (-> bool)
  (let [tg (sx-tag (load node))
        items (sx-items (load node))
        n (if (or (= tg 6) (= tg 7)) (sx-len items) 0)]
    (cond (and (= tg 6) (and (= n 2) (= (sx-head-name items) "->")))
            (mentions-code-type-name? (elem items 1))
          (= tg 7)
            (block :found
              (for [k 0 n]
                (let [p (elem items k)
                      pitems (sx-items (load p))
                      pn (if (= (sx-tag (load p)) 6) (sx-len pitems) 0)
                      ti (if (and (= pn 3)
                                  (and (= (sx-tag (sx-at pitems 0)) 3)
                                       (= (sx-sval (sx-at pitems 0)) "positional")))
                             2
                             1)]
                  (when (and (> pn ti) (mentions-code-type-name? (elem pitems ti)))
                    (break :found true))))
              false)
          :else false)))

(defn transform-introduced-macros? [(forms (ptr (ArrayList TaggedForm)))
                                    (authored (ptr (ArrayList TaggedForm)))
                                    (macros (ptr (ArrayList (slice u8))))
                                    (a (dyn Allocator))] (-> bool)
  (> (len (transform-introduced-macro forms authored macros a)) 0))
;;; The qualified names of top-level functions in FORMS whose signatures
;;; mention Code or CodeBuilder.
(defn code-signature-defns [(forms (ptr (ArrayList TaggedForm))) (a (dyn Allocator))] (-> (ptr (ArrayList (slice u8))))
  (let [(mut out) (ArrayList::new [(slice u8)] a)]
    (for [i 0 (len (load forms))]
      (let [tf (elem forms i)
            f (field tf form)]
        (when (and (= (sx-tag (load f)) 6) (>= (sx-len (sx-items (load f))) 4))
          (let [it (sx-items (load f))]
            (when (and (or (= (sx-head-name it) "defn") (= (sx-head-name it) "defn*"))
                       (= (sx-tag (sx-at it 1)) 2))
              (let [(mut vector) -1]
                (for [k 2 (sx-len it)]
                  (when (and (< (load vector) 0) (= (sx-tag (sx-at it k)) 7)) (set! vector k)))
                ; A generic function's second vector holds its parameters.
                (when (and (>= (load vector) 0)
                           (and (< (+ (load vector) 1) (sx-len it)) (= (sx-tag (sx-at it (+ (load vector) 1))) 7)))
                  (set! vector (+ (load vector) 1)))
                (when (and (>= (load vector) 0) (< (+ (load vector) 1) (sx-len it)))
                  (when (or (signature-mentions-code? (elem it (load vector)))
                            (signature-mentions-code? (elem it (+ (load vector) 1))))
                    (push! (mut out) (qualify-name a (sx-sval (sx-at it 1)) (.module tf))) 0))))))))
    (box-al [(slice u8)] a (load out))))
;;; A compile-time function a before-expand transform added: present in the
;;; transformed forms, absent from the forms the phase tower was built from and
;;; from its macro set. Empty when none.
(defn transform-introduced-macro [(forms (ptr (ArrayList TaggedForm)))
                                  (authored (ptr (ArrayList TaggedForm)))
                                  (macros (ptr (ArrayList (slice u8))))
                                  (a (dyn Allocator))] (-> (slice u8))
  (let [after (code-signature-defns forms a) before (code-signature-defns authored a)]
    (block :found
      (for [i 0 (len (load after))]
        (let [q (get (load after) i)]
          (unless (or (set-contains before q) (macros-has? macros q)) (break :found q))))
      "")))

(defn run-expand [(s (mut LS))
                  (authored (ptr (ArrayList TaggedForm)))
                  (normalized (ptr (ArrayList TaggedForm)))
                  (macros (ptr (ArrayList (slice u8))))
                  (comptime (ptr (ArrayList (slice u8))))
                  (checked (ptr Program))
                  (a (dyn Allocator))] (-> (Result i64 Diag))
  (macros-index-reset!)  ; a new run may not inherit the last one's index
  (derive-reg-reset!)  ; nor the last one's derive registrations
  (let [(mut out-forms) authored
        impb
          (box! a (ArrayList ImpEntry) (primitive/zeroed (ArrayList ImpEntry)))
        expb
          (box! a (ArrayList ExpEntry) (primitive/zeroed (ArrayList ExpEntry)))
        env (primitive/alloc-stack ExpEnv)
        allfns (all-defn-names normalized a)
        _declared (declared-names-set! allfns a)
        _traits (declared-traits-collect! (mut s) normalized)
        gs (box! a SBoxStruct (primitive/zeroed SBoxStruct))
        gu (box! a SBoxSum (primitive/zeroed SBoxSum))
        result (box! a SBoxTF (primitive/zeroed SBoxTF))
        (mut checkers) (ArrayList::new [(slice u8)] a)
        (mut once-transformers) (ArrayList::new [(slice u8)] a)
        (mut transformers) (ArrayList::new [(slice u8)] a)
        (mut pre-checkers) (ArrayList::new [(slice u8)] a)
        (mut pre-transformers) (ArrayList::new [(slice u8)] a)
        (mut post-transformers) (ArrayList::new [(slice u8)] a)
        (mut i) 0
        (mut errf) (None [Diag])
        (mut depthv) 0]
    (set! impb (.imports s))
    (set! expb (.exports s))
    (set-cli-sources (field s sources))  ; expose source names to (primitive/code-file …) in checkers
    (set! (.items gs) (ArrayList::new [StructDef] a))
    (set! (.items gu) (ArrayList::new [SumDef] a))
    (set! (.items result) (ArrayList::new [TaggedForm] a))
    (set! (.macros env) macros)
    (set! (.comptime env) comptime)
    (set! (.sub env) checked)
    (set! (.impb env) impb)
    (set! (.expb env) expb)
    (set! (.bound env)
          (box! a (ArrayList (slice u8)) (ArrayList::new [(slice u8)] a)))
    (set! (.a env) a)
    ; Keep pipeline declarations as session metadata. Only new source forms
    ; enter expansion; accepted checker/transform registrations remain in scope.
    ; A loader can enter expansion again after meta output is spliced. Its
    ; registrations have already been consumed from source at that point.
    ; Seed an empty candidate from its parent once, then retain declarations
    ; across expansion waves. Form identity prevents duplicate registration.
    (when (and (= (len (.pipeline_forms s)) 0)
               (!= (primitive/cast i64 (.parent s)) 0))
      (set! (.pipeline_forms s)
            (ls-copy-list [TaggedForm] a (.pipeline_forms (.parent s))))
      0)
    (for [ri 0 (len (load authored))]
      (let [tf (elem authored ri)]
        (when (and (or (is-register-derive-form (field tf form))
                       (or (is-checker-form (field tf form)) (is-transform-form (field tf form))))
                   (let [scope (.registration_scope s)]
                     (or (= (cast i64 scope) 0)
                         (match (.module tf)
                           (Some [m] (set-contains scope m))
                           (None [] false)))))
          (let [(mut found) false]
            (for [pi 0 (len (.pipeline_forms s))]
              (when (= (.form_id (elem (field s pipeline_forms) pi))
                       (.form_id tf))
                (set! found true)
                0))
            (unless (load found)
              (push! (mut (.pipeline_forms s)) (load tf))
              0))
          0)))
    ; Registrations are declarations of the compilation pipeline, so discover them
    ; from the loaded source before running any of it. A macro/transform cannot
    ; retroactively generate a before-expand registration.
    (loop (if (or (diag-some? (load errf))
                  (>= (load i) (len (.pipeline_forms s))))
              (break)
              (do
                (let [tf (primitive/alloc-stack TaggedForm)]
                  (set! tf (get (.pipeline_forms s) (load i)))
                  (let [module (.module tf)]
                    (cond (is-register-derive-form (field tf form))
                            (match (register-derive-form! (field tf form)
                                                          module
                                                          macros
                                                          impb
                                                          expb
                                                          a)
                              (Some [d] (store! errf (Some d)))
                              (None [] 0))
                          (or (is-checker-form (field tf form)) (is-transform-form (field tf form)))
                            (let [checker? (is-checker-form (field tf form))
                                  once? (is-transform-once-form (field tf form))
                                  name (sx-sval (sx-at (sx-items (load (field tf form))) 1))]
                              (match (registration-phase (field tf form) module impb expb a)
                                (Err [d] (store! errf (Some d)))
                                (Ok [p]
                                    (cond
                                      ; a reader is the read provider, not part of the pipeline
                                      (match p (Some [(phase/Read)] true) (_ false))
                                        (when checker?
                                          (store! errf (Some (derr "checker: a checker runs on a program, not as a reader: (phase/Read) is a transform's"))))
                                      (and once? (match p (Some [_] true) (None [] false)))
                                        (store! errf (Some (derr "transform-once: expected `(transform-once FN)`")))
                                      (and checker? (match p (Some [(phase/BeforeExpand)] false) (Some [_] true) (None [] false)))
                                        (store! errf (Some (derr "checker: a checker's :phase is (phase/BeforeExpand), or none")))
                                      :else
                                        (match (resolve-macro name module macros impb expb a)
                                          (Some [q]
                                                ; nothing names a registered function; the
                                                ; registration is its module's use of it
                                                (match module
                                                  (Some [m] (module-use-record! m q))
                                                  (None [] 0))
                                                (cond checker?
                                                        (match p
                                                          (Some [_] (push! (mut pre-checkers) q))
                                                          (None [] (push! (mut checkers) q)))
                                                      once? (push! (mut once-transformers) q)
                                                      :else
                                                        (match p
                                                          (Some [(phase/BeforeExpand)] (push! (mut pre-transformers) q))
                                                          (Some [(phase/AfterExpand)] (push! (mut post-transformers) q))
                                                          (_ (push! (mut transformers) q)))))
                                          (None []
                                                (store! errf
                                                        (Some (derr (if checker?
                                                                        "checker: FN must be a [(prog Code)] -> Code function in scope"
                                                                        "transform: FN must be a [(prog Code)] -> Code function in scope"))))))))))
                          :else 0)))
                (set! i (primitive/iadd (load i) 1)))))
    (match (load errf)
      (Some [d] (Err [i64 Diag] d))
      (None []
            (match (run-before-expand (box-al [(slice u8)]
                                              a
                                              (load pre-transformers))
                                      (box-al [(slice u8)]
                                              a
                                              (load pre-checkers))
                                      checked
                                      (load out-forms)
                                      allfns
                                      gs
                                      gu
                                      impb
                                      expb
                                      (mut s)
                                      a)
              (Err [d] (do (drain-warnings (mut s)) (Err [i64 Diag] d)))
              (Ok [raw]
                  (if (transform-introduced-macros? raw authored macros a)
                    ; A before-expand transform defined compile-time functions the
                    ; engine was built without. Rebuild the phase tower over the
                    ; transformed program; its transforms then reach their fixpoint.
                    (do (set! (.out s) (load raw))
                        (set! (last-introduced-macro) (sconcat a (transform-introduced-macro raw authored macros a) ""))
                        (Ok [i64 Diag] 2))
                  (block :restart
                  (let [authored-count (len (load raw))]
                    ; Before-expand sees authored syntax. Reuse checked tower forms
                    ; only where that phase left the original form unchanged.
                    (reuse-normalized-forms! a raw authored normalized)
                    (set! out-forms raw)
                    (rebuild-transformed-declarations! (mut s) raw)
                    ; An import the transform added that does not load is the
                    ; error, not the undefined names that follow from it.
                    (when (ls-err? (mut s))
                      (return-from :restart (Err [i64 Diag] (.loaderr s))))
                    ; An import the transform added loaded a module nothing had
                    ; loaded, and its forms joined the program after the tower was
                    ; built: its compile-time definitions were never compiled and
                    ; its (meta …) forms never ran. Rebuild the tower over the
                    ; program that now holds it, as for a transform that
                    ; introduced macros; the module is loaded from then on, so
                    ; the next generation's rebuild adds nothing.
                    (when (> (len (load raw)) authored-count)
                      (set! (.out s) (load raw))
                      (set! (last-introduced-macro)
                            (sconcat a "an import of "
                                     (match (.module (get (load raw) authored-count))
                                       (Some [m] m)
                                       (None [] "a module"))))
                      (return-from :restart (Ok [i64 Diag] 2)))
                    (set! impb (.imports s))
                    (set! expb (.exports s))
                    ; A syntax transform may add/remove definitions; refresh the name
                    ; set used for hygiene before expanding its result.
                    (let [fresh (all-defn-names raw a)]
                      (set! (.items allfns) (.items fresh)))
                    (declared-traits-collect! (mut s) raw)
                    (macro-aliases-collect! (mut s) raw)
                    (set! i 0)
                    (loop (if (or (diag-some? (load errf))
                                  (>= (load i) (len (load raw))))
                              (break)
                              (do
                                (let [tf (primitive/alloc-stack TaggedForm)]
                                  (set! tf (get (load raw) (load i)))
                                  (let [module (.module tf)]
                                    ; Registration forms configure the compiler and
                                    ; are never part of the runtime program.
                                    (if (or (is-checker-form (field tf form))
                                            (or (is-transform-form (field tf
                                                                          form))
                                                (is-register-derive-form (field tf
                                                                                form))))
                                        0
                                        (let [form-work
                                                (primitive/alloc-stack scratch/ScratchArena)
                                              _form-init
                                                (scratch/ScratchArena::init-with-capacity form-work
                                                                                          (retained-heap/compiler-scratch-parent)
                                                                                          262144)
                                              form-a
                                                (allocator form-work)
                                              form-env
                                                (primitive/alloc-stack ExpEnv)]
                                          (store! form-env (load env))
                                          (store! (field form-env a) form-a)
                                          (match (expand-top-form (field tf
                                                                         form)
                                                                  module
                                                                  form-env
                                                                  (field allfns
                                                                         items)
                                                                  (field gs
                                                                         items)
                                                                  (field gu
                                                                         items)
                                                                  (mut depthv)
                                                                  (mut s))
                                            (Err [d]
                                                 (let [dp
                                                         (primitive/alloc-stack Diag)]
                                                   (store! dp d)
                                                   (store! (field dp msg)
                                                           (sexp-own-str-into a
                                                                              (load (field dp
                                                                                           msg))))
                                                   (close! form-work)
                                                   (store! errf
                                                           (Some (load dp)))
                                                   0))
                                            (Ok [outf]
                                                (let [sp
                                                        (primitive/alloc-stack Sexp)]
                                                  (store! sp outf)
                                                  (let [owned
                                                          (sexp-own-into a sp)]
                                                    (close! form-work)
                                                    (do-produced (box-sexp a
                                                                           owned)
                                                                 module
                                                                 tf
                                                                 result
                                                                 gs
                                                                 gu
                                                                 allfns
                                                                 a
                                                                 (mut errf))))))))))
                                (set! i (primitive/iadd (load i) 1)))))
                    ; Every trait the expansion generates is declared by now.
                    (match (match (load errf)
                             (Some [d] (Some d))
                             (None [] (derive-reg-finish! impb expb a)))
                      (Some [d] (Err [i64 Diag] d))
                      (None []
                            (match (run-after-expand (box-al [(slice u8)]
                                                             a
                                                             (load post-transformers))
                                                     checked
                                                     (box-al [TaggedForm]
                                                             a
                                                             (.items result))
                                                     allfns
                                                     gs
                                                     gu
                                                     impb
                                                     expb
                                                     (mut s)
                                                     a)
                              (Err [d] (Err [i64 Diag] d))
                              (Ok [post]
                                  (do
                                    ; Post-expansion output is authoritative for
                                    ; semantic resolution and for later checkers.
                                    (let [fresh (all-defn-names post a)]
                                      (set! (.items allfns) (.items fresh)))
                                    (set! impb (.imports s))
                                    (set! expb (.exports s))
                                    (register-checkers (box-al [(slice u8)]
                                                               a
                                                               (load pre-checkers))
                                                       (box-al [(slice u8)]
                                                               a
                                                               (load checkers))
                                                       (box-al [(slice u8)]
                                                               a
                                                               (load once-transformers))
                                                       (box-al [(slice u8)]
                                                               a
                                                               (load transformers))
                                                       checked
                                                       allfns
                                                       gs
                                                       gu)
                                    (set! (.posttx (.reg (checker-reg-box)))
                                          (box-al [(slice u8)] a (load post-transformers)))
                                    (set! (.macros (.reg (checker-reg-box)))
                                          (persist-names macros a))
                                    (set! (.comptime (.reg (checker-reg-box)))
                                          (persist-names comptime a))
                                    (set! (.expanded (.reg (checker-reg-box)))
                                          (ls-copy-list [TaggedForm] a (load post)))
                                    (Ok [i64 Diag] 0)))))))))))))))

(defn do-produced [(outf (ptr Sexp))
                   (module (Option (slice u8)))
                   (origin (ptr TaggedForm))
                   (result (ptr SBoxTF))
                   (gs (ptr SBoxStruct))
                   (gu (ptr SBoxSum))
                   (allfns (ptr SBox))
                   (a (dyn Allocator))
                   (errf (mut (Option Diag)))] (-> i64)
  (let [(mut produced) (ArrayList::new [Sexp] a)]
    (splice-do-into! (mut produced) outf)
    (let [np (len (load produced))
          (mut j) 0]
      (loop (if (or (diag-some? (load errf)) (>= (load j) np))
                (break)
                (do
                  (let [form (elem produced (load j))]
                    (match (register-generated-decl form module gs gu a)
                      (Some [d] (do (set! errf (Some d)) 0))
                      (None []
                            (do
                              (match (defn-name-of form)
                                (Some [nm]
                                      (push! (mut (.items allfns))
                                             (qualify-name a nm module)))
                                (None [] 0))
                              (let [tf (primitive/alloc-stack TaggedForm)]
                                (set! tf (mk-tagged (load form) module))
                                (when (and (= np 1)
                                           (!= (primitive/cast i64 origin)
                                               0))
                                  (store! (field tf form_id)
                                          (load (field origin form_id)))
                                  (store! (field tf revision)
                                          (primitive/iadd (load (field origin
                                                                       revision))
                                                          (if (expansion-form-equal? (load form)
                                                                                     (load (field origin
                                                                                                  form)))
                                                              0
                                                              1)))
                                  (store! (field tf cached_shape)
                                          (if (expansion-form-equal? (load form)
                                                                     (load (field origin
                                                                                  form)))
                                              (load (field origin cached_shape))
                                              0))
                                  0)
                                (push! (mut (.items result)) (load tf))
                                0)))))
                  (set! j (primitive/iadd (load j) 1)))))))
  0)

(defn d-expanded [(w (ptr Writer)) (a (dyn Allocator)) (s (mut LS))] (-> i64)
  (ps w "(forms")
  (let [n (len (.out s))
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (ps w " (tf ")
                (let [tf (primitive/alloc-stack TaggedForm)]
                  (set! tf (get (.out s) (load i)))
                  (d-opt-str w (.module tf))
                  (wb w 32)
                  (let [fp (primitive/alloc-stack Sexp)]
                    (set! fp (.form tf))
                    (sx-node w fp)))
                (wb w 41)
                (set! i (primitive/iadd (load i) 1))))))
  (wb w 41)
  0)

(defn d-hygiene [(w (ptr Writer)) (s (mut LS))] (-> i64)
  (ps w "(forms")
  (let [n (len (.out s))
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (ps w " (tf ")
                (let [tf (elem (field s out) (load i))]
                  (d-opt-str w (.module tf))
                  (wb w 32)
                  (sx-hnode w (field tf form)))
                (wb w 41)
                (set! i (primitive/iadd (load i) 1))))))
  (wb w 41)
  0)

(defn dump-hygiene-program [(a (dyn Allocator))
                            (src (slice u8))
                            (cwd (slice u8))] (-> i64)
  (let [bout (primitive/alloc-stack BufferedOutput)
        w (BufferedOutput::init bout (stdout))
        s (primitive/alloc-stack LS)
        (mut rc) 0]
    (ls-init! (mut s) a)
    (set! (.srccount s) 1)
    (register-source! (mut s) "<source>" src)
    (match (read-all a src 0)
      (Err [d]
           (let [dp (primitive/alloc-stack Diag)]
             (set! dp d)
             (dump-error w dp)
             (set! rc 1)))
      (Ok [forms]
          (do
            (namespace-index-build! (mut s))
            (load-program (mut s) forms cwd)
            (if (ls-err? (mut s))
                (let [dp (primitive/alloc-stack Diag)]
                  (set! dp (.loaderr s))
                  (dump-error w dp)
                  (set! rc 1))
                (match (expand-stage3 (mut s))
                  (Err [d]
                       (let [dp (primitive/alloc-stack Diag)]
                         (set! dp d)
                         (dump-error w dp)
                         (set! rc 1)))
                  (Ok [_]
                      (do
                        ; Include transform-produced syntax in the audit view.
                        (match (run-transforms-and-check a (mut s))
                          (Err [d]
                               (let [dp (primitive/alloc-stack Diag)]
                                 (set! dp d)
                                 (dump-error w dp)
                                 (set! rc 1)))
                          (Ok [_] (d-hygiene w (mut s)))))))))))
    (flush bout)
    (load rc)))

(defn dump-expand-program [(a (dyn Allocator))
                           (src (slice u8))
                           (cwd (slice u8))] (-> i64)
  (let [bout (primitive/alloc-stack BufferedOutput)
        w (BufferedOutput::init bout (stdout))
        s (primitive/alloc-stack LS)]
    (ls-init! (mut s) a)
    (set! (.srccount s) 1)
    (register-source! (mut s) "<source>" src)
    (match (read-all a src 0)
      (Err [d]
           (let [dp (primitive/alloc-stack Diag)] (set! dp d) (dump-error w dp)))
      (Ok [forms]
          (do
            ; the project/dependency namespace index, exactly as the driver's pipeline
            ; entries build it — without this an import of a project namespace resolves
            ; under `check`/`build` but not under `expand`.
            (namespace-index-build! (mut s))
            (load-program (mut s) forms cwd)
            (match (expand-stage3 (mut s))
              (Err [d]
                   (let [dp (primitive/alloc-stack Diag)]
                     (set! dp d)
                     (dump-error w dp)))
              (Ok [_] (d-expanded w a (mut s)))))))
    (flush bout))
  0)

; ── `coil expand FILE` — the program AS SOURCE after macros AND transforms ────
; Reprints the user file's top-level forms once every macro has expanded and every
; registered transform has rewritten the program (the state a checker/mono sees),
; so a metaprogram's effect is directly readable. An Sexp → source pretty-printer.
(defn sx-atom-text [(w (ptr Writer)) (a (dyn Allocator)) (x Sexp)] (-> i64)
  (let [tg (sx-tag x)]
    (cond (= tg 0) (ps w (i64->str a (sx-ival x)))
          (= tg 2) (ps w (sx-sval x))
          (= tg 3) (do (wb w 58) (ps w (sx-sval x)) 0)
          (= tg 4)
            (do (wb w 34) (ps w (sx-sval x)) (wb w 34) 0)
          (= tg 5)
            (do (wb w 99) (wb w 34) (ps w (sx-sval x)) (wb w 34) 0)
          :else (do (ps w "<") (ps w (i64->str a tg)) (ps w ">") 0))))

; rendered inline width of a node — used to decide whether to break a list
(defn sx-width [(a (dyn Allocator)) (x Sexp)] (-> i64)
  (let [tg (sx-tag x)]
    (cond (= tg 0) (len (i64->str a (sx-ival x)))
          (= tg 2) (len (sx-sval x))
          (= tg 3) (primitive/iadd 1 (len (sx-sval x)))
          (= tg 4) (primitive/iadd 2 (len (sx-sval x)))
          (= tg 5) (primitive/iadd 3 (len (sx-sval x)))
          (or (= tg 6) (= tg 7))
            (let [items (sx-items x)
                  n (sx-len items)
                  (mut wsum) 2
                  (mut i) 0]
              (loop (if (>= (load i) n)
                        (break)
                        (do
                          (store! wsum
                                  (primitive/iadd (primitive/iadd (load wsum)
                                                                  (when (> (load i)
                                                                           0)
                                                                    1))
                                                  (sx-width a
                                                            (sx-at items
                                                                   (load i)))))
                          (store! i (primitive/iadd (load i) 1)))))
              (load wsum))
          :else 3)))

(defn sx-emit [(w (ptr Writer)) (a (dyn Allocator)) (x Sexp) (col i64)] (-> i64)
  (let [tg (sx-tag x)]
    (if (not (or (= tg 6) (= tg 7)))
        (sx-atom-text w a x)
        (let [items (sx-items x)
              n (sx-len items)
              open (if (= tg 7) 91 40)
              close (if (= tg 7) 93 41)]
          (if (= n 0)
              (do (wb w open) (wb w close) 0)
              ; inline if it fits within the line budget from the current column
              (if (<= (primitive/iadd col (sx-width a x))
                      92)
                  (do
                    (wb w open)
                    (let [(mut i) 0]
                      (loop (if (>= (load i) n)
                                (break)
                                (do
                                  (when (> (load i) 0)
                                    (wb w 32))
                                  (sx-emit w a (sx-at items (load i)) 0)
                                  (set! i (primitive/iadd (load i) 1))))))
                    (wb w close)
                    0)
                  (do
                    (wb w open)
                    (sx-emit w a (sx-at items 0) (primitive/iadd col 1))
                    (let [(mut i) 1]
                      (loop (if (>= (load i) n)
                                (break)
                                (do
                                  (wb w 10)
                                  (let [(mut j) 0]
                                    (loop (if (>= (load j)
                                                  (primitive/iadd col 2))
                                              (break)
                                              (do
                                                (wb w 32)
                                                (set! j
                                                      (primitive/iadd (load j)
                                                                      1))))))
                                  (sx-emit w
                                           a
                                           (sx-at items (load i))
                                           (primitive/iadd col 2))
                                  (set! i (primitive/iadd (load i) 1))))))
                    (wb w close)
                    0)))))))

(defn expand-src-program [(a (dyn Allocator))
                          (src (slice u8))
                          (cwd (slice u8))
                          (path (slice u8))] (-> i64)
  (let [w (stdout)
        s (primitive/alloc-stack LS)]
    (ls-init! (mut s) a)
    (set! (.srccount s) 1)
    (register-source! (mut s) path src)  ; real path -> code-from-user? true
    ; A macro/expansion failure is a real error: route it through the SAME located
    ; diagnostic printer build/run use (report-diag, on stderr) and exit non-zero.
    ; Nothing goes to stdout on failure — `coil expand` is a debugger, not a liar.
    (match (read-all a src 0)
      (Err [d] (do (report-diag (stderr) (mut s) d) 1))
      (Ok [forms]
          (do
            (namespace-index-build! (mut s))
            (load-program (mut s) forms cwd)
            (if (ls-err? (mut s))
                (do (report-diag (stderr) (mut s) (.loaderr s)) 1)
                (match (expand-stage3 (mut s))
                  (Err [d] (do (report-diag (stderr) (mut s) d) 1))
                  (Ok [_]
                      ; run the transform fixpoint (mutates s.out to the rewritten program);
                      ; print regardless of whether the final strict check passes.
                      (do
                        (match (run-transforms-and-check a (mut s))
                          (Err [d] 0)
                          (Ok [_] 0))
                        (let [out (field s out)
                              n (len (load out))
                              (mut i) 0]
                          (loop (if (>= (load i) n)
                                    (break)
                                    (do
                                      (let [tf
                                              (elem out
                                                    (load i))
                                            fp (field tf form)]
                                        ; the file's OWN top-level forms are source 0
                                        (when (= (sx-source (load fp))
                                                 0)
                                          (sx-emit w a (load fp) 0)
                                          (wb w 10)
                                          (wb w 10)
                                          0))
                                      (set! i (primitive/iadd (load i) 1)))))
                          0))))))))))

;;; The successful tower arena is already owned by the compilation unit. Keep
;;; its checked compiler ABI and canonical maps for subsequent JIT submissions.
(defn retain-meta-environment! [(a (dyn Allocator))
                                (s (mut LS))
                                (checked-state (mut LS))
                                (checked (ptr Program))
                                (resolved-state (mut LS))] (-> i64)
  (let [saved (box! a LS (load s))
        maps (box! a SemMapsSnap (primitive/zeroed SemMapsSnap))
        workspace
          (box! a
                SemanticWorkspace
                (load (semantic-workspace (mut resolved-state))))]
    (set! (.semantic_workspace saved)
          (box! a
                SemanticWorkspaceSlot
                (SemanticWorkspaceSlot :value
                                         (primitive/cast (ptr i8) workspace)
                  :owner a)))
    ; Borrowed, as everywhere this table is made: each key is the name held by the
    ; function record it indexes, which is how a snapshot finds the key's bytes.
    (set! (.checked_functions saved) (HashMap::new [(slice u8) i64] a (keyops-borrowed)))
    (ls-accept-checked! (mut saved) checked)
    (set! (.checker_context saved) (.checker_context checked-state))
    (sem-maps-save maps)
    (set! (.semantic_maps saved) (primitive/cast (ptr i8) maps))
    (set! (.meta_environment saved) (primitive/cast (ptr LS) 0))
    (set! (.meta_environment s) saved)
    0))

;;; P for a metaprogram's closure: each array length that names one of its
;;; constants replaced by the value, as the checker does, so a closure cut from
;;; P keeps a struct such as `(array u8 MAX-LEN)` without the constant. A
;;; constant whose value needs code run is not computed here; the types that
;;; wait on one, and the constants that would need such a type, are left out,
;;; as are those that read a name a pending generator may declare
;;; (`without-undeclared-value-dependents`).
(defn with-constant-lengths [(a (dyn Allocator)) (p (ptr Program))] (-> (ptr Program))
  (constant-lengths-for-closure a (without-undeclared-value-dependents a p)))

;;; Normalize the arm once, then let expand-match-form establish its binders
;;; before traversing the returned body. Expanding the whole result as an ordinary
;;; call would expand a shadowed macro before the arm's lexical scope exists.
(defn normalize-match-arm-once [(arm (ptr Sexp))
                                (env (ptr ExpEnv))
                                (allfns (ptr (ArrayList (slice u8))))
                                (gs (ptr (ArrayList StructDef)))
                                (gu (ptr (ArrayList SumDef)))
                                (depth (ptr i64))
                                (ls (mut LS))] (-> (Result Sexp Diag))
  (normalize-with-binding-macro "coil.binding.normalize-match-arm" arm env allfns gs gu depth (mut ls)))

;;; A literal pattern: an integer, float, string, `true`, `false`, or a `#\c`
;;; character, which the reader leaves as a symbol.
(defn match-literal-pattern? [(p Sexp)] (-> bool)
  (let [tag (sx-tag p)]
    (cond (or (= tag 0)
              (or (= tag 1) (= tag 4)))
            true
          (= tag 2)
            (let [name (sx-sval p)]
              (or (= name "true")
                  (or (= name "false")
                      (and (>= (len name) 3)
                           (and (= (primitive/cast i64 (get name 0)) 35)
                                (= (primitive/cast i64 (get name 1)) 92))))))
          :else false)))

;;; Can this payload pattern fail to match: a literal or a variant pattern,
;;; `(V [patterns…])` or `(V)`, at any depth?
(defn match-refutable-pattern? [(p Sexp)] (-> bool)
  (let [tag (sx-tag p)]
    (cond (match-literal-pattern? p) true
          (= tag 6)
            (let [items (sx-items p)
                  n (sx-len items)]
              (if (and (>= n 1)
                       (and (= (sx-tag (sx-at items 0)) 2)
                            (or (= n 1)
                                (and (= n 2)
                                     (= (sx-tag (sx-at items 1)) 7)))))
                  true
                  (let [(mut found) false]
                    (for [i 1 n]
                      (when (match-refutable-pattern? (sx-at items i))
                        (set! found true)
                        0))
                    found)))
          (= tag 7)
            (let [items (sx-items p)
                  (mut found) false]
              (for [i 0 (sx-len items)]
                (when (match-refutable-pattern? (sx-at items i))
                  (set! found true)
                  0))
              found)
          :else false)))

;;; Does any arm of this `(match value arm…)` refute: a literal arm, `(0 …)`, or
;;; a refutable payload pattern, `(V [(W [x])] …)`, `(V [1] …)`? Such a match is
;;; lowered as a whole first, by `lower-refutable-match`.
(defn match-has-refutable-arm? [(items (ptr (ArrayList Sexp)))] (-> bool)
  (let [(mut found) false]
    (for [i 2 (sx-len items)]
      (let [arm (sx-at items i)]
        (when (= (sx-tag arm) 6)
          (let [arm-items (sx-items arm)]
            (when (>= (sx-len arm-items) 1)
              (when (match-literal-pattern? (sx-at arm-items 0))
                (set! found true)
                0)
              (when (and (>= (sx-len arm-items) 2)
                         (= (sx-tag (sx-at arm-items 1)) 7))
                (let [pats (sx-items (sx-at arm-items 1))]
                  (for [j 0 (sx-len pats)]
                    (when (match-refutable-pattern? (sx-at pats j))
                      (set! found true)
                      0))))
              0)))
        0))
    found))

; ---- refutable match arms ------------------------------------------------------
; A match with a refutable arm is lowered here, before its arms are expanded, to
; ordinary single-level matches. This is the compiler's own work rather than a
; library macro so that a program pays for it only where it matches refutably:
; library macro code is expanded by every compilation that loads it.
;
; The arms form a pattern matrix, one row per arm, compiled to a decision tree
; (Maranget, "Compiling pattern matching to good decision trees"): each node
; tests one position, by a `match` on its variant or a chain of `=` tests on its
; literals, and every row survives into the branches it can still match. A branch
; exists for each variant some row names, and a catch-all holds the rows that
; accept any value there. When no row accepts any value and the named variants
; are not the whole sum, the generated `match` misses one and the checker's
; ordinary exhaustiveness check reports it, with the types it alone knows; when
; they are the whole sum, the checker drops the catch-all (see
; `primitive/pattern-default`). Literals never cover their type, so a literal
; position with no row that accepts any value is reported here.
;
; Names bind as in a plain arm, where a payload of a named value is a reference
; to it rather than a copy. A name is the binder of its field in the generated
; `match` when everything below that branch belongs to its own arm; otherwise its
; leaf matches the field's parent again, binding the name there.
;
; A row that reaches no leaf can never match, which is an error. A row reached by
; one leaf has its body placed there. A row reached by several (a `(_ …)` arm
; below refutable ones, say) keeps a single copy of its body: those leaves break
; out with the row's number, and the body runs after the tree, binding its names
; from the scrutinee again.
;
; Every symbol the lowering writes comes from `coil.binding.match-vocabulary`, a
; template, so it has a template's scope: `=` and `primitive/pattern-fail` mean
; what they mean in coil.binding, whatever the matching module imports.

;;; A name bound at a leaf: `pattern` matches `value`, which is field `field` of
;;; `variant`'s `arity` fields in `parent`.
(defstruct MatchBind
  [(pattern Sexp) (value Sexp) (parent Sexp) (variant Sexp) (field i64) (arity i64)])

(defstruct MatchTest [(value Sexp) (pattern Sexp)])

;;; One arm in the matrix: the tests still to make and the names to bind.
(defstruct MatchRow
  [(idx i64) (tests (ptr (ArrayList MatchTest))) (binds (ptr (ArrayList MatchBind)))])

(defsum MatchNode
  (MatchLeaf [(idx i64) (binds (ptr (ArrayList MatchBind)))])
  ; `rest` is the catch-all for variants no row names, when some row accepts any.
  (MatchVariants [(value Sexp)
                  (arms (ptr (ArrayList MatchBranch)))
                  (rest (Option (ptr MatchNode)))])
  ; `rest` is absent only when `true` and `false` are both keys.
  (MatchLiterals [(value Sexp)
                  (keys (ptr (ArrayList Sexp)))
                  (subs (ptr (ArrayList (ptr MatchNode))))
                  (rest (Option (ptr MatchNode)))]))

(defstruct MatchBranch [(variant Sexp) (temps (ptr (ArrayList Sexp))) (sub (ptr MatchNode))])

(defstruct MatchCx
  [(a (dyn Allocator))
   (form Sexp)
   (vocab (ptr (ArrayList Sexp)))
   (env (ptr ExpEnv))
   (allfns (ptr (ArrayList (slice u8))))
   (gs (ptr (ArrayList StructDef)))
   (gu (ptr (ArrayList SumDef)))
   (depth (ptr i64))])

; Indices into the vocabulary, in coil.binding.match-vocabulary's order.
(defn mv-match [] (-> i64) 0)
(defn mv-let [] (-> i64) 1)
(defn mv-if [] (-> i64) 2)
(defn mv-do [] (-> i64) 3)
(defn mv-block [] (-> i64) 4)
(defn mv-break [] (-> i64) 5)
(defn mv-eq [] (-> i64) 6)
(defn mv-wild [] (-> i64) 7)
(defn mv-fail [] (-> i64) 8)
(defn mv-default [] (-> i64) 9)

(defn mcx-word [(cx (ptr MatchCx)) (i i64)] (-> Sexp)
  (sx-at (.vocab cx) i))

(defn mcx-err [(cx (ptr MatchCx)) (msg (slice u8))] (-> Diag)
  (stamp-call-site (derr msg) (.form cx)))

(defn rm-list [(a (dyn Allocator)) (items (ArrayList Sexp))] (-> Sexp)
  (sx-mklist (box-al [Sexp] a items)))

(defn rm-vec [(a (dyn Allocator)) (items (ArrayList Sexp))] (-> Sexp)
  (mk-sexp (KVec (box-al [Sexp] a items)) -1 -1))

(defn rm-list2 [(a (dyn Allocator)) (x Sexp) (y Sexp)] (-> Sexp)
  (let [(mut xs) (ArrayList::new [Sexp] a)]
    (push! (mut xs) x)
    (push! (mut xs) y)
    (rm-list a (load xs))))

(defn rm-list3 [(a (dyn Allocator)) (x Sexp) (y Sexp) (z Sexp)] (-> Sexp)
  (let [(mut xs) (ArrayList::new [Sexp] a)]
    (push! (mut xs) x)
    (push! (mut xs) y)
    (push! (mut xs) z)
    (rm-list a (load xs))))

(defn rm-list4 [(a (dyn Allocator)) (w Sexp) (x Sexp) (y Sexp) (z Sexp)] (-> Sexp)
  (let [(mut xs) (ArrayList::new [Sexp] a)]
    (push! (mut xs) w)
    (push! (mut xs) x)
    (push! (mut xs) y)
    (push! (mut xs) z)
    (rm-list a (load xs))))

;;; An identifier as fresh as `primitive/fresh-identifier` makes one.
(defn rm-fresh [(a (dyn Allocator)) (name (slice u8))] (-> Sexp)
  (let [p (primitive/alloc-stack Sexp)]
    (set! p (mk-sexp (KSym name) -1 -1))
    (set! (.hyg p) (primitive/iadd (next-gensym) 1))
    (set! (.horigin p) 2)
    (set! (.hmod p) "")
    (load p)))

;;; A fresh block label.
(defn rm-label [(a (dyn Allocator))] (-> Sexp)
  (mk-sexp (KKw (sconcat a "$g" (dec->str a (next-gensym)))) -1 -1))

(defn rm-sym-is? [(p Sexp) (name (slice u8))] (-> bool)
  (and (= (sx-tag p) 2) (= (sx-sval p) name)))

(defn rm-wild? [(p Sexp)] (-> bool) (rm-sym-is? p "_"))

;;; The same lexical identifier: spelling and scope.
(defn rm-same-ident? [(x Sexp) (y Sexp)] (-> bool)
  (and (= (sx-tag x) 2)
       (and (= (sx-tag y) 2)
            (and (= (sx-sval x) (sx-sval y)) (= (sx-hyg x) (sx-hyg y))))))

;;; Equal as data, the way patterns are compared: by spelling or value.
(defn rm-datum-eq? [(x Sexp) (y Sexp)] (-> bool)
  (and (= (sx-tag x) (sx-tag y))
       (if (= (sx-tag x) 0)
           (= (sx-ival x) (sx-ival y))
           (= (sx-sval x) (sx-sval y)))))

(defn rm-literal? [(p Sexp)] (-> bool)
  (and (match-literal-pattern? p) (!= (sx-tag p) 1)))

;;; `(Variant [patterns…])`, or `(Variant)` for a variant with no fields.
(defn rm-variant? [(p Sexp)] (-> bool)
  (and (= (sx-tag p) 6)
       (let [xs (sx-items p)
             n (sx-len xs)]
         (and (>= n 1)
              (and (= (sx-tag (sx-at xs 0)) 2)
                   (or (= n 1)
                       (and (= n 2)
                            (= (sx-tag (sx-at xs 1)) 7))))))))

(defn rm-fields [(a (dyn Allocator)) (p Sexp)] (-> (ptr (ArrayList Sexp)))
  (if (= (sx-len (sx-items p)) 1)
      (box-al [Sexp] a (ArrayList::new [Sexp] a))
      (sx-items (sx-at (sx-items p) 1))))

(defn rm-headed? [(p Sexp) (head (slice u8)) (n i64)] (-> bool)
  (and (= (sx-tag p) 6)
       (and (= (sx-len (sx-items p)) n) (rm-sym-is? (sx-at (sx-items p) 0) head))))

;;; `(as name pattern)`.
(defn rm-as? [(p Sexp)] (-> bool)
  (and (rm-headed? p "as" 3) (= (sx-tag (sx-at (sx-items p) 1)) 2)))

(defn rm-mut? [(p Sexp)] (-> bool) (rm-headed? p "mut" 2))

;;; A plain name for the whole value.
(defn rm-name? [(p Sexp)] (-> bool)
  (and (= (sx-tag p) 2) (and (not (rm-wild? p)) (not (rm-literal? p)))))

;;; Does the pattern bind a name anywhere?
(defn rm-binds? [(a (dyn Allocator)) (p Sexp)] (-> bool)
  (cond (or (rm-wild? p) (rm-literal? p)) false
        (rm-variant? p)
          (let [fields (rm-fields a p)
                (mut found) false]
            (for [i 0 (sx-len fields)]
              (when (rm-binds? a (sx-at fields i)) (set! found true)))
            found)
        :else true))

(defn rm-arm-head [(arm Sexp)] (-> Sexp)
  (sx-at (sx-items arm) 0))

(defn rm-body-start [(arm Sexp)] (-> i64)
  (if (or (rm-wild? (rm-arm-head arm)) (match-literal-pattern? (rm-arm-head arm))) 1 2))

;;; The arm's body forms; `(do)`, which yields no value, when it has none.
(defn rm-arm-body [(cx (ptr MatchCx)) (arm Sexp)] (-> (ArrayList Sexp))
  (let [a (.a cx)
        items (sx-items arm)
        (mut out) (ArrayList::new [Sexp] a)]
    (for [i (rm-body-start arm) (sx-len items)] (push! (mut out) (sx-at items i)))
    (when (= (len out) 0)
      (let [(mut empty) (ArrayList::new [Sexp] a)]
        (push! (mut empty) (mcx-word cx (mv-do)))
        (push! (mut out) (rm-list a (load empty))))
      0)
    (load out)))

;;; File `pattern`, matched against `value`, as a test when it can fail and a
;;; binding when it names the value; `_` needs neither.
(defn rm-add-pattern! [(cx (ptr MatchCx))
                       (tests (mut (ArrayList MatchTest)))
                       (binds (mut (ArrayList MatchBind)))
                       (value Sexp)
                       (pattern Sexp)
                       (prov MatchBind)] (-> (Result i64 Diag))
  (let [bind (primitive/alloc-stack MatchBind)]
    (set! bind prov)
    (set! (.pattern bind) pattern)
    (set! (.value bind) value)
    (cond (rm-wild? pattern) (Ok [i64 Diag] 0)
          (= (sx-tag pattern) 1)
            (Err [i64 Diag] (mcx-err cx "match: a float literal is not a pattern; compare it in the arm body instead"))
          (= (sx-tag pattern) 3)
            (Err [i64 Diag] (mcx-err cx "match: a keyword is not a pattern"))
          (or (rm-literal? pattern) (rm-variant? pattern))
            (do (push! (mut tests) (MatchTest :value value :pattern pattern)) (Ok [i64 Diag] 0))
          (rm-as? pattern)
            (do
              (set! (.pattern bind) (sx-at (sx-items pattern) 1))
              (push! (mut binds) (load bind))
              (rm-add-pattern! cx (mut tests) (mut binds) value (sx-at (sx-items pattern) 2) prov))
          (and (!= (sx-tag pattern) 2)
               (and (not (rm-mut? pattern)) (match-refutable-pattern? pattern)))
            (Err [i64 Diag] (mcx-err cx "match: a struct or sequence pattern cannot hold a variant or literal pattern; match that field in the arm body"))
          :else (do (push! (mut binds) (load bind)) (Ok [i64 Diag] 0)))))

(defn rm-test-at [(row (ptr MatchRow)) (value Sexp)] (-> i64)
  (let [(mut at) -1]
    (for [i 0 (len (load (.tests row)))]
      (when (and (< (load at) 0)
                 (rm-same-ident? (.value (elem (.tests row) i)) value))
        (set! at i)))
    (load at)))

(defn rm-pattern-at [(row (ptr MatchRow)) (at i64)] (-> Sexp)
  (.pattern (elem (.tests row) at)))

;;; What a pattern selects: a variant's name, or the literal itself.
(defn rm-key [(p Sexp)] (-> Sexp)
  (if (rm-variant? p) (sx-at (sx-items p) 0) p))

;;; `row` with its test at `at` replaced by tests of `fields` against `temps`.
(defn rm-specialize [(cx (ptr MatchCx))
                     (row (ptr MatchRow))
                     (at i64)
                     (temps (ptr (ArrayList Sexp)))
                     (fields (ptr (ArrayList Sexp)))
                     (value Sexp)
                     (variant Sexp)] (-> (Result MatchRow Diag))
  (try (let [a (.a cx)
             (mut tests) (ArrayList::new [MatchTest] a)
             (mut binds) (ArrayList::new [MatchBind] a)]
         (for b (iter (load (.binds row))) (push! (mut binds) b))
         (for [i 0 (len (load (.tests row)))]
           (if (= i at)
               (for [k 0 (sx-len fields)]
                 (try! (rm-add-pattern! cx
                                        (mut tests)
                                        (mut binds)
                                        (sx-at temps k)
                                        (sx-at fields k)
                                        (MatchBind :pattern value
                                                   :value value
                                                   :parent value
                                                   :variant variant
                                                   :field k
                                                   :arity (sx-len fields)))))
               (push! (mut tests) (load (elem (.tests row) i)))))
         (Ok (MatchRow :idx (.idx row)
                       :tests (box-al [MatchTest] a (load tests))
                       :binds (box-al [MatchBind] a (load binds)))))))

;;; The rows that can still match once `value` is `key`; with no key, once it is
;;; none of the keys.
(defn rm-select [(cx (ptr MatchCx))
                 (rows (ptr (ArrayList MatchRow)))
                 (value Sexp)
                 (key (Option Sexp))
                 (temps (ptr (ArrayList Sexp)))] (-> (Result (ptr (ArrayList MatchRow)) Diag))
  (try (let [a (.a cx)
             (mut out) (ArrayList::new [MatchRow] a)]
         (for i (range 0 (len (load rows)))
           (let [row (elem rows i)
                 at (rm-test-at row value)]
             (if (< at 0)
                 (push! (mut out) (load row))
                 (match key
                   (Some [k]
                         (let [pattern (rm-pattern-at row at)]
                           (when (rm-datum-eq? (rm-key pattern) k)
                             (let [fields (if (rm-variant? pattern)
                                              (rm-fields a pattern)
                                              (box-al [Sexp] a (ArrayList::new [Sexp] a)))]
                               (when (!= (sx-len fields) (sx-len temps))
                                 (break :try (Err (mcx-err cx "match: a variant is matched with different numbers of fields"))))
                               (push! (mut out)
                                      (try! (rm-specialize cx row at temps fields value k)))))
                           0))
                   (None [] 0)))))
         (Ok (box-al [MatchRow] a (load out))))))

;;; The distinct keys the rows test `value` against, in the order rows name them.
(defn rm-keys [(cx (ptr MatchCx))
               (rows (ptr (ArrayList MatchRow)))
               (value Sexp)
               (variants bool)] (-> (Result (ptr (ArrayList Sexp)) Diag))
  (try (let [a (.a cx)
             (mut keys) (ArrayList::new [Sexp] a)]
         (for i (range 0 (len (load rows)))
           (let [row (elem rows i)
                 at (rm-test-at row value)]
             (when (>= at 0)
               (let [pattern (rm-pattern-at row at)
                     (mut known) false]
                 (when (!= (rm-variant? pattern) variants)
                   (break :try (Err (mcx-err cx "match: one position is matched against both variants and literals"))))
                 (for k (iter (load keys))
                   (when (rm-datum-eq? k (rm-key pattern)) (set! known true)))
                 (unless (load known) (push! (mut keys) (rm-key pattern)))
                 0))))
         (Ok (box-al [Sexp] a (load keys))))))

(defn rm-has-key? [(keys (ptr (ArrayList Sexp))) (name (slice u8))] (-> bool)
  (let [(mut found) false]
    (for k (iter (load keys)) (when (rm-sym-is? k name) (set! found true)))
    found))

;;; The decision tree for `rows`.
(defn rm-compile [(cx (ptr MatchCx)) (rows (ptr (ArrayList MatchRow)))] (-> (Result (ptr MatchNode) Diag))
  (try (let [a (.a cx)
             row (elem rows 0)]
         (if (= (len (load (.tests row))) 0)
             (Ok (box! a MatchNode (MatchLeaf :idx (.idx row) :binds (.binds row))))
             (let [value (.value (elem (.tests row) 0))
                   variants (rm-variant? (rm-pattern-at row 0))
                   keys (try! (rm-keys cx rows value variants))
                   none (box-al [Sexp] a (ArrayList::new [Sexp] a))
                   rest-rows (try! (rm-select cx rows value (None [Sexp]) none))
                   rest (if (= (len (load rest-rows)) 0)
                            (None [(ptr MatchNode)])
                            (Some (try! (rm-compile cx rest-rows))))]
               (if variants
                   (let [(mut arms) (ArrayList::new [MatchBranch] a)]
                     (for key (iter (load keys))
                       (let [arity (let [(mut n) -1]
                                     (for i (range 0 (len (load rows)))
                                       (let [r (elem rows i)
                                             at (rm-test-at r value)]
                                         (when (and (< (load n) 0)
                                                    (and (>= at 0)
                                                         (rm-datum-eq? (rm-key (rm-pattern-at r at)) key)))
                                           (set! n (sx-len (rm-fields a (rm-pattern-at r at)))))))
                                     (load n))
                             (mut temps) (ArrayList::new [Sexp] a)]
                         (for _ (range 0 arity) (push! (mut temps) (rm-fresh a "payload")))
                         (let [temp-list (box-al [Sexp] a (load temps))
                               spec (try! (rm-select cx rows value (Some key) temp-list))]
                           (push! (mut arms)
                                  (MatchBranch :variant key
                                               :temps temp-list
                                               :sub (try! (rm-compile cx spec)))))))
                     (Ok (box! a MatchNode (MatchVariants :value value
                                                          :arms (box-al [MatchBranch] a (load arms))
                                                          :rest rest))))
                   (let [bools (and (rm-has-key? keys "true")
                                    (and (rm-has-key? keys "false")
                                         (= (len (load keys)) 2)))
                         (mut subs) (ArrayList::new [(ptr MatchNode)] a)]
                     (match rest
                       (Some [_] 0)
                       (None []
                             (unless bools
                               (break :try
                                        (Err (mcx-err cx
                                                      (if (or (rm-has-key? keys "true") (rm-has-key? keys "false"))
                                                          "match: a boolean position needs both `true` and `false` arms, or an arm that accepts either"
                                                          "match: literal patterns never cover every value of their type; add an arm for the values they leave out, such as (_ …)")))))
                             0))
                     (for key (iter (load keys))
                       (push! (mut subs)
                              (try! (rm-compile cx (try! (rm-select cx rows value (Some key) none))))))
                     (Ok (box! a MatchNode (MatchLiterals :value value
                                                          :keys keys
                                                          :subs (box-al [(ptr MatchNode)] a (load subs))
                                                          :rest rest))))))))))

;;; Push the row of every leaf under `node`, with its bindings.
(defn rm-leaves! [(node (ptr MatchNode)) (out (mut (ArrayList MatchNode)))] (-> i64)
  (match (load node)
    (MatchLeaf [_ _] (do (push! (mut out) (load node)) 0))
    (MatchVariants [_ arms rest]
                   (do
                     (for i (range 0 (len (load arms)))
                       (rm-leaves! (.sub (elem arms i)) (mut out)))
                     (match rest (Some [r] (rm-leaves! r (mut out))) (None [] 0))))
    (MatchLiterals [_ _ subs rest]
                   (do
                     (for i (range 0 (len (load subs))) (rm-leaves! (get (load subs) i) (mut out)))
                     (match rest (Some [r] (rm-leaves! r (mut out))) (None [] 0))))))

(defn rm-leaf-idx [(leaf MatchNode)] (-> i64)
  (match leaf (MatchLeaf [idx _] idx) (_ -1)))

(defn rm-leaf-binds [(leaf MatchNode)] (-> (ptr (ArrayList MatchBind)))
  (match leaf (MatchLeaf [_ binds] binds) (_ (primitive/cast (ptr (ArrayList MatchBind)) 0))))

(defn rm-count [(leaves (ptr (ArrayList MatchNode))) (idx i64)] (-> i64)
  (let [(mut n) 0]
    (for leaf (iter (load leaves)) (when (= (rm-leaf-idx leaf) idx) (set! n (+ (load n) 1))))
    (load n)))

;;; A renaming of temporaries to the names that became their binders.
(defstruct MatchRename [(from Sexp) (to Sexp)])

(defn rm-rename [(renames (ptr (ArrayList MatchRename))) (x Sexp)] (-> Sexp)
  (let [(mut out) x]
    (for r (iter (load renames)) (when (rm-same-ident? (.from r) x) (set! out (.to r))))
    (load out)))

(defn rm-check-names [(cx (ptr MatchCx)) (names (ptr (ArrayList Sexp)))] (-> (Result i64 Diag))
  (let [(mut dup) false]
    (for i (range 0 (len (load names)))
      (for j (range (+ i 1) (len (load names)))
        (when (rm-same-ident? (get (load names) i) (get (load names) j)) (set! dup true))))
    (if (load dup)
        (Err [i64 Diag] (mcx-err cx "binding: duplicate identifier in pattern"))
        (Ok [i64 Diag] 0))))

;;; The `let*` pairs that bind a struct or sequence pattern to `value`, from the
;;; binding layer's own destructuring; their names go on `names`.
(defn rm-destructure! [(cx (ptr MatchCx))
                       (pattern Sexp)
                       (value Sexp)
                       (pairs (mut (ArrayList Sexp)))
                       (names (mut (ArrayList Sexp)))
                    (ls (mut LS))] (-> (Result i64 Diag))
  (try (let [a (.a cx)
             (mut binding) (ArrayList::new [Sexp] a)]
         (push! (mut binding) pattern)
         (push! (mut binding) value)
         (let [out (try! (normalize-with-binding-macro "coil.binding.destructure"
                                                       (box-sexp a (rm-vec a (load binding)))
                                                       (.env cx)
                                                       (.allfns cx)
                                                       (.gs cx)
                                                       (.gu cx)
                                                       (.depth cx)
                                                       (mut ls)))
               items (sx-items out)]
           (for i (range 0 (sx-len items))
             (let [x (sx-at items i)]
               (push! (mut pairs) x)
               (when (= (% i 2) 0)
                 (push! (mut names) (if (rm-mut? x) (sx-at (sx-items x) 1) x))
                 0)))
           (Ok 0)))))

;;; `(match value (variant [binders…] body) (_ (primitive/pattern-fail)))`: the
;;; re-match of a value already known to be `variant`.
(defn rm-rematch [(cx (ptr MatchCx)) (value Sexp) (variant Sexp) (binders (ptr (ArrayList Sexp))) (body Sexp)] (-> Sexp)
  (let [a (.a cx)
        (mut fail) (ArrayList::new [Sexp] a)]
    (push! (mut fail) (mcx-word cx (mv-fail)))
    (rm-list4 a
              (mcx-word cx (mv-match))
              value
              (rm-list3 a variant (rm-vec a (load binders)) body)
              (rm-list2 a (mcx-word cx (mv-wild)) (rm-list a (load fail))))))

;;; `inner` with each of `aliases` bound by matching its parent again, so it binds
;;; like a payload; one match binds every name in a distinct field of a parent.
(defn rm-rebind [(cx (ptr MatchCx)) (aliases (ptr (ArrayList MatchBind))) (inner Sexp)] (-> Sexp)
  (if (= (len (load aliases)) 0)
      inner
      (let [a (.a cx)
            first (get (load aliases) 0)
            slots (box-al [Sexp] a (ArrayList::new [Sexp] a))
            (mut rest) (ArrayList::new [MatchBind] a)]
        (for _ (range 0 (.arity first)) (push! slots (mcx-word cx (mv-wild))))
        (for b (iter (load aliases))
          (if (and (rm-same-ident? (.parent b) (.parent first))
                   (and (rm-datum-eq? (.variant b) (.variant first))
                        (rm-wild? (get (load slots) (.field b)))))
              (store! (elem slots (.field b)) (.pattern b))
              (push! (mut rest) b)))
        (rm-rematch cx
                    (.parent first)
                    (.variant first)
                    slots
                    (rm-rebind cx (box-al [MatchBind] a (load rest)) inner)))))

;;; `body` (forms) with a leaf's bindings: a name that is its field's binder needs
;;; nothing, another plain name is matched again, and `(mut name)` and struct or
;;; sequence patterns bind as in `let`.
(defn rm-bind-leaf [(cx (ptr MatchCx))
                    (binds (ptr (ArrayList MatchBind)))
                    (renames (ptr (ArrayList MatchRename)))
                    (body (ArrayList Sexp))
                    (ls (mut LS))] (-> (Result Sexp Diag))
  (try (let [a (.a cx)
             (mut pairs) (ArrayList::new [Sexp] a)
             (mut names) (ArrayList::new [Sexp] a)
             (mut aliases) (ArrayList::new [MatchBind] a)]
         (for b (iter (load binds))
           (let [value (rm-rename renames (.value b))
                 pattern (.pattern b)]
             (cond (rm-name? pattern)
                     (do
                       (push! (mut names) pattern)
                       (unless (rm-same-ident? pattern value)
                         (let [moved (primitive/alloc-stack MatchBind)]
                           (set! moved b)
                           (set! (.value moved) value)
                           (set! (.parent moved) (rm-rename renames (.parent b)))
                           (push! (mut aliases) (load moved))))
                       0)
                   (rm-mut? pattern)
                     (do
                       (push! (mut names) (sx-at (sx-items pattern) 1))
                       (push! (mut pairs) pattern)
                       (push! (mut pairs) value)
                       0)
                   :else (do (try! (rm-destructure! cx pattern value (mut pairs) (mut names) (mut ls))) 0))))
         (try! (rm-check-names cx (box-al [Sexp] a (load names))))
         (let [(mut form) (ArrayList::new [Sexp] a)]
           (push! (mut form) (mcx-word cx (mv-let)))
           (push! (mut form) (rm-vec a (load pairs)))
           (for x (iter body) (push! (mut form) x))
           (Ok (rm-rebind cx (box-al [MatchBind] a (load aliases)) (rm-list a (load form))))))))

;;; The temporaries of `branch` that can be the binder of a name instead: when
;;; every leaf below is one row's, and that row's only leaf (`all` is every leaf
;;; of the tree), a field the row names with exactly one plain name. Returns the
;;; binders and extends `renames`.
(defn rm-binders [(cx (ptr MatchCx))
                  (branch (ptr MatchBranch))
                  (all (ptr (ArrayList MatchNode)))
                  (renames (mut (ArrayList MatchRename)))] (-> (ptr (ArrayList Sexp)))
  (let [a (.a cx)
        (mut leaves) (ArrayList::new [MatchNode] a)
        (mut out) (ArrayList::new [Sexp] a)]
    (rm-leaves! (.sub branch) (mut leaves))
    (let [idx (rm-leaf-idx (get leaves 0))
          one-row (and (= (len leaves) 1) (= (rm-count all idx) 1))
          binds (rm-leaf-binds (get leaves 0))]
      (for temp (iter (load (.temps branch)))
        (let [(mut uses) 0
              (mut name) temp]
          (when one-row
            (for b (iter (load binds))
              (when (rm-same-ident? (.value b) temp)
                (set! uses (+ (load uses) 1))
                (set! name (.pattern b)))))
          (if (and (= (load uses) 1) (rm-name? (load name)))
              (do
                (push! (mut renames) (MatchRename :from temp :to (load name)))
                (push! (mut out) (load name)))
              (push! (mut out) temp))))
      (box-al [Sexp] a (load out)))))

;;; The tree as code. A leaf becomes its row's body when it is the row's only
;;; leaf, and otherwise a break to the shared copy of the body.
(defn rm-emit [(cx (ptr MatchCx))
               (node (ptr MatchNode))
               (arms (ptr (ArrayList Sexp)))
               (leaves (ptr (ArrayList MatchNode)))
               (shared Sexp)
               (renames (ptr (ArrayList MatchRename)))
                    (ls (mut LS))] (-> (Result Sexp Diag))
  (try (let [a (.a cx)]
         (match (load node)
           (MatchLeaf [idx binds]
                      (if (= (rm-count leaves idx) 1)
                          (rm-bind-leaf cx binds renames (rm-arm-body cx (get (load arms) idx)) (mut ls))
                          (Ok (rm-list3 a (mcx-word cx (mv-break)) shared (sx-mkint idx)))))
           (MatchVariants [value branches rest]
                          (let [(mut form) (ArrayList::new [Sexp] a)]
                            (push! (mut form) (mcx-word cx (mv-match)))
                            (push! (mut form) (rm-rename renames value))
                            (for i (range 0 (len (load branches)))
                              (let [branch (elem branches i)
                                    (mut inner) (ArrayList::new [MatchRename] a)]
                                (for r (iter (load renames)) (push! (mut inner) r))
                                (let [binders (rm-binders cx branch leaves (mut inner))]
                                  (push! (mut form)
                                         (rm-list3 a
                                                   (.variant branch)
                                                   (rm-vec a (load binders))
                                                   (try! (rm-emit cx
                                                                  (.sub branch)
                                                                  arms
                                                                  leaves
                                                                  shared
                                                                  (box-al [MatchRename] a (load inner))
                                                                  (mut ls))))))))
                            (match rest
                              (Some [r]
                                    ; The rows left for the variants no row names; the
                                    ; checker drops this arm when the named ones are all.
                                    (push! (mut form)
                                           (rm-list2 a
                                                     (mcx-word cx (mv-wild))
                                                     (rm-list2 a
                                                               (mcx-word cx (mv-default))
                                                               (try! (rm-emit cx r arms leaves shared renames (mut ls)))))))
                              (None [] 0))
                            (Ok (rm-list a (load form)))))
           (MatchLiterals [value keys subs rest]
                          (let [n (len (load keys))
                                (mut acc)
                                  (match rest
                                    (Some [r] (try! (rm-emit cx r arms leaves shared renames (mut ls))))
                                    (None [] (try! (rm-emit cx (get (load subs) (- n 1)) arms leaves shared renames (mut ls)))))
                                last (match rest (Some [_] (- n 1)) (None [] (- n 2)))]
                            (for j (range 0 (+ last 1))
                              (let [i (- last j)]
                                (set! acc
                                      (rm-list4 a
                                                (mcx-word cx (mv-if))
                                                (rm-list3 a
                                                          (mcx-word cx (mv-eq))
                                                          (rm-rename renames value)
                                                          (get (load keys) i))
                                                (try! (rm-emit cx (get (load subs) i) arms leaves shared renames (mut ls)))
                                                (load acc)))))
                            (Ok (load acc))))))))

;;; `inner` with the names of the variant pattern `pattern`, known to match
;;; `value`, bound as the binders of a match on `value`.
(defn rm-project [(cx (ptr MatchCx))
                  (value Sexp)
                  (pattern Sexp)
                  (names (mut (ArrayList Sexp)))
                  (inner Sexp)
                    (ls (mut LS))] (-> (Result Sexp Diag))
  (try (let [a (.a cx)]
         (if (not (rm-binds? a pattern))
             (Ok inner)
             (let [fields (rm-fields a pattern)
                   binders (box-al [Sexp] a (ArrayList::new [Sexp] a))
                   (mut body) inner]
               (for k (range 0 (sx-len fields))
                 (let [field (sx-at fields k)]
                   (cond (rm-name? field) (do (push! (mut names) field) (push! binders field) 0)
                         (not (rm-binds? a field)) (do (push! binders (mcx-word cx (mv-wild))) 0)
                         (rm-as? field)
                           (let [name (sx-at (sx-items field) 1)
                                 sub (sx-at (sx-items field) 2)]
                             (push! (mut names) name)
                             (push! binders name)
                             (if (rm-variant? sub)
                                 (set! body (try! (rm-project cx name sub (mut names) (load body) (mut ls))))
                                 (when (rm-binds? a sub)
                                   (let [(mut pairs) (ArrayList::new [Sexp] a)]
                                     (try! (rm-destructure! cx sub name (mut pairs) (mut names) (mut ls)))
                                     (set! body (rm-list3 a (mcx-word cx (mv-let)) (rm-vec a (load pairs)) (load body))))))
                             0)
                         :else
                           (let [temp (rm-fresh a "payload")]
                             (push! binders temp)
                             (if (rm-variant? field)
                                 (set! body (try! (rm-project cx temp field (mut names) (load body) (mut ls))))
                                 (let [(mut pairs) (ArrayList::new [Sexp] a)]
                                   (if (rm-mut? field)
                                       (do
                                         (push! (mut names) (sx-at (sx-items field) 1))
                                         (push! (mut pairs) field)
                                         (push! (mut pairs) temp)
                                         0)
                                       (try! (rm-destructure! cx field temp (mut pairs) (mut names) (mut ls))))
                                   (set! body (rm-list3 a (mcx-word cx (mv-let)) (rm-vec a (load pairs)) (load body)))))
                             0))))
               (Ok (rm-rematch cx value (sx-at (sx-items pattern) 0) binders (load body))))))))

;;; Arm `idx`, whose leaves are shared, with its names bound from the scrutinee.
(defn rm-shared-body [(cx (ptr MatchCx)) (arm Sexp) (scrutinee Sexp)
                    (ls (mut LS))] (-> (Result Sexp Diag))
  (try (let [a (.a cx)
             (mut body) (ArrayList::new [Sexp] a)
             (mut names) (ArrayList::new [Sexp] a)]
         (push! (mut body) (mcx-word cx (mv-do)))
         (for x (iter (rm-arm-body cx arm)) (push! (mut body) x))
         (let [projected
                 (if (= (rm-body-start arm) 1)
                     (rm-list a (load body))
                     (try! (rm-project cx
                                       scrutinee
                                       (rm-list2 a (rm-arm-head arm) (sx-at (sx-items arm) 1))
                                       (mut names)
                                       (rm-list a (load body))
                                       (mut ls))))]
           (try! (rm-check-names cx (box-al [Sexp] a (load names))))
           (Ok projected)))))

;;; Lower `(match value arm…)` with a refutable arm (see above).
(defn lower-refutable-match [(form Sexp)
                             (env (ptr ExpEnv))
                             (allfns (ptr (ArrayList (slice u8))))
                             (gs (ptr (ArrayList StructDef)))
                             (gu (ptr (ArrayList SumDef)))
                             (depth (ptr i64))
                             (ls (mut LS))] (-> (Result Sexp Diag))
  (try (let [a (.a env)
             vocab (sx-items (try! (normalize-with-binding-macro "coil.binding.match-vocabulary"
                                                                 (box-sexp a form)
                                                                 env
                                                                 allfns
                                                                 gs
                                                                 gu
                                                                 depth
                                                                 (mut ls))))
             cx (box! a MatchCx (MatchCx :a a :form form :vocab vocab :env env :allfns allfns
                                         :gs gs :gu gu :depth depth))
             items (sx-items form)
             scrutinee (rm-fresh a "scrutinee")
             arms (box-al [Sexp] a (ArrayList::new [Sexp] a))
             (mut rows) (ArrayList::new [MatchRow] a)]
         (for i (range 2 (sx-len items)) (push! arms (sx-at items i)))
         (for i (range 0 (len (load arms)))
           (let [arm (get (load arms) i)
                 (mut tests) (ArrayList::new [MatchTest] a)]
             (when (or (!= (sx-tag arm) 6)
                       (= (sx-len (sx-items arm)) 0))
               (break :try (Err (mcx-err cx "match: expected an arm list"))))
             (let [head (rm-arm-head arm)]
               (cond (rm-wild? head) 0
                     (match-literal-pattern? head)
                       (do (push! (mut tests) (MatchTest :value scrutinee :pattern head)) 0)
                     (and (= (sx-tag head) 2)
                          (and (>= (sx-len (sx-items arm)) 2)
                               (= (sx-tag (sx-at (sx-items arm) 1)) 7)))
                       (do
                         (push! (mut tests)
                                (MatchTest :value scrutinee
                                           :pattern (rm-list2 a head (sx-at (sx-items arm) 1))))
                         0)
                     :else
                       (break :try (Err (mcx-err cx "match: expected (Variant [patterns…] body…), (literal body…) or (_ body…)")))))
             (push! (mut rows)
                    (MatchRow :idx i
                              :tests (box-al [MatchTest] a (load tests))
                              :binds (box-al [MatchBind] a (ArrayList::new [MatchBind] a))))))
         (let [tree (try! (rm-compile cx (box-al [MatchRow] a (load rows))))
               (mut leaf-list) (ArrayList::new [MatchNode] a)]
           (rm-leaves! tree (mut leaf-list))
           (let [leaves (box-al [MatchNode] a (load leaf-list))
                 (mut shared-rows) (ArrayList::new [i64] a)
                 shared (rm-label a)
                 done (rm-label a)
                 chosen (rm-fresh a "arm")]
             (for i (range 0 (len (load arms)))
               (let [count (rm-count leaves i)]
                 (when (= count 0)
                   (let [arm (get (load arms) i)
                         (mut shown) (ArrayList::new [Sexp] a)]
                     (for k (range 0 (rm-body-start arm)) (push! (mut shown) (sx-at (sx-items arm) k)))
                     (push! (mut shown) (sx-sym "..."))
                     (break :try
                              (Err (mcx-err cx
                                            (sconcat3 a
                                                      "match: the arm "
                                                      (sexp-display a (rm-list a (load shown)))
                                                      " can never match: the arms before it already match every value it would"))))))
                 (when (> count 1) (push! (mut shared-rows) i))
                 0))
             (let [body (try! (rm-emit cx tree arms leaves shared (box-al [MatchRename] a (ArrayList::new [MatchRename] a)) (mut ls)))
                   (mut bind-scrutinee) (ArrayList::new [Sexp] a)]
               (push! (mut bind-scrutinee) scrutinee)
               (push! (mut bind-scrutinee) (sx-at items 1))
               (let [out
                       (if (= (len shared-rows) 0)
                           (rm-list3 a (mcx-word cx (mv-let)) (rm-vec a (load bind-scrutinee)) body)
                           (let [n (len shared-rows)
                                 (mut dispatch)
                                   (try! (rm-shared-body cx (get (load arms) (get shared-rows (- n 1))) scrutinee (mut ls)))
                                 (mut chosen-bind) (ArrayList::new [Sexp] a)]
                             (for j (range 0 (- n 1))
                               (let [idx (get shared-rows (- (- n 2) j))]
                                 (set! dispatch
                                       (rm-list4 a
                                                 (mcx-word cx (mv-if))
                                                 (rm-list3 a (mcx-word cx (mv-eq)) chosen (sx-mkint idx))
                                                 (try! (rm-shared-body cx (get (load arms) idx) scrutinee (mut ls)))
                                                 (load dispatch)))))
                             (push! (mut chosen-bind) chosen)
                             (push! (mut chosen-bind)
                                    (rm-list3 a
                                              (mcx-word cx (mv-block))
                                              shared
                                              (rm-list3 a (mcx-word cx (mv-break)) done body)))
                             (rm-list3 a
                                       (mcx-word cx (mv-let))
                                       (rm-vec a (load bind-scrutinee))
                                       (rm-list3 a
                                                 (mcx-word cx (mv-block))
                                                 done
                                                 (rm-list3 a
                                                           (mcx-word cx (mv-let))
                                                           (rm-vec a (load chosen-bind))
                                                           (load dispatch))))))
                     outp (box-sexp a out)]
                 ; Generated nodes take the match's own location.
                 (stamp-expansion outp (sx-source form) (sx-lo form) (sx-hi form) (sx-ctxt form))
                 (Ok (load outp)))))))))

(defn normalize-with-binding-macro [(q (slice u8))
                                    (arm (ptr Sexp))
                                    (env (ptr ExpEnv))
                                    (allfns (ptr (ArrayList (slice u8))))
                                    (gs (ptr (ArrayList StructDef)))
                                    (gu (ptr (ArrayList SumDef)))
                                    (depth (ptr i64))
                                    (ls (mut LS))] (-> (Result Sexp Diag))
  (let [a (.a env)
        (mut args) (ArrayList::new [Sexp] a)
        limit (macro-expansion-limit)]
    (set! depth (+ (load depth) 1))
    (trace-macro-call q (load depth) 1)
    (if (and (> limit 0) (> (load depth) limit))
        (Err [Sexp Diag]
             (stamp-call-site (derr "macro expansion budget exhausted while normalizing a match arm")
                              (load arm)))
        (do
          (push! (mut args) (load arm))
          (match (expand-macro (.sub env)
                               q
                               (mut args)
                               allfns
                               gs
                               gu
                               (.impb env)
                               (.expb env)
                               a
                               (.code_session_state ls) (field ls expansions))
            (Err [d] (Err [Sexp Diag] (stamp-call-site d (load arm))))
            (Ok [normalized]
                (let [out (box-sexp a normalized)
                      definition (find-func-ptr (.sub env) q)
                      present (!= (primitive/cast i64 definition) 0)
                      expansion
                        (mk-expansion q
                                      (.source arm)
                                      (.lo arm)
                                      (.hi arm)
                                      (.ctxt arm)
                                      (if present (.source definition) -1)
                                      (if present (.lo definition) -1)
                                      (if present (.hi definition) -1)
                                      (if present (.ctxt definition) 0)
                                      (.ctxt arm))
                      ctxt (add-expansion! (mut ls) expansion)]
                  (stamp-expansion out (.source arm) (.lo arm) (.hi arm) ctxt)
                  (Ok [Sexp Diag] (load out)))))))))

;;; Revision reuse compares semantic syntax, including lexical decisions.
;;; Datum equality deliberately ignores hygiene and cannot establish reuse.
(defn expansion-form-equal? [(x Sexp) (y Sexp)] (-> bool)
  (let [tx (sx-tag x)
        ty (sx-tag y)]
    (if (or (!= (sx-hyg x) (sx-hyg y))
            (or (!= (sx-hmod x) (sx-hmod y))
                (or (!= (sx-horigin x) (sx-horigin y))
                    (!= (sx-hflags x) (sx-hflags y)))))
        false
        (if (and (code-node-listish? x) (code-node-listish? y))
            (if (or (!= (= tx 7) (= ty 7))
                    (!= (code-node-len x) (code-node-len y)))
                false
                (let [(mut same) true]
                  (for [i 0 (code-node-len x)]
                    (unless (expansion-form-equal? (code-node-at x i)
                                                   (code-node-at y i))
                      (set! same false)
                      0))
                  (load same)))
            (sexp-eq x y)))))


; Publish exact occurrence evidence, independently of declaration reflection's
; useful but unsuitable bare-name fallback. Type answers conservatively combine
; resolution evidence: a spelling also used as a type parameter is ambiguous.
;;; KEY is NODE's occurrence key.
(defn source-view-binding [(a (dyn Allocator)) (node Sexp) (key (slice u8))
                            (module (slice u8)) (role (slice u8))] (-> SourceBindingFact)
  (let [answer (if (= role "type")
                   (get (.types (source-facts))
                     (source-name-probe module (lexical-name a node) 1))
                   (if (= role "macro")
                       (get (.macro_answers (source-facts)) key)
                       (if (= role "primitive")
                           (get (.primitive_answers (source-facts)) key)
                           (get (.answers (source-facts)) key))))]
    (match answer
      (None [] (FactUnknown))
      (Some [resolved]
        (cond (.ambiguous resolved) (FactAmbiguous)
              (.local resolved)
                (match (get (.locals (source-facts)) key)
                  (Some [id] (if (> id 0) (FactLocal id) (FactLocalAmbiguous)))
                  (None [] (FactLocalUnknown)))
              (= (.name resolved) "") (FactUnknown)
              :else (FactGlobal (.name resolved)))))))

; Quote contents never name language bindings. Quasiquote unquotes are ordinary
; expressions; nested quasiquotes require the same depth discipline as expansion.
;
; The one walk of the authored program the view makes. Every fact it finds is filed
; in the source index under the key a query asks with (comptime.coil, SourceIndex):
; a reference under its module, its target and the import it went through, and the
; form it heads (PARENT, when the reference is element 0 of it); a `let` binder
; under its module.
(defn source-view-walk! [(a (dyn Allocator)) (node Sexp) (parent Sexp) (at i64)
                          (module (slice u8)) (quote-depth i64)
                          (refs (mut (ArrayList Sexp))) (keys (mut StrBuf))] (-> i64)
  (block :done
    (let [tag (sx-tag node)
          head (if (= (sx-tag node) 6) (sx-head-name (sx-items node)) "")]
      (when (and (= quote-depth 0) (= head "quote")) (return-from :done 0))
      (when (or (= tag 6) (= tag 7))
        (let [depth (cond (= head "quasiquote") (+ quote-depth 1)
                         (and (> quote-depth 0)
                              (or (= head "unquote") (= head "unquote-splicing")))
                           (- quote-depth 1)
                         :else quote-depth)
              items (sx-items node)]
          (when (and (= tag 7) (= depth 0) (= at 1) (source-view-let? a parent module (mut keys)))
            (source-view-binders! a items module (mut keys)) 0)
          ; A form is filed under its head by the depth its HEAD is at: a
          ; quasiquote at depth 0 is code of the module (forms-headed finds it,
          ; and the templates inside it, which the unused-import checks read),
          ; though its contents are one level deeper.
          (when (and (= tag 6) (= quote-depth 0)) (source-view-core-form! a node module (mut keys)) 0)
          (for [i 0 (sx-len items)]
            (source-view-walk! a (sx-at items i) node i module depth (mut refs) (mut keys))))
        (return-from :done 0))
      (unless (and (= quote-depth 0) (= tag 2)) (return-from :done 0))
      ; A binder or other name that is not a reference keeps whatever role the
      ; provisional parse gave it, so its own record is what says it is not one.
      ; A `let` binder still answers how it binds: the local it introduces, the
      ; identity every read of it resolves to (source-binder-identity!).
      (when (source-view-nonreference? a node)
        (let [key (source-view-key (mut keys) node)]
          (match (get (.locals (source-facts)) key)
            (Some [id] (set! (mut (.source_occurrences (comptime-unit-state))) key
                         (SourceOccurrence :binding (if (> id 0) (FactLocal id) (FactLocalAmbiguous))
                                           :reference -1)))
            (None [] 0)))
        (return-from :done 0))
      (let [key (source-view-key (mut keys) node)]
        (match (match (get (.macro_roles (source-facts)) key)
                 (Some [site] (Some site))
                 (None [] (match (get (.primitive_roles (source-facts)) key)
                            (Some [site] (Some site))
                            (None [] (get (.roles (source-facts)) key)))))
          (None [] 0)
          (Some [site]
            (let [role (.role site)
                  binding (source-view-binding a node key module role)
                  global (match binding (FactGlobal [name] name) (_ ""))
                  raw (lexical-name a node)
                  route (if (> (len global) 0)
                            (match (get (.routes (source-facts))
                                     (source-name-probe module raw
                                       (cond (= role "type") 1 (= role "macro") 6 (= role "primitive") 7
                                             (= role "value") 5 :else 0)))
                              (Some [found] (Some found))
                              ; A call head or a pattern can name a type, a
                              ; constructor, whose import is recorded as the type's.
                              (None [] (if (or (= role "call") (= role "pattern"))
                                           (get (.routes (source-facts)) (source-name-probe module raw 1))
                                           (None [SourceRoute]))))
                            (None [SourceRoute]))
                  through (match route
                            (Some [origin] (if (= (.qualified origin) global) (.target origin) ""))
                            (None [] ""))
                  ; a record is built once and never grows: allocate it at its size
                  (mut record) (ArrayList::new [Sexp] a)
                  _sized (reserve! (mut record) (if (> (len through) 0) 6 4))
                  index (field (comptime-unit-state) source_index)]
              ; `(reference MODULE NODE ROLE)`, then the import's target and the
              ; name it exports when the occurrence resolved through an import
              ; (meta/reference-import). How it binds is code-source-binding's.
              (push! (mut record) (sx-sym "reference"))
              (push! (mut record) (sx-sym module))
              (push! (mut record) node)
              (push! (mut record) (mk-sexp (KKw role) -1 -1))
              (match route
                (Some [origin]
                  (when (> (len through) 0)
                    (push! (mut record) (sx-sym (.target origin)))
                    (push! (mut record) (sx-sym (.exported origin)))
                    0))
                (None [] 0))
              (let [reference (sx-mklist (box-al [Sexp] a (load record)))]
                (let [at (len (load refs))]
                  (set! (mut (.source_occurrences (comptime-unit-state))) key
                    (SourceOccurrence :binding binding :reference at))
                  (push! (mut refs) reference)
                  (source-index-add-reference! a (mut (.by_module index)) module at)
                  (when (> (len through) 0)
                    (source-index-add-reference! a (mut (.by_import index)) (sconcat3 a module " " through) at) 0)
                  (match binding
                    (FactGlobal [name] (source-index-add-reference! a (mut (.by_target index)) name at))
                    (FactLocal [id] (source-index-add-reference! a (mut (.by_target index)) (sconcat a "#" (i64->str a id)) at))
                    (_ 0)))
                (when (and (= at 0) (= (sx-tag parent) 6))
                  (set! (mut (.forms index)) key parent) 0))
              0)))))
    0))

;;; NODE's occurrence key, built in KEYS: borrowed until the next one is. Every
;;; table copies a key it is given on insert, so the walk's keys need no storage
;;; of their own; allocated afresh, they were a few hundred bytes per reference.
(defn source-view-key [(keys (mut StrBuf)) (node Sexp)] (-> (slice u8))
  (set! (.len (field keys bytes)) 0)
  (source-occurrence-key-into! (mut keys) node)
  (str (load keys)))

;;; File FORM under its head's spelling when that head is core syntax: a symbol no
;;; declaration answers and no binder introduces (`if`, `or`, `match`, `mut`).
(defn source-view-core-form! [(a (dyn Allocator)) (form Sexp) (module (slice u8)) (keys (mut StrBuf))] (-> i64)
  (let [items (sx-items form)]
    (when (> (sx-len items) 0)
      (let [head (sx-at items 0)]
        (when (and (= (sx-tag head) 2)
                   (not (source-view-nonreference? a head))
                   (let [key (source-view-key (mut keys) head)]
                     (and (none? (get (.macro_roles (source-facts)) key))
                          (none? (get (.primitive_roles (source-facts)) key))
                          (none? (get (.roles (source-facts)) key)))))
          (source-index-add! a (mut (.by_head (field (comptime-unit-state) source_index)))
                             (sconcat3 a module " " (sx-sval head)) form)
          0))
      0))
  0)

;;; Is NODE an authored name the parse recorded as no reference: a binder, a field
;;; name, a declaration's own name?
(defn source-view-nonreference? [(a (dyn Allocator)) (node Sexp)] (-> bool)
  (match (get (.nonreferences (source-facts))
              (source-expression-probe (sx-source node) (sx-lo node) (sx-hi node) 0 0))
    (Some [_] true)
    (None [] false)))

;;; Is FORM an authored `let`: its head resolves to coil.binding.let, or is the core
;;; `let*`? A loop's `[i 0 n]` binds through a `let` its macro writes, so its names
;;; have local identities too, but it is no binding vector to delete a pair from.
(defn source-view-let? [(a (dyn Allocator)) (form Sexp) (module (slice u8)) (keys (mut StrBuf))] (-> bool)
  (and (= (sx-tag form) 6)
       (> (sx-len (sx-items form)) 1)
       (let [head (sx-at (sx-items form) 0)]
         (and (= (sx-tag head) 2)
              (or (= (sx-sval head) "let*")
                  (match (source-view-binding a head (source-view-key (mut keys) head) module "macro")
                    (FactGlobal [name] (= name "coil.binding.let"))
                    (_ false)))))))

;;; The local identity the authored binder NODE introduces, 0 when it is none.
(defn source-view-binder-id [(a (dyn Allocator)) (node Sexp) (keys (mut StrBuf))] (-> i64)
  (if (and (= (sx-tag node) 2) (source-view-nonreference? a node))
      (match (get (.locals (source-facts)) (source-view-key (mut keys) node))
        (Some [id] (if (> id 0) id 0))
        (None [] 0))
      0))

;;; A binding vector's `let` binders: each `NAME VALUE` or `(mut NAME) VALUE` pair
;;; whose NAME introduces a local the checker identified, filed under MODULE as
;;; `(binder MODULE NAME ID FORM VALUE)`, FORM being NAME or `(mut NAME)`.
(defn source-view-binders! [(a (dyn Allocator)) (items (ptr (ArrayList Sexp))) (module (slice u8)) (keys (mut StrBuf))] (-> i64)
  (let [n (sx-len items)
        index (field (comptime-unit-state) source_index)]
    (for [p 0 (/ n 2)]
      (let [form (sx-at items (* p 2))
            name (if (and (= (sx-tag form) 6) (= (sx-len (sx-items form)) 2))
                     (sx-at (sx-items form) 1)
                     form)
            id (source-view-binder-id a name (mut keys))]
        (when (> id 0)
          (let [(mut record) (ArrayList::new [Sexp] a)]
            (reserve! (mut record) 6)
            (push! (mut record) (sx-sym "binder"))
            (push! (mut record) (sx-sym module))
            (push! (mut record) name)
            (push! (mut record) (mk-sexp (KInt id) -1 -1))
            (push! (mut record) form)
            (push! (mut record) (sx-at items (+ (* p 2) 1)))
            (source-index-add! a (mut (.binders index)) module (sx-mklist (box-al [Sexp] a (load record))))))
        0)))
  0)

(defn source-view-publish! [(a (dyn Allocator)) (s (mut LS))
                            (authored (ptr (ArrayList TaggedForm)))] (-> i64)
  (let [state (comptime-unit-state)
        (mut imports) (ArrayList::new [Sexp] a)]
    (source-view-discard!)
    (for definition (.primitive_defs s)
      (set! (mut (.declarations (source-facts)))
        (source-name-key a (.module definition) (.name definition) 0) true))
    (for definition (.primitive_aliases s)
      (set! (mut (.declarations (source-facts)))
        (source-name-key a (.module definition) (.name definition) 0) true))
    (set! (.source_import_table state) (box-al [ImpEntry] a (.imports s)))
    (set! (.source_export_table state) (box-al [ExpEntry] a (.exports s)))
    (for [i 0 (len (.imports s))]
      (let [entry (get (.imports s) i)]
        (for form (.forms (.imp entry))
          (when (.source_import_origins_ready (ast-unit-state))
            (match (get (.source_import_origins (ast-unit-state)) (source-occurrence-key a form))
              (None [] 0)
              (Some [origin]
                (let [(mut parts) (ArrayList::new [Sexp] a)]
                  (push! (mut parts) (sx-sym "source-import"))
                  (push! (mut parts) (sx-sym (.module origin)))
                  (push! (mut parts) form)
                  (push! (mut parts) (sx-sym (.target origin)))
                  (push! (mut imports) (sx-mklist (box-al [Sexp] a (load parts)))) 0))) 0))))
    (set! (.source_imports state) (sx-mklist (box-al [Sexp] a (load imports))))
    (set! (.enabled (source-facts)) false)
    ; The modules and the reference records: built when first asked for.
    (source-view-defer! (primitive/fnptr-of source-view-build)
                        (primitive/cast (ptr i8)
                                        (box! a SourceViewPending
                                              (SourceViewPending :a a
                                                                 :authored authored
                                                                 :imports (.source_import_table state)
                                                                 :exports (.source_export_table state))))))
  0)

;;; What `source-view-build` builds the deferred part of a publication from.
(defstruct SourceViewPending
  [(a (dyn Allocator))
   (authored (ptr (ArrayList TaggedForm)))
   (imports (ptr (ArrayList ImpEntry)))
   (exports (ptr (ArrayList ExpEntry)))])

;;; Sort FORMS by where they start.
(defn source-forms-sort! [(forms (ptr (ArrayList Sexp)))] (-> i64)
  (for [i 1 (len (load forms))]
    (let [value (get (load forms) i) (mut j) i]
      (loop
        (when (or (<= j 0) (<= (sx-lo (get (load forms) (- j 1))) (sx-lo value))) (break))
        (store! (elem forms j) (get (load forms) (- j 1)))
        (set! j (- j 1)))
      (store! (elem forms j) value)))
  0)

(defn source-view-build [(raw (ptr i8))] (-> i64)
  (let [pending (primitive/cast (ptr SourceViewPending) raw)
        a (.a pending)
        authored (.authored pending)
        state (comptime-unit-state)
        (mut refs) (ArrayList::new [Sexp] a)]
    (set! (.source_occurrences state) (HashMap::new [(slice u8) SourceOccurrence] a (keyops)))
    ; One entry per occurrence the facts recorded a role or a local for, at most:
    ; sized once, the table leaves no outgrown copies in the analysis's arena.
    (let [facts (source-facts)]
      (grow! (mut (.source_occurrences state))
             (* 2 (+ (+ (len (.roles facts)) (len (.macro_roles facts)))
                     (+ (len (.primitive_roles facts)) (len (.locals facts)))))))
    (let [span (tr/span-begin "lint.source-view.modules")]
      (set! (.source_modules state) (build-modules a authored (.imports pending) (.exports pending) true))
      (tr/span-end span))
    (set! (.source_index state) (source-index-new a))
    (let [index (field state source_index)]
      ; each module's record, and each authored top-level form by where it was
      ; written (meta/definition-form)
      (for record (load (sx-items (.source_modules state)))
        (let [items (sx-items record)
              module (sx-sval (sx-at items 0))]
          (set! (mut (.modules index)) module record)
          (for [k 1 (sx-len items)]
            (let [f (sx-at items k)]
              (when (>= (sx-source f) 0)
                (set! (mut (.written index)) (source-written-key a (sx-source f) (sx-lo f)) f)
                (match (get (.tops index) (sx-source f))
                  (Some [forms] (push! forms f))
                  (None [] (let [forms (box-al [Sexp] a (ArrayList::new [Sexp] a))]
                             (push! forms f)
                             (set! (mut (.tops index)) (sx-source f) forms))))
                0)))))
      ; each source's top-level forms in source order, for code-path's search
      (for source (iter (.tops index))
        (match (get (.tops index) source)
          (Some [forms] (source-forms-sort! forms))
          (None [] 0)))
      (for item (load (sx-items (.source_imports state)))
        (source-index-add! a (mut (.imports index)) (sx-sval (sx-at (sx-items item) 1)) item)))
    ; A form the authored list holds twice (a module's imports are kept for its
    ; own record and again as forms) is one place in the source: walk it once.
    (let [(mut walked) (HashMap::new [(slice u8) i64] a (keyops))
          (mut keys) (StrBuf::new a)
          span (tr/span-begin "lint.source-view.walk")]
      (for [i 0 (len (load authored))]
        (let [form (elem authored i)
              f (.form form)
              at (if (>= (sx-source f) 0) (source-written-key a (sx-source f) (sx-lo f)) "")]
          (unless (and (> (len at) 0) (contains? walked at))
            (when (> (len at) 0) (set! (mut walked) at 1) 0)
            (source-view-walk! a f f -1 (opt-mod-name (.module form)) 0 (mut refs) (mut keys)))))
      (tr/span-end span))
    (set! (.source_references state) (sx-mklist (box-al [Sexp] a (load refs))))
    (set! (.source_ready state) true))
  0)
