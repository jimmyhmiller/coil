(extern rmdir :cc c [(ptr i8)] (-> i32))

;; Host image compatibility is additionally pinned by the digest of the running
;; compiler binary. Native images are executable plugins and must be trusted in
;; the same way as the source provider used to construct them.
(defn provider-sdk [(a (dyn Allocator))] (-> (Result (slice u8) Diag))
  (artifact-file-digest a (self-command-path a)))

(defn provider-host [] (-> (slice u8))
  (if (me-host-linux?) "native-linux" "native-darwin"))

(defn provider-target [(a (dyn Allocator))] (-> (slice u8))
  (let [triple (target-triple)]
    (if (= (cast i64 triple) 0)
        (sconcat3 a (target-arch-str) "-" (target-os-str))
        (cstr->slice triple))))

(defn provider-read-bytes [(a (dyn Allocator)) (path (slice u8))] (-> (Result (slice u8)
                                                                              Diag))
  (match (fs/file-open (str->cstr a path) fs/O_RDONLY 0)
    (Err [_]
         (Err (artifact-error (sconcat a "cannot open provider metadata: " path))))
    (Ok [opened]
        (let [file (p/alloc-stack fs/File)
              reader (p/alloc-stack io/Reader)
              buffer (p/alloc-stack (array u8 4096))
              (mut bytes) (sb-new a)]
          (store! file opened)
          (fs/file-reader reader file)
          (let [result
                  (block :read
                         (loop (match (io/read-some reader
                                                    (cast (ptr i8) buffer)
                                                    4096)
                                 (Err [_]
                                      (return-from :read
                                                     (Err [(slice u8) Diag]
                                                          (artifact-error "cannot read provider metadata"))))
                                 (Ok [n]
                                     (when (= n 0)
                                       (return-from :read
                                                      (Ok [(slice u8) Diag]
                                                          (sb-str (load bytes)))))
                                     (when (> (+ (len (sb-str (load bytes))) n)
                                              67108864)
                                       (return-from :read
                                                      (Err [(slice u8) Diag]
                                                           (artifact-error "provider metadata exceeds 64 MiB limit"))))
                                     (sb-push-str! (mut bytes)
                                                   (slice-new (cast (ptr u8)
                                                                    buffer)
                                                              n))))
                           0)
                         (Err [(slice u8) Diag]
                              (artifact-error "provider metadata read did not finish")))]
            (fs/file-close file)
            result)))))

(defn provider-inputs [(a (dyn Allocator)) (setup (ptr LS))] (-> (Result (ptr (ArrayList ArtifactInput))
                                                                         Diag))
  (try (let [(mut inputs) (al-new [ArtifactInput] a)
             (mut seen) (al-new [(slice u8)] a)
             layout (stdlib-layout a)]
         ;; The source table includes the implicit prelude, which the import memo does
         ;; not. Resolve bundled display names using the exact active toolchain layout.
         (for [i 0 (len (.sources setup))]
           (let [display (.name (al-elem [Source] (field setup sources) i))
                 path
                   (cond (or (= display "<read setup>")
                             (or (= display "<metashim>")
                                 (starts-with display "<core-provider ")))
                           ""
                         (= display "<prelude>") (.prelude layout)
                         (starts-with display "<bundled ")
                           (let [bn (subslice display 9 (- (len display) 1))
                                 sdk (starts-with bn "compiler/")]
                             (path-join a
                                        (if sdk (.sdk layout) (.libs layout))
                                        (if sdk (subslice bn 9 (len bn)) bn)))
                         :else display)]
             (unless (or (= path "") (set-contains (mut seen) path))
               (let [digest
                       (artifact-bytes-digest a
                                              (.text (al-elem [Source]
                                                              (field setup
                                                                     sources)
                                                              i)))]
                 (push! (mut inputs) (ArtifactInput :path path :digest digest))
                 (push! (mut seen) path))
               0))
           0)
         ;; include-str is a real dependency even though it introduces no module or
         ;; source-map entry. Store the bytes actually consumed, not a later reread.
         (let [embedded (.artifact_inputs (loader-unit-state))]
           (unless (= (cast i64 embedded) 0)
             (for [i 0 (len (load embedded))]
               (let [input (al-elem [LoaderArtifactInput] embedded i)]
                 (push! (mut inputs)
                        (ArtifactInput :path (.path input)
                          :digest (artifact-bytes-digest a (.text input)))))
               0)
             0))
         (try! (artifact-validate-inputs a (mut inputs)))
         (Ok (artifact-inputs-sorted a (mut inputs))))))

;; No shell command strings: paths and each normalized linker argument remain
;; distinct argv elements. This subprocess is only the native system linker, not
;; a generated-unit or metaprogram compilation worker.
(defn provider-link [(a (dyn Allocator)) (object (slice u8)) (image (slice u8))] (-> bool)
  (let [(mut args) (al-new [(ptr i8)] a)
        links (meta-link-box)
        status (p/alloc-stack i32)]
    (push! (mut args) c"cc")
    (push! (mut args) (if (me-host-linux?) c"-shared" c"-dynamiclib"))
    (push! (mut args) (str->cstr a object))
    (push! (mut args) c"-o")
    (push! (mut args) (str->cstr a image))
    (unless (me-host-linux?)
      (push! (mut args) c"-Wl,-undefined,dynamic_lookup")
      0)
    (when (!= (.isset links) 0)
      (for [i 0 (len (load (.flags links)))]
        (push! (mut args) (str->cstr a (get (load (.flags links)) i)))
        0)
      0)
    (push! (mut args) (cast (ptr i8) 0))
    (let [pid (os/spawn c"cc" (.data args) (os/spawn-envp))]
      (if (< pid 0)
          false
          (do
            (store! status -1)
            (and (= (os/waitpid (cast i32 pid) status 0) (cast i32 pid))
                 (= (load status) (cast i32 0))))))))

(defn provider-clean-staging! [(a (dyn Allocator)) (directory (slice u8))] (-> i64)
  (unlink (str->cstr a (sconcat a directory "/unit.o")))
  (unlink (str->cstr a (sconcat3 a directory "/image" (me-dylib-ext))))
  (unlink (str->cstr a (sconcat a directory "/metadata")))
  (rmdir (str->cstr a directory))
  0)

;; A cache hit is a complete, validated immutable artifact, never the existence
;; of a directory alone. The same check handles a concurrent publisher winning
;; the final rename; malformed existing entries are not overwritten implicitly.
(defn provider-reuse [(a (dyn Allocator))
                      (directory (slice u8))
                      (expected (ptr ProviderMetadata))] (-> (Result (slice u8)
                                                                     Diag))
  (try (let [bytes
               (try! (provider-read-bytes a (sconcat a directory "/metadata")))
             m (try! (wire-provider a bytes))]
         (unless (and (= (.key m) (.key expected))
                      (= (.key m)
                         (artifact-key a
                                       (.provider m)
                                       (.entry m)
                                       (.sdk m)
                                       (.host m)
                                       (.target m)
                                       (.options m)
                                       (.inputs m))))
           (return-from :try
                          (Err [(slice u8) Diag]
                               (artifact-error "existing provider artifact identity mismatch"))))
         (try! (artifact-validate-inputs a (.inputs m)))
         (unless (= (.image_digest m)
                    (try! (artifact-file-digest a
                                                (sconcat3 a
                                                          directory
                                                          "/image"
                                                          (me-dylib-ext)))))
           (return-from :try
                          (Err [(slice u8) Diag]
                               (artifact-error "existing provider artifact native image digest mismatch"))))
         (Ok directory))))

(defn provider-publish-stage [(a (dyn Allocator))
                              (m (ptr ProviderMetadata))
                              (mp (ptr Program))
                              (directory (slice u8))
                              (destination (slice u8))] (-> (Result (slice u8)
                                                                    Diag))
  (try (let [object (sconcat a directory "/unit.o")
             image (sconcat3 a directory "/image" (me-dylib-ext))
             builder (meta-build-box)]
         (when (= (.isset builder) 0)
           (return-from :try
                          (Err [(slice u8) Diag]
                               (artifact-error "this compiler cannot build native provider artifacts"))))
         (when (!= (p/call-ptr (.fp builder) a mp (str->cstr a object)) 0)
           (return-from :try
                          (Err [(slice u8) Diag]
                               (artifact-error "provider object emission failed"))))
         (unless (provider-link a object image)
           (return-from :try
                          (Err [(slice u8) Diag]
                               (artifact-error "provider native linking failed"))))
         (set! (.image_digest m) (try! (artifact-file-digest a image)))
         (try! (artifact-validate-inputs a (.inputs m)))
         (let [bytes (try! (wire-put-provider a m))]
           (match (fs/write-file a (sconcat a directory "/metadata") bytes)
             (Err [_]
                  (return-from :try
                                 (Err [(slice u8) Diag]
                                      (artifact-error "cannot write provider metadata"))))
             (Ok [_] 0)))
         (unlink (str->cstr a object))
         (if (= (rename (str->cstr a directory) (str->cstr a destination))
                (cast i32 0))
             (Ok [(slice u8) Diag] destination)
             (if (= (access (str->cstr a destination) 0) (cast i32 0))
                 (provider-reuse a destination m)
                 (Err [(slice u8) Diag]
                      (artifact-error "cannot publish provider artifact into the selected root")))))))

;; The caller supplies an existing output root. Publish the complete immutable
;; pair with one directory rename. Failed builds never expose a loadable manifest.
(defn provider-publish [(a (dyn Allocator))
                        (m (ptr ProviderMetadata))
                        (lowered (ptr MLOut))
                        (root (slice u8))] (-> (Result (slice u8) Diag))
  (try (let [destination (sconcat3 a root "/" (.key m))
             template (str->cstr a (sconcat a root "/.provider-XXXXXX"))]
         (when (= (access (str->cstr a destination) 0) (cast i32 0))
           (return-from :try (provider-reuse a destination m)))
         (let [mp (try! (monomorphize a (.prog lowered)))]
           ;; Only now are generic and trait calls concrete. The plugin exports exactly
           ;; its entry and ABI handshake; other functions are private implementation.
           (set! (.impls mp) (box-al [ImplDef] a (al-new [ImplDef] a)))
           (let [(mut seeds) (al-new [(slice u8)] a)
                 (mut functions) (al-new [Func] a)]
             (push! (mut seeds) (.entry m))
             (push! (mut seeds) "coil.compiler.metashim.mp-init")
             (let [wanted (closure-funcs mp (mut seeds) a)]
               (for [i 0 (len (load (.restricted lowered)))]
                 (let [site (al-elem [MLRestricted] (.restricted lowered) i)]
                   (when (set-contains wanted (.name site))
                     (return-from :try (Err [(slice u8) Diag] (.diag site)))))
                 0)
               (for [i 0 (len (load (.funcs mp)))]
                 (let [function (al-elem [Func] (.funcs mp) i)]
                   (when (set-contains wanted (.name function))
                     (push! (mut functions) (load function))
                     0))
                 0)
               (set! (.funcs mp) (box-al [Func] a (load functions)))))
           (sort-mono-program a mp)
           (when (= (cast i64 (mkdtemp template)) 0)
             (return-from :try
                            (Err [(slice u8) Diag]
                                 (artifact-error "cannot create provider staging directory; output root must exist"))))
           (let [directory (cstr->slice template)
                 result (provider-publish-stage a m mp directory destination)]
             (provider-clean-staging! a directory)
             result)))))

(defn provider-build [(a (dyn Allocator))
                      (setup (ptr LS))
                      (checked (ptr Program))
                      (module (slice u8))
                      (qual (slice u8))
                      (options (slice u8))
                      (root (slice u8))] (-> (Result (slice u8) Diag))
  (try (let [prepared (try! (prepare-read-program a (mut setup) checked qual))
             entry prepared
             m (box! a ProviderMetadata (p/zeroed ProviderMetadata))
             prior (p/alloc-stack SemMapsSnap)
             (mut quals) (al-new [(slice u8)] a)]
         (sem-maps-save prior)
         (sem-maps-restore (.maps entry))
         (push! (mut quals) qual)
         (let [lowered
                 (metalower-program-mode a (.program entry) (mut quals) true)]
           (sem-maps-restore prior)
           (let [mo (try! lowered)]
             (set! (.provider m) module)
             (set! (.entry m) qual)
             (set! (.symbol m) "coil_mp_0")
             (set! (.sdk m) (try! (provider-sdk a)))
             (set! (.host m) (provider-host))
             (set! (.target m) (provider-target a))
             (set! (.options m) options)
             (set! (.inputs m) (try! (provider-inputs a setup)))
             (set! (.key m)
                   (artifact-key a
                                 module
                                 qual
                                 (.sdk m)
                                 (.host m)
                                 (.target m)
                                 options
                                 (.inputs m)))
             (set! (.setup m) setup)
             (set! (.names m) (prog-fn-names (.program entry) a))
             (set! (.registry m) (.registry mo))
             (sem-maps-restore (.maps entry))
             (let [result (provider-publish a m mo root)]
               (sem-maps-restore prior)
               result))))))

(defstruct LoadedProvider [(metadata (ptr ProviderMetadata)) (fp (ptr i8))])

(defn provider-check-node [(s (ptr Sexp))
                           (sources i64)
                           (contexts i64)
                           (max-nid (ptr i64))
                           (max-hyg (ptr i64))] (-> bool)
  (block :validate
         (when (or (< (.source s) -1)
                   (or (>= (.source s) sources)
                       (or (< (.ctxt s) 0)
                           (or (> (.ctxt s) contexts)
                               (or (< (.nid s) 0)
                                   (or (> (.nid s) 0x3fffffffffffffff)
                                       (> (.hyg s) 0x3fffffffffffffff)))))))
           (return-from :validate false))
         (when (> (.nid s) (load max-nid)) (store! max-nid (.nid s)) 0)
         (when (> (.hyg s) (load max-hyg)) (store! max-hyg (.hyg s)) 0)
         (when (or (= (sx-tag (load s)) 6) (= (sx-tag (load s)) 7))
           (let [xs (sx-items (load s))]
             (for [i 0 (len (load xs))]
               (unless (provider-check-node (al-elem [Sexp] xs i)
                                            sources
                                            contexts
                                            max-nid
                                            max-hyg)
                 (return-from :validate false))
               0))
           0)
         true))

(defn provider-rebase-node! [(s (ptr Sexp)) (nid-base i64) (hyg-base i64)] (-> i64)
  (when (> (.nid s) 0) (set! (.nid s) (+ (.nid s) nid-base)) 0)
  (when (> (.hyg s) 0) (set! (.hyg s) (+ (.hyg s) hyg-base)) 0)
  (when (or (= (sx-tag (load s)) 6) (= (sx-tag (load s)) 7))
    (let [xs (sx-items (load s))]
      (for [i 0 (len (load xs))]
        (provider-rebase-node! (al-elem [Sexp] xs i) nid-base hyg-base)
        0))
    0)
  0)

(defn provider-open [(a (dyn Allocator))
                     (directory (slice u8))
                     (options (slice u8))] (-> (Result LoadedProvider Diag))
  (try (let [bytes
               (try! (provider-read-bytes a (sconcat a directory "/metadata")))
             m (try! (wire-provider a bytes))
             sdk (try! (provider-sdk a))
             image (sconcat3 a directory "/image" (me-dylib-ext))
             max-nid (p/alloc-stack i64)
             max-hyg (p/alloc-stack i64)]
         (unless (and (= (.sdk m) sdk)
                      (and (= (.host m) (provider-host))
                           (and (= (.target m) (provider-target a))
                                (= (.options m) options))))
           (return-from :try
                          (Err [LoadedProvider Diag]
                               (artifact-error "stale provider artifact: compiler SDK, target or configuration differs; rebuild the provider"))))
         (unless (= (.key m)
                    (artifact-key a
                                  (.provider m)
                                  (.entry m)
                                  sdk
                                  (.host m)
                                  (.target m)
                                  options
                                  (.inputs m)))
           (return-from :try
                          (Err [LoadedProvider Diag]
                               (artifact-error "provider artifact identity does not match its metadata"))))
         (try! (artifact-validate-inputs a (.inputs m)))
         (unless (= (.image_digest m) (try! (artifact-file-digest a image)))
           (return-from :try
                          (Err [LoadedProvider Diag]
                               (artifact-error "provider artifact native image digest mismatch"))))
         (store! max-nid 0)
         (store! max-hyg 0)
         (for [i 0 (len (load (.registry m)))]
           (unless (provider-check-node (get (load (.registry m)) i)
                                        (len (.sources (.setup m)))
                                        (len (.expansions (.setup m)))
                                        max-nid
                                        max-hyg)
             (return-from :try
                            (Err [LoadedProvider Diag]
                                 (artifact-error "invalid provider artifact syntax provenance"))))
           0)
         (let [nid-base (.n (nid-cell))
               hyg-base (.n (gensym-cell))]
           (when (or (> nid-base (- 0x7fffffffffffffff (load max-nid)))
                     (> hyg-base (- 0x7fffffffffffffff (load max-hyg))))
             (return-from :try
                            (Err [LoadedProvider Diag]
                                 (artifact-error "provider artifact syntax identity space exhausted"))))
           (for [i 0 (len (load (.registry m)))]
             (provider-rebase-node! (get (load (.registry m)) i)
                                    nid-base
                                    hyg-base)
             0)
           (set! (.n (nid-cell)) (+ nid-base (load max-nid)))
           (set! (.n (gensym-cell)) (+ hyg-base (load max-hyg))))
         (let [handle (try! (me-open-dylib a image))
               fp (dlsym handle (str->cstr a (.symbol m)))]
           (if (= (cast i64 fp) 0)
               (Err [LoadedProvider Diag]
                    (artifact-error "provider artifact entry symbol missing"))
               (Ok (LoadedProvider :metadata m :fp fp)))))))

(defn provider-invoke-inner [(a (dyn Allocator))
                             (provider (ptr LoadedProvider))
                             (context Sexp)
                             (code-session-state (ptr i8))] (-> ReadProviderResult)
  (let [m (.metadata provider)
        cx (p/alloc-stack CtCtx)
        prior-sources (load (src-box))
        (mut args) (al-new [Sexp] a)
        engine (p/alloc-stack MetaEngineScope)]
    (store! cx (p/zeroed CtCtx))
    (set! (.a cx) a)
    (set! (.fuel cx) 50000000)
    (set! (.fns cx) (box-al [Func] a (al-new [Func] a)))
    (set! (.structs cx) (box-al [StructDef] a (al-new [StructDef] a)))
    (set! (.sums cx) (box-al [SumDef] a (al-new [SumDef] a)))
    (set! (.traits cx) (box-al [TraitDef] a (al-new [TraitDef] a)))
    (set! (.variants cx) (box-al [(slice u8)] a (al-new [(slice u8)] a)))
    (set! (.qmodule cx) (Some (.provider m)))
    (set! (.module_fns cx) (.names m))
    (set! (.qexports cx) (field (.setup m) exports))
    (let [imp (imports-find (field (.setup m) imports) (.provider m))]
      (unless (= (cast i64 imp) 0) (set! (.qimports cx) (field imp imp)) 0))
    (set! (.code_session_state cx) code-session-state)
    (set! (.lst (src-box)) (field (.setup m) sources))
    (push! (mut args) context)
    (meta-engine-scope-enter! engine a)
    (let [result
            (meta-engine-invoke a (.fp provider) (.registry m) cx (mut args))]
      (meta-engine-scope-leave! engine)
      (set! (src-box) prior-sources)
      (match result (Err [d] (ReadFailed d)) (Ok [forms] (ReadForms forms))))))

;; Match ordinary expansion ownership: transient provider allocations die on
;; return; only the returned syntax/diagnostic and explicitly submitted generated
;; bodies are promoted. Artifact metadata and image remain unit-owned.
(defn provider-invoke [(a (dyn Allocator))
                       (provider (ptr LoadedProvider))
                       (context Sexp)
                       (code-session-state (ptr i8))] (-> ReadProviderResult)
  (let [arena (p/alloc-stack scratch/ScratchArena)]
    (scratch/scratch-init-with-cap arena (malloc-allocator) 262144)
    (let [result
            (provider-invoke-inner (scratch/scratch-allocator arena)
                                   provider
                                   context
                                   code-session-state)
          promoted
            (match result
              (ReadDefault [] (ReadDefault))
              (ReadFailed [d]
                          (let [diag (box! a Diag d)]
                            (set! (.msg diag) (sconcat a (.msg diag) ""))
                            (ReadFailed (load diag))))
              (ReadForms [form]
                         (let [node (p/alloc-stack Sexp)]
                           (store! node form)
                           (ReadForms (promote-sexp-from-arena a arena node)))))]
      (when (= (em-arena-mode) 2) (em-poison-arena! arena) 0)
      (scratch/scratch-close! arena)
      promoted)))
