(import "coil.compiler.artifact_wire" :use *)
(import "coil.compiler.unit_state" :use *)

;; Host image compatibility is additionally pinned by the digest of the running
;; compiler binary. Native images are executable plugins and must be trusted in
;; the same way as the source provider used to construct them.
(defn provider-sdk [(a (dyn Allocator))] (-> (Result (slice u8) Diag))
  (artifact-file-digest a (self-command-path a)))

(defn provider-host [] (-> (slice u8))
  (if (me-host-linux?) "native-linux" "native-darwin"))

(defn provider-target [(a (dyn Allocator))] (-> (slice u8))
  (let [triple (target-triple)]
    (if (= (cast i64 triple) 0)
        (sconcat3 a (target-arch-str) "-" (target-os-str))
        (from-cstr triple))))

(defn provider-read-bytes [(a (dyn Allocator)) (path (slice u8))] (-> (Result (slice u8)
                                                                              Diag))
  (try (let [opened
               (try-or! (fs/File::open (to-cstr a path) fs/O_RDONLY 0)
                        (Err (artifact-error (sconcat a
                                                      "cannot open provider metadata: "
                                                      path))))]
         (let [(mut file) (: opened fs/File)
               (mut reader) (zeroed io/Reader)
               (mut buffer) (zeroed (array u8 4096))
               (mut bytes) (StrBuf::new a)]
           (fs/File::reader (mut reader) (mut file))
           (let [result
                   (block :read
                          (loop (match (io/read-some (mut reader)
                                                     (cast (ptr i8)
                                                           (mut buffer))
                                                     4096)
                                  (Err [_]
                                       (return-from :read
                                                      (Err [(slice u8) Diag]
                                                           (artifact-error "cannot read provider metadata"))))
                                  (Ok [n]
                                      (when (= n 0)
                                        (return-from :read
                                                       (Ok [(slice u8) Diag]
                                                           (str (load bytes)))))
                                      (when (> (+ (len (str (load bytes))) n)
                                               67108864)
                                        (return-from :read
                                                       (Err [(slice u8) Diag]
                                                            (artifact-error "provider metadata exceeds 64 MiB limit"))))
                                      (push-str! (mut bytes)
                                                 (slice::new (cast (ptr u8)
                                                                   (mut buffer))
                                                             n))))
                            0)
                          (Err [(slice u8) Diag]
                               (artifact-error "provider metadata read did not finish")))]
             (close (mut file))
             result)))))

(defn provider-inputs [(a (dyn Allocator)) (setup (ptr LS))] (-> (Result (ptr (ArrayList ArtifactInput))
                                                                         Diag))
  (try (let [(mut inputs) (ArrayList::new [ArtifactInput] a)
             (mut seen) (ArrayList::new [(slice u8)] a)
             layout (stdlib-layout a)]
         ;; The source table includes the implicit prelude, which the import memo does
         ;; not. Resolve bundled display names using the exact active toolchain layout.
         ;; The compiler writes the text of the synthetic sources itself (a `--use`
         ;; list is part of the options), so the compiler's own digest covers them.
         (for [i 0 (len (.sources setup))]
           (let [display (.name (elem (field setup sources) i))
                 path
                   (cond (or (= display "<read setup>")
                             (= display "<lint rules>")
                             (= display "<cli-use>")
                             (= display "<metashim>")
                             (starts-with display "<core-provider "))
                           ""
                         (= display "<prelude>") (.prelude layout)
                         (starts-with display "<bundled ")
                           (let [bn (subslice display 9 (- (len display) 1))
                                 sdk (starts-with bn "compiler/")]
                             (path-join a
                                        (if sdk (.sdk layout) (.libs layout))
                                        (if sdk (subslice bn 9 (len bn)) bn)))
                         :else display)]
             (unless (or (= path "") (set-contains (mut seen) path))
               (let [digest
                       (artifact-bytes-digest a
                                              (.text (elem (field setup
                                                                  sources)
                                                           i)))]
                 (push! (mut inputs) (ArtifactInput :path path :digest digest))
                 (push! (mut seen) path))
               0))
           0)
         ;; include-str is a real dependency even though it introduces no module or
         ;; source-map entry. Store the bytes actually consumed, not a later reread.
         (let [embedded (.artifact_inputs (loader-unit-state))]
           (unless (= (cast i64 embedded) 0)
             (for [i 0 (len (load embedded))]
               (let [input (elem embedded i)]
                 (push! (mut inputs)
                        (ArtifactInput :path (.path input)
                          :digest (artifact-bytes-digest a (.text input)))))
               0)
             0))
         (try! (artifact-validate-inputs a (mut inputs)))
         (Ok (artifact-inputs-sorted a (mut inputs))))))

;; No shell command strings: paths and each normalized linker argument remain
;; distinct argv elements. This subprocess is only the native system linker, not
;; a generated-unit or metaprogram compilation worker.
(defn provider-link [(a (dyn Allocator)) (object (slice u8)) (image (slice u8))] (-> bool)
  (let [(mut args) (ArrayList::new [(ptr i8)] a)
        links (meta-link-box)
        (mut status) (zeroed i32)]
    (push! (mut args) c"cc")
    (push! (mut args) (if (me-host-linux?) c"-shared" c"-dynamiclib"))
    (push! (mut args) (to-cstr a object))
    (push! (mut args) c"-o")
    (push! (mut args) (to-cstr a image))
    (unless (me-host-linux?)
      (push! (mut args) c"-Wl,-undefined,dynamic_lookup")
      0)
    (when (!= (.isset links) 0)
      (for [i 0 (len (load (.flags links)))]
        (push! (mut args) (to-cstr a (get (load (.flags links)) i)))
        0)
      0)
    (push! (mut args) (cast (ptr i8) 0))
    (let [pid (os/spawn c"cc" (.data args) (os/spawn-envp))]
      (if (< pid 0)
          false
          (do
            (set! status -1)
            (and (= (os/waitpid (cast i32 pid) (mut status) 0) (cast i32 pid))
                 (= status (: 0 i32))))))))

;; A cache hit is a complete, validated immutable artifact, never the existence
;; of a directory alone. The same check handles a concurrent publisher winning
;; the final rename; malformed existing entries are not overwritten implicitly.
(defn provider-reuse [(a (dyn Allocator))
                      (directory (slice u8))
                      (expected (ptr ProviderMetadata))] (-> (Result (slice u8)
                                                                     Diag))
  (try (let [bytes
               (try! (provider-read-bytes a (sconcat a directory "/metadata")))
             m (try! (wire-provider a bytes))]
         (unless (and (= (.key m) (.key expected))
                      (= (.key m)
                         (artifact-key a
                                       (.provider m)
                                       (.entry m)
                                       (.sdk m)
                                       (.host m)
                                       (.target m)
                                       (.options m)
                                       (.inputs m))))
           (return-from :try
                          (Err [(slice u8) Diag]
                               (artifact-error "existing provider artifact identity mismatch"))))
         (try! (artifact-validate-inputs a (.inputs m)))
         (unless (= (.image_digest m)
                    (try! (artifact-file-digest a
                                                (sconcat3 a
                                                          directory
                                                          "/image"
                                                          (me-dylib-ext)))))
           (return-from :try
                          (Err [(slice u8) Diag]
                               (artifact-error "existing provider artifact native image digest mismatch"))))
         (Ok directory))))

(defn provider-publish-stage [(a (dyn Allocator))
                              (m (ptr ProviderMetadata))
                              (mp (ptr Program))
                              (directory (slice u8))
                              (destination (slice u8))] (-> (Result (slice u8)
                                                                    Diag))
  (try (do
         (set! (.image_digest m) (try! (provider-emit-image a mp directory)))
         (try! (artifact-validate-inputs a (.inputs m)))
         (let [bytes (try! (wire-put-provider a m))]
           (match (fs/write-file a (sconcat a directory "/metadata") bytes)
             (Err [_]
                  (return-from :try
                                 (Err [(slice u8) Diag]
                                      (artifact-error "cannot write provider metadata"))))
             (Ok [_] 0)))
         (if (= (rename (to-cstr a directory) (to-cstr a destination))
                (: 0 i32))
             (Ok [(slice u8) Diag] destination)
             (if (= (access (to-cstr a destination) 0) (: 0 i32))
                 (provider-reuse a destination m)
                 (Err [(slice u8) Diag]
                      (artifact-error "cannot publish provider artifact into the selected root")))))))

;; Emit MP, a monomorphized image program, as DIRECTORY/image<ext>: an object
;; linked into the native plugin, the object then removed. The image's digest.
(defn provider-emit-image [(a (dyn Allocator))
                           (mp (ptr Program))
                           (directory (slice u8))] (-> (Result (slice u8) Diag))
  (try (let [object (sconcat a directory "/unit.o")
             image (sconcat3 a directory "/image" (me-dylib-ext))
             builder (meta-build-box)]
         (when (= (.isset builder) 0)
           (return-from :try
                          (Err [(slice u8) Diag]
                               (artifact-error "this compiler cannot build native provider artifacts"))))
         (when (!= (call-ptr (.fp builder) a mp (to-cstr a object)) 0)
           (return-from :try
                          (Err [(slice u8) Diag]
                               (artifact-error "provider object emission failed"))))
         (unless (provider-link a object image)
           (return-from :try
                          (Err [(slice u8) Diag]
                               (artifact-error "provider native linking failed"))))
         (unlink (to-cstr a object))
         (artifact-file-digest a image))))

;; LOWERED's program, monomorphized and pruned to what SEEDS reach. Only now are
;; generic and trait calls concrete. The plugin exports exactly its entries and
;; the ABI handshake (metashim's mp-init, always a seed here); every other function
;; is private implementation. A seed that reaches a function the lowering
;; restricted is that restriction's error.
(defn provider-image-program [(a (dyn Allocator))
                              (lowered (ptr MLOut))
                              (entries (ptr (ArrayList (slice u8))))] (-> (Result (ptr Program)
                                                                                 Diag))
  (try (let [mp (try! (monomorphize a (.prog lowered)))]
         (set! (.impls mp) (box-al [ImplDef] a (ArrayList::new [ImplDef] a)))
         (let [(mut seeds) (ArrayList::new [(slice u8)] a)
               (mut functions) (ArrayList::new [Func] a)]
           (for [i 0 (len (load entries))] (push! (mut seeds) (get (load entries) i)) 0)
           (push! (mut seeds) "coil.compiler.metashim.mp-init")
           (let [wanted (closure-funcs mp (mut seeds) a)]
             (for [i 0 (len (load (.restricted lowered)))]
               (let [site (elem (.restricted lowered) i)]
                 (when (set-contains wanted (.name site))
                   (return-from :try (Err [(ptr Program) Diag] (.diag site)))))
               0)
             (for [i 0 (len (load (.funcs mp)))]
               (let [function (elem (.funcs mp) i)]
                 (when (set-contains wanted (.name function))
                   (push! (mut functions) (load function))
                   0))
               0)
             (set! (.funcs mp) (box-al [Func] a (load functions)))))
         (sort-mono-program a mp)
         (Ok mp))))

;; The caller supplies an existing output root. Publish the complete immutable
;; pair with one directory rename. Failed builds never expose a loadable manifest.
(defn provider-publish [(a (dyn Allocator))
                        (m (ptr ProviderMetadata))
                        (lowered (ptr MLOut))
                        (root (slice u8))] (-> (Result (slice u8) Diag))
  (try (let [destination (sconcat3 a root "/" (.key m))]
         (when (= (access (to-cstr a destination) 0) (: 0 i32))
           (return-from :try (provider-reuse a destination m)))
         (let [(mut entries) (ArrayList::new [(slice u8)] a)]
           (push! (mut entries) (.entry m))
           (let [mp (try! (provider-image-program a lowered (box-al [(slice u8)] a (load entries))))
                 ;; Staged beside the destination, so publishing is one rename on one
                 ;; filesystem; a coil.temp name, so a build that dies leaves nothing for long.
                 directory
                   (match (temp/sibling destination)
                     (Ok [p] p)
                     (Err [e]
                          (return-from :try
                                         (Err [(slice u8) Diag]
                                              (artifact-error (text e))))))]
             (when (!= (fs/make-dir (to-cstr a directory) 448) (: 0 i32))
               (return-from :try
                              (Err [(slice u8) Diag]
                                   (artifact-error "cannot create provider staging directory; output root must exist"))))
             (let [result (provider-publish-stage a m mp directory destination)]
               (temp/remove! directory)
               result))))))

(defn provider-build [(a (dyn Allocator))
                      (setup (ptr LS))
                      (checked (ptr Program))
                      (module (slice u8))
                      (qual (slice u8))
                      (options (slice u8))
                      (root (slice u8))] (-> (Result (slice u8) Diag))
  (try (let [prepared (try! (prepare-read-program a (mut setup) checked qual))
             entry prepared
             m (box! a ProviderMetadata (zeroed ProviderMetadata))
             (mut prior) (zeroed SemMapsSnap)
             (mut quals) (ArrayList::new [(slice u8)] a)]
         (sem-maps-save (mut prior))
         (sem-maps-restore (.maps entry))
         (push! (mut quals) qual)
         (let [lowered
                 (metalower-program-mode a (.program entry) (mut quals) true)]
           (sem-maps-restore (mut prior))
           (let [mo (try! lowered)]
             (set! (.provider m) module)
             (set! (.entry m) qual)
             (set! (.symbol m) "coil_mp_0")
             (set! (.sdk m) (try! (provider-sdk a)))
             (set! (.host m) (provider-host))
             (set! (.target m) (provider-target a))
             (set! (.options m) options)
             (set! (.inputs m) (try! (provider-inputs a setup)))
             (set! (.key m)
                   (artifact-key a
                                 module
                                 qual
                                 (.sdk m)
                                 (.host m)
                                 (.target m)
                                 options
                                 (.inputs m)))
             (set! (.setup m) setup)
             (set! (.names m) (field (prog-fn-names (.program entry) a) items))
             (set! (.registry m) (.registry mo))
             (sem-maps-restore (.maps entry))
             (let [result (provider-publish a m mo root)]
               (sem-maps-restore (mut prior))
               result))))))

(defstruct LoadedProvider [(metadata (ptr ProviderMetadata)) (fp (ptr i8))])

(defn provider-check-node [(s (ptr Sexp))
                           (sources i64)
                           (contexts i64)
                           (max-node-id (ptr i64))
                           (max-hyg (ptr i64))] (-> bool)
  (block :validate
         (when (or (< (.source s) -1)
                   (>= (.source s) sources)
                   (< (.ctxt s) 0)
                   (> (.ctxt s) contexts)
                   (< (.node-id s) 0)
                   (> (.node-id s) 0x3fffffffffffffff)
                   (> (.hyg s) 0x3fffffffffffffff))
           (return-from :validate false))
         (when (> (.node-id s) (load max-node-id))
           (store! max-node-id (.node-id s))
           0)
         (when (> (.hyg s) (load max-hyg)) (store! max-hyg (.hyg s)) 0)
         (when (or (= (sx-tag (load s)) 6) (= (sx-tag (load s)) 7))
           (let [xs (sx-items (load s))]
             (for [i 0 (len (load xs))]
               (unless (provider-check-node (elem xs i)
                                            sources
                                            contexts
                                            max-node-id
                                            max-hyg)
                 (return-from :validate false))
               0))
           0)
         true))

(defn provider-rebase-node! [(s (ptr Sexp)) (node-id-base i64) (hyg-base i64)] (-> i64)
  (when (> (.node-id s) 0) (set! (.node-id s) (+ (.node-id s) node-id-base)) 0)
  (when (> (.hyg s) 0) (set! (.hyg s) (+ (.hyg s) hyg-base)) 0)
  (when (or (= (sx-tag (load s)) 6) (= (sx-tag (load s)) 7))
    (let [xs (sx-items (load s))]
      (for [i 0 (len (load xs))]
        (provider-rebase-node! (elem xs i) node-id-base hyg-base)
        0))
    0)
  0)

;; Take REGISTRY, an artifact's quoted syntax, into this process: check that its
;; provenance stays within the SOURCES and CONTEXTS of the compilation that built
;; it, then move its node ids and hygiene marks past every one this process has
;; handed out, so none collides with syntax read here.
(defn provider-registry-adopt! [(registry (ptr (ArrayList (ptr Sexp))))
                                (sources i64)
                                (contexts i64)] (-> (Result i64 Diag))
  (let [(mut max-node-id) 0
        (mut max-hyg) 0]
    (block :adopt
           (for [i 0 (len (load registry))]
             (unless (provider-check-node (get (load registry) i)
                                          sources
                                          contexts
                                          (mut max-node-id)
                                          (mut max-hyg))
               (return-from :adopt
                              (Err [i64 Diag]
                                   (artifact-error "invalid provider artifact syntax provenance"))))
             0)
           (let [node-id-base (.n (node-id-cell))
                 hyg-base (.n (gensym-cell))]
             (when (or (> node-id-base (- 0x7fffffffffffffff (load max-node-id)))
                       (> hyg-base (- 0x7fffffffffffffff (load max-hyg))))
               (return-from :adopt
                              (Err [i64 Diag]
                                   (artifact-error "provider artifact syntax identity space exhausted"))))
             (for [i 0 (len (load registry))]
               (provider-rebase-node! (get (load registry) i) node-id-base hyg-base)
               0)
             (set! (.n (node-id-cell)) (+ node-id-base (load max-node-id)))
             (set! (.n (gensym-cell)) (+ hyg-base (load max-hyg)))
             (Ok [i64 Diag] 0)))))

(defn provider-open [(a (dyn Allocator))
                     (directory (slice u8))
                     (options (slice u8))] (-> (Result LoadedProvider Diag))
  (try (let [bytes
               (try! (provider-read-bytes a (sconcat a directory "/metadata")))
             m (try! (wire-provider a bytes))
             sdk (try! (provider-sdk a))
             image (sconcat3 a directory "/image" (me-dylib-ext))]
         (unless (and (= (.sdk m) sdk)
                      (and (= (.host m) (provider-host))
                           (and (= (.target m) (provider-target a))
                                (= (.options m) options))))
           (return-from :try
                          (Err [LoadedProvider Diag]
                               (artifact-error "stale provider artifact: compiler SDK, target or configuration differs; rebuild the provider"))))
         (unless (= (.key m)
                    (artifact-key a
                                  (.provider m)
                                  (.entry m)
                                  sdk
                                  (.host m)
                                  (.target m)
                                  options
                                  (.inputs m)))
           (return-from :try
                          (Err [LoadedProvider Diag]
                               (artifact-error "provider artifact identity does not match its metadata"))))
         (try! (artifact-validate-inputs a (.inputs m)))
         (unless (= (.image_digest m) (try! (artifact-file-digest a image)))
           (return-from :try
                          (Err [LoadedProvider Diag]
                               (artifact-error "provider artifact native image digest mismatch"))))
         (try! (provider-registry-adopt! (.registry m)
                                         (len (.sources (.setup m)))
                                         (len (.expansions (.setup m)))))
         (let [handle (try! (me-open-dylib a image (.registry m)))
               fp (dlsym handle (to-cstr a (.symbol m)))]
           (if (= (cast i64 fp) 0)
               (Err [LoadedProvider Diag]
                    (artifact-error "provider artifact entry symbol missing"))
               (Ok (LoadedProvider :metadata m :fp fp)))))))

(defn provider-invoke-inner [(a (dyn Allocator))
                             (provider (ptr LoadedProvider))
                             (context Sexp)
                             (code-session-state (ptr i8))] (-> ReadProviderResult)
  (let [m (.metadata provider)
        cx (p/alloc-stack CtCtx)
        prior-sources (load (src-box))
        (mut args) (ArrayList::new [Sexp] a)
        engine (p/alloc-stack MetaEngineScope)]
    (set! cx (zeroed CtCtx))
    (set! (.a cx) a)
    (set! (.fuel cx) 50000000)
    (set! (.fns cx) (box-al [Func] a (ArrayList::new [Func] a)))
    (set! (.structs cx) (box-al [StructDef] a (ArrayList::new [StructDef] a)))
    (set! (.sums cx) (box-al [SumDef] a (ArrayList::new [SumDef] a)))
    (set! (.traits cx) (box-al [TraitDef] a (ArrayList::new [TraitDef] a)))
    (set! (.qmodule cx) (Some (.provider m)))
    (set! (.module_fns cx) (.names m))
    (set! (.qexports cx) (field (.setup m) exports))
    (let [imp (imports-find (field (.setup m) imports) (.provider m))]
      (unless (= (cast i64 imp) 0) (set! (.qimports cx) (field imp imp)) 0))
    (set! (.code_session_state cx) code-session-state)
    (set! (.expansions cx) (field (.setup m) expansions))
    (set! (.lst (src-box)) (field (.setup m) sources))
    (push! (mut args) context)
    (meta-engine-scope-enter! engine a)
    (let [result
            (meta-engine-invoke a (.fp provider) (.registry m) cx (mut args))]
      (meta-engine-scope-leave! engine)
      (set! (src-box) prior-sources)
      (match result (Err [d] (ReadFailed d)) (Ok [forms] (ReadForms forms))))))

;; Match ordinary expansion ownership: transient provider allocations die on
;; return; only the returned syntax/diagnostic and explicitly submitted generated
;; bodies are promoted. Artifact metadata and image remain unit-owned.
(defn provider-invoke [(a (dyn Allocator))
                       (provider (ptr LoadedProvider))
                       (context Sexp)
                       (code-session-state (ptr i8))] (-> ReadProviderResult)
  (let [(mut arena) (zeroed scratch/ScratchArena)]
    (scratch/ScratchArena::init-with-capacity (mut arena)
                                              (retained-heap/compiler-scratch-parent)
                                              262144)
    (let [result
            (provider-invoke-inner (allocator (mut arena))
                                   provider
                                   context
                                   code-session-state)
          promoted
            (match result
              (ReadDefault [] (ReadDefault))
              (ReadFailed [d]
                          (let [diag (box! a Diag d)]
                            (set! (.msg diag) (sconcat a (.msg diag) ""))
                            (ReadFailed (load diag))))
              (ReadForms [form]
                         (let [(mut node) form]
                           (ReadForms (promote-sexp-from-arena a
                                                               (mut arena)
                                                               (mut node))))))]
      (when (= (em-arena-mode) 2) (em-poison-arena! (mut arena)) 0)
      (close! (mut arena))
      promoted)))

;; ---- checker profiles --------------------------------------------------------
;; A checker profile is a fixed module's registered checkers compiled once into a
;; native image. A command that runs them loads the image instead of compiling the
;; module and everything it imports. Its identity is a provider artifact's: this
;; compiler's binary, the host, target and options, and every source the
;; compilation read, by digest.

(defstruct LoadedProfile
  [(metadata (ptr ProfileMetadata))
   ;; The native entry of each of `metadata`'s entries, in order.
   (fps (ptr (ArrayList (ptr i8))))])

(defn profile-key [(a (dyn Allocator)) (m (ptr ProfileMetadata))] (-> (slice u8))
  (let [(mut entries) (StrBuf::new a)]
    (for [i 0 (len (load (.entries m)))]
      (let [entry (elem (.entries m) i)]
        (push-str! (mut entries) (i64->str a (.phase entry)))
        (push-str! (mut entries) " ")
        (push-str! (mut entries) (.name entry))
        (push-str! (mut entries) " ")
        (push-str! (mut entries) (.symbol entry))
        (push-str! (mut entries) "\n"))
      0)
    (artifact-key a
                  (.profile m)
                  (str (load entries))
                  (.sdk m)
                  (.host m)
                  (.target m)
                  (.options m)
                  (.inputs m))))

;; Compile ENTRIES, checkers of SETUP's settled program CHECKED, into a profile
;; published at DESTINATION. NAMES are the definitions the checkers' module scope
;; holds (`module_fns` of the context they run in). The current semantic maps must
;; be CHECKED's.
(defn profile-build [(a (dyn Allocator))
                     (setup (ptr LS))
                     (checked (ptr Program))
                     (profile (slice u8))
                     (entries (ptr (ArrayList ProfileEntry)))
                     (names (ptr (ArrayList (slice u8))))
                     (options (slice u8))
                     (destination (slice u8))] (-> (Result (slice u8) Diag))
  (try (let [prepared (try! (prepare-meta-program a (mut setup) checked))
             m (box! a ProfileMetadata (zeroed ProfileMetadata))
             (mut prior) (zeroed SemMapsSnap)
             (mut quals) (ArrayList::new [(slice u8)] a)]
         (for [i 0 (len (load entries))]
           (push! (mut quals) (.name (elem entries i)))
           0)
         (sem-maps-save (mut prior))
         (sem-maps-restore (.maps prepared))
         (let [lowered
                 (metalower-program a
                                    (.program prepared)
                                    (box-al [(slice u8)] a (load quals)))]
           (sem-maps-restore (mut prior))
           (let [mo (try! lowered)
                 (mut named) (ArrayList::new [ProfileEntry] a)]
             (for [i 0 (len (load entries))]
               (let [entry (elem entries i)
                     symbol
                       (block :symbol
                              (for [j 0 (len (load (.entries mo)))]
                                (when (= (.name (elem (.entries mo) j)) (.name entry))
                                  (break :symbol (.symbol (elem (.entries mo) j)))))
                              "")]
                 (when (= symbol "")
                   (return-from :try
                                  (Err [(slice u8) Diag]
                                       (artifact-error (sconcat3 a
                                                                 "checker profile entry '"
                                                                 (.name entry)
                                                                 "' has no compiled entry")))))
                 (push! (mut named)
                        (ProfileEntry :name (.name entry)
                          :symbol symbol
                          :phase (.phase entry))))
               0)
             (set! (.profile m) profile)
             (set! (.sdk m) (try! (provider-sdk a)))
             (set! (.host m) (provider-host))
             (set! (.target m) (provider-target a))
             (set! (.options m) options)
             (set! (.inputs m) (try! (provider-inputs a setup)))
             (set! (.source_count m) (len (.sources setup)))
             (set! (.context_count m) (len (.expansions setup)))
             (set! (.entries m) (box-al [ProfileEntry] a (load named)))
             (set! (.names m) names)
             (set! (.registry m) (.registry mo))
             (set! (.key m) (profile-key a m))
             (sem-maps-restore (.maps prepared))
             (let [result (profile-publish a m mo destination)]
               (sem-maps-restore (mut prior))
               result))))))

(defn profile-publish [(a (dyn Allocator))
                       (m (ptr ProfileMetadata))
                       (lowered (ptr MLOut))
                       (destination (slice u8))] (-> (Result (slice u8) Diag))
  (try (let [(mut entries) (ArrayList::new [(slice u8)] a)]
         (for [i 0 (len (load (.entries m)))]
           (push! (mut entries) (.name (elem (.entries m) i)))
           0)
         (let [mp (try! (provider-image-program a lowered (box-al [(slice u8)] a (load entries))))
               directory
                 (match (temp/sibling destination)
                   (Ok [p] p)
                   (Err [e]
                        (return-from :try
                                       (Err [(slice u8) Diag] (artifact-error (text e))))))]
           (when (!= (fs/make-dir (to-cstr a directory) 448) (: 0 i32))
             (return-from :try
                            (Err [(slice u8) Diag]
                                 (artifact-error "cannot create the checker profile's staging directory"))))
           (let [result (profile-publish-stage a m mp directory destination)]
             (temp/remove! directory)
             result)))))

;; One profile lives at a destination: a stale one there is moved aside and the
;; new one renamed into place whole, so no reader sees half of either.
(defn profile-publish-stage [(a (dyn Allocator))
                             (m (ptr ProfileMetadata))
                             (mp (ptr Program))
                             (directory (slice u8))
                             (destination (slice u8))] (-> (Result (slice u8)
                                                                   Diag))
  (try (do
         (set! (.image_digest m) (try! (provider-emit-image a mp directory)))
         (try! (artifact-validate-inputs a (.inputs m)))
         (let [bytes (try! (wire-put-profile a m))]
           (match (fs/write-file a (sconcat a directory "/metadata") bytes)
             (Err [_]
                  (return-from :try
                                 (Err [(slice u8) Diag]
                                      (artifact-error "cannot write checker profile metadata"))))
             (Ok [_] 0)))
         (when (= (access (to-cstr a destination) 0) (: 0 i32))
           (match (temp/sibling destination)
             (Err [e]
                  (return-from :try
                                 (Err [(slice u8) Diag] (artifact-error (text e)))))
             (Ok [aside]
                 (when (= (rename (to-cstr a destination) (to-cstr a aside))
                          (: 0 i32))
                   (temp/remove! aside)
                   0)))
           0)
         (if (= (rename (to-cstr a directory) (to-cstr a destination))
                (: 0 i32))
             (Ok [(slice u8) Diag] destination)
             (Err [(slice u8) Diag]
                  (artifact-error "cannot publish the checker profile"))))))

;; The profile at DIRECTORY, when it is this compiler's for OPTIONS and every
;; source it was built from is unchanged; its image loaded into this process.
(defn profile-open [(a (dyn Allocator))
                    (directory (slice u8))
                    (options (slice u8))] (-> (Result LoadedProfile Diag))
  (try (let [bytes
               (try! (provider-read-bytes a (sconcat a directory "/metadata")))
             m (try! (wire-profile a bytes))
             image (sconcat3 a directory "/image" (me-dylib-ext))]
         (unless (and (= (.host m) (provider-host))
                      (and (= (.target m) (provider-target a))
                           (= (.options m) options)))
           (return-from :try
                          (Err [LoadedProfile Diag]
                               (artifact-error "stale checker profile: host, target or configuration differs"))))
         (unless (= (.sdk m) (try! (provider-sdk a)))
           (return-from :try
                          (Err [LoadedProfile Diag]
                               (artifact-error "stale checker profile: another compiler built it"))))
         (unless (= (.key m) (profile-key a m))
           (return-from :try
                          (Err [LoadedProfile Diag]
                               (artifact-error "checker profile identity does not match its metadata"))))
         (try! (artifact-validate-inputs a (.inputs m)))
         (unless (= (.image_digest m) (try! (artifact-file-digest a image)))
           (return-from :try
                          (Err [LoadedProfile Diag]
                               (artifact-error "checker profile native image digest mismatch"))))
         (try! (provider-registry-adopt! (.registry m)
                                         (.source_count m)
                                         (.context_count m)))
         (let [handle (try! (me-open-dylib a image (.registry m)))
               (mut fps) (ArrayList::new [(ptr i8)] a)]
           (for [i 0 (len (load (.entries m)))]
             (let [fp (dlsym handle (to-cstr a (.symbol (elem (.entries m) i))))]
               (when (= (cast i64 fp) 0)
                 (return-from :try
                                (Err [LoadedProfile Diag]
                                     (artifact-error "checker profile entry symbol missing"))))
               (push! (mut fps) fp))
             0)
           (Ok (LoadedProfile :metadata m :fps (box-al [(ptr i8)] a (load fps))))))))
