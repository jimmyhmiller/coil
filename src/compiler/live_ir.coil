;;; Layout-independent lowering of checked functions. This artifact contains no
;;; borrowed compiler pointers and can outlive its preparation transaction.
(module coil.compiler.live_ir)
(import "coil.primitive" :as p)
(import "coil.alloc" :as a)
(import "coil.arraylist" :as al)
(import "coil.hashmap" :as hm)
(import "coil.str" :as str)
(import "coil.compiler.ast" :as ast)
(import "coil.compiler.parser" :as util)

;;; kind: 1 signed i64, 2 bool, 3 f64, 4 nominal record, 0 unsupported.
(defstruct Type [(kind i64) (name (slice u8)) (place bool) (writable bool)])
;;; op: 1 integer, 2 parameter, 3 field place, 4 load, 5 binary,
;;; 6 compare, 7 allocate slot, 8 store, 9 borrow, 10 return,
;;; 11 conditional, 12 logical constructor, 13 revision-pinned direct call.
(defstruct Instruction [(op i64) (dst i64) (x i64) (y i64) (immediate i64)
  (owner (slice u8)) (field (slice u8))
  (arguments (al/ArrayList i64)) (then-code (ptr Function)) (else-code (ptr Function))])
(defstruct Function [(allocator (dyn a/Allocator)) (name (slice u8))
  (parameters (al/ArrayList Type)) (result Type) (registers (al/ArrayList Type))
  (instructions (al/ArrayList Instruction)) (diagnostic (slice u8))])
(defstruct Local [(name (slice u8)) (register i64)])
(defstruct Lower [(program (ptr ast/Program)) (output (ptr Function)) (locals (al/ArrayList Local))])
(defn text [(allocator (dyn a/Allocator)) (value (slice u8))] (-> (slice u8))
  (util/sconcat allocator value ""))
(defn type-of [(allocator (dyn a/Allocator)) (type ast/Type)] (-> Type)
  (match type
    (ast/TInt [bits signed]
      (Type :kind (if (and (= bits 64) signed) 1 0) :name "" :place false :writable false))
    (ast/TBool [] (Type :kind 2 :name "" :place false :writable false))
    (ast/TFloat [bits] (Type :kind (if (= bits 64) 3 0) :name "" :place false :writable false))
    (ast/TStruct [name] (Type :kind 4 :name (text allocator name) :place false :writable false))
    (ast/TRef [mutable inner]
      (let [(mut result) (type-of allocator (load inner))]
        (set! (.place result) true) (set! (.writable result) mutable) (load result)))
    (_ (p/zeroed Type))))
(defn equal? [(left Type) (right Type)] (-> bool)
  (and (= (.kind left) (.kind right)) (and (= (.name left) (.name right))
    (and (= (.place left) (.place right)) (= (.writable left) (.writable right))))))
(defn type-valid? [(type Type)] (-> bool)
  (and (and (>= (.kind type) 1) (<= (.kind type) 4))
    (and (if (= (.kind type) 4) (> (str/len (.name type)) 0) (= (str/len (.name type)) 0))
      (or (not (.writable type)) (.place type)))))
(defn value-type? [(left Type) (right Type)] (-> bool)
  (and (= (.kind left) (.kind right)) (= (.name left) (.name right))))
(defn fail! [(lower (ptr Lower)) (message (slice u8))] (-> i64)
  (when (= (str/len (.diagnostic (.output lower))) 0)
    (set! (.diagnostic (.output lower)) message)) -1)
(defn emit! [(lower (ptr Lower)) (type Type) (op i64) (x i64) (y i64) (immediate i64)
            (owner (slice u8)) (field (slice u8))] (-> i64)
  (let [out (.output lower) id (al/al-len (.registers out))]
    (if (= (.kind type) 0) (fail! lower "unsupported live value type")
      (do (al/al-push! (field out registers) type)
        (al/al-push! (field out instructions) (Instruction :op op :dst id :x x :y y :immediate immediate
          :owner (text (.allocator out) owner) :field (text (.allocator out) field)
          :arguments (al/al-new [i64] (.allocator out)) :then-code (p/cast (ptr Function) 0) :else-code (p/cast (ptr Function) 0))) id))))
(defn scalar [] (-> Type) (Type :kind 1 :name "" :place false :writable false))
(defn lookup [(lower (ptr Lower)) (name (slice u8))] (-> i64)
  (let [(mut i) (al/al-len (.locals lower))]
    (block :found
      (while (> (load i) 0)
        (set! i (- (load i) 1))
        (let [local (al/al-get (.locals lower) (load i))]
          (when (= (.name local) name) (break :found (.register local)))))
      (fail! lower "live lowering encountered an unbound checked local"))))
(defn register-type [(lower (ptr Lower)) (register i64)] (-> Type)
  (if (< register 0) (p/zeroed Type) (al/al-get (.registers (.output lower)) register)))
(defn field-type [(lower (ptr Lower)) (owner (slice u8)) (name (slice u8))] (-> Type)
  (block :found
    (for [i 0 (al/al-len (load (.structs (.program lower))))]
      (let [record (al/al-get (load (.structs (.program lower))) i)]
        (when (= (.name record) owner)
          (for [j 0 (al/al-len (load (.fields record)))]
            (let [field (al/al-get (load (.fields record)) j)]
              (when (= (.name field) name)
                (break :found (type-of (.allocator (.output lower)) (.ty field)))))) 0)))
    (fail! lower "checked field is absent from its logical declaration") (p/zeroed Type)))
(defn expressions! [(lower (ptr Lower)) (body (ptr (al/ArrayList ast/Expr)))] (-> i64)
  (let [(mut result) -1]
    (for [i 0 (al/al-len (load body))]
      (set! result (expression! lower (al/al-elem [ast/Expr] body i))))
    (load result)))
(defn region! [(parent (ptr Lower)) (expression (ref ast/Expr))] (-> (ptr Function))
  (let [allocator (.allocator (.output parent))
        output (a/box! allocator Function (Function :allocator allocator :name ""
          :parameters (al/al-new [Type] allocator) :result (p/zeroed Type)
          :registers (al/al-new [Type] allocator) :instructions (al/al-new [Instruction] allocator) :diagnostic ""))
        (mut state) (Lower :program (.program parent) :output output :locals (al/al-new [Local] allocator))]
    (for [i 0 (al/al-len (.locals parent))]
      (let [local (al/al-get (.locals parent) i) type (register-type parent (.register local))
            register (emit! (mut state) type 2 -1 -1 i "" "")]
        (al/al-push! (field output parameters) type)
        (al/al-push! (mut (.locals state)) (Local :name (.name local) :register register))))
    (let [result (expression! (mut state) expression)]
      (set! (.result output) (register-type (mut state) result))
      (emit! (mut state) (.result output) 10 result -1 0 "" ""))
    (al/al-free! (mut (.locals state))) output))
(defn expression! [(lower (ptr Lower)) (expr (ref ast/Expr))] (-> i64)
  (match (.kind expr)
    (ast/EInt [value] (emit! lower (scalar) 1 -1 -1 value "" ""))
    (ast/EFloat [bits] (emit! lower (Type :kind 3 :name "" :place false :writable false) 1 -1 -1 bits "" ""))
    (ast/EBool [value] (emit! lower (Type :kind 2 :name "" :place false :writable false) 1 -1 -1 (if value 1 0) "" ""))
    (ast/EVar [name] (lookup lower name))
    (ast/ERecordInit [type]
      (emit! lower (type-of (.allocator (.output lower)) type) 12 -1 -1 0 "" ""))
    (ast/ECall [name type-arguments arguments]
      (if (> (al/al-len (load type-arguments)) 0)
        (fail! lower "generic live calls require dictionaries")
        (emit-call! lower name arguments)))
    (ast/EDo [body] (expressions! lower body))
    (ast/EIf [condition then-expression else-expression]
      (let [condition-register (expression! lower condition)
            then-code (region! lower (load then-expression)) else-code (region! lower (load else-expression))]
        (if (or (not (verify then-code)) (or (not (verify else-code)) (not (equal? (.result then-code) (.result else-code)))))
          (fail! lower "conditional regions have incompatible or unsupported live results")
          (let [register (emit! lower (.result then-code) 11 condition-register -1 0 "" "")]
            (when (>= register 0)
              (let [instruction (al/al-elem [Instruction] (field (.output lower) instructions) register)]
                (set! (.then-code instruction) then-code) (set! (.else-code instruction) else-code)
                (for [i 0 (al/al-len (.locals lower))]
                  (let [local (al/al-get (.locals lower) i)]
                    (al/al-push! (field instruction arguments) (.register local))))))
            register))))
    (ast/ELet [bindings body]
      (let [saved (al/al-len (.locals lower))]
        (for [i 0 (al/al-len (load bindings))]
          (let [binding (al/al-get (load bindings) i) value (expression! lower (field binding value))]
            (when (!= (p/cast i64 (.owned_type binding)) 0)
              (fail! lower "owned values require a live type policy"))
            (al/al-push! (field lower locals) (Local :name (.name binding) :register value))))
        (let [result (expressions! lower body)] (set! (.len (field lower locals)) saved) result)))
    (ast/EField [base name]
      (let [source (expression! lower base) type (register-type lower source)
            (mut result) (field-type lower (.name type) name)]
        (if (or (!= (.kind type) 4) (not (.place type))) (fail! lower "field access requires a logical record place")
          (do (set! (.place result) true) (set! (.writable result) (.writable type))
            (emit! lower (load result) 3 source -1 0 (.name type) name)))))
    (ast/ELoad [inner]
      (let [source (expression! lower inner) (mut type) (register-type lower source)]
        (if (not (.place type)) (fail! lower "live load requires a place")
          (do (set! (.place type) false) (set! (.writable type) false)
            (emit! lower (load type) 4 source -1 0 "" "")))))
    (ast/EBorrow [mutable inner]
      (let [source (expression! lower inner) (mut type) (register-type lower source)]
        (if (or (not (.place type)) (and mutable (not (.writable type))))
          (fail! lower "invalid checked live borrow")
          (do (set! (.writable type) mutable) (emit! lower (load type) 9 source -1 0 "" "")))))
    (ast/EBin [operation left right]
      (let [x (expression! lower left) y (expression! lower right) type (register-type lower x)]
        (emit! lower type 5 x y operation "" "")))
    (ast/ECmp [operation left right]
      (let [x (expression! lower left) y (expression! lower right)]
        (emit! lower (Type :kind 2 :name "" :place false :writable false) 6 x y operation "" "")))
    (ast/EAlloc [storage type initial symbol]
      (if (or (= storage 1) (!= (p/cast i64 initial) 0))
        (fail! lower "static storage requires an explicit live root")
        (let [(mut result) (type-of (.allocator (.output lower)) type)]
          (set! (.place result) true) (set! (.writable result) true)
          (emit! lower (load result) 7 -1 -1 0 "" ""))))
    (ast/EStore [place value] (emit-store! lower place value))
    (ast/EInitStore [place value] (emit-store! lower place value))
    (_ (fail! lower "checked operation is not supported by the live baseline"))))
(defn emit-call! [(lower (ptr Lower)) (name (slice u8)) (arguments (ptr (al/ArrayList ast/Expr)))] (-> i64)
  (block :found
    (for [i 0 (al/al-len (load (.funcs (.program lower))))]
      (let [function (al/al-get (load (.funcs (.program lower))) i)]
        (when (= (.name function) name)
          (when (or (.declared function) (> (al/al-len (load (.type_params function))) 0))
            (break :found (fail! lower "external and generic live calls require explicit adapters")))
          (let [allocator (.allocator (.output lower))
                signature (a/box! allocator Function (p/zeroed Function))
                (mut operands) (al/al-new [i64] allocator)]
            (set! (.parameters signature) (al/al-new [Type] allocator))
            (set! (.result signature) (type-of allocator (.ret function)))
            (for [j 0 (al/al-len (load (.params function)))]
              (let [parameter (al/al-get (load (.params function)) j)
                    (mut type) (type-of allocator (parameter-type (.program lower) name j (.ty parameter)))]
                (when (!= (p/cast i64 (.owned_type parameter)) 0)
                  (break :found (fail! lower "owned call parameters require a live type policy")))
                (when (= (.kind type) 4) (set! (.place type) true))
                (al/al-push! (field signature parameters) (load type))))
            (for [j 0 (al/al-len (load arguments))]
              (al/al-push! (mut operands) (expression! lower (al/al-elem [ast/Expr] arguments j))))
            (let [id (emit! lower (.result signature) 13 -1 -1 0 name "")]
              (when (>= id 0)
                (let [instruction (al/al-elem [Instruction] (field (.output lower) instructions) id)]
                  (set! (.arguments instruction) (load operands)) (set! (.then-code instruction) signature)))
              (break :found id))))))
    (fail! lower "live callee is absent from the checked program")))
(defn emit-store! [(lower (ptr Lower)) (place (ptr ast/Expr)) (value (ptr ast/Expr))] (-> i64)
  (let [x (expression! lower place) y (expression! lower value)]
    (emit! lower (scalar) 8 x y 0 "" "")))
;;; Independent verification is mandatory even for compiler-produced artifacts.
;;; Registers are single-assignment and all inputs must precede their use.
(defn verify-body [(function (ptr Function)) (states (ptr (hm/HashMap i64 i64)))] (-> bool)
  (block :invalid
    (unless (type-valid? (.result function)) (break :invalid false))
    (for [i 0 (al/al-len (.parameters function))]
      (unless (type-valid? (al/al-get (.parameters function) i)) (break :invalid false)))
    (when (.place (.result function)) (break :invalid false))
    (when (> (str/len (.diagnostic function)) 0) (break :invalid false))
    (when (!= (al/al-len (.registers function)) (al/al-len (.instructions function))) (break :invalid false))
    (for [i 0 (al/al-len (.instructions function))]
      (let [instruction (al/al-get (.instructions function) i) type (al/al-get (.registers function) i)
            op (.op instruction) x (.x instruction) y (.y instruction)]
        (when (or (!= (.dst instruction) i) (not (type-valid? type))) (break :invalid false))
        (when (or (< op 1) (> op 13)) (break :invalid false))
        (when (or (and (>= op 3) (and (and (!= op 7) (and (!= op 12) (!= op 13))) (or (< x 0) (>= x i))))
                  (and (or (= op 5) (or (= op 6) (= op 8))) (or (< y 0) (>= y i))))
          (break :invalid false))
        (cond
          (= op 1) (when (or (and (= (.kind type) 2) (and (!= (.immediate instruction) 0) (!= (.immediate instruction) 1))) (or (.place type) (or (< (.kind type) 1) (> (.kind type) 3)))) (break :invalid false))
          (= op 2) (let [parameter (.immediate instruction)]
            (when (or (< parameter 0) (>= parameter (al/al-len (.parameters function)))) (break :invalid false))
            (unless (equal? type (al/al-get (.parameters function) parameter)) (break :invalid false)))
          (= op 3) (let [base (al/al-get (.registers function) x)]
            (unless (and (.place base) (and (= (.kind base) 4)
                (and (.place type) (and (= (.name base) (.owner instruction))
                  (or (not (.writable type)) (.writable base)))))) (break :invalid false)))
          (= op 4) (let [base (al/al-get (.registers function) x)]
            (unless (and (.place base) (and (not (.place type)) (value-type? base type))) (break :invalid false)))
          (or (= op 5) (= op 6))
            (let [left (al/al-get (.registers function) x) right (al/al-get (.registers function) y)]
              (unless (and (equal? left right) (and (or (= (.kind left) 1) (= (.kind left) 3)) (not (.place left)))) (break :invalid false))
              (unless (and (not (.place type)) (= (.kind type) (if (= op 5) (.kind left) 2))) (break :invalid false))
              (when (or (< (.immediate instruction) 0) (> (.immediate instruction)
                  (if (= op 5) (if (= (.kind left) 3) 4 11) 5))) (break :invalid false)))
          (= op 13)
            (let [signature (.then-code instruction)]
              (when (or (= (p/cast i64 signature) 0) (= (str/len (.owner instruction)) 0)) (break :invalid false))
              (unless (and (equal? type (.result signature)) (not (.place type))) (break :invalid false))
              (unless (= (al/al-len (.arguments instruction)) (al/al-len (.parameters signature))) (break :invalid false))
              (for [j 0 (al/al-len (.arguments instruction))]
                (let [argument (al/al-get (.arguments instruction) j)]
                  (when (or (< argument 0) (>= argument i)) (break :invalid false))
                  (unless (equal? (al/al-get (.registers function) argument) (al/al-get (.parameters signature) j))
                    (break :invalid false)))))
          (= op 12) (unless (and (= (.kind type) 4) (not (.place type))) (break :invalid false))
          (= op 7) (unless (and (.place type) (.writable type)) (break :invalid false))
          (= op 8) (let [place (al/al-get (.registers function) x) value (al/al-get (.registers function) y)]
            (unless (equal? type (scalar)) (break :invalid false))
            (unless (and (.place place) (and (.writable place) (and (not (.place value)) (value-type? place value)))) (break :invalid false)))
          (= op 9) (let [place (al/al-get (.registers function) x)]
            (unless (and (.place place) (and (.place type) (and (value-type? place type)
                (or (not (.writable type)) (.writable place))))) (break :invalid false)))
          (= op 11)
            (let [condition (al/al-get (.registers function) x) then-code (.then-code instruction) else-code (.else-code instruction)]
              (unless (and (= (.kind condition) 2) (not (.place condition))) (break :invalid false))
              (when (or (= (p/cast i64 then-code) 0) (= (p/cast i64 else-code) 0)) (break :invalid false))
              (unless (and (verify-with then-code states) (verify-with else-code states)) (break :invalid false))
              (unless (and (equal? type (.result then-code)) (equal? type (.result else-code))) (break :invalid false))
              (unless (and (= (al/al-len (.arguments instruction)) (al/al-len (.parameters then-code)))
                           (= (al/al-len (.arguments instruction)) (al/al-len (.parameters else-code)))) (break :invalid false))
              (for [j 0 (al/al-len (.arguments instruction))]
                (let [argument (al/al-get (.arguments instruction) j)]
                  (when (or (< argument 0) (>= argument i)) (break :invalid false))
                  (unless (and (equal? (al/al-get (.registers function) argument) (al/al-get (.parameters then-code) j))
                               (equal? (al/al-get (.registers function) argument) (al/al-get (.parameters else-code) j)))
                    (break :invalid false)))))
          (= op 10) (unless (and (equal? type (.result function)) (and (= i (- (al/al-len (.instructions function)) 1))
              (equal? (al/al-get (.registers function) x) (.result function)))) (break :invalid false))
          :else 0)))
    (and (> (al/al-len (.instructions function)) 0)
      (= (.op (al/al-elem [Instruction] (field function instructions) (- (al/al-len (.instructions function)) 1))) 10))))
(defn verify-with [(function (ptr Function)) (states (ptr (hm/HashMap i64 i64)))] (-> bool)
  (let [key (p/cast i64 function)]
    (match (hm/hm-get (load states) key)
      (Some [state] (= state 2))
      (None []
        (hm/hm-put! states key 1)
        (let [valid (verify-body function states)]
          (hm/hm-put! states key (if valid 2 3)) valid)))))
(defn verify [(function (ptr Function))] (-> bool)
  (let [(mut states) (hm/hm-new [i64 i64] (a/malloc-allocator) (hm/i64-keyops))
        valid (verify-with function (mut states))]
    (hm/hm-free! (mut states)) valid))

(defn parameter-type [(program (ptr ast/Program)) (function (slice u8)) (index i64) (fallback ast/Type)] (-> ast/Type)
  (block :found
    (unless (= (p/cast i64 (.function_abis program)) 0)
      (for [i 0 (al/al-len (load (.function_abis program)))]
        (let [abi (al/al-get (load (.function_abis program)) i)]
          (when (= (.name abi) function)
            (break :found (al/al-get (load (.params abi)) index))))) 0)
    (load fallback)))
(defn lower [(allocator (dyn a/Allocator)) (program (ptr ast/Program)) (name (slice u8))] (-> Function)
  (let [output (p/alloc-stack Function)
        _init (set! output (Function :allocator allocator :name (text allocator name)
          :parameters (al/al-new [Type] allocator) :result (p/zeroed Type)
          :registers (al/al-new [Type] allocator) :instructions (al/al-new [Instruction] allocator) :diagnostic ""))
        (mut state) (Lower :program program :output output :locals (al/al-new [Local] allocator))]
    (block :found
      (for [i 0 (al/al-len (load (.funcs program)))]
        (let [function (al/al-get (load (.funcs program)) i)]
          (when (= (.name function) name)
            (when (or (.declared function) (> (al/al-len (load (.type_params function))) 0))
              (fail! (mut state) "live generic and external calls require dictionaries") (break :found 0))
            (set! (.result output) (type-of allocator (.ret function)))
            (for [j 0 (al/al-len (load (.params function)))]
              (let [parameter (al/al-get (load (.params function)) j) (mut type) (type-of allocator (parameter-type program name j (.ty parameter)))]
                (when (!= (p/cast i64 (.owned_type parameter)) 0)
                  (fail! (mut state) "owned parameters require a live type policy"))
                ; Checked ordinary aggregate parameters are immutable places.
                (when (= (.kind type) 4) (set! (.place type) true))
                (al/al-push! (mut (.parameters output)) (load type))
                (let [register (emit! (mut state) (load type) 2 -1 -1 j "" "")]
                  (al/al-push! (mut (.locals state)) (Local :name (.name parameter) :register register)))))
            (let [result (expressions! (mut state) (.body function))]
              (emit! (mut state) (.result output) 10 result -1 0 "" ""))
            (break :found 0))))
      (fail! (mut state) "live function is absent from the checked candidate"))
    (unless (verify (mut output))
      (when (= (str/len (.diagnostic output)) 0) (set! (.diagnostic output) "live bytecode verification failed")))
    (al/al-free! (mut (.locals state)))
    (load output)))

(defstruct Field [(name (slice u8)) (type Type)])
(defstruct Schema [(name (slice u8)) (fields (al/ArrayList Field)) (valid bool)])
;;; Field order is descriptive only. Runtime linking assigns stable identities;
;;; no byte size, field offset, or native layout enters this representation.
(defn schema [(allocator (dyn a/Allocator)) (program (ptr ast/Program)) (name (slice u8))] (-> Schema)
  (let [(mut output) (Schema :name (text allocator name) :fields (al/al-new [Field] allocator) :valid false)]
    (block :found
      (for [i 0 (al/al-len (load (.structs program)))]
        (let [record (al/al-get (load (.structs program)) i)]
          (when (= (.name record) name)
            (when (> (al/al-len (load (.type_params record))) 0) (break :found 0))
            (for [j 0 (al/al-len (load (.fields record)))]
              (let [field (al/al-get (load (.fields record)) j) type (type-of allocator (.ty field))]
                (when (or (= (.kind type) 0) (.place type)) (break :found 0))
                (al/al-push! (mut (.fields output)) (Field :name (text allocator (.name field)) :type type))))
            (set! (.valid output) true) (break :found 0)))) 0)
    (load output)))
