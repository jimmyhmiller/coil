(defn api-renames [] (-> (slice ApiRename)) API-RENAMES)

;;; The row for MODULE's removed NAME, as an index into `api-renames`, or -1.
(defn api-rename-index [(module (slice u8)) (name (slice u8))] (-> i64)
  (let [rows (api-renames)
        (mut at) -1]
    (for [i 0 (len rows)]
      (let [r (get rows i)]
        (when (and (< at 0) (= (.module r) module) (= (.old r) name)) (set! at i) 0))
      0)
    at))

;;; The modules that lost names, each once.
(defn api-renamed-modules [(a (dyn Allocator))] (-> (ptr (ArrayList (slice u8))))
  (let [out (box! a (ArrayList (slice u8)) (ArrayList::new [(slice u8)] a))
        rows (api-renames)]
    (for [i 0 (len rows)]
      (let [m (.module (get rows i))
            (mut seen) false]
        ; rows come grouped by module, so the last one seen is nearly always it
        (for [k 0 (len (load out))]
          (when (and (not seen) (= (get (load out) (- (- (len (load out)) 1) k)) m))
            (set! seen true)
            0)
          0)
        (unless seen (push! out m) 0))
      0)
    out))

;;; What the removed name is now, for messages.
(defn api-rename-describe [(a (dyn Allocator)) (row ApiRename)] (-> (slice u8))
  (match (.change row)
    (Renamed [name] (sconcat3 a "`" name "`"))
    (TraitCall [_ trait name] (sconcat3 a (sconcat3 a "`" name "`, the method of the ") trait " trait"))
    (MethodCall [_ type name] (sconcat3 a (sconcat3 a "`" name "`, a method on ") type ""))
    (TypeCall [_ type name] (sconcat3 a (sconcat3 a "`" type "::") name "`"))
    (FunctionCall [home name] (sconcat3 a (sconcat3 a "`" name "` from ") home ""))))

(defn api-rename-note [(a (dyn Allocator)) (row ApiRename)] (-> (slice u8))
  (sconcat3 a
            (sconcat3 a "`" (.old row) "` was removed from ")
            (.module row)
            (sconcat a "; it is " (api-rename-describe a row))))

;;; The note a diagnostic about MODULE's missing NAME adds when the table says it was
;;; removed, or "". An empty MODULE matches a removed NAME of any module.
(defn api-rename-hint [(a (dyn Allocator)) (module (slice u8)) (name (slice u8))] (-> (slice u8))
  (let [rows (api-renames)
        (mut at) -1]
    (for [i 0 (len rows)]
      (let [r (get rows i)]
        (when (and (< at 0) (= (.old r) name) (or (= (len module) 0) (= (.module r) module)))
          (set! at i)
          0))
      0)
    (if (< at 0)
        ""
        (sconcat a
                 (api-rename-note a (get rows at))
                 "; `coil lint --fix` rewrites the program to use it"))))
