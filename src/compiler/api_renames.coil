; The standard-library names that were removed when a namespace's module-prefixed
; functions became methods and traits (`hm-put!` -> `set!`), and what each became.
; It is data: coil.compiler.api_migration rewrites a program from it (the syntax
; preflight of `coil lint --fix`), breaking_changes.coil asks it whether a build
; should point at that fix, and the resolver's diagnostics for a missing name say
; what replaced it.
;
; ---- Renaming a stdlib API? Add rows to API-RENAMES below. ----------------------
;
; One row per public name the namespace no longer has, and nothing else: nothing
; outside this table changes. A row says which module the old name lived in, what a
; call to it becomes, and whether an explicit type-argument vector written right
; after the old name is dropped:
;
;   (ApiRename :module "coil.hashmap" :old "hm-put!"
;              :change (TraitCall "coil.core" "Set" "set!") :drop-type-args true)
;
; The change is one of:
;
;   (TraitCall HOME TRAIT NAME)  a trait method: `(hm-put! m k v)` -> `(set! m k v)`.
;   (MethodCall HOME TYPE NAME)  a method on a type: `(hm-free! (mut m))` -> `(free! (mut m))`.
;   (TypeCall HOME TYPE NAME)    a method with no receiver: `(hm-new [K V] a ops)` ->
;                                `(HashMap::new [K V] a ops)`. TYPE is brought into
;                                scope where it is needed.
;   (Renamed NAME)               the same function or macro under a new name in the
;                                same module: `(hm-for [k v m] …)` -> `(for-entries [k v m] …)`.
;   (FunctionCall HOME NAME)     a function or macro another module declares:
;                                `(al-empty? xs)` -> `(empty? xs)`. NAME is brought into
;                                scope where it is needed.
;
; HOME is the module that declares TRAIT, TYPE or NAME ("coil.core" for the ambient
; traits and functions), or "" for a built-in type such as `slice`, which no module
; declares and every module can name. A trait or method call is written with the bare NAME, which the receiver
; dispatches; where a binding around the call, a definition of the file's own, or
; an import could capture that name, it is written `TRAIT::NAME` or `TYPE::NAME`.
; Set `:drop-type-args` when the old function took explicit type arguments that the
; receiver now supplies (trait and method calls of a generic function, or a generic
; function that infers them); leave it false for a TypeCall, whose type takes them,
; for a Renamed function, and for a macro, whose first argument may be a vector.
;
; A name that was removed with no public replacement has no row: there is nothing to
; rewrite it to. When a namespace's names are removed, also delete any
; coil.lint.modernize rule that rewrites them: this table replaces it.
;
; Check a new batch by running the candidate's `coil lint --fix` on code written
; against the old names (`git show <commit>^:<file>`) and building the result.
(module coil.compiler.api_renames)
(import "coil.alloc" :use [Allocator box!])
(import "coil.arraylist" :use [ArrayList])
(import "coil.compiler.parser" :use [sconcat sconcat3])

;;; What a call to a removed name becomes. See the header.
(defsum ApiChange
  (TraitCall [(home (slice u8)) (trait (slice u8)) (name (slice u8))])
  (MethodCall [(home (slice u8)) (type (slice u8)) (name (slice u8))])
  (TypeCall [(home (slice u8)) (type (slice u8)) (name (slice u8))])
  (Renamed [(name (slice u8))])
  (FunctionCall [(home (slice u8)) (name (slice u8))]))

;;; One removed public name. See the header.
(defstruct ApiRename
  [(module (slice u8)) (old (slice u8)) (change ApiChange) (drop-type-args bool)])

(def API-RENAMES
  [; ---- coil.hashmap (05ef88ca) ----
   (ApiRename :module "coil.hashmap" :old "hm-new"
              :change (TypeCall "coil.hashmap" "HashMap" "new") :drop-type-args false)
   (ApiRename :module "coil.hashmap" :old "hm-new-scalar"
              :change (TypeCall "coil.hashmap" "HashMap" "new-scalar") :drop-type-args false)
   (ApiRename :module "coil.hashmap" :old "hm-put!"
              :change (TraitCall "coil.core" "Set" "set!") :drop-type-args true)
   (ApiRename :module "coil.hashmap" :old "hm-get"
              :change (TraitCall "coil.core" "Get" "get") :drop-type-args true)
   (ApiRename :module "coil.hashmap" :old "hm-len"
              :change (TraitCall "coil.core" "Len" "len") :drop-type-args true)
   (ApiRename :module "coil.hashmap" :old "hm-contains?"
              :change (MethodCall "coil.hashmap" "HashMap" "contains?") :drop-type-args true)
   (ApiRename :module "coil.hashmap" :old "hm-remove!"
              :change (MethodCall "coil.hashmap" "HashMap" "remove!") :drop-type-args true)
   (ApiRename :module "coil.hashmap" :old "hm-clear!"
              :change (MethodCall "coil.hashmap" "HashMap" "clear!") :drop-type-args true)
   (ApiRename :module "coil.hashmap" :old "hm-free!"
              :change (MethodCall "coil.hashmap" "HashMap" "free!") :drop-type-args true)
   (ApiRename :module "coil.hashmap" :old "hm-cap"
              :change (MethodCall "coil.hashmap" "HashMap" "cap") :drop-type-args true)
   (ApiRename :module "coil.hashmap" :old "hm-grow!"
              :change (MethodCall "coil.hashmap" "HashMap" "grow!") :drop-type-args true)
   (ApiRename :module "coil.hashmap" :old "hm-header-valid?"
              :change (MethodCall "coil.hashmap" "HashMap" "header-valid?") :drop-type-args true)
   (ApiRename :module "coil.hashmap" :old "hm-for"
              :change (Renamed "for-entries") :drop-type-args false)
   (ApiRename :module "coil.hashmap" :old "keyops-valid?"
              :change (MethodCall "coil.hashmap" "KeyOps" "valid?") :drop-type-args false)
   (ApiRename :module "coil.hashmap" :old "ko-hash"
              :change (MethodCall "coil.hashmap" "KeyOps" "hash") :drop-type-args false)
   (ApiRename :module "coil.hashmap" :old "ko-eq"
              :change (MethodCall "coil.hashmap" "KeyOps" "eq") :drop-type-args false)
   (ApiRename :module "coil.hashmap" :old "ko-owns?"
              :change (MethodCall "coil.hashmap" "KeyOps" "owns?") :drop-type-args false)
   (ApiRename :module "coil.hashmap" :old "ko-keycopy"
              :change (MethodCall "coil.hashmap" "KeyOps" "copy-key!") :drop-type-args false)
   (ApiRename :module "coil.hashmap" :old "ko-keyfree"
              :change (MethodCall "coil.hashmap" "KeyOps" "free-key!") :drop-type-args false)
   ; ---- coil.arraylist ----
   (ApiRename :module "coil.arraylist" :old "al-new"
              :change (TypeCall "coil.arraylist" "ArrayList" "new") :drop-type-args false)
   (ApiRename :module "coil.arraylist" :old "al-len"
              :change (TraitCall "coil.core" "Len" "len") :drop-type-args true)
   (ApiRename :module "coil.arraylist" :old "al-get"
              :change (TraitCall "coil.core" "Get" "get") :drop-type-args true)
   (ApiRename :module "coil.arraylist" :old "al-set!"
              :change (TraitCall "coil.core" "Set" "set!") :drop-type-args true)
   (ApiRename :module "coil.arraylist" :old "al-push!"
              :change (TraitCall "coil.core" "Push" "push!") :drop-type-args true)
   (ApiRename :module "coil.arraylist" :old "al-pop!"
              :change (TraitCall "coil.core" "Pop" "pop!") :drop-type-args true)
   (ApiRename :module "coil.arraylist" :old "al-empty?"
              :change (FunctionCall "coil.core" "empty?") :drop-type-args true)
   (ApiRename :module "coil.arraylist" :old "al-for"
              :change (FunctionCall "coil.core" "for-in") :drop-type-args false)
   (ApiRename :module "coil.arraylist" :old "al-cap"
              :change (MethodCall "coil.arraylist" "ArrayList" "cap") :drop-type-args true)
   (ApiRename :module "coil.arraylist" :old "al-elem"
              :change (MethodCall "coil.arraylist" "ArrayList" "elem") :drop-type-args true)
   (ApiRename :module "coil.arraylist" :old "al-reserve!"
              :change (MethodCall "coil.arraylist" "ArrayList" "reserve!") :drop-type-args true)
   (ApiRename :module "coil.arraylist" :old "al-extend!"
              :change (MethodCall "coil.arraylist" "ArrayList" "extend!") :drop-type-args true)
   (ApiRename :module "coil.arraylist" :old "al-extend-zeroed!"
              :change (MethodCall "coil.arraylist" "ArrayList" "extend-zeroed!") :drop-type-args true)
   (ApiRename :module "coil.arraylist" :old "al-slice"
              :change (MethodCall "coil.arraylist" "ArrayList" "slice") :drop-type-args true)
   (ApiRename :module "coil.arraylist" :old "al-into-slice"
              :change (MethodCall "coil.arraylist" "ArrayList" "into-slice") :drop-type-args true)
   (ApiRename :module "coil.arraylist" :old "al-clear!"
              :change (MethodCall "coil.arraylist" "ArrayList" "clear!") :drop-type-args true)
   (ApiRename :module "coil.arraylist" :old "al-free!"
              :change (MethodCall "coil.arraylist" "ArrayList" "free!") :drop-type-args true)
   ; ---- coil.fixedlist ----
   (ApiRename :module "coil.fixedlist" :old "fixed-list"
              :change (TypeCall "coil.fixedlist" "FixedList" "new") :drop-type-args false)
   (ApiRename :module "coil.fixedlist" :old "inline-list"
              :change (TypeCall "coil.fixedlist" "InlineList" "new") :drop-type-args false)
   (ApiRename :module "coil.fixedlist" :old "fixed-used"
              :change (MethodCall "coil.fixedlist" "FixedList" "used") :drop-type-args true)
   (ApiRename :module "coil.fixedlist" :old "inline-used"
              :change (MethodCall "coil.fixedlist" "InlineList" "used") :drop-type-args true)
   ; ---- coil.slice ----
   (ApiRename :module "coil.slice" :old "slice-new"
              :change (TypeCall "" "slice" "new") :drop-type-args false)
   (ApiRename :module "coil.slice" :old "slice-len"
              :change (TraitCall "coil.core" "Len" "len") :drop-type-args true)
   (ApiRename :module "coil.slice" :old "slice-get"
              :change (TraitCall "coil.core" "Get" "get") :drop-type-args true)
   (ApiRename :module "coil.slice" :old "slice-data"
              :change (MethodCall "" "slice" "data") :drop-type-args true)
   (ApiRename :module "coil.slice" :old "slice-set!"
              :change (MethodCall "" "slice" "set!") :drop-type-args true)
   (ApiRename :module "coil.slice" :old "slice-empty?"
              :change (FunctionCall "coil.core" "empty?") :drop-type-args true)
   (ApiRename :module "coil.slice" :old "slice-for"
              :change (FunctionCall "coil.core" "for-in") :drop-type-args false)
   ; ---- coil.str: StrBuf ----
   (ApiRename :module "coil.str" :old "sb-new"
              :change (TypeCall "coil.str" "StrBuf" "new") :drop-type-args false)
   (ApiRename :module "coil.str" :old "sb-push-str!"
              :change (MethodCall "coil.str" "StrBuf" "push-str!") :drop-type-args false)
   (ApiRename :module "coil.str" :old "sb-push-byte!"
              :change (TraitCall "coil.core" "Push" "push!") :drop-type-args false)
   (ApiRename :module "coil.str" :old "sb-push-i64!"
              :change (MethodCall "coil.str" "StrBuf" "push-i64!") :drop-type-args false)
   (ApiRename :module "coil.str" :old "sb-str"
              :change (MethodCall "coil.str" "StrBuf" "str") :drop-type-args false)
   (ApiRename :module "coil.str" :old "sb-free!"
              :change (MethodCall "coil.str" "StrBuf" "free!") :drop-type-args false)
   (ApiRename :module "coil.str" :old "sb-finish!"
              :change (MethodCall "coil.str" "StrBuf" "finish!") :drop-type-args false)
   (ApiRename :module "coil.str" :old "sb-writer"
              :change (TypeCall "coil.str" "StrBuf" "writer") :drop-type-args false)
   (ApiRename :module "coil.str" :old "sb-format!"
              :change (Renamed "format!") :drop-type-args false)])

(defn api-renames [] (-> (slice ApiRename)) API-RENAMES)

;;; The row for MODULE's removed NAME, as an index into `api-renames`, or -1.
(defn api-rename-index [(module (slice u8)) (name (slice u8))] (-> i64)
  (let [rows (api-renames)
        (mut at) -1]
    (for [i 0 (len rows)]
      (let [r (get rows i)]
        (when (and (< at 0) (= (.module r) module) (= (.old r) name)) (set! at i) 0))
      0)
    at))

;;; The modules that lost names, each once.
(defn api-renamed-modules [(a (dyn Allocator))] (-> (ptr (ArrayList (slice u8))))
  (let [out (box! a (ArrayList (slice u8)) (ArrayList::new [(slice u8)] a))
        rows (api-renames)]
    (for [i 0 (len rows)]
      (let [m (.module (get rows i))
            (mut seen) false]
        ; rows come grouped by module, so the last one seen is nearly always it
        (for [k 0 (len (load out))]
          (when (and (not seen) (= (get (load out) (- (- (len (load out)) 1) k)) m))
            (set! seen true)
            0)
          0)
        (unless seen (push! out m) 0))
      0)
    out))

;;; What the removed name is now, for messages.
(defn api-rename-describe [(a (dyn Allocator)) (row ApiRename)] (-> (slice u8))
  (match (.change row)
    (Renamed [name] (sconcat3 a "`" name "`"))
    (TraitCall [_ trait name] (sconcat3 a (sconcat3 a "`" name "`, the method of the ") trait " trait"))
    (MethodCall [_ type name] (sconcat3 a (sconcat3 a "`" name "`, a method on ") type ""))
    (TypeCall [_ type name] (sconcat3 a (sconcat3 a "`" type "::") name "`"))
    (FunctionCall [home name] (sconcat3 a (sconcat3 a "`" name "` from ") home ""))))

(defn api-rename-note [(a (dyn Allocator)) (row ApiRename)] (-> (slice u8))
  (sconcat3 a
            (sconcat3 a "`" (.old row) "` was removed from ")
            (.module row)
            (sconcat a "; it is " (api-rename-describe a row))))

;;; The note a diagnostic about MODULE's missing NAME adds when the table says it was
;;; removed, or "". An empty MODULE matches a removed NAME of any module.
(defn api-rename-hint [(a (dyn Allocator)) (module (slice u8)) (name (slice u8))] (-> (slice u8))
  (let [rows (api-renames)
        (mut at) -1]
    (for [i 0 (len rows)]
      (let [r (get rows i)]
        (when (and (< at 0) (= (.old r) name) (or (= (len module) 0) (= (.module r) module)))
          (set! at i)
          0))
      0)
    (if (< at 0)
        ""
        (sconcat a
                 (api-rename-note a (get rows at))
                 "; `coil lint --fix` rewrites the program to use it"))))
