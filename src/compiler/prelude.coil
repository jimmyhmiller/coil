(module coil.core)
(import "coil.primitive" :as primitive)
; THE CORE NAMESPACE — compiled into the compiler (src/compiler/prelude.coil) and auto-loaded
; (auto-referred) into every program, like Clojure's clojure.core. Its names — the
; traits `Eq`/`Hash`/`Add`/… and their operator methods `=`/`+`/`hash`/… — are in
; scope with NO import (every other module must be `:use`/`:as`-imported). Trait
; names are namespaced to `coil.core`; add a type with `(impl Eq YourType …)` or
; `(derive Eq YourType)` (src/stdlib/derive.coil).

; RE-EXPORT: `:reexport` re-publishes a module's exported names as part of core, so
; they are auto-referred everywhere (only `:reexport`ed targets, not plain `:use`s).
; This one line gives every program the everyday control flow (while/for/when/
; case/|>/…) with no import. Add another `:reexport` line here to fold more into core.
(import "coil.control" :reexport)

; Result/Option early-exit is equally fundamental control flow. Re-exporting these
; macros makes `try`, `try!`, `try?`, `try-or!`, `some-or!`, and `ensure!` available
; without an import and lets autofixes use them in any module.
(import "coil.try" :reexport)

; `coil.core` is the common ambient base. Profile-specific ambient functions are
; explicit `(provide-core ...)` modules activated by the loader: full uses
; coil.print + coil.assert; hermetic uses coil.assert.hermetic. Keeping them out of
; this source prevents the common core from transitively acquiring IO/allocation.
;
; The test RUNNER is deliberately not ambient. It lives in coil.test-runner, and its
; `(transform …)` — the thing that discovers `coil-test$…` and synthesizes a `main`
; for them — registers only in a program that loads that module: `coil test`, `coil
; fuzz` and project lint pass `--use coil.test-runner`, and nothing else does. Making
; it ambient would give a `--lib` build with tests in it a synthesized `main` that
; collides at link, and cost every `coil run` a module load (~20%) to support running
; a file most people run with `coil test`. `coil build`/`coil run` on a file of tests
; therefore has no entry point, and driver.coil's `built-a-test-file?` note says so
; instead of leaving the linker to.

; Everyday typed pointer access. The primitive declarations live exclusively in
; coil.primitive; core only aliases the deliberately ambient surface.
(def field primitive/field)
(def load primitive/load)
(def store! primitive/store!)
(def cast primitive/cast)
(def index primitive/index)
(def sizeof primitive/sizeof)
(def zeroed primitive/zeroed)
(def alignof primitive/alignof)
(def offsetof primitive/offsetof)
(def fnptr-of primitive/fnptr-of)
(def call-ptr primitive/call-ptr)

;; `(deftest NAME body…)` declares a test as a zero-argument function using the
;; stable name prefix consumed by Coil's library-defined test runner. The declaration
;; itself is core syntax; assertions and runner support remain in `coil.assert`.
; hygiene: deftest declarations intentionally enter the caller-visible test namespace.
(defn deftest [(name Code) & (body Code)] (-> Code)
  `(defn ~(primitive/syntax->datum (primitive/code-symbol "coil-test$" name)) [] (-> i64)
     ~@body
     0))

; Option / Result (and Some/None/Ok/Err) are core vocabulary, always in scope.
; Pure generic sums (no runtime/externs), so this is freestanding-safe, and the
; allocator/IO trait signatures can use Option with no import at the use site.
; `match` recovers the concrete instance from the scrutinee, and bidirectional
; checking pushes the expected type into a bare `(None)`/`(Ok v)`/`(Err e)`, so
; both consuming and constructing them need no `[T …]` annotation in practice.
(defsum Keyword
  (KeywordValue [(name (slice u8))]))

(defsum Option [T]
  (None)
  (Some [(val T)]))

(defsum Result [T E]
  (Ok [(val T)])
  (Err [(err E)]))

; Typed policy used by the compiler's built-in `:inline` annotation. The
; annotation schema itself is installed by the compiler during bootstrap; user
; annotation schemas use `(defannotation :qualified/key ValueType)`.
(defsum InlinePolicy
  (Always)
  (Hint)
  (Never))

; `cond` is core vocabulary rather than an optional control-module export. Keeping
; it here makes the form available in every program even if the rest of
; `control.coil` is eventually made opt-in.
(defn cond-arms [(cs Code)] (-> Code)
  (if (primitive/icmp-eq (primitive/code-count cs) 0)
      `0
      (if (primitive/icmp-eq (primitive/code-count cs) 1)
          (primitive/code-nth cs 0)
          (if (primitive/code-eq (primitive/code-nth cs 0) `:else)
              (primitive/code-nth cs 1)
              `(if ~(primitive/code-nth cs 0)
                   ~(primitive/code-nth cs 1)
                   ~(cond-arms (primitive/code-rest (primitive/code-rest cs))))))))
(defn cond [& (cs Code)] (-> Code)
  (cond-arms cs))

; Clojure-style field threading. `(.. rect origin x)` expands to
; `(.x (.origin rect))`; `.field` itself remains compiler syntax because it must
; denote a value normally and a place beneath `mut`/two-argument `set!`.
(defn dot-path [(value Code) (fields Code) (i i64) (n i64)] (-> Code)
  (if (>= i n)
      value
      (dot-path `(~(primitive/code-symbol "." (primitive/code-nth fields i)) ~value)
                fields
                (+ i 1)
                n)))
(defn .. [(value Code) & (fields Code)] (-> Code)
  (dot-path value fields 0 (primitive/code-count fields)))

; structural equality — the method is `=` (so `(= a b)` at runtime).
(deftrait Eq [Self]
  (= [(a Self) (b Self)] (-> bool)))
; inequality for free on any `Eq` type — `(!= a b)` is `(not (= a b))`.
(defn != [(T Eq)] [(a T) (b T)] (-> bool)
  (not (= a b)))

; a hash of the value (FNV-1a over fields, when derived)
(deftrait Hash [Self]
  (hash [(x Self)] (-> i64)))

; Ownership vocabulary. `Copy` is intentionally a marker: an implementation says
; that an ordinary value duplication is valid and needs no cleanup. `Clone` borrows
; its source and makes ownership duplication explicit. `Drop` receives the final
; mutable place immediately before its storage ceases to be live. The affine checker
; and drop elaborator give these ordinary traits their language semantics.
(deftrait Copy [Self]
  ; A no-op witness keeps implementations syntactically unambiguous across old
  ; bootstrap compilers. Copy remains a marker semantically.
  (copy-witness [(self (ref Self))] (-> void)))
(deftrait Clone [Self]
  (clone [(self (ref Self))] (-> Self)))
(deftrait Drop [Self]
  (drop [(self (mut Self))] (-> void)))

; An affine owner whose storage is preserved without automatic destruction.
; Consuming `manually-drop-into-inner` is the safe extraction path: the wrapper
; cannot subsequently be used again, while its contained owner is transferred.
(defstruct ManuallyDrop [T] [(value T)])
(defn manually-drop [T] [(value T)] (-> (ManuallyDrop T))
  (ManuallyDrop :value value))
(defn manually-drop-into-inner [T] [(value (ManuallyDrop T))] (-> T)
  (.value value))

; Deliberate ownership escape hatches. `forget` consumes without destruction.
; `take!` moves out of a mutable owner place, leaving it uninitialized until a
; subsequent whole-place store reinitializes it.
(defn forget [T] [(value T)] (-> void))
(defn take! [T] [(value (mut T))] (-> T)
  (load value))

; Scalar and non-owning handle values are bitwise-copyable. Aggregates acquire Copy
; structurally only when every field is Copy; raw pointers and borrowed views never
; imply ownership of their pointees.
(impl Copy i8 (copy-witness [(self (ref i8))] (-> void) 0))
(impl Copy i16 (copy-witness [(self (ref i16))] (-> void) 0))
(impl Copy i32 (copy-witness [(self (ref i32))] (-> void) 0))
(impl Copy i64 (copy-witness [(self (ref i64))] (-> void) 0))
(impl Copy u8 (copy-witness [(self (ref u8))] (-> void) 0))
(impl Copy u16 (copy-witness [(self (ref u16))] (-> void) 0))
(impl Copy u32 (copy-witness [(self (ref u32))] (-> void) 0))
(impl Copy u64 (copy-witness [(self (ref u64))] (-> void) 0))
(impl Copy f32 (copy-witness [(self (ref f32))] (-> void) 0))
(impl Copy f64 (copy-witness [(self (ref f64))] (-> void) 0))
(impl Copy bool (copy-witness [(self (ref bool))] (-> void) 0))
(impl [T] Copy (ptr T)
  (copy-witness [(self (ref (ptr T)))] (-> void) 0))
(impl [T] Copy (slice T)
  (copy-witness [(self (ref (slice T)))] (-> void) 0))

; Copy leaves are explicitly clonable. User aggregates still opt into Clone
; structurally with `(derive Clone T)`, preserving ordinary trait coherence.
(impl Clone i8 (clone [(self (ref i8))] (-> i8) (load self)))
(impl Clone i16 (clone [(self (ref i16))] (-> i16) (load self)))
(impl Clone i32 (clone [(self (ref i32))] (-> i32) (load self)))
(impl Clone i64 (clone [(self (ref i64))] (-> i64) (load self)))
(impl Clone u8 (clone [(self (ref u8))] (-> u8) (load self)))
(impl Clone u16 (clone [(self (ref u16))] (-> u16) (load self)))
(impl Clone u32 (clone [(self (ref u32))] (-> u32) (load self)))
(impl Clone u64 (clone [(self (ref u64))] (-> u64) (load self)))
(impl Clone f32 (clone [(self (ref f32))] (-> f32) (load self)))
(impl Clone f64 (clone [(self (ref f64))] (-> f64) (load self)))
(impl Clone bool (clone [(self (ref bool))] (-> bool) (load self)))
(impl [T] Clone (ptr T)
  (clone [(self (ref (ptr T)))] (-> (ptr T)) (load self)))
(impl [T] Clone (slice T)
  (clone [(self (ref (slice T)))] (-> (slice T)) (load self)))

; The conventional marker trait for values exposed through ordinary call syntax.
; Neither this trait's qualified name nor the `call` member is reserved: call syntax
; finds an ordinary trait impl member named `call` and lowers directly to it.
(deftrait Callable [Self Args... R]
  (call :inline
        (Always)
        [(self Self) (args Args...) ...]
        (-> R)))

; ---- arithmetic + ordering, as traits -------------------------
; So `+ - * / %` and `< <= > >=` work and dispatch by type — and a generic can be
; bounded `(T Add)` / `(T Ord)`. Each lowers to the core op in the impl, which the
; optimizer inlines, so there's no overhead on primitives.
(deftrait Add [Self] (+ [(a Self) (b Self)] (-> Self)))
(deftrait Sub [Self] (- [(a Self) (b Self)] (-> Self)))
(deftrait Mul [Self] (* [(a Self) (b Self)] (-> Self)))
(deftrait Div [Self] (/ [(a Self) (b Self)] (-> Self)))
(deftrait Rem [Self] (% [(a Self) (b Self)] (-> Self)))
(deftrait Ord [Self]
  (< [(a Self) (b Self)] (-> bool))
  (<= [(a Self) (b Self)] (-> bool))
  (> [(a Self) (b Self)] (-> bool))
  (>= [(a Self) (b Self)] (-> bool)))

; standard equality impls for every integer primitive.
(impl Eq i8 (= [(a i8) (b i8)] (-> bool) (primitive/icmp-eq a b)))
(impl Eq i16 (= [(a i16) (b i16)] (-> bool) (primitive/icmp-eq a b)))
(impl Eq i32 (= [(a i32) (b i32)] (-> bool) (primitive/icmp-eq a b)))
(impl Eq i64 (= :inline (Always) [(a i64) (b i64)] (-> bool) (primitive/icmp-eq a b)))
(impl Eq u8 (= [(a u8) (b u8)] (-> bool) (primitive/icmp-eq a b)))
(impl Eq u16 (= [(a u16) (b u16)] (-> bool) (primitive/icmp-eq a b)))
(impl Eq u32 (= [(a u32) (b u32)] (-> bool) (primitive/icmp-eq a b)))
(impl Eq u64 (= [(a u64) (b u64)] (-> bool) (primitive/icmp-eq a b)))
; bool is Eq (i1 compare). Note: f64 is deliberately NOT Eq, because NaN != NaN
; breaks reflexivity; use fcmp-eq / fcmp-ne for floats.
(impl Eq bool (= [(a bool) (b bool)] (-> bool) (if a b (not b))))
; Compile-time syntax values use the same structural/identity-aware comparison as
; the primitive metaprogram API, exposed through ordinary Eq dispatch.
(impl Eq Code
  (= [(a Code) (b Code)] (-> bool) (primitive/code-eq a b)))
(impl Hash i64 (hash [(x i64)] (-> i64) x))
(impl Add i64 (+ :inline (Always) [(a i64) (b i64)] (-> i64) (primitive/iadd a b)))
(impl Sub i64 (- :inline (Always) [(a i64) (b i64)] (-> i64) (primitive/isub a b)))
(impl Mul i64 (* :inline (Always) [(a i64) (b i64)] (-> i64) (primitive/imul a b)))
(impl Div i64 (/ :inline (Always) [(a i64) (b i64)] (-> i64) (primitive/idiv a b)))
(impl Rem i64 (% :inline (Always) [(a i64) (b i64)] (-> i64) (primitive/irem a b)))

; The same five operators for every other integer width. `+ - *` are
; width-agnostic, and `/ %` READ THEIR SIGNEDNESS OFF THE OPERAND TYPE in codegen
; (`idiv` becomes SDiv or UDiv accordingly), so one spelling is correct for both
; families — a u64 divide really does emit an unsigned divide, and does not go
; wrong above 2^63 the way a signed one would. `primitive/udiv` / `primitive/urem`
; remain for the other case: bits held in a SIGNED type that are to be read as
; unsigned anyway.
(impl Add i8 (+ [(a i8) (b i8)] (-> i8) (primitive/iadd a b)))
(impl Sub i8 (- [(a i8) (b i8)] (-> i8) (primitive/isub a b)))
(impl Mul i8 (* [(a i8) (b i8)] (-> i8) (primitive/imul a b)))
(impl Div i8 (/ [(a i8) (b i8)] (-> i8) (primitive/idiv a b)))
(impl Rem i8 (% [(a i8) (b i8)] (-> i8) (primitive/irem a b)))
(impl Add i16 (+ [(a i16) (b i16)] (-> i16) (primitive/iadd a b)))
(impl Sub i16 (- [(a i16) (b i16)] (-> i16) (primitive/isub a b)))
(impl Mul i16 (* [(a i16) (b i16)] (-> i16) (primitive/imul a b)))
(impl Div i16 (/ [(a i16) (b i16)] (-> i16) (primitive/idiv a b)))
(impl Rem i16 (% [(a i16) (b i16)] (-> i16) (primitive/irem a b)))
(impl Add i32 (+ [(a i32) (b i32)] (-> i32) (primitive/iadd a b)))
(impl Sub i32 (- [(a i32) (b i32)] (-> i32) (primitive/isub a b)))
(impl Mul i32 (* [(a i32) (b i32)] (-> i32) (primitive/imul a b)))
(impl Div i32 (/ [(a i32) (b i32)] (-> i32) (primitive/idiv a b)))
(impl Rem i32 (% [(a i32) (b i32)] (-> i32) (primitive/irem a b)))
(impl Add u8 (+ [(a u8) (b u8)] (-> u8) (primitive/iadd a b)))
(impl Sub u8 (- [(a u8) (b u8)] (-> u8) (primitive/isub a b)))
(impl Mul u8 (* [(a u8) (b u8)] (-> u8) (primitive/imul a b)))
(impl Div u8 (/ [(a u8) (b u8)] (-> u8) (primitive/idiv a b)))
(impl Rem u8 (% [(a u8) (b u8)] (-> u8) (primitive/irem a b)))
(impl Add u16 (+ [(a u16) (b u16)] (-> u16) (primitive/iadd a b)))
(impl Sub u16 (- [(a u16) (b u16)] (-> u16) (primitive/isub a b)))
(impl Mul u16 (* [(a u16) (b u16)] (-> u16) (primitive/imul a b)))
(impl Div u16 (/ [(a u16) (b u16)] (-> u16) (primitive/idiv a b)))
(impl Rem u16 (% [(a u16) (b u16)] (-> u16) (primitive/irem a b)))
(impl Add u32 (+ [(a u32) (b u32)] (-> u32) (primitive/iadd a b)))
(impl Sub u32 (- [(a u32) (b u32)] (-> u32) (primitive/isub a b)))
(impl Mul u32 (* [(a u32) (b u32)] (-> u32) (primitive/imul a b)))
(impl Div u32 (/ [(a u32) (b u32)] (-> u32) (primitive/idiv a b)))
(impl Rem u32 (% [(a u32) (b u32)] (-> u32) (primitive/irem a b)))
(impl Add u64 (+ [(a u64) (b u64)] (-> u64) (primitive/iadd a b)))
(impl Sub u64 (- [(a u64) (b u64)] (-> u64) (primitive/isub a b)))
(impl Mul u64 (* [(a u64) (b u64)] (-> u64) (primitive/imul a b)))
(impl Div u64 (/ [(a u64) (b u64)] (-> u64) (primitive/idiv a b)))
(impl Rem u64 (% [(a u64) (b u64)] (-> u64) (primitive/irem a b)))
(impl Ord i8
  (< [(a i8) (b i8)] (-> bool) (primitive/icmp-lt a b))
  (<= [(a i8) (b i8)] (-> bool) (primitive/icmp-le a b))
  (> [(a i8) (b i8)] (-> bool) (primitive/icmp-gt a b))
  (>= [(a i8) (b i8)] (-> bool) (primitive/icmp-ge a b)))
(impl Ord i16
  (< [(a i16) (b i16)] (-> bool) (primitive/icmp-lt a b))
  (<= [(a i16) (b i16)] (-> bool) (primitive/icmp-le a b))
  (> [(a i16) (b i16)] (-> bool) (primitive/icmp-gt a b))
  (>= [(a i16) (b i16)] (-> bool) (primitive/icmp-ge a b)))
(impl Ord i32
  (< [(a i32) (b i32)] (-> bool) (primitive/icmp-lt a b))
  (<= [(a i32) (b i32)] (-> bool) (primitive/icmp-le a b))
  (> [(a i32) (b i32)] (-> bool) (primitive/icmp-gt a b))
  (>= [(a i32) (b i32)] (-> bool) (primitive/icmp-ge a b)))
(impl Ord i64
  (< :inline (Always) [(a i64) (b i64)] (-> bool) (primitive/icmp-lt a b))
  (<= :inline (Always) [(a i64) (b i64)] (-> bool) (primitive/icmp-le a b))
  (> :inline (Always) [(a i64) (b i64)] (-> bool) (primitive/icmp-gt a b))
  (>= :inline (Always) [(a i64) (b i64)] (-> bool) (primitive/icmp-ge a b)))
(impl Ord u8
  (< [(a u8) (b u8)] (-> bool) (primitive/icmp-lt a b))
  (<= [(a u8) (b u8)] (-> bool) (primitive/icmp-le a b))
  (> [(a u8) (b u8)] (-> bool) (primitive/icmp-gt a b))
  (>= [(a u8) (b u8)] (-> bool) (primitive/icmp-ge a b)))
(impl Ord u16
  (< [(a u16) (b u16)] (-> bool) (primitive/icmp-lt a b))
  (<= [(a u16) (b u16)] (-> bool) (primitive/icmp-le a b))
  (> [(a u16) (b u16)] (-> bool) (primitive/icmp-gt a b))
  (>= [(a u16) (b u16)] (-> bool) (primitive/icmp-ge a b)))
(impl Ord u32
  (< [(a u32) (b u32)] (-> bool) (primitive/icmp-lt a b))
  (<= [(a u32) (b u32)] (-> bool) (primitive/icmp-le a b))
  (> [(a u32) (b u32)] (-> bool) (primitive/icmp-gt a b))
  (>= [(a u32) (b u32)] (-> bool) (primitive/icmp-ge a b)))
(impl Ord u64
  (< [(a u64) (b u64)] (-> bool) (primitive/icmp-lt a b))
  (<= [(a u64) (b u64)] (-> bool) (primitive/icmp-le a b))
  (> [(a u64) (b u64)] (-> bool) (primitive/icmp-gt a b))
  (>= [(a u64) (b u64)] (-> bool) (primitive/icmp-ge a b)))

; f64 arithmetic + ordering
(impl Add f64 (+ [(a f64) (b f64)] (-> f64) (primitive/fadd a b)))
(impl Sub f64 (- [(a f64) (b f64)] (-> f64) (primitive/fsub a b)))
(impl Mul f64 (* [(a f64) (b f64)] (-> f64) (primitive/fmul a b)))
(impl Div f64 (/ [(a f64) (b f64)] (-> f64) (primitive/fdiv a b)))
(impl Ord f64
  (< [(a f64) (b f64)] (-> bool) (primitive/fcmp-lt a b))
  (<= [(a f64) (b f64)] (-> bool) (primitive/fcmp-le a b))
  (> [(a f64) (b f64)] (-> bool) (primitive/fcmp-gt a b))
  (>= [(a f64) (b f64)] (-> bool) (primitive/fcmp-ge a b)))

; f32 gets the same treatment, and the same deliberate omission of `Eq`.
(impl Add f32 (+ [(a f32) (b f32)] (-> f32) (primitive/fadd a b)))
(impl Sub f32 (- [(a f32) (b f32)] (-> f32) (primitive/fsub a b)))
(impl Mul f32 (* [(a f32) (b f32)] (-> f32) (primitive/fmul a b)))
(impl Div f32 (/ [(a f32) (b f32)] (-> f32) (primitive/fdiv a b)))
(impl Ord f32
  (< [(a f32) (b f32)] (-> bool) (primitive/fcmp-lt a b))
  (<= [(a f32) (b f32)] (-> bool) (primitive/fcmp-le a b))
  (> [(a f32) (b f32)] (-> bool) (primitive/fcmp-gt a b))
  (>= [(a f32) (b f32)] (-> bool) (primitive/fcmp-ge a b)))

; ---- pointers are ordered and compared BY ADDRESS ---------------------------
; `T` is irrelevant to an address comparison, so these are
; UNBOUNDED — `(ptr T)` for any T at all, including a T that is itself unordered.
; One blanket impl covers every pointer type (dispatch keys all pointers as "ptr").
; Casting to u64, NOT i64: `icmp-*` signedness is read off the operand type, and an
; address is unsigned — a signed compare would invert above 2^63.
; Dispatch tries the receiver's own type before auto-dereferencing, so `(< p q)`
; reaches THESE impls and compares addresses; it never peels to the pointee's `Ord`.
(impl [T] Eq (ptr T)
  (= [(a (ptr T)) (b (ptr T))] (-> bool) (primitive/icmp-eq (primitive/cast u64 a) (primitive/cast u64 b))))
(impl [T] Ord (ptr T)
  (< [(a (ptr T)) (b (ptr T))] (-> bool) (primitive/icmp-lt (primitive/cast u64 a) (primitive/cast u64 b)))
  (<= [(a (ptr T)) (b (ptr T))] (-> bool) (primitive/icmp-le (primitive/cast u64 a) (primitive/cast u64 b)))
  (> [(a (ptr T)) (b (ptr T))] (-> bool) (primitive/icmp-gt (primitive/cast u64 a) (primitive/cast u64 b)))
  (>= [(a (ptr T)) (b (ptr T))] (-> bool) (primitive/icmp-ge (primitive/cast u64 a) (primitive/cast u64 b))))

; ---- bitwise, as traits ----------------------------------------------------
; Bit operators `& | ^ << >>`, dispatched by type and inlined to the
; core op — so `(& op 0xC7)` reads like C's `op & 0xC7` with no overhead. (Unary
; bitwise-not has no operator: `~` is the reader's unquote; use `(^ a -1)`.)
(deftrait BitAnd [Self] (& [(a Self) (b Self)] (-> Self)))
(deftrait BitOr [Self] (| [(a Self) (b Self)] (-> Self)))
(deftrait BitXor [Self] (^ [(a Self) (b Self)] (-> Self)))
(deftrait Shl [Self] (<< [(a Self) (b Self)] (-> Self)))
(deftrait Shr [Self] (>> [(a Self) (b Self)] (-> Self)))

(impl BitAnd i64 (& [(a i64) (b i64)] (-> i64) (primitive/iand a b)))
(impl BitOr i64 (| [(a i64) (b i64)] (-> i64) (primitive/ior a b)))
(impl BitXor i64 (^ [(a i64) (b i64)] (-> i64) (primitive/ixor a b)))
(impl Shl i64 (<< [(a i64) (b i64)] (-> i64) (primitive/ishl a b)))
(impl Shr i64 (>> [(a i64) (b i64)] (-> i64) (primitive/ishr a b)))

; And for every other width. `>>` is the one to be careful with: `ishr` emits an
; ARITHMETIC shift for a signed operand and a LOGICAL one for an unsigned operand,
; which is what makes `(>> x 1)` mean the right thing for both — a u64 shifted
; right does not smear sign bits, and an i64 still does.
(impl BitAnd i8 (& [(a i8) (b i8)] (-> i8) (primitive/iand a b)))
(impl BitOr i8 (| [(a i8) (b i8)] (-> i8) (primitive/ior a b)))
(impl BitXor i8 (^ [(a i8) (b i8)] (-> i8) (primitive/ixor a b)))
(impl Shl i8 (<< [(a i8) (b i8)] (-> i8) (primitive/ishl a b)))
(impl Shr i8 (>> [(a i8) (b i8)] (-> i8) (primitive/ishr a b)))
(impl BitAnd i16 (& [(a i16) (b i16)] (-> i16) (primitive/iand a b)))
(impl BitOr i16 (| [(a i16) (b i16)] (-> i16) (primitive/ior a b)))
(impl BitXor i16 (^ [(a i16) (b i16)] (-> i16) (primitive/ixor a b)))
(impl Shl i16 (<< [(a i16) (b i16)] (-> i16) (primitive/ishl a b)))
(impl Shr i16 (>> [(a i16) (b i16)] (-> i16) (primitive/ishr a b)))
(impl BitAnd i32 (& [(a i32) (b i32)] (-> i32) (primitive/iand a b)))
(impl BitOr i32 (| [(a i32) (b i32)] (-> i32) (primitive/ior a b)))
(impl BitXor i32 (^ [(a i32) (b i32)] (-> i32) (primitive/ixor a b)))
(impl Shl i32 (<< [(a i32) (b i32)] (-> i32) (primitive/ishl a b)))
(impl Shr i32 (>> [(a i32) (b i32)] (-> i32) (primitive/ishr a b)))
(impl BitAnd u8 (& [(a u8) (b u8)] (-> u8) (primitive/iand a b)))
(impl BitOr u8 (| [(a u8) (b u8)] (-> u8) (primitive/ior a b)))
(impl BitXor u8 (^ [(a u8) (b u8)] (-> u8) (primitive/ixor a b)))
(impl Shl u8 (<< [(a u8) (b u8)] (-> u8) (primitive/ishl a b)))
(impl Shr u8 (>> [(a u8) (b u8)] (-> u8) (primitive/ishr a b)))
(impl BitAnd u16 (& [(a u16) (b u16)] (-> u16) (primitive/iand a b)))
(impl BitOr u16 (| [(a u16) (b u16)] (-> u16) (primitive/ior a b)))
(impl BitXor u16 (^ [(a u16) (b u16)] (-> u16) (primitive/ixor a b)))
(impl Shl u16 (<< [(a u16) (b u16)] (-> u16) (primitive/ishl a b)))
(impl Shr u16 (>> [(a u16) (b u16)] (-> u16) (primitive/ishr a b)))
(impl BitAnd u32 (& [(a u32) (b u32)] (-> u32) (primitive/iand a b)))
(impl BitOr u32 (| [(a u32) (b u32)] (-> u32) (primitive/ior a b)))
(impl BitXor u32 (^ [(a u32) (b u32)] (-> u32) (primitive/ixor a b)))
(impl Shl u32 (<< [(a u32) (b u32)] (-> u32) (primitive/ishl a b)))
(impl Shr u32 (>> [(a u32) (b u32)] (-> u32) (primitive/ishr a b)))
(impl BitAnd u64 (& [(a u64) (b u64)] (-> u64) (primitive/iand a b)))
(impl BitOr u64 (| [(a u64) (b u64)] (-> u64) (primitive/ior a b)))
(impl BitXor u64 (^ [(a u64) (b u64)] (-> u64) (primitive/ixor a b)))
(impl Shl u64 (<< [(a u64) (b u64)] (-> u64) (primitive/ishl a b)))
(impl Shr u64 (>> [(a u64) (b u64)] (-> u64) (primitive/ishr a b)))

; ---- collections, as traits -------------------------------------------------
; The everyday collection vocabulary — `(len xs)`, `(get xs k)`, `(push! xs v)`
; — dispatched by the receiver's type, like the operators above. These traits
; are PARAMETERIZED: after `Self`, the extra type parameters (an element type, a
; map's key/value) are DETERMINED by Self — one impl per type, so a call on a
; concrete receiver reads them off that type's impl (associated types with a
; lighter surface). Impls live with their types: src/stdlib/arraylist.coil,
; src/stdlib/slice.coil ((slice T) covers strings), src/stdlib/hashmap.coil,
; src/stdlib/str.coil. Code/CodeBuilder impls live below: finished syntax is an
; immutable collection of Code children, while an unfinished builder is only a
; Push sink. That preserves the metaprogram borrow/build/promote boundary.
(deftrait Len [Self]
  (len [(xs Self)] (-> i64)))
; K = how you address an element (i64 for lists/slices, the key type for maps);
; E = what you get back (a map returns (Option V) — absence is in the type).
(deftrait Get [Self K E]
  (get [(xs Self) (k K)] (-> E)))
(deftrait Set [Self K E]
  (set! [(xs (mut Self)) (k K) (v E)] (-> i64)))
(deftrait Push [Self E]
  (push! [(xs (mut Self)) (v E)] (-> i64)))
(deftrait Pop [Self E]
  (pop! [(xs (mut Self))] (-> (Option E))))

; ---- iteration, as traits (gen-1 · std-11 · std-4) --------------------------
; The ONE iteration protocol, replacing the per-collection `slice-for`/`al-for`/
; `hm-for` macros. `Item`/`It` are ASSOCIATED types (determined by the impl —
; associated-type bounds, gen-1): `(next it)` yields the next `Item` or `(None)` at
; the end; `(iter xs)` produces a fresh iterator `It` over a collection. `(for x
; (iter coll))` (src/stdlib/control.coil) drives them uniformly. Impls live with their
; types (src/stdlib/slice.coil covers slices+strings, src/stdlib/arraylist.coil, src/stdlib/hashmap.coil).
; A generic can be bounded `(I Iterator)` and consume any iterator (its element type
; stays abstract), exactly like `(C Len)` — the pattern user collection code copies.
(deftrait Iterator [Self Item]
  (next [(it (mut Self))] (-> (Option Item))))
(deftrait Iterable [Self It]
  (iter [(xs Self)] (-> It)))

; Finished syntax participates in the same read-only collection protocol as a
; slice or ArrayList. `code-nth` returns the original syntax object, so iteration
; preserves source provenance and identifier identity; it never round-trips
; through strings. Scalars have collection count zero; code-count itself remains
; strict to lists and vectors. Views
; (`code-rest`/`code-slice`) remain O(1) and are walked without flattening. The
; iterator is itself the remaining Code view, so it needs no runtime-layout
; wrapper containing a comptime-only Code field.
(defn code-child-count [(xs Code)] (-> i64)
  (if (or (primitive/code-list? xs) (primitive/code-vector? xs))
      (primitive/code-count xs)
      0))
(impl Len Code
  (len [(xs Code)] (-> i64) (code-child-count xs)))
(impl Get Code
  (get [(xs Code) (i i64)] (-> Code) (primitive/code-nth xs i)))
(impl Iterable Code
  (iter [(xs Code)] (-> Code) xs))
(impl Iterator Code
  (next [(it (mut Code))] (-> (Option Code))
    (if (> (code-child-count (load it)) 0)
        (let [item (primitive/code-nth (load it) 0)]
          (set! it (primitive/code-rest (load it)))
          (Some item))
        (None))))

; CodeBuilder is deliberately NOT readable or iterable: only freezing establishes
; an immutable Code value. It can nevertheless be the destination of ordinary
; Push-based collection code. The mut receiver adapts the common collection trait
; to the builder's arena-owned handle; code-list-push! itself still enforces that
; only a live builder can be mutated.
(impl Push CodeBuilder
  (push! [(xs (mut CodeBuilder)) (v Code)] (-> i64)
    (do (primitive/code-list-push! (load xs) v) 0)))

;; Append all children of finished Code to a builder through the ordinary
;; Iterator/Push vocabulary. This concrete helper is intentional: Coil cannot yet
;; express the associated-type equality required by a fully generic `extend`.
(defn code-extend! [(out CodeBuilder) (source Code)] (-> CodeBuilder)
  (let [(mut sink) out
        (mut it) (iter source)]
    (loop (match (next (mut it))
            (None [] (break))
            (Some [item] (push! (mut sink) item))))
    (load sink)))

;; Build and freeze a list containing SOURCE's children, preserving syntax
;; identity and order. Views remain O(1) while read; only builder growth copies
;; element handles into the new list.
(defn code-collect [(source Code)] (-> Code)
  (primitive/code-list-done
    (code-extend! (primitive/code-list-new) source)))

; Emptiness, generically: any type with a Len impl gets `empty?` for free (a
; bounded generic over a trait — the pattern user code can copy).
(defn empty? [(C Len)] [(xs C)] (-> bool)
  (primitive/icmp-eq (len xs) 0))
