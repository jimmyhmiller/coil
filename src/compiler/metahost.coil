; src/compiler/metahost.coil — the HOST side of the compiled-metaprogram boundary.
;
; metashim.coil (compiled INTO each metaprogram dylib) declares coil_meta_* externs;
; this module implements and export-c's them, so they bind at dlopen against the
; compiler process (linked with -Wl,-export_dynamic). Parity with the interpreter
; is by CONSTRUCTION: every code op crossing the boundary is rebuilt as real CtVals
; and dispatched to comptime.coil's own `code-op` with the same CtCtx the
; interpreter would have used — including its runtime errors, verbatim.
;
; A failing op (the interpreter's Err) records the Diag in MetaHostBox and
; terminates the METAPROGRAM THREAD via pthread_exit — never the pipeline thread.
; The engine (metaengine in expander.coil) always runs a compiled metaprogram on
; its own thread, joins it, and turns a recorded Diag into the ordinary
; expand-macro Err, so `(primitive/error ...)`/bad-op behavior is byte-identical to the
; interpreter's from the pipeline's point of view.
(module metahost)
(import "coil.primitive" :as primitive)

(import "coil.alloc" :as alloc :use *)
(import "coil.slice" :use *)
(import "coil.str" :use *)
(import "coil.mem" :use *)
(import "coil.arraylist" :use *)
(import "coil.result" :use *)
(import "coil.io" :use *)
(import "coil.fmt" :use *)
(import "coil.reader" :use *)
(import "parser" :use *)
(import "ast" :use *)
(import "codelib" :as codelib)
(import "ctval" :use *)  ; CtVal / EnvBind / CtCtx (was reached via comptime.coil)
(import "resolve" :use *)
(import "comptime" :use *)
(import "diag" :use *)
(import "ffi" :use *)

(extern pthread_exit :cc c [(ptr i8)] (-> i64))

; ---- per-call context ---------------------------------------------------------
; Set by the engine immediately before invoking a compiled metaprogram entry, read
; by every callback below (the callbacks run on the metaprogram thread while the
; engine blocks in pthread_join, so the stack-allocated CtCtx stays alive).
(defstruct MetaHostBox
  [(cx (ptr CtCtx))
   (registry (ptr (ArrayList (ptr Sexp))))
   (errset i64)
   (err Diag)
   (onmain i64)
   (interp i64)  ; 1 ⇒ metaprogram runs via the in-process interpreter (interp.coil)
   (halt i64)  ; set by mh-halt in interp mode; polled by vm-exec to unwind cleanly
   (callbacks i64)
   (boxed-sexps i64)
   (qq-pushes i64)
   (consume-root i64)])
(defn meta-host-box [] (-> (ptr MetaHostBox))
  (alloc/static MetaHostBox))
(defn meta-host-set! [(cx (ptr CtCtx)) (registry (ptr (ArrayList (ptr Sexp))))] (-> i64)
  (let [b (meta-host-box)]
    (store! (field b cx) cx)
    (store! (field b registry) registry)
    (store! (field b errset) 0)
    (store! (field b callbacks) 0)
    (store! (field b boxed-sexps) 0)
    (store! (field b qq-pushes) 0)
    (store! (field b consume-root) 0)
    0))
(defn meta-host-onmain! [(v i64)] (-> i64)
  (store! (field (meta-host-box) onmain) v)
  0)
; interpreter meta path: mark it active and clear the abort flag before an entry runs.
(defn meta-host-interp! [(v i64)] (-> i64)
  (let [b (meta-host-box)] (store! (field b interp) v) (store! (field b halt) 0) 0))
(defn mh-interp-halted? [] (-> i64)
  (load (field (meta-host-box) halt)))
(defn meta-host-err [] (-> (Option Diag))
  (let [b (meta-host-box)]
    (if (= (load (field b errset)) (primitive/cast i64 0))
        (None [Diag])
        (Some (load (field b
                           err))))))

; A persistent metaprogram worker normally signals completion after an entry
; returns. `(primitive/error ...)` exits that pthread from inside this module, so
; it cannot reach the normal signal. The engine installs this tiny wakeup hook for
; the duration of a worker call; null means the historical one-shot path.
(defstruct MetaAbortHook [(fp (ptr i8)) (ctx (ptr i8))])
(defn meta-abort-hook [] (-> (ptr MetaAbortHook))
  (alloc/static MetaAbortHook))
(defn meta-host-abort-hook! [(fp (ptr i8)) (ctx (ptr i8))] (-> i64)
  (let [h (meta-abort-hook)]
    (store! (field h fp) fp)
    (store! (field h ctx) ctx)
    0))
(defn meta-host-signal-abort [] (-> i64)
  (let [h (meta-abort-hook)
        fp (load (field h fp))]
    (when (!= (primitive/cast i64 fp) (primitive/cast i64 0))
      (primitive/call-ptr (primitive/cast (fnptr c [(ptr i8)] i64) fp)
                          (load (field h ctx)))
      0)
    0))

; A compiler bug in the boundary itself (unset context, impossible shapes) must be
; LOUD and immediate — never a metaprogram-level diagnostic.
(defn mh-bug [(msg (slice u8))] (-> i64)
  (fmt (stderr) "metahost: {s} (compiler bug)\n" msg)
  (abort))

; A metaprogram-level failure: exactly what the interpreter would have returned as
; Err. Record it and end the metaprogram thread; the engine reports it identically.
; Under COIL_META_MAIN=1 the metaprogram runs on the process MAIN thread — there is
; no thread to end, so print the diagnostic and fail the build directly.
(defn mh-halt [(d Diag)] (-> i64)
  (let [b (meta-host-box)]
    (if (!= (load (field b interp)) (primitive/cast i64 0))
        ; interpreter meta path: record the diag and request a cooperative VM abort.
        ; We run in-process on the pipeline thread, so pthread_exit would kill the
        ; whole compile; instead set halt and let vm-exec unwind (mp-op-* then returns
        ; here into the metalowered (loop 0), but the abort poll breaks out first).
        (do
          (store! (field b err) d)
          (store! (field b errset) 1)
          (store! (field b
                         halt)
                  1)
          0)
        (if (!= (load (field b onmain)) (primitive/cast i64 0))
            (do
              (fmt (stderr) "error: {s}\n" (load (field d msg)))
              (exit 1)
              0)
            (do
              (store! (field b err) d)
              (store! (field b errset) 1)
              (meta-host-signal-abort)
              (pthread_exit (primitive/cast (ptr i8) 1)))))))

(defn mh-cx [] (-> (ptr CtCtx))
  (let [b (meta-host-box)
        cx (load (field b cx))]
    (if (= (primitive/cast i64 cx) (primitive/cast i64 0))
        (do (mh-bug "code-op callback with no metaprogram context") (primitive/cast (ptr CtCtx) 0))
        cx)))

(defn mh-allocator [] (-> (ptr Allocator))
  (load (field (mh-cx) a)))
(defn mh-count! [] (-> i64)
  (let [p (field (meta-host-box) callbacks)]
    (store! p (primitive/iadd (load p) 1))
    0))
(defn meta-host-callbacks [] (-> i64) (load (field (meta-host-box) callbacks)))
(defn meta-host-boxed-sexps [] (-> i64) (load (field (meta-host-box) boxed-sexps)))
(defn meta-host-qq-pushes [] (-> i64) (load (field (meta-host-box) qq-pushes)))
(defn meta-host-consume-root? [] (-> bool)
  (!= (load (field (meta-host-box) consume-root)) (primitive/cast i64 0)))

(defn mh-box-sexp [(s Sexp)] (-> (ptr i8))
  (mh-count!)
  (let [count (field (meta-host-box) boxed-sexps)
        p (unwrap-ptr [Sexp] (create [Sexp] (mh-allocator)))]
    (store! count (primitive/iadd (load count) 1))
    (store! p s)
    (primitive/cast (ptr i8) p)))
(defn mh-handle-sexp [(c (ptr i8))] (-> Sexp)
  (if (= (primitive/cast i64 c) (primitive/cast i64 0))
      (do (mh-bug "null Code handle") (primitive/zeroed Sexp))
      (load (primitive/cast (ptr Sexp) c))))

; Typed structural Code callbacks. These are the metaprogram hot path: keep the
; generic CtVal dispatcher for the full reflective API, but do not allocate and
; box an argument list merely to inspect an S-expression node.
(defn mh-code-list? [(c (ptr i8))] (-> i64)
  ;; Keep the compiled metaprogram ABI identical to codelib's Code API:
  ;; `code-list?` means a proper pair chain ending in nil. Vectors are tested
  ;; by `code-vector?`, and arbitrary cons cells by `code-pair?`. The former
  ;; tag-only test answered true for both vectors and improper pairs, making a
  ;; guarded `code-count` fail depending on which metaprogram backend ran it.
  (let [sx (mh-handle-sexp c)
        p (alloc/stack Sexp)]
    (store! p sx)
    (if (codelib/code-proper-list? p) 1 0)))
(defn mh-code-sym? [(c (ptr i8))] (-> i64)
  (if (= (sx-tag (mh-handle-sexp c)) (primitive/cast i64 2)) 1 0))
(defn mh-code-int? [(c (ptr i8))] (-> i64)
  (if (= (sx-tag (mh-handle-sexp c)) (primitive/cast i64 0)) 1 0))
(defn mh-code-keyword? [(c (ptr i8))] (-> i64)
  (if (= (sx-tag (mh-handle-sexp c)) (primitive/cast i64 3)) 1 0))
(defn mh-code-count [(c (ptr i8))] (-> i64)
  (let [x (primitive/cast (ptr Sexp) c)]
    (match (load (field x kind))
      (KVec [items] (al-len [Sexp] (load items)))
      (KNil [] 0)
      (KPair [root]
        (let [(mut pair) root (mut n) 1 (mut done) false (mut proper) false]
          (loop
            (if (load done) (break)
                (match (load (field (field (load pair) tail) kind))
                  (KPair [next]
                    (do (store! pair next) (store! n (primitive/iadd (load n) 1)) 0))
                  (KNil [] (do (store! proper true) (store! done true) 0))
                  (_ (do (store! done true) 0)))))
          (if (load proper) (load n)
              (do (mh-halt (derr "comptime: code-count expects a proper list/vector")) 0))))
      (_ (do (mh-halt (derr "comptime: code-count expects a list/vector")) 0)))))
(defn mh-code-nth [(c (ptr i8)) (i i64)] (-> (ptr i8))
  (let [x (primitive/cast (ptr Sexp) c)]
    (if (< i (primitive/cast i64 0))
        (do (mh-halt (derr "comptime: code-nth index out of range")) (primitive/cast (ptr i8) 0))
        (match (load (field x kind))
          (KVec [items]
            (if (>= i (al-len [Sexp] (load items)))
                (do (mh-halt (derr "comptime: code-nth index out of range")) (primitive/cast (ptr i8) 0))
                (primitive/cast (ptr i8) (al-elem [Sexp] items i))))
          (KPair [root]
            (let [(mut pair) root (mut at) 0 (mut out) (primitive/cast (ptr i8) 0)]
              (loop
                (if (= (load at) i)
                    (do (store! out (primitive/cast (ptr i8) (field (load pair) head))) (break))
                    (match (load (field (field (load pair) tail) kind))
                      (KPair [next]
                        (do (store! pair next) (store! at (primitive/iadd (load at) 1)) 0))
                      (_ (break)))))
              (if (= (primitive/cast i64 (load out)) 0)
                  (do (mh-halt (derr "comptime: code-nth index out of range")) (primitive/cast (ptr i8) 0))
                  (load out))))
          (KNil [] (do (mh-halt (derr "comptime: code-nth index out of range")) (primitive/cast (ptr i8) 0)))
          (_ (do
               (mh-halt
                 (derr
                   (sconcat (mh-allocator)
                            "comptime: code-nth expects a list/vector, got atom: "
                            (sx-sval (load x)))))
               (primitive/cast (ptr i8) 0)))))))
(defn mh-code-eq [(x (ptr i8)) (y (ptr i8))] (-> i64)
  (if (sexp-eq (mh-handle-sexp x) (mh-handle-sexp y)) 1 0))

; Return handles directly into the authoritative pair spine. Their lifetime is
; the containing syntax tree's lifetime, so traversal creates no scratch boxes.
(defn mh-code-car [(c (ptr i8))] (-> (ptr i8))
  (match (load (field (primitive/cast (ptr Sexp) c) kind))
    (KPair [pair] (primitive/cast (ptr i8) (field pair head)))
    (_ (do (mh-halt (derr "comptime: code-car expects a non-empty list"))
           (primitive/cast (ptr i8) 0)))))
(defn mh-code-cdr [(c (ptr i8))] (-> (ptr i8))
  (match (load (field (primitive/cast (ptr Sexp) c) kind))
    (KPair [pair] (primitive/cast (ptr i8) (field pair tail)))
    (_ (do (mh-halt (derr "comptime: code-cdr expects a pair"))
           (primitive/cast (ptr i8) 0)))))
(defn mh-code-set-nth [(c (ptr i8)) (i i64) (v (ptr i8))] (-> (ptr i8))
  (match (ct-set-code-nth! (primitive/cast (ptr Sexp) c) i (mh-handle-sexp v))
    (Some [_] c)
    (None [] (do (mh-halt (derr "comptime: code-set-nth! index out of range or container is not a list/vector")) c))))
(defn mh-code-set-car [(c (ptr i8)) (v (ptr i8))] (-> (ptr i8))
  (match (load (field (primitive/cast (ptr Sexp) c) kind))
    (KPair [pair]
      (do (ct-clear-code-flat! pair)
          (store! (field pair head) (mh-handle-sexp v)) c))
    (_ (do (mh-halt (derr "comptime: code-set-car! expects a pair")) c))))
(defn mh-code-prepend [(c (ptr i8)) (v (ptr i8))] (-> (ptr i8))
  (let [x (primitive/cast (ptr Sexp) c)]
    (match (load (field x kind))
      (KPair [pair]
        (let [a (mh-allocator)
              newpair (unwrap-ptr [SexpPair] (create [SexpPair] a))]
          (ct-clear-code-flat! pair)
          (store! (field newpair head) (load (field pair head)))
          (store! (field newpair tail) (load (field pair tail)))
          (store! (field newpair owner) a)
          (store! (field newpair flat) (primitive/zeroed (ptr (ArrayList Sexp))))
          (store! (field pair head) (mh-handle-sexp v))
          (store! (field pair tail) (mk-sexp-src (KPair newpair) x)) c))
      (_ (do (mh-halt (derr "comptime: code-prepend! expects a non-empty list")) c)))))

; String results cross as a host-owned {ptr,len} — layout mirrored in metashim.coil.
(defstruct MetaBuf [(p (ptr u8)) (n i64)])
(defn mh-buf [(s (slice u8))] (-> (ptr i8))
  (mh-count!)
  (let [b (unwrap-ptr [MetaBuf] (create [MetaBuf] (mh-allocator)))]
    (store! (field b p) (slice-data s))
    (store! (field b n) (slice-len s))
    (primitive/cast (ptr i8) b)))

; ---- code-op argument builder (a boxed ArrayList CtVal) ------------------------
; A metaprogram's argument lists are strictly LIFO. metalower nests the builder
; chain — (mp-op-h OP (mp-arg-i (mp-arg-c (mp-arg-new) X) 0)) — so if evaluating X
; runs a nested op, that op's list is created AND consumed entirely before the outer
; list is filled any further. And exactly one metaprogram runs at a time
; (meta-engine-invoke is a pthread_create immediately followed by pthread_join), so
; one process-wide stack of reusable lists is enough; no per-thread state needed.
;
; Reusing them matters because no code op takes more than three arguments (nothing in
; comptime.coil reads past `cv-get args 2`), so the growable list never actually grew
; — it just cost a malloc for the ArrayList box and another for its first buffer, on
; EVERY code op. After the first few ops each depth's list has capacity and the whole
; arg-passing path is allocation-free. `al-clear!` keeps that capacity.
;
; The syntax expander deliberately permits 4096 nested rewrite levels. A 64-slot
; pool made every callback below that boundary allocate a fresh malloc-backed list,
; while pop merely decremented depth; realistic generated syntax therefore leaked
; millions of tiny lists during one invocation. Keep a bounded margin above the
; language limit so all valid nesting reuses its per-depth list.
(defstruct ArgPool [(depth i64) (slots (array (ptr (ArrayList CtVal)) 65536))])
(defn arg-pool [] (-> (ptr ArgPool))
  (alloc/static ArgPool))
(defn mh-arg-new [] (-> (ptr i8))
  (let [p (arg-pool)
        d (load (field p depth))]
    (if (>= d (primitive/cast i64 65536))
        (let [cx (load (field (meta-host-box) cx))
              a (load (field cx a))]
          ; The exceptional depth remains bounded by the current invocation.
          ; Pop cannot individually recover these lists, so allocating them from
          ; malloc would leak until process exit; the invocation arena releases
          ; them all together when the metaprogram returns.
          (store! (field p depth) (primitive/iadd d 1))
          (primitive/cast (ptr i8) (box-al [CtVal] a (al-new [CtVal] a))))
        (let [sp (primitive/index (field p slots) d)]
          (if (= (primitive/cast i64 (load sp)) (primitive/cast i64 0))
              (store! sp (box-al [CtVal] (malloc-allocator) (al-new [CtVal] (malloc-allocator))))
              (al-clear! [CtVal] (mut (load sp))))
          (store! (field p depth) (primitive/iadd d 1))
          (primitive/cast (ptr i8) (load sp))))))
; Pop the innermost list. Called once the op has run: code-op's result never points
; into the argument list (it returns Sexp handles and slices into Sexp-owned memory),
; so the list is dead the moment code-op returns. A failing op halts the metaprogram
; thread inside code-op and never gets here, which is fine — that thread is over.
(defn mh-arg-pop! [] (-> i64)
  (let [p (arg-pool)
        d (load (field p depth))]
    (when (> d (primitive/cast i64 0)) (store! (field p depth) (primitive/isub d 1)))
    0))
(defn mh-arg-push [(b (ptr i8)) (v CtVal)] (-> (ptr i8))
  (do (al-push! [CtVal] (primitive/cast (ptr (ArrayList CtVal)) b) v) b))
(defn mh-arg-c [(b (ptr i8)) (c (ptr i8))] (-> (ptr i8))
  (mh-arg-push b (CCode (mh-handle-sexp c))))
(defn mh-arg-i [(b (ptr i8)) (v i64)] (-> (ptr i8))
  (mh-arg-push b (CInt v)))
(defn mh-arg-s [(b (ptr i8)) (p (ptr u8)) (n i64)] (-> (ptr i8))
  (mh-arg-push b (CStr (slice-new p n))))
(defn mh-arg-b [(b (ptr i8)) (v i64)] (-> (ptr i8))
  (mh-arg-push b (CBool (!= v (primitive/cast i64 0)))))
(defn mh-arg-f [(b (ptr i8)) (x f64)] (-> (ptr i8))
  (mh-arg-push b (CFloat x)))

; ---- run an op through the interpreter's own dispatch --------------------------
(defn mh-run [(op i64) (b (ptr i8))] (-> CtVal)
  (match (code-op op (primitive/cast (ptr (ArrayList CtVal)) b) (mh-cx))
    (Err [d] (do (mh-halt d) (CInt 0)))
    (Ok [v] (do (mh-arg-pop!) v))))
(defn mh-op-i [(op i64) (b (ptr i8))] (-> i64)
  (match (mh-run op b) (CInt [n] n) (CBool [x] (when x 1)) (_ (do (mh-bug "code-op result is not an int/bool") 0))))
(defn mh-op-h [(op i64) (b (ptr i8))] (-> (ptr i8))
  ; Some ops are TYPED Code but the interpreter returns a scalar (report/warn
  ; yield CInt 0). Coerce exactly as the interpreter would: ctval->sexp — its
  ; own value->code conversion, including its own error on aggregates.
  (let [v (mh-run op b)]
    (when (= op (primitive/cast i64 73))
      (store! (field (meta-host-box) consume-root) 1) 0)
    (match v
      (CCode [c] (mh-box-sexp c))
      (_ (match (ctval->sexp v)
           (Ok [sx] (mh-box-sexp sx))
           (Err [d] (do (mh-halt d) (primitive/cast (ptr i8) 0))))))))
(defn mh-op-s [(op i64) (b (ptr i8))] (-> (ptr i8))
  (match (mh-run op b)
    (CStr [s] (mh-buf s))
    (_ (do (mh-bug "code-op result is not a string") (primitive/cast (ptr i8) 0)))))

; ---- quote registry -------------------------------------------------------------
; metalower collects every EQuote/QLit form (int lowering order) into a registry of
; stable (ptr Sexp); index k is baked into the dylib as (mp-quoted k). The handle
; aliases the AST's own node — same sharing the interpreter's (CCode (primitive/load form)).
(defn mh-quoted [(k i64)] (-> (ptr i8))
  (let [b (meta-host-box)
        reg (load (field b registry))]
    (if (= (primitive/cast i64 reg) (primitive/cast i64 0))
        (do (mh-bug "quote registry unset") (primitive/cast (ptr i8) 0))
        (if (or (< k (primitive/cast i64 0)) (>= k (al-len [(ptr Sexp)] (load reg))))
            (do (mh-bug "quote registry index out of range") (primitive/cast (ptr i8) 0))
            (primitive/cast (ptr i8) (al-get [(ptr Sexp)] (load reg) k))))))

; ---- quasiquote builder -----------------------------------------------------------
; Keep the final splice as a persistent tail. The overwhelmingly common recursive
; list builder is `(~head ~@tail)`; copying `tail` here made every such walker O(n²)
; even after Code itself gained pairs.
(defstruct MhQQ
  [(items (ptr (ArrayList Sexp)))
   (tail (ptr Sexp))
   (has-tail bool)])
(defn mh-qq-new [] (-> (ptr i8))
  (mh-count!)
  (let [a (mh-allocator)
        q (unwrap-ptr [MhQQ] (create [MhQQ] a))]
    (store! (field q items) (box-al [Sexp] a (al-new [Sexp] a)))
    (store! (field q tail) (primitive/zeroed (ptr Sexp)))
    (store! (field q has-tail) false)
    (primitive/cast (ptr i8) q)))
(defn mh-qq-append-code! [(q (ptr MhQQ)) (s Sexp)] (-> i64)
  (let [items (sx-items s) n (sx-len items) (mut i) 0]
    (loop (if (>= (load i) n) (break)
            (do (al-push! [Sexp] (load (field q items)) (sx-at items (load i)))
                (store! i (primitive/iadd (load i) 1))))))
  0)
(defn mh-qq-flush-tail! [(q (ptr MhQQ))] (-> i64)
  (when (load (field q has-tail))
    (mh-qq-append-code! q (load (load (field q tail))))
    (store! (field q tail) (primitive/zeroed (ptr Sexp)))
    (store! (field q has-tail) false)
    0)
  0)
(defn mh-qq-push [(b (ptr i8)) (c (ptr i8))] (-> (ptr i8))
  (mh-count!)
  (let [count (field (meta-host-box) qq-pushes)
        q (primitive/cast (ptr MhQQ) b)]
    (store! count (primitive/iadd (load count) 1))
    (mh-qq-flush-tail! q)
    (al-push! [Sexp] (load (field q items)) (mh-handle-sexp c))
    b))
(defn mh-qq-splice [(b (ptr i8)) (c (ptr i8))] (-> (ptr i8))
  (mh-count!)
  (let [s (mh-handle-sexp c)
        tg (sx-tag s)
        q (primitive/cast (ptr MhQQ) b)]
    (if (not (or (= tg (primitive/cast i64 6)) (= tg (primitive/cast i64 7))))
        (do (mh-halt (derr "comptime: ~@ splice expects a Code list")) b)
        (do
          (mh-qq-flush-tail! q)
          (store! (field q tail) (primitive/cast (ptr Sexp) c))
          (store! (field q has-tail) true)
          b))))
; The head-qualification half of the interpreter's qualify-head. The "head is a
; LITERAL symbol in the template" guard is decided at LOWER time (metalower emits
; qq_listq only then), so only the resolution half lives here — same tables, same
; rewrite, via the CtCtx the interpreter would have consulted.
(defn mh-qualify-head! [(items (ptr (ArrayList Sexp)))] (-> i64)
  (let [cx (mh-cx)]
    (unless (= (al-len [Sexp] (load items)) (primitive/cast i64 0))
      (match (load (field cx qmodule))
        (None [] 0)
        (Some [m]
              (unless (= (primitive/cast i64 (load (field cx module_fns))) (primitive/cast i64 0))
                (let [hp (al-elem [Sexp] items 0)]
                  (unless (!= (sx-tag (load hp)) (primitive/cast i64 2))
                    (let [name (sx-sval (load hp))]
                      (unless (or (has-dot name) (>= (find-slash name) (primitive/cast i64 0)))
                        (match (resolve-in-module cx name m)
                          (None [] 0)
                          (Some [q] (do (store! (field hp kind) (KSym q)) 0)))))))))))))
(defn mh-qq-list [(b (ptr i8))] (-> (ptr i8))
  (let [q (primitive/cast (ptr MhQQ) b)
        a (mh-allocator)
        items (load (field q items))
        n (al-len [Sexp] (load items))
        (mut out) (if (load (field q has-tail))
                      (load (load (field q tail)))
                      (mk-sexp (KNil) -1 -1))
        (mut i) (primitive/isub n 1)]
    ; A vector splice cannot be the cdr of a list; materialize it exactly as the
    ; old builder did. A list splice remains the exact shared tail.
    (when (and (load (field q has-tail))
               (= (sx-tag (load out)) (primitive/cast i64 7)))
      (mh-qq-flush-tail! q)
      (store! out (mk-sexp (KNil) -1 -1))
      (store! i (primitive/isub (al-len [Sexp] (load items)) 1))
      0)
    (loop (if (< (load i) 0) (break)
            (let [pair (unwrap-ptr [SexpPair] (create [SexpPair] a))]
              (store! (field pair head) (al-get [Sexp] (load items) (load i)))
              (store! (field pair tail) (load out))
              (store! (field pair owner) a)
              (store! (field pair flat) (primitive/zeroed (ptr (ArrayList Sexp))))
              (store! out (mk-sexp (KPair pair) -1 -1))
              (store! i (primitive/isub (load i) 1)))))
    (mh-box-sexp (load out))))
(defn mh-qq-listq [(b (ptr i8))] (-> (ptr i8))
  (do
    (mh-qualify-head! (load (field (primitive/cast (ptr MhQQ) b) items)))
    (mh-qq-list b)))
(defn mh-qq-vec [(b (ptr i8))] (-> (ptr i8))
  (let [q (primitive/cast (ptr MhQQ) b)]
    (mh-qq-flush-tail! q)
    (mh-box-sexp (mk-sexp (KVec (load (field q items))) -1 -1))))

; ---- unquote conversions: EXACTLY ctval->sexp's scalar arms ---------------------
(defn mh-unq-int [(v i64)] (-> (ptr i8))
  (mh-box-sexp (sx-mkint v)))
(defn mh-unq-bool [(v i64)] (-> (ptr i8))
  (mh-box-sexp (sx-sym (if (!= v (primitive/cast i64 0)) "true" "false"))))
(defn mh-unq-float [(x f64)] (-> (ptr i8))
  (mh-box-sexp (mk-sexp (KFloat (f64-bits x)) -1 -1)))
; COPY the bytes; do not borrow them.
;
; `(slice-new p n)` alone keeps the METAPROGRAM's pointer inside a Sexp that the compiler
; reads much later — at codegen, long after the generator that produced it returned.
; Whether that survived depended entirely on where the bytes happened to live: a string
; literal points into the metaprogram image (still mapped, so it worked), but
; `~(slice-new [u8] (index (mut s) 0) 4)` over a stack array in the generator points at a
; frame that is gone by then. `coil check` passed and `coil build` died with SIGSEGV and
; no diagnostic — and the quieter outcome, reading whatever now occupies that memory, is
; a miscompile.
;
; Every other value crossing this boundary is already copied into the compiler's own
; allocator (mh-box-sexp, mh-buf, the CtVal rebuilds). This one was the exception.
(defn mh-unq-str [(p (ptr u8)) (n i64)] (-> (ptr i8))
  (mh-count!)
  (let [a (mh-allocator)
        dst (unwrap-ptr [u8] (alloc-slice [u8] a (if (> n (primitive/cast i64 0)) n 1)))
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (store! (primitive/index dst (load i)) (load (primitive/index p (load i))))
                (store! i (primitive/iadd (load i) 1)))))
    (mh-box-sexp (sx-mkstr (slice-new dst n)))))

; ---- interpreter-parity runtime failures ----------------------------------------
; Sites the interpreter rejects only WHEN EVALUATED; metalower emits a call here so
; the compiled engine fails at the same moment with the same message.
(defn mh-fail [(code i64)] (-> i64)
  (cond (= code (primitive/cast i64 1)) (mh-halt (derr "comptime: can't unquote an aggregate value into code"))
        (= code (primitive/cast i64 2)) (mh-halt (derr "comptime: ~@ splice expects a Code list"))
        (= code (primitive/cast i64 3)) (mh-halt (derr "comptime: ~@ (splice) is only valid inside a list/vector"))
        :else (mh-bug "unknown failure code")))

; ---- the vtable handed to the dylib (see metashim.coil MetaVt — FIELD ORDER IS ABI)
(defstruct MetaVt
  [(arg_new (fnptr c [] (ptr i8)))
   (arg_c (fnptr c [(ptr i8) (ptr i8)] (ptr i8)))
   (arg_i (fnptr c [(ptr i8) i64] (ptr i8)))
   (arg_s (fnptr c [(ptr i8) (ptr u8) i64] (ptr i8)))
   (arg_b (fnptr c [(ptr i8) i64] (ptr i8)))
   (arg_f (fnptr c [(ptr i8) f64] (ptr i8)))
   (op_i (fnptr c [i64 (ptr i8)] i64))
   (op_h (fnptr c [i64 (ptr i8)] (ptr i8)))
   (op_s (fnptr c [i64 (ptr i8)] (ptr i8)))
   (quoted (fnptr c [i64] (ptr i8)))
   (qq_new (fnptr c [] (ptr i8)))
   (qq_push (fnptr c [(ptr i8) (ptr i8)] (ptr i8)))
   (qq_splice (fnptr c [(ptr i8) (ptr i8)] (ptr i8)))
   (qq_list (fnptr c [(ptr i8)] (ptr i8)))
   (qq_listq (fnptr c [(ptr i8)] (ptr i8)))
   (qq_vec (fnptr c [(ptr i8)] (ptr i8)))
   (unq_int (fnptr c [i64] (ptr i8)))
   (unq_bool (fnptr c [i64] (ptr i8)))
   (unq_float (fnptr c [f64] (ptr i8)))
   (unq_str (fnptr c [(ptr u8) i64] (ptr i8)))
   (fail (fnptr c [i64] i64))
   (code_list (fnptr c [(ptr i8)] i64))
   (code_sym (fnptr c [(ptr i8)] i64))
   (code_int (fnptr c [(ptr i8)] i64))
   (code_keyword (fnptr c [(ptr i8)] i64))
   (code_count (fnptr c [(ptr i8)] i64))
   (code_nth (fnptr c [(ptr i8) i64] (ptr i8)))
   (code_eq (fnptr c [(ptr i8) (ptr i8)] i64))
   (code_car (fnptr c [(ptr i8)] (ptr i8)))
   (code_cdr (fnptr c [(ptr i8)] (ptr i8)))
   (code_set_nth (fnptr c [(ptr i8) i64 (ptr i8)] (ptr i8)))
   (code_set_car (fnptr c [(ptr i8) (ptr i8)] (ptr i8)))
   (code_prepend (fnptr c [(ptr i8) (ptr i8)] (ptr i8)))])
; ---- WASM export surface (piece 1) --------------------------------------------
; When this compiler is itself built to wasm, a metaprogram compiles to a wasm
; SIDE-MODULE (codegen_wasm side-module mode) that the host instantiates sharing
; THIS module's linear memory. The side-module's metashim wrappers call the code-op
; callbacks below as env imports; the host bridges each `env.mh_*` to the compiler
; instance's exported `mh_*`. So the boundary is the SAME callbacks the native
; vtable holds — all raw scalar (ptr/i64/f64) ABI, no struct-by-value.
;
; These are THIN forwarding wrappers, deliberately NOT the mh-* functions
; themselves: meta-vtable takes the address of every mh-* via (primitive/fnptr-of …), and an
; export-c'd + address-taken function makes LLVM's wasm backend emit a GOT.func.*
; global import the single-unit finalizer cannot resolve. Keeping mh-* internal
; (their fnptr-of stays a plain TABLE_INDEX reloc) and export-c'ing wrappers that
; are never address-taken exports them by function index — no GOT.func. Native
; targets just carry 21 trivial extra thunks; gate-full is byte-unaffected (it
; diffs corpus emit-ir, not the compiler's own export table).
(defn mhx-arg-new [] (-> (ptr i8))
  (mh-arg-new))
(defn mhx-arg-c [(b (ptr i8)) (c (ptr i8))] (-> (ptr i8))
  (mh-arg-c b c))
(defn mhx-arg-i [(b (ptr i8)) (v i64)] (-> (ptr i8))
  (mh-arg-i b v))
(defn mhx-arg-s [(b (ptr i8)) (p (ptr u8)) (n i64)] (-> (ptr i8))
  (mh-arg-s b p n))
(defn mhx-arg-b [(b (ptr i8)) (v i64)] (-> (ptr i8))
  (mh-arg-b b v))
(defn mhx-arg-f [(b (ptr i8)) (x f64)] (-> (ptr i8))
  (mh-arg-f b x))
(defn mhx-op-i [(op i64) (b (ptr i8))] (-> i64)
  (mh-op-i op b))
(defn mhx-op-h [(op i64) (b (ptr i8))] (-> (ptr i8))
  (mh-op-h op b))
(defn mhx-op-s [(op i64) (b (ptr i8))] (-> (ptr i8))
  (mh-op-s op b))
(defn mhx-quoted [(k i64)] (-> (ptr i8))
  (mh-quoted k))
(defn mhx-qq-new [] (-> (ptr i8))
  (mh-qq-new))
(defn mhx-qq-push [(b (ptr i8)) (c (ptr i8))] (-> (ptr i8))
  (mh-qq-push b c))
(defn mhx-qq-splice [(b (ptr i8)) (c (ptr i8))] (-> (ptr i8))
  (mh-qq-splice b c))
(defn mhx-qq-list [(b (ptr i8))] (-> (ptr i8))
  (mh-qq-list b))
(defn mhx-qq-listq [(b (ptr i8))] (-> (ptr i8))
  (mh-qq-listq b))
(defn mhx-qq-vec [(b (ptr i8))] (-> (ptr i8))
  (mh-qq-vec b))
(defn mhx-unq-int [(v i64)] (-> (ptr i8))
  (mh-unq-int v))
(defn mhx-unq-bool [(v i64)] (-> (ptr i8))
  (mh-unq-bool v))
(defn mhx-unq-float [(x f64)] (-> (ptr i8))
  (mh-unq-float x))
(defn mhx-unq-str [(p (ptr u8)) (n i64)] (-> (ptr i8))
  (mh-unq-str p n))
(defn mhx-fail [(code i64)] (-> i64)
  (mh-fail code))
(defn mhx-code-list [(c (ptr i8))] (-> i64)
  (mh-code-list? c))
(defn mhx-code-sym [(c (ptr i8))] (-> i64)
  (mh-code-sym? c))
(defn mhx-code-int [(c (ptr i8))] (-> i64)
  (mh-code-int? c))
(defn mhx-code-keyword [(c (ptr i8))] (-> i64)
  (mh-code-keyword? c))
(defn mhx-code-count [(c (ptr i8))] (-> i64)
  (mh-code-count c))
(defn mhx-code-nth [(c (ptr i8)) (i i64)] (-> (ptr i8))
  (mh-code-nth c i))
(defn mhx-code-eq [(x (ptr i8)) (y (ptr i8))] (-> i64)
  (mh-code-eq x y))
(defn mhx-code-car [(c (ptr i8))] (-> (ptr i8)) (mh-code-car c))
(defn mhx-code-cdr [(c (ptr i8))] (-> (ptr i8)) (mh-code-cdr c))
(defn mhx-code-set-nth [(c (ptr i8)) (i i64) (v (ptr i8))] (-> (ptr i8))
  (mh-code-set-nth c i v))
(defn mhx-code-set-car [(c (ptr i8)) (v (ptr i8))] (-> (ptr i8))
  (mh-code-set-car c v))
(defn mhx-code-prepend [(c (ptr i8)) (v (ptr i8))] (-> (ptr i8))
  (mh-code-prepend c v))
; In-memory object loaders cannot assume the compiler executable exported every
; callback through its dynamic symbol table. Resolve the fixed metashim surface
; directly to ordinary in-process function addresses before consulting dlsym.
(defn meta-host-callback-symbol [(nm (slice u8))] (-> (ptr i8))
  (cond (= nm "mh_arg_new") (primitive/cast (ptr i8) (primitive/fnptr-of mhx-arg-new))
        (= nm "mh_arg_c") (primitive/cast (ptr i8) (primitive/fnptr-of mhx-arg-c))
        (= nm "mh_arg_i") (primitive/cast (ptr i8) (primitive/fnptr-of mhx-arg-i))
        (= nm "mh_arg_s") (primitive/cast (ptr i8) (primitive/fnptr-of mhx-arg-s))
        (= nm "mh_arg_b") (primitive/cast (ptr i8) (primitive/fnptr-of mhx-arg-b))
        (= nm "mh_arg_f") (primitive/cast (ptr i8) (primitive/fnptr-of mhx-arg-f))
        (= nm "mh_op_i") (primitive/cast (ptr i8) (primitive/fnptr-of mhx-op-i))
        (= nm "mh_op_h") (primitive/cast (ptr i8) (primitive/fnptr-of mhx-op-h))
        (= nm "mh_op_s") (primitive/cast (ptr i8) (primitive/fnptr-of mhx-op-s))
        (= nm "mh_quoted") (primitive/cast (ptr i8) (primitive/fnptr-of mhx-quoted))
        (= nm "mh_qq_new") (primitive/cast (ptr i8) (primitive/fnptr-of mhx-qq-new))
        (= nm "mh_qq_push") (primitive/cast (ptr i8) (primitive/fnptr-of mhx-qq-push))
        (= nm "mh_qq_splice") (primitive/cast (ptr i8) (primitive/fnptr-of mhx-qq-splice))
        (= nm "mh_qq_list") (primitive/cast (ptr i8) (primitive/fnptr-of mhx-qq-list))
        (= nm "mh_qq_listq") (primitive/cast (ptr i8) (primitive/fnptr-of mhx-qq-listq))
        (= nm "mh_qq_vec") (primitive/cast (ptr i8) (primitive/fnptr-of mhx-qq-vec))
        (= nm "mh_unq_int") (primitive/cast (ptr i8) (primitive/fnptr-of mhx-unq-int))
        (= nm "mh_unq_bool") (primitive/cast (ptr i8) (primitive/fnptr-of mhx-unq-bool))
        (= nm "mh_unq_float") (primitive/cast (ptr i8) (primitive/fnptr-of mhx-unq-float))
        (= nm "mh_unq_str") (primitive/cast (ptr i8) (primitive/fnptr-of mhx-unq-str))
        (= nm "mh_fail") (primitive/cast (ptr i8) (primitive/fnptr-of mhx-fail))
        (= nm "mh_code_list") (primitive/cast (ptr i8) (primitive/fnptr-of mhx-code-list))
        (= nm "mh_code_sym") (primitive/cast (ptr i8) (primitive/fnptr-of mhx-code-sym))
        (= nm "mh_code_int") (primitive/cast (ptr i8) (primitive/fnptr-of mhx-code-int))
        (= nm "mh_code_keyword") (primitive/cast (ptr i8) (primitive/fnptr-of mhx-code-keyword))
        (= nm "mh_code_count") (primitive/cast (ptr i8) (primitive/fnptr-of mhx-code-count))
        (= nm "mh_code_nth") (primitive/cast (ptr i8) (primitive/fnptr-of mhx-code-nth))
        (= nm "mh_code_eq") (primitive/cast (ptr i8) (primitive/fnptr-of mhx-code-eq))
        (= nm "mh_code_car") (primitive/cast (ptr i8) (primitive/fnptr-of mhx-code-car))
        (= nm "mh_code_cdr") (primitive/cast (ptr i8) (primitive/fnptr-of mhx-code-cdr))
        (= nm "mh_code_set_nth") (primitive/cast (ptr i8) (primitive/fnptr-of mhx-code-set-nth))
        (= nm "mh_code_set_car") (primitive/cast (ptr i8) (primitive/fnptr-of mhx-code-set-car))
        (= nm "mh_code_prepend") (primitive/cast (ptr i8) (primitive/fnptr-of mhx-code-prepend))
        :else (primitive/cast (ptr i8) 0)))
(export-c [mhx-arg-new :as "mh_arg_new"]
          [mhx-arg-c :as "mh_arg_c"]
          [mhx-arg-i :as "mh_arg_i"]
          [mhx-arg-s :as "mh_arg_s"]
          [mhx-arg-b :as "mh_arg_b"]
          [mhx-arg-f :as "mh_arg_f"]
          [mhx-op-i :as "mh_op_i"]
          [mhx-op-h :as "mh_op_h"]
          [mhx-op-s :as "mh_op_s"]
          [mhx-quoted :as "mh_quoted"]
          [mhx-qq-new :as "mh_qq_new"]
          [mhx-qq-push :as "mh_qq_push"]
          [mhx-qq-splice :as "mh_qq_splice"]
          [mhx-qq-list :as "mh_qq_list"]
          [mhx-qq-listq :as "mh_qq_listq"]
          [mhx-qq-vec :as "mh_qq_vec"]
          [mhx-unq-int :as "mh_unq_int"]
          [mhx-unq-bool :as "mh_unq_bool"]
          [mhx-unq-float :as "mh_unq_float"]
          [mhx-unq-str :as "mh_unq_str"]
          [mhx-fail :as "mh_fail"]
          [mhx-code-list :as "mh_code_list"]
          [mhx-code-sym :as "mh_code_sym"]
          [mhx-code-int :as "mh_code_int"]
          [mhx-code-keyword :as "mh_code_keyword"]
          [mhx-code-count :as "mh_code_count"]
          [mhx-code-nth :as "mh_code_nth"]
          [mhx-code-eq :as "mh_code_eq"]
          [mhx-code-car :as "mh_code_car"]
          [mhx-code-cdr :as "mh_code_cdr"]
          [mhx-code-set-nth :as "mh_code_set_nth"]
          [mhx-code-set-car :as "mh_code_set_car"]
          [mhx-code-prepend :as "mh_code_prepend"])

; ---- interpreter meta path: extern dispatch (piece: interp-meta) ---------------
; When a metaprogram runs via the in-process interpreter (interp.coil), its metashim
; wrappers call the mh_* callbacks as `extern`s. The interpreter can't natively call
; the compiler's mh_* (calling a real C address as a Coil fnptr is unsupported), so it
; routes unknown externs to this registered dispatcher, keyed by the extern's C symbol,
; with the same raw-scalar ABI the wasm export bridge uses. Args arrive as i64 cells;
; f64 params (mh_arg_f / mh_unq_float) carry the IEEE-754 bit pattern.
; bits->f64 comes from coil.mem (this file used to carry its own `mh-bits->f64`).
(defn mh-interp-dispatch [(nmd (ptr u8)) (nml i64) (buf (ptr i64)) (n i64)] (-> i64)
  (let [nm (slice-new nmd nml)]
    (cond (= nm "mh_arg_new") (primitive/cast i64 (mh-arg-new))
          (= nm "mh_arg_c")
            (primitive/cast i64
                            (mh-arg-c (primitive/cast (ptr i8) (load (primitive/index buf 0)))
                                      (primitive/cast (ptr i8) (load (primitive/index buf 1)))))
          (= nm "mh_arg_i")
            (primitive/cast i64
                            (mh-arg-i (primitive/cast (ptr i8) (load (primitive/index buf 0)))
                                      (load (primitive/index buf 1))))
          (= nm "mh_arg_s")
            (primitive/cast i64
                            (mh-arg-s (primitive/cast (ptr i8) (load (primitive/index buf 0)))
                                      (primitive/cast (ptr u8) (load (primitive/index buf 1)))
                                      (load (primitive/index buf 2))))
          (= nm "mh_arg_b")
            (primitive/cast i64
                            (mh-arg-b (primitive/cast (ptr i8) (load (primitive/index buf 0)))
                                      (load (primitive/index buf 1))))
          (= nm "mh_arg_f")
            (primitive/cast i64
                            (mh-arg-f (primitive/cast (ptr i8) (load (primitive/index buf 0)))
                                      (bits->f64 (load (primitive/index buf 1)))))
          (= nm "mh_op_i")
            (mh-op-i (load (primitive/index buf 0)) (primitive/cast (ptr i8) (load (primitive/index buf 1))))
          (= nm "mh_op_h")
            (primitive/cast i64
                            (mh-op-h (load (primitive/index buf 0))
                                     (primitive/cast (ptr i8) (load (primitive/index buf 1)))))
          (= nm "mh_op_s")
            (primitive/cast i64
                            (mh-op-s (load (primitive/index buf 0))
                                     (primitive/cast (ptr i8) (load (primitive/index buf 1)))))
          (= nm "mh_quoted") (primitive/cast i64 (mh-quoted (load (primitive/index buf 0))))
          (= nm "mh_qq_new") (primitive/cast i64 (mh-qq-new))
          (= nm "mh_qq_push")
            (primitive/cast i64
                            (mh-qq-push (primitive/cast (ptr i8) (load (primitive/index buf 0)))
                                        (primitive/cast (ptr i8) (load (primitive/index buf 1)))))
          (= nm "mh_qq_splice")
            (primitive/cast i64
                            (mh-qq-splice (primitive/cast (ptr i8) (load (primitive/index buf 0)))
                                          (primitive/cast (ptr i8) (load (primitive/index buf 1)))))
          (= nm "mh_qq_list") (primitive/cast i64 (mh-qq-list (primitive/cast (ptr i8) (load (primitive/index buf 0)))))
          (= nm "mh_qq_listq")
            (primitive/cast i64
                            (mh-qq-listq (primitive/cast (ptr i8) (load (primitive/index buf 0)))))
          (= nm "mh_qq_vec")
            (primitive/cast i64
                            (mh-qq-vec (primitive/cast (ptr i8)
                                                       (load (primitive/index buf 0)))))
          (= nm "mh_unq_int") (primitive/cast i64 (mh-unq-int (load (primitive/index buf 0))))
          (= nm "mh_unq_bool")
            (primitive/cast i64
                            (mh-unq-bool (load (primitive/index buf 0))))
          (= nm "mh_unq_float")
            (primitive/cast i64
                            (mh-unq-float (bits->f64 (load (primitive/index buf
                                                                            0)))))
          (= nm "mh_unq_str")
            (primitive/cast i64
                            (mh-unq-str (primitive/cast (ptr u8)
                                                        (load (primitive/index buf
                                                                               0)))
                                        (load (primitive/index buf
                                                               1))))
          (= nm "mh_code_list") (mh-code-list? (primitive/cast (ptr i8) (load (primitive/index buf 0))))
          (= nm "mh_code_sym") (mh-code-sym? (primitive/cast (ptr i8) (load (primitive/index buf 0))))
          (= nm "mh_code_int") (mh-code-int? (primitive/cast (ptr i8) (load (primitive/index buf 0))))
          (= nm "mh_code_keyword") (mh-code-keyword? (primitive/cast (ptr i8) (load (primitive/index buf 0))))
          (= nm "mh_code_count") (mh-code-count (primitive/cast (ptr i8) (load (primitive/index buf 0))))
          (= nm "mh_code_nth")
            (primitive/cast i64
                            (mh-code-nth (primitive/cast (ptr i8) (load (primitive/index buf 0)))
                                         (load (primitive/index buf 1))))
          (= nm "mh_code_eq")
            (mh-code-eq (primitive/cast (ptr i8) (load (primitive/index buf 0)))
                        (primitive/cast (ptr i8) (load (primitive/index buf 1))))
          (= nm "mh_code_car")
            (primitive/cast i64 (mh-code-car (primitive/cast (ptr i8) (load (primitive/index buf 0)))))
          (= nm "mh_code_cdr")
            (primitive/cast i64 (mh-code-cdr (primitive/cast (ptr i8) (load (primitive/index buf 0)))))
          (= nm "mh_code_set_nth")
            (primitive/cast i64
              (mh-code-set-nth (primitive/cast (ptr i8) (load (primitive/index buf 0)))
                                (load (primitive/index buf 1))
                                (primitive/cast (ptr i8) (load (primitive/index buf 2)))))
          (= nm "mh_code_set_car")
            (primitive/cast i64
              (mh-code-set-car (primitive/cast (ptr i8) (load (primitive/index buf 0)))
                                (primitive/cast (ptr i8) (load (primitive/index buf 1)))))
          (= nm "mh_code_prepend")
            (primitive/cast i64
              (mh-code-prepend (primitive/cast (ptr i8) (load (primitive/index buf 0)))
                               (primitive/cast (ptr i8) (load (primitive/index buf 1)))))
          (= nm "mh_fail") (mh-fail (load (primitive/index buf 0)))
          :else
            (do
              (mh-bug (sconcat3 (malloc-allocator)
                                "meta interp: unknown callback extern '"
                                nm
                                "'"))
              0))))

(defn meta-vtable [] (-> (ptr i8))
  (let [v (alloc/static MetaVt)]
    (store! (field v arg_new) (primitive/fnptr-of mh-arg-new))
    (store! (field v arg_c) (primitive/fnptr-of mh-arg-c))
    (store! (field v arg_i) (primitive/fnptr-of mh-arg-i))
    (store! (field v arg_s) (primitive/fnptr-of mh-arg-s))
    (store! (field v arg_b) (primitive/fnptr-of mh-arg-b))
    (store! (field v arg_f) (primitive/fnptr-of mh-arg-f))
    (store! (field v op_i) (primitive/fnptr-of mh-op-i))
    (store! (field v op_h) (primitive/fnptr-of mh-op-h))
    (store! (field v op_s) (primitive/fnptr-of mh-op-s))
    (store! (field v quoted) (primitive/fnptr-of mh-quoted))
    (store! (field v qq_new) (primitive/fnptr-of mh-qq-new))
    (store! (field v qq_push) (primitive/fnptr-of mh-qq-push))
    (store! (field v qq_splice) (primitive/fnptr-of mh-qq-splice))
    (store! (field v qq_list) (primitive/fnptr-of mh-qq-list))
    (store! (field v qq_listq) (primitive/fnptr-of mh-qq-listq))
    (store! (field v qq_vec) (primitive/fnptr-of mh-qq-vec))
    (store! (field v unq_int) (primitive/fnptr-of mh-unq-int))
    (store! (field v unq_bool) (primitive/fnptr-of mh-unq-bool))
    (store! (field v unq_float) (primitive/fnptr-of mh-unq-float))
    (store! (field v unq_str) (primitive/fnptr-of mh-unq-str))
    (store! (field v fail) (primitive/fnptr-of mh-fail))
    (store! (field v code_list) (primitive/fnptr-of mh-code-list?))
    (store! (field v code_sym) (primitive/fnptr-of mh-code-sym?))
    (store! (field v code_int) (primitive/fnptr-of mh-code-int?))
    (store! (field v code_keyword) (primitive/fnptr-of mh-code-keyword?))
    (store! (field v code_count) (primitive/fnptr-of mh-code-count))
    (store! (field v code_nth) (primitive/fnptr-of mh-code-nth))
    (store! (field v code_eq) (primitive/fnptr-of mh-code-eq))
    (store! (field v code_car) (primitive/fnptr-of mh-code-car))
    (store! (field v code_cdr) (primitive/fnptr-of mh-code-cdr))
    (store! (field v code_set_nth) (primitive/fnptr-of mh-code-set-nth))
    (store! (field v code_set_car) (primitive/fnptr-of mh-code-set-car))
    (store! (field v code_prepend) (primitive/fnptr-of mh-code-prepend))
    (primitive/cast (ptr i8) v)))
