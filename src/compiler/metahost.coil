; src/compiler/metahost.coil — the HOST side of the compiled-metaprogram boundary.
;
; metashim.coil (compiled INTO each metaprogram dylib) declares coil_meta_* externs;
; this module implements and export-c's them, so they bind at dlopen against the
; compiler process (linked with -Wl,-export_dynamic). Parity with the interpreter
; is by CONSTRUCTION: every code op crossing the boundary is rebuilt as real CtVals
; and dispatched to comptime.coil's own `code-op` with the same CtCtx the
; interpreter would have used — including its runtime errors, verbatim.
;
; A failing op (the interpreter's Err) records the Diag in MetaHostBox and
; terminates the METAPROGRAM THREAD via pthread_exit — never the pipeline thread.
; The engine (metaengine in expander.coil) always runs a compiled metaprogram on
; its own thread, joins it, and turns a recorded Diag into the ordinary
; expand-macro Err, so `(primitive/error ...)`/bad-op behavior is byte-identical to the
; interpreter's from the pipeline's point of view.
(module metahost)
(import "coil.primitive" :as primitive)

(import "coil.alloc" :as alloc :use *)
(import "coil.slice" :use *)
(import "coil.str" :use *)
(import "coil.mem" :use *)
(import "coil.arraylist" :use *)
(import "coil.result" :use *)
(import "coil.io" :use *)
(import "coil.fmt" :use *)
(import "coil.reader" :use *)
(import "parser" :use *)
(import "ast" :use *)
(import "ctval" :use *)  ; CtVal / EnvBind / CtCtx (was reached via comptime.coil)
(import "resolve" :use *)
(import "comptime" :use *)
(import "diag" :use *)
(import "ffi" :use *)

(extern pthread_exit :cc c [(ptr i8)] (-> i64))

; ---- per-call context ---------------------------------------------------------
; Set by the engine immediately before invoking a compiled metaprogram entry, read
; by every callback below (the callbacks run on the metaprogram thread while the
; engine blocks in pthread_join, so the stack-allocated CtCtx stays alive).
(defstruct MetaHostBox
  [(cx (ptr CtCtx))
   (registry (ptr (ArrayList (ptr Sexp))))
   (errset i64)
   (err Diag)
   (onmain i64)
   (interp i64)  ; 1 ⇒ metaprogram runs via the in-process interpreter (interp.coil)
   (halt i64)])  ; set by mh-halt in interp mode; polled by vm-exec to unwind cleanly
(defn meta-host-box [] (-> (ptr MetaHostBox))
  (alloc/static MetaHostBox))
(defn meta-host-set! [(cx (ptr CtCtx)) (registry (ptr (ArrayList (ptr Sexp))))] (-> i64)
  (let [b (meta-host-box)]
    (set! (.cx b) cx)
    (set! (.registry b) registry)
    (set! (.errset b) 0)
    0))
(defn meta-host-onmain! [(v i64)] (-> i64)
  (set! (.onmain (meta-host-box)) v)
  0)
; interpreter meta path: mark it active and clear the abort flag before an entry runs.
(defn meta-host-interp! [(v i64)] (-> i64)
  (let [b (meta-host-box)] (set! (.interp b) v) (set! (.halt b) 0) 0))
(defn mh-interp-halted? [] (-> i64)
  (.halt (meta-host-box)))
(defn meta-host-err [] (-> (Option Diag))
  (let [b (meta-host-box)]
    (if (= (.errset b) (primitive/cast i64 0))
        (None [Diag])
        (Some (.err b)))))

; A persistent metaprogram worker normally signals completion after an entry
; returns. `(primitive/error ...)` exits that pthread from inside this module, so
; it cannot reach the normal signal. The engine installs this tiny wakeup hook for
; the duration of a worker call; null means the historical one-shot path.
(defstruct MetaAbortHook [(fp (ptr i8)) (ctx (ptr i8))])
(defn meta-abort-hook [] (-> (ptr MetaAbortHook))
  (alloc/static MetaAbortHook))
(defn meta-host-abort-hook! [(fp (ptr i8)) (ctx (ptr i8))] (-> i64)
  (let [h (meta-abort-hook)]
    (set! (.fp h) fp)
    (set! (.ctx h) ctx)
    0))
(defn meta-host-signal-abort [] (-> i64)
  (let [h (meta-abort-hook)
        fp (load (field h fp))]
    (when (!= (primitive/cast i64 fp) (primitive/cast i64 0))
      (primitive/call-ptr (primitive/cast (fnptr c [(ptr i8)] i64) fp)
                          (load (field h ctx)))
      0)
    0))

; A compiler bug in the boundary itself (unset context, impossible shapes) must be
; LOUD and immediate — never a metaprogram-level diagnostic.
(defn mh-bug [(msg (slice u8))] (-> i64)
  (fmt (stderr) "metahost: {s} (compiler bug)\n" msg)
  (abort))

; A metaprogram-level failure: exactly what the interpreter would have returned as
; Err. Record it and end the metaprogram thread; the engine reports it identically.
; Under COIL_META_MAIN=1 the metaprogram runs on the process MAIN thread — there is
; no thread to end, so print the diagnostic and fail the build directly.
(defn mh-halt [(d Diag)] (-> i64)
  (let [b (meta-host-box)]
    (if (!= (.interp b) (primitive/cast i64 0))
        ; interpreter meta path: record the diag and request a cooperative VM abort.
        ; We run in-process on the pipeline thread, so pthread_exit would kill the
        ; whole compile; instead set halt and let vm-exec unwind (mp-op-* then returns
        ; here into the metalowered (loop 0), but the abort poll breaks out first).
        (do
          (set! (.err b) d)
          (set! (.errset b) 1)
          (set! (.halt b) 1)
          0)
        (if (!= (.onmain b) (primitive/cast i64 0))
            (do
              (fmt (stderr) "error: {s}\n" (load (field d msg)))
              (exit 1)
              0)
            (do
              (set! (.err b) d)
              (set! (.errset b) 1)
              (meta-host-signal-abort)
              (pthread_exit (primitive/cast (ptr i8) 1)))))))

(defn mh-cx [] (-> (ptr CtCtx))
  (let [b (meta-host-box)
        cx (load (field b cx))]
    (if (= (primitive/cast i64 cx) (primitive/cast i64 0))
        (do (mh-bug "code-op callback with no metaprogram context") (primitive/cast (ptr CtCtx) 0))
        cx)))

; The allocator a running metaprogram's values come from: the engine context's
; (CtCtx.a — the same allocator the interpreter's code ops already use), so the
; native and interpreted halves of one expansion allocate from ONE place. That
; is what lets COIL_MTRACE=mem attribute native-side allocation, and what the
; expansion arena scopes (docs/design/META_MEMORY.md). malloc fallback only for
; the no-context error paths. NOT for the ArgPool: its slots are a process-wide
; cache reused across expansions and must outlive any one of them.
(defn mh-a [] (-> (ptr Allocator))
  (let [b (meta-host-box)
        cx (load (field b cx))]
    (if (= (primitive/cast i64 cx) (primitive/cast i64 0))
        (malloc-allocator)
        (load (field cx a)))))

(defn mh-box-sexp [(s Sexp)] (-> (ptr i8))
  (let [p (unwrap-ptr [Sexp] (create [Sexp] (mh-a)))]
    (set! p s)
    (primitive/cast (ptr i8) p)))
(defn mh-handle-sexp [(c (ptr i8))] (-> Sexp)
  (if (= (primitive/cast i64 c) (primitive/cast i64 0))
      (do (mh-bug "null Code handle") (primitive/zeroed Sexp))
      (load (primitive/cast (ptr Sexp) c))))

; Typed structural Code callbacks. These are the metaprogram hot path: keep the
; generic CtVal dispatcher for the full reflective API, but do not allocate and
; box an argument list merely to inspect an S-expression node.
(defn mh-code-list? [(c (ptr i8))] (-> i64)
  (if (code-node-listish? (mh-handle-sexp c)) 1 0))
(defn mh-code-sym? [(c (ptr i8))] (-> i64)
  (if (= (sx-tag (mh-handle-sexp c)) (primitive/cast i64 2)) 1 0))
(defn mh-code-int? [(c (ptr i8))] (-> i64)
  (if (= (sx-tag (mh-handle-sexp c)) (primitive/cast i64 0)) 1 0))
(defn mh-code-keyword? [(c (ptr i8))] (-> i64)
  (if (= (sx-tag (mh-handle-sexp c)) (primitive/cast i64 3)) 1 0))
(defn mh-code-count [(c (ptr i8))] (-> i64)
  (let [sx (mh-handle-sexp c)]
    (if (code-node-listish? sx)
        (code-node-len sx)
        (do (mh-halt (derr "comptime: code-count expects a list/vector")) 0))))
(defn mh-code-nth [(c (ptr i8)) (i i64)] (-> (ptr i8))
  (let [sx (mh-handle-sexp c)]
    (if (code-node-listish? sx)
        (if (or (< i (primitive/cast i64 0)) (>= i (code-node-len sx)))
            (do (mh-halt (derr "comptime: code-nth index out of range")) (primitive/cast (ptr i8) 0))
            (mh-box-sexp (code-node-at sx i)))
        (do (mh-halt (derr "comptime: code-nth expects a list/vector")) (primitive/cast (ptr i8) 0)))))
(defn mh-code-eq [(x (ptr i8)) (y (ptr i8))] (-> i64)
  (if (sexp-eq (mh-handle-sexp x) (mh-handle-sexp y)) 1 0))

; String results cross as a host-owned {ptr,len} — layout mirrored in metashim.coil.
(defstruct MetaBuf [(p (ptr u8)) (n i64)])
(defn mh-buf [(s (slice u8))] (-> (ptr i8))
  (let [b (unwrap-ptr [MetaBuf] (create [MetaBuf] (mh-a)))]
    (set! (.p b) (slice-data s))
    (set! (.n b) (slice-len s))
    (primitive/cast (ptr i8) b)))

; ---- code-op argument builder (a boxed ArrayList CtVal) ------------------------
; A metaprogram's argument lists are strictly LIFO. metalower nests the builder
; chain — (mp-op-h OP (mp-arg-i (mp-arg-c (mp-arg-new) X) 0)) — so if evaluating X
; runs a nested op, that op's list is created AND consumed entirely before the outer
; list is filled any further. And exactly one metaprogram runs at a time
; (meta-engine-invoke is a pthread_create immediately followed by pthread_join), so
; one process-wide stack of reusable lists is enough; no per-thread state needed.
;
; Reusing them matters because no code op takes more than three arguments (nothing in
; comptime.coil reads past `cv-get args 2`), so the growable list never actually grew
; — it just cost a malloc for the ArrayList box and another for its first buffer, on
; EVERY code op. After the first few ops each depth's list has capacity and the whole
; arg-passing path is allocation-free. `al-clear!` keeps that capacity.
;
; Depths beyond the pool fall back to a fresh list, so nesting deeper than POOL just
; loses the optimization rather than misbehaving.
(defstruct ArgPool [(depth i64) (slots (array (ptr (ArrayList CtVal)) 64))])
(defn arg-pool [] (-> (ptr ArgPool))
  (alloc/static ArgPool))
(defn mh-arg-new [] (-> (ptr i8))
  (let [p (arg-pool)
        d (.depth p)]
    (if (>= d (primitive/cast i64 64))
        (do
          (set! (.depth p) (primitive/iadd d 1))
          (primitive/cast (ptr i8) (box-al [CtVal] (malloc-allocator) (al-new [CtVal] (malloc-allocator)))))
        (let [sp (primitive/index (field p slots) d)]
          (if (= (primitive/cast i64 (load sp)) (primitive/cast i64 0))
              (set! sp (box-al [CtVal] (malloc-allocator) (al-new [CtVal] (malloc-allocator))))
              (al-clear! [CtVal] (mut (load sp))))
          (set! (.depth p) (primitive/iadd d 1))
          (primitive/cast (ptr i8) (load sp))))))
; Pop the innermost list. Called once the op has run: code-op's result never points
; into the argument list (it returns Sexp handles and slices into Sexp-owned memory),
; so the list is dead the moment code-op returns. A failing op halts the metaprogram
; thread inside code-op and never gets here, which is fine — that thread is over.
(defn mh-arg-pop! [] (-> i64)
  (let [p (arg-pool)
        d (.depth p)]
    (when (> d (primitive/cast i64 0)) (store! (field p depth) (primitive/isub d 1)))
    0))
(defn mh-arg-push [(b (ptr i8)) (v CtVal)] (-> (ptr i8))
  (do (al-push! [CtVal] (primitive/cast (ptr (ArrayList CtVal)) b) v) b))
(defn mh-arg-c [(b (ptr i8)) (c (ptr i8))] (-> (ptr i8))
  (mh-arg-push b (CCode (mh-handle-sexp c))))
(defn mh-arg-i [(b (ptr i8)) (v i64)] (-> (ptr i8))
  (mh-arg-push b (CInt v)))
(defn mh-arg-s [(b (ptr i8)) (p (ptr u8)) (n i64)] (-> (ptr i8))
  (mh-arg-push b (CStr (slice-new p n))))
(defn mh-arg-b [(b (ptr i8)) (v i64)] (-> (ptr i8))
  (mh-arg-push b (CBool (!= v (primitive/cast i64 0)))))
(defn mh-arg-f [(b (ptr i8)) (x f64)] (-> (ptr i8))
  (mh-arg-push b (CFloat x)))

; ---- run an op through the interpreter's own dispatch --------------------------
(defn mh-run [(op i64) (b (ptr i8))] (-> CtVal)
  (match (code-op op (primitive/cast (ptr (ArrayList CtVal)) b) (mh-cx))
    (Err [d] (do (mh-halt d) (CInt 0)))
    (Ok [v] (do (mh-arg-pop!) v))))
(defn mh-op-i [(op i64) (b (ptr i8))] (-> i64)
  (match (mh-run op b) (CInt [n] n) (CBool [x] (when x 1)) (_ (do (mh-bug "code-op result is not an int/bool") 0))))
(defn mh-op-h [(op i64) (b (ptr i8))] (-> (ptr i8))
  ; Some ops are TYPED Code but the interpreter returns a scalar (report/warn
  ; yield CInt 0). Coerce exactly as the interpreter would: ctval->sexp — its
  ; own value->code conversion, including its own error on aggregates.
  (let [v (mh-run op b)]
    (match v
      (CCode [c] (mh-box-sexp c))
      (_ (match (ctval->sexp v)
           (Ok [sx] (mh-box-sexp sx))
           (Err [d] (do (mh-halt d) (primitive/cast (ptr i8) 0))))))))
(defn mh-op-s [(op i64) (b (ptr i8))] (-> (ptr i8))
  (match (mh-run op b)
    (CStr [s] (mh-buf s))
    (_ (do (mh-bug "code-op result is not a string") (primitive/cast (ptr i8) 0)))))

; ---- quote registry -------------------------------------------------------------
; metalower collects every EQuote/QLit form (int lowering order) into a registry of
; stable (ptr Sexp); index k is baked into the dylib as (mp-quoted k hyg). A
; quasiquote literal passes the fresh identity of that template evaluation and
; receives a shallow atom copy, so unquoted syntax keeps its old identity while
; introduced syntax is marked. Plain quote passes hyg=0 and allocates its own
; identity here, for the same reason and with the same result.
;
; `'name` is metaprogram-authored syntax exactly as a quasiquote literal is, so it
; must carry the same lexical identity. Aliasing the registry node left it in the
; SOURCE scope (hyg 0), where it bound by spelling: `~'tmp` in a template captured
; a caller's `tmp`, and two independently evaluated `'name`s connected to each
; other. That is precisely the implicit spelling-based capture this model exists
; to remove, and the source audit could not see it because `'` is not one of the
; identifier-producing primitives.
;
; Quoted DATA is unaffected. `sexp-eq` (and so `code-eq`) compares tag and
; spelling and never lexical identity, so `(code-eq node 'inc)` answers exactly
; as before; only the binding graph changes.
;
; The stamp is a copy, never a mutation: the registry node is shared by every
; evaluation of that quote site, and each evaluation is a distinct introduction.
(defn mh-stamp-quoted [(s Sexp) (hyg i64) (module (slice u8))] (-> Sexp)
  (let [tg (sx-tag s)]
    (if (or (= tg (primitive/cast i64 6)) (= tg (primitive/cast i64 7)))
        (let [a (mh-a)
              items (sx-items s)
              n (sx-len items)
              (mut out) (al-new [Sexp] a)
              (mut i) 0
              p (alloc/stack Sexp)]
          (loop (if (>= (load i) n)
                    (break)
                    (do
                      (al-push! (mut out) (mh-stamp-quoted (sx-at items (load i)) hyg module))
                      (store! i (primitive/iadd (load i) 1)))))
          (set! p s)
          (store! (field p kind)
                  (if (= tg (primitive/cast i64 7))
                      (KVec (box-al [Sexp] a (load out)))
                      (KList (box-al [Sexp] a (load out)))))
          (mh-stamp-ident! p hyg module)
          (load p))
        (if (= tg (primitive/cast i64 2))
            (let [p (alloc/stack Sexp)]
              (set! p s)
              (mh-stamp-ident! p hyg module)
              (load p))
            ; ints, floats, strings, keywords: no lexical identity to carry
            s))))

(defn mh-stamp-ident! [(p (ptr Sexp)) (hyg i64) (module (slice u8))] (-> i64)
  (store! (field p hyg) hyg)
  (store! (field p horigin) 1)
  ; metalower stamps a quasiquote atom with its lexical definition module. The
  ; dynamic entry module is only a fallback for an unstamped registry entry.
  (when (= (slice-len (load (field p hmod))) (primitive/cast i64 0))
    (store! (field p hmod) module))
  0)

(defn mh-quote-module [] (-> (slice u8))
  (match (load (field (mh-cx) qmodule))
    (Some [m] m)
    (None [] "")))

(defn mh-quoted [(k i64) (hyg i64)] (-> (ptr i8))
  (let [b (meta-host-box)
        reg (load (field b registry))]
    (if (= (primitive/cast i64 reg) (primitive/cast i64 0))
        (do (mh-bug "quote registry unset") (primitive/cast (ptr i8) 0))
        (if (or (< k (primitive/cast i64 0)) (>= k (al-len [(ptr Sexp)] (load reg))))
            (do (mh-bug "quote registry index out of range") (primitive/cast (ptr i8) 0))
            (let [src (al-get [(ptr Sexp)] (load reg) k)]
              (if (= hyg (primitive/cast i64 0))
                  ; plain quote: one fresh introduction identity per evaluation,
                  ; carried through the whole quoted tree
                  (mh-box-sexp (mh-stamp-quoted (load src) (mh-scope-new) (mh-quote-module)))
                  (let [out (mh-box-sexp (load src))]
                    (mh-stamp-ident! (primitive/cast (ptr Sexp) out) hyg (mh-quote-module))
                    out)))))))

; One fresh lexical introduction identity per dynamic quasiquote evaluation.
(defn mh-scope-new [] (-> i64)
  (primitive/iadd (next-gensym) 1))

; ---- quasiquote builder (a boxed ArrayList Sexp) --------------------------------
(defn mh-qq-new [] (-> (ptr i8))
  (let [a (mh-a)] (primitive/cast (ptr i8) (box-al [Sexp] a (al-new [Sexp] a)))))
(defn mh-transported [(s Sexp)] (-> Sexp)
  (if (= (sx-horigin s) (primitive/cast i64 1))
      s
      (let [p (alloc/stack Sexp)]
        (set! p s)
        (set! (.hflags p) (primitive/ior (.hflags p) 1))
        (load p))))
(defn mh-qq-push [(b (ptr i8)) (c (ptr i8))] (-> (ptr i8))
  (do (al-push! [Sexp] (primitive/cast (ptr (ArrayList Sexp)) b)
                (mh-transported (mh-handle-sexp c)))
      b))
(defn mh-qq-splice [(b (ptr i8)) (c (ptr i8))] (-> (ptr i8))
  (let [s (mh-handle-sexp c)]
    (if (not (code-node-listish? s))
        (do (mh-halt (derr "comptime: ~@ splice expects a Code list")) b)
        ; view-aware: splicing a view flattens it into the result builder — the
        ; single irreducible copy (docs/design/META_MEMORY.md phase 5)
        (let [n (code-node-len s)
              (mut i) 0]
          (loop (if (>= (load i) n)
                    (break)
                    (do
                      (al-push! [Sexp] (primitive/cast (ptr (ArrayList Sexp)) b)
                                (mh-transported (code-node-at s (load i))))
                      (set! i (primitive/iadd (load i) 1)))))
          b))))
(defn mh-qq-list [(b (ptr i8))] (-> (ptr i8))
  (let [p (mh-box-sexp (sx-mklist (primitive/cast (ptr (ArrayList Sexp)) b)))]
    (set! (.horigin (primitive/cast (ptr Sexp) p)) 1)
    p))
(defn mh-qq-vec [(b (ptr i8))] (-> (ptr i8))
  (let [p (mh-box-sexp (mk-sexp (KVec (primitive/cast (ptr (ArrayList Sexp)) b)) -1 -1))]
    (set! (.horigin (primitive/cast (ptr Sexp) p)) 1)
    p))

; ---- unquote conversions: EXACTLY ctval->sexp's scalar arms ---------------------
(defn mh-unq-int [(v i64)] (-> (ptr i8))
  (mh-box-sexp (sx-mkint v)))
(defn mh-unq-bool [(v i64)] (-> (ptr i8))
  (mh-box-sexp (sx-sym (if (!= v (primitive/cast i64 0)) "true" "false"))))
(defn mh-unq-float [(x f64)] (-> (ptr i8))
  (mh-box-sexp (mk-sexp (KFloat (f64-bits x)) -1 -1)))
; COPY the bytes; do not borrow them.
;
; `(slice-new p n)` alone keeps the METAPROGRAM's pointer inside a Sexp that the compiler
; reads much later — at codegen, long after the generator that produced it returned.
; Whether that survived depended entirely on where the bytes happened to live: a string
; literal points into the metaprogram image (still mapped, so it worked), but
; `~(slice-new [u8] (index (mut s) 0) 4)` over a stack array in the generator points at a
; frame that is gone by then. `coil check` passed and `coil build` died with SIGSEGV and
; no diagnostic — and the quieter outcome, reading whatever now occupies that memory, is
; a miscompile.
;
; Every other value crossing this boundary is already copied into the compiler's own
; allocator (mh-box-sexp, mh-buf, the CtVal rebuilds). This one was the exception.
(defn mh-unq-str [(p (ptr u8)) (n i64)] (-> (ptr i8))
  (let [a (mh-a)
        dst (unwrap-ptr [u8] (alloc-slice [u8] a (if (> n (primitive/cast i64 0)) n 1)))
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (set! (primitive/index dst (load i)) (load (primitive/index p (load i))))
                (set! i (primitive/iadd (load i) 1)))))
    (mh-box-sexp (sx-mkstr (slice-new dst n)))))

; ---- interpreter-parity runtime failures ----------------------------------------
; Sites the interpreter rejects only WHEN EVALUATED; metalower emits a call here so
; the compiled engine fails at the same moment with the same message.
(defn mh-fail [(code i64)] (-> i64)
  (cond (= code (primitive/cast i64 1)) (mh-halt (derr "comptime: can't unquote an aggregate value into code"))
        (= code (primitive/cast i64 2)) (mh-halt (derr "comptime: ~@ splice expects a Code list"))
        (= code (primitive/cast i64 3)) (mh-halt (derr "comptime: ~@ (splice) is only valid inside a list/vector"))
        :else (mh-bug "unknown failure code")))

; ---- the vtable handed to the dylib (see metashim.coil MetaVt — FIELD ORDER IS ABI)
(defstruct MetaVt
  [(arg_new (fnptr c [] (ptr i8)))
   (arg_c (fnptr c [(ptr i8) (ptr i8)] (ptr i8)))
   (arg_i (fnptr c [(ptr i8) i64] (ptr i8)))
   (arg_s (fnptr c [(ptr i8) (ptr u8) i64] (ptr i8)))
   (arg_b (fnptr c [(ptr i8) i64] (ptr i8)))
   (arg_f (fnptr c [(ptr i8) f64] (ptr i8)))
   (op_i (fnptr c [i64 (ptr i8)] i64))
   (op_h (fnptr c [i64 (ptr i8)] (ptr i8)))
   (op_s (fnptr c [i64 (ptr i8)] (ptr i8)))
   (quoted (fnptr c [i64 i64] (ptr i8)))
   (qq_new (fnptr c [] (ptr i8)))
   (qq_push (fnptr c [(ptr i8) (ptr i8)] (ptr i8)))
   (qq_splice (fnptr c [(ptr i8) (ptr i8)] (ptr i8)))
   (qq_list (fnptr c [(ptr i8)] (ptr i8)))
   (qq_vec (fnptr c [(ptr i8)] (ptr i8)))
   (unq_int (fnptr c [i64] (ptr i8)))
   (unq_bool (fnptr c [i64] (ptr i8)))
   (unq_float (fnptr c [f64] (ptr i8)))
   (unq_str (fnptr c [(ptr u8) i64] (ptr i8)))
   (fail (fnptr c [i64] i64))
   (code_list (fnptr c [(ptr i8)] i64))
   (code_sym (fnptr c [(ptr i8)] i64))
   (code_int (fnptr c [(ptr i8)] i64))
   (code_keyword (fnptr c [(ptr i8)] i64))
   (code_count (fnptr c [(ptr i8)] i64))
   (code_nth (fnptr c [(ptr i8) i64] (ptr i8)))
   (code_eq (fnptr c [(ptr i8) (ptr i8)] i64))
   (scope_new (fnptr c [] i64))])
; ---- WASM export surface (piece 1) --------------------------------------------
; When this compiler is itself built to wasm, a metaprogram compiles to a wasm
; SIDE-MODULE (codegen_wasm side-module mode) that the host instantiates sharing
; THIS module's linear memory. The side-module's metashim wrappers call the code-op
; callbacks below as env imports; the host bridges each `env.mh_*` to the compiler
; instance's exported `mh_*`. So the boundary is the SAME callbacks the native
; vtable holds — all raw scalar (ptr/i64/f64) ABI, no struct-by-value.
;
; These are THIN forwarding wrappers, deliberately NOT the mh-* functions
; themselves: meta-vtable takes the address of every mh-* via (primitive/fnptr-of …), and an
; export-c'd + address-taken function makes LLVM's wasm backend emit a GOT.func.*
; global import the single-unit finalizer cannot resolve. Keeping mh-* internal
; (their fnptr-of stays a plain TABLE_INDEX reloc) and export-c'ing wrappers that
; are never address-taken exports them by function index — no GOT.func. Native
; targets just carry 21 trivial extra thunks; gate-full is byte-unaffected (it
; diffs corpus emit-ir, not the compiler's own export table).
(defn mhx-arg-new [] (-> (ptr i8))
  (mh-arg-new))
(defn mhx-arg-c [(b (ptr i8)) (c (ptr i8))] (-> (ptr i8))
  (mh-arg-c b c))
(defn mhx-arg-i [(b (ptr i8)) (v i64)] (-> (ptr i8))
  (mh-arg-i b v))
(defn mhx-arg-s [(b (ptr i8)) (p (ptr u8)) (n i64)] (-> (ptr i8))
  (mh-arg-s b p n))
(defn mhx-arg-b [(b (ptr i8)) (v i64)] (-> (ptr i8))
  (mh-arg-b b v))
(defn mhx-arg-f [(b (ptr i8)) (x f64)] (-> (ptr i8))
  (mh-arg-f b x))
(defn mhx-op-i [(op i64) (b (ptr i8))] (-> i64)
  (mh-op-i op b))
(defn mhx-op-h [(op i64) (b (ptr i8))] (-> (ptr i8))
  (mh-op-h op b))
(defn mhx-op-s [(op i64) (b (ptr i8))] (-> (ptr i8))
  (mh-op-s op b))
(defn mhx-quoted [(k i64) (hyg i64)] (-> (ptr i8))
  (mh-quoted k hyg))
(defn mhx-scope-new [] (-> i64)
  (mh-scope-new))
(defn mhx-qq-new [] (-> (ptr i8))
  (mh-qq-new))
(defn mhx-qq-push [(b (ptr i8)) (c (ptr i8))] (-> (ptr i8))
  (mh-qq-push b c))
(defn mhx-qq-splice [(b (ptr i8)) (c (ptr i8))] (-> (ptr i8))
  (mh-qq-splice b c))
(defn mhx-qq-list [(b (ptr i8))] (-> (ptr i8))
  (mh-qq-list b))
(defn mhx-qq-vec [(b (ptr i8))] (-> (ptr i8))
  (mh-qq-vec b))
(defn mhx-unq-int [(v i64)] (-> (ptr i8))
  (mh-unq-int v))
(defn mhx-unq-bool [(v i64)] (-> (ptr i8))
  (mh-unq-bool v))
(defn mhx-unq-float [(x f64)] (-> (ptr i8))
  (mh-unq-float x))
(defn mhx-unq-str [(p (ptr u8)) (n i64)] (-> (ptr i8))
  (mh-unq-str p n))
(defn mhx-fail [(code i64)] (-> i64)
  (mh-fail code))
(defn mhx-code-list [(c (ptr i8))] (-> i64)
  (mh-code-list? c))
(defn mhx-code-sym [(c (ptr i8))] (-> i64)
  (mh-code-sym? c))
(defn mhx-code-int [(c (ptr i8))] (-> i64)
  (mh-code-int? c))
(defn mhx-code-keyword [(c (ptr i8))] (-> i64)
  (mh-code-keyword? c))
(defn mhx-code-count [(c (ptr i8))] (-> i64)
  (mh-code-count c))
(defn mhx-code-nth [(c (ptr i8)) (i i64)] (-> (ptr i8))
  (mh-code-nth c i))
(defn mhx-code-eq [(x (ptr i8)) (y (ptr i8))] (-> i64)
  (mh-code-eq x y))
(export-c [mhx-arg-new :as "mh_arg_new"]
          [mhx-arg-c :as "mh_arg_c"]
          [mhx-arg-i :as "mh_arg_i"]
          [mhx-arg-s :as "mh_arg_s"]
          [mhx-arg-b :as "mh_arg_b"]
          [mhx-arg-f :as "mh_arg_f"]
          [mhx-op-i :as "mh_op_i"]
          [mhx-op-h :as "mh_op_h"]
          [mhx-op-s :as "mh_op_s"]
          [mhx-quoted :as "mh_quoted"]
          [mhx-qq-new :as "mh_qq_new"]
          [mhx-qq-push :as "mh_qq_push"]
          [mhx-qq-splice :as "mh_qq_splice"]
          [mhx-qq-list :as "mh_qq_list"]
          [mhx-qq-vec :as "mh_qq_vec"]
          [mhx-unq-int :as "mh_unq_int"]
          [mhx-unq-bool :as "mh_unq_bool"]
          [mhx-unq-float :as "mh_unq_float"]
          [mhx-unq-str :as "mh_unq_str"]
          [mhx-fail :as "mh_fail"]
          [mhx-code-list :as "mh_code_list"]
          [mhx-code-sym :as "mh_code_sym"]
          [mhx-code-int :as "mh_code_int"]
          [mhx-code-keyword :as "mh_code_keyword"]
          [mhx-code-count :as "mh_code_count"]
          [mhx-code-nth :as "mh_code_nth"]
          [mhx-code-eq :as "mh_code_eq"]
          [mhx-scope-new :as "mh_scope_new"])

; ---- interpreter meta path: extern dispatch (piece: interp-meta) ---------------
; When a metaprogram runs via the in-process interpreter (interp.coil), its metashim
; wrappers call the mh_* callbacks as `extern`s. The interpreter can't natively call
; the compiler's mh_* (calling a real C address as a Coil fnptr is unsupported), so it
; routes unknown externs to this registered dispatcher, keyed by the extern's C symbol,
; with the same raw-scalar ABI the wasm export bridge uses. Args arrive as i64 cells;
; f64 params (mh_arg_f / mh_unq_float) carry the IEEE-754 bit pattern.
; bits->f64 comes from coil.mem (this file used to carry its own `mh-bits->f64`).
(defn mh-interp-dispatch [(nmd (ptr u8)) (nml i64) (buf (ptr i64)) (n i64)] (-> i64)
  (let [nm (slice-new nmd nml)]
    (cond (= nm "mh_arg_new") (primitive/cast i64 (mh-arg-new))
          (= nm "mh_arg_c")
            (primitive/cast i64
                            (mh-arg-c (primitive/cast (ptr i8) (load (primitive/index buf 0)))
                                      (primitive/cast (ptr i8) (load (primitive/index buf 1)))))
          (= nm "mh_arg_i")
            (primitive/cast i64
                            (mh-arg-i (primitive/cast (ptr i8) (load (primitive/index buf 0)))
                                      (load (primitive/index buf 1))))
          (= nm "mh_arg_s")
            (primitive/cast i64
                            (mh-arg-s (primitive/cast (ptr i8) (load (primitive/index buf 0)))
                                      (primitive/cast (ptr u8) (load (primitive/index buf 1)))
                                      (load (primitive/index buf 2))))
          (= nm "mh_arg_b")
            (primitive/cast i64
                            (mh-arg-b (primitive/cast (ptr i8) (load (primitive/index buf 0)))
                                      (load (primitive/index buf 1))))
          (= nm "mh_arg_f")
            (primitive/cast i64
                            (mh-arg-f (primitive/cast (ptr i8) (load (primitive/index buf 0)))
                                      (bits->f64 (load (primitive/index buf 1)))))
          (= nm "mh_op_i")
            (mh-op-i (load (primitive/index buf 0)) (primitive/cast (ptr i8) (load (primitive/index buf 1))))
          (= nm "mh_op_h")
            (primitive/cast i64
                            (mh-op-h (load (primitive/index buf 0))
                                     (primitive/cast (ptr i8) (load (primitive/index buf 1)))))
          (= nm "mh_op_s")
            (primitive/cast i64
                            (mh-op-s (load (primitive/index buf 0))
                                     (primitive/cast (ptr i8) (load (primitive/index buf 1)))))
          (= nm "mh_quoted")
            (primitive/cast i64
                            (mh-quoted (load (primitive/index buf 0))
                                       (load (primitive/index buf 1))))
          (= nm "mh_scope_new") (mh-scope-new)
          (= nm "mh_qq_new") (primitive/cast i64 (mh-qq-new))
          (= nm "mh_qq_push")
            (primitive/cast i64
                            (mh-qq-push (primitive/cast (ptr i8) (load (primitive/index buf 0)))
                                        (primitive/cast (ptr i8) (load (primitive/index buf 1)))))
          (= nm "mh_qq_splice")
            (primitive/cast i64
                            (mh-qq-splice (primitive/cast (ptr i8) (load (primitive/index buf 0)))
                                          (primitive/cast (ptr i8) (load (primitive/index buf 1)))))
          (= nm "mh_qq_list") (primitive/cast i64 (mh-qq-list (primitive/cast (ptr i8) (load (primitive/index buf 0)))))
          (= nm "mh_qq_vec")
            (primitive/cast i64
                            (mh-qq-vec (primitive/cast (ptr i8)
                                                       (load (primitive/index buf 0)))))
          (= nm "mh_unq_int") (primitive/cast i64 (mh-unq-int (load (primitive/index buf 0))))
          (= nm "mh_unq_bool")
            (primitive/cast i64
                            (mh-unq-bool (load (primitive/index buf 0))))
          (= nm "mh_unq_float")
            (primitive/cast i64
                            (mh-unq-float (bits->f64 (load (primitive/index buf
                                                                            0)))))
          (= nm "mh_unq_str")
            (primitive/cast i64
                            (mh-unq-str (primitive/cast (ptr u8)
                                                        (load (primitive/index buf
                                                                               0)))
                                        (load (primitive/index buf
                                                               1))))
          (= nm "mh_code_list") (mh-code-list? (primitive/cast (ptr i8) (load (primitive/index buf 0))))
          (= nm "mh_code_sym") (mh-code-sym? (primitive/cast (ptr i8) (load (primitive/index buf 0))))
          (= nm "mh_code_int") (mh-code-int? (primitive/cast (ptr i8) (load (primitive/index buf 0))))
          (= nm "mh_code_keyword") (mh-code-keyword? (primitive/cast (ptr i8) (load (primitive/index buf 0))))
          (= nm "mh_code_count") (mh-code-count (primitive/cast (ptr i8) (load (primitive/index buf 0))))
          (= nm "mh_code_nth")
            (primitive/cast i64
                            (mh-code-nth (primitive/cast (ptr i8) (load (primitive/index buf 0)))
                                         (load (primitive/index buf 1))))
          (= nm "mh_code_eq")
            (mh-code-eq (primitive/cast (ptr i8) (load (primitive/index buf 0)))
                        (primitive/cast (ptr i8) (load (primitive/index buf 1))))
          (= nm "mh_fail") (mh-fail (load (primitive/index buf 0)))
          :else
            (do
              (mh-bug (sconcat3 (malloc-allocator)
                                "meta interp: unknown callback extern '"
                                nm
                                "'"))
              0))))

(defn meta-vtable [] (-> (ptr i8))
  (let [v (alloc/static MetaVt)]
    (set! (.arg_new v) (primitive/fnptr-of mh-arg-new))
    (set! (.arg_c v) (primitive/fnptr-of mh-arg-c))
    (set! (.arg_i v) (primitive/fnptr-of mh-arg-i))
    (set! (.arg_s v) (primitive/fnptr-of mh-arg-s))
    (set! (.arg_b v) (primitive/fnptr-of mh-arg-b))
    (set! (.arg_f v) (primitive/fnptr-of mh-arg-f))
    (set! (.op_i v) (primitive/fnptr-of mh-op-i))
    (set! (.op_h v) (primitive/fnptr-of mh-op-h))
    (set! (.op_s v) (primitive/fnptr-of mh-op-s))
    (set! (.quoted v) (primitive/fnptr-of mh-quoted))
    (set! (.qq_new v) (primitive/fnptr-of mh-qq-new))
    (set! (.qq_push v) (primitive/fnptr-of mh-qq-push))
    (set! (.qq_splice v) (primitive/fnptr-of mh-qq-splice))
    (set! (.qq_list v) (primitive/fnptr-of mh-qq-list))
    (set! (.qq_vec v) (primitive/fnptr-of mh-qq-vec))
    (set! (.unq_int v) (primitive/fnptr-of mh-unq-int))
    (set! (.unq_bool v) (primitive/fnptr-of mh-unq-bool))
    (set! (.unq_float v) (primitive/fnptr-of mh-unq-float))
    (set! (.unq_str v) (primitive/fnptr-of mh-unq-str))
    (set! (.fail v) (primitive/fnptr-of mh-fail))
    (set! (.code_list v) (primitive/fnptr-of mh-code-list?))
    (set! (.code_sym v) (primitive/fnptr-of mh-code-sym?))
    (set! (.code_int v) (primitive/fnptr-of mh-code-int?))
    (set! (.code_keyword v) (primitive/fnptr-of mh-code-keyword?))
    (set! (.code_count v) (primitive/fnptr-of mh-code-count))
    (set! (.code_nth v) (primitive/fnptr-of mh-code-nth))
    (set! (.code_eq v) (primitive/fnptr-of mh-code-eq))
    (set! (.scope_new v) (primitive/fnptr-of mh-scope-new))
    (primitive/cast (ptr i8) v)))
