;;; Immutable declaration-kind index shared between compiler revisions.
(module coil.compiler.declaration_base)
(import "coil.primitive" :as p)
(import "coil.alloc" :use *)
(import "coil.slice" :use [slice-new])
(import "coil.scratch" :as scratch)
(import "coil.pmap" :use *)
(import "coil.compiler.resolution_base" :as res)

(defstruct DeclarationBase
  [(refs i64) (a (dyn Allocator)) (entries (PMap res/ResKey i64))])

(defn declaration-no-base [] (-> (ptr DeclarationBase))
  (p/cast (ptr DeclarationBase) 0))

(defn declaration-base-new [(a (dyn Allocator))] (-> (ptr DeclarationBase))
  (let [base (box! a DeclarationBase (p/zeroed DeclarationBase))]
    (set! (.refs base) 1)
    (set! (.a base) a)
    (set! (.entries base)
      (pm-new [res/ResKey i64] (res/res-lease a) (res/res-keyops)))
    base))

(defn declaration-base-derive [(a (dyn Allocator)) (parent (ptr DeclarationBase))]
  (-> (ptr DeclarationBase))
  (if (= parent (declaration-no-base))
    (declaration-base-new a)
    (let [base (box! a DeclarationBase (p/zeroed DeclarationBase))]
      (set! (.refs base) 1)
      (set! (.a base) a)
      (set! (.entries base)
        (pm-clone-at [(PMap res/ResKey i64)] (field parent entries)))
      base)))

(defn declaration-base-release! [(base (ptr DeclarationBase))] (-> i64)
  (unless (= base (declaration-no-base))
    (let [remaining (- (.refs base) 1)]
      (set! (.refs base) remaining)
      (when (= remaining 0)
        (let [entries (take! [(PMap res/ResKey i64)] (field base entries))] 0)
        (free [DeclarationBase] (.a base) (slice-new base 1)) 0)) 0)
  0)

(defn declaration-base-get [(base (ptr DeclarationBase))
                             (module (slice u8)) (name (slice u8))]
  (-> (Option i64))
  (if (= base (declaration-no-base))
    (None [i64])
    (pm-get (field base entries)
      (res/ResKey :module module :raw name :owner (p/cast (ptr res/ResOwner) 0)))))

(defn declaration-base-put! [(base (ptr DeclarationBase)) (owner (ptr res/ResOwner))
                              (module (slice u8)) (name (slice u8)) (mask i64)]
  (-> i64)
  (let [a (scratch/scratch-allocator (field owner arena))
        key (res/ResKey :module (res/res-own-bytes a module)
                        :raw (res/res-own-bytes a name) :owner owner)]
    (set! (.refs owner) (+ (.refs owner) 1))
    (pm-assoc! (mut (.entries base)) key mask)))

(defn declaration-base-remove! [(base (ptr DeclarationBase))
                                 (module (slice u8)) (name (slice u8))] (-> i64)
  (if (= base (declaration-no-base)) 0
    (pm-dissoc! (mut (.entries base))
      (res/ResKey :module module :raw name :owner (p/cast (ptr res/ResOwner) 0)))))

(defn declaration-base-count [(base (ptr DeclarationBase))] (-> i64)
  (if (= base (declaration-no-base)) 0 (pm-len (field base entries))))
