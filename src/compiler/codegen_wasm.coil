; src/compiler/codegen_wasm.coil — native WebAssembly (memory64) backend, zero LLVM.
;
; Consumes the SAME monomorphized Program as codegen_a64.coil / codegen.coil and
; lowers it directly to a FINAL, instantiable `wasm64-unknown-unknown` (memory64)
; module — it does not go through the LLVM-object + wasm.coil finalizer path; it
; builds the module bytes itself (reusing wasm.coil's LEB128 + section framing).
;
; Codegen model (debug backend — correctness over code quality, like codegen_a64):
;  - every value lives by-value in a SHADOW-STACK slot in linear memory. A scalar
;    (i8..i64, bool, pointer) is an 8-byte slot holding the value sign/zero-extended
;    from its width; a float is its IEEE bit pattern (f32 in the low 32 bits) and is
;    reinterpreted to a native f32/f64 only to compute. An AGGREGATE (struct, sum,
;    slice, array) is a slot of its natural size, manipulated by address +
;    `memory.copy`.
;  - a mutable i64 global is the shadow-stack pointer `$sp`. Each function
;    decrements it by its frame size in the prologue and keeps the result in a
;    local, the FRAME BASE, which every slot is addressed from; alloc-stack-bytes
;    moves `$sp` further down, and the epilogue resets it from the frame base.
;  - values are computed on the wasm operand stack, then stored to a slot. Every
;    `wemit-expr` is OPERAND-STACK-NEUTRAL: it leaves nothing on the stack.
;  - control flow uses wasm's STRUCTURED blocks. A `loop` is `block(brk) loop(cont)
;    … end end`; `break`→`br`(to the block), `continue`→`br`(to the loop). Relative
;    `br` depths come from a running control-nesting `depth` counter.
;  - CALLING CONVENTION: the C ABI of the LLVM wasm backend, for every function
;    (see wbuild-functype!), so imports, host callbacks and Coil functions mix
;    freely behind function pointers. Function pointers are slots of one funcref
;    table — the defined functions, then the imports — called with
;    `call_indirect`. Imports are added as code needs them; direct calls to
;    defined functions carry a padded index patched once the import count is final.
;  - type layout (primitive/struct? sizes/offsets, sum {tag,payload}, slice {ptr,len}) mirrors
;    codegen_a64 exactly — the same registration/sizing code, ported here.
;
; What remains unsupported is inline LLVM IR beyond the slice, float-intrinsic
; and ret forms (a hard error naming the line), and a `declare`d prebuilt unit
; (native only). Every other failure here is a violated compiler invariant — a
; node the checker or monomorphization must have removed — reported as such.
(module coil.compiler.codegen_wasm)
(import "coil.primitive" :as primitive)
(import "coil.compiler.vector_scalar" :use *)
(import "coil.compiler.unit_state" :use *)
(import "coil.compiler.float_math" :use *)

(defstruct WcgUnitState
  [(side WSideFlag)])

(defn wcg-unit-state-cell [] (-> (ptr (ptr WcgUnitState)))
  (primitive/alloc-static (ptr WcgUnitState)))

(defn wcg-unit-state [] (-> (ptr WcgUnitState))
  (let [p (load (wcg-unit-state-cell))]
    (if (= (primitive/cast i64 p) 0) (primitive/alloc-static WcgUnitState) p)))

(defn wcg-unit-bind! [(next (ptr WcgUnitState))] (-> (ptr WcgUnitState))
  (let [prior (wcg-unit-state)]
    (set! (wcg-unit-state-cell) next)
    prior))

(import "coil.alloc" :as alloc :use *)
(import "coil.result" :use *)
(import "coil.slice" :use *)
(import "coil.str" :use *)
(import "coil.arraylist" :use *)
(import "coil.io" :use *)
(import "coil.control" :use *)
(import "coil.compiler.ast" :use *)
(import "coil.compiler.resolve" :use [extern-abi-type-eq])
(import "coil.compiler.parser" :use *)
(import "coil.compiler.layoutdb" :use *)
(import "coil.compiler.mtrace" :as mtr)
(import "coil.compiler.wasm" :use *)

; ============================ layout constants ===============================
(defn wcg-mem-pages [] (-> i64)
  256)  ; 256 * 64KiB = 16 MiB linear memory

(defn wcg-stack-top [] (-> i64)
  16777216)  ; shadow stack top (grows down from here)

(defn wcg-data-base [] (-> i64)
  1024)  ; string/static data lives at [1024 .. ) (low null region reserved)

; process-global flag: the driver sets this when `--wasm-side-module` is passed, and
; build-wasm-program reads it (it runs on a worker thread via the shared DumpCtx).
(defstruct WSideFlag [(v i64)])

(defn wasm-side-cell [] (-> (ptr WSideFlag))
  (field (wcg-unit-state) side))

(defn set-wasm-side-module! [(on bool)] (-> i64)
  (set! (.v (wasm-side-cell)) (if on (do 1) 0))
  0)

(defn wasm-side-module? [] (-> bool)
  (!= (.v (wasm-side-cell)) (primitive/cast i64 0)))

; ============================ state ==========================================
; a lowered value: kind 0 = i64 immediate (v = value); 1 = slot (v = byte offset
; from the frame base). Scalars are 8-byte i64-canonical; aggregates occupy a slot
; of their natural size (accessed by address + memory.copy).
(defstruct WAVal [(kind i64) (v i64) (ty Type)])

; A defined function. `ordinal` is its position among the defined functions:
; its function-table slot (a function pointer's value) and, once every import is
; known, its wasm function index is (imports + ordinal).
(defstruct WSig
  [(name (slice u8))
   (params (ptr (ArrayList Type)))
   (ret Type)
   (ordinal i64)
   (typeidx i64)])

; one wasm function IMPORT: env.<field>, keyed/deduped by its C symbol (`field`).
(defstruct WImport
  [(field (slice u8))
   (params (ptr (ArrayList Type)))
   (ret Type)
   (funcidx i64)
   (typeidx i64)
   (variadic bool)])

; A direct call to a defined function, written with a 5-byte padded LEB128 index
; and patched once the import count (which shifts every defined function) is final.
(defstruct WFix [(entry i64) (off i64) (ordinal i64)])

; A named static cell `(alloc-static T :as "sym")`, one per symbol.
(defstruct WNamed [(name (slice u8)) (off i64)])

; A runtime `def`: its cell in the data segment.
(defstruct WDef [(name (slice u8)) (ty Type) (off i64)])

(defstruct WLoop
  [(label (Option (slice u8)))
   (breaklevel i64)
   (contlevel i64)
   (resslot i64)
   (resty Type)
   (has_res bool)])

(defstruct WStr [(bytes (slice u8)) (nul bool) (off i64)])  ; interned string literal (off = data offset)

(defsum WScope
  (WNil [])
  (WBind [(name (slice u8)) (av WAVal) (rest (ptr WScope))]))

(defstruct Wcg
  [(a (dyn Allocator))
   (program (ptr Program))
   (layouts LayoutDb)
   (sigs (ArrayList WSig))
   (imports (ArrayList WImport))  ; env.* function imports (funcidx 0..K-1; defined funcs shift up by K)
   (types (ArrayList (slice u8)))  ; deduped functype byte-strings (type section pool)
   (data (ArrayList u8))  ; static data segment payload (strings live here)
   (strs (ArrayList WStr))  ; interned strings (dedup)
   (needs-table bool)  ; any EFnPtrOf / ECallPtr seen ⇒ emit funcref table + elems
   (code (ArrayList u8))  ; current function body buffer (operand-stack code)
   (frame i64)  ; next free slot offset (bytes)
   (env (ptr WScope))
   (loops (ArrayList WLoop))
   (depth i64)  ; current control-nesting depth (open block/loop/if)
   (terminated bool)
   (retty Type)
   ; --- side-module (PIC) emission ---
   ; side-module: true ⇒ import memory + __memory_base + __stack_pointer (shared with
   ; the running compiler) and export the metaprogram entries; false ⇒ standalone
   ; (define+export memory, a defined $sp global, export main).
   (side-module bool)
   (sp-global i64)  ; wasm global index of the shadow-stack pointer $sp
   (membase-global i64)  ; wasm global index of __memory_base (side-module only; -1 otherwise)
   ; aggret: current function returns an aggregate (sret pointer in wasm local 0)
   (aggret bool)
   ; the wasm local holding the current frame's base. Slots are addressed from it,
   ; not from $sp, because alloc-stack-bytes moves $sp during the function.
   (fp-local i64)
   ; defined functions that occupy function-table slots (imports follow them)
   (nkeep i64)
   (curfix (ArrayList i64))  ; this function's direct-call fixup offsets (pairs: off, ordinal)
   (fixes (ArrayList WFix))
   (named (ArrayList WNamed))
   (defs (ArrayList WDef))
   ; side-module: data offsets holding a data address, which needs __memory_base
   ; added once the segment is placed
   (relocs (ArrayList i64))])

; hard error helpers — no silent fallbacks anywhere in this backend.
(extern wcg.exit [i32] (-> void))

(defn wcg-user-fail [(msg (slice u8))] (-> i64)
  (print-str (stderr) "error: ")
  (print-str (stderr) msg)
  (write-byte (stderr) (primitive/cast u8 10))
  (wcg.exit (primitive/cast i32 1))
  0)

(defn wcg-fail [(msg (slice u8))] (-> i64)
  (print-str (stderr) "codegen_wasm: ")
  (print-str (stderr) msg)
  (write-byte (stderr) (primitive/cast u8 10))
  (mtr/mtrace-mem-report-once!)
  (abort)
  0)

(defn wcg-fail2 [(msg (slice u8)) (what (slice u8))] (-> i64)
  (print-str (stderr) "codegen_wasm: ")
  (print-str (stderr) msg)
  (print-str (stderr) what)
  (write-byte (stderr) (primitive/cast u8 10))
  (mtr/mtrace-mem-report-once!)
  (abort)
  0)

(defn mk-av [(kind i64) (v i64) (ty Type)] (-> WAVal)
  (let [p (primitive/alloc-stack WAVal)]
    (set! (.kind p) kind)
    (set! (.v p) v)
    (set! (.ty p) ty)
    (load p)))

(defn av-kind [(x WAVal)] (-> i64)
  (let [p (primitive/alloc-stack WAVal)] (set! p x) (.kind p)))

(defn av-v [(x WAVal)] (-> i64)
  (let [p (primitive/alloc-stack WAVal)] (set! p x) (.v p)))

(defn av-ty [(x WAVal)] (-> Type)
  (let [p (primitive/alloc-stack WAVal)] (set! p x) (.ty p)))

; pointer to element i of an ArrayList reached by pointer (live, mutable). Local to
; this module (a64.coil's `al-at` is arm64-only; a fresh name avoids a :use * clash).
(defn wal-at [T] [(p (ptr (ArrayList T))) (i i64)] (-> (ptr T))
  (primitive/index (load (field p data)) i))

; ============================ scopes =========================================
(defn wscope-nil [(a (dyn Allocator))] (-> (ptr WScope))
  (box! a WScope (WNil)))

(defn wscope-put [(a (dyn Allocator))
                  (s (ptr WScope))
                  (name (slice u8))
                  (av WAVal)] (-> (ptr WScope))
  (box! a
        WScope
        (WBind
          :name name
          :av av
          :rest s)))

(defn wscope-get [(s (ptr WScope)) (name (slice u8))] (-> (Option WAVal))
  (match (load s)
    (WNil [] (None [WAVal]))
    (WBind [n av rest] (if (= n name) (Some [WAVal] av) (wscope-get rest name)))))

; ============================ type predicates ================================
(defn wty-scalar? [(t (ptr Type))] (-> bool)
  (match (load t)
    (TInt [_b _s] true)
    (TBool [] true)
    (TPtr [_] true)
    (TRef [_ _] true)
    (TFloat [_b] true)
    ; a float's bit pattern
    (TFn [_c _p _r] true)
    ; function pointer = a table index (scalar)
    (TNever [] true)
    (_ false)))

(defn wty-float? [(t (ptr Type))] (-> bool)
  (match (load t) (TFloat [_b] true) (_ false)))

(defn wty-signed? [(t (ptr Type))] (-> bool)
  (match (load t) (TInt [_b s] s) (_ false)))

; the type a pointer/ref points at (for ELoad's result type).
(defn wty-pointee [(t (ptr Type))] (-> Type)
  (match (load t)
    (TPtr [inner] (load inner))
    (TRef [_m inner] (load inner))
    (_ (do (wcg-fail "load/index through a non-pointer type") (TInt 64 true)))))

; last dotted component of a (possibly qualified) name: `foo.main` -> `main`.
(defn wlast-component [(nm (slice u8))] (-> (slice u8))
  (let [n (len nm)
        (mut cut) 0
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (when (= (primitive/cast i64 (get nm (load i)))
                         (primitive/cast i64 46))
                  (store! cut
                          (primitive/iadd (load i) 1)))
                (set! i (primitive/iadd (load i) 1)))))
    (subslice nm (load cut) n)))

; ============================ shared type layout =============================
(defn wstruct-idx [(g (ptr Wcg)) (name (slice u8))] (-> i64)
  (struct-index (field g layouts) name))

(defn wsum-idx [(g (ptr Wcg)) (name (slice u8))] (-> i64)
  (sum-index (field g layouts) name))

(defn wty-align [(g (ptr Wcg)) (t (ptr Type))] (-> i64)
  (align (field g layouts) t))

(defn wty-size [(g (ptr Wcg)) (t (ptr Type))] (-> i64)
  (size (field g layouts) t))

(defn wfield-off [(g (ptr Wcg)) (si i64) (fi i64)] (-> i64)
  (field-offset (field g layouts) si fi))

(defn wfield-idx [(g (ptr Wcg)) (si i64) (name (slice u8))] (-> i64)
  (field-number (field g layouts) si name))

(defn wtype-bytes [(g (ptr Wcg)) (t (ptr Type))] (-> i64)
  (type-bytes (field g layouts) t))

(defn wsum-words-def [(g (ptr Wcg)) (variants (ptr (ArrayList Variant)))] (-> i64)
  (sum-words (field g layouts) variants))

(defn wnatural-off [(g (ptr Wcg)) (fields (ptr (ArrayList Field))) (fi i64)] (-> i64)
  (natural-offset (field g layouts) fields fi))

(defn wvariant-idx [(g (ptr Wcg)) (su i64) (name (slice u8))] (-> i64)
  (variant-number (field g layouts) su name))

(defn wregister-types! [(g (ptr Wcg)) (mp (ptr Program))] (-> i64)
  (set! (.layouts g) (LayoutDb::new (.a g) mp "wcg" 8 8))
  0)

; Frame slots are Wasm-specific even though aggregate layout is shared.
(defn wslot-new! [(g (ptr Wcg)) (size i64) (align i64)] (-> i64)
  (let [f (.frame g)
        aligned
          (primitive/imul (primitive/idiv (primitive/iadd f
                                                          (primitive/isub align
                                                                          1))
                                          align)
                          align)]
    (set! (.frame g) (primitive/iadd aligned size))
    aligned))

(defn wslot-for-ty! [(g (ptr Wcg)) (tp (ptr Type))] (-> i64)
  (if (wty-scalar? tp)
      (wslot-new! g 8 8)
      (wslot-new! g (wty-size g tp) (wty-align g tp))))

; ============================ low-level byte emitters =========================
(defn we-global-get! [(b (mut (ArrayList u8))) (idx i64)] (-> i64)
  (wb! (mut b) 35)
  (wuleb! (mut b) idx)
  0)

(defn we-global-set! [(b (mut (ArrayList u8))) (idx i64)] (-> i64)
  (wb! (mut b) 36)
  (wuleb! (mut b) idx)
  0)

(defn we-local-get! [(b (mut (ArrayList u8))) (idx i64)] (-> i64)
  (wb! (mut b) 32)
  (wuleb! (mut b) idx)
  0)

(defn we-i64-const! [(b (mut (ArrayList u8))) (v i64)] (-> i64)
  (wb! (mut b) 66)
  (wsleb! (mut b) v)
  0)

(defn we-i64-load! [(b (mut (ArrayList u8)))] (-> i64)
  (wb! (mut b) 41)
  (wb! (mut b) 3)
  (wb! (mut b) 0)
  0)

(defn we-i64-store! [(b (mut (ArrayList u8)))] (-> i64)
  (wb! (mut b) 55)
  (wb! (mut b) 3)
  (wb! (mut b) 0)
  0)

(defn we-call! [(b (mut (ArrayList u8))) (idx i64)] (-> i64)
  (wb! (mut b) 16)
  (wuleb! (mut b) idx)
  0)

(defn we-br! [(b (mut (ArrayList u8))) (idx i64)] (-> i64)
  (wb! (mut b) 12)
  (wuleb! (mut b) idx)
  0)

(defn we-memcopy! [(b (mut (ArrayList u8)))] (-> i64)
  (wb! (mut b) 252)
  (wb! (mut b) 10)
  (wb! (mut b) 0)
  (wb! (mut b) 0)
  0)

; width-aware memory load: address on stack -> i64 (sign/zero-extended). bytes 1/2/4/8.
(defn we-load-mem! [(b (mut (ArrayList u8))) (bytes i64) (signed bool)] (-> i64)
  (cond (= bytes (primitive/cast i64 1))
          (do (wb! (mut b) (if signed 48 49)) (wb! (mut b) 0) (wb! (mut b) 0) 0)
        (= bytes (primitive/cast i64 2))
          (do (wb! (mut b) (if signed 50 51)) (wb! (mut b) 1) (wb! (mut b) 0) 0)
        (= bytes (primitive/cast i64 4))
          (do (wb! (mut b) (if signed 52 53)) (wb! (mut b) 2) (wb! (mut b) 0) 0)
        :else (do (wb! (mut b) 41) (wb! (mut b) 3) (wb! (mut b) 0) 0)))

; width-aware memory store: [addr, value] on stack. bytes 1/2/4/8.
(defn we-store-mem! [(b (mut (ArrayList u8))) (bytes i64)] (-> i64)
  (cond (= bytes (primitive/cast i64 1))
          (do (wb! (mut b) 60) (wb! (mut b) 0) (wb! (mut b) 0) 0)
        (= bytes (primitive/cast i64 2))
          (do (wb! (mut b) 61) (wb! (mut b) 1) (wb! (mut b) 0) 0)
        (= bytes (primitive/cast i64 4))
          (do (wb! (mut b) 62) (wb! (mut b) 2) (wb! (mut b) 0) 0)
        :else (do (wb! (mut b) 55) (wb! (mut b) 3) (wb! (mut b) 0) 0)))


; ---- thin g-based wrappers over the current function body buffer -------------
(defn wg-op! [(g (ptr Wcg)) (byte i64)] (-> i64)
  (wb! (mut (.code g)) byte)
  0)

(defn wg-uleb! [(g (ptr Wcg)) (v i64)] (-> i64)
  (wuleb! (mut (.code g)) v)
  0)

(defn wg-i64-const! [(g (ptr Wcg)) (v i64)] (-> i64)
  (we-i64-const! (mut (.code g)) v))

(defn wg-i32-const! [(g (ptr Wcg)) (v i64)] (-> i64)
  (wb! (mut (.code g)) 65)
  (wsleb! (mut (.code g)) v)
  0)

(defn wg-i64-load! [(g (ptr Wcg))] (-> i64)
  (we-i64-load! (mut (.code g))))

(defn wg-i64-store! [(g (ptr Wcg))] (-> i64)
  (we-i64-store! (mut (.code g))))

(defn wg-load-mem! [(g (ptr Wcg)) (bytes i64) (signed bool)] (-> i64)
  (we-load-mem! (mut (.code g)) bytes signed))

(defn wg-store-mem! [(g (ptr Wcg)) (bytes i64)] (-> i64)
  (we-store-mem! (mut (.code g)) bytes))

(defn wg-memcopy! [(g (ptr Wcg))] (-> i64)
  (we-memcopy! (mut (.code g))))

; push the ADDRESS of frame slot `off`: the frame base (a local set in the
; prologue) + off.
(defn wg-push-addr! [(g (ptr Wcg)) (off i64)] (-> i64)
  (we-local-get! (mut (.code g)) (.fp-local g))
  (when (> off (primitive/cast i64 0))
    (wg-i64-const! g off)
    (wg-op! g 124))
  0)

; push a static-data ADDRESS: standalone ⇒ absolute i64.const; side-module ⇒
; (global.get __memory_base) + off (PIC — the host places the data at __memory_base).
(defn wg-data-addr! [(g (ptr Wcg)) (off i64)] (-> i64)
  (if (.side-module g)
      (do
        (we-global-get! (mut (.code g)) (.membase-global g))
        (when (> off (primitive/cast i64 0))
          (wg-i64-const! g off)
          (wg-op! g 124)
          0)
        0)
      (wg-i64-const! g (primitive/iadd (wcg-data-base) off))))

(defn wg-call! [(g (ptr Wcg)) (idx i64)] (-> i64)
  (we-call! (mut (.code g)) idx))

(defn wg-br! [(g (ptr Wcg)) (idx i64)] (-> i64)
  (we-br! (mut (.code g)) idx))

; ---- AVal materialization ---------------------------------------------------
; push a SCALAR AVal onto the operand stack as an i64 value.
(defn wg-push-av! [(g (ptr Wcg)) (av WAVal)] (-> i64)
  (let [tp (primitive/alloc-stack Type)]
    (set! tp (av-ty av))
    (when (not (wty-scalar? tp))
      (wcg-fail "internal: scalar-push of an aggregate value"))
    (if (= (av-kind av) (primitive/cast i64 0))
        (wg-i64-const! g (av-v av))
        (do (wg-push-addr! g (av-v av)) (wg-i64-load! g) 0))))

; push the i64 ADDRESS of an AVal's storage (spilling an immediate into a slot first).
(defn wg-addr-of-av! [(g (ptr Wcg)) (av WAVal)] (-> i64)
  (if (= (av-kind av) (primitive/cast i64 1))
      (wg-push-addr! g (av-v av))
      (let [slot (wslot-new! g 8 8)]
        (wg-push-addr! g slot)
        (wg-i64-const! g (av-v av))
        (wg-i64-store! g)
        (wg-push-addr! g slot))))

; store an AVal into a local frame slot at `destoff` (scalar ⇒ 8-byte i64; aggregate ⇒ memory.copy).
(defn wg-store-av-to-slot! [(g (ptr Wcg)) (av WAVal) (destoff i64)] (-> i64)
  (let [tp (primitive/alloc-stack Type)]
    (set! tp (av-ty av))
    (if (wty-scalar? tp)
        (do (wg-push-addr! g destoff) (wg-push-av! g av) (wg-i64-store! g) 0)
        (do
          (wg-push-addr! g destoff)
          (wg-addr-of-av! g av)
          (wg-i64-const! g (wty-size g tp))
          (wg-memcopy! g)
          0))))

; store an AVal into memory at frame offset `totaloff` at the value's EXACT width
; (scalar ⇒ i64.storeN of the type's byte width; aggregate ⇒ memory.copy).
(defn wg-store-av-at-off! [(g (ptr Wcg)) (av WAVal) (totaloff i64)] (-> i64)
  (let [tp (primitive/alloc-stack Type)]
    (set! tp (av-ty av))
    (if (wty-scalar? tp)
        (do
          (wg-push-addr! g totaloff)
          (wg-push-av! g av)
          (wg-store-mem! g (wty-size g tp))
          0)
        (do
          (wg-push-addr! g totaloff)
          (wg-addr-of-av! g av)
          (wg-i64-const! g (wty-size g tp))
          (wg-memcopy! g)
          0))))

; copy `size` bytes of type `fty` FROM frame offset `srcoff` INTO fresh slot `destoff`.
(defn wg-copy-field-from! [(g (ptr Wcg))
                           (destoff i64)
                           (srcoff i64)
                           (fty (ptr Type))] (-> i64)
  (if (wty-scalar? fty)
      (do
        (wg-push-addr! g destoff)
        (wg-push-addr! g srcoff)
        (wg-load-mem! g (wty-size g fty) (wty-signed? fty))
        (wg-i64-store! g)
        0)
      (do
        (wg-push-addr! g destoff)
        (wg-push-addr! g srcoff)
        (wg-i64-const! g (wty-size g fty))
        (wg-memcopy! g)
        0)))

; ============================ string interning ==============================
(defn wintern-str! [(g (ptr Wcg)) (sv (slice u8)) (nul bool)] (-> i64)
  (let [n (len (.strs g))
        (mut i) 0
        (mut found) -1]
    (loop (if (>= (load i) n)
              (break)
              (do
                (let [e (wal-at [WStr] (field g strs) (load i))]
                  (when (and (or (and (load (field e nul)) nul)
                                 (and (not (load (field e
                                                        nul)))
                                      (not nul)))
                             (= (load (field e bytes)) sv))
                    (store! found (load (field e off)))))
                (set! i (primitive/iadd (load i) 1)))))
    (if (>= (load found) (primitive/cast i64 0))
        (load found)
        ; `off` is the 0-based offset within the data buffer; the runtime ADDRESS is
        ; computed at the use site (wg-data-addr!) so it works in both PIC and absolute modes.
        (let [off (len (.data g))
              e (primitive/alloc-stack WStr)]
          (let [m (len sv)
                (mut k) 0]
            (loop (if (>= (load k) m)
                      (break)
                      (do
                        (push! (mut (.data g)) (get sv (load k)))
                        (set! k (primitive/iadd (load k) 1))))))
          (when nul (push! (mut (field g data)) (primitive/cast u8 0)))
          (set! (.bytes e) sv)
          (set! (.nul e) nul)
          (set! (.off e) off)
          (push! (mut (.strs g)) (load e))
          off))))

; alloc-static: reserve a fresh, zero-initialised cell in the static data segment for
; ONE call site. Data is written into linear memory at __memory_base on instantiation,
; and the cell's address (base+off) is a compile-time constant, so every execution of
; this alloc-static returns the SAME cell — the wasm equivalent of one global slot per
; call site. Returns the 0-based offset (the address is formed at the use via
; wg-data-addr!, PIC-aware). `size` bytes, aligned to `align`.
(defn wintern-static! [(g (ptr Wcg)) (size i64) (align i64)] (-> i64)
  (let [al (if (> align (primitive/cast i64 1)) align 1)
        cur (len (.data g))
        rem (primitive/irem cur al)
        pad (unless (= rem (primitive/cast i64 0)) (primitive/isub al rem))]
    (let [(mut k) 0]
      (loop (if (>= (load k) pad)
                (break)
                (do
                  (push! (mut (.data g)) (primitive/cast u8 0))
                  (set! k (primitive/iadd (load k) 1))))))
    (let [off (len (.data g))
          (mut j) 0]
      (loop (if (>= (load j) size)
                (break)
                (do
                  (push! (mut (.data g)) (primitive/cast u8 0))
                  (set! j (primitive/iadd (load j) 1)))))
      off)))

; ============================ static data ====================================
; Write the low `bytes` bytes of `v`, little-endian, at data offset `off`.
(defn wdata-put! [(g (ptr Wcg)) (off i64) (v i64) (bytes i64)] (-> i64)
  (for [k 0 bytes]
    (set! (wal-at [u8] (field g data) (+ off k))
          (primitive/cast u8 (primitive/iand (primitive/ishr v (* k 8)) 255))))
  0)

; Write, at data offset `off`, the address of data offset `target`. Standalone,
; the segment sits at a fixed base, so this is the final address; a side module's
; segment is placed at __memory_base, so the offset is written and relocated at
; instantiation (the start function built by wreloc-func).
(defn wdata-addr-put! [(g (ptr Wcg)) (off i64) (target i64)] (-> i64)
  (if (.side-module g)
      (do (push! (mut (.relocs g)) off) (wdata-put! g off target 8))
      (wdata-put! g off (+ (wcg-data-base) target) 8)))

; Write the link-time constant `e`, of type `t`, at data offset `off` — the
; initializer of a `def` or of an initialized alloc-static, with the same
; layouts expressions build at run time.
(defn wstatic-write! [(g (ptr Wcg)) (t (ptr Type)) (e (ptr Expr)) (off i64)] (-> i64)
  (let [a (.a g)]
    (match (.kind e)
      (EInt [n] (wdata-put! g off n (wty-size g t)))
      (EFloat [bits]
              (if (= (wty-size g t) (primitive/cast i64 4))
                  (wdata-put! g off (f64-bits->f32-bits bits) 4)
                  (wdata-put! g off bits 8)))
      (EBool [v] (wdata-put! g off (when v 1) 1))
      (EStr [sv]
            (do
              (wdata-addr-put! g off (wintern-str! g sv true))
              (wdata-put! g (+ off 8) (len sv) 8)))
      (ECStr [sv] (wdata-addr-put! g off (wintern-str! g sv true)))
      (EConstruct [sum variant args]
                  (let [su (wsum-idx g sum)]
                    (when (< su 0)
                      (wcg-fail2 "def initializer: unknown sum " sum))
                    (let [vidx (wvariant-idx g su variant)
                          vs (load (field (sum-at (field g layouts) su) variants))
                          vfields (load (field (wal-at [Variant] vs vidx) fields))]
                      (wdata-put! g off vidx 4)
                      (for [i 0 (len (load args))]
                        (wstatic-write! g
                                        (field (wal-at [Field] vfields i) ty)
                                        (wal-at [Expr] args i)
                                        (+ (+ off 8) (wnatural-off g vfields i))))
                      0)))
      (EZeroed [_] 0)
      (ERecordInit [_] 0)
      (EStaticArray [indices items]
                    (match (load t)
                      (TArray [elem _]
                              (do
                                (for [i 0 (len (load items))]
                                  (wstatic-write! g elem (wal-at [Expr] items i)
                                                  (+ off (* (get (load indices) i) (wty-size g elem)))))
                                0))
                      (_ (wcg-fail "static :elements requires an array allocation"))))
      (EFnPtrOf [name] (wdata-put! g off (wfnptr-slot g name) 8))
      (EAlloc [storage ty init symbol]
              (if (!= storage (primitive/cast i64 1))
                  (wcg-fail "def initializer: only alloc-static storage is a link-time constant")
                  (wdata-addr-put! g off (wstatic-cell! g (box-type a ty) init symbol))))
      (EMakeSlice [data elem len]
                  (do
                    (wstatic-write! g (box-type a (TPtr (box-type a elem))) data off)
                    (wdata-put! g (+ off 8) (extent-value len) 8)))
      (ECast [_ inner] (wstatic-write! g t inner off))
      (ELoad [inner] (wstatic-write! g t inner off))
      (ELet [_ body]
            (match (load t)
              (TStruct [name]
                       (let [si (wstruct-idx g name)]
                         (when (< si 0)
                           (wcg-fail2 "def initializer: unknown struct " name))
                         (for [i 0 (len (load body))]
                           (match (.kind (wal-at [Expr] body i))
                             (EInitStore [place value]
                                         (match (.kind place)
                                           (EField [_ fname]
                                                   (let [fi (wfield-idx g si fname)]
                                                     (when (< fi 0)
                                                       (wcg-fail2 "def initializer: unknown field " fname))
                                                     (wstatic-write! g
                                                                     (field (wal-at [Field]
                                                                                    (load (field (struct-at (field g layouts) si) fields))
                                                                                    fi)
                                                                            ty)
                                                                     value
                                                                     (+ off (wfield-off g si fi)))))
                                           (_ 0)))
                             (_ 0)))
                         0))
              (TArray [elem count-extent]
                      (let [count (extent-value count-extent)]
                        (for [i 0 (len (load body))]
                          (match (.kind (wal-at [Expr] body i))
                            (EStore [place value]
                                    (match (.kind place)
                                      (EIndex [_ index]
                                              (match (.kind index)
                                                (EInt [item]
                                                      (if (or (< item 0) (>= item count))
                                                          (wcg-fail "alloc-static initializer: array index is out of bounds")
                                                          (wstatic-write! g elem value (+ off (* item (wty-size g elem))))))
                                                (_ (wcg-fail "alloc-static initializer: array index is not constant"))))
                                      (_ 0)))
                            (_ 0)))
                        0))
              (_ (wcg-fail "def initializer: materialized aggregate has the wrong type"))))
      (_ (wcg-fail "def initializer is not a link-time constant")))))

; The data cell of an alloc-static site: a fresh cell holding `init` (zeroed
; without one), or — for an `:as` symbol — the one cell wregister-named-statics!
; laid out for that symbol. Returns its offset.
(defn wstatic-cell! [(g (ptr Wcg)) (tp (ptr Type)) (init (ptr Expr)) (symbol (Option (slice u8)))] (-> i64)
  (match symbol
    (Some [name] (wnamed-static-off g name))
    (None []
          (let [off (wintern-static! g (wty-size g tp) (wty-align g tp))]
            (unless (= (primitive/cast i64 init) (primitive/cast i64 0))
              (wstatic-write! g tp init off))
            off))))

; The cell of the named static `name`, or -1.
(defn wnamed-static-find [(g (ptr Wcg)) (name (slice u8))] (-> i64)
  (let [(mut r) -1]
    (for [i 0 (len (.named g))]
      (when (= (.name (get (.named g) i)) name) (set! r (.off (get (.named g) i)))))
    r))

(defn wnamed-static-off [(g (ptr Wcg)) (name (slice u8))] (-> i64)
  (let [off (wnamed-static-find g name)]
    (when (< off (primitive/cast i64 0))
      (wcg-fail2 "named static was not laid out before code generation: " name))
    off))

; A named static site found by wregister-named-statics!.
(defstruct WNamedSite [(name (slice u8)) (ty Type) (init (ptr Expr))])

(defn wfind-named-sites! [(g (ptr Wcg)) (out (mut (ArrayList WNamedSite))) (e (ptr Expr))] (-> i64)
  (match (.kind e)
    (EAlloc [storage ty init symbol]
            (match symbol
              (Some [name]
                    (when (= storage (primitive/cast i64 1))
                      (push! (mut out) (WNamedSite :name name :ty ty :init init))))
              (None [] 0)))
    (_ 0))
  (let [kids (wexpr-children (.a g) e)]
    (for [i 0 (len kids)]
      (wfind-named-sites! g (mut out) (get kids i))))
  0)

; Lay out every `(alloc-static T … :as "sym")` before any code is emitted, so a
; linker-address can name one ahead of its site. A symbol names exactly one cell:
; a second site, or a C function (an extern or export-c) of the same name, is the
; error native linking reports.
(defn wregister-named-statics! [(g (ptr Wcg)) (mp (ptr Program)) (keep (ptr (ArrayList i64)))] (-> i64)
  (let [a (.a g)
        (mut sites) (al-new [WNamedSite] a)
        fs (load (field mp funcs))
        cs (load (field mp consts))]
    (for [k 0 (len (load keep))]
      (let [body (load (field (wal-at [Func] fs (wal-get-keep keep k)) body))]
        (for [i 0 (len (load body))]
          (wfind-named-sites! g (mut sites) (wal-at [Expr] body i)))))
    (for [k 0 (len (load cs))]
      (let [cp (al-elem [Const] cs k)]
        (when (.runtime cp)
          (wfind-named-sites! g (mut sites) (field cp value)))))
    (for [i 0 (len sites)]
      (let [site (get sites i)
            name (.name site)]
        (when (>= (wnamed-static-find g name) (primitive/cast i64 0))
          (wcg-user-fail (sconcat a "duplicate static storage symbol: " name)))
        (let [es (load (field mp externs))]
          (for [j 0 (len (load es))]
            (when (= (extern-link-name (al-elem [Extern] es j)) name)
              (wcg-user-fail (sconcat a "static storage conflicts with function symbol: " name)))))
        (let [ex (load (field mp exports))]
          (for [j 0 (len (load ex))]
            (when (= (wexportc-sym (wal-at [ExportC] ex j)) name)
              (wcg-user-fail (sconcat a "static storage conflicts with function symbol: " name)))))
        (let [tp (box-type a (.ty site))]
          (push! (mut (.named g)) (WNamed :name name :off (wintern-static! g (wty-size g tp) (wty-align g tp)))))))
    ; initializers last: one may point at another named cell
    (for [i 0 (len sites)]
      (let [site (get sites i)]
        (unless (= (primitive/cast i64 (.init site)) (primitive/cast i64 0))
          (wstatic-write! g (box-type a (.ty site)) (.init site) (wnamed-static-off g (.name site))))))
    0))

; Lay out every runtime `def` in the data segment with its initializer.
(defn wdeclare-defs! [(g (ptr Wcg)) (mp (ptr Program))] (-> i64)
  (let [cs (load (field mp consts))]
    (for [i 0 (len (load cs))]
      (let [cp (al-elem [Const] cs i)]
        ; A wasm32 module links no other unit's storage.
        (when (.declared cp)
          (wcg-fail2 "declared storage is defined in another unit, which wasm32 cannot link: " (.name cp))
          0)
        (when (.runtime cp)
          (match (.ty cp)
            (None [] (wcg-fail "internal: checked def has no type"))
            (Some [ty]
                  (let [tp (box-type (.a g) ty)
                        off (wintern-static! g (wty-size g tp) (wty-align g tp))]
                    (push! (mut (.defs g)) (WDef :name (.name cp) :ty ty :off off))
                    (wstatic-write! g tp (field cp value) off))))))))
  0)

; The side module's start function: add __memory_base to every data word that
; holds a data address (see wdata-addr-put!).
(defn wreloc-func [(g (ptr Wcg))] (-> (ArrayList u8))
  (let [(mut b) (al-new [u8] (.a g))
        mb (.membase-global g)]
    (wb! (mut b) 0)
    (for [i 0 (len (.relocs g))]
      (let [r (get (.relocs g) i)]
        (we-global-get! (mut b) mb)
        (we-i64-const! (mut b) r)
        (wb! (mut b) 124)
        (we-global-get! (mut b) mb)
        (we-i64-const! (mut b) r)
        (wb! (mut b) 124)
        (we-i64-load! (mut b))
        (we-global-get! (mut b) mb)
        (wb! (mut b) 124)
        (we-i64-store! (mut b))))
    (wb! (mut b) 11)
    b))

; ============================ functype pool =================================
; Every function in the module — defined, imported, or reached through the table —
; uses the C ABI the LLVM wasm backend uses, so an import, a host callback and a
; Coil function are interchangeable behind a function pointer:
;   - an integer of 32 bits or fewer, or bool, is an i32; i64 and pointers are i64;
;     f32/f64 are f32/f64;
;   - a struct whose only data is one scalar (clang's single-element struct)
;     travels as that scalar, and an empty struct is not passed or returned at
;     all (wabi-class);
;   - any other aggregate argument is passed as a pointer to a copy (byval), and
;     any other aggregate result is written through a leading pointer (sret),
;     the function then having no result;
;   - a variadic function takes one more i64: the address of a buffer holding the
;     variadic arguments (see wemit-invoke).
; Inside a function every scalar is an i64 in a frame slot (canonical: extended
; from its width; a float is its bit pattern), so values convert at the boundary.
; How the C ABI carries a value of type `t` (a declared parameter or result type).
(defsum WAbi
  (WAbiScalar [(t Type)])  ; a scalar: `t` itself, or a single-element struct's element
  (WAbiEmpty [])  ; an empty struct, or void: nothing
  (WAbiIndirect []))  ; any other aggregate: by pointer

; clang's single-element struct, as codegen.coil's cg-single-element: the one
; scalar a type's data amounts to, ignoring empty fields and seeing through
; nested structs and one-element arrays; none for a bit-struct, a sum, a slice,
; or anything with more than one scalar.
(defn wsingle-element [(g (ptr Wcg)) (t (ptr Type))] (-> (Option Type))
  (match (load t)
    (TStruct [nm]
             (let [si (wstruct-idx g nm)]
               (if (< si (primitive/cast i64 0))
                   (None [Type])
                   (let [e (struct-at (field g layouts) si)]
                     (match (.layout e)
                       (LBits [_ _] (None [Type]))
                       (_ (let [fs (load (field e fields))
                                (mut found) (None [Type])
                                (mut count) 0]
                            (for [i 0 (len (load fs))]
                              (let [ft (field (wal-at [Field] fs i) ty)]
                                (unless (= (wty-size g ft) (primitive/cast i64 0))
                                  (set! count (+ count 1))
                                  (set! found (wsingle-element g ft)))))
                            (if (= count 1) found (None [Type])))))))))
    (TArray [elem n] (if (= (extent-value n) 1) (wsingle-element g elem) (None [Type])))
    (TInt [_ _] (Some (load t)))
    (TFloat [_] (Some (load t)))
    (TBool [] (Some (load t)))
    (TPtr [_] (Some (load t)))
    (TFn [_ _ _] (Some (load t)))
    (_ (None [Type]))))

(defn wabi-class [(g (ptr Wcg)) (t (ptr Type))] (-> WAbi)
  (cond (match (load t) (TVoid [] true) (_ false)) (WAbiEmpty)
        (wty-scalar? t) (WAbiScalar (load t))
        (= (wty-size g t) (primitive/cast i64 0)) (WAbiEmpty)
        :else
          (match (wsingle-element g t)
            (Some [e] (if (= (wty-size g (box-type (.a g) e)) (wty-size g t))
                          (WAbiScalar e)
                          (WAbiIndirect)))
            (None [] (WAbiIndirect)))))

; A result written through an sret pointer.
(defn wty-aggret? [(g (ptr Wcg)) (ret (ptr Type))] (-> bool)
  (match (wabi-class g ret) (WAbiIndirect [] true) (_ false)))

; the wasm value type (0x7F i32, 0x7E i64, 0x7D f32, 0x7C f64) carrying `t`.
(defn wvaltype [(t (ptr Type))] (-> i64)
  (match (load t)
    (TInt [bits _] (if (<= bits 32) 127 126))
    (TBool [] 127)
    (TFloat [bits] (if (= bits 32) 125 124))
    (_ 126)))

(defn wbuild-functype! [(g (ptr Wcg))
                        (types (ptr (ArrayList Type)))
                        (ret (ptr Type))
                        (variadic bool)
                        (b (mut (ArrayList u8)))] (-> i64)
  (let [np (len (load types))
        aggret (wty-aggret? g ret)
        (mut passed) 0]
    (for [i 0 np]
      (match (wabi-class g (al-elem [Type] types i)) (WAbiEmpty [] 0) (_ (set! passed (+ passed 1)))))
    (wb! (mut b) 96)
    (wuleb! (mut b) (+ passed (+ (when aggret 1) (when variadic 1))))
    (when aggret (wb! (mut b) 126))
    (for [i 0 np]
      (match (wabi-class g (al-elem [Type] types i))
        (WAbiScalar [st] (wb! (mut b) (wvaltype (box-type (.a g) st))))
        (WAbiEmpty [] 0)
        (WAbiIndirect [] (wb! (mut b) 126))))
    (when variadic (wb! (mut b) 126))
    (match (wabi-class g ret)
      (WAbiScalar [st] (do (wuleb! (mut b) 1) (wb! (mut b) (wvaltype (box-type (.a g) st)))))
      (_ (wuleb! (mut b) 0)))
    0))

(defn wtype-idx! [(g (ptr Wcg)) (types (ptr (ArrayList Type))) (ret (ptr Type)) (variadic bool)] (-> i64)
  (let [(mut tb) (al-new [u8] (.a g))]
    (wbuild-functype! g types ret variadic (mut tb))
    (let [key (al-slice [u8] (load tb))
          n (len (.types g))
          (mut i) 0
          (mut r) -1]
      (loop (if (or (>= (load i) n) (>= (load r) (primitive/cast i64 0)))
                (break)
                (do
                  (when (slice-eq-u8 (get (load (field g types)) (load i)) key)
                    (store! r
                            (load i)))
                  (set! i (primitive/iadd (load i) 1)))))
      (if (>= (load r) (primitive/cast i64 0))
          (load r)
          (do
            (push! (mut (.types g)) key)
            (primitive/isub (len (.types g))
                            1))))))

; The canonical i64 of a scalar of type `t` (on the stack) as the C value the ABI
; passes: wrap to i32, or reinterpret a float's bits.
(defn wg-canon->c! [(g (ptr Wcg)) (t (ptr Type))] (-> i64)
  (let [vt (wvaltype t)]
    (cond (= vt 127) (wg-op! g 167)  ; i32.wrap_i64
          (= vt 125) (do (wg-op! g 167) (wg-op! g 190))  ; wrap; f32.reinterpret_i32
          (= vt 124) (wg-op! g 191)  ; f64.reinterpret_i64
          :else 0)))

; A C value of type `t` (on the stack) as its canonical i64.
(defn wg-c->canon! [(g (ptr Wcg)) (t (ptr Type))] (-> i64)
  (let [vt (wvaltype t)]
    (cond (= vt 127)
            (match (load t)
              (TInt [bits signed]
                    (do
                      (wg-op! g (if signed 172 173))  ; i64.extend_i32_s / _u
                      (wg-canon-int! g bits signed)))
              (_ (do (wg-op! g 173) (wg-i64-const! g 1) (wg-op! g 131) 0)))  ; bool: low bit
          (= vt 125) (do (wg-op! g 188) (wg-op! g 173) 0)  ; i32.reinterpret_f32; extend_u
          (= vt 124) (wg-op! g 189)  ; i64.reinterpret_f64
          :else 0)))

(defn slice-eq-u8 [(a (slice u8)) (b (slice u8))] (-> bool)
  (let [n (len a)]
    (if (!= n (len b))
        false
        (let [(mut i) 0
              (mut ok) true]
          (loop (if (or (>= (load i) n) (not (load ok)))
                    (break)
                    (do
                      (when (!= (primitive/cast i64 (get a (load i)))
                                (primitive/cast i64 (get b (load i))))
                        (store! ok false))
                      (set! i (primitive/iadd (load i) 1)))))
          (load ok)))))

; ============================ reachability (call-graph from main) ============
(defn wname-present? [(lst (ptr (ArrayList (slice u8)))) (nm (slice u8))] (-> bool)
  (let [n (len (load lst))
        (mut i) 0
        (mut r) false]
    (loop (if (or (>= (load i) n) (load r))
              (break)
              (do
                (when (= (get (load lst) (load i)) nm) (store! r true))
                (set! i (primitive/iadd (load i) 1)))))
    (load r)))

(defn wname-add! [(lst (mut (ArrayList (slice u8)))) (nm (slice u8))] (-> i64)
  (unless (wname-present? (mut lst) nm) (push! (mut lst) nm) 0))

;;; The direct subexpressions of `e`, for every expression kind that can reach
;;; a backend — so a walk finds what sits in a cleanup, an initializer, a dyn
;;; receiver or an llvm-ir argument as surely as in a call.
(defn wkid! [(out (mut (ArrayList (ptr Expr)))) (x (ptr Expr))] (-> i64)
  (unless (= (primitive/cast i64 x) (primitive/cast i64 0)) (push! (mut out) x))
  0)

(defn wkids! [(out (mut (ArrayList (ptr Expr)))) (xs (ptr (ArrayList Expr)))] (-> i64)
  (for [i 0 (len (load xs))] (push! (mut out) (wal-at [Expr] xs i)))
  0)

(defn wexpr-children [(a (dyn Allocator)) (e (ptr Expr))] (-> (ArrayList (ptr Expr)))
  (let [(mut out) (al-new [(ptr Expr)] a)]
    (do
      (match (.kind e)
        (ECall [_f _t args] (wkids! (mut out) args))
        (ECallPtr [fp args] (do (wkid! (mut out) fp) (wkids! (mut out) args)))
        (EBin [_o l r] (do (wkid! (mut out) l) (wkid! (mut out) r)))
        (ECmp [_o l r] (do (wkid! (mut out) l) (wkid! (mut out) r)))
        (EIntUnary [_ i] (wkid! (mut out) i))
        (EIf [c t el] (do (wkid! (mut out) c) (wkid! (mut out) t) (wkid! (mut out) el)))
        (EDo [b] (wkids! (mut out) b))
        (ELet [binds body]
              (do
                (for [i 0 (len (load binds))]
                  (push! (mut out) (field (wal-at [Bind] binds i) value)))
                (wkids! (mut out) body)))
        (ELoop [_l b] (wkids! (mut out) b))
        (EBreak [_l value] (match value (Some [ve] (wkid! (mut out) ve)) (None [] 0)))
        (EBorrow [_m place] (wkid! (mut out) place))
        (ESpillRef [i] (wkid! (mut out) i))
        (EMovePlace [i] (wkid! (mut out) i))
        (EField [p _f] (wkid! (mut out) p))
        (EAccessorField [p _f] (wkid! (mut out) p))
        (ELoad [i] (wkid! (mut out) i))
        (EStore [p v] (do (wkid! (mut out) p) (wkid! (mut out) v)))
        (EInitStore [p v] (do (wkid! (mut out) p) (wkid! (mut out) v)))
        (EIndex [p i] (do (wkid! (mut out) p) (wkid! (mut out) i)))
        (ECast [_t i] (wkid! (mut out) i))
        (EBitGet [p _f] (wkid! (mut out) p))
        (EBitSet [p _f v] (do (wkid! (mut out) p) (wkid! (mut out) v)))
        (EFree [i] (wkid! (mut out) i))
        (EErase [_t i] (wkid! (mut out) i))
        (EComptime [i] (wkid! (mut out) i))
        (EAlloc [_s _t init _sym] (wkid! (mut out) init))
        (EMatch [s arms]
                (do
                  (wkid! (mut out) s)
                  (for [i 0 (len (load arms))]
                    (push! (mut out) (field (wal-at [Arm] arms i) body)))))
        (EConstruct [_s _v args] (wkids! (mut out) args))
        (ELlvmIr [_r args _b] (wkids! (mut out) args))
        (EVector [_ _ _ args] (wkids! (mut out) args))
        (EMakeSlice [data _e _l] (wkid! (mut out) data))
        (EStaticArray [_i items] (wkids! (mut out) items))
        (ECleanup [body cleanups] (do (wkid! (mut out) body) (wkids! (mut out) cleanups)))
        (EMakeDyn [_d _v _m inner] (wkid! (mut out) inner))
        (EDynDispatch [_d _v _m _c _p _r recv args] (do (wkid! (mut out) recv) (wkids! (mut out) args)))
        (_ 0)))
    out))

;;; Every function name an expression can reach: calls, function pointers, and
;;; trait-object vtables.
(defn wcollect-expr! [(out (mut (ArrayList (slice u8)))) (e (ptr Expr))] (-> i64)
  (match (.kind e)
    (ECall [func _t _args] (wname-add! (mut out) func))
    ; a function pointer may be its by-value C entry (wfnptr-target)
    (EFnPtrOf [name]
              (do
                (wname-add! (mut out) name)
                (wname-add! (mut out) (export-c-thunk-name (.alc out) name))))
    (EMakeDyn [_d _v methods _i]
              (for [i 0 (len (load methods))]
                (wname-add! (mut out) (get (load methods) i))))
    (_ 0))
  (let [kids (wexpr-children (.alc out) e)]
    (for [i 0 (len kids)]
      (wcollect-expr! (mut out) (get kids i))))
  0)

(defn wcollect-body! [(out (mut (ArrayList (slice u8))))
                      (body (ptr (ArrayList Expr)))] (-> i64)
  (let [n (len (load body))
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (wcollect-expr! (mut out) (wal-at [Expr] body (load i)))
                (set! i (primitive/iadd (load i) 1))))))
  0)

(defn wfind-func-idx [(mp (ptr Program)) (nm (slice u8))] (-> i64)
  (let [fs (load (field mp funcs))
        n (len (load fs))
        (mut i) 0
        (mut r) -1]
    (loop (if (or (>= (load i) n) (>= (load r) (primitive/cast i64 0)))
              (break)
              (do
                (when (= (load (field (wal-at [Func] fs (load i)) name)) nm)
                  (store! r
                          (load i)))
                (set! i (primitive/iadd (load i) 1)))))
    (load r)))

(defn wprogram-main-name [(mp (ptr Program))] (-> (slice u8))
  (let [fs (load (field mp funcs))
        n (len (load fs))
        (mut i) 0
        (mut r) ""]
    (loop (if (>= (load i) n)
              (break)
              (do
                (let [nm (.name (wal-at [Func] fs (load i)))]
                  (when (and (= (len r) (primitive/cast i64 0))
                             (= (wlast-component nm) "main"))
                    (store! r nm)))
                (set! i (primitive/iadd (load i) 1)))))
    (when (= (len (load r)) (primitive/cast i64 0))
      (wcg-fail "no `main` function in the program"))
    (load r)))

; the C symbol an (export-c …) entry is exported under (its :as name, or the
; function's last dotted component when :as was omitted).
(defn wexportc-sym [(ec (ptr ExportC))] (-> (slice u8))
  (match (.symbol ec)
    (Some [s] s)
    (None []
          (wlast-component (.name ec)))))

; reachability SEEDS: standalone ⇒ `main`; side-module ⇒ every (export-c …) entry.
(defn wseeds [(a (dyn Allocator)) (mp (ptr Program)) (side bool)] (-> (ptr (ArrayList (slice u8))))
  (let [(mut s) (al-new [(slice u8)] a)]
    (if side
        (let [es (load (field mp exports))
              n (len (load es))
              (mut i) 0]
          (when (= n (primitive/cast i64 0))
            (wcg-fail "side-module mode requires at least one (export-c …) metaprogram entry"))
          (loop (if (>= (load i) n)
                    (break)
                    (do
                      (when (.published (wal-at [ExportC] es (load i)))
                        (wname-add! (mut s)
                                    (.name (wal-at [ExportC] es (load i)))))
                      (set! i (primitive/iadd (load i) 1))))))
        (wname-add! (mut s) (wprogram-main-name mp)))
    (box-al [(slice u8)] a (load s))))

; A call to an extern whose C symbol this program defines with export-c runs the
; definition, as when C objects are linked; the wasm import is never made.
(defn wcall-target [(mp (ptr Program)) (func (slice u8))] (-> (slice u8))
  (let [ei (wfind-extern mp func)]
    (if (< ei (primitive/cast i64 0))
        func
        (match (export-c-interposer mp (extern-link-name (wal-at [Extern] (load (field mp externs)) ei)))
          (Some [f] f)
          (None [] func)))))

(defn wcg-reachable [(a (dyn Allocator))
                     (mp (ptr Program))
                     (seeds (ptr (ArrayList (slice u8))))] (-> (ArrayList i64))
  (let [(mut names) (al-new [(slice u8)] a)
        (mut wi) 0]
    (let [ns (len (load seeds))
          (mut j) 0]
      (loop (if (>= (load j) ns)
                (break)
                (do
                  (wname-add! (mut names) (get (load seeds) (load j)))
                  (set! j (primitive/iadd (load j) 1))))))
    ; every runtime `def` is laid out in the data segment, and its initializer may
    ; hold function pointers
    (let [cs (load (field mp consts))]
      (for [k 0 (len (load cs))]
        (let [cp (al-elem [Const] cs k)]
          (when (.runtime cp)
            (wcollect-expr! (mut names) (field cp value))))))
    (loop (if (>= (load wi) (len (load names)))
              (break)
              (do
                (let [nm (get (load names) (load wi))
                      _interposed (wname-add! (mut names) (wcall-target mp nm))
                      fidx (wfind-func-idx mp nm)]
                  (when (>= fidx (primitive/cast i64 0))
                    (wcollect-body! (mut names)
                                    (load (field (wal-at [Func]
                                                         (load (field mp
                                                                      funcs))
                                                         fidx)
                                                 body)))))
                (set! wi (primitive/iadd (load wi) 1)))))
    (let [fs (load (field mp funcs))
          n (len (load fs))
          (mut keep) (al-new [i64] a)
          (mut i) 0]
      (loop (if (>= (load i) n)
                (break)
                (do
                  (when (wname-present? (mut names)
                                        (load (field (wal-at [Func] fs (load i))
                                                     name)))
                    (push! (mut keep) (load i)))
                  (set! i (primitive/iadd (load i) 1)))))
      (load keep))))

(defn wal-get-keep [(keep (ptr (ArrayList i64))) (i i64)] (-> i64)
  (get (load keep) i))

; ============================ extern imports ================================
; A call to a function that is declared `extern` but not DEFINED becomes a wasm
; import `env.<C-symbol>` (same convention as the LLVM wasm path). Imports occupy
; the LOW function-index space (0..K-1); defined functions shift up by K. `free`
; (from EFree) and `malloc` (from alloc-heap) are synthesized on demand.
(defn wfind-extern [(mp (ptr Program)) (nm (slice u8))] (-> i64)
  (let [es (load (field mp externs))
        n (len (load es))
        (mut i) 0
        (mut r) -1]
    (loop (if (or (>= (load i) n) (>= (load r) (primitive/cast i64 0)))
              (break)
              (do
                (when (= (load (field (wal-at [Extern] es (load i)) name)) nm)
                  (store! r
                          (load i)))
                (set! i (primitive/iadd (load i) 1)))))
    (load r)))

(defn wimport-idx [(g (ptr Wcg)) (fieldnm (slice u8))] (-> i64)
  (let [n (len (.imports g))
        (mut i) 0
        (mut r) -1]
    (loop (if (or (>= (load i) n) (>= (load r) (primitive/cast i64 0)))
              (break)
              (do
                (when (= (load (field (wal-at [WImport]
                                              (field g imports)
                                              (load i))
                                      field))
                         fieldnm)
                  (store! r (load i)))
                (set! i (primitive/iadd (load i) 1)))))
    (load r)))

; add (dedup by symbol) an import; returns its funcidx (its ordinal among imports).
; Imports are added as code needs them: they occupy the low function indices, and
; direct calls to defined functions are patched once the count is final.
(defn wadd-import! [(g (ptr Wcg))
                    (fieldnm (slice u8))
                    (types (ptr (ArrayList Type)))
                    (ret Type)
                    (variadic bool)] (-> i64)
  (let [ex (wimport-idx g fieldnm)]
    (if (>= ex (primitive/cast i64 0))
        (.funcidx (wal-at [WImport] (field g imports) ex))
        (let [retp (primitive/alloc-stack Type)
              e (primitive/alloc-stack WImport)
              fidx (len (.imports g))]
          (set! retp ret)
          (set! (.field e) fieldnm)
          (set! (.params e) types)
          (set! (.ret e) ret)
          (set! (.funcidx e) fidx)
          (set! (.typeidx e) (wtype-idx! g types retp variadic))
          (set! (.variadic e) variadic)
          (push! (mut (.imports g)) (load e))
          fidx))))

; The import a compiler-synthesized libc/libm call uses (malloc, free, fmod, sin…),
; typed exactly as the C function. A program's own declaration of the same symbol
; must agree with it (see wcheck-import-signature!).
(defn wlibc-import! [(g (ptr Wcg)) (fieldnm (slice u8)) (types (ptr (ArrayList Type))) (ret Type)] (-> i64)
  (let [ii (wadd-import! g fieldnm types ret false)
        imp (wal-at [WImport] (field g imports) ii)
        ip (.params imp)
        (mut same) (and (= (len (load ip)) (len (load types)))
                        (and (not (.variadic imp))
                             (extern-abi-type-eq (field imp ret) (box-type (.a g) ret))))]
    (when (load same)
      (for [i 0 (len (load ip))]
        (unless (extern-abi-type-eq (al-elem [Type] ip i) (al-elem [Type] types i))
          (store! same false))))
    (unless (load same)
      (wcg-fail2 "C symbol declared twice with different signatures; wasm imports are typed per symbol, so one C symbol needs one signature: " fieldnm))
    ii))

(defn wfloat-list [(a (dyn Allocator)) (bits i64) (n i64)] (-> (ptr (ArrayList Type)))
  (let [(mut l) (al-new [Type] a)]
    (for [i 0 n] (push! (mut l) (TFloat bits)))
    (box-al [Type] a (load l))))

; synthetic libc signatures: void free(void*) ; void* malloc(size_t).
(defn wfree-params [(a (dyn Allocator))] (-> (ptr (ArrayList Type)))
  (box-al [Type]
          a
          (let [(mut l) (al-new [Type] a)]
            (push! (mut l) (TPtr (box-type a (TInt 8 false))))
            (load l))))

(defn wmalloc-params [(a (dyn Allocator))] (-> (ptr (ArrayList Type)))
  (box-al [Type]
          a
          (let [(mut l) (al-new [Type] a)]
            (push! (mut l) (TInt 64 true))
            (load l))))

;;; A wasm import is typed per (module, name), so unlike a native call it cannot be
;;; built against each declaration's own prototype: every declaration of one C
;;; symbol must agree on machine types, integer widths included.
(defn wcheck-import-signature! [(g (ptr Wcg)) (ed (ptr Extern))] (-> i64)
  (let [imp (wal-at [WImport] (field g imports) (wimport-idx g (extern-link-name ed)))
        ip (.params imp)
        ep (.params ed)
        (mut same) (and (= (len (load ip)) (len (load ep)))
                        (extern-abi-type-eq (field imp ret) (field ed ret)))]
    (when (load same)
      (for [i 0 (len (load ip))]
        (unless (extern-abi-type-eq (al-elem [Type] ip i) (al-elem [Type] ep i))
          (store! same false)
          0)
        0)
      0)
    (when (!= (.variadic imp) (load (field ed variadic)))
      (store! same false))
    (unless (load same)
      (wcg-fail2 "C symbol declared twice with different signatures; wasm imports are typed per symbol, so one C symbol needs one signature: " (extern-link-name ed)))
    0))

; The import behind a call to an extern this program does not define.
(defn wextern-import! [(g (ptr Wcg)) (ed (ptr Extern))] (-> i64)
  (let [ii (wadd-import! g
                         (extern-link-name ed)
                         (load (field ed params))
                         (load (field ed ret))
                         (load (field ed variadic)))]
    (wcheck-import-signature! g ed)
    ii))

; ============================ sig registration ==============================
(defn wsig-idx [(g (ptr Wcg)) (nm (slice u8))] (-> i64)
  (let [n (len (.sigs g))
        (mut i) 0
        (mut r) -1]
    (loop (if (>= (load i) n)
              (break)
              (do
                (when (= (load (field (wal-at [WSig] (field g sigs) (load i))
                                      name))
                         nm)
                  (store! r
                          (load i)))
                (set! i (primitive/iadd (load i) 1)))))
    (load r)))

(defn wparams->types [(a (dyn Allocator)) (ps (ptr (ArrayList Param)))] (-> (ptr (ArrayList Type)))
  (let [n (len (load ps))
        (mut out) (al-new [Type] a)
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (push! (mut out) (.ty (wal-at [Param] ps (load i))))
                (set! i (primitive/iadd (load i) 1)))))
    (box-al [Type] a (load out))))

(defn wcg-register-sigs! [(g (ptr Wcg))
                          (mp (ptr Program))
                          (keep (ptr (ArrayList i64)))] (-> i64)
  (let [fs (load (field mp funcs))
        a (.a g)
        n (len (load keep))
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (let [fd (wal-at [Func] fs (wal-get-keep keep (load i)))
                      types (wparams->types a (load (field fd params)))
                      retp (primitive/alloc-stack Type)
                      e (primitive/alloc-stack WSig)]
                  (set! retp (.ret fd))
                  (set! (.name e) (.name fd))
                  (set! (.params e) types)
                  (set! (.ret e) (.ret fd))
                  (set! (.ordinal e) (load i))
                  (set! (.typeidx e) (wtype-idx! g types retp false))
                  (push! (mut (.sigs g)) (load e)))
                (set! i (primitive/iadd (load i) 1))))))
  0)

; the wasm function index of the defined function with ordinal `ordinal` — valid
; once every import has been added (imports come first).
(defn wfunc-index [(g (ptr Wcg)) (ordinal i64)] (-> i64)
  (+ (len (.imports g)) ordinal))

; the defined-function ordinal of `main`, for the export section.
(defn wcg-main-idx [(g (ptr Wcg))] (-> i64)
  (let [n (len (.sigs g))
        (mut i) 0
        (mut r) -1]
    (loop (if (>= (load i) n)
              (break)
              (do
                (when (and (= (wlast-component (load (field (wal-at [WSig]
                                                                    (field g
                                                                           sigs)
                                                                    (load i))
                                                            name)))
                              "main")
                           (< (load r) (primitive/cast i64 0)))
                  (store! r (load i)))
                (set! i (primitive/iadd (load i) 1)))))
    (when (< (load r) (primitive/cast i64 0))
      (wcg-fail "no `main` function in the program"))
    (.ordinal (wal-at [WSig] (field g sigs) (load r)))))

; ============================ op-code tables ================================
(defn wbin-opcode [(op i64) (signed bool)] (-> i64)
  (cond (= op (primitive/cast i64 0)) 124
        (= op (primitive/cast i64 1)) 125
        (= op (primitive/cast i64 2)) 126
        (= op (primitive/cast i64 3)) (if signed 127 128)
        (= op (primitive/cast i64 4)) (if signed 129 130)
        (= op (primitive/cast i64 5)) 128
        (= op (primitive/cast i64 6)) 130
        (= op (primitive/cast i64 7)) 131
        (= op (primitive/cast i64 8)) 132
        (= op (primitive/cast i64 9)) 133
        (= op (primitive/cast i64 10)) 134
        (= op (primitive/cast i64 11)) (if signed 135 136)
        :else (wcg-fail "unknown integer binary op")))

(defn wcmp-opcode [(op i64) (signed bool)] (-> i64)
  (cond (= op (primitive/cast i64 0)) (if signed 83 84)
        (= op (primitive/cast i64 1)) (if signed 87 88)
        (= op (primitive/cast i64 2)) (if signed 85 86)
        (= op (primitive/cast i64 3)) (if signed 89 90)
        (= op (primitive/cast i64 4)) 81
        (= op (primitive/cast i64 5)) 82
        :else (wcg-fail "unknown comparison op")))

; Canonicalize the i64 on the stack to a `bits`-wide integer: sign- or
; zero-extended from bit bits-1, the invariant every slot holds (so `=`, `<` and
; a later widening see the value the narrow type has).
(defn wg-canon-int! [(g (ptr Wcg)) (bits i64) (signed bool)] (-> i64)
  (when (< bits (primitive/cast i64 64))
    (let [sh (primitive/isub 64 bits)]
      (wg-i64-const! g sh)
      (wg-op! g 134)
      (wg-i64-const! g sh)
      (wg-op! g (if signed 135 136))
      0))
  0)

; ---- floats -------------------------------------------------------------------
; A float in a slot is its bit pattern (an f32's in the low 32 bits). These move
; it to and from a native f32/f64 on the operand stack.
(defn wty-float-bytes [(t (ptr Type))] (-> i64)
  (match (load t) (TFloat [bits] (/ bits 8)) (_ 8)))

(defn wg-push-float! [(g (ptr Wcg)) (av WAVal) (bytes i64)] (-> i64)
  (wg-push-av! g av)
  (if (= bytes (primitive/cast i64 4))
      (do (wg-op! g 167) (wg-op! g 190))  ; i32.wrap_i64; f32.reinterpret_i32
      (wg-op! g 191)))  ; f64.reinterpret_i64

(defn wg-float-bits! [(g (ptr Wcg)) (bytes i64)] (-> i64)
  (if (= bytes (primitive/cast i64 4))
      (do (wg-op! g 188) (wg-op! g 173))  ; i32.reinterpret_f32; i64.extend_i32_u
      (wg-op! g 189)))  ; i64.reinterpret_f64

; fN.add/sub/mul/div opcode for op 0..3
(defn wfloat-bin-opcode [(op i64) (bytes i64)] (-> i64)
  (+ (if (= bytes (primitive/cast i64 4)) 146 160) op))

; ordered comparisons, like the LLVM backend's fcmp o-predicates: op 0 lt 1 le
; 2 gt 3 ge 4 eq (5, ordered not-equal, is lt|gt)
(defn wfloat-cmp-opcode [(op i64) (bytes i64)] (-> i64)
  (let [base (if (= bytes (primitive/cast i64 4)) 91 97)]  ; f32.eq / f64.eq
    (cond (= op (primitive/cast i64 0)) (+ base 2)
          (= op (primitive/cast i64 1)) (+ base 4)
          (= op (primitive/cast i64 2)) (+ base 3)
          (= op (primitive/cast i64 3)) (+ base 5)
          :else base)))

; Call a libm function on floats already evaluated into `avs`.
(defn wemit-libm-call [(g (ptr Wcg)) (fname (slice u8)) (bits i64) (avs (ptr (ArrayList WAVal)))] (-> WAVal)
  (let [a (.a g)
        types (wfloat-list a bits (len (load avs)))
        retp (box-type a (TFloat bits))
        ii (wlibc-import! g fname types (TFloat bits))]
    (wemit-invoke-avs g types retp avs (WImported (.funcidx (wal-at [WImport] (field g imports) ii))) false)))

; ============================ expression lowering ============================
(defn wemit-body [(g (ptr Wcg)) (body (ptr (ArrayList Expr)))] (-> WAVal)
  (let [n (len (load body))
        (mut i) 0
        (mut last) (mk-av 0 0 (TInt 64 true))]
    (loop (if (>= (load i) n)
              (break)
              (do
                (when (load (field g terminated)) (break))
                (set! last (wemit-expr g (wal-at [Expr] body (load i))))
                (set! i (primitive/iadd (load i) 1)))))
    (load last)))

(defn wemit-stmts [(g (ptr Wcg)) (body (ptr (ArrayList Expr)))] (-> i64)
  (let [n (len (load body))
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (when (load (field g terminated)) (break))
                (wemit-expr g (wal-at [Expr] body (load i)))
                (set! i (primitive/iadd (load i) 1))))))
  0)

(defn wemit-binds [(g (ptr Wcg)) (binds (ptr (ArrayList Bind)))] (-> i64)
  (let [n (len (load binds))
        (mut i) 0
        (mut a) (.a g)]
    (loop (if (>= (load i) n)
              (break)
              (do
                (let [b (wal-at [Bind] binds (load i))
                      av (wemit-expr g (field b value))]
                  ; post-check, mutable bindings are lowered to EAlloc; a bind just names a value.
                  (set! (.env g)
                        (wscope-put (load a)
                                    (load (field g env))
                                    (.name b)
                                    av)))
                (set! i (primitive/iadd (load i) 1))))))
  0)

(defn wg-loop-index [(g (ptr Wcg)) (label (Option (slice u8)))] (-> i64)
  (let [n (len (.loops g))]
    (match label
      (None []
            (do
              (when (= n (primitive/cast i64 0))
                (wcg-fail "break/continue outside a loop"))
              (primitive/isub n 1)))
      (Some [want]
            (let [(mut i) (primitive/isub n 1)
                  (mut r) -1]
              (loop (if (< (load i) (primitive/cast i64 0))
                        (break)
                        (do
                          (match (.label (wal-at [WLoop]
                                                 (field g loops)
                                                 (load i)))
                            (None [] 0)
                            (Some [have]
                                  (when (and (< (load r) (primitive/cast i64 0))
                                             (= have want))
                                    (store! r (load i))
                                    0)))
                          (set! i (primitive/isub (load i) 1)))))
              (when (< (load r) (primitive/cast i64 0))
                (wcg-fail2 "no such loop label: " want))
              (load r))))))

(defn wemit-bin [(g (ptr Wcg)) (op i64) (lhs (ptr Expr)) (rhs (ptr Expr))] (-> WAVal)
  (let [lav (wemit-expr g lhs)
        rav (wemit-expr g rhs)
        t (primitive/alloc-stack Type)]
    (set! t (av-ty lav))
    (if (wty-float? t)
        (wemit-float-bin g op lav rav)
    (let [signed (match (load t) (TInt [_b sg] sg) (_ true))
          slot (wslot-new! g 8 8)]
      (wg-push-addr! g slot)
      (wg-push-av! g lav)
      (wg-push-av! g rav)
      (wg-op! g (wbin-opcode op signed))
      (match (load t) (TInt [bits sg] (wg-canon-int! g bits sg)) (_ 0))
      (wg-i64-store! g)
      (mk-av 1 slot (av-ty lav))))))

(defn wemit-float-bin [(g (ptr Wcg)) (op i64) (lav WAVal) (rav WAVal)] (-> WAVal)
  (let [t (primitive/alloc-stack Type)]
    (set! t (av-ty lav))
    (let [bytes (wty-float-bytes t)]
      (if (= op (primitive/cast i64 4))
          ; frem is C fmod: wasm has no remainder instruction for floats
          (let [(mut avs) (al-new [WAVal] (.a g))]
            (push! (mut avs) lav)
            (push! (mut avs) rav)
            (wemit-libm-call g (if (= bytes 4) "fmodf" "fmod") (* bytes 8) (box-al [WAVal] (.a g) (load avs))))
          (let [slot (wslot-new! g 8 8)]
            (when (> op (primitive/cast i64 4))
              (wcg-fail "unsupported float binary op"))
            (wg-push-addr! g slot)
            (wg-push-float! g lav bytes)
            (wg-push-float! g rav bytes)
            (wg-op! g (wfloat-bin-opcode op bytes))
            (wg-float-bits! g bytes)
            (wg-i64-store! g)
            (mk-av 1 slot (load t)))))))

(defn wemit-cmp [(g (ptr Wcg)) (op i64) (lhs (ptr Expr)) (rhs (ptr Expr))] (-> WAVal)
  (let [lav (wemit-expr g lhs)
        rav (wemit-expr g rhs)
        t (primitive/alloc-stack Type)]
    (set! t (av-ty lav))
    (if (wty-float? t)
        (let [bytes (wty-float-bytes t)
              slot (wslot-new! g 8 8)]
          (wg-push-addr! g slot)
          (wg-push-float! g lav bytes)
          (wg-push-float! g rav bytes)
          (if (= op (primitive/cast i64 5))
              ; ordered not-equal: lt | gt (false when either side is NaN)
              (do
                (wg-op! g (wfloat-cmp-opcode 0 bytes))
                (wg-push-float! g lav bytes)
                (wg-push-float! g rav bytes)
                (wg-op! g (wfloat-cmp-opcode 2 bytes))
                (wg-op! g 114))  ; i32.or
              (wg-op! g (wfloat-cmp-opcode op bytes)))
          (wg-op! g 173)  ; i64.extend_i32_u
          (wg-i64-store! g)
          (mk-av 1 slot (TBool)))
    (let [signed
            (match (load t)
              (TInt [_b sg] sg)
              (TBool [] false)
              (TPtr [_] false)
              (_ true))
          slot (wslot-new! g 8 8)]
      (wg-push-addr! g slot)
      (wg-push-av! g lav)
      (wg-push-av! g rav)
      (wg-op! g (wcmp-opcode op signed))
      (wg-op! g 173)  ; i64.extend_i32_u
      (wg-i64-store! g)
      (mk-av 1 slot (TBool))))))

(defn wemit-if [(g (ptr Wcg))
                (cnd (ptr Expr))
                (thn (ptr Expr))
                (els (ptr Expr))] (-> WAVal)
  (let [cav (wemit-expr g cnd)]
    (wg-push-av! g cav)
    (wg-i64-const! g 0)
    (wg-op! g 82)  ; i64.ne -> i32
    (wg-op! g 4)
    (wg-op! g 64)  ; if void
    (set! (.depth g) (primitive/iadd (.depth g) 1))
    (let [thnav (wemit-expr g thn)
          thnterm (.terminated g)
          (mut rslot) -1
          (mut rty) (TInt 64 true)]
      (unless thnterm
        (store! rslot
                (wslot-for-ty! g
                               (let [tt (primitive/alloc-stack Type)]
                                 (store! tt (av-ty thnav))
                                 tt)))
        (store! rty (av-ty thnav))
        (wg-store-av-to-slot! g thnav (load rslot))
        0)
      (wg-op! g 5)  ; else
      (set! (.terminated g) false)
      (let [elsav (wemit-expr g els)
            elsterm (.terminated g)]
        (unless elsterm
          (when (< (load rslot) (primitive/cast i64 0))
            (store! rslot
                    (wslot-for-ty! g
                                   (let [et (primitive/alloc-stack Type)]
                                     (store! et (av-ty elsav))
                                     et)))
            (store! rty (av-ty elsav))
            0)
          (wg-store-av-to-slot! g elsav (load rslot))
          0)
        (wg-op! g 11)
        (set! (.depth g) (primitive/isub (.depth g) 1))
        (set! (.terminated g) (and thnterm elsterm))
        (if (>= (load rslot) (primitive/cast i64 0))
            (mk-av 1 (load rslot) (load rty))
            (mk-av 0 0 (TInt 64 true)))))))

(defn wemit-loop [(g (ptr Wcg))
                  (label (Option (slice u8)))
                  (body (ptr (ArrayList Expr)))] (-> WAVal)
  (wg-op! g 2)
  (wg-op! g 64)
  (set! (.depth g) (primitive/iadd (.depth g) 1))
  (let [breaklevel (.depth g)]
    (wg-op! g 3)
    (wg-op! g 64)
    (set! (.depth g) (primitive/iadd (.depth g) 1))
    (let [contlevel (.depth g)
          gl (primitive/alloc-stack WLoop)]
      (set! (.label gl) label)
      (set! (.breaklevel gl) breaklevel)
      (set! (.contlevel gl) contlevel)
      (set! (.resslot gl) -1)
      (set! (.resty gl) (TInt 64 true))
      (set! (.has_res gl) false)
      (push! (mut (.loops g)) (load gl))
      (wemit-stmts g body)
      (unless (load (field g terminated))
        (wg-br! g (primitive/isub (load (field g depth)) contlevel))
        0)
      (wg-op! g 11)
      (set! (.depth g) (primitive/isub (.depth g) 1))
      (let [n (len (.loops g))
            fin (get (.loops g) (primitive/isub n 1))
            fp (primitive/alloc-stack WLoop)]
        (set! fp fin)
        (set! (.len (.loops g)) (primitive/isub n 1))
        (wg-op! g 11)
        (set! (.depth g) (primitive/isub (.depth g) 1))
        (if (.has_res fp)
            (do
              (set! (.terminated g) false)
              (mk-av 1
                     (.resslot fp)
                     (.resty fp)))
            (do (set! (.terminated g) true) (mk-av 0 0 (TInt 64 true))))))))

(defn wemit-break [(g (ptr Wcg))
                   (label (Option (slice u8)))
                   (value (Option (ptr Expr)))] (-> WAVal)
  (if (.terminated g)
      (mk-av 0 0 (TInt 64 true))
      (let [av
              (match value
                (Some [ve] (wemit-expr g ve))
                (None [] (mk-av 0 0 (TInt 64 true))))
            li (wg-loop-index g label)
            lp (wal-at [WLoop] (field g loops) li)]
        (when (< (load (field lp resslot)) (primitive/cast i64 0))
          (store! (field lp resslot)
                  (wslot-for-ty! g
                                 (let [t (primitive/alloc-stack Type)]
                                   (store! t
                                           (av-ty av))
                                   t)))
          (store! (field lp resty) (av-ty av))
          (store! (field lp has_res) true)
          0)
        (wg-store-av-to-slot! g av (.resslot lp))
        (wg-br! g (primitive/isub (.depth g) (.breaklevel lp)))
        (set! (.terminated g) true)
        (mk-av 0 0 (TInt 64 true)))))

; ---- calls ------------------------------------------------------------------
; How a call reaches its callee: a defined function (by ordinal, patched to its
; function index at the end), an import (by function index), or a function
; pointer through the table.
(defsum WCallee
  (WDefined [(ordinal i64)])
  (WImported [(funcidx i64)])
  (WIndirect [(fp WAVal) (typeidx i64)]))

; Write a 5-byte (padded) unsigned LEB128, so a later patch never moves code.
(defn wuleb5! [(b (mut (ArrayList u8))) (v i64)] (-> i64)
  (for [k 0 4]
    (wb! (mut b) (primitive/ior (primitive/iand (primitive/ishr v (* k 7)) 127) 128)))
  (wb! (mut b) (primitive/iand (primitive/ishr v 28) 127))
  0)

(defn wpatch-uleb5! [(b (ptr (ArrayList u8))) (off i64) (v i64)] (-> i64)
  (for [k 0 5]
    (let [byte (primitive/iand (primitive/ishr v (* k 7)) 127)]
      (set! (wal-at [u8] b (+ off k))
            (primitive/cast u8 (if (< k 4) (primitive/ior byte 128) byte)))))
  0)

; Push the address of the aggregate `av` stands for: `av` is the aggregate
; itself, or a pointer to it (mono binds an aggregate local as its slot's address).
(defn wg-push-agg-addr! [(g (ptr Wcg)) (av WAVal)] (-> i64)
  (let [tp (box-type (.a g) (av-ty av))]
    (if (wty-scalar? tp) (wg-push-av! g av) (wg-addr-of-av! g av))))

; Copy the aggregate `av` stands for (of type `tp`) into a fresh slot and push the
; copy's address: a C callee owns its byval argument and may write to it.
(defn wg-push-agg-copy! [(g (ptr Wcg)) (av WAVal) (tp (ptr Type))] (-> i64)
  (let [slot (wslot-for-ty! g tp)]
    (wg-push-addr! g slot)
    (wg-push-agg-addr! g av)
    (wg-i64-const! g (wty-size g tp))
    (wg-memcopy! g)
    (wg-push-addr! g slot)))

; Push the scalar a single-element struct value `av` amounts to (element type
; `et`, at offset 0), as its canonical i64.
(defn wg-push-single! [(g (ptr Wcg)) (av WAVal) (et Type)] (-> i64)
  (let [etp (box-type (.a g) et)]
    (wg-push-agg-addr! g av)
    (wg-load-mem! g (wty-size g etp) (wty-signed? etp))))

; The bytes a scalar of type `t` takes in the va_list buffer: a 32-bit-or-narrower
; integer or an f32 is 4 (LLVM legalizes narrower integers to i32), else 8.
(defn wvararg-size [(t (ptr Type))] (-> i64)
  (let [vt (wvaltype t)]
    (if (or (= vt (primitive/cast i64 127)) (= vt (primitive/cast i64 125))) 4 8)))

; The variadic arguments, stored where the callee's va_list reads them: each at
; its natural size and alignment in a frame buffer — an integer narrower than 32
; bits widened to an i32 slot, a single-element struct as its element, an empty
; struct not at all, and any other aggregate as a pointer to a copy — the layout
; clang's va_arg reads and LLVM's wasm lowering writes. Pushes the buffer's
; address, or 0 when it is empty.
(defn wg-push-varargs! [(g (ptr Wcg)) (avs (ptr (ArrayList WAVal))) (from i64)] (-> i64)
  (let [a (.a g)
        n (len (load avs))
        (mut off) 0
        (mut offs) (al-new [i64] a)]
    (for [i from n]
      (let [tp (box-type a (av-ty (get (load avs) i)))
            sz (match (wabi-class g tp)
                 (WAbiScalar [st] (wvararg-size (box-type a st)))
                 (WAbiEmpty [] 0)
                 (WAbiIndirect [] 8))]
        (unless (= sz (primitive/cast i64 0))
          (set! off (* (/ (+ off (- sz 1)) sz) sz)))
        (push! (mut offs) off)
        (set! off (+ off sz))))
    (if (= (load off) (primitive/cast i64 0))
        (wg-i64-const! g 0)
        (let [buf (wslot-new! g (load off) 16)]
          (for [i from n]
            (let [av (get (load avs) i)
                  tp (box-type a (av-ty av))
                  at (+ buf (get offs (- i from)))]
              (match (wabi-class g tp)
                (WAbiScalar [st]
                            (do
                              (wg-push-addr! g at)
                              (if (wty-scalar? tp) (wg-push-av! g av) (wg-push-single! g av st))
                              (wg-store-mem! g (wvararg-size (box-type a st)))))
                (WAbiEmpty [] 0)
                (WAbiIndirect []
                              (do
                                (wg-push-addr! g at)
                                (wg-push-agg-copy! g av tp)
                                (wg-i64-store! g))))))
          (wg-push-addr! g buf)))
    0))

; Call `callee` with already-evaluated arguments `avs`, under the C ABI described
; at wbuild-functype!. `types` are the declared parameter types; arguments past
; them are variadic.
(defn wemit-invoke-avs [(g (ptr Wcg))
                        (types (ptr (ArrayList Type)))
                        (retp (ptr Type))
                        (avs (ptr (ArrayList WAVal)))
                        (callee WCallee)
                        (variadic bool)] (-> WAVal)
  (let [a (.a g)
        rclass (wabi-class g retp)
        retvoid (match (load retp) (TVoid [] true) (_ false))
        aggret (match rclass (WAbiIndirect [] true) (_ false))
        ; a scalar result, or a single-element struct's element, stored into resslot
        scalarret (match rclass (WAbiScalar [_] true) (_ false))
        n (len (load avs))
        nfixed (len (load types))
        ; a Coil function copies an aggregate argument into its own frame; any
        ; other callee is C, which owns its byval copy
        copy (match callee (WDefined [_] false) (_ true))
        resslot (cond (and scalarret (wty-scalar? retp)) (wslot-new! g 8 8)
                      (not retvoid) (wslot-for-ty! g retp)  ; an aggregate result's storage
                      :else -1)]
    (when (and (> n nfixed) (not variadic))
      (wcg-fail "call passes more arguments than a non-variadic callee takes"))
    (when scalarret (wg-push-addr! g resslot))  ; address for the post-call store
    (when aggret (wg-push-addr! g resslot))  ; sret pointer (first arg)
    (for [j 0 (if (< n nfixed) n nfixed)]
      (let [av (get (load avs) j)
            pt (al-elem [Type] types j)
            at (box-type a (av-ty av))]
        (if (wty-scalar? pt)
            (if (wty-scalar? at)
                (do (wg-push-av! g av) (wg-canon->c! g pt) 0)
                ; an aggregate argument declared as a pointer travels as its
                ; address: mono types a by-value struct parameter of a Coil
                ; function as a pointer, and a raw call-ptr keeps that type
                (if copy (wg-push-agg-copy! g av at) (wg-addr-of-av! g av)))
            ; a by-value aggregate parameter (the argument is the aggregate or a
            ; pointer to it), carried as the C ABI says
            (match (wabi-class g pt)
              (WAbiScalar [et]
                          (do
                            (wg-push-single! g av et)
                            (wg-canon->c! g (box-type a et))
                            0))
              (WAbiEmpty [] 0)
              (WAbiIndirect [] (if copy (wg-push-agg-copy! g av pt) (wg-push-agg-addr! g av)))))))
    (when variadic (wg-push-varargs! g avs nfixed))
    (match callee
      (WDefined [ordinal]
                (do
                  (wg-op! g 16)
                  (push! (mut (.curfix g)) (len (.code g)))
                  (push! (mut (.curfix g)) ordinal)
                  (wuleb5! (mut (.code g)) ordinal)))
      (WImported [funcidx] (wg-call! g funcidx))
      (WIndirect [fpav typeidx]
                 (do
                   (set! (.needs-table g) true)
                   (wg-push-av! g fpav)  ; an i64 index: the table is 64-bit, as for C on wasm64
                   (wg-op! g 17)
                   (wg-uleb! g typeidx)
                   (wg-uleb! g 0))))  ; call_indirect typeidx table0
    (match rclass
      (WAbiScalar [st]
                  (let [stp (box-type a st)]
                    (wg-c->canon! g stp)
                    ; a single-element struct result: its element at offset 0
                    (if (wty-scalar? retp) (wg-i64-store! g) (wg-store-mem! g (wty-size g stp)))
                    (mk-av 1 resslot (load retp))))
      (_ (if retvoid
             (mk-av 0 0 (TInt 64 true))
             (mk-av 1 resslot (load retp)))))))

(defn wemit-args [(g (ptr Wcg)) (args (ptr (ArrayList Expr)))] (-> (ptr (ArrayList WAVal)))
  (let [(mut avs) (al-new [WAVal] (.a g))]
    (for [i 0 (len (load args))]
      (push! (mut avs) (wemit-expr g (wal-at [Expr] args i))))
    (box-al [WAVal] (.a g) (load avs))))

(defn wemit-call [(g (ptr Wcg)) (func0 (slice u8)) (args (ptr (ArrayList Expr)))] (-> WAVal)
  (let [func (wcall-target (.program g) func0)
        si (wsig-idx g func)]
    (if (>= si (primitive/cast i64 0))
        ; a DEFINED function: direct call.
        (let [e (wal-at [WSig] (field g sigs) si)
              retp (primitive/alloc-stack Type)]
          (set! retp (.ret e))
          (wemit-invoke-avs g (load (field e params)) retp (wemit-args g args)
                            (WDefined (.ordinal e)) false))
        ; an EXTERN (declared, not defined): call its env.<symbol> import.
        (let [ei (wfind-extern (.program g) func)]
          (when (< ei 0)
            (wcg-fail2 "call to a function that is neither defined nor declared extern: " func))
          (let [ed (wal-at [Extern] (.externs (.program g)) ei)
                ii (wextern-import! g ed)
                imp (wal-at [WImport] (field g imports) ii)
                retp (primitive/alloc-stack Type)]
            (set! retp (.ret imp))
            (wemit-invoke-avs g (load (field imp params)) retp (wemit-args g args)
                              (WImported (.funcidx imp)) (.variadic imp)))))))

(defn wemit-callptr [(g (ptr Wcg))
                     (fp (ptr Expr))
                     (args (ptr (ArrayList Expr)))] (-> WAVal)
  (let [fpav (wemit-expr g fp)
        t (primitive/alloc-stack Type)]
    (set! t (av-ty fpav))
    (match (load t)
      (TFn [_cc params ret]
           (let [retp (primitive/alloc-stack Type)]
             (set! retp (load ret))
             (let [tyidx (wtype-idx! g params retp false)]
               (wemit-invoke-avs g params retp (wemit-args g args) (WIndirect fpav tyidx) false))))
      (_ (do
           (wcg-fail "call-ptr on a value that is not a function pointer reached wasm codegen (checker bug)")
           (mk-av 0 0 (TInt 64 true)))))))

; The type of `(fnptr-of name)`.
; The function a `(fnptr-of name)` points at: its by-value C entry when it has
; one (see wcg-build-module), otherwise the function or the extern it binds to.
(defn wfnptr-target [(g (ptr Wcg)) (name0 (slice u8))] (-> (slice u8))
  (let [name (wcall-target (.program g) name0)
        thunk (export-c-thunk-name (.a g) name)]
    (if (>= (wsig-idx g thunk) (primitive/cast i64 0)) thunk name)))

(defn wfnptr-type [(g (ptr Wcg)) (name0 (slice u8))] (-> Type)
  (let [name (wfnptr-target g name0)
        si (wsig-idx g name)]
    (if (>= si (primitive/cast i64 0))
        (let [e (wal-at [WSig] (field g sigs) si)]
          (TFn :cc "c" :params (load (field e params)) :ret (box-type (.a g) (.ret e))))
        (let [ed (wal-at [Extern] (.externs (.program g)) (wfind-extern (.program g) name))]
          (TFn :cc "c" :params (load (field ed params)) :ret (box-type (.a g) (.ret ed)))))))

; A function pointer's value is its function-table slot: a defined function's
; ordinal, or (after all of them) an import's. `name` may name an extern this
; program does not define: its import is the target.
(defn wfnptr-slot [(g (ptr Wcg)) (name0 (slice u8))] (-> i64)
  (set! (.needs-table g) true)
  (let [name (wfnptr-target g name0)
        si (wsig-idx g name)]
    (if (>= si (primitive/cast i64 0))
        (.ordinal (wal-at [WSig] (field g sigs) si))
        (let [ei (wfind-extern (.program g) name)]
          (when (< ei (primitive/cast i64 0))
            (wcg-fail2 "fnptr-of unknown function: " name))
          (+ (.nkeep g) (wextern-import! g (wal-at [Extern] (.externs (.program g)) ei)))))))

(defn wemit-construct [(g (ptr Wcg))
                       (sum (slice u8))
                       (variant (slice u8))
                       (args (ptr (ArrayList Expr)))] (-> WAVal)
  (let [su (wsum-idx g sum)]
    (when (< su (primitive/cast i64 0))
      (wcg-fail2 "construct of unknown sum: " sum))
    (let [vidx (wvariant-idx g su variant)
          sumty (primitive/alloc-stack Type)]
      (set! sumty (TStruct sum))
      (let [slot (wslot-for-ty! g sumty)
            vs (load (field (sum-at (field g layouts) su) variants))
            vfields (load (field (wal-at [Variant] vs vidx) fields))
            n (len (load args))
            (mut i) 0]
        ; tag: i32 (4 bytes) at offset 0
        (wg-push-addr! g slot)
        (wg-i64-const! g vidx)
        (wg-store-mem! g 4)
        (loop (if (>= (load i) n)
                  (break)
                  (do
                    (let [av (wemit-expr g (wal-at [Expr] args (load i)))
                          off (wnatural-off g vfields (load i))]
                      (wg-store-av-at-off! g
                                           av
                                           (primitive/iadd (primitive/iadd slot
                                                                           8)
                                                           off)))
                    (set! i (primitive/iadd (load i) 1)))))
        (mk-av 1 slot (TStruct sum))))))

; the address of a match scrutinee's sum: the pointer itself when borrowed,
; else the address of the value's slot
(defn wg-push-sum-base! [(g (ptr Wcg)) (sav WAVal) (borrowed bool)] (-> i64)
  (if borrowed (wg-push-av! g sav) (wg-addr-of-av! g sav)))

(defn wemit-match [(g (ptr Wcg))
                   (scrut (ptr Expr))
                   (arms (ptr (ArrayList Arm)))] (-> WAVal)
  (let [sav (wemit-expr g scrut)
        t (primitive/alloc-stack Type)
        a (.a g)]
    (set! t (av-ty sav))
    ; a scrutinee is a sum by value, or a pointer to one (a borrowed match, whose
    ; `$match.ref.` bindings are the addresses of the payload fields)
    (let [borrowed (match (load t)
                     (TPtr [inner] (match (load inner) (TStruct [_] true) (_ false)))
                     (_ false))
          sumname (match (load t)
                    (TStruct [nm] nm)
                    (TPtr [inner] (match (load inner) (TStruct [nm] nm) (_ "")))
                    (_ ""))
          su (wsum-idx g sumname)]
      (when (< su (primitive/cast i64 0))
        (wcg-fail2 "match on non-sum: " sumname))
      (let [vs (load (field (sum-at (field g layouts) su) variants))
            narms (len (load arms))
            ; a trailing `(_ …)` arm opens no `if` of its own — its body IS the
            ; innermost else, in place of the unreachable.
            ncases (if (arms-have-wildcard arms) (primitive/isub narms 1) narms)
            tslot (wslot-new! g 8 8)
            (mut rslot) -1
            (mut rty) (TInt 64 true)
            (mut anylive) false]
        ; tag -> tslot (i32, unsigned)
        (wg-push-addr! g tslot)
        (wg-push-sum-base! g sav borrowed)
        (wg-load-mem! g 4 false)
        (wg-i64-store! g)
        ; nested if/else chain over the tag
        (let [(mut i) 0]
          (loop (if (>= (load i) narms)
                    (break)
                    (do
                      (let [arm (wal-at [Arm] arms (load i))
                            wild (>= (load i) ncases)
                            ; the catch-all binds nothing, so `vfields` is never read;
                            ; variant 0 just keeps the lookup in range.
                            vidx (if wild 0 (wvariant-idx g su (.variant arm)))
                            vfields
                              (load (field (wal-at [Variant] vs vidx) fields))
                            saved (load (field g env))]
                        ; if (tag == vidx)
                        (unless wild
                          (wg-push-addr! g tslot)
                          (wg-i64-load! g)
                          (wg-i64-const! g vidx)
                          (wg-op! g 81)  ; i64.eq
                          (wg-op! g 4)
                          (wg-op! g 64)
                          (store! (field g depth)
                                  (primitive/iadd (load (field g depth)) 1))
                          0)
                        (set! (.terminated g) false)
                        ; bind payload fields by value into fresh slots
                        (let [binds (load (field arm binds))
                              nb (len (load binds))
                              (mut j) 0]
                          (loop (if (>= (load j) nb)
                                    (break)
                                    (do
                                      (let [ftp
                                              (field (wal-at [Field]
                                                             vfields
                                                             (load j))
                                                     ty)
                                            foff
                                              (wnatural-off g vfields (load j))
                                            bname (get (load binds) (load j))]
                                        (if (and borrowed (starts-with bname "$match.ref."))
                                            ; bind the field's address
                                            (let [bslot (wslot-new! g 8 8)]
                                              (wg-push-addr! g bslot)
                                              (wg-push-sum-base! g sav borrowed)
                                              (wg-i64-const! g (+ 8 foff))
                                              (wg-op! g 124)
                                              (wg-i64-store! g)
                                              (set! (.env g)
                                                    (wscope-put a (load (field g env)) bname
                                                                (mk-av 1 bslot (TPtr ftp)))))
                                            ; copy the field's value into a fresh slot
                                            (let [bslot (wslot-for-ty! g ftp)]
                                              (wg-push-addr! g bslot)
                                              (wg-push-sum-base! g sav borrowed)
                                              (wg-i64-const! g (+ 8 foff))
                                              (wg-op! g 124)
                                              (if (wty-scalar? ftp)
                                                  (do
                                                    (wg-load-mem! g (wty-size g ftp) (wty-signed? ftp))
                                                    (wg-i64-store! g))
                                                  (do
                                                    (wg-i64-const! g (wty-size g ftp))
                                                    (wg-memcopy! g)))
                                              (set! (.env g)
                                                    (wscope-put a (load (field g env)) bname
                                                                (mk-av 1 bslot (load ftp)))))))
                                      (set! j (primitive/iadd (load j) 1))))))
                        (let [bav (wemit-expr g (field arm body))]
                          (set! (.env g) saved)
                          (unless (load (field g terminated))
                            (when (< (load rslot) (primitive/cast i64 0))
                              (store! rslot
                                      (wslot-for-ty! g
                                                     (let [bt
                                                             (primitive/alloc-stack Type)]
                                                       (store! bt (av-ty bav))
                                                       bt)))
                              (store! rty (av-ty bav))
                              0)
                            (wg-store-av-to-slot! g bav (load rslot))
                            (store! anylive true)
                            0))
                        (unless wild (wg-op! g 5) 0))  ; else — the next arm nests here
                      (set! i (primitive/iadd (load i) 1)))))
          ; innermost else: the catch-all already wrote its body here; with no
          ; catch-all, no variant matched (unreachable, mirrors the LLVM switch default)
          (when (= ncases narms) (wg-op! g 0) 0)
          ; close all the ifs
          (let [(mut k) 0]
            (loop (if (>= (load k) ncases)
                      (break)
                      (do
                        (wg-op! g 11)
                        (set! (.depth g) (primitive/isub (.depth g) 1))
                        (set! k (primitive/iadd (load k) 1))))))
          (if (load anylive)
              (do
                (set! (.terminated g) false)
                (mk-av 1 (load rslot) (load rty)))
              (do (set! (.terminated g) true) (mk-av 0 0 (TInt 64 true)))))))))

(defn wemit-cast [(g (ptr Wcg)) (t Type) (inner (ptr Expr))] (-> WAVal)
  (wemit-cast-av g t (wemit-expr g inner)))

; The LLVM backend's cast semantics on the canonical i64: integer widths re-extend
; from the target width; float -> integer truncates toward zero, saturating
; (fcvtzs/fcvtzu on arm64); integer -> float honours the SOURCE signedness.
(defn wemit-cast-av [(g (ptr Wcg)) (t Type) (av WAVal)] (-> WAVal)
  (let [st (primitive/alloc-stack Type)
        dt (primitive/alloc-stack Type)]
    (set! st (av-ty av))
    (set! dt t)
    (match t
      (TInt [bits signed]
            (let [slot (wslot-new! g 8 8)]
              (wg-push-addr! g slot)
              (if (wty-float? st)
                  (let [bytes (wty-float-bytes st)]
                    (wg-push-float! g av bytes)
                    ; i64.trunc_sat_f32_s/_u (4/5), i64.trunc_sat_f64_s/_u (6/7)
                    (wg-op! g 252)
                    (wg-uleb! g (+ (if (= bytes 4) 4 6) (if signed 0 1))))
                  (wg-push-av! g av))
              (wg-canon-int! g bits signed)
              (wg-i64-store! g)
              (mk-av 1 slot t)))
      (TFloat [bits]
              (let [slot (wslot-new! g 8 8)
                    dbytes (/ bits 8)]
                (wg-push-addr! g slot)
                (if (wty-float? st)
                    (let [sbytes (wty-float-bytes st)]
                      (wg-push-float! g av sbytes)
                      (unless (= sbytes dbytes)
                        (wg-op! g (if (= dbytes 8) 187 182))))  ; f64.promote_f32 / f32.demote_f64
                    (let [ssigned (match (load st) (TInt [_b sg] sg) (_ false))]
                      (wg-push-av! g av)
                      ; f32.convert_i64_s/_u (180/181), f64.convert_i64_s/_u (185/186)
                      (wg-op! g (+ (if (= dbytes 4) 180 185) (if ssigned 0 1)))))
                (wg-float-bits! g dbytes)
                (wg-i64-store! g)
                (mk-av 1 slot t)))
      (_  ; ptr / ref / fnptr targets: bit-identical scalar; retype in place.
         (if (wty-scalar? dt)
             (mk-av (av-kind av) (av-v av) t)
             (do
               (wcg-fail "cast to an aggregate type reached wasm codegen (the checker rejects it)")
               (mk-av 0 0 (TInt 64 true))))))))

; ---- bit-structs --------------------------------------------------------------
; A bit-struct field: its low bit, width and signedness, and the backing width.
(defstruct WBits [(low i64) (width i64) (signed bool) (back i64)])

(defn wbits-info [(g (ptr Wcg)) (pt (ptr Type)) (fname (slice u8))] (-> WBits)
  (let [nm (match (load pt)
             (TStruct [nm] nm)
             (_ (do (wcg-fail "bit access through a non-struct pointer") "")))
        si (wstruct-idx g nm)]
    (when (< si (primitive/cast i64 0))
      (wcg-fail2 "bit access on unknown struct: " nm))
    (let [e (struct-at (field g layouts) si)]
      (match (.layout e)
        (LBits [backing offs]
               (let [fi (wfield-idx g si fname)]
                 (match (.ty (wal-at [Field] (load (field e fields)) fi))
                   (TInt [bits sg] (WBits :low (get (load offs) fi) :width bits :signed sg :back backing))
                   (TBool [] (WBits :low (get (load offs) fi) :width 1 :signed false :back backing))
                   (_ (do (wcg-fail "bit-struct field with non-int type")
                          (WBits :low 0 :width 0 :signed false :back 0))))))
        (_ (do (wcg-fail2 "bit access on non-bits struct: " nm)
               (WBits :low 0 :width 0 :signed false :back 0)))))))

(defn wemit-bitget [(g (ptr Wcg)) (p (ptr Expr)) (fname (slice u8))] (-> WAVal)
  (let [av (wemit-expr g p)
        t (primitive/alloc-stack Type)]
    (set! t (av-ty av))
    (let [pt (box-type (.a g) (wty-pointee t))
          bi (wbits-info g pt fname)
          fty (if (= (.width bi) (primitive/cast i64 1)) (TBool) (TInt (.width bi) (.signed bi)))
          slot (wslot-new! g 8 8)]
      (wg-push-addr! g slot)
      (wg-push-av! g av)
      (wg-load-mem! g (/ (.back bi) 8) false)
      (when (> (.low bi) (primitive/cast i64 0))
        (wg-i64-const! g (.low bi))
        (wg-op! g 136))  ; i64.shr_u
      (wg-canon-int! g (.width bi) (.signed bi))
      (wg-i64-store! g)
      (mk-av 1 slot fty))))

(defn wemit-bitset [(g (ptr Wcg)) (p (ptr Expr)) (fname (slice u8)) (val (ptr Expr))] (-> WAVal)
  (let [pav (wemit-expr g p)
        vav (wemit-expr g val)
        t (primitive/alloc-stack Type)]
    (set! t (av-ty pav))
    (let [pt (box-type (.a g) (wty-pointee t))
          bi (wbits-info g pt fname)
          bytes (/ (.back bi) 8)
          mask (if (>= (.width bi) (primitive/cast i64 64)) -1 (- (primitive/ishl 1 (.width bi)) 1))]
      ; container = (container & ~(mask << low)) | ((value & mask) << low)
      (wg-push-av! g pav)
      (wg-push-av! g pav)
      (wg-load-mem! g bytes false)
      (wg-i64-const! g (primitive/ixor (primitive/ishl mask (.low bi)) -1))
      (wg-op! g 131)  ; i64.and
      (wg-push-av! g vav)
      (wg-i64-const! g mask)
      (wg-op! g 131)
      (when (> (.low bi) (primitive/cast i64 0))
        (wg-i64-const! g (.low bi))
        (wg-op! g 134))  ; i64.shl
      (wg-op! g 132)  ; i64.or
      (wg-store-mem! g bytes)
      vav)))

; ---- trait objects --------------------------------------------------------------
; A dyn value is { data pointer, vtable pointer }; the vtable, in the data
; segment, holds one function pointer (table slot) per method.
(defn wemit-make-dyn [(g (ptr Wcg))
                      (ds (slice u8))
                      (methods (ptr (ArrayList (slice u8))))
                      (inner (ptr Expr))] (-> WAVal)
  (let [n (len (load methods))
        vt (wintern-static! g (* (if (> n 0) n 1) 8) 8)]
    (for [i 0 n]
      (wdata-put! g (+ vt (* i 8)) (wfnptr-slot g (get (load methods) i)) 8))
    (let [iav (wemit-expr g inner)
          slot (wslot-new! g 16 8)]
      (wg-push-addr! g slot)
      (wg-push-av! g iav)
      (wg-i64-store! g)
      (wg-push-addr! g (+ slot 8))
      (wg-data-addr! g vt)
      (wg-i64-store! g)
      (mk-av 1 slot (TStruct ds)))))

; Call method `mi` of a dyn value: its function pointer is vtable[mi]. `params`
; is the method's full parameter list, the receiver (the data pointer) first.
(defn wemit-dyn-dispatch [(g (ptr Wcg))
                          (mi i64)
                          (params (ptr (ArrayList Type)))
                          (ret Type)
                          (recv (ptr Expr))
                          (args (ptr (ArrayList Expr)))] (-> WAVal)
  (let [a (.a g)
        rav (wemit-expr g recv)
        fpslot (wslot-new! g 8 8)
        dataslot (wslot-new! g 8 8)
        (mut avs) (al-new [WAVal] a)
        retp (box-type a ret)]
    ; data pointer
    (wg-push-addr! g dataslot)
    (wg-addr-of-av! g rav)
    (wg-i64-load! g)
    (wg-i64-store! g)
    ; vtable[mi]
    (wg-push-addr! g fpslot)
    (wg-addr-of-av! g rav)
    (wg-i64-const! g 8)
    (wg-op! g 124)
    (wg-i64-load! g)
    (wg-i64-const! g (* mi 8))
    (wg-op! g 124)
    (wg-i64-load! g)
    (wg-i64-store! g)
    (push! (mut avs) (mk-av 1 dataslot (get (load params) 0)))
    (for [i 0 (len (load args))]
      (push! (mut avs) (wemit-expr g (wal-at [Expr] args i))))
    (let [fty (TFn :cc "c" :params params :ret retp)]
      (wemit-invoke-avs g params retp (box-al [WAVal] a (load avs))
                        (WIndirect (mk-av 1 fpslot fty) (wtype-idx! g params retp false))
                        false))))

; ---- inline llvm-ir (slice primitives only: ret / extractvalue / insertvalue) ----
(defn ir-tokens [(a (dyn Allocator)) (line (slice u8))] (-> (ptr (ArrayList (slice u8))))
  (let [(mut toks) (al-new [(slice u8)] a)
        n (len line)
        (mut i) 0
        (mut start) -1]
    (loop (if (>= (load i) n)
              (do
                (when (>= (load start) (primitive/cast i64 0))
                  (push! (mut toks) (subslice line (load start) n)))
                (break))
              (do
                (let [c (primitive/cast i64 (get line (load i)))]
                  (if (or (or (= c (primitive/cast i64 32))
                              (= c (primitive/cast i64 9)))
                          (= c (primitive/cast i64 44)))
                      (do
                        (when (>= (load start) (primitive/cast i64 0))
                          (push! (mut toks)
                                 (subslice line (load start) (load i)))
                          0)
                        (set! start -1)
                        0)
                      (if (or (or (or (= c (primitive/cast i64 123))
                                      (= c (primitive/cast i64 125)))
                                  (or (= c (primitive/cast i64 40))
                                      (= c
                                         (primitive/cast i64
                                                         41))))
                              (or (= c (primitive/cast i64 60))
                                  (= c (primitive/cast i64 62))))
                          (do
                            (when (>= (load start) (primitive/cast i64 0))
                              (push! (mut toks)
                                     (subslice line (load start) (load i)))
                              0)
                            (push! (mut toks)
                                   (subslice line
                                             (load i)
                                             (primitive/iadd (load i) 1)))
                            (set! start -1)
                            0)
                          (do
                            (when (< (load start) (primitive/cast i64 0))
                              (store! start (load i)))
                            0))))
                (set! i (primitive/iadd (load i) 1)))))
    (box-al [(slice u8)] a (load toks))))

(defn ir-str->i64 [(s (slice u8))] (-> i64)
  (let [n (len s)
        neg
          (and (> n (primitive/cast i64 0))
               (= (primitive/cast i64 (get s 0)) (primitive/cast i64 45)))
        (mut i) (when neg 1)
        (mut v) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (let [c (primitive/cast i64 (get s (load i)))]
                  (if (or (< c (primitive/cast i64 48))
                          (> c (primitive/cast i64 57)))
                      (wcg-fail2 "llvm-ir: not an integer token: " s)
                      (set! v
                            (primitive/iadd (primitive/imul (load v) 10)
                                            (primitive/isub c 48)))))
                (set! i (primitive/iadd (load i) 1)))))
    (if neg (primitive/isub 0 (load v)) (load v))))

(defn ir-parse-type [(g (ptr Wcg))
                     (result Type)
                     (argtys (ptr (ArrayList Type)))
                     (toks (ptr (ArrayList (slice u8))))
                     (tokp (ptr i64))] (-> Type)
  (let [a (.a g)
        tk (get (load toks) (load tokp))]
    (set! tokp (primitive/iadd (load tokp) 1))
    (cond (= tk "$ret") result
          (= tk "i64") (TInt 64 true)
          (= tk "i32") (TInt 32 true)
          (= tk "i16") (TInt 16 true)
          (= tk "i8") (TInt 8 true)
          (= tk "i1") (TBool)
          (= tk "ptr") (TPtr (box-type a (TInt 8 true)))
          (= tk "double") (TFloat 64)
          (= tk "float") (TFloat 32)
          (and (>= (len tk) (primitive/cast i64 3))
               (and (= (primitive/cast i64 (get tk 0)) (primitive/cast i64 36))
                    (= (primitive/cast i64 (get tk 1)) (primitive/cast i64 116))))
            (get (load argtys) (ir-str->i64 (subslice tk 2 (len tk))))
          :else
            (do
              (wcg-fail2 "llvm-ir: unsupported type token: " tk)
              (TInt 64 true)))))

(defn ir-agg-elem [(g (ptr Wcg)) (t (ptr Type)) (idx i64) (offp (ptr i64))] (-> Type)
  (match (load t)
    (TSlice [elem]
            (if (= idx (primitive/cast i64 0))
                (do (set! offp 0) (TPtr elem))
                (do
                  (set! offp 8)
                  (TInt 64 true))))
    (TStruct [nm]
             (let [si (wstruct-idx g nm)]
               (when (< si (primitive/cast i64 0))
                 (wcg-fail2 "llvm-ir: extract from unknown struct " nm))
               (set! offp (wfield-off g si idx))
               (.ty (wal-at [Field]
                            (load (field (struct-at (field g
                                                           layouts)
                                                    si)
                                         fields))
                            idx))))
    (_ (do
         (wcg-fail "llvm-ir: extract/insert on unsupported aggregate")
         (TInt 64 true)))))

(defn ir-value [(g (ptr Wcg))
                (env (ptr WScope))
                (avs (ptr (ArrayList WAVal)))
                (tk (slice u8))
                (t Type)] (-> WAVal)
  (let [tp (primitive/alloc-stack Type)]
    (set! tp t)
    (cond (= (primitive/cast i64 (get tk 0)) (primitive/cast i64 37))  ; %name
            (match (wscope-get env tk)
              (Some [av] av)
              (None []
                    (do
                      (wcg-fail2 "llvm-ir: undefined value " tk)
                      (mk-av 0 0 (TInt 64 true)))))
          (= (primitive/cast i64 (get tk 0)) (primitive/cast i64 36))  ; $N
            (get (load avs) (ir-str->i64 (subslice tk 1 (len tk))))
          (= tk "undef") (mk-av 1 (wslot-for-ty! g tp) t)
          (= tk "zeroinitializer")
            (let [slot (wslot-for-ty! g tp)]
              ; zero the slot bytes
              (wg-push-addr! g slot)
              (wg-i32-const! g 0) ; memory.fill's byte operand is i32 even in memory64
              (wg-i64-const! g (wty-size g tp))
              (wg-op! g 252)
              (wg-op! g 11)
              (wg-op! g 0)
              (mk-av 1 slot t))
          :else (mk-av 0 (ir-str->i64 tk) t))))

(defn wemit-llvmir [(g (ptr Wcg))
                    (result Type)
                    (args (ptr (ArrayList Expr)))
                    (body (slice u8))] (-> WAVal)
  (cond (= body "coil.mem.alloc-stack-bytes")
          (wemit-stack-bytes g result (wemit-expr g (wal-at [Expr] args 0)))
        ; the address of a named static: this module is fully linked, so the
        ; symbol must be one it defines
        (starts-with body "coil.arch.linker-address:")
          (let [name (subslice body 25 (len body))
                off (wnamed-static-find g name)
                slot (wslot-new! g 8 8)]
            (when (< off (primitive/cast i64 0))
              (wcg-user-fail (sconcat (.a g) "linker-address names a symbol this wasm module does not define: " name)))
            (wg-push-addr! g slot)
            (wg-data-addr! g off)
            (wg-i64-store! g)
            (mk-av 1 slot result))
        :else
  (let [a (.a g)
        (mut avs) (al-new [WAVal] a)
        (mut argtys) (al-new [Type] a)
        n (len (load args))
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (let [av (wemit-expr g (wal-at [Expr] args (load i)))]
                  (push! (mut avs) av)
                  (push! (mut argtys) (av-ty av)))
                (set! i (primitive/iadd (load i) 1)))))
    (let [avsp (box-al [WAVal] a (load avs))
          argtysp (box-al [Type] a (load argtys))
          envp (primitive/alloc-stack (ptr WScope))
          retp (primitive/alloc-stack WAVal)
          donep (primitive/alloc-stack bool)
          blen (len body)
          (mut pos) 0]
      (set! envp (wscope-nil a))
      (set! retp (mk-av 0 0 (TInt 64 true)))
      (set! donep false)
      (loop (if (>= (load pos) blen)
                (break)
                (do
                  (let [(mut eol) (load pos)]
                    (loop (if (or (>= (load eol) blen)
                                  (= (primitive/cast i64 (get body (load eol)))
                                     (primitive/cast i64 10)))
                              (break)
                              (set! eol (primitive/iadd (load eol) 1))))
                    (let [line (subslice body (load pos) (load eol))]
                      (set! pos (primitive/iadd (load eol) 1))
                      (unless (= (len line) (primitive/cast i64 0))
                        (if (load donep)
                            (wcg-fail2 "llvm-ir: code after ret: " line)
                            (wemit-ir-line! g
                                            envp
                                            avsp
                                            argtysp
                                            result
                                            retp
                                            donep
                                            line)))))
                  0)))
      (unless (load donep) (wcg-fail "llvm-ir: body did not ret"))
      (load retp)))))

; alloc-stack-bytes: move $sp down by the byte count rounded up to 16 and hand
; out the block there. Slots are addressed from the frame base, not $sp, and the
; epilogue resets $sp from the frame base, so the block lives until the function
; returns.
(defn wemit-stack-bytes [(g (ptr Wcg)) (result Type) (nav WAVal)] (-> WAVal)
  (let [slot (wslot-new! g 8 8)]
    (we-global-get! (mut (.code g)) (.sp-global g))
    (wg-push-av! g nav)
    (wg-i64-const! g 15)
    (wg-op! g 124)
    (wg-i64-const! g -16)
    (wg-op! g 131)
    (wg-op! g 125)  ; i64.sub
    (we-global-set! (mut (.code g)) (.sp-global g))
    (wg-push-addr! g slot)
    (we-global-get! (mut (.code g)) (.sp-global g))
    (wg-i64-store! g)
    (mk-av 1 slot result)))

; `%r = call T @llvm.<op>.fN(T $a, …)` for the scalar float intrinsics coil.math
; is written over (float_math.coil): one wasm instruction where wasm has it,
; otherwise the libm function.
(defn wemit-ir-float-math! [(g (ptr Wcg))
                            (envp (ptr (ptr WScope)))
                            (avsp (ptr (ArrayList WAVal)))
                            (argtysp (ptr (ArrayList Type)))
                            (result Type)
                            (toks (ptr (ArrayList (slice u8))))
                            (tokp (ptr i64))
                            (t0 (slice u8))
                            (rty Type)
                            (fi FloatIntrinsic)] (-> i64)
  (let [a (.a g)
        bytes (/ (.bits fi) 8)
        f32 (= bytes (primitive/cast i64 4))
        (mut ops) (al-new [WAVal] a)]
    (set! tokp (+ (load tokp) 2))  ; skip callee, "("
    (for [i 0 (.arity fi)]
      (let [at (ir-parse-type g result argtysp toks tokp)
            vtk (get (load toks) (load tokp))]
        (set! tokp (+ (load tokp) 1))
        (push! (mut ops) (ir-value g (load envp) avsp vtk at))))
    (let [native
            (match (.op fi)
              (FloatSqrt [] (if f32 145 159))
              (FloatAbs [] (if f32 139 153))
              (FloatCeil [] (if f32 141 155))
              (FloatFloor [] (if f32 142 156))
              (FloatTrunc [] (if f32 143 157))
              (FloatRoundEven [] (if f32 144 158))  ; nearest: ties to even
              ; wasm min/max propagate NaN and order -0 < +0, as llvm.minimum/maximum
              (FloatMinimum [] (if f32 150 164))
              (FloatMaximum [] (if f32 151 165))
              (FloatCopysign [] (if f32 152 166))
              (_ -1))
          av (if (< native (primitive/cast i64 0))
                 (wemit-libm-call g (.libm fi) (.bits fi) (box-al [WAVal] a (load ops)))
                 (let [slot (wslot-new! g 8 8)]
                   (wg-push-addr! g slot)
                   (for [i 0 (len ops)]
                     (wg-push-float! g (get ops i) bytes))
                   (wg-op! g native)
                   (wg-float-bits! g bytes)
                   (wg-i64-store! g)
                   (mk-av 1 slot rty)))]
      (store! envp (wscope-put a (load envp) t0 (mk-av (av-kind av) (av-v av) rty)))
      0)))

(defn wemit-ir-line! [(g (ptr Wcg))
                      (envp (ptr (ptr WScope)))
                      (avsp (ptr (ArrayList WAVal)))
                      (argtysp (ptr (ArrayList Type)))
                      (result Type)
                      (retp (ptr WAVal))
                      (donep (ptr bool))
                      (line (slice u8))] (-> i64)
  (let [a (.a g)
        toks (ir-tokens a line)
        ntk (len (load toks))]
    (unless (= ntk (primitive/cast i64 0))
      (let [t0 (get (load toks) 0)]
        (cond (= t0 "declare") 0
              (= t0 "ret")
                (let [tokp (primitive/alloc-stack i64)]
                  (store! tokp 1)
                  (let [rt (ir-parse-type g result argtysp toks tokp)
                        av
                          (ir-value g
                                    (load envp)
                                    avsp
                                    (get (load toks) (load tokp))
                                    rt)]
                    (store! retp (mk-av (av-kind av) (av-v av) result))
                    (store! donep true)
                    0))
              (and (>= ntk (primitive/cast i64 3))
                   (= (primitive/cast i64 (get t0 0)) (primitive/cast i64 37)))
                (let [op (get (load toks) 2)]
                  (if (= op "extractvalue")
                      (let [tokp (primitive/alloc-stack i64)]
                        (store! tokp 3)
                        (let [aggty (ir-parse-type g result argtysp toks tokp)
                              vtk (get (load toks) (load tokp))
                              idx
                                (ir-str->i64 (get (load toks)
                                                  (primitive/iadd (load tokp) 1)))
                              av (ir-value g (load envp) avsp vtk aggty)
                              atp (primitive/alloc-stack Type)]
                          (store! atp aggty)
                          (let [offp (primitive/alloc-stack i64)
                                ety (ir-agg-elem g atp idx offp)
                                etp (primitive/alloc-stack Type)]
                            (store! etp ety)
                            (let [eslot (wslot-for-ty! g etp)]
                              (wg-copy-field-from! g
                                                   eslot
                                                   (primitive/iadd (av-v av)
                                                                   (load offp))
                                                   etp)
                              (store! envp
                                      (wscope-put a
                                                  (load envp)
                                                  t0
                                                  (mk-av 1 eslot ety)))
                              0))))
                      (if (= op "insertvalue")
                          (let [tokp (primitive/alloc-stack i64)]
                            (store! tokp 3)
                            (let [aggty
                                    (ir-parse-type g result argtysp toks tokp)
                                  aggtk (get (load toks) (load tokp))]
                              (store! tokp (primitive/iadd (load tokp) 1))
                              (let [aggav
                                      (ir-value g (load envp) avsp aggtk aggty)
                                    elty
                                      (ir-parse-type g result argtysp toks tokp)
                                    eltk (get (load toks) (load tokp))
                                    idx
                                      (ir-str->i64 (get (load toks)
                                                        (primitive/iadd (load tokp)
                                                                        1)))
                                    eav (ir-value g (load envp) avsp eltk elty)
                                    atp (primitive/alloc-stack Type)]
                                (store! atp aggty)
                                (let [dslot (wslot-for-ty! g atp)
                                      offp (primitive/alloc-stack i64)]
                                  ; copy the whole aggregate in, then overwrite the element
                                  (wg-push-addr! g dslot)
                                  (wg-addr-of-av! g aggav)
                                  (wg-i64-const! g (wty-size g atp))
                                  (wg-memcopy! g)
                                  (ir-agg-elem g atp idx offp)
                                  (wg-store-av-at-off! g
                                                       eav
                                                       (primitive/iadd dslot
                                                                       (load offp)))
                                  (store! envp
                                          (wscope-put a
                                                      (load envp)
                                                      t0
                                                      (mk-av 1 dslot aggty)))
                                  0))))
                          (if (= op "call")
                              (let [tokp (primitive/alloc-stack i64)]
                                (store! tokp 3)
                                (let [rty (ir-parse-type g result argtysp toks tokp)
                                      callee (get (load toks) (load tokp))]
                                  (match (float-intrinsic callee)
                                    (Some [fi] (wemit-ir-float-math! g envp avsp argtysp result toks tokp t0 rty fi))
                                    (None [] (wcg-fail2 "llvm-ir: unsupported call: " callee)))))
                              (wcg-fail2 "llvm-ir: unsupported op (only extractvalue/insertvalue/call/ret): "
                                         op)))))
              :else (wcg-fail2 "llvm-ir: unsupported line: " line))))))

(defn wemit-expr [(g (ptr Wcg)) (e (ptr Expr))] (-> WAVal)
  (match (.kind e)
    (EAnonFn [_ _]
             (do
               (wcg-fail "EAnonFn reached wasm codegen (the checker lowers it to a function)")
               (mk-av 0 0 (TInt 64 true))))
    (EInt [v] (mk-av 0 v (TInt 64 true)))
    (EBool [b] (mk-av 0 (when b 1) (TBool)))
    (EVar [name]
          (match (wscope-get (load (field g env)) name)
            (Some [av] av)
            (None []
                  (do
                    (wcg-fail2 "unbound variable: " name)
                    (mk-av 0 0 (TInt 64 true))))))
    (EBin [op lhs rhs] (wemit-bin g op lhs rhs))
    (ECmp [op lhs rhs] (wemit-cmp g op lhs rhs))
    (EIntUnary [op inner]
               (let [av (wemit-expr g inner)
                     t (primitive/alloc-stack Type)
                     slot (wslot-new! g 8 8)]
                 (set! t (av-ty av))
                 (let [bits (match (load t) (TInt [n _] n) (_ 64))
                       signed (match (load t) (TInt [_ sg] sg) (_ false))]
                   (wg-push-addr! g slot)
                   (cond (= op (primitive/cast i64 0))
                           (do
                             (wg-i64-const! g -1)
                             (wg-push-av! g av)
                             (wg-op! g 133)
                             0)
                         (= op (primitive/cast i64 1))
                           (do
                             (wg-push-av! g av)
                             (wg-canon-int! g bits false)
                             (wg-op! g 121)
                             (when (< bits (primitive/cast i64 64))
                               (wg-i64-const! g (primitive/isub 64 bits))
                               (wg-op! g 125)))
                         (= op (primitive/cast i64 2))
                           (do
                             (wg-push-av! g av)
                             (wg-canon-int! g bits false)
                             (when (< bits (primitive/cast i64 64))
                               (wg-i64-const! g (primitive/ishl 1 bits))
                               (wg-op! g 132))
                             (wg-op! g 122))
                         (= op (primitive/cast i64 3))
                           (do
                             (wg-push-av! g av)
                             (wg-canon-int! g bits false)
                             (wg-op! g 123))
                         :else
                           (let [(mut i) 0
                                 bytes (primitive/idiv bits 8)]
                             (wg-i64-const! g 0)
                             (loop (if (>= (load i) bytes)
                                       (break)
                                       (do
                                         (wg-push-av! g av)
                                         (when (> (load i)
                                                  (primitive/cast i64 0))
                                           (wg-i64-const! g
                                                          (primitive/imul (load i)
                                                                          8))
                                           (wg-op! g 136))
                                         (wg-i64-const! g 255)
                                         (wg-op! g 131)
                                         (let [dst
                                                 (primitive/imul (primitive/isub (primitive/isub bytes
                                                                                                 1)
                                                                                 (load i))
                                                                 8)]
                                           (when (> dst (primitive/cast i64 0))
                                             (wg-i64-const! g dst)
                                             (wg-op! g 134)))
                                         (wg-op! g 132)
                                         (set! i (primitive/iadd (load i) 1)))))))
                   (wg-canon-int! g bits signed)
                   (wg-i64-store! g)
                   (mk-av 1 slot (av-ty av)))))
    (EIf [cnd thn els] (wemit-if g cnd thn els))
    (EDo [body] (wemit-body g body))
    (ECleanup [body cleanups]
              (let [result (wemit-expr g body)]
                (wemit-body g cleanups)
                result))
    (ELet [binds body]
          (let [saved (load (field g env))]
            (wemit-binds g binds)
            (let [r (wemit-body g body)] (set! (.env g) saved) r)))
    (ELoop [label body] (wemit-loop g label body))
    (EBreak [label value] (wemit-break g label value))
    (EContinue [label]
               (do
                 (let [li (wg-loop-index g label)]
                   (wg-br! g
                           (primitive/isub (.depth g)
                                           (.contlevel (wal-at [WLoop]
                                                               (field g
                                                                      loops)
                                                               li))))
                   (set! (.terminated g) true))
                 (mk-av 0 0 (TInt 64 true))))
    (ECall [func _targs args] (wemit-call g func args))
    (ENamedCall [_func _targs _names _args]
                (do
                  (wcg-fail "named constructor call survived type checking")
                  (mk-av 0 0 (TInt 64 true))))
    (ECallPtr [fp args] (wemit-callptr g fp args))
    (EFnPtrOf [name] (mk-av 0 (wfnptr-slot g name) (wfnptr-type g name)))
    (EAlloc [storage t init symbol]
            (let [a (.a g)
                  tp (primitive/alloc-stack Type)]
              (set! tp t)
              (when (and (!= storage (primitive/cast i64 1))
                         (or (!= (primitive/cast i64 init) 0)
                             (match symbol (Some [_] true) (None [] false))))
                (wcg-fail "an initializer or a symbol on non-static storage reached wasm codegen (checker bug)"))
              (if (or (= storage (primitive/cast i64 0))
                      (= storage (primitive/cast i64 3)))
                  (let [vslot (wslot-for-ty! g tp)
                        pslot (wslot-new! g 8 8)]
                    (wg-push-addr! g pslot)
                    (wg-push-addr! g vslot)
                    (wg-i64-store! g)
                    (mk-av 1 pslot (TPtr (box-type a t))))
                  (if (= storage (primitive/cast i64 2))
                      ; heap: call the malloc import (funcidx from the pre-scan)
                      (let [ii (wlibc-import! g "malloc" (wmalloc-params a) (TPtr (box-type a (TInt 8 false))))
                            slot (wslot-new! g 8 8)]
                        (wg-push-addr! g slot)
                        (wg-i64-const! g (wty-size g tp))
                        (wg-call! g
                                  (.funcidx (wal-at [WImport]
                                                    (field g imports)
                                                    ii)))
                        (wg-i64-store! g)
                        (mk-av 1 slot (TPtr (box-type a t))))
                      ; static: one cell in the data segment per call site (or per `:as`
                      ; symbol), holding its initializer; its address is a constant, so
                      ; every execution yields the same cell.
                      (let [off (wstatic-cell! g tp init symbol)
                            slot (wslot-new! g 8 8)]
                        (wg-push-addr! g slot)
                        (wg-data-addr! g off)
                        (wg-i64-store! g)
                        (mk-av 1 slot (TPtr (box-type a t))))))))
    (EAccessorField [p fname]
                    (wemit-expr g
                                (box-expr (.a g)
                                          (mk-expr (EField p fname)
                                                   (.lo e)
                                                   (.hi e)
                                                   (.source e)
                                                   (.ctxt e)))))
    (EField [p fname]
            (let [av (wemit-expr g p)
                  a (.a g)
                  t (primitive/alloc-stack Type)]
              (set! t (av-ty av))
              (let [pt (primitive/alloc-stack Type)]
                (set! pt (wty-pointee t))
                (match (load pt)
                  (TStruct [nm]
                           (let [si (wstruct-idx g nm)]
                             (when (< si (primitive/cast i64 0))
                               (wcg-fail2 "field access on non-struct: " nm))
                             (let [fi (wfield-idx g si fname)
                                   off (wfield-off g si fi)
                                   fty
                                     (.ty (wal-at [Field]
                                                  (load (field (struct-at (field g
                                                                                 layouts)
                                                                          si)
                                                               fields))
                                                  fi))
                                   slot (wslot-new! g 8 8)]
                               (wg-push-addr! g slot)
                               (wg-push-av! g av)
                               (when (> off (primitive/cast i64 0))
                                 (wg-i64-const! g off)
                                 (wg-op! g 124)
                                 0)
                               (wg-i64-store! g)
                               (mk-av 1 slot (TPtr (box-type a fty))))))
                  (_ (do
                       (wcg-fail "field access through a non-struct pointer")
                       (mk-av 0 0 (TInt 64 true))))))))
    (ELoad [inner]
           (let [av (wemit-expr g inner)
                 t (primitive/alloc-stack Type)]
             (set! t (av-ty av))
             (let [pt (primitive/alloc-stack Type)]
               (set! pt (wty-pointee t))
               (if (wty-scalar? pt)
                   (let [slot (wslot-new! g 8 8)]
                     (wg-push-addr! g slot)
                     (wg-push-av! g av)
                     (wg-load-mem! g (wty-size g pt) (wty-signed? pt))
                     (wg-i64-store! g)
                     (mk-av 1 slot (load pt)))
                   (let [slot (wslot-for-ty! g pt)]
                     (wg-push-addr! g slot)
                     (wg-push-av! g av)
                     (wg-i64-const! g (wty-size g pt))
                     (wg-memcopy! g)
                     (mk-av 1 slot (load pt)))))))
    (EStore [p val]
            (let [pav (wemit-expr g p)
                  vav (wemit-expr g val)
                  t (primitive/alloc-stack Type)]
              (set! t (av-ty vav))
              (if (wty-scalar? t)
                  (do
                    (wg-push-av! g pav)
                    (wg-push-av! g vav)
                    (wg-store-mem! g (wty-size g t))
                    0)
                  (do
                    (wg-push-av! g pav)
                    (wg-addr-of-av! g vav)
                    (wg-i64-const! g (wty-size g t))
                    (wg-memcopy! g)
                    0))
              (mk-av 0 0 (TInt 64 true))))
    (EInitStore [p val]
                (let [pav (wemit-expr g p)
                      vav (wemit-expr g val)
                      t (primitive/alloc-stack Type)]
                  (set! t (av-ty vav))
                  (if (wty-scalar? t)
                      (do
                        (wg-push-av! g pav)
                        (wg-push-av! g vav)
                        (wg-store-mem! g (wty-size g t))
                        0)
                      (do
                        (wg-push-av! g pav)
                        (wg-addr-of-av! g vav)
                        (wg-i64-const! g (wty-size g t))
                        (wg-memcopy! g)
                        0))
                  (mk-av 0 0 (TInt 64 true))))
    (EIndex [p idx]
            (let [pav (wemit-expr g p)
                  iav (wemit-expr g idx)
                  a (.a g)
                  t (primitive/alloc-stack Type)]
              (set! t (av-ty pav))
              (let [pt (primitive/alloc-stack Type)
                    ep (primitive/alloc-stack Type)]
                (set! pt (wty-pointee t))
                (match (load pt)
                  (TArray [elem _n] (set! ep (load elem)))
                  (_ (set! ep (load pt))))
                (let [esz (wty-size g ep)
                      slot (wslot-new! g 8 8)]
                  (wg-push-addr! g slot)
                  (wg-push-av! g pav)
                  (wg-push-av! g iav)
                  (wg-i64-const! g esz)
                  (wg-op! g 126)
                  (wg-op! g 124)  ; idx*esz ; +
                  (wg-i64-store! g)
                  (mk-av 1 slot (TPtr (box-type a (load ep))))))))
    (ECast [t inner] (wemit-cast g t inner))
    (EBorrow [_m place] (wemit-expr g place))
    (ESpillRef [inner]
               (let [av (wemit-expr g inner)
                     a (.a g)
                     pslot (wslot-new! g 8 8)]
                 (wg-push-addr! g pslot)
                 (wg-addr-of-av! g av)
                 (wg-i64-store! g)
                 (mk-av 1 pslot (TPtr (box-type a (av-ty av))))))
    (EMovePlace [_]
                (do
                  (wcg-fail "EMovePlace survived monomorphization (compiler bug)")
                  (mk-av 0 0 (TInt 64 true))))
    (EStr [sv]
          (let [off (wintern-str! g sv true)
                a (.a g)
                slot (wslot-new! g 16 8)]
            ; slice value {ptr@0, len@8}; ptr = data address (PIC-aware)
            (wg-push-addr! g slot)
            (wg-data-addr! g off)
            (wg-i64-store! g)
            (wg-push-addr! g (primitive/iadd slot 8))
            (wg-i64-const! g (len sv))
            (wg-i64-store! g)
            (mk-av 1 slot (TSlice (box-type a (TInt 8 false))))))
    (EConstruct [sum variant args] (wemit-construct g sum variant args))
    (EMatch [scrut arms] (wemit-match g scrut arms))
    (ELlvmIr [result args body] (wemit-llvmir g result args body))
    (EVector [op result types args]
      (let [a (.a g) saved (.env g) (mut values) (al-new [WAVal] a)]
        (for [i 0 (len (load args))]
          (push! (mut values) (wemit-expr g (wal-at [Expr] args i))))
        (for [i 0 (len (load args))]
          (set! (.env g) (wscope-put a (.env g) (vs-argument-name a i) (get (load values) i))))
        (let [lowered (match (scalarize-vector a op (box-type a result) types)
                        (Ok [expr] expr)
                        (Err [d] (let [diag d] (wcg-fail (.msg diag)) (mk-expr (EInt 0) -1 -1 -1 0))))
              value (wemit-expr g (box-expr a lowered))]
          (set! (.env g) saved)
          value)))
    (ESizeOf [t]
             (let [tp (primitive/alloc-stack Type)]
               (set! tp t)
               (mk-av 0 (wty-size g tp) (TInt 64 true))))
    (EAlignOf [t]
              (let [tp (primitive/alloc-stack Type)]
                (set! tp t)
                (mk-av 0 (wty-align g tp) (TInt 64 true))))
    (EOffsetOf [t fname]
               (match t
                 (TStruct [nm]
                          (let [si (wstruct-idx g nm)]
                            (when (< si (primitive/cast i64 0))
                              (wcg-fail2 "offset-of on non-struct: " nm))
                            (mk-av 0
                                   (wfield-off g si (wfield-idx g si fname))
                                   (TInt 64 true))))
                 (_ (do
                      (wcg-fail "offset-of on non-struct type")
                      (mk-av 0 0 (TInt 64 true))))))
    (EZeroed [t]
             (let [tp (primitive/alloc-stack Type)]
               (set! tp t)
               (let [slot (wslot-for-ty! g tp)]
                 (wg-push-addr! g slot)
                 (wg-i32-const! g 0) ; only the address and length are memory64 operands
                 (wg-i64-const! g (wty-size g tp))
                 (wg-op! g 252)
                 (wg-op! g 11)
                 (wg-op! g 0)
                 (mk-av 1 slot t))))
    (ERecordInit [t]
             (let [tp (primitive/alloc-stack Type)]
               (set! tp t)
               (let [slot (wslot-for-ty! g tp)]
                 (wg-push-addr! g slot)
                 (wg-i32-const! g 0) ; only the address and length are memory64 operands
                 (wg-i64-const! g (wty-size g tp))
                 (wg-op! g 252)
                 (wg-op! g 11)
                 (wg-op! g 0)
                 (mk-av 1 slot t))))
    (EFree [inner]
           ; lower to a call of the env.free import (the pointer arg passed by value)
           (let [ii (wlibc-import! g "free" (wfree-params (.a g)) (TVoid))
                 imp (wal-at [WImport] (field g imports) ii)
                 (mut avs) (al-new [WAVal] (.a g))
                 retp (primitive/alloc-stack Type)]
             (push! (mut avs) (wemit-expr g inner))
             (set! retp (.ret imp))
             (wemit-invoke-avs g (load (field imp params)) retp (box-al [WAVal] (.a g) (load avs))
                               (WImported (.funcidx imp)) false)))
    (EComptime [_i]
               (do
                 (wcg-fail "EComptime reached wasm codegen")
                 (mk-av 0 0 (TInt 64 true))))
    (ECStr [sv]
           (let [off (wintern-str! g sv true)
                 slot (wslot-new! g 8 8)]
             (wg-push-addr! g slot)
             (wg-data-addr! g off)
             (wg-i64-store! g)
             (mk-av 1 slot (TPtr (box-type (.a g) (TInt 8 true))))))
    ; the checker keeps every float literal as f64 bits; a cast narrows it
    (EFloat [bits] (mk-av 0 bits (TFloat 64)))
    (EBitGet [p fname] (wemit-bitget g p fname))
    (EBitSet [p fname val] (wemit-bitset g p fname val))
    (EMakeDyn [ds _vt methods inner] (wemit-make-dyn g ds methods inner))
    (EDynDispatch [_ds _vt mi _cc params ret recv args]
                  (wemit-dyn-dispatch g mi params ret recv args))
    (EStaticRef [name]
                (let [(mut found) -1]
                  (for [i 0 (len (.defs g))]
                    (when (= (.name (get (.defs g) i)) name) (set! found i)))
                  (when (< found 0)
                    (wcg-fail2 "static-ref references an unknown def: " name))
                  (let [d (get (.defs g) found)
                        slot (wslot-new! g 8 8)]
                    (wg-push-addr! g slot)
                    (wg-data-addr! g (.off d))
                    (wg-i64-store! g)
                    (mk-av 1 slot (TPtr (box-type (.a g) (.ty d)))))))
    (EErase [_t _i]
            (do
              (wcg-fail "EErase reached wasm codegen (checker bug)")
              (mk-av 0 0 (TInt 64 true))))
    (ETraitCall [_a _b _c _d]
                (do
                  (wcg-fail "ETraitCall reached wasm codegen (mono bug)")
                  (mk-av 0 0 (TInt 64 true))))
    (EAscribe [_t _i]
              (do
                (wcg-fail "EAscribe reached wasm codegen (checker bug)")
                (mk-av 0 0 (TInt 64 true))))
    (EPattern [pattern-op _t _i pattern-index]
              (do
                (wcg-fail "EPattern reached wasm codegen (checker bug)")
                (mk-av 0 0 (TInt 64 true))))
    (EArrayLit [_]
               (do
                 (wcg-fail "EArrayLit reached wasm codegen (checker bug)")
                 (mk-av 0 0 (TInt 64 true))))
    (EStaticArray [_ _]
                  (do
                    (wcg-fail "static :elements escaped its allocation initializer")
                    (mk-av 0 0 (TInt 64 true))))
    (EMakeSlice [data elem len]
                (let [dv (wemit-expr g data)
                      a (.a g)
                      slot (wslot-new! g 16 8)]
                  (wg-push-addr! g slot)
                  (wg-push-av! g dv)
                  (wg-i64-store! g)
                  (wg-push-addr! g (primitive/iadd slot 8))
                  (wg-i64-const! g (extent-value len))
                  (wg-i64-store! g)
                  (mk-av 1 slot (TSlice (box-type a elem)))))
    (ETypeQuery [_q _t]
                (do
                  (wcg-fail "ETypeQuery reached wasm codegen")
                  (mk-av 0 0 (TInt 64 true))))
    (EConstParam [_ _]
                 (do
                   (wcg-fail "unspecialized value parameter reached wasm codegen (compiler bug)")
                   (mk-av 0 0 (TInt 64 true))))
    (EFieldMeta [_m _t _i]
                (do
                  (wcg-fail "EFieldMeta reached wasm codegen")
                  (mk-av 0 0 (TInt 64 true))))
    (EFieldIndex [_t _n]
                 (do
                   (wcg-fail "EFieldIndex reached wasm codegen")
                   (mk-av 0 0 (TInt 64 true))))
    (EQuote [_f]
            (do
              (wcg-fail "EQuote reached wasm codegen")
              (mk-av 0 0 (TInt 64 true))))
    (ECodeOp [_o _a]
             (do
               (wcg-fail "ECodeOp reached wasm codegen")
               (mk-av 0 0 (TInt 64 true))))
    (EQuasi [_q]
            (do
              (wcg-fail "EQuasi reached wasm codegen")
              (mk-av 0 0 (TInt 64 true))))))

; ============================ function emission =============================
(defn wemit-func! [(g (ptr Wcg)) (fd (ptr Func)) (entry i64)] (-> (ArrayList u8))
  (set! (.frame g) 0)
  (set! (.curfix g) (al-new [i64] (.a g)))
  (set! (.env g) (wscope-nil (.a g)))
  (set! (.len (.loops g)) 0)
  (set! (.depth g) 0)
  (set! (.terminated g) false)
  (set! (.retty g) (.ret fd))
  (set! (.code g) (al-new [u8] (.a g)))
  (let [a (.a g)
        ps (load (field fd params))
        np (len (load ps))
        retp (primitive/alloc-stack Type)]
    (set! retp (.ret fd))
    (let [retvoid (match (.ret fd) (TVoid [] true) (_ false))
          aggret (wty-aggret? g retp)
          sretoff (when aggret 1)]
      (set! (.aggret g) aggret)
      ; the frame base lives in the first local after the parameters (an empty
      ; struct parameter has no local)
      (let [(mut nlocals) sretoff]
        (for [k 0 np]
          (match (wabi-class g (field (wal-at [Param] ps k) ty))
            (WAbiEmpty [] 0)
            (_ (set! nlocals (+ nlocals 1)))))
        (set! (.fp-local g) nlocals))
      ; parameter intake: each parameter's local → a slot bound to its name.
      (let [(mut i) 0
            (mut local) sretoff]
        (loop (if (>= (load i) np)
                  (break)
                  (do
                    (let [prm (wal-at [Param] ps (load i))
                          t (field prm ty)
                          slot (wslot-for-ty! g t)]
                      (match (wabi-class g t)
                        ; a scalar, or a single-element struct's element (stored at
                        ; offset 0 of the struct's slot): the C value → canonical
                        (WAbiScalar [st]
                                    (let [stp (box-type a st)]
                                      (wg-push-addr! g slot)
                                      (we-local-get! (mut (.code g)) local)
                                      (wg-c->canon! g stp)
                                      (if (wty-scalar? t) (wg-i64-store! g) (wg-store-mem! g (wty-size g stp)))
                                      (set! local (+ local 1))))
                        ; an empty struct: nothing was passed
                        (WAbiEmpty [] 0)
                        ; any other aggregate: the local is a pointer; copy the
                        ; pointee into a private slot
                        (WAbiIndirect []
                                      (do
                                        (wg-push-addr! g slot)
                                        (we-local-get! (mut (.code g)) local)
                                        (wg-i64-const! g (wty-size g t))
                                        (wg-memcopy! g)
                                        (set! local (+ local 1)))))
                      (set! (.env g)
                            (wscope-put a
                                        (load (field g env))
                                        (.name prm)
                                        (mk-av 1 slot (load t)))))
                    (set! i (primitive/iadd (load i) 1)))))
        ; body
        (let [bav (wemit-body g (load (field fd body)))
              framesize
                (primitive/imul (primitive/idiv (primitive/iadd (.frame g) 15)
                                                16)
                                16)]
          (if (.terminated g)
              (wg-op! g 0)  ; unreachable
              (do
                (match (wabi-class g retp)
                  ; a scalar result on the stack — for a single-element struct, its element
                  (WAbiScalar [st]
                              (let [stp (box-type a st)]
                                (if (wty-scalar? retp) (wg-push-av! g bav) (wg-push-single! g bav st))
                                (wg-canon->c! g stp)))
                  ; an empty struct or void: nothing
                  (WAbiEmpty [] 0)
                  ; copy the aggregate result through the sret pointer (local 0)
                  (WAbiIndirect []
                                (do
                                  (we-local-get! (mut (field g code)) 0)
                                  (wg-addr-of-av! g bav)
                                  (wg-i64-const! g (wty-size g retp))
                                  (wg-memcopy! g)
                                  0)))
                ; epilogue: $sp = frame base + framesize, which also releases every
                ; alloc-stack-bytes block (net stack-neutral; a scalar result stays on top)
                (we-local-get! (mut (.code g)) (.fp-local g))
                (we-i64-const! (mut (.code g)) framesize)
                (wg-op! g 124)
                (we-global-set! (mut (.code g)) (.sp-global g))))
          (wg-op! g 11)
          ; assemble: locals (one i64: the frame base) + prologue + body
          (let [(mut pro) (al-new [u8] a)
                spg (.sp-global g)]
            (wb! (mut pro) 1)
            (wb! (mut pro) 1)
            (wb! (mut pro) 126)
            ; $sp -= framesize; the frame base is the new $sp
            (we-global-get! (mut pro) spg)
            (we-i64-const! (mut pro) framesize)
            (wb! (mut pro) 125)
            (wb! (mut pro) 34)  ; local.tee
            (wuleb! (mut pro) (.fp-local g))
            (we-global-set! (mut pro) spg)
            (let [base (len pro)]
              (for [k 0 (/ (len (.curfix g)) 2)]
                (push! (mut (.fixes g))
                       (WFix :entry entry
                             :off (+ base (get (.curfix g) (* k 2)))
                             :ordinal (get (.curfix g) (+ (* k 2) 1))))))
            (wbytes! (mut pro) (al-slice [u8] (.code g)))
            (load pro)))))))

; ============================ module assembly ===============================
; import section (id 2) payload. Function imports are `(import "env" "<field>"
; (func typeidx))`. In SIDE-MODULE mode, three extra imports precede them so the
; module shares the running compiler's linear memory + PIC bases:
;   (import "env" "memory" (memory i64 …))
;   (import "env" "__memory_base"   (global i64))          ; immutable data base
;   (import "env" "__stack_pointer" (global (mut i64)))    ; the shadow-stack pointer $sp
(defn wemit-name! [(b (mut (ArrayList u8))) (s (slice u8))] (-> i64)
  (wuleb! (mut b) (len s))
  (wbytes! (mut b) s)
  0)

(defn wbuild-import-section [(g (ptr Wcg)) (a (dyn Allocator))] (-> (slice u8))
  (let [side (.side-module g)
        nfun (len (.imports g))
        (mut b) (al-new [u8] a)]
    (wuleb! (mut b) (primitive/iadd nfun (when side 3)))
    (when side
      (wemit-name! (mut b) "env")
      (wemit-name! (mut b) "memory")
      (wb! (mut b) 2)
      (wb! (mut b) 4)
      (wuleb! (mut b) 1)
      ; memory i64, min 1
      (wemit-name! (mut b) "env")
      (wemit-name! (mut b) "__memory_base")
      (wb! (mut b) 3)
      (wb! (mut b) 126)
      (wb! (mut b) 0)
      ; global i64 immutable
      (wemit-name! (mut b) "env")
      (wemit-name! (mut b) "__stack_pointer")
      (wb! (mut b) 3)
      (wb! (mut b) 126)
      (wb! (mut b) 1))  ; global (mut i64)
    (let [(mut i) 0]
      (loop (if (>= (load i) nfun)
                (break)
                (do
                  (let [imp (wal-at [WImport] (field g imports) (load i))]
                    (wemit-name! (mut b) "env")
                    (wemit-name! (mut b) (.field imp))
                    (wb! (mut b) 0)
                    (wuleb! (mut b) (.typeidx imp)))
                  (set! i (primitive/iadd (load i) 1))))))
    (al-slice [u8] (load b))))

; export section (id 7) payload. Standalone ⇒ `main` (func) + `memory`, and the
; function table (under wasm-ld's name) when there is one, so host or C code can
; call back through a function pointer. Side-module ⇒ each (export-c …) entry by
; its C symbol (deduped; no memory export).
(defn wbuild-export-section [(g (ptr Wcg))
                             (mp (ptr Program))
                             (a (dyn Allocator))
                             (mainidx i64)] (-> (slice u8))
  (if (not (.side-module g))
      (let [(mut b) (al-new [u8] a)
            table (.needs-table g)]
        (wuleb! (mut b) (if table 3 2))
        (wemit-name! (mut b) "main")
        (wb! (mut b) 0)
        (wuleb! (mut b) (wfunc-index g mainidx))
        (wemit-name! (mut b) "memory")
        (wb! (mut b) 2)
        (wuleb! (mut b) 0)
        (when table
          (wemit-name! (mut b) "__indirect_function_table")
          (wb! (mut b) 1)
          (wuleb! (mut b) 0))
        (al-slice [u8] (load b)))
      (let [es (load (field mp exports))
            n (len (load es))
            (mut seen) (al-new [(slice u8)] a)
            (mut eb) (al-new [u8] a)
            (mut cnt) 0
            (mut i) 0]
        (loop (if (>= (load i) n)
                  (break)
                  (do
                    (let [ec (wal-at [ExportC] es (load i))
                          sym (wexportc-sym ec)
                          si (wsig-idx g (.name ec))]
                      (when (and (and (>= si (primitive/cast i64 0)) (.published ec))
                                 (not (wname-present? (mut seen) sym)))
                        (wname-add! (mut seen) sym)
                        (wemit-name! (mut eb) sym)
                        (wb! (mut eb) 0)
                        (wuleb! (mut eb)
                                (wfunc-index g (load (field (wal-at [WSig] (field g sigs) si)
                                                            ordinal))))
                        (store! cnt (primitive/iadd (load cnt) 1))
                        0))
                    (set! i (primitive/iadd (load i) 1)))))
        (when (= (load cnt) (primitive/cast i64 0))
          (wcg-fail "side-module mode: no (export-c …) entry resolved to a defined function"))
        (let [(mut out) (al-new [u8] a)]
          (wuleb! (mut out) (load cnt))
          (wbytes! (mut out) (al-slice [u8] (load eb)))
          (al-slice [u8] (load out))))))

; A by-value STRUCT parameter reaches a Coil function by reference (mono types it
; as a pointer), but C passes it by value — a single-element struct as its
; scalar. So a function reached from C with one (an export-c, or the by-value C
; entry the checker records for an anonymous `c` function or a fnptr-of ascribed
; a by-value C type) gets the checker's thunk: it receives the C arguments and
; calls the function with their addresses. Codegen works on a copy of the program
; with the thunks added and the published exports renamed to them, as the x64
; backend does; the caller's program is left as it was.
(defn wcg-build-module [(a (dyn Allocator))
                        (mp0 (ptr Program))
                        (side-module bool)] (-> (slice u8))
  (let [thunks (export-c-thunks a mp0)
        (mut with-thunks) (load mp0)
        mp (cast (ptr Program) (mut with-thunks))]
    (unless (= (len thunks) 0)
      (let [(mut funcs) (al-new [Func] a)
            (mut exports) (al-new [ExportC] a)]
        (for f (load (.funcs mp)) (push! (mut funcs) f))
        (for f thunks (push! (mut funcs) f))
        (for i (range 0 (len (load (.exports mp))))
          (let [e (wal-at [ExportC] (.exports mp) i)
                (mut copy) (load e)]
            (when (export-c-needs-thunk? e)
              (set! (.name copy) (export-c-thunk-name a (.name e))))
            ; an unpublished entry is reached only through fnptr-of, so its thunk
            ; is not exported
            (when (.published e) (push! (mut exports) copy))
            0))
        (set! (.funcs with-thunks) (box! a (ArrayList Func) (load funcs)))
        (set! (.exports with-thunks) (box! a (ArrayList ExportC) (load exports)))))
    (wcg-build-module-thunked a mp side-module)))

(defn wcg-build-module-thunked [(a (dyn Allocator))
                                (mp (ptr Program))
                                (side-module bool)] (-> (slice u8))
  (let [g (primitive/alloc-stack Wcg)]
    (set! (.a g) a)
    (set! (.program g) mp)
    (set! (.sigs g) (al-new [WSig] a))
    (set! (.imports g) (al-new [WImport] a))
    (set! (.types g) (al-new [(slice u8)] a))
    (set! (.data g) (al-new [u8] a))
    (set! (.strs g) (al-new [WStr] a))
    (set! (.needs-table g) false)
    (set! (.code g) (al-new [u8] a))
    (set! (.frame g) 0)
    (set! (.env g) (wscope-nil a))
    (set! (.loops g) (al-new [WLoop] a))
    (set! (.depth g) 0)
    (set! (.terminated g) false)
    (set! (.retty g) (TInt 64 true))
    (set! (.aggret g) false)
    (set! (.fp-local g) 0)
    (set! (.nkeep g) 0)
    (set! (.curfix g) (al-new [i64] a))
    (set! (.fixes g) (al-new [WFix] a))
    (set! (.named g) (al-new [WNamed] a))
    (set! (.defs g) (al-new [WDef] a))
    (set! (.relocs g) (al-new [i64] a))
    ; PIC/side-module layout: imported globals __memory_base(0), __stack_pointer(1)
    ; precede any defined global, so $sp is global 1 and there is no defined global.
    (set! (.side-module g) side-module)
    (set! (.sp-global g) (if side-module (do 1) 0))
    (set! (.membase-global g) (if side-module 0 (do -1)))
    (wregister-types! g mp)
    (let [keepv (wcg-reachable a mp (wseeds a mp side-module))
          keep (box-al [i64] a keepv)]
      (wcg-register-sigs! g mp keep)
      (set! (.nkeep g) (len (load keep)))
      (wregister-named-statics! g mp keep)
      (wdeclare-defs! g mp)
      (let [mainidx (unless side-module (wcg-main-idx g))
            fs (load (field mp funcs))
            nfn (len (load keep))
            (mut entries) (al-new [(ArrayList u8)] a)
            (mut i) 0]
        (loop (if (>= (load i) nfn)
                  (break)
                  (do
                    ; A `declare`d function's definition is a native object;
                    ; wasm32 links no prebuilt units yet, so say so rather than
                    ; emit an empty body that returns garbage.
                    (when (load (field (wal-at [Func]
                                               fs
                                               (wal-get-keep keep (load i)))
                                       declared))
                      (wcg-fail2 "declared function has no body for wasm32; prebuilt units are native only: "
                                 (load (field (wal-at [Func]
                                                      fs
                                                      (wal-get-keep keep
                                                                    (load i)))
                                              name)))
                      0)
                    (push! (mut entries)
                           (wemit-func! g
                                        (wal-at [Func]
                                                fs
                                                (wal-get-keep keep (load i)))
                                        (load i)))
                    (set! i (primitive/iadd (load i) 1)))))
        ; every import is known now: point each direct call at its function index
        (for [k 0 (len (.fixes g))]
          (let [fx (get (.fixes g) k)]
            (wpatch-uleb5! (wal-at [(ArrayList u8)] (mut entries) (.entry fx))
                           (.off fx)
                           (wfunc-index g (.ordinal fx)))))
        (let [nimp (len (.imports g))
              ntotal (+ nimp nfn)
              ; a side module whose data holds data addresses relocates them in a
              ; start function, the last function after the table's
              reloc? (and side-module (> (len (.relocs g)) (primitive/cast i64 0)))
              reloc-type (if reloc?
                             (wtype-idx! g (box-al [Type] a (al-new [Type] a)) (box-type a (TVoid)) false)
                             0)]
        ; ---- type section (id 1): the deduped functype pool ----
        (let [(mut tbody) (al-new [u8] a)]
          (wuleb! (mut tbody) (len (.types g)))
          (let [(mut k) 0]
            (loop (if (>= (load k) (len (.types g)))
                      (break)
                      (do
                        (wbytes! (mut tbody) (get (.types g) (load k)))
                        (set! k (primitive/iadd (load k) 1))))))
          ; ---- function section (id 3): funcidx → typeidx ----
          (let [(mut fbody) (al-new [u8] a)]
            (wuleb! (mut fbody) (+ nfn (when reloc? 1)))
            (let [(mut k) 0]
              (loop (if (>= (load k) nfn)
                        (break)
                        (do
                          (wuleb! (mut fbody)
                                  (.typeidx (wal-at [WSig]
                                                    (field g sigs)
                                                    (load k))))
                          (set! k (primitive/iadd (load k) 1))))))
            (when reloc? (wuleb! (mut fbody) reloc-type))
            ; ---- table section (id 4): one funcref table64 covering ALL functions ----
            ; (64-bit indices: clang's wasm64 C ABI uses a table64, so a function
            ; pointer means the same thing to C code sharing the table)
            (let [(mut tabbody) (al-new [u8] a)]
              (when (load (field g needs-table))
                (wuleb! (mut tabbody) 1)
                (wb! (mut tabbody) 112)
                (wb! (mut tabbody) 4)  ; limits: i64 index type, no maximum
                (wuleb! (mut tabbody) ntotal))
              ; ---- memory section (id 5): standalone only (side-module imports memory) ----
              (let [(mut mbody) (al-new [u8] a)]
                (wuleb! (mut mbody) 1)
                (wb! (mut mbody) 4)
                (wuleb! (mut mbody) (wcg-mem-pages))
                ; ---- global section (id 6): $sp — standalone only (side-module imports __stack_pointer) ----
                (let [(mut gbody) (al-new [u8] a)]
                  (wuleb! (mut gbody) 1)
                  (wb! (mut gbody) 126)
                  (wb! (mut gbody) 1)
                  (wb! (mut gbody) 66)
                  (wsleb! (mut gbody) (wcg-stack-top))
                  (wb! (mut gbody) 11)
                  ; ---- element section (id 9): active table[0] = 0..ntotal-1 (fnptr = funcidx) ----
                  (let [(mut elbody) (al-new [u8] a)]
                    (when (load (field g needs-table))
                      (wuleb! (mut elbody) 1)
                      (wb! (mut elbody) 0)
                      ; 1 segment, flag 0 (active table 0)
                      (wb! (mut elbody) 66)
                      (wsleb! (mut elbody) 0)
                      (wb! (mut elbody) 11)
                      ; i64.const 0 offset (the table is 64-bit)
                      ; slot i < nfn: defined function i; then import j at nfn + j
                      (wuleb! (mut elbody) ntotal)
                      (for [k 0 nfn] (wuleb! (mut elbody) (wfunc-index g k)))
                      (for [k 0 nimp] (wuleb! (mut elbody) k)))
                    ; ---- code section (id 10) ----
                    (let [(mut cbody) (al-new [u8] a)]
                      (wuleb! (mut cbody) (+ nfn (when reloc? 1)))
                      (let [(mut k) 0]
                        (loop (if (>= (load k) nfn)
                                  (break)
                                  (do
                                    (let [ent (get entries (load k))]
                                      (wuleb! (mut cbody) (len ent))
                                      (wbytes! (mut cbody) (al-slice [u8] ent)))
                                    (set! k (primitive/iadd (load k) 1))))))
                      (when reloc?
                        (let [ent (wreloc-func g)]
                          (wuleb! (mut cbody) (len ent))
                          (wbytes! (mut cbody) (al-slice [u8] ent))))
                      ; ---- data section (id 11): active; offset i64.const (standalone) or global.get __memory_base (side) ----
                      (let [(mut dbody) (al-new [u8] a)
                            datalen (len (.data g))]
                        (when (> datalen (primitive/cast i64 0))
                          (wuleb! (mut dbody) 1)
                          (wb! (mut dbody) 0)
                          ; 1 segment, active memory 0
                          (if side-module
                              (do
                                (wb! (mut dbody) 35)
                                (wuleb! (mut dbody)
                                        (load (field g membase-global)))
                                (wb! (mut dbody) 11)
                                0)  ; global.get __memory_base
                              (do
                                (wb! (mut dbody) 66)
                                (wsleb! (mut dbody) (wcg-data-base))
                                (wb! (mut dbody) 11)
                                0))
                          ; i64.const base
                          (wuleb! (mut dbody) datalen)
                          (wbytes! (mut dbody)
                                   (al-slice [u8] (load (field g data)))))
                        ; ---- assemble ----
                        (let [(mut out) (al-new [u8] a)]
                          (wb! (mut out) 0)
                          (wb! (mut out) 97)
                          (wb! (mut out) 115)
                          (wb! (mut out) 109)
                          (wb! (mut out) 1)
                          (wb! (mut out) 0)
                          (wb! (mut out) 0)
                          (wb! (mut out) 0)
                          (wasm-section! (mut out)
                                         1
                                         (al-slice [u8] (load tbody)))
                          (when (or side-module (> nimp (primitive/cast i64 0)))
                            (wasm-section! (mut out)
                                           2
                                           (wbuild-import-section g a)))
                          (wasm-section! (mut out)
                                         3
                                         (al-slice [u8] (load fbody)))
                          (when (load (field g needs-table))
                            (wasm-section! (mut out)
                                           4
                                           (al-slice [u8] (load tabbody))))
                          (unless side-module
                            (wasm-section! (mut out)
                                           5
                                           (al-slice [u8] (load mbody))))
                          (unless side-module
                            (wasm-section! (mut out)
                                           6
                                           (al-slice [u8] (load gbody))))
                          (wasm-section! (mut out)
                                         7
                                         (wbuild-export-section g mp a mainidx))
                          (when reloc?
                            (let [(mut st) (al-new [u8] a)]
                              (wuleb! (mut st) (+ nimp nfn))
                              (wasm-section! (mut out) 8 (al-slice [u8] (load st)))))
                          (when (load (field g needs-table))
                            (wasm-section! (mut out)
                                           9
                                           (al-slice [u8] (load elbody))))
                          (wasm-section! (mut out)
                                         10
                                         (al-slice [u8] (load cbody)))
                          (when (> datalen (primitive/cast i64 0))
                            (wasm-section! (mut out)
                                           11
                                           (al-slice [u8] (load dbody))))
                          (al-slice [u8] (load out))))))))))))))))
