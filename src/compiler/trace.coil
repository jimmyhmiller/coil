(module coil.compiler.trace)
(import "coil.primitive" :as primitive)
(import "coil.time" :as time)
(import "coil.io" :as io)
(import "coil.compiler.mtrace" :as mt)
(import "coil.scratch" :as scratch)

(extern getenv :cc c [(ptr i8)] (-> (ptr i8)))

(defstruct Span
  [(name (slice u8))
   (started-ms i64)
   (started-bytes i64)
   (enabled bool)])

; A trace observation is flushed immediately, but formatting it should not issue
; one system call per field/digit. Storage belongs to the emitting call, including
; its fd writer: parallel backends never share mutable buffering state.
(defstruct TraceOutput
  [(state io/BufferedWriter)
   (writer io/Writer)
   (sink io/Writer)
   (buffer (array i8 1024))])

(defn trace-writer [(out (ptr TraceOutput))] (-> (ptr io/Writer))
  (io/buffered-writer (field out writer)
                      (field out state)
                      (io/fd-writer (field out sink) 2)
                      (primitive/cast (ptr i8) (field out buffer))
                      1024))

(defn trace-enabled? [] (-> bool)
  (let [value (getenv c"COIL_TRACE")]
    (and (!= (primitive/cast i64 value) 0)
         (!= (load value) (primitive/cast i8 48)))))

(defn trace-now-ms [] (-> i64)
  (try (let [value (try-or! (time/monotonic-now-ms) 0)] value)))

(defn trace-line [(kind (slice u8)) (name (slice u8)) (elapsed i64)] (-> i64)
  (let [out (primitive/alloc-stack TraceOutput)
        w (trace-writer out)]
    (io/print-str w "coil-trace ")
    (io/print-str w kind)
    (io/print-str w " ")
    (io/print-str w name)
    (when (>= elapsed 0)
      (io/print-str w " ")
      (io/print-int w elapsed)
      (io/print-str w "ms")
      0)
    (io/write-byte w (primitive/cast u8 10))
    (io/buffered-flush (field out state))
    0))

(defn span-begin [(name (slice u8))] (-> Span)
  (let [span (primitive/alloc-stack Span)
        enabled (trace-enabled?)]
    (set! (.name span) name)
    (set! (.enabled span) enabled)
    (set! (.started-ms span) (if enabled (trace-now-ms) 0))
    (set! (.started-bytes span) (if enabled (mt/mtrace-mem-now) 0))
    (when enabled (trace-line "begin" name -1) 0)
    (load span)))

(defn span-end [(span Span)] (-> i64)
  (when (load (field span enabled))
    (trace-line "end"
                (load (field span name))
                (- (trace-now-ms) (load (field span started-ms))))
    (profile-event "allocated"
                   (.name span)
                   (- (mt/mtrace-mem-now) (.started-bytes span)))
    (arena-snapshot (.name span) (.profile_arena (mt/mtrace-unit-state)))
    0)
  0)

; Tab-delimited observations for development profiling. Names/paths are retained
; by their owning compilation, never by the profiler. No global accumulation.
(defn profile-event [(kind (slice u8)) (name (slice u8)) (value i64)] (-> i64)
  (when (trace-enabled?)
    (let [out (primitive/alloc-stack TraceOutput)
          w (trace-writer out)]
      (io/print-str w "coil-profile\t")
      (io/print-str w kind)
      (io/print-str w "\t")
      (io/print-str w name)
      (io/print-str w "\t")
      (io/print-int w value)
      (io/write-byte w (primitive/cast u8 10))
      (io/buffered-flush (field out state)))
    0)
  0)

(defn arena-snapshot [(name (slice u8)) (arena (ptr scratch/ScratchArena))] (-> i64)
  (when (and (trace-enabled?) (!= (primitive/cast i64 arena) 0))
    (profile-event "arena.live" name (scratch/scratch-live arena))
    (profile-event "arena.peak" name (scratch/scratch-peak arena))
    (profile-event "arena.capacity" name (scratch/scratch-capacity arena))
    0)
  0)

(defn count [(name (slice u8)) (value i64)] (-> i64)
  (when (trace-enabled?)
    (let [out (primitive/alloc-stack TraceOutput)
          w (trace-writer out)]
      (io/print-str w "coil-trace count ")
      (io/print-str w name)
      (io/print-str w " ")
      (io/print-int w value)
      (io/write-byte w (primitive/cast u8 10))
      (io/buffered-flush (field out state)))
    0)
  0)
