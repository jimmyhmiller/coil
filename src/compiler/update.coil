(module coil.compiler.update)
(import "coil.primitive" :as p)
(import "coil.alloc" :use *)
(import "coil.arraylist" :use *)
(import "coil.slice" :use *)
(import "coil.str" :use *)
(import "coil.result" :use *)
(import "coil.io" :use *)
(import "coil.fs" :as fs)
(import "coil.json" :as json)
(import "coil.http.client" :as http)
(import "coil.compiler.digest" :as digest)
(import "coil.compiler.ffi" :use *)

(export update-cmd update-usage)

(defn update-usage [] (-> (slice u8))
  "usage: coil update [--rollback]\n\nCOIL_UPDATE_URL names a schema-v1 HTTPS manifest. Authentication headers may be\nprovided by COIL_UPDATE_HEADERS or COIL_UPDATE_HEADERS_FILE (one Name: value per line).\n")

(defn fail [(message (slice u8))] (-> i64)
  (print-str (stderr) "coil update: ")
  (print-str (stderr) message)
  (write-byte (stderr) (p/cast u8 10))
  1)

(defn c-slice [(value (ptr i8))] (-> (slice u8))
  (let [(mut n) 0]
    (loop (if (= (p/cast i64 (load (p/index value (load n)))) 0)
              (break)
              (set! n (+ (load n) 1))))
    (slice-new (p/cast (ptr u8) value) (load n))))

(defn cat [(a (dyn Allocator)) (left (slice u8)) (right (slice u8))] (-> (slice u8))
  (match (str-concat a left right) (Some [value] value) (None [] "")))

(defn decimal [(a (dyn Allocator)) (value i64)] (-> (slice u8))
  (let [(mut reverse) (sb-new a)
        (mut n) value
        (mut out) (sb-new a)]
    (if (= (load n) 0)
        (sb-push-byte! (mut reverse) (p/cast u8 48))
        (loop (if (= (load n) 0)
                  (break)
                  (do
                    (sb-push-byte! (mut reverse)
                                   (p/cast u8 (+ 48 (p/irem (load n) 10))))
                    (set! n (p/idiv (load n) 10))))))
    (let [(mut i) (- (len (sb-str (load reverse))) 1)]
      (loop (if (< (load i) 0)
                (break)
                (do
                  (sb-push-byte! (mut out)
                                 (get (sb-str (load reverse)) (load i)))
                  (set! i (- (load i) 1))))))
    (sb-str (load out))))

(defn env [(name (ptr i8))] (-> (slice u8))
  (let [value (getenv name)]
    (if (= (p/cast i64 value) 0) "" (c-slice value))))

(defn find-byte [(text (slice u8)) (byte i64) (start i64)] (-> i64)
  (let [(mut i) start
        (mut found) -1]
    (loop (if (>= (load i) (len text))
              (break)
              (if (= (p/cast i64 (get text (load i))) byte)
                  (do (set! found (load i)) (break))
                  (set! i (+ (load i) 1)))))
    (load found)))

(defn starts? [(text (slice u8)) (prefix (slice u8))] (-> bool)
  (and (>= (len text) (len prefix)) (= (subslice text 0 (len prefix)) prefix)))

(defn lower [(byte u8)] (-> u8)
  (let [n (p/cast i64 byte)]
    (if (and (>= n 65) (<= n 90)) (p/cast u8 (+ n 32)) byte)))

(defn ci-eq? [(a (slice u8)) (b (slice u8))] (-> bool)
  (if (!= (len a) (len b))
      false
      (let [(mut same) true]
        (for [i 0 (len a)]
          (unless (= (lower (get a i)) (lower (get b i))) (set! same false) 0)
          0)
        (load same))))

(defn header-name? [(name (slice u8))] (-> bool)
  (if (= (len name) 0)
      false
      (let [(mut good) true]
        (for [i 0 (len name)]
          (let [c (p/cast i64 (get name i))]
            (unless (or (and (>= c 48) (<= c 57))
                        (and (>= c 65) (<= c 90))
                        (and (>= c 97) (<= c 122))
                        (= c 45))
              (set! good false)
              0))
          0)
        (load good))))

(defn reserved-header? [(name (slice u8))] (-> bool)
  (or (ci-eq? name "host")
      (ci-eq? name "content-length")
      (ci-eq? name "transfer-encoding")
      (ci-eq? name "connection")
      (ci-eq? name "range")
      (ci-eq? name "if-range")))

(defn parse-headers [(a (dyn Allocator)) (text (slice u8))] (-> (Result (slice http/Header)
                                                                        i64))
  (let [(mut out) (al-new [http/Header] a)
        (mut start) 0
        (mut bad) false]
    (for [i 0 (+ (len text) 1)]
      (when (or (= i (len text)) (= (p/cast i64 (get text i)) 10))
        (let [line (subslice text (load start) i)]
          (when (> (len line) 0)
            (let [colon (find-byte line 58 0)]
              (if (<= colon 0)
                  (set! bad true)
                  (let [name (subslice line 0 colon)
                        raw (subslice line (+ colon 1) (len line))
                        value
                          (if (and (> (len raw) 0)
                                   (= (p/cast i64 (get raw 0)) 32))
                              (subslice raw 1 (len raw))
                              raw)
                        (mut duplicate) false]
                    (for [j 0 (len (load out))]
                      (when (ci-eq? name
                                    (.name (al-elem [http/Header] (mut out) j)))
                        (set! duplicate true)
                        0)
                      0)
                    (if (or (not (header-name? name))
                            (reserved-header? name)
                            (= (len value) 0)
                            (>= (find-byte value 13 0) 0)
                            (>= (find-byte value 10 0) 0)
                            (load duplicate))
                        (set! bad true)
                        (push! (mut out) (http/Header :name name :value value)))))))
          (set! start (+ i 1)))
        0)
      0)
    (if (load bad)
        (do (al-free! (mut out)) (Err [(slice http/Header) i64] 1))
        (Ok [(slice http/Header) i64] (al-into-slice (mut out))))))

(defn http-get [(a (dyn Allocator))
                (url (slice u8))
                (headers (slice http/Header))] (-> (Result (slice u8) i64))
  (let [request (p/alloc-stack http/Request)]
    (set! request
          (http/Request
            :method "GET"
            :url url
            :headers headers
            :body ""
            :connect-timeout-ms 15000
            :timeout-ms 1800000
            :follow-redirects false
            :ca-info (env c"COIL_UPDATE_CA_FILE")))
    (try (let [response
                 (try-or! (http/request a request) (Err [(slice u8) i64] 1))]
           (if (and (>= (http/response-status response) 200)
                    (< (http/response-status response) 300))
               (Ok [(slice u8) i64] (http/response-body response))
               (Err [(slice u8) i64] (http/response-status response)))))))

(defn number [(text (slice u8))] (-> i64)
  (let [(mut value) 0
        (mut good) (> (len text) 0)]
    (for [i 0 (len text)]
      (let [c (p/cast i64 (get text i))]
        (if (or (< c 48) (> c 57))
            (set! good false)
            (set! value (+ (* (load value) 10) (- c 48)))))
      0)
    (if (load good) (load value) -1)))

(defn hex? [(text (slice u8)) (n i64)] (-> bool)
  (if (!= (len text) n)
      false
      (let [(mut good) true]
        (for [i 0 n]
          (let [c (p/cast i64 (get text i))]
            (unless (or (and (>= c 48) (<= c 57)) (and (>= c 97) (<= c 102)))
              (set! good false)
              0))
          0)
        (load good))))

(defn target [] (-> (slice u8))
  (target-form unused))

(defn target-form [(unused Code)] (-> Code)
  (if (= (p/target-os) `darwin)
      `"aarch64-apple-darwin"
      `"x86_64-unknown-linux-gnu"))

(defn origin-end [(url (slice u8))] (-> i64)
  (if (starts? url "https://") (find-byte url 47 8) -1))

(defn normalize-url-path [(a (dyn Allocator)) (path (slice u8))] (-> (slice u8))
  (let [(mut parts) (al-new [(slice u8)] a)
        (mut start) 0
        (mut escaped) false]
    (for [i 0 (+ (len path) 1)]
      (when (or (= i (len path)) (= (p/cast i64 (get path i)) 47))
        (let [part (subslice path (load start) i)]
          (cond (or (= (len part) 0) (= part ".")) 0
                (= part "..")
                  (if (= (len (load parts)) 0)
                      (do (set! escaped true) 0)
                      (do (pop! (mut parts)) 0))
                :else (push! (mut parts) part))
          (set! start (+ i 1)))
        0)
      0)
    (if (load escaped)
        ""
        (let [(mut out) (sb-new a)]
          (sb-push-byte! (mut out) (p/cast u8 47))
          (for [i 0 (len (load parts))]
            (when (> i 0) (sb-push-byte! (mut out) (p/cast u8 47)) 0)
            (sb-push-str! (mut out) (get (load parts) i))
            0)
          (sb-str (load out))))))

(defn artifact-url [(a (dyn Allocator))
                    (manifest (slice u8))
                    (artifact (slice u8))] (-> (slice u8))
  (let [oe (origin-end manifest)]
    (if (or (< oe 0) (starts? artifact "https://"))
        ""
        (let [origin (subslice manifest 0 oe)
              path (subslice manifest oe (len manifest))
              slash
                (let [(mut last) -1]
                  (for [i 0 (len path)]
                    (when (= (p/cast i64 (get path i)) 47) (set! last i) 0)
                    0)
                  (load last))
              joined (if (starts? artifact "/")
                         artifact
                         (cat a (subslice path 0 (+ slash 1)) artifact))
              normalized (normalize-url-path a joined)]
          (if (= (len normalized) 0)
              ""
              (cat a origin normalized))))))

(defn quote! [(b (mut StrBuf)) (text (slice u8))] (-> i64)
  (sb-push-byte! (mut b) (p/cast u8 39))
  (for [i 0 (len text)]
    (if (= (p/cast i64 (get text i)) 39)
        (sb-push-str! (mut b) "'\\''")
        (sb-push-byte! (mut b) (get text i)))
    0)
  (sb-push-byte! (mut b) (p/cast u8 39))
  0)

(defn shell [(a (dyn Allocator)) (command (slice u8))] (-> bool)
  (= (p/cast i64 (system (str->cstr a command))) 0))

(defn install [(a (dyn Allocator))
               (home (slice u8))
               (commit (slice u8))
               (archive (slice u8))] (-> bool)
  (let [base (cat a home "/.local/lib/coil/toolchains/nightly/")
        final (cat a base commit)
        staged (cat a final ".partial")
        bin (cat a home "/.local/bin")
        current (cat a bin "/coil")
        previous (cat a home "/.local/lib/coil/previous")
        previous-tmp (cat a previous ".new")
        lock (cat a home "/.local/lib/coil/update.lock")
        tmp (cat a current ".new")
        (mut c) (sb-new a)]
    (sb-push-str! (mut c) "set -eu; umask 077; mkdir -p ")
    (quote! (mut c) base)
    (sb-push-str! (mut c) " ")
    (quote! (mut c) bin)
    (sb-push-str! (mut c) "; lock=")
    (quote! (mut c) lock)
    (sb-push-str! (mut c) "; mkdir \"$lock\"; trap 'rmdir \"$lock\"' EXIT")
    (sb-push-str! (mut c) "; rm -rf ")
    (quote! (mut c) staged)
    (sb-push-str! (mut c) "; mkdir ")
    (quote! (mut c) staged)
    (sb-push-str! (mut c) "; tar -xzf ")
    (quote! (mut c) archive)
    (sb-push-str! (mut c) " -C ")
    (quote! (mut c) staged)
    (sb-push-str! (mut c) "; test -x ")
    (quote! (mut c) (cat a staged "/bin/coil"))
    (sb-push-str! (mut c)
                  "; env -u COIL_UPDATE_HEADERS -u COIL_UPDATE_HEADERS_FILE ")
    (quote! (mut c) (cat a staged "/bin/coil"))
    (sb-push-str! (mut c) " --version >/dev/null")
    (sb-push-str! (mut c) "; rm -rf ")
    (quote! (mut c) final)
    (sb-push-str! (mut c) "; mv ")
    (quote! (mut c) staged)
    (sb-push-str! (mut c) " ")
    (quote! (mut c) final)
    (sb-push-str! (mut c) "; if [ -L ")
    (quote! (mut c) current)
    (sb-push-str! (mut c) " ]; then old=$(readlink ")
    (quote! (mut c) current)
    (sb-push-str! (mut c) "); ln -s \"$old\" ")
    (quote! (mut c) previous-tmp)
    (sb-push-str! (mut c) "; mv -f ")
    (quote! (mut c) previous-tmp)
    (sb-push-str! (mut c) " ")
    (quote! (mut c) previous)
    (sb-push-str! (mut c) "; fi")
    (sb-push-str! (mut c) "; ln -s ")
    (quote! (mut c)
            (cat a "../lib/coil/toolchains/nightly/" (cat a commit "/bin/coil")))
    (sb-push-str! (mut c) " ")
    (quote! (mut c) tmp)
    (sb-push-str! (mut c) "; mv -f ")
    (quote! (mut c) tmp)
    (sb-push-str! (mut c) " ")
    (quote! (mut c) current)
    (shell a (sb-str (load c)))))

(defn rollback [(a (dyn Allocator))] (-> i64)
  (let [home (env c"HOME")
        bin (cat a home "/.local/bin/coil")
        previous (cat a home "/.local/lib/coil/previous")
        tmp (cat a bin ".new")
        (mut c) (sb-new a)]
    (sb-push-str! (mut c) "set -eu; test -L ")
    (quote! (mut c) previous)
    (sb-push-str! (mut c) "; target=$(readlink ")
    (quote! (mut c) previous)
    (sb-push-str! (mut c) "); ln -s \"$target\" ")
    (quote! (mut c) tmp)
    (sb-push-str! (mut c) "; mv -f ")
    (quote! (mut c) tmp)
    (sb-push-str! (mut c) " ")
    (quote! (mut c) bin)
    (if (shell a (sb-str (load c)))
        (do (print-str (stdout) "rolled back Coil toolchain\n") 0)
        (fail "no previous toolchain is available"))))

(defn run-update [(a (dyn Allocator))] (-> i64)
  (block :done
         (let [url (env c"COIL_UPDATE_URL")
               inline (env c"COIL_UPDATE_HEADERS")
               header-file (env c"COIL_UPDATE_HEADERS_FILE")
               home (env c"HOME")]
           (when (< (origin-end url) 0)
             (return-from :done
                            (fail "COIL_UPDATE_URL must be an absolute HTTPS URL")))
           (when (and (> (len inline) 0) (> (len header-file) 0))
             (return-from :done
                            (fail "set only one headers environment variable")))
           (let [header-text
                   (if (> (len header-file) 0)
                       (try (let [v
                                    (try-or! (fs/read-file a header-file)
                                             (return-from :done
                                                            (fail "could not read headers file")))]
                              v))
                       inline)]
             (try (let [headers
                          (try-or! (parse-headers a header-text)
                                   (return-from :done
                                                  (fail "headers are malformed, duplicated, or reserved")))]
                    (match (http-get a url headers)
                      (Err [_]
                           (return-from :done (fail "manifest request failed")))
                      (Ok [body]
                          (match (json/parse a body)
                            (Err [_]
                                 (return-from :done
                                                (fail "manifest is invalid JSON")))
                            (Ok [doc]
                                (let [schema-i (json/object-get doc 0 "schema")
                                      commit-i (json/object-get doc 0 "commit")
                                      targets-i
                                        (json/object-get doc 0 "targets")]
                                  (when (or (< schema-i 0)
                                            (< commit-i 0)
                                            (< targets-i 0))
                                    (return-from :done
                                                   (fail "manifest is missing required fields")))
                                  (let [commit
                                          (json/string-text doc
                                                            (json/token doc
                                                                        commit-i))
                                        target-i
                                          (json/object-get doc
                                                           targets-i
                                                           (target))]
                                    (when (or (not (hex? commit 40))
                                              (< target-i 0))
                                      (return-from :done
                                                     (fail "manifest commit or host target is invalid")))
                                    (unless (= (json/number-text doc
                                                                 (json/token doc
                                                                             schema-i))
                                               "1")
                                      (return-from :done
                                                     (fail "unsupported manifest schema")))
                                    (let [artifact-i
                                            (json/object-get doc
                                                             target-i
                                                             "artifact")
                                          sha-i
                                            (json/object-get doc
                                                             target-i
                                                             "sha256")
                                          size-i
                                            (json/object-get doc
                                                             target-i
                                                             "size")]
                                      (when (or (< artifact-i 0)
                                                (< sha-i 0)
                                                (< size-i 0))
                                        (return-from :done
                                                       (fail "target metadata is incomplete")))
                                      (let [artifact
                                              (artifact-url a
                                                            url
                                                            (json/string-text doc
                                                                              (json/token doc
                                                                                          artifact-i)))
                                            sha
                                              (json/string-text doc
                                                                (json/token doc
                                                                            sha-i))
                                            size
                                              (number (json/number-text doc
                                                                        (json/token doc
                                                                                    size-i)))]
                                        (when (or (= (len artifact) 0)
                                                  (not (hex? sha 64))
                                                  (< size 1))
                                          (return-from :done
                                                         (fail "target metadata is invalid")))
                                        (match (http-get a artifact headers)
                                          (Err [_]
                                               (return-from :done
                                                              (fail "artifact request failed")))
                                          (Ok [bytes]
                                              (when (!= (len bytes) size)
                                                (return-from :done
                                                               (fail "artifact size mismatch")))
                                              (let [state
                                                      (p/alloc-stack digest/Sha256)]
                                                (digest/sha256-init! state)
                                                (digest/sha256-update! state
                                                                       bytes)
                                                (unless (= (digest/sha256-hex a
                                                                              state)
                                                           sha)
                                                  (return-from :done
                                                                 (fail "artifact SHA-256 mismatch"))))
                                              (let [download-dir
                                                      (cat a home "/.local/lib/coil")
                                                    (mut prepare) (sb-new a)
                                                    _prepared
                                                      (do
                                                        (sb-push-str! (mut prepare)
                                                                      "umask 077; mkdir -p ")
                                                        (quote! (mut prepare) download-dir)
                                                        (shell a (sb-str (load prepare))))
                                                    path
                                                      (cat a
                                                           download-dir
                                                           (cat a
                                                                "/update-download-"
                                                                (cat a
                                                                     (decimal a
                                                                              (p/cast i64
                                                                                      (getpid)))
                                                                     ".tar.gz")))]
                                                (match (fs/write-file a
                                                                      path
                                                                      bytes)
                                                  (Err [_]
                                                       (return-from :done
                                                                      (fail "could not save artifact")))
                                                  (Ok [_]
                                                      (let [ok
                                                              (install a
                                                                       home
                                                                       commit
                                                                       path)]
                                                        (unlink (str->cstr a
                                                                           path))
                                                        (if ok
                                                            (do
                                                              (print-str (stdout)
                                                                         "updated Coil to ")
                                                              (print-str (stdout)
                                                                         commit)
                                                              (write-byte (stdout)
                                                                          (p/cast u8
                                                                                  10))
                                                              (return-from :done
                                                                             0))
                                                            (return-from :done
                                                                           (fail "toolchain validation or install failed")))))))))))))))))))))
         1))

(defn update-cmd [(a (dyn Allocator)) (argc i32) (argv (ptr (ptr i8)))] (-> i64)
  (if (= (p/cast i64 argc) 2)
      (run-update a)
      (if (and (= (p/cast i64 argc) 3)
               (= (c-slice (load (p/index argv 2))) "--rollback"))
          (rollback a)
          (fail "usage: coil update [--rollback]"))))
