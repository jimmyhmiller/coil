; src/compiler/diag.coil — self-host Coil compiler, diag module.

(module coil.compiler.diag)
(import "coil.primitive" :as primitive)
(import "coil.alloc" :as alloc :use *)
(import "coil.result" :use *)
(import "coil.slice" :use *)
(import "coil.str" :use *)
(import "coil.arraylist" :use *)
(import "coil.io" :use *)
(import "coil.control" :use *)
(import "coil.try" :use *)
(import "coil.reader" :use *)
(import "coil.compiler.ast" :use *)
(import "coil.compiler.loader" :use *)
(import "coil.compiler.parser" :use *)

(defn dump-error [(w (ptr Writer)) (d (ptr Diag))] (-> i64)
  (ps w "(error")
  (dump-span w
             (.source d)
             (.lo d)
             (.hi d)
             (.ctxt d))
  (ps w " \"")
  (esc-write w (.msg d))
  (ps w "\")"))

(defn sm-src-text [(s (mut LS)) (id i64)] (-> (Option (slice u8)))
  (if (or (< id (primitive/cast i64 0)) (>= id (len (.sources s))))
      (None [(slice u8)])
      (let [sp (primitive/alloc-stack Source)]
        (set! sp (get (.sources s) id))
        (Some (.text sp)))))

(defn sm-src-name [(s (mut LS)) (id i64)] (-> (slice u8))
  (if (or (< id (primitive/cast i64 0)) (>= id (len (.sources s))))
      "<source>"
      (let [sp (primitive/alloc-stack Source)]
        (set! sp (get (.sources s) id))
        (.name sp))))

(defn sm-exp [(s (mut LS)) (ctxt i64)] (-> (Option Expansion))
  (if (or (<= ctxt (primitive/cast i64 0)) (> ctxt (len (.expansions s))))
      (None [Expansion])
      (Some (get (.expansions s) (primitive/isub ctxt 1)))))

; number of decimal digits in n (n >= 0).
(defn dec-len [(n i64)] (-> i64)
  (if (< n (primitive/cast i64 10)) 1 (primitive/iadd 1 (dec-len (primitive/udiv n 10)))))

(defn wspaces [(w (ptr Writer)) (n i64)] (-> i64)
  (let [(mut i) 0] (loop (if (>= (load i) n) (break) (do (wb w 32) (set! i (primitive/iadd (load i) 1))))))
  0)

(defn wrepeat [(w (ptr Writer)) (b i64) (n i64)] (-> i64)
  (let [(mut i) 0] (loop (if (>= (load i) n) (break) (do (wb w b) (set! i (primitive/iadd (load i) 1))))))
  0)

; line (1-based), column (1-based, bytes = chars for ASCII), and the offending
; line's [start,end) byte range, for offset `off` in `src`. Mirrors span::locate.
(defstruct Loc [(line i64) (col i64) (lstart i64) (lend i64)])

(defn locate [(src (slice u8)) (off0 i64)] (-> Loc)
  (let [n (len src)
        off (if (> off0 n) n off0)
        (mut ls) 0
        (mut line) 1
        (mut k) 0]
    (loop (if (>= (load k) off)
              (break)
              (do
                (when (= (primitive/cast i64 (get src (load k))) (primitive/cast i64 10))
                  (store! line (primitive/iadd (load line) 1))
                  (store! ls (primitive/iadd (load k) 1)))
                (set! k (primitive/iadd (load k) 1)))))
    (let [(mut le) off]
      (loop (if (or (>= (load le) n) (= (primitive/cast i64 (get src (load le))) (primitive/cast i64 10)))
                (break)
                (set! le (primitive/iadd (load le) 1))))
      (let [lp (primitive/alloc-stack Loc)]
        (set! (.line lp) (load line))
        (set! (.col lp) (primitive/iadd (primitive/isub off (load ls)) 1))
        (set! (.lstart lp) (load ls))
        (set! (.lend lp) (load le))
        (load lp)))))

(defn locate-source [(sp (ptr Source)) (off0 i64)] (-> Loc)
  (let [src (.text sp)
        n (len src)
        off (if (> off0 n) n off0)
        starts (load (field sp line_starts))
        count (len (load starts))
        (mut lo) 0
        (mut hi) count]
    ; upper_bound(line_starts, off) - 1
    (loop (if (>= (load lo) (load hi))
              (break)
              (let [mid (primitive/udiv (primitive/iadd (load lo) (load hi)) 2)]
                (if (<= (get (load starts) mid) off)
                    (set! lo (primitive/iadd mid 1))
                    (set! hi mid)))))
    (let [idx (if (> (load lo) 0) (primitive/isub (load lo) 1) 0)
          ls (get (load starts) idx)
          next
            (if (< (primitive/iadd idx 1) count)
                (get (load starts) (primitive/iadd idx 1))
                n)
          le
            (if (and (> next ls)
                     (= (primitive/cast i64 (get src (primitive/isub next 1)))
                        (primitive/cast i64 10)))
                (primitive/isub next 1)
                next)
          lp (primitive/alloc-stack Loc)]
      (set! (.line lp) (primitive/iadd idx 1))
      (set! (.col lp) (primitive/iadd (primitive/isub off ls) 1))
      (set! (.lstart lp) ls)
      (set! (.lend lp) le)
      (load lp))))

; Render one located frame (mirrors span::render_frame). Returns false (no output)
; when the span is dummy / out of range, so the caller falls back to the message.
(defn render-frame [(w (ptr Writer)) (s (mut LS)) (source i64) (lo i64) (hi i64) (msg (slice u8)) (arrow (slice u8))] (-> bool)
  (match (sm-src-text (mut s) source)
    (None [] false)
    (Some [src]
          (if (or (< lo (primitive/cast i64 0)) (> lo (len src)))
              false
              (let [loc (primitive/alloc-stack Loc)
                    sp (primitive/alloc-stack Source)]
                (set! sp (get (.sources s) source))
                (set! loc (locate-source sp lo))
                (let [line (.line loc)
                      col (.col loc)
                      lstart (.lstart loc)
                      lend (.lend loc)
                      hic (let [h (if (> hi lend) lend hi)] (if (< h lo) lo h))
                      carets (let [c (primitive/isub hic lo)] (if (< c (primitive/cast i64 1)) 1 c))
                      numlen (dec-len line)
                      file (sm-src-name (mut s) source)]
                  ; Window a very long line around the span. A macro-generated line can be tens
                  ; of KB (`cond` -> one line); printing it whole buried the caret and dumped
                  ; the entire expansion. Show at most maxw chars, with `...` (ASCII, so byte
                  ; width matches the caret math) marking either truncated end.
                  (let [maxw 120
                        ctx 32
                        long (> (primitive/isub lend lstart) maxw)
                        wstart (if long (let [x (primitive/isub lo ctx)] (if (< x lstart) lstart x)) lstart)
                        wend (if long (let [x (primitive/iadd wstart maxw)] (if (> x lend) lend x)) lend)
                        pre (> wstart lstart)
                        post (< wend lend)
                        ; caret offset = span start within the window (+3 for a leading "...")
                        pad (primitive/iadd (primitive/isub lo wstart) (when pre 3))
                        ; don't let carets run past the visible window
                        shown
                          (let [avail (primitive/isub wend lo)
                                c (if (< carets avail) carets avail)]
                            (if (< c (primitive/cast i64 1)) 1 c))]
                    (when (> (len msg) (primitive/cast i64 0)) (ps w msg) (wb w 10))
                    (wspaces w numlen)
                    (wb w 32)
                    (ps w arrow)
                    (wb w 32)
                    (ps w file)
                    (wb w 58)
                    (dump-dec w line)
                    (wb w 58)
                    (dump-dec w col)
                    (wb w 10)
                    (wspaces w numlen)
                    (ps w " |")
                    (wb w 10)
                    (dump-dec w line)
                    (ps w " | ")
                    (when pre (ps w "..."))
                    (print-str w (subslice src wstart wend))
                    (when post (ps w "..."))
                    (wb w 10)
                    (wspaces w numlen)
                    (ps w " | ")
                    (wspaces w pad)
                    (wrepeat w 94 shown)
                    true)))))))

; ── scoped resolver keys never reach a reader ────────────────────────────────
; The parser lowers a binder/reference to a key that carries its lexical scope
; (`$scope<N>@<module>$<name>`, `$datum$<name>`). Those numbers are internal, and
; deterministic only within one compilation — printing them names an identifier
; the author cannot find in their file.
;
; A key also reaches a message EMBEDDED in a longer name: a generated function is
; reported as `mymod.$scope7@mymod$helper`, so stripping has to work mid-token,
; not just on a whole name. That is why this normalizes the rendered TEXT at the
; single place every diagnostic is written, instead of at each of the several
; dozen places one is built — a new message cannot forget to do it.
(defn diag-key-start? [(msg (slice u8)) (i i64)] (-> i64)
  (let [n (len msg)]
    (if (and (< (primitive/iadd i 6) n)
             (= (subslice msg i (primitive/iadd i 6)) "$scope"))
        6
        (if (and (< (primitive/iadd i 6) n)
                 (= (subslice msg i (primitive/iadd i 6)) "$datum"))
            6
            0))))

; Where the identifier a key names begins: past the `$` that closes the key's
; scope/module prefix. -1 when the token is not a well-formed key after all.
(defn diag-key-name-at [(msg (slice u8)) (i i64)] (-> i64)
  (let [n (len msg)
        (mut k) (primitive/iadd i 6)
        (mut r) -1]
    (loop (if (>= (load k) n)
              (break)
              (let [c (primitive/cast i64 (get msg (load k)))]
                (if (= c 36)
                    (do (set! r (primitive/iadd (load k) 1)) (break))
                    (if (diag-token-end? c)
                        (break)
                        (set! k (primitive/iadd (load k) 1)))))))
    (load r)))

; A rendered name ends where the surrounding prose starts. Identifier bytes
; include `-`, `.`, `/`, `?`, `!` and the operator characters, so the test is
; written the other way round: these are the delimiters a message puts around a
; name.
(defn diag-token-end? [(c i64)] (-> bool)
  (or (or (= c 32) (or (= c 9) (= c 10)))
      (or (or (= c 39) (or (= c 34) (= c 96)))
          (or (or (= c 40) (or (= c 41) (= c 91)))
              (or (or (= c 93) (or (= c 123) (= c 125)))
                  (or (= c 44) (= c 59)))))))

(defn diag-display-msg [(a (dyn Allocator)) (msg (slice u8))] (-> (slice u8))
  (let [n (len msg)
        (mut out) (al-new [u8] a)
        (mut i) 0
        (mut hit) false]
    (loop (if (>= (load i) n)
              (break)
              (if (= (diag-key-start? msg (load i)) (primitive/cast i64 0))
                  (do
                    (push! (mut out) (get msg (load i)))
                    (set! i (primitive/iadd (load i) 1)))
                  (let [at (diag-key-name-at msg (load i))]
                    (if (< at (primitive/cast i64 0))
                        (do
                          (push! (mut out) (get msg (load i)))
                          (set! i (primitive/iadd (load i) 1)))
                        (let [(mut e) at]
                          (set! hit true)
                          (loop (if (or (>= (load e) n)
                                        (diag-token-end? (primitive/cast i64 (get msg (load e)))))
                                    (break)
                                    (set! e (primitive/iadd (load e) 1))))
                          (let [(mut j) at]
                            (loop (if (>= (load j) (load e))
                                      (break)
                                      (do
                                        (push! (mut out) (get msg (load j)))
                                        (set! j (primitive/iadd (load j) 1))))))
                          (set! i (load e))))))))
    (if (load hit) (al-slice [u8] (load out)) msg)))

; Render one diagnostic body (mirrors span::render). No leading `error:`.
(defn render-diag [(w (ptr Writer)) (s (mut LS)) (d Diag)] (-> i64)
  (let [dp (primitive/alloc-stack Diag)]
    (set! dp d)
    (let [source (.source dp)
          lo (.lo dp)
          hi (.hi dp)
          ctxt0 (.ctxt dp)
          msg (diag-display-msg (.a s) (.msg dp))]
      (if (not (render-frame w (mut s) source lo hi msg "-->"))
          (ps w msg)  ; fallback: bare message
          (let [(mut ctxt) ctxt0]
            (loop (match (sm-exp (mut s) (load ctxt))
                    (None [] (break))
                    (Some [exp]
                          (let [ep (primitive/alloc-stack Expansion)]
                            (set! ep exp)
                            (let [def-dummy (< (.def_lo ep) (primitive/cast i64 0))
                                  at-src
                                    (if def-dummy
                                        (.call_source ep)
                                        (.def_source ep))
                                  at-lo
                                    (if def-dummy
                                        (.call_lo ep)
                                        (.def_lo ep))
                                  at-hi
                                    (if def-dummy
                                        (.call_hi ep)
                                        (.def_hi ep))
                                  note
                                    (sconcat3 (.a s)
                                              "note: in expansion of macro `"
                                              (.macro_name ep)
                                              "`")]
                              (wb w 10)  ; the "\n" before each note
                              (when (not (render-frame w (mut s) at-src at-lo at-hi note ":::")) (ps w note))
                              (set! ctxt (.parent ep)))))))))))
  0)

; Render all diagnostics (mirrors span::render_all): the caller has written the
; leading `error: `; subsequent errors get their own `\n\nerror: `, then an
; `N errors` summary when there is more than one.
(defn render-all [(w (ptr Writer)) (s (mut LS)) (diags (ptr (ArrayList Diag)))] (-> i64)
  (let [n (len (load diags))]
    (if (<= n (primitive/cast i64 1))
        (unless (= n (primitive/cast i64 0)) (render-diag w (mut s) (get (load diags) 0)))
        (let [(mut i) 0]
          (loop (if (>= (load i) n)
                    (break)
                    (do
                      (when (> (load i) (primitive/cast i64 0)) (ps w "\n\nerror: "))
                      (render-diag w (mut s) (get (load diags) (load i)))
                      (set! i (primitive/iadd (load i) 1)))))
          (ps w "\n\n")
          (dump-dec w n)
          (ps w " errors")
          0)))
  0)

; A single diagnostic → the top-level `error: <rendered>` on stderr (mirrors
; The main source (id 0) is registered under the real
; path, so no `<source>` substitution is needed.
(defn report-diag [(w (ptr Writer)) (s (mut LS)) (d Diag)] (-> i64)
  (ps w "error: ")
  (render-diag w (mut s) d)
  (wb w 10)
  0)

; A check failure: render EVERY collected body error (`error: … / … / N errors`)
; when there is more than one, else the single diagnostic. Mirrors render_all.
(defn report-check-diags [(w (ptr Writer)) (s (mut LS)) (d Diag)] (-> i64)
  (if (> (len (load (field s check_diags))) (primitive/cast i64 1))
      (do (ps w "error: ") (render-all w (mut s) (load (field s check_diags))) (wb w 10) 0)
      (report-diag w (mut s) d)))
