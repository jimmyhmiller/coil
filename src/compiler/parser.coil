; src/compiler/parser.coil — self-host Coil compiler, parser module.

(module coil.compiler.parser)
(import "coil.primitive" :as primitive)
(import "coil.alloc" :as alloc :use *)
(import "coil.result" :use *)
(import "coil.slice" :use *)
(import "coil.str" :use *)
(import "coil.mem" :use *)
(import "coil.arraylist" :use *)
(import "coil.hashmap" :use *)
(import "coil.io" :use *)
(import "coil.control" :use *)
(import "coil.try" :use *)
(import "coil.compiler.ffi" :use *)
(import "coil.compiler.ast" :use *)
(import "coil.compiler.astdump" :use *)
(import "coil.compiler.comptime" :use *)
(import "coil.reader" :use *)

(defn unimplemented [(who (slice u8))] (-> i64)
  (let [w (stderr)] (ps w "UNIMPLEMENTED: ") (ps w who) (wb w 10))
  (abort)
  0)

; Primitive dispatch is supplied by module resolution. An empty table means that no
; source name denotes a primitive; the parser itself owns no primitive namespace.
(defstruct PrimitiveBindingsBox
  [(bindings (ptr (ArrayList PrimitiveBinding)))
   (plain_index (ptr (HashMap (slice u8) (slice u8))))
   (scoped_index (ptr (HashMap (slice u8) (slice u8))))])

(defn primitive-bindings-box [] (-> (ptr PrimitiveBindingsBox))
  (primitive/alloc-static PrimitiveBindingsBox))

(defn parser-set-primitive-bindings! [(bindings (ptr (ArrayList PrimitiveBinding)))
                                      (plain-index (ptr (HashMap (slice u8) (slice u8))))
                                      (scoped-index (ptr (HashMap (slice u8) (slice u8))))] (-> i64)
  (set! (.bindings (primitive-bindings-box)) bindings)
  (set! (.plain_index (primitive-bindings-box)) plain-index)
  (set! (.scoped_index (primitive-bindings-box)) scoped-index)
  0)

(defn primitive-dispatch-scoped-scan [(bindings (ptr (ArrayList PrimitiveBinding)))
                                      (spelling (slice u8))
                                      (definition-module (slice u8))] (-> (Option (slice u8)))
  (let [n (len (load bindings))
        (mut i) 0
        (mut out) (None [(slice u8)])]
    (loop (if (>= (load i) n)
              (break)
              (let [bp (primitive/index (load (field bindings data)) (load i))]
                (if (and (= (.source_name bp) spelling)
                         (= (.source_module bp) definition-module))
                    (do (set! out (Some (.opcode bp))) (break))
                    (set! i (primitive/iadd (load i) 1))))))
    (load out)))

(defn primitive-dispatch-head [(head Sexp)] (-> (Option (slice u8)))
  (let [box (primitive-bindings-box)
        bindings (load (field box bindings))]
    (if (= (primitive/cast i64 bindings) 0)
        (None [(slice u8)])
        (let [spelling (sx-sval head)]
          (if (= (sx-hyg head) 0)
              (let [idx (load (field box plain_index))]
                (if (= (primitive/cast i64 idx) 0)
                    (None [(slice u8)])
                    (get (load idx) spelling)))
              (let [idx (load (field box scoped_index))
                    indexed
                      (if (= (primitive/cast i64 idx) 0)
                          (None [(slice u8)])
                          (get (load idx) spelling))]
                (match indexed
                  (Some [opcode]
                        (if (> (len opcode) 0)
                            (Some opcode)
                            (primitive-dispatch-scoped-scan bindings spelling (sx-hmod head))))
                  (None []
                        (primitive-dispatch-scoped-scan bindings spelling (sx-hmod head))))))))))

; ---- generic boxing + string helpers ----
(defn box-al [T] [(a (dyn Allocator)) (l (ArrayList T))] (-> (ptr (ArrayList T)))
  (box! a (ArrayList T) l))

(defn sconcat [(a (dyn Allocator)) (x (slice u8)) (y (slice u8))] (-> (slice u8))
  (match (str-concat a x y) (Some [v] v) (None [] "")))

(defn sconcat3 [(a (dyn Allocator)) (x (slice u8)) (y (slice u8)) (z (slice u8))] (-> (slice u8))
  (sconcat a (sconcat a x y) z))

(defn push-mag [(buf (mut (ArrayList u8))) (n i64)] (-> i64)
  (if (< n (primitive/cast i64 10))
      (push! (mut buf) (primitive/cast u8 (primitive/iadd n 48)))
      (do
        (push-mag (mut buf) (primitive/udiv n 10))
        (push! (mut buf) (primitive/cast u8 (primitive/iadd (primitive/urem n 10) 48))))))

(defn i64->str [(a (dyn Allocator)) (n i64)] (-> (slice u8))
  (let [(mut buf) (al-new [u8] a)]
    (if (< n (primitive/cast i64 0))
        (do (push! (mut buf) (primitive/cast u8 45)) (push-mag (mut buf) (primitive/isub 0 n)))
        (push-mag (mut buf) n))
    (al-slice [u8] (load buf))))

(defn char1 [(a (dyn Allocator)) (c i64)] (-> (slice u8))
  (slice-new [u8]
             (let [cb
                     (primitive/cast (ptr u8)
                                     (primitive/cast (ptr i8)
                                                     (slice-data (match (alloc-bytes a 1 1)
                                                                   (Some [s] s)
                                                                   (None []
                                                                         (do
                                                                           (oom-at c"compiler allocation" 1)
                                                                           (alloc/alloc-slice-new (primitive/cast (ptr u8)
                                                                                                                  0)
                                                                                                  0)))))))]
               (set! (primitive/index cb 0) (primitive/cast u8 c))
               cb)
             1))

; Type/parameter packs are compile-time sequences.  The two internal TApp
; constructors never denote runtime types: `$pack-var` is an unbound sequence
; parameter and `$pack` is its concrete substitution.
(defn pack-name? [(s (slice u8))] (-> bool)
  (let [n (len s)]
    (and (>= n 3) (= (subslice s (primitive/isub n 3) n) "..."))))

(defn pack-type [(a (dyn Allocator)) (name (slice u8))] (-> Type)
  (let [(mut xs) (al-new [Type] a)]
    (push! (mut xs) (TStruct name))
    (TApp "$pack-var" (box-al [Type] a (load xs)))))

(defn type-pack-var? [(t (ptr Type))] (-> bool)
  (match (load t) (TApp [n _] (= n "$pack-var")) (_ false)))

; ---- Sexp inspection (one match -> a flat info struct) ----
(defstruct SxInfo [(tag i64) (ival i64) (sval (slice u8)) (items (ptr (ArrayList Sexp)))])

(defn sx-info [(s Sexp)] (-> SxInfo)
  (let [sp (primitive/alloc-stack Sexp)
        p (primitive/alloc-stack SxInfo)]
    (set! sp s)
    (set! (.ival p) 0)
    (set! (.sval p) "")
    (set! (.items p) (primitive/zeroed (ptr (ArrayList Sexp))))
    (match (.kind sp)
      (KInt [v] (do (set! (.tag p) 0) (set! (.ival p) v) 0))
      (KFloat [b] (do (set! (.tag p) 1) (set! (.ival p) b) 0))
      (KSym [x] (do (set! (.tag p) 2) (set! (.sval p) x) 0))
      (KKw [x] (do (set! (.tag p) 3) (set! (.sval p) x) 0))
      (KStr [x] (do (set! (.tag p) 4) (set! (.sval p) x) 0))
      (KCStr [x] (do (set! (.tag p) 5) (set! (.sval p) x) 0))
      (KList [it] (do (set! (.tag p) 6) (set! (.items p) it) 0))
      (KVec [it] (do (set! (.tag p) 7) (set! (.items p) it) 0))
      ; a KView deliberately leaves items NULL: views are metaprogram-plane
      ; values read only through the view-aware code-op accessors — compiler
      ; code reaching one through sx-items must fail loudly, not read the
      ; parent list at the wrong offset (docs/design/META_MEMORY.md phase 5)
      (KView [it off len] (do (set! (.tag p) 8) 0)))
    (load p)))

(defn sx-tag [(s Sexp)] (-> i64)
  (let [p (primitive/alloc-stack SxInfo)] (set! p (sx-info s)) (.tag p)))

(defn sx-ival [(s Sexp)] (-> i64)
  (let [p (primitive/alloc-stack SxInfo)] (set! p (sx-info s)) (.ival p)))

(defn sx-sval [(s Sexp)] (-> (slice u8))
  (let [p (primitive/alloc-stack SxInfo)] (set! p (sx-info s)) (.sval p)))

(defn sx-items [(s Sexp)] (-> (ptr (ArrayList Sexp)))
  (let [p (primitive/alloc-stack SxInfo)] (set! p (sx-info s)) (load (field p items))))

(defn sx-lo [(s Sexp)] (-> i64)
  (let [p (primitive/alloc-stack Sexp)] (set! p s) (.lo p)))

(defn sx-hi [(s Sexp)] (-> i64)
  (let [p (primitive/alloc-stack Sexp)] (set! p s) (.hi p)))

(defn sx-source [(s Sexp)] (-> i64)
  (let [p (primitive/alloc-stack Sexp)] (set! p s) (.source p)))

(defn sx-ctxt [(s Sexp)] (-> i64)
  (let [p (primitive/alloc-stack Sexp)] (set! p s) (.ctxt p)))

(defn sx-hyg [(s Sexp)] (-> i64)
  (let [p (primitive/alloc-stack Sexp)] (set! p s) (.hyg p)))

(defn sx-hmod [(s Sexp)] (-> (slice u8))
  (let [p (primitive/alloc-stack Sexp)] (set! p s) (.hmod p)))

(defn sx-horigin [(s Sexp)] (-> i64)
  (let [p (primitive/alloc-stack Sexp)] (set! p s) (.horigin p)))

(defn sx-hflags [(s Sexp)] (-> i64)
  (let [p (primitive/alloc-stack Sexp)] (set! p s) (.hflags p)))

(defn lexical-name [(a (dyn Allocator)) (s Sexp)] (-> (slice u8))
  (let [name (sx-sval s)
        scope (sx-hyg s)]
    (if (= scope (primitive/cast i64 0))
        name
        (if (< scope (primitive/cast i64 0))
            ; Unscoped constructed data is never a lexical identity. Allocate a
            ; distinct poison key at every syntactic occurrence, so even reusing
            ; one `code-symbol` object cannot silently establish a binding.
            ; `syntax->datum` is the explicit operation that opts into the
            ; ordinary caller-visible spelling (hyg=0).
            (sconcat3 a "$datum" (i64->str a (next-nid)) (sconcat a "$" name))
            ; Resolver keys are deliberately not source rendering. Definition module
            ; is lexical context; source IDs remain diagnostics only.
            (sconcat3 a
                      "$scope"
                      (i64->str a scope)
                      (sconcat3 a "@" (sx-hmod s) (sconcat a "$" name)))))))

(defn sx-nid [(s Sexp)] (-> i64)
  (let [p (primitive/alloc-stack Sexp)] (set! p s) (.nid p)))

(defn sx-len [(l (ptr (ArrayList Sexp)))] (-> i64)
  (len (load l)))

(defn sx-at [(l (ptr (ArrayList Sexp))) (i i64)] (-> Sexp)
  (get (load l) i))

(defn sx-get [(l (ptr (ArrayList Sexp))) (i i64)] (-> (Option Sexp))
  (if (or (< i (primitive/cast i64 0)) (>= i (sx-len l))) (None [Sexp]) (Some (sx-at l i))))

(defn rest-from [(a (dyn Allocator)) (l (ptr (ArrayList Sexp))) (start i64)] (-> (ptr (ArrayList Sexp)))
  (let [(mut out) (al-new [Sexp] a)
        n (sx-len l)
        (mut i) start]
    (loop (if (>= (load i) n)
              (break)
              (do
                (push! (mut out) (sx-at l (load i)))
                (set! i (primitive/iadd (load i) 1)))))
    (box-al [Sexp] a (load out))))

; small Option<Sexp> predicates
(defn opt-is-vec [(o (Option Sexp))] (-> bool)
  (match o (Some [s] (= (sx-tag s) (primitive/cast i64 7))) (None [] false)))

(defn opt-get [(o (Option Sexp))] (-> Sexp)
  (match o (Some [s] s) (None [] (primitive/zeroed Sexp))))

(defn opt-is-kw [(o (Option Sexp)) (name (slice u8))] (-> bool)
  (match o (Some [s] (and (= (sx-tag s) (primitive/cast i64 3)) (= (sx-sval s) name))) (None [] false)))

(defn opt-is-pos-int [(o (Option Sexp))] (-> bool)
  (match o
    (Some [s] (and (= (sx-tag s) (primitive/cast i64 0)) (> (sx-ival s) (primitive/cast i64 0))))
    (None [] false)))

(defn opt-int [(o (Option Sexp))] (-> i64)
  (match o (Some [s] (sx-ival s)) (None [] 0)))

(defn opt-is-str [(o (Option Sexp))] (-> bool)
  (match o (Some [s] (= (sx-tag s) (primitive/cast i64 4))) (None [] false)))

(defn opt-str-val [(o (Option Sexp))] (-> (slice u8))
  (match o (Some [s] (sx-sval s)) (None [] "")))

; The DISPLAY escaper for Str/CStr, used by sexp-display. Differs from the DUMP
; escaper (esc-write, which emits `\xNN`): Display renders NUL as `\0` and any
; other control byte as `\u{hex}` (minimal lowercase hex).
(defn dbg-hexnum [(a (dyn Allocator)) (b i64)] (-> (slice u8))
  (if (< b (primitive/cast i64 16))
      (char1 a (hexd b))
      (sconcat a (char1 a (hexd (primitive/udiv b 16))) (char1 a (hexd (primitive/urem b 16))))))

(defn dbg-escape [(a (dyn Allocator)) (s (slice u8))] (-> (slice u8))
  (let [n (len s)
        (mut acc) ""
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (let [b (primitive/cast i64 (get s (load i)))]
                  (store! acc
                          (sconcat a
                                   (load acc)
                                   (cond (= b (primitive/cast i64 34)) "\\\""
                                         (= b (primitive/cast i64 92)) "\\\\"
                                         (= b (primitive/cast i64 10)) "\\n"
                                         (= b (primitive/cast i64 13)) "\\r"
                                         (= b (primitive/cast i64 9)) "\\t"
                                         (= b (primitive/cast i64 0)) "\\0"
                                         (or (< b (primitive/cast i64 32)) (= b (primitive/cast i64 127)))
                                           (sconcat a (sconcat a "\\u{" (dbg-hexnum a b)) "}")
                                         :else (char1 a b)))))
                (set! i (primitive/iadd (load i) 1)))))
    (load acc)))

; CStr Debug — used by the llvm-ir parse-error path, where
; An LLVM error string renders as `{:?}` over a `CStr`. Unlike str
; Debug (dbg-escape), CStr Debug is `ascii::escape_default` per byte: it escapes `'`
; as `\'` and renders any non-printable byte as `\xHH` (two lowercase hex digits),
; NOT `\u{…}`. Distinct helper so dbg-escape's str-Debug callers stay unchanged.
(defn cstr-dbg-escape [(a (dyn Allocator)) (s (slice u8))] (-> (slice u8))
  (let [n (len s)
        (mut acc) ""
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (let [b (primitive/cast i64 (get s (load i)))]
                  (store! acc
                          (sconcat a
                                   (load acc)
                                   (cond (= b (primitive/cast i64 9)) "\\t"
                                         (= b (primitive/cast i64 13)) "\\r"
                                         (= b (primitive/cast i64 10)) "\\n"
                                         (= b (primitive/cast i64 92)) "\\\\"
                                         (= b (primitive/cast i64 39)) "\\'"
                                         (= b (primitive/cast i64 34)) "\\\""
                                         (and (>= b (primitive/cast i64 32)) (<= b (primitive/cast i64 126)))
                                           (char1 a b)
                                         :else
                                           (sconcat a
                                                    "\\x"
                                                    (sconcat a
                                                             (char1 a (hexd (primitive/iand (primitive/ishr b 4) 15)))
                                                             (char1 a (hexd (primitive/iand b 15)))))))))
                (set! i (primitive/iadd (load i) 1)))))
    (load acc)))

; ---- f64 Debug, for error interpolation of float literals ----
; A string of `n` ASCII '0' characters.
(defn nzeros [(a (dyn Allocator)) (n i64)] (-> (slice u8))
  (let [(mut acc) ""
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do (set! acc (sconcat a (load acc) "0")) (set! i (primitive/iadd (load i) 1)))))
    (load acc)))

; Render an f64 as the SHORTEST decimal that round-trips. Input is the raw f64 bit
; pattern (a KFloat carries bits, not a decimal). Strategy: libc gives correctly
; rounded p-significant-digit decimals; we search p=1..17 for the SHORTEST p whose
; `%.*e` output parses back (strtod) to the identical f64 — this is exactly the
; shortest-round-trip Ryū would find. We then re-render (sign, digits, exponent) as
; fixed notation with a mandatory `.0`, switching to exponential iff
; `abs < 1e-4 || abs >= 1e16` (equivalently the leading-digit exponent
; E < -4 || E >= 16).
(defn f64-debug [(a (dyn Allocator)) (bits i64)] (-> (slice u8))
  (let [absbits (primitive/iand bits 9223372036854775807)
        sign (= (primitive/cast i64 (primitive/ishr (primitive/cast u64 bits) 63)) (primitive/cast i64 1))
        expfield (primitive/iand (primitive/cast i64 (primitive/ishr (primitive/cast u64 bits) 52)) 2047)
        mant (primitive/iand bits 4503599627370495)]
    (if (= expfield (primitive/cast i64 2047))
        (if (!= mant (primitive/cast i64 0)) "NaN" (if sign "-inf" "inf"))
        (if (= absbits (primitive/cast i64 0))
            (if sign "-0.0" "0.0")
            (let [absx (bits->f64 absbits)
                  buf (primitive/alloc-stack (array u8 64))
                  bp (primitive/cast (ptr i8) buf)
                  ep (primitive/alloc-stack (ptr i8))
                  (mut p) 1
                  (mut done) false]
              ; shortest p whose %.*e round-trips
              (loop (if (or (load done) (> (load p) (primitive/cast i64 17)))
                        (break)
                        (do
                          (snprintf bp 64 c"%.*e" (primitive/cast i32 (primitive/isub (load p) 1)) absx)
                          (if (= (f64-bits (strtod bp ep)) absbits)
                              (do (set! done true) 0)
                              (do (set! p (primitive/iadd (load p) 1)) 0)))))
              ; buf now holds "d[.ddd]e±XX" for the shortest p; parse into digits + E
              (let [(mut ei) 0]
                (loop (if (= (primitive/cast i64 (load (primitive/index bp (load ei)))) (primitive/cast i64 101))
                          (break)
                          (set! ei (primitive/iadd (load ei) 1))))
                (let [(mut ds) (char1 a (primitive/cast i64 (load (primitive/index bp 0))))]
                  (when (> (load ei) (primitive/cast i64 1))
                    (let [(mut k) 2]
                      (loop (if (>= (load k) (load ei))
                                (break)
                                (do
                                  (store! ds
                                          (sconcat a
                                                   (load ds)
                                                   (char1 a (primitive/cast i64 (load (primitive/index bp (load k)))))))
                                  (store! k (primitive/iadd (load k) 1)))))))
                  (let [(mut ecur) (primitive/iadd (load ei) 2)
                        (mut emag) 0]
                    (loop (let [c (primitive/cast i64 (load (primitive/index bp (load ecur))))]
                            (if (= c (primitive/cast i64 0))
                                (break)
                                (do
                                  (set! emag (primitive/iadd (primitive/imul (load emag) 10) (primitive/isub c 48)))
                                  (set! ecur (primitive/iadd (load ecur) 1))))))
                    (let [esignc (primitive/cast i64 (load (primitive/index bp (primitive/iadd (load ei) 1))))
                          ee (if (= esignc (primitive/cast i64 45)) (primitive/isub 0 (load emag)) (load emag))
                          ; strip trailing zeros from the significand
                          (mut dlen) (len (load ds))]
                      (loop (if (<= (load dlen) (primitive/cast i64 1))
                                (break)
                                (if (= (primitive/cast i64 (get (load ds) (primitive/isub (load dlen) 1)))
                                       (primitive/cast i64 48))
                                    (set! dlen (primitive/isub (load dlen) 1))
                                    (break))))
                      (let [dg (subslice (load ds) 0 (load dlen))
                            k (load dlen)
                            point (primitive/iadd ee 1)
                            body
                              (cond (or (< ee (primitive/cast i64 -4)) (>= ee (primitive/cast i64 16)))  ; exponential: d1[.rest]e<E>
                                      (sconcat a
                                               (sconcat a
                                                        (if (> k (primitive/cast i64 1))
                                                            (sconcat a
                                                                     (sconcat a (subslice dg 0 1) ".")
                                                                     (subslice dg 1 k))
                                                            (subslice dg 0 1))
                                                        "e")
                                               (if (< ee (primitive/cast i64 0))
                                                   (sconcat a "-" (i64->str a (primitive/isub 0 ee)))
                                                   (i64->str a ee)))
                                    ; fixed: always at least one fractional digit
                                    (<= point (primitive/cast i64 0))
                                      (sconcat a (sconcat a "0." (nzeros a (primitive/isub 0 point))) dg)
                                    (>= point k) (sconcat a (sconcat a dg (nzeros a (primitive/isub point k))) ".0")
                                    :else (sconcat a (sconcat a (subslice dg 0 point) ".") (subslice dg point k)))]
                        (if sign (sconcat a "-" body) body)))))))))))

; ---- Sexp Display, for error interpolation ----
(defn sexp-display [(a (dyn Allocator)) (s Sexp)] (-> (slice u8))
  (let [tg (sx-tag s)]
    (cond (= tg (primitive/cast i64 0)) (i64->str a (sx-ival s))
          (= tg (primitive/cast i64 2)) (sx-sval s)
          (= tg (primitive/cast i64 3)) (sconcat a ":" (sx-sval s))
          (= tg (primitive/cast i64 4)) (sconcat a (sconcat a "\"" (dbg-escape a (sx-sval s))) "\"")
          (= tg (primitive/cast i64 5)) (sconcat a (sconcat a "c\"" (dbg-escape a (sx-sval s))) "\"")
          (= tg (primitive/cast i64 6)) (seq-display a (sx-items s) 40 41)
          (= tg (primitive/cast i64 7)) (seq-display a (sx-items s) 91 93)
          ; a KView (tag 8) displays as the list it denotes — read through its
          ; own payload, never sx-items (deliberately NULL for views)
          (= tg (primitive/cast i64 8))
            (let [sp (primitive/alloc-stack Sexp)]
              (store! sp s)
              (match (load (field sp kind))
                (KView [vit voff vlen] (seq-display-window a vit voff vlen 40 41))
                (_ "")))
          :else  ; Float (tag 1) Display is the shortest-round-trip f64 decimal.
          ; The KFloat carries the raw bit pattern (sx-ival); f64-debug reproduces it.
          (f64-debug a (sx-ival s)))))

(defn seq-display-window [(a (dyn Allocator))
                          (items (ptr (ArrayList Sexp)))
                          (off i64)
                          (len i64)
                          (open i64)
                          (close i64)] (-> (slice u8))
  (let [(mut acc) (char1 a open)
        (mut i) 0]
    (loop (if (>= (load i) len)
              (break)
              (do
                (when (> (load i) (primitive/cast i64 0)) (store! acc (sconcat a (load acc) " ")) 0)
                (set! acc (sconcat a (load acc) (sexp-display a (sx-at items (primitive/iadd off (load i))))))
                (set! i (primitive/iadd (load i) 1)))))
    (sconcat a (load acc) (char1 a close))))

(defn seq-display [(a (dyn Allocator)) (items (ptr (ArrayList Sexp))) (open i64) (close i64)] (-> (slice u8))
  (let [(mut acc) (char1 a open)
        n (sx-len items)
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (when (> (load i) (primitive/cast i64 0)) (store! acc (sconcat a (load acc) " ")) 0)
                (set! acc (sconcat a (load acc) (sexp-display a (sx-at items (load i)))))
                (set! i (primitive/iadd (load i) 1)))))
    (sconcat a (load acc) (char1 a close))))

; ---- diagnostics ----
(defn derr [(msg (slice u8))] (-> Diag)
  (mk-diag -1 -1 msg))

(defn derr-at [(lo i64) (hi i64) (msg (slice u8))] (-> Diag)
  (mk-diag lo hi msg))

(defn derr-at-src [(source i64) (lo i64) (hi i64) (msg (slice u8))] (-> Diag)
  (mk-diag-src source lo hi msg))

; Fill in whatever the inner diagnostic left unset, from the enclosing node.
; Span and source are INDEPENDENT: `derr-at` pins a precise span but cannot know
; which file it is in, so a diag with a real span still needs its source stamped.
; Guarding the source store on `lo < 0` would leave those attributed to nothing.
(defn dwspan [(d Diag) (source i64) (lo i64) (hi i64) (ctxt i64)] (-> Diag)
  (let [p (primitive/alloc-stack Diag)]
    (set! p d)
    (when (< (load (field p lo)) (primitive/cast i64 0))
      (store! (field p lo) lo)
      (store! (field p hi) hi)
      (store! (field p ctxt) ctxt))
    (when (< (load (field p source)) (primitive/cast i64 0)) (store! (field p source) source))
    (load p)))

; ---- Option -> Result with a message (mirrors `.ok_or(msg)?`) ----
(defn need [T] [(o (Option T)) (msg (slice u8))] (-> (Result T Diag))
  (match o (Some [v] (Ok v)) (None [] (Err (derr msg)))))

; ---- matchers ----
(defn as-list [(s Sexp) (msg (slice u8))] (-> (Result (ptr (ArrayList Sexp)) Diag))
  (if (= (sx-tag s) (primitive/cast i64 6)) (Ok (sx-items s)) (Err (derr-at (sx-lo s) (sx-hi s) msg))))

(defn head-sym [(a (dyn Allocator)) (items (ptr (ArrayList Sexp)))] (-> (Result (slice u8) Diag))
  (if (= (sx-len items) (primitive/cast i64 0))
      (Err (derr "empty list"))
      (let [h (sx-at items 0)]
        (if (= (sx-tag h) (primitive/cast i64 2))
            (Ok (sx-sval h))
            (Err (derr-at (sx-lo h) (sx-hi h) (sconcat a "expected a symbol head, got " (sexp-display a h))))))))

(defn sym-of [(a (dyn Allocator)) (s Sexp) (what (slice u8))] (-> (Result (slice u8) Diag))
  (if (= (sx-tag s) (primitive/cast i64 2))
      (Ok (sx-sval s))
      (Err (derr-at (sx-lo s) (sx-hi s) (sconcat a what (sconcat a ": expected symbol, got " (sexp-display a s)))))))

; `sym-of` for a position that names a BINDING rather than a piece of data: same
; validation, but the identifier keeps its lexical identity instead of collapsing
; to its display spelling. A position that takes the spelling can only be matched
; by spelling — which is how a template-generated `deftrait` became invisible to
; the `impl` in its own template (tests/compiler/hygiene/lib9.coil).
(defn lexical-sym-of [(a (dyn Allocator)) (s Sexp) (what (slice u8))] (-> (Result (slice u8) Diag))
  (if (= (sx-tag s) (primitive/cast i64 2))
      (Ok (lexical-name a s))
      (Err (derr-at (sx-lo s) (sx-hi s) (sconcat a what (sconcat a ": expected symbol, got " (sexp-display a s)))))))

(defn kw-of [(a (dyn Allocator)) (s Sexp) (what (slice u8))] (-> (Result (slice u8) Diag))
  (if (= (sx-tag s) (primitive/cast i64 3))
      (Ok (sx-sval s))
      (Err (derr-at (sx-lo s) (sx-hi s) (sconcat a what (sconcat a ": expected keyword, got " (sexp-display a s)))))))

(defn int-val [(a (dyn Allocator)) (s Sexp) (what (slice u8))] (-> (Result i64 Diag))
  (if (= (sx-tag s) (primitive/cast i64 0))
      (Ok (sx-ival s))
      (Err (derr-at (sx-lo s) (sx-hi s) (sconcat a what (sconcat a ": expected an integer, got " (sexp-display a s)))))))

(defn pow2 [(s (Option Sexp))] (-> (Result i64 Diag))
  (match s
    (Some [x]
          (if (and (= (sx-tag x) (primitive/cast i64 0))
                   (let [n (sx-ival x)]
                     (and (> n (primitive/cast i64 0))
                          (= (primitive/iand n (primitive/isub n 1))
                             (primitive/cast i64 0)))))
              (Ok (sx-ival x))
              (Err (derr "alignment must be a positive power of two"))))
    (None [] (Err (derr "alignment must be a positive power of two")))))

(defn sym-vec [(a (dyn Allocator)) (s Sexp) (what (slice u8))] (-> (Result (ptr (ArrayList (slice u8))) Diag))
  (if (= (sx-tag s) (primitive/cast i64 7))
      (try (let [items (sx-items s)
                 (mut out) (al-new [(slice u8)] a)
                 n (sx-len items)
                 (mut i) 0]
             (loop (if (>= (load i) n)
                       (break)
                       (do
                         (push! (mut out)
                                (match (sym-of a (sx-at items (load i)) what)
                                  (Ok [temporary] temporary)
                                  (Err [temporary] (break :try (Err temporary)))))
                         (store! i (primitive/iadd (load i) 1)))))
             (Ok (box-al [(slice u8)] a (load out)))))
      (Err [(ptr (ArrayList (slice u8))) Diag]
           (derr-at (sx-lo s) (sx-hi s) (sconcat a what (sconcat a ": expected vector, got " (sexp-display a s)))))))

(defn need-vec [(o (Option Sexp)) (msg (slice u8))] (-> (Result (ptr (ArrayList Sexp)) Diag))
  (match o
    (Some [s] (if (= (sx-tag s) (primitive/cast i64 7)) (Ok (sx-items s)) (Err (derr msg))))
    (None [] (Err (derr msg)))))

(defstruct Two [(x Sexp) (y Sexp)])

(defn need-two [(a (dyn Allocator)) (args (ptr (ArrayList Sexp))) (head (slice u8))] (-> (Result Two Diag))
  (if (!= (sx-len args) (primitive/cast i64 2))
      (Err (derr (sconcat a head ": expects exactly 2 arguments")))
      (Ok (let [p (primitive/alloc-stack Two)]
            (set! (.x p) (sx-at args 0))
            (set! (.y p) (sx-at args 1))
            (load p)))))

; ---- types ----
(defn type-int-bits [(t Type)] (-> i64)
  (match t
    (TInt [b s] b)
    (TFloat [_] -1)
    (TBool [] -1)
    (TVoid [] -1)
    (TPtr [_] -1)
    (TRef [_ _] -1)
    (TStruct [_] -1)
    (TArray [_ _] -1)
    (TSlice [_] -1)
    (TVec [_ _] -1)
    (TFn [_ _ _] -1)
    (TApp [_ _] -1)
    (TNever [] -1)
    (TCode [] -1)
    (TCodeBuilder [] -1)
    (TExternRef [] -1)))

(defn not-int-diag [(a (dyn Allocator)) (name (slice u8))] (-> Diag)
  (derr (sconcat3 a "not an int type '" name "'")))

(defn int-type [(a (dyn Allocator)) (name (slice u8))] (-> (Result Type Diag))
  (let [n (len name)]
    (if (= n (primitive/cast i64 0))
        (Err (not-int-diag a name))
        (let [c0 (primitive/cast i64 (get name 0))
              signed (if (= c0 (primitive/cast i64 105)) 1 (unless (= c0 (primitive/cast i64 117)) -1))]
          (if (or (< signed (primitive/cast i64 0)) (= n (primitive/cast i64 1)))
              (Err (not-int-diag a name))
              (let [(mut bits) 0
                    (mut bad) false
                    (mut over) false
                    (mut i) 1]
                (loop (if (>= (load i) n)
                          (break)
                          (let [c (primitive/cast i64 (get name (load i)))]
                            (if (and (>= c (primitive/cast i64 48)) (<= c (primitive/cast i64 57)))
                                (do
                                  (set! bits (primitive/iadd (primitive/imul (load bits) 10) (primitive/isub c 48)))
                                  (when (> (load bits) (primitive/cast i64 4294967295)) (store! over true) 0)
                                  (set! i (primitive/iadd (load i) 1)))
                                (do (set! bad true) (break))))))
                (cond (load bad) (Err (not-int-diag a name))
                      (load over) (Err (derr (sconcat3 a "int width too large in '" name "'")))
                      (or (= (load bits) (primitive/cast i64 0)) (> (load bits) (primitive/cast i64 65535)))
                        (Err (derr (sconcat3 a "int width out of range in '" name "' (1..=65535)")))
                      :else (Ok (TInt (load bits) (= signed (primitive/cast i64 1)))))))))))

; The C machine word: `size_t`/`ssize_t`/`long`/`intptr_t` — i32 on wasm32 (ILP32),
; i64 on LP64 (arm64/x86-64). Resolved HERE, at parse, because the target is fixed and
; already set (driver's set-target-arch! runs before the pipeline parses anything). So
; `usize`/`isize` are plain `TInt`s downstream — visible to generic instantiation and
; needing no backend/checker/mono change. On a 64-bit target `isize` == `:i64` exactly,
; so migrating the prelude's `:i64` size args to `isize` is byte-identical on native.
(defn target-word-bits [] (-> i64)
  (let [a (target-arch-str)] (if (or (= a "wasm32") (= a "riscv32")) 32 64)))

(defn prim-type [(a (dyn Allocator)) (name (slice u8))] (-> (Result Type Diag))
  (cond (= name "f32") (Ok (TFloat 32))
        (= name "f64") (Ok (TFloat 64))
        (= name "bool") (Ok (TBool))
        (= name "void") (Ok (TVoid))
        (= name "externref") (Ok (TExternRef))
        (= name "usize") (Ok (TInt (target-word-bits) false))
        (= name "isize") (Ok (TInt (target-word-bits) true))
        :else (int-type a name)))

(defn parse-types [(a (dyn Allocator)) (items (ptr (ArrayList Sexp)))] (-> (Result (ptr (ArrayList Type)) Diag))
  (try (let [(mut out) (al-new [Type] a)
             n (sx-len items)
             (mut i) 0]
         (loop (if (>= (load i) n)
                   (break)
                   (do
                     (push! (mut out)
                            (match (parse-type a (sx-at items (load i)))
                              (Ok [temporary] temporary)
                              (Err [temporary] (break :try (Err temporary)))))
                     (store! i
                             (primitive/iadd (load i) 1)))))
         (Ok (box-al [Type] a (load out))))))

(defn parse-type [(a (dyn Allocator)) (s Sexp)] (-> (Result Type Diag))
  (match (parse-type-inner a s)
    (Err [d] (Err (dwspan d (sx-source s) (sx-lo s) (sx-hi s) (sx-ctxt s))))
    (Ok [t] (Ok t))))

(defn parse-type-inner [(a (dyn Allocator)) (s Sexp)] (-> (Result Type Diag))
  (let [tg (sx-tag s)
        slo (sx-lo s)
        shi (sx-hi s)]
    (cond (= tg (primitive/cast i64 3)) (prim-type a (sx-sval s))
          (= tg (primitive/cast i64 2))
            (let [k (sx-sval s)]
              (if (pack-name? k)
                  (Ok (pack-type a k))
                  (if (= k "Code")
                      (Ok (TCode))
                      (if (= k "CodeBuilder")
                          (Ok (TCodeBuilder))
                          (try (let [t (try-or! (prim-type a k) (Ok (TStruct (lexical-name a s))))] (Ok t)))))))
          (= tg (primitive/cast i64 6)) (parse-type-list a (sx-items s))
          :else (Err (derr-at slo shi (sconcat a "unsupported type: " (sexp-display a s)))))))

(defn parse-type-list [(a (dyn Allocator)) (items (ptr (ArrayList Sexp)))] (-> (Result Type Diag))
  (try (let [head (try! (head-sym a items))]
         (cond (= head "mut")
                 (Ok (TRef true
                           (box-type a
                                     (try! (parse-type a
                                                       (try! (need [Sexp] (sx-get items 1) "mut: expects (mut TYPE)")))))))
               (= head "ref")
                 (Ok (TRef false
                           (box-type a
                                     (try! (parse-type a
                                                       (try! (need [Sexp] (sx-get items 1) "ref: expects (ref TYPE)")))))))
               (= head "ptr")
                 (Ok (TPtr (box-type a
                                     (match (sx-get items 1)
                                       (Some [t] (try! (parse-type a t)))
                                       (None [] (TInt 64 true))))))
               (= head "array")
                 (let [elem
                         (box-type a
                                   (try! (parse-type a
                                                     (try! (need [Sexp]
                                                                 (sx-get items 1)
                                                                 "array type: missing element type")))))]
                   (match (sx-get items 2)
                     (None []
                           (Err [Type Diag]
                                (derr "array type: missing length; write (array T N) with N a literal integer")))
                     (Some [ls]
                           (if (!= (sx-tag ls) (primitive/cast i64 0))
                               (Err [Type Diag]
                                    (derr "array length must be a literal integer (const generics are not supported)"))
                               (if (<= (sx-ival ls) (primitive/cast i64 0))
                                   (Err [Type Diag] (derr "array type: expected a positive length"))
                                   (Ok (TArray elem (sx-ival ls))))))))
               (= head "slice")
                 (Ok (TSlice (box-type a
                                       (try! (parse-type a
                                                         (try! (need [Sexp]
                                                                     (sx-get items 1)
                                                                     "slice type: missing element type")))))))
               (= head "vec")
                 (let [elem
                         (box-type a
                                   (try! (parse-type a
                                                     (try! (need [Sexp]
                                                                 (sx-get items 1)
                                                                 "vec type: missing element type")))))
                       nn (if (opt-is-pos-int (sx-get items 2)) (opt-int (sx-get items 2)) -1)]
                   (if (< nn (primitive/cast i64 0))
                       (Err [Type Diag] (derr "vec type: expected a positive lane count"))
                       (Ok (TVec elem nn))))
               (= head "struct")
                 (Ok (TStruct (try! (sym-of a
                                            (try! (need [Sexp]
                                                        (sx-get items 1)
                                                        "struct type: missing name"))
                                            "struct name"))))
               (= head "dyn")
                 (Ok (TStruct (sconcat a
                                       (try! (sym-of a
                                                     (try! (need [Sexp]
                                                                 (sx-get items 1)
                                                                 "dyn type: expected (dyn Trait)"))
                                                     "dyn trait name"))
                                       "-dyn")))
               (= head "fnptr")
                 (let [cc
                         (try! (sym-of a
                                       (try! (need [Sexp]
                                                   (sx-get items 1)
                                                   "fnptr type: missing convention"))
                                       "fnptr cc"))
                       pv
                         (try! (need-vec (sx-get items 2)
                                         "fnptr type: expected a vector of parameter types"))
                       params (try! (parse-types a pv))
                       ret
                         (box-type a
                                   (try! (parse-type a
                                                     (try! (need [Sexp]
                                                                 (sx-get items 3)
                                                                 "fnptr type: missing return type")))))]
                   (Ok (TFn
                         :cc cc
                         :params params
                         :ret ret)))
               :else
                 (Ok (TApp (lexical-name a (sx-at items 0))
                           (try! (parse-types a (rest-from a items 1)))))))))

; ---- type parameters ----
; ONE type-parameter entry: a bare `T`, or `(T Trait…)` carrying bounds. Shared by
; `defn`'s `[T (U Ord)]` vector and `impl`'s, so the two spellings cannot drift apart.
(defstruct TPEntry [(name (slice u8)) (traits (ptr (ArrayList (slice u8))))])

(defn mk-tpentry [(a (dyn Allocator)) (nm (slice u8)) (traits (ptr (ArrayList (slice u8))))] (-> TPEntry)
  (let [r (primitive/alloc-stack TPEntry)] (set! (.name r) nm) (set! (.traits r) traits) (load r)))

(defn parse-tparam-entry [(a (dyn Allocator)) (entry Sexp)] (-> (Result TPEntry Diag))
  (try (if (= (sx-tag entry) (primitive/cast i64 2))
           (Ok (mk-tpentry a (lexical-name a entry) (box-al [(slice u8)] a (al-new [(slice u8)] a))))
           (if (= (sx-tag entry) (primitive/cast i64 6))
               (let [eitems (sx-items entry)
                     pnamef (try! (need [Sexp] (sx-get eitems 0) "type parameter: empty () bound"))
                     _pname-check (try! (sym-of a pnamef "type parameter"))
                     pname (lexical-name a pnamef)
                     (mut traits) (al-new [(slice u8)] a)
                     tn (sx-len eitems)
                     (mut ti) 1]
                 (loop (if (>= (load ti) tn)
                           (break)
                           (do
                             ; a trait named in a BOUND is a reference like any
                             ; other; keeping only its spelling made a bound in a
                             ; template resolve at the call site
                             (push! (mut traits)
                                    (match (lexical-sym-of a (sx-at eitems (load ti)) "bound trait")
                                      (Ok [temporary] temporary)
                                      (Err [temporary] (break :try (Err temporary)))))
                             (store! ti (primitive/iadd (load ti) 1)))))
                 (Ok (mk-tpentry a pname (box-al [(slice u8)] a (load traits)))))
               (Err [TPEntry Diag]
                    (derr-at (sx-lo entry) (sx-hi entry) "type parameter must be a name or (name Trait…)"))))))

(defstruct TPResult [(params (ptr (ArrayList (slice u8)))) (bounds (ptr (ArrayList Bound))) (consumed bool)])

(defn parse-type-params [(a (dyn Allocator)) (rest (ptr (ArrayList Sexp))) (i i64)] (-> (Result TPResult Diag))
  (try (let [a0 (sx-get rest i)
             a1 (sx-get rest (primitive/iadd i 1))]
         (if (not (and (opt-is-vec a0) (opt-is-vec a1)))
             (Ok (let [r (primitive/alloc-stack TPResult)]
                   (store! (field r params) (box-al [(slice u8)] a (al-new [(slice u8)] a)))
                   (store! (field r bounds) (box-al [Bound] a (al-new [Bound] a)))
                   (store! (field r consumed) false)
                   (load r)))
             (let [tp (sx-items (opt-get a0))
                   (mut params) (al-new [(slice u8)] a)
                   (mut bounds) (al-new [Bound] a)
                   n (sx-len tp)
                   (mut k) 0]
               (loop (if (>= (load k) n)
                         (break)
                         (let [entry (sx-at tp (load k))]
                           (store! k (primitive/iadd (load k) 1))
                           (let [ep (primitive/alloc-stack TPEntry)]
                             (store! ep
                                     (match (parse-tparam-entry a entry)
                                       (Ok [value] value)
                                       (Err [error] (break :try (Err error)))))
                             (push! (mut params) (load (field ep name)))
                             (when (> (len (load (load (field ep
                                                              traits))))
                                      (primitive/cast i64 0))
                               (let [bp (primitive/alloc-stack Bound)]
                                 (store! (field bp name) (load (field ep name)))
                                 (store! (field bp traits) (load (field ep traits)))
                                 (push! (mut bounds) (load bp))
                                 0))))))
               (Ok (let [r (primitive/alloc-stack TPResult)]
                     (store! (field r params) (box-al [(slice u8)] a (load params)))
                     (store! (field r bounds) (box-al [Bound] a (load bounds)))
                     (store! (field r consumed) true)
                     (load r))))))))

; ---- quasiquote ----
(defn build-quasi-seq [(a (dyn Allocator)) (items (ptr (ArrayList Sexp))) (isvec bool)] (-> (Result Quasi Diag))
  (try (let [(mut out) (al-new [Quasi] a)
             n (sx-len items)
             (mut i) 0]
         (loop (if (>= (load i) n)
                   (break)
                   (do
                     (push! (mut out)
                            (match (build-quasi a (sx-at items (load i)))
                              (Ok [temporary] temporary)
                              (Err [temporary] (break :try (Err temporary)))))
                     (store! i
                             (primitive/iadd (load i) 1)))))
         (Ok (if isvec (QVector (box-al [Quasi] a (load out))) (QList (box-al [Quasi] a (load out))))))))

(defn build-quasi [(a (dyn Allocator)) (s Sexp)] (-> (Result Quasi Diag))
  (let [tg (sx-tag s)]
    (if (= tg (primitive/cast i64 6))
        (let [items (sx-items s)]
          (if (= (sx-len items) (primitive/cast i64 2))
              (let [h (sx-at items 0)]
                (if (= (sx-tag h) (primitive/cast i64 2))
                    (let [hs (sx-sval h)]
                      (if (= hs "unquote")
                          (match (parse-expr a (sx-at items 1))
                            (Err [d] (Err d))
                            (Ok [e] (Ok (QUnquote (box-expr a e)))))
                          (if (= hs "unquote-splicing")
                              (match (parse-expr a (sx-at items 1))
                                (Err [d] (Err d))
                                (Ok [e] (Ok (QSplice (box-expr a e)))))
                              (build-quasi-seq a items false))))
                    (build-quasi-seq a items false)))
              (build-quasi-seq a items false)))
        (if (= tg (primitive/cast i64 7))
            (build-quasi-seq a (sx-items s) true)
            (Ok (QLit (box-sexp a s)))))))

; ---- expressions ----
(defn mk-bin [(a (dyn Allocator)) (args (ptr (ArrayList Sexp))) (head (slice u8)) (op i64)] (-> (Result ExprKind Diag))
  (try (let [tp (primitive/alloc-stack Two)]
         (store! tp (match (need-two a args head) (Ok [value] value) (Err [error] (break :try (Err error)))))
         (Ok (EBin
               :op op
               :lhs (box-expr a (try! (parse-expr a (load (field tp x)))))
               :rhs (box-expr a (try! (parse-expr a (load (field tp y))))))))))

(defn mk-cmp [(a (dyn Allocator)) (args (ptr (ArrayList Sexp))) (head (slice u8)) (op i64)] (-> (Result ExprKind Diag))
  (try (let [tp (primitive/alloc-stack Two)]
         (store! tp (match (need-two a args head) (Ok [value] value) (Err [error] (break :try (Err error)))))
         (Ok (ECmp
               :op op
               :lhs (box-expr a (try! (parse-expr a (load (field tp x)))))
               :rhs (box-expr a (try! (parse-expr a (load (field tp y))))))))))

(defn binop-of [(h (slice u8))] (-> i64)
  (cond (= h "iadd") 0
        (= h "isub") 1
        (= h "imul") 2
        (= h "idiv") 3
        (= h "irem") 4
        (= h "udiv") 5
        (= h "urem") 6
        (= h "iand") 7
        (= h "ior") 8
        (= h "ixor") 9
        (= h "ishl") 10
        (= h "ishr") 11
        (= h "rotl") 12
        (= h "rotr") 13
        (= h "mulhi") 14
        (= h "iadd-overflow?") 15
        (= h "isub-overflow?") 16
        (= h "imul-overflow?") 17
        (= h "fadd") 0
        (= h "fsub") 1
        (= h "fmul") 2
        (= h "fdiv") 3
        (= h "frem") 4
        :else -1))

(defn cmpop-of [(h (slice u8))] (-> i64)
  (cond (= h "fcmp-lt") 0
        (= h "fcmp-le") 1
        (= h "fcmp-gt") 2
        (= h "fcmp-ge") 3
        (= h "fcmp-eq") 4
        (= h "fcmp-ne") 5
        (= h "icmp-lt") 0
        (= h "icmp-le") 1
        (= h "icmp-gt") 2
        (= h "icmp-ge") 3
        (= h "icmp-eq") 4
        (= h "icmp-ne") 5
        :else -1))

(defn codeop-of [(h (slice u8))] (-> i64)
  (cond (= h "code-list?") 0
        (= h "code-sym?") 1
        (= h "code-int?") 2
        (= h "code-count") 3
        (= h "code-nth") 4
        (= h "code-sym") 5
        (= h "code-int") 6
        (= h "code-rest") 7
        (= h "code-eq") 10
        (= h "code-keyword?") 11
        (= h "code-symbol") 12
        (= h "code-str") 13
        (= h "code-field-count") 14
        (= h "code-field-name") 15
        (= h "code-field-kind") 16
        (= h "code-field-type") 17
        ; the field's type name, QUALIFIED — for building symbols in generated code
        (= h "code-field-qtype") 50
        (= h "code-type-shape") 75
        (= h "code-session-state") 76
        (= h "code-session-stage!") 77
        (= h "code-session-monomorphs") 78
        (= h "code-session-condition!") 79
        (= h "code-session-rejected-state") 80
        ; `(code-deriver TRAIT TYPE)` — the deriver REGISTERED for TRAIT, already
        ; picked for TYPE's shape (comptime.coil: cop-deriver). Answered from the
        ; registration table, never from the deriver's name.
        (= h "code-deriver") 51
        (= h "code-vector?") 54
        (= h "code-float?") 55
        (= h "code-float-bits") 56
        (= h "code-exported?") 57
        (= h "code-read") 59
        (= h "code-list-new") 60
        (= h "code-list-push!") 61
        ; freeze a CodeBuilder into Code (identity at runtime; the type is the
        ; point — docs/design/META_MEMORY.md phase 4)
        (= h "code-list-done") 62
        (= h "code-list-like") 74
        ; O(1) views + the two ops that SAY they copy (META_MEMORY phase 5)
        (= h "code-slice") 63
        (= h "code-copy") 64
        (= h "code-concat") 65
        (= h "fresh-identifier") 66
        (= h "datum->syntax") 67
        (= h "syntax->datum") 68
        (= h "free-identifier=?") 69
        (= h "bound-identifier=?") 70
        ; 66-70 were taken by the hygiene ops on main while the staged-
        ; metacompilation branch was numbering these 66-68; they are renumbered
        ; here, and every consumer (check.coil, comptime.coil) with them.
        (= h "code-opaque") 71
        (= h "code-from-opaque") 72
        (= h "code-string?") 73
        (= h "code-variant-sum") 18
        (= h "code-variant-count") 19
        (= h "code-variant-name") 20
        (= h "code-variant-fields") 21
        ; the variant's FULLY-QUALIFIED name. `code-variant-name` (20) strips the
        ; qualifier, which is right for display and wrong for CODE GENERATION: an arm
        ; built from a bare name only resolves where the sum happens to be imported
        ; unqualified, so a macro emitting one produced code whose validity depended on
        ; the caller's import style.
        (= h "code-variant-qname") 49
        (= h "code-variant-field-name") 47
        (= h "code-variant-field-type") 48
        (= h "code-trait-method-count") 22
        (= h "code-trait-method-name") 23
        (= h "code-trait-arity") 24
        (= h "code-trait-param-name") 25
        (= h "code-trait-param-type") 26
        (= h "code-trait-ret-type") 27
        (= h "str-bytes") 28
        (= h "bytes->str") 29
        (= h "int->str") 38
        :else -1))

(defn typequery-of [(h (slice u8))] (-> i64)
  (cond (= h "field-count") 0
        (= h "variant-count") 1
        (= h "struct?") 2
        (= h "sum?") 3
        (= h "int?") 4
        (= h "float?") 5
        (= h "ptr?") 6
        (= h "array?") 7
        :else -1))

(defn fieldmeta-of [(h (slice u8))] (-> i64)
  (cond (= h "field-name") 0 (= h "field-type-kind") 1 (= h "field-type-name") 2 :else -1))

(defn alloc-form [(a (dyn Allocator)) (args (ptr (ArrayList Sexp))) (storage i64)] (-> (Result ExprKind Diag))
  (try (let [n (sx-len args)]
         (if (or (< n (primitive/cast i64 1))
                 (> n (if (= storage (primitive/cast i64 1)) 2 1)))
             (Err [ExprKind Diag]
                  (derr (if (= storage (primitive/cast i64 1))
                            "alloc-static: expects TYPE and an optional INITIAL"
                            "alloc: expects exactly one TYPE")))
             (let [ty (try! (parse-type a (sx-at args 0)))
                   init
                     (if (= n (primitive/cast i64 2))
                         (box-expr a (try! (parse-expr a (sx-at args 1))))
                         (primitive/cast (ptr Expr) 0))]
               (Ok (EAlloc
                     :storage storage
                     :ty ty
                     :init init)))))))

(defn parse-exprs [(a (dyn Allocator)) (items (ptr (ArrayList Sexp)))] (-> (Result (ptr (ArrayList Expr)) Diag))
  (try (let [(mut out) (al-new [Expr] a)
             n (sx-len items)
             (mut i) 0]
         (loop (if (>= (load i) n)
                   (break)
                   (do
                     (push! (mut out)
                            (match (parse-expr a (sx-at items (load i)))
                              (Ok [temporary] temporary)
                              (Err [temporary] (break :try (Err temporary)))))
                     (store! i
                             (primitive/iadd (load i) 1)))))
         (Ok (box-al [Expr] a (load out))))))

; ---- recursion depth guard --------------------------------------------------
; The parser recurses once per nesting LEVEL, and each level is expensive (~75 KB of
; stack: parse-expr-inner is one big match whose per-branch allocas are all hoisted to
; the entry block, so every call pays for every branch). Deeply nested input therefore
; ran off the end of the stack and killed the compiler with a bare SIGBUS/SIGSEGV and
; ZERO output — no message, no location, nothing naming the construct.
;
; Macros make this ordinary rather than exotic: `cond` expands to nested ifs, so an
; 800-clause dispatch table is 800 levels deep, and a derive over a wide struct nests
; the same way. This is a compiler whose whole purpose is generating code, so the depth
; ceiling is a real limit and it must announce itself instead of crashing.
;
; The counter is process-global rather than threaded through every parse entry point:
; the pipeline parses on one thread at a time. The limit sits well under the measured
; stack cliff (see run-on-big-stack) so the diagnostic always wins the race.
(defn parse-depth-cell [] (-> (ptr i64))
  (primitive/alloc-static i64))

(defn parse-depth-limit [] (-> i64)
  2000)

(defn parse-expr [(a (dyn Allocator)) (s Sexp)] (-> (Result Expr Diag))
  (let [d (parse-depth-cell)]
    (set! d (primitive/iadd (load d) 1))
    (if (> (load d) (parse-depth-limit))
        (do
          (set! d (primitive/isub (load d) 1))
          (Err (derr-at (sx-lo s)
                        (sx-hi s)
                        "expression nests more than 2000 levels deep — the parser recurses per level and would run out of stack. If this came from a macro, emit a flatter form (e.g. a jump table or a loop over a data table) instead of one deeply nested expression.")))
        ; the decrement is repeated per arm rather than hoisted into a `let`. gen-9 fixed
        ; the underlying inference hole — a returned let binding now takes the function's
        ; return type `(Result Expr Diag)`, so `(let [r (match …)] (primitive/store! d …) r)` would
        ; type-check under THIS compiler — but the self-host source must stay buildable by
        ; the committed pre-gen-9 seed (rebootstrap stage0), which cannot infer it. Keep the
        ; per-arm form until the seed is refreshed past this commit.
        (match (parse-expr-inner a s)
          (Err [dg]
               (do
                 (set! d (primitive/isub (load d) 1))
                 (Err (dwspan dg (sx-source s) (sx-lo s) (sx-hi s) (sx-ctxt s)))))
          (Ok [kind]
              (do
                (set! d (primitive/isub (load d) 1))
                (Ok (mk-expr-nid kind (sx-lo s) (sx-hi s) (sx-source s) (sx-ctxt s) (sx-nid s)))))))))

(defn parse-expr-inner [(a (dyn Allocator)) (s Sexp)] (-> (Result ExprKind Diag))
  (let [tg (sx-tag s)
        slo (sx-lo s)
        shi (sx-hi s)]
    (cond (= tg (primitive/cast i64 0)) (Ok (EInt (sx-ival s)))
          (= tg (primitive/cast i64 1)) (Ok (EFloat (sx-ival s)))
          (= tg (primitive/cast i64 2))
            (let [nm (sx-sval s)]
              (if (= nm "true")
                  (Ok (EBool true))
                  (if (= nm "false")
                      (Ok (EBool false))
                      (if (and (>= (len nm) 3)
                               (= (primitive/cast i64 (get nm 0)) 35)
                               (= (primitive/cast i64 (get nm 1)) 92))
                          (let [body (subslice nm 2 (len nm))
                                v
                                  (if (= (len body) 1)
                                      (primitive/cast i64 (get body 0))
                                      (char-name-code body))]
                            (if (< v 0)
                                (Err (derr-at slo shi "unknown character literal"))
                                (Ok (EInt v))))
                          (Ok (EVar (lexical-name a s)))))))
          (= tg (primitive/cast i64 3))
          ; Keywords are ordinary values. Lower the literal through core's
          ; nominal Keyword constructor so every later phase sees normal Coil
          ; code rather than a second, compiler-private value representation.
          (let [(mut args) (al-new [Expr] a)]
            (push! (mut args) (mk-expr (EStr (sx-sval s)) slo shi (sx-source s) (sx-ctxt s)))
            (Ok (ECall
                  :func "coil.core.KeywordValue"
                  :type_args (box-al [Type] a (al-new [Type] a))
                  :args (box-al [Expr] a (load args)))))
            (= tg (primitive/cast i64 4))
          (Ok (EStr (sx-sval s))) (= tg (primitive/cast i64 5))
          (Ok (ECStr (sx-sval s))) (= tg (primitive/cast i64 7))
          (match (parse-exprs a (sx-items s))
            (Err [d] (Err [ExprKind Diag] d))
            (Ok [items] (Ok (EArrayLit items))))
            :else
          (parse-list-expr a (sx-items s) slo shi (sx-source s) (sx-ctxt s)))))

; A leading:label keyword.
(defstruct LabelSplit [(label (Option (slice u8))) (rest (ptr (ArrayList Sexp)))])

(defn split-label [(a (dyn Allocator)) (args (ptr (ArrayList Sexp)))] (-> LabelSplit)
  (let [r (primitive/alloc-stack LabelSplit)]
    (if (and (> (sx-len args) (primitive/cast i64 0)) (= (sx-tag (sx-at args 0)) (primitive/cast i64 3)))
        (do
          (set! (.label r) (Some (sx-sval (sx-at args 0))))
          (set! (.rest r) (rest-from a args 1)))
        (do (set! (.label r) (None [(slice u8)])) (set! (.rest r) args)))
    (load r)))

; (let [binds...] body...) — `let` arm.
(defn parse-let [(a (dyn Allocator)) (args (ptr (ArrayList Sexp))) (slo i64) (shi i64)] (-> (Result ExprKind Diag))
  (try (let [bvo (sx-get args 0)]
         (when (not (opt-is-vec bvo))
           (break :try (Err [ExprKind Diag] (derr-at slo shi "let: expected binding vector"))))
         (let [bv (sx-items (opt-get bvo))
               nb (sx-len bv)]
           (when (not (= (primitive/urem nb 2) (primitive/cast i64 0)))
             (break :try (Err [ExprKind Diag] (derr-at slo shi "let: bindings must be name/value pairs"))))
           (let [(mut binds) (al-new [Bind] a)
                 (mut k) 0]
             (loop (if (>= (load k) nb)
                       (break)
                       (let [nmf (sx-at bv (load k))
                             vf (sx-at bv (primitive/iadd (load k) 1))]
                         (let [bp (primitive/alloc-stack Bind)]
                           (store! (field bp bid) 0)
                           (store! (field bp owned_type) (primitive/cast (ptr Type) 0))
                           (if (= (sx-tag nmf) (primitive/cast i64 2))
                               (do
                                 (store! (field bp name) (lexical-name a nmf))
                                 (store! (field bp
                                                mutable)
                                         false))
                               (if (and (= (sx-tag nmf) (primitive/cast i64 6))
                                        (and (= (sx-len (sx-items nmf)) (primitive/cast i64 2))
                                             (= (match (head-sym a (sx-items nmf))
                                                  (Ok [value] value)
                                                  (Err [error] (break :try (Err error))))
                                                "mut")))
                                   (do
                                     (let [bn (sx-at (sx-items nmf) 1)]
                                       (match (sym-of a bn "let binding name")
                                         (Ok [_] (store! (field bp name) (lexical-name a bn)))
                                         (Err [error] (break :try (Err error)))))
                                     (store! (field bp mutable) true))
                                   (return-from :try
                                                  (Err [ExprKind Diag]
                                                       (derr-at (sx-lo nmf)
                                                                (sx-hi nmf)
                                                                (sconcat3 a
                                                                          "let binding name must be `name` or `(mut name)`, got "
                                                                          (sexp-display a nmf)
                                                                          ""))))))
                           (store! (field bp value)
                                   (match (parse-expr a vf)
                                     (Ok [value] value)
                                     (Err [error] (break :try (Err error)))))
                           (push! (mut binds) (load bp)))
                         (store! k (primitive/iadd (load k) 2)))))
             (let [body (try! (parse-exprs a (rest-from a args 1)))]
               (when (= (len (load body)) (primitive/cast i64 0))
                 (break :try (Err [ExprKind Diag] (derr-at slo shi "let: empty body"))))
               (Ok (ELet (box-al [Bind] a (load binds)) body))))))))

; (match scrut arms...) — `match` arm.
;
; `(_ body…)` is the CATCH-ALL arm. It names no variant, so it takes NO bind vector
; (its body starts right after the `_`), and it must be written last — arms after it
; could never run. The checker treats it as covering every variant the explicit arms
; left out, which is what makes an incomplete `match` exhaustive.
(defn parse-match [(a (dyn Allocator)) (args (ptr (ArrayList Sexp))) (slo i64) (shi i64)] (-> (Result ExprKind Diag))
  (try (let [scrut (box-expr a (try! (parse-expr a (try! (need [Sexp] (sx-get args 0) "match: missing scrutinee")))))
             (mut arms) (al-new [Arm] a)
             n (sx-len args)
             (mut i) 1]
         (loop (if (>= (load i) n)
                   (break)
                   (let [arm-s (sx-at args (load i))]
                     (store! i (primitive/iadd (load i) 1))
                     (let [al (try! (as-list arm-s "match arm must be (Variant [binds] body)"))
                           variant (try! (sym-of a (try! (need [Sexp] (sx-get al 0) "arm: missing variant")) "variant"))
                           bvo (sx-get al 1)]
                       (let [wild (= variant "_")]
                         (when (and wild (< (load i) n))
                           (break :try
                                    (Err [ExprKind Diag]
                                         (derr-at (sx-lo arm-s)
                                                  (sx-hi arm-s)
                                                  "match: the `_` arm must come last"))))
                         (when (and (not wild) (not (opt-is-vec bvo)))
                           (break :try
                                    (Err [ExprKind Diag]
                                         (derr-at (sx-lo arm-s)
                                                  (sx-hi arm-s)
                                                  (sconcat3 a "arm '" variant "': expected a bind vector")))))
                         (let [(mut binds) (al-new [(slice u8)] a)
                               nb (if wild 0 (sx-len (sx-items (opt-get bvo))))
                               (mut bi) 0]
                           (loop (if (>= (load bi) nb)
                                     (break)
                                     (do
                                       (let [bn (sx-at (sx-items (opt-get bvo)) (load bi))]
                                         (try! (sym-of a bn "bind"))
                                         (push! (mut binds) (lexical-name a bn)))
                                       (store! bi (primitive/iadd (load bi) 1)))))
                           (let [bodyf (try! (parse-exprs a (rest-from a al (if wild 1 2))))
                                 nbody (len (load bodyf))]
                             (let [body
                                     (if (= nbody (primitive/cast i64 0))
                                         (return-from :try
                                                        (Err [ExprKind Diag]
                                                             (derr-at (sx-lo arm-s)
                                                                      (sx-hi arm-s)
                                                                      (sconcat3 a "arm '" variant "': missing body"))))
                                         (if (= nbody (primitive/cast i64 1))
                                             (get (load bodyf) 0)
                                             (mk-expr (EDo bodyf)
                                                      (sx-lo arm-s)
                                                      (sx-hi arm-s)
                                                      (sx-source arm-s)
                                                      (sx-ctxt arm-s))))]
                               (let [ap (primitive/alloc-stack Arm)]
                                 (store! (field ap variant) variant)
                                 (store! (field ap binds) (box-al [(slice u8)] a (load binds)))
                                 (store! (field ap body) body)
                                 (push! (mut arms) (load ap)))))))))))
         (Ok (EMatch scrut (box-al [Arm] a (load arms)))))))

; (primitive/llvm-ir RESULT [operands] "BODY") — `llvm-ir` arm.
(defn parse-llvm-ir [(a (dyn Allocator)) (args (ptr (ArrayList Sexp))) (slo i64) (shi i64)] (-> (Result ExprKind Diag))
  (try (if (!= (sx-len args) (primitive/cast i64 3))
           (Err [ExprKind Diag]
                (derr-at slo shi "llvm-ir: expects (primitive/llvm-ir RESULT-TYPE [operands...] \"BODY\")"))
           (let [result (try! (parse-type a (sx-at args 0)))
                 ov (sx-at args 1)]
             (when (not (= (sx-tag ov) (primitive/cast i64 7)))
               (break :try
                        (Err [ExprKind Diag]
                             (derr-at (sx-lo ov) (sx-hi ov) "llvm-ir: expected a [operand...] vector"))))
             (let [operands (try! (parse-exprs a (sx-items ov)))
                   bv (sx-at args 2)]
               (when (not (= (sx-tag bv) (primitive/cast i64 4)))
                 (break :try
                          (Err [ExprKind Diag]
                               (derr-at (sx-lo bv) (sx-hi bv) "llvm-ir: body must be a string literal"))))
               (Ok (ELlvmIr
                     :result result
                     :args operands
                     :body (sx-sval bv))))))))

; Heads that are only ever valid at the top level — none of them is also an
; expression head (a definition never nests inside a value), so seeing one in
; expression position is unambiguous. Keep in sync with the top-level dispatch in
; parse-program and the loader's own (module/import/export/cimport) handling.
(defn toplevel-only-head? [(h (slice u8))] (-> bool)
  (cond (= h "defn") true
        (= h "defstruct") true
        (= h "defsum") true
        (= h "defcc") true
        (= h "extern") true
        (= h "export-c") true
        (= h "const") true
        (= h "deftrait") true
        (= h "impl") true
        (= h "static-assert") true
        (= h "meta") true
        (= h "module") true
        (= h "import") true
        (= h "export") true
        (= h "cimport") true
        (= h "reader-provider") true
        :else false))

; A top-level definition in expression position is never legal, and in practice it
; means an earlier form lost a ')' and swallowed this one. Say that, anchored at the
; swallowed definition. Without this the head falls through to the call path and the
; failure surfaces from its parameter list as "unexpected vector in expression" —
; a symptom several lines away from the missing paren, in a form that is itself fine.
(defn nested-toplevel-diag [(a (dyn Allocator)) (head (slice u8)) (args (ptr (ArrayList Sexp))) (slo i64) (shi i64)] (-> Diag)
  (let [named (if (= (sx-len args) (primitive/cast i64 0)) false (= (sx-tag (sx-at args 0)) (primitive/cast i64 2)))
        what (if named (sconcat3 a "'" head (sconcat3 a " " (sx-sval (sx-at args 0)) "'")) (sconcat3 a "'" head "'"))]
    (derr-at slo
             shi
             (sconcat a
                      what
                      " is a top-level definition, but it appears inside an expression — an enclosing form is missing a ')'"))))

; the big head dispatch.
; A bare `:` reads as an empty keyword (KKw ""), so a list whose head is one is the
; type-ascription form `(: value type)` — checked here BEFORE head-sym, which would
; otherwise reject the non-symbol head.
(defn ascribe-head? [(items (ptr (ArrayList Sexp)))] (-> bool)
  (and (> (sx-len items) (primitive/cast i64 0))
       (and (= (sx-tag (sx-at items 0)) (primitive/cast i64 3))
            (= (len (sx-sval (sx-at items 0))) (primitive/cast i64 0)))))

; Parse the `:field value` tail of a named constructor call. Keeping names beside
; expressions in the AST lets the resolver remain syntax-agnostic and gives the
; checker the actual struct/sum definition needed for authoritative validation.
(defn parse-named-call-names [(a (dyn Allocator))
                              (head (slice u8))
                              (args (ptr (ArrayList Sexp)))] (-> (Result (ptr (ArrayList (slice u8))) Diag))
  (try (let [n (sx-len args)
             (mut out) (al-new [(slice u8)] a)
             (mut i) 0]
         (when (!= (primitive/irem n 2) (primitive/cast i64 0))
           (break :try
                    (Err [(ptr (ArrayList (slice u8))) Diag]
                         (derr (sconcat3 a "named constructor '" head "' needs a value after every :field")))))
         (loop (if (>= (load i) n)
                   (break)
                   (let [k (sx-at args (load i))]
                     (when (not (= (sx-tag k) (primitive/cast i64 3)))
                       (break :try
                                (Err [(ptr (ArrayList (slice u8))) Diag]
                                     (derr-at (sx-lo k)
                                              (sx-hi k)
                                              (sconcat3 a "named constructor '" head "' expects :field value pairs")))))
                     (push! (mut out) (sx-sval k))
                     (store! i (primitive/iadd (load i) 2)))))
         (Ok (box-al [(slice u8)] a (load out))))))

(defn parse-named-call-values [(a (dyn Allocator))
                               (args (ptr (ArrayList Sexp)))] (-> (Result (ptr (ArrayList Expr)) Diag))
  (try (let [n (sx-len args)
             (mut out) (al-new [Expr] a)
             (mut i) 1]
         (loop (if (>= (load i) n)
                   (break)
                   (do
                     (push! (mut out)
                            (match (parse-expr a (sx-at args (load i)))
                              (Ok [temporary] temporary)
                              (Err [temporary] (break :try (Err temporary)))))
                     (store! i (primitive/iadd (load i) 2)))))
         (Ok (box-al [Expr] a (load out))))))

(defn parse-call-kind [(a (dyn Allocator))
                       (head (slice u8))
                       (type-args (ptr (ArrayList Type)))
                       (args (ptr (ArrayList Sexp)))] (-> (Result ExprKind Diag))
  (if (and (> (sx-len args) (primitive/cast i64 0))
           (= (sx-tag (sx-at args 0)) (primitive/cast i64 3)))
      (match (parse-named-call-names a head args)
        (Err [d] (Err [ExprKind Diag] d))
        (Ok [names]
            (match (parse-named-call-values a args)
              (Err [d] (Err [ExprKind Diag] d))
              (Ok [values]
                  (Ok [ExprKind Diag]
                      (ENamedCall
                        :func head
                        :type_args type-args
                        :names names
                        :args values))))))
      (match (parse-exprs a args)
        (Err [d] (Err [ExprKind Diag] d))
        (Ok [values]
            (Ok [ExprKind Diag]
                (ECall
                  :func head
                  :type_args type-args
                  :args values))))))

; A vector immediately after a call head used to mean type arguments
; unconditionally. Expression vectors make that position ambiguous, so retain
; the old meaning only when every item has type syntax shape. Constructor calls,
; literals, keywords and nested expression vectors are array elements.
(defn call-type-forms? [(xs (ptr (ArrayList Sexp))) (i i64) (n i64)] (-> bool)
  (if (>= i n)
      true
      (and (call-type-form? (sx-at xs i)) (call-type-forms? xs (+ i 1) n))))

(defn call-type-list? [(xs (ptr (ArrayList Sexp)))] (-> bool)
  (let [n (sx-len xs)]
    (if (= n 0)
        false
        (let [h (sx-at xs 0)]
          (if (not (= (sx-tag h) (primitive/cast i64 2)))
              false
              (let [hn (sx-sval h)]
                (if (and (or (= hn "array") (= hn "vec")) (= n 3))
                    (and (call-type-form? (sx-at xs 1))
                         (= (sx-tag (sx-at xs 2)) (primitive/cast i64 0)))
                    (call-type-forms? xs 1 n))))))))

(defn call-type-form? [(s Sexp)] (-> bool)
  (let [tag (sx-tag s)]
    (cond (= tag (primitive/cast i64 2)) true
          (= tag (primitive/cast i64 3))
            (let [n (sx-sval s)]
              (or (= n "i8")
                  (or (= n "i16")
                      (or (= n "i32")
                          (or (= n "i64")
                              (or (= n "u8")
                                  (or (= n "u16")
                                      (or (= n "u32")
                                          (or (= n "u64")
                                              (or (= n "isize")
                                                  (or (= n "usize")
                                                      (or (= n "f32") (= n "f64")))))))))))))
          (= tag (primitive/cast i64 6)) (call-type-list? (sx-items s))
          (= tag (primitive/cast i64 7)) (let [xs (sx-items s)] (call-type-forms? xs 0 (sx-len xs)))
          :else false)))

(defn call-vector-is-type-args? [(v Sexp)] (-> bool)
  (let [xs (sx-items v)
        n (sx-len xs)
        (mut i) 0
        (mut yes) (> (sx-len xs) 0)]
    (loop (if (>= (load i) n)
              (break)
              (if (call-type-form? (sx-at xs (load i)))
                  (set! i (+ (load i) 1))
                  (do (set! yes false) (break)))))
    (load yes)))

; Variadic short-circuit Boolean forms. Folding here keeps `and`/`or` available to
; the earliest metaprogram bootstrap phases without turning either into an ambient
; callable primitive.
(defn parse-logic [(a (dyn Allocator))
                   (args (ptr (ArrayList Sexp)))
                   (i i64)
                   (n i64)
                   (is-and bool)
                   (slo i64)
                   (shi i64)
                   (ssrc i64)
                   (sctxt i64)] (-> (Result Expr Diag))
  (try (if (>= i n)
           (Ok (mk-expr (EBool is-and) slo shi ssrc sctxt))
           (if (= (primitive/iadd i 1) n)
               (parse-expr a (sx-at args i))
               (let [first (try! (parse-expr a (sx-at args i)))
                     rest (try! (parse-logic a args (primitive/iadd i 1) n is-and slo shi ssrc sctxt))]
                 (Ok (mk-expr (if is-and
                                  (EIf
                                    :cnd (box-expr a first)
                                    :thn (box-expr a rest)
                                    :els (box-expr a (mk-expr (EBool false) slo shi ssrc sctxt)))
                                  (EIf
                                    :cnd (box-expr a first)
                                    :thn (box-expr a (mk-expr (EBool true) slo shi ssrc sctxt))
                                    :els (box-expr a rest)))
                              slo
                              shi
                              ssrc
                              sctxt)))))))

; Parse an expression in a PLACE context. Most place expressions parse normally;
; `.field` is special because its ordinary expression form inserts a load.
(defn dot-field-head? [(h (slice u8))] (-> bool)
  (and (> (len h) (primitive/cast i64 1))
       (and (= (primitive/cast i64 (get h 0)) (primitive/cast i64 46))
            ; `..` is an ordinary core macro, not an accessor head.
            (not (= (primitive/cast i64 (get h 1)) (primitive/cast i64 46))))))

;;; A macro that emits `(set! PLACE V)` hands the expander a `set!` symbol that
;;; hygiene resolves at the quasiquote site — to the coil.core collection trait
;;; method — so the head reaches this parser QUALIFIED and the bare-name
;;; special-form test missed it, turning every macro-emitted place assignment
;;; into a 3-argument trait-call arity error. Two-argument `set!` is reserved for
;;; place assignment language-wide (see the defn-name guard below), so matching
;;; the head's LEAF name is unambiguous.
(defn head-leaf-is-set? [(h (slice u8))] (-> bool)
  (let [n (len h)
        (mut cut) 0
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (when (= (primitive/cast i64 (get h (load i))) (primitive/cast i64 46))
                  (set! cut (primitive/iadd (load i) 1))
                  0)
                (set! i (primitive/iadd (load i) 1)))))
    (= (subslice h (load cut) n) "set!")))

(defn parse-place [(a (dyn Allocator)) (s Sexp)] (-> (Result Expr Diag))
  (try (if (= (sx-tag s) (primitive/cast i64 6))
           (let [items (sx-items s)]
             (let [h (try! (head-sym a items))]
               (if (dot-field-head? h)
                   (if (!= (sx-len items) (primitive/cast i64 2))
                       (Err [Expr Diag]
                            (derr-at (sx-lo s) (sx-hi s) ".field access expects exactly one receiver"))
                       (let [base-expr (try! (parse-place a (sx-at items 1)))
                             fname (subslice h 1 (len h))]
                         (Ok (mk-expr-nid (EField (box-expr a base-expr) fname)
                                          (sx-lo s)
                                          (sx-hi s)
                                          (sx-source s)
                                          (sx-ctxt s)
                                          (sx-nid s)))))
                   (parse-expr a s))))
           (parse-expr a s))))

(defn parse-list-expr [(a (dyn Allocator)) (items (ptr (ArrayList Sexp))) (slo i64) (shi i64) (ssrc i64) (sctxt i64)] (-> (Result ExprKind
                                                                                                                                  Diag))
  (try (if (ascribe-head? items)
           (if (!= (sx-len items) (primitive/cast i64 3))
               (Err [ExprKind Diag] (derr-at slo shi "type ascription: expects (: value type)"))
               (Ok (EAscribe (try! (parse-type a (sx-at items 2))) (box-expr a (try! (parse-expr a (sx-at items 1)))))))
           (let [head-node (sx-at items 0)
                 source-head (try! (head-sym a items))
                 head (match (primitive-dispatch-head head-node) (Some [op] op) (None [] ""))
                 args (rest-from a items 1)
                 nargs (sx-len args)]
             (when (toplevel-only-head? source-head)
               (break :try (Err [ExprKind Diag] (nested-toplevel-diag a source-head args slo shi))))
             (let [bop (binop-of head)]
               (if (>= bop (primitive/cast i64 0))
                   (mk-bin a args head bop)
                   (let [cop (cmpop-of head)]
                     (cond (>= cop (primitive/cast i64 0)) (mk-cmp a args head cop)
                           (or (= head "inot")
                               (or (= head "clz")
                                   (or (= head "ctz")
                                       (or (= head "popcount") (= head "bswap")))))
                             (if (!= nargs (primitive/cast i64 1))
                                 (Err [ExprKind Diag]
                                      (derr-at slo shi (sconcat a head ": expects exactly one argument")))
                                 (Ok (EIntUnary (cond (= head "inot") 0
                                                      (= head "clz") 1
                                                      (= head "ctz") 2
                                                      (= head "popcount") 3
                                                      :else 4)
                                                (box-expr a (try! (parse-expr a (sx-at args 0)))))))
                           (= source-head "and")
                             (let [e (primitive/alloc-stack Expr)]
                               (store! e (try! (parse-logic a args 0 nargs true slo shi ssrc sctxt)))
                               (Ok (load (field e kind))))
                           (= source-head "or")
                             (let [e (primitive/alloc-stack Expr)]
                               (store! e (try! (parse-logic a args 0 nargs false slo shi ssrc sctxt)))
                               (Ok (load (field e kind))))
                           (= source-head "not")
                             (if (!= nargs (primitive/cast i64 1))
                                 (Err [ExprKind Diag] (derr-at slo shi "not: expects (not x)"))
                                 (Ok (EIf
                                       :cnd (box-expr a (try! (parse-expr a (sx-at args 0))))
                                       :thn (box-expr a (mk-expr (EBool false) slo shi ssrc sctxt))
                                       :els (box-expr a (mk-expr (EBool true) slo shi ssrc sctxt)))))
                           (= source-head "if")
                             (if (!= nargs (primitive/cast i64 3))
                                 (Err [ExprKind Diag]
                                      (derr-at slo shi "if: expects (if cond then else)"))
                                 (Ok (EIf
                                       :cnd (box-expr a (try! (parse-expr a (sx-at args 0))))
                                       :thn (box-expr a (try! (parse-expr a (sx-at args 1))))
                                       :els (box-expr a (try! (parse-expr a (sx-at args 2)))))))
                           (= source-head "do") (Ok (EDo (try! (parse-exprs a args))))
                           (= source-head "comptime")
                             (if (!= nargs (primitive/cast i64 1))
                                 (Err [ExprKind Diag]
                                      (derr-at slo shi "comptime: expects (comptime expr)"))
                                 (Ok (EComptime (box-expr a
                                                          (try! (parse-expr a (sx-at args 0)))))))
                           (= source-head "let") (parse-let a args slo shi)
                           (= source-head "call")
                             (let [fs
                                     (try! (need [Sexp]
                                                 (sx-get args 0)
                                                 "call: missing function"))
                                   _fcheck (try! (sym-of a fs "call target"))
                                   f (lexical-name a fs)]
                               (parse-call-kind a
                                                f
                                                (box-al [Type] a (al-new [Type] a))
                                                (rest-from a args 1)))
                           (= head "zeroed")
                             (if (!= nargs (primitive/cast i64 1))
                                 (Err [ExprKind Diag]
                                      (derr-at slo
                                               shi
                                               "zeroed: expects (primitive/zeroed TYPE)"))
                                 (Ok (EZeroed (try! (parse-type a (sx-at args 0))))))
                           (= source-head "mut")
                             (if (!= nargs (primitive/cast i64 1))
                                 (Err [ExprKind Diag]
                                      (derr-at slo
                                               shi
                                               "mut: expects (mut PLACE)"))
                                 (Ok (EBorrow true
                                              (box-expr a
                                                        (try! (parse-place a
                                                                           (sx-at args
                                                                                  0)))))))
                           (dot-field-head? source-head)
                             (if (!= nargs (primitive/cast i64 1))
                                 (Err [ExprKind Diag]
                                      (derr-at slo shi ".field access expects exactly one receiver"))
                                 (let [base-expr (try! (parse-place a (sx-at args 0)))
                                       fname (subslice source-head 1 (len source-head))]
                                   (Ok (ELoad (box-expr a
                                                        (mk-expr (EField (box-expr a base-expr) fname)
                                                                 slo
                                                                 shi
                                                                 ssrc
                                                                 sctxt))))))
                           (and (head-leaf-is-set? source-head) (= nargs (primitive/cast i64 2)))
                             (Ok (EStore (box-expr a (try! (parse-place a (sx-at args 0))))
                                         (box-expr a (try! (parse-expr a (sx-at args 1))))))
                           (= head "alloc-stack") (alloc-form a args 0)
                           (= head "alloc-static") (alloc-form a args 1)
                           (= head "alloc-heap") (alloc-form a args 2)
                           (= head "field")
                             (Ok (EField (box-expr a
                                                   (try! (parse-expr a
                                                                     (try! (need [Sexp]
                                                                                 (sx-get args
                                                                                         0)
                                                                                 "field: missing pointer")))))
                                         (try! (sym-of a
                                                       (try! (need [Sexp]
                                                                   (sx-get args
                                                                           1)
                                                                   "field: missing field name"))
                                                       "field name"))))
                           (= head "bit-get")
                             (Ok (EBitGet (box-expr a
                                                    (try! (parse-expr a
                                                                      (try! (need [Sexp]
                                                                                  (sx-get args
                                                                                          0)
                                                                                  "get: missing pointer")))))
                                          (try! (sym-of a
                                                        (try! (need [Sexp]
                                                                    (sx-get args
                                                                            1)
                                                                    "get: missing field name"))
                                                        "field name"))))
                           (= head "bit-set!")
                             (Ok (EBitSet
                                   :p
                                     (box-expr a
                                               (try! (parse-expr a
                                                                 (try! (need [Sexp]
                                                                             (sx-get args
                                                                                     0)
                                                                             "set!: missing pointer")))))
                                   :fname
                                     (match (sym-of a
                                                    (try! (need [Sexp]
                                                                (sx-get args
                                                                        1)
                                                                "set!: missing field name"))
                                                    "field name")
                                       (Ok [value] value)
                                       (Err [error] (break :try (Err error))))
                                   :val
                                     (box-expr a
                                               (try! (parse-expr a
                                                                 (try! (need [Sexp]
                                                                             (sx-get args
                                                                                     2)
                                                                             "set!: missing value")))))))
                           (= head "fnptr-of")
                             (if (!= nargs (primitive/cast i64 1))
                                 (Err [ExprKind
                                       Diag]
                                      (derr-at slo
                                               shi
                                               "fnptr-of: expects (primitive/fnptr-of name)"))
                                 (let [nf (sx-at args 0)
                                       _name (try! (sym-of a nf "function name"))]
                                   (Ok (EFnPtrOf (lexical-name a nf)))))
                           (= head "call-ptr")
                             (Ok (ECallPtr (box-expr a
                                                     (try! (parse-expr a
                                                                       (try! (need [Sexp]
                                                                                   (sx-get args
                                                                                           0)
                                                                                   "call-ptr: missing function pointer")))))
                                           (try! (parse-exprs a
                                                              (rest-from a
                                                                         args
                                                                         1)))))
                           (= head "load")
                             (if (!= nargs (primitive/cast i64 1))
                                 (Err [ExprKind
                                       Diag]
                                      (derr-at slo
                                               shi
                                               "load: expects (primitive/load ptr)"))
                                 (Ok (ELoad (box-expr a
                                                      (try! (parse-expr a
                                                                        (sx-at args
                                                                               0)))))))
                           (= head "store!")
                             (let [tp (primitive/alloc-stack Two)]
                               (store! tp
                                       (match (need-two a
                                                        args
                                                        "store!")
                                         (Ok [value] value)
                                         (Err [error] (break :try (Err error)))))
                               (Ok (EStore (box-expr a
                                                     (try! (parse-expr a
                                                                       (load (field tp x)))))
                                           (box-expr a
                                                     (try! (parse-expr a
                                                                       (load (field tp y))))))))
                           (= head "free")
                             (if (!= nargs (primitive/cast i64 1))
                                 (Err [ExprKind
                                       Diag]
                                      (derr-at slo
                                               shi
                                               "free: expects (primitive/free ptr)"))
                                 (Ok (EFree (box-expr a
                                                      (try! (parse-expr a
                                                                        (sx-at args
                                                                               0)))))))
                           (= head "make-dyn")
                             (if (!= nargs (primitive/cast i64 2))
                                 (Err [ExprKind
                                       Diag]
                                      (derr-at slo
                                               shi
                                               "make-dyn: expects (primitive/make-dyn Trait expr)"))
                                 (Ok (EErase (try! (sym-of a
                                                           (sx-at args
                                                                  0)
                                                           "make-dyn trait name"))
                                             (box-expr a
                                                       (try! (parse-expr a
                                                                         (sx-at args
                                                                                1)))))))
                           (= head "index")
                             (let [tp (primitive/alloc-stack Two)]
                               (store! tp
                                       (match (need-two a
                                                        args
                                                        "index")
                                         (Ok [value] value)
                                         (Err [error] (break :try (Err error)))))
                               (Ok (EIndex (box-expr a
                                                     (try! (parse-expr a
                                                                       (load (field tp x)))))
                                           (box-expr a
                                                     (try! (parse-expr a
                                                                       (load (field tp y))))))))
                           (= head "cast")
                             (if (!= nargs (primitive/cast i64 2))
                                 (Err [ExprKind
                                       Diag]
                                      (derr-at slo
                                               shi
                                               "cast: expects (primitive/cast :type expr)"))
                                 (Ok (ECast (try! (parse-type a
                                                              (sx-at args
                                                                     0)))
                                            (box-expr a
                                                      (try! (parse-expr a
                                                                        (sx-at args
                                                                               1)))))))
                           (= source-head "match")
                             (parse-match a
                                          args
                                          slo
                                          shi)
                           (= head "sizeof")
                             (if (!= nargs (primitive/cast i64 1))
                                 (Err [ExprKind
                                       Diag]
                                      (derr-at slo
                                               shi
                                               "sizeof: expects (primitive/sizeof TYPE)"))
                                 (Ok (ESizeOf (try! (parse-type a
                                                                (sx-at args
                                                                       0))))))
                           (= head "alignof")
                             (if (!= nargs (primitive/cast i64 1))
                                 (Err [ExprKind
                                       Diag]
                                      (derr-at slo
                                               shi
                                               "alignof: expects (primitive/alignof TYPE)"))
                                 (Ok (EAlignOf (try! (parse-type a
                                                                 (sx-at args
                                                                        0))))))
                           (= head "offsetof")
                             (if (!= nargs (primitive/cast i64 2))
                                 (Err [ExprKind
                                       Diag]
                                      (derr-at slo
                                               shi
                                               "offsetof: expects (primitive/offsetof TYPE field)"))
                                 (Ok (EOffsetOf (try! (parse-type a
                                                                  (sx-at args
                                                                         0)))
                                                (try! (sym-of a
                                                              (sx-at args
                                                                     1)
                                                              "field")))))
                           (= head "linker-address")
                             (if (!= nargs (primitive/cast i64 1))
                                 (Err [ExprKind Diag] (derr-at slo shi "linker-address: expects one linker symbol"))
                                 (Ok (ELlvmIr
                                       :result (TPtr (box-type a (TInt 8 false)))
                                       :args (box-al [Expr] a (al-new [Expr] a))
                                       :body
                                         (sconcat a
                                                  "coil.arch.linker-address:"
                                                  (try! (sym-of a (sx-at args 0) "linker symbol"))))))
                           (= head "write-register!")
                             (if (!= nargs (primitive/cast i64 2))
                                 (Err [ExprKind Diag]
                                      (derr-at slo shi "write-register!: expects a register name and value"))
                                 (let [(mut operands) (al-new [Expr] a)]
                                   (push! (mut operands)
                                          (match (parse-expr a (sx-at args 1))
                                            (Ok [temporary] temporary)
                                            (Err [temporary] (break :try (Err temporary)))))
                                   (Ok (ELlvmIr
                                         :result (TInt 64 true)
                                         :args (box-al [Expr] a (load operands))
                                         :body
                                           (sconcat a
                                                    "coil.arch.write-register:"
                                                    (try! (sym-of a (sx-at args 0) "register name")))))))
                           (= head "volatile-load")
                             (if (!= nargs (primitive/cast i64 2))
                                 (Err [ExprKind Diag] (derr-at slo shi "volatile-load: expects a type and pointer"))
                                 (let [(mut operands) (al-new [Expr] a)]
                                   (push! (mut operands)
                                          (match (parse-expr a (sx-at args 1))
                                            (Ok [temporary] temporary)
                                            (Err [temporary] (break :try (Err temporary)))))
                                   (Ok (ELlvmIr
                                         :result
                                           (match (parse-type a (sx-at args 0))
                                             (Ok [value] value)
                                             (Err [error] (break :try (Err error))))
                                         :args (box-al [Expr] a (load operands))
                                         :body "coil.mem.volatile-load"))))
                           (= head "volatile-store!")
                             (if (!= nargs (primitive/cast i64 2))
                                 (Err [ExprKind Diag] (derr-at slo shi "volatile-store!: expects a pointer and value"))
                                 (let [(mut operands) (al-new [Expr] a)]
                                   (push! (mut operands)
                                          (match (parse-expr a (sx-at args 0))
                                            (Ok [temporary] temporary)
                                            (Err [temporary] (break :try (Err temporary)))))
                                   (push! (mut operands)
                                          (match (parse-expr a (sx-at args 1))
                                            (Ok [temporary] temporary)
                                            (Err [temporary] (break :try (Err temporary)))))
                                   (Ok (ELlvmIr
                                         :result (TInt 64 true)
                                         :args (box-al [Expr] a (load operands))
                                         :body "coil.mem.volatile-store"))))
                           (= head "alias-load")
                             (if (!= nargs (primitive/cast i64 2))
                                 (Err [ExprKind Diag] (derr-at slo shi "alias-load: expects a type and pointer"))
                                 (let [(mut operands) (al-new [Expr] a)]
                                   (push! (mut operands)
                                          (match (parse-expr a (sx-at args 1))
                                            (Ok [temporary] temporary)
                                            (Err [temporary] (break :try (Err temporary)))))
                                   (Ok (ELlvmIr
                                         :result
                                           (match (parse-type a (sx-at args 0))
                                             (Ok [ty] ty)
                                             (Err [diag] (break :try (Err diag))))
                                         :args (box-al [Expr] a (load operands))
                                         :body "coil.mem.alias-load"))))
                           (= head "alias-store!")
                             (if (!= nargs (primitive/cast i64 2))
                                 (Err [ExprKind Diag] (derr-at slo shi "alias-store!: expects a pointer and value"))
                                 (let [(mut operands) (al-new [Expr] a)]
                                   (push! (mut operands)
                                          (match (parse-expr a (sx-at args 0))
                                            (Ok [temporary] temporary)
                                            (Err [temporary] (break :try (Err temporary)))))
                                   (push! (mut operands)
                                          (match (parse-expr a (sx-at args 1))
                                            (Ok [temporary] temporary)
                                            (Err [temporary] (break :try (Err temporary)))))
                                   (Ok (ELlvmIr
                                         :result (TInt 64 true)
                                         :args (box-al [Expr] a (load operands))
                                         :body "coil.mem.alias-store"))))
                           (= head "fence!")
                             (if (!= nargs (primitive/cast i64 0))
                                 (Err [ExprKind Diag] (derr-at slo shi "fence!: expects no arguments"))
                                 (Ok (ELlvmIr
                                       :result (TInt 64 true)
                                       :args (box-al [Expr] a (al-new [Expr] a))
                                       :body "coil.mem.fence")))
                           (= head "csr-read")
                             (if (!= nargs (primitive/cast i64 1))
                                 (Err [ExprKind Diag] (derr-at slo shi "csr-read: expects one CSR name"))
                                 (Ok (ELlvmIr
                                       :result (TInt 32 false)
                                       :args (box-al [Expr] a (al-new [Expr] a))
                                       :body
                                         (sconcat a
                                                  "coil.arch.csr-read:"
                                                  (try! (sym-of a (sx-at args 0) "CSR name"))))))
                           (= head "csr-write!")
                             (if (!= nargs (primitive/cast i64 2))
                                 (Err [ExprKind Diag] (derr-at slo shi "csr-write!: expects a CSR name and u32 value"))
                                 (let [(mut operands) (al-new [Expr] a)]
                                   (push! (mut operands)
                                          (match (parse-expr a (sx-at args 1))
                                            (Ok [temporary] temporary)
                                            (Err [temporary] (break :try (Err temporary)))))
                                   (Ok (ELlvmIr
                                         :result (TInt 64 true)
                                         :args (box-al [Expr] a (load operands))
                                         :body
                                           (sconcat a
                                                    "coil.arch.csr-write:"
                                                    (try! (sym-of a (sx-at args 0) "CSR name")))))))
                           (= head "wfi!")
                             (if (!= nargs (primitive/cast i64 0))
                                 (Err [ExprKind Diag] (derr-at slo shi "wfi!: expects no arguments"))
                                 (Ok (ELlvmIr
                                       :result (TInt 64 true)
                                       :args (box-al [Expr] a (al-new [Expr] a))
                                       :body "coil.arch.wfi")))
                           (= head "mret!")
                             (if (!= nargs (primitive/cast i64 0))
                                 (Err [ExprKind Diag] (derr-at slo shi "mret!: expects no arguments"))
                                 (Ok (ELlvmIr
                                       :result (TNever)
                                       :args (box-al [Expr] a (al-new [Expr] a))
                                       :body "coil.arch.mret")))
                           (>= (typequery-of head) (primitive/cast i64 0))
                             (if (!= nargs (primitive/cast i64 1))
                                 (Err [ExprKind
                                       Diag]
                                      (derr-at slo
                                               shi
                                               (sconcat a
                                                        head
                                                        (sconcat a
                                                                 ": expects ("
                                                                 (sconcat a
                                                                          head
                                                                          " TYPE)")))))
                                 (Ok (ETypeQuery (typequery-of head)
                                                 (try! (parse-type a
                                                                   (sx-at args
                                                                          0))))))
                           (>= (fieldmeta-of head) (primitive/cast i64 0))
                             (if (!= nargs (primitive/cast i64 2))
                                 (Err [ExprKind
                                       Diag]
                                      (derr-at slo
                                               shi
                                               (sconcat a
                                                        head
                                                        (sconcat a
                                                                 ": expects ("
                                                                 (sconcat a
                                                                          head
                                                                          " TYPE index)")))))
                                 (Ok (EFieldMeta
                                       :meta (fieldmeta-of head)
                                       :ty
                                         (match (parse-type a
                                                            (sx-at args
                                                                   0))
                                           (Ok [value] value)
                                           (Err [error] (break :try (Err error))))
                                       :idx
                                         (box-expr a
                                                   (try! (parse-expr a
                                                                     (sx-at args
                                                                            1)))))))
                           (= head "field-index")
                             (if (!= nargs (primitive/cast i64 2))
                                 (Err [ExprKind
                                       Diag]
                                      (derr-at slo
                                               shi
                                               "field-index: expects (primitive/field-index TYPE name)"))
                                 (Ok (EFieldIndex (try! (parse-type a
                                                                    (sx-at args
                                                                           0)))
                                                  (box-expr a
                                                            (try! (parse-expr a
                                                                              (sx-at args
                                                                                     1)))))))
                           (= source-head "quote")
                             (if (!= nargs (primitive/cast i64 1))
                                 (Err [ExprKind
                                       Diag]
                                      (derr-at slo
                                               shi
                                               "quote: expects (quote FORM)"))
                                 (Ok (EQuote (box-sexp a
                                                       (sx-at args
                                                              0)))))
                           (= source-head "quasiquote")
                             (if (!= nargs (primitive/cast i64 1))
                                 (Err [ExprKind
                                       Diag]
                                      (derr-at slo
                                               shi
                                               "quasiquote: expects one template"))
                                 (Ok (EQuasi (try! (build-quasi a
                                                                (sx-at args
                                                                       0))))))
                           (= source-head "unquote")
                             (Err [ExprKind
                                   Diag]
                                  (derr-at slo
                                           shi
                                           "unquote (~) is only valid inside a quasiquote (`)"))
                           (= head "gensym")
                             (if (not (= nargs (primitive/cast i64 0)))
                                 (Err [ExprKind
                                       Diag]
                                      (derr-at slo
                                               shi
                                               "gensym: expects (primitive/gensym)"))
                                 (Ok (ECodeOp 8
                                              (box-al [Expr]
                                                      a
                                                      (al-new [Expr]
                                                              a)))))
                           (= head "target-arch")
                             (if (not (= nargs (primitive/cast i64 0)))
                                 (Err [ExprKind
                                       Diag]
                                      (derr-at slo
                                               shi
                                               "target-arch: expects (primitive/target-arch)"))
                                 (Ok (ECodeOp 30
                                              (box-al [Expr]
                                                      a
                                                      (al-new [Expr]
                                                              a)))))
                           (= head "target-os")
                             (if (not (= nargs (primitive/cast i64 0)))
                                 (Err [ExprKind
                                       Diag]
                                      (derr-at slo
                                               shi
                                               "target-os: expects (primitive/target-os)"))
                                 (Ok (ECodeOp 46
                                              (box-al [Expr]
                                                      a
                                                      (al-new [Expr]
                                                              a)))))
                           (= head "debug-checks?")
                             (if (not (= nargs (primitive/cast i64 0)))
                                 (Err [ExprKind
                                       Diag]
                                      (derr-at slo
                                               shi
                                               "debug-checks?: expects (primitive/debug-checks?)"))
                                 (Ok (ECodeOp 39
                                              (box-al [Expr]
                                                      a
                                                      (al-new [Expr]
                                                              a)))))
                           (= head "lint-param")
                             (if (!= nargs (primitive/cast i64 2))
                                 (Err [ExprKind
                                       Diag]
                                      (derr-at slo
                                               shi
                                               "lint-param: expects (primitive/lint-param KEY DEFAULT)"))
                                 (Ok (ECodeOp 52
                                              (try! (parse-exprs a
                                                                 args)))))
                           (= head "error")
                             (if (!= nargs (primitive/cast i64 1))
                                 (Err [ExprKind
                                       Diag]
                                      (derr-at slo
                                               shi
                                               "error: expects (primitive/error MSG)"))
                                 (Ok (ECodeOp 9
                                              (try! (parse-exprs a
                                                                 args)))))
                           (= head "report")
                             (if (!= nargs (primitive/cast i64 2))
                                 (Err [ExprKind
                                       Diag]
                                      (derr-at slo
                                               shi
                                               "report: expects (primitive/report NODE MSG)"))
                                 (Ok (ECodeOp 31
                                              (try! (parse-exprs a
                                                                 args)))))
                           ; `suggest` is `warn` plus the rewrite it proposes — op 44,
                           ; docs/archive/AUTOFIX.md. `delete` is `warn` plus the removal
                           ; it proposes — op 58 — which is a separate op rather than a
                           ; `suggest` with an empty replacement because no Code value
                           ; renders as nothing.
                           (or (= head "warn")
                               (or (= head "suggest") (= head "delete")))
                             (if (!= nargs
                                     (if (= head "suggest")
                                         3
                                         2))
                                 (Err [ExprKind
                                       Diag]
                                      (derr-at slo
                                               shi
                                               (cond (= head "warn") "warn: expects (primitive/warn NODE MSG)"
                                                     (= head "delete") "delete: expects (primitive/delete NODE MSG)"
                                                     :else "suggest: expects (primitive/suggest NODE MSG REPLACEMENT)")))
                                 (Ok (ECodeOp (cond (= head "warn") 32
                                                    (= head "delete") 58
                                                    :else 44)
                                              (try! (parse-exprs a
                                                                 args)))))
                           (= head "code-file")
                             (if (!= nargs (primitive/cast i64 1))
                                 (Err [ExprKind
                                       Diag]
                                      (derr-at slo
                                               shi
                                               "code-file: expects (primitive/code-file NODE)"))
                                 (Ok (ECodeOp 33
                                              (try! (parse-exprs a
                                                                 args)))))
                           (= head "code-line")
                             (if (!= nargs (primitive/cast i64 1))
                                 (Err [ExprKind
                                       Diag]
                                      (derr-at slo
                                               shi
                                               "code-line: expects (primitive/code-line NODE)"))
                                 (Ok (ECodeOp 40
                                              (try! (parse-exprs a
                                                                 args)))))
                           (= head "code-src")
                             (if (!= nargs (primitive/cast i64 1))
                                 (Err [ExprKind
                                       Diag]
                                      (derr-at slo
                                               shi
                                               "code-src: expects (primitive/code-src NODE)"))
                                 (Ok (ECodeOp 41
                                              (try! (parse-exprs a
                                                                 args)))))
                           (= head "code-col")
                             (if (!= nargs (primitive/cast i64 1))
                                 (Err [ExprKind
                                       Diag]
                                      (derr-at slo
                                               shi
                                               "code-col: expects (primitive/code-col NODE)"))
                                 (Ok (ECodeOp 42
                                              (try! (parse-exprs a
                                                                 args)))))
                           (= head "code-doc")
                             (if (!= nargs (primitive/cast i64 1))
                                 (Err [ExprKind
                                       Diag]
                                      (derr-at slo
                                               shi
                                               "code-doc: expects (primitive/code-doc NODE)"))
                                 (Ok (ECodeOp 43
                                              (try! (parse-exprs a
                                                                 args)))))
                           (or (= head "code-from-user?")
                               (or (= head "code-macro?") (= head "code-macro-call?")))
                           ; macro produced it rather than a human typing it (45).
                           (if (!= nargs (primitive/cast i64 1))
                               (Err [ExprKind
                                     Diag]
                                    (derr-at slo
                                             shi
                                             (sconcat a
                                                      head
                                                      ": expects one Code node")))
                               (Ok (ECodeOp (if (= head "code-from-user?")
                                                34
                                                (if (= head "code-macro?") 45 53))
                                            (try! (parse-exprs a
                                                               args)))))
                             (= head "code-decl")
                           (if (!= nargs (primitive/cast i64 1))
                               (Err [ExprKind
                                     Diag]
                                    (derr-at slo
                                             shi
                                             "code-decl: expects (primitive/code-decl NODE)"))
                               (Ok (ECodeOp 35
                                            (try! (parse-exprs a
                                                               args)))))
                             (= head "type-of")
                           (if (!= nargs (primitive/cast i64 1))
                               (Err [ExprKind
                                     Diag]
                                    (derr-at slo
                                             shi
                                             "type-of: expects (primitive/type-of NODE)"))
                               (Ok (ECodeOp 36
                                            (try! (parse-exprs a
                                                               args)))))
                             (= head "binding-of")
                           (if (!= nargs (primitive/cast i64 1))
                               (Err [ExprKind
                                     Diag]
                                    (derr-at slo
                                             shi
                                             "binding-of: expects (primitive/binding-of NODE)"))
                               (Ok (ECodeOp 37
                                            (try! (parse-exprs a
                                                               args)))))
                             (>= (codeop-of head) (primitive/cast i64 0))
                           (Ok (ECodeOp (codeop-of head)
                                        (try! (parse-exprs a
                                                           args))))
                             (= source-head "loop")
                           (let [lr (primitive/alloc-stack LabelSplit)]
                             (store! lr
                                     (split-label a
                                                  args))
                             (let [body
                                     (try! (parse-exprs a
                                                        (load (field lr rest))))]
                               (if (= (len (load body))
                                      (primitive/cast i64 0))
                                   (Err [ExprKind
                                         Diag]
                                        (derr-at slo
                                                 shi
                                                 "loop: expects (loop [:label] body...)"))
                                   (Ok (ELoop (load (field lr label))
                                              body)))))
                             (= source-head "break")
                           (let [lr (primitive/alloc-stack LabelSplit)]
                             (store! lr
                                     (split-label a
                                                  args))
                             (let [r (load (field lr rest))]
                               (if (> (sx-len r) (primitive/cast i64 1))
                                   (Err [ExprKind
                                         Diag]
                                        (derr-at slo
                                                 shi
                                                 "break: expects (break [:label] [value])"))
                                   (Ok (EBreak (load (field lr label))
                                               (match (sx-get r
                                                              0)
                                                 (Some [e]
                                                       (Some (box-expr a
                                                                       (try! (parse-expr a
                                                                                         e)))))
                                                 (None []
                                                       (None [(ptr Expr)]))))))))
                             (= source-head "continue")
                           (let [lr (primitive/alloc-stack LabelSplit)]
                             (store! lr
                                     (split-label a
                                                  args))
                             (if (> (sx-len (load (field lr rest))) (primitive/cast i64 0))
                                 (Err [ExprKind
                                       Diag]
                                      (derr-at slo
                                               shi
                                               "continue: expects (continue [:label])"))
                                 (Ok (EContinue (load (field lr label))))))
                             (= head "llvm-ir")
                           (parse-llvm-ir a
                                          args
                                          slo
                                          shi)
                             :else
                           (let [fv
                                   (sx-get args
                                           0)]
                             (if (and (opt-is-vec fv) (call-vector-is-type-args? (opt-get fv)))
                                 (parse-call-kind a
                                                  (lexical-name a (sx-at items 0))
                                                  (try! (parse-types a (sx-items (opt-get fv))))
                                                  (rest-from a args 1))
                                 (parse-call-kind a
                                                  (lexical-name a (sx-at items 0))
                                                  (box-al [Type] a (al-new [Type] a))
                                                  args)))))))))))

; ---- declaration parsers ----
(defn func-name [(f Func)] (-> (slice u8))
  (let [p (primitive/alloc-stack Func)] (set! p f) (.name p)))

; variant/struct fields: (name :type) -> Field.
(defn parse-fields [(a (dyn Allocator)) (fv (ptr (ArrayList Sexp)))] (-> (Result (ptr (ArrayList Field)) Diag))
  (try (let [(mut fs) (al-new [Field] a)
             n (sx-len fv)
             (mut i) 0]
         (loop (if (>= (load i) n)
                   (break)
                   (let [f (sx-at fv (load i))]
                     (store! i (primitive/iadd (load i) 1))
                     (let [fl (try! (as-list f "field must be (name :type)"))
                           fn0 (try! (sym-of a (sx-at fl 0) "field name"))
                           ft (try! (parse-type a (try! (need [Sexp] (sx-get fl 1) "field type"))))]
                       (let [fp (primitive/alloc-stack Field)]
                         (store! (field fp name) fn0)
                         (store! (field fp ty) ft)
                         (push! (mut fs) (load fp)))))))
         (Ok (box-al [Field] a (load fs))))))

(defn parse-const [(a (dyn Allocator)) (rest (ptr (ArrayList Sexp)))] (-> (Result Const Diag))
  (try (let [namef (try! (need [Sexp] (sx-get rest 0) "const: missing name"))
             _namecheck (try! (sym-of a namef "const name"))
             name (lexical-name a namef)
             nr (sx-len rest)]
         (if (= nr (primitive/cast i64 2))
             (let [value (try! (parse-expr a (sx-at rest 1)))]
               (Ok (let [c (primitive/alloc-stack Const)]
                     (store! (field c name) name)
                     (store! (field c ty) (None [Type]))
                     (store! (field c value) value)
                     (load c))))
             (if (= nr (primitive/cast i64 3))
                 (let [ty (try! (parse-type a (sx-at rest 1)))
                       value (try! (parse-expr a (sx-at rest 2)))]
                   (Ok (let [c (primitive/alloc-stack Const)]
                         (store! (field c name) name)
                         (store! (field c ty) (Some ty))
                         (store! (field c value) value)
                         (load c))))
                 (Err [Const Diag] (derr "const: expected (const NAME VALUE) or (const NAME TYPE VALUE)")))))))

(defn parse-defannotation [(a (dyn Allocator))
                           (rest (ptr (ArrayList Sexp)))] (-> (Result AnnotationDef Diag))
  (try (do
         (when (not (= (sx-len rest) (primitive/cast i64 2)))
           (break :try
                    (Err [AnnotationDef Diag]
                         (derr "defannotation: expected (defannotation :key ValueType)"))))
         (let [key (try! (kw-of a (sx-at rest 0) "defannotation key"))
               ty (try! (parse-type a (sx-at rest 1)))
               dp (primitive/alloc-stack AnnotationDef)]
           (store! (field dp key) key)
           (store! (field dp value_type) ty)
           (Ok (load dp))))))

(defn parse-defsum [(a (dyn Allocator)) (rest (ptr (ArrayList Sexp)))] (-> (Result SumDef Diag))
  (try (let [namef (try! (need [Sexp] (sx-get rest 0) "defsum: missing name"))
             _namecheck (try! (sym-of a namef "sum name"))
             name (lexical-name a namef)
             (mut i) 1
             (mut tps) (al-new [(slice u8)] a)
             (mut sbounds) (al-new [Bound] a)]
         ; type params may carry bounds — `(T Ord)` — via the SAME per-entry parser defn and
         ; defstruct use, so the three forms cannot drift apart. (This used to require a bare
         ; symbol and reject `(T Ord)` outright, the only form of the three that did.)
         (when (opt-is-vec (sx-get rest (load i)))
           (let [it (sx-items (opt-get (sx-get rest (load i))))
                 n (sx-len it)
                 (mut k) 0]
             (loop (if (>= (load k) n)
                       (break)
                       (do
                         (let [ep (primitive/alloc-stack TPEntry)]
                           (store! ep
                                   (match (parse-tparam-entry a (sx-at it (load k)))
                                     (Ok [value] value)
                                     (Err [error] (break :try (Err error)))))
                           (push! (mut tps) (load (field ep name)))
                           (when (> (len (load (load (field ep
                                                            traits))))
                                    (primitive/cast i64 0))
                             (let [bp (primitive/alloc-stack Bound)]
                               (store! (field bp name) (load (field ep name)))
                               (store! (field bp traits) (load (field ep traits)))
                               (push! (mut sbounds) (load bp))
                               0)))
                         (store! k (primitive/iadd (load k) 1))))))
           (store! i (primitive/iadd (load i) 1)))
         (let [(mut variants) (al-new [Variant] a)
               nr (sx-len rest)
               (mut vi) (load i)]
           (loop (if (>= (load vi) nr)
                     (break)
                     (let [v (sx-at rest (load vi))]
                       (store! vi (primitive/iadd (load vi) 1))
                       (let [vl (try! (as-list v "variant must be (Name [fields])"))
                             vnamef (try! (need [Sexp] (sx-get vl 0) "variant: missing name"))
                             _vnamecheck (try! (sym-of a vnamef "variant name"))
                             vname (lexical-name a vnamef)
                             fields
                               (if (opt-is-vec (sx-get vl 1))
                                   (try! (parse-fields a (sx-items (opt-get (sx-get vl 1)))))
                                   (match (sx-get vl 1)
                                     (Some [_]
                                           (return-from :try
                                                          (Err [SumDef Diag]
                                                               (derr-at (sx-lo v)
                                                                        (sx-hi v)
                                                                        (sconcat3 a
                                                                                  "variant '"
                                                                                  vname
                                                                                  "': fields must be a vector")))))
                                     (None [] (box-al [Field] a (al-new [Field] a)))))]
                         (let [vp (primitive/alloc-stack Variant)]
                           (store! (field vp name) vname)
                           (store! (field vp fields) fields)
                           (push! (mut variants) (load vp)))))))
           (Ok (let [sd (primitive/alloc-stack SumDef)]
                 (store! (field sd name) name)
                 (store! (field sd type_params) (box-al [(slice u8)] a (load tps)))
                 (store! (field sd bounds) (box-al [Bound] a (load sbounds)))
                 (store! (field sd variants) (box-al [Variant] a (load variants)))
                 (load sd)))))))

(defn compute-backing [(a (dyn Allocator)) (name (slice u8)) (acc i64) (backing i64)] (-> (Result i64 Diag))
  (cond (>= backing (primitive/cast i64 0))
          (if (>= backing acc)
              (Ok backing)
              (Err [i64 Diag]
                   (derr (sconcat a
                                  (sconcat3 a "defstruct '" name "': :backing i")
                                  (sconcat a
                                           (i64->str a backing)
                                           (sconcat a " too small for " (sconcat a (i64->str a acc) " bits")))))))
        (<= acc (primitive/cast i64 8)) (Ok 8)
        (<= acc (primitive/cast i64 16)) (Ok 16)
        (<= acc (primitive/cast i64 32)) (Ok 32)
        (<= acc (primitive/cast i64 64)) (Ok 64)
        :else
          (Err [i64 Diag]
               (derr (sconcat a
                              (sconcat3 a "defstruct '" name "': ")
                              (sconcat a (i64->str a acc) " bits needs an explicit :backing"))))))

(defstruct BitField [(fname (slice u8)) (width i64) (signed bool)])

(defn parse-bitfield [(a (dyn Allocator)) (f Sexp)] (-> (Result BitField Diag))
  (try (let [fl (try! (as-list f "bitfield must be (name :bits N|iN|uN)"))
             fname (try! (sym-of a (sx-at fl 0) "field name"))
             spec (try! (need [Sexp] (sx-get fl 2) "bitfield missing width/type"))
             bt
               (if (opt-is-pos-int (sx-get fl 2))
                   (TInt (opt-int (sx-get fl 2)) false)
                   (try! (parse-type a spec)))
             width (match bt (TInt [bits _] bits) (_ -1))
             signed (match bt (TInt [_ s] s) (_ false))]
         (if (< width (primitive/cast i64 0))
             (Err [BitField Diag]
                  (derr-at (sx-lo f) (sx-hi f) (sconcat3 a "field '" fname "' must be (name :bits N|iN|uN)")))
             (Ok (let [b (primitive/alloc-stack BitField)]
                   (store! (field b fname) fname)
                   (store! (field b width) width)
                   (store! (field b signed) signed)
                   (load b)))))))

(defn finish-bits [(a (dyn Allocator))
                   (name (slice u8))
                   (tparams (ptr (ArrayList (slice u8))))
                   (bounds (ptr (ArrayList Bound)))
                   (backing i64)
                   (fields-items (ptr (ArrayList Sexp)))] (-> (Result StructDef Diag))
  (let [(mut fields) (al-new [Field] a)
        (mut offsets) (al-new [i64] a)
        (mut acc) 0
        n (sx-len fields-items)
        (mut fi) 0
        (mut out) (primitive/zeroed (Result StructDef Diag))
        (mut failed) false]
    (loop (if (>= (load fi) n)
              (break)
              (let [f (sx-at fields-items (load fi))]
                (set! fi (primitive/iadd (load fi) 1))
                (match (parse-bitfield a f)
                  (Err [d] (do (set! out (Err d)) (set! failed true) (break)))
                  (Ok [fld]
                      (let [bp (primitive/alloc-stack BitField)]
                        (set! bp fld)
                        (let [fr (primitive/alloc-stack Field)]
                          (set! (.name fr) (.fname bp))
                          (set! (.ty fr) (TInt (.width bp) (.signed bp)))
                          (push! (mut fields) (load fr)))
                        (push! (mut offsets) (load acc))
                        (set! acc (primitive/iadd (load acc) (.width bp)))))))))
    (if (load failed)
        (load out)
        (match (compute-backing a name (load acc) backing)
          (Err [d] (Err d))
          (Ok [bk]
              (Ok (let [sd (primitive/alloc-stack StructDef)]
                    (set! (.name sd) name)
                    (set! (.type_params sd) tparams)
                    (set! (.bounds sd) bounds)
                    (set! (.layout sd) (LBits bk (box-al [i64] a (load offsets))))
                    (set! (.fields sd) (box-al [Field] a (load fields)))
                    (load sd))))))))

(defstruct NField [(fname (slice u8)) (fty Type) (at (Option i64))])

(defn parse-normal-field [(a (dyn Allocator)) (f Sexp)] (-> (Result NField Diag))
  (try (let [fl (try! (as-list f "field must be (name :type [:at N])"))
             fname (try! (sym-of a (sx-at fl 0) "field name"))
             fty (try! (parse-type a (try! (need [Sexp] (sx-get fl 1) "field missing type"))))
             (mut at) (None [i64])
             (mut j) 2
             fln (sx-len fl)
             (mut out) (primitive/zeroed (Result NField Diag))
             (mut bad) false]
         (loop (if (>= (load j) fln)
                   (break)
                   (let [fj (sx-at fl (load j))]
                     (if (and (= (sx-tag fj) (primitive/cast i64 3)) (= (sx-sval fj) "at"))
                         (do
                           (store! at
                                   (Some (try! (int-val a
                                                        (try! (need [Sexp]
                                                                    (sx-get fl (primitive/iadd (load j) 1))
                                                                    ":at missing value"))
                                                        "at"))))
                           (store! j (primitive/iadd (load j) 2)))
                         (do
                           (store! out
                                   (Err (derr-at (sx-lo fj)
                                                 (sx-hi fj)
                                                 (sconcat a "unknown field option " (sexp-display a fj)))))
                           (store! bad true)
                           (break))))))
         (if (load bad)
             (load out)
             (Ok (let [nf (primitive/alloc-stack NField)]
                   (store! (field nf fname) fname)
                   (store! (field nf fty) fty)
                   (store! (field nf at) (load at))
                   (load nf)))))))

(defn compute-layout [(a (dyn Allocator))
                      (name (slice u8))
                      (packed bool)
                      (explicit bool)
                      (aligned i64)
                      (exp-size i64)
                      (has-size bool)
                      (exp-align i64)
                      (anyat bool)
                      (ats (ptr (ArrayList (Option i64))))] (-> (Result Layout Diag))
  (cond (>= aligned (primitive/cast i64 0)) (Ok (LAligned aligned))
        (or explicit anyat)
          (let [(mut offs) (al-new [i64] a)
                na (len (load ats))
                (mut oi) 0
                (mut bad) false]
            (loop (if (>= (load oi) na)
                      (break)
                      (match (get (load ats) (load oi))
                        (Some [o] (do (push! (mut offs) o) (store! oi (primitive/iadd (load oi) 1))))
                        (None [] (do (store! bad true) (break))))))
            (if (load bad)
                (Err (derr (sconcat3 a "defstruct '" name "': explicit layout needs :at on every field")))
                (Ok (LExplicit
                      :offsets (box-al [i64] a (load offs))
                      :size (if has-size (Some exp-size) (None [i64]))
                      :align exp-align))))
        packed (Ok (LPacked))
        :else (Ok (LC))))

(defn finish-normal [(a (dyn Allocator))
                     (name (slice u8))
                     (tparams (ptr (ArrayList (slice u8))))
                     (bounds (ptr (ArrayList Bound)))
                     (packed bool)
                     (explicit bool)
                     (aligned i64)
                     (exp-size i64)
                     (has-size bool)
                     (exp-align i64)
                     (fields-items (ptr (ArrayList Sexp)))] (-> (Result StructDef Diag))
  (let [(mut fields) (al-new [Field] a)
        (mut ats) (al-new [(Option i64)] a)
        (mut anyat) false
        n (sx-len fields-items)
        (mut fi) 0
        (mut out) (primitive/zeroed (Result StructDef Diag))
        (mut failed) false]
    (loop (if (>= (load fi) n)
              (break)
              (let [f (sx-at fields-items (load fi))]
                (set! fi (primitive/iadd (load fi) 1))
                (match (parse-normal-field a f)
                  (Err [d] (do (set! out (Err d)) (set! failed true) (break)))
                  (Ok [nf]
                      (let [np (primitive/alloc-stack NField)]
                        (set! np nf)
                        (let [fr (primitive/alloc-stack Field)]
                          (set! (.name fr) (.fname np))
                          (set! (.ty fr) (.fty np))
                          (push! (mut fields) (load fr)))
                        (match (.at np) (Some [_] (do (set! anyat true) 0)) (None [] 0))
                        (push! (mut ats) (.at np))))))))
    (if (load failed)
        (load out)
        (match (compute-layout a
                               name
                               packed
                               explicit
                               aligned
                               exp-size
                               has-size
                               exp-align
                               (load anyat)
                               (box-al [(Option i64)] a (load ats)))
          (Err [d] (Err d))
          (Ok [layout]
              (Ok (let [sd (primitive/alloc-stack StructDef)]
                    (set! (.name sd) name)
                    (set! (.type_params sd) tparams)
                    (set! (.bounds sd) bounds)
                    (set! (.layout sd) layout)
                    (set! (.fields sd) (box-al [Field] a (load fields)))
                    (load sd))))))))

(defstruct StructOpts
  [(packed bool)
   (explicit bool)
   (bits bool)
   (aligned i64)
   (exp-size i64)
   (has-size bool)
   (exp-align i64)
   (backing i64)
   (next i64)])

(defn parse-struct-opts [(a (dyn Allocator)) (rest (ptr (ArrayList Sexp))) (start i64)] (-> (Result StructOpts Diag))
  (let [(mut packed) false
        (mut explicit) false
        (mut bits) false
        (mut aligned) -1
        (mut exp-size) -1
        (mut has-size) false
        (mut exp-align) 0
        (mut backing) -1
        (mut i) start
        (mut out) (primitive/zeroed (Result StructOpts Diag))
        (mut failed) false]
    (loop (match (sx-get rest (load i))
            (None [] (break))
            (Some [kw]
                  (if (not (= (sx-tag kw) (primitive/cast i64 3)))
                      (break)
                      (match (need [Sexp]
                                   (sx-get rest (primitive/iadd (load i) 1))
                                   (sconcat3 a "defstruct: ':" (sx-sval kw) "' missing value"))
                        (Err [d] (do (set! out (Err d)) (set! failed true) (break)))
                        (Ok [val]
                            (let [k (sx-sval kw)
                                  (mut stop) false]
                              (cond (= k "layout")
                                      (if (= (sx-tag val) (primitive/cast i64 2))
                                          (let [vs (sx-sval val)]
                                            (cond (= vs "c") 0
                                                  (= vs "packed") (do (store! packed true) 0)
                                                  (= vs "explicit") (do (store! explicit true) 0)
                                                  (= vs "bits") (do (store! bits true) 0)
                                                  :else
                                                    (do
                                                      (store! out
                                                              (Err [StructOpts Diag]
                                                                   (derr-at (sx-lo val)
                                                                            (sx-hi val)
                                                                            "layout must be c, packed, explicit, bits, or (align N)")))
                                                      (store! failed true)
                                                      (store! stop true)
                                                      0)))
                                          (if (and (= (sx-tag val) (primitive/cast i64 6))
                                                   (> (sx-len (sx-items val))
                                                      (primitive/cast i64 0)))
                                              (let [vit (sx-items val)]
                                                (if (and (= (sx-tag (sx-at vit 0)) (primitive/cast i64 2))
                                                         (= (sx-sval (sx-at vit 0)) "align"))
                                                    (match (pow2 (sx-get vit 1))
                                                      (Ok [v] (store! aligned v))
                                                      (Err [d]
                                                           (do
                                                             (store! out (Err d))
                                                             (store! failed true)
                                                             (store! stop true)
                                                             0)))
                                                    (do
                                                      (store! out
                                                              (Err [StructOpts Diag]
                                                                   (derr-at (sx-lo val)
                                                                            (sx-hi val)
                                                                            "layout must be c, packed, explicit, bits, or (align N)")))
                                                      (store! failed true)
                                                      (store! stop true)
                                                      0)))
                                              (do
                                                (store! out
                                                        (Err [StructOpts Diag]
                                                             (derr-at (sx-lo val)
                                                                      (sx-hi val)
                                                                      "layout must be c, packed, explicit, bits, or (align N)")))
                                                (store! failed true)
                                                (store! stop true)
                                                0)))
                                    (= k "size")
                                      (match (int-val a val "size")
                                        (Ok [v] (do (store! exp-size v) (store! has-size true) 0))
                                        (Err [d]
                                             (do
                                               (store! out (Err d))
                                               (store! failed true)
                                               (store! stop
                                                       true)
                                               0)))
                                    (= k "align")
                                      (match (pow2 (sx-get rest (primitive/iadd (load i) 1)))
                                        (Ok [v] (store! exp-align v))
                                        (Err [d]
                                             (do
                                               (store! out (Err d))
                                               (store! failed true)
                                               (store! stop
                                                       true)
                                               0)))
                                    (= k "backing")
                                      (match (parse-type a val)
                                        (Err [d]
                                             (do
                                               (store! out (Err d))
                                               (store! failed true)
                                               (store! stop
                                                       true)
                                               0))
                                        (Ok [bt]
                                            (let [bb (type-int-bits bt)]
                                              (if (< bb (primitive/cast i64 0))
                                                  (do
                                                    (store! out
                                                            (Err [StructOpts Diag]
                                                                 (derr-at (sx-lo val)
                                                                          (sx-hi val)
                                                                          ":backing must be an integer type")))
                                                    (store! failed true)
                                                    (store! stop true)
                                                    0)
                                                  (store! backing bb)))))
                                    :else (do (store! stop true) 0))
                              (if (load stop) (break) (set! i (primitive/iadd (load i) 2))))))))))
    (if (load failed)
        (load out)
        (Ok (let [o (primitive/alloc-stack StructOpts)]
              (set! (.packed o) (load packed))
              (set! (.explicit o) (load explicit))
              (set! (.bits o) (load bits))
              (set! (.aligned o) (load aligned))
              (set! (.exp-size o) (load exp-size))
              (set! (.has-size o) (load has-size))
              (set! (.exp-align o) (load exp-align))
              (set! (.backing o) (load backing))
              (set! (.next o) (load i))
              (load o))))))

(defn parse-defstruct [(a (dyn Allocator)) (rest (ptr (ArrayList Sexp)))] (-> (Result StructDef Diag))
  (try (let [namef (try! (need [Sexp] (sx-get rest 0) "defstruct: missing name"))
             _namecheck (try! (sym-of a namef "struct name"))
             name (lexical-name a namef)
             opts (primitive/alloc-stack StructOpts)]
         (store! opts
                 (match (parse-struct-opts a rest 1) (Ok [value] value) (Err [error] (break :try (Err error)))))
         (let [tpr (primitive/alloc-stack TPResult)]
           (store! tpr
                   (match (parse-type-params a rest (load (field opts next)))
                     (Ok [value] value)
                     (Err [error] (break :try (Err error)))))
           (let [i
                   (if (load (field tpr consumed))
                       (primitive/iadd (load (field opts next)) 1)
                       (load (field opts
                                    next)))
                 fields-items
                   (if (opt-is-vec (sx-get rest i))
                       (sx-items (opt-get (sx-get rest i)))
                       (primitive/zeroed (ptr (ArrayList Sexp))))]
             (if (= (primitive/cast i64 fields-items) (primitive/cast i64 0))
                 (Err [StructDef Diag] (derr (sconcat3 a "defstruct '" name "': expected a field vector")))
                 (if (load (field opts bits))
                     (finish-bits a
                                  name
                                  (load (field tpr params))
                                  (load (field tpr bounds))
                                  (load (field opts backing))
                                  fields-items)
                     (finish-normal a
                                    name
                                    (load (field tpr params))
                                    (load (field tpr bounds))
                                    (load (field opts packed))
                                    (load (field opts explicit))
                                    (load (field opts aligned))
                                    (load (field opts exp-size))
                                    (load (field opts has-size))
                                    (load (field opts exp-align))
                                    fields-items))))))))

(defn parse-extern [(a (dyn Allocator)) (rest (ptr (ArrayList Sexp)))] (-> (Result Extern Diag))
  (try (let [namef (try! (need [Sexp] (sx-get rest 0) "extern: missing name"))
             _namecheck (try! (sym-of a namef "extern name"))
             name (lexical-name a namef)
             (mut i) 1
             (mut cc) "c"]
         (match (sx-get rest (load i))
           (Some [k]
                 (when (and (= (sx-tag k) (primitive/cast i64 3)) (= (sx-sval k) "cc"))
                   (store! cc
                           (match (sym-of a
                                          (try! (need [Sexp]
                                                      (sx-get rest (primitive/iadd (load i) 1))
                                                      "extern: ':cc' missing convention"))
                                          "cc name")
                             (Ok [value] value)
                             (Err [error] (break :try (Err error)))))
                   (store! i (primitive/iadd (load i) 2))
                   0))
           (None [] 0))
         (let [params-items
                 (try! (need-vec (sx-get rest (load i))
                                 (sconcat3 a "extern '" name "': expected a vector of parameter types")))]
           (store! i (primitive/iadd (load i) 1))
           (let [pn (sx-len params-items)
                 variadic
                   (if (> pn (primitive/cast i64 0))
                       (let [last (sx-at params-items (primitive/isub pn 1))]
                         (and (= (sx-tag last) (primitive/cast i64 2)) (= (sx-sval last) "...")))
                       false)
                 fixed-n (if variadic (primitive/isub pn 1) pn)
                 (mut params) (al-new [Type] a)
                 (mut pi) 0]
             (loop (if (>= (load pi) fixed-n)
                       (break)
                       (do
                         (push! (mut params)
                                (match (parse-type a (sx-at params-items (load pi)))
                                  (Ok [temporary] temporary)
                                  (Err [temporary] (break :try (Err temporary)))))
                         (store! pi (primitive/iadd (load pi) 1)))))
             (let [ret-l
                     (try! (as-list (try! (need [Sexp] (sx-get rest (load i)) "extern: missing (-> :type)"))
                                    "expected (-> :type)"))]
               (when (not (= (match (head-sym a ret-l) (Ok [value] value) (Err [error] (break :try (Err error)))) "->"))
                 (break :try (Err [Extern Diag] (derr (sconcat3 a "extern '" name "': expected (-> :type)")))))
               (let [ret (try! (parse-type a (try! (need [Sexp] (sx-get ret-l 1) "(-> ) missing type"))))]
                 (Ok (let [e (primitive/alloc-stack Extern)]
                       (store! (field e name) name)
                       (store! (field e cc) (load cc))
                       (store! (field e params) (box-al [Type] a (load params)))
                       (store! (field e variadic) variadic)
                       (store! (field e ret) ret)
                       (load e))))))))))

(defn native-cc-parse [(s (slice u8))] (-> i64)
  (cond (or (= s "c") (= s "ccc")) 0
        (or (= s "fast") (= s "fastcc")) 1
        (or (= s "cold") (= s "coldcc")) 2
        (or (= s "tail") (= s "tailcc")) 3
        (or (= s "swifttail") (= s "swifttailcc")) 4
        :else -1))

(defn parse-defcc [(a (dyn Allocator)) (rest (ptr (ArrayList Sexp)))] (-> (Result Convention Diag))
  (try (let [name (try! (sym-of a (try! (need [Sexp] (sx-get rest 0) "defcc: missing name")) "defcc name"))
             (mut params) (box-al [(slice u8)] a (al-new [(slice u8)] a))
             (mut ret) (None [(slice u8)])
             (mut clobber) (box-al [(slice u8)] a (al-new [(slice u8)] a))
             (mut preserve) (box-al [(slice u8)] a (al-new [(slice u8)] a))
             (mut native) -1
             (mut shim) false
             (mut reset) false
             (mut i) 1
             nr (sx-len rest)]
         (loop (if (>= (load i) nr)
                   (break)
                   (let [kw (try! (kw-of a (sx-at rest (load i)) "defcc option"))
                         val
                           (try! (need [Sexp]
                                       (sx-get rest (primitive/iadd (load i) 1))
                                       (sconcat3 a "defcc: option ':" kw "' missing value")))]
                     (cond (= kw "params")
                             (do
                               (store! params
                                       (match (sym-vec a val "params")
                                         (Ok [value] value)
                                         (Err [error] (break :try (Err error)))))
                               0)
                           (= kw "ret") (do (store! ret (Some (try! (sym-of a val "ret")))) 0)
                           (= kw "clobber")
                             (do
                               (store! clobber
                                       (match (sym-vec a val "clobber")
                                         (Ok [value] value)
                                         (Err [error] (break :try (Err error)))))
                               0)
                           (= kw "preserve")
                             (do
                               (store! preserve
                                       (match (sym-vec a val "preserve")
                                         (Ok [value] value)
                                         (Err [error] (break :try (Err error)))))
                               0)
                           (= kw "native")
                             (let [nn (try! (sym-of a val "native"))
                                   code (native-cc-parse nn)]
                               (if (< code (primitive/cast i64 0))
                                   (return-from :try
                                                  (Err [Convention Diag]
                                                       (derr-at (sx-lo val)
                                                                (sx-hi val)
                                                                (sconcat3 a
                                                                          "defcc: unknown native cc '"
                                                                          nn
                                                                          "'"))))
                                   (do (store! native code) 0)))
                           (= kw "lower")
                             (let [lower (try! (sym-of a val "lower"))]
                               (cond (= lower "shim") (do (store! shim true) 0)
                                     (= lower "reset") (do (store! reset true) 0)
                                     :else
                                       (break :try
                                                (Err [Convention Diag]
                                                     (derr-at (sx-lo val)
                                                              (sx-hi val)
                                                              "defcc: :lower expects shim or reset")))))
                           :else
                             (break :try
                                      (Err [Convention Diag]
                                           (derr-at (sx-lo (sx-at rest (load i)))
                                                    (sx-hi (sx-at rest (load i)))
                                                    (sconcat3 a "defcc: unknown option ':" kw "'")))))
                     (store! i (primitive/iadd (load i) 2)))))
         (let [lowering
                 (if (>= (load native) (primitive/cast i64 0))
                     (LNative (load native))
                     (if (load shim)
                         (LShim)
                         (if (load reset)
                             (LReset)
                             (return-from :try
                                            (Err [Convention Diag]
                                                 (derr (sconcat3 a
                                                                 "defcc '"
                                                                 name
                                                                 "': needs a lowering (:native <c|fast|cold|tail|swifttail> or :lower <shim|reset>)")))))))]
           (Ok (let [c (primitive/alloc-stack Convention)]
                 (store! (field c name) name)
                 (store! (field c params) (load params))
                 (store! (field c ret) (load ret))
                 (store! (field c clobber) (load clobber))
                 (store! (field c preserve) (load preserve))
                 (store! (field c lowering) lowering)
                 (load c)))))))

; Would the parser intercept a call whose head is `name`? Uses the REAL dispatch
; (parse-list-expr) as the single source of truth — no parallel keyword list to
; drift out of sync: a plain user call `(name x)` parses to `ECall name …`, so any
; other outcome (a special form's own ExprKind, or a parse error) means `name` is a
; built-in form and a function of that name could never be *called* as `(name …)`.
; This is why shadowing `call`/`index`/`if`/… must be rejected at the definition.
(defn builtin-form-head? [(a (dyn Allocator)) (name (slice u8))] (-> bool)
  (let [(mut items) (al-new [Sexp] a)]
    (push! (mut items) (mk-sexp (KSym name) -1 -1))
    (push! (mut items) (mk-sexp (KSym "__coil_shadow_probe__") -1 -1))
    (try (let [k (try-or! (parse-list-expr a (box-items a (load items)) -1 -1 -1 0) true)]
           (match k (ECall [f _ta _ar] (not (= f name))) (_ true))))))

(defn parse-defn [(a (dyn Allocator)) (rest (ptr (ArrayList Sexp))) (allow-call bool)] (-> (Result Func Diag))
  (try (let [namef (try! (need [Sexp] (sx-get rest 0) "defn: missing name"))
             raw-name (try! (sym-of a namef "defn name"))
             ; Impl method heads select a member of the explicitly named trait;
             ; they are interface labels, not new lexical/global bindings.
             ; Parameters/body references remain ordinary scoped identifiers.
             name (if allow-call raw-name (lexical-name a namef))
             (mut i) 1
             (mut cc) "c"
             (mut annotations) (al-new [Annotation] a)]
         (when (and (builtin-form-head? a raw-name) (not (and allow-call (= raw-name "call"))))
           (break :try
                    (Err [Func Diag]
                         (derr-at (sx-lo namef)
                                  (sx-hi namef)
                                  (sconcat a
                                           (sconcat3 a
                                                     "cannot define '"
                                                     name
                                                     "': it is a built-in form and can never be called as (")
                                           (sconcat a name " …); rename the function"))))))
         (match (sx-get rest (load i))
           (Some [k]
                 (when (and (= (sx-tag k) (primitive/cast i64 3)) (= (sx-sval k) "cc"))
                   (store! cc
                           (match (sym-of a
                                          (try! (need [Sexp]
                                                      (sx-get rest (primitive/iadd (load i) 1))
                                                      "defn: ':cc' missing convention name"))
                                          "cc name")
                             (Ok [value] value)
                             (Err [error] (break :try (Err error)))))
                   (store! i (primitive/iadd (load i) 2))
                   0))
           (None [] 0))
         ; All other leading keyword/expression pairs are open declaration
         ; annotations. Their keys and value types are resolved later against
         ; `defannotation` declarations.
         (loop (match (sx-get rest (load i))
                 (Some [k]
                       (if (= (sx-tag k) (primitive/cast i64 3))
                           (let [vp
                                   (try! (need [Sexp]
                                               (sx-get rest (primitive/iadd (load i) 1))
                                               (sconcat3 a "defn '" name "': annotation missing value")))
                                 av (try! (parse-expr a vp))
                                 ap (primitive/alloc-stack Annotation)]
                             (store! (field ap key) (sx-sval k))
                             (store! (field ap value) av)
                             (push! (mut annotations) (load ap))
                             (store! i (primitive/iadd (load i) 2)))
                           (break)))
                 (None [] (break))))
         (let [tpr (primitive/alloc-stack TPResult)]
           (store! tpr
                   (match (parse-type-params a rest (load i))
                     (Ok [value] value)
                     (Err [error] (break :try (Err error)))))
           (when (load (field tpr consumed)) (store! i (primitive/iadd (load i) 1)) 0)
           (let [params-items
                   (try! (need-vec (sx-get rest (load i)) (sconcat3 a "defn '" name "': expected parameter vector")))]
             (store! i (primitive/iadd (load i) 1))
             (let [(mut params) (al-new [Param] a)
                   (mut macrov) false
                   np (sx-len params-items)
                   (mut pi) 0]
               ; Two-argument set! is assignment syntax. Reject precisely the
               ; uncallable definition while leaving the three-argument Set trait
               ; method available to impls.
               (when (and (= raw-name "set!") (= np (primitive/cast i64 2)))
                 (break :try
                          (Err [Func Diag]
                               (derr-at (sx-lo namef)
                                        (sx-hi namef)
                                        "cannot define two-argument 'set!': that arity is reserved for place assignment"))))
               (loop (if (>= (load pi) np)
                         (break)
                         (let [p (sx-at params-items (load pi))]
                           (store! pi (primitive/iadd (load pi) 1))
                           (if (and (= (sx-tag p) (primitive/cast i64 2)) (= (sx-sval p) "&"))
                               (do (store! macrov true) 0)
                               (let [pl (try! (as-list p "parameter must be (name :type)"))
                                     pnf (sx-at pl 0)
                                     _pncheck (try! (sym-of a pnf "param name"))
                                     pn (lexical-name a pnf)
                                     pt (try! (parse-type a (try! (need [Sexp] (sx-get pl 1) "param missing type"))))]
                                 (let [pp (primitive/alloc-stack Param)]
                                   (set! (.bid pp) 0)
                                   (set! (.owned_type pp) (primitive/cast (ptr Type) 0))
                                   (if (type-pack-var? (box-type a pt))
                                       (if (and (< (load pi) np)
                                                (= (sx-tag (sx-at params-items (load pi))) (primitive/cast i64 2))
                                                (= (sx-sval (sx-at params-items (load pi))) "..."))
                                           (do
                                             (store! (field pp name) (sconcat a pn "..."))
                                             (store! pi (primitive/iadd (load pi) 1)))
                                           (break :try
                                                    (Err [Func Diag]
                                                         (derr-at (sx-lo p)
                                                                  (sx-hi p)
                                                                  "a pack-typed parameter must be followed by ..."))))
                                       (store! (field pp name) pn))
                                   (store! (field pp ty) pt)
                                   (push! (mut params) (load pp))))))))
               (let [ret-l
                       (try! (as-list (try! (need [Sexp] (sx-get rest (load i)) "defn: missing (-> :type)"))
                                      "expected (-> :type)"))]
                 (when (not (= (match (head-sym a ret-l) (Ok [value] value) (Err [error] (break :try (Err error))))
                               "->"))
                   (break :try (Err [Func Diag] (derr "defn: expected (-> :type) after params"))))
                 (let [ret (try! (parse-type a (try! (need [Sexp] (sx-get ret-l 1) "(-> ) missing type"))))]
                   (store! i (primitive/iadd (load i) 1))
                   ; An empty body is SYNTACTICALLY fine — it is a body of type void,
                   ; and the checker reports the mismatch against a non-void return
                   ; type. Rejecting it here produced "empty body", which reads like the
                   ; body was lost to a paren bug; the type error names the real problem
                   ; and `(defn f [] (-> void))` is legitimately empty.
                   (let [body (try! (parse-exprs a (rest-from a rest (load i))))]
                     (Ok (let [f (primitive/alloc-stack Func)]
                           (store! (field f name) name)
                           (store! (field f type_params) (load (field tpr params)))
                           (store! (field f bounds) (load (field tpr bounds)))
                           (store! (field f cc) (load cc))
                           (store! (field f annotations) (box-al [Annotation] a (load annotations)))
                           (store! (field f params) (box-al [Param] a (load params)))
                           (store! (field f ret) ret)
                           (store! (field f body) body)
                           (store! (field f macro_variadic) (load macrov))
                           (store! (field f lo) -1)
                           (store! (field f hi) -1)
                           (store! (field f source) -1)
                           (store! (field f ctxt) 0)
                           (load f))))))))))))

; ---- impl-target helpers ----
; The dispatch KEY a type carries an impl under: nominal types by (base) name,
; scalars by spelling, and each structural type by a pseudo-name ("slice", "ptr",
; "array", "vec", "fn") — so structural types are first-class impl targets, not
; second-class ones. "" = can't carry an impl (void/ref/never/code/externref).
;
; The key names only the head CONSTRUCTOR: `(Pair i64 i64)` and `(Pair A B)` both
; key to "Pair", and every pointer type keys to "ptr". So the key is an INDEX, not
; an identity — it narrows the candidates, and `check.coil::impl-match` then matches
; the receiver against the impl's own `self_type` pattern. Keep this in sync with
; `check.coil::type-impl-name`/`has-impl-name`, which mirror it on type tags.
(defn impl-base-name [(a (dyn Allocator)) (t (ptr Type))] (-> (slice u8))
  (match (load t)
    (TStruct [n] n)
    (TApp [n _args] n)
    (TInt [b s] (sconcat a (if s "i" "u") (i64->str a b)))
    (TBool [] "bool")
    (TFloat [b] (sconcat a "f" (i64->str a b)))
    (TSlice [_e] "slice")
    (TPtr [_e] "ptr")
    (TArray [_e _n] "array")
    (TVec [_e _n] "vec")
    (TFn [_cc _p _r] "fn")
    ; Code is a first-class value in the compiled metaprogram engine (checkers pass
    ; it around, store it in HashMaps), so it can carry impls like any other data
    ; type — e.g. `impl Display Code` for metaprogram diagnostics. Its methods take a
    ; Code param, so they are comptime-only functions dropped before mono
    ; (mono.coil::func-has-code) — no codegen impact. void/ref/never/externref stay
    ; impl-less: they are non-values, places, or opaque host handles.
    (TCode [] "code")
    (TCodeBuilder [] "codebuilder")
    (_ "")))

; Does `t` mention `nm` as a nominal type reference (a type parameter is a bare
; TStruct reference)?
(defn type-list-mentions-name [(v (ptr (ArrayList Type))) (nm (slice u8))] (-> bool)
  (let [n (len (load v))
        (mut i) 0
        (mut r) false]
    (loop (if (>= (load i) n)
              (break)
              (do
                (let [tv (primitive/alloc-stack Type)]
                  (set! tv (get (load v) (load i)))
                  (when (type-mentions-name tv nm) (store! r true) 0))
                (set! i (primitive/iadd (load i) 1)))))
    (load r)))

(defn type-mentions-name [(t (ptr Type)) (nm (slice u8))] (-> bool)
  (match (load t)
    (TStruct [n] (= n nm))
    (TApp [n args] (or (= n nm) (type-list-mentions-name args nm)))
    (TPtr [p] (type-mentions-name p nm))
    (TRef [_m p] (type-mentions-name p nm))
    (TSlice [p] (type-mentions-name p nm))
    (TArray [p _n] (type-mentions-name p nm))
    (TVec [p _n] (type-mentions-name p nm))
    (TFn [_cc ps r] (or (type-list-mentions-name ps nm) (type-mentions-name r nm)))
    (_ false)))

(defn parse-trait-method [(a (dyn Allocator)) (m Sexp)] (-> (Result TraitMethod Diag))
  (try (let [ml (try! (as-list m "trait method must be (name [params] (-> ret))"))
             mname (try! (sym-of a (try! (need [Sexp] (sx-get ml 0) "trait method: missing name")) "method name"))
             (mut i) 1
             (mut annotations) (al-new [Annotation] a)]
         (loop (match (sx-get ml (load i))
                 (Some [k]
                       (if (= (sx-tag k) (primitive/cast i64 3))
                           (let [vp
                                   (try! (need [Sexp]
                                               (sx-get ml (primitive/iadd (load i) 1))
                                               (sconcat3 a "trait method '" mname "': annotation missing value")))
                                 ap (primitive/alloc-stack Annotation)]
                             (store! (field ap key) (sx-sval k))
                             (store! (field ap value) (try! (parse-expr a vp)))
                             (push! (mut annotations) (load ap))
                             (store! i (primitive/iadd (load i) 2)))
                           (break)))
                 (None [] (break))))
         (if (>= (load i) (sx-len ml))
             (Err [TraitMethod Diag]
                  (derr-at (sx-lo m)
                           (sx-hi m)
                           (sconcat3 a "trait method '" mname "': missing typed signature")))
             (let [params-items
                     (if (opt-is-vec (sx-get ml (load i)))
                         (sx-items (opt-get (sx-get ml (load i))))
                         (break :try
                                  (Err [TraitMethod Diag]
                                       (derr-at (sx-lo m)
                                                (sx-hi m)
                                                (sconcat3 a "trait method '" mname "': expected a param vector")))))
                   (mut params) (al-new [Param] a)
                   pn (sx-len params-items)
                   (mut pi) 0]
               (loop (if (>= (load pi) pn)
                         (break)
                         (let [pl (try! (as-list (sx-at params-items (load pi)) "method param must be (name :type)"))
                               pp (primitive/alloc-stack Param)]
                           (set! (.bid pp) 0)
                           (set! (.owned_type pp) (primitive/cast (ptr Type) 0))
                           (store! pi (primitive/iadd (load pi) 1))
                           (let [pnf (sx-at pl 0)]
                             (try! (sym-of a pnf "param name"))
                             (store! (field pp name) (lexical-name a pnf)))
                           (store! (field pp ty)
                                   (try! (parse-type a (try! (need [Sexp] (sx-get pl 1) "method param missing type")))))
                           (when (type-pack-var? (field pp ty))
                             (if (and (< (load pi) pn)
                                      (= (sx-tag (sx-at params-items (load pi))) (primitive/cast i64 2))
                                      (= (sx-sval (sx-at params-items (load pi))) "..."))
                                 (do
                                   (store! (field pp name) (sconcat a (load (field pp name)) "..."))
                                   (store! pi (primitive/iadd (load pi) 1)))
                                 (break :try
                                          (Err [TraitMethod Diag]
                                               (derr-at (sx-lo m)
                                                        (sx-hi m)
                                                        "a pack-typed method parameter must be followed by ...")))))
                           (push! (mut params) (load pp)))))
               (let [ret-l
                       (try! (as-list (try! (need [Sexp]
                                                  (sx-get ml (primitive/iadd (load i) 1))
                                                  "trait method: missing (-> ret)"))
                                      "expected (-> ret)"))]
                 (when (not (= (try! (head-sym a ret-l)) "->"))
                   (break :try
                            (Err [TraitMethod Diag]
                                 (derr-at (sx-lo m)
                                          (sx-hi m)
                                          (sconcat3 a "trait method '" mname "': expected (-> ret)")))))
                 (let [mp (primitive/alloc-stack TraitMethod)]
                   (store! (field mp name) mname)
                   (store! (field mp annotations) (box-al [Annotation] a (load annotations)))
                   (store! (field mp params) (box-al [Param] a (load params)))
                   (store! (field mp ret)
                           (try! (parse-type a (try! (need [Sexp] (sx-get ret-l 1) "(-> ) missing type")))))
                   (Ok (load mp)))))))))

(defn parse-deftrait [(a (dyn Allocator)) (rest (ptr (ArrayList Sexp)))] (-> (Result TraitDef Diag))
  (try (let [namef (try! (need [Sexp] (sx-get rest 0) "deftrait: missing name"))
             _namecheck (try! (sym-of a namef "trait name"))
             name (lexical-name a namef)
             ; [Self …]: the first entry is Self; any further entries are EXTRA
             ; trait type parameters, determined by Self.
             tp-items
               (if (and (opt-is-vec (sx-get rest 1))
                        (> (sx-len (sx-items (opt-get (sx-get rest 1)))) (primitive/cast i64 0)))
                   (sx-items (opt-get (sx-get rest 1)))
                   (return-from :try (Err [TraitDef Diag] (derr "deftrait: expected [Self …] after the name"))))
             ; A trait's type parameters are BINDERS: the method signatures below
             ; refer to them as types, and those references keep their lexical
             ; identity. Taking the spelling here made the two sides unmatchable
             ; in a generated trait -- `method 'm': needs a Self (Self) parameter`.
             self-param (try! (lexical-sym-of a (sx-at tp-items 0) "trait type parameter"))
             (mut type-params) (al-new [(slice u8)] a)
             (mut requires) (al-new [(slice u8)] a)
             ntp (sx-len tp-items)
             (mut tpi) 1
             (mut methods) (al-new [TraitMethod] a)
             nr (sx-len rest)
             (mut mi) 2]
         (loop (if (>= (load tpi) ntp)
                   (break)
                   (do
                     (push! (mut type-params)
                            (match (lexical-sym-of a (sx-at tp-items (load tpi)) "trait type parameter")
                              (Ok [temporary] temporary)
                              (Err [temporary] (break :try (Err temporary)))))
                     (store! tpi (primitive/iadd (load tpi) 1)))))
         ; optional `:requires [Base …]` supertrait clause, sitting between the type-param
         ; vector and the methods (gen-8). It keeps supertraits OFF the `[Self …]` axis, which
         ; is for associated-type parameters — the two used to share one vector and silently
         ; mean different things. When present, methods start after it (primitive/index 4).
         (match (sx-get rest 2)
           (Some [k]
                 (when (and (= (sx-tag k) (primitive/cast i64 3)) (= (sx-sval k) "requires"))
                   (let [rv (try! (need [Sexp] (sx-get rest 3) "deftrait: ':requires' needs a [Base …] vector"))]
                     (when (not (= (sx-tag rv) (primitive/cast i64 7)))
                       (break :try
                                (Err [TraitDef Diag]
                                     (derr-at (sx-lo rv)
                                              (sx-hi rv)
                                              "deftrait: ':requires' needs a [Base …] vector"))))
                     (let [ri (sx-items rv)
                           nri (sx-len ri)
                           (mut rj) 0]
                       (loop (if (>= (load rj) nri)
                                 (break)
                                 (do
                                   ; same for a supertrait in `:requires`
                                   (push! (mut requires)
                                          (match (lexical-sym-of a (sx-at ri (load rj)) "supertrait name")
                                            (Ok [temporary] temporary)
                                            (Err [temporary] (break :try (Err temporary)))))
                                   (store! rj (primitive/iadd (load rj) 1))))))
                     (store! mi 4)
                     0)))
           (None [] 0))
         (loop (if (>= (load mi) nr)
                   (break)
                   (do
                     (push! (mut methods)
                            (match (parse-trait-method a (sx-at rest (load mi)))
                              (Ok [temporary] temporary)
                              (Err [temporary] (break :try (Err temporary)))))
                     (store! mi (primitive/iadd (load mi) 1)))))
         (Ok (let [t (primitive/alloc-stack TraitDef)]
               (store! (field t name) name)
               (store! (field t self_param) self-param)
               (store! (field t type_params) (box-al [(slice u8)] a (load type-params)))
               (store! (field t requires) (box-al [(slice u8)] a (load requires)))
               (store! (field t methods) (box-al [TraitMethod] a (load methods)))
               (load t))))))

; Dynamic-trait layouts are compiler-owned declarations.  Creating them while the
; trait itself is parsed makes `(dyn Trait)` available to every later type position,
; including while the metaprogram context is being assembled (before a source-level
; `defdyn` call could have expanded).  The names remain an internal lowering detail;
; resolution exposes them through the originating trait, not as separately exported
; declarations.
(defn dyn-vtable-fields [(a (dyn Allocator)) (td (ptr TraitDef))] (-> (ptr (ArrayList Field)))
  (let [methods (load (field td methods))
        n (len (load methods))
        (mut fields) (al-new [Field] a)
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (let [mp (primitive/index (load (field methods data)) (load i))
                      ps (load (field mp params))
                      np (len (load ps))
                      (mut erased) (al-new [Type] a)
                      (mut j) 0]
                  (loop (if (>= (load j) np)
                            (break)
                            (do
                              (if (= (load j) (primitive/cast i64 0))
                                  (push! (mut erased) (TPtr (box-type a (TInt 8 false))))
                                  (push! (mut erased)
                                         (.ty (primitive/index (load (field ps
                                                                            data))
                                                               (load j)))))
                              (set! j (primitive/iadd (load j) 1)))))
                  (let [fp (primitive/alloc-stack Field)]
                    (set! (.name fp) (.name mp))
                    (set! (.ty fp)
                          (TFn
                            :cc "c"
                            :params (box-al [Type] a (load erased))
                            :ret (box-type a (.ret mp))))
                    (push! (mut fields) (load fp))))
                (set! i (primitive/iadd (load i) 1)))))
    (box-al [Field] a (load fields))))

(defn dyn-struct-def [(a (dyn Allocator)) (td (ptr TraitDef)) (vtable bool)] (-> StructDef)
  (let [name (.name td)
        vtname (sconcat a name "-vtable")
        (mut fields) (al-new [Field] a)]
    (if vtable
        (let [generated (dyn-vtable-fields a td)]
          (set! fields (load generated)))
        (let [dataf (primitive/alloc-stack Field)
              vtf (primitive/alloc-stack Field)]
          (set! (.name dataf) "data")
          (set! (.ty dataf) (TPtr (box-type a (TInt 8 false))))
          (push! (mut fields) (load dataf))
          (set! (.name vtf) "vtable")
          (set! (.ty vtf) (TPtr (box-type a (TStruct vtname))))
          (push! (mut fields) (load vtf))))
    (let [sd (primitive/alloc-stack StructDef)]
      (set! (.name sd) (if vtable vtname (sconcat a name "-dyn")))
      (set! (.type_params sd) (box-al [(slice u8)] a (al-new [(slice u8)] a)))
      (set! (.bounds sd) (box-al [Bound] a (al-new [Bound] a)))
      (set! (.layout sd) (LC))
      (set! (.fields sd) (box-al [Field] a (load fields)))
      (load sd))))

(defn dyn-self-param? [(t (ptr Type)) (self-name (slice u8))] (-> bool)
  (match (load t) (TPtr [p] (match (load p) (TStruct [n] (= n self-name)) (_ false))) (_ false)))

(defn trait-object-safe? [(td (ptr TraitDef))] (-> bool)
  (let [self-name (.self_param td)
        methods (load (field td methods))
        n (len (load methods))
        (mut i) 0
        (mut safe) true]
    (loop (if (>= (load i) n)
              (break)
              (do
                (let [mp (primitive/index (load (field methods data)) (load i))
                      ps (load (field mp params))
                      np (len (load ps))]
                  (if (or (= np (primitive/cast i64 0))
                          (not (dyn-self-param? (field (primitive/index (load (field ps data)) 0) ty) self-name)))
                      (set! safe false)
                      (let [(mut j) 1]
                        (loop (if (>= (load j) np)
                                  (break)
                                  (do
                                    (when (type-mentions-name (field (primitive/index (load (field ps
                                                                                                   data))
                                                                                      (load j))
                                                                     ty)
                                                              self-name)
                                      (store! safe false)
                                      (break))
                                    (set! j (primitive/iadd (load j) 1)))))
                        (when (type-mentions-name (field mp ret) self-name) (store! safe false) 0))))
                (when (not (load safe)) (break))
                (set! i (primitive/iadd (load i) 1)))))
    (load safe)))

; `(impl Trait Type …)` or the GENERIC form `(impl [T] Trait (ArrayList T) …)`:
; an optional leading type-parameter vector, then the
; full implementing type. Each method carries the impl's type params as its own
; (the lowered functions are ordinary generic functions); every declared param
; must appear in the implementing type (dispatch infers them from the receiver).
;
; An INHERENT impl omits the trait:
;   `(impl Point (length [(self Point)] (-> i64) …))`
;   `(impl [T] (Box T) (get [(self (ptr (Box T)))] (-> T) …))`
; It is unambiguous because the form after the target is a method: a list whose
; second item is a parameter vector and whose third item is `(-> Type)`. In the
; trait form, the item after the trait is a TYPE instead. `ImplKind` records the
; distinction explicitly; inherent methods are still lowered to ordinary Funcs.
(defn impl-method-form? [(o (Option Sexp))] (-> bool)
  (match o
    (None [] false)
    (Some [s]
          (if (!= (sx-tag s) (primitive/cast i64 6))
              false
              (let [xs (sx-items s)]
                (if (< (sx-len xs) (primitive/cast i64 3))
                    false
                    (let [ps (sx-at xs 1)
                          rt (sx-at xs 2)]
                      (and (= (sx-tag ps) (primitive/cast i64 7))
                           (and (= (sx-tag rt) (primitive/cast i64 6))
                                (let [rs (sx-items rt)]
                                  (and (> (sx-len rs) (primitive/cast i64 0))
                                       (and (= (sx-tag (sx-at rs 0)) (primitive/cast i64 2))
                                            (= (sx-sval (sx-at rs 0)) "->")))))))))))))

(defn parse-impl [(a (dyn Allocator)) (rest0 (ptr (ArrayList Sexp))) (slo i64) (shi i64) (ssrc i64) (sctxt i64)] (-> (Result ImplDef
                                                                                                                             Diag))
  (try (let [has-tps (opt-is-vec (sx-get rest0 0))
             (mut type-params) (al-new [(slice u8)] a)
             (mut bounds) (al-new [Bound] a)
             ; This is a value, not an action: spell out the false branch so an
             ; older bootstrap compiler cannot leave the non-generic offset
             ; unspecified while compiling this parser.
             base (if has-tps 1 0)]
         ; optional leading [T …] type-parameter vector; entries may carry bounds —
         ; `(impl [(T Eq)] Eq (Box T) …)` — parsed by the same entry parser `defn` uses.
         (when has-tps
           (let [v (sx-items (opt-get (sx-get rest0 0)))
                 nv (sx-len v)
                 (mut vi) 0]
             (when (= nv (primitive/cast i64 0))
               (break :try (Err [ImplDef Diag] (derr "impl: the type-parameter vector may not be empty"))))
             (loop (if (>= (load vi) nv)
                       (break)
                       (do
                         (let [ep (primitive/alloc-stack TPEntry)]
                           (store! ep
                                   (match (parse-tparam-entry a (sx-at v (load vi)))
                                     (Ok [entry] entry)
                                     (Err [diag] (break :try (Err diag)))))
                           (push! (mut type-params) (load (field ep name)))
                           (when (> (len (load (load (field ep
                                                            traits))))
                                    (primitive/cast i64 0))
                             (let [bp (primitive/alloc-stack Bound)]
                               (store! (field bp name) (load (field ep name)))
                               (store! (field bp traits) (load (field ep traits)))
                               (push! (mut bounds) (load bp))
                               0)))
                         (store! vi (primitive/iadd (load vi) 1)))))
             0))
         (let [; `rest0` excludes the `impl` head. A one-method inherent impl has
               ; exactly two remaining forms (target + method), so form count
               ; cannot distinguish it from a marker-trait impl. The second form's
               ; grammar can: a method has `[params] (-> ret)` in slots 1 and 2.
               inherent (impl-method-form? (sx-get rest0 (primitive/iadd base 1)))
               trait-name
                 (if inherent
                     ""
                     (try! (lexical-sym-of a
                                           (try! (need [Sexp] (sx-get rest0 base) "impl: missing trait name"))
                                           "trait name")))
               target-idx (if inherent base (primitive/iadd base 1))
               target (try! (need [Sexp] (sx-get rest0 target-idx) "impl: missing implementing type"))
               self-type (try! (parse-type a target))
               stp (primitive/alloc-stack Type)]
           (store! stp self-type)
           (let [for-type (impl-base-name a stp)]
             (when (= (len for-type) (primitive/cast i64 0))
               (break :try
                        (Err [ImplDef Diag]
                             (derr-at (sx-lo target)
                                      (sx-hi target)
                                      "impl: this type can't carry an impl (name a struct, sum, scalar, generic instance, (slice T), (ptr T), array, vector, or fn type)"))))
             ; every impl type param must be inferable from the implementing type
             (let [ntp2 (len (load type-params))
                   (mut ck) 0]
               (loop (if (>= (load ck) ntp2)
                         (break)
                         (let [pn (get (load type-params) (load ck))]
                           (when (not (type-mentions-name stp pn))
                             (break :try
                                      (Err [ImplDef Diag]
                                           (derr-at (sx-lo target)
                                                    (sx-hi target)
                                                    (sconcat3 a
                                                              "impl: type parameter '"
                                                              pn
                                                              "' must appear in the implementing type")))))
                           (store! ck (primitive/iadd (load ck) 1))))))
             (let [(mut methods) (al-new [Func] a)
                   nr (sx-len rest0)
                   (mut mi) (if inherent (primitive/iadd base 1) (primitive/iadd base 2))]
               ; Marker traits deliberately have no methods, so `(impl Marker T)`
               ; is a complete trait implementation. Only an inherent impl has no
               ; declaration to make an empty body meaningful.
               (when (and inherent (>= (load mi) nr))
                 (break :try
                          (Err [ImplDef Diag]
                               (derr-at slo shi "inherent impl must define at least one method"))))
               (loop (if (>= (load mi) nr)
                         (break)
                         (let [m (sx-at rest0 (load mi))]
                           (store! mi (primitive/iadd (load mi) 1))
                           (let [ml (try! (as-list m "impl method must be (name [params] (-> ret) body…)"))
                                 ; `call` is permitted in every trait impl. Value-call
                                 ; syntax discovers it after ordinary trait resolution.
                                 f0 (try! (parse-defn a ml (not inherent)))]
                             (let [fp (primitive/alloc-stack Func)]
                               (store! fp f0)
                               (when (> (len (load (load (field fp
                                                                type_params))))
                                        (primitive/cast i64 0))
                                 (break :try
                                          (Err [ImplDef Diag]
                                               (derr-at (sx-lo m)
                                                        (sx-hi m)
                                                        (sconcat3 a
                                                                  "impl method '"
                                                                  (load (field fp name))
                                                                  "': declare type parameters on the impl, not the method")))))
                               (store! (field fp type_params) (box-al [(slice u8)] a (load type-params)))
                               ; The impl's bounds become each lowered method's own bounds. Methods
                               ; are ordinary generic functions, so this is all it takes: the body
                               ; typechecks against the bound (cur_bounds), and every call site is
                               ; verified by the existing `ca-check-bounds` on the method's Sig.
                               (store! (field fp bounds) (box-al [Bound] a (load bounds)))
                               (store! (field fp lo) slo)
                               (store! (field fp hi) shi)
                               (store! (field fp source) ssrc)
                               (store! (field fp ctxt) sctxt)
                               (push! (mut methods) (load fp)))))))
               (Ok (let [im (primitive/alloc-stack ImplDef)]
                     (store! (field im kind) (if inherent (InherentImpl) (TraitImpl trait-name)))
                     (store! (field im for_type) for-type)
                     (store! (field im type_params) (box-al [(slice u8)] a (load type-params)))
                     (store! (field im bounds) (box-al [Bound] a (load bounds)))
                     (store! (field im self_type) self-type)
                     (store! (field im methods) (box-al [Func] a (load methods)))
                     (load im)))))))))

(defn parse-export-c [(a (dyn Allocator)) (rest (ptr (ArrayList Sexp)))] (-> (Result (ptr (ArrayList ExportC)) Diag))
  (try (let [(mut out) (al-new [ExportC] a)
             n (sx-len rest)
             (mut i) 0]
         (loop (if (>= (load i) n)
                   (break)
                   (let [item (sx-at rest (load i))]
                     (store! i (primitive/iadd (load i) 1))
                     (let [tg (sx-tag item)]
                       (if (= tg (primitive/cast i64 2))
                           (let [ep (primitive/alloc-stack ExportC)]
                             (store! (field ep name) (sx-sval item))
                             (store! (field ep symbol) (None [(slice u8)]))
                             (store! (field ep params) (box-al [Type] a (al-new [Type] a)))
                             (store! (field ep lo) (sx-lo item))
                             (store! (field ep hi) (sx-hi item))
                             (store! (field ep source) (sx-source item))
                             (store! (field ep ctxt) (sx-ctxt item))
                             (push! (mut out) (load ep)))
                           (if (= tg (primitive/cast i64 7))
                               (let [v (sx-items item)
                                     nm
                                       (if (and (> (sx-len v) (primitive/cast i64 0))
                                                (= (sx-tag (sx-at v 0)) (primitive/cast i64 2)))
                                           (sx-sval (sx-at v 0))
                                           (return-from :try
                                                          (Err [(ptr (ArrayList ExportC)) Diag]
                                                               (derr-at (sx-lo item)
                                                                        (sx-hi item)
                                                                        "export-c: expected [name :as \"symbol\"]"))))
                                     sym0
                                       (if (and (opt-is-kw (sx-get v 1) "as") (opt-is-str (sx-get v 2)))
                                           (opt-str-val (sx-get v 2))
                                           (return-from :try
                                                          (Err [(ptr (ArrayList ExportC)) Diag]
                                                               (derr-at (sx-lo item)
                                                                        (sx-hi item)
                                                                        "export-c: expected [name :as \"symbol\"]"))))]
                                 (let [ep (primitive/alloc-stack ExportC)]
                                   (store! (field ep name) nm)
                                   (store! (field ep symbol) (Some sym0))
                                   (store! (field ep params) (box-al [Type] a (al-new [Type] a)))
                                   (store! (field ep lo) (sx-lo item))
                                   (store! (field ep hi) (sx-hi item))
                                   (store! (field ep source) (sx-source item))
                                   (store! (field ep ctxt) (sx-ctxt item))
                                   (push! (mut out) (load ep))))
                               (return-from :try
                                              (Err [(ptr (ArrayList ExportC)) Diag]
                                                   (derr-at (sx-lo item)
                                                            (sx-hi item)
                                                            "export-c: each entry is a function name or [name :as \"symbol\"]")))))))))
         (Ok (box-al [ExportC] a (load out))))))

(defn default-c-convention [(a (dyn Allocator))] (-> Convention)
  (let [c (primitive/alloc-stack Convention)]
    (set! (.name c) "c")
    (set! (.params c) (box-al [(slice u8)] a (al-new [(slice u8)] a)))
    (set! (.ret c) (None [(slice u8)]))
    (set! (.clobber c) (box-al [(slice u8)] a (al-new [(slice u8)] a)))
    (set! (.preserve c) (box-al [(slice u8)] a (al-new [(slice u8)] a)))
    (set! (.lowering c) (LNative 0))
    (load c)))

; `parse_program` in: fold the top-level forms into a Program.
(defn parse-program [(a (dyn Allocator)) (forms (ptr (ArrayList Sexp)))] (-> (Result Program Diag))
  (let [(mut annotation-defs) (al-new [AnnotationDef] a)
        (mut convs) (al-new [Convention] a)
        (mut structs) (al-new [StructDef] a)
        (mut sums) (al-new [SumDef] a)
        (mut externs) (al-new [Extern] a)
        (mut funcs) (al-new [Func] a)
        (mut asserts) (al-new [StaticAssert] a)
        (mut consts) (al-new [Const] a)
        (mut traits) (al-new [TraitDef] a)
        (mut impls) (al-new [ImplDef] a)
        (mut metas) (al-new [Expr] a)
        (mut exports) (al-new [ExportC] a)
        (mut err) (primitive/zeroed Diag)
        (mut failed) false]
    (push! (mut convs) (default-c-convention a))
    (let [nf (sx-len forms)
          (mut fi) 0]
      (loop (if (>= (load fi) nf)
                (break)
                (let [form (sx-at forms (load fi))
                      flo (sx-lo form)
                      fhi (sx-hi form)
                      fsrc (sx-source form)
                      fctxt (sx-ctxt form)]
                  (set! fi (primitive/iadd (load fi) 1))
                  (let [res
                          (match (as-list form "top-level form must be a list")
                            (Err [d] (Err [i64 Diag] d))
                            (Ok [items]
                                (match (head-sym a items)
                                  (Err [d] (Err [i64 Diag] d))
                                  (Ok [head]
                                      (let [rest (rest-from a items 1)]
                                        (cond (= head "defcc")
                                                (match (parse-defcc a rest)
                                                  (Err [d] (Err [i64 Diag] d))
                                                  (Ok [c]
                                                      (let [cp (primitive/alloc-stack Convention)]
                                                        (store! cp c)
                                                        (let [nm (load (field cp name))
                                                              (mut found) -1
                                                              (mut ci) 0
                                                              cn (len (load convs))]
                                                          (loop (if (>= (load ci) cn)
                                                                    (break)
                                                                    (do
                                                                      (when (= (conv-name (get (load convs) (load ci)))
                                                                               nm)
                                                                        (store! found (load ci))
                                                                        0)
                                                                      (store! ci (primitive/iadd (load ci) 1)))))
                                                          (if (>= (load found) (primitive/cast i64 0))
                                                              (if (= nm "c")
                                                                  (do
                                                                    (set! (mut convs) (load found) (load cp))
                                                                    (Ok [i64 Diag] 0))
                                                                  (Err [i64 Diag]
                                                                       (derr (sconcat3 a
                                                                                       "convention '"
                                                                                       nm
                                                                                       "' defined twice"))))
                                                              (do (push! (mut convs) (load cp)) (Ok [i64 Diag] 0)))))))
                                              (= head "defannotation")
                                                (match (parse-defannotation a rest)
                                                  (Ok [ad]
                                                      (do
                                                        (push! (mut annotation-defs) ad)
                                                        (Ok [i64 Diag] 0)))
                                                  (Err [d] (Err [i64 Diag] d)))
                                              (= head "defstruct")
                                                (match (parse-defstruct a rest)
                                                  (Ok [sd] (do (push! (mut structs) sd) (Ok [i64 Diag] 0)))
                                                  (Err [d] (Err [i64 Diag] d)))
                                              (= head "defsum")
                                                (match (parse-defsum a rest)
                                                  (Ok [sd] (do (push! (mut sums) sd) (Ok [i64 Diag] 0)))
                                                  (Err [d] (Err [i64 Diag] d)))
                                              (= head "defn")
                                                (match (parse-defn a rest false)
                                                  (Err [d] (Err [i64 Diag] d))
                                                  (Ok [f0]
                                                      (let [fp (primitive/alloc-stack Func)]
                                                        (store! fp f0)
                                                        (store! (field fp lo) flo)
                                                        (store! (field fp hi) fhi)
                                                        (store! (field fp source) fsrc)
                                                        (store! (field fp ctxt) fctxt)
                                                        (let [nm (load (field fp name))
                                                              (mut dup) false
                                                              (mut ci) 0
                                                              cn (len (load funcs))]
                                                          (loop (if (>= (load ci) cn)
                                                                    (break)
                                                                    (do
                                                                      (when (= (func-name (get (load funcs) (load ci)))
                                                                               nm)
                                                                        (store! dup true)
                                                                        0)
                                                                      (store! ci (primitive/iadd (load ci) 1)))))
                                                          (if (load dup)
                                                              (Err [i64 Diag]
                                                                   (derr (sconcat3 a
                                                                                   "function '"
                                                                                   nm
                                                                                   "' defined twice")))
                                                              (do
                                                                (push! (mut funcs) (load fp))
                                                                (Ok [i64 Diag] 0)))))))
                                              (= head "extern")
                                                (match (parse-extern a rest)
                                                  (Ok [e] (do (push! (mut externs) e) (Ok [i64 Diag] 0)))
                                                  (Err [d] (Err [i64 Diag] d)))
                                              (= head "export-c")
                                                (match (parse-export-c a rest)
                                                  (Err [d] (Err [i64 Diag] d))
                                                  (Ok [es]
                                                      (do
                                                        (let [en (len (load es))
                                                              (mut ei) 0]
                                                          (loop (if (>= (load ei) en)
                                                                    (break)
                                                                    (do
                                                                      (push! (mut exports)
                                                                             (get (load es) (load ei)))
                                                                      (store! ei (primitive/iadd (load ei) 1))))))
                                                        (Ok [i64 Diag] 0))))
                                              (= head "static-assert")
                                                (match (parse-static-assert a items)
                                                  (Ok [sa]
                                                      (do
                                                        (push! (mut asserts) sa)
                                                        (Ok [i64 Diag] 0)))
                                                  (Err [d] (Err [i64 Diag] d)))
                                              (= head "const")
                                                (match (parse-const a rest)
                                                  (Ok [c]
                                                      (do
                                                        (push! (mut consts) c)
                                                        (Ok [i64 Diag] 0)))
                                                  (Err [d] (Err [i64 Diag] d)))
                                              (= head "deftrait")
                                                (match (parse-deftrait a rest)
                                                  (Ok [t]
                                                      (let [tp (primitive/alloc-stack TraitDef)]
                                                        (store! tp t)
                                                        (push! (mut traits) t)
                                                        (when (trait-object-safe? tp)
                                                          (push! (mut structs) (dyn-struct-def a tp true))
                                                          (push! (mut structs) (dyn-struct-def a tp false))
                                                          0)
                                                        (Ok [i64 Diag] 0)))
                                                  (Err [d] (Err [i64 Diag] d)))
                                              (= head "defdyn-marker") (Ok [i64 Diag] 0)
                                              ; `import` is already fully processed by the loader
                                              ; into the import tables. It is kept in the form
                                              ; list so that metaprograms can SEE it — "which
                                              ; namespaces does this module import?" is a basic
                                              ; question for a transform, and it was unanswerable
                                              ; while the loader dropped the form. By the time
                                              ; parsing runs there is nothing left to do with it.
                                              (= head "import") (Ok [i64 Diag] 0)
                                              (= head "export") (Ok [i64 Diag] 0)
                                              (= head "reader-provider") (Ok [i64 Diag] 0)
                                              ; Expansion pre-scan consumes this declaration
                                              ; into the derive registry. Treat it like import
                                              ; when a resolve-only tool parses the pre-expanded
                                              ; declaration surface.
                                              (= head "register-derive") (Ok [i64 Diag] 0)
                                              (= head "impl")
                                                (match (parse-impl a
                                                                   rest
                                                                   flo
                                                                   fhi
                                                                   fsrc
                                                                   fctxt)
                                                  (Ok [im]
                                                      (do
                                                        (push! (mut impls) im)
                                                        (Ok [i64 Diag] 0)))
                                                  (Err [d] (Err [i64 Diag] d)))
                                              (= head "meta")
                                                (if (not (= (sx-len items) (primitive/cast i64 2)))
                                                    (Err [i64 Diag]
                                                         (derr "meta: expected (meta EXPR)"))
                                                    (match (parse-expr a
                                                                       (sx-at items
                                                                              1))
                                                      (Ok [e]
                                                          (do
                                                            (push! (mut metas) e)
                                                            (Ok [i64 Diag] 0)))
                                                      (Err [d] (Err [i64 Diag] d))))
                                              :else
                                                (Err [i64 Diag]
                                                     (derr (sconcat3 a
                                                                     "unknown top-level form '"
                                                                     head
                                                                     "'")))))))))]
                    (match res
                      (Ok [_] 0)
                      (Err [d] (do (set! err (dwspan d fsrc flo fhi fctxt)) (set! failed true) (break)))))))))
    (if (load failed)
        (Err (load err))
        (Ok (let [pp (primitive/alloc-stack Program)]
              (set! (.annotation_defs pp) (box-al [AnnotationDef] a (load annotation-defs)))
              (set! (.conventions pp) (box-al [Convention] a (load convs)))
              (set! (.structs pp) (box-al [StructDef] a (load structs)))
              (set! (.sums pp) (box-al [SumDef] a (load sums)))
              (set! (.externs pp) (box-al [Extern] a (load externs)))
              (set! (.funcs pp) (box-al [Func] a (load funcs)))
              (set! (.asserts pp) (box-al [StaticAssert] a (load asserts)))
              (set! (.consts pp) (box-al [Const] a (load consts)))
              (set! (.traits pp) (box-al [TraitDef] a (load traits)))
              (set! (.impls pp) (box-al [ImplDef] a (load impls)))
              (set! (.metas pp) (box-al [Expr] a (load metas)))
              (set! (.exports pp) (box-al [ExportC] a (load exports)))
              (set! (.function_abis pp) (box-al [Extern] a (al-new [Extern] a)))
              (load pp))))))

; static-assert: condition presence + message rule.
(defn parse-static-condition [(a (dyn Allocator)) (s Sexp)] (-> (Result Expr Diag))
  ; Static assertions are evaluated before ordinary trait calls are lowered. Parse
  ; the public integer comparison spellings directly into ECmp here so `=`/`<`/…
  ; have exactly the same constant-expression support as their metal lowering.
  (if (= (sx-tag s) (primitive/cast i64 6))
      (let [items (sx-items s)]
        (if (> (sx-len items) (primitive/cast i64 0))
            (let [h (sx-at items 0)]
              (if (= (sx-tag h) (primitive/cast i64 2))
                  (let [name (sx-sval h)
                        op
                          (cond (= name "<") 0
                                (= name "<=") 1
                                (= name ">") 2
                                (= name ">=") 3
                                (= name "=") 4
                                (= name "!=") 5
                                :else -1)]
                    (if (>= op (primitive/cast i64 0))
                        (match (mk-cmp a (rest-from a items 1) name op)
                          (Ok [kind] (Ok (mk-expr kind (sx-lo s) (sx-hi s) (sx-source s) (sx-ctxt s))))
                          (Err [d] (Err d)))
                        (parse-expr a s)))
                  (parse-expr a s)))
            (parse-expr a s)))
      (parse-expr a s)))

(defn assert-msg [(a (dyn Allocator)) (items (ptr (ArrayList Sexp)))] (-> (Result (slice u8) Diag))
  (match (sx-get items 2)
    (None [] (Ok "static assertion failed"))
    (Some [s]
          (if (= (sx-tag s) (primitive/cast i64 4))
              (Ok (sx-sval s))
              (Err (derr "static-assert: message must be a string"))))))

(defn parse-static-assert [(a (dyn Allocator)) (items (ptr (ArrayList Sexp)))] (-> (Result StaticAssert Diag))
  (try (let [cond
               (try! (parse-static-condition a (try! (need [Sexp] (sx-get items 1) "static-assert: missing condition"))))
             msg (try! (assert-msg a items))]
         (Ok (let [ap (primitive/alloc-stack StaticAssert)]
               (store! (field ap cnd) cond)
               (store! (field ap
                              msg)
                       msg)
               (load ap))))))

; ============================ reused reader =================================
; Ported (and verified) in src/compiler/reader.coil — copied here so the parser can
; turn source into Sexp. Treat as already-correct.
