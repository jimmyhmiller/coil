;;; `coil doc` and `coil namespace`.
(module coil.compiler.cli_doc)
(import "coil.primitive" :as primitive)
(import "coil.alloc" :as alloc :use *)
(import "coil.result" :use *)
(import "coil.slice" :use *)
(import "coil.str" :as str :use * :exclude [parse-int])
(import "coil.arraylist" :use *)
(import "coil.hashmap" :use *)
(import "coil.pmap" :use *)
(import "coil.io" :use *)
(import "coil.control" :use *)
(import "coil.try" :use *)
(import "coil.compiler.env" :use *)
(import "coil.compiler.guide" :use *)
(import "coil.reader" :use *)
(import "coil.project" :use *)
(import "coil.compiler.ast" :use *)
(import "coil.compiler.parser" :use *)
(import "coil.compiler.loader" :use *)
(import "coil.compiler.stdlib_manifest" :use *)
(import "coil.compiler.resolve" :use *)
(import "coil.compiler.check" :use *)
(import "coil.compiler.mono" :use *)
(import "coil.compiler.diag" :use *)
(import "coil.compiler.metastate" :use *)
(import "coil.compiler.metaengine" :use *)
(import "coil.compiler.expander" :use *)
(import "coil.compiler.unit" :use *)
(import "coil.compiler.jit" :use *)
(import "coil.compiler.interp" :use *)
(import "coil.compiler.wasm" :use *)
(import "coil.compiler.codegen_wasm" :use *)
(import "coil.compiler.cli_base" :use *)
(import "coil.compiler.pipeline" :use *)

; Is this the head symbol of a definition worth documenting?
(defn doc-kind-of [(head (slice u8))] (-> (slice u8))
  (cond (or (= head "defn") (= head "defn*")) "fn"
        (= head "defstruct") "struct"
        (= head "defsum") "sum"
        (= head "deftrait") "trait"
        (= head "defcc") "convention"
        (= head "defprimitive") "primitive"
        (= head "const") "const"
        (= head "extern") "extern"
        ""))

; The signature to show: for a `defn`, everything up to and including the `(-> …)`
; return form (the header, without the body); for anything else, the whole form.
; Both are SOURCE TEXT, so what you read is what was written.
(defn doc-sig [(a (dyn Allocator)) (src (slice u8)) (form Sexp) (is-fn bool)]
  (-> (slice u8))
  (let [items (sx-items form)
        n (sx-len items)
        lo (sx-lo form)
        (mut end) (sx-hi form)]
    (if (not is-fn)
        (subslice [u8] src lo (load end))
        (let [(mut i) 1
              (mut found) false]
          (loop (if (or (load found) (>= (load i) n))
                    (break)
                    (do
                      (let [c (sx-at items (load i))]
                        (when (= (sx-tag c) 6)
                          ; a list …
                          (let [ci (sx-items c)]
                            (when (and (>= (sx-len ci) 1)
                                       (and (= (sx-tag (sx-at ci 0))
                                               2)
                                            (= (sx-sval (sx-at ci 0)) "->")))
                              (set! end (sx-hi c))
                              (set! found true)))))
                      (set! i (primitive/iadd (load i) 1)))))
          (if (load found)
              (sconcat a (subslice [u8] src lo (load end)) ")")
              (subslice [u8] src lo (sx-hi form)))))))

(defn doc-cmd [(a (dyn Allocator))
               (target (slice u8))
               (show-all bool)
               (exact-name (slice u8))
               (search (slice u8))] (-> i64)
  (let [disk (read-file a (to-cstr a target))
        bundled-file (stdlib-file-for-namespace target)
        src
          (if (> (len disk) 0)
              disk
              (if (= target "coil.core")
                  (stdlib-prelude-text a)
                  (if (> (len bundled-file) 0)
                      (bundled-text a bundled-file)
                      "")))
        w (stdout)]
    (if (= (len src) 0)
        (do
          (ps (stderr) "error: no file or bundled namespace named '")
          (ps (stderr) target)
          (ps (stderr) "'\n")
          1)
        (match (read-all a src 0)
          (Err [d]
               (let [(mut dp) d] (dump-error (stderr) (mut dp)) 1))
          (Ok [forms]
              (do
                (let [n (sx-len forms)
                      (mut i) 0
                      (mut shown) 0
                      (mut module-doc) false
                      (mut rc) 0]
                  ; the module header, if the file declares one
                  (loop (if (>= (load i) n)
                            (break)
                            (do
                              (let [f (sx-at forms (load i))]
                                (when (= (sx-tag f) 6)
                                  (let [items (sx-items f)]
                                    (when (and (>= (sx-len items)
                                                   2)
                                               (and (= (sx-tag (sx-at items 0))
                                                       2)
                                                    (= (sx-sval (sx-at items 0))
                                                       "module")))
                                      (ps w "# ")
                                      (ps w (sx-sval (sx-at items 1)))
                                      (wb w 10)
                                      (wb w 10)
                                      ; A `;;;` block above `(module …)` documents the
                                      ; module itself. It belongs to a whole-module
                                      ; listing, not to a lookup of one definition.
                                      (let [mdoc (ct-doc-at a src (sx-lo f))]
                                        (when (and (> (len mdoc) 0)
                                                   (= (len exact-name) 0)
                                                   (= (len search) 0))
                                          (ps w mdoc)
                                          (wb w 10)
                                          (wb w 10)
                                          (store! module-doc true)))
                                      0))))
                              (set! i (primitive/iadd (load i) 1)))))
                  (set! i 0)
                  (loop (if (or (>= (load i) n)
                                (and (> (len search) 0)
                                     (>= (load shown) 10)))
                            (break)
                            (do
                              (let [f (sx-at forms (load i))]
                                (when (= (sx-tag f) 6)
                                  (let [items (sx-items f)]
                                    (when (>= (sx-len items)
                                              2)
                                      (let [h (sx-at items 0)]
                                        (when (= (sx-tag h)
                                                 2)
                                          (let [kind (doc-kind-of (sx-sval h))]
                                            (when (> (len kind)
                                                     0)
                                              (let [name
                                                      (sx-sval (sx-at items 1))
                                                    doc
                                                      (ct-doc-at a
                                                                 src
                                                                 (sx-lo f))
                                                    sig
                                                      (doc-sig a
                                                               src
                                                               f
                                                               (= kind "fn"))
                                                    exact-ok
                                                      (or (= (len exact-name)
                                                             0)
                                                          (= name exact-name))
                                                    search-ok
                                                      (or (= (len search)
                                                             0)
                                                          (ref-contains-ci? name
                                                                            search)
                                                          (ref-contains-ci? kind
                                                                            search)
                                                          (ref-contains-ci? sig
                                                                            search)
                                                          (ref-contains-ci? doc
                                                                            search))]
                                                (when (and exact-ok
                                                           (and search-ok
                                                                (or show-all
                                                                    (> (len doc)
                                                                       0))))
                                                  (set! shown
                                                        (primitive/iadd (load shown)
                                                                        1))
                                                  (ps w "## ")
                                                  (ps w name)
                                                  (ps w "  *(")
                                                  (ps w kind)
                                                  (ps w ")*")
                                                  (wb w 10)
                                                  (wb w 10)
                                                  (ps w "```lisp")
                                                  (wb w 10)
                                                  (ps w sig)
                                                  (wb w 10)
                                                  (ps w "```")
                                                  (wb w 10)
                                                  (wb w 10)
                                                  (when (> (len doc)
                                                           0)
                                                    (ps w doc)
                                                    (wb w 10)
                                                    (wb w 10))
                                                  0))))))))))
                              (set! i (primitive/iadd (load i) 1)))))
                  (when (and (= (load shown) 0)
                             (not (load module-doc)))
                    (if (> (len exact-name) 0)
                        (do
                          (ps (stderr) "No definition named `")
                          (ps (stderr) exact-name)
                          (ps (stderr) "` in ")
                          (ps (stderr) target)
                          (ps (stderr) ".\n")
                          (set! rc 1))
                        (if (> (len search) 0)
                            (do
                              (ps (stderr) "No definitions matching `")
                              (ps (stderr) search)
                              (ps (stderr) "` in ")
                              (ps (stderr) target)
                              (ps (stderr) ".\n")
                              (set! rc 1))
                            (do
                              (ps (stderr) "note: no `;;;` doc comments in ")
                              (ps (stderr) target)
                              (ps (stderr)
                                  " — a doc is a `;;;` block directly above a definition\n")
                              0)))
                    0)
                  (load rc))))))))

(defn namespace-cmd [(a (dyn Allocator)) (argc i32) (argv (ptr (ptr i8)))]
  (-> i64)
  (let [n (primitive/cast i64 argc)]
    (if (< n 3)
        (do
          (ps (stderr)
              "usage: coil namespace <name|file.coil> [--name <definition>|--search <text>]\n")
          1)
        (let [target (from-cstr (load (index argv 2)))]
          (cond (= n 3) (doc-cmd a target true "" "")
                (and (= n 5)
                     (= (from-cstr (load (index argv 3))) "--name"))
                  (doc-cmd a
                           target
                           true
                           (from-cstr (load (index argv 4)))
                           "")
                (and (= n 5)
                     (= (from-cstr (load (index argv 3)))
                        "--search"))
                  (doc-cmd a
                           target
                           true
                           ""
                           (from-cstr (load (index argv 4))))
                (do
                  (ps (stderr)
                      "usage: coil namespace <name|file.coil> [--name <definition>|--search <text>]\n")
                  1))))))
