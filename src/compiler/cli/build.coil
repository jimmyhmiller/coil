(defn reader-invocation-set! [(a (dyn Allocator))
                              (argc i32)
                              (argv (ptr (ptr i8)))
                              (fidx i64)] (-> i64)
  (let [b (reader-invocation)
        (mut paths) (ArrayList::new [(slice u8)] a)
        (mut texts) (ArrayList::new [(slice u8)] a)
        (mut args) (ArrayList::new [(slice u8)] a)
        (mut i) 2
        (mut after) false]
    (when (> fidx 0)
      (let [p (from-cstr (load (index argv fidx)))]
        (push! (mut paths) p)
        (push! (mut texts) (read-src a (to-cstr a p))))
      0)
    (loop (if (>= (load i) (primitive/cast i64 argc))
              (break)
              (let [arg (from-cstr (load (index argv (load i))))]
                (if (load after)
                    (do
                      (push! (mut args) arg)
                      (set! i (primitive/iadd (load i) 1))
                      0)
                    (cond (= arg "--")
                            (do
                              (set! after true)
                              (set! i (primitive/iadd (load i) 1))
                              0)
                          (= (load i) fidx)
                            (do (set! i (primitive/iadd (load i) 1)) 0)
                          (is-flag? arg)
                            (do
                              (set! i
                                    (primitive/iadd (load i)
                                                    (if (flag-takes-value? arg)
                                                        2
                                                        1)))
                              0)
                          :else
                            (do
                              (push! (mut paths) arg)
                              (push! (mut texts) (read-src a (to-cstr a arg)))
                              (set! i (primitive/iadd (load i) 1))
                              0))))))
    (set! (.paths b) (load paths))
    (set! (.texts b) (load texts))
    (set! (.args b) (load args))
    (set! (.ready b) 1)
    0))

;;; The backend NAME names, in the codes unit-backend-name spells, or None.
(defn backend-named [(name (slice u8))] (-> (Option i64))
  (cond (= name "llvm") (Some 1)
        (= name "arm64") (Some 2)  ; tpde for arm64
        (= name "wasm") (Some 4)  ; native wasm64 (memory64)
        (or (= name "x64") (= name "x86_64")) (Some 5)  ; tpde for x86-64
        (= name "tpde") (Some 7)
        :else (None [i64])))

;;; The backend `COMMAND --backend NAME` asks for. A name that is no backend, or one
;;; COMMAND cannot use, is an error: a typo once built with LLVM, silently.
(defn backend-arg [(command (slice u8)) (name (slice u8)) (allow-wasm bool)]
  (-> i64)
  (match (backend-named name)
    (None []
          (do
            (let [w (stderr)]
              (ps w "error: unknown backend '")
              (ps w name)
              (ps w "': expected llvm, arm64, x64, wasm or tpde\n"))
            (exit 1)
            1))
    (Some [b]
          (if (and (= b 4) (not allow-wasm))
              (do
                (let [w (stderr)]
                  (ps w "error: ")
                  (ps w command)
                  (ps w
                      " cannot use --backend wasm, which emits whole modules; use `coil build`\n"))
                (exit 1)
                1)
              b))))

;;; Whether a build emits DWARF: with -g on every backend that can, and by
;;; default from the native backend, unless -g0 / --no-debug.
(defn build-emits-dwarf? [(backend i64) (wantg bool) (nodebug bool)] (-> bool)
  (and (not nodebug) (or wantg (native-backend? backend))))

; The one-switch development profile. Keep the individual flags available for
; focused use, but make the safe default discoverable and reproducible.
(defn enable-debug-runtime! [] (-> i64)
  (enable-debug-checks!)
  (select-sanitizer! 1 "address")
  (cli-use-add "coil.debug-runtime")
  0)

(defn sanitizer? [] (-> bool)
  (!= (sanitize-mode) 0))

(defn sanitizer-link-flag [] (-> (slice u8))
  (cond (= (sanitize-mode) 1) "-fsanitize=address"
        (= (sanitize-mode) 2) "-fsanitize=thread"
        (= (sanitize-mode) 3) "-fsanitize=memory"
        :else "-fsanitize=undefined"))

;;; Did this build compile a file whose only entry points are tests? Only then is the
;;; missing `_main` the user's command rather than their code.
(defn built-a-test-file? [] (-> bool)
  (and (> (.tests (entry-shape)) 0)
       (not (.has-main (entry-shape)))))

; A link flag we must NEVER pass to the metaprogram dylib link: an instrumentation
; flag on the dylib gets dlopen'd into the compiler and aborts it ("interceptors are
; not working … loaded too late"). Frameworks/libraries the program links are kept.
(defn meta-unsafe-flag? [(f (slice u8))] (-> bool)
  (or (starts-with f "-fsanitize")
      (starts-with f "-fno-sanitize")))

; Declaring a link input in Coil.toml AND passing it as `--link-flag` used to be the
; only way to make both `coil build <file>` and `coil test` work, because the
; explicit-file build ignored the manifest. It no longer does, so the two sources
; combine — and a repeated `-Wl,-force_load,X` force-loads the same archive twice, so
; every symbol in it collides WITH ITSELF. The linker then reports
;
;   duplicate symbol '_x' in:
;       libX.a[3](000000.o)
;       libX.a[3](000000.o)
;
; naming the same object on both sides, which gives no hint that a repeated flag is
; the cause. Bare `.o`/`.a` inputs duplicate the same way.
;
; `-l<name>` is deliberately NOT deduped: repeating a library is the standard way to
; resolve circular static archives (`-la -lb -la`). `-framework` is deduped as a PAIR
; for the same reason — dropping the bare token would turn `-framework A -framework B`
; into `-framework A B`.
(defn link-dedupable? [(f (slice u8))] (-> bool)
  (or (starts-with f "-Wl,-force_load,")
      (d-ends-with? f ".o")
      (d-ends-with? f ".a")))

; Compare link inputs by REALPATH, not by spelling. The duplication that prompted
; this arrives as two different spellings of one file — a relative path in Coil.toml
; and an absolute one from a script — and that is exactly the case the linker cannot
; collapse itself: given one path twice it warns and ignores the repeat, but given two
; spellings it force-loads the file twice and every symbol collides. An unresolvable
; path falls back to its literal text.
(defn link-dedupe-key [(a (dyn Allocator)) (f (slice u8))] (-> (slice u8))
  (if (starts-with f "-Wl,-force_load,")
      (let [p (subslice [u8] f (len "-Wl,-force_load,") (len f))]
        (match (m-realpath a p)
          (Some [rp] (sconcat a "-Wl,-force_load," rp))
          (None [] f)))
      (match (m-realpath a f) (Some [rp] rp) (None [] f))))

(defn strs-has? [(xs (ptr (ArrayList (slice u8)))) (v (slice u8))] (-> bool)
  (let [n (len (load xs))
        (mut i) 0
        (mut found) false]
    (loop (if (or (load found) (>= (load i) n))
              (break)
              (do
                (when (= (get (load xs) (load i)) v) (set! found true) 0)
                (set! i (primitive/iadd (load i) 1)))))
    (load found)))

(defn strs-have-prefix? [(xs (ptr (ArrayList (slice u8))))
                         (prefix (slice u8))] (-> bool)
  (let [n (len (load xs))
        (mut i) 0
        (mut found) false]
    (loop (if (or (load found) (>= (load i) n))
              (break)
              (do
                (when (starts-with (get (load xs) (load i)) prefix)
                  (set! found true)
                  0)
                (set! i (primitive/iadd (load i) 1)))))
    (load found)))

(defn dedupe-link-flags [(a (dyn Allocator)) (flags (ArrayList (slice u8)))]
  (-> (ptr (ArrayList (slice u8))))
  (let [(mut out) (ArrayList::new [(slice u8)] a)
        seen
          (box! a
                (ArrayList (slice u8))
                (zeroed (ArrayList (slice u8))))
        n (len flags)
        (mut i) 0]
    (set! seen (ArrayList::new [(slice u8)] a))
    (loop (if (>= (load i) n)
              (break)
              (let [f (get flags (load i))]
                (if (and (= f "-framework") (< (primitive/iadd (load i) 1) n))
                    (let [nm (get flags (primitive/iadd (load i) 1))
                          key (sconcat3 a "-framework " nm "")]
                      (unless (strs-has? seen key)
                        (push! seen key)
                        (push! (mut out) f)
                        (push! (mut out) nm)
                        0)
                      (set! i (primitive/iadd (load i) 2))
                      0)
                    (do
                      (if (link-dedupable? f)
                          (let [key (link-dedupe-key a f)]
                            (unless (strs-has? seen key)
                              (push! seen key)
                              (push! (mut out) f)
                              0))
                          (push! (mut out) f))
                      (set! i (primitive/iadd (load i) 1))
                      0)))))
    (box-al [(slice u8)] a (load out))))

(defn filter-meta-link-flags [(a (dyn Allocator))
                              (flags (ArrayList (slice u8)))]
  (-> (ptr (ArrayList (slice u8))))
  (let [(mut out) (ArrayList::new [(slice u8)] a)
        (mut i) 0
        n (len flags)]
    (loop (if (>= (load i) n)
              (break)
              (do
                (let [f (get flags (load i))]
                  (unless (meta-unsafe-flag? f) (push! (mut out) f)))
                (set! i (primitive/iadd (load i) 1)))))
    ; the metaprogram dylib link is where this bit first: the peer report was
    ; `metaengine: linking the metaprogram dylib failed`, not the program link.
    (dedupe-link-flags a (load out))))

; --wasm-stack-size=<MiB>: set the wasm shadow-stack reservation (see wasm.coil).
; Self-contained '='-form, so the scanner treats it as one token.
(defn apply-wasm-stack-flag! [(arg (slice u8))] (-> i64)
  (let [val (subslice [u8] arg 18 (len arg))]  ; after "--wasm-stack-size="
    (match (parse-int val)
      (Some [mib]
            (if (<= mib 0)
                (let [w (stderr)]
                  (ps w "error: --wasm-stack-size needs a positive MiB value")
                  (wb w 10)
                  (exit 1)
                  0)
                (set-wasm-stack-size! (primitive/imul mib 1048576))))
      (None []
            (let [w (stderr)]
              (ps w "error: --wasm-stack-size=<MiB> not a number")
              (wb w 10)
              (exit 1)
              0)))))

; index of the first positional at/after `start`, or 0 if there is none.
; Stops at `--` (run's program args are not our positionals).
(defn argv-file-idx [(argc i32) (argv (ptr (ptr i8))) (start i64)] (-> i64)
  (let [(mut i) start
        (mut r) 0]
    (loop (if (>= (load i) (primitive/cast i64 argc))
              (break)
              (let [arg (from-cstr (load (index argv (load i))))]
                (if (= arg "--")
                    (break)
                    (if (is-flag? arg)
                        (do
                          (set! i
                                (primitive/iadd (load i)
                                                (if (flag-takes-value? arg) 2 1)))
                          0)
                        (do (set! r (load i)) (break)))))))
    (load r)))

; reject an unrecognised flag instead of skipping it. `fidx` is the positional the
; caller already claimed as its file; anything else non-flag is a stray argument.
(defn argv-reject-unknown [(argc i32)
                           (argv (ptr (ptr i8)))
                           (start i64)
                           (fidx i64)] (-> i64)
  (let [(mut i) start
        multi (argv-has-flag? argc argv "--use")]
    (loop (if (>= (load i) (primitive/cast i64 argc))
              (break)
              (let [arg (from-cstr (load (index argv (load i))))]
                (cond (= arg "--") (break)
                      (= (load i) fidx)
                        (do (set! i (primitive/iadd (load i) 1)) 0)
                      ; In the shared table so every scanner skips its value, but only
                      ; `run` starts a program; run-cmd removes it before it builds.
                      (= arg "--run-in")
                        (do
                          (ps (stderr)
                              "error: --run-in is a `coil run` option: it names the directory the program starts in\n")
                          (exit 1)
                          0)
                      (is-flag? arg)
                        (if (flag-known? arg)
                            (do
                              (set! i
                                    (primitive/iadd (load i)
                                                    (if (flag-takes-value? arg)
                                                        2
                                                        1)))
                              0)
                            (let [w (stderr)]
                              (ps w "error: unknown flag '")
                              (ps w arg)
                              (ps w "'")
                              (wb w 10)
                              (exit 1)
                              0))
                      multi (do (set! i (primitive/iadd (load i) 1)) 0)
                      :else
                        (let [w (stderr)]
                          (ps w "error: unexpected argument '")
                          (ps w arg)
                          (ps w "'")
                          (wb w 10)
                          (exit 1)
                          0))))))
  0)

; The arch component of a triple = the text before the first '-' (`x86_64` of
; `x86_64-apple-macosx11.0.0`). Empty triple would be caught by the null guard first.
(defn triple-arch [(triple (ptr i8))] (-> (slice u8))
  (let [s (from-cstr triple)
        n (len s)
        (mut i) 0]
    (loop (if (or (>= (load i) n)
                  (= (primitive/cast i64 (get s (load i)))
                     45))
              (break)
              (set! i (primitive/iadd (load i) 1))))
    (subslice [u8] s 0 (load i))))

; A `--target <triple>` whose object arch differs from the host's. The host `cc`
; defaults to producing arm64 Mach-O, so linking such an object raw dies with
; `found architecture 'x86_64', required arm64`. The fix is to pass `-arch <arch>`
; to the link step (macOS `cc` cross-links every slice its SDK carries), which this
; predicate gates. A wasm32 target never touches `cc` (wasm-link-object finalizes it
; in-process) and a null triple is the host default — neither needs `-arch`.
(defn native-cross-target? [(triple (ptr i8))] (-> bool)
  (if (or (= (primitive/cast i64 triple) 0)
          (wasm-target? triple))
      false
      (let [arch (triple-arch triple)]
        (not (or (= arch "arm64") (= arch "aarch64"))))))

(defn triple-has? [(triple (ptr i8)) (needle (slice u8))] (-> bool)
  (match (find (from-cstr triple) needle) (Some [_] true) (None [] false)))

;;; Whether TRIPLE names an operating system this host's linker does not make
;;; binaries for: anything but an Apple platform on macOS, anything but Linux on
;;; Linux. The host's own triple (none given) and WebAssembly never are.
(defn foreign-link-target? [(triple (ptr i8))] (-> bool)
  (cond (= (primitive/cast i64 triple) 0) false
        (wasm-target? triple) false
        ; an architecture no backend knows is refused as unsupported, later
        (= (arch-of-triple triple) "") false
        (me-host-linux?) (not (triple-has? triple "linux"))
        :else (not (triple-has? triple "-apple-"))))

; An Apple target other than macOS: iOS and its simulator, tvOS, watchOS,
; visionOS. Its arch can match the host's, so it is not a `native-cross-target?`,
; but its objects carry their own platform: linking them with the host's
; macOS defaults fails with `building for macOS, but linking in object file
; built for iOS`. The link names the triple and that platform's SDK instead.
(defn apple-embedded-target? [(triple (ptr i8))] (-> bool)
  (if (= (primitive/cast i64 triple) (primitive/cast i64 0))
      false
      (and (triple-has? triple "-apple-")
           (or (triple-has? triple "-ios")
               (or (triple-has? triple "-tvos")
                   (or (triple-has? triple "-watchos")
                       (triple-has? triple "-xros")))))))

; The SDK platform an Apple embedded triple builds against, as Xcode names its
; `Platforms/<name>.platform` directory.
(defn apple-embedded-platform [(triple (ptr i8))] (-> (slice u8))
  (let [sim (triple-has? triple "simulator")]
    (cond (triple-has? triple "-tvos") (if sim "AppleTVSimulator" "AppleTVOS")
          (triple-has? triple "-watchos") (if sim "WatchSimulator" "WatchOS")
          (triple-has? triple "-xros") (if sim "XRSimulator" "XROS")
          :else (if sim "iPhoneSimulator" "iPhoneOS"))))

; That platform's SDK: SDKROOT when set, else the one inside DEVELOPER_DIR or the
; default Xcode, found the same way as `darwin-direct-sdk` (no xcrun spawn).
; "" when there is none.
(defn apple-embedded-sdk [(a (dyn Allocator)) (triple (ptr i8))] (-> (slice u8))
  (let [platform (apple-embedded-platform triple)
        tail (sconcat a "/Platforms/" platform)
        sdk-tail
          (sconcat a
                   tail
                   (sconcat a
                            ".platform/Developer/SDKs/"
                            (sconcat a platform ".sdk")))
        envp (unit-getenv c"SDKROOT")
        env (if (= (primitive/cast i64 envp) 0) "" (from-cstr envp))
        devp (unit-getenv c"DEVELOPER_DIR")
        dev (if (= (primitive/cast i64 devp) 0) "" (from-cstr devp))
        from-dev (if (> (len dev) 0) (sconcat a dev sdk-tail) "")
        xcode (sconcat a "/Applications/Xcode.app/Contents/Developer" sdk-tail)]
    (cond (and (> (len env) 0) (= (access (to-cstr a env) 0) 0)) env
          (and (> (len from-dev) 0) (= (access (to-cstr a from-dev) 0) 0))
            from-dev
          (= (access (to-cstr a xcode) 0) 0) xcode
          :else "")))

; What a cross link adds so `cc` produces the target's binary: `-arch <arch>` for
; another macOS arch, `-target <triple> -isysroot <sdk>` for an Apple embedded OS.
; `flags` are the program's own link flags: a `-isysroot` there wins.
;;; The macOS version a `--target` triple names, `13.0.0` of
;;; `arm64-apple-macosx13.0.0`, or "" when it names none (or is not macOS).
(defn macos-triple-version [(triple (ptr i8))] (-> (slice u8))
  (if (= (primitive/cast i64 triple) 0)
      ""
      (let [t (from-cstr triple)]
        (match (find t "-apple-macosx")
          (None [] "")
          (Some [at]
                (let [start (+ at (len "-apple-macosx"))
                      (mut end) start]
                  (while (and (< (load end) (len t))
                              (or (= (get t (load end)) (: 46 u8))
                                  (and (>= (get t (load end)) (: 48 u8))
                                       (<= (get t (load end)) (: 57 u8)))))
                    (set! end (+ (load end) 1)))
                  (subslice t start (load end))))))))

;;; The deployment target a macOS link records (LC_BUILD_VERSION minos): the
;;; version TRIPLE names. The object is compiled for that version; a link that
;;; did not say it got the build machine's own, so a program built for 13.0 was
;;; marked as needing the macOS it happened to be built on.
(defn push-macos-version-min! [(a (dyn Allocator))
                               (args (mut (ArrayList (slice u8))))
                               (triple (ptr i8))] (-> i64)
  (let [v (macos-triple-version triple)]
    (when (> (len v) 0)
      (push! (mut args) (sconcat a "-mmacosx-version-min=" v)))
    0))

(defn push-cross-link-target! [(a (dyn Allocator))
                               (args (mut (ArrayList (slice u8))))
                               (triple (ptr i8))
                               (flags (ArrayList (slice u8)))] (-> i64)
  (cond (me-host-linux?) 0
        (apple-embedded-target? triple)
          (do
            (push! (mut args) "-target")
            (push! (mut args) (from-cstr triple))
            (let [(mut chosen) false]
              (for [i 0 (len flags)]
                (when (= (get flags i) "-isysroot") (set! chosen true) 0)
                0)
              (unless (load chosen)
                (let [sdk (apple-embedded-sdk a triple)]
                  (when (= (len sdk) 0)
                    (ps (stderr) "error: no ")
                    (ps (stderr) (apple-embedded-platform triple))
                    (ps (stderr) " SDK for --target ")
                    (ps (stderr) (from-cstr triple))
                    (ps (stderr)
                        "; install that platform in Xcode, or set SDKROOT or pass -isysroot\n")
                    (exit 1)
                    0)
                  (push! (mut args) "-isysroot")
                  (push! (mut args) sdk)
                  0)
                0))
            0)
        (native-cross-target? triple)
          (do
            (push! (mut args) "-arch")
            (push! (mut args) (triple-arch triple))
            0)
        :else 0))

; `-g` packaging (Mach-O): the DWARF lives in the temporary object; `ld` records a debug
; map into the executable pointing at it. `dsymutil` gathers a `<out>.dSYM` next to the
; exe from that map + the object's DWARF before cleanup, which is what lldb loads.
; Best-effort: a failure (e.g. no dsymutil) is a warning. The arm64 backend now
; emits the __text-relative address RELOCATIONS dsymutil needs (without them it printed
; "No valid relocations found. Skipping." and produced an empty dSYM — tool-11).
; The NATIVE backend for the host this compiler is running on: 5 (x86-64/ELF) on
; Linux, 2 (arm64/Mach-O) elsewhere.
;
; `-g`/`--debug` picks a native backend because those always emit DWARF, where the
; LLVM path historically did not. It used to pick 2 unconditionally, which is right
; only on macOS: on a Linux x86-64 host it emitted a Mach-O object and the link then
; failed with "file format not recognized" -- so `coil build -g` could not produce a
; binary at all there, and the failing link left its /tmp/coil-link-* directory
; behind. run-dsymutil below was already host-aware; this is the other half.
(defn host-native-backend [] (-> i64)
  (if (me-host-linux?) 5 2))

(defn run-dsymutil [(a (dyn Allocator)) (out (slice u8))] (-> i64)
  ; ELF has no debug map / dSYM: the DWARF is linked into the executable itself and
  ; debuggers read it directly, so on a Linux host there is nothing to gather.
  (unless (me-host-linux?)
    (let [(mut args) (ArrayList::new [(slice u8)] a)]
      (push! (mut args) "dsymutil")
      (push! (mut args) out)
      (let [drc (spawn-wait a (load args))]
        (when (!= drc 0)
          (ps (stderr) "warning: dsymutil failed for ")
          (ps (stderr) out)
          (ps (stderr) "\n")
          0)))))

(defstruct ObjectLinkFacts
  [(defines-curl bool) (needs-curl bool) (needs-llvm bool)])

; Object contents are a transient query input, never root-arena state. Return
; only scalar facts so a many-object link retains no cumulative object bytes.
(defn object-link-facts [(obj (slice u8))] (-> ObjectLinkFacts)
  (let [(mut arena) (zeroed scratch/ScratchArena)
        _init
          (scratch/ScratchArena::init-with-capacity (mut arena)
                                                    (large-pages/compiler-scratch-parent)
                                                    65536)
        a (allocator (mut arena))
        bytes (read-file a (to-cstr a obj))
        result
          (ObjectLinkFacts
            :defines-curl
              (or (macho-defined? bytes "_curl_easy_init")
                  (elf-defined? bytes "curl_easy_init"))
            :needs-curl
              (or (macho-symbol-undefined? bytes "_curl_easy_init")
                  (elf-symbol-undefined? bytes "curl_easy_init"))
            :needs-llvm
              (or (macho-undefined? bytes "_LLVMGetDefaultTargetTriple")
                  (elf-undefined? bytes "LLVMGetDefaultTargetTriple")))]
    (close! (mut arena))
    result))

(defn object-u16 [(bytes (slice u8)) (at i64)] (-> i64)
  (| (primitive/cast i64 (get bytes at))
     (<< (primitive/cast i64 (get bytes (+ at 1))) 8)))

(defn object-u32 [(bytes (slice u8)) (at i64)] (-> i64)
  (| (object-u16 bytes at) (<< (object-u16 bytes (+ at 2)) 16)))

(defn object-u64 [(bytes (slice u8)) (at i64)] (-> i64)
  (| (object-u32 bytes at) (<< (object-u32 bytes (+ at 4)) 32)))

(defn object-range? [(bytes (slice u8)) (at i64) (size i64)] (-> bool)
  (and (>= at 0) (and (>= size 0) (<= size (- (len bytes) at)))))

(defn object-cstr-eq? [(bytes (slice u8)) (at i64) (name (slice u8))] (-> bool)
  (let [n (len name)]
    (if (not (object-range? bytes at (+ n 1)))
        false
        (let [(mut i) 0
              (mut same) true]
          (loop (if (>= (load i) n)
                    (break)
                    (do
                      (unless (= (get bytes (+ at (load i)))
                                 (get name (load i)))
                        (set! same false)
                        (break)
                        0)
                      (set! i (+ (load i) 1)))))
          (and (load same) (= (get bytes (+ at n)) (: 0 u8)))))))

; Read the native object's symbol table instead of searching all bytes for a name.
; String literals and undefined linker references share the same spelling in an
; object file; confusing the two made the LLVM-free compiler think its dlsym probe
; was an LLVM dependency. These readers cover the two native object formats Coil
; emits (64-bit little-endian Mach-O and ELF) and only accept SHN_UNDEF/N_UNDF.
(defn macho-undefined? [(bytes (slice u8)) (name (slice u8))] (-> bool)
  (if (or (not (object-range? bytes 0 32)) (!= (object-u32 bytes 0) 4277009103))
      false
      (let [ncmds (object-u32 bytes 16)
            (mut cmd-at) 32
            (mut ci) 0
            (mut symoff) -1
            (mut nsyms) 0
            (mut stroff) -1]
        (loop (if (>= (load ci) ncmds)
                  (break)
                  (if (not (object-range? bytes (load cmd-at) 8))
                      (break)
                      (let [cmd (object-u32 bytes (load cmd-at))
                            size (object-u32 bytes (+ (load cmd-at) 4))]
                        (when (and (= cmd 2)
                                   (object-range? bytes (load cmd-at) 24))
                          (set! symoff (object-u32 bytes (+ (load cmd-at) 8)))
                          (set! nsyms (object-u32 bytes (+ (load cmd-at) 12)))
                          (set! stroff (object-u32 bytes (+ (load cmd-at) 16)))
                          0)
                        (if (< size 8)
                            (break)
                            (set! cmd-at (+ (load cmd-at) size)))
                        (set! ci (+ (load ci) 1))))))
        (let [(mut found) false
              (mut scan-at) 32
              (mut scan-i) 0]
          ; A Mach-O relocation's r_extern bit says its low 24-bit symbol index
          ; addresses LC_SYMTAB. Undefined declarations with no relocation are
          ; inert and must not cause a library to be linked.
          (loop (if (or (>= (load scan-i) ncmds) (load found))
                    (break)
                    (if (not (object-range? bytes (load scan-at) 8))
                        (break)
                        (let [cmd (object-u32 bytes (load scan-at))
                              size (object-u32 bytes (+ (load scan-at) 4))]
                          (when (and (= cmd 25)
                                     (object-range? bytes (load scan-at) 72))
                            (let [nsects
                                    (object-u32 bytes (+ (load scan-at) 64))
                                  (mut sec) 0]
                              (loop (if (or (>= (load sec) nsects) (load found))
                                        (break)
                                        (let [sat
                                                (+ (+ (load scan-at) 72)
                                                   (* (load sec) 80))]
                                          (if (not (object-range? bytes sat 80))
                                              (break)
                                              (let [reloff
                                                      (object-u32 bytes
                                                                  (+ sat 56))
                                                    nreloc
                                                      (object-u32 bytes
                                                                  (+ sat 60))
                                                    (mut ri) 0]
                                                (loop (if (or (>= (load ri)
                                                                  nreloc)
                                                              (load found))
                                                          (break)
                                                          (let [rat
                                                                  (+ reloff
                                                                     (* (load ri)
                                                                        8))]
                                                            (if (not (object-range? bytes
                                                                                    rat
                                                                                    8))
                                                                (break)
                                                                (let [word
                                                                        (object-u32 bytes
                                                                                    (+ rat
                                                                                       4))]
                                                                  (when (!= (& word
                                                                               134217728)
                                                                            0)
                                                                    (let [ndx
                                                                            (& word
                                                                               16777215)
                                                                          nat
                                                                            (+ (load symoff)
                                                                               (* ndx
                                                                                  16))]
                                                                      (when (and (< ndx
                                                                                    (load nsyms))
                                                                                 (and (object-range? bytes
                                                                                                     nat
                                                                                                     16)
                                                                                      (and (= (& (primitive/cast i64
                                                                                                                 (get bytes
                                                                                                                      (+ nat
                                                                                                                         4)))
                                                                                                 14)
                                                                                              0)
                                                                                           (object-cstr-eq? bytes
                                                                                                            (+ (load stroff)
                                                                                                               (object-u32 bytes
                                                                                                                           nat))
                                                                                                            name))))
                                                                        (set! found
                                                                              true)
                                                                        0)))
                                                                  (set! ri
                                                                        (+ (load ri)
                                                                           1)))))))
                                                (set! sec (+ (load sec) 1))))))))
                            0)
                          (if (< size 8)
                              (break)
                              (set! scan-at (+ (load scan-at) size)))
                          (set! scan-i (+ (load scan-i) 1))))))
          (load found)))))

(defn elf-undefined? [(bytes (slice u8)) (name (slice u8))] (-> bool)
  (if (or (not (object-range? bytes 0 64))
          (not (and (= (get bytes 0) (: 127 u8))
                    (and (= (get bytes 1) (: 69 u8))
                         (and (= (get bytes 2) (: 76 u8))
                              (= (get bytes 3) (: 70 u8)))))))
      false
      (let [shoff (object-u64 bytes 40)
            shentsize (object-u16 bytes 58)
            shnum (object-u16 bytes 60)
            (mut si) 0
            (mut found) false]
        (loop (if (or (>= (load si) shnum) (load found))
                  (break)
                  (let [sh (+ shoff (* (load si) shentsize))]
                    (if (not (object-range? bytes sh 64))
                        (break)
                        (do
                          (when (or (= (object-u32 bytes (+ sh 4)) 4)
                                    (= (object-u32 bytes (+ sh 4)) 9))
                            ; SHT_RELA/SHT_REL sh_link names the symbol table. Each
                            ; r_info high word is the referenced symbol index.
                            (let [rel-type (object-u32 bytes (+ sh 4))
                                  sym-index (object-u32 bytes (+ sh 40))
                                  rel-off (object-u64 bytes (+ sh 24))
                                  rel-size (object-u64 bytes (+ sh 32))
                                  rel-ent (object-u64 bytes (+ sh 56))
                                  sym-sh (+ shoff (* sym-index shentsize))]
                              (when (and (> rel-ent 0)
                                         (object-range? bytes sym-sh 64))
                                (let [symoff (object-u64 bytes (+ sym-sh 24))
                                      syment (object-u64 bytes (+ sym-sh 56))
                                      str-index (object-u32 bytes (+ sym-sh 40))
                                      str-sh (+ shoff (* str-index shentsize))]
                                  (when (and (> syment 0)
                                             (object-range? bytes str-sh 64))
                                    (let [stroff
                                            (object-u64 bytes (+ str-sh 24))
                                          (mut off) 0]
                                      (loop (if (or (>= (load off) rel-size)
                                                    (load found))
                                                (break)
                                                (let [rel (+ rel-off (load off))]
                                                  (if (not (object-range? bytes
                                                                          rel
                                                                          (if (= rel-type
                                                                                 4)
                                                                              24
                                                                              16)))
                                                      (break)
                                                      (let [ndx
                                                              (>> (object-u64 bytes
                                                                              (+ rel
                                                                                 8))
                                                                  32)
                                                            sym
                                                              (+ symoff
                                                                 (* ndx syment))]
                                                        (when (and (object-range? bytes
                                                                                  sym
                                                                                  24)
                                                                   (and (= (object-u16 bytes
                                                                                       (+ sym
                                                                                          6))
                                                                           0)
                                                                        (object-cstr-eq? bytes
                                                                                         (+ stroff
                                                                                            (object-u32 bytes
                                                                                                        sym))
                                                                                         name)))
                                                          (set! found true)
                                                          0)
                                                        (set! off
                                                              (+ (load off)
                                                                 rel-ent)))))))))))
                              0))
                          (set! si (+ (load si) 1)))))))
        (load found))))

; Undefined entries in the native symbol table are the linker's ground truth.
; Looking there distinguishes a real external reference from identical bytes in
; an ordinary string literal without depending on architecture-specific
; relocation encodings.
(defn macho-symbol-undefined? [(bytes (slice u8)) (name (slice u8))] (-> bool)
  (if (or (not (object-range? bytes 0 32)) (!= (object-u32 bytes 0) 4277009103))
      false
      (let [ncmds (object-u32 bytes 16)
            (mut at) 32
            (mut ci) 0
            (mut symoff) -1
            (mut nsyms) 0
            (mut stroff) -1]
        (loop (if (>= (load ci) ncmds)
                  (break)
                  (if (not (object-range? bytes (load at) 8))
                      (break)
                      (let [cmd (object-u32 bytes (load at))
                            size (object-u32 bytes (+ (load at) 4))]
                        (when (and (= cmd 2) (object-range? bytes (load at) 24))
                          (set! symoff (object-u32 bytes (+ (load at) 8)))
                          (set! nsyms (object-u32 bytes (+ (load at) 12)))
                          (set! stroff (object-u32 bytes (+ (load at) 16)))
                          0)
                        (if (< size 8) (break) (set! at (+ (load at) size)))
                        (set! ci (+ (load ci) 1))))))
        (let [(mut i) 0
              (mut found) false]
          (loop (if (or (>= (load i) (load nsyms)) (load found))
                    (break)
                    (let [sym (+ (load symoff) (* (load i) 16))]
                      (when (and (object-range? bytes sym 16)
                                 (and (= (& (primitive/cast i64
                                                            (get bytes
                                                                 (+ sym
                                                                    4)))
                                            14)
                                         0)
                                      (object-cstr-eq? bytes
                                                       (+ (load stroff)
                                                          (object-u32 bytes sym))
                                                       name)))
                        (set! found true)
                        0)
                      (set! i (+ (load i) 1)))))
          (load found)))))

(defn elf-symbol-undefined? [(bytes (slice u8)) (name (slice u8))] (-> bool)
  (if (or (not (object-range? bytes 0 64))
          (not (and (= (get bytes 0) (: 127 u8))
                    (and (= (get bytes 1) (: 69 u8))
                         (and (= (get bytes 2) (: 76 u8))
                              (= (get bytes 3) (: 70 u8)))))))
      false
      (let [shoff (object-u64 bytes 40)
            shentsize (object-u16 bytes 58)
            shnum (object-u16 bytes 60)
            (mut si) 0
            (mut found) false]
        (loop (if (or (>= (load si) shnum) (load found))
                  (break)
                  (let [sh (+ shoff (* (load si) shentsize))]
                    (if (not (object-range? bytes sh 64))
                        (break)
                        (do
                          (when (or (= (object-u32 bytes (+ sh 4)) 2)
                                    (= (object-u32 bytes (+ sh 4)) 11))
                            (let [symoff (object-u64 bytes (+ sh 24))
                                  symsize (object-u64 bytes (+ sh 32))
                                  syment (object-u64 bytes (+ sh 56))
                                  str-index (object-u32 bytes (+ sh 40))
                                  str-sh (+ shoff (* str-index shentsize))]
                              (when (and (> syment 0)
                                         (object-range? bytes str-sh 64))
                                (let [stroff (object-u64 bytes (+ str-sh 24))
                                      (mut off) 0]
                                  (loop (if (or (>= (load off) symsize)
                                                (load found))
                                            (break)
                                            (let [sym (+ symoff (load off))]
                                              (when (and (object-range? bytes
                                                                        sym
                                                                        24)
                                                         (and (= (object-u16 bytes
                                                                             (+ sym
                                                                                6))
                                                                 0)
                                                              (object-cstr-eq? bytes
                                                                               (+ stroff
                                                                                  (object-u32 bytes
                                                                                              sym))
                                                                               name)))
                                                (set! found true)
                                                0)
                                              (set! off (+ (load off) syment))))))))
                            0)
                          (set! si (+ (load si) 1)))))))
        (load found))))

; True only when NAME is defined by this Mach-O object. Unlike a byte search,
; this distinguishes a program that implements an API from one that merely
; references it from another partition.
(defn macho-defined? [(bytes (slice u8)) (name (slice u8))] (-> bool)
  (if (or (not (object-range? bytes 0 32)) (!= (object-u32 bytes 0) 4277009103))
      false
      (let [ncmds (object-u32 bytes 16)
            (mut at) 32
            (mut ci) 0
            (mut symoff) -1
            (mut nsyms) 0
            (mut stroff) -1]
        (loop (if (>= (load ci) ncmds)
                  (break)
                  (if (not (object-range? bytes (load at) 8))
                      (break)
                      (let [cmd (object-u32 bytes (load at))
                            size (object-u32 bytes (+ (load at) 4))]
                        (when (and (= cmd 2) (object-range? bytes (load at) 24))
                          (set! symoff (object-u32 bytes (+ (load at) 8)))
                          (set! nsyms (object-u32 bytes (+ (load at) 12)))
                          (set! stroff (object-u32 bytes (+ (load at) 16)))
                          0)
                        (if (< size 8) (break) (set! at (+ (load at) size)))
                        (set! ci (+ (load ci) 1))))))
        (let [(mut i) 0
              (mut found) false]
          (loop (if (or (>= (load i) (load nsyms)) (load found))
                    (break)
                    (let [sym (+ (load symoff) (* (load i) 16))]
                      (when (and (object-range? bytes sym 16)
                                 (and (!= (& (primitive/cast i64
                                                             (get bytes
                                                                  (+ sym
                                                                     4)))
                                             14)
                                          0)
                                      (object-cstr-eq? bytes
                                                       (+ (load stroff)
                                                          (object-u32 bytes sym))
                                                       name)))
                        (set! found true)
                        0)
                      (set! i (+ (load i) 1)))))
          (load found)))))

(defn elf-defined? [(bytes (slice u8)) (name (slice u8))] (-> bool)
  (if (or (not (object-range? bytes 0 64))
          (not (and (= (get bytes 0) (: 127 u8))
                    (and (= (get bytes 1) (: 69 u8))
                         (and (= (get bytes 2) (: 76 u8))
                              (= (get bytes 3) (: 70 u8)))))))
      false
      (let [shoff (object-u64 bytes 40)
            shentsize (object-u16 bytes 58)
            shnum (object-u16 bytes 60)
            (mut si) 0
            (mut found) false]
        (loop (if (or (>= (load si) shnum) (load found))
                  (break)
                  (let [sh (+ shoff (* (load si) shentsize))]
                    (if (not (object-range? bytes sh 64))
                        (break)
                        (do
                          (when (or (= (object-u32 bytes (+ sh 4)) 2)
                                    (= (object-u32 bytes (+ sh 4)) 11))
                            (let [symoff (object-u64 bytes (+ sh 24))
                                  symsize (object-u64 bytes (+ sh 32))
                                  syment (object-u64 bytes (+ sh 56))
                                  str-index (object-u32 bytes (+ sh 40))
                                  str-sh (+ shoff (* str-index shentsize))]
                              (when (and (> syment 0)
                                         (object-range? bytes str-sh 64))
                                (let [stroff (object-u64 bytes (+ str-sh 24))
                                      (mut off) 0]
                                  (loop (if (or (>= (load off) symsize)
                                                (load found))
                                            (break)
                                            (let [sym (+ symoff (load off))]
                                              (when (and (object-range? bytes
                                                                        sym
                                                                        24)
                                                         (and (!= (object-u16 bytes
                                                                              (+ sym
                                                                                 6))
                                                                  0)
                                                              (object-cstr-eq? bytes
                                                                               (+ stroff
                                                                                  (object-u32 bytes
                                                                                              sym))
                                                                               name)))
                                                (set! found true)
                                                0)
                                              (set! off (+ (load off) syment))))))))
                            0)
                          (set! si (+ (load si) 1)))))))
        (load found))))

; Beside the compiler (an installed toolchain, or a stage compiler given the
; layout by stage-lib.sh), else the checkout's build/bin, where build-curl.sh puts
; them. The checkout is the one the library came from, not the working directory:
; the bootstrap's seed lives in bootstrap/seeds and may run from anywhere in it.
(defn bundled-curl-archive [(a (dyn Allocator)) (self (slice u8))]
  (-> (slice u8))
  (let [arch (if (me-host-linux?) "x86_64-linux" "arm64-macos")
        suffix (cat3-d a "/native/curl/" (cat3-d a arch "/libcurl.a"))
        installed (cat3-d a (dirname (m-resolve-self a self)) suffix)
        layout (stdlib-layout a)
        build-bin
          (if (stdlib-checkout? layout)
              (path-join a (dirname (dirname (.libs layout))) "build/bin")
              "build/bin")
        checkout (cat3-d a build-bin suffix)]
    (if (= (primitive/cast i64 (access (to-cstr a installed) 0))
           0)
        installed
        checkout)))

; A final link never writes its destination in place. The old file may be a
; running program: on macOS, rewriting a running signed image gets the process
; killed, and a reader could observe a half-written file. The linker writes a
; private name in the destination's directory, which is then renamed over the
; destination, so the name switches from the complete old file to the complete
; new one while a running process keeps its original file.
(defn staged-output-path [(a (dyn Allocator)) (out (slice u8))] (-> (slice u8))
  (temp-sibling-or-exit out))

(defn discard-staged-output! [(a (dyn Allocator)) (staged (slice u8))] (-> i64)
  (unlink (to-cstr a staged))
  0)

(defn publish-staged-output! [(a (dyn Allocator))
                              (staged (slice u8))
                              (out (slice u8))] (-> bool)
  (let [ok (= (rename (to-cstr a staged) (to-cstr a out)) 0)]
    (unless ok
      (ps (stderr) "error: cannot replace '")
      (ps (stderr) out)
      (ps (stderr) "' with the linked output '")
      (ps (stderr) staged)
      (ps (stderr) "'\n")
      0)
    (discard-staged-output! a staged)
    ok))

(defn append-bundled-curl! [(a (dyn Allocator))
                            (direct-link bool)
                            (args (mut (ArrayList (slice u8))))
                            (self (slice u8))
                            (obj (slice u8))] (-> i64)
  ; Caller has already inspected the object's dependency facts.
  (do
    (let [archive (bundled-curl-archive a self)
          fd (open (to-cstr a archive) 0)]
      (when (< (primitive/cast i64 fd) 0)
        (ps (stderr)
            "error: http_client.coil needs Coil's bundled libcurl; run scripts/native/build-curl.sh\n")
        (cleanup-build-object! a obj)
        (exit 1)
        0)
      (close fd)
      (push! (mut args) archive)
      (let [dir (dirname archive)]
        (push! (mut args) (cat3-d a dir "/libmbedtls.a"))
        (push! (mut args) (cat3-d a dir "/libmbedx509.a"))
        (push! (mut args) (cat3-d a dir "/libmbedcrypto.a")))
      (if (me-host-linux?)
          (do
            ; Bundled libcurl is built with zlib content encoding. ELF linkers
            ; require the archive's direct dependency after the archives.
            (push! (mut args) "-lz")
            (push! (mut args) "-lpthread")
            (push! (mut args) "-Wl,--gc-sections")
            0)
          (do
            (push! (mut args) "-framework")
            (push! (mut args) "CoreFoundation")
            (push! (mut args) "-framework")
            (push! (mut args) "SystemConfiguration")
            (push! (mut args) "-lz")
            (push! (mut args) (if direct-link "-dead_strip" "-Wl,-dead_strip"))
            0))))
  0)

(defn build-temp-object [(a (dyn Allocator))] (-> (slice u8))
  (let [dir (temp-or-exit "link")]
    (when (!= (fs/make-dir (to-cstr a dir) 448) (: 0 i32))
      (ps (stderr) "error: could not create temporary link directory\n")
      (exit 1)
      0)
    (sconcat a dir "/program.o")))

(defn cleanup-build-object! [(a (dyn Allocator)) (obj (slice u8))] (-> i64)
  (temp/remove! (dirname obj)))

(defn cleanup-build-objects! [(a (dyn Allocator)) (base (slice u8)) (count i64)]
  (-> i64)
  (temp/remove! (dirname base)))

; The clang that belongs to the libLLVM THIS COMPILER IS RUNNING, found by asking
; the dynamic loader where an LLVM symbol actually came from. `dladdr` reports the
; loaded object's path (e.g. /usr/lib/llvm-21/lib/libLLVM.so.21.1), whose sibling
; bin/clang is by construction the matching version. Empty when the answer is not
; usable -- a static link, no path, no LLVM at all, or no clang there.
;
; The symbol is reached with dlsym(RTLD_DEFAULT) rather than `fnptr-of`, because
; driver.coil is shared with the LLVM-FREE build (main_x64.coil): naming an LLVM
; function directly would put a link reference to libLLVM in a binary whose whole
; point is not to have one, and rebootstrap-nollvm-linux.sh gates on exactly that
; with ldd. Looked up dynamically, it is simply absent there and this returns "".
(defn llvm-sibling-clang [(a (dyn Allocator))] (-> (slice u8))
  (let [(mut info) (zeroed (array i8 128))
        ; Dl_info; dli_fname is the first field
        ; dlsym(NULL, ...) is not RTLD_DEFAULT on Darwin: NULL is a main-image
        ; handle there, while RTLD_DEFAULT is the sentinel (void*)-2. Opening the
        ; current process gives both Darwin and Linux a real portable handle.
        process (dlopen (primitive/cast (ptr i8) 0) 1)
        sym
          (if (= (primitive/cast i64 process) 0)
              (primitive/cast (ptr i8) 0)
              (dlsym process c"LLVMGetDefaultTargetTriple"))]
    (if (or (= (primitive/cast i64 sym) 0)
            (= (primitive/cast i64
                               (dladdr sym
                                       (primitive/cast (ptr i8)
                                                       (mut info))))
               0))
        ""
        (let [fname
                (load (primitive/cast (ptr (ptr i8))
                                      (mut info)))]
          (if (= (primitive/cast i64 fname) 0)
              ""
              (let [path (from-cstr fname)]
                ; .../lib/libLLVM.so -> .../bin/clang
                (if (< (find-slash path) 0)
                    ""
                    (let [cand (sconcat a (dirname (dirname path)) "/bin/clang")]
                      (if (= (primitive/cast i64 (access (to-cstr a cand) 0))
                             0)
                          cand
                          "")))))))))

(defn append-llvm-runtime! [(a (dyn Allocator))
                            (args (mut (ArrayList (slice u8))))] (-> i64)
  ; An explicit project/toolchain LLVM flag wins. Dynamic builds pass the
  ; monolithic -lLLVM; static builds pass component libraries such as
  ; -lLLVMCore and -lLLVMSupport instead.
  (unless (strs-have-prefix? (box-al [(slice u8)] a (load args)) "-lLLVM")
    (let [clang (llvm-sibling-clang a)]
      (if (= (len clang) 0)
          (do
            (ps (stderr)
                "error: this program imports coil.jit, but the compiler cannot locate its matching libLLVM\n")
            (ps (stderr)
                "note: use the full LLVM-linked Coil toolchain, or pass explicit LLVM link flags\n")
            (exit 1)
            0)
          (let [prefix (dirname (dirname clang))]
            (push! (mut args) (sconcat a "-L" (sconcat a prefix "/lib")))
            (push! (mut args) "-lLLVM")
            (unless (strs-has? (box-al [(slice u8)] a (load args)) "-lm")
              (push! (mut args) "-lm")
              0)
            0))))
  0)

; The ordinary driver remains overridable for toolchains and cross builds. An
; instrumented object must use the clang beside the LLVM that inserted the
; sanitizer pass, otherwise the compiler and runtime versions can disagree -- and
; the disagreement is not subtle: clang looks for its sanitizer runtime under its
; OWN resource directory, so a mismatched one fails the link outright with
; "cannot find libclang_rt.asan*.a".
;
; Order: $COIL_CC, then $LLVM_CONFIG's sibling clang, then the clang belonging to
; the libLLVM we are linked against, then PATH.
;
; That last fallback used to be the only answer on Linux, because the LLVM_CONFIG
; default is a Homebrew path that does not exist here. Bare `clang` on PATH is
; whatever happens to be first -- on a machine with a hand-built /usr/local/bin/clang
; of a different version and no compiler-rt, every `--sanitize=` build failed. Asking
; the loader which libLLVM we actually run gets the version agreement this comment
; has always claimed, without depending on PATH order or an env var being set.
;;; Does the link run a clang this compiler located (see native-link-driver), rather
;;; than `cc` or the user's COIL_CC?
(defn coil-located-clang? [] (-> bool)
  (and (sanitizer?) (= (primitive/cast i64 (unit-getenv c"COIL_CC")) 0)))

(defn native-link-driver [(a (dyn Allocator))] (-> (slice u8))
  (let [override (unit-getenv c"COIL_CC")]
    (if (!= (primitive/cast i64 override) 0)
        (from-cstr override)
        (if (sanitizer?)
            (let [cfgp (unit-getenv c"LLVM_CONFIG")
                  cfg
                    (if (= (primitive/cast i64 cfgp) 0)
                        ""
                        (from-cstr cfgp))
                  beside
                    (if (and (> (len cfg) 0)
                             (>= (find-slash cfg) 0))
                        (sconcat a (dirname cfg) "/clang")
                        "")]
              ; posix_spawnp does NOT fall back to PATH for a name containing a
              ; slash, so a non-existent absolute path must never be handed back:
              ; the spawn fails outright as "linker/ar failed with exit status: 127",
              ; naming neither the driver nor the reason.
              (if (and (> (len beside) 0)
                       (= (primitive/cast i64 (access (to-cstr a beside) 0))
                          0))
                  beside
                  (let [own (llvm-sibling-clang a)]
                    (if (> (len own) 0) own "clang"))))
            "cc"))))

; A `--lib` archive for a target whose objects are not Mach-O, built on a Darwin
; host. Apple's `ar` archives only Mach-O: handed an ELF object it warns, leaves
; the member out and exits 0, so such a build wrote an empty archive and
; reported success. Those archives are written by `llvm-ar` instead.
(defn foreign-archive-target? [(triple (ptr i8))] (-> bool)
  (and (not (me-host-linux?))
       (and (!= (primitive/cast i64 triple) 0)
            (not (or (wasm-target? triple)
                     (or (triple-has? triple "-apple-")
                         (or (triple-has? triple "darwin")
                             (triple-has? triple "macos"))))))))

; The archiver for a `--lib` build: the host `ar`, or for a foreign target the
; `llvm-ar` of the LLVM this compiler runs on (beside its clang). Empty when a
; foreign target needs one and there is none.
(defn native-archiver [(a (dyn Allocator)) (triple (ptr i8))] (-> (slice u8))
  (if (not (foreign-archive-target? triple))
      "ar"
      (let [clang (llvm-sibling-clang a)]
        (if (= (len clang) 0)
            ""
            (let [cand (sconcat a (dirname clang) "/llvm-ar")]
              (if (= (primitive/cast i64 (access (to-cstr a cand) 0)) 0)
                  cand
                  ""))))))

; The decimal number in an ar header field, which is space padded.
(defn ar-field-number [(bytes (slice u8)) (from i64) (width i64)] (-> i64)
  (let [(mut value) 0]
    (for [i from (+ from width)]
      (let [c (primitive/cast i64 (get bytes i))]
        (when (and (>= c 48) (<= c 57))
          (set! value (+ (* value 10) (- c 48))))))
    value))

; How many object members the archive at PATH holds, leaving out the symbol
; tables and the long-name table of both the BSD and the GNU formats; -1 when
; it is not an archive. `--lib` compares it to the objects it archived, so an
; archiver that drops a member is a failed build, not a silent empty library.
(defn archive-member-count [(a (dyn Allocator)) (path (slice u8))] (-> i64)
  (match (read-file-opt-disk a (to-cstr a path))
    (None [] -1)
    (Some [bytes]
          (if (not (starts-with bytes "!<arch>\n"))
              -1
              (let [n (len bytes)
                    (mut at) 8
                    (mut count) 0]
                (while (<= (+ at 60) n)
                  (let [name (subslice bytes at (+ at 16))
                        size (ar-field-number bytes (+ at 48) 10)
                        data (+ at 60)
                        ; BSD `#1/LEN`: the name is the first LEN bytes of the data
                        real
                          (if (starts-with name "#1/")
                              (let [k (ar-field-number name 3 13)]
                                (subslice bytes
                                          data
                                          (if (< (+ data k) n) (+ data k) n)))
                              name)]
                    (unless (or (starts-with real "__.SYMDEF")
                                (or (starts-with real "/ ")
                                    (or (starts-with real "// ")
                                        (starts-with real "/SYM64/"))))
                      (set! count (+ count 1)))
                    (set! at (+ data (+ size (& size 1))))))
                count)))))

(defn push-found-clang-sysroot! [(a (dyn Allocator))
                                 (args (mut (ArrayList (slice u8))))] (-> i64)
  (let [sdk (found-clang-sysroot a)]
    (when (> (len sdk) 0)
      (push! (mut args) "-isysroot")
      (push! (mut args) sdk)
      0)
    0))

; `body` on a native target, `alt` on wasm. Define this before build-cmd's first
; use: staged macro resolution must not depend on a later definition when compiling
; the self-host compiler with the previous stage.
(defn native-only [(body Code) (alt Code)] (-> Code)
  (match (target-os) (Wasm [] alt) (_ body)))

; A dependency package's link inputs reach a program only when that program's
; compilation loaded the package's code. The command layer describes each package
; on the build's command line (m-dep-package-args); the build registers the
; package's source roots with the loader before compiling, and afterwards asks the
; loader which packages the module graph actually reached.
;
; `kind` 0 is a literal linker token, 1 a pkg-config package name, and 2 a
; project-owned flags-command. A provider is consulted only for a package this
; program links, which is why the command layer does not expand it.
(defstruct DepLinkEntry [(id i64) (kind i64) (value (slice u8))])

(defstruct DepPackageName [(id i64) (name (slice u8))])

(defstruct DepRequire [(owner i64) (id i64)])

; `--dep-<...> <id>:<payload>`: one argv element carries both, so a payload with
; spaces (a flags-command) needs no quoting rules of its own.
(defn dep-arg-colon [(value (slice u8))] (-> i64)
  (let [n (len value)
        (mut at) -1
        (mut i) 0]
    (loop (if (or (>= (load i) n) (>= (load at) 0))
              (break)
              (do
                (when (= (get value (load i)) (: 58 u8))
                  (set! at (load i))
                  0)
                (set! i (primitive/iadd (load i) 1)))))
    (load at)))

(defn dep-arg-reject! [(flag (slice u8)) (value (slice u8))] (-> i64)
  (let [w (stderr)]
    (ps w "error: ")
    (ps w flag)
    (ps w " expects <package-id>:<value>, got '")
    (ps w value)
    (ps w "'")
    (wb w 10)
    (exit 1)
    0))

(defn dep-arg-id [(flag (slice u8)) (value (slice u8))] (-> i64)
  (let [at (dep-arg-colon value)]
    (if (<= at 0)
        (do (dep-arg-reject! flag value) 0)
        (match (parse-int (subslice [u8] value 0 at))
          (Some [id] (if (> id 0) id (do (dep-arg-reject! flag value) 0)))
          (None [] (do (dep-arg-reject! flag value) 0))))))

(defn dep-arg-payload [(flag (slice u8)) (value (slice u8))] (-> (slice u8))
  (let [at (dep-arg-colon value)]
    (if (<= at 0)
        (do (dep-arg-reject! flag value) "")
        (subslice [u8] value (primitive/iadd at 1) (len value)))))

(defn dep-id-member? [(ids (ptr (ArrayList i64))) (id i64)] (-> bool)
  (let [(mut found) false]
    (for [i 0 (len (load ids))]
      (when (= (get (load ids) i) id) (set! found true) 0)
      0)
    (load found)))

(defn dep-id-add! [(ids (ptr (ArrayList i64))) (id i64)] (-> bool)
  (if (dep-id-member? ids id)
      false
      (do (push! ids id) true)))

(defn dep-package-name [(names (ptr (ArrayList DepPackageName))) (id i64)]
  (-> (slice u8))
  (let [(mut found) ""]
    (for [i 0 (len (load names))]
      (let [x (elem names i)]
        (when (and (= (.id x) id) (= (len (load found)) 0))
          (set! found (.name x))
          0))
      0)
    (load found)))

; The packages this program links: those the loader saw, closed over the
; `requires` edges, because a package that is loaded brings the packages it is
; built against.
(defn dep-packages-used [(a (dyn Allocator))
                         (entries (ptr (ArrayList DepLinkEntry)))
                         (requires (ptr (ArrayList DepRequire)))]
  (-> (ptr (ArrayList i64)))
  (let [used (box-al [i64] a (ArrayList::new [i64] a))]
    (for [i 0 (len (load entries))]
      (let [e (elem entries i)]
        (when (link-package-used? (.id e)) (dep-id-add! used (.id e)) 0))
      0)
    (for [i 0 (len (load requires))]
      (let [r (elem requires i)]
        (when (link-package-used? (.owner r)) (dep-id-add! used (.owner r)) 0))
      0)
    (let [(mut changed) true]
      (loop (if (not (load changed))
                (break)
                (do
                  (set! changed false)
                  (for [i 0 (len (load requires))]
                    (let [r (elem requires i)]
                      (when (and (dep-id-member? used (.owner r))
                                 (dep-id-add! used (.id r)))
                        (set! changed true)
                        0))
                    0)))))
    used))

; Read a native provider's linker arguments: pkg-config for a `pkg-config`
; provider, the project's own command for a `flags-command` one. The provider runs
; here, in the build that links the package, and nowhere else -- a program that
; does not link the package never runs it. A failing provider stops the build.
(defn dep-native-tokens [(a (dyn Allocator))
                         (package (slice u8))
                         (kind i64)
                         (value (slice u8))] (-> (ptr (ArrayList (slice u8))))
  (native-provider-output a
                          (if (= kind 1)
                              (pkg-config-libs-command a value)
                              value)
                          (sconcat5 a
                                    "dependency package '"
                                    package
                                    "' native dependency '"
                                    value
                                    (if (= kind 1)
                                        "' was not found by pkg-config"
                                        "' flags-command failed"))))

; Append the link inputs of every dependency package this program loaded, in the
; order the command layer described them, and report the packages whose inputs
; were left out because nothing imported them.
(defn dep-link-flags! [(a (dyn Allocator))
                       (flags (mut (ArrayList (slice u8))))
                       (entries (ptr (ArrayList DepLinkEntry)))
                       (names (ptr (ArrayList DepPackageName)))
                       (requires (ptr (ArrayList DepRequire)))]
  (-> (ptr (ArrayList i64)))
  (let [used (dep-packages-used a entries requires)
        excluded (box-al [i64] a (ArrayList::new [i64] a))]
    (for [i 0 (len (load entries))]
      (let [e (elem entries i)]
        (if (dep-id-member? used (.id e))
            (if (= (.kind e) 0)
                (do (push! (mut flags) (.value e)) 0)
                (let [tokens
                        (dep-native-tokens a
                                           (dep-package-name names (.id e))
                                           (.kind e)
                                           (.value e))]
                  (for [j 0 (len (load tokens))]
                    (push! (mut flags) (get (load tokens) j))
                    0)
                  0))
            (do (dep-id-add! excluded (.id e)) 0)))
      0)
    excluded))

(defn build-cmd [(a (dyn Allocator))
                 (argc i32)
                 (argv (ptr (ptr i8)))
                 (build-fn (fnptr (cc/C)
                                  [(ref (dyn Allocator))
                                   (slice u8)
                                   (slice u8)
                                   (ptr i8)
                                   (ptr i8)
                                   (slice u8)]
                                  i64))
                 (emitir-fn (fnptr (cc/C)
                                   [(ref (dyn Allocator))
                                    (slice u8)
                                    (slice u8)
                                    (ptr i8)
                                    (slice u8)]
                                   i64))
                 (default-backend i64)] (-> i64)
  (let [fidx (argv-file-idx argc argv 2)
        _reader_inputs (reader-invocation-set! a argc argv fidx)
        flag-argc (argv-option-count argc argv)
        _rej (argv-reject-unknown flag-argc argv 2 fidx)
        file (load (index argv fidx))
        (mut outp) (primitive/cast (ptr i8) 0)
        (mut flags) (ArrayList::new [(slice u8)] a)
        (mut meta-flags) (ArrayList::new [(slice u8)] a)
        dep-entries (box-al [DepLinkEntry] a (ArrayList::new [DepLinkEntry] a))
        dep-names
          (box-al [DepPackageName] a (ArrayList::new [DepPackageName] a))
        dep-requires (box-al [DepRequire] a (ArrayList::new [DepRequire] a))
        (mut backend) default-backend
        (mut trip) (primitive/cast (ptr i8) 0)
        (mut libmode) 0  ; 0 = executable, 1 = --lib (.a), 2 = --shared (.dylib)
        (mut ehdr) (None [(slice u8)])
        (mut wantg) false  ; -g/--debug requested: gather a .dSYM after linking
        ; -g0/--no-debug: no DWARF even from the backends that emit it by default
        (mut nodebug) false
        ; --no-dsym (`coil run`'s build): keep default DWARF, skip gathering a .dSYM
        (mut nodsym) false
        ; Release is the default profile.  -g/--debug opts into DWARF and the
        ; build/debug output directory; --release can switch back explicitly.
        (mut release) true
        explicit-out (argv-has-flag? flag-argc argv "-o")
        (mut default-out) false
        (mut i) 2]
    ; second pass: --lib / --shared / --emit-header <h> / -g (DWARF via the host's
    ; native debug backend, which always emits DWARF).
    (let [(mut j) 2]
      (loop (if (>= (load j) (primitive/cast i64 flag-argc))
                (break)
                (do
                  (let [arg (from-cstr (load (index argv (load j))))]
                    (cond (= arg "--lib") (set! libmode 1)
                          (= arg "--shared") (set! libmode 2)
                          (= arg "--release") (set! release true)
                          (or (= arg "-g") (= arg "--debug"))
                            (do
                              (set! backend (host-native-backend))
                              (set! wantg true)
                              (set! release false)
                              0)
                          (or (= arg "-g0") (= arg "--no-debug"))
                            (set! nodebug true)
                          (= arg "--no-dsym") (set! nodsym true)
                          (= arg "--debug-checks") (enable-debug-checks!)
                          (= arg "--debug-runtime") (enable-debug-runtime!)
                          (= arg "--quiet") (set-quiet! true)
                          (sanitizer-flag? arg) (apply-sanitizer-flag! arg)
                          (jit-flag? arg) (apply-jit-flag! arg)
                          (opt-flag? arg) (apply-opt-flag! arg)
                          (meta-opt-flag? arg) (apply-meta-opt-flag! arg)
                          (starts-with arg "--wasm-stack-size=")
                            (apply-wasm-stack-flag! arg)
                          (and (< (primitive/iadd (load j) 1)
                                  (primitive/cast i64 flag-argc))
                               (= arg "--emit-header"))
                            (do
                              (set! ehdr
                                    (Some (from-cstr (load (index argv
                                                                  (primitive/iadd (load j)
                                                                                  1))))))
                              0)
                          :else 0))
                  (set! j (primitive/iadd (load j) 1))))))
    ; parse -o / --link-flag / -l<lib> / --backend / --target from argv[3..].
    (loop (if (>= (load i) (primitive/cast i64 flag-argc))
              (break)
              (do
                (let [arg (from-cstr (load (index argv (load i))))]
                  (cond (= arg "-o")
                          (do
                            (set! outp
                                  (load (index argv
                                               (primitive/iadd (load i)
                                                               1))))
                            (set! i (primitive/iadd (load i) 2))
                            0)
                        (= arg "--link-flag")
                          (do
                            (let [flag
                                    (from-cstr (load (index argv
                                                            (primitive/iadd (load i)
                                                                            1))))]
                              (push! (mut flags) flag)
                              (push! (mut meta-flags) flag))
                            (set! i (primitive/iadd (load i) 2))
                            0)
                        (= arg "--runtime-link-flag")
                          (do
                            (push! (mut flags)
                                   (from-cstr (load (index argv
                                                           (primitive/iadd (load i)
                                                                           1)))))
                            (set! i (primitive/iadd (load i) 2))
                            0)
                        ; A dependency package's source root: the loader marks the
                        ; package used when a namespace resolves under it.
                        (= arg "--dep-package")
                          (let [value
                                  (from-cstr (load (index argv
                                                          (primitive/iadd (load i)
                                                                          1))))]
                            (link-package-register! a
                                                    (dep-arg-id arg value)
                                                    (dep-arg-payload arg value))
                            (set! i (primitive/iadd (load i) 2))
                            0)
                        (= arg "--dep-name")
                          (let [value
                                  (from-cstr (load (index argv
                                                          (primitive/iadd (load i)
                                                                          1))))
                                (mut x) (zeroed DepPackageName)]
                            (set! (.id x) (dep-arg-id arg value))
                            (set! (.name x) (dep-arg-payload arg value))
                            (push! [DepPackageName] dep-names x)
                            (set! i (primitive/iadd (load i) 2))
                            0)
                        (= arg "--dep-requires")
                          (let [value
                                  (from-cstr (load (index argv
                                                          (primitive/iadd (load i)
                                                                          1))))
                                (mut x) (zeroed DepRequire)]
                            (set! (.owner x) (dep-arg-id arg value))
                            (set! (.id x)
                                  (match (parse-int (dep-arg-payload arg value))
                                    (Some [v] v)
                                    (None [] (do (dep-arg-reject! arg value) 0))))
                            (push! [DepRequire] dep-requires x)
                            (set! i (primitive/iadd (load i) 2))
                            0)
                        (or (= arg "--dep-link")
                            (= arg "--dep-native-pkg")
                            (= arg "--dep-native-command"))
                          (let [value
                                  (from-cstr (load (index argv
                                                          (primitive/iadd (load i)
                                                                          1))))
                                (mut x) (zeroed DepLinkEntry)]
                            (set! (.id x) (dep-arg-id arg value))
                            (set! (.kind x)
                                  (cond (= arg "--dep-native-pkg") 1
                                        (= arg "--dep-native-command") 2
                                        :else 0))
                            (set! (.value x) (dep-arg-payload arg value))
                            (push! [DepLinkEntry] dep-entries x)
                            (set! i (primitive/iadd (load i) 2))
                            0)
                        (= arg "--target")
                          (do
                            (set! trip
                                  (load (index argv
                                               (primitive/iadd (load i)
                                                               1))))
                            (set! i (primitive/iadd (load i) 2))
                            0)
                        (= arg "--use")
                          (do
                            (cli-use-add (from-cstr (load (index argv
                                                                 (primitive/iadd (load i)
                                                                                 1)))))
                            (set! i (primitive/iadd (load i) 2))
                            0)
                        (or (= arg "--reader-artifact") (= arg "--unit"))
                          (do (set! i (primitive/iadd (load i) 2)) 0)
                        (= arg "--emit-state")
                          (do
                            (set! (.path (state-build))
                                  (from-cstr (load (index argv
                                                          (primitive/iadd (load i)
                                                                          1)))))
                            (set! i (primitive/iadd (load i) 2))
                            0)
                        (= arg "--test-roots-file")
                          (do
                            (set-test-roots-file! (from-cstr (load (index argv
                                                                          (primitive/iadd (load i)
                                                                                          1)))))
                            (set! i (primitive/iadd (load i) 2))
                            0)
                        (and (>= (len arg) 2)
                             (and (= (get arg 0) (: 45 u8))
                                  (= (get arg 1) (: 108 u8))))
                          (do
                            (push! (mut flags) arg)
                            (push! (mut meta-flags) arg)
                            (set! i (primitive/iadd (load i) 1))
                            0)
                        ; -l<lib>
                        (= arg "--backend")
                          (do
                            (set! backend
                                  (backend-arg "build"
                                               (from-cstr (load (index argv
                                                                       (primitive/iadd (load i)
                                                                                       1))))
                                               true))
                            (set! i (primitive/iadd (load i) 2))
                            0)
                        (= arg "--wasm-side-module")
                          (do
                            (set-wasm-side-module! true)
                            (set! i (primitive/iadd (load i) 1))
                            0)
                        :else (do (set! i (primitive/iadd (load i) 1)) 0))))))
    ; Like Cargo, a build without an explicit destination keeps artifacts out of the
    ; source directory. The source basename is stable even when the file is elsewhere;
    ; trim the conventional .coil suffix but preserve other dotted names verbatim.
    (when (not explicit-out)
      (let [stem (source-output-stem (from-cstr file))
            profile (if (load release) "release" "debug")
            path (cat3-d a (cat3-d a "build/" profile) (cat3-d a "/" stem))]
        (set! outp (to-cstr a path))
        (set! default-out true))
      0)
    (when (load default-out)
      (unless (dir? (to-cstr a "build"))
        (native-only (fs/make-dir (to-cstr a "build") 493) 0)
        (unless (dir? (to-cstr a "build"))
          (ps (stderr) "error: could not create build directory\n")
          (exit 1)
          0))
      (let [profile-dir (if (load release) "build/release" "build/debug")]
        (unless (dir? (to-cstr a profile-dir))
          (native-only (fs/make-dir (to-cstr a profile-dir)
                                    493)
                       0)
          (unless (dir? (to-cstr a profile-dir))
            (ps (stderr) "error: could not create build profile directory\n")
            (exit 1)
            0))))
    ; A user-written `-o` is an exact path, and its directory is not created (see
    ; m-build-artifacts!). Say so before compiling; otherwise the linker fails
    ; on the temporary file it writes beside the output.
    (when explicit-out
      (let [out (from-cstr (load outp))
            dir (dirname out)]
        (unless (or (= (len dir) 0) (dir? (to-cstr a dir)))
          (ps (stderr) "error: cannot write `")
          (ps (stderr) out)
          (ps (stderr) "`: the directory `")
          (ps (stderr) dir)
          (ps (stderr) "` does not exist\n")
          (exit 1)
          0))
      0)
    ; The link is the host's own toolchain: a macOS host's links Apple platforms'
    ; binaries and a Linux host's links Linux ones. Building another OS's
    ; executable compiled its object and then fed it to that linker, which failed
    ; on a file it does not know (`ld: unknown file type`) after the whole compile.
    ; An object or a static library is still this host's to make.
    (when (and (!= (load libmode) 1)
               (!= (from-cstr (load outp)) "/dev/null")
               (foreign-link-target? (load trip)))
      (ps (stderr) "error: cannot link a ")
      (ps (stderr) (from-cstr (load trip)))
      (ps (stderr) (if (= (load libmode) 2) " shared library" " executable"))
      (ps (stderr)
          (if (me-host-linux?)
              " on this Linux host, whose linker makes Linux binaries\n"
              " on this macOS host, whose linker makes Apple platforms' binaries\n"))
      (ps (stderr) "  build its object with `coil emit-obj FILE --target ")
      (ps (stderr) (from-cstr (load trip)))
      (ps (stderr)
          " -o FILE.o` (or a static library with --lib) and link it with that platform's\n  toolchain, or build on that platform\n")
      (exit 1)
      0)
    ; `-o /dev/null` is the classic "just tell me if it compiles" idiom. There is no
    ; writable object destination, and handing it to codegen abends with a bare
    ; `LLVMTargetMachineEmitToFile ... Operation not permitted` (SIGABRT). Route it to the
    ; compile-check path instead — the full front-end, no object, located errors, exit 0
    ; on success — and `exit` before the pipeline/link machinery ever runs. (diag-12)
    (when (= (from-cstr (load outp)) "/dev/null")
      (ps (stderr)
          "note: -o /dev/null: compile-check only, no object written\n")
      (set-target-arch! (load trip))
      (set-meta-link-flags! (filter-meta-link-flags a (load meta-flags)))
      (exit (primitive/cast i32
                            (when (= (run-dump-on-big-stack a
                                                            (read-src a file)
                                                            (cwd-slice a)
                                                            (from-cstr file)
                                                            (fnptr-of check-src-program))
                                     0)
                              1)))
      0)
    ; Sanitizers need the LLVM backend (the native arm64 backend emits
    ; Mach-O directly, with no instrumentation pass) — reject the combination loudly
    ; rather than silently produce an UNinstrumented binary. When accepted, the
    ; program is instrument-LINKED with -fsanitize=address; the meta-link filter keeps
    ; that flag off the compiler's own metaprogram dylib (mem-7).
    (when (sanitizer?)
      (if (!= (load backend) 1)
          (do
            (ps (stderr)
                "error: --sanitize requires the LLVM backend (not --backend arm64, -g, or the LLVM-free compiler)\n")
            (exit 1)
            0)
          (do
            (when (and (= (sanitize-mode) 3)
                       (not (me-host-linux?)))
              (ps (stderr)
                  "error: --sanitize=memory is supported only on Linux (this LLVM has no Darwin MSan runtime)\n")
              (exit 1)
              0)
            (push! (mut flags) (sanitizer-link-flag)))))
    ; A saved state is the state of a program a session continues, which is a
    ; native executable.
    (when (and (state-build?)
               (or (!= (load libmode) 0)
                   (not (or (= (load backend) 1)
                            (native-backend? (load backend))))))
      (ps (stderr)
          "error: --emit-state saves the state of a native executable; it does not apply to --lib, --shared or a wasm build\n")
      (exit 1)
      0)
    (let [out-slice (from-cstr (load outp))
          obj-slice
            (if (= (load backend) 4)
                out-slice
                (build-temp-object a))]
      ; the native wasm backend emits a FINAL module (no link step), so it writes
      ; straight to the -o path; every other backend writes a private temporary object.
      (let [obj-cstr (to-cstr a obj-slice)
            (mut ctx) (zeroed DumpCtx)]
        (set! (.a ctx)
              a)
        (set! (.src ctx)
              (read-src a file))
        (set! (.cwd ctx)
              (cwd-slice a))
        (set! (.path ctx)
              (from-cstr file))
        (set! (.mode ctx)
              (load backend))
        (set! (.obj ctx)
              obj-cstr)
        (set! (.triple ctx)
              (load trip))
        (set! (.self ctx)
              (from-cstr (load (index argv 0))))
        (set-target-arch! (load trip))
        (set-native-emit-dwarf! (build-emits-dwarf? (load backend)
                                                    (load wantg)
                                                    (load nodebug)))
        (set-tpde-debug-frames! (and (load wantg) (not (load nodebug))))
        (set! (.ok ctx)
              0)
        (set! (.build-fn ctx)
              build-fn)
        (set! (.emitir-fn ctx)
              emitir-fn)
        ; Only explicit CLI link flags belong to metaprogram dylibs. Manifest
        ; [link] entries describe the final runtime artifact and must not load
        ; application libraries into the compiler process.
        (set-meta-link-flags! (filter-meta-link-flags a (load meta-flags)))
        (set-parallel-codegen! (and (= (load backend) 1)
                                    (and (= (load libmode) 0)
                                         (and (not (sanitizer?))
                                              (= (primitive/cast i64
                                                                 (load trip))
                                                 0)))))
        ; HALT on a compile error: run-on-big-stack returns 0 when the pipeline
        ; reported a diagnostic — it was already printed;
        ; return FAILURE (1) BEFORE the link step so no spurious `cc: no such
        ; file` / undefined-symbol junk is ever emitted.
        (let [object-count (run-on-big-stack (mut ctx))]
          (if (= object-count 0)
              (do
                (unless (= (load backend) 4)
                  (cleanup-build-object! a obj-slice))
                1)
              ; native wasm backend: the module written by build-wasm-program IS the final
              ; artifact — no cc/ar/finalizer step. Report and stop.
              (if (= (load backend) 4)
                  (do
                    (unless (quiet?)
                      (let [w (stdout)]
                        (ps w "wrote ")
                        (ps w out-slice)
                        (wb w 10))
                      0)
                    0)
                  ; final step depends on libmode. Every argument is a distinct argv
                  ; element and the linker driver is spawned directly, without a shell.
                  (let [dep-excluded
                          (dep-link-flags! a
                                           (mut flags)
                                           dep-entries
                                           dep-names
                                           dep-requires)
                        (mut linkargs) (ArrayList::new [(slice u8)] a)
                        link-out (staged-output-path a out-slice)
                        direct-sdk (darwin-direct-sdk a)
                        direct-darwin-link
                          (and (not (me-host-linux?))
                               (and (native-backend? (load backend))
                                    (and (= (load libmode)
                                            0)
                                         (and (= object-count 1)
                                              (and (not (or (native-cross-target? (load trip))
                                                            (apple-embedded-target? (load trip))))
                                                   (and (= (len (load flags)) 0)
                                                        (and (not (native-last-needs-curl?))
                                                             (and (not (native-last-needs-llvm?))
                                                                  (> (len direct-sdk)
                                                                     0)))))))))]
                    (if (= (load libmode) 1)
                        (let [archiver (native-archiver a (load trip))]
                          (when (= (len archiver) 0)
                            (cleanup-build-objects! a obj-slice object-count)
                            (ps (stderr) "error: a --lib archive for ")
                            (ps (stderr) (from-cstr (load trip)))
                            (ps (stderr)
                                " needs llvm-ar: the host ar archives only Mach-O objects, and there is no llvm-ar beside this compiler's LLVM\n")
                            (exit 1)
                            0)
                          (push! (mut linkargs) archiver)
                          (push! (mut linkargs) "rcs")
                          (push! (mut linkargs) link-out)
                          (let [(mut oi) 0]
                            (loop (if (>= (load oi) object-count)
                                      (break)
                                      (do
                                        (push! (mut linkargs)
                                               (build-object-at a
                                                                obj-slice
                                                                object-count
                                                                (load oi)))
                                        (set! oi (+ (load oi) 1))))))
                          0)
                        (do
                          (if direct-darwin-link
                              (do
                                (push! (mut linkargs) "/usr/bin/ld")
                                (push! (mut linkargs) "-dynamic")
                                (push! (mut linkargs) "-arch")
                                (push! (mut linkargs) "arm64")
                                (push! (mut linkargs) "-platform_version")
                                (push! (mut linkargs) "macos")
                                (let [named (macos-triple-version (load trip))
                                      minos
                                        (if (> (len named) 0)
                                            named
                                            (sconcat a
                                                     (i64->str a
                                                               MACOS-MIN-MAJOR)
                                                     ".0"))]
                                  (push! (mut linkargs) minos)
                                  (push! (mut linkargs) minos))
                                (push! (mut linkargs) "-syslibroot")
                                (push! (mut linkargs) direct-sdk)
                                0)
                              (do
                                (push! (mut linkargs) (native-link-driver a))
                                (when (coil-located-clang?)
                                  (push-found-clang-sysroot! a (mut linkargs))
                                  0)
                                (unless (me-host-linux?)
                                  (push-macos-version-min! a
                                                           (mut linkargs)
                                                           (load trip)))
                                0))
                          (when (= (load libmode) 2)
                            (push! (mut linkargs)
                                   (if (me-host-linux?) "-shared" "-dynamiclib"))
                            (unless (me-host-linux?)
                              (push! (mut linkargs)
                                     "-Wl,-undefined,dynamic_lookup")
                              0))
                          ; cross-target: the object's arch differs from the host cc's default
                          ; (arm64), so pass `-arch <arch>` — otherwise ld dies with
                          ; `found architecture '<arch>', required arm64` (xcompile). wasm never
                          ; reaches here; a null/host triple is not a cross-target. `-arch` is a
                          ; Mach-O-toolchain flag: on an ELF host it is not passed (cross-LINKING
                          ; there needs a cross toolchain the driver does not orchestrate).
                          (push-cross-link-target! a
                                                   (mut linkargs)
                                                   (load trip)
                                                   (load flags))
                          (let [(mut oi) 0]
                            (loop (if (>= (load oi) object-count)
                                      (break)
                                      (do
                                        (push! (mut linkargs)
                                               (build-object-at a
                                                                obj-slice
                                                                object-count
                                                                (load oi)))
                                        (set! oi (+ (load oi) 1))))))
                          ; Prebuilt units: their objects define what the program
                          ; declared. After the program's own objects, before the
                          ; flags, like any other object input.
                          (let [units (prebuilt-objects a)]
                            (for [k 0 (len (load units))]
                              (push! (mut linkargs) (get (load units) k))
                              0))
                          (push! (mut linkargs) "-o")
                          (push! (mut linkargs) link-out)
                          ; Every executable is linked as the reachable target
                          ; artifact, not as a container for every loaded declaration.
                          ; Reader providers, semantic checkers, and their compiler/
                          ; stdlib support execute during compilation; their unused
                          ; sections must not survive merely because they shared the
                          ; frontend Program.  This also gives ordinary programs the
                          ; expected dead-code behavior.  User-requested libraries keep
                          ; their complete externally visible surface.
                          (when (= (load libmode) 0)
                            (push! (mut linkargs)
                                   (if direct-darwin-link
                                       "-dead_strip"
                                       (if (me-host-linux?)
                                           "-Wl,--gc-sections"
                                           "-Wl,-dead_strip")))
                            0)
                          ; The session that adopts the saved state links what it
                          ; compiles to this program's definitions by name, so each
                          ; is kept and can be found in the running process.
                          (when (state-build?)
                            (push! (mut linkargs)
                                   (if direct-darwin-link
                                       "-export_dynamic"
                                       (if (me-host-linux?)
                                           "-rdynamic"
                                           "-Wl,-export_dynamic")))
                            0)
                          (let [linkflags (dedupe-link-flags a (load flags))
                                (mut k) 0
                                nf (len (load linkflags))]
                            (loop (if (>= (load k) nf)
                                      (break)
                                      (do
                                        (push! (mut linkargs)
                                               (get (load linkflags) (load k)))
                                        (set! k (primitive/iadd (load k) 1))))))
                          (let [(mut facts) (ArrayList::new [ObjectLinkFacts] a)
                                (mut curl-linked) false
                                (mut llvm-linked) false
                                (mut program-defines-curl) false]
                            (for [oi 0 object-count]
                              (let [item
                                      (object-link-facts (build-object-at a
                                                                          obj-slice
                                                                          object-count
                                                                          oi))]
                                (push! [ObjectLinkFacts] (mut facts) item)
                                (when (.defines-curl item)
                                  (set! program-defines-curl true)
                                  0))
                              0)
                            (for [oi 0 object-count]
                              (let [item (get (load facts) oi)]
                                (when (and (.needs-curl item)
                                           (and (not (load program-defines-curl))
                                                (not (load curl-linked))))
                                  (append-bundled-curl! a
                                                        direct-darwin-link
                                                        (mut linkargs)
                                                        (from-cstr (load (index argv
                                                                                0)))
                                                        (build-object-at a
                                                                         obj-slice
                                                                         object-count
                                                                         oi))
                                  (set! curl-linked true)
                                  0)
                                (when (and (.needs-llvm item)
                                           (not (load llvm-linked)))
                                  (append-llvm-runtime! a (mut linkargs))
                                  (set! llvm-linked true)
                                  0))
                              0)
                            ; A prebuilt unit's object may need what the program's
                            ; own objects did not: the compiler SDK unit uses LLVM.
                            (let [units (prebuilt-objects a)]
                              (for [k 0 (len (load units))]
                                (let [item
                                        (object-link-facts (get (load units) k))]
                                  (when (and (.needs-llvm item)
                                             (not (load llvm-linked)))
                                    (append-llvm-runtime! a (mut linkargs))
                                    (set! llvm-linked true)
                                    0)
                                  (when (and (.needs-curl item)
                                             (and (not (load program-defines-curl))
                                                  (not (load curl-linked))))
                                    (append-bundled-curl! a
                                                          direct-darwin-link
                                                          (mut linkargs)
                                                          (from-cstr (load (index argv
                                                                                  0)))
                                                          (get (load units) k))
                                    (set! curl-linked true)
                                    0))
                                0)))
                          ; glibc keeps the math library (exp, sqrt, fmod, ...) out of
                          ; libc, and cc does not link it by default. Any backend can
                          ; reference it: `frem` on x86-64 is fmod, and LLVM leaves
                          ; calls such as exp to the library, in the program or in a
                          ; prebuilt unit. It is harmless when nothing references it.
                          (when (me-host-linux?)
                            (push! (mut linkargs) "-lm")
                            0)
                          (when direct-darwin-link
                            (push! (mut linkargs) "-lSystem")
                            0)
                          0))
                    (let [link-span (tr/span-begin "driver.final-link")
                          rc
                            (if (wasm-target? (load trip))
                                (wasm-link-object a obj-cstr link-out)
                                (spawn-wait a (load linkargs)))
                          _link-end (tr/span-end link-span)
                          archived
                            (or (!= rc 0)
                                (or (!= (load libmode) 1)
                                    (let [members
                                            (archive-member-count a link-out)]
                                      (or (= members object-count)
                                          (do
                                            (ps (stderr) "error: the archive ")
                                            (ps (stderr) out-slice)
                                            (ps (stderr) " holds ")
                                            (dump-dec (stderr)
                                                      (if (< members 0)
                                                          0
                                                          members))
                                            (ps (stderr) " of the ")
                                            (dump-dec (stderr) object-count)
                                            (ps (stderr) " objects given to ")
                                            (ps (stderr)
                                                (get (load linkargs) 0))
                                            (ps (stderr) "\n")
                                            false)))))
                          published
                            (and (= rc 0)
                                 (and archived
                                      (publish-staged-output! a
                                                              link-out
                                                              out-slice)))]
                      (if (not published)
                          (let [w (stderr)
                                code (wait-code rc)]
                            (discard-staged-output! a link-out)
                            (cleanup-build-objects! a obj-slice object-count)
                            ; A successful link that could not be published has
                            ; already been reported by publish-staged-output!. A Wasm
                            ; module is finalized in process: its failure is a message
                            ; already printed and a plain 1, not a child's wait status,
                            ; and none of the native-linker advice below applies.
                            (unless (or (= rc 0)
                                        (wasm-target? (load trip)))
                              (wait-report rc "linker")
                              ; A NEGATIVE status means the spawn itself failed -- the
                              ; program was never started. wait-code maps that to 127, which
                              ; is the shell's "command not found" and reads as one, so
                              ; reporting it as an exit status sends the reader looking for
                              ; a missing library when the truth is a missing binary. Say
                              ; which one, since we know.
                              (if (< rc 0)
                                  (do
                                    (ps w
                                        "error: could not execute the linker driver '")
                                    (ps w (get (load linkargs) 0))
                                    (ps w "'\n")
                                    (ps w
                                        "note: set COIL_CC to the C driver to link with\n"))
                                  (do
                                    (ps w
                                        "error: linker/ar failed with exit status: ")
                                    (dump-dec w code)
                                    (wb w 10)))
                              ; The one undefined symbol this compiler can explain itself:
                              ; an EXECUTABLE built from a file whose only entry points are
                              ; tests. The missing `_main` is then the command, not the code,
                              ; and the generic advice below would send the reader looking for
                              ; a library that was never the problem — so it is this note OR
                              ; that one, never both.
                              (if (and (= (load libmode) 0)
                                       (built-a-test-file?))
                                  (do
                                    (ps w "note: this file defines ")
                                    (dump-dec w (.tests (entry-shape)))
                                    (ps w
                                        " test(s) and no `main`, so there is no program to link.\n")
                                    (ps w "      run them with `coil test ")
                                    (ps w (from-cstr file))
                                    (ps w
                                        "`, which loads the test runner and\n")
                                    (ps w
                                        "      gives the suite its entry point.\n")
                                    0)
                                  ; An executable whose program defines no `main` at all:
                                  ; the missing `_main` is the whole story (a transform
                                  ; that emitted `main` under a hygienic name is the
                                  ; usual way to get here).
                                  (if (and (= (load libmode)
                                              0)
                                           (and (>= rc 0)
                                                (not (.has-main (entry-shape)))))
                                      (do
                                        (ps w
                                            "note: the program defines no `main`, so an executable has no entry point.\n")
                                        (ps w
                                            "      The entry module needs `(defn main [] (-> i64) …)`; a macro or\n")
                                        (ps w
                                            "      transform that emits it must name it with the module's own syntax\n")
                                        (ps w
                                            "      (datum->syntax), or hygiene gives it a fresh name.\n")
                                        0)
                                      ; `(>= rc 0)`: the same rule the comment above states. A
                                      ; spawn that never started the linker produced no undefined
                                      ; symbols to explain, so this advice would be about a
                                      ; library that was never the problem.
                                      (when (>= rc 0)
                                        ; The linker's own "Undefined symbols" list says WHAT is
                                        ; missing and never how to supply it, which reliably reads
                                        ; as a compiler fault rather than a missing link input.
                                        ; Name the two ways.
                                        (ps w
                                            "note: if those symbols come from a native library, declare it in Coil.toml\n")
                                        (ps w
                                            "      [link] flags = [\"-Wl,-force_load,path/to/lib.a\", \"-framework\", \"Foo\"]\n")
                                        (ps w
                                            "      (applied to `coil build`, `coil run` and `coil test` alike), or pass\n")
                                        (ps w
                                            "      --link-flag on the command line.\n")
                                        ; A dependency package's link inputs reach only
                                        ; a program that imports its code. Say so when
                                        ; one was left out: the symbols it would have
                                        ; supplied are the likely cause.
                                        (for [di 0 (len (load dep-excluded))]
                                          (let [name
                                                  (dep-package-name dep-names
                                                                    (get (load dep-excluded)
                                                                         di))]
                                            (ps w "note: dependency '")
                                            (ps w name)
                                            (ps w
                                                "' declares link inputs, but this program imports no\n")
                                            (ps w
                                                "      module from it, so they were not linked. Import what you use\n")
                                            (ps w
                                                "      from it, or declare those inputs in this package's own [link].\n"))
                                          0)
                                        0)))
                              0)
                            1)
                          (do
                            (unless (quiet?)
                              (let [w (stdout)]
                                (ps w "wrote ")
                                (ps w out-slice)
                                (wb w 10))
                              0)
                            ; Gather the dSYM before deleting the temporary object: the
                            ; executable's debug map names that linker input.
                            (when (and (or (load wantg)
                                           (and (native-emit-dwarf?)
                                                (not (load nodsym))))
                                       (and (not (wasm-target? (load trip)))
                                            (= (load libmode)
                                               0)))
                              (run-dsymutil a out-slice))
                            (cleanup-build-objects! a obj-slice object-count)
                            (when (state-build?)
                              (let [state-path (.path (state-build))
                                    staged (staged-output-path a state-path)]
                                (match (fs/write-file a
                                                      staged
                                                      (.bytes (state-build)))
                                  (Err [_]
                                       (do
                                         (ps (stderr) "error: cannot write `")
                                         (ps (stderr) state-path)
                                         (ps (stderr) "`\n")
                                         (exit 1)
                                         0))
                                  (Ok [_] 0))
                                (unless (publish-staged-output! a
                                                                staged
                                                                state-path)
                                  (exit 1)
                                  0)
                                (unless (quiet?)
                                  (ps (stdout) "wrote ")
                                  (ps (stdout) state-path)
                                  (wb (stdout) 10)
                                  0))
                              0)
                            (match ehdr
                              (Some [h]
                                    (cheader-program a
                                                     (read-src a file)
                                                     (dirname (from-cstr file))
                                                     (from-cstr file)
                                                     (Some h)))
                              (None [] 0)))))))))))))

; Words C (through C23) or C++ reserves, and the <stdint.h>/<stdbool.h> type
; names the header itself spells. A Coil name spelled as one of them is written
; with a trailing `_`: a field or tag name is not part of the ABI.
(defn ch-reserved-words [(a (dyn Allocator))] (-> (HashMap (slice u8) i64))
  (let [(mut words) (HashMap::new [(slice u8) i64] a (keyops))
        text
          (sconcat3 a
                    "auto break case char const continue default do double else enum extern float for goto if inline int long register restrict return short signed sizeof static struct switch typedef union unsigned void volatile while _Alignas _Alignof _Atomic _Bool _Complex _Generic _Imaginary _Noreturn _Static_assert _Thread_local alignas alignof bool constexpr false nullptr static_assert thread_local true typeof typeof_unqual _BitInt _Decimal32 _Decimal64 _Decimal128 "
                    "and and_eq asm bitand bitor catch char8_t char16_t char32_t class co_await co_return co_yield compl concept const_cast consteval constinit decltype delete dynamic_cast explicit export friend mutable namespace new noexcept not not_eq operator or or_eq private protected public reflexpr requires reinterpret_cast static_cast template this throw try typeid typename using virtual wchar_t xor xor_eq "
                    "int8_t int16_t int32_t int64_t uint8_t uint16_t uint32_t uint64_t")
        (mut list) (split a text " ")]
    (for [i 0 (len list)]
      (set! (mut words) (get list i) 1))
    (free! (mut list))
    (load words)))

; The C identifier for one segment of a Coil name: `-` becomes `_`, a reserved
; word gets a trailing `_`, and any other character C cannot spell is an error
; (an invented spelling could collide with a name that really is written so).
(defn ch-ident [(a (dyn Allocator))
                (reserved (ptr (HashMap (slice u8) i64)))
                (what (slice u8))
                (name (slice u8))] (-> (Result (slice u8) (slice u8)))
  (let [(mut out) (StrBuf::new a)
        (mut bad) false]
    (for [i 0 (len name)]
      (let [c (get name i)]
        (cond (or (and (>= c (: 97 u8)) (<= c (: 122 u8)))
                  (and (>= c (: 65 u8)) (<= c (: 90 u8)))
                  (= c (: 95 u8))
                  (and (and (>= c (: 48 u8)) (<= c (: 57 u8))) (> i 0)))
                (push! (mut out) c)
              (= c (: 45 u8)) (push! (mut out) (: 95 u8))
              :else (set! bad true))))
    (if (or (load bad) (= (len name) 0))
        (Err (sconcat5 a
                       "cheader: "
                       what
                       " '"
                       name
                       "' has no C identifier spelling"))
        (let [s (str (load out))]
          (match (get (load reserved) s)
            (Some [_] (Ok (sconcat a s "_")))
            (None [] (Ok s)))))))

; The last `.`-separated segment of a qualified name.
(defn ch-leaf [(qualified (slice u8))] (-> (slice u8))
  (let [(mut cut) 0]
    (for [i 0 (len qualified)]
      (when (= (get qualified i) (: 46 u8))
        (set! cut (+ i 1))))
    (subslice [u8] qualified (load cut) (len qualified))))

; The whole qualified name as one identifier: `a.b.Thing` -> `a_b_Thing`.
(defn ch-qualified-ident [(a (dyn Allocator))
                          (reserved (ptr (HashMap (slice u8) i64)))
                          (qualified (slice u8))]
  (-> (Result (slice u8) (slice u8)))
  (let [(mut flat) (StrBuf::new a)]
    (for [i 0 (len qualified)]
      (let [c (get qualified i)]
        (push! (mut flat)
               (if (= c (: 46 u8))
                   (: 95 u8)
                   c))))
    (match (ch-ident a reserved "type" (str (load flat)))
      (Ok [s] (Ok s))
      (Err [_]
           (Err (sconcat3 a
                          "cheader: type '"
                          qualified
                          "' has no C identifier spelling"))))))

(defn ch-find-struct [(p (ptr Program)) (name (slice u8))] (-> (ptr StructDef))
  (let [ss (load (field p structs))
        n (len ss)
        (mut i) 0
        (mut r) (primitive/cast (ptr StructDef) 0)]
    (loop (if (>= (load i) n)
              (break)
              (do
                (when (= (.name (elem ss (load i)))
                         name)
                  (set! r (elem ss (load i)))
                  (break))
                (set! i (primitive/iadd (load i) 1)))))
    (load r)))

(defn ch-is-sum? [(p (ptr Program)) (name (slice u8))] (-> bool)
  (let [ss (load (field p sums))
        (mut found) false]
    (for [i 0 (len ss)]
      (when (= (.name (elem ss i)) name)
        (set! found true)))
    (load found)))

; Whether C can describe a value of type T: its storage, not just a pointer to
; it. A struct qualifies when its layout is one C spells (natural, packed or
; aligned) and so does every field it holds by value; a pointer to anything
; qualifies, since the header can name its pointee as an opaque tag.
(defn ch-describable? [(p (ptr Program)) (t Type)] (-> bool)
  (match t
    (TInt [bits _] (or (= bits 8) (= bits 16) (= bits 32) (= bits 64)))
    (TFloat [bits] (or (= bits 32) (= bits 64)))
    (TBool [] true)
    (TPtr [_] true)
    (TFn [cc _ _] (= (cc-identity cc) (c-convention)))
    (TArray [inner _] (ch-describable? p (load inner)))
    (TStruct [name]
             (let [sd (ch-find-struct p name)]
               (if (= (primitive/cast i64 sd) 0)
                   false
                   (let [layout-ok
                           (match (.layout sd)
                             (LC [] true)
                             (LPacked [] true)
                             (LAligned [_] true)
                             (_ false))
                         fs (load (field sd fields))
                         (mut ok) layout-ok]
                     (for [i 0 (len fs)]
                       (unless (ch-describable? p (.ty (elem fs i)))
                         (set! ok false)))
                     (load ok)))))
    (_ false)))

; Collect the structs the header defines, dependency-first: a struct's by-value
; fields are defined before it. Whatever is reached through a pointer (or as a
; function pointer's parameter or result, which a declaration may leave
; incomplete) is put on PENDING instead, and taken up after the struct that
; points at it, so a pointer cycle cannot put a struct ahead of one it contains.
(defn ch-collect [(t Type)
                  (p (ptr Program))
                  (order (ptr (ArrayList (slice u8))))
                  (seen (ptr (HashMap (slice u8) i64)))
                  (pending (ptr (ArrayList Type)))] (-> i64)
  (match t
    (TStruct [name]
             (match (get (load seen) name)
               (Some [_] 0)
               (None []
                     (do
                       (set! seen name 1)
                       ; A name with no struct (a sum) is not defined here:
                       ; by value it is an error the prototype reports.
                       (let [sd (ch-find-struct p name)]
                         (unless (= (primitive/cast i64 sd) 0)
                           (let [fs (load (field sd fields))]
                             (for [i 0 (len fs)]
                               (ch-collect (.ty (elem fs i))
                                           p
                                           order
                                           seen
                                           pending)))
                           (push! [(slice u8)] order name)))
                       0))))
    (TPtr [inner] (do (push! [Type] pending (load inner)) 0))
    (TFn [_ params ret]
         (do
           (for [i 0 (len (load params))]
             (push! [Type] pending (get (load params) i)))
           (push! [Type] pending (load ret))
           0))
    (TArray [inner _] (ch-collect (load inner) p order seen pending))
    (_ 0)))

; Take up what was reached through pointers. A struct C can describe is
; defined; anything else becomes an opaque tag, which is all a pointer needs.
(defn ch-drain [(p (ptr Program))
                (order (ptr (ArrayList (slice u8))))
                (opaque (ptr (ArrayList (slice u8))))
                (seen (ptr (HashMap (slice u8) i64)))
                (pending (ptr (ArrayList Type)))] (-> i64)
  (let [(mut k) 0]
    (loop (if (>= (load k) (len (load pending)))
              (break)
              (let [t (get (load pending) (load k))]
                (set! k (+ (load k) 1))
                (match t
                  (TStruct [name]
                           (if (ch-describable? p t)
                               (ch-collect t p order seen pending)
                               (match (get (load seen) name)
                                 (Some [_] 0)
                                 (None []
                                       (do
                                         (set! seen name 1)
                                         (push! [(slice u8)] opaque name)
                                         0)))))
                  (_ (ch-collect t p order seen pending))))))
    0))

; A base type's declaration: `int64_t`, or `int64_t *p` once a declarator is
; written beside it.
(defn ch-base [(a (dyn Allocator)) (spelled (slice u8)) (decl (slice u8))]
  (-> (Result (slice u8) (slice u8)))
  (Ok (if (= (len decl) 0)
          spelled
          (sconcat3 a spelled " " decl))))

; The C declaration of DECL (a declarator, or "" for an abstract type) with type
; T, written inside-out so a function pointer or a pointer to an array keeps its
; name where C requires it: `int64_t (*f)(int64_t)`, not `int64_t (*)(int64_t) f`.
; VOID-OK admits `void`, as a result or behind a pointer.
(defn ch-declare [(a (dyn Allocator))
                  (p (ptr Program))
                  (names (ptr (HashMap (slice u8) (slice u8))))
                  (t Type)
                  (decl (slice u8))
                  (void-ok bool)] (-> (Result (slice u8) (slice u8)))
  (match t
    (TInt [bits signed]
          (if (or (= bits 8) (= bits 16) (= bits 32) (= bits 64))
              (ch-base a
                       (sconcat3 a
                                 (if signed "int" "uint")
                                 (i64->str a bits)
                                 "_t")
                       decl)
              (Err (sconcat3 a
                             "cheader: i"
                             (i64->str a bits)
                             " has no standard C type (use 8/16/32/64-bit)"))))
    (TFloat [bits]
            (if (or (= bits 32) (= bits 64))
                (ch-base a (if (= bits 32) "float" "double") decl)
                (Err (sconcat3 a
                               "cheader: f"
                               (i64->str a bits)
                               " has no standard C type"))))
    (TBool [] (ch-base a "bool" decl))
    (TVoid []
           (if void-ok
               (ch-base a "void" decl)
               (Err "cheader: void has no C representation")))
    (TPtr [inner]
          (let [wrapped
                  (match (load inner)
                    (TFn [_ _ _] (sconcat3 a "(*" decl ")"))
                    (TArray [_ _] (sconcat3 a "(*" decl ")"))
                    (_ (sconcat a "*" decl)))]
            (ch-declare a p names (load inner) wrapped true)))
    (TFn [cc params ret]
         (if (not (= (cc-identity cc) (c-convention)))
             (Err "cheader: only `(fnptr (cc/C) …)` has a C function-pointer representation")
             (match (ch-params a p names (load params))
               (Err [e] (Err e))
               (Ok [plist]
                   (ch-declare a
                               p
                               names
                               (load ret)
                               (sconcat5 a "(*" decl ")(" plist ")")
                               true)))))
    (TArray [inner k-extent]
            (ch-declare a
                        p
                        names
                        (load inner)
                        (sconcat4 a
                                  decl
                                  "["
                                  (i64->str a (extent-value k-extent))
                                  "]")
                        false))
    (TStruct [name]
             (match (get (load names) name)
               (Some [spelled] (ch-base a spelled decl))
               (None []
                     (Err (sconcat3 a
                                    "cheader: type '"
                                    name
                                    "' has no C representation")))))
    (_ (Err "cheader: type has no C representation"))))

; A parameter list `(T1, T2)`'s inside: `void` when there are none. A C array
; parameter would decay to a pointer, so an array passed by value has no C
; spelling here.
(defn ch-params [(a (dyn Allocator))
                 (p (ptr Program))
                 (names (ptr (HashMap (slice u8) (slice u8))))
                 (params (ArrayList Type))] (-> (Result (slice u8) (slice u8)))
  (let [(mut out) (StrBuf::new a)
        (mut err) (None [(slice u8)])]
    (when (= (len params) 0)
      (push-str! (mut out) "void"))
    (for [i 0 (len params)]
      (when (none? (load err))
        (match (ch-by-value a p names (get params i) "" false)
          (Err [e] (set! err (Some e)))
          (Ok [pt]
              (do
                (when (> i 0)
                  (push-str! (mut out) ", "))
                (push-str! (mut out) pt))))))
    (match (load err)
      (Some [e] (Err e))
      (None [] (Ok (str (load out)))))))

; ch-declare for a value passed or returned by value, which C cannot do for an
; array, and which cannot be a type the header only names.
(defn ch-by-value [(a (dyn Allocator))
                   (p (ptr Program))
                   (names (ptr (HashMap (slice u8) (slice u8))))
                   (t Type)
                   (decl (slice u8))
                   (void-ok bool)] (-> (Result (slice u8) (slice u8)))
  (match t
    (TArray [_ _]
            (Err "cheader: a C function cannot take or return an array by value; pass a pointer"))
    (TStruct [name]
             (if (ch-describable? p t)
                 (ch-declare a p names t decl void-ok)
                 (Err (sconcat3 a
                                (if (ch-is-sum? p name)
                                    "cheader: sum '"
                                    "cheader: type '")
                                name
                                "' has no C layout to pass by value; export a pointer to it"))))
    (_ (ch-declare a p names t decl void-ok))))

(defn ch-render-struct [(a (dyn Allocator))
                        (p (ptr Program))
                        (names (ptr (HashMap (slice u8) (slice u8))))
                        (reserved (ptr (HashMap (slice u8) i64)))
                        (sd (ptr StructDef))]
  (-> (Result (slice u8) (slice u8)))
  (let [tag
          (match (get (load names) (.name sd))
            (Some [s] s)
            (None [] (.name sd)))
        attr
          (match (.layout sd)
            (LPacked [] (Some " __attribute__((__packed__))"))
            (LC [] (Some ""))
            (LAligned [n]
                      (Some (sconcat3 a
                                      " __attribute__((__aligned__("
                                      (i64->str a n)
                                      ")))")))
            (_ (None [(slice u8)])))]
    (match attr
      (None []
            (Err (sconcat3 a
                           "cheader: struct '"
                           (.name sd)
                           "' has an :explicit/:bits layout the header generator can't emit; export a :c-layout struct")))
      (Some [attr]
            (let [(mut out) (StrBuf::new a)
                  (mut err) (None [(slice u8)])
                  (mut fields-seen) (HashMap::new [(slice u8) i64] a (keyops))
                  fs (load (field sd fields))]
              (push-str! (mut out) (sconcat5 a "struct" attr " " tag " {\n"))
              (for [i 0 (len fs)]
                (when (none? (load err))
                  (let [fp (elem fs i)]
                    (match (ch-ident a reserved "field" (.name fp))
                      (Err [e] (set! err (Some e)))
                      (Ok [fname]
                          (match (get fields-seen fname)
                            (Some [_]
                                  (set! err
                                        (Some (sconcat5 a
                                                        "cheader: two fields of struct '"
                                                        (.name sd)
                                                        "' are both spelled '"
                                                        fname
                                                        "' in C"))))
                            (None []
                                  (do
                                    (set! (mut fields-seen) fname 1)
                                    (match (ch-by-value-field a
                                                              p
                                                              names
                                                              (.ty fp)
                                                              fname)
                                      (Err [e] (set! err (Some e)))
                                      (Ok [line]
                                          (push-str! (mut out)
                                                     (sconcat3 a
                                                               "    "
                                                               line
                                                               ";\n"))))))))))))
              (free! (mut fields-seen))
              (match (load err)
                (Some [e] (Err e))
                (None []
                      (do
                        (push-str! (mut out) "};\n")
                        (Ok (str (load out)))))))))))

; A field holds its value: an array field is spelled as one, any other type must
; have a C layout.
(defn ch-by-value-field [(a (dyn Allocator))
                         (p (ptr Program))
                         (names (ptr (HashMap (slice u8) (slice u8))))
                         (t Type)
                         (fname (slice u8))] (-> (Result (slice u8) (slice u8)))
  (match t
    (TArray [_ _] (ch-declare a p names t fname false))
    (_ (ch-by-value a p names t fname false))))

; Give every type the header names a C spelling. A type's own name is used when
; no other type named here shares it; two that do (`a.Thing`, `b.Thing`) are
; both spelled from their whole qualified names. A spelling that still clashes,
; with another type or with an exported function, is an error rather than a
; header that redefines a name.
(defn ch-assign-names [(a (dyn Allocator))
                       (reserved (ptr (HashMap (slice u8) i64)))
                       (types (ptr (ArrayList (slice u8))))
                       (functions (ptr (ArrayList (slice u8))))
                       (names (ptr (HashMap (slice u8) (slice u8))))]
  (-> (Option (slice u8)))
  (let [(mut leaf-count) (HashMap::new [(slice u8) i64] a (keyops))
        (mut owner) (HashMap::new [(slice u8) (slice u8)] a (keyops))
        (mut err) (None [(slice u8)])]
    (for [i 0 (len (load types))]
      (let [leaf (ch-leaf (get (load types) i))]
        (set! (mut leaf-count)
              leaf
              (+ (match (get leaf-count leaf)
                   (Some [n] n)
                   (None [] 0))
                 1))))
    (for [i 0 (len (load functions))]
      (set! (mut owner)
            (get (load functions) i)
            (sconcat a "function " (get (load functions) i))))
    (for [i 0 (len (load types))]
      (when (none? (load err))
        (let [q (get (load types) i)
              leaf (ch-leaf q)
              spelled
                (if (> (match (get leaf-count leaf)
                         (Some [n] n)
                         (None [] 0))
                       1)
                    (ch-qualified-ident a reserved q)
                    (ch-ident a reserved "type" leaf))]
          (match spelled
            (Err [e] (set! err (Some e)))
            (Ok [s]
                (match (get owner s)
                  (Some [other]
                        (set! err
                              (Some (sconcat5 a
                                              "cheader: type '"
                                              q
                                              "' and "
                                              (if (starts-with other
                                                               "function ")
                                                  other
                                                  (sconcat3 a
                                                            "type '"
                                                            other
                                                            "'"))
                                              (sconcat3 a
                                                        " are both spelled '"
                                                        s
                                                        "' in C")))))
                  (None []
                        (do
                          (set! (mut owner) s q)
                          (set! names q s)
                          0))))))))
    (free! (mut leaf-count))
    (free! (mut owner))
    (load err)))

; Render the full C header for the program's exports (Result text/err).
(defn cheader-render [(a (dyn Allocator)) (p (ptr Program))]
  (-> (Result (slice u8) (slice u8)))
  (let [order (box! a (ArrayList (slice u8)) (ArrayList::new [(slice u8)] a))
        opaque (box! a (ArrayList (slice u8)) (ArrayList::new [(slice u8)] a))
        pending (box! a (ArrayList Type) (ArrayList::new [Type] a))
        seen
          (box! a
                (HashMap (slice u8) i64)
                (HashMap::new [(slice u8) i64] a (keyops)))
        names
          (box! a
                (HashMap (slice u8) (slice u8))
                (HashMap::new [(slice u8) (slice u8)] a (keyops)))
        reserved (box! a (HashMap (slice u8) i64) (ch-reserved-words a))
        symbols (box! a (ArrayList (slice u8)) (ArrayList::new [(slice u8)] a))
        funcs (box! a (ArrayList (ptr Func)) (ArrayList::new [(ptr Func)] a))
        ; The C signature's parameters are the entry's, not the definition's:
        ; the definition's may already be lowered (a struct by value passed by
        ; pointer).
        entries
          (box! a (ArrayList (ptr ExportC)) (ArrayList::new [(ptr ExportC)] a))
        es (load (field p exports))
        (mut err) (None [(slice u8)])]
    ; The published exports, each with its definition and C symbol.
    (for [i 0 (len es)]
      (let [ep (elem es i)
            sym
              (match (.symbol ep)
                (Some [s] s)
                (None [] (.name ep)))
            fp (ch-find-func p (.name ep))]
        ; An unpublished entry is a fnptr-of target with no C symbol.
        (when (and (.published ep) (none? (load err)))
          (cond (= (primitive/cast i64 fp) 0)
                  (set! err
                        (Some (sconcat a
                                       "cheader: exported function not found: "
                                       (.name ep))))
                ; A linker symbol cannot be renamed in the header: it must already
                ; be a C identifier, and not a reserved word.
                (match (ch-ident a reserved "symbol" sym)
                  (Ok [s] (not (= s sym)))
                  (Err [_] true))
                  (set! err
                        (Some (sconcat3 a
                                        "cheader: exported symbol '"
                                        sym
                                        "' is not a C identifier; name one with (export-c [NAME :as \"c_name\"])")))
                :else
                  (do
                    (push! [(slice u8)] symbols sym)
                    (push! [(ptr Func)] funcs fp)
                    (push! [(ptr ExportC)] entries ep)
                    (ch-collect (.ret fp) p order seen pending)
                    (let [ps (load (field ep params))]
                      (for [j 0 (len ps)]
                        (ch-collect (get ps j) p order seen pending))))))))
    (ch-drain p order opaque seen pending)
    (when (none? (load err))
      (let [(mut all) (ArrayList::new [(slice u8)] a)]
        (for [k 0 (len (load order))] (push! (mut all) (get (load order) k)))
        (for [k 0 (len (load opaque))] (push! (mut all) (get (load opaque) k)))
        (set! err (ch-assign-names a reserved (mut all) symbols names))))
    (let [(mut protos) (StrBuf::new a)]
      (for [i 0 (len (load funcs))]
        (when (none? (load err))
          (let [fp (get (load funcs) i)
                sym (get (load symbols) i)
                ep (get (load entries) i)]
            (match (ch-params a p names (load (field ep params)))
              (Err [e] (set! err (Some e)))
              (Ok [plist]
                  (match (ch-by-value a
                                      p
                                      names
                                      (.ret fp)
                                      (sconcat4 a sym "(" plist ")")
                                      true)
                    (Err [e] (set! err (Some e)))
                    (Ok [line] (push-str! (mut protos) (sconcat a line ";\n")))))))))
      (let [(mut out) (StrBuf::new a)]
        (push-str! (mut out)
                   "/* Generated by `coil cheader`. */\n#pragma once\n#include <stdint.h>\n#include <stdbool.h>\n\n#ifdef __cplusplus\nextern \"C\" {\n#endif\n\n")
        (let [(mut tagged) 0]
          (for [k 0 (len (load order))]
            (let [tag
                    (match (get (load names) (get (load order) k))
                      (Some [s] s)
                      (None [] ""))]
              (set! tagged (+ (load tagged) 1))
              (push-str! (mut out)
                         (sconcat5 a "typedef struct " tag " " tag ";\n"))))
          (for [k 0 (len (load opaque))]
            (let [tag
                    (match (get (load names) (get (load opaque) k))
                      (Some [s] s)
                      (None [] ""))]
              (set! tagged (+ (load tagged) 1))
              (push-str! (mut out)
                         (sconcat5 a "typedef struct " tag " " tag ";\n"))))
          (when (> (load tagged) 0)
            (push-str! (mut out) "\n")))
        (for [k 0 (len (load order))]
          (when (none? (load err))
            (match (ch-render-struct a
                                     p
                                     names
                                     reserved
                                     (ch-find-struct p (get (load order) k)))
              (Err [e] (set! err (Some e)))
              (Ok [sbody]
                  (do
                    (push-str! (mut out) sbody)
                    (push-str! (mut out) "\n"))))))
        (match (load err)
          (Some [e] (Err [(slice u8) (slice u8)] e))
          (None []
                (do
                  (push-str! (mut out) (str (load protos)))
                  (push-str! (mut out) "\n#ifdef __cplusplus\n}\n#endif\n")
                  (Ok (str (load out))))))))))

(defn ch-find-func [(p (ptr Program)) (name (slice u8))] (-> (ptr Func))
  (let [fs (load (field p funcs))
        n (len fs)
        (mut i) 0
        (mut r) (primitive/cast (ptr Func) 0)]
    (loop (if (>= (load i) n)
              (break)
              (do
                (when (= (.name (elem fs (load i))) name)
                  (set! r (elem fs (load i)))
                  (break))
                (set! i (primitive/iadd (load i) 1)))))
    (load r)))

; run the pipeline to a checked Program, render its C header, write to `out`
; (Some file) or stdout (None). Returns 0 on success, 1 on error.
; The header describes a CHECKED program, so it has to be produced by the same
; frontend everything else runs. This used to load, resolve and check the source
; itself -- a second pipeline that never grew the setup the real one has, so it
; stopped at the prelude's own declaration forms and reported an unformatted
; diagnostic against a source it had not registered. `coil cheader` failed on every
; input, and so did `coil build --emit-header`, which shares this path.
(defn cheader-program [(a (dyn Allocator))
                       (src (slice u8))
                       (cwd (slice u8))
                       (path (slice u8))
                       (out (Option (slice u8)))] (-> i64)
  (let [w (stderr)
        (mut sp0) (ArrayList::new [(slice u8)] a)
        (mut st0) (ArrayList::new [(slice u8)] a)]
    (match (run-pipeline a src cwd w path (mut sp0) (mut st0))
      (None [] 1)
      (Some [cp]
            (match (cheader-render a cp)
              (Err [e]
                   (do
                     (ps (stderr) "error: ")
                     (ps (stderr) e)
                     (wb (stderr) 10)
                     1))
              (Ok [hdr]
                  (match out
                    (None [] (do (ps (stdout) hdr) 0))
                    (Some [o]
                          (if (!= (d-write-file a o hdr) 0)
                              1
                              (let [w2 (stdout)]
                                (ps w2 "wrote ")
                                (ps w2 o)
                                (wb w2 10)
                                0))))))))))

; Resource paths must resolve the command the same way the shell did, and the same way
; the loader locates the standard library — one answer to "where am I", in one place.
(defn m-resolve-self [(a (dyn Allocator)) (self (slice u8))] (-> (slice u8))
  (resolve-command-path a self))

; dlopen(NULL) + dlsym + dladdr: used by llvm-sibling-clang to ask the loader
; which libLLVM this process actually has, without linking against it.
(extern dlopen :cc (cc/C) [(ptr i8) i32] (-> (ptr i8)))

(extern dlsym :cc (cc/C) [(ptr i8) (ptr i8)] (-> (ptr i8)))

(extern dladdr :cc (cc/C) [(ptr i8) (ptr i8)] (-> i32))

; Final Wasm linking is a Coil binary transformation, not a child process.
(defn wasm-link-object [(a (dyn Allocator))
                        (obj-path (ptr i8))
                        (out-path (slice u8))] (-> i64)
  (match (wasm-finalize a (read-file a obj-path))
    (Ok [module] (d-write-file a out-path module))
    (Err [why] (do (ps (stderr) why) (wb (stderr) 10) 1))))

; `emit-obj <file> [-o out.o] [--target T] [--backend arm64]` — build the object,
; no link. Mirrors build-cmd's pipeline minus the cc step.
(defn emit-obj-cmd [(a (dyn Allocator))
                    (argc i32)
                    (argv (ptr (ptr i8)))
                    (build-fn (fnptr (cc/C)
                                     [(ref (dyn Allocator))
                                      (slice u8)
                                      (slice u8)
                                      (ptr i8)
                                      (ptr i8)
                                      (slice u8)]
                                     i64))
                    (emitir-fn (fnptr (cc/C)
                                      [(ref (dyn Allocator))
                                       (slice u8)
                                       (slice u8)
                                       (ptr i8)
                                       (slice u8)]
                                      i64))
                    (default-backend i64)] (-> i64)
  (let [file (load (index argv 2))
        _uses (argv-apply-uses! argc argv)
        (mut outp) (primitive/cast (ptr i8) 0)
        (mut backend) default-backend
        (mut trip) (primitive/cast (ptr i8) 0)
        (mut nodebug) false
        (mut i) 3]
    (loop (if (>= (load i) (primitive/cast i64 argc))
              (break)
              (let [arg (from-cstr (load (index argv (load i))))]
                (cond (= arg "-o")
                        (do
                          (set! outp
                                (load (index argv
                                             (primitive/iadd (load i)
                                                             1))))
                          (set! i (primitive/iadd (load i) 2))
                          0)
                      ; The instrumentation flags `build` honours. emit-obj accepted
                      ; these and did NOTHING with them: it parsed only -o/--target/
                      ; --backend and let everything else fall through to the :else
                      ; skip, so `emit-obj --debug-runtime` produced a plain object
                      ; with no stack protector, no ASan and no crash handler -- and
                      ; said nothing about it. Silently ignoring a flag that asks for
                      ; instrumentation is the worst of the options; wire them to the
                      ; same switches the build path sets.
                      (= arg "--debug-checks")
                        (do
                          (enable-debug-checks!)
                          (set! i (primitive/iadd (load i) 1))
                          0)
                      (= arg "--debug-runtime")
                        (do
                          (enable-debug-runtime!)
                          (set! i (primitive/iadd (load i) 1))
                          0)
                      (= arg "--quiet")
                        (do
                          (set-quiet! true)
                          (set! i (primitive/iadd (load i) 1))
                          0)
                      (meta-opt-flag? arg)
                        (do
                          (apply-meta-opt-flag! arg)
                          (set! i (primitive/iadd (load i) 1))
                          0)
                      (or (= arg "-g0") (= arg "--no-debug"))
                        (do
                          (set! nodebug true)
                          (set! i (primitive/iadd (load i) 1))
                          0)
                      (or (= arg "-g") (= arg "--debug"))
                        (do
                          (set-native-emit-dwarf! true)
                          (set-tpde-debug-frames! true)
                          ; the debug backend, unless one was named (in any order)
                          (unless (argv-has-flag? argc argv "--backend")
                            (set! backend (host-native-backend)))
                          (set! i (primitive/iadd (load i) 1))
                          0)
                      (sanitizer-flag? arg)
                        (do
                          (apply-sanitizer-flag! arg)
                          (set! i (primitive/iadd (load i) 1))
                          0)
                      (jit-flag? arg)
                        (do
                          (apply-jit-flag! arg)
                          (set! i (primitive/iadd (load i) 1))
                          0)
                      (opt-flag? arg)
                        (do
                          (apply-opt-flag! arg)
                          (set! i (primitive/iadd (load i) 1))
                          0)
                      (= arg "--target")
                        (do
                          (set! trip
                                (load (index argv
                                             (primitive/iadd (load i)
                                                             1))))
                          (set! i (primitive/iadd (load i) 2))
                          0)
                      (= arg "--backend")
                        (do
                          (set! backend
                                (backend-arg "emit-obj"
                                             (from-cstr (load (index argv
                                                                     (primitive/iadd (load i)
                                                                                     1))))
                                             false))
                          (set! i (primitive/iadd (load i) 2))
                          0)
                      :else (do (set! i (primitive/iadd (load i) 1)) 0)))))
    ; `emit-obj -o /dev/null`: no writable object destination — route to compile-check
    ; rather than abending in codegen. (diag-12)
    (when (and (!= (primitive/cast i64 (load outp)) 0)
               (= (from-cstr (load outp)) "/dev/null"))
      (ps (stderr)
          "note: -o /dev/null: compile-check only, no object written\n")
      (set-target-arch! (load trip))
      (exit (primitive/cast i32
                            (when (= (run-dump-on-big-stack a
                                                            (read-src a file)
                                                            (cwd-slice a)
                                                            (from-cstr file)
                                                            (fnptr-of check-src-program))
                                     0)
                              1)))
      0)
    (let [out-slice
            (if (= (primitive/cast i64 (load outp)) 0)
                (obj-path a (from-cstr file))
                (from-cstr (load outp)))
          ; beside the output, so publishing it is a rename on one filesystem
          temp-dir (temp-sibling-or-exit out-slice)
          _temp-check
            (when (!= (fs/make-dir (to-cstr a temp-dir) 448)
                      (: 0 i32))
              (ps (stderr) "error: could not write object file '")
              (ps (stderr) out-slice)
              (ps (stderr)
                  "': cannot create its temporary directory; check that the parent directory exists and is writable\n")
              (exit 1)
              0)
          obj-cstr (to-cstr a (sconcat a temp-dir "/program.o"))
          (mut ctx) (zeroed DumpCtx)]
      (set! (.a ctx)
            a)
      (set! (.src ctx)
            (read-src a file))
      (set! (.cwd ctx)
            (cwd-slice a))
      (set! (.path ctx)
            (from-cstr file))
      (set! (.mode ctx)
            (load backend))
      (set! (.obj ctx)
            obj-cstr)
      (set! (.triple ctx)
            (load trip))
      (set! (.self ctx)
            (from-cstr (load (index argv 0))))
      (set-native-emit-dwarf! (build-emits-dwarf? (load backend)
                                                  (native-emit-dwarf?)
                                                  (load nodebug)))
      (set-target-arch! (load trip))
      (set! (.ok ctx)
            0)
      (set! (.build-fn ctx)
            build-fn)
      (set! (.emitir-fn ctx)
            emitir-fn)
      (let [compiled (run-on-big-stack (mut ctx))
            n (len (load (.objects ctx)))
            final (sconcat a temp-dir "/combined.o")
            (mut ok) (!= compiled 0)]
        (when (and (load ok) (> n 1))
          (let [(mut args) (ArrayList::new [(slice u8)] a)]
            (push! (mut args) (native-link-driver a))
            (push! (mut args) "-r")
            (push! (mut args) "-nostdlib")
            (push! (mut args) "-o")
            (push! (mut args) final)
            (push-cross-link-target! a
                                     (mut args)
                                     (load trip)
                                     (ArrayList::new [(slice u8)] a))
            (for [i 0 n]
              (push! (mut args)
                     (get (load (.objects ctx))
                          i))
              0)
            (let [rc (spawn-wait a (load args))]
              (unless (= rc 0)
                (wait-report rc "relocatable object linker")
                (set! ok false)
                0)))
          0)
        (when (load ok)
          (let [source
                  (if (= n 1)
                      (get (load (.objects ctx))
                           0)
                      final)]
            (unless (= (rename (to-cstr a source) (to-cstr a out-slice)) 0)
              (ps (stderr) "error: cannot publish object output\n")
              (set! ok false)
              0))
          0)
        (cleanup-dump-objects! (mut ctx))
        (temp/remove! temp-dir)
        (if (load ok)
            (do
              (unless (quiet?)
                (ps (stdout) "wrote ")
                (ps (stdout) out-slice)
                (wb (stdout) 10)
                0)
              0)
            1)))))

; `cheader <file.coil> [-o out.h]` — generate the C header for export-c.
(defn cheader-cmd [(a (dyn Allocator)) (argc i32) (argv (ptr (ptr i8)))]
  (-> i64)
  (if (< (primitive/cast i64 argc) 3)
      (do (ps (stderr) "usage: coil cheader <file.coil> [-o out.h]\n") 1)
      (let [file (load (index argv 2))
            (mut outp) (None [(slice u8)])
            (mut i) 3]
        (loop (if (>= (load i) (primitive/cast i64 argc))
                  (break)
                  (do
                    (if (and (< (primitive/iadd (load i) 1)
                                (primitive/cast i64 argc))
                             (= (from-cstr (load (index argv (load i))))
                                "-o"))
                        (do
                          (set! outp
                                (Some (from-cstr (load (index argv
                                                              (primitive/iadd (load i)
                                                                              1))))))
                          (set! i (primitive/iadd (load i) 2))
                          0)
                        (do (set! i (primitive/iadd (load i) 1)) 0)))))
        (cheader-program a
                         (read-src a file)
                         (dirname (from-cstr file))
                         (from-cstr file)
                         (load outp)))))
