; src/compiler/interp.coil — a BYTECODE interpreter for the self-host Coil

; compiler. It consumes the SAME monomorphized Program the native backends
; consume (parse -> resolve -> check -> mono), compiles each mono'd function to a
; compact stack-bytecode ISA, and executes it on a small VM with a REAL memory
; model: pointers are genuine host addresses, `alloc-stack` bumps a malloc-backed
; per-frame buffer, heap allocations call real malloc, and loads/stores read and
; write actual process memory. FFI extern calls dispatch to real native libc
; functions through a builtin table, so a program that prints via `putchar` /
; `write` / `puts` actually prints.
;
; This module is strictly ADDITIVE: nothing here is wired into the compile
; pipeline. The driver's new `coil interp <file>` subcommand is the only entry
; point (driver.coil). The native backends are byte-unchanged.
;
; See docs/reference/BYTECODE_INTERP.md for the ISA, value/memory model, frame layout, and
; FFI dispatch.
;
; SCOPE: the slice implemented end-to-end is integer + float arithmetic,
; locals/let/mut, if/loop/while, direct calls + recursion, casts, pointer
; load/store + alloc, and libc FFI. Everything not yet implemented HARD-ERRORS
; with a clear message (idie) — never a silent no-op or sentinel.
(module coil.compiler.interp)
(import "coil.primitive" :as primitive)
(import "coil.alloc" :as alloc :use *)
(import "coil.result" :use *)
(import "coil.slice" :use *)
(import "coil.str" :use *)
(import "coil.mem" :use *)
(import "coil.arraylist" :use *)
(import "coil.io" :use *)
(import "coil.control" :use *)
(import "coil.try" :use *)
(import "coil.compiler.ast" :use *)
(import "coil.compiler.parser" :use *)
(import "coil.compiler.layoutdb" :use *)

; libc functions the interpreter itself uses + the FFI builtin table. Names are
; module-qualified so the C SYMBOL is the last dot component (g-last-component),
; matching the cga64.* pattern; this avoids Coil-scope collisions with the same
; extern declared elsewhere while still linking to the real libc symbol.
; Signatures MUST match any other declaration of the same C symbol elsewhere in
; the compiler (one C symbol, one signature): `exit`/`write`/`malloc` are already
; declared in ffi/io/alloc, so these mirror those exactly. `putchar`/`puts` are
; unique to the interpreter.
(extern interp.malloc [isize] (-> (ptr i8)))  ; size_t — mirror alloc.malloc (isize, not i64)

(extern interp.free [(ptr i8)] (-> i64))

(extern interp.exit [i32] (-> i64))

(extern interp.putchar [i64] (-> i64))

(extern interp.write [i32 (ptr i8) isize] (-> isize))

(extern interp.puts [(ptr i8)] (-> i64))

(extern interp.realloc [(ptr i8) isize] (-> (ptr i8)))

(extern interp.calloc [isize isize] (-> (ptr i8)))

(extern interp.memcpy [(ptr i8) (ptr i8) isize] (-> (ptr i8)))

(extern interp.memmove [(ptr i8) (ptr i8) isize] (-> (ptr i8)))

(extern interp.memset [(ptr i8) i32 isize] (-> (ptr i8)))

(extern interp.memcmp [(ptr i8) (ptr i8) isize] (-> i32))

(extern interp.strlen [(ptr i8)] (-> isize))

(extern interp.strcmp [(ptr i8) (ptr i8)] (-> i32))

(extern interp.read [i32 (ptr i8) isize] (-> isize))

(extern interp.abort [] (-> i64))

(extern interp.fmod [f64 f64] (-> f64))

(extern interp.fmodf [f32 f32] (-> f32))

(extern interp.sqrt [f64] (-> f64))

(extern interp.pow [f64 f64] (-> f64))

(extern interp.fabs [f64] (-> f64))

(extern interp.floor [f64] (-> f64))

(extern interp.ceil [f64] (-> f64))

(extern interp.strtol [(ptr i8) (ptr (ptr i8)) i32] (-> i64))

(extern interp.atoi [(ptr i8)] (-> i32))

; Variadic forwarding. We always pass a fixed tail of 6 word-sized varargs; a
; real printf/snprintf reads only as many as the format string names, so extra
; (unused) trailing words are harmless. This is correct for integer / string /
; char / pointer conversions (the corpus' usage); %f-family (v-register)
; variadics are NOT supported and are not exercised.
(extern interp.printf [(ptr i8) ...] (-> i32))

(extern interp.snprintf [(ptr i8) i64 (ptr i8) ...] (-> i32))

(extern interp.dprintf [i32 (ptr i8) ...] (-> i32))

; address of element i of an ArrayList given by pointer (local copy of the a64
; helper, renamed to avoid a duplicate generic instantiation clash).
(defn ial-at [T] [(p (ptr (ArrayList T))) (i i64)] (-> (ptr T))
  (primitive/index (load (field p data)) i))

; ============================ hard-error helpers =============================
(defn idie [(msg (slice u8))] (-> i64)
  (let [w (stderr)] (ps w "interp: ") (ps w msg) (wb w 10) (interp.exit (primitive/cast i32 1)) 0))

(defn idie2 [(msg (slice u8)) (x (slice u8))] (-> i64)
  (let [w (stderr)] (ps w "interp: ") (ps w msg) (ps w x) (wb w 10) (interp.exit (primitive/cast i32 1)) 0))

; ============================ bytecode data model ============================
; One instruction: op + three immediate operands. See docs/reference/BYTECODE_INTERP.md
; for the opcode legend (mirrored in the VM `case` below).
(defstruct Instr [(op i64) (a i64) (b i64) (c i64)])

(defstruct BFunc
  [(name (slice u8))
   (nparams i64)
   (nlocals i64)
   (code (ptr (ArrayList Instr)))
   (retty Type)
   (state i64)])  ; 0 = body not yet compiled, 1 = compiled (lazy: only funcs reachable from main are compiled)

; a compile-time scope entry: local slot index + static type.
(defstruct CScope [(name (slice u8)) (slot i64) (ty Type) (next (ptr CScope))])

; a lexically-open loop during compilation.
(defstruct CLoop
  [(contlabel i64)
   (breaklabel i64)
   (resultlocal i64)
   (label (Option (slice u8)))
   (has_res bool)
   (resty Type)])

; per-function bytecode builder.
(defstruct FB
  [(cx (ptr Interp))
   (code (ArrayList Instr))
   (loops (ArrayList CLoop))
   (labels (ArrayList i64))
   (nlocals i64)
   (env (ptr CScope))
   (term bool)])

; a parsed inline-LLVM-IR body (see ELlvmIr): the raw text + the arg types,
; interpreted at runtime against the VM's real memory. `result` is the IR's $ret.
(defstruct IIr [(body (slice u8)) (argtys (ArrayList Type)) (result Type)])

; the interpreter context: the mono'd program + compiled functions + layouts.
(defstruct Interp
  [(a (dyn Allocator))
   (mp (ptr Program))
   (externs (ptr (ArrayList Extern)))
   (bfuncs (ArrayList BFunc))
   (layouts LayoutDb)
   (irs (ArrayList IIr))])

; ============================ scope helpers ==================================
(defn cs-cons [(a (dyn Allocator)) (nm (slice u8)) (slot i64) (ty Type) (nx (ptr CScope))] (-> (ptr CScope))
  (let [p (box! a CScope (primitive/zeroed CScope))]
    (set! (.name p) nm)
    (set! (.slot p) slot)
    (set! (.ty p) ty)
    (set! (.next p) nx)
    p))

(defn cs-find [(s (ptr CScope)) (nm (slice u8))] (-> (ptr CScope))
  (if (= (primitive/cast i64 s) (primitive/cast i64 0))
      (primitive/cast (ptr CScope) 0)
      (if (= (.name s) nm) s (cs-find (load (field s next)) nm))))

; ============================ struct/sum layout ==============================
; The VM retains these names because they describe bytecode operations at call
; sites, but all layout facts come from the same database as every backend.
(defn istruct-idx [(cx (ptr Interp)) (nm (slice u8))] (-> i64)
  (struct-index (field cx layouts) nm))

(defn isum-idx [(cx (ptr Interp)) (nm (slice u8))] (-> i64)
  (sum-index (field cx layouts) nm))

(defn isize-of [(cx (ptr Interp)) (tp (ptr Type))] (-> i64)
  ; Bytecode compilation uses zero as the return size of a void function.
  (match (load tp) (TVoid [] 0) (_ (size (field cx layouts) tp))))

(defn ialign-of [(cx (ptr Interp)) (tp (ptr Type))] (-> i64)
  (align (field cx layouts) tp))

(defn ifield-off [(cx (ptr Interp)) (si i64) (fi i64)] (-> i64)
  (field-offset (field cx layouts) si fi))

(defn ifield-idx [(cx (ptr Interp)) (si i64) (fname (slice u8))] (-> i64)
  (field-number (field cx layouts) si fname))

(defn itype-bytes [(cx (ptr Interp)) (tp (ptr Type))] (-> i64)
  (type-bytes (field cx layouts) tp))

(defn isum-words-def [(cx (ptr Interp)) (variants (ptr (ArrayList Variant)))] (-> i64)
  (sum-words (field cx layouts) variants))

(defn inatural-off [(cx (ptr Interp)) (fs (ptr (ArrayList Field))) (fi i64)] (-> i64)
  (natural-offset (field cx layouts) fs fi))

(defn ivariant-idx [(cx (ptr Interp)) (su i64) (vname (slice u8))] (-> i64)
  (variant-number (field cx layouts) su vname))

(defn iregister-types! [(cx (ptr Interp)) (mp (ptr Program))] (-> i64)
  (set! (.layouts cx) (LayoutDb::new (.a cx) mp "interp" 8))
  0)

; Bit-struct access needs the declared bit offsets and field types in addition
; to ordinary byte layout, so it reads the shared entry directly.
(defn ibits-info [(cx (ptr Interp))
                  (nm (slice u8))
                  (fname (slice u8))
                  (lowp (ptr i64))
                  (widthp (ptr i64))
                  (signedp (ptr bool))
                  (backbytesp (ptr i64))] (-> i64)
  (let [si (istruct-idx cx nm)]
    (when (< si (primitive/cast i64 0)) (idie2 "bit access on unknown struct: " nm))
    (let [e (struct-at (field cx layouts) si)]
      (match (.layout e)
        (LBits [backing offs]
               (let [fi (ifield-idx cx si fname)]
                 (set! lowp (get (load offs) fi))
                 (set! backbytesp (primitive/idiv backing 8))
                 (match (.ty (ial-at [Field] (load (field e fields)) fi))
                   (TInt [bits sg] (do (set! widthp bits) (set! signedp sg) 0))
                   (TBool [] (do (set! widthp 1) (set! signedp false) 0))
                   (_ (do (idie "bit-struct field with non-int type") 0)))))
        (_ (do (idie2 "bit access on non-bits struct: " nm) 0))))))

; Bytecode type classification is interpreter policy, not physical layout.
(defn signed-of [(tp (ptr Type))] (-> bool)
  (match (load tp) (TInt [b sg] sg) (_ false)))

(defn ty-is-agg [(tp (ptr Type))] (-> bool)
  (match (load tp) (TStruct [nm] true) (TSlice [e0] true) (TArray [e1 n0] true) (TVec [e2 n1] true) (_ false)))

(defn ty-is-float2 [(tp (ptr Type))] (-> bool)
  (match (load tp) (TFloat [b] true) (_ false)))

(defn fbytes-of [(tp (ptr Type))] (-> i64)
  (match (load tp) (TFloat [b] (primitive/idiv b 8)) (_ 8)))

(defn isbool01 [(t Type)] (-> i64)
  (match t (TBool [] 1) (_ 0)))

(defn ty-pointee2 [(tp (ptr Type))] (-> Type)
  (match (load tp)
    (TPtr [inner] (load inner))
    (TRef [m2 inner] (load inner))
    (_ (do (idie "load/deref of a non-pointer value") (TInt 64 true)))))

(defn tmode [(tp (ptr Type))] (-> i64)
  (match (load tp) (TFloat [bits] (if (= bits (primitive/cast i64 32)) 1 2)) (_ 0)))

(defn tsignbits [(tp (ptr Type))] (-> i64)
  (match (load tp)
    (TInt [bits sg] (primitive/ior (when sg 1) (primitive/ishl bits 1)))
    (TBool [] (primitive/ishl 1 1))
    (_ (primitive/ishl 64 1))))

(defn tsigned [(tp (ptr Type))] (-> i64)
  (match (load tp) (TInt [bits sg] (when sg 1)) (TBool [] 0) (_ 1)))

(defn tsize [(cx (ptr Interp)) (t Type)] (-> i64)
  (let [tp (primitive/alloc-stack Type)] (set! tp t) (isize-of cx tp)))

; ============================ bytecode emit ==================================
(defn femit [(fb (ptr FB)) (op i64) (a i64) (b i64) (c i64)] (-> i64)
  (let [ins (primitive/alloc-stack Instr)]
    (set! (.op ins) op)
    (set! (.a ins) a)
    (set! (.b ins) b)
    (set! (.c ins) c)
    (push! (mut (.code fb)) (load ins))
    0))

(defn fnew-label [(fb (ptr FB))] (-> i64)
  (let [id (len (.labels fb))]
    (push! (mut (.labels fb)) -1)
    id))

(defn fbind-label [(fb (ptr FB)) (id i64)] (-> i64)
  (set! (mut (.labels fb)) id (len (.code fb)))
  0)

(defn fb-local! [(fb (ptr FB))] (-> i64)
  (let [n (.nlocals fb)] (set! (.nlocals fb) (primitive/iadd n 1)) n))

; rewrite every JMP(11)/JZ(12) target from label-id to instruction index.
(defn resolve-labels [(fb (ptr FB))] (-> i64)
  (let [n (len (.code fb))
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (let [ins (ial-at [Instr] (field fb code) (load i))
                      op (.op ins)]
                  (when (or (= op (primitive/cast i64 11)) (= op (primitive/cast i64 12)))
                    (store! (field ins a)
                            (get (load (field fb labels))
                                 (load (field ins
                                              a))))))
                (set! i (primitive/iadd (load i) 1))))))
  0)

; ============================ compile-time helpers ===========================
(defn find-func [(cx (ptr Interp)) (nm (slice u8))] (-> i64)
  (let [n (len (.bfuncs cx))
        (mut i) 0
        (mut r) -1]
    (loop (if (>= (load i) n)
              (break)
              (do
                (when (= (load (field (ial-at [BFunc] (field cx bfuncs) (load i)) name)) nm)
                  (store! r (load i))
                  (break))
                (set! i (primitive/iadd (load i) 1)))))
    (load r)))

(defn find-extern [(cx (ptr Interp)) (nm (slice u8))] (-> i64)
  (let [es (load (field cx externs))
        n (len (load es))
        (mut i) 0
        (mut r) -1]
    (loop (if (>= (load i) n)
              (break)
              (do
                (when (= (load (field (ial-at [Extern] es (load i)) name)) nm)
                  (store! r
                          (load i))
                  (break))
                (set! i (primitive/iadd (load i) 1)))))
    (load r)))

; loop index (labeled search from innermost, else innermost). Mirrors g-loop-index.
(defn cloop-index [(fb (ptr FB)) (label (Option (slice u8)))] (-> i64)
  (let [n (len (.loops fb))]
    (match label
      (None []
            (do
              (when (= n (primitive/cast i64 0)) (idie "break/continue outside a loop"))
              (primitive/isub n 1)))
      (Some [want]
            (let [(mut i) (primitive/isub n 1)
                  (mut r) -1]
              (loop (if (< (load i) (primitive/cast i64 0))
                        (break)
                        (do
                          (match (.label (ial-at [CLoop] (field fb loops) (load i)))
                            (None [] 0)
                            (Some [have]
                                  (when (and (< (load r) (primitive/cast i64 0)) (= have want)) (store! r (load i)) 0)))
                          (set! i (primitive/isub (load i) 1)))))
              (when (< (load r) (primitive/cast i64 0)) (idie2 "no such loop label: " want))
              (load r))))))

; A Coil function pointer is encoded as (fnptr-base + fidx): a large, nonzero,
; distinctive tag so a valid fnptr never collides with 0 (null) or small ints,
; and ECallPtr decodes the fidx back. (Real C function addresses are not
; supported as call targets — only Coil functions taken with fnptr-of.)
(defn fnptr-base [] (-> i64)
  2251799813685248)  ; 2^51

; the (TFn …) type of function fidx, built from its params + ret (for ECallPtr).
(defn func-fn-type [(cx (ptr Interp)) (fi i64)] (-> Type)
  (let [a (.a cx)
        fd (ial-at [Func] (load (field (load (field cx mp)) funcs)) fi)
        ps (load (field fd params))
        np (len (load ps))
        (mut ptys) (al-new [Type] a)
        (mut i) 0]
    (loop (if (>= (load i) np)
              (break)
              (do
                (push! (mut ptys) (.ty (ial-at [Param] ps (load i))))
                (set! i (primitive/iadd (load i) 1)))))
    (TFn
      :cc "c"
      :params (box-al [Type] a ptys)
      :ret (box-type a (.ret fd)))))

; the last dot component of a name (extern "io.write" -> C symbol "write").
(defn last-component2 [(nm (slice u8))] (-> (slice u8))
  (let [n (len nm)
        (mut dot) -1
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (when (= (primitive/cast i64 (get nm (load i))) (primitive/cast i64 46)) (store! dot (load i)))
                (set! i (primitive/iadd (load i) 1)))))
    (if (>= (load dot) (primitive/cast i64 0)) (subslice nm (primitive/iadd (load dot) 1) n) nm)))

; intern a string literal into a persistent, NUL-terminated malloc region and
; return its address. String literals are compile-time constants, so the pointer
; is baked into the bytecode as an immediate.
(defn intern-bytes [(sv (slice u8))] (-> i64)
  (let [n (len sv)
        addr (primitive/cast i64 (interp.malloc (primitive/cast isize (primitive/iadd n 1))))
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (set! (primitive/cast (ptr u8) (primitive/iadd addr (load i))) (get sv (load i)))
                (set! i (primitive/iadd (load i) 1)))))
    (set! (primitive/cast (ptr u8) (primitive/iadd addr n)) (primitive/cast u8 0))
    addr))

; ============================ compile ========================================
(defn compile-args [(fb (ptr FB)) (args (ptr (ArrayList Expr)))] (-> i64)
  (let [n (len (load args))
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (compile-expr fb (ial-at [Expr] args (load i)))
                (set! i (primitive/iadd (load i) 1))))))
  0)

(defn compile-call [(fb (ptr FB)) (func (slice u8)) (args (ptr (ArrayList Expr)))] (-> Type)
  (let [cx (load (field fb cx))
        fi (find-func cx func)]
    (if (>= fi (primitive/cast i64 0))
        (do
          (compile-args fb args)
          (femit fb 13 fi (len (load args)) 0)
          (ensure-compiled cx fi)
          (.retty (ial-at [BFunc] (field cx bfuncs) fi)))
        (let [ei (find-extern cx func)]
          (if (>= ei (primitive/cast i64 0))
              (do
                (compile-args fb args)
                (femit fb 14 ei (len (load args)) 0)
                (let [rt (.ret (ial-at [Extern] (load (field cx externs)) ei))
                      rtp (primitive/alloc-stack Type)]
                  (set! rtp rt)
                  ; a by-value aggregate C return (<=8 bytes, e.g. div's div_t in
                  ; x0) comes back as a packed word; box it into a frame slot so it
                  ; behaves as an aggregate value (an address) like any other.
                  (when (ty-is-agg rtp) (femit fb 43 (isize-of cx rtp) (ialign-of cx rtp) 0))
                  rt))
              (do (idie2 "call to unknown function: " func) (TInt 64 true)))))))

; compile a sequence, POPping all but the last; returns the last expr's type
; (the sequence's value). Used for do / let body / function body.
(defn compile-seq [(fb (ptr FB)) (body (ptr (ArrayList Expr)))] (-> Type)
  (let [n (len (load body))
        (mut i) 0
        ; An EMPTY sequence has type VOID (check.coil's synth-let-body agrees; the
        ; checker rejects an empty body against any non-void return type). This used
        ; to default to i64, the same wrong assumption the checker carried.
        (mut last) (TVoid)]
    ; The push STAYS: `RET` below always pops the body's value, so every body must
    ; leave exactly one stack slot. Only the TYPE was wrong, not the stack discipline.
    (when (= n (primitive/cast i64 0)) (femit fb 1 0 0 0) 0)  ; empty body -> push 0
    (loop (if (>= (load i) n)
              (break)
              (do
                (when (load (field fb term)) (break))
                (set! last (compile-expr fb (ial-at [Expr] body (load i))))
                (when (and (< (load i) (primitive/isub n 1))
                           (not (load (field fb
                                             term))))
                  (femit fb 4 0 0 0))  ; POP intermediate result
                (set! i (primitive/iadd (load i) 1)))))
    (load last)))

; compile a statement sequence, POPping EVERY produced value (used for loop bodies).
(defn compile-stmts [(fb (ptr FB)) (body (ptr (ArrayList Expr)))] (-> i64)
  (let [n (len (load body))
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (when (load (field fb term)) (break))
                (compile-expr fb (ial-at [Expr] body (load i)))
                (unless (load (field fb term)) (femit fb 4 0 0 0))  ; POP
                (set! i (primitive/iadd (load i) 1))))))
  0)

(defn compile-binds [(fb (ptr FB)) (binds (ptr (ArrayList Bind)))] (-> i64)
  (let [n (len (load binds))
        (mut i) 0
        cx (load (field fb cx))
        a (.a cx)]
    (loop (if (>= (load i) n)
              (break)
              (do
                (let [b (ial-at [Bind] binds (load i))
                      t (compile-expr fb (field b value))]
                  (if (.mutable b)
                      ; mutable: spill to a frame cell, bind name -> pointer to it
                      (let [tp (primitive/alloc-stack Type)
                            l (fb-local! fb)]
                        (set! tp t)
                        (femit fb 21 l (isize-of cx tp) (when (ty-is-agg tp) 1))  ; MUTCELL
                        (set! (.env fb)
                              (cs-cons a
                                       (.name b)
                                       l
                                       (TPtr (box-type a t))
                                       (load (field fb
                                                    env)))))
                      ; immutable: bind name -> a plain local holding the value
                      (let [l (fb-local! fb)]
                        (femit fb 3 l 0 0)  ; SETLOCAL
                        (set! (.env fb) (cs-cons a (.name b) l t (load (field fb env)))))))
                (set! i (primitive/iadd (load i) 1))))))
  0)

; compile ONE expression; emit its bytecode (leaving exactly one value on the
; operand stack unless the path terminated) and RETURN its static type. This is
; the interpreter analogue of codegen_a64's emit-expr returning an AVal.
(defn compile-expr [(fb (ptr FB)) (e (ptr Expr))] (-> Type)
  (let [cx (load (field fb cx))
        a (.a cx)]
    (match (.kind e)
      (EInt [v] (do (femit fb 1 v 0 0) (TInt 64 true)))
      (EFloat [bits] (do (femit fb 1 bits 0 0) (TFloat 64)))
      (EBool [b] (do (femit fb 1 (when b 1) 0 0) (TBool)))
      (EVar [name]
            (let [node (cs-find (load (field fb env)) name)]
              (if (= (primitive/cast i64 node) (primitive/cast i64 0))
                  (do (idie2 "unbound variable: " name) (TInt 64 true))
                  (do
                    (femit fb 2 (.slot node) 0 0)
                    (.ty node)))))
      (ELet [binds body]
            (let [sv (load (field fb env))]
              (compile-binds fb binds)
              (let [bt (compile-seq fb body)] (set! (.env fb) sv) bt)))
      (EDo [body] (compile-seq fb body))
      (ECleanup [body cleanups]
                ; Preserve the body's value while the cleanup calls consume their
                ; own operand-stack results. Aggregate interpreter values are
                ; addresses, so a plain local preserves the same representation.
                (let [bt (compile-expr fb body)]
                  (if (.term fb)
                      bt
                      (let [result (fb-local! fb)]
                        (femit fb 3 result 0 0)  ; SETLOCAL result
                        (compile-stmts fb cleanups)
                        (unless (load (field fb term)) (femit fb 2 result 0 0))  ; GETLOCAL result
                        bt))))
      (EBin [op lhs rhs]
            (let [tp (primitive/alloc-stack Type)]
              (set! tp (compile-expr fb lhs))
              (compile-expr fb rhs)
              (femit fb 8 op (tmode tp) (tsignbits tp))
              (load tp)))
      (ECmp [op lhs rhs]
            (let [tp (primitive/alloc-stack Type)]
              (set! tp (compile-expr fb lhs))
              (compile-expr fb rhs)
              (femit fb 9 op (tmode tp) (tsigned tp))
              (TBool)))
      (EIntUnary [op inner]
                 (let [t (compile-expr fb inner)]
                   (let [tp (primitive/alloc-stack Type)]
                     (set! tp t)
                     (femit fb
                            10
                            (if (= op (primitive/cast i64 0)) (isbool01 t) (primitive/iadd op 1))
                            (tsignbits tp)
                            0))
                   t))
      (EIf [cnd thn els]
           (do
             (compile-expr fb cnd)
             (let [lelse (fnew-label fb)
                   lend (fnew-label fb)]
               (femit fb 12 lelse 0 0)  ; JZ lelse
               (let [tt (compile-expr fb thn)
                     thnterm (.term fb)]
                 (unless thnterm (femit fb 11 lend 0 0))  ; JMP lend
                 (set! (.term fb) false)
                 (fbind-label fb lelse)
                 (let [et (compile-expr fb els)
                       elsterm (.term fb)]
                   (fbind-label fb lend)
                   (set! (.term fb) (and thnterm elsterm))
                   (if thnterm et tt))))))
      (ELoop [label body]
             (let [contlabel (fnew-label fb)
                   breaklabel (fnew-label fb)
                   resultl (fb-local! fb)
                   gl (primitive/alloc-stack CLoop)]
               (set! (.contlabel gl) contlabel)
               (set! (.breaklabel gl) breaklabel)
               (set! (.resultlocal gl) resultl)
               (set! (.label gl) label)
               (set! (.has_res gl) false)
               (set! (.resty gl) (TInt 64 true))
               (push! (mut (.loops fb)) (load gl))
               (fbind-label fb contlabel)
               (compile-stmts fb body)
               (unless (load (field fb term)) (femit fb 11 contlabel 0 0))  ; JMP contlabel (loop)
               (let [nn (len (.loops fb))
                     fin (ial-at [CLoop] (field fb loops) (primitive/isub nn 1))
                     had (.has_res fin)
                     rty (.resty fin)]
                 (set! (.len (.loops fb)) (primitive/isub nn 1))  ; pop loop frame
                 (fbind-label fb breaklabel)
                 (if had (femit fb 2 resultl 0 0) (femit fb 1 0 0 0))  ; push loop value (or dead 0)
                 (set! (.term fb) (not had))
                 rty)))
      (EBreak [label value]
              (let [li (cloop-index fb label)
                    lp (ial-at [CLoop] (field fb loops) li)]
                (match value
                  (Some [ve]
                        (let [vt (compile-expr fb ve)]
                          (femit fb 3 (.resultlocal lp) 0 0)  ; SETLOCAL resultlocal
                          (set! (.resty lp) vt)))
                  (None []
                        (do
                          (femit fb 1 0 0 0)  ; push 0
                          (femit fb 3 (.resultlocal lp) 0 0))))
                (set! (.has_res lp) true)
                (femit fb 11 (.breaklabel lp) 0 0)  ; JMP breaklabel
                (set! (.term fb) true)
                (TInt 64 true)))
      (EContinue [label]
                 (let [li (cloop-index fb label)
                       lp (ial-at [CLoop] (field fb loops) li)]
                   (femit fb 11 (.contlabel lp) 0 0)
                   (set! (.term fb) true)
                   (TInt 64 true)))
      (ECall [func targs args] (compile-call fb func args))
      (ELoad [inner]
             (let [tp (primitive/alloc-stack Type)]
               (set! tp (compile-expr fb inner))
               (let [pt (primitive/alloc-stack Type)]
                 (set! pt (ty-pointee2 tp))
                 (if (ty-is-agg pt)
                     (femit fb 32 (isize-of cx pt) (ialign-of cx pt) 0)  ; LOADAGG (fresh copy)
                     (femit fb 6 (isize-of cx pt) (when (signed-of pt) 1) 0))  ; LOAD scalar
                 (load pt))))
      (EStore [p val]
              (do
                (compile-expr fb p)
                (let [vt (primitive/alloc-stack Type)]
                  (set! vt (compile-expr fb val))
                  (if (ty-is-agg vt)
                      (femit fb 33 (isize-of cx vt) 0 0)  ; STOREAGG (memcpy)
                      (femit fb 7 (isize-of cx vt) 0 0))  ; STORE scalar
                  (TInt 64 true))))
      (EInitStore [p val]
                  (do
                    (compile-expr fb p)
                    (let [vt (primitive/alloc-stack Type)]
                      (set! vt (compile-expr fb val))
                      (if (ty-is-agg vt)
                          (femit fb 33 (isize-of cx vt) 0 0)
                          (femit fb 7 (isize-of cx vt) 0 0))
                      (TInt 64 true))))
      (ECast [t inner]
             (let [st (primitive/alloc-stack Type)]
               (set! st (compile-expr fb inner))
               (match t
                 (TInt [dbits dsigned]
                       (do
                         (if (ty-is-float2 st)
                             (femit fb 18 dbits (when dsigned 1) (fbytes-of st))  ; F2I
                             (femit fb 16 dbits (when dsigned 1) 0))  ; ICANON
                         t))
                 (TFloat [dbits]
                         (do
                           (if (ty-is-float2 st)
                               (femit fb 19 (primitive/idiv dbits 8) (fbytes-of st) 0)  ; F2F
                               (femit fb 17 (primitive/idiv dbits 8) (when (signed-of st) 1) 0))  ; I2F
                           t))
                 (_ t))))
      ; ptr / fnptr / bool targets: identity 8-byte value
      (EAlloc [storage t init]
              (let [tp (primitive/alloc-stack Type)]
                (set! tp t)
                (let [sz (isize-of cx tp)
                      al (ialign-of cx tp)]
                  (when (not (= (primitive/cast i64 init) 0))
                    (idie "initialized alloc-static is not supported by the bytecode interpreter yet")
                    0)
                  (cond (or (= storage (primitive/cast i64 0)) (= storage (primitive/cast i64 3)))
                          (femit fb 5 sz al 0)  ; stack/frame slot (uninit)
                        (= storage (primitive/cast i64 2)) (femit fb 23 sz 0 0)  ; heap malloc
                        ; static: allocate ONCE at compile time (one persistent, zeroed
                        ; region per alloc-static site, shared across all executions —
                        ; mirrors codegen's per-site zeroed global) and bake its address.
                        (let [addr (primitive/cast i64 (interp.malloc (primitive/cast isize sz)))]
                          (memzero addr sz)
                          (femit fb 1 addr 0 0)))
                  (TPtr (box-type a t)))))
      (EZeroed [t]
               (let [tp (primitive/alloc-stack Type)]
                 (set! tp t)
                 ; an aggregate zero is a zeroed slot (ADDRESS), regardless of size; a
                 ; scalar zero is the literal 0. (A small struct is still by-address, so
                 ; sizing alone must NOT decide — that pushed a bare 0 that a later
                 ; aggregate copy dereferenced as a null pointer.)
                 (if (ty-is-agg tp)
                     (femit fb 31 (isize-of cx tp) (ialign-of cx tp) 0)
                     (femit fb 1 0 0 0))
                 t))
      (EFree [inner] (do (compile-expr fb inner) (femit fb 22 0 0 0) (TInt 64 true)))
      (ESizeOf [t]
               (let [tp (primitive/alloc-stack Type)] (set! tp t) (femit fb 1 (isize-of cx tp) 0 0) (TInt 64 true)))
      (EAlignOf [t]
                (let [tp (primitive/alloc-stack Type)] (set! tp t) (femit fb 1 (ialign-of cx tp) 0 0) (TInt 64 true)))
      (EStr [sv] (do (femit fb 30 (intern-bytes sv) (len sv) 0) (TSlice (box-type a (TInt 8 false)))))
      (ECStr [sv] (do (femit fb 1 (intern-bytes sv) 0 0) (TPtr (box-type a (TInt 8 true)))))
      (EBorrow [m place] (compile-expr fb place))
      (ESpillRef [inner]
                 (let [tp (primitive/alloc-stack Type)]
                   (set! tp (compile-expr fb inner))
                   (let [l (fb-local! fb)]
                     (femit fb 21 l (isize-of cx tp) (when (ty-is-agg tp) 1))
                     (femit fb 2 l 0 0)
                     (TPtr (box-type a (load tp))))))
      (EField [p fname]
              (let [t (primitive/alloc-stack Type)]
                (set! t (compile-expr fb p))  ; pushes a pointer-to-struct
                (let [pt (primitive/alloc-stack Type)]
                  (set! pt (ty-pointee2 t))
                  (match (load pt)
                    (TStruct [nm]
                             (let [si (istruct-idx cx nm)]
                               (when (< si (primitive/cast i64 0)) (idie2 "field access on non-struct: " nm))
                               (let [fi (ifield-idx cx si fname)
                                     off (ifield-off cx si fi)
                                     fty
                                       (.ty (ial-at [Field]
                                                    (load (field (struct-at (field cx
                                                                                   layouts)
                                                                            si)
                                                                 fields))
                                                    fi))]
                                 (when (!= off (primitive/cast i64 0)) (femit fb 34 off 0 0))  ; FIELDPTR: addr += off
                                 (TPtr (box-type a fty)))))
                    (_ (do (idie "field access through non-struct pointer") (TInt 64 true)))))))
      (EIndex [p idx]
              (let [t (primitive/alloc-stack Type)]
                (set! t (compile-expr fb p))  ; base pointer
                (compile-expr fb idx)  ; index
                (let [pt (primitive/alloc-stack Type)
                      ep (primitive/alloc-stack Type)]
                  (set! pt (ty-pointee2 t))
                  (match (load pt) (TArray [elem n0] (set! ep (load elem))) (_ (set! ep (load pt))))
                  (femit fb 35 (isize-of cx ep) 0 0)  ; INDEX: base + idx*esz
                  (TPtr (box-type a (load ep))))))
      (EConstruct [sum variant args]
                  (let [su (isum-idx cx sum)]
                    (when (< su (primitive/cast i64 0)) (idie2 "construct of unknown sum: " sum))
                    (let [vidx (ivariant-idx cx su variant)
                          sumtp (primitive/alloc-stack Type)]
                      (set! sumtp (TStruct sum))
                      (let [sz (isize-of cx sumtp)
                            aln (ialign-of cx sumtp)
                            vs (load (field (sum-at (field cx layouts) su) variants))
                            vfields (load (field (ial-at [Variant] vs vidx) fields))
                            n (len (load args))
                            l (fb-local! fb)
                            (mut i) 0]
                        (femit fb 31 sz aln 0)  ; ALLOCZ zeroed slot
                        (femit fb 3 l 0 0)  ; SETLOCAL l = slot addr
                        ; tag (i32 at offset 0)
                        (femit fb 2 l 0 0)
                        (femit fb 1 vidx 0 0)
                        (femit fb 7 4 0 0)
                        (femit fb 4 0 0 0)
                        ; payload fields at natural offsets within the variant struct, from slot+8
                        (loop (if (>= (load i) n)
                                  (break)
                                  (do
                                    (let [foff (primitive/iadd 8 (inatural-off cx vfields (load i)))]
                                      (femit fb 2 l 0 0)  ; base = slot
                                      (when (!= foff (primitive/cast i64 0)) (femit fb 34 foff 0 0))  ; addr = slot+foff
                                      (let [ft (primitive/alloc-stack Type)]
                                        (set! ft (compile-expr fb (ial-at [Expr] args (load i))))
                                        (if (ty-is-agg ft)
                                            (femit fb 33 (isize-of cx ft) 0 0)
                                            (femit fb 7 (isize-of cx ft) 0 0)))
                                      (femit fb 4 0 0 0))  ; pop store's unit
                                    (set! i (primitive/iadd (load i) 1)))))
                        (femit fb 2 l 0 0)  ; push slot addr (the sum value)
                        (TStruct sum)))))
      (EMatch [scrut arms]
              (let [st (primitive/alloc-stack Type)]
                (set! st (compile-expr fb scrut))
                (let [sumname
                        (match (load st)
                          (TStruct [nm] nm)
                          (TPtr [inner]
                                (match (load inner) (TStruct [nm] nm) (_ "")))
                          (_ ""))
                      su (isum-idx cx sumname)]
                  (when (< su (primitive/cast i64 0)) (idie2 "match on non-sum: " sumname))
                  (let [vs (load (field (sum-at (field cx layouts) su) variants))
                        narms (len (load arms))
                        ; a trailing `(_ …)` arm tests nothing — control just
                        ; falls into it, ahead of the no-arm-matched trap.
                        ncases (if (arms-have-wildcard arms) (primitive/isub narms 1) narms)
                        sloc (fb-local! fb)
                        tagl (fb-local! fb)
                        resl (fb-local! fb)
                        lend (fnew-label fb)
                        (mut anylive) false
                        (mut allterm) true
                        (mut rty) (TInt 64 true)
                        (mut i) 0]
                    (femit fb 3 sloc 0 0)  ; SETLOCAL sloc = scrutinee addr
                    (femit fb 2 sloc 0 0)
                    (femit fb 6 4 0 0)
                    (femit fb 3 tagl 0 0)  ; tag = load i32 at sloc
                    (loop (if (>= (load i) narms)
                              (break)
                              (do
                                (let [arm (ial-at [Arm] arms (load i))
                                      wild (>= (load i) ncases)
                                      ; the catch-all binds nothing, so `vfields`
                                      ; is never read; variant 0 just keeps the
                                      ; lookup in range.
                                      vidx (if wild 0 (ivariant-idx cx su (.variant arm)))
                                      vfields (load (field (ial-at [Variant] vs vidx) fields))
                                      lnext (fnew-label fb)
                                      sv (load (field fb env))
                                      binds (load (field arm binds))
                                      nb (len (load binds))
                                      (mut j) 0]
                                  (unless wild
                                    (femit fb 2 tagl 0 0)
                                    (femit fb 1 vidx 0 0)
                                    (femit fb 9 4 0 0)  ; CMP eq -> bool
                                    (femit fb 12 lnext 0 0))  ; JZ lnext (not this variant)
                                  (set! (.term fb) false)
                                  ; bind payload fields
                                  (loop (if (>= (load j) nb)
                                            (break)
                                            (do
                                              (let [fty (.ty (ial-at [Field] vfields (load j)))
                                                    foff (primitive/iadd 8 (inatural-off cx vfields (load j)))
                                                    bname (get (load binds) (load j))
                                                    borrowed-binding (starts-with bname "$match.ref.")
                                                    bl (fb-local! fb)
                                                    ftp (primitive/alloc-stack Type)]
                                                (set! ftp fty)
                                                (femit fb 2 sloc 0 0)
                                                (when (!= foff (primitive/cast i64 0)) (femit fb 34 foff 0 0))  ; addr = sloc+foff
                                                (unless (ty-is-agg ftp)
                                                  ; aggregate: keep the address
                                                  (femit fb 6 (isize-of cx ftp) (when (signed-of ftp) 1) 0))  ; scalar: load
                                                (femit fb 3 bl 0 0)
                                                (set! (.env fb)
                                                      (cs-cons a
                                                               bname
                                                               bl
                                                               (if borrowed-binding
                                                                   (TPtr (box-type a fty))
                                                                   fty)
                                                               (load (field fb env)))))
                                              (set! j (primitive/iadd (load j) 1)))))
                                  (let [bt (compile-expr fb (field arm body))]
                                    (set! (.env fb) sv)
                                    (unless (load (field fb term))
                                      (femit fb 3 resl 0 0)
                                      ; SETLOCAL resl = body value
                                      (store! anylive true)
                                      (store! allterm false)
                                      (store! rty bt)
                                      (femit fb 11 lend 0 0))  ; JMP lend
                                    (fbind-label fb lnext)))
                                (set! i (primitive/iadd (load i) 1)))))
                    (femit fb 36 0 0 0)  ; no arm matched -> trap
                    (fbind-label fb lend)
                    (femit fb 2 resl 0 0)  ; push result (dead if allterm)
                    (set! (.term fb) (load allterm))
                    (load rty)))))
      (ELlvmIr [result args body]
               (let [n (len (load args))
                     (mut i) 0
                     ir0 (primitive/alloc-stack IIr)]
                 (set! (.body ir0) body)
                 (set! (.argtys ir0) (al-new [Type] a))
                 (set! (.result ir0) result)
                 ; compile args FIRST (nested llvm-ir may register its own IIrs), then
                 ; register this body and read the index back — capturing it before the
                 ; args would use the nested body's slot instead.
                 (loop (if (>= (load i) n)
                           (break)
                           (do
                             (let [t (compile-expr fb (ial-at [Expr] args (load i)))]
                               (push! (mut (.argtys ir0)) t))
                             (set! i (primitive/iadd (load i) 1)))))
                 (let [iri (len (.irs cx))]
                   (push! (mut (.irs cx)) (load ir0))
                   (femit fb 40 iri n 0))
                 result))
      (EOffsetOf [t fname]
                 (match t
                   (TStruct [nm]
                            (let [si (istruct-idx cx nm)]
                              (when (< si (primitive/cast i64 0)) (idie2 "offset-of on non-struct: " nm))
                              (femit fb 1 (ifield-off cx si (ifield-idx cx si fname)) 0 0)
                              (TInt 64 true)))
                   (_ (do (idie "offset-of on non-struct type") (TInt 64 true)))))
      (EFnPtrOf [name]
                (let [fi (find-func cx name)]
                  (if (< fi (primitive/cast i64 0))
                      (do (idie2 "fnptr-of unknown function: " name) (TInt 64 true))
                      (do
                        (ensure-compiled cx fi)
                        (femit fb 1 (primitive/iadd (fnptr-base) fi) 0 0)
                        (func-fn-type cx fi)))))
      (ECallPtr [fp args]
                (let [ft (primitive/alloc-stack Type)]
                  (set! ft (compile-expr fb fp))  ; push the fnptr value
                  (compile-args fb args)  ; push args
                  (femit fb 42 (len (load args)) 0 0)  ; CALLPTR
                  (match (load ft)
                    (TFn [cc ps r] (load r))
                    (_ (do (idie "call-ptr on a non-fnptr value") (TInt 64 true))))))
      (EBitGet [p fname]
               (let [t (primitive/alloc-stack Type)]
                 (set! t (compile-expr fb p))
                 (let [pt (primitive/alloc-stack Type)]
                   (set! pt (ty-pointee2 t))
                   (match (load pt)
                     (TStruct [nm]
                              (let [low (primitive/alloc-stack i64)
                                    width (primitive/alloc-stack i64)
                                    sg (primitive/alloc-stack bool)
                                    bb (primitive/alloc-stack i64)]
                                (ibits-info cx nm fname low width sg bb)
                                (femit fb
                                       37
                                       (load low)
                                       (load width)
                                       (primitive/ior (when (load sg) 1) (primitive/ishl (load bb) 1)))
                                (if (= (load width) (primitive/cast i64 1)) (TBool) (TInt (load width) (load sg)))))
                     (_ (do (idie "bit-get through non-struct pointer") (TInt 64 true)))))))
      (EBitSet [p fname val]
               (let [t (primitive/alloc-stack Type)]
                 (set! t (compile-expr fb p))
                 (let [pt (primitive/alloc-stack Type)
                       vt (primitive/alloc-stack Type)]
                   (set! pt (ty-pointee2 t))
                   (set! vt (compile-expr fb val))
                   (match (load pt)
                     (TStruct [nm]
                              (let [low (primitive/alloc-stack i64)
                                    width (primitive/alloc-stack i64)
                                    sg (primitive/alloc-stack bool)
                                    bb (primitive/alloc-stack i64)]
                                (ibits-info cx nm fname low width sg bb)
                                (femit fb 38 (load low) (load width) (load bb))
                                (load vt)))
                     (_ (do (idie "bit-set through non-struct pointer") (TInt 64 true)))))))
      (EMakeDyn [ds vtn methods inner]
                ; a dyn object { data, vtable } (16 bytes). The vtable is a persistent
                ; malloc'd array of encoded Coil fnptrs, one per method (built once at
                ; compile time and baked as an immediate — mirrors codegen's data global).
                (let [nmeth (len (load methods))
                      vt
                        (primitive/cast i64
                                        (interp.malloc (primitive/cast isize
                                                                       (primitive/imul (if (<= nmeth
                                                                                               (primitive/cast i64
                                                                                                               1))
                                                                                           1
                                                                                           nmeth)
                                                                                       8))))
                      (mut i) 0
                      l (fb-local! fb)]
                  (loop (if (>= (load i) nmeth)
                            (break)
                            (do
                              (let [mnm (get (load methods) (load i))
                                    mfi (find-func cx mnm)]
                                (when (< mfi (primitive/cast i64 0)) (idie2 "make-dyn: unknown method " mnm))
                                (ensure-compiled cx mfi)
                                (set! (primitive/cast (ptr i64) (primitive/iadd vt (primitive/imul (load i) 8)))
                                      (primitive/iadd (fnptr-base) mfi)))
                              (set! i (primitive/iadd (load i) 1)))))
                  (femit fb 31 16 8 0)
                  (femit fb 3 l 0 0)  ; ALLOCZ 16 -> local l
                  (femit fb 2 l 0 0)
                  (compile-expr fb inner)
                  (femit fb 7 8 0 0)
                  (femit fb 4 0 0 0)  ; l[0] = data
                  (femit fb 2 l 0 0)
                  (femit fb 34 8 0 0)
                  (femit fb 1 vt 0 0)
                  (femit fb 7 8 0 0)
                  (femit fb 4 0 0 0)  ; l[8] = vtable
                  (femit fb 2 l 0 0)  ; push the dyn object
                  (TStruct ds)))
      (EDynDispatch [ds vtn mi cc params ret recv args]
                    (let [r (fb-local! fb)]
                      (compile-expr fb recv)
                      (femit fb 3 r 0 0)  ; r = receiver dyn object addr
                      ; fnptr = *( *(r+8) + mi*8 )
                      (femit fb 2 r 0 0)
                      (femit fb 34 8 0 0)
                      (femit fb 6 8 0 0)  ; vtable addr
                      (when (!= (primitive/imul mi 8) (primitive/cast i64 0)) (femit fb 34 (primitive/imul mi 8) 0 0))
                      (femit fb 6 8 0 0)  ; fnptr (encoded)
                      (femit fb 2 r 0 0)
                      (femit fb 6 8 0 0)  ; data ptr (first arg)
                      (compile-args fb args)
                      (femit fb 42 (primitive/iadd 1 (len (load args))) 0 0)  ; CALLPTR
                      ret))
      (EErase [tn inner] (do (idie2 "TODO EErase: " tn) (TInt 64 true)))
      (ETypeQuery [q t] (do (idie "TODO ETypeQuery") (TInt 64 true)))
      (_ (do (idie "unimplemented expression kind reached the interpreter compiler") (TInt 64 true))))))

; compile function `fi` on first reference (self-recursion is guarded by marking
; state=1 BEFORE compiling the body). Only functions reachable from main are ever
; compiled, so unused stdlib functions using not-yet-implemented features never
; force a hard error.
(defn ensure-compiled [(cx (ptr Interp)) (fi i64)] (-> i64)
  (let [bf (ial-at [BFunc] (field cx bfuncs) fi)]
    (when (= (load (field bf state)) (primitive/cast i64 0))
      (store! (field bf state) 1)
      (compile-func cx (ial-at [Func] (load (field (load (field cx mp)) funcs)) fi) fi))))

; compile one mono'd function into cx.bfuncs[fidx] (name/nparams/retty were set
; by pre-registration so calls resolve regardless of compile order).
(defn compile-func [(cx (ptr Interp)) (fd (ptr Func)) (fidx i64)] (-> i64)
  (let [a (.a cx)
        fb (primitive/alloc-stack FB)]
    (set! (.cx fb) cx)
    (set! (.code fb) (al-new [Instr] a))
    (set! (.loops fb) (al-new [CLoop] a))
    (set! (.labels fb) (al-new [i64] a))
    (set! (.nlocals fb) 0)
    (set! (.env fb) (primitive/cast (ptr CScope) 0))
    (set! (.term fb) false)
    (let [ps (load (field fd params))
          np (len (load ps))
          (mut i) 0]
      (loop (if (>= (load i) np)
                (break)
                (do
                  (let [p (ial-at [Param] ps (load i))
                        slot (fb-local! fb)]
                    (set! (.env fb)
                          (cs-cons a
                                   (.name p)
                                   slot
                                   (.ty p)
                                   (load (field fb
                                                env)))))
                  (set! i (primitive/iadd (load i) 1))))))
    (compile-seq fb (load (field fd body)))
    (femit fb 15 0 0 0)  ; RET (pops the body's value)
    (resolve-labels fb)
    (let [bf (ial-at [BFunc] (field cx bfuncs) fidx)]
      (set! (.nlocals bf) (.nlocals fb))
      (set! (.code bf) (box-al [Instr] a (.code fb))))
    0))

; ============================ real memory model ==============================
(defn mem-load [(addr i64) (sz i64) (signed bool)] (-> i64)
  (if (not (or (= sz (primitive/cast i64 1))
               (or (= sz (primitive/cast i64 2))
                   (or (= sz (primitive/cast i64 4)) (= sz (primitive/cast i64 8))))))
      (do (idie "mem-load: bad size") 0)
      ; Interpreter addresses may point into packed structs.  Typed multi-byte
      ; loads would assert alignment that those fields deliberately do not have.
      (let [(mut i) 0
            (mut v) 0]
        (loop (if (>= (load i) sz)
                  (break)
                  (do
                    (let [b
                            (primitive/cast i64
                                            (load (primitive/cast (ptr u8)
                                                                  (primitive/iadd addr (load i)))))]
                      (set! v
                            (primitive/ior (load v)
                                           (primitive/ishl b (primitive/imul (load i) 8)))))
                    (set! i (primitive/iadd (load i) 1)))))
        (if (and signed (< sz (primitive/cast i64 8)))
            (let [shift (primitive/isub 64 (primitive/imul sz 8))]
              (primitive/ishr (primitive/ishl (load v) shift) shift))
            (load v)))))

(defn mem-store [(addr i64) (v i64) (sz i64)] (-> i64)
  (if (not (or (= sz (primitive/cast i64 1))
               (or (= sz (primitive/cast i64 2))
                   (or (= sz (primitive/cast i64 4)) (= sz (primitive/cast i64 8))))))
      (do (idie "mem-store: bad size") 0)
      (let [(mut i) 0]
        (loop (if (>= (load i) sz)
                  (break)
                  (do
                    (set! (primitive/cast (ptr u8) (primitive/iadd addr (load i)))
                          (primitive/cast u8
                                          (primitive/iand (primitive/ishr v (primitive/imul (load i) 8))
                                                          255)))
                    (set! i (primitive/iadd (load i) 1)))))
        0)))

(defn memzero [(addr i64) (n i64)] (-> i64)
  (let [(mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (set! (primitive/cast (ptr u8) (primitive/iadd addr (load i))) (primitive/cast u8 0))
                (set! i (primitive/iadd (load i) 1))))))
  0)

; copy n bytes dst<-src (word-at-a-time then byte tail). src/dst are real addrs.
(defn memcopy [(dst i64) (src i64) (n i64)] (-> i64)
  (let [(mut i) 0]
    (loop (if (> (primitive/iadd (load i) 8) n)
              (break)
              (do
                (set! (primitive/cast (ptr i64) (primitive/iadd dst (load i)))
                      (load (primitive/cast (ptr i64) (primitive/iadd src (load i)))))
                (set! i (primitive/iadd (load i) 8)))))
    (loop (if (>= (load i) n)
              (break)
              (do
                (set! (primitive/cast (ptr u8) (primitive/iadd dst (load i)))
                      (load (primitive/cast (ptr u8) (primitive/iadd src (load i)))))
                (set! i (primitive/iadd (load i) 1))))))
  0)

; bump-allocate `size` bytes (aligned) from the frame buffer; returns a real host
; address. Overflow of the fixed frame buffer is a hard error, never silent.
(defn frame-alloc [(base i64) (offc (ptr i64)) (size i64) (align i64)] (-> i64)
  (let [al (if (<= align (primitive/cast i64 1)) 1 align)
        off (primitive/imul (primitive/idiv (primitive/iadd (load offc) (primitive/isub al 1)) al) al)
        addr (primitive/iadd base off)]
    (set! offc (primitive/iadd off size))
    (when (> (load offc) (primitive/cast i64 1048576))
      (idie "frame overflow: stack allocation exceeded 1 MiB frame buffer"))
    addr))

; ============================ float bit-casts ================================
; The f64 pair (`bits->f64` / `f64->bits`) moved to coil.mem as `bits->f64` /
; `f64-bits`; this file had a third spelling of the same three lines. The f32
; pair stays: it is a NARROWING round-trip (i32 slot, u32-widened result), not
; the same operation.
(defn bits->f32 [(b i64)] (-> f32)
  (let [p (primitive/alloc-stack i32)] (set! p (primitive/cast i32 b)) (load (primitive/cast (ptr f32) p))))

(defn f32->bits [(x f32)] (-> i64)
  (let [p (primitive/alloc-stack f32)]
    (set! p x)
    (primitive/cast i64 (primitive/cast u32 (load (primitive/cast (ptr i32) p))))))

(defn f64-frem-unsupported [] (-> f64)
  (do (idie "float remainder (frem) not implemented in interp yet") (bits->f64 0)))

(defn f32-frem-unsupported [] (-> f32)
  (do (idie "float remainder (frem) not implemented in interp yet") (bits->f32 0)))

; ============================ VM arithmetic =================================
; canonicalize `v` to exact iN width (container invariant: values are sign/zero
; extended from bit N-1). No-op for 64-bit — the common case.
(defn canon-int [(v i64) (bits i64) (signed bool)] (-> i64)
  (if (>= bits (primitive/cast i64 64))
      v
      (if signed
          (let [sh (primitive/isub 64 bits)] (primitive/ishr (primitive/ishl v sh) sh))
          (primitive/iand v (primitive/isub (primitive/ishl 1 bits) 1)))))

(defn ult [(a i64) (b i64)] (-> bool)
  (< (primitive/ixor a (primitive/ishl 1 63)) (primitive/ixor b (primitive/ishl 1 63))))

(defn ule [(a i64) (b i64)] (-> bool)
  (<= (primitive/ixor a (primitive/ishl 1 63)) (primitive/ixor b (primitive/ishl 1 63))))

(defn ugt [(a i64) (b i64)] (-> bool)
  (> (primitive/ixor a (primitive/ishl 1 63)) (primitive/ixor b (primitive/ishl 1 63))))

(defn uge [(a i64) (b i64)] (-> bool)
  (>= (primitive/ixor a (primitive/ishl 1 63)) (primitive/ixor b (primitive/ishl 1 63))))

(defn b01 [(x bool)] (-> i64)
  (when x 1))

(defn do-int-unary [(op i64) (signbits i64) (v i64)] (-> i64)
  (let [bits (primitive/ishr signbits 1)
        (mut n) 0
        (mut x) (canon-int v (primitive/ishr signbits 1) false)]
    (cond (= op (primitive/cast i64 2))
            (do
              (loop (if (or (>= (load n) bits)
                            (!= (primitive/iand (load x) (primitive/ishl 1 (primitive/isub bits 1))) 0))
                        (break)
                        (do
                          (set! n (primitive/iadd (load n) 1))
                          (set! x (primitive/ishl (load x) 1)))))
              (load n))
          (= op (primitive/cast i64 3))
            (do
              (loop (if (or (>= (load n) bits) (!= (primitive/iand (load x) 1) 0))
                        (break)
                        (do
                          (set! n (primitive/iadd (load n) 1))
                          (set! x (primitive/cast i64 (primitive/ishr (primitive/cast u64 (load x)) 1))))))
              (load n))
          (= op (primitive/cast i64 4))
            (do
              (store! n 0)
              (loop (if (= (load x) 0)
                        (break)
                        (do
                          (set! x (primitive/iand (load x) (primitive/isub (load x) 1)))
                          (set! n (primitive/iadd (load n) 1)))))
              (load n))
          :else
            (let [(mut out) 0
                  (mut i) 0]
              (loop (if (>= (primitive/imul (load i) 8) bits)
                        (break)
                        (do
                          (set! out
                                (primitive/ior (primitive/ishl (load out) 8)
                                               (primitive/iand (primitive/ishr (load x) (primitive/imul (load i) 8))
                                                               255)))
                          (set! i (primitive/iadd (load i) 1)))))
              (canon-int (load out) bits (!= (primitive/iand signbits 1) 0))))))

(defn interp-umulhi [(l i64) (r i64) (bits i64)] (-> i64)
  (let [(mut lo) 0
        (mut hi) 0
        (mut xlo) (canon-int l bits false)
        (mut xhi) 0
        (mut y) (canon-int r bits false)
        (mut i) 0]
    (loop (if (>= (load i) bits)
              (break)
              (do
                (when (!= (primitive/iand (load y) 1) 0)
                  (let [old (load lo)]
                    (set! lo (canon-int (primitive/iadd (load lo) (load xlo)) bits false))
                    (set! hi
                          (canon-int (primitive/iadd (primitive/iadd (load hi) (load xhi))
                                                     (when (ult (load lo) old) 1))
                                     bits
                                     false))))
                (set! xhi
                      (canon-int (primitive/ior (primitive/ishl (load xhi) 1)
                                                (primitive/cast i64
                                                                (primitive/ishr (primitive/cast u64 (load xlo))
                                                                                (primitive/cast u64
                                                                                                (primitive/isub bits 1)))))
                                 bits
                                 false))
                (set! xlo (canon-int (primitive/ishl (load xlo) 1) bits false))
                (set! y (primitive/cast i64 (primitive/ishr (primitive/cast u64 (load y)) (primitive/cast u64 1))))
                (set! i (primitive/iadd (load i) 1)))))
    (load hi)))

(defn interp-mulhi [(l i64) (r i64) (bits i64) (signed bool)] (-> i64)
  (let [(mut h) (interp-umulhi l r bits)]
    (when signed
      (let [sign (primitive/ishl 1 (primitive/isub bits 1))
            ul (canon-int l bits false)
            ur (canon-int r bits false)]
        (when (!= (primitive/iand ul sign) 0) (set! h (canon-int (primitive/isub (load h) ur) bits false)))
        (when (!= (primitive/iand ur sign) 0) (set! h (canon-int (primitive/isub (load h) ul) bits false)))))
    (canon-int (load h) bits signed)))

(defn interp-overflow? [(op i64) (l i64) (r i64) (bits i64) (signed bool)] (-> i64)
  (let [ul (canon-int l bits false)
        ur (canon-int r bits false)
        result
          (canon-int (cond (= op (primitive/cast i64 15)) (primitive/iadd ul ur)
                           (= op (primitive/cast i64 16)) (primitive/isub ul ur)
                           :else (primitive/imul ul ur))
                     bits
                     false)]
    (if signed
        (let [sign (primitive/ishl 1 (primitive/isub bits 1))
              ls (!= (primitive/iand ul sign) 0)
              rs (!= (primitive/iand ur sign) 0)
              os (!= (primitive/iand result sign) 0)]
          (if (= op (primitive/cast i64 15))
              (b01 (and (= ls rs) (!= os ls)))
              (if (= op (primitive/cast i64 16))
                  (b01 (and (!= ls rs) (!= os ls)))
                  (let [high (interp-mulhi l r bits true)
                        expected (if os -1 0)]
                    (b01 (!= (canon-int high bits true) (canon-int expected bits true)))))))
        (if (= op (primitive/cast i64 15))
            (b01 (ult result ul))
            (if (= op (primitive/cast i64 16))
                (b01 (ult ul ur))
                (b01 (!= (interp-umulhi ul ur bits) 0)))))))

(defn do-bin [(op i64) (mode i64) (c i64) (l i64) (r i64)] (-> i64)
  (if (= mode (primitive/cast i64 0))
      (let [signed (!= (primitive/iand c 1) (primitive/cast i64 0))
            bits (primitive/ishr c 1)
            v
              (cond (= op (primitive/cast i64 0)) (primitive/iadd l r)
                    (= op (primitive/cast i64 1)) (primitive/isub l r)
                    (= op (primitive/cast i64 2)) (primitive/imul l r)
                    (= op (primitive/cast i64 3)) (if signed (primitive/idiv l r) (primitive/udiv l r))
                    (= op (primitive/cast i64 4)) (if signed (primitive/irem l r) (primitive/urem l r))
                    (= op (primitive/cast i64 5)) (primitive/udiv l r)
                    (= op (primitive/cast i64 6)) (primitive/urem l r)
                    (= op (primitive/cast i64 7)) (primitive/iand l r)
                    (= op (primitive/cast i64 8)) (primitive/ior l r)
                    (= op (primitive/cast i64 9)) (primitive/ixor l r)
                    (= op (primitive/cast i64 10)) (primitive/ishl l r)
                    (= op (primitive/cast i64 11))
                      (if signed
                          (primitive/ishr l r)
                          (primitive/cast i64 (primitive/ishr (primitive/cast u64 l) (primitive/cast u64 r))))
                    (or (= op (primitive/cast i64 12)) (= op (primitive/cast i64 13)))
                      (let [n (primitive/urem r bits)]
                        (if (= n 0)
                            (canon-int l bits signed)
                            (if (= op (primitive/cast i64 12))
                                (primitive/ior (primitive/ishl l n)
                                               (primitive/ishr (canon-int l bits false) (primitive/isub bits n)))
                                (primitive/ior (primitive/ishr (canon-int l bits false) n)
                                               (primitive/ishl l (primitive/isub bits n))))))
                    (= op (primitive/cast i64 14)) (interp-mulhi l r bits signed)
                    (>= op (primitive/cast i64 15)) (interp-overflow? op l r bits signed)
                    :else (idie "do-bin: bad integer op"))]
        (if (>= op (primitive/cast i64 15)) v (canon-int v bits signed)))
      (if (= mode (primitive/cast i64 2))
          (let [lf (bits->f64 l)
                rf (bits->f64 r)]
            (f64-bits (cond (= op (primitive/cast i64 0)) (primitive/fadd lf rf)
                            (= op (primitive/cast i64 1)) (primitive/fsub lf rf)
                            (= op (primitive/cast i64 2)) (primitive/fmul lf rf)
                            (= op (primitive/cast i64 3)) (primitive/fdiv lf rf)
                            (interp.fmod lf rf))))
          (let [lf (bits->f32 l)
                rf (bits->f32 r)]
            (f32->bits (cond (= op (primitive/cast i64 0)) (primitive/fadd lf rf)
                             (= op (primitive/cast i64 1)) (primitive/fsub lf rf)
                             (= op (primitive/cast i64 2)) (primitive/fmul lf rf)
                             (= op (primitive/cast i64 3)) (primitive/fdiv lf rf)
                             (interp.fmodf lf rf)))))))

(defn do-cmp [(op i64) (mode i64) (signed i64) (l i64) (r i64)] (-> i64)
  (if (= mode (primitive/cast i64 0))
      (if (!= signed (primitive/cast i64 0))
          (cond (= op (primitive/cast i64 0)) (b01 (< l r))
                (= op (primitive/cast i64 1)) (b01 (<= l r))
                (= op (primitive/cast i64 2)) (b01 (> l r))
                (= op (primitive/cast i64 3)) (b01 (>= l r))
                (= op (primitive/cast i64 4)) (b01 (= l r))
                (b01 (!= l r)))
          (cond (= op (primitive/cast i64 0)) (b01 (ult l r))
                (= op (primitive/cast i64 1)) (b01 (ule l r))
                (= op (primitive/cast i64 2)) (b01 (ugt l r))
                (= op (primitive/cast i64 3)) (b01 (uge l r))
                (= op (primitive/cast i64 4)) (b01 (= l r))
                (b01 (!= l r))))
      (if (= mode (primitive/cast i64 2))
          (let [lf (bits->f64 l)
                rf (bits->f64 r)]
            (cond (= op (primitive/cast i64 0)) (b01 (primitive/fcmp-lt lf rf))
                  (= op (primitive/cast i64 1)) (b01 (primitive/fcmp-le lf rf))
                  (= op (primitive/cast i64 2)) (b01 (primitive/fcmp-gt lf rf))
                  (= op (primitive/cast i64 3)) (b01 (primitive/fcmp-ge lf rf))
                  (= op (primitive/cast i64 4)) (b01 (primitive/fcmp-eq lf rf))
                  (b01 (primitive/fcmp-ne lf rf))))
          (let [lf (bits->f32 l)
                rf (bits->f32 r)]
            (cond (= op (primitive/cast i64 0)) (b01 (primitive/fcmp-lt lf rf))
                  (= op (primitive/cast i64 1)) (b01 (primitive/fcmp-le lf rf))
                  (= op (primitive/cast i64 2)) (b01 (primitive/fcmp-gt lf rf))
                  (= op (primitive/cast i64 3)) (b01 (primitive/fcmp-ge lf rf))
                  (= op (primitive/cast i64 4)) (b01 (primitive/fcmp-eq lf rf))
                  (b01 (primitive/fcmp-ne lf rf)))))))

(defn i2f [(v i64) (fbytes i64) (srcsigned i64)] (-> i64)
  (if (!= srcsigned (primitive/cast i64 0))
      (if (= fbytes (primitive/cast i64 4)) (f32->bits (primitive/cast f32 v)) (f64-bits (primitive/cast f64 v)))
      (if (= fbytes (primitive/cast i64 4))
          (f32->bits (primitive/cast f32 (primitive/cast u64 v)))
          (f64-bits (primitive/cast f64 (primitive/cast u64 v))))))

(defn f2i [(v i64) (destbits i64) (destsigned i64) (srcfbytes i64)] (-> i64)
  (let [x (if (= srcfbytes (primitive/cast i64 4)) (primitive/cast f64 (bits->f32 v)) (bits->f64 v))]
    (canon-int (primitive/cast i64 x) destbits (!= destsigned (primitive/cast i64 0)))))

(defn f2f [(v i64) (destbytes i64) (srcbytes i64)] (-> i64)
  (if (= destbytes srcbytes)
      v
      (if (= destbytes (primitive/cast i64 8))
          (f64-bits (primitive/cast f64 (bits->f32 v)))
          (f32->bits (primitive/cast f32 (bits->f64 v))))))

; qsort(base, n, size, cmp): sort in place, invoking the Coil comparator fnptr
; through the VM (C-calls-back-into-Coil). A stable insertion sort — for the
; corpus' distinct keys the final order equals libc qsort's. cmp returns i32
; (<0 / 0 / >0); we sign-extend it. Ascending: swap while prev > cur.
(defn interp-qsort [(cx (ptr Interp)) (base i64) (n i64) (size i64) (cmpfp i64)] (-> i64)
  (let [fi (primitive/isub cmpfp (fnptr-base))
        tmp (primitive/cast i64 (interp.malloc (primitive/cast isize (if (< size (primitive/cast i64 1)) 1 size))))
        argbuf (primitive/alloc-stack (array i64 2))
        (mut i) 1]
    (when (or (< fi (primitive/cast i64 0)) (>= fi (len (load (field cx bfuncs)))))
      (idie "qsort: comparator is not a Coil function pointer"))
    (loop (if (>= (load i) n)
              (break)
              (do
                (let [(mut j) (load i)]
                  (loop (if (<= (load j) (primitive/cast i64 0))
                            (break)
                            (let [pa (primitive/iadd base (primitive/imul (primitive/isub (load j) 1) size))
                                  pb (primitive/iadd base (primitive/imul (load j) size))]
                              (set! (primitive/index (primitive/cast (ptr i64) argbuf) 0) pa)
                              (set! (primitive/index (primitive/cast (ptr i64) argbuf) 1) pb)
                              (if (> (canon-int (vm-exec cx fi (primitive/cast (ptr i64) argbuf) 2 0) 32 true)
                                     (primitive/cast i64 0))
                                  (do
                                    (memcopy tmp pa size)
                                    (memcopy pa pb size)
                                    (memcopy pb tmp size)
                                    (set! j (primitive/isub (load j) 1)))
                                  (set! j 0))))))  ; in order -> stop inner loop
                (set! i (primitive/iadd (load i) 1)))))
    (interp.free (primitive/cast (ptr i8) tmp))
    0))

; ============================ FFI dispatch ==================================
; Builtin table: dispatch an extern call to the REAL native libc function by its
; C symbol name. This is self-contained (no dlsym) and every entry is a genuine
; native call with the correct signature. An extern not in the table hard-errors
; — never a silent no-op.
(defn extern-call [(cx (ptr Interp)) (ei i64) (buf (ptr i64)) (n i64)] (-> i64)
  (let [nm (last-component2 (.name (ial-at [Extern] (load (field cx externs)) ei)))]
    (cond (= nm "putchar") (interp.putchar (load (primitive/index buf 0)))
          (= nm "putc") (interp.putchar (load (primitive/index buf 0)))
          (= nm "write")
            (primitive/cast i64
                            (interp.write (primitive/cast i32 (load (primitive/index buf 0)))
                                          (primitive/cast (ptr i8) (load (primitive/index buf 1)))
                                          (primitive/cast isize (load (primitive/index buf 2)))))
          (= nm "puts") (interp.puts (primitive/cast (ptr i8) (load (primitive/index buf 0))))
          (= nm "exit") (interp.exit (primitive/cast i32 (load (primitive/index buf 0))))
          (= nm "malloc") (primitive/cast i64 (interp.malloc (primitive/cast isize (load (primitive/index buf 0)))))
          (= nm "free") (do (interp.free (primitive/cast (ptr i8) (load (primitive/index buf 0)))) 0)
          (= nm "realloc")
            (primitive/cast i64
                            (interp.realloc (primitive/cast (ptr i8) (load (primitive/index buf 0)))
                                            (primitive/cast isize (load (primitive/index buf 1)))))
          (= nm "calloc")
            (primitive/cast i64
                            (interp.calloc (primitive/cast isize (load (primitive/index buf 0)))
                                           (primitive/cast isize (load (primitive/index buf 1)))))
          (= nm "memcpy")
            (primitive/cast i64
                            (interp.memcpy (primitive/cast (ptr i8) (load (primitive/index buf 0)))
                                           (primitive/cast (ptr i8) (load (primitive/index buf 1)))
                                           (primitive/cast isize (load (primitive/index buf 2)))))
          (= nm "memmove")
            (primitive/cast i64
                            (interp.memmove (primitive/cast (ptr i8) (load (primitive/index buf 0)))
                                            (primitive/cast (ptr i8) (load (primitive/index buf 1)))
                                            (primitive/cast isize (load (primitive/index buf 2)))))
          (= nm "memset")
            (primitive/cast i64
                            (interp.memset (primitive/cast (ptr i8) (load (primitive/index buf 0)))
                                           (primitive/cast i32 (load (primitive/index buf 1)))
                                           (primitive/cast isize (load (primitive/index buf 2)))))
          (= nm "memcmp")
            (primitive/cast i64
                            (interp.memcmp (primitive/cast (ptr i8) (load (primitive/index buf 0)))
                                           (primitive/cast (ptr i8) (load (primitive/index buf 1)))
                                           (primitive/cast isize (load (primitive/index buf 2)))))
          (= nm "strlen") (primitive/cast i64 (interp.strlen (primitive/cast (ptr i8) (load (primitive/index buf 0)))))
          (= nm "strcmp")
            (primitive/cast i64
                            (interp.strcmp (primitive/cast (ptr i8) (load (primitive/index buf 0)))
                                           (primitive/cast (ptr i8) (load (primitive/index buf 1)))))
          (= nm "read")
            (primitive/cast i64
                            (interp.read (primitive/cast i32 (load (primitive/index buf 0)))
                                         (primitive/cast (ptr i8) (load (primitive/index buf 1)))
                                         (primitive/cast isize (load (primitive/index buf 2)))))
          (= nm "abort") (do (interp.abort) 0)
          (= nm "printf")
            (primitive/cast i64
                            (interp.printf (primitive/cast (ptr i8) (load (primitive/index buf 0)))
                                           (load (primitive/index buf 1))
                                           (load (primitive/index buf 2))
                                           (load (primitive/index buf 3))
                                           (load (primitive/index buf 4))
                                           (load (primitive/index buf 5))
                                           (load (primitive/index buf 6))))
          (= nm "dprintf")
            (primitive/cast i64
                            (interp.dprintf (primitive/cast i32 (load (primitive/index buf 0)))
                                            (primitive/cast (ptr i8) (load (primitive/index buf 1)))
                                            (load (primitive/index buf 2))
                                            (load (primitive/index buf 3))
                                            (load (primitive/index buf 4))
                                            (load (primitive/index buf 5))
                                            (load (primitive/index buf 6))
                                            (load (primitive/index buf 7))))
          (= nm "snprintf")
            (primitive/cast i64
                            (interp.snprintf (primitive/cast (ptr i8) (load (primitive/index buf 0)))
                                             (load (primitive/index buf 1))
                                             (primitive/cast (ptr i8) (load (primitive/index buf 2)))
                                             (load (primitive/index buf 3))
                                             (load (primitive/index buf 4))
                                             (load (primitive/index buf 5))
                                             (load (primitive/index buf 6))
                                             (load (primitive/index buf 7))
                                             (load (primitive/index buf 8))))
          ; div_t div(int,int): {quot@0, rem@4}, returned in x0 (quot low, rem high).
          ; Computed directly (avoids a struct-return extern declaration); the caller
          ; boxes this packed word into a div_t slot (opcode 43).
          (= nm "div")
            (let [x (load (primitive/index buf 0))
                  y (load (primitive/index buf 1))]
              (primitive/ior (primitive/iand (primitive/idiv x y) 4294967295) (primitive/ishl (primitive/irem x y) 32)))
          (= nm "qsort")
            (interp-qsort cx
                          (load (primitive/index buf 0))
                          (load (primitive/index buf 1))
                          (load (primitive/index buf 2))
                          (load (primitive/index buf 3)))
          ; pthread_create(handle, attr, start, arg): run the Coil start routine
          ; SYNCHRONOUSLY (the interpreter is single-threaded; sequential execution of
          ; the workers' atomic ops yields the same race-free final state as genuine
          ; concurrency for the corpus' contention-free dogfoods). *handle gets a
          ; nonzero id so join has something; the routine's return is discarded.
          (= nm "pthread_create")
            (let [fi (primitive/isub (load (primitive/index buf 2)) (fnptr-base))
                  wargs (primitive/alloc-stack (array i64 1))]
              (when (or (< fi (primitive/cast i64 0)) (>= fi (len (load (field cx bfuncs)))))
                (idie "pthread_create: start routine is not a Coil function pointer"))
              (store! (primitive/index (primitive/cast (ptr i64) wargs) 0) (load (primitive/index buf 3)))
              (vm-exec cx fi (primitive/cast (ptr i64) wargs) 1 0)
              (mem-store (load (primitive/index buf 0)) 1 8)
              0)
          (= nm "pthread_join") 0
          (= nm "sqrt") (f64-bits (interp.sqrt (bits->f64 (load (primitive/index buf 0)))))
          (= nm "pow")
            (f64-bits (interp.pow (bits->f64 (load (primitive/index buf 0))) (bits->f64 (load (primitive/index buf 1)))))
          (= nm "fabs") (f64-bits (interp.fabs (bits->f64 (load (primitive/index buf 0)))))
          (= nm "floor") (f64-bits (interp.floor (bits->f64 (load (primitive/index buf 0)))))
          (= nm "ceil") (f64-bits (interp.ceil (bits->f64 (load (primitive/index buf 0)))))
          (= nm "strtol")
            (interp.strtol (primitive/cast (ptr i8) (load (primitive/index buf 0)))
                           (primitive/cast (ptr (ptr i8)) (load (primitive/index buf 1)))
                           (primitive/cast i32 (load (primitive/index buf 2))))
          (= nm "atoi") (primitive/cast i64 (interp.atoi (primitive/cast (ptr i8) (load (primitive/index buf 0)))))
          ; not a libc builtin: if a meta extern hook is registered (meta execution), let
          ; it dispatch (e.g. the metashim mh_* callbacks into the compiler). Otherwise a
          ; genuinely unsupported extern is a hard error, as before.
          (let [hk (interp-extern-hook)]
            (if (!= (load (field hk isset)) (primitive/cast i64 0))
                (primitive/call-ptr (load (field hk fp)) (slice-data nm) (len nm) buf n)
                (do (idie2 "unsupported extern (add it to the interp builtin table): " nm) 0))))))

; ============================ inline LLVM-IR interpreter ====================
; The corpus' (primitive/llvm-ir …) bodies are straight-line SSA (slice / atomic / simd /
; mmio helpers). We INTERPRET them at runtime against the VM's real memory,
; mirroring codegen_a64's structural lowering exactly (same offsets, same lane
; math). Anything outside the implemented subset HARD-ERRORS with the line.
(defn istr->i64 [(s (slice u8))] (-> i64)
  (let [n (len s)
        neg (and (> n (primitive/cast i64 0)) (= (primitive/cast i64 (get s 0)) (primitive/cast i64 45)))
        (mut i) (when neg 1)
        (mut v) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (let [c (primitive/cast i64 (get s (load i)))]
                  (if (or (< c (primitive/cast i64 48)) (> c (primitive/cast i64 57)))
                      (idie2 "not an integer token: " s)
                      (set! v (primitive/iadd (primitive/imul (load v) 10) (primitive/isub c 48)))))
                (set! i (primitive/iadd (load i) 1)))))
    (if neg (primitive/isub 0 (load v)) (load v))))

; tokenizer: split on whitespace and commas; '{','}','<','>','(',')' self-delimit.
(defn ir-tokens2 [(a (dyn Allocator)) (line (slice u8))] (-> (ptr (ArrayList (slice u8))))
  (let [(mut toks) (al-new [(slice u8)] a)
        n (len line)
        (mut i) 0
        (mut start) -1]
    (loop (if (>= (load i) n)
              (do
                (when (>= (load start) (primitive/cast i64 0)) (push! (mut toks) (subslice line (load start) n)))
                (break))
              (do
                (let [c (primitive/cast i64 (get line (load i)))]
                  (if (or (or (= c (primitive/cast i64 32)) (= c (primitive/cast i64 9))) (= c (primitive/cast i64 44)))
                      (do
                        (when (>= (load start) (primitive/cast i64 0))
                          (push! (mut toks) (subslice line (load start) (load i))))
                        (set! start -1)
                        0)
                      (if (or (or (or (= c (primitive/cast i64 123)) (= c (primitive/cast i64 125)))
                                  (or (= c (primitive/cast i64 40))
                                      (= c
                                         (primitive/cast i64
                                                         41))))
                              (or (= c (primitive/cast i64 60)) (= c (primitive/cast i64 62))))
                          (do
                            (when (>= (load start) (primitive/cast i64 0))
                              (push! (mut toks) (subslice line (load start) (load i))))
                            (push! (mut toks) (subslice line (load i) (primitive/iadd (load i) 1)))
                            (set! start -1)
                            0)
                          (do (when (< (load start) (primitive/cast i64 0)) (store! start (load i))) 0))))
                (set! i (primitive/iadd (load i) 1)))))
    (box-al [(slice u8)] a (load toks))))

(defn irtok [(toks (ptr (ArrayList (slice u8)))) (i i64)] (-> (slice u8))
  (get (load toks) i))

; parse an IR type token (context: result + arg types); advances *tokp past it.
(defn ir-parse-type2 [(cx (ptr Interp))
                      (result Type)
                      (argtys (ptr (ArrayList Type)))
                      (toks (ptr (ArrayList (slice u8))))
                      (tokp (ptr i64))] (-> Type)
  (let [a (.a cx)
        tk (irtok toks (load tokp))]
    (set! tokp (primitive/iadd (load tokp) 1))
    (cond (= tk "$ret") result
          (= tk "i64") (TInt 64 true)
          (= tk "i32") (TInt 32 true)
          (= tk "i16") (TInt 16 true)
          (= tk "i8") (TInt 8 true)
          (= tk "i1") (TBool)
          (= tk "ptr") (TPtr (box-type a (TInt 8 true)))
          (= tk "float") (TFloat 32)
          (= tk "double") (TFloat 64)
          (= tk "{")
            (let [t0 (ir-parse-type2 cx result argtys toks tokp)
                  t1 (ir-parse-type2 cx result argtys toks tokp)]
              (store! tokp (primitive/iadd (load tokp) 1))  ; skip }
              (TSlice (box-type a t0)))
          (= tk "<")
            (let [nstr (irtok toks (load tokp))]
              (store! tokp (primitive/iadd (load tokp) 1))  ; N
              (store! tokp (primitive/iadd (load tokp) 1))  ; x
              (let [elem (ir-parse-type2 cx result argtys toks tokp)]
                (store! tokp (primitive/iadd (load tokp) 1))  ; >
                (TVec (box-type a elem) (istr->i64 nstr))))
          (and (>= (len tk) (primitive/cast i64 3))
               (and (= (primitive/cast i64 (get tk 0)) (primitive/cast i64 36))
                    (= (primitive/cast i64 (get tk 1)) (primitive/cast i64 116))))
            (get (load argtys) (istr->i64 (subslice tk 2 (len tk))))
          :else (do (idie2 "llvm-ir: unsupported type token: " tk) (TInt 64 true)))))

; aggregate element (offset, elem type) for extract/insert.
(defn ir-agg-elem2 [(cx (ptr Interp)) (tp (ptr Type)) (idx i64) (offp (ptr i64))] (-> Type)
  (match (load tp)
    (TSlice [elem]
            (if (= idx (primitive/cast i64 0))
                (do (set! offp 0) (TPtr elem))
                (do
                  (set! offp 8)
                  (TInt 64 true))))
    (TStruct [nm]
             (let [si (istruct-idx cx nm)]
               (when (< si (primitive/cast i64 0)) (idie2 "llvm-ir: extract from unknown struct " nm) 0)
               (set! offp (ifield-off cx si idx))
               (.ty (ial-at [Field]
                            (load (field (struct-at (field cx layouts) si) fields))
                            idx))))
    (_ (do (idie "llvm-ir: extract/insert on unsupported aggregate") (TInt 64 true)))))

; resolve a VALUE token: %name (env), $N (arg), undef/zeroinitializer (fresh slot),
; integer literal. `tp` is the value's type context (for undef/zero slot sizing).
(defn ir-value2 [(cx (ptr Interp))
                 (names (ptr (ArrayList (slice u8))))
                 (vals (ptr (ArrayList i64)))
                 (args (ptr i64))
                 (tk (slice u8))
                 (tp (ptr Type))
                 (fm i64)
                 (moff (ptr i64))] (-> i64)
  (let [c0 (primitive/cast i64 (get tk 0))]
    (cond (= c0 (primitive/cast i64 37))  ; %
            (ir-env-get names vals tk)
          (= c0 (primitive/cast i64 36))  ; $N  (value arg)
            (load (primitive/index args (istr->i64 (subslice tk 1 (len tk)))))
          (= tk "undef") (frame-alloc fm moff (isize-of cx tp) (ialign-of cx tp))
          (= tk "zeroinitializer")
            (let [addr (frame-alloc fm moff (isize-of cx tp) (ialign-of cx tp))]
              (do (memzero addr (isize-of cx tp)) addr))
          :else (istr->i64 tk))))

(defn ir-env-get [(names (ptr (ArrayList (slice u8)))) (vals (ptr (ArrayList i64))) (nm (slice u8))] (-> i64)
  (let [n (len (load names))
        (mut i) (primitive/isub n 1)
        (mut r) 0]
    (loop (if (< (load i) (primitive/cast i64 0))
              (break)
              (do
                (when (= (get (load names) (load i)) nm)
                  (store! r (get (load vals) (load i)))
                  (break))
                (set! i (primitive/isub (load i) 1)))))
    (load r)))

(defn ir-env-put! [(names (ptr (ArrayList (slice u8)))) (vals (ptr (ArrayList i64))) (nm (slice u8)) (v i64)] (-> i64)
  (push! (mut names) nm)
  (push! (mut vals) v)
  0)

; store scalar/aggregate cell `v` of type tp at absolute address `dst`.
(defn ir-store-at [(cx (ptr Interp)) (dst i64) (v i64) (tp (ptr Type))] (-> i64)
  (if (ty-is-agg tp) (memcopy dst v (isize-of cx tp)) (mem-store dst v (isize-of cx tp)))
  0)

; per-lane float binop over vec addresses (op 0 add 1 sub 2 mul). lb = lane bytes.
(defn ir-vec-fbin [(op i64) (dst i64) (asrc i64) (bsrc i64) (lanes i64) (lb i64)] (-> i64)
  (let [(mut k) 0]
    (loop (if (>= (load k) lanes)
              (break)
              (do
                (let [av (mem-load (primitive/iadd asrc (primitive/imul (load k) lb)) lb false)
                      bv (mem-load (primitive/iadd bsrc (primitive/imul (load k) lb)) lb false)
                      rv
                        (if (= lb (primitive/cast i64 4))
                            (f32->bits (if (= op (primitive/cast i64 0))
                                           (primitive/fadd (bits->f32 av) (bits->f32 bv))
                                           (if (= op (primitive/cast i64 1))
                                               (primitive/fsub (bits->f32 av) (bits->f32 bv))
                                               (primitive/fmul (bits->f32 av) (bits->f32 bv)))))
                            (f64-bits (if (= op (primitive/cast i64 0))
                                          (primitive/fadd (bits->f64 av) (bits->f64 bv))
                                          (if (= op (primitive/cast i64 1))
                                              (primitive/fsub (bits->f64 av) (bits->f64 bv))
                                              (primitive/fmul (bits->f64 av) (bits->f64 bv))))))]
                  (mem-store (primitive/iadd dst (primitive/imul (load k) lb)) rv lb))
                (set! k (primitive/iadd (load k) 1)))))
    0))

; interpret ONE IR line; on `ret` writes *retvalp and sets *donep.
(defn ir-line! [(cx (ptr Interp))
                (names (ptr (ArrayList (slice u8))))
                (vals (ptr (ArrayList i64)))
                (args (ptr i64))
                (argtys (ptr (ArrayList Type)))
                (result Type)
                (retvalp (ptr i64))
                (donep (ptr bool))
                (line (slice u8))
                (fm i64)
                (moff (ptr i64))] (-> i64)
  (let [a (.a cx)
        toks (ir-tokens2 a line)
        ntk (len (load toks))]
    (unless (= ntk (primitive/cast i64 0))
      (let [t0 (irtok toks 0)]
        (cond (= t0 "declare") 0
              (= t0 "ret")
                (let [tokp (primitive/alloc-stack i64)
                      rtp (primitive/alloc-stack Type)]
                  (store! tokp 1)
                  (store! rtp (ir-parse-type2 cx result argtys toks tokp))
                  (store! retvalp (ir-value2 cx names vals args (irtok toks (load tokp)) rtp fm moff))
                  (store! donep true)
                  0)
              (= t0 "store")  ; store atomic TYPE VAL, ptr PTR seq_cst, align N   (sequential model)
                (if (and (>= ntk (primitive/cast i64 7)) (= (irtok toks 1) "atomic"))
                    (let [tokp (primitive/alloc-stack i64)
                          vtp (primitive/alloc-stack Type)]
                      (store! tokp 2)
                      (store! vtp (ir-parse-type2 cx result argtys toks tokp))
                      (let [v (ir-value2 cx names vals args (irtok toks (load tokp)) vtp fm moff)
                            ptp (primitive/alloc-stack Type)]
                        (store! ptp (TPtr (box-type a (TInt 8 true))))
                        (let [p (ir-value2 cx names vals args (irtok toks (primitive/iadd (load tokp) 2)) ptp fm moff)]
                          (mem-store p v (isize-of cx vtp))
                          0)))
                    (do (idie2 "llvm-ir: unsupported store line: " line) 0))
              (and (>= ntk (primitive/cast i64 3)) (= (primitive/cast i64 (get t0 0)) (primitive/cast i64 37)))
                (let [op (irtok toks 2)]
                  (cond (= op "extractvalue")
                          (let [tokp (primitive/alloc-stack i64)
                                aggtp (primitive/alloc-stack Type)]
                            (store! tokp 3)
                            (store! aggtp (ir-parse-type2 cx result argtys toks tokp))
                            (let [aggv (ir-value2 cx names vals args (irtok toks (load tokp)) aggtp fm moff)
                                  idx (istr->i64 (irtok toks (primitive/iadd (load tokp) 1)))
                                  offp (primitive/alloc-stack i64)
                                  etp (primitive/alloc-stack Type)]
                              (store! etp (ir-agg-elem2 cx aggtp idx offp))
                              (if (ty-is-agg etp)
                                  (let [ns (frame-alloc fm moff (isize-of cx etp) (ialign-of cx etp))]
                                    (memcopy ns (primitive/iadd aggv (load offp)) (isize-of cx etp))
                                    (ir-env-put! names vals t0 ns))
                                  (ir-env-put! names
                                               vals
                                               t0
                                               (mem-load (primitive/iadd aggv (load offp))
                                                         (isize-of cx etp)
                                                         (signed-of etp))))
                              0))
                        (= op "insertvalue")
                          (let [tokp (primitive/alloc-stack i64)
                                aggtp (primitive/alloc-stack Type)]
                            (store! tokp 3)
                            (store! aggtp (ir-parse-type2 cx result argtys toks tokp))
                            (let [aggtk (irtok toks (load tokp))]
                              (store! tokp (primitive/iadd (load tokp) 1))
                              (let [aggv (ir-value2 cx names vals args aggtk aggtp fm moff)
                                    eltp (primitive/alloc-stack Type)]
                                (store! eltp (ir-parse-type2 cx result argtys toks tokp))
                                (let [elv (ir-value2 cx names vals args (irtok toks (load tokp)) eltp fm moff)
                                      idx (istr->i64 (irtok toks (primitive/iadd (load tokp) 1)))
                                      dslot (frame-alloc fm moff (isize-of cx aggtp) (ialign-of cx aggtp))
                                      offp (primitive/alloc-stack i64)]
                                  (memcopy dslot aggv (isize-of cx aggtp))
                                  (ir-agg-elem2 cx aggtp idx offp)
                                  (ir-store-at cx (primitive/iadd dslot (load offp)) elv eltp)
                                  (ir-env-put! names vals t0 dslot)
                                  0))))
                        (= op "atomicrmw")  ; %old = atomicrmw SUB ptr PTR, TYPE VAL seq_cst
                          (let [sub (irtok toks 3)
                                ptp (primitive/alloc-stack Type)]
                            (store! ptp (TPtr (box-type a (TInt 8 true))))
                            (let [p (ir-value2 cx names vals args (irtok toks 5) ptp fm moff)
                                  tokp (primitive/alloc-stack i64)
                                  vtp (primitive/alloc-stack Type)]
                              (store! tokp 6)
                              (store! vtp (ir-parse-type2 cx result argtys toks tokp))
                              (let [v (ir-value2 cx names vals args (irtok toks (load tokp)) vtp fm moff)
                                    sz (isize-of cx vtp)
                                    old (mem-load p sz false)]
                                (cond (= sub "add") (mem-store p (primitive/iadd old v) sz)
                                      (= sub "sub") (mem-store p (primitive/isub old v) sz)
                                      (= sub "xchg") (mem-store p v sz)
                                      :else (idie2 "llvm-ir: unsupported atomicrmw op: " sub))
                                (ir-env-put! names vals t0 old)
                                0)))
                        (= op "cmpxchg")  ; %r = cmpxchg ptr PTR, TYPE EXP, TYPE NEW seq_cst seq_cst -> {old,success}
                          (let [ptp (primitive/alloc-stack Type)]
                            (store! ptp (TPtr (box-type a (TInt 8 true))))
                            (let [p (ir-value2 cx names vals args (irtok toks 4) ptp fm moff)
                                  tokp (primitive/alloc-stack i64)
                                  etp (primitive/alloc-stack Type)]
                              (store! tokp 5)
                              (store! etp (ir-parse-type2 cx result argtys toks tokp))
                              (let [exp
                                      (ir-value2 cx
                                                 names
                                                 vals
                                                 args
                                                 (irtok toks (load tokp))
                                                 etp
                                                 fm
                                                 moff)]
                                (store! tokp (primitive/iadd (load tokp) 1))
                                (let [ntp (primitive/alloc-stack Type)]
                                  (store! ntp (ir-parse-type2 cx result argtys toks tokp))
                                  (let [nv
                                          (ir-value2 cx
                                                     names
                                                     vals
                                                     args
                                                     (irtok toks (load tokp))
                                                     ntp
                                                     fm
                                                     moff)
                                        old (mem-load p 8 false)
                                        ok (= old exp)
                                        slot (frame-alloc fm moff 16 8)]
                                    (when ok (mem-store p nv 8))
                                    (mem-store slot old 8)
                                    (mem-store (primitive/iadd slot 8) (when ok 1) 8)
                                    (ir-env-put! names vals t0 slot)
                                    0)))))
                        (= op "load")  ; %v = load atomic TYPE, ptr PTR seq_cst, align N
                          (if (= (irtok toks 3) "atomic")
                              (let [tokp (primitive/alloc-stack i64)
                                    vtp (primitive/alloc-stack Type)]
                                (store! tokp 4)
                                (store! vtp (ir-parse-type2 cx result argtys toks tokp))
                                (let [ptp (primitive/alloc-stack Type)]
                                  (store! ptp (TPtr (box-type a (TInt 8 true))))
                                  (let [p
                                          (ir-value2 cx
                                                     names
                                                     vals
                                                     args
                                                     (irtok toks (primitive/iadd (load tokp) 1))
                                                     ptp
                                                     fm
                                                     moff)]
                                    (ir-env-put! names
                                                 vals
                                                 t0
                                                 (mem-load p (isize-of cx vtp) (signed-of vtp)))
                                    0)))
                              (do (idie2 "llvm-ir: unsupported load line: " line) 0))
                        (= op "insertelement")  ; %v = insertelement <N x T> AGG, ET EV, i32 K
                          (let [tokp (primitive/alloc-stack i64)
                                vtp (primitive/alloc-stack Type)]
                            (store! tokp 3)
                            (store! vtp (ir-parse-type2 cx result argtys toks tokp))
                            (let [aggtk (irtok toks (load tokp))]
                              (store! tokp (primitive/iadd (load tokp) 1))
                              (let [aggv (ir-value2 cx names vals args aggtk vtp fm moff)
                                    etp (primitive/alloc-stack Type)]
                                (store! etp (ir-parse-type2 cx result argtys toks tokp))
                                (let [ev
                                        (ir-value2 cx
                                                   names
                                                   vals
                                                   args
                                                   (irtok toks (load tokp))
                                                   etp
                                                   fm
                                                   moff)
                                      k (istr->i64 (irtok toks (primitive/iadd (load tokp) 2)))
                                      lb (isize-of cx etp)
                                      dslot
                                        (frame-alloc fm
                                                     moff
                                                     (isize-of cx vtp)
                                                     (ialign-of cx vtp))]
                                  (memcopy dslot aggv (isize-of cx vtp))
                                  (mem-store (primitive/iadd dslot (primitive/imul k lb)) ev lb)
                                  (ir-env-put! names vals t0 dslot)
                                  0))))
                        (= op "shufflevector")  ; splat: %r = shufflevector VTY V, VTY undef, <N x i32> zeroinitializer
                          (let [tokp (primitive/alloc-stack i64)
                                vtp (primitive/alloc-stack Type)]
                            (store! tokp 3)
                            (store! vtp (ir-parse-type2 cx result argtys toks tokp))
                            (let [v
                                    (ir-value2 cx
                                               names
                                               vals
                                               args
                                               (irtok toks (load tokp))
                                               vtp
                                               fm
                                               moff)]
                              (store! tokp (primitive/iadd (load tokp) 1))
                              (ir-parse-type2 cx result argtys toks tokp)  ; 2nd operand type
                              (store! tokp (primitive/iadd (load tokp) 1))  ; undef
                              (ir-parse-type2 cx result argtys toks tokp)  ; mask type
                              (unless (= (irtok toks (load tokp)) "zeroinitializer")
                                (idie2 "llvm-ir: only splat shuffles supported: " line))
                              (match (load vtp)
                                (TVec [elem lanes]
                                      (let [lb (isize-of cx elem)
                                            dslot
                                              (frame-alloc fm
                                                           moff
                                                           (isize-of cx vtp)
                                                           (ialign-of cx vtp))
                                            lane0 (mem-load v lb false)
                                            (mut k) 0]
                                        (loop (if (>= (load k) lanes)
                                                  (break)
                                                  (do
                                                    (mem-store (primitive/iadd dslot
                                                                               (primitive/imul (load k)
                                                                                               lb))
                                                               lane0
                                                               lb)
                                                    (store! k (primitive/iadd (load k) 1)))))
                                        (ir-env-put! names vals t0 dslot)
                                        0))
                                (_ (do
                                     (idie "llvm-ir: shufflevector on non-vector")
                                     0)))))
                        (or (or (= op "fadd") (= op "fsub"))
                            (= op "fmul"))
                          (let [tokp (primitive/alloc-stack i64)
                                opn (unless (= op "fadd") (if (= op "fsub") 1 2))
                                vtp (primitive/alloc-stack Type)]
                            (store! tokp 3)
                            (store! vtp (ir-parse-type2 cx result argtys toks tokp))
                            (let [av
                                    (ir-value2 cx
                                               names
                                               vals
                                               args
                                               (irtok toks (load tokp))
                                               vtp
                                               fm
                                               moff)
                                  bv
                                    (ir-value2 cx
                                               names
                                               vals
                                               args
                                               (irtok toks (primitive/iadd (load tokp) 1))
                                               vtp
                                               fm
                                               moff)]
                              (match (load vtp)
                                (TVec [elem lanes]
                                      (let [lb (isize-of cx elem)
                                            dslot
                                              (frame-alloc fm
                                                           moff
                                                           (isize-of cx vtp)
                                                           (ialign-of cx
                                                                      vtp))]
                                        (ir-vec-fbin opn
                                                     dslot
                                                     av
                                                     bv
                                                     lanes
                                                     lb)
                                        (ir-env-put! names vals t0 dslot)
                                        0))
                                (TFloat [bits]
                                        (let [rv
                                                (if (= bits (primitive/cast i64 32))
                                                    (f32->bits (if (= opn (primitive/cast i64 0))
                                                                   (primitive/fadd (bits->f32 av)
                                                                                   (bits->f32 bv))
                                                                   (if (= opn (primitive/cast i64 1))
                                                                       (primitive/fsub (bits->f32 av)
                                                                                       (bits->f32 bv))
                                                                       (primitive/fmul (bits->f32 av)
                                                                                       (bits->f32 bv)))))
                                                    (f64-bits (if (= opn (primitive/cast i64 0))
                                                                  (primitive/fadd (bits->f64 av)
                                                                                  (bits->f64 bv))
                                                                  (if (= opn (primitive/cast i64 1))
                                                                      (primitive/fsub (bits->f64 av)
                                                                                      (bits->f64 bv))
                                                                      (primitive/fmul (bits->f64 av)
                                                                                      (bits->f64 bv))))))]
                                          (ir-env-put! names vals t0 rv)
                                          0))
                                (_ (do
                                     (idie "llvm-ir: float op on unsupported type")
                                     0)))))
                        (= op "call")
                          (ir-call! cx
                                    names
                                    vals
                                    args
                                    argtys
                                    result
                                    toks
                                    t0
                                    line
                                    fm
                                    moff)
                        :else (do (idie2 "llvm-ir: unsupported op: " op) 0)))
              :else (do (idie2 "llvm-ir: unsupported line: " line) 0))))))

; intrinsic calls: @llvm.fma.v4f32 and @llvm.vector.reduce.fadd.v4f32
(defn ir-call! [(cx (ptr Interp))
                (names (ptr (ArrayList (slice u8))))
                (vals (ptr (ArrayList i64)))
                (args (ptr i64))
                (argtys (ptr (ArrayList Type)))
                (result Type)
                (toks (ptr (ArrayList (slice u8))))
                (t0 (slice u8))
                (line (slice u8))
                (fm i64)
                (moff (ptr i64))] (-> i64)
  (let [a (.a cx)
        tokp (primitive/alloc-stack i64)
        rtp (primitive/alloc-stack Type)]
    (set! tokp 3)
    (set! rtp (ir-parse-type2 cx result argtys toks tokp))
    (let [callee (irtok toks (load tokp))]
      (if (= callee "@llvm.fma.v4f32")
          (let [t1 (primitive/alloc-stack Type)
                t2 (primitive/alloc-stack Type)
                t3 (primitive/alloc-stack Type)]
            (set! tokp (primitive/iadd (load tokp) 2))  ; skip name + "("
            (set! t1 (ir-parse-type2 cx result argtys toks tokp))
            (let [av (ir-value2 cx names vals args (irtok toks (load tokp)) t1 fm moff)]
              (set! tokp (primitive/iadd (load tokp) 1))
              (set! t2 (ir-parse-type2 cx result argtys toks tokp))
              (let [bv (ir-value2 cx names vals args (irtok toks (load tokp)) t2 fm moff)]
                (set! tokp (primitive/iadd (load tokp) 1))
                (set! t3 (ir-parse-type2 cx result argtys toks tokp))
                (let [cv (ir-value2 cx names vals args (irtok toks (load tokp)) t3 fm moff)]
                  (match result
                    (TVec [elem lanes]
                          (let [lb (isize-of cx elem)
                                dslot
                                  (frame-alloc fm
                                               moff
                                               (isize-of cx (box-type a result))
                                               (ialign-of cx (box-type a result)))
                                (mut k) 0]
                            (loop (if (>= (load k) lanes)
                                      (break)
                                      (do
                                        (let [ai (mem-load (primitive/iadd av (primitive/imul (load k) lb)) lb false)
                                              bi (mem-load (primitive/iadd bv (primitive/imul (load k) lb)) lb false)
                                              ci (mem-load (primitive/iadd cv (primitive/imul (load k) lb)) lb false)
                                              rv
                                                (if (= lb (primitive/cast i64 4))
                                                    (f32->bits (primitive/fadd (primitive/fmul (bits->f32 ai)
                                                                                               (bits->f32 bi))
                                                                               (bits->f32 ci)))
                                                    (f64-bits (primitive/fadd (primitive/fmul (bits->f64 ai)
                                                                                              (bits->f64 bi))
                                                                              (bits->f64 ci))))]
                                          (mem-store (primitive/iadd dslot (primitive/imul (load k) lb)) rv lb))
                                        (set! k (primitive/iadd (load k) 1)))))
                            (ir-env-put! names vals t0 dslot)
                            0))
                    (_ (do (idie "llvm-ir: fma on non-vector") 0)))))))
          (if (= callee "@llvm.vector.reduce.fadd.v4f32")
              (let [vtp (primitive/alloc-stack Type)]
                (set! tokp (primitive/iadd (load tokp) 2))  ; skip name + "("
                (ir-parse-type2 cx result argtys toks tokp)  ; float
                (unless (= (irtok toks (load tokp)) "0.0") (idie2 "llvm-ir: reduce.fadd start must be 0.0: " line))
                (set! tokp (primitive/iadd (load tokp) 1))
                (set! vtp (ir-parse-type2 cx result argtys toks tokp))
                (let [v (ir-value2 cx names vals args (irtok toks (load tokp)) vtp fm moff)]
                  (match (load vtp)
                    (TVec [elem lanes]
                          (let [lb (isize-of cx elem)
                                (mut k) 0
                                (mut acc)
                                  (if (= lb (primitive/cast i64 4))
                                      (f32->bits (primitive/cast f32 0))
                                      (f64-bits (primitive/cast f64 0)))]
                            (loop (if (>= (load k) lanes)
                                      (break)
                                      (do
                                        (let [li (mem-load (primitive/iadd v (primitive/imul (load k) lb)) lb false)]
                                          (set! acc
                                                (if (= lb (primitive/cast i64 4))
                                                    (f32->bits (primitive/fadd (bits->f32 (load acc)) (bits->f32 li)))
                                                    (f64-bits (primitive/fadd (bits->f64 (load acc)) (bits->f64 li))))))
                                        (set! k (primitive/iadd (load k) 1)))))
                            (ir-env-put! names vals t0 (load acc))
                            0))
                    (_ (do (idie "llvm-ir: reduce on non-vector") 0)))))
              (do (idie2 "llvm-ir: unsupported intrinsic: " callee) 0))))))

; run a whole IR body; returns the result cell.
(defn ir-run [(cx (ptr Interp)) (irp (ptr IIr)) (args (ptr i64)) (fm i64) (moff (ptr i64))] (-> i64)
  (let [a (.a cx)
        names (box-al [(slice u8)] a (al-new [(slice u8)] a))
        vals (box-al [i64] a (al-new [i64] a))
        argtys (field irp argtys)
        result (.result irp)
        body (.body irp)
        blen (len body)
        (mut pos) 0
        retvalp (primitive/alloc-stack i64)
        donep (primitive/alloc-stack bool)]
    (set! retvalp 0)
    (set! donep false)
    (loop (if (>= (load pos) blen)
              (break)
              (do
                (let [(mut eol) (load pos)]
                  (loop (if (or (>= (load eol) blen)
                                (= (primitive/cast i64 (get body (load eol)))
                                   (primitive/cast i64 10)))
                            (break)
                            (set! eol (primitive/iadd (load eol) 1))))
                  (let [line (subslice body (load pos) (load eol))]
                    (set! pos (primitive/iadd (load eol) 1))
                    (unless (= (len line) (primitive/cast i64 0))
                      (if (load donep)
                          (idie2 "llvm-ir: code after ret: " line)
                          (ir-line! cx names vals args argtys result retvalp donep line fm moff)))))
                0)))
    (unless (load donep) (idie "llvm-ir: body did not ret"))
    (load retvalp)))

; ============================ the VM ========================================
(defn vpush [(ops (ptr i64)) (spc (ptr i64)) (v i64)] (-> i64)
  (set! (primitive/index ops (load spc)) v)
  (set! spc (primitive/iadd (load spc) 1))
  0)

(defn vpop [(ops (ptr i64)) (spc (ptr i64))] (-> i64)
  (let [t (primitive/isub (load spc) 1)] (set! spc t) (load (primitive/index ops t))))

; execute compiled function `fidx` with `argc` i64 arguments; return its i64
; result. Recursion uses the host call stack (one vm-exec activation per call).
(defn vm-exec [(cx (ptr Interp)) (fidx i64) (argv (ptr i64)) (argc i64) (retbuf i64)] (-> i64)
  (let [bf (ial-at [BFunc] (field cx bfuncs) fidx)
        nl (.nlocals bf)
        nlb (if (<= nl (primitive/cast i64 1)) 1 nl)
        locals (primitive/cast (ptr i64) (interp.malloc (primitive/cast isize (primitive/imul nlb 8))))
        framemem (primitive/cast i64 (interp.malloc 1048576))
        ops (primitive/cast (ptr i64) (interp.malloc 32768))
        spc (primitive/alloc-stack i64)
        memoffc (primitive/alloc-stack i64)
        code (load (field bf code))
        argbuf (primitive/alloc-stack (array i64 32))
        retp (primitive/alloc-stack Type)
        (mut pc) 0
        (mut halt) false
        (mut retval) 0]
    (set! retp (.retty bf))
    (let [retagg (ty-is-agg retp)
          retsz (when (ty-is-agg retp) (isize-of cx retp))]
      (set! spc 0)
      (set! memoffc 0)
      (let [(mut i) 0]
        (loop (if (>= (load i) argc)
                  (break)
                  (do
                    (set! (primitive/index locals (load i)) (load (primitive/index argv (load i))))
                    (set! i (primitive/iadd (load i) 1))))))
      (loop
        ; interp-aborting? is false (one field load) unless a metaprogram-level (primitive/error …)
        ; requested an abort; when it fires, every vm-exec frame breaks here and unwinds,
        ; freeing its frame memory below — no pthread_exit, no (loop 0) spin.
        (if (or (load halt) (interp-aborting?))
            (break)
            (let [ins (ial-at [Instr] code (load pc))
                  op (.op ins)
                  a (.a ins)
                  b (.b ins)
                  c (.c ins)]
              (set! pc (primitive/iadd (load pc) 1))
              (case op 1
                    (vpush ops spc a) 2
                    (vpush ops spc (load (primitive/index locals a))) 3
                    (store! (primitive/index locals a) (vpop ops spc)) 4
                    (do (vpop ops spc) 0) 5
                    (vpush ops spc (frame-alloc framemem memoffc a b)) 6
                    (let [addr (vpop ops spc)] (vpush ops spc (mem-load addr a (!= b (primitive/cast i64 0))))) 7
                    (let [v (vpop ops spc)
                          addr (vpop ops spc)]
                      (do (mem-store addr v a) (vpush ops spc 0)))
                      8
                    (let [r (vpop ops spc)
                          l (vpop ops spc)]
                      (vpush ops spc (do-bin a b c l r)))
                      9
                    (let [r (vpop ops spc)
                          l (vpop ops spc)]
                      (vpush ops spc (do-cmp a b c l r)))
                      10
                    (let [v (vpop ops spc)]
                      (vpush ops
                             spc
                             (cond (= a (primitive/cast i64 0)) (primitive/ixor v -1)
                                   (= a (primitive/cast i64 1)) (when (= v (primitive/cast i64 0)) 1)
                                   :else (do-int-unary a b v))))
                      11
                    (store! pc a) 12
                    (let [v (vpop ops spc)] (when (= v (primitive/cast i64 0)) (store! pc a))) 13
                    (let [(mut k) (primitive/isub b 1)]
                      (loop (if (< (load k) (primitive/cast i64 0))
                                (break)
                                (do
                                  (store! (primitive/index (primitive/cast (ptr i64) argbuf) (load k)) (vpop ops spc))
                                  (store! k (primitive/isub (load k) 1)))))
                      (let [crp (primitive/alloc-stack Type)]
                        (store! crp (load (field (ial-at [BFunc] (field cx bfuncs) a) retty)))
                        (let [rb (when (ty-is-agg crp) (frame-alloc framemem memoffc (isize-of cx crp) 16))]
                          (vpush ops spc (vm-exec cx a (primitive/cast (ptr i64) argbuf) b rb)))))
                      14
                    (let [(mut k) (primitive/isub b 1)]
                      (loop (if (< (load k) (primitive/cast i64 0))
                                (break)
                                (do
                                  (store! (primitive/index (primitive/cast (ptr i64) argbuf) (load k)) (vpop ops spc))
                                  (store! k (primitive/isub (load k) 1)))))
                      (vpush ops spc (extern-call cx a (primitive/cast (ptr i64) argbuf) b)))
                      15
                    (let [v (vpop ops spc)]
                      (if retagg (do (memcopy retbuf v retsz) (store! retval retbuf)) (store! retval v))
                      (store! halt true)
                      0)
                      16
                    (let [v (vpop ops spc)] (vpush ops spc (canon-int v a (!= b (primitive/cast i64 0))))) 17
                    (let [v (vpop ops spc)] (vpush ops spc (i2f v a b))) 18
                    (let [v (vpop ops spc)] (vpush ops spc (f2i v a b c))) 19
                    (let [v (vpop ops spc)] (vpush ops spc (f2f v a b))) 21
                    (let [src (vpop ops spc)
                          addr (frame-alloc framemem memoffc b (if (!= c (primitive/cast i64 0)) 16 8))]
                      (do
                        (if (!= c (primitive/cast i64 0)) (memcopy addr src b) (mem-store addr src b))
                        (store! (primitive/index locals a) addr)))
                      22
                    (let [addr (vpop ops spc)] (do (interp.free (primitive/cast (ptr i8) addr)) (vpush ops spc 0))) 23
                    (vpush ops spc (primitive/cast i64 (interp.malloc (primitive/cast isize a)))) 24
                    (let [addr (primitive/cast i64 (interp.malloc (primitive/cast isize a)))]
                      (do (memzero addr a) (vpush ops spc addr)))
                      30
                    (let [addr (frame-alloc framemem memoffc 16 8)]
                      (do (mem-store addr a 8) (mem-store (primitive/iadd addr 8) b 8) (vpush ops spc addr)))
                      31
                    (let [addr (frame-alloc framemem memoffc a b)] (do (memzero addr a) (vpush ops spc addr))) 32
                    (let [src (vpop ops spc)
                          dst (frame-alloc framemem memoffc a b)]
                      (do (memcopy dst src a) (vpush ops spc dst)))  ; LOADAGG (fresh copy)
                      33
                    (let [src (vpop ops spc)
                          dst (vpop ops spc)]
                      (do (memcopy dst src a) (vpush ops spc 0)))  ; STOREAGG
                      34
                    (let [addr (vpop ops spc)] (vpush ops spc (primitive/iadd addr a)))  ; FIELDPTR
                      35
                    (let [idx (vpop ops spc)
                          base (vpop ops spc)]
                      (vpush ops spc (primitive/iadd base (primitive/imul idx a))))  ; INDEX
                      36
                    (do (idie "match: no variant matched (non-exhaustive match reached at runtime)") 0)  ; TRAP
                      37
                    (let [addr (vpop ops spc)
                          low a
                          width b
                          sg (primitive/iand c 1)
                          bb (primitive/ishr c 1)]
                      (let [cont (mem-load addr bb false)
                            v (primitive/cast i64 (primitive/ishr (primitive/cast u64 cont) (primitive/cast u64 low)))]
                        (vpush ops
                               spc
                               (if (< width (primitive/cast i64 64))
                                   (canon-int v width (!= sg (primitive/cast i64 0)))
                                   v))))  ; BITGET
                      38
                    (let [val (vpop ops spc)
                          addr (vpop ops spc)
                          low a
                          width b
                          bb c]
                      (let [fieldmask
                              (if (>= width (primitive/cast i64 64)) -1 (primitive/isub (primitive/ishl 1 width) 1))
                            cont (mem-load addr bb false)
                            cleared (primitive/iand cont (primitive/ixor (primitive/ishl fieldmask low) -1))
                            merged (primitive/ior cleared (primitive/ishl (primitive/iand val fieldmask) low))]
                        (mem-store addr merged bb)
                        (vpush ops spc val)))  ; BITSET
                      40
                    (let [(mut k) (primitive/isub b 1)]
                      (loop (if (< (load k) (primitive/cast i64 0))
                                (break)
                                (do
                                  (store! (primitive/index (primitive/cast (ptr i64) argbuf) (load k)) (vpop ops spc))
                                  (store! k (primitive/isub (load k) 1)))))
                      (vpush ops
                             spc
                             (ir-run cx
                                     (ial-at [IIr] (field cx irs) a)
                                     (primitive/cast (ptr i64) argbuf)
                                     framemem
                                     memoffc)))  ; LLVMIR
                      43
                    (let [val (vpop ops spc)
                          slot (frame-alloc framemem memoffc a b)]
                      (when (> a (primitive/cast i64 8))
                        (idie "extern by-value struct return >8 bytes not supported by interp"))
                      (memzero slot a)
                      (mem-store slot val a)
                      (vpush ops spc slot))  ; box extern agg return
                      42
                    (let [(mut k) (primitive/isub a 1)]
                      (loop (if (< (load k) (primitive/cast i64 0))
                                (break)
                                (do
                                  (store! (primitive/index (primitive/cast (ptr i64) argbuf) (load k)) (vpop ops spc))
                                  (store! k (primitive/isub (load k) 1)))))
                      (let [fpv (vpop ops spc)
                            fi (primitive/isub fpv (fnptr-base))]
                        (when (or (< fi (primitive/cast i64 0))
                                  (>= fi
                                      (len (load (field cx
                                                        bfuncs)))))
                          (idie "call-ptr: not a Coil function pointer (real C addresses unsupported)")
                          0)
                        (let [crp (primitive/alloc-stack Type)]
                          (store! crp (load (field (ial-at [BFunc] (field cx bfuncs) fi) retty)))
                          (let [rb (when (ty-is-agg crp) (frame-alloc framemem memoffc (isize-of cx crp) 16))]
                            (vpush ops spc (vm-exec cx fi (primitive/cast (ptr i64) argbuf) a rb))))))  ; CALLPTR
                      (do (idie "VM: bad opcode") 0))))))
    (interp.free (primitive/cast (ptr i8) locals))
    (interp.free (primitive/cast (ptr i8) framemem))
    (interp.free (primitive/cast (ptr i8) ops))
    (load retval)))

; ============================ top-level entry ================================
; The program's argc/argv (set by the driver's `interp` subcommand before the
; pipeline runs), delivered to a `main` that declares parameters. argv points at
; the real OS char** (so argv[i] are genuine C strings).
(defstruct IArgs [(argc i64) (argv i64)])

(defn iargs-box [] (-> (ptr IArgs))
  (primitive/alloc-static IArgs))

(defn set-interp-args [(argc i64) (argv i64)] (-> i64)
  (let [b (iargs-box)] (set! (.argc b) argc) (set! (.argv b) argv) 0))

; ============================ META execution hooks ==========================
; The metaengine can run a metaprogram (or a comptime fold thunk) by INTERPRETING
; its mono'd sub-program in-process — no dylib/JIT/side-module. Two registered hooks
; make that work without interp.coil depending on the metahost:
;   (1) an EXTERN FALLBACK: the metaprogram's metashim wrappers call `mh_*` externs
;       (metashim_wasm), which are not libc — dispatch them to the compiler's real
;       mh_* via a registered callback keyed by the extern's C symbol.
;   (2) an ABORT CHECK: a metaprogram-level `(primitive/error …)` cannot pthread_exit (that would
;       kill the whole in-process pipeline) and must not spin on metalower's (loop 0).
;       mh-halt sets a flag; vm-exec polls this hook and unwinds every frame cleanly.
; Both unset ⇒ the interpreter behaves exactly as `coil interp` (gate-interp green).
(defstruct InterpExternHook [(isset i64) (fp (fnptr c [(ptr u8) i64 (ptr i64) i64] i64))])

(defn interp-extern-hook [] (-> (ptr InterpExternHook))
  (primitive/alloc-static InterpExternHook))

(defn set-interp-extern-hook! [(fp (fnptr c [(ptr u8) i64 (ptr i64) i64] i64))] (-> i64)
  (let [b (interp-extern-hook)] (set! (.fp b) fp) (set! (.isset b) 1) 0))

(defstruct InterpAbortHook [(isset i64) (fp (fnptr c [] i64))])

(defn interp-abort-hook [] (-> (ptr InterpAbortHook))
  (primitive/alloc-static InterpAbortHook))

(defn set-interp-abort-check! [(fp (fnptr c [] i64))] (-> i64)
  (let [b (interp-abort-hook)] (set! (.fp b) fp) (set! (.isset b) 1) 0))

(defn interp-aborting? [] (-> bool)
  (let [b (interp-abort-hook)]
    (if (= (.isset b) (primitive/cast i64 0))
        false
        (!= (primitive/call-ptr (.fp b))
            (primitive/cast i64 0)))))

; Build a persistent (heap) interpreter context for a mono'd Program WITHOUT running
; main: same registration as interp-program, so entries can be called repeatedly (one
; per macro invocation). Reachable functions compile lazily on first call.
(defn interp-build [(a (dyn Allocator)) (mp (ptr Program))] (-> (ptr Interp))
  (let [cx (box! a Interp (primitive/zeroed Interp))]
    (set! (.a cx) a)
    (set! (.mp cx) mp)
    (set! (.externs cx) (load (field mp externs)))
    (set! (.bfuncs cx) (al-new [BFunc] a))
    (set! (.irs cx) (al-new [IIr] a))
    (iregister-types! cx mp)
    (let [fs (load (field mp funcs))
          n (len (load fs))
          (mut i) 0
          bf0 (primitive/alloc-stack BFunc)]
      (loop (if (>= (load i) n)
                (break)
                (do
                  (let [fd (ial-at [Func] fs (load i))]
                    (set! (.name bf0) (.name fd))
                    (set! (.nparams bf0) (len (load (field fd params))))
                    (set! (.nlocals bf0) 0)
                    (set! (.code bf0) (primitive/cast (ptr (ArrayList Instr)) 0))
                    (set! (.retty bf0) (.ret fd))
                    (set! (.state bf0) 0)
                    (push! (mut (.bfuncs cx)) (load bf0)))
                  (set! i (primitive/iadd (load i) 1))))))
    cx))

; Run entry `nm` with `argc` already-boxed argument cells; returns the i64 result cell
; (a metaprogram entry returns a Code/Sexp handle as a pointer-in-a-cell). A missing
; entry is a hard error.
(defn interp-call-entry [(cx (ptr Interp)) (nm (slice u8)) (argv (ptr i64)) (argc i64)] (-> i64)
  (let [fi (find-func cx nm)]
    (if (< fi (primitive/cast i64 0))
        (do (idie2 "interp meta: no such entry function: " nm) 0)
        (do
          (ensure-compiled cx fi)
          (vm-exec cx fi argv argc 0)))))

; Does the context define an entry with this coil function name? (e.g. the comptime
; div-by-zero guard's coil.ct.status is present only when the sub-program had a div/rem.)
(defn interp-has-entry? [(cx (ptr Interp)) (nm (slice u8))] (-> bool)
  (>= (find-func cx nm) (primitive/cast i64 0)))

; Compile every mono'd function to bytecode, then run `main` and return its i64
; (the process exit code). Registration happens BEFORE compilation so calls
; resolve by name regardless of order.
(defn interp-program [(a (dyn Allocator)) (mp (ptr Program))] (-> i64)
  (let [cx (primitive/alloc-stack Interp)]
    (set! (.a cx) a)
    (set! (.mp cx) mp)
    (set! (.externs cx) (load (field mp externs)))
    (set! (.bfuncs cx) (al-new [BFunc] a))
    (set! (.irs cx) (al-new [IIr] a))
    (iregister-types! cx mp)
    ; pre-register: name + nparams + retty for every func (calls need these).
    (let [fs (load (field mp funcs))
          n (len (load fs))
          (mut i) 0
          bf0 (primitive/alloc-stack BFunc)]
      (loop (if (>= (load i) n)
                (break)
                (do
                  (let [fd (ial-at [Func] fs (load i))]
                    (set! (.name bf0) (.name fd))
                    (set! (.nparams bf0) (len (load (field fd params))))
                    (set! (.nlocals bf0) 0)
                    (set! (.code bf0) (primitive/cast (ptr (ArrayList Instr)) 0))
                    (set! (.retty bf0) (.ret fd))
                    (set! (.state bf0) 0)
                    (push! (mut (.bfuncs cx)) (load bf0)))
                  (set! i (primitive/iadd (load i) 1))))))
    ; lazily compile from main (transitively compiles exactly the reachable set),
    ; then run it. main's i64 return is the process exit code.
    (let [mi (find-func cx "main")]
      (if (< mi (primitive/cast i64 0))
          (do (idie "no `main` function in program") 1)
          (do
            (ensure-compiled cx mi)
            (let [np (.nparams (ial-at [BFunc] (field cx bfuncs) mi))
                  ib (iargs-box)
                  argbuf (primitive/alloc-stack (array i64 4))]
              ; a main that takes parameters receives (argc, argv); a nullary main
              ; gets none. argc widens into the first cell, argv (a char**) the second.
              (if (>= np (primitive/cast i64 2))
                  (do
                    (set! (primitive/index (primitive/cast (ptr i64) argbuf) 0)
                          (.argc ib))
                    (set! (primitive/index (primitive/cast (ptr i64) argbuf) 1)
                          (.argv ib))
                    (vm-exec cx mi (primitive/cast (ptr i64) argbuf) 2 0))
                  (vm-exec cx mi (primitive/cast (ptr i64) argbuf) 0 0))))))))
