(defstruct DriverUnitState
  [(uses UsesBox)
   (readers ActiveSourceReaders)
   (invocation ReaderInvocation)
   (test_roots TestRootsFileBox)
   (lint LintProfileRegBox)
   (parallel bool)
   (dwarf bool)
   (quiet QuietFlag)
   (entry EntryShape)
   (code_main CodeMainBox)
   (owner GeneratedOwner)
   (reader_artifact (slice u8))
   (loaded_artifact (ptr artifact/LoadedProvider))
   ; Prebuilt units named by `--unit DIR`, in argv order; see loader.coil
   ; PrebuiltUnit. Null when none.
   (units (ptr (ArrayList PrebuiltUnit)))
   ; `coil build-unit`: where the interface and object go, and which backend
   ; emits the object (1 LLVM, 2 arm64, 5 x86-64), for the big-stack render.
   (unit_out (slice u8))
   (unit_backend i64)
   (unit_pretransformed bool)
   ; The backend this invocation compiles with (`--backend`, else the
   ; executable's default). Every prebuilt unit it links -- `--unit`, a
   ; `prebuilt = true` dependency, the shipped coil.jit -- was emitted by it.
   (consumer_backend i64)
   ; `coil build-unit --quiet`: no "wrote"/"up to date" line. Used when the
   ; driver builds a unit for its own consumer as a child process.
   (unit_quiet bool)
   ; `coil build-unit`: the unit's top-level forms after macro expansion and
   ; transforms, recorded by the pipeline so the interface can see what the
   ; module's own metaprograms produced. Null outside build-unit.
   (unit_expanded (ptr (ArrayList TaggedForm)))
   ; `coil build-unit`: the module being prebuilt, and the names its `:reexport`
   ; imports pass on (`module-reexported-names`), recorded by the same pipeline
   ; run while its import and declaration tables are at hand. The interface lists
   ; them in its export list beside the re-export imports it carries.
   (unit_module (slice u8))
   (unit_reexported (ptr (ArrayList (slice u8))))
   ; `coil build-unit`: the names the module itself makes public
   ; (`module-own-public-names`: its export list, or with none every name it
   ; declares, generated ones included), and whether it has an export list, read
   ; from the same pipeline run's declaration and export tables after expansion.
   (unit_public (ptr (ArrayList (slice u8))))
   (unit_listed bool)
   ; `coil build-unit`: the C functions the checked program declares, before
   ; specialization lowers a `(-> never)` one's return to void for the backends.
   (unit_externs (ptr (ArrayList Extern)))])

(defn driver-unit-state-cell [] (-> (ptr (ptr DriverUnitState)))
  (primitive/alloc-static (ptr DriverUnitState)))

(defn driver-unit-state [] (-> (ptr DriverUnitState))
  (let [p (load (driver-unit-state-cell))]
    (if (= (primitive/cast i64 p) 0) (primitive/alloc-static DriverUnitState) p)))

(defn driver-unit-bind! [(next (ptr DriverUnitState))]
  (-> (ptr DriverUnitState))
  (let [prior (driver-unit-state)]
    (set! (driver-unit-state-cell) next)
    prior))

(extern rename :cc (cc/C) [(ptr i8) (ptr i8)] (-> i32))

; ASCII-folded substring matching for the two reference lookup commands. Guide
; topics and Coil identifiers are ASCII even though their prose may contain UTF-8.
(defn ref-lower-byte [(b u8)] (-> i64)
  (let [c (primitive/cast i64 b)]
    (if (and (>= c 65) (<= c 90))
        (primitive/iadd c 32)
        c)))

(defn ref-contains-ci? [(hay (slice u8)) (needle (slice u8))] (-> bool)
  (let [hn (len hay)
        nn (len needle)
        (mut i) 0
        (mut found) (= nn 0)]
    (loop (if (or (load found) (> (primitive/iadd (load i) nn) hn))
              (break)
              (let [(mut j) 0
                    (mut same) true]
                (loop (if (or (not (load same)) (>= (load j) nn))
                          (break)
                          (if (= (ref-lower-byte (get hay
                                                      (primitive/iadd (load i)
                                                                      (load j))))
                                 (ref-lower-byte (get needle (load j))))
                              (set! j (primitive/iadd (load j) 1))
                              (set! same false))))
                (if (load same)
                    (set! found true)
                    (set! i (primitive/iadd (load i) 1))))))
    (load found)))

; ── CLI-applied metaprograms: `--use PATH` imports a module (which self-registers
; its (checker …)/(transform …)) WITHOUT editing the source — so you can run a linter
; optionally: `coil run app.coil --use myproject.lint`.
(defstruct UsesBox [(init i64) (lst (ptr (ArrayList (slice u8))))])

(defn uses-box [] (-> (ptr UsesBox))
  (field (driver-unit-state) uses))

(defn cli-uses [] (-> (ptr (ArrayList (slice u8))))
  (let [b (uses-box)]
    (when (= (.init b) 0)
      (set! (.lst b)
            (box! (unit-allocator)
                  (ArrayList (slice u8))
                  (zeroed (ArrayList (slice u8)))))
      (set! (load (field b lst)) (ArrayList::new [(slice u8)] (unit-allocator)))
      (set! (.init b) 1)
      0)
    (load (field b lst))))

(defn cli-use-add [(p (slice u8))] (-> i64)
  ; once each: a manifest, its profile and the command line may all name one
  (let [(mut seen) false]
    (for [i 0 (len (load (cli-uses)))]
      (when (= (get (load (cli-uses)) i) p) (set! seen true))
      0)
    (unless seen
      (push! (cli-uses) p)
      ; The whole-program safety checks are the safe build mode, so the library's
      ; own checks come with them (the slice, ArrayList and HashMap invariants).
      (when (= p "coil.safety") (enable-debug-checks!))
      0))
  0)

(defn is-module-form [(s (ptr Sexp))] (-> bool)
  (and (= (sx-tag (load s)) 6)
       (let [it (sx-items (load s))]
         (and (>= (sx-len it) 1)
              (and (= (sx-tag (sx-at it 0)) 2)
                   (= (sx-sval (sx-at it 0)) "module"))))))

(defn lint-profile-use? [(name (slice u8))] (-> bool)
  (= name "coil.lint.default"))

; mode 0 = every CLI use, 1 = built-in lint profile only, 2 = everything else.
; A reader provider's module reads input files; it is not part of the program
; they make, so it is never imported into one.
(defn cli-use-selected? [(name (slice u8)) (mode i64)] (-> bool)
  (and (= (primitive/cast i64 (active-source-reader-for name)) 0)
       (or (= mode 0)
           (if (= mode 1)
               (lint-profile-use? name)
               (not (lint-profile-use? name))))))

; A module name for an entry file that declares none: its own basename with the
; extension dropped and anything that is not a name character folded to `_`.
(defn entry-module-name [(a (dyn Allocator)) (path (slice u8))] (-> (slice u8))
  (let [base (basename path)
        n (len base)
        stop
          (if (d-ends-with? base ".coil")
              (primitive/isub n 5)
              (if (d-ends-with? base ".scm")
                  (primitive/isub n 4)
                  n))
        (mut b) (StrBuf::new a)
        (mut i) 0]
    ;; A generated namespace is an identifier, not an arbitrary filename. A
    ;; leading digit is legal in a basename but would make the synthesized name
    ;; token behave inconsistently in hygiene/name resolution.
    (when (and (> stop 0)
               (let [c (primitive/cast i64 (get base 0))]
                 (and (>= c 48)
                      (<= c 57))))
      (push! (mut b) (: 95 u8))
      0)
    (loop (if (>= (load i) stop)
              (break)
              (let [c (primitive/cast i64 (get base (load i)))]
                (if (or (and (>= c 97)
                             (<= c 122))
                        (and (>= c 65)
                             (<= c 90))
                        (and (>= c 48)
                             (<= c 57))
                        (= c 45)
                        (= c 95))
                    (push! (mut b) (primitive/cast u8 c))
                    (push! (mut b) (: 95 u8)))
                (set! i (primitive/iadd (load i) 1)))))
    (if (= (len (str (load b))) 0)
        "app"
        (str (load b)))))

; prepend `(import "PATH" :use *)` forms (one per --use) ahead of the entry forms,
; read as their own synthetic source so entry-file diagnostics keep exact spans.
;
; Also synthesizes a `(module …)` for the ENTRY file when it declares none. The entry
; is named on the command line and imported by nobody, so it needs no declared
; namespace, but its forms still need an owning module: resolution of module-scoped
; names (core's `def` aliases such as `cast`) and of macro-template identifiers is
; keyed by the owning module, so ownerless forms saw only part of `coil.core`.
(defn prepend-selected-uses [(a (dyn Allocator))
                             (s (mut LS))
                             (forms (ptr (ArrayList Sexp)))
                             (mode i64)] (-> (ptr (ArrayList Sexp)))
  (let [uses (cli-uses)
        nuses (len (load uses))
        (mut nu) 0
        (mut u) 0
        nf0 (len (load forms))
        hasmod0
          (if (> nf0 0)
              (is-module-form (elem forms 0))
              false)
        _count
          (loop (if (>= (load u) nuses)
                    (break)
                    (do
                      (when (cli-use-selected? (get (load uses) (load u)) mode)
                        (set! nu (primitive/iadd (load nu) 1))
                        0)
                      (set! u (primitive/iadd (load u) 1)))))
        need-module (not hasmod0)]
    (if (and (= (load nu) 0) (not need-module))
        forms
        (let [(mut src)
                (if need-module
                    (sconcat3 a
                              "(module "
                              (if (> (len (.entry_module s)) 0)
                                  (.entry_module s)
                                  (entry-module-name a
                                                     (.name (elem (field s
                                                                         sources)
                                                                  0))))
                              ")")
                    "")
              (mut k) 0]
          (loop (if (>= (load k) nuses)
                    (break)
                    (do
                      (when (cli-use-selected? (get (load uses) (load k)) mode)
                        (set! src
                              (sconcat a
                                       (load src)
                                       (sconcat3 a
                                                 "(import \""
                                                 (get (load uses) (load k))
                                                 "\" :use *)")))
                        0)
                      (set! k (primitive/iadd (load k) 1)))))
          (let [sid (.srccount s)
                _b (set! (.srccount s) (primitive/iadd sid 1))
                _r (register-source! (mut s) "<cli-use>" (load src))]
            (match (read-all a (load src) sid)
              (Err [d] forms)
              (Ok [ifs]
                  (let [(mut out) (ArrayList::new [Sexp] a)
                        ni (len (load ifs))
                        nf (len (load forms))
                        hasmod
                          (if (> nf 0)
                              (is-module-form (elem forms 0))
                              false)
                        (mut j) 0
                        (mut m) 0]
                    ; keep a leading (module …) first, then the CLI imports, then the rest
                    (when hasmod
                      (push! (mut out) (get (load forms) 0))
                      (set! j 1))
                    (loop (if (>= (load m) ni)
                              (break)
                              (do
                                (push! (mut out) (get (load ifs) (load m)))
                                (set! m (primitive/iadd (load m) 1)))))
                    (loop (if (>= (load j) nf)
                              (break)
                              (do
                                (push! (mut out) (get (load forms) (load j)))
                                (set! j (primitive/iadd (load j) 1)))))
                    (box-al [Sexp] a (load out))))))))))

(defn prepend-uses [(a (dyn Allocator))
                    (s (mut LS))
                    (forms (ptr (ArrayList Sexp)))] (-> (ptr (ArrayList Sexp)))
  (prepend-selected-uses a (mut s) forms 0))

(defn install-reader-hygiene-context! [(target (mut LS))
                                       (reader (ptr LS))
                                       (module (slice u8))] (-> i64)
  (when (and (!= (primitive/cast i64 reader) 0)
             (> (len module) 0))
    (let [source (imports-find (field reader imports) module)]
      (when (!= (primitive/cast i64 source) 0)
        (when (= (primitive/cast i64
                                 (imports-find (field target hygiene_imports)
                                               module))
                 0)
          (push! (mut (.hygiene_imports target)) (load source))
          0)
        (when (= (primitive/cast i64
                                 (imports-find (field target imports) module))
                 0)
          (push! (mut (.imports target)) (load source))
          0))
      0))
  0)

(defsum InitialRead
  (InitialForms [(forms (ptr (ArrayList Sexp)))
                 (reader_state (ptr LS))
                 (definition_module (slice u8))])
  (InitialReadError [(diag Diag)]))

(defstruct ReaderProvider
  ; The module selected by `--use` or `[readers]` and containing this declaration.
  ; Empty while parsing a declaration outside configured-reader discovery.
  [(container (slice u8))
   ; The module that defines the reader implementation named by the declaration.
   (module (slice u8))
   (function (slice u8))])

(defstruct ActiveSourceReader
  [(configured_module (slice u8))
   (definition_module (slice u8))
   (setup (ptr LS))
   (program (ptr Program))
   (qualified (slice u8))
   (maps (ptr SemMapsSnap))
   (artifact (ptr artifact/LoadedProvider))
   ; the engine the first reading compiles, holding every provider of the
   ; shared setup, which every later reading calls; null for an artifact provider
   (engine (ptr ReaderEngineCache))
   ; how the source providers are compiled; null for an artifact provider
   (build (ptr SourceReaderBuild))])

(defstruct ActiveSourceReaders
  [(items (ptr (ArrayList (ptr ActiveSourceReader))))])

(defstruct GeneratedUnit
  [(name (slice u8))
   (interface (slice u8))
   (body (slice u8))
   (symbols (ArrayList (slice u8)))])

(defstruct GeneratedUnitCollector
  [(a (dyn Allocator))
   (active i64)
   (units (ArrayList GeneratedUnit))
   (virtuals (ArrayList VirtualSource))
   (mode i64)
   (target (ptr i8))
   (compiling bool)
   (config CompilationUnitConfig)
   (artifacts (ptr (ArrayList (slice u8))))
   (primary (ptr i8))
   (symbol_owners (ptr generated-symbols/SymbolOwners))])

(defn generated-symbol-owners [(c (ptr GeneratedUnitCollector))]
  (-> (ptr generated-symbols/SymbolOwners))
  (when (= (primitive/cast i64 (.symbol_owners c)) 0)
    (set! (.symbol_owners c) (generated-symbols/owners-new (.a c)))
    0)
  (.symbol_owners c))

(defn generated-cleanup-registered [] (-> (ptr bool))
  (primitive/alloc-static bool))

(defn generated-cleanup-at-exit [] (-> i64)
  (let [c (load (generated-unit-collector-cell))]
    (unless (= (primitive/cast i64 c) 0)
      (for [i 0 (len (load (.artifacts c)))]
        (unlink (to-cstr (.a c) (get (load (.artifacts c)) i)))
        0)
      (unless (= (primitive/cast i64 (.primary c)) 0) (unlink (.primary c)) 0)
      (generated-cleanup! c)
      0))
  0)

(defstruct GeneratedOwner
  [(active bool) (name (slice u8)) (interface (slice u8))])

(defn generated-owner [] (-> (ptr GeneratedOwner))
  (field (driver-unit-state) owner))

(defn generated-error [(name (slice u8)) (message (slice u8))] (-> i64)
  (ps (stderr) "error: generated module '")
  (ps (stderr) name)
  (ps (stderr) "': ")
  (ps (stderr) message)
  (wb (stderr) 10)
  0)

(defn generated-name? [(name (slice u8))] (-> bool)
  (let [(mut good) (> (len name) 0)
        (mut segment) false]
    (for [i 0 (len name)]
      (let [c (primitive/cast i64 (get name i))]
        (if (= c 46)
            (do
              (unless (load segment) (set! good false) 0)
              (set! segment false))
            (do
              (unless (or (and (>= c 65) (<= c 90))
                          (and (>= c 97) (<= c 122))
                          (and (>= c 48) (<= c 57))
                          (= c 45)
                          (= c 95))
                (set! good false)
                0)
              (set! segment true))))
      0)
    (and (load good) (load segment))))

(defn generated-rollback! [(c (ptr GeneratedUnitCollector)) (mark i64)] (-> i64)
  (for [i mark (len (.units c))]
    (let [unit (elem (field c units) i)]
      (unless (= (primitive/cast i64 (.symbol_owners c)) 0)
        (generated-symbols/owners-release! (.symbol_owners c)
                                           (.name unit)
                                           (field unit symbols))
        0)
      (free [u8] (malloc-allocator) (.interface unit))
      (free [u8] (malloc-allocator) (.body unit)))
    0)
  (set! (.len (field c units)) mark)
  (set! (.len (field c virtuals)) mark)
  0)

(defn generated-cleanup! [(c (ptr GeneratedUnitCollector))] (-> i64)
  (generated-rollback! c 0)
  0)

; Interface source is deliberately much smaller than a body. Its syntax is
; checked in temporary storage, so neither duplicate nor failed submissions
; retain source text in the root compiler arena.
(defn generated-interface-import? [(collector (ptr GeneratedUnitCollector))
                                   (name (slice u8))] (-> bool)
  (let [(mut found) false]
    (unless (= (primitive/cast i64 collector) 0)
      (for [i 0 (len (.units collector))]
        (when (= (.name (elem (field collector units) i))
                 name)
          (set! found true)
          0)
        0)
      0)
    (load found)))

(defn generated-interface-alias-free? [(form Sexp)] (-> bool)
  (let [(mut good) true]
    (when (= (sx-tag form) 2)
      (for [i 0 (len (sx-sval form))]
        (when (= (primitive/cast i64 (get (sx-sval form) i)) 47)
          (set! good false)
          0)
        0)
      0)
    (when (or (= (sx-tag form) 6) (= (sx-tag form) 7))
      (for [i 0 (sx-len (sx-items form))]
        (unless (generated-interface-alias-free? (sx-at (sx-items form) i))
          (set! good false)
          0)
        0)
      0)
    (load good)))

(defn generated-extern [(a (dyn Allocator)) (form Sexp)]
  (-> (Result Extern Diag))
  (let [items (sx-items form)
        (mut rest) (ArrayList::new [Sexp] a)]
    (for [i 1 (sx-len items)] (push! (mut rest) (sx-at items i)) 0)
    (parse-extern a (mut rest))))

(defn generated-interface [(a (dyn Allocator))
                           (collector (ptr GeneratedUnitCollector))
                           (name (slice u8))
                           (source (slice u8))
                           (symbols (mut (ArrayList (slice u8))))
                           (prefix (mut StrBuf))
                           (suffix (mut StrBuf))] (-> bool)
  (try (let [forms
               (try-or! (read-all a source 0)
                        (do
                          (generated-error name
                                           "interface is not valid Coil syntax")
                          false))]
         (let [(mut good) true
               (mut modules) 0]
           (for [i 0 (len (load forms))]
             (let [form (get (load forms) i)]
               ; Signature witnesses must keep referring to the same nominal types
               ; inside an implementation. Fully qualified type names cannot be
               ; redirected by an implementation's unrelated import aliases.
               (unless (generated-interface-alias-free? form)
                 (generated-error name
                                  "interface types must use fully qualified names, not import aliases")
                 (store! good false)
                 0)
               (if (or (!= (sx-tag form) 6) (= (sx-len (sx-items form)) 0))
                   (store! good false)
                   (let [items (sx-items form)
                         head (sx-sval (sx-at items 0))]
                     (cond (= head "module")
                             (do
                               (set! modules (+ (load modules) 1))
                               (unless (and (= (sx-len items) 2)
                                            (= (sx-sval (sx-at items 1)) name))
                                 (store! good false)
                                 0))
                           (= head "import")
                             (if (and (= (sx-len items) 2)
                                      (and (= (sx-tag (sx-at items 1)) 4)
                                           (and (!= (sx-sval (sx-at items 1))
                                                    name)
                                                (generated-interface-import? collector
                                                                             (sx-sval (sx-at items
                                                                                             1))))))
                                 (do
                                   (push-str! (mut prefix)
                                              (subslice source
                                                        (.lo form)
                                                        (.hi form)))
                                   (push-str! (mut prefix) "\n"))
                                 (do
                                   (generated-error name
                                                    "interface imports must name an already registered generated interface; self, forward, and ordinary implementation imports are not allowed")
                                   (store! good false)))
                           (= head "extern")
                             (match (generated-extern a form)
                               (Err [_] (store! good false))
                               (Ok [decl]
                                   (let [symbol (sx-sval (sx-at items 1))
                                         ep (box! a Extern decl)
                                         cname (extern-link-name ep)
                                         params
                                           (sx-at items (- (sx-len items) 2))
                                         result
                                           (sx-at items (- (sx-len items) 1))
                                         ; Generated text is read before any import
                                         ; resolves, so it names the convention fully
                                         ; qualified, `:cc (coil.cc.C)`.
                                         explicit-c
                                           (match (.cc ep)
                                             (CcWrittenValue [n]
                                                             (= n
                                                                (c-convention)))
                                             (_ false))]
                                     (unless explicit-c
                                       (store! good false)
                                       0)
                                     (unless (is-c-ident cname)
                                       (generated-error name
                                                        "generated exports require a valid C identifier as their linker name")
                                       (store! good false)
                                       0)
                                     (for [si 0 (len (load symbols))]
                                       (when (= (get (load symbols) si) cname)
                                         (generated-error name
                                                          "two interface bindings cannot own the same linker symbol")
                                         (store! good false)
                                         0)
                                       0)
                                     (push! (mut symbols) cname)
                                     (push-str! (mut suffix) "\n(export-c [")
                                     (push-str! (mut suffix) symbol)
                                     (push-str! (mut suffix) " :as ")
                                     (unless (generated-name? symbol)
                                       (store! good false)
                                       0)
                                     (generated-quoted! (mut suffix) cname)
                                     (push-str! (mut suffix)
                                                "])\n(extern __generated_interface_check_")
                                     (push-str! (mut suffix) (i64->str a i))
                                     (push-str! (mut suffix)
                                                " :cc (coil.cc.C) ")
                                     (push-str! (mut suffix)
                                                (subslice source
                                                          (.lo params)
                                                          (.hi params)))
                                     (push-str! (mut suffix) " ")
                                     (if (and (= (sx-tag result) 6)
                                              (= (sx-len (sx-items result)) 2))
                                         (push-str! (mut suffix)
                                                    (subslice source
                                                              (.lo result)
                                                              (.hi result)))
                                         (store! good false))
                                     (push-str! (mut suffix) ")\n"))))
                           (or (= head "defstruct") (= head "defsum"))
                             (do
                               ; Concrete declarations only: generic parameter lists
                               ; introduce bare symbols, unlike field/variant records.
                               (when (and (> (sx-len items) 2)
                                          (= (sx-tag (sx-at items 2)) 7))
                                 (let [fields (sx-items (sx-at items 2))]
                                   (when (and (> (sx-len fields) 0)
                                              (= (sx-tag (sx-at fields 0)) 2))
                                     (store! good false)
                                     0))
                                 0)
                               (push-str! (mut prefix)
                                          (subslice source
                                                    (.lo form)
                                                    (.hi form)))
                               (push-str! (mut prefix) "\n"))
                           (= head "export") 0
                           :else (store! good false)))))
             0)
           (unless (and (load good) (= (load modules) 1))
             (generated-error name
                              "interface must declare its module and contain only concrete types, exports, explicit extern :cc (coil.cc.C) declarations, and imports of already registered generated interfaces; bodies, generics, and transforms belong in an implementation")
             0)
           (and (load good) (= (load modules) 1))))))

(defn generated-unit-collector-cell [] (-> (ptr (ptr GeneratedUnitCollector)))
  (primitive/alloc-static (ptr GeneratedUnitCollector)))

(defn generated-unit-accepting! [(active bool)] (-> i64)
  (let [c (load (generated-unit-collector-cell))]
    (unless (= (primitive/cast i64 c) 0) (set! (.active c) (if active 1 0)) 0)
    0))

(defn collect-generated-unit [(raw (ptr i8))
                              (name-data (ptr u8))
                              (name-len i64)
                              (interface-data (ptr u8))
                              (interface-len i64)
                              (source-data (ptr u8))
                              (source-len i64)] (-> i64)
  (let [(mut arena) (zeroed scratch/ScratchArena)
        _init
          (scratch/ScratchArena::init-with-capacity (mut arena)
                                                    (large-pages/compiler-scratch-parent)
                                                    65536)
        a (allocator (mut arena))
        c (primitive/cast (ptr GeneratedUnitCollector) raw)
        name (slice::new name-data name-len)
        interface (slice::new interface-data interface-len)
        source (slice::new source-data source-len)
        result (collect-generated-unit-owned c a name interface source)]
    (close! (mut arena))
    result))

(defn collect-generated-unit-owned [(c (ptr GeneratedUnitCollector))
                                    (a (dyn Allocator))
                                    (name (slice u8))
                                    (interface (slice u8))
                                    (source (slice u8))] (-> i64)
  (block :submit
    (when (.compiling c)
      (return-from
        :submit
          (generated-error name
                           "nested generation is not supported; register all module interfaces and bodies in the owning reader")))
    (when (= (.active c) 0)
      (return-from
        :submit
          (generated-error name
                           "submission is only valid while a source reader is running")))
    (when (or (= (.mode c) 4) (wasm-target? (.target c)))
      (return-from
        :submit
          (generated-error name
                           "generated modules require a native relocatable-object target; wasm partition linking is not implemented")))
    (unless (and (generated-name? name)
                 (and (> (len source) 0) (> (len interface) 0)))
      (return-from
        :submit
          (generated-error name
                           "expected a valid module namespace and nonempty interface and implementation")))
    (let [(mut symbols) (ArrayList::new [(slice u8)] a)
          (mut prefix) (StrBuf::new a)
          (mut suffix) (StrBuf::new a)]
      (push-str! (mut prefix)
                 "(import \"coil.primitive\" :as primitive)\n")
      (unless (generated-interface a
                                   c
                                   name
                                   interface
                                   (mut symbols)
                                   (mut prefix)
                                   (mut suffix))
        (return-from :submit 0))
      (let [body
              (sconcat3 a
                        source
                        "\n"
                        (sconcat a
                                 (str (load prefix))
                                 (str (load suffix))))]
        (for [i 0 (len (.units c))]
          (let [prior (elem (field c units) i)]
            (when (= (.name prior) name)
              (if (and (= (.interface prior) interface)
                       (= (.body prior) body))
                  (return-from :submit 1)
                  (return-from
                    :submit
                      (generated-error name
                                       "conflicting interface or implementation for an already registered module")))))
          0)
        (match (generated-symbols/owners-claim! (generated-symbol-owners c)
                                                name
                                                (mut symbols))
          (Err [d]
               (let [diag d]
                 (return-from :submit (generated-error name (.msg diag)))))
          (Ok [_] 0))
        (let [root-a (.a c)
              owned-interface (sconcat (malloc-allocator) interface "")
              owned-body (sconcat (malloc-allocator) body "")
              (mut owned-symbols) (ArrayList::new [(slice u8)] root-a)]
          (for [si 0 (len (load symbols))]
            (push! (mut owned-symbols)
                   (sconcat root-a (get (load symbols) si) ""))
            0)
          (push! (mut (.units c))
                 (GeneratedUnit
                   :name (sconcat root-a name "")
                   :interface owned-interface
                   :body owned-body
                   :symbols (load owned-symbols)))
          (push! (mut (.virtuals c))
                 (VirtualSource
                   :name (sconcat root-a name "")
                   :source
                     (Resolved
                       :text owned-interface
                       :incdir (cwd-slice root-a)
                       :disp (sconcat3 root-a "<generated-interface:" name ">"))))
          1)))))

(defstruct GeneratedInterfaceForm
  [(module (slice u8))
   (form Sexp)
   (whole-module bool)])

(defn generated-declaration-name [(form Sexp)] (-> (slice u8))
  (if (and (= (sx-tag form) 6) (> (sx-len (sx-items form)) 1))
      (sx-sval (sx-at (sx-items form) 1))
      ""))

(defn generated-type-declaration? [(form Sexp)] (-> bool)
  (and (= (sx-tag form) 6)
       (and (> (sx-len (sx-items form)) 1)
            (let [head (sx-sval (sx-at (sx-items form) 0))]
              (or (= head "defstruct") (= head "defsum"))))))

(defn generated-interface-snapshot [(a (dyn Allocator)) (s (mut LS))]
  (-> (ptr (ArrayList GeneratedInterfaceForm)))
  (let [collector (load (generated-unit-collector-cell))
        (mut modules) (ArrayList::new [(slice u8)] a)
        (mut owner-types) (ArrayList::new [(slice u8)] a)
        (mut out) (ArrayList::new [GeneratedInterfaceForm] a)]
    (when (.active (generated-owner))
      (try (let [forms (try-or! (read-all a (.interface (generated-owner)) 0) 0)]
             (for [i 0 (len (load forms))]
               (let [form (get (load forms) i)]
                 (when (generated-type-declaration? form)
                   (push! (mut owner-types) (generated-declaration-name form))
                   0))
               0)))
      0)
    (unless (= (primitive/cast i64 collector) 0)
      (for [i 0 (len (.out s))]
        (let [tf (elem (field s out) i)]
          ; Source spans may be rebased by the reader. Session ownership is the
          ; registered namespace, not the current syntax node's source id.
          (match (.module tf)
            (Some [name]
                  (when (and (not (and (.active (generated-owner))
                                       (= name (.name (generated-owner)))))
                             (generated-interface-import? collector name))
                    (unless (set-contains (mut modules) name)
                      (push! (mut modules) name)
                      0)))
            (None [] 0)))
        0)
      (for [i 0 (len (.out s))]
        (let [tf (elem (field s out) i)]
          (match (.module tf)
            (Some [name]
                  (when (set-contains (mut modules) name)
                    (push! (mut out)
                           (GeneratedInterfaceForm
                             :module name
                             :form (sexp-own-into a (field tf form))
                             :whole-module true))
                    0)
                  ; The owner's implementation is writable, but the type declarations
                  ; and compiler-generated signature witnesses implementing its public
                  ; interface are not. Protect them through every transform phase too.
                  (when (and (.active (generated-owner))
                             (= name (.name (generated-owner))))
                    (let [local (generated-declaration-name (.form tf))]
                      (when (or (set-contains (mut owner-types) local)
                                (starts-with local
                                             "__generated_interface_check_"))
                        (push! (mut out)
                               (GeneratedInterfaceForm
                                 :module name
                                 :form (sexp-own-into a (field tf form))
                                 :whole-module false))
                        0))
                    0))
            (None [] 0)))
        0)
      0)
    (box-al [GeneratedInterfaceForm] a (load out))))

(defn generated-interfaces-unchanged? [(a (dyn Allocator))
                                       (s (mut LS))
                                       (snapshot (ptr (ArrayList GeneratedInterfaceForm)))]
  (-> bool)
  (let [(mut good) true
        (mut actual) 0
        (mut consumed) (ArrayList::new [bool] a)]
    (for [j 0 (len (load snapshot))] (push! (mut consumed) false) 0)
    (for [i 0 (len (.out s))]
      (let [tf (elem (field s out) i)
            (mut interface) false
            (mut found) false]
        (for [j 0 (len (load snapshot))]
          (let [prior (elem snapshot j)]
            (when (and (= (.module prior)
                          (match (.module tf) (Some [name] name) (None [] "")))
                       (or (.whole-module prior)
                           (= (generated-declaration-name (.form prior))
                              (generated-declaration-name (.form tf)))))
              (set! interface true)
              (when (and (not (load found))
                         (and (not (get (load consumed) j))
                              (sexp-eq (.form prior) (.form tf))))
                (set! found true)
                (set! (elem (mut consumed) j) true)
                0))
            0)
          0)
        (when (load interface)
          (set! actual (+ (load actual) 1))
          (unless (load found) (set! good false) 0))
        0)
      0)
    (and (load good) (= (load actual) (len (load snapshot))))))

; Collect every runtime reference, including references in initializers and
; cleanup regions. Static storage in an imported implementation cannot silently
; acquire one copy per generated module; it needs an explicit owning interface.
(defn generated-exprs [(es (ptr (ArrayList Expr)))
                       (refs (mut (ArrayList (slice u8))))] (-> bool)
  (let [(mut storage) false]
    (for [i 0 (len (load es))]
      (when (generated-expr (elem es i) (mut refs))
        (set! storage true)
        0)
      0)
    (load storage)))

(defn generated-expr [(e (ptr Expr)) (refs (mut (ArrayList (slice u8))))]
  (-> bool)
  (match (.kind e)
    (EAlloc [storage _ init symbol]
            (let [nested
                    (if (= (primitive/cast i64 init) 0)
                        false
                        (generated-expr init (mut refs)))]
              (or (= storage 1) nested)))
    (EStaticRef [_] true)
    (ECall [name _ args]
           (do (push! (mut refs) name) (generated-exprs args (mut refs))))
    (ENamedCall [name _ _ args]
                (do (push! (mut refs) name) (generated-exprs args (mut refs))))
    (EFnPtrOf [name] (do (push! (mut refs) name) false))
    (EFnPtrInst [name _] (do (push! (mut refs) name) false))
    (EBorrow [_ x] (generated-expr x (mut refs)))
    (ESpillRef [x] (generated-expr x (mut refs)))
    (EMovePlace [x] (generated-expr x (mut refs)))
    (EIntUnary [_ x] (generated-expr x (mut refs)))
    (ELoad [x] (generated-expr x (mut refs)))
    (EFree [x] (generated-expr x (mut refs)))
    (EErase [_ x] (generated-expr x (mut refs)))
    (ECast [_ x] (generated-expr x (mut refs)))
    (EAscribe [_ x] (generated-expr x (mut refs)))
    (EPattern [pattern-op _ x pattern-index] (generated-expr x (mut refs)))
    (EField [x _] (generated-expr x (mut refs)))
    (EAccessorField [x _] (generated-expr x (mut refs)))
    (EBitGet [x _] (generated-expr x (mut refs)))
    (EMakeSlice [x _ _] (generated-expr x (mut refs)))
    (EBin [_ x y]
          (let [left (generated-expr x (mut refs))
                right (generated-expr y (mut refs))]
            (or left right)))
    (ECmp [_ x y]
          (let [left (generated-expr x (mut refs))
                right (generated-expr y (mut refs))]
            (or left right)))
    (EStore [x y]
            (let [left (generated-expr x (mut refs))
                  right (generated-expr y (mut refs))]
              (or left right)))
    (EInitStore [x y]
                (let [left (generated-expr x (mut refs))
                      right (generated-expr y (mut refs))]
                  (or left right)))
    (EIndex [x y]
            (let [left (generated-expr x (mut refs))
                  right (generated-expr y (mut refs))]
              (or left right)))
    (EBitSet [x _ y]
             (let [left (generated-expr x (mut refs))
                   right (generated-expr y (mut refs))]
               (or left right)))
    (EIf [c t f]
         (let [cc (generated-expr c (mut refs))
               tt (generated-expr t (mut refs))
               ff (generated-expr f (mut refs))]
           (or cc tt ff)))
    (EDo [es] (generated-exprs es (mut refs)))
    (EArrayLit [es] (generated-exprs es (mut refs)))
    (EStaticArray [_ es] (generated-exprs es (mut refs)))
    (ELoop [_ es] (generated-exprs es (mut refs)))
    (ECleanup [body cleanups]
              (let [b (generated-expr body (mut refs))
                    c (generated-exprs cleanups (mut refs))]
                (or b c)))
    (EDefer [cleanup body]
            (let [c (generated-expr cleanup (mut refs))
                  b (generated-exprs body (mut refs))]
              (or c b)))
    (EBreak [_ value]
            (match value
              (Some [x] (generated-expr x (mut refs)))
              (None [] false)))
    (ELet [bindings body]
          (let [(mut storage) (generated-exprs body (mut refs))]
            (for [i 0 (len (load bindings))]
              (when (generated-expr (field (elem bindings i) value)
                                    (mut refs))
                (set! storage true)
                0)
              0)
            (load storage)))
    (EConstruct [_ _ args] (generated-exprs args (mut refs)))
    (ETraitCall [_ name _ args]
                (do (push! (mut refs) name) (generated-exprs args (mut refs))))
    (ELlvmIr [_ args _] (generated-exprs args (mut refs)))
    (EIntrinsic [_ _ args] (generated-exprs args (mut refs)))
    (EVector [_ _ _ args] (generated-exprs args (mut refs)))
    (ECodeOp [_ args] (generated-exprs args (mut refs)))
    (ECallPtr [fp args]
              (let [f (generated-expr fp (mut refs))
                    a (generated-exprs args (mut refs))]
                (or f a)))
    (EMakeDyn [_ _ methods inner]
              (do
                (for [i 0 (len (load methods))]
                  (push! (mut refs) (get (load methods) i))
                  0)
                (generated-expr inner (mut refs))))
    (EDynDispatch [dc]
                  (let [receiver (.recv dc)
                        args (.args dc)]
                    (let [r (generated-expr receiver (mut refs))
                          a (generated-exprs args (mut refs))]
                      (or r a))))
    (EMatch [scrut arms]
            (let [(mut storage) (generated-expr scrut (mut refs))]
              (for [i 0 (len (load arms))]
                (when (generated-expr (field (elem arms i) body)
                                      (mut refs))
                  (set! storage true)
                  0)
                0)
              (load storage)))
    (EFieldMeta [_ _ x] (generated-expr x (mut refs)))
    (EFieldIndex [_ x] (generated-expr x (mut refs)))
    (EAnonFn [_ body] (generated-exprs body (mut refs)))
    (_ false)))

(defn generated-runtime-contract [(a (dyn Allocator)) (p (ptr Program))]
  (-> bool)
  (if (not (.active (generated-owner)))
      true
      (block
        :validate
          (let [owner (.name (generated-owner))
                functions (.funcs p)
                (mut interface-symbols) (ArrayList::new [(slice u8)] a)
                (mut interface-link-names) (ArrayList::new [(slice u8)] a)
                (mut interface-witnesses) (ArrayList::new [(slice u8)] a)
                (mut work) (ArrayList::new [(slice u8)] a)
                (mut seen) (ArrayList::new [(slice u8)] a)
                (mut kept) (ArrayList::new [Func] a)
                (mut i) 0]
            ; Registration already validated this session-owned interface. Re-read
            ; its declaration index without re-running ordered registration inside
            ; a worker, which has no mutable submission collection of its own.
            (match (read-all a (.interface (generated-owner)) 0)
              (Err [_] (return-from :validate false))
              (Ok [forms]
                  (for [fi 0 (len (load forms))]
                    (let [form (get (load forms) fi)]
                      (when (and (= (sx-tag form) 6)
                                 (= (sx-sval (sx-at (sx-items form) 0))
                                    "extern"))
                        (push! (mut interface-symbols)
                               (sx-sval (sx-at (sx-items form) 1)))
                        (match (generated-extern a form)
                          (Err [_] (return-from :validate false))
                          (Ok [decl]
                              (push! (mut interface-link-names)
                                     (extern-link-name (box! a Extern decl)))))
                        (push! (mut interface-witnesses)
                               (sconcat a
                                        "__generated_interface_check_"
                                        (i64->str a fi)))
                        0))
                    0)))
            (for [fi 0 (len (load functions))]
              (let [f (elem functions fi)]
                (when (= (before-last-dot (.name f)) owner)
                  (push! (mut work) (.name f))
                  0))
              0)
            (for [ei 0 (len (load (.exports p)))]
              (let [ex (elem (.exports p) ei)]
                ; An unpublished entry is a fnptr-of target, not a C symbol.
                (when (.published ex)
                  (unless (= (before-last-dot (.name ex)) owner)
                    (generated-error owner
                                     "an imported implementation exports a C symbol; move it into an explicitly owned generated interface")
                    (return-from :validate false))
                  (let [(mut declared) false]
                    (for [si 0 (len (load interface-symbols))]
                      (let [symbol (get (load interface-symbols) si)]
                        (when (and (= (.name ex)
                                      (sconcat3 a owner "." symbol))
                                   (= (match (.symbol ex)
                                        (Some [alias] alias)
                                        (None [] symbol))
                                      (get (load interface-link-names) si)))
                          (store! declared true)
                          (let [witness (get (load interface-witnesses) si)
                                (mut expected) (primitive/cast (ptr Extern) 0)
                                (mut actual) (primitive/cast (ptr Func) 0)]
                            (for [xi 0 (len (load (.externs p)))]
                              (let [xp (elem (.externs p) xi)]
                                (when (or (= (.name xp) witness)
                                          (= (.name xp)
                                             (sconcat3 a owner "." witness)))
                                  (store! expected xp)
                                  0))
                              0)
                            (for [fi 0 (len (load functions))]
                              (let [fp (elem functions fi)]
                                (when (= (.name fp) (.name ex))
                                  (store! actual fp)
                                  0))
                              0)
                            (let [ep (load expected)
                                  fp (load actual)]
                              (when (or (= (primitive/cast i64 ep) 0)
                                        (= (primitive/cast i64 fp) 0))
                                (generated-error owner
                                                 "generated_interface_check: missing interface witness or exported implementation")
                                (return-from :validate false))
                              ; ExportC keeps the authored C parameter types before
                              ; Coil's internal implicit-reference ABI lowering.
                              (when (or (.variadic ep)
                                        (!= (len (load (.params ep)))
                                            (len (load (.params ex)))))
                                (generated-error owner
                                                 "generated_interface_check: exported C arity differs from its interface")
                                (return-from :validate false))
                              (for [pi 0 (len (load (.params ep)))]
                                (unless (type-eq (elem (.params ep)
                                                       pi)
                                                 (elem (.params ex)
                                                       pi))
                                  (generated-error owner
                                                   "generated_interface_check: exported C parameter type differs from its interface")
                                  (return-from :validate false))
                                0)
                              (unless (type-eq (field ep ret)
                                               (field fp ret))
                                (generated-error owner
                                                 "generated_interface_check: exported C return type differs from its interface")
                                (return-from :validate false))))
                          0))
                      0)
                    (unless (load declared)
                      (generated-error owner
                                       "implementation exports a symbol not owned by its interface; declare every external symbol in the interface")
                      (return-from :validate false))))
                0))
            (for [ci 0 (len (load (.consts p)))]
              (let [constant (elem (.consts p) ci)]
                (when (and (.runtime constant)
                           (!= (before-last-dot (.name constant)) owner))
                  (generated-error owner
                                   "an imported implementation defines runtime storage; expose its single owner through an interface")
                  (return-from :validate false)))
              0)
            (loop (if (>= (load i) (len (load work)))
                      (break)
                      (let [name (get (load work) (load i))]
                        (unless (set-contains (mut seen) name)
                          (push! (mut seen) name)
                          (let [f (prog-fn-find p name)]
                            (unless (= (primitive/cast i64 f) 0)
                              (let [storage
                                      (generated-exprs (.body f)
                                                       (mut work))]
                                (when (and storage
                                           (!= (before-last-dot (.name f))
                                               owner))
                                  (generated-error owner
                                                   (sconcat3 a
                                                             "imported implementation '"
                                                             name
                                                             "' owns static storage; move that state behind an explicitly owned interface"))
                                  (return-from :validate false)))
                              (push! (mut kept) (load f))
                              0))
                          0)
                        (set! i (+ (load i) 1)))))
            (set! (.funcs p) (box-al [Func] a (load kept)))
            true))))

(defn active-source-readers [] (-> (ptr ActiveSourceReaders))
  (field (driver-unit-state) readers))

(defn active-source-reader-for [(module (slice u8))]
  (-> (ptr ActiveSourceReader))
  (let [box (active-source-readers)
        xs (.items box)
        (mut out) (primitive/cast (ptr ActiveSourceReader) 0)]
    (unless (= (primitive/cast i64 xs) 0)
      (for [i 0 (len (load xs))]
        (let [r (get (load xs) i)]
          (when (= (.configured_module r) module) (set! out r) 0))
        0)
      0)
    (load out)))

;;; Free the providers the active readers compiled, their images and cache
;;; arenas, before the readers are switched off.
(defn free-active-reader-engines! [] (-> i64)
  (let [xs (.items (active-source-readers))]
    (unless (= (primitive/cast i64 xs) 0)
      (for [i 0 (len (load xs))]
        (let [build (.build (get (load xs) i))]
          ; the unit kept for readers that reflect on their program
          (unless (or (= (primitive/cast i64 build) 0)
                      (= (primitive/cast i64 (.unit build)) 0))
            (compilation-unit-resume! (.unit build))
            (compilation-unit-leave! (.unit build))
            (set! (.unit build) (primitive/cast (ptr CompilationUnitSession) 0))
            0))
        (let [engine (.engine (get (load xs) i))]
          (unless (= (primitive/cast i64 engine) 0)
            (reader-engine-cache-free! engine)
            ; the readers of a shared setup share one engine
            (for [k 0 (len (load xs))]
              (let [r (get (load xs) k)]
                (when (= (primitive/cast i64 (.engine r))
                         (primitive/cast i64 engine))
                  (set! (.engine r) (primitive/cast (ptr ReaderEngineCache) 0))
                  0))
              0)
            0))
        0)
      0))
  0)

(defn run-reader-with-generated-units [(a (dyn Allocator))
                                       (setup (mut LS))
                                       (program (ptr Program))
                                       (name (slice u8))
                                       (context Sexp)] (-> ReadProviderResult)
  (let [collector (load (generated-unit-collector-cell))
        mark
          (if (= (primitive/cast i64 collector) 0) 0 (len (.units collector)))
        prior-active
          (if (= (primitive/cast i64 collector) 0) 0 (.active collector))
        _accept (generated-unit-accepting! true)
        result (run-read-provider-named a (mut setup) program name context)
        _stop (generated-unit-accepting! (!= prior-active 0))]
    (finish-generated-reader collector mark result)))

(defn finish-generated-reader [(collector (ptr GeneratedUnitCollector))
                               (mark i64)
                               (result ReadProviderResult)]
  (-> ReadProviderResult)
  ; A reader invocation is a transaction. Providers may decline a source or
  ; fail after emitting units; neither outcome may leak partial linker inputs.
  (match result
    (ReadForms [out] (ReadForms out))
    (ReadDefault []
                 (do
                   (unless (= (primitive/cast i64 collector) 0)
                     (generated-rollback! collector mark)
                     0)
                   (ReadDefault)))
    (ReadFailed [d]
                (do
                  (unless (= (primitive/cast i64 collector) 0)
                    (generated-rollback! collector mark)
                    0)
                  (ReadFailed d)))))

;;; D, which stopped reading PATH with PROVIDER-MODULE. One with no span of its
;;; own, raised inside the provider or by compiling it, names the file and reader.
(defn reading-failure [(a (dyn Allocator))
                       (path (slice u8))
                       (provider-module (slice u8))
                       (d Diag)] (-> Diag)
  (if (< (.lo d) 0)
      (derr (sconcat a
                     (sconcat3 a "reading '" path "' with reader '")
                     (sconcat3 a provider-module "': " (.msg d))))
      d))

(defn run-import-reader [(a (dyn Allocator))
                         (target (mut LS))
                         (path (slice u8))
                         (src (slice u8))
                         (sid i64)
                         (provider-module (slice u8))]
  (-> (ptr (ArrayList Sexp)))
  (let [r (active-source-reader-for provider-module)]
    (if (= (primitive/cast i64 r) 0)
        (do
          (ls-set-err! (mut target)
                       (derr (sconcat3 a
                                       "configured reader provider '"
                                       provider-module
                                       "' is not active")))
          (primitive/cast (ptr (ArrayList Sexp)) 0))
        (match (source-readers-ready! a r)
          (Some [d]
                (do
                  (ls-set-err! (mut target)
                               (reading-failure a path provider-module d))
                  (primitive/cast (ptr (ArrayList Sexp)) 0)))
          (None []
                (run-import-reader-ready a
                                         (mut target)
                                         path
                                         src
                                         sid
                                         provider-module
                                         r))))))

(defn run-import-reader-ready [(a (dyn Allocator))
                               (target (mut LS))
                               (path (slice u8))
                               (src (slice u8))
                               (sid i64)
                               (provider-module (slice u8))
                               (r (ptr ActiveSourceReader))]
  (-> (ptr (ArrayList Sexp)))
  (let [(mut saved) (zeroed SemMapsSnap)
        prior-engine (load (reader-engine-cache-cell))]
    (unless (!= (primitive/cast i64 (.artifact r)) 0)
      (sem-maps-save (mut saved))
      (sem-maps-restore (.maps r))
      (set! (reader-engine-cache-cell) (.engine r)))
    (let [run-span (tr/span-begin "reader.import.run-provider")
          result
            (if (!= (primitive/cast i64 (.artifact r)) 0)
                (run-artifact-reader-with-generated-units a
                                                          (.artifact r)
                                                          (read-context-code a
                                                                             path
                                                                             src
                                                                             "import")
                                                          (.code_session_state target))
                (run-reader-with-generated-units a
                                                 (.setup r)
                                                 (.program r)
                                                 (.qualified r)
                                                 (read-context-code a
                                                                    path
                                                                    src
                                                                    "import")))
          _run-end (tr/span-end run-span)]
      (set! (reader-engine-cache-cell) prior-engine)
      (unless (!= (primitive/cast i64 (.artifact r)) 0)
        (sem-maps-save (.maps r))
        (sem-maps-restore (mut saved)))
      (match result
        (ReadDefault []
                     (match (read-all a src sid)
                       (Ok [forms] forms)
                       (Err [d]
                            (do
                              (ls-set-err! (mut target) d)
                              (primitive/cast (ptr (ArrayList Sexp)) 0)))))
        (ReadFailed [d]
                    (do
                      (ls-set-err! (mut target)
                                   (reading-failure a path provider-module d))
                      (primitive/cast (ptr (ArrayList Sexp)) 0)))
        (ReadForms [out]
                   (let [forms (unpack-do (box-sexp a out) a)]
                     ; The committed virtual-source registry is immediately
                     ; visible to this loader without rebuilding its disk index.
                     (stamp-source-list forms sid)
                     (install-reader-hygiene-context! (mut target)
                                                      (.setup r)
                                                      (.definition_module r))
                     forms))))))

(defsum ReaderProviderDiscovery
  (NoReaderProvider [])
  (OneReaderProvider [(provider ReaderProvider)])
  (AmbiguousReaderProviders []))

(defstruct ReaderInvocation
  [(ready i64)
   (paths (ArrayList (slice u8)))
   (texts (ArrayList (slice u8)))
   (args (ArrayList (slice u8)))])

(defn reader-invocation [] (-> (ptr ReaderInvocation))
  (field (driver-unit-state) invocation))

(defn indexed-namespace-path [(s (mut LS)) (name (slice u8))] (-> (slice u8))
  (let [n (len (.namespace_names s))
        (mut out) ""]
    (for [i 0 n]
      (when (= (get (.namespace_names s) i) name)
        (set! out (get (.namespace_paths s) i))
        0))
    (load out)))

(defn provider-in-forms [(forms (ptr (ArrayList Sexp)))]
  (-> (Option ReaderProvider))
  (let [n (sx-len forms)
        (mut out) (None [ReaderProvider])]
    (for [i 0 n]
      (let [f (sx-at forms i)]
        (when (and (= (sx-tag f) 6)
                   (let [items (sx-items f)]
                     (and (= (sx-len items) 3)
                          (and (= (sx-tag (sx-at items 0))
                                  2)
                               (= (sx-sval (sx-at items 0)) "reader-provider")))))
          (let [items (sx-items f)]
            (when (and (= (sx-tag (sx-at items 1)) 4)
                       (= (sx-tag (sx-at items 2)) 2))
              (let [module-node (sx-at items 1)
                    function-node (sx-at items 2)]
                (set! out
                      (Some (ReaderProvider
                              :container ""
                              :module (sx-sval module-node)
                              :function (sx-sval function-node)))))
              0))
          0)))
    (load out)))

(defn discover-reader-provider [(a (dyn Allocator))
                                (s (mut LS))] (-> ReaderProviderDiscovery)
  (let [uses (cli-uses)
        n (len (load uses))
        (mut out) (None [ReaderProvider])
        (mut ambiguous) false]
    (for [i 0 n]
      (let [name (get (load uses) i)
            path (indexed-namespace-path (mut s) name)
            bundled-file (stdlib-file-for-namespace name)
            source
              (if (!= path "")
                  (read-file a (to-cstr a path))
                  (if (!= bundled-file "") (bundled-text a bundled-file) ""))]
        (when (!= source "")
          (try (let [forms (try-or! (read-all a source -1) 0)]
                 (match (provider-in-forms forms)
                   (Some [p]
                         (match (load out)
                           (Some [old]
                                 (let [(mut op) old
                                       (mut np) p]
                                   (unless (and (= (.module op) (.module np))
                                                (= (.function op)
                                                   (.function np)))
                                     (store! ambiguous true)
                                     0)))
                           (None [] (store! out (Some p)))))
                   (None [] 0))))
          0)))
    (if (load ambiguous)
        (AmbiguousReaderProviders)
        (match (load out)
          (Some [p] (OneReaderProvider p))
          (None [] (NoReaderProvider))))))

(defn reader-provider-eq? [(a ReaderProvider) (b ReaderProvider)] (-> bool)
  (let [(mut ap) (: a ReaderProvider)
        (mut bp) (: b ReaderProvider)]
    (and (= (.container ap) (.container bp))
         (and (= (.module ap) (.module bp)) (= (.function ap) (.function bp))))))

;;; All distinct providers declared by the invocation's `--use` modules. Manifest
;;; readers are added to that list by m-apply-uses, so provider discovery remains
;;; ordinary namespace loading and provider source is always read as Coil.
(defn discover-reader-providers [(a (dyn Allocator))
                                 (s (mut LS))]
  (-> (ptr (ArrayList ReaderProvider)))
  (let [(mut out) (ArrayList::new [ReaderProvider] a)
        uses (cli-uses)]
    (for [i 0 (len (load uses))]
      (let [name (get (load uses) i)
            path (indexed-namespace-path (mut s) name)
            bundled-file (stdlib-file-for-namespace name)
            source
              (if (!= path "")
                  (read-file a (to-cstr a path))
                  (if (!= bundled-file "") (bundled-text a bundled-file) ""))]
        (when (!= source "")
          (try (let [forms (try-or! (read-all a source -1) 0)]
                 (match (provider-in-forms forms)
                   (Some [p]
                         (let [(mut pp) (zeroed ReaderProvider)
                               _p (set! pp p)
                               _container
                                 (set! (.container pp) (sconcat a name ""))
                               configured pp
                               (mut seen) false]
                           (for [j 0 (len (load out))]
                             (when (reader-provider-eq? (get (load out) j)
                                                        configured)
                               (set! seen true)
                               0)
                             0)
                           (unless (load seen) (push! (mut out) configured) 0)))
                   (None [] 0))))
          0))
      0)
    (box-al [ReaderProvider] a (load out))))

;;; The read error in reader module `name`'s source, located in that file, or
;;; None when it reads (or is not a project file).
(defn reader-module-read-error [(a (dyn Allocator))
                                (s (mut LS))
                                (name (slice u8))] (-> (Option Diag))
  (let [path (indexed-namespace-path (mut s) name)]
    (if (= path "")
        (None [Diag])
        (let [source (read-file a (to-cstr a path))
              sid (len (.sources s))]
          (register-source! (mut s) path source)
          (match (read-all a source sid)
            (Ok [_] (None [Diag]))
            (Err [d] (Some d)))))))

(defn read-context-code [(a (dyn Allocator))
                         (path (slice u8))
                         (src (slice u8))
                         (kind (slice u8))] (-> Sexp)
  (let [(mut xs) (ArrayList::new [Sexp] a)]
    (push! (mut xs) (mk-sexp (KSym "read-context") -1 -1))
    (push! (mut xs) (mk-sexp (KStr path) -1 -1))
    (push! (mut xs) (mk-sexp (KStr src) -1 -1))
    (push! (mut xs) (mk-sexp (KSym kind) -1 -1))
    (let [b (reader-invocation)
          (mut inputs) (ArrayList::new [Sexp] a)
          (mut args) (ArrayList::new [Sexp] a)]
      (push! (mut inputs) (mk-sexp (KSym "read-inputs") -1 -1))
      (if (= (.ready b) 0)
          (let [(mut one) (ArrayList::new [Sexp] a)]
            (push! (mut one) (mk-sexp (KSym "read-input") -1 -1))
            (push! (mut one) (mk-sexp (KStr path) -1 -1))
            (push! (mut one) (mk-sexp (KStr src) -1 -1))
            (push! (mut one) (mk-sexp (KSym kind) -1 -1))
            (push! (mut inputs)
                   (mk-sexp (KList (box-items a (load one))) -1 -1)))
          (for [i 0 (len (.paths b))]
            (let [(mut one) (ArrayList::new [Sexp] a)]
              (push! (mut one) (mk-sexp (KSym "read-input") -1 -1))
              (push! (mut one) (mk-sexp (KStr (get (.paths b) i)) -1 -1))
              (push! (mut one) (mk-sexp (KStr (get (.texts b) i)) -1 -1))
              (push! (mut one) (mk-sexp (KSym kind) -1 -1))
              (push! (mut inputs)
                     (mk-sexp (KList (box-items a (load one))) -1 -1)))))
      (push! (mut args) (mk-sexp (KSym "reader-args") -1 -1))
      (when (!= (.ready b) 0)
        (for [i 0 (len (.args b))]
          (push! (mut args) (mk-sexp (KStr (get (.args b) i)) -1 -1)))
        0)
      (push! (mut xs) (mk-sexp (KList (box-items a (load inputs))) -1 -1))
      (push! (mut xs) (mk-sexp (KList (box-items a (load args))) -1 -1)))
    ; (read-package MANIFEST): the Coil.toml of the package that owns PATH, so a
    ; reader configured by manifest sections reads its own package's, whoever
    ; imports it. "" outside any project.
    (let [(mut pkg) (ArrayList::new [Sexp] a)
          abs (match (realpath-opt a path) (Some [p] p) (None [] path))]
      (push! (mut pkg) (mk-sexp (KSym "read-package") -1 -1))
      (push! (mut pkg) (mk-sexp (KStr (package-manifest-for a abs)) -1 -1))
      (push! (mut xs) (mk-sexp (KList (box-items a (load pkg))) -1 -1)))
    (mk-sexp (KList (box-items a (load xs))) -1 -1)))

(defn own-form-list [(a (dyn Allocator)) (forms (ptr (ArrayList Sexp)))]
  (-> (ptr (ArrayList Sexp)))
  (let [(mut out) (ArrayList::new [Sexp] a)]
    (for [i 0 (len (load forms))]
      (push! (mut out) (sexp-own-into a (elem forms i)))
      0)
    (box-al [Sexp] a (load out))))

(defstruct PreparedReaderSetup [(state (ptr LS)) (checked (ptr Program))])

;;; D, raised compiling the reader setup SETUP, rendered into its message with its
;;; source frame: its spans are in SETUP's sources, which the program it is
;;; reported in does not share.
(defn reader-setup-diag [(a (dyn Allocator)) (setup (mut LS)) (d Diag)]
  (-> Diag)
  (let [(mut text) (StrBuf::new a)
        w (primitive/alloc-stack Writer)]
    (render-diag (StrBuf::writer w (mut text)) (mut setup) d)
    (Diag :lo -1 :hi -1 :msg (str (load text)) :source 0 :ctxt 0)))

;;; Compile a reader setup from SETUP-SRC. A reader runs in the compiler, so its
;;; setup is compiled for the host, as a cross build's host twin is; what the
;;; reader asks of the target when it runs is answered for the build's target.
(defn prepare-reader-setup [(a (dyn Allocator))
                            (setup-src (slice u8))
                            (cwd (slice u8))
                            (excluded (ptr (ArrayList (slice u8))))
                            (phase-closure bool)]
  (-> (Result PreparedReaderSetup Diag))
  (let [target (host-target-enter!)
        result
          (prepare-reader-setup-for-host a setup-src cwd excluded phase-closure)]
    (target-cell-swap! target)
    result))

(defn prepare-reader-setup-for-host [(a (dyn Allocator))
                                     (setup-src (slice u8))
                                     (cwd (slice u8))
                                     (excluded (ptr (ArrayList (slice u8))))
                                     (phase-closure bool)]
  (-> (Result PreparedReaderSetup Diag))
  (let [setup (box! a LS (zeroed LS))]
    (ls-init! (mut setup) a)
    (set! (.srccount setup) 1)
    (register-source! (mut setup) "<read setup>" setup-src)
    (match (read-all a setup-src 0)
      (Err [d]
           (Err [PreparedReaderSetup Diag] (reader-setup-diag a (mut setup) d)))
      (Ok [forms]
          (do
            (namespace-index-build! (mut setup))
            (let [load-span (tr/span-begin "reader.setup.load-program")]
              (load-program (mut setup) forms cwd)
              (tr/span-end load-span))
            (if (ls-err? (mut setup))
                (Err [PreparedReaderSetup Diag]
                     (reader-setup-diag a (mut setup) (.loaderr setup)))
                (let [expand-span (tr/span-begin "reader.setup.expand")
                      expanded
                        (if phase-closure
                            (expand-stage3-phase-except (mut setup) excluded)
                            (expand-stage3-except (mut setup) excluded))
                      _expand-end (tr/span-end expand-span)]
                  (match expanded
                    (Err [d]
                         (Err [PreparedReaderSetup Diag]
                              (reader-setup-diag a (mut setup) d)))
                    (Ok [_]
                        (let [check-span (tr/span-begin "reader.setup.check")
                              checked-result
                                (run-transforms-and-check a (mut setup))
                              _check-end (tr/span-end check-span)]
                          (match checked-result
                            (Err [d]
                                 (Err [PreparedReaderSetup Diag]
                                      (reader-setup-diag a (mut setup) d)))
                            (Ok [checked]
                                (Ok [PreparedReaderSetup Diag]
                                    (PreparedReaderSetup
                                      :state setup
                                      :checked checked))))))))))))))

(defn configured-readers? [] (-> bool)
  (let [p (unit-getenv c"COIL_READERS")]
    (and (!= (primitive/cast i64 p) 0) (> (len (from-cstr p)) 0))))

;; A provider artifact records normalized semantic inputs, not the raw command
;; string or runtime reader arguments. The latter remain ordinary read-context
;; data and can vary for each application invocation.
(defn reader-artifact-options [(a (dyn Allocator))] (-> (slice u8))
  (let [(mut bytes) (StrBuf::new a)
        environment (compilation-environment a)
        links (meta-link-box)]
    (artifact-wire/wire-put-i64! (mut bytes) (meta-opt-level))
    (artifact-wire/wire-put-i64! (mut bytes) (sanitize-mode))
    (artifact-wire/wire-put-i64! (mut bytes) (if (debug-checks?) 1 0))
    (artifact-wire/wire-put-str! (mut bytes)
                                 (jit-implementation-name (jit-implementation)))
    (for [i 0 (len environment)]
      (let [entry (get environment i)]
        (artifact-wire/wire-put-str! (mut bytes) (from-cstr (.key entry)))
        (artifact-wire/wire-put-i64! (mut bytes)
                                     (if (= (primitive/cast i64 (.value entry))
                                            0)
                                         0
                                         1))
        (unless (= (primitive/cast i64 (.value entry)) 0)
          (artifact-wire/wire-put-str! (mut bytes) (from-cstr (.value entry)))
          0))
      0)
    (artifact-wire/wire-put-names! (mut bytes) (cli-uses))
    (artifact-wire/wire-put-names! (mut bytes)
                                   (if (= (.isset links) 0)
                                       (primitive/cast (ptr (ArrayList (slice u8)))
                                                       0)
                                       (.flags links)))
    (str (load bytes))))

(defn initial-read-artifact [(a (dyn Allocator))
                             (s (mut LS))
                             (src (slice u8))
                             (path (slice u8))] (-> InitialRead)
  (block :read
    (when (or (configured-readers?)
              (> (len (load (discover-reader-providers a (mut s)))) 0))
      (return-from
        :read
          (InitialReadError (derr "--reader-artifact cannot be combined with source reader providers"))))
    (match (load-reader-artifact a)
      (Err [d] (InitialReadError d))
      (Ok [provider]
          (let [metadata (.metadata provider)
                result
                  (run-artifact-reader-with-generated-units a
                                                            provider
                                                            (read-context-code a
                                                                               path
                                                                               src
                                                                               "entry")
                                                            (.code_session_state s))]
            (match result
              (ReadFailed [d] (InitialReadError d))
              (ReadDefault []
                           (match (read-all a src 0)
                             (Err [d] (InitialReadError d))
                             (Ok [forms]
                                 (InitialForms
                                   :forms forms
                                   :reader_state (primitive/cast (ptr LS) 0)
                                   :definition_module ""))))
              (ReadForms [out]
                         (let [forms (unpack-do (box-sexp a out) a)]
                           (stamp-source-list forms 0)
                           (InitialForms
                             :forms forms
                             :reader_state (.setup metadata)
                             :definition_module (.provider metadata))))))))))

(defn load-reader-artifact [(a (dyn Allocator))]
  (-> (Result (ptr artifact/LoadedProvider) Diag))
  (let [state (driver-unit-state)]
    (if (!= (primitive/cast i64 (.loaded_artifact state)) 0)
        (Ok (.loaded_artifact state))
        (match (artifact/provider-open a
                                       (.reader_artifact state)
                                       (reader-artifact-options a))
          (Err [d] (Err [(ptr artifact/LoadedProvider) Diag] d))
          (Ok [provider]
              (set! (.loaded_artifact state)
                    (box! a artifact/LoadedProvider provider))
              (Ok [(ptr artifact/LoadedProvider) Diag] (.loaded_artifact state)))))))

(defn run-artifact-reader-with-generated-units [(a (dyn Allocator))
                                                (provider (ptr artifact/LoadedProvider))
                                                (context Sexp)
                                                (session (ptr i8))]
  (-> ReadProviderResult)
  (let [collector (load (generated-unit-collector-cell))
        mark
          (if (= (primitive/cast i64 collector) 0) 0 (len (.units collector)))
        prior-active
          (if (= (primitive/cast i64 collector) 0) 0 (.active collector))
        _accept (generated-unit-accepting! true)
        result (artifact/provider-invoke a provider context session)
        _restore (generated-unit-accepting! (!= prior-active 0))]
    (finish-generated-reader collector mark result)))

; A unit's object follows the calling convention of the backend that emitted it,
; and Coil's backends do not share one for every aggregate (a slice straddling the
; last argument register, a by-value aggregate over 16 bytes: see the coil-bugs
; report "Shipped prebuilt coil.jit unit crashes source-provider setup"). So a
; unit only ever links into a build that uses the same backend: its key records
; the backend, units are built and found per backend, and a `--unit` built by
; another backend is refused rather than linked.
(defn unit-backend-name [(backend i64)] (-> (slice u8))
  (cond (= backend 1) "llvm"
        (= backend 2) "arm64"
        (= backend 5) "x64"
        (= backend 7) "tpde"
        (= backend 4) "wasm"
        :else "unknown"))

;;; Whether BACKEND is the native one, tpde: `arm64` and `x64` name it for one
;;; architecture, `tpde` for the target's.
(defn native-backend? [(backend i64)] (-> bool)
  (or (= backend 2) (= backend 5) (= backend 7)))

;;; Whether the target has the architecture a native backend's name gives. One
;;; that does not is an error, rather than code for another machine.
(defn native-backend-target-ok? [(backend i64)] (-> bool)
  (let [want (cond (= backend 2) "aarch64" (= backend 5) "x86_64" :else "")
        arch (target-arch-str)]
    (if (or (= (len want) 0) (= want arch))
        true
        (let [w (stderr)]
          (ps w "error: --backend ")
          (ps w (unit-backend-name backend))
          (ps w " compiles for ")
          (ps w want)
          (ps w ", but the target is ")
          (ps w arch)
          (ps w "; pass a --target for it, or use --backend tpde\n")
          false))))

; A C symbol has one owner. When this program links a prebuilt unit that already
; defines an `export-c` symbol -- because the program also compiles, from source,
; a module the unit embeds -- the unit's definition is the one kept.
(defn drop-unit-owned-exports! [(a (dyn Allocator)) (mp (ptr Program))] (-> i64)
  (let [units (prebuilt-units)
        (mut owned) (HashMap::new [(slice u8) i64] a (keyops))]
    (unless (= (primitive/cast i64 units) 0)
      (for [i 0 (len (load units))]
        (let [u (elem units i)
              path (path-join a (.dir u) "unit.cexports")]
          (when (and (.used u)
                     (= (access (to-cstr a path) 0) (: 0 i32)))
            (let [lines (split a (read-file a (to-cstr a path)) "\n")]
              (for [j 0 (len (load lines))]
                (let [symbol (get (load lines) j)]
                  (when (> (len symbol) 0) (set! (mut owned) symbol 0)))))))))
    (when (> (len owned) 0)
      (let [(mut kept) (ArrayList::new [ExportC] a)]
        (for [i 0 (len (load (.exports mp)))]
          (let [e (elem (.exports mp) i)]
            (unless (match (.symbol e)
                      (Some [symbol] (contains? owned symbol))
                      (None [] false))
              (push! (mut kept) (load e)))))
        (set! (.exports mp) (box-al [ExportC] a (load kept)))))
    0))

(defn configured-reader-missing [(a (dyn Allocator))] (-> (slice u8))
  (let [p (unit-getenv c"COIL_READERS")
        (mut missing) ""]
    (unless (= (primitive/cast i64 p) 0)
      (let [cfg (from-cstr p)
            n (len cfg)
            (mut lo) 0]
        (for [i 0 (primitive/iadd n 1)]
          (when (or (= i n) (= (primitive/cast i64 (get cfg i)) 10))
            (let [line (subslice cfg (load lo) i)
                  (mut eq) -1]
              (for [j 0 (len line)]
                (when (= (primitive/cast i64 (get line j)) 61) (set! eq j) 0)
                0)
              (when (> (load eq) 0)
                (let [module
                        (subslice line (primitive/iadd (load eq) 1) (len line))]
                  (when (= (primitive/cast i64
                                           (active-source-reader-for module))
                           0)
                    (set! missing (sconcat a module ""))
                    0)))
              (set! lo (primitive/iadd i 1)))
            0)))
      0)
    (load missing)))

;;; The setup that compiles every configured source provider in PROVIDERS but
;;; the one ARTIFACT supplies (null for none), as one program: providers that
;;; share modules share their compilation. Each provider module is imported
;;; under an alias of its own, so helpers of the same name in two providers never
;;; meet; the import hook dispatches by the provider module selected from the
;;; file suffix.
(defn shared-reader-setup-source [(a (dyn Allocator))
                                  (providers (ptr (ArrayList ReaderProvider)))
                                  (artifact (ptr artifact/LoadedProvider))
                                  (excluded (mut (ArrayList (slice u8))))]
  (-> (slice u8))
  (let [(mut out)
          (StrBuf::new a)
        (mut imported) (ArrayList::new [(slice u8)] a)]
    (push-str! (mut out) "(module coil-read-setup)\n(import \"coil.phase\")\n")
    (for [i 0 (len (load providers))]
      (let [pp (get (load providers) i)
            selected
              (and (!= (primitive/cast i64 artifact) 0)
                   (= (.provider (.metadata artifact)) (.module pp)))
            qual (sconcat3 a (.module pp) "." (.function pp))
            (mut seen) false]
        (for [k 0 (len (load excluded))]
          (when (= (get (load excluded) k) qual) (set! seen true) 0))
        (unless (or selected (load seen))
          (let [(mut alias-index) -1]
            (for [k 0 (len (load imported))]
              (when (= (get (load imported) k) (.module pp))
                (set! alias-index k)
                0))
            (when (< (load alias-index) 0)
              (set! alias-index (len (load imported)))
              (push! (mut imported) (.module pp))
              (push-str! (mut out) "(import \"")
              (push-str! (mut out) (.module pp))
              (push-str! (mut out) "\" :as coil-reader-")
              (push-str! (mut out) (i64->str a (load alias-index)))
              (push-str! (mut out) ")\n")
              0)
            (push! (mut excluded) qual)
            (push-str! (mut out) "(transform coil-reader-")
            (push-str! (mut out) (i64->str a (load alias-index)))
            (push-str! (mut out) "/")
            (push-str! (mut out) (.function pp))
            (push-str! (mut out) " :phase (coil.phase.Read))\n"))
          0)))
    (push-str! (mut out) "(defn main [] (-> i64) 0)\n")
    (finish! (mut out))))

;;; Whether this host runs a compiled reader natively, as a provider artifact
;;; needs: not under the bytecode interpreter or inside wasm.
(defn native-reader-host? [] (-> bool)
  (not (or (meta-wasm-active?) (or (meta-interp-active?) (wasm-sandbox?)))))

(defsum ReaderBuildState
  (ReadersPending [])
  (ReadersBuilt [])
  (ReadersFailed [(diag Diag)]))

;;; The source providers of one compilation, compiled together by the first
;;; reading any of them serves.
(defstruct SourceReaderBuild
  [(setup_src (slice u8))
   (cwd (slice u8))
   ; every source provider's entry: one engine holds them all
   (quals (ptr (ArrayList (slice u8))))
   (maps (ptr SemMapsSnap))
   (engine (ptr ReaderEngineCache))
   (state ReaderBuildState)
   ; the unit that holds the program of readers that reflect on it; null
   ; when no reader does, as then nothing outlives the build
   (unit (ptr CompilationUnitSession))])

;;; Give each reader of BUILD its setup PREPARED, which it compiles its entry
;;; from at its first reading (`run-read-provider-named`).
(defn source-readers-adopt-setup! [(build (ptr SourceReaderBuild))
                                   (prepared PreparedReaderSetup)] (-> i64)
  (let [xs (.items (active-source-readers))
        prep (primitive/alloc-stack PreparedReaderSetup)]
    (set! prep prepared)
    (for [i 0 (len (load xs))]
      (let [r (get (load xs) i)]
        (when (= (primitive/cast i64 (.build r)) (primitive/cast i64 build))
          (set! (.setup r) (load (field prep state)))
          (set! (.program r) (load (field prep checked)))
          0))
      0))
  0)

;;; BUILD's readers compiled with the program they read into, where the program
;;; must keep their setup: the bytecode interpreter's engine lives in the
;;; compilation that built it.
(defn source-readers-build-here! [(a (dyn Allocator))
                                  (build (ptr SourceReaderBuild))]
  (-> (Option Diag))
  (match (prepare-reader-setup a
                               (.setup_src build)
                               (.cwd build)
                               (.quals build)
                               false)
    (Err [d] (Some d))
    (Ok [prepared]
        (do
          (sem-maps-save (.maps build))
          (source-readers-adopt-setup! build prepared)
          (None [Diag])))))

(defsum ReaderUnitOutcome
  ; the readers' native engine is in the build's cache, and IMAGE carries what
  ; they run against out of the unit
  (NativeReaders [(image (slice u8))])
  ; a reader reflects on its program, so the unit stays
  (ReflectingReaders [(prepared PreparedReaderSetup)])
  (ReaderUnitFailed [(diag Diag)]))

;;; Inside the unit allocating with A: compile BUILD's setup and, unless a reader
;;; reflects on its program, every entry into one native engine, which the
;;; build's cache takes. OUTER is the allocator of the compilation outside.
(defn source-readers-compile! [(a (dyn Allocator))
                               (outer (dyn Allocator))
                               (build (ptr SourceReaderBuild))]
  (-> ReaderUnitOutcome)
  (match (prepare-reader-setup a
                               (.setup_src build)
                               (.cwd build)
                               (.quals build)
                               false)
    ; rendered against the setup, but in the unit's memory
    (Err [d]
         (ReaderUnitFailed (Diag :lo -1
                                 :hi -1
                                 :msg (sconcat outer (.msg d) "")
                                 :source 0
                                 :ctxt 0)))
    (Ok [prepared]
        (let [prep (primitive/alloc-stack PreparedReaderSetup)
              scope (primitive/alloc-stack MetaEngineScope)
              prior-optimized (meta-optimized-engine?)]
          (set! prep prepared)
          (set! (.open scope) false)
          (set-meta-optimized-engine! true)
          (meta-engine-scope-enter! scope a)
          (let [setup (load (field prep state))
                outcome
                  (match (artifact/provider-engine-setup! a
                                                          (mut setup)
                                                          (load (field prep checked))
                                                          (.quals build))
                    (Err [d]
                         (ReaderUnitFailed (reader-setup-diag outer (mut setup) d)))
                    (Ok [found]
                        (match found
                          (None [] (ReflectingReaders prepared))
                          (Some [names]
                                (do
                                  (reader-engine-cache-capture! (.engine build)
                                                                scope
                                                                (get (load (.quals build))
                                                                     0))
                                  (NativeReaders (artifact-wire/wire-put-reader-image outer
                                                                                      setup
                                                                                      names)))))))]
            (meta-engine-scope-leave! scope)
            (set-meta-optimized-engine! prior-optimized)
            outcome)))))

;;; Give each reader of BUILD the provider IMAGE describes, the entry of its own
;;; in the build's engine: a reading calls it as it calls a provider artifact.
(defn source-readers-adopt-image! [(a (dyn Allocator))
                                   (build (ptr SourceReaderBuild))
                                   (image artifact-wire/ReaderImage)]
  (-> (Option Diag))
  (let [xs (.items (active-source-readers))
        entries (.entries (.engine build))
        (mut problem) (None [Diag])]
    (for [i 0 (len (load xs))]
      (let [r (get (load xs) i)]
        (when (= (primitive/cast i64 (.build r)) (primitive/cast i64 build))
          (let [(mut entry) (primitive/cast (ptr MEEntry) 0)]
            (for [k 0 (len (load entries))]
              (when (= (.name (elem entries k)) (.qualified r))
                (set! entry (elem entries k))
                0)
              0)
            (if (= (primitive/cast i64 (load entry)) 0)
                (set! problem
                      (Some (derr (sconcat3 a
                                            "read phase: provider '"
                                            (.qualified r)
                                            "' has no compiled entry"))))
                (let [m (box! a
                              artifact-wire/ProviderMetadata
                              (zeroed artifact-wire/ProviderMetadata))]
                  (set! (.provider m) (.definition_module r))
                  (set! (.entry m) (.qualified r))
                  (set! (.setup m) (.setup image))
                  (set! (.names m) (.names image))
                  (set! (.registry m) (.registry (load entry)))
                  (set! (.setup r) (.setup image))
                  (set! (.artifact r)
                        (box! a
                              artifact/LoadedProvider
                              (artifact/LoadedProvider :metadata m
                                                       :fp (.fp (load entry))))))))
          0))
      0)
    (load problem)))

;;; Compile BUILD's readers in a unit of their own, so their setup is freed when
;;; the engine is built. Node ids, hygiene marks and form ids continue across the
;;; unit, so the syntax it made never collides with this compilation's.
(defn source-readers-build-native! [(a (dyn Allocator))
                                    (build (ptr SourceReaderBuild))]
  (-> (Option Diag))
  (let [outer-node (.n (node-id-cell))
        outer-gensym (.n (gensym-cell))
        outer-form (.form_id (loader-unit-state))
        config (box! a CompilationUnitConfig (compilation-unit-config a))
        scope
          (box! a CompilationUnitSession (zeroed CompilationUnitSession))
        ua
          (compilation-unit-enter! scope
                                   config
                                   (primitive/cast (ptr (ArrayList VirtualSource))
                                                   0)
                                   false
                                   "unit.reader")
        _ids
          (do
            (set! (.n (node-id-cell)) outer-node)
            (set! (.n (gensym-cell)) outer-gensym)
            (set! (.form_id (loader-unit-state)) outer-form)
            0)
        span (tr/span-begin "reader.unit")
        outcome (source-readers-compile! ua a build)
        _end (tr/span-end span)
        inner-node (.n (node-id-cell))
        inner-gensym (.n (gensym-cell))
        inner-form (.form_id (loader-unit-state))]
    (match outcome
      (ReflectingReaders [prepared]
                         (let [prep (primitive/alloc-stack PreparedReaderSetup)]
                           (set! prep prepared)
                           (let [setup (load (field prep state))]
                             ; what reading against this unit's program from
                             ; outside it needs, as a session's provider unit
                             (set! (.checked setup) (load (field prep checked)))
                             (set! (.resolution_state setup) (ast-unit-state))
                             (sem-maps-save (.maps build))
                             (set! (.semantic_maps setup)
                                   (primitive/cast (ptr i8) (.maps build)))
                             (compilation-unit-suspend! scope)
                             (set! (.unit build) scope)
                             0)))
      (_ (compilation-unit-leave! scope)))
    (set! (.n (node-id-cell)) (library-state-later outer-node inner-node))
    (set! (.n (gensym-cell)) (library-state-later outer-gensym inner-gensym))
    (set! (.form_id (loader-unit-state))
          (library-state-later outer-form inner-form))
    (match outcome
      (ReaderUnitFailed [d] (Some d))
      (ReflectingReaders [prepared]
                         (do
                           (tr/count "reader.unit.kept" 1)
                           (source-readers-adopt-setup! build prepared)
                           (None [Diag])))
      (NativeReaders [bytes]
                     (do
                       (tr/count "reader.unit.released" 1)
                       (match (artifact-wire/wire-reader-image a bytes)
                         (Err [d] (Some d))
                         (Ok [image] (source-readers-adopt-image! a build image))))))))

;;; Compile R's providers if this is the first reading any of them serves: the
;;; problem that stops them, which every later reading reports too.
(defn source-readers-ready! [(a (dyn Allocator)) (r (ptr ActiveSourceReader))]
  (-> (Option Diag))
  (let [build (.build r)]
    (if (= (primitive/cast i64 build) 0)
        (None [Diag])
        (match (.state build)
          (ReadersBuilt [] (None [Diag]))
          (ReadersFailed [d] (Some d))
          (ReadersPending []
                          (let [problem
                                  (if (native-reader-host?)
                                      (source-readers-build-native! a build)
                                      (source-readers-build-here! a build))]
                            (match problem
                              (Some [d] (set! (.state build) (ReadersFailed d)))
                              (None [] (set! (.state build) (ReadersBuilt))))
                            problem))))))

;;; Switch on every configured reader. The source providers are compiled at the
;;; first reading, all together (`source-readers-ready!`); a provider artifact
;;; supplies its own.
(defn activate-configured-readers [(a (dyn Allocator))
                                   (state (mut LS))
                                   (cwd (slice u8))] (-> (Result i64 Diag))
  (block
    :activate
      (let [providers (discover-reader-providers a (mut state))
            artifact
              (if (= (len (.reader_artifact (driver-unit-state))) 0)
                  (primitive/cast (ptr artifact/LoadedProvider) 0)
                  (match (load-reader-artifact a)
                    (Err [d] (return-from :activate (Err [i64 Diag] d)))
                    (Ok [loaded] loaded)))
            (mut artifact-used) false
            (mut active) (ArrayList::new [(ptr ActiveSourceReader)] a)
            (mut excluded) (ArrayList::new [(slice u8)] a)
            setup-src
              (shared-reader-setup-source a providers artifact (mut excluded))
            ; null when an artifact supplies every provider
            build
              (if (= (len (load excluded)) 0)
                  (primitive/cast (ptr SourceReaderBuild) 0)
                  (let [quals (box-al [(slice u8)] a (load excluded))
                        engine (reader-engine-cache-new a)]
                    (set! (.together engine) quals)
                    (box! a
                          SourceReaderBuild
                          (SourceReaderBuild
                            :setup_src setup-src
                            :cwd (sconcat a cwd "")
                            :quals quals
                            :maps (box! a SemMapsSnap (zeroed SemMapsSnap))
                            :engine engine
                            :state (ReadersPending)
                            :unit (primitive/cast (ptr CompilationUnitSession)
                                                  0)))))]
        (set! (.items (active-source-readers))
              (box-al [(ptr ActiveSourceReader)] a (load active)))
        (for [i 0 (len (load providers))]
          (let [(mut pp) (zeroed ReaderProvider)
                _p (set! pp (get (load providers) i))
                qual (sconcat3 a (.module pp) "." (.function pp))
                selected
                  (and (!= (primitive/cast i64 artifact) 0)
                       (= (.provider (.metadata artifact)) (.module pp)))
                r (box! a ActiveSourceReader (zeroed ActiveSourceReader))]
            (when (and selected (!= (.entry (.metadata artifact)) qual))
              (return-from
                :activate
                  (Err [i64 Diag]
                       (derr "provider artifact entry does not match configured reader-provider"))))
            (set! (.configured_module r) (sconcat a (.container pp) ""))
            (set! (.definition_module r) (sconcat a (.module pp) ""))
            (set! (.qualified r) qual)
            (if selected
                (do
                  (set! artifact-used true)
                  (set! (.setup r) (.setup (.metadata artifact)))
                  (set! (.artifact r) artifact)
                  (set! (.maps r) (box! a SemMapsSnap (zeroed SemMapsSnap))))
                (do
                  ; the readers of the shared setup read through one set of
                  ; maps and one engine, as one program
                  (set! (.build r) build)
                  (set! (.maps r) (.maps build))
                  (set! (.engine r) (.engine build))))
            (push! [(ptr ActiveSourceReader)] (mut active) r)
            (set! (.items (active-source-readers))
                  (box-al [(ptr ActiveSourceReader)] a (load active)))
            0)
          0)
        (when (and (!= (primitive/cast i64 artifact) 0)
                   (not (load artifact-used)))
          (return-from
            :activate
              (Err [i64 Diag]
                   (derr "provider artifact does not match any configured reader-provider"))))
        (let [missing (configured-reader-missing a)]
          (if (> (len missing) 0)
              (Err [i64 Diag]
                   ; A provider module that does not even read has no
                   ; declarations at all: its syntax error is the problem.
                   (match (reader-module-read-error a (mut state) missing)
                     (Some [d] d)
                     (None []
                           (derr (sconcat3 a
                                           "[readers] provider module '"
                                           missing
                                           "' does not declare a reader-provider")))))
              (do
                (set-source-reader-hook! (fnptr-of run-import-reader))
                (Ok [i64 Diag] 0)))))))

(defn run-prepared-reader [(a (dyn Allocator))
                           (prepared PreparedReaderSetup)
                           (provider-module (slice u8))
                           (name (slice u8))
                           (context Sexp)
                           (src (slice u8))] (-> InitialRead)
  (let [prep (primitive/alloc-stack PreparedReaderSetup)]
    (set! prep prepared)
    (let [setup (load (field prep state))
          checked (load (field prep checked))
          _accept-generated (generated-unit-accepting! true)
          result
            (run-reader-with-generated-units a (mut setup) checked name context)
          _stop-generated (generated-unit-accepting! false)]
      (match result
        (ReadDefault []
                     (match (read-all a src 0)
                       (Ok [forms]
                           (InitialForms
                             :forms forms
                             :reader_state (primitive/cast (ptr LS) 0)
                             :definition_module ""))
                       (Err [d] (InitialReadError d))))
        (ReadFailed [d] (InitialReadError d))
        (ReadForms [out]
                   (let [op (box-sexp a out)
                         forms (unpack-do op a)]
                     (stamp-source-list forms 0)
                     (InitialForms
                       :forms forms
                       :reader_state setup
                       :definition_module provider-module)))))))

;;; Reader providers are compiled as an isolated, ordinary Coil setup. In
;;; particular, the provider graph is always bootstrapped with the default reader.
(defn initial-read [(a (dyn Allocator))
                    (state (mut LS))
                    (src (slice u8))
                    (path (slice u8))
                    (cwd (slice u8))] (-> InitialRead)
  (do
    (namespace-index-build! (mut state))
    (cond (.unit_pretransformed (driver-unit-state))
            (match (read-all a src 0)
              (Ok [forms]
                  (InitialForms
                    :forms forms
                    :reader_state (primitive/cast (ptr LS) 0)
                    :definition_module ""))
              (Err [d] (InitialReadError d)))
          (.active (generated-owner))
            ; Generated bodies are already decoded Coil. Input reader selection
            ; is not a semantic transform and must not compile a provider here.
            (match (read-all a src 0)
              (Ok [forms]
                  (InitialForms
                    :forms forms
                    :reader_state (primitive/cast (ptr LS) 0)
                    :definition_module ""))
              (Err [d] (InitialReadError d)))
          (and (> (len (.reader_artifact (driver-unit-state))) 0)
               (not (configured-readers?)))
            (initial-read-artifact a (mut state) src path)
          (configured-readers?)
            (match (activate-configured-readers a (mut state) cwd)
              (Err [d] (InitialReadError d))
              (Ok [_]
                  (if (> (len (.unit_out (driver-unit-state))) 0)
                      (let [provider (configured-reader-module a path)
                            forms
                              (run-import-reader a
                                                 (mut state)
                                                 path
                                                 src
                                                 0
                                                 provider)
                            reader (active-source-reader-for provider)]
                        (if (= (primitive/cast i64 forms) 0)
                            (InitialReadError (.loaderr state))
                            (InitialForms
                              :forms forms
                              :reader_state (.setup reader)
                              :definition_module provider)))
                      ; Project entries remain ordinary Coil. build-unit is the one
                      ; command whose entry may itself be a foreign source module.
                      (match (read-all a src 0)
                        (Ok [forms]
                            (InitialForms
                              :forms forms
                              :reader_state (primitive/cast (ptr LS) 0)
                              :definition_module ""))
                        (Err [d] (InitialReadError d))))))
          :else
            (match (discover-reader-provider a (mut state))
              (AmbiguousReaderProviders []
                                        (InitialReadError (derr "reader-provider: more than one --use module declares a reader provider")))
              (NoReaderProvider []
                                (let [request (reader-invocation)]
                                  (if (and (!= (.ready request)
                                               0)
                                           (> (len (.paths request))
                                              1))
                                      (InitialReadError (derr "multiple input files require exactly one registered read provider"))
                                      (match (read-all a src 0)
                                        (Ok [forms]
                                            (InitialForms
                                              :forms forms
                                              :reader_state
                                                (primitive/cast (ptr LS) 0)
                                              :definition_module ""))
                                        (Err [d] (InitialReadError d))))))
              (OneReaderProvider [provider]
                                 (let [(mut pp) (zeroed ReaderProvider)
                                       _provider (set! pp provider)
                                       qual (sconcat3 a (.module pp) "." (.function pp))
                                       _phase-owner (push! (mut (.stage_excluded state)) qual)
                                       setup-src
                                         (sconcat3 a
                                                   "(module coil-read-setup)\n(import \"coil.phase\")\n(import \""
                                                   (.module pp)
                                                   (sconcat3 a
                                                             "\" :use *)\n(transform "
                                                             (.function pp)
                                                             " :phase (coil.phase.Read))\n(defn main [] (-> i64) 0)\n"))
                                       (mut excluded) (ArrayList::new [(slice u8)] a)]
                                   ; The driver already knows the exact invocation-time entry: no call site
                                   ; runs it as a macro, though its body is metaprogram code like any other.
                                   (push! (mut excluded) qual)
                                   (match (prepare-reader-setup a
                                                                setup-src
                                                                cwd
                                                                (box-al [(slice u8)] a (load excluded))
                                                                false)
                                     (Err [d] (InitialReadError d))
                                     (Ok [prepared]
                                         (let [prep (primitive/alloc-stack PreparedReaderSetup)
                                               _prep (set! prep prepared)
                                               setup (load (field prep state))
                                               checked (load (field prep checked))]
                                           (let [active
                                                   (box! a
                                                         ActiveSourceReader
                                                         (zeroed ActiveSourceReader))
                                                 maps
                                                   (box! a
                                                         SemMapsSnap
                                                         (zeroed SemMapsSnap))
                                                 (mut items)
                                                   (ArrayList::new [(ptr ActiveSourceReader)]
                                                                   a)]
                                             (set! (.configured_module active)
                                                   (.module pp))
                                             (set! (.definition_module active)
                                                   (.module pp))
                                             (set! (.setup active)
                                                   setup)
                                             (set! (.program active)
                                                   checked)
                                             (set! (.qualified active)
                                                   qual)
                                             (sem-maps-save maps)
                                             (set! (.maps active)
                                                   maps)
                                             (push! [(ptr ActiveSourceReader)]
                                                    (mut items)
                                                    active)
                                             (set! (.items (active-source-readers))
                                                   (box-al [(ptr ActiveSourceReader)]
                                                           a
                                                           (load items)))
                                             (set-source-reader-hook! (fnptr-of run-import-reader))
                                             (match (run-reader-with-generated-units a
                                                                                     (mut setup)
                                                                                     checked
                                                                                     qual
                                                                                     (read-context-code a
                                                                                                        path
                                                                                                        src
                                                                                                        "entry"))
                                               (ReadDefault []
                                                            (match (read-all a
                                                                             src
                                                                             0)
                                                              (Ok [forms]
                                                                  (InitialForms
                                                                    :forms
                                                                      forms
                                                                    :reader_state
                                                                      (primitive/cast (ptr LS)
                                                                                      0)
                                                                    :definition_module
                                                                      ""))
                                                              (Err [d]
                                                                   (InitialReadError d))))
                                               (ReadFailed [d]
                                                           (InitialReadError d))
                                               (ReadForms [out]
                                                          (let [op
                                                                  (box-sexp a
                                                                            out)
                                                                forms
                                                                  (unpack-do op
                                                                             a)]
                                                            (stamp-source-list forms
                                                                               0)
                                                            (InitialForms
                                                              :forms
                                                                forms
                                                              :reader_state
                                                                setup
                                                              :definition_module
                                                                (.module pp)))))))))))))))

; Internal project-test handoff. A bare `coil test` discovers roots once, writes
; their NUL-delimited paths to this file, and asks one ordinary build to load all
; of them into the same compiler state. Keeping the handoff out of the public
; source language avoids manufacturing a concatenated source file (which loses
; filenames, relative include bases, and module isolation).
(defstruct TestRootsFileBox [(path (slice u8))])

(defn test-roots-file-box [] (-> (ptr TestRootsFileBox))
  (field (driver-unit-state) test_roots))

(defn set-test-roots-file! [(path (slice u8))] (-> i64)
  (set! (.path (test-roots-file-box)) path)
  0)

(defn test-roots-file [] (-> (slice u8))
  (.path (test-roots-file-box)))

; Whether two paths name one file.
(defn same-file? [(a (dyn Allocator)) (x (slice u8)) (y (slice u8))] (-> bool)
  (or (= x y)
      (match (realpath-opt a x)
        (None [] false)
        (Some [rx]
              (match (realpath-opt a y)
                (None [] false)
                (Some [ry] (= rx ry)))))))

; A file other than `path` that declares module `name`: an earlier test root (in
; `names`/`paths`), else a file the namespace index found declaring it. None when
; every such file is `path` itself.
(defn other-module-file [(a (dyn Allocator))
                         (s (mut LS))
                         (names (ArrayList (slice u8)))
                         (paths (ArrayList (slice u8)))
                         (name (slice u8))
                         (path (slice u8))] (-> (Option (slice u8)))
  (let [(mut out) (None [(slice u8)])
        (mut found) false]
    (for [i 0 (len names)]
      (when (and (not (load found))
                 (and (= (get names i) name)
                      (not (same-file? a (get paths i) path))))
        (set! out (Some (get paths i)))
        (set! found true)
        0)
      0)
    (let [indexed (namespace-paths-for a (mut s) name)]
      (for [i 0 (len (load indexed))]
        (when (and (not (load found))
                   (not (same-file? a (get (load indexed) i) path)))
          (set! out (Some (get (load indexed) i)))
          (set! found true)
          0)
        0))
    (load out)))

(defn load-test-roots! [(a (dyn Allocator)) (s (mut LS))] (-> i64)
  (let [list-path (test-roots-file)]
    (when (> (len list-path) 0)
      (let [bytes (read-file a (to-cstr a list-path))
            n (len bytes)
            (mut root-names) (ArrayList::new [(slice u8)] a)
            (mut root-paths) (ArrayList::new [(slice u8)] a)
            (mut start) 0
            (mut i) 0]
        (loop (if (or (>= (load i) n) (ls-err? (mut s)))
                  (break)
                  (do
                    (when (= (primitive/cast i64 (get bytes (load i)))
                             0)
                      (when (> (load i) (load start))
                        (let [path (subslice [u8] bytes (load start) (load i))
                              src (read-src a (to-cstr a path))
                              sid (.srccount s)]
                          (set! (.srccount s) (primitive/iadd sid 1))
                          (register-source! (mut s) path src)
                          (match (read-all a src sid)
                            (Err [d] (ls-set-err! (mut s) d))
                            (Ok [raw]
                                (let [forms
                                        (prepend-uses a
                                                      (mut s)
                                                      (with-implicit-module a
                                                                            (mut s)
                                                                            raw
                                                                            path))
                                      modname
                                        (match (declared-module forms)
                                          (Some [name] name)
                                          (None [] ""))
                                      fresh
                                        (if (= (len modname) 0)
                                            true
                                            (let [inserted
                                                    (loaded-insert! (mut s)
                                                                    modname)]
                                              ; The generated harness addresses tests in
                                              ; each root by `module/function`. Install an
                                              ; internal alias directly; authored dotted
                                              ; aliases remain rejected by the loader.
                                              (mi-add-alias! (imp-entry (mut s)
                                                                        "coil_project_test_harness")
                                                             modname
                                                             modname)
                                              inserted))]
                                  (cond fresh
                                          (do
                                            (push! (mut root-names) modname)
                                            (push! (mut root-paths) path)
                                            (process-forms (mut s)
                                                           forms
                                                           (dirname path)
                                                           (None [(slice u8)])))
                                        ; two headerless roots with one basename: the
                                        ; second would be skipped as already loaded
                                        (not (and (> (len (load raw)) 0)
                                                  (is-module-form (elem raw 0))))
                                          (ls-set-err! (mut s)
                                                       (derr-at-src sid
                                                                    0
                                                                    0
                                                                    (sconcat3 a
                                                                              "test file "
                                                                              path
                                                                              " declares no (module …), and another test file already has its module name; add (module <name>) as its first form")))
                                        :else
                                          ; Loaded already. From this same file (a root
                                          ; another root imports) it is simply shared; a
                                          ; second file declaring the module would
                                          ; otherwise have its tests silently dropped.
                                          (match (other-module-file a
                                                                    (mut s)
                                                                    (load root-names)
                                                                    (load root-paths)
                                                                    modname
                                                                    path)
                                            (None [] 0)
                                            (Some [other]
                                                  (ls-set-err! (mut s)
                                                               (derr-at-src sid
                                                                            0
                                                                            0
                                                                            (sconcat3 a
                                                                                      (sconcat3 a
                                                                                                "test files "
                                                                                                other
                                                                                                " and ")
                                                                                      path
                                                                                      (sconcat3 a
                                                                                                " both declare (module "
                                                                                                modname
                                                                                                "); a module is one file, so give one of them another name"))))))))))))
                      (set! start (primitive/iadd (load i) 1))
                      0)
                    (set! i (primitive/iadd (load i) 1)))))))
    0))

;;; A test root's forms, led by a `(module …)`. A root that declares none gets
;;; the module `coil test` gives the same file named on its own, its basename
;;; (`entry-module-name`): without one, the root took the harness's own module
;;; name, which is already loaded, and its tests were never compiled.
(defn with-implicit-module [(a (dyn Allocator))
                            (s (mut LS))
                            (raw (ptr (ArrayList Sexp)))
                            (path (slice u8))] (-> (ptr (ArrayList Sexp)))
  (if (and (> (len (load raw)) 0) (is-module-form (elem raw 0)))
      raw
      (let [sid (.srccount s)
            src (sconcat3 a "(module " (entry-module-name a path) ")")]
        (set! (.srccount s) (primitive/iadd sid 1))
        (register-source! (mut s) "<test-root-module>" src)
        (match (read-all a src sid)
          (Err [_] raw)
          (Ok [head]
              (let [(mut out) (ArrayList::new [Sexp] a)]
                (for f (load head) (push! (mut out) f))
                (for f (load raw) (push! (mut out) f))
                (box-al [Sexp] a (load out))))))))

;;; The backend compiling this invocation's program when it keeps every integer
;;; in 64 bits ("wasm backend", "interpreter"), else "". Its entry
;;; sets it before the pipeline runs.
(defn narrow-int-backend-cell [] (-> (ptr (slice u8)))
  (primitive/alloc-static (slice u8)))

;;; A program the selected backend cannot lower -- it computes with an integer
;;; wider than 64 bits -- is refused here, where its source is at hand to say
;;; where, rather than by the backend, which has only the function's name.
(defn wide-ints-lowerable? [(a (dyn Allocator))
                            (w (ptr Writer))
                            (s (mut LS))
                            (mp (ptr Program))] (-> bool)
  (let [backend (load (narrow-int-backend-cell))]
    (if (= (len backend) 0)
        true
        (match (wide-refusal a mp)
          (None [] true)
          (Some [r]
                (do
                  (report-diag w
                               (mut s)
                               (derr-at-src (.source r)
                                            (.lo r)
                                            (.hi r)
                                            (wide-int-unsupported a
                                                                  backend
                                                                  (.func r))))
                  false))))))

;;; Where this compiler's library state is: beside an installed library,
;;; `<prefix>/lib/coil/library-state/<target>.state`; for any other compiler -- a
;;; candidate or stage binary of a checkout -- beside the binary,
;;; `<binary>.library-state/<target>.state`.
(defn library-state-path [(a (dyn Allocator))] (-> (slice u8))
  (let [layout (stdlib-layout a)
        dir
          (if (stdlib-installed? layout)
              (path-join a (dirname (.libs layout)) "library-state")
              (sconcat a (self-command-path a) ".library-state"))]
    (path-join a dir (sconcat a (toolchain-target a) ".state"))))

;;; Does every library file ENV holds read the same as the file this compiler
;;; would load now?
(defn library-state-current? [(a (dyn Allocator)) (env (ptr Env))] (-> bool)
  (let [sources (field (field env loader) sources)]
    (block :current
      (for [i 0 (len (load sources))]
        (let [source (elem sources i)]
          (when (library-input-name? (.name source))
            (match (read-file-opt a
                                  (to-cstr a
                                           (library-input-path a (.name source))))
              (None [] (break :current false))
              (Some [text]
                    (unless (= text (.text source)) (break :current false)))))))
      true)))

;;; The library state, loaded once per process: null when there is none, it is
;;; not this toolchain's, or it is not current.
(defstruct LibraryStateCell [(tried bool) (holder (ptr EnvHolder))])

(defn library-state [(a (dyn Allocator))] (-> (ptr EnvHolder))
  (let [cell (primitive/alloc-static LibraryStateCell)]
    (unless (.tried cell)
      (set! (.tried cell) true)
      (let [span (tr/span-begin "library-state.load")
            work (malloc-allocator)]
        (match (read-file-opt work (to-cstr work (library-state-path work)))
          (None [] (tr/count "library-state.missing" 1))
          (Some [bytes]
                (match (env-load work bytes)
                  (Err [_] (tr/count "library-state.foreign" 1))
                  (Ok [holder]
                      (if (library-state-current? work (field holder env))
                          (set! (.holder cell) holder)
                          (do
                            (tr/count "library-state.stale" 1)
                            (env-release! holder)))))))
        (tr/span-end span))
      0)
    (.holder cell)))

;;; Does a compile of the entry file SRC start from the library state? Only one
;;; whose starting point is the state's: the bundled library and its default
;;; profile, no core providers of its own, no --debug-checks, a host compiler that
;;; runs its metaprograms natively, no reader, no checker registered before the
;;; compile that reads every module, and an entry that neither is a module of the
;;; state nor provides core definitions. COIL_LIBRARY_STATE=0 turns it off.
(defn library-state-applies? [(a (dyn Allocator)) (src (slice u8))] (-> bool)
  (let [off (unit-getenv c"COIL_LIBRARY_STATE")
        providers (unit-getenv c"COIL_CORE_PROVIDERS")
        invocation (reader-invocation)]
    (cond (and (!= (primitive/cast i64 off) 0) (= (from-cstr off) "0")) false
          (not (bundled-stdlib-enabled? a)) false
          (!= (stdlib-profile a) "full") false
          (and (!= (primitive/cast i64 providers) 0)
               (> (len (from-cstr providers)) 0))
            false
          (not (lint-profile-native?)) false
          (= (.isset (meta-build-box)) 0) false
          ; the library's own macros expand differently under --debug-checks
          ; (`(primitive/debug-checks?)`), and the state is the library expanded
          ; without them
          (debug-checks-on?) false
          ; (`--jit=` needs no such exclusion: only the compiler SDK, which is no
          ; module of the state, reads `(primitive/jit-implementation)`.)
          (.unit_pretransformed (driver-unit-state)) false
          ; a checker the command registered already reads every module
          (and (!= (.init (checker-reg-box)) 0)
               (.reads_library (.reg (checker-reg-box))))
            false
          (.active (generated-owner)) false
          (> (len (.reader_artifact (driver-unit-state))) 0) false
          (configured-readers?) false
          (and (!= (.ready invocation) 0) (> (len (.paths invocation)) 1)) false
          :else
            (match (find src "provide-core") (Some [_] false) (None [] true)))))

;;; The library state to build the compile of the entry file PATH, SRC, on, or
;;; null. S is the compile's fresh loader state: a `--use` namespace that is a
;;; reader provider is found through its namespace index, and reads the entry
;;; itself, which a compile on the state does not.
(defn library-state-for [(a (dyn Allocator))
                         (s (mut LS))
                         (src (slice u8))
                         (path (slice u8))] (-> (ptr EnvHolder))
  (let [none (primitive/cast (ptr EnvHolder) 0)]
    (if (or (not (library-state-applies? a src))
            (and (> (len (load (cli-uses))) 0)
                 (do
                   (namespace-index-build-from! (mut s) path)
                   (match (discover-reader-provider a (mut s))
                     (NoReaderProvider [] false)
                     (_ true)))))
        none
        (let [holder (library-state a)]
          (cond (= (primitive/cast i64 holder) 0) none
                ; an entry that is one of the state's modules is compiled as itself
                (match (namespace-declared-module src)
                  (Some [m] (library-state-loads? holder m))
                  (None [] false))
                  (do (tr/count "library-state.entry-is-library" 1) none)
                :else holder)))))

;;; Has the library state HOLDER loaded MODULE?
(defn library-state-loads? [(holder (ptr EnvHolder)) (module (slice u8))]
  (-> bool)
  (let [(mut found) false]
    (for m (.loaded (field (field holder env) loader))
      (when (= m module) (set! found true)))
    found))

;;; The later of identity counters X and Y.
(defn library-state-later [(x i64) (y i64)] (-> i64)
  (if (> x y) x y))

;;; Make S, a fresh compile's loader state, the library state HOLDER's, as a
;;; session's revision builds on its base (`compiler-revision-enter!`): its loader
;;; lists, core providers and declarations, and identity domains that continue
;;; past the state's.
(defn library-state-enter! [(a (dyn Allocator))
                            (s (mut LS))
                            (holder (ptr EnvHolder))] (-> i64)
  (let [env (field holder env)
        providers (field env core_providers)
        declarations (field env core_declarations)]
    (ls-inherit! (mut s) (env-view a env))
    ; The library is found through the bundled mapping, never the namespace
    ; index: the index is this compile's, of its own roots alone.
    (set! (.namespace_names s) (avec-new [(slice u8)] a))
    (set! (.namespace_paths s) (avec-new [(slice u8)] a))
    (set! (.indexed_paths s) (avec-new [(slice u8)] a))
    (when (!= (.init providers) 0)
      (for [i 0 (len (load (.names providers)))]
        (core-contribution-add! (get (load (.names providers)) i)
                                (get (load (.modules providers)) i)
                                (!= (get (load (.roots providers)) i) 0))))
    (when (!= (.init declarations) 0)
      (for [i 0 (len (load (.names declarations)))]
        (core-decl-add! (get (load (.modules declarations)) i)
                        (get (load (.names declarations)) i)
                        (get (load (.los declarations)) i)
                        (get (load (.his declarations)) i)
                        (get (load (.srcs declarations)) i)
                        (get (load (.ctxts declarations)) i))))
    (set! (.n (node-id-cell))
          (library-state-later (.n (node-id-cell)) (.next_node_id env)))
    (set! (.form_id (loader-unit-state))
          (library-state-later (.form_id (loader-unit-state)) (.next_form env)))
    (set! (.n (gensym-cell))
          (library-state-later (.n (gensym-cell)) (.n (field env next_gensym))))
    (let [parent (.parent s)]
      (set-closure-parents! parent (.meta_environment parent)))
    (tr/count "library-state.used" 1)
    0))

;;; Load the entry file PATH's FORMS, as its reader produced them, with
;;; everything they import: the load step of every compile, and of every stage
;;; dump, so a dump sees the program `check` sees. A loader error is left in
;;; `(.loaderr s)`.
(defn frontend-load! [(a (dyn Allocator))
                      (s (mut LS))
                      (src (slice u8))
                      (path (slice u8))
                      (forms (ptr (ArrayList Sexp)))
                      (reader-state (ptr LS))
                      (definition-module (slice u8))] (-> i64)
  ;; Scheme identifier folding must precede namespace/macro indexing;
  ;; changing spellings later leaves those indexes keyed by the raw
  ;; spelling and corrupts hygiene for introduced binders.
  (loader-casefold-source! src forms)
  ;; Own a fresh syntax tree after folding. Re-running a reader provider
  ;; here duplicated arbitrary read-phase work and observable effects.
  (let [normalized (own-form-list a forms)
        load-span (tr/span-begin "frontend.load")]
    ; file-relative imports (tool-1): the entry file's own relative imports
    ; resolve against ITS directory, not the process CWD.
    (namespace-index-build! (mut s))
    (load-program (mut s)
                  (prepend-uses a (mut s) normalized)
                  (dirname path))
    (install-reader-hygiene-context! (mut s)
                                     reader-state
                                     definition-module)
    (load-test-roots! a (mut s))
    (tr/span-end load-span))
  0)

;;; `frontend-load!` for a compile on the library state (`library-state-enter!`):
;;; the library is loaded already, so only the entry's own forms, its `--use`
;;; imports and test roots are, as `load-program` loads them after the prelude.
;;; The entry's source is not the first, so the namespace index is told it.
(defn frontend-load-on-library-state! [(a (dyn Allocator))
                                       (s (mut LS))
                                       (src (slice u8))
                                       (path (slice u8))
                                       (forms (ptr (ArrayList Sexp)))] (-> i64)
  (loader-casefold-source! src forms)
  (let [normalized (own-form-list a forms)
        load-span (tr/span-begin "frontend.load")]
    (namespace-index-build-from! (mut s) path)
    ; The state's entry is not this compile's. An entry with no module form is
    ; given one named for its file, as `prepend-uses` names it from the first
    ; source of a compile from nothing -- here the state's.
    (set! (.entry_module s)
          (match (declared-module normalized)
            (Some [module] module)
            (None [] (entry-module-name a path))))
    (let [program (prepend-uses a (mut s) normalized)]
      (match (declared-module program)
        (Some [module]
              (do
                (loaded-insert! (mut s) module)
                (set! (.entry_module s) module)
                (set! (.entry_module (semantic-workspace (mut s))) module)
                0))
        (None [] 0))
      (ci/cimport-load-begin!)
      (process-forms (mut s) program (dirname path) (None [(slice u8)])))
    (ci/cimport-load-end!)
    (load-test-roots! a (mut s))
    (tr/span-end load-span))
  0)

;;; Read the entry file of a compile on the library state, at SID: the plain
;;; read `initial-read` makes when no reader is involved, which is the only one a
;;; compile on the state makes (`library-state-applies?`).
(defn initial-read-on-library-state [(a (dyn Allocator))
                                     (s (mut LS))
                                     (src (slice u8))
                                     (path (slice u8))
                                     (sid i64)] (-> InitialRead)
  (namespace-index-build-from! (mut s) path)
  (match (read-all a src sid)
    (Ok [forms]
        (InitialForms
          :forms forms
          :reader_state (primitive/cast (ptr LS) 0)
          :definition_module ""))
    (Err [d] (InitialReadError d))))

;;; Expand the loaded program, as every compile does.
(defn frontend-expand! [(a (dyn Allocator)) (s (mut LS))] (-> (Result i64 Diag))
  (expand-stage3-except (mut s)
                        (box-al [(slice u8)]
                                a
                                (avec-to-list (field s stage_excluded) a))))

;;; Set by a compile on the library state that registered a checker or transform
;;; reading every module, the library's among them: the state holds those compiled
;;; and cannot hand them over, so the compile starts again from nothing.
(defstruct LibraryStateRestart [(wanted bool)])

(defn library-state-restart [] (-> (ptr LibraryStateRestart))
  (primitive/alloc-static LibraryStateRestart))

;;; Whether S, a compile on the library state that has loaded its program, has to
;;; start again from nothing (`LibraryStateRestart`): it loaded a checker or
;;; transform that reads every module. A registration is a literal top-level form
;;; of a loaded module, so every one is known before anything expands. One whose
;;; `:modules` is not a coil.phase.Modules counts too: the compile from nothing
;;; reports it.
(defn library-state-must-restart? [(a (dyn Allocator)) (s (mut LS))] (-> bool)
  (let [reads
          (block :reads
            (for [i 0 (len (.out s))]
              (let [tf (elem (field s out) i)
                    f (field tf form)]
                (when (or (is-checker-form f) (is-transform-form f))
                  (match (registration-own-modules? f
                                                    (.module tf)
                                                    (field s imports)
                                                    (field s exports)
                                                    a)
                    (Ok [own] (unless own (break :reads true)))
                    (Err [_] (break :reads true))))))
            false)]
    (when reads (set! (.wanted (library-state-restart)) true) 0)
    reads))

;;; A compile on the library state that registered, while expanding, a checker
;;; or transform reading every module, which `library-state-must-restart?` found
;;; none of before: a compiler bug, and the compile cannot go on.
(defn library-state-registration-missed [] (-> Diag)
  (derr "compiler bug: a compile on the library state registered a checker or transform that reads every module, which its loaded forms did not show"))

(defn run-pipeline-with-code-session [(a (dyn Allocator))
                                      (src (slice u8))
                                      (cwd (slice u8))
                                      (w (ptr Writer))
                                      (path (slice u8))
                                      (srcpaths (ptr (ArrayList (slice u8))))
                                      (srctexts (ptr (ArrayList (slice u8))))
                                      (code-session-state (ptr i8))
                                      (reader-setup (ptr LS))
                                      (reader-program (ptr Program))
                                      (reader-name (slice u8))
                                      (reader-module (slice u8))
                                      (reader-maps (ptr SemMapsSnap))
                                      (reader-a (dyn Allocator))]
  (-> (Option (ptr Program)))
  (let [; what the command registered before compiling (a lint profile's checkers)
        registered (load (checker-reg-box))
        first
          (run-pipeline-attempt a
                                src
                                cwd
                                w
                                path
                                srcpaths
                                srctexts
                                code-session-state
                                reader-setup
                                reader-program
                                reader-name
                                reader-module
                                reader-maps
                                reader-a
                                true)]
    (if (not (.wanted (library-state-restart)))
        first
        (do
          (set! (.wanted (library-state-restart)) false)
          (tr/count "library-state.restarted" 1)
          ; nothing of the attempt on the state, which stopped once it had loaded
          ; the program, is this compile's
          (store! (checker-reg-box) registered)
          (set-closure-parents! (primitive/cast (ptr LS) 0)
                                (primitive/cast (ptr LS) 0))
          (run-pipeline-attempt a
                                src
                                cwd
                                w
                                path
                                srcpaths
                                srctexts
                                code-session-state
                                reader-setup
                                reader-program
                                reader-name
                                reader-module
                                reader-maps
                                reader-a
                                false)))))

;;; One compile of the entry file PATH: on the library state when STATE-ALLOWED
;;; and it applies, and otherwise from nothing.
(defn run-pipeline-attempt [(a (dyn Allocator))
                            (src (slice u8))
                            (cwd (slice u8))
                            (w (ptr Writer))
                            (path (slice u8))
                            (srcpaths (ptr (ArrayList (slice u8))))
                            (srctexts (ptr (ArrayList (slice u8))))
                            (code-session-state (ptr i8))
                            (reader-setup (ptr LS))
                            (reader-program (ptr Program))
                            (reader-name (slice u8))
                            (reader-module (slice u8))
                            (reader-maps (ptr SemMapsSnap))
                            (reader-a (dyn Allocator))
                            (state-allowed bool)] (-> (Option (ptr Program)))
  (let [s (primitive/alloc-stack LS)]
    (ls-init! (mut s) a)
    ; `coil build-unit` compiles the entry module as a unit, not a program, so
    ; the resolver keeps no `main` bare as the process entry (see main-stays-bare?).
    (set! (.unit_entry (semantic-workspace (mut s)))
          (.unit_pretransformed (driver-unit-state)))
    (set! (.code_session_state s) code-session-state)
    (let [base
            (if (and state-allowed
                     (and (= (primitive/cast i64 reader-setup) 0)
                          (= (primitive/cast i64 code-session-state) 0)))
                (library-state-for a (mut s) src path)
                (primitive/cast (ptr EnvHolder) 0))
          on-base (!= (primitive/cast i64 base) 0)
          sid
            (if on-base
                (do
                  (library-state-enter! a (mut s) base)
                  (register-live-source! (mut s) path src))
                (do
                  (set! (.srccount s) 1)
                  (register-source! (mut s) path src)
                  0))
          initial
            (if (= (primitive/cast i64 reader-setup) 0)
                (if on-base
                    (initial-read-on-library-state a (mut s) src path sid)
                    (initial-read a (mut s) src path cwd))
                (let [(mut saved) (zeroed SemMapsSnap)]
                  (sem-maps-save (mut saved))
                  (sem-maps-restore reader-maps)
                  (set! (.code_session_state reader-setup) code-session-state)
                  ; The prepared reader and its semantic-map snapshot belong to
                  ; the retained session. Provider evaluation may update that
                  ; snapshot, so its Code/context must use the same allocator;
                  ; the returned forms are copied into the frontend arena below.
                  (let [prepared
                          (PreparedReaderSetup
                            :state reader-setup
                            :checked reader-program)
                        result
                          (run-prepared-reader reader-a
                                               prepared
                                               reader-module
                                               reader-name
                                               (read-context-code reader-a
                                                                  path
                                                                  src
                                                                  "entry")
                                               src)]
                    (sem-maps-save reader-maps)
                    (sem-maps-restore (mut saved))
                    result)))]
      (match initial
        (InitialReadError [d]
                          (do (report-diag w (mut s) d) (None [(ptr Program)])))
        (InitialForms [forms reader-state definition-module]
                      ; file-relative imports (tool-1): the entry file's own relative imports
                      ; resolve against ITS directory, not the process CWD (nested imports already
                      ; use each imported file's incdir). `cwd` stays for DWARF comp_dir only.
                      (do
                        (if on-base
                            (frontend-load-on-library-state! a
                                                             (mut s)
                                                             src
                                                             path
                                                             forms)
                            (frontend-load! a
                                            (mut s)
                                            src
                                            path
                                            forms
                                            reader-state
                                            definition-module))
                        (cond (ls-err? (mut s))
                                (do
                                  (report-diag w (mut s) (.loaderr s))
                                  (None [(ptr Program)]))
                              (and on-base
                                   (library-state-must-restart? a (mut s)))
                                (None [(ptr Program)])
                              :else
                                (let [interface-snapshot
                                        (generated-interface-snapshot a (mut s))
                                      checker-source
                                        (checker-source-facts-begin! a (mut s))
                                      expand-span
                                        (tr/span-begin "frontend.expand")
                                      expand-result (frontend-expand! a (mut s))
                                      _expand-end (tr/span-end expand-span)
                                      _observed
                                        (checker-source-facts-expanded! checker-source)]
                                  (match expand-result
                                    (Err [d]
                                         (do
                                           (report-diag w (mut s) d)
                                           (None [(ptr Program)])))
                                    (Ok [_]
                                        (if (and on-base
                                                 (.reads_library (.reg (checker-reg-box))))
                                            (do
                                              (report-diag w
                                                           (mut s)
                                                           (library-state-registration-missed))
                                              (None [(ptr Program)]))
                                            ; transforms (fixpoint) + authoritative resolve + typecheck, one step
                                            (let [check-span
                                                    (tr/span-begin "frontend.transforms-and-check")
                                                  ; with no session to keep this compilation's
                                                  ; workspace, its authoritative resolve is its last
                                                  _final
                                                    (set! (.final_strict (semantic-workspace (mut s)))
                                                          (= (primitive/cast i64
                                                                             code-session-state)
                                                             0))
                                                  raw-check-result
                                                    (run-transforms-and-check a
                                                                              (mut s))
                                                  check-result
                                                    (if (generated-interfaces-unchanged? a
                                                                                         (mut s)
                                                                                         interface-snapshot)
                                                        raw-check-result
                                                        (Err [(ptr Program)
                                                              Diag]
                                                             (derr "a transform changed a read-only generated-module interface; perform cross-module transforms before partitioning or keep the affected bodies in one compilation unit")))
                                                  _check-end
                                                    (tr/span-end check-span)]
                                              (match check-result
                                                (Err [d]
                                                     (do
                                                       (if (!= (primitive/cast i64
                                                                               code-session-state)
                                                               0)
                                                           (code-session-record-check-repairs! (primitive/cast (ptr CodeSessionState)
                                                                                                               code-session-state)
                                                                                               (mut s))
                                                           0)
                                                       (report-check-diags w
                                                                           (mut s)
                                                                           d)
                                                       (None [(ptr Program)])))
                                                (Ok [cp]
                                                    (let [_unit-forms
                                                            (when (.unit_pretransformed (driver-unit-state))
                                                              (set! (.unit_expanded (driver-unit-state))
                                                                    (box-al [TaggedForm]
                                                                            a
                                                                            (.out s)))
                                                              (set! (.unit_reexported (driver-unit-state))
                                                                    (module-reexported-names a
                                                                                             (.declaration_table (semantic-workspace (mut s)))
                                                                                             (field s
                                                                                                    imports)
                                                                                             (field s
                                                                                                    exports)
                                                                                             (.unit_module (driver-unit-state))))
                                                              ; The module as written: a second run compiles the
                                                              ; forwarding wrappers build-unit adds, which are not
                                                              ; the module's names.
                                                              (when (= (primitive/cast i64
                                                                                       (.unit_public (driver-unit-state)))
                                                                       0)
                                                                (set! (.unit_public (driver-unit-state))
                                                                      (module-own-public-names a
                                                                                               (.declaration_table (semantic-workspace (mut s)))
                                                                                               (field s
                                                                                                      exports)
                                                                                               (.unit_module (driver-unit-state))))
                                                                0)
                                                              (set! (.unit_externs (driver-unit-state))
                                                                    (load (field cp
                                                                                 externs)))
                                                              (set! (.unit_listed (driver-unit-state))
                                                                    (module-export-listed? (field s
                                                                                                  exports)
                                                                                           (.unit_module (driver-unit-state))))
                                                              0)
                                                          checker-span
                                                            (tr/span-begin "frontend.registered-checkers")
                                                          _published
                                                            (checker-source-publish! a
                                                                                     (mut s)
                                                                                     checker-source)
                                                          checker-result
                                                            (run-registered-checkers a
                                                                                     (mut s)
                                                                                     cp)
                                                          _released
                                                            (checker-source-facts-end! checker-source)
                                                          _checker-end
                                                            (tr/span-end checker-span)]
                                                      (match checker-result  ; semantic checkers: read the authoritative checked program
                                                        (Err [d]
                                                             (do
                                                               (report-diag w
                                                                            (mut s)
                                                                            d)
                                                               (None [(ptr Program)])))
                                                        (Ok [_]
                                                            (match (let [drop-span
                                                                           (tr/span-begin "frontend.drop-code")
                                                                         root
                                                                           (drop-code-funcs-unless-root a
                                                                                                        cp
                                                                                                        ""
                                                                                                        ; the library's functions are classified already
                                                                                                        (if (and on-base
                                                                                                                 (.compile_time_known (field base
                                                                                                                                             env)))
                                                                                                            (field (field base
                                                                                                                          env)
                                                                                                                   compile_time)
                                                                                                            (primitive/cast (ptr (AMap (slice u8)
                                                                                                                                       (slice u8)))
                                                                                                                            0))
                                                                                                        (primitive/cast (ptr (AMap (slice u8)
                                                                                                                                   (slice u8)))
                                                                                                                        0))]
                                                                     (tr/span-end drop-span)
                                                                     root)
                                                              (Some [root]
                                                                    (do
                                                                      (report-diag w
                                                                                   (mut s)
                                                                                   (compile-time-root-diag a
                                                                                                           root))
                                                                      (None [(ptr Program)])))
                                                              (None []
                                                                    (do
                                                                      (let [mono-span
                                                                              (tr/span-begin "frontend.monomorphize")
                                                                            mono-result
                                                                              (monomorphize a
                                                                                            cp
                                                                                            (staged-instances))
                                                                            _mono-end
                                                                              (tr/span-end mono-span)]
                                                                        (match mono-result
                                                                          (Err [d]
                                                                               (do
                                                                                 (report-diag w
                                                                                              (mut s)
                                                                                              d)
                                                                                 (None [(ptr Program)])))
                                                                          (Ok [mp]
                                                                              (do
                                                                                (let [sort-span
                                                                                        (tr/span-begin "frontend.mono-sort")]
                                                                                  (sort-mono-program a
                                                                                                     mp)
                                                                                  (tr/span-end sort-span))
                                                                                (if (!= (primitive/cast i64
                                                                                                        code-session-state)
                                                                                        0)
                                                                                    (code-session-stage-monomorphs! (primitive/cast (ptr CodeSessionState)
                                                                                                                                    code-session-state)
                                                                                                                    mp)
                                                                                    0)
                                                                                (record-entry-shape! mp)
                                                                                (drop-unit-owned-exports! a
                                                                                                          mp)
                                                                                ; export the source registry (for DWARF)
                                                                                (let [ns
                                                                                        (len (.sources s))
                                                                                      (mut i)
                                                                                        0]
                                                                                  (loop (if (>= (load i)
                                                                                                ns)
                                                                                            (break)
                                                                                            (do
                                                                                              (let [sp
                                                                                                      (elem (field s
                                                                                                                   sources)
                                                                                                            (load i))]
                                                                                                (push! (mut srcpaths)
                                                                                                       (.name sp))
                                                                                                (push! (mut srctexts)
                                                                                                       (.text sp)))
                                                                                              (set! i
                                                                                                    (primitive/iadd (load i)
                                                                                                                    1))))))
                                                                                ; a backend reports a program it cannot compile at the place
                                                                                (backend-sources-set! a
                                                                                                      srcpaths
                                                                                                      srctexts)
                                                                                (if (and (generated-runtime-contract a
                                                                                                                     mp)
                                                                                         (wide-ints-lowerable? a
                                                                                                               w
                                                                                                               (mut s)
                                                                                                               mp))
                                                                                    (Some mp)
                                                                                    (None [(ptr Program)]))))))))))))))))))))))))))

(defn run-pipeline [(a (dyn Allocator))
                    (src (slice u8))
                    (cwd (slice u8))
                    (w (ptr Writer))
                    (path (slice u8))
                    (srcpaths (ptr (ArrayList (slice u8))))
                    (srctexts (ptr (ArrayList (slice u8))))]
  (-> (Option (ptr Program)))
  (run-pipeline-with-code-session a
                                  src
                                  cwd
                                  w
                                  path
                                  srcpaths
                                  srctexts
                                  (primitive/cast (ptr i8) 0)
                                  (primitive/cast (ptr LS) 0)
                                  (primitive/cast (ptr Program) 0)
                                  ""
                                  ""
                                  (primitive/cast (ptr SemMapsSnap) 0)
                                  a))

; `check` / `build -o /dev/null`: run the SAME front-end `build` runs before codegen
; (read -> load -> expand -> transforms -> typecheck -> monomorphize) but emit NO object.
; Returns 1 when the program compiles cleanly through mono, 0 (with a located diagnostic
; already reported to stderr) otherwise. Because this reuses run-pipeline verbatim, a
; program that `check`s clean is one `build` would only ever fail to LINK, never to
; compile. Signature is the mode-3 dump-fn shape so it runs on the big stack. (diag-12)
(defn check-src-program [(a (dyn Allocator))
                         (src (slice u8))
                         (cwd (slice u8))
                         (path (slice u8))] (-> i64)
  (let [w (stderr)
        (mut sp0) (ArrayList::new [(slice u8)] a)
        (mut st0) (ArrayList::new [(slice u8)] a)]
    (match (run-pipeline a src cwd w path (mut sp0) (mut st0))
      (Some [_] 1)
      (None [] 0))))

; The built-in lint profile is policy, not part of the application. Compile it
; once per process and keep that arena for exactly as long as its registered
; metaprogram pointers. Fixpoint rounds then compile only the changing target.
(defstruct LintProfileRegBox [(init i64) (reg CheckerReg)])

;;; Compile the built-in lint profile from source into RULES: a program that
;;; imports coil.lint.default, expanded and checked. Its checked program, with the
;;; profile's registrations left in the checker registry; None, the diagnostic
;;; reported, when it does not compile.
(defn lint-profile-compile [(ra (dyn Allocator))
                            (rules (mut LS))
                            (cwd (slice u8))] (-> (Option (ptr Program)))
  (let [w (stderr)
        rules-src "(module coil-lint-rules)\n(defn main [] (-> i64) 0)\n"
        (mut result) (None [(ptr Program)])]
    (ls-init! (mut rules) ra)
    (set! (.srccount rules) 1)
    (register-source! (mut rules) "<lint rules>" rules-src)
    (match (read-all ra rules-src 0)
      (Err [d] (report-diag w (mut rules) d))
      (Ok [forms]
          (do
            (namespace-index-build! (mut rules))
            (load-program (mut rules)
                          (prepend-selected-uses ra (mut rules) forms 1)
                          cwd)
            (if (ls-err? (mut rules))
                (report-diag w (mut rules) (.loaderr rules))
                (match (expand-stage3 (mut rules))
                  (Err [d] (report-diag w (mut rules) d))
                  (Ok [_]
                      (match (run-transforms-and-check ra (mut rules))
                        (Err [d] (report-check-diags w (mut rules) d))
                        (Ok [cp] (do (set! result (Some cp)) 0)))))))))
    (load result)))

;;; The profile is built in isolation (see spawn-lint-profile-build!), so nothing
;;; about the command that loads it changes what it is.
(const LINT-PROFILE-OPTIONS "")

;;; Whether this compiler runs metaprograms as native code it can load from an
;;; image: not the interpreter (COIL_META_INTERP=1 asks for it to be exercised)
;;; and not a wasm host.
(defn lint-profile-native? [] (-> bool)
  (not (or (meta-interp-requested?) (or (meta-wasm-active?) (wasm-sandbox?)))))

;;; A build's checkers read the authored source and the facts the compiler files
;;; about it (meta/references-to, meta/path, type-of on an authored node) as
;;; `coil lint`'s do. A build records them only when it has a checker to read them
;;; and nothing else is recording already (`coil lint` records its own): then this
;;; starts the facts and answers the authored forms, snapshotted before expansion
;;; rewrites them; otherwise null, and the build records nothing.
(defn checker-source-facts-begin! [(a (dyn Allocator)) (s (mut LS))]
  (-> (ptr (ArrayList TaggedForm)))
  (if (or (.enabled (source-facts))
          (not (block :found
                 (for [i 0 (len (.out s))]
                   (when (is-checker-form (field (elem (field s out) i) form))
                     (break :found true)))
                 false)))
      (primitive/cast (ptr (ArrayList TaggedForm)) 0)
      (do
        (source-facts-start!)
        (lint-source-facts-scope! a (mut s))
        (source-view-discard!)
        (tower-snapshot a (box-al [TaggedForm] a (.out s)) (len (.out s))))))

;;; Expansion is over: what it observed stays, and checking starts afresh.
(defn checker-source-facts-expanded! [(authored (ptr (ArrayList TaggedForm)))]
  (-> i64)
  (unless (= (primitive/cast i64 authored) 0)
    (set! (.observing (source-facts)) false)
    (source-facts-semantic-reset!)
    0)
  0)

;;; Publish the source view of AUTHORED for the checkers about to run.
(defn checker-source-publish! [(a (dyn Allocator))
                               (s (mut LS))
                               (authored (ptr (ArrayList TaggedForm)))] (-> i64)
  (unless (= (primitive/cast i64 authored) 0)
    (source-view-publish! a (mut s) authored)
    0)
  0)

;;; The checkers ran: release the view and the facts.
(defn checker-source-facts-end! [(authored (ptr (ArrayList TaggedForm)))]
  (-> i64)
  (unless (= (primitive/cast i64 authored) 0)
    (source-view-discard!)
    (source-facts-stop!)
    0)
  0)

;;; What an analysis records source facts about (source-facts-scope!): the files
;;; the user wrote -- a source whose name is not a synthetic `<…>` one, as
;;; `code-from-user?` decides -- and the modules their forms belong to.
(defn lint-source-facts-scope! [(a (dyn Allocator)) (target (mut LS))] (-> i64)
  (let [(mut sources) (ArrayList::new [bool] a)
        (mut modules) (ArrayList::new [(slice u8)] a)]
    (for [i 0 (len (.sources target))]
      (let [name (.name (elem (field target sources) i))]
        (push! (mut sources)
               (and (> (len name) 0) (!= (get name 0) (: 60 u8)))))
      0)
    (for [i 0 (len (.out target))]
      (let [tf (elem (field target out) i)
            sid (sx-source (load (field tf form)))]
        (when (and (>= sid 0)
                   (and (< sid (len (load sources))) (get (load sources) sid)))
          (match (.module tf)
            (Some [m]
                  (unless (set-contains (mut modules) m)
                    (push! (mut modules) m))
                  0)
            (None [] 0))
          0))
      0)
    (source-facts-scope! (box-al [bool] a (load sources))
                         (box-al [(slice u8)] a (load modules)))))

; The LLVM entry points (dump-ir-program / build-object / build-ir-program) live in
; src/compiler/main.coil and are injected here as function pointers (see driver-main /
; DumpCtx), so this module carries no LLVM dependency.

; build-cmd explicitly enables plural LLVM objects only for an ordinary host
; link. emit-obj and metaprogram object builders retain their one-object API.
(defn parallel-codegen-cell [] (-> (ptr bool))
  (field (driver-unit-state) parallel))

(defn set-parallel-codegen! [(enabled bool)] (-> i64)
  (set! (parallel-codegen-cell) enabled)
  0)

(defn parallel-codegen? [] (-> bool)
  (load (parallel-codegen-cell)))

(defn native-emit-dwarf-cell [] (-> (ptr bool))
  (field (driver-unit-state) dwarf))

(defn set-native-emit-dwarf! [(enabled bool)] (-> i64)
  (set! (native-emit-dwarf-cell) enabled)
  0)

(defn native-emit-dwarf? [] (-> bool)
  (load (native-emit-dwarf-cell)))

; The native backend (tpde): mono Program -> CIR -> tpde -> a Mach-O object
; (arm64 or x86-64) or, for Linux x86-64, an ELF one; no LLVM.
(defn build-native-program [(a (dyn Allocator))
                            (src (slice u8))
                            (cwd (slice u8))
                            (obj-cstr (ptr i8))
                            (path (slice u8))
                            (backend i64)] (-> i64)
  (if (not (native-backend-target-ok? backend))
      0
      (let [w (stderr)
            (mut sp0) (ArrayList::new [(slice u8)] a)
            (mut st0) (ArrayList::new [(slice u8)] a)]
        (match (run-pipeline a src cwd w path (mut sp0) (mut st0))
          (Some [mp]
                (do
                  (let [backend-span (tr/span-begin "backend.tpde-object")]
                    (cgtpde-build-object a
                                         mp
                                         obj-cstr
                                         path
                                         cwd
                                         (box-al [(slice u8)] a (load sp0))
                                         (box-al [(slice u8)] a (load st0))
                                         (native-emit-dwarf?))
                    (tr/span-end backend-span))
                  1))
          (None [] 0)))))

; native wasm64 backend: mono Program -> a FINAL memory64 wasm module (no LLVM, no
; linker, no finalizer step). The module bytes are written straight to `obj-cstr`,
; which build-cmd points at the -o output path for --backend wasm.
(defn build-wasm-program [(a (dyn Allocator))
                          (src (slice u8))
                          (cwd (slice u8))
                          (obj-cstr (ptr i8))
                          (path (slice u8))] (-> i64)
  (let [w (stderr)
        _narrow (set! (narrow-int-backend-cell) "wasm backend")
        (mut sp0) (ArrayList::new [(slice u8)] a)
        (mut st0) (ArrayList::new [(slice u8)] a)]
    (match (run-pipeline a src cwd w path (mut sp0) (mut st0))
      (Some [mp]
            (do
              ; 1 only when the module reached the disk: d-write-file has said
              ; which path it could not write.
              (if (= (d-write-file a
                                   (from-cstr obj-cstr)
                                   (wcg-build-module a mp (wasm-side-module?)))
                     0)
                  1
                  0)))
      (None [] 0))))

; Context handed to the pipeline thread (the C entry takes a single (ptr i8) arg).
; `mode` 0 = emit-ir (print IR to stdout); 1 = build (emit object to `obj`).
; `triple` = the `--target` override cstr (null = host default) for cross-compiling.
; `ok` is the pipeline result the thread writes back so the caller (main / build-cmd)
; can HALT and exit nonzero on a compile error —, where a failed
; `build_executable_*` / `emit_ir` returns Err and `main` prints + exits FAILURE
; BEFORE any link step. 1 = pipeline succeeded, 0 = a diagnostic was reported.
;
; `build-fn` / `emitir-fn` are the LLVM-backend entry points, injected by the top
; file (main.coil supplies the real ones; main_a64.coil supplies hard-error stubs).
; dump-thread-entry calls through them for modes 1/0, so the LLVM backend is fully
; decoupled from this module. Their signatures mirror the (removed) build-ir-program
; and dump-ir-program.
(defstruct DumpCtx
  [(a (dyn Allocator))
   (src (slice u8))
   (cwd (slice u8))
   (mode i64)
   (obj (ptr i8))
   (triple (ptr i8))
   (self (slice u8))
   (path (slice u8))
   (ok i64)
   (objects (ptr (ArrayList (slice u8))))
   (build-fn (fnptr (cc/C)
                    [(ref (dyn Allocator))
                     (slice u8)
                     (slice u8)
                     (ptr i8)
                     (ptr i8)
                     (slice u8)]
                    i64))
   (emitir-fn (fnptr (cc/C)
                     [(ref (dyn Allocator))
                      (slice u8)
                      (slice u8)
                      (ptr i8)
                      (slice u8)]
                     i64))
   ; mode 3 (a debug dump: dump-read/ast/load/expand/resolved/checked/mono).
   ; The dump functions differ in arity, so each is adapted to this one
   ; (a src cwd path) -> i64 shape by a `-w` wrapper (see below); the thread
   ; calls whichever wrapper was stored. Dumps run the SAME recursive passes
   ; as build, so they must share the big stack, not overflow the 8 MiB main.
   (dump-fn (fnptr (cc/C)
                   [(ref (dyn Allocator)) (slice u8) (slice u8) (slice u8)]
                   i64))
   ; mode 6: analyse a SET of namespaces as one program (project lint). There
   ; is no entry source; `set-fn` receives the module names and the working
   ; directory instead of a text and a path, and the loader roots the program
   ; in those modules directly.
   (modules (ptr (ArrayList (slice u8))))
   (set-fn (fnptr (cc/C)
                  [(ref (dyn Allocator))
                   (ptr (ArrayList (slice u8)))
                   (slice u8)]
                  i64))])

; Modes that analyse without emitting an object: a debug dump or lint over an
; entry (3) and lint over a module set (6).
(defn dump-mode-analysis? [(ctx (ptr DumpCtx))] (-> bool)
  (or (= (.mode ctx) 3) (= (.mode ctx) 6)))

(defn generated-quoted! [(b (mut StrBuf)) (text (slice u8))] (-> i64)
  (push-str! (mut b) "\"")
  (for [i 0 (len text)]
    (let [c (get text i)]
      (cond (= c (: 34 u8)) (push-str! (mut b) "\\\"")
            (= c (: 92 u8)) (push-str! (mut b) "\\\\")
            (= c (: 10 u8)) (push-str! (mut b) "\\n")
            (= c (: 13 u8)) (push-str! (mut b) "\\r")
            (= c (: 9 u8)) (push-str! (mut b) "\\t")
            :else (push! (mut b) c)))
    0)
  (push-str! (mut b) "\" ")
  0)

; One immutable, normalized configuration is captured before the source reader
; runs. Semantic registries are never copied from the facade into an owner.
(defstruct CompilationUnitConfig
  [(optimization i64)
   (meta_optimization i64)
   (sanitizer i64)
   (debug i64)
   (jit_implementation JitImplementation)
   (dwarf bool)
   (quiet bool)
   (triple (ptr i8))
   (uses (ptr (ArrayList (slice u8))))
   (owner_uses (ptr (ArrayList (slice u8))))
   (reader_artifact (slice u8))
   (links MetaLinkBox)
   (jit MetaJitBox)
   (interp_extern InterpExternHook)
   (interp_abort InterpAbortHook)
   (wasm_side WSideFlag)
   (wasm_stack WStackCfg)
   (environment (ArrayList UnitEnvironment))
   ; Prebuilt units every compilation unit of this command reads in place of
   ; their modules' source. Bound into each unit's loader state on entry.
   (units (ptr (ArrayList PrebuiltUnit)))])

(defn compilation-environment [(a (dyn Allocator))]
  (-> (ArrayList UnitEnvironment))
  (let [(mut entries) (ArrayList::new [UnitEnvironment] a)
        (mut keys)
          [c"COIL_NAMESPACE_ROOTS"
           c"COIL_NAMESPACE_EXCLUDES"
           c"COIL_MODULE_MAP"
           c"COIL_READERS"
           c"COIL_MANIFEST_READERS"
           c"COIL_MANIFEST_PROVIDERS"
           c"COIL_MANIFEST_PATH"
           c"COIL_PACKAGE_NAME"
           c"COIL_WORKSPACE_PACKAGES"
           c"COIL_STDLIB"
           c"COIL_STDLIB_PROFILE"
           c"COIL_STRICT_BUNDLE"
           c"COIL_PRELUDE"
           c"COIL_CORE_PROVIDERS"
           c"COIL_TRACE_MACROS"
           c"COIL_MACRO_EXPANSION_LIMIT"
           c"COIL_META_JIT"
           c"COIL_META_INTERP"
           c"COIL_META_CACHE"
           c"COIL_META_ARENA"
           c"COIL_META_MAIN"]]
    (for [i 0 21]
      (let [key (load (index (primitive/cast (ptr (ptr i8)) (mut keys)) i))
            value (unit-getenv key)]
        (push! (mut entries)
               (UnitEnvironment
                 :key key
                 :value
                   (if (= (primitive/cast i64 value) 0)
                       value
                       (to-cstr a (from-cstr value))))))
      0)
    (load entries)))

; `--use` historically selects both source decoders and semantic metaprograms.
; Normalize that distinction once, before the facade runs: reader-provider
; containers apply to raw inputs, while ordinary uses still apply to each owner.
; Explicit imports in an owner remain ordinary semantic dependencies.
(defn compilation-owner-uses [(a (dyn Allocator))]
  (-> (ptr (ArrayList (slice u8))))
  (let [(mut selected) (ArrayList::new [(slice u8)] a)
        uses (cli-uses)]
    (when (> (len (load uses)) 0)
      (let [index (box! a LS (zeroed LS))]
        (ls-init! (mut index) a)
        (namespace-index-build! (mut index))
        (let [providers (discover-reader-providers a (mut index))]
          (for [i 0 (len (load uses))]
            (let [name (get (load uses) i)
                  (mut input-reader) false]
              (for [j 0 (len (load providers))]
                (when (= name
                         (.container (elem providers j)))
                  (set! input-reader true)
                  0)
                0)
              (unless (load input-reader) (push! (mut selected) name) 0))
            0)))
      0)
    (box-al [(slice u8)] a (load selected))))

(defn compilation-unit-config [(a (dyn Allocator))] (-> CompilationUnitConfig)
  (CompilationUnitConfig
    :optimization (opt-level)
    :meta_optimization (meta-opt-level)
    :sanitizer (sanitize-mode)
    :debug (if (debug-checks?) 1 0)
    :jit_implementation (jit-implementation)
    :dwarf (native-emit-dwarf?)
    :quiet (quiet?)
    :triple (target-triple)
    :uses (cli-uses)
    :owner_uses (compilation-owner-uses a)
    :reader_artifact (.reader_artifact (driver-unit-state))
    :links (load (meta-link-box))
    :jit (load (meta-jit-box))
    :interp_extern (load (interp-extern-hook))
    :interp_abort (load (interp-abort-hook))
    :wasm_side (load (wasm-side-cell))
    :wasm_stack (load (wasm-stack-cell))
    :environment (compilation-environment a)
    :units (.units (driver-unit-state))))

(defstruct CompilationUnitSession
  [(arena scratch/ScratchArena)
   (allocation (ptr UnitAllocationContext))
   (prior_allocation (ptr UnitAllocationContext))
   (prior_node_id (ptr NodeIdCell))
   (prior_ast (ptr AstUnitState))
   (prior_parser (ptr ParserUnitState))
   (prior_resolve (ptr ResolveUnitState))
   (prior_expander (ptr ExpanderUnitState))
   (prior_comptime (ptr MetastateUnitState))
   (prior_loader (ptr LoaderUnitState))
   (prior_driver (ptr DriverUnitState))
   (prior_metahost (ptr mh/MetaHostUnitState))
   (prior_metaengine (ptr MetaEngineUnitState))
   (prior_interp (ptr InterpUnitState))
   (prior_native (ptr NativeUnitState))
   (prior_wcg (ptr WcgUnitState))
   (prior_wasm (ptr WasmUnitState))
   (prior_mtrace (ptr mtr/MtraceUnitState))
   (active bool)])

; Trace aggregation is process-owned and copies names; only the live diagnostic
; context and allocator counter belong to the unit's lifetime.
;;; KIND names the account the unit's arena is counted under (`:memory`).
(defn compilation-unit-enter! [(scope (ptr CompilationUnitSession))
                               (config (ptr CompilationUnitConfig))
                               (virtuals (ptr (ArrayList VirtualSource)))
                               (source-input bool)
                               (kind (slice u8))] (-> (dyn Allocator))
  (set! (.active scope) true)
  (scratch/ScratchArena::init-with-capacity (field scope arena)
                                            (large-pages/compiler-scratch-for kind)
                                            1048576)
  (large-pages/observe-arena! (field scope arena) kind)
  (let [a (allocator (field scope arena))
        allocation
          (box! a
                UnitAllocationContext
                (UnitAllocationContext
                  :allocator a
                  :resources (ArrayList::new [UnitResource] a)
                  :environment (field config environment)
                  :resource_owner (primitive/cast (ptr UnitAllocationContext) 0)))]
    (set! (.allocation scope) allocation)
    (set! (.prior_allocation scope) (unit-allocation-bind! allocation))
    (set! (.prior_node_id scope)
          (node-id-bind! (box! a NodeIdCell (zeroed NodeIdCell))))
    (set! (.prior_ast scope)
          (ast-unit-bind! (box! a AstUnitState (zeroed AstUnitState))))
    (set! (.jit_work_trace (ast-unit-state))
          (.jit_work_trace (.prior_ast scope)))
    (set! (.prior_parser scope)
          (parser-unit-bind! (box! a
                                   ParserUnitState
                                   (zeroed ParserUnitState))))
    (set! (.prior_resolve scope)
          (resolve-unit-bind! (box! a
                                    ResolveUnitState
                                    (zeroed ResolveUnitState))))
    (set! (.prior_expander scope)
          (expander-unit-bind! (box! a
                                     ExpanderUnitState
                                     (zeroed ExpanderUnitState))))
    (set! (.prior_comptime scope)
          (metastate-unit-bind! (box! a
                                     MetastateUnitState
                                     (zeroed MetastateUnitState))))
    (set! (.prior_loader scope)
          (loader-unit-bind! (box! a
                                   LoaderUnitState
                                   (zeroed LoaderUnitState))))
    (set! (.prior_driver scope)
          (driver-unit-bind! (box! a
                                   DriverUnitState
                                   (zeroed DriverUnitState))))
    (set! (.prior_metahost scope)
          (mh/metahost-unit-bind! (box! a
                                        mh/MetaHostUnitState
                                        (zeroed mh/MetaHostUnitState))))
    (set! (.prior_metaengine scope)
          (metaengine-unit-bind! (box! a
                                       MetaEngineUnitState
                                       (zeroed MetaEngineUnitState))))
    (set! (.prior_interp scope)
          (interp-unit-bind! (box! a
                                   InterpUnitState
                                   (zeroed InterpUnitState))))
    (set! (.prior_native scope)
          (native-unit-bind! (box! a
                                   NativeUnitState
                                   (zeroed NativeUnitState))))
    (set! (.prior_wcg scope)
          (wcg-unit-bind! (box! a WcgUnitState (zeroed WcgUnitState))))
    (set! (.prior_wasm scope)
          (wasm-unit-bind! (box! a
                                 WasmUnitState
                                 (zeroed WasmUnitState))))
    (set! (.prior_mtrace scope)
          (mtr/mtrace-unit-bind! (box! a
                                       mtr/MtraceUnitState
                                       (zeroed mtr/MtraceUnitState))))
    (mtr/mtrace-mem-bind! (primitive/cast (ptr i8) (field scope arena))
                          (fnptr-of driver-mem-src))
    (set! (.profile_arena (mtr/mtrace-unit-state)) (field scope arena))
    (set! (.profile (ast-unit-state)) (tr/trace-env?))
    (set! (.virtual_sources (loader-unit-state)) virtuals)
    (set! (.prebuilt (loader-unit-state)) (.units config))
    (set-opt-level! (.optimization config))
    (set-meta-opt-level! (.meta_optimization config))
    (set-sanitize-mode! (.sanitizer config))
    (set-debug-checks! (.debug config))
    (set-jit-implementation! (.jit_implementation config))
    (set-native-emit-dwarf! (.dwarf config))
    (set-target-arch! (.triple config))
    (set-quiet! (.quiet config))
    (set! (meta-link-box) (.links config))
    (set! (meta-jit-box) (.jit config))
    (set! (interp-extern-hook) (.interp_extern config))
    (set! (interp-abort-hook) (.interp_abort config))
    (set! (wasm-side-cell) (.wasm_side config))
    (set! (wasm-stack-cell) (.wasm_stack config))
    (when source-input
      (set! (.reader_artifact (driver-unit-state)) (.reader_artifact config))
      0)
    (let [uses (if source-input (.uses config) (.owner_uses config))]
      (for [i 0 (len (load uses))] (cli-use-add (get (load uses) i)) 0))
    a))

;;; Exchange the complete dynamic compiler context with a retained unit. The
;;; prior slots hold the caller while active and the unit while suspended. No
;;; resource is released: syntax, semantic maps, and native metaprogram engines
;;; remain owned by the unit until close. This also restores an enclosing unit
;;; when a compiler session is invoked from a metaprogram.
(defn compilation-unit-exchange! [(scope (ptr CompilationUnitSession))] (-> i64)
  (set! (.prior_mtrace scope) (mtr/mtrace-unit-bind! (.prior_mtrace scope)))
  (set! (.prior_wasm scope) (wasm-unit-bind! (.prior_wasm scope)))
  (set! (.prior_wcg scope) (wcg-unit-bind! (.prior_wcg scope)))
  (set! (.prior_native scope) (native-unit-bind! (.prior_native scope)))
  (set! (.prior_interp scope) (interp-unit-bind! (.prior_interp scope)))
  (set! (.prior_metaengine scope)
        (metaengine-unit-bind! (.prior_metaengine scope)))
  (set! (.prior_metahost scope)
        (mh/metahost-unit-bind! (.prior_metahost scope)))
  (set! (.prior_driver scope) (driver-unit-bind! (.prior_driver scope)))
  (set! (.prior_loader scope) (loader-unit-bind! (.prior_loader scope)))
  (set! (.prior_comptime scope) (metastate-unit-bind! (.prior_comptime scope)))
  (set! (.prior_expander scope) (expander-unit-bind! (.prior_expander scope)))
  (set! (.prior_resolve scope) (resolve-unit-bind! (.prior_resolve scope)))
  (set! (.prior_parser scope) (parser-unit-bind! (.prior_parser scope)))
  (set! (.prior_ast scope) (ast-unit-bind! (.prior_ast scope)))
  (set! (.prior_node_id scope) (node-id-bind! (.prior_node_id scope)))
  (set! (.prior_allocation scope)
        (unit-allocation-bind! (.prior_allocation scope)))
  0)

;;; Leave a retained unit dormant between synchronous compiler operations.
(defn compilation-unit-suspend! [(scope (ptr CompilationUnitSession))] (-> i64)
  (if (.active scope)
      (do
        (compilation-unit-exchange! scope)
        (set! (.active scope) false)
        0)
      -1))

;;; Resume under the current caller, which need not be the original caller.
(defn compilation-unit-resume! [(scope (ptr CompilationUnitSession))] (-> i64)
  (if (.active scope)
      -1
      (do
        (compilation-unit-exchange! scope)
        (set! (.active scope) true)
        0)))

(defn compilation-unit-leave! [(scope (ptr CompilationUnitSession))] (-> i64)
  (tr/count "allocation.Expr.count" (.boxed_exprs (ast-unit-state)))
  (tr/count "allocation.Expr.bytes"
            (* (.boxed_exprs (ast-unit-state)) (sizeof Expr)))
  (tr/count "allocation.Type.count" (.boxed_types (ast-unit-state)))
  (tr/count "allocation.Type.bytes"
            (* (.boxed_types (ast-unit-state)) (sizeof Type)))
  (tr/count "allocation.CtVal.count" (.boxed_ctvals (ast-unit-state)))
  (tr/count "allocation.CtVal.bytes"
            (* (.boxed_ctvals (ast-unit-state)) (sizeof ctv/CtVal)))
  ; No metaprogram callback is running here: pipeline calls join/acknowledge each
  ; invocation. Unmap executable resources before detaching their callback state.
  (unit-resources-close! (.allocation scope))
  (expander-pools-close!)
  (impl-qual-free!)
  (res-memo-free! (field (resolve-unit-state) memo))
  (compilation-unit-suspend! scope)
  (close! (field scope arena))
  0)

; Reuse the existing pipeline/backend entry points directly, on the already-deep
; compilation stack. This function neither starts a process nor creates sources.
(defn compile-dump-context [(ctx (ptr DumpCtx))] (-> i64)
  (cond (= (.mode ctx) 3)
          (call-ptr (.dump-fn ctx)
                    (primitive/llvm-ir (ref (dyn Allocator))
                                       [(field ctx a)]
                                       "ret $ret $0")
                    (.src ctx)
                    (.cwd ctx)
                    (.path ctx))
        (= (.mode ctx) 6)
          (call-ptr (.set-fn ctx)
                    (primitive/llvm-ir (ref (dyn Allocator))
                                       [(field ctx a)]
                                       "ret $ret $0")
                    (.modules ctx)
                    (.cwd ctx))
        (= (.mode ctx) 4)
          (build-wasm-program (.a ctx)
                              (.src ctx)
                              (.cwd ctx)
                              (.obj ctx)
                              (.path ctx))
        (native-backend? (.mode ctx))
          (build-native-program (.a ctx)
                                (.src ctx)
                                (.cwd ctx)
                                (.obj ctx)
                                (.path ctx)
                                (.mode ctx))
        (= (.mode ctx) 1)
          (call-ptr (.build-fn ctx)
                    (primitive/llvm-ir (ref (dyn Allocator))
                                       [(field ctx a)]
                                       "ret $ret $0")
                    (.src ctx)
                    (.cwd ctx)
                    (.obj ctx)
                    (.triple ctx)
                    (.path ctx))
        :else
          (call-ptr (.emitir-fn ctx)
                    (primitive/llvm-ir (ref (dyn Allocator))
                                       [(field ctx a)]
                                       "ret $ret $0")
                    (.src ctx)
                    (.cwd ctx)
                    (.triple ctx)
                    (.path ctx))))

(defn build-generated-unit [(ctx (ptr DumpCtx))
                            (unit GeneratedUnit)
                            (obj (slice u8))] (-> i64)
  (let [collector (load (generated-unit-collector-cell))
        scope (primitive/alloc-stack CompilationUnitSession)
        a
          (compilation-unit-enter! scope
                                   (field collector config)
                                   (field collector virtuals)
                                   false
                                   "unit.generated")
        child (primitive/alloc-stack DumpCtx)]
    (set! child (load ctx))
    (set! (.a child) a)
    (set! (.src child) (.body unit))
    (set! (.path child) (sconcat3 a "<generated:" (.name unit) ">"))
    (set! (.obj child) (to-cstr a obj))
    (set! (.dump-fn child) (fnptr-of check-src-program))
    ; A generated unit is one source, whatever shape the owning analysis had.
    (when (= (.mode child) 6) (set! (.mode child) 3) 0)
    (set-quiet! true)
    (set! (generated-owner)
          (GeneratedOwner
            :active true
            :name (.name unit)
            :interface (.interface unit)))
    (set! (.compiling collector) true)
    (tr/profile-event "owner.begin" (.name unit) (tr/trace-now-ms))
    (let [span (tr/span-begin "generated.owner")
          result (compile-dump-context child)]
      (tr/span-end span)
      (tr/count "generated.unit.arena-live"
                (live (field scope arena)))
      (tr/count "generated.unit.arena-reserved"
                (reserved-total (field scope arena)))
      (set! (.compiling collector) false)
      (compilation-unit-leave! scope)
      (tr/profile-event "owner.end" (.name unit) (tr/trace-now-ms))
      result)))

;;; Turn the facade object plus streamed sources into one linker input per unit.
;;; The artifact vector belongs to the caller. Each body is released immediately
;;; after its unit arena; declaration sources survive until the session closes.
(defn finish-generated-units [(ctx (ptr DumpCtx)) (primary i64)] (-> i64)
  (let [collector (load (generated-unit-collector-cell))
        n (if (= (primitive/cast i64 collector) 0) 0 (len (.units collector)))]
    (when (and (> primary 0)
               (or (= (.mode ctx) 1) (native-backend? (.mode ctx))))
      (for [i 0 primary]
        (push! (.objects ctx)
               (build-object-at (.a ctx) (from-cstr (.obj ctx)) primary i))
        0)
      0)
    (if (or (= primary 0) (= n 0))
        primary
        (let [(mut ok) true]
          (for [i 0 n]
            (when (load ok)
              (let [unit (get (.units collector) i)
                    path
                      (if (dump-mode-analysis? ctx)
                          ""
                          (sconcat3 (.a ctx)
                                    (from-cstr (.obj ctx))
                                    ".generated-"
                                    (sconcat (.a ctx)
                                             (i64->str (.a ctx) i)
                                             ".o")))]
                (unless (= path "") (push! (.objects ctx) path) 0)
                (unless (= (build-generated-unit ctx unit path) 1)
                  (set! ok false)
                  0)
                (free [u8] (malloc-allocator) (.body unit))
                (set! (.body (elem (field collector units) i))
                      ""))
              0)
            0)
          (when (and (load ok) (not (dump-mode-analysis? ctx)))
            (let [total (len (load (.objects ctx)))]
              (for [i 0 total]
                (let [old (get (load (.objects ctx)) i)
                      final
                        (build-object-at (.a ctx)
                                         (from-cstr (.obj ctx))
                                         total
                                         i)]
                  (if (= (rename (to-cstr (.a ctx) old)
                                 (to-cstr (.a ctx) final))
                         0)
                      (set! (elem (.objects ctx) i) final)
                      (do
                        (generated-error "session"
                                         "cannot stage a generated object")
                        (set! ok false))))
                0))
            0)
          (if (load ok)
              (if (dump-mode-analysis? ctx)
                  primary
                  (len (load (.objects ctx))))
              0)))))

(defn cleanup-dump-objects! [(ctx (ptr DumpCtx))] (-> i64)
  (for [i 0 (len (load (.objects ctx)))]
    (unlink (to-cstr (.a ctx) (get (load (.objects ctx)) i)))
    0)
  (unless (= (primitive/cast i64 (.obj ctx)) 0) (unlink (.obj ctx)) 0)
  0)

; Emission consumes the facade's semantic model completely. Keep the program's
; collector/config/source buffers/artifacts outside this scope, and return only
; the scalar linker/entry facts that the command still needs. Inspection/lint
; paths deliberately retain their existing command scope across passes.
(defn compile-emitting-facade [(ctx (ptr DumpCtx))
                               (collector (ptr GeneratedUnitCollector))]
  (-> i64)
  (let [parallel (parallel-codegen?)
        test-roots (test-roots-file)
        invocation (load (reader-invocation))
        scope (primitive/alloc-stack CompilationUnitSession)
        a
          (compilation-unit-enter! scope
                                   (field collector config)
                                   (field collector virtuals)
                                   true
                                   "unit.facade")
        facade (primitive/alloc-stack DumpCtx)]
    (set! facade (load ctx))
    (set! (.a facade) a)
    (set-parallel-codegen! parallel)
    (set-test-roots-file! test-roots)
    ; Raw input paths, texts and provider arguments belong to the command and
    ; remain borrowed by its facade. Generated owners are already decoded and
    ; deliberately start with an empty reader invocation.
    (set! (reader-invocation) invocation)
    (tr/profile-event "facade.begin" (.path ctx) (tr/trace-now-ms))
    ; A backend may finish its work after this unit is released (unit-defer!).
    (unit-defer-open!)
    (let [span (tr/span-begin "generated.facade")
          unit-result (compile-dump-context facade)
          entry (load (entry-shape))
          native-facts (load (native-unit-state))]
      (tr/count "generated.facade.arena-live"
                (live (field scope arena)))
      (tr/span-end span)
      (compilation-unit-leave! scope)
      (tr/profile-event "facade.end" (.path ctx) (tr/trace-now-ms))
      (set! (entry-shape) entry)
      (set! (native-unit-state) native-facts)
      (unit-defer-finish! unit-result))))

; pthread start_routine: unpack the context and run the real pipeline on the
; big-stack thread so the recursive passes (parser/checker/codegen/comptime) don't
(defn dump-thread-entry [(arg (ptr i8))] (-> (ptr i8))
  (let [ctx (primitive/cast (ptr DumpCtx) arg)
        collector (primitive/alloc-stack GeneratedUnitCollector)
        allocation (primitive/alloc-stack UnitAllocationContext)
        prior-hook (load (mh/generated-unit-hook))
        prior-virtuals (.virtual_sources (loader-unit-state))
        prior-collector (load (generated-unit-collector-cell))]
    (set! collector (zeroed GeneratedUnitCollector))
    (set! (.a collector) (.a ctx))
    (set! (.units collector) (ArrayList::new [GeneratedUnit] (.a ctx)))
    (set! (.virtuals collector) (ArrayList::new [VirtualSource] (.a ctx)))
    (set! (.mode collector) (.mode ctx))
    (set! (.target collector) (.triple ctx))
    (set! (.artifacts collector) (.objects ctx))
    (set! (.primary collector) (.obj ctx))
    (set! (.config collector) (compilation-unit-config (.a ctx)))
    (set! allocation
          (UnitAllocationContext
            :allocator (.a ctx)
            :resources (ArrayList::new [UnitResource] (.a ctx))
            :environment (field (field collector config) environment)
            :resource_owner (unit-resource-owner (load (unit-allocation-cell)))))
    (let [prior-allocation (unit-allocation-bind! allocation)]
      (set! (generated-unit-collector-cell) collector)
      (set! (.virtual_sources (loader-unit-state)) (field collector virtuals))
      (unless (load (generated-cleanup-registered))
        (atexit (fnptr-of generated-cleanup-at-exit))
        (set! (generated-cleanup-registered) true)
        0)
      (mh/set-generated-unit-hook! (primitive/cast (ptr i8) collector)
                                   (fnptr-of collect-generated-unit))
      (let [r
              (if (or (= (.mode ctx) 1) (native-backend? (.mode ctx)))
                  (compile-emitting-facade ctx collector)
                  (compile-dump-context ctx))]
        (set! (.ok ctx) (finish-generated-units ctx r)))
      (when (= (.ok ctx) 0) (cleanup-dump-objects! ctx) 0)
      ; Facade compiler state belongs to the enclosing command (lint may use it
      ; again on its next pass). Its resource owner, not this policy view, closes it.
      (when (= (primitive/cast i64 (.resource_owner allocation)) 0)
        (unit-resources-close! allocation)
        0)
      (generated-cleanup! collector)
      (set! (mh/generated-unit-hook) prior-hook)
      (set! (.virtual_sources (loader-unit-state)) prior-virtuals)
      (set! (generated-unit-collector-cell) prior-collector)
      (unit-allocation-bind! prior-allocation))
    (main-svc-finish!)
    (primitive/cast (ptr i8) 0)))

; Run the (emit-ir or build) pipeline on a 512 MiB pthread, given a fully-populated
; DumpCtx. Shared by the `emit-ir` and `build` subcommands.
(defn run-on-big-stack [(ctx (ptr DumpCtx))] (-> i64)
  (block :run
    (when (!= (primitive/cast i64 (load (generated-unit-collector-cell)))
              0)
      (ps (stderr)
          "error: nested compiler sessions cannot share a generated-module collector\n")
      (return-from :run 0))
    (set! (.objects ctx)
          (box-al [(slice u8)] (.a ctx) (ArrayList::new [(slice u8)] (.a ctx))))
    ; WASM-hosted build: no pthread. The sandbox is single-threaded and the shadow
    ; stack is already the module's whole reserved stack, so run the pipeline inline
    ; (dump-thread-entry writes ctx.ok exactly as the spawned thread would). Covers both
    ; the side-module (meta-wasm-active?) and interpreter (wasm-sandbox?) wasm entries.
    (if (or (meta-wasm-active?) (wasm-sandbox?))
        (do (dump-thread-entry (primitive/cast (ptr i8) ctx)) (.ok ctx))
        (let [(mut attr) (zeroed (array i8 64))
              (mut tid) (zeroed (ptr i8))]
          (pthread_attr_init (primitive/cast (ptr i8)
                                             (mut attr)))
          ; 512 MiB. The 2 MiB floor that justified 32 MiB was measured on HAND-WRITTEN
          ; source, where nesting is shallow because a human wrote it. Macro-generated code
          ; is the case that measurement missed: `cond` expands to nested ifs, so an
          ; 800-clause dispatch table is 800 levels deep, and the pipeline recurses per level
          ; at ~75 KB a level (entry-block allocas — see cg-entry-alloca). At 32 MiB that
          ; ran out at ~450 levels and died with a bare signal and zero output.
          ; This is virtual reservation, not committed memory: pages fault in on use, so the
          ; ceiling costs nothing until a deep program actually needs it. parse-depth-limit
          ; (parser.coil) sits well under the cliff this buys, so a too-deep program gets a
          ; located diagnostic rather than a crash.
          (pthread_attr_setstacksize (primitive/cast (ptr i8)
                                                     (mut attr))
                                     (worker-stack-size))
          (pthread_attr_setguardsize (primitive/cast (ptr i8)
                                                     (mut attr))
                                     (worker-guard-size))
          ; COIL_META_MAIN=1: this (the MAIN) thread services metaprogram calls while
          ; the pipeline runs — AppKit metaprograms need the real main thread. The loop
          ; is a no-op when the service was never initialized.
          (when (meta-main?) (main-svc-init!))
          (pthread_create (primitive/cast (ptr i8)
                                          (mut tid))
                          (primitive/cast (ptr i8)
                                          (mut attr))
                          (fnptr-of dump-thread-entry)
                          (primitive/cast (ptr i8) ctx))
          (pthread_attr_destroy (primitive/cast (ptr i8)
                                                (mut attr)))
          (main-svc-loop)
          (pthread_join tid
                        (primitive/cast (ptr i8) 0))
          ; the thread wrote its pipeline result (1 ok / 0 failed) into ctx.ok.
          (.ok ctx)))))

; Populate a mode-3 DumpCtx and run the chosen dump wrapper on the big-stack pthread.
(defn run-dump-on-big-stack [(a (dyn Allocator))
                             (src (slice u8))
                             (cwd (slice u8))
                             (path (slice u8))
                             (dfn (fnptr (cc/C)
                                         [(ref (dyn Allocator))
                                          (slice u8)
                                          (slice u8)
                                          (slice u8)]
                                         i64))] (-> i64)
  (let [(mut ctx) (zeroed DumpCtx)]
    (set! (.a ctx) a)
    (set! (.src ctx) src)
    (set! (.cwd ctx) cwd)
    (set! (.path ctx) path)
    (set! (.mode ctx) 3)
    (set! (.obj ctx) (primitive/cast (ptr i8) 0))
    (set! (.triple ctx) (target-triple))
    (set! (.self ctx) "")
    (set! (.ok ctx) 0)
    (set! (.dump-fn ctx) dfn)
    (run-on-big-stack (mut ctx))))

; The conventional object path for explicit `emit-obj` output and temporary
; `run` cleanup. Normal `build` objects live in a private temporary directory;
; they are linker inputs, not user-visible build artifacts.
; `out_path.with_extension("o")`: REPLACE the final path-component extension with
; `o` (`a.out` -> `a.o`, `foo.coil` -> `foo.o`), or APPEND `.o` when the basename
; has none (`foo` -> `foo.o`). A `.` in a parent directory doesn't count; a leading
; dot (`.foo`) is not an extension. This keeps the `.o` name — hence any linker
; diagnostic that prints it — for ANY `-o`.
(defn obj-path [(a (dyn Allocator)) (out (slice u8))] (-> (slice u8))
  (let [n (len out)
        (mut slash) -1
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (when (= (primitive/cast i64 (get out (load i)))
                         47)
                  (set! slash (load i)))
                (set! i (primitive/iadd (load i) 1)))))
    (let [(mut dot) -1
          (mut j) (primitive/iadd (load slash) 1)]
      (loop (if (>= (load j) n)
                (break)
                (do
                  (when (= (primitive/cast i64 (get out (load j)))
                           46)
                    (set! dot (load j)))
                  (set! j (primitive/iadd (load j) 1)))))
      (let [(mut sb) (StrBuf::new a)]
        (if (> (load dot) (primitive/iadd (load slash) 1))
            (do
              (push-str! (mut sb) (subslice out 0 (load dot)))
              (push-str! (mut sb) ".o"))
            (do (push-str! (mut sb) out) (push-str! (mut sb) ".o")))
        (str (load sb))))))

(defn wasm-target? [(triple (ptr i8))] (-> bool)
  (if (= (primitive/cast i64 triple) 0)
      false
      (let [s (from-cstr triple)]
        ; `wasm32` alone is the same target as wasm32-unknown-unknown
        (or (starts-with s "wasm32") (starts-with s "wasm64")))))

; `read-file` maps ENOENT to "" — right for the loader's module probing, WRONG for a
; path a user typed. An empty program compiles clean to an object
; with no `main`, so a mistyped filename surfaced as an arm64 linker error about `_main`
; that named neither the file nor the mistake — and `fmt --write` on a missing path
; FABRICATED the file. `read-file-opt` already separates "missing" from "empty" and its
; own comment says so; this is the one door every user-supplied path goes through.
; `rc` is the process exit code for a missing file: 1 for build/emit (what clang
; does), 2 for `fmt --check`, where 1 already means "this file is not formatted"
; and a CI gate must be able to tell that apart from a broken invocation.
;
; A directory is the same mistake in another spelling: it reads as empty text, so
; `coil run .` built an empty program and failed at the linker for want of `main`,
; and `coil check .` reported success on nothing. A project directory never gets
; this far for run, build and check: `enter-project!` has already entered it.
(defn read-src-rc [(a (dyn Allocator)) (path (ptr i8)) (rc i64)] (-> (slice u8))
  (if (dir? path)
      (let [w (stderr)]
        (ps w "error: '")
        (ps w (from-cstr path))
        (ps w "' is a directory, not a source file")
        (wb w 10)
        (ps w
            "note: `coil run`, `build` and `check` take a directory only when it holds a Coil.toml")
        (wb w 10)
        (exit (primitive/cast i32 rc))
        "")
      (match (read-file-opt a path)
        (Some [s] s)
        (None []
              (let [w (stderr)]
                (ps w "error: no such file: '")
                (ps w (from-cstr path))
                (ps w "'")
                (wb w 10)
                (exit (primitive/cast i32 rc))
                "")))))

(defn read-src [(a (dyn Allocator)) (path (ptr i8))] (-> (slice u8))
  (read-src-rc a path 1))

(extern atexit :cc (cc/C) [(fnptr (cc/C) [] i64)] (-> i32))

(extern unsetenv :cc (cc/C) [(ptr i8)] (-> i32))

; `--debug-checks` turns on the library-level safety checks (slice bounds,
; poison-on-free). The checks run inside MACROS that branch on `(primitive/debug-checks?)` —
; a compile-time code op (metastate.coil) read at expansion time — so the driver flips the
; host-side cell here, BEFORE expansion runs, exactly like the target arch. Off by
; default: the guard macro then expands to the plain unchecked op (zero cost).
; --debug-checks also auto-applies the bundled stack-return lint (mem-8): the driver
; --uses it, so its (checker …) runs over the program — no explicit import needed.
; Off, the module is never loaded (zero cost).
(defn enable-debug-checks! [] (-> i64)
  (set-debug-checks! 1)
  (cli-use-add "coil.lint.allocator")
  (cli-use-add "coil.lint.stack-return")
  0)

; Select exactly one sanitizer. ASan, TSan, and MSan use incompatible process-wide
; runtimes; UBSan is kept exclusive too so every artifact has one reproducible mode.
(defn select-sanitizer! [(mode i64) (name (slice u8))] (-> i64)
  (let [old (sanitize-mode)]
    (if (or (= old 0) (= old mode))
        (set-sanitize-mode! mode)
        (do
          (ps (stderr)
              "error: sanitizer modes cannot be combined; already selected one before --sanitize=")
          (ps (stderr) name)
          (wb (stderr) 10)
          (exit 1)
          0))))

(defn apply-sanitizer-flag! [(arg (slice u8))] (-> i64)
  (cond (= arg "--sanitize=address") (select-sanitizer! 1 "address")
        (= arg "--sanitize=thread") (select-sanitizer! 2 "thread")
        (= arg "--sanitize=memory") (select-sanitizer! 3 "memory")
        :else (select-sanitizer! 4 "undefined")))

(defn apply-jit-flag! [(arg (slice u8))] (-> i64)
  (let [name (subslice arg 6 (len arg))]
    (match (jit-implementation-named name)
      (Some [implementation] (set-jit-implementation! implementation))
      (None []
            (do
              (ps (stderr) "error: --jit must be llvm or tpde, not `")
              (ps (stderr) name)
              (ps (stderr) "`\n")
              (exit 1)
              0)))))

;;; The implementation `--jit=` or a manifest's `jit` key names.
(defn jit-implementation-named [(name (slice u8))]
  (-> (Option JitImplementation))
  (cond (= name "llvm") (Some (JitLlvm))
        (= name "tpde") (Some (JitTpde))
        :else (None [JitImplementation])))

(defn debug-checks? [] (-> bool)
  (debug-checks-on?))

; `--quiet` — drop build's "wrote <path>" line, and nothing else.
;
; `run` and `test` drive `build` as a subprocess purely to obtain a temp executable,
; so that line names a path the user never asked for and never sees again. They used
; to hide it by redirecting the whole build to /dev/null — which also discarded
; everything a METAPROGRAM prints while it compiles. A transform reporting what it
; rewrote is exactly the output you reach for `run` to see, and it went to the same
; place as the noise. Suppress the one line at its source instead; diagnostics were
; always on stderr and are unaffected either way.
(defstruct QuietFlag [(v i64)])

(defn quiet-cell [] (-> (ptr QuietFlag))
  (field (driver-unit-state) quiet))

(defn set-quiet! [(on bool)] (-> i64)
  (set! (.v (quiet-cell)) (if on (do 1) 0))
  0)

(defn quiet? [] (-> bool)
  (!= (.v (quiet-cell)) 0))

; A file of `(deftest …)`/`(defprop …)` has NO `main` until coil.test-runner's
; transform gives it one, and that transform is opt-in — `coil test` loads it with
; `--use coil.test-runner`, `coil build`/`coil run` deliberately do not, so a
; library or a freestanding program never gets an entry point it did not ask for.
; Point `coil run` at a test file and the only thing that goes wrong is the LINKER
; reporting an undefined `_main`: it names neither the file, nor the tests in it,
; nor the command that runs them. That is the same failure shape `read-src-rc`
; exists to prevent, so the pipeline remembers the two facts needed to say it
; properly, and the link-failure path spends them.
(defstruct EntryShape [(tests i64) (has-main bool)])

(defn entry-shape [] (-> (ptr EntryShape))
  (field (driver-unit-state) entry))

;;; The last dotted component of a monomorphized name: `m.coil-test$passes` is a test,
;;; and so is `some.deep.module.coil-test$passes`.
(defn entry--leaf [(name (slice u8))] (-> (slice u8))
  (let [n (len name)
        (mut i) n
        (mut at) 0]
    (loop (if (= (load i) 0)
              (break)
              (do
                (set! i (primitive/isub (load i) 1))
                (when (= (get name (load i)) (: 46 u8))  ; '.'
                  (set! at (primitive/iadd (load i) 1))
                  (break)))))
    (subslice name (load at) n)))

;;; Count the program's tests and note whether anything called `main` survived mono.
(defn record-entry-shape! [(p (ptr Program))] (-> i64)
  (let [fs (load (field p funcs))
        n (len fs)
        (mut tests) 0
        (mut has-main) false
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (let [leaf (entry--leaf (.name (elem fs (load i))))]
                  (when (starts-with leaf "coil-test$")
                    (set! tests (primitive/iadd (load tests) 1)))
                  (when (= leaf "main") (set! has-main true)))
                (set! i (primitive/iadd (load i) 1)))))
    (set! (.tests (entry-shape)) (load tests))
    (set! (.has-main (entry-shape)) (load has-main))
    0))

(defn apply-opt-flag! [(arg (slice u8))] (-> i64)
  (set-opt-level! (primitive/isub (primitive/cast i64 (get arg 2)) 48)))

(defn apply-meta-opt-flag! [(arg (slice u8))] (-> i64)
  (let [v (subslice arg 11 (len arg))]
    (if (or (!= (len v) 1)
            (< (primitive/cast i64 (get v 0)) 48)
            (> (primitive/cast i64 (get v 0)) 51))
        (let [w (stderr)]
          (ps w "error: --meta-opt= expects 0, 1, 2 or 3, got '")
          (ps w v)
          (ps w "'")
          (wb w 10)
          (exit 1)
          0)
        (set-meta-opt-level! (primitive/isub (primitive/cast i64 (get v 0)) 48)))))

; Register every `--use <namespace>` in argv on the CLI use list. For the subcommands
; that compile in this process and so have no argument loop of their own to hang it on.
(defn argv-apply-uses! [(argc i32) (argv (ptr (ptr i8)))] (-> i64)
  (let [option-count (argv-option-count argc argv)
        (mut i) 2]
    (loop (if (>= (primitive/iadd (load i) 1) (primitive/cast i64 option-count))
              (break)
              (let [arg (from-cstr (load (index argv (load i))))
                    value
                      (from-cstr (load (index argv (primitive/iadd (load i) 1))))]
                (cond (= arg "--use")
                        (do
                          (cli-use-add value)
                          (set! i (primitive/iadd (load i) 2))
                          0)
                      (= arg "--lint-param")
                        (do
                          (lint-param-cli-add value)
                          (set! i (primitive/iadd (load i) 2))
                          0)
                      :else (set! i (primitive/iadd (load i) 1)))))))
  0)

(defn build-object-at [(a (dyn Allocator))
                       (base (slice u8))
                       (count i64)
                       (index i64)] (-> (slice u8))
  (if (= count 1)
      base
      (cat3-d a base (cat3-d a ".part-" (cat3-d a (i64->str a index) ".o")))))

; The input paths cross to the big-stack pipeline thread through this box (the
; DumpCtx mode-3 shape carries only a src cwd path). `np` is main's raw arity;
; `loaded` selects the code-base contract: a one-Code-param main given FILE
; inputs receives the whole LOADED program — the files become additional load
; roots in the SAME pipeline as the metaprogram, so one expand and one check
; cover both, the semantic model answers about the input, and located
; diagnostics point into the input files. Stdin (or multi-param mains) stays
; the raw-fragment contract for pipes and macro experiments.
; `regmode`: 1 = a Code-signed `main` (run it), 2 = no main at all but the
; file REGISTERS metaprograms — `(transform F …)` / `(checker F …)` — and the
; registration IS the entry declaration: `coil run` applies the registered
; stack to the input, no wrapper needed. `regs` holds the surface names in
; registration order; `regkind`: 0 = transform, 1 = checker. A
; `(reader-provider "MOD" FN)` declaration is an entry too: `rdmod`/`rdfn`
; carry it, and the reader runs FIRST, over the inputs' raw bytes.
(defstruct CodeMainBox
  [(init i64)
   (np i64)
   (loaded i64)
   (regmode i64)
   (regs (ArrayList (slice u8)))
   (regkind (ArrayList i64))
   (rdmod (slice u8))
   (rdfn (slice u8))
   (inputs (ArrayList (slice u8)))
   (insids (ArrayList i64))
   (intexts (ArrayList (slice u8)))])

(defn lint-param-cli-add [(spec (slice u8))] (-> i64)
  (if (lint-param-add-spec spec)
      0
      (do
        (ps (stderr) "error: --lint-param expects a non-empty KEY=VALUE\n")
        (exit 2)
        0)))

;;; COIL_MTRACE=mem source hook: the root arena's monotonic byte counter, lent
;;; to mtrace as an opaque (ctx, fn) pair so mtrace needn't import the arena.
(defn driver-mem-src [(ctx (ptr i8))] (-> i64)
  (total (primitive/cast (ptr scratch/ScratchArena) ctx)))
