; src/compiler/ast.coil — self-host Coil compiler, ast module.

(module coil.compiler.ast)
(import "coil.compiler.retained_heap" :as retained-heap)
(import "coil.primitive" :as primitive)
(import "coil.alloc" :as alloc :use *)
(import "coil.scratch" :as scratch)
(import "coil.result" :use *)
(import "coil.slice" :use *)
(import "coil.str" :use *)
(import "coil.mem" :use *)
(import "coil.arraylist" :use *)
(import "coil.hashmap" :use *)
(import "coil.io" :use *)
(import "coil.control" :use *)
(import "coil.try" :use *)
(import "coil.reader" :use *)
(import "coil.hashmap" :use *)  ; the scope map's node index
(import "coil.compiler.unit_state" :use *)
(import "coil.compiler.stdlib_manifest" :as sm)  ; which namespaces the toolchain owns
(import "coil.compiler.resolution_base" :as resbase)

; These registries describe one compilation, never a compiler process. The
; driver owns the state and arena; temporary nested scopes restore the previous
; state pointer without copying or abandoning any registry's backing storage.
(defstruct AstUnitState
  [(type_refs TypeResBox)
   (value_refs ValueResBox)
   (core_providers CoreProvBox)
   (core_declarations CoreDeclBox)
   (source_modules SrcModBox)
   (shadow_calls ShadowBox)
   (scope_at ScopeAtBox)
   (profile bool)
   (boxed_exprs i64)
   (boxed_types i64)
   (boxed_ctvals i64)
   (jit_work_trace bool)
   (declaration_aliases DeclAliasBox)
   ; Accepted resolution mappings are persistent and owned by CompilerRevision.
   ; This candidate holds only entries produced by its own qualification pass.
   (resolution_base (ptr resbase/ResolutionBase))
   ; Nonzero while a compile-time constant's value is checked: an array spilled
   ; to borrow it as a slice there goes to static storage, because the value the
   ; fold reads back outlives the frame that computed it.
   (const_value_depth i64)
   (source_facts SourceFacts)
   (source_import_origins (HashMap (slice u8) SourceImportOrigin))
   (source_import_origins_ready bool)])

(defn ast-unit-state-cell [] (-> (ptr (ptr AstUnitState)))
  (primitive/alloc-static (ptr AstUnitState)))

(defn ast-unit-state [] (-> (ptr AstUnitState))
  (let [active (load (ast-unit-state-cell))]
    (if (= (primitive/cast i64 active) 0)
        (primitive/alloc-static AstUnitState)
        active)))

(defn ast-unit-bind! [(next (ptr AstUnitState))] (-> (ptr AstUnitState))
  (let [prior (ast-unit-state)]
    (set! (ast-unit-state-cell) next)
    prior))

; Parser-lowered lexical resolver keys. These helpers keep the representation
; private and let resolution/diagnostics recover the source spelling.
(defn scoped-ident? [(name (slice u8))] (-> bool)
  (let [n (len name)]
    (and (> n (primitive/cast i64 7))
         (and (= (primitive/cast i64 (get name 0)) 36)
              (and (= (primitive/cast i64 (get name 1)) 115)
                   (and (= (primitive/cast i64 (get name 2)) 99)
                        (and (= (primitive/cast i64 (get name 3)) 111)
                             (and (= (primitive/cast i64 (get name 4)) 112)
                                  (= (primitive/cast i64 (get name 5)) 101)))))))))

(defn scoped-ident-raw [(name (slice u8))] (-> (slice u8))
  (if (not (or (scoped-ident? name)
               (and (> (len name) (primitive/cast i64 7))
                    (and (= (primitive/cast i64 (get name 0)) 36)
                         (and (= (primitive/cast i64 (get name 1)) 100)
                              (and (= (primitive/cast i64 (get name 2)) 97)
                                   (and (= (primitive/cast i64 (get name 3))
                                           116)
                                        (and (= (primitive/cast i64
                                                                (get name 4))
                                                117)
                                             (= (primitive/cast i64
                                                                (get name 5))
                                                109)))))))))
      name
      (let [n (len name)
            (mut i) 6]
        (loop (if (>= (load i) n)
                  (break)
                  (if (= (primitive/cast i64 (get name (load i))) 36)
                      (break)
                      (set! i (primitive/iadd (load i) 1)))))
        (if (< (load i) n) (subslice name (primitive/iadd (load i) 1) n) name))))

(defn scoped-ident-module [(name (slice u8))] (-> (slice u8))
  (if (not (scoped-ident? name))
      ""
      (let [n (len name)
            (mut at) 6
            (mut end) 6]
        (loop (if (>= (load at) n)
                  (break)
                  (if (= (primitive/cast i64 (get name (load at))) 64)
                      (break)
                      (set! at (primitive/iadd (load at) 1)))))
        (set! end (primitive/iadd (load at) 1))
        (loop (if (>= (load end) n)
                  (break)
                  (if (= (primitive/cast i64 (get name (load end))) 36)
                      (break)
                      (set! end (primitive/iadd (load end) 1)))))
        (if (or (>= (load at) n) (>= (load end) n))
            ""
            (subslice name (primitive/iadd (load at) 1) (load end))))))

; The length of an array or the lane count of a vector: a literal, or an
; integer value parameter. Generic extents participate in the same substitution
; as element types, and must be concrete before layout/codegen.
(defsum Extent
  (FixedExtent [(value i64)])
  (ParamExtent [(name (slice u8))]))

; The value of a compile-time generic argument. Two constants are the same
; argument exactly when their arms and values are equal.
(defsum ConstValue
  (ConstInt [(value i64)])
  (ConstBool [(value bool)])
  (ConstKeyword [(name (slice u8))]))

(defsum Type
  (TInt [(bits i64) (signed bool)])
  (TFloat [(bits i64)])
  (TBool [])
  (TVoid [])
  (TPtr [(inner (ptr Type))])
  (TRef [(mutable bool) (inner (ptr Type))])
  (TStruct [(name (slice u8))])
  (TArray [(elem (ptr Type)) (n Extent)])
  (TSlice [(elem (ptr Type))])
  (TVec [(elem (ptr Type)) (n Extent)])
  (TFn [(cc (slice u8)) (params (ptr (ArrayList Type))) (ret (ptr Type))])
  (TApp [(name (slice u8)) (args (ptr (ArrayList Type)))])
  (TNever [])
  (TCode [])
  (TExternRef [])  ; wasm `externref`: an opaque, GC-managed host reference
  ; A growable Code list UNDER CONSTRUCTION (docs/design/META_MEMORY.md phase 4):
  ; `code-list-new` makes one, `code-list-push!` may only push onto one, and
  ; `code-list-done` (or unquoting it into a template) freezes it into Code.
  ; Distinct from TCode so a metaprogram cannot mutate a finished list in place
  ; nor read a list still being built. New arms append here so every existing
  ; discriminant stays stable.
  (TCodeBuilder [])
  ; A compile-time value used as a generic argument: `4`, `true` or `:meters`.
  ; Never a runtime value type.
  (TConst [(value ConstValue)])
  ; The type of an expression a provisional check could not type. It exists only
  ; in partial semantic models; the authoritative check never produces it.
  (TError []))

(defn fixed-vec [(elem (ptr Type)) (lanes i64)] (-> Type)
  (TVec elem (FixedExtent lanes)))

(defn fixed-array [(elem (ptr Type)) (n i64)] (-> Type)
  (TArray elem (FixedExtent n)))

; Called only after specialization has proved a concrete, positive extent.
(defn extent-value [(width Extent)] (-> i64)
  (match width
    (FixedExtent [n] n)
    (ParamExtent [_] (do (abort) 0))))

; A function parameter (name + type).
(defstruct Param
  [(name (slice u8))
   (ty Type)
   (bid i64)
   (owned_type (ptr Type))
   (positional_only bool)])

; A struct/variant field (name + type).
(defstruct Field [(name (slice u8)) (ty Type)])

; Compiler primitives are ordinary module definitions. `opcode` is compiler-only
; lowering metadata; it is never itself entered into source scope. Primitive aliases
; retain the target definition's identity rather than becoming wrapper functions.
(defstruct PrimitiveDef
  [(module (slice u8)) (name (slice u8)) (opcode (slice u8))])

(defstruct PrimitiveAlias
  [(module (slice u8)) (name (slice u8)) (target (slice u8))])

; The loader/resolver computes the primitive bindings visible in one module. The parser
; consumes only this resolved table, so it never decides primitive-ness from source text.
(defstruct PrimitiveBinding
  [(source_name (slice u8))
   ; Empty for ordinary authored lookup. Hygienic template heads use the
   ; definition module carried by their syntax object to select this binding.
   (source_module (slice u8))
   (opcode (slice u8))])

; ExprKind — parser-produced variants followed by checker/mono-only lowering nodes.
; SpillRef, MakeSlice, DynDispatch, MakeDyn, Construct, StaticRef and TraitCall are
; never produced by the parser.
; Numeric op tags: BinOp/CmpOp/Storage/TypeQuery/FieldMeta/CodeOp are stored as
; i64 codes (see the d-*-tag dumpers for the code->string mapping). Storage 3 is
; the checker-only frame slot used for implicit mutable/aggregate let places;
; unlike source-level stack allocation it must be allocated once in the entry block.
; Target-neutral vector operations. These survive checking with explicit
; operand/result types and are lowered after generic specialization.
(defsum VectorOp
  (VectorZero) (VectorSplat) (VectorExtract) (VectorInsert) (VectorLanes)
  (VectorIota) (VectorMaskLow)
  (VectorLoad) (VectorStore) (VectorLoadAligned) (VectorStoreAligned)
  (VectorAdd) (VectorSub) (VectorMul) (VectorDiv)
  (VectorAnd) (VectorOr) (VectorXor) (VectorNot)
  (VectorShl) (VectorShr) (VectorAShr)
  (VectorEq) (VectorNe) (VectorLt) (VectorLe) (VectorGt) (VectorGe)
  (VectorSelect) (VectorMaskBits) (VectorBitsMask)
  (VectorBitcast) (VectorConvert)
  (VectorWidenLow) (VectorWidenHigh) (VectorNarrow) (VectorNarrowSat)
  (VectorShuffle) (VectorTable)
  (VectorCompress) (VectorCompressStore) (VectorExpandLoad)
  (VectorReduceAdd) (VectorReduceOr) (VectorReduceAnd) (VectorReduceXor)
  (VectorReduceMin) (VectorReduceMax)
  (VectorPopcount) (VectorClz) (VectorCtz) (VectorBswap) (VectorBitReverse)
  (VectorAddSat) (VectorSubSat) (VectorMin) (VectorMax)
  (VectorAbs) (VectorNeg) (VectorRotl) (VectorRotr)
  (VectorMaskedLoad) (VectorMaskedStore) (VectorGather) (VectorScatter)
  (VectorFma) (VectorSqrt) (VectorFloor) (VectorCeil) (VectorTrunc) (VectorRound)
  (VectorIsNan) (VectorIsFinite)
  (VectorScanAdd) (VectorScanXor) (VectorScanOr) (VectorScanMax))

(defsum ExprKind
  (EInt [(v i64)])
  (EStr [(s (slice u8))])
  (ECStr [(s (slice u8))])
  (EVar [(name (slice u8))])
  (EZeroed [(ty Type)])
  (EBorrow [(mutable bool) (place (ptr Expr))])
  (ELet [(binds (ptr (ArrayList Bind))) (body (ptr (ArrayList Expr)))])
  (EBin [(op i64) (lhs (ptr Expr)) (rhs (ptr Expr))])
  ; Integer unary operations: 0 not, 1 clz, 2 ctz, 3 popcount, 4 bswap.
  (EIntUnary [(op i64) (inner (ptr Expr))])
  (EFloat [(bits i64)])
  (EBool [(b bool)])
  (ECmp [(op i64) (lhs (ptr Expr)) (rhs (ptr Expr))])
  (EIf [(cnd (ptr Expr)) (thn (ptr Expr)) (els (ptr Expr))])
  (EDo [(body (ptr (ArrayList Expr)))])
  (ECall [(func (slice u8))
          (type_args (ptr (ArrayList Type)))
          (args (ptr (ArrayList Expr)))])
  ; A source call whose arguments are written as `:field value` pairs. Resolution
  ; preserves this until checking can prove the head is a struct/sum constructor,
  ; validate the field names, and lower the arguments to declaration order.
  (ENamedCall [(func (slice u8))
               (type_args (ptr (ArrayList Type)))
               (names (ptr (ArrayList (slice u8))))
               (args (ptr (ArrayList Expr)))])
  ; `init` is null for the traditional zero/uninitialised form and points at a
  ; checked compile-time expression for `(alloc-static T INITIAL)`.
  ; An explicit linker name belongs to the actual static cell, never a pointer
  ; proxy. None retains the compiler-generated per-site identity.
  (EAlloc [(storage i64)
           (ty Type)
           (init (ptr Expr))
           (symbol (Option (slice u8)))])
  (EField [(p (ptr Expr)) (fname (slice u8))])
  ; Source `.field` before checking. Unlike explicit low-level EField, an
  ; accessor may read a pointer-valued intermediate when another accessor uses
  ; it as its receiver. Checking lowers this to EField/ELoad nodes.
  (EAccessorField [(p (ptr Expr)) (fname (slice u8))])
  (ELoad [(inner (ptr Expr))])
  (EStore [(p (ptr Expr)) (val (ptr Expr))])
  ; Compiler-generated initialization of storage which has never held a live
  ; value. Unlike EStore, ownership elaboration must not drop the destination.
  (EInitStore [(p (ptr Expr)) (val (ptr Expr))])
  (EIndex [(p (ptr Expr)) (idx (ptr Expr))])
  (ECast [(ty Type) (inner (ptr Expr))])
  (ESizeOf [(ty Type)])
  (EAlignOf [(ty Type)])
  (EOffsetOf [(ty Type) (fname (slice u8))])
  (EBitGet [(p (ptr Expr)) (fname (slice u8))])
  (EBitSet [(p (ptr Expr)) (fname (slice u8)) (val (ptr Expr))])
  (EFree [(inner (ptr Expr))])
  (EErase [(trait_name (slice u8)) (inner (ptr Expr))])
  (EMatch [(scrut (ptr Expr)) (arms (ptr (ArrayList Arm)))])
  (EFnPtrOf [(name (slice u8))])
  (ECallPtr [(fp (ptr Expr)) (args (ptr (ArrayList Expr)))])
  (ELoop [(label (Option (slice u8))) (body (ptr (ArrayList Expr)))])
  (EBreak [(label (Option (slice u8))) (value (Option (ptr Expr)))])
  (EContinue [(label (Option (slice u8)))])
  (ELlvmIr [(result Type) (args (ptr (ArrayList Expr))) (body (slice u8))])
  (ETypeQuery [(q i64) (ty Type)])
  (EFieldMeta [(meta i64) (ty Type) (idx (ptr Expr))])
  (EFieldIndex [(ty Type) (name (ptr Expr))])
  (EQuote [(form (ptr Sexp))])
  (ECodeOp [(op i64) (args (ptr (ArrayList Expr)))])
  (EQuasi [(q Quasi)])
  (EComptime [(inner (ptr Expr))])
  ; Type ascription `(: value type)` — a general expression that synthesizes `value`
  ; with `type` as the expected type (so an otherwise-stranded type argument can be
  ; supplied) and yields it at `type`. The checker LOWERS it away (to the coerced
  ; inner value), so it never survives into mono/codegen. Same field shape as ECast,
  ; but it type-CHECKS rather than numeric-converts.
  (EAscribe [(ty Type) (inner (ptr Expr))])
  ; Brackets in expression position. Checking infers the element type and lowers
  ; this to ordinary stack-place initialization before mono/codegen.
  (EArrayLit [(items (ptr (ArrayList Expr)))])
  ; ---- check-introduced variants (parser/resolver never emit these;
  ; the type-checker LOWERS calls/borrows/etc. into them). Mirror.
  (ESpillRef [(inner (ptr Expr))])
  ; Ownership-only marker: a checked affine value is consumed from this place.
  ; Monomorphization resolves it to either the place (pointer owning ABI) or a
  ; load from the place (generic value ABI); it must not reach a backend.
  (EMovePlace [(place (ptr Expr))])
  (EMakeSlice [(data (ptr Expr)) (elem Type) (len Extent)])
  (EConstruct [(sum (slice u8))
               (variant (slice u8))
               (args (ptr (ArrayList Expr)))])
  (ETraitCall [(trait_name (slice u8))
               (method (slice u8))
               (self_tp (slice u8))
               (args (ptr (ArrayList Expr)))])
  (EDynDispatch [(dyn_struct (slice u8))
                 (vtable_struct (slice u8))
                 (method_index i64)
                 (cc (slice u8))
                 (params (ptr (ArrayList Type)))
                 (ret Type)
                 (recv (ptr Expr))
                 (args (ptr (ArrayList Expr)))])
  (EMakeDyn [(dyn_struct (slice u8))
             (vtable_struct (slice u8))
             (methods (ptr (ArrayList (slice u8))))
             (inner (ptr Expr))])
  ; Check-introduced lexical cleanup region. Evaluate `body`, preserve its value,
  ; execute `cleanups` in source-provided order, then yield the preserved value.
  ; Drop elaboration supplies reverse-initialization order and rewrites escaping
  ; control edges before this reaches a backend.
  (ECleanup [(body (ptr Expr)) (cleanups (ptr (ArrayList Expr)))])
  (EStaticRef [(name (slice u8))])
  ; Source `(fn [args...] body...)`. Appended for bootstrap ABI stability. The
  ; checker requires a callable context, rejects captures, and lowers this to an
  ; ordinary generated function plus EFnPtrOf before mono/codegen.
  (EAnonFn [(params (ptr (ArrayList (slice u8))))
            (body (ptr (ArrayList Expr)))])
  ; Only constructed by alloc-static :elements. Its expected type is the
  ; allocation's array type; absent elements are link-time zero. Keep explicit
  ; entries compact through every pass, never materialize the implicit tail.
  (EStaticArray [(indices (ptr (ArrayList i64))) (items (ptr (ArrayList Expr)))])
  ; Internal checked pattern projection. 0 = nominal struct assertion, 1 = sequence
  ; prefix assertion, 2 = element, 3 = suffix, 4 = checked field projection. All lower before monomorphization.
  (EPattern [(op i64) (ty Type) (inner (ptr Expr)) (index i64)])
  (EVector [(op VectorOp)
            (result Type)
            (operand_types (ptr (ArrayList Type)))
            (args (ptr (ArrayList Expr)))])
  ; A value parameter `(const NAME TYPE)` used as an expression. The checker
  ; produces it with the declared type; monomorphization replaces it with the
  ; specialized constant. It never reaches a backend.
  (EConstParam [(name (slice u8)) (ty Type)])
  ; Checked named-constructor initialization. Native lowering uses zeroed storage;
  ; live lowering constructs against the pinned logical schema's defaults.
  (ERecordInit [(ty Type)]))

; `node-id` mirrors Sexp.node-id — parse-expr copies the source node's id so the type-checker
; can record an expression's inferred type keyed by node identity (see do-synth /
; type-of). Never dumped. Synthesized exprs (mk-expr default) get -1.
(defstruct Expr
  [(kind ExprKind) (lo i64) (hi i64) (source i64) (ctxt i64) (node-id i64)])

; A let binding (name, mutable, value). `bid` is checker-owned lexical identity;
; parser/generated bindings start at 0, checked owning bindings retain the same
; identity used by binding-of/move analysis. It is deliberately not dumped.
; `owned_type` is null except on a checked affine owner and is likewise semantic
; metadata, not source syntax.
(defstruct Bind
  [(name (slice u8))
   (mutable bool)
   (value Expr)
   (bid i64)
   (owned_type (ptr Type))])

; A match arm (variant, bound names, body).
;
; The catch-all arm `(_ …)` is an ordinary arm whose "variant" is the literal `_`. It
; names no variant, binds nothing, and — enforced by the parser — can only be the last
; arm. Every consumer that maps an arm to a variant index has to ask first.
(defstruct Arm
  [(variant (slice u8)) (binds (ptr (ArrayList (slice u8)))) (body Expr)])

(defn arm-wildcard? [(ap (ptr Arm))] (-> bool)
  (= (.variant ap) "_"))

;;; Does this arm list end in the catch-all `(_ …)`? Only the last arm can be one, so
;;; `narms - 1` is both the wildcard's index and the number of real variant arms.
(defn arms-have-wildcard [(arms (ptr (ArrayList Arm)))] (-> bool)
  (let [n (len (load arms))]
    (if (= n (primitive/cast i64 0))
        false
        (arm-wildcard? (al-elem [Arm] arms (primitive/isub n 1))))))

; A quasiquote template node.
(defsum Quasi
  (QLit [(form (ptr Sexp))])
  (QUnquote [(e (ptr Expr))])
  (QSplice [(e (ptr Expr))])
  (QList [(items (ptr (ArrayList Quasi)))])
  (QVector [(items (ptr (ArrayList Quasi)))]))

; Calling-convention lowering.
(defsum Lowering
  (LNative [(cc i64)])  ; cc: 0=c 1=fast 2=cold 3=tail 4=swifttail
  (LShim [])
  ; Freestanding reset entry: emitted as `_start`, with target-specific register setup.
  (LReset []))

(defstruct Convention
  [(name (slice u8))
   (params (ptr (ArrayList (slice u8))))
   (ret (Option (slice u8)))
   (clobber (ptr (ArrayList (slice u8))))
   (preserve (ptr (ArrayList (slice u8))))
   (lowering Lowering)])

; Struct memory layout.
(defsum Layout
  (LC [])
  (LPacked [])
  (LAligned [(n i64)])
  (LExplicit [(offsets (ptr (ArrayList i64))) (size (Option i64)) (align i64)])
  (LBits [(backing i64) (offsets (ptr (ArrayList i64)))]))

(defstruct StructDef
  [(name (slice u8))
   (type_params (ptr (ArrayList (slice u8))))
   (bounds (ptr (ArrayList Bound)))  ; trait bounds on the params (empty if none)
   (layout Layout)
   (fields (ptr (ArrayList Field)))
   (submission_only bool)])

(defstruct Variant [(name (slice u8)) (fields (ptr (ArrayList Field)))])

(defstruct SumDef
  [(name (slice u8))
   (type_params (ptr (ArrayList (slice u8))))
   (bounds (ptr (ArrayList Bound)))  ; trait bounds on the params (empty if none)
   (variants (ptr (ArrayList Variant)))
   (submission_only bool)])

(defstruct Extern
  [(name (slice u8))
   (symbol (Option (slice u8)))  ; explicit linker spelling; name remains the Coil binding
   (cc (slice u8))
   (params (ptr (ArrayList Type)))
   (variadic bool)
   (ret Type)
   ; Where the authored parameter vector and return type sit, for source repairs:
   ; the reader's source id and byte spans. source is -1 for an extern the
   ; compiler synthesizes.
   (span_source i64)
   (params_lo i64)
   (params_hi i64)
   (ret_lo i64)
   (ret_hi i64)])

(defn extern-link-name [(e (ptr Extern))] (-> (slice u8))
  (match (.symbol e)
    (Some [symbol] symbol)
    (None []
          (let [name (scoped-ident-raw (.name e))
                (mut start) 0]
            (for [i 0 (len name)]
              (when (= (get name i) (primitive/cast u8 46))
                (set! start (+ i 1))
                0)
              0)
            (subslice name (load start) (len name))))))

; One trait in a bound. `args` supplies the trait's non-Self (associated) type
; parameters; it is empty for the traditional `(T Trait)` spelling.
(defstruct BoundTrait
  [(name (slice u8))
   (args (ptr (ArrayList Type)))])

; The declaration of one generic parameter beyond its name: the traits a type
; parameter must implement, or, for a value parameter `(const N i64)`, the type of
; its value. Parameters with neither have no entry.
(defstruct Bound
  [(name (slice u8))
   (traits (ptr (ArrayList BoundTrait)))
   ; `(Some T)` for a value parameter of type `T`; `(None)` for a type parameter.
   (value_type (Option Type))])

; An open, typed declaration annotation. `AnnotationDef` registers the value type
; for a keyword key; each use retains its ordinary Coil expression until checking
; validates and elaborates it against that type.
(defstruct Annotation [(key (slice u8)) (value Expr)])

; `compiler_owned` marks the schemas the checker installs itself (`:inline`,
; `:params`); a user `defannotation` of one of those keys is an error.
(defstruct AnnotationDef [(key (slice u8)) (value_type Type) (compiler_owned bool)])

;;; `(defalias Name Target)`: within its module, Name resolves to the module's
;;; declaration Target for every declaration kind Target has. A retained session
;;; may redefine an alias; the newest submission's alias wins.
(defstruct AliasDef
  [(name (slice u8))
   (target (slice u8))
   ; The target's source span, so a target the module does not declare is
   ; reported at the `defalias` that names it.
   (source i64)
   (lo i64)
   (hi i64)])

;;; A retained session's submission may retire accepted declarations so that it
;;; can declare replacements. Native code already accepted keeps what it bound.
;;;   (retire-alias Name)            kind 0: the module's alias Name
;;;   (retire-trait Name)            kind 1: the module's trait Name and every impl of it
;;;   (retire-impl [T…] Trait Type)  kind 2: the trait impl with exactly this pattern
;;;   (retire-inherent [T…] Type)    kind 3: the inherent impls with exactly this pattern
;;;   (retire-defn Name)             kind 4: the module's function (or macro) Name
;;;   (retire-struct Name)           kind 5: the module's struct Name and its impls
;;;   (retire-sum Name)              kind 6: the module's sum Name, its variants and impls
;;;   (retire-def Name)              kind 7: the module's runtime `def` Name
;;;   (retire-const Name)            kind 8: the module's `const` Name
;;; A retired name may be defined again, in the same submission or a later one.
;;; `impl` carries the parsed header of kinds 2 and 3; it has no methods.
(defstruct Retirement [(kind i64) (name (slice u8)) (module (slice u8)) (impl ImplDef)])

(defstruct Func
  [(name (slice u8))
   (type_params (ptr (ArrayList (slice u8))))
   (bounds (ptr (ArrayList Bound)))
   (cc (slice u8))
   (annotations (ptr (ArrayList Annotation)))
   (params (ptr (ArrayList Param)))
   (ret Type)
   (body (ptr (ArrayList Expr)))
   (macro_variadic bool)
   (lo i64)
   (hi i64)
   (source i64)
   (ctxt i64)
   ; `(declare NAME [params] (-> ret))`: a function whose definition lives in
   ; another compilation unit. Its signature is checked like any other and calls
   ; to it use Coil's own ABI, but it has no body here, so a backend declares
   ; the symbol and the linker resolves it. Appended for bootstrap ABI
   ; compatibility.
   (declared bool)])

(defstruct StaticAssert [(cnd Expr) (msg (slice u8))])

(defstruct Const
  [(name (slice u8))
   (ty (Option Type))
   (value Expr)
   ; `false` is a compile-time `(const ...)`; `true` is an ordinary runtime
   ; module value introduced by `(def NAME [TYPE] VALUE)`. Appended so an older
   ; bootstrap compiler preserves the established prefix layout.
   (runtime bool)
   ; Declaration annotations between the name and the optional type, exactly
   ; as a `defn` carries them. `(const …)` has none.
   (annotations (ptr (ArrayList Annotation)))
   ; `(declare NAME TYPE)`: runtime storage another compilation unit defines.
   ; This unit references the symbol and holds no value. Appended field.
   (declared bool)])

(defstruct TraitMethod
  [(name (slice u8))
   (annotations (ptr (ArrayList Annotation)))
   (params (ptr (ArrayList Param)))
   (ret Type)])

; `type_params` = the EXTRA trait type parameters beyond Self:
; `(deftrait Get [Self K E] …)` — Self determines them (one impl per type).
; `requires` = the SUPERTRAITS from a `:requires [Base …]` clause (gen-8): every
; impl of this trait must also impl each Base. This is a SEPARATE axis from the
; type-param vector, so `[Self …]` (associated types) and supertraits stop sharing
; one syntax; the names here are qualified by the resolver like any trait name.
(defstruct TraitDef
  [(name (slice u8))
   (self_param (slice u8))
   (type_params (ptr (ArrayList (slice u8))))
   (requires (ptr (ArrayList (slice u8))))
   (methods (ptr (ArrayList TraitMethod)))])

; An impl's kind owns its trait name when there is one. Keeping this distinction
; explicit prevents inherent impls from masquerading as a trait named "".
(defsum ImplKind
  (TraitImpl [(trait_name (slice u8))])
  (InherentImpl []))

; A GENERIC impl `(impl [T] Push (ArrayList T) …)` carries its type params and
; the full implementing-type pattern in `self_type`; `for_type` is the dispatch
; BASE name derived from it (kept in sync by the resolver after qualification).
; Both kinds share one record so their methods use the same qualify/check/lower
; pipeline without encoding the distinction in a magic string.
(defstruct ImplDef
  [(kind ImplKind)
   (for_type (slice u8))
   (type_params (ptr (ArrayList (slice u8))))
   (self_type Type)
   (methods (ptr (ArrayList Func)))
   ; Appended for bootstrap ABI compatibility: a previous-stage compiler knows
   ; the offsets of every field above while it builds the first new stage.
   (bounds (ptr (ArrayList Bound)))])

(defn impl-is-inherent [(im (ptr ImplDef))] (-> bool)
  (match (.kind im) (InherentImpl [] true) (_ false)))

(defn impl-is-trait [(im (ptr ImplDef))] (-> bool)
  (not (impl-is-inherent im)))

(defn impl-trait-name [(im (ptr ImplDef))] (-> (slice u8))
  (match (.kind im)
    (TraitImpl [name] name)
    (InherentImpl [] (do (abort) (primitive/zeroed (slice u8))))))

;;; A C-ABI entry for a Coil function. `published` entries come from `export-c`
;;; (and the metaprogram/comptime hosts) and define a public C symbol. An
;;; unpublished entry is the checker's by-value C entry for an anonymous `c`
;;; function whose parameters include an aggregate by value: `fnptr-of` names it,
;;; nothing links against it, and backends give its symbol local linkage.
(defstruct ExportC
  [(name (slice u8))
   (symbol (Option (slice u8)))
   (params (ptr (ArrayList Type)))
   (published bool)
   (lo i64)
   (hi i64)
   (source i64)
   (ctxt i64)])

; Structural provenance for one concrete artifact produced by monomorphization.
; `generated` is an artifact handle for loading/debugging only; consumers map it
; to `source` and `args` through this record and never reverse-engineer its name.
; kind: 1 function, 2 struct, 3 sum. Trait fields are empty for ordinary
; instantiations and are populated at authoritative trait selection sites.
(defstruct MonoOrigin
  [(kind i64)
   (generated (slice u8))
   (source (slice u8))
   (args (ptr (ArrayList Type)))
   (trait_name (slice u8))
   (impl_source (slice u8))])

(defstruct MonoTraitUse
  [(caller_source (slice u8))
   (trait_name (slice u8))
   (impl_source (slice u8))
   (method_name (slice u8))
   (generated_artifact (slice u8))])

; The whole program. `statics` is omitted: parsing never
; produces statics (they come from checking), so the dump always emits an empty
; `(statics)` section.
(defstruct Program
  [(annotation_defs (ptr (ArrayList AnnotationDef)))
   (conventions (ptr (ArrayList Convention)))
   (structs (ptr (ArrayList StructDef)))
   (sums (ptr (ArrayList SumDef)))
   (externs (ptr (ArrayList Extern)))
   (funcs (ptr (ArrayList Func)))
   (asserts (ptr (ArrayList StaticAssert)))
   (consts (ptr (ArrayList Const)))
   (traits (ptr (ArrayList TraitDef)))
   (impls (ptr (ArrayList ImplDef)))
   (metas (ptr (ArrayList Expr)))
   (exports (ptr (ArrayList ExportC)))
   ; Checked callable surfaces for concrete Coil functions. Unlike Func.params,
   ; these retain the semantic call ABI (`ref` for non-affine aggregates, owned
   ; value for affine aggregates). Appended for bootstrap ABI compatibility.
   (function_abis (ptr (ArrayList Extern)))
   ; Concrete generic/trait artifact provenance, appended so previous-stage
   ; compilers preserve every earlier Program offset during fixed-point rebuild.
   (mono_origins (ptr (ArrayList MonoOrigin)))
   (mono_trait_uses (ptr (ArrayList MonoTraitUse)))
   ; Qualified names of functions this compilation unit publishes under their
   ; Coil ABI: another unit may `declare` them and link this one's object. A
   ; backend emits each as an external definition; every other non-exported
   ; function stays internal. Empty for an ordinary program. Appended for
   ; bootstrap ABI compatibility.
   (unit_exports (ptr (ArrayList (slice u8))))
   ; Module-local rebindable name aliases (`defalias`). Appended for bootstrap
   ; ABI compatibility.
   (aliases (ptr (ArrayList AliasDef)))
   ; Retirement requests of this submission, and the accepted function names
   ; they retired (impl methods). Appended for bootstrap ABI compatibility; a
   ; null list is empty.
   (retirements (ptr (ArrayList Retirement)))
   (retired_functions (ptr (ArrayList (slice u8))))])

; `Diag`, the node-id counter, and the Sexp/Tok/StrRead constructors moved to the
; reader — they describe the reader's OWN types, and keeping them here made `ast`
; and `reader` import each other. The reader is now standalone; `ast` imports it.

; ── TYPE-REFERENCE resolution registry (for exact `(primitive/code-decl TYPE-NODE)`) ────
; Types carry no node id (adding one to the Type sum ripples across every match),
; so instead the resolver records, at qualify-type, what each `(module, raw type
; name)` resolves to. A metaprogram then resolves a type node exactly: its raw name
; (the symbol) + its module (via the source→module map below) → the qualified type.
;; ── Resolution lookup index ──────────────────────────────────────────────────
;; The three registries below (type refs, value refs, source modules) are
;; append-only lists that a checker queries once per syntax node it walks. A
;; list scan per query made a checker that resolves every node cost
;; nodes × registered references. Each list therefore has an open-addressing
;; hash index beside it.
;;
;; The list stays the source of truth: other passes append to it, truncate it
;; for a rollback, and replace it wholesale when pruning, so the index follows
;; the list rather than owning it. A lookup first brings the index up to date by
;; adding the entries appended since the last sync. The index lives OUTSIDE the
;; unit state on purpose: the unit state is walked and rebuilt field by field by
;; the retained-snapshot generator, which cannot copy a pointer to a table of
;; unknown length. Being process-wide, it records which list it was built for
;; and the list's buffer and length, and starts over whenever any of them no
;; longer agree. Every pass that shrinks or replaces a list in place also calls
;; `res-indexes-invalidate!` explicitly; the check is a safety net, not the
;; mechanism.
(defstruct ResSlot
  [(a (slice u8)) (b (slice u8)) (n i64) (val (slice u8)) (used i64)])

(defstruct ResIndex
  [(mem (slice ResSlot))
   (cap i64)
   (count i64)
   (synced i64)
   (owner i64)
   (buf i64)])

(defn type-res-index [] (-> (ptr ResIndex)) (primitive/alloc-static ResIndex))
(defn value-res-index [] (-> (ptr ResIndex)) (primitive/alloc-static ResIndex))
(defn src-mod-index [] (-> (ptr ResIndex)) (primitive/alloc-static ResIndex))

(defn res-index-hash [(a (slice u8)) (b (slice u8)) (n i64)] (-> i64)
  (let [(mut h) 1469598103934665603]
    (for [i 0 (len a)]
      (set! h (primitive/imul (primitive/ixor (load h) (primitive/cast i64 (get a i)))
                              1099511628211)))
    (set! h (primitive/imul (primitive/ixor (load h) 255) 1099511628211))
    (for [i 0 (len b)]
      (set! h (primitive/imul (primitive/ixor (load h) (primitive/cast i64 (get b i)))
                              1099511628211)))
    (set! h (primitive/imul (primitive/ixor (load h) n) 1099511628211))
    (load h)))

(defn res-index-clear! [(ix (ptr ResIndex))] (-> i64)
  (when (> (.cap ix) 0)
    (free [ResSlot] (malloc-allocator) (.mem ix))
    0)
  (set! (.mem ix) (primitive/zeroed (slice ResSlot)))
  (set! (.cap ix) 0)
  (set! (.count ix) 0)
  (set! (.synced ix) 0)
  (set! (.owner ix) 0)
  (set! (.buf ix) 0)
  0)

(defn res-indexes-invalidate! [] (-> i64)
  (res-index-clear! (type-res-index))
  (res-index-clear! (value-res-index))
  (res-index-clear! (src-mod-index))
  0)

(defn res-index-slot-matches? [(s (ptr ResSlot)) (a (slice u8)) (b (slice u8)) (n i64)] (-> bool)
  (and (= (.n s) n) (= (.a s) a) (= (.b s) b)))

; Insert or, when `overwrite`, replace. A first-wins registry passes false.
(defn res-index-put! [(ix (ptr ResIndex))
                      (a (slice u8))
                      (b (slice u8))
                      (n i64)
                      (val (slice u8))
                      (overwrite bool)] (-> i64)
  (when (>= (primitive/imul (primitive/iadd (.count ix) 1) 2) (.cap ix))
    (res-index-grow! ix)
    0)
  (let [slots (slice-data [ResSlot] (.mem ix))
        mask (primitive/isub (.cap ix) 1)
        (mut at) (primitive/iand (res-index-hash a b n) mask)]
    (loop (let [s (primitive/index slots (load at))]
            (cond (= (.used s) 0)
                    (do
                      (set! (.a s) a)
                      (set! (.b s) b)
                      (set! (.n s) n)
                      (set! (.val s) val)
                      (set! (.used s) 1)
                      (set! (.count ix) (primitive/iadd (.count ix) 1))
                      (break))
                  (res-index-slot-matches? s a b n)
                    (do
                      (when overwrite (set! (.val s) val) 0)
                      (break))
                  :else (set! at (primitive/iand (primitive/iadd (load at) 1) mask)))))
    0))

(defn res-index-grow! [(ix (ptr ResIndex))] (-> i64)
  (let [old-mem (.mem ix)
        old-cap (.cap ix)
        new-cap (if (< old-cap 1024) 1024 (primitive/imul old-cap 2))
        mem (match (alloc [ResSlot] (malloc-allocator) new-cap)
              (Some [m] m)
              (None [] (do (ps (stderr) "error: out of memory growing a resolution index\n")
                           (abort)
                           old-mem)))]
    (mem-zero [ResSlot] (slice-data [ResSlot] mem) new-cap)
    (set! (.mem ix) mem)
    (set! (.cap ix) new-cap)
    (set! (.count ix) 0)
    (for [i 0 old-cap]
      (let [s (primitive/index (slice-data [ResSlot] old-mem) i)]
        (when (!= (.used s) 0)
          ; Entries already in the table are distinct keys, so a plain insert
          ; restores each one exactly.
          (res-index-put! ix (.a s) (.b s) (.n s) (.val s) true)
          0)))
    (when (> old-cap 0)
      (free [ResSlot] (malloc-allocator) old-mem)
      0)
    0))

(defn res-index-get [(ix (ptr ResIndex)) (a (slice u8)) (b (slice u8)) (n i64)] (-> (slice u8))
  (if (= (.cap ix) 0)
      ""
      (let [slots (slice-data [ResSlot] (.mem ix))
            mask (primitive/isub (.cap ix) 1)
            (mut at) (primitive/iand (res-index-hash a b n) mask)
            (mut r) ""]
        (loop (let [s (primitive/index slots (load at))]
                (cond (= (.used s) 0) (break)
                      (res-index-slot-matches? s a b n)
                        (do (store! r (load (field s val))) (break))
                      :else (set! at (primitive/iand (primitive/iadd (load at) 1) mask)))))
        (load r))))

; Bring `ix` up to date with a list of `len` entries at `buf`, belonging to
; `owner`. Returns true when the index may be extended in place; false when it
; was started over and must be refilled from entry 0.
(defn res-index-reset-if-stale! [(ix (ptr ResIndex)) (owner i64) (buf i64) (len i64)] (-> i64)
  (when (or (!= (.owner ix) owner) (!= (.buf ix) buf) (< len (.synced ix)))
    (res-index-clear! ix)
    (set! (.owner ix) owner)
    0)
  0)

(defn type-res-synced [] (-> (ptr ResIndex))
  (let [lst (type-res-list)
        ix (type-res-index)
        n (len (load lst))]
    (res-index-reset-if-stale! ix (primitive/cast i64 lst) (primitive/cast i64 (.data lst)) n)
    (for [i (.synced ix) n]
      (let [e (al-elem [TypeResEntry] lst i)]
        (res-index-put! ix (.module e) (.raw e) 0 (.qual e) true)))
    (set! (.synced ix) n)
    (set! (.buf ix) (primitive/cast i64 (.data lst)))
    ix))

(defn value-res-synced [] (-> (ptr ResIndex))
  (let [lst (value-res-list)
        ix (value-res-index)
        n (len (load lst))]
    (res-index-reset-if-stale! ix (primitive/cast i64 lst) (primitive/cast i64 (.data lst)) n)
    (for [i (.synced ix) n]
      (let [e (al-elem [ValueResEntry] lst i)]
        (res-index-put! ix (.module e) (.raw e) 0 (.qual e) true)))
    (set! (.synced ix) n)
    (set! (.buf ix) (primitive/cast i64 (.data lst)))
    ix))

(defn src-mod-synced [] (-> (ptr ResIndex))
  (let [lst (src-mod-list)
        ix (src-mod-index)
        n (len (load lst))]
    (res-index-reset-if-stale! ix (primitive/cast i64 lst) (primitive/cast i64 (.data lst)) n)
    (for [i (.synced ix) n]
      (let [e (al-elem [SrcModEntry] lst i)]
        ; The first registration of a source id wins.
        (res-index-put! ix "" "" (.source e) (.module e) false)))
    (set! (.synced ix) n)
    (set! (.buf ix) (primitive/cast i64 (.data lst)))
    ix))

(defstruct TypeResEntry
  [(module (slice u8)) (raw (slice u8)) (qual (slice u8))])

(defstruct TypeResBox
  [(init i64)
   (lst (ptr (ArrayList TypeResEntry)))
   (arena scratch/ScratchArena)])

(defn resolution-map-arena-release [(raw (ptr i8))] (-> i64)
  ; The lists live in these arenas; an index built over them must not outlive them.
  (res-indexes-invalidate!)
  (scratch/scratch-close! (primitive/cast (ptr scratch/ScratchArena) raw)))

;;; Qualified `defalias` bindings visible to this compilation: the forms being
;;; expanded and the retained parent's declarations, newest first. Macro heads
;;; and reflected type names resolve before a declaration table exists.
(defstruct DeclAliasEntry [(name (slice u8)) (target (slice u8))])
(defstruct DeclAliasBox
  [(init i64)
   (lst (ptr (ArrayList DeclAliasEntry)))
   (arena scratch/ScratchArena)])

(defn decl-alias-box [] (-> (ptr DeclAliasBox))
  (field (ast-unit-state) declaration_aliases))

(defn decl-alias-list [] (-> (ptr (ArrayList DeclAliasEntry)))
  (let [b (decl-alias-box)]
    (when (= (load (field b init)) (primitive/cast i64 0))
      (scratch/scratch-init-with-cap (field b arena) (retained-heap/compiler-scratch-parent) 16384)
      (unit-resource! (primitive/cast (ptr i8) (field b arena))
                      (primitive/fnptr-of resolution-map-arena-release))
      (store! (field b lst)
              (box! (unit-allocator)
                    (ArrayList DeclAliasEntry)
                    (primitive/zeroed (ArrayList DeclAliasEntry))))
      (store! (load (field b lst))
              (al-new [DeclAliasEntry] (scratch/scratch-allocator (field b arena))))
      (store! (field b init) 1)
      0)
    (load (field b lst))))

(defn decl-aliases-reset! [] (-> i64)
  (let [_ (decl-alias-list)
        b (decl-alias-box)]
    (scratch/scratch-reset! (field b arena))
    (set! (load (field b lst))
          (al-new [DeclAliasEntry] (scratch/scratch-allocator (field b arena))))
    0))

(defn decl-alias-target [(q (slice u8))] (-> (slice u8))
  (let [lst (decl-alias-list)]
    (block :found
      (for [i 0 (len (load lst))]
        (let [e (al-elem [DeclAliasEntry] lst i)]
          (when (= (.name e) q) (break :found (.target e)))))
      q)))

;;; MODULE "." NAME, allocated in A.
(defn decl-alias-key [(a (dyn Allocator)) (module (slice u8)) (name (slice u8))] (-> (slice u8))
  (let [(mut out) (sb-new a)]
    (sb-push-str! (mut out) module)
    (sb-push-str! (mut out) ".")
    (sb-push-str! (mut out) name)
    (sb-finish! (mut out))))

;;; Record MODULE.NAME -> MODULE.TARGET unless the name is already bound.
(defn decl-alias-put! [(module (slice u8)) (name (slice u8)) (target (slice u8))] (-> i64)
  (let [lst (decl-alias-list)
        aa (scratch/scratch-allocator (field (decl-alias-box) arena))
        key (decl-alias-key aa module name)]
    (when (= (decl-alias-target key) key)
      (push! lst (DeclAliasEntry :name key :target (decl-alias-key aa module target)))
      0)
    0))

(defn type-res-box [] (-> (ptr TypeResBox))
  (field (ast-unit-state) type_refs))

(defn type-res-list [] (-> (ptr (ArrayList TypeResEntry)))
  (let [b (type-res-box)]
    (when (= (load (field b init)) (primitive/cast i64 0))
      (scratch/scratch-init-with-cap (field b arena) (retained-heap/compiler-scratch-parent) 65536)
      (unit-resource! (primitive/cast (ptr i8) (field b arena))
                      (primitive/fnptr-of resolution-map-arena-release))
      (store! (field b lst)
              (box! (unit-allocator)
                    (ArrayList TypeResEntry)
                    (primitive/zeroed (ArrayList TypeResEntry))))
      (store! (load (field b lst))
              (al-new [TypeResEntry] (scratch/scratch-allocator (field b arena))))
      (store! (field b init) 1)
      (res-indexes-invalidate!)
      0)
    (load (field b lst))))

(defn type-res-reset [] (-> i64)
  (let [_ (type-res-list)
        b (type-res-box)]
    (scratch/scratch-reset! (field b arena))
    (set! (load (field b lst))
          (al-new [TypeResEntry] (scratch/scratch-allocator (field b arena))))
    (res-indexes-invalidate!)
    0))

; An owned copy of a resolution name. The names handed to the two record
; functions below belong to whatever produced them -- a loader arena, a
; metaprogram's expansion -- and those are discarded generation by generation,
; while these lists are kept for the life of the unit. Borrowing them left the
; newest entries pointing into freed memory, and the next generation's scan of
; the list read it.
(defn res-own-name [(a (dyn Allocator)) (text (slice u8))] (-> (slice u8))
  (let [n (slice-len text)]
    (if (= n (primitive/cast i64 0))
        text
        (match (alloc [u8] a n)
          (None [] (do (ps (stderr) "error: out of memory copying a resolution name\n")
                       (abort)
                       text))
          (Some [memory]
                (do (mem-copy [u8] (slice-data [u8] memory) (slice-data [u8] text) n)
                    memory))))))

(defn type-res-record [(module (slice u8)) (raw (slice u8)) (qual (slice u8))] (-> i64)
  (source-type-answer! module raw qual false)
  (let [_ (type-res-list)
        own (scratch/scratch-allocator (field (type-res-box) arena))
        e (primitive/alloc-stack TypeResEntry)]
    (set! (.module e) (res-own-name own module))
    (set! (.raw e) (res-own-name own raw))
    (set! (.qual e) (res-own-name own qual))
    (push! (type-res-list) (load e))
    0))

(defn type-res-lookup [(module (slice u8)) (raw (slice u8))] (-> (slice u8))
  (let [r (res-index-get (type-res-synced) module raw 0)]
    (if (!= r "")
        r
        (resbase/resolution-lookup (.resolution_base (ast-unit-state)) true module raw))))

; ── VALUE-REFERENCE resolution registry ─────────────────────────────────────
; Checked expressions normally retain their source node id, but semantic checkers
; walk the authored syntax tree. Some import forms (notably `:rename`) make the
; authored name unusable for a declaration-table fallback. Preserve resolution's
; authoritative answer by the same stable `(module, raw name)` key used above for
; type references; this also covers function-pointer references whose syntax node
; and checked expression do not share an id.
(defstruct ValueResEntry
  [(module (slice u8)) (raw (slice u8)) (qual (slice u8))])

(defstruct ValueResBox
  [(init i64)
   (lst (ptr (ArrayList ValueResEntry)))
   (arena scratch/ScratchArena)])

(defn value-res-box [] (-> (ptr ValueResBox))
  (field (ast-unit-state) value_refs))

(defn value-res-list [] (-> (ptr (ArrayList ValueResEntry)))
  (let [b (value-res-box)]
    (when (= (load (field b init)) (primitive/cast i64 0))
      (scratch/scratch-init-with-cap (field b arena) (retained-heap/compiler-scratch-parent) 65536)
      (unit-resource! (primitive/cast (ptr i8) (field b arena))
                      (primitive/fnptr-of resolution-map-arena-release))
      (store! (field b lst)
              (box! (unit-allocator)
                    (ArrayList ValueResEntry)
                    (primitive/zeroed (ArrayList ValueResEntry))))
      (store! (load (field b lst))
              (al-new [ValueResEntry] (scratch/scratch-allocator (field b arena))))
      (store! (field b init) 1)
      (res-indexes-invalidate!)
      0)
    (load (field b lst))))

(defn value-res-reset [] (-> i64)
  (let [_ (value-res-list)
        b (value-res-box)]
    (scratch/scratch-reset! (field b arena))
    (set! (load (field b lst))
          (al-new [ValueResEntry] (scratch/scratch-allocator (field b arena))))
    (res-indexes-invalidate!)
    0))

; Owns its names for the same reason type-res-record does.
(defn value-res-record [(module (slice u8)) (raw (slice u8)) (qual (slice u8))] (-> i64)
  (let [_ (value-res-list)
        own (scratch/scratch-allocator (field (value-res-box) arena))
        e (primitive/alloc-stack ValueResEntry)]
    (set! (.module e) (res-own-name own module))
    (set! (.raw e) (res-own-name own raw))
    (set! (.qual e) (res-own-name own qual))
    (push! (value-res-list) (load e))
    0))

(defn value-res-lookup [(module (slice u8)) (raw (slice u8))] (-> (slice u8))
  (let [r (res-index-get (value-res-synced) module raw 0)]
    (if (!= r "")
        r
        (resbase/resolution-lookup (.resolution_base (ast-unit-state)) false module raw))))

; ── ambient core provider ORDER ──────────────────────────────────────────────
; `coil.core` is ONE namespace, and the modules publishing into it form an ORDERED
; list: the profile's built-in providers first, then the root manifest's
; `core-providers` in the order written. A LATER contribution OVERRIDES an earlier
; one, so lookup scans backwards and the first hit is the winner.
;
; The contributed NAMES are recorded here as the loader validates each provider,
; rather than being read back off the export tables later. `provide-core` emits no
; form of its own, so the export entry it builds does not survive the declaration
; rebuild that expansion runs against — the export tables see only modules with a
; literal `(export …)`. This registry is the durable record.
;;; `roots` records, per contribution, whether it came from the ROOT PROJECT's
;;; `[language] core-providers` rather than from the profile's built-in providers.
;;; A root contribution rebinds the name only for the project's own modules: the
;;; standard library was written against the real prelude, and letting a project's
;;; `when` reach it miscompiles the library (tests/compiler/core_providers/
;;; override_prelude). Built-in providers stay universal — they are what the
;;; library itself is written against.
(defstruct CoreProvBox
  [(init i64)
   (names (ptr (ArrayList (slice u8))))
   (modules (ptr (ArrayList (slice u8))))
   (roots (ptr (ArrayList i64)))])

(defn core-prov-box [] (-> (ptr CoreProvBox))
  (field (ast-unit-state) core_providers))

(defn core-prov-init! [] (-> i64)
  (let [b (core-prov-box)]
    (when (= (load (field b init)) (primitive/cast i64 0))
      (store! (field b names)
              (box! (unit-allocator)
                    (ArrayList (slice u8))
                    (primitive/zeroed (ArrayList (slice u8)))))
      (store! (load (field b names)) (al-new [(slice u8)] (unit-allocator)))
      (store! (field b modules)
              (box! (unit-allocator)
                    (ArrayList (slice u8))
                    (primitive/zeroed (ArrayList (slice u8)))))
      (store! (load (field b modules)) (al-new [(slice u8)] (unit-allocator)))
      (store! (field b roots)
              (box! (unit-allocator)
                    (ArrayList i64)
                    (primitive/zeroed (ArrayList i64))))
      (store! (load (field b roots)) (al-new [i64] (unit-allocator)))
      (store! (field b init) 1)
      0)
    0))

(defn core-providers-reset! [] (-> i64)
  (core-prov-init!)
  (let [b (core-prov-box)]
    (al-clear! [(slice u8)] (mut (load (field b names))))
    (al-clear! [(slice u8)] (mut (load (field b modules))))
    (al-clear! [i64] (mut (load (field b roots))))
    0))

(defn core-contribution-add! [(name (slice u8)) (module (slice u8)) (root bool)] (-> i64)
  (core-prov-init!)
  (let [b (core-prov-box)]
    (push! (load (field b names)) name)
    (push! (load (field b modules)) module)
    (push! (load (field b roots)) (if root 1 0))
    0))

; The module that owns `name` ambiently, or "" when no provider contributed it.
; Scans backwards, so the LAST activated provider wins.
;
; `asking` is the module whose code is being resolved. A ROOT contribution — one the
; project's own `[language] core-providers` activated — wins only for that project's
; modules; a toolchain module skips it and keeps scanning older tiers, so the standard
; library keeps the prelude it was written against. See CoreProvBox.
;
; The toolchain test is deliberately reached only when a root contribution actually
; matches the name. It is a linear walk of the stdlib manifest, and this function sits
; under every ambient name resolution in the compiler: running it unconditionally cost
; a 23x compile-time regression.
(defn core-contribution-owner [(name (slice u8)) (asking (slice u8))] (-> (slice u8))
  (core-prov-init!)
  (let [b (core-prov-box)
        n (len (load (load (field b names))))
        (mut i) (primitive/isub n 1)
        (mut r) ""]
    (loop (if (< (load i) (primitive/cast i64 0))
              (break)
              (do
                (when (= (get (load (load (field b names))) (load i)) name)
                  (if (= (get (load (load (field b roots))) (load i))
                         (primitive/cast i64 0))
                      (do
                        (store! r
                                (get (load (load (field b modules))) (load i)))
                        (break))
                      (unless (sm/toolchain-namespace? asking)
                        (store! r
                                (get (load (load (field b modules))) (load i)))
                        (break))))
                (set! i (primitive/isub (load i) 1)))))
    (load r)))

; ── declared `provide-core` names, for validation ────────────────────────────
; Every `(provide-core [...])` the loader sees, activated or not, with the position
; of each name so the error can point at the offending symbol. `provide-core` is an
; export list, and an export list naming something the module does not define is a
; typo that would otherwise fail far away — the name simply never becomes ambient
; and the mistake surfaces as "undefined function" at some unrelated call site.
; Checked in resolve, which is where the declaration table exists.
(defstruct CoreDeclBox
  [(init i64)
   (modules (ptr (ArrayList (slice u8))))
   (names (ptr (ArrayList (slice u8))))
   (los (ptr (ArrayList i64)))
   (his (ptr (ArrayList i64)))
   (srcs (ptr (ArrayList i64)))
   (ctxts (ptr (ArrayList i64)))])

(defn core-decl-box [] (-> (ptr CoreDeclBox))
  (field (ast-unit-state) core_declarations))

(defn core-decl-init! [] (-> i64)
  (let [b (core-decl-box)]
    (when (= (load (field b init)) (primitive/cast i64 0))
      (store! (field b modules)
              (box! (unit-allocator)
                    (ArrayList (slice u8))
                    (primitive/zeroed (ArrayList (slice u8)))))
      (store! (load (field b modules)) (al-new [(slice u8)] (unit-allocator)))
      (store! (field b names)
              (box! (unit-allocator)
                    (ArrayList (slice u8))
                    (primitive/zeroed (ArrayList (slice u8)))))
      (store! (load (field b names)) (al-new [(slice u8)] (unit-allocator)))
      (store! (field b los)
              (box! (unit-allocator)
                    (ArrayList i64)
                    (primitive/zeroed (ArrayList i64))))
      (store! (load (field b los)) (al-new [i64] (unit-allocator)))
      (store! (field b his)
              (box! (unit-allocator)
                    (ArrayList i64)
                    (primitive/zeroed (ArrayList i64))))
      (store! (load (field b his)) (al-new [i64] (unit-allocator)))
      (store! (field b srcs)
              (box! (unit-allocator)
                    (ArrayList i64)
                    (primitive/zeroed (ArrayList i64))))
      (store! (load (field b srcs)) (al-new [i64] (unit-allocator)))
      (store! (field b ctxts)
              (box! (unit-allocator)
                    (ArrayList i64)
                    (primitive/zeroed (ArrayList i64))))
      (store! (load (field b ctxts)) (al-new [i64] (unit-allocator)))
      (store! (field b init) 1)
      0)
    0))

(defn core-decls-reset! [] (-> i64)
  (core-decl-init!)
  (let [b (core-decl-box)]
    (al-clear! [(slice u8)] (mut (load (field b modules))))
    (al-clear! [(slice u8)] (mut (load (field b names))))
    (al-clear! [i64] (mut (load (field b los))))
    (al-clear! [i64] (mut (load (field b his))))
    (al-clear! [i64] (mut (load (field b srcs))))
    (al-clear! [i64] (mut (load (field b ctxts))))
    0))

(defn core-decl-add! [(module (slice u8))
                      (name (slice u8))
                      (lo i64)
                      (hi i64)
                      (src i64)
                      (ctxt i64)] (-> i64)
  (core-decl-init!)
  (let [b (core-decl-box)
        n (len (load (load (field b names))))
        (mut duplicate) false]
    (for [i 0 n]
      (when (and (= (get (load (load (field b modules))) i) module)
                 (and (= (get (load (load (field b names))) i) name)
                      (and (= (get (load (load (field b los))) i) lo)
                           (and (= (get (load (load (field b his))) i) hi)
                                (and (= (get (load (load (field b srcs))) i)
                                        src)
                                     (= (get (load (load (field b ctxts))) i)
                                        ctxt))))))
        (store! duplicate true)))
    (unless (load duplicate)
      (push! (load (field b modules)) module)
      (push! (load (field b names)) name)
      (push! (load (field b los)) lo)
      (push! (load (field b his)) hi)
      (push! (load (field b srcs)) src)
      (push! (load (field b ctxts)) ctxt))
    0))

(defn core-decl-count [] (-> i64)
  (core-decl-init!)
  (len (load (load (field (core-decl-box) names)))))

(defn core-decl-module-at [(i i64)] (-> (slice u8))
  (get (load (load (field (core-decl-box) modules))) i))

(defn core-decl-name-at [(i i64)] (-> (slice u8))
  (get (load (load (field (core-decl-box) names))) i))

(defn core-decl-lo-at [(i i64)] (-> i64)
  (get (load (load (field (core-decl-box) los))) i))

(defn core-decl-hi-at [(i i64)] (-> i64)
  (get (load (load (field (core-decl-box) his))) i))

(defn core-decl-src-at [(i i64)] (-> i64)
  (get (load (load (field (core-decl-box) srcs))) i))

(defn core-decl-ctxt-at [(i i64)] (-> i64)
  (get (load (load (field (core-decl-box) ctxts))) i))

; ── source-id → module-name map (so a node's module is known at query time) ───
(defstruct SrcModEntry [(source i64) (module (slice u8))])

(defstruct SrcModBox
  [(init i64)
   (lst (ptr (ArrayList SrcModEntry)))
   (arena scratch/ScratchArena)])

(defn src-mod-box [] (-> (ptr SrcModBox))
  (field (ast-unit-state) source_modules))

(defn src-mod-list [] (-> (ptr (ArrayList SrcModEntry)))
  (let [b (src-mod-box)]
    (when (= (load (field b init)) (primitive/cast i64 0))
      (scratch/scratch-init-with-cap (field b arena) (retained-heap/compiler-scratch-parent) 65536)
      (unit-resource! (primitive/cast (ptr i8) (field b arena))
                      (primitive/fnptr-of resolution-map-arena-release))
      (store! (field b lst)
              (box! (unit-allocator)
                    (ArrayList SrcModEntry)
                    (primitive/zeroed (ArrayList SrcModEntry))))
      (store! (load (field b lst))
              (al-new [SrcModEntry] (scratch/scratch-allocator (field b arena))))
      (store! (field b init) 1)
      (res-indexes-invalidate!)
      0)
    (load (field b lst))))

(defn src-mod-reset [] (-> i64)
  (let [_ (src-mod-list)
        b (src-mod-box)]
    (scratch/scratch-reset! (field b arena))
    (set! (load (field b lst))
          (al-new [SrcModEntry] (scratch/scratch-allocator (field b arena))))
    (res-indexes-invalidate!)
    0))

(defn src-mod-record [(source i64) (module (slice u8))] (-> i64)
  (unless (< source (primitive/cast i64 0))
    (let [e (primitive/alloc-stack SrcModEntry)]
      (store! (field e source) source)
      (store! (field e module) module)
      (push! (src-mod-list) (load e))
      0)))

(defn src-mod-lookup [(source i64)] (-> (slice u8))
  (let [r (res-index-get (src-mod-synced) "" "" source)]
    (if (!= r "")
        r
        (resbase/resolution-source-lookup (.resolution_base (ast-unit-state)) source))))

;;; ── LEXICAL SCOPE MAP: which locals were in scope at each qualified node ──────
;;; The resolver decides at every reference whether a spelling names a local or a
;;; global. This map keeps the local half of that decision so a checker can ask it
;;; afterwards about a spelling the program does not contain yet — "if `len` were
;;; written here, what would it name?" (`primitive/resolve-at`). The resolver's own
;;; scope is a stack truncated on scope exit, so by the time a checker runs it
;;; remembers nothing.
;;;
;;; Each binding appends a LINK naming its parent, the innermost link in scope when
;;; it was made, and each qualified node records the innermost link in scope at it
;;; (its TIP; -1 when no local is). Following parents from a tip visits exactly that
;;; node's locals, innermost first. Qualification pays only the appends; the node
;;; index is built when a query first needs it.
(defstruct ScopeLink [(name (slice u8)) (parent i64)])

(defstruct ScopeAtEntry [(node-id i64) (tip i64) (module i64)])

(defstruct ScopeAtBox
  [(init i64)
   (links (ptr (ArrayList ScopeLink)))
   (nodes (ptr (ArrayList ScopeAtEntry)))
   (modules (ptr (ArrayList (slice u8))))
   ; node id -> index into `nodes`, current only while `indexed` is true
   (index (ptr (HashMap i64 i64)))
   (indexed bool)
   (arena scratch/ScratchArena)])

(defn scope-at-box [] (-> (ptr ScopeAtBox))
  (field (ast-unit-state) scope_at))

(defn scope-at-fresh-lists! [(b (ptr ScopeAtBox))] (-> i64)
  (let [sa (scratch/scratch-allocator (field b arena))]
    (set! (load (field b links)) (al-new [ScopeLink] sa))
    (set! (load (field b nodes)) (al-new [ScopeAtEntry] sa))
    (set! (load (field b modules)) (al-new [(slice u8)] sa))
    (set! (.indexed b) false)
    0))

(defn scope-at-ready [] (-> (ptr ScopeAtBox))
  (let [b (scope-at-box)]
    (when (= (.init b) 0)
      (scratch/scratch-init-with-cap (field b arena) (retained-heap/compiler-scratch-parent) 65536)
      (unit-resource! (primitive/cast (ptr i8) (field b arena))
                      (primitive/fnptr-of resolution-map-arena-release))
      (set! (.links b) (box! (unit-allocator) (ArrayList ScopeLink) (primitive/zeroed (ArrayList ScopeLink))))
      (set! (.nodes b) (box! (unit-allocator) (ArrayList ScopeAtEntry) (primitive/zeroed (ArrayList ScopeAtEntry))))
      (set! (.modules b) (box! (unit-allocator) (ArrayList (slice u8)) (primitive/zeroed (ArrayList (slice u8)))))
      (set! (.index b) (box! (unit-allocator) (HashMap i64 i64) (primitive/zeroed (HashMap i64 i64))))
      (scope-at-fresh-lists! b)
      (set! (.init b) 1)
      0)
    b))

;;; Drop every entry. Same lifetime as the other qualification side maps.
(defn scope-at-reset [] (-> i64)
  (let [b (scope-at-ready)]
    (scratch/scratch-reset! (field b arena))
    (scope-at-fresh-lists! b)))

(defn scope-link-count [] (-> i64) (len (load (.links (scope-at-ready)))))
(defn scope-node-count [] (-> i64) (len (load (.nodes (scope-at-ready)))))
(defn scope-module-count [] (-> i64) (len (load (.modules (scope-at-ready)))))

(defn scope-link-at [(i i64)] (-> ScopeLink) (get (load (.links (scope-at-ready))) i))
(defn scope-module-at [(i i64)] (-> (slice u8)) (get (load (.modules (scope-at-ready))) i))

;;; Remove the entries appended after a mark (a probe that keeps nothing).
(defn scope-at-truncate! [(links i64) (nodes i64) (modules i64)] (-> i64)
  (let [b (scope-at-ready)]
    (set! (.len (.links b)) links)
    (set! (.len (.nodes b)) nodes)
    (set! (.len (.modules b)) modules)
    (set! (.indexed b) false)
    0))

;;; A new binding of NAME whose enclosing scope is the link PARENT; its index.
(defn scope-link-push! [(name (slice u8)) (parent i64)] (-> i64)
  (let [b (scope-at-ready)]
    (push! (.links b)
           (ScopeLink :name (res-own-name (scratch/scratch-allocator (field b arena)) name)
                      :parent parent))
    (- (len (load (.links b))) 1)))

;;; The index of MODULE in the module list, adding it when it is new.
(defn scope-at-module! [(module (slice u8))] (-> i64)
  (let [b (scope-at-ready)
        ms (load (.modules b))]
    (block :found
      (for [i 0 (len ms)]
        (when (= (get ms i) module) (break :found i)))
      (push! (.modules b) (res-own-name (scratch/scratch-allocator (field b arena)) module))
      (- (len (load (.modules b))) 1))))

(defn scope-at-record! [(node-id i64) (tip i64) (module i64)] (-> i64)
  (unless (<= node-id 0)
    (let [b (scope-at-ready)]
      (push! (.nodes b) (ScopeAtEntry :node-id node-id :tip tip :module module))
      (set! (.indexed b) false)
      0)))

;;; The scope recorded at NODE-ID: the latest record wins, as a requalified or
;;; replayed form records its nodes again.
(defn scope-at-lookup [(node-id i64)] (-> (Option ScopeAtEntry))
  (let [b (scope-at-ready)
        nodes (load (.nodes b))]
    (unless (.indexed b)
      (let [(mut index) (hm-new [i64 i64] (scratch/scratch-allocator (field b arena)) (i64-keyops))]
        (for [i 0 (len nodes)]
          (set! (mut index) (.node-id (get nodes i)) i))
        (set! (load (field b index)) index)
        (set! (.indexed b) true))
      0)
    (match (get (load (load (field b index))) node-id)
      (None [] (None [ScopeAtEntry]))
      (Some [i] (Some (get nodes i))))))

;;; Is NAME one of the locals in scope at the link TIP?
(defn scope-binds? [(tip i64) (name (slice u8))] (-> bool)
  (let [links (load (.links (scope-at-ready)))
        (mut at) tip]
    (block :found
      (while (>= at 0)
        (let [l (get links at)]
          (when (= (.name l) name) (break :found true))
          (set! at (.parent l))))
      false)))

; mk-sexp / mk-tok / mk-diag / mk-diag-src / mk-strread / box-items / box-sexp
; moved to the reader with the types they construct.
(defn box-expr [(a (dyn Allocator)) (e Expr)] (-> (ptr Expr))
  (let [s (ast-unit-state)]
    (when (.profile s) (set! (.boxed_exprs s) (+ (.boxed_exprs s) 1)) 0))
  (box! a Expr e))

; When a head symbol is SHADOWED by a local, expansion is suppressed and the form
; becomes an ordinary call — which then fails to resolve, because a local is not a
; function. Left alone, resolve reported "call to undefined function 'when'; it is
; defined in module 'coil.control', which is not imported here" — and that suffix is
; FALSE: coil.control is re-exported by the prelude, which is the very reason `when`
; was shadowable. Record the exact call site here so resolve can say what actually
; happened instead of guessing at an import problem. Keyed by span, not by name: the
; same name may be shadowed in one function and genuinely undefined in another.
(defstruct ShadowBox
  [(init i64) (srcs (ptr (ArrayList i64))) (node-ids (ptr (ArrayList i64)))])

(defn shadow-box [] (-> (ptr ShadowBox))
  (field (ast-unit-state) shadow_calls))

(defn shadow-init! [] (-> i64)
  (let [b (shadow-box)]
    (when (= (load (field b init)) (primitive/cast i64 0))
      (store! (field b srcs)
              (box! (unit-allocator)
                    (ArrayList i64)
                    (primitive/zeroed (ArrayList i64))))
      (store! (load (field b srcs)) (al-new [i64] (unit-allocator)))
      (store! (field b node-ids)
              (box! (unit-allocator)
                    (ArrayList i64)
                    (primitive/zeroed (ArrayList i64))))
      (store! (load (field b node-ids)) (al-new [i64] (unit-allocator)))
      (store! (field b init) 1)
      0))
  0)

(defn shadow-note! [(src i64) (node-id i64)] (-> i64)
  (shadow-init!)
  (let [b (shadow-box)]
    (push! (load (field b srcs)) src)
    (push! (load (field b node-ids)) node-id))
  0)

(defn shadowed-call? [(src i64) (node-id i64)] (-> bool)
  (shadow-init!)
  (let [b (shadow-box)
        n (len (load (load (field b srcs))))
        (mut i) 0
        (mut found) false]
    (loop (if (or (load found) (>= (load i) n))
              (break)
              (do
                (when (and (= (get (load (load (field b srcs))) (load i)) src)
                           (= (get (load (load (field b node-ids))) (load i)) node-id))
                  (store! found true)
                  0)
                (set! i (primitive/iadd (load i) 1)))))
    (load found)))

(defn box-type [(a (dyn Allocator)) (t Type)] (-> (ptr Type))
  (let [s (ast-unit-state)]
    (when (.profile s) (set! (.boxed_types s) (+ (.boxed_types s) 1)) 0))
  (box! a Type t))

(defn mk-expr [(kind ExprKind) (lo i64) (hi i64) (source i64) (ctxt i64)] (-> Expr)
  (let [p (primitive/alloc-stack Expr)]
    (set! (.kind p) kind)
    (set! (.lo p) lo)
    (set! (.hi p) hi)
    (set! (.source p) source)
    (set! (.ctxt p) ctxt)
    (set! (.node-id p) -1)
    (load p)))

; Like mk-expr but carrying a source node id (parse-expr uses this so type-of can key
; on node identity). Synthesized exprs keep mk-expr's -1.
(defn mk-expr-node-id [(kind ExprKind)
                   (lo i64)
                   (hi i64)
                   (source i64)
                   (ctxt i64)
                   (node-id i64)] (-> Expr)
  (let [p (primitive/alloc-stack Expr)]
    (set! (.kind p) kind)
    (set! (.lo p) lo)
    (set! (.hi p) hi)
    (set! (.source p) source)
    (set! (.ctxt p) ctxt)
    (set! (.node-id p) node-id)
    (load p)))

; Rebuild a Sexp of `kind` preserving `orig`'s full span (source+ctxt+lo+hi),
; mirroring `Sexp::new(kind, s.span)` — so the expander's non-macro
; List/Vector reconstruction never drops source/ctxt.
; mk-sexp-src moved to the reader alongside mk-sexp.

; ============================ numeric/string utils ===========================
; `f64-bits` / `bits->f64` now live in coil.mem — this file, comptime.coil,
; interp.coil, metahost.coil, codegen.coil and coil.serde.msgpack each carried
; their own stack-round-trip copy.

; `slice->cstr` lived here and was a byte-loop re-derivation of coil.str's
; `str->cstr`. Deleted — the compiler uses the stdlib one.

; ============================ output primitives ==============================
(defn wb [(w (ptr Writer)) (b i64)] (-> i64)
  (write-byte w (primitive/cast u8 b))
  0)

(defn ps [(w (ptr Writer)) (s (slice u8))] (-> i64)
  (print-str w s)
  0)

(defn hexd [(d i64)] (-> i64)
  (if (< d (primitive/cast i64 10)) (primitive/iadd d 48) (primitive/iadd d 87)))

(defn dump-dec-mag [(w (ptr Writer)) (n i64)] (-> i64)
  (if (< n (primitive/cast i64 10))
      (wb w (primitive/iadd n 48))
      (do
        (dump-dec-mag w (primitive/udiv n 10))
        (wb w (primitive/iadd (primitive/urem n 10) 48)))))

(defn dump-dec [(w (ptr Writer)) (n i64)] (-> i64)
  (if (< n (primitive/cast i64 0))
      (do (wb w 45) (dump-dec-mag w (primitive/isub 0 n)))
      (dump-dec-mag w n)))

(defn u-hex16 [(w (ptr Writer)) (n i64)] (-> i64)
  (let [(mut k) 60]
    (loop (if (< (load k) (primitive/cast i64 0))
              (break)
              (do
                (wb w (hexd (primitive/iand (primitive/ishr n (load k)) 15)))
                (set! k (primitive/isub (load k) 4))))))
  0)

; A span `@lo:hi`, dummy (lo/hi = -1) prints as `@D:…`/`…:D` (mirrors dump_span).
(defn dump-span-field [(w (ptr Writer)) (v i64)] (-> i64)
  (if (< v (primitive/cast i64 0)) (wb w 68) (dump-dec w v)))

(defn dump-span [(w (ptr Writer)) (source i64) (lo i64) (hi i64) (ctxt i64)] (-> i64)
  (wb w 64)
  (dump-span-field w source)
  (wb w 58)
  (dump-span-field w lo)
  (wb w 58)
  (dump-span-field w hi)
  (wb w 58)
  (dump-span-field w ctxt))

(defn hex2 [(w (ptr Writer)) (b i64)] (-> i64)
  (wb w (hexd (primitive/iand (primitive/ishr b 4) 15)))
  (wb w (hexd (primitive/iand b 15))))

(defn esc-write [(w (ptr Writer)) (s (slice u8))] (-> i64)
  (let [(mut i) 0
        n (len s)]
    (loop (if (>= (load i) n)
              (break)
              (do
                (let [b (primitive/cast i64 (get s (load i)))]
                  (cond (= b (primitive/cast i64 92)) (ps w "\\\\")
                        (= b (primitive/cast i64 34)) (ps w "\\\"")
                        (= b (primitive/cast i64 10)) (ps w "\\n")
                        (= b (primitive/cast i64 9)) (ps w "\\t")
                        (= b (primitive/cast i64 13)) (ps w "\\r")
                        (and (>= b (primitive/cast i64 32))
                             (<= b (primitive/cast i64 126)))
                          (wb w b)
                        :else (do (ps w "\\x") (hex2 w b))))
                (set! i (primitive/iadd (load i) 1))))))
  0)

; A quoted string `"<escaped>"`.
(defn dstr [(w (ptr Writer)) (s (slice u8))] (-> i64)
  (wb w 34)
  (esc-write w s)
  (wb w 34))

; A bool as '1'/'0'.
(defn dbool [(w (ptr Writer)) (b bool)] (-> i64)
  (if b (wb w 49) (wb w 48)))

; ============================ Sexp canonical dump (for quote) =================
; Mirrors dump_node (reused by EQuote / QLit). Identical to
; src/compiler/reader.coil's dumper.
(defn sx-atom [(w (ptr Writer))
               (tag (slice u8))
               (s (slice u8))
               (source i64)
               (lo i64)
               (hi i64)
               (ctxt i64)] (-> i64)
  (wb w 40)
  (ps w tag)
  (dump-span w source lo hi ctxt)
  (ps w " \"")
  (esc-write w s)
  (ps w "\")"))

(defn sx-seq [(w (ptr Writer))
              (tag (slice u8))
              (items (ptr (ArrayList Sexp)))
              (source i64)
              (lo i64)
              (hi i64)
              (ctxt i64)] (-> i64)
  (wb w 40)
  (ps w tag)
  (dump-span w source lo hi ctxt)
  (let [(mut i) 0
        n (len (load items))]
    (loop (if (>= (load i) n)
              (break)
              (do
                (wb w 32)
                (let [child (primitive/alloc-stack Sexp)]
                  (set! child (get (load items) (load i)))
                  (sx-node w child))
                (set! i (primitive/iadd (load i) 1))))))
  (wb w 41))

(defn sx-node [(w (ptr Writer)) (x (ptr Sexp))] (-> i64)
  (let [lo (.lo x)
        hi (.hi x)
        src (.source x)
        ctxt (.ctxt x)]
    (match (.kind x)
      (KInt [v]
            (do
              (ps w "(int")
              (dump-span w src lo hi ctxt)
              (wb w 32)
              (dump-dec w v)
              (wb w 41)))
      (KFloat [bits]
              (do
                (ps w "(float")
                (dump-span w src lo hi ctxt)
                (ps w " 0x")
                (u-hex16 w bits)
                (wb w 41)))
      (KSym [s] (sx-atom w "sym" s src lo hi ctxt))
      (KKw [s] (sx-atom w "kw" s src lo hi ctxt))
      (KStr [s] (sx-atom w "str" s src lo hi ctxt))
      (KCStr [s] (sx-atom w "cstr" s src lo hi ctxt))
      (KList [items] (sx-seq w "list" items src lo hi ctxt))
      (KVec [items] (sx-seq w "vec" items src lo hi ctxt))
      ; a view is metaprogram-plane only (promotion flattens it); loud, not silent
      (KView [items off len] (ps w "(VIEW-LEAKED-TO-DUMP)"))
      (KSeg [parts len flat] (ps w "(JOINED-LIST-LEAKED-TO-DUMP)")))))

; Opt-in syntax-object dump. Normal reader/AST snapshots deliberately omit
; unstable scope IDs; `dump-hygiene` uses this form for audit/debugging.
(defn sx-hmeta [(w (ptr Writer)) (x (ptr Sexp))] (-> i64)
  (ps w "#scope=")
  (dump-dec w (.hyg x))
  (ps w ",module=\"")
  (esc-write w (.hmod x))
  (ps w "\",origin=")
  (dump-dec w (.horigin x))
  (ps w ",flags=")
  (dump-dec w (.hflags x)))

(defn sx-hnode [(w (ptr Writer)) (x (ptr Sexp))] (-> i64)
  (let [lo (.lo x)
        hi (.hi x)
        src (.source x)
        ctxt (.ctxt x)]
    (match (.kind x)
      (KInt [v]
            (do
              (ps w "(int")
              (dump-span w src lo hi ctxt)
              (wb w 32)
              (dump-dec w v)
              (wb w 41)))
      (KFloat [bits]
              (do
                (ps w "(float")
                (dump-span w src lo hi ctxt)
                (ps w " 0x")
                (u-hex16 w bits)
                (wb w 41)))
      (KSym [s]
            (do
              (ps w "(sym")
              (dump-span w src lo hi ctxt)
              (sx-hmeta w x)
              (ps w " \"")
              (esc-write w s)
              (ps w "\")")))
      (KKw [s] (sx-atom w "kw" s src lo hi ctxt))
      (KStr [s] (sx-atom w "str" s src lo hi ctxt))
      (KCStr [s] (sx-atom w "cstr" s src lo hi ctxt))
      (KList [items]
             (do
               (ps w "(list")
               (dump-span w src lo hi ctxt)
               (sx-hmeta w x)
               (let [n (len (load items))
                     (mut i) 0]
                 (loop (if (>= (load i) n)
                           (break)
                           (do
                             (wb w 32)
                             (sx-hnode w (al-elem [Sexp] items (load i)))
                             (set! i (primitive/iadd (load i) 1))))))
               (wb w 41)))
      (KVec [items]
            (do
              (ps w "(vec")
              (dump-span w src lo hi ctxt)
              (sx-hmeta w x)
              (let [n (len (load items))
                    (mut i) 0]
                (loop (if (>= (load i) n)
                          (break)
                          (do
                            (wb w 32)
                            (sx-hnode w (al-elem [Sexp] items (load i)))
                            (set! i (primitive/iadd (load i) 1))))))
              (wb w 41)))
      (KView [_ _ _] (ps w "(VIEW-LEAKED-TO-HYGIENE-DUMP)"))
      (KSeg [_ _ _] (ps w "(JOINED-LIST-LEAKED-TO-HYGIENE-DUMP)")))))

; ============================ AST canonical dump =============================

; `["a" "b"]` — a vector of strings.

;;; Optional per-submission evidence emitted at the actual parser/checker/backend
;;; boundaries. Nested compiler units inherit the flag, so nested work is visible.
;;; Whether the last JIT publication reached its transaction entry. A runner
;;; returns the entry's own status, so a nonzero status alone cannot tell "the
;;; entry rejected the candidate" from "publication failed before the entry".
(defn jit-entry-ran-cell [] (-> (ptr bool)) (primitive/alloc-static bool false))

(defn compiler-work! [(stage (slice u8)) (name (slice u8))] (-> i64)
  (when (.jit_work_trace (ast-unit-state))
    (let [w (stderr)]
      (print-str w "jit-work ")
      (print-str w stage)
      (print-str w " ")
      (print-str w name)
      (print-str w "\n"))
    0)
  0)

;;; Does this export take a struct by value? The direct backends pass a struct
;;; parameter by reference internally, so such an export needs a C-ABI thunk.
(defn export-c-needs-thunk? [(e (ptr ExportC))] (-> bool)
  (let [(mut found) false]
    (for t (load (.params e))
      (match t (TStruct [_] (set! found true)) (_ 0)))
    found))

;;; The function that DEFINES the C symbol `link` for this program, if an
;;; `(export-c [f :as "link"])` does: externs of that symbol bind to it instead of
;;; to an undefined symbol (a thunk export is the checker's to reject).
(defn export-c-interposer [(mp (ptr Program)) (link (slice u8))] (-> (Option (slice u8)))
  (let [(mut found) (None [(slice u8)])]
    (for i (range 0 (len (load (.exports mp))))
      (let [e (al-elem [ExportC] (.exports mp) i)]
        (match (.symbol e)
          (Some [symbol]
                (when (and (= symbol link) (not (export-c-needs-thunk? e)))
                  (set! found (Some [(slice u8)] (.name e)))))
          (None [] 0))))
    found))

;;; The internal name of the thunk that exposes `name` under its C symbol.
(defn export-c-thunk-name [(a (dyn Allocator)) (name (slice u8))] (-> (slice u8))
  (let [(mut b) (sb-new a)]
    (sb-push-str! (mut b) name)
    (sb-push-str! (mut b) ".c-abi-thunk")
    (sb-finish! (mut b))))

;;; For each export that takes a struct by value, a function that receives its
;;; arguments under the C ABI (by value) and calls the real function with the
;;; address of each struct argument, which is how the direct backends pass a
;;; struct to a Coil function. The backend exports the thunk under the C symbol and leaves
;;; the real function internal.
(defn export-c-thunks [(a (dyn Allocator)) (mp (ptr Program))] (-> (ArrayList Func))
  (let [(mut out) (al-new [Func] a)]
    (for i (range 0 (len (load (.exports mp))))
      (let [e (al-elem [ExportC] (.exports mp) i)]
        (when (export-c-needs-thunk? e)
          (let [(mut target) (primitive/cast (ptr Func) 0)]
            (for j (range 0 (len (load (.funcs mp))))
              (let [f (al-elem [Func] (.funcs mp) j)]
                (when (= (.name f) (.name e)) (set! target f))))
            (when (!= (primitive/cast i64 (load target)) 0)
              (let [(mut params) (al-new [Param] a)
                    (mut args) (al-new [Expr] a)]
                (for k (range 0 (len (load (.params e))))
                  (let [pname (let [(mut b) (sb-new a)]
                                (sb-push-str! (mut b) "c-arg")
                                (sb-push-i64! (mut b) k)
                                (sb-finish! (mut b)))
                        ty (get (load (.params e)) k)
                        p (primitive/alloc-stack Param)
                        var (mk-expr (EVar pname) -1 -1 -1 0)]
                    (set! p (primitive/zeroed Param))
                    (set! (.name p) pname)
                    (set! (.ty p) ty)
                    (push! (mut params) (load p))
                    (push! (mut args)
                           (match ty
                             ; the address of the by-value copy the thunk received
                             (TStruct [_] (mk-expr (ESpillRef (box-expr a var)) -1 -1 -1 0))
                             (_ var)))))
                (let [f (primitive/alloc-stack Func)
                      (mut body) (al-new [Expr] a)]
                  (push! (mut body)
                         (mk-expr (ECall (.name e) (box! a (ArrayList Type) (al-new [Type] a)) (box! a (ArrayList Expr) (load args)))
                                  -1 -1 -1 0))
                  (set! f (primitive/zeroed Func))
                  (set! (.name f) (export-c-thunk-name a (.name e)))
                  (set! (.type_params f) (box! a (ArrayList (slice u8)) (al-new [(slice u8)] a)))
                  (set! (.bounds f) (box! a (ArrayList Bound) (al-new [Bound] a)))
                  (set! (.cc f) (.cc (load target)))
                  (set! (.annotations f) (box! a (ArrayList Annotation) (al-new [Annotation] a)))
                  (set! (.params f) (box! a (ArrayList Param) (load params)))
                  (set! (.ret f) (.ret (load target)))
                  (set! (.body f) (box! a (ArrayList Expr) (load body)))
                  (set! (.lo f) -1)
                  (set! (.hi f) -1)
                  (set! (.source f) -1)
                  (push! (mut out) (load f)))))))))
    out))


; Authored-reference evidence is separate from checked declaration reflection.
; It is enabled for source lint analysis only and owned by the compilation unit.
; Keys include lexical hygiene: a generated identifier sharing a source span
; must never supply evidence for an unrelated authored identifier.
(defstruct SourceSite [(node Sexp) (role (slice u8))])
(defstruct SourceAnswer [(name (slice u8)) (local bool) (ambiguous bool)])
(defstruct SourceRoute [(target (slice u8)) (exported (slice u8)) (qualified (slice u8))])
(defstruct SourceFacts
  [(enabled bool)
   (allocator (dyn Allocator))
   (observing bool)
   (observations (ArrayList SourceObservation))
   (sites (HashMap (slice u8) SourceSite))
   (roles (HashMap (slice u8) SourceSite))
   (macro_roles (HashMap (slice u8) SourceSite))
   (macro_answers (HashMap (slice u8) SourceAnswer))
   (primitive_roles (HashMap (slice u8) SourceSite))
   (primitive_answers (HashMap (slice u8) SourceAnswer))
   (locals (HashMap (slice u8) i64))
   (nonreferences (HashMap (slice u8) bool))
   (answers (HashMap (slice u8) SourceAnswer))
   (types (HashMap (slice u8) SourceAnswer))
   (routes (HashMap (slice u8) SourceRoute))
   (primitives (HashMap (slice u8) SourcePrimitive))
   (declarations (HashMap (slice u8) bool))])

(defn source-facts [] (-> (ptr SourceFacts))
  (field (ast-unit-state) source_facts))

(defn source-facts-start! [] (-> i64)
  (let [b (source-facts) a (unit-allocator)]
    (set! (.enabled b) true)
    (set! (.allocator b) a)
    (set! (.observing b) true)
    (set! (.observations b) (al-new [SourceObservation] a))
    (set! (.sites b) (hm-new [(slice u8) SourceSite] a (str-keyops)))
    (set! (.roles b) (hm-new [(slice u8) SourceSite] a (str-keyops)))
    (set! (.macro_roles b) (hm-new [(slice u8) SourceSite] a (str-keyops)))
    (set! (.macro_answers b) (hm-new [(slice u8) SourceAnswer] a (str-keyops)))
    (set! (.primitive_roles b) (hm-new [(slice u8) SourceSite] a (str-keyops)))
    (set! (.primitive_answers b) (hm-new [(slice u8) SourceAnswer] a (str-keyops)))
    (set! (.locals b) (hm-new [(slice u8) i64] a (str-keyops)))
    (set! (.nonreferences b) (hm-new [(slice u8) bool] a (str-keyops)))
    (set! (.answers b) (hm-new [(slice u8) SourceAnswer] a (str-keyops)))
    (set! (.types b) (hm-new [(slice u8) SourceAnswer] a (str-keyops)))
    (set! (.routes b) (hm-new [(slice u8) SourceRoute] a (str-keyops)))
    (set! (.primitives b) (hm-new [(slice u8) SourcePrimitive] a (str-keyops)))
    (set! (.declarations b) (hm-new [(slice u8) bool] a (str-keyops))))
  0)

(defn source-occurrence-key [(a (dyn Allocator)) (node Sexp)] (-> (slice u8))
  (let [(mut out) (sb-new a)]
    (sb-push-i64! (mut out) (.source node)) (sb-push-str! (mut out) ":")
    (sb-push-i64! (mut out) (.lo node)) (sb-push-str! (mut out) ":")
    (sb-push-i64! (mut out) (.hi node)) (sb-push-str! (mut out) ":")
    (sb-push-i64! (mut out) (.hyg node)) (sb-push-str! (mut out) ":")
    (sb-push-i64! (mut out) (.horigin node)) (sb-push-str! (mut out) ":")
    (sb-push-str! (mut out) (.hmod node)) (sb-push-str! (mut out) ":")
    ; Context-copying operations can retain a span while creating another name
    ; or syntax data. Neither is the authored reference whose evidence we own.
    (sb-push-str! (mut out) (match (.kind node) (KSym [name] name) (_ "")))
    (sb-str (load out))))

(defn source-name-key [(a (dyn Allocator)) (module (slice u8))
                        (raw (slice u8)) (kind i64)] (-> (slice u8))
  (let [(mut out) (sb-new a)]
    (sb-push-str! (mut out) module) (sb-push-str! (mut out) ":")
    (sb-push-i64! (mut out) kind) (sb-push-str! (mut out) ":")
    (sb-push-str! (mut out) raw)
    (sb-str (load out))))

(defn source-expression-key [(a (dyn Allocator)) (source i64) (lo i64)
                              (hi i64) (ctxt i64) (id i64)] (-> (slice u8))
  (let [(mut out) (sb-new a)]
    (sb-push-i64! (mut out) source) (sb-push-str! (mut out) ":")
    (sb-push-i64! (mut out) lo) (sb-push-str! (mut out) ":")
    (sb-push-i64! (mut out) hi) (sb-push-str! (mut out) ":")
    (sb-push-i64! (mut out) ctxt) (sb-push-str! (mut out) ":")
    (sb-push-i64! (mut out) id)
    (sb-str (load out))))

(defn source-site-record! [(origin Sexp) (node Sexp) (role (slice u8))] (-> i64)
  (when (and (.enabled (source-facts))
             (and (match (.kind node) (KSym [_] true) (_ false)) (and (>= (.source node) 0) (>= (.lo node) 0))))
    (let [owned (primitive/alloc-stack Sexp)
          a (.allocator (source-facts))]
      (set! owned node)
      (set! (.hmod owned) (res-own-name a (.hmod node)))
      (set! (.kind owned) (KSym (match (.kind node) (KSym [name] (res-own-name a name)) (_ ""))))
      (let [site (SourceSite :node (load owned) :role role)]
      (set! (mut (.sites (source-facts)))
        (source-expression-key a (.source origin) (.lo origin) (.hi origin) (.ctxt origin) (.node-id origin)) site)
      (set! (mut (.roles (source-facts))) (source-occurrence-key (.allocator (source-facts)) node) site))) 0)
  0)

(defn source-answer-merge! [(table (mut (HashMap (slice u8) SourceAnswer)))
                            (key (slice u8)) (name (slice u8)) (local bool)] (-> i64)
  (let [next (SourceAnswer :name (res-own-name (.allocator (source-facts)) name) :local local :ambiguous false)]
    ; A name that resolution left as written answers nothing. A definition a macro
    ; generates is not there on a first pass, and the pass that finds it must not
    ; read as a disagreement with the one that did not.
    (unless (and (not local) (= (len name) 0))
      (match (get table key)
        (None [] (set! (mut table) key next))
        (Some [old]
          (when (or (.ambiguous old) (or (!= (.name old) name) (!= (.local old) local)))
            (set! (mut table) key (SourceAnswer :name "" :local false :ambiguous true)) 0)))))
  0)

(defn source-expression-answer! [(expr (ptr Expr)) (name (slice u8)) (local bool)] (-> i64)
  (when (.enabled (source-facts))
    (match (get (.sites (source-facts))
             (source-expression-key (.allocator (source-facts))
               (.source expr) (.lo expr) (.hi expr) (.ctxt expr) (.node-id expr)))
      (None [] 0)
      (Some [site]
        (source-answer-merge! (mut (.answers (source-facts)))
          (source-occurrence-key (.allocator (source-facts)) (.node site)) name local))) 0)
  0)

(defn source-macro-answer! [(head Sexp) (name (slice u8))] (-> i64)
  (when (and (.enabled (source-facts)) (and (>= (.source head) 0) (>= (.lo head) 0)))
    (let [key (source-occurrence-key (.allocator (source-facts)) head)
          owned (primitive/alloc-stack Sexp)]
      (set! owned head)
      (set! (.hmod owned) (res-own-name (.allocator (source-facts)) (.hmod head)))
      (set! (.kind owned) (KSym (res-own-name (.allocator (source-facts))
        (match (.kind head) (KSym [name] name) (_ "")))))
      (set! (mut (.macro_roles (source-facts))) key (SourceSite :node (load owned) :role "macro")))
    (source-answer-merge! (mut (.macro_answers (source-facts)))
      (source-occurrence-key (.allocator (source-facts)) head) name false) 0)
  0)

(defn source-type-answer! [(module (slice u8)) (raw (slice u8))
                            (name (slice u8)) (local bool)] (-> i64)
  (when (.enabled (source-facts))
    (source-answer-merge! (mut (.types (source-facts)))
      (source-name-key (.allocator (source-facts)) module raw 1) name local) 0)
  0)

; Record at the successful lookup, retaining the imported facade and exported
; spelling even when the declaration is reexported or renamed.
(defn source-route-record! [(module (slice u8)) (raw (slice u8)) (kind i64)
                             (target (slice u8)) (exported (slice u8)) (qualified (slice u8))] (-> i64)
  (when (.enabled (source-facts))
    (set! (mut (.routes (source-facts)))
      (source-name-key (.allocator (source-facts)) module raw kind)
      (SourceRoute :target (res-own-name (.allocator (source-facts)) target)
                   :exported (res-own-name (.allocator (source-facts)) exported)
                   :qualified (res-own-name (.allocator (source-facts)) qualified))) 0)
  0)


(defn source-local-answer! [(expr (ptr Expr)) (binding i64)] (-> i64)
  (when (and (.enabled (source-facts)) (> binding 0))
    (match (get (.sites (source-facts))
             (source-expression-key (.allocator (source-facts))
               (.source expr) (.lo expr) (.hi expr) (.ctxt expr) (.node-id expr)))
      (None [] 0)
      (Some [site]
        (let [key (source-occurrence-key (.allocator (source-facts)) (.node site))]
          (match (get (.locals (source-facts)) key)
            (None [] (do (set! (mut (.locals (source-facts))) key binding) 0))
            (Some [old]
              (do (unless (= old binding) (set! (mut (.locals (source-facts))) key -1) 0)
                  0)))))) 0)
  0)


;;; The route recorded for RAW as a name of kind FROM, also recorded as one of kind
;;; TO, for a spelling used in a position another kind of lookup named.
(defn source-route-copy! [(module (slice u8)) (raw (slice u8)) (from i64) (to i64)] (-> i64)
  (when (.enabled (source-facts))
    (let [a (.allocator (source-facts))]
      (match (get (.routes (source-facts)) (source-name-key a module raw from))
        (Some [route]
          (do (set! (mut (.routes (source-facts))) (source-name-key a module raw to) route) 0))
        (None [] 0))) 0)
  0)

(defstruct SourceImportOrigin [(module (slice u8)) (target (slice u8))])
(defn source-import-record! [(node Sexp) (module (slice u8)) (target (slice u8))] (-> i64)
  (when (and (>= (.source node) 0) (>= (.lo node) 0))
    (let [state (ast-unit-state)]
      (unless (.source_import_origins_ready state)
        (set! (.source_import_origins state)
          (hm-new [(slice u8) SourceImportOrigin] (unit-allocator) (str-keyops)))
        (set! (.source_import_origins_ready state) true) 0)
      (set! (mut (.source_import_origins state))
        (source-occurrence-key (unit-allocator) node)
        (SourceImportOrigin :module (res-own-name (unit-allocator) module)
                            :target (res-own-name (unit-allocator) target)))) 0)
  0)


(defstruct SourceObservation [(source i64) (lo i64) (hi i64)])
;;; A macro asked about syntax contents rather than only transporting syntax.
;;; Qualification refuses an edited identifier inside an observed interval.
(defn source-observe! [(node Sexp)] (-> i64)
  (when (and (.observing (source-facts)) (and (>= (.source node) 0) (>= (.lo node) 0)))
    (push! (mut (.observations (source-facts)))
      (SourceObservation :source (.source node) :lo (.lo node) :hi (.hi node))) 0)
  0)

(defn source-observed? [(node Sexp)] (-> bool)
  (let [(mut found) false]
    (for observed (.observations (source-facts))
      (when (and (= (.source observed) (.source node))
                 (and (< (.lo node) (.hi observed)) (< (.lo observed) (.hi node))))
        (set! found true) 0))
    (load found)))


; Macro staging parses provisional programs. Their expression bindings are not
; the application's final semantic evidence. Keep actual macro dispatch and
; primitive parser dispatch (including cached parsed forms), and syntax
; observations, then collect ordinary references in the checked revision.
;
; The parse-time records `sites` and `roles` stay. They say what role an
; identifier plays where it was parsed, which is a fact about the parse and not a
; binding, and the final check does not parse a form again when a cached revision
; of it exists, so clearing them left every identifier of such a form with no role
; and no way to attach the answers resolution records now. An identifier a macro
; consumed as syntax keeps a role but gets no answer, which reads as an unknown
; binding and refuses the edit, exactly as a missing role did.
(defn source-facts-semantic-reset! [] (-> i64)
  (let [b (source-facts) a (.allocator (source-facts))]
    (set! (.locals b) (hm-new [(slice u8) i64] a (str-keyops)))
    (set! (.nonreferences b) (hm-new [(slice u8) bool] a (str-keyops)))
    (set! (.answers b) (hm-new [(slice u8) SourceAnswer] a (str-keyops)))
    (set! (.types b) (hm-new [(slice u8) SourceAnswer] a (str-keyops)))
    (set! (.primitives b) (hm-new [(slice u8) SourcePrimitive] a (str-keyops))))
  0)


(defn source-nonreference! [(node Sexp)] (-> i64)
  (when (.enabled (source-facts))
    (set! (mut (.nonreferences (source-facts)))
      (source-expression-key (.allocator (source-facts)) (.source node) (.lo node) (.hi node) 0 0) true) 0)
  0)


(defstruct SourcePrimitive [(qualified (slice u8)) (opcode (slice u8))])
(defn source-primitive-record! [(module (slice u8)) (raw (slice u8))
                                 (qualified (slice u8)) (opcode (slice u8))] (-> i64)
  (when (.enabled (source-facts))
    (let [a (.allocator (source-facts)) key (source-name-key a module raw 7)]
      ; The parser's spelling index uses the first binding in this same table.
      (match (get (.primitives (source-facts)) key)
        (Some [_] 0)
        (None []
          (do (set! (mut (.primitives (source-facts))) key
                (SourcePrimitive :qualified (res-own-name a qualified) :opcode (res-own-name a opcode))) 0)))) 0)
  0)

(defn source-primitive-head! [(head Sexp) (opcode (slice u8))] (-> i64)
  (when (.enabled (source-facts))
    (let [a (.allocator (source-facts))
          module (if (and (> (.hyg head) 0) (> (len (.hmod head)) 0))
                     (.hmod head) (src-mod-lookup (.source head)))
          raw (match (.kind head) (KSym [name] name) (_ ""))]
      (match (get (.primitives (source-facts)) (source-name-key a module raw 7))
        (None [] 0)
        (Some [binding]
          (when (= (.opcode binding) opcode)
            (source-site-record! head head "primitive")
            (let [key (source-occurrence-key a head)]
              (match (get (.roles (source-facts)) key)
                (Some [site] (set! (mut (.primitive_roles (source-facts))) key site))
                (None [] 0)))
            (source-answer-merge! (mut (.primitive_answers (source-facts)))
              (source-occurrence-key a head) (.qualified binding) false) 0)))) 0)
  0)
