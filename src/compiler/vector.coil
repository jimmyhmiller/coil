(module coil.compiler.vector)
(import "coil.primitive" :as primitive)
(import "coil.compiler.ast" :use *)
(import "coil.compiler.vector_ops" :use *)
(import "coil.compiler.parser" :use *)
(import "coil.compiler.resolve" :use *)
(import "coil.alloc" :use *)
(import "coil.arraylist" :use *)
(import "coil.str" :use *)
(import "coil.try" :use *)
(import "coil.reader" :use *)

(defn vector-numeric-lane? [(lane (ptr Type)) (generic bool)] (-> bool)
  (match (load lane)
    (TInt [bits _] (or (= bits 8) (= bits 16) (= bits 32) (= bits 64)))
    (TFloat [bits] (or (= bits 32) (= bits 64)))
    (TStruct [_] generic)
    (_ false)))

(defn vector-integer-lane? [(lane (ptr Type)) (generic bool)] (-> bool)
  (match (load lane)
    (TInt [_ _] (vector-numeric-lane? lane generic))
    (TStruct [_] generic)
    (_ false)))

(defn vector-mask-type [(a (dyn Allocator)) (vector (ptr Type))] (-> Type)
  (TVec (box-type a (TBool)) (vector-width-of-type vector)))

(defn vector-requires-integer? [(op VectorOp)] (-> bool)
  (match op
    (VectorScanXor [] true) (VectorScanOr [] true)
    (VectorAnd [] true) (VectorOr [] true) (VectorXor [] true) (VectorNot [] true)
    (VectorShl [] true) (VectorShr [] true) (VectorAShr [] true)
    (VectorPopcount [] true) (VectorClz [] true) (VectorCtz [] true)
    (VectorBswap [] true) (VectorBitReverse [] true)
    (VectorAddSat [] true) (VectorSubSat [] true)
    (VectorRotl [] true) (VectorRotr [] true)
    (VectorReduceOr [] true) (VectorReduceAnd [] true) (VectorReduceXor [] true)
    (_ false)))

(defn vector-unary? [(op VectorOp)] (-> bool)
  (match op
    (VectorScanAdd [] true) (VectorScanXor [] true) (VectorScanOr [] true) (VectorScanMax [] true)
    (VectorNot [] true) (VectorPopcount [] true) (VectorClz [] true)
    (VectorCtz [] true) (VectorBswap [] true) (VectorBitReverse [] true)
    (VectorAbs [] true) (VectorNeg [] true) (VectorSqrt [] true)
    (VectorFloor [] true) (VectorCeil [] true) (VectorTrunc [] true)
    (VectorRound [] true) (VectorIsNan [] true) (VectorIsFinite [] true)
    (VectorReduceAdd [] true) (VectorReduceOr [] true) (VectorReduceAnd [] true)
    (VectorReduceXor [] true) (VectorReduceMin [] true) (VectorReduceMax [] true)
    (_ false)))

(defn vector-requires-float? [(op VectorOp)] (-> bool)
  (match op
    (VectorDiv [] true) (VectorFma [] true) (VectorSqrt [] true)
    (VectorFloor [] true) (VectorCeil [] true) (VectorTrunc [] true)
    (VectorRound [] true) (VectorIsNan [] true) (VectorIsFinite [] true)
    (_ false)))

(defn vector-boolean-op? [(op VectorOp)] (-> bool)
  (match op
    (VectorScanXor [] true) (VectorScanOr [] true)
    (VectorAnd [] true) (VectorOr [] true) (VectorXor [] true) (VectorNot [] true)
    (VectorEq [] true) (VectorNe [] true)
    (VectorReduceAnd [] true) (VectorReduceOr [] true) (VectorReduceXor [] true)
    (_ false)))

(defn vector-comparison? [(op VectorOp)] (-> bool)
  (match op
    (VectorEq [] true) (VectorNe [] true) (VectorLt [] true)
    (VectorLe [] true) (VectorGt [] true) (VectorGe [] true)
    (VectorIsNan [] true) (VectorIsFinite [] true)
    (_ false)))

(defn vector-reduction? [(op VectorOp)] (-> bool)
  (match op
    (VectorReduceAdd [] true) (VectorReduceOr [] true) (VectorReduceAnd [] true)
    (VectorReduceXor [] true) (VectorReduceMin [] true) (VectorReduceMax [] true)
    (_ false)))

(defn vector-check-arity [(op VectorOp) (types (ptr (ArrayList Type))) (n i64)]
                        (-> (Result i64 Diag))
  (if (= (len (load types)) n) (Ok [i64 Diag] 0)
    (Err [i64 Diag] (derr "vector operation has the wrong number of operands"))))

(defn vector-check-type [(t (ptr Type)) (generic bool)] (-> (Result i64 Diag))
  (match (load t)
    (TVec [elem width]
      (if (and (or (vector-numeric-lane? elem generic) (= (type-tag elem) 2))
               (match width (FixedWidth [n] (> n 0)) (WidthParam [_] generic)))
          (Ok [i64 Diag] 0)
          (Err [i64 Diag] (derr "vector operation requires integer, float, or boolean lanes and a positive width"))))
    (_ (Err [i64 Diag] (derr "vector operation requires a vector type")))))

(defn vector-check-same [(left (ptr Type)) (right (ptr Type))] (-> (Result i64 Diag))
  (if (type-eq left right) (Ok [i64 Diag] 0)
    (Err [i64 Diag] (derr "vector operands must have the same lane type and width"))))

(defn vector-memory? [(op VectorOp)] (-> bool)
  (match op
    (VectorCompressStore [] true) (VectorExpandLoad [] true)
    (VectorLoad [] true) (VectorStore [] true)
    (VectorLoadAligned [] true) (VectorStoreAligned [] true)
    (VectorMaskedLoad [] true) (VectorMaskedStore [] true)
    (VectorGather [] true) (VectorScatter [] true)
    (_ false)))

(defn vector-memory-store? [(op VectorOp)] (-> bool)
  (match op (VectorCompressStore [] true) (VectorStore [] true) (VectorStoreAligned [] true)
    (VectorMaskedStore [] true) (VectorScatter [] true) (_ false)))

(defn vector-memory-indexed? [(op VectorOp)] (-> bool)
  (match op (VectorGather [] true) (VectorScatter [] true) (_ false)))

(defn vector-memory-masked? [(op VectorOp)] (-> bool)
  (match op (VectorCompressStore [] true) (VectorExpandLoad [] true)
    (VectorMaskedLoad [] true) (VectorMaskedStore [] true)
    (VectorGather [] true) (VectorScatter [] true) (_ false)))

(defn vector-lane-bits [(lane (ptr Type))] (-> i64)
  (match (load lane) (TInt [bits _] bits) (TFloat [bits] bits) (TBool [] 1) (_ 0)))

(defn vector-conversion-signature [(a (dyn Allocator)) (op VectorOp)
                                   (requested (ptr Type)) (types (ptr (ArrayList Type)))
                                   (generic bool)] (-> (Result Type Diag))
  (try
    (try! (vector-check-arity op types 1))
    (try! (vector-check-type requested generic))
    (let [source (al-elem [Type] types 0)]
      (try! (vector-check-type source generic))
      (unless (and (vector-numeric-lane? (t-inner source) generic)
                   (vector-numeric-lane? (t-inner requested) generic))
        (break :try (Err [Type Diag] (derr "vector conversions require numeric lanes"))))
      (match op
        (VectorBitcast []
          (unless generic
            (unless (= (* (t-arrn source) (vector-lane-bits (t-inner source)))
                       (* (t-arrn requested) (vector-lane-bits (t-inner requested))))
              (break :try (Err [Type Diag] (derr "vector bitcast requires equal total bit sizes"))))))
        (_ (unless (vector-width-eq (vector-width-of-type source) (vector-width-of-type requested))
             (break :try (Err [Type Diag] (derr "numeric vector conversion preserves lane count"))))))
      (Ok (load requested)))))

(defn vector-widening? [(op VectorOp)] (-> bool)
  (match op (VectorWidenLow [] true) (VectorWidenHigh [] true) (_ false)))

(defn vector-resize-signature [(a (dyn Allocator)) (op VectorOp)
                               (requested (ptr Type)) (types (ptr (ArrayList Type)))
                               (generic bool)] (-> (Result Type Diag))
  (try
    (let [widen (vector-widening? op)]
      (try! (vector-check-arity op types (if widen 1 2)))
      (try! (vector-check-type requested generic))
      (let [src (al-elem [Type] types 0) dst (t-inner requested)]
        (try! (vector-check-type src generic))
        (unless widen (try! (vector-check-same src (al-elem [Type] types 1))))
        (unless (and (vector-numeric-lane? (t-inner src) generic) (vector-numeric-lane? dst generic))
          (break :try (Err [Type Diag] (derr "widening and narrowing require numeric lanes"))))
        (unless generic
          (let [sb (vector-lane-bits (t-inner src)) db (vector-lane-bits dst)]
            (unless (and (= (type-tag (t-inner src)) (type-tag dst))
                         (if widen (= db (* sb 2)) (= sb (* db 2)))
                         (if widen (= (t-arrn src) (* (t-arrn requested) 2))
                                   (= (t-arrn requested) (* (t-arrn src) 2))))
              (break :try (Err [Type Diag] (derr "widen/narrow must double/halve lane bits and halve/double lane count, preserving integer or float kind"))))
            (when (and (match op (VectorNarrowSat [] true) (_ false)) (= (type-tag dst) 1))
              (break :try (Err [Type Diag] (derr "saturating narrowing requires integer lanes"))))))
        (Ok (load requested))))))

(defn vector-permute-signature [(a (dyn Allocator)) (op VectorOp)
                                (types (ptr (ArrayList Type))) (generic bool)]
                                (-> (Result Type Diag))
  (try
    (let [table (match op (VectorTable [] true) (_ false))]
      (try! (vector-check-arity op types (if table 2 3)))
      (let [v (al-elem [Type] types 0)
            indices (al-elem [Type] types (if table 1 2))]
        (try! (vector-check-type v generic))
        (try! (vector-check-type indices generic))
        (unless (vector-integer-lane? (t-inner indices) generic)
          (break :try (Err [Type Diag] (derr "vector permutation indices must be integer lanes"))))
        (if table
          (try! (vector-check-same (t-inner v) (box-type a (TInt 8 false))))
          (try! (vector-check-same v (al-elem [Type] types 1))))
        (Ok (TVec (t-inner v) (vector-width-of-type indices)))))))

(defn vector-memory-signature [(a (dyn Allocator)) (op VectorOp)
                                (requested (ptr Type)) (types (ptr (ArrayList Type)))
                                (generic bool)] (-> (Result Type Diag))
  (try
    (let [writing (vector-memory-store? op)
          masked (vector-memory-masked? op)
          indexed (vector-memory-indexed? op)
          count (if indexed 4 (if masked 3 (if writing 2 1)))]
      (try! (vector-check-arity op types count))
      (let [v (if (or writing masked) (al-elem [Type] types (- count 1)) requested)]
        (try! (vector-check-type v generic))
        (unless (vector-numeric-lane? (t-inner v) generic)
          (break :try (Err [Type Diag] (derr "vector memory operations require numeric lanes; masks have no packed-memory ABI"))))
        (try! (vector-check-same (al-elem [Type] types 0) (box-type a (TPtr (t-inner v)))))
        (when masked
          (try! (vector-check-same (al-elem [Type] types (if indexed 2 1))
                                  (box-type a (vector-mask-type a v)))))
        (when indexed
          (let [indices (al-elem [Type] types 1)]
            (try! (vector-check-type indices generic))
            (unless (and (vector-integer-lane? (t-inner indices) generic)
                         (vector-width-eq (vector-width-of-type v) (vector-width-of-type indices)))
              (break :try (Err [Type Diag] (derr "gather/scatter indices must be integer lanes with the value vector's width"))))))
        (Ok (if writing (TInt 64 true) (load v)))))))

;;; One semantic signature checker, used both before and after specialization.
(defn vector-signature [(a (dyn Allocator)) (op VectorOp) (requested (ptr Type))
                        (types (ptr (ArrayList Type))) (args (ptr (ArrayList Expr)))
                        (generic bool)] (-> (Result Type Diag))
  (try
    (let [result (try! (vector-signature-infer a op requested types args generic))]
      (unless (= (type-tag requested) 3)
        (try! (vector-check-same requested (box-type a result))))
      (Ok result))))

(defn vector-signature-infer [(a (dyn Allocator)) (op VectorOp) (requested (ptr Type))
                              (types (ptr (ArrayList Type))) (args (ptr (ArrayList Expr)))
                              (generic bool)] (-> (Result Type Diag))
  (try
    (when (vector-memory? op)
      (break :try (vector-memory-signature a op requested types generic)))
    (match op
      (VectorBitcast [] (vector-conversion-signature a op requested types generic))
      (VectorWidenLow [] (vector-resize-signature a op requested types generic))
      (VectorWidenHigh [] (vector-resize-signature a op requested types generic))
      (VectorNarrow [] (vector-resize-signature a op requested types generic))
      (VectorNarrowSat [] (vector-resize-signature a op requested types generic))
      (VectorCompress []
        (do
          (try! (vector-check-arity op types 3))
          (let [v (al-elem [Type] types 0)]
            (try! (vector-check-type v generic))
            (try! (vector-check-same v (al-elem [Type] types 2)))
            (try! (vector-check-same (box-type a (vector-mask-type a v)) (al-elem [Type] types 1)))
            (Ok (load v)))))
      (VectorConvert [] (vector-conversion-signature a op requested types generic))
      (VectorShuffle [] (vector-permute-signature a op types generic))
      (VectorTable [] (vector-permute-signature a op types generic))
      (VectorIota []
        (do (try! (vector-check-arity op types 0))
            (try! (vector-check-type requested generic))
            (unless (vector-integer-lane? (t-inner requested) generic)
              (break :try (Err [Type Diag] (derr "iota requires integer lanes"))))
            (Ok (load requested))))
      (VectorMaskLow []
        (do (try! (vector-check-arity op types 1))
            (try! (vector-check-type requested generic))
            (unless (= (type-tag (t-inner requested)) 2)
              (break :try (Err [Type Diag] (derr "mask-low requires a boolean vector result"))))
            (try! (vector-check-same (al-elem [Type] types 0) (box-type a (TInt 64 true))))
            (Ok (load requested))))
      (VectorLoad []
        (do (try! (vector-check-arity op types 1))
            (try! (vector-check-type requested generic))
            (try! (vector-check-same (al-elem [Type] types 0)
                    (box-type a (TPtr (t-inner requested)))))
            (Ok (load requested))))
      (VectorStore []
        (do (try! (vector-check-arity op types 2))
            (let [v (al-elem [Type] types 1)]
              (try! (vector-check-type v generic))
              (try! (vector-check-same (al-elem [Type] types 0)
                      (box-type a (TPtr (t-inner v)))))
              (Ok (TInt 64 true)))))
      (VectorMaskBits []
        (do (try! (vector-check-arity op types 1))
            (let [mask (al-elem [Type] types 0)]
              (try! (vector-check-type mask generic))
              (unless (= (type-tag (t-inner mask)) 2)
                (break :try (Err [Type Diag] (derr "mask->bits requires a boolean vector"))))
              (match (vector-width-of-type mask)
                (FixedWidth [n] (when (> n 64)
                  (break :try (Err [Type Diag] (derr "mask->bits supports at most 64 lanes")))))
                (WidthParam [_] 0))
              (Ok (TInt 64 false)))))
      (VectorBitsMask []
        (do (try! (vector-check-arity op types 1))
            (try! (vector-check-type requested generic))
            (unless (= (type-tag (t-inner requested)) 2)
              (break :try (Err [Type Diag] (derr "bits->mask requires a boolean vector result"))))
            (try! (vector-check-same (al-elem [Type] types 0) (box-type a (TInt 64 false))))
            (match (vector-width-of-type requested)
              (FixedWidth [n] (when (> n 64)
                (break :try (Err [Type Diag] (derr "bits->mask supports at most 64 lanes")))))
              (WidthParam [_] 0))
            (Ok (load requested))))
      (VectorZero []
        (do (try! (vector-check-arity op types 0))
            (try! (vector-check-type requested generic)) (Ok (load requested))))
      (VectorSplat []
        (do (try! (vector-check-arity op types 1))
            (try! (vector-check-type requested generic))
            (try! (vector-check-same (t-inner requested) (al-elem [Type] types 0)))
            (Ok (load requested))))
      (VectorLanes []
        (do (try! (vector-check-arity op types 1))
            (try! (vector-check-type (al-elem [Type] types 0) generic))
            (Ok (TInt 64 true))))
      (VectorExtract []
        (do (try! (vector-check-arity op types 2))
            (let [v (al-elem [Type] types 0)]
              (try! (vector-check-type v generic))
              (unless (= (type-tag (al-elem [Type] types 1)) 0)
                (break :try (Err [Type Diag] (derr "vector lane index must be an integer"))))
              (Ok (load (t-inner v))))))
      (VectorInsert []
        (do (try! (vector-check-arity op types 3))
            (let [v (al-elem [Type] types 0)]
              (try! (vector-check-type v generic))
              (unless (= (type-tag (al-elem [Type] types 1)) 0)
                (break :try (Err [Type Diag] (derr "vector lane index must be an integer"))))
              (try! (vector-check-same (t-inner v) (al-elem [Type] types 2)))
              (Ok (load v)))))
      (VectorSelect []
        (do (try! (vector-check-arity op types 3))
            (let [v (al-elem [Type] types 1)]
              (try! (vector-check-type v generic))
              (try! (vector-check-same v (al-elem [Type] types 2)))
              (try! (vector-check-same (box-type a (vector-mask-type a v)) (al-elem [Type] types 0)))
              (Ok (load v)))))
      (VectorFma []
        (do (try! (vector-check-arity op types 3))
            (let [v (al-elem [Type] types 0)]
              (try! (vector-check-type v generic))
              (try! (vector-check-same v (al-elem [Type] types 1)))
              (try! (vector-check-same v (al-elem [Type] types 2)))
              (unless (or (= (type-tag (t-inner v)) 1)
                          (and generic (= (type-tag (t-inner v)) 6)))
                (break :try (Err [Type Diag] (derr "vector fma requires floating-point lanes"))))
              (Ok (load v)))))
      (_
        (do
          (try! (vector-check-arity op types (if (vector-unary? op) 1 2)))
          (let [v (al-elem [Type] types 0)]
            (try! (vector-check-type v generic))
            (unless (vector-unary? op)
              (try! (vector-check-same v (al-elem [Type] types 1))))
            (let [lane (t-inner v)]
              (unless (cond (vector-requires-float? op)
                          (or (= (type-tag lane) 1) (and generic (= (type-tag lane) 6)))
                        (vector-requires-integer? op)
                          (or (vector-integer-lane? lane generic)
                              (and (= (type-tag lane) 2) (vector-boolean-op? op)))
                        :else
                          (or (vector-numeric-lane? lane generic)
                              (and (= (type-tag lane) 2) (vector-boolean-op? op))))
                (break :try (Err [Type Diag] (derr "vector operation is not defined for this lane type"))))
              (Ok (cond (vector-comparison? op) (vector-mask-type a v)
                        (vector-reduction? op) (load lane)
                        :else (load v))))))))))

(defn vector-ir-type [(a (dyn Allocator)) (t (ptr Type))] (-> (slice u8))
  (match (load t)
    (TInt [bits _] (sconcat a "i" (i64->str a bits)))
    (TFloat [bits] (if (= bits 32) "float" "double"))
    (TBool [] "i1")
    (TPtr [_] "ptr") (TRef [_ _] "ptr")
    (TVec [elem width]
      (sconcat3 a (sconcat3 a "<" (i64->str a (vector-width-value width)) " x ")
                  (vector-ir-type a elem) ">"))
    (_ (do (unimplemented "nonconcrete SIMD operand type") ""))))

(defn vector-binary-instruction [(op VectorOp) (floating bool)] (-> (slice u8))
  (match op
    (VectorAdd [] (if floating "fadd" "add"))
    (VectorSub [] (if floating "fsub" "sub"))
    (VectorMul [] (if floating "fmul" "mul"))
    (VectorDiv [] "fdiv")
    (VectorAnd [] "and") (VectorOr [] "or") (VectorXor [] "xor")
    (_ "")))

(defn vector-comparison-predicate [(op VectorOp) (floating bool) (signed bool)]
                                  (-> (slice u8))
  (match op
      (VectorEq [] (if floating "oeq" "eq"))
      (VectorNe [] (if floating "une" "ne"))
      (VectorLt [] (if floating "olt" (if signed "slt" "ult")))
      (VectorLe [] (if floating "ole" (if signed "sle" "ule")))
      (VectorGt [] (if floating "ogt" (if signed "sgt" "ugt")))
      (VectorGe [] (if floating "oge" (if signed "sge" "uge")))
      (_ "")))

(defn vector-intrinsic-suffix [(a (dyn Allocator)) (t (ptr Type))] (-> (slice u8))
  (match (load t)
    (TVec [elem width]
      (sconcat3 a "v" (i64->str a (vector-width-value width)) (vector-intrinsic-suffix a elem)))
    (TInt [bits _] (sconcat a "i" (i64->str a bits)))
    (TFloat [bits] (sconcat a "f" (i64->str a bits)))
    (TBool [] "i1")
    (_ (do (unimplemented "vector intrinsic type") ""))))

(defn vector-constant-ir [(a (dyn Allocator)) (t (ptr Type)) (constant (slice u8))]
                         (-> (slice u8))
  (let [(mut out) (sb-new a) lane (vector-ir-type a (t-inner t))]
    (sb-push-str! (mut out) "<")
    (for [i 0 (t-arrn t)]
      (when (> i 0) (sb-push-str! (mut out) ", "))
      (sb-push-str! (mut out) (sconcat3 a lane " " constant)))
    (sb-push-str! (mut out) ">")
    (sb-str (load out))))

(defn vector-intrinsic-ir [(a (dyn Allocator)) (name (slice u8)) (result (ptr Type))
                          (types (ptr (ArrayList Type))) (defined-zero bool)] (-> (slice u8))
  (let [(mut declaration) (sb-new a) (mut operands) (sb-new a)]
    (for [i 0 (len (load types))]
      (when (> i 0)
        (sb-push-str! (mut declaration) ", ")
        (sb-push-str! (mut operands) ", "))
      (let [ty (vector-ir-type a (al-elem [Type] types i))]
        (sb-push-str! (mut declaration) ty)
        (sb-push-str! (mut operands) (sconcat3 a ty " $" (i64->str a i)))))
    (when defined-zero
      (sb-push-str! (mut declaration) ", i1")
      (sb-push-str! (mut operands) ", i1 false"))
    (sconcat3 a
      (sconcat3 a "declare " (vector-ir-type a result) (sconcat3 a " @" name "("))
      (sconcat3 a (sb-str (load declaration)) ")\n%r = call $ret @" name)
      (sconcat3 a "(" (sb-str (load operands)) ")\nret $ret %r"))))

(defn vector-intrinsic-base [(op VectorOp) (floating bool) (signed bool)] (-> (slice u8))
  (match op
    (VectorPopcount [] "llvm.ctpop.") (VectorClz [] "llvm.ctlz.") (VectorCtz [] "llvm.cttz.")
    (VectorBswap [] "llvm.bswap.") (VectorBitReverse [] "llvm.bitreverse.")
    (VectorAddSat [] (if signed "llvm.sadd.sat." "llvm.uadd.sat."))
    (VectorSubSat [] (if signed "llvm.ssub.sat." "llvm.usub.sat."))
    (VectorMin [] (if floating "llvm.minimum." (if signed "llvm.smin." "llvm.umin.")))
    (VectorMax [] (if floating "llvm.maximum." (if signed "llvm.smax." "llvm.umax.")))
    (VectorAbs [] (if floating "llvm.fabs." "llvm.abs."))
    (VectorFma [] "llvm.fma.") (VectorSqrt [] "llvm.sqrt.")
    (VectorFloor [] "llvm.floor.") (VectorCeil [] "llvm.ceil.")
    (VectorTrunc [] "llvm.trunc.") (VectorRound [] "llvm.roundeven.")
    (VectorReduceAdd [] "llvm.vector.reduce.add.")
    (VectorReduceOr [] "llvm.vector.reduce.or.") (VectorReduceAnd [] "llvm.vector.reduce.and.")
    (VectorReduceXor [] "llvm.vector.reduce.xor.")
    (VectorReduceMin [] (if floating "llvm.vector.reduce.fminimum." (if signed "llvm.vector.reduce.smin." "llvm.vector.reduce.umin.")))
    (VectorReduceMax [] (if floating "llvm.vector.reduce.fmaximum." (if signed "llvm.vector.reduce.smax." "llvm.vector.reduce.umax.")))
    (_ "")))

(defn vector-arithmetic-ir [(a (dyn Allocator)) (op VectorOp) (result (ptr Type))
                           (types (ptr (ArrayList Type)))] (-> (Result (slice u8) Diag))
  (let [v (al-elem [Type] types 0) lane (t-inner v)
        floating (= (type-tag lane) 1)
        signed (t-int-signed lane)
        instruction (vector-binary-instruction op floating)
        intrinsic (vector-intrinsic-base op floating signed)
        suffix (vector-intrinsic-suffix a v)]
    (cond
      (match op (VectorIsNan [] true) (_ false))
        (Ok "%r = fcmp uno $t0 $0, $0\nret $ret %r")
      (match op (VectorIsFinite [] true) (_ false))
        (let [abs-name (sconcat a "llvm.fabs." suffix)
              ty (vector-ir-type a v)
              infinity (vector-constant-ir a v "0x7FF0000000000000")]
          (Ok (sconcat3 a (sconcat3 a "declare " ty (sconcat3 a " @" abs-name "("))
                 (sconcat3 a ty ")\n%abs = call $t0 @" (sconcat3 a abs-name "($t0 $0)\n%r = fcmp olt $t0 %abs, " infinity))
                 "\nret $ret %r")))
      (vector-comparison? op)
        (Ok (sconcat3 a (if floating "%r = fcmp " "%r = icmp ")
              (vector-comparison-predicate op floating signed) " $t0 $0, $1\nret $ret %r"))
      (> (len instruction) 0) (Ok (sconcat3 a "%r = " instruction " $ret $0, $1\nret $ret %r"))
      (match op (VectorNot [] true) (_ false))
        (Ok (sconcat3 a "%r = xor $ret $0, " (vector-constant-ir a v "-1") "\nret $ret %r"))
      (match op (VectorNeg [] true) (_ false))
        (Ok (if floating "%r = fneg $ret $0\nret $ret %r"
                         "%r = sub $ret zeroinitializer, $0\nret $ret %r"))
      (and (match op (VectorAbs [] true) (_ false)) (and (not floating) (not signed)))
        (Ok "ret $ret $0")
      (match op (VectorShl [] true) (VectorShr [] true) (VectorAShr [] true) (_ false))
        (let [count-mask (vector-constant-ir a v (i64->str a (- (t-int-bits lane) 1)))
              opcode (match op (VectorShl [] "shl") (VectorShr [] "lshr") (_ "ashr"))]
          (Ok (sconcat3 a (sconcat3 a "%counts = and $t1 $1, " count-mask "\n%r = ")
                   opcode " $ret $0, %counts\nret $ret %r")))
      (match op (VectorRotl [] true) (VectorRotr [] true) (_ false))
        (let [name (sconcat a (match op (VectorRotl [] "llvm.fshl.") (_ "llvm.fshr.")) suffix)
              ty (vector-ir-type a v)]
          (Ok (sconcat3 a (sconcat3 a "declare " ty (sconcat3 a " @" name "("))
                 (sconcat3 a ty ", " (sconcat3 a ty ", " (sconcat a ty ")\n%r = call $ret @")))
                 (sconcat a name "($t0 $0, $t0 $0, $t1 $1)\nret $ret %r"))))
      (and (match op (VectorBswap [] true) (_ false)) (= (t-int-bits lane) 8))
        (Ok "ret $ret $0")
      (and (match op (VectorReduceAdd [] true) (_ false)) floating)
        (let [name (sconcat a "llvm.vector.reduce.fadd." suffix)
              scalar (vector-ir-type a result) vector (vector-ir-type a v)]
          (Ok (sconcat3 a (sconcat3 a "declare " scalar (sconcat3 a " @" name "("))
                 (sconcat3 a scalar ", " (sconcat a vector ")\n%r = call $ret @"))
                 (sconcat3 a name "($ret -0.0, $t0 $0)\n" "ret $ret %r"))))
      (> (len intrinsic) 0)
        (Ok (vector-intrinsic-ir a (sconcat a intrinsic suffix) result types
              (match op (VectorClz [] true) (VectorCtz [] true) (VectorAbs [] (not floating)) (_ false))))
      :else (Err [(slice u8) Diag] (derr (sconcat a "vector lowering is not implemented: " (vector-op-name op)))))))

(defn vector-resize-ir [(a (dyn Allocator)) (op VectorOp)
                        (result (ptr Type)) (types (ptr (ArrayList Type)))] (-> (slice u8))
  (let [source (al-elem [Type] types 0) src (t-inner source) dst (t-inner result)
        widen (vector-widening? op) floating (= (type-tag src) 1)
        signed (match (load src) (TInt [_ s] s) (_ false))
        dsigned (match (load dst) (TInt [_ s] s) (_ false))
        count (t-arrn result) db (vector-lane-bits dst)
        wide (box-type a (fixed-vec src count)) wt (vector-ir-type a wide)
        (mut out) (sb-new a)]
    (sb-push-str! (mut out) "%parts = shufflevector $t0 $0, $t0 ")
    (sb-push-str! (mut out) (if widen "zeroinitializer" "$1"))
    (sb-push-str! (mut out) (sconcat3 a ", <" (i64->str a count) " x i32> <"))
    (for [i 0 count]
      (when (> i 0) (sb-push-str! (mut out) ", "))
      (sb-push-str! (mut out) (sconcat a "i32 " (i64->str a
        (+ i (match op (VectorWidenHigh [] count) (_ 0)))))))
    (sb-push-str! (mut out) ">\n")
    (when (match op (VectorNarrowSat [] true) (_ false))
      (let [upper (- (primitive/ishl (cast i64 1) (if dsigned (- db 1) db)) 1)
            lower (if (and signed dsigned) (- 0 (primitive/ishl (cast i64 1) (- db 1))) 0)
            lo (vector-constant-ir a wide (i64->str a lower))
            hi (vector-constant-ir a wide (i64->str a upper))
            mt (sconcat3 a "<" (i64->str a count) " x i1>")]
        (sb-push-str! (mut out) (sconcat3 a "%low = icmp " (if signed "slt " "ult ") wt))
        (sb-push-str! (mut out) (sconcat3 a " %parts, " lo "\n%lo = select "))
        (sb-push-str! (mut out) (sconcat3 a mt " %low, " wt))
        (sb-push-str! (mut out) (sconcat3 a " " lo ", "))
        (sb-push-str! (mut out) (sconcat a wt " %parts\n"))
        (sb-push-str! (mut out) (sconcat3 a "%high = icmp " (if signed "sgt " "ugt ") wt))
        (sb-push-str! (mut out) (sconcat3 a " %lo, " hi "\n%clamped = select "))
        (sb-push-str! (mut out) (sconcat3 a mt " %high, " wt))
        (sb-push-str! (mut out) (sconcat3 a " " hi ", "))
        (sb-push-str! (mut out) (sconcat a wt " %lo\n"))))
    (sb-push-str! (mut out) (sconcat3 a "%r = "
      (if widen (if floating "fpext" (if signed "sext" "zext")) (if floating "fptrunc" "trunc")) " "))
    (sb-push-str! (mut out) (sconcat a wt (match op (VectorNarrowSat [] " %clamped") (_ " %parts"))))
    (sb-push-str! (mut out) " to $ret\nret $ret %r")
    (sb-str (load out))))

(defn vector-lane-access-ir [(a (dyn Allocator)) (op VectorOp)
                             (types (ptr (ArrayList Type)))] (-> (slice u8))
  (let [index (al-elem [Type] types 1)
        bits (vector-lane-bits index)
        signed (match (load index) (TInt [_ s] s) (_ false))
        prefix (if (= bits 64) "%index = or i64 $1, 0\n"
                   (if signed "%index = sext $t1 $1 to i64\n"
                              "%index = zext $t1 $1 to i64\n"))]
    (sconcat3 a prefix
      (sconcat3 a "%valid = icmp ult i64 %index, " (i64->str a (t-arrn (al-elem [Type] types 0)))
                  "\n%safe = select i1 %valid, i64 %index, i64 0\n")
      (match op
        (VectorExtract [] "%x = extractelement $t0 $0, i64 %safe\n%r = select i1 %valid, $ret %x, $ret zeroinitializer\nret $ret %r")
        (_ "%x = insertelement $t0 $0, $t2 $2, i64 %safe\n%r = select i1 %valid, $ret %x, $ret $0\nret $ret %r")))))

(defn vector-conversion-ir [(a (dyn Allocator)) (op VectorOp)
                            (result (ptr Type)) (source (ptr Type))] (-> (slice u8))
  (let [src (t-inner source) dst (t-inner result)
        sf (= (type-tag src) 1) df (= (type-tag dst) 1)
        ss (match (load src) (TInt [_ signed] signed) (_ false))
        ds (match (load dst) (TInt [_ signed] signed) (_ false))
        sb (vector-lane-bits src) db (vector-lane-bits dst)]
    (cond
      (match op (VectorBitcast [] true) (_ false))
        "%r = bitcast $t0 $0 to $ret\nret $ret %r"
      (and sf (not df))
        (let [name (sconcat3 a (if ds "llvm.fptosi.sat." "llvm.fptoui.sat.")
                        (vector-intrinsic-suffix a result) (sconcat a "." (vector-intrinsic-suffix a source)))
              (mut types) (al-new [Type] a)]
          (push! (mut types) (load source))
          (vector-intrinsic-ir a name result (box-al [Type] a (load types)) false))
      (and (not sf) df)
        (sconcat3 a "%r = " (if ss "sitofp" "uitofp") " $t0 $0 to $ret\nret $ret %r")
      (= sb db) "ret $ret $0"
      :else
        (sconcat3 a "%r = "
          (if sf (if (< sb db) "fpext" "fptrunc")
                 (if (< sb db) (if ss "sext" "zext") "trunc"))
          " $t0 $0 to $ret\nret $ret %r"))))

(defn vector-permute-ir [(a (dyn Allocator)) (op VectorOp)
                         (result (ptr Type)) (types (ptr (ArrayList Type)))] (-> (slice u8))
  (let [table (match op (VectorTable [] true) (_ false))
        v (al-elem [Type] types 0) width (t-arrn v)
        operand (if table "1" "2")
        indices (al-elem [Type] types (if table 1 2))
        it (vector-ir-type a (t-inner indices))
        et (vector-ir-type a (t-inner v))
        ib (vector-lane-bits (t-inner indices))
        (mut out) (sb-new a)]
    (for [i 0 (t-arrn result)]
      (let [n (i64->str a i) next (i64->str a (+ i 1))]
        (sb-push-str! (mut out) (sconcat3 a "%raw" n " = extractelement $t"))
        (sb-push-str! (mut out) (sconcat3 a operand " $" operand))
        (sb-push-str! (mut out) (sconcat3 a ", i32 " n "\n"))
        (sb-push-str! (mut out) (sconcat3 a "%index" n " = "))
        (if (= ib 64)
          (sb-push-str! (mut out) (sconcat3 a "or i64 %raw" n ", 0\n"))
          (do
            (sb-push-str! (mut out) (sconcat3 a
              (match (load (t-inner indices)) (TInt [_ signed] (if signed "sext " "zext ")) (_ "zext "))
              it " %raw"))
            (sb-push-str! (mut out) (sconcat a n " to i64\n"))))
        (sb-push-str! (mut out) (sconcat3 a "%valid" n " = icmp ult i64 %index"))
        (sb-push-str! (mut out) (sconcat3 a n ", " (i64->str a (if table width (* width 2)))))
        (sb-push-str! (mut out) (sconcat3 a "\n%low" n " = icmp ult i64 %index"))
        (sb-push-str! (mut out) (sconcat3 a n ", " (i64->str a width)))
        (sb-push-str! (mut out) (sconcat3 a "\n%safe" n " = select i1 %low"))
        (sb-push-str! (mut out) (sconcat3 a n ", i64 %index" n))
        (sb-push-str! (mut out) ", i64 0\n")
        (sb-push-str! (mut out) (sconcat3 a "%left" n " = extractelement $t0 $0, i64 %safe"))
        (sb-push-str! (mut out) (sconcat a n "\n"))
        (unless table
          (sb-push-str! (mut out) (sconcat3 a "%upper" n " = sub i64 %index"))
          (sb-push-str! (mut out) (sconcat3 a n ", " (i64->str a width)))
          (sb-push-str! (mut out) (sconcat3 a "\n%uppervalid" n " = icmp ult i64 %upper"))
          (sb-push-str! (mut out) (sconcat3 a n ", " (i64->str a width)))
          (sb-push-str! (mut out) (sconcat3 a "\n%uppersafe" n " = select i1 %uppervalid"))
          (sb-push-str! (mut out) (sconcat3 a n ", i64 %upper" n))
          (sb-push-str! (mut out) ", i64 0\n")
          (sb-push-str! (mut out) (sconcat3 a "%right" n " = extractelement $t1 $1, i64 %uppersafe"))
          (sb-push-str! (mut out) (sconcat a n "\n")))
        (sb-push-str! (mut out) (sconcat3 a "%chosen" n " = select i1 %low"))
        (sb-push-str! (mut out) (sconcat3 a n ", " et))
        (sb-push-str! (mut out) (sconcat3 a " %left" n ", "))
        (sb-push-str! (mut out) (sconcat a et (if table " zeroinitializer\n" (sconcat3 a " %right" n "\n"))))
        (sb-push-str! (mut out) (sconcat3 a "%value" n " = select i1 %valid"))
        (sb-push-str! (mut out) (sconcat3 a n ", " et))
        (sb-push-str! (mut out) (sconcat3 a " %chosen" n ", "))
        (sb-push-str! (mut out) (sconcat a et " zeroinitializer\n"))
        (sb-push-str! (mut out) (sconcat3 a "%v" next " = insertelement $ret "))
        (sb-push-str! (mut out) (if (= i 0) "zeroinitializer" (sconcat a "%v" n)))
        (sb-push-str! (mut out) (sconcat3 a ", " et " %value"))
        (sb-push-str! (mut out) (sconcat3 a n ", i32 " n))
        (sb-push-str! (mut out) "\n")))
    (sb-push-str! (mut out) (sconcat a "ret $ret %v" (i64->str a (t-arrn result))))
    (sb-str (load out))))

(defn vector-iota-ir [(a (dyn Allocator)) (lanes i64) (lane (slice u8))] (-> (slice u8))
  (let [(mut out) (sb-new a)]
    (sb-push-str! (mut out) "<")
    (for [i 0 lanes]
      (when (> i 0) (sb-push-str! (mut out) ", "))
      (sb-push-str! (mut out) (sconcat3 a lane " " (i64->str a i))))
    (sb-push-str! (mut out) ">")
    (sb-str (load out))))

(defn vector-packed-memory-ir [(a (dyn Allocator)) (op VectorOp)
                                (types (ptr (ArrayList Type)))] (-> (slice u8))
  (let [v (al-elem [Type] types 2)
        vt (vector-ir-type a v)
        mt (vector-ir-type a (box-type a (vector-mask-type a v)))
        writing (match op (VectorCompressStore [] true) (_ false))
        name (sconcat a (if writing "llvm.masked.compressstore." "llvm.masked.expandload.")
                         (vector-intrinsic-suffix a v))
        (mut out) (sb-new a)]
    (if writing
      (do
        (sb-push-str! (mut out) (sconcat3 a "declare void @" name "("))
        (sb-push-str! (mut out) (sconcat3 a vt ", ptr, " mt))
        (sb-push-str! (mut out) (sconcat3 a ")\ncall void @" name "($t2 $2, ptr $0, $t1 $1)\nret i64 0")))
      (do
        (sb-push-str! (mut out) (sconcat3 a "declare " vt " @"))
        (sb-push-str! (mut out) (sconcat3 a name "(ptr, " mt))
        (sb-push-str! (mut out) (sconcat3 a ", " vt ")\n%r = call $ret @"))
        (sb-push-str! (mut out) (sconcat a name "(ptr $0, $t1 $1, $t2 $2)\nret $ret %r"))))
    (sb-str (load out))))

(defn vector-memory-ir [(a (dyn Allocator)) (op VectorOp)
                         (result (ptr Type)) (types (ptr (ArrayList Type)))]
                         (-> (slice u8))
  (let [writing (vector-memory-store? op)
        indexed (vector-memory-indexed? op)
        masked (vector-memory-masked? op)
        vi (- (len (load types)) 1)
        v (if (or writing masked) (al-elem [Type] types vi) result)
        vt (vector-ir-type a v)
        mt (vector-ir-type a (box-type a (vector-mask-type a v)))
        suffix (vector-intrinsic-suffix a v)
        (mut out) (sb-new a)]
    (if (not masked)
      (let [aligned (match op (VectorLoadAligned [] true) (VectorStoreAligned [] true) (_ false))
            (mut alignment) 1
            bytes (* (t-arrn v) (/ (match (load (t-inner v)) (TInt [bits _] bits) (TFloat [bits] bits) (_ 8)) 8))]
        (when aligned
          (loop (if (>= (load alignment) bytes) (break) (set! alignment (* (load alignment) 2)))))
        (if writing
          (sconcat3 a "store $t1 $1, ptr $0, align " (i64->str a (load alignment)) "\nret i64 0")
          (sconcat3 a "%r = load $ret, ptr $0, align " (i64->str a (load alignment)) "\nret $ret %r")))
      (if (match op (VectorCompressStore [] true) (VectorExpandLoad [] true) (_ false))
        (vector-packed-memory-ir a op types)
      (if indexed
        (let [indices (al-elem [Type] types 1)
              lane (t-inner indices)
              (mut signed) false
              bits (match (load lane) (TInt [bits s] (do (set! signed s) bits)) (_ 64))
              it (vector-ir-type a (box-type a (fixed-vec (box-type a (TInt 64 true)) (t-arrn v))))
              pt (sconcat3 a "<" (i64->str a (t-arrn v)) " x ptr>")
              et (vector-ir-type a (t-inner v))]
          (if (= bits 64)
            (sb-push-str! (mut out) "%indices = or $t1 $1, zeroinitializer\n")
            (sb-push-str! (mut out) (sconcat3 a (if (load signed) "%indices = sext $t1 $1 to " "%indices = zext $t1 $1 to ") it "\n")))
          ; Inactive offsets may be arbitrary, so this is deliberately not inbounds.
          (sb-push-str! (mut out) (sconcat3 a "%addresses = getelementptr " et (sconcat3 a ", ptr $0, " it " %indices\n")))
          (if writing
            (do
              ; Duplicate indices have lane-order semantics, unlike LLVM scatter.
              (for [i 0 (t-arrn v)]
                (let [n (i64->str a i) next (i64->str a (+ i 1))]
                  (sb-push-str! (mut out) (sconcat3 a "%active" n (sconcat3 a " = extractelement $t2 $2, i32 " n "\n")))
                  (sb-push-str! (mut out) (sconcat3 a "br i1 %active" n (sconcat3 a ", label %write" n (sconcat3 a ", label %next" next "\n"))))
                  (sb-push-str! (mut out) (sconcat3 a "write" n ":\n"))
                  (sb-push-str! (mut out) (sconcat3 a "%address" n (sconcat3 a " = extractelement " pt (sconcat3 a " %addresses, i32 " n "\n"))))
                  (sb-push-str! (mut out) (sconcat3 a "%value" n (sconcat3 a " = extractelement $t3 $3, i32 " n "\n")))
                  (sb-push-str! (mut out) (sconcat3 a "store " et (sconcat3 a " %value" n (sconcat3 a ", ptr %address" n ", align 1\n"))))
                  (sb-push-str! (mut out) (sconcat3 a "br label %next" next (sconcat3 a "\nnext" next ":\n")))))
              (sb-push-str! (mut out) "ret i64 0"))
            (let [name (sconcat3 a "llvm.masked.gather." suffix (sconcat3 a ".v" (i64->str a (t-arrn v)) "p0"))]
              (sb-push-str! (mut out) (sconcat3 a "declare " vt (sconcat3 a " @" name (sconcat3 a "(" pt (sconcat3 a ", i32, " mt (sconcat3 a ", " vt ")\n"))))))
              (sb-push-str! (mut out) (sconcat3 a "%r = call $ret @" name (sconcat3 a "(" pt " %addresses, i32 1, $t2 $2, $t3 $3)\nret $ret %r")))))
          (sb-str (load out)))
        (let [name (sconcat3 a (if writing "llvm.masked.store." "llvm.masked.load.") suffix ".p0")]
          (if writing
            (do
              (sb-push-str! (mut out) (sconcat3 a "declare void @" name (sconcat3 a "(" vt (sconcat3 a ", ptr, i32, " mt ")\n"))))
              (sb-push-str! (mut out) (sconcat3 a "call void @" name "($t2 $2, ptr $0, i32 1, $t1 $1)\nret i64 0")))
            (do
              (sb-push-str! (mut out) (sconcat3 a "declare " vt (sconcat3 a " @" name (sconcat3 a "(ptr, i32, " mt (sconcat3 a ", " vt ")\n")))))
              (sb-push-str! (mut out) (sconcat3 a "%r = call $ret @" name "(ptr $0, i32 1, $t1 $1, $t2 $2)\nret $ret %r"))))
          (sb-str (load out))))))))

; Explicit lane extraction fixes lane zero to bit zero on every endianness.
(defn vector-ballot-ir [(a (dyn Allocator)) (lanes i64)] (-> (slice u8))
  (let [(mut out) (sb-new a)]
    (sb-push-str! (mut out) "%bits0 = or i64 0, 0\n")
    (for [i 0 lanes]
      (let [n (i64->str a i) next (i64->str a (+ i 1))]
        (sb-push-str! (mut out) (sconcat3 a "%lane" n " = extractelement $t0 $0, i32 "))
        (sb-push-str! (mut out) (sconcat a n "\n"))
        (sb-push-str! (mut out) (sconcat3 a "%wide" n " = zext i1 %lane"))
        (sb-push-str! (mut out) (sconcat a n " to i64\n"))
        (sb-push-str! (mut out) (sconcat3 a "%shift" n " = shl i64 %wide"))
        (sb-push-str! (mut out) (sconcat3 a n ", " (sconcat a n "\n")))
        (sb-push-str! (mut out) (sconcat3 a "%bits" next " = or i64 %bits"))
        (sb-push-str! (mut out) (sconcat3 a n ", %shift" (sconcat a n "\n")))))
    (sb-push-str! (mut out) (sconcat a "ret i64 %bits" (i64->str a lanes)))
    (sb-str (load out))))

(defn vector-from-bits-ir [(a (dyn Allocator)) (lanes i64)] (-> (slice u8))
  (let [(mut out) (sb-new a)]
    (for [i 0 lanes]
      (let [n (i64->str a i) next (i64->str a (+ i 1))]
        (sb-push-str! (mut out) (sconcat3 a "%shift" n " = lshr i64 $0, "))
        (sb-push-str! (mut out) (sconcat a n "\n"))
        (sb-push-str! (mut out) (sconcat3 a "%bit" n " = trunc i64 %shift"))
        (sb-push-str! (mut out) (sconcat a n " to i1\n"))
        (sb-push-str! (mut out) (sconcat3 a "%mask" next " = insertelement $ret "))
        (sb-push-str! (mut out) (if (= i 0) "zeroinitializer" (sconcat a "%mask" n)))
        (sb-push-str! (mut out) (sconcat3 a ", i1 %bit" n ", i32 "))
        (sb-push-str! (mut out) (sconcat a n "\n"))))
    (sb-push-str! (mut out) (sconcat a "ret $ret %mask" (i64->str a lanes)))
    (sb-str (load out))))

;;; Lower concrete, checked vectors into ordinary always-inlined LLVM helpers.
;;; No generic types, target-specific opcode strings, or width-specific wrappers
;;; escape into the public library API.
(defn vector-neon-table-ir [(a (dyn Allocator)) (result (ptr Type))
                            (types (ptr (ArrayList Type)))] (-> (slice u8))
  (let [table (al-elem [Type] types 0) indices (al-elem [Type] types 1)
        n (t-arrn table) m (t-arrn result) parts (/ (+ n 15) 16)
        chunks (/ (+ m 15) 16) bits (vector-lane-bits (t-inner indices))
        byte-type (vector-ir-type a result)
        intrinsic (sconcat3 a "llvm.aarch64.neon.tbl" (i64->str a parts) ".v16i8")
        (mut out) (sb-new a)]
    (sb-push-str! (mut out) (sconcat3 a "declare <16 x i8> @" intrinsic "("))
    (for [i 0 parts] (sb-push-str! (mut out) "<16 x i8>, "))
    (sb-push-str! (mut out) "<16 x i8>)\n")
    (for [part 0 parts]
      (sb-push-str! (mut out) (sconcat3 a "%table" (i64->str a part)
        " = shufflevector $t0 $0, $t0 zeroinitializer, <16 x i32> <"))
      (for [j 0 16]
        (when (> j 0) (sb-push-str! (mut out) ", "))
        (let [index (+ (* part 16) j)]
          (sb-push-str! (mut out) (sconcat a "i32 " (i64->str a (if (< index n) index n))))))
      (sb-push-str! (mut out) ">\n"))
    ; Validate in the original index width, before narrowing to byte indices.
    (sb-push-str! (mut out) (sconcat3 a "%valid = icmp ult $t1 $1, "
      (vector-constant-ir a indices (i64->str a n)) "\n"))
    (if (= bits 8)
      (sb-push-str! (mut out) "%bytes = or $t1 $1, zeroinitializer\n")
      (sb-push-str! (mut out) (sconcat3 a "%bytes = trunc $t1 $1 to " byte-type "\n")))
    (sb-push-str! (mut out) (sconcat3 a "%safe = select <" (i64->str a m) " x i1> %valid, "))
    (sb-push-str! (mut out) (sconcat3 a byte-type " %bytes, " byte-type))
    (sb-push-str! (mut out) (sconcat3 a " " (vector-constant-ir a result "255") "\n"))
    (for [chunk 0 chunks]
      (let [c (i64->str a chunk)]
        (sb-push-str! (mut out) (sconcat3 a "%indices" c " = shufflevector "))
        (sb-push-str! (mut out) (sconcat3 a byte-type " %safe, " byte-type))
        (sb-push-str! (mut out) " zeroinitializer, <16 x i32> <")
        (for [j 0 16]
          (when (> j 0) (sb-push-str! (mut out) ", "))
          (let [index (+ (* chunk 16) j)]
            (sb-push-str! (mut out) (sconcat a "i32 " (i64->str a (if (< index m) index m))))))
        (sb-push-str! (mut out) (sconcat3 a ">\n%chunk" c " = call <16 x i8> @"))
        (sb-push-str! (mut out) (sconcat a intrinsic "("))
        (for [part 0 parts]
          (sb-push-str! (mut out) (sconcat3 a "<16 x i8> %table" (i64->str a part) ", ")))
        (sb-push-str! (mut out) (sconcat3 a "<16 x i8> %indices" c ")\n"))))
    (for [i 0 m]
      (let [s (i64->str a i) next (i64->str a (+ i 1))]
        (sb-push-str! (mut out) (sconcat3 a "%lane" s " = extractelement <16 x i8> %chunk"))
        (sb-push-str! (mut out) (sconcat3 a (i64->str a (/ i 16)) ", i32 " (i64->str a (% i 16))))
        (sb-push-str! (mut out) (sconcat3 a "\n%result" next " = insertelement $ret "))
        (sb-push-str! (mut out) (if (= i 0) "zeroinitializer" (sconcat a "%result" s)))
        (sb-push-str! (mut out) (sconcat3 a ", i8 %lane" s ", i32 "))
        (sb-push-str! (mut out) (sconcat a s "\n"))))
    (sb-push-str! (mut out) (sconcat a "ret $ret %result" (i64->str a m)))
    (sb-str (load out))))

(defn vector-ballot-reduce-ir [(a (dyn Allocator)) (lanes i64)] (-> (slice u8))
  (let [vt (sconcat3 a "<" (i64->str a lanes) " x i8>")
        groups (/ (+ lanes 7) 8) (mut out) (sb-new a)]
    (sb-push-str! (mut out) "declare i8 @llvm.vector.reduce.add.v8i8(<8 x i8>)\n")
    (sb-push-str! (mut out) (sconcat3 a "%weighted = select $t0 $0, " vt " <"))
    (for [i 0 lanes]
      (when (> i 0) (sb-push-str! (mut out) ", "))
      (sb-push-str! (mut out) (sconcat a "i8 " (i64->str a (primitive/ishl (cast i64 1) (% i 8))))))
    (sb-push-str! (mut out) (sconcat3 a ">, " vt " zeroinitializer\n%bits0 = or i64 0, 0\n"))
    (for [group 0 groups]
      (let [g (i64->str a group) next (i64->str a (+ group 1))]
        (sb-push-str! (mut out) (sconcat3 a "%group" g " = shufflevector "))
        (sb-push-str! (mut out) (sconcat3 a vt " %weighted, " vt))
        (sb-push-str! (mut out) " zeroinitializer, <8 x i32> <")
        (for [j 0 8]
          (when (> j 0) (sb-push-str! (mut out) ", "))
          (let [i (+ (* group 8) j)]
            (sb-push-str! (mut out) (sconcat a "i32 " (i64->str a (if (< i lanes) i lanes))))))
        (sb-push-str! (mut out) (sconcat3 a ">\n%byte" g " = call i8 @llvm.vector.reduce.add.v8i8(<8 x i8> %group"))
        (sb-push-str! (mut out) (sconcat3 a g ")\n%wide" g))
        (sb-push-str! (mut out) (sconcat3 a " = zext i8 %byte" g " to i64\n%shift"))
        (sb-push-str! (mut out) (sconcat3 a g " = shl i64 %wide" g))
        (sb-push-str! (mut out) (sconcat3 a ", " (i64->str a (* group 8)) "\n%bits"))
        (sb-push-str! (mut out) (sconcat3 a next " = or i64 %bits" g))
        (sb-push-str! (mut out) (sconcat3 a ", %shift" g "\n"))))
    (sb-push-str! (mut out) (sconcat a "ret i64 %bits" (i64->str a groups)))
    (sb-str (load out))))

(defn lower-vector-for-target [(a (dyn Allocator)) (arch i64) (op VectorOp)
                                (result (ptr Type)) (types (ptr (ArrayList Type)))
                                (args (ptr (ArrayList Expr)))] (-> (Result ExprKind Diag))
  (try
    (try! (vector-signature a op result types args false))
    (when (match op (VectorMaskBits [] true) (_ false))
      (let [n (t-arrn (al-elem [Type] types 0))]
        (break :try (Ok (ELlvmIr (load result) args
          (if (= arch 0)
            (sconcat3 a "%packed = bitcast $t0 $0 to i" (i64->str a n)
              (if (= n 64) "\nret i64 %packed"
                (sconcat3 a "\n%wide = zext i" (i64->str a n) " %packed to i64\nret i64 %wide")))
            (vector-ballot-reduce-ir a n)))))))
    (if (and (= arch 1) (match op (VectorTable [] true) (_ false)))
      (if (<= (t-arrn (al-elem [Type] types 0)) 64)
        (Ok (ELlvmIr (load result) args (vector-neon-table-ir a result types)))
        (lower-vector a op result types args))
      (lower-vector a op result types args))))

(defn vector-scan? [(op VectorOp)] (-> bool)
  (match op (VectorScanAdd [] true) (VectorScanXor [] true)
    (VectorScanOr [] true) (VectorScanMax [] true) (_ false)))

(defn vector-scan-operation [(op VectorOp)] (-> VectorOp)
  (match op (VectorScanAdd [] (VectorAdd)) (VectorScanXor [] (VectorXor))
    (VectorScanOr [] (VectorOr)) (_ (VectorMax))))

; Emit the fixed doubling tree here, before target legalization can turn a
; dynamic shuffle into a large scalar loop that LLVM declines to unroll.
(defn vector-scan-ir [(a (dyn Allocator)) (op VectorOp) (result (ptr Type))] (-> (slice u8))
  (let [n (t-arrn result) lane (t-inner result) ty (vector-ir-type a result)
        maximum (match op (VectorScanMax [] true) (_ false))
        instruction (vector-binary-instruction (vector-scan-operation op) (= (type-tag lane) 1))
        intrinsic (sconcat a (vector-intrinsic-base (VectorMax) (= (type-tag lane) 1) (t-int-signed lane))
                             (vector-intrinsic-suffix a result))
        (mut out) (sb-new a) (mut previous) "$0" (mut distance) 1]
    (when maximum
      (sb-push-str! (mut out) (sconcat3 a "declare " ty (sconcat3 a " @" intrinsic "(")))
      (sb-push-str! (mut out) (sconcat3 a ty ", " (sconcat a ty ")\n"))))
    (loop
      (if (>= (load distance) n) (break)
        (let [suffix (i64->str a (load distance))
              shifted (sconcat a "%shift" suffix) combined (sconcat a "%combine" suffix)
              next (sconcat a "%step" suffix)
              indices (sconcat3 a "<" (i64->str a n) " x i32> <")]
          (sb-push-str! (mut out) (sconcat3 a shifted " = shufflevector $ret " (load previous)))
          (sb-push-str! (mut out) (sconcat a ", $ret zeroinitializer, " indices))
          (for [i 0 n]
            (when (> i 0) (sb-push-str! (mut out) ", "))
            (sb-push-str! (mut out) (sconcat a "i32 " (i64->str a (if (< i (load distance)) n (- i (load distance)))))))
          (sb-push-str! (mut out) ">\n")
          (sb-push-str! (mut out) (sconcat a combined " = "))
          (if maximum
            (sb-push-str! (mut out) (sconcat3 a "call $ret @" intrinsic
              (sconcat3 a "($ret " (load previous) (sconcat3 a ", $ret " shifted ")\n"))))
            (sb-push-str! (mut out) (sconcat3 a instruction " $ret "
              (sconcat3 a (load previous) ", " (sconcat a shifted "\n")))))
          ; Zero is an exact identity for integer add/XOR/OR. Other operations
          ; preserve inactive low lanes, including signed zero and NaN payloads.
          (if (or maximum (= (type-tag lane) 1))
            (do
              (sb-push-str! (mut out) (sconcat3 a next " = shufflevector $ret " (load previous)))
              (sb-push-str! (mut out) (sconcat3 a ", $ret " combined (sconcat a ", " indices)))
              (for [i 0 n]
                (when (> i 0) (sb-push-str! (mut out) ", "))
                (sb-push-str! (mut out) (sconcat a "i32 " (i64->str a (if (< i (load distance)) i (+ n i))))))
              (sb-push-str! (mut out) ">\n")
              (set! previous next))
            (set! previous combined))
          (set! distance (* (load distance) 2)))))
    (sb-push-str! (mut out) (sconcat a "ret $ret " (load previous)))
    (sb-str (load out))))

(defn lower-vector [(a (dyn Allocator)) (op VectorOp) (result (ptr Type))
                    (types (ptr (ArrayList Type))) (args (ptr (ArrayList Expr)))]
                    (-> (Result ExprKind Diag))
  (try
    (try! (vector-signature a op result types args false))
    (when (vector-scan? op)
      (break :try (Ok (ELlvmIr (load result) args (vector-scan-ir a op result)))))
    (when (vector-memory? op)
      (break :try (Ok (ELlvmIr (load result) args (vector-memory-ir a op result types)))))
    (let [body
      (match op
        (VectorBitcast [] (vector-conversion-ir a op result (al-elem [Type] types 0)))
        (VectorWidenLow [] (vector-resize-ir a op result types))
        (VectorWidenHigh [] (vector-resize-ir a op result types))
        (VectorNarrow [] (vector-resize-ir a op result types))
        (VectorNarrowSat [] (vector-resize-ir a op result types))
        (VectorCompress []
          (vector-intrinsic-ir a (sconcat a "llvm.experimental.vector.compress." (vector-intrinsic-suffix a result))
                                result types false))
        (VectorConvert [] (vector-conversion-ir a op result (al-elem [Type] types 0)))
        (VectorShuffle [] (vector-permute-ir a op result types))
        (VectorTable [] (vector-permute-ir a op result types))
        (VectorIota [] (sconcat a "ret $ret " (vector-iota-ir a (t-arrn result) (vector-ir-type a (t-inner result)))))
        (VectorMaskLow []
          (let [it (sconcat3 a "<" (i64->str a (t-arrn result)) " x i64>")
                mt (sconcat3 a "<" (i64->str a (t-arrn result)) " x i32>")]
            (sconcat3 a (sconcat3 a "%one = insertelement " it " zeroinitializer, i64 $0, i32 0\n")
              (sconcat3 a "%count = shufflevector " it (sconcat3 a " %one, " it (sconcat3 a " zeroinitializer, " mt " zeroinitializer\n")))
              (sconcat3 a "%r = icmp sgt " it (sconcat3 a " %count, " (vector-iota-ir a (t-arrn result) "i64") "\nret $ret %r")))))
        (VectorLoad [] "%r = load $ret, ptr $0, align 1\nret $ret %r")
        (VectorStore [] "store $t1 $1, ptr $0, align 1\nret i64 0")
        (VectorMaskBits [] (vector-ballot-ir a (t-arrn (al-elem [Type] types 0))))
        (VectorBitsMask [] (vector-from-bits-ir a (t-arrn result)))
        (VectorZero [] "ret $ret zeroinitializer")
        (VectorSplat []
          (sconcat3 a "%v = insertelement $ret zeroinitializer, $t0 $0, i32 0\n%r = shufflevector $ret %v, $ret zeroinitializer, <"
            (i64->str a (t-arrn result)) " x i32> zeroinitializer\nret $ret %r"))
        (VectorLanes []
          (let [(mut body) (al-new [Expr] a)]
            (for [i 0 (len (load args))] (push! (mut body) (get (load args) i)))
            (push! (mut body) (mk-expr (EInt (t-arrn (al-elem [Type] types 0))) -1 -1 -1 -1))
            (break :try (Ok (EDo (box-al [Expr] a (load body)))))))
        (VectorSelect [] "%r = select $t0 $0, $t1 $1, $t2 $2\nret $ret %r")
        (VectorExtract [] (vector-lane-access-ir a op types))
        (VectorInsert [] (vector-lane-access-ir a op types))
        (_ (try! (vector-arithmetic-ir a op result types))))]
      (Ok (ELlvmIr (load result) args body)))))
