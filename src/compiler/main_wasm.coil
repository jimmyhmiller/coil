; src/compiler/main_wasm.coil — self-host Coil compiler ENTRY for the WASM-HOSTED
; build, running comptime (macros AND folds) via the BYTECODE INTERPRETER.
;
; This is the payoff of the interp-meta path: a metaprogram is run by INTERPRETING its
; mono'd sub-program in-process (interp.coil) — pure computation on a real memory model
; — with its metashim mh_* callbacks dispatched back into the compiler. There is NO
; codegen_wasm side-module, NO host meta_run_wasm/meta_run_ct, and NO runtime wasm
; instantiation, so the compiler-as-wasm is a SINGLE STATIC MODULE (wasm2c-friendly):
; its only imports are libc/fs. (The older side-module path in codegen_wasm.coil +
; run-coil-wasm.mjs is kept in the tree as a fallback; this entry simply doesn't use it.)
;
; Build (--wasm-stack-size=64: this compiler recurses deep, so it reserves a larger
; shadow stack than the 16 MiB default; see wasm.coil):
;   coil-w64 build src/compiler/main_wasm.coil --target wasm64-unknown-unknown --wasm-stack-size=64 -o coilc.wasm
;   node src/tooling/wasm-host/run-coil-wasm.mjs coilc.wasm check <file>
; Identical to main_a64.coil except the interp meta path is registered UNCONDITIONALLY.
(module mainwasm)
(import "coil.primitive" :as primitive)

(import "coil.alloc" :as alloc :use *)
(import "coil.result" :use *)
(import "coil.slice" :use *)
(import "coil.str" :use *)
(import "coil.arraylist" :use *)
(import "coil.io" :use *)
(import "coil.control" :use *)
(import "coil.try" :use *)
(import "ffi" :use *)
(import "coil.reader" :use *)
(import "ast" :use *)
(import "astdump" :use *)
(import "parser" :use *)
(import "loader" :use *)
(import "resolve" :use *)
(import "check" :use *)
(import "mono" :use *)
(import "diag" :use *)
(import "comptime" :use *)
(import "metaengine" :use *)
(import "expander" :use *)
(import "comptime_eval" :use *)
(import "cga64" :use *)
(import "macho" :use *)
(import "driver" :use *)
(import "cimport" :as ci)
(import "interp" :as ip)  ; the metaprogram interpreter — THE wasm comptime engine
(import "metahost" :as mh)  ; the mh_* code-op callbacks + interp dispatch/halt hooks

; ---- hard-error stubs for the (excluded) LLVM backend ----
(defn no-llvm-build [(a (ptr Allocator))
                     (src (slice u8))
                     (cwd (slice u8))
                     (obj-cstr (ptr i8))
                     (triple (ptr i8))
                     (path (slice u8))] (-> i64)
  (ps (stderr) "error: this coil was built without the LLVM backend; `build` requires `--backend arm64`\n")
  (abort)
  1)
(defn no-llvm-emitir [(a (ptr Allocator)) (src (slice u8)) (cwd (slice u8)) (triple (ptr i8)) (path (slice u8))] (-> i64)
  (ps (stderr)
      "error: this coil was built without the LLVM backend; `emit-ir` / `dump-ir` are unavailable (no textual LLVM IR without libLLVM)\n")
  (abort)
  1)
(defn no-normalize [(a (ptr Allocator)) (src (slice u8))] (-> i64)
  (ps (stderr) "error: this coil was built without the LLVM backend; `__normalize` is unavailable\n")
  (abort)
  1)

(defn no-jit-repl [(a (ptr Allocator)) (argv (ptr (ptr i8)))] (-> i64)
  (ps (stderr) "error: coil.jit currently requires an arm64 macOS host\n")
  1)
(defn do-cimport [(a (ptr Allocator)) (argc i32) (argv (ptr (ptr i8)))] (-> i64)
  (ci/cimport-cli a argc argv 2))

; the arm64 metaprogram object builder (kept so meta-compiled? is true and
; `build --backend arm64` works; the interp meta path below is preferred at runtime).
(defn meta-build-obj-a64 [(a (ptr Allocator)) (mp (ptr Program)) (obj (ptr i8))] (-> i64)
  (cga64-build-object a
                      mp
                      obj
                      ""
                      ""
                      (box-al [(slice u8)] a (al-new [(slice u8)] a))
                      (box-al [(slice u8)] a (al-new [(slice u8)] a))
                      false))
(defn meta-build-mobj-a64 [(a (ptr Allocator)) (mp (ptr Program))] (-> MObj)
  (cga64-build-mobj a
                    mp
                    ""
                    ""
                    (box-al [(slice u8)] a (al-new [(slice u8)] a))
                    (box-al [(slice u8)] a (al-new [(slice u8)] a))
                    false))

; ---- the interpreter meta path (in-sandbox, single static module) ------------------
; build = mono'd Program -> persistent Interp context; run = call one coil_mp_<k>
; entry; run-ct = interpret a comptime coil.ct.thunk / coil.ct.status fold.
(defn meta-build-interp [(a (ptr Allocator)) (mp (ptr Program))] (-> (ptr i8))
  (primitive/cast (ptr i8) (ip/interp-build a mp)))
(defn meta-run-interp [(cx (ptr i8)) (sym (ptr i8)) (argv (ptr i64)) (argc i64)] (-> (ptr i8))
  (primitive/cast (ptr i8) (ip/interp-call-entry (primitive/cast (ptr ip/Interp) cx) (cstr->slice sym) argv argc)))
(defn meta-run-ct-interp [(cxp (ptr i8)) (kind i64) (cell (ptr i8))] (-> i64)
  (let [icx (primitive/cast (ptr ip/Interp) cxp)]
    (do
      (if (= kind (primitive/cast i64 0))
          (let [argbuf (alloc/stack (array i64 1))]
            (store! (primitive/index (primitive/cast (ptr i64) argbuf) 0) (primitive/cast i64 cell))
            (ip/interp-call-entry icx "coil.ct.thunk" (primitive/cast (ptr i64) argbuf) 1))
          (let [r (ip/interp-call-entry icx "coil.ct.thunk" (primitive/cast (ptr i64) 0) 0)]
            (store! (primitive/cast (ptr i64) cell) r)
            0))
      (when (ip/interp-has-entry? icx "coil.ct.status")
        (ip/interp-call-entry icx "coil.ct.status" (primitive/cast (ptr i64) 0) 0)))))

(defn main [(argc i32) (argv (ptr (ptr i8)))] (-> i64)
  (set-meta-build-obj! (primitive/fnptr-of meta-build-obj-a64))
  (set-meta-build-mobj! (primitive/fnptr-of meta-build-mobj-a64))
  (set-wasm-sandbox! 1)  ; single-threaded sandbox: run the pipeline inline (no pthread)
  ; THE wasm comptime engine: run every metaprogram via the interpreter, in-sandbox.
  (set-meta-interp! (primitive/fnptr-of meta-build-interp)
                    (primitive/fnptr-of meta-run-interp)
                    (primitive/fnptr-of meta-run-ct-interp))
  (ip/set-interp-extern-hook! (primitive/fnptr-of mh/mh-interp-dispatch))
  (ip/set-interp-abort-check! (primitive/fnptr-of mh/mh-interp-halted?))
  (register-comptime-fold!)
  (driver-main argc
               argv
               (primitive/fnptr-of no-llvm-build)
               (primitive/fnptr-of no-llvm-emitir)
               (primitive/fnptr-of no-normalize)
               (primitive/fnptr-of do-cimport)
               (primitive/fnptr-of no-jit-repl)
               2))
