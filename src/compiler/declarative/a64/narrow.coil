;;; Written by the languages of coil-stogir-declarative from narrow.rewrite.
(module declarative.a64.narrow)
(import "coil.primitive" :as primitive)
(import "coil.arraylist" :use [ArrayList])
(import "declarative.rt.graph" :as graph)
(import "declarative.rt.bits" :as bv)
(import "declarative.a64.unit" :as st)
(import "declarative.backend.nodes" :as ir)
(import "declarative.a64.facts" :as facts)
(def RULE-NAMES ["folding" "and-keeps-all" "sext-of-small" "sar-of-small" "lt-of-small" "le-of-small" "sdiv-of-small" "srem-of-small" "shr-past" "ult-bounded"])
(const RULES 9)
(defn rule-name [(rule i64)] (-> (slice u8)) (get RULE-NAMES rule))
(defn payload-value [(cx (mut st/State)) (n i32)] (-> i64)
  (if (ir/type-signed? (graph/ty (.g cx) n))
      (bv/signed (graph/payload (.g cx) n) (ir/type-bits (graph/ty (.g cx) n)))
      (primitive/cast i64 (graph/payload (.g cx) n))))
(defn make-const [(cx (mut st/State)) (type i32) (v i64)] (-> i32)
  (ir/make-const! (mut (.g cx)) type (bv/cut (primitive/cast u64 v) (ir/type-bits type))))
;;; What `n` may be replaced by, or 0. `(.fired cx)` is the rule that said so.
(defn simplify [(cx (mut st/State)) (n i32)] (-> i32)
  (match (graph/op (.g cx) n)
    (44 (cond
        (and true (= (graph/op (.g cx) (graph/input (.g cx) n 1)) ir/CONST) (= (& (payload-value (mut cx) (graph/input (.g cx) n 1)) (bv/ones (facts/width (mut cx) (primitive/cast i32 (cast i64 (graph/input (.g cx) n 0)))))) (bv/ones (facts/width (mut cx) (primitive/cast i32 (cast i64 (graph/input (.g cx) n 0))))))) (do (set! (.fired cx) 1) (graph/input (.g cx) n 0))
        :else 0))
    (76 (cond
        (and true (< (facts/width (mut cx) (primitive/cast i32 (cast i64 (graph/input (.g cx) n 0)))) (ir/type-bits (graph/ty (.g cx) (primitive/cast i32 (cast i64 (graph/input (.g cx) n 0))))))) (do (set! (.fired cx) 2) (ir/zext! (mut (.g cx)) (graph/ty (.g cx) n) (graph/input (.g cx) n 0)))
        :else 0))
    (51 (cond
        (and true (< (facts/width (mut cx) (primitive/cast i32 (cast i64 (graph/input (.g cx) n 0)))) (ir/type-bits (graph/ty (.g cx) (primitive/cast i32 (cast i64 (graph/input (.g cx) n 0))))))) (do (set! (.fired cx) 3) (ir/shr! (mut (.g cx)) (graph/ty (.g cx) n) (graph/input (.g cx) n 0) (graph/input (.g cx) n 1)))
        :else 0))
    (109 (cond
        (and true (and (< (facts/width (mut cx) (primitive/cast i32 (cast i64 (graph/input (.g cx) n 0)))) (ir/type-bits (graph/ty (.g cx) (primitive/cast i32 (cast i64 (graph/input (.g cx) n 0)))))) (< (facts/width (mut cx) (primitive/cast i32 (cast i64 (graph/input (.g cx) n 1)))) (ir/type-bits (graph/ty (.g cx) (primitive/cast i32 (cast i64 (graph/input (.g cx) n 1)))))))) (do (set! (.fired cx) 4) (ir/ult! (mut (.g cx)) (graph/input (.g cx) n 0) (graph/input (.g cx) n 1)))
        :else 0))
    (110 (cond
        (and true (and (< (facts/width (mut cx) (primitive/cast i32 (cast i64 (graph/input (.g cx) n 0)))) (ir/type-bits (graph/ty (.g cx) (primitive/cast i32 (cast i64 (graph/input (.g cx) n 0)))))) (< (facts/width (mut cx) (primitive/cast i32 (cast i64 (graph/input (.g cx) n 1)))) (ir/type-bits (graph/ty (.g cx) (primitive/cast i32 (cast i64 (graph/input (.g cx) n 1)))))))) (do (set! (.fired cx) 5) (ir/ule! (mut (.g cx)) (graph/input (.g cx) n 0) (graph/input (.g cx) n 1)))
        :else 0))
    (53 (cond
        (and true (and (< (facts/width (mut cx) (primitive/cast i32 (cast i64 (graph/input (.g cx) n 0)))) (ir/type-bits (graph/ty (.g cx) (primitive/cast i32 (cast i64 (graph/input (.g cx) n 0)))))) (< (facts/width (mut cx) (primitive/cast i32 (cast i64 (graph/input (.g cx) n 1)))) (ir/type-bits (graph/ty (.g cx) (primitive/cast i32 (cast i64 (graph/input (.g cx) n 1)))))))) (do (set! (.fired cx) 6) (ir/udiv! (mut (.g cx)) (graph/ty (.g cx) n) (graph/input (.g cx) n 0) (graph/input (.g cx) n 1)))
        :else 0))
    (55 (cond
        (and true (and (< (facts/width (mut cx) (primitive/cast i32 (cast i64 (graph/input (.g cx) n 0)))) (ir/type-bits (graph/ty (.g cx) (primitive/cast i32 (cast i64 (graph/input (.g cx) n 0)))))) (< (facts/width (mut cx) (primitive/cast i32 (cast i64 (graph/input (.g cx) n 1)))) (ir/type-bits (graph/ty (.g cx) (primitive/cast i32 (cast i64 (graph/input (.g cx) n 1)))))))) (do (set! (.fired cx) 7) (ir/urem! (mut (.g cx)) (graph/ty (.g cx) n) (graph/input (.g cx) n 0) (graph/input (.g cx) n 1)))
        :else 0))
    (50 (cond
        (and true (= (graph/op (.g cx) (graph/input (.g cx) n 1)) ir/CONST) (and (>= (payload-value (mut cx) (graph/input (.g cx) n 1)) (facts/width (mut cx) (primitive/cast i32 (cast i64 (graph/input (.g cx) n 0))))) (< (payload-value (mut cx) (graph/input (.g cx) n 1)) (ir/type-bits (graph/ty (.g cx) (primitive/cast i32 (cast i64 (graph/input (.g cx) n 0)))))))) (do (set! (.fired cx) 8) (make-const (mut cx) (graph/ty (.g cx) n) 0))
        :else 0))
    (111 (cond
        (and true (= (graph/op (.g cx) (graph/input (.g cx) n 1)) ir/CONST) (and (and (< (facts/width (mut cx) (primitive/cast i32 (cast i64 (graph/input (.g cx) n 0)))) 63) (>= (payload-value (mut cx) (graph/input (.g cx) n 1)) 0)) (<= (bv/shl-signed 1 (facts/width (mut cx) (primitive/cast i32 (cast i64 (graph/input (.g cx) n 0))))) (payload-value (mut cx) (graph/input (.g cx) n 1))))) (do (set! (.fired cx) 9) (make-const (mut cx) (graph/ty (.g cx) n) 1))
        :else 0))
    (_ 0)))
;;; A node whose inputs are all constants is the constant its meaning gives.
(defn fold [(cx (mut st/State)) (n i32)] (-> i32)
  (let [operation (graph/op (.g cx) n)
        count (graph/arity (.g cx) n)]
    (if (or (not (ir/foldable? operation)) (= count 0) (> count 3))
        0
        (let [a (graph/input (.g cx) n 0)
              b (if (> count 1) (graph/input (.g cx) n 1) a)
              c (if (> count 2) (graph/input (.g cx) n 2) a)]
          (if (and (= (graph/op (.g cx) a) ir/CONST)
                   (= (graph/op (.g cx) b) ir/CONST)
                   (= (graph/op (.g cx) c) ir/CONST))
              (do (set! (.fired cx) 0)
                  (ir/make-const! (mut (.g cx)) (graph/ty (.g cx) n)
                             (ir/eval operation (ir/type-bits (graph/ty (.g cx) n))
                                      (ir/type-bits (graph/ty (.g cx) a))
                                      (graph/payload (.g cx) a) (graph/payload (.g cx) b)
                                      (graph/payload (.g cx) c))))
              0)))))
(defn enqueue! [(work (mut (ArrayList i32))) (queued (mut (ArrayList bool))) (n i32)] (-> void)
  (while (<= (len queued) (cast i64 n)) (push! (mut queued) false))
  (unless (get queued (cast i64 n))
    (set! (mut queued) (cast i64 n) true)
    (push! (mut work) n)))
;;; Every use of `old` becomes a use of `new`; the users are looked at again,
;;; and `old` goes, with whatever only it was using.
(defn replace! [(cx (mut st/State)) (work (mut (ArrayList i32))) (queued (mut (ArrayList bool)))
                (old i32) (new i32)] (-> void)
  (let [(mut e) (graph/first-use (.g cx) old)]
    (while (>= e 0)
      (enqueue! (mut work) (mut queued) (graph/user (.g cx) e))
      (set! e (graph/next-use (.g cx) e))))
  (graph/replace-uses! (mut (.g cx)) old new)
  (enqueue! (mut work) (mut queued) new)
  (let [role (ir/role (graph/op (.g cx) old))]
    (cond (ir/pure? (graph/op (.g cx) old)) (do (graph/kill! (mut (.g cx)) old ir/PURE) (do))
          ; A region or phi that has been replaced has no one left to speak for it.
          (or (= role 3) (= role 4) (= role 8)) (graph/drop! (mut (.g cx)) old)
          :else (do)))
  (do))
;;; A control node that can never run goes, and so does whatever only it led to.
;;; A region loses the input that came from it, and its phis the matching
;;; input; a loop that loses its way in goes entirely.
(defn kill-control! [(cx (mut st/State)) (work (mut (ArrayList i32))) (queued (mut (ArrayList bool)))
                     (dead i32)] (-> void)
  (let [(mut stack) (ArrayList::new [i32] (.alc cx))]
    (push! (mut stack) dead)
    (while (> (len stack) 0)
      (let [d (get stack (- (len stack) 1))]
        (pop! (mut stack))
        (unless (graph/dead? (.g cx) d)
          (let [(mut e) (graph/first-use (.g cx) d)]
            (while (>= e 0)
              (let [u (graph/user (.g cx) e)
                    slot (graph/slot (.g cx) e)
                    next (graph/next-use (.g cx) e)
                    role (ir/role (graph/op (.g cx) u))]
                (cond
                  ; A phi of a dead region, or the value of a dead call or load: it goes when its users do.
                  (not (ir/control-node? (graph/op (.g cx) u))) (enqueue! (mut work) (mut queued) u)
                  (and (or (= role 3) (= role 4)) (not (and (= role 4) (= slot 0))))
                    (do
                      ; The region's phis lose the input that came along this way.
                      (let [(mut p) (graph/first-use (.g cx) u)]
                        (while (>= p 0)
                          (let [phi (graph/user (.g cx) p)
                                after (graph/next-use (.g cx) p)]
                            (when (and (= (ir/role (graph/op (.g cx) phi)) 8) (= (graph/input (.g cx) phi 0) u))
                              (enqueue! (mut work) (mut queued) (graph/input (.g cx) phi (+ slot 1)))
                              (graph/remove-input! (mut (.g cx)) phi (+ slot 1))
                              (enqueue! (mut work) (mut queued) phi))
                            (set! p after))))
                      (graph/remove-input! (mut (.g cx)) u slot)
                      (enqueue! (mut work) (mut queued) u)
                      (when (= (graph/arity (.g cx) u) 0) (push! (mut stack) u)))
                  :else (push! (mut stack) u))
                (set! e next))))
          (for i (range 0 (graph/arity (.g cx) d))
            (when (!= (graph/input (.g cx) d i) 0) (enqueue! (mut work) (mut queued) (graph/input (.g cx) d i))))
          (graph/drop! (mut (.g cx)) d))))
    (free! (mut stack))))
;;; A branch that always goes one way: what followed its live side follows what
;;; led to the branch, and its other side can never run.
(defn branch! [(cx (mut st/State)) (work (mut (ArrayList i32))) (queued (mut (ArrayList bool)))
               (n i32) (taken bool)] (-> void)
  (let [before (graph/input (.g cx) n 0)
        (mut live) (: 0 i32)
        (mut dead) (: 0 i32)
        (mut e) (graph/first-use (.g cx) n)]
    (while (>= e 0)
      (let [u (graph/user (.g cx) e)
            role (ir/role (graph/op (.g cx) u))]
        (when (= role 6) (if taken (set! live u) (set! dead u)))
        (when (= role 7) (if taken (set! dead u) (set! live u))))
      (set! e (graph/next-use (.g cx) e)))
    (when (!= dead 0) (kill-control! (mut cx) (mut work) (mut queued) dead))
    (when (!= live 0)
      (let [(mut u) (graph/first-use (.g cx) live)]
        (while (>= u 0)
          (enqueue! (mut work) (mut queued) (graph/user (.g cx) u))
          (set! u (graph/next-use (.g cx) u))))
      (graph/replace-uses! (mut (.g cx)) live before)
      (graph/drop! (mut (.g cx)) live))
    (enqueue! (mut work) (mut queued) (graph/input (.g cx) n 1))
    (graph/drop! (mut (.g cx)) n)))
;;; A region with one way in is that way; a phi all of whose values are one
;;; node, or that node and the phi itself, is that node.
(defn collapse [(cx (mut st/State)) (n i32)] (-> i32)
  (let [role (ir/role (graph/op (.g cx) n))]
    (cond (and (or (= role 3) (= role 4)) (= (graph/arity (.g cx) n) 1)) (graph/input (.g cx) n 0)
          (= role 8)
            (let [(mut only) (: 0 i32)
                  (mut several) false]
              (for i (range 1 (graph/arity (.g cx) n))
                (let [v (graph/input (.g cx) n i)]
                  (when (!= v n)
                    (if (or (= only 0) (= only v)) (set! only v) (set! several true)))))
              (if several 0 only))
          :else 0)))
;;; Keep what control from the start reaches and what
;;; that reads, and drop the rest, which may be rings of values that only read
;;; each other.
(defn sweep! [(cx (mut st/State))] (-> void)
  (let [(mut keep) (ArrayList::new [bool] (.alc cx))
        (mut stack) (ArrayList::new [i32] (.alc cx))]
    (for _ (range 0 (graph/size (.g cx))) (push! (mut keep) false))
    (when (!= (.start (.g cx)) 0)
      (set! (mut keep) (cast i64 (.start (.g cx))) true)
      (push! (mut stack) (.start (.g cx))))
    (while (> (len stack) 0)
      (let [n (get stack (- (len stack) 1))]
        (pop! (mut stack))
        ; Whatever a kept node reads is kept.
        (for i (range 0 (graph/arity (.g cx) n))
          (let [d (graph/input (.g cx) n i)]
            (when (and (!= d 0) (not (get keep (cast i64 d))))
              (set! (mut keep) (cast i64 d) true)
              (push! (mut stack) d))))
        ; Control goes on to the control nodes that follow a kept one.
        (when (ir/control-node? (graph/op (.g cx) n))
          (let [(mut e) (graph/first-use (.g cx) n)]
            (while (>= e 0)
              (let [u (graph/user (.g cx) e)
                    role (ir/role (graph/op (.g cx) u))]
                (when (and (not (get keep (cast i64 u))) (ir/control-node? (graph/op (.g cx) u))
                           (or (= role 3) (= role 4) (= (graph/input (.g cx) u 0) n)))
                  (set! (mut keep) (cast i64 u) true)
                  (push! (mut stack) u)))
              (set! e (graph/next-use (.g cx) e)))))))
    (for i (range 1 (graph/size (.g cx)))
      (let [n (cast i32 i)]
        (unless (or (get keep i) (graph/dead? (.g cx) n)) (graph/drop! (mut (.g cx)) n))))
    (free! (mut keep))
    (free! (mut stack))))
;;; Apply folding and the rules until nothing changes. Returns how many
;;; replacements were made; `counts`, if not empty, gets one more per rule fired.
(defn run-counting [(cx (mut st/State)) (counts (mut (ArrayList i64)))] (-> i64)
  (let [(mut work) (ArrayList::new [i32] (.alc cx))
        (mut queued) (ArrayList::new [bool] (.alc cx))
        (mut changes) 0
        (mut cut) false]
    (for i (range 1 (graph/size (.g cx)))
      (let [n (cast i32 (- (graph/size (.g cx)) i))]
        (unless (graph/dead? (.g cx) n) (enqueue! (mut work) (mut queued) n))))
    (while (> (len work) 0)
      (let [n (get work (- (len work) 1))]
        (pop! (mut work))
        (set! (mut queued) (cast i64 n) false)
        (unless (graph/dead? (.g cx) n)
          (let [operation (graph/op (.g cx) n)]
            (if (and (ir/pure? operation) (= (graph/use-count (.g cx) n) 0))
                (do (graph/kill! (mut (.g cx)) n ir/PURE) (do))
                (do
                  ; A commutative node keeps its operands in the builder's order.
                  (when (and (ir/commutative? operation) (= (graph/arity (.g cx) n) 2))
                    (let [a (graph/input (.g cx) n 0)
                          b (graph/input (.g cx) n 1)]
                      (when (ir/swap? (.g cx) a b)
                        (graph/set-input! (mut (.g cx)) n 0 b)
                        (graph/set-input! (mut (.g cx)) n 1 a))))
                  (let [collapsed (collapse (mut cx) n)
                        folded (if (!= collapsed 0) collapsed (fold (mut cx) n))
                        simpler (if (!= folded 0) folded (simplify (mut cx) n))
                        ; Unchanged by any rule: it may now equal a node already there.
                        other (if (and (= simpler 0) (ir/pure? operation))
                                  (graph/canonical! (mut (.g cx)) n)
                                  simpler)]
                    (when (< other 0)
                      (when (> (len counts) (.fired cx))
                        (set! (mut counts) (.fired cx) (+ (get counts (.fired cx)) 1)))
                      (set! changes (+ changes 1))
                      (set! cut true)
                      (branch! (mut cx) (mut work) (mut queued) n (= other -1)))
                    (when (and (> other 0) (!= other n))
                      (when (and (!= simpler 0) (> (len counts) (.fired cx)))
                        (set! (mut counts) (.fired cx) (+ (get counts (.fired cx)) 1)))
                      (set! changes (+ changes 1))
                      (replace! (mut cx) (mut work) (mut queued) n other)))))))))
    (free! (mut work))
    (free! (mut queued))
    ; Always: rings of phis that only feed each other are dead without any cut.
    (when (or cut (> changes 0) (.swept cx)) (sweep! (mut cx)))
    (set! (.swept cx) false)
    (st/grow-nodes! (mut cx))
    changes))
(defn run [(cx (mut st/State))] (-> i64)
  (let [(mut none) (ArrayList::new [i64] (.alc cx))]
    (run-counting (mut cx) (mut none))))
(defn instance-1 [(cx (mut st/State)) (rnd (mut Rnd)) (main i32)] (-> i32)
  (let [v*0 (narrowed! (mut cx) (mut rnd) (ir/make-param! (mut (.g cx)) (deviate! (mut rnd) main) 0)) ] (ir/and! (mut (.g cx)) (deviate! (mut rnd) main) v*0 (let [t* (deviate! (mut rnd) main)] (ir/make-const! (mut (.g cx)) t* (bv/cut (interesting! (mut rnd)) (ir/type-bits t*)))))))
(defn instance-2 [(cx (mut st/State)) (rnd (mut Rnd)) (main i32)] (-> i32)
  (let [v*0 (narrowed! (mut cx) (mut rnd) (ir/make-param! (mut (.g cx)) (deviate! (mut rnd) main) 0)) ] (ir/sext! (mut (.g cx)) (deviate! (mut rnd) main) v*0)))
(defn instance-3 [(cx (mut st/State)) (rnd (mut Rnd)) (main i32)] (-> i32)
  (let [v*0 (narrowed! (mut cx) (mut rnd) (ir/make-param! (mut (.g cx)) (deviate! (mut rnd) main) 0)) v*1 (narrowed! (mut cx) (mut rnd) (ir/make-param! (mut (.g cx)) (deviate! (mut rnd) main) 1)) ] (ir/sar! (mut (.g cx)) (deviate! (mut rnd) main) v*0 v*1)))
(defn instance-4 [(cx (mut st/State)) (rnd (mut Rnd)) (main i32)] (-> i32)
  (let [v*0 (narrowed! (mut cx) (mut rnd) (ir/make-param! (mut (.g cx)) (deviate! (mut rnd) main) 0)) v*1 (narrowed! (mut cx) (mut rnd) (ir/make-param! (mut (.g cx)) (deviate! (mut rnd) main) 1)) ] (ir/lt! (mut (.g cx)) v*0 v*1)))
(defn instance-5 [(cx (mut st/State)) (rnd (mut Rnd)) (main i32)] (-> i32)
  (let [v*0 (narrowed! (mut cx) (mut rnd) (ir/make-param! (mut (.g cx)) (deviate! (mut rnd) main) 0)) v*1 (narrowed! (mut cx) (mut rnd) (ir/make-param! (mut (.g cx)) (deviate! (mut rnd) main) 1)) ] (ir/le! (mut (.g cx)) v*0 v*1)))
(defn instance-6 [(cx (mut st/State)) (rnd (mut Rnd)) (main i32)] (-> i32)
  (let [v*0 (narrowed! (mut cx) (mut rnd) (ir/make-param! (mut (.g cx)) (deviate! (mut rnd) main) 0)) v*1 (narrowed! (mut cx) (mut rnd) (ir/make-param! (mut (.g cx)) (deviate! (mut rnd) main) 1)) ] (ir/sdiv! (mut (.g cx)) (deviate! (mut rnd) main) v*0 v*1)))
(defn instance-7 [(cx (mut st/State)) (rnd (mut Rnd)) (main i32)] (-> i32)
  (let [v*0 (narrowed! (mut cx) (mut rnd) (ir/make-param! (mut (.g cx)) (deviate! (mut rnd) main) 0)) v*1 (narrowed! (mut cx) (mut rnd) (ir/make-param! (mut (.g cx)) (deviate! (mut rnd) main) 1)) ] (ir/srem! (mut (.g cx)) (deviate! (mut rnd) main) v*0 v*1)))
(defn instance-8 [(cx (mut st/State)) (rnd (mut Rnd)) (main i32)] (-> i32)
  (let [v*0 (narrowed! (mut cx) (mut rnd) (ir/make-param! (mut (.g cx)) (deviate! (mut rnd) main) 0)) ] (ir/shr! (mut (.g cx)) (deviate! (mut rnd) main) v*0 (let [t* (deviate! (mut rnd) main)] (ir/make-const! (mut (.g cx)) t* (bv/cut (interesting! (mut rnd)) (ir/type-bits t*)))))))
(defn instance-9 [(cx (mut st/State)) (rnd (mut Rnd)) (main i32)] (-> i32)
  (let [v*0 (narrowed! (mut cx) (mut rnd) (ir/make-param! (mut (.g cx)) (deviate! (mut rnd) main) 0)) ] (ir/ult! (mut (.g cx)) v*0 (let [t* (deviate! (mut rnd) main)] (ir/make-const! (mut (.g cx)) t* (bv/cut (interesting! (mut rnd)) (ir/type-bits t*)))))))
(defstruct Rnd [(state u64)])
(defn roll! [(rnd (mut Rnd))] (-> u64)
  (let [(mut x) (.state rnd)]
    (set! x (^ x (<< x 13))) (set! x (^ x (>> x 7))) (set! x (^ x (<< x 17)))
    (set! (.state rnd) x)
    x))
(defn value-type! [(rnd (mut Rnd))] (-> i32)
  (let [(mut type) (: 0 i32)]
    (while (not (ir/value-type? type))
      (set! type (cast i32 (+ 1 (cast i64 (% (roll! (mut rnd)) (cast u64 ir/TYPES)))))))
    type))
;;; The trial's main type, or one time in three some other.
(defn deviate! [(rnd (mut Rnd)) (main i32)] (-> i32)
  (if (= (% (roll! (mut rnd)) 3) 0) (value-type! (mut rnd)) main))
;;; Values that find mistakes: zero, one, the edges of every width, and noise.
(defn interesting! [(rnd (mut Rnd))] (-> u64)
  (let [k (% (roll! (mut rnd)) 16)]
    (cond (= k 0) (: 0 u64) (= k 1) (: 1 u64) (= k 2) (: 0xFFFFFFFFFFFFFFFF u64)
          (= k 3) (: 2 u64) (= k 4) (: 0x7F u64) (= k 5) (: 0x80 u64) (= k 6) (: 0xFF u64)
          (= k 7) (: 0x7FFF u64) (= k 8) (: 0x8000 u64) (= k 9) (: 0x7FFFFFFF u64)
          (= k 10) (: 0x80000000 u64) (= k 11) (: 0x8000000000000000 u64)
          (= k 12) (<< (: 1 u64) (% (roll! (mut rnd)) 64))
          (= k 13) (% (roll! (mut rnd)) 64)
          :else (roll! (mut rnd)))))
;;; A parameter, or one time in three its low few bits, so that rules which ask
;;; what is known of a value meet values of which something is known.
(defn narrowed! [(cx (mut st/State)) (rnd (mut Rnd)) (p i32)] (-> i32)
  (let [type (graph/ty (.g cx) p)]
    (if (and (= (% (roll! (mut rnd)) 3) 0) (> (ir/type-bits type) 1) (not (ir/type-float? type)))
        (ir/and! (mut (.g cx)) type p
                 (ir/make-const! (mut (.g cx)) type
                            (bv/mask (cast i64 (% (roll! (mut rnd)) (cast u64 (ir/type-bits type)))))))
        p)))
(defn instance [(cx (mut st/State)) (rnd (mut Rnd)) (rule i64) (main i32)] (-> i32)
  (match rule
    (1 (instance-1 (mut cx) (mut rnd) main))
    (2 (instance-2 (mut cx) (mut rnd) main))
    (3 (instance-3 (mut cx) (mut rnd) main))
    (4 (instance-4 (mut cx) (mut rnd) main))
    (5 (instance-5 (mut cx) (mut rnd) main))
    (6 (instance-6 (mut cx) (mut rnd) main))
    (7 (instance-7 (mut cx) (mut rnd) main))
    (8 (instance-8 (mut cx) (mut rnd) main))
    (9 (instance-9 (mut cx) (mut rnd) main))
    (_ 0)))
;;; Every rule against the nodes' meanings: its pattern is built over
;;; parameters with `tries` choices of types and constants, and wherever a
;;; rule applies, the node and its replacement must have one type and one
;;; value for 64 choices of the parameters. Prints what is wrong and returns
;;; how many rules are wrong or were never seen to apply.
(defn check-rules [(cx (mut st/State)) (tries i64)] (-> i64)
  (let [(mut rnd) (Rnd :state (: 0x9E3779B97F4A7C15 u64))
        (mut applied) (ArrayList::new [i64] (.alc cx))
        (mut wrong) (ArrayList::new [bool] (.alc cx))
        (mut args) (ArrayList::new [u64] (.alc cx))
        (mut bad) 0]
    (for _ (range 0 (+ RULES 1)) (push! (mut applied) 0) (push! (mut wrong) false))
    (for _ (range 0 8) (push! (mut args) 0))
    (for rule (range 1 (+ RULES 1))
      (let [(mut checkable) true]
        (for _ (range 0 tries)
          (when checkable
            (graph/release! (mut (.g cx)))
            (set! (.g cx) (graph/create (.alc cx)))
            (let [main (value-type! (mut rnd))
                  root (instance (mut cx) (mut rnd) rule main)]
              (if (= root 0)
                  (set! checkable false)
                  (when (= (ir/verify (.g cx)) "")
                    (do (st/begin! (mut cx)) (facts/solve (mut cx)))
                    (set! (.fired cx) 0)
                    (let [new (simplify (mut cx) root)
                          fired (.fired cx)]
                      (when (and (!= new 0) (> fired 0) (not (get wrong fired)))
                        (set! (mut applied) fired (+ (get applied fired) 1))
                        (cond
                          (!= (graph/ty (.g cx) new) (graph/ty (.g cx) root))
                            (do (println "  WRONG {}: a {} becomes a {}" (rule-name fired)
                                         (ir/type-name (graph/ty (.g cx) root))
                                         (ir/type-name (graph/ty (.g cx) new)))
                                (set! (mut wrong) fired true))
                          (!= (ir/verify (.g cx)) "")
                            (do (println "  WRONG {}: it builds a node that is not well formed: {}"
                                         (rule-name fired) (ir/verify (.g cx)))
                                (set! (mut wrong) fired true))
                          :else
                            (for _ (range 0 64)
                              (unless (get wrong fired)
                                (for i (range 0 8) (set! (mut args) i (interesting! (mut rnd))))
                                (let [before (ir/eval-node (.g cx) (slice args) root)
                                      after (ir/eval-node (.g cx) (slice args) new)]
                                  (when (!= before after)
                                    (println "  WRONG {}: on a {} with parameters {:x} {:x} {:x}, {:x} became {:x}"
                                             (rule-name fired) (ir/type-name (graph/ty (.g cx) root))
                                             (get args 0) (get args 1) (get args 2) before after)
                                    (set! (mut wrong) fired true)))))))))))))
        (unless checkable
          (println "  not checked, its pattern is not a value of its inputs alone: {}" (rule-name rule))
          (set! (mut applied) rule -1))))
    (for rule (range 1 (+ RULES 1))
      (when (get wrong rule) (set! bad (+ bad 1)))
      (when (= (get applied rule) 0)
        (println "  never seen to apply: {}" (rule-name rule))
        (set! bad (+ bad 1))))
    bad))

