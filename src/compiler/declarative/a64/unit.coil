;;; Written by the languages of coil-stogir-declarative from a64.unit.
(module declarative.a64.unit)
(import "coil.alloc" :use [Allocator])
(import "coil.arraylist" :use [ArrayList])
(import "declarative.rt.graph" :as graph)
(import "declarative.rt.lists" :as lists)
(defstruct State [(g graph/Graph) (alc (dyn Allocator)) (fired i64) (swept bool)
  (block-count i32)
  (inst-count i32)
  (vreg-count i32)
  (range-count i32)
  (use-count i32)
  (piece-count i32)
  (phys-count i32)
