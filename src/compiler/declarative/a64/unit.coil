(defn create [(g graph/Graph) (a (dyn Allocator))] (-> State)
  (State :g g :alc a :fired 0 :swept true
    :block-count 0
    :inst-count 0
    :vreg-count 0
    :range-count 0
    :use-count 0
    :piece-count 0
    :phys-count 0
    :fact-width (ArrayList::new [i64] a)
    :head (ArrayList::new [i32] a)
    :last (ArrayList::new [i32] a)
    :succs (lists/create a)
    :preds (lists/create a)
    :block-of (ArrayList::new [i32] a)
    :idom (ArrayList::new [i32] a)
    :dom-depth (ArrayList::new [i64] a)
    :loop-depth (ArrayList::new [i64] a)
    :rpo (ArrayList::new [i64] a)
    :seen (ArrayList::new [bool] a)
    :mark (ArrayList::new [i64] a)
    :loop-blocks (lists/create a)
    :loop-head (ArrayList::new [i32] a)
    :loop-parent (ArrayList::new [i32] a)
    :chain-pos (ArrayList::new [i64] a)
    :reaching (ArrayList::new [i32] a)
    :out-store (ArrayList::new [i32] a)
    :store-mark (ArrayList::new [i64] a)
    :entry-value (ArrayList::new [i32] a)
    :entry-mark (ArrayList::new [i64] a)
    :known-at (lists/create a)
    :known-as (lists/create a)
    :member (ArrayList::new [i64] a)
    :touched (ArrayList::new [bool] a)
    :varies (ArrayList::new [i64] a)
    :steady (ArrayList::new [i64] a)
    :way-walked (ArrayList::new [i64] a)
    :early-done (ArrayList::new [bool] a)
    :late-done (ArrayList::new [bool] a)
    :placed (ArrayList::new [bool] a)
    :seq (lists/create a)
    :members (lists/create a)
    :inst-op (ArrayList::new [i64] a)
    :a0 (ArrayList::new [i64] a)
    :a1 (ArrayList::new [i64] a)
    :a2 (ArrayList::new [i64] a)
    :a3 (ArrayList::new [i64] a)
    :a4 (ArrayList::new [i64] a)
    :also-reads (ArrayList::new [u64] a)
    :also-writes (ArrayList::new [u64] a)
    :kind (ArrayList::new [i64] a)
    :caller-bytes (ArrayList::new [i64] a)
    :copy-to (ArrayList::new [i64] a)
    :copy-from (ArrayList::new [i64] a)
    :first-inst (ArrayList::new [i64] a)
    :last-inst (ArrayList::new [i64] a)
    :needed (ArrayList::new [bool] a)
    :tile (ArrayList::new [i64] a)
    :local-reg (ArrayList::new [i64] a)
    :local-block (ArrayList::new [i32] a)
    :object-at (ArrayList::new [i64] a)
    :first-piece (ArrayList::new [i32] a)
    :at-piece (ArrayList::new [i32] a)
    :slot (ArrayList::new [i64] a)
    :hint (ArrayList::new [i64] a)
    :class (ArrayList::new [i64] a)
    :wide (ArrayList::new [bool] a)
    :last-reg (ArrayList::new [i64] a)
    :reads (lists/create a)
    :writes (lists/create a)
    :open-from (ArrayList::new [i64] a)
    :last-touch (ArrayList::new [i64] a)
    :out-mark (ArrayList::new [i64] a)
    :weight (ArrayList::new [i64] a)
    :from (ArrayList::new [i64] a)
    :to (ArrayList::new [i64] a)
    :next-range (ArrayList::new [i32] a)
    :pos (ArrayList::new [i64] a)
    :next-use (ArrayList::new [i32] a)
    :owner (ArrayList::new [i32] a)
    :ranges (ArrayList::new [i32] a)
    :last-range (ArrayList::new [i32] a)
    :first-use (ArrayList::new [i32] a)
    :last-use (ArrayList::new [i32] a)
    :pstart (ArrayList::new [i64] a)
    :pend (ArrayList::new [i64] a)
    :reg (ArrayList::new [i64] a)
    :in-frame (ArrayList::new [bool] a)
    :next-piece (ArrayList::new [i32] a)
    :prev-piece (ArrayList::new [i32] a)
    :fixed (ArrayList::new [i32] a)
    :last-fixed (ArrayList::new [i32] a)
    :free-until (ArrayList::new [i64] a)
    :needed-at (ArrayList::new [i64] a)
    :blocked-at (ArrayList::new [i64] a)
    :home (ArrayList::new [i32] a)
    :starts-even (lists/create a)
    :starts-odd (lists/create a)
    :write-mark (ArrayList::new [i64] a)
    :write-first (ArrayList::new [i64] a)
    :live-mark (ArrayList::new [i64] a)
    :live-in (lists/create a)
    :final-first (ArrayList::new [i64] a)
    :onward (ArrayList::new [i32] a)
    :offset (ArrayList::new [i64] a)
    :trial false
    :post (ArrayList::new [i32] a)
    :order (ArrayList::new [i32] a)
    :stamp 0
    :root (: 0 i32)
    :serial 0
    :promoted 0
    :at (ArrayList::new [i32] a)
    :as (ArrayList::new [i32] a)
    :forwarded 0
    :loop-serial 0
    :way-walk 0
    :loop-node (: 0 i32)
    :loop-exit (: 0 i32)
    :loop-after (: 0 i32)
    :use-of (ArrayList::new [i32] a)
    :use-slot (ArrayList::new [i64] a)
    :use-at (ArrayList::new [i32] a)
    :reach-phi (ArrayList::new [i32] a)
    :reach-at (ArrayList::new [i32] a)
    :reach-as (ArrayList::new [i32] a)
    :stores (ArrayList::new [i32] a)
    :unknown false
    :turned 0
    :hoisted 0
    :emitting (: 0 i32)
    :next-vreg 0
    :object-bytes 0
    :out-slots 0
    :calls false
    :dynamic false
    :pinned-writes (: 0 u64)
    :worklist (ArrayList::new [i32] a)
    :wide-temps (ArrayList::new [i64] a)
    :expanded 0
    :copy-routine 0
    :fill-routine 0
    :inline-bytes 0
    :part-at (ArrayList::new [i64] a)
    :part-bytes (ArrayList::new [i64] a)
    :part-object (ArrayList::new [i32] a)
    :accesses (ArrayList::new [i32] a)
    :access-at (ArrayList::new [i64] a)
    :access-bytes (ArrayList::new [i64] a)
    :split 0
    :ints 0
    :floats 0
    :stack-bytes 0
    :following 0
    :placed-bytes 0
    :active (ArrayList::new [i32] a)
    :inactive (ArrayList::new [i32] a)
    :opened (ArrayList::new [i32] a)
    :stack (ArrayList::new [i32] a)
    :slots 0
    :used (: 0 u64)
    :final-start 0
    :frame 0
    :saved (: 0 u64)
    :move-to (ArrayList::new [i64] a)
    :move-from (ArrayList::new [i64] a)
    :move-wide (ArrayList::new [bool] a)
    :code (ArrayList::new [u8] a)
    :code-bytes 0
    :reloc-at (ArrayList::new [i64] a)
    :reloc-symbol (ArrayList::new [i64] a)
    :reloc-op (ArrayList::new [i64] a)
    :dropped 0
  ))
(defn block-new! [(cx (mut State))] (-> i32)
  (let [a (.alc cx)]
  (set! (.block-count cx) (+ (.block-count cx) 1))
  (push! (mut (.head cx)) (: 0 i32))
  (push! (mut (.last cx)) (: 0 i32))
  (lists/add-key! (mut (.succs cx)))
  (lists/add-key! (mut (.preds cx)))
  (push! (mut (.idom cx)) (: 0 i32))
  (push! (mut (.dom-depth cx)) 0)
  (push! (mut (.loop-depth cx)) 0)
  (push! (mut (.rpo cx)) 0)
  (push! (mut (.seen cx)) false)
  (push! (mut (.mark cx)) 0)
  (lists/add-key! (mut (.loop-blocks cx)))
  (push! (mut (.loop-head cx)) (: 0 i32))
  (push! (mut (.loop-parent cx)) (: 0 i32))
  (push! (mut (.out-store cx)) (: 0 i32))
  (push! (mut (.store-mark cx)) 0)
  (push! (mut (.entry-value cx)) (: 0 i32))
  (push! (mut (.entry-mark cx)) 0)
  (lists/add-key! (mut (.known-at cx)))
  (lists/add-key! (mut (.known-as cx)))
  (push! (mut (.member cx)) 0)
  (push! (mut (.touched cx)) false)
  (push! (mut (.way-walked cx)) 0)
  (lists/add-key! (mut (.seq cx)))
  (lists/add-key! (mut (.members cx)))
  (push! (mut (.first-inst cx)) 0)
  (push! (mut (.last-inst cx)) 0)
  (push! (mut (.write-mark cx)) 0)
  (push! (mut (.write-first cx)) 0)
  (push! (mut (.live-mark cx)) 0)
  (lists/add-key! (mut (.live-in cx)))
  (push! (mut (.final-first cx)) 0)
  (push! (mut (.onward cx)) (: 0 i32))
  (.block-count cx)))
(defn inst-new! [(cx (mut State))] (-> i32)
  (let [a (.alc cx)]
  (set! (.inst-count cx) (+ (.inst-count cx) 1))
  (push! (mut (.inst-op cx)) 0)
  (push! (mut (.a0 cx)) 0)
  (push! (mut (.a1 cx)) 0)
  (push! (mut (.a2 cx)) 0)
  (push! (mut (.a3 cx)) 0)
  (push! (mut (.a4 cx)) 0)
  (push! (mut (.also-reads cx)) (: 0 u64))
  (push! (mut (.also-writes cx)) (: 0 u64))
  (push! (mut (.kind cx)) 0)
  (push! (mut (.caller-bytes cx)) 0)
  (push! (mut (.copy-to cx)) 0)
  (push! (mut (.copy-from cx)) 0)
  (push! (mut (.home cx)) (: 0 i32))
  (lists/add-key! (mut (.starts-even cx)))
  (lists/add-key! (mut (.starts-odd cx)))
  (push! (mut (.offset cx)) 0)
  (.inst-count cx)))
(defn vreg-new! [(cx (mut State))] (-> i32)
  (let [a (.alc cx)]
  (set! (.vreg-count cx) (+ (.vreg-count cx) 1))
  (push! (mut (.first-piece cx)) (: 0 i32))
  (push! (mut (.at-piece cx)) (: 0 i32))
  (push! (mut (.slot cx)) 0)
  (push! (mut (.hint cx)) 0)
  (push! (mut (.class cx)) 0)
  (push! (mut (.wide cx)) false)
  (push! (mut (.last-reg cx)) 0)
  (lists/add-key! (mut (.reads cx)))
  (lists/add-key! (mut (.writes cx)))
  (push! (mut (.open-from cx)) 0)
  (push! (mut (.last-touch cx)) 0)
  (push! (mut (.out-mark cx)) 0)
  (push! (mut (.weight cx)) 0)
  (.vreg-count cx)))
(defn range-new! [(cx (mut State))] (-> i32)
  (let [a (.alc cx)]
  (set! (.range-count cx) (+ (.range-count cx) 1))
  (push! (mut (.from cx)) 0)
  (push! (mut (.to cx)) 0)
  (push! (mut (.next-range cx)) (: 0 i32))
  (.range-count cx)))
(defn use-new! [(cx (mut State))] (-> i32)
  (let [a (.alc cx)]
  (set! (.use-count cx) (+ (.use-count cx) 1))
  (push! (mut (.pos cx)) 0)
  (push! (mut (.next-use cx)) (: 0 i32))
  (.use-count cx)))
(defn piece-new! [(cx (mut State))] (-> i32)
  (let [a (.alc cx)]
  (set! (.piece-count cx) (+ (.piece-count cx) 1))
  (push! (mut (.owner cx)) (: 0 i32))
  (push! (mut (.ranges cx)) (: 0 i32))
  (push! (mut (.last-range cx)) (: 0 i32))
  (push! (mut (.first-use cx)) (: 0 i32))
  (push! (mut (.last-use cx)) (: 0 i32))
  (push! (mut (.pstart cx)) 0)
  (push! (mut (.pend cx)) 0)
  (push! (mut (.reg cx)) 0)
  (push! (mut (.in-frame cx)) false)
  (push! (mut (.next-piece cx)) (: 0 i32))
  (push! (mut (.prev-piece cx)) (: 0 i32))
  (.piece-count cx)))
(defn phys-new! [(cx (mut State))] (-> i32)
  (let [a (.alc cx)]
  (set! (.phys-count cx) (+ (.phys-count cx) 1))
  (push! (mut (.fixed cx)) (: 0 i32))
  (push! (mut (.last-fixed cx)) (: 0 i32))
  (push! (mut (.free-until cx)) 0)
  (push! (mut (.needed-at cx)) 0)
  (push! (mut (.blocked-at cx)) 0)
  (.phys-count cx)))
(defn grow-nodes! [(cx (mut State))] (-> void)
  (let [a (.alc cx) n (graph/size (.g cx))]
  (when (< (len (.fact-width cx)) n) (extend-zeroed! (mut (.fact-width cx)) (- n (len (.fact-width cx)))))
  (when (< (len (.block-of cx)) n) (extend-zeroed! (mut (.block-of cx)) (- n (len (.block-of cx)))))
  (when (< (len (.chain-pos cx)) n) (extend-zeroed! (mut (.chain-pos cx)) (- n (len (.chain-pos cx)))))
  (when (< (len (.reaching cx)) n) (extend-zeroed! (mut (.reaching cx)) (- n (len (.reaching cx)))))
  (when (< (len (.varies cx)) n) (extend-zeroed! (mut (.varies cx)) (- n (len (.varies cx)))))
  (when (< (len (.steady cx)) n) (extend-zeroed! (mut (.steady cx)) (- n (len (.steady cx)))))
  (when (< (len (.early-done cx)) n) (extend-zeroed! (mut (.early-done cx)) (- n (len (.early-done cx)))))
  (when (< (len (.late-done cx)) n) (extend-zeroed! (mut (.late-done cx)) (- n (len (.late-done cx)))))
  (when (< (len (.placed cx)) n) (extend-zeroed! (mut (.placed cx)) (- n (len (.placed cx)))))
  (when (< (len (.needed cx)) n) (extend-zeroed! (mut (.needed cx)) (- n (len (.needed cx)))))
  (when (< (len (.tile cx)) n) (extend-zeroed! (mut (.tile cx)) (- n (len (.tile cx)))))
  (when (< (len (.local-reg cx)) n) (extend-zeroed! (mut (.local-reg cx)) (- n (len (.local-reg cx)))))
  (when (< (len (.local-block cx)) n) (extend-zeroed! (mut (.local-block cx)) (- n (len (.local-block cx)))))
  (when (< (len (.object-at cx)) n) (extend-zeroed! (mut (.object-at cx)) (- n (len (.object-at cx)))))
  0))
(defn begin! [(cx (mut State))] (-> void)
  (let [a (.alc cx)]
  (set! (.swept cx) true)
  (set! (.block-count cx) 0)
  (set! (.inst-count cx) 0)
  (set! (.vreg-count cx) 0)
  (set! (.range-count cx) 0)
  (set! (.use-count cx) 0)
  (set! (.piece-count cx) 0)
  (set! (.phys-count cx) 0)
  (clear! (mut (.fact-width cx)))
  (clear! (mut (.head cx)))
  (push! (mut (.head cx)) (: 0 i32))
  (clear! (mut (.last cx)))
  (push! (mut (.last cx)) (: 0 i32))
  (lists/clear! (mut (.succs cx)))
  (lists/add-key! (mut (.succs cx)))
  (lists/clear! (mut (.preds cx)))
  (lists/add-key! (mut (.preds cx)))
  (clear! (mut (.block-of cx)))
  (clear! (mut (.idom cx)))
  (push! (mut (.idom cx)) (: 0 i32))
  (clear! (mut (.dom-depth cx)))
  (push! (mut (.dom-depth cx)) 0)
  (clear! (mut (.loop-depth cx)))
  (push! (mut (.loop-depth cx)) 0)
  (clear! (mut (.rpo cx)))
  (push! (mut (.rpo cx)) 0)
  (clear! (mut (.seen cx)))
  (push! (mut (.seen cx)) false)
  (clear! (mut (.mark cx)))
  (push! (mut (.mark cx)) 0)
  (lists/clear! (mut (.loop-blocks cx)))
  (lists/add-key! (mut (.loop-blocks cx)))
  (clear! (mut (.loop-head cx)))
  (push! (mut (.loop-head cx)) (: 0 i32))
  (clear! (mut (.loop-parent cx)))
  (push! (mut (.loop-parent cx)) (: 0 i32))
  (clear! (mut (.chain-pos cx)))
  (clear! (mut (.reaching cx)))
  (clear! (mut (.out-store cx)))
  (push! (mut (.out-store cx)) (: 0 i32))
  (clear! (mut (.store-mark cx)))
  (push! (mut (.store-mark cx)) 0)
  (clear! (mut (.entry-value cx)))
  (push! (mut (.entry-value cx)) (: 0 i32))
  (clear! (mut (.entry-mark cx)))
  (push! (mut (.entry-mark cx)) 0)
  (lists/clear! (mut (.known-at cx)))
  (lists/add-key! (mut (.known-at cx)))
  (lists/clear! (mut (.known-as cx)))
  (lists/add-key! (mut (.known-as cx)))
  (clear! (mut (.member cx)))
  (push! (mut (.member cx)) 0)
  (clear! (mut (.touched cx)))
  (push! (mut (.touched cx)) false)
  (clear! (mut (.varies cx)))
  (clear! (mut (.steady cx)))
  (clear! (mut (.way-walked cx)))
  (push! (mut (.way-walked cx)) 0)
  (clear! (mut (.early-done cx)))
  (clear! (mut (.late-done cx)))
  (clear! (mut (.placed cx)))
  (lists/clear! (mut (.seq cx)))
  (lists/add-key! (mut (.seq cx)))
  (lists/clear! (mut (.members cx)))
  (lists/add-key! (mut (.members cx)))
  (clear! (mut (.inst-op cx)))
  (push! (mut (.inst-op cx)) 0)
  (clear! (mut (.a0 cx)))
  (push! (mut (.a0 cx)) 0)
  (clear! (mut (.a1 cx)))
  (push! (mut (.a1 cx)) 0)
  (clear! (mut (.a2 cx)))
  (push! (mut (.a2 cx)) 0)
  (clear! (mut (.a3 cx)))
  (push! (mut (.a3 cx)) 0)
  (clear! (mut (.a4 cx)))
  (push! (mut (.a4 cx)) 0)
  (clear! (mut (.also-reads cx)))
  (push! (mut (.also-reads cx)) (: 0 u64))
  (clear! (mut (.also-writes cx)))
  (push! (mut (.also-writes cx)) (: 0 u64))
  (clear! (mut (.kind cx)))
  (push! (mut (.kind cx)) 0)
  (clear! (mut (.caller-bytes cx)))
  (push! (mut (.caller-bytes cx)) 0)
  (clear! (mut (.copy-to cx)))
  (push! (mut (.copy-to cx)) 0)
  (clear! (mut (.copy-from cx)))
  (push! (mut (.copy-from cx)) 0)
  (clear! (mut (.first-inst cx)))
  (push! (mut (.first-inst cx)) 0)
  (clear! (mut (.last-inst cx)))
