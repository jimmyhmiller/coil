;;; Written by the languages of coil-stogir-declarative from blocks.pass.
(module declarative.a64.blocks)
(import "coil.arraylist" :use [ArrayList])
(import "declarative.rt.graph" :as graph)
(import "declarative.rt.lists" :as lists)
(import "declarative.rt.bits" :as bv)
(import "declarative.a64.unit" :as st)
(import "declarative.backend.nodes" :as ir)
(defn at* [(cx (mut st/State)) (p i32) (offset i64)] (-> i32)
  (if (= offset 0) p (ir/add! (mut (.g cx)) ir/T-PTR p (ir/make-const! (mut (.g cx)) ir/T-PTR (cast u64 offset)))))
(defn piece [(cx (mut st/State)) (bytes i64)] (-> i64)
  (if (= bytes 8) (cast i64 ir/T-U64) (if (= bytes 4) (cast i64 ir/T-U32) (if (= bytes 2) (cast i64 ir/T-U16) (cast i64 ir/T-U8)))))
(defn one [(cx (mut st/State)) (c i32) (dst i32) (src i32) (value i32) (offset i64) (width i64)] (-> i32)
  (block :ret (do (let [t (cast i32 (piece (mut cx) width))] (when (!= value 0) (do (return-from :ret (ir/store-node! (mut (.g cx)) (cast u64 0) c (at* (mut cx) dst offset) (if (< width 8) (ir/trunc! (mut (.g cx)) t value) value))))) (let [v (ir/load-node! (mut (.g cx)) t (cast u64 0) c (at* (mut cx) src offset))] (ir/store-node! (mut (.g cx)) (cast u64 0) v (at* (mut cx) dst offset) v))))))
(defn pieces [(cx (mut st/State)) (c i32) (dst i32) (src i32) (value i32) (total i64)] (-> i32)
  (do (let [(mut width) 8] (while (> width total) (do (set! width (/ width 2)))) (let [(mut control) c] (let [(mut done) 0] (while (<= (+ done width) total) (do (set! control (one (mut cx) control dst src value done width)) (set! done (+ done width)))) (when (< done total) (do (set! control (one (mut cx) control dst src value (- total width) width)))) control)))))
(defn call* [(cx (mut st/State)) (c i32) (routine i64) (a i32) (b i32) (bytes i64)] (-> i32)
  (do (when (= routine 0) (do (panic "a copy or fill of this many bytes needs a routine, and the unit was told of none"))) (let [n (ir/call-node! (mut (.g cx)) (cast u64 0) c (ir/extern! (mut (.g cx)) (cast u64 (- routine 1))) 3)] (graph/set-input! (mut (.g cx)) n 2 a) (graph/set-input! (mut (.g cx)) n 3 b) (graph/set-input! (mut (.g cx)) n 4 (ir/make-const! (mut (.g cx)) ir/T-U64 (cast u64 bytes))) n)))
(defn expand [(cx (mut st/State)) (n i32)] (-> void)
  (do (do (let [bytes (cast i64 (graph/payload (.g cx) n))] (let [(mut control) (graph/input (.g cx) n 0)] (if (= (graph/op (.g cx) n) ir/COPY) (do (if (> bytes (.inline-bytes cx)) (do (set! control (call* (mut cx) control (.copy-routine cx) (graph/input (.g cx) n 1) (graph/input (.g cx) n 2) bytes))) (when (!= (graph/input (.g cx) n 1) (graph/input (.g cx) n 2)) (do (set! control (pieces (mut cx) control (graph/input (.g cx) n 1) (graph/input (.g cx) n 2) 0 bytes)))))) (do (let [wide (ir/zext! (mut (.g cx)) ir/T-U64 (graph/input (.g cx) n 2))] (if (> bytes (.inline-bytes cx)) (do (set! control (call* (mut cx) control (.fill-routine cx) (graph/input (.g cx) n 1) wide bytes))) (do (let [every (ir/mul! (mut (.g cx)) ir/T-U64 wide (ir/make-const! (mut (.g cx)) ir/T-U64 (cast u64 72340172838076673)))] (set! control (pieces (mut cx) control (graph/input (.g cx) n 1) 0 every bytes)))))))) (st/grow-nodes! (mut cx)) (graph/replace-uses! (mut (.g cx)) n control) (graph/drop! (mut (.g cx)) n)))) (do)))
(defn run [(cx (mut st/State))] (-> void)
  (do (do (when (= (.inline-bytes cx) 0) (do (set! (.inline-bytes cx) 128))) (for i*1 (range 1 (graph/size (.g cx))) (let [n (cast i32 i*1)] (do (when (and (not (graph/dead? (.g cx) n)) (or (= (graph/op (.g cx) n) ir/COPY) (= (graph/op (.g cx) n) ir/FILL))) (do (expand (mut cx) n))))))) (do)))

