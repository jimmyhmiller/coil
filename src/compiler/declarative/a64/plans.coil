(module declarative.a64.plans)
(import "declarative.a64.unit" :as st)
(import "declarative.a64.atomics" :as m0)
(import "declarative.a64.blocks" :as m1)
(import "declarative.a64.cfg" :as m2)
(import "declarative.a64.schedule" :as m3)
(import "declarative.a64.select" :as m4)
(import "declarative.a64.alloc" :as m5)
(import "declarative.a64.emit" :as m6)
(import "declarative.a64.split" :as m7)
(import "declarative.a64.promote" :as m8)
(import "declarative.a64.forward" :as m9)
(import "declarative.a64.simplify" :as m10)
(import "declarative.a64.facts" :as m11)
(import "declarative.a64.narrow" :as m12)
(defn quick [(cx (mut st/State))] (-> void) (do (m0/run (mut cx)) (m1/run (mut cx)) (m2/build (mut cx)) (m3/build (mut cx)) (m4/run (mut cx)) (m5/run (mut cx)) (m6/run (mut cx)) (do)))
(defn default [(cx (mut st/State))] (-> void) (do (m0/run (mut cx)) (m1/run (mut cx)) (m7/run (mut cx)) (m2/build (mut cx)) (m8/run (mut cx)) (m9/run (mut cx)) (st/begin! (mut cx)) (let [(mut changed*) 1] (while (> changed* 0) (set! changed* 0) (set! changed* (+ changed* (m10/run (mut cx)))))) (m11/solve (mut cx)) (let [(mut changed*) 1] (while (> changed* 0) (set! changed* 0) (set! changed* (+ changed* (m12/run (mut cx)))) (set! changed* (+ changed* (m10/run (mut cx)))))) (quick (mut cx)) (do)))

