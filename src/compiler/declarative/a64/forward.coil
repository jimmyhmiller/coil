(defn written [(cx (mut st/State)) (address i32) (bytes i64)] (-> void)
  (do (do (let [(mut kept) 0] (for i (range 0 (len (.at cx))) (do (when (apart? (mut cx) address bytes (get (.at cx) i) (get (.as cx) i)) (do (set! (mut (.at cx)) kept (get (.at cx) i)) (set! (mut (.as cx)) kept (get (.as cx) i)) (set! kept (+ kept 1)))))) (while (> (len (.at cx)) kept) (do (let [v* (get (.at cx) (- (len (.at cx)) 1))] (pop! (mut (.at cx))) v*) (let [v* (get (.as cx) (- (len (.as cx)) 1))] (pop! (mut (.as cx))) v*))))) (do)))
(defn replace [(cx (mut st/State)) (l i32) (v i32)] (-> void)
  (do (do (let [(mut users) (ArrayList::new [i32] (.alc cx))] (let [(mut slots) (ArrayList::new [i64] (.alc cx))] (let [(mut i*2) (graph/first-use (.g cx) l)] (while (>= i*2 0) (let [e i*2 e*3 (graph/next-use (.g cx) i*2)] (do (push! (mut users) (graph/user (.g cx) e)) (push! (mut slots) (graph/slot (.g cx) e))) (set! i*2 e*3)))) (for i (range 0 (len users)) (do (let [u (get users i)] (let [k (get slots i)] (if (or (or (= (graph/op (.g cx) u) ir/REGION) (= (graph/op (.g cx) u) ir/LOOP)) (and (= k 0) (cfg/control? (mut cx) u))) (do (graph/set-input! (mut (.g cx)) u k (graph/input (.g cx) l 0))) (do (graph/set-input! (mut (.g cx)) u k v))))))) (graph/drop! (mut (.g cx)) l) (set! (.forwarded cx) (+ (.forwarded cx) 1))))) (do)))
(defn walk [(cx (mut st/State)) (b i32)] (-> void)
  (do (do (clear! (mut (.at cx))) (clear! (mut (.as cx))) (when (and (= (lists/count (.preds cx) b) 1) (!= (lists/nth (.preds cx) b 0) b)) (do (let [p (lists/nth (.preds cx) b 0)] (for i (range 0 (lists/count (.known-at cx) p)) (do (push! (mut (.at cx)) (lists/nth (.known-at cx) p i)) (push! (mut (.as cx)) (lists/nth (.known-as cx) p i))))))) (let [(mut c) (cfg/follower (mut cx) (get (.head cx) (cast i64 b)))] (while (and (!= c 0) (cfg/chain? (mut cx) c)) (do (let [next (cfg/follower (mut cx) c)] (if (and (= (graph/op (.g cx) c) ir/LOAD) (= (graph/payload (.g cx) c) 0)) (do (let [(mut found) (: 0 i32)] (for i (range 0 (len (.at cx))) (do (when (and (= (get (.at cx) i) (graph/input (.g cx) c 1)) (= (graph/ty (.g cx) (get (.as cx) i)) (graph/ty (.g cx) c))) (do (set! found (get (.as cx) i)))))) (if (!= found 0) (do (replace (mut cx) c found)) (when (< (len (.at cx)) 24) (do (push! (mut (.at cx)) (graph/input (.g cx) c 1)) (push! (mut (.as cx)) c)))))) (if (= (graph/op (.g cx) c) ir/STORE) (do (written (mut cx) (graph/input (.g cx) c 1) (/ (+ (ir/type-bits (graph/ty (.g cx) (graph/input (.g cx) c 2))) 7) 8)) (when (and (= (graph/payload (.g cx) c) 0) (< (len (.at cx)) 24)) (do (push! (mut (.at cx)) (graph/input (.g cx) c 1)) (push! (mut (.as cx)) (graph/input (.g cx) c 2))))) (when (or (clobbers? (mut cx) c) (= (graph/op (.g cx) c) ir/LOAD)) (do (clear! (mut (.at cx))) (clear! (mut (.as cx))))))) (set! c next)))) (for i (range 0 (len (.at cx))) (do (lists/push! (mut (.known-at cx)) b (get (.at cx) i)) (lists/push! (mut (.known-as cx)) b (get (.as cx) i)))))) (do)))
(defn run [(cx (mut st/State))] (-> void)
