(defn unread? [(cx (mut st/State)) (l i32)] (-> bool)
  (let [(mut acc*9) true] (let [(mut i*11) (graph/first-use (.g cx) l)] (while (>= i*11 0) (let [e i*11 e*12 (graph/next-use (.g cx) i*11)] (unless (or (or (= (graph/op (.g cx) (graph/user (.g cx) e)) ir/REGION) (= (graph/op (.g cx) (graph/user (.g cx) e)) ir/LOOP)) (and (= (graph/slot (.g cx) e) 0) (cfg/control? (mut cx) (graph/user (.g cx) e)))) (set! acc*9 false)) (set! i*11 e*12)))) acc*9))
(defn prune [(cx (mut st/State))] (-> i64)
