;;; A list for every key, in one pool: what a list-valued column is stored as.
;;; Pushing is a few stores and no key's list is ever moved or reallocated.
(module declarative.rt.lists)
(import "coil.alloc" :use [Allocator])
(import "coil.arraylist" :use [ArrayList])

(defstruct Lists
  [(head (ArrayList i32))
   (tail (ArrayList i32))
   (count (ArrayList i32))
   (next (ArrayList i32))
   (value (ArrayList i32))])

(defn create [(a (dyn Allocator))] (-> Lists)
  (Lists
    :head (ArrayList::new [i32] a)
    :tail (ArrayList::new [i32] a)
    :count (ArrayList::new [i32] a)
    :next (ArrayList::new [i32] a)
    :value (ArrayList::new [i32] a)))

;;; Empty every list and forget every key.
(defn clear! [(l (mut Lists))] (-> void)
  (clear! (mut (.head l)))
  (clear! (mut (.tail l)))
  (clear! (mut (.count l)))
  (clear! (mut (.next l)))
  (clear! (mut (.value l))))

;;; One more key, with an empty list.
(defn add-key! [(l (mut Lists))] (-> void)
  (push! (mut (.head l)) -1)
  (push! (mut (.tail l)) -1)
  (push! (mut (.count l)) 0))

(defn push! [(l (mut Lists)) (key i32) (v i32)] (-> void)
  (let [cell (cast i32 (len (.value l)))
        k (cast i64 key)
        last (get (.tail l) k)]
    (push! (mut (.value l)) v)
    (push! (mut (.next l)) -1)
    (if (< last 0)
        (set! (mut (.head l)) k cell)
        (set! (mut (.next l)) (cast i64 last) cell))
    (set! (mut (.tail l)) k cell)
    (set! (mut (.count l)) k (+ (get (.count l) k) 1))))

(defn count [(l Lists) (key i32)] (-> i64) :inline (Always)
  (cast i64 (get (.count l) (cast i64 key))))

;;; The first cell of a key's list, or -1; `after` gives the next, `at` its value.
(defn first [(l Lists) (key i32)] (-> i32) :inline (Always)
  (get (.head l) (cast i64 key)))

(defn after [(l Lists) (cell i32)] (-> i32) :inline (Always)
  (get (.next l) (cast i64 cell)))

(defn at [(l Lists) (cell i32)] (-> i32) :inline (Always)
  (get (.value l) (cast i64 cell)))

;;; The i-th value of a key's list, found by walking it.
(defn nth [(l Lists) (key i32) (i i64)] (-> i32)
  (let [(mut cell) (first l key)]
    (for _ (range 0 i) (set! cell (after l cell)))
    (at l cell)))

(defn set-nth! [(l (mut Lists)) (key i32) (i i64) (v i32)] (-> void)
  (let [(mut cell) (first l key)]
    (for _ (range 0 i) (set! cell (after l cell)))
    (set! (mut (.value l)) (cast i64 cell) v)))

(defn clear-key! [(l (mut Lists)) (key i32)] (-> void)
  (let [k (cast i64 key)]
    (set! (mut (.head l)) k -1)
    (set! (mut (.tail l)) k -1)
    (set! (mut (.count l)) k 0)))
