;;; A list for every key, in one pool: what a list-valued column is stored as.
;;; Pushing is a few stores and no key's list is ever moved or reallocated.
;;; `head`, `tail` and `next` hold a cell's number plus one, so that an empty
;;; list is all zeros and keys are added a run at a time.
(module declarative.rt.lists)
(import "coil.alloc" :use [Allocator])
(import "coil.arraylist" :use [ArrayList])
(import "coil.primitive" :as primitive)

;;; `v` added to the end of a list of plain values: room made by doubling, as
;;; `push!` does, the rest written in place.
(defn add! :inline (Always) [T] [(l (mut (ArrayList T))) (v T)] (-> void)
  (let [n (load (field l len))]
    (when (>= n (load (field l cap)))
      (reserve! (mut l) (if (< (load (field l cap)) 8) 8 (* (load (field l cap)) 2))))
    (primitive/store! (primitive/index (load (field l data)) n) v)
    (primitive/store! (field l len) (+ n 1))))

;;; The last of a non-empty list of plain values, taken off it.
(defn take-last! :inline (Always) [T] [(l (mut (ArrayList T)))] (-> T)
  (let [n (- (load (field l len)) 1)]
    (primitive/store! (field l len) n)
    (load (primitive/index (load (field l data)) n))))

;;; A list of plain values (numbers, flags, entities) emptied: nothing in it
;;; needs dropping, so only its length changes, where `clear!` would drop each
;;; element in turn.
(defn empty! :inline (Always) [T] [(l (mut (ArrayList T)))] (-> void)
  (primitive/store! (field l len) 0))

(defstruct Lists
  [(head (ArrayList i32))
   (tail (ArrayList i32))
   (count (ArrayList i32))
   (next (ArrayList i32))
   (value (ArrayList i32))])

(defn create [(a (dyn Allocator))] (-> Lists)
  (Lists
    :head (ArrayList::new [i32] a)
    :tail (ArrayList::new [i32] a)
    :count (ArrayList::new [i32] a)
    :next (ArrayList::new [i32] a)
    :value (ArrayList::new [i32] a)))

;;; Empty every list and forget every key.
(defn clear! [(l (mut Lists))] (-> void)
  (clear! (mut (.head l)))
  (clear! (mut (.tail l)))
  (clear! (mut (.count l)))
  (clear! (mut (.next l)))
  (clear! (mut (.value l))))

;;; One more key, with an empty list.
(defn add-key! [(l (mut Lists))] (-> void)
  (push! (mut (.head l)) 0)
  (push! (mut (.tail l)) 0)
  (push! (mut (.count l)) 0))

;;; Keys up to `n`, the new ones with empty lists.
(defn keys! [(l (mut Lists)) (n i64)] (-> void)
  (let [have (len (.head l))]
    (when (< have n)
      (extend-zeroed! (mut (.head l)) (- n have))
      (extend-zeroed! (mut (.tail l)) (- n have))
      (extend-zeroed! (mut (.count l)) (- n have)))))

(defn push! [(l (mut Lists)) (key i32) (v i32)] (-> void)
  (let [cell (cast i32 (len (.value l)))
        k (cast i64 key)
        last (get (.tail l) k)]
    (push! (mut (.value l)) v)
    (push! (mut (.next l)) 0)
    (if (= last 0)
        (set! (mut (.head l)) k (+ cell 1))
        (set! (mut (.next l)) (cast i64 (- last 1)) (+ cell 1)))
    (set! (mut (.tail l)) k (+ cell 1))
    (set! (mut (.count l)) k (+ (get (.count l) k) 1))))

(defn count :inline (Always) [(l Lists) (key i32)] (-> i64)
  (cast i64 (get (.count l) (cast i64 key))))

;;; The first cell of a key's list, or -1; `after` gives the next, `at` its value.
(defn first :inline (Always) [(l Lists) (key i32)] (-> i32)
  (- (get (.head l) (cast i64 key)) 1))

(defn after :inline (Always) [(l Lists) (cell i32)] (-> i32)
  (- (get (.next l) (cast i64 cell)) 1))

(defn at :inline (Always) [(l Lists) (cell i32)] (-> i32)
  (get (.value l) (cast i64 cell)))

;;; The i-th value of a key's list, found by walking it.
(defn nth [(l Lists) (key i32) (i i64)] (-> i32)
  (let [(mut cell) (first l key)]
    (for _ (range 0 i) (set! cell (after l cell)))
    (at l cell)))

(defn set-nth! [(l (mut Lists)) (key i32) (i i64) (v i32)] (-> void)
  (let [(mut cell) (first l key)]
    (for _ (range 0 i) (set! cell (after l cell)))
    (set! (mut (.value l)) (cast i64 cell) v)))

(defn clear-key! [(l (mut Lists)) (key i32)] (-> void)
  (let [k (cast i64 key)]
    (set! (mut (.head l)) k 0)
    (set! (mut (.tail l)) k 0)
    (set! (mut (.count l)) k 0)))
