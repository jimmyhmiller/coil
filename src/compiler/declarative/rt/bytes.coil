;;; Bytes appended to a buffer, little end first.
(module declarative.rt.bytes)
(import "coil.primitive" :as primitive)
(import "coil.arraylist" :use [ArrayList])

(defn u8! [(out (mut (ArrayList u8))) (v i64)] (-> void)
  (push! (mut out) (primitive/cast u8 (& v 255))))

(defn u16! [(out (mut (ArrayList u8))) (v i64)] (-> void)
  (u8! (mut out) v)
  (u8! (mut out) (>> v 8)))

(defn u32! [(out (mut (ArrayList u8))) (v i64)] (-> void)
  (u16! (mut out) v)
  (u16! (mut out) (>> v 16)))

(defn u64! [(out (mut (ArrayList u8))) (v i64)] (-> void)
  (u32! (mut out) v)
  (u32! (mut out) (>> v 32)))

;;; The bytes of `s`, then zeros up to `pad` bytes in all.
(defn text! [(out (mut (ArrayList u8))) (s (slice u8)) (pad i64)] (-> void)
  (for ch s (push! (mut out) ch))
  (for _ (range (len s) pad) (push! (mut out) (: 0 u8))))

;;; Zeros until the buffer's length is a multiple of `n`.
(defn align! [(out (mut (ArrayList u8))) (n i64)] (-> void)
  (while (!= (% (len out) n) 0) (push! (mut out) (: 0 u8))))
