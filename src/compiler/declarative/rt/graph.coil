;;; A sea of nodes, as storage: nodes with an operation, a type, a payload and
;;; ordered inputs, and the uses of every node kept as each edge is written.
;;; It names no operation. A node set written in `.ir` gives the numbers meaning.
;;;
;;; `addresses` is for whoever runs the graph without linking it: the address
;;; of each symbol a node names by number.
;;;
;;; A node is a positive i32; 0 is "no node". An edge is an input slot: edge e of
;;; user U refers to definition D. The uses of D are a doubly linked list threaded
;;; through its edges, so writing or clearing an input costs the same few stores
;;; whether or not anything reads the uses afterwards.
(module declarative.rt.graph)
(import "coil.primitive" :as primitive)
(import "coil.alloc" :use [Allocator])
(import "coil.arraylist" :use [ArrayList])

;;; What a node is to the graph's structure. A `.ir` file gives each node a role;
;;; a node with ROLE-PURE is a value computed from its inputs alone.
(const ROLE-PURE 0)
(const ROLE-START 1)
(const ROLE-RETURN 2)
(const ROLE-REGION 3)
(const ROLE-LOOP 4)
(const ROLE-IF 5)
(const ROLE-TRUE 6)
(const ROLE-FALSE 7)
(const ROLE-PHI 8)
(const ROLE-PARAM 9)
(const ROLE-CONST 10)
(const ROLE-CALL 11)
(const ROLE-RESULT 12)
(const ROLE-LOAD 13)
(const ROLE-STORE 14)
(const ROLE-OBJECT 15)
(const ROLE-SYMBOL 16)
(const ROLE-EXTERN 17)
(const ROLE-TRAP 18)
(const ROLE-SWITCH 19)
(const ROLE-CASE 20)
(const ROLE-DEFAULT 21)
(const ROLE-TAILCALL 22)
(const ROLE-UPDATE 23)
(const ROLE-BARRIER 24)
(const ROLE-RESERVE 25)
(const ROLE-COPY 26)
(const ROLE-FILL 27)

(defstruct Graph
  [(ops (ArrayList u16))
   (tys (ArrayList u8))
   (payload (ArrayList u64))
   (first-in (ArrayList i32))
   (n-in (ArrayList i32))
   (edges (ArrayList i32))
   (edge-user (ArrayList i32))
   (use-next (ArrayList i32))
   (use-prev (ArrayList i32))
   (use-head (ArrayList i32))
   (use-count (ArrayList i32))
   (table (ArrayList i32))
   (interned i64)
   (start i32)
   (addresses (ArrayList u64))
   (signature (ArrayList i32))
   (passing (ArrayList u64))
   (shapes (ArrayList u64))
   (shape-at (ArrayList i32))
   (pins (ArrayList u64))
   (code (ArrayList u8))
   (quiet (ArrayList u64))
   (alc (dyn Allocator))])

(defn create [(a (dyn Allocator))] (-> Graph)
  (let [(mut g) (Graph
                  :ops (ArrayList::new [u16] a)
                  :tys (ArrayList::new [u8] a)
                  :payload (ArrayList::new [u64] a)
                  :first-in (ArrayList::new [i32] a)
                  :n-in (ArrayList::new [i32] a)
                  :edges (ArrayList::new [i32] a)
                  :edge-user (ArrayList::new [i32] a)
                  :use-next (ArrayList::new [i32] a)
                  :use-prev (ArrayList::new [i32] a)
                  :use-head (ArrayList::new [i32] a)
                  :use-count (ArrayList::new [i32] a)
                  :table (ArrayList::new [i32] a)
                  :interned 0
                  :start 0
                  :addresses (ArrayList::new [u64] a)
                  :signature (ArrayList::new [i32] a)
                  :passing (ArrayList::new [u64] a)
                  :shapes (ArrayList::new [u64] a)
                  :shape-at (ArrayList::new [i32] a)
                  :pins (ArrayList::new [u64] a)
                  :code (ArrayList::new [u8] a)
                  :quiet (ArrayList::new [u64] a)
                  :alc a)]
    ; Node 0 is "no node".
    (push! (mut (.ops g)) 0)
    (push! (mut (.tys g)) 0)
    (push! (mut (.payload g)) 0)
    (push! (mut (.first-in g)) 0)
    (push! (mut (.n-in g)) 0)
    (push! (mut (.use-head g)) -1)
    (push! (mut (.use-count g)) 0)
    (for _ (range 0 1024) (push! (mut (.table g)) 0))
    g))

(defn release! [(g (mut Graph))] (-> void)
  (free! (mut (.ops g)))
  (free! (mut (.tys g)))
  (free! (mut (.payload g)))
  (free! (mut (.first-in g)))
  (free! (mut (.n-in g)))
  (free! (mut (.edges g)))
  (free! (mut (.edge-user g)))
  (free! (mut (.use-next g)))
  (free! (mut (.use-prev g)))
  (free! (mut (.use-head g)))
  (free! (mut (.use-count g)))
  (free! (mut (.table g)))
  (free! (mut (.quiet g)))
  (free! (mut (.addresses g)))
  (free! (mut (.signature g)))
  (free! (mut (.passing g)))
  (free! (mut (.shapes g)))
  (free! (mut (.shape-at g)))
  (free! (mut (.pins g)))
  (free! (mut (.code g))))

;;; One past the largest node: the size of a column over nodes.
(defn size [(g Graph)] (-> i64)
  (len (.ops g)))

(defn op [(g Graph) (n i32)] (-> i32) :inline (Always)
  (cast i32 (get (.ops g) (cast i64 n))))

(defn ty [(g Graph) (n i32)] (-> i32) :inline (Always)
  (cast i32 (get (.tys g) (cast i64 n))))

(defn payload [(g Graph) (n i32)] (-> u64) :inline (Always)
  (get (.payload g) (cast i64 n)))

(defn arity [(g Graph) (n i32)] (-> i64) :inline (Always)
  (cast i64 (get (.n-in g) (cast i64 n))))

(defn input [(g Graph) (n i32) (i i64)] (-> i32) :inline (Always)
  (get (.edges g) (+ (cast i64 (get (.first-in g) (cast i64 n))) i)))

(defn use-count [(g Graph) (n i32)] (-> i64) :inline (Always)
  (cast i64 (get (.use-count g) (cast i64 n))))

(defn dead? [(g Graph) (n i32)] (-> bool) :inline (Always)
  (= (get (.ops g) (cast i64 n)) 0))

;;; The first edge that uses `n`, or -1. Walk with `next-use`; `user` and
;;; `slot` say whose input an edge is.
(defn first-use [(g Graph) (n i32)] (-> i32) :inline (Always)
  (get (.use-head g) (cast i64 n)))

(defn next-use [(g Graph) (e i32)] (-> i32) :inline (Always)
  (get (.use-next g) (cast i64 e)))

(defn user [(g Graph) (e i32)] (-> i32) :inline (Always)
  (get (.edge-user g) (cast i64 e)))

(defn slot [(g Graph) (e i32)] (-> i64) :inline (Always)
  (- (cast i64 e) (cast i64 (get (.first-in g) (cast i64 (get (.edge-user g) (cast i64 e)))))))

(defn unlink! [(g (mut Graph)) (e i64)] (-> void)
  (let [d (get (.edges g) e)]
    (when (!= d 0)
      (let [next (get (.use-next g) e)
            prev (get (.use-prev g) e)]
        (if (< prev 0)
            (set! (mut (.use-head g)) (cast i64 d) next)
            (set! (mut (.use-next g)) (cast i64 prev) next))
        (when (>= next 0) (set! (mut (.use-prev g)) (cast i64 next) prev))
        (set! (mut (.use-count g)) (cast i64 d) (- (get (.use-count g) (cast i64 d)) 1))
        (set! (mut (.edges g)) e 0)))))

(defn link! [(g (mut Graph)) (e i64) (d i32)] (-> void)
  (when (!= d 0)
    (let [head (get (.use-head g) (cast i64 d))]
      (set! (mut (.edges g)) e d)
      (set! (mut (.use-next g)) e head)
      (set! (mut (.use-prev g)) e -1)
      (when (>= head 0) (set! (mut (.use-prev g)) (cast i64 head) (cast i32 e)))
      (set! (mut (.use-head g)) (cast i64 d) (cast i32 e))
      (set! (mut (.use-count g)) (cast i64 d) (+ (get (.use-count g) (cast i64 d)) 1)))))

;;; A new node with `count` empty inputs.
(defn node! [(g (mut Graph)) (operation i32) (type i32) (data u64) (count i64)] (-> i32)
  (let [n (cast i32 (len (.ops g)))
        first (len (.edges g))]
    (push! (mut (.ops g)) (cast u16 operation))
    (push! (mut (.tys g)) (cast u8 type))
    (push! (mut (.payload g)) data)
    (push! (mut (.first-in g)) (cast i32 first))
    (push! (mut (.n-in g)) (cast i32 count))
    (push! (mut (.use-head g)) -1)
    (push! (mut (.use-count g)) 0)
    (for _ (range 0 count)
      (push! (mut (.edges g)) 0)
      (push! (mut (.edge-user g)) n)
      (push! (mut (.use-next g)) -1)
      (push! (mut (.use-prev g)) -1))
    n))

(defn set-input! [(g (mut Graph)) (n i32) (i i64) (d i32)] (-> void)
  (let [e (+ (cast i64 (get (.first-in g) (cast i64 n))) i)]
    (unlink! (mut g) e)
    (link! (mut g) e d)))

;;; Every use of `old` becomes a use of `new`.
(defn replace-uses! [(g (mut Graph)) (old i32) (new i32)] (-> void)
  (let [(mut e) (get (.use-head g) (cast i64 old))]
    (while (>= e 0)
      (let [next (get (.use-next g) (cast i64 e))]
        (unlink! (mut g) (cast i64 e))
        (link! (mut g) (cast i64 e) new)
        (set! e next)))))

;;; Remove `n`, which nothing uses, and then each input it was the last use of,
;;; if `pure` (indexed by operation) says that input is a value of its inputs
;;; alone. Returns how many nodes went.
(defn kill! [(g (mut Graph)) (n i32) (pure (slice bool))] (-> i64)
  (let [(mut stack) (ArrayList::new [i32] (.alc g))
        (mut killed) 0]
    (push! (mut stack) n)
    (while (> (len stack) 0)
      (let [x (get stack (- (len stack) 1))]
        (pop! (mut stack))
        (when (and (not (dead? g x)) (= (use-count g x) 0))
          (let [first (cast i64 (get (.first-in g) (cast i64 x)))]
            (for i (range 0 (arity g x))
              (let [d (get (.edges g) (+ first i))]
                (when (!= d 0)
                  (unlink! (mut g) (+ first i))
                  (when (and (= (use-count g d) 0) (get pure (cast i64 (op g d))))
                    (push! (mut stack) d))))))
          (set! (mut (.ops g)) (cast i64 x) 0)
          (set! killed (+ killed 1)))))
    (free! (mut stack))
    killed))

;; ---------------------------------------------------------------- value numbering

(defn mix [(h u64) (v u64)] (-> u64) :inline (Always)
  (let [x (primitive/imul (^ h v) (: 0x9E3779B97F4A7C15 u64))]
    (^ x (>> x 29))))

(defn hash-node [(operation i32) (type i32) (data u64) (a i32) (b i32) (c i32)] (-> u64)
  (mix (mix (mix (mix (mix (cast u64 operation) (cast u64 type)) data) (cast u64 a))
            (cast u64 b))
       (cast u64 c)))

(defn same? [(g Graph) (n i32) (operation i32) (type i32) (data u64) (count i64)
             (a i32) (b i32) (c i32)] (-> bool)
  (and (= (op g n) operation)
       (= (ty g n) type)
       (= (payload g n) data)
       (= (arity g n) count)
       (or (< count 1) (= (input g n 0) a))
       (or (< count 2) (= (input g n 1) b))
       (or (< count 3) (= (input g n 2) c))))

(defn grow-table! [(g (mut Graph))] (-> void)
  (let [old (len (.table g))
        (mut bigger) (ArrayList::new [i32] (.alc g))
        mask (cast u64 (- (* old 2) 1))]
    (for _ (range 0 (* old 2)) (push! (mut bigger) 0))
    (for n (.table g)
      (when (and (!= n 0) (not (dead? g n)))
        (let [k (arity g n)
              h (hash-node (op g n) (ty g n) (payload g n)
                           (if (> k 0) (input g n 0) 0)
                           (if (> k 1) (input g n 1) 0)
                           (if (> k 2) (input g n 2) 0))
              (mut at) (cast i64 (& h mask))]
          (while (!= (get bigger at) 0) (set! at (cast i64 (& (cast u64 (+ at 1)) mask))))
          (set! (mut bigger) at n))))
    (free! (mut (.table g)))
    (set! (.table g) bigger)))

;;; The node with this operation, type, payload and up to three inputs: the one
;;; already in the graph, or a new one. Only for nodes that are values of their
;;; inputs alone. An entry whose node was since changed no longer matches and is
;;; passed over, so a stale table loses sharing and never correctness.
(defn intern! [(g (mut Graph)) (operation i32) (type i32) (data u64) (count i64)
               (a i32) (b i32) (c i32)] (-> i32)
  (when (> (* (.interned g) 2) (len (.table g))) (grow-table! (mut g)))
  (let [mask (cast u64 (- (len (.table g)) 1))
        (mut at) (cast i64 (& (hash-node operation type data a b c) mask))
        (mut found) (: 0 i32)]
    (while (and (= found 0) (!= (get (.table g) at) 0))
      (let [n (get (.table g) at)]
        (if (same? g n operation type data count a b c)
            (set! found n)
            (set! at (cast i64 (& (cast u64 (+ at 1)) mask))))))
    (when (= found 0)
      (let [n (node! (mut g) operation type data count)]
        (when (> count 0) (set-input! (mut g) n 0 a))
        (when (> count 1) (set-input! (mut g) n 1 b))
        (when (> count 2) (set-input! (mut g) n 2 c))
        (set! (mut (.table g)) at n)
        (set! (.interned g) (+ (.interned g) 1))
        (set! found n)))
    found))

;;; A node that is the same as `n` in operation, type, payload and inputs and is
;;; not `n`, or 0. If there is none, `n` is now the one later lookups find. For
;;; a node that is a value of its inputs alone, after its inputs changed.
(defn canonical! [(g (mut Graph)) (n i32)] (-> i32)
  (let [count (arity g n)]
    (if (> count 3)
        0
        (do
          (when (> (* (.interned g) 2) (len (.table g))) (grow-table! (mut g)))
          (let [a (if (> count 0) (input g n 0) 0)
                b (if (> count 1) (input g n 1) 0)
                c (if (> count 2) (input g n 2) 0)
                mask (cast u64 (- (len (.table g)) 1))
                (mut at) (cast i64 (& (hash-node (op g n) (ty g n) (payload g n) a b c) mask))
                (mut found) (: 0 i32)
                (mut present) false]
            (while (and (= found 0) (!= (get (.table g) at) 0))
              (let [x (get (.table g) at)]
                (cond (= x n) (set! present true)
                      (and (not (dead? g x)) (same? g x (op g n) (ty g n) (payload g n) count a b c))
                        (set! found x)
                      :else 0)
                (set! at (cast i64 (& (cast u64 (+ at 1)) mask)))))
            (when (and (= found 0) (not present))
              (set! (mut (.table g)) at n)
              (set! (.interned g) (+ (.interned g) 1)))
            found)))))

;;; A new node that is `n` over again: the same operation, type, payload and
;;; inputs. Whoever asks changes some input next; a copy left as it is should
;;; have been `n`.
(defn copy! [(g (mut Graph)) (n i32)] (-> i32)
  (let [count (arity g n)
        c (node! (mut g) (op g n) (ty g n) (payload g n) count)]
    (for i (range 0 count) (set-input! (mut g) c i (input g n i)))
    c))

;;; A call of symbol `symbol` writes no memory the function can read: it only
;;; reads what it is given and answers.
(defn reads-only! [(g (mut Graph)) (symbol u64)] (-> void)
  (unless (reads-only? g symbol) (push! (mut (.quiet g)) symbol)))

(defn reads-only? [(g Graph) (symbol u64)] (-> bool)
  (let [(mut found) false]
    (for s (.quiet g) (when (= s symbol) (set! found true)))
    found))

;;; The function's parameters are these types, in order. Where each arrives
;;; depends on all of them, so a parameter nothing reads still has to be said.
(defn declare-param! [(g (mut Graph)) (index i64) (type i32)] (-> void)
  (while (<= (len (.signature g)) index) (push! (mut (.signature g)) 0))
  (set! (mut (.signature g)) index type))

;;; How an argument is passed, beyond what its type says. The low eight bits
;;; count the arguments after it that must be in registers if it is: the parts
;;; of one thing, which go in registers together or not at all.
(const PASS-WITH (: 255 u64))
;;; The address the function is to write its result to.
(const PASS-INDIRECT (: 256 u64))
;;; Past the parameters a function that takes any number of arguments names.
(const PASS-UNNAMED (: 512 u64))
;;; On the stack, at a multiple of 16.
(const PASS-ALIGN16 (: 1024 u64))

;;; Parameter `index` is passed this way.
(defn declare-passing! [(g (mut Graph)) (index i64) (how u64)] (-> void)
  (while (<= (len (.passing g)) index) (push! (mut (.passing g)) 0))
  (set! (mut (.passing g)) index how))

(defn param-passing [(g Graph) (index i64)] (-> u64)
  (if (< index (len (.passing g))) (get (.passing g) index) (: 0 u64)))

;;; A shape says how each argument of a call is passed, and whether the
;;; function called takes any number of arguments. Shape 0 is the plain one:
;;; every argument by its type alone.
(defn shape! [(g (mut Graph)) (variadic bool)] (-> u64)
  (push! (mut (.shape-at g)) (cast i32 (len (.shapes g))))
  (push! (mut (.shapes g)) (if variadic (: 0x100000000 u64) (: 0 u64)))
  (cast u64 (len (.shape-at g))))

;;; The next argument of `shape` is passed this way.
(defn shape-arg! [(g (mut Graph)) (shape u64) (how u64)] (-> void)
  (when (!= (cast i64 shape) (len (.shape-at g))) (panic "a shape's arguments are said before the next shape is made"))
  (let [at (cast i64 (get (.shape-at g) (- (cast i64 shape) 1)))]
    (set! (mut (.shapes g)) at (+ (get (.shapes g) at) 1))
    (push! (mut (.shapes g)) how)))

(defn shape-passing [(g Graph) (shape i64) (index i64)] (-> u64)
  (if (= shape 0)
      (: 0 u64)
      (let [at (cast i64 (get (.shape-at g) (- shape 1)))
            count (cast i64 (& (get (.shapes g) at) (: 0xFFFFFFFF u64)))]
        (if (< index count) (get (.shapes g) (+ at (+ index 1))) (: 0 u64)))))

(defn shape-variadic? [(g Graph) (shape i64)] (-> bool)
  (and (!= shape 0)
       (!= (& (get (.shapes g) (cast i64 (get (.shape-at g) (- shape 1)))) (: 0x100000000 u64)) 0)))

;;; In the machine register the low eight bits number, whatever the
;;; convention would do: an argument of a call whose shape is pinned.
(const PASS-PINNED (: 2048 u64))

;;; A pinned shape is a call that follows no convention: each argument is in
;;; the register its passing names, the call may write the registers of
;;; `clobbers` and no others, and its one result, if `result` is not negative,
;;; is in that register. With `code`, the call is those bytes of machine code
;;; where it stands, and its target is not called.
(defn shape-pin! [(g (mut Graph)) (shape u64) (clobbers u64) (result i64) (code (slice u8))] (-> void)
  (push! (mut (.pins g)) shape)
  (push! (mut (.pins g)) clobbers)
  (push! (mut (.pins g)) (cast u64 result))
  (push! (mut (.pins g)) (cast u64 (len (.code g))))
  (push! (mut (.pins g)) (cast u64 (len code)))
  (for b code (push! (mut (.code g)) b)))

;;; Where shape `shape`'s pin is in `pins`, or -1 if it is not pinned.
(defn pin-of [(g Graph) (shape i64)] (-> i64)
  (let [(mut found) -1]
    (for i (range 0 (/ (len (.pins g)) 5))
      (when (= (get (.pins g) (* i 5)) (cast u64 shape)) (set! found (* i 5))))
    found))

(defn shape-pinned? [(g Graph) (shape i64)] (-> bool) (and (!= shape 0) (>= (pin-of g shape) 0)))
(defn shape-clobbers [(g Graph) (shape i64)] (-> u64) (get (.pins g) (+ (pin-of g shape) 1)))
(defn shape-result [(g Graph) (shape i64)] (-> i64) (cast i64 (get (.pins g) (+ (pin-of g shape) 2))))
(defn shape-code-bytes [(g Graph) (shape i64)] (-> i64) (cast i64 (get (.pins g) (+ (pin-of g shape) 4))))
(defn shape-code-byte [(g Graph) (shape i64) (i i64)] (-> i64)
  (cast i64 (get (.code g) (+ (cast i64 (get (.pins g) (+ (pin-of g shape) 3))) i))))

(defn param-count [(g Graph)] (-> i64)
  (len (.signature g)))

(defn param-type [(g Graph) (index i64)] (-> i32)
  (get (.signature g) index))

;;; Take input `i` out of `n`: the inputs after it move down one and `n` has
;;; one input fewer.
(defn remove-input! [(g (mut Graph)) (n i32) (i i64)] (-> void)
  (let [count (arity g n)]
    (for j (range i (- count 1)) (set-input! (mut g) n j (input g n (+ j 1))))
    (set-input! (mut g) n (- count 1) 0)
    (set! (mut (.n-in g)) (cast i64 n) (cast i32 (- count 1)))))

;;; Detach `n` from everything it reads and mark it gone. What used it must
;;; already have let go, or be about to go the same way.
(defn drop! [(g (mut Graph)) (n i32)] (-> void)
  (let [first (cast i64 (get (.first-in g) (cast i64 n)))]
    (for i (range 0 (arity g n)) (unlink! (mut g) (+ first i)))
    (set! (mut (.ops g)) (cast i64 n) 0)))
