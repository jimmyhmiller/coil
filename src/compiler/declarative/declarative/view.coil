;;; CIR as the languages read it: the accessors `src/cir/cir.ops` names, over
;;; Coil's own records. Nothing here says what an operation means; that is
;;; `cir.ops`. A value or block is its number, as an i64; -1 is none.
(module declarative.view)
(import "coil.primitive" :as primitive)
(import "native.cir" :as cir)


(defn value :inline (Always) [(f (ptr cir/Func)) (v i64)] (-> (ptr cir/Value))
  (cir/val f (cast u32 v)))

(defn value-count :inline (Always) [(f (ptr cir/Func))] (-> i64) (cast i64 (cir/value-count f)))
(defn block-count :inline (Always) [(f (ptr cir/Func))] (-> i64) (cast i64 (cir/block-count f)))

(defn op :inline (Always) [(f (ptr cir/Func)) (v i64)] (-> i64) (cast i64 (.op (value f v))))
(defn ty :inline (Always) [(f (ptr cir/Func)) (v i64)] (-> i64) (cast i64 (.ty (value f v))))
(defn imm :inline (Always) [(f (ptr cir/Func)) (v i64)] (-> i64) (.imm (value f v)))
(defn imm2 :inline (Always) [(f (ptr cir/Func)) (v i64)] (-> i64) (.imm2 (value f v)))
(defn aux :inline (Always) [(f (ptr cir/Func)) (v i64)] (-> i64) (cast i64 (.aux (value f v))))

;;; How many value operands it has; its blocks follow them.
(defn nops :inline (Always) [(f (ptr cir/Func)) (v i64)] (-> i64) (cast i64 (.nops (value f v))))

(defn operand :inline (Always) [(f (ptr cir/Func)) (v i64) (i i64)] (-> i64)
  (cast i64 (get (.operands f) (+ (cast i64 (.opb (value f v))) i))))

;;; Flags of value operand `i` (of a call: how the argument is passed).
(defn operand-flags :inline (Always) [(f (ptr cir/Func)) (v i64) (i i64)] (-> i64)
  (cast i64 (get (.argflags f) (+ (cast i64 (.opb (value f v))) i))))

;;; The `k`-th block a branch names.
(defn target :inline (Always) [(f (ptr cir/Func)) (v i64) (k i64)] (-> i64)
  (operand f v (+ (nops f v) k)))

(defn targets :inline (Always) [(f (ptr cir/Func)) (v i64)] (-> i64)
  (- (cast i64 (.ntotal (value f v))) (nops f v)))

;;; A block's instructions are `inst` of first..end; the last leaves it.
(defn block-first :inline (Always) [(f (ptr cir/Func)) (b i64)] (-> i64) (cast i64 (.ibegin (cir/blk f (cast u32 b)))))
(defn block-end :inline (Always) [(f (ptr cir/Func)) (b i64)] (-> i64) (cast i64 (.iend (cir/blk f (cast u32 b)))))
(defn inst :inline (Always) [(f (ptr cir/Func)) (k i64)] (-> i64) (cast i64 (get (.insts f) k)))
(defn term :inline (Always) [(f (ptr cir/Func)) (b i64)] (-> i64) (cast i64 (.term (cir/blk f (cast u32 b)))))

(defn phi-count :inline (Always) [(f (ptr cir/Func)) (b i64)] (-> i64) (cast i64 (.phi-count (cir/blk f (cast u32 b)))))
(defn phi :inline (Always) [(f (ptr cir/Func)) (b i64) (i i64)] (-> i64)
  (cast i64 (get (.phis f) (+ (cast i64 (.phi-begin (cir/blk f (cast u32 b)))) i))))

;;; A call that follows no convention (SHIMCALL): the machine register its
;;; operand `i` is put in, and the bytes of machine code it is, if it is that
;;; rather than a call of a symbol.
(defn pinned-register :inline (Always) [(f (ptr cir/Func)) (v i64) (i i64)] (-> i64)
  (operand-flags f v i))
(defn inline-count :inline (Always) [(f (ptr cir/Func)) (v i64)] (-> i64)
  (cast i64 (.next (value f v))))
(defn inline-byte :inline (Always) [(f (ptr cir/Func)) (v i64) (k i64)] (-> i64)
  (cast i64 (get (.bytes f) (+ (cast i64 (.block (value f v))) k))))

;;; The value phi `p` takes when control comes from block `from`.
(defn incoming [(f (ptr cir/Func)) (p i64) (from i64)] (-> i64)
  (let [n (nops f p)
        (mut found) -1]
    (for k (range 0 n) (when (and (< found 0) (= (operand f p (+ n k)) from)) (set! found (operand f p k))))
    (when (< found 0) (panic "a phi has no value for a block that reaches it"))
    found))

;;; A switch's case values: as many as its targets after the default.
(defn case-count [(f (ptr cir/Func)) (v i64)] (-> i64) (- (targets f v) 1))
(defn case-value [(f (ptr cir/Func)) (v i64) (k i64)] (-> u64)
  (get (.case-values f) (+ (imm f v) k)))

;;; Whether the function's frame can be reached from outside it (an address
;;; of a stack variable escaped), and whether it calls anything.
(defn frame-escapes? [(f (ptr cir/Func))] (-> bool) (.frame-escapes f))
(defn calls? [(f (ptr cir/Func))] (-> bool) (.has-calls f))
(defn name [(f (ptr cir/Func))] (-> (slice u8)) (.name f))

;;; The function's parameters: how many, and each one's value.
(defn arg-count [(f (ptr cir/Func))] (-> i64) (len (.args f)))
(defn arg [(f (ptr cir/Func)) (i i64)] (-> i64) (cast i64 (get (.args f) i)))
(defn arg-flags [(f (ptr cir/Func)) (i i64)] (-> i64) (cast i64 (get (.arg-flags f) i)))

;;; How an argument or parameter with CIR's `flags` is passed, as rt.graph's
;;; PASS-… bits say it: how many following parts go in registers with it, the
;;; address of the result, past the named parameters, copied onto the stack
;;; (its size in the bits from 32). An integer's size in C, which is how wide
;;; its place on the stack is where those are packed, is in bits 16..18 (log2
;;; of the bytes, plus one; 0 for its own width), and bit 19 says the C type
;;; is signed, so that one read back from the stack is extended as it was.
(defn passing-of [(flags u32) (sret bool)] (-> u64)
  (let [with (cast u64 (& (>> flags (: 16 u32)) (: 255 u32)))
        byval (cir/af-byval? flags)]
    (| with
       (if (or sret (!= (& flags (cast u32 cir/AF-SRET)) (: 0 u32))) (: 256 u64) (: 0 u64))
       (if (!= (& flags (cast u32 cir/AF-VARIADIC)) (: 0 u32)) (: 512 u64) (: 0 u64))
       (if byval (| (: 4096 u64) (<< (cast u64 (cir/af-byval-size flags)) 32)) (: 0 u64))
       (if byval (: 0 u64) (<< (cast u64 (& (>> flags (: 24 u32)) (: 7 u32))) 16))
       (if (and (not byval) (or (cir/af-signed? flags) (!= (& flags (cast u32 cir/AF-SEXT)) (: 0 u32))))
           (: 524288 u64)
           (: 0 u64)))))

(defn arg-passing [(f (ptr cir/Func)) (i i64)] (-> u64)
  (passing-of (get (.arg-flags f) i) (get (.arg-sret f) i)))

(defn operand-passing [(f (ptr cir/Func)) (v i64) (i i64)] (-> u64)
  (passing-of (cast u32 (operand-flags f v i)) false))
