;;; A CIR function as text, block by block: for DECLARATIVE_SHOW, and for a
;;; test to show the function it found wrong.
(module declarative.dump)
(import "native.cir" :as cir)
(import "declarative.cir.ops" :as cops)
(import "declarative.view" :as view)

(defn cir [(f (ptr cir/Func))] (-> void)
  (println "; {} as CIR" (.name f))
  (for k (range 0 (view/arg-count f))
    (println "  arg {}: v{} type {} flags {:x}" k (view/arg f k) (view/ty f (view/arg f k)) (view/arg-flags f k)))
  (for b (range 0 (view/block-count f))
    (println " block {}:" b)
    (for i (range 0 (view/phi-count f b))
      (let [p (view/phi f b i)]
        (print "  v{} = PHI type {}" p (view/ty f p))
        (for k (range 0 (view/nops f p)) (print " v{}<-b{}" (view/operand f p k) (view/operand f p (+ (view/nops f p) k))))
        (println "")))
    (for k (range (view/block-first f b) (view/block-end f b))
      (let [v (view/inst f k)]
        (print "  v{} = {} type {} imm {} imm2 {} aux {}" v (cops/name (view/op f v)) (view/ty f v) (view/imm f v) (view/imm2 f v) (view/aux f v))
        (for i (range 0 (view/nops f v))
          (let [x (view/operand f v i)
                xo (view/op f x)]
            (if (or (= xo cops/CONST) (= xo cops/SYM) (= xo cops/ALLOCA) (= xo cops/ARG))
                (print " v{}({} {})" x (cops/name xo) (view/imm f x))
                (print " v{}" x))))
        (for i (range 0 (view/targets f v)) (print " ->b{}" (view/target f v i)))
        (println "")))))
