;;; Which of the backend's machines a program that carries the adapter is
;;; compiled for.
(module declarative.target)

;;; `a64` in a program compiled for AArch64, `x64` in one compiled for x86-64.
;;; A macro: only the chosen form reaches the program.
(defn machine-pick [(a64 Code) (x64 Code)] (-> Code)
  (match (target-arch)
    (X86_64 [] x64)
    (_ a64)))
