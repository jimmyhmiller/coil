;;; Written by the languages of coil-stogir-declarative from select.pass.
(module declarative.x64.select)
(import "coil.arraylist" :use [ArrayList])
(import "declarative.rt.graph" :as graph)
(import "declarative.rt.lists" :as lists)
(import "declarative.rt.bits" :as bv)
(import "declarative.x64.unit" :as st)
(import "declarative.backend.nodes" :as ir)
(import "declarative.x64.cfg" :as cfg)
(import "declarative.x64.mach" :as mach)
(import "declarative.x64.lower" :as lower)
(import "declarative.x64.target" :as isa)
(import "declarative.x64.abi" :as abi)
(defn choose [(cx (mut st/State)) (n i32)] (-> void)
  (do (do (let [rule (lower/select (mut cx) n)] (when (= rule 0) (do (println "no rule computes {} (node {})" (ir/name (graph/op (.g cx) n)) n) (panic "instruction selection failed"))) (set! (mut (.tile cx)) (cast i64 n) rule) (lower/mark (mut cx) n rule) (when (or (or (or (or (or (= (graph/op (.g cx) n) ir/PHI) (= (graph/op (.g cx) n) ir/CALL)) (= (graph/op (.g cx) n) ir/SWITCH)) (= (graph/op (.g cx) n) ir/TAILCALL)) (= (graph/op (.g cx) n) ir/RETURN)) (= (graph/op (.g cx) n) ir/RESERVE)) (do (for i (range 1 (graph/arity (.g cx) n)) (do (mach/need (mut cx) (graph/input (.g cx) n i)))))))) (do)))
(defn widened [(cx (mut st/State)) (d i64) (n i32)] (-> void)
  (do (do (if (or (ir/type-float? (graph/ty (.g cx) n)) (>= (ir/type-bits (graph/ty (.g cx) n)) 32)) (do (copy (mut cx) d n)) (do (lower/move (mut cx) d (lower/extended (mut cx) n 2))))) (do)))
(defn arrive [(cx (mut st/State)) (n i32) (r i64)] (-> void)
  (do (do (if (ir/type-float? (graph/ty (.g cx) n)) (do (lower/move-float (mut cx) (cast i64 n) r)) (if (= (ir/type-bits (graph/ty (.g cx) n)) 1) (do (lower/zero-extend (mut cx) (cast i64 n) r 1)) (do (lower/move (mut cx) (cast i64 n) r))))) (do)))
(defn begin-placing [(cx (mut st/State))] (-> void)
  (do (do (set! (.ints cx) 0) (set! (.floats cx) 0) (set! (.stack-bytes cx) 0) (set! (.following cx) 0)) (do)))
(defn place [(cx (mut st/State)) (type* i64) (how u64)] (-> i64)
  (block :ret (do (let [with (cast i64 (& how (cast u64 255)))] (when (and (!= (& how (<< (: 1 u64) (cast u64 8))) 0) (>= abi/INDIRECT-RESULT 0)) (do (return-from :ret abi/INDIRECT-RESULT))) (let [float (ir/type-float? (cast i32 type*))] (let [unnamed (!= (& how (<< (: 1 u64) (cast u64 9))) 0)] (if (> (.following cx) 0) (do (set! (.following cx) (- (.following cx) 1))) (when (not (and unnamed abi/VARIADIC-ON-STACK)) (do (when (and float (< (+ (.floats cx) with) abi/FLOAT-ARGS)) (do (set! (.floats cx) (+ (.floats cx) 1)) (return-from :ret (abi/float-arg (- (.floats cx) 1))))) (when (and (not float) (< (+ (.ints cx) with) abi/INT-ARGS)) (do (set! (.ints cx) (+ (.ints cx) 1)) (return-from :ret (abi/int-arg (- (.ints cx) 1))))) (set! (.following cx) with) (when abi/REGISTERS-CLOSE (do (if float (do (set! (.floats cx) abi/FLOAT-ARGS)) (do (set! (.ints cx) abi/INT-ARGS)))))))) (let [bytes (/ (+ (ir/type-bits (cast i32 type*)) 7) 8)] (let [slot (if (and abi/STACK-PACKED (not unnamed)) bytes (let [x* bytes y* 8] (if (> x* y*) x* y*)))] (set! (.placed-bytes cx) (if float bytes slot)) (let [align (if (!= (& how (<< (: 1 u64) (cast u64 10))) 0) 16 slot)] (let [at* (* (/ (- (+ (.stack-bytes cx) align) 1) align) align)] (set! (.stack-bytes cx) (+ at* slot)) (- (- 0 at*) 1)))))))))))
(defn pass-arguments [(cx (mut st/State)) (n i32) (on-stack bool)] (-> u64)
  (do (let [(mut passed) (cast u64 0)] (let [shape (cast i64 (graph/payload (.g cx) n))] (begin-placing (mut cx)) (for i (range 2 (graph/arity (.g cx) n)) (do (let [a (graph/input (.g cx) n i)] (let [at* (place (mut cx) (cast i64 (graph/ty (.g cx) a)) (graph/shape-passing (.g cx) shape (- i 2)))] (if (>= at* 0) (do (widened (mut cx) (- (- 0 at*) 1) a) (set! passed (| passed (<< (: 1 u64) (cast u64 at*))))) (do (when (not on-stack) (do (panic "a tail call's arguments must all fit in registers"))) (if (ir/type-float? (graph/ty (.g cx) a)) (do (lower/to-stack-float (mut cx) (lower/operand (mut cx) a) (- (- 0 at*) 1) (.placed-bytes cx))) (do (lower/to-stack (mut cx) (lower/extended (mut cx) a 2) (- (- 0 at*) 1) (.placed-bytes cx)))))))))) (set! (.out-slots cx) (let [x* (.out-slots cx) y* (/ (+ (.stack-bytes cx) 7) 8)] (if (> x* y*) x* y*))) (when (and (graph/shape-variadic? (.g cx) shape) (>= abi/VARIADIC-COUNT 0)) (do (lower/count-into (mut cx) (- (- 0 abi/VARIADIC-COUNT) 1) (let [x* (.floats cx) y* abi/FLOAT-ARGS] (if (< x* y*) x* y*))) (set! passed (| passed (<< (: 1 u64) (cast u64 abi/VARIADIC-COUNT)))))) passed))))
(defn call* [(cx (mut st/State)) (n i32)] (-> void)
  (do (do (let [passed (pass-arguments (mut cx) n true)] (if (= (graph/op (.g cx) (graph/input (.g cx) n 1)) ir/SYMBOL) (do (lower/call-symbol (mut cx) (cast i64 (graph/payload (.g cx) (graph/input (.g cx) n 1))))) (do (lower/call-register (mut cx) (lower/operand (mut cx) (graph/input (.g cx) n 1))))) (mach/implicit (mut cx) passed (if (>= abi/LINK 0) (| isa/CALLER-SAVED (<< (: 1 u64) (cast u64 abi/LINK))) isa/CALLER-SAVED)) (set! (.calls cx) true) (let [(mut i*3) (graph/first-use (.g cx) n)] (while (>= i*3 0) (let [u (graph/user (.g cx) i*3) e*4 (graph/next-use (.g cx) i*3)] (do (when (and (= (graph/op (.g cx) u) ir/RESULT) (get (.needed cx) (cast i64 u))) (do (let [r (if (ir/type-float? (graph/ty (.g cx) u)) (abi/float-result (cast i64 (graph/payload (.g cx) u))) (abi/int-result (cast i64 (graph/payload (.g cx) u))))] (when (< r 0) (do (panic "a call's result is numbered past the convention's result registers"))) (arrive (mut cx) u (- (- 0 r) 1)))))) (set! i*3 e*4)))))) (do)))
(defn returns [(cx (mut st/State)) (n i32)] (-> void)
  (do (do (let [(mut given) (cast u64 0)] (let [(mut ints) 0] (let [(mut floats) 0] (for i (range 1 (graph/arity (.g cx) n)) (do (let [a (graph/input (.g cx) n i)] (let [r (if (ir/type-float? (graph/ty (.g cx) a)) (abi/float-result floats) (abi/int-result ints))] (if (ir/type-float? (graph/ty (.g cx) a)) (do (set! floats (+ floats 1))) (do (set! ints (+ ints 1)))) (when (< r 0) (do (panic "more values are returned than the convention has registers for"))) (widened (mut cx) (- (- 0 r) 1) a) (set! given (| given (<< (: 1 u64) (cast u64 r)))))))) (lower/leave (mut cx)) (mach/implicit (mut cx) given (cast u64 0)))))) (do)))
(defn tail-call [(cx (mut st/State)) (n i32)] (-> void)
  (do (do (let [passed (pass-arguments (mut cx) n false)] (if (= (graph/op (.g cx) (graph/input (.g cx) n 1)) ir/SYMBOL) (do (lower/tail-symbol (mut cx) (cast i64 (graph/payload (.g cx) (graph/input (.g cx) n 1)))) (mach/implicit (mut cx) passed (cast u64 0))) (do (lower/move (mut cx) (- (- 0 isa/SCRATCH0) 1) (lower/operand (mut cx) (graph/input (.g cx) n 1))) (lower/tail-register (mut cx) (- (- 0 isa/SCRATCH0) 1)) (mach/implicit (mut cx) passed (cast u64 0)))))) (do)))
(defn reserve [(cx (mut st/State)) (n i32)] (-> void)
  (do (do (set! (.dynamic cx) true) (lower/reserve (mut cx) (lower/operand (mut cx) (graph/input (.g cx) n 1))) (lower/above-arguments (mut cx) (cast i64 n) 0) (mach/above-arguments (mut cx) (cast i64 n))) (do)))
(defn switch [(cx (mut st/State)) (n i32)] (-> void)
  (do (do (let [v (graph/input (.g cx) n 1)] (let [w (if (= (ir/type-bits (graph/ty (.g cx) v)) 64) 1 0)] (let [(mut i*6) (graph/first-use (.g cx) n)] (while (>= i*6 0) (let [u (graph/user (.g cx) i*6) e*7 (graph/next-use (.g cx) i*6)] (do (when (= (graph/op (.g cx) u) ir/CASE) (do (lower/branch-if-equal (mut cx) w (lower/extended (mut cx) v 0) (cast i64 (graph/payload (.g cx) u)) (cast i64 (get (.block-of cx) (cast i64 u))))))) (set! i*6 e*7)))) (let [otherwise (let [(mut acc*8) (: 0 i32)] (let [(mut i*10) (graph/first-use (.g cx) n)] (while (>= i*10 0) (let [u (graph/user (.g cx) i*10) e*11 (graph/next-use (.g cx) i*10)] (when (and (= acc*8 0) (= (graph/op (.g cx) u) ir/DEFAULT)) (set! acc*8 u)) (set! i*10 e*11)))) acc*8)] (lower/jump (mut cx) (cast i64 (get (.block-of cx) (cast i64 otherwise)))))))) (do)))
(defn param [(cx (mut st/State)) (n i32)] (-> void)
  (do (do (let [k (cast i64 (graph/payload (.g cx) n))] (begin-placing (mut cx)) (for j (range 0 k) (do (place (mut cx) (cast i64 (graph/param-type (.g cx) j)) (graph/param-passing (.g cx) j)))) (let [at* (place (mut cx) (cast i64 (graph/ty (.g cx) n)) (graph/param-passing (.g cx) k))] (if (>= at* 0) (do (arrive (mut cx) n (- (- 0 at*) 1))) (do (if (ir/type-float? (graph/ty (.g cx) n)) (do (lower/from-stack-float (mut cx) (cast i64 n) (- (- 0 abi/STACK) 1) (- (- 0 at*) 1) (.placed-bytes cx))) (do (lower/from-stack (mut cx) (cast i64 n) (- (- 0 abi/STACK) 1) (- (- 0 at*) 1) (.placed-bytes cx)))) (mach/from-caller (mut cx) (cast i64 n) (- (- 0 at*) 1) (.placed-bytes cx))))))) (do)))
(defn phi-of? [(cx (mut st/State)) (u i32) (h i32)] (-> bool)
  (and (= (graph/op (.g cx) u) ir/PHI) (= (graph/input (.g cx) u 0) h)))
(defn copy [(cx (mut st/State)) (d i64) (n i32)] (-> void)
  (do (do (if (lower/local? (mut cx) n) (do (lower/emit (mut cx) n (get (.tile cx) (cast i64 n)) d)) (do (transfer (mut cx) d (lower/operand (mut cx) n) n)))) (do)))
(defn transfer [(cx (mut st/State)) (d i64) (s i64) (like i32)] (-> void)
  (do (do (if (ir/type-float? (graph/ty (.g cx) like)) (do (lower/move-float (mut cx) d s)) (do (lower/move (mut cx) d s)))) (do)))
(defn phi-moves [(cx (mut st/State)) (b i32) (s i32)] (-> void)
  (do (do (let [(mut k) 0] (let [(mut index) 0] (let [(mut i*13) (lists/first (.preds cx) s)] (while (>= i*13 0) (let [p (lists/at (.preds cx) i*13)] (do (when (= p b) (do (set! k index))) (set! index (+ index 1)))) (set! i*13 (lists/after (.preds cx) i*13)))) (let [h (get (.head cx) (cast i64 s))] (let [cyclic (let [(mut acc*14) false] (let [(mut i*16) (graph/first-use (.g cx) h)] (while (>= i*16 0) (let [u (graph/user (.g cx) i*16) e*17 (graph/next-use (.g cx) i*16)] (when (and (and (phi-of? (mut cx) u h) (phi-of? (mut cx) (graph/input (.g cx) u (+ k 1)) h)) (!= (graph/input (.g cx) u (+ k 1)) u)) (set! acc*14 true)) (set! i*16 e*17)))) acc*14)] (if cyclic (do (let [(mut temps) (ArrayList::new [i64] (.alc cx))] (let [(mut i*18) (graph/first-use (.g cx) h)] (while (>= i*18 0) (let [u (graph/user (.g cx) i*18) e*19 (graph/next-use (.g cx) i*18)] (do (when (phi-of? (mut cx) u h) (do (let [t (mach/fresh-like (mut cx) u)] (push! (mut temps) t) (copy (mut cx) t (graph/input (.g cx) u (+ k 1))))))) (set! i*18 e*19)))) (let [(mut j) 0] (let [(mut i*20) (graph/first-use (.g cx) h)] (while (>= i*20 0) (let [u (graph/user (.g cx) i*20) e*21 (graph/next-use (.g cx) i*20)] (do (when (phi-of? (mut cx) u h) (do (transfer (mut cx) (cast i64 u) (get temps j) u) (set! j (+ j 1))))) (set! i*20 e*21))))))) (do (let [(mut i*22) (graph/first-use (.g cx) h)] (while (>= i*22 0) (let [u (graph/user (.g cx) i*22) e*23 (graph/next-use (.g cx) i*22)] (do (when (and (phi-of? (mut cx) u h) (!= (graph/input (.g cx) u (+ k 1)) u)) (do (copy (mut cx) (cast i64 u) (graph/input (.g cx) u (+ k 1)))))) (set! i*22 e*23))))))))))) (do)))
(defn run [(cx (mut st/State))] (-> void)
  (do (do (set! (.next-vreg cx) (- (graph/size (.g cx)) 1)) (for b (.order cx) (do (let [(mut i*24) (lists/first (.seq cx) b)] (while (>= i*24 0) (let [n (lists/at (.seq cx) i*24)] (do (when (or (cfg/control? (mut cx) n) (= (graph/op (.g cx) n) ir/PHI)) (do (mach/need (mut cx) n))))) (set! i*24 (lists/after (.seq cx) i*24)))))) (while (> (len (.worklist cx)) 0) (do (choose (mut cx) (let [v* (get (.worklist cx) (- (len (.worklist cx)) 1))] (pop! (mut (.worklist cx))) v*)))) (for b (.order cx) (do (set! (mut (.first-inst cx)) (cast i64 b) (+ (cast i64 (.inst-count cx)) 1)) (set! (.emitting cx) b) (let [(mut i*26) (lists/first (.seq cx) b)] (while (>= i*26 0) (let [n (lists/at (.seq cx) i*26)] (do (if (= (graph/op (.g cx) n) ir/CALL) (do (call* (mut cx) n)) (if (= (graph/op (.g cx) n) ir/SWITCH) (do (switch (mut cx) n)) (if (= (graph/op (.g cx) n) ir/TAILCALL) (do (tail-call (mut cx) n)) (if (= (graph/op (.g cx) n) ir/RETURN) (do (returns (mut cx) n)) (if (= (graph/op (.g cx) n) ir/RESERVE) (do (reserve (mut cx) n)) (if (= (graph/op (.g cx) n) ir/PARAM) (do (when (!= (get (.tile cx) (cast i64 n)) 0) (do (param (mut cx) n)))) (when (and (!= (get (.tile cx) (cast i64 n)) 0) (not (lower/local? (mut cx) n))) (do (lower/emit (mut cx) n (get (.tile cx) (cast i64 n)) (cast i64 n)))))))))))) (set! i*26 (lists/after (.seq cx) i*26)))) (when (not (cfg/end? (mut cx) (get (.last cx) (cast i64 b)))) (do (let [(mut i*27) (lists/first (.succs cx) b)] (while (>= i*27 0) (let [s (lists/at (.succs cx) i*27)] (do (phi-moves (mut cx) b s) (lower/jump (mut cx) (cast i64 s)))) (set! i*27 (lists/after (.succs cx) i*27)))))) (set! (mut (.last-inst cx)) (cast i64 b) (cast i64 (.inst-count cx)))))) (do)))

