;;; Written by the languages of coil-stogir-declarative from forward.pass.
(module declarative.x64.forward)
(import "coil.arraylist" :use [ArrayList])
(import "declarative.rt.graph" :as graph)
(import "declarative.rt.lists" :as lists)
(import "declarative.rt.bits" :as bv)
(import "declarative.x64.unit" :as st)
(import "declarative.backend.nodes" :as ir)
(import "declarative.x64.cfg" :as cfg)
(defn clobbers? [(cx (mut st/State)) (n i32)] (-> bool)
  (or (or (or (or (or (= (graph/op (.g cx) n) ir/CALL) (= (graph/op (.g cx) n) ir/COPY)) (= (graph/op (.g cx) n) ir/FILL)) (= (graph/op (.g cx) n) ir/ATOMIC-STORE)) (= (graph/op (.g cx) n) ir/RESERVE)) (cfg/update? (mut cx) n)))
(defn replace [(cx (mut st/State)) (l i32) (v i32)] (-> void)
  (do (do (let [(mut users) (ArrayList::new [i32] (.alc cx))] (let [(mut slots) (ArrayList::new [i64] (.alc cx))] (let [(mut i*1) (graph/first-use (.g cx) l)] (while (>= i*1 0) (let [e i*1 e*2 (graph/next-use (.g cx) i*1)] (do (push! (mut users) (graph/user (.g cx) e)) (push! (mut slots) (graph/slot (.g cx) e))) (set! i*1 e*2)))) (for i (range 0 (len users)) (do (let [u (get users i)] (let [k (get slots i)] (if (or (or (= (graph/op (.g cx) u) ir/REGION) (= (graph/op (.g cx) u) ir/LOOP)) (and (= k 0) (cfg/control? (mut cx) u))) (do (graph/set-input! (mut (.g cx)) u k (graph/input (.g cx) l 0))) (do (graph/set-input! (mut (.g cx)) u k v))))))) (graph/drop! (mut (.g cx)) l) (set! (.forwarded cx) (+ (.forwarded cx) 1))))) (do)))
(defn walk [(cx (mut st/State)) (b i32)] (-> void)
  (do (do (clear! (mut (.at cx))) (clear! (mut (.as cx))) (when (and (= (lists/count (.preds cx) b) 1) (!= (lists/nth (.preds cx) b 0) b)) (do (let [p (lists/nth (.preds cx) b 0)] (for i (range 0 (lists/count (.known-at cx) p)) (do (push! (mut (.at cx)) (lists/nth (.known-at cx) p i)) (push! (mut (.as cx)) (lists/nth (.known-as cx) p i))))))) (let [(mut c) (cfg/follower (mut cx) (get (.head cx) (cast i64 b)))] (while (and (!= c 0) (cfg/chain? (mut cx) c)) (do (let [next (cfg/follower (mut cx) c)] (if (and (= (graph/op (.g cx) c) ir/LOAD) (= (graph/payload (.g cx) c) 0)) (do (let [(mut found) (: 0 i32)] (for i (range 0 (len (.at cx))) (do (when (and (= (get (.at cx) i) (graph/input (.g cx) c 1)) (= (graph/ty (.g cx) (get (.as cx) i)) (graph/ty (.g cx) c))) (do (set! found (get (.as cx) i)))))) (if (!= found 0) (do (replace (mut cx) c found)) (when (< (len (.at cx)) 24) (do (push! (mut (.at cx)) (graph/input (.g cx) c 1)) (push! (mut (.as cx)) c)))))) (if (= (graph/op (.g cx) c) ir/STORE) (do (clear! (mut (.at cx))) (clear! (mut (.as cx))) (when (= (graph/payload (.g cx) c) 0) (do (push! (mut (.at cx)) (graph/input (.g cx) c 1)) (push! (mut (.as cx)) (graph/input (.g cx) c 2))))) (when (or (clobbers? (mut cx) c) (= (graph/op (.g cx) c) ir/LOAD)) (do (clear! (mut (.at cx))) (clear! (mut (.as cx))))))) (set! c next)))) (for i (range 0 (len (.at cx))) (do (lists/push! (mut (.known-at cx)) b (get (.at cx) i)) (lists/push! (mut (.known-as cx)) b (get (.as cx) i)))))) (do)))
(defn run [(cx (mut st/State))] (-> void)
  (do (do (for b (.order cx) (do (walk (mut cx) b)))) (do)))

