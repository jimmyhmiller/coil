;;; Written by the languages of coil-stogir-declarative from schedule.pass.
(module declarative.x64.schedule)
(import "coil.arraylist" :use [ArrayList])
(import "declarative.rt.graph" :as graph)
(import "declarative.rt.lists" :as lists)
(import "declarative.rt.bits" :as bv)
(import "declarative.x64.unit" :as st)
(import "declarative.backend.nodes" :as ir)
(import "declarative.x64.cfg" :as cfg)
(defn pinned? [(cx (mut st/State)) (n i32)] (-> bool)
  (or (or (or (cfg/control? (mut cx) n) (= (graph/op (.g cx) n) ir/PHI)) (= (graph/op (.g cx) n) ir/PARAM)) (= (graph/op (.g cx) n) ir/RESULT)))
(defn early [(cx (mut st/State)) (n i32)] (-> void)
  (do (block :ret (do (when (or (get (.early-done cx) (cast i64 n)) (pinned? (mut cx) n)) (do (return-from :ret 0))) (set! (mut (.early-done cx)) (cast i64 n) true) (let [(mut b) (cfg/entry (mut cx))] (let [n*2 n] (for i*1 (range 0 (graph/arity (.g cx) n*2)) (let [i (graph/input (.g cx) n*2 i*1)] (do (when (!= i 0) (do (early (mut cx) i) (when (> (get (.dom-depth cx) (cast i64 (get (.block-of cx) (cast i64 i)))) (get (.dom-depth cx) (cast i64 b))) (do (set! b (get (.block-of cx) (cast i64 i))))))))))) (set! (mut (.block-of cx)) (cast i64 n) b))) 0) (do)))
(defn late [(cx (mut st/State)) (n i32)] (-> void)
  (do (block :ret (do (when (or (get (.late-done cx) (cast i64 n)) (pinned? (mut cx) n)) (do (return-from :ret 0))) (set! (mut (.late-done cx)) (cast i64 n) true) (let [(mut i*3) (graph/first-use (.g cx) n)] (while (>= i*3 0) (let [u (graph/user (.g cx) i*3) e*4 (graph/next-use (.g cx) i*3)] (do (late (mut cx) u)) (set! i*3 e*4)))) (let [(mut lca) (: 0 i32)] (let [(mut i*6) (graph/first-use (.g cx) n)] (while (>= i*6 0) (let [u (graph/user (.g cx) i*6) e*7 (graph/next-use (.g cx) i*6)] (do (if (= (graph/op (.g cx) u) ir/PHI) (do (let [region (get (.block-of cx) (cast i64 (graph/input (.g cx) u 0)))] (for i (range 1 (graph/arity (.g cx) u)) (do (when (= (graph/input (.g cx) u i) n) (do (set! lca (cfg/join (mut cx) lca (lists/nth (.preds cx) region (- i 1)))))))))) (when (!= (get (.block-of cx) (cast i64 u)) 0) (do (set! lca (cfg/join (mut cx) lca (get (.block-of cx) (cast i64 u)))))))) (set! i*6 e*7)))) (let [earliest (get (.block-of cx) (cast i64 n))] (set! (mut (.block-of cx)) (cast i64 n) 0) (when (!= lca 0) (do (let [(mut best) lca] (let [(mut x) lca] (while (!= x earliest) (do (when (= x (get (.idom cx) (cast i64 x))) (do (panic "a node's uses are not dominated by its inputs"))) (set! x (get (.idom cx) (cast i64 x))) (when (< (get (.loop-depth cx) (cast i64 x)) (get (.loop-depth cx) (cast i64 best))) (do (set! best x))))) (set! (mut (.block-of cx)) (cast i64 n) best) (lists/push! (mut (.members cx)) best n)))))))) 0) (do)))
(defn place [(cx (mut st/State)) (n i32) (b i32)] (-> void)
  (do (block :ret (do (when (get (.placed cx) (cast i64 n)) (do (return-from :ret 0))) (set! (mut (.placed cx)) (cast i64 n) true) (when (not (= (graph/op (.g cx) n) ir/PHI)) (do (let [n*9 n] (for i*8 (range 0 (graph/arity (.g cx) n*9)) (let [i (graph/input (.g cx) n*9 i*8)] (do (when (and (and (!= i 0) (= (get (.block-of cx) (cast i64 i)) b)) (not (pinned? (mut cx) i))) (do (place (mut cx) i b))))))))) (lists/push! (mut (.seq cx)) b n)) 0) (do)))
(defn order-block [(cx (mut st/State)) (b i32)] (-> void)
  (do (do (let [h (get (.head cx) (cast i64 b))] (place (mut cx) h b) (let [(mut i*10) (graph/first-use (.g cx) h)] (while (>= i*10 0) (let [u (graph/user (.g cx) i*10) e*11 (graph/next-use (.g cx) i*10)] (do (when (and (= (graph/op (.g cx) u) ir/PHI) (= (graph/input (.g cx) u 0) h)) (do (place (mut cx) u b)))) (set! i*10 e*11)))) (when (= (graph/op (.g cx) h) ir/START) (do (for i*12 (range 1 (graph/size (.g cx))) (let [n (cast i32 i*12)] (do (when (and (= (graph/op (.g cx) n) ir/PARAM) (not (graph/dead? (.g cx) n))) (do (place (mut cx) n b)))))))) (let [(mut c) (cfg/follower (mut cx) h)] (while (and (!= c 0) (cfg/chain? (mut cx) c)) (do (place (mut cx) c b) (let [(mut i*13) (graph/first-use (.g cx) c)] (while (>= i*13 0) (let [u (graph/user (.g cx) i*13) e*14 (graph/next-use (.g cx) i*13)] (do (when (= (graph/op (.g cx) u) ir/RESULT) (do (place (mut cx) u b)))) (set! i*13 e*14)))) (set! c (cfg/follower (mut cx) c)))) (let [(mut i*15) (lists/first (.members cx) b)] (while (>= i*15 0) (let [n (lists/at (.members cx) i*15)] (do (place (mut cx) n b))) (set! i*15 (lists/after (.members cx) i*15)))) (when (!= c 0) (do (place (mut cx) c b)))))) (do)))
(defn build [(cx (mut st/State))] (-> void)
  (do (do (for i*16 (range 1 (graph/size (.g cx))) (let [n (cast i32 i*16)] (do (when (or (= (graph/op (.g cx) n) ir/PHI) (= (graph/op (.g cx) n) ir/RESULT)) (do (set! (mut (.block-of cx)) (cast i64 n) (get (.block-of cx) (cast i64 (graph/input (.g cx) n 0))))))))) (for i*17 (range 1 (graph/size (.g cx))) (let [n (cast i32 i*17)] (do (when (= (graph/op (.g cx) n) ir/PARAM) (do (set! (mut (.block-of cx)) (cast i64 n) (cfg/entry (mut cx)))))))) (for i*18 (range 1 (graph/size (.g cx))) (let [n (cast i32 i*18)] (do (when (not (graph/dead? (.g cx) n)) (do (early (mut cx) n)))))) (for i*19 (range 1 (graph/size (.g cx))) (let [n (cast i32 i*19)] (do (when (not (graph/dead? (.g cx) n)) (do (late (mut cx) n)))))) (for b (.order cx) (do (order-block (mut cx) b)))) (do)))
(defn dump [(cx (mut st/State))] (-> void)
  (do (do (for b (.order cx) (do (println "block {} head={} idom={} loop-depth={}" b (get (.head cx) (cast i64 b)) (get (.idom cx) (cast i64 b)) (get (.loop-depth cx) (cast i64 b))) (let [(mut i*21) (lists/first (.seq cx) b)] (while (>= i*21 0) (let [n (lists/at (.seq cx) i*21)] (do (println "  {} {}" n (ir/name (graph/op (.g cx) n))))) (set! i*21 (lists/after (.seq cx) i*21))))))) (do)))

