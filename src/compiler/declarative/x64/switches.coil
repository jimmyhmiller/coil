;;; Written by the languages of coil-stogir-declarative from switches.pass.
(module declarative.x64.switches)
(import "coil.arraylist" :use [ArrayList])
(import "declarative.rt.graph" :as graph)
(import "declarative.rt.lists" :as lists)
(import "declarative.rt.bits" :as bv)
(import "declarative.x64.unit" :as st)
(import "declarative.backend.nodes" :as ir)
(import "declarative.x64.loops" :as loops)
(import "declarative.x64.cfg" :as cfg)
(defn few [(cx (mut st/State))] (-> i64)
  4)
(defn halve [(cx (mut st/State)) (s i32)] (-> void)
  (do (block :ret (do (let [(mut cases) (ArrayList::new [i32] (.alc cx))] (let [(mut i*1) (graph/first-use (.g cx) s)] (while (>= i*1 0) (let [u (graph/user (.g cx) i*1) e*2 (graph/next-use (.g cx) i*1)] (do (when (= (graph/op (.g cx) u) ir/CASE) (do (push! (mut cases) u)))) (set! i*1 e*2)))) (when (<= (len cases) (few (mut cx))) (do (return-from :ret 0))) (let [otherwise (let [(mut acc*3) (: 0 i32)] (let [(mut i*5) (graph/first-use (.g cx) s)] (while (>= i*5 0) (let [u (graph/user (.g cx) i*5) e*6 (graph/next-use (.g cx) i*5)] (when (and (= acc*3 0) (= (graph/op (.g cx) u) ir/DEFAULT)) (set! acc*3 u)) (set! i*5 e*6)))) acc*3)] (when (= otherwise 0) (do (return-from :ret 0))) (let [(mut middle) (: 0 i32)] (for c cases (do (when (and (= middle 0) (= (let [(mut acc*7) 0] (for d cases (when (< (graph/payload (.g cx) d) (graph/payload (.g cx) c)) (set! acc*7 (+ acc*7 1)))) acc*7) (/ (len cases) 2))) (do (set! middle c))))) (when (= middle 0) (do (return-from :ret 0))) (let [v (graph/input (.g cx) s 1)] (let [test (ir/if! (mut (.g cx)) (graph/input (.g cx) s 0) (ir/ult! (mut (.g cx)) v (ir/make-const! (mut (.g cx)) (graph/ty (.g cx) v) (graph/payload (.g cx) middle))))] (let [below (ir/switch! (mut (.g cx)) (ir/true! (mut (.g cx)) test) v)] (let [above (ir/switch! (mut (.g cx)) (ir/false! (mut (.g cx)) test) v)] (let [at* (graph/payload (.g cx) middle)] (for c cases (do (graph/set-input! (mut (.g cx)) c 0 (if (< (graph/payload (.g cx) c) at*) below above)))) (let [both (ir/region! (mut (.g cx)) 2)] (graph/set-input! (mut (.g cx)) both 0 (ir/default! (mut (.g cx)) below)) (graph/set-input! (mut (.g cx)) both 1 (ir/default! (mut (.g cx)) above)) (st/grow-nodes! (mut cx)) (loops/follow (mut cx) otherwise both) (graph/drop! (mut (.g cx)) otherwise) (graph/drop! (mut (.g cx)) s) (set! (.halved cx) (+ (.halved cx) 1)) (halve (mut cx) below) (halve (mut cx) above))))))))))) 0) (do)))
(defn run [(cx (mut st/State))] (-> void)
  (do (block :ret (do (when (not (cfg/on? (mut cx) 5)) (do (return-from :ret 0))) (for i*12 (range 1 (graph/size (.g cx))) (let [n (cast i32 i*12)] (do (when (and (not (graph/dead? (.g cx) n)) (= (graph/op (.g cx) n) ir/SWITCH)) (do (halve (mut cx) n))))))) 0) (do)))

