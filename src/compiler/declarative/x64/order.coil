;;; Written by the languages of coil-stogir-declarative from order.pass.
(module declarative.x64.order)
(import "coil.arraylist" :use [ArrayList])
(import "declarative.rt.graph" :as graph)
(import "declarative.rt.lists" :as lists)
(import "declarative.rt.bits" :as bv)
(import "declarative.x64.unit" :as st)
(import "declarative.backend.nodes" :as ir)
(import "declarative.x64.cfg" :as cfg)
(defn run [(cx (mut st/State))] (-> void)
  (do (do (for i*4 (range 1 (+ (cast i64 (.block-count cx)) 1)) (let [h (cast i32 i*4)] (do (when (and (and (= (graph/op (.g cx) (get (.head cx) (cast i64 h))) ir/LOOP) (= (lists/count (.succs cx) h) 2)) (> (lists/count (.loop-blocks cx) h) 1)) (do (for i (range 0 (len (.order cx))) (do (set! (mut (.place cx)) (cast i64 (get (.order cx) i)) i))) (let [from (get (.place cx) (cast i64 h))] (let [(mut last) from] (let [(mut i*2) (lists/first (.loop-blocks cx) h)] (while (>= i*2 0) (let [b (lists/at (.loop-blocks cx) i*2)] (do (set! last (let [x* last y* (get (.place cx) (cast i64 b))] (if (> x* y*) x* y*))))) (set! i*2 (lists/after (.loop-blocks cx) i*2)))) (when (and (> from 0) (> last from)) (do (for k (range from last) (do (set! (mut (.order cx)) k (get (.order cx) (+ k 1))))) (set! (mut (.order cx)) last h))))))))))) (do)))

