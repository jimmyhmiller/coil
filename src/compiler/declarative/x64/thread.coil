;;; Written by the languages of coil-stogir-declarative from thread.pass.
(module declarative.x64.thread)
(import "coil.arraylist" :use [ArrayList])
(import "declarative.rt.graph" :as graph)
(import "declarative.rt.lists" :as lists)
(import "declarative.rt.bits" :as bv)
(import "declarative.x64.unit" :as st)
(import "declarative.backend.nodes" :as ir)
(defn chooses [(cx (mut st/State)) (c i32) (p i32) (k i32)] (-> bool)
  (block :ret (do (let [set* (!= (graph/payload (.g cx) k) 0)] (when (= c p) (do (return-from :ret set*))) (when (= (graph/op (.g cx) c) ir/EQ) (do (return-from :ret (not set*)))) set*))))
(defn asks? [(cx (mut st/State)) (c i32) (p i32)] (-> bool)
  (block :ret (do (when (= c p) (do (return-from :ret (= (ir/type-bits (graph/ty (.g cx) p)) 1)))) (when (or (not (or (= (graph/op (.g cx) c) ir/NE) (= (graph/op (.g cx) c) ir/EQ))) (!= (graph/use-count (.g cx) c) 1)) (do (return-from :ret false))) (or (and (and (= (graph/input (.g cx) c 0) p) (= (graph/op (.g cx) (graph/input (.g cx) c 1)) ir/CONST)) (= (graph/payload (.g cx) (graph/input (.g cx) c 1)) 0)) (and (and (= (graph/input (.g cx) c 1) p) (= (graph/op (.g cx) (graph/input (.g cx) c 0)) ir/CONST)) (= (graph/payload (.g cx) (graph/input (.g cx) c 0)) 0))))))
(defn onward [(cx (mut st/State)) (ways (mut (ArrayList i32)))] (-> i32)
  (block :ret (do (when (= (len ways) 1) (do (return-from :ret (get ways 0)))) (let [region (ir/region! (mut (.g cx)) (len ways))] (for i (range 0 (len ways)) (do (graph/set-input! (mut (.g cx)) region i (get ways i)))) (st/grow-nodes! (mut cx)) region))))
(defn consider [(cx (mut st/State)) (branch i32)] (-> void)
  (do (block :ret (do (let [r (graph/input (.g cx) branch 0)] (let [c (graph/input (.g cx) branch 1)] (when (or (not (= (graph/op (.g cx) r) ir/REGION)) (!= (graph/use-count (.g cx) r) 2)) (do (return-from :ret 0))) (let [p (let [(mut acc*2) (: 0 i32)] (let [(mut i*4) (graph/first-use (.g cx) r)] (while (>= i*4 0) (let [u (graph/user (.g cx) i*4) e*5 (graph/next-use (.g cx) i*4)] (when (and (= acc*2 0) (and (= (graph/op (.g cx) u) ir/PHI) (= (graph/input (.g cx) u 0) r))) (set! acc*2 u)) (set! i*4 e*5)))) acc*2)] (when (or (= p 0) (not (asks? (mut cx) c p))) (do (return-from :ret 0))) (when (!= (graph/use-count (.g cx) p) 1) (do (return-from :ret 0))) (for i (range 1 (graph/arity (.g cx) p)) (do (when (not (= (graph/op (.g cx) (graph/input (.g cx) p i)) ir/CONST)) (do (return-from :ret 0))))) (let [yes (let [(mut acc*7) (: 0 i32)] (let [(mut i*9) (graph/first-use (.g cx) branch)] (while (>= i*9 0) (let [u (graph/user (.g cx) i*9) e*10 (graph/next-use (.g cx) i*9)] (when (and (= acc*7 0) (= (graph/op (.g cx) u) ir/TRUE)) (set! acc*7 u)) (set! i*9 e*10)))) acc*7)] (let [no (let [(mut acc*11) (: 0 i32)] (let [(mut i*13) (graph/first-use (.g cx) branch)] (while (>= i*13 0) (let [u (graph/user (.g cx) i*13) e*14 (graph/next-use (.g cx) i*13)] (when (and (= acc*11 0) (= (graph/op (.g cx) u) ir/FALSE)) (set! acc*11 u)) (set! i*13 e*14)))) acc*11)] (when (or (= yes 0) (= no 0)) (do (return-from :ret 0))) (let [(mut true-ways) (ArrayList::new [i32] (.alc cx))] (let [(mut false-ways) (ArrayList::new [i32] (.alc cx))] (for i (range 1 (graph/arity (.g cx) p)) (do (if (chooses (mut cx) c p (graph/input (.g cx) p i)) (do (push! (mut true-ways) (graph/input (.g cx) r (- i 1)))) (do (push! (mut false-ways) (graph/input (.g cx) r (- i 1))))))) (when (or (= (len true-ways) 0) (= (len false-ways) 0)) (do (return-from :ret 0))) (graph/replace-uses! (mut (.g cx)) yes (onward (mut cx) (mut true-ways))) (graph/replace-uses! (mut (.g cx)) no (onward (mut cx) (mut false-ways))) (graph/drop! (mut (.g cx)) yes) (graph/drop! (mut (.g cx)) no) (graph/drop! (mut (.g cx)) branch) (when (!= c p) (do (graph/drop! (mut (.g cx)) c))) (graph/drop! (mut (.g cx)) p) (graph/drop! (mut (.g cx)) r) (set! (.threaded cx) (+ (.threaded cx) 1)))))))))) 0) (do)))
(defn run [(cx (mut st/State))] (-> void)
  (do (do (for i*16 (range 1 (graph/size (.g cx))) (let [n (cast i32 i*16)] (do (when (and (not (graph/dead? (.g cx) n)) (= (graph/op (.g cx) n) ir/IF)) (do (consider (mut cx) n))))))) (do)))

