;;; A node whose inputs are all constants is the constant its meaning gives.
(defn fold [(cx (mut st/State)) (n i32)] (-> i32)
  (let [operation (graph/op (.g cx) n)
        count (graph/arity (.g cx) n)]
    (if (or (not (ir/foldable? operation)) (= count 0) (> count 3))
        0
        (let [a (graph/input (.g cx) n 0)
              b (if (> count 1) (graph/input (.g cx) n 1) a)
              c (if (> count 2) (graph/input (.g cx) n 2) a)]
          (if (and (= (graph/op (.g cx) a) ir/CONST)
                   (= (graph/op (.g cx) b) ir/CONST)
                   (= (graph/op (.g cx) c) ir/CONST))
              (do (set! (.fired cx) 0)
                  (ir/make-const! (mut (.g cx)) (graph/ty (.g cx) n)
                             (ir/eval operation (ir/type-bits (graph/ty (.g cx) n))
                                      (ir/type-bits (graph/ty (.g cx) a))
                                      (graph/payload (.g cx) a) (graph/payload (.g cx) b)
                                      (graph/payload (.g cx) c))))
              0)))))
;;; A node over a phi, its other operands constants, is a phi of what the node
;;; is for each of the phi's values: a constant where the value is one, and
;;; the node over the value where it is not. Done when every value is a
;;; constant, or when some are and nothing else reads the phi, so that the node
;;; is not computed more often than it was.
(defn fold-phi [(cx (mut st/State)) (n i32)] (-> i32)
  (let [operation (graph/op (.g cx) n)
        count (graph/arity (.g cx) n)
        (mut phi) (: 0 i32)
        (mut at) -1
        (mut ok) (and (ir/foldable? operation) (> count 0) (<= count 3))]
    (when ok
      (for i (range 0 count)
        (let [d (graph/input (.g cx) n i)
              role (ir/role (graph/op (.g cx) d))]
          (cond (= role 10) 0
                (and (= role 8) (= phi 0)) (do (set! phi d) (set! at i) 0)
                :else (do (set! ok false) 0)))))
    (when (and ok (!= phi 0))
      (when (< (graph/arity (.g cx) phi) 3) (set! ok false))
      (let [(mut known) 0]
        (for i (range 1 (graph/arity (.g cx) phi))
          (when (= (ir/role (graph/op (.g cx) (graph/input (.g cx) phi i))) 10) (set! known (+ known 1))))
        (when (or (= known 0)
                  (and (< known (- (graph/arity (.g cx) phi) 1)) (!= (graph/use-count (.g cx) phi) 1)))
          (set! ok false))))
    (if (or (not ok) (= phi 0))
        0
        (let [ways (- (graph/arity (.g cx) phi) 1)
              out (ir/make-phi! (mut (.g cx)) (graph/ty (.g cx) n) (graph/input (.g cx) phi 0) ways)
              bits (ir/type-bits (graph/ty (.g cx) (graph/input (.g cx) n 0)))]
          (for i (range 1 (+ ways 1))
            (let [value (graph/input (.g cx) phi i)
                  k (graph/payload (.g cx) value)
                  a (if (= at 0) k (graph/payload (.g cx) (graph/input (.g cx) n 0)))
                  b (cond (< count 2) a (= at 1) k :else (graph/payload (.g cx) (graph/input (.g cx) n 1)))
                  c (cond (< count 3) a (= at 2) k :else (graph/payload (.g cx) (graph/input (.g cx) n 2)))]
              (graph/set-input! (mut (.g cx)) out i
                                (if (= (ir/role (graph/op (.g cx) value)) 10)
                                    (ir/make-const! (mut (.g cx)) (graph/ty (.g cx) n)
                                                    (ir/eval operation (ir/type-bits (graph/ty (.g cx) n)) bits a b c))
                                    ; The node itself, over this value in the phi's place.
                                    (graph/intern! (mut (.g cx)) operation (graph/ty (.g cx) n) (graph/payload (.g cx) n) count
                                                   (if (= at 0) value (graph/input (.g cx) n 0))
                                                   (cond (< count 2) 0 (= at 1) value :else (graph/input (.g cx) n 1))
                                                   (cond (< count 3) 0 (= at 2) value :else (graph/input (.g cx) n 2)))))))
          (set! (.fired cx) 0)
          out))))
(defn enqueue! [(work (mut (ArrayList i32))) (queued (mut (ArrayList bool))) (n i32)] (-> void)
  (while (<= (len queued) (cast i64 n)) (push! (mut queued) false))
  (unless (get queued (cast i64 n))
    (set! (mut queued) (cast i64 n) true)
    (push! (mut work) n)))
;;; Every use of `old` becomes a use of `new`; the users are looked at again,
;;; and `old` goes, with whatever only it was using.
(defn replace! [(cx (mut st/State)) (work (mut (ArrayList i32))) (queued (mut (ArrayList bool)))
                (old i32) (new i32)] (-> void)
  (let [(mut e) (graph/first-use (.g cx) old)]
    (while (>= e 0)
      (enqueue! (mut work) (mut queued) (graph/user (.g cx) e))
      (set! e (graph/next-use (.g cx) e))))
  (graph/replace-uses! (mut (.g cx)) old new)
  (enqueue! (mut work) (mut queued) new)
  (let [role (ir/role (graph/op (.g cx) old))]
    (cond (ir/pure? (graph/op (.g cx) old)) (do (graph/kill! (mut (.g cx)) old ir/PURE) (do))
          ; A region or phi that has been replaced has no one left to speak for it.
          (or (= role 3) (= role 4) (= role 8)) (graph/drop! (mut (.g cx)) old)
          :else (do)))
  (do))
;;; A region with one way in is about to become that way. Its phis go first,
;;; each becoming its one value: a phi left behind would name as its region
;;; whatever the way in was, and if that is a region, be taken for one of its phis.
(defn settle-phis! [(cx (mut st/State)) (work (mut (ArrayList i32))) (queued (mut (ArrayList bool)))
                    (n i32)] (-> void)
  (let [role (ir/role (graph/op (.g cx) n))]
    (when (and (or (= role 3) (= role 4)) (= (graph/arity (.g cx) n) 1))
      (let [(mut again) true]
        (while again
          (set! again false)
          (let [(mut e) (graph/first-use (.g cx) n)]
            (while (and (>= e 0) (not again))
              (let [u (graph/user (.g cx) e)]
                (when (and (= (ir/role (graph/op (.g cx) u)) 8) (= (graph/input (.g cx) u 0) n)
                           (= (graph/arity (.g cx) u) 2) (!= (graph/input (.g cx) u 1) u))
                  (replace! (mut cx) (mut work) (mut queued) u (graph/input (.g cx) u 1))
                  (set! again true))
                (unless again (set! e (graph/next-use (.g cx) e)))))))))))
;;; A control node that can never run goes, and so does whatever only it led to.
;;; A region loses the input that came from it, and its phis the matching
;;; input; a loop that loses its way in goes entirely.
(defn kill-control! [(cx (mut st/State)) (work (mut (ArrayList i32))) (queued (mut (ArrayList bool)))
                     (dead i32)] (-> void)
  (let [(mut stack) (ArrayList::new [i32] (.alc cx))]
    (push! (mut stack) dead)
    (while (> (len stack) 0)
      (let [d (get stack (- (len stack) 1))]
        (pop! (mut stack))
        (unless (graph/dead? (.g cx) d)
          ; Who uses it is noted before anything is changed: taking an input out
          ; of a region or a phi moves its later inputs down, and with them the
          ; uses a walk of this node's users would go on to.
          (let [(mut users) (ArrayList::new [i32] (.alc cx))
                (mut e) (graph/first-use (.g cx) d)]
            (while (>= e 0)
              (push! (mut users) (graph/user (.g cx) e))
              (set! e (graph/next-use (.g cx) e)))
            (for u users
              (unless (graph/dead? (.g cx) u)
                (let [role (ir/role (graph/op (.g cx) u))]
                  (cond
                    ; A phi of a dead region, or the value of a dead call or load: it goes when its users do.
                    (not (ir/control-node? (graph/op (.g cx) u))) (enqueue! (mut work) (mut queued) u)
                    (or (= role 3) (= role 4))
                      ; Each input of the region that is this node, wherever it now is.
                      (let [(mut going) true]
                        (while going
                          (let [(mut slot) -1]
                            (for i (range 0 (graph/arity (.g cx) u))
                              (when (and (< slot 0) (= (graph/input (.g cx) u i) d)) (set! slot i)))
                            (cond
                              (< slot 0) (set! going false)
                              ; A loop that loses its way in goes entirely.
                              (and (= role 4) (= slot 0)) (do (push! (mut stack) u) (set! going false))
                              :else
                                (do
                                  ; The region's phis lose the input that came along this way.
                                  (let [(mut phis) (ArrayList::new [i32] (.alc cx))
                                        (mut p) (graph/first-use (.g cx) u)]
                                    (while (>= p 0)
                                      (let [phi (graph/user (.g cx) p)]
                                        (when (and (= (ir/role (graph/op (.g cx) phi)) 8) (= (graph/input (.g cx) phi 0) u))
                                          (push! (mut phis) phi)))
                                      (set! p (graph/next-use (.g cx) p)))
                                    (for phi phis
                                      (enqueue! (mut work) (mut queued) (graph/input (.g cx) phi (+ slot 1)))
                                      (graph/remove-input! (mut (.g cx)) phi (+ slot 1))
                                      (enqueue! (mut work) (mut queued) phi))
                                    (free! (mut phis)))
                                  (graph/remove-input! (mut (.g cx)) u slot)
                                  (enqueue! (mut work) (mut queued) u)
                                  (when (= (graph/arity (.g cx) u) 0)
                                    (push! (mut stack) u)
                                    (set! going false)))))))
                    :else (push! (mut stack) u)))))
            (free! (mut users)))
          (for i (range 0 (graph/arity (.g cx) d))
            (when (!= (graph/input (.g cx) d i) 0) (enqueue! (mut work) (mut queued) (graph/input (.g cx) d i))))
          (graph/drop! (mut (.g cx)) d))))
    (free! (mut stack))))
;;; A branch that always goes one way: what followed its live side follows what
;;; led to the branch, and its other side can never run.
(defn branch! [(cx (mut st/State)) (work (mut (ArrayList i32))) (queued (mut (ArrayList bool)))
               (n i32) (taken bool)] (-> void)
  (let [before (graph/input (.g cx) n 0)
        (mut live) (: 0 i32)
        (mut dead) (: 0 i32)
        (mut e) (graph/first-use (.g cx) n)]
    (while (>= e 0)
      (let [u (graph/user (.g cx) e)
            role (ir/role (graph/op (.g cx) u))]
        (when (= role 6) (if taken (set! live u) (set! dead u)))
        (when (= role 7) (if taken (set! dead u) (set! live u))))
      (set! e (graph/next-use (.g cx) e)))
    (when (!= dead 0) (kill-control! (mut cx) (mut work) (mut queued) dead))
    (when (!= live 0)
      (let [(mut u) (graph/first-use (.g cx) live)]
        (while (>= u 0)
          (enqueue! (mut work) (mut queued) (graph/user (.g cx) u))
          (set! u (graph/next-use (.g cx) u))))
      (graph/replace-uses! (mut (.g cx)) live before)
      (graph/drop! (mut (.g cx)) live))
    (enqueue! (mut work) (mut queued) (graph/input (.g cx) n 1))
    (graph/drop! (mut (.g cx)) n)))
;;; Ways that meet only to part again. Where several ways reach a region, each
;;; bringing a constant, and all that is done there is to branch or switch on
;;; which constant came, each way goes straight to the side its constant
;;; chooses, and a side no way chooses can never run. True if `n` was such a
;;; branch or switch, which is then gone with its region and phi.
(defn thread! [(cx (mut st/State)) (work (mut (ArrayList i32))) (queued (mut (ArrayList bool)))
               (n i32)] (-> bool)
  (let [role (ir/role (graph/op (.g cx) n))]
    (if (or (and (!= role 5) (!= role 19)) (< (graph/arity (.g cx) n) 2))
        false
        (let [r (graph/input (.g cx) n 0)
              v (graph/input (.g cx) n 1)
              ways (graph/arity (.g cx) r)
              (mut ok) (and (= (ir/role (graph/op (.g cx) r)) 3)
                            (= (ir/role (graph/op (.g cx) v)) 8)
                            (= (graph/input (.g cx) v 0) r)
                            (= (graph/use-count (.g cx) r) 2)
                            (= (graph/use-count (.g cx) v) 1)
                            (= (graph/arity (.g cx) v) (+ ways 1))
                            (>= ways 2))
              (mut known) 0]
          ; How many ways bring a constant: those are the ones that can go on.
          (when ok
            (for i (range 1 (+ ways 1))
              (when (= (ir/role (graph/op (.g cx) (graph/input (.g cx) v i))) 10) (set! known (+ known 1)))))
          (if (or (not ok) (= known 0))
              false
              (let [(mut sides) (ArrayList::new [i32] (.alc cx))
                    (mut chosen) (ArrayList::new [i32] (.alc cx))
                    (mut goes) (ArrayList::new [i32] (.alc cx))
                    (mut e) (graph/first-use (.g cx) n)]
                (while (>= e 0)
                  (let [u (graph/user (.g cx) e)]
                    (when (= (graph/input (.g cx) u 0) n) (push! (mut sides) u)))
                  (set! e (graph/next-use (.g cx) e)))
                ; Which side each way goes to, settled before anything is changed:
                ; the side its constant chooses, a switch's default if no case does.
                (for i (range 0 ways)
                  (let [k (graph/payload (.g cx) (graph/input (.g cx) v (+ i 1)))
                        (mut to) (: 0 i32)
                        (mut otherwise) (: 0 i32)]
                    (for side sides
                      (let [side-role (ir/role (graph/op (.g cx) side))]
                        (when (= side-role 21) (set! otherwise side))
                        (when (or (and (= side-role 6) (!= k 0))
                                  (and (= side-role 7) (= k 0))
                                  (and (= side-role 20) (= (graph/payload (.g cx) side) k)))
                          (set! to side))))
                    ; A way that brings no constant stays where it is.
                    (push! (mut goes)
                           (cond (!= (ir/role (graph/op (.g cx) (graph/input (.g cx) v (+ i 1)))) 10) 0
                                 (!= to 0) to
                                 :else otherwise))))
                (for side sides
                  (clear! (mut chosen))
                  (for i (range 0 ways)
                    (when (= (get goes i) side) (push! (mut chosen) (graph/input (.g cx) r i))))
                  (cond
                    ; Some ways stay, so the side is still reached from the
                    ; branch as well as from the ways that now go straight to it.
                    (< known ways)
                      (when (> (len chosen) 0)
                        (let [meet (ir/make-region! (mut (.g cx)) (+ (len chosen) 1))]
                          (replace! (mut cx) (mut work) (mut queued) side meet)
                          (graph/set-input! (mut (.g cx)) meet 0 side)
                          (for i (range 0 (len chosen))
                            (graph/set-input! (mut (.g cx)) meet (+ i 1) (get chosen i)))))
                    (= (len chosen) 0) (kill-control! (mut cx) (mut work) (mut queued) side)
                    (= (len chosen) 1)
                      (do (replace! (mut cx) (mut work) (mut queued) side (get chosen 0))
                          (graph/drop! (mut (.g cx)) side))
                    :else
                      (let [meet (ir/make-region! (mut (.g cx)) (len chosen))]
                        (for i (range 0 (len chosen)) (graph/set-input! (mut (.g cx)) meet i (get chosen i)))
                        (replace! (mut cx) (mut work) (mut queued) side meet)
                        (graph/drop! (mut (.g cx)) side))))
                (for i (range 1 (+ ways 1)) (enqueue! (mut work) (mut queued) (graph/input (.g cx) v i)))
                (if (< known ways)
                    ; The ways that went on leave the region and its phi, last first.
                    (do (for back (range 0 ways)
                          (let [i (- (- ways 1) back)]
                            (when (!= (get goes i) 0)
                              (graph/remove-input! (mut (.g cx)) v (+ i 1))
                              (graph/remove-input! (mut (.g cx)) r i))))
                        (enqueue! (mut work) (mut queued) r)
                        (enqueue! (mut work) (mut queued) v)
                        (enqueue! (mut work) (mut queued) n))
                    (do (graph/drop! (mut (.g cx)) n)
                        (graph/drop! (mut (.g cx)) v)
                        (graph/drop! (mut (.g cx)) r)))
                (free! (mut sides))
                (free! (mut chosen))
                (free! (mut goes))
                true))))))
;;; A region with one way in is that way; a phi all of whose values are one
;;; node, or that node and the phi itself, is that node.
(defn collapse [(cx (mut st/State)) (n i32)] (-> i32)
  (let [role (ir/role (graph/op (.g cx) n))]
    (cond (and (or (= role 3) (= role 4)) (= (graph/arity (.g cx) n) 1)) (graph/input (.g cx) n 0)
          (= role 8)
            (let [(mut only) (: 0 i32)
                  (mut several) false]
              (for i (range 1 (graph/arity (.g cx) n))
                (let [v (graph/input (.g cx) n i)]
                  (when (!= v n)
                    (if (or (= only 0) (= only v)) (set! only v) (set! several true)))))
              (if several 0 only))
          :else 0)))
;;; Keep what control from the start reaches and what
;;; that reads, and drop the rest, which may be rings of values that only read
;;; each other.
(defn sweep! [(cx (mut st/State))] (-> void)
  (let [(mut keep) (ArrayList::new [bool] (.alc cx))
        (mut stack) (ArrayList::new [i32] (.alc cx))]
    (for _ (range 0 (graph/size (.g cx))) (push! (mut keep) false))
    (when (!= (.start (.g cx)) 0)
      (set! (mut keep) (cast i64 (.start (.g cx))) true)
      (push! (mut stack) (.start (.g cx))))
    (while (> (len stack) 0)
      (let [n (get stack (- (len stack) 1))]
        (pop! (mut stack))
        ; Whatever a kept node reads is kept.
        (for i (range 0 (graph/arity (.g cx) n))
          (let [d (graph/input (.g cx) n i)]
            (when (and (!= d 0) (not (get keep (cast i64 d))))
              (set! (mut keep) (cast i64 d) true)
              (push! (mut stack) d))))
        ; Control goes on to the control nodes that follow a kept one.
        (when (ir/control-node? (graph/op (.g cx) n))
          (let [(mut e) (graph/first-use (.g cx) n)]
            (while (>= e 0)
              (let [u (graph/user (.g cx) e)
                    role (ir/role (graph/op (.g cx) u))]
                (when (and (not (get keep (cast i64 u))) (ir/control-node? (graph/op (.g cx) u))
                           (or (= role 3) (= role 4) (= (graph/input (.g cx) u 0) n)))
                  (set! (mut keep) (cast i64 u) true)
                  (push! (mut stack) u)))
              (set! e (graph/next-use (.g cx) e)))))))
    (for i (range 1 (graph/size (.g cx)))
      (let [n (cast i32 i)]
        (unless (or (get keep i) (graph/dead? (.g cx) n)) (graph/drop! (mut (.g cx)) n))))
    (free! (mut keep))
    (free! (mut stack))))
;;; Apply folding and the rules until nothing changes. Returns how many
;;; replacements were made; `counts`, if not empty, gets one more per rule fired.
(defn run-counting [(cx (mut st/State)) (counts (mut (ArrayList i64)))] (-> i64)
  (let [(mut work) (ArrayList::new [i32] (.alc cx))
        (mut queued) (ArrayList::new [bool] (.alc cx))
        (mut changes) 0
        (mut cut) false]
    (for i (range 1 (graph/size (.g cx)))
      (let [n (cast i32 (- (graph/size (.g cx)) i))]
        (unless (graph/dead? (.g cx) n) (enqueue! (mut work) (mut queued) n))))
    (while (> (len work) 0)
      (let [n (get work (- (len work) 1))]
        (pop! (mut work))
        (set! (mut queued) (cast i64 n) false)
        (unless (graph/dead? (.g cx) n)
          ; What a rule makes in place of `n` comes from where `n` came from.
          (graph/from! (mut (.g cx)) n)
          (let [operation (graph/op (.g cx) n)]
            (if (and (ir/pure? operation) (= (graph/use-count (.g cx) n) 0))
                (do (graph/kill! (mut (.g cx)) n ir/PURE) (do))
                (do
                  ; A commutative node keeps its operands in the builder's order.
                  (when (and (ir/commutative? operation) (= (graph/arity (.g cx) n) 2))
                    (let [a (graph/input (.g cx) n 0)
                          b (graph/input (.g cx) n 1)]
                      (when (ir/swap? (.g cx) a b)
                        (graph/set-input! (mut (.g cx)) n 0 b)
                        (graph/set-input! (mut (.g cx)) n 1 a))))
                  (if (thread! (mut cx) (mut work) (mut queued) n)
                      (do (set! changes (+ changes 1)) (set! cut true))
                  (do
                  (settle-phis! (mut cx) (mut work) (mut queued) n)
                  (let [collapsed (collapse (mut cx) n)
                        plain (if (!= collapsed 0) collapsed (fold (mut cx) n))
                        folded (if (!= plain 0) plain (fold-phi (mut cx) n))
                        simpler (if (!= folded 0) folded (simplify (mut cx) n))
                        ; Unchanged by any rule: it may now equal a node already there.
                        ; Two frame objects alike in every way are still two objects.
                        other (if (and (= simpler 0) (ir/pure? operation) (!= (ir/role operation) 15))
                                  (graph/canonical! (mut (.g cx)) n)
                                  simpler)]
                    (when (< other 0)
                      (when (> (len counts) (.fired cx))
                        (set! (mut counts) (.fired cx) (+ (get counts (.fired cx)) 1)))
                      (set! changes (+ changes 1))
                      (set! cut true)
                      (branch! (mut cx) (mut work) (mut queued) n (= other -1)))
                    (when (and (> other 0) (!= other n))
                      (when (and (!= simpler 0) (> (len counts) (.fired cx)))
                        (set! (mut counts) (.fired cx) (+ (get counts (.fired cx)) 1)))
                      (set! changes (+ changes 1))
                      (replace! (mut cx) (mut work) (mut queued) n other)))))))))))
    (graph/from! (mut (.g cx)) 0)
    (free! (mut work))
    (free! (mut queued))
    ; Always: rings of phis that only feed each other are dead without any cut.
    (when (or cut (> changes 0) (.swept cx)) (sweep! (mut cx)))
    (set! (.swept cx) false)
    (st/grow-nodes! (mut cx))
    changes))
(defn run [(cx (mut st/State))] (-> i64)
  (let [(mut none) (ArrayList::new [i64] (.alc cx))]
    (run-counting (mut cx) (mut none))))
(defn instance-1 [(cx (mut st/State)) (rnd (mut Rnd)) (main i32)] (-> i32)
  (let [v*0 (narrowed! (mut cx) (mut rnd) (ir/make-param! (mut (.g cx)) (deviate! (mut rnd) main) 0)) ] (ir/add! (mut (.g cx)) (deviate! (mut rnd) main) v*0 (let [t* (deviate! (mut rnd) main)] (ir/make-const! (mut (.g cx)) t* (bv/cut (primitive/cast u64 0) (ir/type-bits t*)))))))
(defn instance-2 [(cx (mut st/State)) (rnd (mut Rnd)) (main i32)] (-> i32)
  (let [v*0 (narrowed! (mut cx) (mut rnd) (ir/make-param! (mut (.g cx)) (deviate! (mut rnd) main) 0)) ] (ir/sub! (mut (.g cx)) (deviate! (mut rnd) main) v*0 (let [t* (deviate! (mut rnd) main)] (ir/make-const! (mut (.g cx)) t* (bv/cut (primitive/cast u64 0) (ir/type-bits t*)))))))
(defn instance-3 [(cx (mut st/State)) (rnd (mut Rnd)) (main i32)] (-> i32)
  (let [v*0 (narrowed! (mut cx) (mut rnd) (ir/make-param! (mut (.g cx)) (deviate! (mut rnd) main) 0)) ] (ir/sub! (mut (.g cx)) (deviate! (mut rnd) main) v*0 v*0)))
(defn instance-4 [(cx (mut st/State)) (rnd (mut Rnd)) (main i32)] (-> i32)
  (let [v*0 (narrowed! (mut cx) (mut rnd) (ir/make-param! (mut (.g cx)) (deviate! (mut rnd) main) 0)) ] (ir/sub! (mut (.g cx)) (deviate! (mut rnd) main) (let [t* (deviate! (mut rnd) main)] (ir/make-const! (mut (.g cx)) t* (bv/cut (primitive/cast u64 0) (ir/type-bits t*)))) v*0)))
(defn instance-5 [(cx (mut st/State)) (rnd (mut Rnd)) (main i32)] (-> i32)
  (let [v*0 (narrowed! (mut cx) (mut rnd) (ir/make-param! (mut (.g cx)) (deviate! (mut rnd) main) 0)) ] (ir/mul! (mut (.g cx)) (deviate! (mut rnd) main) v*0 (let [t* (deviate! (mut rnd) main)] (ir/make-const! (mut (.g cx)) t* (bv/cut (primitive/cast u64 1) (ir/type-bits t*)))))))
(defn instance-6 [(cx (mut st/State)) (rnd (mut Rnd)) (main i32)] (-> i32)
  (let [v*0 (narrowed! (mut cx) (mut rnd) (ir/make-param! (mut (.g cx)) (deviate! (mut rnd) main) 0)) ] (ir/mul! (mut (.g cx)) (deviate! (mut rnd) main) v*0 (let [t* (deviate! (mut rnd) main)] (ir/make-const! (mut (.g cx)) t* (bv/cut (primitive/cast u64 0) (ir/type-bits t*)))))))
(defn instance-7 [(cx (mut st/State)) (rnd (mut Rnd)) (main i32)] (-> i32)
  (let [v*0 (narrowed! (mut cx) (mut rnd) (ir/make-param! (mut (.g cx)) (deviate! (mut rnd) main) 0)) ] (ir/and! (mut (.g cx)) (deviate! (mut rnd) main) v*0 (let [t* (deviate! (mut rnd) main)] (ir/make-const! (mut (.g cx)) t* (bv/cut (primitive/cast u64 0) (ir/type-bits t*)))))))
