  (let [v*0 (narrowed! (mut cx) (mut rnd) (ir/make-param! (mut (.g cx)) (deviate! (mut rnd) main) 0)) v*1 (narrowed! (mut cx) (mut rnd) (ir/make-param! (mut (.g cx)) (deviate! (mut rnd) main) 1)) v*2 (narrowed! (mut cx) (mut rnd) (ir/make-param! (mut (.g cx)) (deviate! (mut rnd) main) 2)) ] (ir/cond! (mut (.g cx)) (deviate! (mut rnd) main) (ir/not! (mut (.g cx)) (deviate! (mut rnd) main) v*0) v*1 v*2)))
(defn instance-58 [(cx (mut st/State)) (rnd (mut Rnd)) (main i32)] (-> i32)
  (let [v*0 (narrowed! (mut cx) (mut rnd) (ir/make-param! (mut (.g cx)) (deviate! (mut rnd) main) 0)) ] (ir/zext! (mut (.g cx)) (deviate! (mut rnd) main) (ir/zext! (mut (.g cx)) (deviate! (mut rnd) main) v*0))))
(defn instance-59 [(cx (mut st/State)) (rnd (mut Rnd)) (main i32)] (-> i32)
  (let [v*0 (narrowed! (mut cx) (mut rnd) (ir/make-param! (mut (.g cx)) (deviate! (mut rnd) main) 0)) ] (ir/sext! (mut (.g cx)) (deviate! (mut rnd) main) (ir/sext! (mut (.g cx)) (deviate! (mut rnd) main) v*0))))
(defn instance-60 [(cx (mut st/State)) (rnd (mut Rnd)) (main i32)] (-> i32)
  (let [v*0 (narrowed! (mut cx) (mut rnd) (ir/make-param! (mut (.g cx)) (deviate! (mut rnd) main) 0)) ] (ir/sext! (mut (.g cx)) (deviate! (mut rnd) main) (ir/zext! (mut (.g cx)) (deviate! (mut rnd) main) v*0))))
(defn instance-61 [(cx (mut st/State)) (rnd (mut Rnd)) (main i32)] (-> i32)
  0)
(defn instance-62 [(cx (mut st/State)) (rnd (mut Rnd)) (main i32)] (-> i32)
  0)
(defn instance-63 [(cx (mut st/State)) (rnd (mut Rnd)) (main i32)] (-> i32)
  0)
(defn instance-64 [(cx (mut st/State)) (rnd (mut Rnd)) (main i32)] (-> i32)
  0)
(defstruct Rnd [(state u64)])
(defn roll! [(rnd (mut Rnd))] (-> u64)
  (let [(mut x) (.state rnd)]
    (set! x (^ x (<< x 13))) (set! x (^ x (>> x 7))) (set! x (^ x (<< x 17)))
    (set! (.state rnd) x)
    x))
(defn value-type! [(rnd (mut Rnd))] (-> i32)
  (let [(mut type) (: 0 i32)]
    (while (not (ir/value-type? type))
      (set! type (cast i32 (+ 1 (cast i64 (% (roll! (mut rnd)) (cast u64 ir/TYPES)))))))
    type))
;;; The trial's main type, or one time in three some other.
(defn deviate! [(rnd (mut Rnd)) (main i32)] (-> i32)
  (if (= (% (roll! (mut rnd)) 3) 0) (value-type! (mut rnd)) main))
;;; Values that find mistakes: zero, one, the edges of every width, and noise.
(defn interesting! [(rnd (mut Rnd))] (-> u64)
  (let [k (% (roll! (mut rnd)) 16)]
    (cond (= k 0) (: 0 u64) (= k 1) (: 1 u64) (= k 2) (: 0xFFFFFFFFFFFFFFFF u64)
          (= k 3) (: 2 u64) (= k 4) (: 0x7F u64) (= k 5) (: 0x80 u64) (= k 6) (: 0xFF u64)
          (= k 7) (: 0x7FFF u64) (= k 8) (: 0x8000 u64) (= k 9) (: 0x7FFFFFFF u64)
          (= k 10) (: 0x80000000 u64) (= k 11) (: 0x8000000000000000 u64)
          (= k 12) (<< (: 1 u64) (% (roll! (mut rnd)) 64))
          (= k 13) (% (roll! (mut rnd)) 64)
          :else (roll! (mut rnd)))))
;;; A parameter, or one time in three its low few bits, so that rules which ask
;;; what is known of a value meet values of which something is known.
(defn narrowed! [(cx (mut st/State)) (rnd (mut Rnd)) (p i32)] (-> i32)
  p)
(defn instance [(cx (mut st/State)) (rnd (mut Rnd)) (rule i64) (main i32)] (-> i32)
  (match rule
    (1 (instance-1 (mut cx) (mut rnd) main))
    (2 (instance-2 (mut cx) (mut rnd) main))
    (3 (instance-3 (mut cx) (mut rnd) main))
    (4 (instance-4 (mut cx) (mut rnd) main))
    (5 (instance-5 (mut cx) (mut rnd) main))
    (6 (instance-6 (mut cx) (mut rnd) main))
    (7 (instance-7 (mut cx) (mut rnd) main))
    (8 (instance-8 (mut cx) (mut rnd) main))
    (9 (instance-9 (mut cx) (mut rnd) main))
    (10 (instance-10 (mut cx) (mut rnd) main))
    (11 (instance-11 (mut cx) (mut rnd) main))
    (12 (instance-12 (mut cx) (mut rnd) main))
    (13 (instance-13 (mut cx) (mut rnd) main))
    (14 (instance-14 (mut cx) (mut rnd) main))
    (15 (instance-15 (mut cx) (mut rnd) main))
    (16 (instance-16 (mut cx) (mut rnd) main))
    (17 (instance-17 (mut cx) (mut rnd) main))
    (18 (instance-18 (mut cx) (mut rnd) main))
    (19 (instance-19 (mut cx) (mut rnd) main))
    (20 (instance-20 (mut cx) (mut rnd) main))
    (21 (instance-21 (mut cx) (mut rnd) main))
    (22 (instance-22 (mut cx) (mut rnd) main))
    (23 (instance-23 (mut cx) (mut rnd) main))
    (24 (instance-24 (mut cx) (mut rnd) main))
    (25 (instance-25 (mut cx) (mut rnd) main))
    (26 (instance-26 (mut cx) (mut rnd) main))
    (27 (instance-27 (mut cx) (mut rnd) main))
    (28 (instance-28 (mut cx) (mut rnd) main))
    (29 (instance-29 (mut cx) (mut rnd) main))
    (30 (instance-30 (mut cx) (mut rnd) main))
    (31 (instance-31 (mut cx) (mut rnd) main))
    (32 (instance-32 (mut cx) (mut rnd) main))
    (33 (instance-33 (mut cx) (mut rnd) main))
    (34 (instance-34 (mut cx) (mut rnd) main))
    (35 (instance-35 (mut cx) (mut rnd) main))
    (36 (instance-36 (mut cx) (mut rnd) main))
    (37 (instance-37 (mut cx) (mut rnd) main))
    (38 (instance-38 (mut cx) (mut rnd) main))
    (39 (instance-39 (mut cx) (mut rnd) main))
    (40 (instance-40 (mut cx) (mut rnd) main))
    (41 (instance-41 (mut cx) (mut rnd) main))
    (42 (instance-42 (mut cx) (mut rnd) main))
    (43 (instance-43 (mut cx) (mut rnd) main))
    (44 (instance-44 (mut cx) (mut rnd) main))
    (45 (instance-45 (mut cx) (mut rnd) main))
    (46 (instance-46 (mut cx) (mut rnd) main))
    (47 (instance-47 (mut cx) (mut rnd) main))
    (48 (instance-48 (mut cx) (mut rnd) main))
    (49 (instance-49 (mut cx) (mut rnd) main))
    (50 (instance-50 (mut cx) (mut rnd) main))
    (51 (instance-51 (mut cx) (mut rnd) main))
    (52 (instance-52 (mut cx) (mut rnd) main))
    (53 (instance-53 (mut cx) (mut rnd) main))
    (54 (instance-54 (mut cx) (mut rnd) main))
    (55 (instance-55 (mut cx) (mut rnd) main))
    (56 (instance-56 (mut cx) (mut rnd) main))
    (57 (instance-57 (mut cx) (mut rnd) main))
    (58 (instance-58 (mut cx) (mut rnd) main))
    (59 (instance-59 (mut cx) (mut rnd) main))
    (60 (instance-60 (mut cx) (mut rnd) main))
    (61 (instance-61 (mut cx) (mut rnd) main))
    (62 (instance-62 (mut cx) (mut rnd) main))
    (63 (instance-63 (mut cx) (mut rnd) main))
    (64 (instance-64 (mut cx) (mut rnd) main))
    (_ 0)))
;;; Every rule against the nodes' meanings: its pattern is built over
;;; parameters with `tries` choices of types and constants, and wherever a
;;; rule applies, the node and its replacement must have one type and one
;;; value for 64 choices of the parameters. Prints what is wrong and returns
;;; how many rules are wrong or were never seen to apply.
(defn check-rules [(cx (mut st/State)) (tries i64)] (-> i64)
  (let [(mut rnd) (Rnd :state (: 0x9E3779B97F4A7C15 u64))
        (mut applied) (ArrayList::new [i64] (.alc cx))
        (mut wrong) (ArrayList::new [bool] (.alc cx))
        (mut args) (ArrayList::new [u64] (.alc cx))
        (mut bad) 0]
    (for _ (range 0 (+ RULES 1)) (push! (mut applied) 0) (push! (mut wrong) false))
    (for _ (range 0 8) (push! (mut args) 0))
    (for rule (range 1 (+ RULES 1))
      (let [(mut checkable) true]
        (for _ (range 0 tries)
          (when checkable
            (graph/release! (mut (.g cx)))
            (set! (.g cx) (graph/create (.alc cx)))
            (let [main (value-type! (mut rnd))
                  root (instance (mut cx) (mut rnd) rule main)]
              (if (= root 0)
                  (set! checkable false)
                  (when (= (ir/verify (.g cx)) "")
                    (st/begin! (mut cx))
                    (set! (.fired cx) 0)
                    (let [new (simplify (mut cx) root)
                          fired (.fired cx)]
                      (when (and (!= new 0) (> fired 0) (not (get wrong fired)))
                        (set! (mut applied) fired (+ (get applied fired) 1))
                        (cond
                          (!= (graph/ty (.g cx) new) (graph/ty (.g cx) root))
                            (do (println "  WRONG {}: a {} becomes a {}" (rule-name fired)
                                         (ir/type-name (graph/ty (.g cx) root))
                                         (ir/type-name (graph/ty (.g cx) new)))
                                (set! (mut wrong) fired true))
                          (!= (ir/verify (.g cx)) "")
                            (do (println "  WRONG {}: it builds a node that is not well formed: {}"
                                         (rule-name fired) (ir/verify (.g cx)))
                                (set! (mut wrong) fired true))
                          :else
                            (for _ (range 0 64)
                              (unless (get wrong fired)
                                (for i (range 0 8) (set! (mut args) i (interesting! (mut rnd))))
                                (let [before (ir/eval-node (.g cx) (slice args) root)
                                      after (ir/eval-node (.g cx) (slice args) new)]
                                  (when (!= before after)
                                    (println "  WRONG {}: on a {} with parameters {:x} {:x} {:x}, {:x} became {:x}"
                                             (rule-name fired) (ir/type-name (graph/ty (.g cx) root))
                                             (get args 0) (get args 1) (get args 2) before after)
                                    (set! (mut wrong) fired true)))))))))))))
        (unless checkable
          (println "  not checked, its pattern is not a value of its inputs alone: {}" (rule-name rule))
          (set! (mut applied) rule -1))))
    (for rule (range 1 (+ RULES 1))
      (when (get wrong rule) (set! bad (+ bad 1)))
      (when (= (get applied rule) 0)
        (println "  never seen to apply: {}" (rule-name rule))
        (set! bad (+ bad 1))))
    bad))

