;;; Whether `n` is computed again in each block that needs it.
(defn local? [(cx (mut st/State)) (n i32)] (-> bool) (and (not (mach/kept? (mut cx) n)) (or false (= (graph/op (.g cx) n) ir/CONST) (= (graph/op (.g cx) n) ir/SLOT) (= (graph/op (.g cx) n) ir/SYMBOL) (= (graph/op (.g cx) n) ir/EXTERN))))
;;; The node `n` simply is, by the rule chosen for it, or 0.
(defn alias-of [(cx (mut st/State)) (n i32)] (-> i32)
  (match (mach/rule-of (mut cx) n)
    (112 (graph/input (.g cx) n 0))
    (113 (graph/input (.g cx) n 0))
    (117 (graph/input (.g cx) n 0))
    (147 (graph/input (.g cx) n 0))
    (_ (: 0 i32))))
;;; The register that holds `n` where instructions are being emitted.
(defn operand [(cx (mut st/State)) (n i32)] (-> i64)
  (if (not (local? (mut cx) n))
      (let [same (alias-of (mut cx) n)]
        (if (!= same 0) (operand (mut cx) same) (cast i64 n)))
      (let [r (mach/local (mut cx) n)]
        (if (!= r 0)
            r
            (let [fresh (mach/fresh (mut cx))]
              (mach/set-local (mut cx) n fresh)
              (emit (mut cx) n (mach/rule-of (mut cx) n) fresh)
              fresh)))))
;;; A constant's value as a rule sees it: signed if its type is.
(defn payload-value [(cx (mut st/State)) (n i32)] (-> i64)
  (if (ir/type-signed? (graph/ty (.g cx) n))
      (bv/signed (graph/payload (.g cx) n) (ir/type-bits (graph/ty (.g cx) n)))
      (primitive/cast i64 (graph/payload (.g cx) n))))
;;; `n` in a register with its value carried up to 32 bits: by sign (1), by
;;; zeros (0) or as its type says (2). A value 32 bits wide or more is as it is.
(defn extended [(cx (mut st/State)) (n i32) (how i64)] (-> i64)
  (let [bits (ir/type-bits (graph/ty (.g cx) n))
        r (operand (mut cx) n)]
    (if (>= bits 32)
        r
        (let [t (mach/fresh (mut cx))]
          (if (or (= how 1) (and (= how 2) (ir/type-signed? (graph/ty (.g cx) n))))
              (sign-extend (mut cx) t r bits)
              (zero-extend (mut cx) t r bits))
          t))))
