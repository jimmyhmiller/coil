;;; Every fact against the nodes' meanings: random values are built, the facts
;;; solved, and for 64 choices of the parameters each node's value must be what
;;; its facts promise. Prints what is wrong and returns how many facts are.
(defn check-facts [(cx (mut st/State)) (tries i64)] (-> i64)
  (let [(mut rnd) (Rnd :state (: 0x2545F4914F6CDD1D u64))
        (mut args) (ArrayList::new [u64] (.alc cx))
        (mut wrong) (ArrayList::new [bool] (.alc cx))
        (mut bad) 0]
    (for _ (range 0 8) (push! (mut args) 0))
    (for _ (range 0 1) (push! (mut wrong) false))
    (for _ (range 0 tries)
      (graph/release! (mut (.g cx)))
      (set! (.g cx) (graph/create (.alc cx)))
      (random-node! (mut cx) (mut rnd) (value-type! (mut rnd)) 4)
      (when (= (ir/verify (.g cx)) "")
        (st/begin! (mut cx))
        (solve (mut cx))
        (for _ (range 0 64)
          (for i (range 0 8) (set! (mut args) i (interesting! (mut rnd))))
          (for i (range 1 (graph/size (.g cx)))
            (let [n (cast i32 i)]
              (when (and (not (graph/dead? (.g cx) n)) (ir/value-type? (graph/ty (.g cx) n))
                         (not (ir/type-float? (graph/ty (.g cx) n))))
                (let [value* (ir/eval-node (.g cx) (slice args) n)]
                  (unless (or (get wrong 0) 
                              (<= (bv/bit-length (primitive/cast u64 (primitive/cast i64 value*))) (width (mut cx) n)))
                    (println "  WRONG fact width: a {} {} has the value {:x}, and the fact says {}" (ir/type-name (graph/ty (.g cx) n)) (ir/name (graph/op (.g cx) n)) value* (width (mut cx) n))
                    (set! (mut wrong) 0 true))
                  (do))))))))
    (for w wrong (when w (set! bad (+ bad 1))))
    bad))

