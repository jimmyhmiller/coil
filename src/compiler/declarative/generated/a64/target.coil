;;; The bits that encode `v` as a logical immediate, or -1 if it is not one.
(defn logical-code [(v i64)] (-> i64)
  (let [want (primitive/cast u64 v)
        (mut lo) 0
        (mut hi) 5334]
    (while (< lo hi)
      (let [mid (/ (+ lo hi) 2)]
        (if (< (get LOGICAL-VALUES mid) want) (set! lo (+ mid 1)) (set! hi mid))))
    (if (and (< lo 5334) (= (get LOGICAL-VALUES lo) want))
        (get LOGICAL-CODES lo)
        -1)))
