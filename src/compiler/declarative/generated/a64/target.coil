(const ALIGN 4)
;;; How many bytes an instruction takes.
(defn size [(out (mut (ArrayList u8))) (op i64) (a i64) (b i64) (c i64) (d i64) (e i64)] (-> i64) ALIGN)
;;; An instruction's bytes, appended to `out`. A label operand is the distance in
;;; bytes from this instruction to its target. Returns where in the instruction
;;; its symbol's bits are, to be filled in when addresses are known, or -1.
(defn encode! [(out (mut (ArrayList u8))) (op i64) (a i64) (b i64) (c i64) (d i64) (e i64)] (-> i64)
  (put-word! (mut out) (cast u64 (word-of op a b c d e)))
  (if (!= (get RELOCS op) 0) 0 -1))
;;; A finished word appended to `out`.
(defn put-word! :inline (Always) [(out (mut (ArrayList u8))) (word u64)] (-> void)
  (let [w (cast u32 word)
        at (len out)]
    (when (> (+ at ALIGN) (cap out)) (reserve! (mut out) (if (< (cap out) 256) 256 (* (cap out) 2))))
    (let [p (primitive/index (load (field out data)) at)]
      (for k (range 0 ALIGN)
        (primitive/store! (primitive/index p k) (primitive/cast u8 (& (>> w (cast u32 (* k 8))) 255)))))
    (primitive/store! (field out len) (+ at ALIGN))))
