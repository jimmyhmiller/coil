(defn range-grow! [(cx (mut State))] (-> void)
  (let [n (let [twice (* 2 (.range-room cx))] (if (< twice 64) 64 twice))]
  (extend-zeroed! (mut (.from cx)) (- n (len (.from cx))))
  (extend-zeroed! (mut (.to cx)) (- n (len (.to cx))))
  (extend-zeroed! (mut (.next-range cx)) (- n (len (.next-range cx))))
  (set! (.range-room cx) n)))
(defn use-new! :inline (Always) [(cx (mut State))] (-> i32)
  (set! (.use-count cx) (+ (.use-count cx) 1))
  (when (>= (cast i64 (.use-count cx)) (.use-room cx)) (use-grow! (mut cx)))
  (.use-count cx))
(defn use-grow! [(cx (mut State))] (-> void)
  (let [n (let [twice (* 2 (.use-room cx))] (if (< twice 64) 64 twice))]
  (extend-zeroed! (mut (.pos cx)) (- n (len (.pos cx))))
  (extend-zeroed! (mut (.next-use cx)) (- n (len (.next-use cx))))
  (set! (.use-room cx) n)))
(defn piece-new! :inline (Always) [(cx (mut State))] (-> i32)
  (set! (.piece-count cx) (+ (.piece-count cx) 1))
  (when (>= (cast i64 (.piece-count cx)) (.piece-room cx)) (piece-grow! (mut cx)))
  (.piece-count cx))
(defn piece-grow! [(cx (mut State))] (-> void)
  (let [n (let [twice (* 2 (.piece-room cx))] (if (< twice 64) 64 twice))]
  (extend-zeroed! (mut (.owner cx)) (- n (len (.owner cx))))
  (extend-zeroed! (mut (.ranges cx)) (- n (len (.ranges cx))))
  (extend-zeroed! (mut (.last-range cx)) (- n (len (.last-range cx))))
  (extend-zeroed! (mut (.first-use cx)) (- n (len (.first-use cx))))
  (extend-zeroed! (mut (.last-use cx)) (- n (len (.last-use cx))))
  (extend-zeroed! (mut (.pstart cx)) (- n (len (.pstart cx))))
  (extend-zeroed! (mut (.pend cx)) (- n (len (.pend cx))))
  (extend-zeroed! (mut (.reg cx)) (- n (len (.reg cx))))
  (extend-zeroed! (mut (.in-frame cx)) (- n (len (.in-frame cx))))
  (extend-zeroed! (mut (.next-piece cx)) (- n (len (.next-piece cx))))
  (extend-zeroed! (mut (.prev-piece cx)) (- n (len (.prev-piece cx))))
  (set! (.piece-room cx) n)))
(defn phys-new! :inline (Always) [(cx (mut State))] (-> i32)
  (set! (.phys-count cx) (+ (.phys-count cx) 1))
  (when (>= (cast i64 (.phys-count cx)) (.phys-room cx)) (phys-grow! (mut cx)))
  (.phys-count cx))
(defn phys-grow! [(cx (mut State))] (-> void)
  (let [n (let [twice (* 2 (.phys-room cx))] (if (< twice 64) 64 twice))]
  (extend-zeroed! (mut (.fixed cx)) (- n (len (.fixed cx))))
  (extend-zeroed! (mut (.last-fixed cx)) (- n (len (.last-fixed cx))))
  (extend-zeroed! (mut (.free-until cx)) (- n (len (.free-until cx))))
  (extend-zeroed! (mut (.needed-at cx)) (- n (len (.needed-at cx))))
  (extend-zeroed! (mut (.blocked-at cx)) (- n (len (.blocked-at cx))))
  (extend-zeroed! (mut (.giving-up cx)) (- n (len (.giving-up cx))))
  (set! (.phys-room cx) n)))
(defn grow-nodes! [(cx (mut State))] (-> void)
  (let [a (.alc cx) nodes (graph/size (.g cx))]
  (when (< (len (.fact-width cx)) nodes) (extend-zeroed! (mut (.fact-width cx)) (- nodes (len (.fact-width cx)))))
  (when (< (len (.block-of cx)) nodes) (extend-zeroed! (mut (.block-of cx)) (- nodes (len (.block-of cx)))))
  (when (< (len (.chain-pos cx)) nodes) (extend-zeroed! (mut (.chain-pos cx)) (- nodes (len (.chain-pos cx)))))
  (when (< (len (.reaching cx)) nodes) (extend-zeroed! (mut (.reaching cx)) (- nodes (len (.reaching cx)))))
  (when (< (len (.varies cx)) nodes) (extend-zeroed! (mut (.varies cx)) (- nodes (len (.varies cx)))))
  (when (< (len (.steady cx)) nodes) (extend-zeroed! (mut (.steady cx)) (- nodes (len (.steady cx)))))
  (when (< (len (.ahead-seen cx)) nodes) (extend-zeroed! (mut (.ahead-seen cx)) (- nodes (len (.ahead-seen cx)))))
  (when (< (len (.ahead cx)) nodes) (extend-zeroed! (mut (.ahead cx)) (- nodes (len (.ahead cx)))))
  (when (< (len (.early-done cx)) nodes) (extend-zeroed! (mut (.early-done cx)) (- nodes (len (.early-done cx)))))
  (when (< (len (.late-done cx)) nodes) (extend-zeroed! (mut (.late-done cx)) (- nodes (len (.late-done cx)))))
  (when (< (len (.placed cx)) nodes) (extend-zeroed! (mut (.placed cx)) (- nodes (len (.placed cx)))))
  (when (< (len (.needed cx)) nodes) (extend-zeroed! (mut (.needed cx)) (- nodes (len (.needed cx)))))
  (when (< (len (.tile cx)) nodes) (extend-zeroed! (mut (.tile cx)) (- nodes (len (.tile cx)))))
  (when (< (len (.local-reg cx)) nodes) (extend-zeroed! (mut (.local-reg cx)) (- nodes (len (.local-reg cx)))))
  (when (< (len (.local-block cx)) nodes) (extend-zeroed! (mut (.local-block cx)) (- nodes (len (.local-block cx)))))
  (when (< (len (.kept cx)) nodes) (extend-zeroed! (mut (.kept cx)) (- nodes (len (.kept cx)))))
  (when (< (len (.object-at cx)) nodes) (extend-zeroed! (mut (.object-at cx)) (- nodes (len (.object-at cx)))))
  (when (< (len (.pair-with cx)) nodes) (extend-zeroed! (mut (.pair-with cx)) (- nodes (len (.pair-with cx)))))
  (when (< (len (.pair-second cx)) nodes) (extend-zeroed! (mut (.pair-second cx)) (- nodes (len (.pair-second cx)))))
  (when (< (len (.pair-first cx)) nodes) (extend-zeroed! (mut (.pair-first cx)) (- nodes (len (.pair-first cx)))))
  (when (< (len (.pair-base cx)) nodes) (extend-zeroed! (mut (.pair-base cx)) (- nodes (len (.pair-base cx)))))
  (when (< (len (.pair-at cx)) nodes) (extend-zeroed! (mut (.pair-at cx)) (- nodes (len (.pair-at cx)))))
  (when (< (len (.homed cx)) nodes) (extend-zeroed! (mut (.homed cx)) (- nodes (len (.homed cx)))))
  0))
