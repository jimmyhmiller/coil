;;; The instructions of rule `rule` for `v`, its value left in register
;;; `given` if that is not 0, else in one the registers module chooses.
(defn emit [(cx (mut st/State)) (v i32) (rule i64) (given i64)] (-> void)
  (match rule
    (1 (do (regs/clobbers (mut cx) (| (: 0 u64) (: 0 u64) (isa/implicit-writes 98))) (let [] (let [out (if (!= given 0) given (regs/write (mut cx) v))] (mach/emit-word (mut cx) 98 (cast u64 (isa/word-98 (if (= (ops/type-bits (view/ty (.f cx) (- (cast i64 v) 1))) 64) 1 0) (- -1 out) (- -1 -32) 0 0))) (regs/finish (mut cx) v given)))))
    (2 (do (regs/clobbers (mut cx) (| (: 0 u64) (: 0 u64) (<< (: 1 u64) (cast u64 (- 0 (+ -17 1)))) (isa/implicit-writes 98))) (let [] (let [out (if (!= given 0) given (regs/write (mut cx) v))] (tpl/constant (mut cx) -17 (& (view/imm (.f cx) (- (cast i64 v) 1)) 4294967295)) (mach/emit-word (mut cx) 98 (cast u64 (isa/word-98 0 (- -1 out) (- -1 -17) 0 0))) (regs/finish (mut cx) v given)))))
