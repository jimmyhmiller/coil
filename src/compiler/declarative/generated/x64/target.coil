;;; How many bytes an instruction takes, with these operands.
(defn size [(out (mut (ArrayList u8))) (op i64) (a i64) (b i64) (c i64) (d i64) (e i64)] (-> i64)
  (let [start (len out)]
    (encode! (mut out) op a b c d e)
    (let [bytes (- (len out) start)]
      (for _ (range 0 bytes) (pop! (mut out)))
      bytes)))
(defn patch [(op i64) (word u32) (s i64) (g i64) (p i64)] (-> u32)
  (match op
    (46 (primitive/cast u32 (& (- (- s p) 4) 4294967295)))
    (48 (primitive/cast u32 (& (- (- s p) 4) 4294967295)))
    (49 (primitive/cast u32 (& (- (- s p) 4) 4294967295)))
    (50 (primitive/cast u32 (& (- (- g p) 4) 4294967295)))
    (_ word)))

