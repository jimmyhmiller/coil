(defn make-const! [(g (mut graph/Graph)) (type i32) (value u64)] (-> i32) (const! (mut g) type value))
(defn make-phi! [(g (mut graph/Graph)) (type i32) (region i32) (count i64)] (-> i32) (phi! (mut g) type region count))
(defn verify-node [(g graph/Graph) (n i32)] (-> (slice u8))
  (let [type (graph/ty g n) k (graph/arity g n)]
    (match (graph/op g n)
      (1 (cond
        (!= k 0) "START: wrong number of inputs"
        (!= type T-CTRL) "START: type is not ctrl"
        :else ""))
      (2 (cond
        (< k 1) "RETURN: wrong number of inputs"
        (!= type 0) "RETURN: has a type"
        (= (graph/input g n 0) 0) "RETURN: missing operand c"
        (not (control-node? (graph/op g (graph/input g n 0)))) "RETURN: operand c is not control"
        (not (variadic-ok? g n 1 -1)) "RETURN: bad operand among values"
        :else ""))
      (3 (cond
        (< k 0) "REGION: wrong number of inputs"
        (!= type T-CTRL) "REGION: type is not ctrl"
        (not (variadic-ok? g n 0 -2)) "REGION: bad operand among c"
        :else ""))
      (4 (cond
        (< k 0) "LOOP: wrong number of inputs"
        (!= type T-CTRL) "LOOP: type is not ctrl"
        (not (variadic-ok? g n 0 -2)) "LOOP: bad operand among c"
        :else ""))
      (5 (cond
        (!= k 2) "IF: wrong number of inputs"
        (!= type T-CTRL) "IF: type is not ctrl"
        (= (graph/input g n 0) 0) "IF: missing operand c"
        (not (control-node? (graph/op g (graph/input g n 0)))) "IF: operand c is not control"
        (= (graph/input g n 1) 0) "IF: missing operand cond"
        (!= (graph/ty g (graph/input g n 1)) T-BOOL) "IF: operand cond has the wrong type"
        :else ""))
      (6 (cond
        (!= k 1) "TRUE: wrong number of inputs"
        (!= type T-CTRL) "TRUE: type is not ctrl"
        (= (graph/input g n 0) 0) "TRUE: missing operand branch"
        (not (control-node? (graph/op g (graph/input g n 0)))) "TRUE: operand branch is not control"
        :else ""))
      (7 (cond
        (!= k 1) "FALSE: wrong number of inputs"
        (!= type T-CTRL) "FALSE: type is not ctrl"
        (= (graph/input g n 0) 0) "FALSE: missing operand branch"
        (not (control-node? (graph/op g (graph/input g n 0)))) "FALSE: operand branch is not control"
        :else ""))
      (8 (cond
        (!= k 2) "SWITCH: wrong number of inputs"
        (!= type T-CTRL) "SWITCH: type is not ctrl"
        (= (graph/input g n 0) 0) "SWITCH: missing operand c"
        (not (control-node? (graph/op g (graph/input g n 0)))) "SWITCH: operand c is not control"
        (= (graph/input g n 1) 0) "SWITCH: missing operand value"
        (not (value-type? (graph/ty g (graph/input g n 1)))) "SWITCH: operand value is not a value"
        :else ""))
      (9 (cond
        (!= k 1) "CASE: wrong number of inputs"
        (!= type T-CTRL) "CASE: type is not ctrl"
        (= (graph/input g n 0) 0) "CASE: missing operand switch"
        (not (control-node? (graph/op g (graph/input g n 0)))) "CASE: operand switch is not control"
        :else ""))
      (10 (cond
        (!= k 1) "DEFAULT: wrong number of inputs"
        (!= type T-CTRL) "DEFAULT: type is not ctrl"
        (= (graph/input g n 0) 0) "DEFAULT: missing operand switch"
        (not (control-node? (graph/op g (graph/input g n 0)))) "DEFAULT: operand switch is not control"
        :else ""))
      (11 (cond
        (!= k 1) "TRAP: wrong number of inputs"
        (!= type 0) "TRAP: has a type"
        (= (graph/input g n 0) 0) "TRAP: missing operand c"
        (not (control-node? (graph/op g (graph/input g n 0)))) "TRAP: operand c is not control"
        :else ""))
      (12 (cond
        (< k 2) "CALL: wrong number of inputs"
        (!= type T-CTRL) "CALL: type is not ctrl"
        (= (graph/input g n 0) 0) "CALL: missing operand c"
        (not (control-node? (graph/op g (graph/input g n 0)))) "CALL: operand c is not control"
        (= (graph/input g n 1) 0) "CALL: missing operand target"
        (!= (graph/ty g (graph/input g n 1)) T-PTR) "CALL: operand target has the wrong type"
        (not (variadic-ok? g n 2 -1)) "CALL: bad operand among args"
        :else ""))
      (13 (cond
        (!= k 1) "RESULT: wrong number of inputs"
        (= (graph/input g n 0) 0) "RESULT: missing operand call"
        (not (control-node? (graph/op g (graph/input g n 0)))) "RESULT: operand call is not control"
        :else ""))
      (14 (cond
        (< k 2) "TAILCALL: wrong number of inputs"
        (= (graph/input g n 0) 0) "TAILCALL: missing operand c"
        (not (control-node? (graph/op g (graph/input g n 0)))) "TAILCALL: operand c is not control"
        (= (graph/input g n 1) 0) "TAILCALL: missing operand target"
        (!= (graph/ty g (graph/input g n 1)) T-PTR) "TAILCALL: operand target has the wrong type"
        (not (variadic-ok? g n 2 -1)) "TAILCALL: bad operand among args"
        :else ""))
      (15 (cond
        (!= k 2) "LOAD: wrong number of inputs"
        (= (graph/input g n 0) 0) "LOAD: missing operand c"
        (not (control-node? (graph/op g (graph/input g n 0)))) "LOAD: operand c is not control"
        (= (graph/input g n 1) 0) "LOAD: missing operand addr"
        (!= (graph/ty g (graph/input g n 1)) T-PTR) "LOAD: operand addr has the wrong type"
        (not (in-stored? type)) "LOAD: type T is not in stored"
        :else ""))
      (16 (cond
        (!= k 3) "STORE: wrong number of inputs"
        (!= type T-CTRL) "STORE: type is not ctrl"
        (= (graph/input g n 0) 0) "STORE: missing operand c"
        (not (control-node? (graph/op g (graph/input g n 0)))) "STORE: operand c is not control"
        (= (graph/input g n 1) 0) "STORE: missing operand addr"
        (!= (graph/ty g (graph/input g n 1)) T-PTR) "STORE: operand addr has the wrong type"
        (= (graph/input g n 2) 0) "STORE: missing operand value"
        (not (value-type? (graph/ty g (graph/input g n 2)))) "STORE: operand value is not a value"
        :else ""))
      (17 (cond
        (!= k 3) "COPY: wrong number of inputs"
        (!= type T-CTRL) "COPY: type is not ctrl"
        (= (graph/input g n 0) 0) "COPY: missing operand c"
        (not (control-node? (graph/op g (graph/input g n 0)))) "COPY: operand c is not control"
        (= (graph/input g n 1) 0) "COPY: missing operand dst"
        (!= (graph/ty g (graph/input g n 1)) T-PTR) "COPY: operand dst has the wrong type"
        (= (graph/input g n 2) 0) "COPY: missing operand src"
        (!= (graph/ty g (graph/input g n 2)) T-PTR) "COPY: operand src has the wrong type"
        :else ""))
      (18 (cond
        (!= k 3) "FILL: wrong number of inputs"
        (!= type T-CTRL) "FILL: type is not ctrl"
        (= (graph/input g n 0) 0) "FILL: missing operand c"
        (not (control-node? (graph/op g (graph/input g n 0)))) "FILL: operand c is not control"
        (= (graph/input g n 1) 0) "FILL: missing operand dst"
        (!= (graph/ty g (graph/input g n 1)) T-PTR) "FILL: operand dst has the wrong type"
        (= (graph/input g n 2) 0) "FILL: missing operand value"
        (!= (graph/ty g (graph/input g n 2)) T-U8) "FILL: operand value has the wrong type"
        :else ""))
      (19 (cond
        (!= k 2) "ATOMIC-LOAD: wrong number of inputs"
        (= (graph/input g n 0) 0) "ATOMIC-LOAD: missing operand c"
        (not (control-node? (graph/op g (graph/input g n 0)))) "ATOMIC-LOAD: operand c is not control"
        (= (graph/input g n 1) 0) "ATOMIC-LOAD: missing operand addr"
        (!= (graph/ty g (graph/input g n 1)) T-PTR) "ATOMIC-LOAD: operand addr has the wrong type"
        (not (in-int? type)) "ATOMIC-LOAD: type T is not in int"
        :else ""))
      (20 (cond
        (!= k 3) "ATOMIC-STORE: wrong number of inputs"
        (!= type T-CTRL) "ATOMIC-STORE: type is not ctrl"
        (= (graph/input g n 0) 0) "ATOMIC-STORE: missing operand c"
        (not (control-node? (graph/op g (graph/input g n 0)))) "ATOMIC-STORE: operand c is not control"
        (= (graph/input g n 1) 0) "ATOMIC-STORE: missing operand addr"
        (!= (graph/ty g (graph/input g n 1)) T-PTR) "ATOMIC-STORE: operand addr has the wrong type"
        (= (graph/input g n 2) 0) "ATOMIC-STORE: missing operand value"
        (not (value-type? (graph/ty g (graph/input g n 2)))) "ATOMIC-STORE: operand value is not a value"
        :else ""))
      (21 (cond
        (!= k 3) "SWAP: wrong number of inputs"
        (= (graph/input g n 0) 0) "SWAP: missing operand c"
        (not (control-node? (graph/op g (graph/input g n 0)))) "SWAP: operand c is not control"
        (= (graph/input g n 1) 0) "SWAP: missing operand addr"
        (!= (graph/ty g (graph/input g n 1)) T-PTR) "SWAP: operand addr has the wrong type"
        (= (graph/input g n 2) 0) "SWAP: missing operand v"
        (!= (graph/ty g (graph/input g n 2)) type) "SWAP: operand v has the wrong type"
        (not (in-int? type)) "SWAP: type T is not in int"
        :else ""))
      (22 (cond
        (!= k 3) "FETCH-ADD: wrong number of inputs"
        (= (graph/input g n 0) 0) "FETCH-ADD: missing operand c"
        (not (control-node? (graph/op g (graph/input g n 0)))) "FETCH-ADD: operand c is not control"
        (= (graph/input g n 1) 0) "FETCH-ADD: missing operand addr"
        (!= (graph/ty g (graph/input g n 1)) T-PTR) "FETCH-ADD: operand addr has the wrong type"
        (= (graph/input g n 2) 0) "FETCH-ADD: missing operand v"
        (!= (graph/ty g (graph/input g n 2)) type) "FETCH-ADD: operand v has the wrong type"
        (not (in-int? type)) "FETCH-ADD: type T is not in int"
        :else ""))
      (23 (cond
        (!= k 3) "FETCH-SUB: wrong number of inputs"
        (= (graph/input g n 0) 0) "FETCH-SUB: missing operand c"
        (not (control-node? (graph/op g (graph/input g n 0)))) "FETCH-SUB: operand c is not control"
        (= (graph/input g n 1) 0) "FETCH-SUB: missing operand addr"
        (!= (graph/ty g (graph/input g n 1)) T-PTR) "FETCH-SUB: operand addr has the wrong type"
        (= (graph/input g n 2) 0) "FETCH-SUB: missing operand v"
        (!= (graph/ty g (graph/input g n 2)) type) "FETCH-SUB: operand v has the wrong type"
        (not (in-int? type)) "FETCH-SUB: type T is not in int"
        :else ""))
      (24 (cond
        (!= k 3) "FETCH-AND: wrong number of inputs"
        (= (graph/input g n 0) 0) "FETCH-AND: missing operand c"
        (not (control-node? (graph/op g (graph/input g n 0)))) "FETCH-AND: operand c is not control"
        (= (graph/input g n 1) 0) "FETCH-AND: missing operand addr"
        (!= (graph/ty g (graph/input g n 1)) T-PTR) "FETCH-AND: operand addr has the wrong type"
        (= (graph/input g n 2) 0) "FETCH-AND: missing operand v"
        (!= (graph/ty g (graph/input g n 2)) type) "FETCH-AND: operand v has the wrong type"
        (not (in-int? type)) "FETCH-AND: type T is not in int"
        :else ""))
      (25 (cond
        (!= k 3) "FETCH-NAND: wrong number of inputs"
        (= (graph/input g n 0) 0) "FETCH-NAND: missing operand c"
        (not (control-node? (graph/op g (graph/input g n 0)))) "FETCH-NAND: operand c is not control"
        (= (graph/input g n 1) 0) "FETCH-NAND: missing operand addr"
        (!= (graph/ty g (graph/input g n 1)) T-PTR) "FETCH-NAND: operand addr has the wrong type"
        (= (graph/input g n 2) 0) "FETCH-NAND: missing operand v"
        (!= (graph/ty g (graph/input g n 2)) type) "FETCH-NAND: operand v has the wrong type"
        (not (in-int? type)) "FETCH-NAND: type T is not in int"
        :else ""))
      (26 (cond
        (!= k 3) "FETCH-OR: wrong number of inputs"
        (= (graph/input g n 0) 0) "FETCH-OR: missing operand c"
