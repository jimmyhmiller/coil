;;; Control is one chain: what follows a node in it, through its first operand
;;; or as a way into a region or loop, is one node, unless it is a branch,
;;; whose sides each follow it. A second would never be reached.
(defn verify-chain [(g graph/Graph) (n i32)] (-> (slice u8))
  (let [r (get ROLES (cast i64 (graph/op g n)))
        (mut count) 0
        (mut e) (graph/first-use g n)]
    (if (or (not (control-node? (graph/op g n))) (= r 5) (= r 19))
        ""
        (do (while (>= e 0)
              (let [u (graph/user g e)
                    ur (get ROLES (cast i64 (graph/op g u)))]
                (when (and (control-node? (graph/op g u)) (or (= ur 3) (= ur 4) (= (graph/slot g e) 0)))
                  (set! count (+ count 1))))
              (set! e (graph/next-use g e)))
            (if (> count 1) "control that is not a branch is followed by more than one node" "")))))
;;; The first thing wrong with any node, or "".
(defn verify [(g graph/Graph)] (-> (slice u8))
  (let [(mut problem) ""]
    (for n (range 1 (graph/size g))
      (when (and (= problem "") (not (graph/dead? g (cast i32 n))))
        (set! problem (verify-node g (cast i32 n)))
        (when (= problem "") (set! problem (verify-chain g (cast i32 n))))))
    problem))
;;; A node's value from its operands' values: `bits` is the operands' width,
;;; `rbits` the result's, which the value is cut to.
(defn eval [(operation i32) (rbits i64) (bits i64) (a u64) (b u64) (c u64)] (-> u64)
  (bv/cut (match operation
    (21 b)
    (22 (primitive/iadd a b))
    (23 (primitive/isub a b))
    (24 (& a b))
    (25 (^ (& a b) (: 0xFFFFFFFFFFFFFFFF u64)))
    (26 (| a b))
    (27 (^ a b))
    (28 (if (> (bv/signed a bits) (bv/signed b bits)) a b))
    (29 (if (< (bv/signed a bits) (bv/signed b bits)) a b))
    (30 (if (> a b) a b))
    (31 (if (< a b) a b))
    (32 (if (!= (if (= a b) (: 1 u64) (: 0 u64)) 0) c a))
    (41 (primitive/iadd a b))
    (42 (primitive/isub a b))
    (43 (primitive/imul a b))
    (44 (& a b))
    (45 (| a b))
    (46 (^ a b))
    (47 (primitive/isub (: 0x0 u64) a))
    (48 (^ a (: 0xFFFFFFFFFFFFFFFF u64)))
    (49 (bv/shl a (bv/urem b (cast u64 bits))))
    (50 (bv/shr a (bv/urem b (cast u64 bits))))
    (51 (bv/sar (bv/sext a bits) (bv/urem b (cast u64 bits))))
    (52 (bv/udiv a b))
    (53 (bv/sdiv (bv/sext a bits) (bv/sext b bits)))
    (54 (bv/urem a b))
    (55 (bv/srem (bv/sext a bits) (bv/sext b bits)))
    (56 (bv/clz a bits))
    (57 (bv/ctz a bits))
    (58 (bv/popcount a bits))
    (59 (bv/bswap a bits))
    (60 (bv/bitrev a bits))
    (61 (bv/rol a b bits))
    (62 (bv/ror a b bits))
    (63 (if (< (bv/signed a bits) (bv/signed b bits)) a b))
    (64 (if (> (bv/signed a bits) (bv/signed b bits)) a b))
    (65 (if (< a b) a b))
    (66 (if (> a b) a b))
    (67 (bv/umulh a b bits))
    (68 (bv/smulh a b bits))
    (69 (if (bv/sadd-overflows a b bits) (: 1 u64) (: 0 u64)))
    (70 (if (bv/uadd-overflows a b bits) (: 1 u64) (: 0 u64)))
    (71 (if (bv/ssub-overflows a b bits) (: 1 u64) (: 0 u64)))
    (72 (if (bv/usub-overflows a b bits) (: 1 u64) (: 0 u64)))
    (73 (if (bv/smul-overflows a b bits) (: 1 u64) (: 0 u64)))
    (74 (if (bv/umul-overflows a b bits) (: 1 u64) (: 0 u64)))
    (75 a)
    (76 (bv/sext a bits))
    (77 a)
    (78 (bv/fadd a b bits))
    (79 (bv/fsub a b bits))
    (80 (bv/fmul a b bits))
    (81 (bv/fdiv a b bits))
    (82 (bv/fneg a bits))
    (83 (bv/fabs a bits))
    (84 (bv/fsqrt a bits))
    (85 (bv/fmin a b bits))
    (86 (bv/fmax a b bits))
    (87 (bv/fmin-number a b bits))
    (88 (bv/fmax-number a b bits))
    (89 (bv/fround a (: 0x0 u64) bits))
    (90 (bv/fround a (: 0x1 u64) bits))
    (91 (bv/fround a (: 0x2 u64) bits))
    (92 (bv/fround a (: 0x3 u64) bits))
    (93 (bv/fround a (: 0x4 u64) bits))
    (94 (bv/fma a b c bits))
    (95 (if (bv/feq a b bits) (: 1 u64) (: 0 u64)))
    (96 (if (not (bv/feq a b bits)) (: 1 u64) (: 0 u64)))
    (97 (if (bv/flt a b bits) (: 1 u64) (: 0 u64)))
    (98 (if (bv/fle a b bits) (: 1 u64) (: 0 u64)))
    (99 (bv/sitof (bv/sext a bits) rbits))
    (100 (bv/uitof a rbits))
    (101 (bv/ftosi a bits rbits))
    (102 (bv/ftoui a bits rbits))
    (103 (bv/fext a))
    (104 (bv/ftrunc a))
    (105 a)
    (106 (if (!= a 0) b c))
    (107 (if (= a b) (: 1 u64) (: 0 u64)))
    (108 (if (!= a b) (: 1 u64) (: 0 u64)))
    (109 (if (< (bv/signed a bits) (bv/signed b bits)) (: 1 u64) (: 0 u64)))
    (110 (if (<= (bv/signed a bits) (bv/signed b bits)) (: 1 u64) (: 0 u64)))
    (111 (if (< a b) (: 1 u64) (: 0 u64)))
    (112 (if (<= a b) (: 1 u64) (: 0 u64)))
    (_ (: 0 u64))) rbits))
;;; Every node, one to a line: its number, name, type, payload and inputs.
(defn dump [(g graph/Graph)] (-> void)
  (for i (range 1 (graph/size g))
    (let [n (cast i32 i)]
      (unless (graph/dead? g n)
        (print "{:>5} {} {}" i (name (graph/op g n)) (type-name (graph/ty g n)))
        (when (!= (graph/payload g n) 0) (print " #{:x}" (graph/payload g n)))
        (for k (range 0 (graph/arity g n)) (print " {}" (graph/input g n k)))
        (println "")))))
;;; The value of a node that depends only on parameters and constants.
(defn eval-node [(g graph/Graph) (args (slice u64)) (n i32)] (-> u64)
  (let [operation (graph/op g n)
        r (get ROLES (cast i64 operation))]
    (cond
      (= r 10) (graph/payload g n)
      (= r 9) (bv/cut (get args (cast i64 (graph/payload g n))) (type-bits (graph/ty g n)))
      :else
        (let [k (graph/arity g n)
              a (if (> k 0) (eval-node g args (graph/input g n 0)) (: 0 u64))
              b (if (> k 1) (eval-node g args (graph/input g n 1)) (: 0 u64))
              c (if (> k 2) (eval-node g args (graph/input g n 2)) (: 0 u64))
              bits (if (> k 0) (type-bits (graph/ty g (graph/input g n 0))) 0)]
          (eval operation (type-bits (graph/ty g n)) bits a b c)))))
;;; A reference interpreter: what a graph computes, straight from the nodes'
;;; meanings. Control is followed from START; a region's phis take their values
;;; together as it is entered.
(defstruct Interp
  [(val (ArrayList u64)) (stamp (ArrayList i64)) (phi (ArrayList u64)) (second (ArrayList u64)) (epoch i64)])
;;; Two integers returned together, as the C convention returns a pair.
(defstruct Pair [(first u64) (second u64)])
(defn value [(g graph/Graph) (it (mut Interp)) (args (slice u64)) (n i32)] (-> u64)
  (let [operation (graph/op g n)
        r (get ROLES (cast i64 operation))
        at (cast i64 n)]
    (cond
      (= r 10) (graph/payload g n)
      (= r 9) (bv/cut (get args (cast i64 (graph/payload g n))) (type-bits (graph/ty g n)))
      (or (= r 8) (= r 13) (= r 23) (= r 25)) (get (.phi it) at)
      ; A frame object is memory of its own, made the first time it is asked for.
      (= r 15)
        (do (when (= (get (.phi it) at) 0)
              (set! (mut (.phi it)) at (memory/allocate (graph/payload g n))))
            (get (.phi it) at))
      (or (= r 16) (= r 17)) (get (.addresses g) (cast i64 (graph/payload g n)))
      ; A call's result: the first of its kind, or the second integer.
      (= r 12) (bv/cut (get (if (= (graph/payload g n) 0) (.phi it) (.second it)) (cast i64 (graph/input g n 0)))
                       (type-bits (graph/ty g n)))
      (= (get (.stamp it) at) (.epoch it)) (get (.val it) at)
      :else
        (let [k (graph/arity g n)
              a (if (> k 0) (value g (mut it) args (graph/input g n 0)) (: 0 u64))
              b (if (> k 1) (value g (mut it) args (graph/input g n 1)) (: 0 u64))
              c (if (> k 2) (value g (mut it) args (graph/input g n 2)) (: 0 u64))
              bits (if (> k 0) (type-bits (graph/ty g (graph/input g n 0))) 0)
              v (eval operation (type-bits (graph/ty g n)) bits a b c)]
          (set! (mut (.val it)) at v)
          (set! (mut (.stamp it)) at (.epoch it))
          v))))
;;; The user of control node `c` that has role `want` and follows it.
(defn follower [(g graph/Graph) (c i32) (want i64)] (-> i32)
  (let [(mut found) (: 0 i32)
        (mut e) (graph/first-use g c)]
    (while (>= e 0)
      (let [u (graph/user g e)]
        (when (and (= (get ROLES (cast i64 (graph/op g u))) want) (= (graph/input g u 0) c))
          (set! found u)))
      (set! e (graph/next-use g e)))
    found))
(defn call-argument [(g graph/Graph) (it (mut Interp)) (args (slice u64)) (n i32) (i i64)] (-> u64)
  (if (> (graph/arity g n) (+ i 2)) (value g (mut it) args (graph/input g n (+ i 2))) (: 0 u64)))
;;; Control reaches a call: the function at its target runs with the C convention.
;;; Integers alone go as up to twelve integers. With floating point, up to eight
;;; integers and eight floating values go in their own registers.
(defn call-out! [(g graph/Graph) (it (mut Interp)) (args (slice u64)) (n i32)] (-> void)
  (when (graph/shape-pinned? g (cast i64 (graph/payload g n)))
    (panic "the interpreter cannot make a call that follows no convention"))
  (let [target (primitive/cast (ptr u8) (value g (mut it) args (graph/input g n 1)))
        (mut floating) (and (!= (graph/ty g n) 0) (value-type? (graph/ty g n)) (type-float? (graph/ty g n)))
        (mut float-result) (and (!= (graph/ty g n) 0) (value-type? (graph/ty g n)) (type-float? (graph/ty g n)))
        (mut ints) (ArrayList::new [u64] (.alc g))
        (mut floats) (ArrayList::new [f64] (.alc g))
        (mut second) false
        (mut e) (graph/first-use g n)]
    (while (>= e 0)
      (let [u (graph/user g e)]
        (when (and (= (get ROLES (cast i64 (graph/op g u))) 12) (!= (graph/payload g u) 0))
          (when (or (type-float? (graph/ty g u)) (> (graph/payload g u) 1))
            (panic "the interpreter takes one floating result or up to two integers from a call"))
          (set! second true))
        (when (and (= (get ROLES (cast i64 (graph/op g u))) 12) (type-float? (graph/ty g u)))
          (set! floating true)
          (set! float-result true)))
      (set! e (graph/next-use g e)))
    (for i (range 2 (graph/arity g n))
      (when (type-float? (graph/ty g (graph/input g n i))) (set! floating true)))
    (when (and second floating)
      (panic "the interpreter takes a second result only from a call with no floating values"))
    (cond
      second
        (let [f (primitive/cast (fnptr (cc/C) [u64 u64 u64 u64 u64 u64 u64 u64 u64 u64 u64 u64] Pair) target)
              both (f (call-argument g (mut it) args n 0) (call-argument g (mut it) args n 1)
                      (call-argument g (mut it) args n 2) (call-argument g (mut it) args n 3)
                      (call-argument g (mut it) args n 4) (call-argument g (mut it) args n 5)
                      (call-argument g (mut it) args n 6) (call-argument g (mut it) args n 7)
                      (call-argument g (mut it) args n 8) (call-argument g (mut it) args n 9)
                      (call-argument g (mut it) args n 10) (call-argument g (mut it) args n 11))]
          (set! (mut (.phi it)) (cast i64 n) (.first both))
          (set! (mut (.second it)) (cast i64 n) (.second both)))
      (not floating)
        (let [f (primitive/cast (fnptr (cc/C) [u64 u64 u64 u64 u64 u64 u64 u64 u64 u64 u64 u64] u64) target)]
          (set! (mut (.phi it)) (cast i64 n)
                (f (call-argument g (mut it) args n 0) (call-argument g (mut it) args n 1)
                   (call-argument g (mut it) args n 2) (call-argument g (mut it) args n 3)
                   (call-argument g (mut it) args n 4) (call-argument g (mut it) args n 5)
                   (call-argument g (mut it) args n 6) (call-argument g (mut it) args n 7)
                   (call-argument g (mut it) args n 8) (call-argument g (mut it) args n 9)
                   (call-argument g (mut it) args n 10) (call-argument g (mut it) args n 11))))
      :else
        (do
          (for i (range 2 (graph/arity g n))
            (let [a (graph/input g n i)
                  v (value g (mut it) args a)]
              ; A single-precision value rides in the low half of its register.
              (if (type-float? (graph/ty g a)) (push! (mut floats) (bv/f64-of v)) (push! (mut ints) v))))
          (when (or (> (len ints) 8) (> (len floats) 8))
            (panic "the interpreter passes at most eight integers and eight floating values to a call that has any floating value"))
          (while (< (len ints) 8) (push! (mut ints) 0))
          (while (< (len floats) 8) (push! (mut floats) 0.0))
          (if float-result
              (let [f (primitive/cast (fnptr (cc/C) [u64 u64 u64 u64 u64 u64 u64 u64 f64 f64 f64 f64 f64 f64 f64 f64] f64) target)]
                (set! (mut (.phi it)) (cast i64 n)
                      (bv/of-f64 (f (get ints 0) (get ints 1) (get ints 2) (get ints 3) (get ints 4) (get ints 5)
                                    (get ints 6) (get ints 7) (get floats 0) (get floats 1) (get floats 2)
                                    (get floats 3) (get floats 4) (get floats 5) (get floats 6) (get floats 7)))))
              (let [f (primitive/cast (fnptr (cc/C) [u64 u64 u64 u64 u64 u64 u64 u64 f64 f64 f64 f64 f64 f64 f64 f64] u64) target)]
                (set! (mut (.phi it)) (cast i64 n)
                      (f (get ints 0) (get ints 1) (get ints 2) (get ints 3) (get ints 4) (get ints 5)
                         (get ints 6) (get ints 7) (get floats 0) (get floats 1) (get floats 2)
                         (get floats 3) (get floats 4) (get floats 5) (get floats 6) (get floats 7)))))))
    (free! (mut ints))
    (free! (mut floats))
    (set! (.epoch it) (+ (.epoch it) 1))))
;;; What a node in the control chain does as control passes it: a call runs,
;;; a load reads memory, a store writes it.
(defn effect! [(g graph/Graph) (it (mut Interp)) (args (slice u64)) (n i32)] (-> void)
  (let [r (get ROLES (cast i64 (graph/op g n)))]
    (cond
      (= r 11) (call-out! g (mut it) args n)
      (= r 13)
        (do (set! (mut (.phi it)) (cast i64 n)
                  (memory/read (value g (mut it) args (graph/input g n 1)) (type-bits (graph/ty g n))))
            (set! (.epoch it) (+ (.epoch it) 1)))
      (= r 14)
        (memory/write (value g (mut it) args (graph/input g n 1))
                      (type-bits (graph/ty g (graph/input g n 2)))
                      (value g (mut it) args (graph/input g n 2)))
      (= r 25)
        (do (set! (mut (.phi it)) (cast i64 n) (memory/allocate (value g (mut it) args (graph/input g n 1))))
            (set! (.epoch it) (+ (.epoch it) 1)))
      (or (= r 26) (= r 27))
        (let [to (value g (mut it) args (graph/input g n 1))
              from (value g (mut it) args (graph/input g n 2))]
          (for i (range 0 (cast i64 (graph/payload g n)))
            (memory/write (+ to (cast u64 i)) 8 (if (= r 26) (memory/read (+ from (cast u64 i)) 8) from))))
      ; An update: what was there is its value, and its meaning goes back.
      (= r 23)
        (let [address (value g (mut it) args (graph/input g n 1))
              bits (type-bits (graph/ty g n))
              old (memory/read address bits)
              b (if (> (graph/arity g n) 2) (value g (mut it) args (graph/input g n 2)) (: 0 u64))
              c (if (> (graph/arity g n) 3) (value g (mut it) args (graph/input g n 3)) (: 0 u64))]
          (memory/write address bits (eval (graph/op g n) bits bits old b c))
          (set! (mut (.phi it)) (cast i64 n) old)
          (set! (.epoch it) (+ (.epoch it) 1)))
      :else (do))))
;;; The control node that follows `c` inside its block: a branch, a switch, a
;;; return, a trap, a call, a load or a store.
(defn next-in-chain [(g graph/Graph) (c i32)] (-> i32)
  (let [(mut found) (: 0 i32)
        (mut e) (graph/first-use g c)]
    (while (>= e 0)
      (let [u (graph/user g e)
            r (get ROLES (cast i64 (graph/op g u)))]
        (when (and (= (graph/input g u 0) c)
                   (or (= r 5) (= r 2) (= r 11) (= r 13) (= r 14) (= r 18) (= r 19) (= r 22) (= r 23) (= r 24) (= r 25) (= r 26) (= r 27)))
          (set! found u)))
      (set! e (graph/next-use g e)))
    found))
;;; Runs the graph on these arguments and adds the values it returns to
;;; `results`; false if it has not returned within `limit` control steps.
(defn interpret-all [(g graph/Graph) (args (slice u64)) (limit i64) (results (mut (ArrayList u64)))] (-> bool)
  (let [(mut it) (Interp
                   :val (ArrayList::new [u64] (.alc g))
                   :stamp (ArrayList::new [i64] (.alc g))
                   :phi (ArrayList::new [u64] (.alc g))
                   :second (ArrayList::new [u64] (.alc g))
                   :epoch 1)
        (mut pending) (ArrayList::new [u64] (.alc g))
        (mut c) (.start g)
        (mut steps) 0
        (mut returned) false
        (mut running) true]
    (for _ (range 0 (graph/size g))
      (push! (mut (.val it)) 0)
      (push! (mut (.stamp it)) 0)
      (push! (mut (.phi it)) 0)
      (push! (mut (.second it)) 0))
    (while running
      (set! steps (+ steps 1))
      (let [r (get ROLES (cast i64 (graph/op g c)))]
        (cond
          (> steps limit) (set! running false)
          (= r 2)
            (do (for i (range 1 (graph/arity g c))
                  (push! (mut results) (value g (mut it) args (graph/input g c i))))
                (set! returned true)
                (set! running false))
          ; A tail call's result is the function's.
          (= r 22)
            (do (call-out! g (mut it) args c)
                (push! (mut results) (bv/cut (get (.phi it) (cast i64 c))
                                             (if (= (graph/ty g c) 0) 64 (type-bits (graph/ty g c)))))
                (set! returned true)
                (set! running false))
          ; A trap ends the run with no result.
          (= r 18) (set! running false)
          ; A switch goes to the case with its value, or to its default.
          (= r 19)
            (let [v (value g (mut it) args (graph/input g c 1))
                  (mut to) (: 0 i32)
                  (mut otherwise) (: 0 i32)
                  (mut e) (graph/first-use g c)]
              (while (>= e 0)
                (let [u (graph/user g e)
                      ur (get ROLES (cast i64 (graph/op g u)))]
                  (when (and (= ur 20) (= (graph/payload g u) v)) (set! to u))
                  (when (= ur 21) (set! otherwise u)))
                (set! e (graph/next-use g e)))
              (set! c (if (!= to 0) to otherwise)))
          (= r 5)
            (set! c (follower g c (if (!= (value g (mut it) args (graph/input g c 1)) 0) 6 7)))
          :else
            (let [next (next-in-chain g c)]
              (if (!= next 0)
                  (do (set! c next)
                      (effect! g (mut it) args next))
                  ; No follower inside the block: control enters a region.
                  (let [(mut region) (: 0 i32)
                        (mut slot) 0
                        (mut e) (graph/first-use g c)]
                    (while (>= e 0)
                      (let [u (graph/user g e)
                            ur (get ROLES (cast i64 (graph/op g u)))]
                        (when (or (= ur 3) (= ur 4))
                          (set! region u)
                          (set! slot (graph/slot g e))))
                      (set! e (graph/next-use g e)))
                    (if (= region 0)
                        (set! running false)
                        (do
                          (clear! (mut pending))
                          (let [(mut p) (graph/first-use g region)]
                            (while (>= p 0)
                              (let [u (graph/user g p)]
                                (when (and (= (get ROLES (cast i64 (graph/op g u))) 8)
                                           (= (graph/input g u 0) region))
                                  (push! (mut pending)
                                         (value g (mut it) args (graph/input g u (+ slot 1))))))
                              (set! p (graph/next-use g p))))
                          (let [(mut p) (graph/first-use g region)
                                (mut i) 0]
                            (while (>= p 0)
                              (let [u (graph/user g p)]
                                (when (and (= (get ROLES (cast i64 (graph/op g u))) 8)
                                           (= (graph/input g u 0) region))
                                  (set! (mut (.phi it)) (cast i64 u) (get pending i))
                                  (set! i (+ i 1))))
                              (set! p (graph/next-use g p))))
                          (set! (.epoch it) (+ (.epoch it) 1))
                          (set! c region)))))))))
    (free! (mut (.val it)))
    (free! (mut (.stamp it)))
    (free! (mut (.phi it)))
    (free! (mut (.second it)))
    (free! (mut pending))
    returned))
;;; The first value the graph returns for these arguments (0 if it returns
;;; none), or None if it has not returned within `limit` control steps.
(defn interpret [(g graph/Graph) (args (slice u64)) (limit i64)] (-> (Option u64))
  (let [(mut results) (ArrayList::new [u64] (.alc g))
        returned (interpret-all g args limit (mut results))
        first (if (> (len results) 0) (get results 0) (: 0 u64))]
    (free! (mut results))
    (if returned (Some first) (None [u64]))))

