    true (let [t*m (mach/fresh (mut cx)) t*t (mach/fresh (mut cx)) ] (do (swap-fields-in (mut cx) w d mask by t*m t*t) (do)))
    :else (panic "no case of template swap-fields applies")))
(defn swap-fields-in [(cx (mut st/State)) (w i64) (d i64) (mask i64) (by i64) (m i64) (t i64)] (-> void)
  (cond
    true (let [] (do (mach/emit (mut cx) 5 m mask 0 0 0) (move (mut cx) t d) (mach/emit (mut cx) 28 w t by 0 0) (mach/emit (mut cx) 8 w t m 0 0) (mach/emit (mut cx) 8 w d m 0 0) (mach/emit (mut cx) 27 w d by 0 0) (mach/emit (mut cx) 7 w d t 0 0) (do)))
    :else (panic "no case of template swap-fields-in applies")))

