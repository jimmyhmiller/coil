 (.f r) (operand-id (mut r) v 0)))))) (bv/nan? (operand* (mut r) v 1) (cast i64 (cast u64 (type-bits (view/ty (.f r) (operand-id (mut r) v 0))))))) (: 1 u64) (: 0 u64)) (: (: 0x1 u64) u64)) (= k* 9) (if (or (bv/nan? (operand* (mut r) v 0) (cast i64 (cast u64 (type-bits (view/ty (.f r) (operand-id (mut r) v 0)))))) (bv/nan? (operand* (mut r) v 1) (cast i64 (cast u64 (type-bits (view/ty (.f r) (operand-id (mut r) v 0))))))) (: 1 u64) (: 0 u64)) (= k* 10) (| (if (or (bv/nan? (operand* (mut r) v 0) (cast i64 (cast u64 (type-bits (view/ty (.f r) (operand-id (mut r) v 0)))))) (bv/nan? (operand* (mut r) v 1) (cast i64 (cast u64 (type-bits (view/ty (.f r) (operand-id (mut r) v 0))))))) (: 1 u64) (: 0 u64)) (if (bv/flt (operand* (mut r) v 0) (operand* (mut r) v 1) (cast i64 (cast u64 (type-bits (view/ty (.f r) (operand-id (mut r) v 0)))))) (: 1 u64) (: 0 u64))) (= k* 11) (| (if (or (bv/nan? (operand* (mut r) v 0) (cast i64 (cast u64 (type-bits (view/ty (.f r) (operand-id (mut r) v 0)))))) (bv/nan? (operand* (mut r) v 1) (cast i64 (cast u64 (type-bits (view/ty (.f r) (operand-id (mut r) v 0))))))) (: 1 u64) (: 0 u64)) (if (bv/fle (operand* (mut r) v 0) (operand* (mut r) v 1) (cast i64 (cast u64 (type-bits (view/ty (.f r) (operand-id (mut r) v 0)))))) (: 1 u64) (: 0 u64))) (= k* 12) (| (if (or (bv/nan? (operand* (mut r) v 0) (cast i64 (cast u64 (type-bits (view/ty (.f r) (operand-id (mut r) v 0)))))) (bv/nan? (operand* (mut r) v 1) (cast i64 (cast u64 (type-bits (view/ty (.f r) (operand-id (mut r) v 0))))))) (: 1 u64) (: 0 u64)) (if (bv/flt (operand* (mut r) v 1) (operand* (mut r) v 0) (cast i64 (cast u64 (type-bits (view/ty (.f r) (operand-id (mut r) v 0)))))) (: 1 u64) (: 0 u64))) (= k* 13) (| (if (or (bv/nan? (operand* (mut r) v 0) (cast i64 (cast u64 (type-bits (view/ty (.f r) (operand-id (mut r) v 0)))))) (bv/nan? (operand* (mut r) v 1) (cast i64 (cast u64 (type-bits (view/ty (.f r) (operand-id (mut r) v 0))))))) (: 1 u64) (: 0 u64)) (if (bv/fle (operand* (mut r) v 1) (operand* (mut r) v 0) (cast i64 (cast u64 (type-bits (view/ty (.f r) (operand-id (mut r) v 0)))))) (: 1 u64) (: 0 u64))) :else (panic "a meaning's `cases` has no case for this number")))
      (= op 64) (bv/fext (operand* (mut r) v 0))
      (= op 65) (bv/ftrunc (operand* (mut r) v 0))
      (= op 66) (bv/sitof (operand* (mut r) v 0) (cast i64 (cast u64 width*)))
      (= op 67) (bv/uitof (operand* (mut r) v 0) (cast i64 (cast u64 width*)))
      (= op 68) (bv/sext (bv/ftosi (operand* (mut r) v 0) (cast i64 (cast u64 (type-bits (view/ty (.f r) (operand-id (mut r) v 0))))) (cast i64 imm*)) (cast i64 imm*))
      (= op 69) (bv/ftoui (operand* (mut r) v 0) (cast i64 (cast u64 (type-bits (view/ty (.f r) (operand-id (mut r) v 0))))) (cast i64 imm*))
      (= op 70) (if (!= (if (= (cast u64 width*) (: (: 0x20 u64) u64)) (: 1 u64) (: 0 u64)) (: 0 u64)) (bv/cut (operand* (mut r) v 0) (cast i64 (: (: 0x20 u64) u64))) (if (!= (if (= (cast u64 (type-bits (view/ty (.f r) (operand-id (mut r) v 0)))) (: (: 0x20 u64) u64)) (: 1 u64) (: 0 u64)) (: 0 u64)) (bv/cut (operand* (mut r) v 0) (cast i64 (: (: 0x20 u64) u64))) (operand* (mut r) v 0)))
      (= op 71) (operand* (mut r) v 0)
      (= op 80) (load-bytes (primitive/iadd (operand* (mut r) v 0) imm*) (& imm2* (: (: 0xff u64) u64)) (& (bv/shr imm2* (& (: (: 0x8 u64) u64) (: 63 u64))) (: (: 0x1 u64) u64)))
      (= op 81) (store-bytes (primitive/iadd (operand* (mut r) v 0) imm*) (operand* (mut r) v 1) imm2*)
      (= op 82) (primitive/iadd (primitive/iadd (operand* (mut r) v 0) (primitive/imul (operand* (mut r) v 1) imm*)) imm2*)
      (= op 83) (primitive/iadd (operand* (mut r) v 0) imm*)
      (= op 84) (copy-bytes (operand* (mut r) v 0) (operand* (mut r) v 1) imm*)
      (= op 85) (fill-bytes (operand* (mut r) v 0) (: (: 0x0 u64) u64) imm*)
      (= op 92) (copy-bytes (operand* (mut r) v 0) (operand* (mut r) v 1) (operand* (mut r) v 2))
      (= op 93) (copy-bytes (operand* (mut r) v 0) (operand* (mut r) v 1) (operand* (mut r) v 2))
      (= op 94) (fill-bytes (operand* (mut r) v 0) (operand* (mut r) v 1) (operand* (mut r) v 2))
