      :else (panic "the interpreter has no meaning for an operation"))))
;;; Runs `f` on `args` until it returns (its first value) or `fuel` instructions
;;; have run (None). `symbols` is the address of each symbol.
(defn interpret [(f (ptr ir/Func)) (args (slice u64)) (symbols (slice u64)) (fuel i64)] (-> (Option u64))
  (let [n (view/value-count f)
        (mut r) (Run :f f :words (ArrayList::new [u64] (malloc-allocator)) :done (ArrayList::new [bool] (malloc-allocator))
                    :args args :symbols symbols :frame (ArrayList::new [u8] (malloc-allocator))
                    :objects (ArrayList::new [i64] (malloc-allocator)) :fuel fuel)
        (mut phis) (ArrayList::new [u64] (malloc-allocator))
        (mut block) 0 (mut from) -1 (mut result) (None [u64]) (mut going) true]
    (for _ (range 0 n) (push! (mut (.words r)) 0) (push! (mut (.done r)) false) (push! (mut (.objects r)) -1))
    (extend-zeroed! (mut (.frame r)) 65536)
    (while going
      (clear! (mut phis))
      (for i (range 0 (view/phi-count f block))
        (push! (mut phis) (word (mut r) (view/incoming f (view/phi f block i) from))))
      (for i (range 0 (view/phi-count f block))
        (let [p (view/phi f block i)] (set! (mut (.words r)) p (get phis i)) (set! (mut (.done r)) p true)))
      (let [(mut next) -1]
        (for k (range (view/block-first f block) (view/block-end f block))
          (let [v (view/inst f k) role* (role (view/op f v))]
            (set! (.fuel r) (- (.fuel r) 1))
            (when (< (.fuel r) 0) (set! going false))
            (when going
              (cond
                (= role* ROLE-JUMP) (set! next (view/target f v 0))
                (= role* ROLE-BRANCH) (set! next (view/target f v (cast i64 (compute (mut r) v))))
                (= role* ROLE-SWITCH)
                  (let [x (operand* (mut r) v 0) (mut to) (view/target f v 0)]
                    (for c (range 0 (view/case-count f v)) (when (= (view/case-value f v c) x) (set! to (view/target f v (+ c 1)))))
                    (set! next to))
                (= role* ROLE-RETURN)
                  (do (set! result (Some (if (> (view/nops f v) 0) (operand* (mut r) v 0) (: 0 u64)))) (set! going false))
                (= role* ROLE-TRAP) (set! going false)
                (= role* ROLE-CALL)
                  (do (when (> (view/aux f v) 1) (panic "the interpreter's calls give one result"))
                      (set! (mut (.words r)) v (call-words (mut r) v (callee (mut r) v) (if (< (view/imm f v) 0) 1 0)))
                      (set! (mut (.done r)) v true))
                (= role* ROLE-TAILCALL)
                  (do (set! result (Some (call-words (mut r) v (callee (mut r) v) (if (< (view/imm f v) 0) 1 0)))) (set! going false))
                :else (do (set! (mut (.words r)) v (compute (mut r) v)) (set! (mut (.done r)) v true))))))
        (when (and going (< next 0)) (panic "a block ends in nothing that leaves it"))
        (set! from block)
        (set! block next)))
    (free! (mut (.words r))) (free! (mut (.done r))) (free! (mut (.frame r))) (free! (mut (.objects r))) (free! (mut phis))
    result))

