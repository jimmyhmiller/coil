;;; Immutable callable signatures shared between compiler revisions.
(module coil.compiler.sig_base)
(import "coil.primitive" :as p)
(import "coil.alloc" :use *)
(import "coil.arraylist" :use *)
(import "coil.hashmap" :use *)
(import "coil.slice" :use [slice-new])
(import "coil.str" :use [str-keyops-borrowed])
(import "coil.scratch" :as scratch)
(import "coil.pmap" :use *)
(import "coil.compiler.ast" :use *)
(import "coil.compiler.sem_base" :as sem)

(defstruct CallableSig
  [(name (slice u8))
   (type_params (ptr (ArrayList (slice u8))))
   (bounds (ptr (ArrayList Bound)))
   (param_names (ptr (ArrayList (slice u8))))
   (params (ptr (ArrayList Type)))
   (ret Type)
   (is_extern bool)
   (variadic bool)
   (cc (slice u8))
   (fnptr_ok bool)
   (fnptr_params (ptr (ArrayList Type)))])

(defstruct SigEntry [(sig CallableSig) (hold sem/SemHold)])
(impl Clone SigEntry
  (clone [(self (ref SigEntry))] (-> SigEntry)
    (SigEntry :sig (.sig self) :hold (clone (field self hold)))))

(defstruct SigBase
  [(refs i64) (a (dyn Allocator)) (entries (PMap (slice u8) SigEntry))])

(defn sig-box-al [T] [(a (dyn Allocator)) (xs (ArrayList T))]
  (-> (ptr (ArrayList T)))
  (box! a (ArrayList T) xs))

(defn sig-no-base [] (-> (ptr SigBase)) (p/cast (ptr SigBase) 0))

(defn sig-base-new [(a (dyn Allocator))] (-> (ptr SigBase))
  (let [base (box! a SigBase (p/zeroed SigBase))]
    (set! (.refs base) 1)
    (set! (.a base) a)
    (set! (.entries base)
      (pm-new [(slice u8) SigEntry] (sem/sem-lease a) (str-keyops-borrowed)))
    base))

(defn sig-base-derive [(a (dyn Allocator)) (parent (ptr SigBase))] (-> (ptr SigBase))
  (if (= parent (sig-no-base))
    (sig-base-new a)
    (let [base (box! a SigBase (p/zeroed SigBase))]
      (set! (.refs base) 1)
      (set! (.a base) a)
      (set! (.entries base)
        (pm-clone-at [(PMap (slice u8) SigEntry)] (field parent entries)))
      base)))

(defn sig-base-retain [(base (ptr SigBase))] (-> (ptr SigBase))
  (unless (= base (sig-no-base)) (set! (.refs base) (+ (.refs base) 1)) 0)
  base)

(defn sig-base-release! [(base (ptr SigBase))] (-> i64)
  (unless (= base (sig-no-base))
    (let [remaining (- (.refs base) 1)]
      (set! (.refs base) remaining)
      (when (= remaining 0)
        (let [entries (take! [(PMap (slice u8) SigEntry)] (field base entries))] 0)
        (free [SigBase] (.a base) (slice-new base 1))
        0))
    0)
  0)

(defn own-names [(a (dyn Allocator)) (xs (ptr (ArrayList (slice u8))))]
  (-> (ptr (ArrayList (slice u8))))
  (let [(mut out) (al-new [(slice u8)] a)]
    (for [i 0 (len (load xs))]
      (push! (mut out) (sem/sem-own-bytes a (get (load xs) i))))
    (sig-box-al [(slice u8)] a (load out))))

(defn own-bound-traits [(a (dyn Allocator)) (xs (ptr (ArrayList BoundTrait)))]
  (-> (ptr (ArrayList BoundTrait)))
  (let [(mut out) (al-new [BoundTrait] a)]
    (for [i 0 (len (load xs))]
      (let [x (al-elem [BoundTrait] xs i)]
        (push! (mut out)
          (BoundTrait :name (sem/sem-own-bytes a (.name x))
            :args (sem/sem-own-type-list a (.args x))))))
    (sig-box-al [BoundTrait] a (load out))))

(defn own-bounds [(a (dyn Allocator)) (xs (ptr (ArrayList Bound)))]
  (-> (ptr (ArrayList Bound)))
  (let [(mut out) (al-new [Bound] a)]
    (for [i 0 (len (load xs))]
      (let [x (al-elem [Bound] xs i)]
        (push! (mut out)
          (Bound :name (sem/sem-own-bytes a (.name x))
            :traits (own-bound-traits a (.traits x))
            :value_type (match (.value_type x)
              (None [] (None [Type]))
              (Some [t] (Some (sem/sem-own-type a (box! a Type t)))))))))
    (sig-box-al [Bound] a (load out))))

(defn sig-copy [(a (dyn Allocator)) (sig (ptr CallableSig))] (-> CallableSig)
  (CallableSig
            :name (sem/sem-own-bytes a (.name sig))
            :type_params (own-names a (.type_params sig))
            :bounds (own-bounds a (.bounds sig))
            :param_names (own-names a (.param_names sig))
            :params (sem/sem-own-type-list a (.params sig))
            :ret (sem/sem-own-type a (field sig ret))
            :is_extern (.is_extern sig)
            :variadic (.variadic sig)
            :cc (sem/sem-own-bytes a (.cc sig))
            :fnptr_ok (.fnptr_ok sig)
            :fnptr_params (sem/sem-own-type-list a (.fnptr_params sig))))

(defn sig-base-put! [(base (ptr SigBase)) (owner (ptr sem/SemOwner))
                     (sig (ptr CallableSig))] (-> i64)
  (let [a (scratch/scratch-allocator (field owner arena))
        stored (sig-copy a sig)]
    (pm-assoc! (mut (.entries base)) (.name stored)
      (SigEntry :sig stored :hold (sem/sem-owner-hold owner)))))

(defn sig-base-get [(base (ptr SigBase)) (name (slice u8))]
  (-> (Option (ptr CallableSig)))
  (if (= base (sig-no-base))
    (None [(ptr CallableSig)])
    (match (pm-get-ptr (field base entries) name)
      (None [] (None [(ptr CallableSig)]))
      (Some [entry] (Some (field entry sig))))))

(defn sig-base-remove! [(base (ptr SigBase)) (name (slice u8))] (-> i64)
  (if (= base (sig-no-base))
    0
    (pm-dissoc! (mut (.entries base)) name)))

(defn sig-base-count [(base (ptr SigBase))] (-> i64)
  (if (= base (sig-no-base)) 0 (pm-len (field base entries))))

(defn sig-base-append-names! [(base (ptr SigBase))
                              (out (mut (ArrayList (slice u8))))] (-> i64)
  (unless (= base (sig-no-base))
    (let [(mut it) (pm-iter (field base entries))]
      (loop (match (next (mut it))
        (None [] (break))
        (Some [e] (push! (mut out) (.key e))))))
    0)
  0)

(defn sig-base-append-abis! [(base (ptr SigBase))
                             (excluded (HashMap (slice u8) i64))
                             (a (dyn Allocator))
                             (out (mut (ArrayList Extern)))] (-> i64)
  (unless (= base (sig-no-base))
    (let [(mut it) (pm-iter (field base entries))]
      (loop (match (next (mut it))
        (None [] (break))
        (Some [e]
          (let [borrowed (field (field e val) sig)]
            (unless (or (.is_extern borrowed)
                        (or (> (len (load (.type_params borrowed))) 0)
                            (hm-contains? [(slice u8) i64] excluded (.name borrowed))))
              (let [copy (sig-copy a borrowed)]
                (push! (mut out)
                  (Extern :name (.name copy) :symbol (None [(slice u8)]) :cc (.cc copy)
                    :params (.params copy) :variadic false :ret (.ret copy))))
              0))))))
    0)
  0)
