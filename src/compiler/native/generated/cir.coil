(defn read-var! [(f (ptr Func)) (var u32) (block u32)] (-> u32)
  (let [value (lookup-def f var block)]
    (if (!= value (none)) (resolve f value)
        (read-var-recursive! f var block))))
(defn read-var-recursive! [(f (ptr Func)) (var u32) (block u32)] (-> u32)
  (let [ty (cast i64 (get (.var-types f) (i64-of var)))
        value
          (cond (not (.sealed (blk f block)))
                  (let [phi (new-phi! f block ty)]
                    (push! (mut (.incomplete f)) (IncompletePhi :block block :var var :phi phi))
                    phi)
                (= (.npred (blk f block)) (: 1 u32))
                  (read-var! f var (.from (get (.edges f) (i64-of (.pred-first (blk f block))))))
                (= (.npred (blk f block)) (: 0 u32)) (undef! f ty)
                :else
                  (let [phi (new-phi! f block ty) value phi]
