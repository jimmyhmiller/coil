(for vi (range 0 (len (.values f))) (let [x (val f (u32-of vi))] (when (= (get (.fwd f) vi) (none)) (for k (range 0 (i64-of (.nops x))) (let [key* (cast i64 (get (.operands f) (+ (i64-of (.opb x)) k)))] (set! (mut (.scratch-uses f)) key* (+ (get (.scratch-uses f) key*) (: 1 u32))))))))
(do))
(defn fuse-adjacent-snapshots! :inline (Always) [(f (ptr Func))(uses (mut (ArrayList u32)))] (-> i64) (let [(mut matches*) 0] (for b (range 0 (len (.blocks f))) (let [block (blk f (u32-of b))] (for j (range (i64-of (.ibegin block)) (- (i64-of (.iend block)) 1)) (let [first (get (.insts f) j)] (let [second (get (.insts f) (+ j 1))] (let [row first result (try-fuse-snapshot! f (mut uses) first second)] (when result (set! matches* (+ matches* 1))))))))) matches*))
(defn try-fuse-snapshot! [(f (ptr Func))(uses (mut (ArrayList u32)))(first u32)(second u32)] (-> bool) (block :rewrite* (block :reject* (let [x (load (val f first))] (let [y (load (val f second))] (let [op (cast i64 (.op x))] (if (and (and (and (or (= op OP-MEMCPY) (= op OP-MEMZERO)) (= (cast i64 (.op y)) OP-MEMCPY)) (> (.imm x) 0)) (= (.imm x) (.imm y))) (let [temporary (operand f (val f first) (: 0 u32))] (let [slot (load (val f temporary))] (if (and (and (and (= (cast i64 (.op slot)) OP-ALLOCA) (= (.imm slot) (.imm x))) (= (get uses (i64-of temporary)) (: 2 u32))) (= (operand f (val f second) (: 1 u32)) temporary)) (let [destination (operand f (val f second) (: 0 u32))] (let [source (if (= op OP-MEMZERO) (iconst! f 0) (operand f (val f first) (: 1 u32)))] (let [count (iconst! f (.imm x))] (let [begin (u32-of (len (.operands f)))] (do (when true (push-operand! f destination (: 0 u32))) (do (when true (push-operand! f source (: 0 u32))) (do (when true (push-operand! f count (: 0 u32))) (do (when true (replace-snapshot-values! f first second op begin)) (do (when true (mark-fused-slot! (mut uses) temporary)) (return-from :rewrite* true)))))))))) (return-from :reject* (do))))) (return-from :reject* (do))))))) false))
(defn replace-snapshot-values! :inline (Always) [(f (ptr Func))(first u32)(second u32)(op i64)(begin u32)] (-> void) (let [replacement (val f second)] (let [dead (val f first)] (do (set! (.op replacement) (cast u8 (if (= op OP-MEMZERO) OP-MEMSETV OP-MEMMOVEV)))
(set! (.opb replacement) begin)
(set! (.nops replacement) (: 3 u32))
(set! (.ntotal replacement) (: 3 u32))
(set! (.imm replacement) 0)
(set! (.imm2 replacement) 0)
(set! (.flags dead) (| (.flags dead) (: 8 u8)))
(set! (.nops dead) (: 0 u32))
(set! (.ntotal dead) (: 0 u32))
))))
(defn mark-fused-slot! :inline (Always) [(uses (mut (ArrayList u32)))(temporary u32)] (-> void) (do (set! (mut uses) (i64-of temporary) (none))
))
(defn note-has-calls! :inline (Always) [(f (ptr Func))] (-> void) (do (set! (.has-calls f) true)
))
(defn fuse-snapshots! [(f (ptr Func))] (-> void) (block :rewrite* (block :reject* (if (> (len (.allocas f)) 0) (do (when true (snapshot-use-counts! f)) (let [removed (fuse-adjacent-snapshots! f (mut (.scratch-uses f)))] (do (when (> removed 0) (note-has-calls! f)) (do (when (> removed 0) (compact-dead! f)) (do (when (> removed 0) (remove-fused-allocas! f (mut (.scratch-uses f)))) (return-from :rewrite* (do))))))) (return-from :reject* (do)))) (do)))
(defn seal-all-blocks! :inline (Always) [(f (ptr Func))] (-> void) (for b (range 0 (len (.blocks f))) (let [row (u32-of b)] (seal! f row))) (do))
(defn simplify-phis! :inline (Always) [(f (ptr Func))] (-> void) (let [(mut changed*) true] (while changed* (set! changed* false) (for b (range 0 (len (.blocks f))) (let [(mut p) (.phi-first (blk f (u32-of b)))] (while (!= p (none)) (when (= (get (.fwd f) (i64-of p)) (none)) (let [row p result (try-remove-trivial-phi! f row)] (when (!= result row) (set! changed* true)))) (set! p (.next (val f p)))))))))
(defn rewrite-forwarded-operands! :inline (Always) [(f (ptr Func))] (-> void) (for vi (range 0 (len (.values f))) (let [x (val f (u32-of vi))] (for k (range 0 (i64-of (.nops x))) (let [at (+ (i64-of (.opb x)) k)] (let [old (get (.operands f) at)] (when (!= (get (.fwd f) (i64-of old)) (none)) (do (set! (mut (.operands f)) at (resolve f old))
))))))))
(defn layout-phis! :inline (Always) [(f (ptr Func))] (-> void) (clear! (mut (.phis f))) (for b (range 0 (len (.blocks f))) (let [group (u32-of b) begin* (len (.phis f))]
   (let [(mut p) (.phi-first (blk f group))] (while (!= p (none)) (when (= (get (.fwd f) (i64-of p)) (none)) (push! (mut (.phis f)) p)) (set! p (.next (val f p)))))
   (let [count* (- (len (.phis f)) begin*)]
(for i* (range 0 (/ count* 2))
   (let [a* (+ begin* i*) z* (- (+ begin* (- count* 1)) i*) value* (get (.phis f) a*)]
     (set! (mut (.phis f)) a* (get (.phis f) z*)) (set! (mut (.phis f)) z* value*)))
     (let [begin (cast u32 begin*) count (cast u32 count*)] (configure-phi-range! f group begin count))))) (do))
(defn configure-phi-range! :inline (Always) [(f (ptr Func))(group u32)(begin u32)(count u32)] (-> void) (let [block (blk f group)] (do (set! (.phi-begin block) begin)
(set! (.phi-count block) count)
)))
(defn finish! [(f (ptr Func))] (-> void)
(seal-all-blocks! f)
(simplify-phis! f)
(rewrite-forwarded-operands! f)
(drop-dead! f)
(layout-phis! f)
(do))

