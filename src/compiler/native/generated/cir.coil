(push! (mut (.last-def f)) row1*)
(cast u32 index*)))

(defn def-key [(var u32)(block u32)] (-> u64) (| (<< (cast u64 var) (: 32 u64)) (cast u64 block)))
(defn defs-reset! [(f (ptr Func))] (-> void)
  (set! (.def-count f) 0)
