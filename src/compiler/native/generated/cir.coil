(defn cache-runtime-calls! :inline (Always) [(f (ptr Func))] (-> void) (do (set! (.has-calls f) (or (.has-calls f) (block :quantified* (for v (.insts f) (when (runtime-call-op? (val f v)) (return-from :quantified* true))) false)))
