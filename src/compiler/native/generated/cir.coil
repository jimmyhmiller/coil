(defn pure-op? [(op i64)] (-> bool) (or (or (or (or (or (and (>= op OP-ADD) (<= op OP-ASHR)) (and (>= op OP-ROTL) (<= op OP-SELECT))) (and (>= op OP-ADDO) (<= op OP-BITREV))) (and (>= op OP-FADD) (<= op OP-COPY))) (= op OP-PTRADD)) (= op OP-ADDI)))
(defn runtime-call-op? [(x (ptr Value))] (-> bool) (let [ op (cast i64 (.op x))] (or (or (or (= op OP-MEMCPYV) (= op OP-MEMMOVEV)) (= op OP-MEMSETV)) (and (and (>= op OP-SDIV) (<= op OP-UREM)) (= (cast i64 (.ty x)) T-I128)))))
