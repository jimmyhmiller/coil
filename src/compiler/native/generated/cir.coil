  (when (= (.def-gen f) (: 0 u32))
    (for i* (range 0 (len (.def-slots f)))
      (set! (.gen (elem (mut (.def-slots f)) i*)) (: 0 u32)))
    (set! (.def-gen f) (: 1 u32))))
(defn defs-home [(f (ptr Func)) (key u64)] (-> i64)
  (& (cast i64 (>> (* key (: 0x9E3779B97F4A7C15 u64)) (: 32 u64))) (- (len (.def-slots f)) 1)))
(defn defs-put! [(f (ptr Func)) (key u64) (value u32)] (-> void)
  (let [generation* (.def-gen f) mask* (- (len (.def-slots f)) 1)
        (mut i*) (defs-home f key)]
    (while (and (= (.gen (get (.def-slots f) i*)) generation*)
                (!= (.key (get (.def-slots f) i*)) key))
      (set! i* (& (+ i* 1) mask*)))
    (let [slot* (elem (mut (.def-slots f)) i*)]
      (when (!= (.gen slot*) generation*) (set! (.def-count f) (+ (.def-count f) 1)))
      (set! (.key slot*) key) (set! (.value slot*) value) (set! (.gen slot*) generation*))))
(defn defs-grow! [(f (ptr Func))] (-> void)
