(defn Arguments-derive! [(st (ptr State))] (-> void)
 (let [b* (field st arguments)]
 (let [n0* (cast i64 (len (.values (.f st)))) i0* (none)]
(facts-fill! (mut (.r0-v b*)) n0* i0*) (clear! (mut (.r0-trail b*))) (reserve! (mut (.r0-trail b*)) n0*)
(let [n1* (cast i64 (len (.args (.f st)))) i1* (promise (| P-NOCAPTURE P-READONLY))]
