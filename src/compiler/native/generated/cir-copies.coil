(defn sink-block-copies! [(sink (ptr Sink))] (-> i64) (let [(mut matches*) 0] (for b (range 0 (cir/i64-of (cir/block-count (.f sink)))) (let [row (cir/u32-of b) result (sink-block-copy! sink row)] (when result (set! matches* (+ matches* 1))))) matches*))
(defn configure-sunk-block! :inline (Always) [(sink (ptr Sink))(b u32)(begin u32)(count u32)] (-> void) (let [bb (cir/blk (.f sink) b)] (do (set! (.ibegin bb) begin)
(set! (.iend bb) (+ begin count))
)))
(defn layout-sunk-copies! [(sink (ptr Sink))] (-> void) (clear! (mut (.out sink))) (for b (range 0 (cir/i64-of (cir/block-count (.f sink)))) (let [group (cir/u32-of b) begin* (len (.out sink))]
   (let [bb (cir/blk (.f sink) group)] (for j (range (cir/i64-of (.ibegin bb)) (cir/i64-of (.iend bb))) (let [v (get (.insts (.f sink)) j)] (let [n (if (= v (.term bb)) (len (.pending-values sink)) 0)] (for k (range 0 (+ n 1)) (when (or (= k n) (= (get (.pending-blocks sink) k) group)) (push! (mut (.out sink)) (if (= k n) v (get (.pending-values sink) k)))))))))
   (let [count* (- (len (.out sink)) begin*)]

     (let [begin (cast u32 begin*) count (cast u32 count*)] (configure-sunk-block! sink group begin count))))) (do))
(defn publish-sunk-layout! [(sink (ptr Sink))] (-> void) (let [old (.insts (.f sink))] (do (set! (.insts (.f sink)) (.out sink))
(set! (.out sink) old)
)))
(defn dead-sunk-phi? [(sink (ptr Sink))(phi u32)] (-> bool) (block :quantified* (for dead (.dead-phis sink) (when (= dead phi) (return-from :quantified* true))) false))
(defn retire-sunk-phis! [(sink (ptr Sink))] (-> void) (for b (range 0 (cir/i64-of (cir/block-count (.f sink)))) (let [bb (cir/blk (.f sink) (cir/u32-of b))] (for j (range (cir/i64-of (.phi-begin bb)) (cir/i64-of (+ (.phi-begin bb) (.phi-count bb)))) (let [phi (get (.phis (.f sink)) j)] (when (dead-sunk-phi? sink phi) (let [x (cir/val (.f sink) phi)] (do (set! (.nops x) (: 0 u32))
(set! (.ntotal x) (: 0 u32))
))))))))
(defn compact-sunk-phis! [(sink (ptr Sink))] (-> void)
  (let [(mut out*) (.kept sink)] (clear! (mut out*)) (for b (range 0 (cir/i64-of (cir/block-count (.f sink)))) (let [group (cir/u32-of b) lo* (cast i64 (.phi-begin (cir/blk (.f sink) group))) hi* (cast i64 (+ (.phi-begin (cir/blk (.f sink) group)) (.phi-count (cir/blk (.f sink) group)))) begin (cast u32 (len out*))]
   (for j* (range lo* hi*)
     (let [v (get (.phis (.f sink)) j*) item v] (when (not (dead-sunk-phi? sink v)) (push! (mut out*) v))))
   (let [end (cast u32 (len out*))] (cir/configure-phi-range! (.f sink) group begin (- end begin)))))
    (set! (.kept sink) (.phis (.f sink))) (set! (.phis (.f sink)) out*)))
(defn remove-sunk-phis! [(sink (ptr Sink))] (-> void) (block :rewrite* (block :reject* (if (> (len (.dead-phis sink)) 0) (do (when true (retire-sunk-phis! sink)) (do (when true (compact-sunk-phis! sink)) (return-from :rewrite* (do)))) (return-from :reject* (do)))) (do)))
(defn finish-sunk-copies! [(sink (ptr Sink))(sunk i64)] (-> void) (block :rewrite* (block :reject* (if (> sunk 0) (do (when true (layout-sunk-copies! sink)) (do (when true (publish-sunk-layout! sink)) (do (when true (remove-sunk-phis! sink)) (do (when true (cir/compact-dead! (.f sink))) (return-from :rewrite* (do)))))) (return-from :reject* (do)))) (do)))
(defn sink-copies! [(f (ptr cir/Func))] (-> i64) (let [(mut sink) (Sink::new f)] (defer (sink-free! (mut sink))) (let [sunk (sink-block-copies! (mut sink))] (do (when true (finish-sunk-copies! (mut sink) sunk)) sunk))))
(defn forward-copies! [(f (ptr cir/Func))] (-> i64) (forward-copies-with! f (cast (ptr Summaries) 0)))
(defstruct ForwardResult [(modified bool)])
(impl ForwardResult (new [] (-> ForwardResult) (ForwardResult :modified (zeroed bool))))
(defn forward-copies-with! [(f (ptr cir/Func))(sums (ptr Summaries))] (-> i64) (let [(mut st) (state-new f sums)] (defer (state-free! (mut st))) (let [(mut result) (ForwardResult::new)] (defer (forward-result-free! (mut result))) (let [removed (forward-copies-in! (mut st) f sums (mut (.modified result)))] removed))))
(defn forward-result-free! [(result (ptr ForwardResult))] (-> void))
(defstruct ForwardRun [(st (ptr State))(f (ptr cir/Func))(sums (ptr Summaries))(modified bool)(changed bool)(removed i64)])
(impl ForwardRun (new [(st (ptr State))(f (ptr cir/Func))(sums (ptr Summaries))] (-> ForwardRun) (ForwardRun :st st :f f :sums sums :modified (zeroed bool) :changed true :removed (zeroed i64))))
(defn forward-run-free! [(run (ptr ForwardRun))] (-> void))
(defn report-modified! :inline (Always) [(modified (mut bool))(value bool)] (-> void) (do (set! modified value)
))
(defn reset-region-stamp! :inline (Always) [(st (ptr State))] (-> void) (do (set! (.stamp st) (: 0 u32))
))
(defn reset-regions! [(st (ptr State))] (-> void)
(fill-u32! (mut (.mark-f st)) (len (.insts (.f st))) (: 0 u32))
(fill-u32! (mut (.mark-b st)) (len (.insts (.f st))) (: 0 u32))
(fill-u32! (mut (.enter-f st)) (cir/i64-of (cir/block-count (.f st))) (: 0 u32))
(fill-u32! (mut (.enter-b st)) (cir/i64-of (cir/block-count (.f st))) (: 0 u32))
(reset-region-stamp! st)
(do))
(defn forward-one-copy! [(st (ptr State))(c u32)] (-> bool) (block :rewrite* (block :reject* (if (and (= (opcode (.f st) c) cop/OP-MEMCPY) (= (& (.flags (cir/val (.f st) c)) (: 8 u8)) (: 0 u8))) (let [changed (or (try-into-source! st c) (try-into-destination! st c))] (return-from :rewrite* changed)) (return-from :reject* (do)))) false))
(defn forward-round-copies! [(st (ptr State))] (-> i64) (let [(mut matches*) 0] (for c (.insts (.f st)) (let [row c result (forward-one-copy! st row)] (when result (set! matches* (+ matches* 1))))) matches*))
(defn record-forward-round! :inline (Always) [(run (ptr ForwardRun))(sunk i64)(removed i64)] (-> void) (do (set! (.changed run) (or (> sunk 0) (> removed 0)))
(set! (.removed run) (+ (.removed run) removed))
(set! (.modified run) (or (or (.modified run) (> sunk 0)) (> removed 0)))
))
(defn finish-forward-round! [(run (ptr ForwardRun))] (-> void)
(hoist! (.st run))
(cir/compact-dead! (.f run))
(drop-slots! (.st run))
(do))
(defn forward-round! [(run (ptr ForwardRun))(round i64)] (-> void) (let [sunk (sink-copies! (.f run))] (do (when true (analyze! (.st run))) (do (when (= round 0) (dominators! (.st run))) (do (when true (reset-regions! (.st run))) (let [removed (forward-round-copies! (.st run))] (do (when true (record-forward-round! run sunk removed)) (do (when (.changed run) (finish-forward-round! run)) (do)))))))))
(defn forward-rounds! [(run (ptr ForwardRun))] (-> void) (for round (range 0 4) (when (.changed run) (let [row round] (forward-round! run row)))) (do))
(defn forward-active-copies! [(run (ptr ForwardRun))] (-> void) (block :rewrite* (block :reject* (if (and (!= (len (.allocas (.f run))) 0) (block :quantified* (for c (.insts (.f run)) (when (= (opcode (.f run) c) cop/OP-MEMCPY) (return-from :quantified* true))) false)) (do (when true (state-retarget! (.st run) (.f run) (.sums run))) (do (when true (forward-rounds! run)) (return-from :rewrite* (do)))) (return-from :reject* (do)))) (do)))
(defn forward-copies-in! [(st (ptr State))(f (ptr cir/Func))(sums (ptr Summaries))(modified (mut bool))] (-> i64) (let [(mut run) (ForwardRun::new st f sums)] (defer (forward-run-free! (mut run))) (do (when true (forward-active-copies! (mut run))) (do (when true (report-modified! (mut modified) (.modified run))) (.removed run)))))
(defstruct ArgumentScan [(f (ptr cir/Func))(uses (ptr State))(edges (ptr (ArrayList Edge)))(bits u8)(work (ArrayList u32))])
(defn argument-scan-new [(f (ptr cir/Func))(uses (ptr State))(edges (ptr (ArrayList Edge)))] (-> ArgumentScan) (ArgumentScan :f f :uses uses :edges edges :bits (: 3 u8) :work (ArrayList::new [u32] (malloc-allocator))))
(defn argument-scan-free! [(scan (ptr ArgumentScan))] (-> void) (free! (mut (.work scan))))
(defn publish-argument-address! :inline (Always) [(scan (ptr ArgumentScan))(value u32)] (-> void)
(let [index* (len (.work scan))
row0* value
]
(push! (mut (.work scan)) row0*)
(do)))

(defn append-summary-edge! :inline (Always) [(edges (ptr (ArrayList Edge)))(edge Edge)] (-> void)
(let [index* (len edges)
row0* edge
]
(push! (mut edges) row0*)
(do)))

(defn weaken-argument! :inline (Always) [(scan (ptr ArgumentScan))(bits u8)] (-> void) (do (set! (.bits scan) (& (.bits scan) bits))
))
(defn argument-use-bits [(scan (ptr ArgumentScan))(user u32)(k u32)] (-> u8) (let [ x (cir/val (.f scan) user) op (cast i64 (.op x))] (cond  (= (get (.at (.uses scan)) (cir/i64-of user)) (none)) (: 0 u8) (and (= op cop/OP-ADDI) (= k (: 0 u32))) (: 3 u8) (and (and (= op cop/OP-LOAD) (= k (: 0 u32))) (not (cir/volatile? (.f scan) user))) (: 3 u8) (and (= op cop/OP-MEMCPY) (= k (: 1 u32))) (: 3 u8) (or (or (and (and (= op cop/OP-STORE) (= k (: 0 u32))) (not (cir/volatile? (.f scan) user))) (and (= op cop/OP-MEMCPY) (= k (: 0 u32)))) (and (= op cop/OP-MEMZERO) (= k (: 0 u32)))) (: 1 u8) (and (= op cop/OP-CALL) (!= (& (get (.argflags (.f scan)) (cir/i64-of (+ (.opb x) k))) (| (: 0x100 u32) (cast u32 cir/AF-INDIRECT))) (: 0 u32))) (: 1 u8) (and (= op cop/OP-CALL) (>= (.imm x) 0)) (: 3 u8) :else (: 0 u8))))
(defn publish-argument-derivation! :inline (Always) [(scan (ptr ArgumentScan))(user u32)(k u32)] (-> void) (block :rewrite* (block :reject* (if (and (and (!= (get (.at (.uses scan)) (cir/i64-of user)) (none)) (= (opcode (.f scan) user) cop/OP-ADDI)) (= k (: 0 u32))) (do (when true (publish-argument-address! scan user)) (return-from :rewrite* (do))) (return-from :reject* (do)))) (do)))
(defn publish-argument-edge! :inline (Always) [(scan (ptr ArgumentScan))(user u32)(k u32)] (-> void) (block :rewrite* (block :reject* (let [x (cir/val (.f scan) user)] (if (and (and (!= (get (.at (.uses scan)) (cir/i64-of user)) (none)) (= (cast i64 (.op x)) cop/OP-CALL)) (>= (.imm x) 0)) (if (= (& (get (.argflags (.f scan)) (cir/i64-of (+ (.opb x) k))) (| (: 0x100 u32) (cast u32 cir/AF-INDIRECT))) (: 0 u32)) (do (when true (append-summary-edge! (.edges scan) (Edge :symbol (.imm x) :arg k :operands (.nops x)))) (return-from :rewrite* (do))) (return-from :reject* (do))) (return-from :reject* (do))))) (do)))
(defn visit-argument-use! :inline (Always) [(scan (ptr ArgumentScan))(u i64)] (-> void) (let [user (get (.use-user (.uses scan)) u)] (let [k (get (.use-index (.uses scan)) u)] (do (when true (weaken-argument! scan (argument-use-bits scan user k))) (do (when true (publish-argument-derivation! scan user k)) (do (when true (publish-argument-edge! scan user k)) (do)))))))
(defn visit-argument-address! [(scan (ptr ArgumentScan))(d u32)] (-> void) (for u (range (cir/i64-of (get (.use-start (.uses scan)) (cir/i64-of d))) (cir/i64-of (get (.use-start (.uses scan)) (+ (cir/i64-of d) 1)))) (let [row u] (visit-argument-use! scan row))) (do))
(defn trace-argument! [(scan (ptr ArgumentScan))] (-> void)
   (while (> (len (.work scan)) 0)
     (let [row (get (.work scan) (- (len (.work scan)) 1))]
       (pop! (mut (.work scan))) (visit-argument-address! scan row))))
(defn local-argument! [(f (ptr cir/Func))(uses (ptr State))(arg u32)(edges (mut (ArrayList Edge)))] (-> u8) (let [(mut scan) (argument-scan-new f uses (cast (ptr (ArrayList Edge)) edges))] (defer (argument-scan-free! (mut scan))) (do (when true (publish-argument-address! (mut scan) arg)) (do (when true (trace-argument! (mut scan))) (.bits scan)))))
(defstruct Local [(bits (ArrayList u8))(edge-count (ArrayList u32))(edges (ArrayList Edge))])
(defn local-new [] (-> Local) (Local :bits (ArrayList::new [u8] (malloc-allocator)) :edge-count (ArrayList::new [u32] (malloc-allocator)) :edges (ArrayList::new [Edge] (malloc-allocator))))
(defn local-free! [(local (ptr Local))] (-> void) (free! (mut (.bits local))) (free! (mut (.edge-count local))) (free! (mut (.edges local))))
(defn clear-local-bits! [(local (ptr Local))] (-> void) (clear! (mut (.bits local))))
(defn clear-local-counts! [(local (ptr Local))] (-> void) (clear! (mut (.edge-count local))))
(defn clear-local-edges! [(local (ptr Local))] (-> void) (clear! (mut (.edges local))))
(defn append-local-argument! :inline (Always) [(local (ptr Local))(bits u8)(count u32)] (-> void)
(let [index* (len (.bits local))
row0* bits
row1* count
]
(push! (mut (.bits local)) row0*)
(push! (mut (.edge-count local)) row1*)
(do)))

(defn summarize-argument! [(st (ptr State))(f (ptr cir/Func))(local (ptr Local))(arg u32)] (-> void) (let [begin (len (.edges local))] (let [bits (local-argument! f st arg (mut (.edges local)))] (do (when true (append-local-argument! local bits (cir/u32-of (- (len (.edges local)) begin)))) (do)))))
(defn summarize-arguments! [(st (ptr State))(f (ptr cir/Func))(local (ptr Local))] (-> void) (for arg (.args f) (let [row arg] (summarize-argument! st f local row))) (do))
(defn summarize-present-arguments! [(st (ptr State))(f (ptr cir/Func))(local (ptr Local))] (-> void) (block :rewrite* (block :reject* (if (> (len (.args f)) 0) (do (when true (state-retarget! st f (cast (ptr Summaries) 0))) (do (when true (analyze-uses! st)) (do (when true (summarize-arguments! st f local)) (return-from :rewrite* (do))))) (return-from :reject* (do)))) (do)))
(defn local-summarize! [(st (ptr State))(f (ptr cir/Func))(local (ptr Local))] (-> void)
(clear-local-bits! local)
(clear-local-counts! local)
(clear-local-edges! local)
(summarize-present-arguments! st f local)
(do))
(defn symbol-bound [(syms (slice u32))] (-> i64) (let [(mut acc) (: 0 i64)] (for symbol syms (let [row (+ (cir/i64-of symbol) 1)] (set! acc (if (> row acc) row acc)))) acc))
(defstruct Dependencies [(start (ArrayList u32))(users (ArrayList u32))(cursor (ArrayList u32))])
(impl Dependencies (new [] (-> Dependencies) (Dependencies :start (ArrayList::new [u32] (malloc-allocator)) :users (ArrayList::new [u32] (malloc-allocator)) :cursor (ArrayList::new [u32] (malloc-allocator)))))
(defn dependencies-free! [(deps (ptr Dependencies))] (-> void) (free! (mut (.start deps))) (free! (mut (.users deps))) (free! (mut (.cursor deps))))
(defn configure-summary! :inline (Always) [(sums (ptr Summaries))(syms (slice u32))(group i64)(begin u32)(count u32)] (-> void) (let [symbol (cir/i64-of (get syms group))] (do (set! (mut (.first sums)) symbol (+ begin (: 1 u32)))
(set! (mut (.count sums)) symbol count)
)))
(defn layout-local-facts! [(sums (ptr Summaries))(locals (slice Local))(syms (slice u32))] (-> void) (clear! (mut (.flags sums))) (for i (range 0 (len locals)) (let [group i begin* (len (.flags sums))]
   (for bit (.bits (get locals group)) (push! (mut (.flags sums)) bit))
   (let [count* (- (len (.flags sums)) begin*)]

     (let [begin (cast u32 begin*) count (cast u32 count*)] (configure-summary! sums syms group begin count))))) (do))
(defn summarize-locals! [(sums (ptr Summaries))(locals (slice Local))(syms (slice u32))] (-> void) (let [bound (symbol-bound syms)] (let [(mut deps) (Dependencies::new)] (defer (dependencies-free! (mut deps))) (do (when true (fill-u32! (mut (.first sums)) bound (: 0 u32))) (do (when true (fill-u32! (mut (.count sums)) bound (: 0 u32))) (do (when true (layout-local-facts! sums locals syms)) (do (when true (index-callees! sums locals syms (mut (.start deps)) (mut (.users deps)) (mut (.cursor deps)))) (do (when true (solve-argument-facts! sums (mut (.start deps)) (mut (.users deps)))) (do)))))))))
(defn index-callees! [(sums (ptr Summaries))(locals (slice Local))(syms (slice u32))(start (mut (ArrayList u32)))(users (mut (ArrayList u32)))(cursor (mut (ArrayList u32)))] (-> void)
 (let [keys* (+ (len (.flags sums)) 1)]
(clear! (mut start)) (extend-zeroed! (mut start) (+ keys* 1))
(for i (range 0 (len locals)) (let [local (get locals i)] (let [base (- (cir/i64-of (get (.first sums) (cir/i64-of (get syms i)))) 1)] (let [(mut offset*) 0 counts* (.edge-count local)] (for k (range 0 (len counts*)) (let [end* (+ offset* (cast i64 (get counts* k)))] (for e (range offset* end*) (let [target (get (.edges local) e)] (let [to (summary-slot sums (.symbol target) (.arg target) (.operands target))] (let [key* (cast i64 (if (< to 0) (len (.flags sums)) to))] (set! (mut start) key* (+ (get start key*) (: 1 u32))))))) (set! offset* end*)))))))
 (let [(mut total*) (: 0 u32)]
 (for key* (range 0 keys*) (let [count* (get start key*)] (set! (mut start) key* total*) (set! total* (+ total* count*)))) (set! (mut start) keys* total*)
(clear! (mut users)) (extend-zeroed! (mut users) (cast i64 total*))
)
 (clear! (mut cursor)) (extend! (mut cursor) (.data start) keys*)
(for i (range 0 (len locals)) (let [local (get locals i)] (let [base (- (cir/i64-of (get (.first sums) (cir/i64-of (get syms i)))) 1)] (let [(mut offset*) 0 counts* (.edge-count local)] (for k (range 0 (len counts*)) (let [end* (+ offset* (cast i64 (get counts* k)))] (for e (range offset* end*) (let [target (get (.edges local) e)] (let [to (summary-slot sums (.symbol target) (.arg target) (.operands target))] (let [key* (cast i64 (if (< to 0) (len (.flags sums)) to)) at* (get cursor key*)]
(set! (mut users) (cast i64 at*) (cir/u32-of (+ base k)))
(set! (mut cursor) key* (+ at* (: 1 u32))))
))) (set! offset* end*)))))))
))

(defn solve-argument-facts! [(sums (ptr Summaries))(start (mut (ArrayList u32)))(users (mut (ArrayList u32)))] (-> void)
(let [count* (len (.flags sums)) top* (: 3 u8) boundary* (: 0 u8) (mut work*) (ArrayList::new [u32] (malloc-allocator))]
(for key* (range 0 (+ count* 1)) (when (!= (if (< key* count*) (get (.flags sums) key*) boundary*) top*) (push! (mut work*) (cast u32 key*))))
(while (> (len work*) 0) (let [key* (cast i64 (get work* (- (len work*) 1)))] (pop! (mut work*))
(let [fact* (if (< key* count*) (get (.flags sums) key*) boundary*)] (for edge* (range (cast i64 (get start key*)) (cast i64 (get start (+ key* 1))))
(let [user* (cast i64 (get users edge*)) old* (get (.flags sums) user*) next* (& old* fact*)] (when (!= next* old*) (set! (mut (.flags sums)) user* next*) (push! (mut work*) (cast u32 user*))))))))
(free! (mut work*))))

(defn summaries-hold? [(before (ptr Summaries))(after (ptr Summaries))] (-> bool) (and (= (len (.flags before)) (len (.flags after))) (block :quantified* (for i (range 0 (len (.flags before))) (when (not (= (& (get (.flags before) i) (get (.flags after) i)) (get (.flags before) i))) (return-from :quantified* false))) true)))
(defn report-weakened! [(funcs (slice (ptr cir/Func)))(syms (slice u32))(before (ptr Summaries))(after (ptr Summaries))] (-> void) (for i (range 0 (len funcs)) (let [symbol (cir/i64-of (get syms i))] (let [first (cir/i64-of (- (get (.first before) symbol) (: 1 u32)))] (for k (range 0 (cir/i64-of (get (.count before) symbol))) (let [b (get (.flags before) (+ first k))] (let [a (get (.flags after) (+ first k))] (when (!= (& b a) b) (let [row (Weakened :name (.name (load (get funcs i))) :arg k :before b :after a)] (report-weakened-argument! row))))))))) (do))
(defstruct Weakened [(name (slice u8))(arg i64)(before u8)(after u8)])
(defn report-weakened-argument! [(row Weakened)] (-> void) (do (when true (eprintln "copy forwarding: {} argument {}: {} became {}" (.name row) (.arg row) (.before row) (.after row))) (do)))
(defstruct ModuleForward [(funcs (slice (ptr cir/Func)))(syms (slice u32))(locals (ArrayList Local))(modified (ArrayList bool))(current Summaries)(next Summaries)(strengthened (ArrayList bool))(any-strengthened bool)])
(defn module-forward-new [(funcs (slice (ptr cir/Func)))(syms (slice u32))] (-> ModuleForward) (ModuleForward :funcs funcs :syms syms :locals (let [requested* (len funcs) count* (if (< requested* 0) 0 requested*) (mut rows*) (ArrayList::new [Local] (malloc-allocator))] (reserve! (mut rows*) count*) (for i (range 0 count*) (push! (mut rows*) (local-new))) rows*) :modified (library-repeat [bool] (len funcs) false) :current (summaries-new) :next (summaries-new) :strengthened (ArrayList::new [bool] (malloc-allocator)) :any-strengthened (zeroed bool)))
(defn module-forward-free! [(m (ptr ModuleForward))] (-> void)(for i* (range 0 (len (.locals m))) (local-free! (mut (elem (mut (.locals m)) i*)))) (free! (mut (.locals m))) (free! (mut (.modified m)))(summaries-free! (field m current))(summaries-free! (field m next)) (free! (mut (.strengthened m))))
(const MODULE-FORWARD-PHASES 3)
(defn calls-strengthened? [(m (ptr ModuleForward))(f (ptr cir/Func))] (-> bool) (and (.any-strengthened m) (block :quantified* (for v (.insts f) (when (let [ x (cir/val f v)] (and (and (and (= (cast i64 (.op x)) cop/OP-CALL) (>= (.imm x) 0)) (< (.imm x) (len (.strengthened m)))) (get (.strengthened m) (.imm x)))) (return-from :quantified* true))) false)))
(defn record-function-modified! :inline (Always) [(m (ptr ModuleForward))(i i64)(modified bool)] (-> void) (do (set! (mut (.modified m)) i modified)
))
(defn forward-module-function! [(m (ptr ModuleForward))(scratch (ptr State))(phase i64)(i i64)] (-> void) (block :rewrite* (block :reject* (let [f (get (.funcs m) i)] (if (or (or (= phase 1) (get (.modified m) i)) (calls-strengthened? m f)) (let [(mut result) (ForwardResult::new)] (defer (forward-result-free! (mut result))) (do (when true (forward-copies-in! scratch f (field m current) (mut (.modified result)))) (do (when true (record-function-modified! m i (.modified result))) (do (when (.modified result) (local-summarize! scratch f (elem (field m locals) i))) (return-from :rewrite* (do)))))) (return-from :reject* (do))))) (do)))
(defn module-forward-step! [(m (ptr ModuleForward))(scratch (ptr State))(phase i64)(i i64)] (-> void) (block :rewrite* (block :reject* (if (= phase 0) (do (when true (local-summarize! scratch (get (.funcs m) i) (elem (field m locals) i))) (return-from :rewrite* (do))) (return-from :reject* (do)))) (forward-module-function! m scratch phase i)))
(defn module-forward-scratch [] (-> State) (state-new (cast (ptr cir/Func) 0) (cast (ptr Summaries) 0)))
(defn module-forward-scratch-free! [(scratch (ptr State))] (-> void) (state-free! scratch))
(defn clear-strengthened-flag! :inline (Always) [(m (ptr ModuleForward))] (-> void) (do (set! (.any-strengthened m) false)
))
(defn mark-strengthened! [(m (ptr ModuleForward))] (-> void) (for symbol (range 0 (len (.first (.next m)))) (let [first (get (.first (.next m)) symbol)] (when (!= first (: 0 u32)) (for k (range 0 (cir/i64-of (get (.count (.next m)) symbol))) (let [slot (+ (- (cir/i64-of first) 1) k)] (when (!= (get (.flags (.next m)) slot) (get (.flags (.current m)) slot)) (do (set! (mut (.strengthened m)) symbol true)
(set! (.any-strengthened m) true)
))))))))
(defn update-strengthened! [(m (ptr ModuleForward))] (-> void)
(fill-bool! (mut (.strengthened m)) (len (.first (.next m))) false)
(clear-strengthened-flag! m)
(mark-strengthened! m)
(do))
(defn publish-summaries! [(m (ptr ModuleForward))] (-> void) (let [previous (.current m)] (do (set! (.current m) (.next m))
(set! (.next m) previous)
)))
(defn module-forward-join! [(m (ptr ModuleForward))(phase i64)] (-> bool) (do (when true (summarize-locals! (field m next) (slice (.locals m)) (.syms m))) (let [ok (or (= phase 0) (summaries-hold? (field m current) (field m next)))] (do (when (not ok) (report-weakened! (.funcs m) (.syms m) (field m current) (field m next))) (do (when (and (> phase 0) ok) (update-strengthened! m)) (do (when true (publish-summaries! m)) ok))))))
(defstruct ModuleRun [(module ModuleForward)(scratch State)(ok bool)])
(impl ModuleRun (new [(funcs (slice (ptr cir/Func)))(syms (slice u32))] (-> ModuleRun) (ModuleRun :module (module-forward-new funcs syms) :scratch (module-forward-scratch) :ok true)))
(defn module-run-free! [(run (ptr ModuleRun))] (-> void)(module-forward-free! (field run module))(module-forward-scratch-free! (field run scratch)))
(defn forward-module-functions! [(run (ptr ModuleRun))(phase i64)] (-> void) (for i (range 0 (len (.funcs (.module run)))) (let [row i] (module-forward-step! (field run module) (field run scratch) phase row))) (do))
(defn record-module-phase! :inline (Always) [(run (ptr ModuleRun))(ok bool)] (-> void) (do (set! (.ok run) ok)
))
(defn forward-module-phase! [(run (ptr ModuleRun))(phase i64)] (-> void) (do (when true (forward-module-functions! run phase)) (let [ok (module-forward-join! (field run module) phase)] (do (when true (record-module-phase! run ok)) (do)))))
(defn forward-module-phases! [(run (ptr ModuleRun))] (-> void) (for phase (range 0 MODULE-FORWARD-PHASES) (when (.ok run) (let [row phase] (forward-module-phase! run row)))) (do))
(defn forward-module! [(funcs (slice (ptr cir/Func)))(syms (slice u32))] (-> bool) (let [(mut run) (ModuleRun::new funcs syms)] (defer (module-run-free! (mut run))) (do (when true (forward-module-phases! (mut run))) (.ok run))))

