; src/compiler/selftest/llvm_probe.coil — FEASIBILITY PROBE for the codegen self-host port.
;
; Question: can a Coil-compiled binary link libLLVM and drive the LLVM-C API via
; FFI? Build an empty module, print it with LLVMPrintModuleToString, puts it.
;
; Build:
;   ./target/debug/coil build src/compiler/selftest/llvm_probe.coil -o /tmp/llvm_probe \
;     --link-flag -L/opt/homebrew/opt/llvm/lib --link-flag -lLLVM
;   /tmp/llvm_probe   # should print a valid (empty) LLVM module
(module coil.compiler.llvm_probe)
(import "coil.cc" :as cc)

; --- LLVM-C externs (opaque handles as (ptr i8)) ---
(extern LLVMContextCreate :cc (cc/C) [] (-> (ptr i8)))

(extern LLVMModuleCreateWithNameInContext
        :cc
        (cc/C)
        [(ptr i8) (ptr i8)]
        (-> (ptr i8)))

(extern LLVMPrintModuleToString :cc (cc/C) [(ptr i8)] (-> (ptr i8)))

(extern LLVMDisposeModule :cc (cc/C) [(ptr i8)] (-> void))

(extern LLVMContextDispose :cc (cc/C) [(ptr i8)] (-> void))

; --- libc ---
(extern puts :cc (cc/C) [(ptr i8)] (-> i32))

(defn main [] (-> i32)
  (let [ctx (LLVMContextCreate)
        m (LLVMModuleCreateWithNameInContext c"probe" ctx)
        s (LLVMPrintModuleToString m)]
    (puts s)
    (LLVMDisposeModule m)
    (LLVMContextDispose ctx)
    0))
