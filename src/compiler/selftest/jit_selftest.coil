; src/compiler/selftest/jit_selftest.coil — proves the in-memory loader before it is wired
; into the compiler. Hand-builds one MObj exercising every relocation the arm64
; backend emits, loads it with jit-load, calls the entry, checks the answer.
;
;   _leaf:   mov x0, #7 ; ret
;   _gv:     (data) 100
;   _fp:     (data) 0, with an UNSIGNED reloc naming _leaf
;   _entry:  acc  = *_gv          -> 100   PAGE21 + PAGEOFF12
;            acc += _leaf()       -> 107   BRANCH26 (defined)
;            acc += (*_fp)()      -> 114   UNSIGNED (data holds a code address)
;            acc += abs(-5)       -> 119   BRANCH26 to an UNDEFINED symbol (dlsym)
;
;   coil build src/compiler/selftest/jit_selftest.coil -o /tmp/jit-selftest && /tmp/jit-selftest
(module coil.compiler.jit_selftest)
(import "coil.primitive" :as primitive)
(import "coil.alloc" :as alloc :use *)
(import "coil.result" :use *)
(import "coil.slice" :use *)
(import "coil.str" :use *)
(import "coil.arraylist" :use *)
(import "coil.control" :use *)
(import "coil.compiler.a64" :use *)
(import "coil.compiler.macho" :use *)
(import "coil.compiler.jit" :use *)
(import "coil.cc" :as cc)
(import "coil.scratch" :as scratch)

(extern printf :cc (cc/C) [(ptr i8) ...] (-> i32))

(defn metadata-read [(bytes (slice u8)) (offset i64) (width i64)] (-> i64)
  (let [(mut value) (: 0 i64)]
    (for [i 0 width]
      (set! value (| value (<< (cast i64 (get bytes (+ offset i))) (* i 8)))))
    value))

;;; MH_OBJECT data-in-code entries use section VM addresses, not file offsets.
;;; A non-first, over-aligned text section and a >u16 table distinguish both.
(defn metadata-check [] (-> bool)
  (let [work (primitive/alloc-stack scratch/ScratchArena)]
    (scratch/ScratchArena::init-with-capacity work (malloc-allocator) 65536)
    (let [a (allocator work)
          (mut object) (mobj-new a)
          prefix (mobj-add-sect! (mut object) "__DATA" "__prefix" 3 0)
          text (mobj-add-sect! (mut object) "__TEXT" "__text" 4 2147484672)
          (mut valid) true]
      (b-zeros! (mut (mobj-sect-buf (mut object) prefix)) 24)
      (b-zeros! (mut (mobj-sect-buf (mut object) text)) 65548)
      (unless (mobj-add-text-data! (mut object)
                                   (MTextData
                                     :section text
                                     :offset 8
                                     :length 65540
                                     :kind 4))
        (set! valid false))
      (for entry [(MTextData
                    :section text
                    :offset 12
                    :length 4
                    :kind 4)
                  (MTextData
                    :section text
                    :offset 0
                    :length 4
                    :kind 4)
                  (MTextData
                    :section text
                    :offset 65548
                    :length 4
                    :kind 4)
                  (MTextData
                    :section text
                    :offset 0
                    :length 3
                    :kind 4)
                  (MTextData
                    :section text
                    :offset 0
                    :length 4
                    :kind 0)
                  (MTextData
                    :section prefix
                    :offset 0
                    :length 4
                    :kind 4)]
        (when (mobj-add-text-data! (mut object) entry) (set! valid false)))
      (unless (= (len (.text-data object)) 1) (set! valid false))
      (let [output (macho-write (mut object))
            bytes (slice (load output))
            text-address (metadata-read bytes (+ 32 72 80 32) 8)
            (mut command) (: 32 i64)
            (mut table) (: -1 i64)
            (mut size) (: 0 i64)]
        (for [i 0 (metadata-read bytes 16 4)]
          (when (= (metadata-read bytes command 4) 41)
            (set! table (metadata-read bytes (+ command 8) 4))
            (set! size (metadata-read bytes (+ command 12) 4)))
          (set! command (+ command (metadata-read bytes (+ command 4) 4))))
        (if (or (!= text-address 32)
                (< table 0)
                (!= size 16)
                (> (+ table size) (len bytes)))
            (set! valid false)
            (when (or (!= (metadata-read bytes table 4) (+ text-address 8))
                      (!= (metadata-read bytes (+ table 4) 2) 65532)
                      (!= (metadata-read bytes (+ table 6) 2) 4)
                      (!= (metadata-read bytes (+ table 8) 4)
                          (+ text-address 8 65532))
                      (!= (metadata-read bytes (+ table 12) 2) 8)
                      (!= (metadata-read bytes (+ table 14) 2) 4))
              (set! valid false))))
      (close! work)
      valid)))

(defn main [] (-> i64)
  (if (not (metadata-check))
      (do (printf c"jit-selftest: Mach-O text-data metadata FAIL\n") 1)
      (let [a (malloc-allocator)
            (mut o) (mobj-new a)
            textord (mobj-add-sect! (mut o) "__TEXT" "__text" 2 2147484672)
            dataord (mobj-add-sect! (mut o) "__DATA" "__data" 3 0)]

        ; ---- data: gv = 100, fp = &_leaf (filled by an UNSIGNED reloc) ----
        (let [dbuf (mobj-sect-buf (mut o) dataord)]
          (b-u32! (mut dbuf) 100)
          (b-u32! (mut dbuf) 0)  ; gv  @ 0
          (b-u32! (mut dbuf) 0)
          (b-u32! (mut dbuf) 0))  ; fp  @ 8

        (let [gv (mobj-add-sym! (mut o) "_gv" dataord 0 false)
              fp (mobj-add-sym! (mut o) "_fp" dataord 8 false)
              tbuf (mobj-sect-buf (mut o) textord)
              leafoff (len (load tbuf))]

          ; ---- _leaf ----
          (b-u32! (mut tbuf) (a64-movz 0 7 0))  ; mov x0, #7
          (b-u32! (mut tbuf) (a64-ret))

          (let [leaf (mobj-add-sym! (mut o) "_leaf" textord leafoff false)
                abs (mobj-add-sym! (mut o) "_abs" 0 0 true)
                entryoff (len (load tbuf))]
            ; the UNSIGNED fixup in __data that makes _fp point at _leaf
            (mobj-add-reloc! (mut o) dataord 8 leaf (reloc-unsigned) false 3)

            ; ---- _entry ----
            (b-u32! (mut tbuf) (a64-sub-imm 31 31 32))  ; sub sp, sp, #32
            (b-u32! (mut tbuf) (a64-str-x 30 31 24))  ; str x30, [sp,#24]
            (b-u32! (mut tbuf) (a64-str-x 19 31 16))  ; str x19, [sp,#16]
            (b-u32! (mut tbuf) (a64-movz 19 0 0))  ; mov x19, #0

            ; acc += *gv     (PAGE21 + PAGEOFF12)
            (mobj-add-reloc! (mut o)
                             textord
                             (len (load tbuf))
                             gv
                             (reloc-page21)
                             true
                             2)
            (b-u32! (mut tbuf) (a64-adrp 1))
            (mobj-add-reloc! (mut o)
                             textord
                             (len (load tbuf))
                             gv
                             (reloc-pageoff12)
                             false
                             2)
            (b-u32! (mut tbuf) (a64-add-imm 1 1 0))
            (b-u32! (mut tbuf) (a64-ldr-x 2 1 0))
            (b-u32! (mut tbuf) (a64-add-reg 19 19 2))

            ; acc += _leaf()   (BRANCH26, defined)
            (mobj-add-reloc! (mut o)
                             textord
                             (len (load tbuf))
                             leaf
                             (reloc-branch26)
                             true
                             2)
            (b-u32! (mut tbuf) (a64-bl-raw))
            (b-u32! (mut tbuf) (a64-add-reg 19 19 0))

            ; acc += (*fp)()   (the UNSIGNED-patched code pointer in __data)
            (mobj-add-reloc! (mut o)
                             textord
                             (len (load tbuf))
                             fp
                             (reloc-page21)
                             true
                             2)
            (b-u32! (mut tbuf) (a64-adrp 1))
            (mobj-add-reloc! (mut o)
                             textord
                             (len (load tbuf))
                             fp
                             (reloc-pageoff12)
                             false
                             2)
            (b-u32! (mut tbuf) (a64-add-imm 1 1 0))
            (b-u32! (mut tbuf) (a64-ldr-x 1 1 0))
            (b-u32! (mut tbuf) (a64-blr 1))
            (b-u32! (mut tbuf) (a64-add-reg 19 19 0))

            ; acc += abs(-5)   (BRANCH26 to an UNDEFINED symbol -> dlsym)
            (b-u32! (mut tbuf) (a64-movn 0 4 0))  ; mov x0, #-5
            (mobj-add-reloc! (mut o)
                             textord
                             (len (load tbuf))
                             abs
                             (reloc-branch26)
                             true
                             2)
            (b-u32! (mut tbuf) (a64-bl-raw))
            (b-u32! (mut tbuf) (a64-add-reg 19 19 0))

            (b-u32! (mut tbuf) (a64-mov-reg 0 19))
            (b-u32! (mut tbuf) (a64-ldr-x 19 31 16))
            (b-u32! (mut tbuf) (a64-ldr-x 30 31 24))
            (b-u32! (mut tbuf) (a64-add-imm 31 31 32))
            (b-u32! (mut tbuf) (a64-ret))
            (mobj-add-sym! (mut o) "_entry" textord entryoff true)

            ; ---- load and run ----
            (match (jit-load a (mut o))
              (Err [e0]
                   (let [(mut e) e0]
                     (let [m (.msg e)]
                       (printf c"jit-selftest: load failed: %.*s\n"
                               (primitive/cast i32 (len m))
                               (data m)))
                     1))
              (Ok [img0]
                  (let [(mut img) img0]
                    (let [fpv (jit-lookup (mut img) "entry")]
                      (if (= (primitive/cast i64 fpv) 0)
                          (do
                            (printf c"jit-selftest: entry symbol not found\n")
                            1)
                          (let [got
                                  (call-ptr (primitive/cast (fnptr (cc/C)
                                                                   []
                                                                   i64)
                                                            fpv))]
                            (printf c"jit-selftest: entry() = %ld (want 119)\n"
                                    got)
                            (if (= got 119)
                                (do (printf c"jit-selftest: PASS\n") 0)
                                (do (printf c"jit-selftest: FAIL\n") 1)))))))))))))
