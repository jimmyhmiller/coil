;;; Compiler text construction from byte slices. Each format call makes one
;;; allocation, just like sconcat/sconcat3; failed allocation yields empty text.
;;; Inputs are evaluated once, left to right, before the result is allocated.
;;; A template replaces intermediate concatenation buffers with one result.
(module coil.compiler.text)
(import "coil.primitive" :as p)
(import "coil.alloc" :use [Allocator alloc])
(import "coil.mem" :use [copy])
(import "coil.slice" :use *)
(import "coil.result" :use *)

(defn join-parts [(a (dyn Allocator)) (parts (slice (slice u8)))]
  (-> (slice u8))
  (let [(mut size) 0]
    (for [i 0 (len parts)]
      (set! size (p/iadd size (len (get parts i)))))
    (match (alloc [u8] a size)
      (None [] "")
      (Some [memory]
            (let [(mut at) 0]
              (for [i 0 (len parts)]
                (let [part (get parts i)]
                  (copy [u8] (p/index (data memory) at) (data part) (len part))
                  (set! at (p/iadd at (len part)))))
              memory)))))

; Code operations stay primitive so interpolation also stages in pruned macro
; closures, where runtime trait implementations are deliberately unavailable.
(defn format-byte [(bytes Code) (i i64)] (-> i64)
  (if (p/icmp-lt i (p/code-count bytes))
      (p/code-int (p/code-nth bytes i))
      -1))

(defn format-parts [(bytes Code)
                    (i i64)
                    (literal CodeBuilder)
                    (args Code)
                    (ai i64)
                    (parts CodeBuilder)] (-> Code)
  (if (p/icmp-eq i (p/code-count bytes))
      (if (p/icmp-eq ai (p/code-count args))
          (do
            (p/code-list-push! parts (p/bytes->str (p/code-list-done literal)))
            (p/code-list-done parts))
          (p/error "text/format: too many arguments"))
      (let [b (format-byte bytes i)
            next (format-byte bytes (p/iadd i 1))]
        (cond (p/icmp-eq b 123)
                (cond (p/icmp-eq next 123)
                        (do
                          (p/code-list-push! literal `123)
                          (format-parts bytes
                                        (p/iadd i 2)
                                        literal
                                        args
                                        ai
                                        parts))
                      (p/icmp-eq next 125)
                        (if (p/icmp-ge ai (p/code-count args))
                            (p/error "text/format: not enough arguments")
                            (do
                              (p/code-list-push! parts
                                                 (p/bytes->str (p/code-list-done literal)))
                              (p/code-list-push! parts (p/code-nth args ai))
                              (format-parts bytes
                                            (p/iadd i 2)
                                            (p/code-list-new)
                                            args
                                            (p/iadd ai 1)
                                            parts)))
                      :else (p/error "text/format: expected {} or {{"))
              (p/icmp-eq b 125)
                (if (p/icmp-eq next 125)
                    (do
                      (p/code-list-push! literal `125)
                      (format-parts bytes (p/iadd i 2) literal args ai parts))
                    (p/error "text/format: unmatched } (use }})"))
              :else
                (do
                  (p/code-list-push! literal (p/code-nth bytes i))
                  (format-parts bytes (p/iadd i 1) literal args ai parts))))))

;;; `(text/format a "name '{}'{}" name suffix)` interpolates byte slices.
;;; `{}` inserts one slice, `{{`/`}}` are literal braces. Numeric conversion and
;;; escaping are explicit at the call site. Unlike Writer formatting this only
;;; joins slices: it neither invokes Display nor changes their byte contents.
(defn format [(allocator Code) (pattern Code) & (args Code)] (-> Code)
  (if (not (p/code-string? pattern))
      (p/error "text/format: expected a string literal")
      0)
  (let [parts
          (format-parts (p/str-bytes pattern)
                        0
                        (p/code-list-new)
                        args
                        0
                        (p/code-list-new))
        n (p/code-count parts)
        a (p/fresh-identifier "allocator")
        values (p/fresh-identifier "parts")]
    `(let [~a ~allocator
           (mut ~values) (: [~@parts] (array (slice u8) ~n))]
       (join-parts ~a (slice::new (p/cast (ptr (slice u8)) (mut ~values)) ~n)))))
