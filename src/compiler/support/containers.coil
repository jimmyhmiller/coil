;;; Construction syntax shared by compiler modules without parser dependencies.
(module coil.compiler.containers)
(import "coil.primitive" :as primitive)
(import "coil.alloc" :use [box!])
(import "coil.hashmap" :use [HashMap])

;;; Allocate the map header before evaluating its key operations or initializer.
;;; Allocator syntax is repeated at the original two evaluation points.
(defn new-boxed-map [(types Code) (a Code) (ops Code)] (-> Code)
  (let [key (primitive/code-nth types 0)
        value (primitive/code-nth types 1)]
    `(box! ~a (HashMap ~key ~value) (HashMap::new ~types ~a ~ops))))
