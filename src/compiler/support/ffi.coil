; src/compiler/support/ffi.coil — the FFI surface (libc + LLVM-C) for the self-host
; compiler. All extern declarations live here; modules that call them
; (import "coil.compiler.ffi" :use *). Extern link-names are the bare C symbols.
(module coil.compiler.ffi)
(import "coil.primitive" :as primitive)
(import "coil.os" :as os)
(import "coil.cc" :as cc)

(extern open :cc (cc/C) [(ptr i8) i32 ...] (-> i32))

(extern close :cc (cc/C) [i32] (-> i32))

(extern unlink :cc (cc/C) [(ptr i8)] (-> i32))  ; remove a scratch file; every module that makes one needs it

; libc `void exit(int?)` — process exit with a code. Declared `(-> i64)` (like
; `abort`) so it composes as an expression; the return is never taken (exit does
; not return). Used to halt the tool with the nonzero exit code the
; `report`/`ExitCode::FAILURE` produces, instead of `abort`'s SIGABRT (134).
(extern exit :cc (cc/C) [i32] (-> void))

; `strtod` now belongs to the reader (its only users are the reader itself and the
; parser's float round-trip check, and the parser imports the reader). Declaring it
; in both made every module that :use's the two of them ambiguous.
(extern snprintf :cc (cc/C) [(ptr i8) i64 (ptr i8) ...] (-> i32))

(extern realpath :cc (cc/C) [(ptr i8) (ptr i8)] (-> (ptr i8)))  ; NULL on failure

(extern getcwd :cc (cc/C) [(ptr i8) isize] (-> (ptr i8)))

;;; `realpath`, for a path that may be relative. Every caller in the compiler goes
;;; through this one rather than through the extern.
;;;
;;; Handed a relative path, libc first has to learn the working directory, and on
;;; macOS `realpath` does not ask the kernel for it: it climbs from `.`, LISTING each
;;; parent and `stat`-ing every entry until one matches the directory below. So the
;;; cost of resolving one path is the number of siblings the working directory has.
;;; A project made by `mktemp -d` sits directly in `$TMPDIR`; with 390,000 stale
;;; entries there, every path the loader resolved cost 390,000 `stat` calls, a
;;; `coil check` of a ten-line project took two minutes, and the CLI gate two hours.
;;; `getcwd` does ask the kernel, so the path is made absolute with it first and
;;; `realpath` never needs the directory. The result is the same path either way.
;;;
;;; `out` is as for `realpath`: a buffer of PATH_MAX bytes, or null for a result the
;;; caller frees. A path too long to join falls through to `realpath` as given, which
;;; is still correct.
(defn realpath-rooted [(path (ptr i8)) (out (ptr i8))] (-> (ptr i8))
  (block :resolved
    (when (= (primitive/cast i64 (primitive/load path)) 47)
      (return-from :resolved (realpath path out)))
    (let [joined (primitive/cast (ptr i8) (primitive/alloc-stack (array u8 8192)))]
      (when (= (primitive/cast i64 (getcwd joined 4096)) 0)
        (return-from :resolved (realpath path out)))
      (let [(mut at) 0
            (mut from) 0]
        (loop (if (= (primitive/cast i64 (primitive/load (primitive/index joined (primitive/load at)))) 0)
                  (break)
                  (primitive/store! at (primitive/iadd (primitive/load at) 1))))
        (primitive/store! (primitive/index joined (primitive/load at)) (: 47 i8))
        (primitive/store! at (primitive/iadd (primitive/load at) 1))
        (loop
          (let [byte (primitive/load (primitive/index path (primitive/load from)))]
            (when (>= (primitive/load at) 8191)
              (return-from :resolved (realpath path out)))
            (primitive/store! (primitive/index joined (primitive/load at)) byte)
            (if (= (primitive/cast i64 byte) 0)
                (break)
                (do
                  (primitive/store! at (primitive/iadd (primitive/load at) 1))
                  (primitive/store! from (primitive/iadd (primitive/load from) 1))))))
        (realpath joined out)))))

(extern getenv :cc (cc/C) [(ptr i8)] (-> (ptr i8)))  ; NULL if the var is unset

(extern getpid :cc (cc/C) [] (-> i32))

; pthread FFI — run the deeply-recursive pipeline on a big stack, mirroring
; which spawns a 256MB-stack scoped thread. A `coil build`
; binary gets the default ~8MB main stack, which the recursive passes overflow on a
; large input (the self-host's own source). pthread_t / pthread_attr_t are carried
; as opaque buffers (a pointer-sized handle; attr is 64 bytes on macOS).
(extern pthread_create
        :cc
        (cc/C)
        [(ptr i8) (ptr i8) (fnptr (cc/C) [(ptr i8)] (ptr i8)) (ptr i8)]
        (-> i32))

; Darwin's pthread_t is a pointer; glibc's is an integer. Keep the compiler's
; opaque handle storage, but call pthread_join with the target's real C type.
; hygiene: Both target branches declare the same public pthread_join wrapper and
; private pthread_join_raw symbol. Remove the branch's quote context so callers
; resolve the selected declaration by its stable module-level name.
(defn ffi-pthread-join-abi [] (-> Code)
  (let [darwin-form `(do
         ; hygiene: Keep the target-selected pthread_join declaration's name stable.
         (extern ~(primitive/syntax->datum `pthread_join_raw)
           :as "pthread_join" :cc (cc/C) [(ptr i8) (ptr i8)] (-> i32))
         (defn ~(primitive/syntax->datum `pthread_join)
           [(handle (ptr i8)) (result (ptr i8))] (-> i32)
           (pthread_join_raw handle result)))]
    (os/os-pick `(do
         ; hygiene: Keep the target-selected pthread_join declaration's name stable.
         (extern ~(primitive/syntax->datum `pthread_join_raw)
           :as "pthread_join" :cc (cc/C) [u64 (ptr i8)] (-> i32))
         (defn ~(primitive/syntax->datum `pthread_join)
           [(handle (ptr i8)) (result (ptr i8))] (-> i32)
           (pthread_join_raw (primitive/cast u64 handle) result))) darwin-form darwin-form)))

(meta (ffi-pthread-join-abi))

(extern pthread_attr_init :cc (cc/C) [(ptr i8)] (-> i32))

(extern pthread_attr_destroy :cc (cc/C) [(ptr i8)] (-> i32))

(extern pthread_attr_setstacksize :cc (cc/C) [(ptr i8) i64] (-> i32))

(extern pthread_attr_setguardsize :cc (cc/C) [(ptr i8) i64] (-> i32))

(defn ffi-decimal-env [(name (ptr i8)) (fallback i64)] (-> i64)
  (let [text (getenv name)]
    (if (= (primitive/cast i64 text) 0)
        fallback
        (let [(mut i) 0
              (mut value) 0
              (mut valid) false]
          (loop (let [byte
                        (primitive/cast i64
                                        (load (primitive/index text (load i))))]
                  (if (= byte 0)
                      (break)
                      (if (and (>= byte 48) (<= byte 57))
                          (do
                            (set! valid true)
                            (set! value (+ (* (load value) 10) (- byte 48)))
                            (set! i (+ (load i) 1)))
                          (do (set! valid false) (break))))))
          (if (load valid) (load value) fallback)))))

(defn worker-stack-size [] (-> i64)
  ; Preserve the compiler's established 256 MiB deep-pipeline stack. The temporary
  ; 512 MiB default doubled every short-lived worker reservation without evidence
  ; that the compiler needed it; unusually deep workloads can opt up explicitly.
  (let [requested (ffi-decimal-env c"COIL_WORKER_STACK_SIZE" 268435456)]
    (if (< requested 16384) 16384 requested)))

(defn llvm-worker-stack-size [] (-> i64)
  ; LLVM partition workers do not need the compiler pipeline's enormous stack.
  ; Keep their reservation independent so parallel -O3 codegen does not reserve
  ; worker-stack-size once per partition. The Doom -O3 reproducer's LLVM-only
  ; boundary is 864 KiB on macOS/arm64; eight MiB leaves room for variation
  ; between programs, LLVM versions, and hosts without excessive reservation.
  (let [requested (ffi-decimal-env c"COIL_LLVM_WORKER_STACK_SIZE" 8388608)]
    (if (< requested 16384) 16384 requested)))

(defn worker-guard-size [] (-> i64)
  ; 64 KiB catches ordinary runaway recursion without making every short-lived
  ; compiler invocation reserve and protect a full MiB. Reproducers can raise
  ; it precisely with COIL_WORKER_GUARD_SIZE.
  (ffi-decimal-env c"COIL_WORKER_GUARD_SIZE" 65536))

; ============================ LLVM-C FFI surface =============================
; The codegen pass builds the module with LLVMBuild* and prints it with
; LLVMPrintModuleToString (which goes over
; the same C API). Opaque LLVM handles are carried as `(ptr i8)`. This is the
; surface needs; the full port wires each `LLVMBuild*` call. The
; feasibility of linking + calling these is PROVEN by src/compiler/selftest/llvm_probe.coil.
