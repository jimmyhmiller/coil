;;; Where compiler scratch arenas get their segments.
;;;
;;; A compilation's scratch arenas free hundreds of megabytes of large segments
;;; when they close. From malloc, macOS keeps those pages dirty in its
;;; large-allocation cache (and glibc in its arenas), so a process that runs
;;; compilations one after another (a JIT host, a build compiling generated
;;; units in-process) stayed that much larger after every compile.
(module coil.compiler.large_pages)
(import "coil.primitive" :as p)
(import "coil.os" :as os)
(import "coil.alloc" :use *)
(import "coil.cc" :as cc)

;;; mmap arguments for the platform being compiled FOR. A header probe would run
;;; a program on the build host and bake in its values, which is wrong when the
;;; compiler is cross-emitted (the Linux bootstrap IR is emitted on macOS):
;;; Darwin spells MAP_ANON 0x1000, Linux spells MAP_ANONYMOUS 0x20.
;;; PROT_READ|PROT_WRITE (3) and MAP_PRIVATE (2) agree.
(const LARGE_PAGES_PROT_RW 3)

(const LARGE_PAGES_MAP_PRIVATE_ANON (os/os-pick 34 4098 4098))

(extern mmap :cc (cc/C) [(ptr i8) i64 i32 i32 i32 i64] (-> (ptr i8)))
(extern munmap :cc (cc/C) [(ptr i8) i64] (-> i32))
(extern getpagesize :cc (cc/C) [] (-> i32))

;;; Requests of `threshold` bytes or more are private page mappings, unmapped when
;;; freed; smaller ones go to `small`. Frees are routed by the request's byte
;;; count, which callers must pass exactly as they allocated, as every Allocator
;;; requires.
(defstruct LargePages [(small (dyn Allocator)) (threshold i64)])

(defn large-pages-large? [(self (ptr LargePages)) (request (ref AllocRequest))] (-> bool)
  (and (>= (.bytes request) (.threshold self))
       (<= (.align request) (p/cast i64 (getpagesize)))))

(defn large-pages-length [(bytes i64)] (-> i64)
  (let [page (p/cast i64 (getpagesize))]
    (* (/ (+ bytes (- page 1)) page) page)))

(impl Allocator LargePages
  (allocate [(self (ptr LargePages)) (request (ref AllocRequest))]
            (-> (Option (ptr i8)))
            (if (large-pages-large? self request)
                (let [memory (mmap (p/cast (ptr i8) 0) (large-pages-length (.bytes request))
                                   (p/cast i32 LARGE_PAGES_PROT_RW)
                                   (p/cast i32 LARGE_PAGES_MAP_PRIVATE_ANON) -1 0)]
                  (if (= (p/cast i64 memory) -1) (None) (Some memory)))
                (raw-alloc (.small self) (load request))))
  ; Growing across the threshold would change which side frees the block, so
  ; only a small block stays with `small`; everything else reallocates.
  (resize [(self (ptr LargePages)) (memory (ptr i8)) (old (ref AllocRequest)) (new (ref AllocRequest))]
          (-> bool)
          (if (or (large-pages-large? self old) (large-pages-large? self new))
              false
              (raw-resize (.small self) memory (load old) (load new))))
  (remap [(self (ptr LargePages)) (memory (ptr i8)) (old (ref AllocRequest)) (new (ref AllocRequest))]
         (-> (Option (ptr i8)))
         (if (or (large-pages-large? self old) (large-pages-large? self new))
             (None)
             (raw-remap (.small self) memory (load old) (load new))))
  (deallocate [(self (ptr LargePages)) (memory (ptr i8)) (request (ref AllocRequest))]
              (-> i64)
              (if (large-pages-large? self request)
                  (do (when (!= (munmap memory (large-pages-length (.bytes request))) (: 0 i32))
                        (abort) 0)
                      0)
                  (raw-free (.small self) memory (load request)))))

(defn large-pages-cell [] (-> (ptr LargePages))
  (p/alloc-static LargePages))

;;; The process-wide allocator for compiler scratch: 1 MiB and larger blocks are
;;; their own mappings, everything else is malloc.
(defn large-page-allocator [] (-> (dyn Allocator))
  (let [cell (large-pages-cell)]
    (when (= (.threshold cell) 0)
      (set! (.small cell) (malloc-allocator))
      (set! (.threshold cell) 1048576)
      0)
    (p/make-dyn Allocator cell)))

; wasm has no mappings to return; its linear memory only grows.
(defn compiler-scratch-parent-impl [] (-> Code)
  (match (target-os)
    (Linux [] `(large-page-allocator))
    (Darwin [] `(large-page-allocator))
    (Wasm [] `(malloc-allocator))
    (BareMetal [] (p/error "the compiler runs on an operating system, and a bare-metal target has none"))))

;;; Where a compilation unit's scratch arena gets its segments.
(defn compiler-scratch-parent [] (-> (dyn Allocator))
  (compiler-scratch-parent-impl))
