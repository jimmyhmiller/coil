;;; Facts shared by parsing, checking and dumps. Answer sums remain unit-local
;;; in parser.coil; this table contains only the fixed scalar fallback. Operation
;;; execution and CodeBuilder validation belong to their existing stages.
(module coil.compiler.code_ops)
(import "coil.primitive" :as p)
(import "coil.control" :use *)
(import "coil.str" :use *)

(defsum CodeResult
  (IntegerResult)
  (BytesResult)
  (BooleanResult)
  (NeverResult)
  (BuilderResult)
  (NodeResult))

(defsum CodeDiagnostic
  (LiteralDiagnostic [(text (slice u8))])
  (CodeNodeDiagnostic))

(defsum CodeArguments
  (OpenArguments)
  (EmptyArguments [(diagnostic CodeDiagnostic)])
  (FixedArguments [(count i64) (diagnostic CodeDiagnostic)]))

(defstruct CodeOperation
  [(name (slice u8))
   (dump (slice u8))
   (result CodeResult)
   (code_args i64)
   (parsing CodeArguments)])

; Rows keep name-dispatch order; descriptors are indexed by their stable opcode.
; [OP NAME DUMP [RESULT CODE-ARGS [ARITY-or-:empty ARGUMENT-SYNTAX-or-:code-node]]]
; DUMP may be :name or :default (the legacy fallback); omitted result/arity
; metadata means Code with no leading Code-typed operands.
(defn operation-definitions [] (-> Code)
  `[[8 "gensym" :name :code 0 :empty ""]
    [9 "error" :name :never 0 1 "MSG"]
    [30 "target-arch" "targetarch" :code 0 :empty ""]
    [31 "report" :name :code 0 2 "NODE MSG"]
    [32 "warn" :name :code 0 2 "NODE MSG"]
    [33 "code-file" "codefile" :bytes 1 1 "NODE"]
    [34 "code-from-user?" :default :bool 0 1 :code-node]
    [35 "code-decl" "codedecl" :code 0 1 "NODE"]
    [36 "type-of" "typeof" :code 0 1 "NODE"]
    [37 "binding-of" "bindingof" :int 0 1 "NODE"]
    [39 "debug-checks?" :default :bool 0 :empty ""]
    [40 "code-line" :default :int 1 1 "NODE"]
    [41 "code-src" :default :bytes 1 1 "NODE"]
    [42 "code-col" :default :int 1 1 "NODE"]
    [43 "code-doc" :default :bytes 1 1 "NODE"]
    ; `suggest` is `warn` plus the rewrite it proposes — op 44,
    ; docs/archive/AUTOFIX.md. `delete` is `warn` plus the removal
    ; it proposes — op 58 — which is a separate op rather than a
    ; `suggest` with an empty replacement because no Code value
    ; renders as nothing.
    [44 "suggest" :default :code 0 3 "NODE MSG REPLACEMENT"]
    ; code-macro? reports whether a
    ; macro produced it rather than a human typing it (45).
    [45 "code-macro?" :default :bool 0 1 :code-node]
    [46 "target-os" :default :code 0 :empty ""]
    [52 "lint-param" :default :bytes 0 2 "KEY DEFAULT"]
    [53 "code-macro-call?" :default :bool 0 1 :code-node]
    [58 "delete" :default :code 0 2 "NODE MSG"]
    [91 "resolve-at" :default :code 0 2 "NODE NAME"]
    [92 "suggest-transaction" :default :int 0 0 ""]
    [94 "code-macro-of" :default :code 0 1 :code-node]
    [95 "code-alias-of" :default :code 0 1 :code-node]
    [108 "code-source-imports" :name]
    [109 "code-qualify-import" :name]
    [110 "code-suggest-edits" :name]
    [105 "code-source-modules" :name]
    [106 "code-source-references" :name]
    [107 "code-source-binding" :name]
    [87 "code-dependencies" :default]
    [116 "code-module-uses" :name]
    [117 "code-module-references" :name]
    [118 "code-import-references" :name]
    [119 "code-references-to" :name]
    [120 "code-module-binders" :name]
    [121 "code-module-imports" :name]
    [122 "code-reference-form" :name]
    [123 "code-definition-form" :name]
    [124 "code-resolved-uses" :name]
    [125 "code-field-uses" :name]
    [126 "code-cast-structs" :name]
    [127 "code-path" :name]
    [128 "code-module-forms" :name]
    ; describing the program to another unit (comptime.coil, program_query.coil)
    [96 "code-source" :default :bytes 0]
    [98 "program-modules" :default]
    ; the macro call being expanded (comptime.coil, cop-call-site)
    [113 "code-call-site" :default]
    [99 "module-definitions" :default]
    [100 "definition-kind" :default]
    [129 "definitions-of-kind" :name]
    [101 "definition-declaration" :default]
    [111 "definition-annotations" :default]
    [112 "definition-source" :default]
    [102 "module-header" :default]
    [103 "module-impls" :default]
    [104 "program-toolchain" :default]
    [88 "code-dependents" :default]
    [89 "code-dependency-closure" :default]
    [90 "code-dependent-closure" :default]
    [0 "code-list?" "islist" :bool 1]
    [1 "code-sym?" "issym" :bool 1]
    [2 "code-int?" "isint" :bool 1]
    [3 "code-count" "count" :int 1]
    [4 "code-nth" "nth" :code 1]
    [5 "code-sym" "sym" :bytes 1]
    [81 "code-keyword-name" :default :bytes 1]
    [6 "code-int" "int" :int 1]
    [7 "code-rest" "rest" :code 1]
    [10 "code-eq" "eq" :bool 2]
    [11 "code-keyword?" "iskeyword" :bool 1]
    [12 "code-symbol" "symbol"]
    [13 "code-str" "str" :bytes 0]
    [14 "code-field-count" "cfieldcount" :int 0]
    [15 "code-field-name" "cfieldname"]
    [16 "code-field-kind" "cfieldkind" :int 0]
    [17 "code-field-type" "cfieldtype"]
    ; the field's type name, QUALIFIED — for building symbols in generated code
    [50 "code-field-qtype" :default]
    [75 "code-type-shape" :default]
    [86 "code-type-traits" :default]
    [76 "code-session-state" :default]
    [85 "code-session-active?" :default :bool 0]
    [93 "code-session-submission" :default :int 0]
    [77 "code-session-stage!" :default :int 0]
    [78 "code-session-monomorphs" :default]
    [79 "code-session-condition!" :default]
    [80 "code-session-rejected-state" :default]
    [82 "code-session-staged-state" :default]
    [83 "check-error" :default]
    [84 "model-status" :default]
    ; `(code-deriver TRAIT TYPE)` — the deriver REGISTERED for TRAIT, already
    ; picked for TYPE's shape (comptime.coil: cop-deriver). Answered from the
    ; registration table, never from the deriver's name.
    [51 "code-deriver" :default]
    [54 "code-vector?" :default :bool 1]
    [55 "code-float?" :default :bool 1]
    [56 "code-float-bits" :default :int 1]
    [57 "code-exported?" :default :bool 0]
    [59 "code-read" :default]
    [60 "code-list-new" :default :builder 0]
    [61 "code-list-push!" :default :builder 0]
    ; freeze a CodeBuilder into Code (identity at runtime; the type is the
    ; point — docs/design/META_MEMORY.md phase 4)
    [62 "code-list-done" :default]
    [74 "code-list-like" :name]
    ; O(1) views + the two ops that SAY they copy (META_MEMORY phase 5)
    [63 "code-slice" :default]
    [64 "code-copy" :default]
    [65 "code-concat" :default]
    [66 "fresh-identifier" :name]
    [67 "datum->syntax" :name]
    [68 "syntax->datum" :name]
    [69 "free-identifier=?" :name :bool 0]
    [70 "bound-identifier=?" :name :bool 0]
    ; 66-70 were taken by the hygiene ops on main while the staged-
    ; metacompilation branch was numbering these 66-68; they are renumbered
    ; here, and every consumer (check.coil, comptime.coil) with them.
    [71 "code-opaque" :name :int 0]
    [72 "code-from-opaque" :name]
    [73 "code-string?" :name :bool 1]
    [18 "code-variant-sum" "cvariantsum"]
    ; the variant a constructor symbol names where it was written
    [114 "code-variant-ref" :default]
    ; the struct or sum a type symbol names where it was written
    [115 "code-type-ref" :default]
    [19 "code-variant-count" "cvariantcount" :int 0]
    [20 "code-variant-name" "cvariantname"]
    [21 "code-variant-fields" "cvariantfields" :int 0]
    ; the variant's FULLY-QUALIFIED name. `code-variant-name` (20) strips the
    ; qualifier, which is right for display and wrong for CODE GENERATION: an arm
    ; built from a bare name only resolves where the sum happens to be imported
    ; unqualified, so a macro emitting one produced code whose validity depended on
    ; the caller's import style.
    [49 "code-variant-qname" :default]
    [47 "code-variant-field-name" "cvariantfieldname"]
    [48 "code-variant-field-type" "cvariantfieldtype"]
    [22 "code-trait-method-count" "ctraitmethodcount" :int 0]
    [23 "code-trait-method-name" "ctraitmethodname"]
    [24 "code-trait-arity" "ctraitarity" :int 0]
    [25 "code-trait-param-name" "ctraitparamname"]
    [26 "code-trait-param-type" "ctraitparamtype"]
    [27 "code-trait-ret-type" "ctraitrettype"]
    [28 "str-bytes" "strbytes"]
    [29 "bytes->str" "bytestostr"]
    [38 "int->str" :default :bytes 0]
    ; This legacy numeric slot has no source operation name; its scalar result
    ; remains integer, as in the original checker.
    [97 "" :default :int 0]])

; Syntax diagnostics share their spelling while remaining compiled literals.
; Code-node diagnostics below deliberately keep their original runtime format.
(defn syntax-diagnostic [(name Code) (arguments Code)] (-> Code)
  (let [parts
          `[~name
            ": expects (primitive/"
            ~name
            ~@(if (= arguments `"") `[] `[" " ~arguments])
            ")"]
        bytes (p/code-list-new)]
    (for [i 0 (p/code-count parts)]
      (let [part (p/str-bytes (p/code-nth parts i))]
        (for [j 0 (p/code-count part)]
          (p/code-list-push! bytes (p/code-nth part j)))))
    (p/bytes->str (p/code-list-done bytes))))

(defn define-operations [(table Code) (number Code) (generic Code)] (-> Code)
  (let [rows (operation-definitions)
        descriptors (p/code-list-new)
        names (p/code-list-new)
        ordinary (p/code-list-new)
        head (p/fresh-identifier "head")
        n (p/code-count rows)]
    (for [slot 0 n]
      (let [(mut found) false]
        (for [i 0 n]
          (let [row (p/code-nth rows i)
                size (p/code-count row)]
            (unless (and (p/code-vector? row)
                         (or (= size 3) (= size 5) (= size 7))
                         (p/code-int? (p/code-nth row 0))
                         (p/code-string? (p/code-nth row 1))
                         (or (p/code-string? (p/code-nth row 2))
                             (= (p/code-nth row 2) `:name)
                             (= (p/code-nth row 2) `:default))
                         (or (= size 3) (p/code-int? (p/code-nth row 4))))
              (p/error "code operations: expected [OP NAME DUMP RESULT CODE-ARGS [ARITY DIAGNOSTIC]]"))
            (when (= (p/code-int (p/code-nth row 0)) slot)
              (when found (p/error "code operations: duplicate opcode"))
              (set! found true)
              (let [kind (if (= size 3) `:code (p/code-nth row 3))
                    label (p/code-nth row 2)
                    dump
                      (cond (= label `:name) (p/code-nth row 1)
                            (= label `:default) `"codefromuser"
                            :else label)
                    code-args (if (= size 3) `0 (p/code-nth row 4))
                    result
                      (cond (= kind `:int) `(IntegerResult)
                            (= kind `:bytes) `(BytesResult)
                            (= kind `:bool) `(BooleanResult)
                            (= kind `:never) `(NeverResult)
                            (= kind `:builder) `(BuilderResult)
                            (= kind `:code) `(NodeResult)
                            :else (p/error "code operations: unknown result"))
                    policy
                      (if (not (= size 7))
                          `(OpenArguments)
                          (let [arity (p/code-nth row 5)
                                raw-diagnostic (p/code-nth row 6)
                                diagnostic
                                  (cond (p/code-string? raw-diagnostic)
                                          `(LiteralDiagnostic ~(syntax-diagnostic (p/code-nth row
                                                                                              1)
                                                                                  raw-diagnostic))
                                        (= raw-diagnostic `:code-node)
                                          `(CodeNodeDiagnostic)
                                        :else
                                          (p/error "code operations: invalid diagnostic"))]

                            (if (= arity `:empty)
                                `(EmptyArguments ~diagnostic)
                                (do
                                  (unless (and (p/code-int? arity)
                                               (>= (p/code-int arity) 0))
                                    (p/error "code operations: expected nonnegative arity"))
                                  `(FixedArguments ~arity ~diagnostic)))))]
                (p/code-list-push! descriptors
                                   `(CodeOperation
                                      :name ~(p/code-nth row 1)
                                      :dump ~dump
                                      :result ~result
                                      :code_args ~code-args
                                      :parsing ~policy)))))
          0)
        (unless found (p/error "code operations: missing opcode"))))
    (for [i 0 n]
      (let [row (p/code-nth rows i)
            name (p/code-nth row 1)
            op (p/code-nth row 0)]
        (unless (= name `"")
          (for [j 0 i]
            (when (= name (p/code-nth (p/code-nth rows j) 1))
              (p/error "code operations: duplicate name")))
          (p/code-list-push! names `(= ~head ~name))
          (p/code-list-push! names op)
          (when (not (= (p/code-count row) 7))
            (p/code-list-push! ordinary `(= ~head ~name))
            (p/code-list-push! ordinary op)))))
    `(do
       (def ~table [~@(p/code-list-done descriptors)])
       (defn ~number [(~head (slice u8))] (-> i64)
         (cond ~@(p/code-list-done names) :else -1))
       (defn ~generic [(~head (slice u8))] (-> i64)
         (cond ~@(p/code-list-done ordinary) :else -1)))))

(define-operations OPERATIONS operation-number generic-number)

(defn operation [(op i64)] (-> CodeOperation)
  (if (and (>= op 0) (< op (len OPERATIONS)))
      (get OPERATIONS op)
      (CodeOperation
        :name ""
        :dump "codefromuser"
        :result (NodeResult)
        :code_args 0
        :parsing (OpenArguments))))
