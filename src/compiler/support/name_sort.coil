; src/compiler/support/name_sort.coil — self-host Coil compiler: putting a
; program's definitions in name order, so the output of specialization does not
; depend on the order it produced them in.

(module coil.compiler.name_sort)
(import "coil.alloc" :use *)
(import "coil.arraylist" :use *)
(import "coil.compiler.ast" :use *)
(import "coil.compiler.astdump" :use [str-lt])
(import "coil.compiler.parser" :use [box-al])

;;; A definition known by its name.
(deftrait Named [Self]
  (def-name [(d (ptr Self))] (-> (slice u8))))

(impl Named StructDef (def-name [(d (ptr StructDef))] (-> (slice u8)) (.name d)))
(impl Named SumDef (def-name [(d (ptr SumDef))] (-> (slice u8)) (.name d)))
(impl Named Func (def-name [(d (ptr Func))] (-> (slice u8)) (.name d)))

;;; The order of KEYS by name: a permutation of their indices, stable, so equal
;;; names keep their order. A bottom-up merge sort of indices, which compares
;;; names and moves only integers: run on every build over every definition,
;;; a sort that copied whole definitions to compare them was ~15% of the build.
(defn sort-index-by-name [(a (dyn Allocator)) (keys (ArrayList (slice u8)))] (-> (ArrayList i64))
  (let [n (len keys)
        (mut cur) (ArrayList::new [i64] a)
        (mut width) 1]
    (for [k 0 n] (push! (mut cur) k))
    (loop
      (when (>= width n) (break))
      (let [(mut next) (ArrayList::new [i64] a)
            (mut lo) 0]
        (loop
          (when (>= lo n) (break))
          (let [mid (if (< (+ lo width) n) (+ lo width) n)
                hi (if (< (+ mid width) n) (+ mid width) n)
                (mut i) lo
                (mut j) mid]
            (loop
              (when (and (>= i mid) (>= j hi)) (break))
              ; take from the left run unless it is exhausted or the right key is
              ; strictly smaller: ties keep the left one, which makes the sort stable
              (if (and (< i mid)
                       (or (>= j hi)
                           (not (str-lt (get keys (get cur j)) (get keys (get cur i))))))
                  (do (push! (mut next) (get cur i)) (set! i (+ i 1)))
                  (do (push! (mut next) (get cur j)) (set! j (+ j 1)))))
            (set! lo hi)))
        (set! cur (load next))
        (set! width (* width 2))))
    (load cur)))

;;; SRC in name order.
(defn sort-by-name [(T Named)] [(a (dyn Allocator)) (src (ptr (ArrayList T)))] (-> (ptr (ArrayList T)))
  (let [(mut keys) (ArrayList::new [(slice u8)] a)
        (mut out) (ArrayList::new [T] a)]
    (for [i 0 (len (load src))]
      (push! (mut keys) (def-name (elem src i))))
    (let [order (sort-index-by-name a (load keys))]
      (for [i 0 (len order)]
        (push! (mut out) (get (load src) (get order i)))))
    (box-al [T] a (load out))))

;;; Put P's functions, structs and sums in name order. Specialization runs this
;;; on every program it makes: the order it produces definitions in depends on
;;; the order it meets their uses, and nothing downstream may.
(defn sort-mono-program [(a (dyn Allocator)) (p (ptr Program))] (-> i64)
  (set! (.funcs p) (sort-by-name [Func] a (load (field p funcs))))
  (set! (.structs p) (sort-by-name [StructDef] a (load (field p structs))))
  (set! (.sums p) (sort-by-name [SumDef] a (load (field p sums))))
  0)
