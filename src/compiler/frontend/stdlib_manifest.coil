;;; Which modules the standard library and the compiler SDK consist of, found by
;;; reading the library directory the compiler runs beside. The loader names that
;;; directory (`library-dirs-set!`) once it has found the toolchain's layout; each
;;; table below is built from the files there on first use. Nothing lists the
;;; modules ahead of time: a file added to the library is a module of it.
(module coil.compiler.stdlib_manifest)
(import "coil.primitive" :as primitive)
(import "coil.alloc" :use *)
(import "coil.arraylist" :use *)
(import "coil.hashmap" :use *)
(import "coil.slice" :use *)
(import "coil.str" :use *)
(import "coil.fs" :as fs)

; Read only the lexical module header. Namespace discovery must not invoke read-all:
; doing so after the entry file is parsed mutates reader-global node identities and
; can corrupt later staged-macro bookkeeping. Comments and blank lines may precede
; the declaration; imported files already require it to be the first real form.
; Byte offset of the `(module …)` header's opening paren, or -1. Comments may
; precede it; nothing else may.
(defn module-header-offset [(text (slice u8))] (-> i64)
  (let [n (len text)
        (mut i) 0
        (mut comment) false
        (mut out) -1]
    (loop (if (>= (load i) n)
              (break)
              (let [c (primitive/cast i64 (get text (load i)))]
                (cond (= c 10)
                        (do
                          (store! comment false)
                          (store! i (primitive/iadd (load i) 1))
                          0)
                      (load comment) (store! i (primitive/iadd (load i) 1))
                      (= c 59)
                        (do
                          (store! comment true)
                          (store! i (primitive/iadd (load i) 1))
                          0)
                      (and (= c 40)
                           (starts-with (subslice text (load i) n) "(module "))
                        (do (store! out (load i)) (break))
                      :else (store! i (primitive/iadd (load i) 1))))))
    (load out)))

(defn namespace-declared-module [(text (slice u8))] (-> (Option (slice u8)))
  (let [n (len text)
        at (module-header-offset text)
        (mut out) (None [(slice u8)])]
    (when (>= at 0)
      (let [lo (primitive/iadd at 8)
            (mut hi) (primitive/iadd at 8)]
        (loop (if (>= (load hi) n)
                  (break)
                  (let [d
                          (primitive/cast i64
                                          (get text (load hi)))]
                    (if (or (= d 41)
                            (or (= d 32)
                                (or (= d
                                       9)
                                    (or (= d
                                           10)
                                        (= d
                                           13)))))
                        (break)
                        (store! hi
                                (primitive/iadd (load hi) 1))))))
        (when (> (load hi) lo)
          (store! out (Some (subslice text lo (load hi))))
          0)
        0)
      0)
    (load out)))


;;; X followed by Y, in A.
(defn library-join [(a (dyn Allocator)) (x (slice u8)) (y (slice u8))] (-> (slice u8))
  (match (concat a x y)
    (Some [joined] joined)
    (None [] (panic "out of memory while indexing the standard library"))))

;;; Library modules that are importable but not advertised by `coil namespaces`:
;;; implementation details of a public namespace.
(defn stdlib-internal-namespace? [(name (slice u8))] (-> bool)
  (or (= name "coil.assert.hermetic")
      (= name "coil.meta-runtime")
      (= name "coil.prop.rng")
      (= name "coil.prop.runner")
      (= name "coil.prop.shrink")))

;;; Is this namespace admitted by the allocation/environment-free profile? Grow the
;;; list only after the module's whole import and runtime closure has been audited.
(defn stdlib-hermetic-namespace? [(name (slice u8))] (-> bool)
  (or (= name "coil.assert.hermetic") (= name "coil.async") (= name "coil.atomic")
      (= name "coil.cc") (= name "coil.control") (= name "coil.derive")
      (= name "coil.dyn") (= name "coil.fail") (= name "coil.iter")
      (= name "coil.match") (= name "coil.primitive") (= name "coil.result")
      (= name "coil.simd") (= name "coil.try") (= name "coil.var")))

;;; One directory's modules: namespace -> file relative to the directory, and the
;;; set of those files.
(defstruct LibraryTable
  [(built bool)
   (files-by-name (HashMap (slice u8) (slice u8)))
   (files (HashMap (slice u8) i64))
   (names (ArrayList (slice u8)))])

(defstruct LibraryIndex
  [(stdlib-dir (slice u8))
   (sdk-dir (slice u8))
   (stdlib LibraryTable)
   (sdk LibraryTable)])

(defn library-index [] (-> (ptr LibraryIndex))
  (primitive/alloc-static LibraryIndex))

;;; Name the directories the library and the SDK are read from. Naming other
;;; directories than before rebuilds the tables on next use.
(defn library-dirs-set! [(stdlib-dir (slice u8)) (sdk-dir (slice u8))] (-> i64)
  (let [ix (library-index)
        a (malloc-allocator)]
    (unless (and (= (.stdlib-dir ix) stdlib-dir) (= (.sdk-dir ix) sdk-dir))
      (set! (.stdlib-dir ix) (library-join a stdlib-dir ""))
      (set! (.sdk-dir ix) (library-join a sdk-dir ""))
      (set! (.built (field ix stdlib)) false)
      (set! (.built (field ix sdk)) false)
      0)
    0))

;;; Add every `.coil` file under DIR (spelled PREFIX relative to the table's root)
;;; to T. A namespace two files declare keeps the first one found; hidden
;;; directories are not entered.
(defn library-scan! [(t (ptr LibraryTable)) (dir (slice u8)) (prefix (slice u8))
                     (skip (slice u8))] (-> i64)
  (let [a (malloc-allocator)]
    (match (fs/Directory::open a dir)
      (Err [_] 0)
      (Ok [d]
        (let [(mut handle) d]
          (loop
            (match (fs/Directory::next! (mut handle))
              (Err [_] (break))
              (Ok [entry]
                (match entry
                  (None [] (break))
                  (Some [e]
                    (let [name (library-join a (.name e) "")
                          n (len name)
                          path (library-join a (library-join a dir "/") name)
                          rel (if (= (len prefix) 0) name (library-join a (library-join a prefix "/") name))]
                      (match (.kind e)
                        (fs/EntryDirectory []
                          (unless (and (> n 0) (= (get name 0) (: 46 u8)))
                            (library-scan! t path rel skip)
                            0))
                        (_ (when (and (>= n 5) (= (subslice name (- n 5) n) ".coil")
                                      (!= rel skip))
                             (match (fs/read-file a path)
                               (Err [_] 0)
                               (Ok [text]
                                 (match (namespace-declared-module text)
                                   (None [] 0)
                                   (Some [ns]
                                     (let [owned (library-join a ns "")]
                                       (unless (contains? (.files-by-name t) owned)
                                         (set! (mut (.files-by-name t)) owned rel)
                                         (push! (mut (.names t)) owned)
                                         0)
                                       (set! (mut (.files t)) rel 1)
                                       0)))
                                 (free [u8] a text)
                                 0)))
                           0))))))))
          (fs/Directory::close! (mut handle))
          0)))))

;;; Build T from DIR once. Until the loader names a directory -- and in a program
;;; built with no standard library, when it never does -- the table is empty.
(defn library-table-build! [(t (ptr LibraryTable)) (dir (slice u8)) (skip (slice u8))] (-> i64)
  (unless (.built t)
    (let [a (malloc-allocator)]
      (set! (.files-by-name t) (HashMap::new [(slice u8) (slice u8)] a (keyops)))
      (set! (.files t) (HashMap::new [(slice u8) i64] a (keyops)))
      (set! (.names t) (ArrayList::new [(slice u8)] a))
      (when (> (len dir) 0) (library-scan! t dir "" skip) 0)
      (set! (.built t) true)
      0))
  0)

(defn stdlib-table [] (-> (ptr LibraryTable))
  (let [ix (library-index)
        t (field ix stdlib)]
    (library-table-build! t (.stdlib-dir ix) "")
    t))

;;; The SDK table. The wasm metaprogram shim declares the same namespace as the
;;; native one, which is the one the SDK serves.
(defn sdk-table [] (-> (ptr LibraryTable))
  (let [ix (library-index)
        t (field ix sdk)]
    (library-table-build! t (.sdk-dir ix) "meta/metashim_wasm.coil")
    t))

(defn library-name-cmp [(x (slice u8)) (y (slice u8))] (-> i64)
  (let [n (if (< (len x) (len y)) (len x) (len y))
        (mut out) (- (len x) (len y))]
    (block :done
      (for [i 0 n]
        (let [d (- (primitive/cast i64 (get x i)) (primitive/cast i64 (get y i)))]
          (when (!= d 0) (set! out d) (break :done 0))))
      0)
    (load out)))

;;; What `coil namespaces` prints: `coil.core`, which the prelude declares, and
;;; every library module that is not internal, sorted, one per line.
(defn stdlib-namespaces [] (-> (slice u8))
  (let [a (malloc-allocator)
        t (stdlib-table)
        (mut names) (ArrayList::new [(slice u8)] a)
        (mut out) (StrBuf::new a)]
    (push! (mut names) "coil.core")
    (for [i 0 (len (.names t))]
      (let [name (get (.names t) i)]
        (unless (stdlib-internal-namespace? name) (push! (mut names) name) 0)))
    (sort (slice::new (.data names) (len names)) (primitive/fnptr-of library-name-cmp))
    (for [i 0 (len names)]
      (push-str! (mut out) (get names i))
      (push-str! (mut out) "\n"))
    (str out)))

;;; The library file, relative to the stdlib directory, that declares NAME; "" when
;;; none does.
(defn stdlib-file-for-namespace [(name (slice u8))] (-> (slice u8))
  (match (get (.files-by-name (stdlib-table)) name)
    (Some [file] file)
    (None [] "")))

;;; Is this file, relative to the stdlib directory, a module of the library?
(defn stdlib-manifest-file? [(name (slice u8))] (-> bool)
  (contains? (.files (stdlib-table)) name))

(defn sdk-namespace-spelling? [(name (slice u8))] (-> bool)
  (or (starts-with name "coil.compiler.") (starts-with name "tpde.")))

;;; The compiler SDK module that declares NAME, as `compiler/…`; "" when none does.
;;; SDK modules enter a program only through an explicit coil.jit import.
(defn sdk-file-for-namespace [(name (slice u8))] (-> (slice u8))
  (if (not (sdk-namespace-spelling? name))
      ""
      (match (get (.files-by-name (sdk-table)) name)
        (Some [file] (library-join (malloc-allocator) "compiler/" file))
        (None [] ""))))

(defn sdk-manifest-file? [(name (slice u8))] (-> bool)
  (and (starts-with name "compiler/")
       (contains? (.files (sdk-table)) (subslice name 9 (len name)))))

;;; Is NAME a module the toolchain itself ships -- a standard library or compiler
;;; SDK module -- rather than one of the project's own?
;;;
;;; Ambient-core overrides need this. A root project's `[language] core-providers`
;;; entry rebinds a name like `when` for the code that project is written in, but the
;;; standard library compiled alongside it was written against the real prelude and
;;; keeps meaning what it always meant. Without the distinction, a provider that
;;; redefines `when` with a 2-argument macro miscompiles every stdlib module that
;;; calls the 3-argument one.
(defn toolchain-namespace? [(name (slice u8))] (-> bool)
  (or (> (len (stdlib-file-for-namespace name)) 0)
      (> (len (sdk-file-for-namespace name)) 0)))
