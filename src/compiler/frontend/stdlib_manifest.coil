; src/compiler/frontend/stdlib_manifest.coil — WHICH modules the standard library consists
; of, and what namespace each one declares. Not their text: the library is a real
; directory of files installed alongside the compiler, and loader.coil reads it from
; there (`find-stdlib-layout!`). Compiler and library are one toolchain, installed
; together and never separately, so there is no second copy of a module anywhere and
; no way for the two to be different versions.
;
; The compiler used to carry the whole library as `include-str` string constants. A
; single binary was portable, but an INSTALLED compiler then served the library as it
; stood on the day it was built — so a stdlib edit did nothing until the compiler was
; rebuilt, silently, and the workaround was an environment variable every invocation
; had to remember. Toolchains that are real about this (rustc's sysroot, python's
; prefix) ship the library as files and find it relative to the executable. So does
; this one now.
;
; The tables below are generated from src/stdlib/ by
; scripts/compiler/gen-stdlib-manifest.py and gated by COMPREHENSIVE's installed/allns
; step (scripts/tests/installed-toolchain.sh). Do not edit them
; by hand; add the file and regenerate. They decide what `coil namespaces` advertises
; and which `coil.*` imports are library modules rather than project modules, so an
; omission makes a shipped namespace unreachable — hence a generator and a gate rather
; than review.
(module coil.compiler.stdlib_manifest)
(import "coil.slice" :use *)
(import "coil.str" :use *)

;; BEGIN GENERATED -- regenerate with scripts/compiler/gen-stdlib-manifest.py

; Public namespace discovery for the library: what `coil namespaces`
; prints. Internal implementation-detail namespaces are importable but omitted
; here on purpose (see INTERNAL_NAMESPACES in the generator).
(defn stdlib-namespaces [] (-> (slice u8))
  "coil.alloc\ncoil.amap\ncoil.arc\ncoil.arch.riscv\ncoil.args\ncoil.arraylist\ncoil.assert\ncoil.async\ncoil.async-runtime\ncoil.atomic\ncoil.avec\ncoil.binding\ncoil.binding.runtime\ncoil.cancellation\ncoil.cc\ncoil.checked-ffi\ncoil.closure\ncoil.collect\ncoil.control\ncoil.core\ncoil.crash\ncoil.debug\ncoil.debug-allocator\ncoil.debug-runtime\ncoil.derive\ncoil.dyn\ncoil.fail\ncoil.fixedlist\ncoil.fmt\ncoil.fs\ncoil.guardalloc\ncoil.hashmap\ncoil.http.client\ncoil.http.parser\ncoil.http.server\ncoil.integer\ncoil.io\ncoil.iter\ncoil.jit\ncoil.jit.environment\ncoil.jit.reload\ncoil.json\ncoil.layout\ncoil.leased-region\ncoil.lint.allocator\ncoil.lint.default\ncoil.lint.field-syntax\ncoil.lint.import-aliases\ncoil.lint.match-else\ncoil.lint.modernize\ncoil.lint.named-constructor\ncoil.lint.names\ncoil.lint.no-star-imports\ncoil.lint.primitives\ncoil.lint.result-flow\ncoil.lint.stack-return\ncoil.lint.string\ncoil.match\ncoil.math\ncoil.mem\ncoil.memory\ncoil.meta\ncoil.mmio\ncoil.os\ncoil.os.linux\ncoil.panic\ncoil.persist\ncoil.phase\ncoil.pmap\ncoil.primitive\ncoil.print\ncoil.process\ncoil.prop\ncoil.prop.arbitrary\ncoil.prop.cov\ncoil.prop.db\ncoil.prop.derive\ncoil.prop.fuzz\ncoil.prop.gen\ncoil.prop.source\ncoil.prop.stateful\ncoil.pvec\ncoil.rc\ncoil.reader\ncoil.regex\ncoil.region\ncoil.repl\ncoil.result\ncoil.safety\ncoil.safety.checked\ncoil.safety.runtime\ncoil.scratch\ncoil.selectors\ncoil.serde\ncoil.serde.derive\ncoil.serde.json\ncoil.serde.msgpack\ncoil.serde.sexp\ncoil.serde.value\ncoil.signals\ncoil.simd\ncoil.slice\ncoil.socket\ncoil.str\ncoil.subprocess\ncoil.sync\ncoil.temp\ncoil.test-runner\ncoil.test.compile\ncoil.thread\ncoil.time\ncoil.tracealloc\ncoil.try\ncoil.unicode\ncoil.unicode.data\ncoil.unicode.grapheme\ncoil.unicode.grapheme-data\ncoil.var\n")

