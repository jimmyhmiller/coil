; src/compiler/frontend/diverge.coil — self-host Coil compiler: an expression whose
; operand never returns is replaced by the operands that actually run.

(module coil.compiler.diverge)
(import "coil.primitive" :as primitive)
(import "coil.alloc" :use *)
(import "coil.arraylist" :use *)
(import "coil.compiler.ast" :use *)
(import "coil.compiler.parser" :use [box-al])

; ---- operands that do not return -------------------------------------
; An operand of type never -- a call to a `(-> never)` function, which the
; checker follows with a breakless loop, a `break`, an `if` whose arms both
; leave -- ends the path it is evaluated on, so the expression that consumes it
; is never computed. A backend that lowers operands and then the consumer would
; emit the consumer after the path's terminator (LLVM: "Terminator found in the
; middle of a basic block") or ask for a value that does not exist (an aggregate
; argument that is not in memory). Specialization therefore replaces such an
; expression with what actually runs: its operands up to and including the one
; that does not return, in evaluation order, as a `do`. Every backend reads the
; result. Expressions are rebuilt bottom-up, so an operand that does not return
; has already become such a `do` by the time its consumer is looked at.

;;; Does evaluating `e` never finish on any path? Conservative: false means
;;; "may finish".
(defn diverges? [(e (ptr Expr))] (-> bool)
  (match (.kind e)
    (EBreak [_ _] true)
    (EContinue [_] true)
    (ELoop [_ body] (= (len (load body)) 0))
    (EDo [body] (exprs-diverge? body))
    (ELet [binds body]
          (or (binds-diverge? binds) (exprs-diverge? body)))
    (EIf [cnd thn els]
         (or (diverges? cnd) (and (diverges? thn) (diverges? els))))
    (EMatch [scrut arms]
            (or (diverges? scrut)
                (and (> (len (load arms)) 0)
                     (all-arms-diverge? arms))))
    (ECleanup [body _] (diverges? body))
    ; Specialization wraps an argument for the callee's ABI after the
    ; argument itself was rebuilt.
    (ESpillRef [inner] (diverges? inner))
    (ELoad [inner] (diverges? inner))
    (_ false)))

(defn exprs-diverge? [(es (ptr (ArrayList Expr)))] (-> bool)
  (let [(mut found) false]
    (for [i 0 (len (load es))]
      (when (diverges? (elem es i)) (set! found true) 0))
    (load found)))

(defn binds-diverge? [(bs (ptr (ArrayList Bind)))] (-> bool)
  (let [(mut found) false]
    (for [i 0 (len (load bs))]
      (when (diverges? (field (elem bs i) value)) (set! found true) 0))
    (load found)))

(defn all-arms-diverge? [(arms (ptr (ArrayList Arm)))] (-> bool)
  (let [(mut all) true]
    (for [i 0 (len (load arms))]
      (unless (diverges? (field (elem arms i) body)) (set! all false) 0))
    (load all)))

;;; An operand whose evaluation has no effect, dropped rather than kept as a
;;; statement when a later operand does not return.
(defn operand-pure? [(e (ptr Expr))] (-> bool)
  (match (.kind e)
    (EInt [_] true)
    (EWideInt [_ _ _ _ _] true)
    (EFloat [_] true)
    (EBool [_] true)
    (EStr [_] true)
    (ECStr [_] true)
    (EVar [_] true)
    (EZeroed [_] true)
    (ESizeOf [_] true)
    (EAlignOf [_] true)
    (EOffsetOf [_ _] true)
    (EFnPtrOf [_] true)
    (EStaticRef [_] true)
    (EBorrow [_ place] (operand-pure? place))
    (ELoad [inner] (operand-pure? inner))
    (EField [p _] (operand-pure? p))
    (EMovePlace [place] (operand-pure? place))
    (ESpillRef [inner] (operand-pure? inner))
    (ECast [_ inner] (operand-pure? inner))
    (_ false)))

(defn nth-operand [(es (ptr (ArrayList Expr))) (i i64)] (-> (ptr Expr))
  (if (and (>= i 0) (< i (len (load es))))
      (elem es i)
      (primitive/cast (ptr Expr) 0)))

;;; The `i`th operand of an expression, in the order backends evaluate them;
;;; null past the last. Control forms list only what they evaluate first.
(defn eval-operand [(k ExprKind) (i i64)] (-> (ptr Expr))
  (let [none (primitive/cast (ptr Expr) 0)]
    (match k
      (EBin [_ lhs rhs] (cond (= i 0) lhs (= i 1) rhs :else none))
      (ECmp [_ lhs rhs] (cond (= i 0) lhs (= i 1) rhs :else none))
      (EStore [p val] (cond (= i 0) p (= i 1) val :else none))
      (EInitStore [p val] (cond (= i 0) p (= i 1) val :else none))
      (EBitSet [p _ val] (cond (= i 0) p (= i 1) val :else none))
      (EIndex [p idx] (cond (= i 0) p (= i 1) idx :else none))
      (EIntUnary [_ inner] (if (= i 0) inner none))
      (ECast [_ inner] (if (= i 0) inner none))
      (ELoad [inner] (if (= i 0) inner none))
      (EField [p _] (if (= i 0) p none))
      (EAccessorField [p _] (if (= i 0) p none))
      (EBitGet [p _] (if (= i 0) p none))
      (EFree [inner] (if (= i 0) inner none))
      (EErase [_ inner] (if (= i 0) inner none))
      (ESpillRef [inner] (if (= i 0) inner none))
      (EMovePlace [place] (if (= i 0) place none))
      (EBorrow [_ place] (if (= i 0) place none))
      (EMakeDyn [_ _ _ inner] (if (= i 0) inner none))
      (EMakeDynOf [de] (if (= i 0) (.inner de) none))
      (EMakeSlice [data _ _] (if (= i 0) data none))
      (EIf [cnd _ _] (if (= i 0) cnd none))
      (EMatch [scrut _] (if (= i 0) scrut none))
      (EBreak [_ value]
              (match value
                (Some [vp] (if (= i 0) vp none))
                (None [] none)))
      (ECall [_ _ args] (nth-operand args i))
      (ECallPtr [fp args] (if (= i 0) fp (nth-operand args (primitive/isub i 1))))
      (EDynDispatch [dc] (if (= i 0) (.recv dc) (nth-operand (.args dc) (primitive/isub i 1))))
      (EConstruct [_ _ args] (nth-operand args i))
      (ELlvmIr [_ args _] (nth-operand args i))
      (EIntrinsic [_ _ args] (nth-operand args i))
      (EVector [_ _ _ args] (nth-operand args i))
      (_ none))))

(defn hoist-diverging-operand [(a (dyn Allocator)) (k ExprKind)] (-> ExprKind)
  (match k
    ; A binding that does not return ends the let there; the bindings before it
    ; stay in scope for it.
    (ELet [binds _]
          (let [n (len (load binds))
                (mut d) -1]
            (for [i 0 n]
              (when (and (< (load d) 0) (diverges? (field (elem binds i) value)))
                (set! d i)
                0))
            (if (< (load d) 0)
                k
                (let [(mut kept) (ArrayList::new [Bind] a)
                      (mut body) (ArrayList::new [Expr] a)]
                  (for [i 0 (load d)] (push! (mut kept) (load (elem binds i))))
                  (push! (mut body) (load (field (elem binds (load d)) value)))
                  (if (= (load d) 0)
                      (EDo (box-al [Expr] a (load body)))
                      (ELet (box-al [Bind] a (load kept))
                            (box-al [Expr] a (load body))))))))
    (_ (let [(mut d) -1
             (mut i) 0]
         (loop (let [op (eval-operand k (load i))]
                 (cond (= (primitive/cast i64 op) 0) (break)
                       (diverges? op) (do (set! d (load i)) (break))
                       :else (set! i (primitive/iadd (load i) 1)))))
         (if (< (load d) 0)
             k
             (let [(mut body) (ArrayList::new [Expr] a)]
               (for [j 0 (load d)]
                 (let [op (eval-operand k j)]
                   (unless (operand-pure? op) (push! (mut body) (load op)) 0)))
               (push! (mut body) (load (eval-operand k (load d))))
               (EDo (box-al [Expr] a (load body)))))))))
