(module coil.compiler.vector)
(import "coil.compiler.text" :as text)
(import "coil.compiler.ast" :use *)
(import "coil.compiler.vector_ops" :use *)
(import "coil.compiler.parser" :use *)
(import "coil.compiler.resolve" :use *)
(import "coil.alloc" :use *)
(import "coil.arraylist" :use *)
(import "coil.str" :use *)
(import "coil.try" :use *)
(import "coil.reader" :use *)

(defn vector-numeric-lane? [(lane (ptr Type)) (generic bool)] (-> bool)
  (match (load lane)
    (TInt [bits _] (or (= bits 8) (= bits 16) (= bits 32) (= bits 64)))
    (TFloat [bits] (or (= bits 32) (= bits 64)))
    (TStruct [_] generic)
    (_ false)))

(defn vector-integer-lane? [(lane (ptr Type)) (generic bool)] (-> bool)
  (match (load lane)
    (TInt [_ _] (vector-numeric-lane? lane generic))
    (TStruct [_] generic)
    (_ false)))

(defn vector-mask-type [(a (dyn Allocator)) (vector (ptr Type))] (-> Type)
  (TVec (box-type a (TBool)) (vector-width-of-type vector)))

(defn vector-requires-integer? [(op VectorOp)] (-> bool)
  (match op
    (VectorScanXor [] true)
    (VectorScanOr [] true)
    (VectorAnd [] true)
    (VectorOr [] true)
    (VectorXor [] true)
    (VectorNot [] true)
    (VectorShl [] true)
    (VectorShr [] true)
    (VectorAShr [] true)
    (VectorPopcount [] true)
    (VectorClz [] true)
    (VectorCtz [] true)
    (VectorBswap [] true)
    (VectorBitReverse [] true)
    (VectorAddSat [] true)
    (VectorSubSat [] true)
    (VectorRotl [] true)
    (VectorRotr [] true)
    (VectorReduceOr [] true)
    (VectorReduceAnd [] true)
    (VectorReduceXor [] true)
    (_ false)))

(defn vector-unary? [(op VectorOp)] (-> bool)
  (match op
    (VectorScanAdd [] true)
    (VectorScanXor [] true)
    (VectorScanOr [] true)
    (VectorScanMax [] true)
    (VectorNot [] true)
    (VectorPopcount [] true)
    (VectorClz [] true)
    (VectorCtz [] true)
    (VectorBswap [] true)
    (VectorBitReverse [] true)
    (VectorAbs [] true)
    (VectorNeg [] true)
    (VectorSqrt [] true)
    (VectorFloor [] true)
    (VectorCeil [] true)
    (VectorTrunc [] true)
    (VectorRound [] true)
    (VectorIsNan [] true)
    (VectorIsFinite [] true)
    (VectorReduceAdd [] true)
    (VectorReduceOr [] true)
    (VectorReduceAnd [] true)
    (VectorReduceXor [] true)
    (VectorReduceMin [] true)
    (VectorReduceMax [] true)
    (_ false)))

(defn vector-requires-float? [(op VectorOp)] (-> bool)
  (match op
    (VectorDiv [] true)
    (VectorFma [] true)
    (VectorSqrt [] true)
    (VectorFloor [] true)
    (VectorCeil [] true)
    (VectorTrunc [] true)
    (VectorRound [] true)
    (VectorIsNan [] true)
    (VectorIsFinite [] true)
    (_ false)))

(defn vector-boolean-op? [(op VectorOp)] (-> bool)
  (match op
    (VectorScanXor [] true)
    (VectorScanOr [] true)
    (VectorAnd [] true)
    (VectorOr [] true)
    (VectorXor [] true)
    (VectorNot [] true)
    (VectorEq [] true)
    (VectorNe [] true)
    (VectorReduceAnd [] true)
    (VectorReduceOr [] true)
    (VectorReduceXor [] true)
    (_ false)))

(defn vector-comparison? [(op VectorOp)] (-> bool)
  (match op
    (VectorEq [] true)
    (VectorNe [] true)
    (VectorLt [] true)
    (VectorLe [] true)
    (VectorGt [] true)
    (VectorGe [] true)
    (VectorIsNan [] true)
    (VectorIsFinite [] true)
    (_ false)))

(defn vector-reduction? [(op VectorOp)] (-> bool)
  (match op
    (VectorReduceAdd [] true)
    (VectorReduceOr [] true)
    (VectorReduceAnd [] true)
    (VectorReduceXor [] true)
    (VectorReduceMin [] true)
    (VectorReduceMax [] true)
    (_ false)))

(defn vector-check-arity [(op VectorOp) (types (ptr (ArrayList Type))) (n i64)]
  (-> (Result i64 Diag))
  (if (= (len (load types)) n)
      (Ok [i64 Diag] 0)
      (Err [i64 Diag]
           (derr "vector operation has the wrong number of operands"))))

(defn vector-check-type [(t (ptr Type)) (generic bool)] (-> (Result i64 Diag))
  (match (load t)
    (TVec [elem width]
          (if (and (or (vector-numeric-lane? elem generic)
                       (= (type-tag elem) 2))
                   (match width
                     (FixedExtent [n] (> n 0))
                     (ParamExtent [_] generic)))
              (Ok [i64 Diag] 0)
              (Err [i64 Diag]
                   (derr "vector operation requires integer, float, or boolean lanes and a positive width"))))
    (_ (Err [i64 Diag] (derr "vector operation requires a vector type")))))

(defn vector-check-same [(left (ptr Type)) (right (ptr Type))]
  (-> (Result i64 Diag))
  (if (type-eq left right)
      (Ok [i64 Diag] 0)
      (Err [i64 Diag]
           (derr "vector operands must have the same lane type and width"))))

(defn vector-memory? [(op VectorOp)] (-> bool)
  (match op
    (VectorCompressStore [] true)
    (VectorExpandLoad [] true)
    (VectorLoad [] true)
    (VectorStore [] true)
    (VectorLoadAligned [] true)
    (VectorStoreAligned [] true)
    (VectorMaskedLoad [] true)
    (VectorMaskedStore [] true)
    (VectorGather [] true)
    (VectorScatter [] true)
    (_ false)))

(defn vector-memory-store? [(op VectorOp)] (-> bool)
  (match op
    (VectorCompressStore [] true)
    (VectorStore [] true)
    (VectorStoreAligned [] true)
    (VectorMaskedStore [] true)
    (VectorScatter [] true)
    (_ false)))

(defn vector-memory-indexed? [(op VectorOp)] (-> bool)
  (match op (VectorGather [] true) (VectorScatter [] true) (_ false)))

(defn vector-memory-masked? [(op VectorOp)] (-> bool)
  (match op
    (VectorCompressStore [] true)
    (VectorExpandLoad [] true)
    (VectorMaskedLoad [] true)
    (VectorMaskedStore [] true)
    (VectorGather [] true)
    (VectorScatter [] true)
    (_ false)))

(defn vector-lane-bits [(lane (ptr Type))] (-> i64)
  (match (load lane)
    (TInt [bits _] bits)
    (TFloat [bits] bits)
    (TBool [] 1)
    (_ 0)))

(defn vector-conversion-signature [(a (dyn Allocator))
                                   (op VectorOp)
                                   (requested (ptr Type))
                                   (types (ptr (ArrayList Type)))
                                   (generic bool)] (-> (Result Type Diag))
  (try
    (try! (vector-check-arity op types 1))
    (try! (vector-check-type requested generic))
    (let [source (elem types 0)]
      (try! (vector-check-type source generic))
      (unless (and (vector-numeric-lane? (t-inner source) generic)
                   (vector-numeric-lane? (t-inner requested) generic))
        (break
          :try
            (Err [Type Diag] (derr "vector conversions require numeric lanes"))))
      (match op
        (VectorBitcast []
                       (unless generic
                         (unless (= (* (t-arrn source)
                                       (vector-lane-bits (t-inner source)))
                                    (* (t-arrn requested)
                                       (vector-lane-bits (t-inner requested))))
                           (break
                             :try
                               (Err [Type Diag]
                                    (derr "vector bitcast requires equal total bit sizes"))))))
        (_ (unless (extent-eq (vector-width-of-type source)
                              (vector-width-of-type requested))
             (break
               :try
                 (Err [Type Diag]
                      (derr "numeric vector conversion preserves lane count"))))))
      (Ok (load requested)))))

(defn vector-widening? [(op VectorOp)] (-> bool)
  (match op (VectorWidenLow [] true) (VectorWidenHigh [] true) (_ false)))

(defn vector-resize-signature [(a (dyn Allocator))
                               (op VectorOp)
                               (requested (ptr Type))
                               (types (ptr (ArrayList Type)))
                               (generic bool)] (-> (Result Type Diag))
  (try (let [widen (vector-widening? op)]
         (try! (vector-check-arity op types (if widen 1 2)))
         (try! (vector-check-type requested generic))
         (let [src (elem types 0)
               dst (t-inner requested)]
           (try! (vector-check-type src generic))
           (unless widen (try! (vector-check-same src (elem types 1))))
           (unless (and (vector-numeric-lane? (t-inner src) generic)
                        (vector-numeric-lane? dst generic))
             (break
               :try
                 (Err [Type Diag]
                      (derr "widening and narrowing require numeric lanes"))))
           (unless generic
             (let [sb (vector-lane-bits (t-inner src))
                   db (vector-lane-bits dst)]
               (unless (and (= (type-tag (t-inner src)) (type-tag dst))
                            (if widen (= db (* sb 2)) (= sb (* db 2)))
                            (if widen
                                (= (t-arrn src) (* (t-arrn requested) 2))
                                (= (t-arrn requested) (* (t-arrn src) 2))))
                 (break
                   :try
                     (Err [Type Diag]
                          (derr "widen/narrow must double/halve lane bits and halve/double lane count, preserving integer or float kind"))))
               (when (and (match op (VectorNarrowSat [] true) (_ false))
                          (= (type-tag dst) 1))
                 (break
                   :try
                     (Err [Type Diag]
                          (derr "saturating narrowing requires integer lanes"))))))
           (Ok (load requested))))))

(defn vector-permute-signature [(a (dyn Allocator))
                                (op VectorOp)
                                (types (ptr (ArrayList Type)))
                                (generic bool)]
  (-> (Result Type Diag))
  (try (let [table (match op (VectorTable [] true) (_ false))]
         (try! (vector-check-arity op types (if table 2 3)))
         (let [v (elem types 0)
               indices (elem types (if table 1 2))]
           (try! (vector-check-type v generic))
           (try! (vector-check-type indices generic))
           (unless (vector-integer-lane? (t-inner indices) generic)
             (break
               :try
                 (Err [Type Diag]
                      (derr "vector permutation indices must be integer lanes"))))
           (if table
               (try! (vector-check-same (t-inner v) (box-type a (TInt 8 false))))
               (try! (vector-check-same v (elem types 1))))
           (Ok (TVec (t-inner v) (vector-width-of-type indices)))))))

(defn vector-memory-signature [(a (dyn Allocator))
                               (op VectorOp)
                               (requested (ptr Type))
                               (types (ptr (ArrayList Type)))
                               (generic bool)] (-> (Result Type Diag))
  (try (let [writing (vector-memory-store? op)
             masked (vector-memory-masked? op)
             indexed (vector-memory-indexed? op)
             count (if indexed 4 (if masked 3 (if writing 2 1)))]
         (try! (vector-check-arity op types count))
         (let [v (if (or writing masked) (elem types (- count 1)) requested)]
           (try! (vector-check-type v generic))
           (unless (vector-numeric-lane? (t-inner v) generic)
             (break
               :try
                 (Err [Type Diag]
                      (derr "vector memory operations require numeric lanes; masks have no packed-memory ABI"))))
           (try! (vector-check-same (elem types 0)
                                    (box-type a (TPtr (t-inner v)))))
           (when masked
             (try! (vector-check-same (elem types (if indexed 2 1))
                                      (box-type a (vector-mask-type a v)))))
           (when indexed
             (let [indices (elem types 1)]
               (try! (vector-check-type indices generic))
               (unless (and (vector-integer-lane? (t-inner indices) generic)
                            (extent-eq (vector-width-of-type v)
                                       (vector-width-of-type indices)))
                 (break
                   :try
                     (Err [Type Diag]
                          (derr "gather/scatter indices must be integer lanes with the value vector's width"))))))
           (Ok (if writing (TInt 64 true) (load v)))))))

;;; One semantic signature checker, used both before and after specialization.
(defn vector-signature [(a (dyn Allocator))
                        (op VectorOp)
                        (requested (ptr Type))
                        (types (ptr (ArrayList Type)))
                        (args (ptr (ArrayList Expr)))
                        (generic bool)] (-> (Result Type Diag))
  (try (let [result
               (try! (vector-signature-infer a op requested types args generic))]
         (unless (= (type-tag requested) 3)
           (try! (vector-check-same requested (box-type a result))))
         (Ok result))))

(defn vector-signature-infer [(a (dyn Allocator))
                              (op VectorOp)
                              (requested (ptr Type))
                              (types (ptr (ArrayList Type)))
                              (args (ptr (ArrayList Expr)))
                              (generic bool)] (-> (Result Type Diag))
  (try
    (when (vector-memory? op)
      (break :try (vector-memory-signature a op requested types generic)))
    (match op
      (VectorBitcast []
                     (vector-conversion-signature a op requested types generic))
      (VectorWidenLow [] (vector-resize-signature a op requested types generic))
      (VectorWidenHigh []
                       (vector-resize-signature a op requested types generic))
      (VectorNarrow [] (vector-resize-signature a op requested types generic))
      (VectorNarrowSat []
                       (vector-resize-signature a op requested types generic))
      (VectorCompress []
                      (do
                        (try! (vector-check-arity op types 3))
                        (let [v (elem types 0)]
                          (try! (vector-check-type v generic))
                          (try! (vector-check-same v (elem types 2)))
                          (try! (vector-check-same (box-type a
                                                             (vector-mask-type a
                                                                               v))
                                                   (elem types 1)))
                          (Ok (load v)))))
      (VectorConvert []
                     (vector-conversion-signature a op requested types generic))
      (VectorShuffle [] (vector-permute-signature a op types generic))
      (VectorTable [] (vector-permute-signature a op types generic))
      (VectorIota []
                  (do
                    (try! (vector-check-arity op types 0))
                    (try! (vector-check-type requested generic))
                    (unless (vector-integer-lane? (t-inner requested) generic)
                      (break
                        :try
                          (Err [Type Diag] (derr "iota requires integer lanes"))))
                    (Ok (load requested))))
      (VectorMaskLow []
                     (do
                       (try! (vector-check-arity op types 1))
                       (try! (vector-check-type requested generic))
                       (unless (= (type-tag (t-inner requested)) 2)
                         (break
                           :try
                             (Err [Type Diag]
                                  (derr "mask-low requires a boolean vector result"))))
                       (try! (vector-check-same (elem types 0)
                                                (box-type a (TInt 64 true))))
                       (Ok (load requested))))
      (VectorLoad []
                  (do
                    (try! (vector-check-arity op types 1))
                    (try! (vector-check-type requested generic))
                    (try! (vector-check-same (elem types 0)
                                             (box-type a
                                                       (TPtr (t-inner requested)))))
                    (Ok (load requested))))
      (VectorStore []
                   (do
                     (try! (vector-check-arity op types 2))
                     (let [v (elem types 1)]
                       (try! (vector-check-type v generic))
                       (try! (vector-check-same (elem types 0)
                                                (box-type a (TPtr (t-inner v)))))
                       (Ok (TInt 64 true)))))
      (VectorMaskBits []
                      (do
                        (try! (vector-check-arity op types 1))
                        (let [mask (elem types 0)]
                          (try! (vector-check-type mask generic))
                          (unless (= (type-tag (t-inner mask)) 2)
                            (break
                              :try
                                (Err [Type Diag]
                                     (derr "mask->bits requires a boolean vector"))))
                          (match (vector-width-of-type mask)
                            (FixedExtent [n]
                                         (when (> n 64)
                                           (break
                                             :try
                                               (Err [Type Diag]
                                                    (derr "mask->bits supports at most 64 lanes")))))
                            (ParamExtent [_] 0))
                          (Ok (TInt 64 false)))))
      (VectorBitsMask []
                      (do
                        (try! (vector-check-arity op types 1))
                        (try! (vector-check-type requested generic))
                        (unless (= (type-tag (t-inner requested)) 2)
                          (break
                            :try
                              (Err [Type Diag]
                                   (derr "bits->mask requires a boolean vector result"))))
                        (try! (vector-check-same (elem types 0)
                                                 (box-type a (TInt 64 false))))
                        (match (vector-width-of-type requested)
                          (FixedExtent [n]
                                       (when (> n 64)
                                         (break
                                           :try
                                             (Err [Type Diag]
                                                  (derr "bits->mask supports at most 64 lanes")))))
                          (ParamExtent [_] 0))
                        (Ok (load requested))))
      (VectorZero []
                  (do
                    (try! (vector-check-arity op types 0))
                    (try! (vector-check-type requested generic))
                    (Ok (load requested))))
      (VectorSplat []
                   (do
                     (try! (vector-check-arity op types 1))
                     (try! (vector-check-type requested generic))
                     (try! (vector-check-same (t-inner requested)
                                              (elem types 0)))
                     (Ok (load requested))))
      (VectorLanes []
                   (do
                     (try! (vector-check-arity op types 1))
                     (try! (vector-check-type (elem types 0) generic))
                     (Ok (TInt 64 true))))
      (VectorExtract []
                     (do
                       (try! (vector-check-arity op types 2))
                       (let [v (elem types 0)]
                         (try! (vector-check-type v generic))
                         (unless (= (type-tag (elem types 1)) 0)
                           (break
                             :try
                               (Err [Type Diag]
                                    (derr "vector lane index must be an integer"))))
                         (Ok (load (t-inner v))))))
      (VectorInsert []
                    (do
                      (try! (vector-check-arity op types 3))
                      (let [v (elem types 0)]
                        (try! (vector-check-type v generic))
                        (unless (= (type-tag (elem types 1)) 0)
                          (break
                            :try
                              (Err [Type Diag]
                                   (derr "vector lane index must be an integer"))))
                        (try! (vector-check-same (t-inner v) (elem types 2)))
                        (Ok (load v)))))
      (VectorSelect []
                    (do
                      (try! (vector-check-arity op types 3))
                      (let [v (elem types 1)]
                        (try! (vector-check-type v generic))
                        (try! (vector-check-same v (elem types 2)))
                        (try! (vector-check-same (box-type a
                                                           (vector-mask-type a
                                                                             v))
                                                 (elem types 0)))
                        (Ok (load v)))))
      (VectorFma []
                 (do
                   (try! (vector-check-arity op types 3))
                   (let [v (elem types 0)]
                     (try! (vector-check-type v generic))
                     (try! (vector-check-same v (elem types 1)))
                     (try! (vector-check-same v (elem types 2)))
                     (unless (or (= (type-tag (t-inner v)) 1)
                                 (and generic (= (type-tag (t-inner v)) 6)))
                       (break
                         :try
                           (Err [Type Diag]
                                (derr "vector fma requires floating-point lanes"))))
                     (Ok (load v)))))
      (_ (do
           (try! (vector-check-arity op types (if (vector-unary? op) 1 2)))
           (let [v (elem types 0)]
             (try! (vector-check-type v generic))
             (unless (vector-unary? op)
               (try! (vector-check-same v (elem types 1))))
             (let [lane (t-inner v)]
               (unless (cond (vector-requires-float? op)
                               (or (= (type-tag lane) 1)
                                   (and generic (= (type-tag lane) 6)))
                             (vector-requires-integer? op)
                               (or (vector-integer-lane? lane generic)
                                   (and (= (type-tag lane) 2)
                                        (vector-boolean-op? op)))
                             :else
                               (or (vector-numeric-lane? lane generic)
                                   (and (= (type-tag lane) 2)
                                        (vector-boolean-op? op))))
                 (break
                   :try
                     (Err [Type Diag]
                          (derr "vector operation is not defined for this lane type"))))
               (Ok (cond (vector-comparison? op) (vector-mask-type a v)
                         (vector-reduction? op) (load lane)
                         :else (load v))))))))))

(defn vector-ir-type [(a (dyn Allocator)) (t (ptr Type))] (-> (slice u8))
  (match (load t)
    (TInt [bits _] (text/format a "i{}" (i64->str a bits)))
    (TFloat [bits] (if (= bits 32) "float" "double"))
    (TBool [] "i1")
    (TPtr [_] "ptr")
    (TRef [_ _] "ptr")
    (TVec [elem width]
          (text/format a
                       "<{} x {}>"
                       (i64->str a (extent-value width))
                       (vector-ir-type a elem)))
    (_ (do (unimplemented "nonconcrete SIMD operand type") ""))))

(defn vector-binary-instruction [(op VectorOp) (floating bool)] (-> (slice u8))
  (match op
    (VectorAdd [] (if floating "fadd" "add"))
    (VectorSub [] (if floating "fsub" "sub"))
    (VectorMul [] (if floating "fmul" "mul"))
    (VectorDiv [] "fdiv")
    (VectorAnd [] "and")
    (VectorOr [] "or")
    (VectorXor [] "xor")
    (_ "")))

(defn vector-comparison-predicate [(op VectorOp) (floating bool) (signed bool)]
  (-> (slice u8))
  (match op
    (VectorEq [] (if floating "oeq" "eq"))
    (VectorNe [] (if floating "une" "ne"))
    (VectorLt [] (if floating "olt" (if signed "slt" "ult")))
    (VectorLe [] (if floating "ole" (if signed "sle" "ule")))
    (VectorGt [] (if floating "ogt" (if signed "sgt" "ugt")))
    (VectorGe [] (if floating "oge" (if signed "sge" "uge")))
    (_ "")))

(defn vector-intrinsic-suffix [(a (dyn Allocator)) (t (ptr Type))]
  (-> (slice u8))
  (match (load t)
    (TVec [elem width]
          (text/format a
                       "v{}{}"
                       (i64->str a (extent-value width))
                       (vector-intrinsic-suffix a elem)))
    (TInt [bits _] (text/format a "i{}" (i64->str a bits)))
    (TFloat [bits] (text/format a "f{}" (i64->str a bits)))
    (TBool [] "i1")
    (_ (do (unimplemented "vector intrinsic type") ""))))

(defn vector-constant-ir [(a (dyn Allocator))
                          (t (ptr Type))
                          (constant (slice u8))]
  (-> (slice u8))
  (let [(mut out) (StrBuf::new a)
        lane (vector-ir-type a (t-inner t))]
    (push-str! (mut out) "<")
    (for [i 0 (t-arrn t)]
      (when (> i 0) (push-str! (mut out) ", "))
      (push-str! (mut out) (text/format a "{} {}" lane constant)))
    (push-str! (mut out) ">")
    (str (load out))))

(defn vector-intrinsic-ir [(a (dyn Allocator))
                           (name (slice u8))
                           (result (ptr Type))
                           (types (ptr (ArrayList Type)))
                           (defined-zero bool)] (-> (slice u8))
  (let [(mut declaration) (StrBuf::new a)
        (mut operands) (StrBuf::new a)]
    (for [i 0 (len (load types))]
      (when (> i 0)
        (push-str! (mut declaration) ", ")
        (push-str! (mut operands) ", "))
      (let [ty (vector-ir-type a (elem types i))]
        (push-str! (mut declaration) ty)
        (push-str! (mut operands) (text/format a "{} ${}" ty (i64->str a i)))))
    (when defined-zero
      (push-str! (mut declaration) ", i1")
      (push-str! (mut operands) ", i1 false"))
    (text/format a
                 "declare {} @{}({})\n%r = call $ret @{}({})\nret $ret %r"
                 (vector-ir-type a result)
                 name
                 (str (load declaration))
                 name
                 (str (load operands)))))

(defn vector-intrinsic-base [(op VectorOp) (floating bool) (signed bool)]
  (-> (slice u8))
  (match op
    (VectorPopcount [] "llvm.ctpop.")
    (VectorClz [] "llvm.ctlz.")
    (VectorCtz [] "llvm.cttz.")
    (VectorBswap [] "llvm.bswap.")
    (VectorBitReverse [] "llvm.bitreverse.")
    (VectorAddSat [] (if signed "llvm.sadd.sat." "llvm.uadd.sat."))
    (VectorSubSat [] (if signed "llvm.ssub.sat." "llvm.usub.sat."))
    (VectorMin []
               (if floating
                   "llvm.minimum."
                   (if signed "llvm.smin." "llvm.umin.")))
    (VectorMax []
               (if floating
                   "llvm.maximum."
                   (if signed "llvm.smax." "llvm.umax.")))
    (VectorAbs [] (if floating "llvm.fabs." "llvm.abs."))
    (VectorFma [] "llvm.fma.")
    (VectorSqrt [] "llvm.sqrt.")
    (VectorFloor [] "llvm.floor.")
    (VectorCeil [] "llvm.ceil.")
    (VectorTrunc [] "llvm.trunc.")
    (VectorRound [] "llvm.roundeven.")
    (VectorReduceAdd [] "llvm.vector.reduce.add.")
    (VectorReduceOr [] "llvm.vector.reduce.or.")
    (VectorReduceAnd [] "llvm.vector.reduce.and.")
    (VectorReduceXor [] "llvm.vector.reduce.xor.")
    (VectorReduceMin []
                     (if floating
                         "llvm.vector.reduce.fminimum."
                         (if signed
                             "llvm.vector.reduce.smin."
                             "llvm.vector.reduce.umin.")))
    (VectorReduceMax []
                     (if floating
                         "llvm.vector.reduce.fmaximum."
                         (if signed
                             "llvm.vector.reduce.smax."
                             "llvm.vector.reduce.umax.")))
    (_ "")))

(defn vector-arithmetic-ir [(a (dyn Allocator))
                            (op VectorOp)
                            (result (ptr Type))
                            (types (ptr (ArrayList Type)))]
  (-> (Result (slice u8) Diag))
  (let [v (elem types 0)
        lane (t-inner v)
        floating (= (type-tag lane) 1)
        signed (t-int-signed lane)
        instruction (vector-binary-instruction op floating)
        intrinsic (vector-intrinsic-base op floating signed)
        suffix (vector-intrinsic-suffix a v)]
    (cond (match op (VectorIsNan [] true) (_ false))
            (Ok "%r = fcmp uno $t0 $0, $0\nret $ret %r")
          (match op (VectorIsFinite [] true) (_ false))
            (let [abs-name (text/format a "llvm.fabs.{}" suffix)
                  ty (vector-ir-type a v)
                  infinity (vector-constant-ir a v "0x7FF0000000000000")]
              (Ok (text/format a
                               "declare {} @{}({})\n%abs = call $t0 @{}($t0 $0)\n%r = fcmp olt $t0 %abs, {}\nret $ret %r"
                               ty
                               abs-name
                               ty
                               abs-name
                               infinity)))
          (vector-comparison? op)
            (Ok (text/format a
                             "{}{} $t0 $0, $1\nret $ret %r"
                             (if floating "%r = fcmp " "%r = icmp ")
                             (vector-comparison-predicate op floating signed)))
          (> (len instruction) 0)
            (Ok (text/format a "%r = {} $ret $0, $1\nret $ret %r" instruction))
          (match op (VectorNot [] true) (_ false))
            (Ok (text/format a
                             "%r = xor $ret $0, {}\nret $ret %r"
                             (vector-constant-ir a v "-1")))
          (match op (VectorNeg [] true) (_ false))
            (Ok (if floating
                    "%r = fneg $ret $0\nret $ret %r"
                    "%r = sub $ret zeroinitializer, $0\nret $ret %r"))
          (and (match op (VectorAbs [] true) (_ false))
               (and (not floating) (not signed)))
            (Ok "ret $ret $0")
          (match op
            (VectorShl [] true)
            (VectorShr [] true)
            (VectorAShr [] true)
            (_ false))
            (let [count-mask
                    (vector-constant-ir a
                                        v
                                        (i64->str a (- (t-int-bits lane) 1)))
                  opcode
                    (match op
                      (VectorShl [] "shl")
                      (VectorShr [] "lshr")
                      (_ "ashr"))]
              (Ok (text/format a
                               "%counts = and $t1 $1, {}\n%r = {} $ret $0, %counts\nret $ret %r"
                               count-mask
                               opcode)))
          (match op (VectorRotl [] true) (VectorRotr [] true) (_ false))
            (let [name
                    (sconcat a
                             (match op
                               (VectorRotl [] "llvm.fshl.")
                               (_ "llvm.fshr."))
                             suffix)
                  ty (vector-ir-type a v)]
              (Ok (text/format a
                               "declare {} @{}({}, {}, {})\n%r = call $ret @{}($t0 $0, $t0 $0, $t1 $1)\nret $ret %r"
                               ty
                               name
                               ty
                               ty
                               ty
                               name)))
          (and (match op (VectorBswap [] true) (_ false))
               (= (t-int-bits lane) 8))
            (Ok "ret $ret $0")
          (and (match op (VectorReduceAdd [] true) (_ false)) floating)
            (let [name (text/format a "llvm.vector.reduce.fadd.{}" suffix)
                  scalar (vector-ir-type a result)
                  vector (vector-ir-type a v)]
              (Ok (text/format a
                               "declare {} @{}({}, {})\n%r = call $ret @{}($ret -0.0, $t0 $0)\nret $ret %r"
                               scalar
                               name
                               scalar
                               vector
                               name)))
          (> (len intrinsic) 0)
            (Ok (vector-intrinsic-ir a
                                     (sconcat a intrinsic suffix)
                                     result
                                     types
                                     (match op
                                       (VectorClz [] true)
                                       (VectorCtz [] true)
                                       (VectorAbs [] (not floating))
                                       (_ false))))
          :else
            (Err [(slice u8) Diag]
                 (derr (text/format a
                                    "vector lowering is not implemented: {}"
                                    (vector-op-name op)))))))

(defn vector-resize-ir [(a (dyn Allocator))
                        (op VectorOp)
                        (result (ptr Type))
                        (types (ptr (ArrayList Type)))] (-> (slice u8))
  (let [source (elem types 0)
        src (t-inner source)
        dst (t-inner result)
        widen (vector-widening? op)
        floating (= (type-tag src) 1)
        signed (match (load src) (TInt [_ s] s) (_ false))
        dsigned (match (load dst) (TInt [_ s] s) (_ false))
        count (t-arrn result)
        db (vector-lane-bits dst)
        wide (box-type a (fixed-vec src count))
        wt (vector-ir-type a wide)
        (mut out) (StrBuf::new a)]
    (push-str! (mut out) "%parts = shufflevector $t0 $0, $t0 ")
    (push-str! (mut out) (if widen "zeroinitializer" "$1"))
    (push-str! (mut out) (text/format a ", <{} x i32> <" (i64->str a count)))
    (for [i 0 count]
      (when (> i 0) (push-str! (mut out) ", "))
      (push-str! (mut out)
                 (text/format a
                              "i32 {}"
                              (i64->str a
                                        (+ i
                                           (match op
                                             (VectorWidenHigh [] count)
                                             (_ 0)))))))
    (push-str! (mut out) ">\n")
    (when (match op (VectorNarrowSat [] true) (_ false))
      (let [upper (- (<< 1 (if dsigned (- db 1) db)) 1)
            lower (if (and signed dsigned) (- 0 (<< 1 (- db 1))) 0)
            lo (vector-constant-ir a wide (i64->str a lower))
            hi (vector-constant-ir a wide (i64->str a upper))
            mt (text/format a "<{} x i1>" (i64->str a count))]
        (push-str! (mut out)
                   (text/format a
                                "%low = icmp {}{}"
                                (if signed "slt " "ult ")
                                wt))
        (push-str! (mut out) (text/format a " %parts, {}\n%lo = select " lo))
        (push-str! (mut out) (text/format a "{} %low, {}" mt wt))
        (push-str! (mut out) (text/format a " {}, " lo))
        (push-str! (mut out) (text/format a "{} %parts\n" wt))
        (push-str! (mut out)
                   (text/format a
                                "%high = icmp {}{}"
                                (if signed "sgt " "ugt ")
                                wt))
        (push-str! (mut out) (text/format a " %lo, {}\n%clamped = select " hi))
        (push-str! (mut out) (text/format a "{} %high, {}" mt wt))
        (push-str! (mut out) (text/format a " {}, " hi))
        (push-str! (mut out) (text/format a "{} %lo\n" wt))))
    (push-str! (mut out)
               (text/format a
                            "%r = {} "
                            (if widen
                                (if floating "fpext" (if signed "sext" "zext"))
                                (if floating "fptrunc" "trunc"))))
    (push-str! (mut out)
               (sconcat a
                        wt
                        (match op
                          (VectorNarrowSat [] " %clamped")
                          (_ " %parts"))))
    (push-str! (mut out) " to $ret\nret $ret %r")
    (str (load out))))

(defn vector-lane-access-ir [(a (dyn Allocator))
                             (op VectorOp)
                             (types (ptr (ArrayList Type)))] (-> (slice u8))
  (let [index (elem types 1)
        bits (vector-lane-bits index)
        signed (match (load index) (TInt [_ s] s) (_ false))
        prefix
          (if (= bits 64)
              "%index = or i64 $1, 0\n"
              (if signed
                  "%index = sext $t1 $1 to i64\n"
                  "%index = zext $t1 $1 to i64\n"))]
    (text/format a
                 "{}%valid = icmp ult i64 %index, {}\n%safe = select i1 %valid, i64 %index, i64 0\n{}"
                 prefix
                 (i64->str a (t-arrn (elem types 0)))
                 (match op
                   (VectorExtract []
                                  "%x = extractelement $t0 $0, i64 %safe\n%r = select i1 %valid, $ret %x, $ret zeroinitializer\nret $ret %r")
                   (_ "%x = insertelement $t0 $0, $t2 $2, i64 %safe\n%r = select i1 %valid, $ret %x, $ret $0\nret $ret %r")))))

(defn vector-conversion-ir [(a (dyn Allocator))
                            (op VectorOp)
                            (result (ptr Type))
                            (source (ptr Type))] (-> (slice u8))
  (let [src (t-inner source)
        dst (t-inner result)
        sf (= (type-tag src) 1)
        df (= (type-tag dst) 1)
        ss (match (load src) (TInt [_ signed] signed) (_ false))
        ds (match (load dst) (TInt [_ signed] signed) (_ false))
        sb (vector-lane-bits src)
        db (vector-lane-bits dst)]
    (cond (match op (VectorBitcast [] true) (_ false))
            "%r = bitcast $t0 $0 to $ret\nret $ret %r"
          (and sf (not df))
            (let [name
                    (text/format a
                                 "{}{}.{}"
                                 (if ds "llvm.fptosi.sat." "llvm.fptoui.sat.")
                                 (vector-intrinsic-suffix a result)
                                 (vector-intrinsic-suffix a source))
                  (mut types) (ArrayList::new [Type] a)]
              (push! (mut types) (load source))
              (vector-intrinsic-ir a
                                   name
                                   result
                                   (box-al [Type] a (load types))
                                   false))
          (and (not sf) df)
            (text/format a
                         "%r = {} $t0 $0 to $ret\nret $ret %r"
                         (if ss "sitofp" "uitofp"))
          (= sb db) "ret $ret $0"
          :else
            (text/format a
                         "%r = {} $t0 $0 to $ret\nret $ret %r"
                         (if sf
                             (if (< sb db) "fpext" "fptrunc")
                             (if (< sb db) (if ss "sext" "zext") "trunc"))))))

(defn vector-permute-ir [(a (dyn Allocator))
                         (op VectorOp)
                         (result (ptr Type))
                         (types (ptr (ArrayList Type)))] (-> (slice u8))
  (let [table (match op (VectorTable [] true) (_ false))
        v (elem types 0)
        width (t-arrn v)
        operand (if table "1" "2")
        indices (elem types (if table 1 2))
        it (vector-ir-type a (t-inner indices))
        et (vector-ir-type a (t-inner v))
        ib (vector-lane-bits (t-inner indices))
        (mut out) (StrBuf::new a)]
    (for [i 0 (t-arrn result)]
      (let [n (i64->str a i)
            next (i64->str a (+ i 1))]
        (push-str! (mut out) (text/format a "%raw{} = extractelement $t" n))
        (push-str! (mut out) (text/format a "{} ${}" operand operand))
        (push-str! (mut out) (text/format a ", i32 {}\n" n))
        (push-str! (mut out) (text/format a "%index{} = " n))
        (if (= ib 64)
            (push-str! (mut out) (text/format a "or i64 %raw{}, 0\n" n))
            (do
              (push-str! (mut out)
                         (text/format a
                                      "{}{} %raw"
                                      (match (load (t-inner indices))
                                        (TInt [_ signed]
                                              (if signed "sext " "zext "))
                                        (_ "zext "))
                                      it))
              (push-str! (mut out) (text/format a "{} to i64\n" n))))
        (push-str! (mut out) (text/format a "%valid{} = icmp ult i64 %index" n))
        (push-str! (mut out)
                   (text/format a
                                "{}, {}"
                                n
                                (i64->str a (if table width (* width 2)))))
        (push-str! (mut out) (text/format a "\n%low{} = icmp ult i64 %index" n))
        (push-str! (mut out) (text/format a "{}, {}" n (i64->str a width)))
        (push-str! (mut out) (text/format a "\n%safe{} = select i1 %low" n))
        (push-str! (mut out) (text/format a "{}, i64 %index{}" n n))
        (push-str! (mut out) ", i64 0\n")
        (push-str! (mut out)
                   (text/format a
                                "%left{} = extractelement $t0 $0, i64 %safe"
                                n))
        (push-str! (mut out) (text/format a "{}\n" n))
        (unless table
          (push-str! (mut out) (text/format a "%upper{} = sub i64 %index" n))
          (push-str! (mut out) (text/format a "{}, {}" n (i64->str a width)))
          (push-str! (mut out)
                     (text/format a "\n%uppervalid{} = icmp ult i64 %upper" n))
          (push-str! (mut out) (text/format a "{}, {}" n (i64->str a width)))
          (push-str! (mut out)
                     (text/format a "\n%uppersafe{} = select i1 %uppervalid" n))
          (push-str! (mut out) (text/format a "{}, i64 %upper{}" n n))
          (push-str! (mut out) ", i64 0\n")
          (push-str! (mut out)
                     (text/format a
                                  "%right{} = extractelement $t1 $1, i64 %uppersafe"
                                  n))
          (push-str! (mut out) (text/format a "{}\n" n)))
        (push-str! (mut out) (text/format a "%chosen{} = select i1 %low" n))
        (push-str! (mut out) (text/format a "{}, {}" n et))
        (push-str! (mut out) (text/format a " %left{}, " n))
        (push-str! (mut out)
                   (sconcat a
                            et
                            (if table
                                " zeroinitializer\n"
                                (text/format a " %right{}\n" n))))
        (push-str! (mut out) (text/format a "%value{} = select i1 %valid" n))
        (push-str! (mut out) (text/format a "{}, {}" n et))
        (push-str! (mut out) (text/format a " %chosen{}, " n))
        (push-str! (mut out) (text/format a "{} zeroinitializer\n" et))
        (push-str! (mut out) (text/format a "%v{} = insertelement $ret " next))
        (push-str! (mut out)
                   (if (= i 0) "zeroinitializer" (text/format a "%v{}" n)))
        (push-str! (mut out) (text/format a ", {} %value" et))
        (push-str! (mut out) (text/format a "{}, i32 {}" n n))
        (push-str! (mut out) "\n")))
    (push-str! (mut out)
               (text/format a "ret $ret %v{}" (i64->str a (t-arrn result))))
    (str (load out))))

(defn vector-iota-ir [(a (dyn Allocator)) (lanes i64) (lane (slice u8))]
  (-> (slice u8))
  (let [(mut out) (StrBuf::new a)]
    (push-str! (mut out) "<")
    (for [i 0 lanes]
      (when (> i 0) (push-str! (mut out) ", "))
      (push-str! (mut out) (text/format a "{} {}" lane (i64->str a i))))
    (push-str! (mut out) ">")
    (str (load out))))

(defn vector-packed-memory-ir [(a (dyn Allocator))
                               (op VectorOp)
                               (types (ptr (ArrayList Type)))] (-> (slice u8))
  (let [v (elem types 2)
        writing (match op (VectorCompressStore [] true) (_ false))]
    (match (load (t-inner v))
      ; A bool lane is one bit of a packed <N x i1> in memory, so the lane
      ; buffer below cannot address it; LLVM's own lowering stays correct.
      (TBool [] (vector-packed-memory-intrinsic-ir a writing v))
      (_ (vector-packed-memory-loop-ir a writing v)))))

(defn vector-packed-memory-intrinsic-ir [(a (dyn Allocator))
                                         (writing bool)
                                         (v (ptr Type))]
  (-> (slice u8))
  (let [vt (vector-ir-type a v)
        mt (vector-ir-type a (box-type a (vector-mask-type a v)))
        name
          (sconcat a
                   (if writing
                       "llvm.masked.compressstore."
                       "llvm.masked.expandload.")
                   (vector-intrinsic-suffix a v))
        (mut out) (StrBuf::new a)]
    (if writing
        (do
          (push-str! (mut out) (text/format a "declare void @{}(" name))
          (push-str! (mut out) (text/format a "{}, ptr, {}" vt mt))
          (push-str! (mut out)
                     (text/format a
                                  ")\ncall void @{}($t2 $2, ptr $0, $t1 $1)\nret i64 0"
                                  name)))
        (do
          (push-str! (mut out) (text/format a "declare {} @" vt))
          (push-str! (mut out) (text/format a "{}(ptr, {}" name mt))
          (push-str! (mut out) (text/format a ", {})\n%r = call $ret @" vt))
          (push-str! (mut out)
                     (text/format a
                                  "{}(ptr $0, $t1 $1, $t2 $2)\nret $ret %r"
                                  name))))
    (str (load out))))

;;; Compress-store and expand-load as a loop over the mask's set bits: count
;;; trailing zeros, move that lane through a stack copy of the vector, clear the
;;; lowest bit. No Coil target enables a native compress (AVX-512, SVE), so
;;; LLVM scalarizes the masked.compressstore/expandload intrinsics into a
;;; test-and-branch per lane, which on AArch64 ran more than 3x slower than this
;;; for the sparse masks these operations mostly see; here the work is
;;; proportional to the active lanes.
(defn vector-packed-memory-loop-ir [(a (dyn Allocator))
                                    (writing bool)
                                    (v (ptr Type))]
  (-> (slice u8))
  (let [lanes (t-arrn v)
        bt (text/format a "i{}" (i64->str a lanes))
        et (vector-ir-type a (t-inner v))
        (mut out) (StrBuf::new a)]
    (push-str! (mut out)
               (text/format a "declare {} @llvm.cttz.{}({}, i1)\n" bt bt bt))
    ; The lane buffer holds the stored vector, or the fill that loaded lanes overwrite.
    (push-str! (mut out) "%lanes = alloca $t2\nstore $t2 $2, ptr %lanes\n")
    (push-str! (mut out) (text/format a "%bits0 = bitcast $t1 $1 to {}\n" bt))
    (push-str! (mut out)
               (text/format a
                            "%bitsp = alloca {}\nstore {} %bits0, ptr %bitsp\n"
                            bt
                            bt))
    (push-str! (mut out)
               "%cursorp = alloca ptr\nstore ptr $0, ptr %cursorp\nbr label %head\n")
    (push-str! (mut out)
               (text/format a "head:\n%bits = load {}, ptr %bitsp\n" bt))
    (push-str! (mut out)
               (text/format a
                            "%done = icmp eq {} %bits, 0\nbr i1 %done, label %exit, label %body\n"
                            bt))
    (push-str! (mut out)
               (text/format a
                            "body:\n%tz = call {} @llvm.cttz.{}({} %bits, i1 true)\n"
                            bt
                            bt
                            bt))
    (push-str! (mut out)
               (cond (< lanes 64)
                       (text/format a "%lane = zext {} %tz to i64\n" bt)
                     (> lanes 64)
                       (text/format a "%lane = trunc {} %tz to i64\n" bt)
                     :else "%lane = add i64 %tz, 0\n"))
    (push-str! (mut out)
               (text/format a
                            "%slot = getelementptr {}, ptr %lanes, i64 %lane\n"
                            et))
    (push-str! (mut out) "%cursor = load ptr, ptr %cursorp\n")
    (if writing
        (push-str! (mut out)
                   (text/format a
                                "%elt = load {}, ptr %slot\nstore {} %elt, ptr %cursor, align 1\n"
                                et
                                et))
        (push-str! (mut out)
                   (text/format a
                                "%elt = load {}, ptr %cursor, align 1\nstore {} %elt, ptr %slot\n"
                                et
                                et)))
    (push-str! (mut out)
               (text/format a
                            "%next = getelementptr {}, ptr %cursor, i64 1\nstore ptr %next, ptr %cursorp\n"
                            et))
    (push-str! (mut out)
               (text/format a
                            "%less = sub {} %bits, 1\n%cleared = and {} %bits, %less\n"
                            bt
                            bt))
    (push-str! (mut out)
               (text/format a
                            "store {} %cleared, ptr %bitsp\nbr label %head\nexit:\n"
                            bt))
    (push-str! (mut out)
               (if writing
                   "ret i64 0"
                   "%r = load $ret, ptr %lanes\nret $ret %r"))
    (str (load out))))

(defn vector-memory-ir [(a (dyn Allocator))
                        (op VectorOp)
                        (result (ptr Type))
                        (types (ptr (ArrayList Type)))]
  (-> (slice u8))
  (let [writing (vector-memory-store? op)
        indexed (vector-memory-indexed? op)
        masked (vector-memory-masked? op)
        vi (- (len (load types)) 1)
        v (if (or writing masked) (elem types vi) result)
        vt (vector-ir-type a v)
        mt (vector-ir-type a (box-type a (vector-mask-type a v)))
        suffix (vector-intrinsic-suffix a v)
        (mut out) (StrBuf::new a)]
    (if (not masked)
        (let [aligned
                (match op
                  (VectorLoadAligned [] true)
                  (VectorStoreAligned [] true)
                  (_ false))
              (mut alignment) 1
              bytes
                (* (t-arrn v)
                   (/ (match (load (t-inner v))
                        (TInt [bits _] bits)
                        (TFloat [bits] bits)
                        (_ 8))
                      8))]
          (when aligned
            (loop (if (>= (load alignment) bytes)
                      (break)
                      (set! alignment (* (load alignment) 2)))))
          (if writing
              (text/format a
                           "store $t1 $1, ptr $0, align {}\nret i64 0"
                           (i64->str a (load alignment)))
              (text/format a
                           "%r = load $ret, ptr $0, align {}\nret $ret %r"
                           (i64->str a (load alignment)))))
        (if (match op
              (VectorCompressStore [] true)
              (VectorExpandLoad [] true)
              (_ false))
            (vector-packed-memory-ir a op types)
            (if indexed
                (let [indices (elem types 1)
                      lane (t-inner indices)
                      (mut signed) false
                      bits
                        (match (load lane)
                          (TInt [bits s] (do (set! signed s) bits))
                          (_ 64))
                      it
                        (vector-ir-type a
                                        (box-type a
                                                  (fixed-vec (box-type a
                                                                       (TInt 64
                                                                             true))
                                                             (t-arrn v))))
                      pt (text/format a "<{} x ptr>" (i64->str a (t-arrn v)))
                      et (vector-ir-type a (t-inner v))]
                  (if (= bits 64)
                      (push-str! (mut out)
                                 "%indices = or $t1 $1, zeroinitializer\n")
                      (push-str! (mut out)
                                 (text/format a
                                              "{}{}\n"
                                              (if (load signed)
                                                  "%indices = sext $t1 $1 to "
                                                  "%indices = zext $t1 $1 to ")
                                              it)))
                  ; Inactive offsets may be arbitrary, so this is deliberately not inbounds.
                  (push-str! (mut out)
                             (text/format a
                                          "%addresses = getelementptr {}, ptr $0, {} %indices\n"
                                          et
                                          it))
                  (if writing
                      (do
                        ; Duplicate indices have lane-order semantics, unlike LLVM scatter.
                        (for [i 0 (t-arrn v)]
                          (let [n (i64->str a i)
                                next (i64->str a (+ i 1))]
                            (push-str! (mut out)
                                       (text/format a
                                                    "%active{} = extractelement $t2 $2, i32 {}\n"
                                                    n
                                                    n))
                            (push-str! (mut out)
                                       (text/format a
                                                    "br i1 %active{}, label %write{}, label %next{}\n"
                                                    n
                                                    n
                                                    next))
                            (push-str! (mut out) (text/format a "write{}:\n" n))
                            (push-str! (mut out)
                                       (text/format a
                                                    "%address{} = extractelement {} %addresses, i32 {}\n"
                                                    n
                                                    pt
                                                    n))
                            (push-str! (mut out)
                                       (text/format a
                                                    "%value{} = extractelement $t3 $3, i32 {}\n"
                                                    n
                                                    n))
                            (push-str! (mut out)
                                       (text/format a
                                                    "store {} %value{}, ptr %address{}, align 1\n"
                                                    et
                                                    n
                                                    n))
                            (push-str! (mut out)
                                       (text/format a
                                                    "br label %next{}\nnext{}:\n"
                                                    next
                                                    next))))
                        (push-str! (mut out) "ret i64 0"))
                      (let [name
                              (text/format a
                                           "llvm.masked.gather.{}.v{}p0"
                                           suffix
                                           (i64->str a (t-arrn v)))]
                        (push-str! (mut out)
                                   (text/format a
                                                "declare {} @{}({}, i32, {}, {})\n"
                                                vt
                                                name
                                                pt
                                                mt
                                                vt))
                        (push-str! (mut out)
                                   (text/format a
                                                "%r = call $ret @{}({} %addresses, i32 1, $t2 $2, $t3 $3)\nret $ret %r"
                                                name
                                                pt))))
                  (str (load out)))
                (let [name
                        (text/format a
                                     "{}{}.p0"
                                     (if writing
                                         "llvm.masked.store."
                                         "llvm.masked.load.")
                                     suffix)]
                  (if writing
                      (do
                        (push-str! (mut out)
                                   (text/format a
                                                "declare void @{}({}, ptr, i32, {})\n"
                                                name
                                                vt
                                                mt))
                        (push-str! (mut out)
                                   (text/format a
                                                "call void @{}($t2 $2, ptr $0, i32 1, $t1 $1)\nret i64 0"
                                                name)))
                      (do
                        (push-str! (mut out)
                                   (text/format a
                                                "declare {} @{}(ptr, i32, {}, {})\n"
                                                vt
                                                name
                                                mt
                                                vt))
                        (push-str! (mut out)
                                   (text/format a
                                                "%r = call $ret @{}(ptr $0, i32 1, $t1 $1, $t2 $2)\nret $ret %r"
                                                name))))
                  (str (load out))))))))

; Explicit lane extraction fixes lane zero to bit zero on every endianness.
(defn vector-ballot-ir [(a (dyn Allocator)) (lanes i64)] (-> (slice u8))
  (let [(mut out) (StrBuf::new a)]
    (push-str! (mut out) "%bits0 = or i64 0, 0\n")
    (for [i 0 lanes]
      (let [n (i64->str a i)
            next (i64->str a (+ i 1))]
        (push-str! (mut out)
                   (text/format a "%lane{} = extractelement $t0 $0, i32 " n))
        (push-str! (mut out) (text/format a "{}\n" n))
        (push-str! (mut out) (text/format a "%wide{} = zext i1 %lane" n))
        (push-str! (mut out) (text/format a "{} to i64\n" n))
        (push-str! (mut out) (text/format a "%shift{} = shl i64 %wide" n))
        (push-str! (mut out) (text/format a "{}, {}\n" n n))
        (push-str! (mut out) (text/format a "%bits{} = or i64 %bits" next))
        (push-str! (mut out) (text/format a "{}, %shift{}\n" n n))))
    (push-str! (mut out) (text/format a "ret i64 %bits{}" (i64->str a lanes)))
    (str (load out))))

(defn vector-from-bits-ir [(a (dyn Allocator)) (lanes i64)] (-> (slice u8))
  (let [(mut out) (StrBuf::new a)]
    (for [i 0 lanes]
      (let [n (i64->str a i)
            next (i64->str a (+ i 1))]
        (push-str! (mut out) (text/format a "%shift{} = lshr i64 $0, " n))
        (push-str! (mut out) (text/format a "{}\n" n))
        (push-str! (mut out) (text/format a "%bit{} = trunc i64 %shift" n))
        (push-str! (mut out) (text/format a "{} to i1\n" n))
        (push-str! (mut out)
                   (text/format a "%mask{} = insertelement $ret " next))
        (push-str! (mut out)
                   (if (= i 0) "zeroinitializer" (text/format a "%mask{}" n)))
        (push-str! (mut out) (text/format a ", i1 %bit{}, i32 " n))
        (push-str! (mut out) (text/format a "{}\n" n))))
    (push-str! (mut out) (text/format a "ret $ret %mask{}" (i64->str a lanes)))
    (str (load out))))

;;; Lower concrete, checked vectors into ordinary always-inlined LLVM helpers.
;;; No generic types, target-specific opcode strings, or width-specific wrappers
;;; escape into the public library API.
(defn vector-neon-table-ir [(a (dyn Allocator))
                            (result (ptr Type))
                            (types (ptr (ArrayList Type)))] (-> (slice u8))
  (let [table (elem types 0)
        indices (elem types 1)
        n (t-arrn table)
        m (t-arrn result)
        parts (/ (+ n 15) 16)
        chunks (/ (+ m 15) 16)
        bits (vector-lane-bits (t-inner indices))
        byte-type (vector-ir-type a result)
        intrinsic
          (text/format a "llvm.aarch64.neon.tbl{}.v16i8" (i64->str a parts))
        (mut out) (StrBuf::new a)]
    (push-str! (mut out) (text/format a "declare <16 x i8> @{}(" intrinsic))
    (for [i 0 parts] (push-str! (mut out) "<16 x i8>, "))
    (push-str! (mut out) "<16 x i8>)\n")
    (for [part 0 parts]
      (push-str! (mut out)
                 (text/format a
                              "%table{} = shufflevector $t0 $0, $t0 zeroinitializer, <16 x i32> <"
                              (i64->str a part)))
      (for [j 0 16]
        (when (> j 0) (push-str! (mut out) ", "))
        (let [index (+ (* part 16) j)]
          (push-str! (mut out)
                     (text/format a
                                  "i32 {}"
                                  (i64->str a (if (< index n) index n))))))
      (push-str! (mut out) ">\n"))
    ; Validate in the original index width, before narrowing to byte indices.
    (push-str! (mut out)
               (text/format a
                            "%valid = icmp ult $t1 $1, {}\n"
                            (vector-constant-ir a indices (i64->str a n))))
    (if (= bits 8)
        (push-str! (mut out) "%bytes = or $t1 $1, zeroinitializer\n")
        (push-str! (mut out)
                   (text/format a "%bytes = trunc $t1 $1 to {}\n" byte-type)))
    (push-str! (mut out)
               (text/format a
                            "%safe = select <{} x i1> %valid, "
                            (i64->str a m)))
    (push-str! (mut out) (text/format a "{} %bytes, {}" byte-type byte-type))
    (push-str! (mut out)
               (text/format a " {}\n" (vector-constant-ir a result "255")))
    (for [chunk 0 chunks]
      (let [c (i64->str a chunk)]
        (push-str! (mut out) (text/format a "%indices{} = shufflevector " c))
        (push-str! (mut out) (text/format a "{} %safe, {}" byte-type byte-type))
        (push-str! (mut out) " zeroinitializer, <16 x i32> <")
        (for [j 0 16]
          (when (> j 0) (push-str! (mut out) ", "))
          (let [index (+ (* chunk 16) j)]
            (push-str! (mut out)
                       (text/format a
                                    "i32 {}"
                                    (i64->str a (if (< index m) index m))))))
        (push-str! (mut out) (text/format a ">\n%chunk{} = call <16 x i8> @" c))
        (push-str! (mut out) (text/format a "{}(" intrinsic))
        (for [part 0 parts]
          (push-str! (mut out)
                     (text/format a "<16 x i8> %table{}, " (i64->str a part))))
        (push-str! (mut out) (text/format a "<16 x i8> %indices{})\n" c))))
    (for [i 0 m]
      (let [s (i64->str a i)
            next (i64->str a (+ i 1))]
        (push-str! (mut out)
                   (text/format a "%lane{} = extractelement <16 x i8> %chunk" s))
        (push-str! (mut out)
                   (text/format a
                                "{}, i32 {}"
                                (i64->str a (/ i 16))
                                (i64->str a (% i 16))))
        (push-str! (mut out)
                   (text/format a "\n%result{} = insertelement $ret " next))
        (push-str! (mut out)
                   (if (= i 0) "zeroinitializer" (text/format a "%result{}" s)))
        (push-str! (mut out) (text/format a ", i8 %lane{}, i32 " s))
        (push-str! (mut out) (text/format a "{}\n" s))))
    (push-str! (mut out) (text/format a "ret $ret %result{}" (i64->str a m)))
    (str (load out))))

(defn vector-ballot-reduce-ir [(a (dyn Allocator)) (lanes i64)] (-> (slice u8))
  (let [vt (text/format a "<{} x i8>" (i64->str a lanes))
        groups (/ (+ lanes 7) 8)
        (mut out) (StrBuf::new a)]
    (push-str! (mut out) "declare i8 @llvm.vector.reduce.add.v8i8(<8 x i8>)\n")
    (push-str! (mut out) (text/format a "%weighted = select $t0 $0, {} <" vt))
    (for [i 0 lanes]
      (when (> i 0) (push-str! (mut out) ", "))
      (push-str! (mut out)
                 (text/format a "i8 {}" (i64->str a (<< 1 (% i 8))))))
    (push-str! (mut out)
               (text/format a
                            ">, {} zeroinitializer\n%bits0 = or i64 0, 0\n"
                            vt))
    (for [group 0 groups]
      (let [g (i64->str a group)
            next (i64->str a (+ group 1))]
        (push-str! (mut out) (text/format a "%group{} = shufflevector " g))
        (push-str! (mut out) (text/format a "{} %weighted, {}" vt vt))
        (push-str! (mut out) " zeroinitializer, <8 x i32> <")
        (for [j 0 8]
          (when (> j 0) (push-str! (mut out) ", "))
          (let [i (+ (* group 8) j)]
            (push-str! (mut out)
                       (text/format a
                                    "i32 {}"
                                    (i64->str a (if (< i lanes) i lanes))))))
        (push-str! (mut out)
                   (text/format a
                                ">\n%byte{} = call i8 @llvm.vector.reduce.add.v8i8(<8 x i8> %group"
                                g))
        (push-str! (mut out) (text/format a "{})\n%wide{}" g g))
        (push-str! (mut out)
                   (text/format a " = zext i8 %byte{} to i64\n%shift" g))
        (push-str! (mut out) (text/format a "{} = shl i64 %wide{}" g g))
        (push-str! (mut out)
                   (text/format a ", {}\n%bits" (i64->str a (* group 8))))
        (push-str! (mut out) (text/format a "{} = or i64 %bits{}" next g))
        (push-str! (mut out) (text/format a ", %shift{}\n" g))))
    (push-str! (mut out) (text/format a "ret i64 %bits{}" (i64->str a groups)))
    (str (load out))))

(defn lower-vector-for-target [(a (dyn Allocator))
                               (arch i64)
                               (op VectorOp)
                               (result (ptr Type))
                               (types (ptr (ArrayList Type)))
                               (args (ptr (ArrayList Expr)))]
  (-> (Result ExprKind Diag))
  (try
    (try! (vector-signature a op result types args false))
    (when (match op (VectorMaskBits [] true) (_ false))
      (let [n (t-arrn (elem types 0))]
        (break
          :try
            (Ok (ELlvmIr
                  :result (load result)
                  :args args
                  :body
                    (if (or (= arch 0) (= arch 1))
                        (text/format a
                                     "%packed = bitcast $t0 $0 to i{}{}"
                                     (i64->str a n)
                                     (if (= n 64)
                                         "\nret i64 %packed"
                                         (text/format a
                                                      "\n%wide = zext i{} %packed to i64\nret i64 %wide"
                                                      (i64->str a n))))
                        (vector-ballot-reduce-ir a n)))))))
    (if (and (= arch 1) (match op (VectorTable [] true) (_ false)))
        (if (<= (t-arrn (elem types 0)) 64)
            (Ok (ELlvmIr
                  :result (load result)
                  :args args
                  :body (vector-neon-table-ir a result types)))
            (lower-vector a op result types args))
        (lower-vector a op result types args))))

(defn vector-scan? [(op VectorOp)] (-> bool)
  (match op
    (VectorScanAdd [] true)
    (VectorScanXor [] true)
    (VectorScanOr [] true)
    (VectorScanMax [] true)
    (_ false)))

(defn vector-scan-operation [(op VectorOp)] (-> VectorOp)
  (match op
    (VectorScanAdd [] (VectorAdd))
    (VectorScanXor [] (VectorXor))
    (VectorScanOr [] (VectorOr))
    (_ (VectorMax))))

; Emit the fixed doubling tree here, before target legalization can turn a
; dynamic shuffle into a large scalar loop that LLVM declines to unroll.
(defn vector-scan-ir [(a (dyn Allocator)) (op VectorOp) (result (ptr Type))]
  (-> (slice u8))
  (let [n (t-arrn result)
        lane (t-inner result)
        ty (vector-ir-type a result)
        maximum (match op (VectorScanMax [] true) (_ false))
        instruction
          (vector-binary-instruction (vector-scan-operation op)
                                     (= (type-tag lane) 1))
        intrinsic
          (sconcat a
                   (vector-intrinsic-base (VectorMax)
                                          (= (type-tag lane) 1)
                                          (t-int-signed lane))
                   (vector-intrinsic-suffix a result))
        (mut out) (StrBuf::new a)
        (mut previous) "$0"
        (mut distance) 1]
    (when maximum
      (push-str! (mut out)
                 (text/format a "declare {} @{}(" ty intrinsic))
      (push-str! (mut out) (text/format a "{}, {})\n" ty ty)))
    (loop (if (>= (load distance) n)
              (break)
              (let [suffix (i64->str a (load distance))
                    shifted (text/format a "%shift{}" suffix)
                    combined (text/format a "%combine{}" suffix)
                    next (text/format a "%step{}" suffix)
                    indices (text/format a "<{} x i32> <" (i64->str a n))]
                (push-str! (mut out)
                           (text/format a
                                        "{} = shufflevector $ret {}"
                                        shifted
                                        (load previous)))
                (push-str! (mut out)
                           (text/format a ", $ret zeroinitializer, {}" indices))
                (for [i 0 n]
                  (when (> i 0) (push-str! (mut out) ", "))
                  (push-str! (mut out)
                             (text/format a
                                          "i32 {}"
                                          (i64->str a
                                                    (if (< i (load distance))
                                                        n
                                                        (- i (load distance)))))))
                (push-str! (mut out) ">\n")
                (push-str! (mut out) (text/format a "{} = " combined))
                (if maximum
                    (push-str! (mut out)
                               (text/format a
                                            "call $ret @{}($ret {}, $ret {})\n"
                                            intrinsic
                                            (load previous)
                                            shifted))
                    (push-str! (mut out)
                               (text/format a
                                            "{} $ret {}, {}\n"
                                            instruction
                                            (load previous)
                                            shifted)))
                ; Zero is an exact identity for integer add/XOR/OR. Other operations
                ; preserve inactive low lanes, including signed zero and NaN payloads.
                (if (or maximum (= (type-tag lane) 1))
                    (do
                      (push-str! (mut out)
                                 (text/format a
                                              "{} = shufflevector $ret {}"
                                              next
                                              (load previous)))
                      (push-str! (mut out)
                                 (text/format a
                                              ", $ret {}, {}"
                                              combined
                                              indices))
                      (for [i 0 n]
                        (when (> i 0) (push-str! (mut out) ", "))
                        (push-str! (mut out)
                                   (text/format a
                                                "i32 {}"
                                                (i64->str a
                                                          (if (< i
                                                                 (load distance))
                                                              i
                                                              (+ n i))))))
                      (push-str! (mut out) ">\n")
                      (set! previous next))
                    (set! previous combined))
                (set! distance (* (load distance) 2)))))
    (push-str! (mut out) (text/format a "ret $ret {}" (load previous)))
    (str (load out))))

(defn lower-vector [(a (dyn Allocator))
                    (op VectorOp)
                    (result (ptr Type))
                    (types (ptr (ArrayList Type)))
                    (args (ptr (ArrayList Expr)))]
  (-> (Result ExprKind Diag))
  (try
    (try! (vector-signature a op result types args false))
    (when (vector-scan? op)
      (break
        :try
          (Ok (ELlvmIr
                :result (load result)
                :args args
                :body (vector-scan-ir a op result)))))
    (when (vector-memory? op)
      (break
        :try
          (Ok (ELlvmIr
                :result (load result)
                :args args
                :body (vector-memory-ir a op result types)))))
    (let [body
            (match op
              (VectorBitcast []
                             (vector-conversion-ir a op result (elem types 0)))
              (VectorWidenLow [] (vector-resize-ir a op result types))
              (VectorWidenHigh [] (vector-resize-ir a op result types))
              (VectorNarrow [] (vector-resize-ir a op result types))
              (VectorNarrowSat [] (vector-resize-ir a op result types))
              (VectorCompress []
                              (vector-intrinsic-ir a
                                                   (text/format a
                                                                "llvm.experimental.vector.compress.{}"
                                                                (vector-intrinsic-suffix a
                                                                                         result))
                                                   result
                                                   types
                                                   false))
              (VectorConvert []
                             (vector-conversion-ir a op result (elem types 0)))
              (VectorShuffle [] (vector-permute-ir a op result types))
              (VectorTable [] (vector-permute-ir a op result types))
              (VectorIota []
                          (text/format a
                                       "ret $ret {}"
                                       (vector-iota-ir a
                                                       (t-arrn result)
                                                       (vector-ir-type a
                                                                       (t-inner result)))))
              (VectorMaskLow []
                             (let [it
                                     (text/format a
                                                  "<{} x i64>"
                                                  (i64->str a (t-arrn result)))
                                   mt
                                     (text/format a
                                                  "<{} x i32>"
                                                  (i64->str a (t-arrn result)))]
                               (text/format a
                                            "%one = insertelement {} zeroinitializer, i64 $0, i32 0\n%count = shufflevector {} %one, {} zeroinitializer, {} zeroinitializer\n%r = icmp sgt {} %count, {}\nret $ret %r"
                                            it
                                            it
                                            it
                                            mt
                                            it
                                            (vector-iota-ir a
                                                            (t-arrn result)
                                                            "i64"))))
              (VectorLoad [] "%r = load $ret, ptr $0, align 1\nret $ret %r")
              (VectorStore [] "store $t1 $1, ptr $0, align 1\nret i64 0")
              (VectorMaskBits [] (vector-ballot-ir a (t-arrn (elem types 0))))
              (VectorBitsMask [] (vector-from-bits-ir a (t-arrn result)))
              (VectorZero [] "ret $ret zeroinitializer")
              (VectorSplat []
                           (text/format a
                                        "%v = insertelement $ret zeroinitializer, $t0 $0, i32 0\n%r = shufflevector $ret %v, $ret zeroinitializer, <{} x i32> zeroinitializer\nret $ret %r"
                                        (i64->str a (t-arrn result))))
              (VectorLanes []
                           (let [(mut body) (ArrayList::new [Expr] a)]
                             (for [i 0 (len (load args))]
                               (push! (mut body) (get (load args) i)))
                             (push! (mut body)
                                    (mk-expr (EInt (t-arrn (elem types 0)))
                                             -1
                                             -1
                                             -1
                                             -1))
                             (break
                               :try (Ok (EDo (box-al [Expr] a (load body)))))))
              (VectorSelect []
                            "%r = select $t0 $0, $t1 $1, $t2 $2\nret $ret %r")
              (VectorExtract [] (vector-lane-access-ir a op types))
              (VectorInsert [] (vector-lane-access-ir a op types))
              (_ (try! (vector-arithmetic-ir a op result types))))]
      (Ok (ELlvmIr
            :result (load result)
            :args args
            :body body)))))
