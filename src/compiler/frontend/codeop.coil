; src/compiler/frontend/codeop.coil — self-host Coil compiler: the compile-time
; code operations, and everything the compiler knows about each one.
;
; A call of a `coil.primitive` code operation parses to `(ECodeOp OP ARGS)`. The
; parser, the checker, metalower and the comptime host each need facts about OP:
; its name, how many arguments it takes, which of them must be Code, what it
; returns, whether a precompiled syntax reader may call it. They all read them from
; `codeop-spec`, one exhaustive match, so an operation added to a family sum does
; not build until it has a spec, and the comptime host does not build until it
; answers it.
;
; The WIRE number is the one fact that leaves the compiler: a compiled metaprogram
; calls back into the host with it (metahost.coil), and prebuilt compile-time units
; embed it. `codeop-of-wire` is its only reader. Never renumber an operation.

(module coil.compiler.codeop)

;;; Taking one Code node apart.
(defsum ReadOp
  (CodeListP)  ; code-list?
  (CodeSymP)  ; code-sym?
  (CodeIntP)  ; code-int?
  (CodeKeywordP)  ; code-keyword?
  (CodeVectorP)  ; code-vector?
  (CodeFloatP)  ; code-float?
  (CodeStringP)  ; code-string?
  (CodeCount)  ; code-count
  (CodeNth)  ; code-nth
  (CodeSym)  ; code-sym
  (CodeInt)  ; code-int
  (CodeFloatBits)  ; code-float-bits
  (CodeKeywordName)  ; code-keyword-name
  (CodeRest)  ; code-rest
  (CodeEq))  ; code-eq

;;; Making Code.
(defsum MakeOp
  (Gensym)  ; gensym
  (CodeSymbol)  ; code-symbol
  (CodeStr)  ; code-str
  (CodeListNew)  ; code-list-new
  (CodeListPush)  ; code-list-push!
  (CodeListDone)  ; code-list-done
  (CodeListLike)  ; code-list-like
  (CodeSlice)  ; code-slice
  (CodeCopy)  ; code-copy
  (CodeConcat)  ; code-concat
  (CodeRead)  ; code-read
  (CodeOpaque)  ; code-opaque
  (CodeFromOpaque))  ; code-from-opaque

;;; Strings, bytes, and Code as text.
(defsum ConvertOp
  (StrBytes)  ; str-bytes
  (BytesToStr)  ; bytes->str
  (IntToStr)  ; int->str
  (CodeSource))  ; code-source

;;; Identifiers and their scopes.
(defsum HygieneOp
  (FreshIdentifier)  ; fresh-identifier
  (DatumToSyntax)  ; datum->syntax
  (SyntaxToDatum)  ; syntax->datum
  (FreeIdentifierEq)  ; free-identifier=?
  (BoundIdentifierEq))  ; bound-identifier=?

;;; A struct's fields.
(defsum FieldOp
  (FieldCount)  ; code-field-count
  (FieldName)  ; code-field-name
  (FieldKind)  ; code-field-kind
  (FieldType)  ; code-field-type
  (FieldQType))  ; code-field-qtype

;;; A sum's variants.
(defsum VariantOp
  (VariantSum)  ; code-variant-sum
  (VariantCount)  ; code-variant-count
  (VariantName)  ; code-variant-name
  (VariantFields)  ; code-variant-fields
  (VariantFieldName)  ; code-variant-field-name
  (VariantFieldType)  ; code-variant-field-type
  (VariantQName))  ; code-variant-qname

;;; A trait's methods.
(defsum TraitOp
  (TraitMethodCount)  ; code-trait-method-count
  (TraitMethodName)  ; code-trait-method-name
  (TraitArity)  ; code-trait-arity
  (TraitParamName)  ; code-trait-param-name
  (TraitParamType)  ; code-trait-param-type
  (TraitRetType))  ; code-trait-ret-type

;;; Types and constructors as written, and what is known about them.
(defsum TypeOp
  (TypeShapeOf)  ; code-type-shape
  (TypeTraits)  ; code-type-traits
  (Deriver)  ; code-deriver
  (VariantRefOf)  ; code-variant-ref
  (TypeRefOf)  ; code-type-ref
  (Exported))  ; code-exported?

;;; What the checker concluded about a node.
(defsum SemanticOp
  (Decl)  ; code-decl
  (TypeOf)  ; type-of
  (BindingOf)  ; binding-of
  (ResolveAt)  ; resolve-at
  (MacroOf)  ; code-macro-of
  (AliasOf)  ; code-alias-of
  (CheckError)  ; check-error
  (ModelStatusOf))  ; model-status

;;; Describing the program to another unit (program_query.coil); each answer reads the
;;; program model.
(defsum ProgramOp
  (ProgramModules)  ; program-modules
  (ModuleDefinitions)  ; module-definitions
  (DefinitionKindOf)  ; definition-kind
  (DefinitionDeclaration)  ; definition-declaration
  (ModuleHeader)  ; module-header
  (ModuleImpls)  ; module-impls
  (DefinitionAnnotations)  ; definition-annotations
  (DefinitionSource)  ; definition-source
  (DefinitionsOfKind))  ; definitions-of-kind

;;; The authored source, and edits to it.
(defsum SourceOp
  (SourceModules)  ; code-source-modules
  (SourceReferences)  ; code-source-references
  (SourceBindingOf)  ; code-source-binding
  (SourceImports)  ; code-source-imports
  (QualifyImport)  ; code-qualify-import
  (SuggestEdits))  ; code-suggest-edits

;;; Program facts indexed from the source view (docs/design/PROGRAM_FACTS.md).
(defsum FactsOp
  (ModuleReferences)  ; code-module-references
  (ImportReferences)  ; code-import-references
  (ReferencesTo)  ; code-references-to
  (ModuleBinders)  ; code-module-binders
  (ModuleImports)  ; code-module-imports
  (ReferenceForm)  ; code-reference-form
  (DefinitionForm)  ; code-definition-form
  (ResolvedUses)  ; code-resolved-uses
  (FieldUses)  ; code-field-uses
  (CastStructs)  ; code-cast-structs
  (CodePath)  ; code-path
  (ModuleForms))  ; code-module-forms

;;; Diagnostics and the fixes they propose.
(defsum ReportOp
  (Fail)  ; error
  (Report)  ; report
  (Warn)  ; warn
  (Suggest)  ; suggest
  (Delete)  ; delete
  (LintParamOf)  ; lint-param
  (SuggestTransaction))  ; suggest-transaction

;;; Where a node came from.
(defsum LocationOp
  (CodeFile)  ; code-file
  (CodeLine)  ; code-line
  (CodeSrc)  ; code-src
  (CodeCol)  ; code-col
  (CodeDoc)  ; code-doc
  (FromUser)  ; code-from-user?
  (IsMacro)  ; code-macro?
  (IsMacroCall)  ; code-macro-call?
  (CallSite))  ; code-call-site

;;; A retained compiler session's state (docs/design/RETAINED_SESSIONS).
(defsum SessionOp
  (SessionState)  ; code-session-state
  (SessionStage)  ; code-session-stage!
  (SessionMonomorphs)  ; code-session-monomorphs
  (SessionCondition)  ; code-session-condition!
  (SessionRejectedState)  ; code-session-rejected-state
  (SessionStagedState)  ; code-session-staged-state
  (SessionActive)  ; code-session-active?
  (SessionSubmission))  ; code-session-submission

;;; The target, build mode and toolchain being compiled with.
(defsum BuildModeOp
  (TargetArch)  ; target-arch
  (TargetOs)  ; target-os
  (DebugChecks)  ; debug-checks?
  (ProgramToolchain))  ; program-toolchain

;;; A compile-time code operation, by family.
(defsum CodeOp
  (ReadOps [(op ReadOp)])
  (MakeOps [(op MakeOp)])
  (ConvertOps [(op ConvertOp)])
  (HygieneOps [(op HygieneOp)])
  (FieldOps [(op FieldOp)])
  (VariantOps [(op VariantOp)])
  (TraitOps [(op TraitOp)])
  (TypeOps [(op TypeOp)])
  (SemanticOps [(op SemanticOp)])
  (ProgramOps [(op ProgramOp)])
  (SourceOps [(op SourceOp)])
  (FactsOps [(op FactsOp)])
  (ReportOps [(op ReportOp)])
  (LocationOps [(op LocationOp)])
  (SessionOps [(op SessionOp)])
  (BuildModeOps [(op BuildModeOp)]))

;;; How many arguments the parser accepts. An operation without a usage of its own
;;; takes whatever its primitive declares, and the checker holds it to that.
(defsum Arity
  (AnyArgs)
  (Exactly [(n i64) (usage (slice u8))]))  ; "NAME: expects USAGE" otherwise

;;; What an operation returns when its primitive declares no answer sum.
(defsum CodeOpResult (ReturnsCode) (ReturnsInt) (ReturnsStr) (ReturnsBool) (ReturnsNever) (ReturnsBuilder))

;;; Whether an operation's result can depend on how its Code arguments are spelled.
;;; Source facts record a spelling as observed when an operation that may read it
;;; runs; only structural transport, predicates and location queries are transparent.
;;; code-src is transparent because it shows the user what they wrote, so after an
;;; edit it shows the edited text, as an assertion's failure message should.
(defsum Spelling (Transparent) (Observes))

(defstruct CodeOpSpec
  [(name (slice u8))       ; the primitive's lowering keyword
   (wire i64)              ; the number compiled metaprograms call back with
   (arity Arity)
   (code-args i64)         ; how many leading arguments must be finished Code
   (result CodeOpResult)
   (spelling Spelling)
   ; whether a precompiled syntax reader may call it: an explicit opt-in, so an
   ; operation that reads the semantic program is never answered from an empty one
   (reader-safe bool)])

(defn op-spec [(name (slice u8)) (wire i64) (arity Arity) (code-args i64) (result CodeOpResult)
               (spelling Spelling) (reader-safe bool)] (-> CodeOpSpec)
  (CodeOpSpec :name name :wire wire :arity arity :code-args code-args :result result
              :spelling spelling :reader-safe reader-safe))

(defn read-op-spec [(op ReadOp)] (-> CodeOpSpec)
  (match op
    (CodeListP [] (op-spec "code-list?" 0 (AnyArgs) 1 (ReturnsBool) (Transparent) true))
    (CodeSymP [] (op-spec "code-sym?" 1 (AnyArgs) 1 (ReturnsBool) (Transparent) true))
    (CodeIntP [] (op-spec "code-int?" 2 (AnyArgs) 1 (ReturnsBool) (Transparent) true))
    (CodeKeywordP [] (op-spec "code-keyword?" 11 (AnyArgs) 1 (ReturnsBool) (Transparent) true))
    (CodeVectorP [] (op-spec "code-vector?" 54 (AnyArgs) 1 (ReturnsBool) (Transparent) true))
    (CodeFloatP [] (op-spec "code-float?" 55 (AnyArgs) 1 (ReturnsBool) (Transparent) true))
    (CodeStringP [] (op-spec "code-string?" 73 (AnyArgs) 1 (ReturnsBool) (Transparent) true))
    (CodeCount [] (op-spec "code-count" 3 (AnyArgs) 1 (ReturnsInt) (Transparent) true))
    (CodeNth [] (op-spec "code-nth" 4 (AnyArgs) 1 (ReturnsCode) (Transparent) true))
    (CodeSym [] (op-spec "code-sym" 5 (AnyArgs) 1 (ReturnsStr) (Observes) true))
    (CodeInt [] (op-spec "code-int" 6 (AnyArgs) 1 (ReturnsInt) (Transparent) true))
    (CodeFloatBits [] (op-spec "code-float-bits" 56 (AnyArgs) 1 (ReturnsInt) (Transparent) true))
    (CodeKeywordName [] (op-spec "code-keyword-name" 81 (AnyArgs) 1 (ReturnsStr) (Observes) true))
    (CodeRest [] (op-spec "code-rest" 7 (AnyArgs) 1 (ReturnsCode) (Transparent) true))
    (CodeEq [] (op-spec "code-eq" 10 (AnyArgs) 2 (ReturnsBool) (Observes) true))))

(defn make-op-spec [(op MakeOp)] (-> CodeOpSpec)
  (match op
    (Gensym [] (op-spec "gensym" 8 (Exactly 0 "(primitive/gensym)") 0 (ReturnsCode) (Observes) true))
    (CodeSymbol [] (op-spec "code-symbol" 12 (AnyArgs) 0 (ReturnsCode) (Observes) true))
    (CodeStr [] (op-spec "code-str" 13 (AnyArgs) 0 (ReturnsStr) (Observes) true))
    (CodeListNew [] (op-spec "code-list-new" 60 (AnyArgs) 0 (ReturnsBuilder) (Transparent) true))
    (CodeListPush [] (op-spec "code-list-push!" 61 (AnyArgs) 0 (ReturnsBuilder) (Transparent) true))
    (CodeListDone [] (op-spec "code-list-done" 62 (AnyArgs) 0 (ReturnsCode) (Transparent) true))
    (CodeListLike [] (op-spec "code-list-like" 74 (AnyArgs) 0 (ReturnsCode) (Transparent) true))
    (CodeSlice [] (op-spec "code-slice" 63 (AnyArgs) 0 (ReturnsCode) (Transparent) true))
    (CodeCopy [] (op-spec "code-copy" 64 (AnyArgs) 0 (ReturnsCode) (Transparent) true))
    (CodeConcat [] (op-spec "code-concat" 65 (AnyArgs) 0 (ReturnsCode) (Transparent) true))
    (CodeRead [] (op-spec "code-read" 59 (AnyArgs) 0 (ReturnsCode) (Observes) true))
    (CodeOpaque [] (op-spec "code-opaque" 71 (AnyArgs) 0 (ReturnsInt) (Observes) true))
    (CodeFromOpaque [] (op-spec "code-from-opaque" 72 (AnyArgs) 0 (ReturnsCode) (Observes) true))))

(defn convert-op-spec [(op ConvertOp)] (-> CodeOpSpec)
  (match op
    (StrBytes [] (op-spec "str-bytes" 28 (AnyArgs) 0 (ReturnsCode) (Observes) true))
    (BytesToStr [] (op-spec "bytes->str" 29 (AnyArgs) 0 (ReturnsCode) (Observes) true))
    (IntToStr [] (op-spec "int->str" 38 (AnyArgs) 0 (ReturnsStr) (Observes) true))
    (CodeSource [] (op-spec "code-source" 96 (AnyArgs) 0 (ReturnsStr) (Observes) false))))

(defn hygiene-op-spec [(op HygieneOp)] (-> CodeOpSpec)
  (match op
    (FreshIdentifier [] (op-spec "fresh-identifier" 66 (AnyArgs) 0 (ReturnsCode) (Observes) true))
    (DatumToSyntax [] (op-spec "datum->syntax" 67 (AnyArgs) 0 (ReturnsCode) (Observes) true))
    (SyntaxToDatum [] (op-spec "syntax->datum" 68 (AnyArgs) 0 (ReturnsCode) (Observes) true))
    (FreeIdentifierEq [] (op-spec "free-identifier=?" 69 (AnyArgs) 0 (ReturnsBool) (Observes) true))
    (BoundIdentifierEq [] (op-spec "bound-identifier=?" 70 (AnyArgs) 0 (ReturnsBool) (Observes) true))))

(defn field-op-spec [(op FieldOp)] (-> CodeOpSpec)
  (match op
    (FieldCount [] (op-spec "code-field-count" 14 (AnyArgs) 0 (ReturnsInt) (Observes) false))
    (FieldName [] (op-spec "code-field-name" 15 (AnyArgs) 0 (ReturnsCode) (Observes) false))
    (FieldKind [] (op-spec "code-field-kind" 16 (AnyArgs) 0 (ReturnsInt) (Observes) false))
    (FieldType [] (op-spec "code-field-type" 17 (AnyArgs) 0 (ReturnsCode) (Observes) false))
    (FieldQType [] (op-spec "code-field-qtype" 50 (AnyArgs) 0 (ReturnsCode) (Observes) false))))

(defn variant-op-spec [(op VariantOp)] (-> CodeOpSpec)
  (match op
    (VariantSum [] (op-spec "code-variant-sum" 18 (AnyArgs) 0 (ReturnsCode) (Observes) false))
    (VariantCount [] (op-spec "code-variant-count" 19 (AnyArgs) 0 (ReturnsInt) (Observes) false))
    (VariantName [] (op-spec "code-variant-name" 20 (AnyArgs) 0 (ReturnsCode) (Observes) false))
    (VariantFields [] (op-spec "code-variant-fields" 21 (AnyArgs) 0 (ReturnsInt) (Observes) false))
    (VariantFieldName [] (op-spec "code-variant-field-name" 47 (AnyArgs) 0 (ReturnsCode) (Observes) false))
    (VariantFieldType [] (op-spec "code-variant-field-type" 48 (AnyArgs) 0 (ReturnsCode) (Observes) false))
    (VariantQName [] (op-spec "code-variant-qname" 49 (AnyArgs) 0 (ReturnsCode) (Observes) false))))

(defn trait-op-spec [(op TraitOp)] (-> CodeOpSpec)
  (match op
    (TraitMethodCount [] (op-spec "code-trait-method-count" 22 (AnyArgs) 0 (ReturnsInt) (Observes) false))
    (TraitMethodName [] (op-spec "code-trait-method-name" 23 (AnyArgs) 0 (ReturnsCode) (Observes) false))
    (TraitArity [] (op-spec "code-trait-arity" 24 (AnyArgs) 0 (ReturnsInt) (Observes) false))
    (TraitParamName [] (op-spec "code-trait-param-name" 25 (AnyArgs) 0 (ReturnsCode) (Observes) false))
    (TraitParamType [] (op-spec "code-trait-param-type" 26 (AnyArgs) 0 (ReturnsCode) (Observes) false))
    (TraitRetType [] (op-spec "code-trait-ret-type" 27 (AnyArgs) 0 (ReturnsCode) (Observes) false))))

(defn type-op-spec [(op TypeOp)] (-> CodeOpSpec)
  (match op
    (TypeShapeOf [] (op-spec "code-type-shape" 75 (AnyArgs) 0 (ReturnsCode) (Observes) false))
    (TypeTraits [] (op-spec "code-type-traits" 86 (AnyArgs) 0 (ReturnsCode) (Observes) false))
    (Deriver [] (op-spec "code-deriver" 51 (AnyArgs) 0 (ReturnsCode) (Observes) false))
    (VariantRefOf [] (op-spec "code-variant-ref" 114 (AnyArgs) 0 (ReturnsCode) (Observes) false))
    (TypeRefOf [] (op-spec "code-type-ref" 115 (AnyArgs) 0 (ReturnsCode) (Observes) false))
    (Exported [] (op-spec "code-exported?" 57 (AnyArgs) 0 (ReturnsBool) (Observes) true))))

(defn semantic-op-spec [(op SemanticOp)] (-> CodeOpSpec)
  (match op
    (Decl [] (op-spec "code-decl" 35 (Exactly 1 "(primitive/code-decl NODE)") 0 (ReturnsCode) (Observes) false))
    (TypeOf [] (op-spec "type-of" 36 (Exactly 1 "(primitive/type-of NODE)") 0 (ReturnsCode) (Observes) false))
    (BindingOf [] (op-spec "binding-of" 37 (Exactly 1 "(primitive/binding-of NODE)") 0 (ReturnsInt) (Observes) false))
    (ResolveAt [] (op-spec "resolve-at" 91 (Exactly 2 "(primitive/resolve-at NODE NAME)") 0 (ReturnsCode) (Observes) false))
    (MacroOf [] (op-spec "code-macro-of" 94 (Exactly 1 "one Code node") 0 (ReturnsCode) (Observes) false))
    (AliasOf [] (op-spec "code-alias-of" 95 (Exactly 1 "one Code node") 0 (ReturnsCode) (Observes) false))
    (CheckError [] (op-spec "check-error" 83 (AnyArgs) 0 (ReturnsCode) (Observes) false))
    (ModelStatusOf [] (op-spec "model-status" 84 (AnyArgs) 0 (ReturnsCode) (Observes) false))))

(defn program-op-spec [(op ProgramOp)] (-> CodeOpSpec)
  (match op
    (ProgramModules [] (op-spec "program-modules" 98 (AnyArgs) 0 (ReturnsCode) (Observes) false))
    (ModuleDefinitions [] (op-spec "module-definitions" 99 (AnyArgs) 0 (ReturnsCode) (Observes) false))
    (DefinitionKindOf [] (op-spec "definition-kind" 100 (AnyArgs) 0 (ReturnsCode) (Observes) false))
    (DefinitionDeclaration [] (op-spec "definition-declaration" 101 (AnyArgs) 0 (ReturnsCode) (Observes) false))
    (ModuleHeader [] (op-spec "module-header" 102 (AnyArgs) 0 (ReturnsCode) (Observes) false))
    (ModuleImpls [] (op-spec "module-impls" 103 (AnyArgs) 0 (ReturnsCode) (Observes) false))
    (DefinitionAnnotations [] (op-spec "definition-annotations" 111 (AnyArgs) 0 (ReturnsCode) (Observes) false))
    (DefinitionSource [] (op-spec "definition-source" 112 (AnyArgs) 0 (ReturnsCode) (Observes) false))
    (DefinitionsOfKind [] (op-spec "definitions-of-kind" 129 (AnyArgs) 0 (ReturnsCode) (Observes) false))))

(defn source-op-spec [(op SourceOp)] (-> CodeOpSpec)
  (match op
    (SourceModules [] (op-spec "code-source-modules" 105 (AnyArgs) 0 (ReturnsCode) (Observes) false))
    (SourceReferences [] (op-spec "code-source-references" 106 (AnyArgs) 0 (ReturnsCode) (Observes) false))
    (SourceBindingOf [] (op-spec "code-source-binding" 107 (AnyArgs) 0 (ReturnsCode) (Observes) false))
    (SourceImports [] (op-spec "code-source-imports" 108 (AnyArgs) 0 (ReturnsCode) (Observes) false))
    (QualifyImport [] (op-spec "code-qualify-import" 109 (AnyArgs) 0 (ReturnsCode) (Observes) false))
    (SuggestEdits [] (op-spec "code-suggest-edits" 110 (AnyArgs) 0 (ReturnsCode) (Observes) false))))

(defn facts-op-spec [(op FactsOp)] (-> CodeOpSpec)
  (match op
    (ModuleReferences [] (op-spec "code-module-references" 117 (AnyArgs) 0 (ReturnsCode) (Observes) false))
    (ImportReferences [] (op-spec "code-import-references" 118 (AnyArgs) 0 (ReturnsCode) (Observes) false))
    (ReferencesTo [] (op-spec "code-references-to" 119 (AnyArgs) 0 (ReturnsCode) (Observes) false))
    (ModuleBinders [] (op-spec "code-module-binders" 120 (AnyArgs) 0 (ReturnsCode) (Observes) false))
    (ModuleImports [] (op-spec "code-module-imports" 121 (AnyArgs) 0 (ReturnsCode) (Observes) false))
    (ReferenceForm [] (op-spec "code-reference-form" 122 (AnyArgs) 0 (ReturnsCode) (Observes) false))
    (DefinitionForm [] (op-spec "code-definition-form" 123 (AnyArgs) 0 (ReturnsCode) (Observes) false))
    (ResolvedUses [] (op-spec "code-resolved-uses" 124 (AnyArgs) 0 (ReturnsCode) (Observes) false))
    (FieldUses [] (op-spec "code-field-uses" 125 (AnyArgs) 0 (ReturnsCode) (Observes) false))
    (CastStructs [] (op-spec "code-cast-structs" 126 (AnyArgs) 0 (ReturnsCode) (Observes) false))
    (CodePath [] (op-spec "code-path" 127 (AnyArgs) 0 (ReturnsCode) (Observes) false))
    (ModuleForms [] (op-spec "code-module-forms" 128 (AnyArgs) 0 (ReturnsCode) (Observes) false))))

(defn report-op-spec [(op ReportOp)] (-> CodeOpSpec)
  (match op
    (Fail [] (op-spec "error" 9 (Exactly 1 "(primitive/error MSG)") 0 (ReturnsNever) (Observes) true))
    (Report [] (op-spec "report" 31 (Exactly 2 "(primitive/report NODE MSG)") 0 (ReturnsCode) (Observes) true))
    (Warn [] (op-spec "warn" 32 (Exactly 2 "(primitive/warn NODE MSG)") 0 (ReturnsCode) (Observes) true))
    (Suggest [] (op-spec "suggest" 44 (Exactly 3 "(primitive/suggest NODE MSG REPLACEMENT)") 0 (ReturnsCode) (Observes) true))
    (Delete [] (op-spec "delete" 58 (Exactly 2 "(primitive/delete NODE MSG)") 0 (ReturnsCode) (Observes) true))
    (LintParamOf [] (op-spec "lint-param" 52 (Exactly 2 "(primitive/lint-param KEY DEFAULT)") 0 (ReturnsStr) (Observes) false))
    (SuggestTransaction [] (op-spec "suggest-transaction" 92 (Exactly 0 "(primitive/suggest-transaction)") 0 (ReturnsInt) (Observes) false))))

(defn location-op-spec [(op LocationOp)] (-> CodeOpSpec)
  (match op
    (CodeFile [] (op-spec "code-file" 33 (Exactly 1 "(primitive/code-file NODE)") 1 (ReturnsStr) (Transparent) true))
    (CodeLine [] (op-spec "code-line" 40 (Exactly 1 "(primitive/code-line NODE)") 1 (ReturnsInt) (Transparent) true))
    (CodeSrc [] (op-spec "code-src" 41 (Exactly 1 "(primitive/code-src NODE)") 1 (ReturnsStr) (Transparent) true))
    (CodeCol [] (op-spec "code-col" 42 (Exactly 1 "(primitive/code-col NODE)") 1 (ReturnsInt) (Transparent) true))
    (CodeDoc [] (op-spec "code-doc" 43 (Exactly 1 "(primitive/code-doc NODE)") 1 (ReturnsStr) (Observes) true))
    (FromUser [] (op-spec "code-from-user?" 34 (Exactly 1 "one Code node") 0 (ReturnsBool) (Observes) true))
    (IsMacro [] (op-spec "code-macro?" 45 (Exactly 1 "one Code node") 0 (ReturnsBool) (Observes) true))
    (IsMacroCall [] (op-spec "code-macro-call?" 53 (Exactly 1 "one Code node") 0 (ReturnsBool) (Observes) false))
    (CallSite [] (op-spec "code-call-site" 113 (AnyArgs) 0 (ReturnsCode) (Observes) false))))

(defn session-op-spec [(op SessionOp)] (-> CodeOpSpec)
  (match op
    (SessionState [] (op-spec "code-session-state" 76 (AnyArgs) 0 (ReturnsCode) (Observes) false))
    (SessionStage [] (op-spec "code-session-stage!" 77 (AnyArgs) 0 (ReturnsInt) (Observes) false))
    (SessionMonomorphs [] (op-spec "code-session-monomorphs" 78 (AnyArgs) 0 (ReturnsCode) (Observes) false))
    (SessionCondition [] (op-spec "code-session-condition!" 79 (AnyArgs) 0 (ReturnsCode) (Observes) false))
    (SessionRejectedState [] (op-spec "code-session-rejected-state" 80 (AnyArgs) 0 (ReturnsCode) (Observes) false))
    (SessionStagedState [] (op-spec "code-session-staged-state" 82 (AnyArgs) 0 (ReturnsCode) (Observes) false))
    (SessionActive [] (op-spec "code-session-active?" 85 (AnyArgs) 0 (ReturnsBool) (Observes) false))
    (SessionSubmission [] (op-spec "code-session-submission" 93 (AnyArgs) 0 (ReturnsInt) (Observes) false))))

(defn build-mode-op-spec [(op BuildModeOp)] (-> CodeOpSpec)
  (match op
    (TargetArch [] (op-spec "target-arch" 30 (Exactly 0 "(primitive/target-arch)") 0 (ReturnsCode) (Observes) true))
    (TargetOs [] (op-spec "target-os" 46 (Exactly 0 "(primitive/target-os)") 0 (ReturnsCode) (Observes) true))
    (DebugChecks [] (op-spec "debug-checks?" 39 (Exactly 0 "(primitive/debug-checks?)") 0 (ReturnsBool) (Observes) true))
    (ProgramToolchain [] (op-spec "program-toolchain" 104 (AnyArgs) 0 (ReturnsCode) (Observes) false))))

;;; Everything the compiler knows about OP.
(defn codeop-spec [(op CodeOp)] (-> CodeOpSpec)
  (match op
    (ReadOps [o] (read-op-spec o))
    (MakeOps [o] (make-op-spec o))
    (ConvertOps [o] (convert-op-spec o))
    (HygieneOps [o] (hygiene-op-spec o))
    (FieldOps [o] (field-op-spec o))
    (VariantOps [o] (variant-op-spec o))
    (TraitOps [o] (trait-op-spec o))
    (TypeOps [o] (type-op-spec o))
    (SemanticOps [o] (semantic-op-spec o))
    (ProgramOps [o] (program-op-spec o))
    (SourceOps [o] (source-op-spec o))
    (FactsOps [o] (facts-op-spec o))
    (ReportOps [o] (report-op-spec o))
    (LocationOps [o] (location-op-spec o))
    (SessionOps [o] (session-op-spec o))
    (BuildModeOps [o] (build-mode-op-spec o))))

(defn codeop-name [(op CodeOp)] (-> (slice u8))
  (.name (codeop-spec op)))

(defn codeop-wire [(op CodeOp)] (-> i64)
  (.wire (codeop-spec op)))

;;; One more than the largest wire number.
(const CODEOP-WIRE-LIMIT 130)

;;; The operation a compiled metaprogram means by wire number N; the list of every
;;; operation, for the tables built from it (codeop-named).
(defn codeop-of-wire [(n i64)] (-> (Option CodeOp))
  (cond
    (= n 0) (Some (ReadOps (CodeListP)))
    (= n 1) (Some (ReadOps (CodeSymP)))
    (= n 2) (Some (ReadOps (CodeIntP)))
    (= n 3) (Some (ReadOps (CodeCount)))
    (= n 4) (Some (ReadOps (CodeNth)))
    (= n 5) (Some (ReadOps (CodeSym)))
    (= n 6) (Some (ReadOps (CodeInt)))
    (= n 7) (Some (ReadOps (CodeRest)))
    (= n 8) (Some (MakeOps (Gensym)))
    (= n 9) (Some (ReportOps (Fail)))
    (= n 10) (Some (ReadOps (CodeEq)))
    (= n 11) (Some (ReadOps (CodeKeywordP)))
    (= n 12) (Some (MakeOps (CodeSymbol)))
    (= n 13) (Some (MakeOps (CodeStr)))
    (= n 14) (Some (FieldOps (FieldCount)))
    (= n 15) (Some (FieldOps (FieldName)))
    (= n 16) (Some (FieldOps (FieldKind)))
    (= n 17) (Some (FieldOps (FieldType)))
    (= n 18) (Some (VariantOps (VariantSum)))
    (= n 19) (Some (VariantOps (VariantCount)))
    (= n 20) (Some (VariantOps (VariantName)))
    (= n 21) (Some (VariantOps (VariantFields)))
    (= n 22) (Some (TraitOps (TraitMethodCount)))
    (= n 23) (Some (TraitOps (TraitMethodName)))
    (= n 24) (Some (TraitOps (TraitArity)))
    (= n 25) (Some (TraitOps (TraitParamName)))
    (= n 26) (Some (TraitOps (TraitParamType)))
    (= n 27) (Some (TraitOps (TraitRetType)))
    (= n 28) (Some (ConvertOps (StrBytes)))
    (= n 29) (Some (ConvertOps (BytesToStr)))
    (= n 30) (Some (BuildModeOps (TargetArch)))
    (= n 31) (Some (ReportOps (Report)))
    (= n 32) (Some (ReportOps (Warn)))
    (= n 33) (Some (LocationOps (CodeFile)))
    (= n 34) (Some (LocationOps (FromUser)))
    (= n 35) (Some (SemanticOps (Decl)))
    (= n 36) (Some (SemanticOps (TypeOf)))
    (= n 37) (Some (SemanticOps (BindingOf)))
    (= n 38) (Some (ConvertOps (IntToStr)))
    (= n 39) (Some (BuildModeOps (DebugChecks)))
    (= n 40) (Some (LocationOps (CodeLine)))
    (= n 41) (Some (LocationOps (CodeSrc)))
    (= n 42) (Some (LocationOps (CodeCol)))
    (= n 43) (Some (LocationOps (CodeDoc)))
    (= n 44) (Some (ReportOps (Suggest)))
    (= n 45) (Some (LocationOps (IsMacro)))
    (= n 46) (Some (BuildModeOps (TargetOs)))
    (= n 47) (Some (VariantOps (VariantFieldName)))
    (= n 48) (Some (VariantOps (VariantFieldType)))
    (= n 49) (Some (VariantOps (VariantQName)))
    (= n 50) (Some (FieldOps (FieldQType)))
    (= n 51) (Some (TypeOps (Deriver)))
    (= n 52) (Some (ReportOps (LintParamOf)))
    (= n 53) (Some (LocationOps (IsMacroCall)))
    (= n 54) (Some (ReadOps (CodeVectorP)))
    (= n 55) (Some (ReadOps (CodeFloatP)))
    (= n 56) (Some (ReadOps (CodeFloatBits)))
    (= n 57) (Some (TypeOps (Exported)))
    (= n 58) (Some (ReportOps (Delete)))
    (= n 59) (Some (MakeOps (CodeRead)))
    (= n 60) (Some (MakeOps (CodeListNew)))
    (= n 61) (Some (MakeOps (CodeListPush)))
    (= n 62) (Some (MakeOps (CodeListDone)))
    (= n 63) (Some (MakeOps (CodeSlice)))
    (= n 64) (Some (MakeOps (CodeCopy)))
    (= n 65) (Some (MakeOps (CodeConcat)))
    (= n 66) (Some (HygieneOps (FreshIdentifier)))
    (= n 67) (Some (HygieneOps (DatumToSyntax)))
    (= n 68) (Some (HygieneOps (SyntaxToDatum)))
    (= n 69) (Some (HygieneOps (FreeIdentifierEq)))
    (= n 70) (Some (HygieneOps (BoundIdentifierEq)))
    (= n 71) (Some (MakeOps (CodeOpaque)))
    (= n 72) (Some (MakeOps (CodeFromOpaque)))
    (= n 73) (Some (ReadOps (CodeStringP)))
    (= n 74) (Some (MakeOps (CodeListLike)))
    (= n 75) (Some (TypeOps (TypeShapeOf)))
    (= n 76) (Some (SessionOps (SessionState)))
    (= n 77) (Some (SessionOps (SessionStage)))
    (= n 78) (Some (SessionOps (SessionMonomorphs)))
    (= n 79) (Some (SessionOps (SessionCondition)))
    (= n 80) (Some (SessionOps (SessionRejectedState)))
    (= n 81) (Some (ReadOps (CodeKeywordName)))
    (= n 82) (Some (SessionOps (SessionStagedState)))
    (= n 83) (Some (SemanticOps (CheckError)))
    (= n 84) (Some (SemanticOps (ModelStatusOf)))
    (= n 85) (Some (SessionOps (SessionActive)))
    (= n 86) (Some (TypeOps (TypeTraits)))
    (= n 91) (Some (SemanticOps (ResolveAt)))
    (= n 92) (Some (ReportOps (SuggestTransaction)))
    (= n 93) (Some (SessionOps (SessionSubmission)))
    (= n 94) (Some (SemanticOps (MacroOf)))
    (= n 95) (Some (SemanticOps (AliasOf)))
    (= n 96) (Some (ConvertOps (CodeSource)))
    (= n 98) (Some (ProgramOps (ProgramModules)))
    (= n 99) (Some (ProgramOps (ModuleDefinitions)))
    (= n 100) (Some (ProgramOps (DefinitionKindOf)))
    (= n 101) (Some (ProgramOps (DefinitionDeclaration)))
    (= n 102) (Some (ProgramOps (ModuleHeader)))
    (= n 103) (Some (ProgramOps (ModuleImpls)))
    (= n 104) (Some (BuildModeOps (ProgramToolchain)))
    (= n 105) (Some (SourceOps (SourceModules)))
    (= n 106) (Some (SourceOps (SourceReferences)))
    (= n 107) (Some (SourceOps (SourceBindingOf)))
    (= n 108) (Some (SourceOps (SourceImports)))
    (= n 109) (Some (SourceOps (QualifyImport)))
    (= n 110) (Some (SourceOps (SuggestEdits)))
    (= n 111) (Some (ProgramOps (DefinitionAnnotations)))
    (= n 112) (Some (ProgramOps (DefinitionSource)))
    (= n 113) (Some (LocationOps (CallSite)))
    (= n 114) (Some (TypeOps (VariantRefOf)))
    (= n 115) (Some (TypeOps (TypeRefOf)))
    (= n 117) (Some (FactsOps (ModuleReferences)))
    (= n 118) (Some (FactsOps (ImportReferences)))
    (= n 119) (Some (FactsOps (ReferencesTo)))
    (= n 120) (Some (FactsOps (ModuleBinders)))
    (= n 121) (Some (FactsOps (ModuleImports)))
    (= n 122) (Some (FactsOps (ReferenceForm)))
    (= n 123) (Some (FactsOps (DefinitionForm)))
    (= n 124) (Some (FactsOps (ResolvedUses)))
    (= n 125) (Some (FactsOps (FieldUses)))
    (= n 126) (Some (FactsOps (CastStructs)))
    (= n 127) (Some (FactsOps (CodePath)))
    (= n 128) (Some (FactsOps (ModuleForms)))
    (= n 129) (Some (ProgramOps (DefinitionsOfKind)))
    :else (None [CodeOp])))
