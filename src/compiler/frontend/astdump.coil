; src/compiler/frontend/astdump.coil — self-host Coil compiler, astdump module.

(module coil.compiler.astdump)
(import "coil.compiler.code_ops" :as codeops)
(import "coil.compiler.vector_ops" :use *)
(import "coil.primitive" :as primitive)
(import "coil.alloc" :as alloc :use *)
(import "coil.result" :use *)
(import "coil.slice" :use *)
(import "coil.str" :use *)
(import "coil.arraylist" :use *)
(import "coil.io" :use *)
(import "coil.control" :use *)
(import "coil.try" :use *)
(import "coil.cc" :as cc)
(import "coil.compiler.ast" :use *)
(import "coil.compiler.unit_state" :use [unit-allocator])

; Structural dump syntax owns delimiters, field separators and expression spans.
; Field forms name a typed printer followed by its arguments; the writer is
; supplied once. Expansion emits direct calls, preserving the dump grammar and
; avoiding an indirect dispatch or temporary serialization tree at runtime.
(defn dump-fields [(writer Code) & (fields Code)] (-> Code)
  (let [out (primitive/code-list-new)]
    (for [i 0 (primitive/code-count fields)]
      (let [field (primitive/code-nth fields i)]
        (if (or (not (primitive/code-list? field))
                (primitive/code-vector? field)
                (= (primitive/code-count field) 0))
            (primitive/error "dump-fields: expected (PRINTER ARG ...)")
            0)
        (let [printer (primitive/code-nth field 0)
              args (primitive/code-rest field)]
          (primitive/code-list-push! out `(wb ~writer 32))
          (primitive/code-list-push! out `(~printer ~writer ~@args)))))
    `(do ~@(primitive/code-list-done out) 0)))

(defn dump-expression [(writer Code)
                       (expression Code)
                       (tag Code)
                       &
                       (fields Code)] (-> Code)
  `(do
     (ps ~writer ~tag)
     (dump-span ~writer
                (.source ~expression)
                (.lo ~expression)
                (.hi ~expression)
                (.ctxt ~expression))
     (dump-fields ~writer ~@fields)))

; Each row declares a variant pattern, its dump tag, and typed field printers.
; Exceptional grammars remain explicit under :custom, and the generated match
; remains exhaustive under the ordinary checker.
(defn d-expr-cases [(writer Code) (expression Code) & (cases Code)] (-> Code)
  (let [arms (primitive/code-list-new)]
    (for [i 0 (primitive/code-count cases)]
      (let [row (primitive/code-nth cases i)]
        (if (or (not (primitive/code-list? row))
                (primitive/code-vector? row)
                (< (primitive/code-count row) 3))
            (primitive/error "d-expr-cases: expected (VARIANT PATTERN TAG FIELD ...)")
            0)
        (let [variant (primitive/code-nth row 0)
              pattern (primitive/code-nth row 1)
              tag (primitive/code-nth row 2)
              fields
                (primitive/code-rest (primitive/code-rest (primitive/code-rest row)))
              body
                (if (= tag `:custom)
                    (do
                      (if (not (= (primitive/code-count fields) 1))
                          (primitive/error "d-expr-cases: :custom requires one body")
                          0)
                      (primitive/code-nth fields 0))
                    `(dump-expression ~writer ~expression ~tag ~@fields))]
          (primitive/code-list-push! arms `(~variant ~pattern ~body)))))
    `(match (.kind ~expression) ~@(primitive/code-list-done arms))))

(defn dump-node [(writer Code) (tag Code) & (fields Code)] (-> Code)
  `(do
     (wb ~writer 40)
     (ps ~writer ~tag)
     (dump-fields ~writer ~@fields)
     (wb ~writer 41)))

; Sequences share iteration and spacing while retaining their typed element
; printer. The mode chooses a value or an address into the original list; all
; address-based printers here only read the AST. Each input is evaluated once.
(defn dump-items [(writer Code)
                  (values Code)
                  (printer Code)
                  (mode Code)
                  (leading Code)] (-> Code)
  (if (not (or (= mode `:ref) (= mode `:value)))
      (primitive/error "dump-items: expected :ref or :value")
      0)
  (let [w (primitive/fresh-identifier "writer")
        xs (primitive/fresh-identifier "items")
        i (primitive/fresh-identifier "index")
        n (primitive/fresh-identifier "count")
        item (if (= mode `:ref) `(elem ~xs ~i) `(get (load ~xs) ~i))]
    `(let [~w ~writer
           ~xs ~values
           ~n (len (load ~xs))]
       (for [~i 0 ~n]
         (when (or ~leading (> ~i 0)) (wb ~w 32))
         (~printer ~w ~item))
       0)))

(defn d-list [(writer Code) (values Code) (printer Code) (mode Code)] (-> Code)
  `(do
     (wb ~writer 91)
     (dump-items ~writer ~values ~printer ~mode false)
     (wb ~writer 93)))

(defn d-section [(writer Code)
                 (tag Code)
                 (values Code)
                 (printer Code)
                 (mode Code)] (-> Code)
  `(do
     (ps ~writer "\n(")
     (ps ~writer ~tag)
     (dump-items ~writer ~values ~printer ~mode true)
     (wb ~writer 41)))

(defn d-trait-method [(w (ptr Writer)) (method (ptr TraitMethod))] (-> i64)
  (dump-node w
             "method"
             (dstr (.name method))
             (d-params (.params method))
             (d-type-value (.ret method))))

(defn d-annotation [(w (ptr Writer)) (annotation (ptr Annotation))] (-> i64)
  (dstr w (.key annotation))
  (wb w 32)
  (d-expr w (field annotation value)))

(defn d-bind [(w (ptr Writer)) (b (ptr Bind))] (-> i64)
  (dump-node w
             "bind"
             (dstr (.name b))
             (dbool (.mutable b))
             (d-expr (field b value))))

(defn d-arm [(w (ptr Writer)) (a (ptr Arm))] (-> i64)
  (dump-node w
             "arm"
             (dstr (.variant a))
             (d-strs (.binds a))
             (d-expr (field a body))))

(defn d-type-value [(w (ptr Writer)) (value Type)] (-> i64)
  (let [(mut value) value] (d-type w (mut value))))

(defn d-quasi-value [(w (ptr Writer)) (value Quasi)] (-> i64)
  (let [(mut value) value] (d-quasi w (mut value))))

(defn d-float [(w (ptr Writer)) (bits i64)] (-> i64)
  (ps w "0x")
  (u-hex16 w bits))

(defn d-strs [(w (ptr Writer)) (v (ptr (ArrayList (slice u8))))] (-> i64)
  (d-list w v dstr :value))

; `(some "x")` / `(none)` — an optional string.
(defn d-opt-str [(w (ptr Writer)) (v (Option (slice u8)))] (-> i64)
  (match v
    (Some [s]
          (dump-node w
                     "some"
                     (dstr s)))
    (None [] (ps w "(none)"))))

; ---- types ----
(defn d-types [(w (ptr Writer)) (v (ptr (ArrayList Type)))] (-> i64)
  (d-list w v d-type :ref))

(defn d-type [(w (ptr Writer)) (t (ptr Type))] (-> i64)
  (match (load t)
    (TInt [bits signed]
          (dump-node w
                     "int"
                     (dump-dec bits)
                     (dbool signed)))
    (TFloat [bits]
            (dump-node w
                       "float"
                       (dump-dec bits)))
    (TBool [] (ps w "bool"))
    (TVoid [] (ps w "void"))
    (TPtr [inner]
          (dump-node w
                     "ptr"
                     (d-type inner)))
    (TRef [m inner]
          (dump-node w
                     "ref"
                     (dbool m)
                     (d-type inner)))
    (TStruct [name]
             (dump-node w
                        "primitive/struct?"
                        (dstr name)))
    (TArray [elem n]
            (do
              (ps w "(array ")
              (d-type w elem)
              (wb w 32)
              (match n
                (FixedExtent [k] (do (dump-dec w k) 0))
                (ParamExtent [name] (do (ps w name) 0)))
              (wb w 41)))
    (TSlice [elem]
            (dump-node w
                       "slice"
                       (d-type elem)))
    (TVec [elem n]
          (do
            (ps w "(vec ")
            (d-type w elem)
            (wb w 32)
            (match n
              (FixedExtent [k] (do (dump-dec w k) 0))
              (ParamExtent [name] (do (ps w name) 0)))
            (wb w 41)))
    (TConst [v]
            (do
              (ps w "(const ")
              (match v
                (ConstInt [n] (dump-dec w n))
                (ConstBool [b] (ps w (if b "true" "false")))
                (ConstKeyword [name] (do (wb w 58) (ps w name)))
                (ConstRef [name] (ps w name)))
              (wb w 41)))
    (TFn [cc params ret]
         (dump-node w
                    "fn"
                    (dstr (cc-text (unit-allocator) cc))
                    (d-types params)
                    (d-type ret)))
    (TApp [name args]
          (dump-node w
                     "app"
                     (dstr name)
                     (d-types args)))
    (TNever [] (ps w "never"))
    (TError [] (ps w "error"))
    (TCode [] (ps w "code"))
    (TCodeBuilder [] (ps w "codebuilder"))
    (TExternRef [] (ps w "externref"))))

; ---- enum-tag dumpers (i64 code -> string) ----
(defn d-binop [(w (ptr Writer)) (op i64)] (-> i64)
  (ps w
      (cond (= op 0) "add"
            (= op 1) "sub"
            (= op 2) "mul"
            (= op 3) "div"
            (= op 4) "rem"
            (= op 5) "udiv"
            (= op 6) "urem"
            (= op 7) "and"
            (= op 8) "or"
            (= op 9) "xor"
            (= op 10) "shl"
            (= op 11) "shr"
            (= op 12) "rotl"
            (= op 13) "rotr"
            (= op 14) "mulhi"
            (= op 15) "add-overflow"
            (= op 16) "sub-overflow"
            :else "mul-overflow")))

(defn d-cmpop [(w (ptr Writer)) (op i64)] (-> i64)
  (ps w
      (cond (= op 0) "lt"
            (= op 1) "le"
            (= op 2) "gt"
            (= op 3) "ge"
            (= op 4) "eq"
            :else "ne")))

(defn d-storage [(w (ptr Writer)) (s i64)] (-> i64)
  (ps w
      (if (or (= s 0) (= s 3))
          "stack"
          (if (= s 1) "static" "heap"))))

(defn d-typequery [(w (ptr Writer)) (q i64)] (-> i64)
  (ps w
      (cond (= q 0) "fieldcount"
            (= q 1) "variantcount"
            (= q 2) "isstruct"
            (= q 3) "issum"
            (= q 4) "isint"
            (= q 5) "isfloat"
            (= q 6) "isptr"
            :else "isarray")))

(defn d-fieldmeta [(w (ptr Writer)) (m i64)] (-> i64)
  (ps w
      (if (= m 0)
          "name"
          (if (= m 1) "typekind" "typename"))))

(defn d-codeop [(w (ptr Writer)) (op i64)] (-> i64)
  (let [description (codeops/operation op)] (ps w (.dump description))))

; ---- exprs ----
(defn d-exprs [(w (ptr Writer)) (v (ptr (ArrayList Expr)))] (-> i64)
  (d-list w v d-expr :ref))

(defn d-opt-expr [(w (ptr Writer)) (v (Option (ptr Expr)))] (-> i64)
  (match v
    (Some [e]
          (dump-node w
                     "some"
                     (d-expr e)))
    (None [] (ps w "(none)"))))

(defn d-binds [(w (ptr Writer)) (v (ptr (ArrayList Bind)))] (-> i64)
  (d-list w v d-bind :ref))

(defn d-arms [(w (ptr Writer)) (v (ptr (ArrayList Arm)))] (-> i64)
  (d-list w v d-arm :ref))

(defn d-quasi [(w (ptr Writer)) (q (ptr Quasi))] (-> i64)
  (match (load q)
    (QLit [form]
          (dump-node w
                     "qlit"
                     (sx-node form)))
    (QUnquote [e]
              (dump-node w
                         "qunq"
                         (d-expr e)))
    (QSplice [e]
             (dump-node w
                        "qspl"
                        (d-expr e)))
    (QList [items]
           (do
             (ps w "(qlist")
             (dump-items w items d-quasi :ref true)
             (wb w 41)))
    (QVector [items]
             (do
               (ps w "(qvec")
               (dump-items w items d-quasi :ref true)
               (wb w 41)))))

;;; BYTES as a vector of integers.
(defn d-bytes [(w (ptr Writer)) (bytes (ptr (ArrayList u8)))] (-> i64)
  (wb w 91)
  (for i (range 0 (len (load bytes)))
    (when (> i 0) (wb w 32))
    (dump-dec w (primitive/cast i64 (get (load bytes) i))))
  (wb w 93)
  0)

(defn d-expr [(w (ptr Writer)) (e (ptr Expr))] (-> i64)
  (let [lo (.lo e)
        hi (.hi e)
        src (.source e)
        ctxt (.ctxt e)]
    (wb w 40)
    (d-expr-cases w
                  e
                  (EInt [v] "eint" (dump-dec v))
                  (EWideInt [_ _ _ _ text] "ewideint" (ps text))
                  (EFloat [bits] "efloat" (d-float bits))
                  (EBool [b] "ebool" (dbool b))
                  (EStr [s] "estr" (dstr s))
                  (ECStr [s] "ecstr" (dstr s))
                  (EVar [name] "var" (dstr name))
                  (EZeroed [ty] "zeroed" (d-type-value ty))
                  (ERecordInit [ty] "record-init" (d-type-value ty))
                  (EBorrow [m place] "borrow" (dbool m) (d-expr place))
                  (ELet [binds body] "let" (d-binds binds) (d-exprs body))
                  (EBin [op lhs rhs]
                        "bin"
                        (d-binop op)
                        (d-expr lhs)
                        (d-expr rhs))
                  (EIntUnary [op inner]
                             (cond (= op 0) "inot"
                                   (= op 1) "clz"
                                   (= op 2) "ctz"
                                   (= op 3) "popcount"
                                   :else "bswap")
                             (d-expr inner))
                  (ECmp [op lhs rhs]
                        "cmp"
                        (d-cmpop op)
                        (d-expr lhs)
                        (d-expr rhs))
                  (EIf [cnd thn els]
                       "if"
                       (d-expr cnd)
                       (d-expr thn)
                       (d-expr els))
                  (EDo [body] "do" (d-exprs body))
                  (ECall [func type_args args]
                         "call"
                         (dstr func)
                         (d-types type_args)
                         (d-exprs args))
                  (EBracketCall [func type_args args vector]
                                "bracket-call"
                                (dstr func)
                                (d-types type_args)
                                (d-exprs args)
                                (d-expr vector))
                  (ENamedCall [func type_args names args]
                              "named-call"
                              (dstr func)
                              (d-types type_args)
                              (d-strs names)
                              (d-exprs args))
                  (EAlloc [storage ty init symbol]
                          :custom
                          (do
                            (dump-expression w
                                             e
                                             "alloc"
                                             (d-storage storage)
                                             (d-type-value ty))
                            (match symbol
                              (Some [name] (ps w " :as ") (dstr w name))
                              (None [] 0))
                            (unless (= (primitive/cast i64 init) 0)
                              (wb w 32)
                              (d-expr w init))))
                  (EField [p fname] "field" (d-expr p) (dstr fname))
                  (EAccessorField [p fname]
                                  "accessor-field"
                                  (d-expr p)
                                  (dstr fname))
                  (ELoad [inner] "load" (d-expr inner))
                  (EStore [p val] "store" (d-expr p) (d-expr val))
                  (EInitStore [p val] "init-store" (d-expr p) (d-expr val))
                  (EIndex [p idx] "index" (d-expr p) (d-expr idx))
                  (ECast [ty inner] "cast" (d-type-value ty) (d-expr inner))
                  (ESizeOf [ty] "sizeof" (d-type-value ty))
                  (EAlignOf [ty] "alignof" (d-type-value ty))
                  (EOffsetOf [ty fname]
                             "offsetof"
                             (d-type-value ty)
                             (dstr fname))
                  (EBitGet [p fname] "bitget" (d-expr p) (dstr fname))
                  (EBitSet [p fname val]
                           "bitset"
                           (d-expr p)
                           (dstr fname)
                           (d-expr val))
                  (EFree [inner] "free" (d-expr inner))
                  (EErase [trait_name inner]
                          "erase"
                          (dstr trait_name)
                          (d-expr inner))
                  (EMatch [scrut arms] "match" (d-expr scrut) (d-arms arms))
                  (EFnPtrOf [name] "fnptrof" (dstr name))
                  (EFnPtrInst [name type_args]
                              "fnptrof"
                              (dstr name)
                              (d-types type_args))
                  (ECallPtr [fp args] "callptr" (d-expr fp) (d-exprs args))
                  (ELoop [label body] "loop" (d-opt-str label) (d-exprs body))
                  (EBreak [label value]
                          "break"
                          (d-opt-str label)
                          (d-opt-expr value))
                  (EContinue [label] "continue" (d-opt-str label))
                  (EAnonFn [params body] "fn" (d-strs params) (d-exprs body))
                  (EVector [op result types args]
                           (vector-op-name op)
                           (d-type-value result)
                           (d-types types)
                           (d-exprs args))
                  (ELlvmIr [result args body]
                           "llvmir"
                           (d-type-value result)
                           (d-exprs args)
                           (dstr body))
                  (EIntrinsic [op result args]
                              :custom
                              (do
                                (dump-expression w
                                                 e
                                                 "intrinsic"
                                                 (ps (match op
                                                       (IStackBytes []
                                                                    "alloc-stack-bytes")
                                                       (ILinkerAddress [_]
                                                                       "linker-address")
                                                       (IVolatileLoad []
                                                                      "volatile-load")
                                                       (IVolatileStore []
                                                                       "volatile-store!")
                                                       (IAliasLoad []
                                                                   "alias-load")
                                                       (IAliasStore []
                                                                    "alias-store!")
                                                       (IFence [] "fence!")
                                                       (IMachineCodeSource [_]
                                                                           "machine-code")
                                                       (IMachineCode [_ _]
                                                                     "machine-code"))))
                                (match op
                                  (ILinkerAddress [symbol]
                                                  (do (wb w 32) (dstr w symbol)))
                                  (IMachineCode [arch _]
                                                (do (wb w 32) (dstr w arch)))
                                  (_ 0))
                                (match op
                                  (IMachineCodeSource [bytes]
                                                      (do
                                                        (wb w 32)
                                                        (d-bytes w bytes)))
                                  (IMachineCode [_ bytes]
                                                (do (wb w 32) (d-bytes w bytes)))
                                  (_ 0))
                                (wb w 32)
                                (let [(mut t) result] (d-type w (mut t)))
                                (wb w 32)
                                (d-exprs w args)))
                  (EConstParam [name ty]
                               "const-param"
                               (dstr name)
                               (d-type-value ty))
                  (ETypeQuery [q ty]
                              "typequery"
                              (d-typequery q)
                              (d-type-value ty))
                  (EFieldMeta [meta ty idx]
                              "fieldmeta"
                              (d-fieldmeta meta)
                              (d-type-value ty)
                              (d-expr idx))
                  (EFieldIndex [ty name]
                               "fieldindex"
                               (d-type-value ty)
                               (d-expr name))
                  (EQuote [form] "quote" (sx-node form))
                  (ECodeOp [op args] "codeop" (d-codeop op) (d-exprs args))
                  (EQuasi [q] "quasi" (d-quasi-value q))
                  (EComptime [inner] "comptime" (d-expr inner))
                  (EAscribe [ty inner]
                            "ascribe"
                            (d-type-value ty)
                            (d-expr inner))
                  (EPattern [pattern-op ty inner pattern-index]
                            :custom
                            (do
                              (ps w "pattern")
                              (wb w 32)
                              (dump-dec w pattern-op)
                              (wb w 32)
                              (dump-dec w pattern-index)
                              (dump-span w src lo hi ctxt)
                              (wb w 32)
                              (let [(mut t) ty] (d-type w (mut t)))
                              (wb w 32)
                              (d-expr w inner)))
                  (EArrayLit [items] "array-lit" (d-exprs items))
                  (EStaticArray [indices items]
                                :custom
                                (do
                                  (dump-expression w e "static-elements")
                                  (ps w " [")
                                  (for [i 0 (len (load items))]
                                    (when (> i 0) (wb w 32) 0)
                                    (wb w 40)
                                    (print-int w (get (load indices) i))
                                    (wb w 32)
                                    (d-expr w (elem items i))
                                    (wb w 41)
                                    0)
                                  (wb w 93)))
                  ; ---- check-introduced variants ----
                  (ESpillRef [inner] "spillref" (d-expr inner))
                  (EMovePlace [place] "move-place" (d-expr place))
                  (EMakeSlice [data elem len]
                              :custom
                              (do
                                (dump-expression w
                                                 e
                                                 "make-slice"
                                                 (d-expr data)
                                                 (d-type-value elem))
                                (wb w 32)
                                (match len
                                  (FixedExtent [n] (do (print-int w n) 0))
                                  (ParamExtent [name] (do (ps w name) 0)))
                                0))
                  (EConstruct [sum variant args]
                              "construct"
                              (dstr sum)
                              (dstr variant)
                              (d-exprs args))
                  (ETraitCall [trait_name method self_tp args]
                              "traitcall"
                              (dstr trait_name)
                              (dstr method)
                              (dstr self_tp)
                              (d-exprs args))
                  (EDynDispatch [dc]
                                :custom
                                (let [dyn_struct (.dyn_struct dc)
                                      vtable_struct (.vtable_struct dc)
                                      method_index (.method_index dc)
                                      cc (.cc dc)
                                      params (.params dc)
                                      ret (.ret dc)
                                      recv (.recv dc)
                                      args (.args dc)]
                                  (dump-expression w
                                                   e
                                                   "dyndispatch"
                                                   (dstr dyn_struct)
                                                   (dstr vtable_struct)
                                                   (dump-dec method_index)
                                                   (dstr cc)
                                                   (d-types params)
                                                   (d-type-value ret)
                                                   (d-expr recv)
                                                   (d-exprs args))))
                  (EMakeDyn [dyn_struct vtable_struct methods inner]
                            "makedyn"
                            (dstr dyn_struct)
                            (dstr vtable_struct)
                            (d-strs methods)
                            (d-expr inner))
                  (ECleanup [body cleanups]
                            "cleanup"
                            (d-expr body)
                            (d-exprs cleanups))
                  (EDefer [cleanup body]
                          "defer"
                          (d-expr cleanup)
                          (d-exprs body))
                  (EStaticRef [name] "staticref" (dstr name)))
    (wb w 41)))

; ---- declarations ----
(defn d-param [(w (ptr Writer)) (p (ptr Param))] (-> i64)
  (ps w "(param ")
  (dstr w (.name p))
  (wb w 32)
  (let [(mut t) (: (.ty p) Type)] (d-type w (mut t)))
  (when (.positional_only p) (ps w " :positional"))
  (wb w 41))

(defn d-params [(w (ptr Writer)) (v (ptr (ArrayList Param)))] (-> i64)
  (d-list w v d-param :ref))

(defn d-field [(w (ptr Writer)) (f (ptr Field))] (-> i64)
  (dump-node w
             "fld"
             (dstr (.name f))
             (d-type-value (: (.ty f) Type))))

(defn d-fields [(w (ptr Writer)) (v (ptr (ArrayList Field)))] (-> i64)
  (d-list w v d-field :ref))

(defn d-i64s [(w (ptr Writer)) (v (ptr (ArrayList i64)))] (-> i64)
  (d-list w v dump-dec :value))

(defn d-bounds [(w (ptr Writer)) (v (ptr (ArrayList Bound)))] (-> i64)
  (wb w 91)
  (let [(mut i) 0
        n (len (load v))]
    (loop (if (>= (load i) n)
              (break)
              (do
                (when (> (load i) 0) (wb w 32))
                (let [b (primitive/alloc-stack Bound)]
                  (set! b (get (load v) (load i)))
                  (ps w "(bound ")
                  (dstr w (.name b))
                  (wb w 32)
                  (wb w 91)
                  (for [j 0 (len (load (field b traits)))]
                    (when (> j 0) (wb w 32))
                    (let [bt (elem (load (field b traits)) j)]
                      (wb w 40)
                      (dstr w (.name bt))
                      (for [k 0 (len (load (field bt args)))]
                        (wb w 32)
                        (d-type w (elem (load (field bt args)) k)))
                      (wb w 41)))
                  (wb w 93)
                  (match (.value_type b)
                    (Some [vt]
                          (let [(mut cell) vt]
                            (ps w " :value ")
                            (d-type w (mut cell))
                            0))
                    (None [] 0))
                  (wb w 41))
                (set! i (primitive/iadd (load i) 1))))))
  (wb w 93))

(defn d-func [(w (ptr Writer)) (f (ptr Func))] (-> i64)
  (ps w "(func ")
  (dstr w (.name f))
  (wb w 32)
  (d-strs w (load (field f type_params)))
  (wb w 32)
  (d-bounds w (load (field f bounds)))
  (wb w 32)
  (dstr w (cc-text (unit-allocator) (.cc f)))
  (wb w 32)
  (d-annotations w (load (field f annotations)))
  (wb w 32)
  (d-params w (load (field f params)))
  (wb w 32)
  (let [(mut t) (: (.ret f) Type)] (d-type w (mut t)))
  (wb w 32)
  (d-exprs w (load (field f body)))
  (wb w 32)
  (dbool w (.macro_variadic f))
  (wb w 32)
  (dump-span w
             (.source f)
             (.lo f)
             (.hi f)
             (.ctxt f))
  ; Only a declaration prints the marker, so every ordinary function dumps
  ; exactly as before.
  (when (.declared f) (ps w " declared") 0)
  (wb w 41))

(defn d-convention [(w (ptr Writer)) (c (ptr Convention))] (-> i64)
  (ps w "(cc ")
  (dstr w (.name c))
  (wb w 32)
  (d-strs w (load (field c params)))
  (wb w 32)
  (d-opt-str w (.ret c))
  (wb w 32)
  (d-strs w (load (field c clobber)))
  (wb w 32)
  (d-strs w (load (field c preserve)))
  (wb w 32)
  (match (.lowering c)
    (LNative [cc]
             (dump-node w
                        "native"
                        (ps (match cc
                              (cc/C [] "c")
                              (cc/Fast [] "fast")
                              (cc/Cold [] "cold")
                              (cc/Tail [] "tail")
                              (cc/SwiftTail [] "swifttail")))))
    (LShim [] (ps w "(shim)"))
    (LReset [] (ps w "(reset)"))
    (LowerWritten [value]
                  (dump-node w
                             "written"
                             (d-expr value))))
  (wb w 41))

(defn d-layout [(w (ptr Writer)) (l (ptr Layout))] (-> i64)
  (match (load l)
    (LayoutWritten [value _]
                   (dump-node w
                              "written"
                              (d-expr value)))
    (LC [] (ps w "(c)"))
    (LPacked [] (ps w "(packed)"))
    (LAligned [n]
              (dump-node w
                         "aligned"
                         (dump-dec n)))
    (LExplicit [offsets size align]
               (do
                 (ps w "(explicit ")
                 (d-i64s w offsets)
                 (wb w 32)
                 (match size
                   (Some [n]
                         (dump-node w
                                    "some"
                                    (dump-dec n)))
                   (None [] (ps w "(none)")))
                 (wb w 32)
                 (dump-dec w align)
                 (wb w 41)))
    (LBits [backing offsets]
           (dump-node w
                      "bits"
                      (dump-dec backing)
                      (d-i64s offsets)))))

(defn d-struct [(w (ptr Writer)) (s (ptr StructDef))] (-> i64)
  (ps w "(primitive/struct? ")
  (dstr w (.name s))
  (when (annotations-submission-only? (.annotations s))
    (ps w " :jit/retain false")
    0)
  (wb w 32)
  (d-strs w (load (field s type_params)))
  (wb w 32)
  (let [lp (primitive/alloc-stack Layout)]
    (set! lp (.layout s))
    (d-layout w lp))
  (wb w 32)
  (d-fields w (load (field s fields)))
  (wb w 41))

(defn d-variant [(w (ptr Writer)) (vr (ptr Variant))] (-> i64)
  (dump-node w
             "variant"
             (dstr (.name vr))
             (d-fields (load (field vr fields)))))

(defn d-sum [(w (ptr Writer)) (s (ptr SumDef))] (-> i64)
  (ps w "(sum ")
  (dstr w (.name s))
  (when (annotations-submission-only? (.annotations s))
    (ps w " :jit/retain false")
    0)
  (wb w 32)
  (d-strs w (load (field s type_params)))
  (wb w 32)
  (d-list w (.variants s) d-variant :ref)
  (wb w 41))

(defn d-extern [(w (ptr Writer)) (e (ptr Extern))] (-> i64)
  (ps w "(extern ")
  (dstr w (.name e))
  (match (.symbol e)
    (Some [symbol] (do (ps w " :as ") (dstr w symbol)))
    (None [] 0))
  (wb w 32)
  (dstr w (cc-text (unit-allocator) (.cc e)))
  (wb w 32)
  (d-types w (load (field e params)))
  (wb w 32)
  (dbool w (.variadic e))
  (wb w 32)
  (let [(mut t) (: (.ret e) Type)] (d-type w (mut t)))
  (wb w 41))

(defn d-assert [(w (ptr Writer)) (a (ptr StaticAssert))] (-> i64)
  (ps w "(assert ")
  (let [ce (primitive/alloc-stack Expr)] (set! ce (.cnd a)) (d-expr w ce))
  (wb w 32)
  (dstr w (.msg a))
  (wb w 41))

(defn d-annotations [(w (ptr Writer)) (anns (ptr (ArrayList Annotation)))]
  (-> i64)
  (ps w "(annotations")
  (dump-items w anns d-annotation :ref true)
  (wb w 41))

(defn d-const [(w (ptr Writer)) (c (ptr Const))] (-> i64)
  (ps w (if (.runtime c) "(def " "(const "))
  (dstr w (.name c))
  (wb w 32)
  (when (> (len (load (.annotations c))) 0)
    (d-annotations w (.annotations c))
    (wb w 32)
    0)
  (match (.ty c)
    (Some [t]
          (dump-node w
                     "some"
                     (d-type-value t)))
    (None [] (ps w "(none)")))
  (wb w 32)
  (let [ve (primitive/alloc-stack Expr)] (set! ve (.value c)) (d-expr w ve))
  (wb w 41))

(defn d-trait [(w (ptr Writer)) (t (ptr TraitDef))] (-> i64)
  (ps w "(trait ")
  (dstr w (.name t))
  (wb w 32)
  (dstr w (.self_param t))
  (wb w 32)
  (d-list w (.methods t) d-trait-method :ref)
  (wb w 41))

(defn d-impl [(w (ptr Writer)) (im (ptr ImplDef))] (-> i64)
  (if (impl-is-inherent im)
      (ps w "(inherent ")
      (do
        (ps w "(impl ")
        (dstr w (impl-trait-name im))
        (wb w 32)))
  (dstr w (.for_type im))
  (wb w 32)
  (d-list w (.methods im) d-func :ref)
  (wb w 41))

(defn d-export [(w (ptr Writer)) (e (ptr ExportC))] (-> i64)
  (dump-node w
             "export"
             (dstr (.name e))
             (d-opt-str (.symbol e))
             (d-types (load (field e params)))
             (dump-span (.source e) (.lo e) (.hi e) (.ctxt e))))

; Byte-lexicographic `<` on strings (ASCII conv names):
; a proper prefix is less than the longer string.
(defn str-lt [(x (slice u8)) (y (slice u8))] (-> bool)
  (let [nx (len x)
        ny (len y)
        (mut i) 0
        (mut res) 0]
    (loop (if (or (>= (load i) nx) (>= (load i) ny))
              (break)
              (let [cx (primitive/cast i64 (get x (load i)))
                    cy (primitive/cast i64 (get y (load i)))]
                (if (< cx cy)
                    (do (set! res 1) (break))
                    (if (> cx cy)
                        (do (set! res 2) (break))
                        (set! i (primitive/iadd (load i) 1)))))))
    (if (= (load res) 1)
        true
        (if (= (load res) 2) false (< nx ny)))))

(defn conv-name [(c Convention)] (-> (slice u8))
  (let [p (primitive/alloc-stack Convention)] (set! p c) (.name p)))

; A whole-section dumper: `(<tag>` then a space+item per element, then `)`.
; Mirrors dump_program's per-section loops.
(defn d-program [(w (ptr Writer)) (p (ptr Program)) (a (dyn Allocator))]
  (-> i64)
  ; conventions — sorted by name (mirrors dump_program's keys().sort()).
  (ps w "(conventions")
  (let [convs (load (field p conventions))
        n (len convs)
        (mut used) (ArrayList::new [bool] a)]
    (for [k 0 n]
      (push! (mut used) false))
    (let [(mut c) 0]
      (loop (if (>= (load c) n)
                (break)
                (do
                  (let [(mut best) -1]
                    (for [bi 0 n]
                      (when (and (not (get (load used) bi))
                                 (or (< (load best)
                                        0)
                                     (str-lt (conv-name (get convs
                                                             bi))
                                             (conv-name (get convs
                                                             (load best))))))
                        (set! best bi)))
                    (set! (mut used) (load best) true)
                    (wb w 32)
                    (let [cc (primitive/alloc-stack Convention)]
                      (set! cc (get convs (load best)))
                      (d-convention w cc)))
                  (set! c (primitive/iadd (load c) 1)))))))
  (wb w 41)
  (ps w "\n(annotation-defs")
  (let [defs (load (field p annotation_defs))
        n (len (load defs))
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (let [d (elem defs (load i))]
                  (ps w " (annotation-def ")
                  (dstr w (.key d))
                  (wb w 32)
                  (d-type w (field d value_type))
                  (wb w 41))
                (set! i (primitive/iadd (load i) 1))))))
  (wb w 41)
  ; Printed only when a unit publishes something, so an ordinary program's
  ; dump is unchanged.
  (let [ue (load (field p unit_exports))
        n (len (load ue))]
    (when (> n 0)
      (ps w "\n(unit-exports")
      (for [i 0 n] (wb w 32) (dstr w (get (load ue) i)) 0)
      (wb w 41)
      0))
  (d-section w "structs" (.structs p) d-struct :ref)
  (d-section w "sums" (.sums p) d-sum :ref)
  (d-section w "externs" (.externs p) d-extern :ref)
  (d-section w "funcs" (.funcs p) d-func :ref)
  (d-section w "asserts" (.asserts p) d-assert :ref)
  (d-section w "consts" (.consts p) d-const :ref)
  (d-section w "traits" (.traits p) d-trait :ref)
  (d-section w "impls" (.impls p) d-impl :ref)
  (ps w "\n(statics)")
  (d-section w "metas" (.metas p) d-expr :ref)
  (d-section w "exports" (.exports p) d-export :ref)
  0)
