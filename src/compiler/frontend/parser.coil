; src/compiler/frontend/parser.coil — self-host Coil compiler, parser module.

(module coil.compiler.parser)
(import "coil.compiler.code_ops" :as codeops)
(import "coil.compiler.text" :as text)
(import "coil.primitive" :as primitive)
(import "coil.compiler.unit_state" :use *)

(defstruct ParserUnitState
  [(primitive_bindings PrimitiveBindingsBox)
   (depth i64)
   ; Indexed by code operation number: the qualified sum that operation answers
   ; with, empty for one whose primitive declares none (codeop-answer).
   (codeop_answers (array (slice u8) 256))])

(defn parser-unit-state-cell [] (-> (ptr (ptr ParserUnitState)))
  (primitive/alloc-static (ptr ParserUnitState)))

(defn parser-unit-state [] (-> (ptr ParserUnitState))
  (let [active (load (parser-unit-state-cell))]
    (if (= (primitive/cast i64 active) 0)
        (primitive/alloc-static ParserUnitState)
        active)))

(defn parser-unit-bind! [(next (ptr ParserUnitState))]
  (-> (ptr ParserUnitState))
  (let [prior (parser-unit-state)]
    (set! (parser-unit-state-cell) next)
    prior))

(import "coil.alloc" :as alloc :use *)
(import "coil.result" :use *)
(import "coil.slice" :use *)
(import "coil.str" :use *)
(import "coil.mem" :use *)
(import "coil.arraylist" :use *)
(import "coil.hashmap" :use *)
(import "coil.scratch" :as scratch)
(import "coil.io" :use *)
(import "coil.control" :use *)
(import "coil.try" :use *)
(import "coil.compiler.ffi" :use *)
(import "coil.compiler.ast" :use *)
(import "coil.compiler.vector_ops" :use *)
(import "coil.compiler.astdump" :use *)
(import "coil.compiler.comptime" :use *)
(import "coil.reader" :use *)
(import "coil.cc" :as cc)
(import "coil.layout" :as layout)

;;; Initialize listed fields in order, evaluating the target and initializer for each.
(defn init-fields! [(target Code) (initializer Code) (fields Code)] (-> Code)
  (unless (primitive/code-vector? fields)
    (primitive/error "init-fields!: expected a field-name vector"))
  (let [body (primitive/code-list-new)]
    (primitive/code-list-push! body `do)
    (for [i 0 (primitive/code-count fields)]
      (let [name (primitive/code-nth fields i)]
        (unless (primitive/code-sym? name)
          (primitive/error "init-fields!: expected a field name"))
        (let [access (primitive/code-symbol "." (primitive/code-str name))]
          (primitive/code-list-push! body
                                     `(set! (~access ~target) ~initializer)))))
    (primitive/code-list-done body)))

(defn unimplemented [(who (slice u8))] (-> i64)
  (let [w (stderr)] (ps w "UNIMPLEMENTED: ") (ps w who) (wb w 10))
  (abort)
  0)

; Primitive dispatch is supplied by module resolution. An empty table means that no
; source name denotes a primitive; the parser itself owns no primitive namespace.
(defstruct PrimitiveBindingsBox
  [(bindings (ptr (ArrayList PrimitiveBinding)))
   (plain_index (ptr (HashMap (slice u8) (slice u8))))
   (scoped_index (ptr (HashMap (slice u8) (slice u8))))])

(defn primitive-bindings-box [] (-> (ptr PrimitiveBindingsBox))
  (field (parser-unit-state) primitive_bindings))

(defn parser-set-primitive-bindings! [(bindings (ptr (ArrayList PrimitiveBinding)))
                                      (plain-index (ptr (HashMap (slice u8)
                                                                 (slice u8))))
                                      (scoped-index (ptr (HashMap (slice u8)
                                                                  (slice u8))))]
  (-> i64)
  (primitive-scoped-invalidate!)
  (set! (.bindings (primitive-bindings-box)) bindings)
  (set! (.plain_index (primitive-bindings-box)) plain-index)
  (set! (.scoped_index (primitive-bindings-box)) scoped-index)
  0)

;;; The bindings of each spelling a hygienic head asked about, by position, for
;;; the BINDINGS list it was built over. The scoped index answers a head unless
;;; its spelling binds in several modules; then the module decides, and a scan of
;;; every binding per such head was quadratic in the program's expansions. A
;;; spelling's bindings are collected the first time it is asked about, and the
;;; collections follow the list as bindings are appended to it. A list replaced
;;; (another one, a shorter one, `primitive-scoped-invalidate!`) starts over.
(defstruct PrimitiveScopedIndex
  [(ready bool)
   (bindings i64)
   (count i64)
   (buckets (HashMap (slice u8) (ptr (ArrayList i64))))
   (arena scratch/ScratchArena)])

(defn primitive-scoped-index [] (-> (ptr PrimitiveScopedIndex))
  (primitive/alloc-static PrimitiveScopedIndex))

;;; Forget the index: the bindings it was built over are being replaced.
(defn primitive-scoped-invalidate! [] (-> i64)
  (set! (.count (primitive-scoped-index)) -1)
  0)

(defn primitive-scoped-sync! [(ix (ptr PrimitiveScopedIndex))
                              (bindings (ptr (ArrayList PrimitiveBinding)))]
  (-> i64)
  (let [n (len (load bindings))]
    (unless (.ready ix)
      (scratch/ScratchArena::init-with-capacity (field ix arena)
                                                (malloc-allocator)
                                                65536)
      (set! (.buckets ix)
            (HashMap::new [(slice u8) (ptr (ArrayList i64))]
                          (malloc-allocator)
                          (keyops)))
      (set! (.ready ix) true)
      (set! (.count ix) -1)
      0)
    (cond (or (!= (.bindings ix) (primitive/cast i64 bindings))
              (< (.count ix) 0)
              (> (.count ix) n))
            (do
              (clear! (mut (.buckets ix)))
              (reset! (field ix arena))
              (set! (.bindings ix) (primitive/cast i64 bindings))
              (set! (.count ix) n)
              0)
          (< (.count ix) n)
            (do
              ; appended bindings join the buckets of their spellings
              (for [i (.count ix) n]
                (match (get (.buckets ix) (.source_name (elem bindings i)))
                  (Some [bucket] (do (push! bucket i) 0))
                  (None [] 0)))
              (set! (.count ix) n)
              0)
          :else 0))
  0)

(defn primitive-dispatch-scoped-scan [(bindings (ptr (ArrayList PrimitiveBinding)))
                                      (spelling (slice u8))
                                      (definition-module (slice u8))]
  (-> (Option (slice u8)))
  (let [ix (primitive-scoped-index)]
    (primitive-scoped-sync! ix bindings)
    (let [bucket
            (match (get (.buckets ix) spelling)
              (Some [b] b)
              (None []
                    (let [a (allocator (field ix arena))
                          (mut found) (ArrayList::new [i64] a)]
                      (for [i 0 (len (load bindings))]
                        (when (= (.source_name (elem bindings i)) spelling)
                          (push! (mut found) i)
                          0))
                      (let [b (box-al a (load found))]
                        (set! (mut (.buckets ix)) spelling b)
                        b))))]
      ; the first binding of the spelling in the module wins, as the scan's did
      (block :found
        (for [k 0 (len (load bucket))]
          (let [i (get (load bucket) k)]
            (when (and (< i (len (load bindings)))
                       (and (= (.source_name (elem bindings i)) spelling)
                            (= (.source_module (elem bindings i))
                               definition-module)))
              (break :found (Some (.opcode (elem bindings i)))))))
        (None [(slice u8)])))))

(defn primitive-dispatch-head [(head Sexp)] (-> (Option (slice u8)))
  (let [box (primitive-bindings-box)
        bindings (.bindings box)]
    (if (= (primitive/cast i64 bindings) 0)
        (None [(slice u8)])
        (let [spelling (sx-sval head)]
          (if (= (sx-hyg head) 0)
              (let [idx (.plain_index box)]
                (if (= (primitive/cast i64 idx) 0)
                    (None [(slice u8)])
                    (get (load idx) spelling)))
              (let [idx (.scoped_index box)
                    indexed
                      (if (= (primitive/cast i64 idx) 0)
                          (None [(slice u8)])
                          (get (load idx) spelling))]
                (match indexed
                  (Some [opcode]
                        (if (> (len opcode) 0)
                            (Some opcode)
                            (primitive-dispatch-scoped-scan bindings
                                                            spelling
                                                            (sx-hmod head))))
                  (None []
                        (primitive-dispatch-scoped-scan bindings
                                                        spelling
                                                        (sx-hmod head))))))))))

; ---- generic boxing + string helpers ----
(defn box-al [T] [(a (dyn Allocator)) (l (ArrayList T))]
  (-> (ptr (ArrayList T)))
  (box! a (ArrayList T) l))

;;; An empty allocator-backed list whose header lives in that same allocator.
(defn new-boxed-list [T] [(a (dyn Allocator))] (-> (ptr (ArrayList T)))
  (box-al a (ArrayList::new [T] a)))

;;; Allocate one zero-initialized compiler object.
(defn new-zeroed [T] [(a (dyn Allocator))] (-> (ptr T))
  (box! a T (zeroed T)))

(defn sconcat [(a (dyn Allocator)) (x (slice u8)) (y (slice u8))]
  (-> (slice u8))
  (match (concat a x y) (Some [v] v) (None [] "")))

(defn sconcat3 [(a (dyn Allocator))
                (x (slice u8))
                (y (slice u8))
                (z (slice u8))] (-> (slice u8))
  (match (concat3 a x y z) (Some [v] v) (None [] "")))

(defn push-mag [(buf (mut (ArrayList u8))) (n i64)] (-> i64)
  (if (< n 10)
      (push! (mut buf) (primitive/cast u8 (primitive/iadd n 48)))
      (do
        (push-mag (mut buf) (primitive/udiv n 10))
        (push! (mut buf)
               (primitive/cast u8 (primitive/iadd (primitive/urem n 10) 48))))))

(defn i64->str [(a (dyn Allocator)) (n i64)] (-> (slice u8))
  (let [(mut buf) (ArrayList::new [u8] a)]
    (if (< n 0)
        (do
          (push! (mut buf) (: 45 u8))
          (push-mag (mut buf) (primitive/isub 0 n)))
        (push-mag (mut buf) n))
    (slice (load buf))))

(defn char1 [(a (dyn Allocator)) (c i64)] (-> (slice u8))
  (slice::new [u8]
              (let [cb
                      (primitive/cast (ptr u8)
                                      (primitive/cast (ptr i8)
                                                      (data (match (alloc-bytes a
                                                                                1
                                                                                1)
                                                              (Some [s] s)
                                                              (None []
                                                                    (do
                                                                      (oom-at c"compiler allocation"
                                                                              1)
                                                                      (slice::new (primitive/cast (ptr u8)
                                                                                                  0)
                                                                                  0)))))))]
                (set! (index cb 0) (primitive/cast u8 c))
                cb)
              1))

; Type/parameter packs are compile-time sequences.  The two internal TApp
; constructors never denote runtime types: `$pack-var` is an unbound sequence
; parameter and `$pack` is its concrete substitution.
(defn pack-name? [(s (slice u8))] (-> bool)
  (let [n (len s)]
    (and (>= n 3) (= (subslice s (primitive/isub n 3) n) "..."))))

(defn pack-type [(a (dyn Allocator)) (name (slice u8))] (-> Type)
  (let [(mut xs) (ArrayList::new [Type] a)]
    (push! (mut xs) (TStruct name))
    (TApp "$pack-var" (box-al a (load xs)))))

(defn type-pack-var? [(t (ptr Type))] (-> bool)
  (match (load t) (TApp [n _] (= n "$pack-var")) (_ false)))

; ---- Sexp inspection (one match -> a flat info struct) ----
(defstruct SxInfo
  [(tag i64) (ival i64) (sval (slice u8)) (items (ptr (ArrayList Sexp)))])

(defn sx-info [(s Sexp)] (-> SxInfo)
  (let [(mut sp) (: s Sexp)
        (mut p) (zeroed SxInfo)]
    (set! (.ival p) 0)
    (set! (.sval p) "")
    (set! (.items p) (zeroed (ptr (ArrayList Sexp))))
    (match (.kind sp)
      (KInt [v] (do (set! (.tag p) 0) (set! (.ival p) v) 0))
      (KFloat [b] (do (set! (.tag p) 1) (set! (.ival p) b) 0))
      (KSym [x] (do (set! (.tag p) 2) (set! (.sval p) x) 0))
      (KKw [x] (do (set! (.tag p) 3) (set! (.sval p) x) 0))
      (KStr [x] (do (set! (.tag p) 4) (set! (.sval p) x) 0))
      (KCStr [x] (do (set! (.tag p) 5) (set! (.sval p) x) 0))
      (KList [it] (do (set! (.tag p) 6) (set! (.items p) it) 0))
      (KVec [it] (do (set! (.tag p) 7) (set! (.items p) it) 0))
      ; a KView deliberately leaves items NULL: views are metaprogram-plane
      ; values read only through the view-aware code-op accessors — compiler
      ; code reaching one through sx-items must fail loudly, not read the
      ; parent list at the wrong offset (docs/design/META_MEMORY.md phase 5)
      (KView [dc]
             (let [it (.items dc)
                   off (.off dc)
                   len (.len dc)]
               (do (set! (.tag p) 8) 0)))
      ; a joined list reads as the list it denotes: it lays its items out on first
      ; use, so every reader of a list reads it correctly without knowing
      (KSeg [dc]
            (let [parts (.parts dc)
                  len (.len dc)
                  flat (.flat dc)]
              (do
                (set! (.tag p) 6)
                (set! (.items p) (seg-force parts len flat))
                0))))
    p))

; Single-field queries avoid constructing SxInfo and copying unused payloads.
(defn sx-tag [(s Sexp)] (-> i64)
  (match (.kind s)
    (KInt [_] 0)
    (KFloat [_] 1)
    (KSym [_] 2)
    (KKw [_] 3)
    (KStr [_] 4)
    (KCStr [_] 5)
    (KList [_] 6)
    (KVec [_] 7)
    (KView [_] 8)
    (KSeg [_] 6)))

(defn sx-ival [(s Sexp)] (-> i64)
  (match (.kind s) (KInt [v] v) (KFloat [bits] bits) (_ 0)))

(defn sx-sval [(s Sexp)] (-> (slice u8))
  (match (.kind s)
    (KSym [text] text)
    (KKw [text] text)
    (KStr [text] text)
    (KCStr [text] text)
    (_ "")))

(defn sx-items [(s Sexp)] (-> (ptr (ArrayList Sexp)))
  ; A view is deliberately not exposed as its complete underlying list. A joined
  ; list is a list: its items are laid out once, here, the first time they are asked for.
  (match (.kind s)
    (KList [items] items)
    (KVec [items] items)
    (KSeg [dc]
          (let [parts (.parts dc)
                n (.len dc)
                flat (.flat dc)]
            (seg-force parts n flat)))
    (_ (primitive/cast (ptr (ArrayList Sexp)) 0))))

(defn sx-lo [(s Sexp)] (-> i64)
  (let [(mut p) (: s Sexp)] (.lo p)))

(defn sx-hi [(s Sexp)] (-> i64)
  (let [(mut p) (: s Sexp)] (.hi p)))

(defn sx-source [(s Sexp)] (-> i64)
  (let [(mut p) (: s Sexp)] (.source p)))

(defn sx-ctxt [(s Sexp)] (-> i64)
  (let [(mut p) (: s Sexp)] (.ctxt p)))

(defn sx-hyg [(s Sexp)] (-> i64)
  (let [(mut p) (: s Sexp)] (.hyg p)))

(defn sx-hmod [(s Sexp)] (-> (slice u8))
  (let [(mut p) (: s Sexp)] (hmod-name (.hmod p))))

(defn sx-horigin [(s Sexp)] (-> i64)
  (let [(mut p) (: s Sexp)] (.horigin p)))

(defn sx-hflags [(s Sexp)] (-> i64)
  (let [(mut p) (: s Sexp)] (.hflags p)))

(defn lexical-name [(a (dyn Allocator)) (s Sexp)] (-> (slice u8))
  (let [name (sx-sval s)
        scope (sx-hyg s)]
    (if (= scope 0)
        name
        (if (< scope 0)
            ; Unscoped constructed data is never a lexical identity. Allocate a
            ; distinct poison key at every syntactic occurrence, so even reusing
            ; one `code-symbol` object cannot silently establish a binding.
            ; `syntax->datum` is the explicit operation that opts into the
            ; ordinary caller-visible spelling (hyg=0).
            (text/format a "$datum{}${}" (i64->str a (next-node-id)) name)
            ; Resolver keys are deliberately not source rendering. Definition module
            ; is lexical context; source IDs remain diagnostics only.
            (text/format a "$scope{}@{}${}" (i64->str a scope) (sx-hmod s) name)))))

(defn sx-node-id [(s Sexp)] (-> i64)
  (let [(mut p) (: s Sexp)] (.node-id p)))

(defn sx-len [(l (ptr (ArrayList Sexp)))] (-> i64)
  (len (load l)))

(defn sx-at [(l (ptr (ArrayList Sexp))) (i i64)] (-> Sexp)
  (get (load l) i))

(defn sx-get [(l (ptr (ArrayList Sexp))) (i i64)] (-> (Option Sexp))
  (if (or (< i 0) (>= i (sx-len l)))
      (None [Sexp])
      (Some (sx-at l i))))

(defn rest-from [(a (dyn Allocator)) (l (ptr (ArrayList Sexp))) (start i64)]
  (-> (ptr (ArrayList Sexp)))
  (let [(mut out) (ArrayList::new [Sexp] a)
        n (sx-len l)]
    (reserve! (mut out) (if (> n start) (- n start) 0))
    (for [i start n]
      (push! (mut out) (sx-at l i)))
    (box-al a (load out))))

; small Option<Sexp> predicates
(defn opt-is-vec [(o (Option Sexp))] (-> bool)
  (match o (Some [s] (= (sx-tag s) 7)) (None [] false)))

(defn opt-get [(o (Option Sexp))] (-> Sexp)
  (match o (Some [s] s) (None [] (zeroed Sexp))))

(defn opt-is-kw [(o (Option Sexp)) (name (slice u8))] (-> bool)
  (match o
    (Some [s] (and (= (sx-tag s) 3) (= (sx-sval s) name)))
    (None [] false)))

(defn opt-is-pos-int [(o (Option Sexp))] (-> bool)
  (match o
    (Some [s]
          (and (= (sx-tag s) 0)
               (> (sx-ival s) 0)))
    (None [] false)))

(defn opt-int [(o (Option Sexp))] (-> i64)
  (match o (Some [s] (sx-ival s)) (None [] 0)))

(defn opt-is-str [(o (Option Sexp))] (-> bool)
  (match o (Some [s] (= (sx-tag s) 4)) (None [] false)))

(defn opt-str-val [(o (Option Sexp))] (-> (slice u8))
  (match o (Some [s] (sx-sval s)) (None [] "")))

; The DISPLAY escaper for Str/CStr, used by sexp-display. Differs from the DUMP
; escaper (esc-write, which emits `\xNN`): Display renders NUL as `\0` and any
; other control byte as `\u{hex}` (minimal lowercase hex).
(defn dbg-hexnum [(a (dyn Allocator)) (b i64)] (-> (slice u8))
  (if (< b 16)
      (char1 a (hexd b))
      (sconcat a
               (char1 a (hexd (primitive/udiv b 16)))
               (char1 a (hexd (primitive/urem b 16))))))

(defn dbg-escape [(a (dyn Allocator)) (s (slice u8))] (-> (slice u8))
  (let [n (len s)
        (mut acc) ""]
    (for [i 0 n]
      (let [b (primitive/cast i64 (get s i))]
        (store! acc
                (sconcat a
                         (load acc)
                         (cond (= b 34) "\\\""
                               (= b 92) "\\\\"
                               (= b 10) "\\n"
                               (= b 13) "\\r"
                               (= b 9) "\\t"
                               (= b 0) "\\0"
                               (or (< b 32)
                                   (= b 127))
                                 (text/format a "\\u{{{}}}" (dbg-hexnum a b))
                               :else (char1 a b))))))
    (load acc)))

; CStr Debug — used by the llvm-ir parse-error path, where
; An LLVM error string renders as `{:?}` over a `CStr`. Unlike str
; Debug (dbg-escape), CStr Debug is `ascii::escape_default` per byte: it escapes `'`
; as `\'` and renders any non-printable byte as `\xHH` (two lowercase hex digits),
; NOT `\u{…}`. Distinct helper so dbg-escape's str-Debug callers stay unchanged.
(defn cstr-dbg-escape [(a (dyn Allocator)) (s (slice u8))] (-> (slice u8))
  (let [n (len s)
        (mut acc) ""]
    (for [i 0 n]
      (let [b (primitive/cast i64 (get s i))]
        (store! acc
                (sconcat a
                         (load acc)
                         (cond (= b 9) "\\t"
                               (= b 13) "\\r"
                               (= b 10) "\\n"
                               (= b 92) "\\\\"
                               (= b 39) "\\'"
                               (= b 34) "\\\""
                               (and (>= b 32)
                                    (<= b 126))
                                 (char1 a b)
                               :else
                                 (text/format a
                                              "\\x{}{}"
                                              (char1 a
                                                     (hexd (& (>> b 4) 15)))
                                              (char1 a
                                                     (hexd (& b 15)))))))))
    (load acc)))

; ---- f64 Debug, for error interpolation of float literals ----
; A string of `n` ASCII '0' characters.
(defn nzeros [(a (dyn Allocator)) (n i64)] (-> (slice u8))
  (let [(mut acc) ""]
    (for [i 0 n]
      (set! acc (text/format a "{}0" (load acc))))
    (load acc)))

; Render an f64 as the SHORTEST decimal that round-trips. Input is the raw f64 bit
; pattern (a KFloat carries bits, not a decimal). Strategy: libc gives correctly
; rounded p-significant-digit decimals; we search p=1..17 for the SHORTEST p whose
; `%.*e` output parses back (strtod) to the identical f64 — this is exactly the
; shortest-round-trip Ryū would find. We then re-render (sign, digits, exponent) as
; fixed notation with a mandatory `.0`, switching to exponential iff
; `abs < 1e-4 || abs >= 1e16` (equivalently the leading-digit exponent
; E < -4 || E >= 16).
(defn f64-debug [(a (dyn Allocator)) (bits i64)] (-> (slice u8))
  (let [absbits (& bits 9223372036854775807)
        sign
          (= (primitive/cast i64 (>> (primitive/cast u64 bits) 63))
             1)
        expfield
          (& (primitive/cast i64
                             (>> (primitive/cast u64
                                                 bits)
                                 52))
             2047)
        mant (& bits 4503599627370495)]
    (if (= expfield 2047)
        (if (!= mant 0) "NaN" (if sign "-inf" "inf"))
        (if (= absbits 0)
            (if sign "-0.0" "0.0")
            (let [absx (bits->f64 absbits)
                  (mut buf) (zeroed (array u8 64))
                  bp (primitive/cast (ptr i8) (mut buf))
                  (mut ep) (zeroed (ptr i8))
                  (mut p) 1
                  (mut done) false]
              ; shortest p whose %.*e round-trips
              (loop (if (or (load done) (> (load p) 17))
                        (break)
                        (do
                          (snprintf bp
                                    64
                                    c"%.*e"
                                    (primitive/cast i32
                                                    (primitive/isub (load p) 1))
                                    absx)
                          (if (= (f64-bits (strtod bp (mut ep))) absbits)
                              (do (set! done true) 0)
                              (do (set! p (primitive/iadd (load p) 1)) 0)))))
              ; buf now holds "d[.ddd]e±XX" for the shortest p; parse into digits + E
              (let [(mut ei) 0]
                (loop (if (= (primitive/cast i64
                                             (load (index bp (load ei))))
                             101)
                          (break)
                          (set! ei (primitive/iadd (load ei) 1))))
                (let [(mut ds)
                        (char1 a
                               (primitive/cast i64
                                               (load (index bp 0))))]
                  (when (> (load ei) 1)
                    (let [(mut k) 2]
                      (loop (if (>= (load k) (load ei))
                                (break)
                                (do
                                  (set! ds
                                        (sconcat a
                                                 (load ds)
                                                 (char1 a
                                                        (primitive/cast i64
                                                                        (load (index bp
                                                                                     (load k)))))))
                                  (set! k (primitive/iadd (load k) 1)))))))
                  (let [(mut ecur) (primitive/iadd (load ei) 2)
                        (mut emag) 0]
                    (loop (let [c
                                  (primitive/cast i64
                                                  (load (index bp (load ecur))))]
                            (if (= c 0)
                                (break)
                                (do
                                  (set! emag
                                        (primitive/iadd (primitive/imul (load emag)
                                                                        10)
                                                        (primitive/isub c 48)))
                                  (set! ecur (primitive/iadd (load ecur) 1))))))
                    (let [esignc
                            (primitive/cast i64
                                            (load (index bp
                                                         (primitive/iadd (load ei)
                                                                         1))))
                          ee
                            (if (= esignc 45)
                                (primitive/isub 0 (load emag))
                                (load emag))
                          ; strip trailing zeros from the significand
                          (mut dlen) (len (load ds))]
                      (loop (if (<= (load dlen) 1)
                                (break)
                                (if (= (primitive/cast i64
                                                       (get (load ds)
                                                            (primitive/isub (load dlen)
                                                                            1)))
                                       48)
                                    (set! dlen (primitive/isub (load dlen) 1))
                                    (break))))
                      (let [dg (subslice (load ds) 0 (load dlen))
                            k (load dlen)
                            point (primitive/iadd ee 1)
                            body
                              (cond (or (< ee -4)
                                        (>= ee 16))  ; exponential: d1[.rest]e<E>
                                      (text/format a
                                                   "{}e{}"
                                                   (if (> k
                                                          1)
                                                       (text/format a
                                                                    "{}.{}"
                                                                    (subslice dg
                                                                              0
                                                                              1)
                                                                    (subslice dg
                                                                              1
                                                                              k))
                                                       (subslice dg 0 1))
                                                   (if (< ee 0)
                                                       (text/format a
                                                                    "-{}"
                                                                    (i64->str a
                                                                              (primitive/isub 0
                                                                                              ee)))
                                                       (i64->str a ee)))
                                    ; fixed: always at least one fractional digit
                                    (<= point 0)
                                      (text/format a
                                                   "0.{}{}"
                                                   (nzeros a
                                                           (primitive/isub 0
                                                                           point))
                                                   dg)
                                    (>= point k)
                                      (text/format a
                                                   "{}{}.0"
                                                   dg
                                                   (nzeros a
                                                           (primitive/isub point
                                                                           k)))
                                    :else
                                      (text/format a
                                                   "{}.{}"
                                                   (subslice dg 0 point)
                                                   (subslice dg point k)))]
                        (if sign (text/format a "-{}" body) body)))))))))))

; ---- Sexp Display, for error interpolation ----
(defn sexp-display [(a (dyn Allocator)) (s Sexp)] (-> (slice u8))
  (let [tg (sx-tag s)]
    (cond (= tg 0) (i64->str a (sx-ival s))
          (= tg 2) (sx-sval s)
          (= tg 3) (text/format a ":{}" (sx-sval s))
          (= tg 4) (text/format a "\"{}\"" (dbg-escape a (sx-sval s)))
          (= tg 5) (text/format a "c\"{}\"" (dbg-escape a (sx-sval s)))
          (= tg 6) (seq-display a (sx-items s) 40 41)
          (= tg 7) (seq-display a (sx-items s) 91 93)
          ; a KView (tag 8) displays as the list it denotes — read through its
          ; own payload, never sx-items (deliberately NULL for views)
          (= tg 8)
            (let [(mut sp) (: s Sexp)]
              (match (.kind sp)
                (KView [dc]
                       (let [vit (.items dc)
                             voff (.off dc)
                             vlen (.len dc)]
                         (seq-display-window a vit voff vlen 40 41)))
                (_ "")))
          :else  ; Float (tag 1) Display is the shortest-round-trip f64 decimal.
            ; The KFloat carries the raw bit pattern (sx-ival); f64-debug reproduces it.
            (f64-debug a (sx-ival s)))))

(defn seq-display-window [(a (dyn Allocator))
                          (items (ptr (ArrayList Sexp)))
                          (off i64)
                          (len i64)
                          (open i64)
                          (close i64)] (-> (slice u8))
  (let [(mut acc) (char1 a open)]
    (for [i 0 len]
      (when (> i 0)
        (set! acc (text/format a "{} " (load acc)))
        0)
      (set! acc
            (sconcat a
                     (load acc)
                     (sexp-display a
                                   (sx-at items
                                          (primitive/iadd off
                                                          i))))))
    (sconcat a (load acc) (char1 a close))))

(defn seq-display [(a (dyn Allocator))
                   (items (ptr (ArrayList Sexp)))
                   (open i64)
                   (close i64)] (-> (slice u8))
  (let [(mut acc) (char1 a open)
        n (sx-len items)]
    (for [i 0 n]
      (when (> i 0)
        (set! acc (text/format a "{} " (load acc)))
        0)
      (set! acc
            (sconcat a
                     (load acc)
                     (sexp-display a (sx-at items i)))))
    (sconcat a (load acc) (char1 a close))))

; Source rendering streams into a writer. Building a string at every list
; prefix retains quadratic temporary storage for large generated definitions.
(defn source-string-write [(w (ptr Writer)) (s (slice u8))] (-> i64)
  (wb w 34)
  (for byte s
    (let [b (primitive/cast i64 byte)]
      (cond (= b 34) (ps w "\\\"")
            (= b 92) (ps w "\\\\")
            (= b 10) (ps w "\\n")
            (= b 13) (ps w "\\r")
            (= b 9) (ps w "\\t")
            (= b 0) (ps w "\\0")
            (or (< b 32) (= b 127)) (do (ps w "\\x") (hex2 w b) (ps w ";"))
            :else (wb w b))))
  (wb w 34))

(defn sexp-source-write [(a (dyn Allocator)) (w (ptr Writer)) (s Sexp)] (-> i64)
  (let [tag (sx-tag s)]
    (cond (= tag 0) (ps w (i64->str a (sx-ival s)))
          (= tag 1) (ps w (f64-debug a (sx-ival s)))
          (= tag 2) (ps w (sx-sval s))
          (= tag 3) (do (wb w 58) (ps w (sx-sval s)))
          (= tag 4) (source-string-write w (sx-sval s))
          (= tag 5) (do (wb w 99) (source-string-write w (sx-sval s)))
          :else
            (do
              (wb w (if (= tag 7) 91 40))
              (for index (range 0 (code-node-len s))
                (if (> index 0) (wb w 32) 0)
                (sexp-source-write a w (code-node-at s index)))
              (wb w (if (= tag 7) 93 41))))))

(defn sexp-source [(a (dyn Allocator)) (s Sexp)] (-> (slice u8))
  (let [(mut out) (StrBuf::new a)
        (mut w) (zeroed Writer)]
    (sexp-source-write a (StrBuf::writer (mut w) (mut out)) s)
    (finish! (mut out))))

(defn print-sexp-source [(a (dyn Allocator)) (w (ptr Writer)) (s Sexp)] (-> i64)
  (let [(mut buffer) (zeroed BufferedOutput)
        buffered (BufferedOutput::init (mut buffer) w)]
    (sexp-source-write a buffered s)
    (match (BufferedOutput::flush (mut buffer)) (Ok [_] 0) (Err [_] 0))))

; ---- diagnostics ----
(defn derr [(msg (slice u8))] (-> Diag)
  (mk-diag -1 -1 msg))

;;; Where an array length was written as a name, `(array T N)`: a type carries
;;; no span, so a diagnostic about the name (it names no constant, the constant
;;; is negative) looks the place up here. Keyed by the spelling, and by the
;;; qualified name resolution gives it; the first place a name is written wins.
(defstruct ExtentSite [(source i64) (lo i64) (hi i64)])

(defstruct ExtentSites [(ready bool) (map (HashMap (slice u8) ExtentSite))])

(defn extent-sites [] (-> (ptr ExtentSites))
  (primitive/alloc-static ExtentSites))

(defn extent-site-record! [(name (slice u8)) (source i64) (lo i64) (hi i64)]
  (-> i64)
  (let [sites (extent-sites)]
    (unless (.ready sites)
      (set! (.map sites)
            (HashMap::new [(slice u8) ExtentSite] (malloc-allocator) (keyops)))
      (set! (.ready sites) true)
      0)
    (unless (or (< lo 0) (contains? (.map sites) name))
      (set! (mut (.map sites))
            name
            (ExtentSite
              :source source
              :lo lo
              :hi hi))
      0))
  0)

;;; Record that NAME, written as an array length, resolved to QUALIFIED.
(defn extent-site-alias! [(name (slice u8)) (qualified (slice u8))] (-> i64)
  (let [sites (extent-sites)]
    (when (.ready sites)
      (match (get (.map sites) name)
        (Some [site]
              (extent-site-record! qualified
                                   (.source site)
                                   (.lo site)
                                   (.hi site)))
        (None [] 0)))
    0))

(defn extent-site [(name (slice u8))] (-> (Option ExtentSite))
  (let [sites (extent-sites)]
    (if (.ready sites) (get (.map sites) name) (None [ExtentSite]))))

;;; Where resolution has met a type that names a constant, as an array length
;;; or as `(const N)`. Until it has, no program needs its types searched for one,
;;; and only the bodies of the functions listed need theirs searched.
(defstruct ConstantTypeNames
  [(seen bool)
   (ready bool)
   ; the functions whose bodies hold such a type, and the names the types use
   (bodies (HashMap (slice u8) i64))
   (names (HashMap (slice u8) i64))])

(defn constant-type-names [] (-> (ptr ConstantTypeNames))
  (primitive/alloc-static ConstantTypeNames))

;;; A type naming the constant NAME was resolved, in the body of the function
;;; OWNER ("" outside a body).
(defn constant-named-in-type! [(name (slice u8)) (owner (slice u8))] (-> i64)
  (let [names (constant-type-names)]
    (unless (.ready names)
      (set! (.bodies names)
            (HashMap::new [(slice u8) i64] (malloc-allocator) (keyops)))
      (set! (.names names)
            (HashMap::new [(slice u8) i64] (malloc-allocator) (keyops)))
      (set! (.ready names) true)
      0)
    (set! (.seen names) true)
    (unless (contains? (.names names) name)
      (set! (mut (.names names)) name 0)
      0)
    (unless (or (= owner "") (contains? (.bodies names) owner))
      (set! (mut (.bodies names)) owner 0)
      0))
  0)

;;; Has a resolved type named NAME as a constant?
(defn constant-named-in-types? [(name (slice u8))] (-> bool)
  (let [names (constant-type-names)]
    (and (.ready names) (contains? (.names names) name))))

(defn constant-names-in-types? [] (-> bool)
  (.seen (constant-type-names)))

(defn constant-names-in-body? [(name (slice u8))] (-> bool)
  (let [names (constant-type-names)]
    (and (.ready names) (contains? (.bodies names) name))))

(defn derr-at [(lo i64) (hi i64) (msg (slice u8))] (-> Diag)
  (mk-diag lo hi msg))

(defn derr-at-src [(source i64) (lo i64) (hi i64) (msg (slice u8))] (-> Diag)
  (mk-diag-src source lo hi msg))

;;; A ranged diagnostic at captured coordinates. As with derr-at-src, context
;;; stamping remains the enclosing pass's policy rather than copying span.ctxt.
(defn derr-at-span [(span SourceSpan) (msg (slice u8))] (-> Diag)
  (derr-at-src (.source span) (.lo span) (.hi span) msg))

; Fill in whatever the inner diagnostic left unset, from the enclosing node.
; Span and source are INDEPENDENT: `derr-at` pins a precise span but cannot know
; which file it is in, so a diag with a real span still needs its source stamped.
; Guarding the source store on `lo < 0` would leave those attributed to nothing.
(defn dwspan [(d Diag) (source i64) (lo i64) (hi i64) (ctxt i64)] (-> Diag)
  (let [(mut p) (: d Diag)]
    (when (< (.lo p) 0)
      (set! (.lo p) lo)
      (set! (.hi p) hi)
      (set! (.ctxt p) ctxt))
    (when (< (.source p) 0) (set! (.source p) source))
    p))

(defn dwspan-at [(d Diag) (span SourceSpan)] (-> Diag)
  (dwspan d (.source span) (.lo span) (.hi span) (.ctxt span)))

; ---- Option -> Result with a message (mirrors `.ok_or(msg)?`) ----
(defn need [T] [(o (Option T)) (msg (slice u8))] (-> (Result T Diag))
  (match o (Some [v] (Ok v)) (None [] (Err (derr msg)))))

; ---- matchers ----
(defn as-list [(s Sexp) (msg (slice u8))]
  (-> (Result (ptr (ArrayList Sexp)) Diag))
  (if (= (sx-tag s) 6)
      (Ok (sx-items s))
      (Err (derr-at (sx-lo s) (sx-hi s) msg))))

(defn head-sym [(a (dyn Allocator)) (items (ptr (ArrayList Sexp)))]
  (-> (Result (slice u8) Diag))
  (if (= (sx-len items) 0)
      (Err (derr "empty list"))
      (let [h (sx-at items 0)]
        (if (= (sx-tag h) 2)
            (Ok (sx-sval h))
            (Err (derr-at (sx-lo h)
                          (sx-hi h)
                          (text/format a
                                       "expected a symbol head, got {}"
                                       (sexp-display a h))))))))

(defn sym-of [(a (dyn Allocator)) (s Sexp) (what (slice u8))]
  (-> (Result (slice u8) Diag))
  (if (= (sx-tag s) 2)
      (Ok (sx-sval s))
      (Err (derr-at (sx-lo s)
                    (sx-hi s)
                    (text/format a
                                 "{}: expected symbol, got {}"
                                 what
                                 (sexp-display a s))))))

; `sym-of` for a position that names a BINDING rather than a piece of data: same
; validation, but the identifier keeps its lexical identity instead of collapsing
; to its display spelling. A position that takes the spelling can only be matched
; by spelling — which is how a template-generated `deftrait` became invisible to
; the `impl` in its own template.
(defn lexical-sym-of [(a (dyn Allocator)) (s Sexp) (what (slice u8))]
  (-> (Result (slice u8) Diag))
  (if (= (sx-tag s) 2)
      (Ok (lexical-name a s))
      (Err (derr-at (sx-lo s)
                    (sx-hi s)
                    (text/format a
                                 "{}: expected symbol, got {}"
                                 what
                                 (sexp-display a s))))))

(defn kw-of [(a (dyn Allocator)) (s Sexp) (what (slice u8))]
  (-> (Result (slice u8) Diag))
  (if (= (sx-tag s) 3)
      (Ok (sx-sval s))
      (Err (derr-at (sx-lo s)
                    (sx-hi s)
                    (text/format a
                                 "{}: expected keyword, got {}"
                                 what
                                 (sexp-display a s))))))

(defn int-val [(a (dyn Allocator)) (s Sexp) (what (slice u8))]
  (-> (Result i64 Diag))
  (if (= (sx-tag s) 0)
      (Ok (sx-ival s))
      (Err (derr-at (sx-lo s)
                    (sx-hi s)
                    (text/format a
                                 "{}: expected an integer, got {}"
                                 what
                                 (sexp-display a s))))))

(defn pow2 [(s (Option Sexp))] (-> (Result i64 Diag))
  (match s
    (Some [x]
          (if (and (= (sx-tag x) 0)
                   (let [n (sx-ival x)]
                     (and (> n 0)
                          (= (& n (primitive/isub n 1))
                             0))))
              (Ok (sx-ival x))
              (Err (derr "alignment must be a positive power of two"))))
    (None [] (Err (derr "alignment must be a positive power of two")))))

(defn sym-vec [(a (dyn Allocator)) (s Sexp) (what (slice u8))]
  (-> (Result (ptr (ArrayList (slice u8))) Diag))
  (if (= (sx-tag s) 7)
      (try (let [items (sx-items s)
                 (mut out) (ArrayList::new [(slice u8)] a)
                 n (sx-len items)]
             (for [i 0 n]
               (push! (mut out)
                      (match (sym-of a (sx-at items i) what)
                        (Ok [temporary] temporary)
                        (Err [temporary] (break :try (Err temporary))))))
             (Ok (box-al a (load out)))))
      (Err [(ptr (ArrayList (slice u8))) Diag]
           (derr-at (sx-lo s)
                    (sx-hi s)
                    (text/format a
                                 "{}: expected vector, got {}"
                                 what
                                 (sexp-display a s))))))

(defn need-vec [(o (Option Sexp)) (msg (slice u8))]
  (-> (Result (ptr (ArrayList Sexp)) Diag))
  (match o
    (Some [s]
          (if (= (sx-tag s) 7)
              (Ok (sx-items s))
              (Err (derr msg))))
    (None [] (Err (derr msg)))))

(defstruct Two [(x Sexp) (y Sexp)])

(defn need-two [(a (dyn Allocator))
                (args (ptr (ArrayList Sexp)))
                (head (slice u8))] (-> (Result Two Diag))
  (if (!= (sx-len args) 2)
      (Err (derr (text/format a "{}: expects exactly 2 arguments" head)))
      (Ok (let [(mut p) (zeroed Two)]
            (set! (.x p) (sx-at args 0))
            (set! (.y p) (sx-at args 1))
            p))))

; ---- types ----
(defn type-int-bits [(t Type)] (-> i64)
  (match t
    (TConst [_] -1)
    (TInt [b s] b)
    (TFloat [_] -1)
    (TBool [] -1)
    (TVoid [] -1)
    (TPtr [_] -1)
    (TRef [_ _] -1)
    (TStruct [_] -1)
    (TArray [_ _] -1)
    (TSlice [_] -1)
    (TVec [_ _] -1)
    (TFn [_ _ _] -1)
    (TApp [_ _] -1)
    (TNever [] -1)
    (TError [] -1)
    (TCode [] -1)
    (TCodeBuilder [] -1)
    (TExternRef [] -1)))

(defn not-int-diag [(a (dyn Allocator)) (name (slice u8))] (-> Diag)
  (derr (text/format a "not an int type '{}'" name)))

(defn int-type [(a (dyn Allocator)) (name (slice u8))] (-> (Result Type Diag))
  (let [n (len name)]
    (if (= n 0)
        (Err (not-int-diag a name))
        (let [c0 (primitive/cast i64 (get name 0))
              signed
                (if (= c0 105)
                    1
                    (unless (= c0 117) -1))]
          (if (or (< signed 0)
                  (= n 1))
              (Err (not-int-diag a name))
              (let [(mut bits) 0
                    (mut bad) false
                    (mut over) false
                    (mut i) 1]
                (loop (if (>= (load i) n)
                          (break)
                          (let [c (primitive/cast i64 (get name (load i)))]
                            (if (and (>= c 48)
                                     (<= c 57))
                                (do
                                  (set! bits
                                        (primitive/iadd (primitive/imul (load bits)
                                                                        10)
                                                        (primitive/isub c 48)))
                                  (when (> (load bits)
                                           4294967295)
                                    (set! over true)
                                    0)
                                  (set! i (primitive/iadd (load i) 1)))
                                (do (set! bad true) (break))))))
                (cond (load bad) (Err (not-int-diag a name))
                      (load over)
                        (Err (derr (text/format a
                                                "int width too large in '{}'"
                                                name)))
                      (or (= (load bits) 0)
                          (> (load bits) 65535))
                        (Err (derr (text/format a
                                                "int width out of range in '{}' (1..=65535)"
                                                name)))
                      :else (Ok (TInt (load bits) (= signed 1))))))))))

; The C machine word: `size_t`/`ssize_t`/`long`/`intptr_t` — i32 on wasm32 (ILP32),
; i64 on LP64 (arm64/x86-64). Resolved HERE, at parse, because the target is fixed and
; already set (driver's set-target-arch! runs before the pipeline parses anything). So
; `usize`/`isize` are plain `TInt`s downstream — visible to generic instantiation and
; needing no backend/checker/mono change. On a 64-bit target `isize` == `i64` exactly,
; so migrating the prelude's `i64` size args to `isize` is byte-identical on native.
(defn target-word-bits [] (-> i64)
  (let [a (target-arch-str)] (if (or (= a "wasm32") (= a "riscv32")) 32 64)))

; The name a struct, sum or trait definition binds. A built-in type's name is
; read as that type wherever a type is written, before any definition is looked
; up -- macro signatures are recognized by `Code` before names resolve -- so a
; definition spelled like one could never be named, and is rejected here.
; Library types such as Option and Result are ordinary definitions instead, and
; a module's own definition of one shadows it.
(defn definition-type-name [(a (dyn Allocator)) (s Sexp) (what (slice u8))]
  (-> (Result (slice u8) Diag))
  (try (let [name (try! (sym-of a s (text/format a "{} name" what)))]
         (if (or (some? (builtin-code-type name))
                 (match (prim-type a name) (Ok [_] true) (Err [_] false)))
             (Err (derr-at (sx-lo s)
                           (sx-hi s)
                           (text/format a
                                        "'{}' is a built-in type, so a {} can't take its name; choose another"
                                        name
                                        what)))
             (Ok name)))))

;;; The built-in type NAME denotes when it is `Code` or `CodeBuilder`. Like `i64`
;;; these are no module's definitions: the name is read as the type wherever a
;;; type is written, before any definition is looked up, because a metaprogram
;;; is recognized by its `Code` signature before names resolve. Every place that
;;; recognizes one of them asks this.
(defn builtin-code-type [(name (slice u8))] (-> (Option Type))
  (cond (= name "Code") (Some (TCode))
        (= name "CodeBuilder") (Some (TCodeBuilder))
        :else (None [Type])))

;;; The name `builtin-code-type` reads as T, or "" when T is neither type.
(defn builtin-code-type-name [(t Type)] (-> (slice u8))
  (match t
    (TCode [] "Code")
    (TCodeBuilder [] "CodeBuilder")
    (_ "")))

;;; Is the type form S the built-in `Code` type?
(defn code-type-form? [(s Sexp)] (-> bool)
  (and (= (sx-tag s) 2)
       (match (builtin-code-type (sx-sval s))
         (Some [t] (match t (TCode [] true) (_ false)))
         (None [] false))))

(defn prim-type [(a (dyn Allocator)) (name (slice u8))] (-> (Result Type Diag))
  (cond (= name "f32") (Ok (TFloat 32))
        (= name "f64") (Ok (TFloat 64))
        (= name "bool") (Ok (TBool))
        (= name "void") (Ok (TVoid))
        ; The type of an expression that never yields: a function declared
        ; (-> never) does not return, and a call of one has every type.
        (= name "never") (Ok (TNever))
        (= name "externref") (Ok (TExternRef))
        (= name "usize") (Ok (TInt (target-word-bits) false))
        (= name "isize") (Ok (TInt (target-word-bits) true))
        :else (int-type a name)))

(defn parse-types [(a (dyn Allocator)) (items (ptr (ArrayList Sexp)))]
  (-> (Result (ptr (ArrayList Type)) Diag))
  (try (let [(mut out) (ArrayList::new [Type] a)
             n (sx-len items)]
         (reserve! (mut out) n)
         (for [i 0 n]
           (push! (mut out)
                  (match (parse-type a (sx-at items i))
                    (Ok [temporary] temporary)
                    (Err [temporary] (break :try (Err temporary))))))
         (Ok (box-al a (load out))))))

(defn parse-type [(a (dyn Allocator)) (s Sexp)] (-> (Result Type Diag))
  (match (parse-type-inner a s)
    (Err [d] (Err (dwspan d (sx-source s) (sx-lo s) (sx-hi s) (sx-ctxt s))))
    (Ok [t]
        (let [node
                (if (and (= (sx-tag s) 6) (> (sx-len (sx-items s)) 0))
                    (sx-at (sx-items s) 0)
                    s)]
          (match t
            (TStruct [_] (source-site-record! node node "type"))
            (TApp [_ _] (source-site-record! node node "type"))
            (_ 0))
          ; `(dyn Trait)` parses as the nominal `Trait-dyn`, written with the head
          ; `dyn`, so the identifier an author reads as the type is the trait symbol.
          (when (and (= (sx-tag s) 6)
                     (and (> (sx-len (sx-items s)) 1)
                          (and (= (sx-tag (sx-at (sx-items s) 0)) 2)
                               (= (sx-sval (sx-at (sx-items s) 0)) "dyn"))))
            (source-site-record! (sx-at (sx-items s) 1)
                                 (sx-at (sx-items s) 1)
                                 "type")
            0)
          (Ok t)))))

(defn parse-type-inner [(a (dyn Allocator)) (s Sexp)] (-> (Result Type Diag))
  (let [tg (sx-tag s)
        slo (sx-lo s)
        shi (sx-hi s)]
    (cond (= tg 0) (Ok (TConst (ConstInt (sx-ival s))))
          ; A keyword is a Keyword constant: `(Quantity :meters)`.
          (= tg 3) (Ok (TConst (ConstKeyword (sx-sval s))))
          (= tg 2)
            (let [k (sx-sval s)]
              (if (or (= k "true") (= k "false"))
                  (Ok (TConst (ConstBool (= k "true"))))
                  (if (pack-name? k)
                      (Ok (pack-type a k))
                      (match (builtin-code-type k)
                        (Some [t] (Ok t))
                        (None []
                              (try (let [t
                                           (try-or! (prim-type a k)
                                                    (Ok (TStruct (lexical-name a
                                                                               s))))]
                                     (Ok t))))))))
          (= tg 6) (parse-type-list a (sx-items s))
          :else
            (Err (derr-at slo
                          shi
                          (text/format a
                                       "unsupported type: {}"
                                       (sexp-display a s)))))))

(defn parse-type-list [(a (dyn Allocator)) (items (ptr (ArrayList Sexp)))]
  (-> (Result Type Diag))
  (try (let [head (try! (head-sym a items))]
         (cond (= head "const")
                 (if (= (sx-len items) 2)
                     (let [v (sx-at items 1)
                           tg (sx-tag v)]
                       (cond (= tg 0) (Ok (TConst (ConstInt (sx-ival v))))
                             (= tg 3) (Ok (TConst (ConstKeyword (sx-sval v))))
                             (and (= tg 2) (= (sx-sval v) "true"))
                               (Ok (TConst (ConstBool true)))
                             (and (= tg 2) (= (sx-sval v) "false"))
                               (Ok (TConst (ConstBool false)))
                             ; a constant's name: its value, once checking knows it
                             (= tg 2)
                               (Ok (TConst (ConstRef (lexical-name a v))))
                             :else
                               (Err [Type Diag]
                                    (derr "constant generic argument expects (const VALUE) with an integer, true, false, a keyword or a constant's name"))))
                     (Err [Type Diag]
                          (derr "constant generic argument expects (const VALUE) with an integer, true, false, a keyword or a constant's name")))
               (= head "mask")
                 (let [width
                         (try! (need [Sexp]
                                     (sx-get items 1)
                                     "mask type: missing lane count"))
                       elem (box-type a (TBool))]
                   (cond (opt-is-pos-int (sx-get items 1))
                           (Ok (fixed-vec elem (sx-ival width)))
                         (= (sx-tag width) 2)
                           (Ok (TVec elem (ParamExtent (lexical-name a width))))
                         :else
                           (Err [Type Diag]
                                (derr "mask type requires a positive width or generic parameter"))))
               (= head "mut")
                 (Ok (TRef true
                           (box-type a
                                     (try! (parse-type a
                                                       (try! (need [Sexp]
                                                                   (sx-get items
                                                                           1)
                                                                   "mut: expects (mut TYPE)")))))))
               (= head "ref")
                 (Ok (TRef false
                           (box-type a
                                     (try! (parse-type a
                                                       (try! (need [Sexp]
                                                                   (sx-get items
                                                                           1)
                                                                   "ref: expects (ref TYPE)")))))))
               (= head "ptr")
                 (Ok (TPtr (box-type a
                                     (match (sx-get items 1)
                                       (Some [t] (try! (parse-type a t)))
                                       (None [] (TInt 64 true))))))
               (= head "array")
                 (let [elem
                         (box-type a
                                   (try! (parse-type a
                                                     (try! (need [Sexp]
                                                                 (sx-get items
                                                                         1)
                                                                 "array type: missing element type")))))]
                   (match (sx-get items 2)
                     (None []
                           (Err [Type Diag]
                                (derr "array type: missing length; write (array T N) with N a non-negative integer, an integer constant or an integer value parameter")))
                     (Some [ls]
                           (cond (= (sx-tag ls) 0)
                                   (if (< (sx-ival ls) 0)
                                       (Err [Type Diag]
                                            (derr "array type: a length cannot be negative"))
                                       (Ok (fixed-array elem (sx-ival ls))))
                                 (= (sx-tag ls) 2)
                                   (let [nm (lexical-name a ls)]
                                     (extent-site-record! nm
                                                          (sx-source ls)
                                                          (sx-lo ls)
                                                          (sx-hi ls))
                                     (Ok (TArray elem (ParamExtent nm))))
                                 :else
                                   (Err [Type Diag]
                                        (derr "array length must be a non-negative integer, an integer constant or an integer value parameter"))))))
               (= head "slice")
                 (Ok (TSlice (box-type a
                                       (try! (parse-type a
                                                         (try! (need [Sexp]
                                                                     (sx-get items
                                                                             1)
                                                                     "slice type: missing element type")))))))
               (= head "vec")
                 (let [elem
                         (box-type a
                                   (try! (parse-type a
                                                     (try! (need [Sexp]
                                                                 (sx-get items
                                                                         1)
                                                                 "vec type: missing element type")))))
                       width
                         (try! (need [Sexp]
                                     (sx-get items 2)
                                     "vec type: missing lane count"))]
                   (cond (opt-is-pos-int (sx-get items 2))
                           (Ok (fixed-vec elem (sx-ival width)))
                         (= (sx-tag width) 2)
                           (Ok (TVec elem (ParamExtent (lexical-name a width))))
                         :else
                           (Err [Type Diag]
                                (derr "vec type: expected a positive lane count or generic width parameter"))))
               (= head "struct")
                 (Ok (TStruct (try! (sym-of a
                                            (try! (need [Sexp]
                                                        (sx-get items 1)
                                                        "struct type: missing name"))
                                            "struct name"))))
               (= head "dyn")
                 (Ok (TStruct (text/format a
                                           "{}-dyn"
                                           (try! (sym-of a
                                                         (try! (need [Sexp]
                                                                     (sx-get items
                                                                             1)
                                                                     "dyn type: expected (dyn Trait)"))
                                                         "dyn trait name")))))
               (= head "fnptr")
                 (let [cc
                         (try! (parse-cc-ref a
                                             (try! (need [Sexp]
                                                         (sx-get items 1)
                                                         "fnptr type: missing convention"))
                                             "fnptr type"))
                       pv
                         (try! (need-vec (sx-get items 2)
                                         "fnptr type: expected a vector of parameter types"))
                       params (try! (parse-types a pv))
                       ret
                         (box-type a
                                   (try! (parse-type a
                                                     (try! (need [Sexp]
                                                                 (sx-get items
                                                                         3)
                                                                 "fnptr type: missing return type")))))]
                   (Ok (TFn
                         :cc cc
                         :params params
                         :ret ret)))
               :else
                 (Ok (TApp (lexical-name a (sx-at items 0))
                           (try! (parse-types a (rest-from a items 1)))))))))

; ---- type parameters ----
; ONE type-parameter entry: a bare `T`, or `(T Trait…)` carrying bounds. Shared by
; `defn`'s `[T (U Ord)]` vector and `impl`'s, so the two spellings cannot drift apart.
(defstruct TPEntry
  [(name (slice u8))
   (traits (ptr (ArrayList BoundTrait)))
   (value_type (Option Type))])

(defn mk-tpentry [(a (dyn Allocator))
                  (nm (slice u8))
                  (traits (ptr (ArrayList BoundTrait)))] (-> TPEntry)
  (let [r (primitive/alloc-stack TPEntry)]
    (set! (.name r) nm)
    (set! (.traits r) traits)
    (set! (.value_type r) (None [Type]))
    (load r)))

; The declaration record for an entry, when it declares more than a bare name:
; trait requirements, or the value type of `(const N T)`.
(defn tpentry-bound [(ep (ptr TPEntry))] (-> (Option Bound))
  (if (or (> (len (load (.traits ep))) 0)
          (match (.value_type ep) (Some [_] true) (None [] false)))
      (let [bp (primitive/alloc-stack Bound)]
        (set! (.name bp) (.name ep))
        (set! (.traits bp) (.traits ep))
        (set! (.value_type bp) (.value_type ep))
        (Some (load bp)))
      (None [Bound])))

; `(const NAME TYPE)`: a value parameter.
(defn const-tparam-entry? [(entry Sexp)] (-> bool)
  (and (= (sx-tag entry) 6)
       (let [items (sx-items entry)]
         (and (= (sx-len items) 3)
              (and (= (sx-tag (sx-at items 0)) 2)
                   (= (sx-sval (sx-at items 0)) "const"))))))

(defn parse-const-tparam-entry [(a (dyn Allocator)) (entry Sexp)]
  (-> (Result TPEntry Diag))
  (try (let [items (sx-items entry)
             namef (sx-at items 1)
             _name-check (try! (sym-of a namef "value parameter"))
             vt (try! (parse-type a (sx-at items 2)))]
         (Ok (let [r (primitive/alloc-stack TPEntry)]
               (set! (.name r) (lexical-name a namef))
               (set! (.traits r)
                     (new-boxed-list [BoundTrait] a))
               (set! (.value_type r) (Some vt))
               (load r))))))

(defn parse-tparam-entry [(a (dyn Allocator)) (entry Sexp)]
  (-> (Result TPEntry Diag))
  (try (if (const-tparam-entry? entry)
           (parse-const-tparam-entry a entry)
           (if (= (sx-tag entry) 2)
               (Ok (mk-tpentry a
                               (lexical-name a entry)
                               (new-boxed-list [BoundTrait] a)))
               (if (= (sx-tag entry) 6)
                   (let [eitems (sx-items entry)
                         pnamef
                           (try! (need [Sexp]
                                       (sx-get eitems 0)
                                       "type parameter: empty () bound"))
                         _pname-check (try! (sym-of a pnamef "type parameter"))
                         pname (lexical-name a pnamef)
                         (mut traits) (ArrayList::new [BoundTrait] a)
                         tn (sx-len eitems)]
                     (for [ti 1 tn]
                       ; a trait named in a BOUND is a reference like any
                       ; other; keeping only its spelling made a bound in a
                       ; template resolve at the call site
                       (let [raw (sx-at eitems ti)
                             bt (primitive/alloc-stack BoundTrait)]
                         (if (= (sx-tag raw) 2)
                             (do
                               (set! (.name bt) (lexical-name a raw))
                               (set! (.args bt)
                                     (new-boxed-list [Type] a)))
                             (if (= (sx-tag raw) 6)
                                 (let [parts (sx-items raw)
                                       head
                                         (try! (need [Sexp]
                                                     (sx-get parts 0)
                                                     "bound trait: empty application"))]
                                   (set! (.name bt)
                                         (match (lexical-sym-of a
                                                                head
                                                                "bound trait")
                                           (Ok [temporary]
                                               temporary)
                                           (Err [temporary]
                                                (break
                                                  :try (Err temporary)))))
                                   (store! (field bt args)
                                           (try! (parse-types a
                                                              (rest-from a
                                                                         parts
                                                                         1)))))
                                 (break
                                   :try
                                     (Err [TPEntry Diag]
                                          (derr-at (sx-lo raw)
                                                   (sx-hi raw)
                                                   "bound trait must be a name or (Trait AssociatedType…)")))))
                         (push! (mut traits) (load bt))))
                     (Ok (mk-tpentry a
                                     pname
                                     (box-al a (load traits)))))
                   (Err [TPEntry Diag]
                        (derr-at (sx-lo entry)
                                 (sx-hi entry)
                                 "type parameter must be a name, (name Trait…) or (const name Type)")))))))

(defstruct TPResult
  [(params (ptr (ArrayList (slice u8))))
   (bounds (ptr (ArrayList Bound)))
   (consumed bool)])

(defn parse-type-params [(a (dyn Allocator))
                         (rest (ptr (ArrayList Sexp)))
                         (i i64)] (-> (Result TPResult Diag))
  (try (let [a0 (sx-get rest i)
             a1 (sx-get rest (primitive/iadd i 1))]
         (if (not (and (opt-is-vec a0) (opt-is-vec a1)))
             (Ok (let [(mut r) (zeroed TPResult)]
                   (set! (.params r)
                         (new-boxed-list [(slice u8)] a))
                   (set! (.bounds r)
                         (new-boxed-list [Bound] a))
                   (set! (.consumed r) false)
                   r))
             (let [tp (sx-items (opt-get a0))
                   (mut params) (ArrayList::new [(slice u8)] a)
                   (mut bounds) (ArrayList::new [Bound] a)
                   n (sx-len tp)
                   (mut k) 0]
               (loop (if (>= (load k) n)
                         (break)
                         (let [entry (sx-at tp (load k))]
                           (set! k (primitive/iadd (load k) 1))
                           (let [ep (primitive/alloc-stack TPEntry)]
                             (set! ep
                                   (match (parse-tparam-entry a entry)
                                     (Ok [value] value)
                                     (Err [error] (break :try (Err error)))))
                             (push! (mut params) (.name ep))
                             (match (tpentry-bound ep)
                               (Some [b] (do (push! (mut bounds) b) 0))
                               (None [] 0))))))
               (Ok (let [(mut r) (zeroed TPResult)]
                     (set! (.params r) (box-al a (load params)))
                     (set! (.bounds r) (box-al a (load bounds)))
                     (set! (.consumed r) true)
                     r)))))))

; ---- quasiquote ----
(defn build-quasi-seq [(a (dyn Allocator))
                       (items (ptr (ArrayList Sexp)))
                       (isvec bool)] (-> (Result Quasi Diag))
  (try (let [(mut out) (ArrayList::new [Quasi] a)
             n (sx-len items)]
         (for [i 0 n]
           (push! (mut out)
                  (match (build-quasi a (sx-at items i))
                    (Ok [temporary] temporary)
                    (Err [temporary] (break :try (Err temporary))))))
         (Ok (if isvec
                 (QVector (box-al a (load out)))
                 (QList (box-al a (load out))))))))

(defn build-quasi [(a (dyn Allocator)) (s Sexp)] (-> (Result Quasi Diag))
  (let [tg (sx-tag s)]
    (if (= tg 6)
        (let [items (sx-items s)]
          (if (= (sx-len items) 2)
              (let [h (sx-at items 0)]
                (if (= (sx-tag h) 2)
                    (let [hs (sx-sval h)]
                      (if (= hs "unquote")
                          (match (parse-expr a (sx-at items 1))
                            (Err [d] (Err d))
                            (Ok [e] (Ok (QUnquote (box-expr a e)))))
                          (if (= hs "unquote-splicing")
                              (match (parse-expr a (sx-at items 1))
                                (Err [d] (Err d))
                                (Ok [e] (Ok (QSplice (box-expr a e)))))
                              (build-quasi-seq a items false))))
                    (build-quasi-seq a items false)))
              (build-quasi-seq a items false)))
        (if (= tg 7)
            (build-quasi-seq a (sx-items s) true)
            (Ok (QLit (box-sexp a s)))))))

; ---- expressions ----
(defn mk-bin [(a (dyn Allocator))
              (args (ptr (ArrayList Sexp)))
              (head (slice u8))
              (op i64)] (-> (Result ExprKind Diag))
  (try (let [(mut tp)
               (: (match (need-two a args head)
                    (Ok [value] value)
                    (Err [error] (break :try (Err error))))
                  Two)]
         (Ok (EBin
               :op op
               :lhs (box-expr a (try! (parse-expr a (.x tp))))
               :rhs (box-expr a (try! (parse-expr a (.y tp)))))))))

(defn mk-cmp [(a (dyn Allocator))
              (args (ptr (ArrayList Sexp)))
              (head (slice u8))
              (op i64)] (-> (Result ExprKind Diag))
  (try (let [(mut tp)
               (: (match (need-two a args head)
                    (Ok [value] value)
                    (Err [error] (break :try (Err error))))
                  Two)]
         (Ok (ECmp
               :op op
               :lhs (box-expr a (try! (parse-expr a (.x tp))))
               :rhs (box-expr a (try! (parse-expr a (.y tp)))))))))

(defn binop-of [(h (slice u8))] (-> i64)
  (cond (= h "iadd") 0
        (= h "isub") 1
        (= h "imul") 2
        (= h "idiv") 3
        (= h "irem") 4
        (= h "udiv") 5
        (= h "urem") 6
        (= h "iand") 7
        (= h "ior") 8
        (= h "ixor") 9
        (= h "ishl") 10
        (= h "ishr") 11
        (= h "rotl") 12
        (= h "rotr") 13
        (= h "mulhi") 14
        (= h "iadd-overflow?") 15
        (= h "isub-overflow?") 16
        (= h "imul-overflow?") 17
        (= h "fadd") 0
        (= h "fsub") 1
        (= h "fmul") 2
        (= h "fdiv") 3
        (= h "frem") 4
        :else -1))

;;; In a static assertion's folded condition: 1 when the integer overflow test OP
;;; (15, 16, 17: `iadd-overflow?`, `isub-overflow?`, `imul-overflow?`) holds for L
;;; and R, else 0. A condition folds in 64-bit arithmetic, so a narrower type's
;;; overflow is judged at 64 bits, as its sum is computed. Every backend folds
;;; conditions with this; it is what makes coil.safety's checked operators, whose
;;; bodies test before they compute, usable in an assertion.
(defn const-overflow-test [(op i64) (l i64) (r i64) (uns bool)] (-> i64)
  (let [overflows
          (cond (= op 15)
                  (let [sum (primitive/iadd l r)]
                    (if uns
                        (< (primitive/cast u64 sum) (primitive/cast u64 l))
                        (< (& (^ l sum) (^ r sum))
                           0)))
                (= op 16)
                  (if uns
                      (< (primitive/cast u64 l) (primitive/cast u64 r))
                      (< (& (^ l r) (^ l (primitive/isub l r)))
                         0))
                uns
                  (and (!= l 0) (!= (primitive/udiv (primitive/imul l r) l) r))
                (= l 0) false
                ; MIN / -1 itself overflows the division that checks it
                (= l -1) (= r (<< 1 63))
                :else (!= (/ (primitive/imul l r) l) r))]
    (if overflows 1 0)))

(defn cmpop-of [(h (slice u8))] (-> i64)
  (cond (= h "fcmp-lt") 0
        (= h "fcmp-le") 1
        (= h "fcmp-gt") 2
        (= h "fcmp-ge") 3
        (= h "fcmp-eq") 4
        (= h "fcmp-ne") 5
        (= h "icmp-lt") 0
        (= h "icmp-le") 1
        (= h "icmp-gt") 2
        (= h "icmp-ge") 3
        (= h "icmp-eq") 4
        (= h "icmp-ne") 5
        :else -1))

(defn codeop-of [(h (slice u8))] (-> i64)
  (codeops/generic-number h))

;;; The code operation number of OPCODE, a primitive's lowering keyword: the
;;; ECodeOp the parser builds for a call of it, or -1 when OPCODE is not a code
;;; operation. The heads parse-list-expr gives an arity check of their own are
;;; numbered here with the rest, so each number is spelled once.
(defn codeop-number [(h (slice u8))] (-> i64)
  (codeops/operation-number h))

;;; The most code operation numbers the answer table holds.
(const CODEOP-ANSWER-SLOTS 256)

;;; Record, for each primitive in DEFS that declares the sum it answers with, that
;;; sum as its code operation's static type in this unit. Module resolution installs
;;; the primitives whenever it computes the bindings a parse dispatches on, so every
;;; code operation the parser builds has its answer recorded; the checker
;;; (codeop-rty) and metalower read the table.
(defn codeop-answers-install! [(defs (ptr (ArrayList PrimitiveDef)))] (-> i64)
  (let [table (field (parser-unit-state) codeop_answers)]
    (for [i 0 (len (load defs))]
      (let [p (elem defs i)]
        (when (> (len (.result p)) 0)
          (let [op (codeop-number (.opcode p))]
            (when (or (< op 0) (>= op CODEOP-ANSWER-SLOTS))
              (let [w (stderr)]
                (ps w "internal error: primitive '")
                (ps w (.name p))
                (ps w
                    "' declares the sum it answers with, but is not a numbered code operation\n")
                (abort)))
            (let [slot (index table op)]
              (when (!= (load slot) (.result p))
                (set! slot (text/format (unit-allocator) "{}" (.result p)))
                0)))
          0)))
    0))

;;; The qualified sum code operation OP answers with in this unit, if its primitive
;;; declares one.
(defn codeop-answer [(op i64)] (-> (Option (slice u8)))
  (if (or (< op 0) (>= op CODEOP-ANSWER-SLOTS))
      (None [(slice u8)])
      (let [q (load (index (field (parser-unit-state) codeop_answers) op))]
        (if (= (len q) 0) (None [(slice u8)]) (Some q)))))

(defn typequery-of [(h (slice u8))] (-> i64)
  (cond (= h "field-count") 0
        (= h "variant-count") 1
        (= h "struct?") 2
        (= h "sum?") 3
        (= h "int?") 4
        (= h "float?") 5
        (= h "ptr?") 6
        (= h "array?") 7
        :else -1))

(defn fieldmeta-of [(h (slice u8))] (-> i64)
  (cond (= h "field-name") 0
        (= h "field-type-kind") 1
        (= h "field-type-name") 2
        :else -1))

(defn static-element-value [(a (dyn Allocator)) (form Sexp)]
  (-> (Result Expr Diag))
  (if (and (= (sx-tag form) 6)
           (let [parts (sx-items form)]
             (and (> (sx-len parts) 0)
                  (and (= (sx-tag (sx-at parts 0)) 3)
                       (= (sx-sval (sx-at parts 0)) "elements")))))
      (let [parts (sx-items form)]
        (if (= (sx-len parts) 2)
            (static-elements a (sx-at parts 1))
            (Err (derr "nested :elements expects exactly one entry vector"))))
      (parse-expr a form)))

(defn static-elements [(a (dyn Allocator)) (form Sexp)] (-> (Result Expr Diag))
  (try (let [entries
               (try! (need-vec (Some form)
                               "alloc-static :elements expects an entry vector"))
             (mut indices) (ArrayList::new [i64] a)
             (mut items) (ArrayList::new [Expr] a)]
         (for [i 0 (sx-len entries)]
           (let [entry (sx-at entries i)]
             (unless (= (sx-tag entry) 6)
               (break
                 :try
                   (Err (derr "alloc-static :elements expects (INDEX VALUE) entries")))
               0)
             (let [pair (sx-items entry)]
               (unless (= (sx-len pair) 2)
                 (break
                   :try
                     (Err (derr "alloc-static :elements expects (INDEX VALUE) entries")))
                 0)
               (push! (mut indices)
                      (try! (int-val a (sx-at pair 0) "static element index")))
               (push! (mut items)
                      (try! (static-element-value a (sx-at pair 1))))))
           0)
         (Ok (mk-expr (EStaticArray (box-al a (load indices))
                                    (box-al a (load items)))
                      (sx-lo form)
                      (sx-hi form)
                      (sx-source form)
                      (sx-ctxt form))))))

(defn alloc-form [(a (dyn Allocator))
                  (args (ptr (ArrayList Sexp)))
                  (storage i64)] (-> (Result ExprKind Diag))
  (try (let [n (sx-len args)]
         (unless (and (>= n 1) (or (= storage 1) (= n 1)))
           (break
             :try
               (Err (derr "alloc: expects TYPE; only alloc-static accepts an initializer or :as linker name")))
           0)
         (let [ty (try! (parse-type a (sx-at args 0)))
               (mut init) (primitive/cast (ptr Expr) 0)
               (mut symbol) (None [(slice u8)])
               (mut named) false
               (mut index) 1]
           (loop (when (>= (load index) n) (break))
             (let [form (sx-at args (load index))]
               (if (= (sx-tag form) 3)
                   (let [keyword (sx-sval form)]
                     (unless (< (+ (load index) 1) n)
                       (break
                         :try
                           (Err (derr "alloc-static: option requires a value")))
                       0)
                     (cond (= keyword "as")
                             (do
                               (when (load named)
                                 (break
                                   :try
                                     (Err (derr "alloc-static: duplicate :as")))
                                 0)
                               (let [value (sx-at args (+ (load index) 1))]
                                 (unless (= (sx-tag value) 4)
                                   (break
                                     :try
                                       (Err (derr "alloc-static :as requires a literal linker-name string")))
                                   0)
                                 (let [name (sx-sval value)]
                                   (unless (> (len name) 0)
                                     (break
                                       :try
                                         (Err (derr "alloc-static :as requires a nonempty linker name")))
                                     0)
                                   (for [j 0 (len name)]
                                     (when (< (primitive/cast i64 (get name j))
                                              32)
                                       (break
                                         :try
                                           (Err (derr "alloc-static :as linker name contains a control byte")))
                                       0)
                                     0)
                                   (set! symbol (Some name))
                                   (set! named true))))
                           (= keyword "elements")
                             (do
                               (unless (= (primitive/cast i64 (load init)) 0)
                                 (break
                                   :try
                                     (Err (derr "alloc-static: duplicate initializer")))
                                 0)
                               (set! init
                                     (box-expr a
                                               (try! (static-elements a
                                                                      (sx-at args
                                                                             (+ (load index)
                                                                                1)))))))
                           :else
                             (break
                               :try
                                 (Err (derr "alloc-static: expected :as or :elements"))))
                     (set! index (+ (load index) 2)))
                   (do
                     (unless (= (primitive/cast i64 (load init)) 0)
                       (break
                         :try (Err (derr "alloc-static: duplicate initializer")))
                       0)
                     (set! init (box-expr a (try! (parse-expr a form))))
                     (set! index (+ (load index) 1))))))
           (Ok (EAlloc
                 :storage storage
                 :ty ty
                 :init (load init)
                 :symbol (load symbol)))))))

(defn parse-exprs [(a (dyn Allocator)) (items (ptr (ArrayList Sexp)))]
  (-> (Result (ptr (ArrayList Expr)) Diag))
  (try (let [(mut out) (ArrayList::new [Expr] a)
             n (sx-len items)]
         (reserve! (mut out) n)
         (for [i 0 n]
           (push! (mut out)
                  (match (parse-expr a (sx-at items i))
                    (Ok [temporary] temporary)
                    (Err [temporary] (break :try (Err temporary))))))
         (Ok (box-al a (load out))))))

; ---- recursion depth guard --------------------------------------------------
; The parser recurses once per nesting LEVEL, and each level is expensive (~75 KB of
; stack: parse-expr-inner is one big match whose per-branch allocas are all hoisted to
; the entry block, so every call pays for every branch). Deeply nested input therefore
; ran off the end of the stack and killed the compiler with a bare SIGBUS/SIGSEGV and
; ZERO output — no message, no location, nothing naming the construct.
;
; Macros make this ordinary rather than exotic: `cond` expands to nested ifs, so an
; 800-clause dispatch table is 800 levels deep, and a derive over a wide struct nests
; the same way. This is a compiler whose whole purpose is generating code, so the depth
; ceiling is a real limit and it must announce itself instead of crashing.
;
; The counter is process-global rather than threaded through every parse entry point:
; the pipeline parses on one thread at a time. The limit sits well under the measured
; stack cliff (see run-on-big-stack) so the diagnostic always wins the race.
(defn parse-depth-cell [] (-> (ptr i64))
  (field (parser-unit-state) depth))

(defn parse-depth-limit [] (-> i64)
  2000)

(defn parse-expr [(a (dyn Allocator)) (s Sexp)] (-> (Result Expr Diag))
  (let [d (parse-depth-cell)]
    (set! d (primitive/iadd (load d) 1))
    (if (> (load d) (parse-depth-limit))
        (do
          (set! d (primitive/isub (load d) 1))
          (Err (derr-at (sx-lo s)
                        (sx-hi s)
                        "expression nests more than 2000 levels deep — the parser recurses per level and would run out of stack. If this came from a macro, emit a flatter form (e.g. a jump table or a loop over a data table) instead of one deeply nested expression.")))
        ; the decrement is repeated per arm rather than hoisted into a `let`. gen-9 fixed
        ; the underlying inference hole — a returned let binding now takes the function's
        ; return type `(Result Expr Diag)`, so `(let [r (match …)] (primitive/store! d …) r)` would
        ; type-check under THIS compiler — but the self-host source must stay buildable by
        ; the committed pre-gen-9 seed (rebootstrap stage0), which cannot infer it. Keep the
        ; per-arm form until the seed is refreshed past this commit.
        (match (parse-expr-inner a s)
          (Err [dg]
               (do
                 (set! d (primitive/isub (load d) 1))
                 (Err (dwspan dg (sx-source s) (sx-lo s) (sx-hi s) (sx-ctxt s)))))
          (Ok [kind]
              (do
                (set! d (primitive/isub (load d) 1))
                (let [node
                        (if (= (sx-tag s) 6)
                            (if (> (sx-len (sx-items s)) 0)
                                (sx-at (sx-items s) 0)
                                s)
                            s)]
                  (match kind
                    (EVar [_] (source-site-record! s s "value"))
                    (ECall [_ _ _] (source-site-record! s node "call"))
                    (ENamedCall [_ _ _ _] (source-site-record! s node "call"))
                    (EFnPtrOf [_]
                              (when (> (sx-len (sx-items s)) 1)
                                (source-site-record! s
                                                     (sx-at (sx-items s) 1)
                                                     "fnptr")
                                0))
                    (EFnPtrInst [_ _]
                                (when (> (sx-len (sx-items s)) 1)
                                  (source-site-record! s
                                                       (sx-at (sx-items s) 1)
                                                       "fnptr")
                                  0))
                    (_ 0)))
                (when (!= (& (sx-hflags s) 2) 0)
                  (shadow-note! (sx-source s) (sx-node-id s)))
                (Ok (mk-expr-node-id kind
                                     (sx-lo s)
                                     (sx-hi s)
                                     (sx-source s)
                                     (sx-ctxt s)
                                     (sx-node-id s)))))))))

;;; An integer literal too wide for an i64 -- `18446744073709551615`,
;;; `0x1_0000_0000_0000_0000` -- as an EWideInt: an optional sign, an optional
;;; `0x`/`0o`/`0b` radix prefix, and digits with `_` only between them, whose
;;; magnitude fits 128 bits. None for anything else.
(defn parse-wide-int [(text (slice u8))] (-> (Option ExprKind))
  (let [n (len text)
        neg (and (> n 0) (= (primitive/cast i64 (get text 0)) 45))
        start
          (if (and (> n 0) (or neg (= (primitive/cast i64 (get text 0)) 43)))
              1
              0)
        prefixed
          (and (>= (- n start) 2)
               (= (primitive/cast i64 (get text start)) 48)
               (let [c (primitive/cast i64 (get text (+ start 1)))]
                 (or (= c 120) (= c 88) (= c 111) (= c 79) (= c 98) (= c 66))))
        radix
          (if prefixed
              (let [c (primitive/cast i64 (get text (+ start 1)))]
                (cond (or (= c 120) (= c 88)) 16
                      (or (= c 111) (= c 79)) 8
                      :else 2))
              10)
        digits (if prefixed (+ start 2) start)
        ; the magnitude as four 32-bit limbs, least significant first
        (mut limbs) (zeroed (array i64 4))
        (mut seen) 0
        (mut last-digit) false]
    (block :parse
      (when (>= digits n) (break :parse (None [ExprKind])))
      (for [i digits n]
        (let [c (primitive/cast i64 (get text i))
              d
                (cond (and (>= c 48) (<= c 57)) (- c 48)
                      (and (>= c 97) (<= c 102)) (- c 87)
                      (and (>= c 65) (<= c 70)) (- c 55)
                      :else -1)]
          (cond (= c 95)
                  ; `_` separates digits: not first, not last, never doubled
                  (unless (and last-digit (< (+ i 1) n))
                    (break :parse (None [ExprKind])))
                (or (< d 0) (>= d radix)) (break :parse (None [ExprKind]))
                :else
                  (let [(mut carry) d]
                    (for [k 0 4]
                      (let [v (+ (* (get limbs k) radix) carry)]
                        (set! (mut limbs) k (& v 4294967295))
                        (set! carry (>> v 32))))
                    (unless (= carry 0) (break :parse (None [ExprKind])))
                    (set! seen (+ seen 1))))
          (set! last-digit (!= c 95))))
      (when (= seen 0) (break :parse (None [ExprKind])))
      (Some (EWideInt
              :neg neg
              :lo (| (get limbs 0) (<< (get limbs 1) 32))
              :hi (| (get limbs 2) (<< (get limbs 3) 32))
              :radix prefixed
              :text text)))))

(defn parse-expr-inner [(a (dyn Allocator)) (s Sexp)]
  (-> (Result ExprKind Diag))
  (let [tg (sx-tag s)
        slo (sx-lo s)
        shi (sx-hi s)]
    (cond (= tg 0) (Ok (EInt (sx-ival s)))
          (= tg 1) (Ok (EFloat (sx-ival s)))
          (= tg 2)
            (let [nm (sx-sval s)]
              (if (= nm "true")
                  (Ok (EBool true))
                  (if (= nm "false")
                      (Ok (EBool false))
                      (if (and (>= (len nm) 3)
                               (= (primitive/cast i64 (get nm 0)) 35)
                               (= (primitive/cast i64 (get nm 1)) 92))
                          (let [body (subslice nm 2 (len nm))
                                v
                                  (cond (= (len body) 1)
                                          (primitive/cast i64 (get body 0))
                                        ; `#\λ`: one character spelled as its
                                        ; UTF-8 bytes, which the reader keeps
                                        ; together as one token
                                        (>= (primitive/cast i64 (get body 0))
                                            128)
                                          (utf8-decode body)
                                        :else (char-name-code body))]
                            (if (< v 0)
                                (Err (derr-at slo
                                              shi
                                              "unknown character literal"))
                                (Ok (EInt v))))
                          ; The reader keeps an integer an i64 cannot hold as a
                          ; symbol; one that fits 128 bits is a wide literal.
                          (match (parse-wide-int nm)
                            (Some [w] (Ok w))
                            (None [] (Ok (EVar (lexical-name a s)))))))))
          (= tg 3)
            ; Keywords are ordinary values. Lower the literal through core's
            ; nominal Keyword constructor so every later phase sees normal Coil
            ; code rather than a second, compiler-private value representation.
            (let [(mut args) (ArrayList::new [Expr] a)]
              (push! (mut args)
                     (mk-expr (EStr (sx-sval s))
                              slo
                              shi
                              (sx-source s)
                              (sx-ctxt s)))
              (Ok (ECall
                    :func (core-name "KeywordValue")
                    :type_args (new-boxed-list [Type] a)
                    :args (box-al a (load args)))))
          (= tg 4) (Ok (EStr (sx-sval s)))
          (= tg 5) (Ok (ECStr (sx-sval s)))
          (= tg 7)
            (match (parse-exprs a (sx-items s))
              (Err [d] (Err [ExprKind Diag] d))
              (Ok [items] (Ok (EArrayLit items))))
          :else
            (parse-list-expr a (sx-items s) slo shi (sx-source s) (sx-ctxt s)))))

; A leading:label keyword.
(defstruct LabelSplit
  [(label (Option (slice u8))) (rest (ptr (ArrayList Sexp)))])

(defn split-label [(a (dyn Allocator)) (args (ptr (ArrayList Sexp)))]
  (-> LabelSplit)
  (let [r (primitive/alloc-stack LabelSplit)]
    (if (and (> (sx-len args) 0)
             (= (sx-tag (sx-at args 0)) 3))
        (do
          (set! (.label r) (Some (sx-sval (sx-at args 0))))
          (set! (.rest r) (rest-from a args 1)))
        (do (set! (.label r) (None [(slice u8)])) (set! (.rest r) args)))
    (load r)))

; ---- loops, blocks and the targets of break/continue -------------------------
; `(block* :label body…)` evaluates its body and yields the last value; only a
; `(break :label value)` leaves it early. It is the same labelled one-pass loop
; `(loop :label (break :label (do body…)))` -- but an UNLABELED break or continue
; inside it belongs to the nearest enclosing `loop`, not to the block. Without that,
; every macro built on a block (`block`, `scope`, a match with nested patterns)
; captured the `(break)` a user wrote inside it, and the user's loop never ended.
;
; The parser tracks the loops and blocks around the expression it is parsing, back
; to the enclosing function, and gives such a break or continue the label of the loop
; it reaches. A loop with no label of its own is given one that source cannot spell.
; A defer's cleanup runs on the way out of the forms it guards, so a break or
; continue inside it may only reach loops and blocks inside the cleanup itself:
; `ScopeCleanup` is the wall it cannot cross.
(defsum LoopScopeKind (ScopeLoop) (ScopeBlock) (ScopeFunction) (ScopeCleanup))

(defstruct LoopScope
  [(kind LoopScopeKind)
   (label (Option (slice u8)))
   ; a label given to an unlabeled loop that a break inside a block needs to name
   (given (Option (slice u8)))])

(defstruct LoopScopes [(ready bool) (count i64) (items (ArrayList LoopScope))])

(defn loop-scopes [] (-> (ptr LoopScopes))
  (let [c (primitive/alloc-static LoopScopes)]
    (unless (.ready c)
      (set! (.items c) (ArrayList::new [LoopScope] (malloc-allocator)))
      (set! (.ready c) true))
    c))

(defn push-loop-scope! [(kind LoopScopeKind) (label (Option (slice u8)))]
  (-> i64)
  (push! (mut (.items (loop-scopes)))
         (LoopScope
           :kind kind
           :label label
           :given (None [(slice u8)])))
  0)

;;; Pop the innermost scope, returning it so a loop can read the label it was given.
(defn pop-loop-scope! [] (-> LoopScope)
  (match (pop! (mut (.items (loop-scopes))))
    (Some [top] top)
    ; every pop is paired with a push in this file; reaching here is a compiler bug
    (None []
          (do
            (abort)
            (LoopScope
              :kind (ScopeFunction)
              :label (None [(slice u8)])
              :given (None [(slice u8)]))))))

(defn scope-block? [(s LoopScope)] (-> bool)
  (match (.kind s) (ScopeBlock [] true) (_ false)))

(defn scope-loop? [(s LoopScope)] (-> bool)
  (match (.kind s) (ScopeLoop [] true) (_ false)))

(defn scope-cleanup? [(s LoopScope)] (-> bool)
  (match (.kind s) (ScopeCleanup [] true) (_ false)))

(defn cleanup-escape-diag [(a (dyn Allocator))
                           (what (slice u8))
                           (slo i64)
                           (shi i64)] (-> Diag)
  (derr-at slo
           shi
           (text/format a
                        "{} cannot leave a (defer …) cleanup; a cleanup runs on the way out and must finish"
                        what)))

;;; Whether a break or continue to `label` would leave a defer cleanup: the
;;; cleanup's wall comes before any loop or block with that label.
(defn label-leaves-cleanup? [(label (slice u8))] (-> bool)
  (let [c (loop-scopes)
        (mut i) (- (len (.items c)) 1)
        (mut leaves) false]
    (while (>= i 0)
      (let [sc (get (.items c) i)]
        (cond (scope-cleanup? sc) (do (set! leaves true) (set! i -1))
              (match (.kind sc) (ScopeFunction [] true) (_ false)) (set! i -1)
              (match (.label sc) (Some [l] (= l label)) (None [] false))
                (set! i -1)
              :else (set! i (- i 1)))))
    leaves))

;;; The label an unlabeled break or continue at this point must carry: None when
;;; the innermost scope is a loop (the plain meaning), or the label of the nearest
;;; loop past the blocks around it.
(defn unlabeled-target [(a (dyn Allocator))
                        (what (slice u8))
                        (slo i64)
                        (shi i64)] (-> (Result (Option (slice u8)) Diag))
  (let [c (loop-scopes)
        n (len (.items c))]
    (if (or (= n 0) (not (scope-block? (get (.items c) (- n 1)))))
        (if (and (> n 0) (scope-cleanup? (get (.items c) (- n 1))))
            (Err [(Option (slice u8)) Diag]
                 (cleanup-escape-diag a what slo shi))
            (Ok (None [(slice u8)])))
        (let [(mut i) (- n 1)]
          (while (and (>= i 0) (scope-block? (get (.items c) i)))
            (set! i (- i 1)))
          (if (or (< i 0) (not (scope-loop? (get (.items c) i))))
              (Err [(Option (slice u8)) Diag]
                   (if (and (>= i 0) (scope-cleanup? (get (.items c) i)))
                       (cleanup-escape-diag a what slo shi)
                       (derr-at slo
                                shi
                                (text/format a
                                             "{} inside a block has no enclosing loop; leave the block with (return-from :label value)"
                                             what))))
              (let [target (get (.items c) i)]
                (match (.label target)
                  (Some [l]
                        (if (block-label-between? c i l)
                            (Err [(Option (slice u8)) Diag]
                                 (derr-at slo
                                          shi
                                          (text/format a
                                                       "{} inside a block labelled :{} cannot reach the enclosing loop with the same label; rename one"
                                                       what
                                                       l)))
                            (Ok (Some l))))
                  (None []
                        (match (.given target)
                          (Some [l] (Ok (Some l)))
                          (None []
                                (let [l (given-loop-label a)]
                                  (set! (.given (elem (field c items) i))
                                        (Some l))
                                  (Ok (Some l)))))))))))))

;;; Whether a block above scope `i` carries label `l`, shadowing the loop's.
(defn block-label-between? [(c (ptr LoopScopes)) (i i64) (l (slice u8))]
  (-> bool)
  (let [(mut found) false]
    (for k (range (+ i 1) (len (.items c)))
      (match (.label (get (.items c) k))
        (Some [m] (when (= m l) (set! found true)))
        (None [] 0)))
    found))

;;; A fresh label for an unlabeled loop. It contains a space, which no keyword
;;; can, so it never meets a label from source.
(defn given-loop-label [(a (dyn Allocator))] (-> (slice u8))
  (let [c (loop-scopes)]
    (set! (.count c) (+ (.count c) 1))
    (text/format a "loop {}" (i64->str a (.count c)))))

;;; Parse a function body: break and continue inside it cannot reach loops outside.
(defn parse-function-body [(a (dyn Allocator)) (items (ptr (ArrayList Sexp)))]
  (-> (Result (ptr (ArrayList Expr)) Diag))
  (push-loop-scope! (ScopeFunction) (None [(slice u8)]))
  (let [body (parse-body a items)]
    (pop-loop-scope!)
    body))

; ---- defer ---------------------------------------------------------------------
; `(defer* cleanup)` is a form of a BODY: the forms of a function, `let`, `do`,
; `loop`, `block*` or match-arm body, and so of every macro that expands to one
; (`when`, `for`, `block`, `scope`, ...). It guards the forms after it in that body:
; once control has reached it, `cleanup` runs when control leaves the body, by
; falling off its end or by any break, continue or return-from that leaves it --
; including the ones a macro such as `try!` writes. Several defers in one body run
; last-registered first, and an inner body's defers run before an outer one's.
; The parser records the guarded forms as `(EDefer cleanup rest)`; ownership
; elaboration places the cleanup at each exit, in order with the drops there.
(defn defer-form? [(s Sexp)] (-> bool)
  (and (= (sx-tag s) 6)
       (let [items (sx-items s)]
         (and (> (sx-len items) 0)
              (let [h (sx-at items 0)]
                (and (= (sx-tag h) 2)
                     (= (sx-sval h) "defer*")))))))

;;; Parse a defer's cleanup. Nothing in it may break or continue past it.
(defn parse-defer-cleanup [(a (dyn Allocator)) (s Sexp)] (-> (Result Expr Diag))
  (let [items (sx-items s)]
    (if (!= (sx-len items) 2)
        (Err (dwspan (derr-at (sx-lo s)
                              (sx-hi s)
                              "defer: expects exactly one cleanup form, (defer cleanup)")
                     (sx-source s)
                     (sx-lo s)
                     (sx-hi s)
                     (sx-ctxt s)))
        (do
          (push-loop-scope! (ScopeCleanup) (None [(slice u8)]))
          (let [cleanup (parse-expr a (sx-at items 1))]
            (pop-loop-scope!)
            cleanup)))))

;;; Parse the forms of a body, folding each `(defer* cleanup)` and the forms after
;;; it into one `EDefer`.
(defn parse-body [(a (dyn Allocator)) (items (ptr (ArrayList Sexp)))]
  (-> (Result (ptr (ArrayList Expr)) Diag))
  (try (let [(mut out) (ArrayList::new [Expr] a)
             n (sx-len items)
             (mut i) 0]
         (reserve! (mut out) n)
         (while (< i n)
           (let [s (sx-at items i)]
             (if (defer-form? s)
                 (do
                   (when (= (+ i 1) n)
                     (break
                       :try
                         (Err [(ptr (ArrayList Expr)) Diag]
                              (dwspan (derr-at (sx-lo s)
                                               (sx-hi s)
                                               "defer: nothing follows it to guard; (defer cleanup) runs cleanup when control leaves the forms after it, so as the last form of a body it would run at once")
                                      (sx-source s)
                                      (sx-lo s)
                                      (sx-hi s)
                                      (sx-ctxt s)))))
                   (let [cleanup (try! (parse-defer-cleanup a s))
                         rest (try! (parse-body a (rest-from a items (+ i 1))))]
                     (push! (mut out)
                            (mk-expr-node-id (EDefer (box-expr a cleanup) rest)
                                             (sx-lo s)
                                             (sx-hi s)
                                             (sx-source s)
                                             (sx-ctxt s)
                                             (sx-node-id s))))
                   (set! i n))
                 (do
                   (push! (mut out) (try! (parse-expr a s)))
                   (set! i (+ i 1))))))
         (Ok (box-al a (load out))))))

(defn parse-loop [(a (dyn Allocator))
                  (args (ptr (ArrayList Sexp)))
                  (slo i64)
                  (shi i64)] (-> (Result ExprKind Diag))
  (let [lr (split-label a args)]
    (push-loop-scope! (ScopeLoop) (.label lr))
    (let [parsed (parse-body a (.rest lr))
          scope (pop-loop-scope!)]
      (match parsed
        (Err [d] (Err [ExprKind Diag] d))
        (Ok [body]
            (if (= (len (load body)) 0)
                (Err [ExprKind Diag]
                     (derr-at slo shi "loop: expects (loop [:label] body...)"))
                (Ok (ELoop (match (.given scope)
                             (Some [l] (Some l))
                             (None [] (.label lr)))
                           body))))))))

(defn parse-block [(a (dyn Allocator))
                   (args (ptr (ArrayList Sexp)))
                   (slo i64)
                   (shi i64)
                   (ssrc i64)
                   (sctxt i64)] (-> (Result ExprKind Diag))
  (let [lr (split-label a args)]
    (match (.label lr)
      (None []
            (Err [ExprKind Diag]
                 (derr-at slo shi "block*: expects (block* :label body...)")))
      (Some [label]
            (push-loop-scope! (ScopeBlock) (.label lr))
            (let [parsed (parse-body a (.rest lr))]
              (pop-loop-scope!)
              (match parsed
                (Err [d] (Err [ExprKind Diag] d))
                (Ok [body]
                    (let [out (new-boxed-list [Expr] a)
                          value (mk-expr (EDo body) slo shi ssrc sctxt)]
                      (push! out
                             (mk-expr (EBreak (Some label)
                                              (Some (box-expr a value)))
                                      slo
                                      shi
                                      ssrc
                                      sctxt))
                      (Ok (ELoop (Some label) out))))))))))

(defn parse-break [(a (dyn Allocator))
                   (args (ptr (ArrayList Sexp)))
                   (slo i64)
                   (shi i64)] (-> (Result ExprKind Diag))
  (let [lr (split-label a args)
        r (.rest lr)]
    (if (> (sx-len r) 1)
        (Err [ExprKind Diag]
             (derr-at slo shi "break: expects (break [:label] [value])"))
        (let [label
                (match (.label lr)
                  (Some [l]
                        (if (label-leaves-cleanup? l)
                            (Err [(Option (slice u8)) Diag]
                                 (cleanup-escape-diag a "break" slo shi))
                            (Ok [(Option (slice u8)) Diag] (Some l))))
                  (None [] (unlabeled-target a "break" slo shi)))]
          (match label
            (Err [d] (Err [ExprKind Diag] d))
            (Ok [l]
                (match (sx-get r 0)
                  (Some [e]
                        (match (parse-expr a e)
                          (Err [d] (Err [ExprKind Diag] d))
                          (Ok [v] (Ok (EBreak l (Some (box-expr a v)))))))
                  (None [] (Ok (EBreak l (None [(ptr Expr)])))))))))))

(defn parse-continue [(a (dyn Allocator))
                      (args (ptr (ArrayList Sexp)))
                      (slo i64)
                      (shi i64)] (-> (Result ExprKind Diag))
  (let [lr (split-label a args)]
    (if (> (sx-len (.rest lr)) 0)
        (Err [ExprKind Diag]
             (derr-at slo shi "continue: expects (continue [:label])"))
        (match (.label lr)
          (Some [l]
                (if (label-leaves-cleanup? l)
                    (Err [ExprKind Diag]
                         (cleanup-escape-diag a "continue" slo shi))
                    (Ok (EContinue (Some l)))))
          (None []
                (match (unlabeled-target a "continue" slo shi)
                  (Err [d] (Err [ExprKind Diag] d))
                  (Ok [l] (Ok (EContinue l)))))))))

; (let [binds...] body...) — `let` arm.
(defn parse-let [(a (dyn Allocator))
                 (args (ptr (ArrayList Sexp)))
                 (slo i64)
                 (shi i64)] (-> (Result ExprKind Diag))
  (try (let [bvo (sx-get args 0)]
         (when (not (opt-is-vec bvo))
           (break
             :try
               (Err [ExprKind Diag]
                    (derr-at slo shi "let: expected binding vector"))))
         (let [bv (sx-items (opt-get bvo))
               nb (sx-len bv)]
           (when (not (= (primitive/urem nb 2) 0))
             (break
               :try
                 (Err [ExprKind Diag]
                      (derr-at slo
                               shi
                               "let: bindings must be name/value pairs"))))
           (let [(mut binds) (ArrayList::new [Bind] a)
                 (mut k) 0]
             (reserve! (mut binds) (/ nb 2))
             (loop (if (>= (load k) nb)
                       (break)
                       (let [nmf (sx-at bv (load k))
                             vf (sx-at bv (primitive/iadd (load k) 1))]
                         (let [bp (primitive/alloc-stack Bind)]
                           (set! (.bid bp) 0)
                           (set! (.owned_type bp) (primitive/cast (ptr Type) 0))
                           (if (= (sx-tag nmf) 2)
                               (do
                                 (source-nonreference! nmf)
                                 (set! (.name bp) (lexical-name a nmf))
                                 (set! (.mutable bp) false))
                               (if (and (= (sx-tag nmf) 6)
                                        (and (= (sx-len (sx-items nmf))
                                                2)
                                             (= (match (head-sym a
                                                                 (sx-items nmf))
                                                  (Ok [value] value)
                                                  (Err [error]
                                                       (break :try (Err error))))
                                                "mut")))
                                   (do
                                     (let [bn (sx-at (sx-items nmf) 1)]
                                       (source-nonreference! bn)
                                       (match (sym-of a bn "let binding name")
                                         (Ok [_]
                                             (set! (.name bp)
                                                   (lexical-name a bn)))
                                         (Err [error] (break :try (Err error)))))
                                     (set! (.mutable bp) true))
                                   (return-from
                                     :try
                                       (Err [ExprKind Diag]
                                            (derr-at (sx-lo nmf)
                                                     (sx-hi nmf)
                                                     (text/format a
                                                                  "let binding name must be `name` or `(mut name)`, got {}"
                                                                  (sexp-display a
                                                                                nmf)))))))
                           (set! (.value bp)
                                 (match (parse-expr a vf)
                                   (Ok [value] value)
                                   (Err [error] (break :try (Err error)))))
                           (source-binder! (if (= (sx-tag nmf) 2)
                                               nmf
                                               (sx-at (sx-items nmf) 1))
                                           (.node-id (field bp value)))
                           (push! (mut binds) (load bp)))
                         (set! k (primitive/iadd (load k) 2)))))
             (let [body (try! (parse-body a (rest-from a args 1)))]
               (when (= (len (load body)) 0)
                 (break
                   :try
                     (Err [ExprKind Diag]
                          (derr-at slo shi "let: empty body"))))
               (Ok (ELet (box-al a (load binds)) body))))))))

; Anonymous functions intentionally carry no environment. Parameter and return
; types come from the call/type context; the checker reports a direct error when
; the body refers to an enclosing runtime binding.
(defn parse-anon-fn [(a (dyn Allocator))
                     (args (ptr (ArrayList Sexp)))
                     (slo i64)
                     (shi i64)] (-> (Result ExprKind Diag))
  (try (let [pv
               (try! (need-vec (sx-get args 0) "fn: expected parameter vector"))
             n (sx-len pv)
             (mut names) (ArrayList::new [(slice u8)] a)
             (mut i) 0]
         (reserve! (mut names) n)
         (loop (if (>= (load i) n)
                   (break)
                   (let [p (sx-at pv (load i))
                         raw (try! (sym-of a p "fn parameter"))]
                     (when (= raw "...")
                       (break
                         :try
                           (Err [ExprKind Diag]
                                (derr-at (sx-lo p)
                                         (sx-hi p)
                                         "fn: variadic parameters are not supported"))))
                     (let [(mut j) 0]
                       (loop (if (>= (load j) (load i))
                                 (break)
                                 (if (= (scoped-ident-raw (get (load names)
                                                               (load j)))
                                        raw)
                                     (break
                                       :try
                                         (Err [ExprKind Diag]
                                              (derr-at (sx-lo p)
                                                       (sx-hi p)
                                                       (text/format a
                                                                    "fn: duplicate parameter '{}'"
                                                                    raw))))
                                     (set! j (primitive/iadd (load j) 1))))))
                     (source-nonreference! p)
                     (push! (mut names) (lexical-name a p))
                     (set! i (primitive/iadd (load i) 1)))))
         (when (<= (sx-len args) 1)
           (break :try (Err [ExprKind Diag] (derr-at slo shi "fn: empty body"))))
         (Ok (EAnonFn (box-al a (load names))
                      (try! (parse-function-body a (rest-from a args 1))))))))

; (match scrut arms...) — `match` arm.
;
; `(_ body…)` is the CATCH-ALL arm. It names no variant, so it takes NO bind vector
; (its body starts right after the `_`), and it must be written last — arms after it
; could never run. The checker treats it as covering every variant the explicit arms
; left out, which is what makes an incomplete `match` exhaustive.
(defn parse-match [(a (dyn Allocator))
                   (args (ptr (ArrayList Sexp)))
                   (slo i64)
                   (shi i64)] (-> (Result ExprKind Diag))
  (try (let [scrut
               (box-expr a
                         (try! (parse-expr a
                                           (try! (need [Sexp]
                                                       (sx-get args 0)
                                                       "match: missing scrutinee")))))
             (mut arms) (ArrayList::new [Arm] a)
             n (sx-len args)
             (mut i) 1]
         (reserve! (mut arms) (if (> n 1) (- n 1) 0))
         (loop (if (>= (load i) n)
                   (break)
                   (let [arm-s (sx-at args (load i))]
                     (set! i (primitive/iadd (load i) 1))
                     (let [al
                             (try! (as-list arm-s
                                            "match arm must be (Variant [binds] body)"))
                           variant-form
                             (try! (need [Sexp]
                                         (sx-get al 0)
                                         "arm: missing variant"))
                           _variant-check
                             (try! (sym-of a variant-form "variant"))
                           ; the variant names a constructor where the pattern was
                           ; written, which for a template's pattern is the template
                           variant
                             (if (= (sx-sval variant-form) "_")
                                 "_"
                                 (lexical-name a variant-form))
                           bvo (sx-get al 1)]
                       (let [wild (= variant "_")]
                         (when (and wild (< (load i) n))
                           (break
                             :try
                               (Err [ExprKind Diag]
                                    (derr-at (sx-lo arm-s)
                                             (sx-hi arm-s)
                                             "match: the `_` arm must come last"))))
                         (when (and (not wild) (not (opt-is-vec bvo)))
                           (break
                             :try
                               (Err [ExprKind Diag]
                                    (derr-at (sx-lo arm-s)
                                             (sx-hi arm-s)
                                             (text/format a
                                                          "arm '{}': expected a bind vector"
                                                          variant)))))
                         (let [(mut binds) (ArrayList::new [(slice u8)] a)
                               nb (if wild 0 (sx-len (sx-items (opt-get bvo))))]
                           (reserve! (mut binds) nb)
                           (for [bi 0 nb]
                             (let [bn
                                     (sx-at (sx-items (opt-get bvo))
                                            bi)]
                               (try! (sym-of a bn "bind"))
                               (source-nonreference! bn)
                               (push! (mut binds) (lexical-name a bn))))
                           (let [bodyf
                                   (try! (parse-body a
                                                     (rest-from a
                                                                al
                                                                (if wild 1 2))))
                                 nbody (len (load bodyf))]
                             (let [body
                                     ; An arm with no body yields no value, `(do)`:
                                     ; fine where the match is a statement.
                                     (if (= nbody 0)
                                         (mk-expr (EDo bodyf)
                                                  (sx-lo arm-s)
                                                  (sx-hi arm-s)
                                                  (sx-source arm-s)
                                                  (sx-ctxt arm-s))
                                         (if (= nbody 1)
                                             (get (load bodyf) 0)
                                             (mk-expr (EDo bodyf)
                                                      (sx-lo arm-s)
                                                      (sx-hi arm-s)
                                                      (sx-source arm-s)
                                                      (sx-ctxt arm-s))))]
                               (let [ap (primitive/alloc-stack Arm)]
                                 (set! (.variant ap) variant)
                                 (set! (.binds ap)
                                       (box-al a (load binds)))
                                 (set! (.body ap) body)
                                 (unless wild
                                   (source-pattern! variant-form
                                                    (field ap body))
                                   0)
                                 (push! (mut arms) (load ap)))))))))))
         (Ok (EMatch scrut (box-al a (load arms)))))))

; (primitive/llvm-ir RESULT [operands] "BODY") — `llvm-ir` arm.
(defn parse-vector-op [(a (dyn Allocator))
                       (head (slice u8))
                       (args (ptr (ArrayList Sexp)))]
  (-> (Result ExprKind Diag))
  (try (let [op
               (match (vector-op-from-name head)
                 (Some [op] op)
                 (None []
                       (break
                         :try
                           (Err [ExprKind Diag]
                                (derr "unknown vector primitive")))))
             has-type
               (and (> (sx-len args) 0)
                    (= (sx-tag (sx-at args 0)) 7)
                    (call-vector-is-type-args? (sx-at args 0)))
             requested
               (if has-type
                   (let [types (sx-items (sx-at args 0))]
                     (if (= (sx-len types) 1)
                         (try! (parse-type a (sx-at types 0)))
                         (break
                           :try
                             (Err [ExprKind Diag]
                                  (derr "vector primitive expects one result type: [(vec T N)]")))))
                   (TVoid))]
         (Ok (EVector
               :op op
               :result requested
               :operand_types (new-boxed-list [Type] a)
               :args
                 (try! (parse-exprs a
                                    (if has-type (rest-from a args 1) args))))))))

(defn parse-llvm-ir [(a (dyn Allocator))
                     (args (ptr (ArrayList Sexp)))
                     (slo i64)
                     (shi i64)] (-> (Result ExprKind Diag))
  (try (if (!= (sx-len args) 3)
           (Err [ExprKind Diag]
                (derr-at slo
                         shi
                         "llvm-ir: expects (primitive/llvm-ir RESULT-TYPE [operands...] \"BODY\")"))
           (let [result (try! (parse-type a (sx-at args 0)))
                 ov (sx-at args 1)]
             (when (not (= (sx-tag ov) 7))
               (break
                 :try
                   (Err [ExprKind Diag]
                        (derr-at (sx-lo ov)
                                 (sx-hi ov)
                                 "llvm-ir: expected a [operand...] vector"))))
             (let [operands (try! (parse-exprs a (sx-items ov)))
                   bv (sx-at args 2)]
               (when (not (= (sx-tag bv) 4))
                 (break
                   :try
                     (Err [ExprKind Diag]
                          (derr-at (sx-lo bv)
                                   (sx-hi bv)
                                   "llvm-ir: body must be a string literal"))))
               (Ok (ELlvmIr
                     :result result
                     :args operands
                     :body (sx-sval bv))))))))

; Heads that are only ever valid at the top level — none of them is also an
; expression head (a definition never nests inside a value), so seeing one in
; expression position is unambiguous. Keep in sync with the top-level dispatch in
; parse-program and the loader's own (module/import/export/cimport) handling.
(defn toplevel-only-head? [(h (slice u8))] (-> bool)
  (cond (= h "defn*") true
        (= h "defalias") true
        (= h "retire-alias") true
        (= h "retire-trait") true
        (= h "retire-impl") true
        (= h "retire-inherent") true
        (retire-definition-kind? h) true
        (= h "declare") true
        (= h "defstruct") true
        (= h "defsum") true
        (= h "defcc") true
        (= h "extern") true
        (= h "export-c") true
        (= h "const") true
        (= h "deftrait") true
        (= h "impl") true
        (= h "static-assert") true
        (= h "meta") true
        (= h "module") true
        (= h "import") true
        (= h "export") true
        (= h "cimport") true
        (= h "reader-provider") true
        :else false))

; A top-level definition in expression position is never legal, and in practice it
; means an earlier form lost a ')' and swallowed this one. Say that, anchored at the
; swallowed definition. Without this the head falls through to the call path and the
; failure surfaces from its parameter list as "unexpected vector in expression" —
; a symptom several lines away from the missing paren, in a form that is itself fine.
(defn nested-toplevel-diag [(a (dyn Allocator))
                            (head (slice u8))
                            (args (ptr (ArrayList Sexp)))
                            (slo i64)
                            (shi i64)] (-> Diag)
  (let [named
          (if (= (sx-len args) 0)
              false
              (= (sx-tag (sx-at args 0)) 2))
        what
          (if named
              (text/format a "'{} {}'" head (sx-sval (sx-at args 0)))
              (text/format a "'{}'" head))]
    (derr-at slo
             shi
             (text/format a
                          "{} is a top-level definition, but it appears inside an expression — an enclosing form is missing a ')'"
                          what))))

; the big head dispatch.
; A bare `:` reads as an empty keyword (KKw ""), so a list whose head is one is the
; type-ascription form `(: value type)` — checked here BEFORE head-sym, which would
; otherwise reject the non-symbol head.
(defn ascribe-head? [(items (ptr (ArrayList Sexp)))] (-> bool)
  (and (> (sx-len items) 0)
       (and (= (sx-tag (sx-at items 0)) 3)
            (= (len (sx-sval (sx-at items 0))) 0))))

; Parse the `:field value` tail of a named constructor call. Keeping names beside
; expressions in the AST lets the resolver remain syntax-agnostic and gives the
; checker the actual struct/sum definition needed for authoritative validation.
(defn parse-named-call-names [(a (dyn Allocator))
                              (args (ptr (ArrayList Sexp)))]
  (-> (ptr (ArrayList (slice u8))))
  ; named-call-shape? has already established the :name value pairs.
  (let [(mut out) (ArrayList::new [(slice u8)] a)]
    (for i (range 0 (/ (sx-len args) 2))
      (push! (mut out) (sx-sval (sx-at args (* i 2)))))
    (box-al a (load out))))

(defn parse-named-call-values [(a (dyn Allocator))
                               (args (ptr (ArrayList Sexp)))]
  (-> (Result (ptr (ArrayList Expr)) Diag))
  (try (let [n (sx-len args)
             (mut out) (ArrayList::new [Expr] a)
             (mut i) 1]
         (loop (if (>= (load i) n)
                   (break)
                   (do
                     (push! (mut out)
                            (match (parse-expr a (sx-at args (load i)))
                              (Ok [temporary] temporary)
                              (Err [temporary] (break :try (Err temporary)))))
                     (set! i (primitive/iadd (load i) 2)))))
         (Ok (box-al a (load out))))))

;;; `:name value` pairs throughout: an even count with a keyword at every even
;;; position. Anything else that merely starts with a keyword passes that keyword
;;; as an ordinary positional Keyword value, as in `(speed :slow)`.
(defn named-call-shape? [(args (ptr (ArrayList Sexp)))] (-> bool)
  (let [n (sx-len args)
        (mut shaped) (and (> n 0) (= (% n 2) 0))]
    (for i (range 0 (/ n 2))
      (when (!= (sx-tag (sx-at args (* i 2))) 3) (set! shaped false)))
    (load shaped)))

(defn parse-call-kind [(a (dyn Allocator))
                       (head (slice u8))
                       (type-args (ptr (ArrayList Type)))
                       (args (ptr (ArrayList Sexp)))]
  (-> (Result ExprKind Diag))
  (if (named-call-shape? args)
      (match (parse-named-call-values a args)
        (Err [d] (Err [ExprKind Diag] d))
        (Ok [values]
            (Ok [ExprKind Diag]
                (ENamedCall
                  :func head
                  :type_args type-args
                  :names (parse-named-call-names a args)
                  :args values))))
      (match (parse-exprs a args)
        (Err [d] (Err [ExprKind Diag] d))
        (Ok [values]
            (Ok [ExprKind Diag]
                (ECall
                  :func head
                  :type_args type-args
                  :args values))))))

; `(f [X…] rest…)` whose bracket has the shape of type arguments. When it also
; reads as an array value, both readings are kept for resolution to choose
; between (EBracketCall); otherwise it is type arguments.
(defn parse-bracket-call [(a (dyn Allocator))
                          (head (slice u8))
                          (bracket Sexp)
                          (args (ptr (ArrayList Sexp)))]
  (-> (Result ExprKind Diag))
  (try (let [rest (rest-from a args 1)]
         (match (parse-types a (sx-items bracket))
           (Err [_]
                ; Not type syntax after all: an array value.
                (parse-call-kind a
                                 head
                                 (new-boxed-list [Type] a)
                                 args))
           (Ok [types]
               (if (named-call-shape? rest)
                   (parse-call-kind a head types rest)
                   (match (parse-expr a bracket)
                     (Err [_] (parse-call-kind a head types rest))
                     (Ok [vector]
                         (Ok (EBracketCall
                               :func head
                               :type_args types
                               :args (try! (parse-exprs a rest))
                               :vector (box-expr a vector)))))))))))

; A vector immediately after a call head used to mean type arguments
; unconditionally. Expression vectors make that position ambiguous, so retain
; the old meaning only when every item has type syntax shape. Constructor calls,
; literals, keywords and nested expression vectors are array elements.
(defn call-type-forms? [(xs (ptr (ArrayList Sexp))) (i i64) (n i64)] (-> bool)
  (if (>= i n)
      true
      (and (call-type-form? (sx-at xs i)) (call-type-forms? xs (+ i 1) n))))

(defn call-type-list? [(xs (ptr (ArrayList Sexp)))] (-> bool)
  (let [n (sx-len xs)]
    (if (= n 0)
        false
        (let [h (sx-at xs 0)]
          (if (not (= (sx-tag h) 2))
              false
              (let [hn (sx-sval h)]
                ; A quoted or quasiquoted form is a value: no type is spelled so.
                (if (or (= hn "quasiquote")
                        (= hn "quote")
                        (= hn "unquote")
                        (= hn "unquote-splicing"))
                    false
                    (if (and (= hn "const") (= n 2))
                        (or (= (sx-tag (sx-at xs 1)) 0)
                            (= (sx-tag (sx-at xs 1)) 2)
                            (= (sx-tag (sx-at xs 1)) 3))
                        (if (and (= hn "mask") (= n 2))
                            (or (= (sx-tag (sx-at xs 1)) 0)
                                (= (sx-tag (sx-at xs 1)) 2))
                            (if (and (or (= hn "array") (= hn "vec")) (= n 3))
                                (and (call-type-form? (sx-at xs 1))
                                     (or (= (sx-tag (sx-at xs 2)) 0)
                                         (= (sx-tag (sx-at xs 2)) 2)))
                                (call-type-forms? xs 1 n)))))))))))

;;; Is the item `true` or `false`? Like an integer, it is a constant: allowed
;;; among type arguments, never type syntax by itself.
(defn bool-literal-sexp? [(s Sexp)] (-> bool)
  (and (= (sx-tag s) 2) (or (= (sx-sval s) "true") (= (sx-sval s) "false"))))

(defn call-type-form? [(s Sexp)] (-> bool)
  (let [tag (sx-tag s)]
    (cond (= tag 2) (not (bool-literal-sexp? s))
          (= tag 6) (call-type-list? (sx-items s))
          (= tag 7) (let [xs (sx-items s)] (call-type-forms? xs 0 (sx-len xs)))
          :else false)))

(defn call-vector-is-type-args? [(v Sexp)] (-> bool)
  (let [xs (sx-items v)
        n (sx-len xs)
        (mut i) 0
        (mut has-type) false
        (mut yes) (> (sx-len xs) 0)]
    (loop (if (>= (load i) n)
              (break)
              (let [item (sx-at xs (load i))]
                ; Integer, Boolean and keyword constants may appear among type
                ; arguments, but a vector of only constants is an array literal.
                (if (or (= (sx-tag item) 0)
                        (= (sx-tag item) 3)
                        (bool-literal-sexp? item))
                    (set! i (+ (load i) 1))
                    (if (call-type-form? item)
                        (do (set! has-type true) (set! i (+ (load i) 1)))
                        (do (set! yes false) (break)))))))
    (and (load yes) (load has-type))))

; Variadic short-circuit Boolean forms. Folding here keeps `and`/`or` available to
; the earliest metaprogram bootstrap phases without turning either into an ambient
; callable primitive.
(defn parse-logic [(a (dyn Allocator))
                   (args (ptr (ArrayList Sexp)))
                   (i i64)
                   (n i64)
                   (is-and bool)
                   (slo i64)
                   (shi i64)
                   (ssrc i64)
                   (sctxt i64)] (-> (Result Expr Diag))
  (try (if (>= i n)
           (Ok (mk-expr (EBool is-and) slo shi ssrc sctxt))
           (if (= (primitive/iadd i 1) n)
               (parse-expr a (sx-at args i))
               (let [first (try! (parse-expr a (sx-at args i)))
                     rest
                       (try! (parse-logic a
                                          args
                                          (primitive/iadd i 1)
                                          n
                                          is-and
                                          slo
                                          shi
                                          ssrc
                                          sctxt))]
                 (Ok (mk-expr (if is-and
                                  (EIf
                                    :cnd (box-expr a first)
                                    :thn (box-expr a rest)
                                    :els
                                      (box-expr a
                                                (mk-expr (EBool false)
                                                         slo
                                                         shi
                                                         ssrc
                                                         sctxt)))
                                  (EIf
                                    :cnd (box-expr a first)
                                    :thn
                                      (box-expr a
                                                (mk-expr (EBool true)
                                                         slo
                                                         shi
                                                         ssrc
                                                         sctxt))
                                    :els (box-expr a rest)))
                              slo
                              shi
                              ssrc
                              sctxt)))))))

; Parse an expression in a PLACE context. Most place expressions parse normally;
; `.field` is special because its ordinary expression form inserts a load.
(defn dot-field-head? [(h (slice u8))] (-> bool)
  (and (> (len h) 1)
       (and (= (primitive/cast i64 (get h 0)) 46)
            ; `..` is an ordinary core macro, not an accessor head.
            (not (= (primitive/cast i64 (get h 1)) 46)))))

;;; A macro that emits `(set! PLACE V)` hands the expander a `set!` symbol that
;;; hygiene resolves at the quasiquote site — to the coil.core collection trait
;;; method — so the head reaches this parser QUALIFIED and the bare-name
;;; special-form test missed it, turning every macro-emitted place assignment
;;; into a 3-argument trait-call arity error. Two-argument `set!` is reserved for
;;; place assignment language-wide (see the defn-name guard below), so matching
;;; the head's LEAF name is unambiguous.
(defn head-leaf-is-set? [(h (slice u8))] (-> bool)
  (let [n (len h)
        (mut cut) 0]
    (for [i 0 n]
      (when (= (primitive/cast i64 (get h i))
               46)
        (set! cut (primitive/iadd i 1))
        0))
    (= (subslice h (load cut) n) "set!")))

(defn parse-place [(a (dyn Allocator)) (s Sexp)] (-> (Result Expr Diag))
  (try (if (= (sx-tag s) 6)
           (let [items (sx-items s)]
             (let [h (try! (head-sym a items))]
               (if (dot-field-head? h)
                   (if (!= (sx-len items) 2)
                       (Err [Expr Diag]
                            (derr-at (sx-lo s)
                                     (sx-hi s)
                                     ".field access expects exactly one receiver"))
                       (let [base-expr (try! (parse-place a (sx-at items 1)))
                             fname (subslice h 1 (len h))]
                         (Ok (mk-expr-node-id (EAccessorField (box-expr a
                                                                        base-expr)
                                                              fname)
                                              (sx-lo s)
                                              (sx-hi s)
                                              (sx-source s)
                                              (sx-ctxt s)
                                              (sx-node-id s)))))
                   (parse-expr a s))))
           (parse-expr a s))))

;;; The heads parse-list-expr takes as core syntax, whatever they would resolve to.
(defn core-syntax-head? [(h (slice u8))] (-> bool)
  (or (= h "and")
      (= h "or")
      (= h "not")
      (= h "if")
      (= h "do")
      (= h "defer*")
      (= h "fn*")
      (= h "comptime")
      (= h "let*")
      (= h "call")
      (= h "mut")
      (= h "match")
      (= h "quote")
      (= h "quasiquote")
      (= h "unquote")
      (= h "loop")
      (= h "block*")
      (= h "break")
      (= h "continue")))

; Keep nullary allocation and parsed-argument policies distinct: four source
; forms construct their empty expression list directly, while fixed arities
; (including zero) still call parse-exprs after the arity check.
(defn code-operation-message [(a (dyn Allocator))
                              (head (slice u8))
                              (diagnostic codeops/CodeDiagnostic)]
  (-> (slice u8))
  (match diagnostic
    (codeops/LiteralDiagnostic [text] text)
    (codeops/CodeNodeDiagnostic []
                                (text/format a "{}: expects one Code node" head))))

(defn parse-code-operation [(a (dyn Allocator))
                            (head (slice u8))
                            (args (ptr (ArrayList Sexp)))
                            (lo i64)
                            (hi i64)]
  (-> (Result ExprKind Diag))
  (try (let [op (codeop-number head)
             description (codeops/operation op)]
         (match (.parsing description)
           (codeops/OpenArguments []
                                  (Ok (ECodeOp op (try! (parse-exprs a args)))))
           (codeops/EmptyArguments [message]
                                   (if (!= (sx-len args) 0)
                                       (Err [ExprKind Diag]
                                            (derr-at lo
                                                     hi
                                                     (code-operation-message a
                                                                             head
                                                                             message)))
                                       (Ok (ECodeOp op
                                                    (new-boxed-list [Expr] a)))))
           (codeops/FixedArguments [count message]
                                   (if (!= (sx-len args) count)
                                       (Err [ExprKind Diag]
                                            (derr-at lo
                                                     hi
                                                     (code-operation-message a
                                                                             head
                                                                             message)))
                                       (Ok (ECodeOp op
                                                    (try! (parse-exprs a args))))))))))

(defn parse-list-expr [(a (dyn Allocator))
                       (items (ptr (ArrayList Sexp)))
                       (slo i64)
                       (shi i64)
                       (ssrc i64)
                       (sctxt i64)] (-> (Result ExprKind Diag))
  ; `()` has no head to dispatch on. It reaches here from source, and from any
  ; transform that produces one -- a Scheme dialect's `'()` did -- and reading its
  ; first element read through the null storage of an empty list.
  (try (if (= (sx-len items) 0)
           (Err [ExprKind Diag]
                (derr-at slo
                         shi
                         "`()` is not an expression: a list form needs a head"))
           (if (ascribe-head? items)
               (if (!= (sx-len items) 3)
                   (Err [ExprKind Diag]
                        (derr-at slo
                                 shi
                                 "type ascription: expects (: value type)"))
                   (Ok (EAscribe (try! (parse-type a (sx-at items 2)))
                                 (box-expr a
                                           (try! (parse-expr a (sx-at items 1)))))))
               (let [head-node (sx-at items 0)
                     source-head (try! (head-sym a items))
                     head
                       (match (primitive-dispatch-head head-node)
                         (Some [op]
                               (do (source-primitive-head! head-node op) op))
                         (None [] ""))
                     args (rest-from a items 1)
                     nargs (sx-len args)]
                 (when (toplevel-only-head? source-head)
                   (break
                     :try
                       (Err [ExprKind Diag]
                            (nested-toplevel-diag a source-head args slo shi))))
                 (when (core-syntax-head? source-head)
                   (source-core-head! head-node)
                   0)
                 (let [bop (binop-of head)]
                   (if (>= bop 0)
                       (mk-bin a args head bop)
                       (let [cop (cmpop-of head)]
                         (cond (>= cop 0) (mk-cmp a args head cop)
                               (or (= head "inot")
                                   (= head "clz")
                                   (= head "ctz")
                                   (= head "popcount")
                                   (= head "bswap"))
                                 (if (!= nargs 1)
                                     (Err [ExprKind Diag]
                                          (derr-at slo
                                                   shi
                                                   (text/format a
                                                                "{}: expects exactly one argument"
                                                                head)))
                                     (Ok (EIntUnary (cond (= head "inot") 0
                                                          (= head "clz") 1
                                                          (= head "ctz") 2
                                                          (= head "popcount") 3
                                                          :else 4)
                                                    (box-expr a
                                                              (try! (parse-expr a
                                                                                (sx-at args
                                                                                       0)))))))
                               (= source-head "and")
                                 (let [e (primitive/alloc-stack Expr)]
                                   (store! e
                                           (try! (parse-logic a
                                                              args
                                                              0
                                                              nargs
                                                              true
                                                              slo
                                                              shi
                                                              ssrc
                                                              sctxt)))
                                   (Ok (.kind e)))
                               (= source-head "or")
                                 (let [e (primitive/alloc-stack Expr)]
                                   (store! e
                                           (try! (parse-logic a
                                                              args
                                                              0
                                                              nargs
                                                              false
                                                              slo
                                                              shi
                                                              ssrc
                                                              sctxt)))
                                   (Ok (.kind e)))
                               (= source-head "not")
                                 (if (!= nargs 1)
                                     (Err [ExprKind Diag]
                                          (derr-at slo
                                                   shi
                                                   "not: expects (not x)"))
                                     (Ok (EIf
                                           :cnd
                                             (box-expr a
                                                       (try! (parse-expr a
                                                                         (sx-at args
                                                                                0))))
                                           :thn
                                             (box-expr a
                                                       (mk-expr (EBool false)
                                                                slo
                                                                shi
                                                                ssrc
                                                                sctxt))
                                           :els
                                             (box-expr a
                                                       (mk-expr (EBool true)
                                                                slo
                                                                shi
                                                                ssrc
                                                                sctxt)))))
                               (= source-head "if")
                                 (if (!= nargs 3)
                                     (Err [ExprKind Diag]
                                          (derr-at slo
                                                   shi
                                                   "if: expects (if cond then else)"))
                                     (Ok (EIf
                                           :cnd
                                             (box-expr a
                                                       (try! (parse-expr a
                                                                         (sx-at args
                                                                                0))))
                                           :thn
                                             (box-expr a
                                                       (try! (parse-expr a
                                                                         (sx-at args
                                                                                1))))
                                           :els
                                             (box-expr a
                                                       (try! (parse-expr a
                                                                         (sx-at args
                                                                                2)))))))
                               (= source-head "do")
                                 (Ok (EDo (try! (parse-body a args))))
                               (= source-head "defer*")
                                 (Err [ExprKind Diag]
                                      (derr-at slo
                                               shi
                                               "defer: (defer cleanup) is a form of a body -- a function, let, do, loop, block or match-arm body -- where it guards the forms after it; it cannot stand in a value position"))
                               (= source-head "fn*")
                                 (parse-anon-fn a args slo shi)
                               (= source-head "comptime")
                                 (if (!= nargs 1)
                                     (Err [ExprKind Diag]
                                          (derr-at slo
                                                   shi
                                                   "comptime: expects (comptime expr)"))
                                     (Ok (EComptime (box-expr a
                                                              (try! (parse-expr a
                                                                                (sx-at args
                                                                                       0)))))))
                               (= source-head "let*") (parse-let a args slo shi)
                               (= source-head "call")
                                 (let [fs
                                         (try! (need [Sexp]
                                                     (sx-get args 0)
                                                     "call: missing function"))
                                       _fcheck
                                         (try! (sym-of a fs "call target"))
                                       f (lexical-name a fs)]
                                   (parse-call-kind a
                                                    f
                                                    (new-boxed-list [Type] a)
                                                    (rest-from a args 1)))
                               ; A match the binding layer lowered reaching a case its
                               ; arms exclude: the checker proves this unreachable.
                               (= head "pattern-fail")
                                 (if (!= nargs 0)
                                     (Err (derr-at slo
                                                   shi
                                                   "pattern-fail takes no arguments"))
                                     (Ok (EPattern
                                           :op 5
                                           :ty (TVoid)
                                           :inner
                                             (box-expr a
                                                       (mk-expr (EInt 0)
                                                                -1
                                                                -1
                                                                -1
                                                                0))
                                           :index 0)))
                               (= head "pattern-default")
                                 (if (!= nargs 1)
                                     (Err (derr-at slo
                                                   shi
                                                   "pattern-default takes one body"))
                                     (Ok (EPattern
                                           :op 6
                                           :ty (TVoid)
                                           :inner
                                             (box-expr a
                                                       (try! (parse-expr a
                                                                         (sx-at args
                                                                                0))))
                                           :index 0)))
                               (or (= head "pattern-view")
                                   (= head "pattern-prefix")
                                   (= head "pattern-project")
                                   (= head "pattern-nth")
                                   (= head "pattern-rest"))
                                 (if (!= nargs 2)
                                     (Err (derr-at slo
                                                   shi
                                                   "pattern projection expects two arguments"))
                                     (if (= head "pattern-view")
                                         (Ok (EPattern
                                               :op 0
                                               :ty
                                                 (try! (parse-type a
                                                                   (sx-at args
                                                                          0)))
                                               :inner
                                                 (box-expr a
                                                           (try! (parse-expr a
                                                                             (sx-at args
                                                                                    1))))
                                               :index 0))
                                         (Ok (EPattern
                                               :op
                                                 (cond (= head
                                                          "pattern-prefix")
                                                         1
                                                       (= head
                                                          "pattern-nth")
                                                         2
                                                       (= head
                                                          "pattern-project")
                                                         4
                                                       :else 3)
                                               :ty (TVoid)
                                               :inner
                                                 (box-expr a
                                                           (try! (parse-expr a
                                                                             (sx-at args
                                                                                    0))))
                                               :index
                                                 (try! (int-val a
                                                                (sx-at args
                                                                       1)
                                                                "pattern index"))))))
                               (= head "zeroed")
                                 (if (!= nargs 1)
                                     (Err [ExprKind Diag]
                                          (derr-at slo
                                                   shi
                                                   "zeroed: expects (primitive/zeroed TYPE)"))
                                     (Ok (EZeroed (try! (parse-type a
                                                                    (sx-at args
                                                                           0))))))
                               (= source-head "mut")
                                 (if (!= nargs 1)
                                     (Err [ExprKind Diag]
                                          (derr-at slo
                                                   shi
                                                   "mut: expects (mut PLACE)"))
                                     (Ok (EBorrow true
                                                  (box-expr a
                                                            (try! (parse-place a
                                                                               (sx-at args
                                                                                      0)))))))
                               (dot-field-head? source-head)
                                 (if (!= nargs 1)
                                     (Err [ExprKind Diag]
                                          (derr-at slo
                                                   shi
                                                   ".field access expects exactly one receiver"))
                                     (let [base-expr
                                             (try! (parse-place a
                                                                (sx-at args 0)))
                                           fname
                                             (subslice source-head
                                                       1
                                                       (len source-head))]
                                       (Ok (ELoad (box-expr a
                                                            (mk-expr (EAccessorField (box-expr a
                                                                                               base-expr)
                                                                                     fname)
                                                                     slo
                                                                     shi
                                                                     ssrc
                                                                     sctxt))))))
                               (and (head-leaf-is-set? source-head)
                                    (= nargs 2))
                                 (Ok (EStore (box-expr a
                                                       (try! (parse-place a
                                                                          (sx-at args
                                                                                 0))))
                                             (box-expr a
                                                       (try! (parse-expr a
                                                                         (sx-at args
                                                                                1))))))
                               (= head "alloc-stack") (alloc-form a args 0)
                               (= head "alloc-static") (alloc-form a args 1)
                               (= head "alloc-heap") (alloc-form a args 2)
                               (= head "field")
                                 (Ok (EField (box-expr a
                                                       (try! (parse-expr a
                                                                         (try! (need [Sexp]
                                                                                     (sx-get args
                                                                                             0)
                                                                                     "field: missing pointer")))))
                                             (try! (sym-of a
                                                           (try! (need [Sexp]
                                                                       (sx-get args
                                                                               1)
                                                                       "field: missing field name"))
                                                           "field name"))))
                               (= head "bit-get")
                                 (Ok (EBitGet (box-expr a
                                                        (try! (parse-expr a
                                                                          (try! (need [Sexp]
                                                                                      (sx-get args
                                                                                              0)
                                                                                      "get: missing pointer")))))
                                              (try! (sym-of a
                                                            (try! (need [Sexp]
                                                                        (sx-get args
                                                                                1)
                                                                        "get: missing field name"))
                                                            "field name"))))
                               (= head "bit-set!")
                                 (Ok (EBitSet
                                       :p
                                         (box-expr a
                                                   (try! (parse-expr a
                                                                     (try! (need [Sexp]
                                                                                 (sx-get args
                                                                                         0)
                                                                                 "set!: missing pointer")))))
                                       :fname
                                         (match (sym-of a
                                                        (try! (need [Sexp]
                                                                    (sx-get args
                                                                            1)
                                                                    "set!: missing field name"))
                                                        "field name")
                                           (Ok [value] value)
                                           (Err [error]
                                                (break :try (Err error))))
                                       :val
                                         (box-expr a
                                                   (try! (parse-expr a
                                                                     (try! (need [Sexp]
                                                                                 (sx-get args
                                                                                         2)
                                                                                 "set!: missing value")))))))
                               (= head "fnptr-of")
                                 ; `(fnptr-of f)`, or `(fnptr-of f [T…])` for an instance
                                 ; of a generic function, as a call writes its type
                                 ; arguments after the name.
                                 (if (or (< nargs 1)
                                         (> nargs 2)
                                         (and (= nargs 2)
                                              (!= (sx-tag (sx-at args 1)) 7)))
                                     (Err [ExprKind Diag]
                                          (derr-at slo
                                                   shi
                                                   "fnptr-of: expects (primitive/fnptr-of name) or, for a generic function, (primitive/fnptr-of name [T…])"))
                                     (let [nf (sx-at args 0)
                                           _name
                                             (try! (sym-of a nf "function name"))]
                                       (if (= nargs 2)
                                           (Ok (EFnPtrInst (lexical-name a nf)
                                                           (try! (parse-types a
                                                                              (sx-items (sx-at args
                                                                                               1))))))
                                           (Ok (EFnPtrOf (lexical-name a nf))))))
                               (= head "call-ptr")
                                 (Ok (ECallPtr (box-expr a
                                                         (try! (parse-expr a
                                                                           (try! (need [Sexp]
                                                                                       (sx-get args
                                                                                               0)
                                                                                       "call-ptr: missing function pointer")))))
                                               (try! (parse-exprs a
                                                                  (rest-from a
                                                                             args
                                                                             1)))))
                               (= head "load")
                                 (if (!= nargs 1)
                                     (Err [ExprKind Diag]
                                          (derr-at slo
                                                   shi
                                                   "load: expects (primitive/load ptr)"))
                                     (Ok (ELoad (box-expr a
                                                          (try! (parse-expr a
                                                                            (sx-at args
                                                                                   0)))))))
                               (= head "store!")
                                 (let [(mut tp)
                                         (: (match (need-two a
                                                             args
                                                             "store!")
                                              (Ok [value] value)
                                              (Err [error]
                                                   (break :try (Err error))))
                                            Two)]
                                   (Ok (EStore (box-expr a
                                                         (try! (parse-expr a
                                                                           (.x tp))))
                                               (box-expr a
                                                         (try! (parse-expr a
                                                                           (.y tp)))))))
                               (= head "free")
                                 (if (!= nargs 1)
                                     (Err [ExprKind Diag]
                                          (derr-at slo
                                                   shi
                                                   "free: expects (primitive/free ptr)"))
                                     (Ok (EFree (box-expr a
                                                          (try! (parse-expr a
                                                                            (sx-at args
                                                                                   0)))))))
                               (= head "make-dyn")
                                 (if (!= nargs 2)
                                     (Err [ExprKind Diag]
                                          (derr-at slo
                                                   shi
                                                   "make-dyn: expects (primitive/make-dyn Trait expr)"))
                                     (Ok (EErase (try! (sym-of a
                                                               (sx-at args
                                                                      0)
                                                               "make-dyn trait name"))
                                                 (box-expr a
                                                           (try! (parse-expr a
                                                                             (sx-at args
                                                                                    1)))))))
                               (= head "index")
                                 (let [(mut tp)
                                         (: (match (need-two a
                                                             args
                                                             "index")
                                              (Ok [value] value)
                                              (Err [error]
                                                   (break :try (Err error))))
                                            Two)]
                                   (Ok (EIndex (box-expr a
                                                         (try! (parse-expr a
                                                                           (.x tp))))
                                               (box-expr a
                                                         (try! (parse-expr a
                                                                           (.y tp)))))))
                               (= head "cast")
                                 (if (!= nargs 2)
                                     (Err [ExprKind Diag]
                                          (derr-at slo
                                                   shi
                                                   "cast: expects (primitive/cast :type expr)"))
                                     (Ok (ECast (try! (parse-type a
                                                                  (sx-at args
                                                                         0)))
                                                (box-expr a
                                                          (try! (parse-expr a
                                                                            (sx-at args
                                                                                   1)))))))
                               (= source-head "match")
                                 (parse-match a
                                              args
                                              slo
                                              shi)
                               (= head "sizeof")
                                 (if (!= nargs 1)
                                     (Err [ExprKind Diag]
                                          (derr-at slo
                                                   shi
                                                   "sizeof: expects (primitive/sizeof TYPE)"))
                                     (Ok (ESizeOf (try! (parse-type a
                                                                    (sx-at args
                                                                           0))))))
                               (= head "alignof")
                                 (if (!= nargs 1)
                                     (Err [ExprKind Diag]
                                          (derr-at slo
                                                   shi
                                                   "alignof: expects (primitive/alignof TYPE)"))
                                     (Ok (EAlignOf (try! (parse-type a
                                                                     (sx-at args
                                                                            0))))))
                               (= head "offsetof")
                                 (if (!= nargs 2)
                                     (Err [ExprKind Diag]
                                          (derr-at slo
                                                   shi
                                                   "offsetof: expects (primitive/offsetof TYPE field)"))
                                     (Ok (EOffsetOf (try! (parse-type a
                                                                      (sx-at args
                                                                             0)))
                                                    (try! (sym-of a
                                                                  (sx-at args
                                                                         1)
                                                                  "field")))))
                               (= head "alloc-stack-bytes")
                                 (if (!= nargs 1)
                                     (Err [ExprKind Diag]
                                          (derr-at slo
                                                   shi
                                                   "alloc-stack-bytes: expects one u64 byte count"))
                                     (let [(mut operands)
                                             (ArrayList::new [Expr] a)]
                                       (push! (mut operands)
                                              (try! (parse-expr a
                                                                (sx-at args 0))))
                                       (Ok (EIntrinsic
                                             :op (IStackBytes)
                                             :result
                                               (TPtr (box-type a (TInt 8 false)))
                                             :args (box-al a (load operands))))))
                               (= head "linker-address")
                                 (if (!= nargs 1)
                                     (Err [ExprKind Diag]
                                          (derr-at slo
                                                   shi
                                                   "linker-address: expects one linker symbol"))
                                     (Ok (EIntrinsic
                                           :op
                                             (ILinkerAddress (try! (parse-linker-symbol a
                                                                                        (sx-at args
                                                                                               0))))
                                           :result
                                             (TPtr (box-type a (TInt 8 false)))
                                           :args (new-boxed-list [Expr] a))))
                               (= head "volatile-load")
                                 (if (!= nargs 2)
                                     (Err [ExprKind Diag]
                                          (derr-at slo
                                                   shi
                                                   "volatile-load: expects a type and pointer"))
                                     (let [(mut operands)
                                             (ArrayList::new [Expr] a)]
                                       (push! (mut operands)
                                              (match (parse-expr a
                                                                 (sx-at args 1))
                                                (Ok [temporary] temporary)
                                                (Err [temporary]
                                                     (break
                                                       :try (Err temporary)))))
                                       (Ok (EIntrinsic
                                             :op (IVolatileLoad)
                                             :result
                                               (match (parse-type a
                                                                  (sx-at args 0))
                                                 (Ok [value] value)
                                                 (Err [error]
                                                      (break :try (Err error))))
                                             :args (box-al a (load operands))))))
                               (= head "volatile-store!")
                                 (if (!= nargs 2)
                                     (Err [ExprKind Diag]
                                          (derr-at slo
                                                   shi
                                                   "volatile-store!: expects a pointer and value"))
                                     (let [(mut operands)
                                             (ArrayList::new [Expr] a)]
                                       (push! (mut operands)
                                              (match (parse-expr a
                                                                 (sx-at args 0))
                                                (Ok [temporary] temporary)
                                                (Err [temporary]
                                                     (break
                                                       :try (Err temporary)))))
                                       (push! (mut operands)
                                              (match (parse-expr a
                                                                 (sx-at args 1))
                                                (Ok [temporary] temporary)
                                                (Err [temporary]
                                                     (break
                                                       :try (Err temporary)))))
                                       (Ok (EIntrinsic
                                             :op (IVolatileStore)
                                             :result (TInt 64 true)
                                             :args (box-al a (load operands))))))
                               (= head "alias-load")
                                 (if (!= nargs 2)
                                     (Err [ExprKind Diag]
                                          (derr-at slo
                                                   shi
                                                   "alias-load: expects a type and pointer"))
                                     (let [(mut operands)
                                             (ArrayList::new [Expr] a)]
                                       (push! (mut operands)
                                              (match (parse-expr a
                                                                 (sx-at args 1))
                                                (Ok [temporary] temporary)
                                                (Err [temporary]
                                                     (break
                                                       :try (Err temporary)))))
                                       (Ok (EIntrinsic
                                             :op (IAliasLoad)
                                             :result
                                               (match (parse-type a
                                                                  (sx-at args 0))
                                                 (Ok [ty] ty)
                                                 (Err [diag]
                                                      (break :try (Err diag))))
                                             :args (box-al a (load operands))))))
                               (= head "alias-store!")
                                 (if (!= nargs 2)
                                     (Err [ExprKind Diag]
                                          (derr-at slo
                                                   shi
                                                   "alias-store!: expects a pointer and value"))
                                     (let [(mut operands)
                                             (ArrayList::new [Expr] a)]
                                       (push! (mut operands)
                                              (match (parse-expr a
                                                                 (sx-at args 0))
                                                (Ok [temporary] temporary)
                                                (Err [temporary]
                                                     (break
                                                       :try (Err temporary)))))
                                       (push! (mut operands)
                                              (match (parse-expr a
                                                                 (sx-at args 1))
                                                (Ok [temporary] temporary)
                                                (Err [temporary]
                                                     (break
                                                       :try (Err temporary)))))
                                       (Ok (EIntrinsic
                                             :op (IAliasStore)
                                             :result (TInt 64 true)
                                             :args (box-al a (load operands))))))
                               (= head "fence!")
                                 (if (!= nargs 0)
                                     (Err [ExprKind Diag]
                                          (derr-at slo
                                                   shi
                                                   "fence!: expects no arguments"))
                                     (Ok (EIntrinsic
                                           :op (IFence)
                                           :result (TInt 64 true)
                                           :args (new-boxed-list [Expr] a))))
                               (= head "machine-code")
                                 (parse-machine-code a args slo shi)
                               (starts-with head "vector-")
                                 (parse-vector-op a head args)
                               (>= (typequery-of head) 0)
                                 (if (!= nargs 1)
                                     (Err [ExprKind Diag]
                                          (derr-at slo
                                                   shi
                                                   (text/format a
                                                                "{}: expects ({} TYPE)"
                                                                head
                                                                head)))
                                     (Ok (ETypeQuery (typequery-of head)
                                                     (try! (parse-type a
                                                                       (sx-at args
                                                                              0))))))
                               (>= (fieldmeta-of head) 0)
                                 (if (!= nargs 2)
                                     (Err [ExprKind Diag]
                                          (derr-at slo
                                                   shi
                                                   (text/format a
                                                                "{}: expects ({} TYPE index)"
                                                                head
                                                                head)))
                                     (Ok (EFieldMeta
                                           :meta (fieldmeta-of head)
                                           :ty
                                             (match (parse-type a
                                                                (sx-at args
                                                                       0))
                                               (Ok [value] value)
                                               (Err [error]
                                                    (break :try (Err error))))
                                           :idx
                                             (box-expr a
                                                       (try! (parse-expr a
                                                                         (sx-at args
                                                                                1)))))))
                               (= head "field-index")
                                 (if (!= nargs 2)
                                     (Err [ExprKind Diag]
                                          (derr-at slo
                                                   shi
                                                   "field-index: expects (primitive/field-index TYPE name)"))
                                     (Ok (EFieldIndex (try! (parse-type a
                                                                        (sx-at args
                                                                               0)))
                                                      (box-expr a
                                                                (try! (parse-expr a
                                                                                  (sx-at args
                                                                                         1)))))))
                               (= source-head "quote")
                                 (if (!= nargs 1)
                                     (Err [ExprKind Diag]
                                          (derr-at slo
                                                   shi
                                                   "quote: expects (quote FORM)"))
                                     (Ok (EQuote (box-sexp a
                                                           (sx-at args
                                                                  0)))))
                               (= source-head "quasiquote")
                                 (if (!= nargs 1)
                                     (Err [ExprKind Diag]
                                          (derr-at slo
                                                   shi
                                                   "quasiquote: expects one template"))
                                     (Ok (EQuasi (try! (build-quasi a
                                                                    (sx-at args
                                                                           0))))))
                               (= source-head "unquote")
                                 (Err [ExprKind Diag]
                                      (derr-at slo
                                               shi
                                               "unquote (~) is only valid inside a quasiquote (`)"))
                               (>= (codeop-number head) 0)
                                 (parse-code-operation a head args slo shi)
                               (= source-head "loop")
                                 (parse-loop a args slo shi)
                               (= source-head "block*")
                                 (parse-block a args slo shi ssrc sctxt)
                               (= source-head "break")
                                 (parse-break a args slo shi)
                               (= source-head "continue")
                                 (parse-continue a args slo shi)
                               (= head "llvm-ir")
                                 (parse-llvm-ir a
                                                args
                                                slo
                                                shi)
                               :else
                                 (let [fv
                                         (sx-get args
                                                 0)]
                                   (if (and (opt-is-vec fv)
                                            (call-vector-is-type-args? (opt-get fv)))
                                       (parse-bracket-call a
                                                           (lexical-name a
                                                                         (sx-at items
                                                                                0))
                                                           (opt-get fv)
                                                           args)
                                       (parse-call-kind a
                                                        (lexical-name a
                                                                      (sx-at items
                                                                             0))
                                                        (new-boxed-list [Type]
                                                                        a)
                                                        args))))))))))))

; ---- declaration parsers ----
(defn func-name [(f Func)] (-> (slice u8))
  (let [(mut p) (: f Func)] (.name p)))

; variant/struct fields: (name :type) -> Field.
(defn parse-fields [(a (dyn Allocator)) (fv (ptr (ArrayList Sexp)))]
  (-> (Result (ptr (ArrayList Field)) Diag))
  (try (let [(mut fs) (ArrayList::new [Field] a)
             n (sx-len fv)
             (mut i) 0]
         (reserve! (mut fs) n)
         (loop (if (>= (load i) n)
                   (break)
                   (let [f (sx-at fv (load i))]
                     (set! i (primitive/iadd (load i) 1))
                     (let [fl (try! (as-list f "field must be (name :type)"))
                           ; An empty field `()` has no name to read.
                           fn0
                             (try! (sym-of a
                                           (try! (need [Sexp]
                                                       (sx-get fl 0)
                                                       "field must be (name type): `()` names nothing"))
                                           "field name"))
                           ft
                             (try! (parse-type a
                                               (try! (need [Sexp]
                                                           (sx-get fl 1)
                                                           "field type"))))]
                       (let [(mut fp) (zeroed Field)]
                         (set! (.name fp) fn0)
                         (set! (.ty fp) ft)
                         (push! (mut fs) fp))))))
         (Ok (box-al a (load fs))))))

(defn parse-const [(a (dyn Allocator)) (rest (ptr (ArrayList Sexp)))]
  (-> (Result Const Diag))
  (try (let [namef (try! (need [Sexp] (sx-get rest 0) "const: missing name"))
             _namecheck (try! (sym-of a namef "const name"))
             _source-binder (source-nonreference! namef)
             name (lexical-name a namef)
             nr (sx-len rest)]
         (if (= nr 2)
             (let [value (try! (parse-expr a (sx-at rest 1)))]
               (Ok (let [c (primitive/alloc-stack Const)]
                     (set! (.name c) name)
                     (set! (.ty c) (None [Type]))
                     (set! (.value c) value)
                     (set! (.runtime c) false)
                     (set! (.declared c) false)
                     (set! (.annotations c)
                           (new-boxed-list [Annotation] a))
                     (load c))))
             (if (= nr 3)
                 (let [ty (try! (parse-type a (sx-at rest 1)))
                       value (try! (parse-expr a (sx-at rest 2)))]
                   (Ok (let [c (primitive/alloc-stack Const)]
                         (set! (.name c) name)
                         (set! (.ty c) (Some ty))
                         (set! (.value c) value)
                         (set! (.runtime c) false)
                         (set! (.declared c) false)
                         (set! (.annotations c)
                               (new-boxed-list [Annotation] a))
                         (load c))))
                 (Err [Const Diag]
                      (derr "const: expected (const NAME VALUE) or (const NAME TYPE VALUE)")))))))

;;; Leading `:key value` annotation pairs of a declaration, starting at `start`.
;;; With a positive `reserve`, a pair is taken only while that many items remain
;;; after it, so a declaration whose trailing value is itself a keyword
;;; (`(def mode :fast)`) is not misread as an annotation. With 0 every keyword
;;; starts a pair. Returns the index after the last pair.
(defn parse-annotation-pairs [(a (dyn Allocator))
                              (rest (ptr (ArrayList Sexp)))
                              (start i64)
                              (reserve i64)
                              (owner (slice u8))
                              (out (mut (ArrayList Annotation)))]
  (-> (Result i64 Diag))
  (try (let [(mut i) start]
         (loop (match (sx-get rest (load i))
                 (Some [k]
                       (if (and (= (sx-tag k) 3)
                                (or (= reserve 0)
                                    (>= (sx-len rest)
                                        (+ (load i) (+ 2 reserve)))))
                           (let [vp
                                   (try! (need [Sexp]
                                               (sx-get rest
                                                       (primitive/iadd (load i)
                                                                       1))
                                               (text/format a
                                                            "{}: annotation missing value"
                                                            owner)))
                                 av (try! (parse-expr a vp))
                                 ap (primitive/alloc-stack Annotation)]
                             (set! (.key ap) (sx-sval k))
                             (set! (.value ap) av)
                             (push! (mut out) (load ap))
                             (set! i (primitive/iadd (load i) 2)))
                           (break)))
                 (None [] (break))))
         (Ok [i64 Diag] (load i)))))

(defn parse-runtime-def [(a (dyn Allocator)) (rest (ptr (ArrayList Sexp)))]
  (-> (Result Const Diag))
  (try (let [namef (try! (need [Sexp] (sx-get rest 0) "def: missing name"))
             _namecheck (try! (sym-of a namef "def name"))
             _source-binder (source-nonreference! namef)
             name (lexical-name a namef)
             nr (sx-len rest)
             (mut annotations) (ArrayList::new [Annotation] a)
             first
               (try! (parse-annotation-pairs a
                                             rest
                                             1
                                             1
                                             (text/format a "def '{}'" name)
                                             (mut annotations)))
             nv (primitive/isub nr first)
             anns (box-al a (load annotations))]
         (if (= nv 1)
             (let [value (try! (parse-expr a (sx-at rest first)))
                   d (primitive/alloc-stack Const)]
               (set! (.name d) name)
               (set! (.ty d) (None [Type]))
               (set! (.value d) value)
               (set! (.runtime d) true)
               (set! (.declared d) false)
               (set! (.annotations d) anns)
               (Ok (load d)))
             (if (= nv 2)
                 (let [ty (try! (parse-type a (sx-at rest first)))
                       value
                         (try! (parse-expr a
                                           (sx-at rest (primitive/iadd first 1))))
                       d (primitive/alloc-stack Const)]
                   (set! (.name d) name)
                   (set! (.ty d) (Some ty))
                   (set! (.value d) value)
                   (set! (.runtime d) true)
                   (set! (.declared d) false)
                   (set! (.annotations d) anns)
                   (Ok (load d)))
                 (Err [Const Diag]
                      (derr "def: expected (def NAME [:key value …] [TYPE] VALUE)")))))))

(defn parse-defannotation [(a (dyn Allocator))
                           (rest (ptr (ArrayList Sexp)))]
  (-> (Result AnnotationDef Diag))
  (try (do
         (when (not (= (sx-len rest) 2))
           (break
             :try
               (Err [AnnotationDef Diag]
                    (derr "defannotation: expected (defannotation :key ValueType)"))))
         (let [key (try! (kw-of a (sx-at rest 0) "defannotation key"))
               ty (try! (parse-type a (sx-at rest 1)))
               (mut dp) (zeroed AnnotationDef)]
           (set! (.key dp) key)
           (set! (.value_type dp) ty)
           (set! (.compiler_owned dp) false)
           (Ok dp)))))

(defn parse-defalias [(a (dyn Allocator))
                      (rest (ptr (ArrayList Sexp)))] (-> (Result AliasDef Diag))
  (try (do
         (when (not (= (sx-len rest) 2))
           (break
             :try
               (Err [AliasDef Diag]
                    (derr "defalias: expected (defalias Name Target)"))))
         (let [_name (try! (sym-of a (sx-at rest 0) "alias name"))
               _target (try! (sym-of a (sx-at rest 1) "alias target"))
               name (lexical-name a (sx-at rest 0))
               target (lexical-name a (sx-at rest 1))]
           (when (= name target)
             (break
               :try
                 (Err [AliasDef Diag]
                      (derr (text/format a
                                         "defalias: '{}' cannot alias itself"
                                         name)))))
           (Ok [AliasDef Diag]
               (AliasDef
                 :name name
                 :target target
                 :source (sx-source (sx-at rest 1))
                 :lo (sx-lo (sx-at rest 1))
                 :hi (sx-hi (sx-at rest 1))))))))

;;; The Retirement kind a `(retire-… Name)` head names, or -1. See ast.coil.
(defn retirement-name-kind [(h (slice u8))] (-> i64)
  (cond (= h "retire-alias") 0
        (= h "retire-trait") 1
        (= h "retire-defn") 4
        (= h "retire-struct") 5
        (= h "retire-sum") 6
        (= h "retire-def") 7
        (= h "retire-const") 8
        :else -1))

;;; `retire-defn`, `retire-struct`, `retire-sum`, `retire-def` or `retire-const`.
(defn retire-definition-kind? [(h (slice u8))] (-> bool)
  (>= (retirement-name-kind h) 4))

;;; `(retire-alias Name)`, `(retire-trait Name)`, `(retire-impl [T…] Trait Type)`,
;;; `(retire-inherent [T…] Type)`, and `(retire-defn Name)`, `(retire-struct Name)`,
;;; `(retire-sum Name)`, `(retire-def Name)`, `(retire-const Name)`. See Retirement
;;; in ast.coil.
(defn parse-retirement [(a (dyn Allocator))
                        (head (slice u8))
                        (rest (ptr (ArrayList Sexp)))]
  (-> (Result Retirement Diag))
  (try (do
         (if (>= (retirement-name-kind head) 0)
             (do
               (unless (= (sx-len rest) 1)
                 (break
                   :try
                     (Err [Retirement Diag]
                          (derr (text/format a
                                             "{}: expected exactly one declaration name"
                                             head)))))
               (let [_name (try! (sym-of a (sx-at rest 0) "declaration name"))]
                 (Ok [Retirement Diag]
                     (Retirement
                       :kind (retirement-name-kind head)
                       :name (lexical-name a (sx-at rest 0))
                       :module ""
                       :impl (zeroed ImplDef)))))
             (let [has-tps (opt-is-vec (sx-get rest 0))
                   base (if has-tps 1 0)
                   inherent (= head "retire-inherent")
                   (mut type-params) (ArrayList::new [(slice u8)] a)]
               (unless (= (sx-len rest) (+ base (if inherent 1 2)))
                 (break
                   :try
                     (Err [Retirement Diag]
                          (derr (if inherent
                                    "retire-inherent: expected (retire-inherent [T…] Type)"
                                    "retire-impl: expected (retire-impl [T…] Trait Type)")))))
               (when has-tps
                 (let [v (sx-items (opt-get (sx-get rest 0)))]
                   (for [vi 0 (sx-len v)]
                     (match (parse-tparam-entry a (sx-at v vi))
                       (Ok [entry]
                           (let [e entry] (push! (mut type-params) (.name e))))
                       (Err [diag] (break :try (Err [Retirement Diag] diag))))))
                 0)
               (let [trait-name
                       (if inherent
                           ""
                           (try! (lexical-sym-of a
                                                 (sx-at rest base)
                                                 "trait name")))
                     self-type
                       (try! (parse-type a
                                         (sx-at rest (+ base (if inherent 0 1)))))
                     (mut stp) self-type]
                 (Ok [Retirement Diag]
                     (Retirement
                       :kind (if inherent 3 2)
                       :name trait-name
                       :module ""
                       :impl
                         (ImplDef
                           :kind
                             (if inherent (InherentImpl) (TraitImpl trait-name))
                           :for_type (impl-base-name a (mut stp))
                           :type_params (box-al a (load type-params))
                           :self_type self-type
                           :methods (new-boxed-list [Func] a)
                           :bounds (new-boxed-list [Bound] a))))))))))

(defn parse-defsum [(a (dyn Allocator)) (rest (ptr (ArrayList Sexp)))]
  (-> (Result SumDef Diag))
  (try (let [namef (try! (need [Sexp] (sx-get rest 0) "defsum: missing name"))
             _namecheck (try! (definition-type-name a namef "sum"))
             _source-binder (source-nonreference! namef)
             name (lexical-name a namef)
             (mut anns) (ArrayList::new [Annotation] a)
             (mut i)
               (try! (parse-annotation-pairs a rest 1 0 "defsum" (mut anns)))
             (mut tps) (ArrayList::new [(slice u8)] a)
             (mut sbounds) (ArrayList::new [Bound] a)]
         ; type params may carry bounds — `(T Ord)` — via the SAME per-entry parser defn and
         ; defstruct use, so the three forms cannot drift apart. (This used to require a bare
         ; symbol and reject `(T Ord)` outright, the only form of the three that did.)
         (when (opt-is-vec (sx-get rest (load i)))
           (let [it (sx-items (opt-get (sx-get rest (load i))))
                 n (sx-len it)
                 (mut k) 0]
             (loop (if (>= (load k) n)
                       (break)
                       (do
                         (let [ep (primitive/alloc-stack TPEntry)]
                           (set! ep
                                 (match (parse-tparam-entry a
                                                            (sx-at it
                                                                   (load k)))
                                   (Ok [value] value)
                                   (Err [error] (break :try (Err error)))))
                           (push! (mut tps) (.name ep))
                           (match (tpentry-bound ep)
                             (Some [b] (do (push! (mut sbounds) b) 0))
                             (None [] 0)))
                         (set! k (primitive/iadd (load k) 1))))))
           (set! i (primitive/iadd (load i) 1)))
         (let [(mut variants) (ArrayList::new [Variant] a)
               nr (sx-len rest)
               (mut vi) (load i)]
           (loop (if (>= (load vi) nr)
                     (break)
                     (let [v (sx-at rest (load vi))]
                       (set! vi (primitive/iadd (load vi) 1))
                       (let [vl
                               (try! (as-list v
                                              "variant must be (Name [fields])"))
                             vnamef
                               (try! (need [Sexp]
                                           (sx-get vl 0)
                                           "variant: missing name"))
                             _vnamecheck (try! (sym-of a vnamef "variant name"))
                             vname (lexical-name a vnamef)
                             fields
                               (if (opt-is-vec (sx-get vl 1))
                                   (try! (parse-fields a
                                                       (sx-items (opt-get (sx-get vl
                                                                                  1)))))
                                   (match (sx-get vl 1)
                                     (Some [_]
                                           (return-from
                                             :try
                                               (Err [SumDef Diag]
                                                    (derr-at (sx-lo v)
                                                             (sx-hi v)
                                                             (text/format a
                                                                          "variant '{}': fields must be a vector"
                                                                          vname)))))
                                     (None []
                                           (new-boxed-list [Field] a))))]
                         (let [(mut vp) (zeroed Variant)]
                           (set! (.name vp) vname)
                           (set! (.fields vp) fields)
                           (push! (mut variants) vp))))))
           (Ok (let [(mut sd) (zeroed SumDef)]
                 (set! (.annotations sd) (box-al a (load anns)))
                 (set! (.name sd) name)
                 (set! (.type_params sd) (box-al a (load tps)))
                 (set! (.bounds sd) (box-al a (load sbounds)))
                 (set! (.variants sd) (box-al a (load variants)))
                 (set! (.span_source sd) -1)
                 (set! (.span_lo sd) 0)
                 (set! (.span_hi sd) 0)
                 sd))))))

(defn compute-backing [(a (dyn Allocator))
                       (name (slice u8))
                       (acc i64)
                       (backing i64)] (-> (Result i64 Diag))
  (cond (>= backing 0)
          (if (>= backing acc)
              (Ok backing)
              (Err [i64 Diag]
                   (derr (text/format a
                                      "defstruct '{}': :backing i{} too small for {} bits"
                                      name
                                      (i64->str a backing)
                                      (i64->str a acc)))))
        (<= acc 8) (Ok 8)
        (<= acc 16) (Ok 16)
        (<= acc 32) (Ok 32)
        (<= acc 64) (Ok 64)
        :else
          (Err [i64 Diag]
               (derr (text/format a
                                  "defstruct '{}': {} bits needs an explicit :backing"
                                  name
                                  (i64->str a acc))))))

(defstruct BitField [(fname (slice u8)) (width i64) (signed bool)])

(defn parse-bitfield [(a (dyn Allocator)) (f Sexp)] (-> (Result BitField Diag))
  (try (let [fl (try! (as-list f "bitfield must be (name :bits N|iN|uN)"))
             fname
               (try! (sym-of a
                             (try! (need [Sexp]
                                         (sx-get fl 0)
                                         "bitfield must be (name :bits N|iN|uN): `()` names nothing"))
                             "field name"))
             spec
               (try! (need [Sexp] (sx-get fl 2) "bitfield missing width/type"))
             bt
               (if (opt-is-pos-int (sx-get fl 2))
                   (TInt (opt-int (sx-get fl 2)) false)
                   (try! (parse-type a spec)))
             width (match bt (TInt [bits _] bits) (_ -1))
             signed (match bt (TInt [_ s] s) (_ false))]
         (if (< width 0)
             (Err [BitField Diag]
                  (derr-at (sx-lo f)
                           (sx-hi f)
                           (text/format a
                                        "field '{}' must be (name :bits N|iN|uN)"
                                        fname)))
             (Ok (let [(mut b) (zeroed BitField)]
                   (set! (.fname b) fname)
                   (set! (.width b) width)
                   (set! (.signed b) signed)
                   b))))))

(defstruct NField [(fname (slice u8)) (fty Type) (at (Option i64))])

(defn parse-normal-field [(a (dyn Allocator)) (f Sexp)]
  (-> (Result NField Diag))
  (try (let [fl (try! (as-list f "field must be (name :type [:at N])"))
             fname
               ; An empty field `()` has no name to read.
               (if (= (sx-len fl) 0)
                   (break
                     :try
                       (Err [NField Diag]
                            (derr-at (sx-lo f)
                                     (sx-hi f)
                                     "field must be (name type): `()` names nothing")))
                   (try! (sym-of a (sx-at fl 0) "field name")))
             fty
               (try! (parse-type a
                                 (try! (need [Sexp]
                                             (sx-get fl 1)
                                             "field missing type"))))
             (mut at) (None [i64])
             (mut j) 2
             fln (sx-len fl)
             (mut out) (zeroed (Result NField Diag))
             (mut bad) false]
         (loop (if (>= (load j) fln)
                   (break)
                   (let [fj (sx-at fl (load j))]
                     (if (and (= (sx-tag fj) 3)
                              (= (sx-sval fj) "at"))
                         (do
                           (store! at
                                   (Some (try! (int-val a
                                                        (try! (need [Sexp]
                                                                    (sx-get fl
                                                                            (primitive/iadd (load j)
                                                                                            1))
                                                                    ":at missing value"))
                                                        "at"))))
                           (set! j (primitive/iadd (load j) 2)))
                         (do
                           (set! out
                                 (Err (derr-at (sx-lo fj)
                                               (sx-hi fj)
                                               (text/format a
                                                            "unknown field option {}"
                                                            (sexp-display a fj)))))
                           (set! bad true)
                           (break))))))
         (if (load bad)
             (load out)
             (Ok (let [nf (primitive/alloc-stack NField)]
                   (set! (.fname nf) fname)
                   (set! (.fty nf) fty)
                   (set! (.at nf) (load at))
                   (load nf)))))))

;;; A field as a `defstruct` wrote it: `(name :bits W)` is a bitfield, any other
;;; `(name T [:at N])` an ordinary field. WIDTH is -1 for an ordinary field.
(defstruct WrittenField [(field Field) (at (Option i64)) (width i64)])

(defn parse-struct-field [(a (dyn Allocator)) (f Sexp)]
  (-> (Result WrittenField Diag))
  (try (if (and (= (sx-tag f) 6)
                (>= (sx-len (sx-items f)) 2)
                (= (sx-tag (sx-at (sx-items f) 1)) 3)
                (= (sx-sval (sx-at (sx-items f) 1)) "bits"))
           (let [b (try! (parse-bitfield a f))]
             (Ok (WrittenField
                   :field
                     (Field :name (.fname b) :ty (TInt (.width b) (.signed b)))
                   :at (None [i64])
                   :width (.width b))))
           (let [nf (try! (parse-normal-field a f))]
             (Ok (WrittenField
                   :field (Field :name (.fname nf) :ty (.fty nf))
                   :at (.at nf)
                   :width -1))))))

(defn layout-error [(a (dyn Allocator)) (name (slice u8)) (message (slice u8))]
  (-> Diag)
  (derr (text/format a "defstruct '{}': {}" name message)))

;;; The layout of struct NAME, given the coil.layout.Layout it names (None when
;;; it names none) and what it wrote about its fields. With no layout a struct
;;; is C, or explicit when its fields give `:at` offsets.
(defn finalize-layout [(a (dyn Allocator))
                       (name (slice u8))
                       (kind (Option layout/Layout))
                       (pending (ptr PendingLayout))
                       (fields (ptr (ArrayList Field)))]
  (-> (Result Layout Diag))
  (try (let [ats (load (.ats pending))
             widths (load (.widths pending))
             n (len ats)
             anyat
               (block :found
                 (for i (range 0 n)
                   (match (get ats i)
                     (Some [_] (break :found true))
                     (None [] 0)))
                 false)
             bitfield
               (block :found
                 (for i (range 0 n)
                   (when (>= (get widths i) 0) (break :found i)))
                 -1)
             explicit
               (match kind
                 (Some [(layout/Explicit)] true)
                 (None [] anyat)
                 (_ false))
             bits (match kind (Some [(layout/Bits)] true) (_ false))]
         (when (and (>= bitfield 0) (not bits))
           (break
             :try
               (Err [Layout Diag]
                    (layout-error a
                                  name
                                  (text/format a
                                               "field '{}' is a bitfield, and only a (layout/Bits) struct has them"
                                               (.name (elem fields bitfield)))))))
         (when (and (>= (.backing pending) 0) (not bits))
           (break
             :try
               (Err [Layout Diag]
                    (layout-error a
                                  name
                                  ":backing applies to a (layout/Bits) struct"))))
         (when (and (not explicit)
                    (or (match (.size pending) (Some [_] true) (None [] false))
                        (> (.align pending) 0)))
           (break
             :try
               (Err [Layout Diag]
                    (layout-error a
                                  name
                                  ":size and :align apply to a (layout/Explicit) struct"))))
         (when (and anyat (not explicit))
           (break
             :try
               (Err [Layout Diag]
                    (layout-error a
                                  name
                                  ":at applies to the fields of a (layout/Explicit) struct"))))
         (cond bits
                 (let [(mut offsets) (ArrayList::new [i64] a)
                       (mut acc) 0]
                   (for i (range 0 n)
                     (let [w (get widths i)]
                       (when (< w 0)
                         (break
                           :try
                             (Err [Layout Diag]
                                  (layout-error a
                                                name
                                                (text/format a
                                                             "field '{}' of a (layout/Bits) struct must be a bitfield, (name :bits N|iN|uN)"
                                                             (.name (elem fields
                                                                          i)))))))
                       (push! (mut offsets) (load acc))
                       (set! acc (+ (load acc) w))))
                   (let [backing
                           (try! (compute-backing a
                                                  name
                                                  (load acc)
                                                  (.backing pending)))]
                     ; Backends without integers wider than a register read and
                     ; write a field of a wider backing through the one 64-bit
                     ; word that holds it, so a field must not cross words.
                     (when (> backing 64)
                       (for i (range 0 n)
                         (let [lo (get (load offsets) i)
                               hi (- (+ lo (get widths i)) 1)]
                           (when (!= (/ lo 64) (/ hi 64))
                             (break
                               :try
                                 (Err [Layout Diag]
                                      (layout-error a
                                                    name
                                                    (text/format a
                                                                 "field '{}' spans bits {}-{}, across a 64-bit word: in a backing wider than 64 bits each field lies within one 64-bit word; move it or put a padding field before it"
                                                                 (.name (elem fields
                                                                              i))
                                                                 (i64->str a
                                                                           lo)
                                                                 (i64->str a
                                                                           hi)))))))))
                     (Ok (LBits backing (box-al a (load offsets))))))
               explicit
                 (let [(mut offsets) (ArrayList::new [i64] a)]
                   (for i (range 0 n)
                     (match (get ats i)
                       (Some [o] (push! (mut offsets) o))
                       (None []
                             (break
                               :try
                                 (Err [Layout Diag]
                                      (layout-error a
                                                    name
                                                    "explicit layout needs :at on every field"))))))
                   (Ok (LExplicit
                         :offsets (box-al a (load offsets))
                         :size (.size pending)
                         :align (.align pending))))
               :else
                 (Ok (match kind
                       (Some [(layout/Packed)] (LPacked))
                       (Some [(layout/Align [bytes])] (LAligned bytes))
                       (_ (LC))))))))

(defstruct StructOpts
  [(layout (Option (ptr Expr)))
   (exp-size i64)
   (has-size bool)
   (exp-align i64)
   (backing i64)
   (next i64)
   (annotations (ptr (ArrayList Annotation)))])

;;; Whether V is a `:layout` value as Coil spelled it before coil.layout: a bare
;;; c, packed, explicit or bits, or (align N). Read only to say what replaced it.
(defn layout-old-spelling? [(v Sexp)] (-> bool)
  (or (and (= (sx-tag v) 2)
           (let [vs (sx-sval v)]
             (or (= vs "c") (= vs "packed") (= vs "explicit") (= vs "bits"))))
      (and (= (sx-tag v) 6)
           (> (sx-len (sx-items v)) 0)
           (= (sx-tag (sx-at (sx-items v) 0)) 2)
           (= (sx-sval (sx-at (sx-items v) 0)) "align"))))

(defn parse-struct-opts [(a (dyn Allocator))
                         (rest (ptr (ArrayList Sexp)))
                         (start i64)] (-> (Result StructOpts Diag))
  (try (let [(mut anns) (ArrayList::new [Annotation] a)
             (mut layout) (None [(ptr Expr)])
             (mut exp-size) -1
             (mut has-size) false
             (mut exp-align) 0
             (mut backing) -1
             (mut i) start]
         (loop (match (sx-get rest (load i))
                 (None [] (break))
                 (Some [kw]
                       (if (not (= (sx-tag kw) 3))
                           (break)
                           (let [val
                                   (try! (need [Sexp]
                                               (sx-get rest (+ (load i) 1))
                                               (text/format a
                                                            "defstruct: ':{}' missing value"
                                                            (sx-sval kw))))
                                 k (sx-sval kw)]
                             (cond (= k "layout")
                                     (if (layout-old-spelling? val)
                                         (break
                                           :try
                                             (Err [StructOpts Diag]
                                                  (derr-at (sx-lo val)
                                                           (sx-hi val)
                                                           (text/format a
                                                                        ":layout {} is now a coil.layout.Layout value, such as :layout (layout/Packed) or :layout (layout/Align 16), with (import \"coil.layout\" :as layout)"
                                                                        (sexp-display a
                                                                                      val)))))
                                         (set! layout
                                               (Some (box-expr a
                                                               (try! (parse-expr a
                                                                                 val))))))
                                   (= k "size")
                                     (do
                                       (set! exp-size
                                             (try! (int-val a val "size")))
                                       (set! has-size true))
                                   (= k "align")
                                     (set! exp-align
                                           (try! (pow2 (sx-get rest
                                                               (+ (load i) 1)))))
                                   (= k "backing")
                                     (let [bb
                                             (type-int-bits (try! (parse-type a
                                                                              val)))]
                                       (if (< bb 0)
                                           (break
                                             :try
                                               (Err [StructOpts Diag]
                                                    (derr-at (sx-lo val)
                                                             (sx-hi val)
                                                             ":backing must be an integer type")))
                                           (set! backing bb)))
                                   ; any other `:key value` is a declaration annotation
                                   :else
                                     (push! (mut anns)
                                            (Annotation
                                              :key k
                                              :value (try! (parse-expr a val)))))
                             (set! i (+ (load i) 2)))))))
         (Ok (StructOpts
               :layout (load layout)
               :exp-size (load exp-size)
               :has-size (load has-size)
               :exp-align (load exp-align)
               :backing (load backing)
               :next (load i)
               :annotations (box-al a (load anns)))))))

(defn parse-defstruct [(a (dyn Allocator)) (rest (ptr (ArrayList Sexp)))]
  (-> (Result StructDef Diag))
  (try (let [namef
               (try! (need [Sexp] (sx-get rest 0) "defstruct: missing name"))
             _namecheck (try! (definition-type-name a namef "struct"))
             _source-binder (source-nonreference! namef)
             name (lexical-name a namef)
             opts (try! (parse-struct-opts a rest 1))
             tpr (try! (parse-type-params a rest (.next opts)))
             i (if (.consumed tpr) (+ (.next opts) 1) (.next opts))
             fields-items
               (if (opt-is-vec (sx-get rest i))
                   (sx-items (opt-get (sx-get rest i)))
                   (break
                     :try
                       (Err [StructDef Diag]
                            (derr (text/format a
                                               "defstruct '{}': expected a field vector"
                                               name)))))
             (mut fields) (ArrayList::new [Field] a)
             (mut ats) (ArrayList::new [(Option i64)] a)
             (mut widths) (ArrayList::new [i64] a)]
         (for fi (range 0 (sx-len fields-items))
           (let [wf (try! (parse-struct-field a (sx-at fields-items fi)))]
             (push! (mut fields) (.field wf))
             (push! (mut ats) (.at wf))
             (push! (mut widths) (.width wf))))
         (let [pending
                 (box! a
                       PendingLayout
                       (PendingLayout
                         :size
                           (if (.has-size opts)
                               (Some (.exp-size opts))
                               (None [i64]))
                         :align (.exp-align opts)
                         :backing (.backing opts)
                         :ats (box-al a (load ats))
                         :widths (box-al a (load widths))))
               boxed-fields (box-al a (load fields))
               layout
                 (match (.layout opts)
                   (Some [value] (LayoutWritten value pending))
                   (None []
                         (try! (finalize-layout a
                                                name
                                                (None [layout/Layout])
                                                pending
                                                boxed-fields))))]
           (Ok (StructDef
                 :name name
                 :type_params (.params tpr)
                 :bounds (.bounds tpr)
                 :layout layout
                 :fields boxed-fields
                 :annotations (.annotations opts)
                 :span_source -1
                 :span_lo 0
                 :span_hi 0))))))

(defn linker-symbol-valid? [(symbol (slice u8))] (-> bool)
  (let [(mut valid) (> (len symbol) 0)]
    (for [i 0 (len symbol)]
      (when (= (get symbol i) (: 0 u8)) (set! valid false) 0)
      0)
    (load valid)))

; `(primitive/machine-code ARCH BYTE…)` parses to an `EIntrinsic`
; IMachineCodeSource whose one argument is ARCH, a `coil.core.Arch` value. The
; checker admits it only as the whole body of a `defn` and, once ARCH is known,
; rewrites it to IMachineCode, which names the architecture as a triple spells
; it; the backends read only that form and emit the function as its bytes
; followed by the target's return instruction.

;;; A checked machine-code body: the architecture, as a triple spells it, and
;;; the bytes.
(defstruct MachineCodeBody [(arch (slice u8)) (bytes (ptr (ArrayList u8)))])

;;; Whether F's whole body is machine code, checked or not.
(defn func-machine-code-body? [(f (ptr Func))] (-> bool)
  (let [body (.body f)]
    (and (= (len (load body)) 1)
         (match (.kind (elem body 0))
           (EIntrinsic [op _ _]
                       (match op
                         (IMachineCodeSource [_] true)
                         (IMachineCode [_ _] true)
                         (_ false)))
           (_ false)))))

;;; The checked machine-code body of a function whose whole body is one.
(defn func-machine-code [(f (ptr Func))] (-> (Option MachineCodeBody))
  (let [body (.body f)]
    (if (= (len (load body)) 1)
        (match (.kind (elem body 0))
          (EIntrinsic [op _ _]
                      (match op
                        (IMachineCode [arch bytes]
                                      (Some (MachineCodeBody
                                              :arch arch
                                              :bytes bytes)))
                        (_ (None [MachineCodeBody]))))
          (_ (None [MachineCodeBody])))
        (None [MachineCodeBody]))))

;;; Whether a machine-code function returns: the checker gives its body the
;;; declared return type, and only `never` means the bytes do not.
(defn func-machine-code-returns? [(f (ptr Func))] (-> bool)
  (match (.kind (elem (.body f) 0))
    (EIntrinsic [_ result _] (match result (TNever [] false) (_ true)))
    (_ true)))

;;; Whether a machine-code function's callers hold its bytes in place of a
;;; call: it is annotated `:inline (Always)` or `:inline (Hint)`. The checker
;;; admits either only under a `:shim` convention, whose registers are the
;;; contract the bytes keep wherever they are placed.
(defn func-machine-code-inlined? [(f (ptr Func))] (-> bool)
  (and (func-machine-code-body? f)
       (match (func-inline-policy f)
         (Some [(Always)] true)
         (Some [(Hint)] true)
         (_ false))))

;;; RISC-V's ABI names, by register number; -1 for any other name.
(defn riscv-abi-name-number [(r (slice u8))] (-> i64)
  (cond (= r "ra") 1
        (= r "sp") 2
        (= r "gp") 3
        (= r "tp") 4
        (= r "t0") 5
        (= r "t1") 6
        (= r "t2") 7
        (or (= r "s0") (= r "fp")) 8
        (= r "s1") 9
        (= r "a0") 10
        (= r "a1") 11
        (= r "a2") 12
        (= r "a3") 13
        (= r "a4") 14
        (= r "a5") 15
        (= r "a6") 16
        (= r "a7") 17
        (= r "s2") 18
        (= r "s3") 19
        (= r "s4") 20
        (= r "s5") 21
        (= r "s6") 22
        (= r "s7") 23
        (= r "s8") 24
        (= r "s9") 25
        (= r "s10") 26
        (= r "s11") 27
        (= r "t3") 28
        (= r "t4") 29
        (= r "t5") 30
        (= r "t6") 31
        :else -1))

; `x` followed by a decimal register number no greater than MAX.
(defn numbered-xreg? [(reg (slice u8)) (max i64)] (-> bool)
  (let [n (len reg)]
    (if (or (< n 2)
            (!= (primitive/cast i64 (get reg 0)) 120))
        false
        (let [(mut i) 1
              (mut v) 0
              (mut ok) true]
          (loop (if (or (>= (load i) n) (not (load ok)))
                    (break)
                    (let [c (primitive/cast i64 (get reg (load i)))]
                      (if (and (>= c 48)
                               (<= c 57))
                          (do
                            (set! v
                                  (primitive/iadd (primitive/imul (load v) 10)
                                                  (primitive/isub c 48)))
                            (set! i (primitive/iadd (load i) 1)))
                          (do (set! ok false) 0)))))
          (and (load ok) (<= (load v) max))))))

(defn aarch64-xreg? [(reg (slice u8))] (-> bool)
  (numbered-xreg? reg 30))

(defn x86-gpr? [(r (slice u8))] (-> bool)
  (let [(mut ok) false]
    (when (= r "rax") (set! ok true) 0)
    (when (= r "rbx") (set! ok true) 0)
    (when (= r "rcx") (set! ok true) 0)
    (when (= r "rdx") (set! ok true) 0)
    (when (= r "rsi") (set! ok true) 0)
    (when (= r "rdi") (set! ok true) 0)
    (when (= r "rbp") (set! ok true) 0)
    (when (= r "rsp") (set! ok true) 0)
    (when (= r "r8") (set! ok true) 0)
    (when (= r "r9") (set! ok true) 0)
    (when (= r "r10") (set! ok true) 0)
    (when (= r "r11") (set! ok true) 0)
    (when (= r "r12") (set! ok true) 0)
    (when (= r "r13") (set! ok true) 0)
    (when (= r "r14") (set! ok true) 0)
    (when (= r "r15") (set! ok true) 0)
    (load ok)))

(defn aarch64-gpr? [(r (slice u8))] (-> bool)
  (let [(mut ok) (aarch64-xreg? r)]
    (when (= r "sp") (set! ok true) 0)
    (when (= r "lr") (set! ok true) 0)
    (when (= r "fp") (set! ok true) 0)
    (when (= r "xzr") (set! ok true) 0)
    (load ok)))

; x1-x31 by number or ABI name; x0 is the constant zero, not a register a
; value can be put in.
(defn riscv-gpr? [(r (slice u8))] (-> bool)
  (or (and (numbered-xreg? r 31) (!= r "x0"))
      (> (riscv-abi-name-number r) 0)))

;;; Whether REG is a general-purpose register of ARCH, as a triple spells it, that
;;; a shim convention can name. Wasm has no registers, so no name is one there.
(defn arch-gpr? [(arch (slice u8)) (reg (slice u8))] (-> bool)
  (cond (= arch "x86_64") (x86-gpr? reg)
        (= arch "aarch64") (aarch64-gpr? reg)
        (= arch "riscv32") (riscv-gpr? reg)
        :else false))

;;; REG under the one name it has on ARCH (as a triple spells it), so two
;;; spellings of a register compare equal: AArch64's `lr` and `fp` are x30 and
;;; x29, and a RISC-V ABI name is its xN.
(defn shim-reg-canon [(a (dyn Allocator)) (arch (slice u8)) (reg (slice u8))]
  (-> (slice u8))
  (cond (= arch "aarch64")
          (cond (= reg "lr") "x30"
                (= reg "fp") "x29"
                :else reg)
        (= arch "riscv32")
          (let [k (riscv-abi-name-number reg)]
            (if (< k 0) reg (text/format a "x{}" (i64->str a k))))
        :else reg))

;;; The general-purpose registers a C-convention function may change on ARCH and
;;; OS, but for the return address, which a call writes and its caller saves.
;;; AArch64's x16 and x17 are among them because a linker veneer may change them
;;; on the way to any call, and x18 because outside Darwin it is a temporary.
(defn c-caller-saved-gprs [(a (dyn Allocator))
                           (arch (slice u8))
                           (os (slice u8))] (-> (ArrayList (slice u8)))
  (let [(mut out) (ArrayList::new [(slice u8)] a)]
    (cond (= arch "x86_64")
            (do
              (push! (mut out) "rax")
              (push! (mut out) "rcx")
              (push! (mut out) "rdx")
              (push! (mut out) "rsi")
              (push! (mut out) "rdi")
              (push! (mut out) "r8")
              (push! (mut out) "r9")
              (push! (mut out) "r10")
              (push! (mut out) "r11")
              0)
          (= arch "aarch64")
            (do
              (for k (range 0 (if (= os "darwin") 18 19))
                (push! (mut out) (text/format a "x{}" (i64->str a k))))
              0)
          (= arch "riscv32")
            (do
              (for k (range 0 3)
                (push! (mut out) (text/format a "t{}" (i64->str a k))))
              (for k (range 0 8)
                (push! (mut out) (text/format a "a{}" (i64->str a k))))
              (for k (range 3 7)
                (push! (mut out) (text/format a "t{}" (i64->str a k))))
              0)
          :else 0)
    (load out)))

;;; The registers of CALLER-SAVED that a :shim convention returning in RET and
;;; clobbering CLOBBER does not say it changes, joined with ", "; "" for none.
(defn shim-unlisted-clobbers [(a (dyn Allocator))
                              (arch (slice u8))
                              (caller-saved (ArrayList (slice u8)))
                              (ret (slice u8))
                              (clobber (ptr (ArrayList (slice u8))))]
  (-> (slice u8))
  (let [(mut listed) (ArrayList::new [(slice u8)] a)
        (mut missing) ""]
    (push! (mut listed) (shim-reg-canon a arch ret))
    (for j (range 0 (len (load clobber)))
      (push! (mut listed) (shim-reg-canon a arch (get (load clobber) j))))
    (for i (range 0 (len caller-saved))
      (let [r (get caller-saved i)
            c (shim-reg-canon a arch r)]
        (unless (block :found
                  (for j (range 0 (len listed))
                    (when (= (get listed j) c) (break :found true)))
                  false)
          (set! missing
                (if (= (len missing) 0) r (text/format a "{}, {}" missing r))))))
    missing))

;;; The architecture a checked `coil.core.Arch` value names, as a triple spells
;;; it, or "" when the value is not one of its constructors.
(defn machine-code-variant-arch [(e (ptr Expr))] (-> (slice u8))
  (let [c (annotation-constructor e)]
    (cond (core-name? c "X86_64") (arch-name (X86_64))
          (core-name? c "Aarch64") (arch-name (Aarch64))
          (core-name? c "Riscv32") (arch-name (Riscv32))
          (core-name? c "Wasm32") (arch-name (Wasm32))
          (core-name? c "Wasm64") (arch-name (Wasm64))
          :else "")))

;;; Whether ARCH executes machine code; WebAssembly does not.
(defn machine-code-arch-has-code? [(arch (slice u8))] (-> bool)
  (or (= arch "x86_64") (= arch "aarch64") (= arch "riscv32")))

;;; The length of the AArch64 or RISC-V instruction at byte I: AArch64's are all
;;; four bytes; RISC-V's low bits say two (compressed) or four, and the longer
;;; encodings the base ISA reserves are 0, as is one that runs past the end.
(defn machine-code-instruction-length [(arch (slice u8))
                                       (bytes (ptr (ArrayList u8)))
                                       (i i64)] (-> i64)
  (let [n (len (load bytes))
        size
          (if (= arch "aarch64")
              4
              (let [low (primitive/cast i64 (get (load bytes) i))]
                (cond (!= (& low 3) 3) 2
                      (!= (& low 31) 31) 4
                      :else 0)))]
    (if (> (+ i size) n) 0 size)))

;;; Whether BYTES end on an instruction boundary of ARCH, so the return appended
;;; after them is an instruction of its own. x86-64 instructions have no length
;;; the compiler checks without decoding them.
(defn machine-code-whole-instructions? [(arch (slice u8))
                                        (bytes (ptr (ArrayList u8)))] (-> bool)
  (if (= arch "x86_64")
      true
      (let [(mut i) 0
            (mut whole) true]
        (while (and (load whole) (< (load i) (len (load bytes))))
          (let [size (machine-code-instruction-length arch bytes (load i))]
            (if (= size 0)
                (set! whole false)
                (set! i (+ (load i) size)))))
        (load whole))))

;;; Why function NAME, machine code for CODE-ARCH, cannot be part of a build for
;;; TARGET-ARCH, or None when it can.
(defn machine-code-target-error [(a (dyn Allocator))
                                 (name (slice u8))
                                 (code-arch (slice u8))
                                 (target-arch (slice u8))]
  (-> (Option (slice u8)))
  (if (= code-arch target-arch)
      (None [(slice u8)])
      (Some (text/format a
                         "function '{}' is machine code for {}, and this build targets {}"
                         name
                         code-arch
                         target-arch))))

;;; Append TEXT's bytes to OUT.
(defn machine-code-push-text! [(out (mut (ArrayList u8))) (text (slice u8))]
  (-> i64)
  (for i (range 0 (len text))
    (push! (mut out) (get text i)))
  0)

(defn parse-machine-code [(a (dyn Allocator))
                          (args (ptr (ArrayList Sexp)))
                          (lo i64)
                          (hi i64)] (-> (Result ExprKind Diag))
  (try (do
         (when (< (sx-len args) 2)
           (break
             :try
               (Err [ExprKind Diag]
                    (derr-at lo
                             hi
                             "machine-code: expects an architecture and at least one byte"))))
         (let [(mut operands) (ArrayList::new [Expr] a)
               (mut bytes) (ArrayList::new [u8] a)]
           (push! (mut operands) (try! (parse-expr a (sx-at args 0))))
           (for i (range 1 (sx-len args))
             (let [byte (sx-at args i)
                   v (sx-ival byte)]
               (unless (and (= (sx-tag byte) 0) (>= v 0) (<= v 255))
                 (break
                   :try
                     (Err [ExprKind Diag]
                          (derr-at (sx-lo byte)
                                   (sx-hi byte)
                                   "machine-code: each byte must be an integer literal from 0 to 255"))))
               (push! (mut bytes) (primitive/cast u8 v))))
           (Ok (EIntrinsic
                 :op (IMachineCodeSource (box-al a (load bytes)))
                 :result (TNever)
                 :args (box-al a (load operands))))))))

(defn parse-linker-symbol [(a (dyn Allocator)) (form Sexp)]
  (-> (Result (slice u8) Diag))
  (try (let [symbol
               (if (= (sx-tag form) 4)
                   (sx-sval form)
                   (try! (sym-of a form "linker symbol")))]
         (if (linker-symbol-valid? symbol)
             (Ok symbol)
             (Err (derr "linker symbol must be nonempty and contain no NUL byte"))))))

;;; A calling convention as written: a coil.cc.NativeCc constructor, `(cc/C)`,
;;; or the name of a defcc, `fast2`. WHAT names the position in a diagnostic.
(defn parse-cc-ref [(a (dyn Allocator)) (form Sexp) (what (slice u8))]
  (-> (Result CcRef Diag))
  (cond (= (sx-tag form) 2)
          (Ok [CcRef Diag] (CcWrittenName (lexical-name a form)))
        (and (= (sx-tag form) 6)
             (= (sx-len (sx-items form)) 1)
             (= (sx-tag (sx-at (sx-items form) 0)) 2))
          (Ok [CcRef Diag]
              (CcWrittenValue (lexical-name a (sx-at (sx-items form) 0))))
        :else
          (Err [CcRef Diag]
               (derr-at (sx-lo form)
                        (sx-hi form)
                        (text/format a
                                     "{}: a calling convention is a coil.cc.NativeCc value, such as (cc/C), or the name of a defcc"
                                     what)))))

(defn parse-extern [(a (dyn Allocator)) (rest (ptr (ArrayList Sexp)))]
  (-> (Result Extern Diag))
  (try (let [namef (try! (need [Sexp] (sx-get rest 0) "extern: missing name"))
             _namecheck (try! (sym-of a namef "extern name"))
             _source-binder (source-nonreference! namef)
             name (lexical-name a namef)
             (mut i) 1
             (mut cc) (cc-c)
             (mut symbol) (None [(slice u8)])
             (mut saw-cc) false
             (mut saw-as) false]
         (loop (if (>= (load i) (sx-len rest))
                   (break)
                   (let [key (sx-at rest (load i))]
                     (unless (= (sx-tag key) 3) (break) 0)
                     (let [value
                             (try! (need [Sexp]
                                         (sx-get rest (+ (load i) 1))
                                         "extern: option missing value"))]
                       (cond (= (sx-sval key) "cc")
                               (do
                                 (when (load saw-cc)
                                   (break
                                     :try (Err (derr "extern: duplicate :cc")))
                                   0)
                                 (set! saw-cc true)
                                 (store! cc
                                         (try! (parse-cc-ref a
                                                             value
                                                             "extern :cc"))))
                             (= (sx-sval key) "as")
                               (do
                                 (when (load saw-as)
                                   (break
                                     :try (Err (derr "extern: duplicate :as")))
                                   0)
                                 (unless (= (sx-tag value) 4)
                                   (break
                                     :try
                                       (Err (derr "extern: :as expects a linker-symbol string")))
                                   0)
                                 (set! saw-as true)
                                 (store! symbol
                                         (Some (try! (parse-linker-symbol a
                                                                          value)))))
                             :else
                               (break
                                 :try (Err (derr "extern: expected :cc or :as")))))
                     (set! i (+ (load i) 2)))))
         (let [params-items
                 (try! (need-vec (sx-get rest (load i))
                                 (text/format a
                                              "extern '{}': expected a vector of parameter types"
                                              name)))]
           (set! i (primitive/iadd (load i) 1))
           (let [pn (sx-len params-items)
                 variadic
                   (if (> pn 0)
                       (let [last (sx-at params-items (primitive/isub pn 1))]
                         (and (= (sx-tag last) 2)
                              (= (sx-sval last) "...")))
                       false)
                 fixed-n (if variadic (primitive/isub pn 1) pn)
                 (mut params) (ArrayList::new [Type] a)]
             (for [pi 0 fixed-n]
               (push! (mut params)
                      (match (parse-type a
                                         (sx-at params-items
                                                pi))
                        (Ok [temporary] temporary)
                        (Err [temporary] (break :try (Err temporary))))))
             (let [ret-l
                     (try! (as-list (try! (need [Sexp]
                                                (sx-get rest (load i))
                                                "extern: missing (-> :type)"))
                                    "expected (-> :type)"))]
               (when (not (= (match (head-sym a ret-l)
                               (Ok [value] value)
                               (Err [error] (break :try (Err error))))
                             "->"))
                 (break
                   :try
                     (Err [Extern Diag]
                          (derr (text/format a
                                             "extern '{}': expected (-> :type)"
                                             name)))))
               (unless (and (= (sx-len ret-l) 2)
                            (= (+ (load i) 1) (sx-len rest)))
                 (break :try (Err (derr "extern: unexpected trailing forms")))
                 0)
               (let [ret
                       (try! (parse-type a
                                         (try! (need [Sexp]
                                                     (sx-get ret-l 1)
                                                     "(-> ) missing type"))))]
                 (Ok (let [e (primitive/alloc-stack Extern)]
                       (set! (.name e) name)
                       (set! (.symbol e) (load symbol))
                       (set! (.cc e) (load cc))
                       (set! (.params e) (box-al a (load params)))
                       (set! (.variadic e) variadic)
                       (set! (.ret e) ret)
                       (let [vec-node (sx-at rest (primitive/isub (load i) 1))
                             ret-node (sx-at ret-l 1)]
                         (set! (.span_source e) (sx-source vec-node))
                         (set! (.params_lo e) (sx-lo vec-node))
                         (set! (.params_hi e) (sx-hi vec-node))
                         (set! (.ret_lo e) (sx-lo ret-node))
                         (set! (.ret_hi e) (sx-hi ret-node)))
                       (load e))))))))))

(defn parse-defcc [(a (dyn Allocator)) (rest (ptr (ArrayList Sexp)))]
  (-> (Result Convention Diag))
  (try (let [name
               (try! (sym-of a
                             (try! (need [Sexp]
                                         (sx-get rest 0)
                                         "defcc: missing name"))
                             "defcc name"))
             (mut params) (new-boxed-list [(slice u8)] a)
             (mut ret) (None [(slice u8)])
             (mut clobber) (new-boxed-list [(slice u8)] a)
             (mut preserve) (new-boxed-list [(slice u8)] a)
             (mut lower) (None [(ptr Expr)])
             (mut i) 1
             nr (sx-len rest)]
         (loop (if (>= (load i) nr)
                   (break)
                   (let [kw
                           (try! (kw-of a (sx-at rest (load i)) "defcc option"))
                         val
                           (try! (need [Sexp]
                                       (sx-get rest (primitive/iadd (load i) 1))
                                       (text/format a
                                                    "defcc: option ':{}' missing value"
                                                    kw)))]
                     (cond (= kw "params")
                             (do
                               (set! params
                                     (match (sym-vec a val "params")
                                       (Ok [value] value)
                                       (Err [error] (break :try (Err error)))))
                               0)
                           (= kw "ret")
                             (do
                               (store! ret (Some (try! (sym-of a val "ret"))))
                               0)
                           (= kw "clobber")
                             (do
                               (set! clobber
                                     (match (sym-vec a val "clobber")
                                       (Ok [value] value)
                                       (Err [error] (break :try (Err error)))))
                               0)
                           (= kw "preserve")
                             (do
                               (set! preserve
                                     (match (sym-vec a val "preserve")
                                       (Ok [value] value)
                                       (Err [error] (break :try (Err error)))))
                               0)
                           (= kw "lower")
                             (do
                               (store! lower
                                       (Some (box-expr a
                                                       (try! (parse-expr a val)))))
                               0)
                           :else
                             (break
                               :try
                                 (Err [Convention Diag]
                                      (derr-at (sx-lo (sx-at rest (load i)))
                                               (sx-hi (sx-at rest (load i)))
                                               (text/format a
                                                            "defcc: unknown option ':{}'; the options are :params, :ret, :clobber, :preserve and :lower, whose value is a coil.cc.Lowering"
                                                            kw)))))
                     (set! i (primitive/iadd (load i) 2)))))
         (let [lowering
                 (match (load lower)
                   (Some [value] (LowerWritten value))
                   (None []
                         (return-from
                           :try
                             (Err [Convention Diag]
                                  (derr (text/format a
                                                     "defcc '{}': needs a :lower value, (cc/Shim) or (cc/Reset) under (import \"coil.cc\" :as cc); a convention LLVM implements needs no defcc: write :cc (cc/Fast)"
                                                     name))))))]
           (Ok (let [c (primitive/alloc-stack Convention)]
                 (set! (.name c) name)
                 (set! (.params c) (load params))
                 (set! (.ret c) (load ret))
                 (set! (.clobber c) (load clobber))
                 (set! (.preserve c) (load preserve))
                 (set! (.lowering c) lowering)
                 (load c)))))))

; Would the parser intercept a call whose head is `name`? Uses the REAL dispatch
; (parse-list-expr) as the single source of truth — no parallel keyword list to
; drift out of sync: a plain user call `(name x)` parses to `ECall name …`, so any
; other outcome (a special form's own ExprKind, or a parse error) means `name` is a
; built-in form and a function of that name could never be *called* as `(name …)`.
; This is why shadowing `call`/`index`/`if`/… must be rejected at the definition.
(defn builtin-form-head? [(a (dyn Allocator)) (name (slice u8))] (-> bool)
  (let [(mut items) (ArrayList::new [Sexp] a)]
    (push! (mut items) (mk-sexp (KSym name) -1 -1))
    (push! (mut items) (mk-sexp (KSym "__coil_shadow_probe__") -1 -1))
    (try (let [k
                 (try-or! (parse-list-expr a
                                           (box-items a (load items))
                                           -1
                                           -1
                                           -1
                                           0)
                          true)]
           (match k (ECall [f _ta _ar] (not (= f name))) (_ true))))))

(defn parse-defn [(a (dyn Allocator))
                  (rest (ptr (ArrayList Sexp)))
                  (allow-call bool)] (-> (Result Func Diag))
  (try (let [namef (try! (need [Sexp] (sx-get rest 0) "defn: missing name"))
             raw-name (try! (sym-of a namef "defn name"))
             _source-binder (source-nonreference! namef)
             ; Impl method heads select a member of the explicitly named trait;
             ; they are interface labels, not new lexical/global bindings.
             ; Parameters/body references remain ordinary scoped identifiers.
             name (if allow-call raw-name (lexical-name a namef))
             (mut i) 1
             (mut cc) (cc-c)
             (mut annotations) (ArrayList::new [Annotation] a)]
         (when (and (builtin-form-head? a raw-name)
                    (not (and allow-call (= raw-name "call"))))
           (break
             :try
               (Err [Func Diag]
                    (derr-at (sx-lo namef)
                             (sx-hi namef)
                             (text/format a
                                          "cannot define '{}': it is a built-in form and can never be called as ({} …); rename the function"
                                          name
                                          name)))))
         (match (sx-get rest (load i))
           (Some [k]
                 (when (and (= (sx-tag k) 3)
                            (= (sx-sval k) "cc"))
                   (store! cc
                           (try! (parse-cc-ref a
                                               (try! (need [Sexp]
                                                           (sx-get rest
                                                                   (primitive/iadd (load i)
                                                                                   1))
                                                           "defn: ':cc' missing its convention"))
                                               "defn :cc")))
                   (set! i (primitive/iadd (load i) 2))
                   0))
           (None [] 0))
         ; All other leading keyword/expression pairs are open declaration
         ; annotations. Their keys and value types are resolved later against
         ; `defannotation` declarations.
         (store! i
                 (try! (parse-annotation-pairs a
                                               rest
                                               (load i)
                                               0
                                               (text/format a "defn '{}'" name)
                                               (mut annotations))))
         (let [tpr (primitive/alloc-stack TPResult)]
           (set! tpr
                 (match (parse-type-params a rest (load i))
                   (Ok [value] value)
                   (Err [error] (break :try (Err error)))))
           (when (.consumed tpr)
             (set! i (primitive/iadd (load i) 1))
             0)
           (let [params-items
                   (try! (need-vec (sx-get rest (load i))
                                   (text/format a
                                                "defn '{}': expected parameter vector"
                                                name)))]
             (set! i (primitive/iadd (load i) 1))
             (let [(mut params) (ArrayList::new [Param] a)
                   (mut macrov) false
                   np (sx-len params-items)
                   (mut pi) 0]
               ; Two-argument set! is assignment syntax. Reject precisely the
               ; uncallable definition while leaving the three-argument Set trait
               ; method available to impls.
               (when (and (= raw-name "set!") (= np 2))
                 (break
                   :try
                     (Err [Func Diag]
                          (derr-at (sx-lo namef)
                                   (sx-hi namef)
                                   "cannot define two-argument 'set!': that arity is reserved for place assignment"))))
               (loop (if (>= (load pi) np)
                         (break)
                         (let [p (sx-at params-items (load pi))]
                           (set! pi (primitive/iadd (load pi) 1))
                           (if (and (= (sx-tag p) 2)
                                    (= (sx-sval p) "&"))
                               (do (set! macrov true) 0)
                               (let [pl
                                       (try! (as-list p
                                                      "parameter must be (name :type)"))
                                     positional-only
                                       (and (= (sx-len pl) 3)
                                            (and (= (sx-tag (sx-at pl 0)) 3)
                                                 (= (sx-sval (sx-at pl 0))
                                                    "positional")))
                                     pnf (sx-at pl (if positional-only 1 0))
                                     _pncheck (try! (sym-of a pnf "param name"))
                                     _source-binder (source-nonreference! pnf)
                                     pn (lexical-name a pnf)
                                     pt
                                       (try! (parse-type a
                                                         (try! (need [Sexp]
                                                                     (sx-get pl
                                                                             (if positional-only
                                                                                 2
                                                                                 1))
                                                                     "param missing type"))))]
                                 (let [(mut pp) (zeroed Param)]
                                   (set! (.bid pp) 0)
                                   (set! (.positional_only pp) positional-only)
                                   (set! (.owned_type pp)
                                         (primitive/cast (ptr Type) 0))
                                   (if (type-pack-var? (box-type a pt))
                                       (if (and (< (load pi) np)
                                                (= (sx-tag (sx-at params-items
                                                                  (load pi)))
                                                   2)
                                                (= (sx-sval (sx-at params-items
                                                                   (load pi)))
                                                   "..."))
                                           (do
                                             (set! (.name pp)
                                                   (text/format a "{}..." pn))
                                             (set! pi
                                                   (primitive/iadd (load pi)
                                                                   1)))
                                           (break
                                             :try
                                               (Err [Func Diag]
                                                    (derr-at (sx-lo p)
                                                             (sx-hi p)
                                                             "a pack-typed parameter must be followed by ..."))))
                                       (set! (.name pp) pn))
                                   (set! (.ty pp) pt)
                                   (push! (mut params) pp)))))))
               (let [ret-l
                       (try! (as-list (try! (need [Sexp]
                                                  (sx-get rest (load i))
                                                  "defn: missing (-> :type)"))
                                      "expected (-> :type)"))]
                 (when (not (= (match (head-sym a ret-l)
                                 (Ok [value] value)
                                 (Err [error] (break :try (Err error))))
                               "->"))
                   (break
                     :try
                       (Err [Func Diag]
                            (derr "defn: expected (-> :type) after params"))))
                 (let [ret
                         (try! (parse-type a
                                           (try! (need [Sexp]
                                                       (sx-get ret-l 1)
                                                       "(-> ) missing type"))))]
                   (set! i (primitive/iadd (load i) 1))
                   ; An empty body is SYNTACTICALLY fine — it is a body of type void,
                   ; and the checker reports the mismatch against a non-void return
                   ; type. Rejecting it here produced "empty body", which reads like the
                   ; body was lost to a paren bug; the type error names the real problem
                   ; and `(defn f [] (-> void))` is legitimately empty.
                   (let [body
                           (try! (parse-function-body a
                                                      (rest-from a
                                                                 rest
                                                                 (load i))))]
                     (Ok (let [(mut f) (zeroed Func)]
                           (set! (.name f) name)
                           (set! (.type_params f) (.params tpr))
                           (set! (.bounds f) (.bounds tpr))
                           (set! (.cc f) (load cc))
                           (set! (.annotations f)
                                 (box-al a (load annotations)))
                           (set! (.params f) (box-al a (load params)))
                           (set! (.ret f) ret)
                           (set! (.body f) body)
                           (set! (.macro_variadic f) (load macrov))
                           (init-fields! f -1 [lo hi source])
                           (set! (.ctxt f) 0)
                           (set! (.declared f) false)
                           (set! (.lazy f) (primitive/cast (ptr i8) 0))
                           f)))))))))))

; `(declare NAME [params] (-> ret))`: the signature of a function defined in
; another compilation unit. Parsed as a `defn` head so parameters, conventions
; and annotations read the same way; what a declaration cannot have is exactly
; what would need this unit to hold the definition: a body, or type parameters
; (a generic is instantiated wherever it is used, so it has no single object to
; link against).
(defn parse-declare [(a (dyn Allocator))
                     (rest (ptr (ArrayList Sexp)))] (-> (Result Func Diag))
  (match (parse-defn a rest false)
    (Err [d] (Err [Func Diag] d))
    (Ok [f0]
        (let [f (primitive/alloc-stack Func)]
          (set! f f0)
          (cond (> (len (load (.type_params f))) 0)
                  (Err [Func Diag]
                       (derr (text/format a
                                          "declare '{}': a declared function cannot be generic; a generic is instantiated wherever it is used, so there is no single definition to link"
                                          (.name f))))
                (> (len (load (.body f))) 0)
                  (Err [Func Diag]
                       (derr (text/format a
                                          "declare '{}': a declaration has no body; use defn to define the function here"
                                          (.name f))))
                :else
                  (do
                    (set! (.declared f) true)
                    (Ok (load f))))))))

;;; `(declare NAME TYPE)`: runtime storage of TYPE that another compilation unit
;;; defines, as a `def` there. A function declaration has a parameter vector and a
;;; return type; this has only the type, so the two never read alike.
(defn declare-storage? [(rest (ptr (ArrayList Sexp)))] (-> bool)
  (= (sx-len rest) 2))

(defn parse-declare-storage [(a (dyn Allocator)) (rest (ptr (ArrayList Sexp)))]
  (-> (Result Const Diag))
  (try (let [namef (try! (need [Sexp] (sx-get rest 0) "declare: missing name"))
             _namecheck (try! (sym-of a namef "declare name"))
             ty (try! (parse-type a (sx-at rest 1)))
             d (primitive/alloc-stack Const)]
         (set! (.name d) (lexical-name a namef))
         (set! (.ty d) (Some ty))
         ; No value: the defining unit holds it.
         (set! (.value d) (mk-expr (EInt 0) -1 -1 -1 0))
         (set! (.runtime d) true)
         (set! (.declared d) true)
         (set! (.annotations d)
               (new-boxed-list [Annotation] a))
         (Ok (load d)))))

; ---- impl-target helpers ----
; The dispatch KEY a type carries an impl under: nominal types by (base) name,
; scalars by spelling, and each structural type by a pseudo-name ("slice", "ptr",
; "array", "vec", "fn") — so structural types are first-class impl targets, not
; second-class ones. "" = can't carry an impl (void/ref/never/code/externref).
;
; The key names only the head CONSTRUCTOR: `(Pair i64 i64)` and `(Pair A B)` both
; key to "Pair", and every pointer type keys to "ptr". So the key is an INDEX, not
; an identity — it narrows the candidates, and `check.coil::impl-match` then matches
; the receiver against the impl's own `self_type` pattern. Keep this in sync with
; `check.coil::type-impl-name`/`has-impl-name`, which mirror it on type tags.
(defn impl-base-name [(a (dyn Allocator)) (t (ptr Type))] (-> (slice u8))
  (match (load t)
    (TStruct [n] n)
    (TApp [n _args] n)
    (TInt [b s] (sconcat a (if s "i" "u") (i64->str a b)))
    (TBool [] "bool")
    (TFloat [b] (text/format a "f{}" (i64->str a b)))
    (TSlice [_e] "slice")
    (TPtr [_e] "ptr")
    (TArray [_e _n] "array")
    (TVec [_e _n] "vec")
    (TFn [_cc _p _r] "fn")
    ; Code is a first-class value in the compiled metaprogram engine (checkers pass
    ; it around, store it in HashMaps), so it can carry impls like any other data
    ; type — e.g. `impl Display Code` for metaprogram diagnostics. Its methods take a
    ; Code param, so they are comptime-only functions dropped before mono
    ; (mono.coil::func-has-code) — no codegen impact. void/ref/never/externref stay
    ; impl-less: they are non-values, places, or opaque host handles.
    (TCode [] "code")
    (TCodeBuilder [] "codebuilder")
    (_ "")))

; Does `t` mention `nm` as a nominal type reference (a type parameter is a bare
; TStruct reference)?
(defn type-list-mentions-name [(v (ptr (ArrayList Type))) (nm (slice u8))]
  (-> bool)
  (let [n (len (load v))
        (mut r) false]
    (for [i 0 n]
      (let [(mut tv) (: (get (load v) i) Type)]
        (when (type-mentions-name (mut tv) nm) (set! r true) 0)))
    (load r)))

(defn extent-mentions-name [(n Extent) (nm (slice u8))] (-> bool)
  (match n (ParamExtent [name] (= name nm)) (FixedExtent [_] false)))

(defn type-mentions-name [(t (ptr Type)) (nm (slice u8))] (-> bool)
  (match (load t)
    (TStruct [n] (= n nm))
    (TApp [n args] (or (= n nm) (type-list-mentions-name args nm)))
    (TPtr [p] (type-mentions-name p nm))
    (TRef [_m p] (type-mentions-name p nm))
    (TSlice [p] (type-mentions-name p nm))
    (TArray [p n] (or (extent-mentions-name n nm) (type-mentions-name p nm)))
    (TVec [p n] (or (extent-mentions-name n nm) (type-mentions-name p nm)))
    (TFn [_cc ps r]
         (or (type-list-mentions-name ps nm) (type-mentions-name r nm)))
    (_ false)))

(defn parse-trait-method [(a (dyn Allocator)) (m Sexp)]
  (-> (Result TraitMethod Diag))
  (try (let [ml
               (try! (as-list m "trait method must be (name [params] (-> ret))"))
             mname
               (try! (sym-of a
                             (try! (need [Sexp]
                                         (sx-get ml 0)
                                         "trait method: missing name"))
                             "method name"))
             (mut i) 1
             (mut annotations) (ArrayList::new [Annotation] a)]
         (loop (match (sx-get ml (load i))
                 (Some [k]
                       (if (= (sx-tag k) 3)
                           (let [vp
                                   (try! (need [Sexp]
                                               (sx-get ml
                                                       (primitive/iadd (load i)
                                                                       1))
                                               (text/format a
                                                            "trait method '{}': annotation missing value"
                                                            mname)))
                                 ap (primitive/alloc-stack Annotation)]
                             (set! (.key ap) (sx-sval k))
                             (store! (field ap value) (try! (parse-expr a vp)))
                             (push! (mut annotations) (load ap))
                             (set! i (primitive/iadd (load i) 2)))
                           (break)))
                 (None [] (break))))
         (if (>= (load i) (sx-len ml))
             (Err [TraitMethod Diag]
                  (derr-at (sx-lo m)
                           (sx-hi m)
                           (text/format a
                                        "trait method '{}': missing typed signature"
                                        mname)))
             (let [params-items
                     (if (opt-is-vec (sx-get ml (load i)))
                         (sx-items (opt-get (sx-get ml (load i))))
                         (break
                           :try
                             (Err [TraitMethod Diag]
                                  (derr-at (sx-lo m)
                                           (sx-hi m)
                                           (text/format a
                                                        "trait method '{}': expected a param vector"
                                                        mname)))))
                   (mut params) (ArrayList::new [Param] a)
                   pn (sx-len params-items)
                   (mut pi) 0]
               (loop (if (>= (load pi) pn)
                         (break)
                         (let [pl
                                 (try! (as-list (sx-at params-items (load pi))
                                                "method param must be (name :type)"))
                               pp (primitive/alloc-stack Param)]
                           (set! (.bid pp) 0)
                           (set! (.positional_only pp) false)
                           (set! (.owned_type pp) (primitive/cast (ptr Type) 0))
                           (set! pi (primitive/iadd (load pi) 1))
                           (let [pnf (sx-at pl 0)]
                             (try! (sym-of a pnf "param name"))
                             (set! (.name pp) (lexical-name a pnf)))
                           (store! (field pp ty)
                                   (try! (parse-type a
                                                     (try! (need [Sexp]
                                                                 (sx-get pl 1)
                                                                 "method param missing type")))))
                           (when (type-pack-var? (field pp ty))
                             (if (and (< (load pi) pn)
                                      (= (sx-tag (sx-at params-items (load pi)))
                                         2)
                                      (= (sx-sval (sx-at params-items (load pi)))
                                         "..."))
                                 (do
                                   (set! (.name pp)
                                         (text/format a "{}..." (.name pp)))
                                   (set! pi (primitive/iadd (load pi) 1)))
                                 (break
                                   :try
                                     (Err [TraitMethod Diag]
                                          (derr-at (sx-lo m)
                                                   (sx-hi m)
                                                   "a pack-typed method parameter must be followed by ...")))))
                           (push! (mut params) (load pp)))))
               (let [ret-l
                       (try! (as-list (try! (need [Sexp]
                                                  (sx-get ml
                                                          (primitive/iadd (load i)
                                                                          1))
                                                  "trait method: missing (-> ret)"))
                                      "expected (-> ret)"))]
                 (when (not (= (try! (head-sym a ret-l)) "->"))
                   (break
                     :try
                       (Err [TraitMethod Diag]
                            (derr-at (sx-lo m)
                                     (sx-hi m)
                                     (text/format a
                                                  "trait method '{}': expected (-> ret)"
                                                  mname)))))
                 (let [mp (primitive/alloc-stack TraitMethod)]
                   (set! (.name mp) mname)
                   (set! (.annotations mp)
                         (box-al a (load annotations)))
                   (set! (.params mp) (box-al a (load params)))
                   (store! (field mp ret)
                           (try! (parse-type a
                                             (try! (need [Sexp]
                                                         (sx-get ret-l 1)
                                                         "(-> ) missing type")))))
                   (Ok (load mp)))))))))

(defn parse-deftrait [(a (dyn Allocator)) (rest (ptr (ArrayList Sexp)))]
  (-> (Result TraitDef Diag))
  (try (let [namef (try! (need [Sexp] (sx-get rest 0) "deftrait: missing name"))
             _namecheck (try! (definition-type-name a namef "trait"))
             _source-binder (source-nonreference! namef)
             name (lexical-name a namef)
             ; [Self …]: the first entry is Self; any further entries are EXTRA
             ; trait type parameters, determined by Self.
             tp-items
               (if (and (opt-is-vec (sx-get rest 1))
                        (> (sx-len (sx-items (opt-get (sx-get rest 1))))
                           0))
                   (sx-items (opt-get (sx-get rest 1)))
                   (return-from
                     :try
                       (Err [TraitDef Diag]
                            (derr "deftrait: expected [Self …] after the name"))))
             ; A trait's type parameters are BINDERS: the method signatures below
             ; refer to them as types, and those references keep their lexical
             ; identity. Taking the spelling here made the two sides unmatchable
             ; in a generated trait -- `method 'm': needs a Self (Self) parameter`.
             self-param
               (try! (lexical-sym-of a
                                     (sx-at tp-items 0)
                                     "trait type parameter"))
             (mut type-params) (ArrayList::new [(slice u8)] a)
             (mut requires) (ArrayList::new [(slice u8)] a)
             ntp (sx-len tp-items)
             (mut tpi) 1
             (mut methods) (ArrayList::new [TraitMethod] a)
             nr (sx-len rest)
             (mut mi) 2]
         (loop (if (>= (load tpi) ntp)
                   (break)
                   (do
                     (push! (mut type-params)
                            (match (lexical-sym-of a
                                                   (sx-at tp-items (load tpi))
                                                   "trait type parameter")
                              (Ok [temporary] temporary)
                              (Err [temporary] (break :try (Err temporary)))))
                     (set! tpi (primitive/iadd (load tpi) 1)))))
         ; optional `:requires [Base …]` supertrait clause, sitting between the type-param
         ; vector and the methods (gen-8). It keeps supertraits OFF the `[Self …]` axis, which
         ; is for associated-type parameters — the two used to share one vector and silently
         ; mean different things. When present, methods start after it (primitive/index 4).
         (match (sx-get rest 2)
           (Some [k]
                 (when (and (= (sx-tag k) 3)
                            (= (sx-sval k) "requires"))
                   (let [rv
                           (try! (need [Sexp]
                                       (sx-get rest 3)
                                       "deftrait: ':requires' needs a [Base …] vector"))]
                     (when (not (= (sx-tag rv) 7))
                       (break
                         :try
                           (Err [TraitDef Diag]
                                (derr-at (sx-lo rv)
                                         (sx-hi rv)
                                         "deftrait: ':requires' needs a [Base …] vector"))))
                     (let [ri (sx-items rv)
                           nri (sx-len ri)
                           (mut rj) 0]
                       (loop (if (>= (load rj) nri)
                                 (break)
                                 (do
                                   ; same for a supertrait in `:requires`
                                   (push! (mut requires)
                                          (match (lexical-sym-of a
                                                                 (sx-at ri
                                                                        (load rj))
                                                                 "supertrait name")
                                            (Ok [temporary] temporary)
                                            (Err [temporary]
                                                 (break :try (Err temporary)))))
                                   (set! rj (primitive/iadd (load rj) 1))))))
                     (set! mi 4)
                     0)))
           (None [] 0))
         (loop (if (>= (load mi) nr)
                   (break)
                   (do
                     (push! (mut methods)
                            (match (parse-trait-method a (sx-at rest (load mi)))
                              (Ok [temporary] temporary)
                              (Err [temporary] (break :try (Err temporary)))))
                     (set! mi (primitive/iadd (load mi) 1)))))
         (Ok (let [(mut t) (zeroed TraitDef)]
               (set! (.name t) name)
               (set! (.self_param t) self-param)
               (set! (.type_params t)
                     (box-al a (load type-params)))
               (set! (.requires t) (box-al a (load requires)))
               (set! (.methods t) (box-al a (load methods)))
               t)))))

; Dynamic-trait layouts are compiler-owned declarations.  Creating them while the
; trait itself is parsed makes `(dyn Trait)` available to every later type position,
; including while the metaprogram context is being assembled (before a source-level
; `defdyn` call could have expanded).  The names remain an internal lowering detail;
; resolution exposes them through the originating trait, not as separately exported
; declarations.
(defn dyn-vtable-fields [(a (dyn Allocator)) (td (ptr TraitDef))]
  (-> (ptr (ArrayList Field)))
  (let [methods (.methods td)
        n (len (load methods))
        (mut fields) (ArrayList::new [Field] a)]
    (for [i 0 n]
      (let [mp (index (.data methods) i)
            ps (.params mp)
            np (len (load ps))
            (mut erased) (ArrayList::new [Type] a)]
        (for [j 0 np]
          (if (= j 0)
              (push! (mut erased)
                     (TPtr (box-type a (TInt 8 false))))
              (push! (mut erased)
                     (.ty (index (.data ps)
                                 j)))))
        (let [(mut fp) (zeroed Field)]
          (set! (.name fp) (.name mp))
          (set! (.ty fp)
                (TFn
                  :cc (cc-c)
                  :params (box-al a (load erased))
                  :ret (box-type a (.ret mp))))
          (push! (mut fields) fp))))
    (box-al a (load fields))))

(defn dyn-struct-def [(a (dyn Allocator)) (td (ptr TraitDef)) (vtable bool)]
  (-> StructDef)
  (let [name (.name td)
        vtname (text/format a "{}-vtable" name)
        (mut fields) (ArrayList::new [Field] a)]
    (if vtable
        (let [generated (dyn-vtable-fields a td)]
          (set! fields (load generated)))
        (let [(mut dataf) (zeroed Field)
              (mut vtf) (zeroed Field)]
          (set! (.name dataf) "data")
          (set! (.ty dataf) (TPtr (box-type a (TInt 8 false))))
          (push! (mut fields) dataf)
          (set! (.name vtf) "vtable")
          (set! (.ty vtf) (TPtr (box-type a (TStruct vtname))))
          (push! (mut fields) vtf)))
    (let [sd (primitive/alloc-stack StructDef)]
      (set! (.annotations sd)
            (new-boxed-list [Annotation] a))
      (set! (.name sd) (if vtable vtname (text/format a "{}-dyn" name)))
      (set! (.type_params sd)
            (new-boxed-list [(slice u8)] a))
      (set! (.bounds sd) (new-boxed-list [Bound] a))
      (set! (.layout sd) (LC))
      (set! (.fields sd) (box-al a (load fields)))
      (set! (.span_source sd) -1)
      (set! (.span_lo sd) 0)
      (set! (.span_hi sd) 0)
      (load sd))))

(defn dyn-self-param? [(t (ptr Type)) (self-name (slice u8))] (-> bool)
  (match (load t)
    (TPtr [p] (match (load p) (TStruct [n] (= n self-name)) (_ false)))
    (_ false)))

(defn trait-object-safe? [(td (ptr TraitDef))] (-> bool)
  (let [self-name (.self_param td)
        methods (.methods td)
        n (len (load methods))
        (mut i) 0
        ; A parameterized trait's extra parameters are associated types selected
        ; by its concrete implementation.  The current `(dyn Trait)` spelling has
        ; nowhere to bind those types, so there is no complete erased method ABI
        ; from which to build a vtable.  Static dispatch still supports the trait;
        ; only synthesize object layouts once the complete ABI is known.
        (mut safe) (= (len (.type_params td)) 0)]
    (loop (if (>= (load i) n)
              (break)
              (do
                (let [mp (index (.data methods) (load i))
                      ps (.params mp)
                      np (len (load ps))]
                  (if (or (= np 0)
                          (not (dyn-self-param? (field (index (.data ps)
                                                              0)
                                                       ty)
                                                self-name)))
                      (set! safe false)
                      (let []
                        (for [j 1 np]
                          (when (type-mentions-name (field (index (.data ps)
                                                                  j)
                                                           ty)
                                                    self-name)
                            (set! safe false)
                            (break)))
                        (when (type-mentions-name (field mp ret) self-name)
                          (set! safe false)
                          0))))
                (when (not (load safe)) (break))
                (set! i (primitive/iadd (load i) 1)))))
    (load safe)))

; `(impl Trait Type …)` or the GENERIC form `(impl [T] Trait (ArrayList T) …)`:
; an optional leading type-parameter vector, then the
; full implementing type. Each method carries the impl's type params as its own
; (the lowered functions are ordinary generic functions). Inherent impl params
; must appear in the implementing type. A trait impl may additionally bind the
; trait's associated parameters through its method signatures after dispatch has
; selected the one coherent impl for the receiver.
;
; An INHERENT impl omits the trait:
;   `(impl Point (length [(self Point)] (-> i64) …))`
;   `(impl [T] (Box T) (get [(self (ptr (Box T)))] (-> T) …))`
; It is unambiguous because the form after the target is a method: a list whose
; second item is a parameter vector and whose third item is `(-> Type)`. In the
; trait form, the item after the trait is a TYPE instead. `ImplKind` records the
; distinction explicitly; inherent methods are still lowered to ordinary Funcs.
(defn impl-method-form? [(o (Option Sexp))] (-> bool)
  (match o
    (None [] false)
    (Some [s]
          (if (!= (sx-tag s) 6)
              false
              (let [xs (sx-items s)]
                (if (< (sx-len xs) 3)
                    false
                    (let [ps (sx-at xs 1)
                          rt (sx-at xs 2)]
                      (and (= (sx-tag ps) 7)
                           (and (= (sx-tag rt) 6)
                                (let [rs (sx-items rt)]
                                  (and (> (sx-len rs) 0)
                                       (and (= (sx-tag (sx-at rs 0))
                                               2)
                                            (= (sx-sval (sx-at rs 0)) "->")))))))))))))

(defn parse-impl [(a (dyn Allocator))
                  (rest0 (ptr (ArrayList Sexp)))
                  (slo i64)
                  (shi i64)
                  (ssrc i64)
                  (sctxt i64)] (-> (Result ImplDef Diag))
  (try (let [has-tps (opt-is-vec (sx-get rest0 0))
             (mut type-params) (ArrayList::new [(slice u8)] a)
             (mut bounds) (ArrayList::new [Bound] a)
             ; This is a value, not an action: spell out the false branch so an
             ; older bootstrap compiler cannot leave the non-generic offset
             ; unspecified while compiling this parser.
             base (if has-tps 1 0)]
         ; optional leading [T …] type-parameter vector; entries may carry bounds —
         ; `(impl [(T Eq)] Eq (Box T) …)` — parsed by the same entry parser `defn` uses.
         (when has-tps
           (let [v (sx-items (opt-get (sx-get rest0 0)))
                 nv (sx-len v)]
             (when (= nv 0)
               (break
                 :try
                   (Err [ImplDef Diag]
                        (derr "impl: the type-parameter vector may not be empty"))))
             (for [vi 0 nv]
               (let [ep (primitive/alloc-stack TPEntry)]
                 (set! ep
                       (match (parse-tparam-entry a
                                                  (sx-at v
                                                         vi))
                         (Ok [entry] entry)
                         (Err [diag] (break :try (Err diag)))))
                 (push! (mut type-params) (.name ep))
                 (match (tpentry-bound ep)
                   (Some [b] (do (push! (mut bounds) b) 0))
                   (None [] 0))))
             0))
         (let [; `rest0` excludes the `impl` head. A one-method inherent impl has
               ; exactly two remaining forms (target + method), so form count
               ; cannot distinguish it from a marker-trait impl. The second form's
               ; grammar can: a method has `[params] (-> ret)` in slots 1 and 2.
               inherent
                 (impl-method-form? (sx-get rest0 (primitive/iadd base 1)))
               trait-name
                 (if inherent
                     ""
                     (try! (lexical-sym-of a
                                           (try! (need [Sexp]
                                                       (sx-get rest0 base)
                                                       "impl: missing trait name"))
                                           "trait name")))
               target-idx (if inherent base (primitive/iadd base 1))
               target
                 (try! (need [Sexp]
                             (sx-get rest0 target-idx)
                             "impl: missing implementing type"))
               self-type (try! (parse-type a target))
               (mut stp) self-type]
           (let [for-type (impl-base-name a (mut stp))]
             (when (= (len for-type) 0)
               (break
                 :try
                   (Err [ImplDef Diag]
                        (derr-at (sx-lo target)
                                 (sx-hi target)
                                 "impl: this type can't carry an impl (name a struct, sum, scalar, generic instance, (slice T), (ptr T), array, vector, or fn type)"))))
             (let [(mut methods) (ArrayList::new [Func] a)
                   nr (sx-len rest0)
                   (mut mi)
                     (if inherent
                         (primitive/iadd base 1)
                         (primitive/iadd base 2))]
               ; Marker traits deliberately have no methods, so `(impl Marker T)`
               ; is a complete trait implementation. Only an inherent impl has no
               ; declaration to make an empty body meaningful.
               (when (and inherent (>= (load mi) nr))
                 (break
                   :try
                     (Err [ImplDef Diag]
                          (derr-at slo
                                   shi
                                   "inherent impl must define at least one method"))))
               (loop (if (>= (load mi) nr)
                         (break)
                         (let [m (sx-at rest0 (load mi))]
                           (set! mi (primitive/iadd (load mi) 1))
                           (let [ml
                                   (try! (as-list m
                                                  "impl method must be (name [params] (-> ret) body…)"))
                                 ; `call` is permitted in every trait impl. Value-call
                                 ; syntax discovers it after ordinary trait resolution.
                                 f0 (try! (parse-defn a ml (not inherent)))]
                             (let [fp (primitive/alloc-stack Func)]
                               (set! fp f0)
                               (when (> (len (load (.type_params fp)))
                                        0)
                                 (break
                                   :try
                                     (Err [ImplDef Diag]
                                          (derr-at (sx-lo m)
                                                   (sx-hi m)
                                                   (text/format a
                                                                "impl method '{}': declare type parameters on the impl, not the method"
                                                                (.name fp))))))
                               (set! (.type_params fp)
                                     (box-al a
                                             (load type-params)))
                               ; The impl's bounds become each lowered method's own bounds. Methods
                               ; are ordinary generic functions, so this is all it takes: the body
                               ; typechecks against the bound (cur_bounds), and every call site is
                               ; verified by the existing `ca-check-bounds` on the method's Sig.
                               (set! (.bounds fp)
                                     (box-al a (load bounds)))
                               (set! (.lo fp) slo)
                               (set! (.hi fp) shi)
                               (set! (.source fp) ssrc)
                               (set! (.ctxt fp) sctxt)
                               (push! (mut methods) (load fp)))))))
               ; Every generic parameter must be inferable either from the
               ; receiver or, for a trait impl, from an associated type position
               ; in a method signature. Inherent dispatch has no trait contract
               ; that can supply the latter binding.
               (let [ntp2 (len (load type-params))]
                 (for [ck 0 ntp2]
                   (let [pn (get (load type-params) ck)
                         (mut found) (type-mentions-name (mut stp) pn)]
                     (unless (or (load found) inherent)
                       (for [fi 0 (len (load methods))]
                         (let [fp (elem (mut methods) fi)]
                           (for [pi 0 (len (.params fp))]
                             (when (type-mentions-name (field (elem (.params fp)
                                                                    pi)
                                                              ty)
                                                       pn)
                               (set! found true)))
                           (when (type-mentions-name (field fp ret) pn)
                             (set! found true)))))
                     (unless (load found)
                       (break
                         :try
                           (Err [ImplDef Diag]
                                (derr-at (sx-lo target)
                                         (sx-hi target)
                                         (text/format a
                                                      "impl: type parameter '{}{}"
                                                      pn
                                                      (if inherent
                                                          "' must appear in the implementing type"
                                                          "' must appear in the implementing type or a trait method signature")))))))))
               (Ok (let [(mut im) (zeroed ImplDef)]
                     (set! (.kind im)
                           (if inherent (InherentImpl) (TraitImpl trait-name)))
                     (set! (.for_type im) for-type)
                     (set! (.type_params im)
                           (box-al a (load type-params)))
                     (set! (.bounds im) (box-al a (load bounds)))
                     (set! (.self_type im) self-type)
                     (set! (.methods im) (box-al a (load methods)))
                     im))))))))

(defn parse-export-c [(a (dyn Allocator)) (rest (ptr (ArrayList Sexp)))]
  (-> (Result (ptr (ArrayList ExportC)) Diag))
  (try (let [(mut out) (ArrayList::new [ExportC] a)
             n (sx-len rest)
             (mut i) 0]
         (loop (if (>= (load i) n)
                   (break)
                   (let [item (sx-at rest (load i))]
                     (set! i (primitive/iadd (load i) 1))
                     (let [tg (sx-tag item)]
                       (if (= tg 2)
                           (let [ep (primitive/alloc-stack ExportC)]
                             (set! (.name ep) (sx-sval item))
                             (set! (.symbol ep) (None [(slice u8)]))
                             (set! (.params ep)
                                   (new-boxed-list [Type] a))
                             (set! (.published ep) true)
                             (set! (.lo ep) (sx-lo item))
                             (set! (.hi ep) (sx-hi item))
                             (set! (.source ep) (sx-source item))
                             (set! (.ctxt ep) (sx-ctxt item))
                             (push! (mut out) (load ep)))
                           (if (= tg 7)
                               (let [v (sx-items item)
                                     nm
                                       (if (and (> (sx-len v)
                                                   0)
                                                (= (sx-tag (sx-at v 0))
                                                   2))
                                           (sx-sval (sx-at v 0))
                                           (return-from
                                             :try
                                               (Err [(ptr (ArrayList ExportC))
                                                     Diag]
                                                    (derr-at (sx-lo item)
                                                             (sx-hi item)
                                                             "export-c: expected [name :as \"symbol\"]"))))
                                     sym0
                                       (if (and (opt-is-kw (sx-get v 1) "as")
                                                (opt-is-str (sx-get v 2)))
                                           (opt-str-val (sx-get v 2))
                                           (return-from
                                             :try
                                               (Err [(ptr (ArrayList ExportC))
                                                     Diag]
                                                    (derr-at (sx-lo item)
                                                             (sx-hi item)
                                                             "export-c: expected [name :as \"symbol\"]"))))]
                                 (let [ep (primitive/alloc-stack ExportC)]
                                   (set! (.name ep) nm)
                                   (set! (.symbol ep) (Some sym0))
                                   (set! (.params ep)
                                         (new-boxed-list [Type] a))
                                   (set! (.published ep) true)
                                   (set! (.lo ep) (sx-lo item))
                                   (set! (.hi ep) (sx-hi item))
                                   (set! (.source ep) (sx-source item))
                                   (set! (.ctxt ep) (sx-ctxt item))
                                   (push! (mut out) (load ep))))
                               (return-from
                                 :try
                                   (Err [(ptr (ArrayList ExportC))
                                         Diag]
                                        (derr-at (sx-lo item)
                                                 (sx-hi item)
                                                 "export-c: each entry is a function name or [name :as \"symbol\"]")))))))))
         (Ok (box-al a (load out))))))

;;; The convention a coil.cc.NativeCc constructor names: LLVM places its values,
;;; so it lists no registers. Every program has the five.
(defn native-convention [(a (dyn Allocator)) (native cc/NativeCc)]
  (-> Convention)
  (let [c (primitive/alloc-stack Convention)]
    (set! (.name c)
          (match native
            (cc/C [] "coil.cc.C")
            (cc/Fast [] "coil.cc.Fast")
            (cc/Cold [] "coil.cc.Cold")
            (cc/Tail [] "coil.cc.Tail")
            (cc/SwiftTail [] "coil.cc.SwiftTail")))
    (set! (.params c) (new-boxed-list [(slice u8)] a))
    (set! (.ret c) (None [(slice u8)]))
    (set! (.clobber c) (new-boxed-list [(slice u8)] a))
    (set! (.preserve c) (new-boxed-list [(slice u8)] a))
    (set! (.lowering c) (LNative native))
    (load c)))

; Declaration macros may return nested do bundles. Keep one syntax origin in
; the staging workspace while parsing every declaration in that bundle.
(defn declaration-forms! [(out (ptr (ArrayList Sexp))) (form (ptr Sexp))]
  (-> i64)
  (if (and (= (sx-tag (load form)) 6)
           (let [items (sx-items (load form))]
             (and (> (sx-len items) 0)
                  (and (= (sx-tag (sx-at items 0)) 2)
                       (= (sx-sval (sx-at items 0)) "do")))))
      (let [items (sx-items (load form))
            (mut i) 1]
        (loop (if (>= (load i) (sx-len items))
                  (break)
                  (do
                    (declaration-forms! out (elem items (load i)))
                    (set! i (+ (load i) 1)))))
        0)
      (do (push! [Sexp] out (load form)) 0)))

; `parse_program` in: fold the top-level forms into a Program.
(defn parse-program [(a (dyn Allocator)) (forms (ptr (ArrayList Sexp)))]
  (-> (Result Program Diag))
  (let [(mut annotation-defs) (ArrayList::new [AnnotationDef] a)
        (mut convs) (ArrayList::new [Convention] a)
        (mut structs) (ArrayList::new [StructDef] a)
        (mut sums) (ArrayList::new [SumDef] a)
        (mut externs) (ArrayList::new [Extern] a)
        (mut funcs) (ArrayList::new [Func] a)
        (mut asserts) (ArrayList::new [StaticAssert] a)
        (mut consts) (ArrayList::new [Const] a)
        (mut traits) (ArrayList::new [TraitDef] a)
        (mut impls) (ArrayList::new [ImplDef] a)
        (mut metas) (ArrayList::new [Expr] a)
        (mut exports) (ArrayList::new [ExportC] a)
        (mut aliases) (ArrayList::new [AliasDef] a)
        (mut retirements) (ArrayList::new [Retirement] a)
        (mut err) (zeroed Diag)
        (mut failed) false]
    (push! (mut convs) (native-convention a (cc/C)))
    (push! (mut convs) (native-convention a (cc/Fast)))
    (push! (mut convs) (native-convention a (cc/Cold)))
    (push! (mut convs) (native-convention a (cc/Tail)))
    (push! (mut convs) (native-convention a (cc/SwiftTail)))
    (let [(mut flattened) (ArrayList::new [Sexp] a)
          (mut source-index) 0]
      (loop (if (>= (load source-index) (sx-len forms))
                (break)
                (do
                  (declaration-forms! (mut flattened)
                                      (elem forms (load source-index)))
                  (set! source-index (+ (load source-index) 1)))))
      (let [forms (box-al a (load flattened))
            nf (sx-len forms)
            (mut fi) 0]
        (loop (if (>= (load fi) nf)
                  (break)
                  (let [form (sx-at forms (load fi))
                        flo (sx-lo form)
                        fhi (sx-hi form)
                        fsrc (sx-source form)
                        fctxt (sx-ctxt form)]
                    (compiler-work! "parse"
                                    (if (and (= (sx-tag form) 6)
                                             (> (sx-len (sx-items form)) 1))
                                        (let [name (sx-at (sx-items form) 1)]
                                          (if (> (sx-hyg name) 0)
                                              (lexical-name a name)
                                              (sx-sval name)))
                                        "<form>"))
                    (set! fi (primitive/iadd (load fi) 1))
                    (let [res
                            (match (as-list form
                                            "top-level form must be a list")
                              (Err [d] (Err [i64 Diag] d))
                              (Ok [items]
                                  (match (head-sym a items)
                                    (Err [d] (Err [i64 Diag] d))
                                    (Ok [head]
                                        (let [rest (rest-from a items 1)]
                                          (cond (= head "defcc")
                                                  (match (parse-defcc a rest)
                                                    (Err [d] (Err [i64 Diag] d))
                                                    (Ok [c]
                                                        (let [cp
                                                                (primitive/alloc-stack Convention)]
                                                          (set! cp c)
                                                          (let [nm (.name cp)
                                                                (mut found) -1
                                                                cn
                                                                  (len (load convs))]
                                                            (for [ci 0 cn]
                                                              (when (= (conv-name (get (load convs)
                                                                                       ci))
                                                                       nm)
                                                                (set! found
                                                                      ci)
                                                                0))
                                                            (if (>= (load found)
                                                                    0)
                                                                (if (native-cc-identity? nm)
                                                                    (do
                                                                      (set! (mut convs)
                                                                            (load found)
                                                                            (load cp))
                                                                      (Ok [i64
                                                                           Diag]
                                                                          0))
                                                                    (Err [i64
                                                                          Diag]
                                                                         (derr (text/format a
                                                                                            "convention '{}' defined twice"
                                                                                            nm))))
                                                                (do
                                                                  (push! (mut convs)
                                                                         (load cp))
                                                                  (Ok [i64 Diag]
                                                                      0)))))))
                                                (= head "defalias")
                                                  (match (parse-defalias a rest)
                                                    (Err [d] (Err [i64 Diag] d))
                                                    (Ok [ad]
                                                        (let [(mut dup) false
                                                              (mut adp) ad]
                                                          (for [ai
                                                                0
                                                                (len (load aliases))]
                                                            (when (= (.name (elem (mut aliases)
                                                                                  ai))
                                                                     (.name adp))
                                                              (set! dup true)))
                                                          (if (load dup)
                                                              (Err [i64 Diag]
                                                                   (derr (text/format a
                                                                                      "alias '{}' defined twice"
                                                                                      (.name adp))))
                                                              (do
                                                                (push! (mut aliases)
                                                                       ad)
                                                                (Ok [i64 Diag]
                                                                    0))))))
                                                (or (= head "retire-alias")
                                                    (= head "retire-trait")
                                                    (= head
                                                       "retire-impl")
                                                    (= head
                                                       "retire-inherent")
                                                    (retire-definition-kind? head))
                                                  (match (parse-retirement a
                                                                           head
                                                                           rest)
                                                    (Err [d] (Err [i64 Diag] d))
                                                    (Ok [r]
                                                        (do
                                                          (push! (mut retirements)
                                                                 r)
                                                          (Ok [i64 Diag] 0))))
                                                (= head "defannotation")
                                                  (match (parse-defannotation a
                                                                              rest)
                                                    (Ok [ad]
                                                        (do
                                                          (push! (mut annotation-defs)
                                                                 ad)
                                                          (Ok [i64 Diag] 0)))
                                                    (Err [d] (Err [i64 Diag] d)))
                                                (= head "defstruct")
                                                  (match (parse-defstruct a
                                                                          rest)
                                                    (Ok [sd]
                                                        (let [(mut located) sd]
                                                          (set! (.span_source located)
                                                                fsrc)
                                                          (set! (.span_lo located)
                                                                flo)
                                                          (set! (.span_hi located)
                                                                fhi)
                                                          (push! (mut structs)
                                                                 located)
                                                          (Ok [i64 Diag] 0)))
                                                    (Err [d] (Err [i64 Diag] d)))
                                                (= head "defsum")
                                                  (match (parse-defsum a rest)
                                                    (Ok [sd]
                                                        (let [(mut located) sd]
                                                          (set! (.span_source located)
                                                                fsrc)
                                                          (set! (.span_lo located)
                                                                flo)
                                                          (set! (.span_hi located)
                                                                fhi)
                                                          (push! (mut sums)
                                                                 located)
                                                          (Ok [i64 Diag] 0)))
                                                    (Err [d] (Err [i64 Diag] d)))
                                                (and (= head "declare")
                                                     (declare-storage? rest))
                                                  (match (parse-declare-storage a
                                                                                rest)
                                                    (Ok [d]
                                                        (do
                                                          (push! (mut consts) d)
                                                          (Ok [i64 Diag] 0)))
                                                    (Err [d] (Err [i64 Diag] d)))
                                                (or (= head "defn*")
                                                    (= head "declare"))
                                                  (match (if (= head "declare")
                                                             (parse-declare a
                                                                            rest)
                                                             (parse-defn a
                                                                         rest
                                                                         false))
                                                    (Err [d] (Err [i64 Diag] d))
                                                    (Ok [f0]
                                                        (let [(mut fp) f0]
                                                          (set! (.lo fp) flo)
                                                          (set! (.hi fp) fhi)
                                                          (set! (.source fp)
                                                                fsrc)
                                                          (set! (.ctxt fp)
                                                                fctxt)
                                                          (let [nm (.name fp)
                                                                (mut dup) false
                                                                cn
                                                                  (len (load funcs))]
                                                            (for [ci 0 cn]
                                                              (when (= (func-name (get (load funcs)
                                                                                       ci))
                                                                       nm)
                                                                (set! dup
                                                                      true)
                                                                0))
                                                            (if (load dup)
                                                                (Err [i64 Diag]
                                                                     (derr (text/format a
                                                                                        "function '{}' defined twice"
                                                                                        nm)))
                                                                (do
                                                                  (push! (mut funcs)
                                                                         fp)
                                                                  (Ok [i64 Diag]
                                                                      0)))))))
                                                (= head "extern")
                                                  (match (parse-extern a rest)
                                                    (Ok [e]
                                                        (do
                                                          (push! (mut externs)
                                                                 e)
                                                          (Ok [i64 Diag] 0)))
                                                    (Err [d] (Err [i64 Diag] d)))
                                                (= head "export-c")
                                                  (match (parse-export-c a rest)
                                                    (Err [d] (Err [i64 Diag] d))
                                                    (Ok [es]
                                                        (do
                                                          (let [en
                                                                  (len (load es))
                                                                (mut ei) 0]
                                                            (loop (if (>= (load ei)
                                                                          en)
                                                                      (break)
                                                                      (do
                                                                        (push! (mut exports)
                                                                               (get (load es)
                                                                                    (load ei)))
                                                                        (set! ei
                                                                              (primitive/iadd (load ei)
                                                                                              1))))))
                                                          (Ok [i64 Diag] 0))))
                                                (= head "static-assert")
                                                  (match (parse-static-assert a
                                                                              items)
                                                    (Ok [sa]
                                                        (do
                                                          (push! (mut asserts)
                                                                 sa)
                                                          (Ok [i64 Diag] 0)))
                                                    (Err [d] (Err [i64 Diag] d)))
                                                (= head "const")
                                                  (match (parse-const a rest)
                                                    (Ok [c]
                                                        (do
                                                          (push! (mut consts) c)
                                                          (Ok [i64 Diag] 0)))
                                                    (Err [d] (Err [i64 Diag] d)))
                                                (= head "def")
                                                  (match (parse-runtime-def a
                                                                            rest)
                                                    (Ok [d]
                                                        (do
                                                          (push! (mut consts) d)
                                                          (Ok [i64 Diag] 0)))
                                                    (Err [d] (Err [i64 Diag] d)))
                                                (= head "deftrait")
                                                  (match (parse-deftrait a rest)
                                                    (Ok [t]
                                                        (let [(mut tp) t]
                                                          (push! (mut traits) t)
                                                          (when (trait-object-safe? (mut tp))
                                                            (push! (mut structs)
                                                                   (dyn-struct-def a
                                                                                   (mut tp)
                                                                                   true))
                                                            (push! (mut structs)
                                                                   (dyn-struct-def a
                                                                                   (mut tp)
                                                                                   false))
                                                            0)
                                                          (Ok [i64 Diag] 0)))
                                                    (Err [d] (Err [i64 Diag] d)))
                                                (= head "defdyn-marker")
                                                  (Ok [i64 Diag] 0)
                                                ; `import` is already fully processed by the loader
                                                ; into the import tables. It is kept in the form
                                                ; list so that metaprograms can SEE it — "which
                                                ; namespaces does this module import?" is a basic
                                                ; question for a transform, and it was unanswerable
                                                ; while the loader dropped the form. By the time
                                                ; parsing runs there is nothing left to do with it.
                                                (= head "import")
                                                  (Ok [i64 Diag] 0)
                                                (= head "export")
                                                  (Ok [i64 Diag] 0)
                                                (= head "reader-provider")
                                                  (Ok [i64 Diag] 0)
                                                ; Expansion pre-scan consumes this declaration
                                                ; into the derive registry. Treat it like import
                                                ; when a resolve-only tool parses the pre-expanded
                                                ; declaration surface.
                                                (= head "register-derive")
                                                  (Ok [i64 Diag] 0)
                                                (= head "impl")
                                                  (match (parse-impl a
                                                                     rest
                                                                     flo
                                                                     fhi
                                                                     fsrc
                                                                     fctxt)
                                                    (Ok [im]
                                                        (do
                                                          (push! (mut impls) im)
                                                          (Ok [i64 Diag] 0)))
                                                    (Err [d] (Err [i64 Diag] d)))
                                                (= head "meta")
                                                  (if (not (= (sx-len items)
                                                              2))
                                                      (Err [i64 Diag]
                                                           (derr "meta: expected (meta EXPR)"))
                                                      (match (parse-expr a
                                                                         (sx-at items
                                                                                1))
                                                        (Ok [e]
                                                            (do
                                                              (push! (mut metas)
                                                                     e)
                                                              (Ok [i64 Diag] 0)))
                                                        (Err [d]
                                                             (Err [i64 Diag] d))))
                                                :else
                                                  (Err [i64 Diag]
                                                       (derr (text/format a
                                                                          "unknown top-level form '{}'"
                                                                          head)))))))))]
                      (match res
                        (Ok [_] 0)
                        (Err [d]
                             (do
                               (set! err (dwspan d fsrc flo fhi fctxt))
                               (set! failed true)
                               (break)))))))))
      (if (load failed)
          (Err (load err))
          (Ok (let [(mut pp) (zeroed Program)]
                (set! (.annotation_defs pp)
                      (box-al a (load annotation-defs)))
                (set! (.conventions pp) (box-al a (load convs)))
                (set! (.structs pp) (box-al a (load structs)))
                (set! (.sums pp) (box-al a (load sums)))
                (set! (.externs pp) (box-al a (load externs)))
                (set! (.funcs pp) (box-al a (load funcs)))
                (set! (.asserts pp) (box-al a (load asserts)))
                (set! (.consts pp) (box-al a (load consts)))
                (set! (.traits pp) (box-al a (load traits)))
                (set! (.impls pp) (box-al a (load impls)))
                (set! (.metas pp) (box-al a (load metas)))
                (set! (.exports pp) (box-al a (load exports)))
                (set! (.function_abis pp)
                      (new-boxed-list [Extern] a))
                (set! (.mono_origins pp)
                      (new-boxed-list [MonoOrigin] a))
                (set! (.mono_trait_uses pp)
                      (new-boxed-list [MonoTraitUse] a))
                (set! (.unit_exports pp)
                      (new-boxed-list [(slice u8)] a))
                (set! (.aliases pp) (box-al a (load aliases)))
                (set! (.retirements pp)
                      (box-al a (load retirements)))
                (set! (.retired_functions pp)
                      (new-boxed-list [(slice u8)] a))
                (set! (.unit_build pp) false)
                pp))))))

; static-assert: condition presence + message rule. The condition is an ordinary
; expression, checked as one; see `assert-inline-calls` (mono.coil) for how its
; operator calls become foldable.

(defn assert-msg [(a (dyn Allocator)) (items (ptr (ArrayList Sexp)))]
  (-> (Result (slice u8) Diag))
  (match (sx-get items 2)
    (None [] (Ok "static assertion failed"))
    (Some [s]
          (if (= (sx-tag s) 4)
              (Ok (sx-sval s))
              (Err (derr "static-assert: message must be a string"))))))

(defn parse-static-assert [(a (dyn Allocator)) (items (ptr (ArrayList Sexp)))]
  (-> (Result StaticAssert Diag))
  (try (let [cond
               (try! (parse-expr a
                                 (try! (need [Sexp]
                                             (sx-get items 1)
                                             "static-assert: missing condition"))))
             msg (try! (assert-msg a items))]
         (Ok (let [ap (primitive/alloc-stack StaticAssert)]
               (set! (.cnd ap) cond)
               (set! (.msg ap) msg)
               (load ap))))))

; ============================ reused reader =================================
; Ported (and verified) in src/compiler/reader.coil — copied here so the parser can
; turn source into Sexp. Treat as already-correct.
