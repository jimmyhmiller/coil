;;; Structural expression reconstruction. Passes own meaning: they intercept
;;; special nodes, supply expression/type rewrites, and call map-kind for the
;;; remaining structure. Metadata is copied; only syntax edges are traversed.
(module coil.compiler.ast_map)
(import "coil.primitive" :as p)
(import "coil.alloc" :use *)
(import "coil.arraylist" :use *)
(import "coil.result" :use *)
(import "coil.control" :use *)
(import "coil.try" :use *)
(import "coil.compiler.ast" :use *)
(import "coil.reader" :use [Diag])

(deftrait AstMapper [Self]
  (mapper-allocator [(self (ptr Self))] (-> (dyn Allocator)))
  (map-expression [(self (ptr Self)) (value (ptr Expr))] (-> (Result Expr Diag)))
  (map-type [(self (ptr Self)) (value Type)] (-> (Result Type Diag)))
  ; Lists are pass policy too: specialization expands packs, and binding
  ; reconstruction may update ownership metadata after specializing a value.
  (map-expressions [(self (ptr Self)) (values (ptr (ArrayList Expr)))]
    (-> (Result (ptr (ArrayList Expr)) Diag)))
  (map-types [(self (ptr Self)) (values (ptr (ArrayList Type)))]
    (-> (Result (ptr (ArrayList Type)) Diag)))
  (map-bindings [(self (ptr Self)) (values (ptr (ArrayList Bind)))]
    (-> (Result (ptr (ArrayList Bind)) Diag))))

(defn map-expression-pointer [(M AstMapper)] [(m (ptr M)) (value (ptr Expr))]
  (-> (Result (ptr Expr) Diag))
  (try (if (= (p/cast i64 value) 0)
           (Ok value)
           (Ok (box-expr (mapper-allocator m) (try! (map-expression m value)))))))

(defn map-expression-elements [(M AstMapper)] [(m (ptr M))
                                               (values (ptr (ArrayList Expr)))]
  (-> (Result (ptr (ArrayList Expr)) Diag))
  (try (let [a (mapper-allocator m)
             (mut out) (ArrayList::new [Expr] a)]
         (for [i 0 (len (load values))]
           (push! (mut out) (try! (map-expression m (elem values i)))))
         (Ok (box! a (ArrayList Expr) (load out))))))

(defn map-type-elements [(M AstMapper)] [(m (ptr M))
                                         (values (ptr (ArrayList Type)))]
  (-> (Result (ptr (ArrayList Type)) Diag))
  (try (let [a (mapper-allocator m)
             (mut out) (ArrayList::new [Type] a)]
         (for [i 0 (len (load values))]
           (push! (mut out) (try! (map-type m (get (load values) i)))))
         (Ok (box! a (ArrayList Type) (load out))))))

(defn map-binding-elements [(M AstMapper)] [(m (ptr M))
                                            (values (ptr (ArrayList Bind)))]
  (-> (Result (ptr (ArrayList Bind)) Diag))
  (try (let [a (mapper-allocator m)
             (mut out) (ArrayList::new [Bind] a)]
         (for [i 0 (len (load values))]
           (let [(mut value) (get (load values) i)]
             (set! (.value value)
                   (try! (map-expression m (field (mut value) value))))
             (push! (mut out) (load value))))
         (Ok (box! a (ArrayList Bind) (load out))))))

(defn map-arms [(M AstMapper)] [(m (ptr M)) (values (ptr (ArrayList Arm)))]
  (-> (Result (ptr (ArrayList Arm)) Diag))
  (try (let [a (mapper-allocator m)
             (mut out) (ArrayList::new [Arm] a)]
         (for [i 0 (len (load values))]
           (let [(mut value) (get (load values) i)]
             (set! (.body value)
                   (try! (map-expression m (field (mut value) body))))
             (push! (mut out) (load value))))
         (Ok (box! a (ArrayList Arm) (load out))))))

(defn map-optional-expression [(M AstMapper)] [(m (ptr M))
                                               (value (Option (ptr Expr)))]
  (-> (Result (Option (ptr Expr)) Diag))
  (try (match value
         (None [] (Ok (None)))
         (Some [inner] (Ok (Some (try! (map-expression-pointer m inner))))))))

(defn map-dynamic-call [(M AstMapper)] [(m (ptr M)) (value (ptr DynCall))]
  (-> (Result (ptr DynCall) Diag))
  (try (let [(mut out) (load value)]
         (set! (.params out) (try! (map-types m (.params value))))
         (set! (.ret out) (try! (map-type m (.ret value))))
         (set! (.recv out) (try! (map-expression-pointer m (.recv value))))
         (set! (.args out) (try! (map-expressions m (.args value))))
         (Ok (box! (mapper-allocator m) DynCall (load out))))))

; Reflection supplies variant shape, rather than maintaining a parallel list of
; ExprKind's payloads. Types not listed here are metadata, names, and immediates;
; they remain unchanged. Quasiquote is a stage-specific operation, not an Expr
; edge: a pass that lowers templates must intercept EQuasi itself.
(defn mapped-payload [(ty Code) (m Code) (value Code)] (-> Code)
  (cond (= ty `coil.compiler.ast.Type) `(try! (map-type ~m ~value))
        (= ty `(ptr coil.compiler.ast.Expr))
          `(try! (map-expression-pointer ~m ~value))
        (= ty `(ptr (coil.arraylist.ArrayList coil.compiler.ast.Expr)))
          `(try! (map-expressions ~m ~value))
        (= ty `(ptr (coil.arraylist.ArrayList coil.compiler.ast.Type)))
          `(try! (map-types ~m ~value))
        (= ty `(ptr (coil.arraylist.ArrayList coil.compiler.ast.Bind)))
          `(try! (map-bindings ~m ~value))
        (= ty `(ptr (coil.arraylist.ArrayList coil.compiler.ast.Arm)))
          `(try! (map-arms ~m ~value))
        (= ty `(coil.core.Option (ptr coil.compiler.ast.Expr)))
          `(try! (map-optional-expression ~m ~value))
        (= ty `(ptr coil.compiler.ast.DynCall))
          `(try! (map-dynamic-call ~m ~value))
        :else value))

; The shape generator is independent of a pass's result type. Payload and
; result metaprograms own rewriting and wrapping; excluded variants are supplied
; explicitly by a pass when their evaluation order or representation differs.
(defn kind-reconstruction-arms [(context Code)
                                (payload Code)
                                (result Code)
                                (excluded Code)] (-> Code)
  (let [arms (p/code-list-new)]
    (for [vi 0 (p/code-variant-count `ExprKind)]
      (unless (selected-child-variant? excluded
                                       (p/code-variant-name `ExprKind vi))
        (let [binds (p/code-list-new)
              values (p/code-list-new)
              variant (p/code-variant-qname `ExprKind vi)]
          (for [fi 0 (p/code-variant-fields `ExprKind vi)]
            (let [value (p/fresh-identifier "payload")
                  ty (p/code-variant-field-type `ExprKind vi fi)]
              (p/code-list-push! binds value)
              (p/code-list-push! values `(~payload ~ty ~context ~value))))
          (p/code-list-push! arms
                             `(~variant [~@(p/code-list-done binds)]
                                 (~result (~variant ~@(p/code-list-done values))))))))
    (p/code-list-done arms)))

(defn mapped-kind-result [(value Code)] (-> Code)
  `(Ok ~value))

(defn define-kind-mapper [(name Code)] (-> Code)
  (let [m (p/fresh-identifier "mapper")
        kind (p/fresh-identifier "kind")
        arms
          (kind-reconstruction-arms m `mapped-payload `mapped-kind-result `[])]
    `(defn ~name [(M AstMapper)] [(~m (ptr M)) (~kind ExprKind)]
       (-> (Result ExprKind Diag))
       (try (match ~kind ~@arms)))))

(define-kind-mapper map-kind)

; Borrowed, one-level expression edges. Quasiquote is a stage boundary and stays
; with the pass, as in map-kind above. A pass may supply an explicit variant set
; to retain its phase's coverage rather than silently widening that coverage.
(defn child-pointer-form [(name Code) (value Code) (body Code) (required bool)]
  (-> Code)
  (if required
      `(let [~name ~value] ~@body 0)
      (let [pointer (p/fresh-identifier "child")]
        `(let [~pointer ~value]
           (unless (p/icmp-eq (p/cast i64 ~pointer) 0)
             (let [~name ~pointer] ~@body 0))
           0))))

(defn child-list-form [(name Code)
                       (values Code)
                       (member Code)
                       (body Code)
                       (required bool)]
  (-> Code)
  (let [items (p/fresh-identifier "items")
        i (p/fresh-identifier "index")
        limit (p/fresh-identifier "length")
        value
          (if (p/code-eq member `:direct)
              `(elem ~items ~i)
              `(field (elem ~items ~i) ~member))
        iteration
          `(for [~i 0 ~(if required limit `(len (load ~items)))]
             (let [~name ~value] ~@body 0))]
    `(let [~items ~values]
       ~(if required
            `(let [~limit (len (load ~items))] ~iteration)
            `(unless (p/icmp-eq (p/cast i64 ~items) 0) ~iteration))
       0)))

(defn child-payload-form [(ty Code)
                          (name Code)
                          (value Code)
                          (body Code)
                          (required bool)]
  (-> Code)
  (cond (p/code-eq ty `(ptr coil.compiler.ast.Expr))
          (child-pointer-form name value body required)
        (p/code-eq ty `(ptr (coil.arraylist.ArrayList coil.compiler.ast.Expr)))
          (child-list-form name value `:direct body required)
        (p/code-eq ty `(ptr (coil.arraylist.ArrayList coil.compiler.ast.Bind)))
          (child-list-form name value `value body required)
        (p/code-eq ty `(ptr (coil.arraylist.ArrayList coil.compiler.ast.Arm)))
          (child-list-form name value `body body required)
        (p/code-eq ty `(coil.core.Option (ptr coil.compiler.ast.Expr)))
          (let [inner (p/fresh-identifier "optional-child")]
            `(match ~value
               (Some [~inner] ~(child-pointer-form name inner body required))
               (None [] 0)))
        (p/code-eq ty `(ptr coil.compiler.ast.DynCall))
          (let [recv
                  (if required (p/fresh-identifier "receiver") `(.recv ~value))
                args
                  (if required (p/fresh-identifier "arguments") `(.args ~value))
                children
                  `(do
                     ~(child-pointer-form name recv body required)
                     ~(child-list-form name args `:direct body required)
                     0)]
            (if required
                `(let [~recv (.recv ~value)
                       ~args (.args ~value)]
                   ~children)
                `(unless (p/icmp-eq (p/cast i64 ~value) 0) ~children)))
        :else `0))

(defn selected-child-variant? [(selected Code) (variant Code)] (-> bool)
  (block :found
    (for [i 0 (p/code-count selected)]
      (when (p/code-eq (p/code-nth selected i) variant)
        (break :found true)))
    false))

;;; `(visit-expr-children [child expression] body ...)` borrows each immediate
;;; expression child in field/list order. Add `:only [VARIANT ...]` or
;;; `:except [VARIANT ...]` to preserve phase policy. Null pointers are absent.
;;; Use labelled exits such as `break :label` and `try!` to leave visitation;
;;; the body expands at each edge without a callback function or heap buffer.
(defn visit-expr-children [(binding Code) & (body Code)] (-> Code)
  (expression-children-form binding body false))

;;; Like visit-expr-children, but passes null children to the body and dereferences
;;; list headers directly. For passes whose existing traversal requires each edge.
;;; List lengths are captured before iteration; DynCall receiver/argument pointers
;;; are captured together before either child is visited.
(defn visit-required-expr-children [(binding Code) & (body Code)] (-> Code)
  (expression-children-form binding body true))

(defn expression-children-form [(binding Code) (body Code) (required bool)]
  (-> Code)
  (if (or (not (p/code-vector? binding))
          (not (or (p/icmp-eq (p/code-count binding) 2)
                   (p/icmp-eq (p/code-count binding) 4))))
      (p/error "visit-expr-children: expected [NAME EXPR] or [NAME EXPR MODE [VARIANT ...]]")
      0)
  (let [name (p/code-nth binding 0)
        expression (p/code-nth binding 1)
        limited (p/icmp-eq (p/code-count binding) 4)
        mode (if limited (p/code-nth binding 2) `:only)
        selected (if limited (p/code-nth binding 3) `[])
        root (p/fresh-identifier "expression")
        arms (p/code-list-new)]
    (if (not (p/code-sym? name))
        (p/error "visit-expr-children: NAME must be an identifier")
        0)
    (when limited
      (if (not (or (p/code-eq mode `:only) (p/code-eq mode `:except)))
          (p/error "visit-expr-children: MODE must be :only or :except")
          0)
      (if (not (p/code-vector? selected))
          (p/error "visit-expr-children: expected a literal variant vector")
          0)
      (for [i 0 (p/code-count selected)]
        (let [(mut known) false]
          (for [vi 0 (p/code-variant-count `ExprKind)]
            (when (p/code-eq (p/code-nth selected i)
                             (p/code-variant-name `ExprKind vi))
              (set! known true)))
          (unless known
            (p/error "visit-expr-children: unknown ExprKind variant")))))
    (for [vi 0 (p/code-variant-count `ExprKind)]
      (let [variant (p/code-variant-qname `ExprKind vi)
            binds (p/code-list-new)
            forms (p/code-list-new)
            enabled
              (or (not limited)
                  (if (p/code-eq mode `:except)
                      (not (selected-child-variant? selected
                                                    (p/code-variant-name `ExprKind
                                                                         vi)))
                      (selected-child-variant? selected
                                               (p/code-variant-name `ExprKind
                                                                    vi))))]
        (for [fi 0 (p/code-variant-fields `ExprKind vi)]
          (let [value (p/fresh-identifier "payload")]
            (p/code-list-push! binds value)
            (when enabled
              (p/code-list-push! forms
                                 (child-payload-form (p/code-variant-field-type `ExprKind
                                                                                vi
                                                                                fi)
                                                     name
                                                     value
                                                     body
                                                     required)))))
        (p/code-list-push! arms
                           `(~variant [~@(p/code-list-done binds)]
                               (do ~@(p/code-list-done forms) 0)))))
    `(let [~root ~expression]
       (match (.kind ~root) ~@(p/code-list-done arms)))))
