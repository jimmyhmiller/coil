; src/compiler/frontend/loader.coil — self-host Coil compiler, loader module.

(module coil.compiler.loader)
(import "coil.compiler.text" :as text)
(import "coil.compiler.retained_heap" :as retained-heap)
(import "coil.primitive" :as primitive)
(import "coil.os" :as os)
(import "coil.compiler.unit_state" :use *)
(import "coil.compiler.trace" :as tr)
(import "coil.scratch" :as scratch)
(import "coil.compiler.checked_base" :as checkedbase)

(defstruct LoaderUnitState
  [(reader SourceReaderHook)
   (cimport_policy DeferCimportBox)
   (form_id i64)
   (prelude PreludeNameBox)
   (layout StdlibLayout)
   (workspace WsPkgBox)
   (virtual_sources (ptr (ArrayList VirtualSource)))
   (artifact_inputs (ptr (ArrayList LoaderArtifactInput)))
   ; Prebuilt units this compilation links instead of compiling: each one's
   ; interface stands in for its module's source, and its object is a link
   ; input. Null when none are registered.
   (prebuilt (ptr (ArrayList PrebuiltUnit)))
   ; The --target triple when it names a platform other than the one running the
   ; compiler, else empty. A cimport probe compiles and runs a program HERE, so it
   ; cannot answer for another platform; set by comptime's set-target-arch!.
   (cross_target (slice u8))
   ; The modules the namespace index found and their files, copied into the
   ; unit's allocator once the index is built, for the hint an unknown name
   ; gets (resolve.coil hint-catalog). Null before any index is built.
   (index_names (ptr (ArrayList (slice u8))))
   (index_paths (ptr (ArrayList (slice u8))))])

; One source root of a dependency package, as the driver registered it before
; compiling. `used` is set when a namespace resolves to a file under `root`, which
; is the loader's authoritative module -> file mapping rather than a guess about
; what a program might import.
(defstruct LinkPackageRoot [(id i64) (root (slice u8)) (used bool)])

; The registry is process-owned, not part of a compilation unit's state: the
; command registers it before the compile, every compilation this process runs
; contributes to it, and the link step reads it afterwards.
(defstruct LinkPackageCell [(roots (ptr (ArrayList LinkPackageRoot)))])

(defn link-package-cell [] (-> (ptr LinkPackageCell))
  (primitive/alloc-static LinkPackageCell))

(defn link-package-roots [] (-> (ptr (ArrayList LinkPackageRoot)))
  (.roots (link-package-cell)))

(defn link-packages-active? [] (-> bool)
  (!= (primitive/cast i64 (link-package-roots)) 0))

; Register one source root of the dependency package identified by `id`. A package
; with several source roots registers each of them under the same id.
(defn link-package-register! [(a (dyn Allocator))
                              (id i64)
                              (root (slice u8))] (-> i64)
  (let [c (link-package-cell)]
    (when (= (primitive/cast i64 (.roots c)) 0)
      (set! (.roots c)
            (new-boxed-list [LinkPackageRoot] a))
      0)
    (let [(mut e) (zeroed LinkPackageRoot)]
      (set! (.id e) id)
      (set! (.root e) root)
      (set! (.used e) false)
      (push! [LinkPackageRoot] (.roots c) e))
    0))

; Record that a namespace resolved to `path`: every registered package that owns
; the file is loaded by this compilation.
(defn link-package-note-path! [(path (slice u8))] (-> i64)
  (let [rs (link-package-roots)]
    (unless (= (primitive/cast i64 rs) 0)
      (for [i 0 (len (load rs))]
        (let [e (elem rs i)]
          (when (dep-path-contained? (.root e) path) (set! (.used e) true) 0))
        0)
      0)
    0))

(defn link-package-used? [(id i64)] (-> bool)
  (let [rs (link-package-roots)
        (mut found) false]
    (unless (= (primitive/cast i64 rs) 0)
      (for [i 0 (len (load rs))]
        (let [e (elem rs i)]
          (when (and (= (.id e) id) (.used e)) (set! found true) 0))
        0)
      0)
    (load found)))

;; ---- packages: which manifest owns a file ------------------------------------
;;
;; A reader or manifest provider configures itself from its package's Coil.toml:
;; the C reader's [c.<module>] sections, the paths inside them. A dependency's
;; files belong to the dependency's manifest, not to the consumer's, so the
;; loader keeps the project's packages -- source roots, manifest, entry -- and
;; hands a reader the manifest of the package that owns the file it reads (in
;; the read-context, never through the process environment).
;;
;; The driver owns manifests; the loader asks it, through a registered builder,
;; for the packages of the project whose manifest is `manifest` (an absolute
;; path), once per project per process.
(defstruct PackageContext
  [(roots (ptr (ArrayList (slice u8))))
   (manifest (slice u8))
   (entry (slice u8))
   ; A dependency, as opposed to the project's own package.
   (dependency bool)])

(defstruct PackageRegistry
  [(manifest (slice u8))
   (packages (ptr (ArrayList PackageContext)))])

(defstruct PackageRegistryCell
  [(built (ptr (ArrayList PackageRegistry)))
   (builder (fnptr (cc/C) [(slice u8)] (ptr (ArrayList PackageContext))))
   (has-builder bool)])

(defn package-registry-cell [] (-> (ptr PackageRegistryCell))
  (primitive/alloc-static PackageRegistryCell))

(defn set-package-registry-builder! [(fp (fnptr (cc/C)
                                                [(slice u8)]
                                                (ptr (ArrayList PackageContext))))]
  (-> i64)
  (set! (.builder (package-registry-cell)) fp)
  (set! (.has-builder (package-registry-cell)) true)
  0)

;;; Record the packages of the project whose manifest is `manifest` (absolute),
;;; for a driver that has already prepared that manifest.
(defn package-registry-put! [(manifest (slice u8))
                             (pkgs (ptr (ArrayList PackageContext)))] (-> i64)
  (let [c (package-registry-cell)]
    (when (= (primitive/cast i64 (.built c)) 0)
      (set! (.built c)
            (box-al (malloc-allocator)
                    (ArrayList::new [PackageRegistry] (malloc-allocator))))
      0)
    (let [(mut replaced) false]
      (for [i 0 (len (load (.built c)))]
        (let [r (elem (.built c) i)]
          (when (= (.manifest r) manifest)
            (set! (.packages r) pkgs)
            (set! replaced true)
            0))
        0)
      (unless (load replaced)
        (push! [PackageRegistry]
               (.built c)
               (PackageRegistry
                 :manifest (text/format (malloc-allocator) "{}" manifest)
                 :packages pkgs))
        0))
    0))

;;; The consumer's manifest, absolute: COIL_MANIFEST_PATH resolved against the
;;; working directory, or "" when no project manifest is configured.
(defn project-manifest-path [(a (dyn Allocator))] (-> (slice u8))
  (let [p (unit-getenv c"COIL_MANIFEST_PATH")]
    (if (= (primitive/cast i64 p) 0)
        ""
        (match (realpath-opt a (from-cstr p))
          (Some [abs] abs)
          (None [] "")))))

;;; The packages of the project whose manifest is COIL_MANIFEST_PATH; null when
;;; there is none or no builder is registered.
(defn project-packages [(a (dyn Allocator))]
  (-> (ptr (ArrayList PackageContext)))
  (let [c (package-registry-cell)
        manifest (project-manifest-path a)]
    (if (or (= (len manifest) 0) (not (.has-builder c)))
        (primitive/cast (ptr (ArrayList PackageContext)) 0)
        (do
          (let [(mut found) (primitive/cast (ptr (ArrayList PackageContext)) 0)]
            (unless (= (primitive/cast i64 (.built c)) 0)
              (for [i 0 (len (load (.built c)))]
                (let [r (elem (.built c) i)]
                  (when (= (.manifest r) manifest) (set! found (.packages r)) 0))
                0)
              0)
            (when (= (primitive/cast i64 (load found)) 0)
              (let [pkgs (call-ptr (.builder c) manifest)]
                (package-registry-put! manifest pkgs)
                (set! found pkgs))
              0)
            (load found))))))

;;; The manifest of the package whose source roots hold `path` (the deepest such
;;; root wins, so a dependency nested inside the project is its own package);
;;; otherwise the project's manifest; "" when there is no project.
(defn package-manifest-for [(a (dyn Allocator)) (path (slice u8))]
  (-> (slice u8))
  (let [pkgs (project-packages a)
        (mut best) ""
        (mut depth) -1]
    (unless (= (primitive/cast i64 pkgs) 0)
      (for [i 0 (len (load pkgs))]
        (let [p (elem pkgs i)]
          (for [j 0 (len (load (.roots p)))]
            (let [root (get (load (.roots p)) j)]
              (when (and (> (len root) (load depth))
                         (dep-path-contained? root path))
                (set! depth (len root))
                (set! best (.manifest p))
                0))
            0))
        0)
      0)
    (if (> (len (load best)) 0) (load best) (project-manifest-path a))))

(defstruct LoaderArtifactInput [(path (slice u8)) (text (slice u8))])

; A module compiled ahead of time by `coil build-unit`. `source` is its
; interface -- the module's types, its concrete functions as `declare`s, and
; its generic functions as source -- read in place of the module's file.
; `object` defines the declared functions; `dylib` is the same code linked as
; a shared library, loaded into this process so a metaprogram can call it.
(defstruct PrebuiltUnit
  [(module (slice u8))
   (dir (slice u8))
   (object (slice u8))
   (dylib (slice u8))
   (source Resolved)
   ; Set true the first time this unit's interface stands in for an import, so
   ; its object is linked only when the program actually imports the module. An
   ; explicitly named `--unit` sets it at registration; a unit the toolchain
   ; makes always available (the shipped coil.jit) links only if imported.
   (used bool)
   ; A unit the toolchain provides but has not looked at yet (the shipped
   ; coil.jit): whether a built one is fresh, and building one if not, waits for
   ; the first import of `module`, through the registered lazy builder
   ; (prebuilt-realize!). Only `module`, `dir` and `backend` are meaningful until
   ; then. A pending unit is never linked.
   (pending bool)
   ; The backend that emitted (or will emit) the unit's object: 1 LLVM, 2 arm64,
   ; 5 x86-64. Always the consuming build's own backend -- the backends do not
   ; share one calling convention for every aggregate, so units never cross them.
   (backend i64)])

;;; Note, for link-package selection, every source a prebuilt unit serving
;;; `name` was built from: the unit's `unit.sources`, one "digest path" per line.
(defn link-package-note-unit-sources! [(a (dyn Allocator)) (name (slice u8))]
  (-> i64)
  (let [units (.prebuilt (loader-unit-state))]
    (unless (= (primitive/cast i64 units) 0)
      (for [i 0 (len (load units))]
        (let [entry (elem units i)]
          (when (and (= (.module entry) name) (not (.pending entry)))
            (match (read-file-opt a
                                  (to-cstr a
                                           (path-join a
                                                      (.dir entry)
                                                      "unit.sources")))
              (None [] 0)
              (Some [text]
                    (let [lines (split a text "\n")]
                      (for [j 0 (len (load lines))]
                        (let [line (get (load lines) j)
                              (mut space) -1]
                          (for [k 0 (len line)]
                            (when (and (< (load space) 0)
                                       (= (primitive/cast i64 (get line k)) 32))
                              (set! space k)
                              0)
                            0)
                          (when (>= (load space) 0)
                            (link-package-note-path! (subslice line
                                                               (+ (load space)
                                                                  1)
                                                               (len line)))
                            0))
                        0)
                      0)))
            0))
        0)
      0)
    0))

(defn prebuilt-mark-used! [(name (slice u8))] (-> i64)
  (let [units (.prebuilt (loader-unit-state))]
    (unless (= (primitive/cast i64 units) 0)
      (for [i 0 (len (load units))]
        (let [entry (elem units i)]
          (when (and (= (.module entry) name) (prebuilt-realize! entry))
            (set! (.used entry) true)
            0))
        0)
      0)
    0))

; The driver owns building units (it runs `coil build-unit` as a child); the
; loader only learns WHEN a pending unit is first needed. The driver registers
; its builder here at startup, the same way it registers the unit object builder.
(defstruct LazyUnitBuilderBox
  [(isset i64) (fp (fnptr (cc/C) [(ptr PrebuiltUnit)] i64))])

(defn lazy-unit-builder-box [] (-> (ptr LazyUnitBuilderBox))
  (primitive/alloc-static LazyUnitBuilderBox))

(defn set-lazy-unit-builder! [(fp (fnptr (cc/C) [(ptr PrebuiltUnit)] i64))]
  (-> i64)
  (let [b (lazy-unit-builder-box)] (set! (.fp b) fp) (set! (.isset b) 1) 0))

; Build a pending unit now, on the first import of its module. True when the
; unit is (now) built; false leaves it pending, and its module then compiles
; from source like any module no unit stands in for.
(defn prebuilt-realize! [(entry (ptr PrebuiltUnit))] (-> bool)
  (if (not (.pending entry))
      true
      (let [b (lazy-unit-builder-box)]
        (if (= (.isset b) 0)
            false
            (do
              (call-ptr (.fp b) entry)
              (not (.pending entry)))))))

(defn prebuilt-units [] (-> (ptr (ArrayList PrebuiltUnit)))
  (.prebuilt (loader-unit-state)))

; The link inputs prebuilt units contribute: only those actually imported, so a
; unit the toolchain makes available but the program never imports costs nothing.
(defn prebuilt-objects [(a (dyn Allocator))] (-> (ptr (ArrayList (slice u8))))
  (let [units (prebuilt-units)
        (mut out) (ArrayList::new [(slice u8)] a)]
    (unless (= (primitive/cast i64 units) 0)
      (for [i 0 (len (load units))]
        (let [u (elem units i)]
          (when (.used u) (push! (mut out) (.object u)) 0))
        0)
      0)
    (box-al a (load out))))

(defn loader-unit-state-cell [] (-> (ptr (ptr LoaderUnitState)))
  (primitive/alloc-static (ptr LoaderUnitState)))

(defn loader-unit-state [] (-> (ptr LoaderUnitState))
  (let [p (load (loader-unit-state-cell))]
    (if (= (primitive/cast i64 p) 0) (primitive/alloc-static LoaderUnitState) p)))

(defn loader-unit-bind! [(next (ptr LoaderUnitState))]
  (-> (ptr LoaderUnitState))
  (let [prior (load (loader-unit-state-cell))]
    (set! (loader-unit-state-cell) next)
    prior))

(import "coil.alloc" :as alloc :use *)
(import "coil.result" :use *)
(import "coil.slice" :use *)
(import "coil.str" :use *)
(import "coil.arraylist" :use *)
(import "coil.hashmap" :use *)
(import "coil.io" :use *)
(import "coil.control" :use *)
(import "coil.try" :use *)
(import "coil.compiler.ffi" :use *)
(import "coil.compiler.stdlib_manifest" :use *)  ; which modules the standard library consists of

(import "coil.compiler.ast" :use *)
(import "coil.compiler.parser" :use *)
(import "coil.reader" :use *)
(import "coil.compiler.resolve" :use *)
(import "coil.compiler.cimport" :as ci)  ; the (cimport "h.h") source form generates bindings at load time

(import "coil.compiler.artifact_identity" :as artifact-id)  ; content digests of cimport inputs

(import "coil.cc" :as cc)

(extern opendir :cc (cc/C) [(ptr i8)] (-> (ptr i8)))

(extern readdir :cc (cc/C) [(ptr i8)] (-> (ptr i8)))

(extern closedir :cc (cc/C) [(ptr i8)] (-> i32))

; `struct dirent` has different fixed-prefix layouts on Darwin and Linux. Keep
; the platform choice at compile time; only d_type and d_name are inspected.
; hygiene: platform-layout declarations intentionally use stable public names
(defn loader-public-name [(name Code)] (-> Code)
  (primitive/syntax->datum name))

(defn gen-dirent-layout [] (-> Code)
  `(do
     (const ~(loader-public-name `DIRENT-TYPE-OFFSET) ~(os/os-pick `18 `20 `20))
     (const ~(loader-public-name `DIRENT-NAME-OFFSET) ~(os/os-pick `19 `21 `21))))

(meta (gen-dirent-layout))

(const DT-DIR 4)

(const DT-REG 8)

; Driver-installed bridge to the compiled read-metaprogram setup. Keeping the hook
; here avoids a loader -> driver import cycle while letting recursive imports use
; the same provider engine as the entry file.
(defstruct SourceReaderHook
  [(isset i64)
   (fp (fnptr (cc/C)
              [(ref (dyn Allocator))
               (mut LS)
               (slice u8)
               (slice u8)
               i64
               (slice u8)]
              (ptr (ArrayList Sexp))))])

(defn source-reader-hook [] (-> (ptr SourceReaderHook))
  (field (loader-unit-state) reader))

(defn set-source-reader-hook! [(fp (fnptr (cc/C)
                                          [(ref (dyn Allocator))
                                           (mut LS)
                                           (slice u8)
                                           (slice u8)
                                           i64
                                           (slice u8)]
                                          (ptr (ArrayList Sexp))))] (-> i64)
  (set! (.fp (source-reader-hook)) fp)
  (set! (.isset (source-reader-hook)) 1)
  0)

; Analysis clients that do not request C declaration reflection may defer cimport.
; The source form is consumed normally, but Clang is not spawned just to lint Coil
; syntax in an unrelated module. Ordinary build/check paths leave this disabled.
(defstruct DeferCimportBox [(on i64)])

(defn defer-cimport-box [] (-> (ptr DeferCimportBox))
  (field (loader-unit-state) cimport_policy))

(defn set-defer-cimport! [(on bool)] (-> i64)
  (set! (.on (defer-cimport-box)) (if on 1 0))
  0)

(defn defer-cimport? [] (-> bool)
  (!= (.on (defer-cimport-box)) 0))

; Drain an open fd into `bytes` through a 64 KB bounce buffer, appending each read in
; one `extend!`. Shared by both readers below so the loop exists once.
(defn drain-fd! [(fd i64) (buf (ptr i8)) (bytes (mut (ArrayList u8)))] (-> i64)
  (loop (let [n (read (primitive/cast i32 fd) buf 65536)]
          (if (<= n 0)
              (break)
              (extend! (mut bytes)
                       (primitive/cast (ptr u8) buf)
                       (primitive/cast i64 n)))))
  0)

; ---- the source overlay ---------------------------------------------------------
; Text a command holds for a file in place of the file's bytes. `coil lint --fix`
; and `--diff` analyse the rewrites they propose through it: every read of a
; source file (`read-file`, `read-file-opt`) during the run sees the proposed
; text, and the file itself is never written to try one. Entries are keyed by real
; path, so a relative or symlinked spelling of the same file reads the same text.
; Empty except while such a command runs; the texts belong to it.
(defstruct SourceOverlayEntry [(key (slice u8)) (text (slice u8))])

(defstruct SourceOverlay
  [(ready bool) (entries (ArrayList SourceOverlayEntry))])

(defn source-overlay [] (-> (ptr SourceOverlay))
  (let [o (primitive/alloc-static SourceOverlay)]
    (unless (.ready o)
      (set! (.entries o)
            (ArrayList::new [SourceOverlayEntry] (malloc-allocator)))
      (set! (.ready o) true)
      0)
    o))

;;; The entry of PATH, spelled exactly as a key or resolving to one, or -1. An exact
;;; spelling needs no resolution, which is how the loader names the files it reads.
(defn source-overlay-find [(path (ptr i8))] (-> i64)
  (let [exact (source-overlay-index (from-cstr path))]
    (if (>= exact 0)
        exact
        (let [buf
                (primitive/cast (ptr i8)
                                (primitive/alloc-stack (array u8 4096)))]
          (if (= (primitive/cast i64 (realpath-rooted path buf)) 0)
              -1
              (source-overlay-index (from-cstr buf)))))))

;;; The index of KEY's entry, or -1.
(defn source-overlay-index [(key (slice u8))] (-> i64)
  (let [entries (field (source-overlay) entries)
        (mut at) -1]
    (for [i 0 (len (load entries))]
      (when (and (< at 0) (= (.key (elem entries i)) key)) (set! at i) 0)
      0)
    at))

;;; Read TEXT wherever PATH is read, until the entry is removed. PATH must exist: a
;;; rewrite is proposed for a file that was read.
(defn source-overlay-set! [(path (ptr i8)) (text (slice u8))] (-> i64)
  (let [i (source-overlay-find path)
        entries (field (source-overlay) entries)]
    (if (>= i 0)
        (set! (.text (elem (mut entries) i)) text)
        (let [buf
                (primitive/cast (ptr i8)
                                (primitive/alloc-stack (array u8 4096)))]
          (when (= (primitive/cast i64 (realpath-rooted path buf)) 0)
            (panic "source overlay: a rewrite was proposed for a file that does not resolve"))
          (push! (mut entries)
                 (SourceOverlayEntry
                   :key (text/format (malloc-allocator) "{}" (from-cstr buf))
                   :text text))))
    0))

;;; Read PATH from disk again.
(defn source-overlay-remove! [(path (ptr i8))] (-> i64)
  (let [i (source-overlay-find path)
        entries (field (source-overlay) entries)]
    (when (>= i 0)
      (let [n (len (load entries))]
        (set! (elem (mut entries) i) (get (load entries) (- n 1)))
        (set! (.len entries) (- n 1)))
      0)
    0))

;;; Read every file from disk again.
(defn source-overlay-clear! [] (-> i64)
  (set! (.len (field (source-overlay) entries)) 0)
  0)

;;; The text the overlay holds for PATH.
(defn source-overlay-text [(path (ptr i8))] (-> (Option (slice u8)))
  (if (= (len (.entries (source-overlay))) 0)
      (None [(slice u8)])
      (let [i (source-overlay-find path)]
        (if (< i 0)
            (None [(slice u8)])
            (Some (.text (elem (field (source-overlay) entries) i)))))))

;;; PATH's text as this command sees it: the overlay's when it holds the file,
;;; else the file's bytes (`read-file-disk`).
(defn read-file [(a (dyn Allocator)) (path (ptr i8))] (-> (slice u8))
  (match (source-overlay-text path)
    (Some [text] (text/format a "{}" text))
    (None [] (read-file-disk a path))))

;;; PATH's bytes on disk, whatever the overlay holds.
(defn read-file-disk [(a (dyn Allocator)) (path (ptr i8))] (-> (slice u8))
  (let [fd (open path 0)
        buf
          (primitive/cast (ptr i8)
                          (data (match (alloc-bytes a 65536 1)
                                  (Some [s] s)
                                  (None []
                                        (do
                                          (oom-at c"compiler allocation"
                                                  65536)
                                          (slice::new (primitive/cast (ptr u8)
                                                                      0)
                                                      0))))))
        (mut bytes) (ArrayList::new [u8] a)]
    (drain-fd! (primitive/cast i64 fd) buf (mut bytes))
    (close fd)
    (slice (load bytes))))

; Like `read-file`, but distinguishes "could not open" (None) from an empty file
; (Some ""). `read-file` returns an empty slice for both, which is fine for the
; loader's "is there a module at this path" probing but WRONG for `include-str`,
; where a missing file at compile time is a hard build error, not an empty embed.
(defn read-file-opt [(a (dyn Allocator)) (path (ptr i8))]
  (-> (Option (slice u8)))
  (match (source-overlay-text path)
    (Some [text] (Some (text/format a "{}" text)))
    (None [] (read-file-opt-disk a path))))

(defn read-file-opt-disk [(a (dyn Allocator)) (path (ptr i8))]
  (-> (Option (slice u8)))
  (let [fd (open path 0)]
    (if (< (primitive/cast i64 fd) 0)
        (None [(slice u8)])
        (let [buf
                (primitive/cast (ptr i8)
                                (data (match (alloc-bytes a 65536 1)
                                        (Some [s] s)
                                        (None []
                                              (do
                                                (oom-at c"compiler allocation"
                                                        65536)
                                                (slice::new (primitive/cast (ptr u8)
                                                                            0)
                                                            0))))))
              (mut bytes) (ArrayList::new [u8] a)]
          (drain-fd! (primitive/cast i64 fd) buf (mut bytes))
          (close fd)
          (Some (slice (load bytes)))))))

; A hand-built Program smoke test (no spans → byte-exact against `coil dump-ast`
; of the equivalent source). Validates the dumper before the parser is filled.
(defstruct TaggedForm
  [(form Sexp)
   (module (Option (slice u8)))
   ; Compiler-owned top-level identity. Reader node ids cross native
   ; metaprogram boundaries and can collide; they are node identities, not form
   ; identities. Snapshots preserve this id, generated forms allocate a new one.
   (form_id i64)
   (revision i64)
   ; Zero means unknown. Structural hashing is cached across unchanged
   ; expansion rounds and cleared at every syntax mutation site.
   (cached_shape i64)])

(defstruct Alias [(alias (slice u8)) (target (slice u8))])

(defsum UseSpec
  (UAll [])
  (UNames [(names (ptr (ArrayList (slice u8))))]))

; `:rename [[from to] …]` — refer the target's exported `from` under the local name
; `to`. Renaming REPLACES: once `from` is renamed, the bare `from` stops being referred
; (Clojure's rule), so a rename is an exclude plus an alias in one entry.
(defstruct Rename [(from (slice u8)) (to (slice u8))])

(defstruct Use
  [(target (slice u8))
   (spec UseSpec)
   (exclude (ptr (ArrayList (slice u8))))
   (renames (ptr (ArrayList Rename)))])

(defstruct ModImports
  [(aliases (ArrayList Alias))
   (uses (ArrayList Use))
   ; One edge per `:reexport` import. An edge is a `Use` because it republishes
   ; exactly what that import refers: its `:use` list, minus `:exclude`, under its
   ; `:rename`s. A `:reexport` with no `:use` republishes every name of its target.
   ; `use-refers` on the edge decides, so a facade's interface and its own refers
   ; follow one rule.
   (reexports (ArrayList Use))
   ; The module's effective refer of `coil.core`. Every module refers all of core by
   ; default (Clojure's implicit `clojure.core`); writing ANY explicit
   ; `(import "coil.core" …)` REPLACES that default outright rather than adding to it,
   ; which is exactly how `:refer-clojure` behaves. Held as an ordinary `Use` so the one
   ; `use-refers` predicate below decides core exactly like every other import — core is
   ; the lowest-precedence tier, not a different mechanism.
   (core Use)
   (core_set bool)
   ; Kept out of the checked program, but retained with source spans so opt-in
   ; checker metaprograms can lint and rewrite import syntax.
   (forms (ArrayList Sexp))])

(defstruct ImpEntry [(name (slice u8)) (imp ModImports)])

; ---- the refer rules, in ONE place -----------------------------------------
(defn empty-names [(a (dyn Allocator))] (-> (ptr (ArrayList (slice u8))))
  (box! a (ArrayList (slice u8)) (ArrayList::new [(slice u8)] a)))

(defn empty-renames [(a (dyn Allocator))] (-> (ptr (ArrayList Rename)))
  (box! a (ArrayList Rename) (ArrayList::new [Rename] a)))

; A null exclude/renames list means "none" — the parser only allocates when the
; keyword is actually present, so the common import costs nothing.
(defn mk-use [(a (dyn Allocator))
              (target (slice u8))
              (spec UseSpec)
              (exclude (ptr (ArrayList (slice u8))))
              (renames (ptr (ArrayList Rename)))] (-> Use)
  (let [(mut u) (zeroed Use)]
    (set! (.target u) target)
    (set! (.spec u) spec)
    (set! (.exclude u)
          (if (= (primitive/cast i64 exclude) 0)
              (empty-names a)
              exclude))
    (set! (.renames u)
          (if (= (primitive/cast i64 renames) 0)
              (empty-renames a)
              renames))
    u))

;;; Does this import refer NAME into the importing module, and if so, under which of the
;;; target's own exported names? `(Some exported)` when referred — `exported` differs from
;;; `name` only for a `:rename`. `(None)` when this import does not put `name` in scope.
;;;
;;; ONE predicate, four callers: the resolver (values/types/traits), the ambient primitive
;;; aliases, the macro expander, and the checker's trait-method visibility. Every refer
;;; rule lives here, so all four agree by construction — an `:exclude` that hid a name from
;;; the resolver but left the trait method callable would be worse than no feature at all.
(defn use-refers [(u (ptr Use)) (name (slice u8))] (-> (Option (slice u8)))
  (let [rs (load (field u renames))
        n (len (load rs))
        (mut i) 0
        (mut out) (None [(slice u8)])
        (mut done) false]
    ; A rename settles the question in BOTH directions: the new name is referred
    ; whatever the spec says, and the original name stops being referred.
    (loop (if (or (load done) (>= (load i) n))
              (break)
              (do
                (let [rp (elem rs (load i))]
                  (if (= (.to rp) name)
                      (do (set! out (Some (.from rp))) (set! done true) 0)
                      (when (= (.from rp) name)
                        (set! done true)
                        0)))
                (set! i (primitive/iadd (load i) 1)))))
    (if (load done)
        (load out)
        (if (set-contains (load (field u exclude)) name)
            (None [(slice u8)])
            (match (.spec u)
              (UAll [] (Some name))
              (UNames [names]
                      (if (set-contains names name)
                          (Some name)
                          (None [(slice u8)]))))))))

;;; The inverse of `use-refers`: under which LOCAL name, if any, does this import bring
;;; the target's exported NAME into scope? Needed wherever the walk starts from the
;;; target's declarations instead of from a use site (the ambient primitive aliases).
(defn use-local-of [(u (ptr Use)) (exported (slice u8))]
  (-> (Option (slice u8)))
  (let [rs (load (field u renames))
        n (len (load rs))
        (mut i) 0
        (mut out) (None [(slice u8)])
        (mut done) false]
    (loop (if (or (load done) (>= (load i) n))
              (break)
              (do
                (let [rp (elem rs (load i))]
                  (when (= (.from rp) exported)
                    (set! out (Some (.to rp)))
                    (set! done true)
                    0))
                (set! i (primitive/iadd (load i) 1)))))
    (if (load done)
        (load out)
        (if (set-contains (load (field u exclude)) exported)
            (None [(slice u8)])
            (match (.spec u)
              (UAll [] (Some exported))
              (UNames [names]
                      (if (set-contains names exported)
                          (Some exported)
                          (None [(slice u8)]))))))))

;;; The module's refer of `coil.core`, via the same predicates. A module with no import
;;; record at all (a comptime sub-program, a standalone file with no `(module …)`) refers
;;; all of core — that is the default every module starts from.
(defn core-refers [(imp (ptr ImpEntry)) (name (slice u8))]
  (-> (Option (slice u8)))
  (if (= (primitive/cast i64 imp) 0)
      (Some name)
      (use-refers (field (field imp imp) core) name)))

(defn core-local-of [(imp (ptr ImpEntry)) (exported (slice u8))]
  (-> (Option (slice u8)))
  (if (= (primitive/cast i64 imp) 0)
      (Some exported)
      (use-local-of (field (field imp imp) core) exported)))

;;; Did this import DELIBERATELY drop NAME — an `:exclude` entry, or a `:rename` that
;;; moved it to a different local name? This is a stronger statement than "not referred":
;;; a name merely absent from a `:use [names]` list was never claimed either way, which
;;; matters for trait methods (a method whose trait is unique is callable today with no
;;; import at all, so silence must not be read as refusal).
(defn use-drops? [(u (ptr Use)) (name (slice u8))] (-> bool)
  (if (set-contains (load (field u exclude)) name)
      true
      (let [rs (load (field u renames))
            n (len (load rs))
            (mut i) 0
            (mut r) false]
        (loop (if (or (load r) (>= (load i) n))
                  (break)
                  (do
                    (when (= (.from (elem rs (load i)))
                             name)
                      (set! r true)
                      0)
                    (set! i (primitive/iadd (load i) 1)))))
        (load r))))

;;; Does this module have an explicit `(import "coil.core" …)`? An explicit core import
;;; states core's refer set IN FULL, so it is authoritative in a way an ordinary import
;;; is not.
(defn core-explicit? [(imp (ptr ImpEntry))] (-> bool)
  (if (= (primitive/cast i64 imp) 0)
      false
      (.core_set (.imp imp))))

(defn core-drops? [(imp (ptr ImpEntry)) (name (slice u8))] (-> bool)
  (if (= (primitive/cast i64 imp) 0)
      false
      (use-drops? (field (field imp imp) core) name)))

;;; The `:use` entry a module has for TARGET, or null when it has none.
(defn use-for-target [(imp (ptr ImpEntry)) (target (slice u8))] (-> (ptr Use))
  (if (= (primitive/cast i64 imp) 0)
      (primitive/cast (ptr Use) 0)
      (let [uses (field (field imp imp) uses)
            n (len (load uses))
            (mut i) 0
            (mut r) (primitive/cast (ptr Use) 0)]
        (loop (if (or (>= (load i) n)
                      (!= (primitive/cast i64 (load r)) 0))
                  (break)
                  (do
                    (let [up (elem uses (load i))]
                      (when (= (.target up) target) (set! r up) 0))
                    (set! i (primitive/iadd (load i) 1)))))
        (load r))))

(defstruct ExpEntry
  [(name (slice u8))
   (names (ArrayList (slice u8)))
   ; The checker-facing source view also needs explicit export declarations.
   (forms (ArrayList Sexp))])

; One registered source: a display name + full text. `line_starts` makes located
; diagnostics logarithmic in the line count instead of rescanning from byte zero
; for every warning (project lint can legitimately render hundreds of them).
(defstruct Source
  [(name (slice u8))
   (text (slice u8))
   (line_starts (ptr (ArrayList i64)))])

; A macro-expansion record: the macro name, its call site
; and def site (spans), and the enclosing expansion context (parent ctxt).
(defstruct Expansion
  [(macro_name (slice u8))
   (call_source i64)
   (call_lo i64)
   (call_hi i64)
   (call_ctxt i64)
   (def_source i64)
   (def_lo i64)
   (def_hi i64)
   (def_ctxt i64)
   (parent i64)])

; Shared instrumentation for the semantic workspace. Derived loader states point
; at the same box, so a temporary expansion view cannot hide a full rebuild by
; incrementing a private counter.
(defstruct SemanticAudit
  [(full_resolves i64)
   (incremental_resolve_updates i64)
   (form_parse_attempts i64)
   (unique_form_revisions i64)
   (duplicate_form_parses i64)])

(defstruct SemanticWorkspaceSlot [(value (ptr i8)) (owner (dyn Allocator))])

(defstruct LS
  [(a (dyn Allocator))
   (out (ArrayList TaggedForm))
   (loaded (ArrayList (slice u8)))
   ; resolved-path -> declared module name, for files already read (see read-memo-find)
   (readpaths (ArrayList (slice u8)))
   (readmods (ArrayList (slice u8)))
   (imports (ArrayList ImpEntry))
   (exports (ArrayList ExpEntry))
   ; Source-visible compiler operations and aliases, collected from ordinary
   ; namespaced top-level declarations. Opcodes never participate in name lookup.
   (primitive_defs (ArrayList PrimitiveDef))
   (primitive_aliases (ArrayList PrimitiveAlias))
   (srccount i64)
   ; The SourceMap: sources[id] = the file at that id (main=0, prelude=1, imports
   ; 2..). expansions[ctxt-1] = the macro provenance for ctxt (>=1). Both grow in
   ; the exact order registers them, so ids/ctxts match the reference.
   (sources (ArrayList Source))
   (expansions (ArrayList Expansion))
   ; No slot of `expansions` below this index is free. Only a retained session's
   ; provenance prune frees slots (and lowers this); an ordinary compilation never
   ; does, so every new expansion appends in O(1).
   (expansion_free_from i64)
   ; All type-check body errors (build path renders every one; the dump-checked
   ; oracle still reports [0]). A heap-boxed list so the checker can push through it.
   (check_diags (ptr (ArrayList Diag)))
   ; Parallel to check_diags. Empty means a non-function diagnostic; otherwise
   ; this is the exact qualified source function being checked.
   (check_diag_owners (ptr (ArrayList (slice u8))))
   ; All RESOLVE body errors, same treatment: resolve collects per function and
   ; continues instead of aborting the pipeline on the first, so a batch of mistakes
   ; is reported in one pass (the checker already did this; resolve did not). The
   ; qualified names of functions whose BODY failed to resolve — the checker skips
   ; their bodies but keeps their SIGNATURES in the table, so callers don't cascade.
   (resolve_diags (ptr (ArrayList Diag)))
   (resolve_poisoned (ptr (ArrayList (slice u8))))
   ; The loader's first error, as a framed Diag.
   ; Threaded via a slot (not a Result return) so the loop-heavy loader
   ; keeps its i64 signatures; set once, then process-forms/-import bail early and
   ; run-pipeline reports it through the SAME render path as every other diagnostic.
   (loaderr Diag)
   (loaderr_set bool)
   ; Keep index-only state at the tail: staged compiler components share LS's
   ; established prefix layout across their native metaprogram boundary.
   (namespace_names (ArrayList (slice u8)))
   (namespace_paths (ArrayList (slice u8)))
   ; The entry file's declared module. `main` is the one function the resolver never
   ; renames, so its qualified name carries no module — and without this, anything that
   ; asks "which module is this code in?" (import-driven visibility, refer control) gets
   ; no answer inside `main` and silently falls back to "no restrictions".
   (entry_module (slice u8))
   ; Invocation-time Code entries owned by the driver (currently reader
   ; providers). They remain ordinary declarations in the loaded graph but must
   ; never join definition-time eager/lazy staging for that graph.
   (stage_excluded (ArrayList (slice u8)))
   ; When non-null, only modules listed here contribute checker/transform/derive
   ; registrations. A lint analysis loads every owned module as a ROOT to lint it;
   ; that must not also activate each one's own registrations.
   (registration_scope (ptr (ArrayList (slice u8))))
   ; Definition-module import tables carried by hygienic syntax across an
   ; isolated phase boundary. These are resolution metadata, never source forms.
   (hygiene_imports (ArrayList ImpEntry))
   ; Opaque state owned by a compiler SDK session. Only metaprogram Code
   ; operations inspect it; ordinary builds leave it null.
   ; Explicit ambient-provider bookkeeping. A module enters `core_declared_modules`
   ; only through `(provide-core ...)`; the parallel contribution arrays enforce
   ; collision-free assembly across root-activated providers.
   (core_declared_modules (ArrayList (slice u8)))
   (code_session_state (ptr i8))
   ; Opaque, compilation-owned semantic workspace. Resolution owns the concrete
   ; type; loader only establishes its lifetime. Every derived LS used by
   ; expansion must borrow this pointer rather than constructing an independent
   ; parsed/resolved universe.
   (semantic_workspace (ptr SemanticWorkspaceSlot))
   ; Auditable pipeline invariants. `full_resolves` counts complete
   ; workspace construction, not incremental updates. Once the workspace
   ; migration is complete, production compilation asserts this never exceeds
   ; one and the regression gate checks the parse counters per form revision.
   (semantic_audit (ptr SemanticAudit))
   ; Every source file the namespace index visited under its roots, whether or
   ; not it declares a module. Project commands that need "the files this
   ; package owns" (lint, fmt, migration scans) read this instead of shelling
   ; out to `find`; it is the same walk, with the same exclusions.
   (indexed_paths (ArrayList (slice u8)))
   ; A retained compiler submission borrows the previous accepted environment.
   ; Only this submission's syntax lives in out. Parent syntax is never replayed.
   (parent (ptr LS))
   (checked (ptr Program))
   (checked_functions (HashMap (slice u8) i64))
   (semantic_maps (ptr i8))
   (checker_context (ptr i8))
   (pipeline_forms (ArrayList TaggedForm))
   (resolution_state (ptr AstUnitState))
   (meta_environment (ptr LS))

   ; Opaque persistent callable-signature base owned by CompilerRevision.
   ; Keep this appended: staged components share LS's established layout.
   (persistent_sigs (ptr i8))
   ; Persistent name -> sealed checked function index. Appended for bootstrap ABI.
   (persistent_checked (ptr i8))
   ; Persistent (module, raw name) -> declaration-kind mask.
   (persistent_declarations (ptr i8))
   ; Dependency entries already read to learn the module their reader names
   ; (see discover-reader-named); a later import of that file reuses the forms.
   (probed (ArrayList ProbedModule))
   ; Borrowed retained dependency graph. Appended for bootstrap ABI.
   (persistent_dependencies (ptr i8))
   ; The top-level forms of the submissions a retained session has accepted:
   ; the inherited ones (the first `retained_inherited`), then this candidate's,
   ; recorded on acceptance. What a program-description query copies as source
   ; (program_query.coil) may have been written in an earlier submission.
   (retained_forms (ArrayList RetainedForm))
   (retained_inherited i64)
   ; Appended. In a cross build, the compilation of the code that runs inside
   ; the compiler -- macros, `(meta …)` generators, transforms -- expanded for the
   ; host (expander.coil's HostStage, opaque here). Null otherwise.
   (host_stage (ptr i8))
   ; Appended. True on that host compilation itself.
   (host_role bool)
   ; Appended. In a cross build's program, the qualified names of the definitions
   ; it left to the host stage, which defines them. Null otherwise.
   (host_defined (ptr (ArrayList (slice u8))))])

;;; One accepted top-level form: what defines it, and its text. TEXT is "" when
;;; the form is its own authored source at SOURCE [LO, HI) (the source table is
;;; retained); a form a macro produced keeps its printed text.
(defstruct RetainedForm
  [(module (slice u8))
   (head (slice u8))
   (name (slice u8))
   (key (slice u8))
   (source i64)
   (lo i64)
   (hi i64)
   (text (slice u8))])

(defstruct ProbedModule
  [(disp (slice u8))
   (text (slice u8))
   ; the module the reader's output declares; "" when it declares none
   (declared (slice u8))
   (forms (ptr (ArrayList Sexp)))])

(defstruct Resolved [(text (slice u8)) (incdir (slice u8)) (disp (slice u8))])

; Borrowed declaration-only sources owned by the enclosing generated program.
; They are not filesystem aliases and never mutate the process environment.
(defstruct VirtualSource [(name (slice u8)) (source Resolved)])

(defn virtual-source [(name (slice u8))] (-> (ptr Resolved))
  (let [sources (.virtual_sources (loader-unit-state))
        units (.prebuilt (loader-unit-state))
        (mut found) (primitive/cast (ptr Resolved) 0)]
    (unless (= (primitive/cast i64 sources) 0)
      (for [i 0 (len (load sources))]
        (let [entry (elem sources i)]
          (when (= (.name entry) name) (set! found (field entry source)) 0))
        0)
      0)
    ; A prebuilt unit's interface stands in for its module's source file. Mark it
    ; used so its object is linked; a unit nothing imports is never linked. A
    ; pending unit is built here, on this first import; if it cannot be built,
    ; nothing stands in and the module compiles from source.
    (when (and (= (primitive/cast i64 (load found)) 0)
               (!= (primitive/cast i64 units) 0))
      (for [i 0 (len (load units))]
        (let [entry (elem units i)]
          (when (and (= (.module entry) name) (prebuilt-realize! entry))
            (set! (.used entry) true)
            (set! found (field entry source))
            0))
        0)
      0)
    (load found)))

;;; Initialize EVERY field of a fresh LS.
;;;
;;; LS is stack-allocated and used to be hand-initialized field by field at fifteen
;;; separate call sites. That is how eight of them ended up never setting
;;; `namespace_names`/`namespace_paths`: those two read uninitialized stack memory, and
;;; the visible symptom was `coil expand` failing to resolve a project namespace that
;;; `coil check` resolved fine, because the two commands initialize their LS in different
;;; files. A twenty-field struct cannot be correctly initialized by hand in fifteen
;;; places — it has to be one function, so that adding a field is one edit and cannot
;;; leave a site half-built.
;;;
;;; Callers still override what is genuinely theirs afterwards (`srccount`, and the
;;; sub-program builders that deliberately share a parent's boxed diagnostic lists).
(defn ls-init! [(s (mut LS)) (a (dyn Allocator))] (-> i64)
  (set! (.a s) a)
  (init-fields! s
                (ArrayList::new a)
                [out loaded readpaths readmods imports exports primitive_defs
                 primitive_aliases sources expansions])
  (set! (.expansion_free_from s) 0)
  (set! (.retained_forms s) (ArrayList::new [RetainedForm] a))
  (set! (.retained_inherited s) 0)
  (set! (.namespace_names s) (ArrayList::new [(slice u8)] a))
  (set! (.namespace_paths s) (ArrayList::new [(slice u8)] a))
  (set! (.srccount s) 0)
  (set! (.check_diags s) (new-boxed-list [Diag] a))
  (set! (.check_diag_owners s)
        (new-boxed-list [(slice u8)] a))
  (set! (.resolve_diags s) (primitive/cast (ptr (ArrayList Diag)) 0))
  (set! (.resolve_poisoned s) (primitive/cast (ptr (ArrayList (slice u8))) 0))
  (set! (.loaderr s) (zeroed Diag))
  (set! (.loaderr_set s) false)
  (set! (.entry_module s) "")
  (set! (.stage_excluded s) (ArrayList::new [(slice u8)] a))
  (set! (.registration_scope s) (cast (ptr (ArrayList (slice u8))) 0))
  (set! (.hygiene_imports s) (ArrayList::new [ImpEntry] a))
  (set! (.core_declared_modules s) (ArrayList::new [(slice u8)] a))
  (set! (.code_session_state s) (primitive/cast (ptr i8) 0))
  (set! (.semantic_workspace s)
        (box! a SemanticWorkspaceSlot (zeroed SemanticWorkspaceSlot)))
  (set! (.owner (load (field s semantic_workspace))) a)
  (set! (.semantic_audit s)
        (box! a SemanticAudit (zeroed SemanticAudit)))
  (set! (.indexed_paths s) (ArrayList::new [(slice u8)] a))
  (set! (.meta_environment s) (primitive/cast (ptr LS) 0))
  (set! (.parent s) (primitive/cast (ptr LS) 0))
  (set! (.checked s) (primitive/cast (ptr Program) 0))
  (set! (.checked_functions s)
        (HashMap::new [(slice u8) i64] a (keyops-borrowed)))
  (set! (.semantic_maps s) (primitive/cast (ptr i8) 0))
  (set! (.checker_context s) (primitive/cast (ptr i8) 0))
  (set! (.pipeline_forms s) (ArrayList::new [TaggedForm] a))
  (set! (.resolution_state s) (primitive/cast (ptr AstUnitState) 0))
  (set! (.persistent_sigs s) (primitive/cast (ptr i8) 0))
  (set! (.persistent_checked s) (primitive/cast (ptr i8) 0))
  (set! (.persistent_dependencies s) (primitive/cast (ptr i8) 0))
  (set! (.persistent_declarations s) (primitive/cast (ptr i8) 0))
  (set! (.probed s) (ArrayList::new [ProbedModule] a))
  (set! (.host_stage s) (primitive/cast (ptr i8) 0))
  (set! (.host_role s) false)
  (set! (.host_defined s) (primitive/cast (ptr (ArrayList (slice u8))) 0))
  0)

; A derived LS may use a different allocator and form list, but its semantic
; identity belongs to the parent compilation. Keep this operation explicit at
; every phase boundary; copying fields ad hoc is what allowed expansion to
; reconstruct the entire program without the owning pipeline being able to see
; or prevent it.
(defn ls-borrow-semantics! [(child (mut LS)) (parent (mut LS))] (-> i64)
  (set! (.semantic_workspace child) (.semantic_workspace parent))
  (set! (.semantic_audit child) (.semantic_audit parent))
  (set! (.parent child) (.parent parent))
  0)

;;; Copy a container into a candidate allocator. Its elements remain immutable
;;; borrows from the accepted parent; mutable nested import/export containers are
;;; copied separately below. The parent owner must outlive the candidate.
(defn ls-copy-list [T] [(a (dyn Allocator)) (items (ref (ArrayList T)))]
  (-> (ArrayList T))
  (let [(mut out) (ArrayList::new [T] a)]
    (for [i 0 (len items)] (push! (mut out) (get items i)))
    (load out)))

(defn ls-copy-imports [(a (dyn Allocator)) (items (ref (ArrayList ImpEntry)))]
  (-> (ArrayList ImpEntry))
  (let [(mut out) (ArrayList::new [ImpEntry] a)
        (mut entry) (zeroed ImpEntry)]
    (for [i 0 (len items)]
      (do
        (set! entry (get items i))
        (set! (.aliases (.imp entry))
              (ls-copy-list [Alias] a (.aliases (.imp entry))))
        (set! (.uses (.imp entry)) (ls-copy-list [Use] a (.uses (.imp entry))))
        (set! (.reexports (.imp entry))
              (ls-copy-list [Use] a (.reexports (.imp entry))))
        (set! (.forms (.imp entry))
              (ls-copy-list [Sexp] a (.forms (.imp entry))))
        (push! (mut out) entry)))
    (load out)))

(defn ls-copy-exports [(a (dyn Allocator)) (items (ref (ArrayList ExpEntry)))]
  (-> (ArrayList ExpEntry))
  (let [(mut out) (ArrayList::new [ExpEntry] a)
        (mut entry) (zeroed ExpEntry)]
    (for [i 0 (len items)]
      (do
        (set! entry (get items i))
        (set! (.names entry) (ls-copy-list [(slice u8)] a (.names entry)))
        (set! (.forms entry) (ls-copy-list [Sexp] a (.forms entry)))
        (push! (mut out) entry)))
    (load out)))

;;; Inherit resolution metadata without loading or parsing accepted sources.
;;; This does not copy parent out or its mutable semantic revision workspace.
(defn ls-inherit! [(s (mut LS)) (parent (ptr LS))] (-> i64)
  (let [a (.a s)]
    (set! (.parent s) parent)
    (set! (.meta_environment s) (.meta_environment parent))
    (set! (.entry_module s) (.entry_module parent))
    (set! (.srccount s) (.srccount parent))
    (set! (.loaded s) (ls-copy-list [(slice u8)] a (.loaded parent)))
    (set! (.readpaths s) (ls-copy-list [(slice u8)] a (.readpaths parent)))
    (set! (.readmods s) (ls-copy-list [(slice u8)] a (.readmods parent)))
    (set! (.primitive_defs s)
          (ls-copy-list [PrimitiveDef] a (.primitive_defs parent)))
    (set! (.primitive_aliases s)
          (ls-copy-list [PrimitiveAlias] a (.primitive_aliases parent)))
    (set! (.sources s) (ls-copy-list [Source] a (.sources parent)))
    (set! (.expansions s) (ls-copy-list [Expansion] a (.expansions parent)))
    (set! (.retained_forms s)
          (ls-copy-list [RetainedForm] a (.retained_forms parent)))
    (set! (.retained_inherited s) (len (.retained_forms parent)))
    (set! (.expansion_free_from s) (.expansion_free_from parent))
    (set! (.namespace_names s)
          (ls-copy-list [(slice u8)] a (.namespace_names parent)))
    (set! (.namespace_paths s)
          (ls-copy-list [(slice u8)] a (.namespace_paths parent)))
    (set! (.stage_excluded s)
          (ls-copy-list [(slice u8)] a (.stage_excluded parent)))
    (set! (.registration_scope s) (.registration_scope parent))
    (set! (.core_declared_modules s)
          (ls-copy-list [(slice u8)] a (.core_declared_modules parent)))
    (set! (.indexed_paths s)
          (ls-copy-list [(slice u8)] a (.indexed_paths parent)))
    (set! (.imports s) (ls-copy-imports a (.imports parent)))
    (set! (.hygiene_imports s) (ls-copy-imports a (.hygiene_imports parent)))
    (set! (.exports s) (ls-copy-exports a (.exports parent)))
    (set! (.persistent_checked s) (.persistent_checked parent))
    (set! (.persistent_dependencies s) (.persistent_dependencies parent))
    (set! (.persistent_declarations s) (.persistent_declarations parent))
    0))

; `checked_functions` borrows its keys: each is the name held by the function record
; it indexes, which lives exactly as long as the map does. An owned copy per key was a
; separate allocation per function, made again at a new address on every rebuild --
; which is what kept the table from ever looking the same twice to whoever retains it.
;;; Recognize the exact immutable checked body borrowed from a parent. A new
;;; function that happens to have the same spelling is not a cache hit.
(defn ls-function [(s (ptr LS)) (name (slice u8))] (-> (Option (ptr Func)))
  (if (= (primitive/cast i64 s) 0)
      (None [(ptr Func)])
      (match (get (.checked_functions s) name)
        (None []
              (checkedbase/checked-base-get (primitive/cast (ptr checkedbase/CheckedBase)
                                                            (.persistent_checked s))
                                            name))
        ; A negative overlay entry masks a definition removed from the base.
        (Some [index]
              (if (< index 0)
                  (None [(ptr Func)])
                  (Some (elem (.funcs (.checked s)) index)))))))

(defn ls-defines-function? [(s (ptr LS)) (name (slice u8))] (-> bool)
  (match (ls-function s name) (None [] false) (Some [function] true)))

(defn ls-same-function? [(s (ptr LS)) (f (ptr Func))] (-> bool)
  (match (ls-function s (.name f))
    (None [] false)
    (Some [old]
          (= (primitive/cast i64 (.body old))
             (primitive/cast i64 (.body f))))))

(defn ls-accepted-function? [(s (mut LS)) (f (ptr Func))] (-> bool)
  (let [parent (.parent s)]
    (ls-same-function? parent f)))

(defn ls-accept-checked! [(s (mut LS)) (checked (ptr Program))] (-> i64)
  (set! (.checked s) checked)
  (clear! (mut (.checked_functions s)))
  (for [i 0 (len (load (.funcs checked)))]
    (let [function (elem (.funcs checked) i)
          base
            (primitive/cast (ptr checkedbase/CheckedBase)
                            (.persistent_checked s))]
      (unless (match (checkedbase/checked-base-get base (.name function))
                (None [] false)
                (Some [old]
                      (= (primitive/cast i64 (.body old))
                         (primitive/cast i64 (.body function)))))
        (set! (mut (.checked_functions s)) (.name function) i)
        0)))
  0)

;;; Record this candidate's top-level forms, after the inherited ones that still
;;; describe the accepted program. What is kept follows what the program defines,
;;; so it does not grow with a session's history: an inherited form goes once this
;;; submission redefines or retires what it defines, and any named form goes once
;;; the accepted declarations no longer name it (a reclaimed definition, a hidden
;;; entry). It is called on the candidate's own state where its forms are accepted,
;;; and again after publication hides or prunes names; each run reconsiders the
;;; inherited prefix and rebuilds this candidate's part, so a second run is not a
;;; second copy. A view of accepted state (a phase parent, a facade) carries the
;;; list it was copied with and never calls this: its allocator may be sealed.
(defn ls-retain-forms! [(s (mut LS))] (-> i64)
  (let [a (.a s)
        (mut current) (ArrayList::new [RetainedForm] a)
        (mut retired) (ArrayList::new [(slice u8)] a)]
    (for [i 0 (len (.out s))]
      (let [tf (elem (field s out) i)]
        (ls-collect-form! (mut s)
                          (match (.module tf) (Some [m] m) (None [] ""))
                          (field tf form)
                          (mut current)
                          (mut retired))))
    (let [(mut kept) (ArrayList::new [RetainedForm] a)]
      (for [i 0 (.retained_inherited s)]
        (let [rf (elem (field s retained_forms) i)]
          (when (ls-retained-live? (mut s) rf (mut current) (mut retired))
            (push! (mut kept) (load rf))
            0)))
      (set! (.retained_inherited s) (len kept))
      (for rf (iter current)
        (when (or (= (len (.name rf)) 0)
                  (ls-declares? (mut s) (.module rf) (.name rf)))
          (push! (mut kept) rf)
          0))

      (set! (.retained_forms s) (load kept))))
  0)

;;; What an entry is about, for supersession: its name, or for a form defining
;;; none the text that identifies it (an impl's header, an import itself).
(defn ls-retained-key [(rf (ptr RetainedForm))] (-> (slice u8))
  (if (> (len (.name rf)) 0) (.name rf) (.key rf)))

(defn ls-retained-live? [(s (mut LS))
                         (rf (ptr RetainedForm))
                         (current (mut (ArrayList RetainedForm)))
                         (retired (mut (ArrayList (slice u8))))] (-> bool)
  (let [key (ls-retained-key rf)
        (mut superseded) false]
    (for [i 0 (len current)]
      (let [c (elem (mut current) i)]
        (when (and (= (.module c) (.module rf)) (= (ls-retained-key c) key))
          (set! superseded true))))
    (cond superseded false
          ; A definition: only while the accepted declarations name it.
          (> (len (.name rf)) 0) (ls-declares? (mut s) (.module rf) (.name rf))
          ; An impl: until its header, trait or type is retired.
          (or (= (.head rf) "impl") (= (.head rf) "derive"))
            (let [(mut gone) false]
              (for r (iter retired)
                (when (or (= r (ls-qualified-key (.a s) (.module rf) (.key rf)))
                          (ls-impl-names? (.a s) rf r))
                  (set! gone true)))
              (not gone))
          :else true)))

(defn ls-qualified-key [(a (dyn Allocator))
                        (module (slice u8))
                        (key (slice u8))] (-> (slice u8))
  (text/format a "{} {}" module key))

;;; Does impl entry RF name the retired trait or type R (qualified)?
(defn ls-impl-names? [(a (dyn Allocator))
                      (rf (ptr RetainedForm))
                      (r (slice u8))] (-> bool)
  (let [(mut found) false]
    (for word (split a (.key rf) " ")
      (let [bare (ls-strip-brackets word)]
        (when (or (= (ls-qualified-key a (.module rf) bare) r)
                  (= (text/format a "{} .{}" (.module rf) bare) r))
          (set! found true))))
    found))

(defn ls-strip-brackets [(w (slice u8))] (-> (slice u8))
  (let [(mut lo) 0
        (mut hi) (len w)]
    (loop (if (and (< lo hi)
                   (or (= (get w lo) (: 40 u8)) (= (get w lo) (: 91 u8))))
              (set! lo (+ lo 1))
              (break)))
    (loop (if (and (> hi lo)
                   (or (= (get w (- hi 1)) (: 41 u8))
                       (= (get w (- hi 1)) (: 93 u8))))
              (set! hi (- hi 1))
              (break)))
    (subslice w lo hi)))

;;; Does the accepted declaration table give MODULE a declaration named NAME?
(defn ls-declares? [(s (mut LS)) (module (slice u8)) (name (slice u8))]
  (-> bool)
  (let [ws (semantic-workspace (mut s))
        table (.declaration_table ws)]
    (and (.has_declaration_table ws)
         (let [entry (table-find table module)]
           (and (!= (primitive/cast i64 entry) 0) (!= (defs-mask entry name) 0))))))

;;; Gather one top-level form (splicing `do`): an entry for what it defines, or,
;;; for a retirement, the qualified key of what it retires.
(defn ls-collect-form! [(s (mut LS))
                        (module (slice u8))
                        (f (ptr Sexp))
                        (current (mut (ArrayList RetainedForm)))
                        (retired (mut (ArrayList (slice u8))))] (-> i64)
  (let [a (.a s)
        head (match (l-list-head f) (Some [h] h) (None [] ""))
        items (sx-items (load f))]
    (cond (= head "do")
            (for [i 1 (sx-len items)]
              (ls-collect-form! (mut s)
                                module
                                (elem items i)
                                (mut current)
                                (mut retired)))
          (or (= head "") (= head "module")) 0
          (starts-with head "retire-")
            (let [(mut parts) (StrBuf::new a)]
              (for [i 1 (sx-len items)]
                (when (> i 1) (push! (mut parts) (: 32 u8)) 0)
                (push-str! (mut parts) (sexp-display a (sx-at items i))))
              (push! (mut retired)
                     (if (or (= head "retire-impl") (= head "retire-inherent"))
                         (ls-qualified-key a module (str (load parts)))
                         (text/format a
                                      "{} {}.{}"
                                      module
                                      module
                                      (str (load parts)))))
              0)
          :else
            (let [name
                    (if (and (> (sx-len items) 1)
                             (= (sx-tag (sx-at items 1)) 2)
                             (not (or (= head "impl")
                                      (= head "derive")
                                      (= head "import")
                                      (= head "export"))))
                        (sx-sval (sx-at items 1))
                        "")
                  authored (ls-authored-span? (mut s) f name)]
              (push! (mut current)
                     (RetainedForm
                       :module module
                       :head head
                       :name name
                       :key (if (> (len name) 0) "" (ls-form-key a head f))
                       :source (if authored (.source f) -1)
                       :lo (if authored (.lo f) -1)
                       :hi (if authored (.hi f) -1)
                       :text (if authored "" (sexp-display a (load f)))))
              0)))
  0)

;;; What identifies a form that defines no name: an impl's header (its items up
;;; to the first method), the whole form otherwise.
(defn ls-form-key [(a (dyn Allocator)) (head (slice u8)) (f (ptr Sexp))]
  (-> (slice u8))
  (if (= head "impl")
      (let [items (sx-items (load f))
            (mut parts) (StrBuf::new a)]
        (block :header
          (for [i 1 (sx-len items)]
            (let [x (sx-at items i)]
              (when (and (= (sx-tag x) 6)
                         (and (> (sx-len (sx-items x)) 1)
                              (= (sx-tag (sx-at (sx-items x) 1)) 7)))
                (break :header 0))
              (when (> i 1) (push! (mut parts) (: 32 u8)) 0)
              (push-str! (mut parts) (sexp-display a x))))
          0)
        (str (load parts)))
      (sexp-display a (load f))))

;;; Is the text at F's span F itself? Expansion stamps the call's span on what it
;;; produces, so it is only when the text reads back as one form defining NAME,
;;; or, for a form defining no name, one with the same head.
(defn ls-authored-span? [(s (mut LS)) (f (ptr Sexp)) (name (slice u8))]
  (-> bool)
  (let [source (.source f)]
    (if (or (< (.lo f) 0) (< source 0) (>= source (len (.sources s))))
        false
        (let [text (.text (elem (field s sources) source))]
          (if (> (.hi f) (len text))
              false
              (try (let [forms
                           (try-or! (read-source-forms (.a s)
                                                       (subslice text
                                                                 (.lo f)
                                                                 (.hi f))
                                                       -1)
                                    false)]
                     (and (= (len (load forms)) 1)
                          (ls-same-definition? (elem forms 0) f name)))))))))

;;; Does G, read back from F's span, define what F does? A form defining a name is
;;; matched by the name (an expanded `defn*` is the `defn` written there); one
;;; defining none by its head.
(defn ls-same-definition? [(g (ptr Sexp)) (f (ptr Sexp)) (name (slice u8))]
  (-> bool)
  (let [items (sx-items (load g))]
    (if (= (len name) 0)
        (= (match (l-list-head g) (Some [h] h) (None [] ""))
           (match (l-list-head f) (Some [h] h) (None [] "")))
        (and (> (sx-len items) 1)
             (and (= (sx-tag (sx-at items 1)) 2)
                  (= (sx-sval (sx-at items 1)) name))))))

;;; Mask a name removed from this candidate while leaving the accepted base intact.
(defn ls-hide-function! [(s (mut LS)) (name (slice u8))] (-> i64)
  (set! (mut (.checked_functions s)) name -1)
  0)

; Register a source (name+text) into the SourceMap, in id order (sources[id]).
(defn register-source-at! [(s (mut LS))
                           (id i64)
                           (name (slice u8))
                           (text (slice u8))] (-> i64)
  (tr/profile-event "source.register" name (len text))
  (let [(mut sp) (zeroed Source)
        a (.a s)
        (mut starts) (ArrayList::new [i64] a)
        n (len text)]
    (push! (mut starts) 0)
    (for [i 0 n]
      (when (= (primitive/cast i64 (get text i))
               10)
        (push! (mut starts) (primitive/iadd i 1))
        0))
    (set! (.name sp) name)
    (set! (.text sp) text)
    (set! (.line_starts sp) (box-al a (load starts)))
    (if (< id (len (.sources s)))
        (set! (elem (field s sources) id) sp)
        (do
          (unless (= id (len (.sources s))) (abort) 0)
          (push! (mut (.sources s)) sp)
          0)))
  0)

(defn register-source! [(s (mut LS)) (name (slice u8)) (text (slice u8))]
  (-> i64)
  (register-source-at! (mut s) (len (.sources s)) name text))

;;; Reuse a source slot whose last live syntax reference has retired.
(defn register-live-source! [(s (mut LS)) (name (slice u8)) (text (slice u8))]
  (-> i64)
  (let [(mut id) (len (.sources s))]
    (block :slot
      (for [i 0 (len (.sources s))]
        (when (= (len (.name (elem (field s sources) i))) 0)
          (set! id i)
          (return-from :slot 0)))
      0)
    (register-source-at! (mut s) (load id) name text)
    (set! (.srccount s) (len (.sources s)))
    (load id)))

;;; Record a declaration form for the checker-facing source view, ONCE.
;;;
;;; The same declaration reaches here more than once in a normal run -- the initial
;;; load processes it, and `rebuild-transformed-declarations!` re-processes it after
;;; transforms -- and an accumulating list is how one wildcard import turned into two
;;; identical warnings. A form is identified by its span: same source, same start
;;; offset, same form.
(defn decl-form-recorded? [(fs (ArrayList Sexp)) (f Sexp) (i i64) (n i64)]
  (-> bool)
  (if (>= i n)
      false
      (let [g (get fs i)]
        (if (and (= (sx-source g) (sx-source f))
                 (and (= (sx-lo g) (sx-lo f)) (= (sx-hi g) (sx-hi f))))
            true
            (decl-form-recorded? fs f (primitive/iadd i 1) n)))))

(defn record-decl-form! [(fs (mut (ArrayList Sexp))) (f Sexp)] (-> i64)
  (unless (decl-form-recorded? (load fs) f 0 (len (load fs)))
    (push! (mut fs) f)
    0)
  0)

(defn source-is-cli-use? [(s (mut LS)) (source i64)] (-> bool)
  (if (or (< source 0)
          (>= source (len (.sources s))))
      false
      (let [(mut sp) (: (get (.sources s) source) Source)]
        (= (.name sp) "<cli-use>"))))

; Register an expansion; return its ctxt id (1-based; 0 = root).
(defn add-expansion! [(s (mut LS)) (e Expansion)] (-> i64)
  ; Macro lookup may return a name backed by the per-invocation scratch arena.
  ; Expansion provenance outlives that invocation, so retain the spelling in
  ; the loader arena before recording it. Otherwise later diagnostics print
  ; recycled scratch bytes and the snapshot varies from run to run.
  (let [(mut owned) (: e Expansion)]
    (set! (.macro_name owned) (text/format (.a s) "{}" (.macro_name owned)))
    ; Reuse a slot the provenance prune freed. Scanning every slot on every
    ; expansion was quadratic in the program's expansions; the hint keeps the scan
    ; to slots that can actually be free.
    (block :slot
      (for [i (.expansion_free_from s) (len (.expansions s))]
        (when (= (len (.macro_name (elem (field s expansions) i))) 0)
          (set! (elem (field s expansions) i) owned)
          (set! (.expansion_free_from s) (+ i 1))
          (return-from :slot (+ i 1))))
      (push! (mut (.expansions s)) owned)
      (set! (.expansion_free_from s) (len (.expansions s)))
      (len (.expansions s)))))

; ============================ loader helpers (copied) ======================
(defn next-form-id [] (-> i64)
  (let [cell (field (loader-unit-state) form_id)
        id (primitive/iadd (load cell) 1)]
    (set! cell id)
    id))

(defn mk-tagged [(form Sexp) (module (Option (slice u8)))] (-> TaggedForm)
  (let [p (primitive/alloc-stack TaggedForm)]
    (set! (.form p) form)
    (set! (.module p) module)
    (set! (.form_id p) (next-form-id))
    (set! (.revision p) 0)
    (set! (.cached_shape p) 0)
    (load p)))

; The only operation that changes syntax inside an existing form revision.
; Keeping revision and shape invalidation inseparable makes the semantic cache
; safe by construction; source guards reject open-coded form mutation.
(defn tagged-rewrite! [(p (ptr TaggedForm)) (form Sexp)] (-> i64)
  (set! (.form p) form)
  (set! (.revision p) (primitive/iadd (.revision p) 1))
  (set! (.cached_shape p) 0)
  0)

;;; Read TEXT into forms allocated from A. The reader's token list and frame stack
;;; live only for the read, so they get an arena of their own: from A they stayed
;;; until the compilation ended, roughly another node's worth of memory for every
;;; token of every module a program loads.
(defn read-source-forms [(a (dyn Allocator)) (text (slice u8)) (source i64)]
  (-> (Result (ptr (ArrayList Sexp)) Diag))
  (let [work (primitive/alloc-stack scratch/ScratchArena)
        _init
          (scratch/ScratchArena::init-with-capacity work
                                                    (retained-heap/compiler-scratch-parent)
                                                    65536)
        result
          (read-all-scratch a
                            (allocator work)
                            text
                            source
                            (default-reader-config))]
    (close! work)
    result))

(defn loader-abort [(msg (slice u8))] (-> i64)
  (let [w (stderr)] (ps w "loader error: ") (ps w msg) (wb w 10))
  (abort)
  0)

; A framed loader diagnostic anchored at `f`'s span.
(defn diag-at-form [(f (ptr Sexp)) (msg (slice u8))] (-> Diag)
  (let [(mut d) (zeroed Diag)]
    (set! (.lo d) (.lo f))
    (set! (.hi d) (.hi f))
    (set! (.msg d) msg)
    (set! (.source d) (.source f))
    (set! (.ctxt d) (.ctxt f))
    d))

; Record the loader's first error and mark the run failed (idempotent: keep the first).
(defn ls-set-err! [(s (mut LS)) (d Diag)] (-> i64)
  (unless (.loaderr_set s)
    (set! (.loaderr s) d)
    (set! (.loaderr_set s) true)
    0))

(defn ls-err? [(s (mut LS))] (-> bool)
  (.loaderr_set s))

(defn cwd-slice [(a (dyn Allocator))] (-> (slice u8))
  (let [buf
          (primitive/cast (ptr i8)
                          (data (match (alloc-bytes a 4096 1)
                                  (Some [s] s)
                                  (None []
                                        (do
                                          (oom-at c"compiler allocation"
                                                  4096)
                                          (slice::new (primitive/cast (ptr u8)
                                                                      0)
                                                      0))))))
        r (getcwd buf 4096)]
    (if (= (primitive/cast i64 r) 0)
        (do (loader-abort "getcwd failed") "")
        (from-cstr buf))))

(defn path-join [(a (dyn Allocator)) (base (slice u8)) (path (slice u8))]
  (-> (slice u8))
  (if (and (> (len path) 0)
           (= (primitive/cast i64 (get path 0)) 47))
      path
      (let [m1 (match (concat a base "/") (Some [v] v) (None [] ""))]
        (match (concat a m1 path) (Some [v] v) (None [] "")))))

(defn dirname [(p (slice u8))] (-> (slice u8))
  (let [n (len p)
        (mut idx) -1]
    (for [i 0 n]
      (when (= (primitive/cast i64 (get p i))
               47)
        (set! idx i)))
    (if (< (load idx) 0) "." (subslice p 0 (load idx)))))

(defn basename [(p (slice u8))] (-> (slice u8))
  (let [n (len p)
        (mut idx) -1]
    (for [i 0 n]
      (when (= (primitive/cast i64 (get p i))
               47)
        (set! idx i)))
    (if (< (load idx) 0)
        p
        (subslice p (primitive/iadd (load idx) 1) n))))

; The generated manifest IS the single source of truth for which modules are the
; standard library's — the old hand-maintained duplicate list is gone, and the
; snapshot corpus derives its lib set from `src/stdlib/**/*.coil` directly.
(defn bundled? [(name (slice u8))] (-> bool)
  (or (stdlib-manifest-file? name) (sdk-manifest-file? name)))

; The import base for bundled stdlib files and the prelude. It marks compiler-owned
; embedded text, keeping the bundle self-contained and enabling narrowly scoped
; bootstrap compatibility for older embedded filename imports.
(defn bundled-base [] (-> (slice u8))
  "<bundled>")

; Project mode freezes these in the environment before any source is loaded.
; Direct-file mode leaves them unset and retains the bundled toolchain universe.
(defn bundled-stdlib-enabled? [(a (dyn Allocator))] (-> bool)
  (let [p (unit-getenv (to-cstr a "COIL_STDLIB"))]
    (or (= (primitive/cast i64 p) 0)
        (not (= (from-cstr p) "0")))))

(defn stdlib-profile [(a (dyn Allocator))] (-> (slice u8))
  (let [p (unit-getenv (to-cstr a "COIL_STDLIB_PROFILE"))]
    (if (= (primitive/cast i64 p) 0)
        (if (bundled-stdlib-enabled? a) "full" "none")
        (from-cstr p))))

(defstruct PreludeNameBox [(known bool) (name (slice u8))])

(defn prelude-name-box [] (-> (ptr PreludeNameBox))
  (field (loader-unit-state) prelude))

(defn reset-implicit-prelude-cache! [] (-> i64)
  (set! (.known (prelude-name-box)) false)
  (unit-prelude-reset!)
  0)

(defn implicit-prelude-name [(a (dyn Allocator))] (-> (slice u8))
  ; Project configuration is frozen before loading starts. Recursive namespace,
  ; expansion and resolution walks ask for the same prelude thousands of times;
  ; getenv's locked linear environment search does not belong in those walks.
  (let [b (prelude-name-box)]
    (unless (.known b)
      (let [p (unit-getenv (to-cstr a "COIL_PRELUDE"))]
        (set! (.name b)
              (if (or (= (primitive/cast i64 p) 0)
                      (= (len (from-cstr p)) 0))
                  "coil.core"
                  (from-cstr p)))
        (set! (.known b) true))
      0)
    (.name b)))

(defn path-readable? [(a (dyn Allocator)) (p (slice u8))] (-> bool)
  (let [fd (open (to-cstr a p) 0)]
    (if (< (primitive/cast i64 fd) 0)
        false
        (do (close fd) true))))

; ── finding the standard library ─────────────────────────────────────────────
; The compiler and the standard library are ONE toolchain with ONE version. The
; library is a directory of files, installed together with the binary and never
; separately, and found the way python finds its prefix and rustc finds its sysroot:
; walk up from the location of the compiler that is running, looking for a landmark.
; Two layouts count as a hit.
;
;   INSTALLED  <prefix>/bin/coil      ->  <prefix>/lib/coil/stdlib/**/*.coil
;                                         <prefix>/lib/coil/prelude.coil
;   CHECKOUT   <root>/build/bin/coil  ->  <root>/src/stdlib/**/*.coil
;                                         <root>/src/compiler/prelude.coil
;
; A compiler built inside a checkout finds that checkout — which is what keeps two
; checkouts, or two worktrees, on their own library instead of shadowing each other —
; and `dev.py install` copies binary and library into a prefix as one act.
;
; What this replaced: the library used to be `include-str`'d into the binary, so an
; installed compiler served whatever the library was on the day it was built. That is
; a compiler and a library at two different versions, and the only way to see the
; difference was to notice that an edit had no effect. The workaround was
; COIL_STDLIB_DIR, an override that had to be remembered on every invocation and
; failed silently when it wasn't. Both are gone: there is one library on disk, the
; command you ran decides which.
;
; A compiler that finds no library cannot compile: it says so and exits, naming both
; places it looked (`stdlib-not-found`), the way rustc does when its sysroot is
; missing. The search falls back to the working directory because the bootstrap builds
; stage compilers into /tmp and runs them from the checkout, which is a toolchain root
; even though the binary is not inside it.
;;; `resolved` is `path` made absolute when it was published: a relative argv[0]
;;; names the binary only from the directory the command started in, and the
;;; compiler moves into temporary directories to spawn itself (the lint profile, a
;;; compile-time unit), where re-resolving it found nothing to run.
(defstruct SelfCommandBox [(known i64) (path (slice u8)) (resolved (slice u8))])

(defn self-command-box [] (-> (ptr SelfCommandBox))
  (primitive/alloc-static SelfCommandBox))

;;; Publish argv[0] — the command the user actually ran. `driver-main` calls this
;;; before anything can load a library; until it does, only the working-directory
;;; anchor of the search below is available.
(defn set-self-command! [(p (slice u8))] (-> i64)
  (let [b (self-command-box)]
    (set! (.known b) 1)
    (set! (.path b) p)
    (set! (.resolved b) (resolve-command-path (malloc-allocator) p)))
  0)

(defn self-command [] (-> (slice u8))
  (let [b (self-command-box)]
    (if (= (.known b) 0) "" (.path b))))

;;; Scan PATH for `name`, the way the shell just did. "" when no entry holds it.
(defn path-in-search-path [(a (dyn Allocator)) (name (slice u8))]
  (-> (slice u8))
  (let [p (unit-getenv (to-cstr a "PATH"))]
    (if (= (primitive/cast i64 p) 0)
        ""

        (let [path (from-cstr p)
              n (len path)
              (mut start) 0
              (mut i) 0
              (mut found) ""]
          (loop (let [at-end (>= (load i) n)
                      sep
                        (if at-end
                            true
                            (= (primitive/cast i64 (get path (load i)))
                               58))]
                  (if sep
                      ; An empty PATH entry means the working directory, as in the shell.
                      (let [entry (subslice path (load start) (load i))
                            dir
                              (if (= (len entry) 0)
                                  "."
                                  entry)
                            cand (path-join a dir name)]
                        (if (path-readable? a cand)
                            (do (set! found cand) (break))
                            (if at-end
                                (break)
                                (do
                                  (set! start (primitive/iadd (load i) 1))
                                  (set! i (primitive/iadd (load i) 1))
                                  0))))
                      (do (set! i (primitive/iadd (load i) 1)) 0))))
          (load found)))))

(defn realpath-opt [(a (dyn Allocator)) (path (slice u8))]
  (-> (Option (slice u8)))
  (let [buf
          (primitive/cast (ptr i8)
                          (data (match (alloc-bytes a 4096 1)
                                  (Some [s] s)
                                  (None []
                                        (do
                                          (oom-at c"compiler allocation"
                                                  4096)
                                          (slice::new (primitive/cast (ptr u8)
                                                                      0)
                                                      0))))))
        r (realpath-rooted (to-cstr a path) buf)]
    (if (= (primitive/cast i64 r) 0)
        (None [(slice u8)])
        (Some (from-cstr buf)))))

;;; A command name as the filesystem path of the thing it runs.
;;;
;;; A shell may keep the bare command name in argv[0] after finding the executable
;;; through PATH, so a compiler that wants to locate anything relative to ITSELF —
;;; its standard library, the native archives beside it — has to redo that lookup.
;;; realpath first (which covers absolute and cwd-relative names, and follows a
;;; symlinked `coil` to the toolchain it really belongs to), then PATH. Unresolvable
;;; names come back unchanged, so a caller never has to special-case failure.
;;;
;;; `driver.coil`'s resource paths resolve through this same function: two subtly
;;; different answers to "where am I" is how a compiler ends up finding its archives
;;; and its library in different places.
(defn resolve-command-path [(a (dyn Allocator)) (name (slice u8))]
  (-> (slice u8))
  (if (= (len name) 0)
      name
      (match (realpath-opt a name)
        (Some [p] p)
        (None []
              (match (find name "/")
                (Some [i0] name)
                (None []
                      (let [found (path-in-search-path a name)]
                        (if (= (len found) 0)
                            name
                            (match (realpath-opt a found)
                              (Some [p] p)
                              (None [] found))))))))))

(defn self-command-path [(a (dyn Allocator))] (-> (slice u8))
  (let [b (self-command-box)]
    (if (= (.known b) 0) "" (.resolved b))))

; Where the library was found. STDLIB-MISSING means nowhere, which is fatal at the
; first module load — there is nothing else to serve.
(const STDLIB-MISSING 0)

(const STDLIB-INSTALLED 1)

(const STDLIB-CHECKOUT 2)

; `libs` is the ordinary library, `sdk` the opt-in compiler sources, and
; `prelude` the full path of prelude.coil.
(defstruct StdlibLayout
  [(resolved i64)
   (kind i64)
   (libs (slice u8))
   (sdk (slice u8))
   (prelude (slice u8))])

;;; Does `dir` hold either layout? Directories are the landmarks, not any particular
;;; file: a library that gains or loses a module must not change how it is found.
(defn installed-layout-belongs-to-command? [(a (dyn Allocator))
                                            (dir (slice u8))] (-> bool)
  ; An installed library belongs only to a compiler in its sibling `bin` directory.
  ; Without this ownership check, a loose `/tmp/coil-candidate` silently adopts any
  ; stale `/tmp/lib/coil` left by a different checkout or bootstrap run.
  (= (dirname (self-command-path a)) (path-join a dir "bin")))

(defn stdlib-layout-at! [(a (dyn Allocator))
                         (dir (slice u8))
                         (out (ptr StdlibLayout))] (-> bool)
  (let [installed (path-join a dir "lib/coil/stdlib")
        installed-sdk (path-join a dir "lib/coil/compiler")]
    (if (and (path-readable? a installed)
             (installed-layout-belongs-to-command? a dir))
        (do
          (set! (.kind out) STDLIB-INSTALLED)
          (set! (.libs out) installed)
          ; Bootstrap stage binaries live in /tmp beside the installed stdlib
          ; compatibility fixture, while building compiler sources from a checkout.
          ; Prefer a shipped SDK, then the current checkout's SDK if present.
          (set! (.sdk out)
                (if (path-readable? a installed-sdk)
                    installed-sdk
                    (path-join a (cwd-slice a) "src/compiler")))
          (set! (.prelude out) (path-join a dir "lib/coil/prelude.coil"))
          true)
        ; Both halves of a checkout are required. `src/stdlib` alone could be any
        ; project that happens to use that name; only this one also has src/compiler.
        (let [libs (path-join a dir "src/stdlib")]
          (if (and (path-readable? a libs)
                   (path-readable? a (path-join a dir "src/compiler")))
              (do
                (set! (.kind out) STDLIB-CHECKOUT)
                (set! (.libs out) libs)
                (set! (.sdk out) (path-join a dir "src/compiler"))
                (set! (.prelude out)
                      (path-join a dir "src/compiler/prelude.coil"))
                true)
              false)))))

;;; Walk `start` and its ancestors, stopping at the first directory holding a layout.
(defn stdlib-layout-upward! [(a (dyn Allocator))
                             (start (slice u8))
                             (out (ptr StdlibLayout))] (-> bool)
  (if (= (len start) 0)
      false
      (let [(mut dir) start
            (mut hit) false]
        (loop (if (stdlib-layout-at! a (load dir) out)
                  (do (set! hit true) (break))
                  ; dirname bottoms out at "" (from "/x") or "." (from a bare name);
                  ; either way the parent stops changing, which ends the walk.
                  (let [up (dirname (load dir))]
                    (if (or (= up (load dir))
                            (<= (len (load dir)) 1))
                        (break)
                        (do (set! dir up) 0)))))
        (load hit))))

(defn find-stdlib-layout! [(a (dyn Allocator)) (out (ptr StdlibLayout))]
  (-> i64)
  (set! (.kind out) STDLIB-MISSING)
  (init-fields! out "" [libs sdk prelude])
  ; The compiler's own location first — that is the toolchain it belongs to. The
  ; working directory second, which is how a stage compiler in /tmp finds the checkout
  ; it is building.
  (unless (stdlib-layout-upward! a (dirname (self-command-path a)) out)
    (stdlib-layout-upward! a (cwd-slice a) out)
    0)
  0)

; Resolved once per process: every library file consults it, and the walk costs a
; handful of directory probes that would otherwise be repeated seventy times.
(defn stdlib-layout-box [] (-> (ptr StdlibLayout))
  (field (loader-unit-state) layout))

;;; The library's layout, found on first use. It is unit state, so its paths are
;;; allocated by the unit: a caller's allocator may be a scratch arena that is gone
;;; before the next caller reads them.
(defn stdlib-layout [(a (dyn Allocator))] (-> (ptr StdlibLayout))
  (let [b (stdlib-layout-box)]
    (when (= (.resolved b) 0)
      (find-stdlib-layout! (unit-allocator) b)
      (set! (.resolved b) 1)
      0)
    b))

;;; No library, no compiler. Report both places that were searched and how to install,
;;; rather than failing later as a pile of unresolved `coil.*` imports.
(defn stdlib-not-found [(a (dyn Allocator)) (want (slice u8))] (-> i64)
  (let [w (stderr)]
    (ps w "error: cannot find the coil standard library (looking for '")
    (ps w want)
    (ps w "')\n")
    (ps w "  searched upward from the compiler at: ")
    (ps w (self-command-path a))
    (wb w 10)
    (ps w "  and upward from the working directory: ")
    (ps w (cwd-slice a))
    (wb w 10)
    (ps w
        "note: a coil installation is <prefix>/bin/coil next to <prefix>/lib/coil/stdlib,\n")
    (ps w
        "      and a checkout is a directory holding src/stdlib and src/compiler.\n")
    (ps w "      The library ships WITH the compiler: install both with\n")
    (ps w "          python3 scripts/dev.py install\n")
    (exit 1)
    0))

;;; Where one library module's file is in the layout that was found: `bn` is its
;;; manifest name, `compiler/…` for an SDK module and relative to the stdlib otherwise.
(defn bundled-path [(a (dyn Allocator)) (bn (slice u8))] (-> (slice u8))
  (let [l (stdlib-layout a)
        sdk? (starts-with bn "compiler/")]
    (path-join a
               (if sdk? (.sdk l) (.libs l))
               (if sdk? (subslice bn 9 (len bn)) bn))))

; Text of one library module, read from the layout that was found. A missing file is
; fatal for the same reason a missing layout is: the alternative is a compiler that
; half-has a standard library and reports the shortfall as the user's type error.
(defn bundled-text [(a (dyn Allocator)) (bn (slice u8))] (-> (slice u8))
  (let [l (stdlib-layout a)]
    (when (= (.kind l) STDLIB-MISSING) (stdlib-not-found a bn) 0)
    (let [p (bundled-path a bn)
          d (read-file a (to-cstr a p))]
      (when (= (len d) 0) (stdlib-not-found a p) 0)
      d)))

;;; The prelude is a library file too, in its own place in each layout.
(defn stdlib-prelude-text [(a (dyn Allocator))] (-> (slice u8))
  (let [l (stdlib-layout a)]
    (when (= (.kind l) STDLIB-MISSING)
      (stdlib-not-found a "prelude.coil")
      0)
    (let [p (.prelude l)
          d (read-file a (to-cstr a p))]
      (when (= (len d) 0) (stdlib-not-found a p) 0)
      d)))

; A `coil.*` namespace that resolves from the source tree instead of the bundle is
; a manifest bug: it works in this repo and fails for every compiler run outside
; it. That asymmetry is precisely what hid coil.socket/sync/region/signals/
; cancellation, so the build and the gates set COIL_STRICT_BUNDLE=1 to make the
; fallback a hard error instead of an invisible success.
(defn strict-bundle? [(a (dyn Allocator))] (-> bool)
  (let [p (unit-getenv (to-cstr a "COIL_STRICT_BUNDLE"))]
    (if (= (primitive/cast i64 p) 0)
        false
        (not (= (from-cstr p) "0")))))

; Namespace imports deliberately do not encode storage layout. Build a source index
; once per compiler run by scanning the project roots, reading only enough of each
; .coil file to obtain its declared `(module …)` identity. COIL_NAMESPACE_ROOTS is
; a colon-separated list installed by project mode; direct-file mode indexes the
; process working directory, which makes the entry file's location irrelevant.
(defn namespace-index-add! [(s (mut LS)) (name (slice u8)) (path (slice u8))]
  (-> i64)
  (let [names (field s namespace_names)
        paths (field s namespace_paths)
        n (len (load names))
        (mut seen) false]
    (for [i 0 n]
      (when (and (= (get (load names) i) name)
                 (= (get (load paths) i) path))
        (set! seen true)
        (break)))
    (unless (load seen)
      (push! (mut (.namespace_names s)) name)
      (push! (mut (.namespace_paths s)) path)
      0))
  0)

; Read only the lexical module header. Namespace discovery must not invoke read-all:
; doing so after the entry file is parsed mutates reader-global node identities and
; can corrupt later staged-macro bookkeeping. Comments and blank lines may precede
; the declaration; imported files already require it to be the first real form.
; Byte offset of the `(module …)` header's opening paren, or -1. Comments may
; precede it; nothing else may.
(defn module-header-offset [(text (slice u8))] (-> i64)
  (let [n (len text)
        (mut i) 0
        (mut comment) false
        (mut out) -1]
    (loop (if (>= (load i) n)
              (break)
              (let [c (primitive/cast i64 (get text (load i)))]
                (cond (= c 10)
                        (do
                          (set! comment false)
                          (set! i (primitive/iadd (load i) 1))
                          0)
                      (load comment) (set! i (primitive/iadd (load i) 1))
                      (= c 59)
                        (do
                          (set! comment true)
                          (set! i (primitive/iadd (load i) 1))
                          0)
                      (and (= c 40)
                           (starts-with (subslice text (load i) n) "(module "))
                        (do (set! out (load i)) (break))
                      :else (set! i (primitive/iadd (load i) 1))))))
    (load out)))

(defn namespace-declared-module [(text (slice u8))] (-> (Option (slice u8)))
  (let [n (len text)
        at (module-header-offset text)
        (mut out) (None [(slice u8)])]
    (when (>= at 0)
      (let [lo (primitive/iadd at 8)
            (mut hi) (primitive/iadd at 8)]
        (loop (if (>= (load hi) n)
                  (break)
                  (let [d
                          (primitive/cast i64
                                          (get text (load hi)))]
                    (if (or (= d 41)
                            (= d 32)
                            (= d
                               9)
                            (= d
                               10)
                            (= d
                               13))
                        (break)
                        (set! hi (primitive/iadd (load hi) 1))))))
        (when (> (load hi) lo)
          (set! out (Some (subslice text lo (load hi))))
          0)
        0)
      0)
    (load out)))

; A reader-independent namespace declaration for guest syntax. Only the first
; physical line is inspected; bytes before the uncommon sentinel are deliberately
; opaque so `;`, `#`, `//`, `--`, and language-specific comment leaders all work.
(defn namespace-header-module [(text (slice u8))] (-> (Option (slice u8)))
  (let [n (len text)
        (mut end) 0
        (mut at) -1
        needle "coil-module:"
        nn (len needle)]
    (loop (if (or (>= (load end) n)
                  (= (primitive/cast i64 (get text (load end))) 10))
              (break)
              (set! end (primitive/iadd (load end) 1))))
    (for [i 0 (load end)]
      (when (and (<= (primitive/iadd i nn) (load end))
                 (= (subslice text i (primitive/iadd i nn)) needle))
        (set! at (primitive/iadd i nn))
        0))
    (if (< (load at) 0)
        (None [(slice u8)])
        (let [(mut lo) (load at)
              (mut hi) (load end)]
          (loop (if (and (< (load lo) (load end))
                         (let [c (primitive/cast i64 (get text (load lo)))]
                           (or (= c 32) (= c 9))))
                    (set! lo (primitive/iadd (load lo) 1))
                    (break)))
          (loop (if (and (> (load hi) (load lo))
                         (let [c
                                 (primitive/cast i64
                                                 (get text
                                                      (primitive/isub (load hi)
                                                                      1)))]
                           (or (= c 32) (= c 9) (= c 13))))
                    (set! hi (primitive/isub (load hi) 1))
                    (break)))
          (if (> (load hi) (load lo))
              (Some (subslice text (load lo) (load hi)))
              (None [(slice u8)]))))))

(defn configured-reader-module [(a (dyn Allocator)) (path (slice u8))]
  (-> (slice u8))
  (let [p (unit-getenv (to-cstr a "COIL_READERS"))]
    (if (= (primitive/cast i64 p) 0)
        ""
        (let [cfg (from-cstr p)
              n (len cfg)
              (mut out) ""
              (mut best) 0
              (mut lo) 0]
          (for [i 0 (primitive/iadd n 1)]
            (when (or (= i n) (= (primitive/cast i64 (get cfg i)) 10))
              (let [line (subslice cfg (load lo) i)
                    (mut eq) -1]
                (for [j 0 (len line)]
                  (when (= (primitive/cast i64 (get line j)) 61)
                    (set! eq j)
                    0))
                (when (> (load eq) 0)
                  (let [ext (subslice line 0 (load eq))
                        pn (len path)
                        en (load eq)]
                    (when (and (> en (load best))
                               (and (>= pn en)
                                    (= (subslice path (primitive/isub pn en) pn)
                                       ext)))
                      (set! out
                            (subslice line
                                      (primitive/iadd (load eq) 1)
                                      (len line)))
                      (set! best en)
                      0)))
                (set! lo (primitive/iadd i 1)))
              0))
          (load out)))))

(defn configured-reader-extension [(a (dyn Allocator)) (path (slice u8))]
  (-> (slice u8))
  (let [p (unit-getenv (to-cstr a "COIL_READERS"))]
    (if (= (primitive/cast i64 p) 0)
        ""
        (let [cfg (from-cstr p)
              n (len cfg)
              (mut out) ""
              (mut best) 0
              (mut lo) 0]
          (for [i 0 (primitive/iadd n 1)]
            (when (or (= i n) (= (primitive/cast i64 (get cfg i)) 10))
              (let [line (subslice cfg (load lo) i)
                    (mut eq) -1]
                (for [j 0 (len line)]
                  (when (= (primitive/cast i64 (get line j)) 61)
                    (set! eq j)
                    0))
                (when (> (load eq) 0)
                  (let [ext (subslice line 0 (load eq))
                        pn (len path)
                        en (load eq)]
                    (when (and (> en (load best))
                               (and (>= pn en)
                                    (= (subslice path (primitive/isub pn en) pn)
                                       ext)))
                      (set! out ext)
                      (set! best en)
                      0)))
                (set! lo (primitive/iadd i 1)))
              0))
          (load out)))))

(defn configured-module-for-path [(a (dyn Allocator)) (path (slice u8))]
  (-> (Option (slice u8)))
  (let [p (unit-getenv (to-cstr a "COIL_MODULE_MAP"))]
    (if (= (primitive/cast i64 p) 0)
        (None [(slice u8)])
        (let [cfg (from-cstr p)
              n (len cfg)
              (mut out) (None [(slice u8)])
              (mut lo) 0
              buf
                (primitive/cast (ptr i8)
                                (data (match (alloc-bytes a 4096 1)
                                        (Some [x] x)
                                        (None []
                                              (do
                                                (oom-at c"compiler allocation"
                                                        4096)
                                                (slice::new (primitive/cast (ptr u8)
                                                                            0)
                                                            0))))))]
          (for [i 0 (primitive/iadd n 1)]
            (when (or (= i n) (= (primitive/cast i64 (get cfg i)) 10))
              (let [line (subslice cfg (load lo) i)
                    (mut eq) -1]
                (for [j 0 (len line)]
                  (when (= (primitive/cast i64 (get line j)) 61)
                    (set! eq j)
                    0))
                (when (> (load eq) 0)
                  (let [mapped
                          (subslice line
                                    (primitive/iadd (load eq) 1)
                                    (len line))
                        rr (realpath-rooted (to-cstr a mapped) buf)]
                    (when (and (!= (primitive/cast i64 rr) 0)
                               (= (from-cstr buf) path))
                      (set! out (Some (subslice line 0 (load eq))))
                      0)))
                (set! lo (primitive/iadd i 1)))
              0))
          (load out)))))

(defn ensure-guest-module [(a (dyn Allocator))
                           (forms (ptr (ArrayList Sexp)))
                           (name (slice u8))] (-> (ptr (ArrayList Sexp)))
  (match (declared-module forms)
    (Some [_] forms)
    (None []
          (let [(mut head) (ArrayList::new [Sexp] a)
                (mut out) (ArrayList::new [Sexp] a)]
            (push! [Sexp] (mut head) (mk-sexp (KSym "module") -1 -1))
            (push! [Sexp] (mut head) (mk-sexp (KSym name) -1 -1))
            (push! [Sexp]
                   (mut out)
                   (mk-sexp (KList (box-al a (load head))) -1 -1))
            (for [i 0 (len (load forms))]
              (push! [Sexp] (mut out) (get (load forms) i))
              0)
            (box-al a (load out))))))

; Conventional fallback for guest files with no header and no explicit mapping:
; package prefix + source-root-relative path, with the suffix removed.
(defn namespace-path-module [(a (dyn Allocator)) (path (slice u8))]
  (-> (Option (slice u8)))
  (let [pp (unit-getenv (to-cstr a "COIL_PACKAGE_NAME"))
        rp (unit-getenv (to-cstr a "COIL_NAMESPACE_ROOTS"))]
    (if (or (= (primitive/cast i64 pp) 0) (= (primitive/cast i64 rp) 0))
        (None [(slice u8)])
        (let [pkg (from-cstr pp)
              roots (from-cstr rp)
              n (len roots)
              (mut answer) (None [(slice u8)])
              (mut lo) 0]
          (for [i 0 (primitive/iadd n 1)]
            (when (or (= i n) (= (primitive/cast i64 (get roots i)) 58))
              (let [root0 (subslice roots (load lo) i)
                    buf
                      (primitive/cast (ptr i8)
                                      (data (match (alloc-bytes a 4096 1)
                                              (Some [x] x)
                                              (None []
                                                    (do
                                                      (oom-at c"compiler allocation"
                                                              4096)
                                                      (slice::new (primitive/cast (ptr u8)
                                                                                  0)
                                                                  0))))))
                    rr (realpath-rooted (to-cstr a root0) buf)
                    root
                      (if (= (primitive/cast i64 rr) 0) root0 (from-cstr buf))
                    rn (len root)]
                (when (and (> rn 0)
                           (and (starts-with path root)
                                (> (len path) (primitive/iadd rn 1))))
                  (let [rel (subslice path (primitive/iadd rn 1) (len path))
                        stop
                          (primitive/isub (len rel)
                                          (len (configured-reader-extension a
                                                                            path)))
                        (mut b) (StrBuf::new a)]
                    (push-str! (mut b) pkg)
                    (push! (mut b) (: 46 u8))
                    (for [j 0 stop]
                      (let [c (primitive/cast i64 (get rel j))]
                        (push! (mut b)
                               (primitive/cast u8 (if (= c 47) 46 c))))
                      0)
                    (set! answer (Some (str (load b))))))
                (set! lo (primitive/iadd i 1)))
              0))
          (load answer)))))

; ============================ workspace packages ============================
; `COIL_WORKSPACE_PACKAGES` is the driver's description of the workspace: one line
; per member, `<prefix>[!casefold]=<absolute dir>`. Everything the loader needs to
; know about package boundaries comes from here, which is why no namespace spelling
; is compiled into this file any more.
(defstruct WsPkgBox [(loaded i64) (text (slice u8))])

(defn ws-pkg-box [] (-> (ptr WsPkgBox))
  (field (loader-unit-state) workspace))

(defn ws-packages [] (-> (slice u8))
  (let [b (ws-pkg-box)]
    (when (= (.loaded b) 0)
      (let [a (unit-allocator)
            p (unit-getenv (to-cstr a "COIL_WORKSPACE_PACKAGES"))]
        (set! (.text b)
              (if (= (primitive/cast i64 p) 0)
                  ""
                  (from-cstr p)))
        (set! (.loaded b) 1)
        0))
    (.text b)))

; The prefix half of a line, i.e. up to `=`, with any `!casefold` marker dropped.
(defn ws-line-prefix [(line (slice u8))] (-> (slice u8))
  (let [n (len line)
        (mut stop) n
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (let [c (primitive/cast i64 (get line (load i)))]
                (if (or (= c 61) (= c 33))
                    (do (set! stop (load i)) (break))
                    (set! i (primitive/iadd (load i) 1))))))
    (subslice line 0 (load stop))))

(defn ws-line-dir [(line (slice u8))] (-> (slice u8))
  (let [n (len line)
        (mut at) -1]
    (for [i 0 n]
      (when (= (primitive/cast i64 (get line i))
               61)
        (set! at i)
        (break)))
    (if (< (load at) 0) "" (subslice line (primitive/iadd (load at) 1) n))))

; The trigger module between `!` and `=`, empty when the package declares none.
(defn ws-line-casefold-ns [(line (slice u8))] (-> (slice u8))
  (let [n (len line)
        (mut bang) -1
        (mut eq) n
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (let [c (primitive/cast i64 (get line (load i)))]
                (when (and (= c 33) (< (load bang) 0)) (set! bang (load i)) 0)
                (when (= c 61) (set! eq (load i)) (break))
                (set! i (primitive/iadd (load i) 1)))))
    (if (< (load bang) 0)
        ""
        (subslice line (primitive/iadd (load bang) 1) (load eq)))))

(defn ws-line-casefold? [(line (slice u8))] (-> bool)
  (let [n (len line)
        (mut found) false]
    (for [i 0 n]
      (when (= (primitive/cast i64 (get line i))
               33)
        (set! found true)
        (break)))
    (load found)))

; True when `name` sits strictly below `prefix`: the prefix, then a dot, then at
; least one more character. Compared segment-wise, so `experiments.schemer` is NOT
; below `experiments.scheme` -- a plain starts-with would say it is.
(defn ws-below? [(name (slice u8)) (prefix (slice u8))] (-> bool)
  (let [pn (len prefix)
        nn (len name)]
    (and (> nn (primitive/iadd pn 1))
         (and (starts-with name prefix)
              (= (primitive/cast i64 (get name pn)) 46)))))

; The member owning a path, as its line. A member directory is an absolute realpath
; and a file under it starts with `<dir>/`.
(defn ws-line-for-path [(a (dyn Allocator)) (path (slice u8))] (-> (slice u8))
  (let [text (ws-packages)
        n (len text)
        (mut out) ""
        (mut lo) 0
        (mut i) 0]
    (loop (if (> (load i) n)
              (break)
              (if (or (= (load i) n)
                      (= (primitive/cast i64 (get text (load i)))
                         10))
                  (do
                    (when (> (load i) (load lo))
                      (let [line (subslice text (load lo) (load i))
                            dir (ws-line-dir line)]
                        (when (and (> (len dir) 0)
                                   (starts-with path (text/format a "{}/" dir)))
                          (set! out line)
                          0)))
                    (set! lo (primitive/iadd (load i) 1))
                    (set! i (primitive/iadd (load i) 1))
                    0)
                  (set! i (primitive/iadd (load i) 1)))))
    (load out)))

; Does an imported namespace belong to a member that case-folds its importers?
(defn ws-casefold-import? [(ns (slice u8))] (-> bool)
  (let [text (ws-packages)
        n (len text)
        (mut yes) false
        (mut lo) 0
        (mut i) 0]
    (loop (if (> (load i) n)
              (break)
              (if (or (= (load i) n)
                      (= (primitive/cast i64 (get text (load i)))
                         10))
                  (do
                    (when (> (load i) (load lo))
                      (let [line (subslice text (load lo) (load i))]
                        ; Exactly the declared module. A file that imports a SIBLING of
                        ; that module -- which is what every implementation file in the
                        ; package does -- is ordinary Coil and must not be folded.
                        (when (= ns (ws-line-casefold-ns line))
                          (set! yes true)
                          0)))
                    (set! lo (primitive/iadd (load i) 1))
                    (set! i (primitive/iadd (load i) 1))
                    0)
                  (set! i (primitive/iadd (load i) 1)))))
    (load yes)))

; THE workspace rule: a module in a member package is that package's name plus at
; least one more segment. Checked here because this is the one place every file in
; the workspace is opened and its declaration read, so a stray module is reported
; once, by path, rather than as a resolution failure somewhere downstream.
(defn ws-check-module! [(s (mut LS)) (path (slice u8)) (name (slice u8))]
  (-> i64)
  (let [a (.a s)
        line (ws-line-for-path a path)]
    (when (> (len line) 0)
      (let [pre (ws-line-prefix line)]
        (unless (ws-below? name pre)
          (ls-set-err! (mut s)
                       (derr (text/format a
                                          "module '{}' in {} must be named '{}.<name>' — every module in a package begins with the package name and adds at least one segment"
                                          name
                                          path
                                          pre)))
          0)))
    0))

; `*` matches any run of bytes (directory separators included, as `find -path`
; does) and `?` one byte; everything else is literal.
(defn glob-match? [(pat (slice u8)) (s (slice u8))] (-> bool)
  (let [pn (len pat)
        sn (len s)
        (mut pi) 0
        (mut si) 0
        (mut star-p) -1
        (mut star-s) -1
        (mut fail) false]
    (loop (if (or (load fail) (>= (load si) sn))
              (break)
              (let [pc
                      (if (< (load pi) pn)
                          (primitive/cast i64 (get pat (load pi)))
                          -1)]
                (cond (= pc 42)
                        (do
                          (set! star-p (load pi))
                          (set! star-s (load si))
                          (set! pi (primitive/iadd (load pi) 1))
                          0)
                      (or (= pc 63)
                          (= pc (primitive/cast i64 (get s (load si)))))
                        (do
                          (set! pi (primitive/iadd (load pi) 1))
                          (set! si (primitive/iadd (load si) 1))
                          0)
                      (>= (load star-p) 0)
                        (do
                          (set! star-s (primitive/iadd (load star-s) 1))
                          (set! si (load star-s))
                          (set! pi (primitive/iadd (load star-p) 1))
                          0)
                      :else (do (set! fail true) 0)))))
    (loop (if (and (< (load pi) pn)
                   (= (primitive/cast i64 (get pat (load pi)))
                      42))
              (set! pi (primitive/iadd (load pi) 1))
              (break)))
    (and (not (load fail)) (= (load pi) pn))))

; One manifest `exclude` entry against one canonical source path. An entry is a
; file, a directory (which excludes everything below it), or a glob pattern.
(defn exclude-entry-matches? [(entry (slice u8)) (path (slice u8))] (-> bool)
  (let [en (len entry)
        (mut glob) false]
    (for [i 0 en]
      (let [c (primitive/cast i64 (get entry i))]
        (when (or (= c 42) (= c 63))
          (set! glob true)
          0))
      0)
    (if (load glob)
        (glob-match? entry path)
        (or (= entry path)
            (and (> (len path) en)
                 (and (= (subslice path 0 en) entry)
                      (= (primitive/cast i64 (get path en))
                         47)))))))

; Source paths excluded by the owning package manifest. These are files the
; package may still consume explicitly (for example through include-str), but they
; are not namespace-index members and therefore do not participate in workspace
; ownership or duplicate-module checks.
(defn namespace-index-excluded? [(a (dyn Allocator)) (path (slice u8))]
  (-> bool)
  (let [p (unit-getenv (to-cstr a "COIL_NAMESPACE_EXCLUDES"))]
    (if (= (primitive/cast i64 p) 0)
        false
        (let [cfg (from-cstr p)
              n (len cfg)
              (mut found) false
              (mut lo) 0]
          (for [i 0 (primitive/iadd n 1)]
            (when (or (= i n) (= (primitive/cast i64 (get cfg i)) 10))
              (when (and (> i (load lo))
                         (exclude-entry-matches? (subslice cfg (load lo) i)
                                                 path))
                (set! found true)
                0)
              (set! lo (primitive/iadd i 1)))
            0)
          (load found)))))

(defn namespace-index-file-with-scratch! [(s (mut LS))
                                          (path (slice u8))
                                          (work (ptr scratch/ScratchArena))]
  (-> i64)
  ; namespace-index-roots! canonicalizes each root once. The recursive walk
  ; ignores symlinks, so a regular file reached by joining names below that root
  ; is already canonical. Calling realpath here made macOS rediscover the cwd for
  ; every source file in the tree.
  (let [a (.a s)]
    (unless (namespace-index-excluded? a path)
      (let [canon (text/format a "{}" path)
            text
              (read-file (allocator work)
                         (to-cstr a path))]
        (push! (mut (.indexed_paths s)) canon)
        ; A module declaration may follow an arbitrarily long license/design
        ; comment. Reading only the first 4 KiB silently omitted valid modules.
        (match (match (configured-module-for-path a canon)
                 (Some [m] (Some m))
                 (None []
                       (if (> (len (configured-reader-module a canon)) 0)
                           ; Guest-language files are not modules merely because
                           ; their suffix has a reader. They enter the namespace
                           ; index only through an explicit `[modules]` mapping
                           ; or a `coil-module:` marker in their own syntax.
                           (namespace-header-module text)
                           (namespace-declared-module text))))
          (Some [m]
                (do
                  (ws-check-module! (mut s) canon (text/format a "{}" m))
                  (namespace-index-add! (mut s) (text/format a "{}" m) canon)))
          (None [] 0))
        ; The header result was copied into the namespace index. Source bytes
        ; from every unrelated file must not accumulate in the unit arena.
        (recycle! work))))
  0)

(defn namespace-index-file! [(s (mut LS)) (path (slice u8))] (-> i64)
  (let [work (primitive/alloc-stack scratch/ScratchArena)]
    (scratch/ScratchArena::init-with-capacity work
                                              (retained-heap/compiler-scratch-parent)
                                              65536)
    (namespace-index-file-with-scratch! (mut s) path work)
    (close! work))
  0)

(defn namespace-index-dir! [(s (mut LS))
                            (dir (slice u8))
                            (work (ptr scratch/ScratchArena))] (-> i64)
  (let [a (.a s)
        readers-p (unit-getenv c"COIL_READERS")
        has-readers
          (and (!= (primitive/cast i64 readers-p) 0)
               (> (len (from-cstr readers-p)) 0))
        path-work (primitive/alloc-stack scratch/ScratchArena)
        _path-init
          (scratch/ScratchArena::init path-work
                                      (retained-heap/compiler-scratch-parent))
        stream (opendir (to-cstr (allocator path-work) dir))]
    (unless (= (primitive/cast i64 stream) 0)
      (loop (let [entry (readdir stream)]
              (if (= (primitive/cast i64 entry) 0)
                  (break)
                  (let [namep (index entry DIRENT-NAME-OFFSET)
                        name (from-cstr namep)
                        n (len name)
                        kind
                          (primitive/cast i64
                                          (load (index entry DIRENT-TYPE-OFFSET)))]
                    ; Do not descend into hidden directories or follow symlinks.
                    ; Guest files are considered only when their suffix has a
                    ; manifest reader; without a header an explicit [modules]
                    ; entry (or the path fallback) supplies their identity.
                    (unless (or (= name ".") (= name ".."))
                      (if (= kind DT-DIR)
                          (unless (and (> n 0)
                                       (= (primitive/cast i64 (get name 0)) 46))
                            ; The child borrows this path only until its walk
                            ; returns. Each directory owns its own path arena.
                            (namespace-index-dir! (mut s)
                                                  (path-join (allocator path-work)
                                                             dir
                                                             name)
                                                  work)
                            (recycle! path-work)
                            0)
                          (when (and (= kind DT-REG)
                                     (or (and (>= n 5)
                                              (= (subslice name
                                                           (primitive/isub n 5)
                                                           n)
                                                 ".coil"))
                                         has-readers))
                            (let [path
                                    (path-join (allocator work)
                                               dir
                                               name)]
                              (when (or (and (>= n 5)
                                             (= (subslice name
                                                          (primitive/isub n 5)
                                                          n)
                                                ".coil"))
                                        (> (len (configured-reader-module a
                                                                          path))
                                           0))
                                (namespace-index-file-with-scratch! (mut s)
                                                                    path
                                                                    work)
                                0)
                              (recycle! work)
                              0))))))))
      (closedir stream)
      0)
    (close! path-work)
    0))

(defn namespace-index-roots! [(s (mut LS))
                              (roots (slice u8))] (-> i64)
  (let [(mut lo) 0
        (mut i) 0
        n (len roots)
        a (.a s)
        work (primitive/alloc-stack scratch/ScratchArena)
        (mut seen) (ArrayList::new [(slice u8)] a)]
    (scratch/ScratchArena::init-with-capacity work
                                              (retained-heap/compiler-scratch-parent)
                                              65536)
    (loop (if (> (load i) n)
              (break)
              (if (or (= (load i) n)
                      (= (primitive/cast i64 (get roots (load i))) 58))
                  (do
                    (when (> (load i) (load lo))
                      (let [spelled (subslice roots (load lo) (load i))
                            root
                              (match (realpath-opt a spelled)
                                (Some [canonical] canonical)
                                (None [] spelled))
                            (mut duplicate) false
                            (mut si) 0]
                        (loop (if (>= (load si) (len (load seen)))
                                  (break)
                                  (if (= (get (load seen) (load si)) root)
                                      (do (set! duplicate true) (break))
                                      (set! si (primitive/iadd (load si) 1)))))
                        (unless (load duplicate)
                          (push! (mut seen) (text/format a "{}" root))
                          (namespace-index-dir! (mut s) root work)
                          0))
                      0)
                    (set! lo (primitive/iadd (load i) 1))
                    (set! i (primitive/iadd (load i) 1))
                    0)
                  (set! i (primitive/iadd (load i) 1)))))
    (close! work)
    0))

(defn namespace-index-build! [(s (mut LS))] (-> i64)
  (let [a (.a s)
        roots-p (unit-getenv (to-cstr a "COIL_NAMESPACE_ROOTS"))
        unconfigured? (= (primitive/cast i64 roots-p) 0)
        ; Roots come from a project: its Coil.toml sets COIL_NAMESPACE_ROOTS. With
        ; none set, only a file named on the command line owns a tree, so a file
        ; launched from an unrelated directory still resolves its sibling modules.
        ; The working directory is never a root: the index walks every directory
        ; below a root and reads every `.coil` header, so defaulting to it made
        ; `coil repl` started in `~` read the whole home directory before printing
        ; its prompt. Sources with no file behind them (`<source>`, the REPL) own
        ; no tree. The standard library is found beside the compiler, not here.
        entry
          (if (> (len (.sources s)) 0)
              (.name (elem (field s sources) 0))
              "")
        roots
          (cond (not unconfigured?) (from-cstr roots-p)
                (or (= (len entry) 0) (= (primitive/cast i64 (get entry 0)) 60))
                  ""
                :else (dirname entry))
        path-buf
          (primitive/cast (ptr i8)
                          (data (match (alloc-bytes a 4096 1)
                                  (Some [buf] buf)
                                  (None []
                                        (do
                                          (oom-at c"compiler allocation"
                                                  4096)
                                          (slice::new (primitive/cast (ptr u8)
                                                                      0)
                                                      0))))))]
    (namespace-index-roots! (mut s) roots)
    (let [mp (unit-getenv (to-cstr a "COIL_MODULE_MAP"))]
      (unless (= (primitive/cast i64 mp) 0)
        (let [cfg (from-cstr mp)
              n (len cfg)
              (mut lo) 0]
          (for [i 0 (primitive/iadd n 1)]
            (when (or (= i n) (= (primitive/cast i64 (get cfg i)) 10))
              (let [line (subslice cfg (load lo) i)
                    (mut eq) -1]
                (for [j 0 (len line)]
                  (when (= (primitive/cast i64 (get line j)) 61)
                    (set! eq j)
                    0))
                (when (> (load eq) 0)
                  (let [name (subslice line 0 (load eq))
                        rel
                          (subslice line
                                    (primitive/iadd (load eq) 1)
                                    (len line))
                        rp (realpath-rooted (to-cstr a rel) path-buf)]
                    (if (= (primitive/cast i64 rp) 0)
                        (ls-set-err! (mut s)
                                     (derr (text/format a
                                                        "[modules] namespace '{}' points to a file that does not exist"
                                                        name)))
                        (namespace-index-add! (mut s)
                                              (text/format a "{}" name)
                                              (text/format a
                                                           "{}"
                                                           (from-cstr path-buf))))))
                (set! lo (primitive/iadd i 1)))
              0)))))
    (namespace-index-publish! (mut s))
    0))

;;; Copy the namespace index into the unit's allocator, where the import hint of
;;; an unknown name reads it after this LS is gone.
(defn namespace-index-publish! [(s (mut LS))] (-> i64)
  (let [ua (unit-allocator)
        state (loader-unit-state)
        (mut names) (ArrayList::new [(slice u8)] ua)
        (mut paths) (ArrayList::new [(slice u8)] ua)]
    (for [i 0 (len (.namespace_names s))]
      (push! (mut names) (text/format ua "{}" (get (.namespace_names s) i)))
      (push! (mut paths) (text/format ua "{}" (get (.namespace_paths s) i)))
      0)
    (set! (.index_names state) (box-al ua (load names)))
    (set! (.index_paths state) (box-al ua (load paths)))
    0))

; Every indexed file that declares `name`. One is the normal case; more than one
; is an error the caller reports at those files.
(defn namespace-paths-for [(a (dyn Allocator))
                           (s (mut LS))
                           (name (slice u8))] (-> (ptr (ArrayList (slice u8))))
  (let [names (field s namespace_names)
        paths (field s namespace_paths)
        n (len (load names))
        out (new-boxed-list [(slice u8)] a)]
    (for [i 0 n]
      (when (= (get (load names) i) name)
        (push! out (get (load paths) i))
        0))
    out))

; "namespace 'x' is declared by multiple source files: a.coil, b.coil …"
(defn duplicate-namespace-message [(a (dyn Allocator))
                                   (name (slice u8))
                                   (paths (ptr (ArrayList (slice u8))))]
  (-> (slice u8))
  (let [(mut b) (StrBuf::new a)
        n (len (load paths))]
    (push-str! (mut b) "namespace '")
    (push-str! (mut b) name)
    (push-str! (mut b)
               "' is declared by multiple source files (namespace identities must be unique): ")
    (for [i 0 n]
      (when (> i 0) (push-str! (mut b) ", ") 0)
      (push-str! (mut b) (get (load paths) i))
      0)
    (str (load b))))

(defn namespace-path [(a (dyn Allocator))
                      (s (mut LS))
                      (form (ptr Sexp))
                      (name (slice u8))] (-> (Option (slice u8)))
  (let [paths (namespace-paths-for a (mut s) name)
        count (len (load paths))]
    (if (> count 1)
        (do
          (ls-set-err! (mut s)
                       (diag-at-form form
                                     (duplicate-namespace-message a name paths)))
          (None [(slice u8)]))
        (if (= count 1)
            (Some (get (load paths) 0))
            (None [(slice u8)])))))

; Legacy dependency-path resolution is retained only for the syntax-preflight
; migration lint. Normal loading uses COIL_NAMESPACE_ROOTS and never calls this.
(defn dep-slash [(path (slice u8))] (-> i64)
  (let [n (len path)
        (mut i) 0
        (mut found) -1]
    (loop (if (>= (load i) n)
              (break)
              (if (= (primitive/cast i64 (get path (load i)))
                     47)
                  (do (set! found (load i)) (break))
                  (set! i (primitive/iadd (load i) 1)))))
    (load found)))

(defn dep-path-contained? [(root (slice u8)) (path (slice u8))] (-> bool)
  (let [rn (len root)
        pn (len path)
        (mut i) 0
        (mut same) (>= pn rn)]
    (loop (if (or (not (load same)) (>= (load i) rn))
              (break)
              (if (= (get root (load i)) (get path (load i)))
                  (set! i (primitive/iadd (load i) 1))
                  (set! same false))))
    (and (load same)
         (or (= pn rn)
             (and (> pn rn)
                  (or (and (= rn 1)
                           (= (primitive/cast i64 (get root 0))
                              47))
                      (= (primitive/cast i64 (get path rn))
                         47)))))))

(defn resolve-dependency [(a (dyn Allocator)) (path (slice u8))]
  (-> (Option Resolved))
  (let [slash (dep-slash path)]
    (if (<= slash 0)
        (None [Resolved])
        (let [name (subslice path 0 slash)
              rel (subslice path (primitive/iadd slash 1) (len path))
              envname (text/format a "COIL_DEP_{}" name)
              ep (unit-getenv (to-cstr a envname))]
          (if (= (primitive/cast i64 ep) 0)
              (None [Resolved])
              (let [root (from-cstr ep)
                    candidate (path-join a root rel)
                    buf
                      (primitive/cast (ptr i8)
                                      (data (match (alloc-bytes a 4096 1)
                                              (Some [s] s)
                                              (None []
                                                    (do
                                                      (oom-at c"compiler allocation"
                                                              4096)
                                                      (slice::new (primitive/cast (ptr u8)
                                                                                  0)
                                                                  0))))))
                    r (realpath-rooted (to-cstr a candidate) buf)]
                (if (= (primitive/cast i64 r) 0)
                    (None [Resolved])
                    (let [canon (from-cstr buf)]
                      (if (not (dep-path-contained? root canon))
                          (None [Resolved])
                          (let [(mut rp) (zeroed Resolved)]
                            (set! (.text rp) (read-file a buf))
                            (set! (.incdir rp) (dirname canon))
                            (set! (.disp rp) canon)
                            (Some rp)))))))))))

(defn resolve-source [(a (dyn Allocator))
                      (s (mut LS))
                      (form (ptr Sexp))
                      (base (slice u8))
                      (name (slice u8))] (-> Resolved)
  (block :resolve
    ; Which packages this compilation loads is decided here, at the one place
    ; that turns a namespace into a file, and before a prebuilt unit or a
    ; generated source can stand in for that file.
    (when (link-packages-active?)
      (let [owners (namespace-paths-for a (mut s) name)]
        (for [i 0 (len (load owners))]
          (link-package-note-path! (get (load owners) i))
          0))
      ; A prebuilt unit can serve a namespace no file under the package
      ; spells (a reader's `module-name`, as the C reader's is), so the
      ; files the unit was built from are what tie it to its package.
      (link-package-note-unit-sources! a name)
      0)
    (let [virtual (virtual-source name)]
      (unless (= (primitive/cast i64 virtual) 0)
        (return-from :resolve (load virtual))))
    (let [nn (len name)
          legacy
            (or (>= (dep-slash name) 0)
                (and (>= nn 5)
                     (= (subslice name (primitive/isub nn 5) nn) ".coil")))
          stdmapped (stdlib-file-for-namespace name)
          ; The compiler's own package declares the SDK's namespaces in its
          ; files. For a program of that package those files are the
          ; namespaces, not the copy the running toolchain carries: it is the
          ; source being checked, linted or built.
          own-sdk
            (and (> (len (sdk-file-for-namespace name)) 0)
                 (> (len (load (namespace-paths-for a (mut s) name))) 0))
          sdkmapped (if own-sdk "" (sdk-file-for-namespace name))
          profile-forbidden
            (and (not (= base (bundled-base)))
                 (and (= (stdlib-profile a) "hermetic")
                      (and (> (len stdmapped) 0)
                           (not (stdlib-hermetic-namespace? name)))))
          mapped
            (if (bundled-stdlib-enabled? a)
                (if profile-forbidden
                    ""
                    (if (> (len stdmapped) 0) stdmapped sdkmapped))
                "")
          ; Transitional compatibility is confined to compiler-owned embedded text.
          ; User source never has the <bundled> base and therefore cannot import a
          ; filename, relative or otherwise.
          bn
            (if (and (= (len mapped) 0)
                     (and (= base (bundled-base)) (bundled? name)))
                name
                mapped)]
      (if (and legacy (not (= base (bundled-base))))
          (do
            (ls-set-err! (mut s)
                         (diag-at-form form
                                       "import paths are not supported; import the target's declared namespace (run `coil lint --fix` to migrate legacy imports)"))
            (zeroed Resolved))
          (if profile-forbidden
              (do
                (ls-set-err! (mut s)
                             (diag-at-form form
                                           (text/format a
                                                        "namespace '{}' is unavailable under stdlib profile 'hermetic'"
                                                        name)))
                (zeroed Resolved))
              (if (> (len bn) 0)
                  (let [(mut rp) (zeroed Resolved)]
                    (set! (.text rp) (bundled-text a bn))
                    ; include-str is relative to the module's own file, as it
                    ; is for a module found in the namespace roots.
                    (set! (.incdir rp)
                          (dirname (bundled-path a bn)))
                    (set! (.disp rp) (text/format a "<bundled {}>" bn))
                    rp)
                  (match (namespace-path a (mut s) form name)
                    (Some [path]
                          (if (and (bundled-stdlib-enabled? a)
                                   (and (strict-bundle? a)
                                        (and (not own-sdk)
                                             (starts-with name "coil."))))
                              (do
                                (ls-set-err! (mut s)
                                             (diag-at-form form
                                                           (text/format a
                                                                        "namespace '{}' is missing from the bundled stdlib manifest — it resolved only from the source tree, so an installed compiler could not import it; regenerate with scripts/compiler/gen-stdlib-manifest.py"
                                                                        name)))
                                (zeroed Resolved))
                              (let [buf
                                      (primitive/cast (ptr i8)
                                                      (data (match (alloc-bytes a
                                                                                4096
                                                                                1)
                                                              (Some [s]
                                                                    s)
                                                              (None []
                                                                    (do
                                                                      (oom-at c"compiler allocation"
                                                                              4096)
                                                                      (slice::new (primitive/cast (ptr u8)
                                                                                                  0)
                                                                                  0))))))
                                    r (realpath-rooted (to-cstr a path) buf)
                                    (mut rp) (zeroed Resolved)]
                                (if (= (primitive/cast i64 r)
                                       0)
                                    (do
                                      (ls-set-err! (mut s)
                                                   (diag-at-form form
                                                                 (text/format a
                                                                              "namespace '{}' points to a source file that no longer exists"
                                                                              name)))
                                      (zeroed Resolved))
                                    (let [canon (from-cstr buf)]
                                      (set! (.text rp) (read-file a buf))
                                      (set! (.incdir rp) (dirname canon))
                                      (set! (.disp rp) canon)
                                      rp)))))
                    (None []
                          (match (if (ls-err? (mut s))
                                     (None [Resolved])
                                     (discover-reader-named (mut s) name))
                            ; its package is loaded, so its [link] inputs are this build's
                            (Some [found]
                                  (do
                                    (link-package-note-path! (.disp found))
                                    found))
                            (None []
                                  (do
                                    (unless (ls-err? (mut s))
                                      (ls-set-err! (mut s)
                                                   (diag-at-form form
                                                                 (text/format a
                                                                              "namespace '{}{}"
                                                                              name
                                                                              (if (bundled-stdlib-enabled? a)
                                                                                  "' was not found in the project, its dependencies, or the bundled standard library"
                                                                                  "' was not found in the no-stdlib compilation universe"))))
                                      0)
                                    (zeroed Resolved))))))))))))

(defn l-as-list [(f (ptr Sexp))] (-> (ptr (ArrayList Sexp)))
  (match (.kind f)
    (KList [items] items)
    (KInt [_]
          (do
            (loader-abort "expected a list")
            (box-items (unit-allocator)
                       (ArrayList::new [Sexp] (unit-allocator)))))
    (KFloat [_]
            (do
              (loader-abort "expected a list")
              (box-items (unit-allocator)
                         (ArrayList::new [Sexp] (unit-allocator)))))
    (KSym [_]
          (do
            (loader-abort "expected a list")
            (box-items (unit-allocator)
                       (ArrayList::new [Sexp] (unit-allocator)))))
    (KKw [_]
         (do
           (loader-abort "expected a list")
           (box-items (unit-allocator) (ArrayList::new [Sexp] (unit-allocator)))))
    (KStr [_]
          (do
            (loader-abort "expected a list")
            (box-items (unit-allocator)
                       (ArrayList::new [Sexp] (unit-allocator)))))
    (KCStr [_]
           (do
             (loader-abort "expected a list")
             (box-items (unit-allocator)
                        (ArrayList::new [Sexp] (unit-allocator)))))
    (KVec [_]
          (do
            (loader-abort "expected a list")
            (box-items (unit-allocator)
                       (ArrayList::new [Sexp] (unit-allocator)))))
    (KView [_]
           (do
             (loader-abort "expected a list")
             (box-items (unit-allocator)
                        (ArrayList::new [Sexp] (unit-allocator)))))
    (KSeg [_]
          (do
            (loader-abort "expected a list")
            (box-items (unit-allocator)
                       (ArrayList::new [Sexp] (unit-allocator)))))))

(defn l-sym-name [(f (ptr Sexp))] (-> (Option (slice u8)))
  (match (.kind f)
    (KSym [s] (Some s))
    (KInt [_] (None [(slice u8)]))
    (KFloat [_] (None [(slice u8)]))
    (KKw [_] (None [(slice u8)]))
    (KStr [_] (None [(slice u8)]))
    (KCStr [_] (None [(slice u8)]))
    (KList [_] (None [(slice u8)]))
    (KVec [_] (None [(slice u8)]))
    (KView [_] (None [(slice u8)]))
    (KSeg [_] (None [(slice u8)]))))

(defn l-list-head [(f (ptr Sexp))] (-> (Option (slice u8)))
  (match (.kind f)
    (KList [items]
           (if (> (len (load items)) 0)
               (let [(mut h) (: (get (load items) 0) Sexp)]
                 (l-sym-name (mut h)))
               (None [(slice u8)])))
    (KInt [_] (None [(slice u8)]))
    (KFloat [_] (None [(slice u8)]))
    (KSym [_] (None [(slice u8)]))
    (KKw [_] (None [(slice u8)]))
    (KStr [_] (None [(slice u8)]))
    (KCStr [_] (None [(slice u8)]))
    (KVec [_] (None [(slice u8)]))
    (KView [_] (None [(slice u8)]))
    (KSeg [_] (None [(slice u8)]))))

(defn l-as-str [(f (ptr Sexp))] (-> (Option (slice u8)))
  (match (.kind f)
    (KStr [s] (Some s))
    (KInt [_] (None [(slice u8)]))
    (KFloat [_] (None [(slice u8)]))
    (KSym [_] (None [(slice u8)]))
    (KKw [_] (None [(slice u8)]))
    (KCStr [_] (None [(slice u8)]))
    (KList [_] (None [(slice u8)]))
    (KVec [_] (None [(slice u8)]))
    (KView [_] (None [(slice u8)]))
    (KSeg [_] (None [(slice u8)]))))

;;; The name a `(module NAME)` form declares, or None when it names nothing -- `(module)`,
;;; `(module 5)`. That is the author's mistake, so whoever meets it reports it at the
;;; form; `module-name` below is for a form already known to be well formed.
(defn module-name-opt [(f (ptr Sexp))] (-> (Option (slice u8)))
  (let [items (l-as-list f)]
    (if (< (len (load items)) 2)
        (None [(slice u8)])
        (let [(mut it) (: (get (load items) 1) Sexp)] (l-sym-name (mut it))))))

(defn module-name [(f (ptr Sexp))] (-> (slice u8))
  (let [items (l-as-list f)
        n (len (load items))]
    (if (< n 2)
        (do (loader-abort "module: expected a name") "")
        (let [(mut it) (: (get (load items) 1) Sexp)]
          (match (l-sym-name (mut it))
            (Some [x] x)
            (None [] (do (loader-abort "module: expected a name") "")))))))

(defn declared-module [(forms (ptr (ArrayList Sexp)))] (-> (Option (slice u8)))
  (let [n (len (load forms))
        (mut res) (None [(slice u8)])]
    (for [i 0 n]
      (let [(mut f) (: (get (load forms) i) Sexp)]
        (match (l-list-head (mut f))
          (Some [h]
                (when (= h "module")
                  (set! res (module-name-opt (mut f)))
                  (break)))
          (None [] 0))))
    (load res)))

;;; A source opts into case-insensitive identifiers by importing a package whose
;;; manifest declares `[package] casefold = "ascii"`. Detect that on the pristine
;;; reader tree, then normalize before loader tables, macro indexes, or hygiene
;;; contexts observe identifiers.
;;;
;;; This used to test for a literal `(import "coil.scheme" ...)`: one dialect's
;;; namespace, compiled into the compiler. The trigger is now a property a package
;;; declares about itself, so a case-insensitive language can live in any workspace
;;; under any name.
(defn loader-casefolding-source? [(forms (ptr (ArrayList Sexp)))] (-> bool)
  (let [n (len (load forms))
        (mut found) false]
    (for [i 0 n]
      (let [f (elem forms i)]
        (if (and (sexp-list? f)
                 (and (>= (sexp-count f) 2)
                      (and (sexp-sym-is (sexp-nth f 0) "import")
                           (match (.kind (sexp-nth f 1))
                             (KStr [s] (ws-casefold-import? s))
                             (_ false)))))
            (set! found true)
            0)))
    (load found)))

(defn loader-ascii-casefold! [(a (dyn Allocator)) (x (ptr Sexp))] (-> i64)
  (match (.kind x)
    (KSym [s]
          (let [n (len s)]
            (if (and (= n 3)
                     (and (= (primitive/cast i64 (get s 0)) 35)
                          (= (primitive/cast i64 (get s 1)) 92)))
                0
                ;; Keep the original slice identity as well as the syntax-node
                ;; identity: loader indexes may already retain views into this source
                ;; buffer. The source storage is owned and mutable for the compilation.
                (for [i 0 n]
                  (let [c (primitive/cast i64 (get s i))]
                    (if (and (>= c 65) (<= c 90))
                        (set! s i (primitive/cast u8 (+ c 32)))
                        0))))))
    (KList [items]
           (let [n (len (load items))]
             (for [i 0 n] (loader-ascii-casefold! a (elem items i)))))
    (KVec [items]
          (let [n (len (load items))]
            (for [i 0 n] (loader-ascii-casefold! a (elem items i)))))
    (_ 0)))

(defn loader-fold-source-node! [(src (slice u8)) (x (ptr Sexp))] (-> i64)
  (match (.kind x)
    (KSym [s]
          (let [lo (.lo x)
                hi (.hi x)]
            (if (and (= (- hi lo) 3)
                     (and (= (primitive/cast i64 (get src lo)) 35)
                          (= (primitive/cast i64 (get src (+ lo 1))) 92)))
                0
                (for [i lo hi]
                  (let [c (primitive/cast i64 (get src i))]
                    (if (and (>= c 65) (<= c 90))
                        (set! src i (primitive/cast u8 (+ c 32)))
                        0))))))
    (KList [items]
           (let [n (len (load items))]
             (for [i 0 n]
               (loader-fold-source-node! src (elem items i)))))
    (KVec [items]
          (let [n (len (load items))]
            (for [i 0 n]
              (loader-fold-source-node! src (elem items i)))))
    (_ 0)))

(defn loader-casefold-source! [(src (slice u8)) (forms (ptr (ArrayList Sexp)))]
  (-> i64)
  (if (not (loader-casefolding-source? forms))
      0
      (let [n (len (load forms))]
        (for [i 0 n]
          (let [f (elem forms i)]
            (if (and (sexp-list? f)
                     (and (> (sexp-count f) 0)
                          (sexp-sym-is (sexp-nth f 0) "module")))
                0
                (loader-fold-source-node! src f)))))))

(defn loader-casefold-scheme! [(a (dyn Allocator))
                               (forms (ptr (ArrayList Sexp)))] (-> i64)
  (if (not (loader-casefolding-source? forms))
      0
      (let [n (len (load forms))]
        (for [i 0 n]
          (let [f (elem forms i)]
            ;; Preserve the namespace spelling in `(module NAME)`; it belongs to
            ;; Coil's module system, while all Scheme program identifiers fold.
            (if (and (sexp-list? f)
                     (and (>= (sexp-count f) 1)
                          (sexp-sym-is (sexp-nth f 0) "module")))
                0
                (loader-ascii-casefold! a f)))))))

(defn collect-syms [(a (dyn Allocator)) (items (ptr (ArrayList Sexp)))]
  (-> (ptr (ArrayList (slice u8))))
  (let [n (len (load items))
        (mut out) (ArrayList::new [(slice u8)] a)]
    (for [i 0 n]
      (let [(mut it) (: (get (load items) i) Sexp)]
        (match (l-sym-name (mut it))
          (Some [nm] (push! (mut out) nm))
          (None [] 0))))
    (box! a (ArrayList (slice u8)) (load out))))

; `:rename [[from to] …]` — a vector of two-symbol vectors. Pairs rather than a map
; literal because the reader has no `{}` form.
(defn collect-renames [(a (dyn Allocator)) (items (ptr (ArrayList Sexp)))]
  (-> (ptr (ArrayList Rename)))
  (let [n (len (load items))
        (mut out) (ArrayList::new [Rename] a)]
    (for [i 0 n]
      (let [(mut it) (: (get (load items) i) Sexp)]
        (match (.kind it)
          (KVec [pair]
                (let [syms (collect-syms a pair)]
                  (if (!= (len (load syms)) 2)
                      (loader-abort "import: :rename expects [[from to] …] — each entry is exactly two symbols")
                      (let [(mut rp) (zeroed Rename)]
                        (set! (.from rp) (get (load syms) 0))
                        (set! (.to rp) (get (load syms) 1))
                        (push! (mut out) rp)))))
          (_ (loader-abort "import: :rename expects [[from to] …] — each entry is a two-symbol vector")))))
    (box! a (ArrayList Rename) (load out))))

(defn imp-elem [(s (mut LS)) (i i64)] (-> (ptr ImpEntry))
  (let [hdr (primitive/alloc-stack (ArrayList ImpEntry))]
    (set! hdr (.imports s))
    (index (load (field hdr data)) i)))

(defn exp-elem [(s (mut LS)) (i i64)] (-> (ptr ExpEntry))
  (let [hdr (primitive/alloc-stack (ArrayList ExpEntry))]
    (set! hdr (.exports s))
    (index (load (field hdr data)) i)))

(defn imp-entry [(s (mut LS)) (name (slice u8))] (-> (ptr ImpEntry))
  (let [n (len (.imports s))
        (mut idx) -1]
    (for [i 0 n]
      (when (= (.name (imp-elem (mut s) i)) name)
        (set! idx i)
        (break)))
    (if (>= (load idx) 0)
        (imp-elem (mut s) (load idx))
        (let [(mut e) (zeroed ImpEntry)
              a (.a s)]
          (set! (.name e) name)
          (init-fields! (.imp e)
                        (ArrayList::new a)
                        [aliases uses reexports forms])
          ; the implicit `(import "coil.core" :use *)` every module starts with
          (set! (.core (.imp e))
                (mk-use a
                        (implicit-prelude-name a)
                        (UAll)
                        (primitive/cast (ptr (ArrayList (slice u8))) 0)
                        (primitive/cast (ptr (ArrayList Rename)) 0)))
          (set! (.core_set (.imp e)) false)
          (push! (mut (.imports s)) e)
          (imp-elem (mut s) n)))))

(defn exp-entry [(s (mut LS)) (name (slice u8))] (-> (ptr ExpEntry))
  (let [n (len (.exports s))
        (mut idx) -1]
    (for [i 0 n]
      (when (= (.name (exp-elem (mut s) i)) name)
        (set! idx i)
        (break)))
    (if (>= (load idx) 0)
        (exp-elem (mut s) (load idx))
        (let [(mut e) (zeroed ExpEntry)
              a (.a s)]
          (set! (.name e) name)
          (set! (.names e) (ArrayList::new [(slice u8)] a))
          (set! (.forms e) (ArrayList::new [Sexp] a))
          (push! (mut (.exports s)) e)
          (exp-elem (mut s) n)))))

(defn ee-add-name! [(e (ptr ExpEntry)) (name (slice u8))] (-> i64)
  (let [n (len (.names e))
        (mut found) false]
    (for [i 0 n]
      (when (= (get (.names e) i) name)
        (set! found true)
        (break)))
    (unless (load found) (push! (mut (.names e)) name))))

(defn mi-add-alias! [(e (ptr ImpEntry)) (alias (slice u8)) (target (slice u8))]
  (-> i64)
  (let [n (len (.aliases (.imp e)))
        (mut idx) -1
        v
          (let [(mut ap) (zeroed Alias)]
            (set! (.alias ap) alias)
            (set! (.target ap) target)
            ap)]
    (for [i 0 n]
      (when (= (let [(mut ep)
                       (: (get (.aliases (.imp e))
                               i)
                          Alias)]
                 (.alias ep))
               alias)
        (set! idx i)
        (break)))
    (if (>= (load idx) 0)
        (set! (mut (.aliases (.imp e))) (load idx) v)
        (push! (mut (.aliases (.imp e))) v))))

(defn mi-add-use! [(a (dyn Allocator))
                   (e (ptr ImpEntry))
                   (target (slice u8))
                   (spec UseSpec)
                   (exclude (ptr (ArrayList (slice u8))))
                   (renames (ptr (ArrayList Rename)))] (-> i64)
  (push! (mut (.uses (.imp e))) (mk-use a target spec exclude renames)))

; An explicit `(import "coil.core" …)` REPLACES the implicit refer-all rather than adding
; to it — Clojure's `:refer-clojure` rule. Recording it into the dedicated `core` slot
; (not into `uses`) is what keeps core the lowest-precedence tier: an explicitly `:use`d
; module still shadows core, exactly as before this existed.
(defn mi-set-core! [(a (dyn Allocator))
                    (e (ptr ImpEntry))
                    (spec UseSpec)
                    (exclude (ptr (ArrayList (slice u8))))
                    (renames (ptr (ArrayList Rename)))] (-> i64)
  (set! (.core (.imp e))
        (mk-use a (implicit-prelude-name a) spec exclude renames))
  (set! (.core_set (.imp e)) true)
  0)

(defn mi-add-reexport! [(a (dyn Allocator))
                        (e (ptr ImpEntry))
                        (target (slice u8))
                        (spec UseSpec)
                        (exclude (ptr (ArrayList (slice u8))))
                        (renames (ptr (ArrayList Rename)))] (-> i64)
  (push! (mut (.reexports (.imp e))) (mk-use a target spec exclude renames)))

;;; Whether a module of this name has already been loaded into this state.
(defn loaded-has? [(s (mut LS)) (name (slice u8))] (-> bool)
  (let [(mut found) false]
    (for m (.loaded s) (when (= m name) (set! found true)))
    found))

(defn loaded-insert! [(s (mut LS)) (name (slice u8))] (-> bool)
  (let [n (len (.loaded s))
        (mut found) false]
    (for [i 0 n]
      (when (= (get (.loaded s) i) name)
        (set! found true)
        (break)))
    (if (load found) false (do (push! (mut (.loaded s)) name) true))))

; A module imported by K modules was READ FROM DISK and fully RE-PARSED K times. The
; already-loaded test above keys on the module NAME, which is only known after parsing,
; so it could skip the recursive descent but never the work of reaching it. On this
; compiler that is 540 imports across 65 files: eight times the file I/O and lexing, and
; 540 entries in the source table where 65 would do.
;
; Keyed on the RESOLVED PATH — which `resolve-source` produces before anything is read —
; each file is read and parsed exactly once. The per-import bookkeeping (alias, :use
; spec, :reexport) still runs for EVERY import; only the reading is shared, so what any
; one importer sees is unchanged.
(defn read-memo-find [(s (mut LS)) (p (slice u8))] (-> (Option (slice u8)))
  (let [n (len (.readpaths s))
        (mut r) (None [(slice u8)])]
    (for [i 0 n]
      (when (= (get (.readpaths s) i) p)
        (set! r (Some (get (.readmods s) i)))
        (break)))
    (load r)))

(defn read-memo-add! [(s (mut LS)) (p (slice u8)) (m (slice u8))] (-> i64)
  (push! (mut (.readpaths s)) p)
  (push! (mut (.readmods s)) m)
  0)

; The bookkeeping an import performs on its IMPORTER, which is per-import and therefore
; runs whether or not the file itself had to be read.
(defn import-record! [(s (mut LS))
                      (cur (Option (slice u8)))
                      (alias (Option (slice u8)))
                      (use-spec (Option UseSpec))
                      (reexport bool)
                      (exclude (ptr (ArrayList (slice u8))))
                      (renames (ptr (ArrayList Rename)))
                      (modname (slice u8))
                      (form (ptr Sexp))] (-> i64)
  (let [a (.a s)
        importer (match cur (Some [m] m) (None [] ""))
        imp (imp-entry (mut s) importer)
        alias-name (match alias (Some [al] al) (None [] modname))]
    (source-import-record! (load form) importer modname)
    (mi-add-alias! imp alias-name modname)
    ; `coil.core` is already referred implicitly, so an explicit import of it REPLACES
    ; that default instead of stacking a second, competing entry. Omitting `:use`
    ; entirely (`(import "coil.core" :as core)`) is Clojure's qualified-only require:
    ; it refers nothing, leaving only the alias.
    (if (= modname (implicit-prelude-name a))
        (mi-set-core! a
                      imp
                      (match use-spec
                        (Some [spec] spec)
                        (None [] (UNames (empty-names a))))
                      exclude
                      renames)
        (match use-spec
          (Some [spec] (mi-add-use! a imp modname spec exclude renames))
          (None [] 0)))
    ; The edge republishes what this import refers. Without a `:use` the import
    ; refers nothing locally, but the edge still republishes the whole module: a
    ; facade that names no list passes its target on in full.
    (when reexport
      (mi-add-reexport! a
                        imp
                        modname
                        (match use-spec
                          (Some [spec] spec)
                          (None [] (UAll)))
                        exclude
                        renames))
    0))

;;; A malformed declaration form is the author's mistake: record it at the form, as a
;;; diagnostic like any other. These used to abort the compiler with an unlocated line.
(defn loader-form-error! [(s (mut LS)) (form (ptr Sexp)) (msg (slice u8))]
  (-> i64)
  (ls-set-err! (mut s) (diag-at-form form msg)))

(defn handle-export [(s (mut LS)) (f (ptr Sexp)) (cur (Option (slice u8)))]
  (-> i64)
  (match cur
    (Some [m]
          (let [items (l-as-list f)
                n (len (load items))
                ep (exp-entry (mut s) m)]
            (record-decl-form! (mut (.forms ep)) (load f))
            (for [i 1 n]
              (let [(mut it) (: (get (load items) i) Sexp)]
                (match (l-sym-name (mut it))
                  (Some [nm] (ee-add-name! ep nm))
                  (None []
                        (do
                          (loader-form-error! (mut s)
                                              f
                                              "export: names must be symbols")
                          0)))))
            0))
    (None []
          (do
            (loader-form-error! (mut s)
                                f
                                "export: only valid inside a (module …)")
            0))))

; `(provide-core [name ...])` is an explicit export list
; whose declarations are eligible for publication through logical `coil.core`.
; Eligibility alone does not make anything ambient: only modules named by the root
; manifest's `[language] core-providers` are loaded as core reexports.
(defn handle-provide-core [(s (mut LS))
                           (f (ptr Sexp))
                           (cur (Option (slice u8)))] (-> i64)
  (match cur
    (None []
          (ls-set-err! (mut s)
                       (diag-at-form f
                                     "provide-core is only valid inside a (module …)")))
    (Some [m]
          (let [items (l-as-list f)
                n (len (load items))]
            (unless (set-contains (field s core_declared_modules) m)
              (push! (mut (.core_declared_modules s)) m)
              0)
            (if (not (= n 2))
                (ls-set-err! (mut s)
                             (diag-at-form f
                                           "provide-core: expected (provide-core [names])"))
                (let [(mut names-form) (: (get (load items) 1) Sexp)]
                  (match (.kind names-form)
                    (KVec [names]
                          ; Deliberately NOT an `(export ...)`: publishing into the
                          ; ambient namespace is a separate axis from a module's own
                          ; export list, and conflating them broke both. Writing the
                          ; export entry narrowed what `:use [name]` could name, while
                          ; failing to narrow what went ambient -- the entry does not
                          ; survive the declaration rebuild that resolve runs against,
                          ; so the reexport edge passed every name through. Ambient
                          ; visibility is decided by the registry below instead.
                          (let [nn (len (load names))
                                (mut i) 0]
                            (loop (if (>= (load i) nn)
                                      (break)
                                      (let [(mut name-form)
                                              (: (get (load names) (load i))
                                                 Sexp)]
                                        (match (l-sym-name (mut name-form))
                                          (Some [name]
                                                (core-decl-add! m
                                                                name
                                                                (.lo name-form)
                                                                (.hi name-form)
                                                                (.source name-form)
                                                                (.ctxt name-form)))
                                          (None []
                                                (ls-set-err! (mut s)
                                                             (diag-at-form (mut name-form)
                                                                           "provide-core: every provided name must be a symbol"))))
                                        (set! i (primitive/iadd (load i) 1)))))
                            0))
                    (_ (ls-set-err! (mut s)
                                    (diag-at-form (mut names-form)
                                                  "provide-core: expected a vector of declaration names")))))))))
  0)

;;; Forms an earlier probe read from `disp` (with this exact text), or null.
(defn probed-forms [(s (mut LS)) (disp (slice u8)) (text (slice u8))]
  (-> (ptr (ArrayList Sexp)))
  (let [(mut found) (primitive/cast (ptr (ArrayList Sexp)) 0)]
    (for [i 0 (len (.probed s))]
      (let [p (elem (field s probed) i)]
        (when (and (= (.disp p) disp) (= (.text p) text))
          (set! found (.forms p))
          0))
      0)
    (load found)))

;;; A dependency may name its entry module through its reader rather than a
;;; [modules] entry: the C reader's `module-name`, for one. No path spells such a
;;; name, so when a namespace is found nowhere else, read each dependency's
;;; reader-served entry (once per compilation) and see which module it declares.
;;; The forms are kept, so the import that follows does not read the file again.
(defn discover-reader-named [(s (mut LS)) (name (slice u8))]
  (-> (Option Resolved))
  (let [a (.a s)
        pkgs (project-packages a)
        (mut answer) (None [Resolved])]
    ; an entry probed already, for this or an earlier lookup
    (for [i 0 (len (.probed s))]
      (let [p (elem (field s probed) i)]
        (when (and (none? (load answer)) (= (.declared p) name))
          (set! answer
                (Some (Resolved
                        :text (.text p)
                        :incdir (dirname (.disp p))
                        :disp (.disp p))))
          0))
      0)
    (unless (or (= (primitive/cast i64 pkgs) 0) (some? (load answer)))
      (for [i 0 (len (load pkgs))]
        (let [pkg (elem pkgs i)]
          (when (and (none? (load answer))
                     (and (.dependency pkg)
                          (and (> (len (.entry pkg)) 0)
                               (> (len (configured-reader-module a (.entry pkg)))
                                  0))))
            (match (realpath-opt a (.entry pkg))
              (None [] 0)
              (Some [disp]
                    (let [(mut seen) false]
                      (for [j 0 (len (.probed s))]
                        (when (= (.disp (elem (field s probed) j)) disp)
                          (set! seen true)
                          0)
                        0)
                      (unless (load seen)
                        (let [text (read-file a (to-cstr a disp))
                              sid (.srccount s)]
                          (set! (.srccount s) (primitive/iadd sid 1))
                          (register-source! (mut s) disp text)
                          ; "" names no module: output that declares none stays undeclared
                          (match (read-module-forms! (mut s)
                                                     (primitive/cast (ptr Sexp)
                                                                     0)
                                                     disp
                                                     text
                                                     sid
                                                     "")
                            (Err [d] (ls-set-err! (mut s) d))
                            (Ok [forms]
                                (let [declared
                                        (match (declared-module forms)
                                          (Some [m] m)
                                          (None [] ""))]
                                  (push! [ProbedModule]
                                         (mut (.probed s))
                                         (ProbedModule
                                           :disp disp
                                           :text text
                                           :declared declared
                                           :forms forms))
                                  (when (= declared name)
                                    (set! answer
                                          (Some (Resolved
                                                  :text text
                                                  :incdir (dirname disp)
                                                  :disp disp)))
                                    0)))))
                        0)
                      0)))
            0))
        0)
      0)
    (load answer)))

; Read one module's source into forms: Coil through the reader, a guest language
; through the configured source reader, in either case followed by the casefold
; re-read a case-insensitive module asks for. `form` is the importing form the
; "no reader" error anchors at; null anchors it in the file itself.
(defn read-module-forms! [(s (mut LS))
                          (form (ptr Sexp))
                          (disp (slice u8))
                          (text (slice u8))
                          (inc-id i64)
                          (name (slice u8))]
  (-> (Result (ptr (ArrayList Sexp)) Diag))
  (let [a (.a s)
        reader-mod (configured-reader-module a disp)
        guest (> (len reader-mod) 0)
        hook (source-reader-hook)
        probed (probed-forms (mut s) disp text)
        read-result
          (if (!= (primitive/cast i64 probed) 0)
              (Ok [(ptr (ArrayList Sexp)) Diag] probed)
              (if guest
                  (if (= (.isset hook) 0)
                      (let [msg
                              (text/format a
                                           "import '{}' requires a configured reader, but no reader setup is active"
                                           name)]
                        (Err [(ptr (ArrayList Sexp)) Diag]
                             (if (= (primitive/cast i64 form)
                                    0)
                                 (derr-at-src inc-id 0 0 msg)
                                 (diag-at-form form msg))))
                      (let [got
                              (call-ptr (.fp hook)
                                        a
                                        s
                                        disp
                                        text
                                        inc-id
                                        reader-mod)]
                        (if (= (primitive/cast i64 got) 0)
                            (Err [(ptr (ArrayList Sexp)) Diag] (.loaderr s))
                            (Ok [(ptr (ArrayList Sexp)) Diag] got))))
                  (read-source-forms a text inc-id)))]
    (match read-result
      (Err [d] (Err [(ptr (ArrayList Sexp)) Diag] d))
      (Ok [inc0]
          (let [read-forms (if guest (ensure-guest-module a inc0 name) inc0)]
            (Ok [(ptr (ArrayList Sexp)) Diag]
                (if (loader-casefolding-source? read-forms)
                    (do
                      (loader-casefold-source! text read-forms)
                      (try (let [fresh
                                   (try-or! (read-source-forms a text inc-id)
                                            read-forms)]
                             fresh)))
                    read-forms)))))))

(defn process-import-checked [(s (mut LS))
                              (form (ptr Sexp))
                              (base (slice u8))
                              (cur (Option (slice u8)))] (-> i64)
  (let [a (.a s)
        items (l-as-list form)
        nit (len (load items))
        path
          (if (< nit 2)
              (do
                (loader-abort "import: the wrapper let through an import with no namespace")
                "")
              (let [(mut it) (: (get (load items) 1) Sexp)]
                (match (l-as-str (mut it))
                  (Some [p] p)
                  (None []
                        (do
                          (loader-abort "import: the wrapper let through an import whose namespace is not a string")
                          "")))))
        (mut alias) (None [(slice u8)])
        (mut use-spec) (None [UseSpec])
        (mut reexport) false
        (mut exclude) (primitive/cast (ptr (ArrayList (slice u8))) 0)
        (mut renames) (primitive/cast (ptr (ArrayList Rename)) 0)
        (mut i) 2]
    ; `--use` is implemented as a synthetic, unspanned import. It is an input to
    ; the lint run, not user syntax, so never expose it as a checker-visible form.
    (when (not (source-is-cli-use? (mut s) (sx-source (load form))))
      (match cur
        (Some [m]
              (record-decl-form! (mut (.forms (.imp (imp-entry (mut s) m))))
                                 (load form)))
        (None [] 0)))
    (loop (if (>= (load i) nit)
              (break)
              (let [(mut it) (: (get (load items) (load i)) Sexp)]
                (match (.kind it)
                  (KKw [k]
                       (cond (= k "as")
                               (let [(mut a2)
                                       (: (get (load items)
                                               (primitive/iadd (load i) 1))
                                          Sexp)]
                                 (match (l-sym-name (mut a2))
                                   (Some [al]
                                         (do
                                           (set! alias (Some al))
                                           (set! i (primitive/iadd (load i) 2))))
                                   (None []
                                         (do
                                           (loader-form-error! (mut s)
                                                               form
                                                               "import: :as expects an alias symbol")
                                           (set! i (primitive/iadd (load i) 2))))))
                             (= k "reexport")
                               (do
                                 (set! reexport true)
                                 (set! i (primitive/iadd (load i) 1)))
                             (= k "exclude")
                               (let [(mut v2)
                                       (: (get (load items)
                                               (primitive/iadd (load i) 1))
                                          Sexp)]
                                 (match (.kind v2)
                                   (KVec [vit]
                                         (set! exclude (collect-syms a vit)))
                                   (_ (loader-form-error! (mut s)
                                                          form
                                                          "import: :exclude expects [names]")))
                                 (set! i (primitive/iadd (load i) 2)))
                             (= k "rename")
                               (let [(mut v2)
                                       (: (get (load items)
                                               (primitive/iadd (load i) 1))
                                          Sexp)]
                                 (match (.kind v2)
                                   (KVec [vit]
                                         (set! renames (collect-renames a vit)))
                                   (_ (loader-form-error! (mut s)
                                                          form
                                                          "import: :rename expects [[from to] …]")))
                                 (set! i (primitive/iadd (load i) 2)))
                             (= k "use")
                               (let [(mut v2)
                                       (: (get (load items)
                                               (primitive/iadd (load i) 1))
                                          Sexp)]
                                 (match (.kind v2)
                                   (KSym [sm]
                                         (if (= sm "*")
                                             (do
                                               (set! use-spec (Some (UAll)))
                                               (set! i
                                                     (primitive/iadd (load i)
                                                                     2)))
                                             (do
                                               (loader-form-error! (mut s)
                                                                   form
                                                                   "import: :use expects * or [names]")
                                               (set! i
                                                     (primitive/iadd (load i)
                                                                     2)))))
                                   (KVec [vit]
                                         (do
                                           (set! use-spec
                                                 (Some (UNames (collect-syms a
                                                                             vit))))
                                           (set! i (primitive/iadd (load i) 2))))
                                   (KInt [_]
                                         (do
                                           (loader-form-error! (mut s)
                                                               form
                                                               "import: :use expects * or [names]")
                                           (set! i (primitive/iadd (load i) 2))))
                                   (KFloat [_]
                                           (do
                                             (loader-form-error! (mut s)
                                                                 form
                                                                 "import: :use expects * or [names]")
                                             (set! i
                                                   (primitive/iadd (load i) 2))))
                                   (KView [_]
                                          (do
                                            (loader-form-error! (mut s)
                                                                form
                                                                "import: :use expects * or [names]")
                                            (set! i (primitive/iadd (load i) 2))))
                                   (KSeg [_]
                                         (do
                                           (loader-form-error! (mut s)
                                                               form
                                                               "import: :use expects * or [names]")
                                           (set! i (primitive/iadd (load i) 2))))
                                   (KKw [_]
                                        (do
                                          (loader-form-error! (mut s)
                                                              form
                                                              "import: :use expects * or [names]")
                                          (set! i (primitive/iadd (load i) 2))))
                                   (KStr [_]
                                         (do
                                           (loader-form-error! (mut s)
                                                               form
                                                               "import: :use expects * or [names]")
                                           (set! i (primitive/iadd (load i) 2))))
                                   (KCStr [_]
                                          (do
                                            (loader-form-error! (mut s)
                                                                form
                                                                "import: :use expects * or [names]")
                                            (set! i (primitive/iadd (load i) 2))))
                                   (KList [_]
                                          (do
                                            (loader-form-error! (mut s)
                                                                form
                                                                "import: :use expects * or [names]")
                                            (set! i (primitive/iadd (load i) 2))))))
                             :else
                               (do
                                 (loader-form-error! (mut s)
                                                     form
                                                     "import: expected :as alias, :use *|[names], :exclude [names], :rename [[from to] …], or :reexport")
                                 (set! i (primitive/iadd (load i) 1)))))
                  (KInt [_]
                        (do
                          (loader-form-error! (mut s)
                                              form
                                              "import: expected :as alias, :use *|[names], :exclude [names], :rename [[from to] …], or :reexport")
                          (set! i (primitive/iadd (load i) 1))))
                  (KFloat [_]
                          (do
                            (loader-form-error! (mut s)
                                                form
                                                "import: expected :as alias, :use *|[names], :exclude [names], :rename [[from to] …], or :reexport")
                            (set! i (primitive/iadd (load i) 1))))
                  (KSym [_]
                        (do
                          (loader-form-error! (mut s)
                                              form
                                              "import: expected :as alias, :use *|[names], :exclude [names], :rename [[from to] …], or :reexport")
                          (set! i (primitive/iadd (load i) 1))))
                  (KStr [_]
                        (do
                          (loader-form-error! (mut s)
                                              form
                                              "import: expected :as alias, :use *|[names], :exclude [names], :rename [[from to] …], or :reexport")
                          (set! i (primitive/iadd (load i) 1))))
                  (KCStr [_]
                         (do
                           (loader-form-error! (mut s)
                                               form
                                               "import: expected :as alias, :use *|[names], :exclude [names], :rename [[from to] …], or :reexport")
                           (set! i (primitive/iadd (load i) 1))))
                  (KList [_]
                         (do
                           (loader-form-error! (mut s)
                                               form
                                               "import: expected :as alias, :use *|[names], :exclude [names], :rename [[from to] …], or :reexport")
                           (set! i (primitive/iadd (load i) 1))))
                  (KVec [_]
                        (do
                          (loader-form-error! (mut s)
                                              form
                                              "import: expected :as alias, :use *|[names], :exclude [names], :rename [[from to] …], or :reexport")
                          (set! i (primitive/iadd (load i) 1))))
                  (KView [_]
                         (do
                           (loader-form-error! (mut s)
                                               form
                                               "import: expected :as alias, :use *|[names], :exclude [names], :rename [[from to] …], or :reexport")
                           (set! i (primitive/iadd (load i) 1))))
                  (KSeg [_]
                        (do
                          (loader-form-error! (mut s)
                                              form
                                              "import: expected :as alias, :use *|[names], :exclude [names], :rename [[from to] …], or :reexport")
                          (set! i (primitive/iadd (load i) 1))))))))
    ; `:exclude` subtracts from `:use *`. Pairing it with `:use [names]` — already a
    ; whitelist — means the author expects one of the two to be doing something it isn't,
    ; so say so rather than silently honoring the narrower one.
    (when (and (!= (primitive/cast i64 (load exclude)) 0)
               (match (load use-spec)
                 (Some [sp] (match sp (UAll [] false) (UNames [_] true)))
                 (None [] false)))
      (ls-set-err! (mut s)
                   (diag-at-form form
                                 ":exclude subtracts from `:use *`, but this import already lists the names it refers with `:use [names]` — drop one of them"))
      0)
    ; `coil.core` is the prelude: already loaded, and it has no file under any source
    ; root to resolve. An explicit import of it is pure bookkeeping — it overrides the
    ; module's implicit refer-all and nothing more. The same holds for any module this
    ; load (or, in a retained JIT session, an earlier accepted submission) has already
    ; loaded: a module declared in submitted source has no file to resolve.
    (if (or (= path (implicit-prelude-name a)) (loaded-has? (mut s) path))
        (import-record! (mut s)
                        cur
                        (load alias)
                        (load use-spec)
                        (load reexport)
                        (load exclude)
                        (load renames)
                        (if (= path (implicit-prelude-name a))
                            (implicit-prelude-name a)
                            path)
                        form)
        (let [rr (resolve-source a (mut s) form base path)
              (mut rp) (: rr Resolved)]
          (unless (ls-err? (mut s))
            (match (read-memo-find (mut s) (.disp rp))
              ; already read for another importer — only this importer's record is new
              (Some [modname]
                    (import-record! (mut s)
                                    cur
                                    (load alias)
                                    (load use-spec)
                                    (load reexport)
                                    (load exclude)
                                    (load renames)
                                    modname
                                    form))
              (None []
                    (let [text (.text rp)
                          incdir (.incdir rp)
                          inc-id (.srccount s)
                          _ignore (set! (.srccount s) (primitive/iadd inc-id 1))
                          _reg (register-source! (mut s) (.disp rp) text)]
                      (let [guest
                              (> (len (configured-reader-module a (.disp rp)))
                                 0)]
                        (match (read-module-forms! (mut s)
                                                   form
                                                   (.disp rp)
                                                   text
                                                   inc-id
                                                   path)
                          ; `d` is already anchored in the imported file (read-all stamped inc-id),
                          ; so hand it to the driver verbatim — it points at the unclosed form. A
                          ; generic abort here would drop the one span that locates the mistake.
                          (Err [d] (do (ls-set-err! (mut s) d) 0))
                          (Ok [inc-forms]
                              (let [modname
                                      (match (declared-module inc-forms)
                                        (Some [m] m)
                                        (None []
                                              (if guest
                                                  path
                                                  ; The file was read as Coil and therefore
                                                  ; still owns its identity with `(module …)`.
                                                  (do
                                                    (ls-set-err! (mut s)
                                                                 (diag-at-form form
                                                                               (text/format a
                                                                                            "import '{}': file has no (module …) declaration — add (module <name>) as its first form"
                                                                                            (.disp rp))))
                                                    ""))))
                                    _guest-name-check
                                      (when (and guest (not (= modname path)))
                                        (ls-set-err! (mut s)
                                                     (diag-at-form form
                                                                   (text/format a
                                                                                "reader output declares namespace '{}', but the imported namespace is '{}'"
                                                                                modname
                                                                                path)))
                                        0)
                                    _memo
                                      (read-memo-add! (mut s)
                                                      (.disp rp)
                                                      modname)]
                                (import-record! (mut s)
                                                cur
                                                (load alias)
                                                (load use-spec)
                                                (load reexport)
                                                (load exclude)
                                                (load renames)
                                                modname
                                                form)
                                (when (loaded-insert! (mut s) modname)
                                  (process-forms (mut s)
                                                 inc-forms
                                                 incdir
                                                 (None [(slice u8)])))
                                0))))))))))))

;;; Whether every option of an import that takes a value has one. `:as`, `:use`,
;;; `:exclude` and `:rename` each read the item after them; as the last item of the form
;;; there is none, and the option parser would read past the end of the list.
(defn import-options-complete? [(items (ptr (ArrayList Sexp)))] (-> bool)
  (let [n (len (load items))
        (mut complete) true]
    (for [i 2 n]
      (let [(mut it) (: (get (load items) i) Sexp)]
        (match (.kind it)
          (KKw [k]
               (when (and (or (= k "as")
                              (= k "use")
                              (= k "exclude")
                              (= k "rename"))
                          (>= (primitive/iadd i 1) n))
                 (set! complete false)
                 0))
          (_ 0))))
    (load complete)))

;;; A malformed import is the author's mistake, so it is a diagnostic at the form
;;; like any other rather than an abort.
(defn process-import [(s (mut LS))
                      (form (ptr Sexp))
                      (base (slice u8))
                      (cur (Option (slice u8)))] (-> i64)
  (let [items (l-as-list form)
        named
          (if (< (len (load items)) 2)
              false
              (let [(mut it) (: (get (load items) 1) Sexp)]
                (match (l-as-str (mut it)) (Some [_] true) (None [] false))))]
    (if (and named (import-options-complete? items))
        (process-import-checked (mut s) form base cur)
        (ls-set-err! (mut s)
                     (diag-at-form form
                                   "import: expected (import \"namespace\" [:as alias] [:use …])")))))

; Join the string elements of a `:flags ["-I…" "-D…"]` option into one clang
; flags string (each space-prefixed), or "" if absent. Forwarded to clang so
; headers that need include paths / feature defines can be parsed correctly.
(defn cimport-kwstr [(a (dyn Allocator))
                     (items (ptr (ArrayList Sexp)))
                     (nit i64)
                     (kw (slice u8))] (-> (slice u8))
  (let [(mut out) (StrBuf::new a)
        (mut j) 2]
    (loop (if (>= (load j) nit)
              (break)
              (let [(mut kwt) (: (get (load items) (load j)) Sexp)]
                (match (.kind kwt)
                  (KKw [k]
                       (if (and (= k kw) (< (primitive/iadd (load j) 1) nit))
                           (do
                             (let [(mut vec)
                                     (: (get (load items)
                                             (primitive/iadd (load j) 1))
                                        Sexp)]
                               (match (.kind vec)
                                 (KVec [vit]
                                       (let [(mut vi) 0
                                             vn (len (load vit))]
                                         (loop (if (>= (load vi) vn)
                                                   (break)
                                                   (do
                                                     (let [(mut el)
                                                             (: (get (load vit)
                                                                     (load vi))
                                                                Sexp)]
                                                       (match (l-as-str (mut el))
                                                         (Some [fs]
                                                               (do
                                                                 (push-str! (mut out)
                                                                            " ")
                                                                 (push-str! (mut out)
                                                                            fs)
                                                                 0))
                                                         (None [] 0)))
                                                     (set! vi
                                                           (primitive/iadd (load vi)
                                                                           1)))))))
                                 (_ 0)))
                             (set! j (primitive/iadd (load j) 2)))
                           (set! j (primitive/iadd (load j) 1))))
                  (_ (set! j (primitive/iadd (load j) 1)))))))
    (str (load out))))

; parse one `:probe` entry: `(name "C-expr")` (tier 0) or `(name :bits "struct X" "f")`
; (tier 1) → push a Probe. Malformed entries are ignored.
(defn parse-probe-entry [(a (dyn Allocator))
                         (plist (ptr (ArrayList ci/Probe)))
                         (entry (ptr Sexp))] (-> i64)
  (let [it (l-as-list entry)
        n (len (load it))]
    (unless (< n 2)
      (let [(mut e0) (: (get (load it) 0) Sexp)]
        (match (l-sym-name (mut e0))
          (None [] 0)
          (Some [name]
                (let [(mut e1) (: (get (load it) 1) Sexp)]
                  (match (.kind e1)
                    (KStr [ex] (ci/probe-push! a plist name 0 ex "" ""))
                    (KCStr [ex] (ci/probe-push! a plist name 0 ex "" ""))
                    (KKw [k]
                         (when (and (= k "bits") (>= n 4))
                           (let [(mut e2) (: (get (load it) 2) Sexp)
                                 (mut e3) (: (get (load it) 3) Sexp)]
                             (match (l-as-str (mut e2))
                               (None [] 0)
                               (Some [sn]
                                     (match (l-as-str (mut e3))
                                       (None [] 0)
                                       (Some [fnm]
                                             (ci/probe-push! a
                                                             plist
                                                             name
                                                             1
                                                             ""
                                                             sn
                                                             fnm))))))))
                    (_ 0)))))))))

; is a bare keyword `:kw` present anywhere in the form's tail?
(defn has-kw? [(items (ptr (ArrayList Sexp))) (nit i64) (kw (slice u8))]
  (-> bool)
  (let [(mut j) 2
        (mut r) false]
    (loop (if (or (>= (load j) nit) (load r))
              (break)
              (do
                (let [(mut k) (: (get (load items) (load j)) Sexp)]
                  (match (.kind k)
                    (KKw [n] (when (= n kw) (set! r true) 0))
                    (_ 0)))
                (set! j (primitive/iadd (load j) 1)))))
    (load r)))

; Collect bare symbols from a `:use [name …]` option. A present empty vector means
; import nothing; absence means the historical import-everything behavior.
(defn cimport-use-names [(a (dyn Allocator))
                         (items (ptr (ArrayList Sexp)))
                         (nit i64)] (-> (ptr (ArrayList (slice u8))))
  (let [names (box! a (ArrayList (slice u8)) (ArrayList::new [(slice u8)] a))
        (mut j) 2]
    (loop (if (>= (load j) nit)
              (break)
              (let [(mut kwt) (: (get (load items) (load j)) Sexp)]
                (match (.kind kwt)
                  (KKw [k]
                       (if (and (= k "use") (< (primitive/iadd (load j) 1) nit))
                           (do
                             (let [(mut vec)
                                     (: (get (load items)
                                             (primitive/iadd (load j) 1))
                                        Sexp)]
                               (match (.kind vec)
                                 (KVec [vit]
                                       (let [(mut vi) 0
                                             vn (len (load vit))]
                                         (loop (if (>= (load vi) vn)
                                                   (break)
                                                   (let [(mut el)
                                                           (: (get (load vit)
                                                                   (load vi))
                                                              Sexp)]
                                                     (match (l-sym-name (mut el))
                                                       (Some [name]
                                                             (push! [(slice u8)]
                                                                    names
                                                                    name))
                                                       (None [] 0))
                                                     (set! vi
                                                           (primitive/iadd (load vi)
                                                                           1)))))))
                                 (_ 0)))
                             (set! j (primitive/iadd (load j) 2)))
                           (set! j (primitive/iadd (load j) 1))))
                  (_ (set! j (primitive/iadd (load j) 1)))))))
    names))

; collect the `:probe [ … ]` entries into a Probe list.
(defn cimport-probes [(a (dyn Allocator))
                      (items (ptr (ArrayList Sexp)))
                      (nit i64)] (-> (ptr (ArrayList ci/Probe)))
  (let [plist (ci/probe-list-new a)
        (mut j) 2]
    (loop (if (>= (load j) nit)
              (break)
              (let [(mut kwt) (: (get (load items) (load j)) Sexp)]
                (match (.kind kwt)
                  (KKw [k]
                       (if (and (= k "probe")
                                (< (primitive/iadd (load j) 1) nit))
                           (do
                             (let [(mut vec)
                                     (: (get (load items)
                                             (primitive/iadd (load j) 1))
                                        Sexp)]
                               (match (.kind vec)
                                 (KVec [vit]
                                       (let [(mut vi) 0
                                             vn (len (load vit))]
                                         (loop (if (>= (load vi) vn)
                                                   (break)
                                                   (do
                                                     (let [(mut el)
                                                             (: (get (load vit)
                                                                     (load vi))
                                                                Sexp)]
                                                       (parse-probe-entry a
                                                                          plist
                                                                          (mut el)))
                                                     (set! vi
                                                           (primitive/iadd (load vi)
                                                                           1)))))))
                                 (_ 0)))
                             (set! j (primitive/iadd (load j) 2)))
                           (set! j (primitive/iadd (load j) 1))))
                  (_ (set! j (primitive/iadd (load j) 1)))))))
    plist))

;; ── cimport results, reused for the life of the process ─────────────────────
;;; Everything a cimport's generated text is computed from, as the source form
;;; gives it.
(defstruct CimportRequest
  [(path (slice u8))
   (flags (slice u8))
   (use-present bool)
   (use-names (ptr (ArrayList (slice u8))))
   (probes (ptr (ArrayList ci/Probe)))
   (link (slice u8))
   (probe-only bool)])

;;; A generated binding text and the content digest of every file clang read to
;;; generate it. Owned by the cache: malloc storage, freed when replaced.
(defstruct CimportCached
  [(text (slice u8)) (inputs (ArrayList artifact-id/ArtifactInput))])

;;; Process-owned, like the link-package registry. A process can load the same
;;; program many times: `coil lint --fix` analyses it once per round, once per
;;; trial while salvaging a round, and once more to report, and every load ran
;;; every cimport through clang again. For the Mach headers that was seconds and
;;; gigabytes per cimport, per analysis.
(defstruct CimportCacheCell
  [(ready bool) (entries (HashMap (slice u8) CimportCached))])

(defn cimport-cache-cell [] (-> (ptr CimportCacheCell))
  (primitive/alloc-static CimportCacheCell))

(defn cimport-cache [] (-> (ptr CimportCacheCell))
  (let [cell (cimport-cache-cell)]
    (unless (.ready cell)
      (set! (.entries cell)
            (HashMap::new [(slice u8) CimportCached]
                          (malloc-allocator)
                          (keyops)))
      (set! (.ready cell) true)
      0)
    cell))

;;; One length-prefixed field of a cache key, so no two requests share a key.
(defn cimport-key-field! [(out (mut StrBuf)) (text (slice u8))] (-> i64)
  (push-i64! (mut out) (len text))
  (push-str! (mut out) ":")
  (push-str! (mut out) text)
  0)

;;; The request as a cache key. The working directory is part of it: a relative
;;; header path and relative `-I` flags resolve against it.
(defn cimport-request-key [(a (dyn Allocator)) (r CimportRequest)]
  (-> (slice u8))
  (let [(mut out) (StrBuf::new a)]
    (cimport-key-field! (mut out) (cwd-slice a))
    (cimport-key-field! (mut out) (.path r))
    (cimport-key-field! (mut out) (.flags r))
    (cimport-key-field! (mut out) (.link r))
    (cimport-key-field! (mut out) (if (.use-present r) "use" ""))
    (cimport-key-field! (mut out) (if (.probe-only r) "probe-only" ""))
    (push-i64! (mut out) (len (load (.use-names r))))
    (for name (load (.use-names r)) (cimport-key-field! (mut out) name))
    (push-i64! (mut out) (len (load (.probes r))))
    (for probe (load (.probes r))
      (push-i64! (mut out) (ci/pkind probe))
      (for [which 0 4] (cimport-key-field! (mut out) (ci/pget probe which))))
    (str (load out))))

;;; The cached text for KEY, when every file it was generated from still has the
;;; digest recorded for it. A file that changed or went away means regenerate.
(defn cimport-cache-hit [(a (dyn Allocator)) (key (slice u8))]
  (-> (Option (slice u8)))
  (match (get (.entries (cimport-cache)) key)
    (None [] (None [(slice u8)]))
    (Some [cached]
          (if (ci/cimport-inputs-fresh? a (.inputs cached))
              (Some (.text cached))
              (None [(slice u8)])))))

;;; Record TEXT under KEY with the digests of DEPS. A dependency that cannot be
;;; read leaves the request uncached: its freshness could never be established.
(defn cimport-cache-store! [(a (dyn Allocator))
                            (key (slice u8))
                            (text (slice u8))
                            (deps (ptr (ArrayList (slice u8))))] (-> i64)
  (match (ci/cimport-inputs a deps)
    (None [] 0)
    (Some [inputs]
          (let [m (malloc-allocator)
                cache (cimport-cache)]
            (match (get (.entries cache) key)
              (Some [old]
                    (free [u8] m (.text old))
                    (ci/cimport-inputs-free! (.inputs old)))
              (None [] 0))
            (set! (mut (.entries cache))
                  key
                  (CimportCached :text (text/format m "{}" text) :inputs inputs))
            0))))

;;; Generated binding text, and every file clang read to generate it when that is
;;; known (None: not cacheable).
(defstruct CimportGenerated
  [(text (slice u8)) (deps (Option (ptr (ArrayList (slice u8)))))])

;;; Run the generator for R: its clang dumps, layout probes and folds. Probe
;;; values come first; a :probe-only request skips the header dump
;;; (structs/externs/#defines) and emits ONLY the probe consts, the
;;; ABI-extraction workflow. Its dependencies are listed only when WANT-DEPS: the
;;; header dump lists them as it runs, while a :probe-only request needs a clang
;;; run of its own for them.
(defn cimport-generate [(a (dyn Allocator)) (r CimportRequest) (want-deps bool)]
  (-> (Result CimportGenerated (slice u8)))
  (try (let [probes
               (try! (ci/cimport-probe a
                                       (.path r)
                                       (.flags r)
                                       (.probes r)
                                       (.link r)))]
         (if (.probe-only r)
             (Ok (CimportGenerated
                   :text (text/format a "(module cbindings)\n{}" probes)
                   :deps
                     (if want-deps
                         (match (ci/cimport-deps a (.path r) (.flags r))
                           (Ok [deps] (Some deps))
                           (Err [_] (None [(ptr (ArrayList (slice u8)))])))
                         (None [(ptr (ArrayList (slice u8)))]))))
             (let [deps
                     (box! a
                           (ArrayList (slice u8))
                           (ArrayList::new [(slice u8)] a))
                   hdr
                     (try! (ci/cimport-header-generate a
                                                       (.path r)
                                                       (.flags r)
                                                       (.use-names r)
                                                       (.use-present r)
                                                       deps))]
               (Ok (CimportGenerated
                     :text (sconcat a hdr probes)
                     :deps
                       (if want-deps
                           (Some deps)
                           (None [(ptr (ArrayList (slice u8)))])))))))))

;;; R's generated binding text, allocated in A. A request whose inputs are all
;;; known is served from the process cache while they are unchanged. A `:link`
;;; request is not: its probes link and run objects that the header's
;;; dependencies do not cover.
;;;
;;; Generation works in its own arena and only the text is copied out. Its clang
;;; JSON is the largest thing a compile allocates for C (tens of MB per header,
;;; parsed), and leaving it in the program's arena made every cimport of a load
;;; live at once.
(defn cimport-text [(a (dyn Allocator)) (r CimportRequest)]
  (-> (Result (slice u8) (slice u8)))
  (let [cacheable (= (len (.link r)) 0)
        key (cimport-request-key a r)]
    (match (if cacheable (cimport-cache-hit a key) (None [(slice u8)]))
      (Some [text] (Ok [(slice u8) (slice u8)] (text/format a "{}" text)))
      (None []
            (let [work (primitive/alloc-stack scratch/ScratchArena)
                  _init
                    (scratch/ScratchArena::init-with-capacity work
                                                              (retained-heap/compiler-scratch-parent)
                                                              1048576)
                  wa (allocator work)
                  result
                    (match (cimport-generate wa r cacheable)
                      (Err [e]
                           (Err [(slice u8) (slice u8)] (text/format a "{}" e)))
                      (Ok [generated]
                          (do
                            (match (.deps generated)
                              (Some [deps]
                                    (cimport-cache-store! wa
                                                          key
                                                          (.text generated)
                                                          deps))
                              (None [] 0))
                            (Ok [(slice u8) (slice u8)]
                                (text/format a "{}" (.text generated))))))]
              ; The compile path reaches cimport WITHOUT going through its CLI entry,
              ; so this is the only place its mid-compile clang files get swept.
              (ci/cimport-cleanup! wa)
              (close! work)
              result)))))

; `(cimport "header.h" [:flags […]] [:probe […]] [:link […]])` — generate C bindings
; via clang AT LOAD TIME and splice the externs/defstructs/consts + probe consts
; into the CURRENT module (dropping the generated `(module cbindings)` header).
;;; The header a `cimport` in a file under `base` names. A relative header is the
;;; package's: it resolves against the root of the package whose source roots hold
;;; the file, as that package's `[cc] sources` do, so a dependency's
;;; `(cimport "include/dep.h")` finds its own header whichever package is being
;;; built. A header that is not there (`stdio.h`, or one an `-I` flag finds), and
;;; any header in a file outside every package, is passed to clang as written.
(defn cimport-header-path [(a (dyn Allocator))
                           (base (slice u8))
                           (header (slice u8))] (-> (slice u8))
  (let [pkgs (project-packages a)]
    (if (or (= (primitive/cast i64 pkgs) 0)
            (= (len header) 0)
            (= (primitive/cast i64 (get header 0)) 47))
        header
        (let [dir (match (realpath-opt a base) (Some [d] d) (None [] base))
              (mut best) ""
              (mut depth) -1]
          (for [i 0 (len (load pkgs))]
            (let [p (elem pkgs i)]
              (for [j 0 (len (load (.roots p)))]
                (let [root (get (load (.roots p)) j)]
                  (when (and (> (len root) (load depth))
                             (dep-path-contained? root dir))
                    (set! depth (len root))
                    (set! best (.manifest p))
                    0))
                0))
            0)
          (if (= (len (load best)) 0)
              header
              (match (realpath-opt a (path-join a (dirname (load best)) header))
                (Some [abs] abs)
                (None [] header)))))))

(defn process-cimport [(s (mut LS))
                       (form (ptr Sexp))
                       (base (slice u8))
                       (cur (Option (slice u8)))] (-> i64)
  (let [a (.a s)
        items (l-as-list form)
        nit (len (load items))]
    (if (< nit 2)
        (ls-set-err! (mut s)
                     (diag-at-form form
                                   "cimport: expected (cimport \"header.h\")"))
        (let [(mut it) (: (get (load items) 1) Sexp)]
          (match (l-as-str (mut it))
            (None []
                  (ls-set-err! (mut s)
                               (diag-at-form form
                                             "cimport: expected a string header path")))
            (Some [path]
                  (if (and (has-kw? items nit "probe")
                           (> (len (.cross_target (loader-unit-state))) 0))
                      ; Probe values come from running a program on this host; handing
                      ; them to another target would be silently wrong.
                      (ls-set-err! (mut s)
                                   (diag-at-form form
                                                 (text/format a
                                                              "cimport :probe runs a program on this machine, so it cannot supply C values for --target {}; select per-target values with (target-arch) and (target-os)"
                                                              (.cross_target (loader-unit-state)))))
                      (let [rtext
                              (cimport-text a
                                            (CimportRequest
                                              :path
                                                (cimport-header-path a
                                                                     base
                                                                     path)
                                              :flags
                                                (cimport-kwstr a
                                                               items
                                                               nit
                                                               "flags")
                                              :use-present
                                                (has-kw? items nit "use")
                                              :use-names
                                                (cimport-use-names a items nit)
                                              :probes
                                                (cimport-probes a items nit)
                                              :link
                                                (cimport-kwstr a
                                                               items
                                                               nit
                                                               "link")
                                              :probe-only
                                                (has-kw? items nit "probe-only")))]
                        (match rtext
                          (Err [e] (ls-set-err! (mut s) (diag-at-form form e)))
                          (Ok [text]
                              (let [sid (.srccount s)
                                    _1
                                      (set! (.srccount s)
                                            (primitive/iadd sid 1))
                                    _2
                                      (register-source! (mut s)
                                                        (text/format a
                                                                     "<cimport {}"
                                                                     path)
                                                        text)]
                                (match (read-source-forms a text sid)
                                  (Err [d]
                                       (ls-set-err! (mut s)
                                                    (diag-at-form form
                                                                  "cimport: generated bindings failed to parse")))
                                  (Ok [gforms]
                                      (let [gn (len (load gforms))]
                                        (for [k 0 gn]
                                          (let [(mut gf)
                                                  (: (get (load gforms)
                                                          k)
                                                     Sexp)]
                                            (match (l-list-head (mut gf))
                                              (Some [gh]
                                                    (unless (= gh
                                                               "module")
                                                      ; The bindings' own imports (the
                                                      ; layouts they name) become the
                                                      ; importing module's, as written.
                                                      (when (= gh
                                                               "import")
                                                        (process-import (mut s)
                                                                        (mut gf)
                                                                        ""
                                                                        cur)
                                                        0)
                                                      (push! (mut (.out s))
                                                             (mk-tagged gf cur))))
                                              (None []
                                                    (push! (mut (.out s))
                                                           (mk-tagged gf cur))))))
                                        0))))))))))))))

; ── include-str: compile-time file embed, resolved at LOAD time ───────────────
; Each file's forms are walked as it is loaded (EVERY file, always — no dependence
; on the macro-expansion pass), and each `(include-str "rel")` is replaced by a
; string literal of the file's bytes. `rel` resolves relative to the INCLUDING
; file's own directory. A missing file or a
; non-literal path is a hard load error — never a silent empty embed.
(defn incl-is-include-str [(items (ptr (ArrayList Sexp)))] (-> bool)
  (and (>= (sx-len items) 1)
       (and (= (sx-tag (sx-at items 0)) 2)
            (= (sx-sval (sx-at items 0)) "include-str"))))

(defn incl-read [(a (dyn Allocator)) (dir (slice u8)) (rel (slice u8))]
  (-> (Option (slice u8)))
  (read-file-opt a (to-cstr a (path-join a dir rel))))

(defn do-include-str [(s (mut LS)) (f (ptr Sexp)) (dir (slice u8))] (-> Sexp)
  (let [a (.a s)
        items (sx-items (load f))]
    (if (!= (sx-len items) 2)
        (do
          (ls-set-err! (mut s)
                       (diag-at-form f
                                     "include-str: expects exactly one string-literal path argument"))
          (load f))
        (let [arg (sx-at items 1)]
          (if (!= (sx-tag arg) 4)
              (do
                (ls-set-err! (mut s)
                             (diag-at-form f
                                           "include-str: path must be a string literal"))
                (load f))
              (let [rel (sx-sval arg)]
                (match (incl-read a dir rel)
                  (Some [text]
                        (let [inputs (.artifact_inputs (loader-unit-state))]
                          (unless (= (primitive/cast i64 inputs) 0)
                            (push! inputs
                                   (LoaderArtifactInput
                                     :path
                                       (path-join (unit-allocator)
                                                  dir
                                                  rel)
                                     :text
                                       (text/format (unit-allocator) "{}" text)))
                            0)
                          (mk-sexp-src (KStr text) f)))
                  (None []
                        (do
                          (ls-set-err! (mut s)
                                       (diag-at-form f
                                                     (text/format a
                                                                  "include-str: cannot read file '{}' (relative to the including file)"
                                                                  rel)))
                          (load f))))))))))

; ── depends-on: files a module was made from, beyond its imports ─────────────
; `(depends-on "path" ...)`: each path is absolute or relative to the declaring
; file's directory. A reader that reads files of its own (the C reader's sources
; and headers) lists them, so a prebuilt unit or reader artifact built from its
; output is stale when one of them changes. The file's bytes are recorded as read
; now, like include-str's; a missing file is a hard load error.
(defn handle-depends-on [(s (mut LS)) (f (ptr Sexp)) (dir (slice u8))] (-> i64)
  (let [a (.a s)
        items (sx-items (load f))]
    (for [i 1 (sx-len items)]
      (let [arg (sx-at items i)]
        (if (!= (sx-tag arg) 4)
            (ls-set-err! (mut s)
                         (diag-at-form f
                                       "depends-on: every path must be a string literal"))
            (let [rel (sx-sval arg)
                  path
                    (if (and (> (len rel) 0)
                             (= (primitive/cast i64 (get rel 0)) 47))
                        rel
                        (path-join a dir rel))]
              (match (read-file-opt a (to-cstr a path))
                (None []
                      (ls-set-err! (mut s)
                                   (diag-at-form f
                                                 (text/format a
                                                              "depends-on: cannot read '{}'"
                                                              path))))
                (Some [text]
                      (let [inputs (.artifact_inputs (loader-unit-state))]
                        (unless (= (primitive/cast i64 inputs) 0)
                          (push! inputs
                                 (LoaderArtifactInput
                                   :path
                                     (text/format (unit-allocator) "{}" path)
                                   :text
                                     (text/format (unit-allocator) "{}" text)))
                          0)
                        0))))))
      0)
    0))

(defn form-has-include-str [(f (ptr Sexp))] (-> bool)
  (let [tg (sx-tag (load f))]
    (if (and (= tg 6)
             (incl-is-include-str (sx-items (load f))))
        true
        (if (or (= tg 6) (= tg 7))
            (let [items (sx-items (load f))
                  n (sx-len items)
                  (mut i) 0
                  (mut r) false]
              (loop (if (or (load r) (>= (load i) n))
                        (break)
                        (do
                          (when (form-has-include-str (elem items
                                                            (load i)))
                            (set! r true)
                            0)
                          (set! i (primitive/iadd (load i) 1)))))
              (load r))
            false))))

(defn expand-includes-in-form [(s (mut LS)) (f (ptr Sexp)) (dir (slice u8))]
  (-> Sexp)
  (let [a (.a s)
        tg (sx-tag (load f))]
    (if (and (= tg 6)
             (incl-is-include-str (sx-items (load f))))
        (do-include-str (mut s) f dir)
        (if (or (= tg 6) (= tg 7))
            (let [items (sx-items (load f))
                  n (sx-len items)
                  (mut out) (ArrayList::new [Sexp] a)]
              (for [i 0 n]
                (push! (mut out)
                       (expand-includes-in-form (mut s)
                                                (elem items
                                                      i)
                                                dir)))
              (if (= tg 6)
                  (mk-sexp-src (KList (box-al a (load out))) f)
                  (mk-sexp-src (KVec (box-al a (load out))) f)))
            (load f)))))

; Source spelling uses `alias/name`. A dotted name is the compiler's canonical,
; post-resolution representation and must never be accepted as an alias escape hatch
; in authored code. Validate while the original Sexp and import table are both still
; available; generated hygienic names and oracle intermediate forms never pass here
; with an authored `:as` alias, while dotted C extern names remain ordinary symbols.
(defn loader-find-dot [(name (slice u8))] (-> i64)
  (let [(mut i) 0
        (mut found) -1]
    (loop (if (>= (load i) (len name))
              (break)
              (if (= (primitive/cast i64 (get name (load i)))
                     46)
                  (do (set! found (load i)) (break))
                  (set! i (primitive/iadd (load i) 1)))))
    (load found)))

(defn dotted-alias-diag [(s (mut LS))
                         (node (ptr Sexp))
                         (module (Option (slice u8)))] (-> (Option Diag))
  (let [tg (sx-tag (load node))]
    (if (= tg 2)
        (let [name (sx-sval (load node))
              dot (loader-find-dot name)]
          (if (< dot 0)
              (None [Diag])
              (match module
                (None [] (None [Diag]))
                (Some [m]
                      (let [impe (imports-find (field s imports) m)
                            alias (subslice name 0 dot)]
                        (if (= (primitive/cast i64 impe) 0)
                            (None [Diag])
                            (match (alias-target impe alias)
                              (None [] (None [Diag]))
                              (Some [_]
                                    (let [rest
                                            (subslice name
                                                      (primitive/iadd dot 1)
                                                      (len name))
                                          replacement
                                            (text/format (.a s)
                                                         "{}/{}"
                                                         alias
                                                         rest)]
                                      (Some (diag-at-form node
                                                          (text/format (.a s)
                                                                       "dotted module qualification is not valid; use '{}'"
                                                                       replacement))))))))))))
        (if (or (= tg 6) (= tg 7))
            ; quote/quasiquote bodies are Code data, not authored references. Macro
            ; hygiene deliberately uses canonical dotted symbols inside that data.
            (if (and (= tg 6)
                     (match (l-list-head node)
                       (Some [h] (or (= h "quote") (= h "quasiquote")))
                       (None [] false)))
                (None [Diag])
                (let [items (sx-items (load node))
                      (mut i) 0
                      (mut out) (None [Diag])]
                  (loop (if (or (>= (load i) (sx-len items)) (some? (load out)))
                            (break)
                            (do
                              (set! out
                                    (dotted-alias-diag (mut s)
                                                       (elem items
                                                             (load i))
                                                       module))
                              (set! i (primitive/iadd (load i) 1)))))
                  (load out)))
            (None [Diag])))))

(defn push-checked-form! [(s (mut LS)) (form Sexp) (module (Option (slice u8)))]
  (-> i64)
  (let [(mut fp) (: form Sexp)]
    (match (dotted-alias-diag (mut s) (mut fp) module)
      (Some [d] (ls-set-err! (mut s) d))
      (None [] (push! (mut (.out s)) (mk-tagged form module)))))
  0)

(defn register-primitive! [(s (mut LS))
                           (f (ptr Sexp))
                           (module (Option (slice u8)))] (-> i64)
  (match module
    (None []
          (ls-set-err! (mut s)
                       (diag-at-form f
                                     "defprimitive requires a module declaration")))
    (Some [m]
          (let [items (sx-items (load f))
                n (sx-len items)]
            (if (< n 3)
                (ls-set-err! (mut s)
                             (diag-at-form f
                                           "defprimitive: expected a name and :opcode"))
                (let [namef (sx-at items 1)
                      opf (sx-at items (primitive/isub n 1))]
                  (if (or (!= (sx-tag namef) 2)
                          (!= (sx-tag opf) 3))
                      (ls-set-err! (mut s)
                                   (diag-at-form f
                                                 "defprimitive: expected (defprimitive NAME ... :OPCODE)"))
                      (match (primitive-answer-of (mut s)
                                                  f
                                                  items
                                                  m
                                                  (sx-sval opf))
                        (Err [d] (ls-set-err! (mut s) d))
                        (Ok [result]
                            (let [(mut p) (zeroed PrimitiveDef)]
                              (set! (.module p) m)
                              (set! (.name p) (sx-sval namef))
                              (set! (.opcode p) (sx-sval opf))
                              (set! (.result p) result)
                              (push! (mut (.primitive_defs s)) p))))))))))
  0)

;;; The sum a `defprimitive` declares its code operation answers with, qualified in
;;; MODULE: `(defprimitive resolve-at [(node Code) (name Code)] (-> Resolution)
;;; :resolve-at)` answers with MODULE.Resolution. Empty when the declaration names
;;; no sum. A `(-> TYPE)` whose TYPE is not a bare name, as alloc-stack's
;;; `(-> (ptr T))`, describes the primitive to a reader and is not read here.
(defn primitive-answer-of [(s (mut LS))
                           (f (ptr Sexp))
                           (items (ptr (ArrayList Sexp)))
                           (module (slice u8))
                           (opcode (slice u8))] (-> (Result (slice u8) Diag))
  (let [n (sx-len items)
        (mut out) ""
        (mut err) (None [Diag])]
    (for [i 2 (primitive/isub n 1)]
      (let [item (sx-at items i)]
        (when (and (= (sx-tag item) 6)
                   (and (= (sx-len (sx-items item)) 2)
                        (and (= (sx-tag (sx-at (sx-items item) 0)) 2)
                             (and (= (sx-sval (sx-at (sx-items item) 0)) "->")
                                  (= (sx-tag (sx-at (sx-items item) 1)) 2)))))
          (if (> (len (load out)) 0)
              (set! err
                    (Some (diag-at-form f
                                        "defprimitive: more than one answer type")))
              (set! out
                    (text/format (.a s)
                                 "{}.{}"
                                 module
                                 (sx-sval (sx-at (sx-items item) 1)))))
          0)))
    (match (load err)
      (Some [d] (Err [(slice u8) Diag] d))
      (None []
            (if (and (> (len (load out)) 0) (< (codeop-number opcode) 0))
                (Err [(slice u8) Diag]
                     (diag-at-form f
                                   "defprimitive: only a compile-time code operation answers with a declared sum"))
                (Ok [(slice u8) Diag] (load out)))))))

; `(def NAME TARGET)` is a definition alias. Primitive identity is followed through
; this alias by the resolver; no wrapper function or generated call is involved.
(defn register-primitive-alias! [(s (mut LS))
                                 (f (ptr Sexp))
                                 (module (Option (slice u8)))] (-> i64)
  (match module
    (None []
          (ls-set-err! (mut s)
                       (diag-at-form f "def requires a module declaration")))
    (Some [m]
          (let [items (sx-items (load f))]
            (if (!= (sx-len items) 3)
                (ls-set-err! (mut s)
                             (diag-at-form f "def: expected (def NAME TARGET)"))
                (let [namef (sx-at items 1)
                      targetf (sx-at items 2)]
                  (if (or (!= (sx-tag namef) 2)
                          (!= (sx-tag targetf) 2))
                      (ls-set-err! (mut s)
                                   (diag-at-form f
                                                 "def: NAME and TARGET must be symbols"))
                      (let [(mut p) (zeroed PrimitiveAlias)]
                        (set! (.module p) m)
                        (set! (.name p) (sx-sval namef))
                        (set! (.target p) (sx-sval targetf))
                        (push! (mut (.primitive_aliases s)) p))))))))
  0)

; The historical `(def NAME TARGET)` alias remains loader syntax only when both
; operands are symbols. Every other `def` is an ordinary runtime value form and
; must survive into expansion and parsing.
(defn definition-alias? [(f (ptr Sexp))] (-> bool)
  (let [items (sx-items (load f))]
    (and (= (sx-len items) 3)
         (and (= (sx-tag (sx-at items 1)) 2)
              (= (sx-tag (sx-at items 2)) 2)))))

(defn process-forms [(s (mut LS))
                     (forms (ptr (ArrayList Sexp)))
                     (base (slice u8))
                     (cur0 (Option (slice u8)))] (-> i64)
  (let [a (.a s)
        _fold (loader-casefold-scheme! a forms)
        n (len (load forms))
        (mut cur) (None [(slice u8)])
        (mut i) 0]
    (set! cur cur0)
    ; Bail the moment the loader records an error (this file's import failed, or a
    ; nested imported file's did): stop processing further forms so the first
    ; diagnostic is the one reported.
    (loop (if (or (>= (load i) n) (ls-err? (mut s)))
              (break)
              (do
                (let [(mut f) (: (get (load forms) (load i)) Sexp)]
                  (match (l-list-head (mut f))
                    (Some [h]
                          (cond (= h "module")
                                  (match (module-name-opt (mut f))
                                    (Some [name]
                                          (do
                                            (imp-entry (mut s) name)
                                            ; Later forms (a later module in the same
                                            ; submitted source) may import it by name.
                                            (loaded-insert! (mut s) name)
                                            (set! cur (Some name))
                                            0))
                                    (None []
                                          (ls-set-err! (mut s)
                                                       (diag-at-form (mut f)
                                                                     "module: expected (module NAME)"))))
                                (= h "export")
                                  (match (dotted-alias-diag (mut s)
                                                            (mut f)
                                                            (load cur))
                                    (Some [d] (ls-set-err! (mut s) d))
                                    (None []
                                          (do
                                            (handle-export (mut s)
                                                           (mut f)
                                                           (load cur))
                                            ; Like import, export is declaration syntax a
                                            ; transform must be able to inspect and preserve.
                                            ; The parser ignores it after declaration tables
                                            ; have been rebuilt from transformed forms.
                                            (push-checked-form! (mut s)
                                                                f
                                                                (load cur)))))
                                (= h "provide-core")
                                  ; Loader declaration syntax: it shapes the provider's
                                  ; export table but emits no runtime form of its own.
                                  (handle-provide-core (mut s)
                                                       (mut f)
                                                       (load cur))
                                (= h "import")
                                  (match (load cur)
                                    (Some [m]
                                          (do
                                            (process-import (mut s)
                                                            (mut f)
                                                            base
                                                            (load cur))
                                            ; An import is part of the module's source, so a
                                            ; metaprogram must be able to SEE it: a transform is
                                            ; handed the program and asks questions of it, and
                                            ; "which namespaces does this module import?" is one
                                            ; of the most basic. Processing it into the import
                                            ; tables AND dropping it from the forms made every
                                            ; such question unanswerable — a dialect could not
                                            ; tell which modules had opted into it, with no
                                            ; diagnostic, because the marker it looked for had
                                            ; silently ceased to exist.
                                            ;
                                            ; Keeping it is inert downstream: the import has
                                            ; already been processed here, and later phases
                                            ; ignore the form.
                                            (push-checked-form! (mut s)
                                                                f
                                                                (load cur))))
                                    (None []
                                          (ls-set-err! (mut s)
                                                       (diag-at-form (mut f)
                                                                     "import requires a (module …) declaration: add one (e.g. `(module app)`) at the top of the file, before any imports — otherwise imported types and functions cannot be resolved"))))
                                (= h "cimport")
                                  (if (defer-cimport?)
                                      0
                                      (process-cimport (mut s)
                                                       (mut f)
                                                       base
                                                       (load cur)))
                                (= h "defprimitive")
                                  (register-primitive! (mut s)
                                                       (mut f)
                                                       (load cur))
                                (= h "def")
                                  (if (definition-alias? (mut f))
                                      (register-primitive-alias! (mut s)
                                                                 (mut f)
                                                                 (load cur))
                                      (push-checked-form! (mut s) f (load cur)))
                                (= h "depends-on")
                                  ; Loader declaration syntax: files this module was made
                                  ; from that no import names (a reader's C sources and
                                  ; headers). They key prebuilt units and reader artifacts;
                                  ; the form emits nothing.
                                  (handle-depends-on (mut s)
                                                     (mut f)
                                                     base)
                                (= h "reader-provider") 0
                                (form-has-include-str (mut f))
                                  (push-checked-form! (mut s)
                                                      (expand-includes-in-form (mut s)
                                                                               (mut f)
                                                                               base)
                                                      (load cur))
                                :else (push-checked-form! (mut s) f (load cur))))
                    (None [] (push-checked-form! (mut s) f (load cur)))))
                (set! i (primitive/iadd (load i) 1)))))
    0))

; How many reexport edges `coil.core` already has. Everything appended after this
; point comes from a provider, and that tail is what resolution searches in reverse.
; Validate and register the explicit contribution list after a provider module has
; been read. Ambient assembly never uses manifest order as shadowing precedence.
(defn register-core-provider! [(s (mut LS)) (name (slice u8)) (root bool)]
  (-> i64)
  (let [a (.a s)]
    (if (not (set-contains (field s core_declared_modules) name))
        (ls-set-err! (mut s)
                     (derr (text/format a
                                        "core provider '{}' does not declare (provide-core [names] ...)"
                                        name)))
        ; Ambient core is ORDERED: a name contributed twice is an override, not a
        ; clash, and the registry keeps every contribution in activation order for
        ; resolution to read backwards.
        (let [n (core-decl-count)
              (mut i) 0]
          (loop (if (>= (load i) n)
                    (break)
                    (do
                      (when (= (core-decl-module-at (load i)) name)
                        (core-contribution-add! (core-decl-name-at (load i))
                                                name
                                                root)
                        0)
                      (set! i (primitive/iadd (load i) 1))))))))
  0)

; Load one root-activated provider. A plain import, NOT `:reexport`: a reexport
; edge would make every top-level definition in the provider ambient, because the
; edge is filtered by the export table and a `provide-core` list never reaches it.
; Loading the module is all that is needed -- ambient lookup goes through the
; contribution registry and resolves within the owning module directly.
(defn load-core-provider! [(s (mut LS)) (name (slice u8)) (root bool)] (-> i64)
  (let [a (.a s)
        text (text/format a "(module coil.core)\n(import \"{}\")\n" name)
        source-id (.srccount s)
        _next (set! (.srccount s) (primitive/iadd source-id 1))
        display (text/format a "<core-provider {}>" name)
        _reg (register-source! (mut s) display text)]
    (match (read-source-forms a text source-id)
      (Err [d] (ls-set-err! (mut s) d))
      (Ok [pf] (process-forms (mut s) pf "" (None [(slice u8)]))))
    (unless (ls-err? (mut s)) (register-core-provider! (mut s) name root) 0)
    0))

; COIL_CORE_PROVIDERS is newline-delimited and owned by the root manifest. Child
; project commands inherit the frozen value, preventing a dependency from adding
; ambient names merely by declaring its own provider list.
(defn load-core-providers! [(s (mut LS))] (-> i64)
  (let [a (.a s)
        rawp (unit-getenv (to-cstr a "COIL_CORE_PROVIDERS"))]
    ; Built-in conveniences are ordinary explicit providers too. The profile
    ; selects them before root additions, so a root provider naming the same
    ; name overrides the built-in.
    (when (bundled-stdlib-enabled? a)
      ; `derive` is definition syntax in every bundled profile. Loading its
      ; provider makes the original macro ambient directly, preserving call-site
      ; provenance while keeping implementation helpers out of core.
      (load-core-provider! (mut s) "coil.derive" false)
      ; Collection pipelines are ordinary trait-based library definitions, but
      ; their everyday public vocabulary is ambient like Clojure's sequence API.
      ; A provider keeps that surface explicit and avoids making the bootstrapped
      ; compiler prelude depend on the current stdlib's syntax.
      (unless (ls-err? (mut s))
        (load-core-provider! (mut s) "coil.iter" false)
        0)
      (unless (ls-err? (mut s))
        (if (= (stdlib-profile a) "hermetic")
            (load-core-provider! (mut s) "coil.assert.hermetic" false)
            (do
              (load-core-provider! (mut s) "coil.print" false)
              (unless (ls-err? (mut s))
                (load-core-provider! (mut s) "coil.fmt" false)
                0)
              (unless (ls-err? (mut s))
                (load-core-provider! (mut s) "coil.assert" false)
                0)
              (unless (ls-err? (mut s))
                (load-core-provider! (mut s) "coil.panic" false)
                0)))
        0)
      0)
    (when (!= (primitive/cast i64 rawp) 0)
      (let [raw (from-cstr rawp)
            n (len raw)
            (mut lo) 0
            (mut i) 0]
        (loop (if (or (> (load i) n) (ls-err? (mut s)))
                  (break)
                  (if (or (= (load i) n)
                          (= (primitive/cast i64 (get raw (load i)))
                             10))
                      (do
                        (when (> (load i) (load lo))
                          (load-core-provider! (mut s)
                                               (subslice [u8]
                                                         raw
                                                         (load lo)
                                                         (load i))
                                               true)
                          0)
                        (set! lo (primitive/iadd (load i) 1))
                        (set! i (primitive/iadd (load i) 1)))
                      (set! i (primitive/iadd (load i) 1)))))))
    0))

(defn predeclare-entry-core-provider! [(s (mut LS))
                                       (forms (ptr (ArrayList Sexp)))] (-> i64)
  (match (declared-module forms)
    (None [] 0)
    (Some [module]
          (for [i 0 (len (load forms))]
            (let [f (elem forms i)]
              (match (l-list-head f)
                (Some [head]
                      (when (= head "provide-core")
                        (handle-provide-core (mut s) f (Some module))
                        0))
                (None [] 0))))))
  0)

;;; Load FORMS as the entry program. Its cimports share one load's clang work per
;;; header (`ci/cimport-load-begin!`).
(defn load-program-in-module [(s (mut LS))
                              (forms (ptr (ArrayList Sexp)))
                              (base (slice u8))
                              (module (Option (slice u8)))] (-> i64)
  (ci/cimport-load-begin!)
  (let [r (load-program-in-module-run (mut s) forms base module)]
    (ci/cimport-load-end!)
    r))

(defn load-program-in-module-run [(s (mut LS))
                                  (forms (ptr (ArrayList Sexp)))
                                  (base (slice u8))
                                  (module (Option (slice u8)))] (-> i64)
  (let [a (.a s)]
    ; Pre-register the MAIN file's module as loaded: compiling a
    ; stdlib file directly must not ALSO pull the bundled copy of the same
    ; module in through the prelude's import chain (the module would collect
    ; twice — "duplicate impl", silent last-wins for functions).
    (match (declared-module forms)
      (Some [main-mod]
            (do
              (loaded-insert! (mut s) main-mod)
              (set! (.entry_module s) main-mod)
              ; and the compilation's, which the LS its expansion derives share
              (set! (.entry_module (semantic-workspace (mut s))) main-mod)
              0))
      (None [] 0))
    (if (bundled-stdlib-enabled? a)
        ; The bundled prelude comes from the same toolchain layout as every bundled
        ; module and resolves its imports against the bundled sentinel.
        (let [prelude-text (stdlib-prelude-text a)
              prelude-id (.srccount s)
              _next (set! (.srccount s) (primitive/iadd prelude-id 1))
              _reg (register-source! (mut s) "<prelude>" prelude-text)]
          (try (let [pf
                       (try-or! (read-source-forms a prelude-text prelude-id)
                                (do (loader-abort "read error in prelude") 0))]
                 (process-forms (mut s) pf (bundled-base) (None [(slice u8)])))))
        ; A replacement prelude is an ordinary indexed project/dependency module.
        ; It receives no privileged path resolution and therefore cannot reach the
        ; bundled manifests while the compilation universe is sealed.
        (let [name (implicit-prelude-name a)
              (mut probe) (: (zeroed Sexp) Sexp)]
          (match (namespace-path a (mut s) (mut probe) name)
            (None []
                  (unless (ls-err? (mut s))
                    (ls-set-err! (mut s)
                                 (derr (text/format a
                                                    "replacement prelude module '{}' was not found"
                                                    name)))
                    0))
            (Some [path]
                  (let [prelude-text (read-file a (to-cstr a path))
                        prelude-id (.srccount s)
                        _next (set! (.srccount s) (primitive/iadd prelude-id 1))
                        _reg (register-source! (mut s) path prelude-text)]
                    (match (read-source-forms a prelude-text prelude-id)
                      (Err [d] (ls-set-err! (mut s) d))
                      (Ok [pf]
                          (match (declared-module pf)
                            (Some [decl]
                                  (if (= decl name)
                                      (process-forms (mut s)
                                                     pf
                                                     (dirname path)
                                                     (None [(slice u8)]))
                                      (ls-set-err! (mut s)
                                                   (derr (text/format a
                                                                      "replacement prelude path declares module '{}', expected '{}'"
                                                                      decl
                                                                      name)))))
                            (None []
                                  (ls-set-err! (mut s)
                                               (derr (text/format a
                                                                  "replacement prelude module '{}' has no module declaration"
                                                                  name))))))))))))
    (core-providers-reset!)
    (core-decls-reset!)
    (unless (ls-err? (mut s)) (predeclare-entry-core-provider! (mut s) forms) 0)
    (unless (ls-err? (mut s)) (load-core-providers! (mut s)) 0)
    (unless (ls-err? (mut s))
      (process-forms (mut s) forms base module)
      0)
    0))

(defn load-program [(s (mut LS))
                    (forms (ptr (ArrayList Sexp)))
                    (base (slice u8))] (-> i64)
  (load-program-in-module (mut s) forms base (None [(slice u8)])))

; Load a SET of namespaces as the roots of one program: the prelude, then
; `forms` (a command's own inputs, such as lint's `--use` imports), then every
; named module and, through their imports, whatever they reach. This is what
; "the whole project" means to lint and check: there is no entry file, so none
; is invented to import the others, and nothing can be reported at a file that
; does not exist. A problem that belongs to one module — a namespace declared by
; two files, a file that does not parse — is appended to `diags`, anchored in the
; file itself, and that module is left out so every other one still loads.
; Returns how many were left out. An error inside a module's own import graph
; still sets the loader's first-error slot and stops the load, as it does for an
; entry file.
(defn load-namespace-set! [(s (mut LS))
                           (forms (ptr (ArrayList Sexp)))
                           (names (ptr (ArrayList (slice u8))))
                           (base (slice u8))
                           (diags (ptr (ArrayList Diag)))] (-> i64)
  (ci/cimport-load-begin!)
  (let [skipped (load-namespace-set-run! (mut s) forms names base diags)]
    (ci/cimport-load-end!)
    skipped))

(defn load-namespace-set-run! [(s (mut LS))
                               (forms (ptr (ArrayList Sexp)))
                               (names (ptr (ArrayList (slice u8))))
                               (base (slice u8))
                               (diags (ptr (ArrayList Diag)))] (-> i64)
  (let [a (.a s)
        n (len (load names))
        (mut skipped) 0
        (mut i) 0]
    (load-program (mut s) forms base)
    (loop (if (or (>= (load i) n) (ls-err? (mut s)))
              (break)
              (let [name (get (load names) (load i))
                    paths (namespace-paths-for a (mut s) name)
                    np (len (load paths))]
                (cond (= np 0)
                        (do
                          (push! diags
                                 (derr (text/format a
                                                    "namespace '{}' is not in the namespace index"
                                                    name)))
                          (set! skipped (primitive/iadd (load skipped) 1))
                          0)
                      (> np 1)
                        ; Reported once, at the first declaring file's module
                        ; header; the message names every other file.
                        (let [path (get (load paths) 0)
                              text (read-file a (to-cstr a path))
                              sid (.srccount s)
                              _next (set! (.srccount s) (primitive/iadd sid 1))
                              _reg (register-source! (mut s) path text)
                              at (module-header-offset text)
                              lo (if (< at 0) 0 at)
                              hi
                                (if (< at 0)
                                    0
                                    (primitive/iadd at 7))]
                          (push! diags
                                 (derr-at-src sid
                                              lo
                                              hi
                                              (duplicate-namespace-message a
                                                                           name
                                                                           paths)))
                          (set! skipped (primitive/iadd (load skipped) 1))
                          0)
                      :else
                        (let [path (get (load paths) 0)]
                          (match (read-memo-find (mut s) path)
                            ; Reached already through an earlier module's imports.
                            (Some [_] 0)
                            (None []
                                  (let [text (read-file a (to-cstr a path))
                                        sid (.srccount s)
                                        _next
                                          (set! (.srccount s)
                                                (primitive/iadd sid 1))
                                        _reg
                                          (register-source! (mut s) path text)]
                                    (match (read-module-forms! (mut s)
                                                               (primitive/cast (ptr Sexp)
                                                                               0)
                                                               path
                                                               text
                                                               sid
                                                               name)
                                      (Err [d]
                                           (do
                                             (push! diags d)
                                             (set! skipped
                                                   (primitive/iadd (load skipped)
                                                                   1))
                                             0))
                                      (Ok [mod-forms]
                                          (let [modname
                                                  (match (declared-module mod-forms)
                                                    (Some [m] m)
                                                    (None [] name))]
                                            (read-memo-add! (mut s)
                                                            path
                                                            modname)
                                            (when (loaded-insert! (mut s)
                                                                  modname)
                                              (process-forms (mut s)
                                                             mod-forms
                                                             (dirname path)
                                                             (None [(slice u8)])))
                                            0))))))))
                (set! i (primitive/iadd (load i) 1)))))
    (load skipped)))

; ============================ resolve representation =======================
; Mirrors. `Defs` = a module's definition names split by namespace
; (HashSets become ArrayLists, membership = linear `=` scan). `DefTable` =
; per-module Defs (ArrayList of DefEntry). `ParsedForm` = one tagged form parsed
; into its own Program, retaining its module identity.
; `Defs` sets are BY-VALUE ArrayLists so names can be pushed via (primitive/field …).)

;;; A metaprogram closure inherits the retained compiler ABI as well as the
;;; application's checked environment. Neither is reconstructed from source.
(defn ls-meta-parent [(s (mut LS))] (-> (ptr LS))
  (let [parent (.parent s)]
    (if (= (primitive/cast i64 parent) 0)
        parent
        (if (= (primitive/cast i64 (.meta_environment parent)) 0)
            parent
            (.meta_environment parent)))))
