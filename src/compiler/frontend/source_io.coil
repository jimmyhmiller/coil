; src/compiler/frontend/source_io.coil — self-host Coil compiler: reading source
; files, through the overlay `coil lint --fix` uses to try a rewrite without writing it.

(module coil.compiler.source_io)
(import "coil.primitive" :as primitive)
(import "coil.alloc" :use *)
(import "coil.result" :use *)
(import "coil.slice" :use *)
(import "coil.str" :use *)
(import "coil.arraylist" :use *)
(import "coil.io" :use *)
(import "coil.compiler.unit_state" :use *)
(import "coil.compiler.ffi" :use *)
(import "coil.scratch" :as scratch)
(import "coil.compiler.large_pages" :as large-pages)
(import "coil.compiler.paths" :use *)

;;; TEXT copied into A.
(defn copy-text [(a (dyn Allocator)) (text (slice u8))] (-> (slice u8))
  (match (concat a text "") (Some [v] v) (None [] "")))

;;; Everything an open FD holds, in one allocation of its exact size from A. The
;;; reads go through a stack buffer into a scratch arena, so A holds no bounce buffer
;;; and none of the copies a growing list leaves behind.
(defn read-fd-exact [(a (dyn Allocator)) (fd i32)] (-> (slice u8))
  (let [work (primitive/alloc-stack scratch/ScratchArena)
        buf (primitive/cast (ptr i8) (primitive/alloc-stack (array u8 65536)))]
    (scratch/ScratchArena::init work (large-pages/compiler-scratch-parent))
    (let [(mut bytes) (ArrayList::new [u8] (allocator work))]
      (loop (let [n (read fd buf 65536)]
              (if (<= n 0)
                  (break)
                  (extend! (mut bytes) (primitive/cast (ptr u8) buf) (primitive/cast i64 n)))))
      (let [out (copy-text a (slice (load bytes)))]
        (close! work)
        out))))

; ---- the source overlay ---------------------------------------------------------
; Text a command holds for a file in place of the file's bytes. `coil lint --fix`
; and `--diff` analyse the rewrites they propose through it: every read of a
; source file (`read-file`, `read-file-opt`) during the run sees the proposed
; text, and the file itself is never written to try one. Entries are keyed by real
; path, so a relative or symlinked spelling of the same file reads the same text.
; Empty except while such a command runs; the texts belong to it.
(defstruct SourceOverlayEntry [(key (slice u8)) (text (slice u8))])

(defstruct SourceOverlay [(ready bool) (entries (ArrayList SourceOverlayEntry))])

(defn source-overlay [] (-> (ptr SourceOverlay))
  (let [o (primitive/alloc-static SourceOverlay)]
    (unless (.ready o)
      (set! (.entries o) (ArrayList::new [SourceOverlayEntry] (malloc-allocator)))
      (set! (.ready o) true)
      0)
    o))

;;; The entry of PATH, spelled exactly as a key or resolving to one, or -1. An exact
;;; spelling needs no resolution, which is how the loader names the files it reads.
(defn source-overlay-find [(path (ptr i8))] (-> i64)
  (let [exact (source-overlay-index (from-cstr path))]
    (if (>= exact 0)
        exact
        (let [buf (primitive/cast (ptr i8) (primitive/alloc-stack (array u8 4096)))]
          (if (= (primitive/cast i64 (realpath-rooted path buf)) 0)
              -1
              (source-overlay-index (from-cstr buf)))))))

;;; The index of KEY's entry, or -1.
(defn source-overlay-index [(key (slice u8))] (-> i64)
  (let [entries (field (source-overlay) entries)
        (mut at) -1]
    (for [i 0 (len (load entries))]
      (when (and (< at 0) (= (.key (elem entries i)) key)) (set! at i) 0)
      0)
    at))

;;; Read TEXT wherever PATH is read, until the entry is removed. PATH must exist: a
;;; rewrite is proposed for a file that was read.
(defn source-overlay-set! [(path (ptr i8)) (text (slice u8))] (-> i64)
  (let [i (source-overlay-find path)
        entries (field (source-overlay) entries)]
    (if (>= i 0)
        (set! (.text (elem (mut entries) i)) text)
        (let [buf (primitive/cast (ptr i8) (primitive/alloc-stack (array u8 4096)))]
          (when (= (primitive/cast i64 (realpath-rooted path buf)) 0)
            (panic "source overlay: a rewrite was proposed for a file that does not resolve"))
          (push! (mut entries)
                 (SourceOverlayEntry :key (copy-text (malloc-allocator) (from-cstr buf))
                                     :text text))))
    0))

;;; Read PATH from disk again.
(defn source-overlay-remove! [(path (ptr i8))] (-> i64)
  (let [i (source-overlay-find path)
        entries (field (source-overlay) entries)]
    (when (>= i 0)
      (let [n (len (load entries))]
        (set! (elem (mut entries) i) (get (load entries) (- n 1)))
        (set! (.len entries) (- n 1)))
      0)
    0))

;;; Read every file from disk again.
(defn source-overlay-clear! [] (-> i64)
  (set! (.len (field (source-overlay) entries)) 0)
  0)

;;; The text the overlay holds for PATH.
(defn source-overlay-text [(path (ptr i8))] (-> (Option (slice u8)))
  (if (= (len (load (field (source-overlay) entries))) 0)
      (None [(slice u8)])
      (let [i (source-overlay-find path)]
        (if (< i 0)
            (None [(slice u8)])
            (Some (.text (elem (field (source-overlay) entries) i)))))))

;;; PATH's text as this command sees it: the overlay's when it holds the file,
;;; else the file's bytes (`read-file-disk`).
(defn read-file [(a (dyn Allocator)) (path (ptr i8))] (-> (slice u8))
  (match (source-overlay-text path)
    (Some [text] (copy-text a text))
    (None [] (read-file-disk a path))))

;;; PATH's bytes on disk, whatever the overlay holds.
(defn read-file-disk [(a (dyn Allocator)) (path (ptr i8))] (-> (slice u8))
  (match (read-file-opt-disk a path)
    (Some [text] text)
    (None [] "")))

; Like `read-file`, but distinguishes "could not open" (None) from an empty file
; (Some ""). `read-file` returns an empty slice for both, which is fine for the
; loader's "is there a module at this path" probing but WRONG for `include-str`,
; where a missing file at compile time is a hard build error, not an empty embed.
(defn read-file-opt [(a (dyn Allocator)) (path (ptr i8))] (-> (Option (slice u8)))
  (match (source-overlay-text path)
    (Some [text] (Some (copy-text a text)))
    (None [] (read-file-opt-disk a path))))

(defn read-file-opt-disk [(a (dyn Allocator)) (path (ptr i8))] (-> (Option (slice u8)))
  (let [fd (open path 0)]
    (if (< (primitive/cast i64 fd) 0)
        (None [(slice u8)])
        (let [text (read-fd-exact a fd)]
          (close fd)
          (Some text)))))
