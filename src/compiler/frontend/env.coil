; src/compiler/frontend/env.coil — what a compiler session keeps between compiles.
;
; A session (the REPL, a `coil.jit` session) compiles each submission in its own
; arena. What later submissions need of an accepted one is copied out of that
; arena into an `Env`: one value, in memory that belongs to the Env alone, which
; points into no compile's arena and into no other Env. The next compile reads
; it through views (`env-view`) that look like the loader state, checker
; context and resolution registries of the compilation it builds on, so the
; frontend reads accepted state where it always has, one level deep.
;
; Copying is `persist-clone` (coil.persist): every type an Env holds derives
; Persist, so keeping, copying and freeing an Env is one call each. See
; docs/design/COMPILER_STATE.md.
(module coil.compiler.env)
(import "coil.primitive" :as primitive)
(import "coil.alloc" :use *)
(import "coil.scratch" :as scratch)
(import "coil.compiler.large_pages" :as large-pages)
(import "coil.slice" :use *)
(import "coil.str" :use *)
(import "coil.arraylist" :use *)
(import "coil.hashmap" :use *)
(import "coil.control" :use *)
(import "coil.reader" :use *)
(import "coil.persist" :use *)
(import "coil.mem" :as mem)
(import "coil.cc" :as cc)
(import "coil.compiler.ast" :use *)
(import "coil.compiler.parser" :use [sconcat sconcat3 box-al])
(import "coil.compiler.loader" :use *)
(import "coil.compiler.resolve" :use *)
(import "coil.compiler.comptime" :use *)
(import "coil.compiler.check" :use *)
(import "coil.compiler.metaengine" :use [MEEntry MetaEngine])
(import "coil.avec" :use *)
(import "coil.amap" :use *)
(import "coil.compiler.unit_state" :use [UnitResource unit-resources-prepare!])

; ---- what an Env holds is owned data ------------------------------------------
(derive Persist TaggedForm)
(derive Persist Alias)
(derive Persist UseSpec)
(derive Persist Rename)
(derive Persist Use)
(derive Persist ModImports)
(derive Persist ImpEntry)
(derive Persist ExpEntry)
(derive Persist Source)
(derive Persist Expansion)
(derive Persist RetainedForm)
(derive Persist Sig)
(derive Persist ConstEntry)
(derive Persist StructInfo)
(derive Persist SumInfo)
(derive Persist VtoS)
(derive Persist MethodEntry)
(derive Persist ImplBucket)
(derive (Persist (field under (skip))) SemMapsSnap)
(derive Persist Defs)
(derive Persist DefEntry)
(derive Persist TypeResEntry)
(derive Persist ValueResEntry)
(derive Persist SrcModEntry)
(derive Persist CoreProvBox)
(derive Persist CoreDeclBox)
(derive Persist GsCell)

; The loader state of an accepted compilation, minus what belongs to the compile
; that built it: its allocator and working forms, its diagnostics, the opaque
; handles to the checker, maps and workspace (an Env holds those typed, beside
; it), and the links to other states (the views supply them).
(derive (Persist (field a (skip))
                 (field out (skip))
                 (field check_diags (skip))
                 (field check_diag_owners (skip))
                 (field resolve_diags (skip))
                 (field resolve_poisoned (skip))
                 (field loaderr (skip))
                 (field loaderr_set (skip))
                 (field code_session_state (skip))
                 (field semantic_workspace (skip))
                 (field semantic_audit (skip))
                 (field parent (skip))
                 (field checked (skip))
                 (field semantic_maps (skip))
                 (field checker_context (skip))
                 (field resolution_state (skip))
                 (field meta_environment (skip))
                 (field probed (skip))
                 (field host_stage (skip))
                 (field host_defined (skip))
                 (field extends_application (skip)))
        LS)

;;; One compilation's accepted state: the application's, or the metaprogram
;;; environment its macros and transforms were checked in. `functions` indexes
;;; every function of `checked` by name; `maps` are the live semantic facts of its
;;; nodes and `declarations` the resolver's table of what each module declares.
;;; The rest are its checker's tables, which a later check reads as its base: the
;;; signatures and constants, and the structs, sums, variants, traits, trait
;;; methods and impls registered, with the impl indexes over their positions.
(defstruct AcceptedLayer
  [(functions (HashMap (slice u8) i64))
   (checked Program)
   (maps SemMapsSnap)
   (declarations (AVec (ptr DefEntry)))
   ; the checker's tables, as the check that accepted it left them (persistent:
   ; a later check extends them without changing these, `setup-from-base!`)
   (sigs (AVec Sig))
   (sigidx (AMap (slice u8) i64))
   (consts (AVec ConstEntry))
   (constidx (AMap (slice u8) i64))
   (structs (AVec StructInfo))
   (struct_idx (AMap (slice u8) i64))
   (sums (AVec SumInfo))
   (sum_idx (AMap (slice u8) i64))
   (variants (AVec VtoS))
   (variant_idx (AMap (slice u8) i64))
   (traits (AVec TraitDef))
   (trait_idx (AMap (slice u8) i64))
   (methods (AVec MethodEntry))
   (impls (AVec ImplDef))
   (trait_impls (AMap (slice u8) (ptr ImplBucket)))
   (inherent_impls (AMap (slice u8) (ptr ImplBucket)))
   (inherent_names (AMap (slice u8) (ptr ImplBucket)))
   (method_names (AMap (slice u8) (ptr ImplBucket)))])
(derive Persist AcceptedLayer)

;;; What identifies a metaprogram the session accepted. The loaded image or
;;; interpreter that runs it is the session's (`EnvHandle`), not the Env's.
;;; `registry` is the position in `Env.registries` of the quasiquote templates
;;; its build made, which every entry of that build shares; -1 for none.
(defstruct EnvMetaEntry
  [(name (slice u8))
   (symbol (slice u8))
   (modbytes (slice u8))
   (registry i64)])
(derive Persist EnvMetaEntry)

;;; A session's compiler state. `loader` is the loader state both layers read:
;;; the metaprogram environment was loaded from the same sources. `meta` is null
;;; until a submission compiles a metaprogram. The registries are those
;;; resolution answers that later compiles read for accepted nodes; `native` is
;;; the accepted native program, whose functions later compiles declare: the
;;; functions, structs, sums, constants and instance origins mono reads of it,
;;; and the externs and exports whose symbols the session protects from reclaim.
(defstruct Env
  [(loader LS)
   (app AcceptedLayer)
   (meta (ptr AcceptedLayer))
   ; the resolution registries' answers, by `res-key` (ast.coil)
   (type_refs (AMap (slice u8) (slice u8)))
   (value_refs (AMap (slice u8) (slice u8)))
   (source_modules (ArrayList SrcModEntry))
   ; source -> 1 for each source source_modules has entries for
   (source_module_index (HashMap i64 i64))
   (core_providers CoreProvBox)
   (core_declarations CoreDeclBox)
   (engine_active i64)
   (engine (ArrayList EnvMetaEntry))
   (registries (ArrayList (ptr (ArrayList (ptr Sexp)))))
   (native Program)
   ; "f NAME", "s NAME", "u NAME", "c NAME", "x NAME", "e NAME", "o NAME" ->
   ; position in native's functions, structs, sums, constants, externs, exports
   ; and instance origins
   (native_index (HashMap (slice u8) i64))
   ; The accepted functions that exist only while compiling, each with the callee
   ; that made it so ("" for one that mentions Code itself), when the compile that
   ; left this Env classified them (`compile_time_known`): a later compile then
   ; classifies only the functions it adds (phase_split.coil).
   (compile_time (AMap (slice u8) (slice u8)))
   (compile_time_known bool)
   ; the modules the compiles it accepted were entered in, first use first: where
   ; a session's own definitions are (`:defs`)
   (entry_modules (ArrayList (slice u8)))
   (next_node_id i64)
   (next_form i64)
   (next_gensym GsCell)
   (next_elaboration i64)])
(derive Persist Env)

;;; The loaded form of the metaprogram an Env's `engine` entry at the same
;;; position names: its function in a loaded image, or its interpreter. Process
;;; state, so it is the holder's and not the Env's.
(defstruct EnvHandle [(fp (ptr i8)) (interpcx (ptr i8))])

;;; Memory Envs live in. An Env built on another goes into its pool and shares
;;; every record the earlier one already has there, so accepting a submission
;;; copies what it added. What a later Env no longer reaches stays in the pool
;;; until a compaction: once the pool is twice the size of its last full copy,
;;; the next Env is copied whole into a new pool. `refs` counts the Envs in it.
(defstruct EnvPool
  [(arena scratch/ScratchArena)
   (refs i64)
   (compacted i64)])

;;; What one accepted compile's metaprograms were loaded as: executable images
;;; and interpreters, which the handles of every Env whose engine names them
;;; point into. `refs` counts the holders that keep them; the last closes them.
(defstruct EnvResources
  [(items (ArrayList UnitResource))
   (refs i64)])

;;; An Env, the pool it lives in, the handles of its metaprograms and the
;;; resources those point into (its base's and its own compile's). A holder is
;;; shared by whoever holds it (the session's current state, each handle a client
;;; was given); the last release gives up the Env's place in its pool and its
;;; hold on those resources.
(defstruct EnvHolder
  [(pool (ptr EnvPool))
   (env Env)
   (handles (ArrayList EnvHandle))
   (resources (ArrayList (ptr EnvResources)))
   (holds i64)])

;;; A resource set holding ITEMS, kept once; null when there are none.
(defn env-resources-new [(items (ref (ArrayList UnitResource)))] (-> (ptr EnvResources))
  (if (= (len items) 0)
      (primitive/cast (ptr EnvResources) 0)
      (let [r (box! (malloc-allocator) EnvResources
                    (EnvResources :items (ArrayList::new [UnitResource] (malloc-allocator)) :refs 1))]
        (for [i 0 (len items)] (push! (mut (.items r)) (get items i)))
        r)))

;;; Give up one hold on R; the last closes its resources, newest first, as a
;;; unit closes its own.
(defn env-resources-release! [(r (ptr EnvResources))] (-> i64)
  (set! (.refs r) (- (.refs r) 1))
  (when (= (.refs r) 0)
    (unit-resources-prepare! (field r items) 0 -1)
    (let [(mut i) (len (.items r))]
      (loop (if (= (load i) 0)
                (break)
                (do (set! i (- (load i) 1))
                    (let [item (elem (field r items) (load i))]
                      (primitive/call-ptr (.release item) (.value item)))))))
    (free! (mut (.items r)))
    (free [EnvResources] (malloc-allocator) (slice::new r 1))
    0)
  0)

; ---- building an Env from an accepted compilation ------------------------------
;;; Where an accepted Env goes: the pool of the Env it was built on, unless that
;;; pool is due for compaction (`fresh`: a new pool, copied into whole). `extend`
;;; when the Env built on may be extended in place there (`env-exclusive?`): what
;;; it shares with the new one is then not copied, nor rebuilt, but added to.
(defstruct EnvTarget [(pool (ptr EnvPool)) (fresh bool) (extend bool)])

;;; The target of an Env built on BASE (null for none); EXTEND says BASE goes once
;;; the new Env is held, and nothing else holds or shares it.
(defn env-target [(base (ptr EnvHolder)) (extend bool)] (-> EnvTarget)
  (let [reuse (and (!= (primitive/cast i64 base) 0)
                   (< (scratch/ScratchArena::total (field (.pool base) arena))
                      (* 2 (.compacted (.pool base)))))]
    (EnvTarget :pool (if reuse (.pool base) (env-pool-new))
               :fresh (not reuse)
               :extend (and extend reuse))))

(defn env-target-allocator [(t (ptr EnvTarget))] (-> (dyn Allocator))
  (scratch/ScratchArena::allocator (field (.pool t) arena)))

;;; X copied into T's pool, sharing what is already there.
(defn env-into [(T Persist)] [(x (ref T)) (t (ptr EnvTarget))] (-> T)
  (persist-clone-sharing x (env-target-allocator t) (fnptr-of env-pool-owns?)
                         (primitive/cast (ptr i8) (.pool t))))

;;; BASE, an Env's list in T's pool, made to hold what ITEMS, a list a compile
;;; built over it, does: a record ITEMS has at the same position, byte for byte,
;;; stays; any other is replaced by ITEMS' copied into the pool, and ITEMS'
;;; records past BASE's are copied after them. ITEMS is at least as long as BASE.
(defn env-list-onto [(T Persist)] [(t (ptr EnvTarget)) (base (ref (ArrayList T))) (items (ref (ArrayList T)))] (-> (ArrayList T))
  (let [(mut out) (load base)
        n (len base)]
    (for [i 0 n]
      (unless (mem/eql (primitive/index (data (slice base)) i) (primitive/index (data (slice items)) i) 1)
        (set! (mut out) i (env-into (at items i) t))
        0))
    (for [i n (len items)]
      (push! (mut out) (env-into (at items i) t)))
    out))

;;; ITEMS, a list a compile built over BASE, an Env's (in T's pool, extended in
;;; place), which a record holds by pointer: BASE with ITEMS' records after its
;;; own, copied into the pool, when ITEMS begins with BASE's; otherwise ITEMS
;;; itself, for the copy that follows.
(defn env-plist-over [(T Persist)] [(t (ptr EnvTarget)) (base (ptr (ArrayList T))) (items (ptr (ArrayList T)))] (-> (ptr (ArrayList T)))
  (if (or (= (primitive/cast i64 base) 0) (= (primitive/cast i64 items) 0) (not (list-prefix? base items)))
      items
      (do (for [i (len (load base)) (len (load items))]
            (push! base (env-into (at items i) t)))
          base)))

;;; BASE made to hold what ITEMS does (`env-list-onto`) when ITEMS is no shorter,
;;; so a record changed in place is the only one copied; otherwise ITEMS itself,
;;; for the copy that follows. For a list read by position.
(defn env-list-replacing [(T Persist)] [(t (ptr EnvTarget)) (base (ref (ArrayList T))) (items (ref (ArrayList T)))] (-> (ArrayList T))
  (if (<= (len base) (len items))
      (env-list-onto t base items)
      (load items)))

;;; P, a checked program over BASE's, with each list `env-plist-over` BASE's.
(defn env-program-over [(t (ptr EnvTarget)) (base (ptr Program)) (p (ptr Program))] (-> Program)
  (let [(mut out) (load p)]
    (set! (.annotation_defs out) (env-plist-over [AnnotationDef] t (.annotation_defs base) (.annotation_defs p)))
    (set! (.conventions out) (env-plist-over [Convention] t (.conventions base) (.conventions p)))
    (set! (.structs out) (env-plist-over [StructDef] t (.structs base) (.structs p)))
    (set! (.sums out) (env-plist-over [SumDef] t (.sums base) (.sums p)))
    (set! (.externs out) (env-plist-over [Extern] t (.externs base) (.externs p)))
    (set! (.funcs out) (env-plist-over [Func] t (.funcs base) (.funcs p)))
    (set! (.consts out) (env-plist-over [Const] t (.consts base) (.consts p)))
    (set! (.traits out) (env-plist-over [TraitDef] t (.traits base) (.traits p)))
    (set! (.impls out) (env-plist-over [ImplDef] t (.impls base) (.impls p)))
    (set! (.exports out) (env-plist-over [ExportC] t (.exports base) (.exports p)))
    (load out)))

;;; The accepted state of the compilation S built, over PRIOR, the layer of the
;;; Env it built on (null for none), going where T says. Its semantic maps are
;;; S's, which began as PRIOR's and hold what S's checks found. Its checker tables are S's checker's, which began as
;;; PRIOR's and hold what S added; the Env's copy shares what PRIOR's pool holds.
;;; Where T extends PRIOR in place, what S added is appended to PRIOR's lists;
;;; the rest is shallow, sharing S's memory until the Env is copied out.
(defn env-layer [(a (dyn Allocator))
                 (s (ptr LS))
                 (prior (ptr AcceptedLayer))
                 (t (ptr EnvTarget))] (-> AcceptedLayer)
  (let [cx (primitive/cast (ptr Cx) (.checker_context s))
        ws (semantic-workspace s)
        extend (and (.extend t) (!= (primitive/cast i64 prior) 0))
        prior-funcs (if extend (len (load (.funcs (field prior checked)))) 0)
        checked (if extend
                    (env-program-over t (field prior checked) (.checked s))
                    (load (.checked s)))
        extended-funcs (and extend (= (primitive/cast i64 (.funcs checked))
                                      (primitive/cast i64 (.funcs (field prior checked)))))
        (mut functions) (if extended-funcs
                            (load (field prior functions))
                            (HashMap::new [(slice u8) i64] a (keyops-borrowed)))
        (mut layer) (env-tables-of a cx)]
    (for [i (if extended-funcs prior-funcs 0) (len (load (.funcs checked)))]
      (set! (mut functions) (.name (elem (.funcs checked) i)) i))
    (set! (.functions layer) (load functions))
    (set! (.checked layer) checked)
    (set! (.maps layer) (env-maps-of s))
    ; a compile's table is its parent's extended: the Env's copy shares the rest
    (set! (.declarations layer)
          (if (.has_declaration_table ws)
              (load (.declaration_table ws))
              (avec-new [(ptr DefEntry)] a)))
    (load layer)))

;;; S's semantic maps as an Env keeps them: what lies beneath them for a
;;; metaprogram's view is the application layer's own.
(defn env-maps-of [(s (ptr LS))] (-> SemMapsSnap)
  (let [(mut maps) (load (primitive/cast (ptr SemMapsSnap) (.semantic_maps s)))]
    (set! (.under maps) (primitive/cast (ptr SemMapsSnap) 0))
    maps))

;;; A layer holding CX's checker tables (empty ones for a null CX), and nothing
;;; else yet.
(defn env-tables-of [(a (dyn Allocator)) (cx (ptr Cx))] (-> AcceptedLayer)
  (let [(mut layer) (primitive/zeroed AcceptedLayer)]
    (if (= (primitive/cast i64 cx) 0)
        (do (set! (.sigs layer) (avec-new [Sig] a))
            (set! (.sigidx layer) (amap-new [(slice u8) i64] (keyops) a))
            (set! (.consts layer) (avec-new [ConstEntry] a))
            (set! (.constidx layer) (amap-new [(slice u8) i64] (keyops) a))
            (set! (.structs layer) (avec-new [StructInfo] a))
            (set! (.struct_idx layer) (amap-new [(slice u8) i64] (keyops) a))
            (set! (.sums layer) (avec-new [SumInfo] a))
            (set! (.sum_idx layer) (amap-new [(slice u8) i64] (keyops) a))
            (set! (.variants layer) (avec-new [VtoS] a))
            (set! (.variant_idx layer) (amap-new [(slice u8) i64] (keyops) a))
            (set! (.traits layer) (avec-new [TraitDef] a))
            (set! (.trait_idx layer) (amap-new [(slice u8) i64] (keyops) a))
            (set! (.methods layer) (avec-new [MethodEntry] a))
            (set! (.impls layer) (avec-new [ImplDef] a))
            (set! (.trait_impls layer) (amap-new [(slice u8) (ptr ImplBucket)] (keyops) a))
            (set! (.inherent_impls layer) (amap-new [(slice u8) (ptr ImplBucket)] (keyops) a))
            (set! (.inherent_names layer) (amap-new [(slice u8) (ptr ImplBucket)] (keyops) a))
            (set! (.method_names layer) (amap-new [(slice u8) (ptr ImplBucket)] (keyops) a))
            0)
        (do (set! (.sigs layer) (.sigs cx))
            (set! (.sigidx layer) (.sigidx cx))
            (set! (.consts layer) (.consts cx))
            (set! (.constidx layer) (.constidx cx))
            (set! (.structs layer) (.structs cx))
            (set! (.struct_idx layer) (.struct_idx cx))
            (set! (.sums layer) (.sums cx))
            (set! (.sum_idx layer) (.sum_idx cx))
            (set! (.variants layer) (.variant_to_sum cx))
            (set! (.variant_idx layer) (.variant_idx cx))
            (set! (.traits layer) (.trait_defs cx))
            (set! (.trait_idx layer) (.trait_idx cx))
            (set! (.methods layer) (.methods cx))
            (set! (.impls layer) (.impls cx))
            (set! (.trait_impls layer) (.trait_impl_idx cx))
            (set! (.inherent_impls layer) (.inherent_impl_idx cx))
            (set! (.inherent_names layer) (.inherent_name_idx cx))
            (set! (.method_names layer) (.method_idx cx))
            0))
    layer))

;;; RECORDED's source modules, then PRIOR's for sources RECORDED has none for:
;;; the first entry for a source is its module.
(defn env-source-modules [(a (dyn Allocator))
                          (prior (ptr (ArrayList SrcModEntry)))
                          (recorded (ptr (ArrayList SrcModEntry)))] (-> (ArrayList SrcModEntry))
  (let [(mut seen) (HashMap::new [i64 i64] a (i64-keyops))
        (mut out) (ArrayList::new [SrcModEntry] a)]
    (unless (= (primitive/cast i64 recorded) 0)
      (for [i 0 (len (load recorded))]
        (let [e (elem recorded i)]
          (set! (mut seen) (.source e) 1)
          (push! (mut out) (load e)))))
    (unless (= (primitive/cast i64 prior) 0)
      (for [i 0 (len (load prior))]
        (let [e (elem prior i)]
          (unless (contains? seen (.source e))
            (push! (mut out) (load e))
            0))))
    (load out)))

(defn env-source-modules-next! [(a (dyn Allocator)) (t (ptr EnvTarget)) (in-place bool) (prior (ptr Env))
                                (recorded (ptr (ArrayList SrcModEntry))) (env (mut Env))] (-> i64)
  (let [fresh-sources
          (and in-place
               (or (= (primitive/cast i64 recorded) 0)
                   (block :all
                     (for [i 0 (len (load recorded))]
                       (when (contains? (.source_module_index prior) (.source (elem recorded i)))
                         (break :all false)))
                     true)))]
    (if fresh-sources
        (let [(mut lst) (load (field prior source_modules))
              (mut idx) (load (field prior source_module_index))]
          (unless (= (primitive/cast i64 recorded) 0)
            (for [i 0 (len (load recorded))]
              (let [e (elem recorded i)]
                (push! (mut lst) (env-into [SrcModEntry] e t))
                (set! (mut idx) (.source e) 1)))
            0)
          (set! (.source_modules env) (load lst))
          (set! (.source_module_index env) (load idx))
          0)
        (let [(mut lst) (env-source-modules a (if (= (primitive/cast i64 prior) 0)
                                            (primitive/cast (ptr (ArrayList SrcModEntry)) 0)
                                            (field prior source_modules))
                                      recorded)
              (mut idx) (HashMap::new [i64 i64] a (i64-keyops))]
          (for [i 0 (len lst)]
            (set! (mut idx) (.source (elem (mut lst) i)) 1))
          (set! (.source_modules env) (load lst))
          (set! (.source_module_index env) (load idx))
          0))))

;;; The native program of the next Env, into ENV: PRIOR's, with what NATIVE has
;;; that it does not added: functions (as declarations: later compiles call them
;;; and never compile them again, mono's adopt-prior!), structs, sums, constants,
;;; externs, exports and instance origins, each found by name in the index. The
;;; session names a generation's symbols from it (`repl-accepted-symbols`). IN-PLACE adds to
;;; PRIOR's own lists and index, in T's pool.
(defn env-native-next! [(a (dyn Allocator)) (t (ptr EnvTarget)) (in-place bool) (prior (ptr Env))
                        (native (ptr Program)) (env (mut Env))] (-> i64)
  (let [(mut out) (if in-place (load (field prior native)) (env-native-empty a))
        (mut idx) (if in-place (load (field prior native_index)) (HashMap::new [(slice u8) i64] a (keyops)))
        target (if in-place t (primitive/cast (ptr EnvTarget) 0))]
    (for [i 0 (len (load (.funcs native)))]
      (let [(mut f) (load (elem (.funcs native) i))
            key (sconcat a "f " (.name f))]
        (unless (contains? idx key)
          (set! (.declared f) true)
          (set! (.body f) (box-al [Expr] a (ArrayList::new [Expr] a)))
          (set! (mut idx) key (len (load (.funcs out))))
          (push! (.funcs out) (env-native-entry [Func] target (mut f)))
          0)))
    (for [i 0 (len (load (.structs native)))]
      (let [d (elem (.structs native) i)
            key (sconcat a "s " (.name d))]
        (unless (contains? idx key)
          (set! (mut idx) key (len (load (.structs out))))
          (push! (.structs out) (env-native-entry [StructDef] target d))
          0)))
    (for [i 0 (len (load (.sums native)))]
      (let [d (elem (.sums native) i)
            key (sconcat a "u " (.name d))]
        (unless (contains? idx key)
          (set! (mut idx) key (len (load (.sums out))))
          (push! (.sums out) (env-native-entry [SumDef] target d))
          0)))
    (for [i 0 (len (load (.consts native)))]
      (let [d (elem (.consts native) i)
            key (sconcat a "c " (.name d))]
        (unless (contains? idx key)
          (set! (mut idx) key (len (load (.consts out))))
          (push! (.consts out) (env-native-entry [Const] target d))
          0)))
    (for [i 0 (len (load (.externs native)))]
      (let [d (elem (.externs native) i)
            key (sconcat a "x " (.name d))]
        (unless (contains? idx key)
          (set! (mut idx) key (len (load (.externs out))))
          (push! (.externs out) (env-native-entry [Extern] target d))
          0)))
    (for [i 0 (len (load (.exports native)))]
      (let [d (elem (.exports native) i)
            key (sconcat a "e " (.name d))]
        (unless (contains? idx key)
          (set! (mut idx) key (len (load (.exports out))))
          (push! (.exports out) (env-native-entry [ExportC] target d))
          0)))
    (unless (= (primitive/cast i64 (.mono_origins native)) 0)
      (for [i 0 (len (load (.mono_origins native)))]
        (let [d (elem (.mono_origins native) i)
              key (sconcat a "o " (.generated d))]
          (unless (contains? idx key)
            (set! (mut idx) key (len (load (.mono_origins out))))
            (push! (.mono_origins out) (env-native-entry [MonoOrigin] target d))
            0)))
      0)
    (set! (.native env) (load out))
    (set! (.native_index env) (load idx))
    0))

;;; PRIOR's entry modules (none without PRIOR) and MODULE after them unless they
;;; hold it already: in place in T's pool when IN-PLACE, else a list in A.
(defn env-entry-modules [(a (dyn Allocator)) (t (ptr EnvTarget)) (in-place bool) (prior (ptr Env))
                         (module (slice u8))] (-> (ArrayList (slice u8)))
  (let [m (primitive/alloc-stack (slice u8))
        _m (store! m module)
        (mut out) (if in-place
                      (load (field prior entry_modules))
                      (let [(mut fresh) (ArrayList::new [(slice u8)] a)]
                        (unless (= (primitive/cast i64 prior) 0)
                          (for [i 0 (len (.entry_modules prior))]
                            (push! (mut fresh) (get (.entry_modules prior) i))))
                        (load fresh)))]
    (unless (or (= (len module) 0)
                (block :held
                  (for [i 0 (len out)] (when (= (get out i) module) (break :held true)))
                  false))
      (push! (mut out) (if in-place (env-into [(slice u8)] m t) module))
      0)
    out))

;;; Whether the checked program P retired anything of the state it was built on.
(defn env-retires? [(p (ptr Program))] (-> bool)
  (or (and (!= (primitive/cast i64 (.retirements p)) 0) (> (len (load (.retirements p))) 0))
      (and (!= (primitive/cast i64 (.retired_functions p)) 0) (> (len (load (.retired_functions p))) 0))))

;;; X as the next Env's native program holds it: copied into T's pool when T is
;;; given (the program is extended in place), else as it is.
(defn env-native-entry [(T Persist)] [(t (ptr EnvTarget)) (x (ref T))] (-> T)
  (if (= (primitive/cast i64 t) 0) (load x) (env-into [T] x t)))

;;; A native program with nothing in it, its lists allocated from A.
(defn env-native-empty [(a (dyn Allocator))] (-> Program)
  (let [(mut p) (primitive/zeroed Program)]
    (set! (.annotation_defs p) (box-al [AnnotationDef] a (ArrayList::new [AnnotationDef] a)))
    (set! (.conventions p) (box-al [Convention] a (ArrayList::new [Convention] a)))
    (set! (.structs p) (box-al [StructDef] a (ArrayList::new [StructDef] a)))
    (set! (.sums p) (box-al [SumDef] a (ArrayList::new [SumDef] a)))
    (set! (.externs p) (box-al [Extern] a (ArrayList::new [Extern] a)))
    (set! (.funcs p) (box-al [Func] a (ArrayList::new [Func] a)))
    (set! (.asserts p) (box-al [StaticAssert] a (ArrayList::new [StaticAssert] a)))
    (set! (.consts p) (box-al [Const] a (ArrayList::new [Const] a)))
    (set! (.traits p) (box-al [TraitDef] a (ArrayList::new [TraitDef] a)))
    (set! (.impls p) (box-al [ImplDef] a (ArrayList::new [ImplDef] a)))
    (set! (.metas p) (box-al [Expr] a (ArrayList::new [Expr] a)))
    (set! (.exports p) (box-al [ExportC] a (ArrayList::new [ExportC] a)))
    (set! (.function_abis p) (box-al [Extern] a (ArrayList::new [Extern] a)))
    (set! (.mono_origins p) (box-al [MonoOrigin] a (ArrayList::new [MonoOrigin] a)))
    (set! (.mono_trait_uses p) (box-al [MonoTraitUse] a (ArrayList::new [MonoTraitUse] a)))
    (set! (.unit_exports p) (box-al [(slice u8)] a (ArrayList::new [(slice u8)] a)))
    (set! (.aliases p) (box-al [AliasDef] a (ArrayList::new [AliasDef] a)))
    (load p)))

;;; The Env a compilation leaves when it is accepted: S is its loader state (with
;;; its metaprogram environment), AST its resolution registries, ENGINE its
;;; metaprograms, NATIVE its native program and COMPILE-TIME its classification of
;;; functions (null when it made none), built over PRIOR (null for the
;;; first), going where T says. Shallow, but for what T extends of PRIOR in
;;; place: `env-hold` copies it out.
(defn env-of [(a (dyn Allocator))
              (s (ptr LS))
              (ast (ptr AstUnitState))
              (engine (ptr MetaEngine))
              (native (ptr Program))
              (compile-time (ptr (AMap (slice u8) (slice u8))))
              (prior (ptr Env))
              (t (ptr EnvTarget))
              (next-node-id i64)
              (next-form i64)
              (next-gensym GsCell)
              (next-elaboration i64)] (-> Env)
  (let [none (primitive/cast (ptr AcceptedLayer) 0)
        prior-app (if (= (primitive/cast i64 prior) 0) none (field prior app))
        prior-meta (if (= (primitive/cast i64 prior) 0) none (.meta prior))
        app (env-layer a s prior-app t)
        meta-ls (.meta_environment s)
        meta (cond (= (primitive/cast i64 meta-ls) 0) none
                   ; no metaprogram was compiled: the environment is the view of PRIOR's
                   (and (!= (primitive/cast i64 prior-meta) 0)
                        (= (primitive/cast i64 (.semantic_maps meta-ls))
                           (primitive/cast i64 (field prior-meta maps))))
                     prior-meta
                   :else
                     (box! a AcceptedLayer
                           (env-layer a meta-ls prior-meta t)))
        ; its lists began as PRIOR's: the Env's copy shares what they hold of it
        (mut loader) (load s)
        (mut entries) (ArrayList::new [EnvMetaEntry] a)
        (mut registries) (ArrayList::new [(ptr (ArrayList (ptr Sexp)))] a)
        (mut registry-at) (HashMap::new [i64 i64] a (i64-keyops))]
    (let [es (.entries engine)]
      (unless (= (primitive/cast i64 es) 0)
        (for [i 0 (len (load es))]
          (let [e (elem es i)
                key (primitive/cast i64 (.registry e))
                at (cond (= key 0) -1
                         (contains? registry-at key) (match (get registry-at key) (Some [k] k) (None [] -1))
                         :else (let [k (len registries)]
                                 (set! (mut registry-at) key k)
                                 (push! (mut registries) (.registry e))
                                 k))]
            (push! (mut entries)
                   (EnvMetaEntry :name (.name e) :symbol (.symbol e)
                                 :modbytes (.modbytes e) :registry at))))
        0))
    (set! (.checked_functions loader) (.functions app))
    (let [in-place (and (.extend t) (!= (primitive/cast i64 prior) 0))
          (mut env) (primitive/zeroed Env)]
      ; the registries' answers began as PRIOR's: the Env's copy shares them
      (set! (.type_refs env)
            (cond (!= (.init (.type_refs ast)) 0) (type-res-map-of ast)
                  (= (primitive/cast i64 prior) 0) (amap-new [(slice u8) (slice u8)] (keyops) a)
                  :else (.type_refs prior)))
      (set! (.value_refs env)
            (cond (!= (.init (.value_refs ast)) 0) (value-res-map-of ast)
                  (= (primitive/cast i64 prior) 0) (amap-new [(slice u8) (slice u8)] (keyops) a)
                  :else (.value_refs prior)))
      (env-source-modules-next! a t in-place prior
                                (if (= (.init (.source_modules ast)) 0)
                                    (primitive/cast (ptr (ArrayList SrcModEntry)) 0)
                                    (.lst (.source_modules ast)))
                                (mut env))
      ; a retirement removes what PRIOR's native program holds: only a compile
      ; that retired nothing adds to it
      (env-native-next! a t (and in-place (not (env-retires? (.checked s)))) prior native (mut env))
    (Env
      :loader (load loader)
      :app app
      :meta meta
      :type_refs (.type_refs env)
      :value_refs (.value_refs env)
      :source_modules (.source_modules env)
      :source_module_index (.source_module_index env)
      :core_providers (.core_providers ast)
      :core_declarations (.core_declarations ast)
      :engine_active (.active engine)
      :engine (if in-place (env-list-replacing [EnvMetaEntry] t (field prior engine) (mut entries)) (load entries))
      :registries (if in-place
                      (env-list-replacing [(ptr (ArrayList (ptr Sexp)))] t (field prior registries) (mut registries))
                      (load registries))
      :native (.native env)
      :native_index (.native_index env)
      :compile_time (if (= (primitive/cast i64 compile-time) 0)
                        (amap-new [(slice u8) (slice u8)] (keyops) a)
                        (load compile-time))
      :compile_time_known (!= (primitive/cast i64 compile-time) 0)
      :entry_modules (env-entry-modules a t in-place prior (.entry_module s))
      :next_node_id next-node-id
      :next_form next-form
      :next_gensym next-gensym
      :next_elaboration next-elaboration))))

;;; Whether P is memory of the pool at CX.
(defn env-pool-owns? [(cx (ptr i8)) (p (ptr i8))] (-> bool)
  (scratch/ScratchArena::owns-address? (field (primitive/cast (ptr EnvPool) cx) arena) p))

(defn env-pool-new [] (-> (ptr EnvPool))
  (let [pool (box! (malloc-allocator) EnvPool (primitive/zeroed EnvPool))]
    (scratch/ScratchArena::init-with-capacity (field pool arena) (large-pages/compiler-scratch-for "env.pool") 1048576)
    (large-pages/observe-arena! (field pool arena) "env.pool")
    pool))

;;; Copy ENV out of the compile that built it, held once, with the handles
;;; ENGINE's entries were loaded as, into the pool T names. BASE is the Env it was
;;; built on, or null: in BASE's pool ENV shares what BASE has there, and what T
;;; extends of it in place is ENV's already. The memory comes from the process,
;;; not from whoever asks: an Env is freed when its last holder lets go, which an
;;; arena would never do.
;;; OWN is what this compile's metaprograms were loaded as (null for nothing),
;;; kept from now on by the holder; BASE's resources are kept too, as the engine
;;; entries inherited from it name them.
(defn env-hold [(env (ref Env)) (engine (ptr MetaEngine)) (base (ptr EnvHolder)) (t (ptr EnvTarget))
                (own (ptr EnvResources))] (-> (ptr EnvHolder))
  (let [holder (box! (malloc-allocator) EnvHolder (primitive/zeroed EnvHolder))
        reuse (not (.fresh t))
        pool (.pool t)
        a (scratch/ScratchArena::allocator (field pool arena))
        prior (if (= (primitive/cast i64 base) 0) (primitive/cast (ptr Env) 0) (field base env))]
    (set! (.pool holder) pool)
    (set! (.refs pool) (+ (.refs pool) 1))
    (set! (.env holder)
          (if reuse
              (persist-clone-sharing env a (fnptr-of env-pool-owns?) (primitive/cast (ptr i8) pool))
              (persist-clone env a)))
    (unless reuse
      (set! (.compacted pool) (scratch/ScratchArena::total (field pool arena)))
      0)
    (set! (.resources holder) (ArrayList::new [(ptr EnvResources)] (malloc-allocator)))
    (unless (= (primitive/cast i64 base) 0)
      (for [i 0 (len (.resources base))]
        (let [r (get (.resources base) i)]
          (set! (.refs r) (+ (.refs r) 1))
          (push! (mut (.resources holder)) r))))
    (unless (= (primitive/cast i64 own) 0)
      (push! (mut (.resources holder)) own)
      0)
    (set! (.handles holder) (ArrayList::new [EnvHandle] (malloc-allocator)))
    (let [es (.entries engine)]
      (unless (= (primitive/cast i64 es) 0)
        (for [i 0 (len (load es))]
          (let [e (elem es i)]
            (push! (mut (.handles holder)) (EnvHandle :fp (.fp e) :interpcx (.interpcx e)))))
        0))
    (set! (.holds holder) 1)
    holder))

;;; The metaprogram entries of HOLDER's Env, loaded, in A: what a compile that
;;; builds on it starts its engine with.
(defn env-engine-entries [(a (dyn Allocator)) (holder (ptr EnvHolder))] (-> (ptr (ArrayList MEEntry)))
  (let [env (field holder env)
        (mut out) (ArrayList::new [MEEntry] a)]
    (for [i 0 (len (.engine env))]
      (let [e (elem (field env engine) i)
            h (elem (field holder handles) i)]
        (push! (mut out)
               (MEEntry :name (.name e)
                        :fp (.fp h)
                        :registry (if (< (.registry e) 0)
                                      (primitive/cast (ptr (ArrayList (ptr Sexp))) 0)
                                      (get (.registries env) (.registry e)))
                        :symbol (.symbol e) :modbytes (.modbytes e) :interpcx (.interpcx h)))))
    (box! a (ArrayList MEEntry) (load out))))

(defn env-retain! [(holder (ptr EnvHolder))] (-> i64)
  (set! (.holds holder) (+ (.holds holder) 1))
  0)

;;; Give up one hold; the last gives up the Env's place in its pool, and the last
;;; Env of a pool frees it.
(defn env-release! [(holder (ptr EnvHolder))] (-> i64)
  (set! (.holds holder) (- (.holds holder) 1))
  (when (= (.holds holder) 0)
    (let [pool (.pool holder)]
      (set! (.refs pool) (- (.refs pool) 1))
      (when (= (.refs pool) 0)
        (scratch/ScratchArena::close! (field pool arena))
        (free [EnvPool] (malloc-allocator) (slice::new pool 1))
        0))
    (free! (mut (.handles holder)))
    (for [i 0 (len (.resources holder))]
      (env-resources-release! (get (.resources holder) i)))
    (free! (mut (.resources holder)))
    (free [EnvHolder] (malloc-allocator) (slice::new holder 1))
    0)
  0)

;;; Whether HOLDER's Env may be changed in place: one hold on it, and no other Env
;;; in its pool, since Envs in one pool share what they have in common.
(defn env-exclusive? [(holder (ptr EnvHolder))] (-> bool)
  (and (= (.holds holder) 1) (= (.refs (.pool holder)) 1)))

;;; How many bytes the pool the Env lives in holds.
(defn env-bytes [(holder (ptr EnvHolder))] (-> i64)
  (scratch/ScratchArena::total (field (.pool holder) arena)))

; ---- reading an Env -----------------------------------------------------------
;;; A loader state, in A, that reads LAYER over LOADER: the accepted state a
;;; compile builds on. Its lists are LOADER's; its functions, checker context,
;;; maps and declaration table are the layer's, and it builds on nothing. META is
;;; the view of the metaprogram environment, or null; AST the resolution registries.
(defn env-layer-view [(a (dyn Allocator))
                      (loader (ptr LS))
                      (layer (ptr AcceptedLayer))
                      (meta (ptr LS))
                      (ast (ptr AstUnitState))] (-> (ptr LS))
  (let [s (box! a LS (load loader))
        cx (box! a Cx (primitive/zeroed Cx))
        ws (box! a SemanticWorkspace (primitive/zeroed SemanticWorkspace))]
    ; the view only reads the layer's tables; a check on it extends them under
    ; its own tag (`setup-from-base!`)
    (set! (.a cx) a)
    (set! (.edit_tag cx) (edit-tag-new))
    (set! (.sigs cx) (.sigs layer))
    (set! (.sigidx cx) (.sigidx layer))
    (set! (.consts cx) (.consts layer))
    (set! (.constidx cx) (.constidx layer))
    (set! (.structs cx) (.structs layer))
    (set! (.struct_idx cx) (.struct_idx layer))
    (set! (.sums cx) (.sums layer))
    (set! (.sum_idx cx) (.sum_idx layer))
    (set! (.variant_to_sum cx) (.variants layer))
    (set! (.variant_idx cx) (.variant_idx layer))
    (set! (.trait_defs cx) (.traits layer))
    (set! (.trait_idx cx) (.trait_idx layer))
    (set! (.methods cx) (.methods layer))
    (set! (.impls cx) (.impls layer))
    (set! (.trait_impl_idx cx) (.trait_impls layer))
    (set! (.inherent_impl_idx cx) (.inherent_impls layer))
    (set! (.inherent_name_idx cx) (.inherent_names layer))
    (set! (.method_idx cx) (.method_names layer))
    (set! (.declaration_table ws) (field layer declarations))
    (set! (.has_declaration_table ws) true)
    (set! (.a s) a)
    (set! (.checked_functions s) (.functions layer))
    (set! (.parent s) (primitive/cast (ptr LS) 0))
    (set! (.checked s) (field layer checked))
    (set! (.checker_context s) (primitive/cast (ptr i8) cx))
    (set! (.semantic_maps s) (primitive/cast (ptr i8) (field layer maps)))
    (set! (.semantic_workspace s)
          (box! a SemanticWorkspaceSlot
                (SemanticWorkspaceSlot :value (primitive/cast (ptr i8) ws) :owner a)))
    (set! (.semantic_audit s) (box! a SemanticAudit (primitive/zeroed SemanticAudit)))
    (set! (.resolution_state s) ast)
    (set! (.meta_environment s) meta)
    (set! (.out s) (ArrayList::new [TaggedForm] a))
    (set! (.probed s) (ArrayList::new [ProbedModule] a))
    s))

;;; The resolution registries of ENV as the state a compile's falls back to.
(defn env-ast-view [(a (dyn Allocator)) (env (ptr Env))] (-> (ptr AstUnitState))
  (let [ast (box! a AstUnitState (primitive/zeroed AstUnitState))
        modules (field ast source_modules)]
    ; the view answers what ENV answers, and has recorded nothing of its own
    (scratch/ScratchArena::init-with-capacity (field (field ast type_refs) arena) a 4096)
    (set! (.lst (field ast type_refs)) (box! a (ArrayList TypeResEntry) (ArrayList::new [TypeResEntry] a)))
    (set! (.map (field ast type_refs)) (.type_refs env))
    (set! (.base (field ast type_refs)) (.type_refs env))
    (set! (.init (field ast type_refs)) 1)
    (scratch/ScratchArena::init-with-capacity (field (field ast value_refs) arena) a 4096)
    (set! (.lst (field ast value_refs)) (box! a (ArrayList ValueResEntry) (ArrayList::new [ValueResEntry] a)))
    (set! (.map (field ast value_refs)) (.value_refs env))
    (set! (.base (field ast value_refs)) (.value_refs env))
    (set! (.init (field ast value_refs)) 1)
    (set! (.init (field ast source_modules)) 1)
    (set! (.lst (field ast source_modules)) (field env source_modules))
    (scratch/ScratchArena::init-with-capacity (field modules arena) a 4096)
    (src-mod-modules-reset! modules)
    (set! (.core_providers ast) (.core_providers env))
    (set! (.core_declarations ast) (.core_declarations env))
    ast))

;;; The loader state a compile builds on, reading ENV, in A.
(defn env-view [(a (dyn Allocator)) (env (ptr Env))] (-> (ptr LS))
  (let [ast (env-ast-view a env)
        meta (if (= (primitive/cast i64 (.meta env)) 0)
                 (primitive/cast (ptr LS) 0)
                 (env-layer-view a (field env loader) (.meta env) (primitive/cast (ptr LS) 0) ast))]
    (env-layer-view a (field env loader) (field env app) meta ast)))

;;; The function NAME the Env's application state defines, or None.
(defn env-function [(env (ptr Env)) (name (slice u8))] (-> (Option (ptr Func)))
  (let [layer (field env app)]
    (match (get (.functions layer) name)
      (None [] (None [(ptr Func)]))
      (Some [index] (Some (elem (.funcs (field layer checked)) index))))))

; ---- saving an Env ------------------------------------------------------------
;;; The first line of a saved Env. The two that follow name the toolchain that
;;; wrote it and the target it compiled for: the bytes are the Env's layout as
;;; that build of the compiler sees it, so only that build reads them back. The
;;; fourth is the FNV-1a hash of the bytes after it, in hex: the Env's lists are
;;; read by position through its indexes, so bytes that still parse but are not
;;; the ones written are refused rather than trusted.
(const ENV-SAVE-MAGIC "coil saved compiler state 2\n")

;;; The hash a saved Env's header records for BODY, as 16 hex digits in A.
(defn env-body-hash [(a (dyn Allocator)) (body (slice u8))] (-> (slice u8))
  (let [h (bytewise-hash (primitive/cast (ptr i8) (data body)) (len body))
        (mut out) (ArrayList::new [u8] a)
        digits "0123456789abcdef"]
    (for [i 0 16]
      (push! (mut out) (get digits (primitive/cast i64 (primitive/iand (primitive/ishr h (* 4 (- 15 i))) 15)))))
    (slice out)))

;;; HOLDER's Env as bytes in A, or why it cannot be saved. Its metaprograms are
;;; not saved: they are code this process loaded, and a compile on the state read
;;; back builds the ones it calls again from the definitions the state keeps.
(defn env-save [(a (dyn Allocator)) (holder (ptr EnvHolder))] (-> (Result (slice u8) (slice u8)))
  (match (toolchain-digest a)
    (None [] (Err [(slice u8) (slice u8)]
                  "this compiler records no toolchain digest, so nothing could tell which build may read a saved state"))
    (Some [digest]
      (let [(mut env) (load (field holder env))
            (mut out) (ArrayList::new [u8] a)]
        (set! (.engine_active env) 0)
        (set! (.engine env) (ArrayList::new [EnvMetaEntry] a))
        (set! (.registries env) (ArrayList::new [(ptr (ArrayList (ptr Sexp)))] a))
        (let [body (persist-save env a)]
          (env-save-text! (mut out) ENV-SAVE-MAGIC)
          (env-save-text! (mut out) (sconcat3 a digest "\n" (sconcat a (toolchain-target a) "\n")))
          (env-save-text! (mut out) (sconcat a (env-body-hash a body) "\n"))
          (extend! (mut out) (data body) (len body))
          (Ok [(slice u8) (slice u8)] (slice out)))))))

(defn env-save-text! [(out (mut (ArrayList u8))) (text (slice u8))] (-> i64)
  (extend! (mut out) (data text) (len text))
  0)

;;; The line of BYTES that starts at AT, and where the next one starts; None
;;; when no newline ends it.
(defn env-saved-line [(bytes (slice u8)) (at i64)] (-> (Option (slice u8)))
  (block :found
    (for [i at (len bytes)]
      (when (= (get bytes i) (: 10 u8))
        (break :found (Some (subslice bytes at i)))))
    (None [(slice u8)])))

;;; The Env BYTES hold, held once, or why they cannot be read.
(defn env-load [(a (dyn Allocator)) (bytes (slice u8))] (-> (Result (ptr EnvHolder) (slice u8)))
  (let [magic-n (len ENV-SAVE-MAGIC)]
    (if (or (< (len bytes) magic-n) (!= (subslice bytes 0 magic-n) ENV-SAVE-MAGIC))
        (Err [(ptr EnvHolder) (slice u8)] "these bytes are not a saved compiler state")
        (match (env-saved-line bytes magic-n)
          (None [] (Err [(ptr EnvHolder) (slice u8)] "the saved compiler state is cut short"))
          (Some [digest]
            (match (env-saved-line bytes (+ (+ magic-n (len digest)) 1))
              (None [] (Err [(ptr EnvHolder) (slice u8)] "the saved compiler state is cut short"))
              (Some [target]
               (match (env-saved-line bytes (+ (+ (+ magic-n (len digest)) 1) (+ (len target) 1)))
                (None [] (Err [(ptr EnvHolder) (slice u8)] "the saved compiler state is cut short"))
                (Some [hash]
                (let [ours (match (toolchain-digest a) (Some [d] d) (None [] ""))
                      body-at (+ (+ (+ (+ magic-n (len digest)) 1) (+ (len target) 1)) (+ (len hash) 1))
                      body (subslice bytes body-at (len bytes))]
                  (cond (!= digest ours)
                          (Err [(ptr EnvHolder) (slice u8)]
                               (sconcat3 a "the saved compiler state was written by toolchain " digest
                                         (sconcat3 a ", not by this one (" (if (= (len ours) 0) "unstamped" ours) ")")))
                        (!= target (toolchain-target a))
                          (Err [(ptr EnvHolder) (slice u8)]
                               (sconcat3 a "the saved compiler state compiled for " target
                                         (sconcat3 a ", not for " (toolchain-target a) "")))
                        (!= hash (env-body-hash a body))
                          (Err [(ptr EnvHolder) (slice u8)] "the saved compiler state is damaged: its bytes are not the ones saved")
                        :else
                          (let [pool (env-pool-new)]
                            (match (persist-load [Env] body (scratch/ScratchArena::allocator (field pool arena)))
                              (None []
                                (do (scratch/ScratchArena::close! (field pool arena))
                                    (free [EnvPool] (malloc-allocator) (slice::new pool 1))
                                    (Err [(ptr EnvHolder) (slice u8)] "the saved compiler state is damaged: its bytes are not one state")))
                              (Some [env]
                                (let [holder (box! (malloc-allocator) EnvHolder (primitive/zeroed EnvHolder))]
                                  (set! (.pool holder) pool)
                                  (set! (.refs pool) 1)
                                  (set! (.compacted pool) (scratch/ScratchArena::total (field pool arena)))
                                  (set! (.env holder) env)
                                  (set! (.handles holder) (ArrayList::new [EnvHandle] (malloc-allocator)))
                                  (set! (.resources holder) (ArrayList::new [(ptr EnvResources)] (malloc-allocator)))
                                  (set! (.holds holder) 1)
                                  (Ok [(ptr EnvHolder) (slice u8)] holder))))))))))))))))

;;; What HOLDER's Env owns, by field path, as text in A: paths DEPTH fields deep.
(defn env-footprint [(a (dyn Allocator)) (holder (ptr EnvHolder)) (depth i64)] (-> (slice u8))
  (footprint-report (persist-footprint (field holder env) a (+ depth 1)) a depth))

;;; The bytes HOLDER's Env owns.
(defn env-footprint-total [(a (dyn Allocator)) (holder (ptr EnvHolder))] (-> i64)
  (footprint-total (persist-footprint (field holder env) a 1)))
