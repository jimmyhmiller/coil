; src/compiler/frontend/env.coil — what a compiler session keeps between compiles.
;
; A session (the REPL, a `coil.jit` session) compiles each submission in its own
; arena. What later submissions need of an accepted one is copied out of that
; arena into an `Env`: one value, in memory that belongs to the Env alone, which
; points into no compile's arena and into no other Env. The next compile reads
; it through views (`env-view`) that look like the loader state, checker
; context and resolution registries of the compilation it builds on, so the
; frontend reads accepted state where it always has, one level deep.
;
; Copying is `persist-clone` (coil.persist): every type an Env holds derives
; Persist, so keeping, copying and freeing an Env is one call each. See
; docs/design/COMPILER_STATE.md.
(module coil.compiler.env)
(import "coil.primitive" :as primitive)
(import "coil.alloc" :use *)
(import "coil.scratch" :as scratch)
(import "coil.compiler.large_pages" :as large-pages)
(import "coil.slice" :use *)
(import "coil.str" :use *)
(import "coil.arraylist" :use *)
(import "coil.hashmap" :use *)
(import "coil.control" :use *)
(import "coil.reader" :use *)
(import "coil.persist" :use *)
(import "coil.mem" :as mem)
(import "coil.cc" :as cc)
(import "coil.compiler.ast" :use *)
(import "coil.compiler.parser" :use [sconcat sconcat3 box-al])
(import "coil.compiler.loader" :use *)
(import "coil.compiler.resolve" :use *)
(import "coil.compiler.comptime" :use *)
(import "coil.compiler.check" :use *)
(import "coil.compiler.metaengine" :use [MEEntry MetaEngine])

; ---- what an Env holds is owned data ------------------------------------------
(derive Persist TaggedForm)
(derive Persist Alias)
(derive Persist UseSpec)
(derive Persist Rename)
(derive Persist Use)
(derive Persist ModImports)
(derive Persist ImpEntry)
(derive Persist ExpEntry)
(derive Persist Source)
(derive Persist Expansion)
(derive Persist RetainedForm)
(derive Persist Sig)
(derive Persist ConstEntry)
(derive Persist StructInfo)
(derive Persist SumInfo)
(derive Persist VtoS)
(derive Persist MethodEntry)
(derive Persist ImplBucket)
(derive Persist TypeMapEntry)
(derive Persist BindMapEntry)
(derive Persist ResMapEntry)
(derive (Persist (field base (skip))) SemMapsSnap)
(derive Persist Defs)
(derive Persist DefEntry)
(derive Persist TypeResEntry)
(derive Persist ValueResEntry)
(derive Persist SrcModEntry)
(derive Persist CoreProvBox)
(derive Persist CoreDeclBox)
(derive Persist GsCell)

; The loader state of an accepted compilation, minus what belongs to the compile
; that built it: its allocator and working forms, its diagnostics, the opaque
; handles to the checker, maps and workspace (an Env holds those typed, beside
; it), and the links to other states (the views supply them).
(derive (Persist (field a (skip))
                 (field out (skip))
                 (field check_diags (skip))
                 (field check_diag_owners (skip))
                 (field resolve_diags (skip))
                 (field resolve_poisoned (skip))
                 (field loaderr (skip))
                 (field loaderr_set (skip))
                 (field code_session_state (skip))
                 (field semantic_workspace (skip))
                 (field semantic_audit (skip))
                 (field parent (skip))
                 (field checked (skip))
                 (field semantic_maps (skip))
                 (field checker_context (skip))
                 (field resolution_state (skip))
                 (field meta_environment (skip))
                 (field probed (skip))
                 (field host_stage (skip))
                 (field host_defined (skip))
                 (field extends_application (skip)))
        LS)

;;; One compilation's accepted state: the application's, or the metaprogram
;;; environment its macros and transforms were checked in. `functions` indexes
;;; every function of `checked` by name; `maps` are the live semantic facts of its
;;; nodes and `declarations` the resolver's table of what each module declares.
;;; The rest are its checker's tables, which a later check reads as its base: the
;;; signatures and constants, and the structs, sums, variants, traits, trait
;;; methods and impls registered, with the impl indexes over their positions.
(defstruct AcceptedLayer
  [(functions (HashMap (slice u8) i64))
   (checked Program)
   (sigs (ArrayList Sig))
   (sigidx (HashMap (slice u8) i64))
   (consts (ArrayList ConstEntry))
   (constidx (HashMap (slice u8) i64))
   (maps SemMapsSnap)
   (declarations (ArrayList DefEntry))
   (structs (ArrayList StructInfo))
   (sums (ArrayList SumInfo))
   (variants (ArrayList VtoS))
   (traits (ArrayList TraitDef))
   (methods (ArrayList MethodEntry))
   (impls (ArrayList ImplDef))
   (trait_impls (HashMap (slice u8) (ptr ImplBucket)))
   (inherent_impls (HashMap (slice u8) (ptr ImplBucket)))
   (inherent_names (HashMap (slice u8) (ptr ImplBucket)))])
(derive Persist AcceptedLayer)

;;; What identifies a metaprogram the session accepted. The loaded image or
;;; interpreter that runs it is the session's (`EnvHandle`), not the Env's.
;;; `registry` is the position in `Env.registries` of the quasiquote templates
;;; its build made, which every entry of that build shares; -1 for none.
(defstruct EnvMetaEntry
  [(name (slice u8))
   (symbol (slice u8))
   (modbytes (slice u8))
   (registry i64)])
(derive Persist EnvMetaEntry)

;;; A session's compiler state. `loader` is the loader state both layers read:
;;; the metaprogram environment was loaded from the same sources. `meta` is null
;;; until a submission compiles a metaprogram. The registries are those
;;; resolution answers that later compiles read for accepted nodes; `native` is
;;; the accepted native program, whose functions later compiles declare: the
;;; functions, structs, sums, constants and instance origins mono reads of it.
(defstruct Env
  [(loader LS)
   (app AcceptedLayer)
   (meta (ptr AcceptedLayer))
   (type_refs (ArrayList TypeResEntry))
   (value_refs (ArrayList ValueResEntry))
   (source_modules (ArrayList SrcModEntry))
   ; "module name" -> position in type_refs / value_refs; source -> 1 for each
   ; source source_modules has entries for
   (type_ref_index (HashMap (slice u8) i64))
   (value_ref_index (HashMap (slice u8) i64))
   (source_module_index (HashMap i64 i64))
   (core_providers CoreProvBox)
   (core_declarations CoreDeclBox)
   (engine_active i64)
   (engine (ArrayList EnvMetaEntry))
   (registries (ArrayList (ptr (ArrayList (ptr Sexp)))))
   (native Program)
   ; "f NAME", "s NAME", "u NAME", "c NAME", "o NAME" -> position in native's
   ; functions, structs, sums, constants and instance origins
   (native_index (HashMap (slice u8) i64))
   (next_node_id i64)
   (next_form i64)
   (next_gensym GsCell)
   (next_elaboration i64)])
(derive Persist Env)

;;; The loaded form of the metaprogram an Env's `engine` entry at the same
;;; position names: its function in a loaded image, or its interpreter. Process
;;; state, so it is the holder's and not the Env's.
(defstruct EnvHandle [(fp (ptr i8)) (interpcx (ptr i8))])

;;; Memory Envs live in. An Env built on another goes into its pool and shares
;;; every record the earlier one already has there, so accepting a submission
;;; copies what it added. What a later Env no longer reaches stays in the pool
;;; until a compaction: once the pool is twice the size of its last full copy,
;;; the next Env is copied whole into a new pool. `refs` counts the Envs in it.
(defstruct EnvPool
  [(arena scratch/ScratchArena)
   (refs i64)
   (compacted i64)])

;;; An Env, the pool it lives in, and the handles of its metaprograms. A holder is
;;; shared by whoever holds it (the session's current state, each handle a client
;;; was given); the last release gives up the Env's place in its pool.
(defstruct EnvHolder
  [(pool (ptr EnvPool))
   (env Env)
   (handles (ArrayList EnvHandle))
   (holds i64)])

; ---- building an Env from an accepted compilation ------------------------------
;;; Where an accepted Env goes: the pool of the Env it was built on, unless that
;;; pool is due for compaction (`fresh`: a new pool, copied into whole). `extend`
;;; when the Env built on may be extended in place there (`env-exclusive?`): what
;;; it shares with the new one is then not copied, nor rebuilt, but added to.
(defstruct EnvTarget [(pool (ptr EnvPool)) (fresh bool) (extend bool)])

;;; The target of an Env built on BASE (null for none); EXTEND says BASE goes once
;;; the new Env is held, and nothing else holds or shares it.
(defn env-target [(base (ptr EnvHolder)) (extend bool)] (-> EnvTarget)
  (let [reuse (and (!= (primitive/cast i64 base) 0)
                   (< (scratch/ScratchArena::total (field (.pool base) arena))
                      (* 2 (.compacted (.pool base)))))]
    (EnvTarget :pool (if reuse (.pool base) (env-pool-new))
               :fresh (not reuse)
               :extend (and extend reuse))))

(defn env-target-allocator [(t (ptr EnvTarget))] (-> (dyn Allocator))
  (scratch/ScratchArena::allocator (field (.pool t) arena)))

;;; X copied into T's pool, sharing what is already there.
(defn env-into [(T Persist)] [(x (ref T)) (t (ptr EnvTarget))] (-> T)
  (persist-clone-sharing x (env-target-allocator t) (fnptr-of env-pool-owns?)
                         (primitive/cast (ptr i8) (.pool t))))

;;; Whether ITEMS begins with BASE's records, byte for byte: a compile's copy of an
;;; Env's list that changed none of them.
(defn env-prefix? [T] [(base (ref (ArrayList T))) (items (ref (ArrayList T)))] (-> bool)
  (and (<= (len base) (len items))
       (or (= (len base) 0)
           (mem/eql (data (slice base)) (data (slice items)) (len base)))))

;;; ITEMS, a list a compile built over BASE, an Env's (in T's pool, extended in
;;; place): BASE with ITEMS' records after its own, copied into the pool, when
;;; ITEMS begins with BASE's; otherwise ITEMS itself, for the copy that follows.
;;; Either way the list holds what ITEMS does.
(defn env-list-over [(T Persist)] [(t (ptr EnvTarget)) (base (ref (ArrayList T))) (items (ref (ArrayList T)))] (-> (ArrayList T))
  (if (env-prefix? base items)
      (let [(mut out) (load base)]
        (for [i (len base) (len items)]
          (push! (mut out) (env-into (at items i) t)))
        out)
      (load items)))

;;; `env-list-over` for a list a record holds by pointer: BASE itself, extended.
(defn env-plist-over [(T Persist)] [(t (ptr EnvTarget)) (base (ptr (ArrayList T))) (items (ptr (ArrayList T)))] (-> (ptr (ArrayList T)))
  (if (or (= (primitive/cast i64 base) 0) (= (primitive/cast i64 items) 0) (not (env-prefix? base items)))
      items
      (do (for [i (len (load base)) (len (load items))]
            (push! base (env-into (at items i) t)))
          base)))

;;; P, a checked program over BASE's, with each list `env-plist-over` BASE's.
(defn env-program-over [(t (ptr EnvTarget)) (base (ptr Program)) (p (ptr Program))] (-> Program)
  (let [(mut out) (load p)]
    (set! (.annotation_defs out) (env-plist-over [AnnotationDef] t (.annotation_defs base) (.annotation_defs p)))
    (set! (.conventions out) (env-plist-over [Convention] t (.conventions base) (.conventions p)))
    (set! (.structs out) (env-plist-over [StructDef] t (.structs base) (.structs p)))
    (set! (.sums out) (env-plist-over [SumDef] t (.sums base) (.sums p)))
    (set! (.externs out) (env-plist-over [Extern] t (.externs base) (.externs p)))
    (set! (.funcs out) (env-plist-over [Func] t (.funcs base) (.funcs p)))
    (set! (.consts out) (env-plist-over [Const] t (.consts base) (.consts p)))
    (set! (.traits out) (env-plist-over [TraitDef] t (.traits base) (.traits p)))
    (set! (.impls out) (env-plist-over [ImplDef] t (.impls base) (.impls p)))
    (set! (.exports out) (env-plist-over [ExportC] t (.exports base) (.exports p)))
    (load out)))

;;; S, a loader state over BASE's, with each list `env-list-over` BASE's.
(defn env-loader-over [(t (ptr EnvTarget)) (base (ptr LS)) (s (ptr LS))] (-> LS)
  (let [(mut out) (load s)]
    (set! (.loaded out) (env-list-over [(slice u8)] t (field base loaded) (field s loaded)))
    (set! (.readpaths out) (env-list-over [(slice u8)] t (field base readpaths) (field s readpaths)))
    (set! (.readmods out) (env-list-over [(slice u8)] t (field base readmods) (field s readmods)))
    (set! (.primitive_defs out) (env-list-over [PrimitiveDef] t (field base primitive_defs) (field s primitive_defs)))
    (set! (.primitive_aliases out) (env-list-over [PrimitiveAlias] t (field base primitive_aliases) (field s primitive_aliases)))
    (set! (.sources out) (env-list-over [Source] t (field base sources) (field s sources)))
    (set! (.expansions out) (env-list-over [Expansion] t (field base expansions) (field s expansions)))
    (set! (.retained_forms out) (env-list-over [RetainedForm] t (field base retained_forms) (field s retained_forms)))
    (set! (.namespace_names out) (env-list-over [(slice u8)] t (field base namespace_names) (field s namespace_names)))
    (set! (.namespace_paths out) (env-list-over [(slice u8)] t (field base namespace_paths) (field s namespace_paths)))
    (set! (.stage_excluded out) (env-list-over [(slice u8)] t (field base stage_excluded) (field s stage_excluded)))
    (set! (.core_declared_modules out) (env-list-over [(slice u8)] t (field base core_declared_modules) (field s core_declared_modules)))
    (set! (.indexed_paths out) (env-list-over [(slice u8)] t (field base indexed_paths) (field s indexed_paths)))
    (load out)))

;;; TABLE, a compile's declaration table, over PRIOR, an Env's (in T's pool,
;;; extended in place): a module that declares what it did in PRIOR is given
;;; PRIOR's entry; one that declares more after it (a submission's own module)
;;; is given PRIOR's entry with the new names added; any other is TABLE's own.
(defn env-declarations-over [(a (dyn Allocator))
                             (t (ptr EnvTarget))
                             (prior (ptr (ArrayList DefEntry)))
                             (table (ptr (ArrayList DefEntry)))] (-> (ArrayList DefEntry))
  (let [(mut out) (ArrayList::new [DefEntry] a)]
    (for [i 0 (len (load table))]
      (let [e (elem table i)
            p (table-find prior (.module e))]
        (push! (mut out)
               (cond (= (primitive/cast i64 p) 0) (load e)
                     (defs-equal? (field p defs) (field e defs)) (load p)
                     (env-defs-extends? (field p defs) (field e defs))
                       (do (env-defs-append! t p e) (load p))
                     :else (load e)))))
    (load out)))

;;; Whether NEW names what OLD does and more, of every kind, with the same
;;; aliases: each of NEW's lists holds OLD's whole, before or after the names it
;;; adds (a compile's table puts a submission's names before what it inherited).
;;; Only aliases are ordered (the first pair for a name wins), and they are equal.
(defn env-defs-extends? [(old (ptr Defs)) (new (ptr Defs))] (-> bool)
  (and (env-names-within? (field old callables) (field new callables))
       (env-names-within? (field old types) (field new types))
       (env-names-within? (field old traits) (field new traits))
       (env-names-within? (field old convs) (field new convs))
       (env-names-within? (field old externs) (field new externs))
       (env-names-within? (field old consts) (field new consts))
       (env-names-within? (field old methods) (field new methods))
       (env-names-within? (field old extern_links) (field new extern_links))
       (def-names-equal? (field old aliases) (field new aliases))))

(defn env-names-within? [(old (ptr (ArrayList (slice u8)))) (new (ptr (ArrayList (slice u8))))] (-> bool)
  (or (env-prefix? [(slice u8)] old new) (env-suffix? old new)))

;;; Whether NEW ends with OLD's names, byte for byte.
(defn env-suffix? [(old (ptr (ArrayList (slice u8)))) (new (ptr (ArrayList (slice u8))))] (-> bool)
  (let [n (len (load old))
        m (len (load new))]
    (and (<= n m)
         (or (= n 0)
             (mem/eql (data (slice (load old))) (primitive/index (data (slice (load new))) (- m n)) n)))))

;;; Add to P, an Env's entry in T's pool, the names E declares after P's, and
;;; index each under its kind (the bits `defs-index-build!` gives them).
(defn env-defs-append! [(t (ptr EnvTarget)) (p (ptr DefEntry)) (e (ptr DefEntry))] (-> i64)
  (env-defs-kind-append! t p (field (field p defs) callables) (field (field e defs) callables) 1)
  (env-defs-kind-append! t p (field (field p defs) types) (field (field e defs) types) 2)
  (env-defs-kind-append! t p (field (field p defs) traits) (field (field e defs) traits) 4)
  (env-defs-kind-append! t p (field (field p defs) convs) (field (field e defs) convs) 8)
  (env-defs-kind-append! t p (field (field p defs) externs) (field (field e defs) externs) 16)
  (env-defs-kind-append! t p (field (field p defs) consts) (field (field e defs) consts) 32)
  (env-defs-kind-append! t p (field (field p defs) methods) (field (field e defs) methods) 64)
  (env-defs-kind-append! t p (field (field p defs) extern_links) (field (field e defs) extern_links) 0)
  0)

(defn env-defs-kind-append! [(t (ptr EnvTarget)) (p (ptr DefEntry))
                             (old (ptr (ArrayList (slice u8)))) (new (ptr (ArrayList (slice u8))))
                             (bit i64)] (-> i64)
  ; the names NEW adds: after OLD's when it begins with them, else before them
  (let [added (- (len (load new)) (len (load old)))
        from (if (env-prefix? [(slice u8)] old new) (len (load old)) 0)]
  (for [i from (+ from added)]
    (let [name (env-into [(slice u8)] (at (load new) i) t)]
      (push! old name)
      ; the index owns its keys, so it copies NAME into the pool itself
      (unless (= bit 0)
        (set! (mut (.idx p)) name (primitive/ior bit (match (get (.idx p) name) (Some [v] v) (None [] 0))))
        0))))
  0)

;;; CX's signatures over SIGS and SIGIDX, an Env's, extended in place: each
;;; replaces the one of its name, or is added.
(defn env-sigs-over! [(t (ptr EnvTarget))
                      (cx (ptr Cx))
                      (sigs (mut (ArrayList Sig)))
                      (sigidx (mut (HashMap (slice u8) i64)))] (-> i64)
  (unless (= (primitive/cast i64 cx) 0)
    (for [i 0 (len (.sigs cx))]
      (let [sig (elem (field cx sigs) i)]
        (when (= (get (.sigidx cx) (.name sig)) (Some i))
          (let [kept (env-into [Sig] sig t)]
            (match (get (load sigidx) (.name kept))
              (Some [at] (set! (mut sigs) at kept) 0)
              (None [] (do (set! (mut sigidx) (.name kept) (len (load sigs)))
                           (push! (mut sigs) kept)
                           0))))
          0)))
    0)
  0)

;;; `env-sigs-over!` for constants.
(defn env-consts-over! [(t (ptr EnvTarget))
                        (cx (ptr Cx))
                        (consts (mut (ArrayList ConstEntry)))
                        (constidx (mut (HashMap (slice u8) i64)))] (-> i64)
  (unless (= (primitive/cast i64 cx) 0)
    (for [i 0 (len (.consts cx))]
      (let [entry (elem (field cx consts) i)]
        (when (= (get (.constidx cx) (.name entry)) (Some i))
          (let [kept (env-into [ConstEntry] entry t)]
            (match (get (load constidx) (.name kept))
              (Some [at] (set! (mut consts) at kept) 0)
              (None [] (do (set! (mut constidx) (.name kept) (len (load consts)))
                           (push! (mut consts) kept)
                           0))))
          0)))
    0)
  0)

;;; The signatures CX knows, then those of PRIOR it does not replace, each once.
(defn env-sigs! [(a (dyn Allocator))
                 (cx (ptr Cx))
                 (prior (ptr AcceptedLayer))
                 (out (mut (ArrayList Sig)))
                 (index (mut (HashMap (slice u8) i64)))] (-> i64)
  (unless (= (primitive/cast i64 cx) 0)
    (for [i 0 (len (.sigs cx))]
      (let [sig (elem (field cx sigs) i)]
        (when (= (get (.sigidx cx) (.name sig)) (Some i))
          (set! (mut index) (.name sig) (len out))
          (push! (mut out) (load sig))
          0)))
    0)
  (unless (= (primitive/cast i64 prior) 0)
    (for [i 0 (len (.sigs prior))]
      (let [sig (elem (field prior sigs) i)]
        (when (and (= (get (.sigidx prior) (.name sig)) (Some i))
                   (not (contains? index (.name sig))))
          (set! (mut index) (.name sig) (len out))
          (push! (mut out) (load sig))
          0)))
    0)
  0)

;;; The constants CX knows, then those of PRIOR it does not replace, each once.
(defn env-consts! [(a (dyn Allocator))
                   (cx (ptr Cx))
                   (prior (ptr AcceptedLayer))
                   (out (mut (ArrayList ConstEntry)))
                   (index (mut (HashMap (slice u8) i64)))] (-> i64)
  (unless (= (primitive/cast i64 cx) 0)
    (for [i 0 (len (.consts cx))]
      (let [entry (elem (field cx consts) i)]
        (when (= (get (.constidx cx) (.name entry)) (Some i))
          (set! (mut index) (.name entry) (len out))
          (push! (mut out) (load entry))
          0)))
    0)
  (unless (= (primitive/cast i64 prior) 0)
    (for [i 0 (len (.consts prior))]
      (let [entry (elem (field prior consts) i)]
        (when (and (= (get (.constidx prior) (.name entry)) (Some i))
                   (not (contains? index (.name entry))))
          (set! (mut index) (.name entry) (len out))
          (push! (mut out) (load entry))
          0)))
    0)
  0)

;;; The entries of SNAP that count: for each node, the one its index selects. A
;;; snapshot's history keeps every refinement a compile made; only the last one
;;; is a fact. A node UNDER or BELOW (each null for none) answers for is left
;;; out: a metaprogram environment's maps are read over the application's.
(defn env-live-maps [(a (dyn Allocator))
                     (snap (ptr SemMapsSnap))
                     (under (ptr SemMapsSnap))
                     (below (ptr SemMapsSnap))] (-> SemMapsSnap)
  (let [(mut out) (primitive/zeroed SemMapsSnap)]
    (set! (.tlist out) (ArrayList::new [TypeMapEntry] a))
    (set! (.tindex out) (HashMap::new [i64 i64] a (i64-keyops)))
    (set! (.blist out) (ArrayList::new [BindMapEntry] a))
    (set! (.bindex out) (HashMap::new [i64 i64] a (i64-keyops)))
    (set! (.rlist out) (ArrayList::new [ResMapEntry] a))
    (set! (.rindex out) (HashMap::new [i64 (slice u8)] a (i64-keyops)))
    (unless (= (primitive/cast i64 snap) 0)
      (for [i 0 (len (.tlist snap))]
        (let [e (elem (field snap tlist) i)]
          (match (get (.tindex snap) (.node-id e))
            (Some [latest]
              (when (and (sem-snapshot-entry-live? latest i (len (.tlist snap)))
                         (not (env-maps-type? under (.node-id e)))
                         (not (env-maps-type? below (.node-id e))))
                (env-type-put! (mut out) (load e))
                0))
            (None [] 0))))
      (for [i 0 (len (.blist snap))]
        (let [e (elem (field snap blist) i)]
          (match (get (.bindex snap) (.node-id e))
            (Some [latest]
              (when (and (sem-snapshot-entry-live? latest i (len (.blist snap)))
                         (not (env-maps-binding? under (.node-id e)))
                         (not (env-maps-binding? below (.node-id e))))
                (env-binding-put! (mut out) (load e))
                0))
            (None [] 0))))
      (for-entries [k v (field snap rindex)]
        (when (and (not (env-maps-resolution? under (load k)))
                   (not (env-maps-resolution? below (load k))))
          (env-resolution-put! (mut out) (ResMapEntry :node-id (load k) :name (load v)))
          0))
      (set! (.bnext out) (.bnext snap))
      0)
    (load out)))

(defn env-maps-type? [(maps (ptr SemMapsSnap)) (node i64)] (-> bool)
  (and (!= (primitive/cast i64 maps) 0) (contains? (.tindex maps) node)))

(defn env-maps-binding? [(maps (ptr SemMapsSnap)) (node i64)] (-> bool)
  (and (!= (primitive/cast i64 maps) 0) (contains? (.bindex maps) node)))

(defn env-maps-resolution? [(maps (ptr SemMapsSnap)) (node i64)] (-> bool)
  (and (!= (primitive/cast i64 maps) 0) (contains? (.rindex maps) node)))

;;; Make E the fact for its node in MAPS, which hold one entry per node.
(defn env-type-put! [(maps (mut SemMapsSnap)) (e TypeMapEntry)] (-> i64)
  (match (get (.tindex maps) (.node-id e))
    (Some [at] (set! (.ty (elem (field maps tlist) at)) (.ty e)) 0)
    (None [] (do (set! (mut (.tindex maps)) (.node-id e) (len (.tlist maps)))
                 (push! (mut (.tlist maps)) e)
                 0))))

(defn env-binding-put! [(maps (mut SemMapsSnap)) (e BindMapEntry)] (-> i64)
  (match (get (.bindex maps) (.node-id e))
    (Some [at] (set! (.bid (elem (field maps blist) at)) (.bid e)) 0)
    (None [] (do (set! (mut (.bindex maps)) (.node-id e) (len (.blist maps)))
                 (push! (mut (.blist maps)) e)
                 0))))

(defn env-resolution-put! [(maps (mut SemMapsSnap)) (e ResMapEntry)] (-> i64)
  (unless (contains? (.rindex maps) (.node-id e))
    (push! (mut (.rlist maps)) e)
    0)
  (set! (mut (.rindex maps)) (.node-id e) (.name e))
  0)

;;; FACTS (one entry per node) recorded in MAPS over what MAPS holds.
(defn env-maps-add! [(maps (mut SemMapsSnap)) (facts (ptr SemMapsSnap))] (-> i64)
  (for [i 0 (len (.tlist facts))]
    (env-type-put! (mut maps) (get (.tlist facts) i)))
  (for [i 0 (len (.blist facts))]
    (env-binding-put! (mut maps) (get (.blist facts) i)))
  (for [i 0 (len (.rlist facts))]
    (env-resolution-put! (mut maps) (get (.rlist facts) i)))
  (when (> (.bnext facts) (.bnext maps))
    (set! (.bnext maps) (.bnext facts))
    0)
  0)

;;; The accepted state of the compilation S built, over PRIOR, the layer of the
;;; Env it built on (null for none), going where T says. Its maps are only the
;;; facts S's check recorded, less those UNDER and BELOW answer for: `env-hold`
;;; lays them over PRIOR's. Where T extends PRIOR in place, what S added is
;;; appended to PRIOR's lists and tables; the rest is shallow, sharing S's memory
;;; until the Env is copied out.
(defn env-layer [(a (dyn Allocator))
                 (s (ptr LS))
                 (prior (ptr AcceptedLayer))
                 (under (ptr SemMapsSnap))
                 (below (ptr SemMapsSnap))
                 (t (ptr EnvTarget))] (-> AcceptedLayer)
  (let [cx (primitive/cast (ptr Cx) (.checker_context s))
        ws (semantic-workspace s)
        extend (and (.extend t) (!= (primitive/cast i64 prior) 0))
        prior-funcs (if extend (len (load (.funcs (field prior checked)))) 0)
        checked (if extend
                    (env-program-over t (field prior checked) (.checked s))
                    (load (.checked s)))
        extended-funcs (and extend (= (primitive/cast i64 (.funcs checked))
                                      (primitive/cast i64 (.funcs (field prior checked)))))
        (mut functions) (if extended-funcs
                            (load (field prior functions))
                            (HashMap::new [(slice u8) i64] a (keyops-borrowed)))
        (mut sigs) (if extend (load (field prior sigs)) (ArrayList::new [Sig] a))
        (mut sigidx) (if extend (load (field prior sigidx)) (HashMap::new [(slice u8) i64] a (keyops-borrowed)))
        (mut consts) (if extend (load (field prior consts)) (ArrayList::new [ConstEntry] a))
        (mut constidx) (if extend (load (field prior constidx)) (HashMap::new [(slice u8) i64] a (keyops-borrowed)))
        ; a checker that read PRIOR's tables as its base registered only what it
        ; added; one set up whole registered everything itself
        over (if (or (= (primitive/cast i64 prior) 0)
                     (= (primitive/cast i64 cx) 0)
                     (not (.base_tables cx)))
                 (primitive/cast (ptr AcceptedLayer) 0)
                 prior)
        tables (env-tables-over a t (and extend (!= (primitive/cast i64 over) 0)) over cx)]
    (for [i (if extended-funcs prior-funcs 0) (len (load (.funcs checked)))]
      (set! (mut functions) (.name (elem (.funcs checked) i)) i))
    (if extend
        (do (env-sigs-over! t cx (mut sigs) (mut sigidx))
            (env-consts-over! t cx (mut consts) (mut constidx)))
        (do (env-sigs! a cx prior (mut sigs) (mut sigidx))
            (env-consts! a cx prior (mut consts) (mut constidx))))
    (let [(mut layer) tables]
      (set! (.functions layer) (load functions))
      (set! (.checked layer) checked)
      (set! (.sigs layer) (load sigs))
      (set! (.sigidx layer) (load sigidx))
      (set! (.consts layer) (load consts))
      (set! (.constidx layer) (load constidx))
      (set! (.maps layer) (env-live-maps a (primitive/cast (ptr SemMapsSnap) (.semantic_maps s)) under below))
      (set! (.declarations layer)
            (cond (not (.has_declaration_table ws)) (ArrayList::new [DefEntry] a)
                  extend (env-declarations-over a t (field prior declarations) (.declaration_table ws))
                  :else (load (.declaration_table ws))))
      (load layer))))

;;; A layer holding the checker tables of the next layer, and nothing else yet:
;;; OVER's (null for none), then CX's own, which a check over OVER registered
;;; after them. IN-PLACE appends CX's to OVER's, which T's pool holds.
(defn env-tables-over [(a (dyn Allocator)) (t (ptr EnvTarget)) (in-place bool)
                       (over (ptr AcceptedLayer)) (cx (ptr Cx))] (-> AcceptedLayer)
  (let [(mut layer) (primitive/zeroed AcceptedLayer)
        none (primitive/cast (ptr AcceptedLayer) 0)
        offset (if (= (primitive/cast i64 over) 0) 0 (len (.impls over)))]
    (set! (.structs layer) (env-table-over [StructInfo] a t in-place (if (= (primitive/cast i64 over) 0) (primitive/cast (ptr (ArrayList StructInfo)) 0) (field over structs)) (if (= (primitive/cast i64 cx) 0) (primitive/cast (ptr (ArrayList StructInfo)) 0) (field cx structs))))
    (set! (.sums layer) (env-table-over [SumInfo] a t in-place (if (= (primitive/cast i64 over) 0) (primitive/cast (ptr (ArrayList SumInfo)) 0) (field over sums)) (if (= (primitive/cast i64 cx) 0) (primitive/cast (ptr (ArrayList SumInfo)) 0) (field cx sums))))
    (set! (.variants layer) (env-table-over [VtoS] a t in-place (if (= (primitive/cast i64 over) 0) (primitive/cast (ptr (ArrayList VtoS)) 0) (field over variants)) (if (= (primitive/cast i64 cx) 0) (primitive/cast (ptr (ArrayList VtoS)) 0) (field cx variant_to_sum))))
    (set! (.traits layer) (env-table-over [TraitDef] a t in-place (if (= (primitive/cast i64 over) 0) (primitive/cast (ptr (ArrayList TraitDef)) 0) (field over traits)) (if (= (primitive/cast i64 cx) 0) (primitive/cast (ptr (ArrayList TraitDef)) 0) (field cx trait_defs))))
    (set! (.methods layer) (env-table-over [MethodEntry] a t in-place (if (= (primitive/cast i64 over) 0) (primitive/cast (ptr (ArrayList MethodEntry)) 0) (field over methods)) (if (= (primitive/cast i64 cx) 0) (primitive/cast (ptr (ArrayList MethodEntry)) 0) (field cx methods))))
    (set! (.impls layer) (env-table-over [ImplDef] a t in-place (if (= (primitive/cast i64 over) 0) (primitive/cast (ptr (ArrayList ImplDef)) 0) (field over impls)) (if (= (primitive/cast i64 cx) 0) (primitive/cast (ptr (ArrayList ImplDef)) 0) (field cx impls))))
    (set! (.trait_impls layer) (env-buckets-over a t in-place (if (= (primitive/cast i64 over) 0) (env-no-buckets) (field over trait_impls)) (if (= (primitive/cast i64 cx) 0) (env-no-buckets) (field cx trait_impl_idx)) offset))
    (set! (.inherent_impls layer) (env-buckets-over a t in-place (if (= (primitive/cast i64 over) 0) (env-no-buckets) (field over inherent_impls)) (if (= (primitive/cast i64 cx) 0) (env-no-buckets) (field cx inherent_impl_idx)) offset))
    (set! (.inherent_names layer) (env-buckets-over a t in-place (if (= (primitive/cast i64 over) 0) (env-no-buckets) (field over inherent_names)) (if (= (primitive/cast i64 cx) 0) (env-no-buckets) (field cx inherent_name_idx)) offset))
    (load layer)))

;;; A checker table of the next layer: PRIOR's entries (null for none), then OWN's,
;;; which a check over PRIOR registered after them. IN-PLACE: PRIOR's list itself,
;;; in T's pool, with OWN's entries copied in after its own.
(defn env-table-over [(T Persist)] [(a (dyn Allocator)) (t (ptr EnvTarget)) (in-place bool)
                                    (prior (ptr (ArrayList T))) (own (ptr (ArrayList T)))] (-> (ArrayList T))
  (if (and in-place (!= (primitive/cast i64 prior) 0))
      (let [(mut out) (load prior)]
        (unless (= (primitive/cast i64 own) 0)
          (for [i 0 (len (load own))] (push! (mut out) (env-into (at (load own) i) t)))
          0)
        out)
      (env-table-copy [T] a prior own)))

(defn env-table-copy [T] [(a (dyn Allocator)) (prior (ptr (ArrayList T))) (own (ptr (ArrayList T)))] (-> (ArrayList T))
  (let [(mut out) (ArrayList::new [T] a)]
    (unless (= (primitive/cast i64 prior) 0)
      (for [i 0 (len (load prior))] (push! (mut out) (get (load prior) i)))
      0)
    (unless (= (primitive/cast i64 own) 0)
      (for [i 0 (len (load own))] (push! (mut out) (get (load own) i)))
      0)
    (load out)))

(defn env-no-buckets [] (-> (ptr (HashMap (slice u8) (ptr ImplBucket))))
  (primitive/cast (ptr (HashMap (slice u8) (ptr ImplBucket))) 0))

;;; An impl index of the next layer: PRIOR's buckets with OWN's positions, which
;;; are in the checker's own list and so come OFFSET after PRIOR's, added to each
;;; key's. IN-PLACE: PRIOR's index and buckets themselves, in T's pool, added to.
(defn env-buckets-over [(a (dyn Allocator))
                        (t (ptr EnvTarget))
                        (in-place bool)
                        (prior (ptr (HashMap (slice u8) (ptr ImplBucket))))
                        (own (ptr (HashMap (slice u8) (ptr ImplBucket))))
                        (offset i64)] (-> (HashMap (slice u8) (ptr ImplBucket)))
  (if (and in-place (!= (primitive/cast i64 prior) 0))
      (let [(mut out) (load prior)]
        (unless (= (primitive/cast i64 own) 0)
          (for-entries [k v (load own)]
            (match (get out (load k))
              (Some [bucket] (for [i 0 (len (.items (load v)))]
                               (push! (mut (.items bucket)) (+ offset (get (.items (load v)) i)))))
              ; the index owns its keys, so it copies this one into the pool itself
              (None [] (let [slot (primitive/alloc-stack (ptr ImplBucket))]
                         (store! slot (env-bucket-copy a (primitive/cast (ptr ImplBucket) 0) (load v) offset))
                         (set! (mut out) (load k) (env-into [(ptr ImplBucket)] slot t))
                         0))))
          0)
        out)
      (env-buckets-copy a prior own offset)))

(defn env-buckets-copy [(a (dyn Allocator))
                        (prior (ptr (HashMap (slice u8) (ptr ImplBucket))))
                        (own (ptr (HashMap (slice u8) (ptr ImplBucket))))
                        (offset i64)] (-> (HashMap (slice u8) (ptr ImplBucket)))
  (let [(mut out) (HashMap::new [(slice u8) (ptr ImplBucket)] a (keyops))]
    (unless (= (primitive/cast i64 prior) 0)
      (for-entries [k v (load prior)]
        (set! (mut out) (load k) (env-bucket-copy a (load v) (primitive/cast (ptr ImplBucket) 0) 0)))
      0)
    (unless (= (primitive/cast i64 own) 0)
      (for-entries [k v (load own)]
        (set! (mut out) (load k)
              (env-bucket-copy a (match (get out (load k)) (Some [b] b) (None [] (primitive/cast (ptr ImplBucket) 0)))
                               (load v) offset)))
      0)
    (load out)))

;;; A new bucket holding FIRST's positions (null for none), then MORE's moved
;;; OFFSET along.
(defn env-bucket-copy [(a (dyn Allocator)) (first (ptr ImplBucket)) (more (ptr ImplBucket)) (offset i64)] (-> (ptr ImplBucket))
  (let [(mut items) (ArrayList::new [i64] a)]
    (unless (= (primitive/cast i64 first) 0)
      (for [i 0 (len (.items first))] (push! (mut items) (get (.items first) i)))
      0)
    (unless (= (primitive/cast i64 more) 0)
      (for [i 0 (len (.items more))] (push! (mut items) (+ offset (get (.items more) i))))
      0)
    (box! a ImplBucket (ImplBucket :items (load items)))))

;;; PRIOR's type resolutions that RECORDED does not answer, then RECORDED's: the
;;; last answer for a (module, name) wins, as it does in the registry.
(defn env-type-refs [(a (dyn Allocator))
                     (prior (ptr (ArrayList TypeResEntry)))
                     (recorded (ptr (ArrayList TypeResEntry)))] (-> (ArrayList TypeResEntry))
  (let [(mut seen) (HashMap::new [(slice u8) i64] a (keyops))
        (mut out) (ArrayList::new [TypeResEntry] a)]
    (unless (= (primitive/cast i64 recorded) 0)
      (for [i 0 (len (load recorded))]
        (let [e (elem recorded i)]
          (set! (mut seen) (sconcat3 a (.module e) " " (.raw e)) i))))
    (unless (= (primitive/cast i64 prior) 0)
      (for [i 0 (len (load prior))]
        (let [e (elem prior i)]
          (unless (contains? seen (sconcat3 a (.module e) " " (.raw e)))
            (push! (mut out) (load e))
            0))))
    (unless (= (primitive/cast i64 recorded) 0)
      (for [i 0 (len (load recorded))]
        (let [e (elem recorded i)]
          (when (= (get seen (sconcat3 a (.module e) " " (.raw e))) (Some i))
            (push! (mut out) (load e))
            0))))
    (load out)))

(defn env-value-refs [(a (dyn Allocator))
                      (prior (ptr (ArrayList ValueResEntry)))
                      (recorded (ptr (ArrayList ValueResEntry)))] (-> (ArrayList ValueResEntry))
  (let [(mut seen) (HashMap::new [(slice u8) i64] a (keyops))
        (mut out) (ArrayList::new [ValueResEntry] a)]
    (unless (= (primitive/cast i64 recorded) 0)
      (for [i 0 (len (load recorded))]
        (let [e (elem recorded i)]
          (set! (mut seen) (sconcat3 a (.module e) " " (.raw e)) i))))
    (unless (= (primitive/cast i64 prior) 0)
      (for [i 0 (len (load prior))]
        (let [e (elem prior i)]
          (unless (contains? seen (sconcat3 a (.module e) " " (.raw e)))
            (push! (mut out) (load e))
            0))))
    (unless (= (primitive/cast i64 recorded) 0)
      (for [i 0 (len (load recorded))]
        (let [e (elem recorded i)]
          (when (= (get seen (sconcat3 a (.module e) " " (.raw e))) (Some i))
            (push! (mut out) (load e))
            0))))
    (load out)))

;;; RECORDED's source modules, then PRIOR's for sources RECORDED has none for:
;;; the first entry for a source is its module.
(defn env-source-modules [(a (dyn Allocator))
                          (prior (ptr (ArrayList SrcModEntry)))
                          (recorded (ptr (ArrayList SrcModEntry)))] (-> (ArrayList SrcModEntry))
  (let [(mut seen) (HashMap::new [i64 i64] a (i64-keyops))
        (mut out) (ArrayList::new [SrcModEntry] a)]
    (unless (= (primitive/cast i64 recorded) 0)
      (for [i 0 (len (load recorded))]
        (let [e (elem recorded i)]
          (set! (mut seen) (.source e) 1)
          (push! (mut out) (load e)))))
    (unless (= (primitive/cast i64 prior) 0)
      (for [i 0 (len (load prior))]
        (let [e (elem prior i)]
          (unless (contains? seen (.source e))
            (push! (mut out) (load e))
            0))))
    (load out)))

;;; The key a type or value resolution is indexed by: its module and spelling.
(defn env-ref-key [(a (dyn Allocator)) (module (slice u8)) (raw (slice u8))] (-> (slice u8))
  (sconcat3 a module " " raw))

;;; The type resolutions of the next Env, into ENV: PRIOR's, with each RECORDED
;;; made replacing the one of its module and spelling, or added. IN-PLACE extends
;;; PRIOR's list and index, in T's pool.
(defn env-type-refs-next! [(a (dyn Allocator)) (t (ptr EnvTarget)) (in-place bool) (prior (ptr Env))
                           (recorded (ptr (ArrayList TypeResEntry))) (env (mut Env))] (-> i64)
  (if in-place
      (let [(mut lst) (load (field prior type_refs))
            (mut idx) (load (field prior type_ref_index))]
        (unless (= (primitive/cast i64 recorded) 0)
          (for [i 0 (len (load recorded))]
            (let [e (elem recorded i)
                  kept (env-into [TypeResEntry] e t)
                  key (env-ref-key a (.module e) (.raw e))]
              ; the index owns its keys: it copies KEY into the pool itself
              (match (get idx key)
                (Some [at] (set! (mut lst) at kept) 0)
                (None [] (do (set! (mut idx) key (len lst)) (push! (mut lst) kept) 0)))))
          0)
        (set! (.type_refs env) (load lst))
        (set! (.type_ref_index env) (load idx))
        0)
      (let [(mut lst) (env-type-refs a (if (= (primitive/cast i64 prior) 0)
                                     (primitive/cast (ptr (ArrayList TypeResEntry)) 0)
                                     (field prior type_refs))
                               recorded)
            (mut idx) (HashMap::new [(slice u8) i64] a (keyops))]
        (for [i 0 (len lst)]
          (set! (mut idx) (env-ref-key a (.module (elem (mut lst) i))
                                       (.raw (elem (mut lst) i)))
                i))
        (set! (.type_refs env) (load lst))
        (set! (.type_ref_index env) (load idx))
        0)))

;;; `env-type-refs-next!` for value resolutions.
(defn env-value-refs-next! [(a (dyn Allocator)) (t (ptr EnvTarget)) (in-place bool) (prior (ptr Env))
                            (recorded (ptr (ArrayList ValueResEntry))) (env (mut Env))] (-> i64)
  (if in-place
      (let [(mut lst) (load (field prior value_refs))
            (mut idx) (load (field prior value_ref_index))]
        (unless (= (primitive/cast i64 recorded) 0)
          (for [i 0 (len (load recorded))]
            (let [e (elem recorded i)
                  kept (env-into [ValueResEntry] e t)
                  key (env-ref-key a (.module e) (.raw e))]
              (match (get idx key)
                (Some [at] (set! (mut lst) at kept) 0)
                (None [] (do (set! (mut idx) key (len lst)) (push! (mut lst) kept) 0)))))
          0)
        (set! (.value_refs env) (load lst))
        (set! (.value_ref_index env) (load idx))
        0)
      (let [(mut lst) (env-value-refs a (if (= (primitive/cast i64 prior) 0)
                                      (primitive/cast (ptr (ArrayList ValueResEntry)) 0)
                                      (field prior value_refs))
                                recorded)
            (mut idx) (HashMap::new [(slice u8) i64] a (keyops))]
        (for [i 0 (len lst)]
          (set! (mut idx) (env-ref-key a (.module (elem (mut lst) i))
                                       (.raw (elem (mut lst) i)))
                i))
        (set! (.value_refs env) (load lst))
        (set! (.value_ref_index env) (load idx))
        0)))

;;; The source modules of the next Env, into ENV: RECORDED's, then PRIOR's for
;;; sources RECORDED has none for. IN-PLACE appends RECORDED's to PRIOR's when
;;; they are of sources PRIOR has none for, as a submission's own sources are.
(defn env-source-modules-next! [(a (dyn Allocator)) (t (ptr EnvTarget)) (in-place bool) (prior (ptr Env))
                                (recorded (ptr (ArrayList SrcModEntry))) (env (mut Env))] (-> i64)
  (let [fresh-sources
          (and in-place
               (or (= (primitive/cast i64 recorded) 0)
                   (block :all
                     (for [i 0 (len (load recorded))]
                       (when (contains? (.source_module_index prior) (.source (elem recorded i)))
                         (break :all false)))
                     true)))]
    (if fresh-sources
        (let [(mut lst) (load (field prior source_modules))
              (mut idx) (load (field prior source_module_index))]
          (unless (= (primitive/cast i64 recorded) 0)
            (for [i 0 (len (load recorded))]
              (let [e (elem recorded i)]
                (push! (mut lst) (env-into [SrcModEntry] e t))
                (set! (mut idx) (.source e) 1)))
            0)
          (set! (.source_modules env) (load lst))
          (set! (.source_module_index env) (load idx))
          0)
        (let [(mut lst) (env-source-modules a (if (= (primitive/cast i64 prior) 0)
                                            (primitive/cast (ptr (ArrayList SrcModEntry)) 0)
                                            (field prior source_modules))
                                      recorded)
              (mut idx) (HashMap::new [i64 i64] a (i64-keyops))]
          (for [i 0 (len lst)]
            (set! (mut idx) (.source (elem (mut lst) i)) 1))
          (set! (.source_modules env) (load lst))
          (set! (.source_module_index env) (load idx))
          0))))

;;; The native program of the next Env, into ENV: PRIOR's, with what NATIVE has
;;; that it does not added: functions (as declarations: later compiles call them
;;; and never compile them again, mono's adopt-prior!), structs, sums, constants
;;; and instance origins, each found by name in the index. IN-PLACE adds to
;;; PRIOR's own lists and index, in T's pool.
(defn env-native-next! [(a (dyn Allocator)) (t (ptr EnvTarget)) (in-place bool) (prior (ptr Env))
                        (native (ptr Program)) (env (mut Env))] (-> i64)
  (let [(mut out) (if in-place (load (field prior native)) (env-native-empty a))
        (mut idx) (if in-place (load (field prior native_index)) (HashMap::new [(slice u8) i64] a (keyops)))
        target (if in-place t (primitive/cast (ptr EnvTarget) 0))]
    (for [i 0 (len (load (.funcs native)))]
      (let [(mut f) (load (elem (.funcs native) i))
            key (sconcat a "f " (.name f))]
        (unless (contains? idx key)
          (set! (.declared f) true)
          (set! (.body f) (box-al [Expr] a (ArrayList::new [Expr] a)))
          (set! (mut idx) key (len (load (.funcs out))))
          (push! (.funcs out) (env-native-entry [Func] target (mut f)))
          0)))
    (for [i 0 (len (load (.structs native)))]
      (let [d (elem (.structs native) i)
            key (sconcat a "s " (.name d))]
        (unless (contains? idx key)
          (set! (mut idx) key (len (load (.structs out))))
          (push! (.structs out) (env-native-entry [StructDef] target d))
          0)))
    (for [i 0 (len (load (.sums native)))]
      (let [d (elem (.sums native) i)
            key (sconcat a "u " (.name d))]
        (unless (contains? idx key)
          (set! (mut idx) key (len (load (.sums out))))
          (push! (.sums out) (env-native-entry [SumDef] target d))
          0)))
    (for [i 0 (len (load (.consts native)))]
      (let [d (elem (.consts native) i)
            key (sconcat a "c " (.name d))]
        (unless (contains? idx key)
          (set! (mut idx) key (len (load (.consts out))))
          (push! (.consts out) (env-native-entry [Const] target d))
          0)))
    (unless (= (primitive/cast i64 (.mono_origins native)) 0)
      (for [i 0 (len (load (.mono_origins native)))]
        (let [d (elem (.mono_origins native) i)
              key (sconcat a "o " (.generated d))]
          (unless (contains? idx key)
            (set! (mut idx) key (len (load (.mono_origins out))))
            (push! (.mono_origins out) (env-native-entry [MonoOrigin] target d))
            0)))
      0)
    (set! (.native env) (load out))
    (set! (.native_index env) (load idx))
    0))

;;; Whether the checked program P retired anything of the state it was built on.
(defn env-retires? [(p (ptr Program))] (-> bool)
  (or (and (!= (primitive/cast i64 (.retirements p)) 0) (> (len (load (.retirements p))) 0))
      (and (!= (primitive/cast i64 (.retired_functions p)) 0) (> (len (load (.retired_functions p))) 0))))

;;; X as the next Env's native program holds it: copied into T's pool when T is
;;; given (the program is extended in place), else as it is.
(defn env-native-entry [(T Persist)] [(t (ptr EnvTarget)) (x (ref T))] (-> T)
  (if (= (primitive/cast i64 t) 0) (load x) (env-into [T] x t)))

;;; A native program with nothing in it, its lists allocated from A.
(defn env-native-empty [(a (dyn Allocator))] (-> Program)
  (let [(mut p) (primitive/zeroed Program)]
    (set! (.annotation_defs p) (box-al [AnnotationDef] a (ArrayList::new [AnnotationDef] a)))
    (set! (.conventions p) (box-al [Convention] a (ArrayList::new [Convention] a)))
    (set! (.structs p) (box-al [StructDef] a (ArrayList::new [StructDef] a)))
    (set! (.sums p) (box-al [SumDef] a (ArrayList::new [SumDef] a)))
    (set! (.externs p) (box-al [Extern] a (ArrayList::new [Extern] a)))
    (set! (.funcs p) (box-al [Func] a (ArrayList::new [Func] a)))
    (set! (.asserts p) (box-al [StaticAssert] a (ArrayList::new [StaticAssert] a)))
    (set! (.consts p) (box-al [Const] a (ArrayList::new [Const] a)))
    (set! (.traits p) (box-al [TraitDef] a (ArrayList::new [TraitDef] a)))
    (set! (.impls p) (box-al [ImplDef] a (ArrayList::new [ImplDef] a)))
    (set! (.metas p) (box-al [Expr] a (ArrayList::new [Expr] a)))
    (set! (.exports p) (box-al [ExportC] a (ArrayList::new [ExportC] a)))
    (set! (.function_abis p) (box-al [Extern] a (ArrayList::new [Extern] a)))
    (set! (.mono_origins p) (box-al [MonoOrigin] a (ArrayList::new [MonoOrigin] a)))
    (set! (.mono_trait_uses p) (box-al [MonoTraitUse] a (ArrayList::new [MonoTraitUse] a)))
    (set! (.unit_exports p) (box-al [(slice u8)] a (ArrayList::new [(slice u8)] a)))
    (set! (.aliases p) (box-al [AliasDef] a (ArrayList::new [AliasDef] a)))
    (load p)))

;;; The Env a compilation leaves when it is accepted: S is its loader state (with
;;; its metaprogram environment), AST its resolution registries, ENGINE its
;;; metaprograms and NATIVE its native program, built over PRIOR (null for the
;;; first), going where T says. Shallow, but for what T extends of PRIOR in
;;; place: `env-hold` copies it out.
(defn env-of [(a (dyn Allocator))
              (s (ptr LS))
              (ast (ptr AstUnitState))
              (engine (ptr MetaEngine))
              (native (ptr Program))
              (prior (ptr Env))
              (t (ptr EnvTarget))
              (next-node-id i64)
              (next-form i64)
              (next-gensym GsCell)
              (next-elaboration i64)] (-> Env)
  (let [none (primitive/cast (ptr AcceptedLayer) 0)
        no-maps (primitive/cast (ptr SemMapsSnap) 0)
        prior-app (if (= (primitive/cast i64 prior) 0) none (field prior app))
        prior-meta (if (= (primitive/cast i64 prior) 0) none (.meta prior))
        app (env-layer a s prior-app no-maps no-maps t)
        meta-ls (.meta_environment s)
        meta (cond (= (primitive/cast i64 meta-ls) 0) none
                   ; no metaprogram was compiled: the environment is the view of PRIOR's
                   (and (!= (primitive/cast i64 prior-meta) 0)
                        (= (primitive/cast i64 (.semantic_maps meta-ls))
                           (primitive/cast i64 (field prior-meta maps))))
                     prior-meta
                   :else
                     (box! a AcceptedLayer
                           (env-layer a meta-ls prior-meta (primitive/cast (ptr SemMapsSnap) (field app maps))
                                      (if (= (primitive/cast i64 prior-app) 0)
                                          no-maps
                                          (field prior-app maps))
                                      t)))
        (mut loader) (if (and (.extend t) (!= (primitive/cast i64 prior) 0))
                         (env-loader-over t (field prior loader) s)
                         (load s))
        (mut entries) (ArrayList::new [EnvMetaEntry] a)
        (mut registries) (ArrayList::new [(ptr (ArrayList (ptr Sexp)))] a)
        (mut registry-at) (HashMap::new [i64 i64] a (i64-keyops))]
    (let [es (.entries engine)]
      (unless (= (primitive/cast i64 es) 0)
        (for [i 0 (len (load es))]
          (let [e (elem es i)
                key (primitive/cast i64 (.registry e))
                at (cond (= key 0) -1
                         (contains? registry-at key) (match (get registry-at key) (Some [k] k) (None [] -1))
                         :else (let [k (len registries)]
                                 (set! (mut registry-at) key k)
                                 (push! (mut registries) (.registry e))
                                 k))]
            (push! (mut entries)
                   (EnvMetaEntry :name (.name e) :symbol (.symbol e)
                                 :modbytes (.modbytes e) :registry at))))
        0))
    (set! (.checked_functions loader) (.functions app))
    (let [in-place (and (.extend t) (!= (primitive/cast i64 prior) 0))
          (mut env) (primitive/zeroed Env)]
      (env-type-refs-next! a t in-place prior
                           (if (= (.init (.type_refs ast)) 0)
                               (primitive/cast (ptr (ArrayList TypeResEntry)) 0)
                               (.lst (.type_refs ast)))
                           (mut env))
      (env-value-refs-next! a t in-place prior
                            (if (= (.init (.value_refs ast)) 0)
                                (primitive/cast (ptr (ArrayList ValueResEntry)) 0)
                                (.lst (.value_refs ast)))
                            (mut env))
      (env-source-modules-next! a t in-place prior
                                (if (= (.init (.source_modules ast)) 0)
                                    (primitive/cast (ptr (ArrayList SrcModEntry)) 0)
                                    (.lst (.source_modules ast)))
                                (mut env))
      ; a retirement removes what PRIOR's native program holds: only a compile
      ; that retired nothing adds to it
      (env-native-next! a t (and in-place (not (env-retires? (.checked s)))) prior native (mut env))
    (Env
      :loader (load loader)
      :app app
      :meta meta
      :type_refs (.type_refs env)
      :value_refs (.value_refs env)
      :source_modules (.source_modules env)
      :type_ref_index (.type_ref_index env)
      :value_ref_index (.value_ref_index env)
      :source_module_index (.source_module_index env)
      :core_providers (.core_providers ast)
      :core_declarations (.core_declarations ast)
      :engine_active (.active engine)
      :engine (load entries)
      :registries (load registries)
      :native (.native env)
      :native_index (.native_index env)
      :next_node_id next-node-id
      :next_form next-form
      :next_gensym next-gensym
      :next_elaboration next-elaboration))))

;;; Whether P is memory of the pool at CX.
(defn env-pool-owns? [(cx (ptr i8)) (p (ptr i8))] (-> bool)
  (scratch/ScratchArena::owns-address? (field (primitive/cast (ptr EnvPool) cx) arena) p))

(defn env-pool-new [] (-> (ptr EnvPool))
  (let [pool (box! (malloc-allocator) EnvPool (primitive/zeroed EnvPool))]
    (scratch/ScratchArena::init-with-capacity (field pool arena) (large-pages/compiler-scratch-for "env.pool") 1048576)
    (large-pages/observe-arena! (field pool arena) "env.pool")
    pool))

;;; LAYER's maps, the facts its compile recorded (copied out already, into A),
;;; laid over PRIOR's (null for none). EXTEND: the Env PRIOR belongs to goes when
;;; this one is held, and nothing else holds it, so its maps are extended in place.
;;; Otherwise they are copied: entry by entry when A is their pool too (the entries
;;; stay shared), whole when A is a new pool.
(defn env-maps-over! [(a (dyn Allocator))
                      (layer (ptr AcceptedLayer))
                      (prior (ptr AcceptedLayer))
                      (extend bool)
                      (fresh bool)] (-> i64)
  (unless (= (primitive/cast i64 prior) 0)
    (let [none (primitive/cast (ptr SemMapsSnap) 0)
          (mut maps) (cond extend (load (field prior maps))
                           fresh (persist-clone (field prior maps) a)
                           :else (env-live-maps a (field prior maps) none none))]
      (env-maps-add! (mut maps) (field layer maps))
      (set! (.maps layer) (load maps))
      0))
  0)

;;; Copy ENV out of the compile that built it, held once, with the handles
;;; ENGINE's entries were loaded as, into the pool T names. BASE is the Env it was
;;; built on, or null: in BASE's pool ENV shares what BASE has there, and what T
;;; extends of it in place is ENV's already. The memory comes from the process,
;;; not from whoever asks: an Env is freed when its last holder lets go, which an
;;; arena would never do.
(defn env-hold [(env (ref Env)) (engine (ptr MetaEngine)) (base (ptr EnvHolder)) (t (ptr EnvTarget))] (-> (ptr EnvHolder))
  (let [holder (box! (malloc-allocator) EnvHolder (primitive/zeroed EnvHolder))
        reuse (not (.fresh t))
        pool (.pool t)
        a (scratch/ScratchArena::allocator (field pool arena))
        prior (if (= (primitive/cast i64 base) 0) (primitive/cast (ptr Env) 0) (field base env))
        none (primitive/cast (ptr AcceptedLayer) 0)
        meta-reused (and (!= (primitive/cast i64 prior) 0)
                         (!= (primitive/cast i64 (.meta prior)) 0)
                         (= (primitive/cast i64 (.meta env)) (primitive/cast i64 (.meta prior))))]
    (set! (.pool holder) pool)
    (set! (.refs pool) (+ (.refs pool) 1))
    (set! (.env holder)
          (if reuse
              (persist-clone-sharing env a (fnptr-of env-pool-owns?) (primitive/cast (ptr i8) pool))
              (persist-clone env a)))
    (unless (= (primitive/cast i64 prior) 0)
      (env-maps-over! a (field (field holder env) app) (field prior app) (.extend t) (not reuse))
      (unless (or meta-reused (= (primitive/cast i64 (.meta (field holder env))) 0))
        (env-maps-over! a (.meta (field holder env)) (.meta prior) (.extend t) (not reuse))
        0)
      0)
    (unless reuse
      (set! (.compacted pool) (scratch/ScratchArena::total (field pool arena)))
      0)
    (set! (.handles holder) (ArrayList::new [EnvHandle] (malloc-allocator)))
    (let [es (.entries engine)]
      (unless (= (primitive/cast i64 es) 0)
        (for [i 0 (len (load es))]
          (let [e (elem es i)]
            (push! (mut (.handles holder)) (EnvHandle :fp (.fp e) :interpcx (.interpcx e)))))
        0))
    (set! (.holds holder) 1)
    holder))

;;; The metaprogram entries of HOLDER's Env, loaded, in A: what a compile that
;;; builds on it starts its engine with.
(defn env-engine-entries [(a (dyn Allocator)) (holder (ptr EnvHolder))] (-> (ptr (ArrayList MEEntry)))
  (let [env (field holder env)
        (mut out) (ArrayList::new [MEEntry] a)]
    (for [i 0 (len (.engine env))]
      (let [e (elem (field env engine) i)
            h (elem (field holder handles) i)]
        (push! (mut out)
               (MEEntry :name (.name e)
                        :fp (.fp h)
                        :registry (if (< (.registry e) 0)
                                      (primitive/cast (ptr (ArrayList (ptr Sexp))) 0)
                                      (get (.registries env) (.registry e)))
                        :symbol (.symbol e) :modbytes (.modbytes e) :interpcx (.interpcx h)))))
    (box! a (ArrayList MEEntry) (load out))))

(defn env-retain! [(holder (ptr EnvHolder))] (-> i64)
  (set! (.holds holder) (+ (.holds holder) 1))
  0)

;;; Give up one hold; the last gives up the Env's place in its pool, and the last
;;; Env of a pool frees it.
(defn env-release! [(holder (ptr EnvHolder))] (-> i64)
  (set! (.holds holder) (- (.holds holder) 1))
  (when (= (.holds holder) 0)
    (let [pool (.pool holder)]
      (set! (.refs pool) (- (.refs pool) 1))
      (when (= (.refs pool) 0)
        (scratch/ScratchArena::close! (field pool arena))
        (free [EnvPool] (malloc-allocator) (slice::new pool 1))
        0))
    (free! (mut (.handles holder)))
    (free [EnvHolder] (malloc-allocator) (slice::new holder 1))
    0)
  0)

;;; Whether HOLDER's Env may be changed in place: one hold on it, and no other Env
;;; in its pool, since Envs in one pool share what they have in common.
(defn env-exclusive? [(holder (ptr EnvHolder))] (-> bool)
  (and (= (.holds holder) 1) (= (.refs (.pool holder)) 1)))

;;; How many bytes the pool the Env lives in holds.
(defn env-bytes [(holder (ptr EnvHolder))] (-> i64)
  (scratch/ScratchArena::total (field (.pool holder) arena)))

; ---- reading an Env -----------------------------------------------------------
;;; A loader state, in A, that reads LAYER over LOADER: the accepted state a
;;; compile builds on. Its lists are LOADER's; its functions, checker context,
;;; maps and declaration table are the layer's, and it builds on nothing. META is
;;; the view of the metaprogram environment, or null; AST the resolution registries.
(defn env-layer-view [(a (dyn Allocator))
                      (loader (ptr LS))
                      (layer (ptr AcceptedLayer))
                      (meta (ptr LS))
                      (ast (ptr AstUnitState))] (-> (ptr LS))
  (let [s (box! a LS (load loader))
        cx (box! a Cx (primitive/zeroed Cx))
        ws (box! a SemanticWorkspace (primitive/zeroed SemanticWorkspace))]
    (set! (.sigs cx) (.sigs layer))
    (set! (.sigidx cx) (.sigidx layer))
    (set! (.consts cx) (.consts layer))
    (set! (.constidx cx) (.constidx layer))
    (set! (.structs cx) (.structs layer))
    (set! (.sums cx) (.sums layer))
    (set! (.variant_to_sum cx) (.variants layer))
    (set! (.trait_defs cx) (.traits layer))
    (set! (.methods cx) (.methods layer))
    (set! (.impls cx) (.impls layer))
    (set! (.trait_impl_idx cx) (.trait_impls layer))
    (set! (.inherent_impl_idx cx) (.inherent_impls layer))
    (set! (.inherent_name_idx cx) (.inherent_names layer))
    (set! (.declaration_table ws) (field layer declarations))
    (set! (.has_declaration_table ws) true)
    (set! (.a s) a)
    (set! (.checked_functions s) (.functions layer))
    (set! (.parent s) (primitive/cast (ptr LS) 0))
    (set! (.checked s) (field layer checked))
    (set! (.checker_context s) (primitive/cast (ptr i8) cx))
    (set! (.semantic_maps s) (primitive/cast (ptr i8) (field layer maps)))
    (set! (.semantic_workspace s)
          (box! a SemanticWorkspaceSlot
                (SemanticWorkspaceSlot :value (primitive/cast (ptr i8) ws) :owner a)))
    (set! (.semantic_audit s) (box! a SemanticAudit (primitive/zeroed SemanticAudit)))
    (set! (.resolution_state s) ast)
    (set! (.meta_environment s) meta)
    (set! (.out s) (ArrayList::new [TaggedForm] a))
    (set! (.probed s) (ArrayList::new [ProbedModule] a))
    s))

;;; The resolution registries of ENV as the state a compile's falls back to.
(defn env-ast-view [(a (dyn Allocator)) (env (ptr Env))] (-> (ptr AstUnitState))
  (let [ast (box! a AstUnitState (primitive/zeroed AstUnitState))
        modules (field ast source_modules)]
    (set! (.init (field ast type_refs)) 1)
    (set! (.lst (field ast type_refs)) (field env type_refs))
    (set! (.init (field ast value_refs)) 1)
    (set! (.lst (field ast value_refs)) (field env value_refs))
    (set! (.init (field ast source_modules)) 1)
    (set! (.lst (field ast source_modules)) (field env source_modules))
    (scratch/ScratchArena::init-with-capacity (field modules arena) a 4096)
    (src-mod-modules-reset! modules)
    (set! (.core_providers ast) (.core_providers env))
    (set! (.core_declarations ast) (.core_declarations env))
    ast))

;;; The loader state a compile builds on, reading ENV, in A.
(defn env-view [(a (dyn Allocator)) (env (ptr Env))] (-> (ptr LS))
  (let [ast (env-ast-view a env)
        meta (if (= (primitive/cast i64 (.meta env)) 0)
                 (primitive/cast (ptr LS) 0)
                 (env-layer-view a (field env loader) (.meta env) (primitive/cast (ptr LS) 0) ast))]
    (env-layer-view a (field env loader) (field env app) meta ast)))

;;; The function NAME the Env's application state defines, or None.
(defn env-function [(env (ptr Env)) (name (slice u8))] (-> (Option (ptr Func)))
  (let [layer (field env app)]
    (match (get (.functions layer) name)
      (None [] (None [(ptr Func)]))
      (Some [index] (Some (elem (.funcs (field layer checked)) index))))))

; ---- saving an Env ------------------------------------------------------------
;;; The first line of a saved Env. The two that follow name the toolchain that
;;; wrote it and the target it compiled for: the bytes are the Env's layout as
;;; that build of the compiler sees it, so only that build reads them back.
(const ENV-SAVE-MAGIC "coil saved compiler state 1\n")

;;; HOLDER's Env as bytes in A, or why it cannot be saved. Its metaprograms are
;;; not saved: they are code this process loaded, and a compile on the state read
;;; back builds the ones it calls again from the definitions the state keeps.
(defn env-save [(a (dyn Allocator)) (holder (ptr EnvHolder))] (-> (Result (slice u8) (slice u8)))
  (match (toolchain-digest a)
    (None [] (Err [(slice u8) (slice u8)]
                  "this compiler records no toolchain digest, so nothing could tell which build may read a saved state"))
    (Some [digest]
      (let [(mut env) (load (field holder env))
            (mut out) (ArrayList::new [u8] a)]
        (set! (.engine_active env) 0)
        (set! (.engine env) (ArrayList::new [EnvMetaEntry] a))
        (set! (.registries env) (ArrayList::new [(ptr (ArrayList (ptr Sexp)))] a))
        (let [body (persist-save env a)]
          (env-save-text! (mut out) ENV-SAVE-MAGIC)
          (env-save-text! (mut out) (sconcat3 a digest "\n" (sconcat a (toolchain-target a) "\n")))
          (extend! (mut out) (data body) (len body))
          (Ok [(slice u8) (slice u8)] (slice out)))))))

(defn env-save-text! [(out (mut (ArrayList u8))) (text (slice u8))] (-> i64)
  (extend! (mut out) (data text) (len text))
  0)

;;; The line of BYTES that starts at AT, and where the next one starts; None
;;; when no newline ends it.
(defn env-saved-line [(bytes (slice u8)) (at i64)] (-> (Option (slice u8)))
  (block :found
    (for [i at (len bytes)]
      (when (= (get bytes i) (: 10 u8))
        (break :found (Some (subslice bytes at i)))))
    (None [(slice u8)])))

;;; The Env BYTES hold, held once, or why they cannot be read.
(defn env-load [(a (dyn Allocator)) (bytes (slice u8))] (-> (Result (ptr EnvHolder) (slice u8)))
  (let [magic-n (len ENV-SAVE-MAGIC)]
    (if (or (< (len bytes) magic-n) (!= (subslice bytes 0 magic-n) ENV-SAVE-MAGIC))
        (Err [(ptr EnvHolder) (slice u8)] "these bytes are not a saved compiler state")
        (match (env-saved-line bytes magic-n)
          (None [] (Err [(ptr EnvHolder) (slice u8)] "the saved compiler state is cut short"))
          (Some [digest]
            (match (env-saved-line bytes (+ (+ magic-n (len digest)) 1))
              (None [] (Err [(ptr EnvHolder) (slice u8)] "the saved compiler state is cut short"))
              (Some [target]
                (let [ours (match (toolchain-digest a) (Some [d] d) (None [] ""))
                      body-at (+ (+ (+ magic-n (len digest)) 1) (+ (len target) 1))]
                  (cond (!= digest ours)
                          (Err [(ptr EnvHolder) (slice u8)]
                               (sconcat3 a "the saved compiler state was written by toolchain " digest
                                         (sconcat3 a ", not by this one (" (if (= (len ours) 0) "unstamped" ours) ")")))
                        (!= target (toolchain-target a))
                          (Err [(ptr EnvHolder) (slice u8)]
                               (sconcat3 a "the saved compiler state compiled for " target
                                         (sconcat3 a ", not for " (toolchain-target a) "")))
                        :else
                          (let [pool (env-pool-new)]
                            (match (persist-load [Env] (subslice bytes body-at (len bytes))
                                                 (scratch/ScratchArena::allocator (field pool arena)))
                              (None []
                                (do (scratch/ScratchArena::close! (field pool arena))
                                    (free [EnvPool] (malloc-allocator) (slice::new pool 1))
                                    (Err [(ptr EnvHolder) (slice u8)] "the saved compiler state is damaged: its bytes are not one state")))
                              (Some [env]
                                (let [holder (box! (malloc-allocator) EnvHolder (primitive/zeroed EnvHolder))]
                                  (set! (.pool holder) pool)
                                  (set! (.refs pool) 1)
                                  (set! (.compacted pool) (scratch/ScratchArena::total (field pool arena)))
                                  (set! (.env holder) env)
                                  (set! (.handles holder) (ArrayList::new [EnvHandle] (malloc-allocator)))
                                  (set! (.holds holder) 1)
                                  (Ok [(ptr EnvHolder) (slice u8)] holder))))))))))))))

;;; What HOLDER's Env owns, by field path, as text in A: paths DEPTH fields deep.
(defn env-footprint [(a (dyn Allocator)) (holder (ptr EnvHolder)) (depth i64)] (-> (slice u8))
  (footprint-report (persist-footprint (field holder env) a (+ depth 1)) a depth))

;;; The bytes HOLDER's Env owns.
(defn env-footprint-total [(a (dyn Allocator)) (holder (ptr EnvHolder))] (-> i64)
  (footprint-total (persist-footprint (field holder env) a 1)))
