; src/compiler/frontend/mono_subst.coil — self-host Coil compiler: the
; substitution of a generic's parameters by an instance's arguments, and the
; name an instance is given.

(module coil.compiler.mono_subst)
(import "coil.primitive" :as primitive)
(import "coil.alloc" :use *)
(import "coil.str" :use *)
(import "coil.slice" :use [subslice])
(import "coil.arraylist" :use *)
(import "coil.compiler.ast" :use *)
(import "coil.compiler.check" :use [SubstEntry subst-new subst-get pack-value?])
(import "coil.compiler.parser" :use [box-al sconcat sconcat3 unimplemented i64->str])

;;; A substitution: each type parameter's name and the type it stands for. The
;;; checker's own representation, so one substitution serves specialization and
;;; the checker's ownership elaboration alike.
;;; (`(ptr (ArrayList SubstEntry))`, built with `subst-new`.)

;;; Whether NAME is a pack parameter's spelling, `T...`.
(defn dots-name? [(s (slice u8))] (-> bool)
  (let [n (len s)] (and (>= n 3) (= (subslice s (- n 3) n) "..."))))

;;; NAME without its `...`.
(defn dots-base [(s (slice u8))] (-> (slice u8))
  (if (dots-name? s) (subslice s 0 (- (len s) 3)) s))

;;; The Ith element of the pack named BASE, `base$i`.
(defn indexed-name [(a (dyn Allocator)) (base (slice u8)) (i i64)] (-> (slice u8))
  (sconcat3 a base "$" (i64->str a i)))

;;; The type S binds NAME to.
(defn subst-find [(s (ptr (ArrayList SubstEntry))) (name (slice u8))] (-> (Option Type))
  (let [t (subst-get s name)]
    (if (= (primitive/cast i64 t) 0) (None [Type]) (Some (load t)))))

;;; Bind NAME to TY in S.
(defn subst-bind! [(s (ptr (ArrayList SubstEntry))) (name (slice u8)) (ty Type)] (-> i64)
  (push! [SubstEntry] s (SubstEntry :name name :ty ty))
  0)

;;; The substitution of a generic's type parameters PARAMS by an instance's
;;; ARGS. A pack parameter `T...` stands for the arguments its neighbours leave,
;;; as one `$pack`, unless the instance already gives it one.
(defn subst-map [(a (dyn Allocator))
                 (params (ptr (ArrayList (slice u8))))
                 (args (ptr (ArrayList Type)))] (-> (ptr (ArrayList SubstEntry)))
  (let [s (subst-new a)
        np (len (load params))
        na (len (load args))
        pack (block :found
               (for [i 0 np]
                 (when (dots-name? (get (load params) i)) (break :found i)))
               -1)]
    (if (or (< pack 0) (and (= na np) (pack-value? (elem args pack))))
        (for [i 0 (if (< na np) na np)]
          (subst-bind! s (get (load params) i) (get (load args) i)))
        (let [tail (- np (+ pack 1))
              count (- na (+ pack tail))
              (mut packed) (ArrayList::new [Type] a)]
          (for [i 0 pack]
            (subst-bind! s (get (load params) i) (get (load args) i)))
          (for [j 0 count]
            (push! (mut packed) (get (load args) (+ pack j))))
          (subst-bind! s (get (load params) pack) (TApp "$pack" (box-al [Type] a (load packed))))
          (for [j 0 tail]
            (subst-bind! s
                         (get (load params) (+ pack (+ 1 j)))
                         (get (load args) (+ pack (+ count j)))))))
    s))

;;; The elements of the pack S binds, or null when it binds none.
(defn subst-pack [(s (ptr (ArrayList SubstEntry)))] (-> (ptr (ArrayList Type)))
  (block :found
    (for [i 0 (len (load s))]
      (match (.ty (elem s i))
        (TApp [name args] (when (= name "$pack") (break :found args)))
        (_ 0)))
    (primitive/cast (ptr (ArrayList Type)) 0)))

;;; ---- instance names ----------------------------------------------------------
;;; An instance is named for its generic and its arguments, `ArrayList__i64`. Two
;;; different argument lists must never share a name: the definitions are kept by
;;; name, and a second instance under the first one's name would replace it.

;;; A generic constant argument's part of a name: `const4`, `consttrue`,
;;; `constkw_meters`.
(defn const-type-key [(a (dyn Allocator)) (v ConstValue)] (-> (slice u8))
  (match v
    (ConstInt [n] (sconcat a "const" (i64->str a n)))
    (ConstBool [b] (if b "consttrue" "constfalse"))
    (ConstKeyword [name] (sconcat a "constkw_" name))
    (ConstRef [name]
              (do (unimplemented "mono: a (const NAME) generic argument reached specialization unresolved (compiler bug)")
                  ""))))

;;; A type argument's part of an instance name.
(defn type-key [(a (dyn Allocator)) (t (ptr Type))] (-> (slice u8))
  (match (load t)
    (TInt [bits signed] (sconcat a (if signed "i" "u") (i64->str a bits)))
    (TFloat [bits] (sconcat a "f" (i64->str a bits)))
    (TBool [] "bool")
    (TVoid [] "void")
    (TNever [] "never")
    (TCode [] "code")
    (TCodeBuilder [] "codebuilder")
    (TExternRef [] "externref")
    (TConst [v] (const-type-key a v))
    (TPtr [inner] (sconcat a "ptr_" (type-key a inner)))
    (TRef [mutable inner] (sconcat a (if mutable "mut_" "ref_") (type-key a inner)))
    (TStruct [name] name)
    (TArray [elem n] (sconcat3 a (extent-key a "arr" n) "_" (type-key a elem)))
    (TSlice [elem] (sconcat a "slice_" (type-key a elem)))
    (TVec [elem n] (sconcat3 a (extent-key a "vec" n) "_" (type-key a elem)))
    (TFn [cc params ret]
         (mangle a (sconcat a (sconcat3 a "fn_" (cc-identity cc) "_") (type-key a ret)) params))
    (TApp [name args] (mangle a name args))
    (TError [] (do (unimplemented "mono: an untyped expression's type reached specialization (compiler bug)") ""))))

;;; `arr4` or `vec8`: an extent is concrete by the time an instance is named.
(defn extent-key [(a (dyn Allocator)) (prefix (slice u8)) (n Extent)] (-> (slice u8))
  (match n
    (FixedExtent [k] (sconcat a prefix (i64->str a k)))
    (ParamExtent [name] (sconcat a prefix name))))

;;; The name of generic NAME's instance at ARGS.
(defn mangle [(a (dyn Allocator)) (name (slice u8)) (args (ptr (ArrayList Type)))] (-> (slice u8))
  (let [(mut s) name]
    (for [i 0 (len (load args))]
      (set! s (sconcat3 a s "__" (type-key a (elem args i)))))
    s))
