; src/compiler/frontend/expr_children.coil — self-host Coil compiler: the one
; enumeration of an expression's direct subexpressions.
;
; A pass that looks for something anywhere in an expression asks each child in
; turn through `any-child?`, so it does not keep its own list of which kinds of
; expression have children. Such private lists ended in a catch-all arm, and a
; kind left out of one was skipped silently.

(module coil.compiler.expr_children)
(import "coil.primitive" :as primitive)
(import "coil.arraylist" :use *)
(import "coil.compiler.ast" :use *)

;;; A question asked of an expression's direct subexpressions, one at a time.
;;; `visit-child!` answers true to stop the walk there.
(deftrait ChildVisitor [Self]
  (visit-child! [(v (mut Self)) (child (ptr Expr))] (-> bool)))

;;; Ask V of each direct subexpression of E, in evaluation order, until it
;;; answers true; whether it did. Every kind of expression is listed, with no
;;; catch-all, so a kind added to `ExprKind` must be added here before the
;;; compiler builds.
(defn any-child? [(V ChildVisitor)] [(v (mut V)) (e (ptr Expr))] (-> bool)
  (match (.kind e)
    ; no subexpressions
    (EInt [_] false)
    (EWideInt [_ _ _ _ _] false)
    (EStr [_] false)
    (ECStr [_] false)
    (EVar [_] false)
    (EFloat [_] false)
    (EBool [_] false)
    (EZeroed [_] false)
    (ERecordInit [_] false)
    (ESizeOf [_] false)
    (EAlignOf [_] false)
    (EOffsetOf [_ _] false)
    (ETypeQuery [_ _] false)
    (EFnPtrOf [_] false)
    (EFnPtrInst [_ _] false)
    (EStaticRef [_] false)
    (EConstParam [_ _] false)
    (EContinue [_] false)
    (EQuote [_] false)
    ; one
    (EBorrow [_ place] (visit-child! (mut v) place))
    (EIntUnary [_ x] (visit-child! (mut v) x))
    (EField [p _] (visit-child! (mut v) p))
    (EAccessorField [p _] (visit-child! (mut v) p))
    (ELoad [x] (visit-child! (mut v) x))
    (ECast [_ x] (visit-child! (mut v) x))
    (EBitGet [p _] (visit-child! (mut v) p))
    (EFree [x] (visit-child! (mut v) x))
    (EErase [_ x] (visit-child! (mut v) x))
    (EFieldMeta [_ _ idx] (visit-child! (mut v) idx))
    (EFieldIndex [_ name] (visit-child! (mut v) name))
    (EComptime [x] (visit-child! (mut v) x))
    (EAscribe [_ x] (visit-child! (mut v) x))
    (ESpillRef [x] (visit-child! (mut v) x))
    (EMovePlace [x] (visit-child! (mut v) x))
    (EMakeSlice [data _ _] (visit-child! (mut v) data))
    (EMakeDyn [_ _ _ x] (visit-child! (mut v) x))
    (EMakeDynOf [de] (visit-child! (mut v) (.inner de)))
    (EPattern [_ _ x _] (visit-child! (mut v) x))
    (EAlloc [_ _ init _]
            (and (!= (primitive/cast i64 init) 0) (visit-child! (mut v) init)))
    (EBreak [_ value]
            (match value
              (Some [x] (visit-child! (mut v) x))
              (None [] false)))
    ; two or three
    (EBin [_ l r] (or (visit-child! (mut v) l) (visit-child! (mut v) r)))
    (ECmp [_ l r] (or (visit-child! (mut v) l) (visit-child! (mut v) r)))
    (EStore [p x] (or (visit-child! (mut v) p) (visit-child! (mut v) x)))
    (EInitStore [p x] (or (visit-child! (mut v) p) (visit-child! (mut v) x)))
    (EIndex [p i] (or (visit-child! (mut v) p) (visit-child! (mut v) i)))
    (EBitSet [p _ x] (or (visit-child! (mut v) p) (visit-child! (mut v) x)))
    (EIf [c t f] (or (visit-child! (mut v) c) (or (visit-child! (mut v) t) (visit-child! (mut v) f))))
    ; lists
    (EDo [body] (any-in? (mut v) body))
    (ELoop [_ body] (any-in? (mut v) body))
    (ECall [_ _ args] (any-in? (mut v) args))
    (ENamedCall [_ _ _ args] (any-in? (mut v) args))
    (EConstruct [_ _ args] (any-in? (mut v) args))
    (ETraitCall [_ _ _ args] (any-in? (mut v) args))
    (ELlvmIr [_ args _] (any-in? (mut v) args))
    (EIntrinsic [_ _ args] (any-in? (mut v) args))
    (EVector [_ _ _ args] (any-in? (mut v) args))
    (ECodeOp [_ args] (any-in? (mut v) args))
    (EArrayLit [items] (any-in? (mut v) items))
    (EStaticArray [_ items] (any-in? (mut v) items))
    (EAnonFn [_ body] (any-in? (mut v) body))
    (ECallPtr [fp args] (or (visit-child! (mut v) fp) (any-in? (mut v) args)))
    (EDynDispatch [dc] (or (visit-child! (mut v) (.recv dc)) (any-in? (mut v) (.args dc))))
    (ECleanup [body cleanups] (or (visit-child! (mut v) body) (any-in? (mut v) cleanups)))
    (EDefer [cleanup body] (or (visit-child! (mut v) cleanup) (any-in? (mut v) body)))
    (EBracketCall [_ _ args vector]
                  (or (any-in? (mut v) args)
                      (and (!= (primitive/cast i64 vector) 0) (visit-child! (mut v) vector))))
    (ELet [binds body]
          (or (block :found
                (for [i 0 (len (load binds))]
                  (when (visit-child! (mut v) (field (elem binds i) value)) (break :found true)))
                false)
              (any-in? (mut v) body)))
    (EMatch [scrut arms]
            (or (visit-child! (mut v) scrut)
                (block :found
                  (for [i 0 (len (load arms))]
                    (when (visit-child! (mut v) (field (elem arms i) body)) (break :found true)))
                  false)))
    (EQuasi [q]
            (let [(mut quasi) q]
              (any-quasi-child? (mut v) (mut quasi))))))

(defn any-in? [(V ChildVisitor)] [(v (mut V)) (xs (ptr (ArrayList Expr)))] (-> bool)
  (block :found
    (for [i 0 (len (load xs))]
      (when (visit-child! (mut v) (elem xs i)) (break :found true)))
    false))

;;; The expressions a quasiquote template unquotes or splices, at any depth.
(defn any-quasi-child? [(V ChildVisitor)] [(v (mut V)) (q (ptr Quasi))] (-> bool)
  (match (load q)
    (QLit [_] false)
    (QUnquote [x] (visit-child! (mut v) x))
    (QSplice [x] (visit-child! (mut v) x))
    (QList [items]
           (block :found
             (for [i 0 (len (load items))]
               (when (any-quasi-child? (mut v) (elem items i)) (break :found true)))
             false))
    (QVector [items]
             (block :found
               (for [i 0 (len (load items))]
                 (when (any-quasi-child? (mut v) (elem items i)) (break :found true)))
               false))))

;;; Collects every child, never stopping.
(defstruct ChildCollector [(out (ptr (ArrayList (ptr Expr))))])

(impl ChildVisitor ChildCollector
  (visit-child! [(v (mut ChildCollector)) (child (ptr Expr))] (-> bool)
    (push! [(ptr Expr)] (.out v) child)
    false))

;;; E's direct subexpressions, in evaluation order, onto OUT.
(defn expr-children! [(e (ptr Expr)) (out (ptr (ArrayList (ptr Expr))))] (-> i64)
  (let [(mut collector) (ChildCollector :out out)]
    (any-child? (mut collector) e)
    0))
