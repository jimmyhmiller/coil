; src/compiler/frontend/mono.coil — self-host Coil compiler: specialization.
;
; Turns a checked program that still holds generic functions, structs and sums,
; and trait calls whose receiver was a type parameter, into one in which every
; definition is concrete. Each generic definition is instantiated once per
; argument list it is used at, under a name of its own (`ArrayList__i64`).
;
; The pieces: `mono_subst` (substitutions and instance names), `mono_core` (the
; state, the generic definitions, the worklists, types), `mono_abi` (argument
; ABI and ownership at specialized calls), and this module (expressions, the
; worklist, the program). Passes that run beside specialization live in
; `phase_split`, `diverge`, `assert_fold` and `name_sort`.

(module coil.compiler.mono)
(import "coil.primitive" :as primitive)
(import "coil.alloc" :use *)
(import "coil.result" :use *)
(import "coil.slice" :use *)
(import "coil.str" :use *)
(import "coil.arraylist" :use *)
(import "coil.hashmap" :use *)
(import "coil.io" :use *)
(import "coil.control" :use *)
(import "coil.try" :use *)
(import "coil.reader" :use *)
(import "coil.compiler.unit_state" :use [core-name])
(import "coil.compiler.ast" :use *)
(import "coil.compiler.check" :use *)
(import "coil.compiler.parser" :use *)
(import "coil.compiler.resolve" :use *)
(import "coil.compiler.loader" :use [LS ImpEntry ExpEntry])
(import "coil.compiler.vector" :use [vector-signature])
(import "coil.compiler.mono_subst" :use *)
(import "coil.compiler.mono_core" :use *)
(import "coil.compiler.mono_abi" :use *)
(import "coil.compiler.assert_fold" :use [InlineSource assert-inline-calls])
(import "coil.compiler.diverge" :use [hoist-diverging-operand])
(import "coil.compiler.phase_split" :use [phase-only-nominals phase-only-fields? phase-only-variants?])
(import "coil.compiler.name_sort" :use [Named def-name])

;;; ---- specializing expressions ----------------------------------------------

;;; A value pack `xs...` is one expression per element of the type pack,
;;; `xs$0 xs$1 …`.
(impl Specialize Expr
  (specialize-into! [(item (ptr Expr))
                     (m (ptr MonoCtx))
                     (map (ptr (ArrayList SubstEntry)))
                     (out (ptr (ArrayList Expr)))] (-> (Result i64 Diag))
    (try (let [a (.a m)]
           (match (.kind item)
             (EVar [name]
                   (if (dots-name? name)
                       (let [pack (subst-pack map)]
                         (when (= (primitive/cast i64 pack) 0)
                           (break :try (Err [i64 Diag] (derr "internal: value-pack expansion without a type-pack substitution"))))
                         (for [j 0 (len (load pack))]
                           (push! [Expr] out (mk-expr (EVar (indexed-name a (dots-base name) j))
                                                      (.lo item) (.hi item) (.source item) (.ctxt item))))
                         0)
                       (do (push! [Expr] out (try! (resolve-expr m item map))) 0)))
             (_ (do (push! [Expr] out (try! (resolve-expr m item map))) 0)))
           (Ok [i64 Diag] 0)))))

;;; A binding whose value may own keeps its owner type when, at these
;;; arguments, the type owns.
(impl Specialize Bind
  (specialize-into! [(item (ptr Bind))
                     (m (ptr MonoCtx))
                     (map (ptr (ArrayList SubstEntry)))
                     (out (ptr (ArrayList Bind)))] (-> (Result i64 Diag))
    (try (let [a (.a m)
               (mut nb) (mk-bind (.name item) (.mutable item) (try! (resolve-expr m (field item value) map)))
               declared (.owned_type item)
               ; Generic checking cannot always prove that the result of `take!`
               ; is affine before T is substituted. The intrinsic's explicit type
               ; argument is authoritative, so recover it for ownership
               ; elaboration rather than lose the moved value's cleanup.
               recovered (= (primitive/cast i64 declared) 0)
               owner (if recovered (take-owner-type (field item value)) declared)]
           (set! (.bid nb) (.bid item))
           (unless (= (primitive/cast i64 owner) 0)
             (let [concrete (box-type a (try! (resolve-ty m owner map)))
                   semantic (box-type a (ownership-semantic-type m concrete))]
               (when (or recovered (type-is-affine a (load (field m ownership_cx)) semantic))
                 (set! (.owned_type nb) semantic))
               0))
           (push! [Bind] out (load nb))
           (Ok [i64 Diag] 0)))))

(impl Specialize Arm
  (specialize-into! [(item (ptr Arm))
                     (m (ptr MonoCtx))
                     (map (ptr (ArrayList SubstEntry)))
                     (out (ptr (ArrayList Arm)))] (-> (Result i64 Diag))
    (try (let [body (try! (resolve-expr m (field item body) map))]
           (push! [Arm] out (Arm :variant (.variant item) :binds (.binds item) :body body))
           (Ok [i64 Diag] 0)))))

(impl Specialize StaticAssert
  (specialize-into! [(item (ptr StaticAssert))
                     (m (ptr MonoCtx))
                     (map (ptr (ArrayList SubstEntry)))
                     (out (ptr (ArrayList StaticAssert)))] (-> (Result i64 Diag))
    (try (let [cnd (try! (resolve-expr m (field item cnd) map))]
           (push! [StaticAssert] out (StaticAssert :cnd cnd :msg (.msg item)))
           (Ok [i64 Diag] 0)))))

;;; E specialized by MAP. Expressions are rebuilt bottom-up, and each keeps its
;;; source node's identity: the checker's binding and type side tables are keyed
;;; by it, and generic ABI and ownership lowering still read them.
(defn resolve-expr [(m (ptr MonoCtx)) (e (ptr Expr)) (map (ptr (ArrayList SubstEntry)))] (-> (Result Expr Diag))
  (try (let [kind (try! (resolve-expr-kind m e map))
             (mut out) (mk-expr (hoist-diverging-operand (.a m) kind) (.lo e) (.hi e) (.source e) (.ctxt e))]
         (set! (.node-id out) (.node-id e))
         (Ok [Expr Diag] (load out)))))

;;; E specialized, in new storage.
(defn resolve-boxed [(m (ptr MonoCtx)) (e (ptr Expr)) (map (ptr (ArrayList SubstEntry)))] (-> (Result (ptr Expr) Diag))
  (match (resolve-expr m e map)
    (Ok [r] (Ok [(ptr Expr) Diag] (box-expr (.a m) r)))
    (Err [d] (Err [(ptr Expr) Diag] d))))

;;; The type T, held by value, specialized.
(defn resolve-ty-value [(m (ptr MonoCtx)) (t Type) (map (ptr (ArrayList SubstEntry)))] (-> (Result Type Diag))
  (let [(mut cell) t]
    (resolve-ty m (mut cell) map)))

(defn compiler-bug [(e (ptr Expr)) (msg (slice u8))] (-> Diag)
  (derr-at-src (.source e) (.lo e) (.hi e) msg))

(defn resolve-expr-kind [(m (ptr MonoCtx)) (e (ptr Expr)) (map (ptr (ArrayList SubstEntry)))] (-> (Result ExprKind Diag))
  (try (let [a (.a m)]
         (match (.kind e)
           ; leaves: nothing in them names a type parameter
           (EInt [_] (Ok [ExprKind Diag] (.kind e)))
           (EWideInt [_ _ _ _ _] (Ok [ExprKind Diag] (.kind e)))
           (EStr [_] (Ok [ExprKind Diag] (.kind e)))
           (ECStr [_] (Ok [ExprKind Diag] (.kind e)))
           (EVar [_] (Ok [ExprKind Diag] (.kind e)))
           (EFloat [_] (Ok [ExprKind Diag] (.kind e)))
           (EBool [_] (Ok [ExprKind Diag] (.kind e)))
           (EContinue [_] (Ok [ExprKind Diag] (.kind e)))
           (EStaticRef [_] (Ok [ExprKind Diag] (.kind e)))
           ; types
           (EZeroed [t] (Ok [ExprKind Diag] (EZeroed (try! (resolve-ty-value m t map)))))
           (ERecordInit [t] (Ok [ExprKind Diag] (EZeroed (try! (resolve-ty-value m t map)))))
           (ESizeOf [t] (Ok [ExprKind Diag] (ESizeOf (try! (resolve-ty-value m t map)))))
           (EAlignOf [t] (Ok [ExprKind Diag] (EAlignOf (try! (resolve-ty-value m t map)))))
           (EOffsetOf [t fname] (Ok [ExprKind Diag] (EOffsetOf (try! (resolve-ty-value m t map)) fname)))
           (ECast [t inner]
                  (let [ty (try! (resolve-ty-value m t map))]
                    (Ok [ExprKind Diag] (ECast ty (try! (resolve-boxed m inner map))))))
           ; one operand
           (EBorrow [mutable place] (Ok [ExprKind Diag] (EBorrow mutable (try! (resolve-boxed m place map)))))
           (ESpillRef [inner] (Ok [ExprKind Diag] (ESpillRef (try! (resolve-boxed m inner map)))))
           (EMovePlace [place] (Ok [ExprKind Diag] (EMovePlace (try! (resolve-boxed m place map)))))
           (EIntUnary [op inner] (Ok [ExprKind Diag] (EIntUnary op (try! (resolve-boxed m inner map)))))
           (ELoad [inner] (Ok [ExprKind Diag] (ELoad (try! (resolve-boxed m inner map)))))
           (EFree [inner] (Ok [ExprKind Diag] (EFree (try! (resolve-boxed m inner map)))))
           (EErase [trait_name inner] (Ok [ExprKind Diag] (EErase trait_name (try! (resolve-boxed m inner map)))))
           (EField [p fname] (Ok [ExprKind Diag] (EField (try! (resolve-boxed m p map)) fname)))
           (EAccessorField [p fname] (Ok [ExprKind Diag] (EField (try! (resolve-boxed m p map)) fname)))
           (EBitGet [p fname] (Ok [ExprKind Diag] (EBitGet (try! (resolve-boxed m p map)) fname)))
           ; two or three operands
           (EBin [op lhs rhs]
                 (let [l (try! (resolve-boxed m lhs map))]
                   (Ok [ExprKind Diag] (EBin :op op :lhs l :rhs (try! (resolve-boxed m rhs map))))))
           (ECmp [op lhs rhs]
                 (let [l (try! (resolve-boxed m lhs map))]
                   (Ok [ExprKind Diag] (ECmp :op op :lhs l :rhs (try! (resolve-boxed m rhs map))))))
           (EStore [p val]
                   (let [place (try! (resolve-boxed m p map))]
                     (Ok [ExprKind Diag] (EStore place (try! (resolve-boxed m val map))))))
           (EInitStore [p val]
                       (let [place (try! (resolve-boxed m p map))]
                         (Ok [ExprKind Diag] (EInitStore place (try! (resolve-boxed m val map))))))
           (EIndex [p idx]
                   (let [place (try! (resolve-boxed m p map))]
                     (Ok [ExprKind Diag] (EIndex place (try! (resolve-boxed m idx map))))))
           (EBitSet [p fname val]
                    (let [place (try! (resolve-boxed m p map))]
                      (Ok [ExprKind Diag] (EBitSet :p place :fname fname :val (try! (resolve-boxed m val map))))))
           (EIf [cnd thn els]
                (let [c (try! (resolve-boxed m cnd map))
                      t (try! (resolve-boxed m thn map))]
                  (Ok [ExprKind Diag] (EIf :cnd c :thn t :els (try! (resolve-boxed m els map))))))
           ; sequences and bindings
           (EDo [body] (Ok [ExprKind Diag] (EDo (try! (specialize-list [Expr] m body map)))))
           (ELoop [label body] (Ok [ExprKind Diag] (ELoop label (try! (specialize-list [Expr] m body map)))))
           (ELet [binds body]
                 (let [bs (try! (specialize-list [Bind] m binds map))]
                   (Ok [ExprKind Diag] (ELet bs (try! (specialize-list [Expr] m body map))))))
           ; A generic body keeps its defers until the instance is elaborated.
           (EDefer [cleanup body]
                   (let [c (try! (resolve-boxed m cleanup map))]
                     (Ok [ExprKind Diag] (EDefer c (try! (specialize-list [Expr] m body map))))))
           (ECleanup [body cleanups]
                     (let [b (try! (resolve-boxed m body map))]
                       (Ok [ExprKind Diag] (ECleanup :body b :cleanups (try! (specialize-list [Expr] m cleanups map))))))
           (EMatch [scrut arms]
                   (let [s (try! (resolve-boxed m scrut map))]
                     (Ok [ExprKind Diag] (EMatch s (try! (specialize-list [Arm] m arms map))))))
           (EBreak [label value]
                   (Ok [ExprKind Diag]
                       (EBreak label (match value
                                       (Some [v] (Some (try! (resolve-boxed m v map))))
                                       (None [] (None [(ptr Expr)]))))))
           ; storage
           (EAlloc [storage t init symbol]
                   (let [ty (try! (resolve-ty-value m t map))]
                     (Ok [ExprKind Diag]
                         (EAlloc :symbol symbol
                                 :storage storage
                                 :ty ty
                                 :init (if (= (primitive/cast i64 init) 0)
                                           init
                                           (try! (resolve-boxed m init map)))))))
           (EStaticArray [indices items]
                         (Ok [ExprKind Diag] (EStaticArray indices (try! (specialize-list [Expr] m items map)))))
           (EMakeSlice [data elem len]
                       (let [d (try! (resolve-boxed m data map))
                             t (try! (resolve-ty-value m elem map))]
                         (Ok [ExprKind Diag] (EMakeSlice :data d :elem t :len (try! (resolve-extent m len map true))))))
           ; calls
           (ECall [func type_args args] (resolve-call-kind m func type_args args map))
           (ETraitCall [trait_name method self_tp args] (resolve-trait-call m trait_name method self_tp args map))
           (ECallPtr [fp args]
                     (let [f (try! (resolve-boxed m fp map))]
                       (Ok [ExprKind Diag] (ECallPtr f (try! (specialize-list [Expr] m args map))))))
           (EConstruct [sum variant args]
                       (Ok [ExprKind Diag] (EConstruct :sum sum :variant variant :args (try! (specialize-list [Expr] m args map)))))
           (EFnPtrOf [nm]
                     (if (some? (generic-func m nm))
                         (Err [ExprKind Diag]
                              (derr (sconcat3 a "fnptr-of '" nm
                                              "': a generic function's pointer reached specialization without its type arguments (compiler bug)")))
                         (Ok [ExprKind Diag] (.kind e))))
           (EFnPtrInst [nm targs] (fnptr-inst m nm targs map))
           (EMakeDyn [dyn_struct vtable_struct methods inner]
                     (Ok [ExprKind Diag] (EMakeDyn :dyn_struct dyn_struct
                                                   :vtable_struct vtable_struct
                                                   :methods methods
                                                   :inner (try! (resolve-boxed m inner map)))))
           (EDynDispatch [dc]
                         (let [params (try! (specialize-list [Type] m (.params dc) map))
                               ret (try! (resolve-ty-value m (.ret dc) map))
                               recv (try! (resolve-boxed m (.recv dc) map))
                               args (try! (specialize-list [Expr] m (.args dc) map))]
                           (Ok [ExprKind Diag]
                               (EDynDispatch (box! a DynCall (DynCall :dyn_struct (.dyn_struct dc)
                                                                      :vtable_struct (.vtable_struct dc)
                                                                      :method_index (.method_index dc)
                                                                      :cc (.cc dc)
                                                                      :params params
                                                                      :ret ret
                                                                      :recv recv
                                                                      :args args))))))
           ; operations written as code
           (EVector [op result types args]
                    (let [resolved (try! (resolve-ty-value m result map))
                          operands (try! (specialize-list [Type] m types map))
                          values (try! (specialize-list [Expr] m args map))]
                      (try! (vector-signature a op (box-type a resolved) operands values false))
                      (Ok [ExprKind Diag] (EVector op resolved operands values))))
           (ELlvmIr [result args body]
                    (let [ty (try! (resolve-ty-value m result map))]
                      (Ok [ExprKind Diag] (ELlvmIr :result ty :args (try! (specialize-list [Expr] m args map)) :body body))))
           (EIntrinsic [op result args]
                       (let [ty (try! (resolve-ty-value m result map))]
                         (Ok [ExprKind Diag] (EIntrinsic :op op :result ty :args (try! (specialize-list [Expr] m args map))))))
           ; A value parameter becomes the literal it specialized to.
           (EConstParam [name ty] (const-param-value m e name ty map))
           ; Forms the checker lowers away, and compile-time-only code: a
           ; compiler bug when one reaches specialization.
           (ENamedCall [_ _ _ _]
                       (Err [ExprKind Diag] (derr "internal: named constructor call survived type checking")))
           (EAnonFn [_ _] (Err [ExprKind Diag] (derr "internal: anonymous fn survived type checking")))
           (EBracketCall [_ _ _ _] (Err [ExprKind Diag] (derr "internal: a bracket call survived resolution")))
           (EComptime [_] (Err [ExprKind Diag] (compiler-bug e "mono: unresolved comptime node (compiler bug)")))
           (EAscribe [_ _]
                     (Err [ExprKind Diag]
                          (derr "mono: unlowered ascription node — the checker should have replaced (: v t) with its coerced value (compiler bug)")))
           (EPattern [_ _ _ _]
                     (Err [ExprKind Diag]
                          (derr "mono: unlowered pattern projection — the checker should have replaced (: v t) with its coerced value (compiler bug)")))
           (EArrayLit [_] (Err [ExprKind Diag] (derr "mono: array literal survived type checking (compiler bug)")))
           (ETypeQuery [_ _] (Err [ExprKind Diag] (derr "mono: unresolved type-query (compiler bug)")))
           (EFieldMeta [_ _ _] (Err [ExprKind Diag] (derr "mono: unresolved field-reflection (compiler bug)")))
           (EFieldIndex [_ _] (Err [ExprKind Diag] (derr "mono: unresolved field-reflection (compiler bug)")))
           (EQuote [_] (Err [ExprKind Diag] (derr "mono: comptime-only code value reached mono (compiler bug)")))
           (EQuasi [_] (Err [ExprKind Diag] (derr "mono: comptime-only code value reached mono (compiler bug)")))
           (ECodeOp [op _]
                    (Err [ExprKind Diag]
                         (compiler-bug e (sconcat3 a "mono: comptime-only code operation " (i64->str a op)
                                                   " reached mono (compiler bug)"))))))))

;;; The value parameter NAME of type TY in E, as the literal MAP gives it.
(defn const-param-value [(m (ptr MonoCtx))
                         (e (ptr Expr))
                         (name (slice u8))
                         (ty Type)
                         (map (ptr (ArrayList SubstEntry)))] (-> (Result ExprKind Diag))
  (try (let [a (.a m)]
         (match (try! (resolve-ty-value m (TStruct name) map))
           (TConst [v]
                   (match v
                     (ConstInt [n]
                               (match ty
                                 (TInt [bits signed]
                                       (if (and (= bits 64) signed)
                                           (Ok [ExprKind Diag] (EInt n))
                                           (Ok [ExprKind Diag]
                                               (ECast ty (box-expr a (mk-expr (EInt n) (.lo e) (.hi e) (.source e) (.ctxt e)))))))
                                 (_ (Err [ExprKind Diag]
                                         (derr (sconcat3 a "mono: integer value parameter '" name "' has a non-integer type (compiler bug)"))))))
                     (ConstBool [b] (Ok [ExprKind Diag] (EBool b)))
                     (ConstKeyword [kw]
                                   (let [(mut args) (ArrayList::new [Expr] a)]
                                     (push! (mut args) (mk-expr (EStr kw) (.lo e) (.hi e) (.source e) (.ctxt e)))
                                     (Ok [ExprKind Diag]
                                         (EConstruct :sum (core-name "Keyword")
                                                     :variant (core-name "KeywordValue")
                                                     :args (box-al [Expr] a (load args))))))
                     (ConstRef [nm]
                               (Err [ExprKind Diag]
                                    (derr (sconcat3 a "mono: the generic argument (const " nm ") reached specialization unresolved (compiler bug)"))))))
           (_ (Err [ExprKind Diag]
                   (derr (sconcat3 a "mono: value parameter '" name "' did not specialize to a constant (compiler bug)"))))))))

;;; ---- calls -------------------------------------------------------------------

;;; A call of FUNC: a variant's construction, a call of a generic function's
;;; instance, or a call of an ordinary function.
(defn resolve-call-kind [(m (ptr MonoCtx))
                         (func (slice u8))
                         (type_args (ptr (ArrayList Type)))
                         (args (ptr (ArrayList Expr)))
                         (map (ptr (ArrayList SubstEntry)))] (-> (Result ExprKind Diag))
  (try (let [a (.a m)
             nargs (try! (specialize-list [Expr] m args map))]
         (match (variant-sum m func)
           (Some [sum]
                 (do (move-args-to-values! nargs)
                     (resolve-construction m func sum type_args nargs map)))
           (None []
                 (match (generic-func m func)
                   (Some [gf] (resolve-generic-call m func gf type_args nargs map))
                   (None []
                         (do (try! (respecialize-call-args! m func nargs))
                             (Ok [ExprKind Diag] (ECall :func func :type_args (box-items-type a) :args nargs))))))))))

;;; The variant FUNC of SUM constructed from NARGS: of SUM's instance at the
;;; call's type arguments when SUM is generic.
(defn resolve-construction [(m (ptr MonoCtx))
                            (func (slice u8))
                            (sum (slice u8))
                            (type_args (ptr (ArrayList Type)))
                            (nargs (ptr (ArrayList Expr)))
                            (map (ptr (ArrayList SubstEntry)))] (-> (Result ExprKind Diag))
  (try (let [a (.a m)]
         (match (generic-sum m sum)
           (None [] (Ok [ExprKind Diag] (EConstruct :sum sum :variant func :args nargs)))
           (Some [s]
                 (do
                   (when (= (len (load type_args)) 0)
                     (break :try (Err [ExprKind Diag]
                                      (derr (sconcat a
                                                     (sconcat3 a "variant '" func "' of generic sum '")
                                                     (sconcat3 a sum "' needs type arguments: (" (sconcat a func " [<types>] ...)")))))))
                   (let [rtargs (try! (specialize-list [Type] m type_args map))
                         arity (type-param-count (.type_params s))]
                     (when (!= (len (load rtargs)) arity)
                       (break :try (Err [ExprKind Diag]
                                        (arity-err a (sconcat3 a "sum '" sum "'") arity (len (load rtargs))))))
                     (Ok [ExprKind Diag]
                         (EConstruct :sum (request-instance! m (SumInstance) sum rtargs) :variant func :args nargs)))))))))

;;; A call of generic function FUNC: of its instance at the call's type arguments.
(defn resolve-generic-call [(m (ptr MonoCtx))
                            (func (slice u8))
                            (gf (ptr Func))
                            (type_args (ptr (ArrayList Type)))
                            (nargs (ptr (ArrayList Expr)))
                            (map (ptr (ArrayList SubstEntry)))] (-> (Result ExprKind Diag))
  (try (let [a (.a m)]
         (when (= (len (load type_args)) 0)
           (break :try (Err [ExprKind Diag]
                            (derr (sconcat a
                                           (sconcat3 a "generic function '" func "' needs explicit type arguments: (")
                                           (sconcat a func " [<types>] ...)"))))))
         (let [rtargs (try! (resolve-ty-args m type_args map))
               arity (type-param-count (.type_params gf))]
           (when (!= (len (load rtargs)) arity)
             (break :try (Err [ExprKind Diag]
                              (arity-err a (sconcat3 a "generic function '" func "'") arity (len (load rtargs))))))
           (let [mng (mangle a func rtargs)]
             (try! (register-monomorphized-call-sig! m gf rtargs mng))
             (try! (adjust-generic-call-abi! m gf rtargs nargs true))
             (request-instance! m (FuncInstance) func rtargs)
             (Ok [ExprKind Diag] (ECall :func mng :type_args (box-items-type a) :args nargs)))))))

;;; The arguments of a call of the ordinary function FUNC. In the second pass
;;; over an instance's body a call of an instance is already by its instance
;;; name, but ownership elaboration has only now marked the arguments it
;;; consumes: pass them as the generic it instantiates takes them.
(defn respecialize-call-args! [(m (ptr MonoCtx)) (func (slice u8)) (nargs (ptr (ArrayList Expr)))] (-> (Result i64 Diag))
  (match (instance-origin m func)
    (None [] (Ok [i64 Diag] (move-args-to-places! nargs)))
    (Some [origin]
          (match (generic-func m (.source origin))
            (Some [gf] (adjust-generic-call-abi! m gf (.args origin) nargs false))
            (None []
                  (Err [i64 Diag]
                       (derr (sconcat3 (.a m) "mono: the call of instance '" func
                                       "' has no generic function to pass its arguments as (compiler bug)"))))))))

;;; `(fnptr-of f [T…])` at this specialization's arguments: the instance of `f`
;;; at them, queued like a call's, and a pointer to it. Its type takes a
;;; parameter of type `T` by value, as a `c` pointer does, and so does the
;;; instance; where the instance takes an argument by reference that the pointer
;;; passes by value, the pointer is to a by-value C entry (`instance-c-entry!`).
(defn fnptr-inst [(m (ptr MonoCtx))
                  (nm (slice u8))
                  (targs (ptr (ArrayList Type)))
                  (map (ptr (ArrayList SubstEntry)))] (-> (Result ExprKind Diag))
  (try (let [a (.a m)
             gf (match (generic-func m nm)
                  (Some [f] f)
                  (None [] (break :try (Err [ExprKind Diag]
                                            (derr (sconcat3 a "fnptr-of '" nm "': no generic function by that name (compiler bug)"))))))
             rtargs (try! (resolve-ty-args m targs map))
             arity (type-param-count (.type_params gf))
             mng (mangle a nm rtargs)]
         (when (!= (len (load rtargs)) arity)
           (break :try (Err [ExprKind Diag]
                            (arity-err a (sconcat3 a "generic function '" nm "'") arity (len (load rtargs))))))
         (try! (register-monomorphized-call-sig! m gf rtargs mng))
         (request-instance! m (FuncInstance) nm rtargs)
         (try! (instance-c-entry! m gf rtargs mng))
         (Ok [ExprKind Diag] (EFnPtrOf mng)))))

;;; ---- trait calls -------------------------------------------------------------

;;; How a trait call's concrete receiver dispatches: the name impls are keyed by,
;;; and the type an impl's pattern is matched against.
(defstruct Receiver [(base (slice u8)) (shape Type)])

;;; SELF as a trait call's receiver. An instance (ArrayList__i64) dispatches by
;;; its generic's name, and an impl pattern binds against its generic application.
(defn trait-receiver [(a (dyn Allocator)) (m (ptr MonoCtx)) (self Type)] (-> (Result Receiver Diag))
  (match self
    (TStruct [name]
             (match (instance-origin m name)
               (Some [origin] (Ok [Receiver Diag] (Receiver :base (.source origin) :shape (TApp (.source origin) (.args origin)))))
               (None [] (Ok [Receiver Diag] (Receiver :base name :shape self)))))
    (_ (match (let [(mut cell) self] (mono-impl-name a (mut cell)))
         (Some [name] (Ok [Receiver Diag] (Receiver :base name :shape self)))
         (None [] (Err [Receiver Diag] (derr "mono: a trait call's Self resolved to a type with no impl name (compiler bug)")))))))

;;; A trait call whose receiver was a type parameter, now concrete: a call of the
;;; implementing function, or of its instance when the impl is generic. The
;;; impl is the most specific one accepting the receiver, or, when none does, the
;;; one under the receiver's plain key, as before specialization (a general
;;; impl's key IS the plain key).
(defn resolve-trait-call [(m (ptr MonoCtx))
                          (trait_name (slice u8))
                          (method (slice u8))
                          (self_tp (slice u8))
                          (args (ptr (ArrayList Expr)))
                          (map (ptr (ArrayList SubstEntry)))] (-> (Result ExprKind Diag))
  (try (let [a (.a m)
             self (try! (resolve-ty-value m (TStruct self_tp) map))
             receiver (try! (trait-receiver a m self))
             (mut shape) (.shape receiver)
             selected (impl-lookup-sel a m trait_name (mut shape))
             none-selected (= (primitive/cast i64 selected) 0)
             ip (if none-selected (impl-lookup m trait_name (.base receiver)) selected)
             key (if none-selected
                     (.base receiver)
                     (impl-mangle-key a (field selected self_type) (load (field selected type_params))))
             targs (if (and (!= (primitive/cast i64 ip) 0) (> (len (load (load (field ip type_params)))) 0))
                       (try! (impl-type-args m ip (mut shape) trait_name method self_tp map))
                       (box-items-type a))
             basefn (tmfn a trait_name key method)
             rargs (try! (specialize-list [Expr] m args map))]
         (try! (adjust-trait-call-abi! m (trait-find (load (field m ownership_cx)) trait_name) basefn targs method rargs))
         (let [callee (if (> (len (load targs)) 0)
                          (let [mng (request-instance! m (FuncInstance) basefn targs)]
                            (mark-trait-instance! m mng trait_name key)
                            mng)
                          basefn)]
           (trait-use-record! m trait_name key method callee)
           (Ok [ExprKind Diag] (ECall :func callee :type_args (box-items-type a) :args rargs))))))

;;; The type arguments of the generic impl IP for the receiver SHAPE: bound by the
;;; same matcher that selected the impl (`unify-trait-extras`), not a second one
;;; free to disagree with it. An impl parameter the receiver leaves open is fixed
;;; by the associated type the caller's bound stated for the receiver.
(defn impl-type-args [(m (ptr MonoCtx))
                      (ip (ptr ImplDef))
                      (shape (ptr Type))
                      (trait_name (slice u8))
                      (method (slice u8))
                      (self_tp (slice u8))
                      (map (ptr (ArrayList SubstEntry)))] (-> (Result (ptr (ArrayList Type)) Diag))
  (try (let [a (.a m)
             binds (subst-new a)
             params (load (field ip type_params))]
         (unless (unify-trait-extras a (field ip self_type) shape params binds)
           (break :try (Err [(ptr (ArrayList Type)) Diag]
                            (derr (sconcat3 a "trait call '" method "': receiver doesn't match the impl's implementing type")))))
         (let [td (trait-find (load (field m ownership_cx)) trait_name)]
           (unless (= (primitive/cast i64 td) 0)
             (let [assoc (impl-associated-bindings a ip td)
                   tparams (load (field td type_params))]
               (for [pi 0 (len (load tparams))]
                 (let [p (get (load tparams) pi)
                       pattern (subst-get assoc p)]
                   (unless (= (primitive/cast i64 pattern) 0)
                     (match (subst-find map (assoc-tp-name a self_tp trait_name p))
                       (Some [stated]
                             (let [(mut semantic) (instance-application m stated)]
                               (unify-trait-extras a pattern (mut semantic) params binds)
                               0))
                       (None [] 0)))
                   0)))
             0))
         (let [(mut targs) (ArrayList::new [Type] a)]
           (for [k 0 (len (load params))]
             (let [pn (get (load params) k)
                   bound (subst-get binds pn)]
               (when (= (primitive/cast i64 bound) 0)
                 (break :try (Err [(ptr (ArrayList Type)) Diag]
                                  (derr (sconcat a
                                                 (sconcat3 a "trait call '" method "': impl type parameter '")
                                                 (sconcat a pn "' not determined by the receiver"))))))
               (push! (mut targs) (load bound))))
           (Ok [(ptr (ArrayList Type)) Diag] (box-al [Type] a (load targs)))))))

;;; Bind, in MAP, the associated types F's bounds fix for its instance. A bound
;;; that states them, `(New (Migration Old))`, fixes them itself; otherwise the
;;; impl the bound's argument selects does. A trait call on the bound parameter
;;; reads them back to bind impl parameters its receiver leaves open.
(defn extend-associated-subst! [(m (ptr MonoCtx)) (f (ptr Func)) (map (ptr (ArrayList SubstEntry)))] (-> i64)
  (let [a (.a m)
        cx (load (field m ownership_cx))
        bounds (load (field f bounds))]
    (for [bi 0 (len (load bounds))]
      (let [bound (elem bounds bi)]
        (match (subst-find map (.name bound))
          (None [] 0)
          (Some [concrete]
                (let [receiver (box-type a (instance-application m concrete))
                      traits (load (field bound traits))]
                  (for [ti 0 (len (load traits))]
                    (let [bt (elem traits ti)
                          tr (.name bt)
                          td (trait-find cx tr)
                          ip (impl-lookup-sel a m tr receiver)]
                      (unless (= (primitive/cast i64 td) 0)
                        (if (= (len (load (.args bt))) (len (load (.type_params td))))
                            (do
                              (for [pi 0 (len (load (.args bt)))]
                                (match (resolve-ty m (elem (.args bt) pi) map)
                                  (Ok [value]
                                      (subst-bind! map (assoc-tp-name a (.name bound) tr (get (load (.type_params td)) pi)) value))
                                  (Err [_] 0)))
                              0)
                            (unless (= (primitive/cast i64 ip) 0)
                              (let [assoc (impl-associated-bindings a ip td)
                                    impl-binds (subst-new a)
                                    params (load (field td type_params))]
                                (unify-trait-extras a (field ip self_type) receiver (load (field ip type_params)) impl-binds)
                                (for [pi 0 (len (load params))]
                                  (let [p (get (load params) pi)
                                        value (subst-get assoc p)]
                                    (unless (= (primitive/cast i64 value) 0)
                                      (subst-bind! map (assoc-tp-name a (.name bound) tr p) (subst-apply a value impl-binds)))
                                    0))
                                0)
                              0)))
                      0))
                  0)))))
    0))

;;; ---- functions ---------------------------------------------------------------

;;; F specialized by MAP, under NAME.
(defn resolve-func [(m (ptr MonoCtx)) (f (ptr Func)) (map (ptr (ArrayList SubstEntry))) (name (slice u8))] (-> (Result Func Diag))
  (try (let [a (.a m)]
         (set! (.caller m) (.name f))
         (let [params (try! (specialize-list [Param] m (load (field f params)) map))
               ret (try! (resolve-ty m (field f ret) map))
               body (try! (specialize-list [Expr] m (load (field f body)) map))]
           (Ok [Func Diag]
               (Func :name name
                     :type_params (box-al [(slice u8)] a (ArrayList::new [(slice u8)] a))
                     :bounds (box-al [Bound] a (ArrayList::new [Bound] a))
                     :cc (.cc f)
                     :annotations (load (field f annotations))
                     :params params
                     :ret (never-returns-void ret)
                     :body (materialize-generic-owner-params m params body)
                     :macro_variadic false
                     :lo (.lo f)
                     :hi (.hi f)
                     :source (.source f)
                     :ctxt (.ctxt f)
                     :declared (.declared f)
                     :lazy (.lazy f)))))))

;;; ---- the worklist -------------------------------------------------------------

;;; Specialize every instance asked for, and every one those ask for in turn,
;;; until none is left. Structs before sums before functions: the order decides
;;; which signatures exist when an instance's ownership is elaborated.
(defn drain [(m (ptr MonoCtx))] (-> (Result i64 Diag))
  (try (do
         (loop
           (match (next-instance! (field m struct-work))
             (Some [at] (try! (specialize-struct-instance! m at)))
             (None []
                   (match (next-instance! (field m sum-work))
                     (Some [at] (try! (specialize-sum-instance! m at)))
                     (None []
                           (match (next-instance! (field m func-work))
                             (Some [at] (try! (specialize-func-instance! m at)))
                             (None [] (break))))))))
         (Ok [i64 Diag] 0))))

(defn template-missing [(a (dyn Allocator)) (what (slice u8)) (origin (ptr MonoOrigin))] (-> Diag)
  (derr (sconcat3 a (sconcat3 a "mono: no generic " what " '") (.source origin) "' for its instance (compiler bug)")))

;;; D, located in the definition named NAME.
(defn in-definition [(a (dyn Allocator)) (what (slice u8)) (name (slice u8)) (d Diag)] (-> Diag)
  (let [(mut out) d]
    (set! (.msg out) (sconcat a (sconcat3 a (sconcat3 a "in " what " '") name "': ") (.msg d)))
    (load out)))

(defn specialize-struct-instance! [(m (ptr MonoCtx)) (at i64)] (-> (Result i64 Diag))
  (try (let [a (.a m)
             origin (elem (field m origins) at)
             gs (match (get (.structs (field m templates)) (.source origin))
                  (Some [s] s)
                  (None [] (break :try (Err [i64 Diag] (template-missing a "struct" origin)))))
             smap (subst-map a (load (field gs type_params)) (.args origin))]
         (try! (runaway-check a "generic type" origin))
         (let [fields (match (specialize-list [Field] m (load (field gs fields)) smap)
                        (Ok [fs] fs)
                        (Err [d] (break :try (Err [i64 Diag] (in-definition a "type" (.generated origin) d)))))]
           (def-table-put! [StructDef] (field m structs) (struct-instance gs (.generated origin) fields a))
           (Ok [i64 Diag] 0)))))

;;; The concrete struct NAME with FIELDS, laid out and annotated as S.
(defn struct-instance [(s (ptr StructDef)) (name (slice u8)) (fields (ptr (ArrayList Field))) (a (dyn Allocator))] (-> StructDef)
  (StructDef :name name
             :type_params (box-al [(slice u8)] a (ArrayList::new [(slice u8)] a))
             :bounds (box-al [Bound] a (ArrayList::new [Bound] a))
             :layout (.layout s)
             :fields fields
             :annotations (.annotations s)
             :span_source (.span_source s)
             :span_lo (.span_lo s)
             :span_hi (.span_hi s)))

(defn specialize-sum-instance! [(m (ptr MonoCtx)) (at i64)] (-> (Result i64 Diag))
  (try (let [a (.a m)
             origin (elem (field m origins) at)
             gs (match (generic-sum m (.source origin))
                  (Some [s] s)
                  (None [] (break :try (Err [i64 Diag] (template-missing a "sum" origin)))))
             smap (subst-map a (load (field gs type_params)) (.args origin))]
         (try! (runaway-check a "generic sum" origin))
         (def-table-put! [SumDef] (field m sums) (try! (resolve-sum m gs smap (.generated origin))))
         (Ok [i64 Diag] 0))))

;;; S specialized by MAP, under NAME.
(defn resolve-sum [(m (ptr MonoCtx)) (s (ptr SumDef)) (map (ptr (ArrayList SubstEntry))) (name (slice u8))] (-> (Result SumDef Diag))
  (try (let [a (.a m)
             variants (try! (specialize-list [Variant] m (load (field s variants)) map))]
         (Ok [SumDef Diag]
             (SumDef :name name
                     :type_params (box-al [(slice u8)] a (ArrayList::new [(slice u8)] a))
                     :bounds (box-al [Bound] a (ArrayList::new [Bound] a))
                     :variants variants
                     :annotations (.annotations s)
                     :span_source (.span_source s)
                     :span_lo (.span_lo s)
                     :span_hi (.span_hi s))))))

;;; A generic function's instance: its body specialized once Unelaborated, its
;;; ownership elaborated now that its types are concrete, and its body
;;; specialized again, since elaboration may synthesize generic calls (the Drop
;;; of a field such as `(Weak Payload)`) that the first pass never saw.
(defn specialize-func-instance! [(m (ptr MonoCtx)) (at i64)] (-> (Result i64 Diag))
  (try (let [a (.a m)
             origin (elem (field m origins) at)
             gf (match (generic-func m (.source origin))
                  (Some [f] f)
                  (None [] (break :try (Err [i64 Diag] (template-missing a "function" origin)))))
             smap (subst-map a (load (field gf type_params)) (.args origin))]
         (extend-associated-subst! m gf smap)
         (match (runaway-check a "generic function" origin)
           ; at the function that keeps instantiating itself
           (Err [d] (break :try (Err [i64 Diag] (dwspan d (.source gf) (.lo gf) (.hi gf) 0))))
           (Ok [_] 0))
         (set! (.stage m) (Unelaborated))
         (let [first (resolve-func m gf smap (.generated origin))]
           (set! (.stage m) (Elaborated))
           (let [(mut f) (try! first)]
             (try! (elaborate-instance-ownership! m (mut f) smap))
             (set! (.body f) (try! (specialize-list [Expr] m (.body f) smap)))
             (def-table-put! [Func] (field m funcs) (load f))
             (Ok [i64 Diag] 0))))))

;;; Elaborate the ownership of the instance F of a generic specialized by MAP, in
;;; the checked program's environment with MAP's types in their generic shape.
(defn elaborate-instance-ownership! [(m (ptr MonoCtx)) (f (ptr Func)) (map (ptr (ArrayList SubstEntry)))] (-> (Result i64 Diag))
  (let [cx (load (field m ownership_cx))]
    (set! (.cur_bounds cx) (ArrayList::new [Bound] (.a m)))
    (set! (.ownership_subst cx) (ownership-instance-subst m map))
    (let [checked (ownership-check-func (.a m) cx f)]
      (set! (.ownership_subst cx) (primitive/cast (ptr (ArrayList SubstEntry)) 0))
      (match checked
        (Ok [_] (Ok [i64 Diag] 0))
        (Err [d] (Err [i64 Diag] d))))))

;;; ---- the program's concrete definitions ----------------------------------------
;;; Every concrete definition is specialized too: its body may call generics.

(defn seed-concrete-structs [(m (ptr MonoCtx)) (p (ptr Program)) (map (ptr (ArrayList SubstEntry)))] (-> (Result i64 Diag))
  (try (let [a (.a m)]
         (for [i 0 (len (load (.structs p)))]
           (let [sp (elem (.structs p) i)]
             ; Code-bearing aggregates belong to the metaprogram and checker
             ; closure alone. Metalower compiles a private copy with Code erased
             ; to an opaque host handle; the runtime program gives them no layout.
             (when (and (= (len (load (.type_params sp))) 0)
                        (not (phase-only-fields? (load (field sp fields)) (.phase_only m))))
               (let [(mut nd) (struct-instance sp (.name sp) (try! (specialize-list [Field] m (load (field sp fields)) map)) a)]
                 (unless (mono-struct-already? m (mut nd))
                   (def-table-put! [StructDef] (field m structs) (load nd)))
                 0))
             0))
         (Ok [i64 Diag] 0))))

(defn seed-concrete-sums [(m (ptr MonoCtx)) (p (ptr Program)) (map (ptr (ArrayList SubstEntry)))] (-> (Result i64 Diag))
  (try (do
         (for [i 0 (len (load (.sums p)))]
           (let [sp (elem (.sums p) i)]
             (when (and (= (len (load (.type_params sp))) 0)
                        (not (phase-only-variants? (load (field sp variants)) (.phase_only m))))
               (let [(mut ns) (try! (resolve-sum m sp map (.name sp)))]
                 (unless (mono-sum-already? m (mut ns))
                   (def-table-put! [SumDef] (field m sums) (load ns)))
                 0))
             0))
         (Ok [i64 Diag] 0))))

(defn seed-concrete-funcs [(m (ptr MonoCtx)) (p (ptr Program)) (map (ptr (ArrayList SubstEntry)))] (-> (Result i64 Diag))
  (try (let [a (.a m)]
         (for [i 0 (len (load (.funcs p)))]
           (let [fp (elem (.funcs p) i)]
             (when (and (= (len (load (.type_params fp))) 0)
                        (not (contains? (.retained_funcs m) (.name fp))))
               (match (resolve-func m fp map (.name fp))
                 (Ok [nf] (def-table-put! [Func] (field m funcs) nf))
                 (Err [d] (break :try (Err [i64 Diag] (in-definition a "function" (.name fp) d))))))
             0))
         (Ok [i64 Diag] 0))))

;;; P's constants, specialized. `prior` is the program an earlier run produced, or
;;; null. A runtime constant whose checked value is the very node that run was
;;; given -- the same node id, which only the same node has -- keeps the record
;;; that run made for it. Resolving it again gives an equal tree in new storage,
;;; which costs the resolution on every edit of anything and leaves no two native
;;; programs sharing a single constant.
(defn mono-consts [(m (ptr MonoCtx))
                   (p (ptr Program))
                   (map (ptr (ArrayList SubstEntry)))
                   (prior (ptr Program))] (-> (Result (ptr (ArrayList Const)) Diag))
  (try (let [a (.a m)
             cs (load (field p consts))
             (mut out) (ArrayList::new [Const] a)
             (mut made) (HashMap::new [(slice u8) i64] a (keyops-borrowed))]
         (unless (= (primitive/cast i64 prior) 0)
           (for [i 0 (len (load (.consts prior)))]
             (set! (mut made) (.name (elem (.consts prior) i)) i))
           0)
         (for [i 0 (len (load cs))]
           (let [cp (elem cs i)
                 kept (match (get made (.name cp))
                        (None [] (primitive/cast (ptr Const) 0))
                        (Some [at]
                              (let [old (elem (.consts prior) at)]
                                (if (and (.runtime old)
                                         (!= (.node-id (field cp value)) 0)
                                         (= (.node-id (field old value)) (.node-id (field cp value))))
                                    old
                                    (primitive/cast (ptr Const) 0)))))]
             (cond (!= (primitive/cast i64 kept) 0) (push! (mut out) (load kept))
                   (.runtime cp)
                     (let [(mut nc) (load cp)]
                       (set! (.ty nc) (match (.ty cp)
                                        (None [] (None [Type]))
                                        (Some [ty] (Some (try! (resolve-ty-value m ty map))))))
                       (set! (.value nc) (try! (resolve-expr m (field cp value) map)))
                       (push! (mut out) (load nc)))
                   :else (push! (mut out) (load cp)))
             0))
         (Ok [(ptr (ArrayList Const)) Diag] (box-al [Const] a (load out))))))

;;; P's C exports, specialized. An export's C signature names its parameter types
;;; as the checker wrote them; a generic struct such as `(Indexed i64)` (a by-value
;;; C entry for an anonymous function can take one) is the struct instantiated for
;;; it, and the backends decide from that struct whether the entry needs a
;;; by-value thunk. The entry of a generic function (a lifted anonymous function in
;;; a generic body) is not one: each instance a pointer reaches gets its own
;;; (`instance-c-entry!`).
(defn mono-exports [(m (ptr MonoCtx)) (p (ptr Program)) (map (ptr (ArrayList SubstEntry)))] (-> (Result (ptr (ArrayList ExportC)) Diag))
  (try (let [a (.a m)
             (mut out) (ArrayList::new [ExportC] a)]
         (for [i 0 (len (load (.exports p)))]
           (let [ep (elem (.exports p) i)]
             (when (none? (generic-func m (.name ep)))
               (let [(mut ne) (load ep)]
                 (set! (.params ne) (try! (specialize-list [Type] m (.params ep) map)))
                 (push! (mut out) (load ne))))
             0))
         (Ok [(ptr (ArrayList ExportC)) Diag] (box-al [ExportC] a (load out))))))

;;; The program's exports, then the by-value C entries of generic instances.
(defn with-instance-entries [(a (dyn Allocator)) (m (ptr MonoCtx)) (exports (ptr (ArrayList ExportC)))] (-> (ptr (ArrayList ExportC)))
  (let [(mut out) (ArrayList::new [ExportC] a)
        entries (field (field m instance_entries) items)]
    (for [i 0 (len (load exports))]
      (push! (mut out) (get (load exports) i)))
    (for [i 0 (len (load entries))]
      (push! (mut out) (get (load entries) i)))
    (box-al [ExportC] a (load out))))

(defn externs-never-return-void [(a (dyn Allocator)) (es (ptr (ArrayList Extern)))] (-> (ptr (ArrayList Extern)))
  (let [(mut out) (ArrayList::new [Extern] a)]
    (for [i 0 (len (load es))]
      (let [e (elem es i)]
        (push! (mut out) (load e))
        (set! (.ret (elem (mut out) i)) (never-returns-void (.ret e)))))
    (box-al [Extern] a (load out))))

(defn build-mono-program [(a (dyn Allocator))
                          (m (ptr MonoCtx))
                          (p (ptr Program))
                          (asserts (ptr (ArrayList StaticAssert)))
                          (consts (ptr (ArrayList Const)))
                          (exports (ptr (ArrayList ExportC)))] (-> (ptr Program))
  (let [out (box! a Program (primitive/zeroed Program))]
    (set! (.annotation_defs out) (load (field p annotation_defs)))
    (set! (.conventions out) (load (field p conventions)))
    (set! (.structs out) (box-al [StructDef] a (.items (field m structs))))
    (set! (.sums out) (box-al [SumDef] a (.items (field m sums))))
    (set! (.externs out) (externs-never-return-void a (load (field p externs))))
    (set! (.funcs out) (box-al [Func] a (.items (field m funcs))))
    (set! (.asserts out) asserts)
    (set! (.consts out) consts)
    ; Traits and impls are semantic metadata as well as specialization input.
    ; Native code generation ignores these tables, but an incremental compiler
    ; session must retain them to check a later definition against the accepted
    ; trait environment without reconstructing compiler-generated method names.
    (set! (.traits out) (load (field p traits)))
    (set! (.impls out) (load (field p impls)))
    (set! (.metas out) (box-al [Expr] a (ArrayList::new [Expr] a)))
    (set! (.exports out) exports)
    (set! (.function_abis out) (load (field p function_abis)))
    (set! (.mono_origins out) (box-al [MonoOrigin] a (.origins m)))
    (set! (.unit_exports out) (load (field p unit_exports)))
    (set! (.unit_build out) (.unit_build p))
    (set! (.aliases out) (load (field p aliases)))
    (set! (.retirements out) (.retirements p))
    (set! (.retired_functions out) (.retired_functions p))
    (set! (.mono_trait_uses out) (box-al [MonoTraitUse] a (.trait_uses m)))
    out))

;;; ---- keeping what a reused native program already has ----------------------------
;;; A retained session specializes against the native program it built last time.
;;; Every concrete struct and sum is specialized again on each run, and unless the
;;; source changed the result is the definition already there. Writing the new copy
;;; over it is harmless to a single compilation and costly to whoever keeps the
;;; program: every run hands them a freshly allocated, identical definition to retain
;;; in place of the one they already hold. These tell the two apart.

(defn mono-layout-same? [(left (ptr Layout)) (right (ptr Layout))] (-> bool)
  (match (load left)
    (LayoutWritten [_ _] (panic "mono: a struct's :layout was never decided"))
    (LC [] (match (load right) (LC [] true) (_ false)))
    (LPacked [] (match (load right) (LPacked [] true) (_ false)))
    (LAligned [n] (match (load right) (LAligned [m] (= n m)) (_ false)))
    (LExplicit [offsets size align]
      (match (load right)
        (LExplicit [other-offsets other-size other-align]
          (and (= align other-align)
               (and (mono-i64-lists-same? offsets other-offsets)
                    (match size
                      (Some [n] (match other-size (Some [m] (= n m)) (None [] false)))
                      (None [] (match other-size (Some [_] false) (None [] true)))))))
        (_ false)))
    (LBits [backing offsets]
      (match (load right)
        (LBits [other-backing other-offsets]
          (and (= backing other-backing) (mono-i64-lists-same? offsets other-offsets)))
        (_ false)))))

(defn mono-i64-lists-same? [(left (ptr (ArrayList i64))) (right (ptr (ArrayList i64)))] (-> bool)
  (block :same
    (when (= left right) (return-from :same true))
    (when (or (= (primitive/cast i64 left) 0) (= (primitive/cast i64 right) 0))
      (return-from :same false))
    (when (!= (len (load left)) (len (load right))) (return-from :same false))
    (for [i 0 (len (load left))]
      (when (!= (get (load left) i) (get (load right) i)) (return-from :same false)))
    true))

(defn mono-fields-same? [(left (ptr (ArrayList Field))) (right (ptr (ArrayList Field)))] (-> bool)
  (block :same
    (when (!= (len (load left)) (len (load right))) (return-from :same false))
    (for [i 0 (len (load left))]
      (let [l (elem left i) r (elem right i)]
        (unless (and (= (.name l) (.name r)) (type-eq (field l ty) (field r ty)))
          (return-from :same false))))
    true))

;;; Whether the specialized FRESH says nothing the definition already recorded
;;; under its name does not.
(defn mono-struct-already? [(m (ptr MonoCtx)) (fresh (ptr StructDef))] (-> bool)
  (match (def-table-find [StructDef] (field m structs) (.name fresh))
    (None [] false)
    (Some [prior]
          (and (= (len (load (.type_params prior))) 0)
               (and (= (len (load (.bounds prior))) 0)
                    (and (mono-layout-same? (field prior layout) (field fresh layout))
                         (mono-fields-same? (.fields prior) (.fields fresh))))))))

(defn mono-sum-already? [(m (ptr MonoCtx)) (fresh (ptr SumDef))] (-> bool)
  (match (def-table-find [SumDef] (field m sums) (.name fresh))
    (None [] false)
    (Some [prior]
          (block :same
            (unless (and (= (len (load (.type_params prior))) (len (load (.type_params fresh))))
                         (and (= (len (load (.bounds prior))) (len (load (.bounds fresh))))
                              (= (len (load (.variants prior))) (len (load (.variants fresh))))))
              (return-from :same false))
            (for [i 0 (len (load (.variants prior)))]
              (let [l (elem (.variants prior) i) r (elem (.variants fresh) i)]
                (unless (and (= (.name l) (.name r)) (mono-fields-same? (.fields l) (.fields r)))
                  (return-from :same false))))
            true))))

;;; A function the submission retired, or an instance of one. Retired artifacts are
;;; never reused: a replacement declaration reuses their names.
(defn retired-instance? [(p (ptr Program)) (name (slice u8))] (-> bool)
  (let [names (.retired_functions p)]
    (and (!= (primitive/cast i64 names) 0)
      (block :found
        (for [i 0 (len (load names))]
          (let [retired (get (load names) i)]
            (when (or (= name retired)
                      (and (> (len name) (+ (len retired) 2))
                           (and (= (subslice name 0 (len retired)) retired)
                                (= (subslice name (len retired) (+ (len retired) 2)) "__"))))
              (break :found true))))
        false))))

;;; Take on what PRIOR, the native program an earlier run made, already has: its
;;; instances' origins, its structs and sums, which retained signatures may
;;; mention, and its functions, as declarations. Specialization borrows them and
;;; never replaces them; nothing it produces takes their names.
(defn adopt-prior! [(m (ptr MonoCtx)) (p (ptr Program)) (prior (ptr Program))] (-> i64)
  (let [a (.a m)
        origins (.mono_origins prior)]
    (unless (= (primitive/cast i64 origins) 0)
      (for [i 0 (len (load origins))]
        (let [origin (elem origins i)]
          (unless (retired-instance? p (.generated origin))
            (record-origin! m (.kind origin) (.generated origin) (.source origin) (.args origin))
            (mark-trait-instance! m (.generated origin) (.trait_name origin) (.impl_source origin))
            0)))
      0)
    (for [i 0 (len (load (.structs prior)))]
      (let [definition (elem (.structs prior) i)]
        (def-table-put! [StructDef] (field m structs) (load definition))
        (mark-queued! m (StructInstance) (.name definition))))
    (for [i 0 (len (load (.sums prior)))]
      (let [definition (elem (.sums prior) i)]
        (def-table-put! [SumDef] (field m sums) (load definition))
        (mark-queued! m (SumInstance) (.name definition))))
    (for [i 0 (len (load (.funcs prior)))]
      (let [f (elem (.funcs prior) i)]
        (unless (retired-instance? p (.name f))
          ; Declared functions keep the exact Coil ABI and calling convention;
          ; they are not converted to a text/extern approximation.
          (let [(mut declaration) (load f)]
            (set! (.declared declaration) true)
            (set! (.lazy declaration) (primitive/cast (ptr i8) 0))
            ; A function carried over before is already this declaration; give it
            ; the empty body it has, not a newly allocated identical one.
            (unless (and (.declared f) (= (len (load (.body f))) 0))
              (set! (.body declaration) (box-al [Expr] a (ArrayList::new [Expr] a)))
              0)
            (def-table-put! [Func] (field m funcs) (load declaration))
            (mark-queued! m (FuncInstance) (.name f))
            (set! (mut (field m retained_funcs)) (.name f) 0)
            0))))
    0))

;;; ---- entry ---------------------------------------------------------------------

;;; The checker tables mono reads ownership and dispatch from, built for `p`.
;;;
;;; `accepted` is the state `p` was checked on top of, or null. It matters: setting up
;;; checks every constant, and replaces each runtime constant's value in place with the
;;; elaborated tree. Without the state to recognize accepted constants by, every edit
;;; of a retained session re-typed every constant it had ever accepted, a second time,
;;; and rewrote the checked program's own records while doing it -- which is what kept
;;; any two accepted states from sharing a single constant.
(defn mono-ownership-context [(a (dyn Allocator)) (p (ptr Program)) (accepted (ptr LS))] (-> (Result (ptr Cx) Diag))
  (let [cx (box! a Cx (primitive/zeroed Cx))
        imports (box-al [ImpEntry] a (ArrayList::new [ImpEntry] a))
        exports (box-al [ExpEntry] a (ArrayList::new [ExpEntry] a))]
    (set! (.trait_uses cx) (ArrayList::new [MonoTraitUse] a))
    ; Setting up re-checks each constant, and an anonymous function in one is
    ; lifted again. The checked Program already holds that lift (the check that
    ; produced it numbered its constants' anonymous functions first, as this does),
    ; so these lists are only the checker's working storage and are dropped.
    (set! (.anon_funcs cx) (ArrayList::new [Func] a))
    (set! (.anon_c_entries cx) (ArrayList::new [ExportC] a))
    (set! (.anon_outer_env cx) (primitive/cast (ptr (ArrayList EnvEntry)) 0))
    (set! (.recovered_diags cx) (ArrayList::new [Diag] a))
    (match (setup-retained a cx p imports exports accepted)
      (Err [d] (Err [(ptr Cx) Diag] d))
      (Ok [_] (Ok [(ptr Cx) Diag] cx)))))

;;; The specializer's state for P, checked on top of ACCEPTED (or null).
(defn mono-new [(a (dyn Allocator)) (p (ptr Program)) (accepted (ptr LS))] (-> (Result (ptr MonoCtx) Diag))
  (try (let [phase-only (phase-only-nominals a p)
             cx (try! (mono-ownership-context a p accepted))
             templates (try! (templates-of a p))
             m (box! a MonoCtx
                     (MonoCtx :a a
                              :templates templates
                              :origins (ArrayList::new [MonoOrigin] a)
                              :origin-index (HashMap::new [(slice u8) i64] a (keyops))
                              :struct-work (worklist-new a)
                              :sum-work (worklist-new a)
                              :func-work (worklist-new a)
                              :structs (def-table-new [StructDef] a)
                              :sums (def-table-new [SumDef] a)
                              :funcs (def-table-new [Func] a)
                              :ownership_cx cx
                              :impls (load (field p impls))
                              :trait_impl_idx (HashMap::new [(slice u8) (ptr ImplBucket)] a (keyops))
                              :trait_uses (ArrayList::new [MonoTraitUse] a)
                              :trait_use_index (HashMap::new [TraitUseKey i64] a (trait-use-keyops))
                              :caller ""
                              :retained_funcs (HashMap::new [(slice u8) i64] a (keyops))
                              :phase_only phase-only
                              :instance_entries (def-table-new [ExportC] a)
                              :stage (Elaborated)))
             impls (load (field p impls))]
         (for [i 0 (len (load impls))]
           (let [ip (elem impls i)]
             (when (impl-is-trait ip)
               (impl-index-add! a (mut (field m trait_impl_idx))
                                (impl-index-key a (impl-trait-name ip) (load (field ip for_type)))
                                i))
             0))
         ; the trait uses checking recorded, as recorded; specialization adds
         ; each of its own once
         (let [checked-uses (load (field p mono_trait_uses))]
           (unless (= (primitive/cast i64 checked-uses) 0)
             (for [i 0 (len (load checked-uses))]
               (let [use (get (load checked-uses) i)
                     key (trait-use-key use)]
                 (unless (contains? (.trait_use_index m) key)
                   (set! (mut (field m trait_use_index)) key (len (.trait_uses m))))
                 (push! (mut (field m trait_uses)) use)))
             0))
         (Ok [(ptr MonoCtx) Diag] m))))

;;; Specialize the checked program P. PRIOR is the native program an earlier run
;;; made, whose declarations are borrowed (see `adopt-prior!`), or null; ACCEPTED
;;; the state P was checked on top of, or null.
(defn monomorphize-reusing [(a (dyn Allocator))
                            (p (ptr Program))
                            (prior (ptr Program))
                            (accepted (ptr LS))] (-> (Result (ptr Program) Diag))
  (try (let [m (try! (mono-new a p accepted))
             empty (subst-new a)]
         (unless (= (primitive/cast i64 prior) 0)
           (adopt-prior! m p prior))
         (try! (seed-concrete-structs m p empty))
         (try! (seed-concrete-sums m p empty))
         (try! (seed-concrete-funcs m p empty))
         (let [asserts (try! (specialize-list [StaticAssert] m (load (field p asserts)) empty))
               consts (try! (mono-consts m p empty prior))
               exports (try! (mono-exports m p empty))]
           (try! (drain m))
           (let [(mut functions) (InlineSource :a a
                                               :funcs (field (field m funcs) items)
                                               :index (field (field m funcs) index))]
             (Ok [(ptr Program) Diag]
                 (build-mono-program a m p
                                     (assert-inline-calls (mut functions) asserts)
                                     consts
                                     (with-instance-entries a m exports))))))))

(defn monomorphize [(a (dyn Allocator)) (p (ptr Program))] (-> (Result (ptr Program) Diag))
  (monomorphize-reusing a p (primitive/cast (ptr Program) 0) (primitive/cast (ptr LS) 0)))
