(module coil.compiler.unit_state)
(import "coil.primitive" :as primitive)
(import "coil.alloc" :use *)
(import "coil.arraylist" :use *)
(import "coil.io" :use [stderr print-str])
(import "coil.hashmap" :use [HashMap hm-new])
(import "coil.slice" :use [subslice])
(import "coil.str" :use [str-concat str-keyops-borrowed cstr->str])

; A compilation unit owns its compiler allocations. Existing callbacks can run
; on the pipeline, metaprogram, or main-service thread, so the binding belongs to
; the serialized compilation scope, not thread-local storage. The coordinator
; publishes/restores it only while every participating callback is quiescent.
; This does not redirect an authored metaprogram's malloc allocator.
; `kind` groups resources that share a lifetime. 0 is an ordinary resource, held
; until the unit ends. Retained sessions transfer live native/interpreter
; resources separately; compiler scratch always closes with its unit.
(defstruct UnitResource
  [(value (ptr i8)) (release (fnptr c [(ptr i8)] i64)) (kind i64)])

;;; Per-generation macro expansion arenas. Owned by one pipeline run, not by the
;;; session that runs it.
(const UNIT-RESOURCE-EXPANSION-ARENA 1)

;;; Executable mappings and interpreter constant storage outlive compiler scratch.
(const UNIT-RESOURCE-EXECUTABLE 2)
(const UNIT-RESOURCE-INTERPRETER 3)

(defstruct UnitEnvironment [(key (ptr i8)) (value (ptr i8))])

(defstruct UnitAllocationContext
  [(allocator (dyn Allocator))
   (resources (ArrayList UnitResource))
   (environment (ptr (ArrayList UnitEnvironment)))
   (resource_owner (ptr UnitAllocationContext))])

(defn unit-resource-owner [(scope (ptr UnitAllocationContext))] (-> (ptr UnitAllocationContext))
  (if (= (primitive/cast i64 scope) 0)
      scope
      (if (= (primitive/cast i64 (.resource_owner scope)) 0)
          scope
          (unit-resource-owner (.resource_owner scope)))))

(extern unit.getenv :cc c [(ptr i8)] (-> (ptr i8)))

(defn unit-cstr-equal? [(a (ptr i8)) (b (ptr i8))] (-> bool)
  (let [(mut i) 0
        (mut equal) true]
    (loop (let [x (load (primitive/index a (load i)))
                y (load (primitive/index b (load i)))]
            (when (!= x y) (set! equal false) (break))
            (when (= x (primitive/cast i8 0)) (break))
            (set! i (primitive/iadd (load i) 1))))
    (load equal)))

; Compiler policy reads use the program's frozen configuration. This does not
; intercept getenv called by authored metaprograms or mutate the host environment.
(defn unit-getenv [(key (ptr i8))] (-> (ptr i8))
  (block :lookup
         (let [scope (load (unit-allocation-cell))]
           (unless (= (primitive/cast i64 scope) 0)
             (let [values (.environment scope)]
               (unless (= (primitive/cast i64 values) 0)
                 (for [i 0 (len (load values))]
                   (let [entry (al-elem [UnitEnvironment] values i)]
                     (when (unit-cstr-equal? key (.key entry))
                       (return-from :lookup (.value entry))))
                   0)
                 0))
             0))
         (unit.getenv key)))

; Resources are registered in acquisition order and closed in reverse order.
; Their callback records live in the unit arena, which remains valid until every
; callback has completed. Unscoped command tools retain process-lifetime behavior.
(defn unit-resource-kinded! [(value (ptr i8))
                             (release (fnptr c [(ptr i8)] i64))
                             (kind i64)] (-> i64)
  (let [scope (unit-resource-owner (load (unit-allocation-cell)))]
    (unless (or (= (primitive/cast i64 scope) 0)
                (= (primitive/cast i64 value) 0))
      (push! (mut (.resources scope))
             (UnitResource :value value :release release :kind kind))
      0))
  0)

(defn unit-resource! [(value (ptr i8)) (release (fnptr c [(ptr i8)] i64))] (-> i64)
  (unit-resource-kinded! value release 0))

(defn unit-resources-close! [(scope (ptr UnitAllocationContext))] (-> i64)
  (let [(mut remaining) (len (.resources scope))]
    (loop (if (= (load remaining) 0)
              (break)
              (do
                (set! remaining (primitive/isub (load remaining) 1))
                (let [r
                        (al-elem [UnitResource]
                                 (field scope resources)
                                 (load remaining))]
                  (primitive/call-ptr (.release r) (.value r)))))))
  (set! (.len (field scope resources)) 0)
  0)

; Close only the resources released by RELEASE, keeping every other one
; registered. A retained compiler session reuses resources across generations --
; the metaprogram dylib above all -- so it cannot close a whole scope at the end
; of one pipeline run, but it still has to release that run's own arenas.
(defn unit-resources-close-kind! [(scope (ptr UnitAllocationContext))
                                  (kind i64)] (-> i64)
  (let [n (len (.resources scope))
        (mut closed) 0
        (mut write) 0
        (mut i) n]
    ; Release in reverse acquisition order, as unit-resources-close! does.
    (loop (if (= (load i) 0)
              (break)
              (do
                (set! i (primitive/isub (load i) 1))
                (let [r
                        (al-elem [UnitResource]
                                 (field scope resources)
                                 (load i))]
                  (when (= (.kind r) kind)
                    (primitive/call-ptr (.release r) (.value r))
                    (set! closed (primitive/iadd (load closed) 1))
                    0)))))
    ; Compact the survivors forward, keeping them in acquisition order.
    (for [j 0 n]
      (let [r (al-elem [UnitResource] (field scope resources) j)]
        (unless (= (.kind r) kind)
          (let [dst
                  (al-elem [UnitResource]
                           (field scope resources)
                           (load write))]
            (set! (.value dst) (.value r))
            (set! (.release dst) (.release r))
            (set! (.kind dst) (.kind r)))
          (set! write (primitive/iadd (load write) 1))
          0)))
    (set! (.len (field scope resources)) (load write))
    (load closed)))

(defn unit-allocation-cell [] (-> (ptr (ptr UnitAllocationContext)))
  (primitive/alloc-static (ptr UnitAllocationContext)))

(defn unit-allocation-bind! [(next (ptr UnitAllocationContext))] (-> (ptr UnitAllocationContext))
  (let [prior (load (unit-allocation-cell))]
    (set! (unit-allocation-cell) next)
    prior))

(defn unit-allocator [] (-> (dyn Allocator))
  (let [scope (load (unit-allocation-cell))]
    (if (= (primitive/cast i64 scope) 0)
        ; Unscoped CLI/tooling state belongs to the process. Unit compilation
        ; always binds an explicit resettable arena before constructing state.
        (malloc-allocator)
        (.allocator scope))))

; ---- work finished after the unit is released ----------------------------------

;;; A unit may hand its caller work that needs none of the unit's arena, to run
;;; once that arena is released. The LLVM backend uses it: lowering reads the
;;; checked program, but optimization, partitioning and emission work only on the
;;; LLVM module, which owns copies of everything it needs. Emitting inside the unit
;;; kept the whole frontend arena (4 GB for the compiler itself) live underneath
;;; LLVM's own peak.
;;;
;;; The caller opens the slot for exactly one unit; work offered from any other
;;; unit (a generated unit nested inside it, say) runs inline as before.
(defstruct UnitDeferredWork
  [(owner (ptr UnitAllocationContext))
   (finish (fnptr c [(ptr i8)] i64))
   (state (ptr i8))
   (pending bool)])

(defn unit-deferred-cell [] (-> (ptr UnitDeferredWork))
  (primitive/alloc-static UnitDeferredWork))

(defn unit-defer-fail [(message (slice u8))] (-> i64)
  (print-str (stderr) "internal error: ")
  (print-str (stderr) message)
  (print-str (stderr) "\n")
  (abort)
  0)

;;; Accept deferred work from the currently bound unit.
(defn unit-defer-open! [] (-> i64)
  (let [cell (unit-deferred-cell)]
    (when (.pending cell) (unit-defer-fail "unit-defer-open!: the previous deferred work never ran"))
    (set! (.owner cell) (load (unit-allocation-cell)))
    0))

;;; Whether work offered now may wait until the current unit is released.
(defn unit-defer-available? [] (-> bool)
  (let [cell (unit-deferred-cell)
        owner (.owner cell)]
    (and (not (.pending cell))
         (!= (primitive/cast i64 owner) 0)
         (= (primitive/cast i64 owner) (primitive/cast i64 (load (unit-allocation-cell)))))))

;;; Hand over work; `state` must not live in the unit's arena. The caller must have
;;; checked unit-defer-available?.
(defn unit-defer! [(finish (fnptr c [(ptr i8)] i64)) (state (ptr i8))] (-> i64)
  (let [cell (unit-deferred-cell)]
    (unless (unit-defer-available?) (unit-defer-fail "unit-defer!: no open slot for this unit"))
    (set! (.finish cell) finish)
    (set! (.state cell) state)
    (set! (.pending cell) true)
    0))

;;; Close the slot after the unit has been released, running any work it received.
;;; `result` is what the unit returned; deferred work's result replaces it.
(defn unit-defer-finish! [(result i64)] (-> i64)
  (let [cell (unit-deferred-cell)
        pending (.pending cell)
        finish (.finish cell)
        state (.state cell)]
    (set! (.owner cell) (primitive/cast (ptr UnitAllocationContext) 0))
    (set! (.pending cell) false)
    (if pending (primitive/call-ptr finish state) result)))

; ---- the implicit prelude's names -------------------------------------------------

(defn unit-concat [(a (dyn Allocator)) (x (slice u8)) (y (slice u8))] (-> (slice u8))
  (match (str-concat a x y)
    (Some [s] s)
    (None [] (do (oom-at c"a prelude declaration name" (+ (len x) (len y))) ""))))

;;; The implicit prelude this unit compiles against (`coil.core`, or a project's
;;; `[language] prelude`) and the qualified names asked of it. Keyed by the unit
;;; scope, so a nested or later unit with another configuration never reads a
;;; stale answer; `unit-prelude-reset!` drops it when the configuration changes.
(defstruct UnitPrelude
  [(scope (ptr UnitAllocationContext))
   (known bool)
   (name (slice u8))
   (qualified (ptr (HashMap (slice u8) (slice u8))))])

(defn unit-prelude-cell [] (-> (ptr UnitPrelude)) (primitive/alloc-static UnitPrelude))

(defn unit-prelude-reset! [] (-> i64)
  (set! (.known (unit-prelude-cell)) false)
  0)

(defn unit-prelude-state [] (-> (ptr UnitPrelude))
  (let [p (unit-prelude-cell)
        scope (load (unit-allocation-cell))]
    (when (or (not (.known p)) (!= (primitive/cast i64 (.scope p)) (primitive/cast i64 scope)))
      (let [a (unit-allocator)
            env (unit-getenv c"COIL_PRELUDE")]
        (set! (.scope p) scope)
        (set! (.name p)
              (if (or (= (primitive/cast i64 env) 0) (= (load env) (primitive/cast i8 0)))
                  "coil.core"
                  (unit-concat a (cstr->str env) "")))
        (set! (.qualified p)
              (box! a (HashMap (slice u8) (slice u8)) (hm-new [(slice u8) (slice u8)] a (str-keyops-borrowed))))
        (set! (.known p) true))
      0)
    p))

;;; The implicit prelude's namespace for this unit.
(defn unit-prelude-name [] (-> (slice u8))
  (.name (unit-prelude-state)))

;;; NAME as the implicit prelude defines it: `coil.core.Copy`, or the replacement
;;; prelude's own qualified name when a project selects one. Compiler-known
;;; prelude declarations are named through this, never as a `coil.core.` literal.
(defn core-name [(name (slice u8))] (-> (slice u8))
  (let [p (unit-prelude-state)]
    (match (get (.qualified p) name)
      (Some [q] q)
      (None []
            (let [a (unit-allocator)
                  key (unit-concat a name "")
                  q (unit-concat a (unit-concat a (.name p) ".") name)]
              (set! (.qualified p) key q)
              q)))))

;;; Is QUALIFIED the implicit prelude's NAME? Compares without allocating.
(defn core-name? [(qualified (slice u8)) (name (slice u8))] (-> bool)
  (let [p (unit-prelude-name)
        pl (len p)]
    (and (= (len qualified) (+ pl (+ 1 (len name))))
         (and (= (subslice qualified 0 pl) p)
              (and (= (get qualified pl) (primitive/cast u8 46))
                   (= (subslice qualified (+ pl 1) (len qualified)) name))))))

;;; Does QUALIFIED begin with the implicit prelude's NAME (a specialization suffix
;;; such as `take!__i64` follows)? Compares without allocating.
(defn core-name-prefix? [(qualified (slice u8)) (name (slice u8))] (-> bool)
  (let [p (unit-prelude-name)
        pl (len p)
        n (+ pl (+ 1 (len name)))]
    (and (>= (len qualified) n)
         (and (= (subslice qualified 0 pl) p)
              (and (= (get qualified pl) (primitive/cast u8 46))
                   (= (subslice qualified (+ pl 1) n) name))))))
