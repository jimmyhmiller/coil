(module coil.compiler.unit_state)
(import "coil.primitive" :as primitive)
(import "coil.alloc" :use *)
(import "coil.arraylist" :use *)

; A compilation unit owns its compiler allocations. Existing callbacks can run
; on the pipeline, metaprogram, or main-service thread, so the binding belongs to
; the serialized compilation scope, not thread-local storage. The coordinator
; publishes/restores it only while every participating callback is quiescent.
; This does not redirect an authored metaprogram's malloc allocator.
(defstruct UnitResource [(value (ptr i8)) (release (fnptr c [(ptr i8)] i64))])
(defstruct UnitEnvironment [(key (ptr i8)) (value (ptr i8))])
(defstruct UnitAllocationContext
  [(allocator (dyn Allocator)) (resources (ArrayList UnitResource))
   (environment (ptr (ArrayList UnitEnvironment)))
   (resource_owner (ptr UnitAllocationContext))])

(defn unit-resource-owner [(scope (ptr UnitAllocationContext))] (-> (ptr UnitAllocationContext))
  (if (= (primitive/cast i64 scope) 0) scope
    (if (= (primitive/cast i64 (.resource_owner scope)) 0) scope
      (unit-resource-owner (.resource_owner scope)))))

(extern unit.getenv :cc c [(ptr i8)] (-> (ptr i8)))
(defn unit-cstr-equal? [(a (ptr i8)) (b (ptr i8))] (-> bool)
  (let [(mut i) 0 (mut equal) true]
    (loop (let [x (load (primitive/index a (load i)))
                y (load (primitive/index b (load i)))]
      (when (!= x y) (set! equal false) (break))
      (when (= x (primitive/cast i8 0)) (break))
      (set! i (primitive/iadd (load i) 1))))
    (load equal)))

; Compiler policy reads use the program's frozen configuration. This does not
; intercept getenv called by authored metaprograms or mutate the host environment.
(defn unit-getenv [(key (ptr i8))] (-> (ptr i8))
  (block :lookup
    (let [scope (load (unit-allocation-cell))]
      (unless (= (primitive/cast i64 scope) 0)
        (let [values (.environment scope)]
          (unless (= (primitive/cast i64 values) 0)
            (for [i 0 (len (load values))]
              (let [entry (al-elem [UnitEnvironment] values i)]
                (when (unit-cstr-equal? key (.key entry))
                  (return-from :lookup (.value entry)))) 0)
            0)) 0))
    (unit.getenv key)))

; Resources are registered in acquisition order and closed in reverse order.
; Their callback records live in the unit arena, which remains valid until every
; callback has completed. Unscoped command tools retain process-lifetime behavior.
(defn unit-resource! [(value (ptr i8)) (release (fnptr c [(ptr i8)] i64))] (-> i64)
  (let [scope (unit-resource-owner (load (unit-allocation-cell)))]
    (unless (or (= (primitive/cast i64 scope) 0) (= (primitive/cast i64 value) 0))
      (push! (mut (.resources scope)) (UnitResource :value value :release release)) 0))
  0)

(defn unit-resources-close! [(scope (ptr UnitAllocationContext))] (-> i64)
  (let [(mut remaining) (len (.resources scope))]
    (loop (if (= (load remaining) 0) (break)
      (do (set! remaining (primitive/isub (load remaining) 1))
          (let [r (al-elem [UnitResource] (field scope resources) (load remaining))]
            (primitive/call-ptr (.release r) (.value r)))))))
  (set! (.len (field scope resources)) 0)
  0)

(defn unit-allocation-cell [] (-> (ptr (ptr UnitAllocationContext)))
  (primitive/alloc-static (ptr UnitAllocationContext)))

(defn unit-allocation-bind! [(next (ptr UnitAllocationContext))]
                            (-> (ptr UnitAllocationContext))
  (let [prior (load (unit-allocation-cell))]
    (set! (unit-allocation-cell) next)
    prior))

(defn unit-allocator [] (-> (dyn Allocator))
  (let [scope (load (unit-allocation-cell))]
    (if (= (primitive/cast i64 scope) 0)
        ; Unscoped CLI/tooling state belongs to the process. Unit compilation
        ; always binds an explicit resettable arena before constructing state.
        (malloc-allocator)
        (.allocator scope))))
