; src/compiler/cimport.coil — `coil cimport` written IN Coil (self-hosted).

;
; Generate Coil FFI
; bindings (externs + defstructs + consts) from a C header by walking clang's
; JSON AST. Coil NEVER hand-rolls a C parser — clang does the real parsing; this
; walks its machine-readable AST. THE CARDINAL (unchanged): refuse unmappable
; constructs with a clear skip — NEVER emit a silent-wrong binding.
;
; Coverage mirrors the reference: functions, scalars, pointers, structs, unions
; (→ :layout explicit, overlapping storage), bitfield structs (all-bitfield, one
; storage unit → :layout bits :backing :iN), typedefs (clang desugaring), enums
; (type → integer width; constants → `const`), and object-like `#define` integer
; AND float constants (a second `clang -dM` pass; floats emitted verbatim).
;
; Run standalone via the self-hosted compiler:
;   coil build src/compiler/cimport.coil -o /tmp/cimport <llvm-link-flags>
;   /tmp/cimport <header.h>          # bindings printed to stdout
; A `(module cimport)` so it can be imported into the self-hosted compiler `:as ci`
; (its internal names stay module-local; only cimport-cli/cimport-header are called).
; `src/compiler/cimport_main.coil` wraps it as a standalone `main` for the gate.
(module coil.compiler.cimport)
(import "coil.primitive" :as primitive)

; Bundled stdlib module names (bare), matching the compiler's own imports, so when
; this module is pulled into the compiler they share ONE module identity (no dual
; src/stdlib/alloc-vs-alloc `Allocator` type).
(import "coil.alloc" :as alloc :use *)
(import "coil.result" :use *)
(import "coil.slice" :use *)
(import "coil.str" :use *)
(import "coil.arraylist" :use *)
(import "coil.hashmap" :use *)
(import "coil.control" :use *)

; ---- externs (libc: subprocess + file IO + stdout). Externs are global C symbols
; (not namespaced); these signatures MATCH the compiler's ffi.coil/io.coil so the
; duplicate declarations coincide harmlessly when imported into the compiler. -----
(extern system :cc c [(ptr i8)] (-> i32))

(extern open :cc c [(ptr i8) i32 ...] (-> i32))

(extern read :cc c [i32 (ptr i8) isize] (-> isize))

(extern close :cc c [i32] (-> i32))

(extern write :cc c [i32 (ptr i8) isize] (-> isize))

(extern getpid :cc c [] (-> i32))

(extern fopen :cc c [(ptr i8) (ptr i8)] (-> (ptr i8)))

(extern fwrite :cc c [(ptr i8) i64 i64 (ptr i8)] (-> i64))

(extern fclose :cc c [(ptr i8)] (-> i32))

(extern realpath :cc c [(ptr i8) (ptr i8)] (-> (ptr i8)))

; ============================ small helpers =================================

; A slice → NUL-terminated C string (fresh allocation).
(defn s->cstr [(a (dyn Allocator)) (s (slice u8))] (-> (ptr i8))
  (let [n (len s)
        buf
          (primitive/cast (ptr i8)
                          (slice-data (match (alloc-bytes a (primitive/iadd n 1) 1)
                                        (Some [s] s)
                                        (None []
                                              (do
                                                (oom-at c"compiler allocation" (primitive/iadd n 1))
                                                (alloc/alloc-slice-new (primitive/cast (ptr u8) 0) 0))))))
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (set! (primitive/index buf (load i)) (primitive/cast i8 (get s (load i))))
                (set! i (primitive/iadd (load i) 1)))))
    (set! (primitive/index buf n) (primitive/cast i8 0))
    buf))

; Read a whole file into a (slice u8) (empty slice if it won't open).
(defn slurp [(a (dyn Allocator)) (path (ptr i8))] (-> (slice u8))
  (let [fd (open path 0)]
    (if (< fd (primitive/cast i32 0))
        (al-slice [u8] (al-new [u8] a))
        (let [buf
                (primitive/cast (ptr i8)
                                (slice-data (match (alloc-bytes a 65536 1)
                                              (Some [s] s)
                                              (None []
                                                    (do
                                                      (oom-at c"compiler allocation" 65536)
                                                      (alloc/alloc-slice-new (primitive/cast (ptr u8) 0) 0))))))
              (mut bytes) (al-new [u8] a)]
          (loop (let [n (read (primitive/cast i32 fd) buf 65536)]
                  (if (<= n (primitive/cast i64 0))
                      (break)
                      (let [(mut i) 0]
                        (loop (if (>= (load i) (primitive/cast i64 n))
                                  (break)
                                  (do
                                    (push! [u8] (mut bytes) (primitive/cast u8 (load (primitive/index buf (load i)))))
                                    (set! i (primitive/iadd (load i) 1)))))))))
          (close fd)
          (al-slice [u8] (load bytes))))))

; Write a slice to stdout.
(defn emit [(s (slice u8))] (-> i64)
  (write 1 (primitive/cast (ptr i8) (slice-data [u8] s)) (primitive/cast isize (len s)))
  0)

(defn ewrite [(s (slice u8))] (-> i64)
  (write 2 (primitive/cast (ptr i8) (slice-data [u8] s)) (primitive/cast isize (len s)))
  0)

; Write a slice to a file (truncating). Returns 0 on success, -1 on open failure.
(defn write-file [(a (dyn Allocator)) (path (slice u8)) (content (slice u8))] (-> i64)
  (let [f (fopen (s->cstr a path) (s->cstr a "w"))]
    (if (= (primitive/cast i64 f) (primitive/cast i64 0))
        -1
        (do
          (fwrite (primitive/cast (ptr i8) (slice-data [u8] content)) 1 (len content) f)
          (fclose f)
          0))))

; str-concat is fallible only on OOM; unwrap to the left operand as a fallback.
(defn cat [(a (dyn Allocator)) (x (slice u8)) (y (slice u8))] (-> (slice u8))
  (match (str-concat a x y) (Some [s] s) (None [] x)))

(defn cat3 [(a (dyn Allocator)) (x (slice u8)) (y (slice u8)) (z (slice u8))] (-> (slice u8))
  (cat a (cat a x y) z))

(defn ws-byte? [(c u8)] (-> bool)
  (or (= c (primitive/cast u8 32))
      (or (= c (primitive/cast u8 9))
          (or (= c (primitive/cast u8 10)) (= c (primitive/cast u8 13))))))

; Trim leading + trailing ASCII whitespace.
(defn trim [(s (slice u8))] (-> (slice u8))
  (let [n (len s)
        (mut lo) 0
        (mut hi) n]
    (loop (if (and (< (load lo) (load hi)) (ws-byte? (get s (load lo))))
              (set! lo (primitive/iadd (load lo) 1))
              (break)))
    (loop (if (and (< (load lo) (load hi)) (ws-byte? (get s (primitive/isub (load hi) 1))))
              (set! hi (primitive/isub (load hi) 1))
              (break)))
    (subslice [u8] s (load lo) (load hi))))

(defn ends-with [(s (slice u8)) (suf (slice u8))] (-> bool)
  (let [n (len s)
        m (len suf)]
    (if (> m n) false (= (subslice [u8] s (primitive/isub n m) n) suf))))

; Index of the first byte `b` at/after `from`, or -1.
(defn index-of [(s (slice u8)) (b u8) (from i64)] (-> i64)
  (let [n (len s)
        (mut i) from
        (mut r) -1]
    (loop (if (>= (load i) n)
              (break)
              (if (= (get s (load i)) b)
                  (do (set! r (load i)) (break))
                  (set! i (primitive/iadd (load i) 1)))))
    (load r)))

(defn has-byte? [(s (slice u8)) (b u8)] (-> bool)
  (>= (index-of s b 0) (primitive/cast i64 0)))

; Everything before the first byte `b` (whole string if absent).
(defn before [(s (slice u8)) (b u8)] (-> (slice u8))
  (let [i (index-of s b 0)]
    (if (< i (primitive/cast i64 0)) s (subslice [u8] s 0 i))))

; Remove EVERY occurrence of `pat` from `s` (for `const `/`volatile `/`restrict `).
(defn remove-all [(a (dyn Allocator)) (s (slice u8)) (pat (slice u8))] (-> (slice u8))
  (let [m (len pat)]
    (if (= m (primitive/cast i64 0))
        s
        (let [(mut out) (sb-new a)
              n (len s)
              (mut i) 0]
          (loop (if (>= (load i) n)
                    (break)
                    (if (and (<= (primitive/iadd (load i) m) n)
                             (= (subslice [u8] s (load i) (primitive/iadd (load i) m)) pat))
                        (set! i (primitive/iadd (load i) m))
                        (do
                          (sb-push-byte! (mut out) (get s (load i)))
                          (set! i (primitive/iadd (load i) 1))))))
          (sb-str (load out))))))

; Basename: everything after the last '/'.
(defn basename [(s (slice u8))] (-> (slice u8))
  (let [n (len s)
        (mut cut) 0
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (when (= (get s (load i)) (primitive/cast u8 47))
                  (store! cut
                          (primitive/iadd (load i) 1)))
                (set! i (primitive/iadd (load i) 1)))))
    (subslice [u8] s (load cut) n)))

; i64 → decimal text.
(defn i64->dec [(a (dyn Allocator)) (n i64)] (-> (slice u8))
  (if (= n (primitive/cast i64 0))
      "0"
      (let [(mut neg) false
            (mut v) n
            (mut tmp) (al-new [u8] a)]
        (when (< (load v) (primitive/cast i64 0)) (store! neg true) (store! v (primitive/isub 0 (load v))) 0)
        (loop (if (= (load v) (primitive/cast i64 0))
                  (break)
                  (do
                    (push! [u8] (mut tmp) (primitive/cast u8 (primitive/iadd 48 (primitive/irem (load v) 10))))
                    (set! v (primitive/idiv (load v) 10)))))
        (let [(mut out) (sb-new a)
              len (len (load tmp))]
          (when (load neg) (sb-push-byte! (mut out) (primitive/cast u8 45)))
          (let [(mut k) len]
            (loop (if (<= (load k) (primitive/cast i64 0))
                      (break)
                      (do
                        (sb-push-byte! (mut out) (get (load tmp) (primitive/isub (load k) 1)))
                        (set! k (primitive/isub (load k) 1))))))
          (sb-str (load out))))))

; Parse a non-negative decimal from `s`; returns -1 on any non-digit.
(defn parse-dec [(s (slice u8))] (-> i64)
  (let [n (len s)
        (mut v) 0
        (mut i) 0
        (mut ok) (> n (primitive/cast i64 0))]
    (loop (if (>= (load i) n)
              (break)
              (let [c (get s (load i))]
                (if (and (>= c (primitive/cast u8 48)) (<= c (primitive/cast u8 57)))
                    (do
                      (set! v
                            (primitive/iadd (primitive/imul (load v) 10)
                                            (primitive/cast i64 (primitive/isub c (primitive/cast u8 48)))))
                      (set! i (primitive/iadd (load i) 1)))
                    (do (set! ok false) (break))))))
    (if (load ok) (load v) -1)))

; ============================ JSON value model ==============================
(defsum Json
  (JNull [])
  (JBool [(b i64)])
  (JNum [(n i64)])
  (JStr [(s (slice u8))])
  (JArr [(a (ptr (ArrayList Json)))])
  (JObj [(o (ptr (HashMap (slice u8) Json)))]))

(defstruct P [(src (slice u8)) (pos i64) (alc (dyn Allocator))])

(defn p-peek [(p (ptr P))] (-> i64)
  (if (>= (.pos p) (len (.src p)))
      -1
      (primitive/cast i64 (get (.src p) (.pos p)))))

(defn p-adv [(p (ptr P))] (-> i64)
  (set! (.pos p) (primitive/iadd (.pos p) 1))
  0)

(defn j-ws? [(c i64)] (-> bool)
  (or (= c (primitive/cast i64 32))
      (or (= c (primitive/cast i64 10)) (or (= c (primitive/cast i64 9)) (= c (primitive/cast i64 13))))))

(defn j-skip-ws [(p (ptr P))] (-> i64)
  (loop (if (j-ws? (p-peek p)) (p-adv p) (break)))
  0)

(defn j-digit? [(c i64)] (-> bool)
  (and (>= c (primitive/cast i64 48)) (<= c (primitive/cast i64 57))))

(defn j-eat [(p (ptr P)) (len i64)] (-> i64)
  (for [i 0 len] (p-adv p))
  0)

; Parse a JSON string into a (slice u8) VIEW; skips escape pairs so an escaped
; quote can't desync the scanner (we never read a field whose value is escaped).
(defn j-string [(p (ptr P))] (-> (slice u8))
  (p-adv p)
  (let [start (.pos p)]
    (loop (let [c (p-peek p)]
            (cond (= c (primitive/cast i64 34)) (break)
                  (= c (primitive/cast i64 92)) (do (p-adv p) (p-adv p))
                  ; backslash: skip 2
                  (< c (primitive/cast i64 0)) (break)
                  :else (p-adv p))))
    (let [s (subslice [u8] (.src p) start (.pos p))]
      (p-adv p)
      s)))

; A number token → JNum of its integer part; consumes any fractional/exponent
; tail so a stray float can't desync (clang AST numbers we read are integers).
(defn j-number [(p (ptr P))] (-> Json)
  (let [(mut neg) 0
        (mut v) 0]
    (when (= (p-peek p) (primitive/cast i64 45)) (store! neg 1) (p-adv p))
    (loop (let [c (p-peek p)]
            (if (j-digit? c)
                (do
                  (set! v (primitive/iadd (primitive/imul (load v) 10) (primitive/isub c 48)))
                  (p-adv p))
                (break))))
    (loop (let [c (p-peek p)]  ; swallow . / digits / e / +/-
            (if (or (= c (primitive/cast i64 46))
                    (or (= c (primitive/cast i64 101))
                        (or (= c (primitive/cast i64 69))
                            (or (= c (primitive/cast i64 43)) (or (= c (primitive/cast i64 45)) (j-digit? c))))))
                (p-adv p)
                (break))))
    (JNum (if (= (load neg) (primitive/cast i64 1)) (primitive/isub 0 (load v)) (load v)))))

(defn j-value [(p (ptr P))] (-> Json)
  (j-skip-ws p)
  (let [c (p-peek p)]
    (cond (= c (primitive/cast i64 110)) (do (j-eat p 4) (JNull))
          (= c (primitive/cast i64 116)) (do (j-eat p 4) (JBool 1))
          (= c (primitive/cast i64 102)) (do (j-eat p 5) (JBool 0))
          (= c (primitive/cast i64 34)) (JStr (j-string p))
          (= c (primitive/cast i64 91)) (j-array p)
          (= c (primitive/cast i64 123)) (j-object p)
          :else (j-number p))))

(defn j-array [(p (ptr P))] (-> Json)
  (p-adv p)
  (let [arr (box! (load (field p alc)) (ArrayList Json) (al-new [Json] (load (field p alc))))]
    (j-skip-ws p)
    (if (= (p-peek p) (primitive/cast i64 93))
        (p-adv p)
        (loop (push! [Json] arr (j-value p))
          (j-skip-ws p)
          (if (= (p-peek p) (primitive/cast i64 44)) (p-adv p) (do (p-adv p) (break)))))
    (JArr arr)))

(defn j-object [(p (ptr P))] (-> Json)
  (p-adv p)
  (let [obj
          (box! (load (field p alc))
                (HashMap (slice u8) Json)
                (hm-new [(slice u8) Json] (load (field p alc)) (str-keyops)))]
    (j-skip-ws p)
    (if (= (p-peek p) (primitive/cast i64 125))
        (p-adv p)
        (loop (j-skip-ws p)
          (let [key (j-string p)]
            (j-skip-ws p)
            (p-adv p)  ; ':'
            (set! obj key (j-value p)))
          (j-skip-ws p)
          (if (= (p-peek p) (primitive/cast i64 44)) (p-adv p) (do (p-adv p) (break)))))
    (JObj obj)))

(defn json-parse [(a (dyn Allocator)) (src (slice u8))] (-> Json)
  (let [p (primitive/alloc-stack P)]
    (set! (.src p) src)
    (set! (.pos p) 0)
    (set! (.alc p) a)
    (j-value p)))

; ---- accessors -------------------------------------------------------------
(defn jget [(j Json) (k (slice u8))] (-> Json)
  (match j (JObj [o] (match (get (load o) k) (Some [v] v) (None [] (JNull)))) (_ (JNull))))

(defn jstr [(j Json)] (-> (Option (slice u8)))
  (match j (JStr [s] (Some s)) (_ (None [(slice u8)]))))

(defn jgets [(j Json) (k (slice u8))] (-> (Option (slice u8)))
  (jstr (jget j k)))

(defn jstr-or [(o (Option (slice u8))) (d (slice u8))] (-> (slice u8))
  (match o (Some [s] s) (None [] d)))

(defn jkind [(j Json)] (-> (slice u8))
  (jstr-or (jgets j "kind") ""))

(defn jname [(j Json)] (-> (slice u8))
  (jstr-or (jgets j "name") "<anonymous>"))

(defn jbool-true? [(j Json) (k (slice u8))] (-> bool)
  (match (jget j k) (JBool [b] (= b (primitive/cast i64 1))) (_ false)))

(defn jinner [(j Json)] (-> (Option (ptr (ArrayList Json))))
  (match (jget j "inner") (JArr [a] (Some a)) (_ (None [(ptr (ArrayList Json))]))))

; ============================ resolution tables =============================
(defstruct Ctx
  [(typedefs (ptr (HashMap (slice u8) (slice u8))))
   (enums (ptr (HashMap (slice u8) (slice u8))))])

; ============================ type mapping ==================================
(defn normalize [(a (dyn Allocator)) (c (slice u8))] (-> (slice u8))
  (trim (remove-all a
                    (remove-all a
                                (remove-all a
                                            (remove-all a
                                                        (remove-all a
                                                                    (remove-all a (trim c) "const")
                                                                    "volatile")
                                                        "restrict")
                                            "_Nonnull")
                                "_Nullable")
                    "_Null_unspecified")))

(defn scalar [(s (slice u8))] (-> (Option (slice u8)))
  (cond (or (= s "char") (= s "signed char")) (Some "i8")
        (= s "unsigned char") (Some "u8")
        (or (= s "short") (= s "short int")) (Some "i16")
        (or (= s "unsigned short") (= s "unsigned short int")) (Some "u16")
        (or (= s "int") (or (= s "signed int") (= s "signed"))) (Some "i32")
        (or (= s "unsigned int") (= s "unsigned")) (Some "u32")
        (or (= s "long") (= s "long int")) (Some "i64")
        (or (= s "unsigned long") (= s "unsigned long int")) (Some "u64")
        (or (= s "long long") (= s "long long int")) (Some "i64")
        (or (= s "unsigned long long") (= s "unsigned long long int")) (Some "u64")
        (= s "float") (Some "f32")
        (= s "double") (Some "f64")
        (or (= s "_Bool") (= s "bool")) (Some "u8")
        :else (None [(slice u8)])))

(defn map-type-d [(a (dyn Allocator)) (c (slice u8)) (ctx (ptr Ctx)) (depth i64)] (-> (Result (slice u8) (slice u8)))
  (if (> depth (primitive/cast i64 64))
      (Err (cat3 a "typedef chain too deep resolving '" c "' (cycle?)"))
      (let [s (normalize a c)]
        (cond (ends-with s "]")
                (let [lb (index-of s (primitive/cast u8 91) 0)]
                  (if (< lb (primitive/cast i64 0))
                      (Err (cat3 a "unsupported C array type '" s "'"))
                      (let [base (trim (subslice [u8] s 0 lb))
                            count (parse-dec (subslice [u8] s (primitive/iadd lb 1) (primitive/isub (len s) 1)))]
                        (if (< count (primitive/cast i64 0))
                            (Err (cat3 a "non-constant C array bound in '" s "'"))
                            (match (map-type-d a base ctx (primitive/iadd depth 1))
                              (Ok [inner] (Ok (cat3 a (cat3 a "(array " inner " ") (i64->dec a count) ")")))
                              (Err [e] (Err e)))))))
              (ends-with s "*")
                (let [base (trim (subslice [u8] s 0 (primitive/isub (len s) 1)))]
                  (if (= base "void")
                      (Ok "(ptr i8)")
                      (if (has-byte? base (primitive/cast u8 40))
                          (Err (cat3 a "function-pointer type '" c "' (Phase 2+)"))
                          (match (map-type-d a base ctx (primitive/iadd depth 1))
                            (Ok [inner] (Ok (cat3 a "(ptr " inner ")")))
                            (Err [e] (Err e))))))
              :else
                (match (scalar s)
                  (Some [m] (Ok m))
                  (None []
                        (cond (or (= s "struct")
                                  (or (= s "union")
                                      (or (contains-str? s "(anonymous") (contains-str? s "(unnamed"))))
                                (Err (cat3 a "anonymous C aggregate type '" s "'"))
                              (starts-with s "struct ") (Ok (trim (subslice [u8] s 7 (len s))))
                              (starts-with s "union ") (Ok (trim (subslice [u8] s 6 (len s))))
                              (starts-with s "enum ")
                                (let [tag (trim (subslice [u8] s 5 (len s)))]
                                  (match (get (load (field ctx enums)) tag)
                                    (Some [t] (Ok t))
                                    (None [] (Ok "i32"))))
                              :else
                                (match (get (load (field ctx typedefs)) s)
                                  (Some [under] (map-type-d a under ctx (primitive/iadd depth 1)))
                                  (None [] (Err (cat3 a "unsupported C type '" s "'")))))))))))

(defn map-type [(a (dyn Allocator)) (c (slice u8)) (ctx (ptr Ctx))] (-> (Result (slice u8) (slice u8)))
  (map-type-d a c ctx 0))

(defn map-return [(a (dyn Allocator)) (c (slice u8)) (ctx (ptr Ctx))] (-> (Result (slice u8) (slice u8)))
  (if (= (normalize a c) "void") (Ok "void") (map-type a c ctx)))

; size + align (bytes) of a mapped scalar/pointer type; None for aggregates.
(defstruct SzAl [(size i64) (align i64)])

(defn scalar-size-align [(t (slice u8))] (-> (Option SzAl))
  (cond (or (starts-with t "(ptr") (starts-with t "(fnptr")) (Some (mk-szal 8 8))
        (or (= t "i8") (= t "u8")) (Some (mk-szal 1 1))
        (or (= t "i16") (= t "u16")) (Some (mk-szal 2 2))
        (or (= t "i32") (or (= t "u32") (= t "f32"))) (Some (mk-szal 4 4))
        (or (= t "i64") (or (= t "u64") (= t "f64"))) (Some (mk-szal 8 8))
        :else (None [SzAl])))

(defn mk-szal [(sz i64) (al i64)] (-> SzAl)
  (let [r (primitive/alloc-stack SzAl)] (set! (.size r) sz) (set! (.align r) al) (load r)))

; ============================ decl → binding ================================
(defn function-extern [(a (dyn Allocator)) (d Json) (ctx (ptr Ctx))] (-> (Result (slice u8) (slice u8)))
  (match (jgets d "name")
    (None [] (Err "no name"))
    (Some [name]
          (let [(mut ps) (sb-new a)
                (mut first) true
                (mut err) (None [(slice u8)])]
            (match (jinner d)
              (None [] 0)
              (Some [inner]
                    (let [(mut i) 0
                          n (len (load inner))]
                      (loop (if (>= (load i) n)
                                (break)
                                (let [p (get (load inner) (load i))]
                                  (when (= (jkind p) "ParmVarDecl")
                                    (match (jgets (jget p "type") "qualType")
                                      (None [] (do (store! err (Some "a parameter has no type")) (break)))
                                      (Some [ty]
                                            (match (map-type a ty ctx)
                                              (Err [e] (do (store! err (Some e)) (break)))
                                              (Ok [mt]
                                                  (do
                                                    (if (load first)
                                                        (do (store! first false) 0)
                                                        (sb-push-str! (mut ps) " "))
                                                    (sb-push-str! (mut ps) mt)))))))
                                  (set! i (primitive/iadd (load i) 1))))))))
            (match (load err)
              (Some [e] (Err e))
              (None []
                    (match (jgets (jget d "type") "qualType")
                      (None [] (Err "no function type"))
                      (Some [qt]
                            (match (map-return a (trim (before qt (primitive/cast u8 40))) ctx)
                              (Err [e] (Err e))
                              (Ok [ret]
                                  (let [psstr (sb-str (load ps))
                                        variadic (has-dots qt)
                                        psfull
                                          (if variadic
                                              (if (> (len psstr) (primitive/cast i64 0))
                                                  (cat3 a psstr " " "...")
                                                  "...")
                                              psstr)]
                                    (Ok (cat3 a
                                              (cat3 a "(extern " name (cat3 a " :cc c [" psfull "] (-> "))
                                              ret
                                              "))\n")))))))))))))

; Does the function type contain a "..." (variadic)?
(defn has-dots [(s (slice u8))] (-> bool)
  (let [n (len s)
        (mut i) 0
        (mut r) false]
    (loop (if (>= (primitive/iadd (load i) 2) n)
              (break)
              (if (and (= (get s (load i)) (primitive/cast u8 46))
                       (and (= (get s (primitive/iadd (load i) 1)) (primitive/cast u8 46))
                            (= (get s (primitive/iadd (load i) 2)) (primitive/cast u8 46))))
                  (do (set! r true) (break))
                  (set! i (primitive/iadd (load i) 1)))))
    (load r)))

; A RecordDecl → (Ok (Some text)) emitted / (Ok (None)) skip-silently (fwd/anon) /
; (Err reason) refuse-with-note. Unions map to :layout explicit (every field :at 0).
(defn has-any-bitfield [(d Json)] (-> bool)
  (match (jinner d)
    (None [] false)
    (Some [inner]
          (let [(mut i) 0
                n (len (load inner))
                (mut r) false]
            (loop (if (>= (load i) n)
                      (break)
                      (let [f (get (load inner) (load i))]
                        (if (and (= (jkind f) "FieldDecl") (jbool-true? f "isBitfield"))
                            (do (set! r true) (break))
                            (set! i (primitive/iadd (load i) 1))))))
            (load r)))))

; An all-bitfield struct in one storage unit → :layout bits :backing :iN. Refuses
; mixed/multi-unit/differing-width (needs clang record layout)
(defn bitfield-defstruct [(a (dyn Allocator)) (d Json) (ctx (ptr Ctx))] (-> (Result (Option (slice u8)) (slice u8)))
  (let [name (jstr-or (jgets d "name") "")
        (mut out) (sb-new a)
        (mut first) true
        (mut backing) -1
        (mut sum) 0
        (mut err) (None [(slice u8)])]
    (match (jinner d)
      (None [] 0)
      (Some [inner]
            (let [(mut i) 0
                  n (len (load inner))]
              (loop (if (>= (load i) n)
                        (break)
                        (let [f (get (load inner) (load i))]
                          (when (= (jkind f) "FieldDecl")
                            (if (not (jbool-true? f "isBitfield"))
                                (do
                                  (store! err
                                          (Some "mixed bitfield and normal fields (packed layout — Phase 2+ — needs record layout)"))
                                  (break))
                                (match (jgets f "name")
                                  (None []
                                        (do (store! err (Some "an unnamed bitfield (padding — Phase 2+)")) (break)))
                                  (Some [fname]
                                        (let [width (find-value f)]
                                          (if (= width (primitive/cast i64 -9999999999))
                                              (do (store! err (Some "a bitfield with no foldable width")) (break))
                                              (match (jgets (jget f "type") "qualType")
                                                (None [] (do (store! err (Some "a field has no type")) (break)))
                                                (Some [fty]
                                                      (match (map-type a fty ctx)
                                                        (Err [e] (do (store! err (Some e)) (break)))
                                                        (Ok [mt]
                                                            (match (scalar-size-align mt)
                                                              (None []
                                                                    (do
                                                                      (store! err
                                                                              (Some "a bitfield of non-scalar type (Phase 2+)"))
                                                                      (break)))
                                                              (Some [sa]
                                                                    (let [bits (primitive/imul (szal-size sa) 8)]
                                                                      (if (and (>= (load backing)
                                                                                   (primitive/cast i64 0))
                                                                               (!= (load backing) bits))
                                                                          (do
                                                                            (store! err
                                                                                    (Some "bitfields of differing storage widths (Phase 2+ — needs record layout)"))
                                                                            (break))
                                                                          (do
                                                                            (store! backing bits)
                                                                            (store! sum
                                                                                    (primitive/iadd (load sum) width))
                                                                            (if (load first)
                                                                                (do (store! first false) 0)
                                                                                (sb-push-str! (mut out) " "))
                                                                            (sb-push-str! (mut out)
                                                                                          (cat3 a
                                                                                                (cat3 a
                                                                                                      "("
                                                                                                      fname
                                                                                                      " :bits ")
                                                                                                (cat3 a
                                                                                                      (if (and (> (len mt)
                                                                                                                  0)
                                                                                                               (= (get mt
                                                                                                                       0)
                                                                                                                  (primitive/cast u8
                                                                                                                                  105)))
                                                                                                          "i"
                                                                                                          "u")
                                                                                                      (i64->dec a width)
                                                                                                      "")
                                                                                                ")")))))))))))))))))
                          (set! i (primitive/iadd (load i) 1))))))))
    (match (load err)
      (Some [e] (Err e))
      (None []
            (if (< (load backing) (primitive/cast i64 0))
                (Err "empty bitfield struct")
                (if (> (load sum) (load backing))
                    (Err "bitfields span multiple storage units (packed layout — Phase 2+ — needs record layout)")
                    (Ok (Some (cat3 a
                                    (cat3 a
                                          (cat3 a "(defstruct " name " :layout bits :backing :i")
                                          (i64->dec a (load backing))
                                          " [")
                                    (sb-str (load out))
                                    "])\n")))))))))

(defn record-defstruct [(a (dyn Allocator)) (d Json) (ctx (ptr Ctx))] (-> (Result (Option (slice u8)) (slice u8)))
  (let [is-union (= (jstr-or (jgets d "tagUsed") "") "union")]
    (match (jgets d "name")
      (None [] (Ok (None [(slice u8)])))
      (Some [name]
            (if (not (jbool-true? d "completeDefinition"))
                (Ok (None [(slice u8)]))
                (if (has-any-bitfield d)
                    (if is-union
                        (Err "union with a bitfield member (Phase 2+ — needs record layout)")
                        (bitfield-defstruct a d ctx))
                    (let [(mut fields) (sb-new a)
                          (mut first) true
                          (mut max-size) 0
                          (mut max-align) 1
                          (mut err) (None [(slice u8)])]
                      (match (jinner d)
                        (None [] 0)
                        (Some [inner]
                              (let [(mut i) 0
                                    n (len (load inner))]
                                (loop (if (>= (load i) n)
                                          (break)
                                          (let [f (get (load inner) (load i))]
                                            (when (= (jkind f) "FieldDecl")
                                              (if (jbool-true? f "isBitfield")
                                                  (do
                                                    (store! err
                                                            (Some (if is-union
                                                                      "union with a bitfield member (Phase 2+ — needs record layout)"
                                                                      "contains a bitfield (packed layout — Phase 2+ — needs record layout)")))
                                                    (break))
                                                  (match (jgets f "name")
                                                    (None []
                                                          (do
                                                            (store! err
                                                                    (Some "an unnamed field (anon struct/union)"))
                                                            (break)))
                                                    (Some [fname]
                                                          (match (jgets (jget f "type") "qualType")
                                                            (None []
                                                                  (do
                                                                    (store! err (Some "a field has no type"))
                                                                    (break)))
                                                            (Some [fty]
                                                                  (match (map-type a fty ctx)
                                                                    (Err [e] (do (store! err (Some e)) (break)))
                                                                    (Ok [mt]
                                                                        (if is-union
                                                                            (match (scalar-size-align mt)
                                                                              (None []
                                                                                    (do
                                                                                      (store! err
                                                                                              (Some (cat3 a
                                                                                                          (cat3 a
                                                                                                                "union member '"
                                                                                                                fname
                                                                                                                "' has aggregate type '")
                                                                                                          mt
                                                                                                          "' (Phase 2 — needs record layout)")))
                                                                                      (break)))
                                                                              (Some [sa]
                                                                                    (do
                                                                                      (when (> (szal-size sa)
                                                                                               (load max-size))
                                                                                        (store! max-size
                                                                                                (szal-size sa)))
                                                                                      (when (> (szal-align sa)
                                                                                               (load max-align))
                                                                                        (store! max-align
                                                                                                (szal-align sa)))
                                                                                      (if (load first)
                                                                                          (do (store! first false) 0)
                                                                                          (sb-push-str! (mut fields)
                                                                                                        " "))
                                                                                      (sb-push-str! (mut fields)
                                                                                                    (cat3 a
                                                                                                          (cat3 a
                                                                                                                "("
                                                                                                                fname
                                                                                                                " ")
                                                                                                          mt
                                                                                                          " :at 0)")))))
                                                                            (do
                                                                              (if (load first)
                                                                                  (do (store! first false) 0)
                                                                                  (sb-push-str! (mut fields) " "))
                                                                              (sb-push-str! (mut fields)
                                                                                            (cat3 a
                                                                                                  (cat3 a
                                                                                                        "("
                                                                                                        fname
                                                                                                        " ")
                                                                                                  mt
                                                                                                  ")"))))))))))))
                                            (set! i (primitive/iadd (load i) 1))))))))
                      (match (load err)
                        (Some [e] (Err e))
                        (None []
                              (if is-union
                                  (let [algn (load max-align)
                                        size
                                          (primitive/imul (primitive/idiv (primitive/iadd (load max-size)
                                                                                          (primitive/isub algn 1))
                                                                          algn)
                                                          algn)]
                                    (Ok (Some (cat3 a
                                                    (cat3 a
                                                          (cat3 a "(defstruct " name " :layout explicit :size ")
                                                          (i64->dec a size)
                                                          (cat3 a " :align " (i64->dec a algn) " ["))
                                                    (sb-str (load fields))
                                                    "])\n"))))
                                  (Ok (Some (cat3 a (cat3 a "(defstruct " name " [") (sb-str (load fields)) "])\n")))))))))))))

; SzAl is returned by value; read its fields through a stack copy.
(defn szal-size [(sa SzAl)] (-> i64)
  (let [p (primitive/alloc-stack SzAl)] (set! p sa) (.size p)))

(defn szal-align [(sa SzAl)] (-> i64)
  (let [p (primitive/alloc-stack SzAl)] (set! p sa) (.align p)))

(defn enum-consts [(a (dyn Allocator)) (d Json) (seen (ptr (HashMap (slice u8) i64)))] (-> (Result (slice u8)
                                                                                                   (slice u8)))
  (let [(mut out) (sb-new a)
        (mut next) 0
        (mut err) (None [(slice u8)])]
    (match (jinner d)
      (None [] 0)
      (Some [inner]
            (let [(mut i) 0
                  n (len (load inner))]
              (loop (if (>= (load i) n)
                        (break)
                        (let [c (get (load inner) (load i))]
                          (when (= (jkind c) "EnumConstantDecl")
                            (match (jgets c "name")
                              (None [] (do (store! err (Some "an unnamed enumerator")) (break)))
                              (Some [cname]
                                    (let [ev (enumerator-value c)
                                          has-init (has-inner c)]
                                      ; ev == sentinel means "no foldable integer initializer":
                                      ; with an initializer present → refuse; without → running counter.
                                      (if (and (= ev (primitive/cast i64 -9999999999)) has-init)
                                          (do
                                            (store! err
                                                    (Some (cat3 a "enumerator '" cname "' has a non-integer value")))
                                            (break))
                                          (let [value (if (= ev (primitive/cast i64 -9999999999)) (load next) ev)
                                                skey (cat a "const:" cname)]  ; SAME keyspace as the #define pass
                                            (do
                                              (store! next (primitive/iadd value 1))
                                              (match (get (load seen) skey)
                                                (Some [_] 0)
                                                (None []
                                                      (do
                                                        (set! seen skey 1)
                                                        (sb-push-str! (mut out)
                                                                      (cat3 a
                                                                            (cat3 a "(const " cname " ")
                                                                            (i64->dec a value)
                                                                            ")\n"))))))))))))
                          (set! i (primitive/iadd (load i) 1))))))))
    (match (load err) (Some [e] (Err e)) (None [] (Ok (sb-str (load out)))))))

(defn has-inner [(j Json)] (-> bool)
  (match (jinner j) (Some [_] true) (None [] false)))

; The folded integer value of an enumerator initializer; -9999999999 = "none".
(defn enumerator-value [(c Json)] (-> i64)
  (match (jinner c)
    (None [] -9999999999)
    (Some [inner]
          (let [(mut i) 0
                n (len (load inner))
                (mut r) -9999999999]
            (loop (if (>= (load i) n)
                      (break)
                      (let [v (find-value (get (load inner) (load i)))]
                        (if (= v (primitive/cast i64 -9999999999))
                            (set! i (primitive/iadd (load i) 1))
                            (do
                              (set! r v)
                              (break))))))
            (load r)))))

; Recursive: first foldable integer "value" string in a node subtree.
(defn find-value [(node Json)] (-> i64)
  (match (jgets node "value")
    (Some [vs] (let [d (parse-signed vs)] (if (= d (primitive/cast i64 -9999999999)) (find-value-children node) d)))
    (None [] (find-value-children node))))

(defn find-value-children [(node Json)] (-> i64)
  (match (jinner node)
    (None [] -9999999999)
    (Some [inner]
          (let [(mut i) 0
                n (len (load inner))
                (mut r) -9999999999]
            (loop (if (>= (load i) n)
                      (break)
                      (let [v (find-value (get (load inner) (load i)))]
                        (if (= v (primitive/cast i64 -9999999999))
                            (set! i (primitive/iadd (load i) 1))
                            (do
                              (set! r v)
                              (break))))))
            (load r)))))

; Parse an optionally-signed decimal; -9999999999 sentinel on failure.
(defn parse-signed [(s (slice u8))] (-> i64)
  (if (= (len s) (primitive/cast i64 0))
      -9999999999
      (if (= (get s 0) (primitive/cast u8 45))
          (let [d (parse-dec (subslice [u8] s 1 (len s)))]
            (if (< d (primitive/cast i64 0)) -9999999999 (primitive/isub 0 d)))
          (let [d (parse-dec s)] (if (< d (primitive/cast i64 0)) -9999999999 d)))))

; ============================ table collection =============================
(defn collect-types [(a (dyn Allocator)) (top (ArrayList Json)) (ctx (ptr Ctx))] (-> i64)
  (let [(mut i) 0
        n (len top)]
    (loop (if (>= (load i) n)
              (break)
              (let [d (get top (load i))]
                (if (= (jkind d) "TypedefDecl")
                    (match (jgets d "name")
                      (None [] 0)
                      (Some [name]
                            (match (jgets (jget d "type") "qualType")
                              (None [] 0)
                              (Some [under]
                                    (do (set! (load (field ctx typedefs)) name under) 0)))))
                    (when (= (jkind d) "EnumDecl")
                      (match (jgets d "name")
                        (None [] 0)
                        (Some [name]
                              (let [ty
                                      (match (jgets (jget d "fixedUnderlyingType") "qualType")
                                        (None [] "i32")
                                        (Some [q] (try (let [t (try-or! (map-type a q ctx) "i32")] t))))]
                                (do (set! (load (field ctx enums)) name ty) 0))))))
                (set! i (primitive/iadd (load i) 1)))))
    0))

; ============================ #define pass =================================

; Parse a "#define NAME body" line → Some(name,body); None for function-like/malformed.
(defstruct Define [(name (slice u8)) (body (slice u8))])

(defn parse-define [(line (slice u8))] (-> (Option Define))
  (if (not (starts-with line "#define "))
      (None [Define])
      (let [rest (subslice [u8] line 8 (len line))
            n (len rest)
            (mut k) 0]
        (loop (if (>= (load k) n)
                  (break)
                  (let [c (get rest (load k))]
                    (if (or (and (>= c (primitive/cast u8 48)) (<= c (primitive/cast u8 57)))
                            (or (and (>= c (primitive/cast u8 65)) (<= c (primitive/cast u8 90)))
                                (or (and (>= c (primitive/cast u8 97)) (<= c (primitive/cast u8 122)))
                                    (= c (primitive/cast u8 95)))))
                        (set! k (primitive/iadd (load k) 1))
                        (break)))))
        (let [name (subslice [u8] rest 0 (load k))
              after (subslice [u8] rest (load k) n)]
          (if (or (= (load k) (primitive/cast i64 0))
                  (and (> (len after) (primitive/cast i64 0))
                       (= (get after 0) (primitive/cast u8 40))))
              (None [Define])
              (let [d (primitive/alloc-stack Define)]
                (set! (.name d) name)
                (set! (.body d) (trim after))
                (Some (load d))))))))

; Strip a trailing float suffix (f/F/l/L).
(defn strip-float-suffix [(s (slice u8))] (-> (slice u8))
  (let [(mut hi) (len s)]
    (loop (if (<= (load hi) (primitive/cast i64 0))
              (break)
              (let [c (get s (primitive/isub (load hi) 1))]
                (if (or (= c (primitive/cast u8 102))
                        (or (= c (primitive/cast u8 70))
                            (or (= c (primitive/cast u8 108))
                                (= c
                                   (primitive/cast u8 76)))))
                    (set! hi (primitive/isub (load hi) 1))
                    (break)))))
    (subslice [u8] s 0 (load hi))))

; Chars valid in a decimal float literal, at most one '.' — an approximate f64-parse
; validation (real headers only carry clean literals).
(defn float-valid? [(s (slice u8))] (-> bool)
  (let [n (len s)
        (mut i) 0
        (mut dots) 0
        (mut ok) (> n (primitive/cast i64 0))]
    (loop (if (>= (load i) n)
              (break)
              (let [c (get s (load i))]
                (cond (and (>= c (primitive/cast u8 48)) (<= c (primitive/cast u8 57)))
                        (store! i
                                (primitive/iadd (load i) 1))
                      (= c (primitive/cast u8 46))
                        (do
                          (store! dots (primitive/iadd (load dots) 1))
                          (store! i
                                  (primitive/iadd (load i) 1)))
                      (or (= c (primitive/cast u8 101))
                          (or (= c (primitive/cast u8 69))
                              (or (= c (primitive/cast u8 43))
                                  (= c
                                     (primitive/cast u8 45)))))
                        (store! i (primitive/iadd (load i) 1))
                      :else (do (store! ok false) (break))))))
    (and (load ok) (<= (load dots) (primitive/cast i64 1)))))

; A float #define body → its verbatim literal text (suffix stripped, `.0` appended
; if it degenerated to an integer).
(defn float-literal [(a (dyn Allocator)) (b (slice u8))] (-> (Option (slice u8)))
  (let [s (strip-float-suffix b)]
    (if (not (float-valid? s))
        (None [(slice u8)])
        (if (or (has-byte? s (primitive/cast u8 46))
                (or (has-byte? s (primitive/cast u8 101)) (has-byte? s (primitive/cast u8 69))))
            (Some s)
            (Some (cat a s ".0"))))))

; Interpret a #define body as an integer OR float literal → its coil text.
; Strings / identifiers / expressions → None (skip).
(defn c-literal [(a (dyn Allocator)) (body (slice u8))] (-> (Option (slice u8)))
  (let [b (trim body)]
    (if (= (len b) (primitive/cast i64 0))
        (None [(slice u8)])
        (if (float-ish? b)
            (float-literal a b)
            (let [(mut neg) false
                  (mut digits) b]
              (when (= (get b 0) (primitive/cast u8 45))
                (store! neg true)
                (store! digits (trim (subslice [u8] b 1 (len b))))
                0)
              (when (and (> (len (load digits)) (primitive/cast i64 0))
                         (= (get (load digits) 0) (primitive/cast u8 43)))
                (store! digits (subslice [u8] (load digits) 1 (len (load digits))))
                0)
              (let [ds (strip-int-suffix (load digits))
                    mag (parse-int-radix ds)]
                (if (= mag (primitive/cast i64 -9999999999))
                    (None [(slice u8)])
                    (Some (i64->dec a (if (load neg) (primitive/isub 0 mag) mag))))))))))

; A float literal: has '.' or exponent and no 0x prefix (matches the reference test).
(defn float-ish? [(b (slice u8))] (-> bool)
  (if (starts-with b "0x")
      false
      (or (has-byte? b (primitive/cast u8 46))
          (or (has-byte? b (primitive/cast u8 101)) (has-byte? b (primitive/cast u8 69))))))

(defn strip-int-suffix [(s (slice u8))] (-> (slice u8))
  (let [(mut hi) (len s)]
    (loop (if (<= (load hi) (primitive/cast i64 0))
              (break)
              (let [c (get s (primitive/isub (load hi) 1))]
                (if (or (= c (primitive/cast u8 117))
                        (or (= c (primitive/cast u8 85))
                            (or (= c (primitive/cast u8 108))
                                (= c
                                   (primitive/cast u8 76)))))
                    (set! hi (primitive/isub (load hi) 1))
                    (break)))))
    (subslice [u8] s 0 (load hi))))

; Parse decimal / 0x-hex / 0-octal magnitude; -9999999999 on failure.
(defn parse-int-radix [(s (slice u8))] (-> i64)
  (let [n (len s)]
    (cond (= n (primitive/cast i64 0)) -9999999999
          (and (> n (primitive/cast i64 2))
               (and (= (get s 0) (primitive/cast u8 48))
                    (or (= (get s 1) (primitive/cast u8 120))
                        (= (get s 1)
                           (primitive/cast u8 88)))))
            (parse-hex (subslice [u8] s 2 n))
          (and (> n (primitive/cast i64 1)) (= (get s 0) (primitive/cast u8 48))) (parse-oct s)
          :else (let [d (parse-dec s)] (if (< d (primitive/cast i64 0)) -9999999999 d)))))

(defn parse-hex [(s (slice u8))] (-> i64)
  (let [n (len s)
        (mut v) 0
        (mut i) 0
        (mut ok) (> n (primitive/cast i64 0))]
    (loop (if (>= (load i) n)
              (break)
              (let [c (get s (load i))
                    (mut dv) -1]
                (cond (and (>= c (primitive/cast u8 48)) (<= c (primitive/cast u8 57)))
                        (store! dv (primitive/cast i64 (primitive/isub c (primitive/cast u8 48))))
                      (and (>= c (primitive/cast u8 97)) (<= c (primitive/cast u8 102)))
                        (store! dv (primitive/iadd 10 (primitive/cast i64 (primitive/isub c (primitive/cast u8 97)))))
                      (and (>= c (primitive/cast u8 65)) (<= c (primitive/cast u8 70)))
                        (store! dv (primitive/iadd 10 (primitive/cast i64 (primitive/isub c (primitive/cast u8 65)))))
                      :else 0)
                (if (< (load dv) (primitive/cast i64 0))
                    (do (set! ok false) (break))
                    (do
                      (set! v (primitive/iadd (primitive/imul (load v) 16) (load dv)))
                      (set! i (primitive/iadd (load i) 1)))))))
    (if (load ok) (load v) -9999999999)))

(defn parse-oct [(s (slice u8))] (-> i64)
  (let [n (len s)
        (mut v) 0
        (mut i) 0
        (mut ok) (> n (primitive/cast i64 0))]
    (loop (if (>= (load i) n)
              (break)
              (let [c (get s (load i))]
                (if (and (>= c (primitive/cast u8 48)) (<= c (primitive/cast u8 55)))
                    (do
                      (set! v
                            (primitive/iadd (primitive/imul (load v) 8)
                                            (primitive/cast i64 (primitive/isub c (primitive/cast u8 48)))))
                      (set! i (primitive/iadd (load i) 1)))
                    (do (set! ok false) (break))))))
    (if (load ok) (load v) -9999999999)))

; ============================ clang subprocess =============================

; Build a unique temp path "/tmp/coil-cimport-<pid>-<tag>.txt".
(defn tmp-path [(a (dyn Allocator)) (tag (slice u8))] (-> (slice u8))
  (cat3 a (cat3 a "/tmp/coil-cimport-" (i64->dec a (primitive/cast i64 (getpid))) "-") tag ".txt"))

; Remove every scratch file this process made. There are eleven `tmp-path` call
; sites across clang invocations, constant folding and ABI probing, each with
; several failure exits, so unlinking at each one reliably misses paths -- and it
; did: 4,611 of these were left in /tmp. One sweep keyed on our OWN pid is both
; complete and safe, since no other process writes this prefix. The pid is decimal
; digits, so the glob carries no shell metacharacters.
(defn cimport-cleanup! [(a (dyn Allocator))] (-> i64)
  (system (s->cstr a
                   (cat3 a
                         "rm -f /tmp/coil-cimport-"
                         (i64->dec a (primitive/cast i64 (getpid)))
                         "-* 2>/dev/null")))
  0)

; Run a clang command that writes stdout to `outfile`; returns exit status.
(defn run-cmd [(a (dyn Allocator)) (cmd (slice u8))] (-> i32)
  (system (s->cstr a cmd)))

; Add the active Darwin SDK when the caller did not select a sysroot. Command-line
; clang normally discovers this through its driver installation, but headers from
; the Xcode/CLT SDK are not in /usr/include. xcrun is absent on non-Darwin hosts,
; so a failed lookup deliberately leaves the flags unchanged.
(defn clang-flags [(a (dyn Allocator)) (flags (slice u8))] (-> (slice u8))
  (if (or (contains-str? flags "-isysroot") (contains-str? flags "--sysroot"))
      flags
      (let [out (tmp-path a "sdk")
            cmd (cat a "xcrun --sdk macosx --show-sdk-path > '" (cat a out "' 2>/dev/null"))]
        (if (!= (run-cmd a cmd) (primitive/cast i32 0))
            flags
            (let [sdk (trim (slurp a (s->cstr a out)))]
              (if (= (len sdk) (primitive/cast i64 0))
                  flags
                  (cat3 a flags " -isysroot '" (cat a sdk "'"))))))))

; A header name is not itself a clang translation unit: `clang pthread.h`
; addresses a file in the current directory and never performs include search.
; Compile a tiny wrapper so both SDK headers and caller-provided -I headers use
; clang's normal lookup rules.
(defn include-source [(a (dyn Allocator)) (header (slice u8)) (tag (slice u8))] (-> (slice u8))
  (let [src (tmp-path a tag)]
    (write-file a src (cat3 a "#include \"" header "\"\n"))
    src))

; clang JSON AST of `header` → parsed Json (top-level TranslationUnitDecl).
(defn run-clang-ast [(a (dyn Allocator)) (header (slice u8)) (flags (slice u8))] (-> (Result Json (slice u8)))
  (let [out (tmp-path a "ast")
        err (tmp-path a "ast-err")
        cmd
          (cat3 a
                (cat3 a "clang -Xclang -ast-dump=json -fsyntax-only" flags " -x c '")
                (cat3 a header "' > '" out)
                (cat3 a "' 2> '" err "'"))
        rc (run-cmd a cmd)]
    (if (!= rc (primitive/cast i32 0))
        (let [detail (trim (slurp a (s->cstr a err)))]
          (if (= (len detail) (primitive/cast i64 0))
              (Err "clang failed to parse the header")
              (Err (cat a "clang failed to parse the header:\n" detail))))
        (let [txt (slurp a (s->cstr a out))]
          (if (= (len txt) (primitive/cast i64 0))
              (Err "clang produced no AST")
              (Ok (json-parse a txt)))))))

; clang -dM macro dump for `header` (empty header path = the empty-TU baseline).
(defn dump-macros [(a (dyn Allocator)) (header (slice u8)) (tag (slice u8)) (flags (slice u8))] (-> (slice u8))
  (let [out (tmp-path a tag)
        resolved (if (= (len header) (primitive/cast i64 0)) header (abspath a header))
        input (if (= (len header) (primitive/cast i64 0)) header (include-source a resolved "macro-input"))
        src (if (= (len header) (primitive/cast i64 0)) "-" (cat3 a "'" input "'"))
        cmd (cat3 a (cat3 a "clang -dM -E -x c" flags " ") (cat3 a src " > '" out) "' 2>/dev/null")]
    (if (= (len header) (primitive/cast i64 0))
        (run-cmd a (cat3 a (cat3 a "printf '' | clang -dM -E -x c" flags " - > '") out "' 2>/dev/null"))
        (run-cmd a cmd))
    (slurp a (s->cstr a out))))

; ============================ line iteration ===============================
(defn each-line [(a (dyn Allocator)) (text (slice u8))] (-> (ptr (ArrayList (slice u8))))
  (let [lines (box! a (ArrayList (slice u8)) (al-new [(slice u8)] a))
        n (len text)
        (mut start) 0
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (when (= (get text (load i)) (primitive/cast u8 10))
                  (push! [(slice u8)] lines (subslice [u8] text (load start) (load i)))
                  (store! start (primitive/iadd (load i) 1)))
                (set! i (primitive/iadd (load i) 1)))))
    (unless (> (load start) (load i))
      (when (< (load start) n) (push! [(slice u8)] lines (subslice [u8] text (load start) n))))
    lines))

; ============================ driver =======================================
(defn same-file [(file (slice u8)) (header (slice u8))] (-> bool)
  (or (= file header) (= (basename file) (basename header))))

(defn contains-str? [(hay (slice u8)) (needle (slice u8))] (-> bool)
  (match (str-find hay needle) (Some [_] true) (None [] false)))

; A system/SDK/toolchain header (by path) whose decls we DON'T emit — vs the
; target header + the project's own (e.g. -I…) includes, which we DO emit. This
; is what lets a wrapper header (`#include "dispextern.h"` with the build's -I/-D)
; bring the project's structs through, while <stdio.h> etc. stay out.
(defn sys-path? [(f (slice u8))] (-> bool)
  (or (contains-str? f "/usr/")
      (or (contains-str? f ".sdk")
          (or (contains-str? f "/src/stdlib/clang")
              (or (contains-str? f "/Library/Developer")
                  (contains-str? f "/Applications/Xcode"))))))

; Emit a decl from file `f` if it's the target header OR a non-system header.
(defn emit-file? [(f (slice u8)) (header (slice u8))] (-> bool)
  (or (same-file f header) (not (sys-path? f))))

(defn selected-name? [(names (ptr (ArrayList (slice u8))))
                      (selecting bool)
                      (name (slice u8))] (-> bool)
  (if (not selecting)
      true
      (let [(mut i) 0
            n (len (load names))
            (mut found) false]
        (loop (if (or (>= (load i) n) (load found))
                  (break)
                  (do
                    (when (= (get (load names) (load i)) name)
                      (store! found true)
                      0)
                    (set! i (primitive/iadd (load i) 1)))))
        (load found))))

(defn cimport-header-use [(a (dyn Allocator))
                          (header (slice u8))
                          (flags (slice u8))
                          (names (ptr (ArrayList (slice u8))))
                          (selecting bool)] (-> (Result (slice u8) (slice u8)))
  (let [flags (clang-flags a flags)
        input (include-source a (abspath a header) "input")]
    (match (run-clang-ast a input flags)
      (Err [e] (Err e))
      (Ok [ast]
          (let [top (match (jinner ast) (Some [t] t) (None [] (box! a (ArrayList Json) (al-new [Json] a))))
                tdefs (box! a (HashMap (slice u8) (slice u8)) (hm-new [(slice u8) (slice u8)] a (str-keyops)))
                enms (box! a (HashMap (slice u8) (slice u8)) (hm-new [(slice u8) (slice u8)] a (str-keyops)))
                ctx (primitive/alloc-stack Ctx)]
            (set! (.typedefs ctx) tdefs)
            (set! (.enums ctx) enms)
            (collect-types a (load top) ctx)
            (let [(mut structs) (sb-new a)
                  (mut externs) (sb-new a)
                  (mut consts) (sb-new a)
                  (mut skipped) (al-new [(slice u8)] a)
                  seen (box! a (HashMap (slice u8) i64) (hm-new [(slice u8) i64] a (str-keyops)))
                  (mut from-header) false
                  (mut i) 0
                  n (len (load top))]
              (loop (if (>= (load i) n)
                        (break)
                        (let [d (get (load top) (load i))]
                          (match (jgets (jget d "loc") "file")
                            (Some [f] (do (set! from-header (emit-file? f header)) 0))
                            (None [] 0))
                          ; Records from included system headers are ABI dependencies of
                          ; public typedefs (pthread and socket headers rely on this).
                          ; Other declaration kinds remain scoped to the requested or
                          ; project header so cimport does not expose an entire SDK API.
                          (let [k (jkind d)]
                            (unless (or (and (not (load from-header)) (not (= k "RecordDecl")))
                                        (and (or (= k "FunctionDecl")
                                                 (or (= k "RecordDecl") (= k "EnumDecl")))
                                             (not (selected-name? names selecting (jname d)))))
                              (cond (= k "FunctionDecl")
                                      (let [key (cat a "fn:" (jname d))]
                                        (match (get (load seen) key)
                                          (Some [_] 0)
                                          (None []
                                                (do
                                                  (set! seen key 1)
                                                  (match (function-extern a d ctx)
                                                    (Ok [s] (sb-push-str! (mut externs) s))
                                                    (Err [why]
                                                         (push! [(slice u8)]
                                                                (mut skipped)
                                                                (cat3 a "fn " (jname d) (cat a " — " why)))))))))
                                    (= k "RecordDecl")
                                      (match (record-defstruct a d ctx)
                                        (Ok [opt]
                                            (match opt
                                              (Some [s]
                                                    (let [key (cat a "struct:" (jname d))]
                                                      (match (get (load seen) key)
                                                        (Some [_] 0)
                                                        (None []
                                                              (do
                                                                (set! seen key 1)
                                                                (sb-push-str! (mut structs) s))))))
                                              (None [] 0)))
                                        (Err [why]
                                             (let [key (cat a "struct:" (jname d))]
                                               (match (get (load seen) key)
                                                 (Some [_] 0)
                                                 (None []
                                                       (do
                                                         (set! seen key 1)
                                                         (let [opaque (opaque-record-defstruct a header flags d)]
                                                           (if (> (len opaque) (primitive/cast i64 0))
                                                               (sb-push-str! (mut structs) opaque)
                                                               (push! [(slice u8)]
                                                                      (mut skipped)
                                                                      (cat3 a
                                                                            "struct "
                                                                            (jname d)
                                                                            (cat a " — " why)))))))))))
                                    (= k "EnumDecl")
                                      (match (enum-consts a d seen)
                                        (Ok [s] (sb-push-str! (mut consts) s))
                                        (Err [why]
                                             (push! [(slice u8)]
                                                    (mut skipped)
                                                    (cat3 a "enum " (jname d) (cat a " — " why)))))
                                    :else 0)))
                          (set! i (primitive/iadd (load i) 1)))))
              ; #define pass
              (let [baseline (each-line a (dump-macros a "" "base" flags))
                    bset (box! a (HashMap (slice u8) i64) (hm-new [(slice u8) i64] a (str-keyops)))]
                (let [(mut bi) 0
                      bn (len (load baseline))]
                  (loop (if (>= (load bi) bn)
                            (break)
                            (do
                              (match (parse-define (get (load baseline) (load bi)))
                                (Some [d] (do (set! bset (def-name d) 1) 0))
                                (None [] 0))
                              (set! bi (primitive/iadd (load bi) 1))))))
                (let [hlines (each-line a (dump-macros a header "hdr" flags))
                      (mut defs) (al-new [Define] a)]
                  (let [(mut hi) 0
                        hn (len (load hlines))]
                    (loop (if (>= (load hi) hn)
                              (break)
                              (do
                                (match (parse-define (get (load hlines) (load hi)))
                                  (Some [d]
                                        (when (selected-name? names selecting (def-name d))
                                          (match (get (load bset) (def-name d))
                                            (Some [_] 0)
                                            (None []
                                                  (match (c-literal a (def-body d))
                                                    (Some [v] (push! [Define] (mut defs) (mk-define (def-name d) v)))
                                                    (None []
                                                          ; Clang, not a handwritten C evaluator, resolves aliases,
                                                          ; casts and integer expressions from real system headers.
                                                          (let [v
                                                                  (probe-fold-one a
                                                                                  (abspath a header)
                                                                                  flags
                                                                                  (def-name d))]
                                                            (when (!= v (primitive/cast i64 -9999999999))
                                                              (push! [Define]
                                                                     (mut defs)
                                                                     (mk-define (def-name d) (i64->dec a v)))))))))))
                                  (None [] 0))
                                (set! hi (primitive/iadd (load hi) 1))))))
                  (sort-defines (mut defs))
                  (let [(mut di) 0
                        dn (len (load defs))]
                    (loop (if (>= (load di) dn)
                              (break)
                              (let [d (get (load defs) (load di))
                                    key (cat a "const:" (def-name d))]
                                (match (get (load seen) key)
                                  (Some [_] 0)
                                  (None []
                                        (do
                                          (set! seen key 1)
                                          (sb-push-str! (mut consts)
                                                        (cat3 a (cat3 a "(const " (def-name d) " ") (def-body d) ")\n")))))
                                (set! di (primitive/iadd (load di) 1)))))))
                ; assemble output
                (let [(mut body) (sb-new a)]
                  (sb-push-str! (mut body) (cat3 a "; Generated by `coil cimport " header "` — DO NOT EDIT.\n"))
                  (sb-push-str! (mut body)
                                "; A clang-parsed C binding (real header import). Audit before trusting the ABI.\n")
                  (sb-push-str! (mut body) "(module cbindings)\n\n")
                  (let [ns (len (load skipped))]
                    (when (> ns (primitive/cast i64 0))
                      (sb-push-str! (mut body)
                                    "; SKIPPED (unmappable — left out rather than emit a wrong binding):\n")
                      (let [(mut si) 0]
                        (loop (if (>= (load si) ns)
                                  (break)
                                  (do
                                    (sb-push-str! (mut body)
                                                  (cat3 a ";   " (get (load skipped) (load si)) "\n"))
                                    (store! si (primitive/iadd (load si) 1))))))
                      (sb-push-str! (mut body) "\n")))
                  (let [cs (sb-str (load consts))]
                    (do
                      (sb-push-str! (mut body) cs)
                      (when (> (len cs) (primitive/cast i64 0)) (sb-push-str! (mut body) "\n"))))
                  (let [ss (sb-str (load structs))]
                    (do
                      (sb-push-str! (mut body) ss)
                      (when (> (len ss) (primitive/cast i64 0)) (sb-push-str! (mut body) "\n"))))
                  (sb-push-str! (mut body) (sb-str (load externs)))
                  ; surface skips on stderr too (not part of the file)
                  (let [ns (len (load skipped))
                        (mut si) 0]
                    (loop (if (>= (load si) ns)
                              (break)
                              (do
                                (ewrite (cat3 a
                                              "cimport: SKIPPED (unmappable) — "
                                              (get (load skipped) (load si))
                                              "\n"))
                                (set! si (primitive/iadd (load si) 1))))))
                  (Ok (sb-str (load body)))))))))))

(defn cimport-header [(a (dyn Allocator)) (header (slice u8)) (flags (slice u8))] (-> (Result (slice u8) (slice u8)))
  (cimport-header-use a
                      header
                      flags
                      (box! a (ArrayList (slice u8)) (al-new [(slice u8)] a))
                      false))

(defn def-name [(d Define)] (-> (slice u8))
  (let [p (primitive/alloc-stack Define)] (set! p d) (.name p)))

(defn def-body [(d Define)] (-> (slice u8))
  (let [p (primitive/alloc-stack Define)] (set! p d) (.body p)))

(defn mk-define [(name (slice u8)) (body (slice u8))] (-> Define)
  (let [d (primitive/alloc-stack Define)] (set! (.name d) name) (set! (.body d) body) (load d)))

; insertion sort by (name, body), lexicographic's sort+dedup.
(defn sort-defines [(defs (mut (ArrayList Define)))] (-> i64)
  (let [n (len (load defs))
        (mut i) 1]
    (loop (if (>= (load i) n)
              (break)
              (let [(mut j) (load i)]
                (loop (if (<= (load j) (primitive/cast i64 0))
                          (break)
                          (let [aD (get (load defs) (primitive/isub (load j) 1))
                                bD (get (load defs) (load j))]
                            (if (define-lt bD aD)
                                (do
                                  (set! (mut defs) (primitive/isub (load j) 1) bD)
                                  (set! (mut defs) (load j) aD)
                                  (set! j (primitive/isub (load j) 1)))
                                (break)))))
                (set! i (primitive/iadd (load i) 1)))))
    0))

(defn define-lt [(x Define) (y Define)] (-> bool)
  (let [c (str-cmp (def-name x) (def-name y))]
    (if (< c (primitive/cast i64 0))
        true
        (if (> c (primitive/cast i64 0))
            false
            (< (str-cmp (def-body x) (def-body y))
               (primitive/cast i64 0))))))

(defn str-cmp [(x (slice u8)) (y (slice u8))] (-> i64)
  (let [nx (len x)
        ny (len y)
        m (if (< nx ny) nx ny)
        (mut i) 0
        (mut r) 0]
    (loop (if (>= (load i) m)
              (break)
              (let [cx (get x (load i))
                    cy (get y (load i))]
                (if (< cx cy)
                    (do (set! r -1) (break))
                    (if (> cx cy) (do (set! r 1) (break)) (set! i (primitive/iadd (load i) 1)))))))
    (cond (!= (load r) (primitive/cast i64 0)) (load r) (< nx ny) -1 (> nx ny) 1 :else 0)))

; Generate bindings for `header` → write to `out` file (Some) or stdout (None).
; ============================ probe (compute ABI VALUES) ====================
; The toolchain as a value oracle: evaluate C integer expressions / bitfield
; positions with the REAL flags, emit each as a `(const …)`. Tiers, cheapest first:
;   0 = expression: fold via `enum … : long long { n = (long long)(EXPR) }` read
;       from the AST (no link); if it isn't constant, compile+link+run a printf.
;   1 = bitfield:   clang -fdump-record-layouts gives byte:startbit-endbit.
(defstruct Probe [(name (slice u8)) (kind i64) (expr (slice u8)) (sname (slice u8)) (fname (slice u8))])

(defn probe-list-new [(a (dyn Allocator))] (-> (ptr (ArrayList Probe)))
  (box! a (ArrayList Probe) (al-new [Probe] a)))

(defn probe-push! [(a (dyn Allocator))
                   (lst (ptr (ArrayList Probe)))
                   (name (slice u8))
                   (kind i64)
                   (expr (slice u8))
                   (sname (slice u8))
                   (fname (slice u8))] (-> i64)
  (let [p (primitive/alloc-stack Probe)]
    (set! (.name p) name)
    (set! (.kind p) kind)
    (set! (.expr p) expr)
    (set! (.sname p) sname)
    (set! (.fname p) fname)
    (push! [Probe] lst (load p))
    0))

(defn pget [(p Probe) (which i64)] (-> (slice u8))
  (let [q (primitive/alloc-stack Probe)]
    (set! q p)
    (cond (= which (primitive/cast i64 0)) (load (field q name))
          (= which (primitive/cast i64 1)) (load (field q expr))
          (= which (primitive/cast i64 2)) (load (field q sname))
          :else (load (field q fname)))))

(defn pkind [(p Probe)] (-> i64)
  (let [q (primitive/alloc-stack Probe)] (set! q p) (.kind q)))

(defn abspath [(a (dyn Allocator)) (header (slice u8))] (-> (slice u8))
  (let [r (realpath (s->cstr a header) (primitive/cast (ptr i8) 0))]
    (if (= (primitive/cast i64 r) (primitive/cast i64 0)) header (cstr->slice r))))

; put every EnumConstantDecl's folded value into `m` (used for the probe enum).
(defn ee-one [(a (dyn Allocator)) (d Json) (m (ptr (HashMap (slice u8) i64)))] (-> i64)
  (unless (not (= (jkind d) "EnumDecl"))
    (match (jinner d)
      (None [] 0)
      (Some [inner]
            (let [(mut k) 0
                  nk (len (load inner))]
              (loop (if (>= (load k) nk)
                        (break)
                        (do
                          (let [c (get (load inner) (load k))]
                            (when (= (jkind c) "EnumConstantDecl")
                              (let [v (enumerator-value c)]
                                (when (!= v (primitive/cast i64 -9999999999))
                                  (set! m (jname c) v)
                                  0))))
                          (store! k (primitive/iadd (load k) 1)))))
              0)))))

(defn extract-enum-values [(a (dyn Allocator)) (ast Json) (m (ptr (HashMap (slice u8) i64)))] (-> i64)
  (let [top (match (jinner ast) (Some [t] t) (None [] (box! a (ArrayList Json) (al-new [Json] a))))
        (mut i) 0
        n (len (load top))]
    (loop (if (>= (load i) n)
              (break)
              (do
                (ee-one a (get (load top) (load i)) m)
                (set! i (primitive/iadd (load i) 1)))))
    0))

; tier 0a: fold ONE expression via a single-member long-long enum; sentinel if it
; isn't a constant expression (clang errors) → caller falls to tier 0b.
(defn probe-fold-one [(a (dyn Allocator)) (abs (slice u8)) (flags (slice u8)) (expr (slice u8))] (-> i64)
  (let [(mut sb) (sb-new a)]
    (sb-push-str! (mut sb) "#include \"")
    (sb-push-str! (mut sb) abs)
    (sb-push-str! (mut sb) "\"\n")
    (sb-push-str! (mut sb) "enum __coilprobe : long long { __v = (long long)(")
    (sb-push-str! (mut sb) expr)
    (sb-push-str! (mut sb) ") };\n")
    (let [cf (tmp-path a "foldone")]
      (write-file a cf (sb-str (load sb)))
      (try (let [ast (try-or! (run-clang-ast a cf flags) -9999999999)]
             (let [m (box! a (HashMap (slice u8) i64) (hm-new [(slice u8) i64] a (str-keyops)))]
               (extract-enum-values a ast m)
               (match (get (load m) "__v") (Some [x] x) (None [] -9999999999))))))))

; Fold every ordinary constant probe from one header in one clang AST. The old
; path launched clang once per expression, so importing pthread's handful of ABI
; sizes dominated otherwise sub-second builds. If any expression rejects the
; batch, return None and let the existing per-expression fold/runtime fallback
; preserve support for nonconstant probes.
(defn probe-fold-all [(a (dyn Allocator))
                      (abs (slice u8))
                      (flags (slice u8))
                      (probes (ptr (ArrayList Probe)))] (-> (Option (ptr (HashMap (slice u8) i64))))
  (let [(mut sb) (sb-new a)
        n (len (load probes))
        (mut i) 0
        (mut count) 0]
    (sb-push-str! (mut sb) "#include \"")
    (sb-push-str! (mut sb) abs)
    (sb-push-str! (mut sb) "\"\nenum __coilprobes : long long {")
    (loop (if (>= (load i) n)
              (break)
              (do
                (let [p (get (load probes) (load i))]
                  (when (!= (pkind p) (primitive/cast i64 1))
                    (when (> (load count) 0) (sb-push-str! (mut sb) ",") 0)
                    (sb-push-str! (mut sb) "__v")
                    (sb-push-str! (mut sb) (i64->dec a (load i)))
                    (sb-push-str! (mut sb) "=(long long)(")
                    (sb-push-str! (mut sb) (pget p 1))
                    (sb-push-str! (mut sb) ")")
                    (store! count (primitive/iadd (load count) 1))
                    0))
                (set! i (primitive/iadd (load i) 1)))))
    (sb-push-str! (mut sb) "};\n")
    (if (= (load count) 0)
        (None [(ptr (HashMap (slice u8) i64))])
        (let [cf (tmp-path a "foldall")]
          (write-file a cf (sb-str (load sb)))
          (try (let [ast (try-or! (run-clang-ast a cf flags) (None [(ptr (HashMap (slice u8) i64))]))]
                 (let [m (box! a (HashMap (slice u8) i64) (hm-new [(slice u8) i64] a (str-keyops)))]
                   (extract-enum-values a ast m)
                   (Some m))))))))

; If fields cannot be represented safely, retain the C value's ABI storage but
; deliberately expose no fields. This is the caller-owned opaque-value contract
; needed by pthread types and by records containing implementation-only members.
(defn opaque-record-defstruct [(a (dyn Allocator))
                               (header (slice u8))
                               (flags (slice u8))
                               (d Json)] (-> (slice u8))
  (let [name (jname d)
        tag (if (= (jstr-or (jgets d "tagUsed") "struct") "union") "union " "struct ")
        cty (cat a tag name)
        size (probe-fold-one a (abspath a header) flags (cat3 a "sizeof(" cty ")"))
        align (probe-fold-one a (abspath a header) flags (cat3 a "_Alignof(" cty ")"))]
    (if (or (= size (primitive/cast i64 -9999999999))
            (or (= align (primitive/cast i64 -9999999999)) (<= size (primitive/cast i64 0))))
        ""
        (cat3 a
              (cat3 a
                    (cat3 a "(defstruct " name " :layout explicit :size ")
                    (i64->dec a size)
                    (cat3 a " :align " (i64->dec a align) " ["))
              ""
              "])\n"))))

; tier 0b: compile+link+run a printf of the expression (for non-constant values,
; e.g. a global's link-time address). `link` = extra linker args (objects/libs).
(defn probe-run [(a (dyn Allocator)) (abs (slice u8)) (flags (slice u8)) (expr (slice u8)) (link (slice u8))] (-> i64)
  (let [(mut prog) (sb-new a)]
    (sb-push-str! (mut prog) "#include \"")
    (sb-push-str! (mut prog) abs)
    (sb-push-str! (mut prog) "\"\n#include <stdio.h>\n")
    (sb-push-str! (mut prog) "int main(void){printf(\"%lld\\n\",(long long)(")
    (sb-push-str! (mut prog) expr)
    (sb-push-str! (mut prog) "));return 0;}\n")
    (let [cf (tmp-path a "probec")
          exe (tmp-path a "probeexe")
          outf (tmp-path a "probeout")]
      (write-file a cf (sb-str (load prog)))
      (let [(mut cc) (sb-new a)]
        ; -x c applies to the generated source; -x none resets so the linked objects
        ; (link args) are detected by extension, not compiled as C.
        (sb-push-str! (mut cc) "clang")
        (sb-push-str! (mut cc) flags)
        (sb-push-str! (mut cc) " -x c '")
        (sb-push-str! (mut cc) cf)
        (sb-push-str! (mut cc) "' -x none ")
        (sb-push-str! (mut cc) link)
        (sb-push-str! (mut cc) " -o '")
        (sb-push-str! (mut cc) exe)
        (sb-push-str! (mut cc) "' 2>/dev/null")
        (if (!= (run-cmd a (sb-str (load cc))) (primitive/cast i32 0))
            -9999999999
            (let [(mut rc) (sb-new a)]
              (sb-push-str! (mut rc) "'")
              (sb-push-str! (mut rc) exe)
              (sb-push-str! (mut rc) "' > '")
              (sb-push-str! (mut rc) outf)
              (sb-push-str! (mut rc) "' 2>/dev/null")
              (run-cmd a (sb-str (load rc)))
              (parse-signed (trim (slurp a (s->cstr a outf))))))))))

; last whitespace-token of a slice.
(defn last-token [(s (slice u8))] (-> (slice u8))
  (let [t (trim s)
        n (len t)
        (mut cut) 0
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (when (ws-byte? (get t (load i))) (store! cut (primitive/iadd (load i) 1)))
                (set! i (primitive/iadd (load i) 1)))))
    (subslice [u8] t (load cut) n)))

; parse a `-fdump-record-layouts` dump for a bitfield field; emit
; (const NAME_byte B)(const NAME_bit s)(const NAME_width w), or "" if not found.
(defn parse-layout-field [(a (dyn Allocator)) (dump (slice u8)) (name (slice u8)) (fname (slice u8))] (-> (slice u8))
  (let [lines (each-line a dump)
        (mut i) 0
        n (len (load lines))
        (mut out) (sb-new a)
        (mut done) false]
    (loop (if (or (>= (load i) n) (load done))
              (break)
              (do
                (let [line (get (load lines) (load i))
                      bar (index-of line (primitive/cast u8 124) 0)]  ; '|'
                  (when (>= bar (primitive/cast i64 0))
                    (let [left (trim (subslice [u8] line 0 bar))
                          right (subslice [u8] line (primitive/iadd bar 1) (len line))
                          colon (index-of left (primitive/cast u8 58) 0)]  ; ':'
                      (when (and (>= colon (primitive/cast i64 0)) (= (last-token right) fname))
                        (let [byte (subslice [u8] left 0 colon)
                              rest (subslice [u8] left (primitive/iadd colon 1) (len left))
                              dash (index-of rest (primitive/cast u8 45) 0)]  ; '-'
                          (when (>= dash (primitive/cast i64 0))
                            (let [sbit (parse-signed (subslice [u8] rest 0 dash))
                                  ebit (parse-signed (subslice [u8] rest (primitive/iadd dash 1) (len rest)))]
                              (sb-push-str! (mut out) (cat3 a (cat3 a "(const " name "_byte ") (trim byte) ")\n"))
                              (sb-push-str! (mut out)
                                            (cat3 a (cat3 a "(const " name "_bit ") (i64->dec a sbit) ")\n"))
                              (sb-push-str! (mut out)
                                            (cat3 a
                                                  (cat3 a "(const " name "_width ")
                                                  (i64->dec a (primitive/iadd (primitive/isub ebit sbit) 1))
                                                  ")\n"))
                              (store! done true)
                              0)))))))
                (set! i (primitive/iadd (load i) 1)))))
    (sb-str (load out))))

(defn probe-bits [(a (dyn Allocator))
                  (abs (slice u8))
                  (flags (slice u8))
                  (name (slice u8))
                  (sname (slice u8))
                  (fname (slice u8))] (-> (slice u8))
  (let [(mut force) (sb-new a)]
    (sb-push-str! (mut force) "#include \"")
    (sb-push-str! (mut force) abs)
    (sb-push-str! (mut force) "\"\n")
    (sb-push-str! (mut force) sname)
    (sb-push-str! (mut force) " __coil_force;\n")
    (let [cf (tmp-path a "force")
          outf (tmp-path a "layout")]
      (write-file a cf (sb-str (load force)))
      (let [(mut cc) (sb-new a)]
        (sb-push-str! (mut cc) "clang -Xclang -fdump-record-layouts -x c")
        (sb-push-str! (mut cc) flags)
        (sb-push-str! (mut cc) " -c '")
        (sb-push-str! (mut cc) cf)
        (sb-push-str! (mut cc) "' -o /dev/null > '")
        (sb-push-str! (mut cc) outf)
        (sb-push-str! (mut cc) "' 2>&1")
        (run-cmd a (sb-str (load cc)))
        (parse-layout-field a (slurp a (s->cstr a outf)) name fname)))))

; Emit `(const …)` for every probe (routing each to the cheapest tier). "" if none.
(defn cimport-probe [(a (dyn Allocator))
                     (header (slice u8))
                     (flags (slice u8))
                     (probes (ptr (ArrayList Probe)))
                     (link (slice u8))] (-> (slice u8))
  (let [flags (clang-flags a flags)
        n (len (load probes))]
    (if (= n (primitive/cast i64 0))
        ""
        (let [abs (abspath a header)
              folded (probe-fold-all a abs flags probes)
              (mut out) (sb-new a)
              (mut i) 0]
          (loop (if (>= (load i) n)
                    (break)
                    (do
                      (let [p (get (load probes) (load i))]
                        (if (= (pkind p) (primitive/cast i64 1))
                            (sb-push-str! (mut out) (probe-bits a abs flags (pget p 0) (pget p 2) (pget p 3)))
                            (let [nm (pget p 0)
                                  e (pget p 1)
                                  key (cat a "__v" (i64->dec a (load i)))
                                  v0
                                    (match folded
                                      (Some [values]
                                            (match (get (load values) key)
                                              (Some [value] value)
                                              (None [] -9999999999)))
                                      (None [] (probe-fold-one a abs flags e)))
                                  v (if (!= v0 (primitive/cast i64 -9999999999)) v0 (probe-run a abs flags e link))]
                              (if (!= v (primitive/cast i64 -9999999999))
                                  (sb-push-str! (mut out) (cat3 a (cat3 a "(const " nm " ") (i64->dec a v) ")\n"))
                                  (sb-push-str! (mut out)
                                                (cat3 a "; PROBE FAILED (not constant, and no runtime link): " nm "\n"))))))
                      (set! i (primitive/iadd (load i) 1)))))
          (sb-str (load out))))))

(defn cimport-run [(a (dyn Allocator)) (header (slice u8)) (out (Option (slice u8))) (flags (slice u8))] (-> i64)
  (let [r
          (match (cimport-header a header flags)
            (Err [e] (do (ewrite (cat3 a "error: " e "\n")) 1))
            (Ok [body]
                (match out
                  (None [] (do (emit body) 0))
                  (Some [o] (do (write-file a o body) (emit (cat3 a "wrote " o "\n")) 0)))))]
    (cimport-cleanup! a)
    r))

; CLI entry shared by the standalone tool (base=1: `cimport <hdr>`) and the
; compiler subcommand (base=2: `coil cimport <hdr>`). Parses the header at
; argv[base], an optional `-o <out>`, and any other args as clang flags
; (`-I…`, `-D…`, …) forwarded to the clang invocation.
(defn cimport-cli [(a (dyn Allocator)) (argc i32) (argv (ptr (ptr i8))) (base i64)] (-> i64)
  (if (< (primitive/cast i64 argc) (primitive/iadd base 1))
      (do (ewrite "usage: cimport <header.h> [-o out.coil] [clang flags…]\n") 1)
      (let [header (cstr->slice (load (primitive/index argv base)))
            (mut out) (None [(slice u8)])
            (mut flags) (sb-new a)
            (mut i) (primitive/iadd base 1)]
        (loop (if (>= (load i) (primitive/cast i64 argc))
                  (break)
                  (let [arg (cstr->slice (load (primitive/index argv (load i))))]
                    (if (and (< (primitive/iadd (load i) 1) (primitive/cast i64 argc)) (= arg "-o"))
                        (do
                          (set! out (Some (cstr->slice (load (primitive/index argv (primitive/iadd (load i) 1))))))
                          (set! i (primitive/iadd (load i) 2))
                          0)
                        (do
                          (sb-push-str! (mut flags) " ")
                          (sb-push-str! (mut flags) arg)
                          (set! i (primitive/iadd (load i) 1))
                          0)))))
        (cimport-run a header (load out) (sb-str (load flags))))))

; strlen-scan a C string into a slice.
(defn cstr->slice [(p (ptr i8))] (-> (slice u8))
  (let [(mut n) 0]
    (loop (if (= (load (primitive/index p (load n))) (primitive/cast i8 0))
              (break)
              (set! n (primitive/iadd (load n) 1))))
    (slice-new [u8] (primitive/cast (ptr u8) p) (load n))))
