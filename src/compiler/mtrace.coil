(module mtrace)
(import "coil.primitive" :as primitive)
(import "coil.io" :as io)
(import "coil.alloc" :as alloc :use *)
(import "coil.slice" :use *)
(import "coil.str" :use *)

;; ── DEBUGGING METAPROGRAMS ───────────────────────────────────────────────────
;;
;; A metaprogram is ordinary code that runs at compile time, but almost none of
;; the ordinary debugging surface reaches it. You cannot print from it, you
;; cannot step it, and when it goes wrong the error you get is frequently
;; reported against the wrong file entirely.
;;
;; ⚠ WHY `primitive/report` IS NOT A PRINT STATEMENT, which is the trap this
;; module exists to close. `report` COLLECTS a diagnostic into a list that is
;; drained later, and `diag-quiet` suppresses that list during transform rounds
;; (comptime.coil: "the rounds run quiet and the final pass reports"). So a
;; `report` inside a transform produces NO OUTPUT AT ALL — not on success, and
;; not on the failing compile you are trying to debug.
;;
;; That silence is worse than no tool. A debugging session spent eliminating
;; suspects with an instrument that always answers "no" produces a list of
;; confident, wrong conclusions. This module writes STRAIGHT TO STDERR, so what
;; it prints is what happened.
;;
;; ── THE THREE QUESTIONS ──────────────────────────────────────────────────────
;;
;; Debugging a transform means answering, in order:
;;
;;   1. Did my transform even RUN on this form?      COIL_MTRACE=rounds
;;   2. What did it turn the form INTO?              COIL_MTRACE=forms
;;   3. WHICH pass produced the shape that broke?    COIL_MTRACE=diff
;;
;; Question 1 dominates. Most of the time the answer is "no", and every
;; hypothesis that assumed "yes" was wasted. It is also the cheapest to answer,
;; which is why it is the default level.
;;
;; ── LEVELS ───────────────────────────────────────────────────────────────────
;;
;;   COIL_MTRACE=rounds   one line per transform per round: name, round, and
;;                        whether the form list CHANGED. Answers question 1 and
;;                        shows the fixpoint converging (or not).
;;   COIL_MTRACE=forms    the above, plus each module's form count, so a pass
;;                        that drops or duplicates forms is visible.
;;   COIL_MTRACE=diff     the above, plus the actual before/after text of any
;;                        module the round changed. Verbose by design: this is
;;                        the level you use when you know which round is wrong.
;;
;; Levels are cumulative and ordered, so a caller tests `>=`.

(extern getenv :cc c [(ptr i8)] (-> (ptr i8)))
(extern strlen :cc c [(ptr i8)] (-> i64))

;; Local rather than imported: this module is loaded by the expander, and a
;; debugging aid must not add a dependency edge that could itself perturb what
;; it is meant to observe.
(defn mt--cstr [(p (ptr i8))] (-> (slice u8))
  (slice-new [u8] (primitive/cast (ptr u8) p) (strlen p)))

(defn mt--level-off [] (-> i64) 0)
(defn mt--level-rounds [] (-> i64) 1)
(defn mt--level-forms [] (-> i64) 2)
(defn mt--level-diff [] (-> i64) 3)

;; Read `COIL_MTRACE` once per call. Unset, empty or "0" is off; an unrecognized
;; value is treated as `rounds` rather than as off — a typo should give you MORE
;; than you asked for, never silently nothing. Silently-nothing is the failure
;; this module was written to stop.
(defn mtrace-level [] (-> i64)
  (let [v (getenv c"COIL_MTRACE")]
    (if (= (primitive/cast i64 v) 0)
        (mt--level-off)
      (let [s (mt--cstr v)]
        (if (str-eq s "") (mt--level-off)
          (if (str-eq s "0") (mt--level-off)
            (if (str-eq s "off") (mt--level-off)
              (if (str-eq s "diff") (mt--level-diff)
                (if (str-eq s "forms") (mt--level-forms)
                  (mt--level-rounds))))))))))

(defn mtrace-on? [] (-> bool)
  (> (mtrace-level) (mt--level-off)))

;; A transform is about to run. `round` is 0-based; `name` is the registered
;; transform's name, which is what a user grepping this output already knows.
(defn mtrace-enter [(name (slice u8)) (round i64) (nmods i64)] (-> i64)
  (when (mtrace-on?)
    (let [w (io/stderr)]
      (io/print-str w "mtrace  round ")
      (io/print-int w round)
      (io/print-str w "  enter ")
      (io/print-str w name)
      (when (>= (mtrace-level) (mt--level-forms))
        (io/print-str w "  modules=")
        (io/print-int w nmods)
        0)
      (io/write-byte w (primitive/cast u8 10))
      0))
  0)

;; The transform returned. `changed` is the fixpoint question: did the form list
;; differ from what went in? A transform that reports `changed=no` on the round
;; you care about did not touch your code, and every theory that assumed it did
;; is dead — which is exactly the conclusion that is expensive to reach any other
;; way.
(defn mtrace-leave [(name (slice u8)) (round i64) (changed bool)] (-> i64)
  (when (mtrace-on?)
    (let [w (io/stderr)]
      (io/print-str w "mtrace  round ")
      (io/print-int w round)
      (io/print-str w "  leave ")
      (io/print-str w name)
      (io/print-str w "  changed=")
      (io/print-str w (if changed "yes" "no"))
      (io/write-byte w (primitive/cast u8 10))
      0))
  0)

;; A transform raised an error. Printed unconditionally when tracing is on,
;; because this is the moment the user is debugging — and the compiler's own
;; message for it is frequently located against the transform's source rather
;; than against the code that triggered it.
(defn mtrace-error [(name (slice u8)) (round i64)] (-> i64)
  (when (mtrace-on?)
    (let [w (io/stderr)]
      (io/print-str w "mtrace  round ")
      (io/print-int w round)
      (io/print-str w "  ERROR in ")
      (io/print-str w name)
      (io/print-str w "  <- this transform raised; the diagnostic below may be located in ITS source, not yours")
      (io/write-byte w (primitive/cast u8 10))
      0))
  0)

;; ── WHICH METAPROGRAM IS RUNNING RIGHT NOW ───────────────────────────────────
;;
;; A comptime error like
;;
;;     error: comptime: code-nth expects a list/vector
;;      --> yourfile.coil:2:1
;;
;; names neither the metaprogram that raised it nor the form it choked on. The
;; location is the module's `import` line — the point the engine was invoked
;; from — so the message actively misdirects: it looks like your file is wrong
;; when the fault is inside some macro you did not write and cannot see.
;;
;; That single missing word ("which macro?") is the most expensive gap in
;; debugging metaprograms. This cell holds the name of the macro or transform
;; currently executing, so the raise sites can append it.
(defstruct MtCur [(name (slice u8)) (set i64)])
(defn mt--cur [] (-> (ptr MtCur)) (alloc/static MtCur))

(defn mtrace-set-current! [(name (slice u8))] (-> i64)
  (let [c (mt--cur)]
    (store! (field c name) name)
    (store! (field c set) 1)
    0))

(defn mtrace-clear-current! [] (-> i64)
  (store! (field (mt--cur) set) 0) 0)

;; The running metaprogram's name, or "" when none is executing. Callers append
;; it to a diagnostic; "" means the error came from ordinary compilation.
(defn mtrace-current [] (-> (slice u8))
  (let [c (mt--cur)]
    (if (= (load (field c set)) (primitive/cast i64 0)) "" (load (field c name)))))

;; Free-form note from inside the engine, for facts that are not enter/leave —
;; "fixpoint reached", "round limit hit", and so on.
(defn mtrace-note [(msg (slice u8))] (-> i64)
  (when (mtrace-on?)
    (let [w (io/stderr)]
      (io/print-str w "mtrace  ")
      (io/print-str w msg)
      (io/write-byte w (primitive/cast u8 10))
      0))
  0)
