(module mtrace)
(import "coil.primitive" :as primitive)
(import "coil.io" :as io)
(import "coil.alloc" :as alloc :use *)
(import "coil.slice" :use *)
(import "coil.str" :use *)
(import "coil.scratch" :as scratch)

;; ── DEBUGGING METAPROGRAMS ───────────────────────────────────────────────────
;;
;; A metaprogram is ordinary code that runs at compile time, but almost none of
;; the ordinary debugging surface reaches it. You cannot print from it, you
;; cannot step it, and when it goes wrong the error you get is frequently
;; reported against the wrong file entirely.
;;
;; ⚠ WHY `primitive/report` IS NOT A PRINT STATEMENT, which is the trap this
;; module exists to close. `report` COLLECTS a diagnostic into a list that is
;; drained later, and `diag-quiet` suppresses that list during transform rounds
;; (comptime.coil: "the rounds run quiet and the final pass reports"). So a
;; `report` inside a transform produces NO OUTPUT AT ALL — not on success, and
;; not on the failing compile you are trying to debug.
;;
;; That silence is worse than no tool. A debugging session spent eliminating
;; suspects with an instrument that always answers "no" produces a list of
;; confident, wrong conclusions. This module writes STRAIGHT TO STDERR, so what
;; it prints is what happened.
;;
;; ── THE THREE QUESTIONS ──────────────────────────────────────────────────────
;;
;; Debugging a transform means answering, in order:
;;
;;   1. Did my transform even RUN on this form?      COIL_MTRACE=rounds
;;   2. How many forms did it receive?               COIL_MTRACE=forms
;;   3. WHICH pass produced the shape that broke?    COIL_MTRACE=diff
;;
;; Question 1 dominates. Most of the time the answer is "no", and every
;; hypothesis that assumed "yes" was wasted. It is also the cheapest to answer,
;; which is why it is the default level.
;;
;; ── LEVELS ───────────────────────────────────────────────────────────────────
;;
;;   COIL_MTRACE=rounds   one line per transform per round: name, round, and
;;                        whether the form list CHANGED. Answers question 1 and
;;                        shows the fixpoint converging (or not).
;;   COIL_MTRACE=forms    the above, plus the total input form count, so a pass
;;                        that drops or duplicates forms is visible.
;;   COIL_MTRACE=diff     the above, plus the actual before/after text of any
;;                        module the round changed. Verbose by design: this is
;;                        the level you use when you know which round is wrong.
;;
;; Levels are cumulative and ordered, so a caller tests `>=`.
;; Large traces can be narrowed with exact-match filters:
;;
;;   COIL_MTRACE_TRANSFORM=coil.scheme.dialect
;;   COIL_MTRACE_MODULE=chez.runtime.records

(extern getenv :cc c [(ptr i8)] (-> (ptr i8)))
(extern strlen :cc c [(ptr i8)] (-> i64))

;; Local rather than imported: this module is loaded by the expander, and a
;; debugging aid must not add a dependency edge that could itself perturb what
;; it is meant to observe.
(defn mt--cstr [(p (ptr i8))] (-> (slice u8))
  (slice-new [u8] (primitive/cast (ptr u8) p) (strlen p)))

(defn mt--level-off [] (-> i64) 0)
(defn mt--level-rounds [] (-> i64) 1)
(defn mt--level-forms [] (-> i64) 2)
(defn mt--level-diff [] (-> i64) 3)

;; Read `COIL_MTRACE` once per call. Unset, empty or "0" is off; an unrecognized
;; value is treated as `rounds` rather than as off — a typo should give you MORE
;; than you asked for, never silently nothing. Silently-nothing is the failure
;; this module was written to stop.
(defn mtrace-level [] (-> i64)
  (let [v (getenv c"COIL_MTRACE")]
    (if (= (primitive/cast i64 v) 0)
        (mt--level-off)
      (let [s (mt--cstr v)]
        (if (str-eq s "") (mt--level-off)
          (if (str-eq s "0") (mt--level-off)
            (if (str-eq s "off") (mt--level-off)
              (if (str-eq s "diff") (mt--level-diff)
                (if (str-eq s "forms") (mt--level-forms)
                  (mt--level-rounds))))))))))

(defn mtrace-on? [] (-> bool)
  (> (mtrace-level) (mt--level-off)))

(defn mtrace-diff? [] (-> bool)
  (>= (mtrace-level) (mt--level-diff)))

;; Memory tracing is deliberately separate from transform tracing. It samples
;; allocator state without enabling verbose expansion output or changing the
;; program being compiled.
(defn memory-trace-on? [] (-> bool)
  (let [v (getenv c"COIL_MEMORY_TRACE")]
    (and (!= (primitive/cast i64 v) 0)
         (let [s (mt--cstr v)] (and (!= s "") (!= s "0"))))))

(defn memory-trace-reset! [(phase (slice u8))] (-> i64)
  (when (memory-trace-on?)
    (store! (field (scratch/scratch-global) peak-live-reserved)
            (scratch/scratch-global-live-reserved))
    (store! (field (alloc/malloc-stats) peak) (alloc/malloc-live-bytes))
    (let [w (io/stderr)]
      (io/print-str w "memory  event=begin  phase=")
      (io/print-str w phase)
      (io/print-str w "  scratch-live=")
      (io/print-int w (scratch/scratch-global-live-reserved))
      (io/print-str w "  malloc-live=")
      (io/print-int w (alloc/malloc-live-bytes))
      (io/write-byte w (primitive/cast u8 10))
      0))
  0)

(defn memory-trace-snapshot [(phase (slice u8))] (-> i64)
  (when (memory-trace-on?)
    (let [w (io/stderr)]
      (io/print-str w "memory  event=snapshot  phase=")
      (io/print-str w phase)
      (io/print-str w "  scratch-live=")
      (io/print-int w (scratch/scratch-global-live-reserved))
      (io/print-str w "  scratch-peak=")
      (io/print-int w (scratch/scratch-global-peak-live-reserved))
      (io/print-str w "  malloc-live=")
      (io/print-int w (alloc/malloc-live-bytes))
      (io/print-str w "  malloc-peak=")
      (io/print-int w (alloc/malloc-peak-bytes))
      (io/write-byte w (primitive/cast u8 10))
      0))
  0)

;; Definition-time macro towers can legitimately take several recovery rounds,
;; but an application-sized stage that walks toward the 64-round cap otherwise
;; looks like a silent frontend hang. Keep this summary independent of transform
;; filtering: it describes the isolated stage compiler, not a registered pass.
(defn mtrace-stage-round [(round i64) (forms i64) (event (slice u8)) (hit i64)] (-> i64)
  (when (mtrace-on?)
    (let [w (io/stderr)]
      (io/print-str w "mtrace  phase=stage-definition  round=")
      (io/print-int w round)
      (io/print-str w "  forms=")
      (io/print-int w forms)
      (io/print-str w "  event=")
      (io/print-str w event)
      (io/print-str w "  arena-live=")
      (io/print-int w (scratch/scratch-global-live-reserved))
      (io/print-str w "  arena-peak=")
      (io/print-int w (scratch/scratch-global-peak-live-reserved))
      (when (>= hit 0)
        (io/print-str w "  recovered=")
        (io/print-int w hit)
        0)
      (io/write-byte w (primitive/cast u8 10))
      0))
  0)

;; Close a compiler scratch lifetime and, when tracing is enabled, explain both
;; what that lifetime allocated and what closing it actually returned. Keeping
;; close+measurement together prevents misleading "freed" messages that merely
;; sampled an arena before the release happened.
(defn mtrace-close-arena! [(label (slice u8)) (arena (ptr scratch/ScratchArena))] (-> i64)
  (let [before (scratch/scratch-global-live-reserved)
        allocations (scratch/scratch-alloc-count arena)
        bytes (scratch/scratch-alloc-bytes arena)
        segments (scratch/scratch-segment-count arena)
        peak (scratch/scratch-peak-reserved-bytes arena)
        _closed (scratch/scratch-close! arena)
        after (scratch/scratch-global-live-reserved)]
    (when (mtrace-on?)
      (let [w (io/stderr)]
        (io/print-str w "mtrace  phase=arena-release  owner=")
        (io/print-str w label)
        (io/print-str w "  allocations=")
        (io/print-int w allocations)
        (io/print-str w "  bytes=")
        (io/print-int w bytes)
        (io/print-str w "  segments=")
        (io/print-int w segments)
        (io/print-str w "  peak-reserved=")
        (io/print-int w peak)
        (io/print-str w "  released=")
        (io/print-int w (primitive/isub before after))
        (io/print-str w "  global-live=")
        (io/print-int w after)
        (io/write-byte w (primitive/cast u8 10))
        0))
    0))


(defn mtrace-stage-recover [(name (slice u8)) (source i64) (lo i64) (hi i64)] (-> i64)
  (when (mtrace-on?)
    (let [w (io/stderr)]
      (io/print-str w "mtrace  phase=stage-definition  recover=")
      (io/print-str w name)
      (io/print-str w "  source=")
      (io/print-int w source)
      (io/print-str w "  span=")
      (io/print-int w lo)
      (io/write-byte w (primitive/cast u8 58))
      (io/print-int w hi)
      (io/write-byte w (primitive/cast u8 10))
      0))
  0)

(defn mtrace-stage-failure [(name (slice u8)) (source i64) (lo i64) (hi i64)] (-> i64)
  (when (mtrace-on?)
    (let [w (io/stderr)]
      (io/print-str w "mtrace  phase=stage-definition  failure=")
      (io/print-str w name)
      (io/print-str w "  source=")
      (io/print-int w source)
      (io/print-str w "  span=")
      (io/print-int w lo)
      (io/write-byte w (primitive/cast u8 58))
      (io/print-int w hi)
      (io/write-byte w (primitive/cast u8 10))
      0))
  0)

;; Optional exact filters keep `diff` useful on application-sized programs.
;; An unset/empty filter accepts everything. The transform filter is matched
;; against the registered qualified name; the module filter against the loader's
;; module name. These are environment controls because mtrace is also needed
;; while debugging compiler bootstraps where adding a new CLI flag is circular.
(defn mt--filter-matches? [(key (ptr i8)) (candidate (slice u8))] (-> bool)
  (let [p (getenv key)]
    (if (= (primitive/cast i64 p) 0) true
      (let [wanted (mt--cstr p)]
        (or (str-eq wanted "") (str-eq wanted candidate))))))

(defn mtrace-transform? [(name (slice u8))] (-> bool)
  (mt--filter-matches? c"COIL_MTRACE_TRANSFORM" name))

(defn mtrace-module? [(name (slice u8))] (-> bool)
  (mt--filter-matches? c"COIL_MTRACE_MODULE" name))

;; A transform is about to run. `round` is 0-based; `name` is the registered
;; transform's name, which is what a user grepping this output already knows.
(defn mtrace-enter [(phase (slice u8)) (name (slice u8))
                    (round i64) (index i64) (nforms i64)] (-> i64)
  (when (and (mtrace-on?) (mtrace-transform? name))
    (let [w (io/stderr)]
      (io/print-str w "mtrace  phase=")
      (io/print-str w phase)
      (io/print-str w "  round=")
      (io/print-int w round)
      (io/print-str w "  transform=")
      (io/print-int w index)
      (io/print-str w "  enter=")
      (io/print-str w name)
      (when (>= (mtrace-level) (mt--level-forms))
        (io/print-str w "  forms=")
        (io/print-int w nforms)
        0)
      (io/write-byte w (primitive/cast u8 10))
      0))
  0)

;; The transform returned. `changed` is the fixpoint question: did the form list
;; differ from what went in? A transform that reports `changed=no` on the round
;; you care about did not touch your code, and every theory that assumed it did
;; is dead — which is exactly the conclusion that is expensive to reach any other
;; way.
(defn mtrace-leave [(phase (slice u8)) (name (slice u8))
                    (round i64) (index i64) (changed bool)] (-> i64)
  (when (and (mtrace-on?) (mtrace-transform? name))
    (let [w (io/stderr)]
      (io/print-str w "mtrace  phase=")
      (io/print-str w phase)
      (io/print-str w "  round=")
      (io/print-int w round)
      (io/print-str w "  transform=")
      (io/print-int w index)
      (io/print-str w "  leave=")
      (io/print-str w name)
      (io/print-str w "  changed=")
      (io/print-str w (if changed "yes" "no"))
      (io/print-str w "  scratch-live=")
      (io/print-int w (scratch/scratch-global-live-reserved))
      (io/print-str w "  malloc-live=")
      (io/print-int w (alloc/malloc-live-bytes))
      (io/write-byte w (primitive/cast u8 10))
      0))
  0)

;; A transform raised an error. Printed unconditionally when tracing is on,
;; because this is the moment the user is debugging — and the compiler's own
;; message for it is frequently located against the transform's source rather
;; than against the code that triggered it.
(defn mtrace-error [(phase (slice u8)) (name (slice u8))
                    (round i64) (index i64)] (-> i64)
  (when (and (mtrace-on?) (mtrace-transform? name))
    (let [w (io/stderr)]
      (io/print-str w "mtrace  phase=")
      (io/print-str w phase)
      (io/print-str w "  round=")
      (io/print-int w round)
      (io/print-str w "  transform=")
      (io/print-int w index)
      (io/print-str w "  ERROR=")
      (io/print-str w name)
      (io/print-str w "  <- this transform raised; the diagnostic below may be located in ITS source, not yours")
      (io/write-byte w (primitive/cast u8 10))
      0))
  0)

;; ── WHICH METAPROGRAM IS RUNNING RIGHT NOW ───────────────────────────────────
;;
;; A comptime error like
;;
;;     error: comptime: code-nth expects a list/vector
;;      --> yourfile.coil:2:1
;;
;; names neither the metaprogram that raised it nor the form it choked on. The
;; location is the module's `import` line — the point the engine was invoked
;; from — so the message actively misdirects: it looks like your file is wrong
;; when the fault is inside some macro you did not write and cannot see.
;;
;; That single missing word ("which macro?") is the most expensive gap in
;; debugging metaprograms. This cell holds the name of the macro or transform
;; currently executing, so the raise sites can append it.
(defstruct MtCur [(name (slice u8)) (set i64)])
(defn mt--cur [] (-> (ptr MtCur)) (alloc/static MtCur))

(defn mtrace-set-current! [(name (slice u8))] (-> i64)
  (let [c (mt--cur)]
    (store! (field c name) name)
    (store! (field c set) 1)
    0))

(defn mtrace-clear-current! [] (-> i64)
  (store! (field (mt--cur) set) 0) 0)

;; The running metaprogram's name, or "" when none is executing. Callers append
;; it to a diagnostic; "" means the error came from ordinary compilation.
(defn mtrace-current [] (-> (slice u8))
  (let [c (mt--cur)]
    (if (= (load (field c set)) (primitive/cast i64 0)) "" (load (field c name)))))

;; Resolve is also used speculatively while a source dialect is still raw. A
;; parser trace from that probe would report every foreign-language form as an
;; error. The expander brackets only the authoritative post-transform reparse.
(defn mt--boundary-cell [] (-> (ptr i64)) (alloc/static i64))
(defn mtrace-boundary-begin! [] (-> i64)
  (store! (mt--boundary-cell) 1) 0)
(defn mtrace-boundary-end! [] (-> i64)
  (store! (mt--boundary-cell) 0) 0)
(defn mtrace-boundary-active? [] (-> bool)
  (!= (load (mt--boundary-cell)) (primitive/cast i64 0)))

;; Free-form note from inside the engine, for facts that are not enter/leave —
;; "fixpoint reached", "round limit hit", and so on.
(defn mtrace-note [(msg (slice u8))] (-> i64)
  (when (mtrace-on?)
    (let [w (io/stderr)]
      (io/print-str w "mtrace  ")
      (io/print-str w msg)
      (io/write-byte w (primitive/cast u8 10))
      0))
  0)
