;;; The typed C boundary to LLVM's resource-tracked object linker.
(module coil.compiler.orc)
(import "coil.primitive" :as p)
(import "coil.cc" :as cc)

(defstruct SymbolFlags [(generic u8) (target u8)])

(defstruct EvaluatedSymbol [(address i64) (flags SymbolFlags)])

(defstruct SymbolPair [(name (ptr i8)) (symbol EvaluatedSymbol)])

(defstruct SearchOrder [(dylib (ptr i8)) (flags i32)])

(defstruct LookupSymbol [(name (ptr i8)) (flags i32)])

(extern LLVMOrcCreateLLJIT :cc (cc/C) [(ptr (ptr i8)) (ptr i8)] (-> (ptr i8)))

(extern LLVMOrcDisposeLLJIT :cc (cc/C) [(ptr i8)] (-> (ptr i8)))

(extern LLVMOrcLLJITGetExecutionSession :cc (cc/C) [(ptr i8)] (-> (ptr i8)))

(extern LLVMOrcLLJITGetGlobalPrefix :cc (cc/C) [(ptr i8)] (-> i8))

(extern LLVMOrcLLJITGetDataLayoutStr :cc (cc/C) [(ptr i8)] (-> (ptr i8)))

(extern LLVMOrcLLJITMangleAndIntern
        :cc
        (cc/C)
        [(ptr i8) (ptr i8)]
        (-> (ptr i8)))

(extern LLVMOrcExecutionSessionCreateBareJITDylib
        :cc
        (cc/C)
        [(ptr i8) (ptr i8)]
        (-> (ptr i8)))

(extern LLVMOrcJITDylibCreateResourceTracker
        :cc
        (cc/C)
        [(ptr i8)]
        (-> (ptr i8)))

(extern LLVMOrcReleaseResourceTracker :cc (cc/C) [(ptr i8)] (-> void))

(extern LLVMOrcResourceTrackerRemove :cc (cc/C) [(ptr i8)] (-> (ptr i8)))

(extern LLVMOrcJITDylibClear :cc (cc/C) [(ptr i8)] (-> (ptr i8)))

(extern LLVMOrcJITDylibDefine :cc (cc/C) [(ptr i8) (ptr i8)] (-> (ptr i8)))

(extern LLVMOrcAbsoluteSymbols :cc (cc/C) [(ptr SymbolPair) i64] (-> (ptr i8)))

(extern LLVMOrcDisposeMaterializationUnit :cc (cc/C) [(ptr i8)] (-> void))

(extern LLVMOrcCreateDynamicLibrarySearchGeneratorForProcess
        :cc
        (cc/C)
        [(ptr (ptr i8)) i8 (ptr i8) (ptr i8)]
        (-> (ptr i8)))

(extern LLVMOrcJITDylibAddGenerator :cc (cc/C) [(ptr i8) (ptr i8)] (-> void))

(extern LLVMOrcLLJITAddObjectFileWithRT
        :cc
        (cc/C)
        [(ptr i8) (ptr i8) (ptr i8)]
        (-> (ptr i8)))

(extern LLVMOrcExecutionSessionLookup
        :cc
        (cc/C)
        [(ptr i8)
         i32
         (ptr SearchOrder)
         i64
         (ptr LookupSymbol)
         i64
         (fnptr (cc/C) [(ptr i8) (ptr SymbolPair) i64 (ptr i8)] void)
         (ptr i8)]
        (-> void))

(extern LLVMTargetMachineEmitToMemoryBuffer
        :cc
        (cc/C)
        [(ptr i8) (ptr i8) i32 (ptr (ptr i8)) (ptr (ptr i8))]
        (-> i32))
