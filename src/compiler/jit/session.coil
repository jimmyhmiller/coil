;;; A live compiler session: revisions and the REPL's native generations. It knows nothing about a terminal.
(module coil.compiler.session)
(import "coil.compiler.large_pages" :as large-pages)
(import "coil.primitive" :as primitive)
(import "coil.compiler.unit_state" :use *)
(import "coil.alloc" :as alloc :use *)
(import "coil.result" :use *)
(import "coil.slice" :use *)
(import "coil.str" :as str :use * :exclude [parse-int])
(import "coil.arraylist" :use *)
(import "coil.avec" :use [AVec avec-at avec-edit avec-new avec-to-list])
(import "coil.amap" :use [AMap amap-new])
(import "coil.hashmap" :use *)
(import "coil.pmap" :use *)
(import "coil.io" :use *)
(import "coil.os" :as os)
(import "coil.mem" :as mem)
(import "coil.control" :use *)
(import "coil.try" :use *)
(import "coil.scratch" :as scratch)
(import "coil.memory" :as memory)
(import "coil.compiler.env" :use *)
(import "coil.compiler.ffi" :use *)
(import "coil.compiler.guide" :use *)
(import "coil.reader" :use *)
