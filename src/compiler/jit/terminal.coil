; The terminal uses the same retained compiler revisions as the public JIT API.
; Each submission compiles new forms against accepted metadata and native symbols.
; Expression printing wraps the already checked expression; it does not replay
; accepted source or expand the expression again. Diagnostics retain input spans.
(defn repl-head? [(s (slice u8)) (h (slice u8))] (-> bool)
  (starts-with s h))

;;; The head symbol of a submitted form: the text after its `(` up to the first
;;; delimiter, or "" when the form is not a list.
(defn repl-form-head [(s (slice u8))] (-> (slice u8))
  (if (or (= (len s) 0) (!= (get s 0) (: 40 u8)))
      ""
      (let [(mut i) 1]
        (while (and (< (load i) (len s))
                    (let [c (get s (load i))]
                      (not (or (= c (: 32 u8))
                               (= c (: 9 u8))
                               (= c (: 10 u8))
                               (= c (: 13 u8))
                               (= c (: 40 u8))
                               (= c (: 41 u8))
                               (= c (: 91 u8))
                               (= c (: 93 u8))
                               (= c (: 34 u8))))))
          (set! i (+ (load i) 1)))
        (subslice s 1 (load i)))))

;;; A submission that defines something (or opens a module) rather than an
;;; expression to evaluate. It is compiled into the session, and the REPLs answer
;;; it with `; ok`. Every REPL front end asks this one question.
(defn repl-is-def? [(s (slice u8))] (-> bool)
  (let [h (repl-form-head s)]
    (or (= h "defn")
        (= h "def")
        (= h "defmacro")
        (= h "derive")
        (toplevel-only-head? h))))

; read one line from fd 0 (byte at a time); None at EOF with no data.
(defn repl-read-line [(a (dyn Allocator)) (buf (ptr i8))]
  (-> (Option (slice u8)))
  (let [(mut out) (StrBuf::new a)
        (mut got) false]
    (loop (let [n (match (read-some (stdin) buf 1) (Ok [k] k) (Err [_] -1))]
            (if (<= n 0)
                (break)
                (do
                  (set! got true)
                  (if (= (load buf) (: 10 i8))
                      (break)
                      (push! (mut out) (primitive/cast u8 (load buf))))))))
    (if (load got) (Some (str (load out))) (None [(slice u8)]))))

; Read one complete Coil form. The shared balance scanner ignores delimiters in
; strings/comments and understands reader syntax, so multiline input follows the
; language rather than a second, approximate parenthesis counter.
(defn repl-read-form [(a (dyn Allocator)) (buf (ptr i8))]
  (-> (Option (slice u8)))
  (match (repl-read-line a buf)
    (None [] (None [(slice u8)]))
    (Some [first]
          (let [(mut text) (StrBuf::new a)]
            (push-str! (mut text) first)
            (loop (if (bal/fully-balanced? a (str (load text)))
                      (break)
                      (do
                        (ps (stdout) "....> ")
                        (match (repl-read-line a buf)
                          (None [] (break))
                          (Some [line]
                                (if (= (m-trim line) ":cancel")
                                    (do (set! text (StrBuf::new a)) (break))
                                    (do
                                      (push! (mut text)
                                             (: 10 u8))
                                      (push-str! (mut text) line)
                                      0)))))))
            (Some (str (load text)))))))

(defn repl-help-text [] (-> (slice u8))
  "commands:\n  :help, :h       this message\n  :type EXPR      check the expression without running it\n  :load MODULE    import a namespace\n  :compile FORMS  compile arbitrary top-level forms\n  :defs           list current definitions\n  :memory         what holds the process's memory, and what the compiler state owns\n  :reset          release the retained environment\n  :cancel         abandon multiline input\n  :quit, :q       exit\nRuntime functions use Var: compatible redefinitions update existing callers. Types, macros, generic functions, and defn* definitions remain static.\n(module NAME) selects a namespace; it does not move existing definitions.\n")

; Shared terminal UI for compiler entrypoints. Backend-specific modules construct
; the session first, so an LLVM-free entrypoint never has to import the public
; coil.jit module (whose Linux implementation deliberately imports LLVM).
(defn repl-terminal-main [(a (dyn Allocator)) (session (ptr i8))] (-> i64)
  (let [project (repl-session-load-project! session)
        initialized
          (cond (or (= project 0) (= project -2)) (repl-terminal-start! session)
                ; the manifest's error is already reported
                (= project -3) 1
                :else project)]
    (if (!= initialized 0)
        initialized
        (let [buf
                (primitive/cast (ptr i8)
                                (data (match (alloc-bytes a 4 1)
                                        (Some [s] s)
                                        (None []
                                              (do
                                                (oom-at c"compiler allocation"
                                                        4)
                                                (slice::new (primitive/cast (ptr u8)
                                                                            0)
                                                            0))))))
              out (stdout)
              (mut reads) (zeroed scratch/ScratchArena)]
          (print-str out
                     "coil repl — evaluate an expr (printed by type), or (defn …)/(def …) to define. :help, Ctrl-D to exit.\n")
          ; Each input is read into memory of its own, released before the next:
          ; A lives as long as the process, and a session reads without end.
          (scratch/ScratchArena::init (mut reads)
                                      (large-pages/compiler-scratch-for "repl.reads"))
          (loop (print-str out "coil> ")
            (reset! (mut reads))
            (match (repl-read-form (allocator (mut reads)) buf)
              (None [] (break))
              (Some [line]
                    (let [form (trim line)]
                      (cond (or (= form ":quit") (= form ":q")) (break)
                            (or (= form ":help") (= form ":h"))
                              (do (print-str out (repl-help-text)) 0)
                            :else
                              (let [rc (repl-terminal-form! session form)]
                                (when (and (= rc 0) (repl-is-def? form))
                                  (print-str out "; ok\n")
                                  0)
                                rc))))))
          (close! (mut reads))
          (write-byte out (: 10 u8))
          0))))

(defn repl-terminal-start! [(raw (ptr i8))] (-> i64)
  (repl-session-compile! raw
                         "(module replsession) (import \"coil.primitive\" :as primitive) (import \"coil.fmt\") (import \"coil.io\") (import \"coil.repl\")"
                         "0"))

(defn repl-terminal-evaluate! [(raw (ptr i8))
                               (expression (slice u8))
                               (type-only bool)] (-> i64)
  ; the wrapped text and the printed type live only for this input: the
  ; candidate copies its source (`compiler-revision-check`)
  (let [session (repl-session raw)
        (mut arena) (zeroed scratch/ScratchArena)
        _init
          (scratch/ScratchArena::init-with-capacity (mut arena)
                                                    (large-pages/compiler-scratch-parent)
                                                    4096)
        a (allocator (mut arena))]
    (set! (.terminal-expression session) expression)
    (set! (.terminal-mode session) (if type-only 2 1))
    ; A printed expression is marked with `(coil.repl/show)`, whose transform
    ; prints a value of a type with neither Debug nor Display from its structure.
    ; The marker stands beside the expression, which keeps its statement position.
    (let [status
            (repl-session-prepare! raw
                                   ""
                                   (sconcat3 a
                                             (if type-only
                                                 "(do "
                                                 "(do (coil.repl/show) ")
                                             expression
                                             " 0)"))
          result
            (do
              (set! (.terminal-mode session) 0)
              (set! (.terminal-expression session) "")
              (if (!= status 0)
                  status
                  (if type-only
                      (let [revision (.compiler-candidate session)
                            tp (field revision result-type)]
                        (ps (stdout) (ty-str a tp))
                        (wb (stdout) 10)
                        (repl-session-abort-prepared! raw))
                      (repl-session-commit-prepared! raw))))]
      (close! (mut arena))
      result)))

;;; The account tree (who holds the process's memory) and, by field, what the
;;; current compiler state owns.
(defn repl-session-print-memory! [(raw (ptr i8))] (-> i64)
  (let [session (repl-session raw)
        (mut work) (zeroed scratch/ScratchArena)]
    (scratch/ScratchArena::init (mut work) (malloc-allocator))
    (let [a (scratch/ScratchArena::allocator (mut work))]
      (ps (stdout) (memory/account-report a))
      (unless (= (primitive/cast i64 (.env session)) 0)
        (ps (stdout) "compiler state, by field:\n")
        (ps (stdout) (env-footprint a (.env session) 3))
        0))
    (scratch/ScratchArena::close! (mut work))
    0))

;;; `:load NAMESPACE`: import it into the session. The import's text lives only
;;; for this input: the candidate copies its source.
(defn repl-terminal-load! [(raw (ptr i8)) (namespace (slice u8))] (-> i64)
  (let [(mut arena) (zeroed scratch/ScratchArena)
        _init
          (scratch/ScratchArena::init-with-capacity (mut arena)
                                                    (large-pages/compiler-scratch-parent)
                                                    4096)
        status
          (repl-session-compile! raw
                                 (sconcat3 (allocator (mut arena))
                                           "(import \""
                                           namespace
                                           "\" :use *)")
                                 "(coil.repl/publish)")]
    (close! (mut arena))
    status))

(defn repl-terminal-form! [(raw (ptr i8)) (input (slice u8))] (-> i64)
  (let [session (repl-session raw)
        a (.a session)
        form (m-trim input)]
    (cond (= form "") 0
          (= form ":defs") (repl-session-print-definitions! raw)
          (= form ":memory") (repl-session-print-memory! raw)
          (= form ":reset")
            (let [status (repl-session-reset! raw)]
              (if (!= status 0) status (repl-terminal-start! raw)))
          (repl-head? form ":type ")
            (repl-terminal-evaluate! raw
                                     (m-trim (subslice form 6 (len form)))
                                     true)
          (repl-head? form ":compile ")
            (repl-session-compile! raw
                                   (m-trim (subslice form 9 (len form)))
                                   "(coil.repl/publish)")
          (repl-head? form ":load ")
            (repl-terminal-load! raw (m-trim (subslice form 6 (len form))))
          (repl-head? form ":")
            (repl-fail! session
                        form
                        "error: unknown JIT session command\n")
          (repl-is-def? form)
            (repl-session-compile! raw form "(coil.repl/publish)")
          :else (repl-terminal-evaluate! raw form false))))

;;; List current declarations directly from the accepted environment. A session
;;; never retains a journal of submitted source for display or recompilation.
;;; Whether NAME is declared in one of MODULES, the modules a session's
;;; submissions were entered in.
(defn repl-entry-module-name? [(name (slice u8))
                               (modules (ptr (ArrayList (slice u8))))] (-> bool)
  (block :found
    (for [i 0 (len (load modules))]
      (when (= (before-last-dot name) (get (load modules) i))
        (break :found true)))
    false))

(defn repl-session-print-definitions! [(raw (ptr i8))] (-> i64)
  (let [w (stdout)
        base (compiler-revision-base (repl-session raw))]
    (unless (= (primitive/cast i64 base) 0)
      (let [layer (field (field base env) app)
            p (field layer checked)
            modules (field (field base env) entry_modules)]
        (for [i 0 (len (load (.funcs p)))]
          (let [f (elem (.funcs p) i)]
            (when (repl-entry-module-name? (.name f) modules)
              (ps w (.name f))
              (wb w 10)
              0)))
        (for [i 0 (len (load (.consts p)))]
          (let [name (.name (elem (.consts p) i))]
            (when (repl-entry-module-name? name modules)
              (ps w name)
              (wb w 10)
              0))))
      0))
  0)
