; src/compiler/float_math.coil — the scalar floating-point math intrinsics the
; non-LLVM backends lower from `primitive/llvm-ir`.
;
; `coil.math` is written over LLVM's scalar math intrinsics (`@llvm.sin.f32`,
; `@llvm.floor.f64`, …), so the LLVM backend sees the operation itself and can
; fold, vectorize and select one instruction for it. The arm64, x64 and bytecode
; backends interpret the same `llvm-ir` text; this table is what they agree on:
; which intrinsics exist, how many operands each takes, and the libm function
; that computes it when a backend has no instruction for it.
(module coil.compiler.float_math)
(import "coil.str" :use *)
(import "coil.slice" :use *)

;;; What a scalar float intrinsic computes. Every operation but `FloatMinimum`
;;; and `FloatMaximum` has a libm function with the same meaning; those two
;;; (NaN-propagating, -0 < +0) have none and each backend implements them.
(defsum FloatMathOp
  (FloatSqrt) (FloatAbs) (FloatFloor) (FloatCeil) (FloatTrunc)
  (FloatRound) (FloatRoundEven) (FloatFma) (FloatMinimum) (FloatMaximum)
  (FloatCopysign)
  (FloatSin) (FloatCos) (FloatTan) (FloatAsin) (FloatAcos) (FloatAtan) (FloatAtan2)
  (FloatSinh) (FloatCosh) (FloatTanh)
  (FloatExp) (FloatExp2) (FloatLog) (FloatLog2) (FloatLog10) (FloatPow))

;;; One recognized intrinsic call: its operation, its lane width in bits (32 or
;;; 64), its operand count, and the libm symbol (unprefixed; empty for
;;; `FloatMinimum`/`FloatMaximum`).
(defstruct FloatIntrinsic
  [(op FloatMathOp) (bits i64) (arity i64) (libm (slice u8))])

(defn fm-entry [(op FloatMathOp) (bits i64) (arity i64)
                (double (slice u8)) (single (slice u8))] (-> (Option FloatIntrinsic))
  (Some (FloatIntrinsic :op op :bits bits :arity arity
                        :libm (if (= bits 32) single double))))

(defn fm-lookup [(name (slice u8)) (bits i64)] (-> (Option FloatIntrinsic))
  (cond
    (= name "sqrt") (fm-entry (FloatSqrt) bits 1 "sqrt" "sqrtf")
    (= name "fabs") (fm-entry (FloatAbs) bits 1 "fabs" "fabsf")
    (= name "floor") (fm-entry (FloatFloor) bits 1 "floor" "floorf")
    (= name "ceil") (fm-entry (FloatCeil) bits 1 "ceil" "ceilf")
    (= name "trunc") (fm-entry (FloatTrunc) bits 1 "trunc" "truncf")
    (= name "round") (fm-entry (FloatRound) bits 1 "round" "roundf")
    ; C23 roundeven is missing from macOS libm; nearbyint in the default
    ; (to-nearest, ties-to-even) rounding mode is the same function and is C99.
    (= name "roundeven") (fm-entry (FloatRoundEven) bits 1 "nearbyint" "nearbyintf")
    (= name "fma") (fm-entry (FloatFma) bits 3 "fma" "fmaf")
    (= name "minimum") (fm-entry (FloatMinimum) bits 2 "" "")
    (= name "maximum") (fm-entry (FloatMaximum) bits 2 "" "")
    (= name "copysign") (fm-entry (FloatCopysign) bits 2 "copysign" "copysignf")
    (= name "sin") (fm-entry (FloatSin) bits 1 "sin" "sinf")
    (= name "cos") (fm-entry (FloatCos) bits 1 "cos" "cosf")
    (= name "tan") (fm-entry (FloatTan) bits 1 "tan" "tanf")
    (= name "asin") (fm-entry (FloatAsin) bits 1 "asin" "asinf")
    (= name "acos") (fm-entry (FloatAcos) bits 1 "acos" "acosf")
    (= name "atan") (fm-entry (FloatAtan) bits 1 "atan" "atanf")
    (= name "atan2") (fm-entry (FloatAtan2) bits 2 "atan2" "atan2f")
    (= name "sinh") (fm-entry (FloatSinh) bits 1 "sinh" "sinhf")
    (= name "cosh") (fm-entry (FloatCosh) bits 1 "cosh" "coshf")
    (= name "tanh") (fm-entry (FloatTanh) bits 1 "tanh" "tanhf")
    (= name "exp") (fm-entry (FloatExp) bits 1 "exp" "expf")
    (= name "exp2") (fm-entry (FloatExp2) bits 1 "exp2" "exp2f")
    (= name "log") (fm-entry (FloatLog) bits 1 "log" "logf")
    (= name "log2") (fm-entry (FloatLog2) bits 1 "log2" "log2f")
    (= name "log10") (fm-entry (FloatLog10) bits 1 "log10" "log10f")
    (= name "pow") (fm-entry (FloatPow) bits 2 "pow" "powf")
    :else (None [FloatIntrinsic])))

;;; Recognize a scalar float intrinsic callee such as `@llvm.sin.f32` or
;;; `@llvm.fma.f64`. Vector forms (`.v4f32`) and every other callee are `None`.
(defn float-intrinsic [(callee (slice u8))] (-> (Option FloatIntrinsic))
  (let [n (len callee)]
    (if (or (not (starts-with callee "@llvm.")) (< n 11))
        (None [FloatIntrinsic])
        (let [suffix (substr callee (- n 4) n)
              name (substr callee 6 (- n 4))]
          (cond
            (= suffix ".f32") (fm-lookup name 32)
            (= suffix ".f64") (fm-lookup name 64)
            :else (None [FloatIntrinsic]))))))

;;; The `f32` bit pattern of an `f64` literal (the checker keeps every float
;;; literal as f64 bits): round to nearest, then reinterpret. Backends write it
;;; when an `f32` static is initialized from a literal.
(defn f64-bits->f32-bits [(bits i64)] (-> i64)
  (let [(mut wide) bits
        (mut narrow) (cast f32 (load (cast (ptr f64) (mut wide))))]
    (cast i64 (load (cast (ptr u32) (mut narrow))))))
