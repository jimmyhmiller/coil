;;; Persistent names of accepted submission-only functions and nominal types.
(module coil.compiler.lifetime_base)
(import "coil.primitive" :as p)
(import "coil.alloc" :use *)
(import "coil.arraylist" :use *)
(import "coil.hashmap" :use *)
(import "coil.slice" :use [slice-new])
(import "coil.str" :use [str-keyops-borrowed])
(import "coil.scratch" :as scratch)
(import "coil.pmap" :use *)
(import "coil.compiler.sem_base" :as sem)

(defstruct LifetimeBase
  [(refs i64) (a (dyn Allocator))
   (functions (PMap (slice u8) sem/SemHold))
   (types (PMap (slice u8) sem/SemHold))])

(defn lifetime-no-base [] (-> (ptr LifetimeBase))
  (p/cast (ptr LifetimeBase) 0))

(defn lifetime-base-new [(a (dyn Allocator))] (-> (ptr LifetimeBase))
  (let [base (box! a LifetimeBase (p/zeroed LifetimeBase))]
    (set! (.refs base) 1)
    (set! (.a base) a)
    (set! (.functions base)
      (pm-new [(slice u8) sem/SemHold] (sem/sem-lease a) (str-keyops-borrowed)))
    (set! (.types base)
      (pm-new [(slice u8) sem/SemHold] (sem/sem-lease a) (str-keyops-borrowed)))
    base))

(defn lifetime-base-derive [(a (dyn Allocator)) (parent (ptr LifetimeBase))]
  (-> (ptr LifetimeBase))
  (if (= parent (lifetime-no-base))
    (lifetime-base-new a)
    (let [base (box! a LifetimeBase (p/zeroed LifetimeBase))]
      (set! (.refs base) 1)
      (set! (.a base) a)
      (set! (.functions base)
        (pm-clone-at [(PMap (slice u8) sem/SemHold)] (field parent functions)))
      (set! (.types base)
        (pm-clone-at [(PMap (slice u8) sem/SemHold)] (field parent types)))
      base)))

(defn lifetime-base-release! [(base (ptr LifetimeBase))] (-> i64)
  (unless (= base (lifetime-no-base))
    (let [remaining (- (.refs base) 1)]
      (set! (.refs base) remaining)
      (when (= remaining 0)
        (let [functions (take! [(PMap (slice u8) sem/SemHold)] (field base functions))
              types (take! [(PMap (slice u8) sem/SemHold)] (field base types))] 0)
        (free [LifetimeBase] (.a base) (slice-new base 1)) 0)) 0)
  0)

(defn lifetime-base-put! [(base (ptr LifetimeBase)) (owner (ptr sem/SemOwner))
                          (type? bool) (name (slice u8))] (-> i64)
  (let [present? (if type? (pm-contains? (field base types) name)
                            (pm-contains? (field base functions) name))]
    (if present? 0
      (let [arena (scratch/scratch-allocator (field owner arena))
            stored (sem/sem-own-bytes arena name)
            hold (sem/sem-owner-hold owner)]
        (if type?
          (pm-assoc! (mut (.types base)) stored hold)
          (pm-assoc! (mut (.functions base)) stored hold))))))

(defn lifetime-base-remove! [(base (ptr LifetimeBase)) (type? bool)
                             (name (slice u8))] (-> i64)
  (if (= base (lifetime-no-base)) 0
    (if type? (pm-dissoc! (mut (.types base)) name)
              (pm-dissoc! (mut (.functions base)) name))))

(defn lifetime-base-contains? [(base (ptr LifetimeBase)) (type? bool)
                               (name (slice u8))] (-> bool)
  (and (!= base (lifetime-no-base))
    (if type? (pm-contains? (field base types) name)
              (pm-contains? (field base functions) name))))

(defn lifetime-base-names! [(base (ptr LifetimeBase)) (type? bool)
                            (out (mut (HashMap (slice u8) i64)))] (-> i64)
  (unless (= base (lifetime-no-base))
    (if type?
      (let [(mut it) (pm-iter (field base types))]
        (loop (match (next (mut it))
          (None [] (break))
          (Some [entry] (set! (mut out) (.key entry) 0)))))
      (let [(mut it) (pm-iter (field base functions))]
        (loop (match (next (mut it))
          (None [] (break))
          (Some [entry] (set! (mut out) (.key entry) 0))))))
    0)
  0)

(defn lifetime-base-empty? [(base (ptr LifetimeBase))] (-> bool)
  (or (= base (lifetime-no-base))
      (and (pm-empty? (field base functions)) (pm-empty? (field base types)))))

(defn lifetime-base-count [(base (ptr LifetimeBase)) (type? bool)] (-> i64)
  (if (= base (lifetime-no-base)) 0
    (if type? (pm-len (field base types)) (pm-len (field base functions)))))

(defn lifetime-base-same? [(left (ptr LifetimeBase))
                           (right (ptr LifetimeBase))] (-> bool)
  (block :same
    (when (= left right) (return-from :same true))
    (when (or (= left (lifetime-no-base)) (= right (lifetime-no-base)))
      (return-from :same false))
    (when (or (!= (pm-len (field left functions)) (pm-len (field right functions)))
              (!= (pm-len (field left types)) (pm-len (field right types))))
      (return-from :same false))
    (unless (pm-same? (field left functions) (field right functions))
      (let [(mut it) (pm-iter (field left functions))]
        (loop (match (next (mut it))
          (None [] (break))
          (Some [entry]
            (unless (pm-contains? (field right functions) (.key entry))
              (return-from :same false)))))))
    (unless (pm-same? (field left types) (field right types))
      (let [(mut it) (pm-iter (field left types))]
        (loop (match (next (mut it))
          (None [] (break))
          (Some [entry]
            (unless (pm-contains? (field right types) (.key entry))
              (return-from :same false)))))))
    true))

(defn lifetime-base-difference-count [(left (ptr LifetimeBase))
                                      (right (ptr LifetimeBase))] (-> i64)
  (if (or (= left (lifetime-no-base)) (= right (lifetime-no-base))) -1
    (let [(mut count) 0 (mut fit) (pm-iter (field left functions))
          (mut tit) (pm-iter (field left types))]
      (loop (match (next (mut fit))
        (None [] (break))
        (Some [entry]
          (unless (pm-contains? (field right functions) (.key entry))
            (set! count (+ (load count) 1))))))
      (loop (match (next (mut tit))
        (None [] (break))
        (Some [entry]
          (unless (pm-contains? (field right types) (.key entry))
            (set! count (+ (load count) 1))))))
      (load count))))

(defn lifetime-base-added-names! [(current (ptr LifetimeBase))
                                  (prior (ptr LifetimeBase))
                                  (type? bool)
                                  (out (mut (HashMap (slice u8) i64)))] (-> i64)
  (unless (= current (lifetime-no-base))
    (if type?
      (let [(mut it) (pm-iter (field current types))]
        (loop (match (next (mut it))
          (None [] (break))
          (Some [entry]
            (unless (lifetime-base-contains? prior true (.key entry))
              (set! (mut out) (.key entry) 0))))))
      (let [(mut it) (pm-iter (field current functions))]
        (loop (match (next (mut it))
          (None [] (break))
          (Some [entry]
            (unless (lifetime-base-contains? prior false (.key entry))
              (set! (mut out) (.key entry) 0)))))))
    0)
  0)
