; src/compiler/normalize.coil — self-host Coil compiler, normalize module.
(module normalize)
(import "coil.primitive" :as primitive)

(import "coil.alloc" :as alloc :use *)
(import "coil.result" :use *)
(import "coil.slice" :use *)
(import "coil.str" :use *)
(import "coil.arraylist" :use *)
(import "coil.io" :use *)
(import "coil.control" :use *)
(import "coil.try" :use *)
(import "ffi" :use *)
(import "coil.reader" :use *)
(import "ast" :use *)
(import "astdump" :use *)
(import "codegen" :use *)
(import "loader" :use *)
(import "parser" :use *)
(import "resolve" :use *)

(defstruct NumRes [(val i64) (len i64)])
(defstruct ScanRes [(fam i64) (num i64) (endd i64)])
(defstruct NzBlock [(cat i64) (name (slice u8)) (body (ArrayList (slice u8)))])
(defstruct NzParsed [(header (ArrayList (slice u8))) (blocks (ArrayList NzBlock))])
(defstruct Renum [(g (ArrayList i64)) (st (ArrayList i64)) (cs (ArrayList i64)) (lv (ArrayList i64))])
(defstruct AttrDef [(old i64) (body (slice u8))])

(defn nz-b [(s (slice u8)) (i i64)] (-> i64)
  (primitive/cast i64 (slice-get s i)))
(defn nz-digit? [(c i64)] (-> bool)
  (and (>= c (primitive/cast i64 48)) (<= c (primitive/cast i64 57))))
(defn nz-alnum? [(c i64)] (-> bool)
  (or (and (>= c (primitive/cast i64 48)) (<= c (primitive/cast i64 57)))
      (or (and (>= c (primitive/cast i64 65)) (<= c (primitive/cast i64 90)))
          (and (>= c (primitive/cast i64 97)) (<= c (primitive/cast i64 122))))))
(defn nz-ident? [(c i64)] (-> bool)
  (or (nz-alnum? c) (= c (primitive/cast i64 95))))
(defn nz-sym? [(c i64)] (-> bool)
  (or (nz-alnum? c)
      (or (= c (primitive/cast i64 95))
          (or (= c (primitive/cast i64 46))
              (or (= c (primitive/cast i64 36))
                  (= c
                     (primitive/cast i64
                                     45)))))))

(defn nz-contains? [(hay (slice u8)) (needle (slice u8))] (-> bool)
  (match (str-find hay needle) (Some [_] true) (None [] false)))

(defn nz-find-i64 [(l (ArrayList i64)) (x i64)] (-> i64)
  (let [n (al-len [i64] l)
        (mut i) 0
        (mut res) -1]
    (loop (if (or (>= (load i) n) (>= (load res) (primitive/cast i64 0)))
              (break)
              (if (= (al-get [i64] l (load i)) x)
                  (store! res (load i))
                  (store! i
                          (primitive/iadd (load i) 1)))))
    (load res)))

(defn nz-all-digits? [(s (slice u8))] (-> bool)
  (let [n (slice-len s)
        (mut i) 0
        (mut ok) true]
    (loop (if (or (>= (load i) n) (not (load ok)))
              (break)
              (if (nz-digit? (nz-b s (load i)))
                  (do (store! i (primitive/iadd (load i) 1)) 0)
                  (do
                    (store! ok
                            false)
                    0))))
    (and (> n (primitive/cast i64 0)) (load ok))))

(defn nz-leading-number [(s (slice u8)) (start i64)] (-> NumRes)
  (let [n (slice-len s)
        (mut j) start
        (mut v) 0]
    (loop (if (or (>= (load j) n) (not (nz-digit? (nz-b s (load j)))))
              (break)
              (do
                (store! v (primitive/iadd (primitive/imul (load v) 10) (primitive/isub (nz-b s (load j)) 48)))
                (store! j (primitive/iadd (load j) 1)))))
    (let [r (alloc/stack NumRes)]
      (store! (field r val) (load v))
      (store! (field r len) (primitive/isub (load j) start))
      (load r))))

(defn nz-parse-int [(s (slice u8))] (-> i64)
  (let [r (alloc/stack NumRes)] (store! r (nz-leading-number s 0)) (load (field r val))))

(defn nz-split-lines [(a (ptr Allocator)) (text (slice u8))] (-> (ArrayList (slice u8)))
  (let [(mut out) (al-new [(slice u8)] a)
        n (slice-len text)
        (mut start) 0
        (mut i) 0]
    (loop (cond (> (load i) n) (break)
                (= (load i) n)
                  (do (al-push! (mut out) (subslice text (load start) (load i))) (store! i (primitive/iadd (load i) 1)))
                (= (nz-b text (load i)) (primitive/cast i64 10))
                  (do
                    (al-push! (mut out) (subslice text (load start) (load i)))
                    (store! start (primitive/iadd (load i) 1))
                    (store! i (primitive/iadd (load i) 1)))
                :else (store! i (primitive/iadd (load i) 1))))
    (load out)))

(defn nz-first-token [(l (slice u8))] (-> (slice u8))
  (match (str-find l " ") (Some [i] (subslice l 0 i)) (None [] l)))

(defn nz-at-symbol [(l (slice u8))] (-> (slice u8))
  (match (str-find l "@")
    (None [] l)
    (Some [at]
          (let [n (slice-len l)
                (mut j) (primitive/iadd at 1)]
            (if (and (< (load j) n) (= (nz-b l (load j)) (primitive/cast i64 34)))
                (do
                  (store! j (primitive/iadd (load j) 1))
                  (loop (if (or (>= (load j) n) (= (nz-b l (load j)) (primitive/cast i64 34)))
                            (break)
                            (store! j (primitive/iadd (load j) 1))))
                  (when (< (load j) n) (store! j (primitive/iadd (load j) 1)))
                  (subslice l at (load j)))
                (do
                  (loop (if (or (>= (load j) n) (not (nz-sym? (nz-b l (load j)))))
                            (break)
                            (store! j (primitive/iadd (load j) 1))))
                  (subslice l at (load j))))))))

(defn nz-pos-define-name? [(name (slice u8))] (-> bool)
  (let [pre "@__coil_llvm_ir_"
        pl (slice-len pre)]
    (if (or (not (starts-with name pre)) (<= (slice-len name) pl))
        false
        (nz-all-digits? (subslice name pl (slice-len name))))))

; ---- scan_positional -------------------------------------------------------
(defn nz-mk-scan [(fam i64) (num i64) (endd i64)] (-> ScanRes)
  (let [s (alloc/stack ScanRes)]
    (store! (field s fam) fam)
    (store! (field s num) num)
    (store! (field s endd) endd)
    (load s)))

(defn nz-try-fam [(s (slice u8)) (i i64) (pre (slice u8)) (fam i64)] (-> (Option ScanRes))
  (let [n (slice-len s)
        pl (slice-len pre)
        ps (primitive/iadd i 1)]
    (if (or (> (primitive/iadd ps pl) n) (not (= (subslice s ps (primitive/iadd ps pl)) pre)))
        (None [ScanRes])
        (let [nr (alloc/stack NumRes)]
          (store! nr (nz-leading-number s (primitive/iadd ps pl)))
          (if (= (load (field nr len)) (primitive/cast i64 0))
              (None [ScanRes])
              (let [endd (primitive/iadd (primitive/iadd ps pl) (load (field nr len)))]
                (if (or (>= endd n) (not (nz-ident? (nz-b s endd))))
                    (Some (nz-mk-scan fam (load (field nr val)) endd))
                    (None [ScanRes]))))))))

(defn nz-scan-positional [(s (slice u8)) (i i64)] (-> (Option ScanRes))
  (if (or (>= i (slice-len s)) (!= (nz-b s i) (primitive/cast i64 64)))
      (None [ScanRes])
      (match (nz-try-fam s i "g." 0)
        (Some [r] (Some r))
        (None []
              (match (nz-try-fam s i "str." 1)
                (Some [r] (Some r))
                (None []
                      (match (nz-try-fam s i "cstr." 2)
                        (Some [r] (Some r))
                        (None [] (nz-try-fam s i "__coil_llvm_ir_" 3)))))))))

; ---- renumber map (4 first-encounter lists) --------------------------------
(defn nz-renum-assign! [(r (ptr Renum)) (fam i64) (old i64)] (-> i64)
  (cond (= fam (primitive/cast i64 0))
          (when (< (nz-find-i64 (load (field r g)) old) (primitive/cast i64 0))
            (al-push! (mut (field r
                                  g))
                      old))
        (= fam (primitive/cast i64 1))
          (when (< (nz-find-i64 (load (field r st)) old) (primitive/cast i64 0))
            (al-push! (mut (field r
                                  st))
                      old))
        (= fam (primitive/cast i64 2))
          (when (< (nz-find-i64 (load (field r cs)) old) (primitive/cast i64 0))
            (al-push! (mut (field r
                                  cs))
                      old))
        (< (nz-find-i64 (load (field r lv)) old) (primitive/cast i64 0)) (al-push! (mut (field r lv)) old)
        :else 0))

(defn nz-renum-lookup [(r (ptr Renum)) (fam i64) (old i64)] (-> i64)
  (cond (= fam (primitive/cast i64 0)) (nz-find-i64 (load (field r g)) old)
        (= fam (primitive/cast i64 1)) (nz-find-i64 (load (field r st)) old)
        (= fam (primitive/cast i64 2)) (nz-find-i64 (load (field r cs)) old)
        :else (nz-find-i64 (load (field r lv)) old)))

(defn nz-assign-line! [(r (ptr Renum)) (line (slice u8))] (-> i64)
  (let [n (slice-len line)
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (if (= (nz-b line (load i)) (primitive/cast i64 64))
                  (match (nz-scan-positional line (load i))
                    (Some [sr]
                          (let [s (alloc/stack ScanRes)]
                            (store! s sr)
                            (nz-renum-assign! r (load (field s fam)) (load (field s num)))
                            (store! i (load (field s endd)))))
                    (None [] (store! i (primitive/iadd (load i) 1))))
                  (store! i (primitive/iadd (load i) 1)))))
    0))

(defn nz-name-of [(blocks (ArrayList NzBlock)) (idx i64)] (-> (slice u8))
  (let [b (alloc/stack NzBlock)] (store! b (al-get [NzBlock] blocks idx)) (load (field b name))))

(defn nz-pnum [(blocks (ArrayList NzBlock)) (idx i64) (r (ptr Renum))] (-> i64)
  (let [name (nz-name-of blocks idx)
        nr (alloc/stack NumRes)]
    (store! nr (nz-leading-number name (slice-len "@__coil_llvm_ir_")))
    (let [pos (nz-find-i64 (load (field r lv)) (load (field nr val)))]
      (if (< pos (primitive/cast i64 0)) 9223372036854775807 pos))))

(defn nz-assign-block-bodies [(r (ptr Renum)) (blocks (ArrayList NzBlock)) (idx i64)] (-> i64)
  (let [b (alloc/stack NzBlock)]
    (store! b (al-get [NzBlock] blocks idx))
    (let [body (load (field b body))
          n (al-len [(slice u8)] body)
          (mut i) 0]
      (loop (if (>= (load i) n)
                (break)
                (do (nz-assign-line! r (al-get [(slice u8)] body (load i))) (store! i (primitive/iadd (load i) 1))))))
    0))

(defn nz-assign-idxs [(r (ptr Renum)) (blocks (ArrayList NzBlock)) (idxs (ArrayList i64))] (-> i64)
  (let [n (al-len [i64] idxs)
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do (nz-assign-block-bodies r blocks (al-get [i64] idxs (load i))) (store! i (primitive/iadd (load i) 1)))))
    0))

(defn nz-sort-idx-by-name [(a (ptr Allocator)) (blocks (ArrayList NzBlock)) (idxs (ArrayList i64))] (-> (ArrayList i64))
  (let [n (al-len [i64] idxs)
        (mut used) (al-new [bool] a)
        (mut out) (al-new [i64] a)
        (mut k) 0]
    (loop (if (>= (load k) n)
              (break)
              (do
                (al-push! (mut used) false)
                (store! k
                        (primitive/iadd (load k) 1)))))
    (let [(mut c) 0]
      (loop (if (>= (load c) n)
                (break)
                (do
                  (let [(mut best) -1
                        (mut bi) 0]
                    (loop (if (>= (load bi) n)
                              (break)
                              (do
                                (when (and (not (al-get [bool] (load used) (load bi)))
                                           (or (< (load best) (primitive/cast i64 0))
                                               (str-lt (nz-name-of blocks (al-get [i64] idxs (load bi)))
                                                       (nz-name-of blocks (al-get [i64] idxs (load best))))))
                                  (store! best (load bi)))
                                (store! bi (primitive/iadd (load bi) 1)))))
                    (al-set! [bool] (mut used) (load best) true)
                    (al-push! (mut out) (al-get [i64] idxs (load best))))
                  (store! c (primitive/iadd (load c) 1))))))
    (load out)))

(defn nz-sort-idx-by-pnum [(a (ptr Allocator)) (blocks (ArrayList NzBlock)) (idxs (ArrayList i64)) (r (ptr Renum))] (-> (ArrayList i64))
  (let [n (al-len [i64] idxs)
        (mut used) (al-new [bool] a)
        (mut out) (al-new [i64] a)
        (mut k) 0]
    (loop (if (>= (load k) n)
              (break)
              (do
                (al-push! (mut used) false)
                (store! k
                        (primitive/iadd (load k) 1)))))
    (let [(mut c) 0]
      (loop (if (>= (load c) n)
                (break)
                (do
                  (let [(mut best) -1
                        (mut bi) 0]
                    (loop (if (>= (load bi) n)
                              (break)
                              (do
                                (when (and (not (al-get [bool] (load used) (load bi)))
                                           (or (< (load best) (primitive/cast i64 0))
                                               (< (nz-pnum blocks (al-get [i64] idxs (load bi)) r)
                                                  (nz-pnum blocks (al-get [i64] idxs (load best)) r))))
                                  (store! best (load bi)))
                                (store! bi (primitive/iadd (load bi) 1)))))
                    (al-set! [bool] (mut used) (load best) true)
                    (al-push! (mut out) (al-get [i64] idxs (load best))))
                  (store! c (primitive/iadd (load c) 1))))))
    (load out)))

(defn nz-build-renumber [(a (ptr Allocator)) (blocks (ArrayList NzBlock))] (-> Renum)
  (let [rstk (alloc/stack Renum)]
    (store! (field rstk g) (al-new [i64] a))
    (store! (field rstk st) (al-new [i64] a))
    (store! (field rstk cs) (al-new [i64] a))
    (store! (field rstk lv) (al-new [i64] a))
    (let [nb (al-len [NzBlock] blocks)
          (mut stable) (al-new [i64] a)
          (mut pos) (al-new [i64] a)
          (mut k) 0]
      (loop (if (>= (load k) nb)
                (break)
                (do
                  (let [b (alloc/stack NzBlock)]
                    (store! b (al-get [NzBlock] blocks (load k)))
                    (when (= (load (field b cat)) (primitive/cast i64 3))
                      (if (nz-pos-define-name? (load (field b name)))
                          (al-push! (mut pos) (load k))
                          (al-push! (mut stable) (load k)))))
                  (store! k (primitive/iadd (load k) 1)))))
      (nz-assign-idxs rstk blocks (nz-sort-idx-by-name a blocks (load stable)))
      (nz-assign-idxs rstk blocks (nz-sort-idx-by-pnum a blocks (load pos) rstk))
      (let [(mut g2) 0]
        (loop (if (>= (load g2) nb)
                  (break)
                  (do
                    (let [b (alloc/stack NzBlock)]
                      (store! b (al-get [NzBlock] blocks (load g2)))
                      (when (= (load (field b cat)) (primitive/cast i64 1))
                        (nz-assign-block-bodies rstk blocks (load g2))))
                    (store! g2 (primitive/iadd (load g2) 1)))))))
    (load rstk)))

; ---- apply_renumber --------------------------------------------------------
(defn nz-push-str! [(out (mut (ArrayList u8))) (s (slice u8))] (-> i64)
  (let [n (slice-len s)
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do (al-push! (mut out) (slice-get s (load i))) (store! i (primitive/iadd (load i) 1)))))
    0))

(defn nz-fam-str [(fam i64)] (-> (slice u8))
  (if (= fam (primitive/cast i64 0)) "g" (if (= fam (primitive/cast i64 1)) "str" "cstr")))

(defn nz-emit-renamed [(out (mut (ArrayList u8))) (fam i64) (newn i64)] (-> i64)
  (if (= fam (primitive/cast i64 3))
      (do (nz-push-str! (mut out) "@__coil_llvm_ir_") (push-mag (mut out) newn))
      (do
        (al-push! (mut out) (primitive/cast u8 64))
        (nz-push-str! (mut out) (nz-fam-str fam))
        (al-push! (mut out) (primitive/cast u8 46))
        (push-mag (mut out) newn))))

(defn nz-apply-renumber [(a (ptr Allocator)) (line (slice u8)) (r (ptr Renum))] (-> (slice u8))
  (let [n (slice-len line)
        (mut out) (al-new [u8] a)
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (if (= (nz-b line (load i)) (primitive/cast i64 64))
                  (match (nz-scan-positional line (load i))
                    (Some [sr]
                          (let [s (alloc/stack ScanRes)]
                            (store! s sr)
                            (let [newn
                                    (nz-renum-lookup r
                                                     (load (field s fam))
                                                     (load (field s
                                                                  num)))]
                              (if (< newn (primitive/cast i64 0))
                                  (do
                                    (al-push! (mut out) (slice-get line (load i)))
                                    (store! i
                                            (primitive/iadd (load i) 1)))
                                  (do
                                    (nz-emit-renamed (mut out) (load (field s fam)) newn)
                                    (store! i (load (field s endd))))))))
                    (None [] (do (al-push! (mut out) (slice-get line (load i))) (store! i (primitive/iadd (load i) 1)))))
                  (do (al-push! (mut out) (slice-get line (load i))) (store! i (primitive/iadd (load i) 1))))))
    (al-slice [u8] (load out))))

(defn nz-map-apply [(a (ptr Allocator)) (body (ArrayList (slice u8))) (r (ptr Renum))] (-> (ArrayList (slice u8)))
  (let [n (al-len [(slice u8)] body)
        (mut out) (al-new [(slice u8)] a)
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (al-push! (mut out) (nz-apply-renumber a (al-get [(slice u8)] body (load i)) r))
                (store! i (primitive/iadd (load i) 1)))))
    (load out)))

; ---- parse_blocks ----------------------------------------------------------
(defn nz-one-body [(a (ptr Allocator)) (l (slice u8))] (-> (ArrayList (slice u8)))
  (let [(mut b) (al-new [(slice u8)] a)] (al-push! (mut b) l) (load b)))

(defn nz-push-block! [(a (ptr Allocator))
                      (blocks (mut (ArrayList NzBlock)))
                      (cat i64)
                      (name (slice u8))
                      (body (ArrayList (slice u8)))] (-> i64)
  (let [b (alloc/stack NzBlock)]
    (store! (field b cat) cat)
    (store! (field b name) name)
    (store! (field b body) body)
    (al-push! (mut blocks) (load b))
    0))

(defn nz-parse-define [(a (ptr Allocator))
                       (blocks (mut (ArrayList NzBlock)))
                       (lines (ArrayList (slice u8)))
                       (nlines i64)
                       (i i64)
                       (l (slice u8))] (-> i64)
  (let [(mut body) (al-new [(slice u8)] a)
        (mut j) (primitive/iadd i 1)]
    (al-push! (mut body) l)
    (loop (if (or (>= (load j) nlines) (= (al-get [(slice u8)] lines (load j)) "}"))
              (break)
              (do (al-push! (mut body) (al-get [(slice u8)] lines (load j))) (store! j (primitive/iadd (load j) 1)))))
    (when (< (load j) nlines)
      (al-push! (mut body) (al-get [(slice u8)] lines (load j)))
      (store! j (primitive/iadd (load j) 1)))
    (nz-push-block! a (mut blocks) 3 (nz-at-symbol l) (load body))
    (load j)))

(defn nz-parse-one-block [(a (ptr Allocator))
                          (blocks (mut (ArrayList NzBlock)))
                          (lines (ArrayList (slice u8)))
                          (nlines i64)
                          (i i64)
                          (l (slice u8))] (-> i64)
  (cond (and (= (nz-b l 0) (primitive/cast i64 37)) (nz-contains? l "= type"))
          (do (nz-push-block! a (mut blocks) 0 (nz-first-token l) (nz-one-body a l)) (primitive/iadd i 1))
        (= (nz-b l 0) (primitive/cast i64 64))
          (do (nz-push-block! a (mut blocks) 1 (nz-first-token l) (nz-one-body a l)) (primitive/iadd i 1))
        (starts-with l "declare")
          (do (nz-push-block! a (mut blocks) 2 (nz-at-symbol l) (nz-one-body a l)) (primitive/iadd i 1))
        (starts-with l "define") (nz-parse-define a (mut blocks) lines nlines i l)
        :else (do (nz-push-block! a (mut blocks) 4 l (nz-one-body a l)) (primitive/iadd i 1))))

(defn nz-parse-blocks [(a (ptr Allocator)) (text (slice u8))] (-> NzParsed)
  (let [lines (nz-split-lines a text)
        nlines (al-len [(slice u8)] lines)
        (mut header) (al-new [(slice u8)] a)
        (mut blocks) (al-new [NzBlock] a)
        (mut i) 0]
    (loop (if (or (>= (load i) nlines) (= (slice-len (al-get [(slice u8)] lines (load i))) (primitive/cast i64 0)))
              (break)
              (do (al-push! (mut header) (al-get [(slice u8)] lines (load i))) (store! i (primitive/iadd (load i) 1)))))
    (loop (if (>= (load i) nlines)
              (break)
              (let [l (al-get [(slice u8)] lines (load i))]
                (if (= (slice-len l) (primitive/cast i64 0))
                    (store! i (primitive/iadd (load i) 1))
                    (store! i (nz-parse-one-block a (mut blocks) lines nlines (load i) l))))))
    (let [p (alloc/stack NzParsed)]
      (store! (field p header) (load header))
      (store! (field p blocks) (load blocks))
      (load p))))

; ---- block sort by (cat, name) ---------------------------------------------
(defn nz-block-lt [(blocks (ArrayList NzBlock)) (i i64) (j i64)] (-> bool)
  (let [bi (alloc/stack NzBlock)
        bj (alloc/stack NzBlock)]
    (store! bi (al-get [NzBlock] blocks i))
    (store! bj (al-get [NzBlock] blocks j))
    (let [ci (load (field bi cat))
          cj (load (field bj cat))]
      (if (< ci cj)
          true
          (if (> ci cj)
              false
              (str-lt (load (field bi name)) (load (field bj name))))))))

(defn nz-sort-blocks [(a (ptr Allocator)) (blocks (ArrayList NzBlock))] (-> (ArrayList NzBlock))
  (let [n (al-len [NzBlock] blocks)
        (mut used) (al-new [bool] a)
        (mut out) (al-new [NzBlock] a)
        (mut k) 0]
    (loop (if (>= (load k) n)
              (break)
              (do
                (al-push! (mut used) false)
                (store! k
                        (primitive/iadd (load k) 1)))))
    (let [(mut c) 0]
      (loop (if (>= (load c) n)
                (break)
                (do
                  (let [(mut best) -1
                        (mut bi) 0]
                    (loop (if (>= (load bi) n)
                              (break)
                              (do
                                (when (and (not (al-get [bool] (load used) (load bi)))
                                           (or (< (load best) (primitive/cast i64 0))
                                               (nz-block-lt blocks (load bi) (load best))))
                                  (store! best (load bi)))
                                (store! bi (primitive/iadd (load bi) 1)))))
                    (al-set! [bool] (mut used) (load best) true)
                    (al-push! (mut out) (al-get [NzBlock] blocks (load best))))
                  (store! c (primitive/iadd (load c) 1))))))
    (load out)))

; ---- attribute-group renumber ----------------------------------------------
(defn nz-body-of [(defs (ArrayList AttrDef)) (idx i64)] (-> (slice u8))
  (let [d (alloc/stack AttrDef)] (store! d (al-get [AttrDef] defs idx)) (load (field d body))))

(defn nz-sort-attrs [(a (ptr Allocator)) (defs (ArrayList AttrDef))] (-> (ArrayList AttrDef))
  (let [n (al-len [AttrDef] defs)
        (mut used) (al-new [bool] a)
        (mut out) (al-new [AttrDef] a)
        (mut k) 0]
    (loop (if (>= (load k) n)
              (break)
              (do
                (al-push! (mut used) false)
                (store! k
                        (primitive/iadd (load k) 1)))))
    (let [(mut c) 0]
      (loop (if (>= (load c) n)
                (break)
                (do
                  (let [(mut best) -1
                        (mut bi) 0]
                    (loop (if (>= (load bi) n)
                              (break)
                              (do
                                (when (and (not (al-get [bool] (load used) (load bi)))
                                           (or (< (load best) (primitive/cast i64 0))
                                               (str-lt (nz-body-of defs (load bi)) (nz-body-of defs (load best)))))
                                  (store! best (load bi)))
                                (store! bi (primitive/iadd (load bi) 1)))))
                    (al-set! [bool] (mut used) (load best) true)
                    (al-push! (mut out) (al-get [AttrDef] defs (load best))))
                  (store! c (primitive/iadd (load c) 1))))))
    (load out)))

(defn nz-attr-newof [(defs (ArrayList AttrDef)) (old i64)] (-> i64)
  (let [n (al-len [AttrDef] defs)
        (mut i) 0
        (mut res) -1]
    (loop (if (or (>= (load i) n) (>= (load res) (primitive/cast i64 0)))
              (break)
              (do
                (let [d (alloc/stack AttrDef)]
                  (store! d (al-get [AttrDef] defs (load i)))
                  (when (= (load (field d old)) old) (store! res (load i))))
                (store! i (primitive/iadd (load i) 1)))))
    (load res)))

(defn nz-replace-attr-refs [(a (ptr Allocator)) (text (slice u8)) (sorted (ArrayList AttrDef))] (-> (slice u8))
  (let [n (slice-len text)
        (mut out) (al-new [u8] a)
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (if (and (= (nz-b text (load i)) (primitive/cast i64 35))
                       (and (< (primitive/iadd (load i) 1) n) (nz-digit? (nz-b text (primitive/iadd (load i) 1)))))
                  (let [(mut j) (primitive/iadd (load i) 1)]
                    (loop (if (or (>= (load j) n) (not (nz-digit? (nz-b text (load j)))))
                              (break)
                              (store! j (primitive/iadd (load j) 1))))
                    (if (or (>= (load j) n) (not (nz-ident? (nz-b text (load j)))))
                        (let [newn
                                (nz-attr-newof sorted
                                               (nz-parse-int (subslice text (primitive/iadd (load i) 1) (load j))))]
                          (if (>= newn (primitive/cast i64 0))
                              (do
                                (al-push! (mut out) (primitive/cast u8 35))
                                (push-mag (mut out) newn)
                                (store! i
                                        (load j)))
                              (do (al-push! (mut out) (slice-get text (load i))) (store! i (primitive/iadd (load i) 1)))))
                        (do (al-push! (mut out) (slice-get text (load i))) (store! i (primitive/iadd (load i) 1)))))
                  (do (al-push! (mut out) (slice-get text (load i))) (store! i (primitive/iadd (load i) 1))))))
    (al-slice [u8] (load out))))

(defn nz-renumber-attrs [(a (ptr Allocator)) (text (slice u8))] (-> (slice u8))
  (let [lines (nz-split-lines a text)
        nl (al-len [(slice u8)] lines)
        (mut defs) (al-new [AttrDef] a)
        (mut i) 0
        pre "attributes #"]
    (loop (if (>= (load i) nl)
              (break)
              (do
                (let [l (al-get [(slice u8)] lines (load i))]
                  (when (starts-with l pre)
                    (let [rest (subslice l (slice-len pre) (slice-len l))]
                      (match (str-find rest " = ")
                        (None [] 0)
                        (Some [eq]
                              (let [numpart (subslice rest 0 eq)]
                                (when (nz-all-digits? numpart)
                                  (let [d (alloc/stack AttrDef)]
                                    (store! (field d old) (nz-parse-int numpart))
                                    (store! (field d body)
                                            (subslice rest (primitive/iadd eq 3) (slice-len rest)))
                                    (al-push! (mut defs) (load d))
                                    0))))))))
                (store! i (primitive/iadd (load i) 1)))))
    (if (= (al-len [AttrDef] defs) (primitive/cast i64 0))
        text
        (nz-replace-attr-refs a text (nz-sort-attrs a (load defs))))))

; ---- assemble + normalize --------------------------------------------------
(defn nz-assemble [(a (ptr Allocator)) (header (ArrayList (slice u8))) (nblocks (ArrayList NzBlock))] (-> (slice u8))
  (let [(mut out) (al-new [u8] a)
        nh (al-len [(slice u8)] header)
        (mut i) 0]
    (loop (if (>= (load i) nh)
              (break)
              (do
                (nz-push-str! (mut out) (al-get [(slice u8)] header (load i)))
                (al-push! (mut out) (primitive/cast u8 10))
                (store! i (primitive/iadd (load i) 1)))))
    (al-push! (mut out) (primitive/cast u8 10))
    (let [nb (al-len [NzBlock] nblocks)
          (mut k) 0]
      (loop (if (>= (load k) nb)
                (break)
                (do
                  (let [b (alloc/stack NzBlock)]
                    (store! b (al-get [NzBlock] nblocks (load k)))
                    (let [body (load (field b body))
                          nbody (al-len [(slice u8)] body)
                          (mut j) 0]
                      (loop (if (>= (load j) nbody)
                                (break)
                                (do
                                  (nz-push-str! (mut out) (al-get [(slice u8)] body (load j)))
                                  (al-push! (mut out) (primitive/cast u8 10))
                                  (store! j (primitive/iadd (load j) 1)))))
                      (al-push! (mut out) (primitive/cast u8 10))))
                  (store! k (primitive/iadd (load k) 1))))))
    (loop (let [m (al-len [u8] (load out))]
            (if (and (>= m (primitive/cast i64 2))
                     (and (= (nz-b (al-slice [u8] (load out)) (primitive/isub m 1)) (primitive/cast i64 10))
                          (= (nz-b (al-slice [u8] (load out)) (primitive/isub m 2)) (primitive/cast i64 10))))
                (do (al-pop! [u8] (mut out)) 0)
                (break))))
    (al-slice [u8] (load out))))

(defn normalize-ir [(a (ptr Allocator)) (ir (slice u8))] (-> (slice u8))
  (let [text (nz-renumber-attrs a ir)
        parsed (alloc/stack NzParsed)]
    (store! parsed (nz-parse-blocks a text))
    (let [header (load (field parsed header))
          blocks0 (load (field parsed blocks))
          rstk (alloc/stack Renum)]
      (store! rstk (nz-build-renumber a blocks0))
      (let [nb (al-len [NzBlock] blocks0)
            (mut nblocks) (al-new [NzBlock] a)
            (mut i) 0]
        (loop (if (>= (load i) nb)
                  (break)
                  (do
                    (let [b (alloc/stack NzBlock)
                          nbk (alloc/stack NzBlock)]
                      (store! b (al-get [NzBlock] blocks0 (load i)))
                      (store! (field nbk cat) (load (field b cat)))
                      (store! (field nbk name) (nz-apply-renumber a (load (field b name)) rstk))
                      (store! (field nbk body) (nz-map-apply a (load (field b body)) rstk))
                      (al-push! (mut nblocks) (load nbk)))
                    (store! i (primitive/iadd (load i) 1)))))
        (nz-assemble a header (nz-sort-blocks a (load nblocks)))))))

; Tail of the pipeline: mono'd Program -> codegen -> print -> normalize -> stdout.
; Mirrors (emit_ir then normalize_ir::normalize).
(defn emit-ir-normalized [(a (ptr Allocator))
                          (w (ptr Writer))
                          (mp (ptr Program))
                          (triple (ptr i8))
                          (sanitizer i64)
                          (debug-checks bool)] (-> i64)
  (let [m (codegen-module a mp triple sanitizer debug-checks)
        ir-cstr (LLVMPrintModuleToString m)
        ir (cstr->slice ir-cstr)
        norm (normalize-ir a ir)]
    (ps w norm)
    (wb w 10)  ; mirror `coil dump-ir`'s println! trailing newline
    0))

; Shared front of the pipeline: read -> load -> expand -> resolve -> check -> mono.
; Returns `(Some mono-Program)` on success; on any pass error it dumps the Diag to
; `w` and returns `(None)`. Both `dump-ir-program` (print IR) and `build-ir-program`
; (emit object) drive this so the two share ONE pipeline.
; ============================ diagnostic renderer ===========================
; Faithful render/render_all + report/print_error:
; `error: <msg>\n  --> file:line:col\n   |\nN | <src line>\n   |   ^^^^`, plus a
; `note: in expansion of macro …` trace and an `N errors` multi-error summary.
