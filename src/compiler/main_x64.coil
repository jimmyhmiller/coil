; src/compiler/main_x64.coil — self-host Coil compiler ENTRY, LLVM-FREE build,
; x86-64 / ELF. The Linux sibling of main_a64.coil.
;
; Identical to main.coil except it OMITS the LLVM backend: it does not import
; codegen.coil / normalize.coil, so the produced binary links NO libLLVM and needs
; no LLVM at build or run time (only `cc` to link the native object). Its only
; supported build path is the native backend, tpde; the LLVM entry points are
; injected into the shared driver as hard-error stubs. Use main.coil for the full
; (LLVM + native) compiler. Imports are FILE-RELATIVE (tool-1): sibling compiler
; modules resolve against THIS file's directory (src/compiler), so it builds from
; any CWD; bare stdlib names resolve to the bundled library from anywhere.
(module coil.compiler.main_x64)
(import "coil.primitive" :as primitive)
(import "coil.os" :as os)
(import "coil.alloc" :as alloc :use *)
(import "coil.result" :use *)
(import "coil.slice" :use *)
(import "coil.str" :use *)
(import "coil.arraylist" :use *)
(import "coil.io" :use *)
(import "coil.control" :use *)
(import "coil.try" :use *)
(import "coil.compiler.ffi" :use *)
(import "coil.reader" :use *)
(import "coil.compiler.ast" :use *)
(import "coil.compiler.astdump" :use *)
(import "coil.compiler.parser" :use *)
(import "coil.compiler.loader" :use *)
(import "coil.compiler.resolve" :use *)
(import "coil.compiler.check" :use *)
(import "coil.compiler.mono" :use *)
(import "coil.compiler.diag" :use *)
(import "coil.compiler.comptime" :use *)
(import "coil.compiler.metaengine" :use *)
(import "coil.compiler.expander" :use *)
(import "coil.compiler.comptime_eval" :use *)  ; compiled comptime/const fold (interp deletion step 1)

(import "coil.compiler.codegen_tpde" :use [cgtpde-build-eobj cgtpde-build-host-object])
(import "coil.compiler.elf" :use *)  ; EObj — the in-memory object tpde builds for ELF

(import "coil.compiler.driver" :use *)
(import "coil.compiler.cimport" :as ci)  ; `coil cimport` — qualified, no name leak

; ---- hard-error stubs for the (excluded) LLVM backend ----
; This build has no LLVM backend; these fail loudly rather than silently no-op, so
; a caller that reaches them (e.g. `build` without --backend x64, or `emit-ir`)
; gets a clear diagnostic instead of mysterious behavior. Signatures mirror the real
; build-ir-program / dump-ir-program / do-normalize in main.coil.
(defn no-llvm-build [(a (dyn Allocator))
                     (src (slice u8))
                     (cwd (slice u8))
                     (obj-cstr (ptr i8))
                     (triple (ptr i8))
                     (path (slice u8))] (-> i64)
  (ps (stderr)
      "error: this coil was built without the LLVM backend; `build` requires `--backend x64`\n")
  (abort)
  1)

(defn no-llvm-emitir [(a (dyn Allocator))
                      (src (slice u8))
                      (cwd (slice u8))
                      (triple (ptr i8))
                      (path (slice u8))] (-> i64)
  (ps (stderr)
      "error: this coil was built without the LLVM backend; `emit-ir` / `dump-ir` are unavailable (no textual LLVM IR without libLLVM)\n")
  (abort)
  1)

(defn no-normalize [(a (dyn Allocator)) (src (slice u8))] (-> i64)
  (ps (stderr)
      "error: this coil was built without the LLVM backend; `__normalize` is unavailable\n")
  (abort)
  1)

(defn no-jit-repl [(a (dyn Allocator)) (argv (ptr (ptr i8)))] (-> i64)
  (ps (stderr) "error: coil.jit currently requires an arm64 macOS host\n")
  1)

; default-backend = 5 (x64): a bare `build` uses the native backend; there is no
; LLVM backend to fall back to.
(defn do-cimport [(a (dyn Allocator)) (argc i32) (argv (ptr (ptr i8)))] (-> i64)
  (ci/cimport-cli a argc argv 5))

; the compiled-metaprogram engine's object builder (metaengine.coil): a mono'd
; metaprogram Program -> object file, via tpde, so this LLVM-free compiler can
; build metaprogram dylibs too — the compiled engine is the DEFAULT here, exactly
; as in the LLVM build. No DWARF for the dylib (a metaprogram needs no debug info,
; and there are no registered source paths to describe).
(defn meta-build-obj-x64 [(a (dyn Allocator)) (mp (ptr Program)) (obj (ptr i8))] (-> i64)
  (cgtpde-build-host-object a
                            mp
                            obj
                            ""
                            ""
                            (box-al [(slice u8)] a (ArrayList::new [(slice u8)] a))
                            (box-al [(slice u8)] a (ArrayList::new [(slice u8)] a))
                            false))

; The in-memory object builder, the ELF sibling of main_a64.coil's: the same mono'd
; metaprogram Program, handed back as an EObj instead of written to a file, so
; jit_elf.coil can map it straight into executable pages. This is what lets comptime
; and the metaprogram engine skip the `cc -shared` + dlopen round trip entirely.
(defn meta-build-eobj-x64 [(a (dyn Allocator)) (mp (ptr Program))] (-> EObj)
  (cgtpde-build-eobj a
                     mp
                     ""
                     ""
                     (box-al [(slice u8)] a (ArrayList::new [(slice u8)] a))
                     (box-al [(slice u8)] a (ArrayList::new [(slice u8)] a))
                     false))

; The compiler spawns the linker driver directly (spawn-wait -> os/spawn), and
; posix_spawn takes the child environment EXPLICITLY: whatever `os/spawn-envp`
; returns is all the child gets. Nothing published one, so it returned NULL and
; every linker child ran with an EMPTY environment.
;
; Apple's /usr/bin/cc locates `ld` without consulting PATH, so ordinary builds
; never noticed. The sanitizer path uses the clang beside the LLVM that inserted
; the pass -- Homebrew's -- and that one finds `ld` ON PATH, so `--sanitize=...`
; died as `clang: error: unable to execute command: posix_spawn failed: No such
; file or directory`, which names neither the environment nor the linker.
;
; coil.os says main's third C argument is the portable way to get it and that
; whoever owns `main` publishes it once. This is that owner.
(defn main [(argc i32) (argv (ptr (ptr i8))) (envp (ptr (ptr i8)))] (-> i64)
  (os/publish-envp! envp)  ; the linker child inherits this; see above
  (set-meta-build-obj! (fnptr-of meta-build-obj-x64))
  ; in-memory metaprograms by default; COIL_META_JIT=0 falls back to the dylib
  (set-meta-build-eobj! (fnptr-of meta-build-eobj-x64))
  (meta-jit-default-on!)
  (select-meta-interp-from-env!)  ; COIL_META_INTERP=1: the interpreted engine
  (register-comptime-fold!)  ; route comptime/const sites the interpreter can't fold through the compiled engine (mac-8)
  (driver-main argc
               argv
               (fnptr-of no-llvm-build)
               (fnptr-of no-llvm-emitir)
               (fnptr-of no-normalize)
               (fnptr-of do-cimport)
               (fnptr-of no-jit-repl)
               5))
