;;; Immutable name-resolution side tables shared between compiler revisions.
(module coil.compiler.resolution_base)
(import "coil.primitive" :as p)
(import "coil.alloc" :use *)
(import "coil.arraylist" :use *)
(import "coil.hashmap" :use *)
(import "coil.slice" :use *)
(import "coil.scratch" :as scratch)
(import "coil.pmap" :use *)

(defstruct ResOwner
  [(refs i64) (arena scratch/ScratchArena) (a (dyn Allocator))])

(defstruct ResHold [(owner (ptr ResOwner))])

(defn res-owner-release! [(owner (ptr ResOwner))] (-> i64)
  (let [remaining (- (.refs owner) 1)]
    (set! (.refs owner) remaining)
    (when (= remaining 0)
      (close! (field owner arena))
      (free [ResOwner] (.a owner) (slice::new owner 1))
      0))
  0)

(impl Clone ResHold
  (clone [(self (ref ResHold))] (-> ResHold)
    (let [owner (.owner self)]
      (set! (.refs owner) (+ (.refs owner) 1))
      (ResHold :owner owner))))

(impl Drop ResHold
  (drop [(self (mut ResHold))] (-> void)
    (res-owner-release! (.owner self))))

(defn res-owner-new [(a (dyn Allocator))] (-> (ptr ResOwner))
  (let [owner (box! a ResOwner (p/zeroed ResOwner))]
    (set! (.refs owner) 1)
    (set! (.a owner) a)
    (scratch/ScratchArena::init-with-capacity (field owner arena) a 512)
    owner))

(defn res-owner-hold [(owner (ptr ResOwner))] (-> ResHold)
  (set! (.refs owner) (+ (.refs owner) 1))
  (ResHold :owner owner))

(defn res-owner-done! [(owner (ptr ResOwner))] (-> i64)
  (res-owner-release! owner))

(defn res-own-bytes [(a (dyn Allocator)) (text (slice u8))] (-> (slice u8))
  (if (= (len text) 0)
      ""
      (match (alloc [u8] a (len text))
        (None [] (do (oom-at c"resolution name" (len text)) ""))
        (Some [memory]
              (let [out (data memory)]
                (for [i 0 (len text)] (set! (p/index out i) (get text i)))
                memory)))))

(defn res-lease-noop [(state (ptr i8))] (-> i64)
  0)

(defn res-lease [(a (dyn Allocator))] (-> AllocatorLease)
  (unsafe-allocator-lease-new a
                              (p/cast (ptr i8) 0)
                              (p/fnptr-of res-lease-noop)
                              (p/fnptr-of res-lease-noop)))

(defstruct ResKey
  [(module (slice u8)) (raw (slice u8)) (owner (ptr ResOwner))])

(impl Clone ResKey
  (clone [(self (ref ResKey))] (-> ResKey)
    (let [owner (.owner self)]
      (unless (= (p/cast i64 owner) 0)
        (set! (.refs owner) (+ (.refs owner) 1))
        0)
      (ResKey
        :module (.module self)
        :raw (.raw self)
        :owner owner))))

(impl Drop ResKey
  (drop [(self (mut ResKey))] (-> void)
    (unless (= (p/cast i64 (.owner self)) 0)
      (res-owner-release! (.owner self))
      0)))

(defn res-key-hash [(raw (ptr i8)) (size i64)] (-> i64)
  (let [key (p/cast (ptr ResKey) raw)]
    (p/ixor (hash (.module key)) (p/imul (hash (.raw key)) 1099511628211))))

(defn res-key-eq [(left (ptr i8)) (right (ptr i8)) (size i64)] (-> bool)
  (let [a (p/cast (ptr ResKey) left)
        b (p/cast (ptr ResKey) right)]
    (and (= (.module a) (.module b)) (= (.raw a) (.raw b)))))

(defn res-keyops [] (-> (ptr KeyOps))
  (let [ops (p/alloc-static KeyOps)]
    (set! (.hash ops) (p/fnptr-of res-key-hash))
    (set! (.eq ops) (p/fnptr-of res-key-eq))
    (set! (.size ops) (p/sizeof ResKey))
    ops))

(defstruct ResValue [(qual (slice u8)) (hold ResHold)])

(impl Clone ResValue
  (clone [(self (ref ResValue))] (-> ResValue)
    (ResValue :qual (.qual self) :hold (clone (field self hold)))))

(defstruct SrcValue [(module (slice u8)) (hold ResHold)])

(impl Clone SrcValue
  (clone [(self (ref SrcValue))] (-> SrcValue)
    (SrcValue :module (.module self) :hold (clone (field self hold)))))

(defstruct ResolutionBase
  [(refs i64)
   (a (dyn Allocator))
   (types (PMap ResKey ResValue))
   (values (PMap ResKey ResValue))
   (sources (PMap i64 SrcValue))])

(defn resolution-no-base [] (-> (ptr ResolutionBase))
  (p/cast (ptr ResolutionBase) 0))

(defn resolution-base-new [(a (dyn Allocator))] (-> (ptr ResolutionBase))
  (let [base (box! a ResolutionBase (p/zeroed ResolutionBase))]
    (set! (.refs base) 1)
    (set! (.a base) a)
    (set! (.types base)
          (PMap::new [ResKey ResValue] (res-lease a) (res-keyops)))
    (set! (.values base)
          (PMap::new [ResKey ResValue] (res-lease a) (res-keyops)))
    (set! (.sources base) (PMap::new-scalar [i64 SrcValue] (res-lease a)))
    base))

(defn resolution-base-derive [(a (dyn Allocator)) (parent (ptr ResolutionBase))]
  (-> (ptr ResolutionBase))
  (if (= parent (resolution-no-base))
      (resolution-base-new a)
      (let [base (box! a ResolutionBase (p/zeroed ResolutionBase))]
        (set! (.refs base) 1)
        (set! (.a base) a)
        (set! (.types base) (clone (load (field parent types))))
        (set! (.values base) (clone (load (field parent values))))
        (set! (.sources base) (clone (load (field parent sources))))
        base)))

(defn resolution-base-release! [(base (ptr ResolutionBase))] (-> i64)
  (unless (= base (resolution-no-base))
    (let [remaining (- (.refs base) 1)]
      (set! (.refs base) remaining)
      (when (= remaining 0)
        (let [types (take! [(PMap ResKey ResValue)] (field base types))
              values (take! [(PMap ResKey ResValue)] (field base values))
              sources (take! [(PMap i64 SrcValue)] (field base sources))]
          0)
        (free [ResolutionBase] (.a base) (slice::new base 1))
        0))
    0)
  0)

(defn resolution-lookup [(base (ptr ResolutionBase))
                         (types bool)
                         (module (slice u8))
                         (raw (slice u8))] (-> (slice u8))
  (if (= base (resolution-no-base))
      ""
      (let [key
              (ResKey
                :module module
                :raw raw
                :owner (p/cast (ptr ResOwner) 0))]
        (match (if types
                   (get-ptr (field base types) key)
                   (get-ptr (field base values) key))
          (None [] "")
          (Some [value] (.qual value))))))

(defn resolution-source-lookup [(base (ptr ResolutionBase)) (source i64)]
  (-> (slice u8))
  (if (= base (resolution-no-base))
      ""
      (match (get-ptr (field base sources) source)
        (None [] "")
        (Some [value] (.module value)))))

(defn resolution-put! [(base (ptr ResolutionBase))
                       (owner (ptr ResOwner))
                       (types bool)
                       (module (slice u8))
                       (raw (slice u8))
                       (qual (slice u8))] (-> i64)
  (let [a (allocator (field owner arena))
        key
          (ResKey
            :module (res-own-bytes a module)
            :raw (res-own-bytes a raw)
            :owner owner)
        value
          (ResValue
            :qual (res-own-bytes a qual)
            :hold (res-owner-hold owner))]
    ; The key itself owns the module/raw bytes independently of the value.
    (set! (.refs owner) (+ (.refs owner) 1))
    (if types
        (set! (mut (.types base)) key value)
        (set! (mut (.values base)) key value))))

(defn resolution-source-put! [(base (ptr ResolutionBase))
                              (owner (ptr ResOwner))
                              (source i64)
                              (module (slice u8))] (-> i64)
  (let [a (allocator (field owner arena))]
    (set! (mut (.sources base))
          source
          (SrcValue
            :module (res-own-bytes a module)
            :hold (res-owner-hold owner)))))

;;; Remove every answer whose authored leaf is retired. Retirements are rare; this
;;; scan avoids maintaining a second persistent index on the ordinary edit path.
(defn resolution-remove-raw! [(base (ptr ResolutionBase)) (raw (slice u8))]
  (-> i64)
  (let [(mut keys) (ArrayList::new [ResKey] (.a base))]
    (let [(mut it) (iter (field base types))]
      (loop (match (next (mut it))
              (None [] (break))
              (Some [e]
                    (when (= (.raw (.key e)) raw)
                      (push! (mut keys) (clone (load (field e key))))
                      0)))))
    (for [i 0 (len keys)] (dissoc! (mut (.types base)) (get keys i)))
    (clear! (mut keys))
    (let [(mut it) (iter (field base values))]
      (loop (match (next (mut it))
              (None [] (break))
              (Some [e]
                    (when (= (.raw (.key e)) raw)
                      (push! (mut keys) (clone (load (field e key))))
                      0)))))
    (for [i 0 (len keys)] (dissoc! (mut (.values base)) (get keys i)))
    0))

(defn resolution-remove-qual! [(base (ptr ResolutionBase)) (qual (slice u8))]
  (-> i64)
  (let [(mut keys) (ArrayList::new [ResKey] (.a base))
        (mut it) (iter (field base values))]
    (loop (match (next (mut it))
            (None [] (break))
            (Some [e]
                  (when (= (.qual (.val e)) qual)
                    (push! (mut keys) (clone (load (field e key))))
                    0))))
    (for [i 0 (len keys)] (dissoc! (mut (.values base)) (get keys i)))
    0))

(defn resolution-name-scope [(name (slice u8))] (-> i64)
  (match (find name "$scope")
    (None [] 0)
    (Some [start]
          (if (and (> start 0) (!= (p/cast i64 (get name (- start 1))) 46))
              0
              (block
                :scope
                  (let [(mut value) 0
                        (mut at) (+ start 6)]
                    (loop (if (>= (load at) (len name))
                              (break)
                              (let [ch (p/cast i64 (get name (load at)))]
                                (when (= ch 64)
                                  (return-from :scope (load value)))
                                (when (or (< ch 48) (> ch 57))
                                  (return-from :scope 0))
                                (set! value (+ (* (load value) 10) (- ch 48)))
                                (set! at (+ (load at) 1)))))
                    0))))))

(defn resolution-prune! [(base (ptr ResolutionBase))
                         (live-scopes (HashMap i64 i64))
                         (live-sources (HashMap i64 i64))] (-> i64)
  (let [(mut keys) (ArrayList::new [ResKey] (.a base))]
    (let [(mut it) (iter (field base types))]
      (loop (match (next (mut it))
              (None [] (break))
              (Some [e]
                    (let [scope (resolution-name-scope (.raw (.key e)))]
                      (when (and (> scope 0)
                                 (not (contains? live-scopes scope)))
                        (push! (mut keys) (clone (load (field e key))))
                        0))))))
    (for [i 0 (len keys)] (dissoc! (mut (.types base)) (get keys i)))
    (clear! (mut keys))
    (let [(mut it) (iter (field base values))]
      (loop (match (next (mut it))
              (None [] (break))
              (Some [e]
                    (let [scope (resolution-name-scope (.raw (.key e)))]
                      (when (and (> scope 0)
                                 (not (contains? live-scopes scope)))
                        (push! (mut keys) (clone (load (field e key))))
                        0))))))
    (for [i 0 (len keys)] (dissoc! (mut (.values base)) (get keys i)))
    (let [(mut sources) (ArrayList::new [i64] (.a base))
          (mut it) (iter (field base sources))]
      (loop (match (next (mut it))
              (None [] (break))
              (Some [e]
                    (unless (contains? live-sources (.key e))
                      (push! (mut sources) (.key e))
                      0))))
      (for [i 0 (len sources)] (dissoc! (mut (.sources base)) (get sources i))))
    0))
