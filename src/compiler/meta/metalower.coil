; src/compiler/meta/metalower.coil — lower a CHECKED metaprogram sub-program to a
; normal, compilable program (the compile-and-run metaprogram engine's core pass).
;
; Runs AFTER check-program (so every code-op argument's inferred type is in the
; type map) and BEFORE monomorphize. It rewrites, everywhere:
;   - the type `Code`            -> (ptr i8)   (an opaque handle to a host Sexp)
;   - (ECodeOp op args)          -> metashim arg-builder chain + mp-op-RET call
;   - (EQuote form) / QLit       -> (mp-quoted k) against the host quote registry
;   - (EQuasi q)                 -> nested mp-qq-* builder calls
;   - (primitive/error MSG) (op 9, never)  -> (do (mp-op-int 9 ...) (loop 0))  — never-typed
; and appends an ExportC per metaprogram entry so the dylib exposes coil_mp_<k>.
;
; PARITY RULES. The interpreter fails many misuses only WHEN EVALUATED (wrong-typed
; op arguments, unquoting an aggregate, splicing a non-list). Lowering preserves
; that: wrong-typed args still cross the boundary as real CtVals and fail with the
; interpreter's own message; evaluation-order side effects are kept by nesting the
; builder calls (argument chains evaluate left-to-right, like eval-seq). The only
; compile-time rejections here are values that CANNOT cross (structs, refs), which
; the interpreter would also reject on every evaluation.
(module coil.compiler.metalower)
(import "coil.compiler.text" :as text)
(import "coil.primitive" :as primitive)
(import "coil.compiler.unit_state" :use *)
(import "coil.alloc" :as alloc :use *)
(import "coil.slice" :use *)
(import "coil.str" :use *)
(import "coil.arraylist" :use *)
(import "coil.result" :use *)
(import "coil.control" :use *)
(import "coil.try" :use *)
(import "coil.reader" :use *)
(import "coil.compiler.parser" :use *)
(import "coil.compiler.ast" :use *)
(import "coil.compiler.ast_map" :as am)
(import "coil.compiler.resolve" :use *)
(import "coil.compiler.comptime" :use *)
(import "coil.compiler.check" :use *)
(import "coil.compiler.ffi" :use *)
(import "coil.io" :use [stderr])
(import "coil.hashmap" :use *)

; ---- pass state ----------------------------------------------------------------
(defstruct MLS
  [(a (dyn Allocator))
   (reg (ptr (ArrayList (ptr Sexp))))
   ; Lexical module of the function currently being lowered.  Quasiquote literals
   ; are stamped here, rather than from the dynamic metaprogram entry at run time.
   (qmodule (slice u8))
   (syntax_only bool)
   (restricted (ptr (ArrayList MLRestricted)))
   ; The checked program's sums, and a decoder function per answer sum a code
   ; operation of this program returns (ml-answer-decoder).
   (sums (ptr (ArrayList SumDef)))
   (answers (ptr (ArrayList Func)))])

(defstruct MLRestricted [(name (slice u8)) (target (slice u8)) (diag Diag)])

;;; A metaprogram entry: the function NAME, exported as SYMBOL, which calls CALLEE,
;;; NAME itself or its argument-array adapter (`ml-argv-adapter!`).
(defstruct MLEntry [(name (slice u8)) (symbol (slice u8)) (callee (slice u8))])

(defstruct MLOut
  [(prog (ptr Program))
   (entries (ptr (ArrayList MLEntry)))
   (registry (ptr (ArrayList (ptr Sexp))))
   (restricted (ptr (ArrayList MLRestricted)))])

; ---- types: Code -> (ptr i8), recursively ---------------------------------------
(defn ml-code-ty [(a (dyn Allocator))] (-> Type)
  (TPtr (box-type a (TInt 8 true))))

(defn ml-type [(a (dyn Allocator)) (t (ptr Type))] (-> Type)
  (match (load t)
    (TCode [] (ml-code-ty a))
    ; the builder is the same boxed-Sexp handle (docs/design/META_MEMORY.md ph 4)
    (TCodeBuilder [] (ml-code-ty a))
    (TPtr [inner] (TPtr (box-type a (ml-type a inner))))
    (TRef [m inner] (TRef m (box-type a (ml-type a inner))))
    (TArray [e n] (TArray (box-type a (ml-type a e)) n))
    (TSlice [e] (TSlice (box-type a (ml-type a e))))
    (TVec [e n] (TVec (box-type a (ml-type a e)) n))
    (TFn [cc ps ret]
         (TFn
           :cc cc
           :params (ml-type-list a ps)
           :ret (box-type a (ml-type a ret))))
    (TApp [nm args] (TApp nm (ml-type-list a args)))
    (_ (load t))))

(defn ml-type-list [(a (dyn Allocator)) (ts (ptr (ArrayList Type)))]
  (-> (ptr (ArrayList Type)))
  (let [n (len (load ts))
        (mut out) (ArrayList::new [Type] a)]
    (for [i 0 n]
      (push! (mut out) (ml-type a (elem ts i))))
    (box-al [Type] a (load out))))

(defn ml-type-opt [(a (dyn Allocator)) (t (Option Type))] (-> (Option Type))
  (match t
    (None [] (None [Type]))
    (Some [tv]
          (let [(mut tp) tv] (Some (ml-type a (mut tp)))))))

; ---- small expr constructors -----------------------------------------------------
; Every synthesized node inherits the ORIGINAL node's span, so diagnostics keep
; pointing at real source.
(defn ml-call1 [(st (ptr MLS)) (fname (slice u8)) (x Expr) (proto (ptr Expr))]
  (-> Expr)
  (let [a (.a st)
        (mut args) (ArrayList::new [Expr] a)]
    (push! (mut args) x)
    (expr-at proto
             (ECall
               :func fname
               :type_args (box-al [Type] a (ArrayList::new [Type] a))
               :args (box-al [Expr] a (load args))))))

(defn ml-call2 [(st (ptr MLS))
                (fname (slice u8))
                (x Expr)
                (y Expr)
                (proto (ptr Expr))] (-> Expr)
  (let [a (.a st)
        (mut args) (ArrayList::new [Expr] a)]
    (push! (mut args) x)
    (push! (mut args) y)
    (expr-at proto
             (ECall
               :func fname
               :type_args (box-al [Type] a (ArrayList::new [Type] a))
               :args (box-al [Expr] a (load args))))))

(defn ml-call0 [(st (ptr MLS)) (fname (slice u8)) (proto (ptr Expr))] (-> Expr)
  (let [a (.a st)]
    (expr-at proto
             (ECall
               :func fname
               :type_args (box-al [Type] a (ArrayList::new [Type] a))
               :args (box-al [Expr] a (ArrayList::new [Expr] a))))))

(defn ml-int [(st (ptr MLS)) (v i64) (proto (ptr Expr))] (-> Expr)
  (expr-at proto (EInt v)))

; Fail the way the interpreter does, at run time, located at `at`: the operand
; whose value could not become Code.
(defn ml-parity-fail [(st (ptr MLS)) (code i64) (at (ptr Expr))] (-> Expr)
  (let [a (.a st)
        (mut args) (ArrayList::new [Expr] a)]
    (push! (mut args) (ml-int st code at))
    (push! (mut args) (ml-int st (.source at) at))
    (push! (mut args) (ml-int st (.lo at) at))
    (push! (mut args) (ml-int st (.hi at) at))
    (expr-at at
             (ECall
               :func "coil.compiler.metashim.mp-parity-fail"
               :type_args (box-al [Type] a (ArrayList::new [Type] a))
               :args (box-al [Expr] a (load args))))))

(defn ml-do2 [(st (ptr MLS)) (x Expr) (y Expr) (proto (ptr Expr))] (-> Expr)
  (let [a (.a st)
        (mut body) (ArrayList::new [Expr] a)]
    (push! (mut body) x)
    (push! (mut body) y)
    (expr-at proto (EDo (box-al [Expr] a (load body))))))

; a break-less loop: the never-typed tail after a host call that cannot return
(defn ml-diverge [(st (ptr MLS)) (proto (ptr Expr))] (-> Expr)
  (let [a (.a st)
        (mut body) (ArrayList::new [Expr] a)]
    (push! (mut body) (ml-int st 0 proto))
    (expr-at proto (ELoop (None [(slice u8)]) (box-al [Expr] a (load body))))))

; ---- argument classification ------------------------------------------------------
; kinds: 1=Code 2=int 3=str 4=bool 5=float 6=never 0=cannot-cross
(defn ml-kind-of-type [(t (ptr Type))] (-> i64)
  (match (load t)
    (TCode [] 1)
    ; a builder is the same boxed-Sexp handle at runtime; the distinction is
    ; static only (docs/design/META_MEMORY.md phase 4)
    (TCodeBuilder [] 1)
    (TInt [b s] 2)
    (TBool [] 4)
    (TFloat [b] 5)
    (TNever [] 6)
    (TSlice [e]
            (match (load e)
              (TInt [b s] (when (and (= b 8) (not s)) 3))
              (_ 0)))
    (_ 0)))

; The checked type of an ORIGINAL (pre-lowering) expr: type map by node-id, else a
; structural fallback for the node kinds whose type is intrinsic.
(defn ml-node-type [(st (ptr MLS)) (e (ptr Expr))] (-> (Result Type Diag))
  (match (type-map-lookup (.node-id e))
    (Some [t] (Ok [Type Diag] t))
    (None []
          (match (.kind e)
            (EInt [v] (Ok [Type Diag] (TInt 64 true)))
            (EBool [b] (Ok [Type Diag] (TBool)))
            (EFloat [bits] (Ok [Type Diag] (TFloat 64)))
            (EStr [s]
                  (Ok [Type Diag] (TSlice (box-type (.a st) (TInt 8 false)))))
            (EQuote [f] (Ok [Type Diag] (TCode)))
            (EQuasi [q] (Ok [Type Diag] (TCode)))
            (ECodeOp [op args] (Ok [Type Diag] (codeop-rty op)))
            ; Reading a mutable binding, `(let [(mut b) …] (code-list-push! b x))`:
            ; the checker adds the load, and the value is the cell's.
            (ELoad [inner]
                   (match (ml-node-type st inner)
                     (Ok [t]
                         (match t
                           (TRef [_ pointee] (Ok [Type Diag] (load pointee)))
                           (TPtr [pointee] (Ok [Type Diag] (load pointee)))
                           (_ (Err [Type Diag]
                                   (derr-at-src (.source e)
                                                (.lo e)
                                                (.hi e)
                                                "metalower: a load of a code-op argument that is not a place (compiler bug)")))))
                     (Err [d] (Err [Type Diag] d))))
            (_ (Err [Type Diag]
                    (derr-at-src (.source e)
                                 (.lo e)
                                 (.hi e)
                                 "metalower: no inferred type recorded for a code-op argument (compiler bug)")))))))

; widen an int/float argument to the boundary's i64/f64
(defn ml-widen-int [(st (ptr MLS)) (t Type) (le Expr) (proto (ptr Expr))]
  (-> Expr)
  (match t
    (TInt [b s]
          (if (= b 64)
              le
              (expr-at proto (ECast (TInt 64 true) (box-expr (.a st) le)))))
    (_ le)))

(defn ml-widen-float [(st (ptr MLS)) (t Type) (le Expr) (proto (ptr Expr))]
  (-> Expr)
  (match t
    (TFloat [b]
            (if (= b 64)
                le
                (expr-at proto (ECast (TFloat 64) (box-expr (.a st) le)))))
    (_ le)))

; ---- ECodeOp lowering --------------------------------------------------------------
; (op a0 a1 ...) -> (mp-op-RET op (mp-arg-K (mp-arg-K (mp-arg-new) A0) A1))
; If an argument is never-typed, evaluation stops there (like the interpreter's
; arg-evaluation loop): the whole node becomes (do A0 .. ANEVER), itself never-typed.
; The hot lowering belongs to the in-memory engine, so it follows the same switch —
; including the opt-out. This used to test only that COIL_META_JIT was SET, so
; COIL_META_JIT=0 turned the hot lowering on while sending the engine down the dylib
; route: the one combination neither had ever run under. Unreachable while the
; variable was unset by default; reachable the moment it is not.
(defn ml-meta-jit? [] (-> bool)
  (let [v (unit-getenv c"COIL_META_JIT")]
    ; leading '0' (48) = off, the same spelling trace.coil reads COIL_TRACE with.
    (and (!= (primitive/cast i64 v) 0) (!= (load v) (: 48 i8)))))

(defn ml-hot-codeop? [(op i64)] (-> bool)
  (and (ml-meta-jit?)
       (or (<= op 4) (= op 10) (= op 11))))

(defn ml-hot-codeop [(st (ptr MLS))
                     (op i64)
                     (args (ptr (ArrayList Expr)))
                     (proto (ptr Expr))] (-> (Result Expr Diag))
  (try (do
         (let [x (try! (ml-expr st (elem args 0)))]
           (cond (= op 0)
                   (Ok [Expr Diag]
                       (ml-call1 st
                                 "coil.compiler.metashim.mp-code-list?"
                                 x
                                 proto))
                 (= op 1)
                   (Ok [Expr Diag]
                       (ml-call1 st
                                 "coil.compiler.metashim.mp-code-sym?"
                                 x
                                 proto))
                 (= op 2)
                   (Ok [Expr Diag]
                       (ml-call1 st
                                 "coil.compiler.metashim.mp-code-int?"
                                 x
                                 proto))
                 (= op 3)
                   (Ok [Expr Diag]
                       (ml-call1 st
                                 "coil.compiler.metashim.mp-code-count"
                                 x
                                 proto))
                 (= op 11)
                   (Ok [Expr Diag]
                       (ml-call1 st
                                 "coil.compiler.metashim.mp-code-keyword?"
                                 x
                                 proto))
                 (= op 4)
                   (Ok [Expr Diag]
                       (ml-call2 st
                                 "coil.compiler.metashim.mp-code-nth"
                                 x
                                 (try! (ml-expr st (elem args 1)))
                                 proto))
                 :else
                   (Ok [Expr Diag]
                       (ml-call2 st
                                 "coil.compiler.metashim.mp-code-eq"
                                 x
                                 (try! (ml-expr st (elem args 1)))
                                 proto)))))))

(defn ml-codeop [(st (ptr MLS))
                 (op i64)
                 (args (ptr (ArrayList Expr)))
                 (proto (ptr Expr))] (-> (Result Expr Diag))
  (ml-codeop-native st op args proto))

;;; The call of the host's operation FNAME for code operation OP. A precompiled
;;; syntax reader may not use semantic reflection: such a call goes to a restricted
;;; copy of FNAME, which concrete reachability then refuses to emit.
(defn ml-op-call [(st (ptr MLS))
                  (op i64)
                  (fname (slice u8))
                  (opx Expr)
                  (chain Expr)
                  (proto (ptr Expr))] (-> Expr)
  (if (and (.syntax_only st) (not (syntax-provider-codeop? op)))
      (let [name
              (text/format (.a st)
                           "coil.compiler.metashim.__artifact_restricted_{}"
                           (i64->str (.a st) (len (load (.restricted st)))))]
        (push! (.restricted st)
               (MLRestricted
                 :name name
                 :target fname
                 :diag
                   (derr-at-src (.source proto)
                                (.lo proto)
                                (.hi proto)
                                (text/format (.a st)
                                             "precompiled syntax reader cannot use semantic reflection (code operation {}); use a source provider for authoritative program reflection"
                                             (i64->str (.a st) op)))))
        (ml-call2 st name opx chain proto))
      (ml-call2 st fname opx chain proto)))

(defn ml-codeop-native [(st (ptr MLS))
                        (op i64)
                        (args (ptr (ArrayList Expr)))
                        (proto (ptr Expr))] (-> (Result Expr Diag))
  (if (ml-hot-codeop? op)
      (ml-hot-codeop st op args proto)
      (try (do
             (let [a (.a st)
                   n (len (load args))
                   (mut chain)
                     (ml-call0 st "coil.compiler.metashim.mp-arg-new" proto)
                   (mut i) 0
                   (mut diverged) (None [Expr])
                   (mut evald) (ArrayList::new [Expr] a)]
               (loop (if (>= (load i) n)
                         (break)
                         (do
                           (let [ap (elem args (load i))
                                 t (try! (ml-node-type st ap))
                                 k (let [(mut tp) t] (ml-kind-of-type (mut tp)))
                                 le (try! (ml-expr st ap))]
                             (cond (= k 6)  ; never-typed argument: evaluate the chain so far, then it
                                     (do
                                       (push! (mut evald) (load chain))
                                       (push! (mut evald) le)
                                       (set! diverged
                                             (Some (mk-expr (EDo (box-al [Expr]
                                                                         a
                                                                         (load evald)))
                                                            (.lo proto)
                                                            (.hi proto)
                                                            (.source proto)
                                                            (.ctxt proto))))
                                       (break))
                                   (= k 1)
                                     (set! chain
                                           (ml-call2 st
                                                     "coil.compiler.metashim.mp-arg-c"
                                                     (load chain)
                                                     le
                                                     proto))
                                   (= k 2)
                                     (set! chain
                                           (ml-call2 st
                                                     "coil.compiler.metashim.mp-arg-i"
                                                     (load chain)
                                                     (ml-widen-int st
                                                                   t
                                                                   le
                                                                   proto)
                                                     proto))
                                   (= k 3)
                                     (set! chain
                                           (ml-call2 st
                                                     "coil.compiler.metashim.mp-arg-s"
                                                     (load chain)
                                                     le
                                                     proto))
                                   (= k 4)
                                     (set! chain
                                           (ml-call2 st
                                                     "coil.compiler.metashim.mp-arg-b"
                                                     (load chain)
                                                     le
                                                     proto))
                                   (= k 5)
                                     (set! chain
                                           (ml-call2 st
                                                     "coil.compiler.metashim.mp-arg-f"
                                                     (load chain)
                                                     (ml-widen-float st
                                                                     t
                                                                     le
                                                                     proto)
                                                     proto))
                                   :else
                                     (break
                                       :try
                                         (Err [Expr Diag]
                                              (derr-at-src (.source ap)
                                                           (.lo ap)
                                                           (.hi ap)
                                                           "metalower: this value cannot cross into a code op (only Code, integers, bools, floats and (slice u8) can; the interpreter rejects it at run time too)"))))
                             (set! i (primitive/iadd (load i) 1))))))
               (match (load diverged)
                 (Some [de] (Ok [Expr Diag] de))
                 (None []
                       (let [opx (ml-int st op proto)]
                         ; result shape = codeop-rty (check.coil), the op's static type
                         (match (codeop-rty op)
                           (TNever []
                                   (Ok [Expr Diag]
                                       (ml-do2 st
                                               (ml-op-call st
                                                           op
                                                           "coil.compiler.metashim.mp-op-int"
                                                           opx
                                                           (load chain)
                                                           proto)
                                               (ml-diverge st proto)
                                               proto)))
                           (TBool []
                                  (Ok [Expr Diag]
                                      (ml-op-call st
                                                  op
                                                  "coil.compiler.metashim.mp-op-bool"
                                                  opx
                                                  (load chain)
                                                  proto)))
                           (TInt [b s]
                                 (Ok [Expr Diag]
                                     (ml-op-call st
                                                 op
                                                 "coil.compiler.metashim.mp-op-int"
                                                 opx
                                                 (load chain)
                                                 proto)))
                           (TSlice [e]
                                   (Ok [Expr Diag]
                                       (ml-op-call st
                                                   op
                                                   "coil.compiler.metashim.mp-op-str"
                                                   opx
                                                   (load chain)
                                                   proto)))
                           ; an answer crosses as Code (metahost answer->sexp) and
                           ; becomes the sum again in the metaprogram
                           (TStruct [sum]
                                    (Ok [Expr Diag]
                                        (ml-call1 st
                                                  (ml-answer-decoder st sum)
                                                  (ml-op-call st
                                                              op
                                                              "coil.compiler.metashim.mp-op-code"
                                                              opx
                                                              (load chain)
                                                              proto)
                                                  proto)))
                           (_ (Ok [Expr Diag]
                                  (ml-op-call st
                                              op
                                              "coil.compiler.metashim.mp-op-code"
                                              opx
                                              (load chain)
                                              proto))))))))))))

;;; ---- answers ------------------------------------------------------------------
;;; A code operation whose primitive declares the sum it answers with returns, across
;;; the boundary, the Code `(K FIELD…)` comptime.coil's answer->sexp encodes: K is the
;;; variant's position in the sum's declaration. The decoder for a sum is a function
;;; of this program, generated once from that declaration, that rebuilds the value:
;;;   (if (= K 0) (V0 …) (if (= K 1) (V1 (nth 1) …) … error))
;;; A Code field is the handle at its position; a sum field is decoded by that sum's
;;; own decoder.
(defn ml-answer-decoder-name [(st (ptr MLS)) (sum (slice u8))] (-> (slice u8))
  (let [a (.a st)
        prefix "coil.compiler.metashim.answer-"
        (mut out) (ArrayList::new [u8] a)]
    (for [i 0 (len prefix)] (push! (mut out) (get prefix i)))
    ; the sum's own dots would read as module separators
    (for [i 0 (len sum)]
      (let [c (get sum i)]
        (push! (mut out) (if (= c (: 46 u8)) (: 45 u8) c))))
    (slice (load out))))

(defn ml-answer-decoder [(st (ptr MLS)) (sum (slice u8))] (-> (slice u8))
  (let [name (ml-answer-decoder-name st sum)]
    (unless (block :found
              (for [i 0 (len (load (.answers st)))]
                (when (= (.name (elem (.answers st) i)) name)
                  (break :found true)))
              false)
      (ml-answer-decoder-build! st sum name))
    name))

(defn ml-answer-decoder-build! [(st (ptr MLS))
                                (sum (slice u8))
                                (name (slice u8))] (-> i64)
  (let [a (.a st)
        sd
          (block :found
            (for [i 0 (len (load (.sums st)))]
              (when (= (.name (elem (.sums st) i)) sum)
                (break :found (elem (.sums st) i))))
            (primitive/cast (ptr SumDef) 0))]
    (when (= (primitive/cast i64 sd) 0)
      ; the checker refused a code operation whose answer type is not a sum
      (let [w (stderr)]
        (ps w "internal error: metalower: answer type '")
        (ps w sum)
        (ps w "' is not a sum of the checked program\n")
        (abort)))
    ; Register the function before decoding its fields, so a sum that reaches
    ; itself through a field names this decoder rather than building another.
    (let [(mut f) (zeroed Func)
          proto (box! a Expr (mk-expr (EInt 0) -1 -1 -1 0))
          (mut params) (ArrayList::new [Param] a)
          (mut body) (ArrayList::new [Expr] a)]
      (push! (mut params)
             (Param
               :name "answer"
               :ty (ml-code-ty a)
               :bid 0
               :owned_type (primitive/cast (ptr Type) 0)
               :positional_only false))
      (set! f (zeroed Func))
      (set! (.name f) name)
      (set! (.type_params f)
            (box-al [(slice u8)] a (ArrayList::new [(slice u8)] a)))
      (set! (.bounds f) (box-al [Bound] a (ArrayList::new [Bound] a)))
      (set! (.cc f) (cc-c))
      (set! (.annotations f)
            (box-al [Annotation] a (ArrayList::new [Annotation] a)))
      (set! (.params f) (box-al [Param] a (load params)))
      (set! (.ret f) (TStruct sum))
      (set! (.body f) (box-al [Expr] a (load body)))
      (set! (.lo f) -1)
      (set! (.hi f) -1)
      (set! (.source f) -1)
      (set! (.ctxt f) 0)
      (push! (.answers st) f)
      (let [index (primitive/isub (len (load (.answers st))) 1)
            decoded (ml-answer-arms st sum sd 0 proto)]
        (push! (mut body) decoded)
        (set! (.body (elem (.answers st) index)) (box-al [Expr] a (load body))))
      0)))

(defn ml-answer-handle [(st (ptr MLS)) (proto (ptr Expr))] (-> Expr)
  (expr-at proto (EVar "answer")))

;;; The handle's item at POSITION.
(defn ml-answer-item [(st (ptr MLS)) (position i64) (proto (ptr Expr))]
  (-> Expr)
  (ml-call2 st
            "coil.compiler.metashim.mp-code-nth"
            (ml-answer-handle st proto)
            (ml-int st position proto)
            proto))

;;; The variant arms from the K-th on.
(defn ml-answer-arms [(st (ptr MLS))
                      (sum (slice u8))
                      (sd (ptr SumDef))
                      (k i64)
                      (proto (ptr Expr))] (-> Expr)
  (let [a (.a st)
        variants (.variants sd)]
    (if (>= k (len (load variants)))
        ; answer->sexp only encodes a declared variant
        (ml-do2 st
                (ml-call2 st
                          "coil.compiler.metashim.mp-op-int"
                          (ml-int st 9 proto)
                          (ml-call2 st
                                    "coil.compiler.metashim.mp-arg-s"
                                    (ml-call0 st
                                              "coil.compiler.metashim.mp-arg-new"
                                              proto)
                                    (expr-at proto
                                             (EStr (text/format a
                                                                "internal error: an answer of '{}' names no variant it declares"
                                                                sum)))
                                    proto)
                          proto)
                (ml-diverge st proto)
                proto)
        (let [v (elem variants k)
              (mut fields) (ArrayList::new [Expr] a)
              tag
                (ml-call2 st
                          "coil.compiler.metashim.mp-op-int"
                          (ml-int st 6 proto)
                          (ml-call2 st
                                    "coil.compiler.metashim.mp-arg-c"
                                    (ml-call0 st
                                              "coil.compiler.metashim.mp-arg-new"
                                              proto)
                                    (ml-answer-item st 0 proto)
                                    proto)
                          proto)]
          (for [i 0 (len (load (.fields v)))]
            (let [item (ml-answer-item st (+ i 1) proto)]
              (push! (mut fields)
                     (match (.ty (elem (.fields v) i))
                       (TStruct [inner]
                                (ml-call1 st
                                          (ml-answer-decoder st inner)
                                          item
                                          proto))
                       (_ item))))
            0)
          (expr-at proto
                   (EIf
                     :cnd
                       (box-expr a
                                 (mk-expr (ECmp
                                            :op 4
                                            :lhs (box-expr a tag)
                                            :rhs
                                              (box-expr a
                                                        (ml-int st k proto)))
                                          (.lo proto)
                                          (.hi proto)
                                          (.source proto)
                                          (.ctxt proto)))
                     :thn
                       (box-expr a
                                 (mk-expr (ECall
                                            :func (.name v)
                                            :type_args
                                              (box-al [Type]
                                                      a
                                                      (ArrayList::new [Type]
                                                                      a))
                                            :args
                                              (box-al [Expr]
                                                      a
                                                      (load fields)))
                                          (.lo proto)
                                          (.hi proto)
                                          (.source proto)
                                          (.ctxt proto)))
                     :els (box-expr a (ml-answer-arms st sum sd (+ k 1) proto))))))))

;; Explicitly opt-in artifact contract. Unknown future operations must be reviewed
;; instead of silently acquiring an empty authoritative semantic context.
(defn syntax-provider-codeop? [(op i64)] (-> bool)
  (or (= op 81)
      (and (>= op 0) (<= op 13))
      (and (>= op 28) (<= op 34))
      (and (>= op 38) (<= op 46))
      (and (>= op 54) (<= op 74))))

; ---- quote/quasiquote ---------------------------------------------------------------
; The registry OWNS its nodes: `form` points into the checked program being
; lowered, and an engine build may outlive that program (staged metacompilation
; compiles phase programs in a disposable arena; only the engine image and this
; registry survive it). A shared pointer here is the "premature freeing created
; dangling registries" failure the staged-metacompilation experiment recorded —
; deep-copy, string payloads included, into the engine build's allocator.
;
; The hygiene stamp goes on BEFORE the copy, so the owned node carries it: the
; registry's copy is what the metaprogram will actually see.
(defn ml-quoted [(st (ptr MLS))
                 (form (ptr Sexp))
                 (hyg Expr)
                 (stamp bool)
                 (proto (ptr Expr))] (-> Expr)
  (let [a (.a st)
        k (len (load (load (field st reg))))
        (mut owned)
          (:  ; Stamp the registry's own copy. `form` belongs to the function being lowered,
             ; which in a retained session is an accepted, shared body.
             (sexp-own-into a form)
             Sexp)]
    (ml-mark-introduced! (mut owned))
    (when stamp (set! (.hmod owned) (hmod-intern (.qmodule st))))
    (push! [(ptr Sexp)] (load (field st reg)) (box-sexp a owned))
    (ml-call2 st
              "coil.compiler.metashim.mp-quoted"
              (ml-int st k proto)
              hyg
              proto)))

;;; Quoted and template syntax is the metaprogram's own: its spans are the
;;; metaprogram's source. Mark it introduced (origin 1), so a quasiquote that puts
;;; it in a list does not take it for syntax transported out of the program being
;;; compiled (reader.coil's `sexp-transported`). Only a symbol was marked, by the
;;; per-evaluation stamp (mh-stamp-ident!); a keyword, number or string, or a
;;; constant list, passed for the author's, and a lint suggestion was rendered from
;;; the bytes at its span in whichever of the program's files had the metaprogram
;;; source's number: `(: x T)`, whose `:` is a keyword, came out `(  x T)`. A symbol
;;; is left to that stamp.
(defn ml-mark-introduced! [(s (ptr Sexp))] (-> i64)
  (match (.kind s)
    (KSym [_] 0)
    (KList [items] (do (set! (.horigin s) 1) (ml-mark-items-introduced! items)))
    (KVec [items] (do (set! (.horigin s) 1) (ml-mark-items-introduced! items)))
    (_ (do (set! (.horigin s) 1) 0))))

(defn ml-mark-items-introduced! [(items (ptr (ArrayList Sexp)))] (-> i64)
  (for [i 0 (len (load items))]
    (ml-mark-introduced! (elem items i)))
  0)

; An unquoted or spliced operand names a value. A `(mut x)` local is a reference
; to its cell, so read through the reference: `~@b` for a mutable CodeBuilder
; splices the builder, exactly as it does for an immutable one.
(defstruct MlOperand [(t Type) (e Expr)])

(defn ml-quasi-operand [(st (ptr MLS)) (e (ptr Expr))]
  (-> (Result MlOperand Diag))
  (try (let [t (try! (ml-node-type st e))
             le (try! (ml-expr st e))]
         (Ok [MlOperand Diag]
             (match t
               (TRef [_ inner]
                     (MlOperand
                       :t (load inner)
                       :e (ml-rewrap e (ELoad (box-expr (.a st) le)))))
               (_ (MlOperand :t t :e le)))))))

(defn ml-unquote [(st (ptr MLS)) (e (ptr Expr)) (proto (ptr Expr))]
  (-> (Result Expr Diag))
  (try (do
         (let [operand (try! (ml-quasi-operand st e))
               t (.t operand)
               k (let [(mut tp) t] (ml-kind-of-type (mut tp)))
               le (.e operand)]
           (cond (= k 1) (Ok [Expr Diag] le)
                 (= k 2)
                   (Ok [Expr Diag]
                       (ml-call1 st
                                 "coil.compiler.metashim.mp-unq-int"
                                 (ml-widen-int st t le proto)
                                 proto))
                 (= k 4)
                   (Ok [Expr Diag]
                       (ml-call1 st
                                 "coil.compiler.metashim.mp-unq-bool"
                                 le
                                 proto))
                 (= k 5)
                   (Ok [Expr Diag]
                       (ml-call1 st
                                 "coil.compiler.metashim.mp-unq-float"
                                 (ml-widen-float st t le proto)
                                 proto))
                 (= k 3)
                   (Ok [Expr Diag]
                       (ml-call1 st
                                 "coil.compiler.metashim.mp-unq-str"
                                 le
                                 proto))
                 (= k 6) (Ok [Expr Diag] le)
                 :else  ; aggregate: evaluate it (side effects first, like the interpreter's
                   ; eval-then-convert), then fail with ctval->sexp's own message
                   (Ok [Expr Diag]
                       (ml-do2 st
                               le
                               (ml-parity-fail st 1 e)
                               proto)))))))

; the builder chain for a quasi list/vector's items
(defn ml-quasi-items [(st (ptr MLS))
                      (items (ptr (ArrayList Quasi)))
                      (hyg Expr)
                      (proto (ptr Expr))] (-> (Result Expr Diag))
  (try (do
         (let [a (.a st)
               n (len (load items))
               (mut chain)
                 (ml-call0 st "coil.compiler.metashim.mp-qq-new" proto)]
           (for [i 0 n]
             (let [qp (elem items i)]
               (match (load qp)
                 (QSplice [e]
                          (let [operand (try! (ml-quasi-operand st e))
                                k
                                  (let [(mut tp) (: (.t operand) Type)]
                                    (ml-kind-of-type (mut tp)))
                                le (.e operand)]
                            (if (= k 1)
                                (set! chain
                                      (ml-call2 st
                                                "coil.compiler.metashim.mp-qq-splice"
                                                (load chain)
                                                le
                                                proto))
                                (if (= k 6)
                                    (set! chain
                                          (ml-do2 st
                                                  (load chain)
                                                  le
                                                  proto))
                                    ; non-Code splice value: evaluate, then the interpreter's error
                                    (set! chain
                                          (ml-do2 st
                                                  (ml-do2 st
                                                          (load chain)
                                                          le
                                                          proto)
                                                  (ml-parity-fail st
                                                                  2
                                                                  e)
                                                  proto))))))
                 (_ (store! chain
                            (ml-call2 st
                                      "coil.compiler.metashim.mp-qq-push"
                                      (load chain)
                                      (try! (ml-quasi st qp hyg proto))
                                      proto))))))
           (Ok [Expr Diag] (load chain))))))

(defn ml-quasi [(st (ptr MLS)) (q (ptr Quasi)) (hyg Expr) (proto (ptr Expr))]
  (-> (Result Expr Diag))
  (try (do
         (match (load q)
           (QLit [fp] (Ok [Expr Diag] (ml-quoted st fp hyg true proto)))
           (QUnquote [e] (ml-unquote st e proto))
           (QSplice [e]
                    ; a top-level ~@: the interpreter rejects it when evaluated, before
                    ; evaluating e — same here
                    (Ok [Expr Diag]
                        (ml-parity-fail st 3 e)))
           (QList [items]
                  (let [chain (try! (ml-quasi-items st items hyg proto))]
                    (Ok [Expr Diag]
                        (ml-call1 st
                                  "coil.compiler.metashim.mp-qq-list"
                                  chain
                                  proto))))
           (QVector [items]
                    (let [chain (try! (ml-quasi-items st items hyg proto))]
                      (Ok [Expr Diag]
                          (ml-call1 st
                                    "coil.compiler.metashim.mp-qq-vec"
                                    chain
                                    proto))))))))

; Give every dynamic quasiquote evaluation one lexical introduction identity.
; Literal atoms receive it; unquoted and spliced Code retains its prior identity.
(defn ml-quasi-root [(st (ptr MLS)) (q (ptr Quasi)) (proto (ptr Expr))]
  (-> (Result Expr Diag))
  (try (let [a (.a st)
             name (text/format a "$qqscope{}" (dec->str a (.node-id proto)))
             value (ml-call0 st "coil.compiler.metashim.mp-scope-new" proto)
             href (expr-at proto (EVar name))
             body (try! (ml-quasi st q href proto))
             b (primitive/alloc-stack Bind)
             (mut binds) (ArrayList::new [Bind] a)
             (mut bodies) (ArrayList::new [Expr] a)]
         (set! (.name b) name)
         (set! (.mutable b) false)
         (set! (.value b) value)
         (set! (.bid b) 0)
         (set! (.owned_type b) (primitive/cast (ptr Type) 0))
         (push! (mut binds) (load b))
         (push! (mut bodies) body)
         (Ok [Expr Diag]
             (expr-at proto
                      (ELet (box-al [Bind] a (load binds))
                            (box-al [Expr] a (load bodies))))))))

; ---- the expression walk -------------------------------------------------------------
(defn ml-expr-list [(st (ptr MLS)) (es (ptr (ArrayList Expr)))]
  (-> (Result (ptr (ArrayList Expr)) Diag))
  (try (do
         (let [a (.a st)
               n (len (load es))
               (mut out) (ArrayList::new [Expr] a)]
           (for [i 0 n]
             (push! (mut out)
                    (match (ml-expr st (elem es i))
                      (Ok [temporary] temporary)
                      (Err [temporary] (break :try (Err temporary))))))
           (Ok [(ptr (ArrayList Expr)) Diag] (box-al [Expr] a (load out)))))))

(defn ml-rewrap [(proto (ptr Expr)) (k ExprKind)] (-> Expr)
  (expr-with-kind proto k))

(defstruct MlMapper [(state (ptr MLS))])

(impl am/AstMapper MlMapper
  (mapper-allocator [(self (ptr MlMapper))] (-> (dyn Allocator))
    (.a (.state self)))
  (map-expression [(self (ptr MlMapper)) (value (ptr Expr))]
    (-> (Result Expr Diag))
    (ml-expr (.state self) value))
  (map-type [(self (ptr MlMapper)) (value Type)] (-> (Result Type Diag))
    (let [(mut ty) value]
      (Ok (ml-type (.a (.state self)) (mut ty)))))
  (map-expressions [(self (ptr MlMapper)) (values (ptr (ArrayList Expr)))]
    (-> (Result (ptr (ArrayList Expr)) Diag))
    (am/map-expression-elements self values))
  (map-types [(self (ptr MlMapper)) (values (ptr (ArrayList Type)))]
    (-> (Result (ptr (ArrayList Type)) Diag))
    (am/map-type-elements self values))
  (map-bindings [(self (ptr MlMapper)) (values (ptr (ArrayList Bind)))]
    (-> (Result (ptr (ArrayList Bind)) Diag))
    (am/map-binding-elements self values)))

(defn ml-expr [(st (ptr MLS)) (e (ptr Expr))] (-> (Result Expr Diag))
  (try (match (.kind e)
         (ECodeOp [op args] (ml-codeop st op args e))
         (EQuote [form]
                 (Ok [Expr Diag]
                     (ml-quoted st form (ml-int st 0 e) false e)))
         (EQuasi [q]
                 (let [(mut qp) q] (ml-quasi-root st (mut qp) e)))
         (EComptime [inner]
                    (Err [Expr Diag]
                         (derr-at-src (.source e)
                                      (.lo e)
                                      (.hi e)
                                      "metalower: (comptime ...) survived the check fold (compiler bug)")))
         ; These source/check-only nodes were deliberately left untouched by this
         ; pass. Their owners must lower them before metaprogram code generation.
         (ENamedCall [_ _ _ _] (Ok (load e)))
         (EAccessorField [_ _] (Ok (load e)))
         (EAscribe [_ _] (Ok (load e)))
         (EArrayLit [_] (Ok (load e)))
         (EAnonFn [_ _] (Ok (load e)))
         (EConstParam [_ _] (Ok (load e)))
         (EBracketCall [_ _ _ _] (Ok (load e)))
         (EFnPtrInst [_ _] (Ok (load e)))
         (_ (let [(mut mapper) (MlMapper :state st)]
              (Ok (ml-rewrap e (try! (am/map-kind (mut mapper) (.kind e))))))))))

; ---- funcs / defs / the whole program ----------------------------------------------
(defn ml-params [(a (dyn Allocator)) (ps (ptr (ArrayList Param)))]
  (-> (ptr (ArrayList Param)))
  (let [n (len (load ps))
        (mut out) (ArrayList::new [Param] a)]
    (for [i 0 n]
      (let [pp (elem ps i)
            (mut np) (zeroed Param)]
        (set! (.name np) (.name pp))
        (set! (.positional_only np) (.positional_only pp))
        (set! (.ty np) (ml-type a (field pp ty)))
        (set! (.bid np) (.bid pp))
        ; Ownership retains the semantic pre-ABI parameter type in a
        ; second slot.  Leaving that slot as TCode lets mono restore a
        ; phase-only type after the ordinary parameter was lowered,
        ; most visibly for generated constructors of structs that
        ; contain Code.
        (set! (.owned_type np)
              (if (= (primitive/cast i64 (.owned_type pp)) 0)
                  (primitive/cast (ptr Type) 0)
                  (box-type a (ml-type a (.owned_type pp)))))
        (push! (mut out) np)))
    (box-al [Param] a (load out))))

(defn ml-fields [(a (dyn Allocator)) (fs (ptr (ArrayList Field)))]
  (-> (ptr (ArrayList Field)))
  (let [n (len (load fs))
        (mut out) (ArrayList::new [Field] a)]
    (for [i 0 n]
      (let [fp (elem fs i)
            (mut nf) (zeroed Field)]
        (set! (.name nf) (.name fp))
        (set! (.ty nf) (ml-type a (field fp ty)))
        (push! (mut out) nf)))
    (box-al [Field] a (load out))))

(defn ml-func [(st (ptr MLS)) (f (ptr Func))] (-> (Result Func Diag))
  (try (do
         (let [a (.a st)
               (mut nf) (zeroed Func)]
           ; Resolved function names are module-qualified.  The quote's lexical
           ; context follows this definition even when another module calls it.
           (store! (field st qmodule)
                   (let [name (.name f)
                         n (len name)
                         (mut i) (primitive/isub n 1)
                         (mut dot) -1]
                     (loop (if (< (load i) 0)
                               (break)
                               (do
                                 (when (and (< (load dot)
                                               0)
                                            (= (primitive/cast i64
                                                               (get name
                                                                    (load i)))
                                               46))
                                   (set! dot (load i)))
                                 (set! i (primitive/isub (load i) 1)))))
                     (if (< (load dot) 0)
                         ""
                         (subslice name 0 (load dot)))))
           (set! nf (load f))
           (set! (.params nf) (ml-params a (load (field f params))))
           (set! (.ret nf) (ml-type a (field f ret)))
           (set! (.body nf)
                 (match (ml-expr-list st (load (field f body)))
                   (Ok [value] value)
                   (Err [error] (break :try (Err error)))))
           (Ok [Func Diag] nf)))))

(defn ml-funcs [(st (ptr MLS)) (fs (ptr (ArrayList Func)))]
  (-> (Result (ptr (ArrayList Func)) Diag))
  (try (do
         (let [a (.a st)
               n (len (load fs))
               (mut out) (ArrayList::new [Func] a)]
           (for [i 0 n]
             (push! (mut out)
                    (match (ml-func st (elem fs i))
                      (Ok [temporary] temporary)
                      (Err [temporary] (break :try (Err temporary))))))
           (Ok [(ptr (ArrayList Func)) Diag] (box-al [Func] a (load out)))))))

; The checker names each trait impl function from its source-level Self type. Metalower
; then erases Code/CodeBuilder to (ptr i8), and generic trait calls are resolved by
; mono from that lowered receiver type. Keep the checked name for already-resolved
; concrete ECalls, and add the same lowered function under the name generic dispatch
; will request. Only the two opaque source types need this: recursively lowered
; ordinary impl types retain their normal generic mangling behavior.
(defn ml-direct-code-type? [(tp (ptr Type))] (-> bool)
  (match (load tp)
    (TCode [] true)
    (TCodeBuilder [] true)
    (_ false)))

(defn ml-func-index [(funcs (ArrayList Func)) (name (slice u8))] (-> i64)
  (let [n (len funcs)
        (mut found) -1]
    (for [i 0 n]
      (when (= (func-name (get funcs i)) name)
        (set! found i)
        (break)))
    (load found)))

(defn ml-add-impl-alias! [(st (ptr MLS))
                          (ip (ptr ImplDef))
                          (method (ptr Func))
                          (funcs (mut (ArrayList Func)))] (-> (Result i64 Diag))
  (try (do
         (let [a (.a st)
               params (load (field ip type_params))
               old-key (impl-mangle-key a (field ip self_type) params)
               (mut lowered-type) (ml-type a (field ip self_type))]
           (let [new-key (impl-mangle-key a (mut lowered-type) params)
                 old-name (tmfn a (impl-trait-name ip) old-key (.name method))
                 new-name (tmfn a (impl-trait-name ip) new-key (.name method))]
             ; Code and CodeBuilder erase to the same pointer. If future
             ; capabilities make their lowered names collide, reject that program
             ; instead of depending on impl order.
             (when (>= (ml-func-index (load funcs) new-name) 0)
               (break
                 :try
                   (Err [i64 Diag]
                        (derr (text/format a
                                           "metalower: lowered Code trait impl name collision at '{}'"
                                           new-name)))))
             ; A direct concrete call already made the source-mangled function
             ; closure-reachable. A generic-only call did not, so lower the retained
             ; impl method here and publish both names.
             (let [old-i (ml-func-index (load funcs) old-name)
                   source
                     (if (>= old-i 0)
                         (get (load funcs) old-i)
                         (try! (ml-func st method)))
                   (mut old-fn) (: source Func)
                   (mut alias) (zeroed Func)]
               (set! (.name old-fn) old-name)
               (when (< old-i 0) (push! [Func] (mut funcs) old-fn))
               (set! alias source)
               (set! (.name alias) new-name)
               (push! [Func] (mut funcs) alias)
               (Ok [i64 Diag] 0)))))))

(defn ml-add-impl-aliases! [(st (ptr MLS))
                            (impls (ptr (ArrayList ImplDef)))
                            (funcs (mut (ArrayList Func)))]
  (-> (Result i64 Diag))
  (try (do
         (let [ni (len (load impls))
               (mut i) 0]
           (loop (if (>= (load i) ni)
                     (break)
                     (do
                       (let [ip (elem impls (load i))]
                         (when (and (impl-is-trait ip)
                                    (ml-direct-code-type? (field ip self_type)))
                           (let [methods (load (field ip methods))
                                 nm (len (load methods))
                                 (mut j) 0]
                             (loop (if (>= (load j) nm)
                                       (break)
                                       (do
                                         (try! (ml-add-impl-alias! st
                                                                   ip
                                                                   (elem methods
                                                                         (load j))
                                                                   (mut funcs)))
                                         (set! j (primitive/iadd (load j) 1)))))))
                         (set! i (primitive/iadd (load i) 1)))))))
         (Ok [i64 Diag] 0))))

(defn ml-structs [(a (dyn Allocator)) (ss (ptr (ArrayList StructDef)))]
  (-> (ptr (ArrayList StructDef)))
  (let [n (len (load ss))
        (mut out) (ArrayList::new [StructDef] a)]
    (for [i 0 n]
      (let [sp (elem ss i)
            ns (primitive/alloc-stack StructDef)]
        (set! ns (load sp))
        (set! (.fields ns) (ml-fields a (load (field sp fields))))
        (push! (mut out) (load ns))))
    (box-al [StructDef] a (load out))))

(defn ml-sums [(a (dyn Allocator)) (ss (ptr (ArrayList SumDef)))]
  (-> (ptr (ArrayList SumDef)))
  (let [n (len (load ss))
        (mut out) (ArrayList::new [SumDef] a)]
    (for [i 0 n]
      (let [sp (elem ss i)
            (mut ns) (: (load sp) SumDef)
            vs (load (field sp variants))
            nv (len (load vs))
            (mut vout) (ArrayList::new [Variant] a)]
        (for [j 0 nv]
          (let [vp (elem vs j)
                (mut nvr) (zeroed Variant)]
            (set! (.name nvr) (.name vp))
            (set! (.fields nvr)
                  (ml-fields a
                             (load (field vp
                                          fields))))
            (push! (mut vout) nvr)))
        (set! (.variants ns) (box-al [Variant] a (load vout)))
        (push! (mut out) ns)))
    (box-al [SumDef] a (load out))))

(defn ml-externs [(a (dyn Allocator)) (es (ptr (ArrayList Extern)))]
  (-> (ptr (ArrayList Extern)))
  (let [n (len (load es))
        (mut out) (ArrayList::new [Extern] a)]
    (for [i 0 n]
      (let [ep (elem es i)
            ne (primitive/alloc-stack Extern)]
        (set! ne (load ep))
        (set! (.params ne) (ml-type-list a (load (field ep params))))
        (set! (.ret ne) (ml-type a (field ep ret)))
        (push! (mut out) (load ne))))
    (box-al [Extern] a (load out))))

(defn ml-consts [(st (ptr MLS)) (cs (ptr (ArrayList Const)))]
  (-> (Result (ptr (ArrayList Const)) Diag))
  (try (do
         (let [a (.a st)
               n (len (load cs))
               (mut out) (ArrayList::new [Const] a)]
           (for [i 0 n]
             (let [cp (elem cs i)
                   nc (primitive/alloc-stack Const)]
               (set! nc (load cp))
               (set! (.ty nc) (ml-type-opt a (.ty cp)))
               (set! (.value nc)
                     (match (ml-expr st (field cp value))
                       (Ok [value] value)
                       (Err [error] (break :try (Err error)))))
               (push! (mut out) (load nc))))
           (Ok [(ptr (ArrayList Const)) Diag] (box-al [Const] a (load out)))))))

(defn ml-traits [(a (dyn Allocator)) (ts (ptr (ArrayList TraitDef)))]
  (-> (ptr (ArrayList TraitDef)))
  (let [n (len (load ts))
        (mut out) (ArrayList::new [TraitDef] a)]
    (for [i 0 n]
      (let [tp (elem ts i)
            (mut nt) (: (load tp) TraitDef)
            ms (load (field tp methods))
            nm (len (load ms))
            (mut mout) (ArrayList::new [TraitMethod] a)]
        (for [j 0 nm]
          (let [mp (elem ms j)
                (mut nmr) (zeroed TraitMethod)]
            (set! (.name nmr) (.name mp))
            (set! (.annotations nmr) (load (field mp annotations)))
            (set! (.params nmr)
                  (ml-params a
                             (load (field mp
                                          params))))
            (set! (.ret nmr) (ml-type a (field mp ret)))
            (push! (mut mout) nmr)))
        (set! (.methods nt) (box-al [TraitMethod] a (load mout)))
        (push! (mut out) nt)))
    (box-al [TraitDef] a (load out))))

(defn ml-impls [(st (ptr MLS)) (is (ptr (ArrayList ImplDef)))]
  (-> (Result (ptr (ArrayList ImplDef)) Diag))
  (try (do
         (let [a (.a st)
               n (len (load is))
               (mut out) (ArrayList::new [ImplDef] a)]
           (for [i 0 n]
             (let [ip (elem is i)
                   ni (primitive/alloc-stack ImplDef)]
               (set! ni (load ip))
               (set! (.self_type ni) (ml-type a (field ip self_type)))
               ; Trait indexing uses for_type, while symbol mangling uses
               ; self_type. Keep both views of the lowered receiver in
               ; sync so ptr dispatch selects the impl whose alias was
               ; emitted under the lowered self-type key.
               (set! (.for_type ni)
                     (impl-base-name a (field ni self_type)))
               (set! (.methods ni)
                     (match (ml-funcs st
                                      (load (field ip
                                                   methods)))
                       (Ok [value] value)
                       (Err [error] (break :try (Err error)))))
               (push! (mut out) (load ni))))
           (Ok [(ptr (ArrayList ImplDef)) Diag] (box-al [ImplDef] a (load out)))))))

;;; The most parameters an entry is called with directly; metaengine passes one with
;;; more as a single argument array (`ml-argv-adapter!`).
(defn ml-direct-entry-params [] (-> i64)
  8)

;;; The adapter of the entry Q (`ml-argv-adapter!`): Q's own module, a name no
;;; identifier can spell.
(defn ml-argv-adapter-name [(a (dyn Allocator)) (q (slice u8))] (-> (slice u8))
  (text/format a "{}$argv" q))

;;; The function to export for the entry Q of P. One of more than
;;; `ml-direct-entry-params` parameters is reached through an adapter added to P,
;;; which takes the argument handles as one (ptr (ptr i8)) and passes each to Q.
;;; Otherwise Q itself.
;;; FUNCS indexes P's functions by name.
(defn ml-argv-adapter! [(a (dyn Allocator))
                        (p (ptr Program))
                        (funcs (ref (HashMap (slice u8) i64)))
                        (q (slice u8))] (-> (slice u8))
  (let [fi (match (get funcs q) (Some [i] i) (None [] -1))]
    (if (or (< fi 0)
            (<= (len (load (.params (elem (.funcs p) fi))))
                (ml-direct-entry-params)))
        q
        (let [entry (elem (.funcs p) fi)
              n (len (load (.params entry)))
              name (ml-argv-adapter-name a q)
              (mut f) (zeroed Func)
              argv-ty (TPtr (box-type a (ml-code-ty a)))
              (mut params) (ArrayList::new [Param] a)
              (mut args) (ArrayList::new [Expr] a)
              (mut body) (ArrayList::new [Expr] a)]
          (push! (mut params)
                 (Param
                   :name "args"
                   :ty argv-ty
                   :bid 0
                   :owned_type (primitive/cast (ptr Type) 0)
                   :positional_only false))
          (for [k 0 n]
            (let [(mut at) (ArrayList::new [Expr] a)]
              (push! (mut at) (mk-expr (EVar "args") -1 -1 -1 0))
              (push! (mut at) (mk-expr (EInt k) -1 -1 -1 0))
              (push! (mut args)
                     (mk-expr (ECall
                                :func "coil.compiler.metashim.mp-argv-at"
                                :type_args
                                  (box-al [Type] a (ArrayList::new [Type] a))
                                :args (box-al [Expr] a (load at)))
                              -1
                              -1
                              -1
                              0))))
          (push! (mut body)
                 (mk-expr (ECall
                            :func q
                            :type_args
                              (box-al [Type] a (ArrayList::new [Type] a))
                            :args (box-al [Expr] a (load args)))
                          -1
                          -1
                          -1
                          0))
          (set! f (load entry))
          (set! (.name f) name)
          (set! (.annotations f)
                (box-al [Annotation] a (ArrayList::new [Annotation] a)))
          (set! (.params f) (box-al [Param] a (load params)))
          (set! (.body f) (box-al [Expr] a (load body)))
          (set! (.macro_variadic f) false)
          (set! (.declared f) false)
          (set! (.lazy f) (primitive/cast (ptr i8) 0))
          (push! (.funcs p) f)
          name))))

; entry exports: one C symbol per metaprogram function; params left empty like the
; parser's own export-c records (codegen derives the thunk from the Func itself)
(defn ml-exports [(a (dyn Allocator))
                  (p (ptr Program))
                  (quals (ptr (ArrayList (slice u8))))]
  (-> (ptr (ArrayList MLEntry)))
  ; the vtable-handshake entry (metashim.coil mp-init) — closure-subprogram builds
  ; the sub-program with empty exports, so the shim's record is re-created here
  (let [ip (primitive/alloc-stack ExportC)]
    (set! (.name ip) "coil.compiler.metashim.mp-init")
    (set! (.symbol ip) (Some "coil_mp_init"))
    (set! (.params ip) (box-al [Type] a (ArrayList::new [Type] a)))
    (set! (.published ip) true)
    (set! (.lo ip) -1)
    (set! (.hi ip) -1)
    (set! (.source ip) -1)
    (set! (.ctxt ip) 0)
    (push! [ExportC] (load (field p exports)) (load ip)))
  (let [n (len (load quals))
        (mut entries) (ArrayList::new [MLEntry] a)
        ; the program's functions by name, before any adapter is added
        (mut funcs) (HashMap::new [(slice u8) i64] a (keyops-borrowed))
        (mut i) 0]
    (for [k 0 (len (load (.funcs p)))]
      (set! (mut funcs) (.name (elem (.funcs p) k)) k))
    (loop (if (>= (load i) n)
              (break)
              (do
                (let [q (get (load quals) (load i))
                      sym (text/format a "coil_mp_{}" (dec->str a (load i)))
                      ep (primitive/alloc-stack ExportC)
                      me (primitive/alloc-stack MLEntry)]
                  (set! (.callee me) (ml-argv-adapter! a p funcs q))
                  (set! (.name ep) (.callee me))
                  (set! (.symbol ep) (Some sym))
                  (set! (.params ep)
                        (box-al [Type] a (ArrayList::new [Type] a)))
                  (set! (.published ep) true)
                  (set! (.lo ep) -1)
                  (set! (.hi ep) -1)
                  (set! (.source ep) -1)
                  (set! (.ctxt ep) 0)
                  (push! [ExportC] (load (field p exports)) (load ep))
                  (set! (.name me) q)
                  (set! (.symbol me) sym)
                  (push! (mut entries) (load me)))
                (set! i (primitive/iadd (load i) 1)))))
    (box-al [MLEntry] a (load entries))))

(defn metalower-program [(a (dyn Allocator))
                         (checked (ptr Program))
                         (quals (ptr (ArrayList (slice u8))))]
  (-> (Result (ptr MLOut) Diag))
  (metalower-program-mode a checked quals false))

(defn metalower-program-mode [(a (dyn Allocator))
                              (checked (ptr Program))
                              (quals (ptr (ArrayList (slice u8))))
                              (syntax-only bool)] (-> (Result (ptr MLOut) Diag))
  (try (do
         (let [st (primitive/alloc-stack MLS)]
           (set! (.a st) a)
           (set! (.reg st)
                 (box-al [(ptr Sexp)] a (ArrayList::new [(ptr Sexp)] a)))
           (set! (.qmodule st) "")
           (set! (.syntax_only st) syntax-only)
           (set! (.restricted st)
                 (box-al [MLRestricted] a (ArrayList::new [MLRestricted] a)))
           (set! (.sums st) (load (field checked sums)))
           (set! (.answers st) (box-al [Func] a (ArrayList::new [Func] a)))
           (let [out (box! a Program (zeroed Program))]
             (set! (.annotation_defs out)
                   (load (field checked annotation_defs)))
             (set! (.conventions out) (load (field checked conventions)))
             (set! (.structs out) (ml-structs a (load (field checked structs))))
             (set! (.sums out) (ml-sums a (load (field checked sums))))
             (set! (.externs out) (ml-externs a (load (field checked externs))))
             (let [lowered-funcs-p
                     (match (ml-funcs st (load (field checked funcs)))
                       (Ok [value] value)
                       (Err [error] (break :try (Err error))))
                   (mut lowered-funcs) (load lowered-funcs-p)]
               (try! (ml-add-impl-aliases! st
                                           (load (field checked impls))
                                           (mut lowered-funcs)))
               (set! (.funcs out) (box-al [Func] a (load lowered-funcs))))
             (set! (.asserts out) (load (field checked asserts)))
             (set! (.consts out)
                   (match (ml-consts st (load (field checked consts)))
                     (Ok [value] value)
                     (Err [error] (break :try (Err error)))))
             (set! (.traits out) (ml-traits a (load (field checked traits))))
             (set! (.impls out)
                   (match (ml-impls st (load (field checked impls)))
                     (Ok [value] value)
                     (Err [error] (break :try (Err error)))))
             (set! (.metas out) (load (field checked metas)))
             (set! (.exports out)
                   (box-al [ExportC] a (ArrayList::new [ExportC] a)))
             (set! (.function_abis out) (load (field checked function_abis)))
             (set! (.mono_origins out) (load (field checked mono_origins)))
             (set! (.mono_trait_uses out)
                   (load (field checked mono_trait_uses)))
             (set! (.unit_exports out) (load (field checked unit_exports)))
             (set! (.unit_build out) (.unit_build checked))
             (set! (.aliases out) (load (field checked aliases)))
             ;; Keep the ordinary checked graph intact through mono, including
             ;; synthesized trait aliases. Restricted sites get distinct ordinary
             ;; shim callables solely so concrete reachability can identify them;
             ;; an artifact is never emitted when one is reachable from an entry.
             (let [(mut function) (zeroed Func)]
               (for [i 0 (len (load (.restricted st)))]
                 (let [site (elem (.restricted st) i)
                       target (prog-fn-find out (.target site))]
                   (when (= (primitive/cast i64 target) 0)
                     (return-from
                       :try
                         (Err [(ptr MLOut) Diag]
                              (derr "artifact restriction shim missing"))))
                   (set! function (load target))
                   (set! (.name function) (.name site))
                   (push! (.funcs out) function))
                 0))
             (for [i 0 (len (load (.answers st)))]
               (push! (.funcs out) (load (elem (.answers st) i)))
               0)
             (let [entries (ml-exports a out quals)
                   mo (box! a MLOut (zeroed MLOut))]
               (set! (.prog mo) out)
               (set! (.entries mo) entries)
               (set! (.registry mo) (load (field st reg)))
               (set! (.restricted mo) (.restricted st))
               (Ok [(ptr MLOut) Diag] mo)))))))
