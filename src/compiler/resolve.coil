; src/compiler/resolve.coil — self-host Coil compiler, resolve module.
(module resolve)
(import "coil.primitive" :as primitive)

(import "coil.alloc" :as alloc :use *)
(import "coil.result" :use *)
(import "coil.slice" :use *)
(import "coil.str" :use *)
(import "coil.arraylist" :use *)
(import "coil.io" :use *)
(import "coil.control" :use *)
(import "coil.try" :use *)
(import "ast" :use *)
(import "astdump" :use *)
(import "check" :use *)
(import "loader" :use *)
(import "parser" :use *)
(import "coil.reader" :use *)
(import "coil.hashmap" :use *)  ; the per-module def-name index (defs-has?)

(defstruct Defs
  [(callables (ArrayList (slice u8)))
   (types (ArrayList (slice u8)))
   (traits (ArrayList (slice u8)))
   (convs (ArrayList (slice u8)))
   (externs (ArrayList (slice u8)))
   (consts (ArrayList (slice u8)))])
; A module's definitions, plus an INDEX over them. `resolve-name` asks "does module M
; define NAME, as kind K?" once for every identifier in the program, and answering it
; by scanning M's name lists with `str-eq` is O(references × definitions) — quadratic in
; program size, and on the compiler's own source the single largest cost in the whole
; frontend, over half of a run. `mono` had the same defect and was hash-indexed in
; gen-10; this is that treatment for `resolve`.
;
; One map per module, name -> a BITMASK of the kinds that define it, so a name that is
; both a type and a callable costs one slot and one probe instead of one map per kind.
; It is built ONCE, after `build-deftable` has finished filling every module, and lives
; inside the `DefEntry` — so unlike an index keyed on a list's address it cannot outlive
; or be mismatched against the lists it indexes. `built` is 0 until then and every
; lookup falls back to the scan, which keeps the index a pure optimisation: delete the
; build call and the compiler still resolves identically, only slower.
(defstruct DefEntry [(module (slice u8)) (defs Defs) (idx (HashMap (slice u8) i64)) (built i64)])
(defstruct ParsedForm [(prog (ptr Program)) (module (Option (slice u8)))])

; One-field wrapper structs: an `(ArrayList X)` BY VALUE inside a heap struct, so it
; can be GROWN via the field place `(primitive/field box items)` (al-push! needs a place; a
; bare `(ptr (ArrayList X))` cannot be pushed into). `(primitive/field box items)` is itself a
; `(ptr (ArrayList X))`, usable directly for read-only queries (table-find etc.).
(defstruct PBox [(items (ArrayList ParsedForm))])
(defstruct TBox [(items (ArrayList DefEntry))])
(defstruct SBox [(items (ArrayList (slice u8)))])

; The threaded resolution context (mirrors the args of /
; qualify_*). `m`/`imp` change per module; `strict`/`bareok` are constant for the
; whole program (dump-resolved resolves with strict=true).
(defstruct Ctx
  [(a (ptr Allocator))
   (m (slice u8))
   (imp (ptr ImpEntry))
   (table (ptr (ArrayList DefEntry)))
   (exp (ptr (ArrayList ExpEntry)))
   (strict bool)
   (bareok (ptr (ArrayList (slice u8))))
   ; the function whose body is being qualified, so a resolve error can name it the
   ; way the checker's identical error already does ("in 'big.buried'") instead of
   ; naming the module. Empty outside a function body (const/meta/assert).
   (fname (slice u8))
   ; the collect-and-continue sink for recoverable body errors: every diagnostic, and
   ; the qualified names of the functions whose bodies failed (so the checker skips
   ; them). Shared across modules — resolve-program allocates them once.
   (diags (ptr (ArrayList Diag)))
   (poisoned (ptr (ArrayList (slice u8))))
   (impb (ptr (ArrayList ImpEntry)))])

; The merged output program, sections as BY-VALUE ArrayLists so merge can push.
(defstruct Out
  [(annotation_defs (ArrayList AnnotationDef))
   (conventions (ArrayList Convention))
   (structs (ArrayList StructDef))
   (sums (ArrayList SumDef))
   (externs (ArrayList Extern))
   (funcs (ArrayList Func))
   (asserts (ArrayList StaticAssert))
   (consts (ArrayList Const))
   (traits (ArrayList TraitDef))
   (impls (ArrayList ImplDef))
   (metas (ArrayList Expr))
   (exports (ArrayList ExportC))])

; ---- small generic + string helpers ---------------------------------------
; `al-elem` moved to coil.arraylist. It lived here — private to the compiler —
; while being the ONLY way to read a struct field out of a list, so every other
; program hand-rolled per-field accessors instead.
;
; NOTE for the bootstrap: this move, and the matching `f64-bits`/`bits->f64` move
; into coil.mem, mean compiler source now calls stdlib names the OLD committed seed
; does not have — and that seed carries its own embedded copy of the library, from
; before the library became files on disk, so it cannot read this tree's stdlib
; either. The seed must therefore be refreshed in the same change
; (scripts/compiler/refresh-seed.sh with a modern STAGE0); a seed that predates these
; names fails stage1 outright. Focused gates do not catch it — they test an
; already-built compiler and never run the seed.

(defn booleq [(x bool) (y bool)] (-> bool)
  (or (and x y) (and (not x) (not y))))

(defn has-dot [(s (slice u8))] (-> bool)
  (let [n (slice-len s)
        (mut i) 0
        (mut f) false]
    (loop (if (>= (load i) n)
              (break)
              (do
                (when (= (primitive/cast i64 (slice-get s (load i))) (primitive/cast i64 46)) (store! f true) (break))
                (set! i (primitive/iadd (load i) 1)))))
    (load f)))

(defn find-slash [(s (slice u8))] (-> i64)
  (let [n (slice-len s)
        (mut i) 0
        (mut r) -1]
    (loop (if (>= (load i) n)
              (break)
              (do
                (when (= (primitive/cast i64 (slice-get s (load i))) (primitive/cast i64 47))
                  (store! r (load i))
                  (break))
                (set! i (primitive/iadd (load i) 1)))))
    (load r)))

; `(dyn Trait)` is currently parsed as the source-generated nominal `Trait-dyn`.
; Resolve that nominal THROUGH the originating trait rather than as an ordinary
; exported type: `(export Trait)` is the public contract, while the vtable and fat
; pointer structs emitted by `defdyn` remain implementation details.  Keeping this
; bridge here also makes nested uses such as `(Option (dyn Trait))` follow the normal
; recursive type qualifier.
(defn dyn-type-name? [(s (slice u8))] (-> bool)
  (let [n (slice-len s)]
    (and (>= n (primitive/cast i64 4))
         (= (subslice [u8] s (primitive/isub n 4) n) "-dyn"))))

(defn qualify-dyn-type [(c (ptr Ctx)) (name (slice u8))] (-> (Result (slice u8) Diag))
  (let [a (load (field c a))
        n (slice-len name)
        trait-name (subslice [u8] name 0 (primitive/isub n 4))]
    (match (resolve c trait-name 2)
      (Err [d] (Err [(slice u8) Diag] d))
      (Ok [trait-qual] (Ok [(slice u8) Diag] (sconcat a trait-qual "-dyn"))))))

; ── the IMPLICIT-QUALIFICATION map — call node id → was the head written BARE?
; Recorded for every ECall this pass qualifies, consumed by the checker's
; arity-directed fallback, which may only reinterpret a call whose module-
; qualified spelling was the RESOLVER's doing. A user who writes
; `(coil.io.read c)` or `(io/read c)` named that function explicitly, and a
; wrong arity there is a hard error, not an invitation to guess. Same shape and
; lifetime rules as comptime's res-map: append-only, LATEST entry wins, so nid
; reuse across the macro tower's subprograms resolves to the pass that ran most
; recently — each check reads the entries its own resolve just recorded. A nid
; with no entry (code that never passed this rewrite) defaults to explicit,
; which disables the fallback — the conservative, pre-fallback behavior.
(defstruct ImplQualEntry [(nid i64) (bare i64)])
(defstruct ImplQualBox [(init i64) (lst (ptr (ArrayList ImplQualEntry)))])
(defn impl-qual-box [] (-> (ptr ImplQualBox))
  (alloc/static ImplQualBox))
(defn impl-qual-list [] (-> (ptr (ArrayList ImplQualEntry)))
  (let [b (impl-qual-box)]
    (when (= (load (field b init)) (primitive/cast i64 0))
      (store! (field b lst)
              (unwrap-ptr [(ArrayList ImplQualEntry)] (create [(ArrayList ImplQualEntry)] (malloc-allocator))))
      (store! (load (field b lst)) (al-new [ImplQualEntry] (malloc-allocator)))
      (store! (field b init) 1)
      0)
    (load (field b lst))))
(defn impl-qual-record! [(nid i64) (bare i64)] (-> i64)
  (unless (<= nid (primitive/cast i64 0))
    (let [e (alloc/stack ImplQualEntry)]
      (store! (field e nid) nid)
      (store! (field e bare) bare)
      (al-push! (impl-qual-list) (load e))
      0)))
(defn head-was-implicit? [(nid i64)] (-> bool)
  (if (<= nid (primitive/cast i64 0))
      false
      (let [lst (impl-qual-list)
            n (al-len [ImplQualEntry] (load lst))
            (mut i) (primitive/isub n 1)
            (mut r) false]
        (loop (if (< (load i) (primitive/cast i64 0))
                  (break)
                  (do
                    (let [e (al-elem [ImplQualEntry] lst (load i))]
                      (when (= (load (field e nid)) nid)
                        (store! r (!= (load (field e bare)) (primitive/cast i64 0)))
                        (break)))
                    (set! i (primitive/isub (load i) 1)))))
        (load r))))

; Index of the first `::` in a symbol, or -1 (byte 58 = ':'). A `Trait::method`
; qualified trait-method call (gen-6) carries the qualifier this way — the checker
; splits it in synth-call, so resolve leaves the head bare and exempts it from the
; strict undefined-reference check below.
(defn find-coloncolon [(s (slice u8))] (-> i64)
  (let [n (slice-len s)
        (mut i) 0
        (mut r) -1]
    (loop (if (>= (load i) (primitive/isub n 1))
              (break)
              (do
                (when (and (= (primitive/cast i64 (slice-get s (load i))) (primitive/cast i64 58))
                           (= (primitive/cast i64 (slice-get s (primitive/iadd (load i) 1))) (primitive/cast i64 58)))
                  (store! r (load i))
                  (break))
                (set! i (primitive/iadd (load i) 1)))))
    (load r)))

(defn empty-strs [(a (ptr Allocator))] (-> (ptr (ArrayList (slice u8))))
  (box a (ArrayList (slice u8)) (al-new [(slice u8)] a)))

; is_scalar_typename: bool / f32 / f64 / (i|u)<digits>.
(defn is-scalar-typename [(s (slice u8))] (-> bool)
  (cond (= s "bool") true
        (= s "f32") true
        (= s "f64") true
        :else
          (let [n (slice-len s)]
            (if (< n (primitive/cast i64 2))
                false
                (let [c0 (primitive/cast i64 (slice-get s 0))]
                  (if (or (= c0 (primitive/cast i64 105)) (= c0 (primitive/cast i64 117)))
                      (let [(mut ok) true
                            (mut j) 1]
                        (loop (if (>= (load j) n)
                                  (break)
                                  (do
                                    (let [ch (primitive/cast i64 (slice-get s (load j)))]
                                      (unless (and (>= ch (primitive/cast i64 48)) (<= ch (primitive/cast i64 57)))
                                        (store! ok
                                                false)
                                        (break)))
                                    (store! j (primitive/iadd (load j) 1)))))
                        (load ok))
                      false))))))

; ---- error messages (faithful to) --------------------------
(defn priv-msg [(a (ptr Allocator)) (m (slice u8)) (rest (slice u8)) (target (slice u8))] (-> (slice u8))
  (let [p1 (sconcat3 a "in module '" m "': '")
        p2 (sconcat3 a p1 rest "' is private to module '")]
    (sconcat3 a p2 target "' (add it to that module's (export …))")))
; Every callable name in the def table — the candidate pool for an undefined-call
; "did you mean" hint.
(defn all-callables [(a (ptr Allocator)) (table (ptr (ArrayList DefEntry)))] (-> (ptr (ArrayList (slice u8))))
  (let [n (al-len [DefEntry] (load table))
        (mut i) 0
        (mut out) (al-new [(slice u8)] a)]
    (loop (if (>= (load i) n)
              (break)
              (do
                (let [cs (field (field (al-elem [DefEntry] table (load i)) defs) callables)
                      cn (al-len [(slice u8)] (load cs))
                      (mut j) 0]
                  (loop (if (>= (load j) cn)
                            (break)
                            (do
                              (al-push! (mut out) (al-get [(slice u8)] (load cs) (load j)))
                              (set! j (primitive/iadd (load j) 1))))))
                (set! i (primitive/iadd (load i) 1)))))
    (box-al [(slice u8)] a (load out))))
; `where` names the enclosing function when there is one, else the module — the checker
; emits this exact error and names the function, and resolve named only the module, so
; which one a user saw depended on whether the file had a (module …) declaration (diag-1).
; A "did you mean 'X'?" suggestion (nearest def-table name by edit distance) is appended
; when there's a near miss (diag-6).
; The module whose def table holds `func` under exactly that surface name — i.e. the
; name is REAL and simply not in scope here. `nearest-name` skips a candidate equal to
; the query, so without this check an unimported-but-real name produced a typo hint for
; some OTHER function, which reads as "you misspelled it" when nothing is misspelled.
; DefEntry carries its module, so no name-prefix parsing is needed.
(defn defining-module [(table (ptr (ArrayList DefEntry))) (func (slice u8))] (-> (Option (slice u8)))
  (let [n (al-len [DefEntry] (load table))
        (mut i) 0
        (mut found) (None [(slice u8)])]
    (loop (if (or (>= (load i) n) (some? [(slice u8)] (load found)))
              (break)
              (do
                (let [e (al-elem [DefEntry] table (load i))
                      cs (field (field e defs) callables)
                      cn (al-len [(slice u8)] (load cs))
                      (mut j) 0]
                  (loop (if (>= (load j) cn)
                            (break)
                            (do
                              (when (= (last-component (al-get [(slice u8)] (load cs) (load j))) func)
                                (store! found (Some (load (field e module))))
                                (break))
                              (set! j (primitive/iadd (load j) 1))))))
                (set! i (primitive/iadd (load i) 1)))))
    (load found)))

; `src`/`lo` identify the call site so a SHADOWED macro can be named as such. Without
; it the message claimed the defining module "is not imported here", which for a
; prelude-re-exported module like coil.control is simply untrue — and it is precisely
; the modules the prelude re-exports whose names are worth shadowing.
(defn undef-msg-at [(a (ptr Allocator)) (c (ptr Ctx)) (func (slice u8)) (src i64) (lo i64)] (-> (slice u8))
  (if (shadowed-call? src lo)
      (let [fname (.fname c)
            where
              (if (> (slice-len [u8] fname) (primitive/cast i64 0))
                  (sconcat3 a "in '" fname "'")
                  (sconcat3 a "in module '" (.m c) "'"))]
        (sconcat a
                 (sconcat3 a where ": '" func)
                 "' is a local binding here, so it names the local rather than the macro of that name; a local is not callable — rename the binding, or move the call outside its scope"))
      (undef-msg a c func)))

(defn undef-msg [(a (ptr Allocator)) (c (ptr Ctx)) (func (slice u8))] (-> (slice u8))
  (let [fname (.fname c)
        where
          (if (> (slice-len [u8] fname) (primitive/cast i64 0))
              (sconcat3 a "in '" fname "'")
              (sconcat3 a "in module '" (.m c) "'"))
        base (sconcat a (sconcat3 a where ": call to undefined function '" "") (sconcat a func "'"))]
    (match (defining-module (load (field c table)) func)
      (Some [m] (sconcat3 a (sconcat3 a base "; it is defined in module '" m) "', which is not imported here" ""))
      (None []
            (match (nearest-name a (all-callables a (load (field c table))) func)
              (None [] base)
              (Some [s] (sconcat3 a base "; did you mean '" (sconcat a s "'?"))))))))
(defn extern-conflict-msg [(a (ptr Allocator)) (nm (slice u8))] (-> (slice u8))
  (sconcat3 a "extern '" nm "' declared with conflicting signatures"))
(defn const-dup-msg [(a (ptr Allocator)) (nm (slice u8))] (-> (slice u8))
  (sconcat3 a "const '" nm "' defined more than once"))
; A bare name is exported by more than one `:use`d module. Resolving it first-import-wins
; would SILENTLY pick whichever import came first (reorder two import lines, run a different
; function). Same shape as the checker's trait-method ambiguity ("… is ambiguous — …"):
; name the competing modules and tell the user to disambiguate (NAMESPACING.md).
(defn use-ambig-msg [(a (ptr Allocator)) (m (slice u8)) (name (slice u8)) (m1 (slice u8)) (m2 (slice u8))] (-> (slice u8))
  (sconcat5 a
            (sconcat5 a "in module '" m "': '" name "' is ambiguous — exported by :use'd modules '")
            m1
            "' and '"
            m2
            "'; :use only one, or reach it qualified via an :as alias"))
; The SAME name is explicitly `:use [name]`'d from two different modules in one importer —
; the same silent collision, caught eagerly at the import instead of at a later use site.
(defn use-dup-msg [(a (ptr Allocator)) (m (slice u8)) (name (slice u8)) (m1 (slice u8)) (m2 (slice u8))] (-> (slice u8))
  (sconcat5 a
            (sconcat5 a "in module '" m "': '" name "' is explicitly :use'd from two modules '")
            m1
            "' and '"
            m2
            "' — :use it from only one"))
; diag-10: a `:use [name]` naming a symbol the target module does not export. Uses the SAME
; export table (`exports-check`) that resolution itself consults, so a name the resolver would
; treat as private/absent is named at the import site instead of silently accepted. A module
; with no (export …) exports everything, so only an explicit export list can trip this.
(defn use-unexported-msg [(a (ptr Allocator)) (m (slice u8)) (name (slice u8)) (target (slice u8))] (-> (slice u8))
  (let [p (sconcat5 a "in module '" m "': :use names '" name "', which module '")]
    (sconcat3 a p target "' does not export")))

; ---- table / import / export queries --------------------------------------
(defn defs-set [(d (ptr Defs)) (kind i64)] (-> (ptr (ArrayList (slice u8))))
  (cond (= kind (primitive/cast i64 0)) (field d callables)
        (= kind (primitive/cast i64 1)) (field d types)
        (= kind (primitive/cast i64 2)) (field d traits)
        (= kind (primitive/cast i64 3)) (field d convs)
        (= kind (primitive/cast i64 4)) (field d externs)
        :else (field d consts)))

; The bit each `defs-set` kind occupies in an indexed name's mask. Same numbering as
; `defs-set` above, and the two must be read together.
(defn defs-kind-bit [(kind i64)] (-> i64)
  (cond (= kind (primitive/cast i64 0)) 1
        (= kind (primitive/cast i64 1)) 2
        (= kind (primitive/cast i64 2)) 4
        (= kind (primitive/cast i64 3)) 8
        (= kind (primitive/cast i64 4)) 16
        :else 32))

(defn defs-index-kind! [(e (ptr DefEntry)) (lst (ptr (ArrayList (slice u8)))) (bit i64)] (-> i64)
  (let [n (al-len [(slice u8)] (load lst))
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (let [k (al-get [(slice u8)] (load lst) (load i))
                    cur
                      (match (hm-get [(slice u8) i64] (.idx e) k)
                        (Some [v] v)
                        (None [] 0))]
                (hm-put! [(slice u8) i64] (mut (.idx e)) k (primitive/ior cur bit))
                (set! i (primitive/iadd (load i) 1))))))
  0)

(defn defs-index-build! [(a (ptr Allocator)) (e (ptr DefEntry))] (-> i64)
  (set! (.idx e) (hm-new [(slice u8) i64] a (str-keyops)))
  (defs-index-kind! e (field (field e defs) callables) 1)
  (defs-index-kind! e (field (field e defs) types) 2)
  (defs-index-kind! e (field (field e defs) traits) 4)
  (defs-index-kind! e (field (field e defs) convs) 8)
  (defs-index-kind! e (field (field e defs) externs) 16)
  (defs-index-kind! e (field (field e defs) consts) 32)
  (set! (.built e) 1)
  0)

; Does module `e` define `name` as kind `kind`? The indexed answer when the index has
; been built, the original scan when it has not — identical results either way.
(defn defs-has? [(e (ptr DefEntry)) (kind i64) (name (slice u8))] (-> bool)
  (if (= (.built e) (primitive/cast i64 0))
      (set-contains (defs-set (field e defs) kind) name)
      (match (hm-get [(slice u8) i64] (.idx e) name)
        (None [] false)
        (Some [mask] (!= (primitive/iand mask (defs-kind-bit kind)) (primitive/cast i64 0))))))

(defn set-contains [(setp (ptr (ArrayList (slice u8)))) (name (slice u8))] (-> bool)
  (let [n (al-len [(slice u8)] (load setp))
        (mut i) 0
        (mut f) false]
    (loop (if (>= (load i) n)
              (break)
              (do
                (when (= (al-get [(slice u8)] (load setp) (load i)) name) (store! f true) (break))
                (set! i (primitive/iadd (load i) 1)))))
    (load f)))

(defn table-find [(table (ptr (ArrayList DefEntry))) (m (slice u8))] (-> (ptr DefEntry))
  (let [n (al-len [DefEntry] (load table))
        (mut i) 0
        (mut r) (primitive/cast (ptr DefEntry) 0)]
    (loop (if (>= (load i) n)
              (break)
              (do
                (when (= (load (field (al-elem [DefEntry] table (load i)) module)) m)
                  (store! r (al-elem [DefEntry] table (load i)))
                  (break))
                (set! i (primitive/iadd (load i) 1)))))
    (load r)))

(defn imports-find [(impb (ptr (ArrayList ImpEntry))) (m (slice u8))] (-> (ptr ImpEntry))
  (let [n (al-len [ImpEntry] (load impb))
        (mut i) 0
        (mut r) (primitive/cast (ptr ImpEntry) 0)]
    (loop (if (>= (load i) n)
              (break)
              (do
                (when (= (load (field (al-elem [ImpEntry] impb (load i)) name)) m)
                  (store! r (al-elem [ImpEntry] impb (load i)))
                  (break))
                (set! i (primitive/iadd (load i) 1)))))
    (load r)))

; macros::exports — `exports.get(m).map(contains).unwrap_or(true)`.
(defn exports-check [(expb (ptr (ArrayList ExpEntry))) (m (slice u8)) (name (slice u8))] (-> bool)
  (let [n (al-len [ExpEntry] (load expb))
        (mut i) 0
        (mut found) (primitive/cast (ptr ExpEntry) 0)]
    (loop (if (>= (load i) n)
              (break)
              (do
                (when (= (load (field (al-elem [ExpEntry] expb (load i)) name)) m)
                  (store! found (al-elem [ExpEntry] expb (load i)))
                  (break))
                (set! i (primitive/iadd (load i) 1)))))
    (if (= (primitive/cast i64 (load found)) (primitive/cast i64 0))
        true
        (set-contains (field (load found) names) name))))

(defn alias-target [(imp (ptr ImpEntry)) (alias (slice u8))] (-> (Option (slice u8)))
  (let [als (field (field imp imp) aliases)
        n (al-len [Alias] (load als))
        (mut i) 0
        (mut r) (None [(slice u8)])]
    (loop (if (>= (load i) n)
              (break)
              (do
                (let [ep (alloc/stack Alias)]
                  (set! ep (al-get [Alias] (load als) (load i)))
                  (when (= (load (field ep alias)) alias)
                    (store! r
                            (Some (load (field ep
                                               target))))
                    (break)))
                (set! i (primitive/iadd (load i) 1)))))
    (load r)))

(defn resolve-exported [(c (ptr Ctx))
                        (module (slice u8))
                        (name (slice u8))
                        (kind i64)
                        (depth i64)] (-> (Option (slice u8)))
  (if (or (>= depth (primitive/cast i64 64))
          (not (exports-check (load (field c exp)) module name)))
      (None [(slice u8)])
      (let [direct (table-find (load (field c table)) module)]
        (if (and (!= (primitive/cast i64 direct) (primitive/cast i64 0))
                 (defs-has? direct kind name))
            (Some (sconcat3 (load (field c a)) module "." name))
            (let [ie (imports-find (load (field c impb)) module)]
              (if (= (primitive/cast i64 ie) (primitive/cast i64 0))
                  (None [(slice u8)])
                  (let [rs (field (field ie imp) reexports)
                        n (al-len [(slice u8)] (load rs))
                        (mut i) 0
                        (mut out) (None [(slice u8)])]
                    (loop (if (>= (load i) n)
                              (break)
                              (match (resolve-exported c
                                                       (al-get [(slice u8)] (load rs) (load i))
                                                       name
                                                       kind
                                                       (primitive/iadd depth 1))
                                (Some [q] (do (set! out (Some q)) (break)))
                                (None [] (set! i (primitive/iadd (load i) 1))))))
                    (load out))))))))

; the `:use`d-modules branch of resolve (extracted so no try!/return runs in a loop).
; Now collision-aware: it scans ALL `:use`d modules rather than stopping at the first
; match, so a name exported by two distinct `:use`d modules is a hard ambiguity error
; instead of the old first-import-wins silent pick (tool-10). Distinct modules only —
; the same target reached via two `:use` entries is one module, not a collision.
(defn resolve-use [(c (ptr Ctx)) (imp (ptr ImpEntry)) (name (slice u8)) (kind i64)] (-> (Result (Option (slice u8))
                                                                                                Diag))
  (let [a (load (field c a))
        table (load (field c table))
        exp (load (field c exp))
        uses (field (field imp imp) uses)
        n (al-len [Use] (load uses))
        (mut i) 0
        (mut r) (None [(slice u8)])
        (mut m1) ""
        (mut m2) ""
        (mut cnt) 0]
    (loop (if (or (>= (load cnt) (primitive/cast i64 2)) (>= (load i) n))
              (break)
              (do
                (let [up (alloc/stack Use)]
                  (set! up (al-get [Use] (load uses) (load i)))
                  (let [target (.target up)]
                    ; `use-refers` decides referred-ness AND, for a `:rename`, which of the
                    ; target's own exported names the local one stands for.
                    (match (use-refers up name)
                      (None [] 0)
                      (Some [exported]
                            (when (exports-check exp target exported)
                              (match (resolve-exported c target exported kind 0)
                                (Some [q]
                                      (if (= (load cnt) (primitive/cast i64 0))
                                          (do
                                            (store! r (Some q))
                                            (store! m1 target)
                                            (store! cnt 1)
                                            0)
                                          (unless (= (load m1) target)
                                            (store! m2 target)
                                            (store! cnt
                                                    2)
                                            0)))
                                (None [] 0)))))))
                (set! i (primitive/iadd (load i) 1)))))
    (if (>= (load cnt) (primitive/cast i64 2))
        (Err [(Option (slice u8)) Diag] (derr (use-ambig-msg a (.m c) name (load m1) (load m2))))
        (Ok [(Option (slice u8)) Diag] (load r)))))

; — kind: 0 callables, 1 types, 2 traits, 3 convs, 4 externs, 5 consts.
; ── the name-resolution memo ─────────────────────────────────────────────────
; `resolve` is called once per IDENTIFIER, and the answer costs an allocation before it
; can be returned: the qualified name is built with sconcat3 every time. Identifiers
; repeat relentlessly — `load`, `store!`, `al-len`, `icmp-eq` — and within one module the
; answer is a pure function of (name, kind): the def table, imports and exports are all
; fixed for the whole resolve pass.
;
; So it is memoised per module, with one map per kind so the kind need not be encoded
; into the key. Only successes are cached: a failure carries a Diag whose message is
; built for the site that raised it, and reusing one would misreport the second site.
; The memo is dropped whenever the module changes.
(defstruct ResMemo
  [(mod (slice u8))
   (valid i64)
   (k0 (HashMap (slice u8) (slice u8)))
   (k1 (HashMap (slice u8) (slice u8)))
   (k2 (HashMap (slice u8) (slice u8)))
   (k3 (HashMap (slice u8) (slice u8)))
   (k4 (HashMap (slice u8) (slice u8)))])
(defn res-memo [] (-> (ptr ResMemo))
  (alloc/static ResMemo))
(defn res-memo-map [(rm (ptr ResMemo)) (kind i64)] (-> (ptr (HashMap (slice u8) (slice u8))))
  (cond (= kind (primitive/cast i64 0)) (field rm k0)
        (= kind (primitive/cast i64 1)) (field rm k1)
        (= kind (primitive/cast i64 2)) (field rm k2)
        (= kind (primitive/cast i64 3)) (field rm k3)
        :else (field rm k4)))
(defn res-memo-reset! [(rm (ptr ResMemo)) (m (slice u8))] (-> i64)
  (let [a (malloc-allocator)]
    (set! (.k0 rm) (hm-new [(slice u8) (slice u8)] a (str-keyops)))
    (set! (.k1 rm) (hm-new [(slice u8) (slice u8)] a (str-keyops)))
    (set! (.k2 rm) (hm-new [(slice u8) (slice u8)] a (str-keyops)))
    (set! (.k3 rm) (hm-new [(slice u8) (slice u8)] a (str-keyops)))
    (set! (.k4 rm) (hm-new [(slice u8) (slice u8)] a (str-keyops)))
    (set! (.mod rm) m)
    (set! (.valid rm) 1)
    0))
(defn resolve [(c (ptr Ctx)) (name (slice u8)) (kind i64)] (-> (Result (slice u8) Diag))
  (let [rm (res-memo)
        m (.m c)]
    (when (or (= (load (field rm valid)) (primitive/cast i64 0))
              (not (= (load (field rm
                                   mod))
                      m)))
      (res-memo-reset! rm m))
    (let [mp (res-memo-map rm kind)]
      (match (hm-get [(slice u8) (slice u8)] (load mp) name)
        (Some [hit] (Ok [(slice u8) Diag] hit))
        (None []
              (match (resolve-uncached c name kind)
                (Err [d] (Err [(slice u8) Diag] d))
                (Ok [q]
                    (do
                      (hm-put! [(slice u8) (slice u8)] (mut mp) name q)
                      (Ok [(slice u8) Diag] q)))))))))

(defn resolve-uncached [(c (ptr Ctx)) (name (slice u8)) (kind i64)] (-> (Result (slice u8) Diag))
  (let [a (load (field c a))
        m (.m c)
        imp (load (field c imp))
        table (load (field c table))
        exp (load (field c exp))
        sl (find-slash name)]
    (if (>= sl (primitive/cast i64 0))
        (let [alias (subslice name 0 sl)
              rest (subslice name (primitive/iadd sl 1) (slice-len name))]
          (if (!= (primitive/cast i64 imp) (primitive/cast i64 0))
              (match (alias-target imp alias)
                (Some [target]
                      (match (resolve-exported c target rest kind 0)
                        (Some [q] (Ok [(slice u8) Diag] q))
                        (None []
                              (if (exports-check exp target rest)
                                  (Ok [(slice u8) Diag] (sconcat3 a target "." rest))
                                  (Err [(slice u8) Diag] (derr (priv-msg a m rest target)))))))
                (None [] (Ok [(slice u8) Diag] name)))
              (Ok [(slice u8) Diag] name)))
        (let [tf (table-find table m)]
          (if (and (!= (primitive/cast i64 tf) (primitive/cast i64 0)) (defs-has? tf kind name))
              (Ok [(slice u8) Diag] (sconcat3 a m "." name))
              (match (if (!= (primitive/cast i64 imp) (primitive/cast i64 0))
                         (resolve-use c imp name kind)
                         (Ok [(Option (slice u8)) Diag] (None [(slice u8)])))
                (Err [d] (Err [(slice u8) Diag] d))
                (Ok [used-opt]
                    (match used-opt
                      (Some [q] (Ok [(slice u8) Diag] q))
                      ; …and finally `coil.core`, the lowest-precedence tier: referred by
                      ; every module unless that module wrote its own
                      ; `(import "coil.core" …)`, which replaces the default refer-all.
                      ; `core-refers` is the same predicate every `:use` goes through.
                      (None []
                            (if (not (= m "coil.core"))
                                (match (core-refers imp name)
                                  (None [] (Ok [(slice u8) Diag] name))
                                  (Some [exported]
                                        (let [ct (table-find table "coil.core")]
                                          (if (and (and (!= (primitive/cast i64 ct) (primitive/cast i64 0))
                                                        (defs-has? ct kind exported))
                                                   (exports-check exp "coil.core" exported))
                                              (Ok [(slice u8) Diag] (sconcat3 a "coil.core" "." exported))
                                              (Ok [(slice u8) Diag] name)))))
                                (Ok [(slice u8) Diag] name)))))))))))

; ---- type-equality (for extern dedup in merge) ----------------------------
; All take/recurse on `(ptr Type)` — passing a `Type` sum BY VALUE into a recursive
; call corrupts its payload (Coil by-value-aggregate-in-recursion bug), so we keep
; everything behind pointers (as the rest of the resolver does for aggregates).
(defn type-tag [(t (ptr Type))] (-> i64)
  (match (load t)
    (TInt [_ _] 0)
    (TFloat [_] 1)
    (TBool [] 2)
    (TVoid [] 3)
    (TPtr [_] 4)
    (TRef [_ _] 5)
    (TStruct [_] 6)
    (TArray [_ _] 7)
    (TSlice [_] 8)
    (TVec [_ _] 9)
    (TFn [_ _ _] 10)
    (TApp [_ _] 11)
    (TNever [] 12)
    (TCode [] 13)
    (TExternRef [] 14)
    (TCodeBuilder [] 15)))
(defn t-inner [(t (ptr Type))] (-> (ptr Type))
  (match (load t)
    (TPtr [i] i)
    (TRef [_ i] i)
    (TArray [i _] i)
    (TSlice [i] i)
    (TVec [i _] i)
    (TInt [_ _] (do (loader-abort "t-inner: not a wrapper type") (box-type (malloc-allocator) (TVoid))))
    (TFloat [_] (do (loader-abort "t-inner") (box-type (malloc-allocator) (TVoid))))
    (TBool [] (do (loader-abort "t-inner") (box-type (malloc-allocator) (TVoid))))
    (TVoid [] (do (loader-abort "t-inner") (box-type (malloc-allocator) (TVoid))))
    (TStruct [_] (do (loader-abort "t-inner") (box-type (malloc-allocator) (TVoid))))
    (TFn [_ _ _] (do (loader-abort "t-inner") (box-type (malloc-allocator) (TVoid))))
    (TApp [_ _] (do (loader-abort "t-inner") (box-type (malloc-allocator) (TVoid))))
    (TNever [] (do (loader-abort "t-inner") (box-type (malloc-allocator) (TVoid))))
    (TCode [] (do (loader-abort "t-inner") (box-type (malloc-allocator) (TVoid))))
    (TExternRef [] (do (loader-abort "t-inner") (box-type (malloc-allocator) (TVoid))))
    (TCodeBuilder [] (do (loader-abort "t-inner") (box-type (malloc-allocator) (TVoid))))))
(defn type-struct-name [(t (ptr Type))] (-> (slice u8))
  (match (load t)
    (TStruct [n] n)
    (TInt [_ _] (do (loader-abort "type-struct-name: not a struct") ""))
    (TFloat [_] (do (loader-abort "type-struct-name") ""))
    (TBool [] (do (loader-abort "type-struct-name") ""))
    (TVoid [] (do (loader-abort "type-struct-name") ""))
    (TPtr [_] (do (loader-abort "type-struct-name") ""))
    (TRef [_ _] (do (loader-abort "type-struct-name") ""))
    (TArray [_ _] (do (loader-abort "type-struct-name") ""))
    (TSlice [_] (do (loader-abort "type-struct-name") ""))
    (TVec [_ _] (do (loader-abort "type-struct-name") ""))
    (TFn [_ _ _] (do (loader-abort "type-struct-name") ""))
    (TApp [_ _] (do (loader-abort "type-struct-name") ""))
    (TNever [] (do (loader-abort "type-struct-name") ""))
    (TCode [] (do (loader-abort "type-struct-name") ""))
    (TExternRef [] (do (loader-abort "type-struct-name") ""))
    (TCodeBuilder [] (do (loader-abort "type-struct-name") ""))))
(defn t-int-bits [(t (ptr Type))] (-> i64)
  (match (load t)
    (TInt [b _] b)
    (TFloat [b] b)
    (TBool [] 0)
    (TVoid [] 0)
    (TPtr [_] 0)
    (TRef [_ _] 0)
    (TStruct [_] 0)
    (TArray [_ _] 0)
    (TSlice [_] 0)
    (TVec [_ _] 0)
    (TFn [_ _ _] 0)
    (TApp [_ _] 0)
    (TNever [] 0)
    (TCode [] 0)
    (TExternRef [] 0)
    (TCodeBuilder [] 0)))
(defn t-int-signed [(t (ptr Type))] (-> bool)
  (match (load t)
    (TInt [_ s] s)
    (TFloat [_] false)
    (TBool [] false)
    (TVoid [] false)
    (TPtr [_] false)
    (TRef [_ _] false)
    (TStruct [_] false)
    (TArray [_ _] false)
    (TSlice [_] false)
    (TVec [_ _] false)
    (TFn [_ _ _] false)
    (TApp [_ _] false)
    (TNever [] false)
    (TCode [] false)
    (TExternRef [] false)
    (TCodeBuilder [] false)))
(defn t-ref-mut [(t (ptr Type))] (-> bool)
  (match (load t)
    (TRef [m _] m)
    (TInt [_ _] false)
    (TFloat [_] false)
    (TBool [] false)
    (TVoid [] false)
    (TPtr [_] false)
    (TStruct [_] false)
    (TArray [_ _] false)
    (TSlice [_] false)
    (TVec [_ _] false)
    (TFn [_ _ _] false)
    (TApp [_ _] false)
    (TNever [] false)
    (TCode [] false)
    (TExternRef [] false)
    (TCodeBuilder [] false)))
(defn t-arrn [(t (ptr Type))] (-> i64)
  (match (load t)
    (TArray [_ n] n)
    (TVec [_ n] n)
    (TInt [_ _] 0)
    (TFloat [_] 0)
    (TBool [] 0)
    (TVoid [] 0)
    (TPtr [_] 0)
    (TRef [_ _] 0)
    (TStruct [_] 0)
    (TSlice [_] 0)
    (TFn [_ _ _] 0)
    (TApp [_ _] 0)
    (TNever [] 0)
    (TCode [] 0)
    (TExternRef [] 0)
    (TCodeBuilder [] 0)))
(defn t-fn-cc [(t (ptr Type))] (-> (slice u8))
  (match (load t)
    (TFn [cc _ _] cc)
    (TInt [_ _] "")
    (TFloat [_] "")
    (TBool [] "")
    (TVoid [] "")
    (TPtr [_] "")
    (TRef [_ _] "")
    (TStruct [_] "")
    (TArray [_ _] "")
    (TSlice [_] "")
    (TVec [_ _] "")
    (TApp [_ _] "")
    (TNever [] "")
    (TCode [] "")
    (TExternRef [] "")
    (TCodeBuilder [] "")))
(defn t-fn-params [(t (ptr Type))] (-> (ptr (ArrayList Type)))
  (match (load t)
    (TFn [_ p _] p)
    (TApp [_ args] args)
    (TInt [_ _] (box-items-type (malloc-allocator)))
    (TFloat [_] (box-items-type (malloc-allocator)))
    (TBool [] (box-items-type (malloc-allocator)))
    (TVoid [] (box-items-type (malloc-allocator)))
    (TPtr [_] (box-items-type (malloc-allocator)))
    (TRef [_ _] (box-items-type (malloc-allocator)))
    (TStruct [_] (box-items-type (malloc-allocator)))
    (TArray [_ _] (box-items-type (malloc-allocator)))
    (TSlice [_] (box-items-type (malloc-allocator)))
    (TVec [_ _] (box-items-type (malloc-allocator)))
    (TNever [] (box-items-type (malloc-allocator)))
    (TCode [] (box-items-type (malloc-allocator)))
    (TExternRef [] (box-items-type (malloc-allocator)))
    (TCodeBuilder [] (box-items-type (malloc-allocator)))))
(defn t-fn-ret [(t (ptr Type))] (-> (ptr Type))
  (match (load t)
    (TFn [_ _ r] r)
    (TInt [_ _] (box-type (malloc-allocator) (TVoid)))
    (TFloat [_] (box-type (malloc-allocator) (TVoid)))
    (TBool [] (box-type (malloc-allocator) (TVoid)))
    (TVoid [] (box-type (malloc-allocator) (TVoid)))
    (TPtr [_] (box-type (malloc-allocator) (TVoid)))
    (TRef [_ _] (box-type (malloc-allocator) (TVoid)))
    (TStruct [_] (box-type (malloc-allocator) (TVoid)))
    (TArray [_ _] (box-type (malloc-allocator) (TVoid)))
    (TSlice [_] (box-type (malloc-allocator) (TVoid)))
    (TVec [_ _] (box-type (malloc-allocator) (TVoid)))
    (TApp [_ _] (box-type (malloc-allocator) (TVoid)))
    (TNever [] (box-type (malloc-allocator) (TVoid)))
    (TCode [] (box-type (malloc-allocator) (TVoid)))
    (TExternRef [] (box-type (malloc-allocator) (TVoid)))
    (TCodeBuilder [] (box-type (malloc-allocator) (TVoid)))))
(defn t-app-name [(t (ptr Type))] (-> (slice u8))
  (match (load t)
    (TApp [n _] n)
    (TInt [_ _] "")
    (TFloat [_] "")
    (TBool [] "")
    (TVoid [] "")
    (TPtr [_] "")
    (TRef [_ _] "")
    (TStruct [_] "")
    (TArray [_ _] "")
    (TSlice [_] "")
    (TVec [_ _] "")
    (TFn [_ _ _] "")
    (TNever [] "")
    (TCode [] "")
    (TExternRef [] "")
    (TCodeBuilder [] "")))
(defn box-items-type [(a (ptr Allocator))] (-> (ptr (ArrayList Type)))
  (box a (ArrayList Type) (al-new [Type] a)))

(defn type-list-eq [(xs (ptr (ArrayList Type))) (ys (ptr (ArrayList Type)))] (-> bool)
  (let [nx (al-len [Type] (load xs))
        ny (al-len [Type] (load ys))]
    (if (not (= nx ny))
        false
        (let [(mut i) 0
              (mut ok) true]
          (loop (if (>= (load i) nx)
                    (break)
                    (do
                      (when (not (type-eq (al-elem [Type] xs (load i)) (al-elem [Type] ys (load i))))
                        (store! ok false)
                        (break))
                      (set! i (primitive/iadd (load i) 1)))))
          (load ok)))))
(defn type-eq [(x (ptr Type)) (y (ptr Type))] (-> bool)
  (if (not (= (type-tag x) (type-tag y)))
      false
      (let [tg (type-tag x)]
        (cond (= tg (primitive/cast i64 0))
                (and (= (t-int-bits x) (t-int-bits y)) (booleq (t-int-signed x) (t-int-signed y)))
              (= tg (primitive/cast i64 1)) (= (t-int-bits x) (t-int-bits y))
              (= tg (primitive/cast i64 2)) true
              (= tg (primitive/cast i64 3)) true
              (= tg (primitive/cast i64 4)) (type-eq (t-inner x) (t-inner y))
              (= tg (primitive/cast i64 5)) (and (booleq (t-ref-mut x) (t-ref-mut y)) (type-eq (t-inner x) (t-inner y)))
              (= tg (primitive/cast i64 6)) (= (type-struct-name x) (type-struct-name y))
              (= tg (primitive/cast i64 7)) (and (= (t-arrn x) (t-arrn y)) (type-eq (t-inner x) (t-inner y)))
              (= tg (primitive/cast i64 8)) (type-eq (t-inner x) (t-inner y))
              (= tg (primitive/cast i64 9)) (and (= (t-arrn x) (t-arrn y)) (type-eq (t-inner x) (t-inner y)))
              (= tg (primitive/cast i64 10))
                (and (= (t-fn-cc x) (t-fn-cc y))
                     (and (type-list-eq (t-fn-params x) (t-fn-params y))
                          (type-eq (t-fn-ret x) (t-fn-ret y))))
              (= tg (primitive/cast i64 11))
                (and (= (t-app-name x) (t-app-name y))
                     (type-list-eq (t-fn-params x) (t-fn-params y)))
              :else true))))

(defn extern-eq [(x (ptr Extern)) (y (ptr Extern))] (-> bool)
  (and (= (.cc x) (.cc y))
       (and (type-list-eq (load (field x params)) (load (field y params)))
            (and (booleq (.variadic x) (.variadic y))
                 (type-eq (field x ret) (field y ret))))))

; ============================ foundation =============================
; display_name — strip the auto-referred "coil.core." prefix
; from a name for diagnostics. "coil.core." is 10 bytes.
(defn ty-str-join [(a (ptr Allocator)) (v (ptr (ArrayList Type)))] (-> (slice u8))
  (let [(mut out) ""
        n (al-len [Type] (load v))
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (when (> (load i) (primitive/cast i64 0)) (store! out (sconcat a (load out) " ")) 0)
                (let [tp (alloc/stack Type)]
                  (set! tp (al-get [Type] (load v) (load i)))
                  (set! out (sconcat a (load out) (ty-str a tp))))
                (set! i (primitive/iadd (load i) 1)))))
    (load out)))

; A synthetic associated type minted for an associated-type bound
; (check.coil::assoc-tp-name) is spelled `C$assoc$Get$K`. Render it readably as
; `<C as Get>::K` in diagnostics. No ordinary type name contains `$assoc$`, so
; `assoc-marker-at` returns -1 for every real type and this is a no-op there —
; existing ty-str output is byte-for-byte unchanged.
(defn assoc-marker-at [(s (slice u8))] (-> i64)
  (let [n (slice-len s)
        mk "$assoc$"
        mn (slice-len mk)
        (mut i) 0
        (mut r) -1]
    (loop (if (> (primitive/iadd (load i) mn) n)
              (break)
              (do
                (when (= (subslice [u8] s (load i) (primitive/iadd (load i) mn)) mk) (store! r (load i)) (break))
                (set! i (primitive/iadd (load i) 1)))))
    (load r)))
(defn last-dollar [(s (slice u8))] (-> i64)
  (let [n (slice-len s)
        (mut i) (primitive/isub n 1)
        (mut r) -1]
    (loop (if (< (load i) (primitive/cast i64 0))
              (break)
              (do
                (when (= (primitive/cast i64 (slice-get s (load i))) (primitive/cast i64 36))
                  (store! r (load i))
                  (break))
                (set! i (primitive/isub (load i) 1)))))
    (load r)))
(defn assoc-render [(a (ptr Allocator)) (s (slice u8))] (-> (slice u8))
  (let [mi (assoc-marker-at s)]
    (if (< mi (primitive/cast i64 0))
        s
        (let [base (subslice [u8] s 0 mi)
              rest (subslice [u8] s (primitive/iadd mi 7) (slice-len s))
              di (last-dollar rest)]
          (if (< di (primitive/cast i64 0))
              s
              (let [tr (subslice [u8] rest 0 di)
                    p (subslice [u8] rest (primitive/iadd di 1) (slice-len rest))]
                (sconcat a "<" (sconcat a base (sconcat a " as " (sconcat3 a tr ">::" p))))))))))

(defn ty-str [(a (ptr Allocator)) (t (ptr Type))] (-> (slice u8))
  (let [tg (type-tag t)]
    (cond (= tg (primitive/cast i64 12)) "!"
          (= tg (primitive/cast i64 14)) "externref"
          (= tg (primitive/cast i64 13)) "code"
          (= tg (primitive/cast i64 15)) "codebuilder"
          (= tg (primitive/cast i64 3)) "void"
          (= tg (primitive/cast i64 0)) (sconcat a (if (t-int-signed t) "i" "u") (i64->str a (t-int-bits t)))
          (= tg (primitive/cast i64 1)) (sconcat a "f" (i64->str a (t-int-bits t)))
          (= tg (primitive/cast i64 2)) "bool"
          (= tg (primitive/cast i64 4)) (sconcat3 a "(ptr " (ty-str a (t-inner t)) ")")
          (= tg (primitive/cast i64 5))
            (if (t-ref-mut t)
                (sconcat3 a "(mut " (ty-str a (t-inner t)) ")")
                (sconcat3 a "(ref " (ty-str a (t-inner t)) ")"))
          (= tg (primitive/cast i64 6)) (assoc-render a (type-struct-name t))
          (= tg (primitive/cast i64 7))
            (sconcat3 a
                      (sconcat3 a "(array " (ty-str a (t-inner t)) " ")
                      (i64->str a (t-arrn t))
                      ")")
          (= tg (primitive/cast i64 8)) (sconcat3 a "(slice " (ty-str a (t-inner t)) ")")
          (= tg (primitive/cast i64 9))
            (sconcat3 a
                      (sconcat3 a "(vec " (ty-str a (t-inner t)) " ")
                      (i64->str a (t-arrn t))
                      ")")
          (= tg (primitive/cast i64 10))
            (sconcat3 a
                      (sconcat3 a
                                (sconcat3 a "(fnptr " (t-fn-cc t) " [")
                                (ty-str-join a (t-fn-params t))
                                "] ")
                      (ty-str a (t-fn-ret t))
                      ")")
          :else
            (sconcat3 a
                      (sconcat3 a "(" (t-app-name t) " ")
                      (ty-str-join a (t-fn-params t))
                      ")"))))

; ---- qualify a Type in place ----------------
(defn qualify-type-list [(c (ptr Ctx)) (lst (ptr (ArrayList Type))) (tps (ptr (ArrayList (slice u8))))] (-> (Result i64
                                                                                                                    Diag))
  (let [n (al-len [Type] (load lst))
        (mut i) 0
        (mut err) (primitive/zeroed Diag)
        (mut failed) false]
    (loop (if (>= (load i) n)
              (break)
              (do
                (match (qualify-type c (al-elem [Type] lst (load i)) tps)
                  (Err [d] (do (set! err d) (set! failed true) (break)))
                  (Ok [_] 0))
                (set! i (primitive/iadd (load i) 1)))))
    (if (load failed) (Err (load err)) (Ok [i64 Diag] 0))))
(defn qualify-type [(c (ptr Ctx)) (typ (ptr Type)) (tps (ptr (ArrayList (slice u8))))] (-> (Result i64 Diag))
  (let [a (load (field c a))]
    (match (load typ)
      (TNever [] (Ok [i64 Diag] 0))
      (TCode [] (Ok [i64 Diag] 0))
      (TExternRef [] (Ok [i64 Diag] 0))
      (TCodeBuilder [] (Ok [i64 Diag] 0))
      (TBool [] (Ok [i64 Diag] 0))
      (TVoid [] (Ok [i64 Diag] 0))
      (TInt [_ _] (Ok [i64 Diag] 0))
      (TFloat [_] (Ok [i64 Diag] 0))
      (TStruct [nm]
               (if (set-contains tps nm)
                   (Ok [i64 Diag] 0)
                   (match (if (dyn-type-name? nm) (qualify-dyn-type c nm) (resolve c nm 1))
                     (Err [d] (Err [i64 Diag] d))
                     (Ok [nn]
                         (do (type-res-record (.m c) nm nn) (set! typ (TStruct nn)) (Ok [i64 Diag] 0))))))
      (TApp [nm args]
            (if (or (= nm "$pack-var") (= nm "$pack"))
                (qualify-type-list c args tps)
                (let [r0
                        (if (set-contains tps nm)
                            (Ok [i64 Diag] 0)
                            (match (resolve c nm 1)
                              (Err [d] (Err [i64 Diag] d))
                              (Ok [nn]
                                  (do
                                    (type-res-record (.m c) nm nn)
                                    (set! typ (TApp nn args))
                                    (Ok [i64 Diag] 0)))))]
                  (match r0
                    (Err [d] (Err [i64 Diag] d))
                    (Ok [_] (qualify-type-list c args tps))))))
      (TPtr [inner] (qualify-type c inner tps))
      (TRef [mu inner] (qualify-type c inner tps))
      (TArray [inner nn] (qualify-type c inner tps))
      (TSlice [inner] (qualify-type c inner tps))
      (TVec [inner nn] (qualify-type c inner tps))
      (TFn [cc params ret]
           (match (resolve c cc 3)
             (Err [d] (Err [i64 Diag] d))
             (Ok [ncc]
                 (do
                   (set! typ
                         (TFn
                           :cc ncc
                           :params params
                           :ret ret))
                   (match (qualify-type-list c params tps)
                     (Err [d] (Err [i64 Diag] d))
                     (Ok [_] (qualify-type c ret tps))))))))))

; ---- qualify Exprs / quasi / lists ----------
(defn qualify-expr-list [(c (ptr Ctx)) (lst (ptr (ArrayList Expr))) (tps (ptr (ArrayList (slice u8))))] (-> (Result i64
                                                                                                                    Diag))
  (let [n (al-len [Expr] (load lst))
        (mut i) 0
        (mut err) (primitive/zeroed Diag)
        (mut failed) false]
    (loop (if (>= (load i) n)
              (break)
              (do
                (match (qualify-expr c (al-elem [Expr] lst (load i)) tps)
                  (Err [d] (do (set! err d) (set! failed true) (break)))
                  (Ok [_] 0))
                (set! i (primitive/iadd (load i) 1)))))
    (if (load failed) (Err (load err)) (Ok [i64 Diag] 0))))
(defn qualify-bind-list [(c (ptr Ctx)) (binds (ptr (ArrayList Bind))) (tps (ptr (ArrayList (slice u8))))] (-> (Result i64
                                                                                                                      Diag))
  (let [n (al-len [Bind] (load binds))
        (mut i) 0
        (mut err) (primitive/zeroed Diag)
        (mut failed) false]
    (loop (if (>= (load i) n)
              (break)
              (do
                (match (qualify-expr c (field (al-elem [Bind] binds (load i)) value) tps)
                  (Err [d] (do (set! err d) (set! failed true) (break)))
                  (Ok [_] 0))
                (set! i (primitive/iadd (load i) 1)))))
    (if (load failed) (Err (load err)) (Ok [i64 Diag] 0))))
(defn qualify-arm-list [(c (ptr Ctx)) (arms (ptr (ArrayList Arm))) (tps (ptr (ArrayList (slice u8))))] (-> (Result i64
                                                                                                                   Diag))
  (let [n (al-len [Arm] (load arms))
        (mut i) 0
        (mut err) (primitive/zeroed Diag)
        (mut failed) false]
    (loop (if (>= (load i) n)
              (break)
              (do
                (let [ap (al-elem [Arm] arms (load i))]
                  ; `_` is the catch-all arm, not a name to look up: it belongs to no
                  ; module and resolving it would report an unknown variant.
                  (if (arm-wildcard? ap)
                      (match (qualify-expr c (field ap body) tps)
                        (Err [d] (do (set! err d) (set! failed true) (break)))
                        (Ok [_] 0))
                      (match (resolve c (.variant ap) 0)
                        (Err [d] (do (set! err d) (set! failed true) (break)))
                        (Ok [nv]
                            (do
                              (set! (.variant ap) nv)
                              (match (qualify-expr c (field ap body) tps)
                                (Err [d] (do (set! err d) (set! failed true) (break)))
                                (Ok [_] 0)))))))
                (set! i (primitive/iadd (load i) 1)))))
    (if (load failed) (Err (load err)) (Ok [i64 Diag] 0))))
(defn qualify-quasi-list [(c (ptr Ctx)) (items (ptr (ArrayList Quasi))) (tps (ptr (ArrayList (slice u8))))] (-> (Result i64
                                                                                                                        Diag))
  (let [n (al-len [Quasi] (load items))
        (mut i) 0
        (mut err) (primitive/zeroed Diag)
        (mut failed) false]
    (loop (if (>= (load i) n)
              (break)
              (do
                (match (qualify-quasi c (al-elem [Quasi] items (load i)) tps)
                  (Err [d] (do (set! err d) (set! failed true) (break)))
                  (Ok [_] 0))
                (set! i (primitive/iadd (load i) 1)))))
    (if (load failed) (Err (load err)) (Ok [i64 Diag] 0))))
(defn qualify-quasi [(c (ptr Ctx)) (qp (ptr Quasi)) (tps (ptr (ArrayList (slice u8))))] (-> (Result i64 Diag))
  (match (load qp)
    (QLit [_] (Ok [i64 Diag] 0))
    (QUnquote [e] (qualify-expr c e tps))
    (QSplice [e] (qualify-expr c e tps))
    (QList [items] (qualify-quasi-list c items tps))
    (QVector [items] (qualify-quasi-list c items tps))))
(defn qualify-expr [(c (ptr Ctx)) (ep (ptr Expr)) (tps (ptr (ArrayList (slice u8))))] (-> (Result i64 Diag))
  (let [a (load (field c a))]
    (try (do
           (match (load (field ep kind))
             (EInt [_] 0)
             (EFloat [_] 0)
             (EBool [_] 0)
             (EStr [_] 0)
             (ECStr [_] 0)
             (EVar [name]
                   (match (resolve c name 5)
                     (Err [d] (break :try (Err d)))
                     (Ok [nn]
                         (do
                           (when (not (= nn name)) (store! (field ep kind) (EVar nn)) 0)
                           0))))
             (EZeroed [t]
                      (do
                        (let [tp (alloc/stack Type)]
                          (store! tp t)
                          (try! (qualify-type c tp tps))
                          (store! (field ep kind) (EZeroed (load tp))))
                        0))
             (EBorrow [mu place] (do (try! (qualify-expr c place tps)) 0))
             (ELet [binds body] (do (try! (qualify-bind-list c binds tps)) (try! (qualify-expr-list c body tps)) 0))
             (EBin [op lhs rhs] (do (try! (qualify-expr c lhs tps)) (try! (qualify-expr c rhs tps)) 0))
             (ENot [inner] (do (try! (qualify-expr c inner tps)) 0))
             (ECmp [op lhs rhs] (do (try! (qualify-expr c lhs tps)) (try! (qualify-expr c rhs tps)) 0))
             (EIf [cnd thn els]
                  (do (try! (qualify-expr c cnd tps)) (try! (qualify-expr c thn tps)) (try! (qualify-expr c els tps)) 0))
             (EDo [body] (do (try! (qualify-expr-list c body tps)) 0))
             (ECall [func type_args args]
                    (do
                      (let [nf (try! (resolve c func 0))]
                        ; Was the head written bare? (No module dot, no alias
                        ; slash, no Trait:: qualifier.) The checker's arity-
                        ; directed fallback consults this — only a spelling THIS
                        ; pass qualified may be reinterpreted as a trait method.
                        (impl-qual-record! (load (field ep nid))
                                           (if (and (not (has-dot func))
                                                    (and (< (find-slash func) (primitive/cast i64 0))
                                                         (< (find-coloncolon func) (primitive/cast i64 0))))
                                               1
                                               0))
                        (store! (field ep kind)
                                (ECall
                                  :func nf
                                  :type_args type_args
                                  :args args))
                        ; A `Trait::method` qualified call (gen-6) is validated in the checker
                        ; (synth-call splits it and pins the trait), so it is not an undefined
                        ; reference here even though the whole head is not a def-table name.
                        (when (and (load (field c strict))
                                   (and (< (find-coloncolon nf) (primitive/cast i64 0))
                                        (and (not (= nf func))
                                             (and (not (has-dot nf))
                                                  (not (set-contains (load (field c bareok)) nf))))))
                          (break  ; `ep` IS the call node — its span was right here and simply unused,
                                 ; so the language's most common error lost its location the moment a
                                 ; file declared a module (i.e. in every real multi-file project). The
                                 ; message itself now also carries the did-you-mean suggestion (diag-6).
                                 :try
                                 (Err (dwspan (derr (undef-msg-at a c nf (load (field ep source)) (load (field ep lo))))
                                              (load (field ep source))
                                              (load (field ep lo))
                                              (load (field ep hi))
                                              (load (field ep ctxt)))))))
                      (try! (qualify-type-list c type_args tps))
                      (try! (qualify-expr-list c args tps))
                      0))
             (ENamedCall [func type_args names args]
                         (do
                           ; Sum variants live in the value namespace; struct
                           ; constructors use the type's name because structs had
                           ; no callable constructor before named construction.
                           (let [value-name (try! (resolve c func 0))
                                 type-name (try! (resolve c func 1))
                                 nf (if (not (= type-name func)) type-name value-name)]
                             (impl-qual-record! (load (field ep nid))
                                                (if (and (not (has-dot func))
                                                         (and (< (find-slash func) (primitive/cast i64 0))
                                                              (< (find-coloncolon func) (primitive/cast i64 0))))
                                                    1
                                                    0))
                             (store! (field ep kind)
                                     (ENamedCall
                                       :func nf
                                       :type_args type_args
                                       :names names
                                       :args args)))
                           (try! (qualify-type-list c type_args tps))
                           (try! (qualify-expr-list c args tps))
                           0))
             (EAlloc [storage t]
                     (do
                       (let [tp (alloc/stack Type)]
                         (store! tp t)
                         (try! (qualify-type c tp tps))
                         (store! (field ep kind) (EAlloc storage (load tp))))
                       0))
             (EField [p fname] (do (try! (qualify-expr c p tps)) 0))
             (ELoad [inner] (do (try! (qualify-expr c inner tps)) 0))
             (EStore [p val] (do (try! (qualify-expr c p tps)) (try! (qualify-expr c val tps)) 0))
             (EIndex [p idx] (do (try! (qualify-expr c p tps)) (try! (qualify-expr c idx tps)) 0))
             (ECast [t inner]
                    (do
                      (let [tp (alloc/stack Type)]
                        (store! tp t)
                        (try! (qualify-type c tp tps))
                        (store! (field ep kind) (ECast (load tp) inner)))
                      (try! (qualify-expr c inner tps))
                      0))
             (EAscribe [t inner]
                       (do
                         (let [tp (alloc/stack Type)]
                           (store! tp t)
                           (try! (qualify-type c tp tps))
                           (store! (field ep kind) (EAscribe (load tp) inner)))
                         (try! (qualify-expr c inner tps))
                         0))
             (EArrayLit [items] (do (try! (qualify-expr-list c items tps)) 0))
             (EMakeSlice [data elem len] (do (try! (qualify-expr c data tps)) 0))
             (ESizeOf [t]
                      (do
                        (let [tp (alloc/stack Type)]
                          (store! tp t)
                          (try! (qualify-type c tp tps))
                          (store! (field ep kind) (ESizeOf (load tp))))
                        0))
             (EAlignOf [t]
                       (do
                         (let [tp (alloc/stack Type)]
                           (store! tp t)
                           (try! (qualify-type c tp tps))
                           (store! (field ep kind) (EAlignOf (load tp))))
                         0))
             (EOffsetOf [t fname]
                        (do
                          (let [tp (alloc/stack Type)]
                            (store! tp t)
                            (try! (qualify-type c tp tps))
                            (store! (field ep kind) (EOffsetOf (load tp) fname)))
                          0))
             (EBitGet [p fname] (do (try! (qualify-expr c p tps)) 0))
             (EBitSet [p fname val] (do (try! (qualify-expr c p tps)) (try! (qualify-expr c val tps)) 0))
             (EFree [inner] (do (try! (qualify-expr c inner tps)) 0))
             (EErase [trait_name inner]
                     (do
                       (let [tp (alloc/stack Type)]
                         (store! tp (TStruct trait_name))
                         (try! (qualify-type c tp tps))
                         (store! (field ep kind) (EErase (type-struct-name tp) inner)))
                       (try! (qualify-expr c inner tps))
                       0))
             (EMatch [scrut arms] (do (try! (qualify-expr c scrut tps)) (try! (qualify-arm-list c arms tps)) 0))
             (EFnPtrOf [nm] (do (let [nn (try! (resolve c nm 0))] (store! (field ep kind) (EFnPtrOf nn))) 0))
             (ECallPtr [fp args] (do (try! (qualify-expr c fp tps)) (try! (qualify-expr-list c args tps)) 0))
             (ELoop [label body] (do (try! (qualify-expr-list c body tps)) 0))
             (EBreak [label value] (do (match value (Some [vp] (try! (qualify-expr c vp tps))) (None [] 0)) 0))
             (EContinue [label] 0)
             (ELlvmIr [result args body]
                      (do
                        (let [tp (alloc/stack Type)]
                          (store! tp result)
                          (try! (qualify-type c tp tps))
                          (store! (field ep kind)
                                  (ELlvmIr
                                    :result (load tp)
                                    :args args
                                    :body body)))
                        (try! (qualify-expr-list c args tps))
                        0))
             (ETypeQuery [q t]
                         (do
                           (let [tp (alloc/stack Type)]
                             (store! tp t)
                             (try! (qualify-type c tp tps))
                             (store! (field ep kind) (ETypeQuery q (load tp))))
                           0))
             (EFieldMeta [meta t idx]
                         (do
                           (let [tp (alloc/stack Type)]
                             (store! tp t)
                             (try! (qualify-type c tp tps))
                             (store! (field ep kind)
                                     (EFieldMeta
                                       :meta meta
                                       :ty (load tp)
                                       :idx idx)))
                           (try! (qualify-expr c idx tps))
                           0))
             (EFieldIndex [t nm]
                          (do
                            (let [tp (alloc/stack Type)]
                              (store! tp t)
                              (try! (qualify-type c tp tps))
                              (store! (field ep kind) (EFieldIndex (load tp) nm)))
                            (try! (qualify-expr c nm tps))
                            0))
             (EQuote [form] 0)
             (ECodeOp [op args] (do (try! (qualify-expr-list c args tps)) 0))
             (EQuasi [q] (do (let [qp (alloc/stack Quasi)] (store! qp q) (try! (qualify-quasi c qp tps))) 0))
             (EComptime [inner] (do (try! (qualify-expr c inner tps)) 0))
             ; ---- check-introduced variants: cannot occur during resolve (they are
             ; produced by the LATER check pass), so reaching them here is a bug. ----
             (ESpillRef [_] (do (unimplemented "qualify/ESpillRef") 0))
             (EConstruct [_ _ _] (do (unimplemented "qualify/EConstruct") 0))
             (ETraitCall [_ _ _ _] (do (unimplemented "qualify/ETraitCall") 0))
             (EDynDispatch [_ _ _ _ _ _ _ _] (do (unimplemented "qualify/EDynDispatch") 0))
             (EMakeDyn [_ _ _ _] (do (unimplemented "qualify/EMakeDyn") 0))
             (EStaticRef [_] (do (unimplemented "qualify/EStaticRef") 0)))
           (Ok 0)))))

; ---- qualify per-section helpers ---------
(defn qualify-param-types [(c (ptr Ctx)) (ps (ptr (ArrayList Param))) (tps (ptr (ArrayList (slice u8))))] (-> (Result i64
                                                                                                                      Diag))
  (let [n (al-len [Param] (load ps))
        (mut i) 0
        (mut err) (primitive/zeroed Diag)
        (mut failed) false]
    (loop (if (>= (load i) n)
              (break)
              (do
                (match (qualify-type c (field (al-elem [Param] ps (load i)) ty) tps)
                  (Err [d] (do (set! err d) (set! failed true) (break)))
                  (Ok [_] 0))
                (set! i (primitive/iadd (load i) 1)))))
    (if (load failed) (Err (load err)) (Ok [i64 Diag] 0))))
(defn qualify-field-types [(c (ptr Ctx)) (fs (ptr (ArrayList Field))) (tps (ptr (ArrayList (slice u8))))] (-> (Result i64
                                                                                                                      Diag))
  (let [n (al-len [Field] (load fs))
        (mut i) 0
        (mut err) (primitive/zeroed Diag)
        (mut failed) false]
    (loop (if (>= (load i) n)
              (break)
              (do
                (match (qualify-type c (field (al-elem [Field] fs (load i)) ty) tps)
                  (Err [d] (do (set! err d) (set! failed true) (break)))
                  (Ok [_] 0))
                (set! i (primitive/iadd (load i) 1)))))
    (if (load failed) (Err (load err)) (Ok [i64 Diag] 0))))
; `resolve` is deliberately lenient: a name it cannot find passes through UNQUALIFIED
; (bare), because some names resolve later (builtins, coil.core methods). A real trait
; always resolves to `module.Trait` — so a bound trait that comes back with no dot names
; a trait that exists nowhere. That was accepted silently: `(defn f [(T NoSuchTrait)] …)`
; compiled, and only failed at the CALL site as "i64 does not implement NoSuchTrait" —
; which is nonsense, since no type could ever implement a trait that doesn't exist. Catch
; it here, at the definition, where it belongs.
; THE single trait-name resolver for every bound position (defn/defstruct/defsum/impl
; trait, and `:requires` supertraits). `resolve` is lenient — an unknown name passes
; through bare — but a real trait (kind 2) always comes back as `module.Trait`, so a
; result with no dot names a trait that exists nowhere. Every bound position delegates
; here, so an unknown trait produces the identical located "unknown trait '…' in bound".
(defn qualify-trait-name [(c (ptr Ctx)) (raw (slice u8))] (-> (Result (slice u8) Diag))
  (let [a (load (field c a))]
    (match (resolve c raw 2)
      (Err [d] (Err [(slice u8) Diag] d))
      (Ok [nn]
          (if (has-dot nn)
              (Ok [(slice u8) Diag] nn)
              (Err [(slice u8) Diag] (derr (sconcat3 a "unknown trait '" raw "' in bound"))))))))
(defn qualify-trait-names [(c (ptr Ctx)) (lst (ptr (ArrayList (slice u8))))] (-> (Result i64 Diag))
  (let [n (al-len [(slice u8)] (load lst))
        (mut i) 0
        (mut err) (primitive/zeroed Diag)
        (mut failed) false]
    (loop (if (>= (load i) n)
              (break)
              (do
                (let [raw (al-get [(slice u8)] (load lst) (load i))]
                  (match (qualify-trait-name c raw)
                    (Err [d] (do (set! err d) (set! failed true) (break)))
                    (Ok [nn] (set! (al-elem [(slice u8)] lst (load i)) nn))))
                (set! i (primitive/iadd (load i) 1)))))
    (if (load failed) (Err (load err)) (Ok [i64 Diag] 0))))
(defn qualify-bound-list [(c (ptr Ctx)) (bounds (ptr (ArrayList Bound)))] (-> (Result i64 Diag))
  (let [n (al-len [Bound] (load bounds))
        (mut i) 0
        (mut err) (primitive/zeroed Diag)
        (mut failed) false]
    (loop (if (>= (load i) n)
              (break)
              (do
                (match (qualify-trait-names c (load (field (al-elem [Bound] bounds (load i)) traits)))
                  (Err [d] (do (set! err d) (set! failed true) (break)))
                  (Ok [_] 0))
                (set! i (primitive/iadd (load i) 1)))))
    (if (load failed) (Err (load err)) (Ok [i64 Diag] 0))))

; Is this signature Code-signed (every parameter Code, return Code)? Local twin
; of comptime's type-is-code/all-params-code — resolve sits below comptime in
; the module layering, so it cannot import them.
(defn rs-sig-is-code? [(fp (ptr Func))] (-> bool)
  (match (.ret fp)
    (TCode []
           (let [ps (load (field fp params))
                 n (al-len [Param] (load ps))
                 (mut i) 0
                 (mut ok) true]
             (loop (if (>= (load i) n)
                       (break)
                       (do
                         (match (.ty (al-elem [Param] ps (load i)))
                           (TCode [] 0)
                           (_ (do (set! ok false) (break))))
                         (set! i (primitive/iadd (load i) 1)))))
             (load ok)))
    (_ false)))

; The SIGNATURE (name, cc, bounds, param/return types). An error here is FATAL: an
; unqualified name or a bad type corrupts the shared tables the checker reads, so
; continuing past it cascades. These abort the pipeline as before.
(defn qualify-func-sig [(c (ptr Ctx)) (fp (ptr Func))] (-> (Result i64 Diag))
  (let [a (load (field c a))
        m (.m c)
        tps (load (field fp type_params))]
    (try (do
           ; `main` stays unqualified for the linker — UNLESS it is Code-signed.
           ; A code->code `main` (docs/design/RUN_METAPROGRAMS.md) can never be a
           ; linker entry (drop-code-funcs removes it), and left bare it loses its
           ; module identity: module-of "main" is None, so the definition-time
           ; tower judges its body without the module's imports and wrongly
           ; expands cross-module metaprogram calls like (sd/desugar-inc prog).
           (when (not (and (= (load (field fp name)) "main")
                           (not (rs-sig-is-code? fp))))
             (store! (field fp name) (sconcat3 a m "." (load (field fp name))))
             0)
           (store! (field fp cc)
                   (match (resolve c (load (field fp cc)) 3)
                     (Ok [$g13090] $g13090)
                     (Err [$g13091] (break :try (Err $g13091)))))
           (try! (qualify-bound-list c (load (field fp bounds))))
           (try! (qualify-param-types c (load (field fp params)) tps))
           (try! (qualify-type c (field fp ret) tps))
           (Ok 0)))))

; The BODY. An error here is RECOVERABLE: one function's body cannot corrupt another,
; so q-funcs collects it and moves on, and the checker skips this body while keeping
; the (already-resolved) signature. `fname` names the enclosing function in any error.
(defn qualify-func-body [(c (ptr Ctx)) (fp (ptr Func))] (-> (Result i64 Diag))
  (let [tps (load (field fp type_params))]
    (try (do
           (store! (field c fname) (load (field fp name)))
           (let [anns (load (field fp annotations))
                 an (al-len [Annotation] (load anns))
                 (mut ai) 0]
             (loop (if (>= (load ai) an)
                       (break)
                       (do
                         (try! (qualify-expr c
                                             (field (al-elem [Annotation] anns (load ai)) value)
                                             tps))
                         (store! ai (primitive/iadd (load ai) 1))))))
           (try! (qualify-expr-list c (load (field fp body)) tps))
           (store! (field c fname) "")
           (Ok 0)))))

(defn qualify-one-func [(c (ptr Ctx)) (fp (ptr Func))] (-> (Result i64 Diag))
  (try (do (try! (qualify-func-sig c fp)) (try! (qualify-func-body c fp)) (Ok 0))))
(defn qualify-one-struct [(c (ptr Ctx)) (sp (ptr StructDef))] (-> (Result i64 Diag))
  (let [a (load (field c a))
        m (.m c)
        tps (load (field sp type_params))]
    (set! (.name sp) (sconcat3 a m "." (.name sp)))
    (try (do
           (try! (qualify-bound-list c (load (field sp bounds))))  ; resolve + reject unknown traits
           (try! (qualify-field-types c (load (field sp fields)) tps))
           (Ok 0)))))
(defn qualify-variants [(c (ptr Ctx))
                        (vs (ptr (ArrayList Variant)))
                        (m (slice u8))
                        (a (ptr Allocator))
                        (tps (ptr (ArrayList (slice u8))))] (-> (Result i64 Diag))
  (let [n (al-len [Variant] (load vs))
        (mut i) 0
        (mut err) (primitive/zeroed Diag)
        (mut failed) false]
    (loop (if (>= (load i) n)
              (break)
              (do
                (let [vp (al-elem [Variant] vs (load i))]
                  (set! (.name vp) (sconcat3 a m "." (.name vp)))
                  (match (qualify-field-types c (load (field vp fields)) tps)
                    (Err [d] (do (set! err d) (set! failed true) (break)))
                    (Ok [_] 0)))
                (set! i (primitive/iadd (load i) 1)))))
    (if (load failed) (Err (load err)) (Ok [i64 Diag] 0))))
(defn qualify-one-sum [(c (ptr Ctx)) (sp (ptr SumDef))] (-> (Result i64 Diag))
  (let [a (load (field c a))
        m (.m c)
        tps (load (field sp type_params))]
    (set! (.name sp) (sconcat3 a m "." (.name sp)))
    (try (do
           (try! (qualify-bound-list c (load (field sp bounds))))  ; resolve + reject unknown traits
           (try! (qualify-variants c (load (field sp variants)) m a tps))
           (Ok 0)))))
(defn qualify-one-conv [(c (ptr Ctx)) (cp (ptr Convention))] (-> (Result i64 Diag))
  (let [a (load (field c a))
        m (.m c)]
    (when (not (= (load (field cp name)) "c"))
      (store! (field cp name) (sconcat3 a m "." (load (field cp name))))
      0)
    (Ok [i64 Diag] 0)))
(defn qualify-one-extern [(c (ptr Ctx)) (ep (ptr Extern)) (empty (ptr (ArrayList (slice u8))))] (-> (Result i64 Diag))
  (let [a (load (field c a))
        m (.m c)]
    (try (do
           (store! (field ep name) (sconcat3 a m "." (load (field ep name))))
           (try! (qualify-type-list c (load (field ep params)) empty))
           (try! (qualify-type c (field ep ret) empty))
           (Ok 0)))))
(defn qualify-one-export [(c (ptr Ctx)) (ep (ptr ExportC))] (-> (Result i64 Diag))
  (match (resolve c (.name ep) 0)
    (Err [d] (Err [i64 Diag] d))
    (Ok [nn] (do (set! (.name ep) nn) (Ok [i64 Diag] 0)))))
(defn qualify-one-assert [(c (ptr Ctx)) (ap (ptr StaticAssert)) (empty (ptr (ArrayList (slice u8))))] (-> (Result i64
                                                                                                                  Diag))
  (qualify-expr c (field ap cnd) empty))
(defn qualify-one-const [(c (ptr Ctx)) (kp (ptr Const)) (empty (ptr (ArrayList (slice u8))))] (-> (Result i64 Diag))
  (try (do
         (store! (field kp name)
                 (sconcat3 (load (field c a)) (load (field c m)) "." (load (field kp name))))
         (match (load (field kp ty))
           (Some [t]
                 (let [tp (alloc/stack Type)]
                   (store! tp t)
                   (try! (qualify-type c tp empty))
                   (store! (field kp ty) (Some (load tp)))
                   0))
           (None [] 0))
         (try! (qualify-expr c (field kp value) empty))
         (Ok 0))))
(defn qualify-trait-methods [(c (ptr Ctx)) (ms (ptr (ArrayList TraitMethod))) (tps (ptr (ArrayList (slice u8))))] (-> (Result i64
                                                                                                                              Diag))
  (let [n (al-len [TraitMethod] (load ms))
        (mut i) 0
        (mut err) (primitive/zeroed Diag)
        (mut failed) false]
    (loop (if (>= (load i) n)
              (break)
              (do
                (let [mp (al-elem [TraitMethod] ms (load i))]
                  (let [anns (load (field mp annotations))
                        an (al-len [Annotation] (load anns))
                        (mut ai) 0]
                    (loop (if (>= (load ai) an)
                              (break)
                              (do
                                (match (qualify-expr c (field (al-elem [Annotation] anns (load ai)) value) tps)
                                  (Err [d] (do (set! err d) (set! failed true) (break)))
                                  (Ok [_] 0))
                                (set! ai (primitive/iadd (load ai) 1))))))
                  (unless (load failed)
                    (match (qualify-param-types c (load (field mp params)) tps)
                      (Err [d] (do (store! err d) (store! failed true) (break)))
                      (Ok [_]
                          (match (qualify-type c (field mp ret) tps)
                            (Err [d] (do (store! err d) (store! failed true) (break)))
                            (Ok [_] 0))))))
                (set! i (primitive/iadd (load i) 1)))))
    (if (load failed) (Err (load err)) (Ok [i64 Diag] 0))))
(defn qualify-one-trait [(c (ptr Ctx)) (tp (ptr TraitDef))] (-> (Result i64 Diag))
  (try (let [a (load (field c a))
             m (load (field c m))
             (mut tl) (al-new [(slice u8)] a)]
         (al-push! (mut tl) (load (field tp self_param)))
         ; extra trait type parameters are in scope in method signatures too. gen-8 guard:
         ; an extra param that NAMES A KNOWN TRAIT was almost certainly meant as a supertrait
         ; (the two used to share this vector), so reject it with a pointer at `:requires`
         ; rather than silently accepting it as an associated-type parameter.
         (let [xs (load (field tp type_params))
               nx (al-len [(slice u8)] (load xs))
               (mut xi) 0]
           (loop (if (>= (load xi) nx)
                     (break)
                     (do
                       (let [pn (al-get [(slice u8)] (load xs) (load xi))]
                         (when (and (not (and (>= (slice-len pn) 3)
                                              (= (subslice pn (primitive/isub (slice-len pn) 3) (slice-len pn)) "...")))
                                    (has-dot (try! (resolve c pn 2))))
                           (break :try
                                    (Err (derr (sconcat a
                                                        (sconcat3 a
                                                                  "deftrait: type parameter '"
                                                                  pn
                                                                  "' names a trait — if you meant a supertrait, write ':requires [")
                                                        (sconcat a
                                                                 pn
                                                                 "]'; if you meant an associated-type parameter, rename it"))))))
                         (al-push! (mut tl) pn))
                       (store! xi (primitive/iadd (load xi) 1))))))
         ; qualify the `:requires` supertrait names exactly as trait bounds are qualified —
         ; an unknown supertrait is a located "unknown trait" error, and the stored names
         ; become the canonical qualified ones the checker matches impls against.
         (try! (qualify-trait-names c (load (field tp requires))))
         (let [tlb (unwrap-ptr [(ArrayList (slice u8))] (create [(ArrayList (slice u8))] a))]
           (store! tlb (load tl))
           (store! (field tp name) (sconcat3 a m "." (load (field tp name))))
           (qualify-trait-methods c (load (field tp methods)) tlb)))))
(defn qualify-impl-method [(c (ptr Ctx)) (fp (ptr Func)) (tps (ptr (ArrayList (slice u8))))] (-> (Result i64 Diag))
  (try
       ; bounds too — an impl method now carries its impl's bounds (`(impl [(T Eq)] …)`),
       ; and an unqualified `Eq` here would never match the checker's `coil.core.Eq`
       (do
         (try! (qualify-bound-list c (load (field fp bounds))))
         (try! (qualify-param-types c (load (field fp params)) tps))
         (try! (qualify-type c (field fp ret) tps))
         (let [anns (load (field fp annotations))
               an (al-len [Annotation] (load anns))
               (mut ai) 0]
           (loop (if (>= (load ai) an)
                     (break)
                     (do
                       (try! (qualify-expr c
                                           (field (al-elem [Annotation] anns (load ai)) value)
                                           tps))
                       (store! ai (primitive/iadd (load ai) 1))))))
         (try! (qualify-expr-list c (load (field fp body)) tps))
         (Ok 0))))
(defn qualify-impl-methods [(c (ptr Ctx)) (ms (ptr (ArrayList Func)))] (-> (Result i64 Diag))
  (let [n (al-len [Func] (load ms))
        (mut i) 0
        (mut err) (primitive/zeroed Diag)
        (mut failed) false]
    (loop (if (>= (load i) n)
              (break)
              (do
                (let [fp (al-elem [Func] ms (load i))]
                  (match (qualify-impl-method c fp (load (field fp type_params)))
                    (Err [d] (do (set! err d) (set! failed true) (break)))
                    (Ok [_] 0)))
                (set! i (primitive/iadd (load i) 1)))))
    (if (load failed) (Err (load err)) (Ok [i64 Diag] 0))))
(defn qualify-one-impl [(c (ptr Ctx)) (ip (ptr ImplDef)) (empty (ptr (ArrayList (slice u8))))] (-> (Result i64 Diag))
  (let [a (load (field c a))]
    (try
         ; The trait being implemented is a bound position too — resolve it through the
         ; ONE shared helper so an unknown trait errors identically to a defn/struct/sum
         ; bound (was: lenient `resolve`, so an unknown impl trait slipped past here and was
         ; caught late in the checker with a divergent "impl: unknown trait" message).
         (do
           (when (impl-is-trait ip)
             (store! (field ip kind) (TraitImpl (try! (qualify-trait-name c (impl-trait-name ip))))))
           ; A blanket impl — `(impl [T] Show T)`, the implementing type IS a bare type
           ; param — was accepted and then never matched any receiver, so it was dead code
           ; that looked live: the user got no error at the impl and "does not implement" at
           ; every call. Reject it at the impl (blanket impls / specialization over a bare
           ; param are not supported).
           (match (load (field ip self_type))
             (TStruct [nm]
                      (when (set-contains (load (field ip type_params)) nm)
                        (break :try
                                 (Err (derr (sconcat3 a
                                                      "cannot impl on a bare type parameter '"
                                                      nm
                                                      "'; the implementing type must be a concrete type or type constructor"))))))
             (_ 0))
           ; Qualify the implementing type (the impl's own type params stay
           ; unqualified — scalars and `slice` are structurally exempt), then
           ; re-derive the dispatch base name from the qualified type.
           (try! (qualify-type c (field ip self_type) (load (field ip type_params))))
           (store! (field ip for_type) (impl-base-name a (field ip self_type)))
           (try! (qualify-impl-methods c (load (field ip methods))))
           (Ok 0)))))

; SIGNATURE errors abort (fatal, corrupt shared tables); BODY errors are collected
; into the sink and the loop continues, so a batch of undefined-function mistakes is
; reported in ONE pass instead of one-recompile-at-a-time. The checker later skips
; every poisoned body while keeping its resolved signature, so callers don't cascade.
(defn q-funcs [(c (ptr Ctx)) (p (ptr Program))] (-> (Result i64 Diag))
  (let [fs (load (field p funcs))
        n (al-len [Func] (load fs))
        (mut i) 0
        (mut err) (primitive/zeroed Diag)
        (mut failed) false]
    (loop (if (>= (load i) n)
              (break)
              (do
                (let [fp (al-elem [Func] fs (load i))]
                  (match (qualify-func-sig c fp)
                    (Err [d] (do (set! err d) (set! failed true) (break)))
                    (Ok [_]
                        (match (qualify-func-body c fp)
                          (Err [d]
                               (do
                                 (al-push! (mut (load (field c diags))) d)
                                 (al-push! (mut (load (field c poisoned)))
                                           (.name fp))
                                 (set! (.fname c) "")
                                 0))
                          (Ok [_] 0)))))
                (set! i (primitive/iadd (load i) 1)))))
    (if (load failed) (Err (load err)) (Ok [i64 Diag] 0))))
(defn q-structs [(c (ptr Ctx)) (p (ptr Program))] (-> (Result i64 Diag))
  (let [fs (load (field p structs))
        n (al-len [StructDef] (load fs))
        (mut i) 0
        (mut err) (primitive/zeroed Diag)
        (mut failed) false]
    (loop (if (>= (load i) n)
              (break)
              (do
                (match (qualify-one-struct c (al-elem [StructDef] fs (load i)))
                  (Err [d] (do (set! err d) (set! failed true) (break)))
                  (Ok [_] 0))
                (set! i (primitive/iadd (load i) 1)))))
    (if (load failed) (Err (load err)) (Ok [i64 Diag] 0))))
(defn q-sums [(c (ptr Ctx)) (p (ptr Program))] (-> (Result i64 Diag))
  (let [fs (load (field p sums))
        n (al-len [SumDef] (load fs))
        (mut i) 0
        (mut err) (primitive/zeroed Diag)
        (mut failed) false]
    (loop (if (>= (load i) n)
              (break)
              (do
                (match (qualify-one-sum c (al-elem [SumDef] fs (load i)))
                  (Err [d] (do (set! err d) (set! failed true) (break)))
                  (Ok [_] 0))
                (set! i (primitive/iadd (load i) 1)))))
    (if (load failed) (Err (load err)) (Ok [i64 Diag] 0))))
(defn q-convs [(c (ptr Ctx)) (p (ptr Program))] (-> (Result i64 Diag))
  (let [fs (load (field p conventions))
        n (al-len [Convention] (load fs))
        (mut i) 0
        (mut err) (primitive/zeroed Diag)
        (mut failed) false]
    (loop (if (>= (load i) n)
              (break)
              (do
                (match (qualify-one-conv c (al-elem [Convention] fs (load i)))
                  (Err [d] (do (set! err d) (set! failed true) (break)))
                  (Ok [_] 0))
                (set! i (primitive/iadd (load i) 1)))))
    (if (load failed) (Err (load err)) (Ok [i64 Diag] 0))))
(defn q-externs [(c (ptr Ctx)) (p (ptr Program)) (empty (ptr (ArrayList (slice u8))))] (-> (Result i64 Diag))
  (let [fs (load (field p externs))
        n (al-len [Extern] (load fs))
        (mut i) 0
        (mut err) (primitive/zeroed Diag)
        (mut failed) false]
    (loop (if (>= (load i) n)
              (break)
              (do
                (match (qualify-one-extern c (al-elem [Extern] fs (load i)) empty)
                  (Err [d] (do (set! err d) (set! failed true) (break)))
                  (Ok [_] 0))
                (set! i (primitive/iadd (load i) 1)))))
    (if (load failed) (Err (load err)) (Ok [i64 Diag] 0))))
(defn q-exports [(c (ptr Ctx)) (p (ptr Program))] (-> (Result i64 Diag))
  (let [fs (load (field p exports))
        n (al-len [ExportC] (load fs))
        (mut i) 0
        (mut err) (primitive/zeroed Diag)
        (mut failed) false]
    (loop (if (>= (load i) n)
              (break)
              (do
                (match (qualify-one-export c (al-elem [ExportC] fs (load i)))
                  (Err [d] (do (set! err d) (set! failed true) (break)))
                  (Ok [_] 0))
                (set! i (primitive/iadd (load i) 1)))))
    (if (load failed) (Err (load err)) (Ok [i64 Diag] 0))))
(defn q-asserts [(c (ptr Ctx)) (p (ptr Program)) (empty (ptr (ArrayList (slice u8))))] (-> (Result i64 Diag))
  (let [fs (load (field p asserts))
        n (al-len [StaticAssert] (load fs))
        (mut i) 0
        (mut err) (primitive/zeroed Diag)
        (mut failed) false]
    (loop (if (>= (load i) n)
              (break)
              (do
                (match (qualify-one-assert c (al-elem [StaticAssert] fs (load i)) empty)
                  (Err [d] (do (set! err d) (set! failed true) (break)))
                  (Ok [_] 0))
                (set! i (primitive/iadd (load i) 1)))))
    (if (load failed) (Err (load err)) (Ok [i64 Diag] 0))))
(defn q-consts [(c (ptr Ctx)) (p (ptr Program)) (empty (ptr (ArrayList (slice u8))))] (-> (Result i64 Diag))
  (let [fs (load (field p consts))
        n (al-len [Const] (load fs))
        (mut i) 0
        (mut err) (primitive/zeroed Diag)
        (mut failed) false]
    (loop (if (>= (load i) n)
              (break)
              (do
                (match (qualify-one-const c (al-elem [Const] fs (load i)) empty)
                  (Err [d] (do (set! err d) (set! failed true) (break)))
                  (Ok [_] 0))
                (set! i (primitive/iadd (load i) 1)))))
    (if (load failed) (Err (load err)) (Ok [i64 Diag] 0))))
(defn q-metas [(c (ptr Ctx)) (p (ptr Program)) (empty (ptr (ArrayList (slice u8))))] (-> (Result i64 Diag))
  (let [fs (load (field p metas))
        n (al-len [Expr] (load fs))
        (mut i) 0
        (mut err) (primitive/zeroed Diag)
        (mut failed) false]
    (loop (if (>= (load i) n)
              (break)
              (do
                (match (qualify-expr c (al-elem [Expr] fs (load i)) empty)
                  (Err [d] (do (set! err d) (set! failed true) (break)))
                  (Ok [_] 0))
                (set! i (primitive/iadd (load i) 1)))))
    (if (load failed) (Err (load err)) (Ok [i64 Diag] 0))))
(defn q-traits [(c (ptr Ctx)) (p (ptr Program))] (-> (Result i64 Diag))
  (let [fs (load (field p traits))
        n (al-len [TraitDef] (load fs))
        (mut i) 0
        (mut err) (primitive/zeroed Diag)
        (mut failed) false]
    (loop (if (>= (load i) n)
              (break)
              (do
                (match (qualify-one-trait c (al-elem [TraitDef] fs (load i)))
                  (Err [d] (do (set! err d) (set! failed true) (break)))
                  (Ok [_] 0))
                (set! i (primitive/iadd (load i) 1)))))
    (if (load failed) (Err (load err)) (Ok [i64 Diag] 0))))
(defn q-impls [(c (ptr Ctx)) (p (ptr Program)) (empty (ptr (ArrayList (slice u8))))] (-> (Result i64 Diag))
  (let [fs (load (field p impls))
        n (al-len [ImplDef] (load fs))
        (mut i) 0
        (mut err) (primitive/zeroed Diag)
        (mut failed) false]
    (loop (if (>= (load i) n)
              (break)
              (do
                (match (qualify-one-impl c (al-elem [ImplDef] fs (load i)) empty)
                  (Err [d] (do (set! err d) (set! failed true) (break)))
                  (Ok [_] 0))
                (set! i (primitive/iadd (load i) 1)))))
    (if (load failed) (Err (load err)) (Ok [i64 Diag] 0))))

(defn qualify-program [(c (ptr Ctx)) (p (ptr Program))] (-> (Result i64 Diag))
  (let [empty (empty-strs (load (field c a)))]
    (try (do
           (let [defs (load (field p annotation_defs))
                 ndefs (al-len [AnnotationDef] (load defs))
                 (mut di) 0]
             (loop (if (>= (load di) ndefs)
                       (break)
                       (do
                         (try! (qualify-type c
                                             (field (al-elem [AnnotationDef] defs (load di)) value_type)
                                             empty))
                         (store! di (primitive/iadd (load di) 1))))))
           (try! (q-funcs c p))
           (try! (q-structs c p))
           (try! (q-sums c p))
           (try! (q-convs c p))
           (try! (q-externs c p empty))
           (try! (q-exports c p))
           (try! (q-asserts c p empty))
           (try! (q-consts c p empty))
           (try! (q-metas c p empty))
           (try! (q-traits c p))
           (try! (q-impls c p empty))
           (Ok 0)))))

; ---- merge -----------------------------------------
(defn out-extern [(o (mut Out)) (i i64)] (-> (ptr Extern))
  (primitive/index (load (field (field o externs) data)) i))
(defn out-const [(o (mut Out)) (i i64)] (-> (ptr Const))
  (primitive/index (load (field (field o consts) data)) i))

(defn merge-structs [(o (mut Out)) (p (ptr Program))] (-> i64)
  (let [src (load (field p structs))
        n (al-len [StructDef] (load src))
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (al-push! (mut (.structs o)) (al-get [StructDef] (load src) (load i)))
                (set! i (primitive/iadd (load i) 1))))))
  0)
(defn merge-annotation-defs [(o (mut Out)) (p (ptr Program))] (-> i64)
  (let [src (load (field p annotation_defs))
        n (al-len [AnnotationDef] (load src))
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (al-push! (mut (.annotation_defs o)) (al-get [AnnotationDef] (load src) (load i)))
                (set! i (primitive/iadd (load i) 1))))))
  0)
(defn merge-sums [(o (mut Out)) (p (ptr Program))] (-> i64)
  (let [src (load (field p sums))
        n (al-len [SumDef] (load src))
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (al-push! (mut (.sums o)) (al-get [SumDef] (load src) (load i)))
                (set! i (primitive/iadd (load i) 1))))))
  0)
(defn merge-funcs [(o (mut Out)) (p (ptr Program))] (-> i64)
  (let [src (load (field p funcs))
        n (al-len [Func] (load src))
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (al-push! (mut (.funcs o)) (al-get [Func] (load src) (load i)))
                (set! i (primitive/iadd (load i) 1))))))
  0)
(defn merge-exports [(o (mut Out)) (p (ptr Program))] (-> i64)
  (let [src (load (field p exports))
        n (al-len [ExportC] (load src))
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (al-push! (mut (.exports o)) (al-get [ExportC] (load src) (load i)))
                (set! i (primitive/iadd (load i) 1))))))
  0)
(defn merge-asserts [(o (mut Out)) (p (ptr Program))] (-> i64)
  (let [src (load (field p asserts))
        n (al-len [StaticAssert] (load src))
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (al-push! (mut (.asserts o)) (al-get [StaticAssert] (load src) (load i)))
                (set! i (primitive/iadd (load i) 1))))))
  0)
(defn merge-metas [(o (mut Out)) (p (ptr Program))] (-> i64)
  (let [src (load (field p metas))
        n (al-len [Expr] (load src))
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (al-push! (mut (.metas o)) (al-get [Expr] (load src) (load i)))
                (set! i (primitive/iadd (load i) 1))))))
  0)
(defn merge-traits [(o (mut Out)) (p (ptr Program))] (-> i64)
  (let [src (load (field p traits))
        n (al-len [TraitDef] (load src))
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (al-push! (mut (.traits o)) (al-get [TraitDef] (load src) (load i)))
                (set! i (primitive/iadd (load i) 1))))))
  0)
(defn impl-same-origin? [(x (ptr ImplDef)) (y (ptr ImplDef))] (-> bool)
  (let [xm (.methods x)
        ym (.methods y)
        n (al-len [Func] (load xm))
        (mut i) 0
        (mut same) (> n (primitive/cast i64 0))]
    (when (!= n (al-len [Func] (load ym))) (set! same false) 0)
    (when (load same)
      (if (and (impl-is-inherent x) (impl-is-inherent y))
          0
          (if (and (impl-is-trait x) (impl-is-trait y))
              (unless (= (impl-trait-name x) (impl-trait-name y)) (set! same false) 0)
              (set! same false)))
      0)
    (loop (if (or (not (load same)) (>= (load i) n))
              (break)
              (let [xf (al-elem [Func] xm (load i))
                    yf (al-elem [Func] ym (load i))]
                (unless (and (= (.name xf) (.name yf))
                             (and (= (.source xf) (.source yf))
                                  (and (= (.lo xf) (.lo yf)) (= (.hi xf) (.hi yf)))))
                  (set! same false)
                  0)
                (set! i (primitive/iadd (load i) 1)))))
    (load same)))

(defn merge-impls [(o (mut Out)) (p (ptr Program))] (-> i64)
  (let [src (load (field p impls))
        n (al-len [ImplDef] (load src))
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (let [candidate (al-elem [ImplDef] src (load i))
                      on (al-len [ImplDef] (.impls o))
                      (mut j) 0
                      (mut seen) false]
                  (loop (if (>= (load j) on)
                            (break)
                            (if (impl-same-origin? candidate (al-elem [ImplDef] (mut (.impls o)) (load j)))
                                (do (set! seen true) (break))
                                (set! j (primitive/iadd (load j) 1)))))
                  (unless (load seen)
                    (al-push! (mut (.impls o)) (load candidate))
                    0))
                (set! i (primitive/iadd (load i) 1))))))
  0)
(defn conv-in-out [(o (mut Out)) (name (slice u8))] (-> bool)
  (let [n (al-len [Convention] (.conventions o))
        (mut i) 0
        (mut f) false]
    (loop (if (>= (load i) n)
              (break)
              (do
                (when (= (conv-name (al-get [Convention] (load (field o conventions)) (load i))) name)
                  (store! f true)
                  (break))
                (set! i (primitive/iadd (load i) 1)))))
    (load f)))
(defn merge-convs [(o (mut Out)) (p (ptr Program))] (-> i64)
  (let [src (load (field p conventions))
        n (al-len [Convention] (load src))
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (let [cv (al-get [Convention] (load src) (load i))]
                  (unless (conv-in-out (mut o) (conv-name cv)) (al-push! (mut (field o conventions)) cv)))
                (set! i (primitive/iadd (load i) 1))))))
  0)
(defn merge-externs [(o (mut Out)) (p (ptr Program)) (a (ptr Allocator))] (-> (Result i64 Diag))
  (let [src (load (field p externs))
        n (al-len [Extern] (load src))
        (mut i) 0
        (mut err) (primitive/zeroed Diag)
        (mut failed) false]
    (loop (if (>= (load i) n)
              (break)
              (do
                (let [ev (al-get [Extern] (load src) (load i))
                      esp (alloc/stack Extern)]
                  (set! esp ev)
                  (let [nm (.name esp)
                        on (al-len [Extern] (.externs o))
                        (mut idx) -1
                        (mut j) 0]
                    (loop (if (>= (load j) on)
                              (break)
                              (do
                                (when (= (load (field (out-extern (mut o) (load j)) name)) nm)
                                  (store! idx (load j))
                                  (break))
                                (set! j (primitive/iadd (load j) 1)))))
                    (if (>= (load idx) (primitive/cast i64 0))
                        (unless (extern-eq (out-extern (mut o) (load idx)) esp)
                          (store! err (derr (extern-conflict-msg a nm)))
                          (store! failed true)
                          (break))
                        (al-push! (mut (.externs o)) ev))))
                (set! i (primitive/iadd (load i) 1)))))
    (if (load failed) (Err (load err)) (Ok [i64 Diag] 0))))
(defn merge-consts [(o (mut Out)) (p (ptr Program)) (a (ptr Allocator))] (-> (Result i64 Diag))
  (let [src (load (field p consts))
        n (al-len [Const] (load src))
        (mut i) 0
        (mut err) (primitive/zeroed Diag)
        (mut failed) false]
    (loop (if (>= (load i) n)
              (break)
              (do
                (let [cv (al-get [Const] (load src) (load i))
                      csp (alloc/stack Const)]
                  (set! csp cv)
                  (let [nm (.name csp)
                        on (al-len [Const] (.consts o))
                        (mut dup) false
                        (mut j) 0]
                    (loop (if (>= (load j) on)
                              (break)
                              (do
                                (when (= (load (field (out-const (mut o) (load j)) name)) nm)
                                  (store! dup true)
                                  (break))
                                (set! j (primitive/iadd (load j) 1)))))
                    (if (load dup)
                        (do (set! err (derr (const-dup-msg a nm))) (set! failed true) (break))
                        (al-push! (mut (.consts o)) cv))))
                (set! i (primitive/iadd (load i) 1)))))
    (if (load failed) (Err (load err)) (Ok [i64 Diag] 0))))
(defn merge-into [(o (mut Out)) (p (ptr Program)) (a (ptr Allocator))] (-> (Result i64 Diag))
  (merge-annotation-defs (mut o) p)
  (merge-convs (mut o) p)
  (merge-structs (mut o) p)
  (merge-sums (mut o) p)
  (match (merge-externs (mut o) p a)
    (Err [d] (Err [i64 Diag] d))
    (Ok [_]
        (do
          (merge-funcs (mut o) p)
          (merge-exports (mut o) p)
          (merge-asserts (mut o) p)
          (merge-metas (mut o) p)
          (merge-traits (mut o) p)
          (merge-impls (mut o) p)
          (merge-consts (mut o) p a)))))

; ---- build the DefTable + bare-ok set (pass 1) ----------------------------
(defn mk-empty-defs [(a (ptr Allocator))] (-> Defs)
  (let [d (alloc/stack Defs)]
    (set! (.callables d) (al-new [(slice u8)] a))
    (set! (.types d) (al-new [(slice u8)] a))
    (set! (.traits d) (al-new [(slice u8)] a))
    (set! (.convs d) (al-new [(slice u8)] a))
    (set! (.externs d) (al-new [(slice u8)] a))
    (set! (.consts d) (al-new [(slice u8)] a))
    (load d)))
(defn table-getc [(a (ptr Allocator)) (tb (ptr TBox)) (m (slice u8))] (-> (ptr DefEntry))
  (let [hit (table-find (field tb items) m)]
    (if (!= (primitive/cast i64 hit) (primitive/cast i64 0))
        hit
        (let [e (alloc/stack DefEntry)
              n (al-len [DefEntry] (.items tb))]
          (set! (.module e) m)
          (set! (.defs e) (mk-empty-defs a))
          ; no index yet — `defs-has?` scans until build-deftable builds one
          (set! (.built e) 0)
          (set! (.idx e) (hm-new [(slice u8) i64] a (str-keyops)))
          (al-push! (mut (.items tb)) (load e))
          (al-elem [DefEntry] (field tb items) n)))))
(defn add-module-defs [(a (ptr Allocator)) (tb (ptr TBox)) (m (slice u8)) (prog (ptr Program))] (-> i64)
  (let [de (table-getc a tb m)]
    ; funcs (non-main) -> callables
    (let [fs (load (field prog funcs))
          n (al-len [Func] (load fs))
          (mut i) 0]
      (loop (if (>= (load i) n)
                (break)
                (do
                  (let [nm (func-name (al-get [Func] (load fs) (load i)))]
                    (when (not (= nm "main")) (al-push! (mut (field (field de defs) callables)) nm)))
                  (set! i (primitive/iadd (load i) 1))))))
    ; structs -> types
    (let [fs (load (field prog structs))
          n (al-len [StructDef] (load fs))
          (mut i) 0]
      (loop (if (>= (load i) n)
                (break)
                (do
                  (let [sp (al-elem [StructDef] fs (load i))]
                    (al-push! (mut (.types (.defs de))) (.name sp)))
                  (set! i (primitive/iadd (load i) 1))))))
    ; sums -> types + variants -> callables
    (let [fs (load (field prog sums))
          n (al-len [SumDef] (load fs))
          (mut i) 0]
      (loop (if (>= (load i) n)
                (break)
                (do
                  (let [sp (al-elem [SumDef] fs (load i))]
                    (al-push! (mut (.types (.defs de))) (.name sp))
                    (let [vs (load (field sp variants))
                          vn (al-len [Variant] (load vs))
                          (mut j) 0]
                      (loop (if (>= (load j) vn)
                                (break)
                                (do
                                  (al-push! (mut (.callables (.defs de)))
                                            (.name (al-elem [Variant] vs (load j))))
                                  (set! j (primitive/iadd (load j) 1)))))))
                  (set! i (primitive/iadd (load i) 1))))))
    ; traits -> traits
    (let [fs (load (field prog traits))
          n (al-len [TraitDef] (load fs))
          (mut i) 0]
      (loop (if (>= (load i) n)
                (break)
                (do
                  (al-push! (mut (.traits (.defs de)))
                            (.name (al-elem [TraitDef] fs (load i))))
                  (set! i (primitive/iadd (load i) 1))))))
    ; conventions (non-c) -> convs
    (let [fs (load (field prog conventions))
          n (al-len [Convention] (load fs))
          (mut i) 0]
      (loop (if (>= (load i) n)
                (break)
                (do
                  (let [nm (conv-name (al-get [Convention] (load fs) (load i)))]
                    (when (not (= nm "c")) (al-push! (mut (field (field de defs) convs)) nm)))
                  (set! i (primitive/iadd (load i) 1))))))
    ; externs -> externs + callables
    (let [fs (load (field prog externs))
          n (al-len [Extern] (load fs))
          (mut i) 0]
      (loop (if (>= (load i) n)
                (break)
                (do
                  (let [nm (.name (al-elem [Extern] fs (load i)))]
                    (al-push! (mut (.externs (.defs de))) nm)
                    (al-push! (mut (.callables (.defs de))) nm))
                  (set! i (primitive/iadd (load i) 1))))))
    ; consts -> consts
    (let [fs (load (field prog consts))
          n (al-len [Const] (load fs))
          (mut i) 0]
      (loop (if (>= (load i) n)
                (break)
                (do
                  (al-push! (mut (.consts (.defs de)))
                            (.name (al-elem [Const] fs (load i))))
                  (set! i (primitive/iadd (load i) 1))))))
    0))
(defn build-deftable [(a (ptr Allocator)) (parsed (ptr (ArrayList ParsedForm)))] (-> (ptr (ArrayList DefEntry)))
  (let [tb (unwrap-ptr [TBox] (create [TBox] a))
        n (al-len [ParsedForm] (load parsed))
        (mut i) 0]
    (set! (.items tb) (al-new [DefEntry] a))
    (loop (if (>= (load i) n)
              (break)
              (do
                (let [pf (al-elem [ParsedForm] parsed (load i))]
                  (match (.module pf)
                    (Some [m] (add-module-defs a tb m (load (field pf prog))))
                    (None [] 0)))
                (set! i (primitive/iadd (load i) 1)))))
    ; every module is filled now, so the indexes can be built and can no longer go
    ; stale — nothing adds a definition after this point.
    (let [ne (al-len [DefEntry] (.items tb))
          (mut k) 0]
      (loop (if (>= (load k) ne)
                (break)
                (do
                  (defs-index-build! a (al-elem [DefEntry] (field tb items) (load k)))
                  (set! k (primitive/iadd (load k) 1))))))
    (field tb items)))
(defn build-bareok [(a (ptr Allocator)) (parsed (ptr (ArrayList ParsedForm)))] (-> (ptr (ArrayList (slice u8))))
  (let [sb (unwrap-ptr [SBox] (create [SBox] a))
        n (al-len [ParsedForm] (load parsed))
        (mut i) 0]
    (set! (.items sb) (al-new [(slice u8)] a))
    (loop (if (>= (load i) n)
              (break)
              (do
                (let [prog (load (field (al-elem [ParsedForm] parsed (load i)) prog))
                      ts (load (field prog traits))
                      tn (al-len [TraitDef] (load ts))
                      (mut j) 0]
                  (loop (if (>= (load j) tn)
                            (break)
                            (do
                              (let [tp (al-elem [TraitDef] ts (load j))
                                    ms (load (field tp methods))
                                    mn (al-len [TraitMethod] (load ms))
                                    (mut k) 0]
                                (loop (if (>= (load k) mn)
                                          (break)
                                          (do
                                            (al-push! (mut (.items sb))
                                                      (.name (al-elem [TraitMethod] ms (load k))))
                                            (set! k (primitive/iadd (load k) 1))))))
                              (set! j (primitive/iadd (load j) 1)))))
                  ; Receiver-bearing inherent methods are validated later, but all
                  ; inherent names must pass strict resolution so `(size db ty)` can
                  ; reach the checker's type-directed method selection.
                  (let [is (load (field prog impls))
                        ni (al-len [ImplDef] (load is))
                        (mut ii) 0]
                    (loop (if (>= (load ii) ni)
                              (break)
                              (do
                                (let [ip (al-elem [ImplDef] is (load ii))]
                                  (when (impl-is-inherent ip)
                                    (let [ms (load (field ip methods))
                                          nm (al-len [Func] (load ms))
                                          (mut mi) 0]
                                      (loop (if (>= (load mi) nm)
                                                (break)
                                                (do
                                                  (al-push! (mut (field sb items))
                                                            (load (field (al-elem [Func] ms (load mi))
                                                                         name)))
                                                  (store! mi (primitive/iadd (load mi) 1))))))))
                                (set! ii (primitive/iadd (load ii) 1)))))))
                (set! i (primitive/iadd (load i) 1)))))
    (field sb items)))

; ---- Out -> Program + Ctx/Out init -----------------------------------------
(defn init-out [(o (ptr Out)) (a (ptr Allocator))] (-> i64)
  (set! (.annotation_defs o) (al-new [AnnotationDef] a))
  (set! (.conventions o) (al-new [Convention] a))
  (set! (.structs o) (al-new [StructDef] a))
  (set! (.sums o) (al-new [SumDef] a))
  (set! (.externs o) (al-new [Extern] a))
  (set! (.funcs o) (al-new [Func] a))
  (set! (.asserts o) (al-new [StaticAssert] a))
  (set! (.consts o) (al-new [Const] a))
  (set! (.traits o) (al-new [TraitDef] a))
  (set! (.impls o) (al-new [ImplDef] a))
  (set! (.metas o) (al-new [Expr] a))
  (set! (.exports o) (al-new [ExportC] a))
  0)
(defn out->program [(o (ptr Out)) (a (ptr Allocator))] (-> (ptr Program))
  (let [pp (unwrap-ptr [Program] (create [Program] a))]
    (set! (.annotation_defs pp) (box-al [AnnotationDef] a (.annotation_defs o)))
    (set! (.conventions pp) (box-al [Convention] a (.conventions o)))
    (set! (.structs pp) (box-al [StructDef] a (.structs o)))
    (set! (.sums pp) (box-al [SumDef] a (.sums o)))
    (set! (.externs pp) (box-al [Extern] a (.externs o)))
    (set! (.funcs pp) (box-al [Func] a (.funcs o)))
    (set! (.asserts pp) (box-al [StaticAssert] a (.asserts o)))
    (set! (.consts pp) (box-al [Const] a (.consts o)))
    (set! (.traits pp) (box-al [TraitDef] a (.traits o)))
    (set! (.impls pp) (box-al [ImplDef] a (.impls o)))
    (set! (.metas pp) (box-al [Expr] a (.metas o)))
    (set! (.exports pp) (box-al [ExportC] a (.exports o)))
    pp))
(defn init-ctx [(c (ptr Ctx))
                (a (ptr Allocator))
                (m (slice u8))
                (imp (ptr ImpEntry))
                (table (ptr (ArrayList DefEntry)))
                (exp (ptr (ArrayList ExpEntry)))
                (bareok (ptr (ArrayList (slice u8))))
                (strict bool)
                (diags (ptr (ArrayList Diag)))
                (poisoned (ptr (ArrayList (slice u8))))] (-> i64)
  (set! (.a c) a)
  (set! (.m c) m)
  (set! (.imp c) imp)
  (set! (.table c) table)
  (set! (.exp c) exp)
  (set! (.strict c) strict)
  (set! (.bareok c) bareok)
  (set! (.fname c) "")
  (set! (.diags c) diags)
  (set! (.poisoned c) poisoned)
  0)

; tool-10 (import-site collision). The two parallel `(ptr SBox)`s hold, for one importer,
; the names already explicitly `:use [name]`'d and the module each came from — a box so the
; push survives across the per-`:use` scan (a bare ArrayList can't be grown through a ptr).
; partner-of returns the module a name was first seen from, or "" if this is the first.
(defn partner-of [(nbox (ptr SBox)) (tbox (ptr SBox)) (nm (slice u8))] (-> (slice u8))
  (let [names (field nbox items)
        tgts (field tbox items)
        n (al-len [(slice u8)] (load names))
        (mut i) 0
        (mut r) ""]
    (loop (if (>= (load i) n)
              (break)
              (do
                (when (= (al-get [(slice u8)] (load names) (load i)) nm)
                  (store! r (al-get [(slice u8)] (load tgts) (load i)))
                  (break))
                (set! i (primitive/iadd (load i) 1)))))
    (load r)))
; Scan one `:use [names]` entry: the first name already seen from a DIFFERENT module is the
; collision (Some diag); otherwise every name is recorded and None is returned.
(defn scan-use-names [(a (ptr Allocator))
                      (importer (slice u8))
                      (nbox (ptr SBox))
                      (tbox (ptr SBox))
                      (nms (ptr (ArrayList (slice u8))))
                      (tgt (slice u8))] (-> (Option Diag))
  (let [nn (al-len [(slice u8)] (load nms))
        (mut k) 0
        (mut r) (None [Diag])]
    (loop (if (>= (load k) nn)
              (break)
              (do
                (let [nm (al-get [(slice u8)] (load nms) (load k))
                      prev (partner-of nbox tbox nm)]
                  (if (and (> (slice-len [u8] prev) (primitive/cast i64 0)) (not (= prev tgt)))
                      (do (set! r (Some (derr (use-dup-msg a importer nm prev tgt)))) (break))
                      (do (al-push! (mut (.items nbox)) nm) (al-push! (mut (.items tbox)) tgt) 0)))
                (set! k (primitive/iadd (load k) 1)))))
    (load r)))
; One importer: scan every `:use [names]` entry, sharing the seen-name boxes across them.
(defn dup-in-importer [(a (ptr Allocator)) (ie (ptr ImpEntry))] (-> (Result i64 Diag))
  (let [importer (.name ie)
        uses (field (field ie imp) uses)
        un (al-len [Use] (load uses))
        (mut j) 0
        nbox (unwrap-ptr [SBox] (create [SBox] a))
        tbox (unwrap-ptr [SBox] (create [SBox] a))
        (mut err) (primitive/zeroed Diag)
        (mut failed) false]
    (set! (.items nbox) (al-new [(slice u8)] a))
    (set! (.items tbox) (al-new [(slice u8)] a))
    (loop (if (or (load failed) (>= (load j) un))
              (break)
              (do
                (let [up (alloc/stack Use)]
                  (set! up (al-get [Use] (load uses) (load j)))
                  (match (.spec up)
                    (UAll [] 0)
                    (UNames [nms]
                            (match (scan-use-names a importer nbox tbox nms (.target up))
                              (Some [d] (do (set! err d) (set! failed true) 0))
                              (None [] 0)))))
                (set! j (primitive/iadd (load j) 1)))))
    (if (load failed) (Err (load err)) (Ok [i64 Diag] 0))))
; tool-10: reject the SAME name explicitly `:use [name]`'d from two DIFFERENT modules in one
; importer, eagerly at the import site (before any use site is even reached).
(defn check-explicit-use-dups [(a (ptr Allocator)) (impb (ptr (ArrayList ImpEntry)))] (-> (Result i64 Diag))
  (let [n (al-len [ImpEntry] (load impb))
        (mut i) 0
        (mut err) (primitive/zeroed Diag)
        (mut failed) false]
    (loop (if (or (load failed) (>= (load i) n))
              (break)
              (do
                (match (dup-in-importer a (al-elem [ImpEntry] impb (load i)))
                  (Err [d] (do (set! err d) (set! failed true) 0))
                  (Ok [_] 0))
                (set! i (primitive/iadd (load i) 1)))))
    (if (load failed) (Err (load err)) (Ok [i64 Diag] 0))))

; diag-10: scan one `:use [names]` entry — the first name the target module does NOT export
; is a located error (Some diag); otherwise None.
(defn scan-use-exports [(a (ptr Allocator))
                        (importer (slice u8))
                        (expb (ptr (ArrayList ExpEntry)))
                        (nms (ptr (ArrayList (slice u8))))
                        (tgt (slice u8))] (-> (Option Diag))
  (let [nn (al-len [(slice u8)] (load nms))
        (mut k) 0
        (mut r) (None [Diag])]
    (loop (if (>= (load k) nn)
              (break)
              (do
                (let [nm (al-get [(slice u8)] (load nms) (load k))]
                  (when (not (exports-check expb tgt nm))
                    (store! r (Some (derr (use-unexported-msg a importer nm tgt))))
                    (break)))
                (set! k (primitive/iadd (load k) 1)))))
    (load r)))
; One importer: every `:use [names]` entry must name only exports of its target module.
(defn exports-in-importer [(a (ptr Allocator)) (expb (ptr (ArrayList ExpEntry))) (ie (ptr ImpEntry))] (-> (Result i64
                                                                                                                  Diag))
  (let [importer (.name ie)
        uses (field (field ie imp) uses)
        un (al-len [Use] (load uses))
        (mut j) 0
        (mut err) (primitive/zeroed Diag)
        (mut failed) false]
    (loop (if (or (load failed) (>= (load j) un))
              (break)
              (do
                (let [up (alloc/stack Use)]
                  (set! up (al-get [Use] (load uses) (load j)))
                  (match (.spec up)
                    (UAll [] 0)
                    (UNames [nms]
                            (match (scan-use-exports a importer expb nms (.target up))
                              (Some [d] (do (set! err d) (set! failed true) 0))
                              (None [] 0)))))
                (set! j (primitive/iadd (load j) 1)))))
    (if (load failed) (Err (load err)) (Ok [i64 Diag] 0))))
; diag-10: reject `:use [name]` naming a non-exported symbol, eagerly at the import site.
(defn check-use-exports [(a (ptr Allocator)) (impb (ptr (ArrayList ImpEntry))) (expb (ptr (ArrayList ExpEntry)))] (-> (Result i64
                                                                                                                              Diag))
  (let [n (al-len [ImpEntry] (load impb))
        (mut i) 0
        (mut err) (primitive/zeroed Diag)
        (mut failed) false]
    (loop (if (or (load failed) (>= (load i) n))
              (break)
              (do
                (match (exports-in-importer a expb (al-elem [ImpEntry] impb (load i)))
                  (Err [d] (do (set! err d) (set! failed true) 0))
                  (Ok [_] 0))
                (set! i (primitive/iadd (load i) 1)))))
    (if (load failed) (Err (load err)) (Ok [i64 Diag] 0))))

; ---- resolve-program, strict=true --------
; `tolerant` = SKIP a top-level form that does not parse, instead of aborting. Only
; the macro-context build (expander.coil::expand-stage3) passes true: at that point
; macros are not yet expanded, so a top-level macro CALL — `(gctype Node)` — is not
; yet a `defn` and cannot parse. Skipping those leaves every real definition in the
; context, so the comptime closure walk can reach ordinary functions rather than
; being restricted to a syntactic `Code`-signature subset. Every other caller passes
; false and still reports a genuine syntax error. NOTE: deliberately NOT keyed on
; `strict` — the authoritative resolve runs with strict=false whenever the program
; has metaprograms, and must still fail loudly on a real parse error.
; ---- primitive-definition resolution --------------------------------------
; Runs before AST parsing because primitive operands may themselves be type syntax.
; The parser receives only source spelling -> opcode bindings already resolved for
; the current module; it never interprets imports or primitive declaration names.
(defn primitive-canonical [(a (ptr Allocator)) (module (slice u8)) (name (slice u8))] (-> (slice u8))
  (sconcat3 a module "." name))

(defn primitive-def-op [(s (mut LS)) (canonical (slice u8))] (-> (Option (slice u8)))
  (let [defs (alloc/stack (ArrayList PrimitiveDef))
        a (load (field s a))
        (mut i) 0
        (mut out) (None [(slice u8)])]
    (set! defs (.primitive_defs s))
    (let [n (al-len [PrimitiveDef] (load defs))]
      (loop (if (>= (load i) n)
                (break)
                (let [p (al-elem [PrimitiveDef] defs (load i))]
                  (if (= (primitive-canonical a
                                              (.module p)
                                              (.name p))
                         canonical)
                      (do (set! out (Some (.opcode p))) (break))
                      (set! i (primitive/iadd (load i) 1)))))))
    (load out)))

(defn primitive-alias-target [(s (mut LS)) (canonical (slice u8))] (-> (Option (slice u8)))
  (let [aliases (alloc/stack (ArrayList PrimitiveAlias))
        a (load (field s a))
        (mut i) 0
        (mut out) (None [(slice u8)])]
    (set! aliases (.primitive_aliases s))
    (let [n (al-len [PrimitiveAlias] (load aliases))]
      (loop (if (>= (load i) n)
                (break)
                (let [p (al-elem [PrimitiveAlias] aliases (load i))]
                  (if (= (primitive-canonical a
                                              (.module p)
                                              (.name p))
                         canonical)
                      (let [raw (.target p)
                            slash (find-slash raw)]
                        (if (>= slash (primitive/cast i64 0))
                            (let [impe (imports-find (field s imports) (.module p))
                                  prefix (subslice raw 0 slash)
                                  rest (subslice raw (primitive/iadd slash 1) (slice-len raw))]
                              (if (= (primitive/cast i64 impe) (primitive/cast i64 0))
                                  (break)
                                  (match (alias-target impe prefix)
                                    (Some [target] (do (set! out (Some (primitive-canonical a target rest))) (break)))
                                    (None [] (break)))))
                            (do (set! out (Some (primitive-canonical a (.module p) raw))) (break))))
                      (set! i (primitive/iadd (load i) 1)))))))
    (load out)))

(defn primitive-op [(s (mut LS)) (canonical (slice u8)) (depth i64)] (-> (Option (slice u8)))
  (if (> depth (primitive/cast i64 64))
      (None [(slice u8)])
      (match (primitive-def-op (mut s) canonical)
        (Some [op] (Some op))
        (None []
              (match (primitive-alias-target (mut s) canonical)
                (Some [target] (primitive-op (mut s) target (primitive/iadd depth 1)))
                (None [] (None [(slice u8)])))))))

(defn primitive-binding-push! [(out (mut (ArrayList PrimitiveBinding))) (name (slice u8)) (op (slice u8))] (-> i64)
  (let [p (alloc/stack PrimitiveBinding)]
    (set! (.source_name p) name)
    (set! (.opcode p) op)
    (al-push! (mut out) (load p)))
  0)

(defn primitive-bind-one! [(s (mut LS))
                           (module (slice u8))
                           (decl-module (slice u8))
                           (name (slice u8))
                           (op (slice u8))
                           (out (mut (ArrayList PrimitiveBinding)))] (-> i64)
  (let [a (load (field s a))
        impe (imports-find (field s imports) module)]
    ; Fully-qualified module names resolve without an import alias, just like
    ; ordinary definitions.  This also lets hygienic macros emit canonical names.
    (primitive-binding-push! (mut out) (sconcat3 a decl-module "/" name) op)
    (when (= module decl-module) (primitive-binding-push! (mut out) name op) 0)
    (when (!= (primitive/cast i64 impe) (primitive/cast i64 0))
      (let [aliases (field (field impe imp) aliases)
            n (al-len [Alias] (load aliases))
            (mut i) 0]
        (loop (if (>= (load i) n)
                  (break)
                  (let [p (al-elem [Alias] aliases (load i))]
                    (when (and (= (load (field p target)) decl-module)
                               (exports-check (field s exports) decl-module name))
                      (primitive-binding-push! (mut out) (sconcat3 a (load (field p alias)) "/" name) op)
                      0)
                    (store! i (primitive/iadd (load i) 1))))))
      (let [uses (field (field impe imp) uses)
            n (al-len [Use] (load uses))
            (mut i) 0]
        (loop (if (>= (load i) n)
                  (break)
                  (let [p (al-elem [Use] uses (load i))]
                    (when (and (= (load (field p target)) decl-module)
                               (exports-check (field s exports) decl-module name))
                      (match (use-local-of p name)
                        (None [] 0)
                        (Some [local] (primitive-binding-push! (mut out) local op)))
                      0)
                    (store! i (primitive/iadd (load i) 1)))))))
    ; core's ambient aliases (`load`, `store!`, `field`, `cast`, …) go through the same
    ; refer rules as everything else, so `:exclude [load]` really does force
    ; `primitive/load` rather than hiding the name from one pass and not the others.
    (when (and (not (= module "coil.core")) (= decl-module "coil.core"))
      (match (core-local-of impe name)
        (None [] 0)
        (Some [local] (primitive-binding-push! (mut out) local op)))
      0))
  0)

(defn primitive-bindings-for [(s (mut LS)) (module (Option (slice u8)))] (-> (ptr (ArrayList PrimitiveBinding)))
  (let [a (load (field s a))
        box (unwrap-ptr [(ArrayList PrimitiveBinding)] (create [(ArrayList PrimitiveBinding)] a))
        (mut out) (al-new [PrimitiveBinding] a)]
    ; Canonical names do not depend on the current source having a module
    ; declaration. This mirrors ordinary fully-qualified lookup and matters for
    ; small standalone/comptime files.
    (let [defs (alloc/stack (ArrayList PrimitiveDef))
          (mut i) 0]
      (set! defs (.primitive_defs s))
      (let [n (al-len [PrimitiveDef] (load defs))]
        (loop (if (>= (load i) n)
                  (break)
                  (let [p (al-elem [PrimitiveDef] defs (load i))]
                    (primitive-binding-push! (mut out)
                                             (sconcat3 a (.module p) "/" (.name p))
                                             (.opcode p))
                    (set! i (primitive/iadd (load i) 1)))))))
    (let [aliases (alloc/stack (ArrayList PrimitiveAlias))
          (mut i) 0]
      (set! aliases (.primitive_aliases s))
      (let [n (al-len [PrimitiveAlias] (load aliases))]
        (loop (if (>= (load i) n)
                  (break)
                  (let [p (al-elem [PrimitiveAlias] aliases (load i))
                        canonical
                          (primitive-canonical a
                                               (.module p)
                                               (.name p))]
                    (match (primitive-op (mut s) canonical 0)
                      (Some [op]
                            (primitive-binding-push! (mut out)
                                                     (sconcat3 a
                                                               (.module p)
                                                               "/"
                                                               (.name p))
                                                     op))
                      (None [] 0))
                    (set! i (primitive/iadd (load i) 1)))))))
    (match module
      (None [] 0)
      (Some [m]
            (do
              (let [defs (alloc/stack (ArrayList PrimitiveDef))
                    (mut i) 0]
                (set! defs (.primitive_defs s))
                (let [n (al-len [PrimitiveDef] (load defs))]
                  (loop (if (>= (load i) n)
                            (break)
                            (let [p (al-elem [PrimitiveDef] defs (load i))]
                              (primitive-bind-one! (mut s)
                                                   m
                                                   (.module p)
                                                   (.name p)
                                                   (.opcode p)
                                                   (mut out))
                              (set! i (primitive/iadd (load i) 1)))))))
              (let [aliases (alloc/stack (ArrayList PrimitiveAlias))
                    (mut i) 0]
                (set! aliases (.primitive_aliases s))
                (let [n (al-len [PrimitiveAlias] (load aliases))]
                  (loop (if (>= (load i) n)
                            (break)
                            (let [p (al-elem [PrimitiveAlias] aliases (load i))
                                  canonical
                                    (primitive-canonical a
                                                         (.module p)
                                                         (.name p))]
                              (match (primitive-op (mut s) canonical 0)
                                (Some [op]
                                      (primitive-bind-one! (mut s)
                                                           m
                                                           (.module p)
                                                           (.name p)
                                                           op
                                                           (mut out)))
                                (None [] 0))
                              (set! i (primitive/iadd (load i) 1))))))))))
    (set! box (load out))
    box))

(defstruct PrimitiveBindingsCacheEntry
  [(module (Option (slice u8)))
   (bindings (ptr (ArrayList PrimitiveBinding)))])

(defn primitive-module-eq? [(a (Option (slice u8))) (b (Option (slice u8)))] (-> bool)
  (match a
    (None [] (match b (None [] true) (Some [_] false)))
    (Some [x] (match b (None [] false) (Some [y] (= x y))))))

; Primitive visibility depends only on the current module and the loader's immutable
; import/export tables. A resolve pass used to rebuild the complete binding list for
; every top-level form—hundreds of times for a normal program—even though adjacent
; definitions overwhelmingly share a module.
(defn primitive-bindings-cached [(s (mut LS))
                                 (cache (mut (ArrayList PrimitiveBindingsCacheEntry)))
                                 (module (Option (slice u8)))] (-> (ptr (ArrayList PrimitiveBinding)))
  (let [n (al-len [PrimitiveBindingsCacheEntry] (load cache))
        (mut i) 0
        (mut found) (primitive/cast (ptr (ArrayList PrimitiveBinding)) 0)]
    (loop (if (>= (load i) n)
              (break)
              (let [entry (al-elem [PrimitiveBindingsCacheEntry] cache (load i))]
                (if (primitive-module-eq? (.module entry) module)
                    (do (set! found (load (field entry bindings))) (break))
                    (set! i (primitive/iadd (load i) 1))))))
    (if (!= (primitive/cast i64 (load found)) 0)
        (load found)
        (let [bindings (primitive-bindings-for (mut s) module)
              entry (alloc/stack PrimitiveBindingsCacheEntry)]
          (set! (.module entry) module)
          (set! (.bindings entry) bindings)
          (al-push! [PrimitiveBindingsCacheEntry] (mut cache) (load entry))
          bindings))))

(defn resolve-program [(a (ptr Allocator)) (s (mut LS)) (strict bool) (tolerant bool)] (-> (Result (ptr Program) Diag))
  (let [impb (unwrap-ptr [(ArrayList ImpEntry)] (create [(ArrayList ImpEntry)] a))
        expb (unwrap-ptr [(ArrayList ExpEntry)] (create [(ArrayList ExpEntry)] a))
        out-forms (field s out)
        nforms (al-len [TaggedForm] (load out-forms))
        pb (unwrap-ptr [PBox] (create [PBox] a))
        parsed (field pb items)
        (mut perr) (primitive/zeroed Diag)
        (mut pfailed) false
        (mut fi) 0
        (mut primitive-cache) (al-new [PrimitiveBindingsCacheEntry] a)
        (mut dupd) (primitive/zeroed Diag)
        (mut dupfail) false]
    (set! impb (.imports s))
    (set! expb (.exports s))
    (match (check-explicit-use-dups a impb)
      (Err [d] (do (set! dupd d) (set! dupfail true) 0))
      (Ok [_] 0))
    ; diag-10: a `:use [name]` naming a non-exported symbol is a located error, not silence.
    (unless (load dupfail)
      (match (check-use-exports a impb expb)
        (Err [d] (do (store! dupd d) (store! dupfail true) 0))
        (Ok [_] 0)))
    (set! (.items pb) (al-new [ParsedForm] a))
    (type-res-reset)  ; fresh type-reference resolution registry for this pass
    (src-mod-reset)  ; fresh source→module map
    ; pass 0: parse each tagged form into its own Program
    (loop (if (>= (load fi) nforms)
              (break)
              (do
                (let [tfp (alloc/stack TaggedForm)]
                  (set! tfp (al-get [TaggedForm] (load out-forms) (load fi)))
                  (parser-set-primitive-bindings! (primitive-bindings-cached (mut s)
                                                                             (mut primitive-cache)
                                                                             (.module tfp)))
                  ; record which module this source file belongs to (for type-node resolution)
                  (src-mod-record (sx-source (.form tfp))
                                  (match (.module tfp) (Some [m] m) (None [] "")))
                  (let [single (unwrap-ptr [(ArrayList Sexp)] (create [(ArrayList Sexp)] a))
                        (mut sl) (al-new [Sexp] a)]
                    (al-push! (mut sl) (.form tfp))
                    (set! single (load sl))
                    (match (parse-program a single)
                      (Err [d] (unless tolerant (store! perr d) (store! pfailed true) (break)))
                      (Ok [prog]
                          (let [pp (unwrap-ptr [Program] (create [Program] a))
                                pf (alloc/stack ParsedForm)]
                            (set! pp prog)
                            (set! (.prog pf) pp)
                            (set! (.module pf) (.module tfp))
                            (al-push! (mut (.items pb)) (load pf)))))))
                (set! fi (primitive/iadd (load fi) 1)))))
    (if (load dupfail)
        (Err (load dupd))
        (if (load pfailed)
            (Err (load perr))
            (let [table (build-deftable a parsed)
                  bareok (build-bareok a parsed)
                  o (alloc/stack Out)
                  np (al-len [ParsedForm] (load parsed))
                  ; the collect-and-continue sink, allocated once and shared across modules.
                  rdiags (unwrap-ptr [(ArrayList Diag)] (create [(ArrayList Diag)] a))
                  rpoison (unwrap-ptr [(ArrayList (slice u8))] (create [(ArrayList (slice u8))] a))
                  (mut qerr) (primitive/zeroed Diag)
                  (mut qfailed) false
                  (mut qi) 0]
              (set! rdiags (al-new [Diag] a))
              (set! rpoison (al-new [(slice u8)] a))
              (set! (.resolve_diags s) rdiags)
              (set! (.resolve_poisoned s) rpoison)
              (init-out o a)
              (loop (if (>= (load qi) np)
                        (break)
                        (do
                          (let [pf (al-elem [ParsedForm] parsed (load qi))
                                prog (load (field pf prog))]
                            (match (.module pf)
                              (Some [m]
                                    (let [imp (imports-find impb m)
                                          cx (alloc/stack Ctx)]
                                      (init-ctx cx a m imp table expb bareok strict rdiags rpoison)
                                      (set! (.impb cx) impb)
                                      (match (qualify-program cx prog)
                                        (Err [d] (do (set! qerr d) (set! qfailed true) (break)))
                                        (Ok [_] 0))))
                              (None [] 0))
                            (unless (load qfailed)
                              (match (merge-into (mut o) prog a)
                                (Err [d] (do (store! qerr d) (store! qfailed true) (break)))
                                (Ok [_] 0))))
                          (set! qi (primitive/iadd (load qi) 1)))))
              (if (load qfailed) (Err (load qerr)) (Ok (out->program o a))))))))

; ============================ tables (Cx) ==========================
; Sig/StructInfo/SumInfo/Cx. The HashMaps become
; linear-scan ArrayList tables (the resolver's deftable idiom). Cx tables are
; BY-VALUE ArrayList fields so they can be pushed via (mut (primitive/field cx X)); they are
; read via (primitive/field cx X) for al-elem and (primitive/load (primitive/field cx X)) for al-len/al-get.
