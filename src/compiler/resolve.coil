(defn q-metas [(c (ptr Ctx)) (p (ptr Program)) (empty (ptr (ArrayList (slice u8))))] (-> (Result i64 Diag))
  (let [fs (load (field p metas))
        n (al-len [Expr] (load fs))
        (mut i) 0
        (mut err) (primitive/zeroed Diag)
        (mut failed) false]
    (loop (if (>= (load i) n)
              (break)
              (do
                (match (qualify-expr c (al-elem [Expr] fs (load i)) empty)
                  (Err [d] (do (set! err d) (set! failed true) (break)))
                  (Ok [_] 0))
                (set! i (primitive/iadd (load i) 1)))))
    (if (load failed) (Err (load err)) (Ok [i64 Diag] 0))))

(defn q-traits [(c (ptr Ctx)) (p (ptr Program))] (-> (Result i64 Diag))
  (let [fs (load (field p traits))
        n (al-len [TraitDef] (load fs))
        (mut i) 0
        (mut err) (primitive/zeroed Diag)
        (mut failed) false]
    (loop (if (>= (load i) n)
              (break)
              (do
                (match (qualify-one-trait c (al-elem [TraitDef] fs (load i)))
                  (Err [d] (do (set! err d) (set! failed true) (break)))
                  (Ok [_] 0))
                (set! i (primitive/iadd (load i) 1)))))
    (if (load failed) (Err (load err)) (Ok [i64 Diag] 0))))

(defn q-impls [(c (ptr Ctx)) (p (ptr Program)) (empty (ptr (ArrayList (slice u8))))] (-> (Result i64 Diag))
  (let [fs (load (field p impls))
        n (al-len [ImplDef] (load fs))
        (mut i) 0
        (mut err) (primitive/zeroed Diag)
        (mut failed) false]
    (loop (if (>= (load i) n)
              (break)
              (do
                (match (qualify-one-impl c (al-elem [ImplDef] fs (load i)) empty)
                  (Err [d] (do (set! err d) (set! failed true) (break)))
                  (Ok [_] 0))
                (set! i (primitive/iadd (load i) 1)))))
    (if (load failed) (Err (load err)) (Ok [i64 Diag] 0))))

(defn qualify-program [(c (ptr Ctx)) (p (ptr Program))] (-> (Result i64 Diag))
  (let [empty (empty-strs (load (field c a)))]
    (try (do
           (let [defs (load (field p annotation_defs))
                 ndefs (al-len [AnnotationDef] (load defs))
                 (mut di) 0]
             (loop (if (>= (load di) ndefs)
                       (break)
                       (do
                         (try! (qualify-type c
                                             (field (al-elem [AnnotationDef] defs (load di)) value_type)
                                             empty))
                         (store! di (primitive/iadd (load di) 1))))))
           (try! (q-funcs c p))
           (try! (q-structs c p))
           (try! (q-sums c p))
           (try! (q-convs c p))
           (try! (q-externs c p empty))
           (try! (q-exports c p))
           (try! (q-asserts c p empty))
           (try! (q-consts c p empty))
           (try! (q-metas c p empty))
           (try! (q-traits c p))
           (try! (q-impls c p empty))
           (Ok 0)))))

; ---- merge -----------------------------------------
(defn out-extern [(o (mut Out)) (i i64)] (-> (ptr Extern))
  (primitive/index (load (field (field o externs) data)) i))

(defn out-const [(o (mut Out)) (i i64)] (-> (ptr Const))
  (primitive/index (load (field (field o consts) data)) i))

(defn merge-structs [(o (mut Out)) (p (ptr Program))] (-> i64)
  (let [src (load (field p structs))
        n (al-len [StructDef] (load src))
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (al-push! (mut (.structs o)) (al-get [StructDef] (load src) (load i)))
                (set! i (primitive/iadd (load i) 1))))))
  0)

(defn merge-annotation-defs [(o (mut Out)) (p (ptr Program))] (-> i64)
  (let [src (load (field p annotation_defs))
        n (al-len [AnnotationDef] (load src))
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (al-push! (mut (.annotation_defs o)) (al-get [AnnotationDef] (load src) (load i)))
                (set! i (primitive/iadd (load i) 1))))))
  0)

(defn merge-sums [(o (mut Out)) (p (ptr Program))] (-> i64)
  (let [src (load (field p sums))
        n (al-len [SumDef] (load src))
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (al-push! (mut (.sums o)) (al-get [SumDef] (load src) (load i)))
                (set! i (primitive/iadd (load i) 1))))))
  0)

(defn merge-funcs [(o (mut Out)) (p (ptr Program))] (-> i64)
  (let [src (load (field p funcs))
        n (al-len [Func] (load src))
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (al-push! (mut (.funcs o)) (al-get [Func] (load src) (load i)))
                (set! i (primitive/iadd (load i) 1))))))
  0)

(defn merge-exports [(o (mut Out)) (p (ptr Program))] (-> i64)
  (let [src (load (field p exports))
        n (al-len [ExportC] (load src))
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (al-push! (mut (.exports o)) (al-get [ExportC] (load src) (load i)))
                (set! i (primitive/iadd (load i) 1))))))
  0)

(defn merge-asserts [(o (mut Out)) (p (ptr Program))] (-> i64)
  (let [src (load (field p asserts))
        n (al-len [StaticAssert] (load src))
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (al-push! (mut (.asserts o)) (al-get [StaticAssert] (load src) (load i)))
                (set! i (primitive/iadd (load i) 1))))))
  0)

(defn merge-metas [(o (mut Out)) (p (ptr Program))] (-> i64)
  (let [src (load (field p metas))
        n (al-len [Expr] (load src))
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (al-push! (mut (.metas o)) (al-get [Expr] (load src) (load i)))
                (set! i (primitive/iadd (load i) 1))))))
  0)

(defn merge-traits [(o (mut Out)) (p (ptr Program))] (-> i64)
  (let [src (load (field p traits))
        n (al-len [TraitDef] (load src))
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (al-push! (mut (.traits o)) (al-get [TraitDef] (load src) (load i)))
                (set! i (primitive/iadd (load i) 1))))))
  0)

(defn impl-same-origin? [(x (ptr ImplDef)) (y (ptr ImplDef))] (-> bool)
  (let [xm (.methods x)
        ym (.methods y)
        n (al-len [Func] (load xm))
        (mut i) 0
        (mut same) (> n (primitive/cast i64 0))]
    (when (!= n (al-len [Func] (load ym))) (set! same false) 0)
    (when (load same)
      (if (and (impl-is-inherent x) (impl-is-inherent y))
          0
          (if (and (impl-is-trait x) (impl-is-trait y))
              (unless (= (impl-trait-name x) (impl-trait-name y)) (set! same false) 0)
              (set! same false)))
      0)
    (loop (if (or (not (load same)) (>= (load i) n))
              (break)
              (let [xf (al-elem [Func] xm (load i))
                    yf (al-elem [Func] ym (load i))]
                (unless (and (= (.name xf) (.name yf))
                             (and (= (.source xf) (.source yf))
                                  (and (= (.lo xf) (.lo yf)) (= (.hi xf) (.hi yf)))))
                  (set! same false)
                  0)
                (set! i (primitive/iadd (load i) 1)))))
    (load same)))

(defn merge-impls [(o (mut Out)) (p (ptr Program))] (-> i64)
  (let [src (load (field p impls))
        n (al-len [ImplDef] (load src))
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (let [candidate (al-elem [ImplDef] src (load i))
                      on (al-len [ImplDef] (.impls o))
                      (mut j) 0
                      (mut seen) false]
                  (loop (if (>= (load j) on)
                            (break)
                            (if (impl-same-origin? candidate (al-elem [ImplDef] (mut (.impls o)) (load j)))
                                (do (set! seen true) (break))
                                (set! j (primitive/iadd (load j) 1)))))
                  (unless (load seen)
                    (al-push! (mut (.impls o)) (load candidate))
                    0))
                (set! i (primitive/iadd (load i) 1))))))
  0)

(defn conv-in-out [(o (mut Out)) (name (slice u8))] (-> bool)
  (let [n (al-len [Convention] (.conventions o))
        (mut i) 0
        (mut f) false]
    (loop (if (>= (load i) n)
              (break)
              (do
                (when (= (conv-name (al-get [Convention] (load (field o conventions)) (load i))) name)
                  (store! f true)
                  (break))
                (set! i (primitive/iadd (load i) 1)))))
    (load f)))

(defn merge-convs [(o (mut Out)) (p (ptr Program))] (-> i64)
  (let [src (load (field p conventions))
        n (al-len [Convention] (load src))
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (let [cv (al-get [Convention] (load src) (load i))]
                  (unless (conv-in-out (mut o) (conv-name cv)) (al-push! (mut (field o conventions)) cv)))
                (set! i (primitive/iadd (load i) 1))))))
  0)

(defn merge-externs [(o (mut Out)) (p (ptr Program)) (a (dyn Allocator))] (-> (Result i64 Diag))
  (let [src (load (field p externs))
        n (al-len [Extern] (load src))
        (mut i) 0
        (mut err) (primitive/zeroed Diag)
        (mut failed) false]
    (loop (if (>= (load i) n)
              (break)
              (do
                (let [ev (al-get [Extern] (load src) (load i))
                      esp (primitive/alloc-stack Extern)]
                  (set! esp ev)
                  (let [nm (.name esp)
                        on (al-len [Extern] (.externs o))
                        (mut idx) -1
                        (mut j) 0]
                    (loop (if (>= (load j) on)
                              (break)
                              (do
                                (when (= (load (field (out-extern (mut o) (load j)) name)) nm)
                                  (store! idx (load j))
                                  (break))
                                (set! j (primitive/iadd (load j) 1)))))
                    (if (>= (load idx) (primitive/cast i64 0))
                        (unless (extern-eq (out-extern (mut o) (load idx)) esp)
                          (store! err (derr (extern-conflict-msg a nm)))
                          (store! failed true)
                          (break))
                        (al-push! (mut (.externs o)) ev))))
                (set! i (primitive/iadd (load i) 1)))))
    (if (load failed) (Err (load err)) (Ok [i64 Diag] 0))))

(defn merge-consts [(o (mut Out)) (p (ptr Program)) (a (dyn Allocator))] (-> (Result i64 Diag))
  (let [src (load (field p consts))
        n (al-len [Const] (load src))
        (mut i) 0
        (mut err) (primitive/zeroed Diag)
        (mut failed) false]
    (loop (if (>= (load i) n)
              (break)
              (do
                (let [cv (al-get [Const] (load src) (load i))
                      csp (primitive/alloc-stack Const)]
                  (set! csp cv)
                  (let [nm (.name csp)
                        on (al-len [Const] (.consts o))
                        (mut dup) false
                        (mut j) 0]
                    (loop (if (>= (load j) on)
                              (break)
                              (do
                                (when (= (load (field (out-const (mut o) (load j)) name)) nm)
                                  (store! dup true)
                                  (break))
                                (set! j (primitive/iadd (load j) 1)))))
                    (if (load dup)
                        (do (set! err (derr (const-dup-msg a nm))) (set! failed true) (break))
                        (al-push! (mut (.consts o)) cv))))
                (set! i (primitive/iadd (load i) 1)))))
    (if (load failed) (Err (load err)) (Ok [i64 Diag] 0))))

(defn merge-into [(o (mut Out)) (p (ptr Program)) (a (dyn Allocator))] (-> (Result i64 Diag))
  (merge-annotation-defs (mut o) p)
  (merge-convs (mut o) p)
  (merge-structs (mut o) p)
  (merge-sums (mut o) p)
  (match (merge-externs (mut o) p a)
    (Err [d] (Err [i64 Diag] d))
    (Ok [_]
        (do
          (merge-funcs (mut o) p)
          (merge-exports (mut o) p)
          (merge-asserts (mut o) p)
          (merge-metas (mut o) p)
          (merge-traits (mut o) p)
          (merge-impls (mut o) p)
          (merge-consts (mut o) p a)))))

; ---- build the DefTable + bare-ok set (pass 1) ----------------------------
(defn mk-empty-defs [(a (dyn Allocator))] (-> Defs)
  (let [d (primitive/alloc-stack Defs)]
    (set! (.callables d) (al-new [(slice u8)] a))
    (set! (.types d) (al-new [(slice u8)] a))
    (set! (.traits d) (al-new [(slice u8)] a))
    (set! (.convs d) (al-new [(slice u8)] a))
    (set! (.externs d) (al-new [(slice u8)] a))
    (set! (.consts d) (al-new [(slice u8)] a))
    (set! (.methods d) (al-new [(slice u8)] a))
    (load d)))

(defn table-getc [(a (dyn Allocator)) (tb (ptr TBox)) (m (slice u8))] (-> (ptr DefEntry))
  (let [hit (table-find (field tb items) m)]
    (if (!= (primitive/cast i64 hit) (primitive/cast i64 0))
        hit
        (let [e (primitive/alloc-stack DefEntry)
              n (al-len [DefEntry] (.items tb))]
          (set! (.module e) m)
          (set! (.defs e) (mk-empty-defs a))
          ; no index yet — `defs-has?` scans until build-deftable builds one
          (set! (.built e) 0)
          (set! (.idx e) (hm-new [(slice u8) i64] a (str-keyops)))
          (al-push! (mut (.items tb)) (load e))
          (al-elem [DefEntry] (field tb items) n)))))

(defn add-module-defs [(a (dyn Allocator)) (tb (ptr TBox)) (m (slice u8)) (prog (ptr Program))] (-> i64)
  (let [de (table-getc a tb m)]
    ; funcs (non-main) -> callables
    (let [fs (load (field prog funcs))
          n (al-len [Func] (load fs))
          (mut i) 0]
      (loop (if (>= (load i) n)
                (break)
                (do
                  (let [nm (func-name (al-get [Func] (load fs) (load i)))]
                    (when (not (= nm "main")) (al-push! (mut (field (field de defs) callables)) nm)))
                  (set! i (primitive/iadd (load i) 1))))))
    ; structs -> types
    (let [fs (load (field prog structs))
          n (al-len [StructDef] (load fs))
          (mut i) 0]
      (loop (if (>= (load i) n)
                (break)
                (do
                  (let [sp (al-elem [StructDef] fs (load i))]
                    (al-push! (mut (.types (.defs de))) (.name sp)))
                  (set! i (primitive/iadd (load i) 1))))))
    ; sums -> types + variants -> callables
    (let [fs (load (field prog sums))
          n (al-len [SumDef] (load fs))
          (mut i) 0]
      (loop (if (>= (load i) n)
                (break)
                (do
                  (let [sp (al-elem [SumDef] fs (load i))]
                    (al-push! (mut (.types (.defs de))) (.name sp))
                    (let [vs (load (field sp variants))
                          vn (al-len [Variant] (load vs))
                          (mut j) 0]
                      (loop (if (>= (load j) vn)
                                (break)
                                (do
                                  (al-push! (mut (.callables (.defs de)))
                                            (.name (al-elem [Variant] vs (load j))))
                                  (set! j (primitive/iadd (load j) 1)))))))
                  (set! i (primitive/iadd (load i) 1))))))
    ; traits -> traits + a separate method namespace. Methods are selected by the checker,
    ; but the resolver must still preserve a template reference's definition
    ; module instead of falling back to the caller's imports.
    (let [fs (load (field prog traits))
          n (al-len [TraitDef] (load fs))
          (mut i) 0]
      (loop (if (>= (load i) n)
                (break)
                (do
                  (let [tp (al-elem [TraitDef] fs (load i))]
                    (al-push! (mut (.traits (.defs de))) (.name tp))
                    (let [ms (load (field tp methods))
                          mn (al-len [TraitMethod] (load ms))
                          (mut j) 0]
                      (loop (if (>= (load j) mn)
                                (break)
                                (do
                                  (al-push! (mut (.methods (.defs de)))
                                            (.name (al-elem [TraitMethod] ms (load j))))
                                  (set! j (primitive/iadd (load j) 1)))))))
                  (set! i (primitive/iadd (load i) 1))))))
    ; conventions (non-c) -> convs
    (let [fs (load (field prog conventions))
          n (al-len [Convention] (load fs))
          (mut i) 0]
      (loop (if (>= (load i) n)
                (break)
                (do
                  (let [nm (conv-name (al-get [Convention] (load fs) (load i)))]
                    (when (not (= nm "c")) (al-push! (mut (field (field de defs) convs)) nm)))
                  (set! i (primitive/iadd (load i) 1))))))
    ; externs -> externs + callables
    (let [fs (load (field prog externs))
          n (al-len [Extern] (load fs))
          (mut i) 0]
      (loop (if (>= (load i) n)
                (break)
                (do
                  (let [nm (.name (al-elem [Extern] fs (load i)))]
                    (al-push! (mut (.externs (.defs de))) nm)
                    (al-push! (mut (.callables (.defs de))) nm))
                  (set! i (primitive/iadd (load i) 1))))))
    ; consts -> consts
    (let [fs (load (field prog consts))
          n (al-len [Const] (load fs))
          (mut i) 0]
      (loop (if (>= (load i) n)
                (break)
                (do
                  (al-push! (mut (.consts (.defs de)))
                            (.name (al-elem [Const] fs (load i))))
                  (set! i (primitive/iadd (load i) 1))))))
    0))

(defn append-def-names! [(dst (mut (ArrayList (slice u8))))
                         (src (ptr (ArrayList (slice u8))))] (-> i64)
  (let [n (al-len [(slice u8)] (load src))
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (al-push! (mut dst) (al-get [(slice u8)] (load src) (load i)))
                (store! i (primitive/iadd (load i) 1))))))
  0)

(defn merge-defs! [(dst (mut Defs)) (src (ptr Defs))] (-> i64)
  (append-def-names! (mut (.callables dst)) (field src callables))
  (append-def-names! (mut (.types dst)) (field src types))
  (append-def-names! (mut (.traits dst)) (field src traits))
  (append-def-names! (mut (.convs dst)) (field src convs))
  (append-def-names! (mut (.externs dst)) (field src externs))
  (append-def-names! (mut (.consts dst)) (field src consts))
  (append-def-names! (mut (.methods dst)) (field src methods))
  0)

(defn program-raw-defs [(a (dyn Allocator))
                        (module (Option (slice u8)))
                        (prog (ptr Program))] (-> Defs)
  (let [tb (box! a TBox (primitive/zeroed TBox))]
    (set! (.items tb) (al-new [DefEntry] a))
    (add-module-defs a
                     tb
                     (match module (Some [m] m) (None [] ""))
                     prog)
    (load (field (al-elem [DefEntry] (field tb items) 0) defs))))

(defn build-deftable [(a (dyn Allocator)) (parsed (ptr (ArrayList ParsedForm)))] (-> (ptr (ArrayList DefEntry)))
  (let [tb (box! a TBox (primitive/zeroed TBox))
        n (al-len [ParsedForm] (load parsed))
        (mut i) 0]
    (set! (.items tb) (al-new [DefEntry] a))
    (loop (if (>= (load i) n)
              (break)
              (do
                (let [pf (al-elem [ParsedForm] parsed (load i))]
                  (let [de (table-getc a
                                       tb
                                       (match (.module pf) (Some [m] m) (None [] "")))]
                    (merge-defs! (mut (.defs de)) (field pf defs))))
                (set! i (primitive/iadd (load i) 1)))))
    ; every module is filled now, so the indexes can be built and can no longer go
    ; stale — nothing adds a definition after this point.
    (let [ne (al-len [DefEntry] (.items tb))
          (mut k) 0]
      (loop (if (>= (load k) ne)
                (break)
                (do
                  (defs-index-build! a (al-elem [DefEntry] (field tb items) (load k)))
                  (set! k (primitive/iadd (load k) 1))))))
    (field tb items)))

(defn def-names-equal? [(a (ptr (ArrayList (slice u8))))
                        (b (ptr (ArrayList (slice u8))))] (-> bool)
  (let [n (al-len [(slice u8)] (load a))]
    (if (!= n (al-len [(slice u8)] (load b)))
        false
        (let [(mut i) 0
              (mut same) true]
          (loop (if (or (not (load same)) (>= (load i) n))
                    (break)
                    (do
                      (unless (= (al-get [(slice u8)] (load a) (load i))
                                 (al-get [(slice u8)] (load b) (load i)))
                        (store! same false)
                        0)
                      (store! i (primitive/iadd (load i) 1)))))
          (load same)))))

(defn defs-equal? [(a (ptr Defs)) (b (ptr Defs))] (-> bool)
  (and (def-names-equal? (field a callables) (field b callables))
       (and (def-names-equal? (field a types) (field b types))
            (and (def-names-equal? (field a traits) (field b traits))
                 (and (def-names-equal? (field a convs) (field b convs))
                      (and (def-names-equal? (field a externs) (field b externs))
                           (and (def-names-equal? (field a consts) (field b consts))
                                (def-names-equal? (field a methods) (field b methods)))))))))

(defn deftables-equal? [(a (ptr (ArrayList DefEntry)))
                        (b (ptr (ArrayList DefEntry)))] (-> bool)
  (let [n (al-len [DefEntry] (load a))]
    (if (!= n (al-len [DefEntry] (load b)))
        false
        (let [(mut i) 0
              (mut same) true]
          (loop (if (or (not (load same)) (>= (load i) n))
                    (break)
                    (let [x (al-elem [DefEntry] a (load i))
                          y (al-elem [DefEntry] b (load i))]
                      (unless (and (= (.module x) (.module y))
                                   (defs-equal? (field x defs) (field y defs)))
                        (store! same false)
                        0)
                      (store! i (primitive/iadd (load i) 1)))))
          (load same)))))

(defn build-bareok [(a (dyn Allocator)) (parsed (ptr (ArrayList ParsedForm)))] (-> (ptr (ArrayList (slice u8))))
  (let [sb (box! a SBox (primitive/zeroed SBox))
        n (al-len [ParsedForm] (load parsed))
        (mut i) 0]
    (set! (.items sb) (al-new [(slice u8)] a))
    (loop (if (>= (load i) n)
              (break)
              (do
                (let [prog (load (field (al-elem [ParsedForm] parsed (load i)) prog))
                      ts (load (field prog traits))
                      tn (al-len [TraitDef] (load ts))
                      (mut j) 0]
                  (loop (if (>= (load j) tn)
                            (break)
                            (do
                              (let [tp (al-elem [TraitDef] ts (load j))
                                    ms (load (field tp methods))
                                    mn (al-len [TraitMethod] (load ms))
                                    (mut k) 0]
                                (loop (if (>= (load k) mn)
                                          (break)
                                          (do
                                            (al-push! (mut (.items sb))
                                                      (.name (al-elem [TraitMethod] ms (load k))))
                                            (set! k (primitive/iadd (load k) 1))))))
                              (set! j (primitive/iadd (load j) 1)))))
                  ; Receiver-bearing inherent methods are validated later, but all
                  ; inherent names must pass strict resolution so `(size db ty)` can
                  ; reach the checker's type-directed method selection.
                  (let [is (load (field prog impls))
                        ni (al-len [ImplDef] (load is))
                        (mut ii) 0]
                    (loop (if (>= (load ii) ni)
                              (break)
                              (do
                                (let [ip (al-elem [ImplDef] is (load ii))]
                                  (when (impl-is-inherent ip)
                                    (let [ms (load (field ip methods))
                                          nm (al-len [Func] (load ms))
                                          (mut mi) 0]
                                      (loop (if (>= (load mi) nm)
                                                (break)
                                                (do
                                                  (al-push! (mut (field sb items))
                                                            (load (field (al-elem [Func] ms (load mi))
                                                                         name)))
                                                  (store! mi (primitive/iadd (load mi) 1))))))))
                                (set! ii (primitive/iadd (load ii) 1)))))))
                (set! i (primitive/iadd (load i) 1)))))
    (field sb items)))

; ---- Out -> Program + Ctx/Out init -----------------------------------------
(defn init-out [(o (ptr Out)) (a (dyn Allocator))] (-> i64)
  (set! (.annotation_defs o) (al-new [AnnotationDef] a))
  (set! (.conventions o) (al-new [Convention] a))
  (set! (.structs o) (al-new [StructDef] a))
  (set! (.sums o) (al-new [SumDef] a))
  (set! (.externs o) (al-new [Extern] a))
  (set! (.funcs o) (al-new [Func] a))
  (set! (.asserts o) (al-new [StaticAssert] a))
  (set! (.consts o) (al-new [Const] a))
  (set! (.traits o) (al-new [TraitDef] a))
  (set! (.impls o) (al-new [ImplDef] a))
  (set! (.metas o) (al-new [Expr] a))
  (set! (.exports o) (al-new [ExportC] a))
  0)

(defn out->program [(o (ptr Out)) (a (dyn Allocator))] (-> (ptr Program))
  (let [pp (box! a Program (primitive/zeroed Program))]
    (set! (.annotation_defs pp) (box-al [AnnotationDef] a (.annotation_defs o)))
    (set! (.conventions pp) (box-al [Convention] a (.conventions o)))
    (set! (.structs pp) (box-al [StructDef] a (.structs o)))
    (set! (.sums pp) (box-al [SumDef] a (.sums o)))
    (set! (.externs pp) (box-al [Extern] a (.externs o)))
    (set! (.funcs pp) (box-al [Func] a (.funcs o)))
    (set! (.asserts pp) (box-al [StaticAssert] a (.asserts o)))
    (set! (.consts pp) (box-al [Const] a (.consts o)))
    (set! (.traits pp) (box-al [TraitDef] a (.traits o)))
    (set! (.impls pp) (box-al [ImplDef] a (.impls o)))
    (set! (.metas pp) (box-al [Expr] a (.metas o)))
    (set! (.exports pp) (box-al [ExportC] a (.exports o)))
    (set! (.function_abis pp) (box-al [Extern] a (al-new [Extern] a)))
    pp))

(defn init-ctx [(c (ptr Ctx))
                (a (dyn Allocator))
                (m (slice u8))
                (imp (ptr ImpEntry))
                (table (ptr (ArrayList DefEntry)))
                (exp (ptr (ArrayList ExpEntry)))
                (bareok (ptr (ArrayList (slice u8))))
                (strict bool)
                (diags (ptr (ArrayList Diag)))
                (poisoned (ptr (ArrayList (slice u8))))] (-> i64)
  (set! (.a c) a)
  (set! (.m c) m)
  (set! (.imp c) imp)
  (set! (.table c) table)
  (set! (.exp c) exp)
  (set! (.strict c) strict)
  (set! (.bareok c) bareok)
  (set! (.fname c) "")
  (set! (.diags c) diags)
  (set! (.poisoned c) poisoned)
  0)

; tool-10 (import-site collision). The two parallel `(ptr SBox)`s hold, for one importer,
; the names already explicitly `:use [name]`'d and the module each came from — a box so the
; push survives across the per-`:use` scan (a bare ArrayList can't be grown through a ptr).
; partner-of returns the module a name was first seen from, or "" if this is the first.
(defn partner-of [(nbox (ptr SBox)) (tbox (ptr SBox)) (nm (slice u8))] (-> (slice u8))
  (let [names (field nbox items)
        tgts (field tbox items)
        n (al-len [(slice u8)] (load names))
        (mut i) 0
        (mut r) ""]
    (loop (if (>= (load i) n)
              (break)
              (do
                (when (= (al-get [(slice u8)] (load names) (load i)) nm)
                  (store! r (al-get [(slice u8)] (load tgts) (load i)))
                  (break))
                (set! i (primitive/iadd (load i) 1)))))
    (load r)))

; Scan one `:use [names]` entry: the first name already seen from a DIFFERENT module is the
; collision (Some diag); otherwise every name is recorded and None is returned.
(defn scan-use-names [(a (dyn Allocator))
                      (importer (slice u8))
                      (nbox (ptr SBox))
                      (tbox (ptr SBox))
                      (nms (ptr (ArrayList (slice u8))))
                      (tgt (slice u8))] (-> (Option Diag))
  (let [nn (al-len [(slice u8)] (load nms))
        (mut k) 0
        (mut r) (None [Diag])]
    (loop (if (>= (load k) nn)
              (break)
              (do
                (let [nm (al-get [(slice u8)] (load nms) (load k))
                      prev (partner-of nbox tbox nm)]
                  (if (and (> (slice-len [u8] prev) (primitive/cast i64 0)) (not (= prev tgt)))
                      (do (set! r (Some (derr (use-dup-msg a importer nm prev tgt)))) (break))
                      (do (al-push! (mut (.items nbox)) nm) (al-push! (mut (.items tbox)) tgt) 0)))
                (set! k (primitive/iadd (load k) 1)))))
    (load r)))

; One importer: scan every `:use [names]` entry, sharing the seen-name boxes across them.
(defn dup-in-importer [(a (dyn Allocator)) (ie (ptr ImpEntry))] (-> (Result i64 Diag))
  (let [importer (.name ie)
        uses (field (field ie imp) uses)
        un (al-len [Use] (load uses))
        (mut j) 0
        nbox (box! a SBox (primitive/zeroed SBox))
        tbox (box! a SBox (primitive/zeroed SBox))
        (mut err) (primitive/zeroed Diag)
        (mut failed) false]
    (set! (.items nbox) (al-new [(slice u8)] a))
    (set! (.items tbox) (al-new [(slice u8)] a))
    (loop (if (or (load failed) (>= (load j) un))
              (break)
              (do
                (let [up (primitive/alloc-stack Use)]
                  (set! up (al-get [Use] (load uses) (load j)))
                  (match (.spec up)
                    (UAll [] 0)
                    (UNames [nms]
                            (match (scan-use-names a importer nbox tbox nms (.target up))
                              (Some [d] (do (set! err d) (set! failed true) 0))
                              (None [] 0)))))
                (set! j (primitive/iadd (load j) 1)))))
    (if (load failed) (Err (load err)) (Ok [i64 Diag] 0))))

; tool-10: reject the SAME name explicitly `:use [name]`'d from two DIFFERENT modules in one
; importer, eagerly at the import site (before any use site is even reached).
(defn check-explicit-use-dups [(a (dyn Allocator)) (impb (ptr (ArrayList ImpEntry)))] (-> (Result i64 Diag))
  (let [n (al-len [ImpEntry] (load impb))
        (mut i) 0
        (mut err) (primitive/zeroed Diag)
        (mut failed) false]
    (loop (if (or (load failed) (>= (load i) n))
              (break)
              (do
                (match (dup-in-importer a (al-elem [ImpEntry] impb (load i)))
                  (Err [d] (do (set! err d) (set! failed true) 0))
                  (Ok [_] 0))
                (set! i (primitive/iadd (load i) 1)))))
    (if (load failed) (Err (load err)) (Ok [i64 Diag] 0))))

; diag-10: scan one `:use [names]` entry — the first name the target module does NOT export
; is a located error (Some diag); otherwise None.
(defn scan-use-exports [(a (dyn Allocator))
                        (importer (slice u8))
                        (expb (ptr (ArrayList ExpEntry)))
                        (nms (ptr (ArrayList (slice u8))))
                        (tgt (slice u8))] (-> (Option Diag))
  (let [nn (al-len [(slice u8)] (load nms))
        (mut k) 0
        (mut r) (None [Diag])]
    (loop (if (>= (load k) nn)
              (break)
              (do
                (let [nm (al-get [(slice u8)] (load nms) (load k))]
                  (when (not (exports-check expb tgt nm))
                    (store! r (Some (derr (use-unexported-msg a importer nm tgt))))
                    (break)))
                (set! k (primitive/iadd (load k) 1)))))
    (load r)))

; One importer: every `:use [names]` entry must name only exports of its target module.
(defn exports-in-importer [(a (dyn Allocator)) (expb (ptr (ArrayList ExpEntry))) (ie (ptr ImpEntry))] (-> (Result i64
                                                                                                                  Diag))
  (let [importer (.name ie)
        uses (field (field ie imp) uses)
        un (al-len [Use] (load uses))
        (mut j) 0
        (mut err) (primitive/zeroed Diag)
        (mut failed) false]
    (loop (if (or (load failed) (>= (load j) un))
              (break)
              (do
                (let [up (primitive/alloc-stack Use)]
                  (set! up (al-get [Use] (load uses) (load j)))
                  (match (.spec up)
                    (UAll [] 0)
                    (UNames [nms]
                            (match (scan-use-exports a importer expb nms (.target up))
                              (Some [d] (do (set! err d) (set! failed true) 0))
                              (None [] 0)))))
                (set! j (primitive/iadd (load j) 1)))))
    (if (load failed) (Err (load err)) (Ok [i64 Diag] 0))))

; diag-10: reject `:use [name]` naming a non-exported symbol, eagerly at the import site.
(defn check-use-exports [(a (dyn Allocator)) (impb (ptr (ArrayList ImpEntry))) (expb (ptr (ArrayList ExpEntry)))] (-> (Result i64
                                                                                                                              Diag))
  (let [n (al-len [ImpEntry] (load impb))
        (mut i) 0
        (mut err) (primitive/zeroed Diag)
        (mut failed) false]
    (loop (if (or (load failed) (>= (load i) n))
              (break)
              (do
                (match (exports-in-importer a expb (al-elem [ImpEntry] impb (load i)))
                  (Err [d] (do (set! err d) (set! failed true) 0))
                  (Ok [_] 0))
                (set! i (primitive/iadd (load i) 1)))))
    (if (load failed) (Err (load err)) (Ok [i64 Diag] 0))))

; `provide-core` is an export list, so a name in it that the module never defines
; is a typo. Left alone it fails silently and remotely: the name simply never
; becomes ambient, and the mistake surfaces as "call to undefined function" at some
; unrelated call site with nothing pointing back at the list. Report it where it was
; written.
;
; Modules absent from this table are skipped rather than reported: a table can
; legitimately cover a subset of the program, and a missing module means "not parsed
; here", not "not defined". The caller additionally skips tolerant sub-builds, whose
; tables are deliberately partial.
(defn core-provided-defined? [(table (ptr (ArrayList DefEntry)))
                              (module (slice u8))
                              (name (slice u8))] (-> bool)
  (let [e (table-find table module)
        (mut k) 0
        (mut found) false]
    (if (= (primitive/cast i64 e) (primitive/cast i64 0))
        true
        (do
          (loop (if (> (load k) (primitive/cast i64 6))
                    (break)
                    (do
                      (when (defs-has? e (load k) name) (store! found true) (break))
                      (set! k (primitive/iadd (load k) 1)))))
          (load found)))))

(defn check-core-provided-names [(a (dyn Allocator))
                                 (table (ptr (ArrayList DefEntry)))] (-> (Result i64 Diag))
  (let [n (core-decl-count)
        (mut i) 0
        (mut err) (primitive/zeroed Diag)
        (mut failed) false]
    (loop (if (or (load failed) (>= (load i) n))
              (break)
              (let [m (core-decl-module-at (load i))
                    nm (core-decl-name-at (load i))]
                (unless (core-provided-defined? table m nm)
                  (let [d (primitive/alloc-stack Diag)]
                    (set! (.lo d) (core-decl-lo-at (load i)))
                    (set! (.hi d) (core-decl-hi-at (load i)))
                    (set! (.source d) (core-decl-src-at (load i)))
                    (set! (.ctxt d) (core-decl-ctxt-at (load i)))
                    (set! (.msg d)
                          (sconcat3 a
                                    (sconcat3 a "provide-core: '" nm "' is not defined in module '")
                                    m
                                    "'"))
                    (store! err (load d))
                    (store! failed true)
                    0))
                (set! i (primitive/iadd (load i) 1)))))
    (if (load failed) (Err (load err)) (Ok [i64 Diag] 0))))

; ---- resolve-program, strict=true --------
; `tolerant` = SKIP a top-level form that does not parse, instead of aborting. Only
; the macro-context build (expander.coil::expand-stage3) passes true: at that point
; macros are not yet expanded, so a top-level macro CALL — `(gctype Node)` — is not
; yet a `defn` and cannot parse. Skipping those leaves every real definition in the
; context, so the comptime closure walk can reach ordinary functions rather than
; being restricted to a syntactic `Code`-signature subset. Every other caller passes
; false and still reports a genuine syntax error. NOTE: deliberately NOT keyed on
; `strict` — the authoritative resolve runs with strict=false whenever the program
; has metaprograms, and must still fail loudly on a real parse error.
; ---- primitive-definition resolution --------------------------------------
; Runs before AST parsing because primitive operands may themselves be type syntax.
; The parser receives only source spelling -> opcode bindings already resolved for
; the current module; it never interprets imports or primitive declaration names.
(defn primitive-canonical [(a (dyn Allocator)) (module (slice u8)) (name (slice u8))] (-> (slice u8))
  (sconcat3 a module "." name))

(defn primitive-def-op [(s (mut LS)) (canonical (slice u8))] (-> (Option (slice u8)))
  (let [defs (primitive/alloc-stack (ArrayList PrimitiveDef))
        a (load (field s a))
        (mut i) 0
        (mut out) (None [(slice u8)])]
    (set! defs (.primitive_defs s))
    (let [n (al-len [PrimitiveDef] (load defs))]
      (loop (if (>= (load i) n)
                (break)
                (let [p (al-elem [PrimitiveDef] defs (load i))]
                  (if (= (primitive-canonical a
                                              (.module p)
                                              (.name p))
                         canonical)
                      (do (set! out (Some (.opcode p))) (break))
                      (set! i (primitive/iadd (load i) 1)))))))
    (load out)))

(defn primitive-alias-target [(s (mut LS)) (canonical (slice u8))] (-> (Option (slice u8)))
  (let [aliases (primitive/alloc-stack (ArrayList PrimitiveAlias))
        a (load (field s a))
        (mut i) 0
        (mut out) (None [(slice u8)])]
    (set! aliases (.primitive_aliases s))
    (let [n (al-len [PrimitiveAlias] (load aliases))]
      (loop (if (>= (load i) n)
                (break)
                (let [p (al-elem [PrimitiveAlias] aliases (load i))]
                  (if (= (primitive-canonical a
                                              (.module p)
                                              (.name p))
                         canonical)
                      (let [raw (.target p)
                            slash (find-slash raw)]
                        (if (>= slash (primitive/cast i64 0))
                            (let [impe (imports-find (field s imports) (.module p))
                                  prefix (subslice raw 0 slash)
                                  rest (subslice raw (primitive/iadd slash 1) (slice-len raw))]
                              (if (= (primitive/cast i64 impe) (primitive/cast i64 0))
                                  (break)
                                  (match (alias-target impe prefix)
                                    (Some [target] (do (set! out (Some (primitive-canonical a target rest))) (break)))
                                    (None [] (break)))))
                            (do (set! out (Some (primitive-canonical a (.module p) raw))) (break))))
                      (set! i (primitive/iadd (load i) 1)))))))
    (load out)))

(defn primitive-op [(s (mut LS)) (canonical (slice u8)) (depth i64)] (-> (Option (slice u8)))
  (if (> depth (primitive/cast i64 64))
      (None [(slice u8)])
      (match (primitive-def-op (mut s) canonical)
        (Some [op] (Some op))
        (None []
              (match (primitive-alias-target (mut s) canonical)
                (Some [target] (primitive-op (mut s) target (primitive/iadd depth 1)))
                (None [] (None [(slice u8)])))))))

(defn primitive-binding-push! [(out (mut (ArrayList PrimitiveBinding))) (name (slice u8)) (op (slice u8))] (-> i64)
  (let [p (primitive/alloc-stack PrimitiveBinding)]
    (set! (.source_name p) name)
    (set! (.source_module p) "")
    (set! (.opcode p) op)
    (al-push! (mut out) (load p)))
  0)

(defn primitive-bind-one! [(s (mut LS))
                           (module (slice u8))
                           (decl-module (slice u8))
                           (name (slice u8))
                           (op (slice u8))
                           (out (mut (ArrayList PrimitiveBinding)))] (-> i64)
  (let [a (load (field s a))
        impe (imports-find (field s imports) module)]
    ; Fully-qualified module names resolve without an import alias, just like
    ; ordinary definitions.  This also lets hygienic macros emit canonical names.
    (primitive-binding-push! (mut out) (sconcat3 a decl-module "/" name) op)
    (when (= module decl-module) (primitive-binding-push! (mut out) name op) 0)
    (when (!= (primitive/cast i64 impe) (primitive/cast i64 0))
      (let [aliases (field (field impe imp) aliases)
            n (al-len [Alias] (load aliases))
            (mut i) 0]
        (loop (if (>= (load i) n)
                  (break)
                  (let [p (al-elem [Alias] aliases (load i))]
                    (when (and (= (load (field p target)) decl-module)
                               (exports-check (field s exports) decl-module name))
                      (primitive-binding-push! (mut out) (sconcat3 a (load (field p alias)) "/" name) op)
                      0)
                    (store! i (primitive/iadd (load i) 1))))))
      (let [uses (field (field impe imp) uses)
            n (al-len [Use] (load uses))
            (mut i) 0]
        (loop (if (>= (load i) n)
                  (break)
                  (let [p (al-elem [Use] uses (load i))]
                    (when (and (= (load (field p target)) decl-module)
                               (exports-check (field s exports) decl-module name))
                      (match (use-local-of p name)
                        (None [] 0)
                        (Some [local] (primitive-binding-push! (mut out) local op)))
                      0)
                    (store! i (primitive/iadd (load i) 1)))))))
    ; core's ambient aliases (`load`, `store!`, `field`, `cast`, …) go through the same
    ; refer rules as everything else, so `:exclude [load]` really does force
    ; `primitive/load` rather than hiding the name from one pass and not the others.
    (when (and (not (= module (implicit-prelude-name a)))
               (= decl-module (implicit-prelude-name a)))
      (match (core-local-of impe name)
        (None [] 0)
        (Some [local] (primitive-binding-push! (mut out) local op)))
      0))
  0)

(defn primitive-bind-one-scoped! [(s (mut LS))
                                  (source-module (slice u8))
                                  (decl-module (slice u8))
                                  (name (slice u8))
                                  (op (slice u8))
                                  (out (mut (ArrayList PrimitiveBinding)))] (-> i64)
  (let [start (al-len [PrimitiveBinding] (load out))]
    (primitive-bind-one! (mut s) source-module decl-module name op (mut out))
    (for [i start (al-len [PrimitiveBinding] (load out))]
      (set! (.source_module (al-elem [PrimitiveBinding] (mut out) i)) source-module)))
  0)

; Parser primitive dispatch precedes ordinary resolution. Recompute the exact
; primitive names visible in the identifier's definition module, then tag those
; entries with that module. This includes bare `:use`/core refer names as well as
; qualified aliases; it does not merge the target module's spelling table.
(defn primitive-bind-scoped-module! [(s (mut LS))
                                     (source-module (slice u8))
                                     (out (mut (ArrayList PrimitiveBinding)))] (-> i64)
  (let [defs (primitive/alloc-stack (ArrayList PrimitiveDef))
        aliases (primitive/alloc-stack (ArrayList PrimitiveAlias))]
    (set! defs (.primitive_defs s))
    (for [i 0 (al-len [PrimitiveDef] (load defs))]
      (let [p (al-elem [PrimitiveDef] defs i)]
        (primitive-bind-one-scoped! (mut s)
                                    source-module
                                    (.module p)
                                    (.name p)
                                    (.opcode p)
                                    (mut out))))
    (set! aliases (.primitive_aliases s))
    (for [i 0 (al-len [PrimitiveAlias] (load aliases))]
      (let [p (al-elem [PrimitiveAlias] aliases i)
            canonical (primitive-canonical (load (field s a)) (.module p) (.name p))]
        (match (primitive-op (mut s) canonical 0)
          (Some [op]
                (primitive-bind-one-scoped! (mut s)
                                            source-module
                                            (.module p)
                                            (.name p)
                                            op
                                            (mut out)))
          (None [] 0)))))
  0)

(defn primitive-bindings-have-scope? [(out (ptr (ArrayList PrimitiveBinding)))
                                      (source-module (slice u8))] (-> bool)
  (let [n (al-len [PrimitiveBinding] (load out))
        (mut i) 0
        (mut found) false]
    (loop (if (>= (load i) n)
              (break)
              (let [p (al-elem [PrimitiveBinding] out (load i))]
                (if (= (.source_module p) source-module)
                    (do (set! found true) (break))
                    (set! i (primitive/iadd (load i) 1))))))
    (load found)))

; Only materialize definition-module bindings actually present in this authored
; form. Building a complete spelling table for every imported module multiplied
; resolver work and memory across the whole compiler graph.
(defn primitive-add-hyg-scopes! [(s (mut LS))
                                 (node (ptr Sexp))
                                 (out (ptr (ArrayList PrimitiveBinding)))] (-> i64)
  (let [sx (load node)
        tg (sx-tag sx)]
    (when (and (= tg (primitive/cast i64 2)) (> (sx-hyg sx) 0))
      (let [m (sx-hmod sx)]
        (when (and (> (slice-len m) 0) (not (primitive-bindings-have-scope? out m)))
          (primitive-bind-scoped-module! (mut s) m (mut out))
          0))
      0)
    (when (or (= tg (primitive/cast i64 6)) (= tg (primitive/cast i64 7)))
      (let [items (sx-items sx)]
        (for [i 0 (sx-len items)]
          (primitive-add-hyg-scopes! (mut s) (al-elem [Sexp] items i) out)))
      0))
  0)

(defn primitive-bindings-for [(s (mut LS)) (module (Option (slice u8)))] (-> (ptr (ArrayList PrimitiveBinding)))
  (let [a (load (field s a))
        box (box! a (ArrayList PrimitiveBinding) (primitive/zeroed (ArrayList PrimitiveBinding)))
        (mut out) (al-new [PrimitiveBinding] a)]
    ; Canonical names do not depend on the current source having a module
    ; declaration. This mirrors ordinary fully-qualified lookup and matters for
    ; small standalone/comptime files.
    (let [defs (primitive/alloc-stack (ArrayList PrimitiveDef))
          (mut i) 0]
      (set! defs (.primitive_defs s))
      (let [n (al-len [PrimitiveDef] (load defs))]
        (loop (if (>= (load i) n)
                  (break)
                  (let [p (al-elem [PrimitiveDef] defs (load i))]
                    (primitive-binding-push! (mut out)
                                             (sconcat3 a (.module p) "/" (.name p))
                                             (.opcode p))
                    (set! i (primitive/iadd (load i) 1)))))))
    (let [aliases (primitive/alloc-stack (ArrayList PrimitiveAlias))
          (mut i) 0]
      (set! aliases (.primitive_aliases s))
      (let [n (al-len [PrimitiveAlias] (load aliases))]
        (loop (if (>= (load i) n)
                  (break)
                  (let [p (al-elem [PrimitiveAlias] aliases (load i))
                        canonical
                          (primitive-canonical a
                                               (.module p)
                                               (.name p))]
                    (match (primitive-op (mut s) canonical 0)
                      (Some [op]
                            (primitive-binding-push! (mut out)
                                                     (sconcat3 a
                                                               (.module p)
                                                               "/"
                                                               (.name p))
                                                     op))
                      (None [] 0))
                    (set! i (primitive/iadd (load i) 1)))))))
    (match module
      (None [] 0)
      (Some [m]
            (do
              (let [defs (primitive/alloc-stack (ArrayList PrimitiveDef))
                    (mut i) 0]
                (set! defs (.primitive_defs s))
                (let [n (al-len [PrimitiveDef] (load defs))]
                  (loop (if (>= (load i) n)
                            (break)
                            (let [p (al-elem [PrimitiveDef] defs (load i))]
                              (primitive-bind-one! (mut s)
                                                   m
                                                   (.module p)
                                                   (.name p)
                                                   (.opcode p)
                                                   (mut out))
                              (set! i (primitive/iadd (load i) 1)))))))
              (let [aliases (primitive/alloc-stack (ArrayList PrimitiveAlias))
                    (mut i) 0]
                (set! aliases (.primitive_aliases s))
                (let [n (al-len [PrimitiveAlias] (load aliases))]
                  (loop (if (>= (load i) n)
                            (break)
                            (let [p (al-elem [PrimitiveAlias] aliases (load i))
                                  canonical
                                    (primitive-canonical a
                                                         (.module p)
                                                         (.name p))]
                              (match (primitive-op (mut s) canonical 0)
                                (Some [op]
                                      (primitive-bind-one! (mut s)
                                                           m
                                                           (.module p)
                                                           (.name p)
                                                           op
                                                           (mut out)))
                                (None [] 0))
                              (set! i (primitive/iadd (load i) 1))))))))))
    (set! box (load out))
    box))

(defstruct PrimitiveBindingsCacheEntry
  [(module (Option (slice u8)))
   (bindings (ptr (ArrayList PrimitiveBinding)))
   (plain_index (ptr (HashMap (slice u8) (slice u8))))
   (scoped_index (ptr (HashMap (slice u8) (slice u8))))])

(defn primitive-module-eq? [(a (Option (slice u8))) (b (Option (slice u8)))] (-> bool)
  (match a
    (None [] (match b (None [] true) (Some [_] false)))
    (Some [x] (match b (None [] false) (Some [y] (= x y))))))

(defn semantic-revision-find [(ws (ptr SemanticWorkspace))
                              (module (Option (slice u8)))
                              (form-id i64)
                              (revision i64)
                              (shape i64)] (-> i64)
  (let [(mut i) (match (hm-get [i64 i64] (load (field ws revision_heads)) form-id)
                  (Some [head] head)
                  (None [] -1))
        (mut found) -1]
    (loop (if (< (load i) 0)
              (break)
              (let [e (al-elem [ResolvedRevision] (field ws resolved_revisions) (load i))]
                (if (and (= (load (field (field e revision) form_id)) form-id)
                         (and (= (load (field (field e revision) revision)) revision)
                              (and (= (load (field (field e revision) shape)) shape)
                                   (primitive-module-eq? (load (field e module)) module))))
                    (do (store! found (load i)) (break))
                    (store! i (load (field e previous_same_form)))))))
    (load found)))

(defn semantic-revision-add! [(ws (ptr SemanticWorkspace))
                              (owner (dyn Allocator))
                              (module (Option (slice u8)))
                              (form-id i64)
                              (revision i64)
                              (shape i64)
                              (form (ptr Sexp))
                              (prog (ptr Program))
                              (defs Defs)] (-> i64)
  (let [e (primitive/alloc-stack ResolvedRevision)]
    (store! (field (field e revision) form_id) form-id)
    (store! (field (field e revision) revision) revision)
    (store! (field (field e revision) shape) shape)
    (store! (field e previous_same_form)
            (match (hm-get [i64 i64] (load (field ws revision_heads)) form-id)
              (Some [head] head)
              (None [] -1)))
    (store! (field e module) module)
    (store! (field e raw_form) (semantic-clone-sexp owner form))
    (store! (field e prog) prog)
    (store! (field e raw_prog) (semantic-clone-program owner prog))
    (store! (field e defs) defs)
    (store! (field e impl_quals) (al-new [CachedImplQual] owner))
    (store! (field e type_resolutions) (al-new [TypeResEntry] owner))
    (store! (field e qualified) false)
    (store! (field e strict) false)
    (al-push! (mut (field ws resolved_revisions)) (load e))
    (let [index (primitive/isub (al-len [ResolvedRevision]
                                         (load (field ws resolved_revisions)))
                                1)]
      (hm-put! [i64 i64] (mut (field ws revision_heads)) form-id index)
      index)))

(defn semantic-capture-resolution! [(owner (dyn Allocator))
                                    (entry (ptr ResolvedRevision))
                                    (impl-start i64)
                                    (type-start i64)] (-> i64)
  (store! (field entry impl_quals) (al-new [CachedImplQual] owner))
  (store! (field entry type_resolutions) (al-new [TypeResEntry] owner))
  (let [src (impl-qual-list)
        n (al-len [ImplQualEntry] (load src))
        (mut i) impl-start]
    (loop (if (>= (load i) n)
              (break)
              (do
                (let [x (al-elem [ImplQualEntry] src (load i))
                      c (primitive/alloc-stack CachedImplQual)]
                  (store! (field c nid) (load (field x nid)))
                  (store! (field c bare) (load (field x bare)))
                  (al-push! (mut (field entry impl_quals)) (load c)))
                (store! i (primitive/iadd (load i) 1))))))
  (let [src (type-res-list)
        n (al-len [TypeResEntry] (load src))
        (mut i) type-start]
    (loop (if (>= (load i) n)
              (break)
              (do
                (al-push! (mut (field entry type_resolutions))
                          (al-get [TypeResEntry] (load src) (load i)))
                (store! i (primitive/iadd (load i) 1))))))
  0)

(defn semantic-replay-resolution! [(entry (ptr ResolvedRevision))] (-> i64)
  (let [src (field entry impl_quals)
        n (al-len [CachedImplQual] (load src))
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (let [x (al-elem [CachedImplQual] src (load i))
                      out (primitive/alloc-stack ImplQualEntry)]
                  (store! (field out nid) (load (field x nid)))
                  (store! (field out bare) (load (field x bare)))
                  (al-push! (impl-qual-list) (load out)))
                (store! i (primitive/iadd (load i) 1))))))
  (let [src (field entry type_resolutions)
        n (al-len [TypeResEntry] (load src))
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (al-push! (type-res-list) (al-get [TypeResEntry] (load src) (load i)))
                (store! i (primitive/iadd (load i) 1))))))
  0)

; Primitive visibility depends only on the current module and the loader's immutable
; import/export tables. A resolve pass used to rebuild the complete binding list for
; every top-level form—hundreds of times for a normal program—even though adjacent
; definitions overwhelmingly share a module.
(defn primitive-bindings-cached [(s (mut LS))
                                 (cache (mut (ArrayList PrimitiveBindingsCacheEntry)))
                                 (module (Option (slice u8)))] (-> (ptr PrimitiveBindingsCacheEntry))
  (let [n (al-len [PrimitiveBindingsCacheEntry] (load cache))
        (mut i) 0
        (mut found) (primitive/cast (ptr PrimitiveBindingsCacheEntry) 0)]
    (loop (if (>= (load i) n)
              (break)
              (let [entry (al-elem [PrimitiveBindingsCacheEntry] cache (load i))]
                (if (primitive-module-eq? (.module entry) module)
                    (do (set! found entry) (break))
                    (set! i (primitive/iadd (load i) 1))))))
    (if (!= (primitive/cast i64 (load found)) 0)
        (load found)
        (let [bindings (primitive-bindings-for (mut s) module)
              (mut index) (hm-new [(slice u8) (slice u8)] (load (field s a)) (str-keyops))
              (mut scoped-index) (hm-new [(slice u8) (slice u8)] (load (field s a)) (str-keyops))
              entry (primitive/alloc-stack PrimitiveBindingsCacheEntry)]
          (for [bi 0 (al-len [PrimitiveBinding] (load bindings))]
            (let [binding (al-elem [PrimitiveBinding] bindings bi)]
              (when (and (= (.source_module binding) "")
                         (none? [(slice u8)]
                                (hm-get [(slice u8) (slice u8)] (load index) (.source_name binding))))
                (hm-put! [(slice u8) (slice u8)]
                         (mut index)
                         (.source_name binding)
                         (.opcode binding))
                0)
              (when (!= (.source_module binding) "")
                (match (hm-get [(slice u8) (slice u8)]
                               (load scoped-index)
                               (.source_name binding))
                  (None [] (hm-put! [(slice u8) (slice u8)]
                                    (mut scoped-index)
                                    (.source_name binding)
                                    (.opcode binding)))
                  (Some [prior]
                        (when (!= prior (.opcode binding))
                          (hm-put! [(slice u8) (slice u8)]
                                   (mut scoped-index)
                                   (.source_name binding)
                                   "")
                          0))))))
          (set! (.module entry) module)
          (set! (.bindings entry) bindings)
          (set! (.plain_index entry)
                (box! (load (field s a)) (HashMap (slice u8) (slice u8)) (load index)))
          (set! (.scoped_index entry)
                (box! (load (field s a)) (HashMap (slice u8) (slice u8)) (load scoped-index)))
          (al-push! [PrimitiveBindingsCacheEntry] (mut cache) (load entry))
          (al-elem [PrimitiveBindingsCacheEntry]
                   (mut cache)
                   (primitive/isub (al-len [PrimitiveBindingsCacheEntry] (load cache)) 1))))))

; Build the declaration view for an incremental epoch. A changed universe gets
; fresh mutable Programs cloned from each revision's immutable parser snapshot;
; the parser itself is never re-entered. Canonical syntax nids remain shared with
; the loader so checker/type-of side tables join the same semantic nodes.
(defn semantic-prepare-table [(owner (dyn Allocator))
                              (ws (ptr SemanticWorkspace))
                              (parsed (ptr (ArrayList ParsedForm)))
                              (out-forms (ptr (ArrayList TaggedForm)))] (-> (Result (ptr (ArrayList DefEntry)) Diag))
  (let [candidate (build-deftable owner parsed)
        same
          (and (load (field ws has_declaration_table))
               (deftables-equal? (load (field ws declaration_table)) candidate))]
    (tr/count "semantic.declaration-table-reused" (if same 1 0))
    (unless same
      (when (load (field ws has_declaration_table))
        (let [n (al-len [ParsedForm] (load parsed)) (mut i) 0]
          (loop (if (>= (load i) n) (break)
                    (let [pf (al-elem [ParsedForm] parsed (load i))]
                      (unless (load (field pf fresh))
                        (let [entry (al-elem [ResolvedRevision]
                                             (field ws resolved_revisions)
                                             (load (field pf entry_index)))
                              working (semantic-clone-program owner (load (field entry raw_prog)))]
                          (store! (field entry prog) working)
                          (store! (field entry qualified) false)
                          (store! (field entry strict) false)
                          (store! (field pf prog) working)
                          (store! (field pf fresh) true)
                          0))
                      (store! i (primitive/iadd (load i) 1)))))))
      ; Qualification side maps describe the declaration universe. Replace them
      ; only when that universe changes; an unchanged incremental round extends
      ; the existing maps for fresh revisions and leaves cached answers intact.
      (type-res-reset)
      (value-res-reset)
      (src-mod-reset)
      (let [nf (al-len [TaggedForm] (load out-forms))
            (mut fi) 0]
        (loop (if (>= (load fi) nf)
                  (break)
                  (let [tf (al-elem [TaggedForm] out-forms (load fi))]
                    (src-mod-record (sx-source (load (field tf form)))
                                    (match (load (field tf module))
                                      (Some [m] m)
                                      (None [] "")))
                    (store! fi (primitive/iadd (load fi) 1))))))
      0)
    (store! (field ws declaration_table) candidate)
    (store! (field ws has_declaration_table) true)
    (Ok [(ptr (ArrayList DefEntry)) Diag] candidate)))

(defn semantic-audit-invariant [(s (mut LS))] (-> (Result i64 Diag))
  (let [audit (load (field s semantic_audit))]
    (if (not (= (load (field audit full_resolves)) 1))
        (Err [i64 Diag]
             (derr "internal compiler error: semantic workspace initialized more than once"))
        (if (not (= (load (field audit form_parse_attempts))
                    (load (field audit unique_form_revisions))))
            (Err [i64 Diag]
                 (derr "internal compiler error: a semantic form revision was parsed more than once"))
            (if (not (= (load (field audit duplicate_form_parses)) 0))
                (Err [i64 Diag]
                     (derr "internal compiler error: duplicate semantic form parse escaped the revision cache"))
                (Ok [i64 Diag] 0))))))

(defn resolve-program [(a (dyn Allocator)) (s (mut LS)) (strict bool) (tolerant bool)] (-> (Result (ptr Program) Diag))
  (let [impb (box! a (ArrayList ImpEntry) (primitive/zeroed (ArrayList ImpEntry)))
        expb (box! a (ArrayList ExpEntry) (primitive/zeroed (ArrayList ExpEntry)))
        out-forms (field s out)
        nforms (al-len [TaggedForm] (load out-forms))
        ws (semantic-workspace (mut s))
        owner (load (field (load (field s semantic_workspace)) owner))
        pb (box! a PBox (primitive/zeroed PBox))
        parsed (field pb items)
        (mut perr) (primitive/zeroed Diag)
        (mut pfailed) false
        (mut fi) 0
        (mut cache-hits) 0
        parse-span (tr/span-begin "frontend.resolve.parse")
        (mut primitive-cache) (al-new [PrimitiveBindingsCacheEntry] a)
        (mut dupd) (primitive/zeroed Diag)
        (mut dupfail) false]
    (semantic-audit-resolve-update! (mut s))
    (set! impb (.imports s))
    (set! expb (.exports s))
    (match (check-explicit-use-dups a impb)
      (Err [d] (do (set! dupd d) (set! dupfail true) 0))
      (Ok [_] 0))
    ; diag-10: a `:use [name]` naming a non-exported symbol is a located error, not silence.
    (unless (load dupfail)
      (match (check-use-exports a impb expb)
        (Err [d] (do (store! dupd d) (store! dupfail true) 0))
        (Ok [_] 0)))
    (set! (.items pb) (al-new [ParsedForm] a))
    ; Pass 0: materialize one parsed entry per form revision. Exact revisions
    ; already owned by this compilation reuse their Program and raw declaration
    ; summary. Whether their qualification is reusable is decided only after the
    ; complete declaration environment has been rebuilt below.
    (loop (if (>= (load fi) nforms)
              (break)
              (do
                (let [tfp (al-elem [TaggedForm] (field s out) (load fi))]
                  (semantic-adopt-form! ws tfp)
                  ; record which module this source file belongs to (for type-node resolution)
                  (src-mod-record (sx-source (.form tfp))
                                  (match (.module tfp) (Some [m] m) (None [] "")))
                  (let [form-id (load (field tfp form_id))
                        (mut revision) (load (field tfp revision))
                        (mut shape) (load (field tfp cached_shape))
                        (mut cached)
                          (semantic-revision-find ws
                                                  (.module tfp)
                                                  form-id
                                                  (load revision)
                                                  (load shape))]
                    (when (= (load shape) 0)
                      (store! shape (semantic-revision-token (load revision)))
                      (store! (field tfp cached_shape) (load shape))
                      0)
                    ; Rewriting any part creates a new top-level semantic
                    ; revision. Freshen the complete tree so unchanged children
                    ; cannot alias annotations retained by the old revision.
                    (when (< (load cached) 0)
                      ; A mutation site that did not explicitly advance the
                      ; revision is repaired here and becomes visible to the
                      ; invariant audit.
                      (when (semantic-form-revision-known? ws form-id (load revision))
                        (store! revision (primitive/iadd (load revision) 1))
                        (store! (field tfp revision) (load revision))
                        (store! (field tfp cached_shape) 0)
                        0)
                      ; Reader/metaprogram node counters live in separate native
                      ; images and can collide. Only host-assigned ids enter the
                      ; semantic model; exact cached revisions retain them.
                      (semantic-freshen-nids! (field tfp form))
                      (store! shape (semantic-revision-token (load revision)))
                      (store! (field tfp cached_shape) (load shape))
                      0)
                    (if (>= (load cached) 0)
                        (let [pf (primitive/alloc-stack ParsedForm)
                              entry (al-elem [ResolvedRevision]
                                             (field ws resolved_revisions)
                                             (load cached))]
                          ; The semantic revision owns node identity. Native
                          ; engines and syntax snapshots may reproduce the same
                          ; form with different numeric nids; restore the
                          ; canonical syntax tree so Code/type-of joins use the
                          ; exact ids copied into the cached parser AST.
                          (when (not (= (load (field (field tfp form) nid))
                                        (load (field (field entry raw_form) nid))))
                            (store! (field tfp form)
                                    (semantic-clone-sexp owner (field entry raw_form)))
                            0)
                          (store! cache-hits (primitive/iadd (load cache-hits) 1))
                          (store! (field pf prog) (load (field entry prog)))
                          (store! (field pf module) (.module tfp))
                          (store! (field pf defs) (load (field entry defs)))
                          (store! (field pf entry_index) (load cached))
                          (store! (field pf fresh) false)
                          (store! (field pf source_index) (load fi))
                          (al-push! (mut (.items pb)) (load pf)))
                        (do
                          (semantic-audit-form-parse! (mut s))
                          (let [binding-entry
                                  (primitive-bindings-cached (mut s)
                                                             (mut primitive-cache)
                                                             (.module tfp))]
                            (primitive-add-hyg-scopes! (mut s)
                                                       (field tfp form)
                                                       (load (field binding-entry bindings)))
                            (parser-set-primitive-bindings!
                              (load (field binding-entry bindings))
                              (load (field binding-entry plain_index))
                              (load (field binding-entry scoped_index))))
                          (let [single (box! owner
                                             (ArrayList Sexp)
                                             (primitive/zeroed (ArrayList Sexp)))
                                (mut sl) (al-new [Sexp] owner)]
                            (al-push! (mut sl) (.form tfp))
                            (set! single (load sl))
                            (match (parse-program owner single)
                              (Err [d]
                                   (unless tolerant
                                     (store! perr d)
                                     (store! pfailed true)
                                     (break)))
                              (Ok [prog]
                                  (let [pp (box! owner Program (primitive/zeroed Program))
                                        pf (primitive/alloc-stack ParsedForm)]
                                    (set! pp prog)
                                    (let [defs (program-raw-defs owner (.module tfp) pp)
                                          entry
                                            (semantic-revision-add! ws
                                                                    owner
                                                                    (.module tfp)
                                                                    form-id
                                                                    (load revision)
                                                                    (load shape)
                                                                    (field tfp form)
                                                                    pp
                                                                    defs)]
                                      (store! (field pf prog) pp)
                                      (store! (field pf module) (.module tfp))
                                      (store! (field pf defs) defs)
                                      (store! (field pf entry_index) entry)
                                      (store! (field pf fresh) true)
                                      (store! (field pf source_index) (load fi))
                                      (al-push! (mut (.items pb)) (load pf)))))))))))
                (set! fi (primitive/iadd (load fi) 1)))))
    (tr/span-end parse-span)
    (tr/count "semantic.form-cache-hits" (load cache-hits))
    (unless (load pfailed)
      (match (semantic-audit-invariant (mut s))
        (Err [d] (do (store! perr d) (store! pfailed true) 0))
        (Ok [_] 0)))
    (if (load dupfail)
        (Err (load dupd))
        (if (load pfailed)
            (Err (load perr))
            (match (semantic-prepare-table owner
                                           ws
                                           parsed
                                           (box-al [TaggedForm] owner (load out-forms)))
              (Err [d] (Err [(ptr Program) Diag] d))
              (Ok [table]
                  (match (if tolerant
                             (Ok [i64 Diag] 0)
                             (check-core-provided-names a table))
                    (Err [d] (Err [(ptr Program) Diag] d))
                    (Ok [_]
                  (let [audit (load (field s semantic_audit))
                        _ (tr/count "semantic.full-resolves" (load (field audit full_resolves)))
                        _ (tr/count "semantic.incremental-resolve-updates"
                                    (load (field audit incremental_resolve_updates)))
                        _ (tr/count "semantic.form-parse-attempts" (load (field audit form_parse_attempts)))
                        _ (tr/count "semantic.unique-form-revisions" (load (field audit unique_form_revisions)))
                        _ (tr/count "semantic.duplicate-form-parses" (load (field audit duplicate_form_parses)))
                        qualify-span (tr/span-begin "frontend.resolve.qualify")
                        bareok (build-bareok a parsed)
                        o (primitive/alloc-stack Out)
                        np (al-len [ParsedForm] (load parsed))
                        rdiags (box! a (ArrayList Diag) (primitive/zeroed (ArrayList Diag)))
                        rpoison (box! a (ArrayList (slice u8)) (primitive/zeroed (ArrayList (slice u8))))
                        (mut qerr) (primitive/zeroed Diag)
                        (mut qfailed) false
                        (mut qi) 0]
                    (set! rdiags (al-new [Diag] a))
                    (set! rpoison (al-new [(slice u8)] a))
                    (set! (.resolve_diags s) rdiags)
                    (set! (.resolve_poisoned s) rpoison)
                    (init-out o a)
                    (loop (if (>= (load qi) np)
                              (break)
                              (do
                                (let [pf (al-elem [ParsedForm] parsed (load qi))
                                      prog (load (field pf prog))
                                      entry (al-elem [ResolvedRevision]
                                                     (field ws resolved_revisions)
                                                     (load (field pf entry_index)))
                                      needs
                                        (or (load (field pf fresh))
                                            (or (not (load (field entry qualified)))
                                                (and strict (not (load (field entry strict))))))]
                                  (when needs
                                    (let [m (match (.module pf) (Some [name] name) (None [] ""))
                                          imp (imports-find impb m)
                                          cx (primitive/alloc-stack Ctx)
                                          impl-start (al-len [ImplQualEntry] (load (impl-qual-list)))
                                          type-start (al-len [TypeResEntry] (load (type-res-list)))]
                                      (init-ctx cx a m imp table expb bareok strict rdiags rpoison)
                                      (set! (.impb cx) impb)
                                      (match (qualify-program cx prog)
                                        (Err [d]
                                             (do
                                               (set! qerr d)
                                               (set! qfailed true)
                                               (break)))
                                        (Ok [_]
                                            (do
                                              (semantic-capture-resolution! owner entry impl-start type-start)
                                              (store! (field entry qualified) true)
                                              (when strict
                                                (store! (field entry strict) true)
                                                0)))))
                                    0)
                                  (unless needs
                                    (semantic-replay-resolution! entry)
                                    0)
                                  (unless (load qfailed)
                                    (match (merge-into (mut o) prog a)
                                      (Err [d]
                                           (do
                                             (store! qerr d)
                                             (store! qfailed true)
                                             (break)))
                                      (Ok [_] 0))))
                                (set! qi (primitive/iadd (load qi) 1)))))
                    (tr/span-end qualify-span)
                    (if (load qfailed)
                        (Err (load qerr))
                        (Ok (out->program o a))))))))))))

; ============================ tables (Cx) ==========================
; Sig/StructInfo/SumInfo/Cx. The HashMaps become
; linear-scan ArrayList tables (the resolver's deftable idiom). Cx tables are
; BY-VALUE ArrayList fields so they can be pushed via (mut (primitive/field cx X)); they are
; read via (primitive/field cx X) for al-elem and (primitive/load (primitive/field cx X)) for al-len/al-get.
