; src/compiler/loader.coil — self-host Coil compiler, loader module.
(module loader)
(import "coil.primitive" :as primitive)

(import "coil.alloc" :as alloc :use *)
(import "coil.result" :use *)
(import "coil.slice" :use *)
(import "coil.str" :use *)
(import "coil.arraylist" :use *)
(import "coil.io" :use *)
(import "coil.control" :use *)
(import "coil.try" :use *)
(import "coil.match" :use *)
(import "ffi" :use *)
(import "embedded_stdlib" :use *)  ; embedded prelude + bundled libs -> runs outside the repo
(import "ast" :use *)
(import "parser" :use *)
(import "coil.reader" :use *)
(import "resolve" :use *)
(import "cimport" :as ci)  ; the (cimport "h.h") source form generates bindings at load time

(extern getpid :cc c [] (-> i32))

; Drain an open fd into `bytes` through a 64 KB bounce buffer, appending each read in
; one `al-extend!`. Shared by both readers below so the loop exists once.
(defn drain-fd! [(fd :i64) (buf (ptr i8)) (bytes (mut (ArrayList u8)))] (-> :i64)
  (loop (let [n (read (primitive/cast i32 fd) buf 65536)]
          (if (<= n (primitive/cast i64 0))
              (break)
              (al-extend! [u8] (mut bytes) (primitive/cast (ptr u8) buf) (primitive/cast i64 n)))))
  0)

(defn read-file [(a (ptr Allocator)) (path (ptr i8))] (-> (slice u8))
  (let [fd (open path 0)
        buf (unwrap-ptr [i8] (raw-alloc a 65536 1))
        (mut bytes) (al-new [u8] a)]
    (drain-fd! (primitive/cast :i64 fd) buf (mut bytes))
    (close fd)
    (al-slice [u8] (load bytes))))

; Like `read-file`, but distinguishes "could not open" (None) from an empty file
; (Some ""). `read-file` returns an empty slice for both, which is fine for the
; loader's disk-first / embedded-fallback probing but WRONG for `include-str`,
; where a missing file at compile time is a hard build error, not an empty embed.
(defn read-file-opt [(a (ptr Allocator)) (path (ptr i8))] (-> (Option (slice u8)))
  (let [fd (open path 0)]
    (if (< (primitive/cast i64 fd) (primitive/cast i64 0))
        (None [(slice u8)])
        (let [buf (unwrap-ptr [i8] (raw-alloc a 65536 1))
              (mut bytes) (al-new [u8] a)]
          (drain-fd! (primitive/cast :i64 fd) buf (mut bytes))
          (close fd)
          (Some (al-slice [u8] (load bytes)))))))

; A hand-built Program smoke test (no spans → byte-exact against `coil dump-ast`
; of the equivalent source). Validates the dumper before the parser is filled.
(defstruct TaggedForm [(form Sexp) (module (Option (slice u8)))])

(defstruct Alias [(alias (slice u8)) (target (slice u8))])
(defsum UseSpec
  (UAll [])
  (UNames [(names (ptr (ArrayList (slice u8))))]))
; `:rename [[from to] …]` — refer the target's exported `from` under the local name
; `to`. Renaming REPLACES: once `from` is renamed, the bare `from` stops being referred
; (Clojure's rule), so a rename is an exclude plus an alias in one entry.
(defstruct Rename [(from (slice u8)) (to (slice u8))])
(defstruct Use [(target (slice u8)) (spec UseSpec)
                (exclude (ptr (ArrayList (slice u8))))
                (renames (ptr (ArrayList Rename)))])

(defstruct ModImports
  [(aliases (ArrayList Alias))
   (uses (ArrayList Use))
   (reexports (ArrayList (slice u8)))
   ; The module's effective refer of `coil.core`. Every module refers all of core by
   ; default (Clojure's implicit `clojure.core`); writing ANY explicit
   ; `(import "coil.core" …)` REPLACES that default outright rather than adding to it,
   ; which is exactly how `:refer-clojure` behaves. Held as an ordinary `Use` so the one
   ; `use-refers` predicate below decides core exactly like every other import — core is
   ; the lowest-precedence tier, not a different mechanism.
   (core Use)
   (core_set bool)])

(defstruct ImpEntry [(name (slice u8)) (imp ModImports)])

; ---- the refer rules, in ONE place -----------------------------------------
(defn empty-names [(a (ptr Allocator))] (-> (ptr (ArrayList (slice u8))))
  (let [p (unwrap-ptr [(ArrayList (slice u8))] (create [(ArrayList (slice u8))] a))]
    (store! p (al-new [(slice u8)] a))
    p))
(defn empty-renames [(a (ptr Allocator))] (-> (ptr (ArrayList Rename)))
  (let [p (unwrap-ptr [(ArrayList Rename)] (create [(ArrayList Rename)] a))]
    (store! p (al-new [Rename] a))
    p))
; A null exclude/renames list means "none" — the parser only allocates when the
; keyword is actually present, so the common import costs nothing.
(defn mk-use [(a (ptr Allocator))
              (target (slice u8))
              (spec UseSpec)
              (exclude (ptr (ArrayList (slice u8))))
              (renames (ptr (ArrayList Rename)))] (-> Use)
  (let [u (alloc/stack Use)]
    (store! (field u target) target)
    (store! (field u spec) spec)
    (store! (field u exclude)
            (if (= (primitive/cast i64 exclude) (primitive/cast i64 0)) (empty-names a) exclude))
    (store! (field u renames)
            (if (= (primitive/cast i64 renames) (primitive/cast i64 0)) (empty-renames a) renames))
    (load u)))

;; Does this import refer NAME into the importing module, and if so, under which of the
;; target's own exported names? `(Some exported)` when referred — `exported` differs from
;; `name` only for a `:rename`. `(None)` when this import does not put `name` in scope.
;;
;; ONE predicate, four callers: the resolver (values/types/traits), the ambient primitive
;; aliases, the macro expander, and the checker's trait-method visibility. Every refer
;; rule lives here, so all four agree by construction — an `:exclude` that hid a name from
;; the resolver but left the trait method callable would be worse than no feature at all.
(defn use-refers [(u (ptr Use)) (name (slice u8))] (-> (Option (slice u8)))
  (let [rs (load (field u renames))
        n (al-len [Rename] (load rs))
        (mut i) 0
        (mut out) (None [(slice u8)])
        (mut done) false]
    ; A rename settles the question in BOTH directions: the new name is referred
    ; whatever the spec says, and the original name stops being referred.
    (loop (if (or (load done) (>= (load i) n))
              (break)
              (do
                (let [rp (al-elem [Rename] rs (load i))]
                  (if (str-eq (load (field rp to)) name)
                      (do (store! out (Some (load (field rp from)))) (store! done true) 0)
                      (when (str-eq (load (field rp from)) name) (store! done true) 0)))
                (store! i (primitive/iadd (load i) 1)))))
    (if (load done)
        (load out)
        (if (set-contains (load (field u exclude)) name)
            (None [(slice u8)])
            (match (load (field u spec))
              (UAll [] (Some name))
              (UNames [names] (if (set-contains names name) (Some name) (None [(slice u8)]))))))))

;; The inverse of `use-refers`: under which LOCAL name, if any, does this import bring
;; the target's exported NAME into scope? Needed wherever the walk starts from the
;; target's declarations instead of from a use site (the ambient primitive aliases).
(defn use-local-of [(u (ptr Use)) (exported (slice u8))] (-> (Option (slice u8)))
  (let [rs (load (field u renames))
        n (al-len [Rename] (load rs))
        (mut i) 0
        (mut out) (None [(slice u8)])
        (mut done) false]
    (loop (if (or (load done) (>= (load i) n))
              (break)
              (do
                (let [rp (al-elem [Rename] rs (load i))]
                  (when (str-eq (load (field rp from)) exported)
                        (store! out (Some (load (field rp to))))
                        (store! done true)
                        0))
                (store! i (primitive/iadd (load i) 1)))))
    (if (load done)
        (load out)
        (if (set-contains (load (field u exclude)) exported)
            (None [(slice u8)])
            (match (load (field u spec))
              (UAll [] (Some exported))
              (UNames [names] (if (set-contains names exported) (Some exported) (None [(slice u8)]))))))))

;; The module's refer of `coil.core`, via the same predicates. A module with no import
;; record at all (a comptime sub-program, a standalone file with no `(module …)`) refers
;; all of core — that is the default every module starts from.
(defn core-refers [(imp (ptr ImpEntry)) (name (slice u8))] (-> (Option (slice u8)))
  (if (= (primitive/cast i64 imp) (primitive/cast i64 0))
      (Some name)
      (use-refers (field (field imp imp) core) name)))
(defn core-local-of [(imp (ptr ImpEntry)) (exported (slice u8))] (-> (Option (slice u8)))
  (if (= (primitive/cast i64 imp) (primitive/cast i64 0))
      (Some exported)
      (use-local-of (field (field imp imp) core) exported)))

;; Did this import DELIBERATELY drop NAME — an `:exclude` entry, or a `:rename` that
;; moved it to a different local name? This is a stronger statement than "not referred":
;; a name merely absent from a `:use [names]` list was never claimed either way, which
;; matters for trait methods (a method whose trait is unique is callable today with no
;; import at all, so silence must not be read as refusal).
(defn use-drops? [(u (ptr Use)) (name (slice u8))] (-> bool)
  (if (set-contains (load (field u exclude)) name)
      true
      (let [rs (load (field u renames))
            n (al-len [Rename] (load rs))
            (mut i) 0
            (mut r) false]
        (loop (if (or (load r) (>= (load i) n))
                  (break)
                  (do
                    (when (str-eq (load (field (al-elem [Rename] rs (load i)) from)) name)
                          (store! r true)
                          0)
                    (store! i (primitive/iadd (load i) 1)))))
        (load r))))

;; Does this module have an explicit `(import "coil.core" …)`? An explicit core import
;; states core's refer set IN FULL, so it is authoritative in a way an ordinary import
;; is not.
(defn core-explicit? [(imp (ptr ImpEntry))] (-> bool)
  (if (= (primitive/cast i64 imp) (primitive/cast i64 0))
      false
      (load (field (field imp imp) core_set))))
(defn core-drops? [(imp (ptr ImpEntry)) (name (slice u8))] (-> bool)
  (if (= (primitive/cast i64 imp) (primitive/cast i64 0))
      false
      (use-drops? (field (field imp imp) core) name)))

;; The `:use` entry a module has for TARGET, or null when it has none.
(defn use-for-target [(imp (ptr ImpEntry)) (target (slice u8))] (-> (ptr Use))
  (if (= (primitive/cast i64 imp) (primitive/cast i64 0))
      (primitive/cast (ptr Use) 0)
      (let [uses (field (field imp imp) uses)
            n (al-len [Use] (load uses))
            (mut i) 0
            (mut r) (primitive/cast (ptr Use) 0)]
        (loop (if (or (>= (load i) n) (!= (primitive/cast i64 (load r)) (primitive/cast i64 0)))
                  (break)
                  (do
                    (let [up (al-elem [Use] uses (load i))]
                      (when (str-eq (load (field up target)) target) (store! r up) 0))
                    (store! i (primitive/iadd (load i) 1)))))
        (load r))))
(defstruct ExpEntry [(name (slice u8)) (names (ArrayList (slice u8)))])

; One registered source: a display name + full text.
(defstruct Source [(name (slice u8)) (text (slice u8))])
; A macro-expansion record: the macro name, its call site
; and def site (spans), and the enclosing expansion context (parent ctxt).
(defstruct Expansion
  [(macro_name (slice u8))
   (call_source i64)
   (call_lo i64)
   (call_hi i64)
   (call_ctxt i64)
   (def_source i64)
   (def_lo i64)
   (def_hi i64)
   (def_ctxt i64)
   (parent i64)])

(defstruct LS
  [(a (ptr Allocator))
   (out (ArrayList TaggedForm))
   (loaded (ArrayList (slice u8)))
   ; resolved-path -> declared module name, for files already read (see read-memo-find)
   (readpaths (ArrayList (slice u8)))
   (readmods (ArrayList (slice u8)))
   (imports (ArrayList ImpEntry))
   (exports (ArrayList ExpEntry))
   ; Source-visible compiler operations and aliases, collected from ordinary
   ; namespaced top-level declarations. Opcodes never participate in name lookup.
   (primitive_defs (ArrayList PrimitiveDef))
   (primitive_aliases (ArrayList PrimitiveAlias))
   (srccount i64)
   ; The SourceMap: sources[id] = the file at that id (main=0, prelude=1, imports
   ; 2..). expansions[ctxt-1] = the macro provenance for ctxt (>=1). Both grow in
   ; the exact order registers them, so ids/ctxts match the reference.
   (sources (ArrayList Source))
   (expansions (ArrayList Expansion))
   ; All type-check body errors (build path renders every one; the dump-checked
   ; oracle still reports [0]). A heap-boxed list so the checker can push through it.
   (check_diags (ptr (ArrayList Diag)))
   ; All RESOLVE body errors, same treatment: resolve collects per function and
   ; continues instead of aborting the pipeline on the first, so a batch of mistakes
   ; is reported in one pass (the checker already did this; resolve did not). The
   ; qualified names of functions whose BODY failed to resolve — the checker skips
   ; their bodies but keeps their SIGNATURES in the table, so callers don't cascade.
   (resolve_diags (ptr (ArrayList Diag)))
   (resolve_poisoned (ptr (ArrayList (slice u8))))
   ; The loader's first error, as a framed Diag.
   ; Threaded via a slot (not a Result return) so the loop-heavy loader
   ; keeps its i64 signatures; set once, then process-forms/-import bail early and
   ; run-pipeline reports it through the SAME render path as every other diagnostic.
   (loaderr Diag)
   (loaderr_set bool)
   ; Keep index-only state at the tail: staged compiler components share LS's
   ; established prefix layout across their native metaprogram boundary.
   (namespace_names (ArrayList (slice u8)))
   (namespace_paths (ArrayList (slice u8)))
   ; The entry file's declared module. `main` is the one function the resolver never
   ; renames, so its qualified name carries no module — and without this, anything that
   ; asks "which module is this code in?" (import-driven visibility, refer control) gets
   ; no answer inside `main` and silently falls back to "no restrictions".
   (entry_module (slice u8))])

(defstruct Resolved [(text (slice u8)) (incdir (slice u8)) (disp (slice u8))])

;; Initialize EVERY field of a fresh LS.
;;
;; LS is stack-allocated and used to be hand-initialized field by field at fifteen
;; separate call sites. That is how eight of them ended up never setting
;; `namespace_names`/`namespace_paths`: those two read uninitialized stack memory, and
;; the visible symptom was `coil expand` failing to resolve a project namespace that
;; `coil check` resolved fine, because the two commands initialize their LS in different
;; files. A twenty-field struct cannot be correctly initialized by hand in fifteen
;; places — it has to be one function, so that adding a field is one edit and cannot
;; leave a site half-built.
;;
;; Callers still override what is genuinely theirs afterwards (`srccount`, and the
;; sub-program builders that deliberately share a parent's boxed diagnostic lists).
(defn ls-init! [(s (mut LS)) (a (ptr Allocator))] (-> i64)
  (store! (field s a) a)
  (store! (field s out) (al-new [TaggedForm] a))
  (store! (field s loaded) (al-new [(slice u8)] a))
  (store! (field s readpaths) (al-new [(slice u8)] a))
  (store! (field s readmods) (al-new [(slice u8)] a))
  (store! (field s imports) (al-new [ImpEntry] a))
  (store! (field s exports) (al-new [ExpEntry] a))
  (store! (field s primitive_defs) (al-new [PrimitiveDef] a))
  (store! (field s primitive_aliases) (al-new [PrimitiveAlias] a))
  (store! (field s sources) (al-new [Source] a))
  (store! (field s expansions) (al-new [Expansion] a))
  (store! (field s namespace_names) (al-new [(slice u8)] a))
  (store! (field s namespace_paths) (al-new [(slice u8)] a))
  (store! (field s srccount) 0)
  (store! (field s check_diags) (box-al [Diag] a (al-new [Diag] a)))
  (store! (field s resolve_diags) (primitive/cast (ptr (ArrayList Diag)) 0))
  (store! (field s resolve_poisoned) (primitive/cast (ptr (ArrayList (slice u8))) 0))
  (store! (field s loaderr) (primitive/zeroed Diag))
  (store! (field s loaderr_set) false)
  (store! (field s entry_module) "")
  0)

; Register a source (name+text) into the SourceMap, in id order (sources[id]).
(defn register-source! [(s (mut LS)) (name (slice u8)) (text (slice u8))] (-> i64)
  (let [sp (alloc/stack Source)]
    (store! (field sp name) name)
    (store! (field sp text) text)
    (al-push! (mut (field s sources)) (load sp)))
  0)
; Register an expansion; return its ctxt id (1-based; 0 = root).
(defn add-expansion! [(s (mut LS)) (e Expansion)] (-> i64)
  (al-push! (mut (field s expansions)) e)
  (al-len [Expansion] (load (field s expansions))))

; ============================ loader helpers (copied) ======================
(defn mk-tagged [(form Sexp) (module (Option (slice u8)))] (-> TaggedForm)
  (let [p (alloc/stack TaggedForm)]
    (store! (field p form) form)
    (store! (field p module) module)
    (load p)))

(defn loader-abort [(msg (slice u8))] (-> i64)
  (let [w (stderr)] (ps w "loader error: ") (ps w msg) (wb w 10))
  (abort)
  0)

; A framed loader diagnostic anchored at `f`'s span.
(defn diag-at-form [(f (ptr Sexp)) (msg (slice u8))] (-> Diag)
  (let [d (alloc/stack Diag)]
    (store! (field d lo) (load (field f lo)))
    (store! (field d hi) (load (field f hi)))
    (store! (field d msg) msg)
    (store! (field d source) (load (field f source)))
    (store! (field d ctxt) (load (field f ctxt)))
    (load d)))
; Record the loader's first error and mark the run failed (idempotent: keep the first).
(defn ls-set-err! [(s (mut LS)) (d Diag)] (-> i64)
  (unless (load (field s loaderr_set))
    (store! (field s loaderr) d)
    (store! (field s loaderr_set) true)
    0))
(defn ls-err? [(s (mut LS))] (-> bool)
  (load (field s loaderr_set)))

(defn cstr-len [(p (ptr i8))] (-> i64)
  (let [(mut i) 0]
    (loop (if (= (primitive/cast i64 (load (primitive/index p (load i)))) (primitive/cast i64 0))
              (break)
              (store! i (primitive/iadd (load i) 1))))
    (load i)))
(defn cstr->slice [(p (ptr i8))] (-> (slice u8))
  (slice-new [u8] (primitive/cast (ptr u8) p) (cstr-len p)))

(defn cwd-slice [(a (ptr Allocator))] (-> (slice u8))
  (let [buf (unwrap-ptr [i8] (raw-alloc a 4096 1))
        r (getcwd buf 4096)]
    (if (= (primitive/cast i64 r) (primitive/cast i64 0))
        (do (loader-abort "getcwd failed") "")
        (cstr->slice buf))))

(defn path-join [(a (ptr Allocator)) (base (slice u8)) (path (slice u8))] (-> (slice u8))
  (if (and (> (slice-len path) (primitive/cast i64 0)) (= (primitive/cast i64 (slice-get path 0)) (primitive/cast i64 47)))
      path
      (let [m1 (match (str-concat a base "/") (Some [v] v) (None [] ""))]
        (match (str-concat a m1 path) (Some [v] v) (None [] "")))))

(defn dirname [(p (slice u8))] (-> (slice u8))
  (let [n (slice-len p)
        (mut idx) -1
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (when (= (primitive/cast i64 (slice-get p (load i))) (primitive/cast i64 47))
                  (store! idx (load i)))
                (store! i (primitive/iadd (load i) 1)))))
    (if (< (load idx) (primitive/cast i64 0)) "." (subslice p 0 (load idx)))))

(defn basename [(p (slice u8))] (-> (slice u8))
  (let [n (slice-len p)
        (mut idx) -1
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (when (= (primitive/cast i64 (slice-get p (load i))) (primitive/cast i64 47))
                  (store! idx (load i)))
                (store! i (primitive/iadd (load i) 1)))))
    (if (< (load idx) (primitive/cast i64 0)) p (subslice p (primitive/iadd (load idx) 1) n))))

; The embedded table IS the single manifest of bundled modules: a name is bundled
; iff we carry its text (embedded-lib returns "" for anything not bundled). This is
; the one source of truth — the old hand-maintained duplicate list is gone, and the
; snapshot corpus derives its lib set from `src/stdlib/*.coil` directly.
(defn bundled? [(name (slice u8))] (-> bool)
  (> (slice-len (embedded-lib name)) (primitive/cast i64 0)))

; The import base for bundled stdlib files and the prelude. It marks compiler-owned
; embedded text, keeping the bundle self-contained and enabling narrowly scoped
; bootstrap compatibility for older embedded filename imports.
(defn bundled-base [] (-> (slice u8))
  "<bundled>")

(defn path-readable? [(a (ptr Allocator)) (p (slice u8))] (-> bool)
  (let [fd (open (str->cstr a p) 0)]
    (if (< (primitive/cast i64 fd) (primitive/cast i64 0))
        false
        (do (close fd) true))))

; The explicit stdlib source root (`COIL_STDLIB_DIR`), or None. When set, the loader
; prefers live source files under it over the embedded copies — for developing the
; compiler (edit a lib, rebuild a program, no compiler rebuild). When UNSET the
; embedded copies are authoritative and NO disk path is consulted, so a portable
; binary can never be shadowed by a stray src/stdlib/*.coil in whatever directory it runs
; in. (The self-build stays correct either way: each stage's embedded copies equal
; the disk sources it was built from.)
;
; The value is a CHECKOUT ROOT — the directory holding src/stdlib and
; src/compiler — so `COIL_STDLIB_DIR=$PWD` from the repo root is the intended
; spelling. A root without src/stdlib is a hard error rather than a silent
; fallback to the embedded copies: an override that quietly does nothing turns
; every "I edited the lib and nothing changed" into a debugging session, and made
; the A/B measurement procedure in docs/reference/ALLOCATION.md a no-op.
(defn stdlib-dir [(a (ptr Allocator))] (-> (Option (slice u8)))
  (let [p (getenv (str->cstr a "COIL_STDLIB_DIR"))]
    (if (= (primitive/cast i64 p) (primitive/cast i64 0))
        (None [(slice u8)])
        (let [dir (cstr->slice p)
              libs (path-join a dir "src/stdlib")]
          (if (path-readable? a libs)
              (Some dir)
              (let [w (stderr)]
                (ps w "error: COIL_STDLIB_DIR is set to '")
                (ps w dir)
                (ps w "' but '")
                (ps w libs)
                (ps w "' does not exist\n")
                (ps w "note: it must name a checkout root (the directory containing src/stdlib),\n")
                (ps w "      not the stdlib directory itself; unset it to use the embedded copies\n")
                (exit 1)
                (None [(slice u8)])))))))

; Text of a bundled lib: the file under $COIL_STDLIB_DIR/src/stdlib if that
; override is set and the file exists, otherwise the embedded copy. A per-file
; miss still falls back (a root may predate a newly added lib); an unusable root
; is rejected up front by `stdlib-dir`.
(defn bundled-text [(a (ptr Allocator)) (bn (slice u8))] (-> (slice u8))
  (match (stdlib-dir a)
    (None [] (embedded-lib bn))
    (Some [dir]
          (let [lc (str->cstr a (path-join a (path-join a dir "src/stdlib") bn))
                d (read-file a lc)]
            (if (= (slice-len d) (primitive/cast i64 0)) (embedded-lib bn) d)))))

; A `coil.*` namespace that resolves from the source tree instead of the bundle is
; a manifest bug: it works in this repo and fails for every compiler run outside
; it. That asymmetry is precisely what hid coil.socket/sync/region/signals/
; cancellation, so the build and the gates set COIL_STRICT_BUNDLE=1 to make the
; fallback a hard error instead of an invisible success.
(defn strict-bundle? [(a (ptr Allocator))] (-> bool)
  (let [p (getenv (str->cstr a "COIL_STRICT_BUNDLE"))]
    (if (= (primitive/cast i64 p) (primitive/cast i64 0))
        false
        (not (str-eq (cstr->slice p) "0")))))

; Namespace imports deliberately do not encode storage layout. Build a source index
; once per compiler run by scanning the project roots, reading only enough of each
; .coil file to obtain its declared `(module …)` identity. COIL_NAMESPACE_ROOTS is
; a colon-separated list installed by project mode; direct-file mode indexes the
; process working directory, which makes the entry file's location irrelevant.
(defn namespace-index-add! [(s (mut LS)) (name (slice u8)) (path (slice u8))] (-> i64)
  (let [names (field s namespace_names)
        paths (field s namespace_paths)
        n (al-len [(slice u8)] (load names))
        (mut seen) false
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (when (and (str-eq (al-get [(slice u8)] (load names) (load i)) name)
                           (str-eq (al-get [(slice u8)] (load paths) (load i)) path))
                  (store! seen true)
                  (break))
                (store! i (primitive/iadd (load i) 1)))))
    (unless (load seen)
      (al-push! (mut (field s namespace_names)) name)
      (al-push! (mut (field s namespace_paths)) path)
      0))
  0)

; Read only the lexical module header. Namespace discovery must not invoke read-all:
; doing so after the entry file is parsed mutates reader-global node identities and
; can corrupt later staged-macro bookkeeping. Comments and blank lines may precede
; the declaration; imported files already require it to be the first real form.
(defn namespace-declared-module [(text (slice u8))] (-> (Option (slice u8)))
  (let [n (slice-len text)
        (mut i) 0
        (mut comment) false
        (mut out) (None [(slice u8)])]
    (loop (if (>= (load i) n)
              (break)
              (let [c (primitive/cast i64 (slice-get text (load i)))]
                (cond (= c (primitive/cast i64 10))
                        (do
                          (store! comment false)
                          (store! i (primitive/iadd (load i) 1))
                          0)
                      (load comment) (store! i (primitive/iadd (load i) 1))
                      (= c (primitive/cast i64 59))
                        (do
                          (store! comment true)
                          (store! i (primitive/iadd (load i) 1))
                          0)
                      (and (= c (primitive/cast i64 40)) (starts-with (subslice text (load i) n) "(module "))
                        (let [lo (primitive/iadd (load i) 8)
                              (mut hi) (primitive/iadd (load i) 8)]
                          (loop (if (>= (load hi) n)
                                    (break)
                                    (let [d (primitive/cast i64 (slice-get text (load hi)))]
                                      (if (or (= d (primitive/cast i64 41))
                                              (or (= d (primitive/cast i64 32))
                                                  (or (= d (primitive/cast i64 9))
                                                      (or (= d (primitive/cast i64 10)) (= d (primitive/cast i64 13))))))
                                          (break)
                                          (store! hi (primitive/iadd (load hi) 1))))))
                          (when (> (load hi) lo)
                            (store! out (Some (subslice text lo (load hi))))
                            0)
                          (break))
                      :else (store! i (primitive/iadd (load i) 1))))))
    (load out)))

(defn namespace-index-file! [(s (mut LS))
                             (path (slice u8))
                             (path-buf (ptr i8))] (-> i64)
  (let [a (load (field s a))
        rp (realpath (str->cstr a path) path-buf)]
    (unless (= (primitive/cast i64 rp) (primitive/cast i64 0))
      (let [canon (sconcat a (cstr->slice path-buf) "")
            text (read-file a path-buf)]
        ; A module declaration may follow an arbitrarily long license/design
        ; comment. Reading only the first 4 KiB silently omitted valid modules.
        (match (namespace-declared-module text)
          (Some [m] (namespace-index-add! (mut s) (sconcat a m "") canon))
          (None [] 0)))))
  0)

(defn namespace-index-list! [(s (mut LS)) (text (slice u8))] (-> i64)
  (let [a (load (field s a))
        path-buf (unwrap-ptr [i8] (raw-alloc a 4096 1))
        n (slice-len text)
        (mut lo) 0
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (when (= (primitive/cast i64 (slice-get text (load i))) (primitive/cast i64 10))
                  (when (> (load i) (load lo))
                    (namespace-index-file! (mut s)
                                           (subslice text (load lo) (load i))
                                           path-buf)
                    0)
                  (store! lo (primitive/iadd (load i) 1)))
                (store! i (primitive/iadd (load i) 1)))))
    (when (< (load lo) n)
      (namespace-index-file! (mut s) (subslice text (load lo) n) path-buf)
      0))
  0)

(defn namespace-find-args [(a (ptr Allocator)) (roots (slice u8))] (-> (slice u8))
  (let [(mut b) (sb-new a)
        (mut lo) 0
        (mut i) 0
        n (slice-len roots)]
    (loop (if (>= (load i) n)
              (break)
              (do
                (when (= (primitive/cast i64 (slice-get roots (load i))) (primitive/cast i64 58))
                  (when (> (load i) (load lo))
                    (sb-push-str! (mut b) "'")
                    (sb-push-str! (mut b) (subslice roots (load lo) (load i)))
                    (sb-push-str! (mut b) "' ")
                    0)
                  (store! lo (primitive/iadd (load i) 1)))
                (store! i (primitive/iadd (load i) 1)))))
    (when (< (load lo) n)
      (sb-push-str! (mut b) "'")
      (sb-push-str! (mut b) (subslice roots (load lo) n))
      (sb-push-str! (mut b) "'")
      0)
    (sb-str (load b))))

(defn namespace-index-build! [(s (mut LS))] (-> i64)
  (let [a (load (field s a))
        roots-p (getenv (str->cstr a "COIL_NAMESPACE_ROOTS"))
        entry-name (load (field (al-elem [Source] (field s sources) 0) name))
        configured (if (= (primitive/cast i64 roots-p) (primitive/cast i64 0)) (cwd-slice a) (cstr->slice roots-p))
        roots (sconcat3 a configured ":" (dirname entry-name))
        tmp (sconcat a "/tmp/coil-namespace-index-" (i64->str a (primitive/cast i64 (getpid))))
        ; Project manifest values already reject quotes/newlines. Direct mode uses
        ; getcwd; a quote is rare but must fail closed instead of becoming shell text.
        (mut safe) true
        (mut i) 0]
    (loop (if (>= (load i) (slice-len roots))
              (break)
              (if (or (= (primitive/cast i64 (slice-get roots (load i))) (primitive/cast i64 39))
                      (= (primitive/cast i64 (slice-get roots (load i))) (primitive/cast i64 10)))
                  (do (store! safe false) (break))
                  (store! i (primitive/iadd (load i) 1)))))
    (when (load safe)
      ; Hidden directories (.git, .coil build output, worktrees under .claude/)
      ; can hold full copies of the tree; indexing them declares every namespace
      ; twice. `.?*` rather than `.*` so a root of `.` itself is not pruned.
      (let [cmd
              (sconcat a
                       "find "
                       (sconcat3 a
                                 (namespace-find-args a roots)
                                 " -name '.?*' -prune -o -type f -name '*.coil' -print > '"
                                 (sconcat a tmp "'")))]
        (system (str->cstr a cmd))
        ; `find` may return nonzero when an optional default root (usually tests/)
        ; is absent; paths from every existing root are still valid index input.
        (namespace-index-list! (mut s) (read-file a (str->cstr a tmp)))
        0))
    0))

(defn namespace-path [(a (ptr Allocator)) (s (mut LS)) (form (ptr Sexp)) (name (slice u8))] (-> (Option (slice u8)))
  (let [names (field s namespace_names)
        paths (field s namespace_paths)
        n (al-len [(slice u8)] (load names))
        (mut found) ""
        (mut count) 0
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (when (str-eq (al-get [(slice u8)] (load names) (load i)) name)
                  (store! count (primitive/iadd (load count) 1))
                  (when (= (load count) (primitive/cast i64 1))
                    (store! found (al-get [(slice u8)] (load paths) (load i)))
                    0)
                  0)
                (store! i (primitive/iadd (load i) 1)))))
    (if (> (load count) (primitive/cast i64 1))
        (do
          (ls-set-err! (mut s)
                       (diag-at-form form
                                     (sconcat3 a
                                               "namespace '"
                                               (sconcat3 a
                                                         name
                                                         "' is declared by multiple source files (namespace identities must be unique)"
                                                         "")
                                               "")))
          (None [(slice u8)]))
        (if (= (load count) (primitive/cast i64 1)) (Some (load found)) (None [(slice u8)])))))

; Legacy dependency-path resolution is retained only for the syntax-preflight
; migration lint. Normal loading uses COIL_NAMESPACE_ROOTS and never calls this.
(defn dep-slash [(path (slice u8))] (-> i64)
  (let [n (slice-len path)
        (mut i) 0
        (mut found) -1]
    (loop (if (>= (load i) n)
              (break)
              (if (= (primitive/cast i64 (slice-get path (load i))) (primitive/cast i64 47))
                  (do (store! found (load i)) (break))
                  (store! i (primitive/iadd (load i) 1)))))
    (load found)))

(defn dep-path-contained? [(root (slice u8)) (path (slice u8))] (-> bool)
  (let [rn (slice-len root)
        pn (slice-len path)
        (mut i) 0
        (mut same) (>= pn rn)]
    (loop (if (or (not (load same)) (>= (load i) rn))
              (break)
              (if (= (slice-get root (load i)) (slice-get path (load i)))
                  (store! i (primitive/iadd (load i) 1))
                  (store! same false))))
    (and (load same)
         (or (= pn rn)
             (and (> pn rn)
                  (or (and (= rn (primitive/cast i64 1)) (= (primitive/cast i64 (slice-get root 0)) (primitive/cast i64 47)))
                      (= (primitive/cast i64 (slice-get path rn)) (primitive/cast i64 47))))))))

(defn resolve-dependency [(a (ptr Allocator)) (path (slice u8))] (-> (Option Resolved))
  (let [slash (dep-slash path)]
    (if (<= slash (primitive/cast i64 0))
        (None [Resolved])
        (let [name (subslice path 0 slash)
              rel (subslice path (primitive/iadd slash 1) (slice-len path))
              envname (sconcat a "COIL_DEP_" name)
              ep (getenv (str->cstr a envname))]
          (if (= (primitive/cast i64 ep) (primitive/cast i64 0))
              (None [Resolved])
              (let [root (cstr->slice ep)
                    candidate (path-join a root rel)
                    buf (unwrap-ptr [i8] (raw-alloc a 4096 1))
                    r (realpath (str->cstr a candidate) buf)]
                (if (= (primitive/cast i64 r) (primitive/cast i64 0))
                    (None [Resolved])
                    (let [canon (cstr->slice buf)]
                      (if (not (dep-path-contained? root canon))
                          (None [Resolved])
                          (let [rp (alloc/stack Resolved)]
                            (store! (field rp text) (read-file a buf))
                            (store! (field rp incdir) (dirname canon))
                            (store! (field rp disp) canon)
                            (Some (load rp))))))))))))

(defn resolve-source [(a (ptr Allocator)) (s (mut LS)) (form (ptr Sexp)) (base (slice u8)) (name (slice u8))] (-> Resolved)
  (let [nn (slice-len name)
        legacy
          (or (>= (dep-slash name) (primitive/cast i64 0))
              (and (>= nn (primitive/cast i64 5)) (str-eq (subslice name (primitive/isub nn 5) nn) ".coil")))
        mapped (embedded-file-for-namespace name)
        ; Transitional compatibility is confined to compiler-owned embedded text.
        ; User source never has the <bundled> base and therefore cannot import a
        ; filename, relative or otherwise.
        bn
          (if (and (= (slice-len mapped) (primitive/cast i64 0)) (and (str-eq base (bundled-base)) (bundled? name)))
              name
              mapped)]
    (if (and legacy (not (str-eq base (bundled-base))))
        (do
          (ls-set-err! (mut s)
                       (diag-at-form form
                                     "import paths are not supported; import the target's declared namespace (run `coil lint --fix` to migrate legacy imports)"))
          (primitive/zeroed Resolved))
        (if (> (slice-len bn) (primitive/cast i64 0))
            (let [rp (alloc/stack Resolved)]
              (store! (field rp text) (bundled-text a bn))
              (store! (field rp incdir) (bundled-base))
              (store! (field rp disp) (sconcat3 a "<bundled " bn ">"))
              (load rp))
            (match (namespace-path a (mut s) form name)
              (Some [path]
                    (if (and (strict-bundle? a) (starts-with name "coil."))
                        (do
                          (ls-set-err! (mut s)
                                       (diag-at-form form
                                                     (sconcat3 a
                                                               "namespace '"
                                                               name
                                                               "' is missing from the bundled stdlib manifest — it resolved only from the source tree, so a compiler run outside this repo could not import it; regenerate with scripts/compiler/gen-embedded-stdlib.py")))
                          (primitive/zeroed Resolved))
                        (let [buf (unwrap-ptr [i8] (raw-alloc a 4096 1))
                              r (realpath (str->cstr a path) buf)
                              rp (alloc/stack Resolved)]
                          (if (= (primitive/cast i64 r) (primitive/cast i64 0))
                              (do
                                (ls-set-err! (mut s)
                                             (diag-at-form form
                                                           (sconcat3 a
                                                                     "namespace '"
                                                                     name
                                                                     "' points to a source file that no longer exists")))
                                (primitive/zeroed Resolved))
                              (let [canon (cstr->slice buf)]
                                (store! (field rp text) (read-file a buf))
                                (store! (field rp incdir) (dirname canon))
                                (store! (field rp disp) canon)
                                (load rp))))))
              (None []
                    (do
                      (unless (ls-err? (mut s))
                        (ls-set-err! (mut s)
                                     (diag-at-form form
                                                   (sconcat3 a
                                                             "namespace '"
                                                             name
                                                             "' was not found in the project, its dependencies, or the bundled standard library")))
                        0)
                      (primitive/zeroed Resolved))))))))

(defn l-as-list [(f (ptr Sexp))] (-> (ptr (ArrayList Sexp)))
  (match (load (field f kind))
    (KList [items] items)
    (KInt [_] (do (loader-abort "expected a list") (box-items (malloc-allocator) (al-new [Sexp] (malloc-allocator)))))
    (KFloat [_] (do (loader-abort "expected a list") (box-items (malloc-allocator) (al-new [Sexp] (malloc-allocator)))))
    (KSym [_] (do (loader-abort "expected a list") (box-items (malloc-allocator) (al-new [Sexp] (malloc-allocator)))))
    (KKw [_] (do (loader-abort "expected a list") (box-items (malloc-allocator) (al-new [Sexp] (malloc-allocator)))))
    (KStr [_] (do (loader-abort "expected a list") (box-items (malloc-allocator) (al-new [Sexp] (malloc-allocator)))))
    (KCStr [_] (do (loader-abort "expected a list") (box-items (malloc-allocator) (al-new [Sexp] (malloc-allocator)))))
    (KVec [_] (do (loader-abort "expected a list") (box-items (malloc-allocator) (al-new [Sexp] (malloc-allocator)))))))

(defn l-sym-name [(f (ptr Sexp))] (-> (Option (slice u8)))
  (match (load (field f kind))
    (KSym [s] (Some s))
    (KInt [_] (None [(slice u8)]))
    (KFloat [_] (None [(slice u8)]))
    (KKw [_] (None [(slice u8)]))
    (KStr [_] (None [(slice u8)]))
    (KCStr [_] (None [(slice u8)]))
    (KList [_] (None [(slice u8)]))
    (KVec [_] (None [(slice u8)]))))

(defn l-list-head [(f (ptr Sexp))] (-> (Option (slice u8)))
  (match (load (field f kind))
    (KList [items]
           (if (> (al-len [Sexp] (load items)) (primitive/cast i64 0))
               (let [h (alloc/stack Sexp)] (store! h (al-get [Sexp] (load items) 0)) (l-sym-name h))
               (None [(slice u8)])))
    (KInt [_] (None [(slice u8)]))
    (KFloat [_] (None [(slice u8)]))
    (KSym [_] (None [(slice u8)]))
    (KKw [_] (None [(slice u8)]))
    (KStr [_] (None [(slice u8)]))
    (KCStr [_] (None [(slice u8)]))
    (KVec [_] (None [(slice u8)]))))

(defn l-as-str [(f (ptr Sexp))] (-> (Option (slice u8)))
  (match (load (field f kind))
    (KStr [s] (Some s))
    (KInt [_] (None [(slice u8)]))
    (KFloat [_] (None [(slice u8)]))
    (KSym [_] (None [(slice u8)]))
    (KKw [_] (None [(slice u8)]))
    (KCStr [_] (None [(slice u8)]))
    (KList [_] (None [(slice u8)]))
    (KVec [_] (None [(slice u8)]))))

(defn module-name [(f (ptr Sexp))] (-> (slice u8))
  (let [items (l-as-list f)
        n (al-len [Sexp] (load items))]
    (if (< n (primitive/cast i64 2))
        (do (loader-abort "module: expected a name") "")
        (let [it (alloc/stack Sexp)]
          (store! it (al-get [Sexp] (load items) 1))
          (match (l-sym-name it)
            (Some [x] x)
            (None [] (do (loader-abort "module: expected a name") "")))))))

(defn declared-module [(forms (ptr (ArrayList Sexp)))] (-> (Option (slice u8)))
  (let [n (al-len [Sexp] (load forms))
        (mut res) (None [(slice u8)])
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (let [f (alloc/stack Sexp)]
                  (store! f (al-get [Sexp] (load forms) (load i)))
                  (match (l-list-head f)
                    (Some [h] (when (str-eq h "module") (store! res (Some (module-name f))) (break)))
                    (None [] 0)))
                (store! i (primitive/iadd (load i) 1)))))
    (load res)))

(defn collect-syms [(a (ptr Allocator)) (items (ptr (ArrayList Sexp)))] (-> (ptr (ArrayList (slice u8))))
  (let [n (al-len [Sexp] (load items))
        (mut out) (al-new [(slice u8)] a)
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (let [it (alloc/stack Sexp)]
                  (store! it (al-get [Sexp] (load items) (load i)))
                  (match (l-sym-name it) (Some [nm] (al-push! (mut out) nm)) (None [] 0)))
                (store! i (primitive/iadd (load i) 1)))))
    (let [bp (unwrap-ptr [(ArrayList (slice u8))] (create [(ArrayList (slice u8))] a))]
      (store! bp (load out))
      bp)))

; `:rename [[from to] …]` — a vector of two-symbol vectors. Pairs rather than a map
; literal because the reader has no `{}` form.
(defn collect-renames [(a (ptr Allocator)) (items (ptr (ArrayList Sexp)))] (-> (ptr (ArrayList Rename)))
  (let [n (al-len [Sexp] (load items))
        (mut out) (al-new [Rename] a)
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (let [it (alloc/stack Sexp)]
                  (store! it (al-get [Sexp] (load items) (load i)))
                  (match-else (load (field it kind))
                    (KVec [pair]
                          (let [syms (collect-syms a pair)]
                            (if (!= (al-len [(slice u8)] (load syms)) (primitive/cast i64 2))
                                (loader-abort "import: :rename expects [[from to] …] — each entry is exactly two symbols")
                                (let [rp (alloc/stack Rename)]
                                  (store! (field rp from) (al-get [(slice u8)] (load syms) 0))
                                  (store! (field rp to) (al-get [(slice u8)] (load syms) 1))
                                  (al-push! (mut out) (load rp))))))
                    (_ (loader-abort "import: :rename expects [[from to] …] — each entry is a two-symbol vector"))))
                (store! i (primitive/iadd (load i) 1)))))
    (let [bp (unwrap-ptr [(ArrayList Rename)] (create [(ArrayList Rename)] a))]
      (store! bp (load out))
      bp)))

(defn imp-elem [(s (mut LS)) (i i64)] (-> (ptr ImpEntry))
  (let [hdr (alloc/stack (ArrayList ImpEntry))]
    (store! hdr (load (field s imports)))
    (primitive/index (load (field hdr data)) i)))
(defn exp-elem [(s (mut LS)) (i i64)] (-> (ptr ExpEntry))
  (let [hdr (alloc/stack (ArrayList ExpEntry))]
    (store! hdr (load (field s exports)))
    (primitive/index (load (field hdr data)) i)))

(defn imp-entry [(s (mut LS)) (name (slice u8))] (-> (ptr ImpEntry))
  (let [n (al-len [ImpEntry] (load (field s imports)))
        (mut idx) -1
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (when (str-eq (load (field (imp-elem (mut s) (load i)) name)) name)
                  (store! idx (load i))
                  (break))
                (store! i (primitive/iadd (load i) 1)))))
    (if (>= (load idx) (primitive/cast i64 0))
        (imp-elem (mut s) (load idx))
        (let [e (alloc/stack ImpEntry)
              a (load (field s a))]
          (store! (field e name) name)
          (store! (field (field e imp) aliases) (al-new [Alias] a))
          (store! (field (field e imp) uses) (al-new [Use] a))
          (store! (field (field e imp) reexports) (al-new [(slice u8)] a))
          ; the implicit `(import "coil.core" :use *)` every module starts with
          (store! (field (field e imp) core)
                  (mk-use a
                          "coil.core"
                          (UAll)
                          (primitive/cast (ptr (ArrayList (slice u8))) 0)
                          (primitive/cast (ptr (ArrayList Rename)) 0)))
          (store! (field (field e imp) core_set) false)
          (al-push! (mut (field s imports)) (load e))
          (imp-elem (mut s) n)))))

(defn exp-entry [(s (mut LS)) (name (slice u8))] (-> (ptr ExpEntry))
  (let [n (al-len [ExpEntry] (load (field s exports)))
        (mut idx) -1
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (when (str-eq (load (field (exp-elem (mut s) (load i)) name)) name)
                  (store! idx (load i))
                  (break))
                (store! i (primitive/iadd (load i) 1)))))
    (if (>= (load idx) (primitive/cast i64 0))
        (exp-elem (mut s) (load idx))
        (let [e (alloc/stack ExpEntry)
              a (load (field s a))]
          (store! (field e name) name)
          (store! (field e names) (al-new [(slice u8)] a))
          (al-push! (mut (field s exports)) (load e))
          (exp-elem (mut s) n)))))

(defn ee-add-name! [(e (ptr ExpEntry)) (name (slice u8))] (-> i64)
  (let [n (al-len [(slice u8)] (load (field e names)))
        (mut found) false
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (when (str-eq (al-get [(slice u8)] (load (field e names)) (load i)) name)
                  (store! found true)
                  (break))
                (store! i (primitive/iadd (load i) 1)))))
    (unless (load found) (al-push! (mut (field e names)) name))))

(defn mi-add-alias! [(e (ptr ImpEntry)) (alias (slice u8)) (target (slice u8))] (-> i64)
  (let [n (al-len [Alias] (load (field (field e imp) aliases)))
        (mut idx) -1
        (mut i) 0
        v
          (let [ap (alloc/stack Alias)]
            (store! (field ap alias) alias)
            (store! (field ap target) target)
            (load ap))]
    (loop (if (>= (load i) n)
              (break)
              (do
                (when (str-eq (let [ep (alloc/stack Alias)]
                                (store! ep
                                        (al-get [Alias]
                                                (load (field (field e imp) aliases))
                                                (load i)))
                                (load (field ep alias)))
                              alias)
                  (store! idx (load i))
                  (break))
                (store! i (primitive/iadd (load i) 1)))))
    (if (>= (load idx) (primitive/cast i64 0))
        (al-set! [Alias] (mut (field (field e imp) aliases)) (load idx) v)
        (al-push! (mut (field (field e imp) aliases)) v))))

(defn mi-add-use! [(a (ptr Allocator))
                   (e (ptr ImpEntry))
                   (target (slice u8))
                   (spec UseSpec)
                   (exclude (ptr (ArrayList (slice u8))))
                   (renames (ptr (ArrayList Rename)))] (-> i64)
  (al-push! (mut (field (field e imp) uses)) (mk-use a target spec exclude renames)))

; An explicit `(import "coil.core" …)` REPLACES the implicit refer-all rather than adding
; to it — Clojure's `:refer-clojure` rule. Recording it into the dedicated `core` slot
; (not into `uses`) is what keeps core the lowest-precedence tier: an explicitly `:use`d
; module still shadows core, exactly as before this existed.
(defn mi-set-core! [(a (ptr Allocator))
                    (e (ptr ImpEntry))
                    (spec UseSpec)
                    (exclude (ptr (ArrayList (slice u8))))
                    (renames (ptr (ArrayList Rename)))] (-> i64)
  (store! (field (field e imp) core) (mk-use a "coil.core" spec exclude renames))
  (store! (field (field e imp) core_set) true)
  0)

(defn mi-add-reexport! [(e (ptr ImpEntry)) (target (slice u8))] (-> i64)
  (al-push! (mut (field (field e imp) reexports)) target))

(defn loaded-insert! [(s (mut LS)) (name (slice u8))] (-> bool)
  (let [n (al-len [(slice u8)] (load (field s loaded)))
        (mut found) false
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (when (str-eq (al-get [(slice u8)] (load (field s loaded)) (load i)) name)
                  (store! found true)
                  (break))
                (store! i (primitive/iadd (load i) 1)))))
    (if (load found) false (do (al-push! (mut (field s loaded)) name) true))))

; A module imported by K modules was READ FROM DISK and fully RE-PARSED K times. The
; already-loaded test above keys on the module NAME, which is only known after parsing,
; so it could skip the recursive descent but never the work of reaching it. On this
; compiler that is 540 imports across 65 files: eight times the file I/O and lexing, and
; 540 entries in the source table where 65 would do.
;
; Keyed on the RESOLVED PATH — which `resolve-source` produces before anything is read —
; each file is read and parsed exactly once. The per-import bookkeeping (alias, :use
; spec, :reexport) still runs for EVERY import; only the reading is shared, so what any
; one importer sees is unchanged.
(defn read-memo-find [(s (mut LS)) (p (slice u8))] (-> (Option (slice u8)))
  (let [n (al-len [(slice u8)] (load (field s readpaths)))
        (mut i) 0
        (mut r) (None [(slice u8)])]
    (loop (if (>= (load i) n)
              (break)
              (do
                (when (str-eq (al-get [(slice u8)] (load (field s readpaths)) (load i)) p)
                  (store! r
                          (Some (al-get [(slice u8)]
                                        (load (field s readmods))
                                        (load i))))
                  (break))
                (store! i (primitive/iadd (load i) 1)))))
    (load r)))

(defn read-memo-add! [(s (mut LS)) (p (slice u8)) (m (slice u8))] (-> i64)
  (al-push! (mut (field s readpaths)) p)
  (al-push! (mut (field s readmods)) m)
  0)

; The bookkeeping an import performs on its IMPORTER, which is per-import and therefore
; runs whether or not the file itself had to be read.
(defn import-record! [(s (mut LS))
                      (cur (Option (slice u8)))
                      (alias (Option (slice u8)))
                      (use-spec (Option UseSpec))
                      (reexport bool)
                      (exclude (ptr (ArrayList (slice u8))))
                      (renames (ptr (ArrayList Rename)))
                      (modname (slice u8))] (-> i64)
  (let [a (load (field s a))
        importer (match cur (Some [m] m) (None [] ""))
        imp (imp-entry (mut s) importer)
        alias-name (match alias (Some [al] al) (None [] modname))]
    (mi-add-alias! imp alias-name modname)
    ; `coil.core` is already referred implicitly, so an explicit import of it REPLACES
    ; that default instead of stacking a second, competing entry. Omitting `:use`
    ; entirely (`(import "coil.core" :as core)`) is Clojure's qualified-only require:
    ; it refers nothing, leaving only the alias.
    (if (str-eq modname "coil.core")
        (mi-set-core! a
                      imp
                      (match use-spec (Some [spec] spec) (None [] (UNames (empty-names a))))
                      exclude
                      renames)
        (match use-spec
          (Some [spec] (mi-add-use! a imp modname spec exclude renames))
          (None [] 0)))
    (when reexport (mi-add-reexport! imp modname))
    0))

(defn handle-export [(s (mut LS)) (f (ptr Sexp)) (cur (Option (slice u8)))] (-> i64)
  (match cur
    (Some [m]
          (let [items (l-as-list f)
                n (al-len [Sexp] (load items))
                ep (exp-entry (mut s) m)
                (mut i) 1]
            (loop (if (>= (load i) n)
                      (break)
                      (do
                        (let [it (alloc/stack Sexp)]
                          (store! it (al-get [Sexp] (load items) (load i)))
                          (match (l-sym-name it)
                            (Some [nm] (ee-add-name! ep nm))
                            (None [] (do (loader-abort "export: names must be symbols") 0))))
                        (store! i (primitive/iadd (load i) 1)))))
            0))
    (None [] (do (loader-abort "export: only valid inside a (module …)") 0))))

(defn process-import [(s (mut LS)) (form (ptr Sexp)) (base (slice u8)) (cur (Option (slice u8)))] (-> i64)
  (let [a (load (field s a))
        items (l-as-list form)
        nit (al-len [Sexp] (load items))
        path
          (if (< nit (primitive/cast i64 2))
              (do (loader-abort "import: expected (import \"path\" [:as alias])") "")
              (let [it (alloc/stack Sexp)]
                (store! it (al-get [Sexp] (load items) 1))
                (match (l-as-str it)
                  (Some [p] p)
                  (None [] (do (loader-abort "import: expected (import \"path\" [:as alias])") "")))))
        (mut alias) (None [(slice u8)])
        (mut use-spec) (None [UseSpec])
        (mut reexport) false
        (mut exclude) (primitive/cast (ptr (ArrayList (slice u8))) 0)
        (mut renames) (primitive/cast (ptr (ArrayList Rename)) 0)
        (mut i) 2]
    (loop (if (>= (load i) nit)
              (break)
              (let [it (alloc/stack Sexp)]
                (store! it (al-get [Sexp] (load items) (load i)))
                (match (load (field it kind))
                  (KKw [k]
                       (cond (str-eq k "as")
                               (let [a2 (alloc/stack Sexp)]
                                 (store! a2
                                         (al-get [Sexp]
                                                 (load items)
                                                 (primitive/iadd (load i) 1)))
                                 (match (l-sym-name a2)
                                   (Some [al]
                                         (do
                                           (store! alias (Some al))
                                           (store! i (primitive/iadd (load i) 2))))
                                   (None []
                                         (do
                                           (loader-abort "import: :as expects an alias symbol")
                                           (store! i (primitive/iadd (load i) 2))))))
                             (str-eq k "reexport")
                               (do
                                 (store! reexport true)
                                 (store! i (primitive/iadd (load i) 1)))
                             (str-eq k "exclude")
                               (let [v2 (alloc/stack Sexp)]
                                 (store! v2
                                         (al-get [Sexp]
                                                 (load items)
                                                 (primitive/iadd (load i) 1)))
                                 (match-else (load (field v2 kind))
                                   (KVec [vit] (store! exclude (collect-syms a vit)))
                                   (_ (loader-abort "import: :exclude expects [names]")))
                                 (store! i (primitive/iadd (load i) 2)))
                             (str-eq k "rename")
                               (let [v2 (alloc/stack Sexp)]
                                 (store! v2
                                         (al-get [Sexp]
                                                 (load items)
                                                 (primitive/iadd (load i) 1)))
                                 (match-else (load (field v2 kind))
                                   (KVec [vit] (store! renames (collect-renames a vit)))
                                   (_ (loader-abort "import: :rename expects [[from to] …]")))
                                 (store! i (primitive/iadd (load i) 2)))
                             (str-eq k "use")
                               (let [v2 (alloc/stack Sexp)]
                                 (store! v2
                                         (al-get [Sexp]
                                                 (load items)
                                                 (primitive/iadd (load i) 1)))
                                 (match (load (field v2 kind))
                                   (KSym [sm]
                                         (if (str-eq sm "*")
                                             (do
                                               (store! use-spec (Some (UAll)))
                                               (store! i (primitive/iadd (load i) 2)))
                                             (do
                                               (loader-abort "import: :use expects * or [names]")
                                               (store! i (primitive/iadd (load i) 2)))))
                                   (KVec [vit]
                                         (do
                                           (store! use-spec (Some (UNames (collect-syms a vit))))
                                           (store! i (primitive/iadd (load i) 2))))
                                   (KInt [_]
                                         (do
                                           (loader-abort "import: :use expects * or [names]")
                                           (store! i (primitive/iadd (load i) 2))))
                                   (KFloat [_]
                                           (do
                                             (loader-abort "import: :use expects * or [names]")
                                             (store! i (primitive/iadd (load i) 2))))
                                   (KKw [_]
                                        (do
                                          (loader-abort "import: :use expects * or [names]")
                                          (store! i (primitive/iadd (load i) 2))))
                                   (KStr [_]
                                         (do
                                           (loader-abort "import: :use expects * or [names]")
                                           (store! i (primitive/iadd (load i) 2))))
                                   (KCStr [_]
                                          (do
                                            (loader-abort "import: :use expects * or [names]")
                                            (store! i (primitive/iadd (load i) 2))))
                                   (KList [_]
                                          (do
                                            (loader-abort "import: :use expects * or [names]")
                                            (store! i (primitive/iadd (load i) 2))))))
                             :else
                               (do
                                 (loader-abort "import: expected :as alias, :use *|[names], :exclude [names], :rename [[from to] …], or :reexport")
                                 (store! i (primitive/iadd (load i) 1)))))
                  (KInt [_]
                        (do
                          (loader-abort "import: expected :as alias, :use *|[names], :exclude [names], :rename [[from to] …], or :reexport")
                          (store! i (primitive/iadd (load i) 1))))
                  (KFloat [_]
                          (do
                            (loader-abort "import: expected :as alias, :use *|[names], :exclude [names], :rename [[from to] …], or :reexport")
                            (store! i (primitive/iadd (load i) 1))))
                  (KSym [_]
                        (do
                          (loader-abort "import: expected :as alias, :use *|[names], :exclude [names], :rename [[from to] …], or :reexport")
                          (store! i (primitive/iadd (load i) 1))))
                  (KStr [_]
                        (do
                          (loader-abort "import: expected :as alias, :use *|[names], :exclude [names], :rename [[from to] …], or :reexport")
                          (store! i (primitive/iadd (load i) 1))))
                  (KCStr [_]
                         (do
                           (loader-abort "import: expected :as alias, :use *|[names], :exclude [names], :rename [[from to] …], or :reexport")
                           (store! i (primitive/iadd (load i) 1))))
                  (KList [_]
                         (do
                           (loader-abort "import: expected :as alias, :use *|[names], :exclude [names], :rename [[from to] …], or :reexport")
                           (store! i (primitive/iadd (load i) 1))))
                  (KVec [_]
                        (do
                          (loader-abort "import: expected :as alias, :use *|[names], :exclude [names], :rename [[from to] …], or :reexport")
                          (store! i (primitive/iadd (load i) 1))))))))
    ; `:exclude` subtracts from `:use *`. Pairing it with `:use [names]` — already a
    ; whitelist — means the author expects one of the two to be doing something it isn't,
    ; so say so rather than silently honoring the narrower one.
    (when (and (!= (primitive/cast i64 (load exclude)) (primitive/cast i64 0))
               (match (load use-spec) (Some [sp] (match sp (UAll [] false) (UNames [_] true))) (None [] false)))
      (ls-set-err! (mut s)
                   (diag-at-form form
                                 ":exclude subtracts from `:use *`, but this import already lists the names it refers with `:use [names]` — drop one of them"))
      0)
    ; `coil.core` is the prelude: already loaded, and it has no file under any source
    ; root to resolve. An explicit import of it is pure bookkeeping — it overrides the
    ; module's implicit refer-all and nothing more.
    (if (str-eq path "coil.core")
        (import-record! (mut s)
                        cur
                        (load alias)
                        (load use-spec)
                        (load reexport)
                        (load exclude)
                        (load renames)
                        "coil.core")
    (let [rr (resolve-source a (mut s) form base path)
          rp (alloc/stack Resolved)]
      (store! rp rr)
      (unless (ls-err? (mut s))
        (match (read-memo-find (mut s) (load (field rp disp)))
          ; already read for another importer — only this importer's record is new
          (Some [modname]
                (import-record! (mut s)
                                cur
                                (load alias)
                                (load use-spec)
                                (load reexport)
                                (load exclude)
                                (load renames)
                                modname))
          (None []
                (let [text (load (field rp text))
                      incdir (load (field rp incdir))
                      inc-id (load (field s srccount))
                      _ignore (store! (field s srccount) (primitive/iadd inc-id 1))
                      _reg (register-source! (mut s) (load (field rp disp)) text)]
                  (match (read-all a text inc-id)
                    ; `d` is already anchored in the imported file (read-all stamped inc-id),
                    ; so hand it to the driver verbatim — it points at the unclosed form. A
                    ; generic abort here would drop the one span that locates the mistake.
                    (Err [d] (do (ls-set-err! (mut s) d) 0))
                    (Ok [inc-forms]
                        (let [modname
                                (match (declared-module inc-forms)
                                  (Some [m] m)
                                  ; the one fact the user needs is WHICH file, and it was the one
                                  ; fact omitted — while the process killed itself with SIGABRT, so
                                  ; build tools saw a crashed compiler rather than a failed compile.
                                  ; `rp disp` is the imported file's path and `form` is the import
                                  ; that pulled it in: the same pair behind the excellent
                                  ; "import 'X': not found" error a few hundred lines up.
                                  (None []
                                        (do
                                          (ls-set-err! (mut s)
                                                       (diag-at-form form
                                                                     (sconcat3 a
                                                                               "import '"
                                                                               (load (field rp disp))
                                                                               "': file has no (module …) declaration — add (module <name>) as its first form")))
                                          "")))
                              _memo (read-memo-add! (mut s) (load (field rp disp)) modname)]
                          (import-record! (mut s)
                                          cur
                                          (load alias)
                                          (load use-spec)
                                          (load reexport)
                                          (load exclude)
                                          (load renames)
                                          modname)
                          (when (loaded-insert! (mut s) modname)
                            (process-forms (mut s) inc-forms incdir (None [(slice u8)])))
                          0)))))))))))

; Join the string elements of a `:flags ["-I…" "-D…"]` option into one clang
; flags string (each space-prefixed), or "" if absent. Forwarded to clang so
; headers that need include paths / feature defines can be parsed correctly.
(defn cimport-kwstr [(a (ptr Allocator)) (items (ptr (ArrayList Sexp))) (nit i64) (kw (slice u8))] (-> (slice u8))
  (let [(mut out) (sb-new a)
        (mut j) 2]
    (loop (if (>= (load j) nit)
              (break)
              (let [kwt (alloc/stack Sexp)]
                (store! kwt (al-get [Sexp] (load items) (load j)))
                (match-else (load (field kwt kind))
                            (KKw [k]
                                 (if (and (str-eq k kw) (< (primitive/iadd (load j) 1) nit))
                                     (do
                                       (let [vec (alloc/stack Sexp)]
                                         (store! vec
                                                 (al-get [Sexp]
                                                         (load items)
                                                         (primitive/iadd (load j) 1)))
                                         (match-else (load (field vec kind))
                                                     (KVec [vit]
                                                           (let [(mut vi) 0
                                                                 vn (al-len [Sexp] (load vit))]
                                                             (loop (if (>= (load vi) vn)
                                                                       (break)
                                                                       (do
                                                                         (let [el (alloc/stack Sexp)]
                                                                           (store! el
                                                                                   (al-get [Sexp]
                                                                                           (load vit)
                                                                                           (load vi)))
                                                                           (match (l-as-str el)
                                                                             (Some [fs]
                                                                                   (do
                                                                                     (sb-push-str! (mut out) " ")
                                                                                     (sb-push-str! (mut out) fs)
                                                                                     0))
                                                                             (None [] 0)))
                                                                         (store! vi
                                                                                 (primitive/iadd (load vi)
                                                                                                 1)))))))
                                                     (_ 0)))
                                       (store! j (primitive/iadd (load j) 2)))
                                     (store! j (primitive/iadd (load j) 1))))
                            (_ (store! j (primitive/iadd (load j) 1)))))))
    (sb-str (load out))))

; parse one `:probe` entry: `(name "C-expr")` (tier 0) or `(name :bits "struct X" "f")`
; (tier 1) → push a Probe. Malformed entries are ignored.
(defn parse-probe-entry [(a (ptr Allocator)) (plist (ptr (ArrayList ci/Probe))) (entry (ptr Sexp))] (-> i64)
  (let [it (l-as-list entry)
        n (al-len [Sexp] (load it))]
    (unless (< n (primitive/cast i64 2))
      (let [e0 (alloc/stack Sexp)]
        (store! e0 (al-get [Sexp] (load it) 0))
        (match (l-sym-name e0)
          (None [] 0)
          (Some [name]
                (let [e1 (alloc/stack Sexp)]
                  (store! e1 (al-get [Sexp] (load it) 1))
                  (match-else (load (field e1 kind))
                              (KStr [ex] (ci/probe-push! a plist name 0 ex "" ""))
                              (KCStr [ex] (ci/probe-push! a plist name 0 ex "" ""))
                              (KKw [k]
                                   (when (and (str-eq k "bits") (>= n (primitive/cast i64 4)))
                                     (let [e2 (alloc/stack Sexp)
                                           e3 (alloc/stack Sexp)]
                                       (store! e2 (al-get [Sexp] (load it) 2))
                                       (store! e3 (al-get [Sexp] (load it) 3))
                                       (match (l-as-str e2)
                                         (None [] 0)
                                         (Some [sn]
                                               (match (l-as-str e3)
                                                 (None [] 0)
                                                 (Some [fnm] (ci/probe-push! a plist name 1 "" sn fnm))))))))
                              (_ 0)))))))))

; is a bare keyword `:kw` present anywhere in the form's tail?
(defn has-kw? [(items (ptr (ArrayList Sexp))) (nit i64) (kw (slice u8))] (-> bool)
  (let [(mut j) 2
        (mut r) false]
    (loop (if (or (>= (load j) nit) (load r))
              (break)
              (do
                (let [k (alloc/stack Sexp)]
                  (store! k (al-get [Sexp] (load items) (load j)))
                  (match-else (load (field k kind))
                              (KKw [n] (when (str-eq n kw) (store! r true) 0))
                              (_ 0)))
                (store! j (primitive/iadd (load j) 1)))))
    (load r)))

; Collect bare symbols from a `:use [name …]` option. A present empty vector means
; import nothing; absence means the historical import-everything behavior.
(defn cimport-use-names [(a (ptr Allocator))
                         (items (ptr (ArrayList Sexp)))
                         (nit i64)] (-> (ptr (ArrayList (slice u8))))
  (let [names (box a (ArrayList (slice u8)) (al-new [(slice u8)] a))
        (mut j) 2]
    (loop (if (>= (load j) nit)
              (break)
              (let [kwt (alloc/stack Sexp)]
                (store! kwt (al-get [Sexp] (load items) (load j)))
                (match-else (load (field kwt kind))
                            (KKw [k]
                                 (if (and (str-eq k "use") (< (primitive/iadd (load j) 1) nit))
                                     (do
                                       (let [vec (alloc/stack Sexp)]
                                         (store! vec (al-get [Sexp] (load items) (primitive/iadd (load j) 1)))
                                         (match-else (load (field vec kind))
                                                     (KVec [vit]
                                                           (let [(mut vi) 0
                                                                 vn (al-len [Sexp] (load vit))]
                                                             (loop (if (>= (load vi) vn)
                                                                       (break)
                                                                       (let [el (alloc/stack Sexp)]
                                                                         (store! el (al-get [Sexp] (load vit) (load vi)))
                                                                         (match (l-sym-name el)
                                                                           (Some [name] (al-push! [(slice u8)] names name))
                                                                           (None [] 0))
                                                                         (store! vi (primitive/iadd (load vi) 1)))))))
                                                     (_ 0)))
                                       (store! j (primitive/iadd (load j) 2)))
                                     (store! j (primitive/iadd (load j) 1))))
                            (_ (store! j (primitive/iadd (load j) 1)))))))
    names))

; collect the `:probe [ … ]` entries into a Probe list.
(defn cimport-probes [(a (ptr Allocator)) (items (ptr (ArrayList Sexp))) (nit i64)] (-> (ptr (ArrayList ci/Probe)))
  (let [plist (ci/probe-list-new a)
        (mut j) 2]
    (loop (if (>= (load j) nit)
              (break)
              (let [kwt (alloc/stack Sexp)]
                (store! kwt (al-get [Sexp] (load items) (load j)))
                (match-else (load (field kwt kind))
                            (KKw [k]
                                 (if (and (str-eq k "probe")
                                          (< (primitive/iadd (load j) 1) nit))
                                     (do
                                       (let [vec (alloc/stack Sexp)]
                                         (store! vec
                                                 (al-get [Sexp]
                                                         (load items)
                                                         (primitive/iadd (load j) 1)))
                                         (match-else (load (field vec kind))
                                                     (KVec [vit]
                                                           (let [(mut vi) 0
                                                                 vn (al-len [Sexp] (load vit))]
                                                             (loop (if (>= (load vi) vn)
                                                                       (break)
                                                                       (do
                                                                         (let [el (alloc/stack Sexp)]
                                                                           (store! el
                                                                                   (al-get [Sexp]
                                                                                           (load vit)
                                                                                           (load vi)))
                                                                           (parse-probe-entry a plist el))
                                                                         (store! vi
                                                                                 (primitive/iadd (load vi)
                                                                                                 1)))))))
                                                     (_ 0)))
                                       (store! j (primitive/iadd (load j) 2)))
                                     (store! j (primitive/iadd (load j) 1))))
                            (_ (store! j (primitive/iadd (load j) 1)))))))
    plist))

; `(cimport "header.h" [:flags […]] [:probe […]] [:link […]])` — generate C bindings
; via clang AT LOAD TIME and splice the externs/defstructs/consts + probe consts
; into the CURRENT module (dropping the generated `(module cbindings)` header).
(defn process-cimport [(s (mut LS)) (form (ptr Sexp)) (cur (Option (slice u8)))] (-> i64)
  (let [a (load (field s a))
        items (l-as-list form)
        nit (al-len [Sexp] (load items))]
    (if (< nit (primitive/cast i64 2))
        (ls-set-err! (mut s) (diag-at-form form "cimport: expected (cimport \"header.h\")"))
        (let [it (alloc/stack Sexp)]
          (store! it (al-get [Sexp] (load items) 1))
          (match (l-as-str it)
            (None [] (ls-set-err! (mut s) (diag-at-form form "cimport: expected a string header path")))
            (Some [path]
                  (let [flags (cimport-kwstr a items nit "flags")
                        use-present (has-kw? items nit "use")
                        use-names (cimport-use-names a items nit)
                        probe-out
                          (ci/cimport-probe a
                                            path
                                            flags
                                            (cimport-probes a items nit)
                                            (cimport-kwstr a items nit "link"))
                        ; :probe-only skips the whole header dump (structs/externs/#defines)
                        ; and emits ONLY the probe consts — the ABI-extraction workflow.
                        rtext
                          (if (has-kw? items nit "probe-only")
                              (Ok [(slice u8) (slice u8)] (sconcat a "(module cbindings)\n" probe-out))
                              (match (ci/cimport-header-use a path flags use-names use-present)
                                (Err [e] (Err [(slice u8) (slice u8)] e))
                                (Ok [hdr] (Ok [(slice u8) (slice u8)] (sconcat a hdr probe-out)))))]
                    (match rtext
                      (Err [e] (ls-set-err! (mut s) (diag-at-form form e)))
                      (Ok [text]
                          (let [sid (load (field s srccount))
                                _1 (store! (field s srccount) (primitive/iadd sid 1))
                                _2 (register-source! (mut s) (sconcat a "<cimport " path) text)]
                            (match (read-all a text sid)
                              (Err [d]
                                   (ls-set-err! (mut s)
                                                (diag-at-form form "cimport: generated bindings failed to parse")))
                              (Ok [gforms]
                                  (let [(mut k) 0
                                        gn (al-len [Sexp] (load gforms))]
                                    (loop (if (>= (load k) gn)
                                              (break)
                                              (do
                                                (let [gf (alloc/stack Sexp)]
                                                  (store! gf
                                                          (al-get [Sexp]
                                                                  (load gforms)
                                                                  (load k)))
                                                  (match (l-list-head gf)
                                                    (Some [gh]
                                                          (unless (str-eq gh "module")
                                                            (al-push! (mut (field s out))
                                                                      (mk-tagged (load gf) cur))))
                                                    (None []
                                                          (al-push! (mut (field s out))
                                                                    (mk-tagged (load gf) cur)))))
                                                (store! k (primitive/iadd (load k) 1)))))
                                    0)))))))))))))

; ── include-str: compile-time file embed, resolved at LOAD time ───────────────
; Each file's forms are walked as it is loaded (EVERY file, always — no dependence
; on the macro-expansion pass), and each `(include-str "rel")` is replaced by a
; string literal of the file's bytes. `rel` resolves relative to the INCLUDING
; file's own directory. A missing file or a
; non-literal path is a hard load error — never a silent empty embed.
(defn incl-is-include-str [(items (ptr (ArrayList Sexp)))] (-> bool)
  (and (>= (sx-len items) (primitive/cast i64 1))
       (and (= (sx-tag (sx-at items 0)) (primitive/cast i64 2))
            (str-eq (sx-sval (sx-at items 0)) "include-str"))))
(defn incl-read [(a (ptr Allocator)) (dir (slice u8)) (rel (slice u8))] (-> (Option (slice u8)))
  (read-file-opt a (str->cstr a (path-join a dir rel))))
(defn do-include-str [(s (mut LS)) (f (ptr Sexp)) (dir (slice u8))] (-> Sexp)
  (let [a (load (field s a))
        items (sx-items (load f))]
    (if (!= (sx-len items) (primitive/cast i64 2))
        (do
          (ls-set-err! (mut s) (diag-at-form f "include-str: expects exactly one string-literal path argument"))
          (load f))
        (let [arg (sx-at items 1)]
          (if (!= (sx-tag arg) (primitive/cast i64 4))
              (do
                (ls-set-err! (mut s) (diag-at-form f "include-str: path must be a string literal"))
                (load f))
              (let [rel (sx-sval arg)]
                (match (incl-read a dir rel)
                  (Some [text] (mk-sexp-src (KStr text) f))
                  (None []
                        (do
                          (ls-set-err! (mut s)
                                       (diag-at-form f
                                                     (sconcat3 a
                                                               "include-str: cannot read file '"
                                                               rel
                                                               "' (relative to the including file)")))
                          (load f))))))))))
(defn form-has-include-str [(f (ptr Sexp))] (-> bool)
  (let [tg (sx-tag (load f))]
    (if (and (= tg (primitive/cast i64 6)) (incl-is-include-str (sx-items (load f))))
        true
        (if (or (= tg (primitive/cast i64 6)) (= tg (primitive/cast i64 7)))
            (let [items (sx-items (load f))
                  n (sx-len items)
                  (mut i) 0
                  (mut r) false]
              (loop (if (or (load r) (>= (load i) n))
                        (break)
                        (do
                          (when (form-has-include-str (al-elem [Sexp] items (load i)))
                            (store! r true)
                            0)
                          (store! i (primitive/iadd (load i) 1)))))
              (load r))
            false))))
(defn expand-includes-in-form [(s (mut LS)) (f (ptr Sexp)) (dir (slice u8))] (-> Sexp)
  (let [a (load (field s a))
        tg (sx-tag (load f))]
    (if (and (= tg (primitive/cast i64 6)) (incl-is-include-str (sx-items (load f))))
        (do-include-str (mut s) f dir)
        (if (or (= tg (primitive/cast i64 6)) (= tg (primitive/cast i64 7)))
            (let [items (sx-items (load f))
                  n (sx-len items)
                  (mut out) (al-new [Sexp] a)
                  (mut i) 0]
              (loop (if (>= (load i) n)
                        (break)
                        (do
                          (al-push! (mut out)
                                    (expand-includes-in-form (mut s) (al-elem [Sexp] items (load i)) dir))
                          (store! i (primitive/iadd (load i) 1)))))
              (if (= tg (primitive/cast i64 6))
                  (mk-sexp-src (KList (box-al [Sexp] a (load out))) f)
                  (mk-sexp-src (KVec (box-al [Sexp] a (load out))) f)))
            (load f)))))

; Source spelling uses `alias/name`. A dotted name is the compiler's canonical,
; post-resolution representation and must never be accepted as an alias escape hatch
; in authored code. Validate while the original Sexp and import table are both still
; available; generated hygienic names and oracle intermediate forms never pass here
; with an authored `:as` alias, while dotted C extern names remain ordinary symbols.
(defn loader-find-dot [(name (slice u8))] (-> i64)
  (let [(mut i) 0
        (mut found) -1]
    (loop (if (>= (load i) (slice-len name))
              (break)
              (if (= (primitive/cast i64 (slice-get name (load i))) (primitive/cast i64 46))
                  (do (store! found (load i)) (break))
                  (store! i (primitive/iadd (load i) 1)))))
    (load found)))

(defn dotted-alias-diag [(s (mut LS)) (node (ptr Sexp)) (module (Option (slice u8)))] (-> (Option Diag))
  (let [tg (sx-tag (load node))]
    (if (= tg (primitive/cast i64 2))
        (let [name (sx-sval (load node))
              dot (loader-find-dot name)]
          (if (< dot (primitive/cast i64 0))
              (None [Diag])
              (match module
                (None [] (None [Diag]))
                (Some [m]
                      (let [impe (imports-find (field s imports) m)
                            alias (subslice name 0 dot)]
                        (if (= (primitive/cast i64 impe) (primitive/cast i64 0))
                            (None [Diag])
                            (match (alias-target impe alias)
                              (None [] (None [Diag]))
                              (Some [_]
                                    (let [rest (subslice name (primitive/iadd dot 1) (slice-len name))
                                          replacement (sconcat3 (load (field s a)) alias "/" rest)]
                                      (Some (diag-at-form node
                                                          (sconcat3 (load (field s a))
                                                                    "dotted module qualification is not valid; use '"
                                                                    replacement
                                                                    "'"))))))))))))
        (if (or (= tg (primitive/cast i64 6)) (= tg (primitive/cast i64 7)))
            ; quote/quasiquote bodies are Code data, not authored references. Macro
            ; hygiene deliberately uses canonical dotted symbols inside that data.
            (if (and (= tg (primitive/cast i64 6))
                     (match (l-list-head node)
                       (Some [h] (or (str-eq h "quote") (str-eq h "quasiquote")))
                       (None [] false)))
                (None [Diag])
                (let [items (sx-items (load node))
                      (mut i) 0
                      (mut out) (None [Diag])]
                  (loop (if (or (>= (load i) (sx-len items)) (some? (load out)))
                            (break)
                            (do
                              (store! out
                                      (dotted-alias-diag (mut s)
                                                         (al-elem [Sexp] items (load i))
                                                         module))
                              (store! i (primitive/iadd (load i) 1)))))
                  (load out)))
            (None [Diag])))))

(defn push-checked-form! [(s (mut LS)) (form Sexp) (module (Option (slice u8)))] (-> i64)
  (let [fp (alloc/stack Sexp)]
    (store! fp form)
    (match (dotted-alias-diag (mut s) fp module)
      (Some [d] (ls-set-err! (mut s) d))
      (None [] (al-push! (mut (field s out)) (mk-tagged form module)))))
  0)

(defn register-primitive! [(s (mut LS)) (f (ptr Sexp)) (module (Option (slice u8)))] (-> i64)
  (match module
    (None []
          (ls-set-err! (mut s) (diag-at-form f "defprimitive requires a module declaration")))
    (Some [m]
          (let [items (sx-items (load f))
                n (sx-len items)]
            (if (< n (primitive/cast i64 3))
                (ls-set-err! (mut s) (diag-at-form f "defprimitive: expected a name and :opcode"))
                (let [namef (sx-at items 1)
                      opf (sx-at items (primitive/isub n 1))]
                  (if (or (!= (sx-tag namef) (primitive/cast i64 2)) (!= (sx-tag opf) (primitive/cast i64 3)))
                      (ls-set-err! (mut s) (diag-at-form f "defprimitive: expected (defprimitive NAME ... :OPCODE)"))
                      (let [p (alloc/stack PrimitiveDef)]
                        (store! (field p module) m)
                        (store! (field p name) (sx-sval namef))
                        (store! (field p opcode) (sx-sval opf))
                        (al-push! (mut (field s primitive_defs)) (load p)))))))))
  0)

; `(def NAME TARGET)` is a definition alias. Primitive identity is followed through
; this alias by the resolver; no wrapper function or generated call is involved.
(defn register-primitive-alias! [(s (mut LS)) (f (ptr Sexp)) (module (Option (slice u8)))] (-> i64)
  (match module
    (None [] (ls-set-err! (mut s) (diag-at-form f "def requires a module declaration")))
    (Some [m]
          (let [items (sx-items (load f))]
            (if (!= (sx-len items) (primitive/cast i64 3))
                (ls-set-err! (mut s) (diag-at-form f "def: expected (def NAME TARGET)"))
                (let [namef (sx-at items 1)
                      targetf (sx-at items 2)]
                  (if (or (!= (sx-tag namef) (primitive/cast i64 2)) (!= (sx-tag targetf) (primitive/cast i64 2)))
                      (ls-set-err! (mut s) (diag-at-form f "def: NAME and TARGET must be symbols"))
                      (let [p (alloc/stack PrimitiveAlias)]
                        (store! (field p module) m)
                        (store! (field p name) (sx-sval namef))
                        (store! (field p target) (sx-sval targetf))
                        (al-push! (mut (field s primitive_aliases)) (load p)))))))))
  0)

(defn process-forms [(s (mut LS)) (forms (ptr (ArrayList Sexp))) (base (slice u8)) (cur0 (Option (slice u8)))] (-> i64)
  (let [n (al-len [Sexp] (load forms))
        (mut cur) (None [(slice u8)])
        (mut i) 0]
    (store! cur cur0)
    ; Bail the moment the loader records an error (this file's import failed, or a
    ; nested imported file's did): stop processing further forms so the first
    ; diagnostic is the one reported.
    (loop (if (or (>= (load i) n) (ls-err? (mut s)))
              (break)
              (do
                (let [f (alloc/stack Sexp)]
                  (store! f (al-get [Sexp] (load forms) (load i)))
                  (match (l-list-head f)
                    (Some [h]
                          (cond (str-eq h "module")
                                  (let [name (module-name f)]
                                    (imp-entry (mut s) name)
                                    (store! cur (Some name))
                                    0)
                                (str-eq h "export")
                                  (match (dotted-alias-diag (mut s) f (load cur))
                                    (Some [d] (ls-set-err! (mut s) d))
                                    (None [] (handle-export (mut s) f (load cur))))
                                (str-eq h "import")
                                  (match (load cur)
                                    (Some [m] (process-import (mut s) f base (load cur)))
                                    (None []
                                          (ls-set-err! (mut s)
                                                       (diag-at-form f
                                                                     "import requires a (module …) declaration: add one (e.g. `(module app)`) at the top of the file, before any imports — otherwise imported types and functions cannot be resolved"))))
                                (str-eq h "cimport") (process-cimport (mut s) f (load cur))
                                (str-eq h "defprimitive") (register-primitive! (mut s) f (load cur))
                                (str-eq h "def") (register-primitive-alias! (mut s) f (load cur))
                                (form-has-include-str f)
                                  (push-checked-form! (mut s)
                                                      (expand-includes-in-form (mut s) f base)
                                                      (load cur))
                                :else (push-checked-form! (mut s) (load f) (load cur))))
                    (None []
                          (push-checked-form! (mut s) (load f) (load cur)))))
                (store! i (primitive/iadd (load i) 1)))))
    0))

(defn load-program [(s (mut LS)) (forms (ptr (ArrayList Sexp))) (base (slice u8))] (-> i64)
  (let [a (load (field s a))
        ; $COIL_STDLIB_DIR/src/compiler/prelude.coil if that override is set and the
        ; file exists (so dev edits take effect without a compiler rebuild), else the
        ; embedded copy. Unset => embedded only, never an ambient disk read.
        prelude-text
          (match (stdlib-dir a)
            (None [] (embedded-prelude))
            (Some [dir]
                  (let [d (read-file a (str->cstr a (path-join a dir "src/compiler/prelude.coil")))]
                    (if (= (slice-len d) (primitive/cast i64 0)) (embedded-prelude) d))))
        prelude-id (load (field s srccount))
        _ignore (store! (field s srccount) (primitive/iadd prelude-id 1))
        _reg (register-source! (mut s) "<prelude>" prelude-text)]
    ; Pre-register the MAIN file's module as loaded: compiling a
    ; stdlib file directly must not ALSO pull the bundled copy of the same
    ; module in through the prelude's import chain (the module would collect
    ; twice — "duplicate impl", silent last-wins for functions).
    (match (declared-module forms)
      (Some [main-mod] (do (loaded-insert! (mut s) main-mod)
                           (store! (field s entry_module) main-mod)
                           0))
      (None [] 0))
    ; The prelude is bundled stdlib: resolve ITS imports (control.coil, print.coil,
    ; …) against the bundled sentinel, not the entry file's directory — otherwise a
    ; demo like src/examples/io.coil would shadow the io library (tool-1). The MAIN file's
    ; imports use `base` = its own directory (file-relative).
    (match (read-all a prelude-text prelude-id)
      (Err [d] (do (loader-abort "read error in prelude") 0))
      (Ok [pf] (process-forms (mut s) pf (bundled-base) (None [(slice u8)]))))
    (process-forms (mut s) forms base (None [(slice u8)]))
    0))

; ============================ resolve representation =======================
; Mirrors. `Defs` = a module's definition names split by namespace
; (HashSets become ArrayLists, membership = linear str-eq scan). `DefTable` =
; per-module Defs (ArrayList of DefEntry). `ParsedForm` = one tagged form parsed
; into its own Program, retaining its module identity.
; `Defs` sets are BY-VALUE ArrayLists so names can be pushed via (primitive/field …).)
