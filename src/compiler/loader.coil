; src/compiler/loader.coil — self-host Coil compiler, loader module.

(module loader)
(import "coil.primitive" :as primitive)
(import "coil.alloc" :as alloc :use *)
(import "coil.result" :use *)
(import "coil.slice" :use *)
(import "coil.str" :use *)
(import "coil.arraylist" :use *)
(import "coil.io" :use *)
(import "coil.control" :use *)
(import "coil.try" :use *)
(import "ffi" :use *)
(import "stdlib_manifest" :use *)  ; which modules the standard library consists of

(import "ast" :use *)
(import "parser" :use *)
(import "coil.reader" :use *)
(import "resolve" :use *)
(import "cimport" :as ci)  ; the (cimport "h.h") source form generates bindings at load time

(extern opendir :cc c [(ptr i8)] (-> (ptr i8)))

(extern readdir :cc c [(ptr i8)] (-> (ptr i8)))

(extern closedir :cc c [(ptr i8)] (-> i32))

; `struct dirent` has different fixed-prefix layouts on Darwin and Linux. Keep
; the platform choice at compile time; only d_type and d_name are inspected.
(defn loader-os-pick [(linux Code) (darwin Code)] (-> Code)
  (if (primitive/code-eq (primitive/target-os) `linux) linux darwin))

; hygiene: platform-layout declarations intentionally use stable public names
(defn loader-public-name [(name Code)] (-> Code)
  (primitive/syntax->datum name))

(defn gen-dirent-layout [] (-> Code)
  `(do
     (const ~(loader-public-name `DIRENT-TYPE-OFFSET) ~(loader-os-pick `18 `20))
     (const ~(loader-public-name `DIRENT-NAME-OFFSET) ~(loader-os-pick `19 `21))))

(meta (gen-dirent-layout))

(const DT-DIR 4)

(const DT-REG 8)

; Driver-installed bridge to the compiled read-metaprogram setup. Keeping the hook
; here avoids a loader -> driver import cycle while letting recursive imports use
; the same provider engine as the entry file.
(defstruct SourceReaderHook
  [(isset i64)
   (fp (fnptr c [(ref (dyn Allocator)) (mut LS) (slice u8) (slice u8) i64 (slice u8)] (ptr (ArrayList Sexp))))])

(defn source-reader-hook [] (-> (ptr SourceReaderHook))
  (primitive/alloc-static SourceReaderHook))

(defn set-source-reader-hook! [(fp (fnptr c
                                          [(ref (dyn Allocator)) (mut LS) (slice u8) (slice u8) i64 (slice u8)]
                                          (ptr (ArrayList Sexp))))] (-> i64)
  (set! (.fp (source-reader-hook)) fp)
  (set! (.isset (source-reader-hook)) 1)
  0)

; Analysis clients that do not request C declaration reflection may defer cimport.
; The source form is consumed normally, but Clang is not spawned just to lint Coil
; syntax in an unrelated module. Ordinary build/check paths leave this disabled.
(defstruct DeferCimportBox [(on i64)])

(defn defer-cimport-box [] (-> (ptr DeferCimportBox))
  (primitive/alloc-static DeferCimportBox))

(defn set-defer-cimport! [(on bool)] (-> i64)
  (set! (.on (defer-cimport-box)) (if on 1 0))
  0)

(defn defer-cimport? [] (-> bool)
  (!= (.on (defer-cimport-box)) (primitive/cast i64 0)))

; Drain an open fd into `bytes` through a 64 KB bounce buffer, appending each read in
; one `al-extend!`. Shared by both readers below so the loop exists once.
(defn drain-fd! [(fd :i64) (buf (ptr i8)) (bytes (mut (ArrayList u8)))] (-> :i64)
  (loop (let [n (read (primitive/cast i32 fd) buf 65536)]
          (if (<= n (primitive/cast i64 0))
              (break)
              (al-extend! [u8] (mut bytes) (primitive/cast (ptr u8) buf) (primitive/cast i64 n)))))
  0)

(defn read-file [(a (dyn Allocator)) (path (ptr i8))] (-> (slice u8))
  (let [fd (open path 0)
        buf
          (primitive/cast (ptr i8)
                          (slice-data (match (alloc-bytes a 65536 1)
                                        (Some [s] s)
                                        (None []
                                              (do
                                                (oom-at c"compiler allocation" 65536)
                                                (alloc/alloc-slice-new (primitive/cast (ptr u8) 0) 0))))))
        (mut bytes) (al-new [u8] a)]
    (drain-fd! (primitive/cast :i64 fd) buf (mut bytes))
    (close fd)
    (al-slice [u8] (load bytes))))

; Like `read-file`, but distinguishes "could not open" (None) from an empty file
; (Some ""). `read-file` returns an empty slice for both, which is fine for the
; loader's "is there a module at this path" probing but WRONG for `include-str`,
; where a missing file at compile time is a hard build error, not an empty embed.
(defn read-file-opt [(a (dyn Allocator)) (path (ptr i8))] (-> (Option (slice u8)))
  (let [fd (open path 0)]
    (if (< (primitive/cast i64 fd) (primitive/cast i64 0))
        (None [(slice u8)])
        (let [buf
                (primitive/cast (ptr i8)
                                (slice-data (match (alloc-bytes a 65536 1)
                                              (Some [s] s)
                                              (None []
                                                    (do
                                                      (oom-at c"compiler allocation" 65536)
                                                      (alloc/alloc-slice-new (primitive/cast (ptr u8) 0) 0))))))
              (mut bytes) (al-new [u8] a)]
          (drain-fd! (primitive/cast :i64 fd) buf (mut bytes))
          (close fd)
          (Some (al-slice [u8] (load bytes)))))))

; A hand-built Program smoke test (no spans → byte-exact against `coil dump-ast`
; of the equivalent source). Validates the dumper before the parser is filled.
(defstruct TaggedForm
  [(form Sexp)
   (module (Option (slice u8)))
   ; Compiler-owned top-level identity. Reader node ids cross native
   ; metaprogram boundaries and can collide; they are node identities, not form
   ; identities. Snapshots preserve this id, generated forms allocate a new one.
   (form_id i64)
   (revision i64)
   ; Zero means unknown. Structural hashing is cached across unchanged
   ; expansion rounds and cleared at every syntax mutation site.
   (cached_shape i64)])

(defstruct Alias [(alias (slice u8)) (target (slice u8))])

(defsum UseSpec
  (UAll [])
  (UNames [(names (ptr (ArrayList (slice u8))))]))

; `:rename [[from to] …]` — refer the target's exported `from` under the local name
; `to`. Renaming REPLACES: once `from` is renamed, the bare `from` stops being referred
; (Clojure's rule), so a rename is an exclude plus an alias in one entry.
(defstruct Rename [(from (slice u8)) (to (slice u8))])

(defstruct Use
  [(target (slice u8))
   (spec UseSpec)
   (exclude (ptr (ArrayList (slice u8))))
   (renames (ptr (ArrayList Rename)))])

(defstruct ModImports
  [(aliases (ArrayList Alias))
   (uses (ArrayList Use))
   (reexports (ArrayList (slice u8)))
   ; The module's effective refer of `coil.core`. Every module refers all of core by
   ; default (Clojure's implicit `clojure.core`); writing ANY explicit
   ; `(import "coil.core" …)` REPLACES that default outright rather than adding to it,
   ; which is exactly how `:refer-clojure` behaves. Held as an ordinary `Use` so the one
   ; `use-refers` predicate below decides core exactly like every other import — core is
   ; the lowest-precedence tier, not a different mechanism.
   (core Use)
   (core_set bool)
   ; Kept out of the checked program, but retained with source spans so opt-in
   ; checker metaprograms can lint and rewrite import syntax.
   (forms (ArrayList Sexp))])

(defstruct ImpEntry [(name (slice u8)) (imp ModImports)])

; ---- the refer rules, in ONE place -----------------------------------------
(defn empty-names [(a (dyn Allocator))] (-> (ptr (ArrayList (slice u8))))
  (box! a (ArrayList (slice u8)) (al-new [(slice u8)] a)))

(defn empty-renames [(a (dyn Allocator))] (-> (ptr (ArrayList Rename)))
  (box! a (ArrayList Rename) (al-new [Rename] a)))

; A null exclude/renames list means "none" — the parser only allocates when the
; keyword is actually present, so the common import costs nothing.
(defn mk-use [(a (dyn Allocator))
              (target (slice u8))
              (spec UseSpec)
              (exclude (ptr (ArrayList (slice u8))))
              (renames (ptr (ArrayList Rename)))] (-> Use)
  (let [u (primitive/alloc-stack Use)]
    (set! (.target u) target)
    (set! (.spec u) spec)
    (set! (.exclude u) (if (= (primitive/cast i64 exclude) (primitive/cast i64 0)) (empty-names a) exclude))
    (set! (.renames u) (if (= (primitive/cast i64 renames) (primitive/cast i64 0)) (empty-renames a) renames))
    (load u)))

;; Does this import refer NAME into the importing module, and if so, under which of the
;; target's own exported names? `(Some exported)` when referred — `exported` differs from
;; `name` only for a `:rename`. `(None)` when this import does not put `name` in scope.
;;
;; ONE predicate, four callers: the resolver (values/types/traits), the ambient primitive
;; aliases, the macro expander, and the checker's trait-method visibility. Every refer
;; rule lives here, so all four agree by construction — an `:exclude` that hid a name from
;; the resolver but left the trait method callable would be worse than no feature at all.
(defn use-refers [(u (ptr Use)) (name (slice u8))] (-> (Option (slice u8)))
  (let [rs (load (field u renames))
        n (al-len [Rename] (load rs))
        (mut i) 0
        (mut out) (None [(slice u8)])
        (mut done) false]
    ; A rename settles the question in BOTH directions: the new name is referred
    ; whatever the spec says, and the original name stops being referred.
    (loop (if (or (load done) (>= (load i) n))
              (break)
              (do
                (let [rp (al-elem [Rename] rs (load i))]
                  (if (= (.to rp) name)
                      (do (set! out (Some (.from rp))) (set! done true) 0)
                      (when (= (load (field rp from)) name) (store! done true) 0)))
                (set! i (primitive/iadd (load i) 1)))))
    (if (load done)
        (load out)
        (if (set-contains (load (field u exclude)) name)
            (None [(slice u8)])
            (match (.spec u)
              (UAll [] (Some name))
              (UNames [names] (if (set-contains names name) (Some name) (None [(slice u8)]))))))))

;; The inverse of `use-refers`: under which LOCAL name, if any, does this import bring
;; the target's exported NAME into scope? Needed wherever the walk starts from the
;; target's declarations instead of from a use site (the ambient primitive aliases).
(defn use-local-of [(u (ptr Use)) (exported (slice u8))] (-> (Option (slice u8)))
  (let [rs (load (field u renames))
        n (al-len [Rename] (load rs))
        (mut i) 0
        (mut out) (None [(slice u8)])
        (mut done) false]
    (loop (if (or (load done) (>= (load i) n))
              (break)
              (do
                (let [rp (al-elem [Rename] rs (load i))]
                  (when (= (load (field rp from)) exported)
                    (store! out (Some (load (field rp to))))
                    (store! done true)
                    0))
                (set! i (primitive/iadd (load i) 1)))))
    (if (load done)
        (load out)
        (if (set-contains (load (field u exclude)) exported)
            (None [(slice u8)])
            (match (.spec u)
              (UAll [] (Some exported))
              (UNames [names] (if (set-contains names exported) (Some exported) (None [(slice u8)]))))))))

;; The module's refer of `coil.core`, via the same predicates. A module with no import
;; record at all (a comptime sub-program, a standalone file with no `(module …)`) refers
;; all of core — that is the default every module starts from.
(defn core-refers [(imp (ptr ImpEntry)) (name (slice u8))] (-> (Option (slice u8)))
  (if (= (primitive/cast i64 imp) (primitive/cast i64 0))
      (Some name)
      (use-refers (field (field imp imp) core) name)))

(defn core-local-of [(imp (ptr ImpEntry)) (exported (slice u8))] (-> (Option (slice u8)))
  (if (= (primitive/cast i64 imp) (primitive/cast i64 0))
      (Some exported)
      (use-local-of (field (field imp imp) core) exported)))

;; Did this import DELIBERATELY drop NAME — an `:exclude` entry, or a `:rename` that
;; moved it to a different local name? This is a stronger statement than "not referred":
;; a name merely absent from a `:use [names]` list was never claimed either way, which
;; matters for trait methods (a method whose trait is unique is callable today with no
;; import at all, so silence must not be read as refusal).
(defn use-drops? [(u (ptr Use)) (name (slice u8))] (-> bool)
  (if (set-contains (load (field u exclude)) name)
      true
      (let [rs (load (field u renames))
            n (al-len [Rename] (load rs))
            (mut i) 0
            (mut r) false]
        (loop (if (or (load r) (>= (load i) n))
                  (break)
                  (do
                    (when (= (load (field (al-elem [Rename] rs (load i)) from)) name)
                      (store! r true)
                      0)
                    (set! i (primitive/iadd (load i) 1)))))
        (load r))))

;; Does this module have an explicit `(import "coil.core" …)`? An explicit core import
;; states core's refer set IN FULL, so it is authoritative in a way an ordinary import
;; is not.
(defn core-explicit? [(imp (ptr ImpEntry))] (-> bool)
  (if (= (primitive/cast i64 imp) (primitive/cast i64 0))
      false
      (.core_set (.imp imp))))

(defn core-drops? [(imp (ptr ImpEntry)) (name (slice u8))] (-> bool)
  (if (= (primitive/cast i64 imp) (primitive/cast i64 0))
      false
      (use-drops? (field (field imp imp) core) name)))

;; The `:use` entry a module has for TARGET, or null when it has none.
(defn use-for-target [(imp (ptr ImpEntry)) (target (slice u8))] (-> (ptr Use))
  (if (= (primitive/cast i64 imp) (primitive/cast i64 0))
      (primitive/cast (ptr Use) 0)
      (let [uses (field (field imp imp) uses)
            n (al-len [Use] (load uses))
            (mut i) 0
            (mut r) (primitive/cast (ptr Use) 0)]
        (loop (if (or (>= (load i) n) (!= (primitive/cast i64 (load r)) (primitive/cast i64 0)))
                  (break)
                  (do
                    (let [up (al-elem [Use] uses (load i))]
                      (when (= (load (field up target)) target) (store! r up) 0))
                    (set! i (primitive/iadd (load i) 1)))))
        (load r))))

(defstruct ExpEntry
  [(name (slice u8))
   (names (ArrayList (slice u8)))
   ; The checker-facing source view also needs explicit export declarations.
   (forms (ArrayList Sexp))])

; One registered source: a display name + full text. `line_starts` makes located
; diagnostics logarithmic in the line count instead of rescanning from byte zero
; for every warning (project lint can legitimately render hundreds of them).
(defstruct Source
  [(name (slice u8))
   (text (slice u8))
   (line_starts (ptr (ArrayList i64)))])

; A macro-expansion record: the macro name, its call site
; and def site (spans), and the enclosing expansion context (parent ctxt).
(defstruct Expansion
  [(macro_name (slice u8))
   (call_source i64)
   (call_lo i64)
   (call_hi i64)
   (call_ctxt i64)
   (def_source i64)
   (def_lo i64)
   (def_hi i64)
   (def_ctxt i64)
   (parent i64)])

; Shared instrumentation for the semantic workspace. Derived loader states point
; at the same box, so a temporary expansion view cannot hide a full rebuild by
; incrementing a private counter.
(defstruct SemanticAudit
  [(full_resolves i64)
   (incremental_resolve_updates i64)
   (form_parse_attempts i64)
   (unique_form_revisions i64)
   (duplicate_form_parses i64)])
(defstruct SemanticWorkspaceSlot [(value (ptr i8)) (owner (dyn Allocator))])

(defstruct LS
  [(a (dyn Allocator))
   (out (ArrayList TaggedForm))
   (loaded (ArrayList (slice u8)))
   ; resolved-path -> declared module name, for files already read (see read-memo-find)
   (readpaths (ArrayList (slice u8)))
   (readmods (ArrayList (slice u8)))
   (imports (ArrayList ImpEntry))
   (exports (ArrayList ExpEntry))
   ; Source-visible compiler operations and aliases, collected from ordinary
   ; namespaced top-level declarations. Opcodes never participate in name lookup.
   (primitive_defs (ArrayList PrimitiveDef))
   (primitive_aliases (ArrayList PrimitiveAlias))
   (srccount i64)
   ; The SourceMap: sources[id] = the file at that id (main=0, prelude=1, imports
   ; 2..). expansions[ctxt-1] = the macro provenance for ctxt (>=1). Both grow in
   ; the exact order registers them, so ids/ctxts match the reference.
   (sources (ArrayList Source))
   (expansions (ArrayList Expansion))
   ; All type-check body errors (build path renders every one; the dump-checked
   ; oracle still reports [0]). A heap-boxed list so the checker can push through it.
   (check_diags (ptr (ArrayList Diag)))
   ; All RESOLVE body errors, same treatment: resolve collects per function and
   ; continues instead of aborting the pipeline on the first, so a batch of mistakes
   ; is reported in one pass (the checker already did this; resolve did not). The
   ; qualified names of functions whose BODY failed to resolve — the checker skips
   ; their bodies but keeps their SIGNATURES in the table, so callers don't cascade.
   (resolve_diags (ptr (ArrayList Diag)))
   (resolve_poisoned (ptr (ArrayList (slice u8))))
   ; The loader's first error, as a framed Diag.
   ; Threaded via a slot (not a Result return) so the loop-heavy loader
   ; keeps its i64 signatures; set once, then process-forms/-import bail early and
   ; run-pipeline reports it through the SAME render path as every other diagnostic.
   (loaderr Diag)
   (loaderr_set bool)
   ; Keep index-only state at the tail: staged compiler components share LS's
   ; established prefix layout across their native metaprogram boundary.
   (namespace_names (ArrayList (slice u8)))
   (namespace_paths (ArrayList (slice u8)))
   ; The entry file's declared module. `main` is the one function the resolver never
   ; renames, so its qualified name carries no module — and without this, anything that
   ; asks "which module is this code in?" (import-driven visibility, refer control) gets
   ; no answer inside `main` and silently falls back to "no restrictions".
   (entry_module (slice u8))
   ; Invocation-time Code entries owned by the driver (currently reader
   ; providers). They remain ordinary declarations in the loaded graph but must
   ; never join definition-time eager/lazy staging for that graph.
   (stage_excluded (ArrayList (slice u8)))
   ; Definition-module import tables carried by hygienic syntax across an
   ; isolated phase boundary. These are resolution metadata, never source forms.
   (hygiene_imports (ArrayList ImpEntry))
   ; Opaque state owned by a compiler SDK session. Only metaprogram Code
   ; operations inspect it; ordinary builds leave it null.
   ; Explicit ambient-provider bookkeeping. A module enters `core_declared_modules`
   ; only through `(provide-core ...)`; the parallel contribution arrays enforce
   ; collision-free assembly across root-activated providers.
   (core_declared_modules (ArrayList (slice u8)))
   (core_contribution_names (ArrayList (slice u8)))
   (core_contribution_modules (ArrayList (slice u8)))
   (code_session_state (ptr i8))
   ; Opaque, compilation-owned semantic workspace. Resolution owns the concrete
   ; type; loader only establishes its lifetime. Every derived LS used by
   ; expansion must borrow this pointer rather than constructing an independent
   ; parsed/resolved universe.
   (semantic_workspace (ptr SemanticWorkspaceSlot))
   ; Auditable pipeline invariants. `full_resolves` counts complete
   ; workspace construction, not incremental updates. Once the workspace
   ; migration is complete, production compilation asserts this never exceeds
   ; one and the regression gate checks the parse counters per form revision.
   (semantic_audit (ptr SemanticAudit))])

(defstruct Resolved [(text (slice u8)) (incdir (slice u8)) (disp (slice u8))])

;; Initialize EVERY field of a fresh LS.
;;
;; LS is stack-allocated and used to be hand-initialized field by field at fifteen
;; separate call sites. That is how eight of them ended up never setting
;; `namespace_names`/`namespace_paths`: those two read uninitialized stack memory, and
;; the visible symptom was `coil expand` failing to resolve a project namespace that
;; `coil check` resolved fine, because the two commands initialize their LS in different
;; files. A twenty-field struct cannot be correctly initialized by hand in fifteen
;; places — it has to be one function, so that adding a field is one edit and cannot
;; leave a site half-built.
;;
;; Callers still override what is genuinely theirs afterwards (`srccount`, and the
;; sub-program builders that deliberately share a parent's boxed diagnostic lists).
(defn ls-init! [(s (mut LS)) (a (dyn Allocator))] (-> i64)
  (set! (.a s) a)
  (set! (.out s) (al-new [TaggedForm] a))
  (set! (.loaded s) (al-new [(slice u8)] a))
  (set! (.readpaths s) (al-new [(slice u8)] a))
  (set! (.readmods s) (al-new [(slice u8)] a))
  (set! (.imports s) (al-new [ImpEntry] a))
  (set! (.exports s) (al-new [ExpEntry] a))
  (set! (.primitive_defs s) (al-new [PrimitiveDef] a))
  (set! (.primitive_aliases s) (al-new [PrimitiveAlias] a))
  (set! (.sources s) (al-new [Source] a))
  (set! (.expansions s) (al-new [Expansion] a))
  (set! (.namespace_names s) (al-new [(slice u8)] a))
  (set! (.namespace_paths s) (al-new [(slice u8)] a))
  (set! (.srccount s) 0)
  (set! (.check_diags s) (box-al [Diag] a (al-new [Diag] a)))
  (set! (.resolve_diags s) (primitive/cast (ptr (ArrayList Diag)) 0))
  (set! (.resolve_poisoned s) (primitive/cast (ptr (ArrayList (slice u8))) 0))
  (set! (.loaderr s) (primitive/zeroed Diag))
  (set! (.loaderr_set s) false)
  (set! (.entry_module s) "")
  (set! (.stage_excluded s) (al-new [(slice u8)] a))
  (set! (.hygiene_imports s) (al-new [ImpEntry] a))
  (set! (.core_declared_modules s) (al-new [(slice u8)] a))
  (set! (.core_contribution_names s) (al-new [(slice u8)] a))
  (set! (.core_contribution_modules s) (al-new [(slice u8)] a))
  (set! (.code_session_state s) (primitive/cast (ptr i8) 0))
  (set! (.semantic_workspace s)
        (box! a SemanticWorkspaceSlot (primitive/zeroed SemanticWorkspaceSlot)))
  (store! (field (load (field s semantic_workspace)) owner) a)
  (set! (.semantic_audit s) (box! a SemanticAudit (primitive/zeroed SemanticAudit)))
  0)

; A derived LS may use a different allocator and form list, but its semantic
; identity belongs to the parent compilation. Keep this operation explicit at
; every phase boundary; copying fields ad hoc is what allowed expansion to
; reconstruct the entire program without the owning pipeline being able to see
; or prevent it.
(defn ls-borrow-semantics! [(child (mut LS)) (parent (mut LS))] (-> i64)
  (set! (.semantic_workspace child) (.semantic_workspace parent))
  (set! (.semantic_audit child) (.semantic_audit parent))
  0)

; Register a source (name+text) into the SourceMap, in id order (sources[id]).
(defn register-source! [(s (mut LS)) (name (slice u8)) (text (slice u8))] (-> i64)
  (let [sp (primitive/alloc-stack Source)
        a (load (field s a))
        (mut starts) (al-new [i64] a)
        n (slice-len text)
        (mut i) 0]
    (al-push! (mut starts) 0)
    (loop (if (>= (load i) n)
              (break)
              (do
                (when (= (primitive/cast i64 (slice-get text (load i))) (primitive/cast i64 10))
                  (al-push! (mut starts) (primitive/iadd (load i) 1))
                  0)
                (set! i (primitive/iadd (load i) 1)))))
    (set! (.name sp) name)
    (set! (.text sp) text)
    (set! (.line_starts sp) (box-al [i64] a (load starts)))
    (al-push! (mut (.sources s)) (load sp)))
  0)

;; Record a declaration form for the checker-facing source view, ONCE.
;;
;; The same declaration reaches here more than once in a normal run -- the initial
;; load processes it, and `rebuild-transformed-declarations!` re-processes it after
;; transforms -- and an accumulating list is how one wildcard import turned into two
;; identical warnings. A form is identified by its span: same source, same start
;; offset, same form.
(defn decl-form-recorded? [(fs (ArrayList Sexp)) (f Sexp) (i i64) (n i64)] (-> bool)
  (if (>= i n)
      false
      (let [g (al-get [Sexp] fs i)]
        (if (and (= (sx-source g) (sx-source f))
                 (and (= (sx-lo g) (sx-lo f)) (= (sx-hi g) (sx-hi f))))
            true
            (decl-form-recorded? fs f (primitive/iadd i 1) n)))))

(defn record-decl-form! [(fs (mut (ArrayList Sexp))) (f Sexp)] (-> i64)
  (unless (decl-form-recorded? (load fs) f 0 (al-len [Sexp] (load fs)))
    (al-push! (mut fs) f)
    0)
  0)

(defn source-is-cli-use? [(s (mut LS)) (source i64)] (-> bool)
  (if (or (primitive/icmp-lt source 0)
          (primitive/icmp-ge source (al-len [Source] (primitive/load (primitive/field s sources)))))
      false
      (let [sp (primitive/alloc-stack Source)]
        (primitive/store! sp (al-get [Source] (primitive/load (primitive/field s sources)) source))
        (str-eq (primitive/load (primitive/field sp name)) "<cli-use>"))))

; Register an expansion; return its ctxt id (1-based; 0 = root).
(defn add-expansion! [(s (mut LS)) (e Expansion)] (-> i64)
  (al-push! (mut (.expansions s)) e)
  (al-len [Expansion] (.expansions s)))

; ============================ loader helpers (copied) ======================
(defn next-form-id [] (-> i64)
  (let [cell (primitive/alloc-static i64)
        id (primitive/iadd (load cell) 1)]
    (store! cell id)
    id))

(defn mk-tagged [(form Sexp) (module (Option (slice u8)))] (-> TaggedForm)
  (let [p (primitive/alloc-stack TaggedForm)]
    (set! (.form p) form)
    (set! (.module p) module)
    (set! (.form_id p) (next-form-id))
    (set! (.revision p) 0)
    (set! (.cached_shape p) 0)
    (load p)))

; The only operation that changes syntax inside an existing form revision.
; Keeping revision and shape invalidation inseparable makes the semantic cache
; safe by construction; source guards reject open-coded form mutation.
(defn tagged-rewrite! [(p (ptr TaggedForm)) (form Sexp)] (-> i64)
  (store! (field p form) form)
  (store! (field p revision) (primitive/iadd (load (field p revision)) 1))
  (store! (field p cached_shape) 0)
  0)

(defn loader-abort [(msg (slice u8))] (-> i64)
  (let [w (stderr)] (ps w "loader error: ") (ps w msg) (wb w 10))
  (abort)
  0)

; A framed loader diagnostic anchored at `f`'s span.
(defn diag-at-form [(f (ptr Sexp)) (msg (slice u8))] (-> Diag)
  (let [d (primitive/alloc-stack Diag)]
    (set! (.lo d) (.lo f))
    (set! (.hi d) (.hi f))
    (set! (.msg d) msg)
    (set! (.source d) (.source f))
    (set! (.ctxt d) (.ctxt f))
    (load d)))

; Record the loader's first error and mark the run failed (idempotent: keep the first).
(defn ls-set-err! [(s (mut LS)) (d Diag)] (-> i64)
  (unless (load (field s loaderr_set))
    (store! (field s loaderr) d)
    (store! (field s loaderr_set) true)
    0))

(defn ls-err? [(s (mut LS))] (-> bool)
  (.loaderr_set s))

(defn cstr-len [(p (ptr i8))] (-> i64)
  (let [(mut i) 0]
    (loop (if (= (primitive/cast i64 (load (primitive/index p (load i)))) (primitive/cast i64 0))
              (break)
              (set! i (primitive/iadd (load i) 1))))
    (load i)))

(defn cstr->slice [(p (ptr i8))] (-> (slice u8))
  (slice-new [u8] (primitive/cast (ptr u8) p) (cstr-len p)))

(defn cwd-slice [(a (dyn Allocator))] (-> (slice u8))
  (let [buf
          (primitive/cast (ptr i8)
                          (slice-data (match (alloc-bytes a 4096 1)
                                        (Some [s] s)
                                        (None []
                                              (do
                                                (oom-at c"compiler allocation" 4096)
                                                (alloc/alloc-slice-new (primitive/cast (ptr u8) 0) 0))))))
        r (getcwd buf 4096)]
    (if (= (primitive/cast i64 r) (primitive/cast i64 0))
        (do (loader-abort "getcwd failed") "")
        (cstr->slice buf))))

(defn path-join [(a (dyn Allocator)) (base (slice u8)) (path (slice u8))] (-> (slice u8))
  (if (and (> (slice-len path) (primitive/cast i64 0))
           (= (primitive/cast i64 (slice-get path 0)) (primitive/cast i64 47)))
      path
      (let [m1 (match (str-concat a base "/") (Some [v] v) (None [] ""))]
        (match (str-concat a m1 path) (Some [v] v) (None [] "")))))

(defn dirname [(p (slice u8))] (-> (slice u8))
  (let [n (slice-len p)
        (mut idx) -1
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (when (= (primitive/cast i64 (slice-get p (load i))) (primitive/cast i64 47))
                  (store! idx (load i)))
                (set! i (primitive/iadd (load i) 1)))))
    (if (< (load idx) (primitive/cast i64 0)) "." (subslice p 0 (load idx)))))

(defn basename [(p (slice u8))] (-> (slice u8))
  (let [n (slice-len p)
        (mut idx) -1
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (when (= (primitive/cast i64 (slice-get p (load i))) (primitive/cast i64 47))
                  (store! idx (load i)))
                (set! i (primitive/iadd (load i) 1)))))
    (if (< (load idx) (primitive/cast i64 0)) p (subslice p (primitive/iadd (load idx) 1) n))))

; The generated manifest IS the single source of truth for which modules are the
; standard library's — the old hand-maintained duplicate list is gone, and the
; snapshot corpus derives its lib set from `src/stdlib/*.coil` directly.
(defn bundled? [(name (slice u8))] (-> bool)
  (or (stdlib-manifest-file? name) (sdk-manifest-file? name)))

; The import base for bundled stdlib files and the prelude. It marks compiler-owned
; embedded text, keeping the bundle self-contained and enabling narrowly scoped
; bootstrap compatibility for older embedded filename imports.
(defn bundled-base [] (-> (slice u8))
  "<bundled>")

; Project mode freezes these in the environment before any source is loaded.
; Direct-file mode leaves them unset and retains the bundled toolchain universe.
(defn bundled-stdlib-enabled? [(a (dyn Allocator))] (-> bool)
  (let [p (getenv (str->cstr a "COIL_STDLIB"))]
    (or (= (primitive/cast i64 p) (primitive/cast i64 0))
        (not (= (cstr->slice p) "0")))))

(defn stdlib-profile [(a (dyn Allocator))] (-> (slice u8))
  (let [p (getenv (str->cstr a "COIL_STDLIB_PROFILE"))]
    (if (= (primitive/cast i64 p) (primitive/cast i64 0))
        (if (bundled-stdlib-enabled? a) "full" "none")
        (cstr->slice p))))

(defstruct PreludeNameBox [(known bool) (name (slice u8))])

(defn prelude-name-box [] (-> (ptr PreludeNameBox))
  (primitive/alloc-static PreludeNameBox))

(defn reset-implicit-prelude-cache! [] (-> i64)
  (set! (.known (prelude-name-box)) false)
  0)

(defn implicit-prelude-name [(a (dyn Allocator))] (-> (slice u8))
  ; Project configuration is frozen before loading starts. Recursive namespace,
  ; expansion and resolution walks ask for the same prelude thousands of times;
  ; getenv's locked linear environment search does not belong in those walks.
  (let [b (prelude-name-box)]
    (unless (.known b)
      (let [p (getenv (str->cstr a "COIL_PRELUDE"))]
        (set! (.name b)
          (if (or (= (primitive/cast i64 p) (primitive/cast i64 0))
                  (= (slice-len [u8] (cstr->slice p)) (primitive/cast i64 0)))
              "coil.core"
              (cstr->slice p)))
        (set! (.known b) true))
      0)
    (.name b)))

(defn path-readable? [(a (dyn Allocator)) (p (slice u8))] (-> bool)
  (let [fd (open (str->cstr a p) 0)]
    (if (< (primitive/cast i64 fd) (primitive/cast i64 0))
        false
        (do (close fd) true))))

; ── finding the standard library ─────────────────────────────────────────────
; The compiler and the standard library are ONE toolchain with ONE version. The
; library is a directory of files, installed together with the binary and never
; separately, and found the way python finds its prefix and rustc finds its sysroot:
; walk up from the location of the compiler that is running, looking for a landmark.
; Two layouts count as a hit.
;
;   INSTALLED  <prefix>/bin/coil      ->  <prefix>/lib/coil/stdlib/*.coil
;                                         <prefix>/lib/coil/prelude.coil
;   CHECKOUT   <root>/build/bin/coil  ->  <root>/src/stdlib/*.coil
;                                         <root>/src/compiler/prelude.coil
;
; A compiler built inside a checkout finds that checkout — which is what keeps two
; checkouts, or two worktrees, on their own library instead of shadowing each other —
; and `dev.py install` copies binary and library into a prefix as one act.
;
; What this replaced: the library used to be `include-str`'d into the binary, so an
; installed compiler served whatever the library was on the day it was built. That is
; a compiler and a library at two different versions, and the only way to see the
; difference was to notice that an edit had no effect. The workaround was
; COIL_STDLIB_DIR, an override that had to be remembered on every invocation and
; failed silently when it wasn't. Both are gone: there is one library on disk, the
; command you ran decides which, and `coil --version` prints it.
;
; A compiler that finds no library cannot compile: it says so and exits, naming both
; places it looked (`stdlib-not-found`), the way rustc does when its sysroot is
; missing. The search falls back to the working directory because the bootstrap builds
; stage compilers into /tmp and runs them from the checkout, which is a toolchain root
; even though the binary is not inside it.
(defstruct SelfCommandBox [(known i64) (path (slice u8))])

(defn self-command-box [] (-> (ptr SelfCommandBox))
  (primitive/alloc-static SelfCommandBox))

;; Publish argv[0] — the command the user actually ran. `driver-main` calls this
;; before anything can load a library; until it does, only the working-directory
;; anchor of the search below is available.
(defn set-self-command! [(p (slice u8))] (-> i64)
  (let [b (self-command-box)]
    (set! (.known b) 1)
    (set! (.path b) p))
  0)

(defn self-command [] (-> (slice u8))
  (let [b (self-command-box)]
    (if (= (.known b) (primitive/cast i64 0)) "" (.path b))))

;; Scan PATH for `name`, the way the shell just did. "" when no entry holds it.
(defn path-in-search-path [(a (dyn Allocator)) (name (slice u8))] (-> (slice u8))
  (let [p (getenv (str->cstr a "PATH"))]
    (if (= (primitive/cast i64 p) (primitive/cast i64 0))
        ""

        (let [path (cstr->slice p)
              n (slice-len path)
              (mut start) 0
              (mut i) 0
              (mut found) ""]
          (loop (let [at-end (>= (load i) n)
                      sep
                        (if at-end
                            true
                            (= (primitive/cast i64 (slice-get path (load i))) (primitive/cast i64 58)))]
                  (if sep
                      ; An empty PATH entry means the working directory, as in the shell.
                      (let [entry (subslice path (load start) (load i))
                            dir (if (= (slice-len entry) (primitive/cast i64 0)) "." entry)
                            cand (path-join a dir name)]
                        (if (path-readable? a cand)
                            (do (set! found cand) (break))
                            (if at-end
                                (break)
                                (do
                                  (set! start (primitive/iadd (load i) 1))
                                  (set! i (primitive/iadd (load i) 1))
                                  0))))
                      (do (set! i (primitive/iadd (load i) 1)) 0))))
          (load found)))))

(defn realpath-opt [(a (dyn Allocator)) (path (slice u8))] (-> (Option (slice u8)))
  (let [buf
          (primitive/cast (ptr i8)
                          (slice-data (match (alloc-bytes a 4096 1)
                                        (Some [s] s)
                                        (None []
                                              (do
                                                (oom-at c"compiler allocation" 4096)
                                                (alloc/alloc-slice-new (primitive/cast (ptr u8) 0) 0))))))
        r (realpath (str->cstr a path) buf)]
    (if (= (primitive/cast i64 r) (primitive/cast i64 0))
        (None [(slice u8)])
        (Some (cstr->slice buf)))))

;; A command name as the filesystem path of the thing it runs.
;;
;; A shell may keep the bare command name in argv[0] after finding the executable
;; through PATH, so a compiler that wants to locate anything relative to ITSELF —
;; its standard library, the native archives beside it — has to redo that lookup.
;; realpath first (which covers absolute and cwd-relative names, and follows a
;; symlinked `coil` to the toolchain it really belongs to), then PATH. Unresolvable
;; names come back unchanged, so a caller never has to special-case failure.
;;
;; `driver.coil`'s resource paths resolve through this same function: two subtly
;; different answers to "where am I" is how a compiler ends up finding its archives
;; and its library in different places.
(defn resolve-command-path [(a (dyn Allocator)) (name (slice u8))] (-> (slice u8))
  (if (= (slice-len name) (primitive/cast i64 0))
      name
      (match (realpath-opt a name)
        (Some [p] p)
        (None []
              (match (str-find name "/")
                (Some [i0] name)
                (None []
                      (let [found (path-in-search-path a name)]
                        (if (= (slice-len found) (primitive/cast i64 0))
                            name
                            (match (realpath-opt a found) (Some [p] p) (None [] found))))))))))

(defn self-command-path [(a (dyn Allocator))] (-> (slice u8))
  (resolve-command-path a (self-command)))

; Where the library was found. STDLIB-MISSING means nowhere, which is fatal at the
; first module load — there is nothing else to serve.
(const STDLIB-MISSING 0)

(const STDLIB-INSTALLED 1)

(const STDLIB-CHECKOUT 2)

; `libs` is the ordinary library, `sdk` the opt-in compiler sources, and
; `prelude` the full path of prelude.coil.
(defstruct StdlibLayout
  [(resolved i64) (kind i64) (libs (slice u8)) (sdk (slice u8)) (prelude (slice u8))])

;; Does `dir` hold either layout? Directories are the landmarks, not any particular
;; file: a library that gains or loses a module must not change how it is found.
(defn installed-layout-belongs-to-command? [(a (dyn Allocator)) (dir (slice u8))] (-> bool)
  ; An installed library belongs only to a compiler in its sibling `bin` directory.
  ; Without this ownership check, a loose `/tmp/coil-candidate` silently adopts any
  ; stale `/tmp/lib/coil` left by a different checkout or bootstrap run.
  (= (dirname (self-command-path a)) (path-join a dir "bin")))

(defn stdlib-layout-at! [(a (dyn Allocator)) (dir (slice u8)) (out (ptr StdlibLayout))] (-> bool)
  (let [installed (path-join a dir "lib/coil/stdlib")
        installed-sdk (path-join a dir "lib/coil/compiler")]
    (if (and (path-readable? a installed) (installed-layout-belongs-to-command? a dir))
        (do
          (set! (.kind out) STDLIB-INSTALLED)
          (set! (.libs out) installed)
          ; Bootstrap stage binaries live in /tmp beside the installed stdlib
          ; compatibility fixture, while building compiler sources from a checkout.
          ; Prefer a shipped SDK, then the current checkout's SDK if present.
          (set! (.sdk out)
                (if (path-readable? a installed-sdk)
                    installed-sdk
                    (path-join a (cwd-slice a) "src/compiler")))
          (set! (.prelude out) (path-join a dir "lib/coil/prelude.coil"))
          true)
        ; Both halves of a checkout are required. `src/stdlib` alone could be any
        ; project that happens to use that name; only this one also has src/compiler.
        (let [libs (path-join a dir "src/stdlib")]
          (if (and (path-readable? a libs) (path-readable? a (path-join a dir "src/compiler")))
              (do
                (set! (.kind out) STDLIB-CHECKOUT)
                (set! (.libs out) libs)
                (set! (.sdk out) (path-join a dir "src/compiler"))
                (set! (.prelude out) (path-join a dir "src/compiler/prelude.coil"))
                true)
              false)))))

;; Walk `start` and its ancestors, stopping at the first directory holding a layout.
(defn stdlib-layout-upward! [(a (dyn Allocator)) (start (slice u8)) (out (ptr StdlibLayout))] (-> bool)
  (if (= (slice-len start) (primitive/cast i64 0))
      false
      (let [(mut dir) start
            (mut hit) false]
        (loop (if (stdlib-layout-at! a (load dir) out)
                  (do (set! hit true) (break))
                  ; dirname bottoms out at "" (from "/x") or "." (from a bare name);
                  ; either way the parent stops changing, which ends the walk.
                  (let [up (dirname (load dir))]
                    (if (or (= up (load dir)) (<= (slice-len (load dir)) (primitive/cast i64 1)))
                        (break)
                        (do (set! dir up) 0)))))
        (load hit))))

(defn find-stdlib-layout! [(a (dyn Allocator)) (out (ptr StdlibLayout))] (-> i64)
  (set! (.kind out) STDLIB-MISSING)
  (set! (.libs out) "")
  (set! (.sdk out) "")
  (set! (.prelude out) "")
  ; The compiler's own location first — that is the toolchain it belongs to. The
  ; working directory second, which is how a stage compiler in /tmp finds the checkout
  ; it is building.
  (unless (stdlib-layout-upward! a (dirname (self-command-path a)) out)
    (stdlib-layout-upward! a (cwd-slice a) out)
    0)
  0)

; Resolved once per process: every library file consults it, and the walk costs a
; handful of directory probes that would otherwise be repeated seventy times.
(defn stdlib-layout-box [] (-> (ptr StdlibLayout))
  (primitive/alloc-static StdlibLayout))

(defn stdlib-layout [(a (dyn Allocator))] (-> (ptr StdlibLayout))
  (let [b (stdlib-layout-box)]
    (when (= (load (field b resolved)) (primitive/cast i64 0))
      (find-stdlib-layout! a b)
      (store! (field b resolved) 1)
      0)
    b))

;; How `coil --version` describes the answer. The layout is named as well as located,
;; because "which library am I compiling against" is the question this whole mechanism
;; exists to make answerable by asking rather than by experiment.
(defn stdlib-source-text [(a (dyn Allocator))] (-> (slice u8))
  (let [l (stdlib-layout a)
        kind (.kind l)]
    (if (= kind STDLIB-MISSING)
        "NOT FOUND"
        (let [label (if (= kind STDLIB-INSTALLED) "installed: " "checkout: ")]
          (match (str-concat a label (.libs l)) (Some [v] v) (None [] label))))))

;; No library, no compiler. Report both places that were searched and how to install,
;; rather than failing later as a pile of unresolved `coil.*` imports.
(defn stdlib-not-found [(a (dyn Allocator)) (want (slice u8))] (-> i64)
  (let [w (stderr)]
    (ps w "error: cannot find the coil standard library (looking for '")
    (ps w want)
    (ps w "')\n")
    (ps w "  searched upward from the compiler at: ")
    (ps w (self-command-path a))
    (wb w 10)
    (ps w "  and upward from the working directory: ")
    (ps w (cwd-slice a))
    (wb w 10)
    (ps w "note: a coil installation is <prefix>/bin/coil next to <prefix>/lib/coil/stdlib,\n")
    (ps w "      and a checkout is a directory holding src/stdlib and src/compiler.\n")
    (ps w "      The library ships WITH the compiler: install both with\n")
    (ps w "          python3 scripts/dev.py install\n")
    (exit 1)
    0))

; Text of one library module, read from the layout that was found. A missing file is
; fatal for the same reason a missing layout is: the alternative is a compiler that
; half-has a standard library and reports the shortfall as the user's type error.
(defn bundled-text [(a (dyn Allocator)) (bn (slice u8))] (-> (slice u8))
  (let [l (stdlib-layout a)]
    (when (= (load (field l kind)) STDLIB-MISSING) (stdlib-not-found a bn) 0)
    (let [sdk? (starts-with bn "compiler/")
          p
            (path-join a
                       (if sdk? (.sdk l) (.libs l))
                       (if sdk? (subslice bn 9 (slice-len bn)) bn))
          d (read-file a (str->cstr a p))]
      (when (= (slice-len d) (primitive/cast i64 0)) (stdlib-not-found a p) 0)
      d)))

;; The prelude is a library file too, in its own place in each layout.
(defn stdlib-prelude-text [(a (dyn Allocator))] (-> (slice u8))
  (let [l (stdlib-layout a)]
    (when (= (load (field l kind)) STDLIB-MISSING) (stdlib-not-found a "prelude.coil") 0)
    (let [p (.prelude l)
          d (read-file a (str->cstr a p))]
      (when (= (slice-len d) (primitive/cast i64 0)) (stdlib-not-found a p) 0)
      d)))

; A `coil.*` namespace that resolves from the source tree instead of the bundle is
; a manifest bug: it works in this repo and fails for every compiler run outside
; it. That asymmetry is precisely what hid coil.socket/sync/region/signals/
; cancellation, so the build and the gates set COIL_STRICT_BUNDLE=1 to make the
; fallback a hard error instead of an invisible success.
(defn strict-bundle? [(a (dyn Allocator))] (-> bool)
  (let [p (getenv (str->cstr a "COIL_STRICT_BUNDLE"))]
    (if (= (primitive/cast i64 p) (primitive/cast i64 0))
        false
        (not (= (cstr->slice p) "0")))))

; Namespace imports deliberately do not encode storage layout. Build a source index
; once per compiler run by scanning the project roots, reading only enough of each
; .coil file to obtain its declared `(module …)` identity. COIL_NAMESPACE_ROOTS is
; a colon-separated list installed by project mode; direct-file mode indexes the
; process working directory, which makes the entry file's location irrelevant.
(defn namespace-index-add! [(s (mut LS)) (name (slice u8)) (path (slice u8))] (-> i64)
  (let [names (field s namespace_names)
        paths (field s namespace_paths)
        n (al-len [(slice u8)] (load names))
        (mut seen) false
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (when (and (= (al-get [(slice u8)] (load names) (load i)) name)
                           (= (al-get [(slice u8)] (load paths) (load i)) path))
                  (store! seen true)
                  (break))
                (set! i (primitive/iadd (load i) 1)))))
    (unless (load seen)
      (al-push! (mut (field s namespace_names)) name)
      (al-push! (mut (field s namespace_paths)) path)
      0))
  0)

; Read only the lexical module header. Namespace discovery must not invoke read-all:
; doing so after the entry file is parsed mutates reader-global node identities and
; can corrupt later staged-macro bookkeeping. Comments and blank lines may precede
; the declaration; imported files already require it to be the first real form.
(defn namespace-declared-module [(text (slice u8))] (-> (Option (slice u8)))
  (let [n (slice-len text)
        (mut i) 0
        (mut comment) false
        (mut out) (None [(slice u8)])]
    (loop (if (>= (load i) n)
              (break)
              (let [c (primitive/cast i64 (slice-get text (load i)))]
                (cond (= c (primitive/cast i64 10))
                        (do
                          (store! comment false)
                          (store! i (primitive/iadd (load i) 1))
                          0)
                      (load comment) (store! i (primitive/iadd (load i) 1))
                      (= c (primitive/cast i64 59))
                        (do
                          (store! comment true)
                          (store! i (primitive/iadd (load i) 1))
                          0)
                      (and (= c (primitive/cast i64 40)) (starts-with (subslice text (load i) n) "(module "))
                        (let [lo (primitive/iadd (load i) 8)
                              (mut hi) (primitive/iadd (load i) 8)]
                          (loop (if (>= (load hi) n)
                                    (break)
                                    (let [d (primitive/cast i64 (slice-get text (load hi)))]
                                      (if (or (= d (primitive/cast i64 41))
                                              (or (= d (primitive/cast i64 32))
                                                  (or (= d (primitive/cast i64 9))
                                                      (or (= d (primitive/cast i64 10)) (= d (primitive/cast i64 13))))))
                                          (break)
                                          (store! hi (primitive/iadd (load hi) 1))))))
                          (when (> (load hi) lo)
                            (store! out (Some (subslice text lo (load hi))))
                            0)
                          (break))
                      :else (store! i (primitive/iadd (load i) 1))))))
    (load out)))

; A reader-independent namespace declaration for guest syntax. Only the first
; physical line is inspected; bytes before the uncommon sentinel are deliberately
; opaque so `;`, `#`, `//`, `--`, and language-specific comment leaders all work.
(defn namespace-header-module [(text (slice u8))] (-> (Option (slice u8)))
  (let [n (slice-len text)
        (mut end) 0
        (mut at) -1
        needle "coil-module:"
        nn (slice-len needle)]
    (loop (if (or (>= (load end) n)
                  (= (primitive/cast i64 (slice-get text (load end))) 10))
              (break)
              (set! end (primitive/iadd (load end) 1))))
    (for [i 0 (load end)]
      (when (and (<= (primitive/iadd i nn) (load end))
                 (= (subslice text i (primitive/iadd i nn)) needle))
        (store! at (primitive/iadd i nn))
        0))
    (if (< (load at) 0)
        (None [(slice u8)])
        (let [(mut lo) (load at)
              (mut hi) (load end)]
          (loop (if (and (< (load lo) (load end))
                         (let [c (primitive/cast i64 (slice-get text (load lo)))]
                           (or (= c 32) (= c 9))))
                    (store! lo (primitive/iadd (load lo) 1))
                    (break)))
          (loop (if (and (> (load hi) (load lo))
                         (let [c (primitive/cast i64 (slice-get text (primitive/isub (load hi) 1)))]
                           (or (= c 32) (or (= c 9) (= c 13)))))
                    (store! hi (primitive/isub (load hi) 1))
                    (break)))
          (if (> (load hi) (load lo))
              (Some (subslice text (load lo) (load hi)))
              (None [(slice u8)]))))))

(defn configured-reader-module [(a (dyn Allocator)) (path (slice u8))] (-> (slice u8))
  (let [p (getenv (str->cstr a "COIL_READERS"))]
    (if (= (primitive/cast i64 p) 0)
        ""
        (let [cfg (cstr->slice p)
              n (slice-len cfg)
              (mut out) ""
              (mut best) 0
              (mut lo) 0]
          (for [i 0 (primitive/iadd n 1)]
            (when (or (= i n) (= (primitive/cast i64 (slice-get cfg i)) 10))
              (let [line (subslice cfg (load lo) i)
                    (mut eq) -1]
                (for [j 0 (slice-len line)]
                  (when (= (primitive/cast i64 (slice-get line j)) 61) (store! eq j) 0))
                (when (> (load eq) 0)
                  (let [ext (subslice line 0 (load eq))
                        pn (slice-len path)
                        en (load eq)]
                    (when (and (> en (load best))
                               (and (>= pn en) (= (subslice path (primitive/isub pn en) pn) ext)))
                      (store! out (subslice line (primitive/iadd (load eq) 1) (slice-len line)))
                      (store! best en)
                      0)))
                (store! lo (primitive/iadd i 1)))
              0))
          (load out)))))

(defn configured-reader-extension [(a (dyn Allocator)) (path (slice u8))] (-> (slice u8))
  (let [p (getenv (str->cstr a "COIL_READERS"))]
    (if (= (primitive/cast i64 p) 0)
        ""
        (let [cfg (cstr->slice p)
              n (slice-len cfg)
              (mut out) ""
              (mut best) 0
              (mut lo) 0]
          (for [i 0 (primitive/iadd n 1)]
            (when (or (= i n) (= (primitive/cast i64 (slice-get cfg i)) 10))
              (let [line (subslice cfg (load lo) i)
                    (mut eq) -1]
                (for [j 0 (slice-len line)]
                  (when (= (primitive/cast i64 (slice-get line j)) 61) (store! eq j) 0))
                (when (> (load eq) 0)
                  (let [ext (subslice line 0 (load eq))
                        pn (slice-len path)
                        en (load eq)]
                    (when (and (> en (load best))
                               (and (>= pn en) (= (subslice path (primitive/isub pn en) pn) ext)))
                      (store! out ext)
                      (store! best en)
                      0)))
                (store! lo (primitive/iadd i 1)))
              0))
          (load out)))))

(defn configured-module-for-path [(a (dyn Allocator)) (path (slice u8))] (-> (Option (slice u8)))
  (let [p (getenv (str->cstr a "COIL_MODULE_MAP"))]
    (if (= (primitive/cast i64 p) 0)
        (None [(slice u8)])
        (let [cfg (cstr->slice p)
              n (slice-len cfg)
              (mut out) (None [(slice u8)])
              (mut lo) 0
              buf
                (primitive/cast (ptr i8)
                                (slice-data (match (alloc-bytes a 4096 1)
                                              (Some [x] x)
                                              (None []
                                                    (do
                                                      (oom-at c"compiler allocation" 4096)
                                                      (alloc/alloc-slice-new (primitive/cast (ptr u8) 0) 0))))))]
          (for [i 0 (primitive/iadd n 1)]
            (when (or (= i n) (= (primitive/cast i64 (slice-get cfg i)) 10))
              (let [line (subslice cfg (load lo) i)
                    (mut eq) -1]
                (for [j 0 (slice-len line)]
                  (when (= (primitive/cast i64 (slice-get line j)) 61) (store! eq j) 0))
                (when (> (load eq) 0)
                  (let [mapped (subslice line (primitive/iadd (load eq) 1) (slice-len line))
                        rr (realpath (str->cstr a mapped) buf)]
                    (when (and (!= (primitive/cast i64 rr) 0) (= (cstr->slice buf) path))
                      (store! out (Some (subslice line 0 (load eq))))
                      0)))
                (store! lo (primitive/iadd i 1)))
              0))
          (load out)))))

(defn ensure-guest-module [(a (dyn Allocator))
                           (forms (ptr (ArrayList Sexp)))
                           (name (slice u8))] (-> (ptr (ArrayList Sexp)))
  (match (declared-module forms)
    (Some [_] forms)
    (None []
          (let [(mut head) (al-new [Sexp] a)
                (mut out) (al-new [Sexp] a)]
            (al-push! [Sexp] (mut head) (mk-sexp (KSym "module") -1 -1))
            (al-push! [Sexp] (mut head) (mk-sexp (KSym name) -1 -1))
            (al-push! [Sexp] (mut out) (mk-sexp (KList (box-al [Sexp] a (load head))) -1 -1))
            (for [i 0 (al-len [Sexp] (load forms))]
              (al-push! [Sexp] (mut out) (al-get [Sexp] (load forms) i))
              0)
            (box-al [Sexp] a (load out))))))

; Conventional fallback for guest files with no header and no explicit mapping:
; package prefix + source-root-relative path, with the suffix removed.
(defn namespace-path-module [(a (dyn Allocator)) (path (slice u8))] (-> (Option (slice u8)))
  (let [pp (getenv (str->cstr a "COIL_PACKAGE_NAME"))
        rp (getenv (str->cstr a "COIL_NAMESPACE_ROOTS"))]
    (if (or (= (primitive/cast i64 pp) 0) (= (primitive/cast i64 rp) 0))
        (None [(slice u8)])
        (let [pkg (cstr->slice pp)
              roots (cstr->slice rp)
              n (slice-len roots)
              (mut answer) (None [(slice u8)])
              (mut lo) 0]
          (for [i 0 (primitive/iadd n 1)]
            (when (or (= i n) (= (primitive/cast i64 (slice-get roots i)) 58))
              (let [root0 (subslice roots (load lo) i)
                    buf
                      (primitive/cast (ptr i8)
                                      (slice-data (match (alloc-bytes a 4096 1)
                                                    (Some [x] x)
                                                    (None []
                                                          (do
                                                            (oom-at c"compiler allocation" 4096)
                                                            (alloc/alloc-slice-new (primitive/cast (ptr u8) 0) 0))))))
                    rr (realpath (str->cstr a root0) buf)
                    root (if (= (primitive/cast i64 rr) 0) root0 (cstr->slice buf))
                    rn (slice-len root)]
                (when (and (> rn 0)
                           (and (starts-with path root)
                                (> (slice-len path) (primitive/iadd rn 1))))
                  (let [rel (subslice path (primitive/iadd rn 1) (slice-len path))
                        stop
                          (primitive/isub (slice-len rel)
                                          (slice-len (configured-reader-extension a path)))
                        (mut b) (sb-new a)]
                    (sb-push-str! (mut b) pkg)
                    (sb-push-byte! (mut b) (primitive/cast u8 46))
                    (for [j 0 stop]
                      (let [c (primitive/cast i64 (slice-get rel j))]
                        (sb-push-byte! (mut b) (primitive/cast u8 (if (= c 47) 46 c))))
                      0)
                    (store! answer (Some (sb-str (load b))))))
                (store! lo (primitive/iadd i 1)))
              0))
          (load answer)))))

; ============================ workspace packages ============================
; `COIL_WORKSPACE_PACKAGES` is the driver's description of the workspace: one line
; per member, `<prefix>[!casefold]=<absolute dir>`. Everything the loader needs to
; know about package boundaries comes from here, which is why no namespace spelling
; is compiled into this file any more.
(defstruct WsPkgBox [(loaded i64) (text (slice u8))])

(defn ws-pkg-box [] (-> (ptr WsPkgBox))
  (primitive/alloc-static WsPkgBox))

(defn ws-packages [] (-> (slice u8))
  (let [b (ws-pkg-box)]
    (when (= (load (field b loaded)) (primitive/cast i64 0))
      (let [a (malloc-allocator)
            p (getenv (str->cstr a "COIL_WORKSPACE_PACKAGES"))]
        (set! (.text b) (if (= (primitive/cast i64 p) (primitive/cast i64 0)) "" (cstr->slice p)))
        (set! (.loaded b) (primitive/cast i64 1))
        0))
    (load (field b text))))

; The prefix half of a line, i.e. up to `=`, with any `!casefold` marker dropped.
(defn ws-line-prefix [(line (slice u8))] (-> (slice u8))
  (let [n (slice-len line)
        (mut stop) n
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (let [c (primitive/cast i64 (slice-get line (load i)))]
                (if (or (= c 61) (= c 33))
                    (do (store! stop (load i)) (break))
                    (set! i (primitive/iadd (load i) 1))))))
    (subslice line 0 (load stop))))

(defn ws-line-dir [(line (slice u8))] (-> (slice u8))
  (let [n (slice-len line)
        (mut at) -1
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (when (= (primitive/cast i64 (slice-get line (load i))) (primitive/cast i64 61))
                  (store! at (load i))
                  (break))
                (set! i (primitive/iadd (load i) 1)))))
    (if (< (load at) 0) "" (subslice line (primitive/iadd (load at) 1) n))))

; The trigger module between `!` and `=`, empty when the package declares none.
(defn ws-line-casefold-ns [(line (slice u8))] (-> (slice u8))
  (let [n (slice-len line)
        (mut bang) -1
        (mut eq) n
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (let [c (primitive/cast i64 (slice-get line (load i)))]
                (when (and (= c 33) (< (load bang) 0)) (store! bang (load i)) 0)
                (when (= c 61) (store! eq (load i)) (break))
                (set! i (primitive/iadd (load i) 1)))))
    (if (< (load bang) 0) "" (subslice line (primitive/iadd (load bang) 1) (load eq)))))

(defn ws-line-casefold? [(line (slice u8))] (-> bool)
  (let [n (slice-len line)
        (mut found) false
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (when (= (primitive/cast i64 (slice-get line (load i))) (primitive/cast i64 33))
                  (store! found true)
                  (break))
                (set! i (primitive/iadd (load i) 1)))))
    (load found)))

; True when `name` sits strictly below `prefix`: the prefix, then a dot, then at
; least one more character. Compared segment-wise, so `experiments.schemer` is NOT
; below `experiments.scheme` -- a plain starts-with would say it is.
(defn ws-below? [(name (slice u8)) (prefix (slice u8))] (-> bool)
  (let [pn (slice-len prefix)
        nn (slice-len name)]
    (and (> nn (primitive/iadd pn 1))
         (and (starts-with name prefix)
              (= (primitive/cast i64 (slice-get name pn)) (primitive/cast i64 46))))))

; The member owning a path, as its line. A member directory is an absolute realpath
; and a file under it starts with `<dir>/`.
(defn ws-line-for-path [(a (dyn Allocator)) (path (slice u8))] (-> (slice u8))
  (let [text (ws-packages)
        n (slice-len text)
        (mut out) ""
        (mut lo) 0
        (mut i) 0]
    (loop (if (> (load i) n)
              (break)
              (if (or (= (load i) n)
                      (= (primitive/cast i64 (slice-get text (load i))) (primitive/cast i64 10)))
                  (do
                    (when (> (load i) (load lo))
                      (let [line (subslice text (load lo) (load i))
                            dir (ws-line-dir line)]
                        (when (and (> (slice-len dir) (primitive/cast i64 0))
                                   (starts-with path (sconcat a dir "/")))
                          (store! out line)
                          0)))
                    (store! lo (primitive/iadd (load i) 1))
                    (set! i (primitive/iadd (load i) 1))
                    0)
                  (set! i (primitive/iadd (load i) 1)))))
    (load out)))

; Does an imported namespace belong to a member that case-folds its importers?
(defn ws-casefold-import? [(ns (slice u8))] (-> bool)
  (let [text (ws-packages)
        n (slice-len text)
        (mut yes) false
        (mut lo) 0
        (mut i) 0]
    (loop (if (> (load i) n)
              (break)
              (if (or (= (load i) n)
                      (= (primitive/cast i64 (slice-get text (load i))) (primitive/cast i64 10)))
                  (do
                    (when (> (load i) (load lo))
                      (let [line (subslice text (load lo) (load i))]
                        ; Exactly the declared module. A file that imports a SIBLING of
                        ; that module -- which is what every implementation file in the
                        ; package does -- is ordinary Coil and must not be folded.
                        (when (= ns (ws-line-casefold-ns line))
                          (store! yes true)
                          0)))
                    (store! lo (primitive/iadd (load i) 1))
                    (set! i (primitive/iadd (load i) 1))
                    0)
                  (set! i (primitive/iadd (load i) 1)))))
    (load yes)))

; THE workspace rule: a module in a member package is that package's name plus at
; least one more segment. Checked here because this is the one place every file in
; the workspace is opened and its declaration read, so a stray module is reported
; once, by path, rather than as a resolution failure somewhere downstream.
(defn ws-check-module! [(s (mut LS)) (path (slice u8)) (name (slice u8))] (-> i64)
  (let [a (load (field s a))
        line (ws-line-for-path a path)]
    (when (> (slice-len line) (primitive/cast i64 0))
      (let [pre (ws-line-prefix line)]
        (unless (ws-below? name pre)
          (ls-set-err! (mut s)
                       (derr (sconcat a
                                      "module '"
                                      (sconcat a
                                               name
                                               (sconcat3 a
                                                         "' in "
                                                         path
                                                         (sconcat a
                                                                  " must be named '"
                                                                  (sconcat3 a
                                                                            pre
                                                                            ".<name>' — every module in a package begins with the package name and adds at least one segment"
                                                                            "")))))))
          0)))
    0))

(defn namespace-index-file! [(s (mut LS))
                             (path (slice u8))] (-> i64)
  ; namespace-index-roots! canonicalizes each root once. The recursive walk
  ; ignores symlinks, so a regular file reached by joining names below that root
  ; is already canonical. Calling realpath here made macOS rediscover the cwd for
  ; every source file in the tree.
  (let [a (load (field s a))]
      (let [canon (sconcat a path "")
            text (read-file a (str->cstr a path))]
        ; A module declaration may follow an arbitrarily long license/design
        ; comment. Reading only the first 4 KiB silently omitted valid modules.
        (match (match (configured-module-for-path a canon)
                 (Some [m] (Some m))
                 (None []
                       (if (> (slice-len (configured-reader-module a canon)) 0)
                           (match (namespace-header-module text)
                             (Some [m] (Some m))
                             (None [] (namespace-path-module a canon)))
                           (namespace-declared-module text))))
          (Some [m]
                (do
                  (ws-check-module! (mut s) canon (sconcat a m ""))
                  (namespace-index-add! (mut s) (sconcat a m "") canon)))
          (None [] 0))))
  0)

(defn namespace-index-dir! [(s (mut LS))
                            (dir (slice u8))] (-> i64)
  (let [a (load (field s a))
        stream (opendir (str->cstr a dir))]
    (unless (= (primitive/cast i64 stream) (primitive/cast i64 0))
      (loop (let [entry (readdir stream)]
              (if (= (primitive/cast i64 entry) (primitive/cast i64 0))
                  (break)
                  (let [namep (primitive/index entry DIRENT-NAME-OFFSET)
                        name (cstr->slice namep)
                        n (slice-len name)
                        kind (primitive/cast i64 (load (primitive/index entry DIRENT-TYPE-OFFSET)))]
                    ; Do not descend into hidden directories or follow symlinks.
                    ; Guest files are considered only when their suffix has a
                    ; manifest reader; without a header an explicit [modules]
                    ; entry (or the path fallback) supplies their identity.
                    (unless (or (= name ".") (= name ".."))
                      (let [path (path-join a dir name)]
                        (if (= kind DT-DIR)
                            (unless (and (> n 0)
                                         (= (primitive/cast i64 (slice-get name 0)) 46))
                              (namespace-index-dir! (mut s) path)
                              0)
                            (when (and (= kind DT-REG)
                                       (or (and (>= n 5)
                                                (= (subslice name (primitive/isub n 5) n) ".coil"))
                                           (> (slice-len (configured-reader-module a path)) 0)))
                              (namespace-index-file! (mut s) path)
                              0))))))))
      (closedir stream)
      0))
  0)

(defn namespace-index-roots! [(s (mut LS))
                              (roots (slice u8))] (-> i64)
  (let [(mut lo) 0
        (mut i) 0
        n (slice-len roots)
        a (load (field s a))
        (mut seen) (al-new [(slice u8)] a)]
    (loop (if (> (load i) n)
              (break)
              (if (or (= (load i) n)
                      (= (primitive/cast i64 (slice-get roots (load i))) 58))
                  (do
                    (when (> (load i) (load lo))
                      (let [spelled (subslice roots (load lo) (load i))
                            root (match (realpath-opt a spelled)
                                   (Some [canonical] canonical)
                                   (None [] spelled))
                            (mut duplicate) false
                            (mut si) 0]
                        (loop (if (>= (load si) (al-len [(slice u8)] (load seen)))
                                  (break)
                                  (if (= (al-get [(slice u8)] (load seen) (load si)) root)
                                      (do (store! duplicate true) (break))
                                      (store! si (primitive/iadd (load si) 1)))))
                        (unless (load duplicate)
                          (al-push! (mut seen) (sconcat a root ""))
                          (namespace-index-dir! (mut s) root)
                          0))
                      0)
                    (store! lo (primitive/iadd (load i) 1))
                    (set! i (primitive/iadd (load i) 1))
                    0)
                  (set! i (primitive/iadd (load i) 1)))))
    0))

(defn namespace-index-build! [(s (mut LS))] (-> i64)
  (let [a (load (field s a))
        roots-p (getenv (str->cstr a "COIL_NAMESPACE_ROOTS"))
        entry-name (.name (al-elem [Source] (field s sources) 0))
        unconfigured? (= (primitive/cast i64 roots-p) (primitive/cast i64 0))
        configured (if unconfigured? (cwd-slice a) (cstr->slice roots-p))
        ; Project mode has already supplied every source/dependency root. Appending
        ; the entry directory is both outside that ownership boundary and disastrous
        ; for compiler-generated entries in /tmp: lint's tiny synthetic root caused
        ; the indexer to retain paths for every file below the system temp directory.
        ; Direct-file mode still needs both cwd and the entry tree so a file launched
        ; from an unrelated directory can resolve its sibling modules.
        roots
          (if unconfigured?
              (sconcat3 a configured ":" (dirname entry-name))
              configured)
        path-buf
          (primitive/cast (ptr i8)
                          (slice-data (match (alloc-bytes a 4096 1)
                                        (Some [buf] buf)
                                        (None []
                                              (do
                                                (oom-at c"compiler allocation" 4096)
                                                (alloc/alloc-slice-new (primitive/cast (ptr u8) 0) 0))))))]
    (namespace-index-roots! (mut s) roots)
    (let [mp (getenv (str->cstr a "COIL_MODULE_MAP"))]
      (unless (= (primitive/cast i64 mp) 0)
        (let [cfg (cstr->slice mp)
              n (slice-len cfg)
              (mut lo) 0]
          (for [i 0 (primitive/iadd n 1)]
            (when (or (= i n) (= (primitive/cast i64 (slice-get cfg i)) 10))
              (let [line (subslice cfg (load lo) i)
                    (mut eq) -1]
                (for [j 0 (slice-len line)]
                  (when (= (primitive/cast i64 (slice-get line j)) 61) (store! eq j) 0))
                (when (> (load eq) 0)
                  (let [name (subslice line 0 (load eq))
                        rel (subslice line (primitive/iadd (load eq) 1) (slice-len line))
                        rp (realpath (str->cstr a rel) path-buf)]
                    (if (= (primitive/cast i64 rp) 0)
                        (ls-set-err! (mut s)
                                     (derr (sconcat3 a
                                                     "[modules] namespace '"
                                                     name
                                                     "' points to a file that does not exist")))
                        (namespace-index-add! (mut s) (sconcat a name "") (sconcat a (cstr->slice path-buf) "")))))
                (store! lo (primitive/iadd i 1)))
              0)))))
    0))

(defn namespace-path [(a (dyn Allocator)) (s (mut LS)) (form (ptr Sexp)) (name (slice u8))] (-> (Option (slice u8)))
  (let [names (field s namespace_names)
        paths (field s namespace_paths)
        n (al-len [(slice u8)] (load names))
        (mut found) ""
        (mut count) 0
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (when (= (al-get [(slice u8)] (load names) (load i)) name)
                  (store! count (primitive/iadd (load count) 1))
                  (when (= (load count) (primitive/cast i64 1))
                    (store! found (al-get [(slice u8)] (load paths) (load i)))
                    0)
                  0)
                (set! i (primitive/iadd (load i) 1)))))
    (if (> (load count) (primitive/cast i64 1))
        (do
          (ls-set-err! (mut s)
                       (diag-at-form form
                                     (sconcat3 a
                                               "namespace '"
                                               (sconcat3 a
                                                         name
                                                         "' is declared by multiple source files (namespace identities must be unique)"
                                                         "")
                                               "")))
          (None [(slice u8)]))
        (if (= (load count) (primitive/cast i64 1)) (Some (load found)) (None [(slice u8)])))))

; Legacy dependency-path resolution is retained only for the syntax-preflight
; migration lint. Normal loading uses COIL_NAMESPACE_ROOTS and never calls this.
(defn dep-slash [(path (slice u8))] (-> i64)
  (let [n (slice-len path)
        (mut i) 0
        (mut found) -1]
    (loop (if (>= (load i) n)
              (break)
              (if (= (primitive/cast i64 (slice-get path (load i))) (primitive/cast i64 47))
                  (do (set! found (load i)) (break))
                  (set! i (primitive/iadd (load i) 1)))))
    (load found)))

(defn dep-path-contained? [(root (slice u8)) (path (slice u8))] (-> bool)
  (let [rn (slice-len root)
        pn (slice-len path)
        (mut i) 0
        (mut same) (>= pn rn)]
    (loop (if (or (not (load same)) (>= (load i) rn))
              (break)
              (if (= (slice-get root (load i)) (slice-get path (load i)))
                  (set! i (primitive/iadd (load i) 1))
                  (set! same false))))
    (and (load same)
         (or (= pn rn)
             (and (> pn rn)
                  (or (and (= rn (primitive/cast i64 1))
                           (= (primitive/cast i64 (slice-get root 0)) (primitive/cast i64 47)))
                      (= (primitive/cast i64 (slice-get path rn)) (primitive/cast i64 47))))))))

(defn resolve-dependency [(a (dyn Allocator)) (path (slice u8))] (-> (Option Resolved))
  (let [slash (dep-slash path)]
    (if (<= slash (primitive/cast i64 0))
        (None [Resolved])
        (let [name (subslice path 0 slash)
              rel (subslice path (primitive/iadd slash 1) (slice-len path))
              envname (sconcat a "COIL_DEP_" name)
              ep (getenv (str->cstr a envname))]
          (if (= (primitive/cast i64 ep) (primitive/cast i64 0))
              (None [Resolved])
              (let [root (cstr->slice ep)
                    candidate (path-join a root rel)
                    buf
                      (primitive/cast (ptr i8)
                                      (slice-data (match (alloc-bytes a 4096 1)
                                                    (Some [s] s)
                                                    (None []
                                                          (do
                                                            (oom-at c"compiler allocation" 4096)
                                                            (alloc/alloc-slice-new (primitive/cast (ptr u8) 0) 0))))))
                    r (realpath (str->cstr a candidate) buf)]
                (if (= (primitive/cast i64 r) (primitive/cast i64 0))
                    (None [Resolved])
                    (let [canon (cstr->slice buf)]
                      (if (not (dep-path-contained? root canon))
                          (None [Resolved])
                          (let [rp (primitive/alloc-stack Resolved)]
                            (set! (.text rp) (read-file a buf))
                            (set! (.incdir rp) (dirname canon))
                            (set! (.disp rp) canon)
                            (Some (load rp))))))))))))

(defn resolve-source [(a (dyn Allocator)) (s (mut LS)) (form (ptr Sexp)) (base (slice u8)) (name (slice u8))] (-> Resolved)
  (let [nn (slice-len name)
        legacy
          (or (>= (dep-slash name) (primitive/cast i64 0))
              (and (>= nn (primitive/cast i64 5)) (= (subslice name (primitive/isub nn 5) nn) ".coil")))
        stdmapped (stdlib-file-for-namespace name)
        sdkmapped (sdk-file-for-namespace name)
        profile-forbidden
          (and (not (= base (bundled-base)))
               (and (= (stdlib-profile a) "hermetic")
                    (and (> (slice-len stdmapped) (primitive/cast i64 0))
                         (not (stdlib-hermetic-namespace? name)))))
        mapped
          (if (bundled-stdlib-enabled? a)
              (if profile-forbidden
                  ""
                  (if (> (slice-len stdmapped) 0) stdmapped sdkmapped))
              "")
        ; Transitional compatibility is confined to compiler-owned embedded text.
        ; User source never has the <bundled> base and therefore cannot import a
        ; filename, relative or otherwise.
        bn
          (if (and (= (slice-len mapped) (primitive/cast i64 0)) (and (= base (bundled-base)) (bundled? name)))
              name
              mapped)]
    (if (and legacy (not (= base (bundled-base))))
        (do
          (ls-set-err! (mut s)
                       (diag-at-form form
                                     "import paths are not supported; import the target's declared namespace (run `coil lint --fix` to migrate legacy imports)"))
          (primitive/zeroed Resolved))
        (if profile-forbidden
            (do
              (ls-set-err! (mut s)
                           (diag-at-form form
                                         (sconcat3 a
                                                   "namespace '"
                                                   name
                                                   "' is unavailable under stdlib profile 'hermetic'")))
              (primitive/zeroed Resolved))
            (if (> (slice-len bn) (primitive/cast i64 0))
            (let [rp (primitive/alloc-stack Resolved)]
              (set! (.text rp) (bundled-text a bn))
              ; Keep a real directory for include-str while namespace imports
              ; continue to resolve through the two generated manifests.
              (set! (.incdir rp)
                    (if (starts-with bn "compiler/")
                        (.sdk (stdlib-layout a))
                        (.libs (stdlib-layout a))))
              (set! (.disp rp) (sconcat3 a "<bundled " bn ">"))
              (load rp))
            (match (namespace-path a (mut s) form name)
              (Some [path]
                    (if (and (bundled-stdlib-enabled? a)
                             (and (strict-bundle? a) (starts-with name "coil.")))
                        (do
                          (ls-set-err! (mut s)
                                       (diag-at-form form
                                                     (sconcat3 a
                                                               "namespace '"
                                                               name
                                                               "' is missing from the bundled stdlib manifest — it resolved only from the source tree, so an installed compiler could not import it; regenerate with scripts/compiler/gen-stdlib-manifest.py")))
                          (primitive/zeroed Resolved))
                        (let [buf
                                (primitive/cast (ptr i8)
                                                (slice-data (match (alloc-bytes a 4096 1)
                                                              (Some [s] s)
                                                              (None []
                                                                    (do
                                                                      (oom-at c"compiler allocation" 4096)
                                                                      (alloc/alloc-slice-new (primitive/cast (ptr u8) 0)
                                                                                             0))))))
                              r (realpath (str->cstr a path) buf)
                              rp (primitive/alloc-stack Resolved)]
                          (if (= (primitive/cast i64 r) (primitive/cast i64 0))
                              (do
                                (ls-set-err! (mut s)
                                             (diag-at-form form
                                                           (sconcat3 a
                                                                     "namespace '"
                                                                     name
                                                                     "' points to a source file that no longer exists")))
                                (primitive/zeroed Resolved))
                              (let [canon (cstr->slice buf)]
                                (set! (.text rp) (read-file a buf))
                                (set! (.incdir rp) (dirname canon))
                                (set! (.disp rp) canon)
                                (load rp))))))
              (None []
                    (do
                      (unless (ls-err? (mut s))
                        (ls-set-err! (mut s)
                                     (diag-at-form form
                                                   (sconcat3 a
                                                             "namespace '"
                                                             name
                                                             (if (bundled-stdlib-enabled? a)
                                                                 "' was not found in the project, its dependencies, or the bundled standard library"
                                                                 "' was not found in the no-stdlib compilation universe"))))
                        0)
                      (primitive/zeroed Resolved)))))))))

(defn l-as-list [(f (ptr Sexp))] (-> (ptr (ArrayList Sexp)))
  (match (.kind f)
    (KList [items] items)
    (KInt [_] (do (loader-abort "expected a list") (box-items (malloc-allocator) (al-new [Sexp] (malloc-allocator)))))
    (KFloat [_] (do (loader-abort "expected a list") (box-items (malloc-allocator) (al-new [Sexp] (malloc-allocator)))))
    (KSym [_] (do (loader-abort "expected a list") (box-items (malloc-allocator) (al-new [Sexp] (malloc-allocator)))))
    (KKw [_] (do (loader-abort "expected a list") (box-items (malloc-allocator) (al-new [Sexp] (malloc-allocator)))))
    (KStr [_] (do (loader-abort "expected a list") (box-items (malloc-allocator) (al-new [Sexp] (malloc-allocator)))))
    (KCStr [_] (do (loader-abort "expected a list") (box-items (malloc-allocator) (al-new [Sexp] (malloc-allocator)))))
    (KVec [_] (do (loader-abort "expected a list") (box-items (malloc-allocator) (al-new [Sexp] (malloc-allocator)))))
    (KView [_ _ _]
           (do (loader-abort "expected a list") (box-items (malloc-allocator) (al-new [Sexp] (malloc-allocator)))))))

(defn l-sym-name [(f (ptr Sexp))] (-> (Option (slice u8)))
  (match (.kind f)
    (KSym [s] (Some s))
    (KInt [_] (None [(slice u8)]))
    (KFloat [_] (None [(slice u8)]))
    (KKw [_] (None [(slice u8)]))
    (KStr [_] (None [(slice u8)]))
    (KCStr [_] (None [(slice u8)]))
    (KList [_] (None [(slice u8)]))
    (KVec [_] (None [(slice u8)]))
    (KView [_ _ _] (None [(slice u8)]))))

(defn l-list-head [(f (ptr Sexp))] (-> (Option (slice u8)))
  (match (.kind f)
    (KList [items]
           (if (> (al-len [Sexp] (load items)) (primitive/cast i64 0))
               (let [h (primitive/alloc-stack Sexp)] (set! h (al-get [Sexp] (load items) 0)) (l-sym-name h))
               (None [(slice u8)])))
    (KInt [_] (None [(slice u8)]))
    (KFloat [_] (None [(slice u8)]))
    (KSym [_] (None [(slice u8)]))
    (KKw [_] (None [(slice u8)]))
    (KStr [_] (None [(slice u8)]))
    (KCStr [_] (None [(slice u8)]))
    (KVec [_] (None [(slice u8)]))
    (KView [_ _ _] (None [(slice u8)]))))

(defn l-as-str [(f (ptr Sexp))] (-> (Option (slice u8)))
  (match (.kind f)
    (KStr [s] (Some s))
    (KInt [_] (None [(slice u8)]))
    (KFloat [_] (None [(slice u8)]))
    (KSym [_] (None [(slice u8)]))
    (KKw [_] (None [(slice u8)]))
    (KCStr [_] (None [(slice u8)]))
    (KList [_] (None [(slice u8)]))
    (KVec [_] (None [(slice u8)]))
    (KView [_ _ _] (None [(slice u8)]))))

(defn module-name [(f (ptr Sexp))] (-> (slice u8))
  (let [items (l-as-list f)
        n (al-len [Sexp] (load items))]
    (if (< n (primitive/cast i64 2))
        (do (loader-abort "module: expected a name") "")
        (let [it (primitive/alloc-stack Sexp)]
          (set! it (al-get [Sexp] (load items) 1))
          (match (l-sym-name it)
            (Some [x] x)
            (None [] (do (loader-abort "module: expected a name") "")))))))

(defn declared-module [(forms (ptr (ArrayList Sexp)))] (-> (Option (slice u8)))
  (let [n (al-len [Sexp] (load forms))
        (mut res) (None [(slice u8)])
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (let [f (primitive/alloc-stack Sexp)]
                  (set! f (al-get [Sexp] (load forms) (load i)))
                  (match (l-list-head f)
                    (Some [h] (when (= h "module") (store! res (Some (module-name f))) (break)))
                    (None [] 0)))
                (set! i (primitive/iadd (load i) 1)))))
    (load res)))

;; A source opts into case-insensitive identifiers by importing a package whose
;; manifest declares `[package] casefold = "ascii"`. Detect that on the pristine
;; reader tree, then normalize before loader tables, macro indexes, or hygiene
;; contexts observe identifiers.
;;
;; This used to test for a literal `(import "coil.scheme" ...)`: one dialect's
;; namespace, compiled into the compiler. The trigger is now a property a package
;; declares about itself, so a case-insensitive language can live in any workspace
;; under any name.
(defn loader-casefolding-source? [(forms (ptr (ArrayList Sexp)))] (-> bool)
  (let [n (al-len [Sexp] (load forms))
        (mut found) false]
    (for [i 0 n]
      (let [f (al-elem [Sexp] forms i)]
        (if (and (sexp-list? f)
                 (and (>= (sexp-count f) 2)
                      (and (sexp-sym-is (sexp-nth f 0) "import")
                           (match (load (field (sexp-nth f 1) kind))
                             (KStr [s] (ws-casefold-import? s))
                             (_ false)))))
            (store! found true)
            0)))
    (load found)))

(defn loader-ascii-casefold! [(a (dyn Allocator)) (x (ptr Sexp))] (-> i64)
  (match (.kind x)
    (KSym [s]
          (let [n (slice-len [u8] s)]
            (if (and (= n 3)
                     (and (= (primitive/cast i64 (slice-get [u8] s 0)) 35)
                          (= (primitive/cast i64 (slice-get [u8] s 1)) 92)))
                0
                ;; Keep the original slice identity as well as the syntax-node
                ;; identity: loader indexes may already retain views into this source
                ;; buffer. The source storage is owned and mutable for the compilation.
                (for [i 0 n]
                  (let [c (primitive/cast i64 (slice-get [u8] s i))]
                    (if (and (>= c 65) (<= c 90))
                        (slice-set! [u8] s i (primitive/cast u8 (+ c 32)))
                        0))))))
    (KList [items]
           (let [n (al-len [Sexp] (load items))]
             (for [i 0 n] (loader-ascii-casefold! a (al-elem [Sexp] items i)))))
    (KVec [items]
          (let [n (al-len [Sexp] (load items))]
            (for [i 0 n] (loader-ascii-casefold! a (al-elem [Sexp] items i)))))
    (_ 0)))

(defn loader-fold-source-node! [(src (slice u8)) (x (ptr Sexp))] (-> i64)
  (match (.kind x)
    (KSym [s]
          (let [lo (.lo x)
                hi (.hi x)]
            (if (and (= (- hi lo) 3)
                     (and (= (primitive/cast i64 (slice-get [u8] src lo)) 35)
                          (= (primitive/cast i64 (slice-get [u8] src (+ lo 1))) 92)))
                0
                (for [i lo hi]
                  (let [c (primitive/cast i64 (slice-get [u8] src i))]
                    (if (and (>= c 65) (<= c 90))
                        (slice-set! [u8] src i (primitive/cast u8 (+ c 32)))
                        0))))))
    (KList [items]
           (let [n (al-len [Sexp] (load items))]
             (for [i 0 n] (loader-fold-source-node! src (al-elem [Sexp] items i)))))
    (KVec [items]
          (let [n (al-len [Sexp] (load items))]
            (for [i 0 n] (loader-fold-source-node! src (al-elem [Sexp] items i)))))
    (_ 0)))

(defn loader-casefold-source! [(src (slice u8)) (forms (ptr (ArrayList Sexp)))] (-> i64)
  (if (not (loader-casefolding-source? forms))
      0
      (let [n (al-len [Sexp] (load forms))]
        (for [i 0 n]
          (let [f (al-elem [Sexp] forms i)]
            (if (and (sexp-list? f)
                     (and (> (sexp-count f) 0)
                          (sexp-sym-is (sexp-nth f 0) "module")))
                0
                (loader-fold-source-node! src f)))))))

(defn loader-casefold-scheme! [(a (dyn Allocator)) (forms (ptr (ArrayList Sexp)))] (-> i64)
  (if (not (loader-casefolding-source? forms))
      0
      (let [n (al-len [Sexp] (load forms))]
        (for [i 0 n]
          (let [f (al-elem [Sexp] forms i)]
            ;; Preserve the namespace spelling in `(module NAME)`; it belongs to
            ;; Coil's module system, while all Scheme program identifiers fold.
            (if (and (sexp-list? f)
                     (and (>= (sexp-count f) 1)
                          (sexp-sym-is (sexp-nth f 0) "module")))
                0
                (loader-ascii-casefold! a f)))))))

(defn collect-syms [(a (dyn Allocator)) (items (ptr (ArrayList Sexp)))] (-> (ptr (ArrayList (slice u8))))
  (let [n (al-len [Sexp] (load items))
        (mut out) (al-new [(slice u8)] a)
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (let [it (primitive/alloc-stack Sexp)]
                  (set! it (al-get [Sexp] (load items) (load i)))
                  (match (l-sym-name it) (Some [nm] (al-push! (mut out) nm)) (None [] 0)))
                (set! i (primitive/iadd (load i) 1)))))
    (box! a (ArrayList (slice u8)) (load out))))

; `:rename [[from to] …]` — a vector of two-symbol vectors. Pairs rather than a map
; literal because the reader has no `{}` form.
(defn collect-renames [(a (dyn Allocator)) (items (ptr (ArrayList Sexp)))] (-> (ptr (ArrayList Rename)))
  (let [n (al-len [Sexp] (load items))
        (mut out) (al-new [Rename] a)
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (let [it (primitive/alloc-stack Sexp)]
                  (set! it (al-get [Sexp] (load items) (load i)))
                  (match (.kind it)
                    (KVec [pair]
                          (let [syms (collect-syms a pair)]
                            (if (!= (al-len [(slice u8)] (load syms)) (primitive/cast i64 2))
                                (loader-abort "import: :rename expects [[from to] …] — each entry is exactly two symbols")
                                (let [rp (primitive/alloc-stack Rename)]
                                  (set! (.from rp) (al-get [(slice u8)] (load syms) 0))
                                  (set! (.to rp) (al-get [(slice u8)] (load syms) 1))
                                  (al-push! (mut out) (load rp))))))
                    (_ (loader-abort "import: :rename expects [[from to] …] — each entry is a two-symbol vector"))))
                (set! i (primitive/iadd (load i) 1)))))
    (box! a (ArrayList Rename) (load out))))

(defn imp-elem [(s (mut LS)) (i i64)] (-> (ptr ImpEntry))
  (let [hdr (primitive/alloc-stack (ArrayList ImpEntry))]
    (set! hdr (.imports s))
    (primitive/index (load (field hdr data)) i)))

(defn exp-elem [(s (mut LS)) (i i64)] (-> (ptr ExpEntry))
  (let [hdr (primitive/alloc-stack (ArrayList ExpEntry))]
    (set! hdr (.exports s))
    (primitive/index (load (field hdr data)) i)))

(defn imp-entry [(s (mut LS)) (name (slice u8))] (-> (ptr ImpEntry))
  (let [n (al-len [ImpEntry] (.imports s))
        (mut idx) -1
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (when (= (load (field (imp-elem (mut s) (load i)) name)) name)
                  (store! idx (load i))
                  (break))
                (set! i (primitive/iadd (load i) 1)))))
    (if (>= (load idx) (primitive/cast i64 0))
        (imp-elem (mut s) (load idx))
        (let [e (primitive/alloc-stack ImpEntry)
              a (load (field s a))]
          (set! (.name e) name)
          (set! (.aliases (.imp e)) (al-new [Alias] a))
          (set! (.uses (.imp e)) (al-new [Use] a))
          (set! (.reexports (.imp e)) (al-new [(slice u8)] a))
          (set! (.forms (.imp e)) (al-new [Sexp] a))
          ; the implicit `(import "coil.core" :use *)` every module starts with
          (set! (.core (.imp e))
                (mk-use a
                        (implicit-prelude-name a)
                        (UAll)
                        (primitive/cast (ptr (ArrayList (slice u8))) 0)
                        (primitive/cast (ptr (ArrayList Rename)) 0)))
          (set! (.core_set (.imp e)) false)
          (al-push! (mut (.imports s)) (load e))
          (imp-elem (mut s) n)))))

(defn exp-entry [(s (mut LS)) (name (slice u8))] (-> (ptr ExpEntry))
  (let [n (al-len [ExpEntry] (.exports s))
        (mut idx) -1
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (when (= (load (field (exp-elem (mut s) (load i)) name)) name)
                  (store! idx (load i))
                  (break))
                (set! i (primitive/iadd (load i) 1)))))
    (if (>= (load idx) (primitive/cast i64 0))
        (exp-elem (mut s) (load idx))
        (let [e (primitive/alloc-stack ExpEntry)
              a (load (field s a))]
          (set! (.name e) name)
          (set! (.names e) (al-new [(slice u8)] a))
          (set! (.forms e) (al-new [Sexp] a))
          (al-push! (mut (.exports s)) (load e))
          (exp-elem (mut s) n)))))

(defn ee-add-name! [(e (ptr ExpEntry)) (name (slice u8))] (-> i64)
  (let [n (al-len [(slice u8)] (.names e))
        (mut found) false
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (when (= (al-get [(slice u8)] (load (field e names)) (load i)) name)
                  (store! found true)
                  (break))
                (set! i (primitive/iadd (load i) 1)))))
    (unless (load found) (al-push! (mut (field e names)) name))))

(defn mi-add-alias! [(e (ptr ImpEntry)) (alias (slice u8)) (target (slice u8))] (-> i64)
  (let [n (al-len [Alias] (.aliases (.imp e)))
        (mut idx) -1
        (mut i) 0
        v
          (let [ap (primitive/alloc-stack Alias)]
            (set! (.alias ap) alias)
            (set! (.target ap) target)
            (load ap))]
    (loop (if (>= (load i) n)
              (break)
              (do
                (when (= (let [ep (primitive/alloc-stack Alias)]
                           (store! ep
                                   (al-get [Alias]
                                           (load (field (field e imp) aliases))
                                           (load i)))
                           (load (field ep alias)))
                         alias)
                  (store! idx (load i))
                  (break))
                (set! i (primitive/iadd (load i) 1)))))
    (if (>= (load idx) (primitive/cast i64 0))
        (al-set! [Alias] (mut (.aliases (.imp e))) (load idx) v)
        (al-push! (mut (.aliases (.imp e))) v))))

(defn mi-add-use! [(a (dyn Allocator))
                   (e (ptr ImpEntry))
                   (target (slice u8))
                   (spec UseSpec)
                   (exclude (ptr (ArrayList (slice u8))))
                   (renames (ptr (ArrayList Rename)))] (-> i64)
  (al-push! (mut (.uses (.imp e))) (mk-use a target spec exclude renames)))

; An explicit `(import "coil.core" …)` REPLACES the implicit refer-all rather than adding
; to it — Clojure's `:refer-clojure` rule. Recording it into the dedicated `core` slot
; (not into `uses`) is what keeps core the lowest-precedence tier: an explicitly `:use`d
; module still shadows core, exactly as before this existed.
(defn mi-set-core! [(a (dyn Allocator))
                    (e (ptr ImpEntry))
                    (spec UseSpec)
                    (exclude (ptr (ArrayList (slice u8))))
                    (renames (ptr (ArrayList Rename)))] (-> i64)
  (set! (.core (.imp e)) (mk-use a (implicit-prelude-name a) spec exclude renames))
  (set! (.core_set (.imp e)) true)
  0)

(defn mi-add-reexport! [(e (ptr ImpEntry)) (target (slice u8))] (-> i64)
  (al-push! (mut (.reexports (.imp e))) target))

(defn loaded-insert! [(s (mut LS)) (name (slice u8))] (-> bool)
  (let [n (al-len [(slice u8)] (.loaded s))
        (mut found) false
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (when (= (al-get [(slice u8)] (load (field s loaded)) (load i)) name)
                  (store! found true)
                  (break))
                (set! i (primitive/iadd (load i) 1)))))
    (if (load found) false (do (al-push! (mut (.loaded s)) name) true))))

; A module imported by K modules was READ FROM DISK and fully RE-PARSED K times. The
; already-loaded test above keys on the module NAME, which is only known after parsing,
; so it could skip the recursive descent but never the work of reaching it. On this
; compiler that is 540 imports across 65 files: eight times the file I/O and lexing, and
; 540 entries in the source table where 65 would do.
;
; Keyed on the RESOLVED PATH — which `resolve-source` produces before anything is read —
; each file is read and parsed exactly once. The per-import bookkeeping (alias, :use
; spec, :reexport) still runs for EVERY import; only the reading is shared, so what any
; one importer sees is unchanged.
(defn read-memo-find [(s (mut LS)) (p (slice u8))] (-> (Option (slice u8)))
  (let [n (al-len [(slice u8)] (.readpaths s))
        (mut i) 0
        (mut r) (None [(slice u8)])]
    (loop (if (>= (load i) n)
              (break)
              (do
                (when (= (al-get [(slice u8)] (load (field s readpaths)) (load i)) p)
                  (store! r
                          (Some (al-get [(slice u8)]
                                        (load (field s readmods))
                                        (load i))))
                  (break))
                (set! i (primitive/iadd (load i) 1)))))
    (load r)))

(defn read-memo-add! [(s (mut LS)) (p (slice u8)) (m (slice u8))] (-> i64)
  (al-push! (mut (.readpaths s)) p)
  (al-push! (mut (.readmods s)) m)
  0)

; The bookkeeping an import performs on its IMPORTER, which is per-import and therefore
; runs whether or not the file itself had to be read.
(defn import-record! [(s (mut LS))
                      (cur (Option (slice u8)))
                      (alias (Option (slice u8)))
                      (use-spec (Option UseSpec))
                      (reexport bool)
                      (exclude (ptr (ArrayList (slice u8))))
                      (renames (ptr (ArrayList Rename)))
                      (modname (slice u8))] (-> i64)
  (let [a (load (field s a))
        importer (match cur (Some [m] m) (None [] ""))
        imp (imp-entry (mut s) importer)
        alias-name (match alias (Some [al] al) (None [] modname))]
    (mi-add-alias! imp alias-name modname)
    ; `coil.core` is already referred implicitly, so an explicit import of it REPLACES
    ; that default instead of stacking a second, competing entry. Omitting `:use`
    ; entirely (`(import "coil.core" :as core)`) is Clojure's qualified-only require:
    ; it refers nothing, leaving only the alias.
    (if (= modname (implicit-prelude-name a))
        (mi-set-core! a
                      imp
                      (match use-spec (Some [spec] spec) (None [] (UNames (empty-names a))))
                      exclude
                      renames)
        (match use-spec
          (Some [spec] (mi-add-use! a imp modname spec exclude renames))
          (None [] 0)))
    (when reexport (mi-add-reexport! imp modname))
    0))

(defn handle-export [(s (mut LS)) (f (ptr Sexp)) (cur (Option (slice u8)))] (-> i64)
  (match cur
    (Some [m]
          (let [items (l-as-list f)
                n (al-len [Sexp] (load items))
                ep (exp-entry (mut s) m)
                (mut i) 1]
            (record-decl-form! (mut (.forms ep)) (load f))
            (loop (if (>= (load i) n)
                      (break)
                      (do
                        (let [it (primitive/alloc-stack Sexp)]
                          (set! it (al-get [Sexp] (load items) (load i)))
                          (match (l-sym-name it)
                            (Some [nm] (ee-add-name! ep nm))
                            (None [] (do (loader-abort "export: names must be symbols") 0))))
                        (set! i (primitive/iadd (load i) 1)))))
            0))
    (None [] (do (loader-abort "export: only valid inside a (module …)") 0))))

; `(provide-core [name ...])` is an explicit export list
; whose declarations are eligible for publication through logical `coil.core`.
; Eligibility alone does not make anything ambient: only modules named by the root
; manifest's `[language] core-providers` are loaded as core reexports.
(defn handle-provide-core [(s (mut LS)) (f (ptr Sexp)) (cur (Option (slice u8)))] (-> i64)
  (match cur
    (None [] (ls-set-err! (mut s) (diag-at-form f "provide-core is only valid inside a (module …)")))
    (Some [m]
          (let [items (l-as-list f)
                n (al-len [Sexp] (load items))]
            (unless (set-contains (field s core_declared_modules) m)
              (al-push! (mut (field s core_declared_modules)) m)
              0)
            (if (not (= n (primitive/cast i64 2)))
                (ls-set-err! (mut s)
                             (diag-at-form f "provide-core: expected (provide-core [names])"))
                (let [names-form (primitive/alloc-stack Sexp)]
                  (set! names-form (al-get [Sexp] (load items) 1))
                  (match (load (field names-form kind))
                    (KVec [names]
                          (let [ep (exp-entry (mut s) m)
                                nn (al-len [Sexp] (load names))
                                (mut i) 0]
                            (loop (if (>= (load i) nn)
                                      (break)
                                      (let [name-form (primitive/alloc-stack Sexp)]
                                        (set! name-form (al-get [Sexp] (load names) (load i)))
                                        (match (l-sym-name name-form)
                                          (Some [name] (ee-add-name! ep name))
                                          (None []
                                                (ls-set-err! (mut s)
                                                             (diag-at-form name-form
                                                                           "provide-core: every provided name must be a symbol"))))
                                        (set! i (primitive/iadd (load i) 1)))))
                            0))
                    (_ (ls-set-err! (mut s)
                                    (diag-at-form names-form
                                                  "provide-core: expected a vector of declaration names")))))))))
  0)

(defn process-import [(s (mut LS)) (form (ptr Sexp)) (base (slice u8)) (cur (Option (slice u8)))] (-> i64)
  (let [a (load (field s a))
        items (l-as-list form)
        nit (al-len [Sexp] (load items))
        path
          (if (< nit (primitive/cast i64 2))
              (do (loader-abort "import: expected (import \"path\" [:as alias])") "")
              (let [it (primitive/alloc-stack Sexp)]
                (set! it (al-get [Sexp] (load items) 1))
                (match (l-as-str it)
                  (Some [p] p)
                  (None [] (do (loader-abort "import: expected (import \"path\" [:as alias])") "")))))
        (mut alias) (None [(slice u8)])
        (mut use-spec) (None [UseSpec])
        (mut reexport) false
        (mut exclude) (primitive/cast (ptr (ArrayList (slice u8))) 0)
        (mut renames) (primitive/cast (ptr (ArrayList Rename)) 0)
        (mut i) 2]
    ; `--use` is implemented as a synthetic, unspanned import. It is an input to
    ; the lint run, not user syntax, so never expose it as a checker-visible form.
    (when (not (source-is-cli-use? (mut s) (sx-source (load form))))
      (match cur
        (Some [m]
              (record-decl-form! (mut (.forms (.imp (imp-entry (mut s) m)))) (load form)))
        (None [] 0)))
    (loop (if (>= (load i) nit)
              (break)
              (let [it (primitive/alloc-stack Sexp)]
                (set! it (al-get [Sexp] (load items) (load i)))
                (match (.kind it)
                  (KKw [k]
                       (cond (= k "as")
                               (let [a2 (primitive/alloc-stack Sexp)]
                                 (store! a2
                                         (al-get [Sexp]
                                                 (load items)
                                                 (primitive/iadd (load i) 1)))
                                 (match (l-sym-name a2)
                                   (Some [al]
                                         (do
                                           (store! alias (Some al))
                                           (store! i (primitive/iadd (load i) 2))))
                                   (None []
                                         (do
                                           (loader-abort "import: :as expects an alias symbol")
                                           (store! i (primitive/iadd (load i) 2))))))
                             (= k "reexport")
                               (do
                                 (store! reexport true)
                                 (store! i (primitive/iadd (load i) 1)))
                             (= k "exclude")
                               (let [v2 (primitive/alloc-stack Sexp)]
                                 (store! v2
                                         (al-get [Sexp]
                                                 (load items)
                                                 (primitive/iadd (load i) 1)))
                                 (match (load (field v2 kind))
                                   (KVec [vit] (store! exclude (collect-syms a vit)))
                                   (_ (loader-abort "import: :exclude expects [names]")))
                                 (store! i (primitive/iadd (load i) 2)))
                             (= k "rename")
                               (let [v2 (primitive/alloc-stack Sexp)]
                                 (store! v2
                                         (al-get [Sexp]
                                                 (load items)
                                                 (primitive/iadd (load i) 1)))
                                 (match (load (field v2 kind))
                                   (KVec [vit] (store! renames (collect-renames a vit)))
                                   (_ (loader-abort "import: :rename expects [[from to] …]")))
                                 (store! i (primitive/iadd (load i) 2)))
                             (= k "use")
                               (let [v2 (primitive/alloc-stack Sexp)]
                                 (store! v2
                                         (al-get [Sexp]
                                                 (load items)
                                                 (primitive/iadd (load i) 1)))
                                 (match (load (field v2 kind))
                                   (KSym [sm]
                                         (if (= sm "*")
                                             (do
                                               (store! use-spec (Some (UAll)))
                                               (store! i (primitive/iadd (load i) 2)))
                                             (do
                                               (loader-abort "import: :use expects * or [names]")
                                               (store! i (primitive/iadd (load i) 2)))))
                                   (KVec [vit]
                                         (do
                                           (store! use-spec (Some (UNames (collect-syms a vit))))
                                           (store! i (primitive/iadd (load i) 2))))
                                   (KInt [_]
                                         (do
                                           (loader-abort "import: :use expects * or [names]")
                                           (store! i (primitive/iadd (load i) 2))))
                                   (KFloat [_]
                                           (do
                                             (loader-abort "import: :use expects * or [names]")
                                             (store! i (primitive/iadd (load i) 2))))
                                   (KView [_ _ _]
                                          (do
                                            (loader-abort "import: :use expects * or [names]")
                                            (store! i (primitive/iadd (load i) 2))))
                                   (KKw [_]
                                        (do
                                          (loader-abort "import: :use expects * or [names]")
                                          (store! i (primitive/iadd (load i) 2))))
                                   (KStr [_]
                                         (do
                                           (loader-abort "import: :use expects * or [names]")
                                           (store! i (primitive/iadd (load i) 2))))
                                   (KCStr [_]
                                          (do
                                            (loader-abort "import: :use expects * or [names]")
                                            (store! i (primitive/iadd (load i) 2))))
                                   (KList [_]
                                          (do
                                            (loader-abort "import: :use expects * or [names]")
                                            (store! i (primitive/iadd (load i) 2))))))
                             :else
                               (do
                                 (loader-abort "import: expected :as alias, :use *|[names], :exclude [names], :rename [[from to] …], or :reexport")
                                 (store! i (primitive/iadd (load i) 1)))))
                  (KInt [_]
                        (do
                          (loader-abort "import: expected :as alias, :use *|[names], :exclude [names], :rename [[from to] …], or :reexport")
                          (set! i (primitive/iadd (load i) 1))))
                  (KFloat [_]
                          (do
                            (loader-abort "import: expected :as alias, :use *|[names], :exclude [names], :rename [[from to] …], or :reexport")
                            (set! i (primitive/iadd (load i) 1))))
                  (KSym [_]
                        (do
                          (loader-abort "import: expected :as alias, :use *|[names], :exclude [names], :rename [[from to] …], or :reexport")
                          (set! i (primitive/iadd (load i) 1))))
                  (KStr [_]
                        (do
                          (loader-abort "import: expected :as alias, :use *|[names], :exclude [names], :rename [[from to] …], or :reexport")
                          (set! i (primitive/iadd (load i) 1))))
                  (KCStr [_]
                         (do
                           (loader-abort "import: expected :as alias, :use *|[names], :exclude [names], :rename [[from to] …], or :reexport")
                           (set! i (primitive/iadd (load i) 1))))
                  (KList [_]
                         (do
                           (loader-abort "import: expected :as alias, :use *|[names], :exclude [names], :rename [[from to] …], or :reexport")
                           (set! i (primitive/iadd (load i) 1))))
                  (KVec [_]
                        (do
                          (loader-abort "import: expected :as alias, :use *|[names], :exclude [names], :rename [[from to] …], or :reexport")
                          (set! i (primitive/iadd (load i) 1))))
                  (KView [_ _ _]
                         (do
                           (loader-abort "import: expected :as alias, :use *|[names], :exclude [names], :rename [[from to] …], or :reexport")
                           (set! i (primitive/iadd (load i) 1))))))))
    ; `:exclude` subtracts from `:use *`. Pairing it with `:use [names]` — already a
    ; whitelist — means the author expects one of the two to be doing something it isn't,
    ; so say so rather than silently honoring the narrower one.
    (when (and (!= (primitive/cast i64 (load exclude)) (primitive/cast i64 0))
               (match (load use-spec) (Some [sp] (match sp (UAll [] false) (UNames [_] true))) (None [] false)))
      (ls-set-err! (mut s)
                   (diag-at-form form
                                 ":exclude subtracts from `:use *`, but this import already lists the names it refers with `:use [names]` — drop one of them"))
      0)
    ; `coil.core` is the prelude: already loaded, and it has no file under any source
    ; root to resolve. An explicit import of it is pure bookkeeping — it overrides the
    ; module's implicit refer-all and nothing more.
    (if (= path (implicit-prelude-name a))
        (import-record! (mut s)
                        cur
                        (load alias)
                        (load use-spec)
                        (load reexport)
                        (load exclude)
                        (load renames)
                        (implicit-prelude-name a))
        (let [rr (resolve-source a (mut s) form base path)
              rp (primitive/alloc-stack Resolved)]
          (set! rp rr)
          (unless (ls-err? (mut s))
            (match (read-memo-find (mut s) (load (field rp disp)))
              ; already read for another importer — only this importer's record is new
              (Some [modname]
                    (import-record! (mut s)
                                    cur
                                    (load alias)
                                    (load use-spec)
                                    (load reexport)
                                    (load exclude)
                                    (load renames)
                                    modname))
              (None []
                    (let [text (load (field rp text))
                          incdir (load (field rp incdir))
                          inc-id (load (field s srccount))
                          _ignore (store! (field s srccount) (primitive/iadd inc-id 1))
                          _reg (register-source! (mut s) (load (field rp disp)) text)]
                      (let [reader-mod (configured-reader-module a (load (field rp disp)))
                            guest (> (slice-len reader-mod) 0)
                            hook (source-reader-hook)
                            read-result
                              (if guest
                                  (if (= (.isset hook) 0)
                                      (do
                                        (ls-set-err! (mut s)
                                                     (diag-at-form form
                                                                   (sconcat3 a
                                                                             "import '"
                                                                             path
                                                                             "' requires a configured reader, but no reader setup is active")))
                                        (Err [(ptr (ArrayList Sexp)) Diag] (.loaderr s)))
                                      (let [got
                                              (primitive/call-ptr (.fp hook)
                                                                  a
                                                                  s
                                                                  (load (field rp disp))
                                                                  text
                                                                  inc-id
                                                                  reader-mod)]
                                        (if (= (primitive/cast i64 got) 0)
                                            (Err [(ptr (ArrayList Sexp)) Diag] (.loaderr s))
                                            (Ok [(ptr (ArrayList Sexp)) Diag] got))))
                                  (read-all a text inc-id))]
                        (match read-result
                          ; `d` is already anchored in the imported file (read-all stamped inc-id),
                          ; so hand it to the driver verbatim — it points at the unclosed form. A
                          ; generic abort here would drop the one span that locates the mistake.
                          (Err [d] (do (ls-set-err! (mut s) d) 0))
                          (Ok [inc0]
                              (let [read-forms (if guest (ensure-guest-module a inc0 path) inc0)
                                    inc-forms
                                      (if (loader-casefolding-source? read-forms)
                                          (do
                                            (loader-casefold-source! text read-forms)
                                            (match (read-all a text inc-id)
                                              (Ok [fresh] fresh)
                                              (Err [_] read-forms)))
                                          read-forms)
                                    modname
                                      (match (declared-module inc-forms)
                                        (Some [m] m)
                                        (None []
                                              (if guest
                                                  path
                                                  ; The file was read as Coil and therefore
                                                  ; still owns its identity with `(module …)`.
                                                  (do
                                                    (ls-set-err! (mut s)
                                                                 (diag-at-form form
                                                                               (sconcat3 a
                                                                                         "import '"
                                                                                         (load (field rp disp))
                                                                                         "': file has no (module …) declaration — add (module <name>) as its first form")))
                                                    ""))))
                                    _guest-name-check
                                      (when (and guest (not (= modname path)))
                                        (ls-set-err! (mut s)
                                                     (diag-at-form form
                                                                   (sconcat3 a
                                                                             "reader output declares namespace '"
                                                                             modname
                                                                             (sconcat3 a
                                                                                       "', but the imported namespace is '"
                                                                                       path
                                                                                       "'"))))
                                        0)
                                    _memo (read-memo-add! (mut s) (load (field rp disp)) modname)]
                                (import-record! (mut s)
                                                cur
                                                (load alias)
                                                (load use-spec)
                                                (load reexport)
                                                (load exclude)
                                                (load renames)
                                                modname)
                                (when (loaded-insert! (mut s) modname)
                                  (process-forms (mut s) inc-forms incdir (None [(slice u8)])))
                                0))))))))))))

; Join the string elements of a `:flags ["-I…" "-D…"]` option into one clang
; flags string (each space-prefixed), or "" if absent. Forwarded to clang so
; headers that need include paths / feature defines can be parsed correctly.
(defn cimport-kwstr [(a (dyn Allocator)) (items (ptr (ArrayList Sexp))) (nit i64) (kw (slice u8))] (-> (slice u8))
  (let [(mut out) (sb-new a)
        (mut j) 2]
    (loop (if (>= (load j) nit)
              (break)
              (let [kwt (primitive/alloc-stack Sexp)]
                (set! kwt (al-get [Sexp] (load items) (load j)))
                (match (.kind kwt)
                  (KKw [k]
                       (if (and (= k kw) (< (primitive/iadd (load j) 1) nit))
                           (do
                             (let [vec (primitive/alloc-stack Sexp)]
                               (set! vec
                                     (al-get [Sexp]
                                             (load items)
                                             (primitive/iadd (load j) 1)))
                               (match (.kind vec)
                                 (KVec [vit]
                                       (let [(mut vi) 0
                                             vn (al-len [Sexp] (load vit))]
                                         (loop (if (>= (load vi) vn)
                                                   (break)
                                                   (do
                                                     (let [el (primitive/alloc-stack Sexp)]
                                                       (set! el
                                                             (al-get [Sexp]
                                                                     (load vit)
                                                                     (load vi)))
                                                       (match (l-as-str el)
                                                         (Some [fs]
                                                               (do
                                                                 (sb-push-str! (mut out) " ")
                                                                 (sb-push-str! (mut out) fs)
                                                                 0))
                                                         (None [] 0)))
                                                     (set! vi
                                                           (primitive/iadd (load vi)
                                                                           1)))))))
                                 (_ 0)))
                             (set! j (primitive/iadd (load j) 2)))
                           (set! j (primitive/iadd (load j) 1))))
                  (_ (set! j (primitive/iadd (load j) 1)))))))
    (sb-str (load out))))

; parse one `:probe` entry: `(name "C-expr")` (tier 0) or `(name :bits "struct X" "f")`
; (tier 1) → push a Probe. Malformed entries are ignored.
(defn parse-probe-entry [(a (dyn Allocator)) (plist (ptr (ArrayList ci/Probe))) (entry (ptr Sexp))] (-> i64)
  (let [it (l-as-list entry)
        n (al-len [Sexp] (load it))]
    (unless (< n (primitive/cast i64 2))
      (let [e0 (primitive/alloc-stack Sexp)]
        (store! e0 (al-get [Sexp] (load it) 0))
        (match (l-sym-name e0)
          (None [] 0)
          (Some [name]
                (let [e1 (primitive/alloc-stack Sexp)]
                  (store! e1 (al-get [Sexp] (load it) 1))
                  (match (load (field e1 kind))
                    (KStr [ex] (ci/probe-push! a plist name 0 ex "" ""))
                    (KCStr [ex] (ci/probe-push! a plist name 0 ex "" ""))
                    (KKw [k]
                         (when (and (= k "bits") (>= n (primitive/cast i64 4)))
                           (let [e2 (primitive/alloc-stack Sexp)
                                 e3 (primitive/alloc-stack Sexp)]
                             (store! e2 (al-get [Sexp] (load it) 2))
                             (store! e3 (al-get [Sexp] (load it) 3))
                             (match (l-as-str e2)
                               (None [] 0)
                               (Some [sn]
                                     (match (l-as-str e3)
                                       (None [] 0)
                                       (Some [fnm] (ci/probe-push! a plist name 1 "" sn fnm))))))))
                    (_ 0)))))))))

; is a bare keyword `:kw` present anywhere in the form's tail?
(defn has-kw? [(items (ptr (ArrayList Sexp))) (nit i64) (kw (slice u8))] (-> bool)
  (let [(mut j) 2
        (mut r) false]
    (loop (if (or (>= (load j) nit) (load r))
              (break)
              (do
                (let [k (primitive/alloc-stack Sexp)]
                  (set! k (al-get [Sexp] (load items) (load j)))
                  (match (.kind k) (KKw [n] (when (= n kw) (store! r true) 0)) (_ 0)))
                (set! j (primitive/iadd (load j) 1)))))
    (load r)))

; Collect bare symbols from a `:use [name …]` option. A present empty vector means
; import nothing; absence means the historical import-everything behavior.
(defn cimport-use-names [(a (dyn Allocator))
                         (items (ptr (ArrayList Sexp)))
                         (nit i64)] (-> (ptr (ArrayList (slice u8))))
  (let [names (box! a (ArrayList (slice u8)) (al-new [(slice u8)] a))
        (mut j) 2]
    (loop (if (>= (load j) nit)
              (break)
              (let [kwt (primitive/alloc-stack Sexp)]
                (set! kwt (al-get [Sexp] (load items) (load j)))
                (match (.kind kwt)
                  (KKw [k]
                       (if (and (= k "use") (< (primitive/iadd (load j) 1) nit))
                           (do
                             (let [vec (primitive/alloc-stack Sexp)]
                               (set! vec (al-get [Sexp] (load items) (primitive/iadd (load j) 1)))
                               (match (.kind vec)
                                 (KVec [vit]
                                       (let [(mut vi) 0
                                             vn (al-len [Sexp] (load vit))]
                                         (loop (if (>= (load vi) vn)
                                                   (break)
                                                   (let [el (primitive/alloc-stack Sexp)]
                                                     (set! el (al-get [Sexp] (load vit) (load vi)))
                                                     (match (l-sym-name el)
                                                       (Some [name] (al-push! [(slice u8)] names name))
                                                       (None [] 0))
                                                     (set! vi (primitive/iadd (load vi) 1)))))))
                                 (_ 0)))
                             (set! j (primitive/iadd (load j) 2)))
                           (set! j (primitive/iadd (load j) 1))))
                  (_ (set! j (primitive/iadd (load j) 1)))))))
    names))

; collect the `:probe [ … ]` entries into a Probe list.
(defn cimport-probes [(a (dyn Allocator)) (items (ptr (ArrayList Sexp))) (nit i64)] (-> (ptr (ArrayList ci/Probe)))
  (let [plist (ci/probe-list-new a)
        (mut j) 2]
    (loop (if (>= (load j) nit)
              (break)
              (let [kwt (primitive/alloc-stack Sexp)]
                (set! kwt (al-get [Sexp] (load items) (load j)))
                (match (.kind kwt)
                  (KKw [k]
                       (if (and (= k "probe")
                                (< (primitive/iadd (load j) 1) nit))
                           (do
                             (let [vec (primitive/alloc-stack Sexp)]
                               (set! vec
                                     (al-get [Sexp]
                                             (load items)
                                             (primitive/iadd (load j) 1)))
                               (match (.kind vec)
                                 (KVec [vit]
                                       (let [(mut vi) 0
                                             vn (al-len [Sexp] (load vit))]
                                         (loop (if (>= (load vi) vn)
                                                   (break)
                                                   (do
                                                     (let [el (primitive/alloc-stack Sexp)]
                                                       (set! el
                                                             (al-get [Sexp]
                                                                     (load vit)
                                                                     (load vi)))
                                                       (parse-probe-entry a plist el))
                                                     (set! vi
                                                           (primitive/iadd (load vi)
                                                                           1)))))))
                                 (_ 0)))
                             (set! j (primitive/iadd (load j) 2)))
                           (set! j (primitive/iadd (load j) 1))))
                  (_ (set! j (primitive/iadd (load j) 1)))))))
    plist))

; `(cimport "header.h" [:flags […]] [:probe […]] [:link […]])` — generate C bindings
; via clang AT LOAD TIME and splice the externs/defstructs/consts + probe consts
; into the CURRENT module (dropping the generated `(module cbindings)` header).
(defn process-cimport [(s (mut LS)) (form (ptr Sexp)) (cur (Option (slice u8)))] (-> i64)
  (let [a (load (field s a))
        items (l-as-list form)
        nit (al-len [Sexp] (load items))]
    (if (< nit (primitive/cast i64 2))
        (ls-set-err! (mut s) (diag-at-form form "cimport: expected (cimport \"header.h\")"))
        (let [it (primitive/alloc-stack Sexp)]
          (set! it (al-get [Sexp] (load items) 1))
          (match (l-as-str it)
            (None [] (ls-set-err! (mut s) (diag-at-form form "cimport: expected a string header path")))
            (Some [path]
                  (let [flags (cimport-kwstr a items nit "flags")
                        use-present (has-kw? items nit "use")
                        use-names (cimport-use-names a items nit)
                        probe-out
                          (ci/cimport-probe a
                                            path
                                            flags
                                            (cimport-probes a items nit)
                                            (cimport-kwstr a items nit "link"))
                        ; :probe-only skips the whole header dump (structs/externs/#defines)
                        ; and emits ONLY the probe consts — the ABI-extraction workflow.
                        rtext
                          (if (has-kw? items nit "probe-only")
                              (Ok [(slice u8) (slice u8)] (sconcat a "(module cbindings)\n" probe-out))
                              (match (ci/cimport-header-use a path flags use-names use-present)
                                (Err [e] (Err [(slice u8) (slice u8)] e))
                                (Ok [hdr] (Ok [(slice u8) (slice u8)] (sconcat a hdr probe-out)))))
                        ; Both calls above are done with their clang scratch files by
                        ; now, and their results are already in the arena. The compile
                        ; path reaches cimport WITHOUT going through its CLI entry, so
                        ; this is the only place the mid-compile files get swept.
                        _swept (ci/cimport-cleanup! a)]
                    (match rtext
                      (Err [e] (ls-set-err! (mut s) (diag-at-form form e)))
                      (Ok [text]
                          (let [sid (.srccount s)
                                _1 (set! (.srccount s) (primitive/iadd sid 1))
                                _2 (register-source! (mut s) (sconcat a "<cimport " path) text)]
                            (match (read-all a text sid)
                              (Err [d]
                                   (ls-set-err! (mut s)
                                                (diag-at-form form "cimport: generated bindings failed to parse")))
                              (Ok [gforms]
                                  (let [(mut k) 0
                                        gn (al-len [Sexp] (load gforms))]
                                    (loop (if (>= (load k) gn)
                                              (break)
                                              (do
                                                (let [gf (primitive/alloc-stack Sexp)]
                                                  (set! gf
                                                        (al-get [Sexp]
                                                                (load gforms)
                                                                (load k)))
                                                  (match (l-list-head gf)
                                                    (Some [gh]
                                                          (unless (= gh "module")
                                                            (al-push! (mut (field s out))
                                                                      (mk-tagged (load gf) cur))))
                                                    (None []
                                                          (al-push! (mut (.out s))
                                                                    (mk-tagged (load gf) cur)))))
                                                (set! k (primitive/iadd (load k) 1)))))
                                    0)))))))))))))

; ── include-str: compile-time file embed, resolved at LOAD time ───────────────
; Each file's forms are walked as it is loaded (EVERY file, always — no dependence
; on the macro-expansion pass), and each `(include-str "rel")` is replaced by a
; string literal of the file's bytes. `rel` resolves relative to the INCLUDING
; file's own directory. A missing file or a
; non-literal path is a hard load error — never a silent empty embed.
(defn incl-is-include-str [(items (ptr (ArrayList Sexp)))] (-> bool)
  (and (>= (sx-len items) (primitive/cast i64 1))
       (and (= (sx-tag (sx-at items 0)) (primitive/cast i64 2))
            (= (sx-sval (sx-at items 0)) "include-str"))))

(defn incl-read [(a (dyn Allocator)) (dir (slice u8)) (rel (slice u8))] (-> (Option (slice u8)))
  (read-file-opt a (str->cstr a (path-join a dir rel))))

(defn do-include-str [(s (mut LS)) (f (ptr Sexp)) (dir (slice u8))] (-> Sexp)
  (let [a (load (field s a))
        items (sx-items (load f))]
    (if (!= (sx-len items) (primitive/cast i64 2))
        (do
          (ls-set-err! (mut s) (diag-at-form f "include-str: expects exactly one string-literal path argument"))
          (load f))
        (let [arg (sx-at items 1)]
          (if (!= (sx-tag arg) (primitive/cast i64 4))
              (do
                (ls-set-err! (mut s) (diag-at-form f "include-str: path must be a string literal"))
                (load f))
              (let [rel (sx-sval arg)]
                (match (incl-read a dir rel)
                  (Some [text] (mk-sexp-src (KStr text) f))
                  (None []
                        (do
                          (ls-set-err! (mut s)
                                       (diag-at-form f
                                                     (sconcat3 a
                                                               "include-str: cannot read file '"
                                                               rel
                                                               "' (relative to the including file)")))
                          (load f))))))))))

(defn form-has-include-str [(f (ptr Sexp))] (-> bool)
  (let [tg (sx-tag (load f))]
    (if (and (= tg (primitive/cast i64 6)) (incl-is-include-str (sx-items (load f))))
        true
        (if (or (= tg (primitive/cast i64 6)) (= tg (primitive/cast i64 7)))
            (let [items (sx-items (load f))
                  n (sx-len items)
                  (mut i) 0
                  (mut r) false]
              (loop (if (or (load r) (>= (load i) n))
                        (break)
                        (do
                          (when (form-has-include-str (al-elem [Sexp] items (load i)))
                            (store! r true)
                            0)
                          (set! i (primitive/iadd (load i) 1)))))
              (load r))
            false))))

(defn expand-includes-in-form [(s (mut LS)) (f (ptr Sexp)) (dir (slice u8))] (-> Sexp)
  (let [a (load (field s a))
        tg (sx-tag (load f))]
    (if (and (= tg (primitive/cast i64 6)) (incl-is-include-str (sx-items (load f))))
        (do-include-str (mut s) f dir)
        (if (or (= tg (primitive/cast i64 6)) (= tg (primitive/cast i64 7)))
            (let [items (sx-items (load f))
                  n (sx-len items)
                  (mut out) (al-new [Sexp] a)
                  (mut i) 0]
              (loop (if (>= (load i) n)
                        (break)
                        (do
                          (al-push! (mut out)
                                    (expand-includes-in-form (mut s) (al-elem [Sexp] items (load i)) dir))
                          (set! i (primitive/iadd (load i) 1)))))
              (if (= tg (primitive/cast i64 6))
                  (mk-sexp-src (KList (box-al [Sexp] a (load out))) f)
                  (mk-sexp-src (KVec (box-al [Sexp] a (load out))) f)))
            (load f)))))

; Source spelling uses `alias/name`. A dotted name is the compiler's canonical,
; post-resolution representation and must never be accepted as an alias escape hatch
; in authored code. Validate while the original Sexp and import table are both still
; available; generated hygienic names and oracle intermediate forms never pass here
; with an authored `:as` alias, while dotted C extern names remain ordinary symbols.
(defn loader-find-dot [(name (slice u8))] (-> i64)
  (let [(mut i) 0
        (mut found) -1]
    (loop (if (>= (load i) (slice-len name))
              (break)
              (if (= (primitive/cast i64 (slice-get name (load i))) (primitive/cast i64 46))
                  (do (set! found (load i)) (break))
                  (set! i (primitive/iadd (load i) 1)))))
    (load found)))

(defn dotted-alias-diag [(s (mut LS)) (node (ptr Sexp)) (module (Option (slice u8)))] (-> (Option Diag))
  (let [tg (sx-tag (load node))]
    (if (= tg (primitive/cast i64 2))
        (let [name (sx-sval (load node))
              dot (loader-find-dot name)]
          (if (< dot (primitive/cast i64 0))
              (None [Diag])
              (match module
                (None [] (None [Diag]))
                (Some [m]
                      (let [impe (imports-find (field s imports) m)
                            alias (subslice name 0 dot)]
                        (if (= (primitive/cast i64 impe) (primitive/cast i64 0))
                            (None [Diag])
                            (match (alias-target impe alias)
                              (None [] (None [Diag]))
                              (Some [_]
                                    (let [rest (subslice name (primitive/iadd dot 1) (slice-len name))
                                          replacement (sconcat3 (load (field s a)) alias "/" rest)]
                                      (Some (diag-at-form node
                                                          (sconcat3 (load (field s a))
                                                                    "dotted module qualification is not valid; use '"
                                                                    replacement
                                                                    "'"))))))))))))
        (if (or (= tg (primitive/cast i64 6)) (= tg (primitive/cast i64 7)))
            ; quote/quasiquote bodies are Code data, not authored references. Macro
            ; hygiene deliberately uses canonical dotted symbols inside that data.
            (if (and (= tg (primitive/cast i64 6))
                     (match (l-list-head node)
                       (Some [h] (or (= h "quote") (= h "quasiquote")))
                       (None [] false)))
                (None [Diag])
                (let [items (sx-items (load node))
                      (mut i) 0
                      (mut out) (None [Diag])]
                  (loop (if (or (>= (load i) (sx-len items)) (some? (load out)))
                            (break)
                            (do
                              (set! out
                                    (dotted-alias-diag (mut s)
                                                       (al-elem [Sexp] items (load i))
                                                       module))
                              (set! i (primitive/iadd (load i) 1)))))
                  (load out)))
            (None [Diag])))))

(defn push-checked-form! [(s (mut LS)) (form Sexp) (module (Option (slice u8)))] (-> i64)
  (let [fp (primitive/alloc-stack Sexp)]
    (set! fp form)
    (match (dotted-alias-diag (mut s) fp module)
      (Some [d] (ls-set-err! (mut s) d))
      (None [] (al-push! (mut (.out s)) (mk-tagged form module)))))
  0)

(defn register-primitive! [(s (mut LS)) (f (ptr Sexp)) (module (Option (slice u8)))] (-> i64)
  (match module
    (None []
          (ls-set-err! (mut s) (diag-at-form f "defprimitive requires a module declaration")))
    (Some [m]
          (let [items (sx-items (load f))
                n (sx-len items)]
            (if (< n (primitive/cast i64 3))
                (ls-set-err! (mut s) (diag-at-form f "defprimitive: expected a name and :opcode"))
                (let [namef (sx-at items 1)
                      opf (sx-at items (primitive/isub n 1))]
                  (if (or (!= (sx-tag namef) (primitive/cast i64 2)) (!= (sx-tag opf) (primitive/cast i64 3)))
                      (ls-set-err! (mut s) (diag-at-form f "defprimitive: expected (defprimitive NAME ... :OPCODE)"))
                      (let [p (primitive/alloc-stack PrimitiveDef)]
                        (set! (.module p) m)
                        (set! (.name p) (sx-sval namef))
                        (set! (.opcode p) (sx-sval opf))
                        (al-push! (mut (.primitive_defs s)) (load p)))))))))
  0)

; `(def NAME TARGET)` is a definition alias. Primitive identity is followed through
; this alias by the resolver; no wrapper function or generated call is involved.
(defn register-primitive-alias! [(s (mut LS)) (f (ptr Sexp)) (module (Option (slice u8)))] (-> i64)
  (match module
    (None [] (ls-set-err! (mut s) (diag-at-form f "def requires a module declaration")))
    (Some [m]
          (let [items (sx-items (load f))]
            (if (!= (sx-len items) (primitive/cast i64 3))
                (ls-set-err! (mut s) (diag-at-form f "def: expected (def NAME TARGET)"))
                (let [namef (sx-at items 1)
                      targetf (sx-at items 2)]
                  (if (or (!= (sx-tag namef) (primitive/cast i64 2)) (!= (sx-tag targetf) (primitive/cast i64 2)))
                      (ls-set-err! (mut s) (diag-at-form f "def: NAME and TARGET must be symbols"))
                      (let [p (primitive/alloc-stack PrimitiveAlias)]
                        (set! (.module p) m)
                        (set! (.name p) (sx-sval namef))
                        (set! (.target p) (sx-sval targetf))
                        (al-push! (mut (.primitive_aliases s)) (load p)))))))))
  0)

(defn process-forms [(s (mut LS)) (forms (ptr (ArrayList Sexp))) (base (slice u8)) (cur0 (Option (slice u8)))] (-> i64)
  (let [a (load (field s a))
        _fold (loader-casefold-scheme! a forms)
        n (al-len [Sexp] (load forms))
        (mut cur) (None [(slice u8)])
        (mut i) 0]
    (set! cur cur0)
    ; Bail the moment the loader records an error (this file's import failed, or a
    ; nested imported file's did): stop processing further forms so the first
    ; diagnostic is the one reported.
    (loop (if (or (>= (load i) n) (ls-err? (mut s)))
              (break)
              (do
                (let [f (primitive/alloc-stack Sexp)]
                  (set! f (al-get [Sexp] (load forms) (load i)))
                  (match (l-list-head f)
                    (Some [h]
                          (cond (= h "module")
                                  (let [name (module-name f)]
                                    (imp-entry (mut s) name)
                                    (store! cur (Some name))
                                    0)
                                (= h "export")
                                  (match (dotted-alias-diag (mut s) f (load cur))
                                    (Some [d] (ls-set-err! (mut s) d))
                                    (None []
                                          (do
                                            (handle-export (mut s) f (load cur))
                                            ; Like import, export is declaration syntax a
                                            ; transform must be able to inspect and preserve.
                                            ; The parser ignores it after declaration tables
                                            ; have been rebuilt from transformed forms.
                                            (push-checked-form! (mut s) (load f) (load cur)))))
                                (= h "provide-core")
                                  ; Loader declaration syntax: it shapes the provider's
                                  ; export table but emits no runtime form of its own.
                                  (handle-provide-core (mut s) f (load cur))
                                (= h "import")
                                  (match (load cur)
                                    (Some [m]
                                          (do
                                            (process-import (mut s) f base (load cur))
                                            ; An import is part of the module's source, so a
                                            ; metaprogram must be able to SEE it: a transform is
                                            ; handed the program and asks questions of it, and
                                            ; "which namespaces does this module import?" is one
                                            ; of the most basic. Processing it into the import
                                            ; tables AND dropping it from the forms made every
                                            ; such question unanswerable — a dialect could not
                                            ; tell which modules had opted into it, with no
                                            ; diagnostic, because the marker it looked for had
                                            ; silently ceased to exist.
                                            ;
                                            ; Keeping it is inert downstream: the import has
                                            ; already been processed here, and later phases
                                            ; ignore the form.
                                            (push-checked-form! (mut s) (load f) (load cur))))
                                    (None []
                                          (ls-set-err! (mut s)
                                                       (diag-at-form f
                                                                     "import requires a (module …) declaration: add one (e.g. `(module app)`) at the top of the file, before any imports — otherwise imported types and functions cannot be resolved"))))
                                (= h "cimport") (if (defer-cimport?) 0 (process-cimport (mut s) f (load cur)))
                                (= h "defprimitive") (register-primitive! (mut s) f (load cur))
                                (= h "def") (register-primitive-alias! (mut s) f (load cur))
                                (= h "reader-provider") 0
                                (form-has-include-str f)
                                  (push-checked-form! (mut s)
                                                      (expand-includes-in-form (mut s) f base)
                                                      (load cur))
                                :else (push-checked-form! (mut s) (load f) (load cur))))
                    (None []
                          (push-checked-form! (mut s) (load f) (load cur)))))
                (set! i (primitive/iadd (load i) 1)))))
    0))

; Validate and register the explicit contribution list after a provider module has
; been read. Ambient assembly never uses manifest order as shadowing precedence.
(defn register-core-provider! [(s (mut LS)) (name (slice u8))] (-> i64)
  (let [a (load (field s a))]
    (if (not (set-contains (field s core_declared_modules) name))
        (ls-set-err! (mut s)
                     (derr (sconcat3 a
                                     "core provider '"
                                     name
                                     "' does not declare (provide-core [names] ...)")))
        (let [ep (exp-entry (mut s) name)
              names (field ep names)
              n (al-len [(slice u8)] (load names))
              (mut i) 0]
          (loop (if (or (>= (load i) n) (ls-err? (mut s)))
                    (break)
                    (let [provided (al-get [(slice u8)] (load names) (load i))
                          existing-n (al-len [(slice u8)] (.core_contribution_names s))
                          (mut j) 0
                          (mut origin) ""]
                      (loop (if (>= (load j) existing-n)
                                (break)
                                (if (= (al-get [(slice u8)]
                                               (load (field s core_contribution_names))
                                               (load j))
                                       provided)
                                    (do
                                      (store! origin
                                              (al-get [(slice u8)]
                                                      (load (field s core_contribution_modules))
                                                      (load j)))
                                      (break))
                                    (set! j (primitive/iadd (load j) 1)))))
                      (if (> (slice-len [u8] (load origin)) (primitive/cast i64 0))
                          (ls-set-err! (mut s)
                                       (derr (sconcat3 a
                                                       (sconcat3 a
                                                                 "core contribution '"
                                                                 provided
                                                                 "' is provided by both '")
                                                       (load origin)
                                                       (sconcat a "' and '" (sconcat a name "'")))))
                          (do
                            (al-push! (mut (field s core_contribution_names)) provided)
                            (al-push! (mut (field s core_contribution_modules)) name)
                            0))
                      (set! i (primitive/iadd (load i) 1))))))))
  0)

; Load one root-activated provider as a reexport of logical `coil.core`. The
; provider's own `(provide-core [names] ...)` declaration creates its explicit
; export list, so only those names cross this reexport edge.
(defn load-core-provider! [(s (mut LS)) (name (slice u8))] (-> i64)
  (let [a (load (field s a))
        text (sconcat3 a
                       "(module coil.core)\n(import \""
                       name
                       "\" :reexport)\n")
        source-id (.srccount s)
        _next (set! (.srccount s) (primitive/iadd source-id 1))
        display (sconcat3 a "<core-provider " name ">")
        _reg (register-source! (mut s) display text)]
    (match (read-all a text source-id)
      (Err [d] (ls-set-err! (mut s) d))
      (Ok [pf] (process-forms (mut s) pf "" (None [(slice u8)]))))
    (unless (ls-err? (mut s)) (register-core-provider! (mut s) name) 0)
    0))

; COIL_CORE_PROVIDERS is newline-delimited and owned by the root manifest. Child
; project commands inherit the frozen value, preventing a dependency from adding
; ambient names merely by declaring its own provider list.
(defn load-core-providers! [(s (mut LS))] (-> i64)
  (let [a (load (field s a))
        rawp (getenv (str->cstr a "COIL_CORE_PROVIDERS"))]
    ; Built-in conveniences are ordinary explicit providers too. The profile
    ; selects them before root additions; collision rules apply uniformly.
    (when (bundled-stdlib-enabled? a)
      (if (= (stdlib-profile a) "hermetic")
          (load-core-provider! (mut s) "coil.assert.hermetic")
          (do
            (load-core-provider! (mut s) "coil.print")
            (unless (ls-err? (mut s)) (load-core-provider! (mut s) "coil.assert") 0)))
      0)
    (when (!= (primitive/cast i64 rawp) (primitive/cast i64 0))
      (let [raw (cstr->slice rawp)
            n (slice-len [u8] raw)
            (mut lo) 0
            (mut i) 0]
        (loop (if (or (> (load i) n) (ls-err? (mut s)))
                  (break)
                  (if (or (= (load i) n)
                          (= (primitive/cast i64 (slice-get [u8] raw (load i)))
                             (primitive/cast i64 10)))
                      (do
                        (when (> (load i) (load lo))
                          (load-core-provider! (mut s) (subslice [u8] raw (load lo) (load i)))
                          0)
                        (store! lo (primitive/iadd (load i) 1))
                        (set! i (primitive/iadd (load i) 1)))
                      (set! i (primitive/iadd (load i) 1)))))))
    0))

(defn load-program [(s (mut LS)) (forms (ptr (ArrayList Sexp))) (base (slice u8))] (-> i64)
  (let [a (load (field s a))]
    ; Pre-register the MAIN file's module as loaded: compiling a
    ; stdlib file directly must not ALSO pull the bundled copy of the same
    ; module in through the prelude's import chain (the module would collect
    ; twice — "duplicate impl", silent last-wins for functions).
    (match (declared-module forms)
      (Some [main-mod]
            (do
              (loaded-insert! (mut s) main-mod)
              (set! (.entry_module s) main-mod)
              0))
      (None [] 0))
    (if (bundled-stdlib-enabled? a)
        ; The bundled prelude comes from the same toolchain layout as every bundled
        ; module and resolves its imports against the bundled sentinel.
        (let [prelude-text (stdlib-prelude-text a)
              prelude-id (.srccount s)
              _next (set! (.srccount s) (primitive/iadd prelude-id 1))
              _reg (register-source! (mut s) "<prelude>" prelude-text)]
          (match (read-all a prelude-text prelude-id)
            (Err [_] (do (loader-abort "read error in prelude") 0))
            (Ok [pf] (process-forms (mut s) pf (bundled-base) (None [(slice u8)])))))
        ; A replacement prelude is an ordinary indexed project/dependency module.
        ; It receives no privileged path resolution and therefore cannot reach the
        ; bundled manifests while the compilation universe is sealed.
        (let [name (implicit-prelude-name a)
              probe (primitive/alloc-stack Sexp)]
          (set! probe (primitive/zeroed Sexp))
          (match (namespace-path a (mut s) probe name)
            (None []
                  (unless (ls-err? (mut s))
                    (ls-set-err! (mut s)
                                 (derr (sconcat3 a "replacement prelude module '" name "' was not found")))
                    0))
            (Some [path]
                  (let [prelude-text (read-file a (str->cstr a path))
                        prelude-id (.srccount s)
                        _next (set! (.srccount s) (primitive/iadd prelude-id 1))
                        _reg (register-source! (mut s) path prelude-text)]
                    (match (read-all a prelude-text prelude-id)
                      (Err [d] (ls-set-err! (mut s) d))
                      (Ok [pf]
                          (match (declared-module pf)
                            (Some [decl]
                                  (if (= decl name)
                                      (process-forms (mut s) pf (dirname path) (None [(slice u8)]))
                                      (ls-set-err! (mut s)
                                                   (derr (sconcat3 a
                                                                   "replacement prelude path declares module '"
                                                                   (sconcat3 a
                                                                             decl
                                                                             "', expected '"
                                                                             (sconcat a name "'"))
                                                                   "")))))
                            (None []
                                  (ls-set-err! (mut s)
                                               (derr (sconcat3 a
                                                               "replacement prelude module '"
                                                               name
                                                               "' has no module declaration"))))))))))))
    (unless (ls-err? (mut s)) (load-core-providers! (mut s)) 0)
    (unless (ls-err? (mut s)) (process-forms (mut s) forms base (None [(slice u8)])) 0)
    0))

; ============================ resolve representation =======================
; Mirrors. `Defs` = a module's definition names split by namespace
; (HashSets become ArrayLists, membership = linear str-eq scan). `DefTable` =
; per-module Defs (ArrayList of DefEntry). `ParsedForm` = one tagged form parsed
; into its own Program, retaining its module identity.
; `Defs` sets are BY-VALUE ArrayLists so names can be pushed via (primitive/field …).)
