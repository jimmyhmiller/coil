; src/compiler/mono.coil — self-host Coil compiler, mono module.

(module coil.compiler.mono)
(import "coil.compiler.vector" :use *)
(import "coil.primitive" :as primitive)
(import "coil.compiler.unit_state" :use [core-name core-name? core-name-prefix?])
(import "coil.alloc" :as alloc :use *)
(import "coil.result" :use *)
(import "coil.slice" :use *)
(import "coil.str" :use *)
(import "coil.arraylist" :use *)
(import "coil.hashmap" :use *)
(import "coil.io" :use *)
(import "coil.control" :use *)
(import "coil.try" :use *)
(import "coil.reader" :use *)
(import "coil.compiler.ast" :use *)
(import "coil.compiler.astdump" :use *)
(import "coil.compiler.check" :use *)
(import "coil.compiler.comptime" :use *)
(import "coil.compiler.parser" :use *)
(import "coil.compiler.resolve" :use *)
(import "coil.compiler.loader" :use *)
(import "coil.compiler.type_references" :as type-refs)
(import "coil.compiler.retained_graph" :use [GraphKey graph-keyops])

(defstruct Subst
  [(names (ptr (ArrayList (slice u8)))) (types (ptr (ArrayList Type)))])

; A pending instantiation request (template name + concrete type-args).
(defstruct PendInst [(name (slice u8)) (args (ptr (ArrayList Type)))])

; The monomorphizer state. gfuncs/gstructs/gsums are
; the FILTERED generic templates; the rest are growable output/work lists.
(defstruct MonoCtx
  [(a (dyn Allocator))
   (gfuncs (ptr (ArrayList Func)))
   (gstructs (ptr (ArrayList StructDef)))
   (gsums (ptr (ArrayList SumDef)))
   (vsum-names (ArrayList (slice u8)))
   (vsum-sums (ArrayList (slice u8)))
   (out-structs (ArrayList StructDef))
   (out-sums (ArrayList SumDef))
   (out-funcs (ArrayList Func))
   ; O(1) name -> index side-index into the three out-* lists, so upsert (which
   ; MUST insert-or-replace by name) is a map lookup, not a scan of an output list
   ; that grows with every instantiation. The out-* ArrayLists stay the source of
   ; truth for order; these maps only accelerate the lookup (gen-10).
   (out-struct-idx (HashMap (slice u8) i64))
   (out-sum-idx (HashMap (slice u8) i64))
   (out-func-idx (HashMap (slice u8) i64))
   (pending-structs (ArrayList PendInst))
   (pending-sums (ArrayList PendInst))
   (pending-funcs (ArrayList PendInst))
   ; The dedupe SETS: membership decides whether an instantiation is already
   ; queued. Hash sets (value unused) so the check is O(1), not a linear scan that
   ; made the whole worklist ~O(n^2) (gen-10). First-encounter order is preserved
   ; because a name is pushed to pending-* exactly once, on its first `queue-*`.
   (queued-structs (HashMap (slice u8) i64))
   (queued-sums (HashMap (slice u8) i64))
   (queued-funcs (HashMap (slice u8) i64))
   ; Checked source-program environment used to run affine/drop elaboration on
   ; each function only after its generic parameters have concrete types.
   (ownership_cx (ptr Cx))
   ; the program's impls (for resolving a deferred TraitCall against a GENERIC
   ; impl), and the instantiation-origin map: mangled name -> (base, args), so
   ; a TraitCall receiver that resolved to a mangled struct recovers its base
   ; (the impl dispatch key) and args (the impl pattern's bindings).
   (impls (ptr (ArrayList ImplDef)))
   (trait_impl_idx (HashMap (slice u8) (ptr ImplBucket)))
   ; instantiation-origin: mangled name -> its index in io-origin (the parallel
   ; (base, args) record). A hash index so io-record!/io-find are O(1) instead of a
   ; scan of a list that grows with every instantiation (gen-10). io-origin stays an
   ; ArrayList (ETraitCall reads it by that index), appended in first-seen order.
   (io-index (HashMap (slice u8) i64))
   (io-origin (ArrayList PendInst))
   (origins (ArrayList MonoOrigin))
   (trait_uses (ArrayList MonoTraitUse))
   (current_source (slice u8))
   (retained_funcs (HashMap (slice u8) i64))
   ; Structs and sums whose values exist only at compile time; see
   ; `phase-only-nominals`. They get no runtime layout.
   (phase_only (ptr (HashMap (slice u8) i64)))
   ; The by-value C entries of generic instances a function pointer reaches
   ; (`fnptr-inst`), one per instance; added to the program's exports.
   (instance_entries (ArrayList ExportC))
   ; True while the first resolve pass walks a generic instance's body, before
   ; ownership elaboration has run on it; see `adjust-generic-call-abi!`.
   (instance_first_pass bool)])

; ---- small constructors -----------------------------------------------------
(defn mk-field [(name (slice u8)) (ty Type)] (-> Field)
  (let [p (primitive/alloc-stack Field)]
    (set! (.name p) name)
    (set! (.ty p) ty)
    (load p)))

(defn mk-param [(name (slice u8)) (ty Type)] (-> Param)
  (let [p (primitive/alloc-stack Param)]
    (set! (.name p) name)
    (set! (.ty p) ty)
    (set! (.bid p) 0)
    (set! (.positional_only p) false)
    (set! (.owned_type p) (primitive/cast (ptr Type) 0))
    (load p)))

(defn mk-param-bid [(name (slice u8)) (ty Type) (bid i64)] (-> Param)
  (let [p (primitive/alloc-stack Param)]
    (set! p (mk-param name ty))
    (set! (.bid p) bid)
    (load p)))

(defn mk-variant [(name (slice u8)) (fields (ptr (ArrayList Field)))] (-> Variant)
  (let [p (primitive/alloc-stack Variant)]
    (set! (.name p) name)
    (set! (.fields p) fields)
    (load p)))

(defn mk-arm [(variant (slice u8))
              (binds (ptr (ArrayList (slice u8))))
              (body Expr)] (-> Arm)
  (let [p (primitive/alloc-stack Arm)]
    (set! (.variant p) variant)
    (set! (.binds p) binds)
    (set! (.body p) body)
    (load p)))

(defn mk-pend [(a (dyn Allocator))
               (name (slice u8))
               (args (ptr (ArrayList Type)))] (-> PendInst)
  (let [p (primitive/alloc-stack PendInst)]
    (set! (.name p) name)
    (set! (.args p) args)
    (load p)))

(defn t-app-args [(t (ptr Type))] (-> (ptr (ArrayList Type)))
  (t-fn-params t))

(defn pack-value? [(t (ptr Type))] (-> bool)
  (match (load t) (TApp [n _] (= n "$pack")) (_ false)))

(defn dots-name? [(s (slice u8))] (-> bool)
  (let [n (len s)] (and (>= n 3) (= (subslice s (primitive/isub n 3) n) "..."))))

(defn dots-base [(s (slice u8))] (-> (slice u8))
  (if (dots-name? s) (subslice s 0 (primitive/isub (len s) 3)) s))

(defn indexed-name [(a (dyn Allocator)) (base (slice u8)) (i i64)] (-> (slice u8))
  (sconcat a (sconcat a base "$") (i64->str a i)))

; ---- Subst -----------------------
(defn mk-subst [(a (dyn Allocator))
                (names (ptr (ArrayList (slice u8))))
                (types (ptr (ArrayList Type)))] (-> (ptr Subst))
  (let [s (box! a Subst (primitive/zeroed Subst))]
    (set! (.names s) names)
    (set! (.types s) types)
    s))

(defn subst-empty [(a (dyn Allocator))] (-> (ptr Subst))
  (mk-subst a
            (box-al [(slice u8)] a (ArrayList::new [(slice u8)] a))
            (box-items-type a)))

; — zip params with args (parallel-list HashMap).
(defn subst-map [(a (dyn Allocator))
                 (params (ptr (ArrayList (slice u8))))
                 (args (ptr (ArrayList Type)))] (-> (ptr Subst))
  (let [np (len (load params))
        na (len (load args))
        (mut pi) -1
        (mut i) 0]
    (loop (if (>= (load i) np)
              (break)
              (do
                (when (dots-name? (get (load params) (load i)))
                  (store! pi (load i))
                  (break))
                (set! i (primitive/iadd (load i) 1)))))
    (if (or (< (load pi) 0)
            (and (= na np) (pack-value? (elem args (load pi)))))
        (mk-subst a params args)
        (let [tail (primitive/isub np (primitive/iadd (load pi) 1))
              count (primitive/isub na (primitive/iadd (load pi) tail))
              (mut out) (ArrayList::new [Type] a)
              (mut j) 0]
          (loop (if (>= (load j) (load pi))
                    (break)
                    (do
                      (push! (mut out) (get (load args) (load j)))
                      (set! j (primitive/iadd (load j) 1)))))
          (let [(mut packed) (ArrayList::new [Type] a)]
            (set! j 0)
            (loop (if (>= (load j) count)
                      (break)
                      (do
                        (push! (mut packed)
                               (get (load args)
                                    (primitive/iadd (load pi) (load j))))
                        (set! j (primitive/iadd (load j) 1)))))
            (push! (mut out) (TApp "$pack" (box-al [Type] a (load packed)))))
          (set! j 0)
          (loop (if (>= (load j) tail)
                    (break)
                    (do
                      (push! (mut out)
                             (get (load args)
                                  (primitive/iadd (primitive/iadd (load pi)
                                                                  count)
                                                  (load j))))
                      (set! j (primitive/iadd (load j) 1)))))
          (mk-subst a params (box-al [Type] a (load out)))))))

(defn subst-lookup [(s (ptr Subst)) (name (slice u8))] (-> (Option Type))
  (let [ns (load (field s names))
        ts (load (field s types))
        n (len (load ns))
        (mut i) 0
        (mut r) (None [Type])]
    (loop (if (>= (load i) n)
              (break)
              (do
                (when (= (get (load ns) (load i)) name)
                  (store! r (Some (get (load ts) (load i))))
                  (break))
                (set! i (primitive/iadd (load i) 1)))))
    (load r)))

;;; A monomorphized type as its generic spelling: a mangled instance such as
;;; `ArrayList__OldRecord` back to `(ArrayList OldRecord)`, the form impl patterns
;;; are written in.
(defn mono-semantic-type [(m (ptr MonoCtx)) (t Type)] (-> Type)
  (match t
    (TStruct [name]
             (let [oi (io-find m name)]
               (if (>= oi 0)
                   (let [origin (elem (field m io-origin) oi)]
                     (TApp (load (field origin name)) (load (field origin args))))
                   t)))
    (_ t)))

(defn mono-subst-insert! [(s (ptr Subst)) (name (slice u8)) (ty Type)] (-> i64)
  (push! (mut (load (field s names))) name)
  (push! (mut (load (field s types))) ty)
  0)

(defn mono-subst-copy [(a (dyn Allocator)) (s (ptr Subst))] (-> (ptr Subst))
  (let [(mut names) (ArrayList::new [(slice u8)] a)
        (mut types) (ArrayList::new [Type] a)]
    (for [i 0 (len (load (load (field s names))))]
      (push! (mut names) (get (load (field s names)) i))
      (push! (mut types) (get (load (field s types)) i)))
    (mk-subst a
              (box-al [(slice u8)] a (load names))
              (box-al [Type] a (load types)))))

(defn extend-associated-subst! [(m (ptr MonoCtx))
                                (f (ptr Func))
                                (map (ptr Subst))] (-> i64)
  (let [a (.a m)
        bounds (load (field f bounds))]
    (for [bi 0 (len (load bounds))]
      (let [bound (elem bounds bi)]
        (match (subst-lookup map (.name bound))
          (None [] 0)
          (Some [concrete]
                (let [raw (box-type a concrete)
                      oi
                        (if (= (type-tag raw) 6)
                            (io-find m (type-struct-name raw))
                            -1)
                      semantic
                        (if (>= oi 0)
                            (let [origin
                                    (elem (field m io-origin) oi)]
                              (TApp (load (field origin name))
                                    (load (field origin args))))
                            concrete)
                      cp (box-type a semantic)
                      traits (load (field bound traits))]
                  (for [ti 0 (len (load traits))]
                    (let [bt (elem traits ti)
                          tr (.name bt)
                          td (trait-find (load (field m ownership_cx)) tr)
                          ip (impl-lookup-sel a m tr cp)]
                      ; A bound that states its associated types, `(New (Migration Old))`,
                      ; fixes them: a trait call on the bound parameter reads them back
                      ; to bind impl parameters its receiver leaves open.
                      (unless (or (= (primitive/cast i64 td) 0)
                                  (!= (len (load (.args bt))) (len (load (.type_params td)))))
                        (for [pi 0 (len (load (.args bt)))]
                          (match (resolve-ty m (elem (.args bt) pi) map)
                            (Ok [value]
                                (mono-subst-insert! map
                                                    (assoc-tp-name a (.name bound) tr
                                                                   (get (load (.type_params td)) pi))
                                                    value))
                            (Err [_] 0))
                          0)
                        0)
                      (unless (or (or (= (primitive/cast i64 td) 0)
                                      (= (primitive/cast i64 ip) 0))
                                  (= (len (load (.args bt))) (len (load (.type_params td)))))
                        (let [assoc (impl-associated-bindings a ip td)
                              impl-binds (subst-new a)]
                          (unify-trait-extras a
                                              (field ip self_type)
                                              cp
                                              (load (field ip type_params))
                                              impl-binds)
                          (let [params (load (field td type_params))]
                            (for [pi 0 (len (load params))]
                              (let [p (get (load params) pi)
                                    value (subst-get assoc p)]
                                (unless (= (primitive/cast i64 value) 0)
                                  (mono-subst-insert! map
                                                      (assoc-tp-name a
                                                                     (.name bound)
                                                                     tr
                                                                     p)
                                                      (subst-apply a
                                                                   value
                                                                   impl-binds))
                                  0))))))))))))))
  0)

(defn subst-pack [(s (ptr Subst))] (-> (ptr (ArrayList Type)))
  (let [ts (load (field s types))
        n (len (load ts))
        (mut i) 0
        (mut out) (primitive/cast (ptr (ArrayList Type)) 0)]
    (loop (if (>= (load i) n)
              (break)
              (let [tp (elem ts (load i))]
                (if (pack-value? tp)
                    (do (set! out (t-app-args tp)) (break))
                    (set! i (primitive/iadd (load i) 1))))))
    (load out)))

; A generic constant's part of an instance name: `const4`, `consttrue`, `constkw_meters`.
(defn const-type-key [(a (dyn Allocator)) (t (ptr Type))] (-> (slice u8))
  (match (load t)
    (TConst [v]
      (match v
        (ConstInt [n] (sconcat a "const" (i64->str a n)))
        (ConstBool [b] (if b "consttrue" "constfalse"))
        (ConstKeyword [name] (sconcat a "constkw_" name))
        (ConstRef [name] (do (unimplemented "mono: a (const NAME) generic argument reached specialization unresolved (compiler bug)") ""))))
    (_ (do (abort) ""))))

; ---- type_key / mangle — mutually recursive -------------------
(defn type-key [(a (dyn Allocator)) (t (ptr Type))] (-> (slice u8))
  (let [tg (type-tag t)]
    (cond (= tg 12) "never"
          (= tg 13) "code"
          (= tg 15) "codebuilder"
          (= tg 16) (const-type-key a t)
          (= tg 3) "void"
          (= tg 0)
            (sconcat a
                     (if (t-int-signed t) "i" "u")
                     (i64->str a (t-int-bits t)))
          (= tg 1)
            (sconcat a "f" (i64->str a (t-int-bits t)))
          (= tg 2) "bool"
          (= tg 4)
            (sconcat a "ptr_" (type-key a (t-inner t)))
          (= tg 5)
            (sconcat a "ref_" (type-key a (t-inner t)))
          (= tg 6) (type-struct-name t)
          (= tg 7)
            (sconcat a
                     (sconcat a "arr" (i64->str a (t-arrn t)))
                     (sconcat a "_" (type-key a (t-inner t))))
          (= tg 8)
            (sconcat a "slice_" (type-key a (t-inner t)))
          (= tg 9)
            (sconcat a
                     (sconcat a "vec" (i64->str a (t-arrn t)))
                     (sconcat a "_" (type-key a (t-inner t))))
          (= tg 10)
            (mangle a
                    (sconcat a
                             (sconcat3 a "fn_" (t-fn-cc t) "_")
                             (type-key a (t-fn-ret t)))
                    (t-fn-params t))
          :else (mangle a (t-app-name t) (t-app-args t)))))

(defn mangle [(a (dyn Allocator))
              (name (slice u8))
              (args (ptr (ArrayList Type)))] (-> (slice u8))
  (let [(mut s) name
        n (len (load args))
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (set! s
                      (sconcat a
                               (load s)
                               (sconcat a
                                        "__"
                                        (type-key a
                                                  (elem args (load i))))))
                (set! i (primitive/iadd (load i) 1)))))
    (load s)))

; ---- trait_method_fn / type_impl_name --------------------------
; Delegates to check's `tmfn` — the ONE definition. These were two hand-synced copies
; of the same scheme; a mangler that drifts from the one used to EMIT the impl's
; functions produces calls to symbols that don't exist.
(defn trait-method-fn [(a (dyn Allocator))
                       (trait (slice u8))
                       (type-name (slice u8))
                       (method (slice u8))] (-> (slice u8))
  (tmfn a trait type-name method))

; The dispatch key for a deferred trait call whose Self resolved to a concrete type.
; Delegates to the ONE definition (`parser.coil::impl-base-name`) — this was a third
; hand-synced copy, and it silently lagged the other two: `(!= p q)` on a pointer is a
; bounded generic, so `Eq` for `(ptr T)` is resolved HERE, and a copy that didn't know
; about pointers type-checked fine and then hit the `unimplemented` below at mono time.
(defn mono-impl-name [(a (dyn Allocator)) (t (ptr Type))] (-> (Option (slice u8)))
  (let [n (impl-base-name a t)]
    (if (= (len n) 0) (None [(slice u8)]) (Some n))))

; ---- generic-impl resolution for deferred trait calls ----------
(defn impl-lookup [(m (ptr MonoCtx)) (tr (slice u8)) (base (slice u8))] (-> (ptr ImplDef))
  (let [bucket
          (impl-index-get (field m trait_impl_idx)
                          (impl-index-key (.a m) tr base))]
    (if (= (primitive/cast i64 bucket) 0)
        (primitive/cast (ptr ImplDef) 0)
        (elem (load (field m impls))
              (get (.items bucket) 0)))))

; Several impls can share a key, so "first one with this key" is not good enough here
; either: pick the most specific whose pattern accepts the receiver. That is exactly
; `check.coil::impl-select-indexed`, called with mono's own impl table and index — NOT a second copy of
; the rule. A parallel implementation here would be free to disagree with the one that
; type-checked the program, which is the whole failure mode this phase keeps hitting.
(defn impl-lookup-sel [(a (dyn Allocator))
                       (m (ptr MonoCtx))
                       (tr (slice u8))
                       (recv (ptr Type))] (-> (ptr ImplDef))
  (let [s (primitive/alloc-stack ImplSel)]
    (set! s
          (impl-select-indexed a
                               (.ownership_cx m)
                               (load (field m impls))
                               (impl-index-get (field m trait_impl_idx)
                                               (impl-index-key a
                                                               tr
                                                               (type-impl-name a
                                                                               recv)))
                               (impl-index-get (field m trait_impl_idx)
                                               (impl-index-key a tr BLANKET-IMPL-KEY))
                               tr
                               recv))
    (load (field s ip))))

; NOTE: the impl-pattern matcher lives in check.coil (`unify-trait-extras`) and mono
; uses it directly. There was a second one here (`match-impl-pattern`/`mip-list`),
; which is how a receiver could be accepted by the selector and then rejected by the
; binder. One matcher, one answer.

; ---- generic-template lookups (the gfuncs/gstructs/gsums HashMaps) -----------
(defn find-struct-named [(lst (ptr (ArrayList StructDef))) (nm (slice u8))] (-> i64)
  (let [n (len (load lst))
        (mut i) 0
        (mut r) -1]
    (loop (if (>= (load i) n)
              (break)
              (do
                (when (= (load (field (elem lst (load i)) name))
                         nm)
                  (store! r
                          (load i))
                  0)
                (set! i (primitive/iadd (load i) 1)))))
    (load r)))

(defn find-sum-named [(lst (ptr (ArrayList SumDef))) (nm (slice u8))] (-> i64)
  (let [n (len (load lst))
        (mut i) 0
        (mut r) -1]
    (loop (if (>= (load i) n)
              (break)
              (do
                (when (= (load (field (elem lst (load i)) name)) nm)
                  (store! r
                          (load i))
                  0)
                (set! i (primitive/iadd (load i) 1)))))
    (load r)))

(defn find-func-named [(lst (ptr (ArrayList Func))) (nm (slice u8))] (-> i64)
  (let [n (len (load lst))
        (mut i) 0
        (mut r) -1]
    (loop (if (>= (load i) n)
              (break)
              (do
                (when (= (load (field (elem lst (load i)) name)) nm)
                  (store! r
                          (load i))
                  0)
                (set! i (primitive/iadd (load i) 1)))))
    (load r)))

(defn gstruct-has [(m (ptr MonoCtx)) (nm (slice u8))] (-> bool)
  (>= (find-struct-named (load (field m gstructs)) nm) 0))

(defn gsum-has [(m (ptr MonoCtx)) (nm (slice u8))] (-> bool)
  (>= (find-sum-named (load (field m gsums)) nm) 0))

(defn gfunc-has [(m (ptr MonoCtx)) (nm (slice u8))] (-> bool)
  (>= (find-func-named (load (field m gfuncs)) nm) 0))

(defn gstruct-arity [(m (ptr MonoCtx)) (nm (slice u8))] (-> i64)
  (len (load (field (elem (load (field m gstructs))
                          (find-struct-named (load (field m
                                                          gstructs))
                                             nm))
                    type_params))))

(defn gsum-arity [(m (ptr MonoCtx)) (nm (slice u8))] (-> i64)
  (len (load (field (elem (load (field m gsums))
                          (find-sum-named (load (field m
                                                       gsums))
                                          nm))
                    type_params))))

(defn gfunc-arity [(m (ptr MonoCtx)) (nm (slice u8))] (-> i64)
  (len (load (field (elem (load (field m gfuncs))
                          (find-func-named (load (field m
                                                        gfuncs))
                                           nm))
                    type_params))))

; variant_to_sum lookup.
(defn variant-sum [(m (ptr MonoCtx)) (func (slice u8))] (-> (Option (slice u8)))
  (let [ns (.vsum-names m)
        ss (.vsum-sums m)
        n (len ns)
        (mut i) 0
        (mut r) (None [(slice u8)])]
    (loop (if (>= (load i) n)
              (break)
              (do
                (when (= (get ns (load i)) func)
                  (store! r (Some (get ss (load i))))
                  (break))
                (set! i (primitive/iadd (load i) 1)))))
    (load r)))

; ---- queues — dedup via the queued set ----------------
(defn io-record! [(m (ptr MonoCtx))
                  (kind i64)
                  (mng (slice u8))
                  (nm (slice u8))
                  (args (ptr (ArrayList Type)))] (-> i64)
  (unless (contains? (load (field m io-index)) mng)
    ; index the new record gets = current length (its slot after the push), so
    ; io-index maps mng -> its position in io-origin, exactly the old parallel index.
    (let [idx (len (load (field m io-origin)))]
      (push! (mut (field m io-origin)) (mk-pend (load (field m a)) nm args))
      (let [origin (primitive/alloc-stack MonoOrigin)]
        (set! (.kind origin) kind)
        (set! (.generated origin) mng)
        (set! (.source origin) nm)
        (set! (.args origin) args)
        (set! (.trait_name origin) "")
        (set! (.impl_source origin) "")
        (push! (mut (field m origins)) (load origin)))
      (set! (mut (field m io-index)) mng idx)
      0)))

(defn io-find [(m (ptr MonoCtx)) (mng (slice u8))] (-> i64)
  (match (get (.io-index m) mng)
    (Some [i] i)
    (None [] -1)))

(defn io-mark-trait! [(m (ptr MonoCtx))
                      (mng (slice u8))
                      (trait-name (slice u8))
                      (impl-source (slice u8))] (-> i64)
  (let [index (io-find m mng)]
    (if (< index 0)
        0
        (let [origin (elem (field m origins) index)]
          (set! (.trait_name origin) trait-name)
          (set! (.impl_source origin) impl-source)
          0))))

(defn trait-use-record! [(m (ptr MonoCtx))
                         (trait-name (slice u8))
                         (impl-source (slice u8))
                         (method-name (slice u8))
                         (generated (slice u8))] (-> i64)
  (let [(mut found) false]
    (for [i 0 (len (.trait_uses m))]
      (let [use (elem (field m trait_uses) i)]
        (if (and (= (.caller_source use) (.current_source m))
                 (and (= (.trait_name use) trait-name)
                      (and (= (.impl_source use) impl-source)
                           (= (.method_name use) method-name))))
            (set! found true)
            0)))
    (if (load found)
        0
        (let [use (primitive/alloc-stack MonoTraitUse)]
          (set! (.caller_source use) (.current_source m))
          (set! (.trait_name use) trait-name)
          (set! (.impl_source use) impl-source)
          (set! (.method_name use) method-name)
          (set! (.generated_artifact use) generated)
          (push! (mut (.trait_uses m)) (load use))
          0))))

; Ownership elaboration needs the semantic generic shape, not only the concrete
; ABI name produced by monomorphization.  The source checking context knows how
; `(Arc T)` is dropped, but it deliberately has no declaration named
; `Arc__Payload`; that name exists only in mono's output program.  Recovering the
; recorded origin lets the shared ownership machinery select the generic Drop
; impl and inspect generic fields before the final expression resolver lowers the
; synthesized glue back to concrete ABI names.
(defn ownership-semantic-type-list [(m (ptr MonoCtx))
                                    (xs (ptr (ArrayList Type)))] (-> (ptr (ArrayList Type)))
  (let [a (.a m)
        n (len (load xs))
        (mut out) (ArrayList::new [Type] a)
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (push! (mut out)
                       (ownership-semantic-type m (elem xs (load i))))
                (set! i (primitive/iadd (load i) 1)))))
    (box-al [Type] a (load out))))

(defn ownership-semantic-type [(m (ptr MonoCtx)) (t (ptr Type))] (-> Type)
  (let [a (.a m)]
    (match (load t)
      (TStruct [name]
               (let [idx (io-find m name)]
                 (if (< idx 0)
                     (load t)
                     (let [origin (elem (field m io-origin) idx)]
                       (TApp (.name origin)
                             (ownership-semantic-type-list m
                                                           (load (field origin
                                                                        args))))))))
      (TPtr [inner] (TPtr (box-type a (ownership-semantic-type m inner))))
      (TRef [mu inner] (TRef mu (box-type a (ownership-semantic-type m inner))))
      (TArray [inner count]
              (TArray (box-type a (ownership-semantic-type m inner)) count))
      (TSlice [inner] (TSlice (box-type a (ownership-semantic-type m inner))))
      (TVec [inner count]
            (TVec (box-type a (ownership-semantic-type m inner)) count))
      (TApp [name args]
            (TApp name (ownership-semantic-type-list m args)))
      (_ (load t)))))

;;; The checker's recorded node types name this instance's type parameters; bind
;;; each to its semantic concrete type so ownership elaboration of the instance
;;; decides Drop for the types its nodes really have.
(defn ownership-instance-subst [(m (ptr MonoCtx)) (map (ptr Subst))] (-> (ptr (ArrayList SubstEntry)))
  (let [a (.a m)
        names (load (field map names))
        types (load (field map types))
        (mut out) (ArrayList::new [SubstEntry] a)]
    (for [i 0 (len (load names))]
      (let [e (primitive/alloc-stack SubstEntry)]
        (set! (.name e) (get (load names) i))
        (set! (.ty e) (ownership-semantic-type m (elem types i)))
        (push! (mut out) (load e))))
    (box-al [SubstEntry] a (load out))))

; ---- runaway instantiation guard --------------------------------------------
; A generic that recurses on a WRAPPED version of its own argument (T -> (Box T) ->
; (Box (Box T)) -> …) never reaches a fixpoint: every round mints a type the dedupe set
; has never seen, so `drain` queues forever. It did so silently — no output, no progress,
; no limit — turning a typo-shaped mistake into a build that never finishes and never
; says why. In CI that eats the whole job.
;
; Type-term DEPTH is the exact signal. Every other way to diverge is already closed:
; identical (name, args) is deduped by the queued-* sets, and constant arguments are
; only ever literals copied from source (type positions never compute, so no `N + 1`
; can mint new ones) — so an unbounded run must grow the term. Real code never nests types
; anywhere near this deep, so the limit only ever fires on a genuine runaway.
(defn ty-depth [(t (ptr Type))] (-> i64)
  (match (load t)
    (TConst [_] 1)
    (TPtr [i] (primitive/iadd 1 (ty-depth i)))
    (TRef [mu i] (primitive/iadd 1 (ty-depth i)))
    (TArray [e n] (primitive/iadd 1 (ty-depth e)))
    (TSlice [e] (primitive/iadd 1 (ty-depth e)))
    (TVec [e n] (primitive/iadd 1 (ty-depth e)))
    (TApp [nm as2] (primitive/iadd 1 (ty-list-depth as2)))
    (TFn [cc ps r] (primitive/iadd 1 (ty-depth r)))
    (TInt [b s] 1)
    (TFloat [b] 1)
    (TBool [] 1)
    (TVoid [] 1)
    (TStruct [n] 1)
    (TNever [] 1)
    (TError [] 1)
    (TCode [] 1)
    (TCodeBuilder [] 1)
    (TExternRef [] 1)))

(defn ty-list-depth [(lst (ptr (ArrayList Type)))] (-> i64)
  (let [n (len (load lst))
        (mut i) 0
        (mut mx) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (let [d (ty-depth (elem lst (load i)))]
                  (when (> d (load mx)) (store! mx d) 0))
                (set! i (primitive/iadd (load i) 1)))))
    (load mx)))

(defn mono-depth-limit [] (-> i64)
  64)

(defn mono-name-limit [] (-> i64)
  512)

; the deepest type argument in this instantiation request
(defn pend-depth [(args (ptr (ArrayList Type)))] (-> i64)
  (ty-list-depth args))

; Two views of the same thing — the type TERM got too big:
;   depth: catches growth still shaped as a term, e.g. (Box (Box (Box …))) as a TApp.
;   name:  catches growth AFTER substitution, which is the case that actually fires.
;          Mono rewrites (Box T) to a TStruct whose mangled NAME carries the nesting
;          (Box$i64 -> Box$Box$i64 -> …), so the term depth stays 1 while the term size
;          grows without bound. Measuring depth alone silently misses the real runaway.
(defn mono-runaway? [(args (ptr (ArrayList Type))) (mng (slice u8))] (-> bool)
  (or (> (pend-depth args) (mono-depth-limit))
      (> (len mng) (mono-name-limit))))

; Show the growth rather than just asserting it: the mangled name spells the nesting
; out (Box$Box$Box$…), which is the one thing that makes the mistake obvious. Truncated
; — at depth 64 it is thousands of characters.
(defn mono-runaway-diag [(a (dyn Allocator))
                         (what (slice u8))
                         (nm (slice u8))
                         (mng (slice u8))] (-> Diag)
  (let [shown
          (if (> (len mng) 100)
              (sconcat a (subslice mng 0 100) " …")
              mng)]
    (derr (sconcat3 a
                    (sconcat3 a
                              "monomorphization: "
                              what
                              (sconcat3 a
                                        " '"
                                        nm
                                        "' is being instantiated with an ever-growing type, so it never reaches a fixpoint. A generic that recurses on a WRAPPED version of its own argument (T -> (Box T) -> (Box (Box T)) -> …) mints a type nobody has seen every round and instantiates forever. Last instantiation: "))
                    shown
                    ""))))

(defn queue-struct [(m (ptr MonoCtx))
                    (nm (slice u8))
                    (args (ptr (ArrayList Type)))] (-> i64)
  (let [a (.a m)
        mng (mangle a nm args)]
    (io-record! m 2 mng nm args)
    (unless (contains? (load (field m queued-structs)) mng)
      (set! (mut (field m queued-structs)) mng 0)
      (push! (mut (field m pending-structs)) (mk-pend a nm args))
      0)))

(defn queue-sum [(m (ptr MonoCtx))
                 (nm (slice u8))
                 (args (ptr (ArrayList Type)))] (-> i64)
  (let [a (.a m)
        mng (mangle a nm args)]
    (io-record! m 3 mng nm args)
    (unless (contains? (load (field m queued-sums)) mng)
      (set! (mut (field m queued-sums)) mng 0)
      (push! (mut (field m pending-sums)) (mk-pend a nm args))
      0)))

(defn queue-func [(m (ptr MonoCtx))
                  (nm (slice u8))
                  (args (ptr (ArrayList Type)))] (-> i64)
  (let [a (.a m)
        mng (mangle a nm args)]
    ; Keep the origin for the post-ownership resolve pass. Ownership elaboration
    ; runs after the first generic substitution and may introduce EMovePlace at
    ; an already-mangled call. Recovering the source generic signature here is
    ; what lets that second pass choose value bits versus a pointer ABI correctly.
    (io-record! m 1 mng nm args)
    (unless (contains? (load (field m queued-funcs)) mng)
      (set! (mut (field m queued-funcs)) mng 0)
      (push! (mut (field m pending-funcs)) (mk-pend a nm args))
      0)))

; "<prefix> expects N type arguments, got M" — the shared arity-error shape.
(defn arity-err [(a (dyn Allocator)) (prefix (slice u8)) (n i64) (m i64)] (-> (slice u8))
  (sconcat a
           prefix
           (sconcat a
                    " expects "
                    (sconcat a
                             (i64->str a n)
                             (sconcat a " type arguments, got " (i64->str a m))))))

; ---- resolve_ty — substitute params, mangle generic apps ------
(defn resolve-ty-list [(m (ptr MonoCtx))
                       (lst (ptr (ArrayList Type)))
                       (map (ptr Subst))] (-> (Result (ptr (ArrayList Type))
                                                      Diag))
  (let [a (.a m)
        n (len (load lst))
        (mut out) (ArrayList::new [Type] a)
        (mut i) 0
        (mut err) (primitive/zeroed Diag)
        (mut failed) false]
    (loop (if (>= (load i) n)
              (break)
              (do
                (match (resolve-ty m (elem lst (load i)) map)
                  (Err [d] (do (set! err d) (set! failed true) (break)))
                  (Ok [t]
                      (let [tp (box-type a t)]
                        (if (pack-value? tp)
                            (let [xs (t-app-args tp)
                                  nx (len (load xs))
                                  (mut j) 0]
                              (loop (if (>= (load j) nx)
                                        (break)
                                        (do
                                          (push! (mut out)
                                                 (get (load xs) (load j)))
                                          (set! j (primitive/iadd (load j) 1))))))
                            (push! (mut out) t)))))
                (set! i (primitive/iadd (load i) 1)))))
    (if (load failed)
        (Err [(ptr (ArrayList Type)) Diag] (load err))
        (Ok (box-al [Type] a (load out))))))

; Generic type-argument vectors retain one entry per declared parameter.  A pack
; substitution is therefore kept as one `$pack` entry here; only ABI/type
; sequences use resolve-ty-list's splicing behavior.
(defn resolve-ty-args [(m (ptr MonoCtx))
                       (lst (ptr (ArrayList Type)))
                       (map (ptr Subst))] (-> (Result (ptr (ArrayList Type))
                                                      Diag))
  (let [a (.a m)
        n (len (load lst))
        (mut out) (ArrayList::new [Type] a)
        (mut i) 0
        (mut err) (primitive/zeroed Diag)
        (mut failed) false]
    (loop (if (>= (load i) n)
              (break)
              (do
                (match (resolve-ty m (elem lst (load i)) map)
                  (Err [d] (do (set! err d) (set! failed true) (break)))
                  (Ok [t] (push! (mut out) t)))
                (set! i (primitive/iadd (load i) 1)))))
    (if (load failed)
        (Err [(ptr (ArrayList Type)) Diag] (load err))
        (Ok (box-al [Type] a (load out))))))

(defn resolve-ty-app [(m (ptr MonoCtx)) (t (ptr Type)) (map (ptr Subst))] (-> (Result Type
                                                                                      Diag))
  (let [a (.a m)
        nm (t-app-name t)]
    (if (= nm "$pack-var")
        (match (subst-lookup map
                             (type-struct-name (elem (t-app-args t) 0)))
          (Some [v] (Ok v))
          (None []
                (Err [Type Diag]
                     (derr "internal: unbound type pack during monomorphization"))))
        (if (= nm "$pack")
            (resolve-pack m t map)
            (match (resolve-ty-list m (t-app-args t) map)
              (Err [d] (Err [Type Diag] d))
              (Ok [rargs]
                  (let [mng (mangle a nm rargs)
                        rlen (len (load rargs))]
                    (if (gstruct-has m nm)
                        (let [ar (gstruct-arity m nm)]
                          (if (not (= ar rlen))
                              (Err [Type Diag]
                                   (derr (arity-err a
                                                    (sconcat3 a
                                                              "generic type '"
                                                              nm
                                                              "'")
                                                    ar
                                                    rlen)))
                              (do (queue-struct m nm rargs) (Ok (TStruct mng)))))
                        (if (gsum-has m nm)
                            (let [ar (gsum-arity m nm)]
                              (if (not (= ar rlen))
                                  (Err [Type Diag]
                                       (derr (arity-err a
                                                        (sconcat3 a
                                                                  "generic type '"
                                                                  nm
                                                                  "'")
                                                        ar
                                                        rlen)))
                                  (do (queue-sum m nm rargs) (Ok (TStruct mng)))))
                            (Err [Type Diag]
                                 (derr (sconcat3 a
                                                 "unknown generic type '"
                                                 nm
                                                 "'"))))))))))))

;;; A concrete type pack, `$pack [A B …]`, with its element types specialized. In
;;; a generic body one may name the body's own type parameters -- the argument
;;; list of a function pointer `(fnptr c [T] R)` called there -- and a pack
;;; variable among them stands for its whole pack, spliced in place.
(defn resolve-pack [(m (ptr MonoCtx)) (t (ptr Type)) (map (ptr Subst))] (-> (Result Type Diag))
  (try (let [a (.a m)
             elems (t-app-args t)
             (mut out) (ArrayList::new [Type] a)]
         (for [i 0 (len (load elems))]
           (let [e (elem elems i)
                 spliced (and (= (type-tag e) 11) (= (t-app-name e) "$pack-var"))
                 r (try! (resolve-ty m e map))]
             (if (and spliced (and (= (type-tag (box-type a r)) 11)
                                   (= (t-app-name (box-type a r)) "$pack")))
                 (for [j 0 (len (load (t-app-args (box-type a r))))]
                   (push! (mut out) (get (load (t-app-args (box-type a r))) j)))
                 (push! (mut out) r))))
         (Ok [Type Diag] (TApp "$pack" (box-al [Type] a (load out)))))))

; A specialized extent is a literal: positive for a vector's width, and for an
; array's length (`zero`) not negative.
(defn resolve-extent [(m (ptr MonoCtx)) (n Extent) (map (ptr Subst)) (zero bool)] (-> (Result Extent Diag))
  (let [a (.a m)]
    (match (resolve-ty m (box-type a (extent-type n)) map)
      (Err [d] (Err [Extent Diag] d))
      (Ok [resolved]
        (match resolved
          (TConst [v]
            (match v
              (ConstInt [k]
                (cond (> k 0) (Ok (FixedExtent k))
                      (and zero (= k 0)) (Ok (FixedExtent k))
                      zero (Err [Extent Diag] (derr "array length cannot be negative"))
                      :else (Err [Extent Diag] (derr "vector width must be positive"))))
              (_ (Err [Extent Diag] (derr "array length or vector width must specialize to an integer")))))
          (_ (Err [Extent Diag] (derr "array length or vector width must specialize to an integer"))))))))

(defn resolve-ty [(m (ptr MonoCtx)) (t (ptr Type)) (map (ptr Subst))] (-> (Result Type
                                                                                  Diag))
  (let [a (.a m)
        tg (type-tag t)]
    (cond (= tg 12) (Ok (TNever))
          (= tg 13) (Ok (TCode))
          (= tg 14) (Ok (TExternRef))
          (= tg 15) (Ok (TCodeBuilder))
          (= tg 16) (Ok (load t))
          (= tg 3) (Ok (TVoid))
          (= tg 0)
            (Ok (TInt (t-int-bits t) (t-int-signed t)))
          (= tg 1) (Ok (TFloat (t-int-bits t)))
          (= tg 2) (Ok (TBool))
          (= tg 4)
            (match (resolve-ty m (t-inner t) map)
              (Err [d] (Err [Type Diag] d))
              (Ok [it] (Ok (TPtr (box-type a it)))))
          (= tg 5)
            (match (resolve-ty m (t-inner t) map)
              (Err [d] (Err [Type Diag] d))
              (Ok [it] (Ok (TRef (t-ref-mut t) (box-type a it)))))
          (= tg 7)
            (match (resolve-ty m (t-inner t) map)
              (Err [d] (Err [Type Diag] d))
              (Ok [it]
                (match (resolve-extent m (array-extent-of-type t) map true)
                  (Err [d] (Err [Type Diag] d))
                  (Ok [n] (Ok (TArray (box-type a it) n))))))
          (= tg 8)
            (match (resolve-ty m (t-inner t) map)
              (Err [d] (Err [Type Diag] d))
              (Ok [it] (Ok (TSlice (box-type a it)))))
          (= tg 9)
            (match (resolve-ty m (t-inner t) map)
              (Err [d] (Err [Type Diag] d))
              (Ok [it]
                (match (resolve-extent m (vector-width-of-type t) map false)
                  (Err [d] (Err [Type Diag] d))
                  (Ok [n] (Ok (TVec (box-type a it) n))))))
          (= tg 10)
            (match (resolve-ty-list m (t-fn-params t) map)
              (Err [d] (Err [Type Diag] d))
              (Ok [ps]
                  (match (resolve-ty m (t-fn-ret t) map)
                    (Err [d] (Err [Type Diag] d))
                    (Ok [r]
                        (Ok (TFn
                              :cc (t-fn-cc t)
                              :params ps
                              :ret (box-type a (never-returns-void r))))))))
          (= tg 6)
            (match (subst-lookup map (type-struct-name t))
              (Some [ct] (Ok ct))
              (None [] (Ok (TStruct (type-struct-name t)))))
          :else (resolve-ty-app m t map))))

; ---- resolve a sum / its variants -----------------
(defn resolve-fields [(m (ptr MonoCtx))
                      (fs (ptr (ArrayList Field)))
                      (map (ptr Subst))] (-> (Result (ptr (ArrayList Field))
                                                     Diag))
  (let [a (.a m)
        n (len (load fs))
        (mut out) (ArrayList::new [Field] a)
        (mut i) 0
        (mut err) (primitive/zeroed Diag)
        (mut failed) false]
    (loop (if (>= (load i) n)
              (break)
              (do
                (let [fp (elem fs (load i))]
                  (match (resolve-ty m (field fp ty) map)
                    (Err [d] (do (set! err d) (set! failed true) (break)))
                    (Ok [t] (push! (mut out) (mk-field (.name fp) t)))))
                (set! i (primitive/iadd (load i) 1)))))
    (if (load failed)
        (Err [(ptr (ArrayList Field)) Diag] (load err))
        (Ok (box-al [Field] a (load out))))))

(defn resolve-param-one [(m (ptr MonoCtx))
                         (pp (ptr Param))
                         (ty Type)
                         (map (ptr Subst))] (-> (Result Param Diag))
  (try (let [a (load (field m a))
             np (primitive/alloc-stack Param)]
         (set! np (mk-param-bid (.name pp) ty (.bid pp)))
         (set! (.positional_only np) (.positional_only pp))
         (unless (= (primitive/cast i64 (.owned_type pp))
                    0)
           ; `ty` is the already-substituted semantic parameter type. Using it
           ; directly also avoids retaining a stale generic marker when the
           ; checked body representation differed from the signature type.
           (let [resolved-owner (try! (resolve-ty m (.owned_type pp) map))
                 concrete (box-type a resolved-owner)
                 rp (box-type a (ownership-semantic-type m concrete))]
             (when (type-is-affine a (load (field m ownership_cx)) rp)
               (set! (.owned_type np) rp)
               0))
           0)
         (Ok [Param Diag] (load np)))))

(defn resolve-params [(m (ptr MonoCtx))
                      (ps (ptr (ArrayList Param)))
                      (map (ptr Subst))] (-> (Result (ptr (ArrayList Param))
                                                     Diag))
  (let [a (.a m)
        n (len (load ps))
        (mut out) (ArrayList::new [Param] a)
        (mut i) 0
        (mut err) (primitive/zeroed Diag)
        (mut failed) false]
    (loop (if (>= (load i) n)
              (break)
              (do
                (let [pp (elem ps (load i))]
                  (match (resolve-ty m (field pp ty) map)
                    (Err [d] (do (set! err d) (set! failed true) (break)))
                    (Ok [t]
                        (let [tp (box-type a t)]
                          (if (pack-value? tp)
                              (let [xs (t-app-args tp)
                                    nx (len (load xs))
                                    (mut j) 0]
                                (loop (if (>= (load j) nx)
                                          (break)
                                          (do
                                            (push! (mut out)
                                                   (mk-param (indexed-name a
                                                                           (dots-base (.name pp))
                                                                           (load j))
                                                             (get (load xs)
                                                                  (load j))))
                                            (set! j (primitive/iadd (load j) 1))))))
                              (match (resolve-param-one m pp t map)
                                (Err [d]
                                     (do
                                       (set! err d)
                                       (set! failed true)
                                       (break)))
                                (Ok [np] (push! (mut out) np))))))))
                (set! i (primitive/iadd (load i) 1)))))
    (if (load failed)
        (Err [(ptr (ArrayList Param)) Diag] (load err))
        (Ok (box-al [Param] a (load out))))))

(defn resolve-sum [(m (ptr MonoCtx))
                   (s (ptr SumDef))
                   (map (ptr Subst))
                   (name (slice u8))] (-> (Result SumDef Diag))
  (let [a (.a m)
        vs (load (field s variants))
        n (len vs)
        (mut out) (ArrayList::new [Variant] a)
        (mut i) 0
        (mut err) (primitive/zeroed Diag)
        (mut failed) false]
    (loop (if (>= (load i) n)
              (break)
              (do
                (let [vp (elem vs (load i))]
                  (match (resolve-fields m (load (field vp fields)) map)
                    (Err [d] (do (set! err d) (set! failed true) (break)))
                    (Ok [nfs] (push! (mut out) (mk-variant (.name vp) nfs)))))
                (set! i (primitive/iadd (load i) 1)))))
    (if (load failed)
        (Err [SumDef Diag] (load err))
        (let [ns (primitive/alloc-stack SumDef)]
          (set! (.submission_only ns) (.submission_only s))
          (set! (.name ns) name)
          (set! (.type_params ns)
                (box-al [(slice u8)] a (ArrayList::new [(slice u8)] a)))
          (set! (.bounds ns) (box-al [Bound] a (ArrayList::new [Bound] a)))
          (set! (.variants ns) (box-al [Variant] a (load out)))
          (Ok (load ns))))))

; A generic `T` parameter is checked with value ABI because its representation is
; unknown. If substitution makes it an affine aggregate, preserve that external
; ABI but immediately materialize it into the pointer-backed owning place expected
; by drop elaboration and by the instantiated body.
(defn materialize-generic-owner-params [(m (ptr MonoCtx))
                                        (params (ptr (ArrayList Param)))
                                        (body (ptr (ArrayList Expr)))] (-> (ptr (ArrayList Expr)))
  (let [a (.a m)
        n (len (load params))
        (mut binds) (ArrayList::new [Bind] a)
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (let [pp (elem params (load i))
                      owner-type (.owned_type pp)]
                  (when (and (!= (primitive/cast i64 owner-type)
                                 0)
                             (match (.ty pp)
                               (TStruct [_] true)
                               (TApp [_ _] true)
                               (TArray [_ _] true)
                               (_ false)))
                    (let [name (.name pp)
                          raw-name (sconcat a "$owned.in." name)
                          slot-name (sconcat a "$owned.slot." name)
                          (mut init) (ArrayList::new [Expr] a)
                          owner-bind (primitive/alloc-stack Bind)]
                      (set! (.name pp) raw-name)
                      (set! (.owned_type pp) (primitive/cast (ptr Type) 0))
                      (push! (mut binds)
                             (mk-bind slot-name
                                      false
                                      (mk-expr (EAlloc
                                                 :symbol (None)
                                                 :storage 3
                                                 :ty (load owner-type)
                                                 :init
                                                   (primitive/cast (ptr Expr) 0))
                                               -1
                                               -1
                                               -1
                                               0)))
                      (push! (mut init)
                             (mk-expr (EInitStore (box-expr a
                                                            (mk-expr (EVar slot-name)
                                                                     -1
                                                                     -1
                                                                     -1
                                                                     0))
                                                  (box-expr a
                                                            (mk-expr (EVar raw-name)
                                                                     -1
                                                                     -1
                                                                     -1
                                                                     0)))
                                      -1
                                      -1
                                      -1
                                      0))
                      (push! (mut init) (mk-expr (EVar slot-name) -1 -1 -1 0))
                      (set! owner-bind
                            (mk-bind name
                                     false
                                     (mk-expr (EDo (box-al [Expr] a (load init)))
                                              -1
                                              -1
                                              -1
                                              0)))
                      (set! (.bid owner-bind) (.bid pp))
                      (set! (.owned_type owner-bind) owner-type)
                      (push! (mut binds) (load owner-bind))
                      0))
                  (set! i (primitive/iadd (load i) 1))))))
    (if (= (len (load binds)) 0)
        body
        (let [(mut wrapped) (ArrayList::new [Expr] a)
              (mut inner) (ArrayList::new [Expr] a)]
          ; The body was checked with each such parameter a VALUE; its name now
          ; denotes the owning slot, so every use reads the slot, as a concrete
          ; owner parameter's uses do.
          (for [k 0 (len (load binds))]
            (let [name (.name (elem (mut binds) k))]
              (unless (starts-with name "$owned.slot.")
                (for [j 0 (len (load body))]
                  (owner-param-uses-load! a (elem body j) name))
                0)))
          (if (= (len (load body)) 0)
              (push! (mut inner)
                     (mk-expr (EDo (box-al [Expr] a (ArrayList::new [Expr] a)))
                              -1
                              -1
                              -1
                              0))
              (for [j 0 (len (load body))]
                (push! (mut inner) (get (load body) j))
                0))
          (push! (mut wrapped)
                 (mk-expr (ELet (box-al [Bind] a (load binds))
                                (box-al [Expr] a (load inner)))
                          -1
                          -1
                          -1
                          0))
          (box-al [Expr] a (load wrapped))))))

;;; Rewrite each use of the variable `name` in `e` to a load of it, except where
;;; a binding inside `e` shadows it.
(defn owner-param-uses-load! [(a (dyn Allocator)) (e (ptr Expr)) (name (slice u8))] (-> i64)
  (match (.kind e)
    (EVar [n]
          (when (= n name)
            (let [place (box-expr a (load e))]
              (set! (.kind e) (ELoad place))
              0)))
    (ELet [binds body]
          (let [(mut shadowed) false]
            (for [i 0 (len (load binds))]
              (unless (load shadowed)
                (let [bp (elem binds i)]
                  (owner-param-uses-load! a (field bp value) name)
                  (when (= (.name bp) name) (set! shadowed true))
                  0)))
            (unless (load shadowed)
              (for [i 0 (len (load body))]
                (owner-param-uses-load! a (elem body i) name)))
            0))
    (EMatch [scrut arms]
            (do
              (owner-param-uses-load! a scrut name)
              (for [i 0 (len (load arms))]
                (let [arm (elem arms i)]
                  (unless (block :binds
                            (for [j 0 (len (load (.binds arm)))]
                              (when (= (get (load (.binds arm)) j) name) (break :binds true)))
                            false)
                    (owner-param-uses-load! a (field arm body) name))
                  0))
              0))
    ; a lifted function's body is its own
    (EAnonFn [_ _] 0)
    (_ (let [(mut kids) (ArrayList::new [(ptr Expr)] a)]
         (ownership-children! e (mut kids))
         (for [i 0 (len kids)]
           (owner-param-uses-load! a (get kids i) name))
         0)))
  0)

; ---- resolve a function --------------------------
(defn resolve-func [(m (ptr MonoCtx))
                    (f (ptr Func))
                    (map (ptr Subst))
                    (name (slice u8))] (-> (Result Func Diag))
  (let [a (.a m)]
    (set! (.current_source m) (.name f))
    (match (resolve-params m (load (field f params)) map)
      (Err [d] (Err [Func Diag] d))
      (Ok [params]
          (match (resolve-ty m (field f ret) map)
            (Err [d] (Err [Func Diag] d))
            (Ok [ret]
                (match (resolve-expr-list m (load (field f body)) map)
                  (Err [d] (Err [Func Diag] d))
                  (Ok [body]
                      (let [nf (primitive/alloc-stack Func)]
                        (set! (.name nf) name)
                        (set! (.type_params nf)
                              (box-al [(slice u8)] a (ArrayList::new [(slice u8)] a)))
                        (set! (.bounds nf)
                              (box-al [Bound] a (ArrayList::new [Bound] a)))
                        (set! (.cc nf) (.cc f))
                        (set! (.annotations nf) (load (field f annotations)))
                        (set! (.params nf) params)
                        (set! (.ret nf) (never-returns-void ret))
                        (set! (.body nf)
                              (materialize-generic-owner-params m params body))
                        (set! (.macro_variadic nf) false)
                        (set! (.declared nf) (.declared f))
                        (set! (.lo nf) (.lo f))
                        (set! (.source nf) (.source f))
                        (set! (.ctxt nf) (.ctxt f))
                        (set! (.hi nf) (.hi f))
                        (Ok (load nf)))))))))))

;;; `(fnptr-of f [T…])` with the type arguments of this specialization: the
;;; instance of `f` at them, queued like a call's, and a pointer to it. Its type
;;; takes a parameter of type `T` by value, as a `c` pointer does, and so does the
;;; instance; where the instance takes an argument by reference that the pointer
;;; passes by value, the pointer is to a by-value C entry (`instance-c-entry!`).
(defn fnptr-inst [(m (ptr MonoCtx))
                  (nm (slice u8))
                  (targs (ptr (ArrayList Type)))
                  (map (ptr Subst))] (-> (Result ExprKind Diag))
  (try (let [a (.a m)]
         (unless (gfunc-has m nm)
           (break :try (Err [ExprKind Diag]
                            (derr (sconcat3 a "fnptr-of '" nm "': no generic function by that name (compiler bug)")))))
         (let [rtargs (try! (resolve-ty-args m targs map))
               gf (elem (load (field m gfuncs)) (find-func-named (load (field m gfuncs)) nm))
               mng (mangle a nm rtargs)]
           (when (not (= (len (load rtargs)) (gfunc-arity m nm)))
             (break :try (Err [ExprKind Diag]
                              (derr (arity-err a (sconcat3 a "generic function '" nm "'")
                                               (gfunc-arity m nm) (len (load rtargs)))))))
           (try! (register-monomorphized-call-sig! m gf rtargs mng))
           (queue-func m nm rtargs)
           (try! (instance-c-entry! m gf rtargs mng))
           (Ok (EFnPtrOf mng))))))

;;; Record the by-value C entry of instance `mng` of `gf`, when the function
;;; pointer's type takes by value a struct or sum that the instance takes by
;;; reference. A parameter declared as a bare type parameter is taken by value by
;;; the instance as well, so the pointer is to the instance itself; a struct
;;; parameter of a lifted anonymous function is taken by reference, and so is one
;;; that may own (`(Option T)`): the pointer takes it by value, the body by its
;;; place. Those are reached through the entry.
(defn instance-c-entry! [(m (ptr MonoCtx))
                         (gf (ptr Func))
                         (rtargs (ptr (ArrayList Type)))
                         (mng (slice u8))] (-> (Result i64 Diag))
  (try (let [a (.a m)
             cx (.ownership_cx m)
             sg (sig-find cx (.name gf))
             tparams (load (field gf type_params))
             smap (subst-map a tparams rtargs)
             params (load (field gf params))
             (mut surface) (ArrayList::new [Type] a)
             (mut needed) false]
         (for [i 0 (len (load params))]
           (let [pp (elem params i)
                 owner (.owned_type pp)
                 bare-param (match (load (field pp ty))
                              (TStruct [n] (set-contains tparams n))
                              (_ false))
                 ; A parameter that may own is a struct or sum the pointer takes by
                 ; value (`(Option T)`), and the body by reference: resolved, it is
                 ; an instantiated aggregate whatever its arguments are.
                 owned-aggregate (and (not bare-param)
                                      (!= (primitive/cast i64 owner) 0)
                                      (match (load owner)
                                        (TStruct [_] true)
                                        (TApp [_ _] true)
                                        (_ false)))
                 declared (try! (resolve-ty m (field pp ty) smap))
                 shown (cond owned-aggregate (try! (resolve-ty m owner smap))
                             (and (!= (primitive/cast i64 sg) 0)
                                  (< i (len (load (.fnptr_params sg)))))
                               (try! (resolve-ty m (elem (.fnptr_params sg) i) smap))
                             :else declared)
                 by-reference (match declared (TRef [_ _] true) (TPtr [_] true) (_ false))]
             (when (or owned-aggregate
                       (and by-reference (by-value-c-entry-param? cx (box-type a shown))))
               (set! needed true))
             (push! (mut surface) shown)))
         (when (and (load needed)
                    (not (block :seen
                           (for [i 0 (len (.instance_entries m))]
                             (when (= (.name (elem (field m instance_entries) i)) mng)
                               (break :seen true)))
                           false)))
           (push! (mut (field m instance_entries))
                  (ExportC :name mng
                           :symbol (Some (sconcat a mng ".c"))
                           :params (box-al [Type] a (load surface))
                           :published false
                           :lo (.lo gf)
                           :hi (.hi gf)
                           :source (.source gf)
                           :ctxt (.ctxt gf))))
         (Ok [i64 Diag] 0))))

; ---- resolve expressions -------------------------
(defn resolve-expr-list [(m (ptr MonoCtx))
                         (lst (ptr (ArrayList Expr)))
                         (map (ptr Subst))] (-> (Result (ptr (ArrayList Expr))
                                                        Diag))
  (let [a (.a m)
        n (len (load lst))
        (mut out) (ArrayList::new [Expr] a)
        (mut i) 0
        (mut err) (primitive/zeroed Diag)
        (mut failed) false]
    (loop (if (>= (load i) n)
              (break)
              (do
                (let [ep (elem lst (load i))]
                  (match (.kind ep)
                    (EVar [nm]
                          (if (dots-name? nm)
                              (let [pack (subst-pack map)]
                                (if (= (primitive/cast i64 pack)
                                       0)
                                    (do
                                      (set! err
                                            (derr "internal: value-pack expansion without a type-pack substitution"))
                                      (set! failed true))
                                    (let [np (len (load pack))
                                          (mut j) 0]
                                      (loop (if (>= (load j) np)
                                                (break)
                                                (do
                                                  (push! (mut out)
                                                         (mk-expr (EVar (indexed-name a
                                                                                      (dots-base nm)
                                                                                      (load j)))
                                                                  (.lo ep)
                                                                  (.hi ep)
                                                                  (.source ep)
                                                                  (.ctxt ep)))
                                                  (set! j
                                                        (primitive/iadd (load j)
                                                                        1))))))))
                              (match (resolve-expr m ep map)
                                (Err [d] (do (set! err d) (set! failed true)))
                                (Ok [e] (push! (mut out) e)))))
                    (_ (match (resolve-expr m ep map)
                         (Err [d] (do (set! err d) (set! failed true)))
                         (Ok [e] (push! (mut out) e))))))
                (set! i (primitive/iadd (load i) 1)))))
    (if (load failed)
        (Err [(ptr (ArrayList Expr)) Diag] (load err))
        (Ok (box-al [Expr] a (load out))))))

(defn take-owner-type-in-list [(items (ptr (ArrayList Expr))) (i i64) (n i64)] (-> (ptr Type))
  (if (>= i n)
      (primitive/cast (ptr Type) 0)
      (let [found (take-owner-type-in-expr (elem items i))]
        (if (!= (primitive/cast i64 found) 0)
            found
            (take-owner-type-in-list items (+ i 1) n)))))

(defn take-owner-type-in-expr [(ep (ptr Expr))] (-> (ptr Type))
  (match (.kind ep)
    (ECall [func type-args _]
           (if (and (or (core-name? func "take!")
                        (core-name-prefix? func "take!__"))
                    (> (len (load type-args)) 0))
               (elem type-args 0)
               (primitive/cast (ptr Type) 0)))
    (EDo [items]
         (take-owner-type-in-list items 0 (len (load items))))
    (EDefer [_ items]
            (take-owner-type-in-list items 0 (len (load items))))
    (EStore [_ value] (take-owner-type-in-expr value))
    (EInitStore [_ value] (take-owner-type-in-expr value))
    (ESpillRef [value] (take-owner-type-in-expr value))
    (_ (primitive/cast (ptr Type) 0))))

(defn resolve-bind [(m (ptr MonoCtx)) (bp (ptr Bind)) (map (ptr Subst))] (-> (Result Bind
                                                                                     Diag))
  (try (let [a (load (field m a))
             ne (try! (resolve-expr m (field bp value) map))
             nb (primitive/alloc-stack Bind)]
         (set! nb (mk-bind (.name bp) (.mutable bp) ne))
         (set! (.bid nb) (.bid bp))
         (let [(mut source-owner) (.owned_type bp)
               (mut recovered-take) false]
           ; Generic checking cannot always prove that the result of `take!` is
           ; affine before T is substituted. The intrinsic's explicit type
           ; argument is authoritative, so recover it for concrete ownership
           ; elaboration instead of losing the moved value's cleanup.
           (when (= (primitive/cast i64 (load source-owner))
                    0)
             (set! source-owner (take-owner-type-in-expr (field bp value)))
             (when (!= (primitive/cast i64 (load source-owner))
                       0)
               (set! recovered-take true)
               0)
             0)
           (unless (= (primitive/cast i64 (load source-owner))
                      0)
             (let [resolved (try! (resolve-ty m (load source-owner) map))
                   concrete (box-type a resolved)
                   rp (box-type a (ownership-semantic-type m concrete))]
               (when (or (load recovered-take)
                         (type-is-affine a (load (field m ownership_cx)) rp))
                 (set! (.owned_type nb) rp)
                 0))
             0))
         (Ok [Bind Diag] (load nb)))))

(defn resolve-bind-list [(m (ptr MonoCtx))
                         (binds (ptr (ArrayList Bind)))
                         (map (ptr Subst))] (-> (Result (ptr (ArrayList Bind))
                                                        Diag))
  (let [a (.a m)
        n (len (load binds))
        (mut out) (ArrayList::new [Bind] a)
        (mut i) 0
        (mut err) (primitive/zeroed Diag)
        (mut failed) false]
    (loop (if (>= (load i) n)
              (break)
              (do
                (let [bp (elem binds (load i))]
                  (match (resolve-bind m bp map)
                    (Err [d] (do (set! err d) (set! failed true) (break)))
                    (Ok [nb] (push! [Bind] (mut out) nb))))
                (set! i (primitive/iadd (load i) 1)))))
    (if (load failed)
        (Err [(ptr (ArrayList Bind)) Diag] (load err))
        (Ok (box-al [Bind] a (load out))))))

(defn resolve-arm-list [(m (ptr MonoCtx))
                        (arms (ptr (ArrayList Arm)))
                        (map (ptr Subst))] (-> (Result (ptr (ArrayList Arm))
                                                       Diag))
  (let [a (.a m)
        n (len (load arms))
        (mut out) (ArrayList::new [Arm] a)
        (mut i) 0
        (mut err) (primitive/zeroed Diag)
        (mut failed) false]
    (loop (if (>= (load i) n)
              (break)
              (do
                (let [ap (elem arms (load i))]
                  (match (resolve-expr m (field ap body) map)
                    (Err [d] (do (set! err d) (set! failed true) (break)))
                    (Ok [nb]
                        (push! (mut out)
                               (mk-arm (.variant ap)
                                       (load (field ap
                                                    binds))
                                       nb)))))
                (set! i (primitive/iadd (load i) 1)))))
    (if (load failed)
        (Err [(ptr (ArrayList Arm)) Diag] (load err))
        (Ok (box-al [Arm] a (load out))))))

; The ECall arm: variant construction / generic-fn call / plain call.
(defn move-args-to-values! [(a (dyn Allocator))
                            (args (ptr (ArrayList Expr)))] (-> i64)
  (for [i 0 (len (load args))]
    (let [arg (elem args i)]
      (match (.kind arg)
        (EMovePlace [place] (set! (.kind arg) (ELoad place)))
        ; Type checking uses the ordinary aggregate-call ABI while variants are
        ; still represented as calls, so an aggregate rvalue is materialized as
        ; `ESpillRef value`. EConstruct stores field VALUES, not pointers to those
        ; temporary values; recover the expression that was spilled.
        (ESpillRef [value] (set! (.kind arg) (.kind value)))
        (_ 0)))
    0)
  0)

(defn move-args-to-places! [(args (ptr (ArrayList Expr)))] (-> i64)
  (for [i 0 (len (load args))]
    (let [arg (elem args i)]
      (match (.kind arg)
        (EMovePlace [place] (set! (.kind arg) (.kind place)))
        (_ 0)))
    0)
  0)

; A trait method parameter the TRAIT declares as a reference or raw pointer was
; already passed as one by the checker.
(defn trait-abi-place-param? [(t (ptr Type))] (-> bool)
  (match (load t)
    (TRef [_ _] true)
    (TPtr [_] true)
    (_ false)))

; A trait call survives to monomorphization only when its receiver was a generic
; type parameter, so its arguments were checked against the TRAIT method's
; declared parameters. Reconcile them with the implementing method's own
; signature here. A parameter the trait spells by value over its own type
; parameters (`Self`, or an extra such as a state machine's `Event`) has no known
; representation before substitution, so the checker gave it VALUE ABI; the
; implementing method takes it as `(ref T)` when T is a plain aggregate (Coil's
; implicit immutable reference) or when the impl borrows an owner the trait would
; let it consume. Either way the callee needs an address, so materialize the
; argument into a place. Without this the instance hands an aggregate VALUE to a
; pointer parameter: the LLVM backend quietly spills it on some call paths and
; fails module verification on others, while the native backends pass the
; aggregate's first word as the address.
(defn adjust-trait-call-abi! [(m (ptr MonoCtx))
                              (td (ptr TraitDef))
                              (impl-fn (slice u8))
                              (impl-targs (ptr (ArrayList Type)))
                              (method (slice u8))
                              (args (ptr (ArrayList Expr)))] (-> (Result i64 Diag))
  (let [a (.a m)
        cx (load (field m ownership_cx))]
    (if (= (primitive/cast i64 td) 0)
        (Ok [i64 Diag] 0)
        (let [tm (trait-method-find td method)
              sg (sig-find cx impl-fn)]
          (cond (= (primitive/cast i64 tm) 0)
                  (Ok [i64 Diag] 0)
                (= (primitive/cast i64 sg) 0)
                  (Err [i64 Diag]
                       (derr (sconcat3 a
                                       "mono: no signature for the implementing method '"
                                       impl-fn
                                       "' of a trait call (compiler bug)")))
                :else
                  (let [tps (load (field tm params))
                        ips (load (field sg params))
                        n (len (load args))
                        no-tps (box-al [(slice u8)] a (ArrayList::new [(slice u8)] a))
                        binds (subst-new a)]
                    ; A generic impl's signature names its own type parameters;
                    ; whether such a parameter is passed as a reference is known
                    ; only for the concrete instance this call selected.
                    (for [k 0 (len (load (field sg type_params)))]
                      (when (< k (len (load impl-targs)))
                        (subst-insert! binds
                                       (get (load (field sg type_params)) k)
                                       (elem impl-targs k))
                        0))
                    (for [i 0 n]
                      (when (and (< i (len (load tps))) (< i (len (load ips))))
                        (let [declared (field (elem tps i) ty)
                              concrete (box-type a (subst-apply a (elem ips i) binds))
                              lowered (box-type a (param-ref-type cx concrete no-tps))]
                          (when (and (not (trait-abi-place-param? declared))
                                     (match (load lowered)
                                       (TRef [_ _] true)
                                       (_ false)))
                            (let [arg (elem args i)]
                              (match (.kind arg)
                                ; Already addressed: pass the place itself rather
                                ; than loading it and spilling the copy back out.
                                (ELoad [place] (set! (.kind arg) (.kind place)))
                                (ESpillRef [_] 0)
                                (_ (let [saved (box-expr a (load arg))]
                                     (set! (.kind arg) (ESpillRef saved))
                                     0))))
                            0))
                        0)
                      0)
                    (Ok [i64 Diag] 0)))))))

(defn adjust-generic-call-abi! [(m (ptr MonoCtx))
                                (gf (ptr Func))
                                (rtargs (ptr (ArrayList Type)))
                                (nargs (ptr (ArrayList Expr)))
                                (first-pass bool)] (-> (Result i64
                                                                            Diag))
  (try (let [a (load (field m a))
             smap (subst-map a (load (field gf type_params)) rtargs)
             params (load (field gf params))
             n
               (if (< (len (load params)) (len (load nargs)))
                   (len (load params))
                   (len (load nargs)))
             (mut i) 0]
         (loop (if (>= (load i) n)
                   (break)
                   (do
                     (let [pp (elem params (load i))
                           arg (elem nargs (load i))
                           owner-type (.owned_type pp)
                           ; `(Option T)` may own, but this instance may be Copy:
                           ; then nothing moved, and the argument is a value
                           ; however it is spelled
                           instance-owns
                             (and (!= (primitive/cast i64 owner-type)
                                      0)
                                  (match (resolve-ty m owner-type smap)
                                    (Ok [t]
                                        (type-is-affine a
                                                        (load (field m ownership_cx))
                                                        (box-type a (ownership-semantic-type m (box-type a t)))))
                                    (Err [_] true)))]
                       (match (.kind arg)
                         (EMovePlace [place]
                                     (if (match (load (field pp ty))
                                           (TPtr [_] true)
                                           (TRef [_ _] true)
                                           (_ false))
                                         (set! (.kind arg) (.kind place))
                                         (set! (.kind arg) (ELoad place)))
                                     0)
                         (_ 0))
                       ; Only the first pass sees arguments as checked: the second
                       ; (see the caller) sees them already passed by address.
                       (when (and first-pass
                                  (!= (primitive/cast i64 owner-type)
                                      0)
                                  (not instance-owns)
                                  (match (load (field pp ty))
                                    (TPtr [_] true)
                                    (TRef [_ _] true)
                                    (_ false)))
                         ; a place is passed as itself; a value is spilled
                         (match (.kind arg)
                           (ELoad [place] (do (set! (.kind arg) (.kind place)) 0))
                           (ESpillRef [_] 0)
                           (_ (let [saved (box-expr a (load arg))]
                                (set! (.kind arg) (ESpillRef saved))
                                0))))
                       ; An owned argument's place ABI is lowered once, on the
                       ; argument as ownership elaboration left it. A non-generic
                       ; function was elaborated before monomorphization; a
                       ; generic instance is elaborated between its two resolve
                       ; passes, so its first pass leaves the argument alone.
                       ; Elaboration reads an argument as the checker wrote it,
                       ; `(load place)`: given the bare place instead, it took a
                       ; place with no variable at its root (the slot of a
                       ; constructor) for an rvalue and spilled it, so the
                       ; callee got the address of a pointer to the value.
                       (when (and instance-owns
                                  (not (.instance_first_pass m))
                                  (match (load (field pp ty))
                                    (TPtr [_] true)
                                    (TRef [_ _] true)
                                    (_ false)))
                         (match (.kind arg)
                           (ELoad [place]
                                  (do
                                    (set! (.kind arg) (.kind place))
                                    0))
                           ; Checked non-generic calls already spill aggregate
                           ; rvalues when the callee ABI takes an owning place.
                           ; Generic calls do not know that concrete ABI until
                           ; substitution here, so materialize an rvalue now.
                           (ESpillRef [_] 0)
                           ; The ownership pass has already rewritten moved
                           ; affine locals/parameters from `load place` to the
                           ; place itself. Do not spill that pointer a second
                           ; time when this call is later monomorphized.
                           (EVar [_] 0)
                           (EField [_ _] 0)
                           (EIndex [_ _] 0)
                           (_ (let [saved (box-expr a (load arg))]
                                (set! (.kind arg) (ESpillRef saved))
                                0)))
                         0))
                     (set! i (primitive/iadd (load i) 1)))))
         (Ok [i64 Diag] 0))))

; Concrete ownership elaboration runs while the monomorphization worklist is
; still being built. Register a semantic signature as soon as a generic call is
; specialized, so a caller processed before its callee can still distinguish an
; owning parameter from a borrow. The source Cx contains only the generic name;
; looking up the mangled call there would otherwise silently treat every argument
; as non-consuming.
(defn register-monomorphized-call-sig! [(m (ptr MonoCtx))
                                        (gf (ptr Func))
                                        (rtargs (ptr (ArrayList Type)))
                                        (mng (slice u8))] (-> (Result i64 Diag))
  (try (let [cx (load (field m ownership_cx))]
         (if (!= (primitive/cast i64 (sig-find cx mng)) 0)
             (Ok [i64 Diag] 0)
             (let [a (load (field m a))
                   smap (subst-map a (load (field gf type_params)) rtargs)
                   ps (load (field gf params))
                   n (len (load ps))
                   (mut types) (ArrayList::new [Type] a)
                   (mut names) (ArrayList::new [(slice u8)] a)
                   (mut i) 0
                   sg (primitive/alloc-stack Sig)]
               (loop (if (>= (load i) n)
                         (break)
                         (let [pp (elem ps (load i))
                               semantic
                                 (if (= (primitive/cast i64 (.owned_type pp))
                                        0)
                                     (field pp ty)
                                     (.owned_type pp))]
                           (push! (mut types)
                                  (match (resolve-ty m semantic smap)
                                    (Ok [temporary] temporary)
                                    (Err [temporary]
                                         (break :try (Err temporary)))))
                           (push! (mut names) (.name pp))
                           (set! i (primitive/iadd (load i) 1)))))
               (set! (.name sg) mng)
               (set! (.type_params sg)
                     (box-al [(slice u8)] a (ArrayList::new [(slice u8)] a)))
               (set! (.bounds sg) (box-al [Bound] a (ArrayList::new [Bound] a)))
               (set! (.param_names sg) (box-al [(slice u8)] a (load names)))
               (set! (.params sg) (box-al [Type] a (load types)))
               (set! (.fnptr_params sg) (.params sg))
               (set! (.ret sg) (try! (resolve-ty m (field gf ret) smap)))
               (set! (.is_extern sg) false)
               (set! (.variadic sg) false)
               (set! (.cc sg) (.cc gf))
               (set! (.fnptr_ok sg) false)
               (push! (mut (.sigs cx)) (load sg))
               (sig-index-put! cx mng)
               (Ok [i64 Diag] 0))))))

(defn resolve-call-kind [(m (ptr MonoCtx))
                         (func (slice u8))
                         (type_args (ptr (ArrayList Type)))
                         (args (ptr (ArrayList Expr)))
                         (map (ptr Subst))] (-> (Result ExprKind Diag))
  (let [a (.a m)]
    (try (let [nargs (try! (resolve-expr-list m args map))]
           (match (variant-sum m func)
             (Some [sum-name]
                   (move-args-to-values! a nargs)
                   (if (gsum-has m sum-name)
                       (do
                         (when (= (len (load type_args)) 0)
                           (break :try
                                    (Err [ExprKind Diag]
                                         (derr (sconcat a
                                                        (sconcat a
                                                                 (sconcat3 a
                                                                           "variant '"
                                                                           func
                                                                           "' of generic sum '")
                                                                 (sconcat3 a
                                                                           sum-name
                                                                           "' needs type arguments: ("
                                                                           func))
                                                        " [<types>] ...)")))))
                         (let [rtargs (try! (resolve-ty-list m type_args map))]
                           (when (not (= (len (load rtargs))
                                         (gsum-arity m sum-name)))
                             (break :try
                                      (Err [ExprKind Diag]
                                           (derr (arity-err a
                                                            (sconcat3 a
                                                                      "sum '"
                                                                      sum-name
                                                                      "'")
                                                            (gsum-arity m
                                                                        sum-name)
                                                            (len (load rtargs)))))))
                           (let [mng (mangle a sum-name rtargs)]
                             (queue-sum m sum-name rtargs)
                             (Ok (EConstruct
                                   :sum mng
                                   :variant func
                                   :args nargs)))))
                       (Ok (EConstruct
                             :sum sum-name
                             :variant func
                             :args nargs))))
             (None []
                   (if (gfunc-has m func)
                       (do
                         (when (= (len (load type_args)) 0)
                           (break :try
                                    (Err [ExprKind Diag]
                                         (derr (sconcat a
                                                        (sconcat3 a
                                                                  "generic function '"
                                                                  func
                                                                  "' needs explicit type arguments: (")
                                                        (sconcat a
                                                                 func
                                                                 " [<types>] ...)"))))))
                         (let [rtargs (try! (resolve-ty-args m type_args map))]
                           (when (not (= (len (load rtargs))
                                         (gfunc-arity m func)))
                             (break :try
                                      (Err [ExprKind Diag]
                                           (derr (arity-err a
                                                            (sconcat3 a
                                                                      "generic function '"
                                                                      func
                                                                      "'")
                                                            (gfunc-arity m func)
                                                            (len (load rtargs)))))))
                           (let [mng (mangle a func rtargs)]
                             (let [gf
                                     (elem (load (field m gfuncs))
                                           (find-func-named (load (field m
                                                                         gfuncs))
                                                            func))]
                               (try! (register-monomorphized-call-sig! m
                                                                       gf
                                                                       rtargs
                                                                       mng))
                               (try! (adjust-generic-call-abi! m
                                                               gf
                                                               rtargs
                                                               nargs
                                                               true))
                               0)
                             (queue-func m func rtargs)
                             (Ok (ECall
                                   :func mng
                                   :type_args (box-items-type a)
                                   :args nargs)))))
                       (do
                         ; This may be the second resolve pass over a concrete
                         ; generic body. Such calls are already mangled, but the
                         ; ownership pass has only now marked consumed arguments
                         ; with EMovePlace. Use the recorded generic origin rather
                         ; than treating the call as an ordinary pointer-ABI call.
                         (let [ioi (io-find m func)]
                           (if (>= ioi 0)
                               (let [orig
                                       (elem (field m io-origin)
                                             ioi)
                                     gf
                                       (elem (load (field m gfuncs))
                                             (find-func-named (load (field m
                                                                           gfuncs))
                                                              (.name orig)))]
                                 (try! (adjust-generic-call-abi! m
                                                                 gf
                                                                 (.args orig)
                                                                 nargs
                                                                 false))
                                 0)
                               (move-args-to-places! nargs)))
                         (Ok (ECall
                               :func func
                               :type_args (box-items-type a)
                               :args nargs))))))))))

(defn resolve-expr-kind [(m (ptr MonoCtx)) (e (ptr Expr)) (map (ptr Subst))] (-> (Result ExprKind
                                                                                         Diag))
  (let [a (.a m)]
    (try (match (load (field e kind))
           (EInt [v] (Ok (EInt v)))
           (EWideInt [neg lo hi radix text] (Ok (EWideInt neg lo hi radix text)))
           (EStr [s] (Ok (EStr s)))
           (ECStr [s] (Ok (ECStr s)))
           (EVar [nm] (Ok (EVar nm)))
           (EFloat [b] (Ok (EFloat b)))
           (EBool [b] (Ok (EBool b)))
           (EZeroed [t]
                    (let [tp (primitive/alloc-stack Type)]
                      (store! tp t)
                      (Ok (EZeroed (try! (resolve-ty m tp map))))))
           (ERecordInit [t]
                    (let [tp (primitive/alloc-stack Type)]
                      (store! tp t)
                      (Ok (EZeroed (try! (resolve-ty m tp map))))))
           (EBorrow [mu place]
                    (Ok (EBorrow mu
                                 (box-expr a (try! (resolve-expr m place map))))))
           (ESpillRef [inner]
                      (Ok (ESpillRef (box-expr a
                                               (try! (resolve-expr m inner map))))))
           (EMovePlace [place]
                       (Ok (EMovePlace (box-expr a
                                                 (try! (resolve-expr m
                                                                     place
                                                                     map))))))
           (ELet [binds body]
                 (Ok (ELet (try! (resolve-bind-list m binds map))
                           (try! (resolve-expr-list m body map)))))
           (EBin [op lhs rhs]
                 (Ok (EBin
                       :op op
                       :lhs (box-expr a (try! (resolve-expr m lhs map)))
                       :rhs (box-expr a (try! (resolve-expr m rhs map))))))
           (EIntUnary [op inner]
                      (Ok (EIntUnary op
                                     (box-expr a
                                               (try! (resolve-expr m inner map))))))
           (ECmp [op lhs rhs]
                 (Ok (ECmp
                       :op op
                       :lhs (box-expr a (try! (resolve-expr m lhs map)))
                       :rhs (box-expr a (try! (resolve-expr m rhs map))))))
           (EIf [cnd thn els]
                (Ok (EIf
                      :cnd (box-expr a (try! (resolve-expr m cnd map)))
                      :thn (box-expr a (try! (resolve-expr m thn map)))
                      :els (box-expr a (try! (resolve-expr m els map))))))
           (EDo [body] (Ok (EDo (try! (resolve-expr-list m body map)))))
           ; A generic body keeps its defers until the instance is elaborated.
           (EDefer [cleanup body]
                   (Ok (EDefer (box-expr a (try! (resolve-expr m cleanup map)))
                               (try! (resolve-expr-list m body map)))))
           (ECleanup [body cleanups]
                     (Ok (ECleanup :body
                                     (box-expr a
                                               (try! (resolve-expr m body map)))
                           :cleanups (try! (resolve-expr-list m cleanups map)))))
           (ECall [func type_args args]
                  (resolve-call-kind m func type_args args map))
           (ENamedCall [_func _type_args _names _args]
                       (Err [ExprKind Diag]
                            (derr "internal: named constructor call survived type checking")))
           (EAlloc [storage t init symbol]
                   (let [tp (primitive/alloc-stack Type)]
                     (store! tp t)
                     (Ok (EAlloc
                           :symbol symbol
                           :storage storage
                           :ty
                             (match (resolve-ty m tp map)
                               (Ok [temporary] temporary)
                               (Err [temporary] (break :try (Err temporary))))
                           :init
                             (if (= (primitive/cast i64 init) 0)
                                 init
                                 (box-expr a (try! (resolve-expr m init map))))))))
           (EStaticArray [indices items]
                         (Ok (EStaticArray indices
                                           (try! (resolve-expr-list m items map)))))
           (EField [p fname]
                   (Ok (EField (box-expr a (try! (resolve-expr m p map))) fname)))
           (EAccessorField [p fname]
                           (Ok (EField (box-expr a
                                                 (try! (resolve-expr m p map)))
                                       fname)))
           (ELoad [inner]
                  (Ok (ELoad (box-expr a (try! (resolve-expr m inner map))))))
           (EStore [p val]
                   (Ok (EStore (box-expr a (try! (resolve-expr m p map)))
                               (box-expr a (try! (resolve-expr m val map))))))
           (EInitStore [p val]
                       (Ok (EInitStore (box-expr a
                                                 (try! (resolve-expr m p map)))
                                       (box-expr a
                                                 (try! (resolve-expr m val map))))))
           (EIndex [p idx]
                   (Ok (EIndex (box-expr a (try! (resolve-expr m p map)))
                               (box-expr a (try! (resolve-expr m idx map))))))
           (ECast [t inner]
                  (let [tp (primitive/alloc-stack Type)]
                    (store! tp t)
                    (Ok (ECast (try! (resolve-ty m tp map))
                               (box-expr a (try! (resolve-expr m inner map)))))))
           (ESizeOf [t]
                    (let [tp (primitive/alloc-stack Type)]
                      (store! tp t)
                      (Ok (ESizeOf (try! (resolve-ty m tp map))))))
           (EAlignOf [t]
                     (let [tp (primitive/alloc-stack Type)]
                       (store! tp t)
                       (Ok (EAlignOf (try! (resolve-ty m tp map))))))
           (EOffsetOf [t fname]
                      (let [tp (primitive/alloc-stack Type)]
                        (store! tp t)
                        (Ok (EOffsetOf (try! (resolve-ty m tp map)) fname))))
           (EBitGet [p fname]
                    (Ok (EBitGet (box-expr a (try! (resolve-expr m p map)))
                                 fname)))
           (EBitSet [p fname val]
                    (Ok (EBitSet
                          :p (box-expr a (try! (resolve-expr m p map)))
                          :fname fname
                          :val (box-expr a (try! (resolve-expr m val map))))))
           (EFree [inner]
                  (Ok (EFree (box-expr a (try! (resolve-expr m inner map))))))
           (EErase [trait_name inner]
                   (Ok (EErase trait_name
                               (box-expr a (try! (resolve-expr m inner map))))))
           (EMatch [scrut arms]
                   (Ok (EMatch (box-expr a (try! (resolve-expr m scrut map)))
                               (try! (resolve-arm-list m arms map)))))
           (EFnPtrOf [nm]
                     (if (gfunc-has m nm)
                         (Err [ExprKind Diag]
                              (derr (sconcat3 a
                                              "fnptr-of '"
                                              nm
                                              "': a generic function's pointer reached specialization without its type arguments (compiler bug)")))
                         (Ok (EFnPtrOf nm))))
           (EFnPtrInst [nm targs] (fnptr-inst m nm targs map))
           (ECallPtr [fp args]
                     (Ok (ECallPtr (box-expr a (try! (resolve-expr m fp map)))
                                   (try! (resolve-expr-list m args map)))))
           (ELoop [label body]
                  (Ok (ELoop label (try! (resolve-expr-list m body map)))))
           (EBreak [label value]
                   (Ok (EBreak label
                               (match value
                                 (Some [vp]
                                       (Some (box-expr a
                                                       (try! (resolve-expr m
                                                                           vp
                                                                           map)))))
                                 (None [] (None [(ptr Expr)]))))))
           (EContinue [label] (Ok (EContinue label)))
           (EAnonFn [_ _]
                    (Err [ExprKind Diag]
                         (derr "internal: anonymous fn survived type checking")))
           (EBracketCall [_ _ _ _]
                         (Err [ExprKind Diag]
                              (derr "internal: a bracket call survived resolution")))
           ; A value parameter becomes the literal it specialized to.
           (EConstParam [name ty]
             (let [param (primitive/alloc-stack Type)]
               (store! param (TStruct name))
               (match (try! (resolve-ty m param map))
                 (TConst [v]
                   (match v
                     (ConstInt [n]
                       (match ty
                         (TInt [bits signed]
                           (if (and (= bits 64) signed)
                               (Ok (EInt n))
                               (Ok (ECast ty (box-expr a (mk-expr (EInt n) (.lo e) (.hi e) (.source e) (.ctxt e)))))))
                         (_ (Err [ExprKind Diag]
                                 (derr (sconcat3 a "mono: integer value parameter '" name "' has a non-integer type (compiler bug)"))))))
                     (ConstBool [b] (Ok (EBool b)))
                     (ConstKeyword [kw]
                       (let [(mut args) (ArrayList::new [Expr] a)]
                         (push! (mut args) (mk-expr (EStr kw) (.lo e) (.hi e) (.source e) (.ctxt e)))
                         (Ok (EConstruct
                               :sum (core-name "Keyword")
                               :variant (core-name "KeywordValue")
                               :args (box-al [Expr] a (load args))))))
                     (ConstRef [nm]
                       (Err [ExprKind Diag]
                            (derr (sconcat3 a "mono: the generic argument (const " nm ") reached specialization unresolved (compiler bug)"))))))
                 (_ (Err [ExprKind Diag]
                         (derr (sconcat3 a "mono: value parameter '" name "' did not specialize to a constant (compiler bug)")))))))
           (EVector [op result types args]
             (let [resolved (try! (resolve-ty m (box-type a result) map))
                   operands (try! (resolve-ty-list m types map))
                   values (try! (resolve-expr-list m args map))]
               (try! (vector-signature a op (box-type a resolved) operands values false))
               (Ok (EVector op resolved operands values))))
           (ELlvmIr [result args body]
                    (let [tp (primitive/alloc-stack Type)]
                      (store! tp result)
                      (Ok (ELlvmIr
                            :result
                              (match (resolve-ty m tp map)
                                (Ok [value] value)
                                (Err [error] (break :try (Err error))))
                            :args
                              (match (resolve-expr-list m args map)
                                (Ok [value] value)
                                (Err [error] (break :try (Err error))))
                            :body body))))
           (EConstruct [sum variant args]
                       (Ok (EConstruct
                             :sum sum
                             :variant variant
                             :args
                               (match (resolve-expr-list m args map)
                                 (Ok [value] value)
                                 (Err [error] (break :try (Err error)))))))
           (EMakeDyn [dyn_struct vtable_struct methods inner]
                     (Ok (EMakeDyn
                           :dyn_struct dyn_struct
                           :vtable_struct vtable_struct
                           :methods methods
                           :inner (box-expr a (try! (resolve-expr m inner map))))))
           (EDynDispatch [dyn_struct
                          vtable_struct
                          method_index
                          cc
                          params
                          ret
                          recv
                          args]
                         (let [rp (primitive/alloc-stack Type)]
                           (store! rp ret)
                           (Ok (EDynDispatch
                                 :dyn_struct dyn_struct
                                 :vtable_struct vtable_struct
                                 :method_index method_index
                                 :cc cc
                                 :params
                                   (match (resolve-ty-list m params map)
                                     (Ok [value] value)
                                     (Err [error] (break :try (Err error))))
                                 :ret
                                   (match (resolve-ty m rp map)
                                     (Ok [value] value)
                                     (Err [error] (break :try (Err error))))
                                 :recv
                                   (box-expr a (try! (resolve-expr m recv map)))
                                 :args
                                   (match (resolve-expr-list m args map)
                                     (Ok [value] value)
                                     (Err [error] (break :try (Err error))))))))
           (EStaticRef [nm] (Ok (EStaticRef nm)))
           ; trait call: substitute Self -> concrete, call the implementing fn
           ; directly. A receiver that resolved to a MANGLED instantiation
           ; (ArrayList__i64) dispatches by its BASE name, and its recorded args
           ; feed the impl pattern; a GENERIC impl's lowered method is a generic
           ; function, instantiated by matching that pattern.
           (ETraitCall [trait_name method self_tp args]
                       (let [tp (primitive/alloc-stack Type)]
                         (store! tp (TStruct self_tp))
                         (let [styp (primitive/alloc-stack Type)]
                           (store! styp
                                   (match (resolve-ty m tp map)
                                     (Ok [value] value)
                                     (Err [error] (break :try (Err error)))))
                           (let [(mut base) ""
                                 (mut mty) (load styp)]
                             (if (= (type-tag styp) 6)
                                 (let [ioi (io-find m (type-struct-name styp))]
                                   (if (>= ioi 0)
                                       (let [orig
                                               (elem (field m io-origin)
                                                     ioi)]
                                         (store! base (load (field orig name)))
                                         (store! mty
                                                 (TApp (load (field orig name))
                                                       (load (field orig
                                                                    args))))
                                         0)
                                       (do
                                         (store! base (type-struct-name styp))
                                         0)))
                                 (match (mono-impl-name a styp)
                                   (None []
                                         (do
                                           (unimplemented "mono/trait-call: Self resolved to a type with no impl name")
                                           0))
                                   (Some [tn] (do (store! base tn) 0))))
                             (let [rtyp (primitive/alloc-stack Type)]
                               (store! rtyp (load mty))
                               ; the most specific impl accepting this receiver; fall back to the
                               ; plain key lookup when nothing matches, which is the pre-specialization
                               ; behaviour (and a general impl's key IS the plain key)
                               (let [ipsel (impl-lookup-sel a m trait_name rtyp)
                                     ip
                                       (if (= (primitive/cast i64 ipsel)
                                              0)
                                           (impl-lookup m
                                                        trait_name
                                                        (load base))
                                           ipsel)
                                     mkey
                                       (if (= (primitive/cast i64 ipsel)
                                              0)
                                           (load base)
                                           (impl-mangle-key a
                                                            (field ipsel
                                                                   self_type)
                                                            (load (field ipsel
                                                                         type_params))))
                                     (mut targs) (box-items-type a)]
                                 (when (if (!= (primitive/cast i64 ip)
                                               0)
                                           (> (len (load (load (field ip
                                                                      type_params))))
                                              0)
                                           false)
                                   ; Bind the impl's type params from the receiver with the SAME
                                   ; matcher that selected the impl (`unify-trait-extras`). Mono used
                                   ; to run its own `match-impl-pattern` here — a second matcher, free
                                   ; to disagree with the selecting one and then reject a receiver the
                                   ; selector had just accepted. (It also compared types by mono's
                                   ; `type-key`, which renders a TRef without its mutability flag and
                                   ; so equates `(mut T)` with `(ref T)`; unify-trait-extras checks it.)
                                   (let [binds (subst-new a)
                                         mtyp (primitive/alloc-stack Type)]
                                     (store! mtyp (load mty))
                                     (when (not (unify-trait-extras a
                                                                    (field ip
                                                                           self_type)
                                                                    mtyp
                                                                    (load (field ip
                                                                                 type_params))
                                                                    binds))
                                       (break :try
                                                (Err [ExprKind Diag]
                                                     (derr (sconcat3 a
                                                                     "trait call '"
                                                                     method
                                                                     "': receiver doesn't match the impl's implementing type")))))
                                     ; An impl parameter the receiver leaves open
                                     ; is fixed by the associated type the caller's
                                     ; bound stated for this receiver.
                                     (let [td (trait-find (load (field m ownership_cx)) trait_name)]
                                       (unless (= (primitive/cast i64 td) 0)
                                         (let [assoc (impl-associated-bindings a ip td)
                                               params (load (field td type_params))]
                                           (for [pi 0 (len (load params))]
                                             (let [p (get (load params) pi)
                                                   pattern (subst-get assoc p)]
                                               (unless (= (primitive/cast i64 pattern) 0)
                                                 (match (subst-lookup map (assoc-tp-name a self_tp trait_name p))
                                                   (Some [stated]
                                                         (let [sp (primitive/alloc-stack Type)]
                                                           (store! sp (mono-semantic-type m stated))
                                                           (unify-trait-extras a
                                                                               pattern
                                                                               sp
                                                                               (load (field ip type_params))
                                                                               binds)
                                                           0))
                                                   (None [] 0)))
                                               0)))
                                         0))
                                     (let [ps (load (field ip type_params))
                                           np (len (load ps))
                                           (mut k) 0
                                           (mut ta) (ArrayList::new [Type] a)]
                                       (loop (if (>= (load k) np)
                                                 (break)
                                                 (let [pn
                                                         (get (load ps)
                                                              (load k))
                                                       bp (subst-get binds pn)]
                                                   (when (= (primitive/cast i64
                                                                            bp)
                                                            0)
                                                     (break :try
                                                              (Err [ExprKind
                                                                    Diag]
                                                                   (derr (sconcat a
                                                                                  (sconcat3 a
                                                                                            "trait call '"
                                                                                            method
                                                                                            "': impl type parameter '")
                                                                                  (sconcat a
                                                                                           pn
                                                                                           "' not determined by the receiver"))))))
                                                   (push! (mut ta) (load bp))
                                                   (store! k
                                                           (primitive/iadd (load k)
                                                                           1)))))
                                       (store! targs
                                               (box-al [Type] a (load ta)))
                                       0)))
                                 (let [basefn
                                         (trait-method-fn a
                                                          trait_name
                                                          mkey
                                                          method)
                                       rargs
                                         (try! (resolve-expr-list m args map))]
                                   (try! (adjust-trait-call-abi! m
                                                                 (trait-find (load (field m
                                                                                          ownership_cx))
                                                                             trait_name)
                                                                 basefn
                                                                 (load targs)
                                                                 method
                                                                 rargs))
                                   (if (> (len (load (load targs)))
                                          0)
                                       (let [mng (mangle a basefn (load targs))]
                                         (queue-func m basefn (load targs))
                                         (io-mark-trait! m mng trait_name mkey)
                                         (trait-use-record! m
                                                            trait_name
                                                            mkey
                                                            method
                                                            mng)
                                         (Ok (ECall
                                               :func mng
                                               :type_args (box-items-type a)
                                               :args rargs)))
                                       (do
                                         (trait-use-record! m
                                                            trait_name
                                                            mkey
                                                            method
                                                            basefn)
                                         (Ok (ECall
                                               :func basefn
                                               :type_args (box-items-type a)
                                               :args rargs)))))))))))
           ; comptime-only / unresolved nodes: a compiler bug if they reach mono.
           (EComptime [inner]
                      (Err [ExprKind Diag]
                           (derr-at-src (.source e) (.lo e) (.hi e)
                                        "mono: unresolved comptime node (compiler bug)")))
           (EAscribe [t inner]
                     (Err [ExprKind Diag]
                          (derr "mono: unlowered ascription node — the checker should have replaced (: v t) with its coerced value (compiler bug)")))
           (EPattern [pattern-op t inner pattern-index]
                     (Err [ExprKind Diag]
                          (derr "mono: unlowered pattern projection — the checker should have replaced (: v t) with its coerced value (compiler bug)")))
           (EArrayLit [_]
                      (Err [ExprKind Diag]
                           (derr "mono: array literal survived type checking (compiler bug)")))
           (EMakeSlice [data elem len]
                       (let [tp (primitive/alloc-stack Type)]
                         (store! tp elem)
                         (Ok (EMakeSlice
                               :data
                                 (box-expr a (try! (resolve-expr m data map)))
                               :elem
                                 (match (resolve-ty m tp map)
                                   (Ok [value] value)
                                   (Err [error] (break :try (Err error))))
                               :len (try! (resolve-extent m len map true))))))
           (ETypeQuery [q t]
                       (Err [ExprKind Diag]
                            (derr "mono: unresolved type-query (compiler bug)")))
           (EFieldMeta [meta t idx]
                       (Err [ExprKind Diag]
                            (derr "mono: unresolved field-reflection (compiler bug)")))
           (EFieldIndex [t nm]
                        (Err [ExprKind Diag]
                             (derr "mono: unresolved field-reflection (compiler bug)")))
           (EQuote [form]
                   (Err [ExprKind Diag]
                        (derr "mono: comptime-only code value reached mono (compiler bug)")))
           (ECodeOp [op args]
                    (Err [ExprKind Diag]
                         (derr-at-src (load (field e source))
                                      (load (field e lo))
                                      (load (field e hi))
                                      (sconcat (load (field m a))
                                               "mono: comptime-only code operation "
                                               (sconcat (load (field m a))
                                                        (dec->str (load (field m
                                                                               a))
                                                                  op)
                                                        " reached mono (compiler bug)")))))
           (EQuasi [q]
                   (Err [ExprKind Diag]
                        (derr "mono: comptime-only code value reached mono (compiler bug)")))))))

(defn resolve-expr [(m (ptr MonoCtx)) (e (ptr Expr)) (map (ptr Subst))] (-> (Result Expr
                                                                                    Diag))
  (match (resolve-expr-kind m e map)
    (Err [d] (Err [Expr Diag] d))
    (Ok [k]
        (let [(mut out)
                (mk-expr k
                         (.lo e)
                         (.hi e)
                         (.source e)
                         (.ctxt e))]
          ; Binding/type side maps are keyed by source node identity. Mono must
          ; not erase that identity before generic ABI and ownership lowering.
          (set! (.node-id out) (.node-id e))
          (Ok (load out))))))

; ---- drain the worklist --------------------------------
; An append-only cursor sweep (same fixpoint, output order is
; unobserved by the oracle — every corpus file errors during seeding).
(defn drain [(m (ptr MonoCtx))] (-> (Result i64 Diag))
  (let [a (.a m)
        (mut sc) 0
        (mut uc) 0
        (mut fc) 0
        (mut err) (primitive/zeroed Diag)
        (mut failed) false
        (mut done) false]
    (loop (if (load done)
              (break)
              (do
                (cond (< (load sc)
                         (len (load (field m
                                           pending-structs))))
                        (do
                          (let [pi
                                  (elem (field m pending-structs)
                                        (load sc))
                                nm (load (field pi name))
                                args (load (field pi args))
                                gs
                                  (elem (load (field m gstructs))
                                        (find-struct-named (load (field m
                                                                        gstructs))
                                                           nm))
                                smap
                                  (subst-map a
                                             (load (field gs type_params))
                                             args)
                                mng (mangle a nm args)]
                            (if (mono-runaway? args mng)
                                (do
                                  (store! err
                                          (mono-runaway-diag a
                                                             "generic type"
                                                             nm
                                                             mng))
                                  (store! failed true)
                                  (store! done true)
                                  0)
                                (match (resolve-fields m
                                                       (load (field gs fields))
                                                       smap)
                                  (Err [d]
                                       (let [dp (primitive/alloc-stack Diag)]
                                         (set! dp d)
                                         (set! (.msg dp)
                                               (sconcat a
                                                        (sconcat3 a
                                                                  "in function '"
                                                                  mng
                                                                  "': ")
                                                        (.msg dp)))
                                         (store! err (load dp))
                                         (store! failed true)
                                         (store! done
                                                 true)
                                         0))
                                  (Ok [nfs]
                                      (let [nd (primitive/alloc-stack StructDef)]
                                        (set! (.submission_only nd) (.submission_only gs))
                                        (store! (field nd name) mng)
                                        (store! (field nd type_params)
                                                (box-al [(slice u8)]
                                                        a
                                                        (ArrayList::new [(slice u8)] a)))
                                        (store! (field nd bounds)
                                                (box-al [Bound]
                                                        a
                                                        (ArrayList::new [Bound] a)))
                                        (store! (field nd layout)
                                                (load (field gs layout)))
                                        (store! (field nd fields) nfs)
                                        (upsert-struct m (load nd)))))))
                          (store! sc (primitive/iadd (load sc) 1)))
                      (< (load uc) (len (load (field m pending-sums))))
                        (do
                          (let [pi
                                  (elem (field m pending-sums)
                                        (load uc))
                                nm (load (field pi name))
                                args (load (field pi args))
                                gs
                                  (elem (load (field m gsums))
                                        (find-sum-named (load (field m
                                                                     gsums))
                                                        nm))
                                smap
                                  (subst-map a
                                             (load (field gs type_params))
                                             args)
                                mng (mangle a nm args)]
                            (if (mono-runaway? args mng)
                                (do
                                  (store! err
                                          (mono-runaway-diag a
                                                             "generic sum"
                                                             nm
                                                             mng))
                                  (store! failed true)
                                  (store! done true)
                                  0)
                                (match (resolve-sum m gs smap mng)
                                  (Err [d]
                                       (do
                                         (store! err d)
                                         (store! failed true)
                                         (store! done
                                                 true)
                                         0))
                                  (Ok [ns] (upsert-sum m ns)))))
                          (store! uc (primitive/iadd (load uc) 1)))
                      (< (load fc) (len (load (field m pending-funcs))))
                        (do
                          (let [pi
                                  (elem (field m pending-funcs)
                                        (load fc))
                                nm (load (field pi name))
                                args (load (field pi args))
                                gf
                                  (elem (load (field m gfuncs))
                                        (find-func-named (load (field m
                                                                      gfuncs))
                                                         nm))
                                smap
                                  (mono-subst-copy a
                                                   (subst-map a
                                                              (load (field gf
                                                                           type_params))
                                                              args))
                                _assoc (extend-associated-subst! m gf smap)
                                mng (mangle a nm args)]
                            (if (mono-runaway? args mng)
                                (do
                                  ; at the function that keeps instantiating itself
                                  (store! err
                                          (dwspan (mono-runaway-diag a
                                                                     "generic function"
                                                                     nm
                                                                     mng)
                                                  (.source gf) (.lo gf) (.hi gf) 0))
                                  (store! failed true)
                                  (store! done true)
                                  0)
                                (match (do
                                         (set! (.instance_first_pass m) true)
                                         (let [first (resolve-func m gf smap mng)]
                                           (set! (.instance_first_pass m) false)
                                           first))
                                  (Err [d]
                                       (do
                                         (store! err d)
                                         (store! failed true)
                                         (store! done
                                                 true)
                                         0))
                                  (Ok [nf]
                                      (let [nfp (primitive/alloc-stack Func)]
                                        (set! nfp nf)
                                        (set! (.cur_bounds (load (field m
                                                                        ownership_cx)))
                                              (ArrayList::new [Bound] a))
                                        (set! (.ownership_subst (load (field m
                                                                             ownership_cx)))
                                              (ownership-instance-subst m smap))
                                        (match (let [checked
                                                       (ownership-check-func a
                                                                             (load (field m
                                                                                          ownership_cx))
                                                                             nfp)]
                                                 (set! (.ownership_subst (load (field m
                                                                                      ownership_cx)))
                                                       (primitive/cast (ptr (ArrayList SubstEntry))
                                                                       0))
                                                 checked)
                                          (Err [d]
                                               (do
                                                 (store! err d)
                                                 (store! failed true)
                                                 (store! done true)
                                                 0))
                                          (Ok [_]
                                              ; Concrete ownership elaboration may
                                              ; synthesize generic Drop calls for
                                              ; fields such as Weak<Payload>. Those
                                              ; calls did not exist during the first
                                              ; resolve-expr walk, so specialize and
                                              ; queue them before publishing `nf`.
                                              (match (resolve-expr-list m
                                                                        (load (field nfp
                                                                                     body))
                                                                        smap)
                                                (Err [d]
                                                     (do
                                                       (store! err d)
                                                       (store! failed true)
                                                       (store! done true)
                                                       0))
                                                (Ok [owned-body]
                                                    (do
                                                      (set! (.body nfp)
                                                            owned-body)
                                                      (upsert-func m (load nfp))))))))))))
                          (store! fc (primitive/iadd (load fc) 1)))
                      :else (do (store! done true) 0)))))
    (if (load failed) (Err [i64 Diag] (load err)) (Ok [i64 Diag] 0))))

; ---- orchestration ------------------------------
;;; Whether a value of this type can exist only at compile time: it is `Code`, or is
;;; built from a type that is. `nominals` names the structs and sums already known to
;;; be such (see `phase-only-nominals`), so that holding a `Code` in a field, or a
;;; struct that does, counts the same as mentioning `Code` directly. Neither this test
;;; nor its twin for function signatures used to look through a nominal type: a struct
;;; with a `Code` field was correctly left out of the runtime layouts, a helper taking
;;; a pointer to it was not recognized as compile-time code, and codegen then met a
;;; struct nobody had laid out and aborted.
(defn mono-phase-only-type? [(t (ptr Type)) (nominals (ptr (HashMap (slice u8) i64)))] (-> bool)
  (match (load t)
    (TCode [] true)
    (TCodeBuilder [] true)
    (TStruct [name] (contains? (load nominals) name))
    (TPtr [inner] (mono-phase-only-type? inner nominals))
    (TRef [_ inner] (mono-phase-only-type? inner nominals))
    (TArray [inner _] (mono-phase-only-type? inner nominals))
    (TSlice [inner] (mono-phase-only-type? inner nominals))
    (TVec [inner _] (mono-phase-only-type? inner nominals))
    (TFn [_ params ret]
         (or (mono-phase-only-types? params 0 (len (load params)) nominals)
             (mono-phase-only-type? ret nominals)))
    (TApp [name args]
          (or (contains? (load nominals) name)
              (mono-phase-only-types? args 0 (len (load args)) nominals)))
    (_ false)))

(defn mono-phase-only-types? [(types (ptr (ArrayList Type)))
                              (i i64)
                              (n i64)
                              (nominals (ptr (HashMap (slice u8) i64)))] (-> bool)
  (if (>= i n)
      false
      (or (mono-phase-only-type? (elem types i) nominals)
          (mono-phase-only-types? types (primitive/iadd i 1) n nominals))))

(defn mono-phase-only-fields? [(fields (ptr (ArrayList Field)))
                               (nominals (ptr (HashMap (slice u8) i64)))] (-> bool)
  (let [n (len (load fields))
        (mut i) 0
        (mut found) false]
    (loop (if (or (load found) (>= (load i) n))
              (break)
              (do
                (when (mono-phase-only-type? (field (elem fields
                                                          (load i))
                                                    ty)
                                             nominals)
                  (store! found true)
                  0)
                (set! i (primitive/iadd (load i) 1)))))
    (load found)))

(defn mono-phase-only-variants? [(variants (ptr (ArrayList Variant)))
                                 (nominals (ptr (HashMap (slice u8) i64)))] (-> bool)
  (let [n (len (load variants))
        (mut i) 0
        (mut found) false]
    (loop (if (or (load found) (>= (load i) n))
              (break)
              (do
                (when (mono-phase-only-fields? (load (field (elem variants
                                                                  (load i))
                                                            fields))
                                               nominals)
                  (store! found true)
                  0)
                (set! i (primitive/iadd (load i) 1)))))
    (load found)))

;;; The structs and sums of `p` whose values can exist only at compile time, by name.
;;; Found to a fixed point, because such a type may hold another rather than `Code`
;;; itself. A generic definition is in the set when its own fields say so; an
;;; instantiation with a compile-time argument is caught at the use by the type test.
(defn phase-only-nominals [(a (dyn Allocator)) (p (ptr Program))] (-> (ptr (HashMap (slice u8) i64)))
  (let [found (box! a
                    (HashMap (slice u8) i64)
                    (HashMap::new [(slice u8) i64] a (keyops-borrowed)))]
    (loop
      (let [before (len (load found))]
        (for [i 0 (len (load (.structs p)))]
          (let [sp (elem (.structs p) i)]
            (unless (contains? (load found) (.name sp))
              (when (mono-phase-only-fields? (load (field sp fields)) found)
                (set! found (.name sp) 0)
                0)
              0)))
        (for [i 0 (len (load (.sums p)))]
          (let [sp (elem (.sums p) i)]
            (unless (contains? (load found) (.name sp))
              (when (mono-phase-only-variants? (load (field sp variants)) found)
                (set! found (.name sp) 0)
                0)
              0)))
        (when (= before (len (load found))) (break))))
    found))

(defn collect-generic-structs [(a (dyn Allocator)) (p (ptr Program))] (-> (ptr (ArrayList StructDef)))
  (let [fs (load (field p structs))
        n (len (load fs))
        (mut out) (ArrayList::new [StructDef] a)
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (let [sp (elem fs (load i))]
                  (when (> (len (load (field sp type_params)))
                           0)
                    (push! (mut out) (load sp))))
                (set! i (primitive/iadd (load i) 1)))))
    (box-al [StructDef] a (load out))))

(defn collect-generic-sums [(a (dyn Allocator)) (p (ptr Program))] (-> (ptr (ArrayList SumDef)))
  (let [ss (load (field p sums))
        n (len (load ss))
        (mut out) (ArrayList::new [SumDef] a)
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (let [sp (elem ss (load i))]
                  (when (> (len (load (field sp type_params)))
                           0)
                    (push! (mut out) (load sp))))
                (set! i (primitive/iadd (load i) 1)))))
    (box-al [SumDef] a (load out))))

(defn collect-generic-funcs [(a (dyn Allocator)) (p (ptr Program))] (-> (ptr (ArrayList Func)))
  (let [fs (load (field p funcs))
        n (len (load fs))
        (mut out) (ArrayList::new [Func] a)
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (let [fp (elem fs (load i))]
                  (when (> (len (load (field fp type_params)))
                           0)
                    (push! (mut out) (load fp))))
                (set! i (primitive/iadd (load i) 1)))))
    (box-al [Func] a (load out))))

; build variant_to_sum (primitive/error if a variant name is in two sums).
(defn build-vsum [(m (ptr MonoCtx)) (p (ptr Program))] (-> (Result i64 Diag))
  (let [a (.a m)
        ss (load (field p sums))
        n (len (load ss))
        (mut i) 0
        (mut err) (primitive/zeroed Diag)
        (mut failed) false]
    (loop (if (or (load failed) (>= (load i) n))
              (break)
              (do
                (let [sp (elem ss (load i))
                      vs (load (field sp variants))
                      nv (len vs)
                      (mut j) 0]
                  (loop (if (or (load failed) (>= (load j) nv))
                            (break)
                            (do
                              (let [vp (elem vs (load j))
                                    vn (.name vp)]
                                (if (set-contains (field m vsum-names) vn)
                                    (do
                                      (set! err
                                            (derr (sconcat3 a
                                                            "variant '"
                                                            vn
                                                            "' is declared in two sum types")))
                                      (set! failed true)
                                      0)
                                    (do
                                      (push! (mut (.vsum-names m)) vn)
                                      (push! (mut (.vsum-sums m)) (.name sp)))))
                              (set! j (primitive/iadd (load j) 1))))))
                (set! i (primitive/iadd (load i) 1)))))
    (if (load failed) (Err [i64 Diag] (load err)) (Ok [i64 Diag] 0))))

(defn seed-concrete-structs [(m (ptr MonoCtx))
                             (p (ptr Program))
                             (map (ptr Subst))] (-> (Result i64 Diag))
  (let [a (.a m)
        ss (load (field p structs))
        n (len (load ss))
        (mut i) 0
        (mut err) (primitive/zeroed Diag)
        (mut failed) false]
    (loop (if (>= (load i) n)
              (break)
              (do
                (let [sp (elem ss (load i))]
                  ; Code-bearing concrete aggregates belong exclusively to the
                  ; metaprogram/checker closure. Metalower compiles a private copy
                  ; with Code erased to an opaque host handle; the ordinary target
                  ; must not seed the source declaration into runtime layout.
                  (when (and (= (len (load (field sp type_params)))
                                0)
                             (not (mono-phase-only-fields? (load (field sp
                                                                        fields))
                                                           (.phase_only m))))
                    (match (resolve-fields m (load (field sp fields)) map)
                      (Err [d] (do (store! err d) (store! failed true) (break)))
                      (Ok [nfs]
                          (let [nd (primitive/alloc-stack StructDef)]
                            (set! (.submission_only nd) (.submission_only sp))
                            (store! (field nd name) (load (field sp name)))
                            (store! (field nd type_params)
                                    (box-al [(slice u8)]
                                            a
                                            (ArrayList::new [(slice u8)] a)))
                            (store! (field nd bounds)
                                    (box-al [Bound] a (ArrayList::new [Bound] a)))
                            (store! (field nd layout) (load (field sp layout)))
                            (store! (field nd fields) nfs)
                            (unless (mono-struct-already? m nd)
                              (upsert-struct m (load nd))
                              0)
                            0)))))
                (set! i (primitive/iadd (load i) 1)))))
    (if (load failed) (Err [i64 Diag] (load err)) (Ok [i64 Diag] 0))))

(defn seed-concrete-sums [(m (ptr MonoCtx)) (p (ptr Program)) (map (ptr Subst))] (-> (Result i64
                                                                                             Diag))
  (let [a (.a m)
        ss (load (field p sums))
        n (len (load ss))
        (mut i) 0
        (mut err) (primitive/zeroed Diag)
        (mut failed) false]
    (loop (if (>= (load i) n)
              (break)
              (do
                (let [sp (elem ss (load i))]
                  (when (and (= (len (load (field sp type_params)))
                                0)
                             (not (mono-phase-only-variants? (load (field sp
                                                                          variants))
                                                             (.phase_only m))))
                    (match (resolve-sum m sp map (load (field sp name)))
                      (Err [d] (do (store! err d) (store! failed true) (break)))
                      (Ok [ns]
                          (let [(mut fresh) ns]
                            (unless (mono-sum-already? m (mut fresh))
                              (upsert-sum m (load fresh))
                              0)
                            0)))))
                (set! i (primitive/iadd (load i) 1)))))
    (if (load failed) (Err [i64 Diag] (load err)) (Ok [i64 Diag] 0))))

(defn seed-concrete-funcs [(m (ptr MonoCtx))
                           (p (ptr Program))
                           (map (ptr Subst))] (-> (Result i64 Diag))
  (let [a (.a m)
        fs (load (field p funcs))
        n (len (load fs))
        (mut i) 0
        (mut err) (primitive/zeroed Diag)
        (mut failed) false]
    (loop (if (>= (load i) n)
              (break)
              (do
                (let [fp (elem fs (load i))]
                  (when (and (= (len (load (field fp type_params)))
                                0)
                             (not (contains? (.retained_funcs m) (.name fp))))
                    (match (resolve-func m fp map (load (field fp name)))
                      (Err [d]
                           (let [dp (primitive/alloc-stack Diag)]
                             (set! dp d)
                             (set! (.msg dp)
                                   (sconcat (load (field m a))
                                            (sconcat3 (load (field m a))
                                                      "in function '"
                                                      (load (field fp name))
                                                      "': ")
                                            (.msg dp)))
                             (store! err (load dp))
                             (store! failed true)
                             (break)))
                      (Ok [nf] (upsert-func m nf)))))
                (set! i (primitive/iadd (load i) 1)))))
    (if (load failed) (Err [i64 Diag] (load err)) (Ok [i64 Diag] 0))))

(defn mono-asserts [(m (ptr MonoCtx)) (p (ptr Program)) (map (ptr Subst))] (-> (Result (ptr (ArrayList StaticAssert))
                                                                                       Diag))
  (let [a (.a m)
        as (load (field p asserts))
        n (len (load as))
        (mut out) (ArrayList::new [StaticAssert] a)
        (mut i) 0
        (mut err) (primitive/zeroed Diag)
        (mut failed) false]
    (loop (if (>= (load i) n)
              (break)
              (do
                (let [ap (elem as (load i))]
                  (match (resolve-expr m (field ap cnd) map)
                    (Err [d] (do (set! err d) (set! failed true) (break)))
                    (Ok [ce]
                        (let [na (primitive/alloc-stack StaticAssert)]
                          (set! (.cnd na) ce)
                          (set! (.msg na) (.msg ap))
                          (push! (mut out) (load na))
                          0))))
                (set! i (primitive/iadd (load i) 1)))))
    (if (load failed)
        (Err [(ptr (ArrayList StaticAssert)) Diag] (load err))
        (Ok (box-al [StaticAssert] a (load out))))))

;;; `prior` is the program an earlier run produced, or null. A runtime constant whose
;;; checked value is the very node that run was given -- the same node id, which only
;;; the same node has -- keeps the record that run made for it. Resolving it again
;;; gives an equal tree in new storage, which costs the resolution on every edit of
;;; anything and leaves no two native programs sharing a single constant.
(defn mono-consts [(m (ptr MonoCtx))
                   (p (ptr Program))
                   (map (ptr Subst))
                   (prior (ptr Program))] (-> (Result (ptr (ArrayList Const)) Diag))
  (try (let [a (.a m)
             cs (load (field p consts))
             (mut out) (ArrayList::new [Const] a)
             (mut made) (HashMap::new [(slice u8) i64] a (keyops-borrowed))]
         (unless (= (primitive/cast i64 prior) 0)
           (for [i 0 (len (load (.consts prior)))]
             (set! (mut made) (.name (elem (.consts prior) i)) i))
           0)
         (for [i 0 (len (load cs))]
           (let [cp (elem cs i)
                 kept
                   (match (get made (.name cp))
                     (None [] (primitive/cast (ptr Const) 0))
                     (Some [at]
                           (let [old (elem (.consts prior) at)]
                             (if (and (.runtime old)
                                      (and (!= (.node-id (field cp value)) 0)
                                           (= (.node-id (field old value))
                                              (.node-id (field cp value)))))
                                 old
                                 (primitive/cast (ptr Const) 0)))))]
             (if (!= (primitive/cast i64 kept) 0)
               (push! (mut out) (load kept))
             (if (.runtime cp)
                 (let [nc (primitive/alloc-stack Const)]
                   (set! nc (load cp))
                   (set! (.ty nc)
                         (match (.ty cp)
                           (None [] (None [Type]))
                           (Some [ty]
                                 (let [tp (box-type a ty)]
                                   (Some (try! (resolve-ty m tp map)))))))
                   (set! (.value nc)
                         (try! (resolve-expr m (field cp value) map)))
                   (push! (mut out) (load nc)))
                 (push! (mut out) (load cp)))))
           0)
         (Ok [(ptr (ArrayList Const)) Diag] (box-al [Const] a (load out))))))

; An export's C signature names its parameter types as the checker wrote them.
; A generic struct such as `(Indexed i64)` (a by-value C entry for an anonymous
; function can take one) is the concrete struct mono instantiated for it, and the
; backends decide whether the entry needs a by-value thunk from that struct. The
; entry of a generic function (a lifted anonymous function in a generic body) is
; not one: it records the surface its instances' entries take, and each instance
; a pointer reaches gets its own (`instance-c-entry!`).
(defn mono-exports [(m (ptr MonoCtx))
                    (p (ptr Program))
                    (map (ptr Subst))] (-> (Result (ptr (ArrayList ExportC)) Diag))
  (try (let [a (.a m)
             (mut out) (ArrayList::new [ExportC] a)]
         (for [i 0 (len (load (.exports p)))]
           (let [ep (elem (.exports p) i)
                 ne (primitive/alloc-stack ExportC)]
             (unless (gfunc-has m (.name ep))
               (set! ne (load ep))
               (set! (.params ne) (try! (resolve-ty-list m (.params ep) map)))
               (push! (mut out) (load ne))
               0)))
         (Ok [(ptr (ArrayList ExportC)) Diag] (box-al [ExportC] a (load out))))))

;;; The program's exports, then the by-value C entries of generic instances.
(defn with-instance-entries [(a (dyn Allocator))
                             (m (ptr MonoCtx))
                             (exports (ptr (ArrayList ExportC)))] (-> (ptr (ArrayList ExportC)))
  (let [(mut out) (ArrayList::new [ExportC] a)]
    (for [i 0 (len (load exports))]
      (push! (mut out) (get (load exports) i)))
    (for [i 0 (len (.instance_entries m))]
      (push! (mut out) (get (.instance_entries m) i)))
    (box-al [ExportC] a (load out))))

;;; A function declared `(-> never)` returns nothing, as a void one does; the
;;; checker followed each call of one with a loop that never exits, so nothing
;;; after specialization reads a value of type never from a call. Backends see
;;; only the void signature.
(defn never-returns-void [(t Type)] (-> Type)
  (match t (TNever [] (TVoid)) (_ t)))

(defn externs-never-return-void [(a (dyn Allocator))
                                 (es (ptr (ArrayList Extern)))] (-> (ptr (ArrayList Extern)))
  (let [(mut out) (ArrayList::new [Extern] a)]
    (for [i 0 (len (load es))]
      (let [e (elem es i)]
        (push! (mut out) (load e))
        (set! (.ret (elem (mut out) i)) (never-returns-void (.ret e)))))
    (box-al [Extern] a (load out))))

(defn build-mono-program [(a (dyn Allocator))
                          (m (ptr MonoCtx))
                          (p (ptr Program))
                          (asserts (ptr (ArrayList StaticAssert)))
                          (consts (ptr (ArrayList Const)))
                          (exports (ptr (ArrayList ExportC)))] (-> (Result (ptr Program)
                                                                        Diag))
  (let [out (box! a Program (primitive/zeroed Program))]
    (set! (.annotation_defs out) (load (field p annotation_defs)))
    (set! (.conventions out) (load (field p conventions)))
    (set! (.structs out) (box-al [StructDef] a (.out-structs m)))
    (set! (.sums out) (box-al [SumDef] a (.out-sums m)))
    (set! (.externs out) (externs-never-return-void a (load (field p externs))))
    (set! (.funcs out) (box-al [Func] a (.out-funcs m)))
    (set! (.asserts out) asserts)
    (set! (.consts out) consts)
    ; Traits and impls are semantic metadata as well as monomorphization input.
    ; Native code generation ignores these tables, but an incremental compiler
    ; session must retain them to check a later definition against the accepted
    ; trait environment without reconstructing compiler-generated method names.
    (set! (.traits out) (load (field p traits)))
    (set! (.impls out) (load (field p impls)))
    (set! (.metas out) (box-al [Expr] a (ArrayList::new [Expr] a)))
    (set! (.exports out) exports)
    (set! (.function_abis out) (load (field p function_abis)))
    (set! (.mono_origins out) (box-al [MonoOrigin] a (.origins m)))
    (set! (.unit_exports out) (load (field p unit_exports)))
    (set! (.unit_build out) (.unit_build p))
    (set! (.aliases out) (load (field p aliases)))
    (set! (.retirements out) (.retirements p))
    (set! (.retired_functions out) (.retired_functions p))
    (set! (.mono_trait_uses out) (box-al [MonoTraitUse] a (.trait_uses m)))
    (Ok out)))

; keeps out_structs/out_sums/out_funcs in HashMaps keyed by name, so a
; second insert with the same name OVERWRITES (last-writer-wins) — duplicate-named
; concrete definitions (e.g. a fn re-seen via two import paths) collapse to one.
; Our out lists are ArrayLists, so mirror that with insert-or-replace by name.
; O(1) insert-or-replace by name via the out-*-idx side-index (gen-10). Same
; last-writer-wins semantics as the old scan: a name already in the list is
; replaced IN PLACE at its recorded index; a new name is appended and its index
; recorded. The list never holds a duplicate name, so the index stays exact.
;;; ---- keeping what a reused native program already has ----------------------------
;;; A retained session specializes against the native program it built last time.
;;; Every concrete struct and sum is specialized again on each run, and unless the
;;; source changed the result is the definition already there. Writing the new copy
;;; over it is harmless to a single compilation and costly to whoever keeps the
;;; program: every run hands them a freshly allocated, identical definition to retain
;;; in place of the one they already hold. These tell the two apart.

(defn mono-layout-same? [(left (ptr Layout)) (right (ptr Layout))] (-> bool)
  (match (load left)
    (LC [] (match (load right) (LC [] true) (_ false)))
    (LPacked [] (match (load right) (LPacked [] true) (_ false)))
    (LAligned [n] (match (load right) (LAligned [m] (= n m)) (_ false)))
    (LExplicit [offsets size align]
      (match (load right)
        (LExplicit [other-offsets other-size other-align]
          (and (= align other-align)
               (and (mono-i64-lists-same? offsets other-offsets)
                    (match size
                      (Some [n] (match other-size (Some [m] (= n m)) (None [] false)))
                      (None [] (match other-size (Some [_] false) (None [] true)))))))
        (_ false)))
    (LBits [backing offsets]
      (match (load right)
        (LBits [other-backing other-offsets]
          (and (= backing other-backing) (mono-i64-lists-same? offsets other-offsets)))
        (_ false)))))

(defn mono-i64-lists-same? [(left (ptr (ArrayList i64))) (right (ptr (ArrayList i64)))] (-> bool)
  (block :same
    (when (= left right) (return-from :same true))
    (when (or (= (primitive/cast i64 left) 0) (= (primitive/cast i64 right) 0))
      (return-from :same false))
    (when (!= (len (load left)) (len (load right))) (return-from :same false))
    (for [i 0 (len (load left))]
      (when (!= (get (load left) i) (get (load right) i)) (return-from :same false)))
    true))

(defn mono-fields-same? [(left (ptr (ArrayList Field))) (right (ptr (ArrayList Field)))] (-> bool)
  (block :same
    (when (!= (len (load left)) (len (load right))) (return-from :same false))
    (for [i 0 (len (load left))]
      (let [l (elem left i) r (elem right i)]
        (unless (and (= (.name l) (.name r)) (type-eq (field l ty) (field r ty)))
          (return-from :same false))))
    true))

;;; Whether the specialized `fresh` says nothing the definition already recorded
;;; under its name does not.
(defn mono-struct-already? [(m (ptr MonoCtx)) (fresh (ptr StructDef))] (-> bool)
  (match (get (.out-struct-idx m) (.name fresh))
    (None [] false)
    (Some [at]
          (let [prior (elem (field m out-structs) at)]
            (and (= (.submission_only prior) (.submission_only fresh))
                 (and (= (len (load (.type_params prior))) 0)
                      (and (= (len (load (.bounds prior))) 0)
                           (and (mono-layout-same? (field prior layout) (field fresh layout))
                                (mono-fields-same? (.fields prior) (.fields fresh))))))))))

(defn mono-sum-already? [(m (ptr MonoCtx)) (fresh (ptr SumDef))] (-> bool)
  (match (get (.out-sum-idx m) (.name fresh))
    (None [] false)
    (Some [at]
          (let [prior (elem (field m out-sums) at)]
            (block :same
              (unless (and (= (.submission_only prior) (.submission_only fresh))
                           (and (= (len (load (.type_params prior))) (len (load (.type_params fresh))))
                                (and (= (len (load (.bounds prior))) (len (load (.bounds fresh))))
                                     (= (len (load (.variants prior))) (len (load (.variants fresh)))))))
                (return-from :same false))
              (for [i 0 (len (load (.variants prior)))]
                (let [l (elem (.variants prior) i) r (elem (.variants fresh) i)]
                  (unless (and (= (.name l) (.name r)) (mono-fields-same? (.fields l) (.fields r)))
                    (return-from :same false))))
              true)))))

(defn upsert-struct [(m (ptr MonoCtx)) (s StructDef)] (-> i64)
  (let [nm (sdef-name s)]
    (match (get (.out-struct-idx m) nm)
      (Some [i] (do (set! (mut (.out-structs m)) i s) 0))
      (None []
            (let [idx (len (.out-structs m))]
              (push! (mut (.out-structs m)) s)
              (set! (mut (.out-struct-idx m)) nm idx)
              0)))))

(defn upsert-sum [(m (ptr MonoCtx)) (s SumDef)] (-> i64)
  (let [nm (sumdef-name s)]
    (match (get (.out-sum-idx m) nm)
      (Some [i] (do (set! (mut (.out-sums m)) i s) 0))
      (None []
            (let [idx (len (.out-sums m))]
              (push! (mut (.out-sums m)) s)
              (set! (mut (.out-sum-idx m)) nm idx)
              0)))))

(defn upsert-func [(m (ptr MonoCtx)) (f Func)] (-> i64)
  (let [nm (func-name f)]
    (match (get (.out-func-idx m) nm)
      (Some [i] (do (set! (mut (.out-funcs m)) i f) 0))
      (None []
            (let [idx (len (.out-funcs m))]
              (push! (mut (.out-funcs m)) f)
              (set! (mut (.out-func-idx m)) nm idx)
              0)))))

;;; The checker tables mono reads ownership and dispatch from, built for `p`.
;;;
;;; `accepted` is the state `p` was checked on top of, or null. It matters: setting up
;;; checks every constant, and replaces each runtime constant's value in place with the
;;; elaborated tree. Without the state to recognize accepted constants by, every edit
;;; of a retained session re-typed every constant it had ever accepted, a second time,
;;; and rewrote the checked program's own records while doing it -- which is what kept
;;; any two accepted states from sharing a single constant.
(defn mono-ownership-context [(a (dyn Allocator))
                              (p (ptr Program))
                              (accepted (ptr LS))] (-> (Result (ptr Cx) Diag))
  (let [cx (box! a Cx (primitive/zeroed Cx))
        imports (box-al [ImpEntry] a (ArrayList::new [ImpEntry] a))
        exports (box-al [ExpEntry] a (ArrayList::new [ExpEntry] a))]
    (set! (.trait_uses cx) (ArrayList::new [MonoTraitUse] a))
    ; Setting up re-checks each constant, and an anonymous function in one is
    ; lifted again. The checked Program already holds that lift (the check that
    ; produced it numbered its constants' anonymous functions first, as this does),
    ; so these lists are only the checker's working storage and are dropped.
    (set! (.anon_funcs cx) (ArrayList::new [Func] a))
    (set! (.anon_c_entries cx) (ArrayList::new [ExportC] a))
    (set! (.anon_outer_env cx) (primitive/cast (ptr (ArrayList EnvEntry)) 0))
    (set! (.recovered_diags cx) (ArrayList::new [Diag] a))
    (match (setup-retained a cx p imports exports accepted)
      (Err [d] (Err [(ptr Cx) Diag] d))
      (Ok [_] (Ok [(ptr Cx) Diag] cx)))))

;;; Specialize a checked delta while borrowing native declarations from an
;;; accepted generation. Declared functions retain the exact Coil ABI and calling
;;; convention; they are not converted to a text/extern approximation.
;;; A function the submission retired, or a specialization of one. Retired
;;; artifacts are never reused: a replacement declaration reuses their names.
(defn retired-instance? [(p (ptr Program)) (name (slice u8))] (-> bool)
  (let [names (.retired_functions p)]
    (and (!= (primitive/cast i64 names) 0)
      (block :found
        (for [i 0 (len (load names))]
          (let [retired (get (load names) i)]
            (when (or (= name retired)
                      (and (> (len name) (+ (len retired) 2))
                           (and (= (subslice name 0 (len retired)) retired)
                                (= (subslice name (len retired) (+ (len retired) 2)) "__"))))
              (break :found true))))
        false))))

(defn monomorphize-reusing [(a (dyn Allocator))
                            (p (ptr Program))
                            (prior (ptr Program))
                            (accepted (ptr LS))] (-> (Result (ptr Program) Diag))
  (try (let [m (box! a MonoCtx (primitive/zeroed MonoCtx))]
         (set! (.a m) a)
         (set! (.phase_only m) (phase-only-nominals a p))
         (set! (.gfuncs m) (collect-generic-funcs a p))
         (set! (.gstructs m) (collect-generic-structs a p))
         (set! (.gsums m) (collect-generic-sums a p))
         (set! (.vsum-names m) (ArrayList::new [(slice u8)] a))
         (set! (.vsum-sums m) (ArrayList::new [(slice u8)] a))
         (set! (.out-structs m) (ArrayList::new [StructDef] a))
         (set! (.out-sums m) (ArrayList::new [SumDef] a))
         (set! (.out-funcs m) (ArrayList::new [Func] a))
         (set! (.instance_entries m) (ArrayList::new [ExportC] a))
         (set! (.pending-structs m) (ArrayList::new [PendInst] a))
         (set! (.pending-sums m) (ArrayList::new [PendInst] a))
         (set! (.pending-funcs m) (ArrayList::new [PendInst] a))
         (set! (.out-struct-idx m) (HashMap::new [(slice u8) i64] a (keyops)))
         (set! (.out-sum-idx m) (HashMap::new [(slice u8) i64] a (keyops)))
         (set! (.out-func-idx m) (HashMap::new [(slice u8) i64] a (keyops)))
         (set! (.queued-structs m) (HashMap::new [(slice u8) i64] a (keyops)))
         (set! (.queued-sums m) (HashMap::new [(slice u8) i64] a (keyops)))
         (set! (.queued-funcs m) (HashMap::new [(slice u8) i64] a (keyops)))
         (set! (.ownership_cx m) (try! (mono-ownership-context a p accepted)))
         (set! (.impls m) (load (field p impls)))
         (set! (.trait_impl_idx m)
               (HashMap::new [(slice u8) (ptr ImplBucket)] a (keyops)))
         (let [is (load (field m impls))
               ni (len (load is))
               (mut ii) 0]
           (loop (if (>= (load ii) ni)
                     (break)
                     (do
                       (let [ip (elem is (load ii))]
                         (when (impl-is-trait ip)
                           (impl-index-add! a
                                            (mut (field m trait_impl_idx))
                                            (impl-index-key a
                                                            (impl-trait-name ip)
                                                            (load (field ip
                                                                         for_type)))
                                            (load ii))))
                       (set! ii (primitive/iadd (load ii) 1))))))
         (set! (.io-index m) (HashMap::new [(slice u8) i64] a (keyops)))
         (set! (.io-origin m) (ArrayList::new [PendInst] a))
         (set! (.origins m) (ArrayList::new [MonoOrigin] a))
         (set! (.trait_uses m) (ArrayList::new [MonoTraitUse] a))
         (let [checked-uses (load (field p mono_trait_uses))]
           (if (!= (primitive/cast i64 checked-uses) 0)
               (for [i 0 (len (load checked-uses))]
                 (push! (mut (field m trait_uses)) (get (load checked-uses) i)))
               0))
         (set! (.current_source m) "")
         (set! (.retained_funcs m) (HashMap::new [(slice u8) i64] a (keyops)))
         (unless (= (primitive/cast i64 prior) 0)
           (unless (= (primitive/cast i64 (.mono_origins prior)) 0)
             (for [i 0 (len (load (.mono_origins prior)))]
               (let [origin (elem (.mono_origins prior) i)]
                 ; Restore the paired index and records together. Appending only
                 ; origins duplicated each reused artifact and made io-mark-trait!
                 ; write through an index belonging to a different record.
                 (unless (retired-instance? p (.generated origin))
                   (io-record! m (.kind origin) (.generated origin) (.source origin) (.args origin))
                   (io-mark-trait! m (.generated origin) (.trait_name origin) (.impl_source origin)) 0)))
             0)
           ; Retained signatures may mention already specialized aggregate types.
           ; Their layouts are part of the accepted native ABI as well.
           (for [i 0 (len (load (.structs prior)))]
             (let [definition (elem (.structs prior) i)]
               (upsert-struct m (load definition))
               (set! (mut (.queued-structs m)) (.name definition) 0)))
           (for [i 0 (len (load (.sums prior)))]
             (let [definition (elem (.sums prior) i)]
               (upsert-sum m (load definition))
               (set! (mut (.queued-sums m)) (.name definition) 0)))
           (let [declaration (primitive/alloc-stack Func)]
             (for [i 0 (len (load (.funcs prior)))]
               (let [f (elem (.funcs prior) i)]
                (unless (retired-instance? p (.name f))
                 (set! declaration (load f))
                 (set! (.declared declaration) true)
                 ; A function carried over before is already this declaration; give
                 ; it the empty body it has, not a newly allocated identical one.
                 (unless (and (.declared f) (= (len (load (.body f))) 0))
                   (set! (.body declaration) (box-al [Expr] a (ArrayList::new [Expr] a)))
                   0)
                 (upsert-func m (load declaration))
                 (set! (mut (.queued-funcs m)) (.name f) 0)
                 (set! (mut (.retained_funcs m)) (.name f) 0) 0)))
             0)
           0)
         (let [empty (subst-empty a)]
           (match (build-vsum m p)
             (Err [d] (Err [(ptr Program) Diag] d))
             (Ok [_]
                 (match (seed-concrete-structs m p empty)
                   (Err [d] (Err [(ptr Program) Diag] d))
                   (Ok [_]
                       (match (seed-concrete-sums m p empty)
                         (Err [d] (Err [(ptr Program) Diag] d))
                         (Ok [_]
                             (match (seed-concrete-funcs m p empty)
                               (Err [d] (Err [(ptr Program) Diag] d))
                               (Ok [_]
                                   (match (mono-asserts m p empty)
                                     (Err [d] (Err [(ptr Program) Diag] d))
                                     (Ok [asserts]
                                         (match (mono-consts m p empty prior)
                                           (Err [d]
                                                (Err [(ptr Program) Diag] d))
                                           (Ok [consts]
                                               (match (mono-exports m p empty)
                                                 (Err [d]
                                                      (Err [(ptr Program) Diag]
                                                           d))
                                                 (Ok [exports]
                                                     (match (drain m)
                                                       (Err [d]
                                                            (Err [(ptr Program) Diag]
                                                                 d))
                                                       (Ok [_]
                                                           (build-mono-program a
                                                                               m
                                                                               p
                                                                               asserts
                                                                               consts
                                                                               (with-instance-entries a m exports))))))))))))))))))))))

(defn monomorphize [(a (dyn Allocator)) (p (ptr Program))] (-> (Result (ptr Program) Diag))
  (monomorphize-reusing a p (primitive/cast (ptr Program) 0) (primitive/cast (ptr LS) 0)))

; ---- post-check Code definition drop ----
; Comptime-only functions (a `Code`/`CodeBuilder` parameter or return — macros,
; generators, code helpers, and their trait impl methods) have no runtime
; representation and are dropped after check, before mono. A trait mutator takes
; `(mut Code)` or `(mut CodeBuilder)`; the checked impl keeps that as TRef while its
; synthesized dispatch wrapper uses TPtr. Code can also be nested in a result such
; as `(Option Code)` (Iterator.next is the canonical case). Walk every compound type:
; a runtime signature cannot contain a comptime-only value at any depth.
(defn func-has-code [(fp (ptr Func)) (nominals (ptr (HashMap (slice u8) i64)))] (-> bool)
  (let [rt (primitive/alloc-stack Type)]
    (set! rt (.ret fp))
    (if (mono-phase-only-type? rt nominals)
        true
        (let [ps (load (field fp params))
              n (len ps)
              (mut i) 0
              (mut found) false]
          (loop (if (or (load found) (>= (load i) n))
                    (break)
                    (do
                      (let [pp (elem ps (load i))
                            pt (primitive/alloc-stack Type)]
                        (set! pt (.ty pp))
                        (when (mono-phase-only-type? pt nominals) (store! found true) 0))
                      (set! i (primitive/iadd (load i) 1)))))
          (load found)))))

; A Code-signed entry may delegate ordinary computation to helpers whose own
; signatures contain no Code. Those helpers are still comptime-only when their
; checked bodies contain Code operations, quotes, or explicit comptime nodes.
; Find those bodies before mono, then close the set backwards over callers so a
; runtime-shaped wrapper cannot retain a call to a function removed at the phase
; boundary.
(defn expr-list-has-code-node? [(es (ptr (ArrayList Expr)))] (-> bool)
  (let [n (len (load es))
        (mut i) 0
        (mut found) false]
    (loop (if (or (load found) (>= (load i) n))
              (break)
              (do
                (when (expr-has-code-node? (elem es (load i)))
                  (store! found true)
                  0)
                (set! i (primitive/iadd (load i) 1)))))
    (load found)))

(defn expr-opt-has-code-node? [(o (Option (ptr Expr)))] (-> bool)
  (match o (Some [e] (expr-has-code-node? e)) (None [] false)))

(defn binds-have-code-node? [(bs (ptr (ArrayList Bind)))] (-> bool)
  (let [n (len (load bs))
        (mut i) 0
        (mut found) false]
    (loop (if (or (load found) (>= (load i) n))
              (break)
              (do
                (when (expr-has-code-node? (field (elem bs (load i))
                                                  value))
                  (store! found true)
                  0)
                (set! i (primitive/iadd (load i) 1)))))
    (load found)))

(defn arms-have-code-node? [(arms (ptr (ArrayList Arm)))] (-> bool)
  (let [n (len (load arms))
        (mut i) 0
        (mut found) false]
    (loop (if (or (load found) (>= (load i) n))
              (break)
              (do
                (when (expr-has-code-node? (field (elem arms (load i))
                                                  body))
                  (store! found true)
                  0)
                (set! i (primitive/iadd (load i) 1)))))
    (load found)))

(defn quasi-list-has-code-node? [(items (ptr (ArrayList Quasi)))] (-> bool)
  (let [n (len (load items))
        (mut i) 0
        (mut found) false]
    (loop (if (or (load found) (>= (load i) n))
              (break)
              (do
                (when (quasi-has-code-node? (elem items (load i)))
                  (store! found true)
                  0)
                (set! i (primitive/iadd (load i) 1)))))
    (load found)))

(defn quasi-has-code-node? [(q (ptr Quasi))] (-> bool)
  (match (load q)
    (QUnquote [_] true)
    (QSplice [_] true)
    (QList [_] true)
    (QVector [_] true)
    (_ false)))

(defn expr-has-code-node? [(e (ptr Expr))] (-> bool)
  (match (.kind e)
    (EComptime [_] true)
    (EQuote [_] true)
    (ECodeOp [_ _] true)
    (EQuasi [_] true)
    (ECall [_ _ args] (expr-list-has-code-node? args))
    (EBorrow [_ place] (expr-has-code-node? place))
    (ESpillRef [x] (expr-has-code-node? x))
    (EMovePlace [x] (expr-has-code-node? x))
    (EIntUnary [_ x] (expr-has-code-node? x))
    (ELoad [x] (expr-has-code-node? x))
    (EFree [x] (expr-has-code-node? x))
    (EErase [_ inner] (expr-has-code-node? inner))
    (EMakeDyn [_ _ _ inner] (expr-has-code-node? inner))
    (EDynDispatch [_ _ _ _ _ _ recv args]
                  (or (expr-has-code-node? recv)
                      (expr-list-has-code-node? args)))
    (ECast [_ x] (expr-has-code-node? x))
    (EAscribe [_ x] (expr-has-code-node? x))
    (EPattern [pattern-op _ x pattern-index] (expr-has-code-node? x))
    (EBin [_ l r] (or (expr-has-code-node? l) (expr-has-code-node? r)))
    (ECmp [_ l r] (or (expr-has-code-node? l) (expr-has-code-node? r)))
    (EIf [c t el]
         (or (expr-has-code-node? c)
             (or (expr-has-code-node? t) (expr-has-code-node? el))))
    (EDo [es] (expr-list-has-code-node? es))
    (EDefer [cleanup body]
            (or (expr-has-code-node? cleanup) (expr-list-has-code-node? body)))
    (ECleanup [body cleanups]
              (or (expr-has-code-node? body)
                  (expr-list-has-code-node? cleanups)))
    (ELoop [_ es] (expr-list-has-code-node? es))
    (EBreak [_ v] (expr-opt-has-code-node? v))
    (ELet [bs body]
          (or (binds-have-code-node? bs) (expr-list-has-code-node? body)))
    (EField [p _] (expr-has-code-node? p))
    (EBitGet [p _] (expr-has-code-node? p))
    (EStore [p v] (or (expr-has-code-node? p) (expr-has-code-node? v)))
    (EInitStore [p v] (or (expr-has-code-node? p) (expr-has-code-node? v)))
    (EIndex [p idx] (or (expr-has-code-node? p) (expr-has-code-node? idx)))
    (EBitSet [p _ v] (or (expr-has-code-node? p) (expr-has-code-node? v)))
    (EConstruct [_ _ args] (expr-list-has-code-node? args))
    (ETraitCall [_ _ _ args] (expr-list-has-code-node? args))
    (ELlvmIr [_ args _] (expr-list-has-code-node? args))
    (EVector [_ _ _ args] (expr-list-has-code-node? args))
    (ECallPtr [fp args]
              (or (expr-has-code-node? fp) (expr-list-has-code-node? args)))
    (EMatch [scrut arms]
            (or (expr-has-code-node? scrut) (arms-have-code-node? arms)))
    (EFieldMeta [_ _ idx] (expr-has-code-node? idx))
    (EFieldIndex [_ nm] (expr-has-code-node? nm))
    (_ false)))

(defn func-body-has-code-node? [(fp (ptr Func))] (-> bool)
  (expr-list-has-code-node? (load (field fp body))))

;;; Whether `fp` mentions, anywhere in it, a struct or sum that exists only at compile
;;; time: a local of that type, a cast to it, a constructor of it. Such a function has
;;; no `Code` in its signature and may have no `Code` operation in its body, and is
;;; compile-time code all the same, because nothing it names has a runtime layout.
(defn func-mentions-phase-only? [(a (dyn Allocator))
                                 (fp (ptr Func))
                                 (nominals (ptr (HashMap (slice u8) i64)))] (-> bool)
  (let [(mut refs) (HashMap::new [(slice u8) i64] a (keyops-borrowed))
        (mut seen) (HashMap::new [GraphKey i64] a (graph-keyops))
        (mut found) false]
    (type-refs/func! (mut refs) (mut seen) fp)
    (for [k 0 (.cap refs)]
      (let [e (primitive/index (.slots refs) k)]
        (when (and (= (.state e) 1)
                   (contains? (load nominals) (.key e)))
          (set! found true)
          0)))
    (load found)))

(defn func-calls-dropped? [(a (dyn Allocator))
                           (fp (ptr Func))
                           (names (ptr FnNames))
                           (dropped (ptr (ArrayList (slice u8))))] (-> bool)
  (let [calls (box! a SBox (primitive/zeroed SBox))
        (mut found) false]
    (set! (.items calls) (ArrayList::new [(slice u8)] a))
    (cc-list (load (field fp body)) names calls (primitive/cast (ptr SBox) 0))
    (for [i 0 (len (.items calls))]
      (when (set-contains dropped (get (.items calls) i))
        (set! found true)
        0)
      0)
    (load found)))

(defn code-phase-func-names [(a (dyn Allocator))
                             (p (ptr Program))] (-> (ptr (ArrayList (slice u8))))
  (let [(mut cause) (HashMap::new [(slice u8) (slice u8)] a (keyops-borrowed))]
    (code-phase-funcs a p (mut cause))))

;;; A runtime root — `main`, an `export-c` function, or `extra` — that reaches
;;; compile-time code, with the function at the end of that chain. Dropping such a
;;; root silently would leave only a missing symbol at link or publication.
(defstruct CompileTimeRoot [(root (ptr Func)) (seed (slice u8)) (why (slice u8))])

;;; Why `name` is compile-time code in its own right, phrased after "which".
(defn code-phase-reason [(a (dyn Allocator)) (p (ptr Program)) (name (slice u8))] (-> (slice u8))
  (let [nominals (phase-only-nominals a p)
        (mut why) "takes or returns Code"]
    (for [i 0 (len (load (.funcs p)))]
      (let [fp (elem (.funcs p) i)]
        (when (= (.name fp) name)
          (set! why (cond (func-has-code fp nominals) "takes or returns Code"
                          (func-body-has-code-node? fp)
                            "uses Code, a quote, or a compile-time-only operation such as primitive/error"
                          :else "uses a type that exists only at compile time"))
          0)))
    why))

(defn runtime-root-reaching-code [(a (dyn Allocator)) (p (ptr Program)) (extra (slice u8))]
  (-> (Option CompileTimeRoot))
  (let [(mut cause) (HashMap::new [(slice u8) (slice u8)] a (keyops-borrowed))
        _dropped (code-phase-funcs a p (mut cause))
        (mut found) (None [CompileTimeRoot])]
    (for [i 0 (len (load (.funcs p)))]
      (let [f (elem (.funcs p) i)
            name (.name f)]
        (when (and (none? found)
                   (and (contains? cause name)
                        (or (= name "main")
                            (or (and (> (len extra) 0) (= name extra))
                                (exported-c? p name)))))
          (let [(mut at) name]
            (loop
              (match (get cause at)
                (None [] (break))
                (Some [callee]
                  (if (= (len callee) 0) (break) (set! at callee)))))
            (set! found (Some (CompileTimeRoot :root f :seed at :why (code-phase-reason a p at))))))))
    found))

(defn exported-c? [(p (ptr Program)) (name (slice u8))] (-> bool)
  (let [(mut hit) false]
    (for [i 0 (len (load (.exports p)))]
      (when (= (.name (elem (.exports p) i)) name) (set! hit true)))
    hit))

(defn jit-entry-name? [(name (slice u8))] (-> bool)
  (let [marker "__coil_jit_entry_" (mut hit) false]
    (for [i 0 (+ (- (len name) (len marker)) 1)]
      (when (= (subslice name i (+ i (len marker))) marker) (set! hit true)))
    hit))

;;; The diagnostic for a runtime root that reaches compile-time code.
(defn compile-time-root-diag [(a (dyn Allocator)) (r CompileTimeRoot)] (-> Diag)
  (let [root (.root r)
        ; A retained session's transaction entry is synthetic; call it that.
        subject (if (jit-entry-name? (.name root))
                    "the entry"
                    (sconcat3 a "'" (.name root) "'"))
        what (if (= (.name root) (.seed r))
                 (sconcat3 a subject " " (.why r))
                 (sconcat a
                   (sconcat a subject " reaches '")
                   (sconcat3 a (.seed r) "', which " (.why r))))
        msg (sconcat a what
              ", so it exists only while compiling and cannot run; call compile-time code from a macro or metaprogram, not from runtime code")]
    (derr-at-src (.source root) (.lo root) (.hi root) msg)))

;;; Functions that exist only at compile time. `cause` maps each to the callee
;;; that pulled it in, or to "" for a function that mentions Code itself.
(defn code-phase-funcs [(a (dyn Allocator))
                        (p (ptr Program))
                        (cause (mut (HashMap (slice u8) (slice u8))))] (-> (ptr (ArrayList (slice u8))))
  ; Seeds are functions that mention Code; every transitive caller of one is
  ; dropped too. Calls are collected once and propagated over reverse edges.
  ;
  ; A retained session's submission reaches functions an earlier submission
  ; accepted, which are not in `p`. They are classified the same way, read
  ; through the closure base as the walk reaches them: code that reaches an
  ; accepted Code function is compile-time code too. Outside a session there is
  ; no base, and the walk covers `p` alone.
  (let [fs (load (field p funcs))
        names (prog-fn-names p a)
        nominals (phase-only-nominals a p)
        (mut work) (ArrayList::new [(ptr Func)] a)
        (mut queued) (HashMap::new [(slice u8) i64] a (keyops-borrowed))
        (mut dropped) (ArrayList::new [(slice u8)] a)
        (mut dropped-index) (HashMap::new [(slice u8) i64] a (keyops-borrowed))
        ; callee name -> index of its latest (caller, next) link
        (mut first-link) (HashMap::new [(slice u8) i64] a (keyops-borrowed))
        (mut link-caller) (ArrayList::new [i64] a)
        (mut link-next) (ArrayList::new [i64] a)]
    (for [i 0 (len (load fs))]
      (let [fp (elem fs i)]
        (push! (mut work) fp)
        (unless (contains? queued (.name fp)) (set! (mut queued) (.name fp) i))))
    (let [(mut i) 0]
      (loop (if (>= i (len work)) (break)
        (let [fp (get work i)
              calls (box! a SBox (primitive/zeroed SBox))]
          (when (or (func-has-code fp nominals)
                    (or (func-body-has-code-node? fp)
                        ; Only a program that has such a type pays for looking.
                        (and (> (len (load nominals)) 0)
                             (func-mentions-phase-only? a fp nominals))))
            (unless (contains? dropped-index (load (field fp name)))
              (set! (mut dropped-index) (load (field fp name)) 0)
              (set! (mut cause) (load (field fp name)) "")
              (push! (mut dropped) (load (field fp name))) 0)
            0)
          (set! (.items calls) (ArrayList::new [(slice u8)] a))
          (cc-list (load (field fp body)) names calls (primitive/cast (ptr SBox) 0))
          (for [j 0 (len (.items calls))]
            (let [callee (get (.items calls) j)]
              (unless (contains? queued callee)
                (match (closure-base-func callee)
                  (Some [accepted]
                    (when (= (len (load (.type_params accepted))) 0)
                      (set! (mut queued) callee (len work))
                      (push! (mut work) accepted)))
                  (None [] 0)))
              (push! (mut link-caller) i)
              (push! (mut link-next) (match (get first-link callee) (Some [at] at) (None [] -1)))
              (set! (mut first-link) callee (- (len link-caller) 1))))
          (set! i (+ i 1))))))
    (let [(mut next) 0]
      (loop (if (>= (load next) (len dropped)) (break)
        (let [name (get dropped (load next))
              (mut link) (match (get first-link name) (Some [at] at) (None [] -1))]
          (set! next (+ (load next) 1))
          (loop (if (< (load link) 0) (break)
            (let [caller (get work (get link-caller (load link)))
                  caller-name (load (field caller name))]
              (unless (contains? dropped-index caller-name)
                (set! (mut dropped-index) caller-name 0)
                (set! (mut cause) caller-name name)
                (push! (mut dropped) caller-name) 0)
              (set! link (get link-next (load link))))))))))
    (box-al [(slice u8)] a (load dropped))))

(defn drop-code-impls [(a (dyn Allocator)) (p (ptr Program))] (-> i64)
  (let [nominals (phase-only-nominals a p)
        is (load (field p impls))
        n (len (load is))
        (mut out) (ArrayList::new [ImplDef] a)
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (let [ip (elem is (load i))]
                  (unless (mono-phase-only-type? (field ip self_type) nominals)
                    (push! (mut out) (load ip))))
                (set! i (primitive/iadd (load i) 1)))))
    (set! (.impls p) (box-al [ImplDef] a (load out)))
    0))

(defn drop-code-funcs [(a (dyn Allocator)) (p (ptr Program))] (-> i64)
  (let [fs (load (field p funcs))
        n (len (load fs))
        dropped (code-phase-func-names a p)
        (mut dropped-index) (HashMap::new [(slice u8) i64] a (keyops-borrowed))
        (mut out) (ArrayList::new [Func] a)
        (mut i) 0]
    (for [j 0 (len (load dropped))]
      (set! (mut dropped-index) (get (load dropped) j) 0))
    (loop (if (>= (load i) n)
              (break)
              (do
                (let [fp (elem fs (load i))]
                  (unless (contains? dropped-index (load (field fp name)))
                    (push! (mut out) (load fp))))
                (set! i (primitive/iadd (load i) 1)))))
    (set! (.funcs p) (box-al [Func] a (load out)))
    ; This function is the final runtime boundary. Metaprogram dylibs call
    ; monomorphize directly and still need Code trait impls for dispatch; only
    ; programs that have dropped their Code functions may drop those impls too.
    (drop-code-impls a p)
    0))

; ---- canonicalize mono output order (name sorts) ----
; `mono::monomorphize` builds funcs/structs/sums from `HashMap::into_values()`
; (nondeterministic), so the raw dump is not a stable oracle. Sort these three
; sections by name (mangled names are unique → total order) before dumping. This
; sort lives ONLY in the mono dump path; the shared dumper is untouched.
(defn sdef-name [(s StructDef)] (-> (slice u8))
  (let [p (primitive/alloc-stack StructDef)] (set! p s) (.name p)))

(defn sumdef-name [(s SumDef)] (-> (slice u8))
  (let [p (primitive/alloc-stack SumDef)] (set! p s) (.name p)))

; All three sorts run on EVERY build (run-pipeline calls sort-mono-program before
; codegen), over every mono'd definition in the program. They used to be selection
; sorts: O(n²) comparisons, and each comparison pulled two whole Func/StructDef/
; SumDef structs out of the list BY VALUE just to read one name field. On the
; compiler's own source that came to ~15% of the build.
;
; Instead: extract the names ONCE, sort a permutation of indices with a bottom-up
; merge, then materialize. Same order out — mangled names are a total order and
; both sorts are stable — with O(n log n) comparisons and no struct copies.
(defn sort-index-by-name [(a (dyn Allocator)) (keys (ArrayList (slice u8)))] (-> (ArrayList i64))
  (let [n (len keys)
        (mut cur) (ArrayList::new [i64] a)
        (mut nxt) (ArrayList::new [i64] a)
        (mut w) 1
        (mut lo) 0
        (mut mid) 0
        (mut hi) 0
        (mut i) 0
        (mut j) 0
        (mut k) 0]
    (loop (if (>= (load k) n)
              (break)
              (do
                (push! (mut cur) (load k))
                (set! k (primitive/iadd (load k) 1)))))
    (loop (if (>= (load w) n)
              (break)
              (do
                (set! nxt (ArrayList::new [i64] a))
                (set! lo 0)
                (loop (if (>= (load lo) n)
                          (break)
                          (do
                            (set! mid
                                  (if (< (primitive/iadd (load lo) (load w)) n)
                                      (primitive/iadd (load lo) (load w))
                                      n))
                            (set! hi
                                  (if (< (primitive/iadd (load mid) (load w)) n)
                                      (primitive/iadd (load mid) (load w))
                                      n))
                            (set! i (load lo))
                            (set! j (load mid))
                            (loop (if (and (>= (load i) (load mid))
                                           (>= (load j) (load hi)))
                                      (break)
                                      ; take from the left run unless it is exhausted or the right key
                                      ; is strictly smaller — ties keep the left element, so this is stable
                                      (if (if (>= (load i) (load mid))
                                              false
                                              (if (>= (load j) (load hi))
                                                  true
                                                  (not (str-lt (get keys
                                                                    (get (load cur)
                                                                         (load j)))
                                                               (get keys
                                                                    (get (load cur)
                                                                         (load i)))))))
                                          (do
                                            (push! (mut nxt)
                                                   (get (load cur) (load i)))
                                            (set! i (primitive/iadd (load i) 1)))
                                          (do
                                            (push! (mut nxt)
                                                   (get (load cur) (load j)))
                                            (set! j (primitive/iadd (load j) 1))))))
                            (set! lo (load hi)))))
                (set! cur (load nxt))
                (set! w (primitive/imul (load w) 2)))))
    (load cur)))

(defn sort-funcs [(a (dyn Allocator)) (src (ptr (ArrayList Func)))] (-> (ptr (ArrayList Func)))
  (let [n (len (load src))
        (mut keys) (ArrayList::new [(slice u8)] a)
        (mut out) (ArrayList::new [Func] a)
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (push! (mut keys) (.name (elem src (load i))))
                (set! i (primitive/iadd (load i) 1)))))
    (let [ord (sort-index-by-name a (load keys))
          (mut c) 0]
      (loop (if (>= (load c) n)
                (break)
                (do
                  (push! (mut out) (get (load src) (get ord (load c))))
                  (set! c (primitive/iadd (load c) 1))))))
    (box-al [Func] a (load out))))

(defn sort-structs [(a (dyn Allocator)) (src (ptr (ArrayList StructDef)))] (-> (ptr (ArrayList StructDef)))
  (let [n (len (load src))
        (mut keys) (ArrayList::new [(slice u8)] a)
        (mut out) (ArrayList::new [StructDef] a)
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (push! (mut keys) (.name (elem src (load i))))
                (set! i (primitive/iadd (load i) 1)))))
    (let [ord (sort-index-by-name a (load keys))
          (mut c) 0]
      (loop (if (>= (load c) n)
                (break)
                (do
                  (push! (mut out) (get (load src) (get ord (load c))))
                  (set! c (primitive/iadd (load c) 1))))))
    (box-al [StructDef] a (load out))))

(defn sort-sums [(a (dyn Allocator)) (src (ptr (ArrayList SumDef)))] (-> (ptr (ArrayList SumDef)))
  (let [n (len (load src))
        (mut keys) (ArrayList::new [(slice u8)] a)
        (mut out) (ArrayList::new [SumDef] a)
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (push! (mut keys) (.name (elem src (load i))))
                (set! i (primitive/iadd (load i) 1)))))
    (let [ord (sort-index-by-name a (load keys))
          (mut c) 0]
      (loop (if (>= (load c) n)
                (break)
                (do
                  (push! (mut out) (get (load src) (get ord (load c))))
                  (set! c (primitive/iadd (load c) 1))))))
    (box-al [SumDef] a (load out))))

(defn sort-mono-program [(a (dyn Allocator)) (p (ptr Program))] (-> i64)
  (set! (.funcs p) (sort-funcs a (load (field p funcs))))
  (set! (.structs p) (sort-structs a (load (field p structs))))
  (set! (.sums p) (sort-sums a (load (field p sums))))
  0)

; ============================ entry ========================================
; dump-mono: read -> load -> resolve -> check -> mono -> sorted mono Program dump.
; (Was named dump-checked-program; the real checked dumper — which STOPS at check,
; no mono — is defined below. This serves the `dump-mono` gate subcommand.)
