; src/compiler/mono.coil — self-host Coil compiler, mono module.
(module mono)
(import "coil.primitive" :as primitive)

(import "coil.alloc" :as alloc :use *)
(import "coil.result" :use *)
(import "coil.slice" :use *)
(import "coil.str" :use *)
(import "coil.arraylist" :use *)
(import "coil.hashmap" :use *)
(import "coil.io" :use *)
(import "coil.control" :use *)
(import "coil.try" :use *)
(import "coil.reader" :use *)
(import "ast" :use *)
(import "astdump" :use *)
(import "check" :use *)
(import "comptime" :use *)
(import "parser" :use *)
(import "resolve" :use *)
(import "loader" :use *)

(defstruct Subst [(names (ptr (ArrayList (slice u8)))) (types (ptr (ArrayList Type)))])
; A pending instantiation request (template name + concrete type-args).
(defstruct PendInst [(name (slice u8)) (args (ptr (ArrayList Type)))])
; The monomorphizer state. gfuncs/gstructs/gsums are
; the FILTERED generic templates; the rest are growable output/work lists.
(defstruct MonoCtx
  [(a (dyn Allocator))
   (gfuncs (ptr (ArrayList Func)))
   (gstructs (ptr (ArrayList StructDef)))
   (gsums (ptr (ArrayList SumDef)))
   (vsum-names (ArrayList (slice u8)))
   (vsum-sums (ArrayList (slice u8)))
   (out-structs (ArrayList StructDef))
   (out-sums (ArrayList SumDef))
   (out-funcs (ArrayList Func))
   ; O(1) name -> index side-index into the three out-* lists, so upsert (which
   ; MUST insert-or-replace by name) is a map lookup, not a scan of an output list
   ; that grows with every instantiation. The out-* ArrayLists stay the source of
   ; truth for order; these maps only accelerate the lookup (gen-10).
   (out-struct-idx (HashMap (slice u8) i64))
   (out-sum-idx (HashMap (slice u8) i64))
   (out-func-idx (HashMap (slice u8) i64))
   (pending-structs (ArrayList PendInst))
   (pending-sums (ArrayList PendInst))
   (pending-funcs (ArrayList PendInst))
   ; The dedupe SETS: membership decides whether an instantiation is already
   ; queued. Hash sets (value unused) so the check is O(1), not a linear scan that
   ; made the whole worklist ~O(n^2) (gen-10). First-encounter order is preserved
   ; because a name is pushed to pending-* exactly once, on its first `queue-*`.
   (queued-structs (HashMap (slice u8) i64))
   (queued-sums (HashMap (slice u8) i64))
   (queued-funcs (HashMap (slice u8) i64))
   ; Checked source-program environment used to run affine/drop elaboration on
   ; each function only after its generic parameters have concrete types.
   (ownership_cx (ptr Cx))
   ; the program's impls (for resolving a deferred TraitCall against a GENERIC
   ; impl), and the instantiation-origin map: mangled name -> (base, args), so
   ; a TraitCall receiver that resolved to a mangled struct recovers its base
   ; (the impl dispatch key) and args (the impl pattern's bindings).
   (impls (ptr (ArrayList ImplDef)))
   (trait_impl_idx (HashMap (slice u8) (ptr ImplBucket)))
   ; instantiation-origin: mangled name -> its index in io-origin (the parallel
   ; (base, args) record). A hash index so io-record!/io-find are O(1) instead of a
   ; scan of a list that grows with every instantiation (gen-10). io-origin stays an
   ; ArrayList (ETraitCall reads it by that index), appended in first-seen order.
   (io-index (HashMap (slice u8) i64))
   (io-origin (ArrayList PendInst))
   (origins (ArrayList MonoOrigin))
   (trait_uses (ArrayList MonoTraitUse))
   (current_source (slice u8))])

; ---- small constructors -----------------------------------------------------
(defn mk-field [(name (slice u8)) (ty Type)] (-> Field)
  (let [p (primitive/alloc-stack Field)] (set! (.name p) name) (set! (.ty p) ty) (load p)))
(defn mk-param [(name (slice u8)) (ty Type)] (-> Param)
  (let [p (primitive/alloc-stack Param)]
    (set! (.name p) name)
    (set! (.ty p) ty)
    (set! (.bid p) 0)
    (set! (.owned_type p) (primitive/cast (ptr Type) 0))
    (load p)))
(defn mk-param-bid [(name (slice u8)) (ty Type) (bid i64)] (-> Param)
  (let [p (primitive/alloc-stack Param)]
    (set! p (mk-param name ty))
    (set! (.bid p) bid)
    (load p)))
(defn mk-variant [(name (slice u8)) (fields (ptr (ArrayList Field)))] (-> Variant)
  (let [p (primitive/alloc-stack Variant)] (set! (.name p) name) (set! (.fields p) fields) (load p)))
(defn mk-arm [(variant (slice u8)) (binds (ptr (ArrayList (slice u8)))) (body Expr)] (-> Arm)
  (let [p (primitive/alloc-stack Arm)]
    (set! (.variant p) variant)
    (set! (.binds p) binds)
    (set! (.body p) body)
    (load p)))
(defn mk-pend [(a (dyn Allocator)) (name (slice u8)) (args (ptr (ArrayList Type)))] (-> PendInst)
  (let [p (primitive/alloc-stack PendInst)] (set! (.name p) name) (set! (.args p) args) (load p)))
(defn t-app-args [(t (ptr Type))] (-> (ptr (ArrayList Type)))
  (t-fn-params t))
(defn pack-value? [(t (ptr Type))] (-> bool)
  (match (load t) (TApp [n _] (= n "$pack")) (_ false)))
(defn dots-name? [(s (slice u8))] (-> bool)
  (let [n (slice-len s)] (and (>= n 3) (= (subslice s (primitive/isub n 3) n) "..."))))
(defn dots-base [(s (slice u8))] (-> (slice u8))
  (if (dots-name? s) (subslice s 0 (primitive/isub (slice-len s) 3)) s))
(defn indexed-name [(a (dyn Allocator)) (base (slice u8)) (i i64)] (-> (slice u8))
  (sconcat a (sconcat a base "$") (i64->str a i)))

; ---- Subst -----------------------
(defn mk-subst [(a (dyn Allocator)) (names (ptr (ArrayList (slice u8)))) (types (ptr (ArrayList Type)))] (-> (ptr Subst))
  (let [s (box! a Subst (primitive/zeroed Subst))]
    (set! (.names s) names)
    (set! (.types s) types)
    s))
(defn subst-empty [(a (dyn Allocator))] (-> (ptr Subst))
  (mk-subst a (box-al [(slice u8)] a (al-new [(slice u8)] a)) (box-items-type a)))
; — zip params with args (parallel-list HashMap).
(defn subst-map [(a (dyn Allocator)) (params (ptr (ArrayList (slice u8)))) (args (ptr (ArrayList Type)))] (-> (ptr Subst))
  (let [np (al-len [(slice u8)] (load params))
        na (al-len [Type] (load args))
        (mut pi) -1
        (mut i) 0]
    (loop (if (>= (load i) np)
              (break)
              (do
                (when (dots-name? (al-get [(slice u8)] (load params) (load i)))
                  (store! pi (load i))
                  (break))
                (set! i (primitive/iadd (load i) 1)))))
    (if (or (< (load pi) 0)
            (and (= na np) (pack-value? (al-elem [Type] args (load pi)))))
        (mk-subst a params args)
        (let [tail (primitive/isub np (primitive/iadd (load pi) 1))
              count (primitive/isub na (primitive/iadd (load pi) tail))
              (mut out) (al-new [Type] a)
              (mut j) 0]
          (loop (if (>= (load j) (load pi))
                    (break)
                    (do
                      (al-push! (mut out) (al-get [Type] (load args) (load j)))
                      (set! j (primitive/iadd (load j) 1)))))
          (let [(mut packed) (al-new [Type] a)]
            (set! j 0)
            (loop (if (>= (load j) count)
                      (break)
                      (do
                        (al-push! (mut packed) (al-get [Type] (load args) (primitive/iadd (load pi) (load j))))
                        (set! j (primitive/iadd (load j) 1)))))
            (al-push! (mut out) (TApp "$pack" (box-al [Type] a (load packed)))))
          (set! j 0)
          (loop (if (>= (load j) tail)
                    (break)
                    (do
                      (al-push! (mut out)
                                (al-get [Type] (load args) (primitive/iadd (primitive/iadd (load pi) count) (load j))))
                      (set! j (primitive/iadd (load j) 1)))))
          (mk-subst a params (box-al [Type] a (load out)))))))
(defn subst-lookup [(s (ptr Subst)) (name (slice u8))] (-> (Option Type))
  (let [ns (load (field s names))
        ts (load (field s types))
        n (al-len [(slice u8)] (load ns))
        (mut i) 0
        (mut r) (None [Type])]
    (loop (if (>= (load i) n)
              (break)
              (do
                (when (= (al-get [(slice u8)] (load ns) (load i)) name)
                  (store! r (Some (al-get [Type] (load ts) (load i))))
                  (break))
                (set! i (primitive/iadd (load i) 1)))))
    (load r)))
(defn mono-subst-insert! [(s (ptr Subst)) (name (slice u8)) (ty Type)] (-> i64)
  (al-push! (mut (load (field s names))) name)
  (al-push! (mut (load (field s types))) ty)
  0)
(defn mono-subst-copy [(a (dyn Allocator)) (s (ptr Subst))] (-> (ptr Subst))
  (let [(mut names) (al-new [(slice u8)] a) (mut types) (al-new [Type] a)]
    (for [i 0 (al-len [(slice u8)] (load (load (field s names))))]
      (al-push! (mut names) (al-get [(slice u8)] (load (field s names)) i))
      (al-push! (mut types) (al-get [Type] (load (field s types)) i)))
    (mk-subst a (box-al [(slice u8)] a (load names)) (box-al [Type] a (load types)))))

(defn extend-associated-subst! [(m (ptr MonoCtx)) (f (ptr Func)) (map (ptr Subst))] (-> i64)
  (let [a (load (field m a)) bounds (load (field f bounds))]
    (for [bi 0 (al-len [Bound] (load bounds))]
      (let [bound (al-elem [Bound] bounds bi)]
        (match (subst-lookup map (.name bound))
          (None [] 0)
          (Some [concrete]
            (let [raw (box-type a concrete)
                  oi (if (= (type-tag raw) 6) (io-find m (type-struct-name raw)) -1)
                  semantic (if (>= oi 0)
                               (let [origin (al-elem [PendInst] (field m io-origin) oi)]
                                 (TApp (load (field origin name)) (load (field origin args))))
                               concrete)
                  cp (box-type a semantic) traits (load (field bound traits))]
              (for [ti 0 (al-len [(slice u8)] (load traits))]
                (let [tr (al-get [(slice u8)] (load traits) ti)
                      td (trait-find (load (field m ownership_cx)) tr)
                      ip (impl-lookup-sel a m tr cp)]
                  (unless (or (= (primitive/cast i64 td) 0) (= (primitive/cast i64 ip) 0))
                    (let [assoc (impl-associated-bindings a ip td cp)
                          impl-binds (subst-new a)]
                      (unify-trait-extras a (field ip self_type) cp
                                          (load (field ip type_params)) impl-binds)
                      (let [params (load (field td type_params))]
                        (for [pi 0 (al-len [(slice u8)] (load params))]
                          (let [p (al-get [(slice u8)] (load params) pi)
                                value (subst-get assoc p)]
                            (unless (= (primitive/cast i64 value) 0)
                              (mono-subst-insert! map (assoc-tp-name a (.name bound) tr p)
                                                  (subst-apply a value impl-binds))
                              0))))))))))))))
  0)
(defn subst-pack [(s (ptr Subst))] (-> (ptr (ArrayList Type)))
  (let [ts (load (field s types))
        n (al-len [Type] (load ts))
        (mut i) 0
        (mut out) (primitive/cast (ptr (ArrayList Type)) 0)]
    (loop (if (>= (load i) n)
              (break)
              (let [tp (al-elem [Type] ts (load i))]
                (if (pack-value? tp)
                    (do (set! out (t-app-args tp)) (break))
                    (set! i (primitive/iadd (load i) 1))))))
    (load out)))

; ---- type_key / mangle — mutually recursive -------------------
(defn type-key [(a (dyn Allocator)) (t (ptr Type))] (-> (slice u8))
  (let [tg (type-tag t)]
    (cond (= tg (primitive/cast i64 12)) "never"
          (= tg (primitive/cast i64 13)) "code"
          (= tg (primitive/cast i64 15)) "codebuilder"
          (= tg (primitive/cast i64 3)) "void"
          (= tg (primitive/cast i64 0)) (sconcat a (if (t-int-signed t) "i" "u") (i64->str a (t-int-bits t)))
          (= tg (primitive/cast i64 1)) (sconcat a "f" (i64->str a (t-int-bits t)))
          (= tg (primitive/cast i64 2)) "bool"
          (= tg (primitive/cast i64 4)) (sconcat a "ptr_" (type-key a (t-inner t)))
          (= tg (primitive/cast i64 5)) (sconcat a "ref_" (type-key a (t-inner t)))
          (= tg (primitive/cast i64 6)) (type-struct-name t)
          (= tg (primitive/cast i64 7))
            (sconcat a
                     (sconcat a "arr" (i64->str a (t-arrn t)))
                     (sconcat a "_" (type-key a (t-inner t))))
          (= tg (primitive/cast i64 8)) (sconcat a "slice_" (type-key a (t-inner t)))
          (= tg (primitive/cast i64 9))
            (sconcat a
                     (sconcat a "vec" (i64->str a (t-arrn t)))
                     (sconcat a "_" (type-key a (t-inner t))))
          (= tg (primitive/cast i64 10))
            (mangle a
                    (sconcat a
                             (sconcat3 a "fn_" (t-fn-cc t) "_")
                             (type-key a (t-fn-ret t)))
                    (t-fn-params t))
          :else (mangle a (t-app-name t) (t-app-args t)))))
(defn mangle [(a (dyn Allocator)) (name (slice u8)) (args (ptr (ArrayList Type)))] (-> (slice u8))
  (let [(mut s) name
        n (al-len [Type] (load args))
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (set! s (sconcat a (load s) (sconcat a "__" (type-key a (al-elem [Type] args (load i))))))
                (set! i (primitive/iadd (load i) 1)))))
    (load s)))

; ---- trait_method_fn / type_impl_name --------------------------
; Delegates to check's `tmfn` — the ONE definition. These were two hand-synced copies
; of the same scheme; a mangler that drifts from the one used to EMIT the impl's
; functions produces calls to symbols that don't exist.
(defn trait-method-fn [(a (dyn Allocator)) (trait (slice u8)) (type-name (slice u8)) (method (slice u8))] (-> (slice u8))
  (tmfn a trait type-name method))
; The dispatch key for a deferred trait call whose Self resolved to a concrete type.
; Delegates to the ONE definition (`parser.coil::impl-base-name`) — this was a third
; hand-synced copy, and it silently lagged the other two: `(!= p q)` on a pointer is a
; bounded generic, so `Eq` for `(ptr T)` is resolved HERE, and a copy that didn't know
; about pointers type-checked fine and then hit the `unimplemented` below at mono time.
(defn mono-impl-name [(a (dyn Allocator)) (t (ptr Type))] (-> (Option (slice u8)))
  (let [n (impl-base-name a t)]
    (if (= (slice-len n) (primitive/cast i64 0)) (None [(slice u8)]) (Some n))))

; ---- generic-impl resolution for deferred trait calls ----------
(defn impl-lookup [(m (ptr MonoCtx)) (tr (slice u8)) (base (slice u8))] (-> (ptr ImplDef))
  (let [bucket (impl-index-get (field m trait_impl_idx) (impl-index-key (load (field m a)) tr base))]
    (if (= (primitive/cast i64 bucket) (primitive/cast i64 0))
        (primitive/cast (ptr ImplDef) 0)
        (al-elem [ImplDef]
                 (load (field m impls))
                 (al-get [i64] (.items bucket) 0)))))
; Several impls can share a key, so "first one with this key" is not good enough here
; either: pick the most specific whose pattern accepts the receiver. That is exactly
; `check.coil::impl-select-indexed`, called with mono's own impl table and index — NOT a second copy of
; the rule. A parallel implementation here would be free to disagree with the one that
; type-checked the program, which is the whole failure mode this phase keeps hitting.
(defn impl-lookup-sel [(a (dyn Allocator)) (m (ptr MonoCtx)) (tr (slice u8)) (recv (ptr Type))] (-> (ptr ImplDef))
  (let [s (primitive/alloc-stack ImplSel)]
    (set! s
          (impl-select-indexed a
                               (load (field m impls))
                               (impl-index-get (field m trait_impl_idx)
                                               (impl-index-key a tr (type-impl-name a recv)))
                               tr
                               recv))
    (load (field s ip))))
; NOTE: the impl-pattern matcher lives in check.coil (`unify-trait-extras`) and mono
; uses it directly. There was a second one here (`match-impl-pattern`/`mip-list`),
; which is how a receiver could be accepted by the selector and then rejected by the
; binder. One matcher, one answer.

; ---- generic-template lookups (the gfuncs/gstructs/gsums HashMaps) -----------
(defn find-struct-named [(lst (ptr (ArrayList StructDef))) (nm (slice u8))] (-> i64)
  (let [n (al-len [StructDef] (load lst))
        (mut i) 0
        (mut r) -1]
    (loop (if (>= (load i) n)
              (break)
              (do
                (when (= (load (field (al-elem [StructDef] lst (load i)) name)) nm)
                  (store! r
                          (load i))
                  0)
                (set! i (primitive/iadd (load i) 1)))))
    (load r)))
(defn find-sum-named [(lst (ptr (ArrayList SumDef))) (nm (slice u8))] (-> i64)
  (let [n (al-len [SumDef] (load lst))
        (mut i) 0
        (mut r) -1]
    (loop (if (>= (load i) n)
              (break)
              (do
                (when (= (load (field (al-elem [SumDef] lst (load i)) name)) nm)
                  (store! r
                          (load i))
                  0)
                (set! i (primitive/iadd (load i) 1)))))
    (load r)))
(defn find-func-named [(lst (ptr (ArrayList Func))) (nm (slice u8))] (-> i64)
  (let [n (al-len [Func] (load lst))
        (mut i) 0
        (mut r) -1]
    (loop (if (>= (load i) n)
              (break)
              (do
                (when (= (load (field (al-elem [Func] lst (load i)) name)) nm)
                  (store! r
                          (load i))
                  0)
                (set! i (primitive/iadd (load i) 1)))))
    (load r)))
(defn gstruct-has [(m (ptr MonoCtx)) (nm (slice u8))] (-> bool)
  (>= (find-struct-named (load (field m gstructs)) nm) (primitive/cast i64 0)))
(defn gsum-has [(m (ptr MonoCtx)) (nm (slice u8))] (-> bool)
  (>= (find-sum-named (load (field m gsums)) nm) (primitive/cast i64 0)))
(defn gfunc-has [(m (ptr MonoCtx)) (nm (slice u8))] (-> bool)
  (>= (find-func-named (load (field m gfuncs)) nm) (primitive/cast i64 0)))
(defn gstruct-arity [(m (ptr MonoCtx)) (nm (slice u8))] (-> i64)
  (al-len [(slice u8)]
          (load (field (al-elem [StructDef]
                                (load (field m gstructs))
                                (find-struct-named (load (field m
                                                                gstructs))
                                                   nm))
                       type_params))))
(defn gsum-arity [(m (ptr MonoCtx)) (nm (slice u8))] (-> i64)
  (al-len [(slice u8)]
          (load (field (al-elem [SumDef]
                                (load (field m gsums))
                                (find-sum-named (load (field m
                                                             gsums))
                                                nm))
                       type_params))))
(defn gfunc-arity [(m (ptr MonoCtx)) (nm (slice u8))] (-> i64)
  (al-len [(slice u8)]
          (load (field (al-elem [Func]
                                (load (field m gfuncs))
                                (find-func-named (load (field m
                                                              gfuncs))
                                                 nm))
                       type_params))))
; variant_to_sum lookup.
(defn variant-sum [(m (ptr MonoCtx)) (func (slice u8))] (-> (Option (slice u8)))
  (let [ns (.vsum-names m)
        ss (.vsum-sums m)
        n (al-len [(slice u8)] ns)
        (mut i) 0
        (mut r) (None [(slice u8)])]
    (loop (if (>= (load i) n)
              (break)
              (do
                (when (= (al-get [(slice u8)] ns (load i)) func)
                  (store! r (Some (al-get [(slice u8)] ss (load i))))
                  (break))
                (set! i (primitive/iadd (load i) 1)))))
    (load r)))

; ---- queues — dedup via the queued set ----------------
(defn io-record! [(m (ptr MonoCtx)) (kind i64) (mng (slice u8))
                  (nm (slice u8)) (args (ptr (ArrayList Type)))] (-> i64)
  (unless (hm-contains? [(slice u8) i64] (load (field m io-index)) mng)
    ; index the new record gets = current length (its slot after the push), so
    ; io-index maps mng -> its position in io-origin, exactly the old parallel index.
    (let [idx (al-len [PendInst] (load (field m io-origin)))]
      (al-push! (mut (field m io-origin)) (mk-pend (load (field m a)) nm args))
      (let [origin (primitive/alloc-stack MonoOrigin)]
        (set! (.kind origin) kind)
        (set! (.generated origin) mng)
        (set! (.source origin) nm)
        (set! (.args origin) args)
        (set! (.trait_name origin) "")
        (set! (.impl_source origin) "")
        (al-push! (mut (field m origins)) (load origin)))
      (hm-put! [(slice u8) i64] (mut (field m io-index)) mng idx)
      0)))
(defn io-find [(m (ptr MonoCtx)) (mng (slice u8))] (-> i64)
  (match (hm-get [(slice u8) i64] (.io-index m) mng)
    (Some [i] i)
    (None [] -1)))

(defn io-mark-trait! [(m (ptr MonoCtx)) (mng (slice u8))
                      (trait-name (slice u8))
                      (impl-source (slice u8))] (-> i64)
  (let [index (io-find m mng)]
    (if (< index 0)
        0
        (let [origin (al-elem [MonoOrigin] (field m origins) index)]
          (set! (.trait_name origin) trait-name)
          (set! (.impl_source origin) impl-source)
          0))))

(defn trait-use-record! [(m (ptr MonoCtx))
                         (trait-name (slice u8))
                         (impl-source (slice u8))
                         (method-name (slice u8))
                         (generated (slice u8))] (-> i64)
  (let [(mut found) false]
    (for [i 0 (al-len [MonoTraitUse] (.trait_uses m))]
      (let [use (al-elem [MonoTraitUse] (field m trait_uses) i)]
        (if (and (= (.caller_source use) (.current_source m))
                 (and (= (.trait_name use) trait-name)
                      (and (= (.impl_source use) impl-source)
                           (= (.method_name use) method-name))))
            (set! found true) 0)))
    (if (load found)
        0
        (let [use (primitive/alloc-stack MonoTraitUse)]
          (set! (.caller_source use) (.current_source m))
          (set! (.trait_name use) trait-name)
          (set! (.impl_source use) impl-source)
          (set! (.method_name use) method-name)
          (set! (.generated_artifact use) generated)
          (al-push! (mut (field m trait_uses)) (load use))
          0))))

; Ownership elaboration needs the semantic generic shape, not only the concrete
; ABI name produced by monomorphization.  The source checking context knows how
; `(Arc T)` is dropped, but it deliberately has no declaration named
; `Arc__Payload`; that name exists only in mono's output program.  Recovering the
; recorded origin lets the shared ownership machinery select the generic Drop
; impl and inspect generic fields before the final expression resolver lowers the
; synthesized glue back to concrete ABI names.
(defn ownership-semantic-type-list [(m (ptr MonoCtx))
                                    (xs (ptr (ArrayList Type)))] (-> (ptr (ArrayList Type)))
  (let [a (load (field m a))
        n (al-len [Type] (load xs))
        (mut out) (al-new [Type] a)
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (al-push! (mut out) (ownership-semantic-type m (al-elem [Type] xs (load i))))
                (set! i (primitive/iadd (load i) 1)))))
    (box-al [Type] a (load out))))

(defn ownership-semantic-type [(m (ptr MonoCtx)) (t (ptr Type))] (-> Type)
  (let [a (load (field m a))]
    (match (load t)
      (TStruct [name]
        (let [idx (io-find m name)]
          (if (< idx (primitive/cast i64 0))
              (load t)
              (let [origin (al-elem [PendInst] (field m io-origin) idx)]
                (TApp (load (field origin name))
                      (ownership-semantic-type-list m (load (field origin args))))))))
      (TPtr [inner] (TPtr (box-type a (ownership-semantic-type m inner))))
      (TRef [mu inner] (TRef mu (box-type a (ownership-semantic-type m inner))))
      (TArray [inner count] (TArray (box-type a (ownership-semantic-type m inner)) count))
      (TSlice [inner] (TSlice (box-type a (ownership-semantic-type m inner))))
      (TVec [inner count] (TVec (box-type a (ownership-semantic-type m inner)) count))
      (TApp [name args]
        (TApp name (ownership-semantic-type-list m args)))
      (_ (load t)))))
; ---- runaway instantiation guard --------------------------------------------
; A generic that recurses on a WRAPPED version of its own argument (T -> (Box T) ->
; (Box (Box T)) -> …) never reaches a fixpoint: every round mints a type the dedupe set
; has never seen, so `drain` queues forever. It did so silently — no output, no progress,
; no limit — turning a typo-shaped mistake into a build that never finishes and never
; says why. In CI that eats the whole job.
;
; Type-term DEPTH is the exact signal. Every other way to diverge is already closed:
; identical (name, args) is deduped by the queued-* sets, and there are no const generics
; to diverge over — so an unbounded run must grow the term. Real code never nests types
; anywhere near this deep, so the limit only ever fires on a genuine runaway.
(defn ty-depth [(t (ptr Type))] (-> i64)
  (match (load t)
    (TPtr [i] (primitive/iadd 1 (ty-depth i)))
    (TRef [mu i] (primitive/iadd 1 (ty-depth i)))
    (TArray [e n] (primitive/iadd 1 (ty-depth e)))
    (TSlice [e] (primitive/iadd 1 (ty-depth e)))
    (TVec [e n] (primitive/iadd 1 (ty-depth e)))
    (TApp [nm as2] (primitive/iadd 1 (ty-list-depth as2)))
    (TFn [cc ps r] (primitive/iadd 1 (ty-depth r)))
    (TInt [b s] 1)
    (TFloat [b] 1)
    (TBool [] 1)
    (TVoid [] 1)
    (TStruct [n] 1)
    (TNever [] 1)
    (TCode [] 1)
    (TCodeBuilder [] 1)
    (TExternRef [] 1)))

(defn ty-list-depth [(lst (ptr (ArrayList Type)))] (-> i64)
  (let [n (al-len [Type] (load lst))
        (mut i) 0
        (mut mx) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (let [d (ty-depth (al-elem [Type] lst (load i)))]
                  (when (> d (load mx)) (store! mx d) 0))
                (set! i (primitive/iadd (load i) 1)))))
    (load mx)))

(defn mono-depth-limit [] (-> i64)
  64)
(defn mono-name-limit [] (-> i64)
  512)

; the deepest type argument in this instantiation request
(defn pend-depth [(args (ptr (ArrayList Type)))] (-> i64)
  (ty-list-depth args))

; Two views of the same thing — the type TERM got too big:
;   depth: catches growth still shaped as a term, e.g. (Box (Box (Box …))) as a TApp.
;   name:  catches growth AFTER substitution, which is the case that actually fires.
;          Mono rewrites (Box T) to a TStruct whose mangled NAME carries the nesting
;          (Box$i64 -> Box$Box$i64 -> …), so the term depth stays 1 while the term size
;          grows without bound. Measuring depth alone silently misses the real runaway.
(defn mono-runaway? [(args (ptr (ArrayList Type))) (mng (slice u8))] (-> bool)
  (or (> (pend-depth args) (mono-depth-limit))
      (> (slice-len [u8] mng) (mono-name-limit))))

; Show the growth rather than just asserting it: the mangled name spells the nesting
; out (Box$Box$Box$…), which is the one thing that makes the mistake obvious. Truncated
; — at depth 64 it is thousands of characters.
(defn mono-runaway-diag [(a (dyn Allocator)) (what (slice u8)) (nm (slice u8)) (mng (slice u8))] (-> Diag)
  (let [shown
          (if (> (slice-len [u8] mng) (primitive/cast i64 100))
              (sconcat a (subslice mng 0 100) " …")
              mng)]
    (derr (sconcat3 a
                    (sconcat3 a
                              "monomorphization: "
                              what
                              (sconcat3 a
                                        " '"
                                        nm
                                        "' is being instantiated with an ever-growing type, so it never reaches a fixpoint. A generic that recurses on a WRAPPED version of its own argument (T -> (Box T) -> (Box (Box T)) -> …) mints a type nobody has seen every round and instantiates forever. Last instantiation: "))
                    shown
                    ""))))

(defn queue-struct [(m (ptr MonoCtx)) (nm (slice u8)) (args (ptr (ArrayList Type)))] (-> i64)
  (let [a (load (field m a))
        mng (mangle a nm args)]
    (io-record! m 2 mng nm args)
    (unless (hm-contains? [(slice u8) i64] (load (field m queued-structs)) mng)
      (hm-put! [(slice u8) i64] (mut (field m queued-structs)) mng 0)
      (al-push! (mut (field m pending-structs)) (mk-pend a nm args))
      0)))
(defn queue-sum [(m (ptr MonoCtx)) (nm (slice u8)) (args (ptr (ArrayList Type)))] (-> i64)
  (let [a (load (field m a))
        mng (mangle a nm args)]
    (io-record! m 3 mng nm args)
    (unless (hm-contains? [(slice u8) i64] (load (field m queued-sums)) mng)
      (hm-put! [(slice u8) i64] (mut (field m queued-sums)) mng 0)
      (al-push! (mut (field m pending-sums)) (mk-pend a nm args))
      0)))
(defn queue-func [(m (ptr MonoCtx)) (nm (slice u8)) (args (ptr (ArrayList Type)))] (-> i64)
  (let [a (load (field m a))
        mng (mangle a nm args)]
    ; Keep the origin for the post-ownership resolve pass. Ownership elaboration
    ; runs after the first generic substitution and may introduce EMovePlace at
    ; an already-mangled call. Recovering the source generic signature here is
    ; what lets that second pass choose value bits versus a pointer ABI correctly.
    (io-record! m 1 mng nm args)
    (unless (hm-contains? [(slice u8) i64] (load (field m queued-funcs)) mng)
      (hm-put! [(slice u8) i64] (mut (field m queued-funcs)) mng 0)
      (al-push! (mut (field m pending-funcs)) (mk-pend a nm args))
      0)))

; "<prefix> expects N type arguments, got M" — the shared arity-error shape.
(defn arity-err [(a (dyn Allocator)) (prefix (slice u8)) (n i64) (m i64)] (-> (slice u8))
  (sconcat a
           prefix
           (sconcat a " expects " (sconcat a (i64->str a n) (sconcat a " type arguments, got " (i64->str a m))))))

; ---- resolve_ty — substitute params, mangle generic apps ------
(defn resolve-ty-list [(m (ptr MonoCtx)) (lst (ptr (ArrayList Type))) (map (ptr Subst))] (-> (Result (ptr (ArrayList Type))
                                                                                                     Diag))
  (let [a (load (field m a))
        n (al-len [Type] (load lst))
        (mut out) (al-new [Type] a)
        (mut i) 0
        (mut err) (primitive/zeroed Diag)
        (mut failed) false]
    (loop (if (>= (load i) n)
              (break)
              (do
                (match (resolve-ty m (al-elem [Type] lst (load i)) map)
                  (Err [d] (do (set! err d) (set! failed true) (break)))
                  (Ok [t]
                      (let [tp (box-type a t)]
                        (if (pack-value? tp)
                            (let [xs (t-app-args tp)
                                  nx (al-len [Type] (load xs))
                                  (mut j) 0]
                              (loop (if (>= (load j) nx)
                                        (break)
                                        (do
                                          (al-push! (mut out) (al-get [Type] (load xs) (load j)))
                                          (set! j (primitive/iadd (load j) 1))))))
                            (al-push! (mut out) t)))))
                (set! i (primitive/iadd (load i) 1)))))
    (if (load failed) (Err [(ptr (ArrayList Type)) Diag] (load err)) (Ok (box-al [Type] a (load out))))))
; Generic type-argument vectors retain one entry per declared parameter.  A pack
; substitution is therefore kept as one `$pack` entry here; only ABI/type
; sequences use resolve-ty-list's splicing behavior.
(defn resolve-ty-args [(m (ptr MonoCtx)) (lst (ptr (ArrayList Type))) (map (ptr Subst))] (-> (Result (ptr (ArrayList Type))
                                                                                                     Diag))
  (let [a (load (field m a))
        n (al-len [Type] (load lst))
        (mut out) (al-new [Type] a)
        (mut i) 0
        (mut err) (primitive/zeroed Diag)
        (mut failed) false]
    (loop (if (>= (load i) n)
              (break)
              (do
                (match (resolve-ty m (al-elem [Type] lst (load i)) map)
                  (Err [d] (do (set! err d) (set! failed true) (break)))
                  (Ok [t] (al-push! (mut out) t)))
                (set! i (primitive/iadd (load i) 1)))))
    (if (load failed) (Err [(ptr (ArrayList Type)) Diag] (load err)) (Ok (box-al [Type] a (load out))))))
(defn resolve-ty-app [(m (ptr MonoCtx)) (t (ptr Type)) (map (ptr Subst))] (-> (Result Type Diag))
  (let [a (load (field m a))
        nm (t-app-name t)]
    (if (= nm "$pack-var")
        (match (subst-lookup map (type-struct-name (al-elem [Type] (t-app-args t) 0)))
          (Some [v] (Ok v))
          (None [] (Err [Type Diag] (derr "internal: unbound type pack during monomorphization"))))
        (if (= nm "$pack")
            (Ok (load t))
            (match (resolve-ty-list m (t-app-args t) map)
              (Err [d] (Err [Type Diag] d))
              (Ok [rargs]
                  (let [mng (mangle a nm rargs)
                        rlen (al-len [Type] (load rargs))]
                    (if (gstruct-has m nm)
                        (let [ar (gstruct-arity m nm)]
                          (if (not (= ar rlen))
                              (Err [Type Diag] (derr (arity-err a (sconcat3 a "generic type '" nm "'") ar rlen)))
                              (do (queue-struct m nm rargs) (Ok (TStruct mng)))))
                        (if (gsum-has m nm)
                            (let [ar (gsum-arity m nm)]
                              (if (not (= ar rlen))
                                  (Err [Type Diag] (derr (arity-err a (sconcat3 a "generic type '" nm "'") ar rlen)))
                                  (do (queue-sum m nm rargs) (Ok (TStruct mng)))))
                            (Err [Type Diag] (derr (sconcat3 a "unknown generic type '" nm "'"))))))))))))
(defn resolve-ty [(m (ptr MonoCtx)) (t (ptr Type)) (map (ptr Subst))] (-> (Result Type Diag))
  (let [a (load (field m a))
        tg (type-tag t)]
    (cond (= tg (primitive/cast i64 12)) (Ok (TNever))
          (= tg (primitive/cast i64 13)) (Ok (TCode))
          (= tg (primitive/cast i64 14)) (Ok (TExternRef))
          (= tg (primitive/cast i64 15)) (Ok (TCodeBuilder))
          (= tg (primitive/cast i64 3)) (Ok (TVoid))
          (= tg (primitive/cast i64 0)) (Ok (TInt (t-int-bits t) (t-int-signed t)))
          (= tg (primitive/cast i64 1)) (Ok (TFloat (t-int-bits t)))
          (= tg (primitive/cast i64 2)) (Ok (TBool))
          (= tg (primitive/cast i64 4))
            (match (resolve-ty m (t-inner t) map)
              (Err [d] (Err [Type Diag] d))
              (Ok [it] (Ok (TPtr (box-type a it)))))
          (= tg (primitive/cast i64 5))
            (match (resolve-ty m (t-inner t) map)
              (Err [d] (Err [Type Diag] d))
              (Ok [it] (Ok (TRef (t-ref-mut t) (box-type a it)))))
          (= tg (primitive/cast i64 7))
            (match (resolve-ty m (t-inner t) map)
              (Err [d] (Err [Type Diag] d))
              (Ok [it] (Ok (TArray (box-type a it) (t-arrn t)))))
          (= tg (primitive/cast i64 8))
            (match (resolve-ty m (t-inner t) map)
              (Err [d] (Err [Type Diag] d))
              (Ok [it] (Ok (TSlice (box-type a it)))))
          (= tg (primitive/cast i64 9))
            (match (resolve-ty m (t-inner t) map)
              (Err [d] (Err [Type Diag] d))
              (Ok [it] (Ok (TVec (box-type a it) (t-arrn t)))))
          (= tg (primitive/cast i64 10))
            (match (resolve-ty-list m (t-fn-params t) map)
              (Err [d] (Err [Type Diag] d))
              (Ok [ps]
                  (match (resolve-ty m (t-fn-ret t) map)
                    (Err [d] (Err [Type Diag] d))
                    (Ok [r]
                        (Ok (TFn
                              :cc (t-fn-cc t)
                              :params ps
                              :ret (box-type a r)))))))
          (= tg (primitive/cast i64 6))
            (match (subst-lookup map (type-struct-name t))
              (Some [ct] (Ok ct))
              (None [] (Ok (TStruct (type-struct-name t)))))
          :else (resolve-ty-app m t map))))

; ---- resolve a sum / its variants -----------------
(defn resolve-fields [(m (ptr MonoCtx)) (fs (ptr (ArrayList Field))) (map (ptr Subst))] (-> (Result (ptr (ArrayList Field))
                                                                                                    Diag))
  (let [a (load (field m a))
        n (al-len [Field] (load fs))
        (mut out) (al-new [Field] a)
        (mut i) 0
        (mut err) (primitive/zeroed Diag)
        (mut failed) false]
    (loop (if (>= (load i) n)
              (break)
              (do
                (let [fp (al-elem [Field] fs (load i))]
                  (match (resolve-ty m (field fp ty) map)
                    (Err [d] (do (set! err d) (set! failed true) (break)))
                    (Ok [t] (al-push! (mut out) (mk-field (.name fp) t)))))
                (set! i (primitive/iadd (load i) 1)))))
    (if (load failed) (Err [(ptr (ArrayList Field)) Diag] (load err)) (Ok (box-al [Field] a (load out))))))
(defn resolve-param-one [(m (ptr MonoCtx))
                         (pp (ptr Param))
                         (ty Type)
                         (map (ptr Subst))] (-> (Result Param Diag))
  (try (let [a (load (field m a))
             np (primitive/alloc-stack Param)]
         (set! np (mk-param-bid (.name pp) ty (.bid pp)))
         (unless (= (primitive/cast i64 (.owned_type pp)) (primitive/cast i64 0))
         ; `ty` is the already-substituted semantic parameter type. Using it
           ; directly also avoids retaining a stale generic marker when the
           ; checked body representation differed from the signature type.
           (let [resolved-owner (try! (resolve-ty m (.owned_type pp) map))
                 concrete (box-type a resolved-owner)
                 rp (box-type a (ownership-semantic-type m concrete))]
             (when (type-is-affine a (load (field m ownership_cx)) rp)
               (set! (.owned_type np) rp)
               0))
           0)
         (Ok [Param Diag] (load np)))))

(defn resolve-params [(m (ptr MonoCtx)) (ps (ptr (ArrayList Param))) (map (ptr Subst))] (-> (Result (ptr (ArrayList Param))
                                                                                                    Diag))
  (let [a (load (field m a))
        n (al-len [Param] (load ps))
        (mut out) (al-new [Param] a)
        (mut i) 0
        (mut err) (primitive/zeroed Diag)
        (mut failed) false]
    (loop (if (>= (load i) n)
              (break)
              (do
                (let [pp (al-elem [Param] ps (load i))]
                  (match (resolve-ty m (field pp ty) map)
                    (Err [d] (do (set! err d) (set! failed true) (break)))
                    (Ok [t]
                        (let [tp (box-type a t)]
                          (if (pack-value? tp)
                              (let [xs (t-app-args tp)
                                    nx (al-len [Type] (load xs))
                                    (mut j) 0]
                                (loop (if (>= (load j) nx)
                                          (break)
                                          (do
                                            (al-push! (mut out)
                                                      (mk-param (indexed-name a
                                                                              (dots-base (.name pp))
                                                                              (load j))
                                                                (al-get [Type] (load xs) (load j))))
                                            (set! j (primitive/iadd (load j) 1))))))
                              (match (resolve-param-one m pp t map)
                                (Err [d] (do (set! err d) (set! failed true) (break)))
                                (Ok [np] (al-push! (mut out) np))))))))
                (set! i (primitive/iadd (load i) 1)))))
    (if (load failed) (Err [(ptr (ArrayList Param)) Diag] (load err)) (Ok (box-al [Param] a (load out))))))
(defn resolve-sum [(m (ptr MonoCtx)) (s (ptr SumDef)) (map (ptr Subst)) (name (slice u8))] (-> (Result SumDef Diag))
  (let [a (load (field m a))
        vs (load (field s variants))
        n (al-len [Variant] vs)
        (mut out) (al-new [Variant] a)
        (mut i) 0
        (mut err) (primitive/zeroed Diag)
        (mut failed) false]
    (loop (if (>= (load i) n)
              (break)
              (do
                (let [vp (al-elem [Variant] vs (load i))]
                  (match (resolve-fields m (load (field vp fields)) map)
                    (Err [d] (do (set! err d) (set! failed true) (break)))
                    (Ok [nfs] (al-push! (mut out) (mk-variant (.name vp) nfs)))))
                (set! i (primitive/iadd (load i) 1)))))
    (if (load failed)
        (Err [SumDef Diag] (load err))
        (let [ns (primitive/alloc-stack SumDef)]
          (set! (.name ns) name)
          (set! (.type_params ns) (box-al [(slice u8)] a (al-new [(slice u8)] a)))
          (set! (.bounds ns) (box-al [Bound] a (al-new [Bound] a)))
          (set! (.variants ns) (box-al [Variant] a (load out)))
          (Ok (load ns))))))

; A generic `T` parameter is checked with value ABI because its representation is
; unknown. If substitution makes it an affine aggregate, preserve that external
; ABI but immediately materialize it into the pointer-backed owning place expected
; by drop elaboration and by the instantiated body.
(defn materialize-generic-owner-params [(m (ptr MonoCtx))
                                        (params (ptr (ArrayList Param)))
                                        (body (ptr (ArrayList Expr)))] (-> (ptr (ArrayList Expr)))
  (let [a (load (field m a))
        n (al-len [Param] (load params))
        (mut binds) (al-new [Bind] a)
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (let [pp (al-elem [Param] params (load i))
                      owner-type (.owned_type pp)]
                  (when (and (!= (primitive/cast i64 owner-type) (primitive/cast i64 0))
                             (match (.ty pp)
                               (TStruct [_] true)
                               (TApp [_ _] true)
                               (TArray [_ _] true)
                               (_ false)))
                    (let [name (.name pp)
                          raw-name (sconcat a "$owned.in." name)
                          slot-name (sconcat a "$owned.slot." name)
                          (mut init) (al-new [Expr] a)
                          owner-bind (primitive/alloc-stack Bind)]
                      (set! (.name pp) raw-name)
                      (set! (.owned_type pp) (primitive/cast (ptr Type) 0))
                      (al-push! (mut binds)
                                (mk-bind slot-name
                                         false
                                         (mk-expr (EAlloc 3 (load owner-type) (primitive/cast (ptr Expr) 0))
                                                  -1 -1 -1 0)))
                      (al-push! (mut init)
                                (mk-expr (EInitStore
                                           (box-expr a (mk-expr (EVar slot-name) -1 -1 -1 0))
                                           (box-expr a (mk-expr (EVar raw-name) -1 -1 -1 0)))
                                         -1 -1 -1 0))
                      (al-push! (mut init) (mk-expr (EVar slot-name) -1 -1 -1 0))
                      (set! owner-bind
                            (mk-bind name false (mk-expr (EDo (box-al [Expr] a (load init))) -1 -1 -1 0)))
                      (set! (.bid owner-bind) (.bid pp))
                      (set! (.owned_type owner-bind) owner-type)
                      (al-push! (mut binds) (load owner-bind))
                      0))
                (set! i (primitive/iadd (load i) 1))))))
    (if (= (al-len [Bind] (load binds)) (primitive/cast i64 0))
        body
        (let [(mut wrapped) (al-new [Expr] a)
              (mut inner) (al-new [Expr] a)]
          (if (= (al-len [Expr] (load body)) (primitive/cast i64 0))
              (al-push! (mut inner)
                        (mk-expr (EDo (box-al [Expr] a (al-new [Expr] a))) -1 -1 -1 0))
              (for [j 0 (al-len [Expr] (load body))]
                (al-push! (mut inner) (al-get [Expr] (load body) j))
                0))
          (al-push! (mut wrapped)
                    (mk-expr (ELet (box-al [Bind] a (load binds))
                                   (box-al [Expr] a (load inner)))
                             -1 -1 -1 0))
          (box-al [Expr] a (load wrapped))))))

; ---- resolve a function --------------------------
(defn resolve-func [(m (ptr MonoCtx)) (f (ptr Func)) (map (ptr Subst)) (name (slice u8))] (-> (Result Func Diag))
  (let [a (load (field m a))]
    (set! (.current_source m) (load (field f name)))
    (match (resolve-params m (load (field f params)) map)
      (Err [d] (Err [Func Diag] d))
      (Ok [params]
          (match (resolve-ty m (field f ret) map)
            (Err [d] (Err [Func Diag] d))
            (Ok [ret]
                (match (resolve-expr-list m (load (field f body)) map)
                  (Err [d] (Err [Func Diag] d))
                  (Ok [body]
                      (let [nf (primitive/alloc-stack Func)]
                        (set! (.name nf) name)
                        (set! (.type_params nf) (box-al [(slice u8)] a (al-new [(slice u8)] a)))
                        (set! (.bounds nf) (box-al [Bound] a (al-new [Bound] a)))
                        (set! (.cc nf) (.cc f))
                        (set! (.annotations nf) (load (field f annotations)))
                        (set! (.params nf) params)
                        (set! (.ret nf) ret)
                        (set! (.body nf) (materialize-generic-owner-params m params body))
                        (set! (.macro_variadic nf) false)
                        (set! (.lo nf) (.lo f))
                        (set! (.source nf) (.source f))
                        (set! (.ctxt nf) (.ctxt f))
                        (set! (.hi nf) (.hi f))
                        (Ok (load nf)))))))))))

; ---- resolve expressions -------------------------
(defn resolve-expr-list [(m (ptr MonoCtx)) (lst (ptr (ArrayList Expr))) (map (ptr Subst))] (-> (Result (ptr (ArrayList Expr))
                                                                                                       Diag))
  (let [a (load (field m a))
        n (al-len [Expr] (load lst))
        (mut out) (al-new [Expr] a)
        (mut i) 0
        (mut err) (primitive/zeroed Diag)
        (mut failed) false]
    (loop (if (>= (load i) n)
              (break)
              (do
                (let [ep (al-elem [Expr] lst (load i))]
                  (match (.kind ep)
                    (EVar [nm]
                          (if (dots-name? nm)
                              (let [pack (subst-pack map)]
                                (if (= (primitive/cast i64 pack) (primitive/cast i64 0))
                                    (do
                                      (set! err
                                            (derr "internal: value-pack expansion without a type-pack substitution"))
                                      (set! failed true))
                                    (let [np (al-len [Type] (load pack))
                                          (mut j) 0]
                                      (loop (if (>= (load j) np)
                                                (break)
                                                (do
                                                  (al-push! (mut out)
                                                            (mk-expr (EVar (indexed-name a (dots-base nm) (load j)))
                                                                     (.lo ep)
                                                                     (.hi ep)
                                                                     (.source ep)
                                                                     (.ctxt ep)))
                                                  (set! j (primitive/iadd (load j) 1))))))))
                              (match (resolve-expr m ep map)
                                (Err [d] (do (set! err d) (set! failed true)))
                                (Ok [e] (al-push! (mut out) e)))))
                    (_ (match (resolve-expr m ep map)
                         (Err [d] (do (set! err d) (set! failed true)))
                         (Ok [e] (al-push! (mut out) e))))))
                (set! i (primitive/iadd (load i) 1)))))
    (if (load failed) (Err [(ptr (ArrayList Expr)) Diag] (load err)) (Ok (box-al [Expr] a (load out))))))

(defn take-owner-type-in-list [(items (ptr (ArrayList Expr))) (i i64) (n i64)] (-> (ptr Type))
  (if (>= i n)
      (primitive/cast (ptr Type) 0)
      (let [found (take-owner-type-in-expr (al-elem [Expr] items i))]
        (if (!= (primitive/cast i64 found) (primitive/cast i64 0))
            found
            (take-owner-type-in-list items (+ i 1) n)))))

(defn take-owner-type-in-expr [(ep (ptr Expr))] (-> (ptr Type))
  (match (.kind ep)
    (ECall [func type-args _]
      (if (and (or (= func "coil.core.take!")
                   (starts-with func "coil.core.take!__"))
               (> (al-len [Type] (load type-args)) (primitive/cast i64 0)))
          (al-elem [Type] type-args 0)
          (primitive/cast (ptr Type) 0)))
    (EDo [items]
      (take-owner-type-in-list items 0 (al-len [Expr] (load items))))
    (EStore [_ value] (take-owner-type-in-expr value))
    (EInitStore [_ value] (take-owner-type-in-expr value))
    (ESpillRef [value] (take-owner-type-in-expr value))
    (_ (primitive/cast (ptr Type) 0))))

(defn resolve-bind [(m (ptr MonoCtx)) (bp (ptr Bind)) (map (ptr Subst))] (-> (Result Bind Diag))
  (try (let [a (load (field m a))
             ne (try! (resolve-expr m (field bp value) map))
             nb (primitive/alloc-stack Bind)]
         (set! nb (mk-bind (.name bp) (.mutable bp) ne))
         (set! (.bid nb) (.bid bp))
         (let [(mut source-owner) (.owned_type bp)
               (mut recovered-take) false]
           ; Generic checking cannot always prove that the result of `take!` is
           ; affine before T is substituted. The intrinsic's explicit type
           ; argument is authoritative, so recover it for concrete ownership
           ; elaboration instead of losing the moved value's cleanup.
           (when (= (primitive/cast i64 (load source-owner)) (primitive/cast i64 0))
             (set! source-owner (take-owner-type-in-expr (field bp value)))
             (when (!= (primitive/cast i64 (load source-owner)) (primitive/cast i64 0))
               (set! recovered-take true)
               0)
             0)
           (unless (= (primitive/cast i64 (load source-owner)) (primitive/cast i64 0))
           (let [resolved (try! (resolve-ty m (load source-owner) map))
                 concrete (box-type a resolved)
                 rp (box-type a (ownership-semantic-type m concrete))]
             (when (or (load recovered-take)
                       (type-is-affine a (load (field m ownership_cx)) rp))
               (set! (.owned_type nb) rp)
               0))
           0))
         (Ok [Bind Diag] (load nb)))))

(defn resolve-bind-list [(m (ptr MonoCtx)) (binds (ptr (ArrayList Bind))) (map (ptr Subst))] (-> (Result (ptr (ArrayList Bind))
                                                                                                         Diag))
  (let [a (load (field m a))
        n (al-len [Bind] (load binds))
        (mut out) (al-new [Bind] a)
        (mut i) 0
        (mut err) (primitive/zeroed Diag)
        (mut failed) false]
    (loop (if (>= (load i) n)
              (break)
              (do
                (let [bp (al-elem [Bind] binds (load i))]
                  (match (resolve-bind m bp map)
                    (Err [d] (do (set! err d) (set! failed true) (break)))
                    (Ok [nb] (al-push! [Bind] (mut out) nb))))
                (set! i (primitive/iadd (load i) 1)))))
    (if (load failed) (Err [(ptr (ArrayList Bind)) Diag] (load err)) (Ok (box-al [Bind] a (load out))))))
(defn resolve-arm-list [(m (ptr MonoCtx)) (arms (ptr (ArrayList Arm))) (map (ptr Subst))] (-> (Result (ptr (ArrayList Arm))
                                                                                                      Diag))
  (let [a (load (field m a))
        n (al-len [Arm] (load arms))
        (mut out) (al-new [Arm] a)
        (mut i) 0
        (mut err) (primitive/zeroed Diag)
        (mut failed) false]
    (loop (if (>= (load i) n)
              (break)
              (do
                (let [ap (al-elem [Arm] arms (load i))]
                  (match (resolve-expr m (field ap body) map)
                    (Err [d] (do (set! err d) (set! failed true) (break)))
                    (Ok [nb]
                        (al-push! (mut out)
                                  (mk-arm (.variant ap)
                                          (load (field ap
                                                       binds))
                                          nb)))))
                (set! i (primitive/iadd (load i) 1)))))
    (if (load failed) (Err [(ptr (ArrayList Arm)) Diag] (load err)) (Ok (box-al [Arm] a (load out))))))
; The ECall arm: variant construction / generic-fn call / plain call.
(defn move-args-to-values! [(a (dyn Allocator))
                            (args (ptr (ArrayList Expr)))] (-> i64)
  (for [i 0 (al-len [Expr] (load args))]
    (let [arg (al-elem [Expr] args i)]
      (match (.kind arg)
        (EMovePlace [place] (set! (.kind arg) (ELoad place)))
        ; Type checking uses the ordinary aggregate-call ABI while variants are
        ; still represented as calls, so an aggregate rvalue is materialized as
        ; `ESpillRef value`. EConstruct stores field VALUES, not pointers to those
        ; temporary values; recover the expression that was spilled.
        (ESpillRef [value] (set! (.kind arg) (.kind value)))
        (_ 0)))
    0)
  0)

(defn move-args-to-places! [(args (ptr (ArrayList Expr)))] (-> i64)
  (for [i 0 (al-len [Expr] (load args))]
    (let [arg (al-elem [Expr] args i)]
      (match (.kind arg)
        (EMovePlace [place] (set! (.kind arg) (.kind place)))
        (_ 0)))
    0)
  0)

(defn adjust-generic-call-abi! [(m (ptr MonoCtx))
                                (gf (ptr Func))
                                (rtargs (ptr (ArrayList Type)))
                                (nargs (ptr (ArrayList Expr)))] (-> (Result i64 Diag))
  (try (let [a (load (field m a))
             smap (subst-map a (load (field gf type_params)) rtargs)
             params (load (field gf params))
             n (if (< (al-len [Param] (load params)) (al-len [Expr] (load nargs)))
                   (al-len [Param] (load params))
                   (al-len [Expr] (load nargs)))
             (mut i) 0]
         (loop (if (>= (load i) n)
                   (break)
                   (do
                     (let [pp (al-elem [Param] params (load i))
                           arg (al-elem [Expr] nargs (load i))
                           owner-type (.owned_type pp)]
                       (match (.kind arg)
                         (EMovePlace [place]
                           (if (match (load (field pp ty))
                                 (TPtr [_] true)
                                 (TRef [_ _] true)
                                 (_ false))
                               (set! (.kind arg) (.kind place))
                               (set! (.kind arg) (ELoad place)))
                           0)
                         (_ 0))
                       (when (and (!= (primitive/cast i64 owner-type) (primitive/cast i64 0))
                                  (match (load (field pp ty))
                                    (TPtr [_] true)
                                    (TRef [_ _] true)
                                    (_ false)))
                         (match (.kind arg)
                           (ELoad [place]
                             (do
                               (set! (.kind arg) (.kind place))
                               0))
                           ; Checked non-generic calls already spill aggregate
                           ; rvalues when the callee ABI takes an owning place.
                           ; Generic calls do not know that concrete ABI until
                           ; substitution here, so materialize an rvalue now.
                           (ESpillRef [_] 0)
                           ; The ownership pass has already rewritten moved
                           ; affine locals/parameters from `load place` to the
                           ; place itself. Do not spill that pointer a second
                           ; time when this call is later monomorphized.
                           (EVar [_] 0)
                           (EField [_ _] 0)
                           (EIndex [_ _] 0)
                           (_
                             (let [saved (box-expr a (load arg))]
                               (set! (.kind arg) (ESpillRef saved))
                               0)))
                         0))
                     (set! i (primitive/iadd (load i) 1)))))
         (Ok [i64 Diag] 0))))

; Concrete ownership elaboration runs while the monomorphization worklist is
; still being built. Register a semantic signature as soon as a generic call is
; specialized, so a caller processed before its callee can still distinguish an
; owning parameter from a borrow. The source Cx contains only the generic name;
; looking up the mangled call there would otherwise silently treat every argument
; as non-consuming.
(defn register-monomorphized-call-sig! [(m (ptr MonoCtx))
                                        (gf (ptr Func))
                                        (rtargs (ptr (ArrayList Type)))
                                        (mng (slice u8))] (-> (Result i64 Diag))
  (try (let [cx (load (field m ownership_cx))]
         (if (!= (primitive/cast i64 (sig-find cx mng)) (primitive/cast i64 0))
             (Ok [i64 Diag] 0)
             (let [a (load (field m a))
                   smap (subst-map a (load (field gf type_params)) rtargs)
                   ps (load (field gf params))
                   n (al-len [Param] (load ps))
                   (mut types) (al-new [Type] a)
                   (mut names) (al-new [(slice u8)] a)
                   (mut i) 0
                   sg (primitive/alloc-stack Sig)]
               (loop (if (>= (load i) n)
                         (break)
                         (let [pp (al-elem [Param] ps (load i))
                               semantic (if (= (primitive/cast i64 (.owned_type pp))
                                               (primitive/cast i64 0))
                                            (field pp ty)
                                            (.owned_type pp))]
                           (al-push! (mut types) (try! (resolve-ty m semantic smap)))
                           (al-push! (mut names) (.name pp))
                           (set! i (primitive/iadd (load i) 1)))))
               (set! (.name sg) mng)
               (set! (.type_params sg) (box-al [(slice u8)] a (al-new [(slice u8)] a)))
               (set! (.bounds sg) (box-al [Bound] a (al-new [Bound] a)))
               (set! (.param_names sg) (box-al [(slice u8)] a (load names)))
               (set! (.params sg) (box-al [Type] a (load types)))
               (set! (.ret sg) (try! (resolve-ty m (field gf ret) smap)))
               (set! (.is_extern sg) false)
               (set! (.variadic sg) false)
               (set! (.cc sg) (.cc gf))
               (set! (.fnptr_ok sg) false)
               (al-push! (mut (.sigs cx)) (load sg))
               (sig-index-put! cx mng)
               (Ok [i64 Diag] 0))))))

(defn resolve-call-kind [(m (ptr MonoCtx))
                         (func (slice u8))
                         (type_args (ptr (ArrayList Type)))
                         (args (ptr (ArrayList Expr)))
                         (map (ptr Subst))] (-> (Result ExprKind Diag))
  (let [a (load (field m a))]
    (try (let [nargs (try! (resolve-expr-list m args map))]
           (match (variant-sum m func)
             (Some [sum-name]
                   (move-args-to-values! a nargs)
                   (if (gsum-has m sum-name)
                       (do
                         (when (= (al-len [Type] (load type_args)) (primitive/cast i64 0))
                           (break :try
                                    (Err [ExprKind Diag]
                                         (derr (sconcat a
                                                        (sconcat a
                                                                 (sconcat3 a
                                                                           "variant '"
                                                                           func
                                                                           "' of generic sum '")
                                                                 (sconcat3 a
                                                                           sum-name
                                                                           "' needs type arguments: ("
                                                                           func))
                                                        " [<types>] ...)")))))
                         (let [rtargs (try! (resolve-ty-list m type_args map))]
                           (when (not (= (al-len [Type] (load rtargs)) (gsum-arity m sum-name)))
                             (break :try
                                      (Err [ExprKind Diag]
                                           (derr (arity-err a
                                                            (sconcat3 a "sum '" sum-name "'")
                                                            (gsum-arity m sum-name)
                                                            (al-len [Type] (load rtargs)))))))
                           (let [mng (mangle a sum-name rtargs)]
                             (queue-sum m sum-name rtargs)
                             (Ok (EConstruct
                                   :sum mng
                                   :variant func
                                   :args nargs)))))
                       (Ok (EConstruct
                             :sum sum-name
                             :variant func
                             :args nargs))))
             (None []
                   (if (gfunc-has m func)
                       (do
                         (when (= (al-len [Type] (load type_args)) (primitive/cast i64 0))
                           (break :try
                                    (Err [ExprKind Diag]
                                         (derr (sconcat a
                                                        (sconcat3 a
                                                                  "generic function '"
                                                                  func
                                                                  "' needs explicit type arguments: (")
                                                        (sconcat a func " [<types>] ...)"))))))
                         (let [rtargs (try! (resolve-ty-args m type_args map))]
                           (when (not (= (al-len [Type] (load rtargs)) (gfunc-arity m func)))
                             (break :try
                                      (Err [ExprKind Diag]
                                           (derr (arity-err a
                                                            (sconcat3 a "generic function '" func "'")
                                                            (gfunc-arity m func)
                                                            (al-len [Type] (load rtargs)))))))
                           (let [mng (mangle a func rtargs)]
                             (let [gf (al-elem [Func]
                                               (load (field m gfuncs))
                                               (find-func-named (load (field m gfuncs)) func))]
                               (try! (register-monomorphized-call-sig! m gf rtargs mng))
                               (try! (adjust-generic-call-abi! m gf rtargs nargs))
                               0)
                             (queue-func m func rtargs)
                             (Ok (ECall
                                   :func mng
                                   :type_args (box-items-type a)
                                   :args nargs)))))
                       (do
                         ; This may be the second resolve pass over a concrete
                         ; generic body. Such calls are already mangled, but the
                         ; ownership pass has only now marked consumed arguments
                         ; with EMovePlace. Use the recorded generic origin rather
                         ; than treating the call as an ordinary pointer-ABI call.
                         (let [ioi (io-find m func)]
                           (if (>= ioi 0)
                               (let [orig (al-elem [PendInst] (field m io-origin) ioi)
                                     gf (al-elem [Func]
                                                 (load (field m gfuncs))
                                                 (find-func-named (load (field m gfuncs)) (.name orig)))]
                                 (try! (adjust-generic-call-abi! m gf (.args orig) nargs))
                                 0)
                               (move-args-to-places! nargs)))
                         (Ok (ECall
                               :func func
                               :type_args (box-items-type a)
                               :args nargs))))))))))
(defn resolve-expr-kind [(m (ptr MonoCtx)) (e (ptr Expr)) (map (ptr Subst))] (-> (Result ExprKind Diag))
  (let [a (load (field m a))]
    (try (match (load (field e kind))
           (EInt [v] (Ok (EInt v)))
           (EStr [s] (Ok (EStr s)))
           (ECStr [s] (Ok (ECStr s)))
           (EVar [nm] (Ok (EVar nm)))
           (EFloat [b] (Ok (EFloat b)))
           (EBool [b] (Ok (EBool b)))
           (EZeroed [t] (let [tp (primitive/alloc-stack Type)] (store! tp t) (Ok (EZeroed (try! (resolve-ty m tp map))))))
           (EBorrow [mu place] (Ok (EBorrow mu (box-expr a (try! (resolve-expr m place map))))))
           (ESpillRef [inner] (Ok (ESpillRef (box-expr a (try! (resolve-expr m inner map))))))
           (EMovePlace [place] (Ok (EMovePlace (box-expr a (try! (resolve-expr m place map))))))
           (ELet [binds body] (Ok (ELet (try! (resolve-bind-list m binds map)) (try! (resolve-expr-list m body map)))))
           (EBin [op lhs rhs]
                 (Ok (EBin
                       :op op
                       :lhs (box-expr a (try! (resolve-expr m lhs map)))
                       :rhs (box-expr a (try! (resolve-expr m rhs map))))))
           (ENot [inner] (Ok (ENot (box-expr a (try! (resolve-expr m inner map))))))
           (ECmp [op lhs rhs]
                 (Ok (ECmp
                       :op op
                       :lhs (box-expr a (try! (resolve-expr m lhs map)))
                       :rhs (box-expr a (try! (resolve-expr m rhs map))))))
           (EIf [cnd thn els]
                (Ok (EIf
                      :cnd (box-expr a (try! (resolve-expr m cnd map)))
                      :thn (box-expr a (try! (resolve-expr m thn map)))
                      :els (box-expr a (try! (resolve-expr m els map))))))
           (EDo [body] (Ok (EDo (try! (resolve-expr-list m body map)))))
           (ECleanup [body cleanups]
                     (Ok (ECleanup
                           :body (box-expr a (try! (resolve-expr m body map)))
                           :cleanups (try! (resolve-expr-list m cleanups map)))))
           (ECall [func type_args args] (resolve-call-kind m func type_args args map))
           (ENamedCall [_func _type_args _names _args]
                       (Err [ExprKind Diag] (derr "internal: named constructor call survived type checking")))
           (EAlloc [storage t init]
                   (let [tp (primitive/alloc-stack Type)]
                     (store! tp t)
                     (Ok (EAlloc storage
                                 (try! (resolve-ty m tp map))
                                 (if (= (primitive/cast i64 init) 0)
                                     init
                                     (box-expr a (try! (resolve-expr m init map))))))))
           (EField [p fname] (Ok (EField (box-expr a (try! (resolve-expr m p map))) fname)))
           (ELoad [inner] (Ok (ELoad (box-expr a (try! (resolve-expr m inner map))))))
           (EStore [p val]
                   (Ok (EStore (box-expr a (try! (resolve-expr m p map))) (box-expr a (try! (resolve-expr m val map))))))
           (EInitStore [p val]
                   (Ok (EInitStore (box-expr a (try! (resolve-expr m p map))) (box-expr a (try! (resolve-expr m val map))))))
           (EIndex [p idx]
                   (Ok (EIndex (box-expr a (try! (resolve-expr m p map))) (box-expr a (try! (resolve-expr m idx map))))))
           (ECast [t inner]
                  (let [tp (primitive/alloc-stack Type)]
                    (store! tp t)
                    (Ok (ECast (try! (resolve-ty m tp map)) (box-expr a (try! (resolve-expr m inner map)))))))
           (ESizeOf [t] (let [tp (primitive/alloc-stack Type)] (store! tp t) (Ok (ESizeOf (try! (resolve-ty m tp map))))))
           (EAlignOf [t] (let [tp (primitive/alloc-stack Type)] (store! tp t) (Ok (EAlignOf (try! (resolve-ty m tp map))))))
           (EOffsetOf [t fname]
                      (let [tp (primitive/alloc-stack Type)] (store! tp t) (Ok (EOffsetOf (try! (resolve-ty m tp map)) fname))))
           (EBitGet [p fname] (Ok (EBitGet (box-expr a (try! (resolve-expr m p map))) fname)))
           (EBitSet [p fname val]
                    (Ok (EBitSet
                          :p (box-expr a (try! (resolve-expr m p map)))
                          :fname fname
                          :val (box-expr a (try! (resolve-expr m val map))))))
           (EFree [inner] (Ok (EFree (box-expr a (try! (resolve-expr m inner map))))))
           (EErase [trait_name inner] (Ok (EErase trait_name (box-expr a (try! (resolve-expr m inner map))))))
           (EMatch [scrut arms]
                   (Ok (EMatch (box-expr a (try! (resolve-expr m scrut map))) (try! (resolve-arm-list m arms map)))))
           (EFnPtrOf [nm]
                     (if (gfunc-has m nm)
                         (Err [ExprKind Diag]
                              (derr (sconcat3 a
                                              "fnptr-of '"
                                              nm
                                              "': cannot take a function pointer to a generic function")))
                         (Ok (EFnPtrOf nm))))
           (ECallPtr [fp args]
                     (Ok (ECallPtr (box-expr a (try! (resolve-expr m fp map))) (try! (resolve-expr-list m args map)))))
           (ELoop [label body] (Ok (ELoop label (try! (resolve-expr-list m body map)))))
           (EBreak [label value]
                   (Ok (EBreak label
                               (match value
                                 (Some [vp] (Some (box-expr a (try! (resolve-expr m vp map)))))
                                 (None [] (None [(ptr Expr)]))))))
           (EContinue [label] (Ok (EContinue label)))
           (ELlvmIr [result args body]
                    (let [tp (primitive/alloc-stack Type)]
                      (store! tp result)
                      (Ok (ELlvmIr
                            :result
                              (match (resolve-ty m tp map)
                                (Ok [value] value)
                                (Err [error] (break :try (Err error))))
                            :args
                              (match (resolve-expr-list m args map)
                                (Ok [value] value)
                                (Err [error] (break :try (Err error))))
                            :body body))))
           (EConstruct [sum variant args]
                       (Ok (EConstruct
                             :sum sum
                             :variant variant
                             :args
                               (match (resolve-expr-list m args map)
                                 (Ok [value] value)
                                 (Err [error] (break :try (Err error)))))))
           (EMakeDyn [dyn_struct vtable_struct methods inner]
                     (Ok (EMakeDyn
                           :dyn_struct dyn_struct
                           :vtable_struct vtable_struct
                           :methods methods
                           :inner (box-expr a (try! (resolve-expr m inner map))))))
           (EDynDispatch [dyn_struct vtable_struct method_index cc params ret recv args]
                         (let [rp (primitive/alloc-stack Type)]
                           (store! rp ret)
                           (Ok (EDynDispatch
                                 :dyn_struct dyn_struct
                                 :vtable_struct vtable_struct
                                 :method_index method_index
                                 :cc cc
                                 :params
                                   (match (resolve-ty-list m params map)
                                     (Ok [value] value)
                                     (Err [error] (break :try (Err error))))
                                 :ret
                                   (match (resolve-ty m rp map)
                                     (Ok [value] value)
                                     (Err [error] (break :try (Err error))))
                                 :recv (box-expr a (try! (resolve-expr m recv map)))
                                 :args
                                   (match (resolve-expr-list m args map)
                                     (Ok [value] value)
                                     (Err [error] (break :try (Err error))))))))
           (EStaticRef [nm] (Ok (EStaticRef nm)))
           ; trait call: substitute Self -> concrete, call the implementing fn
           ; directly. A receiver that resolved to a MANGLED instantiation
           ; (ArrayList__i64) dispatches by its BASE name, and its recorded args
           ; feed the impl pattern; a GENERIC impl's lowered method is a generic
           ; function, instantiated by matching that pattern.
           (ETraitCall [trait_name method self_tp args]
                       (let [tp (primitive/alloc-stack Type)]
                         (store! tp (TStruct self_tp))
                         (let [styp (primitive/alloc-stack Type)]
                           (store! styp
                                   (match (resolve-ty m tp map)
                                     (Ok [value] value)
                                     (Err [error] (break :try (Err error)))))
                           (let [(mut base) ""
                                 (mut mty) (load styp)]
                             (if (= (type-tag styp) (primitive/cast i64 6))
                                 (let [ioi (io-find m (type-struct-name styp))]
                                   (if (>= ioi (primitive/cast i64 0))
                                       (let [orig (al-elem [PendInst] (field m io-origin) ioi)]
                                         (store! base (load (field orig name)))
                                         (store! mty
                                                 (TApp (load (field orig name))
                                                       (load (field orig
                                                                    args))))
                                         0)
                                       (do (store! base (type-struct-name styp)) 0)))
                                 (match (mono-impl-name a styp)
                                   (None []
                                         (do
                                           (unimplemented "mono/trait-call: Self resolved to a type with no impl name")
                                           0))
                                   (Some [tn] (do (store! base tn) 0))))
                             (let [rtyp (primitive/alloc-stack Type)]
                               (store! rtyp (load mty))
                               ; the most specific impl accepting this receiver; fall back to the
                               ; plain key lookup when nothing matches, which is the pre-specialization
                               ; behaviour (and a general impl's key IS the plain key)
                               (let [ipsel (impl-lookup-sel a m trait_name rtyp)
                                     ip
                                       (if (= (primitive/cast i64 ipsel) (primitive/cast i64 0))
                                           (impl-lookup m trait_name (load base))
                                           ipsel)
                                     mkey
                                       (if (= (primitive/cast i64 ipsel) (primitive/cast i64 0))
                                           (load base)
                                           (impl-mangle-key a
                                                            (field ipsel self_type)
                                                            (load (field ipsel
                                                                         type_params))))
                                     (mut targs) (box-items-type a)]
                                 (when (if (!= (primitive/cast i64 ip) (primitive/cast i64 0))
                                           (> (al-len [(slice u8)]
                                                      (load (load (field ip
                                                                         type_params))))
                                              (primitive/cast i64 0))
                                           false)
                                   ; Bind the impl's type params from the receiver with the SAME
                                   ; matcher that selected the impl (`unify-trait-extras`). Mono used
                                   ; to run its own `match-impl-pattern` here — a second matcher, free
                                   ; to disagree with the selecting one and then reject a receiver the
                                   ; selector had just accepted. (It also compared types by mono's
                                   ; `type-key`, which renders a TRef without its mutability flag and
                                   ; so equates `(mut T)` with `(ref T)`; unify-trait-extras checks it.)
                                   (let [binds (subst-new a)
                                         mtyp (primitive/alloc-stack Type)]
                                     (store! mtyp (load mty))
                                     (when (not (unify-trait-extras a
                                                                    (field ip self_type)
                                                                    mtyp
                                                                    (load (field ip type_params))
                                                                    binds))
                                       (break :try
                                                (Err [ExprKind Diag]
                                                     (derr (sconcat3 a
                                                                     "trait call '"
                                                                     method
                                                                     "': receiver doesn't match the impl's implementing type")))))
                                     (let [ps (load (field ip type_params))
                                           np (al-len [(slice u8)] (load ps))
                                           (mut k) 0
                                           (mut ta) (al-new [Type] a)]
                                       (loop (if (>= (load k) np)
                                                 (break)
                                                 (let [pn (al-get [(slice u8)] (load ps) (load k))
                                                       bp (subst-get binds pn)]
                                                   (when (= (primitive/cast i64 bp) (primitive/cast i64 0))
                                                     (break :try
                                                              (Err [ExprKind Diag]
                                                                   (derr (sconcat a
                                                                                  (sconcat3 a
                                                                                            "trait call '"
                                                                                            method
                                                                                            "': impl type parameter '")
                                                                                  (sconcat a
                                                                                           pn
                                                                                           "' not determined by the receiver"))))))
                                                   (al-push! (mut ta) (load bp))
                                                   (store! k (primitive/iadd (load k) 1)))))
                                       (store! targs (box-al [Type] a (load ta)))
                                       0)))
                                 (let [basefn (trait-method-fn a trait_name mkey method)
                                       rargs (try! (resolve-expr-list m args map))]
                                   (if (> (al-len [Type] (load (load targs))) (primitive/cast i64 0))
                                       (let [mng (mangle a basefn (load targs))]
                                         (queue-func m basefn (load targs))
                                         (io-mark-trait! m mng trait_name mkey)
                                         (trait-use-record! m trait_name mkey method mng)
                                         (Ok (ECall
                                               :func mng
                                               :type_args (box-items-type a)
                                               :args rargs)))
                                       (do
                                         (trait-use-record! m trait_name mkey method basefn)
                                         (Ok (ECall
                                               :func basefn
                                               :type_args (box-items-type a)
                                               :args rargs)))))))))))
           ; comptime-only / unresolved nodes: a compiler bug if they reach mono.
           (EComptime [inner] (Err [ExprKind Diag] (derr "mono: unresolved comptime node (compiler bug)")))
           (EAscribe [t inner]
                     (Err [ExprKind Diag]
                          (derr "mono: unlowered ascription node — the checker should have replaced (: v t) with its coerced value (compiler bug)")))
           (EArrayLit [_]
                      (Err [ExprKind Diag]
                           (derr "mono: array literal survived type checking (compiler bug)")))
           (EMakeSlice [data elem len]
                       (let [tp (primitive/alloc-stack Type)]
                         (store! tp elem)
                         (Ok (EMakeSlice :data
                                         (box-expr a (try! (resolve-expr m data map)))
                                         :elem
                                         (match (resolve-ty m tp map)
                                                (Ok [value] value)
                                                (Err [error] (break :try (Err error))))
                                         :len
                                         len))))
           (ETypeQuery [q t] (Err [ExprKind Diag] (derr "mono: unresolved type-query (compiler bug)")))
           (EFieldMeta [meta t idx] (Err [ExprKind Diag] (derr "mono: unresolved field-reflection (compiler bug)")))
           (EFieldIndex [t nm] (Err [ExprKind Diag] (derr "mono: unresolved field-reflection (compiler bug)")))
           (EQuote [form] (Err [ExprKind Diag] (derr "mono: comptime-only code value reached mono (compiler bug)")))
           (ECodeOp [op args]
                    (Err [ExprKind Diag]
                         (derr-at-src (load (field e source))
                                      (load (field e lo))
                                      (load (field e hi))
                                      (sconcat (load (field m a))
                                               "mono: comptime-only code operation "
                                               (sconcat (load (field m a))
                                                        (dec->str (load (field m a)) op)
                                                        " reached mono (compiler bug)")))))
           (EQuasi [q] (Err [ExprKind Diag] (derr "mono: comptime-only code value reached mono (compiler bug)")))))))
(defn resolve-expr [(m (ptr MonoCtx)) (e (ptr Expr)) (map (ptr Subst))] (-> (Result Expr Diag))
  (match (resolve-expr-kind m e map)
    (Err [d] (Err [Expr Diag] d))
    (Ok [k]
        (let [(mut out) (mk-expr k
                                 (.lo e)
                                 (.hi e)
                                 (.source e)
                                 (.ctxt e))]
          ; Binding/type side maps are keyed by source node identity. Mono must
          ; not erase that identity before generic ABI and ownership lowering.
          (set! (.nid out) (.nid e))
          (Ok (load out))))))

; ---- drain the worklist --------------------------------
; An append-only cursor sweep (same fixpoint, output order is
; unobserved by the oracle — every corpus file errors during seeding).
(defn drain [(m (ptr MonoCtx))] (-> (Result i64 Diag))
  (let [a (load (field m a))
        (mut sc) 0
        (mut uc) 0
        (mut fc) 0
        (mut err) (primitive/zeroed Diag)
        (mut failed) false
        (mut done) false]
    (loop (if (load done)
              (break)
              (do
                (cond (< (load sc)
                         (al-len [PendInst]
                                 (load (field m
                                              pending-structs))))
                        (do
                          (let [pi (al-elem [PendInst] (field m pending-structs) (load sc))
                                nm (load (field pi name))
                                args (load (field pi args))
                                gs
                                  (al-elem [StructDef]
                                           (load (field m gstructs))
                                           (find-struct-named (load (field m gstructs)) nm))
                                smap (subst-map a (load (field gs type_params)) args)
                                mng (mangle a nm args)]
                            (if (mono-runaway? args mng)
                                (do
                                  (store! err (mono-runaway-diag a "generic type" nm mng))
                                  (store! failed true)
                                  (store! done true)
                                  0)
                                (match (resolve-fields m (load (field gs fields)) smap)
                                  (Err [d]
                                       (let [dp (primitive/alloc-stack Diag)]
                                         (set! dp d)
                                         (set! (.msg dp)
                                               (sconcat a
                                                        (sconcat3 a "in function '" mng "': ")
                                                        (.msg dp)))
                                         (store! err (load dp))
                                         (store! failed true)
                                         (store! done
                                                 true)
                                         0))
                                  (Ok [nfs]
                                      (let [nd (primitive/alloc-stack StructDef)]
                                        (store! (field nd name) mng)
                                        (store! (field nd type_params) (box-al [(slice u8)] a (al-new [(slice u8)] a)))
                                        (store! (field nd bounds) (box-al [Bound] a (al-new [Bound] a)))
                                        (store! (field nd layout) (load (field gs layout)))
                                        (store! (field nd fields) nfs)
                                        (upsert-struct m (load nd)))))))
                          (store! sc (primitive/iadd (load sc) 1)))
                      (< (load uc) (al-len [PendInst] (load (field m pending-sums))))
                        (do
                          (let [pi (al-elem [PendInst] (field m pending-sums) (load uc))
                                nm (load (field pi name))
                                args (load (field pi args))
                                gs
                                  (al-elem [SumDef]
                                           (load (field m gsums))
                                           (find-sum-named (load (field m
                                                                        gsums))
                                                           nm))
                                smap (subst-map a (load (field gs type_params)) args)
                                mng (mangle a nm args)]
                            (if (mono-runaway? args mng)
                                (do
                                  (store! err (mono-runaway-diag a "generic sum" nm mng))
                                  (store! failed true)
                                  (store! done true)
                                  0)
                                (match (resolve-sum m gs smap mng)
                                  (Err [d]
                                       (do
                                         (store! err d)
                                         (store! failed true)
                                         (store! done
                                                 true)
                                         0))
                                  (Ok [ns] (upsert-sum m ns)))))
                          (store! uc (primitive/iadd (load uc) 1)))
                      (< (load fc) (al-len [PendInst] (load (field m pending-funcs))))
                        (do
                          (let [pi (al-elem [PendInst] (field m pending-funcs) (load fc))
                                nm (load (field pi name))
                                args (load (field pi args))
                                gf
                                  (al-elem [Func]
                                           (load (field m gfuncs))
                                           (find-func-named (load (field m gfuncs)) nm))
                                smap (mono-subst-copy a (subst-map a (load (field gf type_params)) args))
                                _assoc (extend-associated-subst! m gf smap)
                                mng (mangle a nm args)]
                            (if (mono-runaway? args mng)
                                (do
                                  (store! err (mono-runaway-diag a "generic function" nm mng))
                                  (store! failed true)
                                  (store! done true)
                                  0)
                                (match (resolve-func m gf smap mng)
                                  (Err [d]
                                       (do
                                         (store! err d)
                                         (store! failed true)
                                         (store! done
                                                 true)
                                         0))
                                  (Ok [nf]
                                      (let [nfp (primitive/alloc-stack Func)]
                                        (set! nfp nf)
                                        (set! (.cur_bounds (load (field m ownership_cx)))
                                              (al-new [Bound] a))
                                        (match (ownership-check-func a
                                                                     (load (field m ownership_cx))
                                                                     nfp)
                                          (Err [d]
                                            (do
                                              (store! err d)
                                              (store! failed true)
                                              (store! done true)
                                              0))
                                          (Ok [_]
                                            ; Concrete ownership elaboration may
                                            ; synthesize generic Drop calls for
                                            ; fields such as Weak<Payload>. Those
                                            ; calls did not exist during the first
                                            ; resolve-expr walk, so specialize and
                                            ; queue them before publishing `nf`.
                                            (match (resolve-expr-list m
                                                                      (load (field nfp body))
                                                                      smap)
                                              (Err [d]
                                                (do
                                                  (store! err d)
                                                  (store! failed true)
                                                  (store! done true)
                                                  0))
                                              (Ok [owned-body]
                                                (do
                                                  (set! (.body nfp) owned-body)
                                                  (upsert-func m (load nfp))))))))))))
                          (store! fc (primitive/iadd (load fc) 1)))
                      :else (do (store! done true) 0)))))
    (if (load failed) (Err [i64 Diag] (load err)) (Ok [i64 Diag] 0))))

; ---- orchestration ------------------------------
(defn mono-phase-only-type? [(t (ptr Type))] (-> bool)
  (match (load t)
    (TCode [] true)
    (TCodeBuilder [] true)
    (TPtr [inner] (mono-phase-only-type? inner))
    (TRef [_ inner] (mono-phase-only-type? inner))
    (TArray [inner _] (mono-phase-only-type? inner))
    (TSlice [inner] (mono-phase-only-type? inner))
    (TVec [inner _] (mono-phase-only-type? inner))
    (TFn [_ params ret]
      (or (mono-phase-only-types? params 0 (al-len [Type] (load params)))
          (mono-phase-only-type? ret)))
    (TApp [_ args] (mono-phase-only-types? args 0 (al-len [Type] (load args))))
    (_ false)))

(defn mono-phase-only-types? [(types (ptr (ArrayList Type))) (i i64) (n i64)] (-> bool)
  (if (>= i n)
      false
      (or (mono-phase-only-type? (al-elem [Type] types i))
          (mono-phase-only-types? types (primitive/iadd i 1) n))))

(defn mono-phase-only-fields? [(fields (ptr (ArrayList Field)))] (-> bool)
  (let [n (al-len [Field] (load fields))
        (mut i) 0
        (mut found) false]
    (loop (if (or (load found) (>= (load i) n))
              (break)
              (do
                (when (mono-phase-only-type? (field (al-elem [Field] fields (load i)) ty))
                  (store! found true) 0)
                (store! i (primitive/iadd (load i) 1)))))
    (load found)))

(defn mono-phase-only-variants? [(variants (ptr (ArrayList Variant)))] (-> bool)
  (let [n (al-len [Variant] (load variants))
        (mut i) 0
        (mut found) false]
    (loop (if (or (load found) (>= (load i) n))
              (break)
              (do
                (when (mono-phase-only-fields? (load (field (al-elem [Variant] variants (load i)) fields)))
                  (store! found true) 0)
                (store! i (primitive/iadd (load i) 1)))))
    (load found)))

(defn collect-generic-structs [(a (dyn Allocator)) (p (ptr Program))] (-> (ptr (ArrayList StructDef)))
  (let [fs (load (field p structs))
        n (al-len [StructDef] (load fs))
        (mut out) (al-new [StructDef] a)
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (let [sp (al-elem [StructDef] fs (load i))]
                  (when (> (al-len [(slice u8)] (load (field sp type_params))) (primitive/cast i64 0))
                    (al-push! (mut out) (load sp))))
                (set! i (primitive/iadd (load i) 1)))))
    (box-al [StructDef] a (load out))))
(defn collect-generic-sums [(a (dyn Allocator)) (p (ptr Program))] (-> (ptr (ArrayList SumDef)))
  (let [ss (load (field p sums))
        n (al-len [SumDef] (load ss))
        (mut out) (al-new [SumDef] a)
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (let [sp (al-elem [SumDef] ss (load i))]
                  (when (> (al-len [(slice u8)] (load (field sp type_params))) (primitive/cast i64 0))
                    (al-push! (mut out) (load sp))))
                (set! i (primitive/iadd (load i) 1)))))
    (box-al [SumDef] a (load out))))
(defn collect-generic-funcs [(a (dyn Allocator)) (p (ptr Program))] (-> (ptr (ArrayList Func)))
  (let [fs (load (field p funcs))
        n (al-len [Func] (load fs))
        (mut out) (al-new [Func] a)
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (let [fp (al-elem [Func] fs (load i))]
                  (when (> (al-len [(slice u8)] (load (field fp type_params))) (primitive/cast i64 0))
                    (al-push! (mut out) (load fp))))
                (set! i (primitive/iadd (load i) 1)))))
    (box-al [Func] a (load out))))
; build variant_to_sum (primitive/error if a variant name is in two sums).
(defn build-vsum [(m (ptr MonoCtx)) (p (ptr Program))] (-> (Result i64 Diag))
  (let [a (load (field m a))
        ss (load (field p sums))
        n (al-len [SumDef] (load ss))
        (mut i) 0
        (mut err) (primitive/zeroed Diag)
        (mut failed) false]
    (loop (if (or (load failed) (>= (load i) n))
              (break)
              (do
                (let [sp (al-elem [SumDef] ss (load i))
                      vs (load (field sp variants))
                      nv (al-len [Variant] vs)
                      (mut j) 0]
                  (loop (if (or (load failed) (>= (load j) nv))
                            (break)
                            (do
                              (let [vp (al-elem [Variant] vs (load j))
                                    vn (.name vp)]
                                (if (set-contains (field m vsum-names) vn)
                                    (do
                                      (set! err (derr (sconcat3 a "variant '" vn "' is declared in two sum types")))
                                      (set! failed true)
                                      0)
                                    (do
                                      (al-push! (mut (.vsum-names m)) vn)
                                      (al-push! (mut (.vsum-sums m)) (.name sp)))))
                              (set! j (primitive/iadd (load j) 1))))))
                (set! i (primitive/iadd (load i) 1)))))
    (if (load failed) (Err [i64 Diag] (load err)) (Ok [i64 Diag] 0))))
(defn seed-concrete-structs [(m (ptr MonoCtx)) (p (ptr Program)) (map (ptr Subst))] (-> (Result i64 Diag))
  (let [a (load (field m a))
        ss (load (field p structs))
        n (al-len [StructDef] (load ss))
        (mut i) 0
        (mut err) (primitive/zeroed Diag)
        (mut failed) false]
    (loop (if (>= (load i) n)
              (break)
              (do
                (let [sp (al-elem [StructDef] ss (load i))]
                  ; Code-bearing concrete aggregates belong exclusively to the
                  ; metaprogram/checker closure. Metalower compiles a private copy
                  ; with Code erased to an opaque host handle; the ordinary target
                  ; must not seed the source declaration into runtime layout.
                  (when (and (= (al-len [(slice u8)] (load (field sp type_params))) (primitive/cast i64 0))
                             (not (mono-phase-only-fields? (load (field sp fields)))))
                    (match (resolve-fields m (load (field sp fields)) map)
                      (Err [d] (do (store! err d) (store! failed true) (break)))
                      (Ok [nfs]
                          (let [nd (primitive/alloc-stack StructDef)]
                            (store! (field nd name) (load (field sp name)))
                            (store! (field nd type_params) (box-al [(slice u8)] a (al-new [(slice u8)] a)))
                            (store! (field nd bounds) (box-al [Bound] a (al-new [Bound] a)))
                            (store! (field nd layout) (load (field sp layout)))
                            (store! (field nd fields) nfs)
                            (upsert-struct m (load nd))
                            0)))))
                (set! i (primitive/iadd (load i) 1)))))
    (if (load failed) (Err [i64 Diag] (load err)) (Ok [i64 Diag] 0))))
(defn seed-concrete-sums [(m (ptr MonoCtx)) (p (ptr Program)) (map (ptr Subst))] (-> (Result i64 Diag))
  (let [a (load (field m a))
        ss (load (field p sums))
        n (al-len [SumDef] (load ss))
        (mut i) 0
        (mut err) (primitive/zeroed Diag)
        (mut failed) false]
    (loop (if (>= (load i) n)
              (break)
              (do
                (let [sp (al-elem [SumDef] ss (load i))]
                  (when (and (= (al-len [(slice u8)] (load (field sp type_params))) (primitive/cast i64 0))
                             (not (mono-phase-only-variants? (load (field sp variants)))))
                    (match (resolve-sum m sp map (load (field sp name)))
                      (Err [d] (do (store! err d) (store! failed true) (break)))
                      (Ok [ns] (upsert-sum m ns)))))
                (set! i (primitive/iadd (load i) 1)))))
    (if (load failed) (Err [i64 Diag] (load err)) (Ok [i64 Diag] 0))))
(defn seed-concrete-funcs [(m (ptr MonoCtx)) (p (ptr Program)) (map (ptr Subst))] (-> (Result i64 Diag))
  (let [a (load (field m a))
        fs (load (field p funcs))
        n (al-len [Func] (load fs))
        (mut i) 0
        (mut err) (primitive/zeroed Diag)
        (mut failed) false]
    (loop (if (>= (load i) n)
              (break)
              (do
                (let [fp (al-elem [Func] fs (load i))]
                  (when (= (al-len [(slice u8)] (load (field fp type_params))) (primitive/cast i64 0))
                    (match (resolve-func m fp map (load (field fp name)))
                      (Err [d]
                           (let [dp (primitive/alloc-stack Diag)]
                             (set! dp d)
                             (set! (.msg dp)
                                   (sconcat (load (field m a))
                                            (sconcat3 (load (field m a)) "in function '" (load (field fp name)) "': ")
                                            (.msg dp)))
                             (store! err (load dp))
                             (store! failed true)
                             (break)))
                      (Ok [nf] (upsert-func m nf)))))
                (set! i (primitive/iadd (load i) 1)))))
    (if (load failed) (Err [i64 Diag] (load err)) (Ok [i64 Diag] 0))))
(defn mono-asserts [(m (ptr MonoCtx)) (p (ptr Program)) (map (ptr Subst))] (-> (Result (ptr (ArrayList StaticAssert))
                                                                                       Diag))
  (let [a (load (field m a))
        as (load (field p asserts))
        n (al-len [StaticAssert] (load as))
        (mut out) (al-new [StaticAssert] a)
        (mut i) 0
        (mut err) (primitive/zeroed Diag)
        (mut failed) false]
    (loop (if (>= (load i) n)
              (break)
              (do
                (let [ap (al-elem [StaticAssert] as (load i))]
                  (match (resolve-expr m (field ap cnd) map)
                    (Err [d] (do (set! err d) (set! failed true) (break)))
                    (Ok [ce]
                        (let [na (primitive/alloc-stack StaticAssert)]
                          (set! (.cnd na) ce)
                          (set! (.msg na) (.msg ap))
                          (al-push! (mut out) (load na))
                          0))))
                (set! i (primitive/iadd (load i) 1)))))
    (if (load failed) (Err [(ptr (ArrayList StaticAssert)) Diag] (load err)) (Ok (box-al [StaticAssert] a (load out))))))
(defn build-mono-program [(a (dyn Allocator))
                          (m (ptr MonoCtx))
                          (p (ptr Program))
                          (asserts (ptr (ArrayList StaticAssert)))] (-> (Result (ptr Program) Diag))
  (let [out (box! a Program (primitive/zeroed Program))]
    (set! (.annotation_defs out) (load (field p annotation_defs)))
    (set! (.conventions out) (load (field p conventions)))
    (set! (.structs out) (box-al [StructDef] a (.out-structs m)))
    (set! (.sums out) (box-al [SumDef] a (.out-sums m)))
    (set! (.externs out) (load (field p externs)))
    (set! (.funcs out) (box-al [Func] a (.out-funcs m)))
    (set! (.asserts out) asserts)
    (set! (.consts out) (load (field p consts)))
    ; Traits and impls are semantic metadata as well as monomorphization input.
    ; Native code generation ignores these tables, but an incremental compiler
    ; session must retain them to check a later definition against the accepted
    ; trait environment without reconstructing compiler-generated method names.
    (set! (.traits out) (load (field p traits)))
    (set! (.impls out) (load (field p impls)))
    (set! (.metas out) (box-al [Expr] a (al-new [Expr] a)))
    (set! (.exports out) (load (field p exports)))
    (set! (.function_abis out) (load (field p function_abis)))
    (set! (.mono_origins out) (box-al [MonoOrigin] a (.origins m)))
    (set! (.mono_trait_uses out) (box-al [MonoTraitUse] a (.trait_uses m)))
    (Ok out)))
; keeps out_structs/out_sums/out_funcs in HashMaps keyed by name, so a
; second insert with the same name OVERWRITES (last-writer-wins) — duplicate-named
; concrete definitions (e.g. a fn re-seen via two import paths) collapse to one.
; Our out lists are ArrayLists, so mirror that with insert-or-replace by name.
; O(1) insert-or-replace by name via the out-*-idx side-index (gen-10). Same
; last-writer-wins semantics as the old scan: a name already in the list is
; replaced IN PLACE at its recorded index; a new name is appended and its index
; recorded. The list never holds a duplicate name, so the index stays exact.
(defn upsert-struct [(m (ptr MonoCtx)) (s StructDef)] (-> i64)
  (let [nm (sdef-name s)]
    (match (hm-get [(slice u8) i64] (.out-struct-idx m) nm)
      (Some [i] (do (al-set! [StructDef] (mut (.out-structs m)) i s) 0))
      (None []
            (let [idx (al-len [StructDef] (.out-structs m))]
              (al-push! (mut (.out-structs m)) s)
              (hm-put! [(slice u8) i64] (mut (.out-struct-idx m)) nm idx)
              0)))))
(defn upsert-sum [(m (ptr MonoCtx)) (s SumDef)] (-> i64)
  (let [nm (sumdef-name s)]
    (match (hm-get [(slice u8) i64] (.out-sum-idx m) nm)
      (Some [i] (do (al-set! [SumDef] (mut (.out-sums m)) i s) 0))
      (None []
            (let [idx (al-len [SumDef] (.out-sums m))]
              (al-push! (mut (.out-sums m)) s)
              (hm-put! [(slice u8) i64] (mut (.out-sum-idx m)) nm idx)
              0)))))
(defn upsert-func [(m (ptr MonoCtx)) (f Func)] (-> i64)
  (let [nm (func-name f)]
    (match (hm-get [(slice u8) i64] (.out-func-idx m) nm)
      (Some [i] (do (al-set! [Func] (mut (.out-funcs m)) i f) 0))
      (None []
            (let [idx (al-len [Func] (.out-funcs m))]
              (al-push! (mut (.out-funcs m)) f)
              (hm-put! [(slice u8) i64] (mut (.out-func-idx m)) nm idx)
              0)))))

(defn mono-ownership-context [(a (dyn Allocator)) (p (ptr Program))] (-> (Result (ptr Cx) Diag))
  (let [cx (box! a Cx (primitive/zeroed Cx))
        imports (box-al [ImpEntry] a (al-new [ImpEntry] a))
        exports (box-al [ExpEntry] a (al-new [ExpEntry] a))]
    (set! (.trait_uses cx) (al-new [MonoTraitUse] a))
    (match (setup a cx p imports exports)
      (Err [d] (Err [(ptr Cx) Diag] d))
      (Ok [_] (Ok [(ptr Cx) Diag] cx)))))

(defn monomorphize [(a (dyn Allocator)) (p (ptr Program))] (-> (Result (ptr Program) Diag))
  (try (let [m (box! a MonoCtx (primitive/zeroed MonoCtx))]
    (set! (.a m) a)
    (set! (.gfuncs m) (collect-generic-funcs a p))
    (set! (.gstructs m) (collect-generic-structs a p))
    (set! (.gsums m) (collect-generic-sums a p))
    (set! (.vsum-names m) (al-new [(slice u8)] a))
    (set! (.vsum-sums m) (al-new [(slice u8)] a))
    (set! (.out-structs m) (al-new [StructDef] a))
    (set! (.out-sums m) (al-new [SumDef] a))
    (set! (.out-funcs m) (al-new [Func] a))
    (set! (.pending-structs m) (al-new [PendInst] a))
    (set! (.pending-sums m) (al-new [PendInst] a))
    (set! (.pending-funcs m) (al-new [PendInst] a))
    (set! (.out-struct-idx m) (hm-new [(slice u8) i64] a (str-keyops)))
    (set! (.out-sum-idx m) (hm-new [(slice u8) i64] a (str-keyops)))
    (set! (.out-func-idx m) (hm-new [(slice u8) i64] a (str-keyops)))
    (set! (.queued-structs m) (hm-new [(slice u8) i64] a (str-keyops)))
    (set! (.queued-sums m) (hm-new [(slice u8) i64] a (str-keyops)))
    (set! (.queued-funcs m) (hm-new [(slice u8) i64] a (str-keyops)))
    (set! (.ownership_cx m) (try! (mono-ownership-context a p)))
    (set! (.impls m) (load (field p impls)))
    (set! (.trait_impl_idx m) (hm-new [(slice u8) (ptr ImplBucket)] a (str-keyops)))
    (let [is (load (field m impls))
          ni (al-len [ImplDef] (load is))
          (mut ii) 0]
      (loop (if (>= (load ii) ni)
                (break)
                (do
                  (let [ip (al-elem [ImplDef] is (load ii))]
                    (when (impl-is-trait ip)
                      (impl-index-add! a
                                       (mut (field m trait_impl_idx))
                                       (impl-index-key a (impl-trait-name ip) (load (field ip for_type)))
                                       (load ii))))
                  (set! ii (primitive/iadd (load ii) 1))))))
    (set! (.io-index m) (hm-new [(slice u8) i64] a (str-keyops)))
    (set! (.io-origin m) (al-new [PendInst] a))
    (set! (.origins m) (al-new [MonoOrigin] a))
    (set! (.trait_uses m) (al-new [MonoTraitUse] a))
    (let [checked-uses (load (field p mono_trait_uses))]
      (if (!= (primitive/cast i64 checked-uses) 0)
          (for [i 0 (al-len [MonoTraitUse] (load checked-uses))]
            (al-push! (mut (field m trait_uses))
              (al-get [MonoTraitUse] (load checked-uses) i)))
          0))
    (set! (.current_source m) "")
    (let [empty (subst-empty a)]
      (match (build-vsum m p)
        (Err [d] (Err [(ptr Program) Diag] d))
        (Ok [_]
            (match (seed-concrete-structs m p empty)
              (Err [d] (Err [(ptr Program) Diag] d))
              (Ok [_]
                  (match (seed-concrete-sums m p empty)
                    (Err [d] (Err [(ptr Program) Diag] d))
                    (Ok [_]
                        (match (seed-concrete-funcs m p empty)
                          (Err [d] (Err [(ptr Program) Diag] d))
                          (Ok [_]
                              (match (mono-asserts m p empty)
                                (Err [d] (Err [(ptr Program) Diag] d))
                                (Ok [asserts]
                                    (match (drain m)
                                      (Err [d] (Err [(ptr Program) Diag] d))
                                      (Ok [_] (build-mono-program a m p asserts)))))))))))))))))

; ---- post-check Code definition drop ----
; Comptime-only functions (a `Code`/`CodeBuilder` parameter or return — macros,
; generators, code helpers, and their trait impl methods) have no runtime
; representation and are dropped after check, before mono. A trait mutator takes
; `(mut Code)` or `(mut CodeBuilder)`; the checked impl keeps that as TRef while its
; synthesized dispatch wrapper uses TPtr. Code can also be nested in a result such
; as `(Option Code)` (Iterator.next is the canonical case). Walk every compound type:
; a runtime signature cannot contain a comptime-only value at any depth.
(defn type-list-has-comptime-code [(ts (ptr (ArrayList Type)))] (-> bool)
  (let [n (al-len [Type] (load ts))
        (mut i) 0
        (mut found) false]
    (loop (if (or (load found) (>= (load i) n))
              (break)
              (do
                (when (type-is-comptime-code (al-elem [Type] ts (load i)))
                  (store! found true) 0)
                (set! i (primitive/iadd (load i) 1)))))
    (load found)))
(defn type-is-comptime-code [(tp (ptr Type))] (-> bool)
  (match (load tp)
    (TCode [] true)
    (TCodeBuilder [] true)
    (TRef [_ inner] (type-is-comptime-code inner))
    (TPtr [inner] (type-is-comptime-code inner))
    (TSlice [inner] (type-is-comptime-code inner))
    (TArray [inner _] (type-is-comptime-code inner))
    (TVec [inner _] (type-is-comptime-code inner))
    (TApp [_ args] (type-list-has-comptime-code args))
    (TFn [_ params ret]
         (or (type-list-has-comptime-code params)
             (type-is-comptime-code ret)))
    (_ false)))
(defn func-has-code [(fp (ptr Func))] (-> bool)
  (let [rt (primitive/alloc-stack Type)]
    (set! rt (.ret fp))
    (if (type-is-comptime-code rt)
        true
        (let [ps (load (field fp params))
              n (al-len [Param] ps)
              (mut i) 0
              (mut found) false]
          (loop (if (or (load found) (>= (load i) n))
                    (break)
                    (do
                      (let [pp (al-elem [Param] ps (load i))
                            pt (primitive/alloc-stack Type)]
                        (set! pt (.ty pp))
                        (when (type-is-comptime-code pt) (store! found true) 0))
                      (set! i (primitive/iadd (load i) 1)))))
          (load found)))))

; A Code-signed entry may delegate ordinary computation to helpers whose own
; signatures contain no Code. Those helpers are still comptime-only when their
; checked bodies contain Code operations, quotes, or explicit comptime nodes.
; Find those bodies before mono, then close the set backwards over callers so a
; runtime-shaped wrapper cannot retain a call to a function removed at the phase
; boundary.
(defn expr-list-has-code-node? [(es (ptr (ArrayList Expr)))] (-> bool)
  (let [n (al-len [Expr] (load es))
        (mut i) 0
        (mut found) false]
    (loop (if (or (load found) (>= (load i) n))
              (break)
              (do
                (when (expr-has-code-node? (al-elem [Expr] es (load i)))
                  (store! found true) 0)
                (set! i (primitive/iadd (load i) 1)))))
    (load found)))
(defn expr-opt-has-code-node? [(o (Option (ptr Expr)))] (-> bool)
  (match o (Some [e] (expr-has-code-node? e)) (None [] false)))
(defn binds-have-code-node? [(bs (ptr (ArrayList Bind)))] (-> bool)
  (let [n (al-len [Bind] (load bs))
        (mut i) 0
        (mut found) false]
    (loop (if (or (load found) (>= (load i) n))
              (break)
              (do
                (when (expr-has-code-node? (field (al-elem [Bind] bs (load i)) value))
                  (store! found true) 0)
                (set! i (primitive/iadd (load i) 1)))))
    (load found)))
(defn arms-have-code-node? [(arms (ptr (ArrayList Arm)))] (-> bool)
  (let [n (al-len [Arm] (load arms))
        (mut i) 0
        (mut found) false]
    (loop (if (or (load found) (>= (load i) n))
              (break)
              (do
                (when (expr-has-code-node? (field (al-elem [Arm] arms (load i)) body))
                  (store! found true) 0)
                (set! i (primitive/iadd (load i) 1)))))
    (load found)))
(defn quasi-list-has-code-node? [(items (ptr (ArrayList Quasi)))] (-> bool)
  (let [n (al-len [Quasi] (load items))
        (mut i) 0
        (mut found) false]
    (loop (if (or (load found) (>= (load i) n))
              (break)
              (do
                (when (quasi-has-code-node? (al-elem [Quasi] items (load i)))
                  (store! found true) 0)
                (set! i (primitive/iadd (load i) 1)))))
    (load found)))
(defn quasi-has-code-node? [(q (ptr Quasi))] (-> bool)
  (match (load q)
    (QUnquote [_] true)
    (QSplice [_] true)
    (QList [_] true)
    (QVector [_] true)
    (_ false)))
(defn expr-has-code-node? [(e (ptr Expr))] (-> bool)
  (match (.kind e)
    (EComptime [_] true)
    (EQuote [_] true)
    (ECodeOp [_ _] true)
    (EQuasi [_] true)
    (ECall [_ _ args] (expr-list-has-code-node? args))
    (EBorrow [_ place] (expr-has-code-node? place))
    (ESpillRef [x] (expr-has-code-node? x))
    (EMovePlace [x] (expr-has-code-node? x))
    (ENot [x] (expr-has-code-node? x))
    (ELoad [x] (expr-has-code-node? x))
    (EFree [x] (expr-has-code-node? x))
    (EErase [_ inner] (expr-has-code-node? inner))
    (EMakeDyn [_ _ _ inner] (expr-has-code-node? inner))
    (EDynDispatch [_ _ _ _ _ _ recv args]
                  (or (expr-has-code-node? recv) (expr-list-has-code-node? args)))
    (ECast [_ x] (expr-has-code-node? x))
    (EAscribe [_ x] (expr-has-code-node? x))
    (EBin [_ l r] (or (expr-has-code-node? l) (expr-has-code-node? r)))
    (ECmp [_ l r] (or (expr-has-code-node? l) (expr-has-code-node? r)))
    (EIf [c t el]
         (or (expr-has-code-node? c)
             (or (expr-has-code-node? t) (expr-has-code-node? el))))
    (EDo [es] (expr-list-has-code-node? es))
    (ECleanup [body cleanups]
              (or (expr-has-code-node? body) (expr-list-has-code-node? cleanups)))
    (ELoop [_ es] (expr-list-has-code-node? es))
    (EBreak [_ v] (expr-opt-has-code-node? v))
    (ELet [bs body]
          (or (binds-have-code-node? bs) (expr-list-has-code-node? body)))
    (EField [p _] (expr-has-code-node? p))
    (EBitGet [p _] (expr-has-code-node? p))
    (EStore [p v] (or (expr-has-code-node? p) (expr-has-code-node? v)))
    (EInitStore [p v] (or (expr-has-code-node? p) (expr-has-code-node? v)))
    (EIndex [p idx] (or (expr-has-code-node? p) (expr-has-code-node? idx)))
    (EBitSet [p _ v] (or (expr-has-code-node? p) (expr-has-code-node? v)))
    (EConstruct [_ _ args] (expr-list-has-code-node? args))
    (ETraitCall [_ _ _ args] (expr-list-has-code-node? args))
    (ELlvmIr [_ args _] (expr-list-has-code-node? args))
    (ECallPtr [fp args]
              (or (expr-has-code-node? fp) (expr-list-has-code-node? args)))
    (EMatch [scrut arms]
            (or (expr-has-code-node? scrut) (arms-have-code-node? arms)))
    (EFieldMeta [_ _ idx] (expr-has-code-node? idx))
    (EFieldIndex [_ nm] (expr-has-code-node? nm))
    (_ false)))
(defn func-body-has-code-node? [(fp (ptr Func))] (-> bool)
  (expr-list-has-code-node? (load (field fp body))))

(defn func-calls-dropped? [(a (dyn Allocator))
                           (fp (ptr Func))
                           (names (ptr (ArrayList (slice u8))))
                           (dropped (ptr (ArrayList (slice u8))))] (-> bool)
  (let [calls (box! a SBox (primitive/zeroed SBox))
        (mut found) false]
    (set! (.items calls) (al-new [(slice u8)] a))
    (cc-list (load (field fp body)) names calls)
    (for [i 0 (al-len [(slice u8)] (.items calls))]
      (when (set-contains dropped (al-get [(slice u8)] (.items calls) i))
        (set! found true) 0)
      0)
    (load found)))

(defn code-phase-func-names [(a (dyn Allocator))
                             (p (ptr Program))] (-> (ptr (ArrayList (slice u8))))
  (let [fs (load (field p funcs))
        names (prog-fn-names p a)
        (mut dropped) (al-new [(slice u8)] a)
        (mut changed) true]
    (for [i 0 (al-len [Func] (load fs))]
      (let [fp (al-elem [Func] fs i)]
        (when (or (func-has-code fp) (func-body-has-code-node? fp))
          (al-push! (mut dropped) (load (field fp name))) 0))
      0)
    (loop (if (not (load changed))
              (break)
              (do
                (store! changed false)
                (for [i 0 (al-len [Func] (load fs))]
                  (let [fp (al-elem [Func] fs i)
                        name (load (field fp name))]
                    (when (and (not (set-contains (mut dropped) name))
                               (func-calls-dropped? a fp names (mut dropped)))
                      (al-push! (mut dropped) name)
                      (store! changed true)
                      0))
                  0))))
    (box-al [(slice u8)] a (load dropped))))
(defn drop-code-impls [(a (dyn Allocator)) (p (ptr Program))] (-> i64)
  (let [is (load (field p impls))
        n (al-len [ImplDef] (load is))
        (mut out) (al-new [ImplDef] a)
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (let [ip (al-elem [ImplDef] is (load i))]
                  (unless (type-is-comptime-code (field ip self_type))
                    (al-push! (mut out) (load ip))))
                (set! i (primitive/iadd (load i) 1)))))
    (set! (.impls p) (box-al [ImplDef] a (load out)))
    0))
(defn drop-code-funcs [(a (dyn Allocator)) (p (ptr Program))] (-> i64)
  (let [fs (load (field p funcs))
        n (al-len [Func] (load fs))
        dropped (code-phase-func-names a p)
        (mut out) (al-new [Func] a)
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (let [fp (al-elem [Func] fs (load i))]
                  (unless (set-contains dropped (load (field fp name)))
                    (al-push! (mut out) (load fp))))
                (set! i (primitive/iadd (load i) 1)))))
    (set! (.funcs p) (box-al [Func] a (load out)))
    ; This function is the final runtime boundary. Metaprogram dylibs call
    ; monomorphize directly and still need Code trait impls for dispatch; only
    ; programs that have dropped their Code functions may drop those impls too.
    (drop-code-impls a p)
    0))

; ---- canonicalize mono output order (name sorts) ----
; `mono::monomorphize` builds funcs/structs/sums from `HashMap::into_values()`
; (nondeterministic), so the raw dump is not a stable oracle. Sort these three
; sections by name (mangled names are unique → total order) before dumping. This
; sort lives ONLY in the mono dump path; the shared dumper is untouched.
(defn sdef-name [(s StructDef)] (-> (slice u8))
  (let [p (primitive/alloc-stack StructDef)] (set! p s) (.name p)))
(defn sumdef-name [(s SumDef)] (-> (slice u8))
  (let [p (primitive/alloc-stack SumDef)] (set! p s) (.name p)))
; All three sorts run on EVERY build (run-pipeline calls sort-mono-program before
; codegen), over every mono'd definition in the program. They used to be selection
; sorts: O(n²) comparisons, and each comparison pulled two whole Func/StructDef/
; SumDef structs out of the list BY VALUE just to read one name field. On the
; compiler's own source that came to ~15% of the build.
;
; Instead: extract the names ONCE, sort a permutation of indices with a bottom-up
; merge, then materialize. Same order out — mangled names are a total order and
; both sorts are stable — with O(n log n) comparisons and no struct copies.
(defn sort-index-by-name [(a (dyn Allocator)) (keys (ArrayList (slice u8)))] (-> (ArrayList i64))
  (let [n (al-len [(slice u8)] keys)
        (mut cur) (al-new [i64] a)
        (mut nxt) (al-new [i64] a)
        (mut w) 1
        (mut lo) 0
        (mut mid) 0
        (mut hi) 0
        (mut i) 0
        (mut j) 0
        (mut k) 0]
    (loop (if (>= (load k) n)
              (break)
              (do
                (al-push! (mut cur) (load k))
                (set! k (primitive/iadd (load k) 1)))))
    (loop (if (>= (load w) n)
              (break)
              (do
                (set! nxt (al-new [i64] a))
                (set! lo 0)
                (loop (if (>= (load lo) n)
                          (break)
                          (do
                            (set! mid
                                  (if (< (primitive/iadd (load lo) (load w)) n) (primitive/iadd (load lo) (load w)) n))
                            (set! hi
                                  (if (< (primitive/iadd (load mid) (load w)) n)
                                      (primitive/iadd (load mid) (load w))
                                      n))
                            (set! i (load lo))
                            (set! j (load mid))
                            (loop (if (and (>= (load i) (load mid)) (>= (load j) (load hi)))
                                      (break)
                                      ; take from the left run unless it is exhausted or the right key
                                      ; is strictly smaller — ties keep the left element, so this is stable
                                      (if (if (>= (load i) (load mid))
                                              false
                                              (if (>= (load j) (load hi))
                                                  true
                                                  (not (str-lt (al-get [(slice u8)]
                                                                       keys
                                                                       (al-get [i64] (load cur) (load j)))
                                                               (al-get [(slice u8)]
                                                                       keys
                                                                       (al-get [i64] (load cur) (load i)))))))
                                          (do
                                            (al-push! (mut nxt) (al-get [i64] (load cur) (load i)))
                                            (set! i (primitive/iadd (load i) 1)))
                                          (do
                                            (al-push! (mut nxt) (al-get [i64] (load cur) (load j)))
                                            (set! j (primitive/iadd (load j) 1))))))
                            (set! lo (load hi)))))
                (set! cur (load nxt))
                (set! w (primitive/imul (load w) 2)))))
    (load cur)))
(defn sort-funcs [(a (dyn Allocator)) (src (ptr (ArrayList Func)))] (-> (ptr (ArrayList Func)))
  (let [n (al-len [Func] (load src))
        (mut keys) (al-new [(slice u8)] a)
        (mut out) (al-new [Func] a)
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (al-push! (mut keys) (.name (al-elem [Func] src (load i))))
                (set! i (primitive/iadd (load i) 1)))))
    (let [ord (sort-index-by-name a (load keys))
          (mut c) 0]
      (loop (if (>= (load c) n)
                (break)
                (do
                  (al-push! (mut out) (al-get [Func] (load src) (al-get [i64] ord (load c))))
                  (set! c (primitive/iadd (load c) 1))))))
    (box-al [Func] a (load out))))
(defn sort-structs [(a (dyn Allocator)) (src (ptr (ArrayList StructDef)))] (-> (ptr (ArrayList StructDef)))
  (let [n (al-len [StructDef] (load src))
        (mut keys) (al-new [(slice u8)] a)
        (mut out) (al-new [StructDef] a)
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (al-push! (mut keys) (.name (al-elem [StructDef] src (load i))))
                (set! i (primitive/iadd (load i) 1)))))
    (let [ord (sort-index-by-name a (load keys))
          (mut c) 0]
      (loop (if (>= (load c) n)
                (break)
                (do
                  (al-push! (mut out) (al-get [StructDef] (load src) (al-get [i64] ord (load c))))
                  (set! c (primitive/iadd (load c) 1))))))
    (box-al [StructDef] a (load out))))
(defn sort-sums [(a (dyn Allocator)) (src (ptr (ArrayList SumDef)))] (-> (ptr (ArrayList SumDef)))
  (let [n (al-len [SumDef] (load src))
        (mut keys) (al-new [(slice u8)] a)
        (mut out) (al-new [SumDef] a)
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (al-push! (mut keys) (.name (al-elem [SumDef] src (load i))))
                (set! i (primitive/iadd (load i) 1)))))
    (let [ord (sort-index-by-name a (load keys))
          (mut c) 0]
      (loop (if (>= (load c) n)
                (break)
                (do
                  (al-push! (mut out) (al-get [SumDef] (load src) (al-get [i64] ord (load c))))
                  (set! c (primitive/iadd (load c) 1))))))
    (box-al [SumDef] a (load out))))
(defn sort-mono-program [(a (dyn Allocator)) (p (ptr Program))] (-> i64)
  (store! (field p funcs) (sort-funcs a (load (field p funcs))))
  (store! (field p structs) (sort-structs a (load (field p structs))))
  (store! (field p sums) (sort-sums a (load (field p sums))))
  0)

; ============================ entry ========================================
; dump-mono: read -> load -> resolve -> check -> mono -> sorted mono Program dump.
; (Was named dump-checked-program; the real checked dumper — which STOPS at check,
; no mono — is defined below. This serves the `dump-mono` gate subcommand.)
