(module coil.compiler.artifact_identity)
(import "coil.alloc" :as alloc :use *)
(import "coil.slice" :use *)
(import "coil.str" :use *)
(import "coil.arraylist" :use *)
(import "coil.result" :use *)
(import "coil.io" :as io)
(import "coil.fs" :as fs)
(import "coil.reader" :use *)
(import "coil.compiler.digest" :as hash)
(import "coil.compiler.ffi" :use *)
(import "coil.compiler.parser" :use [sconcat])

(defn artifact-error [(message (slice u8))] (-> Diag)
  (Diag
    :msg message
    :lo 0
    :hi 0
    :source -1
    :ctxt 0))

(defstruct ArtifactInput [(path (slice u8)) (digest (slice u8))])

(defn artifact-bytes-digest [(a (dyn Allocator)) (bytes (slice u8))] (-> (slice u8))
  (let [(mut state) (zeroed hash/Sha256)]
    (hash/sha256-init! (mut state))
    (hash/sha256-update! (mut state) bytes)
    (hash/sha256-hex a (mut state))))

;; Bound temporary hashing storage independently of the compiler image or input
;; file size. No timestamp/mtime shortcut participates in artifact validity.
(defn artifact-file-digest [(a (dyn Allocator)) (path (slice u8))] (-> (Result (slice u8)
                                                                               Diag))
  (try (let [opened
               (try-or! (fs/file-open (str->cstr a path) fs/O_RDONLY 0)
                        (Err (artifact-error (sconcat a
                                                      "cannot open artifact dependency: "
                                                      path))))]
         (let [(mut file) (: opened fs/File)
               (mut reader) (zeroed io/Reader)
               (mut buffer) (zeroed (array u8 65536))
               (mut state) (zeroed hash/Sha256)]
           (fs/file-reader (mut reader) (mut file))
           (hash/sha256-init! (mut state))
           (let [result
                   (block :reading
                          (loop (match (io/read-some (mut reader)
                                                     (cast (ptr i8)
                                                           (mut buffer))
                                                     65536)
                                  (Err [_]
                                       (break :reading
                                                (Err [(slice u8) Diag]
                                                     (artifact-error (sconcat a
                                                                              "cannot read artifact dependency: "
                                                                              path)))))
                                  (Ok [count]
                                      (when (= count 0)
                                        (break :reading
                                                 (Ok [(slice u8) Diag]
                                                     (hash/sha256-hex a
                                                                      (mut state))))
                                        0)
                                      (unless (hash/sha256-update! (mut state)
                                                                   (slice-new (cast (ptr u8)
                                                                                    (mut buffer))
                                                                              count))
                                        (break :reading
                                                 (Err [(slice u8) Diag]
                                                      (artifact-error "artifact dependency exceeds SHA-256 input limit")))
                                        0)))
                            0)
                          (Err [(slice u8) Diag]
                               (artifact-error "artifact digest read did not finish")))]
             (fs/file-close (mut file))
             result)))))

;; Length-prefix fields; concatenation and separators alone allow ambiguous
;; tuples. The schema tag versions the framing as well as artifact semantics.
(defn artifact-hash-field! [(state (ptr hash/Sha256)) (bytes (slice u8))] (-> i64)
  (let [(mut length) (zeroed (array u8 8))
        data (cast (ptr u8) (mut length))
        n (len bytes)]
    (for [i 0 8]
      (set! (index data i) (cast u8 (>> n (* i 8))))
      0)
    (hash/sha256-update! state (slice-new data 8))
    (hash/sha256-update! state bytes)
    0))

(defn artifact-inputs-sorted [(a (dyn Allocator))
                              (inputs (ptr (ArrayList ArtifactInput)))] (-> (ptr (ArrayList ArtifactInput)))
  (let [(mut sorted) (ArrayList::new [ArtifactInput] a)]
    (for [i 0 (len (load inputs))]
      (let [item (get (load inputs) i)
            (mut at) (len (load sorted))]
        (push! (mut sorted) item)
        (loop (if (= (load at) 0) (break) 0)
          (let [prior (get (load sorted) (- (load at) 1))]
            (if (<= (str-cmp (.path prior) (.path item)) 0) (break) 0)
            (set! (mut sorted) (load at) prior)
            (set! at (- (load at) 1))))
        (set! (mut sorted) (load at) item))
      0)
    (box! a (ArrayList ArtifactInput) (load sorted))))

(defn artifact-key [(a (dyn Allocator))
                    (provider (slice u8))
                    (entry (slice u8))
                    (sdk (slice u8))
                    (host (slice u8))
                    (target (slice u8))
                    (options (slice u8))
                    (inputs (ptr (ArrayList ArtifactInput)))] (-> (slice u8))
  (let [(mut state) (zeroed hash/Sha256)
        sorted (artifact-inputs-sorted a inputs)]
    (hash/sha256-init! (mut state))
    (artifact-hash-field! (mut state) "coil-provider-artifact-v1")
    (artifact-hash-field! (mut state) provider)
    (artifact-hash-field! (mut state) entry)
    (artifact-hash-field! (mut state) sdk)
    (artifact-hash-field! (mut state) host)
    (artifact-hash-field! (mut state) target)
    (artifact-hash-field! (mut state) options)
    (for [i 0 (len (load sorted))]
      (let [item (elem sorted i)]
        (artifact-hash-field! (mut state) (.path item))
        (artifact-hash-field! (mut state) (.digest item)))
      0)
    (hash/sha256-hex a (mut state))))

(defn artifact-validate-inputs [(a (dyn Allocator))
                                (inputs (ptr (ArrayList ArtifactInput)))] (-> (Result i64
                                                                                      Diag))
  (block :validate
         (for [i 0 (len (load inputs))]
           (let [item (elem inputs i)]
             (match (artifact-file-digest a (.path item))
               (Err [d] (break :validate (Err [i64 Diag] d)))
               (Ok [actual]
                   (unless (= actual (.digest item))
                     (break :validate
                              (Err [i64 Diag]
                                   (artifact-error (sconcat a
                                                            "stale provider artifact; changed dependency: "
                                                            (.path item)))))
                     0))))
           0)
         (Ok [i64 Diag] 0)))
