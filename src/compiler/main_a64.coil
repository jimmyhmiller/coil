; src/compiler/main_a64.coil — self-host Coil compiler ENTRY, LLVM-FREE build.
; Identical to main.coil except it OMITS the LLVM backend: it does not import
; codegen.coil / normalize.coil, so the produced binary links NO libLLVM and needs
; no LLVM at build or run time (only `cc` to link the native object). Its only
; supported build path is the native arm64 backend; the LLVM entry points are
; injected into the shared driver as hard-error stubs. Use main.coil for the full
; (LLVM + arm64) compiler. Imports are FILE-RELATIVE (tool-1): sibling compiler
; modules resolve against THIS file's directory (src/compiler), so it builds from
; any CWD; bare stdlib names resolve to the bundled library from anywhere.
(module maina64)
(import "coil.primitive" :as primitive)

(import "coil.alloc" :as alloc :use *)
(import "coil.result" :use *)
(import "coil.slice" :use *)
(import "coil.str" :use *)
(import "coil.arraylist" :use *)
(import "coil.io" :use *)
(import "coil.control" :use *)
(import "coil.try" :use *)
(import "ffi" :use *)
(import "coil.reader" :use *)
(import "ast" :use *)
(import "astdump" :use *)
(import "parser" :use *)
(import "loader" :use *)
(import "resolve" :use *)
(import "check" :use *)
(import "mono" :use *)
(import "diag" :use *)
(import "comptime" :use *)
(import "metaengine" :use *)
(import "expander" :use *)
(import "comptime_eval" :use *)  ; compiled comptime/const fold (interp deletion step 1)
(import "cga64" :use *)
(import "macho" :use *)  ; MObj — for the in-memory comptime builder below
(import "driver" :use *)
(import "cimport" :as ci)  ; `coil cimport` — qualified, no name leak
(import "interp" :as ip)  ; COIL_META_INTERP: run metaprograms via the interpreter
(import "metahost" :as mh)  ; the mh_* code-op callbacks + interp dispatch/halt hooks

; ---- hard-error stubs for the (excluded) LLVM backend ----
; This build has no LLVM backend; these fail loudly rather than silently no-op, so
; a caller that reaches them (e.g. `build` without --backend arm64, or `emit-ir`)
; gets a clear diagnostic instead of mysterious behavior. Signatures mirror the real
; build-ir-program / dump-ir-program / do-normalize in main.coil.
(defn no-llvm-build [(a (dyn Allocator))
                     (src (slice u8))
                     (cwd (slice u8))
                     (obj-cstr (ptr i8))
                     (triple (ptr i8))
                     (path (slice u8))] (-> i64)
  (ps (stderr) "error: this coil was built without the LLVM backend; `build` requires `--backend arm64`\n")
  (abort)
  1)

(defn no-llvm-emitir [(a (dyn Allocator)) (src (slice u8)) (cwd (slice u8)) (triple (ptr i8)) (path (slice u8))] (-> i64)
  (ps (stderr)
      "error: this coil was built without the LLVM backend; `emit-ir` / `dump-ir` are unavailable (no textual LLVM IR without libLLVM)\n")
  (abort)
  1)

(defn no-normalize [(a (dyn Allocator)) (src (slice u8))] (-> i64)
  (ps (stderr) "error: this coil was built without the LLVM backend; `__normalize` is unavailable\n")
  (abort)
  1)

; default-backend = 2 (arm64): a bare `build` uses the native backend; there is no
; LLVM backend to fall back to.
(defn do-cimport [(a (dyn Allocator)) (argc i32) (argv (ptr (ptr i8)))] (-> i64)
  (ci/cimport-cli a argc argv 2))

; the compiled-metaprogram engine's object builder (metaengine.coil): a mono'd
; metaprogram Program -> object file, via the native arm64 backend. The arm64
; backend is AAPCS64-native and now supports (export-c …) (the coil_mp_<k> entry
; symbols the dylib exposes), so this LLVM-free compiler can build metaprogram
; dylibs too — the compiled engine is the DEFAULT here, exactly as in the LLVM
; build. No DWARF for the dylib (a metaprogram needs no debug info, and there are
; no registered source paths to describe).
(defn meta-build-obj-a64 [(a (dyn Allocator)) (mp (ptr Program)) (obj (ptr i8))] (-> i64)
  (cga64-build-object a
                      mp
                      obj
                      ""
                      ""
                      (box-al [(slice u8)] a (al-new [(slice u8)] a))
                      (box-al [(slice u8)] a (al-new [(slice u8)] a))
                      false))

; the same object, handed back in memory instead of written to a file. comptime_eval
; loads this straight into executable pages (jit.coil) — no .o, no `cc`, no dlopen.
(defn meta-build-mobj-a64 [(a (dyn Allocator)) (mp (ptr Program))] (-> MObj)
  (cga64-build-mobj a
                    mp
                    ""
                    ""
                    (box-al [(slice u8)] a (al-new [(slice u8)] a))
                    (box-al [(slice u8)] a (al-new [(slice u8)] a))
                    false))

; ---- interpreter meta path (COIL_META_INTERP=1) ------------------------------------
; Run each metaprogram by interpreting its mono'd sub-program in-process (interp.coil)
; instead of compiling it to a dylib/JIT. build = mono'd Program -> persistent Interp
; context; run = call one coil_mp_<k> entry with boxed Sexp arg cells.
(defn meta-build-interp [(a (dyn Allocator)) (mp (ptr Program))] (-> (ptr i8))
  (primitive/cast (ptr i8) (ip/interp-build a mp)))
(defn meta-run-interp [(cx (ptr i8)) (sym (ptr i8)) (argv (ptr i64)) (argc i64)] (-> (ptr i8))
  (primitive/cast (ptr i8) (ip/interp-call-entry (primitive/cast (ptr ip/Interp) cx) (cstr->slice sym) argv argc)))
; comptime fold via interpreter: run coil.ct.thunk (scalar bits -> cell, or aggregate
; written through cell as a buf for kind 0) + coil.ct.status if present -> status code.
(defn meta-run-ct-interp [(cxp (ptr i8)) (kind i64) (cell (ptr i8))] (-> i64)
  (let [icx (primitive/cast (ptr ip/Interp) cxp)]
    (do
      (if (= kind (primitive/cast i64 0))
          (let [argbuf (primitive/alloc-stack (array i64 1))]
            (store! (primitive/index (primitive/cast (ptr i64) argbuf) 0) (primitive/cast i64 cell))
            (ip/interp-call-entry icx "coil.ct.thunk" (primitive/cast (ptr i64) argbuf) 1))
          (let [r (ip/interp-call-entry icx "coil.ct.thunk" (primitive/cast (ptr i64) 0) 0)]
            (store! (primitive/cast (ptr i64) cell) r)
            0))
      (when (ip/interp-has-entry? icx "coil.ct.status")
        (ip/interp-call-entry icx "coil.ct.status" (primitive/cast (ptr i64) 0) 0)))))
(defn meta-interp-env? [] (-> bool)
  (let [v (getenv c"COIL_META_INTERP")]
    (if (= (primitive/cast i64 v) (primitive/cast i64 0)) false (= (cstr->slice v) "1"))))

; Keep the stock ARM64 REPL available without importing coil.jit: that public SDK
; also contains the Linux LLVM implementation, which would make this supposedly
; LLVM-free compiler reference libLLVM merely by importing the module.
(defn jit-repl-a64 [(a (dyn Allocator)) (argv (ptr (ptr i8)))] (-> i64)
  (set-self-command! (cstr->slice (load argv)))
  (set-meta-build-obj! (primitive/fnptr-of meta-build-obj-a64))
  (set-meta-build-mobj! (primitive/fnptr-of meta-build-mobj-a64))
  (set-meta-jit! true)
  (register-comptime-fold!)
  (repl-terminal-main a (repl-session-new-with-runner a (primitive/fnptr-of repl-arm64-runner))))

(defn main [(argc i32) (argv (ptr (ptr i8)))] (-> i64)
  (set-meta-build-obj! (primitive/fnptr-of meta-build-obj-a64))
  (set-meta-build-mobj! (primitive/fnptr-of meta-build-mobj-a64))
  ; opt-in interpreter meta path: register the run hooks + the interp extern/abort
  ; hooks. Off by default ⇒ the native dylib/JIT path is byte-unchanged.
  (when (meta-interp-env?)
    (set-meta-interp! (primitive/fnptr-of meta-build-interp)
                      (primitive/fnptr-of meta-run-interp)
                      (primitive/fnptr-of meta-run-ct-interp))
    (ip/set-interp-extern-hook! (primitive/fnptr-of mh/mh-interp-dispatch))
    (ip/set-interp-abort-check! (primitive/fnptr-of mh/mh-interp-halted?))
    0)
  (register-comptime-fold!)  ; route comptime/const sites the interpreter can't fold through the compiled engine (mac-8)
  (driver-main argc
               argv
               (primitive/fnptr-of no-llvm-build)
               (primitive/fnptr-of no-llvm-emitir)
               (primitive/fnptr-of no-normalize)
               (primitive/fnptr-of do-cimport)
               (primitive/fnptr-of jit-repl-a64)
               2))
