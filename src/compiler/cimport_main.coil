; Standalone `main` wrapper around the cimport module — so the importer can be

; built and run on its own (the oracle gate uses this). The self-hosted COMPILER
; instead imports src/compiler/cimport.coil `:as ci` and dispatches `coil cimport`.
;   coil build src/compiler/cimport_main.coil -o /tmp/cimport <llvm-link-flags>
;   /tmp/cimport <header.h> [-o out.coil]
(module coil.compiler.cimport_main)
(import "coil.primitive" :as primitive)
(import "coil.alloc" :use *)
(import "coil.compiler.cimport" :use *)

(defn main [(argc i32) (argv (ptr (ptr i8)))] (-> i64)
  (cimport-cli (malloc-allocator) argc argv 1))
