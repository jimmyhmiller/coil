; src/compiler/astdump.coil — self-host Coil compiler, astdump module.

(module coil.compiler.astdump)
(import "coil.primitive" :as primitive)
(import "coil.alloc" :as alloc :use *)
(import "coil.result" :use *)
(import "coil.slice" :use *)
(import "coil.str" :use *)
(import "coil.arraylist" :use *)
(import "coil.io" :use *)
(import "coil.control" :use *)
(import "coil.try" :use *)
(import "coil.compiler.ast" :use *)

(defn d-strs [(w (ptr Writer)) (v (ptr (ArrayList (slice u8))))] (-> i64)
  (wb w 91)
  (let [(mut i) 0
        n (len (load v))]
    (loop (if (>= (load i) n)
              (break)
              (do
                (when (> (load i) (primitive/cast i64 0)) (wb w 32))
                (dstr w (get (load v) (load i)))
                (set! i (primitive/iadd (load i) 1))))))
  (wb w 93))

; `(some "x")` / `(none)` — an optional string.
(defn d-opt-str [(w (ptr Writer)) (v (Option (slice u8)))] (-> i64)
  (match v
    (Some [s] (do (ps w "(some ") (dstr w s) (wb w 41)))
    (None [] (ps w "(none)"))))

; ---- types ----
(defn d-types [(w (ptr Writer)) (v (ptr (ArrayList Type)))] (-> i64)
  (wb w 91)
  (let [(mut i) 0
        n (len (load v))]
    (loop (if (>= (load i) n)
              (break)
              (do
                (when (> (load i) (primitive/cast i64 0)) (wb w 32))
                (let [t (primitive/alloc-stack Type)] (set! t (get (load v) (load i))) (d-type w t))
                (set! i (primitive/iadd (load i) 1))))))
  (wb w 93))

(defn d-type [(w (ptr Writer)) (t (ptr Type))] (-> i64)
  (match (load t)
    (TInt [bits signed] (do (ps w "(int ") (dump-dec w bits) (wb w 32) (dbool w signed) (wb w 41)))
    (TFloat [bits] (do (ps w "(float ") (dump-dec w bits) (wb w 41)))
    (TBool [] (ps w "bool"))
    (TVoid [] (ps w "void"))
    (TPtr [inner] (do (ps w "(ptr ") (d-type w inner) (wb w 41)))
    (TRef [m inner] (do (ps w "(ref ") (dbool w m) (wb w 32) (d-type w inner) (wb w 41)))
    (TStruct [name] (do (ps w "(primitive/struct? ") (dstr w name) (wb w 41)))
    (TArray [elem n] (do (ps w "(array ") (d-type w elem) (wb w 32) (dump-dec w n) (wb w 41)))
    (TSlice [elem] (do (ps w "(slice ") (d-type w elem) (wb w 41)))
    (TVec [elem n] (do (ps w "(vec ") (d-type w elem) (wb w 32) (dump-dec w n) (wb w 41)))
    (TFn [cc params ret] (do (ps w "(fn ") (dstr w cc) (wb w 32) (d-types w params) (wb w 32) (d-type w ret) (wb w 41)))
    (TApp [name args] (do (ps w "(app ") (dstr w name) (wb w 32) (d-types w args) (wb w 41)))
    (TNever [] (ps w "never"))
    (TCode [] (ps w "code"))
    (TCodeBuilder [] (ps w "codebuilder"))
    (TExternRef [] (ps w "externref"))))

; ---- enum-tag dumpers (i64 code -> string) ----
(defn d-binop [(w (ptr Writer)) (op i64)] (-> i64)
  (ps w
      (cond (= op (primitive/cast i64 0)) "add"
            (= op (primitive/cast i64 1)) "sub"
            (= op (primitive/cast i64 2)) "mul"
            (= op (primitive/cast i64 3)) "div"
            (= op (primitive/cast i64 4)) "rem"
            (= op (primitive/cast i64 5)) "udiv"
            (= op (primitive/cast i64 6)) "urem"
            (= op (primitive/cast i64 7)) "and"
            (= op (primitive/cast i64 8)) "or"
            (= op (primitive/cast i64 9)) "xor"
            (= op (primitive/cast i64 10)) "shl"
            (= op (primitive/cast i64 11)) "shr"
            (= op (primitive/cast i64 12)) "rotl"
            (= op (primitive/cast i64 13)) "rotr"
            (= op (primitive/cast i64 14)) "mulhi"
            (= op (primitive/cast i64 15)) "add-overflow"
            (= op (primitive/cast i64 16)) "sub-overflow"
            :else "mul-overflow")))

(defn d-cmpop [(w (ptr Writer)) (op i64)] (-> i64)
  (ps w
      (cond (= op (primitive/cast i64 0)) "lt"
            (= op (primitive/cast i64 1)) "le"
            (= op (primitive/cast i64 2)) "gt"
            (= op (primitive/cast i64 3)) "ge"
            (= op (primitive/cast i64 4)) "eq"
            :else "ne")))

(defn d-storage [(w (ptr Writer)) (s i64)] (-> i64)
  (ps w
      (if (or (= s (primitive/cast i64 0)) (= s (primitive/cast i64 3)))
          "stack"
          (if (= s (primitive/cast i64 1)) "static" "heap"))))

(defn d-typequery [(w (ptr Writer)) (q i64)] (-> i64)
  (ps w
      (cond (= q (primitive/cast i64 0)) "fieldcount"
            (= q (primitive/cast i64 1)) "variantcount"
            (= q (primitive/cast i64 2)) "isstruct"
            (= q (primitive/cast i64 3)) "issum"
            (= q (primitive/cast i64 4)) "isint"
            (= q (primitive/cast i64 5)) "isfloat"
            (= q (primitive/cast i64 6)) "isptr"
            :else "isarray")))

(defn d-fieldmeta [(w (ptr Writer)) (m i64)] (-> i64)
  (ps w (if (= m (primitive/cast i64 0)) "name" (if (= m (primitive/cast i64 1)) "typekind" "typename"))))

(defn d-codeop [(w (ptr Writer)) (op i64)] (-> i64)
  (ps w
      (cond (= op (primitive/cast i64 0)) "islist"
            (= op (primitive/cast i64 1)) "issym"
            (= op (primitive/cast i64 2)) "isint"
            (= op (primitive/cast i64 3)) "count"
            (= op (primitive/cast i64 4)) "nth"
            (= op (primitive/cast i64 5)) "sym"
            (= op (primitive/cast i64 6)) "int"
            (= op (primitive/cast i64 7)) "rest"
            (= op (primitive/cast i64 8)) "gensym"
            (= op (primitive/cast i64 9)) "error"
            (= op (primitive/cast i64 10)) "eq"
            (= op (primitive/cast i64 11)) "iskeyword"
            (= op (primitive/cast i64 12)) "symbol"
            (= op (primitive/cast i64 13)) "str"
            (= op (primitive/cast i64 66)) "fresh-identifier"
            (= op (primitive/cast i64 67)) "datum->syntax"
            (= op (primitive/cast i64 68)) "syntax->datum"
            (= op (primitive/cast i64 69)) "free-identifier=?"
            (= op (primitive/cast i64 70)) "bound-identifier=?"
            (= op (primitive/cast i64 71)) "code-opaque"
            (= op (primitive/cast i64 72)) "code-from-opaque"
            (= op (primitive/cast i64 73)) "code-string?"
            (= op (primitive/cast i64 74)) "code-list-like"
            (= op (primitive/cast i64 14)) "cfieldcount"
            (= op (primitive/cast i64 15)) "cfieldname"
            (= op (primitive/cast i64 16)) "cfieldkind"
            (= op (primitive/cast i64 17)) "cfieldtype"
            (= op (primitive/cast i64 18)) "cvariantsum"
            (= op (primitive/cast i64 19)) "cvariantcount"
            (= op (primitive/cast i64 20)) "cvariantname"
            (= op (primitive/cast i64 21)) "cvariantfields"
            (= op (primitive/cast i64 47)) "cvariantfieldname"
            (= op (primitive/cast i64 48)) "cvariantfieldtype"
            (= op (primitive/cast i64 22)) "ctraitmethodcount"
            (= op (primitive/cast i64 23)) "ctraitmethodname"
            (= op (primitive/cast i64 24)) "ctraitarity"
            (= op (primitive/cast i64 25)) "ctraitparamname"
            (= op (primitive/cast i64 26)) "ctraitparamtype"
            (= op (primitive/cast i64 27)) "ctraitrettype"
            (= op (primitive/cast i64 28)) "strbytes"
            (= op (primitive/cast i64 29)) "bytestostr"
            (= op (primitive/cast i64 30)) "targetarch"
            (= op (primitive/cast i64 31)) "report"
            (= op (primitive/cast i64 32)) "warn"
            (= op (primitive/cast i64 33)) "codefile"
            (= op (primitive/cast i64 34)) "codefromuser"
            (= op (primitive/cast i64 35)) "codedecl"
            (= op (primitive/cast i64 36)) "typeof"
            (= op (primitive/cast i64 37)) "bindingof"
            :else "codefromuser")))

; ---- exprs ----
(defn d-exprs [(w (ptr Writer)) (v (ptr (ArrayList Expr)))] (-> i64)
  (wb w 91)
  (let [(mut i) 0
        n (len (load v))]
    (loop (if (>= (load i) n)
              (break)
              (do
                (when (> (load i) (primitive/cast i64 0)) (wb w 32))
                (let [e (primitive/alloc-stack Expr)] (set! e (get (load v) (load i))) (d-expr w e))
                (set! i (primitive/iadd (load i) 1))))))
  (wb w 93))

(defn d-opt-expr [(w (ptr Writer)) (v (Option (ptr Expr)))] (-> i64)
  (match v
    (Some [e] (do (ps w "(some ") (d-expr w e) (wb w 41)))
    (None [] (ps w "(none)"))))

(defn d-binds [(w (ptr Writer)) (v (ptr (ArrayList Bind)))] (-> i64)
  (wb w 91)
  (let [(mut i) 0
        n (len (load v))]
    (loop (if (>= (load i) n)
              (break)
              (do
                (when (> (load i) (primitive/cast i64 0)) (wb w 32))
                (let [b (primitive/alloc-stack Bind)]
                  (set! b (get (load v) (load i)))
                  (ps w "(bind ")
                  (dstr w (.name b))
                  (wb w 32)
                  (dbool w (.mutable b))
                  (wb w 32)
                  (let [ve (primitive/alloc-stack Expr)] (set! ve (.value b)) (d-expr w ve))
                  (wb w 41))
                (set! i (primitive/iadd (load i) 1))))))
  (wb w 93))

(defn d-arms [(w (ptr Writer)) (v (ptr (ArrayList Arm)))] (-> i64)
  (wb w 91)
  (let [(mut i) 0
        n (len (load v))]
    (loop (if (>= (load i) n)
              (break)
              (do
                (when (> (load i) (primitive/cast i64 0)) (wb w 32))
                (let [a (primitive/alloc-stack Arm)]
                  (set! a (get (load v) (load i)))
                  (ps w "(arm ")
                  (dstr w (.variant a))
                  (wb w 32)
                  (d-strs w (load (field a binds)))
                  (wb w 32)
                  (let [be (primitive/alloc-stack Expr)] (set! be (.body a)) (d-expr w be))
                  (wb w 41))
                (set! i (primitive/iadd (load i) 1))))))
  (wb w 93))

(defn d-quasi [(w (ptr Writer)) (q (ptr Quasi))] (-> i64)
  (match (load q)
    (QLit [form] (do (ps w "(qlit ") (sx-node w form) (wb w 41)))
    (QUnquote [e] (do (ps w "(qunq ") (d-expr w e) (wb w 41)))
    (QSplice [e] (do (ps w "(qspl ") (d-expr w e) (wb w 41)))
    (QList [items]
           (do
             (ps w "(qlist")
             (let [(mut i) 0
                   n (len (load items))]
               (loop (if (>= (load i) n)
                         (break)
                         (do
                           (wb w 32)
                           (let [c (primitive/alloc-stack Quasi)] (set! c (get (load items) (load i))) (d-quasi w c))
                           (set! i (primitive/iadd (load i) 1))))))
             (wb w 41)))
    (QVector [items]
             (do
               (ps w "(qvec")
               (let [(mut i) 0
                     n (len (load items))]
                 (loop (if (>= (load i) n)
                           (break)
                           (do
                             (wb w 32)
                             (let [c (primitive/alloc-stack Quasi)]
                               (set! c (get (load items) (load i)))
                               (d-quasi w c))
                             (set! i (primitive/iadd (load i) 1))))))
               (wb w 41)))))

(defn d-expr [(w (ptr Writer)) (e (ptr Expr))] (-> i64)
  (let [lo (.lo e)
        hi (.hi e)
        src (.source e)
        ctxt (.ctxt e)]
    (wb w 40)
    (match (.kind e)
      (EInt [v] (do (ps w "eint") (dump-span w src lo hi ctxt) (wb w 32) (dump-dec w v)))
      (EFloat [bits] (do (ps w "efloat") (dump-span w src lo hi ctxt) (ps w " 0x") (u-hex16 w bits)))
      (EBool [b] (do (ps w "ebool") (dump-span w src lo hi ctxt) (wb w 32) (dbool w b)))
      (EStr [s] (do (ps w "estr") (dump-span w src lo hi ctxt) (wb w 32) (dstr w s)))
      (ECStr [s] (do (ps w "ecstr") (dump-span w src lo hi ctxt) (wb w 32) (dstr w s)))
      (EVar [name] (do (ps w "var") (dump-span w src lo hi ctxt) (wb w 32) (dstr w name)))
      (EZeroed [ty]
               (do
                 (ps w "zeroed")
                 (dump-span w src lo hi ctxt)
                 (wb w 32)
                 (let [t (primitive/alloc-stack Type)] (set! t ty) (d-type w t))))
      (EBorrow [m place]
               (do (ps w "borrow") (dump-span w src lo hi ctxt) (wb w 32) (dbool w m) (wb w 32) (d-expr w place)))
      (ELet [binds body]
            (do (ps w "let") (dump-span w src lo hi ctxt) (wb w 32) (d-binds w binds) (wb w 32) (d-exprs w body)))
      (EBin [op lhs rhs]
            (do
              (ps w "bin")
              (dump-span w src lo hi ctxt)
              (wb w 32)
              (d-binop w op)
              (wb w 32)
              (d-expr w lhs)
              (wb w 32)
              (d-expr w rhs)))
      (EIntUnary [op inner]
                 (do
                   (ps w
                       (cond (= op (primitive/cast i64 0)) "inot"
                             (= op (primitive/cast i64 1)) "clz"
                             (= op (primitive/cast i64 2)) "ctz"
                             (= op (primitive/cast i64 3)) "popcount"
                             :else "bswap"))
                   (dump-span w src lo hi ctxt)
                   (wb w 32)
                   (d-expr w inner)))
      (ECmp [op lhs rhs]
            (do
              (ps w "cmp")
              (dump-span w src lo hi ctxt)
              (wb w 32)
              (d-cmpop w op)
              (wb w 32)
              (d-expr w lhs)
              (wb w 32)
              (d-expr w rhs)))
      (EIf [cnd thn els]
           (do
             (ps w "if")
             (dump-span w src lo hi ctxt)
             (wb w 32)
             (d-expr w cnd)
             (wb w 32)
             (d-expr w thn)
             (wb w 32)
             (d-expr w els)))
      (EDo [body] (do (ps w "do") (dump-span w src lo hi ctxt) (wb w 32) (d-exprs w body)))
      (ECall [func type_args args]
             (do
               (ps w "call")
               (dump-span w src lo hi ctxt)
               (wb w 32)
               (dstr w func)
               (wb w 32)
               (d-types w type_args)
               (wb w 32)
               (d-exprs w args)))
      (ENamedCall [func type_args names args]
                  (do
                    (ps w "named-call")
                    (dump-span w src lo hi ctxt)
                    (wb w 32)
                    (dstr w func)
                    (wb w 32)
                    (d-types w type_args)
                    (wb w 32)
                    (d-strs w names)
                    (wb w 32)
                    (d-exprs w args)))
      (EAlloc [storage ty init]
              (do
                (ps w "alloc")
                (dump-span w src lo hi ctxt)
                (wb w 32)
                (d-storage w storage)
                (wb w 32)
                (let [t (primitive/alloc-stack Type)] (set! t ty) (d-type w t))
                (unless (= (primitive/cast i64 init) 0)
                  (wb w 32)
                  (d-expr w init))))
      (EField [p fname]
              (do (ps w "field") (dump-span w src lo hi ctxt) (wb w 32) (d-expr w p) (wb w 32) (dstr w fname)))
      (EAccessorField [p fname]
                      (do (ps w "accessor-field") (dump-span w src lo hi ctxt) (wb w 32) (d-expr w p) (wb w 32) (dstr w fname)))
      (ELoad [inner] (do (ps w "load") (dump-span w src lo hi ctxt) (wb w 32) (d-expr w inner)))
      (EStore [p val] (do (ps w "store") (dump-span w src lo hi ctxt) (wb w 32) (d-expr w p) (wb w 32) (d-expr w val)))
      (EInitStore [p val]
                  (do (ps w "init-store") (dump-span w src lo hi ctxt) (wb w 32) (d-expr w p) (wb w 32) (d-expr w val)))
      (EIndex [p idx] (do (ps w "index") (dump-span w src lo hi ctxt) (wb w 32) (d-expr w p) (wb w 32) (d-expr w idx)))
      (ECast [ty inner]
             (do
               (ps w "cast")
               (dump-span w src lo hi ctxt)
               (wb w 32)
               (let [t (primitive/alloc-stack Type)] (set! t ty) (d-type w t))
               (wb w 32)
               (d-expr w inner)))
      (ESizeOf [ty]
               (do
                 (ps w "sizeof")
                 (dump-span w src lo hi ctxt)
                 (wb w 32)
                 (let [t (primitive/alloc-stack Type)] (set! t ty) (d-type w t))))
      (EAlignOf [ty]
                (do
                  (ps w "alignof")
                  (dump-span w src lo hi ctxt)
                  (wb w 32)
                  (let [t (primitive/alloc-stack Type)] (set! t ty) (d-type w t))))
      (EOffsetOf [ty fname]
                 (do
                   (ps w "offsetof")
                   (dump-span w src lo hi ctxt)
                   (wb w 32)
                   (let [t (primitive/alloc-stack Type)] (set! t ty) (d-type w t))
                   (wb w 32)
                   (dstr w fname)))
      (EBitGet [p fname]
               (do (ps w "bitget") (dump-span w src lo hi ctxt) (wb w 32) (d-expr w p) (wb w 32) (dstr w fname)))
      (EBitSet [p fname val]
               (do
                 (ps w "bitset")
                 (dump-span w src lo hi ctxt)
                 (wb w 32)
                 (d-expr w p)
                 (wb w 32)
                 (dstr w fname)
                 (wb w 32)
                 (d-expr w val)))
      (EFree [inner] (do (ps w "free") (dump-span w src lo hi ctxt) (wb w 32) (d-expr w inner)))
      (EErase [trait_name inner]
              (do (ps w "erase") (dump-span w src lo hi ctxt) (wb w 32) (dstr w trait_name) (wb w 32) (d-expr w inner)))
      (EMatch [scrut arms]
              (do (ps w "match") (dump-span w src lo hi ctxt) (wb w 32) (d-expr w scrut) (wb w 32) (d-arms w arms)))
      (EFnPtrOf [name] (do (ps w "fnptrof") (dump-span w src lo hi ctxt) (wb w 32) (dstr w name)))
      (ECallPtr [fp args]
                (do (ps w "callptr") (dump-span w src lo hi ctxt) (wb w 32) (d-expr w fp) (wb w 32) (d-exprs w args)))
      (ELoop [label body]
             (do (ps w "loop") (dump-span w src lo hi ctxt) (wb w 32) (d-opt-str w label) (wb w 32) (d-exprs w body)))
      (EBreak [label value]
              (do
                (ps w "break")
                (dump-span w src lo hi ctxt)
                (wb w 32)
                (d-opt-str w label)
                (wb w 32)
                (d-opt-expr w value)))
      (EContinue [label] (do (ps w "continue") (dump-span w src lo hi ctxt) (wb w 32) (d-opt-str w label)))
      (EAnonFn [params body]
               (do
                 (ps w "fn")
                 (dump-span w src lo hi ctxt)
                 (wb w 32)
                 (d-strs w params)
                 (wb w 32)
                 (d-exprs w body)))
      (ELlvmIr [result args body]
               (do
                 (ps w "llvmir")
                 (dump-span w src lo hi ctxt)
                 (wb w 32)
                 (let [t (primitive/alloc-stack Type)] (set! t result) (d-type w t))
                 (wb w 32)
                 (d-exprs w args)
                 (wb w 32)
                 (dstr w body)))
      (ETypeQuery [q ty]
                  (do
                    (ps w "typequery")
                    (dump-span w src lo hi ctxt)
                    (wb w 32)
                    (d-typequery w q)
                    (wb w 32)
                    (let [t (primitive/alloc-stack Type)] (set! t ty) (d-type w t))))
      (EFieldMeta [meta ty idx]
                  (do
                    (ps w "fieldmeta")
                    (dump-span w src lo hi ctxt)
                    (wb w 32)
                    (d-fieldmeta w meta)
                    (wb w 32)
                    (let [t (primitive/alloc-stack Type)] (set! t ty) (d-type w t))
                    (wb w 32)
                    (d-expr w idx)))
      (EFieldIndex [ty name]
                   (do
                     (ps w "fieldindex")
                     (dump-span w src lo hi ctxt)
                     (wb w 32)
                     (let [t (primitive/alloc-stack Type)] (set! t ty) (d-type w t))
                     (wb w 32)
                     (d-expr w name)))
      (EQuote [form] (do (ps w "quote") (dump-span w src lo hi ctxt) (wb w 32) (sx-node w form)))
      (ECodeOp [op args]
               (do (ps w "codeop") (dump-span w src lo hi ctxt) (wb w 32) (d-codeop w op) (wb w 32) (d-exprs w args)))
      (EQuasi [q]
              (do
                (ps w "quasi")
                (dump-span w src lo hi ctxt)
                (wb w 32)
                (let [qp (primitive/alloc-stack Quasi)] (set! qp q) (d-quasi w qp))))
      (EComptime [inner] (do (ps w "comptime") (dump-span w src lo hi ctxt) (wb w 32) (d-expr w inner)))
      (EAscribe [ty inner]
                (do
                  (ps w "ascribe")
                  (dump-span w src lo hi ctxt)
                  (wb w 32)
                  (let [t (primitive/alloc-stack Type)] (set! t ty) (d-type w t))
                  (wb w 32)
                  (d-expr w inner)))
      (EArrayLit [items]
                 (do (ps w "array-lit") (dump-span w src lo hi ctxt) (wb w 32) (d-exprs w items)))
      ; ---- check-introduced variants  ----
      (ESpillRef [inner] (do (ps w "spillref") (dump-span w src lo hi ctxt) (wb w 32) (d-expr w inner)))
      (EMovePlace [place] (do (ps w "move-place") (dump-span w src lo hi ctxt) (wb w 32) (d-expr w place)))
      (EMakeSlice [data elem len]
                  (do
                    (ps w "make-slice")
                    (dump-span w src lo hi ctxt)
                    (wb w 32)
                    (d-expr w data)
                    (wb w 32)
                    (let [t (primitive/alloc-stack Type)] (set! t elem) (d-type w t))
                    (wb w 32)
                    (print-int w len)
                    0))
      (EConstruct [sum variant args]
                  (do
                    (ps w "construct")
                    (dump-span w src lo hi ctxt)
                    (wb w 32)
                    (dstr w sum)
                    (wb w 32)
                    (dstr w variant)
                    (wb w 32)
                    (d-exprs w args)))
      (ETraitCall [trait_name method self_tp args]
                  (do
                    (ps w "traitcall")
                    (dump-span w src lo hi ctxt)
                    (wb w 32)
                    (dstr w trait_name)
                    (wb w 32)
                    (dstr w method)
                    (wb w 32)
                    (dstr w self_tp)
                    (wb w 32)
                    (d-exprs w args)))
      (EDynDispatch [dyn_struct vtable_struct method_index cc params ret recv args]
                    (do
                      (ps w "dyndispatch")
                      (dump-span w src lo hi ctxt)
                      (wb w 32)
                      (dstr w dyn_struct)
                      (wb w 32)
                      (dstr w vtable_struct)
                      (wb w 32)
                      (dump-dec w method_index)
                      (wb w 32)
                      (dstr w cc)
                      (wb w 32)
                      (d-types w params)
                      (wb w 32)
                      (let [t (primitive/alloc-stack Type)] (set! t ret) (d-type w t))
                      (wb w 32)
                      (d-expr w recv)
                      (wb w 32)
                      (d-exprs w args)))
      (EMakeDyn [dyn_struct vtable_struct methods inner]
                (do
                  (ps w "makedyn")
                  (dump-span w src lo hi ctxt)
                  (wb w 32)
                  (dstr w dyn_struct)
                  (wb w 32)
                  (dstr w vtable_struct)
                  (wb w 32)
                  (d-strs w methods)
                  (wb w 32)
                  (d-expr w inner)))
      (ECleanup [body cleanups]
                (do
                  (ps w "cleanup")
                  (dump-span w src lo hi ctxt)
                  (wb w 32)
                  (d-expr w body)
                  (wb w 32)
                  (d-exprs w cleanups)))
      (EStaticRef [name] (do (ps w "staticref") (dump-span w src lo hi ctxt) (wb w 32) (dstr w name))))
    (wb w 41)))

; ---- declarations ----
(defn d-param [(w (ptr Writer)) (p (ptr Param))] (-> i64)
  (ps w "(param ")
  (dstr w (.name p))
  (wb w 32)
  (let [t (primitive/alloc-stack Type)] (set! t (.ty p)) (d-type w t))
  (wb w 41))

(defn d-params [(w (ptr Writer)) (v (ptr (ArrayList Param)))] (-> i64)
  (wb w 91)
  (let [(mut i) 0
        n (len (load v))]
    (loop (if (>= (load i) n)
              (break)
              (do
                (when (> (load i) (primitive/cast i64 0)) (wb w 32))
                (let [p (primitive/alloc-stack Param)] (set! p (get (load v) (load i))) (d-param w p))
                (set! i (primitive/iadd (load i) 1))))))
  (wb w 93))

(defn d-field [(w (ptr Writer)) (f (ptr Field))] (-> i64)
  (ps w "(fld ")
  (dstr w (.name f))
  (wb w 32)
  (let [t (primitive/alloc-stack Type)] (set! t (.ty f)) (d-type w t))
  (wb w 41))

(defn d-fields [(w (ptr Writer)) (v (ptr (ArrayList Field)))] (-> i64)
  (wb w 91)
  (let [(mut i) 0
        n (len (load v))]
    (loop (if (>= (load i) n)
              (break)
              (do
                (when (> (load i) (primitive/cast i64 0)) (wb w 32))
                (let [f (primitive/alloc-stack Field)] (set! f (get (load v) (load i))) (d-field w f))
                (set! i (primitive/iadd (load i) 1))))))
  (wb w 93))

(defn d-i64s [(w (ptr Writer)) (v (ptr (ArrayList i64)))] (-> i64)
  (wb w 91)
  (let [(mut i) 0
        n (len (load v))]
    (loop (if (>= (load i) n)
              (break)
              (do
                (when (> (load i) (primitive/cast i64 0)) (wb w 32))
                (dump-dec w (get (load v) (load i)))
                (set! i (primitive/iadd (load i) 1))))))
  (wb w 93))

(defn d-bounds [(w (ptr Writer)) (v (ptr (ArrayList Bound)))] (-> i64)
  (wb w 91)
  (let [(mut i) 0
        n (len (load v))]
    (loop (if (>= (load i) n)
              (break)
              (do
                (when (> (load i) (primitive/cast i64 0)) (wb w 32))
                (let [b (primitive/alloc-stack Bound)]
                  (set! b (get (load v) (load i)))
                  (ps w "(bound ")
                  (dstr w (.name b))
                  (wb w 32)
                  (wb w 91)
                  (for [j 0 (len (load (field b traits)))]
                    (when (> j 0) (wb w 32))
                    (let [bt (al-elem [BoundTrait] (load (field b traits)) j)]
                      (wb w 40)
                      (dstr w (.name bt))
                      (for [k 0 (len (load (field bt args)))]
                        (wb w 32)
                        (d-type w (al-elem [Type] (load (field bt args)) k)))
                      (wb w 41)))
                  (wb w 93)
                  (wb w 41))
                (set! i (primitive/iadd (load i) 1))))))
  (wb w 93))

(defn d-func [(w (ptr Writer)) (f (ptr Func))] (-> i64)
  (ps w "(func ")
  (dstr w (.name f))
  (wb w 32)
  (d-strs w (load (field f type_params)))
  (wb w 32)
  (d-bounds w (load (field f bounds)))
  (wb w 32)
  (dstr w (.cc f))
  (wb w 32)
  (ps w "(annotations")
  (let [anns (load (field f annotations))
        n (len (load anns))
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (let [ap (al-elem [Annotation] anns (load i))]
                  (wb w 32)
                  (dstr w (.key ap))
                  (wb w 32)
                  (d-expr w (field ap value)))
                (set! i (primitive/iadd (load i) 1))))))
  (wb w 41)
  (wb w 32)
  (d-params w (load (field f params)))
  (wb w 32)
  (let [t (primitive/alloc-stack Type)] (set! t (.ret f)) (d-type w t))
  (wb w 32)
  (d-exprs w (load (field f body)))
  (wb w 32)
  (dbool w (.macro_variadic f))
  (wb w 32)
  (dump-span w
             (.source f)
             (.lo f)
             (.hi f)
             (.ctxt f))
  (wb w 41))

(defn d-convention [(w (ptr Writer)) (c (ptr Convention))] (-> i64)
  (ps w "(cc ")
  (dstr w (.name c))
  (wb w 32)
  (d-strs w (load (field c params)))
  (wb w 32)
  (d-opt-str w (.ret c))
  (wb w 32)
  (d-strs w (load (field c clobber)))
  (wb w 32)
  (d-strs w (load (field c preserve)))
  (wb w 32)
  (match (.lowering c)
    (LNative [cc]
             (do
               (ps w "(native ")
               (ps w (if (= cc (primitive/cast i64 0)) "c" (if (= cc (primitive/cast i64 1)) "fast" "cold")))
               (wb w 41)))
    (LShim [] (ps w "(shim)"))
    (LReset [] (ps w "(reset)")))
  (wb w 41))

(defn d-layout [(w (ptr Writer)) (l (ptr Layout))] (-> i64)
  (match (load l)
    (LC [] (ps w "(c)"))
    (LPacked [] (ps w "(packed)"))
    (LAligned [n] (do (ps w "(aligned ") (dump-dec w n) (wb w 41)))
    (LExplicit [offsets size align]
               (do
                 (ps w "(explicit ")
                 (d-i64s w offsets)
                 (wb w 32)
                 (match size (Some [n] (do (ps w "(some ") (dump-dec w n) (wb w 41))) (None [] (ps w "(none)")))
                 (wb w 32)
                 (dump-dec w align)
                 (wb w 41)))
    (LBits [backing offsets]
           (do (ps w "(bits ") (dump-dec w backing) (wb w 32) (d-i64s w offsets) (wb w 41)))))

(defn d-struct [(w (ptr Writer)) (s (ptr StructDef))] (-> i64)
  (ps w "(primitive/struct? ")
  (dstr w (.name s))
  (wb w 32)
  (d-strs w (load (field s type_params)))
  (wb w 32)
  (let [lp (primitive/alloc-stack Layout)] (set! lp (.layout s)) (d-layout w lp))
  (wb w 32)
  (d-fields w (load (field s fields)))
  (wb w 41))

(defn d-variant [(w (ptr Writer)) (vr (ptr Variant))] (-> i64)
  (ps w "(variant ")
  (dstr w (.name vr))
  (wb w 32)
  (d-fields w (load (field vr fields)))
  (wb w 41))

(defn d-sum [(w (ptr Writer)) (s (ptr SumDef))] (-> i64)
  (ps w "(sum ")
  (dstr w (.name s))
  (wb w 32)
  (d-strs w (load (field s type_params)))
  (wb w 32)
  (wb w 91)
  (let [(mut i) 0
        n (len (load (field s variants)))]
    (loop (if (>= (load i) n)
              (break)
              (do
                (when (> (load i) (primitive/cast i64 0)) (wb w 32))
                (let [vr (primitive/alloc-stack Variant)]
                  (set! vr (get (load (field s variants)) (load i)))
                  (d-variant w vr))
                (set! i (primitive/iadd (load i) 1))))))
  (wb w 93)
  (wb w 41))

(defn d-extern [(w (ptr Writer)) (e (ptr Extern))] (-> i64)
  (ps w "(extern ")
  (dstr w (.name e))
  (wb w 32)
  (dstr w (.cc e))
  (wb w 32)
  (d-types w (load (field e params)))
  (wb w 32)
  (dbool w (.variadic e))
  (wb w 32)
  (let [t (primitive/alloc-stack Type)] (set! t (.ret e)) (d-type w t))
  (wb w 41))

(defn d-assert [(w (ptr Writer)) (a (ptr StaticAssert))] (-> i64)
  (ps w "(assert ")
  (let [ce (primitive/alloc-stack Expr)] (set! ce (.cnd a)) (d-expr w ce))
  (wb w 32)
  (dstr w (.msg a))
  (wb w 41))

(defn d-const [(w (ptr Writer)) (c (ptr Const))] (-> i64)
  (ps w (if (.runtime c) "(def " "(const "))
  (dstr w (.name c))
  (wb w 32)
  (match (.ty c)
    (Some [t] (do (ps w "(some ") (let [tp (primitive/alloc-stack Type)] (set! tp t) (d-type w tp)) (wb w 41)))
    (None [] (ps w "(none)")))
  (wb w 32)
  (let [ve (primitive/alloc-stack Expr)] (set! ve (.value c)) (d-expr w ve))
  (wb w 41))

(defn d-trait [(w (ptr Writer)) (t (ptr TraitDef))] (-> i64)
  (ps w "(trait ")
  (dstr w (.name t))
  (wb w 32)
  (dstr w (.self_param t))
  (wb w 32)
  (wb w 91)
  (let [(mut i) 0
        n (len (load (field t methods)))]
    (loop (if (>= (load i) n)
              (break)
              (do
                (when (> (load i) (primitive/cast i64 0)) (wb w 32))
                (let [m (primitive/alloc-stack TraitMethod)]
                  (set! m (get (load (field t methods)) (load i)))
                  (ps w "(method ")
                  (dstr w (.name m))
                  (wb w 32)
                  (d-params w (load (field m params)))
                  (wb w 32)
                  (let [rt (primitive/alloc-stack Type)] (set! rt (.ret m)) (d-type w rt))
                  (wb w 41))
                (set! i (primitive/iadd (load i) 1))))))
  (wb w 93)
  (wb w 41))

(defn d-impl [(w (ptr Writer)) (im (ptr ImplDef))] (-> i64)
  (if (impl-is-inherent im)
      (ps w "(inherent ")
      (do
        (ps w "(impl ")
        (dstr w (impl-trait-name im))
        (wb w 32)))
  (dstr w (.for_type im))
  (wb w 32)
  (wb w 91)
  (let [(mut i) 0
        n (len (load (field im methods)))]
    (loop (if (>= (load i) n)
              (break)
              (do
                (when (> (load i) (primitive/cast i64 0)) (wb w 32))
                (let [f (primitive/alloc-stack Func)] (set! f (get (load (field im methods)) (load i))) (d-func w f))
                (set! i (primitive/iadd (load i) 1))))))
  (wb w 93)
  (wb w 41))

(defn d-export [(w (ptr Writer)) (e (ptr ExportC))] (-> i64)
  (ps w "(export ")
  (dstr w (.name e))
  (wb w 32)
  (d-opt-str w (.symbol e))
  (wb w 32)
  (d-types w (load (field e params)))
  (wb w 32)
  (dump-span w
             (.source e)
             (.lo e)
             (.hi e)
             (.ctxt e))
  (wb w 41))

; Byte-lexicographic `<` on strings (ASCII conv names):
; a proper prefix is less than the longer string.
(defn str-lt [(x (slice u8)) (y (slice u8))] (-> bool)
  (let [nx (len x)
        ny (len y)
        (mut i) 0
        (mut res) 0]
    (loop (if (or (>= (load i) nx) (>= (load i) ny))
              (break)
              (let [cx (primitive/cast i64 (get x (load i)))
                    cy (primitive/cast i64 (get y (load i)))]
                (if (< cx cy)
                    (do (set! res 1) (break))
                    (if (> cx cy)
                        (do (set! res 2) (break))
                        (set! i (primitive/iadd (load i) 1)))))))
    (if (= (load res) (primitive/cast i64 1)) true (if (= (load res) (primitive/cast i64 2)) false (< nx ny)))))

(defn conv-name [(c Convention)] (-> (slice u8))
  (let [p (primitive/alloc-stack Convention)] (set! p c) (.name p)))

; A whole-section dumper: `(<tag>` then a space+item per element, then `)`.
; Mirrors dump_program's per-section loops.
(defn d-program [(w (ptr Writer)) (p (ptr Program)) (a (dyn Allocator))] (-> i64)
  ; conventions — sorted by name (mirrors dump_program's keys().sort()).
  (ps w "(conventions")
  (let [convs (load (field p conventions))
        n (len convs)
        (mut used) (al-new [bool] a)
        (mut k) 0]
    (loop (if (>= (load k) n)
              (break)
              (do
                (push! (mut used) false)
                (set! k (primitive/iadd (load k) 1)))))
    (let [(mut c) 0]
      (loop (if (>= (load c) n)
                (break)
                (do
                  (let [(mut best) -1
                        (mut bi) 0]
                    (loop (if (>= (load bi) n)
                              (break)
                              (do
                                (when (and (not (get (load used) (load bi)))
                                           (or (< (load best) (primitive/cast i64 0))
                                               (str-lt (conv-name (get convs (load bi)))
                                                       (conv-name (get convs (load best))))))
                                  (store! best (load bi)))
                                (set! bi (primitive/iadd (load bi) 1)))))
                    (set! (mut used) (load best) true)
                    (wb w 32)
                    (let [cc (primitive/alloc-stack Convention)]
                      (set! cc (get convs (load best)))
                      (d-convention w cc)))
                  (set! c (primitive/iadd (load c) 1)))))))
  (wb w 41)
  (ps w "\n(annotation-defs")
  (let [defs (load (field p annotation_defs))
        n (len (load defs))
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (let [d (al-elem [AnnotationDef] defs (load i))]
                  (ps w " (annotation-def ")
                  (dstr w (.key d))
                  (wb w 32)
                  (d-type w (field d value_type))
                  (wb w 41))
                (set! i (primitive/iadd (load i) 1))))))
  (wb w 41)
  (ps w "\n(structs")
  (let [(mut i) 0
        n (len (load (field p structs)))]
    (loop (if (>= (load i) n)
              (break)
              (do
                (wb w 32)
                (let [s (primitive/alloc-stack StructDef)]
                  (set! s (get (load (field p structs)) (load i)))
                  (d-struct w s))
                (set! i (primitive/iadd (load i) 1))))))
  (wb w 41)
  (ps w "\n(sums")
  (let [(mut i) 0
        n (len (load (field p sums)))]
    (loop (if (>= (load i) n)
              (break)
              (do
                (wb w 32)
                (let [s (primitive/alloc-stack SumDef)] (set! s (get (load (field p sums)) (load i))) (d-sum w s))
                (set! i (primitive/iadd (load i) 1))))))
  (wb w 41)
  (ps w "\n(externs")
  (let [(mut i) 0
        n (len (load (field p externs)))]
    (loop (if (>= (load i) n)
              (break)
              (do
                (wb w 32)
                (let [e (primitive/alloc-stack Extern)]
                  (set! e (get (load (field p externs)) (load i)))
                  (d-extern w e))
                (set! i (primitive/iadd (load i) 1))))))
  (wb w 41)
  (ps w "\n(funcs")
  (let [(mut i) 0
        n (len (load (field p funcs)))]
    (loop (if (>= (load i) n)
              (break)
              (do
                (wb w 32)
                (let [f (primitive/alloc-stack Func)] (set! f (get (load (field p funcs)) (load i))) (d-func w f))
                (set! i (primitive/iadd (load i) 1))))))
  (wb w 41)
  (ps w "\n(asserts")
  (let [(mut i) 0
        n (len (load (field p asserts)))]
    (loop (if (>= (load i) n)
              (break)
              (do
                (wb w 32)
                (let [a (primitive/alloc-stack StaticAssert)]
                  (set! a (get (load (field p asserts)) (load i)))
                  (d-assert w a))
                (set! i (primitive/iadd (load i) 1))))))
  (wb w 41)
  (ps w "\n(consts")
  (let [(mut i) 0
        n (len (load (field p consts)))]
    (loop (if (>= (load i) n)
              (break)
              (do
                (wb w 32)
                (let [c (primitive/alloc-stack Const)] (set! c (get (load (field p consts)) (load i))) (d-const w c))
                (set! i (primitive/iadd (load i) 1))))))
  (wb w 41)
  (ps w "\n(traits")
  (let [(mut i) 0
        n (len (load (field p traits)))]
    (loop (if (>= (load i) n)
              (break)
              (do
                (wb w 32)
                (let [t (primitive/alloc-stack TraitDef)]
                  (set! t (get (load (field p traits)) (load i)))
                  (d-trait w t))
                (set! i (primitive/iadd (load i) 1))))))
  (wb w 41)
  (ps w "\n(impls")
  (let [(mut i) 0
        n (len (load (field p impls)))]
    (loop (if (>= (load i) n)
              (break)
              (do
                (wb w 32)
                (let [im (primitive/alloc-stack ImplDef)]
                  (set! im (get (load (field p impls)) (load i)))
                  (d-impl w im))
                (set! i (primitive/iadd (load i) 1))))))
  (wb w 41)
  (ps w "\n(statics)")
  (ps w "\n(metas")
  (let [(mut i) 0
        n (len (load (field p metas)))]
    (loop (if (>= (load i) n)
              (break)
              (do
                (wb w 32)
                (let [m (primitive/alloc-stack Expr)] (set! m (get (load (field p metas)) (load i))) (d-expr w m))
                (set! i (primitive/iadd (load i) 1))))))
  (wb w 41)
  (ps w "\n(exports")
  (let [(mut i) 0
        n (len (load (field p exports)))]
    (loop (if (>= (load i) n)
              (break)
              (do
                (wb w 32)
                (let [e (primitive/alloc-stack ExportC)]
                  (set! e (get (load (field p exports)) (load i)))
                  (d-export w e))
                (set! i (primitive/iadd (load i) 1))))))
  (wb w 41)
  0)

; ============================ the PORT (implement these) =====================
; Each stub HARD-ABORTS (never a silent wrong value). Replace the body with a
; faithful.
