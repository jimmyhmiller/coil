; src/compiler/codegen_a64.coil — the native AArch64 backend (zero LLVM).

; Consumes the SAME monomorphized Program as codegen.coil and lowers it
; directly to machine code in a Mach-O object. codegen.coil (the LLVM
; backend) is the behavioral spec: every lowering decision here mirrors its
; semantics — sum layout {i32 tag, [words x i64] payload}, slice fat pointers
; {ptr,i64}, divergence discipline, C ABI (AAPCS64) at every call.
;
; Code generation model (debug backend — compile speed over code quality):
;  - every value lives by-value in an fp-anchored stack slot; x28 = slot base
;  - scratch registers x9-x15 / d0-d7 are only live within one expression
;  - one calling convention everywhere: AAPCS64 (Apple), incl. variadic rule
;
; Frame layout (grows down):     [caller frame | incoming stack args]
;   x29 -> saved x29,x30                      <- stp x29,x30,[sp,#-16]!
;          saved x28 (+8 pad)                 <- str x28,[sp,#-16]!
;          slots (x28 = base, off 0..slotbytes)
;   sp  -> outgoing stack args (outbytes)
; prologue subs + `add x28, sp, #outbytes` are back-patched once the body is
; emitted and slotbytes/outbytes are known.
(module coil.compiler.codegen_a64)
(import "coil.primitive" :as primitive)
(import "coil.alloc" :as alloc :use *)
(import "coil.result" :use *)
(import "coil.slice" :use *)
(import "coil.str" :use *)
(import "coil.arraylist" :use *)
(import "coil.hashmap" :use *)
(import "coil.io" :use *)
(import "coil.control" :use *)
(import "coil.compiler.ast" :use *)
(import "coil.compiler.parser" :use *)
(import "coil.compiler.layoutdb" :use *)
(import "coil.compiler.a64" :use *)
(import "coil.compiler.macho" :use *)
(import "coil.compiler.dwarf" :use *)
(import "coil.compiler.mtrace" :as mtr)

; file-writing externs (creat is NOT variadic, unlike open-with-O_CREAT)
(extern cga64.creat [(ptr i8) i64] (-> i64))

(extern cga64.write [i32 (ptr i8) isize] (-> isize))  ; C write's fd is int (i32); matches io/cimport write (isize=i64 native, i32 wasm)

(extern cga64.close [i32] (-> i32))  ; C `close(int?)` returns int, not long — matches ffi.close/cimport.close (return is discarded)

(extern cga64.exit [i32] (-> i64))

; ============================ state ==========================================
(defstruct GSig  ; one callable (function or extern)
  [(name (slice u8))
   (params (ptr (ArrayList Type)))
   (ret Type)
   (variadic bool)
   (symidx i64)
   (shim bool)
   (implsym i64)  ; :shim conventions (trampoline realization)
   (shimregs (ptr (ArrayList i64)))
   (shimret i64)
   (func (ptr Func))
   (inline_policy i64)])

(defstruct GLoop
  [(label (Option (slice u8)))
   (contlabel i64)
   (breaklabel i64)
   (resslot i64)
   (resty Type)
   (has_res bool)])

(defstruct GStr [(s (slice u8)) (symidx i64)])  ; interned string literal

(defstruct GStatic [(name (slice u8)) (ty Type) (symidx i64)])

; a lowered value: kind 0 = int/ptr immediate, 1 = slot (by-value), 2 = f64 imm bits
(defstruct AVal [(kind i64) (v i64) (ty Type)])

(defsum GScope
  (GNil [])
  (GBind [(name (slice u8)) (av AVal) (rest (ptr GScope))]))

(defstruct Cga
  [(a (dyn Allocator))
   (program (ptr Program))
   (layouts LayoutDb)
   (sigs (ArrayList GSig))  ; funcs + externs, keyed by name
   (sig_index (HashMap (slice u8) i64))
   (obj MObj)
   (text i64)
   (constsec i64)
   (datasec i64)  ; section ordinals
   (asm Asm)
   (strs (ArrayList GStr))  ; interned EStr/ECStr globals
   (statics (ArrayList GStatic))
   (nglob i64)  ; g.N counter
   (nstatic i64)  ; stable alloc-static ordinal within the current function
   ; ---- per-function state ----
   (frame i64)  ; next free slot offset
   (env (ptr GScope))
   (loops (ArrayList GLoop))
   (terminated bool)
   (retty Type)
   (sretslot i64)  ; slot holding incoming x8, -1 = none
   (epilabel i64)
   (outbytes i64)  ; max outgoing stack-arg bytes of any call
   (fnstart i64)  ; text offset of current function start
   ; ---- self-tail-call state (see emit-tail-self-call!) ----
   (selfname (slice u8))  ; name of the function being emitted
   (tailslots (ptr (ArrayList i64)))  ; its parameter slots, in order
   (tailtys (ptr (ArrayList Type)))  ; and their types
   (entrylabel i64)  ; label bound after parameter intake
   (tailok bool)  ; the expression being emitted is in TAIL position
   (inline_depth i64)
   ; ---- DWARF collection ----
   (dwtys (ArrayList DwTy))
   (dwfns (ArrayList DwFn))
   (dwvars (ArrayList DwVar))
   (dwevs (ArrayList DwLineEv))
   (dwcursrc i64)
   (dwcurlo i64)
   (convs (ptr (ArrayList Convention)))])

; hard error helper — no silent fallbacks anywhere in this backend.
(defn cga-fail [(msg (slice u8))] (-> i64)
  (print-str (stderr) "cga64: ")
  (print-str (stderr) msg)
  (write-byte (stderr) (primitive/cast u8 10))
  (mtr/mtrace-mem-report-once!)
  (abort)
  0)

(defn cga-fail2 [(msg (slice u8)) (what (slice u8))] (-> i64)
  (print-str (stderr) "cga64: ")
  (print-str (stderr) msg)
  (print-str (stderr) what)
  (write-byte (stderr) (primitive/cast u8 10))
  (mtr/mtrace-mem-report-once!)
  (abort)
  0)

(defn mk-aval [(kind i64) (v i64) (ty Type)] (-> AVal)
  (let [p (primitive/alloc-stack AVal)]
    (set! (.kind p) kind)
    (set! (.v p) v)
    (set! (.ty p) ty)
    (load p)))

(defn av-kind [(x AVal)] (-> i64)
  (let [p (primitive/alloc-stack AVal)] (set! p x) (.kind p)))

(defn av-v [(x AVal)] (-> i64)
  (let [p (primitive/alloc-stack AVal)] (set! p x) (.v p)))

(defn av-ty [(x AVal)] (-> Type)
  (let [p (primitive/alloc-stack AVal)] (set! p x) (.ty p)))

(defn gscope-nil [(a (dyn Allocator))] (-> (ptr GScope))
  (box! a GScope (GNil)))

(defn gscope-put [(a (dyn Allocator)) (s (ptr GScope)) (name (slice u8)) (av AVal)] (-> (ptr GScope))
  (box! a
        GScope
        (GBind
          :name name
          :av av
          :rest s)))

(defn gscope-get [(s (ptr GScope)) (name (slice u8))] (-> (Option AVal))
  (match (load s)
    (GNil [] (None [AVal]))
    (GBind [n av rest] (if (= n name) (Some [AVal] av) (gscope-get rest name)))))

; ---- shared type layout ----------------------------------------------------
(defn g-struct-idx [(g (ptr Cga)) (name (slice u8))] (-> i64)
  (struct-index (field g layouts) name))

(defn g-sum-idx [(g (ptr Cga)) (name (slice u8))] (-> i64)
  (sum-index (field g layouts) name))

(defn g-sig-idx [(g (ptr Cga)) (name (slice u8))] (-> i64)
  (match (get (.sig_index g) name)
    (Some [index] index)
    (None [] -1)))

(defn ty-align [(g (ptr Cga)) (t (ptr Type))] (-> i64)
  (align (field g layouts) t))

(defn ty-size [(g (ptr Cga)) (t (ptr Type))] (-> i64)
  (size (field g layouts) t))

(defn g-field-off [(g (ptr Cga)) (si i64) (fi i64)] (-> i64)
  (field-offset (field g layouts) si fi))

(defn g-field-idx [(g (ptr Cga)) (si i64) (name (slice u8))] (-> i64)
  (field-number (field g layouts) si name))

(defn g-field-ty [(g (ptr Cga)) (si i64) (fi i64)] (-> (ptr Type))
  (field (al-at [Field]
                (load (field (al-at [StructDef] (load (field (.program g) structs)) si) fields))
                fi)
         ty))

(defn g-type-bytes [(g (ptr Cga)) (t (ptr Type))] (-> i64)
  (type-bytes (field g layouts) t))

(defn g-sum-words-def [(g (ptr Cga)) (variants (ptr (ArrayList Variant)))] (-> i64)
  (sum-words (field g layouts) variants))

(defn g-natural-off [(g (ptr Cga)) (fields (ptr (ArrayList Field))) (fi i64)] (-> i64)
  (natural-offset (field g layouts) fields fi))

(defn g-variant-idx [(g (ptr Cga)) (su i64) (name (slice u8))] (-> i64)
  (variant-number (field g layouts) su name))

(defn g-register-types! [(g (ptr Cga)) (mp (ptr Program))] (-> i64)
  (set! (.layouts g) (LayoutDb::new (.a g) mp "cga64" 8 8))
  0)

; ============================ program registration ===========================
; extern "io.write" links against C symbol "_write" (last dot component).
(defn g-last-component [(nm (slice u8))] (-> (slice u8))
  (let [n (len nm)
        (mut dot) -1
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (when (= (primitive/cast i64 (get nm (load i))) (primitive/cast i64 46)) (store! dot (load i)))
                (set! i (primitive/iadd (load i) 1)))))
    (if (>= (load dot) (primitive/cast i64 0)) (subslice nm (primitive/iadd (load dot) 1) n) nm)))

(defn g-func-inline-policy [(f (ptr Func))] (-> i64)
  (let [anns (load (field f annotations))
        n (len (load anns))
        (mut i) 0
        (mut policy) 0]
    (loop (if (>= (load i) n)
              (break)
              (let [ap (al-elem [Annotation] anns (load i))]
                (when (= (load (field ap key)) "inline")
                  (match (load (field (field ap value) kind))
                    (EConstruct [_sum variant _args]
                                (let [v (g-last-component variant)]
                                  (cond (= v "Always") (store! policy 1)
                                        (= v "Hint") (store! policy 2)
                                        (= v "Never") (store! policy 3)
                                        :else 0)))
                    (ECall [func _type_args _args]
                           (let [v (g-last-component func)]
                             (cond (= v "Always") (store! policy 1)
                                   (= v "Hint") (store! policy 2)
                                   (= v "Never") (store! policy 3)
                                   :else 0)))
                    (_ 0)))
                (set! i (primitive/iadd (load i) 1)))))
    (load policy)))

(defn g-mangle [(g (ptr Cga)) (nm (slice u8))] (-> (slice u8))
  (sconcat (.a g) "_" nm))

; the C symbol a function is exported under, or None. Mirrors codegen.coil's
; cg-export-find: an (export-c …) entry pins the function's public symbol. On this
; AAPCS64-native backend no thunk is needed — the function itself is emitted under
; this symbol with external linkage (see g-register-sigs!). ExportC.symbol is always
; Some by codegen time (check.coil fills the default bare-name symbol when :as is
; omitted).
(defn g-export-c-sym [(mp (ptr Program)) (name (slice u8))] (-> (Option (slice u8)))
  (let [es (load (field mp exports))
        n (len (load es))
        (mut i) 0
        (mut r) (None [(slice u8)])]
    (loop (if (>= (load i) n)
              (break)
              (do
                (when (= (load (field (al-at [ExportC] es (load i)) name)) name)
                  (store! r (load (field (al-at [ExportC] es (load i)) symbol)))
                  (break))
                (set! i (primitive/iadd (load i) 1)))))
    (load r)))

; a by-value STRUCT param (type-tag 6) is the one C-export case this reference-model
; backend passes differently from C (by pointer, not in registers) — it would need a
; C-ABI marshaling thunk. Mirrors codegen.coil::cg-export-needs-thunk. Scalar/pointer
; params, struct RETURNS (sret / x0-x1, which already match C), and the metaprogram
; entries (Code = pointer args, empty ExportC params) are all thunk-free.
(defn g-export-needs-thunk [(e (ptr ExportC))] (-> bool)
  (let [ps (load (field e params))
        n (len (load ps))
        (mut i) 0
        (mut r) false]
    (loop (if (>= (load i) n)
              (break)
              (do
                (match (load (al-at [Type] ps (load i))) (TStruct [nm] (do (set! r true) 0)) (_ 0))
                (set! i (primitive/iadd (load i) 1)))))
    (load r)))

; register every extern + func as a GSig with a Mach-O symbol.
(defn g-register-sigs! [(g (ptr Cga)) (mp (ptr Program))] (-> i64)
  (let [es (load (field mp externs))
        n (len (load es))
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (let [ed (al-at [Extern] es (load i))
                      sym
                        (mobj-add-sym! (mut (.obj g))
                                       (g-mangle g (g-last-component (.name ed)))
                                       0
                                       0
                                       true)
                      e (primitive/alloc-stack GSig)]
                  (set! (.name e) (.name ed))
                  (set! (.params e) (load (field ed params)))
                  (set! (.ret e) (.ret ed))
                  (set! (.variadic e) (.variadic ed))
                  (set! (.symidx e) sym)
                  (set! (.shim e) false)
                  (set! (.implsym e) -1)
                  (set! (.shimregs e)
                        (box-al [i64]
                                (.a g)
                                (al-new [i64]
                                        (.a g))))
                  (set! (.shimret e) 0)
                  (set! (.func e) (primitive/cast (ptr Func) 0))
                  (set! (.inline_policy e) 0)
                  ; duplicate extern declarations across modules are expected; keep the first
                  (when (< (g-sig-idx g (load (field ed name))) (primitive/cast i64 0))
                    (push! (mut (field g
                                       sigs))
                           (load e))
                    (set! (mut (field g sig_index))
                          (load (field ed name))
                          (primitive/isub (len (load (field g sigs))) 1))
                    0))
                (set! i (primitive/iadd (load i) 1))))))
  (let [fs (load (field mp funcs))
        n (len (load fs))
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (let [fd (al-at [Func] fs (load i))
                      expsym (g-export-c-sym mp (.name fd))
                      ; an exported function is emitted directly under its C symbol with
                      ; external linkage; otherwise the mangled Coil name, external only for main.
                      ext
                        (or (= (.name fd) "main")
                            (match expsym (Some [s] true) (None [] false)))
                      symname (match expsym (Some [s] s) (None [] (.name fd)))
                      sym
                        (mobj-add-sym! (mut (.obj g))
                                       (g-mangle g symname)
                                       (.text g)
                                       0
                                       ext)
                      (mut ptys) (al-new [Type] (.a g))
                      e (primitive/alloc-stack GSig)]
                  (let [ps (load (field fd params))
                        np (len (load ps))
                        (mut j) 0]
                    (loop (if (>= (load j) np)
                              (break)
                              (do
                                (push! (mut ptys) (.ty (al-at [Param] ps (load j))))
                                (set! j (primitive/iadd (load j) 1))))))
                  (set! (.name e) (.name fd))
                  (set! (.params e) (box-al [Type] (.a g) (load ptys)))
                  (set! (.ret e) (.ret fd))
                  (set! (.variadic e) false)
                  (set! (.symidx e) sym)
                  (set! (.shim e) false)
                  (set! (.implsym e) -1)
                  (set! (.shimregs e)
                        (box-al [i64]
                                (.a g)
                                (al-new [i64]
                                        (.a g))))
                  (set! (.shimret e) 0)
                  (set! (.func e) fd)
                  (set! (.inline_policy e) (g-func-inline-policy fd))
                  ; a :shim-convention function is realized as <name>__impl + trampoline
                  (let [ci (g-conv-idx g (.cc fd))]
                    (when (>= ci (primitive/cast i64 0))
                      (match (load (field (al-at [Convention] (load (field g convs)) ci) lowering))
                        (LShim []
                               (let [cv (al-at [Convention] (load (field g convs)) ci)
                                     (mut regs) (al-new [i64] (load (field g a)))
                                     prs (load (field cv params))
                                     npr (len (load prs))
                                     (mut j) 0]
                                 (loop (if (>= (load j) npr)
                                           (break)
                                           (do
                                             (push! (mut regs)
                                                    (g-parse-xreg g
                                                                  (get (load prs) (load j))))
                                             (store! j (primitive/iadd (load j) 1)))))
                                 (store! (field e shim) true)
                                 (store! (field e shimregs)
                                         (box-al [i64]
                                                 (load (field g
                                                              a))
                                                 (load regs)))
                                 (store! (field e shimret)
                                         (match (load (field cv ret))
                                           (Some [r] (g-parse-xreg g r))
                                           (None [] 0)))
                                 (store! (field e implsym)
                                         (mobj-add-sym! (mut (field g obj))
                                                        (g-mangle g
                                                                  (sconcat (load (field g a))
                                                                           (load (field fd name))
                                                                           "__impl"))
                                                        (load (field g text))
                                                        0
                                                        false))
                                 0))
                        (LNative [_] 0)
                        (LReset [] 0))))
                  (push! (mut (.sigs g)) (load e))
                  (set! (mut (.sig_index g))
                        (.name fd)
                        (primitive/isub (len (.sigs g)) 1)))
                (set! i (primitive/iadd (load i) 1))))))
  0)

(defn g-conv-idx [(g (ptr Cga)) (nm (slice u8))] (-> i64)
  (let [cs (load (field g convs))
        n (len (load cs))
        (mut i) 0
        (mut r) -1]
    (loop (if (>= (load i) n)
              (break)
              (do
                (when (= (load (field (al-at [Convention] cs (load i)) name)) nm)
                  (store! r
                          (load i)))
                (set! i (primitive/iadd (load i) 1)))))
    (load r)))

; "x20" -> 20 (shim conventions name GPRs as xN; validated by the checker)
(defn g-parse-xreg [(g (ptr Cga)) (r (slice u8))] (-> i64)
  (if (or (= r "lr") (= r "x30"))
      30
      (if (!= (primitive/cast i64 (get r 0)) (primitive/cast i64 120))
          (cga-fail2 "shim register is not an x-register: " r)
          (let [v (str->i64 (subslice r 1 (len r)))]
            (if (or (>= v (primitive/cast i64 28)) (and (>= v (primitive/cast i64 16)) (<= v (primitive/cast i64 17))))
                (cga-fail2 "shim register collides with backend-reserved registers: " r)
                v)))))

; set a defined symbol's section offset once known (function start / global).
(defn mobj-set-sym! [(o (ptr MObj)) (idx i64) (sect i64) (off i64)] (-> i64)
  (let [sp (al-at [MSym] (field o syms) idx)]
    (set! (.sect sp) sect)
    (set! (.off sp) off)
    0))

; ============================ frame / slots ==================================
(defn slot-new! [(g (ptr Cga)) (size i64) (align i64)] (-> i64)
  ; every slot is 8-aligned and 8-rounded (16 for 16-aligned types): stores of
  ; full x-words into small slots can never clobber a neighbor.
  (let [al (if (< align (primitive/cast i64 8)) 8 align)
        sz (primitive/imul (primitive/idiv (primitive/iadd (if (< size (primitive/cast i64 1)) 1 size) 7) 8) 8)
        off (primitive/imul (primitive/idiv (primitive/iadd (.frame g) (primitive/isub al 1)) al) al)]
    (set! (.frame g) (primitive/iadd off sz))
    off))

(defn slot-for-ty! [(g (ptr Cga)) (t (ptr Type))] (-> i64)
  (slot-new! g (ty-size g t) (ty-align g t)))

; x28 + off into `reg` (single add when the offset fits imm12).
(defn emit-slot-addr! [(g (ptr Cga)) (reg i64) (off i64)] (-> i64)
  (let [s (field g asm)]
    (if (<= off (primitive/cast i64 4095))
        (a64-w! (mut s) (a64-add-imm reg 28 off))
        (do
          (a64-mov-imm! (mut s) reg off)
          (a64-w! (mut s) (a64-add-reg reg 28 reg))
          0))))

; can a scaled-u12 load/store reach offset `off` at scale `sz`?
(defn ldst-fits [(off i64) (sz i64)] (-> bool)
  (and (= (primitive/urem off sz) (primitive/cast i64 0)) (<= (primitive/idiv off sz) (primitive/cast i64 4095))))

; load an int/ptr/bool slot into x-reg `reg`, extending per width+signedness.
; base register `base` (usually 28).
(defn emit-load-int! [(g (ptr Cga)) (reg i64) (base i64) (off i64) (bytes i64) (signed bool)] (-> i64)
  (let [s (field g asm)]
    (cond (= bytes (primitive/cast i64 1))
            (if (ldst-fits off 1)
                (a64-w! (mut s) (if signed (a64-ldrsb-x reg base off) (a64-ldr-b reg base off)))
                (do
                  (emit-slot-addr! g 16 off)
                  (a64-w! (mut s) (if signed (a64-ldrsb-x reg 16 0) (a64-ldr-b reg 16 0)))))
          (= bytes (primitive/cast i64 2))
            (if (ldst-fits off 2)
                (a64-w! (mut s) (if signed (a64-ldrsh-x reg base off) (a64-ldr-h reg base off)))
                (do
                  (emit-slot-addr! g 16 off)
                  (a64-w! (mut s) (if signed (a64-ldrsh-x reg 16 0) (a64-ldr-h reg 16 0)))))
          (= bytes (primitive/cast i64 4))
            (if (ldst-fits off 4)
                (a64-w! (mut s) (if signed (a64-ldrsw-x reg base off) (a64-ldr-w reg base off)))
                (do
                  (emit-slot-addr! g 16 off)
                  (a64-w! (mut s) (if signed (a64-ldrsw-x reg 16 0) (a64-ldr-w reg 16 0)))))
          (ldst-fits off 8) (a64-w! (mut s) (a64-ldr-x reg base off))
          :else
            (do
              (emit-slot-addr! g 16 off)
              (a64-w! (mut s) (a64-ldr-x reg 16 0))))))

; store x-reg `reg` into a slot, truncating to the slot width.
(defn emit-store-int! [(g (ptr Cga)) (reg i64) (base i64) (off i64) (bytes i64)] (-> i64)
  (let [s (field g asm)]
    (cond (= bytes (primitive/cast i64 1))
            (if (ldst-fits off 1)
                (a64-w! (mut s) (a64-str-b reg base off))
                (do (emit-slot-addr! g 16 off) (a64-w! (mut s) (a64-str-b reg 16 0))))
          (= bytes (primitive/cast i64 2))
            (if (ldst-fits off 2)
                (a64-w! (mut s) (a64-str-h reg base off))
                (do (emit-slot-addr! g 16 off) (a64-w! (mut s) (a64-str-h reg 16 0))))
          (= bytes (primitive/cast i64 4))
            (if (ldst-fits off 4)
                (a64-w! (mut s) (a64-str-w reg base off))
                (do (emit-slot-addr! g 16 off) (a64-w! (mut s) (a64-str-w reg 16 0))))
          (ldst-fits off 8) (a64-w! (mut s) (a64-str-x reg base off))
          :else (do (emit-slot-addr! g 16 off) (a64-w! (mut s) (a64-str-x reg 16 0))))))

; float slot <-> d/s register
(defn emit-load-fp! [(g (ptr Cga)) (dreg i64) (base i64) (off i64) (bytes i64)] (-> i64)
  (let [s (field g asm)]
    (if (= bytes (primitive/cast i64 4))
        (if (ldst-fits off 4)
            (a64-w! (mut s) (a64-ldr-s dreg base off))
            (do (emit-slot-addr! g 16 off) (a64-w! (mut s) (a64-ldr-s dreg 16 0))))
        (if (ldst-fits off 8)
            (a64-w! (mut s) (a64-ldr-d dreg base off))
            (do (emit-slot-addr! g 16 off) (a64-w! (mut s) (a64-ldr-d dreg 16 0)))))))

(defn emit-store-fp! [(g (ptr Cga)) (dreg i64) (base i64) (off i64) (bytes i64)] (-> i64)
  (let [s (field g asm)]
    (if (= bytes (primitive/cast i64 4))
        (if (ldst-fits off 4)
            (a64-w! (mut s) (a64-str-s dreg base off))
            (do (emit-slot-addr! g 16 off) (a64-w! (mut s) (a64-str-s dreg 16 0))))
        (if (ldst-fits off 8)
            (a64-w! (mut s) (a64-str-d dreg base off))
            (do (emit-slot-addr! g 16 off) (a64-w! (mut s) (a64-str-d dreg 16 0)))))))

; is a type an int-like scalar (lives in x regs)? floats live in d/s.
(defn ty-is-float [(t (ptr Type))] (-> bool)
  (match (load t) (TFloat [_] true) (_ false)))

(defn ty-float-bytes [(t (ptr Type))] (-> i64)
  (match (load t) (TFloat [bits] (primitive/idiv bits 8)) (_ 8)))

(defn ty-is-scalar [(t (ptr Type))] (-> bool)
  (match (load t)
    (TInt [_ _] true)
    (TBool [] true)
    (TPtr [_] true)
    (TRef [_ _] true)
    (TFn [_ _ _] true)
    (TNever [] true)
    (TFloat [_] true)
    (TStruct [nm] false)
    (_ false)))

; int-like scalar: scalar and not float
(defn ty-int-info [(g (ptr Cga)) (t (ptr Type)) (bytesp (ptr i64)) (signedp (ptr bool))] (-> i64)
  (match (load t)
    (TInt [bits sg]
          (do
            (set! bytesp
                  (if (<= bits (primitive/cast i64 8))
                      1
                      (if (<= bits (primitive/cast i64 16))
                          2
                          (if (<= bits
                                  (primitive/cast i64
                                                  32))
                              4
                              8))))
            (set! signedp sg)
            0))
    (TBool [] (do (set! bytesp 1) (set! signedp false) 0))
    (_ (do (set! bytesp 8) (set! signedp false) 0))))

; load an AVal into x-reg `reg` (int-like values only).
(defn av-to-x! [(g (ptr Cga)) (av AVal) (reg i64)] (-> i64)
  (let [k (av-kind av)
        t (primitive/alloc-stack Type)]
    (set! t (av-ty av))
    (if (or (= k (primitive/cast i64 0))
            (= k (primitive/cast i64 2)))
        (a64-mov-imm! (mut (.asm g)) reg (av-v av))
        ; raw f64 bits as int
        (let [bytes (primitive/alloc-stack i64)
              signed (primitive/alloc-stack bool)]
          (ty-int-info g t bytes signed)
          (if (ty-is-float t)
              (emit-load-int! g reg 28 (av-v av) (ty-float-bytes t) false)
              (emit-load-int! g reg 28 (av-v av) (load bytes) (load signed)))))))

; load an AVal into fp reg `dreg` (float values only).
(defn av-to-d! [(g (ptr Cga)) (av AVal) (dreg i64)] (-> i64)
  (let [k (av-kind av)
        t (primitive/alloc-stack Type)]
    (set! t (av-ty av))
    (if (= k (primitive/cast i64 2))
        (do
          (a64-mov-imm! (mut (.asm g)) 16 (av-v av))
          (a64-w! (mut (.asm g)) (a64-fmov-x-to-fp dreg 16))
          0)
        (if (= k (primitive/cast i64 1))
            (emit-load-fp! g dreg 28 (av-v av) (ty-float-bytes t))
            (cga-fail "av-to-d!: int immediate where float expected")))))

; materialize an AVal into a slot; returns the slot offset.
(defn av-slot! [(g (ptr Cga)) (av AVal)] (-> i64)
  (if (= (av-kind av) (primitive/cast i64 1))
      (av-v av)
      (let [t (primitive/alloc-stack Type)]
        (set! t (av-ty av))
        (let [off (slot-for-ty! g t)]
          (if (= (av-kind av) (primitive/cast i64 2))
              (do
                (a64-mov-imm! (mut (.asm g)) 9 (av-v av))
                (emit-store-int! g 9 28 off (ty-size g t))
                0)
              (do
                (a64-mov-imm! (mut (.asm g)) 9 (av-v av))
                (emit-store-int! g 9 28 off (ty-size g t))
                0))
          off))))

; copy `size` bytes between slots (x28-relative), through x9 (+x16/x17 for
; big-offset addressing). Unrolled words for small sizes, byte loop for huge.
(defn emit-copy! [(g (ptr Cga)) (dst i64) (src i64) (size i64)] (-> i64)
  (let [s (field g asm)]
    (if (<= size (primitive/cast i64 256))
        (let [(mut k) 0]
          (loop (if (>= (primitive/iadd (load k) 8) (primitive/iadd size 1))
                    (break)
                    (do
                      (emit-load-int! g 9 28 (primitive/iadd src (load k)) 8 false)
                      (emit-store-int! g 9 28 (primitive/iadd dst (load k)) 8)
                      (set! k (primitive/iadd (load k) 8)))))
          ; remainder: 4/2/1 byte chunks
          (when (<= (primitive/iadd (load k) 4) size)
            (emit-load-int! g 9 28 (primitive/iadd src (load k)) 4 false)
            (emit-store-int! g 9 28 (primitive/iadd dst (load k)) 4)
            (store! k (primitive/iadd (load k) 4))
            0)
          (when (<= (primitive/iadd (load k) 2) size)
            (emit-load-int! g 9 28 (primitive/iadd src (load k)) 2 false)
            (emit-store-int! g 9 28 (primitive/iadd dst (load k)) 2)
            (store! k (primitive/iadd (load k) 2))
            0)
          (when (<= (primitive/iadd (load k) 1) size)
            (emit-load-int! g 9 28 (primitive/iadd src (load k)) 1 false)
            (emit-store-int! g 9 28 (primitive/iadd dst (load k)) 1)
            (store! k (primitive/iadd (load k) 1))
            0)
          0)
        ; big: byte loop  x10=i, x11=srcbase, x12=dstbase
        (do
          (emit-slot-addr! g 11 src)
          (emit-slot-addr! g 12 dst)
          (a64-mov-imm! (mut s) 10 0)
          (a64-mov-imm! (mut s) 13 size)
          (let [ltop (a64-new-label (mut s))
                lend (a64-new-label (mut s))]
            (a64-bind-label! (mut s) ltop)
            (a64-w! (mut s) (a64-cmp-reg 10 13))
            (a64-bcond-label! (mut s) (cond-ge) lend)
            (a64-w! (mut s) (a64-ldst-roff 0 0 1 9 11 10))  ; ldrb x9,[x11,x10]
            (a64-w! (mut s) (a64-ldst-roff 0 0 0 9 12 10))  ; strb x9,[x12,x10]
            (a64-w! (mut s) (a64-add-imm 10 10 1))
            (a64-b-label! (mut s) ltop)
            (a64-bind-label! (mut s) lend))
          0))))

; copy `size` bytes from a slot to memory addressed by x-reg `dstreg`, and the
; reverse. Byte loops via register-offset addressing (x10 idx, x9 data).
; NOTE: the data register is x14 — callers pass the ADDRESS in x9.
; slot -> slot, both x28-relative. 8-byte chunks then a byte tail, so an odd size
; (a packed struct) is copied correctly rather than rounded.
(defn emit-copy-slot! [(g (ptr Cga)) (dst i64) (src i64) (size i64)] (-> i64)
  (let [(mut k) 0]
    (loop (if (> (primitive/iadd (load k) 8) size)
              (break)
              (do
                (emit-load-int! g 14 28 (primitive/iadd src (load k)) 8 false)
                (emit-store-int! g 14 28 (primitive/iadd dst (load k)) 8)
                (set! k (primitive/iadd (load k) 8)))))
    (loop (if (>= (load k) size)
              (break)
              (do
                (emit-load-int! g 14 28 (primitive/iadd src (load k)) 1 false)
                (emit-store-int! g 14 28 (primitive/iadd dst (load k)) 1)
                (set! k (primitive/iadd (load k) 1)))))
    0))

(defn emit-copy-to-mem! [(g (ptr Cga)) (dstreg i64) (src i64) (size i64)] (-> i64)
  (let [s (field g asm)]
    (if (<= size (primitive/cast i64 64))
        (let [(mut k) 0]
          (loop (if (>= (primitive/iadd (load k) 8) (primitive/iadd size 1))
                    (break)
                    (do
                      (emit-load-int! g 14 28 (primitive/iadd src (load k)) 8 false)
                      (a64-w! (mut s) (a64-str-x 14 dstreg (load k)))
                      (set! k (primitive/iadd (load k) 8)))))
          (when (<= (primitive/iadd (load k) 4) size)
            (emit-load-int! g 14 28 (primitive/iadd src (load k)) 4 false)
            (a64-w! (mut s) (a64-str-w 14 dstreg (load k)))
            (store! k (primitive/iadd (load k) 4))
            0)
          (when (<= (primitive/iadd (load k) 2) size)
            (emit-load-int! g 14 28 (primitive/iadd src (load k)) 2 false)
            (a64-w! (mut s) (a64-str-h 14 dstreg (load k)))
            (store! k (primitive/iadd (load k) 2))
            0)
          (when (<= (primitive/iadd (load k) 1) size)
            (emit-load-int! g 14 28 (primitive/iadd src (load k)) 1 false)
            (a64-w! (mut s) (a64-str-b 14 dstreg (load k)))
            (store! k (primitive/iadd (load k) 1))
            0)
          0)
        (do
          (emit-slot-addr! g 11 src)
          (a64-mov-imm! (mut s) 10 0)
          (a64-mov-imm! (mut s) 13 size)
          (let [ltop (a64-new-label (mut s))
                lend (a64-new-label (mut s))]
            (a64-bind-label! (mut s) ltop)
            (a64-w! (mut s) (a64-cmp-reg 10 13))
            (a64-bcond-label! (mut s) (cond-ge) lend)
            (a64-w! (mut s) (a64-ldst-roff 0 0 1 14 11 10))
            (a64-w! (mut s) (a64-ldst-roff 0 0 0 14 dstreg 10))
            (a64-w! (mut s) (a64-add-imm 10 10 1))
            (a64-b-label! (mut s) ltop)
            (a64-bind-label! (mut s) lend))
          0))))

; NOTE: the data register is x14 — callers pass the ADDRESS in x9.
(defn emit-copy-from-mem! [(g (ptr Cga)) (dst i64) (srcreg i64) (size i64)] (-> i64)
  (let [s (field g asm)]
    (if (<= size (primitive/cast i64 64))
        (let [(mut k) 0]
          (loop (if (>= (primitive/iadd (load k) 8) (primitive/iadd size 1))
                    (break)
                    (do
                      (a64-w! (mut s) (a64-ldr-x 14 srcreg (load k)))
                      (emit-store-int! g 14 28 (primitive/iadd dst (load k)) 8)
                      (set! k (primitive/iadd (load k) 8)))))
          (when (<= (primitive/iadd (load k) 4) size)
            (a64-w! (mut s) (a64-ldr-w 14 srcreg (load k)))
            (emit-store-int! g 14 28 (primitive/iadd dst (load k)) 4)
            (store! k (primitive/iadd (load k) 4))
            0)
          (when (<= (primitive/iadd (load k) 2) size)
            (a64-w! (mut s) (a64-ldr-h 14 srcreg (load k)))
            (emit-store-int! g 14 28 (primitive/iadd dst (load k)) 2)
            (store! k (primitive/iadd (load k) 2))
            0)
          (when (<= (primitive/iadd (load k) 1) size)
            (a64-w! (mut s) (a64-ldr-b 14 srcreg (load k)))
            (emit-store-int! g 14 28 (primitive/iadd dst (load k)) 1)
            (store! k (primitive/iadd (load k) 1))
            0)
          0)
        (do
          (emit-slot-addr! g 12 dst)
          (a64-mov-imm! (mut s) 10 0)
          (a64-mov-imm! (mut s) 13 size)
          (let [ltop (a64-new-label (mut s))
                lend (a64-new-label (mut s))]
            (a64-bind-label! (mut s) ltop)
            (a64-w! (mut s) (a64-cmp-reg 10 13))
            (a64-bcond-label! (mut s) (cond-ge) lend)
            (a64-w! (mut s) (a64-ldst-roff 0 0 1 14 srcreg 10))
            (a64-w! (mut s) (a64-ldst-roff 0 0 0 14 12 10))
            (a64-w! (mut s) (a64-add-imm 10 10 1))
            (a64-b-label! (mut s) ltop)
            (a64-bind-label! (mut s) lend))
          0))))

; ============================ zeroing ========================================
(defn emit-zero! [(g (ptr Cga)) (dst i64) (size i64)] (-> i64)
  (let [s (field g asm)]
    (if (<= size (primitive/cast i64 256))
        (let [(mut k) 0]
          (loop (if (>= (primitive/iadd (load k) 8) (primitive/iadd size 1))
                    (break)
                    (do
                      (emit-store-int! g 31 28 (primitive/iadd dst (load k)) 8)  ; str xzr
                      (set! k (primitive/iadd (load k) 8)))))
          (when (<= (primitive/iadd (load k) 4) size)
            (emit-store-int! g 31 28 (primitive/iadd dst (load k)) 4)
            (store! k (primitive/iadd (load k) 4))
            0)
          (when (<= (primitive/iadd (load k) 2) size)
            (emit-store-int! g 31 28 (primitive/iadd dst (load k)) 2)
            (store! k (primitive/iadd (load k) 2))
            0)
          (when (<= (primitive/iadd (load k) 1) size)
            (emit-store-int! g 31 28 (primitive/iadd dst (load k)) 1)
            (store! k (primitive/iadd (load k) 1))
            0)
          0)
        (do
          (emit-slot-addr! g 12 dst)
          (a64-mov-imm! (mut s) 10 0)
          (a64-mov-imm! (mut s) 13 size)
          (let [ltop (a64-new-label (mut s))
                lend (a64-new-label (mut s))]
            (a64-bind-label! (mut s) ltop)
            (a64-w! (mut s) (a64-cmp-reg 10 13))
            (a64-bcond-label! (mut s) (cond-ge) lend)
            (a64-w! (mut s) (a64-ldst-roff 0 0 0 31 12 10))  ; strb wzr,[x12,x10]
            (a64-w! (mut s) (a64-add-imm 10 10 1))
            (a64-b-label! (mut s) ltop)
            (a64-bind-label! (mut s) lend))
          0))))

; ============================ ABI classification =============================
; classes: 0 = int-like scalar (x reg), 1 = float scalar (d/s reg),
;          2 = aggregate <= 8B (one x reg), 3 = aggregate <= 16B (x pair),
;          4 = aggregate > 16B (indirect), 5 = HFA (hfa_n regs of hfa_bits)
(defstruct AbiInfo [(cls i64) (hfa_n i64) (hfa_bits i64)])

; HFA walk: count uniform float leaves; returns leaf count or -1 (not an HFA).
; bitsp receives the leaf width. Mirrors abi-hfa in codegen.coil.
(defn g-hfa-walk [(g (ptr Cga)) (t (ptr Type)) (bitsp (ptr i64))] (-> i64)
  (match (load t)
    (TFloat [bits]
            (if (= (load bitsp) (primitive/cast i64 0))
                (do (set! bitsp bits) 1)
                (if (= (load bitsp) bits) 1 -1)))
    (TArray [elem n]
            (let [inner (g-hfa-walk g elem bitsp)]
              (if (< inner (primitive/cast i64 0)) -1 (primitive/imul inner n))))
    (TStruct [nm]
             (let [si (g-struct-idx g nm)]
               (if (< si (primitive/cast i64 0))
                   -1
                   (let [fs (load (field (struct-at (field g layouts) si) fields))
                         nf (len (load fs))
                         (mut i) 0
                         (mut tot) 0]
                     ; only plain C layouts participate in HFA classification
                     (match (.layout (struct-at (field g layouts) si))
                       (LC []
                           (do
                             (loop (if (>= (load i) nf)
                                       (break)
                                       (do
                                         (let [inner
                                                 (g-hfa-walk g
                                                             (field (al-at [Field] fs (load i)) ty)
                                                             bitsp)]
                                           (if (< inner (primitive/cast i64 0))
                                               (do (set! tot -1000000) 0)
                                               (set! tot (primitive/iadd (load tot) inner))))
                                         (set! i (primitive/iadd (load i) 1)))))
                             (if (< (load tot) (primitive/cast i64 0)) -1 (load tot))))
                       (_ -1))))))
    (_ -1)))

(defn g-abi-info [(g (ptr Cga)) (t (ptr Type))] (-> AbiInfo)
  (let [r (primitive/alloc-stack AbiInfo)]
    (set! (.hfa_n r) 0)
    (set! (.hfa_bits r) 0)
    (if (ty-is-scalar t)
        (do (set! (.cls r) (if (ty-is-float t) (do 1) 0)) 0)
        (let [bitsp (primitive/alloc-stack i64)]
          (set! bitsp 0)
          (let [hn (g-hfa-walk g t bitsp)]
            (if (and (>= hn (primitive/cast i64 1)) (<= hn (primitive/cast i64 4)))
                (do
                  (set! (.cls r) 5)
                  (set! (.hfa_n r) hn)
                  (set! (.hfa_bits r) (load bitsp))
                  0)
                (let [sz (ty-size g t)]
                  (if (<= sz (primitive/cast i64 8))
                      (do (set! (.cls r) 2) 0)
                      (if (<= sz (primitive/cast i64 16))
                          (do (set! (.cls r) 3) 0)
                          (do (set! (.cls r) 4) 0))))))))
    (load r)))

(defn abi-cls [(x AbiInfo)] (-> i64)
  (let [p (primitive/alloc-stack AbiInfo)] (set! p x) (.cls p)))

(defn abi-hfa-n [(x AbiInfo)] (-> i64)
  (let [p (primitive/alloc-stack AbiInfo)] (set! p x) (.hfa_n p)))

(defn abi-hfa-bits [(x AbiInfo)] (-> i64)
  (let [p (primitive/alloc-stack AbiInfo)] (set! p x) (.hfa_bits p)))

(defn mk-abi-scalar [] (-> AbiInfo)
  (let [r (primitive/alloc-stack AbiInfo)]
    (set! (.cls r) 0)
    (set! (.hfa_n r) 0)
    (set! (.hfa_bits r) 0)
    (load r)))

; ============================ calls ==========================================
; One unified AAPCS64 (Apple) call emitter for direct calls (symidx >= 0),
; and indirect calls through a function-pointer AVal (symidx < 0).
; `params` = the callee's declared param types (named args); args beyond that
; are variadic (Apple: on the stack, 8-byte slots).
(defn emit-call! [(g (ptr Cga))
                  (symidx i64)
                  (fpav (ptr AVal))
                  (params (ptr (ArrayList Type)))
                  (variadic bool)
                  (ret Type)
                  (avs (ptr (ArrayList AVal)))] (-> AVal)
  (let [s (field g asm)
        a (.a g)
        nargs (len (load avs))
        nparams (len (load params))
        retp (primitive/alloc-stack Type)]
    (set! retp ret)
    ; ---- return classification
    (let [retvoid (match ret (TVoid [] true) (_ false))
          retinfo (if retvoid (mk-abi-scalar) (g-abi-info g retp))
          ; indirect result slot (also the result home for by-value agg returns)
          resslot (if retvoid -1 (slot-for-ty! g retp))
          ; ---- plan: parallel lists per arg
          ; kinds: 0 xreg, 1 dreg, 2 xpair, 3 stack, 4 indirect-xreg, 5 hfa-dregs, 6 indirect-stack
          (mut pkind) (al-new [i64] a)
          (mut pa) (al-new [i64] a)  ; xreg#/dreg#/stack off
          (mut pslot) (al-new [i64] a)  ; source slot (materialized)
          (mut gp) 0
          (mut fp) 0
          (mut stk) 0]
      ; classify every arg
      (let [(mut i) 0]
        (loop (if (>= (load i) nargs)
                  (break)
                  (do
                    (let [av (get (load avs) (load i))
                          t (primitive/alloc-stack Type)]
                      (set! t (av-ty av))
                      (let [vararg (>= (load i) nparams)
                            info (g-abi-info g t)
                            cls (abi-cls info)]
                        (cond vararg  ; Apple variadic: every anonymous arg goes on the stack (8B granule)
                                (if (>= cls (primitive/cast i64 2))
                                    (if (= cls (primitive/cast i64 4))
                                        (cga-fail "struct-by-value in a variadic slot is unsupported")
                                        (do
                                          (push! (mut pkind) 3)
                                          (store! stk
                                                  (primitive/imul (primitive/idiv (primitive/iadd (load stk) 7) 8) 8))
                                          (push! (mut pa) (load stk))
                                          (push! (mut pslot) (av-slot! g av))
                                          (store! stk
                                                  (primitive/iadd (load stk)
                                                                  (primitive/imul (primitive/idiv (primitive/iadd (ty-size g
                                                                                                                           t)
                                                                                                                  7)
                                                                                                  8)
                                                                                  8)))
                                          0))
                                    (do
                                      (push! (mut pkind) 3)
                                      (store! stk (primitive/imul (primitive/idiv (primitive/iadd (load stk) 7) 8) 8))
                                      (push! (mut pa) (load stk))
                                      (push! (mut pslot) (av-slot! g av))
                                      (store! stk (primitive/iadd (load stk) 8))
                                      0))
                              (= cls (primitive/cast i64 0))
                                (if (< (load gp) (primitive/cast i64 8))
                                    (do
                                      (push! (mut pkind) 0)
                                      (push! (mut pa) (load gp))
                                      (push! (mut pslot) (av-slot! g av))
                                      (store! gp (primitive/iadd (load gp) 1))
                                      0)
                                    (do
                                      (push! (mut pkind) 3)
                                      (store! stk (primitive/imul (primitive/idiv (primitive/iadd (load stk) 7) 8) 8))
                                      (push! (mut pa) (load stk))
                                      (push! (mut pslot) (av-slot! g av))
                                      (store! stk (primitive/iadd (load stk) 8))
                                      0))
                              (= cls (primitive/cast i64 1))
                                (if (< (load fp) (primitive/cast i64 8))
                                    (do
                                      (push! (mut pkind) 1)
                                      (push! (mut pa) (load fp))
                                      (push! (mut pslot) (av-slot! g av))
                                      (store! fp (primitive/iadd (load fp) 1))
                                      0)
                                    (do
                                      (push! (mut pkind) 3)
                                      (store! stk (primitive/imul (primitive/idiv (primitive/iadd (load stk) 7) 8) 8))
                                      (push! (mut pa) (load stk))
                                      (push! (mut pslot) (av-slot! g av))
                                      (store! stk (primitive/iadd (load stk) 8))
                                      0))
                              (= cls (primitive/cast i64 2))
                                (if (< (load gp) (primitive/cast i64 8))
                                    (do
                                      (push! (mut pkind) 0)
                                      (push! (mut pa) (load gp))
                                      (push! (mut pslot) (av-slot! g av))
                                      (store! gp (primitive/iadd (load gp) 1))
                                      0)
                                    (do
                                      (push! (mut pkind) 3)
                                      (store! stk (primitive/imul (primitive/idiv (primitive/iadd (load stk) 7) 8) 8))
                                      (push! (mut pa) (load stk))
                                      (push! (mut pslot) (av-slot! g av))
                                      (store! stk (primitive/iadd (load stk) 8))
                                      0))
                              (= cls (primitive/cast i64 3))
                                (if (<= (load gp) (primitive/cast i64 6))
                                    (do
                                      (push! (mut pkind) 2)
                                      (push! (mut pa) (load gp))
                                      (push! (mut pslot) (av-slot! g av))
                                      (store! gp (primitive/iadd (load gp) 2))
                                      0)
                                    (do
                                      (push! (mut pkind) 3)
                                      (store! stk
                                              (primitive/imul (primitive/idiv (primitive/iadd (load stk) 15) 16) 16))
                                      (push! (mut pa) (load stk))
                                      (push! (mut pslot) (av-slot! g av))
                                      (store! stk (primitive/iadd (load stk) 16))
                                      (store! gp 8)
                                      0))
                              (= cls (primitive/cast i64 5))
                                (if (<= (primitive/iadd (load fp) (abi-hfa-n info)) (primitive/cast i64 8))
                                    (do
                                      (push! (mut pkind) 5)
                                      (push! (mut pa)
                                             (primitive/ior (primitive/ishl (abi-hfa-n info) 8)
                                                            (primitive/ior (primitive/ishl (abi-hfa-bits info) 16)
                                                                           (load fp))))
                                      (push! (mut pslot) (av-slot! g av))
                                      (store! fp (primitive/iadd (load fp) (abi-hfa-n info)))
                                      0)
                                    (do
                                      (push! (mut pkind) 3)
                                      (store! stk (primitive/imul (primitive/idiv (primitive/iadd (load stk) 7) 8) 8))
                                      (push! (mut pa) (load stk))
                                      (push! (mut pslot) (av-slot! g av))
                                      (store! stk
                                              (primitive/iadd (load stk)
                                                              (primitive/imul (primitive/idiv (primitive/iadd (ty-size g
                                                                                                                       t)
                                                                                                              7)
                                                                                              8)
                                                                              8)))
                                      (store! fp 8)
                                      0))
                              :else  ; cls 4: indirect — copy to a fresh slot, pass its address
                                (let [sz (ty-size g t)
                                      cp (slot-new! g sz (ty-align g t))]
                                  (emit-copy! g cp (av-slot! g av) sz)
                                  (if (< (load gp) (primitive/cast i64 8))
                                      (do
                                        (push! (mut pkind) 4)
                                        (push! (mut pa) (load gp))
                                        (push! (mut pslot) cp)
                                        (store! gp (primitive/iadd (load gp) 1))
                                        0)
                                      (do
                                        (push! (mut pkind) 6)
                                        (store! stk (primitive/imul (primitive/idiv (primitive/iadd (load stk) 7) 8) 8))
                                        (push! (mut pa) (load stk))
                                        (push! (mut pslot) cp)
                                        (store! stk (primitive/iadd (load stk) 8))
                                        0)))))
                      (set! i (primitive/iadd (load i) 1))))))
        ; grow the outgoing-args area
        (let [stk16 (primitive/imul (primitive/idiv (primitive/iadd (load stk) 15) 16) 16)]
          (when (> stk16 (load (field g outbytes)))
            (store! (field g
                           outbytes)
                    stk16)
            0))
        ; ---- execute the plan: stack args first (x9 scratch), then registers
        (let [(mut i) 0]
          (loop (if (>= (load i) nargs)
                    (break)
                    (do
                      (let [k (get (load pkind) (load i))
                            off (get (load pa) (load i))
                            slot (get (load pslot) (load i))
                            av (get (load avs) (load i))
                            t (primitive/alloc-stack Type)]
                        (set! t (av-ty av))
                        (if (= k (primitive/cast i64 3))
                            ; stack: copy ty-size bytes (scalars: one word) to [sp+off]
                            (let [sz (ty-size g t)]
                              (if (<= sz (primitive/cast i64 8))
                                  (do
                                    (emit-load-int! g 9 28 slot sz false)
                                    (a64-w! (mut s) (a64-str-x 9 31 off))
                                    0)
                                  ; aggregate on stack: word-copy slot -> [sp+off..]
                                  (let [(mut kk) 0]
                                    (loop (if (>= (load kk) sz)
                                              (break)
                                              (do
                                                (emit-load-int! g 9 28 (primitive/iadd slot (load kk)) 8 false)
                                                (a64-w! (mut s) (a64-str-x 9 31 (primitive/iadd off (load kk))))
                                                (set! kk (primitive/iadd (load kk) 8)))))
                                    0)))
                            (when (= k (primitive/cast i64 6))
                              (emit-slot-addr! g 9 slot)
                              (a64-w! (mut s) (a64-str-x 9 31 off))
                              0)))
                      (set! i (primitive/iadd (load i) 1))))))
        ; register args (loaded last so scratch use above cannot clobber them)
        (let [(mut i) 0]
          (loop (if (>= (load i) nargs)
                    (break)
                    (do
                      (let [k (get (load pkind) (load i))
                            n (get (load pa) (load i))
                            slot (get (load pslot) (load i))
                            av (get (load avs) (load i))
                            t (primitive/alloc-stack Type)]
                        (set! t (av-ty av))
                        (cond (= k (primitive/cast i64 0))
                                (let [bytes (primitive/alloc-stack i64)
                                      signed (primitive/alloc-stack bool)]
                                  (ty-int-info g t bytes signed)
                                  (if (ty-is-scalar t)
                                      (emit-load-int! g n 28 slot (load bytes) (load signed))
                                      ; cls-2 aggregate in one x reg: load its (<=8) bytes
                                      (emit-load-int! g n 28 slot (ty-size g t) false)))
                              (= k (primitive/cast i64 1)) (emit-load-fp! g n 28 slot (ty-float-bytes t))
                              (= k (primitive/cast i64 2))
                                (do
                                  (emit-load-int! g n 28 slot 8 false)
                                  (let [rem (primitive/isub (ty-size g t) 8)]
                                    (emit-load-int! g
                                                    (primitive/iadd n 1)
                                                    28
                                                    (primitive/iadd slot 8)
                                                    (if (>= rem
                                                            (primitive/cast i64
                                                                            8))
                                                        8
                                                        rem)
                                                    false))
                                  0)
                              (= k (primitive/cast i64 4)) (emit-slot-addr! g n slot)
                              (= k (primitive/cast i64 5))
                                (let [hn (primitive/iand (primitive/ishr n 8) 255)
                                      bits (primitive/iand (primitive/ishr n 16) 255)
                                      base (primitive/iand n 255)
                                      lb (primitive/idiv bits 8)
                                      (mut j) 0]
                                  (loop (if (>= (load j) hn)
                                            (break)
                                            (do
                                              (emit-load-fp! g
                                                             (primitive/iadd base (load j))
                                                             28
                                                             (primitive/iadd slot (primitive/imul (load j) lb))
                                                             lb)
                                              (store! j (primitive/iadd (load j) 1)))))
                                  0)
                              :else 0))
                      (set! i (primitive/iadd (load i) 1))))))
        ; sret pointer in x8
        (when (= (abi-cls retinfo) (primitive/cast i64 4)) (emit-slot-addr! g 8 resslot) 0)
        ; ---- the call
        (if (>= symidx (primitive/cast i64 0))
            (do
              (mobj-add-reloc! (mut (.obj g))
                               (.text g)
                               (a64-off (mut s))
                               symidx
                               (reloc-branch26)
                               true
                               2)
              (a64-w! (mut s) (a64-bl-raw))
              0)
            (do
              (av-to-x! g (load fpav) 17)
              (a64-w! (mut s) (a64-blr 17))
              0))
        ; ---- result
        (if retvoid
            (mk-aval 0 0 (TInt 64 true))
            (let [cls (abi-cls retinfo)]
              (cond (= cls (primitive/cast i64 0))
                      (do
                        (emit-store-int! g 0 28 resslot (ty-size g retp))
                        (mk-aval 1 resslot ret))
                    (= cls (primitive/cast i64 1))
                      (do
                        (emit-store-fp! g 0 28 resslot (ty-float-bytes retp))
                        (mk-aval 1 resslot ret))
                    (= cls (primitive/cast i64 2))
                      (do
                        (emit-store-int! g 0 28 resslot (ty-size g retp))
                        (mk-aval 1 resslot ret))
                    (= cls (primitive/cast i64 3))
                      (do
                        (emit-store-int! g 0 28 resslot 8)
                        (let [rem (primitive/isub (ty-size g retp) 8)]
                          (emit-store-int! g 1 28 (primitive/iadd resslot 8) (if (>= rem (primitive/cast i64 8)) 8 rem)))
                        (mk-aval 1 resslot ret))
                    (= cls (primitive/cast i64 5))
                      (let [hn (abi-hfa-n retinfo)
                            lb (primitive/idiv (abi-hfa-bits retinfo) 8)
                            (mut j) 0]
                        (loop (if (>= (load j) hn)
                                  (break)
                                  (do
                                    (emit-store-fp! g
                                                    (load j)
                                                    28
                                                    (primitive/iadd resslot (primitive/imul (load j) lb))
                                                    lb)
                                    (store! j (primitive/iadd (load j) 1)))))
                        (mk-aval 1 resslot ret))
                    :else  ; cls 4: already written through x8
                      (mk-aval 1 resslot ret))))))))

; ============================ globals / strings ==============================
; intern an EStr/ECStr payload as a private const-section global; returns symidx.
; `nul` appends a trailing NUL (ECStr); EStr arrays are exactly the bytes.
(defn g-intern-str! [(g (ptr Cga)) (sv (slice u8)) (nul bool)] (-> i64)
  ; dedup exact (content, nul) pairs via a name prefix in the intern list
  (let [n (len (.strs g))
        (mut i) 0
        (mut found) -1]
    (loop (if (>= (load i) n)
              (break)
              (do
                (let [e (al-at [GStr] (field g strs) (load i))]
                  ; entries are stored with a 1-byte kind prefix (0=str,1=cstr)
                  (let [es (.s e)]
                    (when (and (= (primitive/cast i64 (get es 0)) (if nul (do 1) 0))
                               (= (subslice es 1 (len es)) sv))
                      (store! found (load (field e symidx)))
                      0)))
                (set! i (primitive/iadd (load i) 1)))))
    (if (>= (load found) (primitive/cast i64 0))
        (load found)
        (let [a (.a g)
              buf (mobj-sect-buf (mut (.obj g)) (.constsec g))
              off (len (load buf))
              nm (sconcat a (if nul "l_cstr." "l_str.") (i64->str a (.nglob g)))]
          (set! (.nglob g) (primitive/iadd (.nglob g) 1))
          (b-bytes! (mut buf) sv)
          (when nul (b-u8! (mut buf) 0))
          (let [sym (mobj-add-sym! (mut (.obj g)) nm (.constsec g) off false)
                e (primitive/alloc-stack GStr)
                (mut tagged) (sb-new a)]
            (sb-push-byte! (mut tagged) (primitive/cast u8 (when nul 1)))
            (sb-push-str! (mut tagged) sv)
            (set! (.s e) (sb-str (load tagged)))
            (set! (.symidx e) sym)
            (push! (mut (.strs g)) (load e))
            sym)))))

; a zero-initialized global in __data; returns symidx.
(defn g-zero-global! [(g (ptr Cga)) (size i64) (align i64)] (-> i64)
  (let [a (.a g)
        buf (mobj-sect-buf (mut (.obj g)) (.datasec g))]
    (b-align! (mut buf) (if (< align (primitive/cast i64 8)) 8 align))
    (let [off (len (load buf))
          nm
            (sconcat a
                     "repl_static."
                     (sconcat a
                              (.selfname g)
                              (sconcat a "." (i64->str a (.nstatic g)))))]
      (set! (.nglob g) (primitive/iadd (.nglob g) 1))
      (set! (.nstatic g) (primitive/iadd (.nstatic g) 1))
      (b-zeros! (mut buf) size)
      (mobj-add-sym! (mut (.obj g)) nm (.datasec g) off false))))

(defn g-named-zero-global! [(g (ptr Cga)) (name (slice u8)) (size i64) (align i64)] (-> i64)
  (let [buf (mobj-sect-buf (mut (.obj g)) (.datasec g))]
    (b-align! (mut buf) (if (< align (primitive/cast i64 8)) 8 align))
    (let [off (len (load buf))]
      (b-zeros! (mut buf) size)
      (mobj-add-sym! (mut (.obj g)) name (.datasec g) off false))))

(defn g-static-idx [(g (ptr Cga)) (name (slice u8))] (-> i64)
  (let [n (len (.statics g))
        (mut i) 0
        (mut found) -1]
    (loop (if (or (>= (load i) n) (>= (load found) 0))
              (break)
              (do
                (when (= (.name (al-at [GStatic] (field g statics) (load i))) name)
                  (set! found (load i))
                  0)
                (set! i (primitive/iadd (load i) 1)))))
    (load found)))

(defn g-static-write! [(g (ptr Cga)) (t (ptr Type)) (e (ptr Expr)) (off i64)] (-> i64)
  (let [buf (mobj-sect-buf (mut (.obj g)) (.datasec g))]
    (match (.kind e)
      (EInt [n]
            (let [sz (ty-size g t)]
              (cond (= sz 1) (set! (mut buf) off (primitive/cast u8 n))
                    (= sz 2)
                      (do
                        (set! (mut buf) off (primitive/cast u8 n))
                        (set! (mut buf) (primitive/iadd off 1) (primitive/cast u8 (primitive/ishr n 8)))
                        0)
                    (= sz 4) (b-patch-u32! (mut buf) off n)
                    :else (b-patch-u64! (mut buf) off n))))
      (EBool [v] (set! (mut buf) off (primitive/cast u8 (when v 1))))
      (EZeroed [_] 0)
      (EFnPtrOf [name]
                (let [si (g-sig-idx g name)]
                  (when (< si 0) (cga-fail2 "def initializer: unknown function " name))
                  (mobj-add-reloc! (mut (.obj g))
                                   (.datasec g)
                                   off
                                   (.symidx (al-at [GSig] (field g sigs) si))
                                   (reloc-unsigned)
                                   false
                                   3)))
      (EAlloc [storage ty init]
              (if (!= storage 1)
                  (cga-fail "def initializer: only alloc-static storage is a link-time constant")
                  (let [tp (box-type (.a g) ty)
                        sym (g-zero-global! g (ty-size g tp) (ty-align g tp))
                        ms (al-at [MSym] (field (field g obj) syms) sym)]
                    (when (!= (primitive/cast i64 init) 0)
                      (g-static-write! g tp init (.off ms))
                      0)
                    (mobj-add-reloc! (mut (.obj g)) (.datasec g) off sym (reloc-unsigned) false 3))))
      (ECast [_ inner] (g-static-write! g t inner off))
      (ELoad [inner] (g-static-write! g t inner off))
      (ELet [_ body]
            (match (load t)
              (TStruct [name]
                       (let [si (g-struct-idx g name)]
                         (when (< si 0) (cga-fail2 "def initializer: unknown struct " name))
                         (for [i 0 (len (load body))]
                           (match (.kind (al-at [Expr] body i))
                             (EInitStore [place value]
                                         (match (.kind place)
                                           (EField [_ fname]
                                                   (let [fi (g-field-idx g si fname)]
                                                     (when (< fi 0)
                                                       (cga-fail2 "def initializer: unknown field " fname))
                                                     (g-static-write! g
                                                                      (g-field-ty g si fi)
                                                                      value
                                                                      (primitive/iadd off (g-field-off g si fi)))))
                                           (_ 0)))
                             (_ 0)))
                         0))
              (TArray [elem count]
                      (do
                        (for [i 0 (len (load body))]
                          (match (.kind (al-at [Expr] body i))
                            (EStore [place value]
                                    (match (.kind place)
                                      (EIndex [_ index]
                                              (match (.kind index)
                                                (EInt [item]
                                                      (if (or (< item 0) (>= item count))
                                                          (cga-fail "alloc-static initializer: array index is out of bounds")
                                                          (g-static-write! g
                                                                           elem
                                                                           value
                                                                           (primitive/iadd off
                                                                                           (primitive/imul item
                                                                                                           (ty-size g elem))))))
                                                (_ (cga-fail "alloc-static initializer: array index is not constant"))))
                                      (_ 0)))
                            (_ 0)))
                        0))
              (_ (cga-fail "def initializer: materialized aggregate has the wrong type"))))
      (_ (cga-fail "def initializer is not a link-time constant")))))

(defn g-declare-statics! [(g (ptr Cga)) (p (ptr Program))] (-> i64)
  (let [cs (load (field p consts))]
    (for [i 0 (len (load cs))]
      (let [cp (al-elem [Const] cs i)]
        (when (.runtime cp)
          (match (.ty cp)
            (None [] (cga-fail "internal: checked def has no type"))
            (Some [ty]
                  (let [tp (box-type (.a g) ty)
                        sym (g-named-zero-global! g
                                                  (sconcat (.a g) "coil_def." (.name cp))
                                                  (ty-size g tp)
                                                  (ty-align g tp))
                        st (primitive/alloc-stack GStatic)]
                    (set! (.name st) (.name cp))
                    (set! (.ty st) ty)
                    (set! (.symidx st) sym)
                    (push! (mut (.statics g)) (load st))
                    (let [ms (al-at [MSym] (field (field g obj) syms) sym)]
                      ; Include the concrete outer type in nested alloc-static
                      ; identity. A full-source replacement may legally change a
                      ; def's signature; its new Var must not reuse the old
                      ; signature's cell merely because the public name matches.
                      (set! (.selfname g)
                            (match ty
                              (TStruct [tn] (sconcat (.a g) (.name cp) (sconcat (.a g) "." tn)))
                              (_ (.name cp))))
                      (set! (.nstatic g) 0)
                      (g-static-write! g tp (field cp value) (.off ms))))))
          0)))
    0))

; reg = address of symbol (adrp+add with PAGE21/PAGEOFF12 relocs)
(defn emit-sym-addr! [(g (ptr Cga)) (reg i64) (symidx i64)] (-> i64)
  (let [s (field g asm)]
    (let [sym (al-at [MSym] (field (field g obj) syms) symidx)]
      (if (or (= (.sect sym) (primitive/cast i64 0))
              (starts-with (.name sym) "repl_static."))
          (do
            ; Undefined symbols and persistent reload cells are addressed through
            ; a GOT slot.  Besides satisfying ld for dylib symbols, this keeps a
            ; new JIT image's ADRP local even when the stable cell itself belongs
            ; to an older mapping more than 4 GiB away.
            (mobj-add-reloc! (mut (.obj g)) (.text g) (a64-off (mut s)) symidx (reloc-got-load-page21) true 2)
            (a64-w! (mut s) (a64-adrp reg))
            (mobj-add-reloc! (mut (.obj g)) (.text g) (a64-off (mut s)) symidx (reloc-got-load-pageoff12) false 2)
            (a64-w! (mut s) (a64-ldr-x reg reg 0)))
          (do
            (mobj-add-reloc! (mut (.obj g)) (.text g) (a64-off (mut s)) symidx (reloc-page21) true 2)
            (a64-w! (mut s) (a64-adrp reg))
            (mobj-add-reloc! (mut (.obj g)) (.text g) (a64-off (mut s)) symidx (reloc-pageoff12) false 2)
            (a64-w! (mut s) (a64-add-imm reg reg 0)))))
    0))

; store an AVal into a slot (any type).
(defn emit-store-av! [(g (ptr Cga)) (av AVal) (dst i64)] (-> i64)
  (let [t (primitive/alloc-stack Type)]
    (set! t (av-ty av))
    (if (ty-is-scalar t)
        (do
          (av-to-x! g av 9)
          (emit-store-int! g 9 28 dst (ty-size g t))
          0)
        (emit-copy! g dst (av-slot! g av) (ty-size g t)))))

; pointee type of a TPtr/TRef value
(defn ty-pointee [(t (ptr Type))] (-> Type)
  (match (load t)
    (TPtr [inner] (load inner))
    (TRef [_m inner] (load inner))
    (_ (do (cga-fail "load/store through a non-pointer") (TInt 64 true)))))

; ============================ expression emission ============================
(defn emit-body [(g (ptr Cga)) (body (ptr (ArrayList Expr)))] (-> AVal)
  (let [n (len (load body))
        (mut i) 0
        (mut last) (mk-aval 0 0 (TInt 64 true))]
    (loop (if (>= (load i) n)
              (break)
              (do
                (when (load (field g terminated)) (break))
                (set! last (emit-expr g (al-at [Expr] body (load i))))
                (set! i (primitive/iadd (load i) 1)))))
    (load last)))

; The function body: identical to emit-body except the LAST expression is emitted in
; TAIL position. Only the function body may start a tail chain — a `do` in argument
; position ends in a value that its caller still consumes.
(defn emit-body-tail [(g (ptr Cga)) (body (ptr (ArrayList Expr)))] (-> AVal)
  (let [n (len (load body))
        (mut i) 0
        (mut last) (mk-aval 0 0 (TInt 64 true))]
    (loop (if (>= (load i) n)
              (break)
              (do
                (when (load (field g terminated)) (break))
                (when (= (load i) (primitive/isub n 1)) (store! (field g tailok) true) 0)
                (set! last (emit-expr g (al-at [Expr] body (load i))))
                (set! i (primitive/iadd (load i) 1)))))
    (load last)))

(defn emit-binds [(g (ptr Cga)) (binds (ptr (ArrayList Bind)))] (-> i64)
  (let [n (len (load binds))
        (mut i) 0
        (mut a) (.a g)]
    (loop (if (>= (load i) n)
              (break)
              (do
                (let [b (al-at [Bind] binds (load i))
                      av (emit-expr g (field b value))]
                  (if (.mutable b)
                      ; mutable: give the value a stable slot and bind the NAME to a
                      ; pointer to it (the checker reads it via (primitive/load name)).
                      (let [t (primitive/alloc-stack Type)]
                        (set! t (av-ty av))
                        (let [vslot (av-slot! g av)
                              pslot (slot-new! g 8 8)]
                          (emit-slot-addr! g 9 vslot)
                          (emit-store-int! g 9 28 pslot 8)
                          (dw-note-var! g
                                        (.name b)
                                        t
                                        pslot
                                        true
                                        false
                                        (.source (.value b))
                                        (.lo (.value b)))
                          (set! (.env g)
                                (gscope-put (load a)
                                            (load (field g env))
                                            (.name b)
                                            (mk-aval 1 pslot (TPtr (box-type (load a) (av-ty av))))))
                          0))
                      (do
                        (when (= (av-kind av) (primitive/cast i64 1))
                          (dw-note-bind! g
                                         (load (field b name))
                                         av
                                         (load (field (field b value) source))
                                         (load (field (field b value) lo))))
                        (set! (.env g)
                              (gscope-put (load a)
                                          (load (field g env))
                                          (.name b)
                                          av))
                        0)))
                (set! i (primitive/iadd (load i) 1))))))
  0)

(defn emit-stmts [(g (ptr Cga)) (body (ptr (ArrayList Expr)))] (-> i64)
  (let [n (len (load body))
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (when (load (field g terminated)) (break))
                (emit-expr g (al-at [Expr] body (load i)))
                (set! i (primitive/iadd (load i) 1))))))
  0)

; find the target loop index (labeled search from innermost, else innermost).
(defn g-loop-index [(g (ptr Cga)) (label (Option (slice u8)))] (-> i64)
  (let [n (len (.loops g))]
    (match label
      (None []
            (do
              (when (= n (primitive/cast i64 0)) (cga-fail "break/continue outside a loop"))
              (primitive/isub n 1)))
      (Some [want]
            (let [(mut i) (primitive/isub n 1)
                  (mut r) -1]
              (loop (if (< (load i) (primitive/cast i64 0))
                        (break)
                        (do
                          (match (.label (al-at [GLoop] (field g loops) (load i)))
                            (None [] 0)
                            (Some [have]
                                  (when (and (< (load r) (primitive/cast i64 0)) (= have want)) (store! r (load i)) 0)))
                          (set! i (primitive/isub (load i) 1)))))
              (when (< (load r) (primitive/cast i64 0)) (cga-fail2 "no such loop label: " want))
              (load r))))))

; TAIL POSITION is CONSUMED here. Every entry to emit-expr clears the flag into a
; local, so a construct that does not explicitly re-arm it cannot leak tail-ness to
; its children — the failure that would matter (compiling a NON-tail call as a jump)
; is structurally impossible rather than a thing to remember. `if` re-arms it for its
; two branches, which is the only propagation the reported case needs.
(defn emit-expr [(g (ptr Cga)) (e (ptr Expr))] (-> AVal)
  (dw-note-span! g e)
  (let [am-tail (.tailok g)]
    (set! (.tailok g) false)
    (match (.kind e)
      (EIf [cnd thn els] (emit-if-tail g cnd thn els am-tail))
      (ECall [func targs args]
             (if (and am-tail (tail-self-callable? g func args))
                 (emit-tail-self-call! g args)
                 (emit-call-named g func args)))
      (_ (emit-expr-rest g e)))))

(defn emit-expr-rest [(g (ptr Cga)) (e (ptr Expr))] (-> AVal)
  (match (.kind e)
    (EAnonFn [_ _] (do (abort) (primitive/zeroed AVal)))
    (EInt [v] (mk-aval 0 v (TInt 64 true)))
    (EFloat [bits] (mk-aval 2 bits (TFloat 64)))
    (EBool [b] (mk-aval 0 (when b 1) (TBool)))
    (EStr [sv]
          (let [sym (g-intern-str! g sv true)  ; NUL-terminate the backing bytes (slice len below is separate)
                a (.a g)
                slot (slot-new! g 16 8)]
            (emit-sym-addr! g 9 sym)
            (emit-store-int! g 9 28 slot 8)
            (a64-mov-imm! (mut (.asm g)) 9 (len sv))
            (emit-store-int! g 9 28 (primitive/iadd slot 8) 8)
            (mk-aval 1 slot (TSlice (box-type a (TInt 8 false))))))
    (ECStr [sv]
           (let [sym (g-intern-str! g sv true)
                 a (.a g)
                 slot (slot-new! g 8 8)]
             (emit-sym-addr! g 9 sym)
             (emit-store-int! g 9 28 slot 8)
             (mk-aval 1 slot (TPtr (box-type a (TInt 8 true))))))
    (EVar [name]
          (match (gscope-get (load (field g env)) name)
            (Some [av] av)
            (None [] (do (cga-fail2 "unbound variable: " name) (mk-aval 0 0 (TInt 64 true))))))
    (EZeroed [t]
             (let [tp (primitive/alloc-stack Type)]
               (set! tp t)
               (let [slot (slot-for-ty! g tp)]
                 (emit-zero! g slot (ty-size g tp))
                 (mk-aval 1 slot t))))
    (EBorrow [_m place] (emit-expr g place))
    (ESpillRef [inner]
               (let [av (emit-expr g inner)
                     a (.a g)
                     vslot (av-slot! g av)
                     pslot (slot-new! g 8 8)]
                 (emit-slot-addr! g 9 vslot)
                 (emit-store-int! g 9 28 pslot 8)
                 (mk-aval 1 pslot (TPtr (box-type a (av-ty av))))))
    (EMovePlace [_]
                (do
                  (cga-fail "EMovePlace survived monomorphization (compiler bug)")
                  (mk-aval 0 0 (TInt 64 true))))
    (ELet [binds body]
          (let [saved (load (field g env))]
            (emit-binds g binds)
            (let [r (emit-body g body)]
              (set! (.env g) saved)
              r)))
    (EDo [body] (emit-body g body))
    (ECleanup [body cleanups]
              (let [result (emit-expr g body)]
                (emit-body g cleanups)
                result))
    (EBin [op lhs rhs] (emit-bin g op lhs rhs))
    (ECmp [op lhs rhs] (emit-cmp g op lhs rhs))
    (EIntUnary [op inner] (emit-int-unary g op inner))
    (EIf [cnd thn els] (emit-if g cnd thn els))
    (ELoop [label body] (emit-loop g label body))
    (EBreak [label value] (emit-break g label value))
    (EContinue [label]
               (do
                 (let [li (g-loop-index g label)]
                   (a64-b-label! (mut (.asm g))
                                 (.contlabel (al-at [GLoop]
                                                    (field g
                                                           loops)
                                                    li)))
                   (set! (.terminated g) true))
                 (mk-aval 0 0 (TInt 64 true))))
    (ECall [func _targs args] (emit-call-named g func args))
    (ENamedCall [_func _targs _names _args]
                (do
                  (cga-fail "named constructor call survived type checking")
                  (mk-aval 0 0 (TInt 64 true))))
    (ECallPtr [fp args]
              (let [fpav (primitive/alloc-stack AVal)]
                (set! fpav (emit-expr g fp))
                (let [t (primitive/alloc-stack Type)]
                  (set! t (av-ty (load fpav)))
                  (match (load t)
                    (TFn [_cc params ret]
                         (let [(mut avs) (al-new [AVal] (.a g))
                               n (len (load args))
                               (mut i) 0]
                           (loop (if (>= (load i) n)
                                     (break)
                                     (do
                                       (push! (mut avs) (emit-expr g (al-at [Expr] args (load i))))
                                       (set! i (primitive/iadd (load i) 1)))))
                           (emit-call! g
                                       -1
                                       fpav
                                       params
                                       false
                                       (load ret)
                                       (box-al [AVal] (.a g) (load avs)))))
                    (_ (do
                         (cga-fail "call-ptr on non-fnptr value")
                         (mk-aval 0 0 (TInt 64 true))))))))
    (EAlloc [storage t init]
            (let [a (.a g)
                  tp (primitive/alloc-stack Type)]
              (set! tp t)
              (if (or (= storage (primitive/cast i64 0)) (= storage (primitive/cast i64 3)))
                  ; stack: a per-function-execution frame slot
                  (let [slot (slot-for-ty! g tp)
                        pslot (slot-new! g 8 8)]
                    (emit-slot-addr! g 9 slot)
                    (emit-store-int! g 9 28 pslot 8)
                    (mk-aval 1 pslot (TPtr (box-type a t))))
                  (if (= storage (primitive/cast i64 2))
                      ; heap: call malloc(size)
                      (let [msym (g-runtime-sym! g "_malloc")
                            slot (slot-new! g 8 8)]
                        (a64-mov-imm! (mut (.asm g)) 0 (ty-size g tp))
                        (mobj-add-reloc! (mut (.obj g))
                                         (.text g)
                                         (a64-off (mut (.asm g)))
                                         msym
                                         (reloc-branch26)
                                         true
                                         2)
                        (a64-w! (mut (.asm g)) (a64-bl-raw))
                        (emit-store-int! g 0 28 slot 8)
                        (mk-aval 1 slot (TPtr (box-type a t))))
                      ; static: one persistent data symbol per allocation site.
                      ; The checked initializer is a link-time constant; use the
                      ; same aggregate/relocation writer as top-level definitions.
                      (let [sym (g-zero-global! g (ty-size g tp) (ty-align g tp))
                            ms (al-at [MSym] (field (field g obj) syms) sym)
                            pslot (slot-new! g 8 8)]
                        (when (!= (primitive/cast i64 init) 0)
                          (g-static-write! g tp init (.off ms))
                          0)
                        (emit-sym-addr! g 9 sym)
                        (emit-store-int! g 9 28 pslot 8)
                        (mk-aval 1 pslot (TPtr (box-type a t))))))))
    (EAccessorField [p fname]
                    (emit-expr g
                               (box-expr (.a g)
                                         (mk-expr (EField p fname) (.lo e) (.hi e) (.source e) (.ctxt e)))))
    (EField [p fname]
            (let [av (emit-expr g p)
                  a (.a g)
                  t (primitive/alloc-stack Type)]
              (set! t (av-ty av))
              (let [pt (primitive/alloc-stack Type)]
                (set! pt (ty-pointee t))
                (match (load pt)
                  (TStruct [nm]
                           (let [si (g-struct-idx g nm)]
                             (when (< si (primitive/cast i64 0)) (cga-fail2 "field access on non-struct: " nm))
                             (let [fi (g-field-idx g si fname)
                                   off (g-field-off g si fi)
                                   fty
                                     (.ty (al-at [Field]
                                                 (load (field (struct-at (field g
                                                                                layouts)
                                                                         si)
                                                              fields))
                                                 fi))
                                   slot (slot-new! g 8 8)]
                               (av-to-x! g av 9)
                               (if (<= off (primitive/cast i64 4095))
                                   (a64-w! (mut (.asm g)) (a64-add-imm 9 9 off))
                                   (do
                                     (a64-mov-imm! (mut (.asm g)) 10 off)
                                     (a64-w! (mut (.asm g)) (a64-add-reg 9 9 10))
                                     0))
                               (emit-store-int! g 9 28 slot 8)
                               (mk-aval 1 slot (TPtr (box-type a fty))))))
                  (_ (do
                       (cga-fail "field access through non-struct pointer")
                       (mk-aval 0 0 (TInt 64 true))))))))
    (ELoad [inner]
           (let [av (emit-expr g inner)
                 a (.a g)
                 t (primitive/alloc-stack Type)]
             (set! t (av-ty av))
             (let [pt (primitive/alloc-stack Type)]
               (set! pt (ty-pointee t))
               (let [sz (ty-size g pt)
                     slot (slot-for-ty! g pt)]
                 (av-to-x! g av 9)
                 (if (<= sz (primitive/cast i64 8))
                     (do
                       (emit-load-from-mem! g 10 9 sz)
                       (emit-store-int! g 10 28 slot sz)
                       0)
                     (emit-copy-from-mem! g slot 9 sz))
                 (mk-aval 1 slot (load pt))))))
    (EStore [p val]
            (let [pav (emit-expr g p)
                  vav (emit-expr g val)
                  t (primitive/alloc-stack Type)]
              (set! t (av-ty vav))
              (let [sz (ty-size g t)]
                (if (ty-is-scalar t)
                    (do
                      (av-to-x! g vav 10)
                      (av-to-x! g pav 9)
                      (emit-store-to-mem! g 10 9 sz)
                      0)
                    (do
                      (av-to-x! g pav 9)
                      (emit-copy-to-mem! g 9 (av-slot! g vav) sz)
                      0))
                ; std-12: store! yields unit (canonical i64 0), matching its checked type.
                (mk-aval 0 0 (TInt 64 true)))))
    (EInitStore [p val]
                (let [pav (emit-expr g p)
                      vav (emit-expr g val)
                      t (primitive/alloc-stack Type)]
                  (set! t (av-ty vav))
                  (let [sz (ty-size g t)]
                    (if (ty-is-scalar t)
                        (do
                          (av-to-x! g vav 10)
                          (av-to-x! g pav 9)
                          (emit-store-to-mem! g 10 9 sz)
                          0)
                        (do
                          (av-to-x! g pav 9)
                          (emit-copy-to-mem! g 9 (av-slot! g vav) sz)
                          0))
                    (mk-aval 0 0 (TInt 64 true)))))
    (EIndex [p idx]
            (let [pav (emit-expr g p)
                  iav (emit-expr g idx)
                  a (.a g)
                  t (primitive/alloc-stack Type)]
              (set! t (av-ty pav))
              (let [pt (primitive/alloc-stack Type)]
                (set! pt (ty-pointee t))
                ; pointer-to-array indexes elements of the array; otherwise the pointee
                (let [ep (primitive/alloc-stack Type)]
                  (match (load pt) (TArray [elem _n] (set! ep (load elem))) (_ (set! ep (load pt))))
                  (let [esz (ty-size g ep)
                        slot (slot-new! g 8 8)]
                    (av-to-x! g pav 9)
                    (av-to-x! g iav 10)
                    (a64-mov-imm! (mut (.asm g)) 11 esz)
                    (a64-w! (mut (.asm g)) (a64-madd 9 10 11 9))
                    (emit-store-int! g 9 28 slot 8)
                    (mk-aval 1 slot (TPtr (box-type a (load ep)))))))))
    (ECast [t inner] (emit-cast g t inner))
    (ESizeOf [t]
             (let [tp (primitive/alloc-stack Type)] (set! tp t) (mk-aval 0 (ty-size g tp) (TInt 64 true))))
    (EAlignOf [t]
              (let [tp (primitive/alloc-stack Type)] (set! tp t) (mk-aval 0 (ty-align g tp) (TInt 64 true))))
    (EOffsetOf [t fname]
               (let [tp (primitive/alloc-stack Type)]
                 (set! tp t)
                 (match t
                   (TStruct [nm]
                            (let [si (g-struct-idx g nm)]
                              (when (< si (primitive/cast i64 0)) (cga-fail2 "offset-of on non-struct: " nm))
                              (mk-aval 0 (g-field-off g si (g-field-idx g si fname)) (TInt 64 true))))
                   (_ (do (cga-fail "offset-of on non-struct type") (mk-aval 0 0 (TInt 64 true)))))))
    (EFree [inner]
           (let [av (emit-expr g inner)
                 fsym (g-runtime-sym! g "_free")]
             (av-to-x! g av 0)
             (mobj-add-reloc! (mut (.obj g))
                              (.text g)
                              (a64-off (mut (.asm g)))
                              fsym
                              (reloc-branch26)
                              true
                              2)
             (a64-w! (mut (.asm g)) (a64-bl-raw))
             (mk-aval 0 0 (TInt 64 true))))
    (EConstruct [sum variant args] (emit-construct g sum variant args))
    (EMatch [scrut arms] (emit-match g scrut arms))
    (EFnPtrOf [name]
              (let [si (g-sig-idx g name)]
                (when (< si (primitive/cast i64 0)) (cga-fail2 "fnptr-of unknown function: " name))
                (let [e (al-at [GSig] (field g sigs) si)
                      slot (slot-new! g 8 8)]
                  (emit-sym-addr! g 9 (.symidx e))
                  (emit-store-int! g 9 28 slot 8)
                  (mk-aval 1
                           slot
                           (TFn
                             :cc "c"
                             :params (load (field e params))
                             :ret
                               (box-type (.a g)
                                         (.ret e)))))))
    (EBitGet [p fname] (emit-bitget g p fname))
    (EBitSet [p fname val] (emit-bitset g p fname val))
    (ELlvmIr [result args body] (emit-llvmir g result args body))
    (EMakeDyn [ds vt methods inner] (emit-make-dyn g ds vt methods inner))
    (EDynDispatch [ds vt mi cc params ret recv args] (emit-dyn-dispatch g ds vt mi cc params ret recv args))
    (EStaticRef [name]
                (let [si (g-static-idx g name)]
                  (if (< si 0)
                      (do
                        (cga-fail2 "static-ref references an unknown def: " name)
                        (mk-aval 0 0 (TInt 64 true)))
                      (let [st (al-at [GStatic] (field g statics) si)
                            slot (slot-new! g 8 8)]
                        (emit-sym-addr! g 9 (.symidx st))
                        (emit-store-int! g 9 28 slot 8)
                        (mk-aval 1 slot (TPtr (box-type (.a g) (.ty st))))))))
    (EErase [_t _i] (do (cga-fail "EErase reached codegen (checker bug)") (mk-aval 0 0 (TInt 64 true))))
    (ETraitCall [_a _b _c _d] (do (cga-fail "ETraitCall reached codegen (mono bug)") (mk-aval 0 0 (TInt 64 true))))
    (EComptime [_] (do (cga-fail "EComptime reached codegen") (mk-aval 0 0 (TInt 64 true))))
    (EAscribe [_t _i]
              (do
                (cga-fail "EAscribe reached codegen (checker should have lowered (: v t) to its coerced value)")
                (mk-aval 0 0 (TInt 64 true))))
    (EArrayLit [_] (do (cga-fail "EArrayLit reached codegen (checker bug)") (mk-aval 0 0 (TInt 64 true))))
    (EMakeSlice [data elem len]
                (let [dv (emit-expr g data)
                      a (.a g)
                      slot (slot-new! g 16 8)]
                  (av-to-x! g dv 9)
                  (emit-store-int! g 9 28 slot 8)
                  (a64-mov-imm! (mut (.asm g)) 9 len)
                  (emit-store-int! g 9 28 (primitive/iadd slot 8) 8)
                  (mk-aval 1 slot (TSlice (box-type a elem)))))
    (ETypeQuery [_q _t] (do (cga-fail "ETypeQuery reached codegen") (mk-aval 0 0 (TInt 64 true))))
    (EFieldMeta [_m _t _i] (do (cga-fail "EFieldMeta reached codegen") (mk-aval 0 0 (TInt 64 true))))
    (EFieldIndex [_t _n] (do (cga-fail "EFieldIndex reached codegen") (mk-aval 0 0 (TInt 64 true))))
    (EQuote [_] (do (cga-fail "EQuote reached codegen") (mk-aval 0 0 (TInt 64 true))))
    (ECodeOp [_o _a] (do (cga-fail "ECodeOp reached codegen") (mk-aval 0 0 (TInt 64 true))))
    (EQuasi [_] (do (cga-fail "EQuasi reached codegen") (mk-aval 0 0 (TInt 64 true))))))

; lazily-declared runtime symbols (malloc/free used by EAlloc heap / EFree).
(defn g-runtime-sym! [(g (ptr Cga)) (nm (slice u8))] (-> i64)
  (let [n (len (.syms (.obj g)))
        (mut i) 0
        (mut r) -1]
    (loop (if (>= (load i) n)
              (break)
              (do
                (when (= (load (field (al-at [MSym] (field (field g obj) syms) (load i)) name)) nm)
                  (store! r (load i)))
                (set! i (primitive/iadd (load i) 1)))))
    (if (>= (load r) (primitive/cast i64 0))
        (load r)
        (mobj-add-sym! (mut (.obj g)) nm 0 0 true))))

; memory load/store with a dynamic address register (widths 1/2/4/8)
(defn emit-load-from-mem! [(g (ptr Cga)) (reg i64) (addrreg i64) (bytes i64)] (-> i64)
  (let [s (field g asm)]
    (cond (= bytes (primitive/cast i64 1)) (a64-w! (mut s) (a64-ldr-b reg addrreg 0))
          (= bytes (primitive/cast i64 2)) (a64-w! (mut s) (a64-ldr-h reg addrreg 0))
          (= bytes (primitive/cast i64 4)) (a64-w! (mut s) (a64-ldr-w reg addrreg 0))
          :else (a64-w! (mut s) (a64-ldr-x reg addrreg 0)))))

(defn emit-store-to-mem! [(g (ptr Cga)) (reg i64) (addrreg i64) (bytes i64)] (-> i64)
  (let [s (field g asm)]
    (cond (= bytes (primitive/cast i64 1)) (a64-w! (mut s) (a64-str-b reg addrreg 0))
          (= bytes (primitive/cast i64 2)) (a64-w! (mut s) (a64-str-h reg addrreg 0))
          (= bytes (primitive/cast i64 4)) (a64-w! (mut s) (a64-str-w reg addrreg 0))
          :else (a64-w! (mut s) (a64-str-x reg addrreg 0)))))

; canonicalize x-reg `reg` to exact iN width semantics (the container invariant:
; slots always hold values sign/zero-extended from bit N-1).
(defn emit-canon-int! [(g (ptr Cga)) (reg i64) (bits i64) (signed bool)] (-> i64)
  (let [s (field g asm)]
    (cond (= bits (primitive/cast i64 64)) 0
          (= bits (primitive/cast i64 8)) (a64-w! (mut s) (if signed (a64-sxtb reg reg) (a64-uxtb reg reg)))
          (= bits (primitive/cast i64 16)) (a64-w! (mut s) (if signed (a64-sxth reg reg) (a64-uxth reg reg)))
          (= bits (primitive/cast i64 32)) (a64-w! (mut s) (if signed (a64-sxtw reg reg) (a64-mov32 reg reg)))
          :else
            (let [sh (primitive/isub 64 bits)]
              (a64-w! (mut s) (a64-lsl-imm reg reg sh))
              (a64-w! (mut s) (if signed (a64-asr-imm reg reg sh) (a64-lsr-imm reg reg sh)))
              0))))

(defn emit-int-unary [(g (ptr Cga)) (op i64) (inner (ptr Expr))] (-> AVal)
  (let [av (emit-expr g inner)
        t (primitive/alloc-stack Type)
        s (field g asm)]
    (set! t (av-ty av))
    (let [bits (match (load t) (TInt [n _] n) (_ 64))]
      (av-to-x! g av 9)
      (if (= op (primitive/cast i64 0))
          (a64-w! (mut s) (a64-mvn-reg 9 9))
          (do
            (emit-canon-int! g 9 bits false)
            (cond (= op (primitive/cast i64 1))
                    (do
                      (a64-w! (mut s) (a64-clz 9 9))
                      (when (< bits (primitive/cast i64 64))
                        (a64-mov-imm! (mut s) 10 (primitive/isub 64 bits))
                        (a64-w! (mut s) (a64-sub-reg 9 9 10))))
                  (= op (primitive/cast i64 2))
                    (do
                      (a64-w! (mut s) (a64-cmp-imm 9 0))
                      (a64-w! (mut s) (a64-rbit 9 9))
                      (a64-w! (mut s) (a64-clz 9 9))
                      (a64-mov-imm! (mut s) 10 bits)
                      (a64-w! (mut s) (a64-csel 9 10 9 0)))
                  (= op (primitive/cast i64 3))
                    (do
                      (a64-w! (mut s) (a64-lsr-imm 10 9 1))
                      (a64-mov-imm! (mut s) 11 0x5555555555555555)
                      (a64-w! (mut s) (a64-and-reg 10 10 11))
                      (a64-w! (mut s) (a64-sub-reg 9 9 10))
                      (a64-mov-imm! (mut s) 11 0x3333333333333333)
                      (a64-w! (mut s) (a64-and-reg 10 9 11))
                      (a64-w! (mut s) (a64-lsr-imm 9 9 2))
                      (a64-w! (mut s) (a64-and-reg 9 9 11))
                      (a64-w! (mut s) (a64-add-reg 9 9 10))
                      (a64-w! (mut s) (a64-lsr-imm 10 9 4))
                      (a64-w! (mut s) (a64-add-reg 9 9 10))
                      (a64-mov-imm! (mut s) 11 0x0f0f0f0f0f0f0f0f)
                      (a64-w! (mut s) (a64-and-reg 9 9 11))
                      (a64-w! (mut s) (a64-lsr-imm 10 9 8))
                      (a64-w! (mut s) (a64-add-reg 9 9 10))
                      (a64-w! (mut s) (a64-lsr-imm 10 9 16))
                      (a64-w! (mut s) (a64-add-reg 9 9 10))
                      (a64-w! (mut s) (a64-lsr-imm 10 9 32))
                      (a64-w! (mut s) (a64-add-reg 9 9 10))
                      (a64-mov-imm! (mut s) 11 127)
                      (a64-w! (mut s) (a64-and-reg 9 9 11)))
                  :else
                    (do
                      (a64-w! (mut s) (a64-rev 9 9))
                      (when (< bits (primitive/cast i64 64))
                        (a64-w! (mut s) (a64-lsr-imm 9 9 (primitive/isub 64 bits))))))))
      (emit-canon-int! g 9 bits (match (load t) (TInt [_ sg] sg) (_ false)))
      (let [slot (slot-for-ty! g t)]
        (emit-store-int! g 9 28 slot (ty-size g t))
        (mk-aval 1 slot (av-ty av))))))

; ---- arithmetic -------------------------------------------------------------
(defn emit-bin [(g (ptr Cga)) (op i64) (lhs (ptr Expr)) (rhs (ptr Expr))] (-> AVal)
  (let [lav (emit-expr g lhs)
        rav (emit-expr g rhs)
        t (primitive/alloc-stack Type)
        s (field g asm)]
    (set! t (av-ty lav))
    (if (ty-is-float t)
        ; float ops: 0 add 1 sub 2 mul 3 div 4 rem(unsupported)
        (let [fb (ty-float-bytes t)
              fty (unless (= fb (primitive/cast i64 4)) 1)]
          (av-to-d! g lav 0)
          (av-to-d! g rav 1)
          (cond (= op (primitive/cast i64 0)) (a64-w! (mut s) (a64-fadd fty 0 0 1))
                (= op (primitive/cast i64 1)) (a64-w! (mut s) (a64-fsub fty 0 0 1))
                (= op (primitive/cast i64 2)) (a64-w! (mut s) (a64-fmul fty 0 0 1))
                (= op (primitive/cast i64 3)) (a64-w! (mut s) (a64-fdiv fty 0 0 1))
                (= op (primitive/cast i64 4))  ; frem: libm fmod(d0,d1) — args are already in d0/d1
                  (let [fsym (g-runtime-sym! g (if (= fb (primitive/cast i64 4)) "_fmodf" "_fmod"))]
                    (mobj-add-reloc! (mut (field g obj))
                                     (load (field g text))
                                     (a64-off (mut s))
                                     fsym
                                     (reloc-branch26)
                                     true
                                     2)
                    (a64-w! (mut s) (a64-bl-raw)))
                :else (cga-fail "unsupported float binary op"))
          (let [slot (slot-for-ty! g t)]
            (emit-store-fp! g 0 28 slot fb)
            (mk-aval 1 slot (av-ty lav))))
        ; integer ops
        (let [signed (match (load t) (TInt [_b sg] sg) (_ false))]
          (av-to-x! g lav 9)
          (av-to-x! g rav 10)
          (cond (= op (primitive/cast i64 0)) (a64-w! (mut s) (a64-add-reg 9 9 10))
                (= op (primitive/cast i64 1)) (a64-w! (mut s) (a64-sub-reg 9 9 10))
                (= op (primitive/cast i64 2)) (a64-w! (mut s) (a64-mul 9 9 10))
                (= op (primitive/cast i64 3)) (a64-w! (mut s) (if signed (a64-sdiv 9 9 10) (a64-udiv 9 9 10)))
                (= op (primitive/cast i64 4))  ; rem: q = div(a,b); r = a - q*b   (msub x9, x11, x10, x9)
                  (do
                    (a64-w! (mut s) (if signed (a64-sdiv 11 9 10) (a64-udiv 11 9 10)))
                    (a64-w! (mut s) (a64-msub 9 11 10 9)))
                (= op (primitive/cast i64 5)) (a64-w! (mut s) (a64-udiv 9 9 10))
                (= op (primitive/cast i64 6))
                  (do
                    (a64-w! (mut s) (a64-udiv 11 9 10))
                    (a64-w! (mut s) (a64-msub 9 11 10 9)))
                (= op (primitive/cast i64 7)) (a64-w! (mut s) (a64-and-reg 9 9 10))
                (= op (primitive/cast i64 8)) (a64-w! (mut s) (a64-orr-reg 9 9 10))
                (= op (primitive/cast i64 9)) (a64-w! (mut s) (a64-eor-reg 9 9 10))
                (= op (primitive/cast i64 10)) (a64-w! (mut s) (a64-lslv 9 9 10))
                (= op (primitive/cast i64 11))
                  (a64-w! (mut s)
                          (if signed (a64-asrv 9 9 10) (a64-lsrv 9 9 10)))
                (= op (primitive/cast i64 12))
                  (let [nbits (match (load t) (TInt [n _] n) (_ 64))]
                    (a64-mov-imm! (mut s) 12 nbits)
                    (a64-w! (mut s) (a64-udiv 11 10 12))
                    (a64-w! (mut s) (a64-msub 10 11 12 10))
                    (a64-w! (mut s) (a64-lslv 11 9 10))
                    (a64-w! (mut s) (a64-sub-reg 12 12 10))
                    (a64-w! (mut s) (a64-lsrv 12 9 12))
                    (a64-w! (mut s) (a64-orr-reg 9 11 12)))
                (= op (primitive/cast i64 13))
                  (let [nbits (match (load t) (TInt [n _] n) (_ 64))]
                    (a64-mov-imm! (mut s) 12 nbits)
                    (a64-w! (mut s) (a64-udiv 11 10 12))
                    (a64-w! (mut s) (a64-msub 10 11 12 10))
                    (a64-w! (mut s) (a64-lsrv 11 9 10))
                    (a64-w! (mut s) (a64-sub-reg 12 12 10))
                    (a64-w! (mut s) (a64-lslv 12 9 12))
                    (a64-w! (mut s) (a64-orr-reg 9 11 12)))
                (= op (primitive/cast i64 14))
                  (do
                    (a64-w! (mut s) (a64-mul 11 9 10))
                    (a64-w! (mut s) (if signed (a64-smulh 12 9 10) (a64-umulh 12 9 10)))
                    (if (= (match (load t) (TInt [n _] n) (_ 64)) (primitive/cast i64 64))
                        (a64-w! (mut s) (a64-orr-reg 9 12 31))
                        (let [nbits (match (load t) (TInt [n _] n) (_ 64))]
                          (a64-w! (mut s) (a64-lsr-imm 11 11 nbits))
                          (a64-w! (mut s) (a64-lsl-imm 12 12 (primitive/isub 64 nbits)))
                          (a64-w! (mut s) (a64-orr-reg 9 11 12)))))
                (= op (primitive/cast i64 15))
                  (let [nbits (match (load t) (TInt [n _] n) (_ 64))]
                    (if (= nbits (primitive/cast i64 64))
                        (do (a64-w! (mut s) (a64-adds-reg 9 9 10)) (a64-w! (mut s) (a64-cset 9 (if signed 6 2))))
                        (do
                          (a64-w! (mut s) (a64-add-reg 11 9 10))
                          (a64-w! (mut s) (a64-orr-reg 12 11 31))
                          (emit-canon-int! g 12 nbits signed)
                          (if signed
                              (do (a64-w! (mut s) (a64-cmp-reg 11 12)) (a64-w! (mut s) (a64-cset 9 1)))
                              (do (a64-w! (mut s) (a64-cmp-reg 12 9)) (a64-w! (mut s) (a64-cset 9 3)))))))
                (= op (primitive/cast i64 16))
                  (let [nbits (match (load t) (TInt [n _] n) (_ 64))]
                    (if (= nbits (primitive/cast i64 64))
                        (do (a64-w! (mut s) (a64-subs-reg 9 9 10)) (a64-w! (mut s) (a64-cset 9 (if signed 6 3))))
                        (if signed
                            (do
                              (a64-w! (mut s) (a64-sub-reg 11 9 10))
                              (a64-w! (mut s) (a64-orr-reg 12 11 31))
                              (emit-canon-int! g 12 nbits true)
                              (a64-w! (mut s) (a64-cmp-reg 11 12))
                              (a64-w! (mut s) (a64-cset 9 1)))
                            (do (a64-w! (mut s) (a64-cmp-reg 9 10)) (a64-w! (mut s) (a64-cset 9 3))))))
                (= op (primitive/cast i64 17))
                  (do
                    (a64-w! (mut s) (a64-mul 11 9 10))
                    (a64-w! (mut s) (if signed (a64-smulh 12 9 10) (a64-umulh 12 9 10)))
                    (a64-w! (mut s) (a64-orr-reg 13 11 31))
                    (match (load t) (TInt [n sg] (emit-canon-int! g 13 n sg)) (_ 0))
                    (a64-w! (mut s) (a64-cmp-reg 11 13))
                    (a64-w! (mut s) (a64-cset 14 1))
                    (if signed (a64-w! (mut s) (a64-asr-imm 13 13 63)) (a64-mov-imm! (mut s) 13 0))
                    (a64-w! (mut s) (a64-cmp-reg 12 13))
                    (a64-w! (mut s) (a64-cset 9 1))
                    (a64-w! (mut s) (a64-orr-reg 9 9 14)))
                :else (cga-fail "unknown integer binary op"))
          (unless (>= op (primitive/cast i64 15))
            (match (load t) (TInt [bits sg] (emit-canon-int! g 9 bits sg)) (_ 0)))
          (let [outty (if (>= op (primitive/cast i64 15)) (TBool) (load t))
                outp (primitive/alloc-stack Type)]
            (set! outp outty)
            (let [slot (slot-for-ty! g outp)]
              (emit-store-int! g 9 28 slot (ty-size g outp))
              (mk-aval 1 slot outty)))))))

(defn emit-cmp [(g (ptr Cga)) (op i64) (lhs (ptr Expr)) (rhs (ptr Expr))] (-> AVal)
  (let [lav (emit-expr g lhs)
        rav (emit-expr g rhs)
        t (primitive/alloc-stack Type)
        s (field g asm)]
    (set! t (av-ty lav))
    (if (ty-is-float t)
        ; float: ordered predicates. 0 lt->mi 1 le->ls 2 gt->gt 3 ge->ge 4 eq->eq 5 one
        (let [fty (unless (= (ty-float-bytes t) (primitive/cast i64 4)) 1)]
          (av-to-d! g lav 0)
          (av-to-d! g rav 1)
          (a64-w! (mut s) (a64-fcmp fty 0 1))
          (if (= op (primitive/cast i64 5))
              ; ONE = ordered and not-equal: (ne && vc)
              (do
                (a64-w! (mut s) (a64-cset 9 (cond-ne)))
                (a64-w! (mut s) (a64-cset 10 (cond-vc)))
                (a64-w! (mut s) (a64-and-reg 9 9 10))
                0)
              (do
                (a64-w! (mut s)
                        (a64-cset 9
                                  (cond (= op (primitive/cast i64 0)) (cond-mi)
                                        (= op (primitive/cast i64 1)) (cond-ls)
                                        (= op (primitive/cast i64 2)) (cond-gt)
                                        (= op (primitive/cast i64 3)) (cond-ge)
                                        :else (cond-eq))))
                0))
          (let [slot (slot-new! g 8 8)]
            (emit-store-int! g 9 28 slot 1)
            (mk-aval 1 slot (TBool))))
        (let [signed (match (load t) (TInt [_b sg] sg) (TBool [] false) (_ true))]
          (av-to-x! g lav 9)
          (av-to-x! g rav 10)
          (a64-w! (mut s) (a64-cmp-reg 9 10))
          (a64-w! (mut s)
                  (a64-cset 9
                            (cond (= op (primitive/cast i64 0)) (if signed (cond-lt) (cond-lo))
                                  (= op (primitive/cast i64 1)) (if signed (cond-le) (cond-ls))
                                  (= op (primitive/cast i64 2)) (if signed (cond-gt) (cond-hi))
                                  (= op (primitive/cast i64 3)) (if signed (cond-ge) (cond-hs))
                                  (= op (primitive/cast i64 4)) (cond-eq)
                                  :else (cond-ne))))
          (let [slot (slot-new! g 8 8)]
            (emit-store-int! g 9 28 slot 1)
            (mk-aval 1 slot (TBool)))))))

; ---- control flow -----------------------------------------------------------
; ---- self-tail-call optimization ------------------------------------------
; Without this the arm64 backend turns every self-recursive tail call into a real
; BL, so a tail-recursive function consumes a frame per iteration and dies of stack
; exhaustion where the LLVM backend — which does this — runs it in constant space.
; That is a plain miscompile-by-omission at RUNTIME (`coil build --backend arm64`
; segfaults on a program LLVM runs fine), and comptime inherits it because the
; comptime thunk is built by THIS backend: the reported "runaway comptime crashes
; the compiler" was this, not a comptime defect.
;
; Eligible when the callee is the function being emitted, the arity matches its
; recorded parameter slots, and every parameter was spilled to a slot (the ordinary
; case — recorded during intake). Anything else falls back to a normal call, so the
; optimization can only ever be skipped, never misapplied.
(defn tail-self-callable? [(g (ptr Cga)) (func (slice u8)) (args (ptr (ArrayList Expr)))] (-> bool)
  (and (> (len (.selfname g)) (primitive/cast i64 0))
       (and (= func (.selfname g))
            (= (len (load args))
               (len (load (load (field g tailslots))))))))

; Evaluate the arguments into FRESH slots first, then copy those into the parameter
; slots, then jump. The two phases are not an optimization detail: `(f b a)` swapping
; its arguments would otherwise overwrite the first parameter before the second
; argument had read it.
(defn emit-tail-self-call! [(g (ptr Cga)) (args (ptr (ArrayList Expr)))] (-> AVal)
  (let [n (len (load args))
        tmps (box! (load (field g a)) (ArrayList i64) (primitive/zeroed (ArrayList i64)))
        (mut i) 0]
    (set! tmps (al-new [i64] (.a g)))
    (loop (if (>= (load i) n)
              (break)
              (do
                (let [av (emit-expr g (al-at [Expr] args (load i)))
                      t (primitive/alloc-stack Type)]
                  (set! t (get (load (load (field g tailtys))) (load i)))
                  (let [ts (slot-for-ty! g t)]
                    (emit-store-av! g av ts)
                    (push! tmps ts)))
                (set! i (primitive/iadd (load i) 1)))))
    (set! i 0)
    (loop (if (>= (load i) n)
              (break)
              (do
                (let [t (primitive/alloc-stack Type)]
                  (set! t (get (load (load (field g tailtys))) (load i)))
                  (let [dst (get (load (load (field g tailslots))) (load i))
                        src (get (load tmps) (load i))
                        sz (ty-size g t)]
                    (emit-copy-slot! g dst src sz)))
                (set! i (primitive/iadd (load i) 1)))))
    (a64-b-label! (mut (.asm g)) (.entrylabel g))
    ; the jump never falls through, so the surrounding `if`/body treats this arm as
    ; terminated and emits no result store — the same path `break` already used.
    (set! (.terminated g) true)
    (mk-aval 0 0 (TInt 64 true))))

; `if` is the one construct that propagates tail position: both branches of a tail
; `if` are themselves in tail position; the CONDITION never is.
(defn emit-if-tail [(g (ptr Cga)) (cnd (ptr Expr)) (thn (ptr Expr)) (els (ptr Expr)) (am-tail bool)] (-> AVal)
  (let [cav (emit-expr g cnd)
        s (field g asm)
        lelse (a64-new-label (mut (.asm g)))
        lend (a64-new-label (mut (.asm g)))]
    (av-to-x! g cav 9)
    (a64-cbz-label! (mut (.asm g)) 9 lelse)
    (set! (.tailok g) am-tail)
    (let [thnav (emit-expr g thn)
          thnterm (.terminated g)
          (mut rslot) -1
          (mut rty) (TInt 64 true)]
      (unless thnterm
        (let [tt (primitive/alloc-stack Type)]
          (store! tt (av-ty thnav))
          (store! rslot (slot-for-ty! g tt))
          (store! rty (av-ty thnav))
          (emit-store-av! g thnav (load rslot)))
        (a64-b-label! (mut (field g asm)) lend)
        0)
      (set! (.terminated g) false)
      (a64-bind-label! (mut (.asm g)) lelse)
      (set! (.tailok g) am-tail)
      (let [elsav (emit-expr g els)
            elsterm (.terminated g)]
        (unless elsterm
          (let [et (primitive/alloc-stack Type)]
            (store! et (av-ty elsav))
            (when (< (load rslot) (primitive/cast i64 0))
              (store! rslot (slot-for-ty! g et))
              (store! rty (av-ty elsav))
              0)
            (emit-store-av! g elsav (load rslot)))
          0)
        (a64-bind-label! (mut (.asm g)) lend)
        (set! (.terminated g) (and thnterm elsterm))
        (if (>= (load rslot) (primitive/cast i64 0))
            (mk-aval 1 (load rslot) (load rty))
            (mk-aval 0 0 (TInt 64 true)))))))

(defn emit-if [(g (ptr Cga)) (cnd (ptr Expr)) (thn (ptr Expr)) (els (ptr Expr))] (-> AVal)
  (let [cav (emit-expr g cnd)
        s (field g asm)
        lelse (a64-new-label (mut (.asm g)))
        lend (a64-new-label (mut (.asm g)))]
    (av-to-x! g cav 9)
    (a64-cbz-label! (mut (.asm g)) 9 lelse)
    (let [thnav (emit-expr g thn)
          thnterm (.terminated g)
          (mut rslot) -1
          (mut rty) (TInt 64 true)]
      (unless thnterm
        (let [tt (primitive/alloc-stack Type)]
          (store! tt (av-ty thnav))
          (store! rslot (slot-for-ty! g tt))
          (store! rty (av-ty thnav))
          (emit-store-av! g thnav (load rslot)))
        (a64-b-label! (mut (field g asm)) lend)
        0)
      (set! (.terminated g) false)
      (a64-bind-label! (mut (.asm g)) lelse)
      (let [elsav (emit-expr g els)
            elsterm (.terminated g)]
        (unless elsterm
          (let [et (primitive/alloc-stack Type)]
            (store! et (av-ty elsav))
            (when (< (load rslot) (primitive/cast i64 0))
              (store! rslot (slot-for-ty! g et))
              (store! rty
                      (av-ty elsav))
              0)
            (emit-store-av! g elsav (load rslot)))
          0)
        (a64-bind-label! (mut (.asm g)) lend)
        (set! (.terminated g) (and thnterm elsterm))
        (if (>= (load rslot) (primitive/cast i64 0))
            (mk-aval 1 (load rslot) (load rty))
            (mk-aval 0 0 (TInt 64 true)))))))

(defn emit-loop [(g (ptr Cga)) (label (Option (slice u8))) (body (ptr (ArrayList Expr)))] (-> AVal)
  (let [s (field g asm)
        contlabel (a64-new-label (mut (.asm g)))
        breaklabel (a64-new-label (mut (.asm g)))
        gl (primitive/alloc-stack GLoop)]
    (set! (.label gl) label)
    (set! (.contlabel gl) contlabel)
    (set! (.breaklabel gl) breaklabel)
    (set! (.resslot gl) -1)
    (set! (.resty gl) (TInt 64 true))
    (set! (.has_res gl) false)
    (push! (mut (.loops g)) (load gl))
    (a64-bind-label! (mut (.asm g)) contlabel)
    (emit-stmts g body)
    (unless (load (field g terminated)) (a64-b-label! (mut (field g asm)) contlabel) 0)
    ; pop the loop frame and read its break results
    (let [n (len (.loops g))
          fin (get (.loops g) (primitive/isub n 1))
          fp (primitive/alloc-stack GLoop)]
      (set! fp fin)
      (set! (.len (.loops g)) (primitive/isub n 1))
      (a64-bind-label! (mut (.asm g)) breaklabel)
      (if (.has_res fp)
          (do
            (set! (.terminated g) false)
            (mk-aval 1 (.resslot fp) (.resty fp)))
          (do
            (set! (.terminated g) true)
            (mk-aval 0 0 (TInt 64 true)))))))

(defn emit-break [(g (ptr Cga)) (label (Option (slice u8))) (value (Option (ptr Expr)))] (-> AVal)
  (if (.terminated g)
      (mk-aval 0 0 (TInt 64 true))
      (let [av
              (match value
                (Some [ve] (emit-expr g ve))
                (None [] (mk-aval 0 0 (TInt 64 true))))
            li (g-loop-index g label)
            lp (al-at [GLoop] (field g loops) li)]
        (when (< (load (field lp resslot)) (primitive/cast i64 0))
          (let [t (primitive/alloc-stack Type)]
            (store! t (av-ty av))
            (store! (field lp resslot) (slot-for-ty! g t))
            (store! (field lp resty) (av-ty av))
            (store! (field lp has_res) true))
          0)
        (emit-store-av! g av (.resslot lp))
        (a64-b-label! (mut (.asm g)) (.breaklabel lp))
        (set! (.terminated g) true)
        (mk-aval 0 0 (TInt 64 true)))))

; ---- casts ------------------------------------------------------------------
(defn emit-cast [(g (ptr Cga)) (t Type) (inner (ptr Expr))] (-> AVal)
  (let [av (emit-expr g inner)
        st (primitive/alloc-stack Type)
        dt (primitive/alloc-stack Type)
        s (field g asm)]
    (set! st (av-ty av))
    (set! dt t)
    (match t
      (TInt [dbits dsigned]
            (if (ty-is-float st)
                ; float -> int (toward zero), signedness of the TARGET
                (let [fty (unless (= (ty-float-bytes st) (primitive/cast i64 4)) 1)
                      slot (slot-for-ty! g dt)]
                  (av-to-d! g av 0)
                  (a64-w! (mut s) (if dsigned (a64-fcvtzs fty 9 0) (a64-fcvtzu fty 9 0)))
                  (emit-store-int! g 9 28 slot (ty-size g dt))
                  (mk-aval 1 slot t))
                ; int/ptr -> int: source-extended load, canonicalize to dest width
                (let [slot (slot-for-ty! g dt)]
                  (av-to-x! g av 9)
                  (emit-canon-int! g 9 dbits dsigned)
                  (emit-store-int! g 9 28 slot (ty-size g dt))
                  (mk-aval 1 slot t))))
      (TFloat [dbits]
              (let [dfty (unless (= dbits (primitive/cast i64 32)) 1)
                    slot (slot-for-ty! g dt)]
                (if (ty-is-float st)
                    (do
                      (av-to-d! g av 0)
                      (unless (= (ty-float-bytes st) (primitive/idiv dbits 8))
                        (if (= dbits (primitive/cast i64 64))
                            (a64-w! (mut s) (a64-fcvt-s-to-d 0 0))
                            (a64-w! (mut s) (a64-fcvt-d-to-s 0 0))))
                      (emit-store-fp! g 0 28 slot (primitive/idiv dbits 8))
                      0)
                    ; int -> float, signedness of the SOURCE
                    (let [ssigned (match (load st) (TInt [_b sg] sg) (_ true))]
                      (av-to-x! g av 9)
                      (a64-w! (mut s) (if ssigned (a64-scvtf dfty 0 9) (a64-ucvtf dfty 0 9)))
                      (emit-store-fp! g 0 28 slot (primitive/idiv dbits 8))
                      0))
                (mk-aval 1 slot t)))
      (_  ; ptr / fnptr targets: bit-identical 8-byte move
         (let [slot (slot-for-ty! g dt)]
           (av-to-x! g av 9)
           (emit-store-int! g 9 28 slot 8)
           (mk-aval 1 slot t))))))

; ---- sums -------------------------------------------------------------------
(defn emit-construct [(g (ptr Cga)) (sum (slice u8)) (variant (slice u8)) (args (ptr (ArrayList Expr)))] (-> AVal)
  (let [su (g-sum-idx g sum)]
    (when (< su (primitive/cast i64 0)) (cga-fail2 "construct of unknown sum: " sum))
    (let [vidx (g-variant-idx g su variant)
          sumty (primitive/alloc-stack Type)]
      (set! sumty (TStruct sum))
      (let [slot (slot-for-ty! g sumty)
            vs (load (field (sum-at (field g layouts) su) variants))
            vfields (load (field (al-at [Variant] vs vidx) fields))
            n (len (load args))
            (mut i) 0]
        ; tag (i32 at offset 0)
        (a64-mov-imm! (mut (.asm g)) 9 vidx)
        (emit-store-int! g 9 28 slot 4)
        ; payload fields at their natural offsets within the variant struct
        (loop (if (>= (load i) n)
                  (break)
                  (do
                    (let [av (emit-expr g (al-at [Expr] args (load i)))
                          off (g-natural-off g vfields (load i))]
                      (emit-store-av-at! g av (primitive/iadd (primitive/iadd slot 8) off)))
                    (set! i (primitive/iadd (load i) 1)))))
        (mk-aval 1 slot (TStruct sum))))))

; store an AVal at an absolute slot byte offset (may be unaligned-in-slot for
; sub-slot fields — offsets are still 1/2/4/8-aligned by construction).
(defn emit-store-av-at! [(g (ptr Cga)) (av AVal) (dst i64)] (-> i64)
  (let [t (primitive/alloc-stack Type)]
    (set! t (av-ty av))
    (if (ty-is-scalar t)
        (do
          (av-to-x! g av 9)
          (emit-store-int! g 9 28 dst (ty-size g t))
          0)
        (emit-copy! g dst (av-slot! g av) (ty-size g t)))))

(defn emit-match [(g (ptr Cga)) (scrut (ptr Expr)) (arms (ptr (ArrayList Arm)))] (-> AVal)
  (let [sav (emit-expr g scrut)
        t (primitive/alloc-stack Type)
        s (field g asm)
        a (.a g)]
    (set! t (av-ty sav))
    (let [borrowed
            (match (load t)
              (TPtr [inner] (match (load inner) (TStruct [_] true) (_ false)))
              (_ false))
          sumname
            (match (load t)
              (TStruct [nm] nm)
              (TPtr [inner] (match (load inner) (TStruct [nm] nm) (_ "")))
              (_ ""))
          su (g-sum-idx g sumname)]
      (when (< su (primitive/cast i64 0)) (cga-fail2 "match on non-sum: " sumname))
      (let [sslot (av-slot! g sav)
            vs (load (field (sum-at (field g layouts) su) variants))
            narms (len (load arms))
            ; a trailing `(_ …)` arm is the fallthrough, so it gets a label but no
            ; comparison — the chain branches to it instead of trapping.
            ncases (if (arms-have-wildcard arms) (primitive/isub narms 1) narms)
            lend (a64-new-label (mut (.asm g)))
            (mut armlabels) (al-new [i64] a)
            (mut rslot) -1
            (mut rty) (TInt 64 true)
            (mut anylive) false]
        ; tag -> x9, then the compare/branch chain
        (if borrowed
            (do
              (emit-load-int! g 11 28 sslot 8 false)
              (emit-load-from-mem! g 9 11 4))
            (emit-load-int! g 9 28 sslot 4 false))
        (let [(mut i) 0]
          (loop (if (>= (load i) narms)
                    (break)
                    (do
                      (let [arm (al-at [Arm] arms (load i))
                            lab (a64-new-label (mut (.asm g)))]
                        (push! (mut armlabels) lab)
                        (unless (>= (load i) ncases)
                          (let [vidx (g-variant-idx g su (load (field arm variant)))]
                            (a64-mov-imm! (mut (field g asm)) 10 vidx)
                            (a64-w! (mut s) (a64-cmp-reg 9 10))
                            (a64-bcond-label! (mut (field g asm)) (cond-eq) lab))))
                      (set! i (primitive/iadd (load i) 1))))))
        ; no arm matched: the catch-all if there is one, else unreachable
        (if (= ncases narms)
            (a64-w! (mut s) (a64-brk 61680))
            (a64-b-label! (mut (.asm g)) (get (load armlabels) ncases)))
        ; arms
        (let [(mut i) 0]
          (loop (if (>= (load i) narms)
                    (break)
                    (do
                      (let [arm (al-at [Arm] arms (load i))
                            ; the catch-all binds nothing, so `vfields` is never read;
                            ; variant 0 just keeps the lookup in range.
                            vidx (if (>= (load i) ncases) 0 (g-variant-idx g su (.variant arm)))
                            vfields (load (field (al-at [Variant] vs vidx) fields))
                            saved (load (field g env))]
                        (a64-bind-label! (mut (.asm g)) (get (load armlabels) (load i)))
                        (set! (.terminated g) false)
                        ; bind payload fields BY VALUE into fresh slots
                        (let [binds (load (field arm binds))
                              nb (len (load binds))
                              (mut j) 0]
                          (loop (if (>= (load j) nb)
                                    (break)
                                    (do
                                      (let [fty (.ty (al-at [Field] vfields (load j)))
                                            ftp (primitive/alloc-stack Type)]
                                        (set! ftp fty)
                                        (let [foff (g-natural-off g vfields (load j))
                                              bname (get (load binds) (load j))
                                              borrowed-binding (and borrowed (starts-with bname "$match.ref."))]
                                          (if borrowed-binding
                                              (let [bslot (slot-new! g 8 8)]
                                                (emit-load-int! g 9 28 sslot 8 false)
                                                (a64-w! (mut s)
                                                        (a64-add-imm 9
                                                                     9
                                                                     (primitive/iadd 8 foff)))
                                                (emit-store-int! g 9 28 bslot 8)
                                                (set! (.env g)
                                                      (gscope-put a
                                                                  (load (field g env))
                                                                  bname
                                                                  (mk-aval 1
                                                                           bslot
                                                                           (TPtr (box-type a fty))))))
                                              (let [bslot (slot-for-ty! g ftp)]
                                                (if borrowed
                                                    (do
                                                      (emit-load-int! g 9 28 sslot 8 false)
                                                      (a64-w! (mut s)
                                                              (a64-add-imm 9
                                                                           9
                                                                           (primitive/iadd 8 foff)))
                                                      (emit-copy-from-mem! g
                                                                           bslot
                                                                           9
                                                                           (ty-size g ftp)))
                                                    (emit-copy! g
                                                                bslot
                                                                (primitive/iadd (primitive/iadd sslot 8)
                                                                                foff)
                                                                (ty-size g ftp)))
                                                (set! (.env g)
                                                      (gscope-put a
                                                                  (load (field g env))
                                                                  bname
                                                                  (mk-aval 1 bslot fty)))))))
                                      (set! j (primitive/iadd (load j) 1))))))
                        (let [bav (emit-expr g (field arm body))]
                          (set! (.env g) saved)
                          (unless (load (field g terminated))
                            (when (< (load rslot) (primitive/cast i64 0))
                              (let [bt (primitive/alloc-stack Type)]
                                (store! bt (av-ty bav))
                                (store! rslot (slot-for-ty! g bt))
                                (store! rty (av-ty bav)))
                              0)
                            (emit-store-av! g bav (load rslot))
                            (store! anylive true)
                            (a64-b-label! (mut (field g asm)) lend)
                            0)))
                      (set! i (primitive/iadd (load i) 1))))))
        (a64-bind-label! (mut (.asm g)) lend)
        (if (load anylive)
            (do
              (set! (.terminated g) false)
              (mk-aval 1 (load rslot) (load rty)))
            (do
              (set! (.terminated g) true)
              (mk-aval 0 0 (TInt 64 true))))))))

; ---- named calls ------------------------------------------------------------
(defn g-leaf-inline-body? [(fd (ptr Func))] (-> bool)
  (let [body (load (field fd body))]
    (if (not (= (len (load body)) 1))
        false
        ; These nodes cannot redirect caller control flow or introduce lexical
        ; cleanup. They cover the core Always wrappers (numeric primitives and
        ; the callable-value trampoline) without pretending to be a general AST
        ; inliner.
        (match (.kind (al-elem [Expr] body 0))
          (EBin [_ _ _] true)
          (ECmp [_ _ _] true)
          (EIntUnary [_ _] true)
          (ECast [_ _] true)
          (ECallPtr [_ _] true)
          (_ false)))))

(defn g-leaf-inline-candidate? [(g (ptr Cga)) (sig (ptr GSig))] (-> bool)
  (let [fd (load (field sig func))]
    (if (or (= (primitive/cast i64 fd) 0)
            (or (not (= (.inline_policy sig) 1))
                (or (>= (.inline_depth g) 16)
                    (= (.name fd) (.selfname g)))))
        false
        (let [ps (load (field fd params))
              np (len (load ps))
              (mut i) 0
              (mut scalar) (ty-is-scalar (field fd ret))]
          (loop (if (or (>= (load i) np) (not (load scalar)))
                    (break)
                    (do
                      (unless (ty-is-scalar (field (al-elem [Param] ps (load i)) ty))
                        (store! scalar false)
                        0)
                      (set! i (primitive/iadd (load i) 1)))))
          (and (load scalar) (g-leaf-inline-body? fd))))))

(defn emit-leaf-inline [(g (ptr Cga))
                        (sig (ptr GSig))
                        (avs (ptr (ArrayList AVal)))] (-> AVal)
  (let [fd (load (field sig func))
        saved (load (field g env))
        ps (load (field fd params))
        np (len (load ps))
        (mut i) 0]
    (loop (if (>= (load i) np)
              (break)
              (do
                (let [p (al-elem [Param] ps (load i))]
                  (set! (.env g)
                        (gscope-put (.a g)
                                    (load (field g env))
                                    (.name p)
                                    (get (load avs) (load i)))))
                (set! i (primitive/iadd (load i) 1)))))
    (set! (.inline_depth g) (primitive/iadd (.inline_depth g) 1))
    (let [answer (emit-expr g (al-elem [Expr] (load (field fd body)) 0))]
      (set! (.inline_depth g) (primitive/isub (.inline_depth g) 1))
      (set! (.env g) saved)
      answer)))

(defn emit-call-named [(g (ptr Cga)) (func (slice u8)) (args (ptr (ArrayList Expr)))] (-> AVal)
  (let [si (g-sig-idx g func)]
    (when (< si (primitive/cast i64 0)) (cga-fail2 "call to unknown function: " func))
    (let [e (al-at [GSig] (field g sigs) si)
          (mut avs) (al-new [AVal] (.a g))
          n (len (load args))
          (mut i) 0
          dummy (primitive/alloc-stack AVal)]
      (loop (if (>= (load i) n)
                (break)
                (do
                  (push! (mut avs) (emit-expr g (al-at [Expr] args (load i))))
                  (set! i (primitive/iadd (load i) 1)))))
      (set! dummy (mk-aval 0 0 (TInt 64 true)))
      (if (g-leaf-inline-candidate? g e)
          (emit-leaf-inline g e (box-al [AVal] (.a g) (load avs)))
          (if (.shim e)
              ; register-constrained call: args in the convention's registers,
              ; result read back from its return register.
              (let [s (field g asm)
                    regs (load (field e shimregs))
                    (mut slots) (al-new [i64] (.a g))
                    (mut j) 0]
                (loop (if (>= (load j) n)
                          (break)
                          (do
                            (push! (mut slots) (av-slot! g (get (load avs) (load j))))
                            (set! j (primitive/iadd (load j) 1)))))
                (set! j 0)
                (loop (if (>= (load j) n)
                          (break)
                          (do
                            (emit-load-int! g
                                            (get (load regs) (load j))
                                            28
                                            (get (load slots) (load j))
                                            8
                                            false)
                            (set! j (primitive/iadd (load j) 1)))))
                (mobj-add-reloc! (mut (.obj g))
                                 (.text g)
                                 (a64-off (mut s))
                                 (.symidx e)
                                 (reloc-branch26)
                                 true
                                 2)
                (a64-w! (mut s) (a64-bl-raw))
                (let [retp (primitive/alloc-stack Type)]
                  (set! retp (.ret e))
                  (if (match (.ret e) (TVoid [] true) (_ false))
                      (mk-aval 0 0 (TInt 64 true))
                      (let [slot (slot-for-ty! g retp)]
                        (emit-store-int! g (.shimret e) 28 slot (ty-size g retp))
                        (mk-aval 1 slot (.ret e))))))
              (emit-call! g
                          (.symidx e)
                          dummy
                          (load (field e params))
                          (.variadic e)
                          (.ret e)
                          (box-al [AVal] (.a g) (load avs))))))))

; ---- bit-struct access --------------------------------------------------------
; layout info for a bit-struct: backing width + per-field low-bit offsets.
(defn g-bits-info [(g (ptr Cga))
                   (nm (slice u8))
                   (fname (slice u8))
                   (lowp (ptr i64))
                   (widthp (ptr i64))
                   (signedp (ptr bool))
                   (backp (ptr i64))] (-> i64)
  (let [si (g-struct-idx g nm)]
    (when (< si (primitive/cast i64 0)) (cga-fail2 "bit access on unknown struct: " nm))
    (let [e (struct-at (field g layouts) si)]
      (match (.layout e)
        (LBits [backing offs]
               (let [fi (g-field-idx g si fname)]
                 (set! lowp (get (load offs) fi))
                 (set! backp backing)
                 (match (.ty (al-at [Field] (load (field e fields)) fi))
                   (TInt [bits sg] (do (set! widthp bits) (set! signedp sg) 0))
                   (TBool [] (do (set! widthp 1) (set! signedp false) 0))
                   (_ (cga-fail "bit-struct field with non-int type")))))
        (_ (cga-fail2 "bit access on non-bits struct: " nm))))))

(defn emit-bitget [(g (ptr Cga)) (p (ptr Expr)) (fname (slice u8))] (-> AVal)
  (let [av (emit-expr g p)
        t (primitive/alloc-stack Type)
        s (field g asm)]
    (set! t (av-ty av))
    (let [pt (primitive/alloc-stack Type)]
      (set! pt (ty-pointee t))
      (match (load pt)
        (TStruct [nm]
                 (let [low (primitive/alloc-stack i64)
                       width (primitive/alloc-stack i64)
                       signed (primitive/alloc-stack bool)
                       back (primitive/alloc-stack i64)]
                   (g-bits-info g nm fname low width signed back)
                   (av-to-x! g av 9)
                   (emit-load-from-mem! g 9 9 (primitive/idiv (load back) 8))
                   (when (> (load low) (primitive/cast i64 0)) (a64-w! (mut s) (a64-lsr-imm 9 9 (load low))))
                   ; mask/sign-extend to the field width via shift pairs
                   (when (< (load width) (primitive/cast i64 64))
                     (a64-w! (mut s) (a64-lsl-imm 9 9 (primitive/isub 64 (load width))))
                     (a64-w! (mut s)
                             (if (load signed)
                                 (a64-asr-imm 9 9 (primitive/isub 64 (load width)))
                                 (a64-lsr-imm 9 9 (primitive/isub 64 (load width)))))
                     0)
                   (let [fty (if (= (load width) (primitive/cast i64 1)) (TBool) (TInt (load width) (load signed)))
                         ftp (primitive/alloc-stack Type)]
                     (set! ftp fty)
                     (let [slot (slot-for-ty! g ftp)]
                       (emit-store-int! g 9 28 slot (ty-size g ftp))
                       (mk-aval 1 slot fty)))))
        (_ (do (cga-fail "bit-get through non-struct pointer") (mk-aval 0 0 (TInt 64 true))))))))

(defn emit-bitset [(g (ptr Cga)) (p (ptr Expr)) (fname (slice u8)) (val (ptr Expr))] (-> AVal)
  (let [pav (emit-expr g p)
        vav (emit-expr g val)
        t (primitive/alloc-stack Type)
        s (field g asm)]
    (set! t (av-ty pav))
    (let [pt (primitive/alloc-stack Type)]
      (set! pt (ty-pointee t))
      (match (load pt)
        (TStruct [nm]
                 (let [low (primitive/alloc-stack i64)
                       width (primitive/alloc-stack i64)
                       signed (primitive/alloc-stack bool)
                       back (primitive/alloc-stack i64)]
                   (g-bits-info g nm fname low width signed back)
                   (av-to-x! g pav 9)  ; x9 = container address
                   (emit-load-from-mem! g 10 9 (primitive/idiv (load back) 8))  ; x10 = container
                   ; x11 = ~(fieldmask << low)
                   (let [fieldmask
                           (if (>= (load width) (primitive/cast i64 64))
                               -1
                               (primitive/isub (primitive/ishl 1 (load width)) 1))]
                     (a64-mov-imm! (mut s) 11 (primitive/ishl fieldmask (load low)))
                     (a64-w! (mut s) (a64-mvn-reg 11 11))
                     (a64-w! (mut s) (a64-and-reg 10 10 11))
                     ; x12 = (value & fieldmask) << low
                     (av-to-x! g vav 12)
                     (a64-mov-imm! (mut s) 13 fieldmask)
                     (a64-w! (mut s) (a64-and-reg 12 12 13))
                     (when (> (load low) (primitive/cast i64 0)) (a64-w! (mut s) (a64-lsl-imm 12 12 (load low))))
                     (a64-w! (mut s) (a64-orr-reg 10 10 12))
                     (emit-store-to-mem! g 10 9 (primitive/idiv (load back) 8))
                     vav)))
        (_ (do (cga-fail "bit-set through non-struct pointer") (mk-aval 0 0 (TInt 64 true))))))))

; ---- trait objects ----------------------------------------------------------
(defn emit-make-dyn [(g (ptr Cga))
                     (ds (slice u8))
                     (_vt (slice u8))
                     (methods (ptr (ArrayList (slice u8))))
                     (inner (ptr Expr))] (-> AVal)
  (let [a (.a g)
        buf (mobj-sect-buf (mut (.obj g)) (.datasec g))]
    ; the vtable: one 8-byte relocated function pointer per method
    (b-align! (mut buf) 8)
    (let [vtoff (len (load buf))
          nm (sconcat a "l_vtable." (i64->str a (.nglob g)))]
      (set! (.nglob g) (primitive/iadd (.nglob g) 1))
      (let [n (len (load methods))
            (mut i) 0]
        (loop (if (>= (load i) n)
                  (break)
                  (do
                    (let [mnm (get (load methods) (load i))
                          msi (g-sig-idx g mnm)]
                      (when (< msi (primitive/cast i64 0)) (cga-fail2 "make-dyn: unknown method " mnm))
                      (mobj-add-reloc! (mut (.obj g))
                                       (.datasec g)
                                       (len (load buf))
                                       (.symidx (al-at [GSig] (field g sigs) msi))
                                       (reloc-unsigned)
                                       false
                                       3)
                      (b-u64! (mut buf) 0))
                    (set! i (primitive/iadd (load i) 1))))))
      (let [vtsym (mobj-add-sym! (mut (.obj g)) nm (.datasec g) vtoff false)
            iav (emit-expr g inner)
            slot (slot-new! g 16 8)]
        ; dyn object { data, vtable } by value
        (av-to-x! g iav 9)
        (emit-store-int! g 9 28 slot 8)
        (emit-sym-addr! g 9 vtsym)
        (emit-store-int! g 9 28 (primitive/iadd slot 8) 8)
        (mk-aval 1 slot (TStruct ds))))))

(defn emit-dyn-dispatch [(g (ptr Cga))
                         (_ds (slice u8))
                         (_vt (slice u8))
                         (mi i64)
                         (_cc (slice u8))
                         (params (ptr (ArrayList Type)))
                         (ret Type)
                         (recv (ptr Expr))
                         (args (ptr (ArrayList Expr)))] (-> AVal)
  (let [a (.a g)
        rav (emit-expr g recv)
        rslot (av-slot! g rav)
        ; fnptr = vtable[mi]
        fpslot (slot-new! g 8 8)
        dataslot (slot-new! g 8 8)]
    ; data ptr
    (emit-load-int! g 9 28 rslot 8 false)
    (emit-store-int! g 9 28 dataslot 8)
    ; vtable -> method fnptr
    (emit-load-int! g 9 28 (primitive/iadd rslot 8) 8 false)
    (a64-w! (mut (.asm g)) (a64-ldr-x 9 9 (primitive/imul mi 8)))
    (emit-store-int! g 9 28 fpslot 8)
    ; assemble [data, args...] and the full param list [ptr, params...]
    (let [(mut avs) (al-new [AVal] a)
          (mut ptys) (al-new [Type] a)
          fpav (primitive/alloc-stack AVal)]
      (push! (mut ptys) (TPtr (box-type a (TInt 8 true))))
      (let [np (len (load params))
            (mut i) 0]
        (loop (if (>= (load i) np)
                  (break)
                  (do
                    (push! (mut ptys) (get (load params) (load i)))
                    (set! i (primitive/iadd (load i) 1))))))
      (push! (mut avs) (mk-aval 1 dataslot (TPtr (box-type a (TInt 8 true)))))
      (let [na (len (load args))
            (mut i) 0]
        (loop (if (>= (load i) na)
                  (break)
                  (do
                    (push! (mut avs) (emit-expr g (al-at [Expr] args (load i))))
                    (set! i (primitive/iadd (load i) 1))))))
      (set! fpav
            (mk-aval 1
                     fpslot
                     (TFn
                       :cc "c"
                       :params (box-al [Type] a (load ptys))
                       :ret (box-type a ret))))
      (emit-call! g
                  -1
                  fpav
                  (box-al [Type] a (load ptys))
                  false
                  ret
                  (box-al [AVal] a (load avs))))))

; parse a (possibly negative) decimal integer token — llvm-ir literals.
(defn str->i64 [(s (slice u8))] (-> i64)
  (let [n (len s)
        neg (and (> n (primitive/cast i64 0)) (= (primitive/cast i64 (get s 0)) (primitive/cast i64 45)))
        (mut i) (when neg 1)
        (mut v) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (let [c (primitive/cast i64 (get s (load i)))]
                  (if (or (< c (primitive/cast i64 48)) (> c (primitive/cast i64 57)))
                      (cga-fail2 "not an integer token: " s)
                      (set! v (primitive/iadd (primitive/imul (load v) 10) (primitive/isub c 48)))))
                (set! i (primitive/iadd (load i) 1)))))
    (if neg (primitive/isub 0 (load v)) (load v))))

; ============================ inline LLVM-IR subset ==========================
; The corpus' (primitive/llvm-ir ...) bodies are straight-line SSA — no control flow, no
; phi (verified inventory: slice/atomic/simd/mmio helpers). We lower them
; structurally. Anything outside the implemented subset is a HARD ERROR that
; prints the offending line.

; tokenizer: split on whitespace and commas; '{', '}', '<', '>' self-delimit.
(defn ir-tokens [(a (dyn Allocator)) (line (slice u8))] (-> (ptr (ArrayList (slice u8))))
  (let [(mut toks) (al-new [(slice u8)] a)
        n (len line)
        (mut i) 0
        (mut start) -1]
    (loop (if (>= (load i) n)
              (do
                (when (>= (load start) (primitive/cast i64 0)) (push! (mut toks) (subslice line (load start) n)))
                (break))
              (do
                (let [c (primitive/cast i64 (get line (load i)))]
                  (if (or (or (= c (primitive/cast i64 32)) (= c (primitive/cast i64 9))) (= c (primitive/cast i64 44)))
                      (do
                        (when (>= (load start) (primitive/cast i64 0))
                          (push! (mut toks) (subslice line (load start) (load i)))
                          0)
                        (set! start -1)
                        0)
                      (if (or (or (or (= c (primitive/cast i64 123)) (= c (primitive/cast i64 125)))
                                  (or (= c (primitive/cast i64 40)) (= c (primitive/cast i64 41))))
                              (or (= c (primitive/cast i64 60)) (= c (primitive/cast i64 62))))
                          (do
                            (when (>= (load start) (primitive/cast i64 0))
                              (push! (mut toks) (subslice line (load start) (load i)))
                              0)
                            (push! (mut toks) (subslice line (load i) (primitive/iadd (load i) 1)))
                            (set! start -1)
                            0)
                          (do (when (< (load start) (primitive/cast i64 0)) (store! start (load i))) 0))))
                (set! i (primitive/iadd (load i) 1)))))
    (box-al [(slice u8)] a (load toks))))

; parse an IR type token in the context of (result type, arg types).
; tokp = index of the first token of the type; returns the Type and advances
; *tokp past it. Handles $ret/$tN/i1/i8/i16/i32/i64/float/double/ptr and
; "{ ... }" / "< N x T >" forms (mapped to synthetic Coil types).
(defn ir-parse-type [(g (ptr Cga))
                     (result Type)
                     (argtys (ptr (ArrayList Type)))
                     (toks (ptr (ArrayList (slice u8))))
                     (tokp (ptr i64))] (-> Type)
  (let [a (.a g)
        tk (get (load toks) (load tokp))]
    (set! tokp (primitive/iadd (load tokp) 1))
    (cond (= tk "$ret") result
          (= tk "i64") (TInt 64 true)
          (= tk "i32") (TInt 32 true)
          (= tk "i16") (TInt 16 true)
          (= tk "i8") (TInt 8 true)
          (= tk "i1") (TBool)
          (= tk "ptr") (TPtr (box-type a (TInt 8 true)))
          (= tk "float") (TFloat 32)
          (= tk "double") (TFloat 64)
          (= tk "{")  ; consume a literal struct type; used only for cmpxchg
          ; results ({i64,i1}/{ptr,i1}) — treat as 16-byte pair
          (let [t0 (ir-parse-type g result argtys toks tokp)
                t1 (ir-parse-type g result argtys toks tokp)]
            ; skip the closing }
            (store! tokp (primitive/iadd (load tokp) 1))
            ; a synthetic slice-shaped pair: elem 0 = t0, elem 1 = t1
            (TSlice (box-type a t0)))
            (= tk "<")
          (let [nstr (get (load toks) (load tokp))]
            (store! tokp (primitive/iadd (load tokp) 1))  ; N
            (store! tokp (primitive/iadd (load tokp) 1))  ; x
            (let [elem (ir-parse-type g result argtys toks tokp)]
              (store! tokp (primitive/iadd (load tokp) 1))  ; >
              (TVec (box-type a elem) (str->i64 nstr))))
            (and (>= (len tk) (primitive/cast i64 3))
                 (and (= (primitive/cast i64 (get tk 0)) (primitive/cast i64 36))
                      (= (primitive/cast i64 (get tk 1)) (primitive/cast i64 116))))  ; $tN
          (get (load argtys) (str->i64 (subslice tk 2 (len tk)))) :else
          (do
            (cga-fail2 "llvm-ir: unsupported type token: " tk)
            (TInt 64 true)))))

; aggregate element info for extractvalue/insertvalue: given the agg type and
; element index, produce (offset, element type).
(defn ir-agg-elem [(g (ptr Cga)) (t (ptr Type)) (idx i64) (offp (ptr i64))] (-> Type)
  (match (load t)
    (TSlice [elem]
            (if (= idx (primitive/cast i64 0))
                (do (set! offp 0) (TPtr elem))
                (do (set! offp 8) (TInt 64 true))))
    (TStruct [nm]
             (let [si (g-struct-idx g nm)]
               (when (< si (primitive/cast i64 0)) (cga-fail2 "llvm-ir: extract from unknown struct " nm))
               (set! offp (g-field-off g si idx))
               (.ty (al-at [Field]
                           (load (field (struct-at (field g
                                                          layouts)
                                                   si)
                                        fields))
                           idx))))
    (_ (do
         (cga-fail "llvm-ir: extract/insert on unsupported aggregate")
         (TInt 64 true)))))

; resolve a VALUE token: %name (env), $N (arg), integer literal, undef/zeroinitializer.
(defn ir-value [(g (ptr Cga))
                (env (ptr GScope))
                (avs (ptr (ArrayList AVal)))
                (tk (slice u8))
                (t Type)] (-> AVal)
  (let [tp (primitive/alloc-stack Type)]
    (set! tp t)
    (cond (= (primitive/cast i64 (get tk 0)) (primitive/cast i64 37))  ; %
            (match (gscope-get env tk)
              (Some [av] av)
              (None [] (do (cga-fail2 "llvm-ir: undefined value " tk) (mk-aval 0 0 (TInt 64 true)))))
          (= (primitive/cast i64 (get tk 0)) (primitive/cast i64 36))  ; $N
            (get (load avs) (str->i64 (subslice tk 1 (len tk))))
          (= tk "undef") (mk-aval 1 (slot-for-ty! g tp) t)
          ; fresh, uninitialized slot
          (= tk "zeroinitializer")
            (let [slot (slot-for-ty! g tp)]
              (emit-zero! g slot (ty-size g tp))
              (mk-aval 1 slot t))
          :else  ; integer literal (also covers negative)
            (mk-aval 0 (str->i64 tk) t))))

; Alias-aware accesses differ from ordinary Coil load/store only in LLVM metadata.
; Native machine code has no corresponding annotation, so lower the same scalar
; memory operations directly instead of feeding their synthetic opcode names to
; the textual llvm-ir compatibility parser below.
(defn emit-alias-memory [(g (ptr Cga))
                         (result Type)
                         (args (ptr (ArrayList Expr)))
                         (store bool)] (-> AVal)
  (if store
      (let [pav (emit-expr g (al-at [Expr] args 0))
            vav (emit-expr g (al-at [Expr] args 1))
            t (primitive/alloc-stack Type)]
        (set! t (av-ty vav))
        (let [sz (ty-size g t)]
          (av-to-x! g vav 10)
          (av-to-x! g pav 9)
          (emit-store-to-mem! g 10 9 sz)
          (mk-aval 0 0 (TInt 64 true))))
      (let [pav (emit-expr g (al-at [Expr] args 0))
            t (primitive/alloc-stack Type)]
        (set! t result)
        (let [sz (ty-size g t)
              slot (slot-for-ty! g t)]
          (av-to-x! g pav 9)
          (emit-load-from-mem! g 10 9 sz)
          (emit-store-int! g 10 28 slot sz)
          (mk-aval 1 slot result)))))

(defn emit-llvmir [(g (ptr Cga)) (result Type) (args (ptr (ArrayList Expr))) (body (slice u8))] (-> AVal)
  (cond (= body "coil.mem.alias-load") (emit-alias-memory g result args false)
        (= body "coil.mem.alias-store") (emit-alias-memory g result args true)
        :else
          (let [a (load (field g a))
                (mut avs) (al-new [AVal] a)
                (mut argtys) (al-new [Type] a)
                n (len (load args))
                (mut i) 0]
            (loop (if (>= (load i) n)
                      (break)
                      (do
                        (let [av (emit-expr g (al-at [Expr] args (load i)))]
                          (push! (mut avs) av)
                          (push! (mut argtys) (av-ty av)))
                        (set! i (primitive/iadd (load i) 1)))))
            (let [avsp (box-al [AVal] a (load avs))
                  argtysp (box-al [Type] a (load argtys))
                  envp (primitive/alloc-stack (ptr GScope))
                  retp (primitive/alloc-stack AVal)
                  donep (primitive/alloc-stack bool)
                  blen (len body)
                  (mut pos) 0]
              (set! envp (gscope-nil a))
              (set! retp (mk-aval 0 0 (TInt 64 true)))
              (set! donep false)
              (loop (if (>= (load pos) blen)
                        (break)
                        (do
                          (let [(mut eol) (load pos)]
                            (loop (if (or (>= (load eol) blen)
                                          (= (primitive/cast i64 (get body (load eol))) (primitive/cast i64 10)))
                                      (break)
                                      (set! eol (primitive/iadd (load eol) 1))))
                            (let [line (subslice body (load pos) (load eol))]
                              (set! pos (primitive/iadd (load eol) 1))
                              (unless (= (len line) (primitive/cast i64 0))
                                (if (load donep)
                                    (cga-fail2 "llvm-ir: code after ret: " line)
                                    (emit-ir-line! g envp avsp argtysp result retp donep line)))))
                          0)))
              (unless (load donep) (cga-fail "llvm-ir: body did not ret"))
              (load retp)))))

; per-lane float op over vector slots: op 0 add, 1 sub, 2 mul.
(defn emit-vec-fbin! [(g (ptr Cga)) (op i64) (dst i64) (asrc i64) (bsrc i64) (lanes i64) (lb i64)] (-> i64)
  (let [s (field g asm)
        fty (unless (= lb (primitive/cast i64 4)) 1)
        (mut k) 0]
    (loop (if (>= (load k) lanes)
              (break)
              (do
                (emit-load-fp! g 0 28 (primitive/iadd asrc (primitive/imul (load k) lb)) lb)
                (emit-load-fp! g 1 28 (primitive/iadd bsrc (primitive/imul (load k) lb)) lb)
                (if (= op (primitive/cast i64 0))
                    (a64-w! (mut s) (a64-fadd fty 0 0 1))
                    (if (= op (primitive/cast i64 1))
                        (a64-w! (mut s) (a64-fsub fty 0 0 1))
                        (a64-w! (mut s) (a64-fmul fty 0 0 1))))
                (emit-store-fp! g 0 28 (primitive/iadd dst (primitive/imul (load k) lb)) lb)
                (set! k (primitive/iadd (load k) 1)))))
    0))

; one line of the inline-IR subset. Sets *donep and *retp on `ret`.
(defn emit-ir-line! [(g (ptr Cga))
                     (envp (ptr (ptr GScope)))
                     (avsp (ptr (ArrayList AVal)))
                     (argtysp (ptr (ArrayList Type)))
                     (result Type)
                     (retp (ptr AVal))
                     (donep (ptr bool))
                     (line (slice u8))] (-> i64)
  (let [a (.a g)
        s (field g asm)
        toks (ir-tokens a line)
        ntk (len (load toks))]
    (unless (= ntk (primitive/cast i64 0))
      (let [t0 (get (load toks) 0)]
        (cond (= t0 "declare") 0
              ; hoisted intrinsic declaration — the ops lower structurally
              (= t0 "ret")
                (let [tokp (primitive/alloc-stack i64)]
                  (store! tokp 1)
                  (let [rt (ir-parse-type g result argtysp toks tokp)
                        av
                          (ir-value g
                                    (load envp)
                                    avsp
                                    (get (load toks) (load tokp))
                                    rt)]
                    (store! retp (mk-aval (av-kind av) (av-v av) result))
                    (store! donep true)
                    0))
              (= t0 "store")  ; store atomic TYPE VAL, ptr PTR seq_cst, align N
                (if (and (>= ntk (primitive/cast i64 7)) (= (get (load toks) 1) "atomic"))
                    (let [tokp (primitive/alloc-stack i64)]
                      (store! tokp 2)
                      (let [vt (ir-parse-type g result argtysp toks tokp)
                            vav
                              (ir-value g
                                        (load envp)
                                        avsp
                                        (get (load toks) (load tokp))
                                        vt)
                            pav
                              (ir-value g
                                        (load envp)
                                        avsp
                                        (get (load toks) (primitive/iadd (load tokp) 2))
                                        (TPtr (box-type a (TInt 8 true))))]
                        (av-to-x! g vav 10)
                        (av-to-x! g pav 9)
                        (a64-w! (mut s) (a64-stlr 10 9))
                        0))
                    (cga-fail2 "llvm-ir: unsupported store line: " line))
              (and (>= ntk (primitive/cast i64 3)) (= (primitive/cast i64 (get t0 0)) (primitive/cast i64 37)))
                (let [op (get (load toks) 2)]
                  (cond (= op "extractvalue")
                          (let [tokp (primitive/alloc-stack i64)]
                            (store! tokp 3)
                            (let [aggty (ir-parse-type g result argtysp toks tokp)
                                  vtk (get (load toks) (load tokp))
                                  idx (str->i64 (get (load toks) (primitive/iadd (load tokp) 1)))
                                  av (ir-value g (load envp) avsp vtk aggty)
                                  atp (primitive/alloc-stack Type)]
                              (store! atp aggty)
                              (let [offp (primitive/alloc-stack i64)
                                    ety (ir-agg-elem g atp idx offp)
                                    etp (primitive/alloc-stack Type)]
                                (store! etp ety)
                                (let [eslot (slot-for-ty! g etp)]
                                  (emit-copy! g eslot (primitive/iadd (av-slot! g av) (load offp)) (ty-size g etp))
                                  (store! envp (gscope-put a (load envp) t0 (mk-aval 1 eslot ety)))
                                  0))))
                        (= op "insertvalue")
                          (let [tokp (primitive/alloc-stack i64)]
                            (store! tokp 3)
                            (let [aggty (ir-parse-type g result argtysp toks tokp)
                                  aggtk (get (load toks) (load tokp))]
                              (store! tokp (primitive/iadd (load tokp) 1))
                              (let [aggav (ir-value g (load envp) avsp aggtk aggty)
                                    elty (ir-parse-type g result argtysp toks tokp)
                                    eltk (get (load toks) (load tokp))
                                    idx (str->i64 (get (load toks) (primitive/iadd (load tokp) 1)))
                                    eav (ir-value g (load envp) avsp eltk elty)
                                    atp (primitive/alloc-stack Type)]
                                (store! atp aggty)
                                (let [dslot (slot-for-ty! g atp)
                                      offp (primitive/alloc-stack i64)]
                                  (emit-copy! g dslot (av-slot! g aggav) (ty-size g atp))
                                  (ir-agg-elem g atp idx offp)
                                  (emit-store-av-at! g eav (primitive/iadd dslot (load offp)))
                                  (store! envp (gscope-put a (load envp) t0 (mk-aval 1 dslot aggty)))
                                  0))))
                        (= op "atomicrmw")  ; %old = atomicrmw SUB ptr PTR, TYPE VAL seq_cst
                          (let [sub (get (load toks) 3)
                                pav
                                  (ir-value g
                                            (load envp)
                                            avsp
                                            (get (load toks) 5)
                                            (TPtr (box-type a (TInt 8 true))))
                                tokp (primitive/alloc-stack i64)]
                            (store! tokp 6)
                            (let [vt (ir-parse-type g result argtysp toks tokp)
                                  vav
                                    (ir-value g
                                              (load envp)
                                              avsp
                                              (get (load toks) (load tokp))
                                              vt)
                                  vtp (primitive/alloc-stack Type)]
                              (store! vtp vt)
                              (av-to-x! g pav 9)
                              (av-to-x! g vav 10)
                              (cond (= sub "add") 0
                                    (= sub "sub") (do (a64-w! (mut s) (a64-neg 10 10)) 0)
                                    (= sub "xchg") 0
                                    :else (cga-fail2 "llvm-ir: unsupported atomicrmw op: " sub))
                              (if (= sub "xchg")
                                  (a64-w! (mut s) (a64-swpal 10 11 9))
                                  (a64-w! (mut s) (a64-ldaddal 10 11 9)))
                              (let [slot (slot-for-ty! g vtp)]
                                (emit-store-int! g 11 28 slot (ty-size g vtp))
                                (store! envp (gscope-put a (load envp) t0 (mk-aval 1 slot vt)))
                                0)))
                        (= op "cmpxchg")  ; %r = cmpxchg ptr PTR, TYPE EXP, TYPE NEW seq_cst seq_cst
                          (let [pav
                                  (ir-value g
                                            (load envp)
                                            avsp
                                            (get (load toks) 4)
                                            (TPtr (box-type a (TInt 8 true))))
                                tokp (primitive/alloc-stack i64)]
                            (store! tokp 5)
                            (let [et (ir-parse-type g result argtysp toks tokp)
                                  eav
                                    (ir-value g
                                              (load envp)
                                              avsp
                                              (get (load toks) (load tokp))
                                              et)]
                              (store! tokp (primitive/iadd (load tokp) 1))
                              (let [nt (ir-parse-type g result argtysp toks tokp)
                                    nav
                                      (ir-value g
                                                (load envp)
                                                avsp
                                                (get (load toks) (load tokp))
                                                nt)]
                                (av-to-x! g pav 9)
                                (av-to-x! g eav 10)  ; expected (in/out)
                                (av-to-x! g nav 11)  ; new
                                (a64-w! (mut s) (a64-mov-reg 12 10))  ; original expected
                                (a64-w! (mut s) (a64-casal 10 11 9))
                                ; pair {old, success}: old at +0, success bit at +8
                                (let [slot (slot-new! g 16 8)]
                                  (emit-store-int! g 10 28 slot 8)
                                  (a64-w! (mut s) (a64-cmp-reg 10 12))
                                  (a64-w! (mut s) (a64-cset 13 (cond-eq)))
                                  (emit-store-int! g 13 28 (primitive/iadd slot 8) 8)
                                  (store! envp
                                          (gscope-put a
                                                      (load envp)
                                                      t0
                                                      (mk-aval 1 slot (TSlice (box-type a et)))))
                                  0))))
                        (= op "load")  ; %v = load atomic TYPE, ptr PTR seq_cst, align N
                          (if (= (get (load toks) 3) "atomic")
                              (let [tokp (primitive/alloc-stack i64)]
                                (store! tokp 4)
                                (let [vt (ir-parse-type g result argtysp toks tokp)
                                      vtp (primitive/alloc-stack Type)]
                                  (store! vtp vt)
                                  ; skip the "ptr" token
                                  (let [pav
                                          (ir-value g
                                                    (load envp)
                                                    avsp
                                                    (get (load toks) (primitive/iadd (load tokp) 1))
                                                    (TPtr (box-type a (TInt 8 true))))]
                                    (av-to-x! g pav 9)
                                    (a64-w! (mut s) (a64-ldar 10 9))
                                    (let [slot (slot-for-ty! g vtp)]
                                      (emit-store-int! g 10 28 slot (ty-size g vtp))
                                      (store! envp (gscope-put a (load envp) t0 (mk-aval 1 slot vt)))
                                      0))))
                              (cga-fail2 "llvm-ir: unsupported load line: " line))
                        (= op "insertelement")  ; %v = insertelement <N x T> AGG, ET EV, i32 K
                          (let [tokp (primitive/alloc-stack i64)]
                            (store! tokp 3)
                            (let [vty (ir-parse-type g result argtysp toks tokp)
                                  aggtk (get (load toks) (load tokp))]
                              (store! tokp (primitive/iadd (load tokp) 1))
                              (let [aggav (ir-value g (load envp) avsp aggtk vty)
                                    elty (ir-parse-type g result argtysp toks tokp)
                                    eav
                                      (ir-value g
                                                (load envp)
                                                avsp
                                                (get (load toks) (load tokp))
                                                elty)
                                    k (str->i64 (get (load toks) (primitive/iadd (load tokp) 2)))
                                    vtp (primitive/alloc-stack Type)
                                    etp (primitive/alloc-stack Type)]
                                (store! vtp vty)
                                (store! etp elty)
                                (let [lb (ty-size g etp)
                                      dslot (slot-for-ty! g vtp)]
                                  (emit-copy! g dslot (av-slot! g aggav) (ty-size g vtp))
                                  (av-to-d! g eav 0)
                                  (emit-store-fp! g 0 28 (primitive/iadd dslot (primitive/imul k lb)) lb)
                                  (store! envp (gscope-put a (load envp) t0 (mk-aval 1 dslot vty)))
                                  0))))
                        (= op "shufflevector")  ; splat: %r = shufflevector <..> V, <..> undef, <4 x i32> zeroinitializer
                          (let [tokp (primitive/alloc-stack i64)]
                            (store! tokp 3)
                            (let [vty (ir-parse-type g result argtysp toks tokp)
                                  vav
                                    (ir-value g
                                              (load envp)
                                              avsp
                                              (get (load toks) (load tokp))
                                              vty)]
                              (store! tokp (primitive/iadd (load tokp) 1))
                              (ir-parse-type g result argtysp toks tokp)  ; second operand type
                              (store! tokp (primitive/iadd (load tokp) 1))  ; undef
                              (ir-parse-type g result argtysp toks tokp)  ; mask type
                              (unless (= (get (load toks) (load tokp)) "zeroinitializer")
                                (cga-fail2 "llvm-ir: only splat shuffles supported: "
                                           line))
                              (let [vtp (primitive/alloc-stack Type)]
                                (store! vtp vty)
                                (match vty
                                  (TVec [elem lanes]
                                        (let [lb (ty-size g elem)
                                              src (av-slot! g vav)
                                              dslot (slot-for-ty! g vtp)
                                              (mut k) 0]
                                          (emit-load-fp! g 0 28 src lb)
                                          (loop (if (>= (load k) lanes)
                                                    (break)
                                                    (do
                                                      (emit-store-fp! g
                                                                      0
                                                                      28
                                                                      (primitive/iadd dslot
                                                                                      (primitive/imul (load k)
                                                                                                      lb))
                                                                      lb)
                                                      (store! k (primitive/iadd (load k) 1)))))
                                          (store! envp
                                                  (gscope-put a
                                                              (load envp)
                                                              t0
                                                              (mk-aval 1
                                                                       dslot
                                                                       vty)))
                                          0))
                                  (_ (cga-fail "llvm-ir: shufflevector on non-vector"))))))
                        (or (or (= op "fadd") (= op "fsub"))
                            (= op "fmul"))
                          (let [tokp (primitive/alloc-stack i64)
                                opn (unless (= op "fadd") (if (= op "fsub") 1 2))]
                            (store! tokp 3)
                            (let [vty (ir-parse-type g result argtysp toks tokp)
                                  aav
                                    (ir-value g
                                              (load envp)
                                              avsp
                                              (get (load toks) (load tokp))
                                              vty)
                                  bav
                                    (ir-value g
                                              (load envp)
                                              avsp
                                              (get (load toks) (primitive/iadd (load tokp) 1))
                                              vty)
                                  vtp (primitive/alloc-stack Type)]
                              (store! vtp vty)
                              (match vty
                                (TVec [elem lanes]
                                      (let [lb (ty-size g elem)
                                            dslot (slot-for-ty! g vtp)]
                                        (emit-vec-fbin! g
                                                        opn
                                                        dslot
                                                        (av-slot! g aav)
                                                        (av-slot! g bav)
                                                        lanes
                                                        lb)
                                        (store! envp
                                                (gscope-put a
                                                            (load envp)
                                                            t0
                                                            (mk-aval 1
                                                                     dslot
                                                                     vty)))
                                        0))
                                (TFloat [bits]
                                        (let [fty (unless (= bits (primitive/cast i64 32)) 1)
                                              dslot (slot-for-ty! g vtp)]
                                          (av-to-d! g aav 0)
                                          (av-to-d! g bav 1)
                                          (if (= opn (primitive/cast i64 0))
                                              (a64-w! (mut s)
                                                      (a64-fadd fty 0 0 1))
                                              (if (= opn (primitive/cast i64 1))
                                                  (a64-w! (mut s)
                                                          (a64-fsub fty
                                                                    0
                                                                    0
                                                                    1))
                                                  (a64-w! (mut s)
                                                          (a64-fmul fty
                                                                    0
                                                                    0
                                                                    1))))
                                          (emit-store-fp! g
                                                          0
                                                          28
                                                          dslot
                                                          (primitive/idiv bits 8))
                                          (store! envp
                                                  (gscope-put a
                                                              (load envp)
                                                              t0
                                                              (mk-aval 1
                                                                       dslot
                                                                       vty)))
                                          0))
                                (_ (cga-fail "llvm-ir: float op on unsupported type")))))
                        (= op "call") (emit-ir-call! g envp avsp argtysp result toks t0 line)
                        :else (cga-fail2 "llvm-ir: unsupported op: " op)))
              :else (cga-fail2 "llvm-ir: unsupported line: " line))))))

; intrinsic calls: @llvm.fma.v4f32 and @llvm.vector.reduce.fadd.v4f32
(defn emit-ir-call! [(g (ptr Cga))
                     (envp (ptr (ptr GScope)))
                     (avsp (ptr (ArrayList AVal)))
                     (argtysp (ptr (ArrayList Type)))
                     (result Type)
                     (toks (ptr (ArrayList (slice u8))))
                     (t0 (slice u8))
                     (line (slice u8))] (-> i64)
  (let [a (.a g)
        s (field g asm)
        tokp (primitive/alloc-stack i64)]
    (set! tokp 3)
    (let [rty (ir-parse-type g result argtysp toks tokp)
          callee (get (load toks) (load tokp))]
      (if (= callee "@llvm.fma.v4f32")
          ; ( $t0 $0 $t1 $1 $t2 $2 ) -> per-lane single-rounding fmadd
          (let [rtp (primitive/alloc-stack Type)]
            (set! rtp rty)
            (set! tokp (primitive/iadd (load tokp) 2))  ; skip "("
            (let [t1 (ir-parse-type g result argtysp toks tokp)
                  aav (ir-value g (load envp) avsp (get (load toks) (load tokp)) t1)]
              (set! tokp (primitive/iadd (load tokp) 1))
              (let [t2 (ir-parse-type g result argtysp toks tokp)
                    bav (ir-value g (load envp) avsp (get (load toks) (load tokp)) t2)]
                (set! tokp (primitive/iadd (load tokp) 1))
                (let [t3 (ir-parse-type g result argtysp toks tokp)
                      cav (ir-value g (load envp) avsp (get (load toks) (load tokp)) t3)]
                  (match rty
                    (TVec [elem lanes]
                          (let [lb (ty-size g elem)
                                fty (unless (= lb (primitive/cast i64 4)) 1)
                                asrc (av-slot! g aav)
                                bsrc (av-slot! g bav)
                                csrc (av-slot! g cav)
                                dslot (slot-for-ty! g rtp)
                                (mut k) 0]
                            (loop (if (>= (load k) lanes)
                                      (break)
                                      (do
                                        (emit-load-fp! g 0 28 (primitive/iadd asrc (primitive/imul (load k) lb)) lb)
                                        (emit-load-fp! g 1 28 (primitive/iadd bsrc (primitive/imul (load k) lb)) lb)
                                        (emit-load-fp! g 2 28 (primitive/iadd csrc (primitive/imul (load k) lb)) lb)
                                        (a64-w! (mut s) (a64-fmadd fty 0 0 1 2))
                                        (emit-store-fp! g 0 28 (primitive/iadd dslot (primitive/imul (load k) lb)) lb)
                                        (set! k (primitive/iadd (load k) 1)))))
                            (set! envp (gscope-put a (load envp) t0 (mk-aval 1 dslot rty)))
                            0))
                    (_ (cga-fail "llvm-ir: fma on non-vector")))))))
          (if (= callee "@llvm.vector.reduce.fadd.v4f32")
              ; ( float 0.0 $t0 $0 ) -> strict sequential reduce from 0.0
              (let [rtp (primitive/alloc-stack Type)]
                (set! rtp rty)
                (set! tokp (primitive/iadd (load tokp) 2))  ; skip "("
                (ir-parse-type g result argtysp toks tokp)  ; float
                (unless (= (get (load toks) (load tokp)) "0.0")
                  (cga-fail2 "llvm-ir: reduce.fadd start must be 0.0: " line))
                (set! tokp (primitive/iadd (load tokp) 1))
                (let [vt (ir-parse-type g result argtysp toks tokp)
                      vav (ir-value g (load envp) avsp (get (load toks) (load tokp)) vt)]
                  (match vt
                    (TVec [elem lanes]
                          (let [lb (ty-size g elem)
                                fty (unless (= lb (primitive/cast i64 4)) 1)
                                src (av-slot! g vav)
                                dslot (slot-for-ty! g rtp)
                                (mut k) 0]
                            ; s0 = +0.0 (all-zero bits)
                            (a64-w! (mut s)
                                    (if (= lb (primitive/cast i64 4)) (a64-fmov-w-to-fp 0 31) (a64-fmov-x-to-fp 0 31)))
                            (loop (if (>= (load k) lanes)
                                      (break)
                                      (do
                                        (emit-load-fp! g 1 28 (primitive/iadd src (primitive/imul (load k) lb)) lb)
                                        (a64-w! (mut s) (a64-fadd fty 0 0 1))
                                        (set! k (primitive/iadd (load k) 1)))))
                            (emit-store-fp! g 0 28 dslot lb)
                            (set! envp (gscope-put a (load envp) t0 (mk-aval 1 dslot rty)))
                            0))
                    (_ (cga-fail "llvm-ir: reduce on non-vector")))))
              (cga-fail2 "llvm-ir: unsupported intrinsic: " callee))))))

; ============================ static asserts =================================
; faithful port of codegen.coil const-eval (LLVM size/align/offset queries
; replaced by this backend's own layout — same natural-layout answers).
(defstruct GCEval [(v i64) (uns bool)])

(defn mk-gcev [(v i64) (u bool)] (-> GCEval)
  (let [p (primitive/alloc-stack GCEval)] (set! (.v p) v) (set! (.uns p) u) (load p)))

(defn gcev-v [(c GCEval)] (-> i64)
  (let [p (primitive/alloc-stack GCEval)] (set! p c) (.v p)))

(defn gcev-u [(c GCEval)] (-> bool)
  (let [p (primitive/alloc-stack GCEval)] (set! p c) (.uns p)))

(defn g-user-fail [(msg (slice u8))] (-> i64)
  (let [w (stderr)]
    (print-str w "error: ")
    (print-str w msg)
    (write-byte w (primitive/cast u8 10))
    (cga64.exit (primitive/cast i32 1))
    0))

(defn g-const-bin [(op i64) (l i64) (lu bool) (r i64) (ru bool)] (-> GCEval)
  (let [uns (or lu ru)]
    (mk-gcev (cond (= op (primitive/cast i64 0)) (primitive/iadd l r)
                   (= op (primitive/cast i64 1)) (primitive/isub l r)
                   (= op (primitive/cast i64 2)) (primitive/imul l r)
                   (= op (primitive/cast i64 7)) (primitive/iand l r)
                   (= op (primitive/cast i64 8)) (primitive/ior l r)
                   (= op (primitive/cast i64 9)) (primitive/ixor l r)
                   (= op (primitive/cast i64 10)) (primitive/ishl l r)
                   (= op (primitive/cast i64 11))
                     (if uns
                         (primitive/cast i64 (primitive/ishr (primitive/cast u64 l) (primitive/cast u64 r)))
                         (primitive/ishr l r))
                   (= op (primitive/cast i64 3))
                     (if (= r (primitive/cast i64 0))
                         (do (g-user-fail "static-assert: divide/mod by zero") 0)
                         (if uns (primitive/udiv l r) (primitive/idiv l r)))
                   (= op (primitive/cast i64 4))
                     (if (= r (primitive/cast i64 0))
                         (do (g-user-fail "static-assert: divide/mod by zero") 0)
                         (if uns (primitive/urem l r) (primitive/irem l r)))
                   (= op (primitive/cast i64 5))
                     (if (= r (primitive/cast i64 0))
                         (do (g-user-fail "static-assert: divide/mod by zero") 0)
                         (primitive/udiv l r))
                   (= r (primitive/cast i64 0)) (do (g-user-fail "static-assert: divide/mod by zero") 0)
                   :else (primitive/urem l r))
             uns)))

(defn g-const-cmp [(op i64) (l i64) (lu bool) (r i64) (ru bool)] (-> GCEval)
  (let [b
          (cond (or lu ru)
                  (let [lx (primitive/cast u64 l)
                        rx (primitive/cast u64 r)]
                    (cond (= op (primitive/cast i64 0)) (< lx rx)
                          (= op (primitive/cast i64 1)) (<= lx rx)
                          (= op (primitive/cast i64 2)) (> lx rx)
                          (= op (primitive/cast i64 3)) (>= lx rx)
                          (= op (primitive/cast i64 4)) (= lx rx)
                          :else (!= lx rx)))
                (= op (primitive/cast i64 0)) (< l r)
                (= op (primitive/cast i64 1)) (<= l r)
                (= op (primitive/cast i64 2)) (> l r)
                (= op (primitive/cast i64 3)) (>= l r)
                (= op (primitive/cast i64 4)) (= l r)
                :else (!= l r))]
    (mk-gcev (when b 1) false)))

(defn g-const-eval [(g (ptr Cga)) (e (ptr Expr))] (-> GCEval)
  (let [a (.a g)]
    (match (.kind e)
      (EInt [v] (mk-gcev v false))
      (EBool [b] (mk-gcev (when b 1) false))
      (EIf [c thn els]
           (if (!= (gcev-v (g-const-eval g c)) (primitive/cast i64 0)) (g-const-eval g thn) (g-const-eval g els)))
      (ESizeOf [t] (mk-gcev (ty-size g (box-type a t)) false))
      (EAlignOf [t] (mk-gcev (ty-align g (box-type a t)) false))
      (EOffsetOf [t fname]
                 (match t
                   (TStruct [nm]
                            (let [si (g-struct-idx g nm)]
                              (when (< si (primitive/cast i64 0)) (cga-fail2 "offset-of on unknown struct: " nm))
                              (mk-gcev (g-field-off g si (g-field-idx g si fname)) false)))
                   (_ (do (g-user-fail "static-assert: offset-of on non-struct") (mk-gcev 0 false)))))
      (ECast [t inner]
             (mk-gcev (gcev-v (g-const-eval g inner)) (match t (TInt [bits s] (not s)) (_ false))))
      (EBin [op lhs rhs]
            (let [lc (g-const-eval g lhs)
                  rc (g-const-eval g rhs)]
              (g-const-bin op (gcev-v lc) (gcev-u lc) (gcev-v rc) (gcev-u rc))))
      (ECmp [op lhs rhs]
            (let [lc (g-const-eval g lhs)
                  rc (g-const-eval g rhs)]
              (g-const-cmp op (gcev-v lc) (gcev-u lc) (gcev-v rc) (gcev-u rc))))
      (_ (do
           (g-user-fail "static-assert: only int literals, sizeof/alignof/offsetof, casts, arithmetic and comparisons are allowed")
           (mk-gcev 0 false))))))

(defn g-eval-asserts! [(g (ptr Cga)) (mp (ptr Program))] (-> i64)
  (let [asserts (load (field mp asserts))
        n (len (load asserts))
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (let [sa (al-at [StaticAssert] asserts (load i))]
                  (when (= (gcev-v (g-const-eval g (field sa cnd))) (primitive/cast i64 0))
                    (let [w (stderr)]
                      (print-str w "error: static assertion failed: ")
                      (print-str w (load (field sa msg)))
                      (write-byte w (primitive/cast u8 10))
                      (cga64.exit (primitive/cast i32 1))
                      0)))
                (set! i (primitive/iadd (load i) 1))))))
  0)

; ============================ function emission ==============================
(defn emit-func! [(g (ptr Cga)) (fd (ptr Func))] (-> i64)
  ; reset per-function state
  (set! (.frame g) 0)
  (set! (.dwcursrc g) -1)
  (set! (.dwcurlo g) -1)
  (set! (.env g) (gscope-nil (.a g)))
  (set! (.len (.loops g)) 0)
  (set! (.terminated g) false)
  (set! (.retty g) (.ret fd))
  (set! (.sretslot g) -1)
  (set! (.outbytes g) 0)
  (set! (.nstatic g) 0)
  ; self-tail-call state, fresh per function
  (set! (.selfname g) (.name fd))
  (set! (.tailok g) false)
  (set! (.inline_depth g) 0)
  (store! (field g tailslots)
          (box! (load (field g a)) (ArrayList i64) (al-new [i64] (load (field g a)))))
  (store! (field g tailtys)
          (box! (load (field g a)) (ArrayList Type) (al-new [Type] (load (field g a)))))
  (set! (.entrylabel g) (a64-new-label (mut (.asm g))))
  (let [s (field g asm)
        a (.a g)
        si (g-sig-idx g (.name fd))]
    (when (< si (primitive/cast i64 0)) (cga-fail2 "emit-func!: unregistered function " (load (field fd name))))
    ; pin the symbol to the function start (a :shim function's BODY is the
    ; __impl symbol; the Coil name gets the trampoline emitted afterwards)
    (mobj-set-sym! (mut (.obj g))
                   (if (.shim (al-at [GSig] (field g sigs) si))
                       (.implsym (al-at [GSig] (field g sigs) si))
                       (.symidx (al-at [GSig] (field g sigs) si)))
                   (.text g)
                   (a64-off (mut s)))
    (set! (.fnstart g) (a64-off (mut s)))
    ; line row at the function entry (its defn line) — the prologue-end row
    ; after param intake then tells lldb where breakpoints should land
    (when (>= (load (field fd source)) (primitive/cast i64 0))
      (let [ev (primitive/alloc-stack DwLineEv)]
        (store! (field ev textoff) (a64-off (mut s)))
        (store! (field ev source) (load (field fd source)))
        (store! (field ev lo)
                (if (< (load (field fd lo)) (primitive/cast i64 0))
                    0
                    (do
                      (load (field fd
                                   lo)))))
        (store! (field ev pe) false)
        (push! (mut (field g dwevs)) (load ev))
        (store! (field g dwcursrc) (load (field fd source)))
        (store! (field g dwcurlo) (load (field ev lo)))
        0))
    (let [dwvarlo (len (.dwvars g))
          dwfnlo (.lo fd)
          dwfnsrc (.source fd)]
      ; ---- prologue (frame sizes patched at the end)
      (a64-w! (mut s) (a64-stp-pre 29 30 31 -16))
      (a64-w! (mut s) (a64-mov-sp 29 31))
      ; save x28 (16B for alignment)
      (a64-w! (mut s) (a64-ldstp 3 0 28 31 31 -2))  ; stp x28, xzr, [sp, #-16]!
      (let [p1 (a64-off (mut s))]
        (a64-w! (mut s) (a64-sub-imm-lsl12 31 31 0))  ; sub sp, sp, #hi, lsl 12
        (a64-w! (mut s) (a64-sub-imm 31 31 0))  ; sub sp, sp, #lo
        (a64-w! (mut s) (a64-add-imm 28 31 0))  ; add x28, sp, #outbytes
        ; ---- parameter intake (mirror of the emit-call! plan)
        (let [retp (primitive/alloc-stack Type)]
          (set! retp (.ret fd))
          (let [retvoid (match (.ret fd) (TVoid [] true) (_ false))
                retinfo (if retvoid (mk-abi-scalar) (g-abi-info g retp))]
            ; incoming sret pointer
            (when (= (abi-cls retinfo) (primitive/cast i64 4))
              (let [ss (slot-new! g 8 8)]
                (emit-store-int! g 8 28 ss 8)
                (store! (field g sretslot) ss))
              0)
            (let [ps (load (field fd params))
                  np (len (load ps))
                  (mut gp) 0
                  (mut fp) 0
                  (mut stk) 0
                  (mut i) 0]
              (loop (if (>= (load i) np)
                        (break)
                        (do
                          (let [prm (al-at [Param] ps (load i))
                                t (field prm ty)
                                info (g-abi-info g t)
                                cls (abi-cls info)
                                slot (slot-for-ty! g t)
                                sz (ty-size g t)
                                _tailrec
                                  (do
                                    (push! (load (field g tailslots)) slot)
                                    (push! (load (field g tailtys)) (load t))
                                    0)]
                            (cond (= cls (primitive/cast i64 0))
                                    (if (< (load gp) (primitive/cast i64 8))
                                        (do
                                          (emit-store-int! g
                                                           (load gp)
                                                           28
                                                           slot
                                                           (if (ty-is-scalar t)
                                                               sz
                                                               (if (> sz (primitive/cast i64 8)) 8 sz)))
                                          (store! gp (primitive/iadd (load gp) 1))
                                          0)
                                        (do
                                          (emit-load-int! g 9 29 (primitive/iadd 16 (load stk)) 8 false)
                                          (emit-store-int! g 9 28 slot sz)
                                          (store! stk (primitive/iadd (load stk) 8))
                                          0))
                                  (= cls (primitive/cast i64 1))
                                    (if (< (load fp) (primitive/cast i64 8))
                                        (do
                                          (emit-store-fp! g (load fp) 28 slot (ty-float-bytes t))
                                          (store! fp (primitive/iadd (load fp) 1))
                                          0)
                                        (do
                                          (emit-load-int! g 9 29 (primitive/iadd 16 (load stk)) 8 false)
                                          (emit-store-int! g 9 28 slot sz)
                                          (store! stk (primitive/iadd (load stk) 8))
                                          0))
                                  (= cls (primitive/cast i64 2))
                                    (if (< (load gp) (primitive/cast i64 8))
                                        (do
                                          (emit-store-int! g (load gp) 28 slot 8)
                                          (store! gp (primitive/iadd (load gp) 1))
                                          0)
                                        (do
                                          (emit-load-int! g 9 29 (primitive/iadd 16 (load stk)) 8 false)
                                          (emit-store-int! g 9 28 slot 8)
                                          (store! stk (primitive/iadd (load stk) 8))
                                          0))
                                  (= cls (primitive/cast i64 3))
                                    (if (<= (load gp) (primitive/cast i64 6))
                                        (do
                                          (emit-store-int! g (load gp) 28 slot 8)
                                          (emit-store-int! g (primitive/iadd (load gp) 1) 28 (primitive/iadd slot 8) 8)
                                          (store! gp (primitive/iadd (load gp) 2))
                                          0)
                                        (do
                                          (store! stk
                                                  (primitive/imul (primitive/idiv (primitive/iadd (load stk) 15) 16) 16))
                                          (emit-load-int! g 9 29 (primitive/iadd 16 (load stk)) 8 false)
                                          (emit-store-int! g 9 28 slot 8)
                                          (emit-load-int! g 9 29 (primitive/iadd 24 (load stk)) 8 false)
                                          (emit-store-int! g 9 28 (primitive/iadd slot 8) 8)
                                          (store! stk (primitive/iadd (load stk) 16))
                                          (store! gp 8)
                                          0))
                                  (= cls (primitive/cast i64 5))
                                    (let [hn (abi-hfa-n info)
                                          lb (primitive/idiv (abi-hfa-bits info) 8)]
                                      (if (<= (primitive/iadd (load fp) hn) (primitive/cast i64 8))
                                          (do
                                            (let [(mut j) 0]
                                              (loop (if (>= (load j) hn)
                                                        (break)
                                                        (do
                                                          (emit-store-fp! g
                                                                          (primitive/iadd (load fp) (load j))
                                                                          28
                                                                          (primitive/iadd slot
                                                                                          (primitive/imul (load j) lb))
                                                                          lb)
                                                          (store! j (primitive/iadd (load j) 1))))))
                                            (store! fp (primitive/iadd (load fp) hn))
                                            0)
                                          (do
                                            (let [(mut kk) 0]
                                              (loop (if (>= (load kk) sz)
                                                        (break)
                                                        (do
                                                          (emit-load-int! g
                                                                          9
                                                                          29
                                                                          (primitive/iadd 16
                                                                                          (primitive/iadd (load stk)
                                                                                                          (load kk)))
                                                                          8
                                                                          false)
                                                          (emit-store-int! g 9 28 (primitive/iadd slot (load kk)) 8)
                                                          (store! kk (primitive/iadd (load kk) 8))))))
                                            (store! stk
                                                    (primitive/iadd (load stk)
                                                                    (primitive/imul (primitive/idiv (primitive/iadd sz
                                                                                                                    7)
                                                                                                    8)
                                                                                    8)))
                                            (store! fp 8)
                                            0)))
                                  ; cls 4: pointer to a caller-made copy — copy it in
                                  (< (load gp) (primitive/cast i64 8))
                                    (do
                                      (a64-w! (mut s) (a64-mov-reg 9 (load gp)))
                                      (emit-copy-from-mem! g slot 9 sz)
                                      (store! gp (primitive/iadd (load gp) 1))
                                      0)
                                  :else
                                    (do
                                      (emit-load-int! g 9 29 (primitive/iadd 16 (load stk)) 8 false)
                                      (emit-copy-from-mem! g slot 9 sz)
                                      (store! stk (primitive/iadd (load stk) 8))
                                      0))
                            (dw-note-var! g
                                          (.name prm)
                                          t
                                          slot
                                          false
                                          true
                                          (.source fd)
                                          (.lo fd))
                            (set! (.env g)
                                  (gscope-put a
                                              (load (field g env))
                                              (.name prm)
                                              (mk-aval 1 slot (load t)))))
                          (set! i (primitive/iadd (load i) 1))))))
            ; ---- prologue is complete: mark it for the line table so lldb
            ; stops AFTER params are spilled (frame vars valid from here)
            (when (>= (load (field fd source)) (primitive/cast i64 0))
              (let [ev (primitive/alloc-stack DwLineEv)]
                (store! (field ev textoff) (a64-off (mut s)))
                (store! (field ev source) (load (field fd source)))
                (store! (field ev lo)
                        (if (< (load (field fd lo)) (primitive/cast i64 0))
                            0
                            (do
                              (load (field fd
                                           lo)))))
                (store! (field ev pe) true)
                (push! (mut (field g dwevs)) (load ev))
                0))
            ; ---- body. The entry label sits AFTER parameter intake, so a self-tail
            ; call jumps here: the frame, the incoming-argument registers and the
            ; spill code are all already done, and re-running them would be wrong.
            (a64-bind-label! (mut (.asm g)) (.entrylabel g))
            (let [bav (emit-body-tail g (load (field fd body)))]
              (unless (load (field g terminated))
                (unless  ; ---- return value per ABI class
                  retvoid
                  (let [cls (abi-cls retinfo)]
                    (cond (= cls (primitive/cast i64 0)) (av-to-x! g bav 0)
                          (= cls (primitive/cast i64 1)) (av-to-d! g bav 0)
                          (= cls (primitive/cast i64 2)) (emit-load-int! g 0 28 (av-slot! g bav) (ty-size g retp) false)
                          (= cls (primitive/cast i64 3))
                            (let [bs (av-slot! g bav)]
                              (emit-load-int! g 0 28 bs 8 false)
                              (emit-load-int! g 1 28 (primitive/iadd bs 8) 8 false))
                          (= cls (primitive/cast i64 5))
                            (let [bs (av-slot! g bav)
                                  hn (abi-hfa-n retinfo)
                                  lb (primitive/idiv (abi-hfa-bits retinfo) 8)
                                  (mut j) 0]
                              (loop (if (>= (load j) hn)
                                        (break)
                                        (do
                                          (emit-load-fp! g
                                                         (load j)
                                                         28
                                                         (primitive/iadd bs (primitive/imul (load j) lb))
                                                         lb)
                                          (store! j (primitive/iadd (load j) 1)))))
                              0)
                          :else  ; cls 4: copy into *sret
                            (do
                              (emit-load-int! g 9 28 (load (field g sretslot)) 8 false)
                              (emit-copy-to-mem! g 9 (av-slot! g bav) (ty-size g retp))
                              0))))
                0)
              ; ---- epilogue
              (a64-w! (mut s) (a64-sub-imm 16 29 16))  ; x16 = x29 - 16 (saved x28)
              (a64-w! (mut s) (a64-ldr-x 28 16 0))
              (a64-w! (mut s) (a64-add-imm 31 29 0))  ; sp = x29
              (a64-w! (mut s) (a64-ldp-post 29 30 31 16))
              (a64-w! (mut s) (a64-ret))
              ; ---- resolve labels, patch frame sizes
              (a64-resolve-fixups! (mut s))
              (let [slotbytes (primitive/imul (primitive/idiv (primitive/iadd (.frame g) 15) 16) 16)
                    out (.outbytes g)
                    total (primitive/iadd slotbytes out)]
                (when (> out (primitive/cast i64 4095)) (cga-fail "outgoing-args area exceeds 4095 bytes"))
                (b-patch-u32! (mut (.buf s))
                              p1
                              (a64-sub-imm-lsl12 31 31 (primitive/iand (primitive/ishr total 12) 4095)))
                (b-patch-u32! (mut (.buf s))
                              (primitive/iadd p1 4)
                              (a64-sub-imm 31 31 (primitive/iand total 4095)))
                (b-patch-u32! (mut (.buf s))
                              (primitive/iadd p1 8)
                              (a64-add-imm 28 31 out))
                (when (> total (primitive/cast i64 68719476735)) (cga-fail "frame too large"))
                ; record the function for DWARF
                (let [df (primitive/alloc-stack DwFn)]
                  (set! (.name df) (.name fd))
                  (set! (.symidx df)
                        (.symidx (al-at [GSig]
                                        (field g
                                               sigs)
                                        si)))
                  (set! (.source df) (if (< dwfnsrc (primitive/cast i64 0)) 0 (do dwfnsrc)))
                  (set! (.lo df) (if (< dwfnlo (primitive/cast i64 0)) 0 (do dwfnlo)))
                  (set! (.textoff df) (.fnstart g))
                  (set! (.len df)
                        (primitive/isub (a64-off (mut s))
                                        (.fnstart g)))
                  (set! (.slotbytes df) slotbytes)
                  (set! (.varlo df) dwvarlo)
                  (set! (.varhi df) (len (.dwvars g)))
                  (push! (mut (.dwfns g)) (load df)))
                ; :shim: the Coil-named symbol is a trampoline that moves the
                ; convention's registers into the C argument registers, calls
                ; __impl, and moves x0 back into the convention's return register.
                (when (load (field (al-at [GSig] (field g sigs) si) shim))
                  (let [e (al-at [GSig] (field g sigs) si)
                        regs (load (field e shimregs))
                        nr (len (load regs))]
                    (mobj-set-sym! (mut (field g obj))
                                   (load (field e symidx))
                                   (load (field g text))
                                   (a64-off (mut s)))
                    (a64-w! (mut s) (a64-stp-pre 29 30 31 -16))
                    (a64-w! (mut s) (a64-mov-sp 29 31))
                    (let [(mut j) 0]
                      (loop (if (>= (load j) nr)
                                (break)
                                (do
                                  (a64-w! (mut s) (a64-mov-reg (load j) (get (load regs) (load j))))
                                  (store! j (primitive/iadd (load j) 1))))))
                    (mobj-add-reloc! (mut (field g obj))
                                     (load (field g text))
                                     (a64-off (mut s))
                                     (load (field e implsym))
                                     (reloc-branch26)
                                     true
                                     2)
                    (a64-w! (mut s) (a64-bl-raw))
                    (when (!= (load (field e shimret)) (primitive/cast i64 0))
                      (a64-w! (mut s) (a64-mov-reg (load (field e shimret)) 0)))
                    (a64-w! (mut s) (a64-ldp-post 29 30 31 16))
                    (a64-w! (mut s) (a64-ret))
                    0))
                0)))))))
  0)

; ============================ driver =========================================
; Build the program's Mach-O object IN MEMORY. Serializing it to a file (the AOT
; path) and loading it straight into executable memory (jit.coil, the comptime and
; metaprogram path) are both thin wrappers over this — the codegen happens once,
; here, so the two paths can never drift.
(defn cga64-build-mobj [(a (dyn Allocator))
                        (mp (ptr Program))
                        (mainpath (slice u8))
                        (compdir (slice u8))
                        (paths (ptr (ArrayList (slice u8))))
                        (texts (ptr (ArrayList (slice u8))))
                        (emit-dwarf bool)] (-> MObj)
  (let [g (primitive/alloc-stack Cga)]
    (set! (.a g) a)
    (set! (.program g) mp)
    (set! (.sigs g) (al-new [GSig] a))
    (set! (.sig_index g) (hm-new [(slice u8) i64] a (str-keyops)))
    (set! (.obj g) (mobj-new a))
    (set! (.asm g) (asm-new a))
    (set! (.strs g) (al-new [GStr] a))
    (set! (.statics g) (al-new [GStatic] a))
    (set! (.nglob g) 0)
    (set! (.nstatic g) 0)
    (set! (.loops g) (al-new [GLoop] a))
    (set! (.env g) (gscope-nil a))
    (set! (.frame g) 0)
    (set! (.terminated g) false)
    (set! (.sretslot g) -1)
    (set! (.outbytes g) 0)
    (set! (.fnstart g) 0)
    (set! (.retty g) (TInt 64 true))
    (set! (.epilabel g) 0)
    (set! (.dwtys g) (al-new [DwTy] a))
    (set! (.dwfns g) (al-new [DwFn] a))
    (set! (.dwvars g) (al-new [DwVar] a))
    (set! (.dwevs g) (al-new [DwLineEv] a))
    (set! (.dwcursrc g) -1)
    (set! (.dwcurlo g) -1)
    (set! (.convs g) (load (field mp conventions)))
    (set! (.inline_depth g) 0)
    ; sections: ordinals are 1-based in push order
    (set! (.text g) (mobj-add-sect! (mut (.obj g)) "__TEXT" "__text" 2 2147484672))
    (set! (.constsec g) (mobj-add-sect! (mut (.obj g)) "__TEXT" "__const" 3 0))
    (set! (.datasec g) (mobj-add-sect! (mut (.obj g)) "__DATA" "__data" 3 0))
    ; (export-c …): an exported function is emitted directly under its C symbol with
    ; external linkage (g-register-sigs! below) — no thunk needed for scalar/pointer
    ; params or struct returns. A by-value STRUCT param is the sole exception (this
    ; backend passes aggregates by pointer), and would need a C-ABI marshaling thunk;
    ; reject it with a clear error rather than emit a silently-wrong symbol.
    (let [es (load (field mp exports))
          ne (len (load es))
          (mut ei) 0]
      (loop (if (>= (load ei) ne)
                (break)
                (do
                  (when (g-export-needs-thunk (al-at [ExportC] es (load ei)))
                    (cga-fail2 "export-c with a by-value struct parameter isn't supported by the arm64 backend yet (it needs a C-ABI marshaling thunk); scalar/pointer params and struct returns work: "
                               (load (field (al-at [ExportC] es (load ei)) name))))
                  (set! ei (primitive/iadd (load ei) 1))))))
    (g-register-types! g mp)
    (g-eval-asserts! g mp)
    (g-register-sigs! g mp)
    (g-declare-statics! g mp)
    ; emit every function
    (let [fs (load (field mp funcs))
          n (len (load fs))
          (mut i) 0]
      (loop (if (>= (load i) n)
                (break)
                (do
                  (emit-func! g (al-at [Func] fs (load i)))
                  (set! i (primitive/iadd (load i) 1))))))
    ; move the code into the __text section and serialize
    (b-bytes! (mut (mobj-sect-buf (mut (field g obj)) (load (field g text))))
              (al-slice [u8] (.buf (.asm g))))
    ; ---- DWARF (on for a normal build; a metaprogram dylib passes emit-dwarf=false —
    ; it needs no debug info and has no registered source paths/texts to describe).
    (when emit-dwarf
      (let [ltmp (mobj-add-sym! (mut (field g obj)) "ltmp0" (load (field g text)) 0 false)
            dw
              (dw-build! a
                         mainpath
                         compdir
                         paths
                         texts
                         (mut (field g dwtys))
                         (mut (field g dwfns))
                         (mut (field g dwvars))
                         (mut (field g dwevs))
                         (len (load (field (field g asm) buf)))
                         ltmp
                         29  ; DW_OP_reg29 — x29 is the frame base here
                         16)
            dbgattr 33554432
            sline (mobj-add-sect! (mut (field g obj)) "__DWARF" "__debug_line" 0 dbgattr)
            sinfo (mobj-add-sect! (mut (field g obj)) "__DWARF" "__debug_info" 0 dbgattr)
            sabbr (mobj-add-sect! (mut (field g obj)) "__DWARF" "__debug_abbrev" 0 dbgattr)
            sstr (mobj-add-sect! (mut (field g obj)) "__DWARF" "__debug_str" 0 dbgattr)]
        (b-bytes! (mut (mobj-sect-buf (mut (field g obj)) sline))
                  (al-slice [u8]
                            (load (load (field dw
                                               line)))))
        (b-bytes! (mut (mobj-sect-buf (mut (field g obj)) sinfo))
                  (al-slice [u8]
                            (load (load (field dw
                                               info)))))
        (b-bytes! (mut (mobj-sect-buf (mut (field g obj)) sabbr))
                  (al-slice [u8]
                            (load (load (field dw
                                               abbrev)))))
        (b-bytes! (mut (mobj-sect-buf (mut (field g obj)) sstr))
                  (al-slice [u8]
                            (load (load (field dw
                                               strs)))))
        (let [rl (load (field dw relocs))
              nr (len (load rl))
              (mut i) 0]
          (loop (if (>= (load i) nr)
                    (break)
                    (do
                      (let [r (al-at [DwReloc] rl (load i))]
                        ; a SECTION reloc targeting __text (negative sym = -(section ordinal),
                        ; r_extern=0 in the writer) — clang's Mach-O DWARF scheme, the one dsymutil
                        ; relocates per-function via the debug map.
                        (mobj-add-reloc! (mut (field g obj))
                                         (if (= (load (field r sect)) (primitive/cast i64 1)) sinfo sline)
                                         (load (field r off))
                                         (primitive/isub 0 (load (field g text)))
                                         (reloc-unsigned)
                                         false
                                         3))
                      (store! i (primitive/iadd (load i) 1))))))))
    (.obj g)))

; serialize a built object to disk — the AOT path.
(defn cga64-last-needs-curl-cell [] (-> (ptr bool))
  (primitive/alloc-static bool))

(defn cga64-last-needs-llvm-cell [] (-> (ptr bool))
  (primitive/alloc-static bool))

(defn cga64-last-needs-curl? [] (-> bool)
  (load (cga64-last-needs-curl-cell)))

(defn cga64-last-needs-llvm? [] (-> bool)
  (load (cga64-last-needs-llvm-cell)))

(defn cga64-probe-name [(a (dyn Allocator)) (left (slice u8)) (right (slice u8))] (-> (slice u8))
  (let [(mut b) (al-new [u8] a)]
    (b-bytes! (mut b) left)
    (b-bytes! (mut b) right)
    (al-slice [u8] (load b))))

(defn cga64-build-object [(a (dyn Allocator))
                          (mp (ptr Program))
                          (objpath (ptr i8))
                          (mainpath (slice u8))
                          (compdir (slice u8))
                          (paths (ptr (ArrayList (slice u8))))
                          (texts (ptr (ArrayList (slice u8))))
                          (emit-dwarf bool)] (-> i64)
  (let [(mut o) (cga64-build-mobj a mp mainpath compdir paths texts emit-dwarf)
        bytes (macho-write (mut o))
        fd (cga64.creat objpath 420)]
    ; Preserve link requirements while the relocation graph is still in memory.
    ; The build driver can consume these facts without reading and decoding the
    ; just-written object.  Exact names intentionally remain split so the
    ; compiler's own object does not acquire the complete probe strings.
    (set! (cga64-last-needs-curl-cell) (mobj-references-undefined? (mut o) (cga64-probe-name a "_curl_easy_" "init")))
    (set! (cga64-last-needs-llvm-cell)
          (mobj-references-undefined? (mut o) (cga64-probe-name a "_LLVMGetDefault" "TargetTriple")))
    (when (< fd (primitive/cast i64 0)) (cga-fail "cannot create object file"))
    (let [total (len (load bytes))
          (mut off) 0]
      (loop (if (>= (load off) total)
                (break)
                (do
                  (let [wrote
                          (cga64.write (primitive/cast i32 fd)
                                       (primitive/cast (ptr i8)
                                                       (primitive/index (slice-data (al-slice [u8] (load bytes)))
                                                                        (load off)))
                                       (primitive/cast isize (primitive/isub total (load off))))]
                    (when (<= wrote (primitive/cast i64 0)) (cga-fail "object write failed"))
                    (set! off (primitive/iadd (load off) (primitive/cast i64 wrote))))))))
    (cga64.close (primitive/cast i32 fd))
    0))

; ============================ DWARF collection ===============================
; rendered, memo-stable name for a type's DIE
(defn dw-ty-name [(g (ptr Cga)) (t (ptr Type))] (-> (slice u8))
  (let [a (.a g)]
    (match (load t)
      (TInt [bits sg] (sconcat a (if sg "i" "u") (i64->str a bits)))
      (TBool [] "bool")
      (TFloat [bits] (sconcat a "f" (i64->str a bits)))
      (TPtr [inner] (sconcat a "*" (dw-ty-name g inner)))
      (TRef [_m inner] (sconcat a "*" (dw-ty-name g inner)))
      (TSlice [elem] (sconcat a "slice$" (dw-ty-name g elem)))
      (TStruct [nm] nm)
      (TArray [elem n] (sconcat a (sconcat a "arr" (i64->str a n)) (sconcat a "$" (dw-ty-name g elem))))
      (_ "?"))))

(defn dw-find-ty [(g (ptr Cga)) (nm (slice u8))] (-> i64)
  (let [n (len (.dwtys g))
        (mut i) 0
        (mut r) -1]
    (loop (if (>= (load i) n)
              (break)
              (do
                (when (= (load (field (al-at [DwTy] (field g dwtys) (load i)) name)) nm)
                  (store! r
                          (load i)))
                (set! i (primitive/iadd (load i) 1)))))
    (load r)))

; type -> DwTy index, or -1 when we deliberately don't describe it (sums,
; fnptrs, vecs, non-C struct layouts — mirrors the DI-type policy:
; never a wrong type).
(defn dw-ty-of! [(g (ptr Cga)) (t (ptr Type))] (-> i64)
  (let [a (.a g)
        nm (dw-ty-name g t)
        hit (dw-find-ty g nm)]
    (if (>= hit (primitive/cast i64 0))
        hit
        (match (load t)
          (TInt [bits sg]
                (let [e (primitive/alloc-stack DwTy)]
                  (set! (.kind e) 0)
                  (set! (.name e) nm)
                  (set! (.size e) (ty-size g t))
                  (set! (.enc e) (if sg 5 7))
                  (set! (.to e) -1)
                  (set! (.count e) 0)
                  (set! (.off e) 0)
                  (set! (.fields e) (al-new [DwField] a))
                  (push! (mut (.dwtys g)) (load e))
                  (primitive/isub (len (.dwtys g)) 1)))
          (TBool []
                 (let [e (primitive/alloc-stack DwTy)]
                   (set! (.kind e) 0)
                   (set! (.name e) nm)
                   (set! (.size e) 1)
                   (set! (.enc e) 2)
                   (set! (.to e) -1)
                   (set! (.count e) 0)
                   (set! (.off e) 0)
                   (set! (.fields e) (al-new [DwField] a))
                   (push! (mut (.dwtys g)) (load e))
                   (primitive/isub (len (.dwtys g)) 1)))
          (TFloat [bits]
                  (let [e (primitive/alloc-stack DwTy)]
                    (set! (.kind e) 0)
                    (set! (.name e) nm)
                    (set! (.size e) (primitive/idiv bits 8))
                    (set! (.enc e) 4)
                    (set! (.to e) -1)
                    (set! (.count e) 0)
                    (set! (.off e) 0)
                    (set! (.fields e) (al-new [DwField] a))
                    (push! (mut (.dwtys g)) (load e))
                    (primitive/isub (len (.dwtys g)) 1)))
          (TPtr [inner]
                (let [ti (dw-ty-of! g inner)
                      e (primitive/alloc-stack DwTy)]
                  (set! (.kind e) 1)
                  (set! (.name e) nm)
                  (set! (.size e) 8)
                  (set! (.enc e) 0)
                  (set! (.to e) ti)
                  (set! (.count e) 0)
                  (set! (.off e) 0)
                  (set! (.fields e) (al-new [DwField] a))
                  (push! (mut (.dwtys g)) (load e))
                  (primitive/isub (len (.dwtys g)) 1)))
          (TRef [_m inner]
                (let [ti (dw-ty-of! g inner)
                      e (primitive/alloc-stack DwTy)]
                  (set! (.kind e) 1)
                  (set! (.name e) nm)
                  (set! (.size e) 8)
                  (set! (.enc e) 0)
                  (set! (.to e) ti)
                  (set! (.count e) 0)
                  (set! (.off e) 0)
                  (set! (.fields e) (al-new [DwField] a))
                  (push! (mut (.dwtys g)) (load e))
                  (primitive/isub (len (.dwtys g)) 1)))
          (TSlice [elem]
                  (let [ep (primitive/alloc-stack Type)]
                    (set! ep (TPtr elem))
                    (let [pi (dw-ty-of! g ep)
                          li (dw-ty-of! g (box-type a (TInt 64 true)))
                          e (primitive/alloc-stack DwTy)
                          (mut fs) (al-new [DwField] a)
                          f0 (primitive/alloc-stack DwField)
                          f1 (primitive/alloc-stack DwField)]
                      (set! (.name f0) "data")
                      (set! (.tyidx f0) pi)
                      (set! (.off f0) 0)
                      (set! (.name f1) "len")
                      (set! (.tyidx f1) li)
                      (set! (.off f1) 8)
                      (push! (mut fs) (load f0))
                      (push! (mut fs) (load f1))
                      (set! (.kind e) 2)
                      (set! (.name e) nm)
                      (set! (.size e) 16)
                      (set! (.enc e) 0)
                      (set! (.to e) -1)
                      (set! (.count e) 0)
                      (set! (.off e) 0)
                      (set! (.fields e) (load fs))
                      (push! (mut (.dwtys g)) (load e))
                      (primitive/isub (len (.dwtys g)) 1))))
          (TArray [elem n]
                  (let [ei (dw-ty-of! g elem)]
                    (if (< ei (primitive/cast i64 0))
                        -1
                        (let [e (primitive/alloc-stack DwTy)]
                          (set! (.kind e) 3)
                          (set! (.name e) nm)
                          (set! (.size e) (ty-size g t))
                          (set! (.enc e) 0)
                          (set! (.to e) ei)
                          (set! (.count e) n)
                          (set! (.off e) 0)
                          (set! (.fields e) (al-new [DwField] a))
                          (push! (mut (.dwtys g)) (load e))
                          (primitive/isub (len (.dwtys g)) 1)))))
          (TStruct [snm]
                   (let [si (g-struct-idx g snm)]
                     (if (< si (primitive/cast i64 0))
                         -1  ; sums: deliberately undescribed
                         (let [sp (struct-at (field g layouts) si)]
                           (match (.layout sp)
                             (LC []
                                 ; reserve the entry FIRST (recursion through pointers)
                                 (let [e (primitive/alloc-stack DwTy)]
                                   (set! (.kind e) 2)
                                   (set! (.name e) nm)
                                   (set! (.size e)
                                         (.size sp))
                                   (set! (.enc e) 0)
                                   (set! (.to e) -1)
                                   (set! (.count e) 0)
                                   (set! (.off e) 0)
                                   (set! (.fields e) (al-new [DwField] a))
                                   (push! (mut (.dwtys g)) (load e))
                                   (let [idx
                                           (primitive/isub (len (.dwtys g))
                                                           1)
                                         fs (load (field sp fields))
                                         nf (len (load fs))
                                         (mut i) 0]
                                     (loop (if (>= (load i) nf)
                                               (break)
                                               (do
                                                 (let [fp (al-at [Field] fs (load i))
                                                       fi (dw-ty-of! g (field fp ty))]
                                                   (when (>= fi (primitive/cast i64 0))
                                                     (let [f (primitive/alloc-stack DwField)]
                                                       (store! (field f name)
                                                               (load (field fp name)))
                                                       (store! (field f tyidx) fi)
                                                       (store! (field f off)
                                                               (g-field-off g si (load i)))
                                                       (push! (mut (field (al-at [DwTy]
                                                                                 (field g
                                                                                        dwtys)
                                                                                 idx)
                                                                          fields))
                                                              (load f))
                                                       0)))
                                                 (set! i (primitive/iadd (load i) 1)))))
                                     ; refresh size (fields may have been dropped; header stays right)
                                     idx)))
                             (LBits [backing _o]
                                    (let [e (primitive/alloc-stack DwTy)]
                                      (set! (.kind e) 0)
                                      (set! (.name e) nm)
                                      (set! (.size e) (primitive/idiv backing 8))
                                      (set! (.enc e) 7)
                                      (set! (.to e) -1)
                                      (set! (.count e) 0)
                                      (set! (.off e) 0)
                                      (set! (.fields e) (al-new [DwField] a))
                                      (push! (mut (.dwtys g)) (load e))
                                      (primitive/isub (len (.dwtys g)) 1)))
                             (_ -1))))))
          (_ -1)))))

; record a line-table row if the source position moved
(defn dw-note-span! [(g (ptr Cga)) (e (ptr Expr))] (-> i64)
  (let [src (.source e)
        lo (.lo e)]
    (unless (or (or (< src (primitive/cast i64 0)) (< lo (primitive/cast i64 0)))
                (and (= src (load (field g dwcursrc)))
                     (= lo
                        (load (field g
                                     dwcurlo)))))
      (let [ev (primitive/alloc-stack DwLineEv)]
        (store! (field ev textoff) (a64-off (mut (field g asm))))
        (store! (field ev source) src)
        (store! (field ev lo) lo)
        (store! (field ev pe) false)
        (push! (mut (field g dwevs)) (load ev))
        (store! (field g dwcursrc) src)
        (store! (field g dwcurlo) lo)
        0))))

; DWARF note for a let bind. `(mut x)` desugars to `x.slot` (the alloc) plus
; `x` (a pointer to it): skip the internal `.slot` name and describe `x` as an
; indirect variable of the POINTEE type (location: fbreg off, deref).
(defn dw-note-bind! [(g (ptr Cga)) (name (slice u8)) (av AVal) (src i64) (lo i64)] (-> i64)
  (let [n (len name)
        t (primitive/alloc-stack Type)]
    (set! t (av-ty av))
    (unless (and (>= n (primitive/cast i64 5)) (= (subslice name (primitive/isub n 5) n) ".slot"))
      (let [slotname (sconcat (load (field g a)) name ".slot")]
        (match (gscope-get (load (field g env)) slotname)
          (Some [_sl]
                ; mut variable: value lives behind the pointer
                (match (load t)
                  (TPtr [inner]
                        (dw-note-var! g name inner (av-v av) true false src lo))
                  (_ (dw-note-var! g name t (av-v av) false false src lo))))
          (None []
                (dw-note-var! g name t (av-v av) false false src lo)))))))

; record a variable/parameter DIE for the current function
(defn dw-note-var! [(g (ptr Cga))
                    (name (slice u8))
                    (t (ptr Type))
                    (slot i64)
                    (indirect bool)
                    (param bool)
                    (src i64)
                    (lo i64)] (-> i64)
  (let [ti (dw-ty-of! g t)]
    (unless (or (< ti (primitive/cast i64 0)) (or (< src (primitive/cast i64 0)) (< lo (primitive/cast i64 0))))
      (let [v (primitive/alloc-stack DwVar)]
        (store! (field v name) name)
        (store! (field v tyidx) ti)
        (store! (field v slot) slot)
        (store! (field v indirect) indirect)
        (store! (field v param) param)
        (store! (field v source) src)
        (store! (field v lo) lo)
        (push! (mut (field g dwvars)) (load v))
        0))))
