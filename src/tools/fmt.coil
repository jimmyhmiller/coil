;;; `coil fmt`: the source formatter as a program of its own. It reads no compiler
;;; code; `coil fmt` runs it (run-tool in driver.coil) the way git runs git-NAME.
(module coil.tool.fmt)
(import "coil.primitive" :as primitive)
(import "coil.alloc" :as alloc :use *)
(import "coil.result" :use *)
(import "coil.slice" :use *)
(import "coil.str" :as str :use *)
(import "coil.arraylist" :use *)
(import "coil.io" :use *)
(import "coil.os" :use [exit])
(import "coil.path" :use *)
(import "coil.project" :use [parse-manifest project-source-paths])
(import "coil.reader" :use [Diag])
(import "coil.source.cli" :use *)
(import "coil.source.diagnostic" :as diagnostic)
(import "coil.source.format" :as fmtr)

; `fmt [--check|--write] [--width N] <file>` — the Coil source formatter (src/stdlib/source/format.coil). Prints
; the formatted source, or with --write rewrites the file, or with --check exits 1 if
; the file isn't already formatted. Width defaults to 80 (source/format.coil's
; fmt-default-width), Clojure indentation conventions.
; exit codes follow gofmt/black: 0 clean, 1 unformatted (--check), 2 error. `--check`
; must distinguish "your file is unformatted" from "your invocation is broken", or a CI
; gate cannot tell a real violation from a typo'd path. A file the reader refuses is an
; error too, reported as the compiler reports it, and it is left as it is.
(defn fmt-refused [(name (slice u8)) (src (slice u8)) (d Diag)] (-> i64)
  (diagnostic/report (stderr) name src d)
  2)

(defn fmt-one [(a (dyn Allocator))
               (pathc (ptr i8))
               (check bool)
               (write bool)
               (width i64)] (-> i64)
  (if (dir? pathc)
      (let [w (stderr)]
        (ps w "error: '")
        (ps w (from-cstr pathc))
        (ps w "' is a directory")
        (wb w 10)
        2)
      (let [src (read-source a pathc 2)]
        (match (fmtr/format-src a src width)
          (Err [d] (fmt-refused (from-cstr pathc) src d))
          (Ok [out]
              (let [same (= src out)]
                (if check
                    (unless same
                      (ps (stderr) "not formatted: ")
                      (ps (stderr) (from-cstr pathc))
                      (wb (stderr) 10)
                      1)
                    (if write
                        (unless same
                          (d-rewrite-file a
                                          "fmt input changed while it was formatted"
                                          (from-cstr pathc)
                                          src
                                          out))
                        (write-stdout-all out)))))))))

; Formats EVERY file given, not just argv[2]: `coil fmt --write src/*.coil` silently
; formatted one file and reported success, and under --check silently gated a fraction
; of what was asked. Flags may appear anywhere.
(defn fmt-stdin [(a (dyn Allocator)) (check bool) (write bool) (width i64)]
  (-> i64)
  (if write
      (do
        (ps (stderr) "error: coil fmt --write cannot write standard input\n")
        2)
      (let [src (read-stdin-all a)]
        (match (fmtr/format-src a src width)
          (Err [d] (fmt-refused "<stdin>" src d))
          (Ok [out]
              (if check
                  (unless (= src out)
                    (ps (stderr) "not formatted: standard input\n")
                    1)
                  (write-stdout-all out)))))))

(defn fmt-cmd [(a (dyn Allocator)) (argc i32) (argv (ptr (ptr i8)))] (-> i64)
  (let [(mut check) false
        (mut write) false
        (mut width) (fmtr/fmt-default-width)
        (mut nfiles) 0
        (mut rc) 0
        (mut i) 1]
    ; pass 1: flags, wherever they sit
    (loop (if (>= (load i) (primitive/cast i64 argc))
              (break)
              (do
                (let [arg (from-cstr (load (index argv (load i))))]
                  (when (and (is-flag? arg) (!= arg "-"))
                    (if (= arg "--check")
                        (do (set! check true) 0)
                        (if (= arg "--write")
                            (do (set! write true) 0)
                            (if (= arg "--width")
                                (do
                                  (when (>= (primitive/iadd (load i) 1)
                                            (primitive/cast i64 argc))
                                    (ps (stderr)
                                        "error: --width needs a positive column count\n")
                                    (exit 2)
                                    0)
                                  (match (parse-int (from-cstr (load (index argv
                                                                            (primitive/iadd (load i)
                                                                                            1)))))
                                    (Some [n]
                                          (if (> n 0)
                                              (set! width n)
                                              (do
                                                (ps (stderr)
                                                    "error: --width needs a positive column count\n")
                                                (exit 2)
                                                0)))
                                    (None []
                                          (do
                                            (ps (stderr)
                                                "error: --width needs a positive column count\n")
                                            (exit 2)
                                            0)))
                                  (set! i (primitive/iadd (load i) 1))
                                  0)
                                (let [w (stderr)]
                                  (ps w "error: unknown flag '")
                                  (ps w arg)
                                  (ps w "'")
                                  (wb w 10)
                                  (exit 2)
                                  0))))))
                (set! i (primitive/iadd (load i) 1)))))
    ; pass 2: every positional, keeping the worst exit code
    (set! i 1)
    (loop (if (>= (load i) (primitive/cast i64 argc))
              (break)
              (do
                (let [arg (from-cstr (load (index argv (load i))))]
                  (if (= arg "--width")
                      (set! i (primitive/iadd (load i) 2))
                      (do
                        (unless (and (is-flag? arg) (!= arg "-"))
                          (set! nfiles (primitive/iadd (load nfiles) 1))
                          (let [r
                                  (if (= arg "-")
                                      (fmt-stdin a
                                                 (load check)
                                                 (load write)
                                                 (load width))
                                      (fmt-one a
                                               (load (index argv (load i)))
                                               (load check)
                                               (load write)
                                               (load width)))]
                            (when (> r (load rc)) (set! rc r) 0)))
                        (set! i (primitive/iadd (load i) 1))))))))
    (if (= (load nfiles) 0)
        (let [text (read-file-disk a (to-cstr a "Coil.toml"))]
          (when (= (len text) 0)
            (ps (stderr)
                "usage: coil fmt [--check|--write] [--width N] <file.coil>...\n")
            (exit 2)
            0)
          ; Project mode: every file the package owns, in this process.
          (let [files (project-source-paths a (parse-manifest a text))]
            (for [k 0 (len (load files))]
              (let [r
                      (fmt-one a
                               (to-cstr a (get (load files) k))
                               (load check)
                               (load write)
                               (load width))]
                (when (> r (load rc)) (set! rc r) 0))
              0)
            (load rc)))
        (load rc))))

(defn main [(argc i32) (argv (ptr (ptr i8)))] (-> i64)
  (if (and (= argc 2) (= (from-cstr (load (index argv 1))) "--help"))
      (do
        (ps (stdout)
            "usage: coil-fmt [--check|--write] [--width N] <file.coil>...\n")
        0)
      (fmt-cmd (malloc-allocator) argc argv)))
