;;; `coil balance`: delimiter repair as a program of its own. It reads no compiler
;;; code; `coil balance` runs it (run-tool in driver.coil) the way git runs git-NAME.
(module coil.tool.balance)
(import "coil.primitive" :as primitive)
(import "coil.alloc" :as alloc :use *)
(import "coil.result" :use *)
(import "coil.slice" :use *)
(import "coil.str" :as str :use *)
(import "coil.arraylist" :use *)
(import "coil.io" :use *)
(import "coil.fs" :as fs)
(import "coil.os" :as os :use [exit])
(import "coil.source.balance" :as bal)
(import "coil.source.cli" :use *)
(import "coil.source.diagnostic" :use [write-decimal])
(import "coil.time" :as time)

; One line per `coil balance` run, appended locally. Nothing is transmitted anywhere,
; and no source text is recorded — a path, an outcome, a cause, and four counters.
;
; It exists because the aggregate numbers from the mutation corpus describe damage
; that a script invented, and the refusals that actually matter are the ones hit on
; real half-edited files. Which cause dominates there decides what to fix next, and
; guessing at that from a synthetic benchmark is how tools get tuned for the wrong
; population. Read it with `coil balance --stats`, or with jq for the full picture.
;
; Set COIL_BALANCE_LOG=0 to turn it off. A write that fails is ignored: a repair tool
; must never fail because its bookkeeping did.
(defn stats-enabled? [(a (dyn Allocator))] (-> bool)
  (let [off (os/getenv (to-cstr a "COIL_BALANCE_LOG"))
        home (os/getenv (to-cstr a "HOME"))]
    (if (= (primitive/cast i64 home) 0)
        false
        (if (= (primitive/cast i64 off) 0)
            true
            (!= (from-cstr off) "0")))))

(defn stats-path [(a (dyn Allocator))] (-> (slice u8))
  (let [h (os/getenv (to-cstr a "HOME"))
        (mut b) (StrBuf::new a)]
    (if (= (primitive/cast i64 h) 0)
        ""
        (do
          (push-str! (mut b) (from-cstr h))
          (push-str! (mut b) "/.coil")
          (fs/make-dir (to-cstr a (str (load b))) 493)
          (push-str! (mut b) "/balance-log.jsonl")
          (str (load b))))))

; A path may contain a quote or a backslash, and one unescaped byte would make every
; later line unparseable to anything reading the file as JSON.
(defn json-str! [(b (mut StrBuf)) (s (slice u8))] (-> i64)
  (let [n (len s)
        (mut i) 0]
    (push! (mut b) (: 34 u8))
    (loop (if (>= (load i) n)
              (break)
              (let [c (primitive/cast i64 (get s (load i)))]
                (cond (or (= c 34) (= c 92))
                        (do
                          (push! (mut b) (: 92 u8))
                          (push! (mut b) (primitive/cast u8 c))
                          0)
                      (< c 32) (push! (mut b) (: 32 u8))
                      :else (push! (mut b) (primitive/cast u8 c)))
                (set! i (primitive/iadd (load i) 1))
                0)))
    (push! (mut b) (: 34 u8))
    0))

(defn stats-log! [(a (dyn Allocator))
                  (path (slice u8))
                  (outcome (slice u8))
                  (cause (slice u8))
                  (tried i64)
                  (matches i64)
                  (guessed i64)
                  (capped bool)] (-> i64)
  (if (not (stats-enabled? a))
      0
      (let [lp (stats-path a)]
        (if (= lp "")
            0
            (let [(mut b) (StrBuf::new a)]
              (push-str! (mut b) "{\"t\":")
              ; A clock that cannot be read is not a reason to lose the record: stamp 0
              ; and keep the line, since the outcome and cause are what get counted.
              (push-i64! (mut b)
                         (try (let [ms (try-or! (time/wall-now-ms) 0)]
                                (primitive/udiv ms 1000))))
              (push-str! (mut b) ",\"cmd\":\"balance\",\"path\":")
              (json-str! (mut b) path)
              (push-str! (mut b) ",\"outcome\":")
              (json-str! (mut b) outcome)
              (push-str! (mut b) ",\"cause\":")
              (json-str! (mut b) cause)
              (push-str! (mut b) ",\"tried\":")
              (push-i64! (mut b) tried)
              (push-str! (mut b) ",\"matches\":")
              (push-i64! (mut b) matches)
              (push-str! (mut b) ",\"guessed\":")
              (push-i64! (mut b) guessed)
              (push-str! (mut b) ",\"capped\":")
              (push-str! (mut b) (if capped "true" "false"))
              (push-str! (mut b) "}\n")
              (let [f (fopen (to-cstr a lp) (to-cstr a "ab"))]
                (if (= (primitive/cast i64 f) 0)
                    0
                    (do
                      (fwrite (primitive/cast (ptr i8)
                                              (data (str (load b))))
                              1
                              (len (str (load b)))
                              f)
                      (fclose f)
                      0))))))))

(defn balance-one [(a (dyn Allocator))
                   (pathc (ptr i8))
                   (check bool)
                   (write bool)
                   (strict bool)] (-> i64)
  (if (dir? pathc)
      (let [w (stderr)]
        (ps w "error: '")
        (ps w (from-cstr pathc))
        (ps w "' is a directory")
        (wb w 10)
        2)
      (let [path (from-cstr pathc)
            src (read-source a pathc 2)]
        (match (bal/balance-src a src strict)
          (bal/BClean []
                      (do
                        (unless check
                          (stats-log! a path "clean" "" 0 0 0 false)
                          0)
                        ; The filter's output is the source: losing it is a
                        ; failure here as much as for a repaired file.
                        (if (or check write) 0 (write-stdout-all src))))
          (bal/BRefused [rcode why line col]
                        (if check
                            1
                            ; Layout did not derive a safe repair. Refuse structural
                            ; ambiguity rather than consulting unrelated semantics.
                            ; The refusal is an outcome like the others, and the one
                            ; `--stats` breaks down by cause.
                            (do
                              (stats-log! a path "refused" rcode 0 0 0 false)
                              (balance-refusal path why line col))))
          (bal/BFixed [text ins del guessed guess-line]
                      (if check
                          (let [w (stderr)]
                            (ps w "unbalanced: ")
                            (ps w path)
                            (wb w 10)
                            1)
                          (do
                            (when (> guessed 0)
                              (let [w (stderr)]
                                (ps w "note: ")
                                (ps w path)
                                (ps w ": placed ")
                                (write-decimal w guessed)
                                (ps w
                                    " closer(s) at the indentation-derived boundary; first at line ")
                                (write-decimal w guess-line)
                                (wb w 10))
                              0)
                            (stats-log! a
                                        path
                                        "repaired"
                                        (if (> guessed 0) "plausible" "derived")
                                        0
                                        0
                                        guessed
                                        false)
                            (balance-emit a path src text write))))))))

(defn balance-emit [(a (dyn Allocator))
                    (path (slice u8))
                    (src (slice u8))
                    (text (slice u8))
                    (write bool)] (-> i64)
  (if write
      (d-rewrite-file a
                      "balance input changed while it was repaired"
                      path
                      src
                      text)
      (write-stdout-all text)))

(defn stats-row [(w (ptr Writer)) (label (slice u8)) (n i64) (total i64)]
  (-> i64)
  (when (> n 0)
    (ps w "  ")
    (ps w label)
    (let [pad (primitive/isub 22 (len label))
          (mut k) 0]
      (loop (if (>= (load k) pad)
                (break)
                (do (wb w 32) (set! k (primitive/iadd (load k) 1))))))
    (write-decimal w n)
    (when (> total 0)
      (ps w "  (")
      (write-decimal w (primitive/udiv (primitive/imul n 100) total))
      (ps w "%)"))
    (wb w 10)
    0)
  0)

(defn cause-count [(log (slice u8)) (a (dyn Allocator)) (name (slice u8))]
  (-> i64)
  (let [(mut b) (StrBuf::new a)]
    (push-str! (mut b) "\"cause\":\"")
    (push-str! (mut b) name)
    (push-str! (mut b) "\"")
    (count-substr log (str (load b)))))

(defn balance-stats-cmd [(a (dyn Allocator))] (-> i64)
  (let [lp (stats-path a)
        w (stdout)]
    (if (= lp "")
        (do (ps (stderr) "error: no HOME, so there is no ~/.coil to read\n") 2)
        (let [log (read-file-disk a (to-cstr a lp))]
          (if (= (len log) 0)
              (do
                (ps w "no runs recorded yet at ")
                (ps w lp)
                (wb w 10)
                0)
              (let [runs (count-substr log "{\"t\":")
                    repaired (count-substr log "\"outcome\":\"repaired\"")
                    refused (count-substr log "\"outcome\":\"refused\"")
                    clean (count-substr log "\"outcome\":\"clean\"")
                    damaged (primitive/iadd repaired refused)]
                (ps w "coil balance — ")
                (write-decimal w runs)
                (ps w " runs recorded in ")
                (ps w lp)
                (wb w 10)
                (wb w 10)
                (stats-row w "already balanced" clean runs)
                (stats-row w "repaired" repaired runs)
                (stats-row w "refused" refused runs)
                (when (> damaged 0)
                  (wb w 10)
                  (ps w "of the ")
                  (write-decimal w damaged)
                  (ps w " damaged files, how each was decided:")
                  (wb w 10)
                  (stats-row w "derived" (cause-count log a "derived") damaged)
                  (stats-row w
                             "typed-boundary"
                             (cause-count log a "typed-boundary")
                             damaged)
                  ; Retain historical labels so old log files remain summarizable.
                  (stats-row w
                             "adjudicated"
                             (cause-count log a "adjudicated")
                             damaged)
                  (stats-row w
                             "no-typecheck"
                             (cause-count log a "no-typecheck")
                             damaged)
                  (wb w 10)
                  (ps w "why the refusals happened:")
                  (wb w 10)
                  (stats-row w
                             "no-typed-boundary"
                             (cause-count log a "no-typed-boundary")
                             refused)
                  (stats-row w
                             "ambiguous-type-boundary"
                             (cause-count log a "ambiguous-type-boundary")
                             refused)
                  (stats-row w
                             "multiple-typed-boundaries"
                             (cause-count log a "multiple-typed-boundaries")
                             refused)
                  (stats-row w
                             "none-compile"
                             (cause-count log a "none-compile")
                             refused)
                  (stats-row w
                             "ambiguous-compile"
                             (cause-count log a "ambiguous-compile")
                             refused)
                  (stats-row w "capped" (cause-count log a "capped") refused)
                  (stats-row w
                             "surplus-ambiguous"
                             (cause-count log a "surplus-ambiguous")
                             refused)
                  (stats-row w
                             "mismatch"
                             (cause-count log a "mismatch")
                             refused)
                  (stats-row w
                             "move-required"
                             (cause-count log a "move-required")
                             refused)
                  (stats-row w
                             "inside-line"
                             (cause-count log a "inside-line")
                             refused)
                  (stats-row w
                             "no-place"
                             (cause-count log a "no-place")
                             refused)
                  (stats-row w
                             "over-fire"
                             (cause-count log a "over-fire")
                             refused)
                  (stats-row w
                             "underflow"
                             (cause-count log a "underflow")
                             refused)
                  (stats-row w
                             "indent-disagree"
                             (cause-count log a "indent-disagree")
                             refused)
                  (stats-row w
                             "unterminated-string"
                             (cause-count log a "unterminated-string")
                             refused)
                  (stats-row w
                             "internal"
                             (cause-count log a "internal")
                             refused)
                  0)
                0))))))

(defn balance-refusal [(path (slice u8)) (why (slice u8)) (line i64) (col i64)]
  (-> i64)
  (let [w (stderr)]
    (ps w "error: ")
    (ps w why)
    (wb w 10)
    (ps w "  --> ")
    (ps w path)
    (wb w 58)
    (write-decimal w line)
    (wb w 58)
    (write-decimal w col)
    (wb w 10)
    2))

(defn balance-cmd [(a (dyn Allocator)) (argc i32) (argv (ptr (ptr i8)))]
  (-> i64)
  (let [(mut check) false
        (mut write) false
        (mut strict) false
        (mut stats) false
        (mut nfiles) 0
        (mut rc) 0
        (mut i) 1]
    (loop (if (>= (load i) (primitive/cast i64 argc))
              (break)
              (do
                (let [arg (from-cstr (load (index argv (load i))))]
                  (when (and (is-flag? arg) (!= arg "-"))
                    (cond (= arg "--stats") (set! stats true)
                          (= arg "--check") (set! check true)
                          (= arg "--write") (set! write true)
                          (= arg "--strict") (set! strict true)
                          :else
                            (let [w (stderr)]
                              (ps w "error: unknown flag '")
                              (ps w arg)
                              (ps w "'")
                              (wb w 10)
                              (exit 2)
                              0))))
                (set! i (primitive/iadd (load i) 1)))))
    (set! i 1)
    (loop (if (>= (load i) (primitive/cast i64 argc))
              (break)
              (do
                (let [arg (from-cstr (load (index argv (load i))))]
                  (unless (is-flag? arg)
                    (set! nfiles (primitive/iadd (load nfiles) 1))
                    (let [r
                            (balance-one a
                                         (load (index argv (load i)))
                                         (load check)
                                         (load write)
                                         (load strict))]
                      (when (> r (load rc)) (set! rc r) 0))))
                (set! i (primitive/iadd (load i) 1)))))
    (cond (load stats) (balance-stats-cmd a)
          (= (load nfiles) 0)
            (do
              (ps (stderr)
                  "usage: coil balance [--check|--write] [--strict] <file.coil>...\n       coil balance --stats\n")
              2)
          :else (load rc))))

(defn main [(argc i32) (argv (ptr (ptr i8)))] (-> i64)
  (if (and (= argc 2) (= (from-cstr (load (index argv 1))) "--help"))
      (do
        (ps (stdout)
            "usage: coil-balance [--check|--write] [--strict] <file.coil>...\n       coil-balance --stats\n")
        0)
      (balance-cmd (malloc-allocator) argc argv)))
