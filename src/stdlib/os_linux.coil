(module coil.os.linux)
(import "coil.primitive" :as primitive)
(import "coil.os" :as os)

; Linux-only operating-system facilities. Nothing here is portable, which is why it is
; a module of its own and not part of `coil.os`: importing it says the program means
; Linux. Every function exists on every target, so a program that names one still
; builds elsewhere; off Linux it returns `Err (Syscall ENOSYS)`, "function not
; implemented", exactly what a system without the call would answer.

; hygiene: the C symbol and the public function must keep their exact names
(defn linux-public-name [(name Code)] (-> Code)
  (primitive/syntax->datum name))

;;; unshare(2) flag: give the caller its own file-descriptor table.
(const CLONE_FILES 1024)

;;; Give the CALLING THREAD a private copy of the process's file-descriptor table
;;; (`unshare(CLONE_FILES)`). Descriptors open now are duplicated into it. From then
;;; on, a descriptor this thread opens or closes is invisible to every other thread,
;;; and theirs to it.
;;;
;;; The point is a worker that opens and closes many files: threads sharing one table
;;; contend on its lock, a private table does not. The cost is that the thread can no
;;; longer hand a descriptor to another thread by number, or see one another thread
;;; opens afterwards, and it cannot go back. Call it first thing in a thread that owns
;;; its descriptors for its whole life.
(defn linux-unshare-files-body [] (-> Code)
  (if (primitive/code-eq (primitive/target-os) `linux)
      `(do
         (extern ~(linux-public-name `unshare) :cc c [i32] (-> i32))
         (defn ~(linux-public-name `unshare-files!) [] (-> (Result i64 os/OsError))
           (if (= (~(linux-public-name `unshare) (primitive/cast i32 CLONE_FILES)) 0)
               (Ok [i64 os/OsError] 0)
               (Err [i64 os/OsError] (os/Syscall (os/os-errno))))))
      `(defn ~(linux-public-name `unshare-files!) [] (-> (Result i64 os/OsError))
         ; ENOSYS on Darwin
         (Err [i64 os/OsError] (os/Syscall 78)))))

(meta (linux-unshare-files-body))
