(module coil.derive)
(import "coil.primitive" :as primitive)
; Registry-backed, type-directed trait derivation as a library over comptime
; reflection. There are no naming conventions and no parallel per-trait macros:
; `(derive Eq Hash T)` is the sole public entry point.
; ---- generic targets: (derive Eq (Box T)) ----------------------------------
;; `(Box T)` is a LIST whose head is the type and whose rest are its type params.
;; Deriving over one emits a generic impl carrying the derived trait as a bound on each
;; param — mechanically the hand-written `(impl [(T Eq)] Eq (Box T) …)`, which already
;; worked. Without the params the impl mentioned an unbound `T` and blew up with a
;; leaked mangled name ('coil.core.Eq$Box<T>$=' param 'a': unknown type 'T').
;; The walkers here build with code-list-new/push! instead of
;; `(~x ~@(self …)) — that shape re-splices the recursion's suffix at every
;; level, which is quadratic in the field/trait count (docs/design/META_MEMORY.md).
(defn derive--tparams [(tname Code) (trait-name Code) (i i64) (n i64)] (-> Code)
  (let [out (primitive/code-list-new)
        (mut k) i]
    (loop (if (>= (load k) n)
              (break)
              (do (primitive/code-list-push! out `(~(primitive/code-nth tname (load k)) ~trait-name))
                  (store! k (primitive/iadd (load k) 1)))))
    (primitive/code-list-done out)))

;; is this field's type one of the target's type params (the `v : T` in `(Box T)`)?
;; Such a field must compare through the trait — the bound we emit is what guarantees
;; it — not through icmp-eq, which would be nonsense for a T that turns out to be a struct.
(defn derive--tparam-field? [(tname Code) (fty Code) (i i64) (n i64)] (-> bool)
  (if (>= i n)
      false
      (if (primitive/code-eq fty (primitive/code-nth tname i))
          true
          (derive--tparam-field? tname fty (primitive/iadd i 1) n))))
(defn derive--generic-field? [(tname Code) (fty Code)] (-> bool)
  (if (primitive/code-list? tname) (derive--tparam-field? tname fty 1 (primitive/code-count tname)) false))

(defn derive--teq-field [(T Code) (a Code) (b Code) (i i64)] (-> Code)
  (let [fname (primitive/code-field-name T i)
        kind (primitive/code-field-kind T i)
        pa `(field ~a ~fname)
        pb `(field ~b ~fname)]
    (if (derive--generic-field? T (primitive/code-field-type T i))
        `(= ~pa ~pb)  ; T: Eq, via the bound
        (if (= kind (cast i64 3))
            `(= ~pa ~pb)  ; nested: trait =
            (if (= kind (cast i64 4))
                (primitive/error "derive Eq: sum fields unsupported; impl by hand")
                (if (= kind (cast i64 1))
                    `(primitive/fcmp-eq (load ~pa) (load ~pb))
                    `(= (load ~pa) (load ~pb))))))))

(defn derive--teq-and [(T Code) (a Code) (b Code) (i i64) (n i64)] (-> Code)
  (if (= i n)
      `true
      (let [this (derive--teq-field T a b i)]
        (if (= (primitive/iadd i 1) n)
            this
            `(and ~this ~(derive--teq-and T a b (primitive/iadd i 1) n))))))

(defn derive--thash-field [(T Code) (x Code) (i i64)] (-> Code)
  (let [fname (primitive/code-field-name T i)
        kind (primitive/code-field-kind T i)
        p `(field ~x ~fname)]
    (if (derive--generic-field? T (primitive/code-field-type T i))
        `(hash ~p)  ; T: Hash, via the bound
        (if (= kind (cast i64 3))
            `(hash ~p)  ; nested: trait hash
            (if (= kind (cast i64 4))
                (primitive/error "derive Hash: sum fields unsupported; impl by hand")
                (if (= kind (cast i64 1))
                    (primitive/error "derive Hash: float fields unsupported (bit-hashing is lossy); impl by hand")
                    `(load ~p)))))))

(defn derive--thash-steps [(T Code) (x Code) (h Code) (i i64) (n i64)] (-> Code)
  (let [out (primitive/code-list-new)
        (mut k) i]
    (loop (if (>= (load k) n)
              (break)
              (let [fh (derive--thash-field T x (load k))]
                (do (primitive/code-list-push! out `(store! ~h (* (^ (load ~h) ~fh) 1099511628211)))
                    (store! k (primitive/iadd (load k) 1))))))
    (primitive/code-list-done out)))

(defn derive--eq [(trait-name Code) (tname Code)] (-> Code)
  (if (primitive/code-eq trait-name `Eq)
      (if (primitive/code-list? tname)
          `(impl [~@(derive--tparams tname trait-name 1 (primitive/code-count tname))] Eq ~tname
             (= [(a ~tname) (b ~tname)]
                (-> bool)
                ~(derive--teq-and tname `a `b 0 (primitive/code-field-count tname))))
          `(impl Eq ~tname
             (= [(a ~tname) (b ~tname)]
                (-> bool)
                ~(derive--teq-and tname `a `b 0 (primitive/code-field-count tname)))))
      (if (primitive/code-eq trait-name `Hash)
          (if (primitive/code-list? tname)
              `(impl [~@(derive--tparams tname trait-name 1 (primitive/code-count tname))] Hash ~tname
                 (hash [(x ~tname)]
                       (-> i64)
                       (let [(mut h) -3750763034362895579]
                         ~@(derive--thash-steps tname `x `h 0 (primitive/code-field-count tname))
                         (load h))))
              `(impl Hash ~tname
                 (hash [(x ~tname)]
                       (-> i64)
                       (let [(mut h) -3750763034362895579]
                         ~@(derive--thash-steps tname `x `h 0 (primitive/code-field-count tname))
                         (load h)))))
          (primitive/error "derive: internal Eq/Hash arm mismatch"))))

;; Registry-backed derive definitions.  The generated function names are not a
;; protocol: only these explicit registrations make them derivers.
(defderive Eq
           (struct [tname] (derive--eq `Eq tname)))
(defderive Hash
           (struct [tname] (derive--eq `Hash tname)))

(defn derive--spec-args [(spec Code) (i i64) (n i64)] (-> Code)
  (let [out (primitive/code-list-new)
        (mut k) i]
    (loop (if (>= (load k) n)
              (break)
              (do (primitive/code-list-push! out (primitive/code-nth spec (load k)))
                  (store! k (primitive/iadd (load k) 1)))))
    (primitive/code-list-done out)))

(defn derive--calls [(tname Code) (traits Code) (i i64) (n i64)] (-> Code)
  (let [out (primitive/code-list-new)
        (mut k) i]
    (loop (if (>= (load k) n)
              (break)
              (let [spec (primitive/code-nth traits (load k))
                    _c (if (primitive/code-list? spec)
                           (if (= (primitive/code-count spec) (cast i64 0))
                               (primitive/error "derive: an option-bearing trait spec may not be empty")
                               (primitive/code-list-push! out
                                                          `(~(primitive/code-deriver (primitive/code-nth spec 0) tname) ~tname
                                                              ~@(derive--spec-args spec 1 (primitive/code-count spec)))))
                           (primitive/code-list-push! out `(~(primitive/code-deriver spec tname) ~tname)))]
                (store! k (primitive/iadd (load k) 1)))))
    (primitive/code-list-done out)))

;; `(derive Trait... Type)` dispatches exclusively through the registry. A trait
;; spec may be a list to pass options to that one deriver:
;; `(derive (Serialize (rename-all :camelCase)) Deserialize T)`.
(defn derive [& (args Code)] (-> Code)
  (let [n (primitive/code-count args)]
    (if (< n (cast i64 2))
        (primitive/error "derive: expected (derive Trait... Type)")
        (let [tname (primitive/code-nth args (primitive/isub n 1))]
          `(do ~@(derive--calls tname args 0 (primitive/isub n 1)))))))
