(module coil.derive)

(export derive plain-copy-type?)

(provide-core [derive])

(import "coil.primitive" :as primitive)

; Registry-backed, type-directed trait derivation as a library over comptime
; reflection. There are no naming conventions and no parallel per-trait macros:
; `(derive Eq Hash T)` is the sole public entry point.
; ---- generic targets: (derive Eq (Box T)) ----------------------------------
;;; `(Box T)` is a LIST whose head is the type and whose rest are its type params.
;;; Deriving over one emits a generic impl carrying the derived trait as a bound on each
;;; param — mechanically the hand-written `(impl [(T Eq)] Eq (Box T) …)`, which already
;;; worked. Without the params the impl mentioned an unbound `T` and blew up with a
;;; leaked mangled name ('coil.core.Eq$Box<T>$=' param 'a': unknown type 'T').
;;; The walkers here build with code-list-new/push! instead of
;;; `(~x ~@(self …)) — that shape re-splices the recursion's suffix at every
;;; level, which is quadratic in the field/trait count (docs/design/META_MEMORY.md).
(defn derive--tparams [(tname Code) (trait-name Code) (i i64) (n i64)] (-> Code)
  (let [out (primitive/code-list-new)
        (mut k) i]
    (loop (if (>= (load k) n)
              (break)
              (do
                (primitive/code-list-push! out
                                           `(~(primitive/code-nth tname
                                                                  (load k)) ~trait-name))
                (store! k (primitive/iadd (load k) 1)))))
    (primitive/code-list-done out)))

;;; is this field's type one of the target's type params (the `v : T` in `(Box T)`)?
;;; Such a field must compare through the trait — the bound we emit is what guarantees
;;; it — not through icmp-eq, which would be nonsense for a T that turns out to be a struct.
(defn derive--tparam-field? [(tname Code) (fty Code) (i i64) (n i64)] (-> bool)
  (if (>= i n)
      false
      (if (primitive/code-eq fty (primitive/code-nth tname i))
          true
          (derive--tparam-field? tname fty (primitive/iadd i 1) n))))

(defn derive--generic-field? [(tname Code) (fty Code)] (-> bool)
  (if (primitive/code-list? tname)
      (derive--tparam-field? tname fty 1 (primitive/code-count tname))
      false))

(defn derive--teq-field [(T Code) (a Code) (b Code) (i i64)] (-> Code)
  (let [fname (primitive/code-field-name T i)
        kind (primitive/code-field-kind T i)
        pa `(field ~a ~fname)
        pb `(field ~b ~fname)]
    (if (derive--generic-field? T (primitive/code-field-type T i))
        `(= ~pa ~pb)  ; T: Eq, via the bound
        (if (= kind (cast i64 3))
            `(= ~pa ~pb)  ; nested: trait =
            (if (= kind (cast i64 4))
                `(= ~pa ~pb)  ; nested sum: trait =
                (if (= kind (cast i64 1))
                    `(primitive/fcmp-eq (load ~pa) (load ~pb))
                    `(= (load ~pa) (load ~pb))))))))

(defn derive--teq-and [(T Code) (a Code) (b Code) (i i64) (n i64)] (-> Code)
  (if (= i n)
      `true
      (let [this (derive--teq-field T a b i)]
        (if (= (primitive/iadd i 1) n)
            this
            `(and ~this ~(derive--teq-and T a b (primitive/iadd i 1) n))))))

(defn derive--thash-field [(T Code) (x Code) (i i64)] (-> Code)
  (let [fname (primitive/code-field-name T i)
        kind (primitive/code-field-kind T i)
        p `(field ~x ~fname)]
    (if (derive--generic-field? T (primitive/code-field-type T i))
        `(hash ~p)  ; T: Hash, via the bound
        (if (= kind (cast i64 3))
            `(hash ~p)  ; nested: trait hash
            (if (= kind (cast i64 4))
                `(hash ~p)  ; nested sum: trait hash
                (if (= kind (cast i64 1))
                    (primitive/error "derive Hash: float fields unsupported (bit-hashing is lossy); impl by hand")
                    `(load ~p)))))))

(defn derive--thash-steps [(T Code) (x Code) (h Code) (i i64) (n i64)] (-> Code)
  (let [out (primitive/code-list-new)
        (mut k) i]
    (loop (if (>= (load k) n)
              (break)
              (let [fh (derive--thash-field T x (load k))]
                (do
                  (primitive/code-list-push! out
                                             `(store! ~h
                                                      (primitive/imul (^ (load ~h) ~fh)
                                                                      1099511628211)))
                  (store! k (primitive/iadd (load k) 1))))))
    (primitive/code-list-done out)))

(defn derive--eq [(trait-name Code) (tname Code)] (-> Code)
  (let [a-id (primitive/fresh-identifier "left")
        b-id (primitive/fresh-identifier "right")
        x-id (primitive/fresh-identifier "value")
        h-id (primitive/fresh-identifier "hash")]
    (if (primitive/code-eq trait-name `Eq)
        (if (primitive/code-list? tname)
            `(impl [~@(derive--tparams tname
                                       trait-name
                                       1
                                       (primitive/code-count tname))] Eq ~tname
               (= [(~a-id ~tname) (~b-id ~tname)]
                  (-> bool)
                  ~(derive--teq-and tname
                                    a-id
                                    b-id
                                    0
                                    (primitive/code-field-count tname))))
            `(impl Eq ~tname
               (= [(~a-id ~tname) (~b-id ~tname)]
                  (-> bool)
                  ~(derive--teq-and tname
                                    a-id
                                    b-id
                                    0
                                    (primitive/code-field-count tname)))))
        (if (primitive/code-eq trait-name `Hash)
            (if (primitive/code-list? tname)
                `(impl [~@(derive--tparams tname
                                           trait-name
                                           1
                                           (primitive/code-count tname))] Hash ~tname
                   (hash [(~x-id ~tname)]
                         (-> i64)
                         (let [(mut ~h-id) -3750763034362895579]
                           ~@(derive--thash-steps tname
                                                  x-id
                                                  h-id
                                                  0
                                                  (primitive/code-field-count tname))
                           (load ~h-id))))
                `(impl Hash ~tname
                   (hash [(~x-id ~tname)]
                         (-> i64)
                         (let [(mut ~h-id) -3750763034362895579]
                           ~@(derive--thash-steps tname
                                                  x-id
                                                  h-id
                                                  0
                                                  (primitive/code-field-count tname))
                           (load ~h-id)))))
            (primitive/error "derive: internal Eq/Hash arm mismatch")))))

; ---- ownership derives -----------------------------------------------------
; Clone is fieldwise. Scalar/pointer/view fields are Copy and can be loaded;
; aggregate and generic fields call Clone so their own ownership policy remains
; authoritative. Named construction preserves declaration order.
(defn derive--clone-value [(T Code) (self Code) (i i64)] (-> Code)
  (let [fname (primitive/code-field-name T i)
        kind (primitive/code-field-kind T i)
        place `(field ~self ~fname)]
    (if (or (derive--generic-field? T (primitive/code-field-type T i))
            (= kind (cast i64 3)))
        `(clone ~place)
        (if (= kind (cast i64 4))
            `(clone ~place)  ; nested sum: its own Clone
            `(load ~place)))))

(defn derive--clone-fields [(T Code) (self Code) (i i64) (n i64)] (-> Code)
  (let [out (primitive/code-list-new)
        (mut k) i]
    (loop (if (>= (load k) n)
              (break)
              (let [fname (primitive/code-field-name T (load k))]
                (primitive/code-list-push! out
                                           (primitive/code-symbol ":" fname))
                (primitive/code-list-push! out
                                           (derive--clone-value T self (load k)))
                (store! k (primitive/iadd (load k) 1)))))
    (primitive/code-list-done out)))

(defn derive--target-args [(T Code)] (-> Code)
  (let [out (primitive/code-list-new)]
    (when (primitive/code-list? T)
      (let [(mut i) 1
            n (primitive/code-count T)]
        (loop (if (>= (load i) n)
                  (break)
                  (do
                    (primitive/code-list-push! out
                                               (primitive/code-nth T (load i)))
                    (store! i (primitive/iadd (load i) 1)))))))
    (primitive/code-list-done out)))

(defn derive--clone [(tname Code)] (-> Code)
  (let [self (primitive/fresh-identifier "self")
        body
          (if (primitive/code-list? tname)
              `(~(primitive/code-nth tname 0) [~@(derive--target-args tname)]
                  ~@(derive--clone-fields tname
                                          self
                                          0
                                          (primitive/code-field-count tname)))
              `(~tname ~@(derive--clone-fields tname
                                               self
                                               0
                                               (primitive/code-field-count tname))))]
    (if (primitive/code-list? tname)
        `(impl [~@(derive--tparams tname `Clone 1 (primitive/code-count tname))] Clone ~tname
           (clone [(~self (ref ~tname))] (-> ~tname) ~body))
        `(impl Clone ~tname
           (clone [(~self (ref ~tname))] (-> ~tname) ~body)))))

(defn derive--copy [(tname Code)] (-> Code)
  (if (primitive/code-list? tname)
      `(impl [~@(derive--tparams tname `Copy 1 (primitive/code-count tname))] Copy ~tname
         (copy-witness [(self (ref ~tname))] (-> void) 0))
      `(impl Copy ~tname
         (copy-witness [(self (ref ~tname))] (-> void) 0))))

;;; Whether reflected type syntax is trivially copyable without invoking Clone.
;;; Ownership transforms share this predicate with the built-in Clone deriver.
(defn plain-copy-type? [(ty Code)] (-> bool)
  (if (primitive/code-sym? ty)
      (or (primitive/code-eq ty `i8)
          (or (primitive/code-eq ty `i16)
              (or (primitive/code-eq ty `i32)
                  (or (primitive/code-eq ty `i64)
                      (or (primitive/code-eq ty `u8)
                          (or (primitive/code-eq ty `u16)
                              (or (primitive/code-eq ty `u32)
                                  (or (primitive/code-eq ty `u64)
                                      (or (primitive/code-eq ty `f32)
                                          (or (primitive/code-eq ty `f64)
                                              (or (primitive/code-eq ty `bool)
                                                  (primitive/code-eq ty `void))))))))))))
      (and (primitive/code-list? ty)
           (> (primitive/code-count ty) 0)
           (let [head (primitive/code-nth ty 0)]
             (and (primitive/code-sym? head)
                  (or (primitive/code-eq head `ptr)
                      (or (primitive/code-eq head `ref)
                          (or (primitive/code-eq head `mut)
                              (or (primitive/code-eq head `slice)
                                  (primitive/code-eq head `fnptr))))))))))

(defn derive--sum-binds [(T Code) (vi i64) (n i64)] (-> Code)
  (let [out (primitive/code-list-new)
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (primitive/code-list-push! out
                                           (primitive/fresh-identifier (primitive/code-symbol "clone$field$"
                                                                                              (primitive/code-variant-field-name T
                                                                                                                                 vi
                                                                                                                                 (load i)))))
                (store! i (primitive/iadd (load i) 1)))))
    (primitive/code-list-done out)))

(defn derive--sum-values [(T Code) (vi i64) (binds Code) (n i64)] (-> Code)
  (let [out (primitive/code-list-new)
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (let [ty (primitive/code-variant-field-type T vi (load i))
                    value (primitive/code-nth binds (load i))]
                (primitive/code-list-push! out
                                           (if (plain-copy-type? ty)
                                               value
                                               `(clone ~value)))
                (store! i (primitive/iadd (load i) 1)))))
    (primitive/code-list-done out)))

(defn derive--clone-sum-arms [(T Code) (vi i64) (nv i64)] (-> Code)
  (let [out (primitive/code-list-new)
        (mut i) vi]
    (loop (if (>= (load i) nv)
              (break)
              (let [nf (primitive/code-variant-fields T (load i))
                    binds (derive--sum-binds T (load i) nf)]
                (primitive/code-list-push! out
                                           `(~(primitive/code-variant-qname T
                                                                            (load i)) [~@binds]
                                               ~(if (primitive/code-list? T)
                                                    `(~(primitive/code-variant-qname T
                                                                                     (load i)) [~@(derive--target-args T)]
                                                        ~@(derive--sum-values T
                                                                              (load i)
                                                                              binds
                                                                              nf))
                                                    `(~(primitive/code-variant-qname T
                                                                                     (load i)) ~@(derive--sum-values T
                                                                                                                     (load i)
                                                                                                                     binds
                                                                                                                     nf)))))
                (store! i (primitive/iadd (load i) 1)))))
    (primitive/code-list-done out)))

(defn derive--clone-sum [(tname Code)] (-> Code)
  (let [self (primitive/fresh-identifier "self")
        body
          `(match (load ~self)
             ~@(derive--clone-sum-arms tname
                                       0
                                       (primitive/code-variant-count tname)))]
    (if (primitive/code-list? tname)
        `(impl [~@(derive--tparams tname `Clone 1 (primitive/code-count tname))] Clone ~tname
           (clone [(~self (ref ~tname))] (-> ~tname) ~body))
        `(impl Clone ~tname
           (clone [(~self (ref ~tname))] (-> ~tname) ~body)))))

;;; How a sum payload field of type TY compares and hashes, by its spelling:
;;; 0 integer or bool, 1 float, 2 anything else (through its own trait impl).
;;; Compared as Code, not as strings: a hermetic profile has no string `=`.
(defn derive--payload-kind [(ty Code)] (-> i64)
  (cond (not (primitive/code-sym? ty)) 2
        (or (primitive/code-eq ty `f64) (primitive/code-eq ty `f32)) 1
        (or (primitive/code-eq ty `bool)
            (or (primitive/code-eq ty `i8)
                (or (primitive/code-eq ty `i16)
                    (or (primitive/code-eq ty `i32)
                        (or (primitive/code-eq ty `i64)
                            (or (primitive/code-eq ty `u8)
                                (or (primitive/code-eq ty `u16)
                                    (or (primitive/code-eq ty `u32)
                                        (or (primitive/code-eq ty `u64)
                                            (or (primitive/code-eq ty `isize)
                                                (primitive/code-eq ty `usize))))))))))) 0
        :else 2))

(defn derive--sum-eq-fields [(T Code) (vi i64) (xs Code) (ys Code) (n i64)] (-> Code)
  (let [(mut out) `true]
    (for [k 0 n]
      (let [i (- (- n 1) k)
            x (primitive/code-nth xs i)
            y (primitive/code-nth ys i)
            same (if (= (derive--payload-kind (primitive/code-variant-field-type T vi i)) 1)
                     `(primitive/fcmp-eq ~x ~y)
                     `(= ~x ~y))]
        (set! out (if (= k 0) same `(and ~same ~(load out))))))
    (load out)))

(defn derive--sum-eq-arms [(T Code) (right Code)] (-> Code)
  (let [out (primitive/code-list-new)
        nv (primitive/code-variant-count T)]
    (for [vi 0 nv]
      (let [nf (primitive/code-variant-fields T vi)
            xs (derive--sum-binds T vi nf)
            ys (derive--sum-binds T vi nf)
            variant (primitive/code-variant-qname T vi)]
        (primitive/code-list-push! out
          `(~variant [~@xs]
             (match ~right
               (~variant [~@ys] ~(derive--sum-eq-fields T vi xs ys nf))
               (_ false))))
        0))
    (primitive/code-list-done out)))

(defn derive--sum-hash-arms [(T Code) (h Code)] (-> Code)
  (let [out (primitive/code-list-new)
        nv (primitive/code-variant-count T)]
    (for [vi 0 nv]
      (let [nf (primitive/code-variant-fields T vi)
            xs (derive--sum-binds T vi nf)
            steps (primitive/code-list-new)]
        (for [i 0 nf]
          (let [x (primitive/code-nth xs i)
                kind (derive--payload-kind (primitive/code-variant-field-type T vi i))
                fh (cond (= kind 0) `(cast i64 ~x)
                         (= kind 1) (primitive/error "derive Hash: float fields unsupported (bit-hashing is lossy); impl by hand")
                         :else `(hash ~x))]
            (primitive/code-list-push! steps `(store! ~h (primitive/imul (^ (load ~h) ~fh) 1099511628211)))
            0))
        (primitive/code-list-push! out
          `(~(primitive/code-variant-qname T vi) [~@xs]
             (do (store! ~h (primitive/imul (^ (load ~h) ~vi) 1099511628211))
                 ~@(primitive/code-list-done steps)
                 0)))
        0))
    (primitive/code-list-done out)))

;;; `Eq` for a sum: equal when both values are the same variant with equal payloads.
(defn derive--eq-sum [(tname Code)] (-> Code)
  (let [left (primitive/fresh-identifier "left")
        right (primitive/fresh-identifier "right")
        body `(match ~left ~@(derive--sum-eq-arms tname right))]
    (if (primitive/code-list? tname)
        `(impl [~@(derive--tparams tname `Eq 1 (primitive/code-count tname))] Eq ~tname
           (= [(~left ~tname) (~right ~tname)] (-> bool) ~body))
        `(impl Eq ~tname
           (= [(~left ~tname) (~right ~tname)] (-> bool) ~body)))))

;;; `Hash` for a sum: FNV-style mixing of the variant index and each payload field.
(defn derive--hash-sum [(tname Code)] (-> Code)
  (let [value (primitive/fresh-identifier "value")
        h (primitive/fresh-identifier "hash")
        body `(let [(mut ~h) -3750763034362895579]
                (match ~value ~@(derive--sum-hash-arms tname h))
                (load ~h))]
    (if (primitive/code-list? tname)
        `(impl [~@(derive--tparams tname `Hash 1 (primitive/code-count tname))] Hash ~tname
           (hash [(~value ~tname)] (-> i64) ~body))
        `(impl Hash ~tname
           (hash [(~value ~tname)] (-> i64) ~body)))))

;; Registry-backed derive definitions.  The generated function names are not a
;; protocol: only these explicit registrations make them derivers.
(defderive Eq
           (struct [tname] (derive--eq `Eq tname))
           (sum [tname] (derive--eq-sum tname)))

(defderive Hash
           (struct [tname] (derive--eq `Hash tname))
           (sum [tname] (derive--hash-sum tname)))

(defderive Clone
           (struct [tname] (derive--clone tname))
           (sum [tname] (derive--clone-sum tname)))

(defderive Copy
           (struct [tname] (derive--copy tname))
           (sum [tname] (derive--copy tname)))

(defn derive--spec-args [(spec Code) (i i64) (n i64)] (-> Code)
  (let [out (primitive/code-list-new)
        (mut k) i]
    (loop (if (>= (load k) n)
              (break)
              (do
                (primitive/code-list-push! out
                                           (primitive/code-nth spec (load k)))
                (store! k (primitive/iadd (load k) 1)))))
    (primitive/code-list-done out)))

(defn derive--calls [(tname Code) (traits Code) (i i64) (n i64)] (-> Code)
  (let [out (primitive/code-list-new)
        (mut k) i]
    (loop (if (>= (load k) n)
              (break)
              (let [spec (primitive/code-nth traits (load k))
                    _c
                      (if (primitive/code-list? spec)
                          (if (= (primitive/code-count spec) (cast i64 0))
                              (primitive/error "derive: an option-bearing trait spec may not be empty")
                              (primitive/code-list-push! out
                                                         `(~(primitive/code-deriver (primitive/code-nth spec
                                                                                                        0)
                                                                                    tname) ~tname
                                                             ~@(derive--spec-args spec
                                                                                  1
                                                                                  (primitive/code-count spec)))))
                          (primitive/code-list-push! out
                                                     `(~(primitive/code-deriver spec
                                                                                tname) ~tname)))]
                (store! k (primitive/iadd (load k) 1)))))
    (primitive/code-list-done out)))

;;; `(derive Trait... Type)` dispatches exclusively through the registry. A trait
;;; spec may be a list to pass options to that one deriver:
;;; `(derive (Serialize (rename-all :camelCase)) Deserialize T)`.
(defn derive [& (args Code)] (-> Code)
  (let [n (primitive/code-count args)]
    (if (< n (cast i64 2))
        (primitive/error "derive: expected (derive Trait... Type)")
        (let [tname (primitive/code-nth args (primitive/isub n 1))]
          `(do ~@(derive--calls tname args 0 (primitive/isub n 1)))))))
