;;; Lifetime declarations for functions compiled by a retained JIT session.
(module coil.jit.lifetime)

;;; False excludes a concrete runtime function from the session's metadata roots.
;;; A retained initializer, generic, or metaprogram can still keep it alive through
;;; a dependency. Its native code remains callable through published pointers.
;;; This lets metaprograms publish fresh implementations without retaining an
;;; unused compiler definition. Functions are roots unless annotated false.
(defannotation :jit/retain bool)

;;; A versioned metadata root within the function's module. Use with
;;; :jit/retain false and a positive :jit/root-version. A new function may advance
;;; the same positive root ID; only its newest version is a metadata root.
;;; Superseded functions still remain if other retained declarations call them.
;;; This changes compiler metadata ownership, never native generation leases.
(defannotation :jit/root i64)
(defannotation :jit/root-version i64)
