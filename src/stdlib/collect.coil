(module coil.collect)
(import "coil.primitive" :as primitive)
(import "coil.alloc" :as alloc)

; A zero-sized-in-practice type witness used to dispatch collection construction
; on the requested output type. Keeping it explicit lets the ordinary trait
; system select the implementation without an ambient allocator.
(defstruct CollectTarget [C] [(marker i64)])

;;; Implemented by collection modules that can own a run of homogeneous elements.
;;; The allocator stays an argument because Coil has no ambient heap.
(deftrait Collect [Self Collection Item]
  (collect-from [(target Self)
                 (allocator (dyn alloc/Allocator))
                 (items (slice Item))]
                (-> Collection)))

;;; `(collect [CollectionType] allocator [elements...])` constructs an owned
;;; collection through `Collect`. The bracket expression itself remains an inline
;;; array borrowed as a slice for this call.
(defn collect [(types Code) (allocator Code) (items Code)] (-> Code)
  (if (or (not (primitive/code-vector? types))
          (!= (primitive/code-count types) 1))
      (primitive/error "collect: expected (collect [CollectionType] allocator [elements...])")
      (let [collection (primitive/code-nth types 0)]
        `(collect-from (: (coil.collect.CollectTarget :marker 0) (coil.collect.CollectTarget ~collection))
                       ~allocator
                       ~items))))

(export Collect CollectTarget collect collect-from)
