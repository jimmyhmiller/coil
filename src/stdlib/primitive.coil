(module coil.primitive)

; Raw compiler operations. This module is intentionally not auto-referred: a source
; name denotes a primitive only after normal module resolution reaches one of these
; declarations. The final keyword is compiler lowering metadata, not a callable name.
;
; A compile-time query that can answer in more than one way names the sum it answers
; with, `(-> Resolution)`, and the sums are declared here beside it. A metaprogram
; matches on the answer: `(match (primitive/resolve-at n name) (primitive/ResolvesTo
; [q] …) …)`.
(defprimitive alloc-stack [T] (-> (ptr T)) :alloc-stack)

;; Dynamic bytes in the executing function's frame, aligned to 16 bytes.
;; Every evaluation allocates again; a loop accumulates storage until return.
(defprimitive alloc-stack-bytes :alloc-stack-bytes)

(defprimitive alloc-static [T] (-> (ptr T)) :alloc-static)

(defprimitive alloc-heap [T] (-> (ptr T)) :alloc-heap)

; Integer and floating-point machine operations.
(defprimitive iadd :iadd)

(defprimitive isub :isub)

(defprimitive imul :imul)

(defprimitive idiv :idiv)

(defprimitive irem :irem)

(defprimitive udiv :udiv)

(defprimitive urem :urem)

(defprimitive iand :iand)

(defprimitive ior :ior)

(defprimitive ixor :ixor)

(defprimitive ishl :ishl)

(defprimitive ishr :ishr)

(defprimitive inot :inot)

(defprimitive clz :clz)

(defprimitive ctz :ctz)

(defprimitive popcount :popcount)

(defprimitive bswap :bswap)

(defprimitive rotl :rotl)

(defprimitive rotr :rotr)

(defprimitive mulhi :mulhi)

(defprimitive iadd-overflow? :iadd-overflow?)

(defprimitive isub-overflow? :isub-overflow?)

(defprimitive imul-overflow? :imul-overflow?)

(defprimitive fadd :fadd)

(defprimitive fsub :fsub)

(defprimitive fmul :fmul)

(defprimitive fdiv :fdiv)

(defprimitive frem :frem)

(defprimitive icmp-lt :icmp-lt)

(defprimitive icmp-le :icmp-le)

(defprimitive icmp-gt :icmp-gt)

(defprimitive icmp-ge :icmp-ge)

(defprimitive icmp-eq :icmp-eq)

(defprimitive icmp-ne :icmp-ne)

(defprimitive fcmp-lt :fcmp-lt)

(defprimitive fcmp-le :fcmp-le)

(defprimitive fcmp-gt :fcmp-gt)

(defprimitive fcmp-ge :fcmp-ge)

(defprimitive fcmp-eq :fcmp-eq)

(defprimitive fcmp-ne :fcmp-ne)

; Memory, representation, and indirect calls.
(defprimitive zeroed :zeroed)

(defprimitive field :field)

(defprimitive bit-get :bit-get)

(defprimitive bit-set! :bit-set!)

(defprimitive fnptr-of :fnptr-of)

(defprimitive call-ptr :call-ptr)

(defprimitive load :load)

(defprimitive store! :store!)

(defprimitive volatile-load :volatile-load)

(defprimitive volatile-store! :volatile-store!)

(defprimitive alias-load :alias-load)

(defprimitive alias-store! :alias-store!)

(defprimitive fence! :fence!)

(defprimitive free :free)

(defprimitive make-dyn :make-dyn)

(defprimitive index :index)

(defprimitive cast :cast)

(defprimitive sizeof :sizeof)

(defprimitive alignof :alignof)

(defprimitive offsetof :offsetof)

(defprimitive llvm-ir :llvm-ir)

(defprimitive linker-address :linker-address)

;;; `(machine-code ARCH BYTE…)` as the whole body of a `defn`: the function is
;;; these bytes followed by the target's return instruction, unless it returns
;;; `never`. ARCH is the `coil.core.Arch` the bytes are for, such as `(Riscv32)`,
;;; and is checked against the target, so a build for another architecture
;;; refuses the function. The calling convention is the contract: arguments
;;; arrive where `:cc` puts them, and the bytes leave the result there, preserve
;;; what the convention says a callee preserves, and leave the stack pointer and
;;; return address alone. The compiler treats a call as touching all memory.
(defprimitive machine-code :machine-code)

; Compile-time type and declaration reflection.
(defprimitive field-count :field-count)

(defprimitive variant-count :variant-count)

(defprimitive struct? :struct?)

(defprimitive sum? :sum?)

(defprimitive int? :int?)

(defprimitive float? :float?)

(defprimitive ptr? :ptr?)

(defprimitive array? :array?)

(defprimitive field-name :field-name)

(defprimitive field-type-kind :field-type-kind)

(defprimitive field-type-name :field-type-name)

(defprimitive field-index :field-index)

; Compile-time Code operations and compiler environment queries.
(defprimitive code-list? :code-list?)

(defprimitive code-sym? :code-sym?)

(defprimitive code-int? :code-int?)

(defprimitive code-count :code-count)

(defprimitive code-nth :code-nth)

(defprimitive code-sym :code-sym)

(defprimitive code-int :code-int)

(defprimitive code-rest :code-rest)

(defprimitive code-eq :code-eq)

(defprimitive code-keyword? :code-keyword?)

(defprimitive code-vector? :code-vector?)

(defprimitive code-float? :code-float?)

(defprimitive code-float-bits :code-float-bits)

(defprimitive code-exported? :code-exported?)

;;; Parse SOURCE, either a runtime `(slice u8)` or string Code, with
;;; character-valued reader configuration Code, e.g.
;;; `(reader-config :unquote #\, :splice #\@)`.
;;; Intended for `:phase (phase/Read)` metaprograms that delegate to the built-in reader.
(defprimitive code-read :code-read)

;;; Make a fresh growable Code list for metaprograms that emit many forms. Unlike
;;; repeated quasiquote suffix splicing, pushes are amortized constant time.
(defprimitive code-list-new :code-list-new)

;;; Append one Code node to a list created by `code-list-new`; returns that list.
(defprimitive code-list-push! :code-list-push!)

;;; Freeze a CodeBuilder into Code. Identity at runtime; the CodeBuilder/Code
;;; type split is the point: a finished list cannot be pushed onto, a list still
;;; being built cannot be read (docs/design/META_MEMORY.md phase 4).
(defprimitive code-list-done :code-list-done)

;;; `(code-list-like PROTOTYPE ITEMS)` replaces a list/vector's children while
;;; preserving PROTOTYPE's shape (list or vector), source and hygiene identity. Semantic transforms use
;;; this for declaration containers (`impl`, method, function) whose binder
;;; context must survive a body rewrite.
(defprimitive code-list-like :code-list-like)

;;; `(code-slice CODE LO HI)` — an O(1) VIEW of elements [LO, HI). Like
;;; `code-rest`, it copies nothing: both alias the parent list, which is why
;;; cdr-style recursion over Code is linear (docs/design/META_MEMORY.md ph 5).
(defprimitive code-slice :code-slice)

;;; The ONE deep copy, named as one: fresh structure and string payloads.
(defprimitive code-copy :code-copy)

;;; `(code-concat A B)` — a fresh list holding A's elements then B's. O(n+m),
;;; and it says so in its name.
(defprimitive code-concat :code-concat)

;;; `(code-opaque CODE)` — a compilation-scoped i64 handle naming the exact node,
;;; so a native phase program (a compiled Scheme transformer's syntax object) can
;;; retain syntax inside its own tagged data. Valid for the invocation that made
;;; it: the node lives in the expansion arena, and keeping a handle across
;;; invocations is the same use-after-reset as keeping any borrowed Code.
(defprimitive code-opaque :code-opaque)

;;; `(code-from-opaque HANDLE)` — the exact Code node a handle names; a located
;;; error on anything that is not a live handle.
(defprimitive code-from-opaque :code-from-opaque)

;;; String-literal predicate, completing the atom set (sym?/int?/float?/keyword?).
(defprimitive code-string? :code-string?)

(defprimitive code-symbol :code-symbol)

(defprimitive code-str :code-str)

;;; Scope-bearing identifier operations. Context introduction is deliberately
;;; named and searchable; `code-symbol` remains an unscoped/data-name builder.
(defprimitive fresh-identifier :fresh-identifier)

(defprimitive datum->syntax :datum->syntax)

(defprimitive syntax->datum :syntax->datum)

(defprimitive free-identifier=? :free-identifier=?)

(defprimitive bound-identifier=? :bound-identifier=?)

(defprimitive code-field-count :code-field-count)

(defprimitive code-field-name :code-field-name)

(defprimitive code-field-kind :code-field-kind)

(defprimitive code-field-type :code-field-type)

;;; The field's type name with its QUALIFICATION intact. Use this, not
;;; `code-field-type`, when building a symbol that generated code will call.
(defprimitive code-field-qtype :code-field-qtype)

;;; What kind of type a reflected type is, as `code-type-shape` answers.
(defsum TypeShape
  ;;; A struct.
  (StructShape)
  ;;; A sum.
  (SumShape)
  ;;; Neither, or a name no type has.
  (UnknownShape))

;;; Safely classify a reflected type without probing a shape-specific API.
(defprimitive code-type-shape [(type Code)] (-> TypeShape) :code-type-shape)

;;; The traits a type implements, as `code-type-traits` answers.
(defsum Traits
  ;;; NAMES, a list of the traits' qualified names.
  (TraitsAre [(names Code)])
  ;;; There is no checked program yet to ask.
  (TraitsUnknown))

;;; `(code-type-traits TYPE)`: the traits TYPE implements: those the checker would
;;; accept a use of at TYPE, generic impls included when their bounds hold there
;;; (`(Option S)` has Debug only when S does). TYPE is a type as `type-of` reports
;;; it.
(defprimitive code-type-traits [(type Code)] (-> Traits) :code-type-traits)

;;; Compiler-SDK session state for source metaprograms. The accepted value is
;;; immutable `Code`; a candidate may stage a replacement, which the owning JIT
;;; session commits only after native publication succeeds.
(defprimitive code-session-state :code-session-state)

;;; True while a source transform runs in a retained compiler SDK session.
;;; Policies can use this to remain valid in ordinary ahead-of-time builds.
(defprimitive code-session-active? :code-session-active?)

;;; This compilation's number in its retained session: it grows with every
;;; compilation the session begins, so a later submission always has a larger one.
;;; 0 outside a retained session. A metaprogram that publishes a new version of a
;;; metadata root uses it as `:jit/root-version`.
(defprimitive code-session-submission :code-session-submission)

(defprimitive code-session-stage! :code-session-stage!)

;;; Accepted concrete generic/trait artifacts from the retained compiler session.
;;; The result is structural Code; generated names are artifact values, not IDs.
(defprimitive code-session-monomorphs :code-session-monomorphs)

;;; Stage a structured positive rejection kind for the current compiler-SDK
;;; candidate. It remains inspectable after the candidate is rejected and is
;;; cleared when the next transaction begins or a candidate commits.
(defprimitive code-session-condition! :code-session-condition!)

;;; The source-model Code staged by the last rejected compiler-SDK transaction.
(defprimitive code-session-rejected-state :code-session-rejected-state)

;;; The source-model Code staged so far by the current compiler-SDK transaction,
;;; or the default when nothing is staged. A later stage of one transaction reads
;;; what an earlier stage decided without carrying it in the program.
(defprimitive code-session-staged-state :code-session-staged-state)

;;; `(code-deriver TRAIT TYPE)` — the deriver REGISTERED for TRAIT, already picked
;;; for TYPE's shape. The answer comes from the `(register-derive …)` table and from
;;; nothing else: naming a function a particular way never makes it a deriver.
;;; Errors, naming the trait, when it has no registration or no arm for that shape.
(defprimitive code-deriver :code-deriver)

(defprimitive code-variant-sum :code-variant-sum)

;;; What `code-variant-ref` answers.
(defsum VariantRef
  ;;; The constructor names the variant NAME, qualified: `coil.mmio.ReadOnly`.
  (NamesVariant [(name Code)])
  ;;; No variant of that name is in scope where the constructor was written.
  (NamesNoVariant))

;;; `(code-variant-ref CONSTRUCTOR)`: the variant the constructor symbol names
;;; where it was written, resolved through that module's imports, as a macro
;;; that decides by a value the user wrote reads it: compare the answer, never
;;; the spelling.
(defprimitive code-variant-ref [(constructor Code)] (-> VariantRef) :code-variant-ref)

;;; What `code-type-ref` answers.
(defsum TypeRef
  ;;; The symbol names the struct or sum NAME, qualified: `coil.core.Option`.
  (NamesType [(name Code)])
  ;;; It names no struct or sum in scope there: a built-in type such as `i64`, a
  ;;; type parameter, or nothing.
  (NamesNoType))

;;; `(code-type-ref TYPE)`: the struct or sum the type symbol names where it was
;;; written, resolved through that module's imports.
(defprimitive code-type-ref [(type Code)] (-> TypeRef) :code-type-ref)

(defprimitive code-variant-count :code-variant-count)

(defprimitive code-variant-name :code-variant-name)

;;; The variant's FULLY-QUALIFIED name. `code-variant-name` strips the qualifier, which
;;; is right for display and wrong for CODE GENERATION: an arm or call built from a bare
;;; name only resolves where the sum happens to be imported unqualified, so a macro
;;; emitting one produces code whose validity depends on the CALLER's imports.
(defprimitive code-variant-qname :code-variant-qname)

(defprimitive code-variant-fields :code-variant-fields)

(defprimitive code-variant-field-name :code-variant-field-name)

(defprimitive code-variant-field-type :code-variant-field-type)

(defprimitive code-trait-method-count :code-trait-method-count)

(defprimitive code-trait-method-name :code-trait-method-name)

(defprimitive code-trait-arity :code-trait-arity)

(defprimitive code-trait-param-name :code-trait-param-name)

(defprimitive code-trait-param-type :code-trait-param-type)

(defprimitive code-trait-ret-type :code-trait-ret-type)

(defprimitive str-bytes :str-bytes)

(defprimitive bytes->str :bytes->str)

(defprimitive int->str :int->str)

(defprimitive gensym :gensym)

(defprimitive target-arch :target-arch)

(defprimitive target-os :target-os)

(defprimitive debug-checks? :debug-checks?)

(defprimitive lint-param :lint-param)

(defprimitive error :error)

(defprimitive report :report)

(defprimitive warn :warn)

(defprimitive suggest :suggest)

;;; `(suggest-transaction)`: the suggestions that follow, until the next call, are
;;; one transaction — `coil lint --fix` applies all of them or none. Each checker run
;;; starts one, so by default all of a checker's suggestions land together (a
;;; signature rewrite with the rewrites of its calls). A checker whose suggestions
;;; are independent of each other calls this before each one: then a fix that does
;;; not compile, or that would drop a comment, is held back alone instead of taking
;;; every other fix of that checker with it. Returns the transaction's id.
(defprimitive suggest-transaction :suggest-transaction)

;;; `(delete NODE MSG)` — a `warn` that proposes REMOVING the node. `coil lint --fix`
;;; (and only it) deletes the form, together with the comment block written above it.
(defprimitive delete :delete)

(defprimitive code-file :code-file)

(defprimitive code-line :code-line)

(defprimitive code-src :code-src)

(defprimitive code-col :code-col)

;;; `(primitive/code-call-site)` -- in a macro, the call being expanded, as Code:
;;; the form whose file, line and column `code-file`, `code-line` and `code-col`
;;; report. A macro with no arguments has no other node from its caller.
(defprimitive code-call-site :code-call-site)

(defprimitive code-doc :code-doc)

(defprimitive code-from-user? :code-from-user?)

(defprimitive code-macro? :code-macro?)

(defprimitive code-macro-call? :code-macro-call?)

;;; What kind of declaration a node resolved to, as `code-decl` answers.
(defsum DeclKind
  (FunctionDecl)
  ;;; An impl's method, inherent or a trait's.
  (MethodDecl)
  (StructDecl)
  (SumDecl)
  ;;; A variant a construction names; its module is the sum's.
  (VariantDecl)
  (TraitDecl)
  (ConstDecl)
  (ExternDecl)
  ;;; One of this module's primitives.
  (PrimitiveDecl))

;;; What `code-decl` answers.
(defsum DeclAnswer
  ;;; The node resolved to NAME, the exact qualified declaration the checker chose,
  ;;; of KIND, declared in MODULE. SIGNATURE is `([PARAM-TYPE…] RET)` for a function
  ;;; and `([PARAM-TYPE…] RET OWNER-TYPE [TRAIT])` for a method, where OWNER-TYPE is
  ;;; the type of the impl the checker chose and TRAIT, present for a trait's method,
  ;;; names the trait; a method's MODULE is the module that declares OWNER-TYPE, and
  ;;; empty for a type no module declares (`i64`). Empty for other kinds.
  (Declared [(module Code) (kind DeclKind) (name Code) (signature Code)])
  ;;; Nothing the compiler resolved, or no checked program.
  (DeclUnresolved)
  ;;; A bare name that more than one declaration has.
  (DeclAmbiguous))

;;; `(code-decl NODE)`: the declaration NODE resolved to. Pass a whole call, a
;;; function-pointer reference, a construction or a type reference: a reference the
;;; checker resolved answers exactly, even when its simple name lives in several
;;; modules; a bare symbol falls back to a lookup by name.
(defprimitive code-decl [(node Code)] (-> DeclAnswer) :code-decl)

;;; Where a node came from, as `code-macro-of` answers.
(defsum Provenance
  ;;; It was written by hand: `code-macro?` is false.
  (Handwritten)
  ;;; The expansion of MACRO, a qualified symbol, produced it.
  (ExpandedBy [(macro Code)])
  ;;; This compilation has no record of the node's expansion (outside an
  ;;; expansion, checker or transform).
  (ProvenanceUnknown))

;;; `(code-macro-of NODE)`: the macro whose expansion produced NODE.
(defprimitive code-macro-of [(node Code)] (-> Provenance) :code-macro-of)

;;; The `defalias` a reference goes through, as `code-alias-of` answers.
(defsum AliasUse
  ;;; The spelling names its declaration directly, or a local.
  (NoAlias)
  ;;; The reference resolves through ALIAS, a qualified symbol. `code-decl` answers
  ;;; with the declaration the alias leads to.
  (ThroughAlias [(alias Code)])
  ;;; The node is not a reference this compilation qualified (generated by a
  ;;; macro, or no semantic model).
  (AliasUnknown))

;;; `(code-alias-of NODE)`: the `defalias` the reference NODE is resolved through.
;;; NODE is a symbol or a call, which answers for its head.
(defprimitive code-alias-of [(node Code)] (-> AliasUse) :code-alias-of)

;;; Asking the compiler about the compiled program, as a metaprogram that describes
;;; it to a JIT session running inside it does. `coil.meta` wraps these. Names are
;;; qualified symbols.
;;; `(code-source CODE)`: CODE as source text.
(defprimitive code-source :code-source)

;;; What a query about the program answers.
(defsum ProgramAnswer
  ;;; VALUE, the Code the query asked for.
  (Answer [(value Code)])
  ;;; The program has no definition or module by that name.
  (NotInProgram)
  ;;; There is no checked program to ask (a macro expanding before checking).
  (NoProgram))

;;; `(program-modules)`: every module of the program, the library's included.
(defprimitive program-modules [] (-> ProgramAnswer) :program-modules)
;;; `(module-definitions MODULE)`: MODULE's definitions, as qualified symbols.
(defprimitive module-definitions [(module Code)] (-> ProgramAnswer) :module-definitions)

;;; What a definition is, as a description of the program needs to know it: whether
;;; another unit links against it (a function, a `def`), instantiates or expands it
;;; (a generic, a macro, a trait, a constant) or reads its layout (a struct, a sum).
(defsum DefinitionKind
  (Function)
  (Macro)
  (Generic)
  (Def)
  (Const)
  (Struct)
  (Sum)
  (Trait)
  (Alias)
  (Extern))

;;; What `definition-kind` answers.
(defsum KindAnswer
  ;;; The definition is a KIND.
  (KindIs [(kind DefinitionKind)])
  ;;; The program has no definition by that name.
  (KindNotInProgram)
  ;;; There is no checked program to ask.
  (KindNoProgram))

;;; `(definition-kind NAME)`: what the definition NAME is.
(defprimitive definition-kind [(name Code)] (-> KindAnswer) :definition-kind)
;;; `(definition-declaration NAME)`: the form that declares NAME to another unit.
(defprimitive definition-declaration [(name Code)] (-> ProgramAnswer) :definition-declaration)
;;; `(definition-annotations NAME)`: the `:key value` pairs a function or `def`
;;; carries, as one list; empty when it has none.
(defprimitive definition-annotations [(name Code)] (-> ProgramAnswer) :definition-annotations)
;;; `(definition-source NAME)`: the form that defines NAME, as written.
(defprimitive definition-source [(name Code)] (-> ProgramAnswer) :definition-source)
;;; `(module-header MODULE)`: `(module M)` and its import and export forms.
(defprimitive module-header [(module Code)] (-> ProgramAnswer) :module-header)
;;; `(module-impls MODULE)`: its `impl` and `derive` forms.
(defprimitive module-impls [(module Code)] (-> ProgramAnswer) :module-impls)
;;; `(program-toolchain)`: `(toolchain :compiler "<digest>" :target "<arch>-<os>")`.
(defprimitive program-toolchain :program-toolchain)

;;; Authored source reflection for source lint checkers (`coil.meta` wraps these).
;;; Unlike code-decl, code-source-binding never searches declarations by spelling.

;;; What the authored-source queries answer.
(defsum SourceView
  ;;; RECORDS, a list.
  (SourceIs [(records Code)])
  ;;; Outside a semantic checker run by `coil lint`, where no source model is kept.
  (SourceUnavailable))

;;; `(code-source-modules)`: the original module records, as written.
(defprimitive code-source-modules [] (-> SourceView) :code-source-modules)
;;; `(code-source-references)`: every authored reference occurrence, as records
;;; `(reference MODULE NODE ROLE)`, followed by the import's target and the name it
;;; exports when the occurrence resolved through an import.
(defprimitive code-source-references [] (-> SourceView) :code-source-references)
;;; `(code-source-imports)`: every authored import, as `(source-import MODULE NODE
;;; TARGET)`.
(defprimitive code-source-imports [] (-> SourceView) :code-source-imports)

;;; How an authored occurrence binds, as `code-source-binding` answers.
(defsum SourceBinding
  ;;; It names NAME, a qualified declaration.
  (BindsGlobal [(name Code)])
  ;;; It names the local whose checked identity is ID, an integer.
  (BindsLocal [(id Code)])
  ;;; It names a local, but no checked identity is recorded for it.
  (LocalUnknown)
  ;;; It names a local, but more than one checked identity is recorded for it.
  (LocalAmbiguous)
  ;;; No evidence: not an authored reference, or outside the lint phase.
  (BindingUnknown)
  ;;; The evidence names more than one declaration.
  (BindingAmbiguous))

;;; `(code-source-binding NODE)`: how the authored occurrence NODE binds. A newly
;;; constructed symbol never acquires a binding from its spelling.
(defprimitive code-source-binding [(node Code)] (-> SourceBinding) :code-source-binding)

;;; What `code-qualify-import` answers.
(defsum ImportPlan
  ;;; EDITS, a list of `(edit NODE REPLACEMENT)` that `code-suggest-edits` takes.
  (PlanEdits [(edits Code)])
  ;;; REASON, a string, why the import cannot be qualified.
  (PlanRefused [(reason Code)]))

;;; `(code-qualify-import IMPORT ALIAS MODE)`: the edits that qualify the
;;; references through IMPORT, a `code-source-imports` record, with ALIAS. MODE is
;;; the symbol `strict` or `assume-no-shadow`.
(defprimitive code-qualify-import [(import Code) (alias Code) (mode Code)] (-> ImportPlan) :code-qualify-import)

;;; What `code-suggest-edits` answers.
(defsum Suggestion
  ;;; The edits are suggested together, as one group.
  (Suggested)
  ;;; An edit has no editable authored source, so none is suggested.
  (SuggestionRefused))

;;; `(code-suggest-edits EDITS MESSAGE)`: suggest a plan's EDITS as one group.
(defprimitive code-suggest-edits [(edits Code) (message (slice u8))] (-> Suggestion) :code-suggest-edits)

;;; Direct semantic dependencies / dependents of a declaration in the current
;;; checked model: `(Answer NAMES)`, NAMES a sorted Code list of fully qualified
;;; names. Accepts a declaration reference or fully qualified symbol. Answers
;;; `(NotInProgram)` for a declaration the model does not have, `(NoProgram)`
;;; without a semantic model.
(defprimitive code-dependencies [(name Code)] (-> ProgramAnswer) :code-dependencies)
(defprimitive code-dependents [(name Code)] (-> ProgramAnswer) :code-dependents)

;;; Transitive forms of the dependency queries. Cycles terminate; the queried
;;; declaration itself is excluded. These queries never compile or publish code.
(defprimitive code-dependency-closure [(name Code)] (-> ProgramAnswer) :code-dependency-closure)
(defprimitive code-dependent-closure [(name Code)] (-> ProgramAnswer) :code-dependent-closure)

;;; What `type-of` answers.
(defsum TypeAnswer
  ;;; The checker inferred TYPE, as Code: `i64`, `(ptr i64)`, a qualified
  ;;; `myapp.Point`.
  (TypeIs [(type Code)])
  ;;; The checker recorded no type for the node: it did not check (in a partial
  ;;; model), it is not an expression, or there is no checked program.
  (TypeUnknown))

;;; `(type-of NODE)`: the type the real type-checker inferred for the expression
;;; NODE, not its syntax: a call `(getf)` is `f64` because `getf` returns `f64`.
(defprimitive type-of [(node Code)] (-> TypeAnswer) :type-of)

;;; Whether the checker reported an error at a node, as `check-error` answers.
(defsum CheckOutcome
  ;;; No error is located exactly at the node.
  (ChecksClean)
  ;;; The checker's MESSAGE, a string, for the error located there.
  (FailsAt [(message Code)]))

;;; `(check-error NODE)`: in a semantic transform, whether the checker reported an
;;; error located exactly at NODE. With a partial model a transform can find the
;;; nodes that do not check yet, and why, and rewrite exactly those.
(defprimitive check-error [(node Code)] (-> CheckOutcome) :check-error)

;;; How much of the program being transformed checks, as `model-status` answers.
(defsum ModelStatus
  ;;; The whole program checks.
  (ModelComplete)
  ;;; Some of it does not; queries still answer for everything that checked.
  (ModelPartial)
  ;;; No model could be built.
  (NoModel))

;;; `(model-status)`: how much of the program being transformed checks.
(defprimitive model-status [] (-> ModelStatus) :model-status)

