(defprimitive vector-reduce-or :vector-reduce-or)
(defprimitive vector-reduce-and :vector-reduce-and)
(defprimitive vector-reduce-xor :vector-reduce-xor)
(defprimitive vector-reduce-min :vector-reduce-min)
(defprimitive vector-reduce-max :vector-reduce-max)
(defprimitive vector-popcount :vector-popcount)
