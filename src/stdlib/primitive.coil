(defprimitive binding-of :binding-of)

;;; What a name written as a call head would denote, as `resolve-at` answers.
(defsum Resolution
  ;;; A local of that name is in scope there.
  (ResolvesLocal)
  ;;; A call would reach NAME, the qualified declaration (`coil.core.len` for the
  ;;; `Len` method).
  (ResolvesTo [(name Code)])
  ;;; Nothing has that name there.
  (ResolvesNothing)
  ;;; The node was not qualified by this compilation (macro-generated, or no
  ;;; semantic model).
  (ResolutionUnknown))

;;; `(resolve-at NODE NAME)`: what the symbol NAME would denote if it were written as
;;; a call head at NODE. A checker asks it before inserting a name, because a local
;;; can shadow the definition a rewrite means to call.
(defprimitive resolve-at [(node Code) (name Code)] (-> Resolution) :resolve-at)

;;; Internal checked projections used by the core binding macros.
(defprimitive pattern-view :pattern-view)

(defprimitive pattern-prefix :pattern-prefix)

(defprimitive pattern-nth :pattern-nth)

(defprimitive pattern-rest :pattern-rest)

;;; The field-name text of a keyword Code value, without its leading colon.
(defprimitive code-keyword-name :code-keyword-name)

(defprimitive pattern-project :pattern-project)

;;; Unreachable by the exhaustiveness check of a lowered match: aborts.
(defprimitive pattern-fail :pattern-fail)

;;; The body of a lowered match's catch-all for the variants its arms do not
;;; name. When they name every variant, the checker drops the arm unchecked.
(defprimitive pattern-default :pattern-default)
