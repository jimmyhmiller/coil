(defprimitive report :report)

(defprimitive warn :warn)

(defprimitive suggest :suggest)

;;; `(delete NODE MSG)` — a `warn` that proposes REMOVING the node. `coil lint --fix`
;;; (and only it) deletes the form, together with the comment block written above it.
(defprimitive delete :delete)

