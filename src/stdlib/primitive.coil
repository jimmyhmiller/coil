(module coil.primitive)
; Raw compiler operations. This module is intentionally not auto-referred: a source
; name denotes a primitive only after normal module resolution reaches one of these
; declarations. The final keyword is compiler lowering metadata, not a callable name.
(defprimitive alloc-stack [T] (-> (ptr T)) :alloc-stack)
(defprimitive alloc-static [T] (-> (ptr T)) :alloc-static)
(defprimitive alloc-heap [T] (-> (ptr T)) :alloc-heap)

; Integer and floating-point machine operations.
(defprimitive iadd :iadd)
(defprimitive isub :isub)
(defprimitive imul :imul)
(defprimitive idiv :idiv)
(defprimitive irem :irem)
(defprimitive udiv :udiv)
(defprimitive urem :urem)
(defprimitive iand :iand)
(defprimitive ior :ior)
(defprimitive ixor :ixor)
(defprimitive ishl :ishl)
(defprimitive ishr :ishr)
(defprimitive inot :inot)
(defprimitive fadd :fadd)
(defprimitive fsub :fsub)
(defprimitive fmul :fmul)
(defprimitive fdiv :fdiv)
(defprimitive frem :frem)
(defprimitive icmp-lt :icmp-lt)
(defprimitive icmp-le :icmp-le)
(defprimitive icmp-gt :icmp-gt)
(defprimitive icmp-ge :icmp-ge)
(defprimitive icmp-eq :icmp-eq)
(defprimitive icmp-ne :icmp-ne)
(defprimitive fcmp-lt :fcmp-lt)
(defprimitive fcmp-le :fcmp-le)
(defprimitive fcmp-gt :fcmp-gt)
(defprimitive fcmp-ge :fcmp-ge)
(defprimitive fcmp-eq :fcmp-eq)
(defprimitive fcmp-ne :fcmp-ne)

; Memory, representation, and indirect calls.
(defprimitive zeroed :zeroed)
(defprimitive field :field)
(defprimitive bit-get :bit-get)
(defprimitive bit-set! :bit-set!)
(defprimitive fnptr-of :fnptr-of)
(defprimitive call-ptr :call-ptr)
(defprimitive load :load)
(defprimitive store! :store!)
(defprimitive volatile-load :volatile-load)
(defprimitive volatile-store! :volatile-store!)
(defprimitive alias-load :alias-load)
(defprimitive alias-store! :alias-store!)
(defprimitive fence! :fence!)
(defprimitive free :free)
(defprimitive make-dyn :make-dyn)
(defprimitive index :index)
(defprimitive cast :cast)
(defprimitive sizeof :sizeof)
(defprimitive alignof :alignof)
(defprimitive offsetof :offsetof)
(defprimitive llvm-ir :llvm-ir)
(defprimitive linker-address :linker-address)
(defprimitive write-register! :write-register!)
(defprimitive csr-read :csr-read)
(defprimitive csr-write! :csr-write!)
(defprimitive wfi! :wfi!)
(defprimitive mret! :mret!)

; Compile-time type and declaration reflection.
(defprimitive field-count :field-count)
(defprimitive variant-count :variant-count)
(defprimitive struct? :struct?)
(defprimitive sum? :sum?)
(defprimitive int? :int?)
(defprimitive float? :float?)
(defprimitive ptr? :ptr?)
(defprimitive array? :array?)
(defprimitive field-name :field-name)
(defprimitive field-type-kind :field-type-kind)
(defprimitive field-type-name :field-type-name)
(defprimitive field-index :field-index)

; Compile-time Code operations and compiler environment queries.
(defprimitive code-list? :code-list?)
(defprimitive code-sym? :code-sym?)
(defprimitive code-int? :code-int?)
(defprimitive code-count :code-count)
(defprimitive code-nth :code-nth)
(defprimitive code-sym :code-sym)
(defprimitive code-int :code-int)
(defprimitive code-rest :code-rest)
(defprimitive code-eq :code-eq)
(defprimitive code-keyword? :code-keyword?)
(defprimitive code-vector? :code-vector?)
(defprimitive code-float? :code-float?)
(defprimitive code-float-bits :code-float-bits)
(defprimitive code-exported? :code-exported?)
;; Parse SOURCE, either a runtime `(slice u8)` or string Code, with
;; character-valued reader configuration Code, e.g.
;; `(reader-config :unquote #\, :splice #\@)`.
;; Intended for `:phase read` metaprograms that delegate to the built-in reader.
(defprimitive code-read :code-read)
;; Make a fresh growable Code list for metaprograms that emit many forms. Unlike
;; repeated quasiquote suffix splicing, pushes are amortized constant time.
(defprimitive code-list-new :code-list-new)
;; Append one Code node to a list created by `code-list-new`; returns that list.
(defprimitive code-list-push! :code-list-push!)
;; Freeze a CodeBuilder into Code. Identity at runtime; the CodeBuilder/Code
;; type split is the point: a finished list cannot be pushed onto, a list still
;; being built cannot be read (docs/design/META_MEMORY.md phase 4).
(defprimitive code-list-done :code-list-done)
;; `(code-list-like PROTOTYPE ITEMS)` replaces a list/vector's children while
;; preserving PROTOTYPE's source and hygiene identity. Semantic transforms use
;; this for declaration containers (`impl`, method, function) whose binder
;; context must survive a body rewrite.
(defprimitive code-list-like :code-list-like)
;; `(code-slice CODE LO HI)` — an O(1) VIEW of elements [LO, HI). Like
;; `code-rest`, it copies nothing: both alias the parent list, which is why
;; cdr-style recursion over Code is linear (docs/design/META_MEMORY.md ph 5).
(defprimitive code-slice :code-slice)
;; The ONE deep copy, named as one: fresh structure and string payloads.
(defprimitive code-copy :code-copy)
;; `(code-concat A B)` — a fresh list holding A's elements then B's. O(n+m),
;; and it says so in its name.
(defprimitive code-concat :code-concat)
;; `(code-opaque CODE)` — a compilation-scoped i64 handle naming the exact node,
;; so a native phase program (a compiled Scheme transformer's syntax object) can
;; retain syntax inside its own tagged data. Valid for the invocation that made
;; it: the node lives in the expansion arena, and keeping a handle across
;; invocations is the same use-after-reset as keeping any borrowed Code.
(defprimitive code-opaque :code-opaque)
;; `(code-from-opaque HANDLE)` — the exact Code node a handle names; a located
;; error on anything that is not a live handle.
(defprimitive code-from-opaque :code-from-opaque)
;; String-literal predicate, completing the atom set (sym?/int?/float?/keyword?).
(defprimitive code-string? :code-string?)
(defprimitive code-symbol :code-symbol)
(defprimitive code-str :code-str)
;; Scope-bearing identifier operations. Context introduction is deliberately
;; named and searchable; `code-symbol` remains an unscoped/data-name builder.
(defprimitive fresh-identifier :fresh-identifier)
(defprimitive datum->syntax :datum->syntax)
(defprimitive syntax->datum :syntax->datum)
(defprimitive free-identifier=? :free-identifier=?)
(defprimitive bound-identifier=? :bound-identifier=?)
(defprimitive code-field-count :code-field-count)
(defprimitive code-field-name :code-field-name)
(defprimitive code-field-kind :code-field-kind)
(defprimitive code-field-type :code-field-type)
;; The field's type name with its QUALIFICATION intact. Use this, not
;; `code-field-type`, when building a symbol that generated code will call.
(defprimitive code-field-qtype :code-field-qtype)
;; Safely classify a reflected type without probing a shape-specific API.
;; Returns `struct`, `sum`, or `unknown` as Code.
(defprimitive code-type-shape :code-type-shape)
;; Compiler-SDK session state for source metaprograms. The accepted value is
;; immutable `Code`; a candidate may stage a replacement, which the owning JIT
;; session commits only after native publication succeeds.
(defprimitive code-session-state :code-session-state)
(defprimitive code-session-stage! :code-session-stage!)
;; Accepted concrete generic/trait artifacts from the retained compiler session.
;; The result is structural Code; generated names are artifact values, not IDs.
(defprimitive code-session-monomorphs :code-session-monomorphs)
;; Stage a structured positive rejection kind for the current compiler-SDK
;; candidate. It remains inspectable after the candidate is rejected and is
;; cleared when the next transaction begins or a candidate commits.
(defprimitive code-session-condition! :code-session-condition!)
;; The source-model Code staged by the last rejected compiler-SDK transaction.
(defprimitive code-session-rejected-state :code-session-rejected-state)
;; `(code-deriver TRAIT TYPE)` — the deriver REGISTERED for TRAIT, already picked
;; for TYPE's shape. The answer comes from the `(register-derive …)` table and from
;; nothing else: naming a function a particular way never makes it a deriver.
;; Errors, naming the trait, when it has no registration or no arm for that shape.
(defprimitive code-deriver :code-deriver)
(defprimitive code-variant-sum :code-variant-sum)
(defprimitive code-variant-count :code-variant-count)
(defprimitive code-variant-name :code-variant-name)
;; The variant's FULLY-QUALIFIED name. `code-variant-name` strips the qualifier, which
;; is right for display and wrong for CODE GENERATION: an arm or call built from a bare
;; name only resolves where the sum happens to be imported unqualified, so a macro
;; emitting one produces code whose validity depends on the CALLER's imports.
(defprimitive code-variant-qname :code-variant-qname)
(defprimitive code-variant-fields :code-variant-fields)
(defprimitive code-variant-field-name :code-variant-field-name)
(defprimitive code-variant-field-type :code-variant-field-type)
(defprimitive code-trait-method-count :code-trait-method-count)
(defprimitive code-trait-method-name :code-trait-method-name)
(defprimitive code-trait-arity :code-trait-arity)
(defprimitive code-trait-param-name :code-trait-param-name)
(defprimitive code-trait-param-type :code-trait-param-type)
(defprimitive code-trait-ret-type :code-trait-ret-type)
(defprimitive str-bytes :str-bytes)
(defprimitive bytes->str :bytes->str)
(defprimitive int->str :int->str)
(defprimitive gensym :gensym)
(defprimitive target-arch :target-arch)
(defprimitive target-os :target-os)
(defprimitive debug-checks? :debug-checks?)
(defprimitive lint-param :lint-param)
(defprimitive error :error)
(defprimitive report :report)
(defprimitive warn :warn)
(defprimitive suggest :suggest)
;; `(delete NODE MSG)` — a `warn` that proposes REMOVING the node. `coil lint --fix`
;; (and only it) deletes the form, together with the comment block written above it.
(defprimitive delete :delete)
(defprimitive code-file :code-file)
(defprimitive code-line :code-line)
(defprimitive code-src :code-src)
(defprimitive code-col :code-col)
(defprimitive code-doc :code-doc)
(defprimitive code-from-user? :code-from-user?)
(defprimitive code-macro? :code-macro?)
(defprimitive code-macro-call? :code-macro-call?)
(defprimitive code-decl :code-decl)
(defprimitive type-of :type-of)
(defprimitive binding-of :binding-of)
