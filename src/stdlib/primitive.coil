(module coil.primitive)

; Raw compiler operations. This module is intentionally not auto-referred: a source
; name denotes a primitive only after normal module resolution reaches one of these
; declarations. The final keyword is compiler lowering metadata, not a callable name.
(defprimitive alloc-stack [T] (-> (ptr T)) :alloc-stack)

;; Dynamic bytes in the executing function's frame, aligned to 16 bytes.
;; Every evaluation allocates again; a loop accumulates storage until return.
(defprimitive alloc-stack-bytes :alloc-stack-bytes)

(defprimitive alloc-static [T] (-> (ptr T)) :alloc-static)

(defprimitive alloc-heap [T] (-> (ptr T)) :alloc-heap)

