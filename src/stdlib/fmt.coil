(module coil.fmt)
(import "coil.primitive" :as primitive)
; Formatting helpers over the IO Writer capability (src/stdlib/io.coil) — all explicit:
; every printer TAKES a `(ptr Writer)`, there is no ambient stdout. Builds on io's
; print-str / print-int (non-negative) / write-byte, adding the everyday pieces:
; signed decimal, hex, bool, char, and newline/line convenience. The positional
; FORMAT-STRING front end (`(fmt w "x={d} y={s}" a b)`) is implemented below as a
; macro over these printers plus the str-bytes compile-time builtin.
;
;   (import "coil.fmt" :use *) (import "coil.io" :use *) (import "coil.result" :use *)

(import "coil.io" :use *)
(import "coil.result" :use *)

;;; Signed decimal (io's print-int is non-negative only), correct over the WHOLE
;;; range including i64 MIN.
;;;
;;; The magnitude of i64 MIN is not an i64, so `(isub 0 n)` wraps straight back to
;;; MIN — still negative. The previous version handed that to `print-int`, whose
;;; `n < 10` base case then wrote one byte, `(cast u8 (iadd MIN 48))` = '0', so
;;; `-9223372036854775808` printed as **`-0`**. Not a display quirk: both serde
;;; text backends encode integers through here, so a struct containing i64 MIN
;;; serialized to `-0` and decoded back as 0 — silent data loss with no error
;;; anywhere. (Found by `tests/prop/stdlib_props_test.coil`, which shrank it to
;;; exactly `n = i64::MIN`.)
;;;
;;; The fix is to never negate: emit '-' and print the magnitude through the
;;; UNSIGNED path. `(isub 0 n)` still wraps, but `print-u` reads those bits as
;;; unsigned, and the unsigned reading of the wrapped value IS the magnitude.
(defn print-i [(w (ptr Writer)) (n :i64)] (-> (Result :i64 IoError))
  (if (< n (cast i64 0))
      (match (write-byte w (primitive/cast :u8 45))  ; '-'
        (Err [e] (Err e))
        (Ok [_] (print-u w (primitive/isub 0 n))))
      (print-int w n)))

;;; Lowercase hexadecimal (non-negative), no "0x" prefix.
(defn print-hex [(w (ptr Writer)) (n :i64)] (-> (Result :i64 IoError))
  (if (< n (cast i64 16))
      (write-byte w (primitive/cast :u8 (if (< n (cast i64 10)) (primitive/iadd n 48) (primitive/iadd n 87))))  ; 87 = 'a'-10
      (match (print-hex w (primitive/idiv n 16))
        (Err [e] (Err e))
        (Ok [_]
            (let [d (primitive/irem n 16)]
              (write-byte w (primitive/cast :u8 (if (< d (cast i64 10)) (primitive/iadd d 48) (primitive/iadd d 87)))))))))

;;; UNSIGNED lowercase hex over the FULL range (udiv/urem interpret the bits as
;;; unsigned, so a "negative" i64 / a u64 with the high bit set prints correctly —
;;; unlike print-hex, which assumes non-negative). Recurses MSB-first.
(defn uhex-digits [(w (ptr Writer)) (n :i64)] (-> (Result :i64 IoError))
  (if (= n (cast i64 0))
      (Ok 0)
      (match (uhex-digits w (primitive/udiv n 16))
        (Err [e] (Err e))
        (Ok [_]
            (let [d (primitive/urem n 16)]
              (write-byte w (primitive/cast :u8 (if (< d (cast i64 10)) (primitive/iadd d 48) (primitive/iadd d 87)))))))))
(defn print-uhex [(w (ptr Writer)) (n :i64)] (-> (Result :i64 IoError))
  (if (= n (cast i64 0))
      (write-byte w (primitive/cast :u8 48))  ; "0"
      (uhex-digits w n)))

;;; UNSIGNED decimal over the FULL range (udiv/urem interpret the bits as unsigned),
;;; so a u64 with the high bit set prints its true magnitude — print-i would show
;;; the wrapped negative value. Recurses MSB-first, like uhex-digits.
(defn udec-digits [(w (ptr Writer)) (n :i64)] (-> (Result :i64 IoError))
  (if (= n (cast i64 0))
      (Ok 0)
      (match (udec-digits w (primitive/udiv n 10))
        (Err [e] (Err e))
        (Ok [_] (write-byte w (primitive/cast :u8 (primitive/iadd (primitive/urem n 10) 48)))))))
(defn print-u [(w (ptr Writer)) (n :i64)] (-> (Result :i64 IoError))
  (if (= n (cast i64 0))
      (write-byte w (primitive/cast :u8 48))  ; "0"
      (udec-digits w n)))

; ---- floats ------------------------------------------------------------------
; `print-f` writes an f64 in plain decimal: integer part, '.', then the fraction
; rounded to six digits (half-up) with trailing zeros trimmed but at least one
; digit kept — 1.5 -> "1.5", 42.0 -> "42.0", pi -> "3.141593". NaN -> "NaN", the
; infinities -> "inf" / "-inf". A magnitude whose integer part doesn't fit i64
; falls back to approximate scientific notation ("1.797693e+308"). This is a
; DISPLAY convenience (fixed six-digit precision), NOT a shortest-roundtrip
; serializer. Byte writes along the way are best-effort (an error on one digit
; doesn't abort the rest); the final write's result is returned.

;;; write `n` '0' bytes (returns the last write's result)
(defn f--zeros [(w (ptr Writer)) (n :i64)] (-> (Result :i64 IoError))
  (if (<= n (cast i64 0))
      (Ok 0)
      (do (write-byte w (primitive/cast :u8 48)) (f--zeros w (primitive/isub n 1)))))

(defn f--ndigits [(n :i64)] (-> :i64)
  (if (< n (cast i64 10)) 1 (primitive/iadd 1 (f--ndigits (primitive/idiv n 10)))))

;;; the fraction part: '.', then fr6 (0..999999 — the fraction scaled by 1e6 and
;;; rounded) with its leading zeros restored and trailing zeros trimmed (min one).
(defn f--frac [(w (ptr Writer)) (fr6 :i64)] (-> (Result :i64 IoError))
  (let [(mut v) fr6
        (mut width) 6]
    (while (and (> (load width) (cast i64 1)) (= (primitive/irem (load v) 10) (cast i64 0)))
      (store! v (primitive/idiv (load v) 10))
      (store! width (primitive/isub (load width) 1)))
    (write-byte w (primitive/cast :u8 46))  ; '.'
    (f--zeros w (primitive/isub (load width) (f--ndigits (load v))))
    (print-int w (load v))))

;;; x is finite and 0 <= x < 2^63: "<int>.<frac>" (watch the round-up carry:
;;; 0.9999999 scales to 1000000, which is really "1.0")
(defn f--fixed [(w (ptr Writer)) (x :f64)] (-> (Result :i64 IoError))
  (let [ip0 (primitive/cast :i64 x)
        fr6-r
          (primitive/cast :i64
                          (primitive/fadd (primitive/fmul (primitive/fsub x (primitive/cast :f64 ip0)) 1000000.0) 0.5))
        carry (= fr6-r (cast i64 1000000))
        ip (if carry (primitive/iadd ip0 1) ip0)
        fr6 (if carry 0 fr6-r)]
    (print-int w ip)
    (f--frac w fr6)))

;;; x >= 2^63 (huge finite): approximate scientific notation "m.mmmmmm" 'e' '+' NN
(defn f--sci [(w (ptr Writer)) (x :f64)] (-> (Result :i64 IoError))
  (let [(mut m) x
        (mut e) 0]
    (while (primitive/fcmp-ge (load m) 10.0)
      (store! m (primitive/fdiv (load m) 10.0))
      (store! e (primitive/iadd (load e) 1)))
    (f--fixed w (load m))
    (write-byte w (primitive/cast :u8 101))  ; 'e'
    (write-byte w (primitive/cast :u8 43))  ; '+'
    (print-int w (load e))))

;;; x >= 0 (sign and NaN handled by print-f); inf iff x > 0 and 1/x == 0 — the
;;; test needs no max-double literal
(defn f--abs [(w (ptr Writer)) (x :f64)] (-> (Result :i64 IoError))
  (if (if (primitive/fcmp-gt x 0.0) (primitive/fcmp-eq (primitive/fdiv 1.0 x) 0.0) false)
      (print-str w "inf")
      (if (primitive/fcmp-lt x 9223372036854775808.0)  ; 2^63, exact as f64
          (f--fixed w x)
          (f--sci w x))))

(defn print-f [(w (ptr Writer)) (x :f64)] (-> (Result :i64 IoError))
  (if (not (primitive/fcmp-eq x x))  ; only NaN differs from itself
      (print-str w "NaN")
      (if (primitive/fcmp-lt x 0.0)
          (do
            (write-byte w (primitive/cast :u8 45))  ; '-'
            (f--abs w (primitive/fsub 0.0 x)))
          (f--abs w x))))

(defn print-bool [(w (ptr Writer)) (b bool)] (-> (Result :i64 IoError))
  (print-str w (if b "true" "false")))

(defn print-char [(w (ptr Writer)) (c :i64)] (-> (Result :i64 IoError))
  (write-byte w (primitive/cast :u8 c)))

(defn print-nl [(w (ptr Writer))] (-> (Result :i64 IoError))
  (write-byte w (primitive/cast :u8 10)))  ; '\n'

;;; Print a `(slice u8)` string followed by a newline.
(defn print-line [(w (ptr Writer)) (s (slice u8))] (-> (Result :i64 IoError))
  (match (print-str w s)
    (Err [e] (Err e))
    (Ok [_] (print-nl w))))

; ---- positional format strings (a MACRO over the printers + the str-bytes /
;      bytes->str compile-time builtins; the compiler knows nothing of formats) ----
; `(fmt w "n={d} s={s}" a b)` — specs: {d} signed int, {s} string, {x} hex (>=0),
; {c} char, {b} bool, {u} unsigned decimal (full range), {f} float (print-f);
; `{{`/`}}` are literal braces. Expands to a sequence of print-* calls. Too few
; args for the specs is a compile error (no silent wrong).

;; The printer for a spec, as a canonical hygienic name or an alias-qualified
;; imported name. Canonical dotted names here are Code values
;; emitted by the macro, not source-level module qualification.
;; The name is spliced into call-head position via `~unquote`, which bypasses the
;; macro's call-head hygiene — so qualify it here, otherwise it resolves at the use
;; site and breaks wherever the caller didn't import io/fmt (e.g. the ambient
;; `print`/`println`, which import nothing).
; ⚠ The fmt MACRO's helpers (fmt--printer/fmt--flush/fmt--go) must use METAL
; comparison ops, not the clean `=`/`<`: the tower stages a macro through the
; PRUNED closure, which deliberately carries no trait impls (see
; comptime.coil::closure-subprogram-pruned) — a clean operator there makes the
; whole macro unstageable inside other macro bodies.
(defn fmt--printer [(spec i64)] (-> Code)
  (if (primitive/icmp-eq spec 100)
      `coil.fmt.print-i
      (if (primitive/icmp-eq spec 115)
          `coil.io.print-str
          (if (primitive/icmp-eq spec 120)
              `coil.fmt.print-uhex  ; {x}: full-range hex. print-hex assumed
              ; non-negative and emitted a garbage byte for
              ; a negative i64 (a hash/mask/errno that went
              ; negative — exactly what {x} is reached for).
              (if (primitive/icmp-eq spec 99)
                  `coil.fmt.print-char
                  (if (primitive/icmp-eq spec 98)
                      `coil.fmt.print-bool
                      (if (primitive/icmp-eq spec 117)
                          `coil.fmt.print-u
                          (if (primitive/icmp-eq spec 102)
                              `coil.fmt.print-f
                              (primitive/error "fmt: unknown spec; use {d} {s} {x} {c} {b} {u} {f}")))))))))

;;; flush the accumulated literal bytes as a single print-str (or nothing if empty)
(defn fmt--flush [(w Code) (lit Code)] (-> Code)
  (if (primitive/icmp-eq (primitive/code-count lit) 0)
      `()
      `((coil.io.print-str ~w ~(primitive/bytes->str lit)))))

;;; Append every element of list `xs` onto the growable list `out` (METAL ops —
;;; see the ⚠ note above).
(defn fmt--push-each [(out CodeBuilder) (xs Code)] (-> CodeBuilder)
  (let [(mut k) 0]
    (loop (if (primitive/icmp-lt (load k) (primitive/code-count xs))
              (do (primitive/code-list-push! out (primitive/code-nth xs (load k)))
                  (store! k (primitive/iadd (load k) 1)))
              (break)))
    out))

;;; single pass over the format bytes (primitive/index i), accumulating literal bytes in `lit`
;;; and consuming `args` (primitive/index ai). Appends print-* call forms onto the
;;; growable list `out` and returns it. `lit` and `out` are growable code lists
;;; (code-list-new/push!) — re-splicing the accumulator per byte and splicing the
;;; recursion's result per segment are both quadratic in the format-string length
;;; (docs/design/META_MEMORY.md).
(defn fmt--go [(w Code) (bs Code) (i i64) (lit CodeBuilder) (args Code) (ai i64) (out CodeBuilder)] (-> CodeBuilder)
  (if (primitive/icmp-eq i (primitive/code-count bs))
      (fmt--push-each out (fmt--flush w (primitive/code-list-done lit)))
      (let [b (primitive/code-int (primitive/code-nth bs i))]
        (if (primitive/icmp-eq b 123)  ; '{'
            (if (if (primitive/icmp-lt (primitive/iadd i 1) (primitive/code-count bs))
                    (primitive/icmp-eq (primitive/code-int (primitive/code-nth bs (primitive/iadd i 1))) 123)
                    false)
                (do (primitive/code-list-push! lit `123)  ; '{{' -> literal '{'
                    (fmt--go w bs (primitive/iadd i 2) lit args ai out))
                (if (if (primitive/icmp-lt (primitive/iadd i 2) (primitive/code-count bs))
                        (primitive/icmp-eq (primitive/code-int (primitive/code-nth bs (primitive/iadd i 2))) 125)
                        false)
                    (if (primitive/icmp-eq ai (primitive/code-count args))
                        (primitive/error "fmt: not enough arguments for the format string")
                        (do (fmt--push-each out (fmt--flush w (primitive/code-list-done lit)))
                            (primitive/code-list-push! out
                                                       `(~(fmt--printer (primitive/code-int (primitive/code-nth bs
                                                                                                                (primitive/iadd i
                                                                                                                                1)))) ~w
                                                           ~(primitive/code-nth args ai)))
                            (fmt--go w bs (primitive/iadd i 3) (primitive/code-list-new) args (primitive/iadd ai 1) out)))
                    (primitive/error "fmt: malformed spec, expected {X}")))
            (if (primitive/icmp-eq b 125)  ; '}'
                (if (if (primitive/icmp-lt (primitive/iadd i 1) (primitive/code-count bs))
                        (primitive/icmp-eq (primitive/code-int (primitive/code-nth bs (primitive/iadd i 1))) 125)
                        false)
                    (do (primitive/code-list-push! lit `125)  ; '}}' -> literal '}'
                        (fmt--go w bs (primitive/iadd i 2) lit args ai out))
                    (primitive/error "fmt: unmatched '}' (use '}}')"))
                (do (primitive/code-list-push! lit (primitive/code-nth bs i))
                    (fmt--go w bs (primitive/iadd i 1) lit args ai out)))))))

(defn fmt [(w Code) (fmt-str Code) & (args Code)] (-> Code)
  `(do ~@(fmt--go w (primitive/str-bytes fmt-str) 0 (primitive/code-list-new) args 0 (primitive/code-list-new))))
