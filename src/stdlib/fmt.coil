(module coil.fmt)
(import "coil.primitive" :as primitive)

; Formatting helpers over the IO Writer capability (src/stdlib/io.coil) — all explicit:
; every printer TAKES a `(ptr Writer)`, there is no ambient stdout. Builds on io's
; print-str / print-int (non-negative) / write-byte, adding the everyday pieces:
; signed decimal, hex, bool, char, and newline/line convenience. The trait-driven
; FORMAT-STRING front end (`(fmt w "x={} value={:?}" a b)`) is implemented below
; as a macro over these printers plus the str-bytes compile-time builtin.
;
;   (import "coil.fmt" :use *) (import "coil.io" :use *) (import "coil.result" :use *)
(import "coil.io" :use *)
(import "coil.result" :use *)
(import "coil.slice" :use [slice-get slice-len slice-new subslice])
(import "coil.derive" :use *)

; In the full profile these are ambient: a program implements Display or Debug and
; formats through a Formatter with no import.
(provide-core [Display
               display-fmt
               Debug
               debug-fmt
               LowerHex
               lower-hex-fmt
               Formatter
               FormatSpec
               fmt
               formatter-write
               formatter-writer
               formatter-pretty?
               formatter-disarm!
               formatter-take-spec!])

;;; Formatting state shared by `Display` and `Debug`.  The format-string macro
;;; owns one stack value and changes only the flags selected by each placeholder.
;;; Keeping the Writer behind this object leaves room for Rust-compatible width,
;;; precision, fill, and alignment without changing either trait again.
;;; A placeholder's spec, as in `{:*>8.2}`: -1 means no width or precision.
(defstruct FormatSpec
  [(width i64)
   (precision i64)
   (fill u8)
   (align Align)
   (plus bool)
   (zero bool)])

;;; `spec` applies to the whole value a placeholder prints. While `armed`, the first
;;; number or string rendered takes it (and disarms it); a composite Debug impl
;;; disarms it before rendering its parts; whatever is still narrower than the
;;; width is padded afterwards.
(defstruct Formatter
  [(writer (ptr Writer))
   (alternate bool)
   (depth i64)
   (spec FormatSpec)
   (armed bool)])

;;; Where padding goes when a value is narrower than its width. `AlignDefault` is right
;;; for numbers and left for everything else, as in Rust.
(defsum Align (AlignDefault) (AlignLeft) (AlignRight) (AlignCenter))

(defn formatter-init [(f (ptr Formatter)) (w (ptr Writer))] (-> (ptr Formatter))
  (store! (field f writer) w)
  (store! (field f alternate) false)
  (store! (field f depth) 0)
  (formatter-clear-spec! f)
  f)

;;; No width, no precision, space fill, default alignment, no flags.
(defn plain-format-spec [] (-> FormatSpec)
  (FormatSpec :width -1 :precision -1 :fill (cast u8 32) :align (AlignDefault) :plus false :zero false))

;;; Arm the spec of the next placeholder.
(defn formatter-set-spec! [(f (ptr Formatter)) (spec FormatSpec)] (-> i64)
  (set! (.spec f) spec)
  (set! (.armed f) true)
  0)

(defn formatter-clear-spec! [(f (ptr Formatter))] (-> i64)
  (set! (.spec f) (plain-format-spec))
  (set! (.armed f) false)
  0)

;;; Take the armed spec for the value being rendered now, leaving parts of that
;;; value unformatted. A plain spec when none is armed.
(defn formatter-take-spec! [(f (ptr Formatter))] (-> FormatSpec)
  (if (.armed f)
      (do (set! (.armed f) false) (.spec f))
      (plain-format-spec)))

;;; A composite value's Debug or Display calls this before rendering its parts, so
;;; the spec pads the whole value rather than its first part.
(defn formatter-disarm! [(f (ptr Formatter))] (-> i64)
  (set! (.armed f) false)
  0)

(defn formatter-write [(f (ptr Formatter)) (s (slice u8))] (-> (Result i64
                                                                       IoError))
  (print-str (load (field f writer)) s))

(defn formatter-pretty? [(f (ptr Formatter))] (-> bool)
  (load (field f alternate)))

(defn formatter-writer [(f (ptr Formatter))] (-> (ptr Writer))
  (load (field f writer)))

(defn formatter-set-alternate! [(f (ptr Formatter)) (alternate bool)] (-> i64)
  (store! (field f alternate) alternate)
  0)

;;; User-facing text. `{}` dispatches here by the argument's static type.
(deftrait Display [Self]
  (display-fmt [(x Self) (f (ptr Formatter))] (-> i64)))

;;; Structural diagnostic text. `{:?}` is compact and `{:#?}` sets
;;; `formatter-pretty?` while this method runs.
(deftrait Debug [Self]
  (debug-fmt [(x Self) (f (ptr Formatter))] (-> i64)))

(deftrait LowerHex [Self]
  (lower-hex-fmt [(x Self) (f (ptr Formatter))] (-> i64)))

;;; Signed decimal (io's print-int is non-negative only), correct over the WHOLE
;;; range including i64 MIN.
;;;
;;; The magnitude of i64 MIN is not an i64, so `(isub 0 n)` wraps straight back to
;;; MIN — still negative. The previous version handed that to `print-int`, whose
;;; `n < 10` base case then wrote one byte, `(cast u8 (iadd MIN 48))` = '0', so
;;; `-9223372036854775808` printed as **`-0`**. Not a display quirk: both serde
;;; text backends encode integers through here, so a struct containing i64 MIN
;;; serialized to `-0` and decoded back as 0 — silent data loss with no error
;;; anywhere. (Found by `tests/prop/stdlib_props_test.coil`, which shrank it to
;;; exactly `n = i64::MIN`.)
;;;
;;; The fix is to never negate: emit '-' and print the magnitude through the
;;; UNSIGNED path. `(isub 0 n)` still wraps, but `print-u` reads those bits as
;;; unsigned, and the unsigned reading of the wrapped value IS the magnitude.
(defn print-i [(w (ptr Writer)) (n i64)] (-> (Result i64 IoError))
  (if (< n (cast i64 0))
      (match (write-byte w (primitive/cast u8 45))  ; '-'
        (Err [e] (Err e))
        (Ok [_] (print-u w (primitive/isub 0 n))))
      (print-int w n)))

;;; Lowercase hexadecimal (non-negative), no "0x" prefix.
(defn print-hex [(w (ptr Writer)) (n i64)] (-> (Result i64 IoError))
  (if (< n (cast i64 16))
      (write-byte w
                  (primitive/cast u8
                                    (if (< n (cast i64 10))
                                        (primitive/iadd n 48)
                                        (primitive/iadd n 87))))  ; 87 = 'a'-10
      (match (print-hex w (primitive/idiv n 16))
        (Err [e] (Err e))
        (Ok [_]
            (let [d (primitive/irem n 16)]
              (write-byte w
                          (primitive/cast u8
                                            (if (< d (cast i64 10))
                                                (primitive/iadd d 48)
                                                (primitive/iadd d 87)))))))))

;;; UNSIGNED lowercase hex over the FULL range (udiv/urem interpret the bits as
;;; unsigned, so a "negative" i64 / a u64 with the high bit set prints correctly —
;;; unlike print-hex, which assumes non-negative). Recurses MSB-first.
(defn uhex-digits [(w (ptr Writer)) (n i64)] (-> (Result i64 IoError))
  (if (= n (cast i64 0))
      (Ok 0)
      (match (uhex-digits w (primitive/udiv n 16))
        (Err [e] (Err e))
        (Ok [_]
            (let [d (primitive/urem n 16)]
              (write-byte w
                          (primitive/cast u8
                                            (if (< d (cast i64 10))
                                                (primitive/iadd d 48)
                                                (primitive/iadd d 87)))))))))

(defn print-uhex [(w (ptr Writer)) (n i64)] (-> (Result i64 IoError))
  (if (= n (cast i64 0))
      (write-byte w (primitive/cast u8 48))  ; "0"
      (uhex-digits w n)))

;;; UNSIGNED decimal over the FULL range (udiv/urem interpret the bits as unsigned),
;;; so a u64 with the high bit set prints its true magnitude — print-i would show
;;; the wrapped negative value. Recurses MSB-first, like uhex-digits.
(defn udec-digits [(w (ptr Writer)) (n i64)] (-> (Result i64 IoError))
  (if (= n (cast i64 0))
      (Ok 0)
      (match (udec-digits w (primitive/udiv n 10))
        (Err [e] (Err e))
        (Ok [_]
            (write-byte w
                        (primitive/cast u8
                                          (primitive/iadd (primitive/urem n 10)
                                                          48)))))))

(defn print-u [(w (ptr Writer)) (n i64)] (-> (Result i64 IoError))
  (if (= n (cast i64 0))
      (write-byte w (primitive/cast u8 48))  ; "0"
      (udec-digits w n)))

; ---- floats ------------------------------------------------------------------
; `print-f` writes an f64 in plain decimal: integer part, '.', then the fraction
; rounded to six digits (half-up) with trailing zeros trimmed but at least one
; digit kept — 1.5 -> "1.5", 42.0 -> "42.0", pi -> "3.141593". NaN -> "NaN", the
; infinities -> "inf" / "-inf". A magnitude whose integer part doesn't fit i64
; falls back to approximate scientific notation ("1.797693e+308"). This is a
; DISPLAY convenience (fixed six-digit precision), NOT a shortest-roundtrip
; serializer. Byte writes along the way are best-effort (an error on one digit
; doesn't abort the rest); the final write's result is returned.

;;; write `n` '0' bytes (returns the last write's result)
(defn f--zeros [(w (ptr Writer)) (n i64)] (-> (Result i64 IoError))
  (if (<= n (cast i64 0))
      (Ok 0)
      (do
        (write-byte w (primitive/cast u8 48))
        (f--zeros w (primitive/isub n 1)))))

(defn f--ndigits [(n i64)] (-> i64)
  (if (< n (cast i64 10))
      1
      (primitive/iadd 1 (f--ndigits (primitive/idiv n 10)))))

;;; the fraction part: '.', then fr6 (0..999999 — the fraction scaled by 1e6 and
;;; rounded) with its leading zeros restored and trailing zeros trimmed (min one).
(defn f--frac [(w (ptr Writer)) (fr6 i64)] (-> (Result i64 IoError))
  (let [(mut v) fr6
        (mut width) 6]
    (while (and (> (load width) (cast i64 1))
                (= (primitive/irem (load v) 10) (cast i64 0)))
      (store! v (primitive/idiv (load v) 10))
      (store! width (primitive/isub (load width) 1)))
    (write-byte w (primitive/cast u8 46))  ; '.'
    (f--zeros w (primitive/isub (load width) (f--ndigits (load v))))
    (print-int w (load v))))

;;; x is finite and 0 <= x < 2^63: "<int>.<frac>" (watch the round-up carry:
;;; 0.9999999 scales to 1000000, which is really "1.0")
(defn f--fixed [(w (ptr Writer)) (x f64)] (-> (Result i64 IoError))
  (let [ip0 (primitive/cast i64 x)
        fr6-r
          (primitive/cast i64
                            (primitive/fadd (primitive/fmul (primitive/fsub x
                                                                            (primitive/cast f64
                                                                                              ip0))
                                                            1000000.0)
                                            0.5))
        carry (= fr6-r (cast i64 1000000))
        ip (if carry (primitive/iadd ip0 1) ip0)
        fr6 (if carry 0 fr6-r)]
    (print-int w ip)
    (f--frac w fr6)))

;;; x >= 2^63 (huge finite): approximate scientific notation "m.mmmmmm" 'e' '+' NN
(defn f--sci [(w (ptr Writer)) (x f64)] (-> (Result i64 IoError))
  (let [(mut m) x
        (mut e) 0]
    (while (primitive/fcmp-ge (load m) 10.0)
      (store! m (primitive/fdiv (load m) 10.0))
      (store! e (primitive/iadd (load e) 1)))
    (f--fixed w (load m))
    (write-byte w (primitive/cast u8 101))  ; 'e'
    (write-byte w (primitive/cast u8 43))  ; '+'
    (print-int w (load e))))

;;; x >= 0 (sign and NaN handled by print-f); inf iff x > 0 and 1/x == 0 — the
;;; test needs no max-double literal
(defn f--abs [(w (ptr Writer)) (x f64)] (-> (Result i64 IoError))
  (if (if (primitive/fcmp-gt x 0.0)
          (primitive/fcmp-eq (primitive/fdiv 1.0 x) 0.0)
          false)
      (print-str w "inf")
      (if (primitive/fcmp-lt x 9223372036854775808.0)  ; 2^63, exact as f64
          (f--fixed w x)
          (f--sci w x))))

(defn print-f [(w (ptr Writer)) (x f64)] (-> (Result i64 IoError))
  (if (not (primitive/fcmp-eq x x))  ; only NaN differs from itself
      (print-str w "NaN")
      (if (f--negative? x)
          (do
            (write-byte w (primitive/cast u8 45))  ; '-'
            (f--abs w (primitive/fsub 0.0 x)))
          (f--abs w x))))

;;; Below zero, or negative zero (whose reciprocal is -inf).
(defn f--negative? [(x f64)] (-> bool)
  (or (primitive/fcmp-lt x 0.0)
      (and (primitive/fcmp-eq x 0.0) (primitive/fcmp-lt (primitive/fdiv 1.0 x) 0.0))))

;;; x >= 0, finite or not, with exactly `digits` fraction digits. A value whose
;;; scaled form fits an i64 rounds half to even, as Rust does: 2.5 -> "2", 1.25 at
;;; one digit -> "1.2". Larger values round half up digit by digit.
(defn f--abs-prec [(w (ptr Writer)) (x f64) (digits i64)] (-> (Result i64 IoError))
  (let [(mut scale) 1.0
        (mut unit) 1]
    (for _ (range 0 digits)
      (set! scale (* scale 10.0))
      (set! unit (* unit 10)))
    (cond (and (primitive/fcmp-gt x 0.0) (primitive/fcmp-eq (primitive/fdiv 1.0 x) 0.0))
            (print-str w "inf")
          (and (<= digits 18) (primitive/fcmp-lt (* x (load scale)) 9223372036854775807.0))
            (let [scaled (* x (load scale))
                  whole (cast i64 scaled)
                  rest (- scaled (cast f64 whole))
                  rounded
                    (cond (primitive/fcmp-gt rest 0.5) (+ whole 1)
                          (primitive/fcmp-eq rest 0.5) (+ whole (% whole 2))
                          :else whole)]
              (f--scaled w rounded (load unit) digits))
          :else (f--digit-loop w x (load scale) digits))))

;;; `rounded / unit` with `digits` zero-padded fraction digits.
(defn f--scaled [(w (ptr Writer)) (rounded i64) (unit i64) (digits i64)] (-> (Result i64 IoError))
  (let [result (print-int w (/ rounded unit))]
    (if (= digits 0)
        result
        (let [fraction (% rounded unit)]
          (write-byte w (cast u8 46))
          (f--zeros w (- digits (f--ndigits fraction)))
          (print-int w fraction)))))

(defn f--digit-loop [(w (ptr Writer)) (x f64) (scale f64) (digits i64)] (-> (Result i64 IoError))
  (let [rounded (+ x (/ 0.5 scale))]
    (if (primitive/fcmp-ge rounded 9223372036854775808.0)
        (f--sci w rounded)
        (let [whole (cast i64 rounded)
              (mut rest) (- rounded (cast f64 whole))
              (mut result) (print-int w whole)]
          (when (> digits 0)
            (write-byte w (cast u8 46))
            (for _ (range 0 digits)
              (set! rest (* rest 10.0))
              (let [d (cast i64 (load rest))
                    digit (if (> d 9) 9 d)]
                (set! result (write-byte w (cast u8 (+ 48 digit))))
                (set! rest (- rest (cast f64 digit))))))
          (load result)))))

(defn print-bool [(w (ptr Writer)) (b bool)] (-> (Result i64 IoError))
  (print-str w (if b "true" "false")))

(defn print-char [(w (ptr Writer)) (c i64)] (-> (Result i64 IoError))
  (write-byte w (primitive/cast u8 c)))

(defn print-nl [(w (ptr Writer))] (-> (Result i64 IoError))
  (write-byte w (primitive/cast u8 10)))  ; '\n'

;;; Print a `(slice u8)` string followed by a newline.
(defn print-line [(w (ptr Writer)) (s (slice u8))] (-> (Result i64 IoError))
  (match (print-str w s)
    (Err [e] (Err e))
    (Ok [_] (print-nl w))))

; ---- width, fill and alignment ----------------------------------------------
(defn count--write [(ctx (ptr i8)) (buf (ptr i8)) (len i64)] (-> (Result i64 IoError))
  (let [count (cast (ptr i64) ctx)]
    (store! count (+ (load count) len))
    (Ok len)))

;;; A Writer that only counts the bytes written through it into `count`.
(defn counting-writer [(w (ptr Writer)) (count (ptr i64))] (-> (ptr Writer))
  (store! count 0)
  (store! (field w write-fn) (fnptr-of count--write))
  (store! (field w ctx) (cast (ptr i8) count))
  w)

(defn fmt--fill [(w (ptr Writer)) (spec FormatSpec) (n i64)] (-> i64)
  (for _ (range 0 n) (write-byte w (.fill spec)))
  0)

;;; Padding before and after a value `len` bytes wide; `default-left` places it for
;;; `AlignDefault`.
(defn fmt--pad-before [(w (ptr Writer)) (spec FormatSpec) (len i64) (default-left bool)] (-> i64)
  (let [pad (- (.width spec) len)]
    (when (> pad 0)
      (match (.align spec)
        (AlignRight [] (fmt--fill w spec pad))
        (AlignCenter [] (fmt--fill w spec (/ pad 2)))
        (AlignLeft [] 0)
        (AlignDefault [] (if default-left 0 (fmt--fill w spec pad)))))
    0))

(defn fmt--pad-after [(w (ptr Writer)) (spec FormatSpec) (len i64) (default-left bool)] (-> i64)
  (let [pad (- (.width spec) len)]
    (when (> pad 0)
      (match (.align spec)
        (AlignLeft [] (fmt--fill w spec pad))
        (AlignCenter [] (fmt--fill w spec (- pad (/ pad 2))))
        (AlignRight [] 0)
        (AlignDefault [] (if default-left (fmt--fill w spec pad) 0))))
    0))

;;; The unsigned digits of a number, printed after its sign and any prefix.
(defsum NumberBody
  (NumberDecimal [(magnitude i64)])
  (NumberHex [(bits i64)])
  (NumberFloat [(magnitude f64)])
  ; the shortest text that reads back as exactly this value
  (NumberShortest [(magnitude f64)])
  (NumberShortest32 [(magnitude f32)])
  (NumberText [(text (slice u8))]))

(defn fmt--print-body [(w (ptr Writer)) (body NumberBody) (precision i64)] (-> i64)
  (match body
    (NumberDecimal [m] (print-u w m))
    (NumberHex [bits] (print-uhex w bits))
    (NumberFloat [x] (if (< precision 0) (f--abs w x) (f--abs-prec w x precision)))
    (NumberShortest [x] (if (< precision 0) (write-f64-shortest w x) (f--abs-prec w x precision)))
    (NumberShortest32 [x] (if (< precision 0) (write-f32-shortest w x) (f--abs-prec w (cast f64 x) precision)))
    (NumberText [text] (print-str w text)))
  0)

;;; Write a number as sign, prefix and digits, honoring width, fill, alignment and
;;; `0` (zeros between the sign and the digits, as in Rust).
(defn fmt--number [(f (ptr Formatter)) (negative bool) (prefix (slice u8)) (body NumberBody)] (-> i64)
  (let [w (formatter-writer f)
        spec (formatter-take-spec! f)
        precision (.precision spec)
        sign (cond negative "-" (.plus spec) "+" :else "")
        counter (primitive/alloc-stack Writer)
        digits (primitive/alloc-stack i64)]
    (if (< (.width spec) 0)
        (do (print-str w sign) (print-str w prefix) (fmt--print-body w body precision))
        (do
          (fmt--print-body (counting-writer counter digits) body precision)
          (let [len (+ (len sign) (+ (len prefix) (load digits)))]
            (if (.zero spec)
                (do
                  (print-str w sign)
                  (print-str w prefix)
                  (for _ (range 0 (- (.width spec) len)) (write-byte w (cast u8 48)))
                  (fmt--print-body w body precision))
                (do
                  (fmt--pad-before w spec len false)
                  (print-str w sign)
                  (print-str w prefix)
                  (fmt--print-body w body precision)
                  (fmt--pad-after w spec len false))))))))

;;; Render a Display value under the armed spec: measure it, then pad what the
;;; value did not already fill.
(defn fmt-display-padded [(T Display)] [(x T) (f (ptr Formatter))] (-> i64)
  (let [spec (.spec f)
        w (formatter-writer f)
        counter (primitive/alloc-stack Writer)
        n (primitive/alloc-stack i64)]
    (if (< (.width spec) 0)
        (display-fmt x f)
        (do
          (set! (.writer f) (counting-writer counter n))
          (display-fmt x f)
          (set! (.writer f) w)
          (formatter-set-spec! f spec)
          (fmt--pad-before w spec (load n) true)
          (display-fmt x f)
          (fmt--pad-after w spec (load n) true)))))

;;; Render a Debug value under the armed spec: measure it, then pad what the value
;;; did not already fill.
(defn fmt-debug-padded [(T Debug)] [(x T) (f (ptr Formatter))] (-> i64)
  (let [spec (.spec f)
        w (formatter-writer f)
        counter (primitive/alloc-stack Writer)
        n (primitive/alloc-stack i64)]
    (if (< (.width spec) 0)
        (debug-fmt x f)
        (do
          (set! (.writer f) (counting-writer counter n))
          (debug-fmt x f)
          (set! (.writer f) w)
          (formatter-set-spec! f spec)
          (fmt--pad-before w spec (load n) true)
          (debug-fmt x f)
          (fmt--pad-after w spec (load n) true)))))

; ---- trait implementations --------------------------------------------------
(impl Display i64
  (display-fmt [(x i64) (f (ptr Formatter))]
               (-> i64)
               (let [n (cast i64 x)]
                 (fmt--number f (< n 0) "" (NumberDecimal (if (< n 0) (- 0 n) n))))))

(impl Display i32
  (display-fmt [(x i32) (f (ptr Formatter))]
               (-> i64)
               (let [n (cast i64 x)]
                 (fmt--number f (< n 0) "" (NumberDecimal (if (< n 0) (- 0 n) n))))))

(impl Display i16
  (display-fmt [(x i16) (f (ptr Formatter))]
               (-> i64)
               (let [n (cast i64 x)]
                 (fmt--number f (< n 0) "" (NumberDecimal (if (< n 0) (- 0 n) n))))))

(impl Display i8
  (display-fmt [(x i8) (f (ptr Formatter))]
               (-> i64)
               (let [n (cast i64 x)]
                 (fmt--number f (< n 0) "" (NumberDecimal (if (< n 0) (- 0 n) n))))))

(impl Display u64
  (display-fmt [(x u64) (f (ptr Formatter))]
               (-> i64)
               (fmt--number f false "" (NumberDecimal (cast i64 x)))))

(impl Display u32
  (display-fmt [(x u32) (f (ptr Formatter))]
               (-> i64)
               (fmt--number f false "" (NumberDecimal (cast i64 x)))))

(impl Display u16
  (display-fmt [(x u16) (f (ptr Formatter))]
               (-> i64)
               (fmt--number f false "" (NumberDecimal (cast i64 x)))))

(impl Display u8
  (display-fmt [(x u8) (f (ptr Formatter))]
               (-> i64)
               (fmt--number f false "" (NumberDecimal (cast i64 x)))))

(impl Display bool
  (display-fmt [(x bool) (f (ptr Formatter))]
               (-> i64)
               (print-bool (load (field f writer)) x)
               0))

(defn fmt--float [(f (ptr Formatter)) (x f64)] (-> i64)
  (cond (not (primitive/fcmp-eq x x)) (fmt--number f false "" (NumberText "NaN"))
        (f--negative? x) (fmt--number f true "" (NumberFloat (primitive/fsub 0.0 x)))
        :else (fmt--number f false "" (NumberFloat x))))

(impl Display f64
  (display-fmt [(x f64) (f (ptr Formatter))] (-> i64) (fmt--float f x)))

(impl Display f32
  (display-fmt [(x f32) (f (ptr Formatter))] (-> i64) (fmt--float f (cast f64 x))))

;;; The first `chars` UTF-8 scalars of `s` (all of it when chars is negative).
(defn fmt--truncate [(s (slice u8)) (chars i64)] (-> (slice u8))
  (if (< chars 0)
      s
      (let [(mut seen) 0
            (mut end) (len s)]
        (for i (range 0 (len s))
          (when (!= (& (cast i64 (get s i)) 192) 128)
            (when (and (= (load seen) chars) (= (load end) (len s)))
              (set! end i))
            (set! seen (+ (load seen) 1))))
        (subslice s 0 (load end)))))

(impl Display (slice u8)
  (display-fmt [(x (slice u8)) (f (ptr Formatter))]
               (-> i64)
               (let [spec (formatter-take-spec! f)]
                 (print-str (load (field f writer)) (fmt--truncate x (.precision spec))))
               0))

(impl Debug i64
  (debug-fmt [(x i64) (f (ptr Formatter))] (-> i64) (display-fmt x f)))

(impl Debug i32
  (debug-fmt [(x i32) (f (ptr Formatter))] (-> i64) (display-fmt x f)))

(impl Debug i16
  (debug-fmt [(x i16) (f (ptr Formatter))] (-> i64) (display-fmt x f)))

(impl Debug i8
  (debug-fmt [(x i8) (f (ptr Formatter))] (-> i64) (display-fmt x f)))

(impl Debug u64
  (debug-fmt [(x u64) (f (ptr Formatter))] (-> i64) (display-fmt x f)))

(impl Debug u32
  (debug-fmt [(x u32) (f (ptr Formatter))] (-> i64) (display-fmt x f)))

(impl Debug u16
  (debug-fmt [(x u16) (f (ptr Formatter))] (-> i64) (display-fmt x f)))

(impl Debug u8
  (debug-fmt [(x u8) (f (ptr Formatter))] (-> i64) (display-fmt x f)))

(impl Debug bool
  (debug-fmt [(x bool) (f (ptr Formatter))] (-> i64) (display-fmt x f)))

;;; Debug prints a float as the shortest text that reads back as the same value
;;; (`0.1`, `1.5e-7`), so a derived Debug of a struct with floats is exact
;;; source. Display still rounds to six decimals. An explicit precision
;;; (`{:.3?}`) still selects fixed digits.
(impl Debug f64
  (debug-fmt [(x f64) (f (ptr Formatter))] (-> i64)
    (cond (not (primitive/fcmp-eq x x)) (fmt--number f false "" (NumberText "NaN"))
          (f--negative? x) (fmt--number f true "" (NumberShortest (primitive/fsub 0.0 x)))
          :else (fmt--number f false "" (NumberShortest x)))))

(impl Debug f32
  (debug-fmt [(x f32) (f (ptr Formatter))] (-> i64)
    (let [wide (cast f64 x)]
      (cond (not (primitive/fcmp-eq wide wide)) (fmt--number f false "" (NumberText "NaN"))
            (f--negative? wide) (fmt--number f true "" (NumberShortest32 (- (: 0.0 f32) x)))
            :else (fmt--number f false "" (NumberShortest32 x))))))

(defn debug-byte-write [(w (ptr Writer)) (b i64)] (-> i64)
  (let [byte (primitive/alloc-stack u8)]
    (store! byte (primitive/cast u8 b))
    (print-str w (slice-new [u8] byte 1))
    0))

(defn debug-byte-fmt [(w (ptr Writer)) (b i64)] (-> i64)
  (cond (= b 34) (do (print-str w "\\\"") 0)
        (= b 92) (do (print-str w "\\\\") 0)
        (= b 10) (do (print-str w "\\n") 0)
        (= b 9) (do (print-str w "\\t") 0)
        (= b 13) (do (print-str w "\\r") 0)
        (or (< b 32) (> b 126)) (do (print-str w "\\x") (print-uhex w b) 0)
        :else (debug-byte-write w b)))

(impl Debug (slice u8)
  (debug-fmt [(x (slice u8)) (f (ptr Formatter))]
             (-> i64)
             (let [w (formatter-writer f)]
               (print-str w "\"")
               (let [(mut i) 0]
                 (loop (if (>= (load i) (slice-len [u8] x))
                           (break)
                           (do
                             (debug-byte-fmt w
                                             (primitive/cast i64
                                                             (slice-get [u8]
                                                                        x
                                                                        (load i))))
                             (store! i (primitive/iadd (load i) 1))))))
               (print-str w "\"")
               0)))

(impl LowerHex i64
  (lower-hex-fmt [(x i64) (f (ptr Formatter))]
                 (-> i64)
                 (fmt--number f false (if (formatter-pretty? f) "0x" "") (NumberHex x))))

(impl LowerHex u64
  (lower-hex-fmt [(x u64) (f (ptr Formatter))]
                 (-> i64)
                 (fmt--number f false (if (formatter-pretty? f) "0x" "") (NumberHex (cast i64 x)))))

; ---- positional format strings (a MACRO over the printers + the str-bytes /
;      bytes->str compile-time builtins; the compiler knows nothing of formats) ----
; Rust-style forms are `{}` (Display), `{:?}` (compact Debug), `{:#?}` (pretty
; Debug), `{:x}` (LowerHex), and `{:#x}` (alternate LowerHex). `{{`/`}}` escape
; braces. The old one-letter forms remain temporarily as a migration bridge.

;; The printer for a spec, as a canonical hygienic name or an alias-qualified
;; imported name. Canonical dotted names here are Code values
;; emitted by the macro, not source-level module qualification.
;; The name is spliced into call-head position via `~unquote`, which bypasses the
;; macro's call-head hygiene — so qualify it here, otherwise it resolves at the use
;; site and breaks wherever the caller didn't import io/fmt (e.g. the ambient
;; `print`/`println`, which import nothing).
; ⚠ The fmt MACRO's helpers (fmt--printer/fmt--flush/fmt--go) must use METAL
; comparison ops, not the clean `=`/`<`: the tower stages a macro through the
; PRUNED closure, which deliberately carries no trait impls (see
; comptime.coil::closure-subprogram-pruned) — a clean operator there makes the
; whole macro unstageable inside other macro bodies.
(defn fmt--legacy-printer [(spec i64)] (-> Code)
  (if (primitive/icmp-eq spec 100)
      `coil.fmt.print-i
      (if (primitive/icmp-eq spec 115)
          `coil.io.print-str
          (if (primitive/icmp-eq spec 120)
              `coil.fmt.print-uhex  ; {x}: full-range hex. print-hex assumed
              ; non-negative and emitted a garbage byte for
              ; a negative i64 (a hash/mask/errno that went
              ; negative — exactly what {x} is reached for).
              (if (primitive/icmp-eq spec 99)
                  `coil.fmt.print-char
                  (if (primitive/icmp-eq spec 98)
                      `coil.fmt.print-bool
                      (if (primitive/icmp-eq spec 117)
                          `coil.fmt.print-u
                          (if (primitive/icmp-eq spec 102)
                              `coil.fmt.print-f
                              (primitive/error "fmt: unknown spec; use {d} {s} {x} {c} {b} {u} {f}")))))))))

;;; The byte at `i` of the format string, or -1 past its end.
(defn fmt--byte [(bs Code) (i i64)] (-> i64)
  (if (primitive/icmp-lt i (primitive/code-count bs))
      (primitive/code-int (primitive/code-nth bs i))
      -1))

;;; 1 for '<', 2 for '>', 3 for '^', otherwise 0.
(defn fmt--align-byte [(b i64)] (-> i64)
  (if (primitive/icmp-eq b 60)
      1
      (if (primitive/icmp-eq b 62) 2 (if (primitive/icmp-eq b 94) 3 0))))

;;; The index of the first non-digit at or after `i`.
(defn fmt--digits-end [(bs Code) (i i64)] (-> i64)
  (let [(mut at) i]
    (loop (let [b (fmt--byte bs (load at))]
            (if (and (primitive/icmp-ge b 48) (primitive/icmp-le b 57))
                (store! at (primitive/iadd (load at) 1))
                (break))))
    (load at)))

(defn fmt--digits-value [(bs Code) (from i64) (to i64)] (-> i64)
  (let [(mut value) 0
        (mut at) from]
    (loop (if (primitive/icmp-lt (load at) to)
              (do
                (store! value
                        (primitive/iadd (primitive/imul (load value) 10)
                                        (primitive/isub (fmt--byte bs (load at)) 48)))
                (store! at (primitive/iadd (load at) 1)))
              (break)))
    (load value)))

;;; Parse the placeholder starting at `i` (its '{') into
;;; `(kind end width precision fill align plus zero)`. Kinds 0..4 are `{}`, `{:?}`,
;;; `{:#?}`, `{:x}` and `{:#x}`; legacy one-letter forms are 100 plus their letter.
;;; `end` is the index after the closing '}'. The spec grammar is Rust's subset
;;; `[[fill]align][+][#][0][width][.precision][?|x]`.
(defn fmt--parse-placeholder [(bs Code) (i i64)] (-> Code)
  (let [b1 (fmt--byte bs (primitive/iadd i 1))]
    (if (primitive/icmp-eq b1 -1)
        (primitive/error "fmt: unmatched '{'")
        (if (primitive/icmp-eq b1 125)
            `(0 ~(primitive/iadd i 2) -1 -1 32 0 0 0)
            (if (primitive/icmp-eq b1 58)
                (fmt--parse-spec bs (primitive/iadd i 2))
                (if (primitive/icmp-eq (fmt--byte bs (primitive/iadd i 2)) 125)
                    `(~(primitive/iadd 100 b1) ~(primitive/iadd i 3) -1 -1 32 0 0 0)
                    (primitive/error "fmt: malformed placeholder")))))))

(defn fmt--parse-spec [(bs Code) (start i64)] (-> Code)
  (let [(mut at) start
        (mut fill) 32
        (mut align) 0
        (mut plus) 0
        (mut alternate) 0
        (mut zero) 0
        (mut width) -1
        (mut precision) -1
        b0 (fmt--byte bs start)
        after (fmt--align-byte (fmt--byte bs (primitive/iadd start 1)))]
    (if (and (not (primitive/icmp-eq b0 125)) (not (primitive/icmp-eq after 0)))
        (do
          (store! fill b0)
          (store! align after)
          (store! at (primitive/iadd start 2)))
        (when (not (primitive/icmp-eq (fmt--align-byte b0) 0))
          (store! align (fmt--align-byte b0))
          (store! at (primitive/iadd start 1))))
    (when (primitive/icmp-eq (fmt--byte bs (load at)) 43)
      (store! plus 1)
      (store! at (primitive/iadd (load at) 1)))
    (when (primitive/icmp-eq (fmt--byte bs (load at)) 35)
      (store! alternate 1)
      (store! at (primitive/iadd (load at) 1)))
    (when (primitive/icmp-eq (fmt--byte bs (load at)) 48)
      (store! zero 1)
      (store! at (primitive/iadd (load at) 1)))
    (let [width-end (fmt--digits-end bs (load at))]
      (when (primitive/icmp-lt (load at) width-end)
        (store! width (fmt--digits-value bs (load at) width-end))
        (store! at width-end)))
    (when (primitive/icmp-eq (fmt--byte bs (load at)) 46)
      (let [from (primitive/iadd (load at) 1)
            to (fmt--digits-end bs from)]
        (if (primitive/icmp-eq from to)
            (primitive/code-int (primitive/error "fmt: expected digits after '.' in a format spec"))
            (do
              (store! precision (fmt--digits-value bs from to))
              (store! at to)))))
    (let [t (fmt--byte bs (load at))
          kind
            (if (primitive/icmp-eq t 63)
                (if (primitive/icmp-eq (load alternate) 1) 2 1)
                (if (primitive/icmp-eq t 120)
                    (if (primitive/icmp-eq (load alternate) 1) 4 3)
                    (if (primitive/icmp-eq t 125)
                        0
                        (primitive/code-int (primitive/error "fmt: unsupported format spec; use [[fill]align][+][#][0][width][.precision][?|x]")))))
          close (if (primitive/icmp-eq t 125) (load at) (primitive/iadd (load at) 1))]
      (if (primitive/icmp-eq (fmt--byte bs close) 125)
          `(~kind ~(primitive/iadd close 1) ~(load width) ~(load precision) ~(load fill)
                  ~(load align) ~(load plus) ~(load zero))
          (primitive/error "fmt: expected '}' to close the format spec")))))

(defn fmt--spec-int [(spec Code) (i i64)] (-> i64)
  (primitive/code-int (primitive/code-nth spec i)))

(defn fmt--plain-spec? [(spec Code)] (-> bool)
  (and (primitive/icmp-eq (fmt--spec-int spec 2) -1)
       (primitive/icmp-eq (fmt--spec-int spec 3) -1)
       (primitive/icmp-eq (fmt--spec-int spec 5) 0)
       (primitive/icmp-eq (fmt--spec-int spec 6) 0)
       (primitive/icmp-eq (fmt--spec-int spec 7) 0)))

(defn fmt--align-code [(align i64)] (-> Code)
  (if (primitive/icmp-eq align 1)
      `(AlignLeft)
      (if (primitive/icmp-eq align 2)
          `(AlignRight)
          (if (primitive/icmp-eq align 3) `(AlignCenter) `(AlignDefault)))))

(defn fmt--emit [(f Code) (w Code) (arg Code) (spec Code)] (-> Code)
  (let [kind (fmt--spec-int spec 0)]
    (if (fmt--plain-spec? spec)
        (fmt--emit-plain f w arg kind)
        (let [alternate (if (primitive/icmp-eq kind 2) `true (if (primitive/icmp-eq kind 4) `true `false))
              printer
                (if (primitive/icmp-eq kind 0)
                    `fmt-display-padded
                    (if (primitive/icmp-lt kind 3) `fmt-debug-padded `lower-hex-fmt))]
          `(do
             (formatter-set-spec! ~f
                                  (FormatSpec
                                    :width ~(primitive/code-nth spec 2)
                                    :precision ~(primitive/code-nth spec 3)
                                    :fill (primitive/cast u8 ~(primitive/code-nth spec 4))
                                    :align ~(fmt--align-code (fmt--spec-int spec 5))
                                    :plus ~(if (primitive/icmp-eq (fmt--spec-int spec 6) 1) `true `false)
                                    :zero ~(if (primitive/icmp-eq (fmt--spec-int spec 7) 1) `true `false)))
             (formatter-set-alternate! ~f ~alternate)
             (~printer ~arg ~f)
             (formatter-clear-spec! ~f))))))

(defn fmt--emit-plain [(f Code) (w Code) (arg Code) (kind i64)] (-> Code)
  (if (primitive/icmp-eq kind 0)
      `(do (formatter-set-alternate! ~f false) (display-fmt ~arg ~f))
      (if (primitive/icmp-eq kind 1)
          `(do (formatter-set-alternate! ~f false) (debug-fmt ~arg ~f))
          (if (primitive/icmp-eq kind 2)
              `(do (formatter-set-alternate! ~f true) (debug-fmt ~arg ~f))
              (if (primitive/icmp-eq kind 3)
                  `(do
                     (formatter-set-alternate! ~f false)
                     (lower-hex-fmt ~arg ~f))
                  (if (primitive/icmp-eq kind 4)
                      `(do
                         (formatter-set-alternate! ~f true)
                         (lower-hex-fmt ~arg ~f))
                      `(~(fmt--legacy-printer (primitive/isub kind 100)) ~w
                          ~arg)))))))

;;; flush the accumulated literal bytes as a single print-str (or nothing if empty)
(defn fmt--flush [(w Code) (lit Code)] (-> Code)
  (if (primitive/icmp-eq (primitive/code-count lit) 0)
      `()
      `((coil.io.print-str ~w ~(primitive/bytes->str lit)))))

;;; Append every element of list `xs` onto the growable list `out` (METAL ops —
;;; see the ⚠ note above).
(defn fmt--push-each [(out CodeBuilder) (xs Code)] (-> CodeBuilder)
  (let [(mut k) 0]
    (loop (if (primitive/icmp-lt (load k) (primitive/code-count xs))
              (do
                (primitive/code-list-push! out (primitive/code-nth xs (load k)))
                (store! k (primitive/iadd (load k) 1)))
              (break)))
    out))

;;; single pass over the format bytes (primitive/index i), accumulating literal bytes in `lit`
;;; and consuming `args` (primitive/index ai). Appends print-* call forms onto the
;;; growable list `out` and returns it. `lit` and `out` are growable code lists
;;; (code-list-new/push!) — re-splicing the accumulator per byte and splicing the
;;; recursion's result per segment are both quadratic in the format-string length
;;; (docs/design/META_MEMORY.md).
(defn fmt--go [(f Code)
               (w Code)
               (bs Code)
               (i i64)
               (lit CodeBuilder)
               (args Code)
               (ai i64)
               (out CodeBuilder)] (-> CodeBuilder)
  (if (primitive/icmp-eq i (primitive/code-count bs))
      (if (primitive/icmp-eq ai (primitive/code-count args))
          (fmt--push-each out (fmt--flush w (primitive/code-list-done lit)))
          (primitive/error "fmt: too many arguments for the format string"))
      (let [b (primitive/code-int (primitive/code-nth bs i))]
        (if (primitive/icmp-eq b 123)  ; '{'
            (if (if (primitive/icmp-lt (primitive/iadd i 1)
                                       (primitive/code-count bs))
                    (primitive/icmp-eq (primitive/code-int (primitive/code-nth bs
                                                                               (primitive/iadd i
                                                                                               1)))
                                       123)
                    false)
                (do
                  (primitive/code-list-push! lit `123)  ; '{{' -> literal '{'
                  (fmt--go f w bs (primitive/iadd i 2) lit args ai out))
                (if (primitive/icmp-eq ai (primitive/code-count args))
                    (primitive/error "fmt: not enough arguments for the format string")
                    (let [spec (fmt--parse-placeholder bs i)]
                      (fmt--push-each out
                                      (fmt--flush w
                                                  (primitive/code-list-done lit)))
                      (primitive/code-list-push! out
                                                 (fmt--emit f
                                                            w
                                                            (primitive/code-nth args
                                                                                ai)
                                                            spec))
                      (fmt--go f
                               w
                               bs
                               (fmt--spec-int spec 1)
                               (primitive/code-list-new)
                               args
                               (primitive/iadd ai 1)
                               out))))
            (if (primitive/icmp-eq b 125)  ; '}'
                (if (if (primitive/icmp-lt (primitive/iadd i 1)
                                           (primitive/code-count bs))
                        (primitive/icmp-eq (primitive/code-int (primitive/code-nth bs
                                                                                   (primitive/iadd i
                                                                                                   1)))
                                           125)
                        false)
                    (do
                      (primitive/code-list-push! lit `125)  ; '}}' -> literal '}'
                      (fmt--go f w bs (primitive/iadd i 2) lit args ai out))
                    (primitive/error "fmt: unmatched '}' (use '}}')"))
                (do
                  (primitive/code-list-push! lit (primitive/code-nth bs i))
                  (fmt--go f w bs (primitive/iadd i 1) lit args ai out)))))))

(defn fmt [(w Code) (fmt-str Code) & (args Code)] (-> Code)
  (let [f (primitive/fresh-identifier "formatter")]
    `(let [~f (primitive/alloc-stack Formatter)]
       (formatter-init ~f ~w)
       (do
         ~@(fmt--go f
                    w
                    (primitive/str-bytes fmt-str)
                    0
                    (primitive/code-list-new)
                    args
                    0
                    (primitive/code-list-new))))))

; ---- Debug for Option and Result, the pretty-print indent writer, and derive ----

; A derived value writes its own field prefixes to the caller's writer. Nested
; values use this adapter, which adds one level to every continuation line while
; leaving the nested value's first byte exactly where the field prefix put it.
(defstruct DebugIndentWriter
  [(inner (ptr Writer))
   (line-start bool)])

(defn debug-indent-write [(ctx (ptr i8)) (buf (ptr i8)) (len i64)] (-> (Result i64
                                                                               IoError))
  (let [state (primitive/cast (ptr DebugIndentWriter) ctx)
        bytes (primitive/cast (ptr u8) buf)
        (mut at) 0
        (mut failed) false
        (mut error) (Eof)]
    (loop (if (or (load failed) (>= (load at) len)) (break) 0)
      (let [byte (load (primitive/index bytes (load at)))]
        (when (and (load (field state line-start))
                   (!= (primitive/cast i64 byte) 10))
          (match (print-str (load (field state inner)) "  ")
            (Err [e] (do (store! failed true) (store! error e) 0))
            (Ok [_] (do (store! (field state line-start) false) 0)))
          0)
        (unless (load failed)
          (match (coil.io.write-byte (load (field state inner)) byte)
            (Err [e] (do (store! failed true) (store! error e) 0))
            (Ok [_]
                (do
                  (store! (field state line-start)
                          (= (primitive/cast i64 byte) 10))
                  (store! at (primitive/iadd (load at) 1))
                  0)))
          0)))
    (if (load failed) (Err (load error)) (Ok len))))

(defn debug-indent-writer [(state (ptr DebugIndentWriter))
                           (out (ptr Writer))
                           (inner (ptr Writer))] (-> (ptr Writer))
  (store! (field state inner) inner)
  (store! (field state line-start) false)
  (store! (field out write-fn) (primitive/fnptr-of debug-indent-write))
  (store! (field out ctx) (primitive/cast (ptr i8) state))
  out)

(impl [(T Debug)] Debug (Option T)
  (debug-fmt [(x (Option T)) (f (ptr Formatter))]
             (-> i64)
             (formatter-disarm! f)
             (let [w (formatter-writer f)
                   indent (primitive/alloc-stack DebugIndentWriter)
                   nested-w (primitive/alloc-stack Writer)
                   nested-f (primitive/alloc-stack Formatter)]
               (if (formatter-pretty? f)
                   (do
                     (debug-indent-writer indent nested-w w)
                     (formatter-init nested-f nested-w)
                     (formatter-set-alternate! nested-f true))
                   (do (formatter-init nested-f w) 0))
               (match x
                 (None [] (do (print-str w "(None)") 0))
                 (Some [v]
                       (if (formatter-pretty? f)
                           (do
                             (print-str w "(Some\n  ")
                             (debug-fmt v nested-f)
                             (print-str w "\n)")
                             0)
                           (do
                             (print-str w "(Some ")
                             (debug-fmt v nested-f)
                             (print-str w ")")
                             0)))))))

(impl [(T Debug) (E Debug)] Debug (Result T E)
  (debug-fmt [(x (Result T E)) (f (ptr Formatter))]
             (-> i64)
             (formatter-disarm! f)
             (let [w (formatter-writer f)
                   indent (primitive/alloc-stack DebugIndentWriter)
                   nested-w (primitive/alloc-stack Writer)
                   nested-f (primitive/alloc-stack Formatter)]
               (if (formatter-pretty? f)
                   (do
                     (debug-indent-writer indent nested-w w)
                     (formatter-init nested-f nested-w)
                     (formatter-set-alternate! nested-f true))
                   (do (formatter-init nested-f w) 0))
               (let [pretty (formatter-pretty? f)]
                 (match x
                   (Ok [v]
                       (print-str w (if pretty "(Ok\n  " "(Ok "))
                       (debug-fmt v nested-f))
                   (Err [e]
                        (print-str w (if pretty "(Err\n  " "(Err "))
                        (debug-fmt e nested-f))))
               (print-str w (if (formatter-pretty? f) "\n)" ")"))
               0)))

; --------------------------- derive Debug ----------------------------------

; Debug derive options use the same field-oriented shape as serde derives:
; `(derive (Debug (field secret (skip))) T)`. Keeping the option attached to
; Debug avoids a declaration-wide annotation that would silently affect other
; derives such as Serialize or Eq.
(defn debug--some? [(form Code)] (-> bool)
  (if (primitive/code-list? form)
      (> (primitive/code-count form) (primitive/cast i64 0))
      false))

(defn debug--head [(form Code)] (-> Code)
  (if (debug--some? form) (primitive/code-nth form 0) `()))

(defn debug--find-field-option [(opts Code) (fname Code)] (-> Code)
  (let [n (primitive/code-count opts)
        (mut i) 0
        (mut out) `()]
    (loop (if (>= (load i) n)
              (break)
              (let [option (primitive/code-nth opts (load i))]
                (if (and (primitive/code-eq (debug--head option) `field)
                         (and (>= (primitive/code-count option)
                                  (primitive/cast i64 2))
                              (primitive/code-eq (primitive/code-nth option 1)
                                                 fname)))
                    (do (store! out option) (break))
                    (store! i (primitive/iadd (load i) 1))))))
    (load out)))

(defn debug--field-skipped? [(opts Code) (fname Code)] (-> bool)
  (let [option (debug--find-field-option opts fname)]
    (and (debug--some? option)
         (and (= (primitive/code-count option) (primitive/cast i64 3))
              (let [setting (primitive/code-nth option 2)]
                (and (= (primitive/code-count setting) (primitive/cast i64 1))
                     (primitive/code-eq (debug--head setting) `skip)))))))

(defn debug--known-field? [(T Code) (fname Code)] (-> bool)
  (let [n (primitive/code-field-count T)
        (mut i) 0
        (mut found) false]
    (loop (if (>= (load i) n)
              (break)
              (if (primitive/code-eq (primitive/code-field-name T (load i))
                                     fname)
                  (do (store! found true) (break))
                  (store! i (primitive/iadd (load i) 1)))))
    (load found)))

(defn debug--option-seen-before? [(opts Code)
                                  (at i64)
                                  (kind Code)
                                  (name Code)
                                  (start i64)] (-> bool)
  (let [(mut i) start
        (mut found) false]
    (loop (if (>= (load i) at)
              (break)
              (let [option (primitive/code-nth opts (load i))]
                (if (and (primitive/code-eq (debug--head option) kind)
                         (and (>= (primitive/code-count option)
                                  (primitive/cast i64 2))
                              (primitive/code-eq (primitive/code-nth option 1)
                                                 name)))
                    (do (store! found true) (break))
                    (store! i (primitive/iadd (load i) 1))))))
    (load found)))

(defn debug--check-options [(T Code) (opts Code)] (-> i64)
  (let [n (primitive/code-count opts)
        (mut i) 0]
    (loop (if (>= (load i) n) (break) 0)
      (let [option (primitive/code-nth opts (load i))]
        (if (not (and (primitive/code-eq (debug--head option) `field)
                      (= (primitive/code-count option) (primitive/cast i64 3))))
            (primitive/code-int (primitive/error "derive Debug: expected (field NAME (skip))"))
            (let [fname (primitive/code-nth option 1)
                  setting (primitive/code-nth option 2)]
              (if (debug--option-seen-before? opts (load i) `field fname 0)
                  (primitive/code-int (primitive/error (primitive/code-str fname
                                                                           " — derive Debug: duplicate field option")))
                  (if (not (debug--known-field? T fname))
                      (primitive/code-int (primitive/error (primitive/code-str fname
                                                                               " — derive Debug: no such field")))
                      (if (not (and (= (primitive/code-count setting)
                                       (primitive/cast i64 1))
                                    (primitive/code-eq (debug--head setting)
                                                       `skip)))
                          (primitive/code-int (primitive/error "derive Debug: field option must be (skip)"))
                          0)))))
        (store! i (primitive/iadd (load i) 1))))
    0))

(defn debug--variant-index [(T Code) (vname Code)] (-> i64)
  (let [n (primitive/code-variant-count T)
        (mut i) 0
        (mut found) -1]
    (loop (if (>= (load i) n)
              (break)
              (if (primitive/code-eq (primitive/code-variant-name T (load i))
                                     vname)
                  (do (store! found (load i)) (break))
                  (store! i (primitive/iadd (load i) 1)))))
    (load found)))

(defn debug--known-variant-field? [(T Code) (vi i64) (fname Code)] (-> bool)
  (let [n (primitive/code-variant-fields T vi)
        (mut i) 0
        (mut found) false]
    (loop (if (>= (load i) n)
              (break)
              (if (primitive/code-eq (primitive/code-variant-field-name T
                                                                        vi
                                                                        (load i))
                                     fname)
                  (do (store! found true) (break))
                  (store! i (primitive/iadd (load i) 1)))))
    (load found)))

(defn debug--find-variant-option [(opts Code) (vname Code)] (-> Code)
  (let [n (primitive/code-count opts)
        (mut i) 0
        (mut out) `()]
    (loop (if (>= (load i) n)
              (break)
              (let [option (primitive/code-nth opts (load i))]
                (if (and (primitive/code-eq (debug--head option) `variant)
                         (and (>= (primitive/code-count option)
                                  (primitive/cast i64 2))
                              (primitive/code-eq (primitive/code-nth option 1)
                                                 vname)))
                    (do (store! out option) (break))
                    (store! i (primitive/iadd (load i) 1))))))
    (load out)))

(defn debug--variant-field-skipped? [(opts Code) (vname Code) (fname Code)] (-> bool)
  (let [variant-option (debug--find-variant-option opts vname)
        n (primitive/code-count variant-option)
        (mut i) 2
        (mut skipped) false]
    (loop (if (>= (load i) n)
              (break)
              (let [field-option (primitive/code-nth variant-option (load i))]
                (if (and (primitive/code-eq (debug--head field-option) `field)
                         (and (primitive/code-eq (primitive/code-nth field-option
                                                                     1)
                                                 fname)
                              (primitive/code-eq (debug--head (primitive/code-nth field-option
                                                                                  2))
                                                 `skip)))
                    (do (store! skipped true) (break))
                    (store! i (primitive/iadd (load i) 1))))))
    (load skipped)))

(defn debug--check-variant-fields [(T Code) (vi i64) (variant-option Code)] (-> i64)
  (let [n (primitive/code-count variant-option)
        (mut i) 2]
    (loop (if (>= (load i) n) (break) 0)
      (let [field-option (primitive/code-nth variant-option (load i))]
        (if (not (and (primitive/code-eq (debug--head field-option) `field)
                      (= (primitive/code-count field-option)
                         (primitive/cast i64 3))))
            (primitive/code-int (primitive/error "derive Debug: expected (field NAME (skip)) inside variant"))
            (let [fname (primitive/code-nth field-option 1)
                  setting (primitive/code-nth field-option 2)]
              (cond (debug--option-seen-before? variant-option
                                                (load i)
                                                `field
                                                fname
                                                2)
                      (primitive/code-int (primitive/error (primitive/code-str fname
                                                                               " — derive Debug: duplicate variant field option")))
                    (not (debug--known-variant-field? T vi fname))
                      (primitive/code-int (primitive/error (primitive/code-str fname
                                                                               " — derive Debug: no such field on variant")))
                    (not (and (= (primitive/code-count setting)
                                 (primitive/cast i64 1))
                              (primitive/code-eq (debug--head setting) `skip)))
                      (primitive/code-int (primitive/error "derive Debug: variant field option must be (skip)"))
                    :else 0)))
        (store! i (primitive/iadd (load i) 1))))
    0))

(defn debug--check-sum-options [(T Code) (opts Code)] (-> i64)
  (let [n (primitive/code-count opts)
        (mut i) 0]
    (loop (if (>= (load i) n) (break) 0)
      (let [variant-option (primitive/code-nth opts (load i))]
        (if (not (and (primitive/code-eq (debug--head variant-option) `variant)
                      (>= (primitive/code-count variant-option)
                          (primitive/cast i64 3))))
            (primitive/code-int (primitive/error "derive Debug: expected (variant NAME (field NAME (skip)) ...)"))
            (let [vname (primitive/code-nth variant-option 1)
                  vi (debug--variant-index T vname)]
              (cond (debug--option-seen-before? opts (load i) `variant vname 0)
                      (primitive/code-int (primitive/error (primitive/code-str vname
                                                                               " — derive Debug: duplicate variant option")))
                    (< vi 0)
                      (primitive/code-int (primitive/error (primitive/code-str vname
                                                                               " — derive Debug: no such variant")))
                    :else (debug--check-variant-fields T vi variant-option))))
        (store! i (primitive/iadd (load i) 1))))
    0))

;;; A growable Code list, not `(… ~@(debug--fields …)): splicing the recursion's
;;; result rebuilds the suffix at every level — quadratic in the field count
;;; (docs/design/META_MEMORY.md).
(defn debug--fields [(T Code)
                     (x Code)
                     (w Code)
                     (nested-f Code)
                     (opts Code)
                     (i i64)
                     (n i64)] (-> Code)
  (let [out (primitive/code-list-new)
        (mut f) i]
    (loop (if (>= (load f) n)
              (break)
              (let [fname (primitive/code-field-name T (load f))]
                (do
                  (unless (debug--field-skipped? opts fname)
                    (primitive/code-list-push! out
                                               `(coil.io.print-str ~w
                                                                   ~(primitive/code-str "\n  :"
                                                                                        fname
                                                                                        " ")))
                    (primitive/code-list-push! out
                                               `(debug-fmt (load (field ~x
                                                                        ~fname))
                                                           ~nested-f))
                    0)
                  (store! f (primitive/iadd (load f) 1))))))
    (primitive/code-list-done out)))

(defn debug--compact-fields [(T Code)
                             (x Code)
                             (w Code)
                             (f Code)
                             (opts Code)
                             (i i64)
                             (n i64)] (-> Code)
  (let [out (primitive/code-list-new)
        (mut at) i]
    (loop (if (>= (load at) n)
              (break)
              (let [fname (primitive/code-field-name T (load at))]
                (do
                  (unless (debug--field-skipped? opts fname)
                    (primitive/code-list-push! out
                                               `(coil.io.print-str ~w
                                                                   ~(primitive/code-str " :"
                                                                                        fname
                                                                                        " ")))
                    (primitive/code-list-push! out
                                               `(debug-fmt (load (field ~x
                                                                        ~fname))
                                                           ~f))
                    0)
                  (store! at (primitive/iadd (load at) 1))))))
    (primitive/code-list-done out)))

(defn debug--visible-fields [(T Code) (opts Code)] (-> i64)
  (let [n (primitive/code-field-count T)
        (mut at) 0
        (mut visible) 0]
    (loop (if (>= (load at) n)
              (break)
              (do
                (unless (debug--field-skipped? opts
                                               (primitive/code-field-name T
                                                                          (load at)))
                  (store! visible (primitive/iadd (load visible) 1)))
                (store! at (primitive/iadd (load at) 1)))))
    (load visible)))

(defn debug--struct [(T Code) (opts Code)] (-> Code)
  (let [n (primitive/code-field-count T)
        x-id (primitive/fresh-identifier "value")
        f-id (primitive/fresh-identifier "formatter")
        w-id (primitive/fresh-identifier "writer")
        indent-id (primitive/fresh-identifier "indent-state")
        nested-w-id (primitive/fresh-identifier "nested-writer")
        nested-f-id (primitive/fresh-identifier "nested-formatter")
        visible (debug--visible-fields T opts)]
    (debug--check-options T opts)
    `(impl Debug ~T
       (debug-fmt [(~x-id ~T) (~f-id (ptr Formatter))]
                  (-> i64)
                  (formatter-disarm! ~f-id)
                  (let [~w-id (formatter-writer ~f-id)]
                    (coil.io.print-str ~w-id ~(primitive/code-str "(" T))
                    (if (formatter-pretty? ~f-id)
                        (let [~indent-id
                                (primitive/alloc-stack DebugIndentWriter)
                              ~nested-w-id
                                (primitive/alloc-stack coil.io.Writer)
                              ~nested-f-id (primitive/alloc-stack Formatter)]
                          (debug-indent-writer ~indent-id ~nested-w-id ~w-id)
                          (formatter-init ~nested-f-id ~nested-w-id)
                          (formatter-set-alternate! ~nested-f-id true)
                          ~@(debug--fields T x-id w-id nested-f-id opts 0 n)
                          ~(if (> visible 0) `(coil.io.print-str ~w-id "\n") `0)
                          0)
                        (do
                          ~@(debug--compact-fields T x-id w-id f-id opts 0 n)
                          0))
                    (coil.io.print-str ~w-id ")")
                    0)))))

;;; Builder loop, not `(~sym ~@(self …)): re-splicing the recursion's result is
;;; quadratic in the payload field count (docs/design/META_MEMORY.md).
(defn debug--binds [(T Code) (vi i64) (fi i64) (n i64)] (-> Code)
  (let [out (primitive/code-list-new)
        (mut f) fi]
    (loop (if (>= (load f) n)
              (break)
              (do
                (primitive/code-list-push! out
                                           (primitive/fresh-identifier (primitive/code-symbol "debug$field$"
                                                                                              (primitive/code-variant-field-name T
                                                                                                                                 vi
                                                                                                                                 (load f)))))
                (store! f (primitive/iadd (load f) 1)))))
    (primitive/code-list-done out)))

(defn debug--ptr? [(T Code)] (-> bool)
  (if (primitive/code-list? T)
      (and (= (primitive/code-count T) (primitive/cast i64 2))
           (primitive/code-eq (primitive/code-nth T 0) `ptr))
      false))

;;; Builder loop for the same reason as debug--fields (docs/design/META_MEMORY.md).
(defn debug--payload [(T Code)
                      (w Code)
                      (nested-f Code)
                      (binds Code)
                      (opts Code)
                      (vi i64)
                      (fi i64)
                      (n i64)] (-> Code)
  (let [out (primitive/code-list-new)
        (mut f) fi]
    (loop (if (>= (load f) n)
              (break)
              (let [fname (primitive/code-variant-field-name T vi (load f))
                    ty (primitive/code-variant-field-type T vi (load f))
                    binder (primitive/code-nth binds (load f))
                    value (if (debug--ptr? ty) `(load ~binder) binder)
                    vname (primitive/code-variant-name T vi)]
                (do
                  (unless (debug--variant-field-skipped? opts vname fname)
                    (primitive/code-list-push! out
                                               `(coil.io.print-str ~w
                                                                   ~(primitive/code-str "\n  :"
                                                                                        fname
                                                                                        " ")))
                    (primitive/code-list-push! out
                                               `(debug-fmt ~value ~nested-f))
                    0)
                  (store! f (primitive/iadd (load f) 1))))))
    (primitive/code-list-done out)))

(defn debug--compact-payload [(T Code)
                              (w Code)
                              (f Code)
                              (binds Code)
                              (opts Code)
                              (vi i64)
                              (fi i64)
                              (n i64)] (-> Code)
  (let [out (primitive/code-list-new)
        (mut at) fi]
    (loop (if (>= (load at) n)
              (break)
              (let [fname (primitive/code-variant-field-name T vi (load at))
                    ty (primitive/code-variant-field-type T vi (load at))
                    binder (primitive/code-nth binds (load at))
                    value (if (debug--ptr? ty) `(load ~binder) binder)
                    vname (primitive/code-variant-name T vi)]
                (do
                  (unless (debug--variant-field-skipped? opts vname fname)
                    (primitive/code-list-push! out
                                               `(coil.io.print-str ~w
                                                                   ~(primitive/code-str " :"
                                                                                        fname
                                                                                        " ")))
                    (primitive/code-list-push! out `(debug-fmt ~value ~f))
                    0)
                  (store! at (primitive/iadd (load at) 1))))))
    (primitive/code-list-done out)))

(defn debug--visible-payload [(T Code) (opts Code) (vi i64)] (-> i64)
  (let [n (primitive/code-variant-fields T vi)
        vname (primitive/code-variant-name T vi)
        (mut at) 0
        (mut visible) 0]
    (loop (if (>= (load at) n)
              (break)
              (do
                (unless (debug--variant-field-skipped? opts
                                                       vname
                                                       (primitive/code-variant-field-name T
                                                                                          vi
                                                                                          (load at)))
                  (store! visible (primitive/iadd (load visible) 1)))
                (store! at (primitive/iadd (load at) 1)))))
    (load visible)))

;;; Builder loop, one match arm per push — quadratic in the variant count as a
;;; self-splice (docs/design/META_MEMORY.md). The inner ~@ splices are one-shot
;;; uses of finished lists, which stay.
(defn debug--arms [(T Code)
                   (w Code)
                   (f Code)
                   (nested-f Code)
                   (opts Code)
                   (vi i64)
                   (n i64)] (-> Code)
  (let [out (primitive/code-list-new)
        (mut v) vi]
    (loop (if (>= (load v) n)
              (break)
              (let [nf (primitive/code-variant-fields T (load v))
                    visible (debug--visible-payload T opts (load v))
                    binds (debug--binds T (load v) 0 nf)]
                (do
                  (primitive/code-list-push! out
                                             `(~(primitive/code-variant-qname T
                                                                              (load v)) [~@binds]
                                                 (do
                                                   (coil.io.print-str ~w
                                                                      ~(primitive/code-str "("
                                                                                           (primitive/code-variant-name T
                                                                                                                        (load v))))
                                                   (if (formatter-pretty? ~f)
                                                       (do
                                                         ~@(debug--payload T
                                                                           w
                                                                           nested-f
                                                                           binds
                                                                           opts
                                                                           (load v)
                                                                           0
                                                                           nf)
                                                         ~(if (> visible 0)
                                                              `(coil.io.print-str ~w
                                                                                  "\n")
                                                              `0)
                                                         0)
                                                       (do
                                                         ~@(debug--compact-payload T
                                                                                   w
                                                                                   f
                                                                                   binds
                                                                                   opts
                                                                                   (load v)
                                                                                   0
                                                                                   nf)
                                                         0))
                                                   (coil.io.print-str ~w ")")
                                                   0)))
                  (store! v (primitive/iadd (load v) 1))))))
    (primitive/code-list-done out)))

(defn debug--sum [(T Code) (opts Code)] (-> Code)
  (let [x-id (primitive/fresh-identifier "value")
        f-id (primitive/fresh-identifier "formatter")
        w-id (primitive/fresh-identifier "writer")
        indent-id (primitive/fresh-identifier "indent-state")
        nested-w-id (primitive/fresh-identifier "nested-writer")
        nested-f-id (primitive/fresh-identifier "nested-formatter")]
    (debug--check-sum-options T opts)
    `(impl Debug ~T
       (debug-fmt [(~x-id ~T) (~f-id (ptr Formatter))]
                  (-> i64)
                  (formatter-disarm! ~f-id)
                  (let [~w-id (formatter-writer ~f-id)
                        ~indent-id (primitive/alloc-stack DebugIndentWriter)
                        ~nested-w-id (primitive/alloc-stack coil.io.Writer)
                        ~nested-f-id (primitive/alloc-stack Formatter)]
                    (debug-indent-writer ~indent-id ~nested-w-id ~w-id)
                    (formatter-init ~nested-f-id ~nested-w-id)
                    (formatter-set-alternate! ~nested-f-id true)
                    (match ~x-id
                      ~@(debug--arms T
                                     w-id
                                     f-id
                                     nested-f-id
                                     opts
                                     0
                                     (primitive/code-variant-count T))))))))

(defderive Debug
           (struct [T & opts] (debug--struct T opts))
           (sum [T & opts] (debug--sum T opts)))

; ---- shortest round-trip float text -------------------------------------------
; The fewest significant decimal digits that read back as exactly the same
; float, by Steele & White's free-format algorithm (Dragon4) over exact
; integers. It runs anywhere: it needs neither libc's %g nor strtod.

(const FSH-LIMBS 80)  ; 32-bit limbs: 2560 bits, room for 2^1076 * 10^343

;;; A non-negative integer in 32-bit limbs, least significant first.
(defstruct FshBig [(used i64) (limbs (array u64 80))])

(defn fsh-zero [] (-> FshBig) (FshBig :used 0 :limbs (zeroed (array u64 80))))

(defn fsh-from [(v u64)] (-> FshBig)
  (let [(mut b) (fsh-zero)]
    (set! (mut (.limbs b)) 0 (& v 4294967295))
    (set! (mut (.limbs b)) 1 (>> v 32))
    (set! (.used b) (cond (!= (>> v 32) 0) 2 (!= v 0) 1 :else 0))
    b))

(defn fsh-trim! [(b (mut FshBig))] (-> void)
  (while (and (> (.used b) 0) (= (get (.limbs b) (- (.used b) 1)) 0))
    (set! (.used b) (- (.used b) 1))))

(defn fsh-mul-small! [(b (mut FshBig)) (m u64)] (-> void)
  (let [(mut carry) (: 0 u64)]
    (for i (range 0 (.used b))
      (let [t (+ (* (get (.limbs b) i) m) carry)]
        (set! (mut (.limbs b)) i (& t 4294967295))
        (set! carry (>> t 32))))
    (when (!= carry 0)
      (set! (mut (.limbs b)) (.used b) carry)
      (set! (.used b) (+ (.used b) 1)))))

(defn fsh-shl! [(b (mut FshBig)) (bits i64)] (-> void)
  (let [words (/ bits 32)
        shift (: (cast u64 (% bits 32)) u64)]
    (when (> (.used b) 0)
      (let [(mut i) (+ (.used b) words)]
        (set! (mut (.limbs b)) i 0)
        (while (> i words)
          (let [src (get (.limbs b) (- i words 1))]
            (set! (mut (.limbs b)) i (& (| (get (.limbs b) i) (if (= shift 0) 0 (>> src (- (: 32 u64) shift)))) 4294967295))
            (set! (mut (.limbs b)) (- i 1) (& (<< src shift) 4294967295)))
          (set! i (- i 1)))
        (for j (range 0 words) (set! (mut (.limbs b)) j 0))
        (set! (.used b) (+ (.used b) words 1))
        (fsh-trim! (mut b))))))

(defn fsh-cmp [(x FshBig) (y FshBig)] (-> i64)
  (if (!= (.used x) (.used y))
      (if (> (.used x) (.used y)) 1 -1)
      (let [(mut i) (- (.used x) 1)
            (mut r) 0]
        (while (and (>= i 0) (= r 0))
          (let [a (get (.limbs x) i) c (get (.limbs y) i)]
            (cond (> a c) (set! r 1) (< a c) (set! r -1) :else 0))
          (set! i (- i 1)))
        r)))

(defn fsh-add [(x FshBig) (y FshBig)] (-> FshBig)
  (let [(mut out) (fsh-zero)
        n (if (> (.used x) (.used y)) (.used x) (.used y))
        (mut carry) (: 0 u64)]
    (for i (range 0 n)
      (let [t (+ (get (.limbs x) i) (get (.limbs y) i) carry)]
        (set! (mut (.limbs out)) i (& t 4294967295))
        (set! carry (>> t 32))))
    (set! (mut (.limbs out)) n carry)
    (set! (.used out) (if (= carry 0) n (+ n 1)))
    (fsh-trim! (mut out))
    out))

;;; x - y for x >= y.
(defn fsh-sub! [(x (mut FshBig)) (y FshBig)] (-> void)
  (let [(mut borrow) (: 0 u64)]
    (for i (range 0 (.used x))
      (let [a (get (.limbs x) i)
            c (+ (get (.limbs y) i) borrow)]
        (if (>= a c)
            (do (set! (mut (.limbs x)) i (- a c)) (set! borrow 0))
            (do (set! (mut (.limbs x)) i (- (+ a 4294967296) c)) (set! borrow 1)))))
    (fsh-trim! (mut x))))

;;; ceil for the small magnitudes k takes (|x| < 400).
(defn fsh-ceil [(x f64)] (-> f64)
  (let [t (cast f64 (cast i64 x))]
    (if (primitive/fcmp-gt x t) (+ t 1.0) t)))

(defn fsh-mul-pow10! [(b (mut FshBig)) (n i64)] (-> void)
  (let [(mut left) n]
    (while (>= left 9) (fsh-mul-small! (mut b) 1000000000) (set! left (- left 9)))
    (let [(mut m) (: 1 u64)]
      (for _ (range 0 left) (set! m (* m 10)))
      (when (> left 0) (fsh-mul-small! (mut b) m)))))

;;; The next decimal digit of r/s (< 10): subtracts s from r that many times.
(defn fsh-next-digit! [(r (mut FshBig)) (s FshBig)] (-> i64)
  (let [(mut d) 0]
    (while (>= (fsh-cmp r s) 0) (fsh-sub! (mut r) s) (set! d (+ d 1)))
    d))

;;; The shortest digits of the positive finite value mantissa * 2^exp2, and the
;;; decimal exponent k with value = 0.d1d2... * 10^k. `min-normal?` is true when
;;; the mantissa is the smallest normal one (its lower neighbour is closer).
(defn fsh-digits [(mantissa u64) (exp2 i64) (min-normal? bool) (digits (mut (array u8 20)))] (-> (array i64 2))
  (let [even (= (& mantissa 1) 0)
        (mut r) (fsh-from mantissa)
        (mut s) (fsh-from 1)
        (mut mplus) (fsh-from 1)
        (mut mminus) (fsh-from 1)]
    ; r/s = v, mplus/s and mminus/s = the gaps to the neighbouring floats, all x2
    (if (>= exp2 0)
        (do
          (fsh-shl! (mut r) (+ exp2 1))
          (fsh-shl! (mut s) 1)
          (fsh-shl! (mut mplus) exp2)
          (fsh-shl! (mut mminus) exp2)
          (when min-normal?
            (fsh-shl! (mut r) 1) (fsh-shl! (mut s) 1) (fsh-shl! (mut mplus) 1)))
        (do
          (fsh-shl! (mut r) 1)
          (fsh-shl! (mut s) (- 1 exp2))
          (when min-normal?
            (fsh-shl! (mut r) 1) (fsh-shl! (mut s) 1) (fsh-shl! (mut mplus) 1))))
    ; k = ceil(log10 v), estimated low from the bit length and fixed up below
    (let [bits (let [(mut n) 0 (mut m) mantissa] (while (!= m 0) (set! m (>> m 1)) (set! n (+ n 1))) n)
          estimate (cast i64 (fsh-ceil (- (* (cast f64 (+ exp2 bits -1)) 0.30102999566398114) 0.0000000001)))
          (mut k) estimate]
      (if (>= k 0)
          (fsh-mul-pow10! (mut s) k)
          (do
            (fsh-mul-pow10! (mut r) (- 0 k))
            (fsh-mul-pow10! (mut mplus) (- 0 k))
            (fsh-mul-pow10! (mut mminus) (- 0 k))))
      (let [high (fsh-cmp (fsh-add r mplus) s)]
        (when (or (> high 0) (and even (= high 0)))
          (fsh-mul-small! (mut s) 10)
          (set! k (+ k 1))))
      (let [(mut n) 0
            (mut done) false]
        (while (not done)
          (fsh-mul-small! (mut r) 10)
          (fsh-mul-small! (mut mplus) 10)
          (fsh-mul-small! (mut mminus) 10)
          (let [d (fsh-next-digit! (mut r) s)]
            (let [lowc (fsh-cmp r mminus)
                  highc (fsh-cmp (fsh-add r mplus) s)
                  low (or (< lowc 0) (and even (= lowc 0)))
                  high (or (> highc 0) (and even (= highc 0)))]
              (cond (and (not low) (not high)) (do (set! (mut digits) n (cast u8 d)) (set! n (+ n 1)))
                    :else
                      (let [up (cond (and low (not high)) false
                                     (and high (not low)) true
                                     :else (let [twice (fsh-add r r) c (fsh-cmp twice s)]
                                             (or (> c 0) (and (= c 0) (= (% d 2) 1)))))]
                        (set! (mut digits) n (cast u8 (if up (+ d 1) d)))
                        (set! n (+ n 1))
                        (set! done true))))))
        [n k]))))

;;; Write `digits[0..n)` with decimal exponent `k` (value 0.d1d2... * 10^k):
;;; positional for 1e-5 <= |v| < 1e16, else d.ddd e±N. Always has a `.` or an
;;; exponent, so the text reads back as a float.
(defn fsh-write [(w (ptr Writer)) (digits (array u8 20)) (n i64) (k i64)] (-> (Result i64 IoError))
  (do
    (cond (and (> k 0) (<= k 16))
            (do
              (for i (range 0 k)
                (write-byte w (cast u8 (+ 48 (if (< i n) (cast i64 (get digits i)) 0)))))
              (write-byte w (cast u8 46))
              (if (> n k)
                  (for i (range k n) (write-byte w (cast u8 (+ 48 (cast i64 (get digits i))))))
                  (write-byte w (cast u8 48)))
              (Ok 0))
          (and (<= k 0) (> k -4))
            (do
              (print-str w "0.")
              (for _ (range 0 (- 0 k)) (write-byte w (cast u8 48)))
              (for i (range 0 n) (write-byte w (cast u8 (+ 48 (cast i64 (get digits i))))))
              (Ok 0))
          :else
            (do
              (write-byte w (cast u8 (+ 48 (cast i64 (get digits 0)))))
              (write-byte w (cast u8 46))
              (if (> n 1)
                  (for i (range 1 n) (write-byte w (cast u8 (+ 48 (cast i64 (get digits i))))))
                  (write-byte w (cast u8 48)))
              (write-byte w (cast u8 101))
              (print-int w (- k 1))))))

;;; `x` as the shortest decimal text that reads back as exactly `x`: `0.1`,
;;; `100.0`, `1.5e-7`, `1.0e21`. NaN and infinities print as `NaN`, `inf`,
;;; `-inf`, which are not float literals.
(defn write-f64-shortest [(w (ptr Writer)) (x f64)] (-> (Result i64 IoError))
  (let [(mut v) x
        bits (load (cast (ptr u64) (mut v)))
        negative (!= (>> bits 63) 0)
        biased (cast i64 (& (>> bits 52) 2047))
        fraction (& bits 4503599627370495)]
    (when negative (write-byte w (cast u8 45)))
    (cond (= biased 2047) (print-str w (if (= fraction 0) "inf" "NaN"))
          (and (= biased 0) (= fraction 0)) (print-str w "0.0")
          :else
            (let [(mut digits) (zeroed (array u8 20))
                  mantissa (if (= biased 0) fraction (| fraction 4503599627370496))
                  exp2 (if (= biased 0) -1074 (- biased 1075))
                  nk (fsh-digits mantissa exp2 (and (= fraction 0) (> biased 1)) (mut digits))]
              (fsh-write w digits (get nk 0) (get nk 1))))))

;;; The f32 counterpart: the shortest text that reads back as this f32.
(defn write-f32-shortest [(w (ptr Writer)) (x f32)] (-> (Result i64 IoError))
  (let [(mut v) x
        bits (cast u64 (load (cast (ptr u32) (mut v))))
        negative (!= (>> bits 31) 0)
        biased (cast i64 (& (>> bits 23) 255))
        fraction (& bits 8388607)]
    (when negative (write-byte w (cast u8 45)))
    (cond (= biased 255) (print-str w (if (= fraction 0) "inf" "NaN"))
          (and (= biased 0) (= fraction 0)) (print-str w "0.0")
          :else
            (let [(mut digits) (zeroed (array u8 20))
                  mantissa (if (= biased 0) fraction (| fraction 8388608))
                  exp2 (if (= biased 0) -149 (- biased 150))
                  nk (fsh-digits mantissa exp2 (and (= fraction 0) (> biased 1)) (mut digits))]
              (fsh-write w digits (get nk 0) (get nk 1))))))
