;;; RISC-V machine operations for RV32: control and status registers, `wfi`,
;;; `mret`, and handing a reset entry to its runtime. Each is a machine-code
;;; function under the C convention, and this module encodes its instructions
;;; as it is compiled; none of them is built into the compiler. Each names
;;; `(Riscv32)` as its architecture, so a build for another one refuses the
;;; module where it is checked.
(module coil.arch.riscv)
(import "coil.primitive" :as primitive)

; ---- instruction encoding, run while this module expands ----

; An I-type instruction: the CSR instructions and `addi`/`jalr`.
(defn i-type [(imm i64) (rs1 i64) (funct3 i64) (rd i64) (opcode i64)] (-> i64)
  (| (<< (& imm 4095) 20)
     (| (<< rs1 15) (| (<< funct3 12) (| (<< rd 7) opcode)))))

; One 32-bit instruction's bytes, least significant first.
(defn push-instruction! [(out CodeBuilder) (word i64)] (-> i64)
  (for k (range 0 4)
    (primitive/code-list-push! out `~(& (>> word (* k 8)) 255)))
  0)

;;; `(defcsr NAME NUMBER)` defines `read-NAME`, the CSR's value (`csrr a0`),
;;; and `write-NAME!`, which replaces it (`csrw`). `(defcsr NAME NUMBER
;;; :read-only)` defines only the reader.
(defn defcsr [(name Code) (number Code) & (options Code)] (-> Code)
  (if (not (primitive/code-int? number))
      (primitive/error "defcsr: NUMBER must be an integer literal")
      0)
  (let [csr (primitive/code-int number)
        writable
          (cond (= (primitive/code-count options) 0) true
                (and (= (primitive/code-count options) 1)
                     (= (primitive/code-nth options 0) `:read-only))
                  false
                :else
                  (do
                    (primitive/error "defcsr: expected NAME NUMBER, optionally followed by :read-only")
                    false))
        reader (primitive/syntax->datum (primitive/code-symbol "read-" name))
        writer
          (primitive/syntax->datum (primitive/code-symbol (primitive/code-symbol "write-"
                                                                                 name)
                                                          "!"))
        read-bytes (primitive/code-list-new)
        write-bytes (primitive/code-list-new)]
    (if (or (< csr 0) (> csr 4095))
        (primitive/error "defcsr: a CSR number is 12 bits")
        0)
    ; csrrs a0, csr, x0
    (push-instruction! read-bytes (i-type csr 0 2 10 115))
    ; csrrw x0, csr, a0
    (push-instruction! write-bytes (i-type csr 10 1 0 115))
    `(do
       (defn ~reader :cc c [] (-> u32)
         (primitive/machine-code (Riscv32)
                                 ~@(primitive/code-list-done read-bytes)))
       ~@(if writable
             `((defn ~writer :cc c [(value u32)] (-> void)
                 (primitive/machine-code (Riscv32)
                                         ~@(primitive/code-list-done write-bytes))))
             `()))))

; ---- machine-mode CSRs ----

(defcsr mstatus 0x300)
(defcsr misa 0x301)
(defcsr mie 0x304)
(defcsr mtvec 0x305)
(defcsr mscratch 0x340)
(defcsr mepc 0x341)
(defcsr mcause 0x342)
(defcsr mtval 0x343)
(defcsr mip 0x344)
(defcsr cycle 0xc00 :read-only)
(defcsr time 0xc01 :read-only)
(defcsr instret 0xc02 :read-only)
(defcsr mhartid 0xf14 :read-only)

; ---- privileged instructions ----

;;; Wait for an interrupt (`wfi`). The hart may also resume without one.
(defn wfi! :cc c [] (-> void)
  ; wfi
  (primitive/machine-code (Riscv32) 0x73 0x00 0x50 0x10))

;;; Return from a machine-mode trap (`mret`): to `mepc`, with the privilege and
;;; interrupt enable that `mstatus` saved.
(defn mret! :cc c [] (-> never)
  ; mret
  (primitive/machine-code (Riscv32) 0x73 0x00 0x20 0x30))

;;; Leave reset code for good: set the stack pointer and the global pointer, then
;;; jump to ENTRY. Call it last from a `reset` function, whose own frame is on
;;; the stack it abandons.
(defn enter! :cc c [(stack (ptr u8))
                    (global-pointer (ptr u8))
                    (entry (fnptr c [] never))] (-> never)
  ; mv sp, a0 ; mv gp, a1 ; jr a2
  (primitive/machine-code (Riscv32)
                          0x13 0x01 0x05 0x00
                          0x93 0x81 0x05 0x00
                          0x67 0x00 0x06 0x00))
