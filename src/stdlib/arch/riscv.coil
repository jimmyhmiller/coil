;;; RISC-V machine operations for RV32: control and status registers, `wfi`,
;;; `mret`, and handing a reset entry to its runtime. Each is a machine-code
;;; function, and this module encodes its instructions as it is compiled; none
;;; of them is built into the compiler. Each names `(Riscv32)` as its
;;; architecture, so a build for another one refuses the module where it is
;;; checked.
;;;
;;; The CSR operations, `wfi!` and `mret!` are inlined: their callers hold the
;;; instruction itself, not a call to it.
(module coil.arch.riscv)
(import "coil.primitive" :as primitive)
(import "coil.cc" :as cc)

;;; The contract of an inlined read: its result is left in a0, and it changes
;;; no other register.
(defcc machine-read :params [] :ret a0 :clobber [] :lower (cc/Shim))

;;; The contract of an inlined operation with no result: its argument, if it
;;; has one, is in a0, and it changes no register.
(defcc machine-op :params [a0] :clobber [] :lower (cc/Shim))

; ---- instruction encoding, run while this module expands ----

; An I-type instruction: the CSR instructions and `addi`/`jalr`.
(defn i-type [(imm i64) (rs1 i64) (funct3 i64) (rd i64) (opcode i64)] (-> i64)
  (| (<< (& imm 4095) 20)
     (| (<< rs1 15) (| (<< funct3 12) (| (<< rd 7) opcode)))))

; One 32-bit instruction's bytes, least significant first.
(defn push-instruction! [(out CodeBuilder) (word i64)] (-> i64)
  (for k (range 0 4)
    (primitive/code-list-push! out `~(& (>> word (* k 8)) 255)))
  0)

;;; `(defcsr NAME NUMBER)` defines `read-NAME`, the CSR's value (`csrr`);
;;; `write-NAME!`, which replaces it (`csrw`); and `set-NAME!` and
;;; `clear-NAME!`, which set and clear the bits of a mask in it (`csrs`, `csrc`)
;;; as one instruction, so an interrupt cannot land between a read and a write.
;;; `(defcsr NAME NUMBER :read-only)` defines only the reader.
;;;
;;; `(defcsr NAME NUMBER :masks [(FIELD MASK) …])` also defines, for each named
;;; mask, `set-NAME-FIELD!` and `clear-NAME-FIELD!`. A mask of at most 31 is
;;; the instruction's own operand (`csrsi`, `csrci`), so the operation is one
;;; instruction; a larger one is loaded into a0 for `set-NAME!` or
;;; `clear-NAME!`.
(defn defcsr [(name Code) (number Code) & (options Code)] (-> Code)
  (if (not (primitive/code-int? number))
      (primitive/error "defcsr: NUMBER must be an integer literal")
      0)
  ; the definitions land in the module that calls defcsr, so they name this
  ; module's conventions in full
  (let [csr (primitive/code-int number)
        n (primitive/code-count options)
        (mut writable) true
        (mut masks) `[]
        (mut i) 0]
    (loop (if (>= i n)
              (break)
              (let [option (primitive/code-nth options i)]
                (cond (= option `:read-only)
                        (do (set! writable false) (set! i (+ i 1)))
                      (and (= option `:masks) (< (+ i 1) n))
                        (do (set! masks (primitive/code-nth options (+ i 1))) (set! i (+ i 2)))
                      :else
                        (do
                          (primitive/error "defcsr: expected NAME NUMBER, then :read-only or :masks [(FIELD MASK) …]")
                          (break))))))
    (if (not (primitive/code-vector? masks))
        (primitive/error "defcsr: :masks takes a vector of (FIELD MASK)")
        0)
    (if (and (not writable) (> (primitive/code-count masks) 0))
        (primitive/error "defcsr: a :read-only CSR has no bits to set or clear, so it takes no :masks")
        0)
    (if (or (< csr 0) (> csr 4095))
        (primitive/error "defcsr: a CSR number is 12 bits")
        0)
    (let [reader (primitive/syntax->datum (primitive/code-symbol "read-" name))
          writer (primitive/syntax->datum (primitive/code-symbol "write-" name "!"))
          setter (primitive/syntax->datum (primitive/code-symbol "set-" name "!"))
          clearer (primitive/syntax->datum (primitive/code-symbol "clear-" name "!"))
          read-bytes (primitive/code-list-new)
          write-bytes (primitive/code-list-new)
          set-bytes (primitive/code-list-new)
          clear-bytes (primitive/code-list-new)
          mask-defns (primitive/code-list-new)]
      ; csrrs a0, csr, x0
      (push-instruction! read-bytes (i-type csr 0 2 10 115))
      ; csrrw x0, csr, a0
      (push-instruction! write-bytes (i-type csr 10 1 0 115))
      ; csrrs x0, csr, a0
      (push-instruction! set-bytes (i-type csr 10 2 0 115))
      ; csrrc x0, csr, a0
      (push-instruction! clear-bytes (i-type csr 10 3 0 115))
      (for k (range 0 (primitive/code-count masks))
        (let [entry (primitive/code-nth masks k)]
          (if (not (and (primitive/code-list? entry)
                        (= (primitive/code-count entry) 2)
                        (primitive/code-sym? (primitive/code-nth entry 0))
                        (primitive/code-int? (primitive/code-nth entry 1))))
              (primitive/error "defcsr: each of :masks is (FIELD MASK), a name and an integer literal")
              0)
          (let [field (primitive/code-nth entry 0)
                mask (primitive/code-nth entry 1)
                bits (primitive/code-int mask)
                set-field (primitive/syntax->datum (primitive/code-symbol "set-" name "-" field "!"))
                clear-field (primitive/syntax->datum (primitive/code-symbol "clear-" name "-" field "!"))]
            (if (or (< bits 1) (> bits 0xffffffff))
                (primitive/error "defcsr: a mask is a nonzero 32-bit value")
                0)
            (if (<= bits 31)
                (let [set-bytes (primitive/code-list-new)
                      clear-bytes (primitive/code-list-new)]
                  ; csrrsi x0, csr, bits
                  (push-instruction! set-bytes (i-type csr bits 6 0 115))
                  ; csrrci x0, csr, bits
                  (push-instruction! clear-bytes (i-type csr bits 7 0 115))
                  (primitive/code-list-push! mask-defns
                                             `(defn ~set-field :cc coil.arch.riscv.machine-op :inline (Always) [] (-> void)
                                                (primitive/machine-code (Riscv32)
                                                                        ~@(primitive/code-list-done set-bytes))))
                  (primitive/code-list-push! mask-defns
                                             `(defn ~clear-field :cc coil.arch.riscv.machine-op :inline (Always) [] (-> void)
                                                (primitive/machine-code (Riscv32)
                                                                        ~@(primitive/code-list-done clear-bytes))))
                  0)
                (do
                  (primitive/code-list-push! mask-defns
                                             `(defn ~set-field :inline (Always) [] (-> void)
                                                (~setter (: ~mask u32))))
                  (primitive/code-list-push! mask-defns
                                             `(defn ~clear-field :inline (Always) [] (-> void)
                                                (~clearer (: ~mask u32))))
                  0)))))
      `(do
         (defn ~reader :cc coil.arch.riscv.machine-read :inline (Always) [] (-> u32)
           (primitive/machine-code (Riscv32)
                                   ~@(primitive/code-list-done read-bytes)))
         ~@(if writable
               `((defn ~writer :cc coil.arch.riscv.machine-op :inline (Always) [(value u32)] (-> void)
                   (primitive/machine-code (Riscv32)
                                           ~@(primitive/code-list-done write-bytes)))
                 (defn ~setter :cc coil.arch.riscv.machine-op :inline (Always) [(mask u32)] (-> void)
                   (primitive/machine-code (Riscv32)
                                           ~@(primitive/code-list-done set-bytes)))
                 (defn ~clearer :cc coil.arch.riscv.machine-op :inline (Always) [(mask u32)] (-> void)
                   (primitive/machine-code (Riscv32)
                                           ~@(primitive/code-list-done clear-bytes))))
               `())
         ~@(primitive/code-list-done mask-defns)))))

; ---- machine-mode CSRs ----

;;; `mstatus`'s fields: the interrupt enables of machine and supervisor mode, the
;;; enables and privilege a trap saved, the floating-point state, and the
;;; memory-access and trap controls.
(defcsr mstatus 0x300 :masks [(sie 0x2)
                              (mie 0x8)
                              (spie 0x20)
                              (mpie 0x80)
                              (spp 0x100)
                              (mpp 0x1800)
                              (fs 0x6000)
                              (mprv 0x20000)
                              (sum 0x40000)
                              (mxr 0x80000)
                              (tw 0x200000)])
(defcsr misa 0x301)
;;; `mie`'s enables of the software, timer and external interrupts.
(defcsr mie 0x304 :masks [(ssie 0x2) (msie 0x8) (stie 0x20) (mtie 0x80) (seie 0x200) (meie 0x800)])
(defcsr mtvec 0x305)
(defcsr mscratch 0x340)
(defcsr mepc 0x341)
(defcsr mcause 0x342)
(defcsr mtval 0x343)
;;; `mip`'s pending bits, in the same places as `mie`'s enables.
(defcsr mip 0x344 :masks [(ssip 0x2) (msip 0x8) (stip 0x20) (mtip 0x80) (seip 0x200) (meip 0x800)])
(defcsr cycle 0xc00 :read-only)
(defcsr time 0xc01 :read-only)
(defcsr instret 0xc02 :read-only)
(defcsr mhartid 0xf14 :read-only)

; ---- privileged instructions ----

;;; Wait for an interrupt (`wfi`). The hart may also resume without one.
(defn wfi! :cc machine-op :inline (Always) [] (-> void)
  ; wfi
  (primitive/machine-code (Riscv32) 0x73 0x00 0x50 0x10))

;;; Return from a machine-mode trap (`mret`): to `mepc`, with the privilege and
;;; interrupt enable that `mstatus` saved.
(defn mret! :cc machine-op :inline (Always) [] (-> never)
  ; mret
  (primitive/machine-code (Riscv32) 0x73 0x00 0x20 0x30))

;;; Leave reset code for good: set the stack pointer and the global pointer, then
;;; jump to ENTRY. Call it last from a `reset` function, whose own frame is on
;;; the stack it abandons.
(defn enter! :cc c [(stack (ptr u8))
                    (global-pointer (ptr u8))
                    (entry (fnptr c [] never))] (-> never)
  ; mv sp, a0 ; mv gp, a1 ; jr a2
  (primitive/machine-code (Riscv32)
                          0x13 0x01 0x05 0x00
                          0x93 0x81 0x05 0x00
                          0x67 0x00 0x06 0x00))
