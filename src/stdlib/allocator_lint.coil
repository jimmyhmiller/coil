(module coil.lint.allocator)
(import "coil.primitive" :as primitive)

;; High-confidence allocator-composition lint. It uses resolved declarations, so
;; aliases and renamed imports are handled without matching source spellings.

(defn al-code-list-head? [(x Code) (head Code)] (-> bool)
  (and (primitive/code-list? x)
       (and (> (primitive/code-count x) 0)
            (primitive/code-eq (primitive/code-nth x 0) head))))

(defn al-fn-decl? [(decl Code)] (-> bool)
  (and (primitive/code-list? decl)
       (and (= (primitive/code-count decl) 6)
            (and (primitive/code-eq (primitive/code-nth decl 0) `decl)
                 (primitive/code-eq (primitive/code-nth decl 2) `fn)))))

(defn al-region-fn-arity? [(call Code) (arity i64)] (-> bool)
  (let [decl (primitive/code-decl call)]
    (and (al-fn-decl? decl)
         (and (primitive/code-eq (primitive/code-nth decl 1) `coil.region)
              (let [params (primitive/code-nth decl 4)]
                (and (primitive/code-list? params)
                     (= (primitive/code-count params) arity)))))))

;; At a typechecked allocator argument, the only one-argument coil.region function that
;; can appear here is region-allocator. region-closed? returns bool and is rejected by
;; the ordinary checker before this policy pass runs.
(defn al-region-allocator-call? [(form Code)] (-> bool)
  (and (primitive/code-list? form)
       (and (= (primitive/code-count form) 2)
            (al-region-fn-arity? form 1))))

(defn al-warn-nested-region [(parent Code)] (-> i64)
  (primitive/warn parent
                  "Region is backed by another Region allocator; use a root allocator for the child or ScratchArena marks for nested scratch lifetimes")
  0)

(defn al-walk [(form Code)] (-> i64)
  (if (primitive/code-list? form)
      (let [n (primitive/code-count form)]
        (do
          ;; region-init has two parameters and region-new has one. Typechecking plus
          ;; the coil.region declaration owner makes these cases unambiguous.
          (if (and (= n 3) (al-region-fn-arity? form 2))
              (let [parent (primitive/code-nth form 2)]
                (if (al-region-allocator-call? parent) (al-warn-nested-region parent) 0))
              (if (and (= n 2) (al-region-fn-arity? form 1))
                  (let [parent (primitive/code-nth form 1)]
                    (if (al-region-allocator-call? parent) (al-warn-nested-region parent) 0))
                  0))
          (al-walk-kids form 0 n)))
      0))

(defn al-walk-kids [(form Code) (i i64) (n i64)] (-> i64)
  (if (>= i n)
      0
      (do
        (al-walk (primitive/code-nth form i))
        (al-walk-kids form (+ i 1) n))))

(defn al-module [(m Code) (i i64) (n i64)] (-> i64)
  (if (>= i n)
      0
      (do
        (let [form (primitive/code-nth m i)]
          (if (primitive/code-from-user? form) (al-walk form) 0))
        (al-module m (+ i 1) n))))

(defn al-modules [(modules Code) (i i64) (n i64)] (-> i64)
  (if (>= i n)
      0
      (let [m (primitive/code-nth modules i)]
        (do
          (al-module m 1 (primitive/code-count m))
          (al-modules modules (+ i 1) n)))))

(defn allocator-lint [(modules Code)] (-> Code)
  (do (al-modules modules 0 (primitive/code-count modules)) `0))

(checker allocator-lint)
