(module coil.match)
(import "coil.primitive" :as primitive)
(import "coil.slice" :use [slice-len slice-get subslice])
; `(match-else scrut (V1 [..] body) … (_ default))` — a `match` with a CATCH-ALL
; arm, as a pure-LIBRARY MACRO over the comptime reflection bridge (no compiler
; `_` support). It infers the sum from the first explicit arm's variant name
; (code-variant-sum), enumerates the sum's variants (code-variant-*), and expands
; `_` into an explicit arm for each NOT-yet-covered variant (with gensym'd field
; binds the default ignores). Stage-3: macros are ordinary [Code…] -> Code fns.
;
;   (match-else j (JNum [n] n) (_ 0))   ; the other Json variants -> 0
;
; ⚠ Macro bodies here use METAL comparisons (primitive/icmp-*): the tower's
; pruned staging closure carries no trait impls, so clean `=` in a macro body
; makes it unstageable inside other macro bodies (templates are unaffected).

;; all but the last element of a list
(defn me--butlast [(xs Code) (i i64)] (-> Code)
  (if (primitive/icmp-eq i (primitive/isub (primitive/code-count xs) 1)) `()
    `(~(primitive/code-nth xs i) ~@(me--butlast xs (primitive/iadd i 1)))))

;; the `_` arm's body: (_ b) -> b ; (_ b1 b2 …) -> (do b1 b2 …)
(defn me--wild-body [(wild Code)] (-> Code)
  (let [b (primitive/code-rest wild)]
    (if (primitive/icmp-eq (primitive/code-count b) 1) (primitive/code-nth b 0) `(do ~@b))))

;; The unqualified tail of a name: `coil.socket.Closed` and `socket/Closed` both give
;; `Closed`. An explicit arm carries whatever spelling the AUTHOR used, while
;; `code-variant-name` always hands back the bare name, so comparing them directly
;; reported every alias-qualified arm as uncovered and re-emitted it — a duplicate arm
;; for a variant the author had just written out.
;; Metal ops only: this is a macro-body helper, and the tower's pruned staging closure
;; carries no trait impls (see the header note).
(defn me--tail [(s (slice u8))] (-> (slice u8))
  (let [n (slice-len s)
        (mut i) (primitive/isub n 1)
        (mut at) -1]
    (loop (if (primitive/icmp-lt (load i) 0)
              (break)
              (do
                (let [c (primitive/cast i64 (slice-get s (load i)))]
                  (when (or (primitive/icmp-eq c 46) (primitive/icmp-eq c 47))
                        (store! at (load i))
                        (break)))
                (store! i (primitive/isub (load i) 1)))))
    (if (primitive/icmp-lt (load at) 0) s (subslice s (primitive/iadd (load at) 1) n))))

(defn me--streq [(a (slice u8)) (b (slice u8))] (-> bool)
  (if (primitive/icmp-ne (slice-len a) (slice-len b)) false
    (me--streq-at a b 0)))
(defn me--streq-at [(a (slice u8)) (b (slice u8)) (i i64)] (-> bool)
  (if (primitive/icmp-eq i (slice-len a)) true
    (if (primitive/icmp-ne (primitive/cast i64 (slice-get a i)) (primitive/cast i64 (slice-get b i))) false
      (me--streq-at a b (primitive/iadd i 1)))))

;; is `vname` the variant of one of the explicit arms? compared on the unqualified tail
(defn me--covered? [(explicit Code) (vname Code) (i i64)] (-> bool)
  (if (primitive/icmp-eq i (primitive/code-count explicit)) false
    (if (me--streq (me--tail (primitive/code-sym (primitive/code-nth (primitive/code-nth explicit i) 0)))
                   (me--tail (primitive/code-sym vname)))
        true
      (me--covered? explicit vname (primitive/iadd i 1)))))

;; n fresh bind names as a list (the default ignores them)
(defn me--genbinds [(n i64)] (-> Code)
  (if (primitive/icmp-eq n 0) `() `(~(primitive/gensym) ~@(me--genbinds (primitive/isub n 1)))))

;; an arm `(Vname [binds] default)` for each variant of `sum` not already covered
(defn me--uncovered [(sum Code) (explicit Code) (default Code) (i i64)] (-> Code)
  (if (primitive/icmp-eq i (primitive/code-variant-count sum)) `()
    (let [vname (primitive/code-variant-name sum i)]
      (if (me--covered? explicit vname 0)
          (me--uncovered sum explicit default (primitive/iadd i 1))
          ; the FULLY-QUALIFIED name in the emitted arm: generated code must not depend
          ; on how the CALLER imported the sum. With the bare name this expansion only
          ; resolved where the sum happened to be imported unqualified, so
          ; `(match-else e (socket/Closed [] 1) (_ 0))` produced arms naming variants
          ; the resolver could not place. `code-variant-name` stays bare for the
          ; coverage comparison below, which is matched against the author's spelling.
          `((~(primitive/code-variant-qname sum i)
             [~@(me--genbinds (primitive/code-variant-fields sum i))] ~default)
            ~@(me--uncovered sum explicit default (primitive/iadd i 1)))))))

(defn match-else [(scrut Code) & (arms Code)] (-> Code)
  (let [n        (primitive/code-count arms)
        wild     (primitive/code-nth arms (primitive/isub n 1))
        explicit (me--butlast arms 0)]
    (if (not (primitive/code-eq (primitive/code-nth wild 0) `_))
        (primitive/error "match-else: the last arm must be (_ default)")
      (if (primitive/icmp-eq (primitive/code-count explicit) 0)
          (primitive/error "match-else: needs at least one explicit variant arm (to infer the sum)")
        (let [default (me--wild-body wild)
              sum     (primitive/code-variant-sum (primitive/code-nth (primitive/code-nth explicit 0) 0))]
          `(match ~scrut ~@explicit ~@(me--uncovered sum explicit default 0)))))))
