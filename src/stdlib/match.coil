(module coil.match)
(import "coil.primitive" :as primitive)
;;; DEPRECATED — use `match` with a `(_ …)` arm.
;;;
;;; `match-else` existed because `match` had no catch-all: this macro inferred the sum
;;; from the first arm by comptime reflection, enumerated its variants, and expanded
;;; `(_ default)` into one explicit arm per uncovered variant — copying `default` into
;;; every one of them. `match` now understands `(_ …)` natively (the checker counts it as
;;; covering whatever the explicit arms left out, and every backend emits it as the
;;; fallthrough), so all of that is gone and the macro is a forwarder that only exists to
;;; keep old source compiling.
;;;
;;;     (match j (JNum [n] n) (_ 0))      ; the other Json variants -> 0
;;;
;;; `coil lint FILE --use coil.lint.match-else --fix` rewrites every call.
(defn match-else [(scrut Code) & (arms Code)] (-> Code)
  `(match ~scrut ~@arms))
