; Strict HTTP/1.x server-side request parsing backed by llhttp. Method, target,
; and headers are zero-copy views into the input; the decoded body is owned by
; the request so chunked transfer encoding has the same API as Content-Length.
(module coil.http.server)
(import "coil.primitive" :as primitive)
(import "coil.alloc" :as alloc)
(import "coil.arraylist" :as arraylist)
(import "coil.slice" :as slice)
(import "coil.str" :as str)
(import "coil.http.parser"
        :as
        ll
        :use
        [HTTP_REQUEST HPE_OK HPE_INVALID_EOF_STATE HPE_PAUSED HPE_USER])
(import "coil.http.parser.types" :as lltypes)
(import "coil.fmt" :use [fmt Display display-fmt Formatter formatter-writer])

(export Header
        Request
        Error
        HTTP_ERROR_LIMIT
        HTTP_MAX_HEADERS
        HTTP_MAX_HEADER_BYTES
        HTTP_MAX_BODY_BYTES
        RequestParser
        request-parser-init!
        request-parser-feed!
        request-parser-free!
        limit-exceeded?
        parse-request
        request-free
        header-count
        header-at
        header
        method-is
        keep-alive?
        method
        target
        version
        body
        consumed
        error-offset
        error-code)

(defstruct Header [(name (slice u8)) (value (slice u8))])

(defstruct Request
  [(method (slice u8))
   (target (slice u8))
   (version (slice u8))
   (headers (arraylist/ArrayList Header))
   (body (slice u8))
   (consumed i64)
   (keep-alive bool)
   (allocator (dyn alloc/Allocator))])

(defstruct Error [(offset i64) (code i64)])

;;; Most headers a request may carry.
(const HTTP_MAX_HEADERS 100)

;;; Most bytes of header names and values together.
(const HTTP_MAX_HEADER_BYTES 65536)

;;; Most bytes of decoded body.
(const HTTP_MAX_BODY_BYTES 8388608)

;;; The `Error` code of a request that exceeded one of the limits above; codes
;;; below it are llhttp's errno values.
(const HTTP_ERROR_LIMIT 1000)

(defstruct ParseContext
  [(allocator (dyn alloc/Allocator))
   ; where the bytes being parsed start: the spans below are offsets from it, so
   ; they survive a caller's buffer growing (and moving) between feeds
   (base (ptr u8))
   (spans (arraylist/ArrayList HeaderSpan))
   (body str/StrBuf)
   (method-start i64)
   (method-len i64)
   (target-start i64)
   (target-len i64)
   (header-name-start i64)
   (header-name-len i64)
   (header-value-start i64)
   (header-value-len i64)
   (header-bytes i64)
   (keep-alive bool)
   (complete bool)
   (error-code i64)])

;;; A header's name and value, as offsets into the buffer being parsed.
(defstruct HeaderSpan [(name-start i64) (name-len i64) (value-start i64) (value-len i64)])

(defn context-of [(p (ptr lltypes/Parser))] (-> (ptr ParseContext))
  (primitive/cast (ptr ParseContext) (load (field p data))))

;;; Extend the span at `start`/`total` by `len` bytes at `at`. llhttp reports a span
;;; once per feed it crosses, and the pieces are adjacent in the caller's buffer.
(defn append-span! [(c (ptr ParseContext))
                    (start (ptr i64))
                    (total (ptr i64))
                    (at (ptr u8))
                    (len i64)] (-> i64)
  (when (< (load start) 0)
    (store! start (primitive/isub (primitive/cast i64 at) (primitive/cast i64 (.base c)))))
  (store! total (primitive/iadd (load total) len))
  0)

(defn server-on-method [(p (ptr lltypes/Parser)) (at (ptr u8)) (len i64)] (-> i64)
  (let [c (context-of p)]
    (append-span! c (field c method-start) (field c method-len) at len)))

(defn server-on-url [(p (ptr lltypes/Parser)) (at (ptr u8)) (len i64)] (-> i64)
  (let [c (context-of p)]
    (append-span! c (field c target-start) (field c target-len) at len)))

(defn server-on-header-field [(p (ptr lltypes/Parser)) (at (ptr u8)) (size i64)] (-> i64)
  (let [c (context-of p)
        bytes (primitive/iadd (load (field c header-bytes)) size)]
    (if (or (>= (len (field c spans)) HTTP_MAX_HEADERS)
            (> bytes HTTP_MAX_HEADER_BYTES))
        (do (store! (field c error-code) HTTP_ERROR_LIMIT) HPE_USER)
        (do
          (store! (field c header-bytes) bytes)
          (append-span! c (field c header-name-start) (field c header-name-len) at size)))))

(defn server-on-header-value [(p (ptr lltypes/Parser)) (at (ptr u8)) (len i64)] (-> i64)
  (let [c (context-of p)
        bytes (primitive/iadd (load (field c header-bytes)) len)]
    (if (> bytes HTTP_MAX_HEADER_BYTES)
        (do (store! (field c error-code) HTTP_ERROR_LIMIT) HPE_USER)
        (do
          (store! (field c header-bytes) bytes)
          (append-span! c (field c header-value-start) (field c header-value-len) at len)))))

(defn server-on-header-value-complete [(p (ptr lltypes/Parser))] (-> i64)
  (let [c (context-of p)]
    (if (>= (len (field c spans)) HTTP_MAX_HEADERS)
        (do (store! (field c error-code) HTTP_ERROR_LIMIT) HPE_USER)
        (do
          (push! (mut (field c spans))
                 (HeaderSpan :name-start (.header-name-start c)
                             :name-len (.header-name-len c)
                             :value-start (if (< (.header-value-start c) 0) 0 (.header-value-start c))
                             :value-len (.header-value-len c)))
          (store! (field c header-name-start) -1)
          (store! (field c header-name-len) 0)
          (store! (field c header-value-start) -1)
          (store! (field c header-value-len) 0)
          0))))

(defn server-on-body [(p (ptr lltypes/Parser)) (at (ptr u8)) (size i64)] (-> i64)
  (let [c (context-of p)
        current (len (str/sb-str (load (field c body))))]
    (if (> (primitive/iadd current size) HTTP_MAX_BODY_BYTES)
        (do (store! (field c error-code) HTTP_ERROR_LIMIT) HPE_USER)
        (do
          (str/sb-push-str! (mut (field c body)) (slice::new [u8] at size))
          0))))

(defn server-on-headers-complete [(p (ptr lltypes/Parser))] (-> i64)
  (store! (field (context-of p) keep-alive) (ll/should-keep-alive? p))
  0)

(defn server-on-message-complete [(p (ptr lltypes/Parser))] (-> i64)
  (store! (field (context-of p) complete) true)
  HPE_PAUSED)

(defn http-ascii-lower [(c i64)] (-> i64)
  (if (and (>= c (cast i64 \A)) (<= c (cast i64 \Z))) (primitive/iadd c 32) c))

(defn http-ci-eq [(a (slice u8)) (b (slice u8))] (-> bool)
  (if (!= (len a) (len b))
      false
      (let [(mut i) 0
            (mut same) true]
        (loop (if (>= (load i) (len a))
                  (break)
                  (if (= (http-ascii-lower (primitive/cast i64
                                                           (get a
                                                                (load i))))
                         (http-ascii-lower (primitive/cast i64
                                                           (get b
                                                                (load i)))))
                      (store! i (primitive/iadd (load i) 1))
                      (do (store! same false) (break)))))
        (load same))))

(defn header-count [(r Request)] (-> i64)
  (len (field r headers)))

(defn header-at [(r Request) (i i64)] (-> Header)
  (get (load (field r headers)) i))

;;; Case-insensitive header lookup. Returns an empty slice when absent.
(defn header [(r Request) (name (slice u8))] (-> (slice u8))
  (let [(mut i) 0
        (mut value) ""]
    (loop (if (>= (load i) (header-count r))
              (break)
              (let [h (header-at r (load i))]
                (if (http-ci-eq (load (field h name)) name)
                    (do (store! value (load (field h value))) (break))
                    (store! i (primitive/iadd (load i) 1))))))
    (load value)))

;;; The version on the request line. Without LENIENT_VERSION (which parse-request
;;; never sets) llhttp accepts exactly HTTP/0.9, HTTP/1.0, HTTP/1.1 and HTTP/2.0.
(defn http-version [(parser (ptr lltypes/Parser))] (-> (slice u8))
  (let [major (ll/get-http-major parser)
        minor (ll/get-http-minor parser)]
    (cond (and (= major (cast i64 0)) (= minor (cast i64 9))) "HTTP/0.9"
          (and (= major (cast i64 1)) (= minor (cast i64 0))) "HTTP/1.0"
          (and (= major (cast i64 1)) (= minor (cast i64 1))) "HTTP/1.1"
          (and (= major (cast i64 2)) (= minor (cast i64 0))) "HTTP/2.0"
          :else (unreachable-version major minor))))

(extern abort :cc c [] (-> void))

;;; A version the strict parser rejects reached a completed request.
(defn unreachable-version [(major i64) (minor i64)] (-> (slice u8))
  (println "coil.http.server: llhttp accepted HTTP/{}.{}, which strict mode rejects"
           major
           minor)
  (abort)
  "")

;;; An incremental request parser. Feed it the request's bytes as they arrive,
;;; with `request-parser-feed!`, and each feed parses only what it has not seen;
;;; parsing a request read in many pieces costs what parsing it whole does. The
;;; struct holds no pointer into itself between calls, so it may be moved.
(defstruct RequestParser
  [(parser lltypes/Parser)
   (settings lltypes/Settings)
   (context ParseContext)
   ; how many bytes of the caller's buffer have been parsed
   (fed i64)
   ; true once a request or an error came out: its parts are the caller's now
   (done bool)])

;;; Prepare `p` to parse one request, allocating its decoded body and header table
;;; from `a`.
(defn request-parser-init! [(p (ptr RequestParser)) (a (dyn alloc/Allocator))] (-> i64)
  (let [(mut initial) (primitive/zeroed ParseContext)]
    (store! (field initial allocator) a)
    (store! (field initial spans) (arraylist/ArrayList::new [HeaderSpan] a))
    (store! (field initial body) (str/sb-new a))
    (store! (field initial method-start) -1)
    (store! (field initial target-start) -1)
    (store! (field initial header-name-start) -1)
    (store! (field initial header-value-start) -1)
    (store! (field p context) (load initial)))
  (let [settings (field p settings)]
    (ll/settings-init settings)
    (ll/set-span-callback! settings 4 (primitive/fnptr-of server-on-method))
    (ll/set-span-callback! settings 2 (primitive/fnptr-of server-on-url))
    (ll/set-span-callback! settings 6 (primitive/fnptr-of server-on-header-field))
    (ll/set-span-callback! settings 7 (primitive/fnptr-of server-on-header-value))
    (ll/set-span-callback! settings 11 (primitive/fnptr-of server-on-body))
    (ll/set-simple-callback! settings 19 (primitive/fnptr-of server-on-header-value-complete))
    (ll/set-simple-callback! settings 10 (primitive/fnptr-of server-on-headers-complete))
    (ll/set-simple-callback! settings 12 (primitive/fnptr-of server-on-message-complete))
    (ll/init (field p parser) HTTP_REQUEST settings))
  (store! (field p fed) 0)
  (store! (field p done) false)
  0)

;;; Release what an unfinished parse holds. A parser that produced a request or an
;;; error has handed everything over, and this does nothing.
(defn request-parser-free! [(p (ptr RequestParser))] (-> i64)
  (unless (.done p)
    (free! (mut (field (field p context) spans)))
    (str/sb-free! (mut (field (field p context) body)))
    (store! (field p done) true))
  0)

;;; Parse the bytes of `buffer` the parser has not seen. `buffer` is everything
;;; received so far, starting with the first byte of the request: it may have
;;; grown, or moved, since the last feed, but the bytes already fed must be
;;; unchanged. `(Ok (None))` asks for more; `(Ok (Some request))` is the finished
;;; request, whose method, target and header slices borrow from this `buffer`
;;; and whose `consumed` says where the next request in it starts. After a request
;;; or an error the parser is finished; parse the next request with a new one.
(defn request-parser-feed! [(p (ptr RequestParser)) (buffer (slice u8))] (-> (Result (Option Request) Error))
  (let [parser (field p parser)
        c (field p context)
        fed (.fed p)]
    (when (.done p)
      (println "coil.http.server: request-parser-feed! on a parser that already finished")
      (abort))
    ; the parser's pointers to its context and settings, restored in case it moved
    (store! (field parser data) (primitive/cast (ptr i8) c))
    (lltypes/field-store! parser 12 (primitive/cast i64 (field p settings)))
    (store! (field c base) (data buffer))
    (let [err (ll/execute parser (slice/subslice buffer fed (len buffer)))]
      (store! (field p fed) (len buffer))
      (cond
        (and (.complete c) (= err HPE_PAUSED))
          (do
            (store! (field p done) true)
            (Ok (Some (request-parser--request p buffer))))
        (and (= err HPE_OK) (= (.error-code c) 0)) (Ok (None))
        :else (Err (request-parser--fail p buffer err))))))

;;; The finished request, its slices over `buffer`.
(defn request-parser--request [(p (ptr RequestParser)) (buffer (slice u8))] (-> Request)
  (let [c (field p context)
        a (.allocator c)
        (mut spans) (load (field c spans))
        (mut headers) (arraylist/ArrayList::new [Header] a)]
    (for s (iter spans)
      (push! (mut headers)
             (Header :name (slice/subslice buffer (.name-start s) (+ (.name-start s) (.name-len s)))
                     :value (slice/subslice buffer (.value-start s) (+ (.value-start s) (.value-len s))))))
    (free! (mut spans))
    (Request :method (request-parser--span buffer (.method-start c) (.method-len c))
             :target (request-parser--span buffer (.target-start c) (.target-len c))
             :version (http-version (field p parser))
             :headers (load headers)
             :body (str/sb-finish! (mut (field c body)))
             :consumed (primitive/isub (primitive/cast i64 (ll/get-error-pos (field p parser)))
                                       (primitive/cast i64 (data buffer)))
             :keep-alive (.keep-alive c)
             :allocator a)))

(defn request-parser--span [(buffer (slice u8)) (start i64) (len i64)] (-> (slice u8))
  (if (< start 0) (slice/subslice buffer 0 0) (slice/subslice buffer start (+ start len))))

;;; The error the parse stopped on, `err` being llhttp's, and the parser's parts
;;; released.
(defn request-parser--fail [(p (ptr RequestParser)) (buffer (slice u8)) (err i64)] (-> Error)
  (let [c (field p context)
        pos (ll/get-error-pos (field p parser))
        code (if (!= (.error-code c) 0) (.error-code c) err)]
    (request-parser-free! p)
    (Error :offset (if (= (primitive/cast i64 pos) 0)
                       (len buffer)
                       (primitive/isub (primitive/cast i64 pos)
                                       (primitive/cast i64 (data buffer))))
           :code code)))

;;; Parse exactly one request from `source`, which must hold all of it. A
;;; successful Request owns its decoded body and header table and must be released
;;; with `request-free`; its other slices borrow from `source`, which must remain
;;; alive until the request is no longer used. Error codes below 1000 are llhttp
;;; errno values; HTTP_ERROR_LIMIT (1000) is a configured size or count limit.
;;; Truncated input reports llhttp's HPE_INVALID_EOF_STATE (14). To parse a
;;; request as its bytes arrive, use a `RequestParser`.
(defn parse-request [(a (dyn alloc/Allocator)) (source (slice u8))] (-> (Result Request Error))
  (let [(mut p) (primitive/zeroed RequestParser)]
    (request-parser-init! (mut p) a)
    (match (request-parser-feed! (mut p) source)
      (Ok [found]
          (match found
            (Some [r] (Ok r))
            ; No message completed. finish() answers HPE_OK when the input ended
            ; between messages (e.g. it was empty), which for a request is still a
            ; truncated one.
            (None []
                  (let [finished (ll/finish (field (mut p) parser))]
                    (Err (request-parser--fail (mut p)
                                               source
                                               (if (= finished HPE_OK) HPE_INVALID_EOF_STATE finished)))))))
      (Err [e] (Err e)))))

;;; Whether the parse stopped at one of the configured limits: header count, header
;;; bytes, or body bytes.
(defn limit-exceeded? [(e Error)] (-> bool)
  (= (.code e) HTTP_ERROR_LIMIT))

;;; `{}` of an Error names what went wrong and where.
(impl Display Error
  (display-fmt [(e Error) (f (ptr Formatter))] (-> i64)
    (if (limit-exceeded? e)
        (fmt (formatter-writer f) "request exceeds a size or count limit at byte {}" (.offset e))
        (fmt (formatter-writer f) "malformed request ({}) at byte {}" (ll/errno-name (.code e)) (.offset e)))
    0))

(defn request-free [(r Request)] (-> i64)
  (let [(mut hs) (load (field r headers))]
    (free! (mut hs))
    (let [owned-body (load (field r body))]
      (if (> (len owned-body) (cast i64 0))
          (alloc/free [u8] (load (field r allocator)) owned-body)
          0))
    0))

(defn method-is [(r Request) (expected (slice u8))] (-> bool)
  (str/str-eq (load (field r method)) expected))

(defn method [(r Request)] (-> (slice u8))
  (load (field r method)))

(defn target [(r Request)] (-> (slice u8))
  (load (field r target)))

(defn version [(r Request)] (-> (slice u8))
  (load (field r version)))

(defn body [(r Request)] (-> (slice u8))
  (load (field r body)))

(defn consumed [(r Request)] (-> i64)
  (load (field r consumed)))

(defn error-offset [(e Error)] (-> i64)
  (load (field e offset)))

(defn error-code [(e Error)] (-> i64)
  (load (field e code)))

(defn keep-alive? [(r Request)] (-> bool)
  (load (field r keep-alive)))
