; Strict HTTP/1.x server-side request parsing backed by llhttp. Method, target,
; and headers are zero-copy views into the input; the decoded body is owned by
; the request so chunked transfer encoding has the same API as Content-Length.
(module coil.http.server)

(import "coil.primitive" :as primitive)
(import "coil.alloc" :as alloc)
(import "coil.arraylist" :as arraylist)
(import "coil.slice" :as slice)
(import "coil.str" :as str)
(import "coil.http.parser" :as ll :use [HTTP_REQUEST HPE_OK HPE_PAUSED HPE_USER])
(import "coil.http.parser.types" :as lltypes)

(export Header
        Request
        Error
        parse-request
        request-free
        header-count
        header-at
        header
        method-is
        keep-alive?
        method
        target
        version
        body
        consumed
        error-offset
        error-code)

(defstruct Header [(name (slice u8)) (value (slice u8))])
(defstruct Request
  [(method (slice u8))
   (target (slice u8))
   (version (slice u8))
   (headers (arraylist/ArrayList Header))
   (body (slice u8))
   (consumed i64)
   (keep-alive bool)
   (allocator (dyn alloc/Allocator))])
(defstruct Error [(offset i64) (code i64)])

(const HTTP_MAX_HEADERS 100)
(const HTTP_MAX_HEADER_BYTES 65536)
(const HTTP_MAX_BODY_BYTES 8388608)
(const HTTP_ERROR_LIMIT 1000)

(defstruct ParseContext
  [(allocator (dyn alloc/Allocator))
   (headers (arraylist/ArrayList Header))
   (body str/StrBuf)
   (method-start (ptr u8))
   (method-len i64)
   (target-start (ptr u8))
   (target-len i64)
   (header-name-start (ptr u8))
   (header-name-len i64)
   (header-value-start (ptr u8))
   (header-value-len i64)
   (header-bytes i64)
   (keep-alive bool)
   (complete bool)
   (error-code i64)])

(defn context-of [(p (ptr lltypes/Parser))] (-> (ptr ParseContext))
  (primitive/cast (ptr ParseContext) (load (field p data))))

(defn append-span! [(start (ptr (ptr u8)))
                    (total (ptr i64))
                    (at (ptr u8))
                    (len i64)] (-> i64)
  (if (= (primitive/cast i64 (load start)) (cast i64 0))
      (store! start at)
      0)
  (store! total (primitive/iadd (load total) len))
  0)

(defn server-on-method [(p (ptr lltypes/Parser)) (at (ptr u8)) (len i64)] (-> i64)
  (let [c (context-of p)]
    (append-span! (field c method-start) (field c method-len) at len)))

(defn server-on-url [(p (ptr lltypes/Parser)) (at (ptr u8)) (len i64)] (-> i64)
  (let [c (context-of p)]
    (append-span! (field c target-start) (field c target-len) at len)))

(defn server-on-header-field [(p (ptr lltypes/Parser)) (at (ptr u8)) (len i64)] (-> i64)
  (let [c (context-of p)
        bytes (primitive/iadd (load (field c header-bytes)) len)]
    (if (or (>= (arraylist/al-len (field c headers)) HTTP_MAX_HEADERS)
            (> bytes HTTP_MAX_HEADER_BYTES))
        (do (store! (field c error-code) HTTP_ERROR_LIMIT) HPE_USER)
        (do
          (store! (field c header-bytes) bytes)
          (append-span! (field c header-name-start)
                        (field c header-name-len)
                        at
                        len)))))

(defn server-on-header-value [(p (ptr lltypes/Parser)) (at (ptr u8)) (len i64)] (-> i64)
  (let [c (context-of p)
        bytes (primitive/iadd (load (field c header-bytes)) len)]
    (if (> bytes HTTP_MAX_HEADER_BYTES)
        (do (store! (field c error-code) HTTP_ERROR_LIMIT) HPE_USER)
        (do
          (store! (field c header-bytes) bytes)
          (append-span! (field c header-value-start)
                        (field c header-value-len)
                        at
                        len)))))

(defn server-on-header-value-complete [(p (ptr lltypes/Parser))] (-> i64)
  (let [c (context-of p)]
    (if (>= (arraylist/al-len (field c headers)) HTTP_MAX_HEADERS)
        (do (store! (field c error-code) HTTP_ERROR_LIMIT) HPE_USER)
        (let [(mut h) (primitive/zeroed Header)]
          (store! (field h name)
                  (slice/slice-new [u8]
                                   (load (field c header-name-start))
                                   (load (field c header-name-len))))
          (store! (field h value)
                  (slice/slice-new [u8]
                                   (load (field c header-value-start))
                                   (load (field c header-value-len))))
          (arraylist/al-push! [Header] (mut (field c headers)) (load h))
          (store! (field c header-name-start) (primitive/cast (ptr u8) 0))
          (store! (field c header-name-len) 0)
          (store! (field c header-value-start) (primitive/cast (ptr u8) 0))
          (store! (field c header-value-len) 0)
          0))))

(defn server-on-body [(p (ptr lltypes/Parser)) (at (ptr u8)) (len i64)] (-> i64)
  (let [c (context-of p)
        current (slice/slice-len (str/sb-str (load (field c body))))]
    (if (> (primitive/iadd current len) HTTP_MAX_BODY_BYTES)
        (do (store! (field c error-code) HTTP_ERROR_LIMIT) HPE_USER)
        (do
          (str/sb-push-str! (mut (field c body)) (slice/slice-new [u8] at len))
          0))))

(defn server-on-headers-complete [(p (ptr lltypes/Parser))] (-> i64)
  (store! (field (context-of p) keep-alive) (ll/should-keep-alive? p))
  0)

(defn server-on-message-complete [(p (ptr lltypes/Parser))] (-> i64)
  (store! (field (context-of p) complete) true)
  HPE_PAUSED)

(defn http-ascii-lower [(c i64)] (-> i64)
  (if (and (>= c (cast i64 \A)) (<= c (cast i64 \Z))) (primitive/iadd c 32) c))

(defn http-ci-eq [(a (slice u8)) (b (slice u8))] (-> bool)
  (if (!= (slice/slice-len a) (slice/slice-len b))
      false
      (let [(mut i) 0
            (mut same) true]
        (loop (if (>= (load i) (slice/slice-len a))
                  (break)
                  (if (= (http-ascii-lower (primitive/cast i64 (slice/slice-get a (load i))))
                         (http-ascii-lower (primitive/cast i64 (slice/slice-get b (load i)))))
                      (store! i (primitive/iadd (load i) 1))
                      (do (store! same false) (break)))))
        (load same))))

(defn header-count [(r Request)] (-> i64)
  (arraylist/al-len (field r headers)))

(defn header-at [(r Request) (i i64)] (-> Header)
  (arraylist/al-get (load (field r headers)) i))

;;; Case-insensitive header lookup. Returns an empty slice when absent.
(defn header [(r Request) (name (slice u8))] (-> (slice u8))
  (let [(mut i) 0
        (mut value) ""]
    (loop (if (>= (load i) (header-count r))
              (break)
              (let [h (header-at r (load i))]
                (if (http-ci-eq (load (field h name)) name)
                    (do (store! value (load (field h value))) (break))
                    (store! i (primitive/iadd (load i) 1))))))
    (load value)))

(defn http-version [(parser (ptr lltypes/Parser))] (-> (slice u8))
  (if (and (= (ll/get-http-major parser) (cast i64 1))
           (= (ll/get-http-minor parser) (cast i64 0)))
      "HTTP/1.0"
      "HTTP/1.1"))

;;; Parse exactly one request. A successful Request owns its decoded body and
;;; header table and must be released with `request-free`; its other slices borrow
;;; from `source`, which must remain alive until the request is no longer used.
;;; Error codes below 1000 are llhttp errno values; 1000 is a configured size/count
;;; limit and 1001 is native allocation failure. Truncated input reports llhttp's
;;; HPE_INVALID_EOF_STATE (14).
(defn parse-request [(a (dyn alloc/Allocator)) (source (slice u8))] (-> (Result Request Error))
  (let [parser (primitive/alloc-stack lltypes/Parser)
        settings (primitive/alloc-stack lltypes/Settings)
        context (primitive/alloc-stack ParseContext)
        (mut initial) (primitive/zeroed ParseContext)]
    (store! (field initial allocator) a)
    (store! (field initial headers) (arraylist/al-new [Header] a))
    (store! (field initial body) (str/sb-new a))
    (store! context (load initial))
    (ll/settings-init settings)
    (ll/set-span-callback! settings 4 (primitive/fnptr-of server-on-method))
    (ll/set-span-callback! settings 2 (primitive/fnptr-of server-on-url))
    (ll/set-span-callback! settings 6 (primitive/fnptr-of server-on-header-field))
    (ll/set-span-callback! settings 7 (primitive/fnptr-of server-on-header-value))
    (ll/set-span-callback! settings 11 (primitive/fnptr-of server-on-body))
    (ll/set-simple-callback! settings 19 (primitive/fnptr-of server-on-header-value-complete))
    (ll/set-simple-callback! settings 10 (primitive/fnptr-of server-on-headers-complete))
    (ll/set-simple-callback! settings 12 (primitive/fnptr-of server-on-message-complete))
    (ll/init parser HTTP_REQUEST settings)
    (store! (field parser data) (primitive/cast (ptr i8) context))
    (let [err (ll/execute parser source)
          complete (load (field context complete))]
      (if (and complete (= err HPE_PAUSED))
          (let [(mut r) (primitive/zeroed Request)]
            (store! (field r method)
                    (slice/slice-new [u8]
                                     (load (field context method-start))
                                     (load (field context method-len))))
            (store! (field r target)
                    (slice/slice-new [u8]
                                     (load (field context target-start))
                                     (load (field context target-len))))
            (store! (field r version) (http-version parser))
            (store! (field r headers) (load (field context headers)))
            (store! (field r body) (str/sb-finish! (mut (field context body))))
            (store! (field r consumed)
                    (primitive/isub (primitive/cast i64 (ll/get-error-pos parser))
                                    (primitive/cast i64 (slice/slice-data source))))
            (store! (field r keep-alive) (load (field context keep-alive)))
            (store! (field r allocator) a)
            (Ok (load r)))
          (let [(mut hs) (load (field context headers))
                (mut body) (load (field context body))
                (mut e) (primitive/zeroed Error)
                code
                  (if (!= (load (field context error-code)) (cast i64 0))
                      (load (field context error-code))
                      (if (= err HPE_OK) (ll/finish parser) err))
                pos (ll/get-error-pos parser)]
            (arraylist/al-free! [Header] (mut hs))
            (str/sb-free! (mut body))
            (store! (field e offset)
                    (if (= (primitive/cast i64 pos) (cast i64 0))
                        (slice/slice-len source)
                        (primitive/isub (primitive/cast i64 pos)
                                        (primitive/cast i64 (slice/slice-data source)))))
            (store! (field e code) code)
            (Err (load e)))))))

(defn request-free [(r Request)] (-> i64)
  (let [(mut hs) (load (field r headers))]
    (arraylist/al-free! [Header] (mut hs))
    (let [owned-body (load (field r body))]
      (if (> (slice/slice-len owned-body) (cast i64 0))
          (alloc/free [u8] (load (field r allocator)) owned-body)
          0))
    0))

(defn method-is [(r Request) (expected (slice u8))] (-> bool)
  (str/str-eq (load (field r method)) expected))
(defn method [(r Request)] (-> (slice u8))
  (load (field r method)))
(defn target [(r Request)] (-> (slice u8))
  (load (field r target)))
(defn version [(r Request)] (-> (slice u8))
  (load (field r version)))
(defn body [(r Request)] (-> (slice u8))
  (load (field r body)))
(defn consumed [(r Request)] (-> i64)
  (load (field r consumed)))
(defn error-offset [(e Error)] (-> i64)
  (load (field e offset)))
(defn error-code [(e Error)] (-> i64)
  (load (field e code)))
(defn keep-alive? [(r Request)] (-> bool)
  (load (field r keep-alive)))
