(module coil.args)
(import "coil.primitive" :as primitive)
(import "coil.alloc" :as alloc)
(import "coil.slice" :use *)
(import "coil.str" :as str)

; The program's own command line, readable from anywhere.
;
; `main` receives argc/argv, and only `main` does — so any library that wants to
; be configurable from the command line has to be handed them by the entry point,
; or invent a side channel. The usual side channel is an environment variable,
; which is how `coil.prop` was configured before this module existed: workable,
; but the wrong shape. A test runner's knobs are arguments to a command, they
; belong in `--flags`, and `COIL_PBT_CASES=5000 coil test` reads like a
; workaround because it is one.
;
; So: `main` stashes its arguments here once, and libraries read them.
;
;   (defn main [(argc i32) (argv (ptr (ptr i8)))] (-> i64)
;     (args-set! argc argv)
;     …)
;
; `coil.assert`'s test transform does exactly that in the `main` it synthesizes,
; which is what lets `coil test FILE --cases 5000` reach the property runner.
;
; A program that never calls `args-set!` sees an empty command line and every
; lookup returns its default — so a library reading flags stays correct in a
; program that has none to give it.
(defstruct Args [(argc i64) (argv (ptr (ptr i8))) (ready bool)])

(defn args-cell [] (-> (ptr Args))
  (primitive/alloc-static Args))

;;; Record the command line. Call once, from `main`, before anything reads it.
(defn args-set! [(argc i32) (argv (ptr (ptr i8)))] (-> i64)
  (let [c (args-cell)]
    (store! (field c argc) (primitive/cast i64 argc))
    (store! (field c argv) argv)
    (store! (field c ready) true)
    0))

(defn args-count [] (-> i64)
  (if (load (field (args-cell) ready)) (load (field (args-cell) argc)) 0))

;;; Argument `i`, or the empty slice when there is none. Never returns a dangling
;;; slice: an out-of-range index is a caller mistake, not a memory error.
(defn args-nth [(i i64)] (-> (slice u8))
  (if (or (< i 0) (>= i (args-count)))
      ""
      (str/cstr->str (load (primitive/index (load (field (args-cell) argv)) i)))))

;;; Is `name` present as a bare flag (`--verbose`)?
(defn args-has? [(name (slice u8))] (-> bool)
  (let [n (args-count)
        (mut i) 1
        (mut found) false]
    (loop (if (or (load found) (>= (load i) n))
              (break)
              (do
                (if (str/str-eq (args-nth (load i)) name) (store! found true) 0)
                (store! i (primitive/iadd (load i) 1)))))
    (load found)))

;;; The value of `--name VALUE` or `--name=VALUE`, or the empty slice.
;;;
;;; Both spellings, because both are what people type. The separated form is
;;; checked first since it is the one this codebase's own commands use.
(defn args-value [(name (slice u8))] (-> (slice u8))
  (let [n (args-count)
        (mut i) 1
        (mut out) ""
        (mut done) false]
    (loop (if (or (load done) (>= (load i) n))
              (break)
              (let [a (args-nth (load i))]
                (if (str/str-eq a name)
                    (do
                      (if (< (primitive/iadd (load i) 1) n)
                          (do (store! out (args-nth (primitive/iadd (load i) 1))) 0)
                          0)
                      (store! done true)
                      0)
                    (if (and (str/starts-with a name) (args--eq-at? a (slice-len [u8] name)))
                        (do
                          (store! out (subslice [u8] a (primitive/iadd (slice-len [u8] name) 1) (slice-len [u8] a)))
                          (store! done true)
                          0)
                        0))
                (store! i (primitive/iadd (load i) 1))
                0)))
    (load out)))

;;; Is byte `at` of `s` an `=`? Guards the `--name=VALUE` split so that `--cases`
;;; does not match `--cases-per-worker`.
(defn args--eq-at? [(s (slice u8)) (at i64)] (-> bool)
  (and (< at (slice-len [u8] s)) (= (slice-get [u8] s at) (primitive/cast u8 61))))

;;; `--name N` as an integer, or `dflt` when absent or unparseable.
;;;
;;; An unparseable value falls back rather than aborting: these are diagnostic
;;; knobs on a test runner, and dying on a typo in one of them would be a worse
;;; outcome than running with the default.
(defn args-int [(name (slice u8)) (dflt i64)] (-> i64)
  (let [v (args-value name)]
    (if (= (slice-len [u8] v) 0)
        dflt
        (match (str/str-parse-int v)
          (None [] dflt)
          (Some [n] n)))))

;;; A flag that may be given bare (`--verbose`) or with a value (`--verbose 2`).
(defn args-level [(name (slice u8)) (dflt i64)] (-> i64)
  (let [v (args-value name)]
    (if (> (slice-len [u8] v) 0)
        (match (str/str-parse-int v)
          (None [] 1)
          (Some [n] n))
        (if (args-has? name) 1 dflt))))
