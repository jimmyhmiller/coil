(module coil.cancellation)
(import "coil.primitive" :as primitive)
(import "coil.alloc" :as alloc)
(import "coil.atomic" :as atomic)
(import "coil.os" :as os)
(import "coil.io" :as io)
(import "coil.selectors" :as selectors)

(export Cancellation
        CancellationError
        PipeFailed
        cancellation-init
        cancellation-request!
        cancellation-requested?
        cancellation-watch
        cancellation-close!)

(defsum CancellationError (PipeFailed [(code i64)]))
(defstruct Cancellation [(read-fd i32) (write-fd i32) (requested i64) (closed bool)])

(defn cancellation-init [(token (ptr Cancellation))] (-> (Result (ptr Cancellation) CancellationError))
  (let [fds (alloc/stack (array i32 2))]
    (if (< (os/pipe (primitive/cast (ptr i32) fds)) 0)
        (Err (PipeFailed (os/os-errno)))
        (do
          (store! (field token read-fd) (load (primitive/index fds 0)))
          (store! (field token write-fd) (load (primitive/index fds 1)))
          (store! (field token requested) 0)
          (store! (field token closed) false)
          (Ok token)))))

;; Async threads may request cancellation concurrently. Exactly the first request
;; writes a wake byte, so the pipe cannot fill from repeated calls.
(defn cancellation-request! [(token (ptr Cancellation))] (-> i64)
  (if (or (load (field token closed)) (!= (atomic/atomic-xchg (field token requested) 1) 0))
      0
      (let [byte (alloc/stack i8)]
        (store! byte 1)
        (primitive/cast i64 (io/write (load (field token write-fd)) byte 1)))))

(defn cancellation-requested? [(token (ptr Cancellation))] (-> bool)
  (!= (atomic/atomic-load (field token requested)) 0))

(defn cancellation-watch [(token (ptr Cancellation)) (tag i64)] (-> selectors/Watch)
  (selectors/watch (load (field token read-fd)) (selectors/interest-readable) tag))

(defn cancellation-close! [(token (ptr Cancellation))] (-> i64)
  (unless (load (field token closed))
    (os/close (load (field token read-fd)))
    (os/close (load (field token write-fd)))
    (store! (field token read-fd) -1)
    (store! (field token write-fd) -1)
    (store! (field token closed) true))
  0)
