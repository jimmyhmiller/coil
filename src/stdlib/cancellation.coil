(module coil.cancellation)
(import "coil.primitive" :as primitive)
(import "coil.alloc" :as alloc)
(import "coil.atomic" :as atomic)
(import "coil.os" :as os)
(import "coil.io" :as io)
(import "coil.selectors" :as selectors)

(export Cancellation
        CancellationError
        PipeFailed
        cancellation-init
        cancellation-request!
        cancellation-requested?
        cancellation-watch
        cancellation-close!)

(defsum CancellationError (PipeFailed [(code i64)]))

(defstruct Cancellation
  [(read-fd i32) (write-fd i32) (requested i64) (closed bool)])

(defn cancellation-init [(token (ptr Cancellation))] (-> (Result (ptr Cancellation)
                                                                 CancellationError))
  (let [fds (primitive/alloc-stack (array i32 2))]
    (if (< (os/pipe (primitive/cast (ptr i32) fds)) 0)
        (Err (PipeFailed (os/os-errno)))
        (let [read-fd (load (primitive/index fds 0))
              write-fd (load (primitive/index fds 1))]
          (if (or (< (os/fcntl read-fd 2 1) 0)
                  (< (os/fcntl write-fd 2 1) 0))
              (let [error (os/os-errno)]
                (os/close read-fd)
                (os/close write-fd)
                (Err (PipeFailed error)))
              (do
                (set! (.read-fd token) read-fd)
                (set! (.write-fd token) write-fd)
                (set! (.requested token) 0)
                (set! (.closed token) false)
                (Ok token)))))))

(defn cancellation-write-wake [(fd i32) (byte (ptr i8))] (-> i64)
  (let [n (primitive/cast i64 (io/write fd byte 1))]
    (if (and (< n 0) (= (os/os-errno) 4))
        (cancellation-write-wake fd byte)
        n)))

;;; Async threads may request cancellation concurrently. Exactly the first request
;;; writes a wake byte, so the pipe cannot fill from repeated calls.
(defn cancellation-request! [(token (ptr Cancellation))] (-> i64)
  (if (or (.closed token) (!= (atomic/atomic-xchg (field token requested) 1) 0))
      0
      (let [byte (primitive/alloc-stack i8)]
        (set! byte 1)
        (cancellation-write-wake (.write-fd token) byte))))

(defn cancellation-requested? [(token (ptr Cancellation))] (-> bool)
  (!= (atomic/atomic-load (field token requested)) 0))

(defn cancellation-watch [(token (ptr Cancellation)) (tag i64)] (-> selectors/Watch)
  (selectors/watch (.read-fd token) (selectors/interest-readable) tag))

(defn cancellation-close! [(token (ptr Cancellation))] (-> i64)
  (unless (load (field token closed))
    (os/close (load (field token read-fd)))
    (os/close (load (field token write-fd)))
    (store! (field token read-fd) -1)
    (store! (field token write-fd) -1)
    (store! (field token closed) true))
  0)
