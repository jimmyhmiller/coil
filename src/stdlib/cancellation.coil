(module coil.cancellation)
(import "coil.primitive" :as primitive)
(import "coil.fmt" :use [fmt Display display-fmt Formatter])
(import "coil.alloc" :as alloc)
(import "coil.atomic" :as atomic)
(import "coil.os" :as os)
(import "coil.io" :as io)
(import "coil.selectors" :as selectors)

(export Cancellation
        CancellationError
        PipeFailed)

(defsum CancellationError (PipeFailed [(code i64)]))

(derive Eq CancellationError)

;;; `{}` is a message for a person; an errno reads as the operating system describes it.
(impl Display CancellationError
  (display-fmt [(e CancellationError) (f (ptr Formatter))] (-> i64)
    (let [w (writer f)]
      (match e
        (PipeFailed [code] (do (io/print-str w "creating the cancellation pipe failed: ") (io/write-os-error w code)))))
    0))

(defstruct Cancellation
  [(read-fd i32) (write-fd i32) (requested i64) (closed bool)])

;;; Wakes the pipe's reader: one byte, retried when a signal interrupts the write.
(defn write-wake [(fd i32) (byte (ptr i8))] (-> i64)
  (let [n (primitive/cast i64 (io/write fd byte 1))]
    (if (and (< n 0) (= (os/errno) 4))
        (write-wake fd byte)
        n)))

(impl Cancellation
  ;;; Initialize the token at `token` with its wake pipe.
  (init [(token (ptr Cancellation))] (-> (Result (ptr Cancellation) CancellationError))
    (let [fds (primitive/alloc-stack (array i32 2))]
      (let [error (os/pipe-cloexec (primitive/cast (ptr i32) fds))]
        (if (!= error 0)
            (Err (PipeFailed error))
            (do
              (set! (.read-fd token) (load (primitive/index fds 0)))
              (set! (.write-fd token) (load (primitive/index fds 1)))
              (set! (.requested token) 0)
              (set! (.closed token) false)
              (Ok token))))))

  ;;; Async threads may request cancellation concurrently. Exactly the first request
  ;;; writes a wake byte, so the pipe cannot fill from repeated calls.
  (request! [(token (ptr Cancellation))] (-> i64)
    (if (or (.closed token) (!= (atomic/xchg (field token requested) 1) 0))
        0
        (let [byte (primitive/alloc-stack i8)]
          (set! byte 1)
          (write-wake (.write-fd token) byte))))

  ;;; Has cancellation been requested?
  (requested? [(token (ptr Cancellation))] (-> bool)
    (!= (atomic/read (field token requested)) 0))

  ;;; A selector watch, tagged `tag`, that is readable once cancellation is requested.
  (watch [(token (ptr Cancellation)) (tag i64)] (-> selectors/Watch)
    (selectors/watch (.read-fd token) (selectors/interest-readable) tag))

  ;;; Close the wake pipe. Closing twice does nothing.
  (close! [(token (ptr Cancellation))] (-> i64)
    (unless (load (field token closed))
      (os/close (load (field token read-fd)))
      (os/close (load (field token write-fd)))
      (store! (field token read-fd) -1)
      (store! (field token write-fd) -1)
      (store! (field token closed) true))
    0))
