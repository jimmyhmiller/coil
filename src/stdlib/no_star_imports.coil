(module coil.lint.no-star-imports)
(import "coil.primitive" :as primitive)

; Opt-in import hygiene:
;   coil lint app.coil --use coil.lint.no-star-imports [--fix|--diff]
; Checkers see the source-spanned import/export declarations in addition to the
; checked forms. Expanding a wildcard to every exported name is conservative: it
; remains correct for macro imports whose original calls are gone after expansion.

(defn si-head? [(f Code) (head Code)] (-> bool)
  (and (primitive/code-list? f)
       (and (> (primitive/code-count f) 0) (primitive/code-eq (primitive/code-nth f 0) head))))

(defn si-member? [(xs Code) (x Code) (i i64) (n i64)] (-> bool)
  (if (>= i n) false
    (if (primitive/code-eq (primitive/code-nth xs i) x) true (si-member? xs x (+ i 1) n))))

(defn si-add-name [(xs Code) (x Code)] (-> Code)
  (if (or (not (primitive/code-sym? x)) (si-member? xs x 0 (primitive/code-count xs))) xs `(~@xs ~x)))

(defn si-add-range [(xs Code) (f Code) (i i64) (n i64)] (-> Code)
  (if (>= i n) xs (si-add-range (si-add-name xs (primitive/code-nth f i)) f (+ i 1) n)))

(defn si-explicit-exports [(m Code) (i i64) (n i64) (xs Code)] (-> Code)
  (if (>= i n) xs
    (let [f (primitive/code-nth m i)]
      (si-explicit-exports m (+ i 1) n
        (if (si-head? f `export) (si-add-range xs f 1 (primitive/code-count f)) xs)))))

(defn si-has-export? [(m Code) (i i64) (n i64)] (-> bool)
  (if (>= i n) false
    (if (si-head? (primitive/code-nth m i) `export) true (si-has-export? m (+ i 1) n))))

(defn si-declaration? [(f Code)] (-> bool)
  (or (si-head? f `defn)
    (or (si-head? f `defmacro)
      (or (si-head? f `defstruct)
        (or (si-head? f `defsum)
          (or (si-head? f `deftrait)
            (or (si-head? f `const)
              (or (si-head? f `extern)
                (or (si-head? f `def) (si-head? f `defprimitive))))))))))

(defn si-default-exports [(m Code) (i i64) (n i64) (xs Code)] (-> Code)
  (if (>= i n) xs
    (let [f (primitive/code-nth m i)]
      (si-default-exports m (+ i 1) n
        (if (and (si-declaration? f) (> (primitive/code-count f) 1))
            (si-add-name xs (primitive/code-nth f 1)) xs)))))

(defn si-find-module [(modules Code) (name Code) (i i64) (n i64)] (-> Code)
  (if (>= i n) `()
    (let [m (primitive/code-nth modules i)]
      (if (and (> (primitive/code-count m) 0) (primitive/code-eq (primitive/code-nth m 0) name))
          m (si-find-module modules name (+ i 1) n)))))

(defn si-form-has? [(f Code) (needle Code) (i i64) (n i64)] (-> bool)
  (if (>= i n) false
    (if (primitive/code-eq (primitive/code-nth f i) needle) true (si-form-has? f needle (+ i 1) n))))

(defn si-merge [(xs Code) (ys Code) (i i64)] (-> Code)
  (if (>= i (primitive/code-count ys)) xs
    (si-merge (si-add-name xs (primitive/code-nth ys i)) ys (+ i 1))))

(defn si-module-exports [(modules Code) (name Code) (depth i64)] (-> Code)
  (if (<= depth 0) `()
    (let [m (si-find-module modules name 0 (primitive/code-count modules))]
      (if (= (primitive/code-count m) 0) `()
        (si-reexports modules m 1 (primitive/code-count m) depth
          (if (si-has-export? m 1 (primitive/code-count m))
              (si-explicit-exports m 1 (primitive/code-count m) `())
              (si-default-exports m 1 (primitive/code-count m) `())))))))

(defn si-reexports [(modules Code) (m Code) (i i64) (n i64) (depth i64) (xs Code)] (-> Code)
  (if (>= i n) xs
    (let [f (primitive/code-nth m i)]
      (si-reexports modules m (+ i 1) n depth
        (if (and (si-head? f `import)
                 (and (> (primitive/code-count f) 1) (si-form-has? f `:reexport 2 (primitive/code-count f))))
            (si-merge xs (si-module-exports modules (primitive/code-symbol (primitive/code-nth f 1) "") (- depth 1)) 0)
            xs)))))

(defn si-star-use? [(f Code) (i i64) (n i64)] (-> bool)
  (and (< (+ i 1) n)
       (and (primitive/code-eq (primitive/code-nth f i) `:use)
            (primitive/code-eq (primitive/code-nth f (+ i 1)) `*))))

;;; The import's clause list, with a `:use *` replaced by `:use [name ...]`.
;;;
;;; A builder in an index loop, not a recursive splice: splicing a direct recursive call
;;; rebuilds the suffix at every level, and the compiler's own metaprogram lint says so --
;;; it fired on THIS checker, twice, on every run, so anyone who opted in got two warnings
;;; about the linter before any warning about their code.
(defn si-rewrite-tail [(f Code) (i i64) (n i64) (names Code)] (-> Code)
  (let [(mut b) (primitive/code-list-new)
        (mut k) i]
    (loop (if (>= (load k) n)
              (break)
              (if (si-star-use? f (load k) n)
                  (let [chunk `(:use [~@names])]
                    (set! b (primitive/code-list-push! (load b) (primitive/code-nth chunk 0)))
                    (set! b (primitive/code-list-push! (load b) (primitive/code-nth chunk 1)))
                    (set! k (primitive/iadd (load k) 2))
                    0)
                (do (set! b (primitive/code-list-push! (load b) (primitive/code-nth f (load k))))
                    (set! k (primitive/iadd (load k) 1))
                    0))))
    (primitive/code-list-done (load b))))

(defn si-fix-import [(modules Code) (f Code)] (-> Code)
  (let [names (si-module-exports modules (primitive/code-symbol (primitive/code-nth f 1) "") 32)]
    `(import ~@(si-rewrite-tail f 1 (primitive/code-count f) names))))

(defn si-check-form [(modules Code) (f Code)] (-> i64)
  (if (and (primitive/code-from-user? f)
           (and (si-head? f `import) (si-form-has? f `* 2 (primitive/code-count f))))
      (do (primitive/suggest f "wildcard import; list the exported names explicitly" (si-fix-import modules f)) 0)
      0))

(defn si-check-module [(modules Code) (m Code) (i i64) (n i64)] (-> i64)
  (if (>= i n) 0
    (do (si-check-form modules (primitive/code-nth m i)) (si-check-module modules m (+ i 1) n))))

(defn si-check-modules [(modules Code) (i i64) (n i64)] (-> Code)
  (if (>= i n) `0
    (let [m (primitive/code-nth modules i)]
      (do (si-check-module modules m 1 (primitive/code-count m)) (si-check-modules modules (+ i 1) n)))))

(defn lint-no-star-imports [(modules Code)] (-> Code)
  (si-check-modules modules 0 (primitive/code-count modules)))

;; `:phase before-expand` -- this lints AUTHORED import syntax, so it belongs in the
;; syntax phase, which is also the only phase handed the import declarations.
(checker lint-no-star-imports :phase before-expand)
