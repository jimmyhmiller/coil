; Threads — a thin capability-as-value wrapper over the POSIX `pthread` externs (the
; same C-interop callback pattern cinterop proved with qsort: a Coil function handed to
; C as a function pointer). PURE LIBRARY, no core feature. Hosted (links libpthread/
; libc) — concurrency is a hosted concern; bare-metal concurrency is a separate axis.
(module coil.thread)
(import "coil.primitive" :as primitive)
(import "coil.alloc" :as alloc)
(import "coil.checked-ffi" :use [checked-out-new checked-out-ptr checked-out-free!])

; hygiene: platform-layout declarations intentionally use stable public names
(defn thread-public-name [(name Code)] (-> Code)
  (primitive/syntax->datum name))
(defn thread-os-pick [(linux Code) (darwin Code)] (-> Code)
  (if (primitive/code-eq (primitive/target-os) `linux) linux darwin))
(defn thread-pthread-layout [] (-> Code)
  `(do
     ; pthread_attr_t is opaque and its ABI size differs by host libc: 56 bytes
     ; on glibc x86-64/aarch64 and 64 bytes on Darwin. Keeping the target choice
     ; at comptime also makes cross-target builds allocate the target layout.
     (const ~(thread-public-name `THREAD_ATTR_SIZE) ~(thread-os-pick `56 `64))
     (const ~(thread-public-name `THREAD_ATTR_ALIGN) 8)
     (const ~(thread-public-name `THREAD_STACK_MIN) 16384)))
(meta (thread-pthread-layout))

(export Thread
        ThreadConfig
        thread-config
        thread-spawn
        thread-spawn-configured
        thread-join)

;;; int pthread_create(pthread_t*, const pthread_attr_t*, void*(*)(void*), void*)
(extern pthread_create :cc c [(ptr i8) (ptr i8) (fnptr c [(ptr i8)] (ptr i8)) (ptr i8)] (-> i32))
;;; int pthread_join(pthread_t, void**)
(extern pthread_join :cc c [(ptr i8) (ptr i8)] (-> i32))
(extern pthread_attr_init :cc c [(ptr i8)] (-> i32))
(extern pthread_attr_destroy :cc c [(ptr i8)] (-> i32))
(extern pthread_attr_setstacksize :cc c [(ptr i8) i64] (-> i32))
(extern pthread_attr_setguardsize :cc c [(ptr i8) i64] (-> i32))

;;; A handle to a spawned thread. `pthread_t` is an opaque pointer-sized value; we keep it
;;; in a struct so a thread is an ordinary value you pass around.
(defstruct Thread [(handle (ptr i8))])
(defstruct ThreadConfig [(stack-size i64) (guard-size i64)])

(defn thread-stack-min [] (-> i64)
  THREAD_STACK_MIN)

;;; Construct a validated thread-stack request. Zero selects the platform default;
;;; nonzero stack sizes are clamped to PTHREAD_STACK_MIN by thread-spawn-configured.
(defn thread-config [(stack-size i64) (guard-size i64)] (-> ThreadConfig)
  (let [config (primitive/alloc-stack ThreadConfig)]
    (store! (field config stack-size) stack-size)
    (store! (field config guard-size) guard-size)
    (load config)))

;;; spawn: run `body(arg)` on a new thread, recording the handle into `th`. Returns the
;;; pthread_create status (0 = ok).
(defn thread-spawn [(th (ptr Thread)) (body (fnptr c [(ptr i8)] (ptr i8))) (arg (ptr i8))] (-> i32)
  (pthread_create (primitive/cast (ptr i8) (field th handle)) (primitive/cast (ptr i8) 0) body arg))

;;; Spawn with explicit stack and guard sizes using a probed opaque pthread_attr_t.
;;; Returns the first pthread status code and always destroys initialized attrs.
(defn thread-spawn-configured [(th (ptr Thread))
                               (body (fnptr c [(ptr i8)] (ptr i8)))
                               (arg (ptr i8))
                               (config ThreadConfig)] (-> i32)
  (let [(mut storage) (checked-out-new (alloc/malloc-allocator) THREAD_ATTR_SIZE THREAD_ATTR_ALIGN)
        attr (checked-out-ptr (mut storage))
        init-status (pthread_attr_init attr)]
    (if (!= init-status (primitive/cast i32 0))
        (do
          (checked-out-free! (mut storage))
          init-status)
        (let [requested-stack (load (field config stack-size))
              stack-size
                (if (and (> requested-stack 0) (< requested-stack (thread-stack-min)))
                    (thread-stack-min)
                    requested-stack)
              stack-status (if (> stack-size 0) (pthread_attr_setstacksize attr stack-size) 0)
              guard-status
                (if (and (= stack-status 0) (>= (load (field config guard-size)) 0))
                    (pthread_attr_setguardsize attr (load (field config guard-size)))
                    stack-status)
              spawn-status
                (if (= guard-status 0)
                    (pthread_create (primitive/cast (ptr i8) (field th handle)) attr body arg)
                    guard-status)]
          (pthread_attr_destroy attr)
          (checked-out-free! (mut storage))
          spawn-status))))

;;; join: block until the thread finishes (discarding its return value). Returns status.
(defn thread-join [(th (ptr Thread))] (-> i32)
  (pthread_join (load (field th handle)) (primitive/cast (ptr i8) 0)))
