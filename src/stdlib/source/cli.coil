;;; What a source tool's command line shares: writing a file only if it still holds
;;; what was read, standard input and output, and small output helpers.
(module coil.source.cli)
(import "coil.primitive" :as primitive)
(import "coil.alloc" :use *)
(import "coil.result" :use *)
(import "coil.slice" :use *)
(import "coil.str" :use *)
(import "coil.io" :use *)
(import "coil.fs" :as fs)
(import "coil.os" :use [exit])
(import "coil.cc" :as cc)

(extern fopen :cc (cc/C) [(ptr i8) (ptr i8)] (-> (ptr i8)))

(extern fwrite :cc (cc/C) [(ptr i8) i64 i64 (ptr i8)] (-> i64))

(extern fclose :cc (cc/C) [(ptr i8)] (-> i32))

(defn ps [(w (ptr Writer)) (s (slice u8))] (-> i64)
  (print-str w s)
  0)

(defn wb [(w (ptr Writer)) (b i64)] (-> i64)
  (write-byte w (primitive/cast u8 b))
  0)

;;; The bytes of the file at PATH on disk, or empty when it cannot be read.
(defn read-file-disk [(a (dyn Allocator)) (path (ptr i8))] (-> (slice u8))
  (match (fs/read-file a (from-cstr path))
    (Ok [text] text)
    (Err [_] "")))

(defn is-flag? [(arg (slice u8))] (-> bool)
  (and (>= (len arg) 1)
       (= (get arg 0) (: 45 u8))))  ; '-'

(defn d-write-file [(a (dyn Allocator)) (path (slice u8)) (content (slice u8))]
  (-> i64)
  (let [f (fopen (to-cstr a path) (to-cstr a "wb"))]
    (if (= (primitive/cast i64 f) 0)
        (do
          (ps (stderr) "error: cannot write ")
          (ps (stderr) path)
          (wb (stderr) 10)
          1)
        (let [written
                (fwrite (primitive/cast (ptr i8) (data content))
                        1
                        (len content)
                        f)
              closed (fclose f)]
          (if (and (= written (len content)) (= closed 0))
              0
              (do
                (ps (stderr) "error: incomplete write to ")
                (ps (stderr) path)
                (wb (stderr) 10)
                1))))))

;;; Rewrite a source file that the command read as EXPECTED: write CONTENT only
;;; while PATH still holds those bytes. A file that holds anything else was edited
;;; by someone else after it was read, and that edit is theirs: it is left as it
;;; is, and reported as `error: WHAT; left untouched: PATH`. 0 when written, 1
;;; when the write failed (d-write-file says why), 2 when the file was left.
(defn d-rewrite-file [(a (dyn Allocator))
                      (what (slice u8))
                      (path (slice u8))
                      (expected (slice u8))
                      (content (slice u8))] (-> i64)
  (if (= (read-file-disk a (to-cstr a path)) expected)
      (d-write-file a path content)
      (let [w (stderr)]
        (ps w "error: ")
        (ps w what)
        (ps w "; left untouched: ")
        (ps w path)
        (wb w 10)
        2)))

(defn read-stdin-all [(a (dyn Allocator))] (-> (slice u8))
  (match (read-to-end a (stdin))
    (Ok [bytes] (OwnedBytes::slice bytes))
    (Err [e]
         (do
           (ps (stderr) "error: cannot read standard input: ")
           (match e
             (Errno [code] (do (write-os-error (stderr) code) 0))
             (_ (ps (stderr) "out of memory")))
           (wb (stderr) 10)
           (exit 1)
           ""))))

;;; Write TEXT, a command's whole output, to standard output: 0, or 1 having said
;;; why when the write fails. A filter's output is its result, so a failed write
;;; must not exit 0.
(defn write-stdout-all [(text (slice u8))] (-> i64)
  (match (print-str (stdout) text)
    (Ok [_] 0)
    (Err [e]
         (do
           (ps (stderr) "error: cannot write standard output: ")
           (match e
             (Errno [code] (do (write-os-error (stderr) code) 0))
             (_ (ps (stderr) "the write accepted no bytes")))
           (wb (stderr) 10)
           1))))

; Counts `"cause":"…"` occurrences rather than parsing JSON, which is honest here
; because this program is the only writer of the file and escapes every value it
; emits. jq gives the full picture; this answers the one question worth asking often:
; which cause is actually costing you repairs.
(defn count-substr [(hay (slice u8)) (needle (slice u8))] (-> i64)
  (let [n (len hay)
        m (len needle)
        (mut i) 0
        (mut c) 0]
    (loop (if (or (= m 0)
                  (> (primitive/iadd (load i) m) n))
              (break)
              (do
                (when (= (subslice hay (load i) (primitive/iadd (load i) m))
                         needle)
                  (set! c (primitive/iadd (load c) 1))
                  0)
                (set! i (primitive/iadd (load i) 1)))))
    (load c)))

;;; Is PATH a directory?
(defn dir? [(path (ptr i8))] (-> bool)
  (let [a (malloc-allocator)]
    (match (fs/Directory::open a (from-cstr path))
      (Ok [d] (do (let [(mut held) d] (fs/Directory::close! (mut held))) true))
      (Err [_] false))))

;;; The source at PATH, or say why not and exit with status RC.
(defn read-source [(a (dyn Allocator)) (path (ptr i8)) (rc i64)] (-> (slice u8))
  (match (fs/read-file a (from-cstr path))
    (Ok [text] text)
    (Err [_]
         (do
           (ps (stderr) "error: no such file: '")
           (ps (stderr) (from-cstr path))
           (ps (stderr) "'\n")
           (exit (primitive/cast i32 rc))
           ""))))
