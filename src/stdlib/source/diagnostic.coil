;;; How a located source error is written: the message, the file and position, the
;;; line, and carets under the span. The compiler writes every diagnostic through
;;; this, and a source tool that reads a file with coil.reader reports the same way.
(module coil.source.diagnostic)
(import "coil.primitive" :as primitive)
(import "coil.slice" :use *)
(import "coil.str" :use *)
(import "coil.io" :use *)
(import "coil.reader" :use [Diag])

(defn put [(w (ptr Writer)) (b i64)] (-> i64)
  (write-byte w (primitive/cast u8 b))
  0)

(defn write-decimal [(w (ptr Writer)) (n i64)] (-> i64)
  (when (>= n 10) (write-decimal w (primitive/udiv n 10)) 0)
  (put w (primitive/iadd (primitive/urem n 10) 48)))

; number of decimal digits in n (n >= 0).
(defn dec-len [(n i64)] (-> i64)
  (if (< n 10)
      1
      (primitive/iadd 1 (dec-len (primitive/udiv n 10)))))

(defn wspaces [(w (ptr Writer)) (n i64)] (-> i64)
  (let [(mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do (put w 32) (set! i (primitive/iadd (load i) 1))))))
  0)

(defn wrepeat [(w (ptr Writer)) (b i64) (n i64)] (-> i64)
  (let [(mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do (put w b) (set! i (primitive/iadd (load i) 1))))))
  0)

; line (1-based), column (1-based, bytes = chars for ASCII), and the offending
; line's [start,end) byte range, for offset `off` in `src`. Mirrors span::locate.
(defstruct Loc [(line i64) (col i64) (lstart i64) (lend i64)])

;;; Where offset OFF of SRC is. The compiler keeps a table of line starts and finds
;;; this by binary search; a tool with one error to report just scans.
(defn locate [(src (slice u8)) (off0 i64)] (-> Loc)
  (let [n (len src)
        off (if (> off0 n) n (if (< off0 0) 0 off0))
        (mut line) 1
        (mut lstart) 0
        (mut i) 0]
    (loop (if (>= (load i) off)
              (break)
              (do
                (when (= (primitive/cast i64 (get src (load i))) 10)
                  (set! line (primitive/iadd (load line) 1))
                  (set! lstart (primitive/iadd (load i) 1))
                  0)
                (set! i (primitive/iadd (load i) 1)))))
    (let [(mut lend) off]
      (loop (if (or (>= (load lend) n)
                    (= (primitive/cast i64 (get src (load lend))) 10))
                (break)
                (set! lend (primitive/iadd (load lend) 1))))
      (Loc
        :line (load line)
        :col (primitive/iadd (primitive/isub off (load lstart)) 1)
        :lstart (load lstart)
        :lend (load lend)))))

; A frame for a span that LOC has located in SRC, under FILE: everything after the
; message is positional, so a caller only has to say where it found the line.
(defn write-frame [(w (ptr Writer))
                   (file (slice u8))
                   (src (slice u8))
                   (loc Loc)
                   (lo i64)
                   (hi i64)
                   (msg (slice u8))
                   (arrow (slice u8))] (-> i64)
  (let [line (.line loc)
        col (.col loc)
        lstart (.lstart loc)
        lend (.lend loc)
        hic (let [h (if (> hi lend) lend hi)] (if (< h lo) lo h))
        carets
          (let [c (primitive/isub hic lo)]
            (if (< c 1) 1 c))
        numlen (dec-len line)]
    ; Window a very long line around the span. A macro-generated line can be tens
    ; of KB (`cond` -> one line); printing it whole buried the caret and dumped
    ; the entire expansion. Show at most maxw chars, with `...` (ASCII, so byte
    ; width matches the caret math) marking either truncated end.
    (let [maxw 120
          ctx 32
          long (> (primitive/isub lend lstart) maxw)
          wstart
            (if long
                (let [x (primitive/isub lo ctx)]
                  (if (< x lstart) lstart x))
                lstart)
          wend
            (if long
                (let [x (primitive/iadd wstart maxw)]
                  (if (> x lend) lend x))
                lend)
          pre (> wstart lstart)
          post (< wend lend)
          ; caret offset = span start within the window (+3 for a leading "...")
          pad
            (primitive/iadd (primitive/isub lo wstart)
                            (when pre 3))
          ; don't let carets run past the visible window
          shown
            (let [avail (primitive/isub wend lo)
                  c (if (< carets avail) carets avail)]
              (if (< c 1) 1 c))]
      (when (> (len msg) 0)
        (print-str w msg)
        (put w 10))
      (wspaces w numlen)
      (put w 32)
      (print-str w arrow)
      (put w 32)
      (print-str w file)
      (put w 58)
      (write-decimal w line)
      (put w 58)
      (write-decimal w col)
      (put w 10)
      (wspaces w numlen)
      (print-str w " |")
      (put w 10)
      (write-decimal w line)
      (print-str w " | ")
      (when pre (print-str w "..."))
      (print-str w (subslice src wstart wend))
      (when post (print-str w "..."))
      (put w 10)
      (wspaces w numlen)
      (print-str w " | ")
      (wspaces w pad)
      (wrepeat w 94 shown)
      0)))

;;; D, read from SRC under FILE, as `error: …` with its frame.
(defn report [(w (ptr Writer)) (file (slice u8)) (src (slice u8)) (d Diag)]
  (-> i64)
  (print-str w "error: ")
  (if (or (< (.lo d) 0) (> (.lo d) (len src)))
      (print-str w (.msg d))
      (write-frame w
                   file
                   src
                   (locate src (.lo d))
                   (.lo d)
                   (.hi d)
                   (.msg d)
                   "-->"))
  (put w 10))
