;;; Edits to a file's text by byte span: applying them, and printing them as a diff.
(module coil.source.edit)
(import "coil.primitive" :as primitive)
(import "coil.alloc" :as alloc :use *)
(import "coil.arraylist" :use *)
(import "coil.io" :use *)
(import "coil.slice" :use *)
(import "coil.str" :use *)
(import "coil.source.cli" :use [ps wb])
(import "coil.source.diagnostic" :use [write-decimal])
(import "coil.text" :use [box-al sconcat sconcat3 i64->str append-bytes!])

; One rewrite of one file's byte range. `text` is the already-rendered replacement.
; `group` is the suggestion group a semantic round must apply or drop as a whole
; (`lint-sug-group`); preflight edits are never grouped and carry 0.
(defstruct LintEdit
  [(source i64) (lo i64) (hi i64) (text (slice u8)) (group i64)])

; Apply the edits for source `sid` to `src`, skipping any that overlap one already
; taken. Edits arrive sorted by descending `lo`. First select the non-overlapping
; edits in that order, then walk those edits backward to assemble the result once in
; source order. Repeated `sconcat3` splices retained one full copy of the source per
; edit in the round allocator: a generated multi-megabyte file with thousands of
; findings could therefore consume tens of gigabytes even when its final text was
; only slightly larger than its input.
; Returns the rewritten text (== `src` if nothing applied).
(defn lint-apply [(a (dyn Allocator))
                  (src (slice u8))
                  (edits (ptr (ArrayList LintEdit)))
                  (sid i64)] (-> (slice u8))
  (let [n (len (load edits))
        src-n (len src)
        (mut accepted) (ArrayList::new [LintEdit] a)
        (mut floor) (len src)  ; lowest offset already rewritten
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (let [ep (elem edits (load i))]
                  (when (and (= (.source ep) sid)
                             (and (<= (.hi ep) (load floor))
                                  (and (>= (.lo ep)
                                           0)
                                       (and (<= (.lo ep)
                                                (.hi ep))
                                            (<= (.hi ep) src-n)))))
                    (push! (mut accepted) (load ep))
                    (set! floor (.lo ep))
                    0))
                (set! i (primitive/iadd (load i) 1)))))
    (let [m (len (load accepted))]
      (if (= m 0)
          src
          (let [(mut out) (ArrayList::new [u8] a)
                (mut cursor) 0
                (mut j) (primitive/isub m 1)]
            (loop (if (< (load j) 0)
                      (break)
                      (let [ep (elem (mut accepted) (load j))]
                        (append-bytes! (mut out)
                                       (subslice [u8]
                                                 src
                                                 (load cursor)
                                                 (.lo ep)))
                        (append-bytes! (mut out) (.text ep))
                        (set! cursor (.hi ep))
                        (set! j (primitive/isub (load j) 1)))))
            (append-bytes! (mut out) (subslice [u8] src (load cursor) src-n))
            (slice (load out)))))))

; 1-based line number of byte `off`, and how many lines the range [lo,hi) spans —
; the two numbers a unified-diff hunk header is made of.
(defn lint-line-of [(src (slice u8)) (off i64)] (-> i64)
  (let [n (len src)
        cap (if (> off n) n off)
        (mut i) 0
        (mut line) 1]
    (loop (if (>= (load i) cap)
              (break)
              (do
                (when (= (primitive/cast i64 (get src (load i)))
                         10)
                  (set! line (primitive/iadd (load line) 1)))
                (set! i (primitive/iadd (load i) 1)))))
    (load line)))

; Start of the line containing `off`, and end of the line containing `off` (exclusive
; of the newline) — a hunk replaces WHOLE lines, so a fix inside a line still produces
; a patch a human (or `git apply`) can read.
(defn lint-line-start [(src (slice u8)) (off i64)] (-> i64)
  (let [(mut i) off]
    (loop (if (or (<= (load i) 0)
                  (= (primitive/cast i64 (get src (primitive/isub (load i) 1)))
                     10))
              (break)
              (set! i (primitive/isub (load i) 1))))
    (load i)))

(defn lint-line-end [(src (slice u8)) (off i64)] (-> i64)
  (let [n (len src)
        (mut i) (if (> off n) n off)]
    (loop (if (or (>= (load i) n)
                  (= (primitive/cast i64 (get src (load i)))
                     10))
              (break)
              (set! i (primitive/iadd (load i) 1))))
    (load i)))

; Print `text` as diff body lines, each prefixed with `mark`.
(defn lint-diff-lines [(w (ptr Writer)) (mark i64) (text (slice u8))] (-> i64)
  (let [n (len text)
        (mut i) 0
        (mut count) 0]
    (loop (if (>= (load i) n)
              (break)
              (let [e (lint-line-end text (load i))]
                (wb w mark)
                (ps w (subslice [u8] text (load i) e))
                (wb w 10)
                (set! count (primitive/iadd (load count) 1))
                (set! i (primitive/iadd e 1)))))
    (load count)))

; A unified diff of one edit. Deliberately ZERO context lines: the exact bytes that
; change are known, so a hunk is stated rather than recovered by a diff algorithm.
; The result still applies with `git apply --unidiff-zero`.
(defn lint-print-diff [(a (dyn Allocator))
                       (w (ptr Writer))
                       (path (slice u8))
                       (src (slice u8))
                       (e (ptr LintEdit))] (-> i64)
  (let [lo (.lo e)
        hi (.hi e)
        ls (lint-line-start src lo)
        le (lint-line-end src hi)
        old (subslice [u8] src ls le)
        new
          (sconcat3 a
                    (subslice [u8] src ls lo)
                    (.text e)
                    (subslice [u8] src hi le))]
    (ps w "--- a/")
    (ps w path)
    (wb w 10)
    (ps w "+++ b/")
    (ps w path)
    (wb w 10)
    (let [oldn (lint-count-lines old)
          newn (lint-count-lines new)
          start (lint-line-of src ls)]
      (ps w "@@ -")
      (ps w (i64->str a start))
      (ps w ",")
      (ps w (i64->str a oldn))
      (ps w " +")
      (ps w (i64->str a start))
      (ps w ",")
      (ps w (i64->str a newn))
      (ps w " @@")
      (wb w 10))
    (lint-diff-lines w 45 old)
    (lint-diff-lines w 43 new)
    0))

(defn lint-count-lines [(text (slice u8))] (-> i64)
  (let [n (len text)
        (mut i) 0
        (mut c) 1]
    (loop (if (>= (load i) n)
              (break)
              (do
                (when (= (primitive/cast i64 (get text (load i)))
                         10)
                  (set! c (primitive/iadd (load c) 1)))
                (set! i (primitive/iadd (load i) 1)))))
    (load c)))
