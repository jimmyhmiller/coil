(module coil.temp)
(export TempError TempUnavailable path sibling dir keep-for! remove! free cleanup!
        mkdtemp unlink rmdir atexit getuid base-dir root-dir remove-tree! dead?
        namespace-tag our-namespace?)
(import "coil.primitive" :as primitive)
(import "coil.io" :as io)
(import "coil.fmt" :use [fmt Display display-fmt Formatter])
(import "coil.alloc" :as alloc)
(import "coil.os" :as os)
(import "coil.fs" :as fs)
(import "coil.str" :as str)
(import "coil.slice" :use [subslice])
(import "coil.arraylist" :use [ArrayList])
(import "coil.cc" :as cc)

;;; Temporary files.
;;;
;;; Each process gets one directory, `$TMPDIR/coil-<uid>/<pid>-<tag>XXXXXX`, made on
;;; first use; `temp/path` names things inside it. `temp/sibling` names a file
;;; beside a destination, `.<name>.coil-tmp-<pid>-<tag><n>`, for writing it whole and
;;; renaming it into place on the destination's filesystem.
;;;
;;; Every path these return is the caller's: a `(slice u8)` from the malloc
;;; allocator, valid until the caller passes it to `temp/free`, independently of the
;;; file it names. Not freeing one only costs its bytes.
;;;
;;; Both are removed when the process exits. A process that died without exiting
;;; (`kill -9`, Ctrl-C) leaves them, so whatever makes a new temporary first removes
;;; the ones whose pid is no longer running: making a directory sweeps the other
;;; directories (one kept for a program still running from it stays), and naming a
;;; sibling sweeps the stale siblings of the same file.
;;;
;;; A pid means something only in its own PID namespace, and on Linux processes in
;;; different ones (sandboxes, containers) can share `$TMPDIR`: there another
;;; namespace's live process looks dead. So on Linux the pid in a name is followed
;;; by the namespace's tag, `ns<inode of /proc/self/ns/pid>-`, and a sweep judges
;;; only names that carry its own tag. Darwin has no PID namespaces and no tag.

(extern mkdtemp :cc (cc/C) [(ptr i8)] (-> (ptr i8)))

(extern unlink :cc (cc/C) [(ptr i8)] (-> i32))

(extern rmdir :cc (cc/C) [(ptr i8)] (-> i32))

(extern atexit :cc (cc/C) [(fnptr (cc/C) [] i64)] (-> i32))

(extern getuid :cc (cc/C) [] (-> u32))

(defsum TempError
  (TempUnavailable [(what (slice u8)) (code i64)]))

(derive Eq TempError)

;;; `{}` is a message for a person; an errno reads as the operating system describes it.
(impl Display TempError
  (display-fmt [(e TempError) (f (ptr Formatter))] (-> i64)
    (match e
      (TempUnavailable [what code]
        (fmt (writer f) "{}: " what)
        (io/write-os-error (writer f) code)))
    0))

;;; A sentence describing `e`, for an error message.
(impl TempError
  (text [(e TempError)] (-> (slice u8))
    (match e
      (TempUnavailable [what _] what))))

(defstruct TempState
  [(ready bool)
   (dir (slice u8))
   (counter i64)
   (siblings (ArrayList (slice u8)))])

(defn state [] (-> (ptr TempState))
  (primitive/alloc-static TempState))

(defn heap [] (-> (dyn alloc/Allocator))
  (alloc/malloc-allocator))

(defn cstr [(s (slice u8))] (-> (ptr i8))
  (str/to-cstr (heap) s))

(defn free-cstr [(p (ptr i8))] (-> i64)
  (str/free-cstr (heap) p))

;;; Release a path that `path`, `sibling` or `dir` returned. The file it
;;; names is untouched, and is still removed at exit.
(defn free [(path (slice u8))] (-> i64)
  (alloc/free [u8] (heap) path))

(defn copy [(s (slice u8))] (-> (slice u8))
  (let [(mut sb) (str/StrBuf::new (heap))]
    (push-str! (mut sb) s)
    (finish! (mut sb))))

(defn join [(dir (slice u8)) (name (slice u8))] (-> (slice u8))
  (let [(mut sb) (str/StrBuf::new (heap))]
    (push-str! (mut sb) dir)
    (push-str! (mut sb) "/")
    (push-str! (mut sb) name)
    (finish! (mut sb))))

(defn unavailable [(what (slice u8))] (-> TempError)
  (TempUnavailable what (os/errno)))

;;; `$TMPDIR` without its trailing slashes, or `/tmp`.
(defn base-dir [] (-> (slice u8))
  (let [p (os/getenv c"TMPDIR")]
    (if (= (primitive/cast i64 p) 0)
        "/tmp"
        (let [s (str/from-cstr p)
              (mut n) (len s)]
          (while (and (> n 1) (= (get s (- n 1)) (: 47 u8))) (set! n (- n 1)))
          (if (= n 0) "/tmp" (subslice s 0 n))))))

;;; `$TMPDIR/coil-<uid>`: per user, because a sweep deletes what it finds there.
(defn root-dir [] (-> (slice u8))
  (let [(mut sb) (str/StrBuf::new (heap))]
    (push-str! (mut sb) (base-dir))
    (push-str! (mut sb) "/coil-")
    (push-i64! (mut sb) (cast i64 (getuid)))
    (finish! (mut sb))))

; ---- removal -----------------------------------------------------------------

;;; The names in the directory at `path`, or none when it cannot be read. Release
;;; the list with `free-names`.
(defn dir-names [(path (slice u8))] (-> (ArrayList (slice u8)))
  (match (fs/Directory::list (heap) path)
    (Ok [names] names)
    (Err [_] (ArrayList::new [(slice u8)] (heap)))))

(defn free-names [(names (mut (ArrayList (slice u8))))] (-> i64)
  (fs/Directory::free-list (heap) (mut names)))

;;; Remove `path`: a file or symbolic link is unlinked, never followed; a directory
;;; is emptied and removed.
(defn remove-tree! [(path (slice u8))] (-> i64)
  (let [p (cstr path)]
    (when (!= (unlink p) (: 0 i32))
      (let [(mut names) (dir-names path)]
        (for name (iter names)
          (let [child (join path name)]
            (remove-tree! child)
            (free child)))
        (free-names (mut names)))
      (rmdir p)
      0)
    (free-cstr p))
  0)

;;; The pid a temporary's name starts with, read up to `-`; 0 when there is none.
(defn name-pid [(name (slice u8))] (-> i64)
  (let [(mut pid) 0
        (mut digits) 0]
    (while (and (< digits (len name))
                (and (>= (get name digits) (: 48 u8)) (<= (get name digits) (: 57 u8))))
      (set! pid (+ (* pid 10) (cast i64 (- (get name digits) (: 48 u8)))))
      (set! digits (+ digits 1)))
    (if (and (> digits 0) (and (< digits (len name)) (= (get name digits) (: 45 u8))))
        pid
        0)))

;;; This process's PID-namespace tag on Linux, `ns<inode>-`, read from the
;;; `pid:[<inode>]` that `/proc/self/ns/pid` links to; "" when that cannot be read.
;;; `readlink` is found with dlsym (as `os/errno-cell` finds errno), so no other
;;; target declares it.
(defn linux-namespace-tag [] (-> (slice u8))
  (let [readlink (os/dlsym-cached (primitive/alloc-static (ptr i8)) c"readlink" (primitive/cast (ptr i8) 0))
        buf (primitive/index (primitive/alloc-static (array u8 64)) 0)
        base (primitive/cast (ptr i8) buf)]
    (if (= (primitive/cast i64 readlink) 0)
        ""
        (let [n (primitive/call-ptr (primitive/cast (fnptr (cc/C) [(ptr i8) (ptr i8) i64] i64) readlink)
                                    c"/proc/self/ns/pid"
                                    base
                                    64)
              (mut lo) -1
              (mut hi) -1]
          (for i (range 0 (if (> n 0) n 0))
            (let [c (load (primitive/index buf i))]
              (when (and (< lo 0) (= c (: 91 u8))) (set! lo (+ i 1)))
              (when (and (>= lo 0) (< hi 0) (= c (: 93 u8))) (set! hi i))))
          (if (or (< lo 0) (<= hi lo))
              ""
              (let [(mut sb) (str/StrBuf::new (heap))]
                (push-str! (mut sb) "ns")
                (push-str! (mut sb) (slice::new (primitive/cast (ptr u8) (primitive/index buf lo)) (- hi lo)))
                (push-str! (mut sb) "-")
                (finish! (mut sb))))))))

;;; This process's PID-namespace tag: what follows `<pid>-` in the names it makes.
(defn namespace-tag [] (-> (slice u8))
  (let [cache (primitive/alloc-static (slice u8))
        known (primitive/alloc-static bool)]
    (unless (load known)
      (store! cache (os/os-pick (linux-namespace-tag) "" ""))
      (store! known true)
      0)
    (load cache)))

;;; Whether `name`, a `<pid>-…` name, was made in this process's PID namespace, so
;;; its pid can be judged here: what follows `<pid>-` is our tag. On Linux without
;;; a readable `/proc`, a name with no tag is ours and a tagged one is not; Darwin
;;; has one namespace, so every name is ours.
(defn our-namespace? [(name (slice u8))] (-> bool)
  (let [(mut i) 0]
    (while (and (< i (len name)) (>= (get name i) (: 48 u8)) (<= (get name i) (: 57 u8)))
      (set! i (+ i 1)))
    (let [rest (subslice name (if (< i (len name)) (+ i 1) i) (len name))
          tag (namespace-tag)]
      (if (> (len tag) 0)
          (str/starts-with rest tag)
          (os/os-pick (not (and (str/starts-with rest "ns")
                                (> (len rest) 2)
                                (>= (get rest 2) (: 48 u8))
                                (<= (get rest 2) (: 57 u8))))
                      true
                      true)))))

;;; Whether no process with this pid is running.
(defn dead? [(pid i64)] (-> bool)
  (and (> pid 0)
       (and (!= pid (cast i64 (os/getpid)))
            (and (< (os/kill (cast i32 pid) (: 0 i32)) (: 0 i32))
                 (= (os/errno) 3)))))

;;; Whether the temporary directory `path`, named `name`, belongs to nobody running:
;;; it was made in this PID namespace, its owner is gone, and so is every process
;;; it was kept for (`keep-for!`).
(defn abandoned? [(path (slice u8)) (name (slice u8))] (-> bool)
  (and (our-namespace? name)
       (dead? (name-pid name))
       (let [(mut alive) false
             (mut names) (dir-names path)]
         (for entry (iter names)
           (when (and (str/starts-with entry ".keep-")
                      (not (dead? (name-pid (subslice entry 6 (len entry))))))
             (set! alive true)))
         (free-names (mut names))
         (not alive))))

; ---- the directory -----------------------------------------------------------

;;; Remove this process's temporary files. Registered with `atexit`.
(defn cleanup! [] (-> i64)
  (let [st (state)]
    (when (.ready st)
      (set! (.ready st) false)
      (for path (iter (.siblings st)) (remove-tree! path))
      (remove-tree! (.dir st))
      0))
  0)

(defn make-dir! [(st (ptr TempState))] (-> (Result i64 TempError))
  (let [root (root-dir)
        result (make-dir-in! st root)]
    (free root)
    result))

(defn make-dir-in! [(st (ptr TempState)) (root (slice u8))] (-> (Result i64 TempError))
  (let [croot (cstr root)]
    (fs/make-dir croot 448)
    ; Sweep only a directory we own: `fchmod` succeeds only for its owner.
    (let [fd (os/open croot (cast i32 (+ fs/O_RDONLY (+ fs/O_DIRECTORY (+ fs/O_NOFOLLOW fs/O_CLOEXEC)))))
          owned (and (>= fd (: 0 i32)) (= (fs/change-mode fd 448) (: 0 i32)))
          ; read errno before anything below can change it
          failure (if owned
                      (: (None) (Option TempError))
                      (Some (unavailable "the temporary directory root is missing or not owned by this user")))]
      (when (>= fd (: 0 i32)) (os/close fd))
      (free-cstr croot)
      (match failure
        (Some [e] (Err e))
        (None []
            (let [(mut names) (dir-names root)]
              (for name (iter names)
                (let [path (join root name)]
                  (when (abandoned? path name) (remove-tree! path))
                  (free path)))
              (free-names (mut names)))
            (let [(mut tb) (str/StrBuf::new (heap))]
              (push-str! (mut tb) root)
              (push-str! (mut tb) "/")
              (push-i64! (mut tb) (cast i64 (os/getpid)))
              (push-str! (mut tb) "-")
              (push-str! (mut tb) (namespace-tag))
              (push-str! (mut tb) "XXXXXX")
              (let [template (finish! (mut tb))
                    ctemplate (cstr template)
                    made (mkdtemp ctemplate)
                    result
                      (if (= (primitive/cast i64 made) 0)
                          (Err (unavailable "cannot make a temporary directory"))
                          (do
                            (set! (.dir st) (copy (str/from-cstr made)))
                            (set! (.siblings st) (ArrayList::new [(slice u8)] (heap)))
                            (atexit (fnptr-of cleanup!))
                            (set! (.ready st) true)
                            (Ok 0)))]
                (free-cstr ctemplate)
                (free template)
                result)))))))

;;; This process's temporary directory, made on first use.
(defn dir [] (-> (Result (slice u8) TempError))
  (match (dir-ready)
    (Err [e] (Err e))
    (Ok [dir] (Ok (copy dir)))))

;; The directory itself, owned by the temp state.
(defn dir-ready [] (-> (Result (slice u8) TempError))
  (let [st (state)]
    (if (.ready st)
        (Ok (.dir st))
        (match (make-dir! st)
          (Err [e] (Err e))
          (Ok [_] (Ok (.dir st)))))))

;;; A fresh name in this process's temporary directory ending in `name`. Nothing is
;;; created; whatever is made there, file or directory, goes with the directory.
(defn path [(name (slice u8))] (-> (Result (slice u8) TempError))
  (match (dir-ready)
    (Err [e] (Err e))
    (Ok [dir]
      (let [st (state)
            (mut sb) (str/StrBuf::new (heap))]
        (set! (.counter st) (+ (.counter st) 1))
        (push-str! (mut sb) dir)
        (push-str! (mut sb) "/")
        (push-i64! (mut sb) (.counter st))
        (push-str! (mut sb) "-")
        (push-str! (mut sb) name)
        (Ok (finish! (mut sb)))))))

;;; Keep this process's directory for process `pid` too: one that runs a program
;;; from it, say. If this process is killed, the directory stays until `pid` is
;;; gone as well.
(defn keep-for! [(pid i64)] (-> (Result i64 TempError))
  (match (dir-ready)
    (Err [e] (Err e))
    (Ok [dir]
      (let [(mut sb) (str/StrBuf::new (heap))]
        (push-str! (mut sb) ".keep-")
        (push-i64! (mut sb) pid)
        (push-str! (mut sb) "-")
        (let [name (finish! (mut sb))
              path (join dir name)
              cpath (cstr path)
              fd (fs/create-file cpath 384)
              ; before the frees below can change errno
              error (if (< fd 0) (Some (unavailable "cannot mark a temporary directory")) (: (None) (Option TempError)))]
          (free-cstr cpath)
          (free path)
          (free name)
          (match error
            (Some [e] (Err e))
            (None [] (do (os/close (cast i32 fd)) (Ok 0)))))))))

; ---- siblings ----------------------------------------------------------------

;;; A fresh name beside `dest`, `.<name>.coil-tmp-<pid>-<tag><n>`, for writing a file or
;;; directory and renaming it to `dest`. Removed at exit if it still exists. Stale
;;; siblings of `dest` from processes that are gone are removed first.
(defn sibling [(dest (slice u8))] (-> (Result (slice u8) TempError))
  (match (dir-ready)
    (Err [e] (Err e))
    (Ok [_]
      (let [st (state)
            (mut cut) 0]
        (for i (range 0 (len dest))
          (when (= (get dest i) (: 47 u8)) (set! cut (+ i 1))))
        (let [dir (subslice dest 0 cut)
              (mut pb) (str/StrBuf::new (heap))]
          (push-str! (mut pb) ".")
          (push-str! (mut pb) (subslice dest cut (len dest)))
          (push-str! (mut pb) ".coil-tmp-")
          (let [prefix (finish! (mut pb))]
            (sweep-siblings! dir prefix)
            (set! (.counter st) (+ (.counter st) 1))
            (let [(mut sb) (str/StrBuf::new (heap))]
              (push-str! (mut sb) dir)
              (push-str! (mut sb) prefix)
              (push-i64! (mut sb) (cast i64 (os/getpid)))
              (push-str! (mut sb) "-")
              (push-str! (mut sb) (namespace-tag))
              (push-i64! (mut sb) (.counter st))
              (free prefix)
              (let [path (finish! (mut sb))]
                ; the state keeps its own copy for the exit cleanup
                (push! (mut (.siblings st)) (copy path))
                (Ok path)))))))))

;;; Remove every `<prefix><pid>-…` in `dir` made in this PID namespace whose pid
;;; is not running.
(defn sweep-siblings! [(dir (slice u8)) (prefix (slice u8))] (-> i64)
  (let [(mut names) (dir-names (if (= (len dir) 0) "." dir))]
    (for name (iter names)
      (when (and (str/starts-with name prefix)
                 (our-namespace? (subslice name (len prefix) (len name)))
                 (dead? (name-pid (subslice name (len prefix) (len name)))))
        (let [(mut sb) (str/StrBuf::new (heap))]
          (push-str! (mut sb) dir)
          (push-str! (mut sb) name)
          (let [path (finish! (mut sb))]
            (remove-tree! path)
            (free path)))))
    (free-names (mut names)))
  0)

;;; Remove `path`, a file or a whole directory, now: for a temporary finished with
;;; before the process exits.
(defn remove! [(path (slice u8))] (-> i64)
  (remove-tree! path))
