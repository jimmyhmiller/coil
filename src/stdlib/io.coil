(module coil.io)
(import "coil.primitive" :as primitive)
(import "coil.alloc" :as alloc)
(import "coil.os" :as os)

; Zig-style IO: a capability is a VALUE (a vtable struct) threaded explicitly,
; exactly like the allocator. A `Writer` is `{ write-fn, ctx }`; a function that
; does output *takes* a Writer, so IO shows up in its type. There is no ambient
; stdout -- you pass `(stdout)` (or a buffer, or a null sink) in.
;
;   write-fn (ctx, bytes, len) -> (Result n IoError)   ; n = bytes written
;   read-fn  (ctx, buf,   len) -> (Result n IoError)   ; n = bytes read, 0 = EOF
;
; Errors are a sum type (Result), never a -1 sentinel. Constructors like `(Ok n)`
; / `(Err e)` carry no type annotations: the checker pushes the expected
; `(Result :i64 IoError)` in from each function's return type (bidirectional
; checking), filling even the error type that `Ok` mentions in no field.
(import "coil.result" :use *)
(import "coil.fmt" :use [fmt Display display-fmt Formatter])
(import "coil.cc" :as cc)

(export IoError
        Eof
        Errno
        LineTooLong
        OutOfMemory
        InvalidLimit
        WriteZero
        BufferFull
        write-os-error
        Writer
        write-some
        write-all
        write-byte
        print-str
        write-line
        print-cstr
        print-int
        stdout
        stderr
        BufferedWriter
        BufferedOutput
        FixBuf
        Reader
        read-some
        read-fill
        read-exact
        read-line
        OwnedBytes
        read-line-alloc
        read-to-end
        fd-retry?
        stdin
        BufferedReader
        BufferedInput
        read
        write
        strlen memcpy memchr fill-buffer take-buffered buffered? read-line-buffered read-line-alloc-buffered)

(extern write :cc (cc/C) [i32 (ptr i8) isize] (-> isize))  ; ssize_t write(int fd, const void*, size_t)

(extern read :cc (cc/C) [i32 (ptr i8) isize] (-> isize))  ; ssize_t read(int fd, void*, size_t)

(extern strlen :cc (cc/C) [(ptr i8)] (-> isize))  ; size_t strlen(const char*)

(extern memcpy :cc (cc/C) [(ptr i8) (ptr i8) isize] (-> (ptr i8)))  ; void* memcpy(void*, const void*, size_t)

(extern memchr :cc (cc/C) [(ptr i8) i32 isize] (-> (ptr i8)))  ; void* memchr(const void*, int, size_t)

(defsum IoError
  (Eof)
  ; the operating system reported this errno
  (Errno [(code i64)])
  (LineTooLong)
  (OutOfMemory)
  (InvalidLimit)
  ; a write accepted no bytes
  (WriteZero)
  ; a fixed-capacity sink had no room left
  (BufferFull))

(derive Eq IoError)

;;; `{}` of an IoError is a sentence for a person: an `Errno` reads as the C
;;; library's text for that code, then `(os error N)`.
(impl Display IoError
  (display-fmt [(e IoError) (f (ptr Formatter))] (-> i64)
    (let [w (writer f)]
      (match e
        (Eof [] (print-str w "unexpected end of input"))
        (Errno [code] (write-os-error w code))
        (LineTooLong [] (print-str w "line too long"))
        (OutOfMemory [] (print-str w "out of memory"))
        (InvalidLimit [] (print-str w "invalid limit"))
        (WriteZero [] (print-str w "write accepted no bytes"))
        (BufferFull [] (print-str w "buffer full"))))
    0))

;;; Write the operating system's description of errno `code`, followed by
;;; `(os error N)`, as in "No such file or directory (os error 2)". Every standard
;;; library error that carries an errno displays it through this.
(defn write-os-error [(w (ptr Writer)) (code i64)] (-> (Result i64 IoError))
  (fmt w "{} (os error {})" (os/errno-message code) code))

; ============================ Writer ========================================
(defstruct Writer
  [(write-fn (fnptr (cc/C) [(ptr i8) (ptr i8) i64] (Result i64 IoError)))
   (ctx (ptr i8))])

;;; One underlying write; may be short (writes fewer than `len` bytes).
(defn write-some [(w (ptr Writer)) (buf (ptr i8)) (len i64)] (-> (Result i64
                                                                            IoError))
  (primitive/call-ptr (load (field w write-fn)) (load (field w ctx)) buf len))

;;; Write the whole buffer, looping over short writes; returns the total or errors.
(defn write-all [(w (ptr Writer)) (buf (ptr i8)) (len i64)] (-> (Result i64
                                                                           IoError))
  (if (<= len 0)
      (Ok 0)
      (match (write-some w buf len)
        (Err [e] (Err e))
        (Ok [n]
            (if (<= n 0)
                (Err (WriteZero))
                (match (write-all w
                                  (primitive/index buf n)
                                  (primitive/isub len n))
                  (Err [e] (Err e))
                  (Ok [m] (Ok (primitive/iadd n m)))))))))

(defn write-byte [(w (ptr Writer)) (b u8)] (-> (Result i64 IoError))
  (let [p (primitive/alloc-stack u8)]
    (store! p b)
    (write-all w (primitive/cast (ptr i8) p) 1)))

;;; Write a `(slice u8)` string — its length is carried, so no `strlen` scan and
;;; embedded NULs are fine. This is the everyday string printer.
(defn print-str [(w (ptr Writer)) (s (slice u8))] (-> (Result i64 IoError))
  (write-all w (primitive/cast (ptr i8) (data s)) (len s)))

;;; Write a byte slice followed by one newline. The returned count includes the newline.
(defn write-line [(w (ptr Writer)) (s (slice u8))] (-> (Result i64 IoError))
  (match (print-str w s)
    (Err [e] (Err e))
    (Ok [n]
        (match (write-byte w (primitive/cast u8 #\newline))
          (Err [e] (Err e))
          (Ok [m] (Ok (primitive/iadd n m)))))))

;;; Write a NUL-terminated C string (`c"…"` / a `(ptr i8)` from FFI).
(defn print-cstr [(w (ptr Writer)) (s (ptr i8))] (-> (Result i64 IoError))
  (write-all w s (primitive/cast i64 (strlen s))))

;;; Write a non-negative integer in decimal, most-significant digit first.
;;; Decimal `n`, with a leading `-` when negative (i64 MIN included).
(defn print-int [(w (ptr Writer)) (n i64)] (-> (Result i64 IoError))
  (if (< n 0)
      (match (write-byte w (: 45 u8))
        (Err [e] (Err e))
        ; Work on the non-positive value: -MIN does not fit in i64.
        (Ok [_] (print-nonpositive w n)))
      (print-nonpositive w (- 0 n))))

(defn print-nonpositive [(w (ptr Writer)) (n i64)] (-> (Result i64 IoError))
  (if (> n -10)
      (write-byte w (primitive/cast u8 (- 48 n)))
      (match (print-nonpositive w (primitive/idiv n 10))
        (Err [e] (Err e))
        (Ok [_] (write-byte w (primitive/cast u8 (- 48 (primitive/irem n 10))))))))

; ---- backends ----
; An fd Reader or Writer is a blocking stream, whatever the descriptor's own mode:
; a caller handed a descriptor some other process made non-blocking (Ruby's Open3
; and Node do this to pipes) still reads to the end and writes everything. Without
; that, EAGAIN read as end of input and a write error went unseen, and `coil fmt -`
; under such a parent printed a truncated file and exited 0.
(defstruct FdWait [(fd i32) (events i16) (revents i16)])

;;; Wait, without a time limit, until `fd` is ready for `events` (poll's POLLIN 1,
;;; POLLOUT 4); `poll` is found with dlsym through `handle`, the C library's
;;; RTLD_DEFAULT, as `os/errno-cell` finds its accessor. False if it cannot wait.
(defn poll-one [(fd i32) (events i16) (handle (ptr i8))] (-> bool)
  (let [entry (primitive/alloc-stack FdWait)
        poll (os/dlsym-cached (primitive/alloc-static (ptr i8)) c"poll" handle)]
    (store! (field entry fd) fd)
    (store! (field entry events) events)
    (store! (field entry revents) (: 0 i16))
    (if (= (primitive/cast i64 poll) 0)
        false
        (let [rc (primitive/call-ptr (primitive/cast (fnptr (cc/C) [(ptr FdWait) i64 i32] i32) poll)
                                     entry
                                     1
                                     (: -1 i32))]
          ; an interrupted wait is retried by the caller's retried call
          (or (>= rc (: 0 i32)) (= (os/errno) 4))))))

;;; Whether a read or write of `fd` that failed with errno `code` should be made
;;; again: it was interrupted (EINTR), or the descriptor is non-blocking and not
;;; ready (EAGAIN), in which case this first waits until it is ready for `events`.
(defn fd-retry? [(fd i32) (code i64) (events i16)] (-> bool)
  (cond (= code 4) true
        (= code (os/os-pick-with-none 11 35 35 35))
          (os/os-pick-with-none (poll-one fd events (primitive/cast (ptr i8) 0))
                                (poll-one fd events (primitive/cast (ptr i8) -2))
                                false
                                false)
        :else false))

;;; fd-backed: the ctx pointer *is* the file descriptor (int<->ptr cast).
(defn write-fd [(ctx (ptr i8)) (buf (ptr i8)) (len i64)] (-> (Result i64
                                                                        IoError))
  (let [fd (primitive/cast i32 ctx)]
    (block :done
      (loop (let [n (primitive/cast i64 (write fd buf (primitive/cast isize len)))]
              (if (>= n 0)
                  (return-from :done (Ok n))
                  (let [code (os/errno)]
                    (unless (fd-retry? fd code (: 4 i16))
                      (return-from :done (Err (Errno code)))))))))))

;;; null sink: discards everything, always succeeds.
(defn write-null [(ctx (ptr i8)) (buf (ptr i8)) (len i64)] (-> (Result i64
                                                                          IoError))
  (Ok len))

(impl Writer
  ;;; The caller owns the Writer cell. `alloc-static` gives ONE cell per CALL SITE, not
  ;;; per call, so building the Writer in here handed every caller the SAME struct: two
  ;;; live fd writers on different fds aliased, and the aliasing was already known to
  ;;; bite — it is why `coil emit-ir f > f.ll` once yielded an empty file (the IR write
  ;;; landed on fd 2 after a diagnostic touched stderr). The previous fix gave
  ;;; stdout/stderr their own statics; that treated the symptom, and `stdin` (via
  ;;; `Reader::from-fd`) still shared one. A static is right for a genuine singleton at
  ;;; ITS OWN site — never for instance state.
  (from-fd [(w (ptr Writer)) (fd i64)] (-> (ptr Writer))
    (store! (field w write-fn) (primitive/fnptr-of write-fd))
    (store! (field w ctx) (primitive/cast (ptr i8) fd))
    w)

  ;;; A sink that discards everything. A static IS correct here: it has no instance
  ;;; state (its ctx is always 0 and its write-fn is constant), so every instance is
  ;;; interchangeable and sharing one is unobservable — unlike `from-fd`, whose ctx
  ;;; carries the fd. It is constant data, never written after load, so threads
  ;;; may share it.
  (null [] (-> (ptr Writer))
    (primitive/alloc-static Writer
                            (Writer :write-fn (primitive/fnptr-of write-null)
                                    :ctx (primitive/cast (ptr i8) 0)))))

;;; the standard streams ARE singletons: each owns a dedicated static at its own call
;;; site, initialized as constant data rather than rewritten on every call, so threads
;;; printing at once never race on it.
(defn stdout [] (-> (ptr Writer))
  (primitive/alloc-static Writer
                          (Writer :write-fn (primitive/fnptr-of write-fd)
                                  :ctx (primitive/cast (ptr i8) 1))))

(defn stderr [] (-> (ptr Writer))
  (primitive/alloc-static Writer
                          (Writer :write-fn (primitive/fnptr-of write-fd)
                                  :ctx (primitive/cast (ptr i8) 2))))

; Buffered output for serializers that emit many tiny fragments. `write-byte`
; deliberately remains an unbuffered primitive; buffering is explicit and
; caller-owned, so diagnostics and ordinary program output never disappear
; behind an implicit flush boundary.
(defstruct BufferedWriter
  [(inner (ptr Writer))
   (data (ptr i8))
   (len i64)
   (cap i64)])

(defn write-buffered [(ctx (ptr i8)) (src (ptr i8)) (len i64)] (-> (Result i64
                                                                              IoError))
  (let [b (primitive/cast (ptr BufferedWriter) ctx)
        cap (load (field b cap))]
    (if (<= len 0)
        (Ok 0)
        (if (<= cap 0)
            (write-all (load (field b inner)) src len)
            (let [used (load (field b len))
                  room (primitive/isub cap used)]
              (if (<= len room)
                  (do
                    (memcpy (primitive/index (load (field b data)) used)
                            src
                            (primitive/cast isize len))
                    (store! (field b len) (primitive/iadd used len))
                    (Ok len))
                  (match (flush b)
                    (Err [e] (Err e))
                    (Ok [_]
                        (if (>= len cap)
                            (write-all (load (field b inner)) src len)
                            (write-buffered ctx src len))))))))))

(impl BufferedWriter
  ;;; Initialize a caller-owned writer/state pair over caller-owned storage.
  (init [(w (ptr Writer))
         (b (ptr BufferedWriter))
         (inner (ptr Writer))
         (data (ptr i8))
         (cap i64)] (-> (ptr Writer))
    (store! (field b inner) inner)
    (store! (field b data) data)
    (store! (field b len) 0)
    (store! (field b cap) cap)
    (store! (field w write-fn) (primitive/fnptr-of write-buffered))
    (store! (field w ctx) (primitive/cast (ptr i8) b))
    w)

  ;;; Flush pending bytes to the wrapped writer.
  (flush [(b (ptr BufferedWriter))] (-> (Result i64 IoError))
    (let [n (load (field b len))]
      (if (<= n 0)
          (Ok 0)
          (match (write-all (load (field b inner)) (load (field b data)) n)
            (Err [e] (Err e))
            (Ok [written]
                (do
                  (store! (field b len) 0)
                  (Ok written))))))))

; Convenient fixed-capacity owner for compiler dumps and similar bounded-stack
; serializers. It is intentionally instantiated by the caller, never static.
(defstruct BufferedOutput
  [(state BufferedWriter)
   (writer Writer)
   (buffer (array i8 65536))])

(impl BufferedOutput
  ;;; Initialize `out` and return its buffered writer.
  (init [(out (ptr BufferedOutput)) (inner (ptr Writer))] (-> (ptr Writer))
    (BufferedWriter::init (field out writer)
                          (field out state)
                          inner
                          (primitive/cast (ptr i8) (field out buffer))
                          65536))

  ;;; Flush a caller-owned `BufferedOutput`.
  (flush [(out (ptr BufferedOutput))] (-> (Result i64 IoError))
    (flush (field out state))))

;;; fixed-buffer sink: writes into a caller-provided byte buffer, tracking how
;;; much is used (Zig's fixedBufferStream). Errors with `BufferFull` when full.
(defstruct FixBuf [(data (ptr i8)) (len i64) (cap i64)])

(defn write-fixbuf [(ctx (ptr i8)) (buf (ptr i8)) (len i64)] (-> (Result i64
                                                                        IoError))
  (let [fb (primitive/cast (ptr FixBuf) ctx)
        cur (load (field fb len))
        room (primitive/isub (load (field fb cap)) cur)
        n (if (< len room) len room)]
    (memcpy (primitive/index (load (field fb data)) cur)
            buf
            (primitive/cast isize n))
    (store! (field fb len) (primitive/iadd cur n))
    (if (< n len) (Err (BufferFull)) (Ok n))))

(impl FixBuf
  ;;; Initialize a caller-owned Writer over an existing FixBuf (data/cap already set,
  ;;; len 0). The Writer cell is the caller's: formatting into two buffers at once is
  ;;; the whole point of this sink, and a shared static silently merged both into
  ;;; whichever was made last.
  (writer [(w (ptr Writer)) (fb (ptr FixBuf))] (-> (ptr Writer))
    (store! (field fb len) 0)
    (store! (field w write-fn) (primitive/fnptr-of write-fixbuf))
    (store! (field w ctx) (primitive/cast (ptr i8) fb))
    w))

; ============================ Reader ========================================
(defstruct Reader
  [(read-fn (fnptr (cc/C) [(ptr i8) (ptr i8) i64] (Result i64 IoError)))
   (ctx (ptr i8))])

(defn read-some [(r (ptr Reader)) (buf (ptr i8)) (len i64)] (-> (Result i64
                                                                           IoError))
  (primitive/call-ptr (load (field r read-fn)) (load (field r ctx)) buf len))

;;; Fill `buf` by looping over short reads until it holds `len` bytes OR the stream ends;
;;; returns the total read (which is `< len` only at EOF). The read mirror of `write-all`
;;; — but where a short WRITE with no progress is an error, a short READ of 0 is EOF, a
;;; normal stop, so this returns the partial count rather than erroring. (Named
;;; `read-fill`, not `read-all`, so it never collides with the s-expression reader's
;;; `read-all` in src/stdlib/sexp.coil when both are imported.)
(defn read-fill [(r (ptr Reader)) (buf (ptr i8)) (len i64)] (-> (Result i64
                                                                           IoError))
  (if (<= len 0)
      (Ok 0)
      (match (read-some r buf len)
        (Err [e] (Err e))
        (Ok [n]
            (if (<= n 0)
                (Ok 0)  ; EOF — no more bytes
                (match (read-fill r
                                  (primitive/index buf n)
                                  (primitive/isub len n))
                  (Err [e] (Err e))
                  (Ok [m] (Ok (primitive/iadd n m)))))))))

;;; Read EXACTLY `len` bytes, or fail: `(Err (Eof))` if the stream ends first. For
;;; fixed-size records/headers where a short read is a real error, not a normal stop.
(defn read-exact [(r (ptr Reader)) (buf (ptr i8)) (len i64)] (-> (Result i64
                                                                            IoError))
  (match (read-fill r buf len)
    (Err [e] (Err e))
    (Ok [n] (if (= n len) (Ok n) (Err (Eof))))))

;;; Read one line into `buf` (up to `cap` bytes): stop after a newline (consumed, NOT
;;; stored), at `cap`, or at EOF. Returns the number of content bytes stored. `(Err (Eof))`
;;; iff the stream ended before ANY byte was read (so a caller can loop until Eof; a final
;;; line with no trailing newline is returned once, then the next call reports Eof).
;;; Over a reader from `BufferedReader::init` it copies whole runs out of the buffer; over
;;; any other reader it must read a byte at a time, one call each, so that it never
;;; consumes past the newline. Wrap a file or socket in a BufferedReader to read lines
;;; from it.
(defn read-line [(r (ptr Reader)) (buf (ptr i8)) (cap i64)] (-> (Result i64
                                                                           IoError))
  (if (buffered? r)
      (read-line-buffered (primitive/cast (ptr BufferedReader) (load (field r ctx))) buf cap)
      (let [(mut i) 0
            one (primitive/alloc-stack u8)]
        (block :done
                 (loop (if (>= (load i) cap)
                           (return-from :done (Ok (load i)))
                           0)
                   (match (read-some r (primitive/cast (ptr i8) one) 1)
                     (Err [e] (return-from :done (Err e)))
                     (Ok [n]
                         (if (<= n 0)
                             (return-from :done
                                            (if (= (load i) 0)
                                                (Err (Eof))
                                                (Ok (load i))))  ; EOF
                             (let [c (load one)]
                               (if (= (primitive/cast i64 c) (cast i64 #\newline))
                                   (return-from :done (Ok (load i)))
                                   (do
                                     (store! (primitive/index buf (load i))
                                             (primitive/cast i8 c))
                                     (store! i (primitive/iadd (load i) 1)))))))))))))

;;; An allocator-owned line whose capacity is retained so every allocator, including an
;;; arena, can release it with the exact size it received. The byte slice excludes the
;;; consumed newline. `OwnedBytes::free` is idempotent for one object.
(defstruct OwnedBytes
  [(bytes (slice u8))
   (capacity i64)])

(defn make-owned-bytes [(data (ptr i8)) (len i64) (capacity i64)] (-> OwnedBytes)
  (let [out (primitive/alloc-stack OwnedBytes)]
    (store! (field out bytes) (slice::new (primitive/cast (ptr u8) data) len))
    (store! (field out capacity) capacity)
    (load out)))

(impl OwnedBytes
  ;;; Return the owned line's bytes as a slice view. The view remains valid until free.
  (slice [(bytes OwnedBytes)] (-> (slice u8))
    (load (field bytes bytes)))

  ;;; Release an OwnedBytes allocation. The caller must not use its slice afterward.
  (free [(a (dyn alloc/Allocator)) (bytes (ptr OwnedBytes))] (-> i64)
    (let [capacity (load (field bytes capacity))]
      (if (> capacity 0)
          (alloc/free [i8]
                      a
                      (slice::new (primitive/cast (ptr i8)
                                                  (data (load (field bytes
                                                                     bytes))))
                                  capacity))
          0)
      (store! (field bytes bytes) (slice::new (primitive/cast (ptr u8) 0) 0))
      (store! (field bytes capacity) 0)
      0)))

;;; Read one newline-terminated line into allocator-owned storage. The newline is
;;; consumed and omitted. A final unterminated line is returned once, then the next call
;;; returns Eof. `max-bytes` limits content bytes, not the newline. Like `read-line`, it
;;; reads a byte per call unless `r` comes from `BufferedReader::init`.
(defn read-line-alloc [(a (dyn alloc/Allocator))
                       (r (ptr Reader))
                       (max-bytes i64)] (-> (Result OwnedBytes IoError))
  (cond
    (< max-bytes 0) (Err (InvalidLimit))
    (buffered? r)
      (read-line-alloc-buffered a (primitive/cast (ptr BufferedReader) (load (field r ctx))) max-bytes)
    :else
      (let [(mut buffer) (primitive/cast (ptr i8) 0)
            (mut len) 0
            (mut capacity) 0
            one (primitive/alloc-stack i8)]
        (block :done
                 (loop (match (read-some r one 1)
                         (Err [e]
                              (do
                                (if (> (load capacity) 0)
                                    (alloc/free [i8]
                                                a
                                                (slice::new (load buffer)
                                                            (load capacity)))
                                    0)
                                (return-from :done (Err e))))
                         (Ok [n]
                             (if (<= n 0)
                                 (return-from :done
                                                (if (= (load len) 0)
                                                    (Err (Eof))
                                                    (Ok (make-owned-bytes (load buffer)
                                                                          (load len)
                                                                          (load capacity)))))
                                 (let [c (load one)]
                                   (if (= (primitive/cast i64 c)
                                          (cast i64 #\newline))
                                       (return-from :done
                                                      (Ok (make-owned-bytes (load buffer)
                                                                            (load len)
                                                                            (load capacity))))
                                       (if (>= (load len) max-bytes)
                                           (do
                                             (if (> (load capacity)
                                                    0)
                                                 (alloc/free [i8]
                                                             a
                                                             (slice::new (load buffer)
                                                                         (load capacity)))
                                                 0)
                                             (return-from :done
                                                            (Err (LineTooLong))))
                                           (do
                                             (when (>= (load len)
                                                       (load capacity))
                                               (let [new-cap
                                                       (if (= (load capacity)
                                                              0)
                                                           (if (< max-bytes
                                                                  64)
                                                               max-bytes
                                                               64)
                                                           (if (> (load capacity)
                                                                  (primitive/idiv max-bytes
                                                                                  2))
                                                               max-bytes
                                                               (primitive/imul (load capacity)
                                                                               2)))]
                                                 (match (alloc/reallocate [i8]
                                                                          a
                                                                          (slice::new (load buffer)
                                                                                      (load capacity))
                                                                          new-cap)
                                                   (None []
                                                         (do
                                                           (alloc/free [i8]
                                                                       a
                                                                       (slice::new (load buffer)
                                                                                   (load capacity)))
                                                           (return-from :done
                                                                          (Err (OutOfMemory)))))
                                                   (Some [memory]
                                                         (do
                                                           (store! buffer
                                                                   (data memory))
                                                           (store! capacity
                                                                   new-cap))))))
                                             (store! (primitive/index (load buffer)
                                                                      (load len))
                                                     c)
                                             (store! len
                                                     (primitive/iadd (load len)
                                                                     1))))))))))))))

;;; fd-backed, and blocking like `write-fd`.
(defn read-fd [(ctx (ptr i8)) (buf (ptr i8)) (len i64)] (-> (Result i64
                                                                       IoError))
  (let [fd (primitive/cast i32 ctx)]
    (block :done
      (loop (let [n (primitive/cast i64 (read fd buf (primitive/cast isize len)))]
              (if (>= n 0)
                  (return-from :done (Ok n))
                  (let [code (os/errno)]
                    (unless (fd-retry? fd code (: 1 i16))
                      (return-from :done (Err (Errno code)))))))))))

;;; Read `r` to its end into allocator-owned storage (free it with
;;; `OwnedBytes::free`). Empty input is `(Ok …)` with no bytes, not `Eof`.
(defn read-to-end [(a (dyn alloc/Allocator)) (r (ptr Reader))] (-> (Result OwnedBytes IoError))
  (let [(mut data) (primitive/cast (ptr i8) 0)
        (mut len) 0
        (mut capacity) 0
        run 65536]
    (block :done
      (loop
        (unless (grow-line a (mut data) (mut capacity) (+ len run) 9223372036854775807)
          (return-from :done (Err (OutOfMemory))))
        (match (read-some r (primitive/index (load data) len) (- capacity len))
          (Err [e]
               (do
                 (when (> capacity 0) (alloc/free [i8] a (slice::new (load data) capacity)))
                 (return-from :done (Err e))))
          (Ok [n]
              (if (<= n 0)
                  (return-from :done (Ok (make-owned-bytes (load data) len capacity)))
                  (set! len (+ len n)))))))))

(impl Reader
  ;;; caller-owned, for the same reason as `Writer::from-fd`.
  (from-fd [(r (ptr Reader)) (fd i64)] (-> (ptr Reader))
    (store! (field r read-fn) (primitive/fnptr-of read-fd))
    (store! (field r ctx) (primitive/cast (ptr i8) fd))
    r))

(defn stdin [] (-> (ptr Reader))
  (primitive/alloc-static Reader
                          (Reader :read-fn (primitive/fnptr-of read-fd)
                                  :ctx (primitive/cast (ptr i8) 0))))

; ============================ BufferedReader ================================
; Buffered input, the mirror of BufferedWriter: caller-owned state over
; caller-owned storage. `BufferedReader::init` returns an ordinary `(ptr Reader)`, so
; every Reader function works on it, and `read-line`/`read-line-alloc` recognize it
; and take whole runs of bytes out of the buffer instead of one byte per call.
(defstruct BufferedReader
  [(inner (ptr Reader))
   (data (ptr i8))
   ; the unread bytes are data[start..end)
   (start i64)
   (end i64)
   (cap i64)])

;;; Refill an empty buffer with one read from the wrapped reader. Returns the number
;;; of unread bytes now buffered: 0 only at the end of the stream.
(defn fill-buffer [(b (ptr BufferedReader))] (-> (Result i64 IoError))
  (if (< (.start b) (.end b))
      (Ok (- (.end b) (.start b)))
      (match (read-some (.inner b) (.data b) (.cap b))
        (Err [e] (Err e))
        (Ok [n]
            (do
              (set! (.start b) 0)
              (set! (.end b) (if (> n 0) n 0))
              (Ok (.end b)))))))

;;; Consume up to `len` buffered bytes into `dst`; returns how many were copied.
(defn take-buffered [(b (ptr BufferedReader)) (dst (ptr i8)) (len i64)] (-> i64)
  (let [avail (- (.end b) (.start b))
        n (if (< len avail) len avail)]
    (memcpy dst (primitive/index (.data b) (.start b)) (primitive/cast isize n))
    (set! (.start b) (+ (.start b) n))
    n))

(defn read-buffered [(ctx (ptr i8)) (dst (ptr i8)) (len i64)] (-> (Result i64 IoError))
  (let [b (primitive/cast (ptr BufferedReader) ctx)]
    (cond
      (<= len 0) (Ok 0)
      (< (.start b) (.end b)) (Ok (take-buffered b dst len))
      ; nothing buffered and the request is at least a buffer: read straight into it
      (>= len (.cap b)) (read-some (.inner b) dst len)
      :else (match (fill-buffer b)
              (Err [e] (Err e))
              (Ok [_] (Ok (take-buffered b dst len)))))))

(impl BufferedReader
  ;;; Initialize caller-owned state `b` over `cap` bytes at `data`, reading from
  ;;; `inner`, and return `r` as its Reader. `cap` must be positive.
  (init [(r (ptr Reader))
         (b (ptr BufferedReader))
         (inner (ptr Reader))
         (data (ptr i8))
         (cap i64)] (-> (ptr Reader))
    (store! (field b inner) inner)
    (store! (field b data) data)
    (store! (field b start) 0)
    (store! (field b end) 0)
    (store! (field b cap) cap)
    (store! (field r read-fn) (primitive/fnptr-of read-buffered))
    (store! (field r ctx) (primitive/cast (ptr i8) b))
    r))

;;; Whether `r` was made by `BufferedReader::init`.
(defn buffered? [(r (ptr Reader))] (-> bool)
  (= (primitive/cast (ptr i8) (load (field r read-fn)))
     (primitive/cast (ptr i8) (primitive/fnptr-of read-buffered))))

;;; The index of the first newline among the next `n` buffered bytes, or -1.
(defn find-newline [(b (ptr BufferedReader)) (n i64)] (-> i64)
  (let [from (primitive/index (.data b) (.start b))
        hit (memchr from 10 (primitive/cast isize n))]
    (if (= hit (primitive/cast (ptr i8) 0))
        -1
        (- (primitive/cast i64 hit) (primitive/cast i64 from)))))

;;; `read-line` over a BufferedReader: the same results, copied a run at a time.
(defn read-line-buffered [(b (ptr BufferedReader)) (buf (ptr i8)) (cap i64)] (-> (Result i64 IoError))
  (let [(mut stored) 0]
    (block :done
      (loop
        (when (>= stored cap) (return-from :done (Ok stored)))
        (match (fill-buffer b)
          (Err [e] (return-from :done (Err e)))
          (Ok [avail]
              (if (= avail 0)
                  (return-from :done (if (= stored 0) (Err (Eof)) (Ok stored)))
                  (let [room (- cap stored)
                        window (if (< avail room) avail room)
                        newline (find-newline b window)]
                    (if (>= newline 0)
                        (do
                          (take-buffered b (primitive/index buf stored) newline)
                          (set! (.start b) (+ (.start b) 1))  ; the newline
                          (return-from :done (Ok (+ stored newline))))
                        (set! stored (+ stored (take-buffered b (primitive/index buf stored) window))))))))))))

;;; Grow `data`'s allocation to hold at least `need` bytes, doubling up to `limit`.
;;; Returns false, having freed it, when the allocator fails.
(defn grow-line [(a (dyn alloc/Allocator)) (buffer (mut (ptr i8))) (capacity (mut i64)) (need i64) (limit i64)] (-> bool)
  (if (<= need capacity)
      true
      (let [doubled (if (= capacity 0) 64 (* capacity 2))
            wanted (if (> doubled need) doubled need)
            new-cap (if (> wanted limit) limit wanted)]
        (match (alloc/reallocate [i8] a (slice::new (load buffer) (load capacity)) new-cap)
          (None []
                (do
                  (when (> capacity 0) (alloc/free [i8] a (slice::new (load buffer) (load capacity))))
                  false))
          (Some [memory]
                (do
                  (set! buffer (data memory))
                  (set! capacity new-cap)
                  true))))))

;;; `read-line-alloc` over a BufferedReader: the same results, copied a run at a time.
(defn read-line-alloc-buffered [(a (dyn alloc/Allocator))
                                (b (ptr BufferedReader))
                                (max-bytes i64)] (-> (Result OwnedBytes IoError))
  ; `(load data)` names the pointer the cell holds; `data` alone is the cell
  (let [(mut data) (primitive/cast (ptr i8) 0)
        (mut len) 0
        (mut capacity) 0]
    (block :done
      (loop
        (match (fill-buffer b)
          (Err [e]
               (do
                 (when (> capacity 0) (alloc/free [i8] a (slice::new (load data) capacity)))
                 (return-from :done (Err e))))
          (Ok [avail]
              (if (= avail 0)
                  (return-from :done
                    (if (= len 0) (Err (Eof)) (Ok (make-owned-bytes (load data) len capacity))))
                  (let [newline (find-newline b avail)
                        run (if (>= newline 0) newline avail)]
                    (when (> (+ len run) max-bytes)
                      ; consumed through the first byte past the limit, as read a byte at a time
                      (set! (.start b) (+ (.start b) (+ (- max-bytes len) 1)))
                      (when (> capacity 0) (alloc/free [i8] a (slice::new (load data) capacity)))
                      (return-from :done (Err (LineTooLong))))
                    (unless (grow-line a (mut data) (mut capacity) (+ len run) max-bytes)
                      (return-from :done (Err (OutOfMemory))))
                    (set! len (+ len (take-buffered b (primitive/index (load data) len) run)))
                    (when (>= newline 0)
                      (set! (.start b) (+ (.start b) 1))  ; the newline
                      (return-from :done (Ok (make-owned-bytes (load data) len capacity))))))))))))

; A fixed-capacity BufferedReader with its own 64 KiB buffer, the mirror of
; BufferedOutput. Instantiate it in the caller's frame or storage.
(defstruct BufferedInput
  [(state BufferedReader)
   (reader Reader)
   (buffer (array i8 65536))])

(impl BufferedInput
  ;;; Initialize `in` over `inner` and return its buffered Reader.
  (init [(in (ptr BufferedInput)) (inner (ptr Reader))] (-> (ptr Reader))
    (BufferedReader::init (field in reader)
                          (field in state)
                          inner
                          (primitive/cast (ptr i8) (field in buffer))
                          65536)))
