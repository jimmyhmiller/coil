(module coil.integer)
(import "coil.primitive" :as primitive)

;;; A wrapped machine-arithmetic result together with its type-directed signed
;;; or unsigned overflow flag.
(defstruct Overflow [T] [(value T) (overflow bool)])

;;; Wrapped addition plus its signed/unsigned overflow flag.
(defn overflowing-add [T] [(a T) (b T)] (-> (Overflow T))
  (Overflow :value (primitive/iadd a b) :overflow (primitive/iadd-overflow? a b)))

;;; Wrapped subtraction plus its signed/unsigned overflow flag.
(defn overflowing-sub [T] [(a T) (b T)] (-> (Overflow T))
  (Overflow :value (primitive/isub a b) :overflow (primitive/isub-overflow? a b)))

;;; Wrapped multiplication plus its signed/unsigned overflow flag.
(defn overflowing-mul [T] [(a T) (b T)] (-> (Overflow T))
  (Overflow :value (primitive/imul a b) :overflow (primitive/imul-overflow? a b)))
