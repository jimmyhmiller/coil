(module coil.arc.auto)
(import "coil.primitive" :as primitive)
(import "coil.arc" :as arc)
(import "coil.arc.auto-runtime" :as auto)
(import "coil.str" :as str)
(import "coil.slice" :as slice)
(import "coil.closure" :as closure)

; ---- transparent surface lowering -----------------------------------------
;
; Ownership elaboration runs after provisional typechecking. Source forms whose
; existing manual API requires an allocator therefore need one earlier rewrite:
; the author writes `(al-new [T])`, while provisional Coil sees the ordinary
; allocator-taking call. The typed ownership pass later replaces the manual
; representation and supplies ARC operations. Keep this pass limited to user
; modules so imported manual runtimes preserve their ABI and behavior.
(defn ta-user-form-in? [(form Code) (i i64) (n i64)] (-> bool)
  (if (>= i n)
      false
      (if (primitive/code-from-user? (primitive/code-nth form i))
          true
          (ta-user-form-in? form (+ i 1) n))))

(defn ta-module-defines? [(module Code) (wanted (slice u8)) (i i64) (n i64)] (-> bool)
  (if (>= i n)
      false
      (let [form (primitive/code-nth module i)]
        (if (and (primitive/code-list? form)
                 (and (> (primitive/code-count form) 1)
                      (and (ta-symbol-named? (primitive/code-nth form 0) "defn")
                           (ta-symbol-named? (primitive/code-nth form 1) wanted))))
            true
            (ta-module-defines? module wanted (+ i 1) n)))))

(defn ta-user-module? [(module Code)] (-> bool)
  (and (primitive/code-list? module)
       (and (> (primitive/code-count module) 1)
            (let [name (primitive/code-nth module 0)]
              (and (primitive/code-sym? name)
                   (and (not (ta-module-defines? module
                                                 "auto-al-new"
                                                 1
                                                 (primitive/code-count module)))
                        (let [text (primitive/code-sym name)]
                          (and (!= text "coil.arc.auto")
                               (and (!= text "coil.arc.auto-runtime")
                                    (not (str/starts-with text "coil.")))))))))))

(defn ta-symbol-named? [(form Code) (name (slice u8))] (-> bool)
  (and (primitive/code-sym? form) (= (primitive/code-sym form) name)))

(defn ta-surface-list-items [(form Code) (i i64) (n i64)] (-> Code)
  (if (>= i n)
      `()
      `(~(ta-rewrite-surface (primitive/code-nth form i)) ~@(ta-surface-list-items form (+ i 1) n))))

(defn ta-surface-vector-items [(form Code) (i i64) (n i64)] (-> Code)
  (if (>= i n)
      `[]
      `[~(ta-rewrite-surface (primitive/code-nth form i))
        ~@(ta-surface-vector-items form (+ i 1) n)]))

; The provisional checker represents aggregate locals as places.  A second let
; binding initialized directly from an existing place would otherwise be parsed
; as a mutable alias before the ownership-phase representation rewrite gets a
; chance to turn it into an ARC retain.  Materialize the source-level copy here;
; the typed pass later keeps it only for managed values.
(defn ta-surface-alias-value [(value Code)] (-> Code)
  (if (primitive/code-sym? value) `(clone ~value) (ta-rewrite-surface value)))

(defn ta-surface-let-items [(items Code) (i i64) (n i64)] (-> Code)
  (if (>= i n)
      `[]
      (if (>= (+ i 1) n)
          `[~(primitive/code-nth items i)]
          `[~(primitive/code-nth items i)
            ~(ta-surface-alias-value (primitive/code-nth items (+ i 1)))
            ~@(ta-surface-let-items items (+ i 2) n)])))

(defn ta-rewrite-surface [(form Code)] (-> Code)
  (if (primitive/code-vector? form)
      (ta-surface-vector-items form 0 (primitive/code-count form))
      (if (not (primitive/code-list? form))
          form
          (let [n (primitive/code-count form)]
            (if (= n 0)
                form
                (let [head (primitive/code-nth form 0)]
                  (if (or (ta-symbol-named? head "quote")
                          (ta-symbol-named? head "quasiquote"))
                      form
                      (cond (and (ta-symbol-named? head "let")
                                 (and (> n 1)
                                      (primitive/code-vector? (primitive/code-nth form 1))))
                              `(let ~(ta-surface-let-items (primitive/code-nth form 1)
                                                           0
                                                           (primitive/code-count (primitive/code-nth form 1)))
                                 ~@(ta-surface-list-items form 2 n))
                            (and (= n 2) (ta-symbol-named? head "al-new"))
                              `(auto/auto-al-new ~(ta-rewrite-surface (primitive/code-nth form 1)))
                            (ta-symbol-named? head "al-push!") `(auto/auto-al-push! ~@(ta-surface-list-items form 1 n))
                            (ta-symbol-named? head "al-get") `(auto/auto-al-get ~@(ta-surface-list-items form 1 n))
                            (ta-symbol-named? head "al-len") `(auto/auto-al-len ~@(ta-surface-list-items form 1 n))
                            (and (= n 2) (ta-symbol-named? head "ArrayList"))
                              `(auto/AutoArrayList ~(ta-rewrite-surface (primitive/code-nth form 1)))
                            (ta-symbol-named? head "defclosure")
                              `(closure/defarcclosure ~@(ta-surface-list-items form 1 n))
                            (and (= n 2) (ta-symbol-named? head "weak"))
                              `(auto/auto-weak-preview ~(ta-rewrite-surface (primitive/code-nth form 1)))
                            (and (= n 2) (ta-symbol-named? head "weak-upgrade"))
                              `(auto/auto-weak-upgrade-preview ~(ta-rewrite-surface (primitive/code-nth form 1)))
                            :else `(~@(ta-surface-list-items form 0 n))))))))))

(defn ta-rewrite-surface-modules [(modules Code) (i i64) (n i64)] (-> Code)
  (if (>= i n)
      `()
      (let [module (primitive/code-nth modules i)]
        `(~(if (ta-user-module? module) (ta-rewrite-surface module) module) ~@(ta-rewrite-surface-modules modules
                                                                                                          (+ i 1)
                                                                                                          n)))))

(defn transparent-arc-surface-pass [(modules Code)] (-> Code)
  `(do ~@(ta-rewrite-surface-modules modules 0 (primitive/code-count modules))))

(transform transparent-arc-surface-pass :phase before-expand)

; Generated transparent-ARC names are implementation details. Authored source
; continues to use its ordinary type and constructor names.
(defn ma-public-name [(base Code) (suffix (slice u8))] (-> Code)
  ; hygiene: generated ARC support declarations intentionally enter the transformed module's public namespace.
  (primitive/syntax->datum (primitive/code-symbol base suffix)))

; ---- ownership-elaboration transform --------------------------------------
(defn ma-unref-type [(ty Code)] (-> Code)
  (if (and (primitive/code-list? ty)
           (and (= (primitive/code-count ty) 2)
                (let [head (primitive/code-nth ty 0)]
                  (and (primitive/code-sym? head)
                       (let [name (primitive/code-sym head)]
                         (or (= name "ref")
                             (or (= name "coil.core.ref")
                                 (or (= name "mut")
                                     (or (= name "coil.core.mut")
                                         (or (= name "ptr")
                                             (= name "coil.core.ptr")))))))))))
      (ma-unref-type (primitive/code-nth ty 1))
      (if (and (primitive/code-list? ty)
               (and (= (primitive/code-count ty) 2)
                    (let [head (primitive/code-nth ty 0)]
                      (and (primitive/code-sym? head)
                           (let [name (primitive/code-sym head)]
                             (or (= name "ManuallyDrop")
                                 (= name "coil.core.ManuallyDrop")))))))
          (ma-unref-type (primitive/code-nth ty 1))
          ty)))

(defn ta-type-head [(ty Code)] (-> Code)
  (if (primitive/code-sym? ty)
      ty
      (if (and (primitive/code-list? ty)
               (and (> (primitive/code-count ty) 0)
                    (primitive/code-sym? (primitive/code-nth ty 0))))
          (primitive/code-nth ty 0)
          `:unknown)))

(defn ta-qualified-name? [(name (slice u8))] (-> bool)
  (str/string-view-contains? (str/StringView :raw name) (str/sv ".")))

(defn ta-reflect-source-struct? [(plain Code)] (-> bool)
  (let [base (ta-type-head plain)]
    (if (not (primitive/code-sym? base))
        false
        (let [name (primitive/code-sym base)]
          (if (or (not (ta-qualified-name? name))
                  (or (str/starts-with name "coil.")
                      (str/string-view-contains? (str/StringView :raw name)
                                                 (str/sv "arc-auto-payload-"))))
              false
              (and (primitive/code-eq (primitive/code-type-shape plain) `struct)
                   (let [count (primitive/code-field-count plain)]
                     (and (> count 0)
                          (not (and (= count 1)
                                    (let [field-name (primitive/code-sym (primitive/code-field-name plain 0))]
                                      (or (= field-name "auto-owner")
                                          (= field-name "auto-weak")))))))))))))

(defn ta-reflect-source-sum? [(plain Code)] (-> bool)
  (let [base (ta-type-head plain)]
    (if (not (primitive/code-sym? base))
        false
        (let [name (primitive/code-sym base)]
          (if (or (not (ta-qualified-name? name)) (str/starts-with name "coil."))
              false
              (primitive/code-eq (primitive/code-type-shape plain) `sum))))))

(defn ta-source-struct-type? [(ty Code)] (-> bool)
  (ta-reflect-source-struct? (ma-unref-type ty)))

(defn ta-user-struct-reference? [(node Code)] (-> bool)
  (let [decl (primitive/code-decl node)]
    (and (primitive/code-sym? node)
         (and (not (str/string-view-contains? (str/StringView :raw (primitive/code-sym node))
                                              (str/sv "arc-auto-payload-")))
              (and (primitive/code-list? decl)
                   (and (>= (primitive/code-count decl) 3)
                        (and (ta-symbol-tail-named? (primitive/code-nth decl 2) "struct")
                             (let [module-name (primitive/code-nth decl 1)]
                               (and (primitive/code-sym? module-name)
                                    (not (str/starts-with (primitive/code-sym module-name)
                                                          "coil.")))))))))))

(defn ma-managed-type? [(ty Code)] (-> bool)
  (let [plain (ma-unref-type ty)]
    (if (primitive/code-list? plain)
        (or (ta-source-struct-type? plain)
            (or (ta-reflect-source-sum? plain)
                (and (> (primitive/code-count plain) 0)
                     (let [head (primitive/code-nth plain 0)]
                       (and (primitive/code-sym? head)
                            (let [name (primitive/code-sym head)]
                              (or (= name "AutoArrayList")
                                  (= name "coil.arc.auto-runtime.AutoArrayList"))))))))
        (if (not (primitive/code-sym? plain))
            false
            (let [name (primitive/code-sym plain)]
              (if (or (= name "i8")
                      (or (= name "i16")
                          (or (= name "i32")
                              (or (= name "i64")
                                  (or (= name "u8")
                                      (or (= name "u16")
                                          (or (= name "u32")
                                              (or (= name "u64")
                                                  (or (= name "f32")
                                                      (or (= name "f64")
                                                          (or (= name "bool")
                                                              (or (= name "void")
                                                                  (= name "Code")))))))))))))
                  false
                  (or (ta-source-struct-type? plain)
                      (or (ta-reflect-source-sum? plain)
                          (let [decl (primitive/code-decl plain)]
                            (and (primitive/code-list? decl)
                                 (and (> (primitive/code-count decl) 0)
                                      (and (ta-symbol-named? (primitive/code-nth decl 0) "defstruct")
                                           (and (= (primitive/code-field-count plain) 1)
                                                (= (primitive/code-sym (primitive/code-field-name plain 0))
                                                   "auto-owner"))))))))))))))

(defn ma-managed-reference? [(form Code)] (-> bool)
  (and (primitive/code-sym? form)
       (ma-managed-type? (primitive/type-of form))))

(defn ma-ref-type? [(ty Code)] (-> bool)
  (and (primitive/code-list? ty)
       (and (= (primitive/code-count ty) 2)
            (let [head (primitive/code-nth ty 0)]
              (and (primitive/code-sym? head)
                   (let [name (primitive/code-sym head)]
                     (or (= name "ref")
                         (or (= name "coil.core.ref")
                             (or (= name "mut") (= name "coil.core.mut"))))))))))

(defn ta-auto-runtime-head? [(head Code)] (-> bool)
  (or (primitive/code-eq head `auto/auto-al-new)
      (or (primitive/code-eq head `auto/auto-al-push!)
          (or (primitive/code-eq head `auto/auto-al-get)
              (primitive/code-eq head `auto/auto-al-len)))))

(defn ta-auto-weak-preview-head? [(head Code)] (-> bool)
  (or (primitive/code-eq head `auto/auto-weak-preview)
      (and (primitive/code-sym? head)
           (let [name (primitive/code-sym head)]
             (or (= name "auto-weak-preview")
                 (= name "auto/auto-weak-preview")
                 (= name "coil.arc.auto-runtime.auto-weak-preview"))))))

(defn ta-auto-weak-upgrade-preview-head? [(head Code)] (-> bool)
  (or (primitive/code-eq head `auto/auto-weak-upgrade-preview)
      (and (primitive/code-sym? head)
           (let [name (primitive/code-sym head)]
             (or (= name "auto-weak-upgrade-preview")
                 (= name "auto/auto-weak-upgrade-preview")
                 (= name "coil.arc.auto-runtime.auto-weak-upgrade-preview"))))))

(defn ta-rewrite-weak-preview-call [(form Code) (inside bool)] (-> Code)
  (let [value (primitive/code-nth form 1)
        source-type (ma-unref-type (primitive/type-of value))
        preview-type
          (if (ta-auto-weak-upgrade-preview-head? (primitive/code-nth form 0))
              source-type
              (ma-unref-type (primitive/type-of form)))
        target-type
          (if (and (primitive/code-list? preview-type)
                   (= (primitive/code-count preview-type) 2))
              (primitive/code-nth preview-type 1)
              preview-type)
        target-name (ta-type-head (ma-unref-type target-type))
        operation
          (if (not (primitive/code-sym? target-name))
              (primitive/error (primitive/code-str target-type))
              ; hygiene: synthesized ARC operation calls intentionally resolve as public declarations in the transformed module.
              (let [datum-name (primitive/syntax->datum target-name)]
                (if (ta-auto-weak-upgrade-preview-head? (primitive/code-nth form 0))
                    (primitive/syntax->datum (primitive/code-symbol (primitive/code-sym datum-name)
                                                                    "-auto-upgrade"))
                    ; hygiene: synthesized ARC downgrade calls intentionally resolve to the generated public operation.
                    (primitive/syntax->datum (primitive/code-symbol (primitive/code-sym datum-name)
                                                                    "-auto-downgrade")))))]
    `(~operation ~(ma-rewrite value inside false))))

(defn ta-rewrite-auto-call-items [(form Code) (i i64) (n i64) (inside bool)] (-> Code)
  (if (>= i n)
      `()
      (let [item (primitive/code-nth form i)]
        `(~(if (and (= i 1) (primitive/code-vector? item))
               item
               (ma-rewrite item
                           inside
                           (not (ma-call-borrows? (primitive/code-nth form 0)
                                                  (if (and (> i 1)
                                                           (primitive/code-vector? (primitive/code-nth form 1)))
                                                      (- i 2)
                                                      (- i 1)))))) ~@(ta-rewrite-auto-call-items form (+ i 1) n inside)))))

(defn ta-rewrite-auto-call [(form Code) (inside bool)] (-> Code)
  `(~(primitive/code-nth form 0) ~@(ta-rewrite-auto-call-items form 1 (primitive/code-count form) inside)))

; Ask the authoritative provisional declaration model whether call argument `i`
; is borrowed. Unknown call shapes conservatively consume; managed constructors and
; stores therefore clone, while generated `T-borrow`/downgrade APIs do not.
(defn ma-call-borrows? [(head Code) (i i64)] (-> bool)
  (let [generated-borrow
          (and (= i 0)
               (and (primitive/code-sym? head)
                    (let [text (str/StringView :raw (primitive/code-sym head))]
                      (or (str/string-view-contains? text (str/sv "-auto-borrow"))
                          (str/string-view-contains? text (str/sv "-auto-clone"))))))
        decl (if (primitive/code-sym? head) (primitive/code-decl head) `:unknown)]
    (if generated-borrow
        true
        (if (and (primitive/code-list? decl)
                 (and (>= (primitive/code-count decl) 3)
                      (and (primitive/code-sym? (primitive/code-nth decl 0))
                           (let [kind (primitive/code-sym (primitive/code-nth decl 0))]
                             (or (= kind "defn") (= kind "func"))))))
            (let [params (primitive/code-nth decl 2)]
              (if (and (primitive/code-vector? params) (< i (primitive/code-count params)))
                  (let [param (primitive/code-nth params i)]
                    (and (primitive/code-list? param)
                         (and (= (primitive/code-count param) 2)
                              (ma-ref-type? (primitive/code-nth param 1)))))
                  false))
            false))))

(defn ma-rewrite-let-items [(items Code) (i i64) (n i64) (inside bool)] (-> Code)
  (if (>= i n)
      `()
      (if (>= (+ i 1) n)
          `(~(primitive/code-nth items i))
          `(~(primitive/code-nth items i) ~(ma-rewrite (primitive/code-nth items (+ i 1)) inside true)
              ~@(ma-rewrite-let-items items (+ i 2) n inside)))))

(defn ma-rewrite-call-items [(form Code) (i i64) (n i64) (inside bool)] (-> Code)
  (if (>= i n)
      `()
      (let [head (primitive/code-nth form 0)
            item (primitive/code-nth form i)
            explicit-types
              (and (> n 1)
                   (primitive/code-vector? (primitive/code-nth form 1)))]
        `(~(if (and (= i 1) explicit-types)
               item
               (ma-rewrite item
                           inside
                           (not (ma-call-borrows? head
                                                  (if explicit-types (- i 2) (- i 1)))))) ~@(ma-rewrite-call-items form
                                                                                                                   (+ i
                                                                                                                      1)
                                                                                                                   n
                                                                                                                   inside)))))

(defn ma-rewrite-body-items [(form Code)
                             (i i64)
                             (n i64)
                             (inside bool)
                             (tail-consumes bool)] (-> Code)
  (if (>= i n)
      `()
      `(~(ma-rewrite (primitive/code-nth form i)
                     inside
                     (and tail-consumes (= (+ i 1) n))) ~@(ma-rewrite-body-items form (+ i 1) n inside tail-consumes))))

(defn ma-rewrite-match-arms [(form Code)
                             (i i64)
                             (n i64)
                             (inside bool)
                             (consumes bool)] (-> Code)
  (if (>= i n)
      `()
      (let [arm (primitive/code-nth form i)]
        (if (and (primitive/code-list? arm)
                 (and (= (primitive/code-count arm) 3)
                      (primitive/code-vector? (primitive/code-nth arm 1))))
            `((~(primitive/code-nth arm 0) ~(primitive/code-nth arm 1)
                 ~(ma-rewrite (primitive/code-nth arm 2) inside consumes)) ~@(ma-rewrite-match-arms form
                                                                                                    (+ i 1)
                                                                                                    n
                                                                                                    inside
                                                                                                    consumes))
            `(~arm ~@(ma-rewrite-match-arms form (+ i 1) n inside consumes))))))

; ---- ordinary aggregate representation ------------------------------------
(defn ta-generated-wrapper-fields? [(fields Code)] (-> bool)
  (and (= (primitive/code-count fields) 1)
       (let [field (primitive/code-nth fields 0)]
         (and (primitive/code-list? field)
              (and (> (primitive/code-count field) 0)
                   (let [name (primitive/code-nth field 0)]
                     (or (ta-symbol-named? name "auto-owner")
                         (ta-symbol-named? name "auto-weak"))))))))

(defn ta-generic-defstruct? [(form Code)] (-> bool)
  (and (= (primitive/code-count form) 4)
       (and (primitive/code-vector? (primitive/code-nth form 2))
            (primitive/code-vector? (primitive/code-nth form 3)))))

(defn ta-defstruct-fields [(form Code)] (-> Code)
  (if (ta-generic-defstruct? form)
      (primitive/code-nth form 3)
      (primitive/code-nth form 2)))

(defn ta-type-app-items [(items Code) (i i64) (n i64)] (-> Code)
  (if (>= i n)
      `()
      `(~(primitive/code-nth items i) ~@(ta-type-app-items items (+ i 1) n))))

(defn ta-applied-type [(name Code) (params Code)] (-> Code)
  `(~name ~@(ta-type-app-items params 0 (primitive/code-count params))))

(defn ta-freshen-list-items [(form Code) (i i64) (n i64)] (-> Code)
  (if (>= i n)
      `()
      `(~(ta-freshen-syntax (primitive/code-nth form i)) ~@(ta-freshen-list-items form (+ i 1) n))))

(defn ta-freshen-vector-items [(form Code) (i i64) (n i64)] (-> Code)
  (if (>= i n)
      `[]
      `[~(ta-freshen-syntax (primitive/code-nth form i))
        ~@(ta-freshen-vector-items form (+ i 1) n)]))

; A semantic transform replaces declarations, so transported resolved
; identifiers would still name the discarded declaration graph. Rebuild the
; generated declaration as unresolved datum syntax for the authoritative
; resolve/check pass to bind as one coherent graph.
(defn ta-freshen-syntax [(form Code)] (-> Code)
  (if (primitive/code-sym? form)
      (let [name (primitive/code-sym form)]
        (if (and (ta-qualified-name? name) (not (str/starts-with name "coil.")))
            ; hygiene: transported generated references deliberately discard the replaced declaration graph's context before re-resolution.
            (primitive/syntax->datum form)
            form))
      (if (primitive/code-vector? form)
          (ta-freshen-vector-items form 0 (primitive/code-count form))
          (if (primitive/code-list? form)
              `(~@(ta-freshen-list-items form 0 (primitive/code-count form)))
              form))))

(defn ta-freshen-owned-list-items [(form Code) (owner Code) (i i64) (n i64)] (-> Code)
  (if (>= i n)
      `()
      `(~(ta-freshen-owned-syntax (primitive/code-nth form i) owner) ~@(ta-freshen-owned-list-items form
                                                                                                    owner
                                                                                                    (+ i 1)
                                                                                                    n))))

(defn ta-freshen-owned-vector-items [(form Code) (owner Code) (i i64) (n i64)] (-> Code)
  (if (>= i n)
      `[]
      `[~(ta-freshen-owned-syntax (primitive/code-nth form i) owner)
        ~@(ta-freshen-owned-vector-items form owner (+ i 1) n)]))

(defn ta-freshen-owned-syntax [(form Code) (owner Code)] (-> Code)
  (if (primitive/code-sym? form)
      (let [name (primitive/code-sym form)]
        (if (or (= name (primitive/code-sym owner))
                (and (ta-qualified-name? name) (not (str/starts-with name "coil."))))
            ; hygiene: owner-local and generated qualified references deliberately rebind in the replacement declaration graph.
            (primitive/syntax->datum form)
            form))
      (if (primitive/code-vector? form)
          (ta-freshen-owned-vector-items form owner 0 (primitive/code-count form))
          (if (primitive/code-list? form)
              `(~@(ta-freshen-owned-list-items form owner 0 (primitive/code-count form)))
              form))))

(defn ta-generic-defsum? [(form Code)] (-> bool)
  (and (>= (primitive/code-count form) 4)
       (primitive/code-vector? (primitive/code-nth form 2))))

(defn ta-plain-defsum? [(form Code)] (-> bool)
  (and (primitive/code-list? form)
       (and (>= (primitive/code-count form) 3)
            (ta-symbol-named? (primitive/code-nth form 0) "defsum"))))

(defn ta-sum-binds [(n i64)] (-> Code)
  (let [out (primitive/code-list-new)
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (primitive/code-list-push! out
                                           (primitive/fresh-identifier "auto-sum-field"))
                (store! i (+ (load i) 1)))))
    (primitive/code-list-done out)))

; The ownership transform cannot call derive's private metaprogram helpers across
; the module boundary. Keep its copy classification local: these are precisely the
; structural values that never require a generated Clone call.
(defn ta-plain-copy-type? [(ty Code)] (-> bool)
  (if (primitive/code-sym? ty)
      (or (primitive/code-eq ty `i8)
          (or (primitive/code-eq ty `i16)
              (or (primitive/code-eq ty `i32)
                  (or (primitive/code-eq ty `i64)
                      (or (primitive/code-eq ty `u8)
                          (or (primitive/code-eq ty `u16)
                              (or (primitive/code-eq ty `u32)
                                  (or (primitive/code-eq ty `u64)
                                      (or (primitive/code-eq ty `f32)
                                          (or (primitive/code-eq ty `f64)
                                              (or (primitive/code-eq ty `bool)
                                                  (primitive/code-eq ty `void))))))))))))
      (and (primitive/code-list? ty)
           (> (primitive/code-count ty) 0)
           (let [head (primitive/code-nth ty 0)]
             (and (primitive/code-sym? head)
                  (or (primitive/code-eq head `ptr)
                      (or (primitive/code-eq head `ref)
                          (or (primitive/code-eq head `mut)
                              (or (primitive/code-eq head `slice)
                                  (primitive/code-eq head `fnptr))))))))))

(defn ta-sum-values [(T Code) (vi i64) (binds Code) (n i64)] (-> Code)
  (let [out (primitive/code-list-new)
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (let [ty (primitive/code-variant-field-type T vi (load i))
                    value (primitive/code-nth binds (load i))]
                (primitive/code-list-push! out
                                           (if (ta-plain-copy-type? ty) value `(clone ~value)))
                (store! i (+ (load i) 1)))))
    (primitive/code-list-done out)))

(defn ta-sum-clone-arms [(T Code) (reflect-type Code) (vi i64) (nv i64)] (-> Code)
  (let [out (primitive/code-list-new)
        (mut i) vi]
    (loop (if (>= (load i) nv)
              (break)
              (let [nf (primitive/code-variant-fields reflect-type (load i))
                    binds (ta-sum-binds nf)
                    variant (primitive/code-variant-qname reflect-type (load i))]
                (primitive/code-list-push! out
                                           `(~variant [~@binds]
                                               ~(if (primitive/code-list? T)
                                                    `(~variant [~@(ta-type-app-items T 1 (primitive/code-count T))]
                                                        ~@(ta-sum-values reflect-type (load i) binds nf))
                                                    `(~variant ~@(ta-sum-values reflect-type (load i) binds nf)))))
                (store! i (+ (load i) 1)))))
    (primitive/code-list-done out)))

(defn ta-sum-clone-bounds [(target Code) (i i64) (n i64)] (-> Code)
  (if (>= i n)
      `()
      `((~(primitive/code-nth target i) Clone) ~@(ta-sum-clone-bounds target (+ i 1) n))))

(defn ta-sum-clone-impl [(target Code)] (-> Code)
  (let [self (primitive/fresh-identifier "auto-sum-self")
        reflect-type (ta-type-head target)
        body
          `(match (load ~self)
             ~@(ta-sum-clone-arms target
                                  reflect-type
                                  0
                                  (primitive/code-variant-count reflect-type)))]
    (if (primitive/code-list? target)
        `(impl [~@(ta-sum-clone-bounds target 1 (primitive/code-count target))] Clone ~target
           (clone [(~self (ref ~target))] (-> ~target) ~body))
        `(impl Clone ~target
           (clone [(~self (ref ~target))] (-> ~target) ~body)))))

(defn ta-sum-clone-fn [(target Code)] (-> Code)
  (let [self (primitive/fresh-identifier "auto-sum-value")
        fname (ma-public-name (ta-type-head target) "-auto-clone")
        reflect-type (ta-type-head target)
        body
          `(match (load ~self)
             ~@(ta-sum-clone-arms target
                                  reflect-type
                                  0
                                  (primitive/code-variant-count reflect-type)))]
    (if (primitive/code-list? target)
        `(defn ~fname [~@(ta-sum-clone-bounds target 1 (primitive/code-count target))] [(~self (ref ~target))] (-> ~target)
           ~body)
        `(defn ~fname [(~self (ref ~target))] (-> ~target)
           ~body))))

(defn ta-lower-plain-defsum [(form Code)] (-> Code)
  (let [name (primitive/code-nth form 1)
        target
          (if (ta-generic-defsum? form)
              (ta-applied-type name (primitive/code-nth form 2))
              name)
        clone-impl (ta-sum-clone-impl target)
        clone-fn (ta-sum-clone-fn target)]
    `(~(ta-freshen-owned-syntax form name) ~(ta-freshen-owned-syntax clone-impl name)
        ~(ta-freshen-owned-syntax clone-fn name))))

(defn ta-symbol-tail-named? [(form Code) (wanted (slice u8))] (-> bool)
  (if (not (primitive/code-sym? form))
      false
      (let [text (primitive/code-sym form)
            nt (slice/slice-len text)
            nw (slice/slice-len wanted)]
        (and (<= nw nt)
             (and (= (slice/subslice text (- nt nw) nt) wanted)
                  (or (= nw nt)
                      (let [separator
                              (primitive/cast i64
                                              (slice/slice-get text (- (- nt nw) 1)))]
                        (or (= separator 46) (= separator 47)))))))))

(defn ta-clone-impl-for? [(form Code) (name Code)] (-> bool)
  (and (primitive/code-list? form)
       (let [n (primitive/code-count form)]
         (and (>= n 3)
              (and (ta-symbol-tail-named? (primitive/code-nth form 0) "impl")
                   (let [generic (primitive/code-vector? (primitive/code-nth form 1))
                         trait-i (if generic 2 1)
                         type-i (if generic 3 2)]
                     (and (> n type-i)
                          (and (ta-symbol-tail-named? (primitive/code-nth form trait-i) "Clone")
                               (ta-head-names-type? (ta-type-head (primitive/code-nth form type-i))
                                                    name)))))))))

(defn ta-plain-defstruct? [(form Code)] (-> bool)
  (and (primitive/code-list? form)
       (and (or (= (primitive/code-count form) 3)
                (= (primitive/code-count form) 4))
            (and (ta-symbol-named? (primitive/code-nth form 0) "defstruct")
                 (and (primitive/code-vector? (ta-defstruct-fields form))
                      (let [name (primitive/code-nth form 1)
                            fields (ta-defstruct-fields form)]
                        (and (not (str/starts-with (primitive/code-sym name)
                                                   "arc-auto-payload-"))
                             (not (ta-generated-wrapper-fields? fields)))))))))

(defn ta-struct-name-from-type [(ty Code)] (-> Code)
  (ta-type-head (ma-unref-type ty)))

(defn ta-last-dot [(text (slice u8)) (i i64)] (-> i64)
  (if (< i 0)
      -1
      (if (= (primitive/cast i64 (slice/slice-get text i)) 46)
          i
          (ta-last-dot text (- i 1)))))

(defn ta-struct-payload-name [(name Code)] (-> Code)
  (let [text (primitive/code-sym name)
        n (slice/slice-len text)
        dot (ta-last-dot text (- n 1))]
    ; hygiene: payload declarations are stable generated names intentionally published in the owning module.
    (if (< dot 0)
        (primitive/syntax->datum (primitive/code-symbol "arc-auto-payload-" name))
        (primitive/syntax->datum (primitive/code-symbol (slice/subslice text 0 (+ dot 1))
                                                        "arc-auto-payload-"
                                                        (slice/subslice text (+ dot 1) n))))))

(defn ta-struct-wrap-name [(name Code)] (-> Code)
  (ma-public-name name "-auto-wrap"))

(defn ta-struct-borrow-name [(name Code)] (-> Code)
  (ma-public-name name "-auto-borrow"))

(defn ta-struct-clone-name [(name Code)] (-> Code)
  (ma-public-name name "-auto-clone"))

(defn ta-struct-weak-name [(name Code)] (-> Code)
  (ma-public-name name "Weak"))

(defn ta-struct-downgrade-name [(name Code)] (-> Code)
  (ma-public-name name "-auto-downgrade"))

(defn ta-struct-upgrade-name [(name Code)] (-> Code)
  (ma-public-name name "-auto-upgrade"))

(defn ta-lower-plain-defstruct [(form Code)] (-> Code)
  (let [name (primitive/code-nth form 1)
        fields (ta-defstruct-fields form)
        payload (ta-struct-payload-name name)
        wrap (ta-struct-wrap-name name)
        borrow (ta-struct-borrow-name name)
        weak-name (ta-struct-weak-name name)
        downgrade (ta-struct-downgrade-name name)
        upgrade (ta-struct-upgrade-name name)
        generic (ta-generic-defstruct? form)]
    (if generic
        (let [params (primitive/code-nth form 2)
              payload-type (ta-applied-type payload params)
              public-type (ta-applied-type name params)
              weak-type (ta-applied-type weak-name params)]
          `((defstruct ~payload ~params ~fields) (impl ~params Drop
                                                   ~payload-type
                                                   (drop [(self (mut ~payload-type))]
                                                         (-> void)
                                                         (forget (auto/auto-object-live-dec!))))
              (defstruct ~name ~params [(auto-owner (arc/Arc ~payload-type))])
              (defstruct ~weak-name ~params [(auto-weak (arc/Weak ~payload-type))])
              (impl ~params Clone
                ~public-type
                (clone [(self (ref ~public-type))]
                       (-> ~public-type)
                       (~name :auto-owner (clone (.auto-owner self)))))
              (defn ~(ta-struct-clone-name name)
                ~params
                [(self (ref ~public-type))]
                (-> ~public-type)
                (~name :auto-owner (clone (.auto-owner self))))
              (defn ~wrap
                ~params
                [(value ~payload-type)]
                (-> ~public-type)
                (~name :auto-owner (auto/auto-new-owner value)))
              (defn ~borrow
                ~params
                [(self (ref ~public-type))]
                (-> (ptr ~payload-type))
                (arc/arc-borrow [~payload-type] (.auto-owner self)))
              (impl ~params Clone
                ~weak-type
                (clone [(self (ref ~weak-type))]
                       (-> ~weak-type)
                       (~weak-name :auto-weak (clone (.auto-weak self)))))
              (defn ~downgrade
                ~params
                [(self (ref ~public-type))]
                (-> ~weak-type)
                (~weak-name :auto-weak (arc/arc-downgrade [~payload-type] (.auto-owner self))))
              (defn ~upgrade
                ~params
                [(self (ref ~weak-type))]
                (-> (Option ~public-type))
                (match (arc/weak-upgrade [~payload-type] (.auto-weak self))
                  (None [] (None [~public-type]))
                  (Some [owner] (Some (~name :auto-owner owner)))))))
        `((defstruct ~payload ~fields) (impl Drop ~payload
                                         (drop [(self (mut ~payload))]
                                               (-> void)
                                               (forget (auto/auto-object-live-dec!))))
            (defstruct ~name [(auto-owner (arc/Arc ~payload))])
            (defstruct ~weak-name [(auto-weak (arc/Weak ~payload))])
            (impl Clone ~name
              (clone [(self (ref ~name))]
                     (-> ~name)
                     (~name :auto-owner (clone (.auto-owner self)))))
            (defn ~(ta-struct-clone-name name) [(self (ref ~name))] (-> ~name)
              (~name :auto-owner (clone (.auto-owner self))))
            (defn ~wrap [(value ~payload)] (-> ~name)
              (~name :auto-owner (auto/auto-new-owner value)))
            (defn ~borrow [(self (ref ~name))] (-> (ptr ~payload))
              (arc/arc-borrow [~payload] (.auto-owner self)))
            (impl Clone ~weak-name
              (clone [(self (ref ~weak-name))]
                     (-> ~weak-name)
                     (~weak-name :auto-weak (clone (.auto-weak self)))))
            (defn ~downgrade [(self (ref ~name))] (-> ~weak-name)
              (~weak-name :auto-weak (arc/arc-downgrade [~payload] (.auto-owner self))))
            (defn ~upgrade [(self (ref ~weak-name))] (-> (Option ~name))
              (match (arc/weak-upgrade [~payload] (.auto-weak self))
                (None [] (None [~name]))
                (Some [owner] (Some (~name :auto-owner owner)))))))))

(defn ta-source-struct-constructor? [(form Code)] (-> bool)
  (let [head (primitive/code-nth form 0)
        ty (ma-unref-type (primitive/type-of form))]
    (and (primitive/code-sym? head)
         (and (or (and (ta-head-names-type? head ty)
                       (ta-reflect-source-struct? ty))
                  (ta-user-struct-reference? head))
              (not (ta-constructor-has-auto-owner? form
                                                   1
                                                   (primitive/code-count form)))))))

(defn ta-head-names-type? [(head Code) (ty Code)] (-> bool)
  (let [base (ta-type-head ty)]
    (if (or (not (primitive/code-sym? head)) (not (primitive/code-sym? base)))
        false
        (let [h (primitive/code-sym head)
              t (primitive/code-sym base)
              hn (slice/slice-len h)
              tn (slice/slice-len t)]
          (and (<= hn tn)
               (and (= (slice/subslice t (- tn hn) tn) h)
                    (or (= hn tn)
                        (= (primitive/cast i64
                                           (slice/slice-get t (- (- tn hn) 1)))
                           46))))))))

(defn ta-constructor-has-auto-owner? [(form Code) (i i64) (n i64)] (-> bool)
  (if (>= i n)
      false
      (let [item (primitive/code-nth form i)]
        (if (or (primitive/code-eq item `:auto-owner)
                (primitive/code-eq item `:auto-weak))
            true
            (ta-constructor-has-auto-owner? form (+ i 1) n)))))

(defn ta-rewrite-constructor-items [(form Code) (i i64) (n i64) (inside bool)] (-> Code)
  (if (>= i n)
      `()
      `(~(let [item (primitive/code-nth form i)]
           (if (and (primitive/code-sym? item)
                    (str/starts-with (primitive/code-sym item) ":"))
               item
               (ma-rewrite item inside true))) ~@(ta-rewrite-constructor-items form (+ i 1) n inside))))

(defn ta-rewrite-struct-constructor-for [(form Code) (inside bool) (ty Code)] (-> Code)
  (let [inferred (ta-reflect-source-struct? ty)
        name (if inferred (ta-type-head ty) (primitive/code-nth form 0))
        payload (ta-struct-payload-name name)
        wrap (ta-struct-wrap-name name)
        generic
          (and (> (primitive/code-count form) 1)
               (primitive/code-vector? (primitive/code-nth form 1)))
        start (if generic 2 1)]
    (if generic
        `(~wrap (~payload ~@(ta-rewrite-constructor-items form
                                                          start
                                                          (primitive/code-count form)
                                                          inside)))
        `(~wrap (~payload ~@(ta-rewrite-constructor-items form
                                                          start
                                                          (primitive/code-count form)
                                                          inside))))))

(defn ta-rewrite-struct-constructor [(form Code) (inside bool)] (-> Code)
  (ta-rewrite-struct-constructor-for form
                                     inside
                                     (ma-unref-type (primitive/type-of form))))

(defn ta-type-arg-vector [(ty Code) (i i64) (n i64)] (-> Code)
  (if (>= i n)
      `[]
      `[~(primitive/code-nth ty i) ~@(ta-type-arg-vector ty (+ i 1) n)]))

(defn ta-source-field-access? [(form Code)] (-> bool)
  (and (primitive/code-list? form)
       (and (= (primitive/code-count form) 2)
            (let [head (primitive/code-nth form 0)]
              (and (primitive/code-sym? head)
                   (and (not (= (primitive/code-sym head) ".auto-owner"))
                        (and (str/starts-with (primitive/code-sym head) ".")
                             (ta-source-struct-type? (primitive/type-of (primitive/code-nth form 1))))))))))

(defn ta-field-access? [(form Code)] (-> bool)
  (and (primitive/code-list? form)
       (and (= (primitive/code-count form) 2)
            (let [head (primitive/code-nth form 0)]
              (and (primitive/code-sym? head)
                   (str/starts-with (primitive/code-sym head) "."))))))

(defn ta-rewrite-field-receiver [(form Code) (inside bool)] (-> Code)
  `(~(primitive/code-nth form 0) ~(ma-rewrite (primitive/code-nth form 1) inside false)))

(defn ta-rewrite-source-field [(form Code) (inside bool)] (-> Code)
  (let [head (primitive/code-nth form 0)
        recv (primitive/code-nth form 1)
        ty (ma-unref-type (primitive/type-of recv))
        name (ta-struct-name-from-type ty)
        borrow (ta-struct-borrow-name name)]
    `(~head (~borrow ~(ma-rewrite recv inside false)))))

(defn ma-rewrite [(form Code) (inside bool) (consumes bool)] (-> Code)
  (if (primitive/code-sym? form)
      (if (and inside (and consumes (ma-managed-reference? form)))
          `(clone ~form)
          form)
      (if (not (primitive/code-list? form))
          form
          (if (not inside)
              form
              (let [n (primitive/code-count form)
                    active inside]
                (if (= n 0)
                    form
                    (let [head (primitive/code-nth form 0)]
                      (cond (ta-source-field-access? form) (ta-rewrite-source-field form active)
                            (ta-field-access? form) (ta-rewrite-field-receiver form active)
                            (ta-source-struct-constructor? form) (ta-rewrite-struct-constructor form active)
                            (primitive/code-eq head `clone)
                              (let [value (primitive/code-nth form 1)
                                    value-type (ma-unref-type (primitive/type-of value))]
                                (if (ta-reflect-source-sum? value-type)
                                    (let [helper
                                            (ma-public-name (ta-type-head value-type)
                                                            "-auto-clone")]
                                      `(~helper ~(ma-rewrite value active false)))
                                    (if (ta-reflect-source-struct? value-type)
                                        (let [helper (ta-struct-clone-name (ta-type-head value-type))]
                                          `(~helper ~(ma-rewrite value active false)))
                                        form)))
                            (primitive/code-eq head `move) form
                            (or (primitive/code-eq head `mut)
                                (primitive/code-eq head `ref))
                              `(~head ~(ma-rewrite (primitive/code-nth form 1) active false))
                            (and (primitive/code-eq head `set!) (= n 3))
                            ; The destination is a writable place, never a consumed
                            ; value. Only the replacement crosses an ownership
                            ; boundary. Treating both operands like call arguments
                            ; cloned an affine local and destroyed its place type.
                            (let [place (primitive/code-nth form 1)
                                  value (primitive/code-nth form 2)
                                  place-type (ma-unref-type (primitive/type-of place))]
                              `(set! ~(ma-rewrite place active false)
                                     ~(if (and (primitive/code-list? value)
                                               (and (> (primitive/code-count value) 0)
                                                    (and (ta-head-names-type? (primitive/code-nth value 0)
                                                                              place-type)
                                                         (ta-reflect-source-struct? place-type))))
                                          ; A failed provisional assignment may
                                          ; leave the RHS constructor without type
                                          ; metadata. Its writable destination still
                                          ; provides the authoritative source type.
                                          (ta-rewrite-struct-constructor-for value
                                                                             active
                                                                             place-type)
                                          (ma-rewrite value active true))))
                              (or (ta-auto-weak-preview-head? head)
                                  (ta-auto-weak-upgrade-preview-head? head))
                            (ta-rewrite-weak-preview-call form active)
                              (or (ta-auto-runtime-head? head)
                                  (and (primitive/code-sym? head)
                                       (let [name (primitive/code-sym head)]
                                         (or (= name "auto-al-new")
                                             (= name "coil.arc.auto-runtime.auto-al-new")))))
                            (ta-rewrite-auto-call form active)
                              (and (primitive/code-eq head `let)
                                   (and (> n 1)
                                        (primitive/code-vector? (primitive/code-nth form 1))))
                            (let [items (primitive/code-nth form 1)]
                              `(let [~@(ma-rewrite-let-items items 0 (primitive/code-count items) active)]
                                 ~@(ma-rewrite-body-items form 2 n active consumes)))
                              (or (primitive/code-eq head `do)
                                  (primitive/code-eq head `block))
                            `(~head ~@(ma-rewrite-body-items form 1 n active consumes))
                              (and (primitive/code-eq head `match) (> n 1))
                            `(match ~(ma-rewrite (primitive/code-nth form 1) active false)
                               ~@(ma-rewrite-match-arms form 2 n active consumes))
                              :else
                            `(~head ~@(ma-rewrite-call-items form 1 n active))))))))))

(defn ma-defn? [(form Code)] (-> bool)
  (and (primitive/code-list? form)
       (and (>= (primitive/code-count form) 4)
            (ta-symbol-named? (primitive/code-nth form 0) "defn"))))

(defn ma-rewrite-user-form [(form Code)] (-> Code)
  (if (ma-defn? form)
      (let [n (primitive/code-count form)
            name (primitive/code-nth form 1)]
        (if (and (primitive/code-sym? name)
                 (str/string-view-contains? (str/StringView :raw (primitive/code-sym name))
                                            (str/sv "-auto-clone")))
            form
            `(defn ~name
               ~(primitive/code-nth form 2)
               ~(primitive/code-nth form 3)
               ~@(ma-rewrite-body-items form 4 n true true))))
      (ma-rewrite form false false)))

(defn ma-rewrite-user-module-forms [(module Code) (i i64) (n i64)] (-> Code)
  (if (>= i n)
      `()
      (let [form (primitive/code-nth module i)
            rest (ma-rewrite-user-module-forms module (+ i 1) n)]
        (if (ta-plain-defstruct? form)
            `(~@(ta-lower-plain-defstruct form) ~@rest)
            (if (ta-plain-defsum? form)
                (if (and (> (primitive/code-count rest) 0)
                         (ta-clone-impl-for? (primitive/code-nth rest 0)
                                             (primitive/code-nth form 1)))
                    `(~form ~@rest)
                    `(~@(ta-lower-plain-defsum form) ~@rest))
                `(~(ma-rewrite-user-form form) ~@rest))))))

(defn ma-rewrite-user-module [(module Code)] (-> Code)
  `(~(primitive/code-nth module 0) ~@(ma-rewrite-user-module-forms module 1 (primitive/code-count module))))

(defn ma-rewrite-modules [(modules Code) (i i64) (n i64)] (-> Code)
  (if (>= i n)
      `()
      (let [module (primitive/code-nth modules i)]
        `(~(if (ta-user-module? module)
               (ma-rewrite-user-module module)
               module) ~@(ma-rewrite-modules modules (+ i 1) n)))))

(defn managed-ownership-pass [(modules Code)] (-> Code)
  `(do ~@(ma-rewrite-modules modules 0 (primitive/code-count modules))))

(transform managed-ownership-pass :phase ownership)
