(module coil.iter)

(provide-core [range
               map
               filter
               take
               skip
               enumerate
               chain
               zip
               fold
               count
               find
               any?
               all?])

(import "coil.primitive" :as primitive)

; Pull-based, allocation-free lazy iteration. Constructors accept any Iterable,
; mint its iterator once, and adapters perform work only when `next` is called.
(defstruct Range [(current i64) (end i64)])

;;; A lazy half-open integer range `[start, end)`.
(defn range [(start i64) (end i64)] (-> Range)
  (Range :current start :end end))

(impl Iterable Range
  (iter [(r Range)] (-> Range) r))

(impl Iterator Range
  (next [(r (mut Range))]
        (-> (Option i64))
        (if (< (.current r) (.end r))
            (let [value (.current r)]
              (set! (.current r) (+ value 1))
              (Some value))
            (None))))

(defstruct MapIter [I F T U] [(source I) (f F)])

;;; Lazily transform every item in any Iterable.
(defn map [(C (Iterable I)) (I (Iterator T)) (F (Callable T U)) T U] [(source C) (f F)] (-> (MapIter I F T U))
  (MapIter :source (iter source) :f f))

(impl [(I (Iterator T)) (F (Callable T U)) T U] Iterable (MapIter I F T U)
  (iter [(m (MapIter I F T U))] (-> (MapIter I F T U)) m))

(impl [(I (Iterator T)) (F (Callable T U)) T U] Iterator (MapIter I F T U)
  (next [(m (mut (MapIter I F T U)))]
        (-> (Option U))
        (match (next (mut (.source m)))
          (None [] (None))
          (Some [value]
                (Some (Callable::call (load (field m f)) value))))))

(defstruct FilterIter [I F T] [(source I) (predicate F)])

;;; Lazily retain the items satisfying `predicate`.
(defn filter [(C (Iterable I)) (I (Iterator T)) (F (Callable T bool)) T] [(source C) (predicate F)] (-> (FilterIter I F T))
  (FilterIter :source (iter source) :predicate predicate))

(impl [(I (Iterator T)) (F (Callable T bool)) T] Iterable (FilterIter I F T)
  (iter [(f (FilterIter I F T))] (-> (FilterIter I F T)) f))

(impl [(I (Iterator T)) (F (Callable T bool)) T] Iterator (FilterIter I F T)
  (next [(f (mut (FilterIter I F T)))]
        (-> (Option T))
        (loop (match (next (mut (.source f)))
                (None [] (break (None)))
                (Some [value]
                      (if (Callable::call (load (field f predicate)) value)
                          (break (Some value))
                          0))))))

(defstruct TakeIter [I T] [(source I) (remaining i64)])

;;; Lazily yield at most `count` items. A non-positive count is empty.
(defn take [(C (Iterable I)) (I (Iterator T)) T] [(source C) (count i64)] (-> (TakeIter I T))
  (TakeIter :source (iter source) :remaining (if (> count 0) count 0)))

(impl [(I (Iterator T)) T] Iterable (TakeIter I T)
  (iter [(t (TakeIter I T))] (-> (TakeIter I T)) t))

(impl [(I (Iterator T)) T] Iterator (TakeIter I T)
  (next [(t (mut (TakeIter I T)))]
        (-> (Option T))
        (if (> (.remaining t) 0)
            (match (next (mut (.source t)))
              (None [] (do (set! (.remaining t) 0) (None)))
              (Some [value]
                    (do (set! (.remaining t) (- (.remaining t) 1)) (Some value))))
            (None))))

(defstruct SkipIter [I T] [(source I) (remaining i64)])

;;; Lazily discard the first `count` items, then yield the rest.
(defn skip [(C (Iterable I)) (I (Iterator T)) T] [(source C) (count i64)] (-> (SkipIter I T))
  (SkipIter :source (iter source) :remaining (if (> count 0) count 0)))

(impl [(I (Iterator T)) T] Iterable (SkipIter I T)
  (iter [(s (SkipIter I T))] (-> (SkipIter I T)) s))

(impl [(I (Iterator T)) T] Iterator (SkipIter I T)
  (next [(s (mut (SkipIter I T)))]
        (-> (Option T))
        (loop (if (> (.remaining s) 0)
                  (match (next (mut (.source s)))
                    (None [] (do (set! (.remaining s) 0) (break (None))))
                    (Some [_] (set! (.remaining s) (- (.remaining s) 1))))
                  (break (next (mut (.source s))))))))

(defstruct Indexed [T] [(index i64) (value T)])

(defstruct EnumerateIter [I T] [(source I) (index i64)])

;;; Lazily pair every item with its zero-based index.
(defn enumerate [(C (Iterable I)) (I (Iterator T)) T] [(source C)] (-> (EnumerateIter I T))
  (EnumerateIter :source (iter source) :index 0))

(impl [(I (Iterator T)) T] Iterable (EnumerateIter I T)
  (iter [(e (EnumerateIter I T))] (-> (EnumerateIter I T)) e))

(impl [(I (Iterator T)) T] Iterator (EnumerateIter I T)
  (next [(e (mut (EnumerateIter I T)))]
        (-> (Option (Indexed T)))
        (match (next (mut (.source e)))
          (None [] (None))
          (Some [value]
                (let [index (.index e)]
                  (set! (.index e) (+ index 1))
                  (Some (Indexed :index index :value value)))))))

(defstruct ChainIter [A B T] [(first A) (second B) (first-done bool)])

;;; Lazily yield `first`, followed by `second`.
(defn chain [(CA (Iterable IA))
             (IA (Iterator T))
             (CB (Iterable IB))
             (IB (Iterator T))
             T] [(first CA) (second CB)] (-> (ChainIter IA IB T))
  (ChainIter
    :first (iter first)
    :second (iter second)
    :first-done false))

(impl [(A (Iterator T)) (B (Iterator T)) T] Iterable (ChainIter A B T)
  (iter [(c (ChainIter A B T))] (-> (ChainIter A B T)) c))

(impl [(A (Iterator T)) (B (Iterator T)) T] Iterator (ChainIter A B T)
  (next [(c (mut (ChainIter A B T)))]
        (-> (Option T))
        (if (.first-done c)
            (next (mut (.second c)))
            (match (next (mut (.first c)))
              (Some [value] (Some value))
              (None []
                    (do
                      (set! (.first-done c) true)
                      (next (mut (.second c)))))))))

(defstruct ZipItem [A B] [(first A) (second B)])

(defstruct ZipIter [IA IB A B] [(first IA) (second IB)])

;;; Lazily pair two Iterables, stopping when either one ends.
(defn zip [(CA (Iterable IA))
           (IA (Iterator A))
           (CB (Iterable IB))
           (IB (Iterator B))
           A
           B] [(first CA) (second CB)] (-> (ZipIter IA IB A B))
  (ZipIter :first (iter first) :second (iter second)))

(impl [(IA (Iterator A)) (IB (Iterator B)) A B] Iterable (ZipIter IA IB A B)
  (iter [(z (ZipIter IA IB A B))] (-> (ZipIter IA IB A B)) z))

(impl [(IA (Iterator A)) (IB (Iterator B)) A B] Iterator (ZipIter IA IB A B)
  (next [(z (mut (ZipIter IA IB A B)))]
        (-> (Option (ZipItem A B)))
        (match (next (mut (.first z)))
          (None [] (None))
          (Some [a]
                (match (next (mut (.second z)))
                  (None [] (None))
                  (Some [b] (Some (ZipItem :first a :second b))))))))

;;; Consume an Iterable into one accumulated value.
(defn fold [(C (Iterable I)) (I (Iterator T)) (F (Callable A T A)) T A] [(source C) (initial A) (f F)] (-> A)
  (let [(mut iterator) (iter source)
        (mut accumulator) initial]
    (loop (match (next (mut iterator))
            (None [] (break))
            (Some [value]
                  (store! accumulator (Callable::call f (load accumulator) value)))))
    (load accumulator)))

;;; Consume an Iterable and return its number of items.
(defn count [(C (Iterable I)) (I (Iterator T)) T] [(source C)] (-> i64)
  (let [(mut iterator) (iter source)
        (mut total) 0]
    (loop (match (next (mut iterator))
            (None [] (break))
            (Some [_] (store! total (+ (load total) 1)))))
    (load total)))

;;; Return the first item satisfying `predicate`, if any.
(defn find [(C (Iterable I)) (I (Iterator T)) (F (Callable T bool)) T] [(source C) (predicate F)] (-> (Option T))
  (let [(mut iterator) (iter source)]
    (loop (match (next (mut iterator))
            (None [] (break (None)))
            (Some [value]
                  (if (Callable::call predicate value)
                      (break (Some value))
                      0))))))

;;; Whether any item satisfies `predicate`.
(defn any? [(C (Iterable I)) (I (Iterator T)) (F (Callable T bool)) T] [(source C) (predicate F)] (-> bool)
  (let [(mut iterator) (iter source)]
    (loop (match (next (mut iterator))
            (None [] (break false))
            (Some [value]
                  (if (Callable::call predicate value)
                      (break true)
                      0))))))

;;; Whether every item satisfies `predicate` (true for an empty Iterable).
(defn all? [(C (Iterable I)) (I (Iterator T)) (F (Callable T bool)) T] [(source C) (predicate F)] (-> bool)
  (let [(mut iterator) (iter source)]
    (loop (match (next (mut iterator))
            (None [] (break true))
            (Some [value]
                  (if (Callable::call predicate value)
                      0
                      (break false)))))))

(export Range
        MapIter
        FilterIter
        TakeIter
        SkipIter
        Indexed
        EnumerateIter
        ChainIter
        ZipItem
        ZipIter
        range
        map
        filter
        take
        skip
        enumerate
        chain
        zip
        fold
        count
        find
        any?
        all?)
