(module coil.subprocess)
(import "coil.primitive" :as primitive)
(import "coil.alloc" :as alloc)
(import "coil.slice" :use [slice-new slice-data slice-len slice-get])
(import "coil.slice" :as slice)
(import "coil.os" :as os)
(import "coil.io" :as io)
(import "coil.time" :as time)
(import "coil.selectors" :as selectors)
(import "coil.cancellation" :as cancellation)
(import "coil.str" :as str)

(export Stdio
        Inherit
        Null
        Pipe
        MergeStdout
        ExitStatus
        Exited
        Signaled
        Child
        SpawnOptions
        SubprocessError
        InvalidCommand
        OutOfMemory
        PipeFailed
        SpawnFailed
        WaitFailed
        SignalFailed
        Timeout
        StillRunning
        AlreadyClosed
        inherit-stdio
        null-stdio
        pipe-stdio
        merge-stderr
        spawn
        spawn-with-options
        spawn-options
        child-id
        child-stdin-writer
        child-stdout-reader
        child-stderr-reader
        child-close-stdin
        child-try-wait
        child-wait
        child-wait-until
        child-terminate
        child-kill
        child-kill-and-wait
        child-close
        RunOptions
        RunResult
        run-options
        run
        run-result-free)

;;; Policy for one child standard stream. `MergeStdout` is valid only for stderr.
(defsum Stdio (Inherit) (Null) (Pipe) (MergeStdout))

(defsum ExitStatus (Exited [(code i64)]) (Signaled [(signal i64)]))

(defsum SubprocessError
  (InvalidCommand)
  (OutOfMemory)
  (PipeFailed [(code i64)])
  (SpawnFailed [(code i64)])
  (WaitFailed [(code i64)])
  (SignalFailed [(code i64)])
  (Timeout)
  (StillRunning)
  (AlreadyClosed))

;;; Caller-owned child state. Descriptors less than zero are absent or already closed.
(defstruct Child
  [(pid i32)
   (stdin-fd i32)
   (stdout-fd i32)
   (stderr-fd i32)
   (waited bool)
   (closed bool)
   (process-group bool)
   (status-kind i32)
   (status-code i64)])

;;; `cwd` is a borrowed NUL-terminated path valid through spawn-with-options.
(defstruct SpawnOptions [(cwd (ptr i8)) (new-process-group bool)])

(defn spawn-options [] (-> SpawnOptions)
  (let [options (primitive/alloc-stack SpawnOptions)]
    (store! (field options cwd) (primitive/cast (ptr i8) 0))
    (store! (field options new-process-group) false)
    (load options)))

(defn inherit-stdio [] (-> Stdio)
  (Inherit))

(defn null-stdio [] (-> Stdio)
  (Null))

(defn pipe-stdio [] (-> Stdio)
  (Pipe))

(defn merge-stderr [] (-> Stdio)
  (MergeStdout))

(defn stdio-piped? [(policy Stdio)] (-> bool)
  (match policy (Inherit [] false) (Null [] false) (Pipe [] true) (MergeStdout [] false)))

(defn close-if-open [(fd i32)] (-> i64)
  (if (>= fd 0) (primitive/cast i64 (os/close fd)) 0))

(defn set-cloexec [(fd i32)] (-> i64)
  (if (< (os/fcntl fd 2 1) 0) (os/os-errno) 0))

(defn make-pipe [(fds (ptr (array i32 2)))] (-> i64)
  (if (< (os/pipe (primitive/cast (ptr i32) fds)) 0)
      (os/os-errno)
      (let [a (set-cloexec (load (primitive/index fds 0)))
            b (set-cloexec (load (primitive/index fds 1)))]
        (if (!= a 0) a b))))

(defn init-pair [(fds (ptr (array i32 2)))] (-> i64)
  (store! (primitive/index fds 0) -1)
  (store! (primitive/index fds 1) -1)
  0)

(defn alloc-c-string [(a (dyn alloc/Allocator)) (s (slice u8))] (-> (Result (ptr i8) SubprocessError))
  (let [len (slice-len s)]
    (if (os/slice-has-byte? s (primitive/cast u8 0))
        (Err (InvalidCommand))
        (match (alloc/alloc [i8] a (+ len 1))
          (None [] (Err (OutOfMemory)))
          (Some [memory]
                (let [p (slice-data memory)
                      (mut i) 0]
                  (loop (if (>= (load i) len)
                            (break)
                            (do
                              (store! (primitive/index p (load i))
                                      (primitive/cast i8 (slice-get s (load i))))
                              (store! i (+ (load i) 1)))))
                  (store! (primitive/index p len) (primitive/cast i8 0))
                  (Ok p)))))))

(defn free-argv [(a (dyn alloc/Allocator))
                 (argv (ptr (ptr i8)))
                 (program (slice u8))
                 (args (slice (slice u8)))
                 (built i64)] (-> i64)
  (if (> built 0)
      (alloc/free [i8] a (slice-new (load argv) (+ (slice-len program) 1)))
      0)
  (let [(mut i) 1]
    (loop (if (>= (load i) built)
              (break)
              (do
                (alloc/free [i8]
                            a
                            (slice-new (load (primitive/index argv (load i)))
                                       (+ (slice-len (slice-get args (- (load i) 1))) 1)))
                (store! i (+ (load i) 1))))))
  (alloc/free [(ptr i8)] a (slice-new argv (+ (slice-len args) 2)))
  0)

(defn build-argv-items [(a (dyn alloc/Allocator))
                        (argv (ptr (ptr i8)))
                        (args (slice (slice u8)))
                        (index i64)
                        (built (ptr i64))] (-> (Result i64 SubprocessError))
  (if (>= index (slice-len args))
      (do
        (store! (primitive/index argv (+ index 1)) (primitive/cast (ptr i8) 0))
        (Ok 0))
      (match (alloc-c-string a (slice-get args index))
        (Err [e] (Err e))
        (Ok [arg]
            (do
              (store! (primitive/index argv (+ index 1)) arg)
              (store! built (+ (load built) 1))
              (build-argv-items a argv args (+ index 1) built))))))

(defn build-argv [(a (dyn alloc/Allocator))
                  (program (slice u8))
                  (args (slice (slice u8)))
                  (built (ptr i64))] (-> (Result (ptr (ptr i8)) SubprocessError))
  (let [count (+ (slice-len args) 2)]
    (match (alloc/alloc [(ptr i8)] a count)
      (None [] (Err (OutOfMemory)))
      (Some [memory]
            (let [argv (slice-data memory)]
              (store! built 0)
              (match (alloc-c-string a program)
                (Err [e]
                     (do
                       (alloc/free [(ptr i8)] a memory)
                       (Err e)))
                (Ok [p]
                    (do
                      (store! argv p)
                      (store! built 1)
                      (match (build-argv-items a argv args 0 built)
                        (Ok [_] (Ok argv))
                        (Err [e]
                             (do
                               (free-argv a argv program args (load built))
                               (Err e))))))))))))

(defn child-report-error [(fd i32) (code i64)] (-> i64)
  (let [slot (primitive/alloc-stack i32)]
    (store! slot (primitive/cast i32 code))
    (child-write-error fd (primitive/cast (ptr i8) slot) 4)
    (os/_exit 127)
    0))

; The exec-error record is four bytes, below PIPE_BUF, but a signal may interrupt the
; write before any byte is transferred. Stay within async-signal-safe libc calls.
(defn child-write-error [(fd i32) (data (ptr i8)) (remaining i64)] (-> i64)
  (if (<= remaining 0)
      0
      (let [n (primitive/cast i64 (io/write fd data (primitive/cast isize remaining)))]
        (if (> n 0)
            (child-write-error fd (primitive/index data n) (- remaining n))
            (if (and (< n 0) (= (os/os-errno) 4))
                (child-write-error fd data remaining)
                0)))))

; EOF means exec succeeded because the child-side descriptor is close-on-exec. A four
; byte record means setup/exec failed. EINTR must not be mistaken for EOF.
(defn read-exec-error [(fd i32) (slot (ptr i32))] (-> i64)
  (let [n
          (primitive/cast i64
                          (io/read fd (primitive/cast (ptr i8) slot) (primitive/cast isize 4)))]
    (if (and (< n 0) (= (os/os-errno) 4)) (read-exec-error fd slot) n)))

(defn waitpid-retry [(pid i32) (status (ptr i32)) (flags i32)] (-> i32)
  (let [rc (os/waitpid pid status flags)]
    (if (and (< rc 0) (= (os/os-errno) 4)) (waitpid-retry pid status flags) rc)))

(defn child-redirect [(policy Stdio)
                      (pair (ptr (array i32 2)))
                      (target i32)
                      (input bool)
                      (error-fd i32)] (-> i64)
  (match policy
    (Inherit [] 0)
    (MergeStdout []
                 (if (= target 2)
                     (if (< (os/dup2 1 2) 0) (child-report-error error-fd (os/os-errno)) 0)
                     (child-report-error error-fd 22)))
    (Pipe []
          (let [source (load (primitive/index pair (if input 0 1)))]
            (if (< (os/dup2 source target) 0) (child-report-error error-fd (os/os-errno)) 0)))
    (Null []
          (let [fd (os/open c"/dev/null" (if input 0 1) 0)]
            (if (< fd 0)
                (child-report-error error-fd (os/os-errno))
                (do
                  (if (< (os/dup2 fd target) 0) (child-report-error error-fd (os/os-errno)) 0)
                  (os/close fd)
                  0))))))

(defn close-pair [(pair (ptr (array i32 2)))] (-> i64)
  (close-if-open (load (primitive/index pair 0)))
  (close-if-open (load (primitive/index pair 1)))
  0)

(defn child-init [(child (ptr Child))
                  (pid i32)
                  (stdin-fd i32)
                  (stdout-fd i32)
                  (stderr-fd i32)
                  (process-group bool)] (-> i64)
  (store! (field child pid) pid)
  (store! (field child stdin-fd) stdin-fd)
  (store! (field child stdout-fd) stdout-fd)
  (store! (field child stderr-fd) stderr-fd)
  (store! (field child waited) false)
  (store! (field child closed) false)
  (store! (field child process-group) process-group)
  (store! (field child status-kind) 0)
  (store! (field child status-code) 0)
  0)

;;; Spawn `program` with exact argument bytes and no shell interpretation. `args` excludes
;;; argv[0], which is set to `program`. The executable is located with PATH like Python's
;;; subprocess default. Inputs are borrowed only until this call returns.
(defn spawn-with-options [(a (dyn alloc/Allocator))
                          (child (ptr Child))
                          (program (slice u8))
                          (args (slice (slice u8)))
                          (stdin-policy Stdio)
                          (stdout-policy Stdio)
                          (stderr-policy Stdio)
                          (options SpawnOptions)] (-> (Result (ptr Child) SubprocessError))
  (if (= (slice-len program) 0)
      (Err (InvalidCommand))
      (let [stdin-pipe (primitive/alloc-stack (array i32 2))
            stdout-pipe (primitive/alloc-stack (array i32 2))
            stderr-pipe (primitive/alloc-stack (array i32 2))
            error-pipe (primitive/alloc-stack (array i32 2))
            built (primitive/alloc-stack i64)]
        (init-pair stdin-pipe)
        (init-pair stdout-pipe)
        (init-pair stderr-pipe)
        (init-pair error-pipe)
        (block :done
               (let [error (if (stdio-piped? stdin-policy) (make-pipe stdin-pipe) 0)]
                 (if (!= error 0) (return-from :done (Err (PipeFailed error))) 0))
               (let [error (if (stdio-piped? stdout-policy) (make-pipe stdout-pipe) 0)]
                 (if (!= error 0)
                     (do (close-pair stdin-pipe) (return-from :done (Err (PipeFailed error))))
                     0))
               (let [error (if (stdio-piped? stderr-policy) (make-pipe stderr-pipe) 0)]
                 (if (!= error 0)
                     (do
                       (close-pair stdin-pipe)
                       (close-pair stdout-pipe)
                       (return-from :done (Err (PipeFailed error))))
                     0))
               (let [error (make-pipe error-pipe)]
                 (if (!= error 0)
                     (do
                       (close-pair stdin-pipe)
                       (close-pair stdout-pipe)
                       (close-pair stderr-pipe)
                       (return-from :done (Err (PipeFailed error))))
                     0))
               (match (build-argv a program args built)
                 (Err [error]
                      (do
                        (close-pair stdin-pipe)
                        (close-pair stdout-pipe)
                        (close-pair stderr-pipe)
                        (close-pair error-pipe)
                        (return-from :done (Err error))))
                 (Ok [argv]
                     (let [pid (os/fork)]
                       (if (< pid 0)
                           (let [error (os/os-errno)]
                             (free-argv a argv program args (load built))
                             (close-pair stdin-pipe)
                             (close-pair stdout-pipe)
                             (close-pair stderr-pipe)
                             (close-pair error-pipe)
                             (return-from :done (Err (SpawnFailed error))))
                           (if (= pid 0)
                               (do
                                 (os/close (load (primitive/index error-pipe 0)))
                                 (if (!= (primitive/cast i64 (load (field options cwd))) 0)
                                     (if (< (os/chdir (load (field options cwd))) 0)
                                         (child-report-error (load (primitive/index error-pipe 1)) (os/os-errno))
                                         0)
                                     0)
                                 (if (load (field options new-process-group))
                                     (if (< (os/setpgid 0 0) 0)
                                         (child-report-error (load (primitive/index error-pipe 1)) (os/os-errno))
                                         0)
                                     0)
                                 (child-redirect stdin-policy stdin-pipe 0 true (load (primitive/index error-pipe 1)))
                                 (child-redirect stdout-policy
                                                 stdout-pipe
                                                 1
                                                 false
                                                 (load (primitive/index error-pipe 1)))
                                 (child-redirect stderr-policy
                                                 stderr-pipe
                                                 2
                                                 false
                                                 (load (primitive/index error-pipe 1)))
                                 (close-pair stdin-pipe)
                                 (close-pair stdout-pipe)
                                 (close-pair stderr-pipe)
                                 (os/execvp (load argv) argv)
                                 (child-report-error (load (primitive/index error-pipe 1)) (os/os-errno))
                                 (Err [(ptr Child) SubprocessError] (SpawnFailed 0)))
                               (do
                                 (os/close (load (primitive/index error-pipe 1)))
                                 (if (stdio-piped? stdin-policy) (os/close (load (primitive/index stdin-pipe 0))) 0)
                                 (if (stdio-piped? stdout-policy) (os/close (load (primitive/index stdout-pipe 1))) 0)
                                 (if (stdio-piped? stderr-policy) (os/close (load (primitive/index stderr-pipe 1))) 0)
                                 (let [exec-error (primitive/alloc-stack i32)
                                       n (read-exec-error (load (primitive/index error-pipe 0)) exec-error)]
                                   (os/close (load (primitive/index error-pipe 0)))
                                   (free-argv a argv program args (load built))
                                   (if (> n 0)
                                       (let [status (primitive/alloc-stack i32)]
                                         (waitpid-retry pid status 0)
                                         (if (stdio-piped? stdin-policy)
                                             (os/close (load (primitive/index stdin-pipe 1)))
                                             0)
                                         (if (stdio-piped? stdout-policy)
                                             (os/close (load (primitive/index stdout-pipe 0)))
                                             0)
                                         (if (stdio-piped? stderr-policy)
                                             (os/close (load (primitive/index stderr-pipe 0)))
                                             0)
                                         (return-from :done (Err (SpawnFailed (primitive/cast i64 (load exec-error))))))
                                       (do
                                         (child-init child
                                                     pid
                                                     (if (stdio-piped? stdin-policy)
                                                         (load (primitive/index stdin-pipe 1))
                                                         -1)
                                                     (if (stdio-piped? stdout-policy)
                                                         (load (primitive/index stdout-pipe 0))
                                                         -1)
                                                     (if (stdio-piped? stderr-policy)
                                                         (load (primitive/index stderr-pipe 0))
                                                         -1)
                                                     (load (field options new-process-group)))
                                         (return-from :done (Ok child)))))))))))))))

;;; Backward-compatible spawn with inherited cwd and no process group.
(defn spawn [(a (dyn alloc/Allocator))
             (child (ptr Child))
             (program (slice u8))
             (args (slice (slice u8)))
             (stdin-policy Stdio)
             (stdout-policy Stdio)
             (stderr-policy Stdio)] (-> (Result (ptr Child) SubprocessError))
  (spawn-with-options a child program args stdin-policy stdout-policy stderr-policy (spawn-options)))

(defn child-id [(child (ptr Child))] (-> i64)
  (primitive/cast i64 (load (field child pid))))

(defn child-stdin-writer [(writer (ptr io/Writer)) (child (ptr Child))] (-> (Option (ptr io/Writer)))
  (if (>= (load (field child stdin-fd)) 0)
      (Some (io/fd-writer writer (primitive/cast i64 (load (field child stdin-fd)))))
      (None)))

(defn child-stdout-reader [(reader (ptr io/Reader)) (child (ptr Child))] (-> (Option (ptr io/Reader)))
  (if (>= (load (field child stdout-fd)) 0)
      (Some (io/fd-reader reader (primitive/cast i64 (load (field child stdout-fd)))))
      (None)))

(defn child-stderr-reader [(reader (ptr io/Reader)) (child (ptr Child))] (-> (Option (ptr io/Reader)))
  (if (>= (load (field child stderr-fd)) 0)
      (Some (io/fd-reader reader (primitive/cast i64 (load (field child stderr-fd)))))
      (None)))

;;; Close the parent write end, delivering EOF to a child reading stdin. Idempotent.
(defn child-close-stdin [(child (ptr Child))] (-> i64)
  (close-if-open (load (field child stdin-fd)))
  (store! (field child stdin-fd) -1)
  0)

(defn status-decode [(raw i32)] (-> ExitStatus)
  (let [value (primitive/cast i64 raw)
        signal (& value 127)]
    (if (= signal 0) (Exited (& (>> value 8) 255)) (Signaled signal))))

(defn cache-status [(child (ptr Child)) (status ExitStatus)] (-> ExitStatus)
  (match status
    (Exited [code]
            (do (store! (field child status-kind) 1) (store! (field child status-code) code)))
    (Signaled [signal]
              (do (store! (field child status-kind) 2) (store! (field child status-code) signal))))
  (store! (field child waited) true)
  status)

(defn cached-status [(child (ptr Child))] (-> ExitStatus)
  (if (= (load (field child status-kind)) 1)
      (Exited (load (field child status-code)))
      (Signaled (load (field child status-code)))))

;;; Nonblocking status probe. `None` means the child is still running.
(defn child-try-wait [(child (ptr Child))] (-> (Result (Option ExitStatus) SubprocessError))
  (if (load (field child waited))
      (Ok (Some (cached-status child)))
      (let [raw (primitive/alloc-stack i32)
            rc (waitpid-retry (load (field child pid)) raw 1)]
        (if (= rc 0)
            (Ok (None))
            (if (< rc 0)
                (let [error (os/os-errno)]
                  (if (= error 4) (child-try-wait child) (Err (WaitFailed error))))
                (Ok (Some (cache-status child (status-decode (load raw))))))))))

;;; Block until the child is reaped. Repeated waits return the cached status.
(defn child-wait [(child (ptr Child))] (-> (Result ExitStatus SubprocessError))
  (if (load (field child waited))
      (Ok (cached-status child))
      (let [raw (primitive/alloc-stack i32)
            rc (waitpid-retry (load (field child pid)) raw 0)]
        (if (< rc 0)
            (let [error (os/os-errno)]
              (if (= error 4) (child-wait child) (Err (WaitFailed error))))
            (Ok (cache-status child (status-decode (load raw))))))))

;;; Wait until a monotonic deadline. Timeout leaves the child running and valid.
(defn child-wait-until [(child (ptr Child)) (deadline time/Instant)] (-> (Result ExitStatus SubprocessError))
  (block :done
           (loop (match (child-try-wait child)
                   (Err [e] (return-from :done (Err e)))
                   (Ok [maybe]
                       (match maybe
                         (Some [status] (return-from :done (Ok status)))
                         (None []
                               (match (time/deadline-remaining deadline)
                                 (Err [e] (return-from :done (Err (WaitFailed (time/time-error-code e)))))
                                 (Ok [remaining]
                                     (let [remainingp (primitive/alloc-stack time/Duration)]
                                       (store! remainingp remaining)
                                       (if (and (= (load (field remainingp sec)) 0)
                                                (= (load (field remainingp nsec)) 0))
                                           (return-from :done (Err (Timeout)))
                                           (match (time/duration-millis 10)
                                             (Err [e] (return-from :done (Err (WaitFailed (time/time-error-code e)))))
                                             (Ok [pause] (time/sleep pause))))))))))))))

(defn child-signal [(child (ptr Child)) (signal i32)] (-> (Result i64 SubprocessError))
  (if (load (field child waited))
      (Err (AlreadyClosed))
      (let [target
              (if (load (field child process-group))
                  (primitive/isub 0 (load (field child pid)))
                  (load (field child pid)))]
        (if (= (os/kill target signal) 0)
            (Ok 0)
            (Err (SignalFailed (os/os-errno)))))))

;;; Request graceful termination (SIGTERM). The caller must still wait.
(defn child-terminate [(child (ptr Child))] (-> (Result i64 SubprocessError))
  (child-signal child 15))

;;; Force termination (SIGKILL). The caller must still wait.
(defn child-kill [(child (ptr Child))] (-> (Result i64 SubprocessError))
  (child-signal child 9))

;;; Force termination and reap, providing an explicit leak-free finalization path.
(defn child-kill-and-wait [(child (ptr Child))] (-> (Result ExitStatus SubprocessError))
  (match (child-kill child) (Err [e] (Err e)) (Ok [_] (child-wait child))))

;;; Close parent-owned streams. A live child is not silently detached: this returns
;;; `StillRunning`; call wait or kill-and-wait before final close. Idempotent once reaped.
(defn child-close [(child (ptr Child))] (-> (Result i64 SubprocessError))
  (child-close-stdin child)
  (close-if-open (load (field child stdout-fd)))
  (close-if-open (load (field child stderr-fd)))
  (store! (field child stdout-fd) -1)
  (store! (field child stderr-fd) -1)
  (if (load (field child waited))
      (do (store! (field child closed) true) (Ok 0))
      (Err (StillRunning))))

;;; Cohesive execution options. Empty `cwd` inherits the parent directory; a null
;;; cancellation pointer disables cancellation. Capture limits are hard memory bounds.
(defstruct RunOptions
  [(program (slice u8))
   (args (slice (slice u8)))
   (cwd (slice u8))
   (stdout-limit i64)
   (stderr-limit i64)
   (deadline (Option time/Instant))
   (cancellation (ptr cancellation/Cancellation))
   (terminate-grace time/Duration)])

;;; Captured byte slices are allocator-owned. Release both with run-result-free.
(defstruct RunResult
  [(stdout (slice u8))
   (stderr (slice u8))
   (stdout-capacity i64)
   (stderr-capacity i64)
   (status ExitStatus)
   (timed-out bool)
   (cancelled bool)
   (stdout-truncated bool)
   (stderr-truncated bool)])

(defstruct CaptureBuffer
  [(data (ptr i8))
   (length i64)
   (capacity i64)
   (limit i64)
   (truncated bool)])

(defn run-options [(program (slice u8))
                   (args (slice (slice u8)))
                   (cwd (slice u8))
                   (stdout-limit i64)
                   (stderr-limit i64)
                   (deadline (Option time/Instant))
                   (cancel-token (ptr cancellation/Cancellation))
                   (terminate-grace time/Duration)] (-> RunOptions)
  (let [options (primitive/alloc-stack RunOptions)]
    (store! (field options program) program)
    (store! (field options args) args)
    (store! (field options cwd) cwd)
    (store! (field options stdout-limit) stdout-limit)
    (store! (field options stderr-limit) stderr-limit)
    (store! (field options deadline) deadline)
    (store! (field options cancellation) cancel-token)
    (store! (field options terminate-grace) terminate-grace)
    (load options)))

(defn capture-init [(a (dyn alloc/Allocator)) (capture (ptr CaptureBuffer)) (limit i64)] (-> (Result i64
                                                                                                     SubprocessError))
  (let [capacity (if (> limit 8192) 8192 (if (> limit 0) limit 0))]
    (store! (field capture limit) limit)
    (if (= capacity 0)
        (do
          (store! (field capture data) (primitive/cast (ptr i8) 0))
          (store! (field capture length) 0)
          (store! (field capture capacity) 0)
          (store! (field capture truncated) false)
          (Ok 0))
        (match (alloc/alloc [i8] a capacity)
          (None [] (Err (OutOfMemory)))
          (Some [memory]
                (do
                  (store! (field capture data) (slice-data memory))
                  (store! (field capture length) 0)
                  (store! (field capture capacity) capacity)
                  (store! (field capture truncated) false)
                  (Ok 0)))))))

(defn capture-free [(a (dyn alloc/Allocator)) (capture (ptr CaptureBuffer))] (-> i64)
  (if (> (load (field capture capacity)) 0)
      (alloc/free [i8]
                  a
                  (slice-new (load (field capture data)) (load (field capture capacity))))
      0)
  (store! (field capture capacity) 0)
  0)

(defn capture-grow! [(a (dyn alloc/Allocator))
                     (capture (ptr CaptureBuffer))
                     (required i64)] (-> bool)
  (let [capacity (load (field capture capacity))
        limit (load (field capture limit))]
    (if (or (<= required capacity) (>= capacity limit))
        true
        (let [(mut next) capacity]
          (loop (if (and (< (load next) required) (< (load next) limit))
                    (store! next
                            (if (> (load next) (primitive/idiv limit 2))
                                limit
                                (primitive/imul (load next) 2)))
                    (break)))
          (match (alloc/reallocate [i8]
                                   a
                                   (slice-new (load (field capture data)) capacity)
                                   (load next))
            (None [] false)
            (Some [memory]
                  (do
                    (store! (field capture data) (slice-data memory))
                    (store! (field capture capacity) (load next))
                    true)))))))

(defn capture-append [(a (dyn alloc/Allocator))
                      (capture (ptr CaptureBuffer))
                      (source (ptr i8))
                      (count i64)] (-> bool)
  (if (not (capture-grow! a capture (+ (load (field capture length)) count)))
      false
      (let [available (- (load (field capture capacity)) (load (field capture length)))
            copy-count (if (< available count) available count)
            (mut i) 0]
        (loop (if (>= (load i) copy-count)
                  (break)
                  (do
                    (store! (primitive/index (load (field capture data)) (+ (load (field capture length)) (load i)))
                            (load (primitive/index source (load i))))
                    (store! i (+ (load i) 1)))))
        (store! (field capture length) (+ (load (field capture length)) copy-count))
        (if (> count copy-count) (store! (field capture truncated) true) 0)
        true)))

(defn capture-read-fd [(a (dyn alloc/Allocator))
                       (capture (ptr CaptureBuffer))
                       (fd i32)] (-> (Result bool SubprocessError))
  (let [buffer (primitive/alloc-stack (array i8 8192))
        n
          (primitive/cast i64
                          (io/read fd (primitive/cast (ptr i8) buffer) (primitive/cast isize 8192)))]
    (if (> n 0)
        (if (capture-append a capture (primitive/cast (ptr i8) buffer) n)
            (Ok true)
            (Err (OutOfMemory)))
        (if (= n 0)
            (Ok false)
            (let [error (os/os-errno)]
              (if (= error 4) (Ok true) (Err (WaitFailed error))))))))

(defn close-output-fd [(child (ptr Child)) (stdout bool)] (-> i64)
  (if stdout
      (do (close-if-open (load (field child stdout-fd))) (store! (field child stdout-fd) -1))
      (do (close-if-open (load (field child stderr-fd))) (store! (field child stderr-fd) -1)))
  0)

(defn terminate-and-reap [(child (ptr Child)) (grace time/Duration)] (-> (Result ExitStatus SubprocessError))
  (match (child-terminate child)
    (Err [_] 0)
    (Ok [_] 0))
  (match (time/deadline-after grace)
    (Err [_] (child-kill-and-wait child))
    (Ok [deadline]
        (match (child-wait-until child deadline)
          (Ok [status] (Ok status))
          (Err [_] (child-kill-and-wait child))))))

(defn finish-run-result [(result (ptr RunResult))
                         (stdout (ptr CaptureBuffer))
                         (stderr (ptr CaptureBuffer))
                         (status ExitStatus)
                         (timed-out bool)
                         (cancelled bool)] (-> (ptr RunResult))
  (store! (field result stdout)
          (slice/slice-new [u8] (primitive/cast (ptr u8) (load (field stdout data))) (load (field stdout length))))
  (store! (field result stderr)
          (slice/slice-new [u8] (primitive/cast (ptr u8) (load (field stderr data))) (load (field stderr length))))
  (store! (field result stdout-capacity) (load (field stdout capacity)))
  (store! (field result stderr-capacity) (load (field stderr capacity)))
  (store! (field result status) status)
  (store! (field result timed-out) timed-out)
  (store! (field result cancelled) cancelled)
  (store! (field result stdout-truncated) (load (field stdout truncated)))
  (store! (field result stderr-truncated) (load (field stderr truncated)))
  result)

;;; Spawn, concurrently drain stdout/stderr, honor deadline/cancellation, terminate the
;;; entire process group, and reap on every post-spawn path.
(defn run [(a (dyn alloc/Allocator))
           (result (ptr RunResult))
           (options RunOptions)] (-> (Result (ptr RunResult) SubprocessError))
  (if (or (< (load (field options stdout-limit)) 0) (< (load (field options stderr-limit)) 0))
      (Err (InvalidCommand))
      (let [stdout (primitive/alloc-stack CaptureBuffer)
            stderr (primitive/alloc-stack CaptureBuffer)]
        (match (capture-init a stdout (load (field options stdout-limit)))
          (Err [e] (Err e))
          (Ok [_]
              (match (capture-init a stderr (load (field options stderr-limit)))
                (Err [e] (do (capture-free a stdout) (Err e)))
                (Ok [_]
                    (let [cwd
                            (if (= (slice-len (load (field options cwd))) 0)
                                (primitive/cast (ptr i8) 0)
                                (str/str->cstr a (load (field options cwd))))]
                      (if (and (> (slice-len (load (field options cwd))) 0)
                               (= (primitive/cast i64 cwd) 0))
                          (do (capture-free a stdout) (capture-free a stderr) (Err (OutOfMemory)))
                          (let [child (primitive/alloc-stack Child)
                                spawn-settings (primitive/alloc-stack SpawnOptions)]
                            (store! (field spawn-settings cwd) cwd)
                            (store! (field spawn-settings new-process-group) true)
                            (let [spawned
                                    (spawn-with-options a
                                                        child
                                                        (load (field options program))
                                                        (load (field options args))
                                                        (null-stdio)
                                                        (pipe-stdio)
                                                        (pipe-stdio)
                                                        (load spawn-settings))]
                              (if (!= (primitive/cast i64 cwd) 0)
                                  (alloc/free [i8] a (slice-new cwd (+ (slice-len (load (field options cwd))) 1)))
                                  0)
                              (match spawned
                                (Err [e] (do (capture-free a stdout) (capture-free a stderr) (Err e)))
                                (Ok [_]
                                    (block :done
                                             (let [(mut timed-out) false
                                                   (mut cancelled) false]
                                               (loop (if (and (< (load (field child stdout-fd)) 0)
                                                              (< (load (field child stderr-fd)) 0))
                                                         (break)
                                                         (let [watches (primitive/alloc-stack (array selectors/Watch 3))
                                                               (mut count) 0]
                                                           (when (>= (load (field child stdout-fd)) 0)
                                                             (store! (primitive/index watches (load count))
                                                                     (selectors/watch (load (field child stdout-fd))
                                                                                      (selectors/interest-readable)
                                                                                      1))
                                                             (store! count (+ (load count) 1)))
                                                           (when (>= (load (field child stderr-fd)) 0)
                                                             (store! (primitive/index watches (load count))
                                                                     (selectors/watch (load (field child stderr-fd))
                                                                                      (selectors/interest-readable)
                                                                                      2))
                                                             (store! count (+ (load count) 1)))
                                                           (when (!= (primitive/cast i64
                                                                                     (load (field options cancellation)))
                                                                     0)
                                                             (store! (primitive/index watches (load count))
                                                                     (cancellation/cancellation-watch (load (field options
                                                                                                                   cancellation))
                                                                                                      3))
                                                             (store! count (+ (load count) 1)))
                                                           (let [watch-slice
                                                                   (slice/slice-new [selectors/Watch]
                                                                                    (primitive/cast (ptr selectors/Watch)
                                                                                                    watches)
                                                                                    (load count))
                                                                 selected
                                                                   (match (load (field options deadline))
                                                                     (None [] (selectors/wait-many a watch-slice))
                                                                     (Some [deadline]
                                                                           (selectors/wait-many-until a
                                                                                                      watch-slice
                                                                                                      deadline)))]
                                                             (match selected
                                                               (Err [e]
                                                                    (match e
                                                                      (selectors/Timeout []
                                                                                         (do
                                                                                           (store! timed-out true)
                                                                                           (break)))
                                                                      (selectors/InvalidFd []
                                                                                           (do
                                                                                             (store! timed-out true)
                                                                                             (break)))
                                                                      (selectors/Syscall [code]
                                                                                         (do
                                                                                           (close-output-fd child true)
                                                                                           (close-output-fd child false)
                                                                                           (terminate-and-reap child
                                                                                                               (load (field options
                                                                                                                            terminate-grace)))
                                                                                           (capture-free a stdout)
                                                                                           (capture-free a stderr)
                                                                                           (return-from :done
                                                                                                          (Err (WaitFailed code)))))))
                                                               (Ok [selection]
                                                                   (let [selectionp
                                                                           (primitive/alloc-stack selectors/Selection)]
                                                                     (store! selectionp selection)
                                                                     (cond (= (load (field selectionp token)) 1)
                                                                             (match (capture-read-fd a
                                                                                                     stdout
                                                                                                     (load (field child
                                                                                                                  stdout-fd)))
                                                                               (Err [e]
                                                                                    (do
                                                                                      (terminate-and-reap child
                                                                                                          (load (field options
                                                                                                                       terminate-grace)))
                                                                                      (capture-free a stdout)
                                                                                      (capture-free a stderr)
                                                                                      (return-from :done (Err e))))
                                                                               (Ok [open]
                                                                                   (if open
                                                                                       0
                                                                                       (close-output-fd child true))))
                                                                           (= (load (field selectionp token)) 2)
                                                                             (match (capture-read-fd a
                                                                                                     stderr
                                                                                                     (load (field child
                                                                                                                  stderr-fd)))
                                                                               (Err [e]
                                                                                    (do
                                                                                      (terminate-and-reap child
                                                                                                          (load (field options
                                                                                                                       terminate-grace)))
                                                                                      (capture-free a stdout)
                                                                                      (capture-free a stderr)
                                                                                      (return-from :done (Err e))))
                                                                               (Ok [open]
                                                                                   (if open
                                                                                       0
                                                                                       (close-output-fd child false))))
                                                                           :else (do (store! cancelled true) (break))))))))))
                                               (close-output-fd child true)
                                               (close-output-fd child false)
                                               (let [status-result
                                                       (if (or (load timed-out) (load cancelled))
                                                           (terminate-and-reap child
                                                                               (load (field options terminate-grace)))
                                                           (child-wait child))]
                                                 (match status-result
                                                   (Err [e]
                                                        (do (capture-free a stdout) (capture-free a stderr) (Err e)))
                                                   (Ok [status]
                                                       (do
                                                         (child-close child)
                                                         (Ok (finish-run-result result
                                                                                stdout
                                                                                stderr
                                                                                status
                                                                                (load timed-out)
                                                                                (load cancelled))))))))))))))))))))))

(defn run-result-free [(a (dyn alloc/Allocator)) (result (ptr RunResult))] (-> i64)
  (if (> (load (field result stdout-capacity)) 0)
      (alloc/free [i8]
                  a
                  (slice-new (primitive/cast (ptr i8) (slice-data (load (field result stdout))))
                             (load (field result stdout-capacity))))
      0)
  (if (> (load (field result stderr-capacity)) 0)
      (alloc/free [i8]
                  a
                  (slice-new (primitive/cast (ptr i8) (slice-data (load (field result stderr))))
                             (load (field result stderr-capacity))))
      0)
  (store! (field result stdout-capacity) 0)
  (store! (field result stderr-capacity) 0)
  0)
