(module coil.subprocess)
(import "coil.primitive" :as primitive)
(import "coil.fmt" :use [fmt Display display-fmt Formatter])
(import "coil.alloc" :as alloc)
(import "coil.os" :as os)
(import "coil.io" :as io)
(import "coil.time" :as time)
(import "coil.selectors" :as selectors)
(import "coil.cancellation" :as cancellation)
(import "coil.str" :as str)

(export Stdio
        Inherit
        Null
        Pipe
        MergeStdout
        ExitStatus
        Exited
        Signaled
        Child
        SpawnOptions
        SubprocessError
        InvalidCommand
        OutOfMemory
        PipeFailed
        SpawnFailed
        WaitFailed
        SignalFailed
        Timeout
        StillRunning
        AlreadyClosed
        inherit-stdio
        null-stdio
        pipe-stdio
        merge-stderr
        RunOptions
        RunResult
        run)

;;; Policy for one child standard stream. `MergeStdout` is valid only for stderr.
(defsum Stdio (Inherit) (Null) (Pipe) (MergeStdout))

(defsum ExitStatus (Exited [(code i64)]) (Signaled [(signal i64)]))

(derive Eq ExitStatus)

(defsum SubprocessError
  (InvalidCommand)
  (OutOfMemory)
  (PipeFailed [(code i64)])
  (SpawnFailed [(code i64)])
  (WaitFailed [(code i64)])
  (SignalFailed [(code i64)])
  (Timeout)
  (StillRunning)
  (AlreadyClosed))

(derive Eq SubprocessError)

;;; `{}` is a message for a person; an errno reads as the operating system describes it.
(impl Display SubprocessError
  (display-fmt [(e SubprocessError) (f (ptr Formatter))] (-> i64)
    (let [w (writer f)]
      (match e
        (InvalidCommand [] (io/print-str w "invalid command"))
        (OutOfMemory [] (io/print-str w "out of memory"))
        (PipeFailed [code] (do (io/print-str w "creating a pipe failed: ") (io/write-os-error w code)))
        (SpawnFailed [code] (do (io/print-str w "starting the process failed: ") (io/write-os-error w code)))
        (WaitFailed [code] (do (io/print-str w "waiting for the process failed: ") (io/write-os-error w code)))
        (SignalFailed [code] (do (io/print-str w "signalling the process failed: ") (io/write-os-error w code)))
        (Timeout [] (io/print-str w "the process timed out"))
        (StillRunning [] (io/print-str w "the process is still running"))
        (AlreadyClosed [] (io/print-str w "the process handle is already closed"))))
    0))

;;; Caller-owned child state. Descriptors less than zero are absent or already closed.
(defstruct Child
  [(pid i32)
   (stdin-fd i32)
   (stdout-fd i32)
   (stderr-fd i32)
   (waited bool)
   (closed bool)
   (process-group bool)
   (status-kind i32)
   (status-code i64)])

;;; `cwd` is a borrowed NUL-terminated path valid through spawn-with-options.
(defstruct SpawnOptions [(cwd (ptr i8)) (new-process-group bool)])

(impl SpawnOptions
  (new [] (-> SpawnOptions)
    (let [options (primitive/alloc-stack SpawnOptions)]
      (store! (field options cwd) (primitive/cast (ptr i8) 0))
      (store! (field options new-process-group) false)
      (load options))))

(defn inherit-stdio [] (-> Stdio)
  (Inherit))

(defn null-stdio [] (-> Stdio)
  (Null))

(defn pipe-stdio [] (-> Stdio)
  (Pipe))

(defn merge-stderr [] (-> Stdio)
  (MergeStdout))

(defn stdio-piped? [(policy Stdio)] (-> bool)
  (match policy
    (Inherit [] false)
    (Null [] false)
    (Pipe [] true)
    (MergeStdout [] false)))

(defn merges? [(policy Stdio)] (-> bool)
  (match policy
    (Inherit [] false)
    (Null [] false)
    (Pipe [] false)
    (MergeStdout [] true)))

(defn close-if-open [(fd i32)] (-> i64)
  (if (>= fd 0) (primitive/cast i64 (os/close fd)) 0))

(defn make-pipe [(fds (ptr (array i32 2)))] (-> i64)
  (os/pipe-cloexec (primitive/cast (ptr i32) fds)))

(defn init-pair [(fds (ptr (array i32 2)))] (-> i64)
  (store! (primitive/index fds 0) -1)
  (store! (primitive/index fds 1) -1)
  0)

(defn alloc-c-string [(a (dyn alloc/Allocator)) (s (slice u8))] (-> (Result (ptr i8)
                                                                            SubprocessError))
  (let [len (len s)]
    (if (os/slice-has-byte? s (: 0 u8))
        (Err (InvalidCommand))
        (match (alloc/alloc [i8] a (+ len 1))
          (None [] (Err (OutOfMemory)))
          (Some [memory]
                (let [p (data memory)
                      (mut i) 0]
                  (loop (if (>= (load i) len)
                            (break)
                            (do
                              (store! (primitive/index p (load i))
                                      (primitive/cast i8 (get s (load i))))
                              (store! i (+ (load i) 1)))))
                  (store! (primitive/index p len) (: 0 i8))
                  (Ok p)))))))

(defn free-argv [(a (dyn alloc/Allocator))
                 (argv (ptr (ptr i8)))
                 (program (slice u8))
                 (args (slice (slice u8)))
                 (built i64)] (-> i64)
  (if (> built 0)
      (alloc/free [i8] a (slice::new (load argv) (+ (len program) 1)))
      0)
  (let [(mut i) 1]
    (loop (if (>= (load i) built)
              (break)
              (do
                (alloc/free [i8]
                            a
                            (slice::new (load (primitive/index argv (load i)))
                                        (+ (len (get args
                                                     (- (load i) 1)))
                                           1)))
                (store! i (+ (load i) 1))))))
  (alloc/free [(ptr i8)] a (slice::new argv (+ (len args) 2)))
  0)

(defn build-argv-items [(a (dyn alloc/Allocator))
                        (argv (ptr (ptr i8)))
                        (args (slice (slice u8)))
                        (index i64)
                        (built (ptr i64))] (-> (Result i64 SubprocessError))
  (if (>= index (len args))
      (do
        (store! (primitive/index argv (+ index 1)) (primitive/cast (ptr i8) 0))
        (Ok 0))
      (match (alloc-c-string a (get args index))
        (Err [e] (Err e))
        (Ok [arg]
            (do
              (store! (primitive/index argv (+ index 1)) arg)
              (store! built (+ (load built) 1))
              (build-argv-items a argv args (+ index 1) built))))))

(defn build-argv [(a (dyn alloc/Allocator))
                  (program (slice u8))
                  (args (slice (slice u8)))
                  (built (ptr i64))] (-> (Result (ptr (ptr i8)) SubprocessError))
  (let [count (+ (len args) 2)]
    (match (alloc/alloc [(ptr i8)] a count)
      (None [] (Err (OutOfMemory)))
      (Some [memory]
            (let [argv (data memory)]
              (store! built 0)
              (match (alloc-c-string a program)
                (Err [e]
                     (do
                       (alloc/free [(ptr i8)] a memory)
                       (Err e)))
                (Ok [p]
                    (do
                      (store! argv p)
                      (store! built 1)
                      (match (build-argv-items a argv args 0 built)
                        (Ok [_] (Ok argv))
                        (Err [e]
                             (do
                               (free-argv a argv program args (load built))
                               (Err e))))))))))))

;; ---- starting the child ------------------------------------------------------
;;
;; A child is started with `posix_spawnp`, never `fork`: in a process with threads
;; a forked child shares locks held by threads it does not have (see `os/spawn`).
;; What the forked child used to do before `exec` is said as file actions and
;; attributes, and `posix_spawnp` reports a failure to start, exec included, as its
;; result.

(extern posix_spawn_file_actions_init :cc c [(ptr i8)] (-> i32))

(extern posix_spawn_file_actions_destroy :cc c [(ptr i8)] (-> i32))

(extern posix_spawn_file_actions_adddup2 :cc c [(ptr i8) i32 i32] (-> i32))

(extern posix_spawn_file_actions_addopen :cc c [(ptr i8) i32 (ptr i8) i32 i32] (-> i32))

(extern posix_spawn_file_actions_addchdir_np :cc c [(ptr i8) (ptr i8)] (-> i32))

(extern posix_spawnattr_init :cc c [(ptr i8)] (-> i32))

(extern posix_spawnattr_destroy :cc c [(ptr i8)] (-> i32))

(extern posix_spawnattr_setflags :cc c [(ptr i8) i16] (-> i32))

(extern posix_spawnattr_setpgroup :cc c [(ptr i8) i32] (-> i32))

;;; Room for a `posix_spawn_file_actions_t`, a `posix_spawnattr_t` or a `sigset_t`,
;;; whose sizes the C library chooses: a pointer, 4 bytes for the set, on Darwin;
;;; 80, 336 and 128 bytes in glibc.
(defstruct SpawnStorage [(words (array u64 64))])

(extern posix_spawnattr_setsigmask :cc c [(ptr i8) (ptr i8)] (-> i32))

(extern sigemptyset :cc c [(ptr i8)] (-> i32))

;;; POSIX_SPAWN_SETPGROUP and POSIX_SPAWN_SETSIGMASK, the same on Linux and Darwin.
(const SPAWN-SETPGROUP 2)

(const SPAWN-SETSIGMASK 8)

;; A child gets its standard streams and nothing else, as Python's and Java's do:
;; however many descriptors this process has open, and whichever thread opened
;; them, close-on-exec or not yet. Darwin says so with POSIX_SPAWN_CLOEXEC_DEFAULT
;; (spawn-flags), Linux with a closefrom(3) file action (spawn-close-the-rest!).
;; It starts with no signals blocked, as Rust's and Go's do, whatever the
;; spawning thread blocks.

;;; The attribute flags every child gets: an empty signal mask (spawn-describe!
;;; sets it) and, on Darwin, POSIX_SPAWN_CLOEXEC_DEFAULT.
(defn spawn-flags [] (-> i64)
  (os/os-pick SPAWN-SETSIGMASK
              (primitive/ior SPAWN-SETSIGMASK 16384)
              SPAWN-SETSIGMASK))

;;; Close every descriptor from 3 up in the child, after the file actions before
;;; it: Linux's `posix_spawn_file_actions_addclosefrom_np` (glibc 2.34). A C
;;; library without it (an older glibc, musl) closes only what is close-on-exec,
;;; which every descriptor this library opens is (`os/pipe-cloexec`, `coil.fs`,
;;; `coil.socket`); a descriptor other code opened without the flag then reaches
;;; the child too. On Darwin, spawn-flags already closes the rest.
(defn spawn-close-the-rest! [(actions (ptr i8))] (-> i32)
  (os/os-pick (let [closefrom (os/dlsym-cached (primitive/alloc-static (ptr i8))
                                               c"posix_spawn_file_actions_addclosefrom_np"
                                               (primitive/cast (ptr i8) 0))]
                (if (= (primitive/cast i64 closefrom) 0)
                    (: 0 i32)
                    (primitive/call-ptr (primitive/cast (fnptr c [(ptr i8) i32] i32) closefrom)
                                        actions
                                        (: 3 i32))))
              (: 0 i32)
              (: 0 i32)))

;;; Keep descriptor `fd` open in the child as it is in this process, close-on-exec
;;; or not. Darwin names it with addinherit_np, as spawn-flags closes whatever no
;;; file action names; glibc clears close-on-exec on a dup2 onto itself. A
;;; descriptor that is not open here is left closed, as it was.
(defn spawn-inherit! [(actions (ptr i8)) (fd i32)] (-> i32)
  (if (< (os/fcntl fd 1) 0)  ; F_GETFD
      (: 0 i32)
      (os/os-pick (posix_spawn_file_actions_adddup2 actions fd fd)
                  (primitive/call-ptr (primitive/cast (fnptr c [(ptr i8) i32] i32)
                                                      (os/dlsym-cached (primitive/alloc-static (ptr i8))
                                                                       c"posix_spawn_file_actions_addinherit_np"
                                                                       (primitive/cast (ptr i8) -2)))
                                      actions
                                      fd)
                  (: 0 i32))))

;;; The file action that gives the child `target` under `policy`, or an errno.
(defn spawn-redirect! [(actions (ptr i8))
                       (policy Stdio)
                       (pair (ptr (array i32 2)))
                       (target i32)
                       (input bool)] (-> i32)
  (match policy
    (Inherit [] (spawn-inherit! actions target))
    (MergeStdout []
                 (if (= target 2)
                     (posix_spawn_file_actions_adddup2 actions 1 2)
                     (: 22 i32)))  ; EINVAL
    (Pipe []
          (let [source (load (primitive/index pair (if input 0 1)))]
            ; a dup2 onto itself would leave the end close-on-exec
            (if (= source target)
                (spawn-inherit! actions target)
                (posix_spawn_file_actions_adddup2 actions source target))))
    (Null []
          (posix_spawn_file_actions_addopen actions
                                            target
                                            c"/dev/null"
                                            (if input (: 0 i32) (: 1 i32))  ; O_RDONLY, O_WRONLY
                                            (: 0 i32)))))

;;; The first nonzero of two results.
(defn first-error [(x i32) (y i32)] (-> i32)
  (if (!= x 0) x y))

;;; Describe the child in `actions` and `attr`; zero, or the errno of the first
;;; step that failed. `signals` is room for the child's signal mask.
(defn spawn-describe! [(actions (ptr i8))
                       (attr (ptr i8))
                       (signals (ptr i8))
                       (stdin-policy Stdio)
                       (stdout-policy Stdio)
                       (stderr-policy Stdio)
                       (stdin-pipe (ptr (array i32 2)))
                       (stdout-pipe (ptr (array i32 2)))
                       (stderr-pipe (ptr (array i32 2)))
                       (options SpawnOptions)] (-> i32)
  (let [cwd (.cwd options)
        chdir (if (= (primitive/cast i64 cwd) 0)
                  (: 0 i32)
                  (posix_spawn_file_actions_addchdir_np actions cwd))
        group (.new-process-group options)
        flags (primitive/iadd (spawn-flags) (if group SPAWN-SETPGROUP 0))]
    (first-error chdir
                 (first-error (spawn-redirect! actions stdin-policy stdin-pipe 0 true)
                              (first-error (spawn-redirect! actions stdout-policy stdout-pipe 1 false)
                                           (first-error (spawn-redirect! actions stderr-policy stderr-pipe 2 false)
                                                        (first-error (spawn-close-the-rest! actions)
                                                                     (first-error (posix_spawnattr_setflags attr
                                                                                                            (primitive/cast i16 flags))
                                                                                  (first-error (sigemptyset signals)
                                                                                               (first-error (posix_spawnattr_setsigmask attr
                                                                                                                                        signals)
                                                                                                            (if group
                                                                                                                (posix_spawnattr_setpgroup attr (: 0 i32))
                                                                                                                (: 0 i32))))))))))))

(defn waitpid-retry [(pid i32) (status (ptr i32)) (flags i32)] (-> i32)
  (let [rc (os/waitpid pid status flags)]
    (if (and (< rc 0) (= (os/errno) 4)) (waitpid-retry pid status flags) rc)))

(defn close-pair [(pair (ptr (array i32 2)))] (-> i64)
  (close-if-open (load (primitive/index pair 0)))
  (close-if-open (load (primitive/index pair 1)))
  0)

(defn init-child [(child (ptr Child))
                  (pid i32)
                  (stdin-fd i32)
                  (stdout-fd i32)
                  (stderr-fd i32)
                  (process-group bool)] (-> i64)
  (store! (field child pid) pid)
  (store! (field child stdin-fd) stdin-fd)
  (store! (field child stdout-fd) stdout-fd)
  (store! (field child stderr-fd) stderr-fd)
  (store! (field child waited) false)
  (store! (field child closed) false)
  (store! (field child process-group) process-group)
  (store! (field child status-kind) 0)
  (store! (field child status-code) 0)
  0)

(impl Child
  ;;; Spawn `program` with exact argument bytes and no shell interpretation. `args` excludes
  ;;; argv[0], which is set to `program`. The executable is located with PATH like Python's
  ;;; subprocess default. Inputs are borrowed only until this call returns.
  ;;;
  ;;; The child gets the current environment, its three standard streams as the
  ;;; policies say and no other descriptor of this process, and starts with no
  ;;; signals blocked. `MergeStdout` for stdin or stdout is `InvalidCommand`; a
  ;;; program that cannot be started, missing or not executable, is
  ;;; `SpawnFailed` with the errno.
  (spawn-with-options [(a (dyn alloc/Allocator))
                       (child (ptr Child))
                       (program (slice u8))
                       (args (slice (slice u8)))
                       (stdin-policy Stdio)
                       (stdout-policy Stdio)
                       (stderr-policy Stdio)
                       (options SpawnOptions)] (-> (Result (ptr Child)
                                                           SubprocessError))
    (if (or (= (len program) 0)
            (or (merges? stdin-policy) (merges? stdout-policy)))
        (Err (InvalidCommand))  ; only stderr can merge into stdout
        (let [stdin-pipe (primitive/alloc-stack (array i32 2))
              stdout-pipe (primitive/alloc-stack (array i32 2))
              stderr-pipe (primitive/alloc-stack (array i32 2))
              built (primitive/alloc-stack i64)]
          (init-pair stdin-pipe)
          (init-pair stdout-pipe)
          (init-pair stderr-pipe)
          (block :done
                 (let [error
                         (if (stdio-piped? stdin-policy) (make-pipe stdin-pipe) 0)]
                   (if (!= error 0)
                       (return-from :done (Err (PipeFailed error)))
                       0))
                 (let [error
                         (if (stdio-piped? stdout-policy)
                             (make-pipe stdout-pipe)
                             0)]
                   (if (!= error 0)
                       (do
                         (close-pair stdin-pipe)
                         (return-from :done (Err (PipeFailed error))))
                       0))
                 (let [error
                         (if (stdio-piped? stderr-policy)
                             (make-pipe stderr-pipe)
                             0)]
                   (if (!= error 0)
                       (do
                         (close-pair stdin-pipe)
                         (close-pair stdout-pipe)
                         (return-from :done (Err (PipeFailed error))))
                       0))
                 (match (build-argv a program args built)
                   (Err [error]
                        (do
                          (close-pair stdin-pipe)
                          (close-pair stdout-pipe)
                          (close-pair stderr-pipe)
                          (return-from :done (Err error))))
                   (Ok [argv]
                       (let [actions
                               (primitive/cast (ptr i8)
                                               (primitive/alloc-stack SpawnStorage))
                             attr
                               (primitive/cast (ptr i8)
                                               (primitive/alloc-stack SpawnStorage))
                             signals
                               (primitive/cast (ptr i8)
                                               (primitive/alloc-stack SpawnStorage))
                             pid (primitive/alloc-stack i32)
                             _actions (posix_spawn_file_actions_init actions)
                             _attr (posix_spawnattr_init attr)
                             described
                               (spawn-describe! actions
                                                attr
                                                signals
                                                stdin-policy
                                                stdout-policy
                                                stderr-policy
                                                stdin-pipe
                                                stdout-pipe
                                                stderr-pipe
                                                options)
                             error
                               (if (!= described 0)
                                   described
                                   (os/posix_spawnp pid
                                                    (load argv)
                                                    actions
                                                    attr
                                                    argv
                                                    (os/environment)))]
                         (posix_spawn_file_actions_destroy actions)
                         (posix_spawnattr_destroy attr)
                         (free-argv a argv program args (load built))
                         ; the child's ends: it has its own copies now, or none
                         (close-if-open (load (primitive/index stdin-pipe 0)))
                         (close-if-open (load (primitive/index stdout-pipe 1)))
                         (close-if-open (load (primitive/index stderr-pipe 1)))
                         (if (!= error 0)
                             (do
                               (close-if-open (load (primitive/index stdin-pipe 1)))
                               (close-if-open (load (primitive/index stdout-pipe 0)))
                               (close-if-open (load (primitive/index stderr-pipe 0)))
                               (Err (SpawnFailed (primitive/cast i64 error))))
                             (do
                               (init-child child
                                           (load pid)
                                           (load (primitive/index stdin-pipe 1))
                                           (load (primitive/index stdout-pipe 0))
                                           (load (primitive/index stderr-pipe 0))
                                           (.new-process-group options))
                               (Ok child))))))))))

  ;;; Backward-compatible spawn with inherited cwd and no process group.
  (spawn [(a (dyn alloc/Allocator))
          (child (ptr Child))
          (program (slice u8))
          (args (slice (slice u8)))
          (stdin-policy Stdio)
          (stdout-policy Stdio)
          (stderr-policy Stdio)] (-> (Result (ptr Child) SubprocessError))
    (Child::spawn-with-options a
                               child
                               program
                               args
                               stdin-policy
                               stdout-policy
                               stderr-policy
                               (SpawnOptions::new)))

  (id [(child (ptr Child))] (-> i64)
    (primitive/cast i64 (load (field child pid))))

  (stdin-writer [(writer (ptr io/Writer)) (child (ptr Child))] (-> (Option (ptr io/Writer)))
    (if (>= (load (field child stdin-fd)) 0)
        (Some (io/Writer::from-fd writer
                                  (primitive/cast i64 (load (field child stdin-fd)))))
        (None)))

  (stdout-reader [(reader (ptr io/Reader)) (child (ptr Child))] (-> (Option (ptr io/Reader)))
    (if (>= (load (field child stdout-fd)) 0)
        (Some (io/Reader::from-fd reader
                                  (primitive/cast i64 (load (field child stdout-fd)))))
        (None)))

  (stderr-reader [(reader (ptr io/Reader)) (child (ptr Child))] (-> (Option (ptr io/Reader)))
    (if (>= (load (field child stderr-fd)) 0)
        (Some (io/Reader::from-fd reader
                                  (primitive/cast i64 (load (field child stderr-fd)))))
        (None)))

  ;;; Close the parent write end, delivering EOF to a child reading stdin. Idempotent.
  (close-stdin [(child (ptr Child))] (-> i64)
    (close-if-open (load (field child stdin-fd)))
    (store! (field child stdin-fd) -1)
    0)

  ;;; Nonblocking status probe. `None` means the child is still running.
  (try-wait [(child (ptr Child))] (-> (Result (Option ExitStatus)
                                              SubprocessError))
    (if (load (field child waited))
        (Ok (Some (cached-status child)))
        (let [raw (primitive/alloc-stack i32)
              rc (waitpid-retry (load (field child pid)) raw 1)]
          (if (= rc 0)
              (Ok (None))
              (if (< rc 0)
                  (let [error (os/errno)]
                    (if (= error 4)
                        (try-wait child)
                        (Err (WaitFailed error))))
                  (Ok (Some (cache-status child (status-decode (load raw))))))))))

  ;;; Block until the child is reaped. Repeated waits return the cached status.
  (wait [(child (ptr Child))] (-> (Result ExitStatus SubprocessError))
    (if (load (field child waited))
        (Ok (cached-status child))
        (let [raw (primitive/alloc-stack i32)
              rc (waitpid-retry (load (field child pid)) raw 0)]
          (if (< rc 0)
              (let [error (os/errno)]
                (if (= error 4) (wait child) (Err (WaitFailed error))))
              (Ok (cache-status child (status-decode (load raw))))))))

  ;;; Wait until a monotonic deadline. Timeout leaves the child running and valid.
  (wait-until [(child (ptr Child)) (deadline time/Instant)] (-> (Result ExitStatus
                                                                        SubprocessError))
    (match (wait-for-exit child (Some deadline) (primitive/cast (ptr cancellation/Cancellation) 0))
      (Err [e] (Err e))
      (Ok [outcome]
          (match outcome
            (Reaped [status] (Ok status))
            (WaitTimedOut [] (Err (Timeout)))
            (WaitCancelled [] (unreachable "a wait with no cancellation token was cancelled"))))))

  (signal [(child (ptr Child)) (signal i32)] (-> (Result i64
                                                         SubprocessError))
    (if (load (field child waited))
        (Err (AlreadyClosed))
        (let [target
                (if (load (field child process-group))
                    (primitive/isub 0 (load (field child pid)))
                    (load (field child pid)))]
          (if (= (os/kill target signal) 0)
              (Ok 0)
              (Err (SignalFailed (os/errno)))))))

  ;;; Request graceful termination (SIGTERM). The caller must still wait.
  (terminate [(child (ptr Child))] (-> (Result i64 SubprocessError))
    (signal child 15))

  ;;; Force termination (SIGKILL). The caller must still wait.
  (kill [(child (ptr Child))] (-> (Result i64 SubprocessError))
    (signal child 9))

  ;;; Force termination and reap, providing an explicit leak-free finalization path.
  (kill-and-wait [(child (ptr Child))] (-> (Result ExitStatus
                                                   SubprocessError))
    (match (kill child) (Err [e] (Err e)) (Ok [_] (wait child))))

  ;;; Close parent-owned streams. A live child is not silently detached: this returns
  ;;; `StillRunning`; call wait or kill-and-wait before final close. Idempotent once reaped.
  (close [(child (ptr Child))] (-> (Result i64 SubprocessError))
    (close-stdin child)
    (close-if-open (load (field child stdout-fd)))
    (close-if-open (load (field child stderr-fd)))
    (store! (field child stdout-fd) -1)
    (store! (field child stderr-fd) -1)
    (if (load (field child waited))
        (do (store! (field child closed) true) (Ok 0))
        (Err (StillRunning)))))

(defn status-decode [(raw i32)] (-> ExitStatus)
  (let [value (primitive/cast i64 raw)
        signal (& value 127)]
    (if (= signal 0) (Exited (& (>> value 8) 255)) (Signaled signal))))

(defn cache-status [(child (ptr Child)) (status ExitStatus)] (-> ExitStatus)
  (match status
    (Exited [code]
            (do
              (store! (field child status-kind) 1)
              (store! (field child status-code) code)))
    (Signaled [signal]
              (do
                (store! (field child status-kind) 2)
                (store! (field child status-code) signal))))
  (store! (field child waited) true)
  status)

(defn cached-status [(child (ptr Child))] (-> ExitStatus)
  (if (= (load (field child status-kind)) 1)
      (Exited (load (field child status-code)))
      (Signaled (load (field child status-code)))))

;; ---- waiting for a child to exit ------------------------------------------------
;;
;; A wait with a deadline or a cancellation token sleeps until the system says the
;; child has exited, and does not ask on a timer: Linux hands out a descriptor for
;; the process that turns readable when it exits (`pidfd_open`, Linux 5.3), and a
;; Darwin kqueue holding the process's exit event is readable once the event is
;; pending. Where neither exists (an older kernel, a sandbox that denies the call),
;; the wait asks on a backoff from 1 to 50 ms, as Python's `wait(timeout)` does.

;;; hygiene: the platform declarations enter this module's namespace by name.
(defn subprocess-public-name [(name Code)] (-> Code)
  (primitive/syntax->datum name))

;;; `exit-watch-raw`: a descriptor readable once child `pid` has exited, or -1
;;; with errno set; ESRCH means it has exited already. The descriptor is the
;;; caller's to close.
(defn gen-exit-watch [] (-> Code)
  (os/os-pick
    `(do
       (extern ~(subprocess-public-name `syscall) :cc c [i64 ...] (-> i64))
       (defn ~(subprocess-public-name `exit-watch-raw) [(pid i32)] (-> i32)
         ; pidfd_open(pid, 0), close-on-exec by definition; 434 on every architecture
         (primitive/cast i32 (~(subprocess-public-name `syscall) 434 (primitive/cast i64 pid) 0))))
    `(do
       (extern ~(subprocess-public-name `kqueue) :cc c [] (-> i32))
       (extern ~(subprocess-public-name `kevent) :cc c [i32 (ptr i8) i32 (ptr i8) i32 (ptr i8)] (-> i32))
       (defn ~(subprocess-public-name `exit-watch-raw) [(pid i32)] (-> i32)
         (let [queue (~(subprocess-public-name `kqueue))]
           (if (< queue 0)
               queue
               (let [event (primitive/alloc-stack (array u8 32))
                     e (primitive/cast (ptr i8) event)]
                 ; struct kevent: ident, filter EVFILT_PROC, flags EV_ADD, fflags NOTE_EXIT
                 (store! (primitive/cast (ptr u64) e) (primitive/cast u64 pid))
                 (store! (primitive/cast (ptr i16) (primitive/index e 8)) (: -5 i16))
                 (store! (primitive/cast (ptr u16) (primitive/index e 10)) (: 1 u16))
                 (store! (primitive/cast (ptr u32) (primitive/index e 12)) (: 2147483648 u32))
                 (store! (primitive/cast (ptr i64) (primitive/index e 16)) 0)
                 (store! (primitive/cast (ptr i64) (primitive/index e 24)) 0)
                 (if (< (~(subprocess-public-name `kevent) queue e 1 (primitive/cast (ptr i8) 0) 0 (primitive/cast (ptr i8) 0))
                        0)
                     (let [error (os/errno)]
                       (os/close queue)
                       (os/set-errno! error)
                       (: -1 i32))
                     queue))))))
    `(defn ~(subprocess-public-name `exit-watch-raw) [(pid i32)] (-> i32)
       (os/set-errno! 78)  ; ENOSYS: a wasm module starts no processes
       (: -1 i32))))

(meta (gen-exit-watch))

;;; How a wait for a child's exit ended.
(defsum ExitWait
  (Reaped [(status ExitStatus)])
  (WaitTimedOut)
  (WaitCancelled))

;;; Milliseconds for `poll` until `deadline`, rounded up, and at most `cap` when
;;; `cap` is not negative; -1, forever, for neither.
(defn poll-timeout [(deadline (Option time/Instant)) (cap i64)] (-> (Result i64 SubprocessError))
  (match deadline
    (None [] (Ok cap))
    (Some [limit]
          (match (remaining limit)
            (Err [e] (Err (WaitFailed (code e))))
            (Ok [left]
                (let [ms (if (> (.sec left) 2147483)
                             2147483647
                             (+ (* (.sec left) 1000) (/ (+ (.nsec left) 999999) 1000000)))]
                  (Ok (if (and (>= cap 0) (< cap ms)) cap ms))))))))

;;; Has `deadline` passed?
(defn deadline-passed? [(deadline (Option time/Instant))] (-> (Result bool SubprocessError))
  (match deadline
    (None [] (Ok false))
    (Some [limit]
          (match (remaining limit)
            (Err [e] (Err (WaitFailed (code e))))
            (Ok [left] (Ok (and (= (.sec left) 0) (= (.nsec left) 0))))))))

;;; Wait for `child` to exit, until `deadline` if there is one, and until `token`
;;; is requested if it is not null. An exit beats both: a child found exited is
;;; reaped and reported even past the deadline. A timed-out or cancelled wait
;;; leaves the child running and the handle valid.
(defn wait-for-exit [(child (ptr Child))
                     (deadline (Option time/Instant))
                     (token (ptr cancellation/Cancellation))] (-> (Result ExitWait SubprocessError))
  (let [cancellable (!= (primitive/cast i64 token) 0)]
    (if (and (not cancellable)
             (match deadline (None [] true) (Some [_] false)))
        (match (wait child) (Err [e] (Err e)) (Ok [status] (Ok (Reaped status))))
        (let [raw (exit-watch-raw (load (field child pid)))
              ; ESRCH: exited already, so the first try-wait reaps it
              (mut exit-fd) raw
              (mut backoff) 1
              entries (primitive/alloc-stack (array selectors/PollFd 2))
              outcome
                (block :done
                       (loop (match (try-wait child)
                               (Err [e] (return-from :done (Err e)))
                               (Ok [maybe]
                                   (match maybe
                                     (Some [status] (return-from :done (Ok (Reaped status))))
                                     (None [] 0))))
                             (when (and cancellable (requested? token))
                               (return-from :done (Ok (WaitCancelled))))
                             (match (deadline-passed? deadline)
                               (Err [e] (return-from :done (Err e)))
                               (Ok [passed]
                                   (when passed (return-from :done (Ok (WaitTimedOut))))))
                             (let [watching (>= (load exit-fd) (: 0 i32))
                                   (mut count) 0]
                               (when watching
                                 (store! (field (primitive/index entries 0) fd) (load exit-fd))
                                 (store! (field (primitive/index entries 0) events) (: 1 i16))  ; POLLIN
                                 (store! (field (primitive/index entries 0) revents) (: 0 i16))
                                 (set! count 1))
                               (when cancellable
                                 (store! (field (primitive/index entries (load count)) fd)
                                         (.read-fd token))
                                 (store! (field (primitive/index entries (load count)) events) (: 1 i16))
                                 (store! (field (primitive/index entries (load count)) revents) (: 0 i16))
                                 (set! count (+ (load count) 1)))
                               (match (poll-timeout deadline (if watching -1 (load backoff)))
                                 (Err [e] (return-from :done (Err e)))
                                 (Ok [timeout]
                                     (let [rc (selectors/poll-fds (primitive/cast (ptr selectors/PollFd) entries)
                                                                  (load count)
                                                                  (primitive/cast i32 timeout))]
                                       (cond (< rc 0)
                                               (let [error (os/errno)]
                                                 (when (!= error 4)  ; EINTR: ask again
                                                   (return-from :done (Err (WaitFailed error)))))
                                             (not watching)
                                               (when (< (load backoff) 50)
                                                 (set! backoff (* (load backoff) 2)))
                                             (!= (& (primitive/cast i64 (load (field (primitive/index entries 0) revents)))
                                                    32)  ; POLLNVAL
                                                 0)
                                               (return-from :done (Err (WaitFailed 9)))
                                             (!= (load (field (primitive/index entries 0) revents)) (: 0 i16))
                                               ; it has exited, and the next try-wait reaps it; if
                                               ; Darwin told before the exit is reapable, ask on the
                                               ; backoff from here
                                               (do
                                                 (os/close (load exit-fd))
                                                 (set! exit-fd -1))
                                             :else 0)))))))]
          (when (>= (load exit-fd) (: 0 i32)) (os/close (load exit-fd)))
          outcome))))

;;; Cohesive execution options. Empty `cwd` inherits the parent directory; a null
;;; cancellation pointer disables cancellation. Capture limits are hard memory bounds.
(defstruct RunOptions
  [(program (slice u8))
   (args (slice (slice u8)))
   (cwd (slice u8))
   (stdout-limit i64)
   (stderr-limit i64)
   (deadline (Option time/Instant))
   (cancellation (ptr cancellation/Cancellation))
   (terminate-grace time/Duration)])

;;; Captured byte slices are allocator-owned. Release both with RunResult::free.
(defstruct RunResult
  [(stdout (slice u8))
   (stderr (slice u8))
   (stdout-capacity i64)
   (stderr-capacity i64)
   (status ExitStatus)
   (timed-out bool)
   (cancelled bool)
   (stdout-truncated bool)
   (stderr-truncated bool)])

(defstruct CaptureBuffer
  [(data (ptr i8))
   (length i64)
   (capacity i64)
   (limit i64)
   (truncated bool)])

(impl RunOptions
  (new [(program (slice u8))
        (args (slice (slice u8)))
        (cwd (slice u8))
        (stdout-limit i64)
        (stderr-limit i64)
        (deadline (Option time/Instant))
        (cancel-token (ptr cancellation/Cancellation))
        (terminate-grace time/Duration)] (-> RunOptions)
    (let [options (primitive/alloc-stack RunOptions)]
      (store! (field options program) program)
      (store! (field options args) args)
      (store! (field options cwd) cwd)
      (store! (field options stdout-limit) stdout-limit)
      (store! (field options stderr-limit) stderr-limit)
      (store! (field options deadline) deadline)
      (store! (field options cancellation) cancel-token)
      (store! (field options terminate-grace) terminate-grace)
      (load options))))

(defn capture-init [(a (dyn alloc/Allocator))
                    (capture (ptr CaptureBuffer))
                    (limit i64)] (-> (Result i64
                                             SubprocessError))
  (let [capacity (if (> limit 8192) 8192 (if (> limit 0) limit 0))]
    (store! (field capture limit) limit)
    (if (= capacity 0)
        (do
          (store! (field capture data) (primitive/cast (ptr i8) 0))
          (store! (field capture length) 0)
          (store! (field capture capacity) 0)
          (store! (field capture truncated) false)
          (Ok 0))
        (match (alloc/alloc [i8] a capacity)
          (None [] (Err (OutOfMemory)))
          (Some [memory]
                (do
                  (store! (field capture data) (data memory))
                  (store! (field capture length) 0)
                  (store! (field capture capacity) capacity)
                  (store! (field capture truncated) false)
                  (Ok 0)))))))

(defn capture-free [(a (dyn alloc/Allocator)) (capture (ptr CaptureBuffer))] (-> i64)
  (if (> (load (field capture capacity)) 0)
      (alloc/free [i8]
                  a
                  (slice::new (load (field capture data))
                              (load (field capture capacity))))
      0)
  (store! (field capture capacity) 0)
  0)

(defn capture-grow! [(a (dyn alloc/Allocator))
                     (capture (ptr CaptureBuffer))
                     (required i64)] (-> bool)
  (let [capacity (load (field capture capacity))
        limit (load (field capture limit))]
    (if (or (<= required capacity) (>= capacity limit))
        true
        (let [(mut next) capacity]
          (loop (if (and (< (load next) required) (< (load next) limit))
                    (store! next
                            (if (> (load next) (primitive/idiv limit 2))
                                limit
                                (primitive/imul (load next) 2)))
                    (break)))
          (match (alloc/reallocate [i8]
                                   a
                                   (slice::new (load (field capture data))
                                               capacity)
                                   (load next))
            (None [] false)
            (Some [memory]
                  (do
                    (store! (field capture data) (data memory))
                    (store! (field capture capacity) (load next))
                    true)))))))

(defn capture-append [(a (dyn alloc/Allocator))
                      (capture (ptr CaptureBuffer))
                      (source (ptr i8))
                      (count i64)] (-> bool)
  (if (not (capture-grow! a capture (+ (load (field capture length)) count)))
      false
      (let [available
              (- (load (field capture capacity)) (load (field capture length)))
            copy-count (if (< available count) available count)
            (mut i) 0]
        (loop (if (>= (load i) copy-count)
                  (break)
                  (do
                    (store! (primitive/index (load (field capture data))
                                             (+ (load (field capture length))
                                                (load i)))
                            (load (primitive/index source (load i))))
                    (store! i (+ (load i) 1)))))
        (store! (field capture length)
                (+ (load (field capture length)) copy-count))
        (if (> count copy-count) (store! (field capture truncated) true) 0)
        true)))

(defn capture-read-fd [(a (dyn alloc/Allocator))
                       (capture (ptr CaptureBuffer))
                       (fd i32)] (-> (Result bool SubprocessError))
  (let [buffer (primitive/alloc-stack (array i8 8192))
        n
          (primitive/cast i64
                          (io/read fd
                                   (primitive/cast (ptr i8) buffer)
                                   (primitive/cast isize 8192)))]
    (if (> n 0)
        (if (capture-append a capture (primitive/cast (ptr i8) buffer) n)
            (Ok true)
            (Err (OutOfMemory)))
        (if (= n 0)
            (Ok false)
            (let [error (os/errno)]
              (if (= error 4) (Ok true) (Err (WaitFailed error))))))))

(defn close-output-fd [(child (ptr Child)) (stdout bool)] (-> i64)
  (if stdout
      (do
        (close-if-open (load (field child stdout-fd)))
        (store! (field child stdout-fd) -1))
      (do
        (close-if-open (load (field child stderr-fd)))
        (store! (field child stderr-fd) -1)))
  0)

(defn terminate-and-reap [(child (ptr Child)) (grace time/Duration)] (-> (Result ExitStatus
                                                                                 SubprocessError))
  (match (terminate child)
    (Err [_] 0)
    (Ok [_] 0))
  (match (time/Instant::from-now grace)
    (Err [_] (kill-and-wait child))
    (Ok [deadline]
        (match (wait-until child deadline)
          (Ok [status] (Ok status))
          (Err [_] (kill-and-wait child))))))

(defn finish-run-result [(result (ptr RunResult))
                         (stdout (ptr CaptureBuffer))
                         (stderr (ptr CaptureBuffer))
                         (status ExitStatus)
                         (timed-out bool)
                         (cancelled bool)] (-> (ptr RunResult))
  (store! (field result stdout)
          (slice::new [u8]
                      (primitive/cast (ptr u8) (load (field stdout data)))
                      (load (field stdout length))))
  (store! (field result stderr)
          (slice::new [u8]
                      (primitive/cast (ptr u8) (load (field stderr data)))
                      (load (field stderr length))))
  (store! (field result stdout-capacity) (load (field stdout capacity)))
  (store! (field result stderr-capacity) (load (field stderr capacity)))
  (store! (field result status) status)
  (store! (field result timed-out) timed-out)
  (store! (field result cancelled) cancelled)
  (store! (field result stdout-truncated) (load (field stdout truncated)))
  (store! (field result stderr-truncated) (load (field stderr truncated)))
  result)

;;; Spawn, concurrently drain stdout/stderr, honor deadline/cancellation, terminate the
;;; entire process group, and reap on every post-spawn path.
(defn run [(a (dyn alloc/Allocator))
           (result (ptr RunResult))
           (options RunOptions)] (-> (Result (ptr RunResult) SubprocessError))
  (if (or (< (load (field options stdout-limit)) 0)
          (< (load (field options stderr-limit)) 0))
      (Err (InvalidCommand))
      (let [stdout (primitive/alloc-stack CaptureBuffer)
            stderr (primitive/alloc-stack CaptureBuffer)]
        (match (capture-init a stdout (load (field options stdout-limit)))
          (Err [e] (Err e))
          (Ok [_]
              (match (capture-init a stderr (load (field options stderr-limit)))
                (Err [e] (do (capture-free a stdout) (Err e)))
                (Ok [_]
                    (let [cwd
                            (if (= (len (load (field options cwd))) 0)
                                (primitive/cast (ptr i8) 0)
                                (str/to-cstr a (load (field options cwd))))]
                      (if (and (> (len (load (field options cwd))) 0)
                               (= (primitive/cast i64 cwd) 0))
                          (do
                            (capture-free a stdout)
                            (capture-free a stderr)
                            (Err (OutOfMemory)))
                          (let [child (primitive/alloc-stack Child)
                                spawn-settings
                                  (primitive/alloc-stack SpawnOptions)]
                            (store! (field spawn-settings cwd) cwd)
                            (store! (field spawn-settings new-process-group)
                                    true)
                            (let [spawned
                                    (Child::spawn-with-options a
                                                               child
                                                               (load (field options
                                                                            program))
                                                               (load (field options
                                                                            args))
                                                               (null-stdio)
                                                               (pipe-stdio)
                                                               (pipe-stdio)
                                                               (load spawn-settings))]
                              (if (!= (primitive/cast i64 cwd) 0)
                                  (alloc/free [i8]
                                              a
                                              (slice::new cwd
                                                          (+ (len (load (field options
                                                                               cwd)))
                                                             1)))
                                  0)
                              (match spawned
                                (Err [e]
                                     (do
                                       (capture-free a stdout)
                                       (capture-free a stderr)
                                       (Err e)))
                                (Ok [_]
                                    (block :done
                                             (let [(mut timed-out) false
                                                   (mut cancelled) false
                                                   ; refilled on every wake-up: an
                                                   ; alloc-stack in the loop would
                                                   ; grow the stack with each one
                                                   watches
                                                     (primitive/alloc-stack (array selectors/Watch
                                                                                   3))]
                                               (loop (if (and (< (load (field child
                                                                              stdout-fd))
                                                                 0)
                                                              (< (load (field child
                                                                              stderr-fd))
                                                                 0))
                                                         (break)
                                                         (let [(mut count) 0]
                                                           (when (>= (load (field child
                                                                                  stdout-fd))
                                                                     0)
                                                             (store! (primitive/index watches
                                                                                      (load count))
                                                                     (selectors/watch (load (field child
                                                                                                   stdout-fd))
                                                                                      (selectors/interest-readable)
                                                                                      1))
                                                             (store! count
                                                                     (+ (load count)
                                                                        1)))
                                                           (when (>= (load (field child
                                                                                  stderr-fd))
                                                                     0)
                                                             (store! (primitive/index watches
                                                                                      (load count))
                                                                     (selectors/watch (load (field child
                                                                                                   stderr-fd))
                                                                                      (selectors/interest-readable)
                                                                                      2))
                                                             (store! count
                                                                     (+ (load count)
                                                                        1)))
                                                           (when (!= (primitive/cast i64
                                                                                     (load (field options
                                                                                                  cancellation)))
                                                                     0)
                                                             (store! (primitive/index watches
                                                                                      (load count))
                                                                     (watch (load (field options
                                                                                         cancellation))
                                                                            3))
                                                             (store! count
                                                                     (+ (load count)
                                                                        1)))
                                                           (let [watch-slice
                                                                   (slice::new [selectors/Watch]
                                                                               (primitive/cast (ptr selectors/Watch)
                                                                                               watches)
                                                                               (load count))
                                                                 selected
                                                                   (match (load (field options
                                                                                       deadline))
                                                                     (None []
                                                                           (selectors/wait-many a
                                                                                                watch-slice))
                                                                     (Some [deadline]
                                                                           (selectors/wait-many-until a
                                                                                                      watch-slice
                                                                                                      deadline)))]
                                                             (match selected
                                                               (Err [e]
                                                                    (let [code
                                                                            (match e
                                                                              (selectors/Timeout [] 0)
                                                                              (selectors/InvalidFd [] 9)  ; EBADF
                                                                              (selectors/Syscall [code] code))]
                                                                      (if (= code 0)
                                                                          (do
                                                                            (store! timed-out true)
                                                                            (break))
                                                                          (do
                                                                            (close-output-fd child true)
                                                                            (close-output-fd child false)
                                                                            (terminate-and-reap child
                                                                                                (load (field options
                                                                                                             terminate-grace)))
                                                                            (capture-free a stdout)
                                                                            (capture-free a stderr)
                                                                            (return-from :done
                                                                                           (Err (WaitFailed code)))))))
                                                               (Ok [selection]
                                                                   (let [token (.token selection)]
                                                                     (cond (= token
                                                                              1)
                                                                             (match (capture-read-fd a
                                                                                                     stdout
                                                                                                     (load (field child
                                                                                                                  stdout-fd)))
                                                                               (Err [e]
                                                                                    (do
                                                                                      (terminate-and-reap child
                                                                                                          (load (field options
                                                                                                                       terminate-grace)))
                                                                                      (capture-free a
                                                                                                    stdout)
                                                                                      (capture-free a
                                                                                                    stderr)
                                                                                      (return-from :done
                                                                                                     (Err e))))
                                                                               (Ok [open]
                                                                                   (if open
                                                                                       0
                                                                                       (close-output-fd child
                                                                                                        true))))
                                                                           (= token
                                                                              2)
                                                                             (match (capture-read-fd a
                                                                                                     stderr
                                                                                                     (load (field child
                                                                                                                  stderr-fd)))
                                                                               (Err [e]
                                                                                    (do
                                                                                      (terminate-and-reap child
                                                                                                          (load (field options
                                                                                                                       terminate-grace)))
                                                                                      (capture-free a
                                                                                                    stdout)
                                                                                      (capture-free a
                                                                                                    stderr)
                                                                                      (return-from :done
                                                                                                     (Err e))))
                                                                               (Ok [open]
                                                                                   (if open
                                                                                       0
                                                                                       (close-output-fd child
                                                                                                        false))))
                                                                           :else
                                                                             (do
                                                                               (store! cancelled
                                                                                       true)
                                                                               (break))))))))))
                                               (close-output-fd child true)
                                               (close-output-fd child false)
                                               (unless (or (load timed-out)
                                                           (load cancelled))
                                                 (match (wait-for-exit child
                                                                       (load (field options
                                                                                    deadline))
                                                                       (load (field options
                                                                                    cancellation)))
                                                   (Err [e]
                                                        (do
                                                          (terminate-and-reap child
                                                                              (load (field options
                                                                                           terminate-grace)))
                                                          (capture-free a
                                                                        stdout)
                                                          (capture-free a
                                                                        stderr)
                                                          (return-from :done
                                                                         (Err e))))
                                                   (Ok [outcome]
                                                       (match outcome
                                                         (Reaped [_] 0)
                                                         (WaitTimedOut [] (store! timed-out true))
                                                         (WaitCancelled [] (store! cancelled true))))))
                                               (let [status-result
                                                       (if (or (load timed-out)
                                                               (load cancelled))
                                                           (terminate-and-reap child
                                                                               (load (field options
                                                                                            terminate-grace)))
                                                           (wait child))]
                                                 (match status-result
                                                   (Err [e]
                                                        (do
                                                          (capture-free a
                                                                        stdout)
                                                          (capture-free a
                                                                        stderr)
                                                          (Err e)))
                                                   (Ok [status]
                                                       (do
                                                         (close child)
                                                         (Ok (finish-run-result result
                                                                                stdout
                                                                                stderr
                                                                                status
                                                                                (load timed-out)
                                                                                (load cancelled))))))))))))))))))))))

(impl RunResult
  (free [(a (dyn alloc/Allocator)) (result (ptr RunResult))] (-> i64)
    (if (> (load (field result stdout-capacity)) 0)
        (alloc/free [i8]
                    a
                    (slice::new (primitive/cast (ptr i8)
                                                (data (load (field result
                                                                   stdout))))
                                (load (field result stdout-capacity))))
        0)
    (if (> (load (field result stderr-capacity)) 0)
        (alloc/free [i8]
                    a
                    (slice::new (primitive/cast (ptr i8)
                                                (data (load (field result
                                                                   stderr))))
                                (load (field result stderr-capacity))))
        0)
    (store! (field result stdout-capacity) 0)
    (store! (field result stderr-capacity) 0)
    0))

