;;; Tests that code is rejected at compile time, and with which diagnostic.
;;;
;;;     (import "coil.test.compile" :use [assert-compile-error])
;;;
;;;     (deftest a-string-is-not-a-number
;;;       (assert-compile-error "argument 2 to '+' has type (slice u8)"
;;;         (defn f [] (-> i64) (+ 1 "two"))))
;;;
;;; The forms after the expectation are not part of the test program. They are
;;; compiled while the test runs, by the in-process compiler (`coil.jit`), as a
;;; submission of their own: a test that imports this module links the compiler.
;;; They see what any source file sees — the standard library and, run inside a
;;; project, the project's modules — and nothing of the test file around them, so
;;; they carry their own `import`s.
;;;
;;; Each form keeps the line and column it was written at, under the test file's
;;; name, so a diagnostic's `--> FILE:LINE:COL` names the place in the test file
;;; where the error was found. An expectation can be any part of the diagnostic
;;; text, a location included.
(module coil.test.compile)
(import "coil.primitive" :as primitive)
(import "coil.alloc" :as alloc)
(import "coil.args" :as coil.args)
(import "coil.io" :use [stderr])
(import "coil.fmt" :use [fmt])
(import "coil.jit" :as jit)
(import "coil.str" :as str)

; ---- compile time: the forms as source text ---------------------------------
;;; The source text of FORMS, each preceded by the blank lines and spaces that put it
;;; back at the line and column it was written at. Compiled under the file's name,
;;; this reports the locations the file itself has.
(defn tc-positioned-source [(forms Code)] (-> (slice u8))
  (let [(mut out) (str/StrBuf::new (alloc/malloc-allocator))
        (mut line) 1
        (mut col) 1]
    (for i (range 0 (primitive/code-count forms))
      (let [form (primitive/code-nth forms i)
            text (primitive/code-src form)
            at-line (primitive/code-line form)
            at-col (primitive/code-col form)]
        (when (= (len text) 0)
          (primitive/report form "assert-compile-error: the forms must be written in the source, not generated by a macro"))
        (when (< at-line line)
          (primitive/report form "assert-compile-error: the forms must appear in the order they are written"))
        (while (< line at-line)
          (push! (mut out) (cast u8 10))
          (set! line (+ line 1))
          (set! col 1))
        (while (< col at-col)
          (push! (mut out) (cast u8 32))
          (set! col (+ col 1)))
        (push-str! (mut out) text)
        (for c text
          (if (= c (cast u8 10))
              (do (set! line (+ line 1)) (set! col 1))
              (set! col (+ col 1))))))
    (str out)))

;;; EXPECTED as a vector of string literals: a string alone, or a vector of them.
(defn tc-expectations [(expected Code)] (-> Code)
  (cond (primitive/code-string? expected) `[~expected]
        (and (primitive/code-vector? expected)
             (> (primitive/code-count expected) 0)
             (block :all
               (for i (range 0 (primitive/code-count expected))
                 (unless (primitive/code-string? (primitive/code-nth expected i))
                   (return-from :all false)))
               true))
          expected
        :else
          (do
            (primitive/report expected
                              "assert-compile-error: the expectation is a string, or a nonempty vector of strings, that the diagnostics must contain")
            `[""])))

;;; `(compile-errors FORM…)` — compile FORMs at run time, as their own submission.
;;; `(Some diagnostics)` when they do not compile: every located diagnostic, as text
;;; the caller owns (malloc). `(None)` when they compile.
(defn compile-errors [& (forms Code)] (-> Code)
  (if (= (primitive/code-count forms) 0)
      (primitive/error "compile-errors: give it the forms to compile")
      `(compile-errors-of ~(tc-positioned-source forms)
                          ~(primitive/code-file (primitive/code-nth forms 0)))))

;;; `(assert-compile-error EXPECTED FORM…)` — assert that FORMs do not compile and that
;;; their diagnostics contain EXPECTED: a string, or a vector of strings that must
;;; all appear. On failure, prints what was expected and what the compiler said
;;; (or that the forms compiled), then fails the test like `assert`.
(defn assert-compile-error [(expected Code) & (forms Code)] (-> Code)
  (if (= (primitive/code-count forms) 0)
      (do
        (primitive/report expected "assert-compile-error: give it the forms that must not compile, after the expectation")
        `0)
      (let [first (primitive/code-nth forms 0)]
        `(compile-error-check! ~(tc-positioned-source forms)
                               ~(primitive/code-file first)
                               ~(tc-expectations expected)
                               ~(primitive/code-line first)))))

; ---- run time: compiling and judging ------------------------------------------
;;; The toolchain whose compiler built this program. `coil test` names itself with
;;; `--coil-toolchain`; a test program run by hand uses the `coil` on PATH, as
;;; `jit-session-new` does.
(defn tc-toolchain [] (-> (slice u8))
  (let [named (coil.args/value "--coil-toolchain")]
    (if (> (len named) 0) named "coil")))

(defn tc-copy [(s (slice u8))] (-> (slice u8))
  (match (str/concat (alloc/malloc-allocator) s "")
    (Some [copy] copy)
    (None []
          (do
            (fmt (stderr) "coil.test.compile: out of memory copying a diagnostic\n")
            (alloc/abort)
            ""))))

;;; Compile SOURCE, named NAME in its diagnostics, in a fresh compiler session that
;;; loads the project in the working directory, if there is one. `(Some text)` with
;;; every located diagnostic when it does not compile (the caller owns the text),
;;; `(None)` when it does. Nothing is written to stderr either way.
(defn compile-errors-of [(source (slice u8)) (name (slice u8))] (-> (Option (slice u8)))
  (let [(mut session) (jit/jit-session-new-with-toolchain (alloc/malloc-allocator) (tc-toolchain))]
    (jit/jit-session-set-quiet! (mut session) true)
    (jit/jit-session-set-source-name! (mut session) name)
    ; -2 is "no Coil.toml here": the forms then see only the standard library
    (jit/jit-session-load-project! (mut session))
    (let [status (jit/jit-prepare! (mut session) source)
          result
            (if (= status 0)
                (do (jit/jit-abort-prepared! (mut session)) (: (None) (Option (slice u8))))
                (Some (tc-copy (jit/jit-diagnostic (mut session)))))]
      (jit/jit-session-free! (mut session))
      result)))

;;; The verdict of `assert-compile-error`: the forms in SOURCE must fail to compile
;;; with diagnostics containing each of EXPECTED. FILE and LINE locate the
;;; assertion in a failure report.
(defn compile-error-check! [(source (slice u8))
                            (file (slice u8))
                            (expected (slice (slice u8)))
                            (line i64)] (-> i64)
  (match (compile-errors-of source file)
    (None []
          (do
            (fmt (stderr)
                 "assertion failed: the forms compiled, but a compile error was expected\n  at {}:{}\n"
                 file
                 line)
            (for e expected (fmt (stderr) "  expected a diagnostic containing: {}\n" e))
            (coil.args/test-verdict-failed!)
            0))
    (Some [text]
          (let [(mut missing) 0]
            (for e expected
              (match (find text e)
                (Some [_] 0)
                (None [] (set! missing (+ missing 1)))))
            (when (> missing 0)
              (fmt (stderr) "assertion failed: the compile error is not the one expected\n  at {}:{}\n" file line)
              (for e expected
                (match (find text e)
                  (Some [_] 0)
                  (None [] (fmt (stderr) "  expected a diagnostic containing: {}\n" e))))
              (fmt (stderr) "  the compiler said:\n{}\n" text))
            (alloc/free [u8] (alloc/malloc-allocator) text)
            (when (> missing 0) (coil.args/test-verdict-failed!))
            0))))
