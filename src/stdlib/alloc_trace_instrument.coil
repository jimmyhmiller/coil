(module coil.alloc_trace.instrument)
(import "coil.primitive" :as primitive)
(import "coil.slice" :use *)
(import "coil.str" :use [str-find cstr->str])
(import "coil.alloc_trace" :as allocation-trace)
(extern getenv :cc c [(ptr i8)] (-> (ptr i8)))

;; Whole-program allocation attribution. Use with:
;;
;;   coil build app.coil --use coil.alloc_trace.instrument
;;
;; It wraps allocation-producing calls in a nest-safe site scope. The observer
;; itself lives in coil.alloc_trace and is independent of this transform.

(defn ati-simple [(s (slice u8))] (-> (slice u8))
  (let [n (slice-len [u8] s) (mut i) (- n 1) (mut dot) -1]
    (loop (if (< (load i) 0) (break)
              (do
                (when (= (primitive/cast i64 (slice-get [u8] s (load i))) 46)
                  (store! dot (load i)) (break) 0)
                (store! i (- (load i) 1)))))
    (if (< (load dot) 0) s (subslice [u8] s (+ (load dot) 1) n))))

(defn ati-name [(h Code)] (-> (slice u8))
  (if (primitive/code-sym? h) (ati-simple (primitive/code-str h)) ""))

(defn ati-target? [(name (slice u8))] (-> bool)
  (or (= name "raw-alloc")
      (or (= name "raw-resize")
          (or (= name "create")
              (= name "alloc-slice")))))

(defn ati-type-label [(call Code) (name (slice u8))] (-> (slice u8))
  (if (> (primitive/code-count call) 1)
      (let [candidate (primitive/code-nth call 1) src (primitive/code-src candidate)]
        (if (> (slice-len [u8] src) 0) src name))
      name))

(defn ati-spine-kids! [(spine Code)] (-> Code)
  (if (primitive/code-null? spine) spine
      (do
        (primitive/code-set-car! spine (ati-rewrite (primitive/code-car spine)))
        (ati-spine-kids! (primitive/code-cdr spine)))))

(defn ati-vector-kids! [(v Code) (i i64) (n i64)] (-> Code)
  (if (>= i n) v
      (do (primitive/code-set-nth! v i (ati-rewrite (primitive/code-nth v i)))
          (ati-vector-kids! v (+ i 1) n))))

(defn ati-kids! [(form Code)] (-> Code)
  (if (primitive/code-vector? form)
      (ati-vector-kids! form 0 (primitive/code-count form))
      (ati-spine-kids! (primitive/code-cdr form))))

(defn ati-wrapped? [(form Code)] (-> bool)
  (and (primitive/code-list? form)
       (and (>= (primitive/code-count form) 2)
            (and (primitive/code-eq (primitive/code-car form) `let)
                 (let [binds (primitive/code-nth form 1)]
                   (and (primitive/code-vector? binds)
                        (and (>= (primitive/code-count binds) 2)
                             (let [enter (primitive/code-nth binds 1)]
                               (and (primitive/code-list? enter)
                                    (and (> (primitive/code-count enter) 0)
                                         (primitive/code-eq (primitive/code-car enter)
                                           `allocation-trace/allocation-trace-enter!)))))))))))

(defn ati-rewrite [(form Code)] (-> Code)
  (if (primitive/code-vector? form)
      (ati-vector-kids! form 0 (primitive/code-count form))
  (if (not (primitive/code-list? form)) form
      (if (ati-wrapped? form) form
      (let [n (primitive/code-count form)]
        (if (= n 0) form
            (let [head (primitive/code-car form) name (ati-name head)
                  rewritten (do (ati-kids! form) form)]
              (if (ati-target? name)
                  (let [token (primitive/gensym) result (primitive/gensym)]
                    `(let [~token
                              (allocation-trace/allocation-trace-enter!
                                ~(ati-type-label form name)
                                ~(primitive/code-file form)
                                ~(primitive/code-line form)
                                ~(primitive/code-col form))
                           ~result ~rewritten]
                       (allocation-trace/allocation-trace-leave! ~token)
                       ~result))
                  (if (primitive/code-eq head `defn)
                          (if (primitive/code-eq (primitive/code-nth form 1) `main)
                              (let [result (primitive/gensym)]
                                `(defn ~(primitive/code-nth form 1)
                                   ~(primitive/code-nth form 2)
                                   ~(primitive/code-nth form 3)
                                   (allocation-trace/allocation-trace-init!)
                                   (let [~result (do ~@(primitive/code-rest (primitive/code-rest (primitive/code-rest (primitive/code-rest form)))))]
                                     (allocation-trace/allocation-trace-snapshot! "process-exit")
                                     (allocation-trace/allocation-trace-close!)
                                     ~result)))
                              form)
                          form)))))))))

(defn ati-vector [(v Code) (i i64) (n i64)] (-> Code)
  (if (>= i n) `[] `[~(ati-rewrite (primitive/code-nth v i))
                       ~@(ati-vector v (+ i 1) n)]))

(defn ati-marked? [(m Code) (i i64) (n i64)] (-> bool)
  (if (>= i n) false
      (let [f (primitive/code-nth m i)]
        (if (and (primitive/code-list? f)
                 (and (= (primitive/code-count f) 3)
                      (primitive/code-eq (primitive/code-nth f 0) `const)))
            (if (primitive/code-eq (primitive/code-nth f 1) `coil-allocation-trace-instrumented)
                true (ati-marked? m (+ i 1) n))
            (ati-marked? m (+ i 1) n)))))

(defn ati-selected? [(name Code)] (-> bool)
  (let [raw (getenv c"COIL_ALLOC_TRACE_MODULES")]
    (if (= (primitive/cast i64 raw) 0) true
        (match (str-find (cstr->str raw) (primitive/code-str name))
          (Some [_] true)
          (None [] false)))))

(defn ati-module [(m Code)] (-> Code)
  (let [n (primitive/code-count m) name (primitive/code-nth m 0)]
    (if (or (not (ati-selected? name))
            (or (ati-marked? m 1 n)
            (or (= (primitive/code-str name) "coil.alloc_trace")
                (= (primitive/code-str name) "coil.alloc_trace.instrument"))))
        m
        (let [tail (primitive/code-cdr m)]
          ;; Insert support declarations by editing the module spine itself.
          ;; `code-prepend!` reuses the first pair and allocates one new shell.
          (primitive/code-prepend! tail `(const coil-allocation-trace-instrumented 0))
          (primitive/code-prepend! tail `(import "coil.alloc_trace" :as allocation-trace))
          (ati-user-forms! m 1 (+ n 2))))))

;; Bundled standard-library/compiler support is not attributed to the user's
;; selected source graph by default. This both keeps reports useful and avoids
;; instrumenting the tracer's own implementation transitively.
(defn ati-user-forms! [(m Code) (i i64) (n i64)] (-> Code)
  (if (>= i n) m
      (ati-user-spine! m (primitive/code-cdr m))))

(defn ati-user-spine! [(m Code) (spine Code)] (-> Code)
  (if (primitive/code-null? spine) m
      (let [f (primitive/code-car spine)]
        (do
          (when (primitive/code-from-user? f)
            (primitive/code-set-car! spine (ati-rewrite f)) 0)
          (ati-user-spine! m (primitive/code-cdr spine))))))

(defn ati-modules! [(mods Code) (i i64) (n i64)] (-> Code)
  (ati-module-spine! mods mods))

(defn ati-module-spine! [(mods Code) (spine Code)] (-> Code)
  (if (primitive/code-null? spine) mods
      (do (primitive/code-set-car! spine (ati-module (primitive/code-car spine)))
          (ati-module-spine! mods (primitive/code-cdr spine)))))

(defn allocation-trace-instrument [(mods Code)] (-> Code)
  (do
    (ati-modules! mods 0 (primitive/code-count mods))
    (primitive/code-prepend! mods `do)
    (primitive/code-consume! mods)))

(transform allocation-trace-instrument :phase before-expand)
