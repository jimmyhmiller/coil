(module coil.time)
(import "coil.primitive" :as primitive)
(import "coil.io" :as io)
(import "coil.fmt" :use [fmt Display display-fmt Formatter])
(import "coil.alloc" :as alloc)
(import "coil.os" :as os)
(os/requires-os)  ; it calls the operating system

(export Timespec
        Duration
        Instant
        SystemTime
        TimeError
        InvalidTimeDuration
        TimeOverflow
        Syscall
        wall-now-ms
        monotonic-now-ms
        wall-now
        monotonic-now
        sleep
        sleep-until
        clock_gettime nanosleep now-ms now-timespec wall-clock-id monotonic-clock-id)

; Hosted clocks and duration helpers. Wall and monotonic time are deliberately separate:
; wall time is for timestamps, while monotonic time is for elapsed time and deadlines.
(defstruct Timespec [(sec i64) (nsec i64)])

(defstruct Duration [(sec i64) (nsec i64)])

(defstruct Instant [(sec i64) (nsec i64)])

(defstruct SystemTime [(sec i64) (nsec i64)])

(defsum TimeError
  (InvalidTimeDuration)
  (TimeOverflow)
  (Syscall [(errno i64)]))

(derive Eq TimeError)

;;; `{}` is a message for a person; an errno reads as the operating system describes it.
(impl Display TimeError
  (display-fmt [(e TimeError) (f (ptr Formatter))] (-> i64)
    (let [w (writer f)]
      (match e
        (InvalidTimeDuration [] (io/print-str w "invalid duration"))
        (TimeOverflow [] (io/print-str w "time value out of range"))
        (Syscall [code] (io/write-os-error w code))))
    0))

;;; The time failure as a conventional errno-like code, for lower-level runtimes.
(impl TimeError
  (code [(error TimeError)] (-> i64)
    (match error
      (InvalidTimeDuration [] 22)
      (TimeOverflow [] 75)
      (Syscall [code] code))))

(extern clock_gettime :cc c [i32 (ptr Timespec)] (-> i32))

(extern nanosleep :cc c [(ptr Timespec) (ptr Timespec)] (-> i32))

;;; Clock IDs are compile-target constants, so expand them as literal expressions
;;; instead of injecting stable top-level declarations into the module namespace.
(defn wall-clock-id [] (-> Code)
  `0)

(defn monotonic-clock-id [] (-> Code)
  (os/os-pick `1 `6 `6))

(defn timespec-ms [(ts (ptr Timespec))] (-> i64)
  (+ (* (.sec ts) 1000)
     (/ (.nsec ts) 1000000)))

(defn now-ms [(clock-id i32)] (-> (Result i64 TimeError))
  (let [ts (primitive/alloc-stack Timespec)
        rc (clock_gettime clock-id ts)]
    (if (= rc 0)
        (Ok (timespec-ms ts))
        (Err (Syscall (os/errno))))))

;;; Milliseconds since the system's wall-clock epoch. Suitable for event timestamps, not
;;; elapsed-time calculations because administrators and time synchronization can adjust it.
(defn wall-now-ms [] (-> (Result i64 TimeError))
  (now-ms (wall-clock-id)))

;;; Monotonic milliseconds for elapsed time and deadlines.
(defn monotonic-now-ms [] (-> (Result i64 TimeError))
  (now-ms (monotonic-clock-id)))

(impl Duration
  ;;; A duration of `sec` seconds and `nsec` nanoseconds, both non-negative. Nanoseconds
  ;;; past a second carry into the seconds.
  (new [(sec i64) (nsec i64)] (-> (Result Duration TimeError))
    (if (or (< sec 0) (< nsec 0))
        (Err (InvalidTimeDuration))
        (let [extra (/ nsec 1000000000)
              normalized (% nsec 1000000000)]
          (if (> sec (- 9223372036854775807 extra))
              (Err (TimeOverflow))
              (let [d (primitive/alloc-stack Duration)]
                (set! (.sec d) (+ sec extra))
                (set! (.nsec d) normalized)
                (Ok (load d)))))))

  ;;; Construct a non-negative duration from seconds.
  (seconds [(value i64)] (-> (Result Duration TimeError))
    (Duration::new value 0))

  ;;; Construct a non-negative duration from milliseconds.
  (millis [(value i64)] (-> (Result Duration TimeError))
    (if (< value 0)
        (Err (InvalidTimeDuration))
        (Duration::new (/ value 1000) (* (% value 1000) 1000000))))

  ;;; Construct a non-negative duration from microseconds.
  (micros [(value i64)] (-> (Result Duration TimeError))
    (if (< value 0)
        (Err (InvalidTimeDuration))
        (Duration::new (/ value 1000000) (* (% value 1000000) 1000))))

  ;;; Construct a non-negative duration from nanoseconds.
  (nanos [(value i64)] (-> (Result Duration TimeError))
    (if (< value 0) (Err (InvalidTimeDuration)) (Duration::new 0 value)))

  ;;; Is this a normalized, non-negative duration?
  (valid? [(d Duration)] (-> bool)
    (and (>= (.sec d) 0)
         (and (>= (.nsec d) 0)
              (< (.nsec d) 1000000000)))))

(defn now-timespec [(clock-id i32) (out (ptr Timespec))] (-> (Result i64 TimeError))
  (if (= (clock_gettime clock-id out) 0)
      (Ok 0)
      (Err (Syscall (os/errno)))))

;;; Read the monotonic clock as an instant suitable for deadlines and elapsed time.
(defn monotonic-now [] (-> (Result Instant TimeError))
  (let [ts (primitive/alloc-stack Timespec)]
    (match (now-timespec (monotonic-clock-id) ts)
      (Err [e] (Err e))
      (Ok [_]
          (let [out (primitive/alloc-stack Instant)]
            (set! (.sec out) (.sec ts))
            (set! (.nsec out) (.nsec ts))
            (Ok (load out)))))))

;;; Read the adjustable wall clock as a timestamp.
(defn wall-now [] (-> (Result SystemTime TimeError))
  (let [ts (primitive/alloc-stack Timespec)]
    (match (now-timespec (wall-clock-id) ts)
      (Err [e] (Err e))
      (Ok [_]
          (let [out (primitive/alloc-stack SystemTime)]
            (set! (.sec out) (.sec ts))
            (set! (.nsec out) (.nsec ts))
            (Ok (load out)))))))

(impl Instant
  ;;; The monotonic deadline `duration` from now.
  (from-now [(duration Duration)] (-> (Result Instant TimeError))
    (match (monotonic-now)
      (Err [e] (Err e))
      (Ok [now] (add now duration))))

  ;;; Add a duration to a monotonic instant, returning overflow explicitly.
  (add [(instant Instant) (duration Duration)] (-> (Result Instant TimeError))
    (if (not (valid? duration))
        (Err (InvalidTimeDuration))
        (let [carry (if (>= (+ (.nsec instant) (.nsec duration)) 1000000000) 1 0)
              delta (+ (.sec duration) carry)]
          (if (> (.sec instant) (- 9223372036854775807 delta))
              (Err (TimeOverflow))
              (let [out (primitive/alloc-stack Instant)]
                (set! (.sec out) (+ (.sec instant) delta))
                (set! (.nsec out)
                      (% (+ (.nsec instant) (.nsec duration)) 1000000000))
                (Ok (load out)))))))

  ;;; Remaining duration until this deadline, clamped to zero after expiry.
  (remaining [(deadline Instant)] (-> (Result Duration TimeError))
    (match (monotonic-now)
      (Err [e] (Err e))
      (Ok [now]
          (let [(mut nowp) now]
            (if (or (> (.sec nowp) (.sec deadline))
                    (and (= (.sec nowp) (.sec deadline))
                         (>= (.nsec nowp) (.nsec deadline))))
                (Duration::new 0 0)
                (let [borrow (if (> (.nsec nowp) (.nsec deadline)) 1 0)
                      sec (- (- (.sec deadline) (.sec nowp)) borrow)
                      nsec
                        (if (= borrow 1)
                            (- (+ (.nsec deadline) 1000000000) (.nsec nowp))
                            (- (.nsec deadline) (.nsec nowp)))]
                  (Duration::new sec nsec))))))))

;;; Sleep for a duration. Signals do not shorten the sleep: `EINTR` resumes with libc's
;;; reported remainder.
(defn sleep [(duration Duration)] (-> (Result i64 TimeError))
  (if (not (valid? duration))
      (Err (InvalidTimeDuration))
      (let [request (primitive/alloc-stack Timespec)
            remaining (primitive/alloc-stack Timespec)]
        (set! (.sec request) (.sec duration))
        (set! (.nsec request) (.nsec duration))
        (block :done
                 (loop (if (= (nanosleep request remaining) 0)
                           (return-from :done (Ok 0))
                           (let [error (os/errno)]
                             (if (= error 4)
                                 (do
                                   (store! (field request sec)
                                           (load (field remaining sec)))
                                   (store! (field request nsec)
                                           (load (field remaining nsec)))
                                   0)
                                 (return-from :done (Err (Syscall error)))))))))))

;;; Sleep until an absolute monotonic deadline.
(defn sleep-until [(deadline Instant)] (-> (Result i64 TimeError))
  (match (remaining deadline)
    (Err [e] (Err e))
    (Ok [remaining] (sleep remaining))))
