(module coil.time)
(import "coil.primitive" :as primitive)
(import "coil.alloc" :as alloc)
(import "coil.os" :as os)
; Hosted clocks and duration helpers. Wall and monotonic time are deliberately separate:
; wall time is for timestamps, while monotonic time is for elapsed time and deadlines.

(defstruct Timespec [(sec i64) (nsec i64)])
(defstruct Duration [(sec i64) (nsec i64)])
(defstruct Instant [(sec i64) (nsec i64)])
(defstruct SystemTime [(sec i64) (nsec i64)])
(defsum TimeError
  (InvalidTimeDuration)
  (TimeOverflow)
  (Syscall [(errno i64)]))

;; Convert a time failure to a conventional errno-like code for lower-level runtimes.
(defn time-error-code [(error TimeError)] (-> i64)
  (match error
    (InvalidTimeDuration [] 22)
    (TimeOverflow [] 75)
    (Syscall [code] code)))

(extern clock_gettime :cc c [i32 (ptr Timespec)] (-> i32))
(extern nanosleep :cc c [(ptr Timespec) (ptr Timespec)] (-> i32))

(defn gen-time-platform [] (-> Code)
  (if (primitive/code-eq (primitive/target-os) `linux)
      `(do
         (defn wall-clock-id [] (-> i32)
           0)
         (defn monotonic-clock-id [] (-> i32)
           1))
      `(do
         (defn wall-clock-id [] (-> i32)
           0)
         (defn monotonic-clock-id [] (-> i32)
           6))))
(meta (gen-time-platform))

(defn timespec-ms [(ts (ptr Timespec))] (-> i64)
  (+ (* (load (field ts sec)) 1000)
     (/ (load (field ts nsec)) 1000000)))

(defn clock-ms [(clock-id i32)] (-> (Result i64 TimeError))
  (let [ts (alloc/stack Timespec)
        rc (clock_gettime clock-id ts)]
    (if (= rc 0)
        (Ok (timespec-ms ts))
        (Err (Syscall (os/os-errno))))))

;; Milliseconds since the system's wall-clock epoch. Suitable for event timestamps, not
;; elapsed-time calculations because administrators and time synchronization can adjust it.
(defn wall-now-ms [] (-> (Result i64 TimeError))
  (clock-ms (wall-clock-id)))

;; Monotonic milliseconds for elapsed time and deadlines.
(defn monotonic-now-ms [] (-> (Result i64 TimeError))
  (clock-ms (monotonic-clock-id)))

(defn duration-valid? [(d Duration)] (-> bool)
  (and (>= (load (field d sec)) 0)
       (and (>= (load (field d nsec)) 0)
            (< (load (field d nsec)) 1000000000))))

(defn duration-parts [(sec i64) (nsec i64)] (-> (Result Duration TimeError))
  (if (or (< sec 0) (< nsec 0))
      (Err (InvalidTimeDuration))
      (let [extra (/ nsec 1000000000)
            normalized (% nsec 1000000000)]
        (if (> sec (- 9223372036854775807 extra))
            (Err (TimeOverflow))
            (let [d (alloc/stack Duration)]
              (store! (field d sec) (+ sec extra))
              (store! (field d nsec) normalized)
              (Ok (load d)))))))

;; Construct a non-negative duration from seconds.
(defn duration-seconds [(value i64)] (-> (Result Duration TimeError))
  (duration-parts value 0))

;; Construct a non-negative duration from milliseconds.
(defn duration-millis [(value i64)] (-> (Result Duration TimeError))
  (if (< value 0)
      (Err (InvalidTimeDuration))
      (duration-parts (/ value 1000) (* (% value 1000) 1000000))))

;; Construct a non-negative duration from microseconds.
(defn duration-micros [(value i64)] (-> (Result Duration TimeError))
  (if (< value 0)
      (Err (InvalidTimeDuration))
      (duration-parts (/ value 1000000) (* (% value 1000000) 1000))))

;; Construct a non-negative duration from nanoseconds.
(defn duration-nanos [(value i64)] (-> (Result Duration TimeError))
  (if (< value 0) (Err (InvalidTimeDuration)) (duration-parts 0 value)))

(defn clock-timespec [(clock-id i32) (out (ptr Timespec))] (-> (Result i64 TimeError))
  (if (= (clock_gettime clock-id out) 0)
      (Ok 0)
      (Err (Syscall (os/os-errno)))))

;; Read the monotonic clock as an instant suitable for deadlines and elapsed time.
(defn monotonic-now [] (-> (Result Instant TimeError))
  (let [ts (alloc/stack Timespec)]
    (match (clock-timespec (monotonic-clock-id) ts)
      (Err [e] (Err e))
      (Ok [_]
          (let [out (alloc/stack Instant)]
            (store! (field out sec) (load (field ts sec)))
            (store! (field out nsec) (load (field ts nsec)))
            (Ok (load out)))))))

;; Read the adjustable wall clock as a timestamp.
(defn wall-now [] (-> (Result SystemTime TimeError))
  (let [ts (alloc/stack Timespec)]
    (match (clock-timespec (wall-clock-id) ts)
      (Err [e] (Err e))
      (Ok [_]
          (let [out (alloc/stack SystemTime)]
            (store! (field out sec) (load (field ts sec)))
            (store! (field out nsec) (load (field ts nsec)))
            (Ok (load out)))))))

;; Add a duration to a monotonic instant, returning overflow explicitly.
(defn instant-add [(instant Instant) (duration Duration)] (-> (Result Instant TimeError))
  (if (not (duration-valid? duration))
      (Err (InvalidTimeDuration))
      (let [carry (if (>= (+ (load (field instant nsec)) (load (field duration nsec))) 1000000000) 1 0)
            delta (+ (load (field duration sec)) carry)]
        (if (> (load (field instant sec)) (- 9223372036854775807 delta))
            (Err (TimeOverflow))
            (let [out (alloc/stack Instant)]
              (store! (field out sec) (+ (load (field instant sec)) delta))
              (store! (field out nsec) (% (+ (load (field instant nsec)) (load (field duration nsec))) 1000000000))
              (Ok (load out)))))))

;; Create an absolute monotonic deadline.
(defn deadline-after [(duration Duration)] (-> (Result Instant TimeError))
  (match (monotonic-now)
    (Err [e] (Err e))
    (Ok [now] (instant-add now duration))))

;; Remaining duration until a deadline, clamped to zero after expiry.
(defn deadline-remaining [(deadline Instant)] (-> (Result Duration TimeError))
  (match (monotonic-now)
    (Err [e] (Err e))
    (Ok [now]
        (let [nowp (alloc/stack Instant)]
          (store! nowp now)
          (if (or (> (load (field nowp sec)) (load (field deadline sec)))
                  (and (= (load (field nowp sec)) (load (field deadline sec)))
                       (>= (load (field nowp nsec)) (load (field deadline nsec)))))
              (duration-parts 0 0)
              (let [borrow (if (> (load (field nowp nsec)) (load (field deadline nsec))) 1 0)
                    sec (- (- (load (field deadline sec)) (load (field nowp sec))) borrow)
                    nsec
                      (if (= borrow 1)
                          (- (+ (load (field deadline nsec)) 1000000000) (load (field nowp nsec)))
                          (- (load (field deadline nsec)) (load (field nowp nsec))))]
                (duration-parts sec nsec)))))))

;; Sleep for a duration. Signals do not shorten the sleep: `EINTR` resumes with libc's
;; reported remainder.
(defn sleep [(duration Duration)] (-> (Result i64 TimeError))
  (if (not (duration-valid? duration))
      (Err (InvalidTimeDuration))
      (let [request (alloc/stack Timespec)
            remaining (alloc/stack Timespec)]
        (store! (field request sec) (load (field duration sec)))
        (store! (field request nsec) (load (field duration nsec)))
        (block :done
               (loop (if (= (nanosleep request remaining) 0)
                         (return-from :done (Ok 0))
                         (let [error (os/os-errno)]
                           (if (= error 4)
                               (do
                                 (store! (field request sec) (load (field remaining sec)))
                                 (store! (field request nsec) (load (field remaining nsec)))
                                 0)
                               (return-from :done (Err (Syscall error)))))))))))

;; Sleep until an absolute monotonic deadline.
(defn sleep-until [(deadline Instant)] (-> (Result i64 TimeError))
  (match (deadline-remaining deadline)
    (Err [e] (Err e))
    (Ok [remaining] (sleep remaining))))
