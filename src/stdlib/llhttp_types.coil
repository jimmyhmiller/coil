; Handwritten runtime for the llparse-generated Coil state machine.

(module coil.http.parser.types)
(import "coil.primitive" :as primitive)

(export Parser
        Settings
        STEP_INPUT
        STEP_ERROR
        parser-zero!
        ascii-lower
        fail!
        fail-code!
        field-load
        field-store!
        field-and!
        field-or!
        field-mul-add!
        invoke-external
        invoke-external-span
        message-needs-eof?
        should-keep-alive?)

(const STEP_INPUT -1)

(const STEP_ERROR -2)

(const TY_HTTP_BOTH 0)

(const TY_HTTP_REQUEST 1)

(const TY_HTTP_RESPONSE 2)

(const TY_HTTP_CONNECT 5)

(const TY_HPE_USER 24)

(const F_CONNECTION_KEEP_ALIVE 1)

(const F_CONNECTION_CLOSE 2)

(const F_CONNECTION_UPGRADE 4)

(const F_CHUNKED 8)

(const F_UPGRADE 16)

(const F_CONTENT_LENGTH 32)

(const F_SKIPBODY 64)

(const F_TRANSFER_ENCODING 512)

(const TY_LENIENT_CHUNKED_LENGTH 2)

(const TY_LENIENT_TRANSFER_ENCODING 8)

(const TY_FINISH_SAFE 0)

; The generated parser owns all protocol state. `settings` is erased here to
; break the Parser/Settings declaration cycle and cast back at callback sites.
(defstruct Parser
  [(index i64)
   (span-pos (ptr u8))
   (span-callback i64)
   (error i64)
   (reason (slice u8))
   (error-pos (ptr u8))
   (data (ptr i8))
   (current i64)
   (content-length i64)
   (parser-type i64)
   (method i64)
   (http-major i64)
   (http-minor i64)
   (header-state i64)
   (lenient-flags i64)
   (upgrade i64)
   (finish i64)
   (flags i64)
   (status-code i64)
   (initial-message-completed i64)
   (settings (ptr i8))])

(defstruct Settings
  [(on-message-begin (ptr i8))
   (on-protocol (ptr i8))
   (on-url (ptr i8))
   (on-status (ptr i8))
   (on-method (ptr i8))
   (on-version (ptr i8))
   (on-header-field (ptr i8))
   (on-header-value (ptr i8))
   (on-chunk-extension-name (ptr i8))
   (on-chunk-extension-value (ptr i8))
   (on-headers-complete (ptr i8))
   (on-body (ptr i8))
   (on-message-complete (ptr i8))
   (on-protocol-complete (ptr i8))
   (on-url-complete (ptr i8))
   (on-status-complete (ptr i8))
   (on-method-complete (ptr i8))
   (on-version-complete (ptr i8))
   (on-header-field-complete (ptr i8))
   (on-header-value-complete (ptr i8))
   (on-chunk-extension-name-complete (ptr i8))
   (on-chunk-extension-value-complete (ptr i8))
   (on-chunk-header (ptr i8))
   (on-chunk-complete (ptr i8))
   (on-reset (ptr i8))])

(defn parser-zero! [(s (ptr Parser))] (-> i64)
  (store! s (primitive/zeroed Parser))
  0)

(defn ascii-lower [(c i64)] (-> i64)
  (if (and (>= c (cast i64 65)) (<= c (cast i64 90)))
      (primitive/ior c 32)
      c))

(defn fail! [(s (ptr Parser))
             (code i64)
             (reason (slice u8))
             (pos (ptr u8))
             (resume i64)] (-> i64)
  (store! (field s error) code)
  (store! (field s reason) reason)
  (store! (field s error-pos) pos)
  (store! (field s current) resume)
  code)

; Record an error without replacing a reason supplied by a callback.
(defn fail-code! [(s (ptr Parser)) (code i64) (pos (ptr u8)) (resume i64)] (-> i64)
  (store! (field s error) code)
  (store! (field s error-pos) pos)
  (store! (field s current) resume)
  code)

; Field ids are the property order emitted by llparse's frontend.
(defn field-load [(s (ptr Parser)) (id i64)] (-> i64)
  (case id 0
        (load (field s content-length)) 1
        (load (field s parser-type)) 2
        (load (field s method)) 3
        (load (field s http-major)) 4
        (load (field s http-minor)) 5
        (load (field s header-state)) 6
        (load (field s lenient-flags)) 7
        (load (field s upgrade)) 8
        (load (field s finish)) 9
        (load (field s flags)) 10
        (load (field s status-code)) 11
        (load (field s initial-message-completed)) 12
        (primitive/cast i64 (load (field s settings))) 0))

(defn narrow-field [(id i64) (value i64)] (-> i64)
  (cond (or (and (>= id (cast i64 1)) (<= id (cast i64 5)))
            (or (= id (cast i64 7)) (or (= id (cast i64 8)) (= id (cast i64 11)))))
          (primitive/iand value 255)
        (or (= id (cast i64 6)) (or (= id (cast i64 9)) (= id (cast i64 10)))) (primitive/iand value 65535)
        :else value))

(defn field-store! [(s (ptr Parser)) (id i64) (raw i64)] (-> i64)
  (let [value (narrow-field id raw)]
    (case id 0
          (store! (field s content-length) value) 1
          (store! (field s parser-type) value) 2
          (store! (field s method) value) 3
          (store! (field s http-major) value) 4
          (store! (field s http-minor) value) 5
          (store! (field s header-state) value) 6
          (store! (field s lenient-flags) value) 7
          (store! (field s upgrade) value) 8
          (store! (field s finish) value) 9
          (store! (field s flags) value) 10
          (store! (field s status-code) value) 11
          (store! (field s initial-message-completed) value) 12
          (store! (field s settings) (primitive/cast (ptr i8) value)) 0))
  0)

(defn field-and! [(s (ptr Parser)) (id i64) (value i64)] (-> i64)
  (field-store! s id (primitive/iand (field-load s id) value)))

(defn field-or! [(s (ptr Parser)) (id i64) (value i64)] (-> i64)
  (field-store! s id (primitive/ior (field-load s id) value)))

; Return 1 on overflow/range failure, matching llparse's MulAdd code node.
(defn field-mul-add! [(s (ptr Parser))
                      (id i64)
                      (base i64)
                      (max i64)
                      (signed bool)
                      (addend i64)] (-> i64)
  (let [old (field-load s id)]
    (if signed
        (if (or (> old (primitive/idiv 0x7fffffffffffffff base))
                (< old (primitive/idiv -0x8000000000000000 base)))
            1
            (let [multiplied (primitive/imul old base)]
              (if (or (and (>= addend (cast i64 0))
                           (> multiplied (primitive/isub 0x7fffffffffffffff addend)))
                      (and (< addend (cast i64 0))
                           (< multiplied (primitive/isub -0x8000000000000000 addend))))
                  1
                  (let [result (primitive/iadd multiplied addend)]
                    (if (and (>= max (cast i64 0)) (> result max))
                        1
                        (do (field-store! s id result) 0))))))
        ; llparse properties are unsigned. Preserve all 64 content-length bits;
        ; narrower properties use their declared storage width.
        (let [limit (case id 10 65535 -1)
              old-u (primitive/cast u64 old)
              limit-u (primitive/cast u64 limit)
              base-u (primitive/cast u64 base)
              add-u (primitive/cast u64 addend)]
          (if (> old-u (primitive/udiv limit-u base-u))
              1
              (let [multiplied (primitive/imul old-u base-u)]
                (if (> multiplied (primitive/isub limit-u add-u))
                    1
                    (let [result (primitive/iadd multiplied add-u)]
                      (if (and (>= max (cast i64 0))
                               (> result (primitive/cast u64 max)))
                          1
                          (do (field-store! s id (primitive/cast i64 result)) 0))))))))))

(defn settings-of [(s (ptr Parser))] (-> (ptr Settings))
  (primitive/cast (ptr Settings) (load (field s settings))))

(defn call-simple [(s (ptr Parser)) (raw (ptr i8))] (-> i64)
  (if (= (primitive/cast i64 raw) (cast i64 0))
      0
      (primitive/call-ptr (primitive/cast (fnptr c [(ptr Parser)] i64) raw) s)))

(defn call-span [(s (ptr Parser))
                 (raw (ptr i8))
                 (start (ptr u8))
                 (endp (ptr u8))] (-> i64)
  (if (= (primitive/cast i64 raw) (cast i64 0))
      0
      (let [fp (primitive/cast (fnptr c [(ptr Parser) (ptr u8) i64] i64) raw)
            err
              (primitive/call-ptr fp
                                  s
                                  start
                                  (primitive/isub (primitive/cast i64 endp)
                                                  (primitive/cast i64 start)))]
        err)))

(defn span-result [(s (ptr Parser)) (id i64) (err i64)] (-> i64)
  (if (!= err (cast i64 -1))
      err
      (do
        (store! (field s reason)
                (let [$g10 id]
                  (if (= $g10 1)
                      "Span callback error in on_method"
                      (if (= $g10 3)
                          "Span callback error in on_url"
                          (if (= $g10 5)
                              "Span callback error in on_header_field"
                              (if (= $g10 7)
                                  "Span callback error in on_header_value"
                                  (if (= $g10 15)
                                      "Span callback error in on_body"
                                      (if (= $g10 17)
                                          "Span callback error in on_chunk_extension_name"
                                          (if (= $g10 19)
                                              "Span callback error in on_chunk_extension_value"
                                              (if (= $g10 21)
                                                  "Span callback error in on_protocol"
                                                  (if (= $g10 23)
                                                      "Span callback error in on_version"
                                                      (if (= $g10 26)
                                                          "Span callback error in on_status"
                                                          "Span callback error"))))))))))))
        TY_HPE_USER)))

(defn has-flag? [(s (ptr Parser)) (flag i64)] (-> bool)
  (!= (primitive/iand (load (field s flags)) flag) (cast i64 0)))

(defn has-lenient? [(s (ptr Parser)) (flag i64)] (-> bool)
  (!= (primitive/iand (load (field s lenient-flags)) flag) (cast i64 0)))

(defn message-needs-eof? [(s (ptr Parser))] (-> bool)
  (if (= (load (field s parser-type)) TY_HTTP_REQUEST)
      false
      (let [status (load (field s status-code))]
        (cond (or (= (primitive/idiv status 100) (cast i64 1))
                  (or (= status (cast i64 204))
                      (or (= status (cast i64 304)) (has-flag? s F_SKIPBODY))))
                false
              (and (has-flag? s F_TRANSFER_ENCODING) (not (has-flag? s F_CHUNKED))) true
              (or (has-flag? s F_CHUNKED) (has-flag? s F_CONTENT_LENGTH)) false
              :else true))))

(defn should-keep-alive? [(s (ptr Parser))] (-> bool)
  (let [modern
          (and (> (load (field s http-major)) (cast i64 0))
               (> (load (field s http-minor)) (cast i64 0)))]
    (and (if modern (not (has-flag? s F_CONNECTION_CLOSE)) (has-flag? s F_CONNECTION_KEEP_ALIVE))
         (not (message-needs-eof? s)))))

(defn before-headers-complete! [(s (ptr Parser))] (-> i64)
  (if (and (has-flag? s F_UPGRADE) (has-flag? s F_CONNECTION_UPGRADE))
      (field-store! s
                    7
                    (if (or (= (field-load s 1) TY_HTTP_REQUEST)
                            (= (field-load s 10) (cast i64 101)))
                        1
                        0))
      (field-store! s 7 (if (= (field-load s 2) TY_HTTP_CONNECT) 1 0)))
  0)

(defn after-headers-complete [(s (ptr Parser))] (-> i64)
  (let [has-body
          (or (has-flag? s F_CHUNKED)
              (> (field-load s 0) (cast i64 0)))
        response (= (field-load s 1) TY_HTTP_RESPONSE)
        status (field-load s 10)]
    (cond (or (and (!= (field-load s 7) (cast i64 0))
                   (or (= (field-load s 2) TY_HTTP_CONNECT)
                       (or (has-flag? s F_SKIPBODY) (not has-body))))
              (and response (= status (cast i64 101))))
            1
          (and response (= status (cast i64 100))) 0
          (or (has-flag? s F_SKIPBODY)
              (and response
                   (or (= status (cast i64 102))
                       (or (= status (cast i64 103))
                           (or (= status (cast i64 204)) (= status (cast i64 304)))))))
            0
          (has-flag? s F_CHUNKED) 2
          (has-flag? s F_TRANSFER_ENCODING)
            (if (and (= (field-load s 1) TY_HTTP_REQUEST)
                     (and (not (has-lenient? s TY_LENIENT_CHUNKED_LENGTH))
                          (not (has-lenient? s TY_LENIENT_TRANSFER_ENCODING))))
                5
                4)
          (not (has-flag? s F_CONTENT_LENGTH)) (if (message-needs-eof? s) 4 0)
          (= (field-load s 0) (cast i64 0)) 0
          :else 3)))

(defn after-message-complete! [(s (ptr Parser))] (-> i64)
  (let [keep (should-keep-alive? s)]
    (field-store! s 8 TY_FINISH_SAFE)
    (field-store! s 9 0)
    (if keep 1 0)))

(defn invoke-external [(s (ptr Parser))
                       (id i64)
                       (p (ptr u8))
                       (endp (ptr u8))
                       (matched i64)] (-> i64)
  (let [settings (settings-of s)]
    (case id
          ; Handwritten protocol hooks do not consult the callback table.
          9 (before-headers-complete! s)
          11 (after-headers-complete s)
          13 (after-message-complete! s)
          ; Upstream permits llhttp_init(..., NULL) and skips every callback.
          (if (= (primitive/cast i64 settings) (cast i64 0))
              0
              (case id 0
                    (call-simple s (load (field settings on-message-begin))) 2
                    (call-simple s (load (field settings on-method-complete))) 4
                    (call-simple s (load (field settings on-url-complete))) 6
                    (call-simple s (load (field settings on-header-field-complete))) 8
                    (call-simple s (load (field settings on-header-value-complete))) 10
                    (call-simple s (load (field settings on-headers-complete))) 12
                    (call-simple s (load (field settings on-message-complete))) 14
                    (call-simple s (load (field settings on-chunk-header))) 16
                    (call-simple s (load (field settings on-chunk-complete))) 18
                    (call-simple s (load (field settings on-chunk-extension-name-complete))) 20
                    (call-simple s (load (field settings on-chunk-extension-value-complete))) 22
                    (call-simple s (load (field settings on-protocol-complete))) 24
                    (call-simple s (load (field settings on-version-complete))) 25
                    (call-simple s (load (field settings on-status-complete))) 27
                    (call-simple s (load (field settings on-reset))) 0)))))

(defn invoke-external-span [(s (ptr Parser))
                            (id i64)
                            (start (ptr u8))
                            (endp (ptr u8))] (-> i64)
  (let [settings (settings-of s)]
    (if (= (primitive/cast i64 settings) (cast i64 0))
        0
        (case id 1
              (span-result s id (call-span s (load (field settings on-method)) start endp)) 3
              (span-result s id (call-span s (load (field settings on-url)) start endp)) 5
              (span-result s id (call-span s (load (field settings on-header-field)) start endp)) 7
              (span-result s id (call-span s (load (field settings on-header-value)) start endp)) 15
              (span-result s id (call-span s (load (field settings on-body)) start endp)) 17
              (span-result s id (call-span s (load (field settings on-chunk-extension-name)) start endp)) 19
              (span-result s id (call-span s (load (field settings on-chunk-extension-value)) start endp)) 21
              (span-result s id (call-span s (load (field settings on-protocol)) start endp)) 23
              (span-result s id (call-span s (load (field settings on-version)) start endp)) 26
              (span-result s id (call-span s (load (field settings on-status)) start endp)) 0))))
