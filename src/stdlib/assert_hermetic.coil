(module coil.assert.hermetic)
(import "coil.primitive" :as primitive)

; Assertion surface for the hermetic core profile. Failure deliberately performs
; no IO and calls no process/runtime function: it traps through an invalid store.
(defn hermetic-assert-fail! [] (-> i64)
  (store! (primitive/cast (ptr i64) 0) 0)
  0)

(defn assert [(condition Code)] (-> Code)
  `(if ~condition 0 (hermetic-assert-fail!)))

(defn assert-eq [(left Code) (right Code)] (-> Code)
  `(let [left-value ~left
         right-value ~right]
     (if (= left-value right-value) 0 (hermetic-assert-fail!))))

(defn assert-ne [(left Code) (right Code)] (-> Code)
  `(let [left-value ~left
         right-value ~right]
     (if (!= left-value right-value) 0 (hermetic-assert-fail!))))

(provide-core [assert assert-eq assert-ne])
