(module coil.assert.hermetic)
(import "coil.primitive" :as primitive)
(import "coil.fail" :as fail)

; Assertion surface for the hermetic core profile. Failure performs no IO and
; calls no process/runtime function: it goes to the `coil.fail` handler, if the
; program installed one, and traps.
(defn hermetic-assert-fail! [(what (slice u8)) (at (slice u8))] (-> i64)
  (fail/fail! what at)
  0)

;;; `file:line:col` of the assertion being expanded, as a string literal.
(defn call-site [] (-> Code)
  (let [node (primitive/code-call-site)
        text (primitive/code-str (primitive/code-file node) ":" (primitive/code-line node)
                                 ":" (primitive/code-col node))]
    `~text))

(defn assert [(condition Code)] (-> Code)
  `(if ~condition 0 (hermetic-assert-fail! "assertion failed" ~(call-site))))

(defn assert-eq [(left Code) (right Code)] (-> Code)
  `(let [left-value ~left
         right-value ~right]
     (if (= left-value right-value)
         0
         (hermetic-assert-fail! "assert-eq failed" ~(call-site)))))

(defn assert-ne [(left Code) (right Code)] (-> Code)
  `(let [left-value ~left
         right-value ~right]
     (if (!= left-value right-value)
         0
         (hermetic-assert-fail! "assert-ne failed" ~(call-site)))))

(provide-core [assert assert-eq assert-ne])
