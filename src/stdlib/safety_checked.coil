(module coil.safety.checked)

;;; `:safety/checked false` on a `defn` or an impl method turns off the runtime
;;; checks `coil.safety` would insert into it, like Zig's `@setRuntimeSafety(false)`.
;;; The operations written in that function keep their unchecked meaning: an
;;; integer `+` wraps, `get` reads past the end, `cast` truncates.
;;;
;;; This module only declares the annotation, so code can carry it whether or not
;;; the build applies `coil.safety`; importing it switches nothing on.
(defannotation :safety/checked bool)
