(module coil.print)
(import "coil.primitive" :as primitive)

; Ambient print/println over stdout — the convenience layer you can call with ZERO
; imports (coil.core `:reexport`s this module, so `print`/`println` are auto-referred
; everywhere, like Clojure's `println` in clojure.core).
;
; Format strings are `fmt`'s: `{}` uses Display, `{:?}` compact Debug, `{:#?}`
; pretty Debug, and `{:x}`/`{:#x}` lowercase hexadecimal. `{{`/`}}` are literal
; braces. A wrong argument count is a compile-time error.
;
;   (println "x={} ok={}" 42 true)       ; -> stdout, with a trailing newline
;   (println "point={:?}" point)         ; -> compact structural Debug
;   (print   "loading {}" name)          ; -> stdout, no newline
;   (eprintln "warning: {}" message)     ; -> stderr, with a trailing newline
;
; Both yield a `(Result i64 IoError)` (the underlying write result), so discard it in
; a `(do … 0)` like any effectful call. The explicit-Writer forms remain in fmt/io
; (`(fmt w …)`, `print-*`) for when you need a specific sink (a buffer, stderr, …);
; this is just the everyday stdout/stderr shortcut.
(export print println eprint eprintln)

(provide-core [print println eprint eprintln])

(import "coil.fmt" :use [fmt])  ; format-string macro

(import "coil.io" :use [stdout stderr])

;;; The format string `f` with a newline appended, so the line is formatted as one
;;; unit: every argument is evaluated before anything is written, and the newline
;;; goes out with the last literal piece rather than as a separate write.
(defn print--line-format [(f Code)] (-> Code)
  (let [bytes (primitive/str-bytes f)
        out (primitive/code-list-new)]
    (for b bytes (primitive/code-list-push! out b))
    (primitive/code-list-push! out `10)
    (primitive/bytes->str (primitive/code-list-done out))))

;;; (print "fmt" args…) — format to stdout, no trailing newline. The writer is bound
;;; once (a gensym) so a multi-spec format doesn't re-create the stdout writer per piece.
(defn print [(f Code) & (args Code)] (-> Code)
  (let [w (primitive/fresh-identifier "temporary")]
    `(let [~w (stdout)] (fmt ~w ~f ~@args))))

;;; (println "fmt" args…) — like `print`, plus a trailing newline.
(defn println [(f Code) & (args Code)] (-> Code)
  (let [w (primitive/fresh-identifier "temporary")]
    `(let [~w (stdout)] (fmt ~w ~(print--line-format f) ~@args))))

;;; (eprint "fmt" args…) — `print` to stderr.
(defn eprint [(f Code) & (args Code)] (-> Code)
  (let [w (primitive/fresh-identifier "temporary")]
    `(let [~w (stderr)] (fmt ~w ~f ~@args))))

;;; (eprintln "fmt" args…) — `println` to stderr: diagnostics, progress and errors
;;; that should not mix with a program's output.
(defn eprintln [(f Code) & (args Code)] (-> Code)
  (let [w (primitive/fresh-identifier "temporary")]
    `(let [~w (stderr)] (fmt ~w ~(print--line-format f) ~@args))))
