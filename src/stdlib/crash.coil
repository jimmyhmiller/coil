(module coil.crash)
(import "coil.primitive" :as primitive)
(import "coil.alloc" :as alloc)
(import "coil.slice" :use [slice-data slice-len])

(export crash-install!
        crash-install-memory-faults!
        crash-install-artifact!
        crash-event!
        crash-set-event-capacity!)

(extern write :cc c [i32 (ptr i8) isize] (-> isize))

(extern open :cc c [(ptr i8) i32 ...] (-> i32))

(extern close :cc c [i32] (-> i32))

(extern sigaction :cc c [i32 (ptr i8) (ptr i8)] (-> i32))

(extern sigemptyset :cc c [(ptr i8)] (-> i32))

(extern sigaltstack :cc c [(ptr i8) (ptr i8)] (-> i32))

(extern signal :cc c [i32 (ptr i8)] (-> (ptr i8)))

(extern raise :cc c [i32] (-> i32))

(extern _exit :cc c [i32] (-> never))

(extern backtrace :cc c [(ptr (ptr i8)) i32] (-> i32))

(extern backtrace_symbols_fd :cc c [(ptr (ptr i8)) i32 i32] (-> void))

(extern getenv :cc c [(ptr i8)] (-> (ptr i8)))

(extern getpid :cc c [] (-> i32))

;;; open(2) flags for the crash artifact, folded for the platform being COMPILED
;;; FOR. O_CREAT and O_TRUNC differ between Linux and darwin (64/512 vs 512/1024),
;;; so a hardcoded literal is correct on exactly one of them — see fs.coil, which
;;; carries the same table for the same reason.
(defn crash--os-pick [(linux Code) (darwin Code)] (-> Code)
  (if (primitive/code-eq (primitive/target-os) `linux) linux darwin))

;;; hygiene: platform crash declarations intentionally enter this module's public namespace.
(defn crash--explicit-public-name [(name Code)] (-> Code)
  (primitive/syntax->datum name))

; pthread_self returns pthread_t, which is an integer on glibc and a pointer
; on Darwin. Crash records print its bits as a hexadecimal thread identifier.
(defn crash--pthread-self-abi [] (-> Code)
  (if (primitive/code-eq (primitive/target-os) `linux)
      `(do
         (extern ~(crash--explicit-public-name `pthread_self_raw)
           :as "pthread_self" :cc c [] (-> u64))
         (defn ~(crash--explicit-public-name `pthread_self) [] (-> i64)
           (primitive/cast i64 (pthread_self_raw))))
      `(do
         (extern ~(crash--explicit-public-name `pthread_self_raw)
           :as "pthread_self" :cc c [] (-> (ptr i8)))
         (defn ~(crash--explicit-public-name `pthread_self) [] (-> i64)
           (primitive/cast i64 (pthread_self_raw))))))

(meta (crash--pthread-self-abi))

(defn crash--gen-open-flags [] (-> Code)
  `(do
     (const ~(crash--explicit-public-name `CRASH_O_WRONLY) 1)
     (const ~(crash--explicit-public-name `CRASH_O_CREAT)
            ~(crash--os-pick `64 `512))
     (const ~(crash--explicit-public-name `CRASH_O_TRUNC)
            ~(crash--os-pick `512 `1024))))

(meta (crash--gen-open-flags))

;;; Is the program being COMPILED FOR a WebAssembly instance?
(defn crash--wasm-target? [] (-> bool)
  (let [arch (primitive/target-arch)]
    (or (primitive/code-eq arch `wasm32) (primitive/code-eq arch `wasm64))))

;;; libc's signal records stay opaque: only their sizes, field offsets and
;;; constants cross the ABI boundary, folded for the platform being COMPILED FOR,
;;; as fs.coil folds its open flags. (A `cimport :probe` would ask the machine the
;;; compiler runs on, which answers for no other target.) Each column was read from
;;; clang's `sizeof`/`offsetof` on that platform; glibc lays the records out alike
;;; on x86-64 and AArch64, and Darwin on both its architectures. A WebAssembly
;;; instance has no signals: a fault traps it, and the host reports the trap, so it
;;; gets none of these.
(defn crash--signal-abi [] (-> Code)
  (if (crash--wasm-target?)
      `(do)
      `(do
         (const ~(crash--explicit-public-name `CRASH_SIGACTION_SIZE) ~(crash--os-pick `152 `16))
         (const ~(crash--explicit-public-name `CRASH_SA_MASK_OFFSET) 8)
         (const ~(crash--explicit-public-name `CRASH_SA_FLAGS_OFFSET) ~(crash--os-pick `136 `12))
         (const ~(crash--explicit-public-name `CRASH_SIGINFO_ADDR_OFFSET) ~(crash--os-pick `16 `24))
         (const ~(crash--explicit-public-name `CRASH_SA_SIGINFO) ~(crash--os-pick `4 `64))
         (const ~(crash--explicit-public-name `CRASH_SA_ONSTACK) ~(crash--os-pick `134217728 `1))
         (const ~(crash--explicit-public-name `CRASH_STACK_SIZE) 24)
         (const ~(crash--explicit-public-name `CRASH_STACK_SP_OFFSET) 0)
         (const ~(crash--explicit-public-name `CRASH_STACK_SIZE_OFFSET) ~(crash--os-pick `16 `8))
         (const ~(crash--explicit-public-name `CRASH_STACK_FLAGS_OFFSET) ~(crash--os-pick `8 `16))
         (const ~(crash--explicit-public-name `CRASH_SIGSEGV) 11)
         (const ~(crash--explicit-public-name `CRASH_SIGBUS) ~(crash--os-pick `7 `10))
         (const ~(crash--explicit-public-name `CRASH_SIGILL) 4)
         (const ~(crash--explicit-public-name `CRASH_SIGABRT) 6)
         (const ~(crash--explicit-public-name `CRASH_SIGFPE) 8))))

(meta (crash--signal-abi))

(defn crash-artifact-fd [] (-> (ptr i32))
  (primitive/alloc-static i32))

(defn crash-event-next [] (-> (ptr i64))
  (primitive/alloc-static i64))

(defn crash-event-capacity [] (-> (ptr i64))
  (primitive/alloc-static i64))

(defn crash-events [] (-> (ptr (array i8 4096)))
  (primitive/alloc-static (array i8 4096)))

(defn crash-event-lengths [] (-> (ptr (array i8 64)))
  (primitive/alloc-static (array i8 64)))

(defn crash-alt-stack [] (-> (ptr (array i8 65536)))
  (primitive/alloc-static (array i8 65536)))

(defn crash-write-fd [(fd i32) (bytes (ptr i8)) (n i64)] (-> i64)
  (if (>= fd 0) (primitive/cast i64 (write fd bytes (primitive/cast isize n))) 0))

(defn crash-write-both [(bytes (ptr i8)) (n i64)] (-> i64)
  (crash-write-fd 2 bytes n)
  (let [artifact (load (crash-artifact-fd))]
    (if (> artifact 2) (crash-write-fd artifact bytes n) 0)))

;;; The triple of the platform being COMPILED FOR, as a string literal.
(defn crash-target [] (-> Code)
  (cond (crash--wasm-target?) (if (primitive/code-eq (primitive/target-arch) `wasm64) `"wasm64" `"wasm32")
        (primitive/code-eq (primitive/target-os) `linux)
      (if (primitive/code-eq (primitive/target-arch) `x86_64)
          `"x86_64-linux"
          `"aarch64-linux")
      :else
      (if (primitive/code-eq (primitive/target-arch) `x86_64)
          `"x86_64-macos"
          `"aarch64-macos")))

(defn crash-artifact-header [] (-> i64)
  (let [fd (load (crash-artifact-fd))]
    (when (> fd 2)
      (let [heading "coil crash artifact v1\n"
            metadata
              "compiler=self-hosted\nprofile=debug-runtime\nbackend=llvm\ntarget="]
        (crash-write-fd fd
                        (primitive/cast (ptr i8) (slice-data heading))
                        (slice-len heading))
        (crash-write-fd fd
                        (primitive/cast (ptr i8) (slice-data metadata))
                        (slice-len metadata)))
      (let [target (crash-target)]
        (crash-write-fd fd
                        (primitive/cast (ptr i8) (slice-data target))
                        (slice-len target)))
      (let [process "\nprocess="]
        (crash-write-fd fd
                        (primitive/cast (ptr i8) (slice-data process))
                        (slice-len process)))
      ; Fixed-width hex is also used here to keep artifact setup independent of fmt.
      (let [saved (load (crash-artifact-fd))]
        (store! (crash-artifact-fd) -1)
        (crash-write-hex-fd fd (primitive/cast i64 (getpid)))
        (store! (crash-artifact-fd) saved))
      (let [newline "\n"]
        (crash-write-fd fd (primitive/cast (ptr i8) (slice-data newline)) 1))
      0))
  0)

(defn crash-text [(s (slice u8))] (-> i64)
  (crash-write-both (primitive/cast (ptr i8) (slice-data s)) (slice-len s)))

; Fixed-width hexadecimal avoids snprintf and allocation in the fatal handler.
(defn crash-hex-digit [(x i64)] (-> i8)
  (primitive/cast i8 (if (< x 10) (+ 48 x) (+ 87 x))))

(defn crash-write-hex-fd [(fd i32) (value i64)] (-> i64)
  (let [buf (primitive/alloc-stack (array i8 18))
        (mut shift) 60
        (mut i) 2]
    (store! (primitive/index buf 0) (primitive/cast i8 48))
    (store! (primitive/index buf 1) (primitive/cast i8 120))
    (loop (if (< (load shift) 0)
              (break)
              (do
                (store! (primitive/index buf (load i))
                        (crash-hex-digit (primitive/iand (primitive/ishr value
                                                                         (load shift))
                                                         15)))
                (store! shift (- (load shift) 4))
                (store! i (+ (load i) 1)))))
    (crash-write-fd fd (primitive/cast (ptr i8) buf) 18)))

(defn crash-write-hex [(value i64)] (-> i64)
  (crash-write-hex-fd 2 value)
  (let [artifact (load (crash-artifact-fd))]
    (if (> artifact 2) (crash-write-hex-fd artifact value) 0)))

(defn crash-dump-events [] (-> i64)
  (let [capacity (load (crash-event-capacity))
        next (load (crash-event-next))
        start (if (> next capacity) (- next capacity) 0)
        (mut i) start]
    (when (> capacity 0)
      (crash-text "recent events:\n")
      (loop (if (>= (load i) next)
                (break)
                (let [slot (primitive/urem (load i) capacity)
                      n
                        (primitive/cast i64
                                        (load (primitive/index (crash-event-lengths)
                                                               slot)))
                      p
                        (primitive/index (primitive/cast (ptr i8)
                                                         (crash-events))
                                         (* slot 64))]
                  (crash-text "  ")
                  (crash-write-both p n)
                  (crash-text "\n")
                  (store! i (+ (load i) 1))))))
    0))

;;; An address near the top of the stack of the thread that installed the handler,
;;; recorded at install time. The handler runs on its own alternate stack, so a
;;; local of its own says nothing about where the fault was.
(defn crash-stack-top [] (-> (ptr i64))
  (primitive/alloc-static i64))

;;; Whether a fault at `fault` lies just below the recorded top of the stack, within
;;; the largest stack a thread is given by default: stacks grow downward, so an
;;; overflow touches the page past the lowest one.
(defn crash-below-stack? [(fault i64)] (-> bool)
  (let [top (load (crash-stack-top))]
    (and (> top 0)
         (and (< fault top) (< (- top fault) 268435456)))))

;;; The fault diagnostics, which catch signals. A WebAssembly instance has none --
;;; a fault traps it, and the host reports the trap -- so there is nothing to
;;; install there, and asking to is an error.
(defn crash--fault-machinery [] (-> Code)
  (if (crash--wasm-target?)
      `(do
         (defn ~(crash--explicit-public-name `crash-install!) [] (-> i64)
           (panic "coil.crash: a WebAssembly instance has no signals to install fault diagnostics for; a fault traps the instance and its host reports it"))
         (defn ~(crash--explicit-public-name `crash-install-memory-faults!) [] (-> i64)
           (panic "coil.crash: a WebAssembly instance has no signals to install fault diagnostics for; a fault traps the instance and its host reports it")))
      `(do
         (defn ~(crash--explicit-public-name `crash-handler) [(number i32) (info (ptr i8)) (context (ptr i8))] (-> i64)
           (let [fault
                   (load (primitive/cast (ptr (ptr i8))
                                         (primitive/index info CRASH_SIGINFO_ADDR_OFFSET)))
                 marker (primitive/alloc-stack i8)
                 distance
                   (let [a (primitive/cast i64 fault)
                         b (primitive/cast i64 marker)]
                     (if (> a b) (- a b) (- b a)))]
             (crash-text "\ncoil crash: signal=")
             (crash-write-hex (primitive/cast i64 number))
             (crash-text " fault-address=")
             (crash-write-hex (primitive/cast i64 fault))
             (crash-text " thread=")
             (crash-write-hex (primitive/cast i64 (pthread_self)))
             (crash-text " context=")
             (crash-write-hex (primitive/cast i64 context))
             (crash-text "\n")
             (when (and (or (= number (primitive/cast i32 CRASH_SIGSEGV))
                            (= number (primitive/cast i32 CRASH_SIGBUS)))
                        (or (< distance 1048576) (crash-below-stack? (primitive/cast i64 fault))))
               (crash-text "diagnosis: stack-overflow guard fault\n")
               0)
             (crash-dump-events)
             (let [frames (primitive/alloc-stack (array (ptr i8) 32))
                   count (backtrace (primitive/cast (ptr (ptr i8)) frames) 32)]
               (when (> count 0)
                 (crash-text "stack trace:\n")
                 (backtrace_symbols_fd (primitive/cast (ptr (ptr i8)) frames) count 2)
                 (let [artifact (load (crash-artifact-fd))]
                   (when (> artifact 2)
                     (backtrace_symbols_fd (primitive/cast (ptr (ptr i8)) frames)
                                           count
                                           artifact)
                     0))))
             ; Restore the default disposition and re-raise, retaining the original signal
             ; semantics for shells, supervisors, and core-dump policy.
             (signal number (primitive/cast (ptr i8) 0))
             (raise number)
             (_exit (primitive/cast i32 (+ 128 (primitive/cast i64 number))))
             0))

         (defn ~(crash--explicit-public-name `crash-install-alt-stack) [] (-> i64)
           (let [config (primitive/alloc-stack (array i8 64))
                 top (primitive/alloc-stack i8)
                 (mut i) 0]
             (store! (crash-stack-top) (primitive/cast i64 top))
             (loop (if (>= (load i) CRASH_STACK_SIZE)
                       (break)
                       (do
                         (store! (primitive/index config (load i)) (primitive/cast i8 0))
                         (store! i (+ (load i) 1)))))
             (store! (primitive/cast (ptr (ptr i8))
                                     (primitive/index config CRASH_STACK_SP_OFFSET))
                     (primitive/cast (ptr i8) (crash-alt-stack)))
             (store! (primitive/cast (ptr i64)
                                     (primitive/index config CRASH_STACK_SIZE_OFFSET))
                     65536)
             (store! (primitive/cast (ptr i32)
                                     (primitive/index config CRASH_STACK_FLAGS_OFFSET))
                     0)
             (primitive/cast i64
                             (sigaltstack (primitive/cast (ptr i8) config)
                                          (primitive/cast (ptr i8) 0)))))

         (defn ~(crash--explicit-public-name `crash-install-one) [(number i32)] (-> i64)
           (let [action (primitive/alloc-stack (array i8 256))
                 (mut i) 0]
             (loop (if (>= (load i) CRASH_SIGACTION_SIZE)
                       (break)
                       (do
                         (store! (primitive/index action (load i)) (primitive/cast i8 0))
                         (store! i (+ (load i) 1)))))
             (store! (primitive/cast (ptr (ptr i8)) action)
                     (primitive/cast (ptr i8) (primitive/fnptr-of crash-handler)))
             (sigemptyset (primitive/index (primitive/cast (ptr i8) action)
                                           CRASH_SA_MASK_OFFSET))
             (store! (primitive/cast (ptr i32)
                                     (primitive/index (primitive/cast (ptr i8) action)
                                                      CRASH_SA_FLAGS_OFFSET))
                     (primitive/cast i32 (+ CRASH_SA_SIGINFO CRASH_SA_ONSTACK)))
             (primitive/cast i64
                             (sigaction number
                                        (primitive/cast (ptr i8) action)
                                        (primitive/cast (ptr i8) 0)))))

         ;;; Install fatal-signal diagnostics for memory, illegal-instruction, arithmetic,
         ;;; and explicit-abort failures. Returns zero when every disposition was installed.
         (defn ~(crash--explicit-public-name `crash-install!) [] (-> i64)
           (store! (crash-artifact-fd) -1)
           (crash-install-alt-stack)
           (let [path (getenv c"COIL_CRASH_REPORT")]
             (when (!= (primitive/cast i64 path) 0)
               (crash-install-artifact! path)
               (crash-artifact-header)
               0))
           (when (= (load (crash-event-capacity)) 0)
             (store! (crash-event-capacity) 64)
             0)
           (+ (crash-install-one (primitive/cast i32 CRASH_SIGSEGV))
              (+ (crash-install-one (primitive/cast i32 CRASH_SIGBUS))
                 (+ (crash-install-one (primitive/cast i32 CRASH_SIGILL))
                    (+ (crash-install-one (primitive/cast i32 CRASH_SIGABRT))
                       (crash-install-one (primitive/cast i32 CRASH_SIGFPE)))))))

         ;;; Install diagnostics for memory faults only, a segmentation fault or bus error,
         ;;; on an alternate stack. A stack overflow faults with no stack left to report on,
         ;;; which is why the stack is separate. `SIGABRT` is left alone: a program that
         ;;; aborts on purpose has already said why. Returns zero when both were installed.
         (defn ~(crash--explicit-public-name `crash-install-memory-faults!) [] (-> i64)
           (store! (crash-artifact-fd) -1)
           (crash-install-alt-stack)
           (when (= (load (crash-event-capacity)) 0)
             (store! (crash-event-capacity) 64)
             0)
           (+ (crash-install-one (primitive/cast i32 CRASH_SIGSEGV))
              (crash-install-one (primitive/cast i32 CRASH_SIGBUS)))))))

(meta (crash--fault-machinery))

;;; Open a predeclared crash artifact before faults occur. The handler only writes
;;; to this already-open descriptor.
(defn crash-install-artifact! [(path (ptr i8))] (-> i64)
  (let [old (load (crash-artifact-fd))]
    (when (> old 2) (close old) 0)
    ; O_WRONLY | O_CREAT | O_TRUNC, mode 0600 — folded for the TARGET, because
    ; these numbers differ per OS. The literal 1537 that used to be here was the
    ; darwin spelling; on Linux it means O_WRONLY|O_TRUNC|0x400 with no O_CREAT,
    ; so the artifact was silently never created and COIL_CRASH_REPORT did
    ; nothing. Same class of bug as fs.coil's open flags, and the same fix.
    (let [fd
            (open path
                  (primitive/ior CRASH_O_WRONLY
                                 (primitive/ior CRASH_O_CREAT CRASH_O_TRUNC))
                  384)]
      (store! (crash-artifact-fd) fd)
      (primitive/cast i64 fd))))

(defn crash-set-event-capacity! [(capacity i64)] (-> i64)
  (store! (crash-event-capacity)
          (if (< capacity 0) 0 (if (> capacity 64) 64 capacity)))
  0)

;;; Record a bounded recent event without allocating. Events are truncated to 63
;;; bytes and kept in a fixed 64-entry ring for post-crash context.
(defn crash-event! [(event (slice u8))] (-> i64)
  (let [capacity (load (crash-event-capacity))]
    (when (> capacity 0)
      (let [next (load (crash-event-next))
            slot (primitive/urem next capacity)
            n (if (> (slice-len event) 63) 63 (slice-len event))
            dst
              (primitive/index (primitive/cast (ptr i8) (crash-events))
                               (* slot 64))
            (mut i) 0]
        (loop (if (>= (load i) n)
                  (break)
                  (do
                    (store! (primitive/index dst (load i))
                            (primitive/cast i8
                                            (load (primitive/index (slice-data event)
                                                                   (load i)))))
                    (store! i (+ (load i) 1)))))
        (store! (primitive/index (crash-event-lengths) slot)
                (primitive/cast i8 n))
        (store! (crash-event-next) (+ next 1))))
    0))
