(module coil.crash)
(import "coil.primitive" :as primitive)
(import "coil.alloc" :as alloc)
(import "coil.os" :as os)
(import "coil.fail" :as fail)

(export install!
        install-memory-faults!
        install-artifact!
        event!
        set-event-capacity!)

(extern write :cc c [i32 (ptr i8) isize] (-> isize))

(extern open :cc c [(ptr i8) i32 ...] (-> i32))

(extern close :cc c [i32] (-> i32))

(extern sigaction :cc c [i32 (ptr i8) (ptr i8)] (-> i32))

(extern sigemptyset :cc c [(ptr i8)] (-> i32))

(extern sigaltstack :cc c [(ptr i8) (ptr i8)] (-> i32))

(extern signal :cc c [i32 (ptr i8)] (-> (ptr i8)))

(extern raise :cc c [i32] (-> i32))

(extern _exit :cc c [i32] (-> never))

(extern backtrace :cc c [(ptr (ptr i8)) i32] (-> i32))

(extern backtrace_symbols_fd :cc c [(ptr (ptr i8)) i32 i32] (-> void))

(extern getenv :cc c [(ptr i8)] (-> (ptr i8)))

(extern getpid :cc c [] (-> i32))

;;; Signal records, for the platforms that have signals: Linux and Darwin.
(defn signal-pick [(linux Code) (darwin Code)] (-> Code)
  (match (target-os)
    (Linux [] linux)
    (Darwin [] darwin)
    (_ (primitive/error (primitive/code-str "coil.crash: `" (os-name (target-os)) "` has no signal records")))))

;;; hygiene: platform crash declarations intentionally enter this module's public namespace.
(defn explicit-public-name [(name Code)] (-> Code)
  (primitive/syntax->datum name))

; pthread_self returns pthread_t, which is an integer on glibc and a pointer
; on Darwin. Crash records print its bits as a hexadecimal thread identifier.
(defn pthread-self-abi [] (-> Code)
  (let [pointer
          `(do
             (extern ~(explicit-public-name `pthread_self_raw)
               :as "pthread_self" :cc c [] (-> (ptr i8)))
             (defn ~(explicit-public-name `pthread_self) [] (-> i64)
               (primitive/cast i64 (pthread_self_raw))))]
    (os/os-pick-with-none
      `(do
         (extern ~(explicit-public-name `pthread_self_raw)
           :as "pthread_self" :cc c [] (-> u64))
         (defn ~(explicit-public-name `pthread_self) [] (-> i64)
           (primitive/cast i64 (pthread_self_raw))))
      pointer
      pointer
      ; Bare metal runs the program on its one thread of execution.
      `(defn ~(explicit-public-name `pthread_self) [] (-> i64) 0))))

(meta (pthread-self-abi))

;;; open(2) flags for the crash artifact, folded for the platform being COMPILED
;;; FOR. O_CREAT and O_TRUNC differ between Linux and darwin (64/512 vs 512/1024),
;;; so a hardcoded literal is correct on exactly one of them — see fs.coil, which
;;; carries the same table for the same reason. Bare metal has no files.
(defn gen-open-flags [] (-> Code)
  (if (fail/freestanding?)
      `(do)
      `(do
         (const ~(explicit-public-name `CRASH_O_WRONLY) 1)
         (const ~(explicit-public-name `CRASH_O_CREAT)
                ~(os/os-pick `64 `512 `512))
         (const ~(explicit-public-name `CRASH_O_TRUNC)
                ~(os/os-pick `512 `1024 `1024)))))

(meta (gen-open-flags))

;;; Is the program being COMPILED FOR a WebAssembly instance?
(defn wasm-target? [] (-> bool)
  (match (target-arch)
    (Wasm32 [] true)
    (Wasm64 [] true)
    (X86_64 [] false)
    (Aarch64 [] false)
    (Riscv32 [] false)))

;;; Does the platform being COMPILED FOR deliver signals? Linux and Darwin do; a
;;; WebAssembly instance traps and its host reports it, and bare metal has no OS.
(defn signals? [] (-> bool)
  (match (target-os)
    (Linux [] true)
    (Darwin [] true)
    (Wasm [] false)
    (BareMetal [] false)))

;;; libc's signal records stay opaque: only their sizes, field offsets and
;;; constants cross the ABI boundary, folded for the platform being COMPILED FOR,
;;; as fs.coil folds its open flags. (A `cimport :probe` would ask the machine the
;;; compiler runs on, which answers for no other target.) Each column was read from
;;; clang's `sizeof`/`offsetof` on that platform; glibc lays the records out alike
;;; on x86-64 and AArch64, and Darwin on both its architectures. A WebAssembly
;;; instance has no signals: a fault traps it, and the host reports the trap, so it
;;; gets none of these.
(defn signal-abi [] (-> Code)
  (if (not (signals?))
      `(do)
      `(do
         (const ~(explicit-public-name `CRASH_SIGACTION_SIZE) ~(signal-pick `152 `16))
         (const ~(explicit-public-name `CRASH_SA_MASK_OFFSET) 8)
         (const ~(explicit-public-name `CRASH_SA_FLAGS_OFFSET) ~(signal-pick `136 `12))
         (const ~(explicit-public-name `CRASH_SIGINFO_ADDR_OFFSET) ~(signal-pick `16 `24))
         (const ~(explicit-public-name `CRASH_SA_SIGINFO) ~(signal-pick `4 `64))
         (const ~(explicit-public-name `CRASH_SA_ONSTACK) ~(signal-pick `134217728 `1))
         (const ~(explicit-public-name `CRASH_STACK_SIZE) 24)
         (const ~(explicit-public-name `CRASH_STACK_SP_OFFSET) 0)
         (const ~(explicit-public-name `CRASH_STACK_SIZE_OFFSET) ~(signal-pick `16 `8))
         (const ~(explicit-public-name `CRASH_STACK_FLAGS_OFFSET) ~(signal-pick `8 `16))
         (const ~(explicit-public-name `CRASH_SIGSEGV) 11)
         (const ~(explicit-public-name `CRASH_SIGBUS) ~(signal-pick `7 `10))
         (const ~(explicit-public-name `CRASH_SIGILL) 4)
         (const ~(explicit-public-name `CRASH_SIGABRT) 6)
         (const ~(explicit-public-name `CRASH_SIGFPE) 8))))

(meta (signal-abi))

(defn artifact-fd [] (-> (ptr i32))
  (primitive/alloc-static i32))

(defn event-next [] (-> (ptr i64))
  (primitive/alloc-static i64))

(defn event-capacity [] (-> (ptr i64))
  (primitive/alloc-static i64))

(defn events [] (-> (ptr (array i8 4096)))
  (primitive/alloc-static (array i8 4096)))

(defn event-lengths [] (-> (ptr (array i8 64)))
  (primitive/alloc-static (array i8 64)))

(defn alt-stack [] (-> (ptr (array i8 65536)))
  (primitive/alloc-static (array i8 65536)))

(defn write-fd [(fd i32) (bytes (ptr i8)) (n i64)] (-> i64)
  (if (>= fd 0) (primitive/cast i64 (write fd bytes (primitive/cast isize n))) 0))

(defn write-both [(bytes (ptr i8)) (n i64)] (-> i64)
  (write-fd 2 bytes n)
  (let [artifact (load (artifact-fd))]
    (if (> artifact 2) (write-fd artifact bytes n) 0)))

;;; The platform being COMPILED FOR, as a string literal: `aarch64-linux`,
;;; `x86_64-macos`, `wasm32`, `riscv32-none`.
(defn target [] (-> Code)
  (let [os (match (target-os)
             (Linux [] "-linux")
             (Darwin [] "-macos")
             (Wasm [] "")
             (BareMetal [] "-none"))
        name (primitive/code-str (arch-name (target-arch)) os)]
    `~name))

(defn artifact-header [] (-> i64)
  (let [fd (load (artifact-fd))]
    (when (> fd 2)
      (let [heading "coil crash artifact v1\n"
            metadata
              "compiler=self-hosted\nprofile=debug-runtime\nbackend=llvm\ntarget="]
        (write-fd fd
                  (primitive/cast (ptr i8) (data heading))
                  (len heading))
        (write-fd fd
                  (primitive/cast (ptr i8) (data metadata))
                  (len metadata)))
      (let [triple (target)]
        (write-fd fd
                  (primitive/cast (ptr i8) (data triple))
                  (len triple)))
      (let [process "\nprocess="]
        (write-fd fd
                  (primitive/cast (ptr i8) (data process))
                  (len process)))
      ; Fixed-width hex is also used here to keep artifact setup independent of fmt.
      (let [saved (load (artifact-fd))]
        (store! (artifact-fd) -1)
        (write-hex-fd fd (primitive/cast i64 (getpid)))
        (store! (artifact-fd) saved))
      (let [newline "\n"]
        (write-fd fd (primitive/cast (ptr i8) (data newline)) 1))
      0))
  0)

(defn text [(s (slice u8))] (-> i64)
  (write-both (primitive/cast (ptr i8) (data s)) (len s)))

; Fixed-width hexadecimal avoids snprintf and allocation in the fatal handler.
(defn hex-digit [(x i64)] (-> i8)
  (primitive/cast i8 (if (< x 10) (+ 48 x) (+ 87 x))))

(defn write-hex-fd [(fd i32) (value i64)] (-> i64)
  (let [buf (primitive/alloc-stack (array i8 18))
        (mut shift) 60
        (mut i) 2]
    (store! (primitive/index buf 0) (: 48 i8))
    (store! (primitive/index buf 1) (: 120 i8))
    (loop (if (< (load shift) 0)
              (break)
              (do
                (store! (primitive/index buf (load i))
                        (hex-digit (primitive/iand (primitive/ishr value
                                                                   (load shift))
                                                   15)))
                (store! shift (- (load shift) 4))
                (store! i (+ (load i) 1)))))
    (write-fd fd (primitive/cast (ptr i8) buf) 18)))

(defn write-hex [(value i64)] (-> i64)
  (write-hex-fd 2 value)
  (let [artifact (load (artifact-fd))]
    (if (> artifact 2) (write-hex-fd artifact value) 0)))

(defn dump-events [] (-> i64)
  (let [capacity (load (event-capacity))
        next (load (event-next))
        start (if (> next capacity) (- next capacity) 0)
        (mut i) start]
    (when (> capacity 0)
      (text "recent events:\n")
      (loop (if (>= (load i) next)
                (break)
                (let [slot (primitive/urem (load i) capacity)
                      n
                        (primitive/cast i64
                                        (load (primitive/index (event-lengths)
                                                               slot)))
                      p
                        (primitive/index (primitive/cast (ptr i8)
                                                         (events))
                                         (* slot 64))]
                  (text "  ")
                  (write-both p n)
                  (text "\n")
                  (store! i (+ (load i) 1))))))
    0))

;;; An address near the top of the stack of the thread that installed the handler,
;;; recorded at install time. The handler runs on its own alternate stack, so a
;;; local of its own says nothing about where the fault was.
(defn stack-top [] (-> (ptr i64))
  (primitive/alloc-static i64))

;;; Whether a fault at `fault` lies just below the recorded top of the stack, within
;;; the largest stack a thread is given by default: stacks grow downward, so an
;;; overflow touches the page past the lowest one.
(defn below-stack? [(fault i64)] (-> bool)
  (let [top (load (stack-top))]
    (and (> top 0)
         (and (< fault top) (< (- top fault) 268435456)))))

;;; The fault diagnostics, which catch signals. A WebAssembly instance has none --
;;; a fault traps it, and the host reports the trap -- and bare metal has no OS to
;;; deliver one, so there is nothing to install there, and asking to is an error.
(defn fault-machinery [] (-> Code)
  (if (not (signals?))
      (let [why (if (fail/freestanding?)
                    "coil.crash: a bare-metal target has no operating system to deliver signals, so there are no fault diagnostics to install"
                    "coil.crash: a WebAssembly instance has no signals to install fault diagnostics for; a fault traps the instance and its host reports it")]
        `(do
           (defn ~(explicit-public-name `install!) [] (-> i64)
             (panic ~why))
           (defn ~(explicit-public-name `install-memory-faults!) [] (-> i64)
             (panic ~why))))
      `(do
         (defn ~(explicit-public-name `handler) [(number i32) (info (ptr i8)) (context (ptr i8))] (-> i64)
           (let [fault
                   (load (primitive/cast (ptr (ptr i8))
                                         (primitive/index info CRASH_SIGINFO_ADDR_OFFSET)))
                 marker (primitive/alloc-stack i8)
                 distance
                   (let [a (primitive/cast i64 fault)
                         b (primitive/cast i64 marker)]
                     (if (> a b) (- a b) (- b a)))]
             (text "\ncoil crash: signal=")
             (write-hex (primitive/cast i64 number))
             (text " fault-address=")
             (write-hex (primitive/cast i64 fault))
             (text " thread=")
             (write-hex (primitive/cast i64 (pthread_self)))
             (text " context=")
             (write-hex (primitive/cast i64 context))
             (text "\n")
             (when (and (or (= number (primitive/cast i32 CRASH_SIGSEGV))
                            (= number (primitive/cast i32 CRASH_SIGBUS)))
                        (or (< distance 1048576) (below-stack? (primitive/cast i64 fault))))
               (text "diagnosis: stack-overflow guard fault\n")
               0)
             (dump-events)
             (let [frames (primitive/alloc-stack (array (ptr i8) 32))
                   count (backtrace (primitive/cast (ptr (ptr i8)) frames) 32)]
               (when (> count 0)
                 (text "stack trace:\n")
                 (backtrace_symbols_fd (primitive/cast (ptr (ptr i8)) frames) count 2)
                 (let [artifact (load (artifact-fd))]
                   (when (> artifact 2)
                     (backtrace_symbols_fd (primitive/cast (ptr (ptr i8)) frames)
                                           count
                                           artifact)
                     0))))
             ; Restore the default disposition and re-raise, retaining the original signal
             ; semantics for shells, supervisors, and core-dump policy.
             (signal number (primitive/cast (ptr i8) 0))
             (raise number)
             (_exit (primitive/cast i32 (+ 128 (primitive/cast i64 number))))
             0))

         (defn ~(explicit-public-name `install-alt-stack) [] (-> i64)
           (let [config (primitive/alloc-stack (array i8 64))
                 top (primitive/alloc-stack i8)
                 (mut i) 0]
             (store! (stack-top) (primitive/cast i64 top))
             (loop (if (>= (load i) CRASH_STACK_SIZE)
                       (break)
                       (do
                         (store! (primitive/index config (load i)) (primitive/cast i8 0))
                         (store! i (+ (load i) 1)))))
             (store! (primitive/cast (ptr (ptr i8))
                                     (primitive/index config CRASH_STACK_SP_OFFSET))
                     (primitive/cast (ptr i8) (alt-stack)))
             (store! (primitive/cast (ptr i64)
                                     (primitive/index config CRASH_STACK_SIZE_OFFSET))
                     65536)
             (store! (primitive/cast (ptr i32)
                                     (primitive/index config CRASH_STACK_FLAGS_OFFSET))
                     0)
             (primitive/cast i64
                             (sigaltstack (primitive/cast (ptr i8) config)
                                          (primitive/cast (ptr i8) 0)))))

         (defn ~(explicit-public-name `install-one) [(number i32)] (-> i64)
           (let [action (primitive/alloc-stack (array i8 256))
                 (mut i) 0]
             (loop (if (>= (load i) CRASH_SIGACTION_SIZE)
                       (break)
                       (do
                         (store! (primitive/index action (load i)) (primitive/cast i8 0))
                         (store! i (+ (load i) 1)))))
             (store! (primitive/cast (ptr (ptr i8)) action)
                     (primitive/cast (ptr i8) (primitive/fnptr-of handler)))
             (sigemptyset (primitive/index (primitive/cast (ptr i8) action)
                                           CRASH_SA_MASK_OFFSET))
             (store! (primitive/cast (ptr i32)
                                     (primitive/index (primitive/cast (ptr i8) action)
                                                      CRASH_SA_FLAGS_OFFSET))
                     (primitive/cast i32 (+ CRASH_SA_SIGINFO CRASH_SA_ONSTACK)))
             (primitive/cast i64
                             (sigaction number
                                        (primitive/cast (ptr i8) action)
                                        (primitive/cast (ptr i8) 0)))))

         ;;; Install fatal-signal diagnostics for memory, illegal-instruction, arithmetic,
         ;;; and explicit-abort failures. Returns zero when every disposition was installed.
         (defn ~(explicit-public-name `install!) [] (-> i64)
           (store! (artifact-fd) -1)
           (install-alt-stack)
           (let [path (getenv c"COIL_CRASH_REPORT")]
             (when (!= (primitive/cast i64 path) 0)
               (install-artifact! path)
               (artifact-header)
               0))
           (when (= (load (event-capacity)) 0)
             (store! (event-capacity) 64)
             0)
           (+ (install-one (primitive/cast i32 CRASH_SIGSEGV))
              (+ (install-one (primitive/cast i32 CRASH_SIGBUS))
                 (+ (install-one (primitive/cast i32 CRASH_SIGILL))
                    (+ (install-one (primitive/cast i32 CRASH_SIGABRT))
                       (install-one (primitive/cast i32 CRASH_SIGFPE)))))))

         ;;; Install diagnostics for memory faults only, a segmentation fault or bus error,
         ;;; on an alternate stack. A stack overflow faults with no stack left to report on,
         ;;; which is why the stack is separate. `SIGABRT` is left alone: a program that
         ;;; aborts on purpose has already said why. Returns zero when both were installed.
         (defn ~(explicit-public-name `install-memory-faults!) [] (-> i64)
           (store! (artifact-fd) -1)
           (install-alt-stack)
           (when (= (load (event-capacity)) 0)
             (store! (event-capacity) 64)
             0)
           (+ (install-one (primitive/cast i32 CRASH_SIGSEGV))
              (install-one (primitive/cast i32 CRASH_SIGBUS)))))))

(meta (fault-machinery))

;;; Open a predeclared crash artifact before faults occur. The handler only writes
;;; to this already-open descriptor. Bare metal has no files to open one in.
(defn artifact-opener [] (-> Code)
  (if (fail/freestanding?)
      `(defn ~(explicit-public-name `install-artifact!) [(path (ptr i8))] (-> i64)
         (panic "coil.crash: a bare-metal target has no files to write a crash artifact to"))
      `(defn ~(explicit-public-name `install-artifact!) [(path (ptr i8))] (-> i64)
         (let [old (load (artifact-fd))]
           (when (> old 2) (close old) 0)
           ; O_WRONLY | O_CREAT | O_TRUNC, mode 0600 — folded for the TARGET, because
           ; these numbers differ per OS. The literal 1537 that used to be here was the
           ; darwin spelling; on Linux it means O_WRONLY|O_TRUNC|0x400 with no O_CREAT,
           ; so the artifact was silently never created and COIL_CRASH_REPORT did
           ; nothing. Same class of bug as fs.coil's open flags, and the same fix.
           (let [fd
                   (open path
                         (primitive/ior CRASH_O_WRONLY
                                        (primitive/ior CRASH_O_CREAT CRASH_O_TRUNC))
                         384)]
             (store! (artifact-fd) fd)
             (primitive/cast i64 fd))))))

(meta (artifact-opener))

(defn set-event-capacity! [(capacity i64)] (-> i64)
  (store! (event-capacity)
          (if (< capacity 0) 0 (if (> capacity 64) 64 capacity)))
  0)

;;; Record a bounded recent event without allocating. Events are truncated to 63
;;; bytes and kept in a fixed 64-entry ring for post-crash context.
(defn event! [(event (slice u8))] (-> i64)
  (let [capacity (load (event-capacity))]
    (when (> capacity 0)
      (let [next (load (event-next))
            slot (primitive/urem next capacity)
            n (if (> (len event) 63) 63 (len event))
            dst
              (primitive/index (primitive/cast (ptr i8) (events))
                               (* slot 64))
            (mut i) 0]
        (loop (if (>= (load i) n)
                  (break)
                  (do
                    (store! (primitive/index dst (load i))
                            (primitive/cast i8
                                            (load (primitive/index (data event)
                                                                   (load i)))))
                    (store! i (+ (load i) 1)))))
        (store! (primitive/index (event-lengths) slot)
                (primitive/cast i8 n))
        (store! (event-next) (+ next 1))))
    0))
