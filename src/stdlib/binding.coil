(module coil.binding)
(import "coil.primitive" :as primitive)

; This module is below the public binding layer. Keep its executable code in
; primitive forms so loading a binding macro never requires invoking itself.
(defn* binding-append! [(out CodeBuilder) (value Code)] (-> i64)
  (primitive/code-list-push! out value)
  0)

(defn* binding-is? [(value Code) (symbol Code)] (-> bool)
  (primitive/code-eq value symbol))

(defn* binding-count [(value Code)] (-> i64)
  (if (or (primitive/code-list? value) (primitive/code-vector? value))
      (primitive/code-count value)
      0))

(defn* binding-as? [(pattern Code)] (-> bool)
  (and (primitive/code-list? pattern)
       (and (primitive/icmp-gt (binding-count pattern) 0)
            (binding-is? (primitive/code-nth pattern 0) `as))))

(defn* binding-mut? [(pattern Code)] (-> bool)
  (and (primitive/code-list? pattern)
       (and (primitive/icmp-eq (binding-count pattern) 2)
            (binding-is? (primitive/code-nth pattern 0) `mut))))

(defn* binding-vector-as? [(pattern Code)] (-> bool)
  (and (primitive/code-vector? pattern)
       (and (primitive/icmp-ge (binding-count pattern) 2)
            (binding-is? (primitive/code-nth pattern
                                             (primitive/isub (binding-count pattern)
                                                             2))
                         `:as))))

(defn* binding-whole-name [(pattern Code)] (-> Code)
  (if (binding-as? pattern)
      (if (primitive/icmp-eq (binding-count pattern) 3)
          (primitive/code-nth pattern 1)
          (primitive/error "binding: expected (as name pattern)"))
      (if (binding-vector-as? pattern)
          (primitive/code-nth pattern
                              (primitive/isub (binding-count pattern) 1))
          (primitive/fresh-identifier "pattern"))))

(defn* binding-strip-as [(pattern Code)] (-> Code)
  (if (binding-as? pattern)
      (let* [inner (primitive/code-nth pattern 2)]
        (if (or (binding-as? inner) (binding-vector-as? inner))
            (primitive/error "binding: repeated whole-value name")
            inner))
      (if (binding-vector-as? pattern)
          (primitive/code-list-like pattern
                                    `[~@(primitive/code-slice pattern
                                                              0
                                                              (primitive/isub (binding-count pattern)
                                                                              2))])
          pattern)))

(defn* binding-name! [(names CodeBuilder) (name Code)] (-> i64)
  (if (and (primitive/code-sym? name)
           (and (not (binding-is? name `_))
                (and (not (binding-is? name `&)) (not (binding-is? name `...)))))
      (do (binding-append! names name) 0)
      (primitive/error "binding: expected an identifier for the whole-value name")))

(defn* binding-pair! [(out CodeBuilder) (name Code) (value Code)] (-> i64)
  (binding-append! out name)
  (binding-append! out value)
  0)

(defn* binding-check-names [(names Code)] (-> i64)
  (let* [(mut i) 0]
    (loop (if (primitive/icmp-ge (primitive/load i) (binding-count names))
              (break)
              (let* [(mut j) (primitive/iadd (primitive/load i) 1)]
                (loop (if (primitive/icmp-ge (primitive/load j)
                                             (binding-count names))
                          (break)
                          (do
                            (if (primitive/bound-identifier=? (primitive/code-nth names
                                                                                  (primitive/load i))
                                                              (primitive/code-nth names
                                                                                  (primitive/load j)))
                                (primitive/error "binding: duplicate identifier in pattern")
                                0)
                            (primitive/store! j
                                              (primitive/iadd (primitive/load j)
                                                              1)))))
                (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
    0))

(defn* binding-sequence! [(out CodeBuilder)
                          (names CodeBuilder)
                          (pattern Code)
                          (root Code)] (-> i64)
  (let* [count (binding-count pattern)
         (mut prefix) 0
         (mut rest-index) -1]
    (loop (if (primitive/icmp-ge (primitive/load prefix) count)
              (break)
              (let* [child (primitive/code-nth pattern (primitive/load prefix))]
                (if (binding-is? child `&)
                    (do
                      (if (primitive/icmp-ne (primitive/iadd (primitive/load prefix)
                                                             2)
                                             count)
                          (primitive/error "binding: & must be followed by one final suffix pattern")
                          0)
                      (primitive/store! rest-index
                                        (primitive/iadd (primitive/load prefix)
                                                        1))
                      (break))
                    (if (primitive/code-keyword? child)
                        (primitive/error "binding: misplaced keyword in sequence pattern")
                        (primitive/store! prefix
                                          (primitive/iadd (primitive/load prefix)
                                                          1)))))))
    (binding-pair! out
                   (primitive/fresh-identifier "pattern-check")
                   `(primitive/pattern-prefix ~root ~(primitive/load prefix)))
    (let* [(mut i) 0]
      (loop (if (primitive/icmp-ge (primitive/load i) (primitive/load prefix))
                (break)
                (do
                  (if (binding-is? (primitive/code-nth pattern
                                                       (primitive/load i))
                                   `_)
                      0
                      (binding-emit! out
                                     names
                                     (primitive/code-nth pattern
                                                         (primitive/load i))
                                     `(primitive/pattern-nth ~root
                                                             ~(primitive/load i))))
                  (primitive/store! i (primitive/iadd (primitive/load i) 1))))))
    (if (primitive/icmp-ge (primitive/load rest-index) 0)
        (let* [suffix (primitive/code-nth pattern (primitive/load rest-index))]
          (if (binding-is? suffix `_)
              0
              (binding-emit! out
                             names
                             suffix
                             `(primitive/pattern-rest ~root
                                                      ~(primitive/load prefix)))))
        0)
    0))

(defn* binding-struct! [(out CodeBuilder)
                        (names CodeBuilder)
                        (pattern Code)
                        (root Code)] (-> i64)
  (let* [count (binding-count pattern)]
    (if (or (primitive/icmp-eq count 0)
            (primitive/icmp-ne (primitive/urem count 2) 1))
        (primitive/error "binding: expected (Type :field pattern ...) constructor pattern")
        0)
    (let* [type (primitive/code-nth pattern 0)
           (mut i) 1]
      (binding-pair! out
                     (primitive/fresh-identifier "pattern-type")
                     `(primitive/pattern-view ~type ~root))
      (loop (if (primitive/icmp-ge (primitive/load i) count)
                (break)
                (let* [field (primitive/code-nth pattern (primitive/load i))
                       (mut j) 1]
                  (if (not (primitive/code-keyword? field))
                      (primitive/error "binding: constructor fields must be named with keywords")
                      0)
                  (loop (if (primitive/icmp-ge (primitive/load j)
                                               (primitive/load i))
                            (break)
                            (do
                              (if (binding-is? field
                                               (primitive/code-nth pattern
                                                                   (primitive/load j)))
                                  (primitive/error "binding: duplicate constructor field")
                                  0)
                              (primitive/store! j
                                                (primitive/iadd (primitive/load j)
                                                                2)))))
                  (let* [child
                           (primitive/code-nth pattern
                                               (primitive/iadd (primitive/load i)
                                                               1))
                         projection
                           `(~(primitive/code-symbol "."
                                                     (primitive/code-keyword-name field)) ~root)]
                    (binding-emit! out
                                   names
                                   child
                                   `(primitive/pattern-project ~projection
                                                               ~(if (binding-is? child
                                                                                 `_)
                                                                    1
                                                                    0))))
                  (primitive/store! i (primitive/iadd (primitive/load i) 2))))))
    0))

(defn* binding-project! [(out CodeBuilder)
                         (names CodeBuilder)
                         (pattern Code)
                         (root Code)] (-> i64)
  (if (primitive/code-vector? pattern)
      (binding-sequence! out names pattern root)
      (if (binding-mut? pattern)
          (primitive/error "binding: mutable pattern leaves are not supported; bind an explicit mutable place")
          (if (primitive/code-list? pattern)
              (binding-struct! out names pattern root)
              (if (primitive/code-sym? pattern)
                  (if (binding-is? pattern `_)
                      0
                      (do
                        (binding-name! names pattern)
                        (binding-pair! out pattern root)))
                  (primitive/error "binding: expected an identifier, sequence, or constructor pattern"))))))

(defn* binding-emit! [(out CodeBuilder)
                      (names CodeBuilder)
                      (pattern Code)
                      (value Code)] (-> i64)
  (if (primitive/code-sym? pattern)
      (if (binding-is? pattern `_)
          (binding-pair! out (primitive/fresh-identifier "ignored") value)
          (do (binding-name! names pattern) (binding-pair! out pattern value)))
      (let* [root (binding-whole-name pattern)
             inner (binding-strip-as pattern)]
        (if (or (binding-as? pattern) (binding-vector-as? pattern))
            (binding-name! names root)
            0)
        (binding-pair! out root value)
        (binding-project! out names inner root))))

;;; Expand sequential binding pairs to primitive name/value pairs. Source
;;; identifiers are retained; generated identifiers are fresh syntax objects.
(defn* destructure [(bindings Code)] (-> Code)
  (if (or (not (primitive/code-vector? bindings))
          (primitive/icmp-ne (primitive/urem (binding-count bindings) 2) 0))
      (primitive/error "let: expected a vector of pattern/value pairs")
      (let* [out (primitive/code-list-new)
             (mut i) 0]
        (loop (if (primitive/icmp-ge (primitive/load i)
                                     (binding-count bindings))
                  (break)
                  (let* [pattern
                           (primitive/code-nth bindings (primitive/load i))
                         value
                           (primitive/code-nth bindings
                                               (primitive/iadd (primitive/load i)
                                                               1))
                         names (primitive/code-list-new)]
                    (if (binding-mut? pattern)
                        (binding-pair! out pattern value)
                        (binding-emit! out names pattern value))
                    (binding-check-names (primitive/code-list-done names))
                    (primitive/store! i (primitive/iadd (primitive/load i) 2)))))
        (primitive/code-list-like bindings `[~@(primitive/code-list-done out)]))))

;;; Sequential local bindings with positional and constructor patterns.
(defn* let [(bindings Code) & (body Code)] (-> Code)
  `(let* ~(destructure bindings) ~@body))

; Parameter normalization is shared by named/anonymous functions and generators.
; It returns [primitive-parameters primitive-prologue] as syntax data.
(defn* normalize-parameters [(params Code) (typed bool)] (-> Code)
  (if (not (primitive/code-vector? params))
      (primitive/error "function: expected parameter vector")
      (let* [ps (primitive/code-list-new)
             prologue (primitive/code-list-new)
             names (primitive/code-list-new)
             (mut i) 0]
        (loop (if (primitive/icmp-ge (primitive/load i) (binding-count params))
                  (break)
                  (let* [entry (primitive/code-nth params (primitive/load i))]
                    (if (and typed
                             (or (binding-is? entry `&)
                                 (binding-is? entry `...)))
                        (binding-append! ps entry)
                        (let* [pattern
                                 (if typed
                                     (if (and (primitive/code-list? entry)
                                              (primitive/icmp-eq (binding-count entry)
                                                                 2))
                                         (primitive/code-nth entry 0)
                                         (if (and (primitive/code-list? entry)
                                                  (and (primitive/icmp-eq (binding-count entry)
                                                                          3)
                                                       (binding-is? (primitive/code-nth entry
                                                                                        0)
                                                                    `:positional)))
                                             (primitive/code-nth entry 1)
                                             (primitive/error "defn: expected (pattern Type) parameter")))
                                     entry)]
                          (if (primitive/code-sym? pattern)
                              (if (binding-is? pattern `_)
                                  (let* [ignored
                                           (primitive/fresh-identifier "ignored")]
                                    (binding-append! ps
                                                     (if typed
                                                         `(:positional ~ignored
                                                                       ~(primitive/code-nth entry
                                                                                            1))
                                                         ignored)))
                                  (do
                                    (binding-name! names pattern)
                                    (binding-append! ps entry)))
                              (let* [root (binding-whole-name pattern)
                                     inner (binding-strip-as pattern)]
                                (if (or (binding-as? pattern)
                                        (binding-vector-as? pattern))
                                    (binding-name! names root)
                                    0)
                                (binding-append! ps
                                                 (if typed
                                                     (if (or (binding-as? pattern)
                                                             (binding-vector-as? pattern))
                                                         `(~root ~(primitive/code-nth entry
                                                                                      1))
                                                         `(:positional ~root
                                                                       ~(primitive/code-nth entry
                                                                                            1)))
                                                     root))
                                (binding-project! prologue names inner root)))))
                    (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
        (binding-check-names (primitive/code-list-done names))
        `[~(primitive/code-list-like params `[~@(primitive/code-list-done ps)])
          [~@(primitive/code-list-done prologue)]])))

;;; Anonymous function; contextual typing and the non-capture rule are unchanged.
(defn* fn [(params Code) & (body Code)] (-> Code)
  (let* [normalized (normalize-parameters params false)
         bindings (primitive/code-nth normalized 1)]
    (if (primitive/icmp-eq (binding-count bindings) 0)
        `(fn* ~(primitive/code-nth normalized 0) ~@body)
        `(fn* ~(primitive/code-nth normalized 0) (let* ~bindings ~@body)))))

;;; Named declaration with the existing annotations, generics and return syntax.
(defn* normalize-declaration [(name Code) (declaration Code)] (-> Code)
  (let* [out (primitive/code-list-new)
         count (binding-count declaration)
         (mut i) 0]
    (loop (if (primitive/icmp-ge (primitive/load i) count)
              (primitive/error "defn: missing parameter vector")
              (if (primitive/code-keyword? (primitive/code-nth declaration
                                                               (primitive/load i)))
                  (primitive/store! i (primitive/iadd (primitive/load i) 2))
                  (break))))
    (if (and (primitive/icmp-lt (primitive/iadd (primitive/load i) 1) count)
             (primitive/code-vector? (primitive/code-nth declaration
                                                         (primitive/iadd (primitive/load i)
                                                                         1))))
        (primitive/store! i (primitive/iadd (primitive/load i) 1))
        0)
    (let* [pi (primitive/load i)
           normalized
             (normalize-parameters (primitive/code-nth declaration pi) true)
           bindings (primitive/code-nth normalized 1)
           body-start (primitive/iadd pi 2)]
      (if (primitive/icmp-ge (primitive/iadd pi 1) count)
          (primitive/error "defn: missing return annotation")
          0)
      (binding-append! out `defn*)
      (binding-append! out name)
      (primitive/store! i 0)
      (loop (if (primitive/icmp-ge (primitive/load i) pi)
                (break)
                (do
                  (binding-append! out
                                   (primitive/code-nth declaration
                                                       (primitive/load i)))
                  (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
      (binding-append! out (primitive/code-nth normalized 0))
      (binding-append! out
                       (primitive/code-nth declaration (primitive/iadd pi 1)))
      (if (primitive/icmp-eq (binding-count bindings) 0)
          (do
            (primitive/store! i body-start)
            (loop (if (primitive/icmp-ge (primitive/load i) count)
                      (break)
                      (do
                        (binding-append! out
                                         (primitive/code-nth declaration
                                                             (primitive/load i)))
                        (primitive/store! i
                                          (primitive/iadd (primitive/load i) 1))))))
          (binding-append! out
                           `(let* ~bindings
                              ~@(primitive/code-slice declaration
                                                      body-start
                                                      count))))
      (primitive/code-list-done out))))

(defn* defn [(name Code) & (declaration Code)] (-> Code)
  (normalize-declaration name declaration))

; The compiler wraps impl members in this ordinary core normalizer. The returned
; primitive declaration lets the expander apply ordinary parameter scope rules.
(defn* normalize-method [(method Code)] (-> Code)
  (normalize-declaration (primitive/code-nth method 0)
                         (primitive/code-rest method)))
