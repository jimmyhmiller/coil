(module coil.slice)
(import "coil.primitive" :as primitive)
(import "coil.alloc" :as alloc)

; A `(slice T)` is a fat pointer `{ data: (ptr T), len: i64 }` over contiguous
; elements — the everyday view into an array/buffer, and the representation of a
; string (`(slice u8)`). The fat-pointer TYPE is the one piece of core support
; slices need; every operation here is a LIBRARY over `(primitive/llvm-ir …)`, exactly as
; src/stdlib/simd.coil builds SIMD over the core `(vec T N)` type.
;
;   (let [s (slice::new p 3)]          ; or any array, which borrows as a slice
;     (set! s 0 7) (for x s …) (subslice s 1 3))
;
; `len` and `get` are the collection traits; `(data s)`, `(set! s i v)` and
; `slice::new` are methods of the slice type, which is built in, so they need no
; import. Slices ALIAS their backing storage: `set!` writes through to the
; original, and a `subslice` shares the same memory. A slice is a small value (two
; words), so it is passed/returned BY VALUE, and writing through it needs no
; mutable place.
;
; Bounds checking is the `--debug-checks` build mode (mem-6): `get`, `set!` and
; `subslice` verify their indices (and reject a `lo > hi` subslice, which used to
; yield a slice reporting length -2) ONLY when the build requested it. The check
; lives in a MACRO branched on `(primitive/debug-checks?)` at expansion time, so with
; the flag off the op expands to the exact unchecked form — genuinely zero-cost,
; byte-identical IR. `write`/`abort` are module-private (see the `export` list) so
; they never collide with io/main's own decls via `:use *`.

; Only the public API is exported — the debug panic's `write`/`abort` externs stay
; private (they would otherwise be ambiguous where a `:use *` importer of slice also
; declares them, e.g. io.coil's `write`, main.coil's `abort`).
(export subslice sort SliceIter)

(import "coil.control" :use *)  ; `for` and its loop/break lowering
(import "coil.fail" :as fail)

; `(primitive/debug-checks?)` is a comptime code op (the --debug-checks predicate, mem-6) — a
; builtin like `target-arch`/`gensym`, so it needs no import.

; ---- debug-mode bounds-check panic (mem-6), only emitted under --debug-checks ----
;;; `write` is the libc write(2); it is ALREADY declared globally (io.coil), so slice
;;; naming it adds no new declaration — the off-path stays byte-identical. `abort` is
;;; NOT declared here on purpose: an unreferenced module-level extern decl leaks a
;;; `declare` into programs that never trip a check, so the failure stops at
;;; `coil.fail`'s trap instead, which needs no symbol at all.
(extern write :cc c [i32 (ptr i8) isize] (-> isize))  ; ssize_t write(int fd, const void*, size_t)

;;; Report an out-of-bounds slice access and stop at a trap. The message goes to
;;; stderr, or with no OS to the `coil.fail` handler. (A store through null used to
;;; stand in for the trap. LLVM reads that as undefined behavior, so whether
;;; anything stopped the program was up to the optimizer and the target.)
;;; GENERIC (T inferred from the offending slice): a generic function is emitted only
;;; when instantiated, so with --debug-checks OFF nothing calls it, it is never
;;; instantiated, and NOT one byte of it reaches the output — the guard is genuinely
;;; zero-cost, and the off-path IR is byte-identical to the unchecked form.
(defn oob-fail! [T] [(s (slice T)) (msg (slice u8))] (-> i64)
  (fail/freestanding-or
    (fail/fail! msg "coil.slice")
    (do
      (write 2
             (primitive/cast (ptr i8) (data msg))
             (primitive/cast isize (len msg)))
      (fail/trap!)))
  0)

;;; The three guards are macros so `(primitive/debug-checks?)` is read at EXPANSION time: with the
;;; flag off each expands to the ORIGINAL unchecked expression (byte-identical), with it
;;; on it prefixes the bounds test. `s`/`i`/`lo`/`hi` arrive as already-evaluated param
;;; symbols, so referencing them twice is side-effect-free; `~s` also fixes the panic's T.
(defn dbg-get [(s Code) (i Code)] (-> Code)
  (if (primitive/debug-checks?)
      `(do
         (if (or (< (len ~s) 0)
                 (or (and (> (len ~s) 0)
                          (= (primitive/cast i64 (data ~s)) 0))
                     (or (< ~i 0) (>= ~i (len ~s)))))
             (do
               (oob-fail! ~s
                          "coil: invalid slice header or slice index out of bounds in get (--debug-checks)\n")
               0)
             0)
         (load (primitive/index (data ~s) ~i)))
      `(load (primitive/index (data ~s) ~i))))

(defn dbg-set [(s Code) (i Code) (v Code)] (-> Code)
  (if (primitive/debug-checks?)
      `(do
         (if (or (< ~i 0) (>= ~i (len ~s)))
             (do
               (oob-fail! ~s
                          "coil: slice index out of bounds in set! (--debug-checks)\n")
               0)
             0)
         (store! (primitive/index (data ~s) ~i) ~v)
         0)
      `(do
         (store! (primitive/index (data ~s) ~i) ~v)
         0)))

;;; A subslice's lo/hi must satisfy 0 <= lo <= hi <= len — the `lo > hi` case is the
;;; mem-6 invariant break (length hi-lo went negative). Checked here under the flag.
(defn dbg-subslice [(s Code) (lo Code) (hi Code)] (-> Code)
  (if (primitive/debug-checks?)
      `(do
         (if (or (< ~lo 0) (or (> ~hi (len ~s)) (> ~lo ~hi)))
             (do
               (oob-fail! ~s
                          "coil: subslice out of range or lo>hi (--debug-checks)\n")
               0)
             0)
         (slice::new (primitive/index (data ~s) ~lo)
                     (primitive/isub ~hi ~lo)))
      `(slice::new (primitive/index (data ~s) ~lo)
                   (primitive/isub ~hi ~lo))))

(defn dbg-new-check [(base Code) (count Code)] (-> Code)
  (if (primitive/debug-checks?)
      `(if (or (< ~count 0)
               (and (> ~count 0) (= (primitive/cast i64 ~base) 0)))
           (do (alloc/debug-fail-at c"invalid slice header") 0)
           0)
      `0))

(impl [T] (slice T)
  ;;; Construct a slice from a base element pointer and length.
  (new [(base (ptr T)) (count i64)] (-> (slice T))
    (dbg-new-check base count)
    (primitive/llvm-ir (slice T)
                       [base count]
                       "%s0 = insertvalue $ret undef, $t0 $0, 0
%s1 = insertvalue $ret %s0, $t1 $1, 1
ret $ret %s1"))

  ;;; The base element pointer (primitive/field 0).
  (data [(s (slice T))] (-> (ptr T))
    (primitive/llvm-ir (ptr T) [s] "%d = extractvalue $t0 $0, 0
ret $ret %d"))

  ;;; Write element i through the view. A slice borrows its elements, so this takes
  ;;; the slice by value, and a direct `(set! s i v)` needs no mutable place; the
  ;;; `Set` impl below serves code generic over `Set`. Bounds-checked only under
  ;;; --debug-checks (mem-6).
  (set! [(s (slice T)) (i i64) (v T)] (-> i64)
    (dbg-set s i v)))

;;; `subslice s lo hi` → the half-open view `[lo, hi)`, sharing storage. Under
;;; --debug-checks, rejects lo<0 / hi>len / lo>hi (the mem-6 length-(-2) invariant break).
(defn subslice [T] [(s (slice T)) (lo i64) (hi i64)] (-> (slice T))
  (dbg-subslice s lo hi))

;;; `(sort s cmp)` — sort the slice IN PLACE (writing through to its backing storage)
;;; using the comparator `cmp : (fnptr c [T T] i64)` (negative ⇒ a before b, 0 ⇒ equal,
;;; positive ⇒ a after b — the `cmp`/`isub` convention). A stable insertion sort:
;;; simple and correct, the everyday sort for the small-to-moderate slices Coil programs
;;; hold; a caller needing n·log n can write it over the same `get`/`set!`.
;;; `cmp` is a plain function taken with `(primitive/fnptr-of my-cmp)`.
(defn sort [T] [(s (slice T)) (cmp (fnptr c [T T] i64))] (-> i64)
  (let [n (len s)
        (mut i) 1]
    (loop (if (>= (load i) n)
              (break)
              (let [key (get s (load i))
                    (mut j) (primitive/isub (load i) 1)]
                (loop (if (and (>= (load j) (cast i64 0))
                               (> (primitive/call-ptr cmp
                                                      (get s (load j))
                                                      key)
                                  (cast i64 0)))
                          (do
                            (set! s
                                  (primitive/iadd (load j) 1)
                                  (get s (load j)))
                            (set! j (primitive/isub (load j) 1)))
                          (break)))
                (set! s (primitive/iadd (load j) 1) key)
                (set! i (primitive/iadd (load i) 1)))))
    0))

; ---- the core collection traits (coil.core) ---------------------------------
; `(len s)` / `(get s i)` on any (slice T) — including strings, which are
; (slice u8). Bounds-checked only under --debug-checks (mem-6); off, the guard
; macro expands to the exact unchecked load/store (zero-cost, byte-identical).
; Set's receiver is the trait's `(mut Self)`, which a direct call never reaches:
; the slice's own `set!` above takes the view by value. No Push/Pop: a slice
; can't grow.
(impl [T] Len (slice T)
  ;;; The element count (primitive/field 1).
  (len [(s (slice T))] (-> i64)
    (primitive/llvm-ir i64 [s] "%l = extractvalue $t0 $0, 1
ret $ret %l")))

(impl [T] Get (slice T)
  (get [(s (slice T)) (i i64)] (-> T) (dbg-get s i)))

(impl [T] Set (slice T)
  (set! [(s (mut (slice T))) (i i64) (v T)] (-> i64) (dbg-set (load s) i v)))

;;; Two slices are equal when they have the same length and their elements are
;;; pairwise `=`. Strings keep their byte-comparing impl in coil.str, which is more
;;; specific and agrees with this one.
(impl [(T Eq)] Eq (slice T)
  (= [(a (slice T)) (b (slice T))] (-> bool)
     (let [n (len a)]
       (and (= n (len b))
            (block :compare
              (for i (range 0 n)
                (when (not (= (get a i) (get b i)))
                  (return-from :compare false)))
              true)))))

; ---- iteration (coil.core Iterator/Iterable) --------------------------------
;;; A slice's iterator is a `(SliceIter T)` — the slice plus a cursor. `iter` mints
;;; one; `next` yields each element and advances the cursor (`Item = T`). This is the
;;; iterator ArrayList reuses (over its `slice`) and the one `(for x s)` drives.
;;; Option/Some/None are coil.core (auto-loaded), so no result.coil import is needed.
(defstruct SliceIter [T] [(s (slice T)) (pos i64)])

(impl [T] Iterable (slice T)
  (iter [(s (slice T))]
        (-> (SliceIter T))
        (let [it (primitive/alloc-stack (SliceIter T))]
          (set! (.s it) s)
          (set! (.pos it) 0)
          (load it))))

(impl [T] Iterator (SliceIter T)
  (next [(it (mut (SliceIter T)))]
        (-> (Option T))
        (let [p (.pos it)]
          (if (< p (len (.s it)))
              (do
                (set! (.pos it) (primitive/iadd p 1))
                (Some (get (.s it) p)))
              (None)))))
