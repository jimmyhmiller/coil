(module coil.arc.auto-runtime)
(import "coil.primitive" :as primitive)
(import "coil.alloc" :as alloc)
(import "coil.arc" :as arc)
(import "coil.arraylist" :as list)
(import "coil.result" :use *)

; Runtime representation used only after the transparent surface transform. User
; source continues to spell `(ArrayList T)` and the ordinary `al-*` operations.
(defstruct AutoArrayListPayload [T]
  [(inner (list/ArrayList T))])

(defstruct AutoArrayList [T]
  [(owner (arc/Arc (AutoArrayListPayload T)))])

; Provisional type used only between the transparent surface pass and ownership
; lowering. The authoritative pass replaces every constructor/upgrade operation
; with the source type's generated weak companion, so this representation never
; reaches code generation in a valid transformed program.
(defstruct AutoWeakPreview [T] [(marker i64)])

(impl [T] Clone (AutoWeakPreview T)
  (clone [(self (ref (AutoWeakPreview T)))]
         (-> (AutoWeakPreview T))
         (AutoWeakPreview :marker (field self marker))))

(defn auto-weak-preview [T] [(value (ref T))] (-> (AutoWeakPreview T))
  (AutoWeakPreview :marker 0))

(defn auto-weak-upgrade-preview [T] [(value (ref (AutoWeakPreview T)))] (-> (Option T))
  (None [T]))

; Common allocation primitive for wrappers synthesized around ordinary user
; aggregates.  The generated wrapper retains the source type's public name;
; only its hidden payload and Arc owner mention this runtime API.
(defn auto-object-live-cell [] (-> (ptr i64))
  (primitive/alloc-static i64))

(defn auto-object-live-count [] (-> i64)
  (load (auto-object-live-cell)))

(defn auto-object-live-inc! [] (-> i64)
  (do
    (store! (auto-object-live-cell)
            (primitive/iadd (load (auto-object-live-cell)) 1))
    0))

(defn auto-object-live-dec! [] (-> i64)
  (do
    (store! (auto-object-live-cell)
            (primitive/isub (load (auto-object-live-cell)) 1))
    0))

; Macro-generated aggregates are introduced after the ownership transform's
; declaration walk. Embed this token in those aggregates so ordinary recursive
; drop glue performs the same final-object accounting as synthesized payload
; Drop implementations.
(defstruct AutoObjectToken [(marker u8)])

(impl Drop AutoObjectToken
  (drop [(self (mut AutoObjectToken))]
        (-> void)
        (forget (auto-object-live-dec!))))

(defn auto-object-token [] (-> AutoObjectToken)
  (AutoObjectToken :marker 0))

(defn auto-new-owner [T] [(value T)] (-> (arc/Arc T))
  (match (arc/arc-new-in (alloc/malloc-allocator-lease) value)
    (Some [owner] (do (auto-object-live-inc!) owner))
    (None [] (do (alloc/abort) (primitive/zeroed (arc/Arc T))))))

(defn auto-arraylist-live-cell [] (-> (ptr i64))
  (primitive/alloc-static i64))

(defn auto-arraylist-live-count [] (-> i64)
  (load (auto-arraylist-live-cell)))

(impl [T] Drop (AutoArrayListPayload T)
  (drop [(self (mut (AutoArrayListPayload T)))]
        (-> void)
        (forget [i64] (list/al-free! [T] (mut (field self inner))))
        (store! (auto-arraylist-live-cell)
                (primitive/isub (load (auto-arraylist-live-cell)) 1))))

(impl [T] Clone (AutoArrayList T)
  (clone [(self (ref (AutoArrayList T)))]
         (-> (AutoArrayList T))
         (AutoArrayList :owner (clone (field self owner)))))

(impl [T] Drop (AutoArrayList T)
  (drop [(self (mut (AutoArrayList T)))]
        (-> void)
        (let [owner (take! [(arc/Arc (AutoArrayListPayload T))] (mut (field self owner)))]
          0)))

(defn auto-al-new [T] [] (-> (AutoArrayList T))
  (let [payload
          (AutoArrayListPayload :inner (list/al-new [T] (alloc/malloc-allocator)))]
    (match (arc/arc-new-in (alloc/malloc-allocator-lease) payload)
      (Some [owner]
            (do
              (store! (auto-arraylist-live-cell)
                      (primitive/iadd (load (auto-arraylist-live-cell)) 1))
              (AutoArrayList :owner owner)))
      (None [] (do (alloc/abort) (primitive/zeroed (AutoArrayList T)))))))

(defn auto-al-push! [T] [(owner (mut (AutoArrayList T))) (value T)] (-> i64)
  (let [payload (arc/arc-borrow [(AutoArrayListPayload T)] (field owner owner))]
    (list/al-push! [T] (field payload inner) value)))

(defn auto-al-get [T] [(owner (ref (AutoArrayList T))) (index i64)] (-> T)
  (let [payload (arc/arc-borrow [(AutoArrayListPayload T)] (field owner owner))]
    (list/al-get [T] (field payload inner) index)))

(defn auto-al-len [T] [(owner (ref (AutoArrayList T)))] (-> i64)
  (let [payload (arc/arc-borrow [(AutoArrayListPayload T)] (field owner owner))]
    (list/al-len [T] (field payload inner))))
