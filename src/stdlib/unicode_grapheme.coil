(module coil.unicode.grapheme)
(import "coil.primitive" :as primitive)
(import "coil.slice" :use [slice-get])
(import "coil.str" :as string :use [StringView Text Rune StringIndex])
(import "coil.unicode.grapheme-data" :as data)

; Unicode 17 extended grapheme clusters (UAX #29). This module is separate from
; coil.str so byte/scalar-only programs do not pull Unicode property tables into
; their reachable program.
(defstruct Char [(text StringView)])

(defstruct Chars [(text StringView)])

(defstruct CharIter [(text StringView) (offset i64)])

(defn char-view [(char Char)] (-> StringView)
  (.text char))

(defn chars [(text StringView)] (-> Chars)
  (Chars :text text))

; Grapheme_Cluster_Break property codes generated in grapheme-data.
(defn gcb-control? [(property i64)] (-> bool)
  (or (= property (cast i64 1))
      (or (= property (cast i64 2)) (= property (cast i64 3)))))

(defn grapheme-no-break? [(previous i64)
                          (current i64)
                          (ri_count i64)
                          (zwj_after_ep bool)
                          (incb_active bool)
                          (incb_linker bool)
                          (current_ep bool)
                          (current_incb i64)] (-> bool)
  (cond ; GB3
        (and (= previous (cast i64 1)) (= current (cast i64 2))) true
        ; GB4 / GB5
        (or (gcb-control? previous) (gcb-control? current)) false
        ; GB6
        (and (= previous (cast i64 9))
             (or (= current (cast i64 9))
                 (or (= current (cast i64 10))
                     (or (= current (cast i64 12)) (= current (cast i64 13))))))
          true
        ; GB7
        (and (or (= previous (cast i64 12)) (= previous (cast i64 10)))
             (or (= current (cast i64 10)) (= current (cast i64 11))))
          true
        ; GB8
        (and (or (= previous (cast i64 13)) (= previous (cast i64 11)))
             (= current (cast i64 11)))
          true
        ; GB9 / GB9a / GB9b
        (or (= current (cast i64 4)) (= current (cast i64 5))) true
        (= current (cast i64 8)) true
        (= previous (cast i64 7)) true
        ; GB9c
        (and incb_active (and incb_linker (= current_incb (cast i64 1)))) true
        ; GB11
        (and current_ep (and (= previous (cast i64 5)) zwj_after_ep)) true
        ; GB12 / GB13
        (and (= previous (cast i64 6))
             (and (= current (cast i64 6))
                  (= (primitive/urem ri_count 2) (cast i64 1))))
          true
        :else false))

(defn grapheme-next-offset [(text StringView) (start i64)] (-> i64)
  (let [n (string/string-view-byte-len text)]
    (if (>= start n)
        n
        (let [first (string/string-view-rune-at text start)
              first-value (string/rune-value first)
              (mut previous) (data/grapheme-break-property first-value)
              (mut offset)
                (primitive/iadd start
                                (string/utf8-scalar-width (slice-get (string/string-view-bytes text) start)))
              (mut ri-count) (if (= (load previous) (cast i64 6)) 1 0)
              (mut ep-chain) (= (data/extended-pictographic? first-value) (cast i64 1))
              (mut zwj-after-ep) false
              first-incb (data/indic-conjunct-break-property first-value)
              (mut incb-active) (= first-incb (cast i64 1))
              (mut incb-linker) false]
          (loop (if (>= (load offset) n)
                    (break)
                    (let [rune (string/string-view-rune-at text (load offset))
                          value (string/rune-value rune)
                          current (data/grapheme-break-property value)
                          current-ep (= (data/extended-pictographic? value) (cast i64 1))
                          current-incb (data/indic-conjunct-break-property value)]
                      (if (not (grapheme-no-break? (load previous)
                                                   current
                                                   (load ri-count)
                                                   (load zwj-after-ep)
                                                   (load incb-active)
                                                   (load incb-linker)
                                                   current-ep
                                                   current-incb))
                          (break)
                          (do
                            ; State for GB11.
                            (if current-ep
                                (do (store! ep-chain true) (store! zwj-after-ep false))
                                (if (= current (cast i64 4))
                                    (store! zwj-after-ep false)
                                    (if (= current (cast i64 5))
                                        (do
                                          (store! zwj-after-ep (load ep-chain))
                                          (store! ep-chain false))
                                        (do
                                          (store! ep-chain false)
                                          (store! zwj-after-ep false)))))
                            ; State for GB9c.
                            (cond (= current-incb (cast i64 1))
                                    (do (store! incb-active true) (store! incb-linker false))
                                  (and (load incb-active) (= current-incb (cast i64 2))) 0
                                  (and (load incb-active) (= current-incb (cast i64 3))) (store! incb-linker true)
                                  :else (do (store! incb-active false) (store! incb-linker false)))
                            (store! ri-count
                                    (if (= current (cast i64 6))
                                        (primitive/iadd (load ri-count) 1)
                                        0))
                            (store! previous current)
                            (store! offset
                                    (primitive/iadd (load offset)
                                                    (string/utf8-scalar-width (slice-get (string/string-view-bytes text)
                                                                                         (load offset))))))))))
          (load offset)))))

(impl Iterable Chars
  (iter [(view Chars)]
        (-> CharIter)
        (CharIter :text (.text view) :offset 0)))

(impl Iterator CharIter
  (next [(it (mut CharIter))]
        (-> (Option Char))
        (let [text (load (field it text))
              start (load (field it offset))
              n (string/string-view-byte-len text)]
          (if (>= start n)
              (None)
              (let [end (grapheme-next-offset text start)
                    lo (StringIndex :byte_offset start)
                    hi (StringIndex :byte_offset end)]
                (store! (field it offset) end)
                (Some (Char :text (string/string-view-slice text lo hi))))))))

(impl Text Char
  (as-string-view [(char Char)] (-> StringView) (char-view char)))

(impl Eq Char
  (= [(a Char) (b Char)] (-> bool) (= (char-view a) (char-view b))))

(impl Hash Char
  (hash [(char Char)] (-> i64) (hash (char-view char))))
