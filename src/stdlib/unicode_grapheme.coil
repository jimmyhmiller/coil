(module coil.unicode.grapheme)
(import "coil.primitive" :as primitive)
(import "coil.str" :as string :use [StringView Text Rune StringIndex])
(import "coil.unicode.grapheme-data" :as data)

; Unicode 17 extended grapheme clusters (UAX #29). This module is separate from
; coil.str so byte/scalar-only programs do not pull Unicode property tables into
; their reachable program.
(defstruct Char [(text StringView)])

(defstruct Chars [(text StringView)])

(defstruct CharIter [(text StringView) (offset i64)])

(defn char-view [(char Char)] (-> StringView)
  (.text char))

(defn chars [(text StringView)] (-> Chars)
  (Chars :text text))

; Grapheme_Cluster_Break property codes generated in grapheme-data.
(defn gcb-control? [(property i64)] (-> bool)
  (or (= property 1)
      (or (= property 2) (= property 3))))

(defn grapheme-no-break? [(previous i64)
                          (current i64)
                          (ri_count i64)
                          (zwj_after_ep bool)
                          (incb_active bool)
                          (incb_linker bool)
                          (current_ep bool)
                          (current_incb i64)] (-> bool)
  (cond ; GB3
        (and (= previous 1) (= current 2)) true
        ; GB4 / GB5
        (or (gcb-control? previous) (gcb-control? current)) false
        ; GB6
        (and (= previous 9)
             (or (= current 9)
                 (or (= current 10)
                     (or (= current 12) (= current 13)))))
          true
        ; GB7
        (and (or (= previous 12) (= previous 10))
             (or (= current 10) (= current 11)))
          true
        ; GB8
        (and (or (= previous 13) (= previous 11))
             (= current 11))
          true
        ; GB9 / GB9a / GB9b
        (or (= current 4) (= current 5)) true
        (= current 8) true
        (= previous 7) true
        ; GB9c
        (and incb_active (and incb_linker (= current_incb 1))) true
        ; GB11
        (and current_ep (and (= previous 5) zwj_after_ep)) true
        ; GB12 / GB13
        (and (= previous 6)
             (and (= current 6)
                  (= (primitive/urem ri_count 2) 1)))
          true
        :else false))

(defn grapheme-next-offset [(text StringView) (start i64)] (-> i64)
  (let [n (byte-len text)]
    (if (>= start n)
        n
        (let [first (rune-at text start)
              first-value (value first)
              (mut previous) (data/grapheme-break-property first-value)
              (mut offset)
                (primitive/iadd start
                                (string/scalar-width (get (bytes text)
                                                          start)))
              (mut ri-count) (if (= (load previous) 6) 1 0)
              (mut ep-chain)
                (= (data/extended-pictographic? first-value) 1)
              (mut zwj-after-ep) false
              first-incb (data/indic-conjunct-break-property first-value)
              (mut incb-active) (= first-incb 1)
              (mut incb-linker) false]
          (loop (if (>= (load offset) n)
                    (break)
                    (let [rune (rune-at text (load offset))
                          value (value rune)
                          current (data/grapheme-break-property value)
                          current-ep
                            (= (data/extended-pictographic? value) 1)
                          current-incb
                            (data/indic-conjunct-break-property value)]
                      (if (not (grapheme-no-break? (load previous)
                                                   current
                                                   (load ri-count)
                                                   (load zwj-after-ep)
                                                   (load incb-active)
                                                   (load incb-linker)
                                                   current-ep
                                                   current-incb))
                          (break)
                          (do
                            ; State for GB11.
                            (if current-ep
                                (do
                                  (store! ep-chain true)
                                  (store! zwj-after-ep false))
                                (if (= current 4)
                                    (store! zwj-after-ep false)
                                    (if (= current 5)
                                        (do
                                          (store! zwj-after-ep (load ep-chain))
                                          (store! ep-chain false))
                                        (do
                                          (store! ep-chain false)
                                          (store! zwj-after-ep false)))))
                            ; State for GB9c.
                            (cond (= current-incb 1)
                                    (do
                                      (store! incb-active true)
                                      (store! incb-linker false))
                                  (and (load incb-active)
                                       (= current-incb 2))
                                    0
                                  (and (load incb-active)
                                       (= current-incb 3))
                                    (store! incb-linker true)
                                  :else
                                    (do
                                      (store! incb-active false)
                                      (store! incb-linker false)))
                            (store! ri-count
                                    (if (= current 6)
                                        (primitive/iadd (load ri-count) 1)
                                        0))
                            (store! previous current)
                            (store! offset
                                    (primitive/iadd (load offset)
                                                    (string/scalar-width (get (bytes text)
                                                                              (load offset))))))))))
          (load offset)))))

(impl Iterable Chars
  (iter [(view Chars)]
        (-> CharIter)
        (CharIter :text (.text view) :offset 0)))

(impl Iterator CharIter
  (next [(it (mut CharIter))]
        (-> (Option Char))
        (let [text (load (field it text))
              start (load (field it offset))
              n (byte-len text)]
          (if (>= start n)
              (None)
              (let [end (grapheme-next-offset text start)
                    lo (StringIndex :byte_offset start)
                    hi (StringIndex :byte_offset end)]
                (store! (field it offset) end)
                (Some (Char :text (slice text lo hi))))))))

(impl Text Char
  (as-string-view [(char Char)] (-> StringView) (char-view char)))

(impl Eq Char
  (= [(a Char) (b Char)] (-> bool) (= (char-view a) (char-view b))))

(impl Hash Char
  (hash [(char Char)] (-> i64) (hash (char-view char))))
