(module coil.binding.runtime)
(import "coil.primitive" :as primitive)

; Checked projections call these ordinary functions after source-type selection.
; Every program that destructures reaches this module, including hermetic ones,
; so it uses only compiler primitives: importing coil.slice here made every
; hermetic program fail to load.
; The runtime failure is explicit and unconditional, independent of debug mode.
(extern abort :cc c [] (-> void))

(export check-struct
        require-code
        code-nth
        code-rest
        require-slice
        slice-nth
        slice-rest)

(defn require-code [(value Code) (required i64)] (-> i64)
  (if (or (primitive/code-list? value) (primitive/code-vector? value))
      (if (primitive/icmp-ge (primitive/code-count value) required)
          0
          (primitive/error "sequence pattern has too few Code elements"))
      (primitive/error "sequence pattern requires a Code list or vector")))

(defn code-nth [(value Code) (index i64)] (-> Code)
  (require-code value (primitive/iadd index 1))
  (primitive/code-nth value index))

(defn code-rest [(value Code) (index i64)] (-> Code)
  (require-code value index)
  (primitive/code-slice value index (primitive/code-count value)))

(defn rt--slice-len [T] [(s (slice T))] (-> i64)
  (primitive/llvm-ir i64 [s] "%l = extractvalue $t0 $0, 1
ret $ret %l"))

(defn rt--slice-data [T] [(s (slice T))] (-> (ptr T))
  (primitive/llvm-ir (ptr T) [s] "%d = extractvalue $t0 $0, 0
ret $ret %d"))

(defn rt--slice-new [T] [(data (ptr T)) (len i64)] (-> (slice T))
  (primitive/llvm-ir (slice T)
                     [data len]
                     "%s0 = insertvalue $ret undef, $t0 $0, 0
%s1 = insertvalue $ret %s0, $t1 $1, 1
ret $ret %s1"))

(defn require-slice [T] [(value (slice T)) (required i64)] (-> i64)
  (if (primitive/icmp-ge (rt--slice-len value) required)
      0
      (do (abort) 0)))

(defn slice-nth [T] [(value (slice T)) (index i64)] (-> (ptr T))
  (require-slice value (primitive/iadd index 1))
  (primitive/index (rt--slice-data value) index))

(defn slice-rest [T] [(value (slice T)) (index i64)] (-> (slice T))
  (require-slice value index)
  (rt--slice-new (primitive/index (rt--slice-data value) index)
                   (primitive/isub (rt--slice-len value) index)))

; Nominal pattern validation borrows the root and produces no second owner.
(defn check-struct [T] [(value (ref T))] (-> i64)
  0)
