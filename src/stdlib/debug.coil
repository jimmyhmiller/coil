(module coil.debug)
(import "coil.primitive" :as primitive)
(import "coil.io" :use *)
(import "coil.fmt" :use * :reexport)
(import "coil.slice" :use *)
(import "coil.arraylist" :use *)
(import "coil.hashmap" :use [HashMap hm-cap])
(import "coil.derive" :reexport)
(import "coil.result" :use *)

; Source-shaped diagnostic printing. Derived structs and sums are emitted as valid
; named constructor calls, so their output can be pasted back into Coil source.
;
; A shrunk counterexample is only useful if you can READ it, so every type a
; property takes must know how to display itself. `Debug` is that, as a trait —
; overridable per type, monomorphized, and derivable from a type's fields with
; `(derive Debug T)` so nobody writes it by hand.
;
; Values print as re-readable Coil source whenever their component Debug impls do.

;;; Compatibility adapter for code that explicitly writes one compact Debug value.
;;; Format strings dispatch straight to `debug-fmt` so `{:#?}` can carry its mode.
(defn debug-write [(x Code) (w Code)] (-> Code)
  (let [f (primitive/fresh-identifier "formatter")]
    `(let [~f (primitive/alloc-stack Formatter)]
       (formatter-init ~f ~w)
       (debug-fmt ~x ~f))))

;;; Print one Debug value to stdout, with or without a trailing newline. These are
;;; macros so aggregate constructor expressions stay in the caller; no temporary
;;; aggregate reference crosses an extra generic call boundary.
(defn debug [(x Code)] (-> Code)
  `(debug-write ~x (coil.io.stdout)))

(defn debugln [(x Code)] (-> Code)
  (let [w (primitive/fresh-identifier "temporary")]
    `(let [~w (coil.io.stdout)] (debug-write ~x ~w) (coil.io.write-byte ~w 10) 0)))

(impl [(T Debug)] Debug (ArrayList T)
  (debug-fmt [(x (ArrayList T)) (f (ptr Formatter))]
               (-> i64)
               (let [w (formatter-writer f)
                     indent (primitive/alloc-stack DebugIndentWriter)
                     nested-w (primitive/alloc-stack Writer)
                     nested-f (primitive/alloc-stack Formatter)]
               (if (formatter-pretty? f)
                   (do (debug-indent-writer indent nested-w w)
                       (formatter-init nested-f nested-w)
                       (formatter-set-alternate! nested-f true))
                   (do (formatter-init nested-f w) 0))
               (print-str w "(")
               (let [(mut i) 0
                     n (al-len [T] x)]
                 (loop (if (>= (load i) n)
                           (break)
                           (do
                             (if (formatter-pretty? f)
                                 (do (print-str w "\n  ") 0)
                                 (if (> (load i) 0) (do (print-str w " ") 0) 0))
                             (debug-fmt (al-get [T] x (load i)) nested-f)
                             (store! i (primitive/iadd (load i) 1))))))
               (when (and (formatter-pretty? f) (> (al-len [T] x) 0)) (print-str w "\n") 0)
               (print-str w ")")
               0)))

(impl [(T Debug)] Debug (Option T)
  (debug-fmt [(x (Option T)) (f (ptr Formatter))]
               (-> i64)
               (let [w (formatter-writer f)
                     indent (primitive/alloc-stack DebugIndentWriter)
                     nested-w (primitive/alloc-stack Writer)
                     nested-f (primitive/alloc-stack Formatter)]
               (if (formatter-pretty? f)
                   (do (debug-indent-writer indent nested-w w)
                       (formatter-init nested-f nested-w)
                       (formatter-set-alternate! nested-f true))
                   (do (formatter-init nested-f w) 0))
               (match x
                 (None [] (do (print-str w "(None)") 0))
                 (Some [v]
                   (if (formatter-pretty? f)
                       (do (print-str w "(Some\n  ") (debug-fmt v nested-f) (print-str w "\n)") 0)
                       (do (print-str w "(Some ") (debug-fmt v nested-f) (print-str w ")") 0)))))))

;;; `name = value`, the shape every counterexample line takes.
(defn debug-named [(T Debug)] [(w (ptr Writer)) (name (slice u8)) (v T)] (-> i64)
  (print-str w "    ")
  (print-str w name)
  (print-str w " = ")
  (debug-write v w)
  (print-str w "\n")
  0)

;;; One `name = value` counterexample line on stdout. `defprop` expands to calls of
;;; this, so it lives here (next to the trait it is bounded on) rather than in
;;; coil.prop, and a property's file needs no `coil.io` import of its own.
;;;
;;; ⚠ It repeats `debug-named`'s body instead of calling it. A bounded generic
;;; calling ANOTHER bounded generic with the same bound is rejected by the checker
;;; ("'T' does not implement 'Debug'") — the bound does not propagate across
;;; that edge. A direct trait-method call on a bounded parameter is fine, which is
;;; what this does.
(defn debug-arg [(T Debug)] [(name (slice u8)) (v T)] (-> i64)
  (let [w (stdout)]
    (print-str w "    ")
    (print-str w name)
    (print-str w " = ")
    (debug-write v w)
    (print-str w "\n")
    0))

; A derived value writes its own field prefixes to the caller's writer. Nested
; values use this adapter, which adds one level to every continuation line while
; leaving the nested value's first byte exactly where the field prefix put it.
(defstruct DebugIndentWriter
  [(inner (ptr Writer))
   (line-start bool)])

(defn debug-indent-write [(ctx (ptr i8)) (buf (ptr i8)) (len i64)] (-> (Result i64 IoError))
  (let [state (primitive/cast (ptr DebugIndentWriter) ctx)
        bytes (primitive/cast (ptr u8) buf)
        (mut at) 0
        (mut failed) false
        (mut error) (Eof)]
    (loop (if (or (load failed) (>= (load at) len)) (break) 0)
      (let [byte (load (primitive/index bytes (load at)))]
        (when (and (load (field state line-start)) (!= (primitive/cast i64 byte) 10))
          (match (print-str (load (field state inner)) "  ")
            (Err [e] (do (store! failed true) (store! error e) 0))
            (Ok [_] (do (store! (field state line-start) false) 0)))
          0)
        (unless (load failed)
          (match (coil.io.write-byte (load (field state inner)) byte)
            (Err [e] (do (store! failed true) (store! error e) 0))
            (Ok [_]
                (do
                  (store! (field state line-start) (= (primitive/cast i64 byte) 10))
                  (store! at (primitive/iadd (load at) 1))
                  0)))
          0)))
    (if (load failed) (Err (load error)) (Ok len))))

(defn debug-indent-writer [(state (ptr DebugIndentWriter))
                           (out (ptr Writer))
                           (inner (ptr Writer))] (-> (ptr Writer))
  (store! (field state inner) inner)
  (store! (field state line-start) false)
  (store! (field out write-fn) (primitive/fnptr-of debug-indent-write))
  (store! (field out ctx) (primitive/cast (ptr i8) state))
  out)

;;; Hash maps are Debug exactly when both their keys and values are Debug. Slot
;;; order is deliberately unspecified, matching iteration order. The shape is a
;;; Coil-styled constructor rather than pretending the language has a map literal.
(impl [(K Debug) (V Debug)] Debug (HashMap K V)
  (debug-fmt [(x (HashMap K V)) (f (ptr Formatter))]
             (-> i64)
             (let [w (formatter-writer f)
                   (mut at) 0
                   (mut written) 0
                   cap (hm-cap [K V] x)
                   slots (load (field x slots))
                   indent (primitive/alloc-stack DebugIndentWriter)
                   nested-w (primitive/alloc-stack Writer)
                   nested-f (primitive/alloc-stack Formatter)]
               (if (formatter-pretty? f)
                   (do (debug-indent-writer indent nested-w w)
                       (formatter-init nested-f nested-w)
                       (formatter-set-alternate! nested-f true))
                   (do (formatter-init nested-f w) 0))
               (print-str w "(HashMap")
               (loop (if (>= (load at) cap)
                         (break)
                         (let [entry (primitive/index slots (load at))]
                           (when (= (load (field entry state)) 1)
                             (if (formatter-pretty? f)
                                 (print-str w "\n  (")
                                 (print-str w " ("))
                             (debug-fmt (load (field entry key)) nested-f)
                             (print-str w " ")
                             (debug-fmt (load (field entry val)) nested-f)
                             (print-str w ")")
                             (store! written (primitive/iadd (load written) 1))
                             0)
                           (store! at (primitive/iadd (load at) 1)))))
               (when (and (formatter-pretty? f) (> (load written) 0))
                 (print-str w "\n")
                 0)
               (print-str w ")")
               0)))

; --------------------------- derive Debug ----------------------------------

; Debug derive options use the same field-oriented shape as serde derives:
; `(derive (Debug (field secret (skip))) T)`. Keeping the option attached to
; Debug avoids a declaration-wide annotation that would silently affect other
; derives such as Serialize or Eq.
(defn debug--some? [(form Code)] (-> bool)
  (if (primitive/code-list? form) (> (primitive/code-count form) (primitive/cast i64 0)) false))

(defn debug--head [(form Code)] (-> Code)
  (if (debug--some? form) (primitive/code-nth form 0) `()))

(defn debug--find-field-option [(opts Code) (fname Code)] (-> Code)
  (let [n (primitive/code-count opts)
        (mut i) 0
        (mut out) `()]
    (loop (if (>= (load i) n)
              (break)
              (let [option (primitive/code-nth opts (load i))]
                (if (and (primitive/code-eq (debug--head option) `field)
                         (and (>= (primitive/code-count option) (primitive/cast i64 2))
                              (primitive/code-eq (primitive/code-nth option 1) fname)))
                    (do (store! out option) (break))
                    (store! i (primitive/iadd (load i) 1))))))
    (load out)))

(defn debug--field-skipped? [(opts Code) (fname Code)] (-> bool)
  (let [option (debug--find-field-option opts fname)]
    (and (debug--some? option)
         (and (= (primitive/code-count option) (primitive/cast i64 3))
              (let [setting (primitive/code-nth option 2)]
                (and (= (primitive/code-count setting) (primitive/cast i64 1))
                     (primitive/code-eq (debug--head setting) `skip)))))))

(defn debug--known-field? [(T Code) (fname Code)] (-> bool)
  (let [n (primitive/code-field-count T)
        (mut i) 0
        (mut found) false]
    (loop (if (>= (load i) n)
              (break)
              (if (primitive/code-eq (primitive/code-field-name T (load i)) fname)
                  (do (store! found true) (break))
                  (store! i (primitive/iadd (load i) 1)))))
    (load found)))

(defn debug--option-seen-before? [(opts Code) (at i64) (kind Code) (name Code) (start i64)] (-> bool)
  (let [(mut i) start
        (mut found) false]
    (loop (if (>= (load i) at)
              (break)
              (let [option (primitive/code-nth opts (load i))]
                (if (and (primitive/code-eq (debug--head option) kind)
                         (and (>= (primitive/code-count option) (primitive/cast i64 2))
                              (primitive/code-eq (primitive/code-nth option 1) name)))
                    (do (store! found true) (break))
                    (store! i (primitive/iadd (load i) 1))))))
    (load found)))

(defn debug--check-options [(T Code) (opts Code)] (-> i64)
  (let [n (primitive/code-count opts)
        (mut i) 0]
    (loop (if (>= (load i) n) (break) 0)
      (let [option (primitive/code-nth opts (load i))]
        (if (not (and (primitive/code-eq (debug--head option) `field)
                      (= (primitive/code-count option) (primitive/cast i64 3))))
            (primitive/code-int (primitive/error "derive Debug: expected (field NAME (skip))"))
            (let [fname (primitive/code-nth option 1)
                  setting (primitive/code-nth option 2)]
              (if (debug--option-seen-before? opts (load i) `field fname 0)
                  (primitive/code-int (primitive/error (primitive/code-str fname
                                                                           " — derive Debug: duplicate field option")))
                  (if (not (debug--known-field? T fname))
                      (primitive/code-int (primitive/error (primitive/code-str fname " — derive Debug: no such field")))
                      (if (not (and (= (primitive/code-count setting) (primitive/cast i64 1))
                                    (primitive/code-eq (debug--head setting) `skip)))
                          (primitive/code-int (primitive/error "derive Debug: field option must be (skip)"))
                          0)))))
        (store! i (primitive/iadd (load i) 1))))
    0))

(defn debug--variant-index [(T Code) (vname Code)] (-> i64)
  (let [n (primitive/code-variant-count T)
        (mut i) 0
        (mut found) -1]
    (loop (if (>= (load i) n)
              (break)
              (if (primitive/code-eq (primitive/code-variant-name T (load i)) vname)
                  (do (store! found (load i)) (break))
                  (store! i (primitive/iadd (load i) 1)))))
    (load found)))

(defn debug--known-variant-field? [(T Code) (vi i64) (fname Code)] (-> bool)
  (let [n (primitive/code-variant-fields T vi)
        (mut i) 0
        (mut found) false]
    (loop (if (>= (load i) n)
              (break)
              (if (primitive/code-eq (primitive/code-variant-field-name T vi (load i)) fname)
                  (do (store! found true) (break))
                  (store! i (primitive/iadd (load i) 1)))))
    (load found)))

(defn debug--find-variant-option [(opts Code) (vname Code)] (-> Code)
  (let [n (primitive/code-count opts)
        (mut i) 0
        (mut out) `()]
    (loop (if (>= (load i) n)
              (break)
              (let [option (primitive/code-nth opts (load i))]
                (if (and (primitive/code-eq (debug--head option) `variant)
                         (and (>= (primitive/code-count option) (primitive/cast i64 2))
                              (primitive/code-eq (primitive/code-nth option 1) vname)))
                    (do (store! out option) (break))
                    (store! i (primitive/iadd (load i) 1))))))
    (load out)))

(defn debug--variant-field-skipped? [(opts Code) (vname Code) (fname Code)] (-> bool)
  (let [variant-option (debug--find-variant-option opts vname)
        n (primitive/code-count variant-option)
        (mut i) 2
        (mut skipped) false]
    (loop (if (>= (load i) n)
              (break)
              (let [field-option (primitive/code-nth variant-option (load i))]
                (if (and (primitive/code-eq (debug--head field-option) `field)
                         (and (primitive/code-eq (primitive/code-nth field-option 1) fname)
                              (primitive/code-eq (debug--head (primitive/code-nth field-option 2)) `skip)))
                    (do (store! skipped true) (break))
                    (store! i (primitive/iadd (load i) 1))))))
    (load skipped)))

(defn debug--check-variant-fields [(T Code) (vi i64) (variant-option Code)] (-> i64)
  (let [n (primitive/code-count variant-option)
        (mut i) 2]
    (loop (if (>= (load i) n) (break) 0)
      (let [field-option (primitive/code-nth variant-option (load i))]
        (if (not (and (primitive/code-eq (debug--head field-option) `field)
                      (= (primitive/code-count field-option) (primitive/cast i64 3))))
            (primitive/code-int (primitive/error "derive Debug: expected (field NAME (skip)) inside variant"))
            (let [fname (primitive/code-nth field-option 1)
                  setting (primitive/code-nth field-option 2)]
              (cond (debug--option-seen-before? variant-option (load i) `field fname 2)
                      (primitive/code-int (primitive/error (primitive/code-str fname
                                                                               " — derive Debug: duplicate variant field option")))
                    (not (debug--known-variant-field? T vi fname))
                      (primitive/code-int (primitive/error (primitive/code-str fname
                                                                               " — derive Debug: no such field on variant")))
                    (not (and (= (primitive/code-count setting) (primitive/cast i64 1))
                              (primitive/code-eq (debug--head setting) `skip)))
                      (primitive/code-int (primitive/error "derive Debug: variant field option must be (skip)"))
                    :else 0)))
        (store! i (primitive/iadd (load i) 1))))
    0))

(defn debug--check-sum-options [(T Code) (opts Code)] (-> i64)
  (let [n (primitive/code-count opts)
        (mut i) 0]
    (loop (if (>= (load i) n) (break) 0)
      (let [variant-option (primitive/code-nth opts (load i))]
        (if (not (and (primitive/code-eq (debug--head variant-option) `variant)
                      (>= (primitive/code-count variant-option) (primitive/cast i64 3))))
            (primitive/code-int (primitive/error "derive Debug: expected (variant NAME (field NAME (skip)) ...)"))
            (let [vname (primitive/code-nth variant-option 1)
                  vi (debug--variant-index T vname)]
              (cond (debug--option-seen-before? opts (load i) `variant vname 0)
                      (primitive/code-int (primitive/error (primitive/code-str vname
                                                                               " — derive Debug: duplicate variant option")))
                    (< vi 0)
                      (primitive/code-int (primitive/error (primitive/code-str vname
                                                                               " — derive Debug: no such variant")))
                    :else (debug--check-variant-fields T vi variant-option))))
        (store! i (primitive/iadd (load i) 1))))
    0))

;;; A growable Code list, not `(… ~@(debug--fields …)): splicing the recursion's
;;; result rebuilds the suffix at every level — quadratic in the field count
;;; (docs/design/META_MEMORY.md).
(defn debug--fields [(T Code) (x Code) (w Code) (nested-f Code) (opts Code) (i i64) (n i64)] (-> Code)
  (let [out (primitive/code-list-new)
        (mut f) i]
    (loop (if (>= (load f) n)
              (break)
              (let [fname (primitive/code-field-name T (load f))]
                (do
                  (unless (debug--field-skipped? opts fname)
                    (primitive/code-list-push! out `(coil.io.print-str ~w ~(primitive/code-str "\n  :" fname " ")))
                    (primitive/code-list-push! out `(debug-fmt (load (field ~x ~fname)) ~nested-f))
                    0)
                  (store! f (primitive/iadd (load f) 1))))))
    (primitive/code-list-done out)))

(defn debug--compact-fields [(T Code) (x Code) (w Code) (f Code) (opts Code) (i i64) (n i64)] (-> Code)
  (let [out (primitive/code-list-new)
        (mut at) i]
    (loop (if (>= (load at) n)
              (break)
              (let [fname (primitive/code-field-name T (load at))]
                (do
                  (unless (debug--field-skipped? opts fname)
                    (primitive/code-list-push! out `(coil.io.print-str ~w ~(primitive/code-str " :" fname " ")))
                    (primitive/code-list-push! out `(debug-fmt (load (field ~x ~fname)) ~f))
                    0)
                  (store! at (primitive/iadd (load at) 1))))))
    (primitive/code-list-done out)))

(defn debug--visible-fields [(T Code) (opts Code)] (-> i64)
  (let [n (primitive/code-field-count T)
        (mut at) 0
        (mut visible) 0]
    (loop (if (>= (load at) n)
              (break)
              (do
                (unless (debug--field-skipped? opts (primitive/code-field-name T (load at)))
                  (store! visible (primitive/iadd (load visible) 1)))
                (store! at (primitive/iadd (load at) 1)))))
    (load visible)))

(defn debug--struct [(T Code) (opts Code)] (-> Code)
  (let [n (primitive/code-field-count T)
        x-id (primitive/fresh-identifier "value")
        f-id (primitive/fresh-identifier "formatter")
        w-id (primitive/fresh-identifier "writer")
        indent-id (primitive/fresh-identifier "indent-state")
        nested-w-id (primitive/fresh-identifier "nested-writer")
        nested-f-id (primitive/fresh-identifier "nested-formatter")
        visible (debug--visible-fields T opts)]
    (debug--check-options T opts)
    `(impl Debug ~T
       (debug-fmt [(~x-id ~T) (~f-id (ptr Formatter))]
                    (-> i64)
                    (let [~w-id (formatter-writer ~f-id)]
                      (coil.io.print-str ~w-id ~(primitive/code-str "(" T))
                      (if (formatter-pretty? ~f-id)
                          (let [~indent-id (primitive/alloc-stack DebugIndentWriter)
                                ~nested-w-id (primitive/alloc-stack coil.io.Writer)
                                ~nested-f-id (primitive/alloc-stack Formatter)]
                            (debug-indent-writer ~indent-id ~nested-w-id ~w-id)
                            (formatter-init ~nested-f-id ~nested-w-id)
                            (formatter-set-alternate! ~nested-f-id true)
                            ~@(debug--fields T x-id w-id nested-f-id opts 0 n)
                            ~(if (> visible 0) `(coil.io.print-str ~w-id "\n") `0)
                            0)
                          (do ~@(debug--compact-fields T x-id w-id f-id opts 0 n) 0))
                      (coil.io.print-str ~w-id ")")
                      0)))))

;;; Builder loop, not `(~sym ~@(self …)): re-splicing the recursion's result is
;;; quadratic in the payload field count (docs/design/META_MEMORY.md).
(defn debug--binds [(T Code) (vi i64) (fi i64) (n i64)] (-> Code)
  (let [out (primitive/code-list-new)
        (mut f) fi]
    (loop (if (>= (load f) n)
              (break)
              (do
                (primitive/code-list-push! out
                                           (primitive/fresh-identifier (primitive/code-symbol "debug$field$"
                                                                                              (primitive/code-variant-field-name T
                                                                                                                                 vi
                                                                                                                                 (load f)))))
                (store! f (primitive/iadd (load f) 1)))))
    (primitive/code-list-done out)))

(defn debug--ptr? [(T Code)] (-> bool)
  (if (primitive/code-list? T)
      (and (= (primitive/code-count T) (primitive/cast i64 2))
           (primitive/code-eq (primitive/code-nth T 0) `ptr))
      false))

;;; Builder loop for the same reason as debug--fields (docs/design/META_MEMORY.md).
(defn debug--payload [(T Code) (w Code) (nested-f Code) (binds Code) (opts Code) (vi i64) (fi i64) (n i64)] (-> Code)
  (let [out (primitive/code-list-new)
        (mut f) fi]
    (loop (if (>= (load f) n)
              (break)
              (let [fname (primitive/code-variant-field-name T vi (load f))
                    ty (primitive/code-variant-field-type T vi (load f))
                    binder (primitive/code-nth binds (load f))
                    value (if (debug--ptr? ty) `(load ~binder) binder)
                    vname (primitive/code-variant-name T vi)]
                (do
                  (unless (debug--variant-field-skipped? opts vname fname)
                    (primitive/code-list-push! out `(coil.io.print-str ~w ~(primitive/code-str "\n  :" fname " ")))
                    (primitive/code-list-push! out `(debug-fmt ~value ~nested-f))
                    0)
                  (store! f (primitive/iadd (load f) 1))))))
    (primitive/code-list-done out)))

(defn debug--compact-payload [(T Code) (w Code) (f Code) (binds Code) (opts Code) (vi i64) (fi i64) (n i64)] (-> Code)
  (let [out (primitive/code-list-new)
        (mut at) fi]
    (loop (if (>= (load at) n)
              (break)
              (let [fname (primitive/code-variant-field-name T vi (load at))
                    ty (primitive/code-variant-field-type T vi (load at))
                    binder (primitive/code-nth binds (load at))
                    value (if (debug--ptr? ty) `(load ~binder) binder)
                    vname (primitive/code-variant-name T vi)]
                (do
                  (unless (debug--variant-field-skipped? opts vname fname)
                    (primitive/code-list-push! out `(coil.io.print-str ~w ~(primitive/code-str " :" fname " ")))
                    (primitive/code-list-push! out `(debug-fmt ~value ~f))
                    0)
                  (store! at (primitive/iadd (load at) 1))))))
    (primitive/code-list-done out)))

(defn debug--visible-payload [(T Code) (opts Code) (vi i64)] (-> i64)
  (let [n (primitive/code-variant-fields T vi)
        vname (primitive/code-variant-name T vi)
        (mut at) 0
        (mut visible) 0]
    (loop (if (>= (load at) n)
              (break)
              (do
                (unless (debug--variant-field-skipped? opts vname (primitive/code-variant-field-name T vi (load at)))
                  (store! visible (primitive/iadd (load visible) 1)))
                (store! at (primitive/iadd (load at) 1)))))
    (load visible)))

;;; Builder loop, one match arm per push — quadratic in the variant count as a
;;; self-splice (docs/design/META_MEMORY.md). The inner ~@ splices are one-shot
;;; uses of finished lists, which stay.
(defn debug--arms [(T Code) (w Code) (f Code) (nested-f Code) (opts Code) (vi i64) (n i64)] (-> Code)
  (let [out (primitive/code-list-new)
        (mut v) vi]
    (loop (if (>= (load v) n)
              (break)
              (let [nf (primitive/code-variant-fields T (load v))
                    visible (debug--visible-payload T opts (load v))
                    binds (debug--binds T (load v) 0 nf)]
                (do
                  (primitive/code-list-push! out
                                             `(~(primitive/code-variant-qname T (load v)) [~@binds]
                                                 (do
                                                   (coil.io.print-str ~w
                                                                      ~(primitive/code-str "("
                                                                                           (primitive/code-variant-name T
                                                                                                                        (load v))))
                                                   (if (formatter-pretty? ~f)
                                                       (do
                                                         ~@(debug--payload T w nested-f binds opts (load v) 0 nf)
                                                         ~(if (> visible 0) `(coil.io.print-str ~w "\n") `0)
                                                         0)
                                                       (do ~@(debug--compact-payload T w f binds opts (load v) 0 nf) 0))
                                                   (coil.io.print-str ~w ")")
                                                   0)))
                  (store! v (primitive/iadd (load v) 1))))))
    (primitive/code-list-done out)))

(defn debug--sum [(T Code) (opts Code)] (-> Code)
  (let [x-id (primitive/fresh-identifier "value")
        f-id (primitive/fresh-identifier "formatter")
        w-id (primitive/fresh-identifier "writer")
        indent-id (primitive/fresh-identifier "indent-state")
        nested-w-id (primitive/fresh-identifier "nested-writer")
        nested-f-id (primitive/fresh-identifier "nested-formatter")]
    (debug--check-sum-options T opts)
    `(impl Debug ~T
       (debug-fmt [(~x-id ~T) (~f-id (ptr Formatter))]
                    (-> i64)
                    (let [~w-id (formatter-writer ~f-id)
                          ~indent-id (primitive/alloc-stack DebugIndentWriter)
                          ~nested-w-id (primitive/alloc-stack coil.io.Writer)
                          ~nested-f-id (primitive/alloc-stack Formatter)]
                      (debug-indent-writer ~indent-id ~nested-w-id ~w-id)
                      (formatter-init ~nested-f-id ~nested-w-id)
                      (formatter-set-alternate! ~nested-f-id true)
                      (match ~x-id ~@(debug--arms T w-id f-id nested-f-id opts 0 (primitive/code-variant-count T))))))))

(defderive Debug
           (struct [T & opts] (debug--struct T opts))
           (sum [T & opts] (debug--sum T opts)))
