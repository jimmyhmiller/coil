(module coil.alloc)
(import "coil.primitive" :as primitive)

; Allocators are ordinary trait objects. `(dyn Allocator)` is a borrowed, copyable
; pair of pointers (implementation + compiler-generated vtable); it does not own or
; extend the lifetime of the implementation. Allocation failure is always explicit.

(import "coil.result" :use *)  ; Option/Result/Some/None/Ok/Err, brought in bare

(extern malloc :cc c [isize] (-> (ptr i8)))  ; void* malloc(size_t)
(extern realloc :cc c [(ptr i8) isize] (-> (ptr i8)))  ; void* realloc(void*, size_t)
(extern posix_memalign :cc c [(ptr (ptr i8)) isize isize] (-> i32))
(extern abort :cc c [] (-> :i64))  ; void abort() — unrecoverable hard-fail

; ---- reporting an unrecoverable allocation failure -------------------------
;; write(2), for the abort message below. io.coil and slice.coil already declare this
;; exact signature; an identical redeclaration names the same symbol rather than adding
;; a new one, and nothing here is referenced by a program that never allocates, so
;; --gc-sections still drops it and freestanding builds stay libc-free.
(extern write :cc c [i32 (ptr i8) isize] (-> isize))  ; ssize_t write(int, const void*, size_t)

;; Write a NUL-terminated literal to stderr. The length is measured by scanning so this
;; needs no `strlen` extern, and the write is unbuffered so nothing is lost to `abort`.
(defn oom-puts [(s (ptr i8))] (-> :i64)
  (let [(mut n) 0]
    (loop (if (= (primitive/cast :i64 (load (primitive/index s (load n)))) (cast i64 0))
              (break)
              (store! n (primitive/iadd (load n) 1))))
    (write 2 s (primitive/cast isize (load n)))
    0))

;; Decimal-print a non-negative i64 to stderr. Digits are built back-to-front in a
;; call-site-static scratch buffer — `alloc-static` gives one cell per call site, which
;; is exactly right here: this runs once, on the way to `abort`.
(defn oom-putd [(v :i64)] (-> :i64)
  (let [buf (primitive/alloc-static (array i8 24))
        (mut i) 24
        (mut x) v]
    (loop (do
            (store! i (primitive/isub (load i) 1))
            (store! (primitive/index buf (load i)) (primitive/cast i8 (primitive/iadd 48 (primitive/irem (load x) 10))))
            (store! x (primitive/idiv (load x) 10))
            (if (= (load x) (cast i64 0)) (break) 0)))
    (write 2
           (primitive/cast (ptr i8) (primitive/index buf (load i)))
           (primitive/cast isize (primitive/isub 24 (load i))))
    0))

;; Report a failed allocation, then hard-abort the process. `site` names the caller and
;; `bytes` is the request that could not be satisfied (pass -1 when the size is not
;; known). This used to be a bare `abort()`: exit 134, empty stdout, empty stderr — so
;; every allocator-exhaustion bug cost an afternoon of bisecting builds to locate what
;; one line of output identifies. See docs/reference/ALLOCATION.md.
(defn oom-at [(site (ptr i8)) (bytes :i64)] (-> :i64)
  (oom-puts c"out of memory: ")
  (oom-puts site)
  (oom-puts c" failed to allocate")
  (if (>= bytes (cast i64 0))
      (do (oom-puts c" ") (oom-putd bytes) (oom-puts c" bytes"))
      0)
  (oom-puts c"; the allocator is exhausted\n")
  (abort)
  0)

;; Shared hard-fail for development checks in ordinary data structures. Keeping the
;; unbuffered reporter here avoids each collection redeclaring libc write/abort.
(defn debug-fail-at [(site (ptr i8))] (-> :i64)
  (oom-puts c"coil: ")
  (oom-puts site)
  (oom-puts c" (--debug-checks)\n")
  (abort)
  0)

;; Hard-abort on an unrecoverable allocation failure, without a known site or size.
;; Prefer `oom-at` — the site and the request size are what make the abort diagnosable.
;; Exposed as a defn (not the bare extern) so callers share ONE `abort` declaration:
;; Coil doesn't dedup identical externs across modules, and defns ARE shared via
;; `:use *` while extern decls are not — so collections route OOM through here instead
;; of each declaring their own `abort` (which would collide when two such libs are
;; imported together).
(defn oom [] (-> :i64)
  (oom-at c"an allocation" -1))

(defstruct AllocRequest
  [(type-id i64)   ; 0 is intentionally untyped bytes
   (count i64)     ; logical element count
   (bytes i64)     ; actual storage size
   (align i64)])

;; The raw contract is deliberately object-safe: only the receiver mentions `Self`.
;; `resize` may change the size only when the address stays fixed; `remap` may move it.
(deftrait Allocator [Self]
  ; Aggregate arguments are references so the concrete impl function and erased
  ; vtable function have the same ABI. Callers still pass AllocRequest values.
  (allocate [(self (ptr Self)) (request (ref AllocRequest))] (-> (Option (ptr i8))))
  (resize [(self (ptr Self)) (memory (ptr i8)) (old (ref AllocRequest)) (new (ref AllocRequest))] (-> bool))
  (remap [(self (ptr Self)) (memory (ptr i8)) (old (ref AllocRequest)) (new (ref AllocRequest))] (-> (Option (ptr i8))))
  (deallocate [(self (ptr Self)) (memory (ptr i8)) (request (ref AllocRequest))] (-> i64)))

; An owning, type-erased capability for an allocator. Unlike `(dyn Allocator)`, a
; lease may escape the scope that produced it: each clone retains `state`, and the
; final drop releases it. The allocator object referenced by `allocator` must remain
; valid until `release(state)` destroys the final lease. `retain` and `release` are
; deliberately supplied by the allocator implementation, so this abstraction does
; not select or depend on a global allocator.
;
; The concrete ABI is a borrowed allocator pair plus a state pointer and two C-ABI
; callbacks. Keeping dispatch and lifetime erasure separate lets existing Allocator
; implementations participate without changing the object-safe allocation trait.
(defstruct AllocatorLease
  [(allocator (dyn Allocator))
   (state (ptr i8))
   (retain (fnptr c [(ptr i8)] i64))
   (release (fnptr c [(ptr i8)] i64))])

; The callbacks are a lifetime-safety assertion: `allocator` may be used until
; the final release completes. Only allocator implementations that can uphold
; that contract may construct a lease. The unsafe name makes it impossible to
; accidentally present a scratch/resettable borrowed allocator as an owned one.
(defn unsafe-allocator-lease-new [(allocator (dyn Allocator))
                                  (state (ptr i8))
                                  (retain (fnptr c [(ptr i8)] i64))
                                  (release (fnptr c [(ptr i8)] i64))] (-> AllocatorLease)
  (AllocatorLease :allocator allocator :state state :retain retain :release release))

(defn allocator-lease-borrow [(lease (ref AllocatorLease))] (-> (dyn Allocator))
  (load (field lease allocator)))

(impl Clone AllocatorLease
  (clone [(self (ref AllocatorLease))] (-> AllocatorLease)
    (primitive/call-ptr (load (field self retain)) (load (field self state)))
    (AllocatorLease :allocator (load (field self allocator))
                    :state (load (field self state))
                    :retain (load (field self retain))
                    :release (load (field self release)))))

(impl Drop AllocatorLease
  (drop [(self (mut AllocatorLease))] (-> void)
    (primitive/call-ptr (load (field self release)) (load (field self state)))))

(defn valid-request? [(r AllocRequest)] (-> bool)
  ; Type IDs are process-local pointer tokens represented as i64, so the sign bit
  ; is not a validity condition. Zero is valid and deliberately means raw bytes.
  (and (> (load (field r count)) 0)
       (and (> (load (field r bytes)) 0)
            (and (> (load (field r align)) 0)
                 (= (primitive/iand (load (field r align))
                                    (primitive/isub (load (field r align)) 1))
                    0)))))

(defn raw-alloc [(a (dyn Allocator)) (request AllocRequest)] (-> (Option (ptr i8)))
  (if (valid-request? request) (allocate a request) (None)))
(defn raw-resize [(a (dyn Allocator)) (memory (ptr i8)) (old AllocRequest) (new AllocRequest)] (-> bool)
  (if (and (valid-request? old) (valid-request? new))
      (resize a memory old new)
      false))
(defn raw-remap [(a (dyn Allocator)) (memory (ptr i8)) (old AllocRequest) (new AllocRequest)] (-> (Option (ptr i8)))
  (if (and (valid-request? old) (valid-request? new))
      (remap a memory old new)
      (None)))
(defn raw-free [(a (dyn Allocator)) (memory (ptr i8)) (request AllocRequest)] (-> i64)
  (if (valid-request? request) (deallocate a memory request) 0))

; Lease-oriented raw operations keep provenance explicit at the call site. The
; lease is borrowed for each operation; allocating never consumes the capability.
(defn lease-raw-alloc [(lease (ref AllocatorLease)) (request AllocRequest)] (-> (Option (ptr i8)))
  (raw-alloc (allocator-lease-borrow lease) request))
(defn lease-raw-resize [(lease (ref AllocatorLease)) (memory (ptr i8)) (old AllocRequest) (new AllocRequest)] (-> bool)
  (raw-resize (allocator-lease-borrow lease) memory old new))
(defn lease-raw-remap [(lease (ref AllocatorLease)) (memory (ptr i8)) (old AllocRequest) (new AllocRequest)] (-> (Option (ptr i8)))
  (raw-remap (allocator-lease-borrow lease) memory old new))
(defn lease-raw-free [(lease (ref AllocatorLease)) (memory (ptr i8)) (request AllocRequest)] (-> i64)
  (raw-free (allocator-lease-borrow lease) memory request))

;; Each `request` specialization owns one static byte. Its address is stable and
;; unique for the life of the process, making it a process-local identity for T.
;; IDs are for diagnostics and allocator policy only; they must never be serialized.
(defn request [T] [(count i64)] (-> (Option AllocRequest))
  (let [size (primitive/sizeof T)]
    (if (or (<= count 0)
            (or (<= size 0) (> count (primitive/idiv 9223372036854775807 size))))
        (None)
        (Some (AllocRequest :type-id (primitive/cast i64 (primitive/alloc-static i8))
                            :count count
                            :bytes (primitive/imul count size)
                            :align (primitive/alignof T))))))

(defn type-id [T] [] (-> i64)
  ; Ask the canonical request specialization rather than minting a second token.
  (match (request [T] 1)
    (Some [r]
      (let [(mut request) r]
        (.type-id request)))
    ; Zero-sized types never produce an allocation request, but they still have a
    ; useful nonzero identity for reflection and diagnostics.
    (None [] (primitive/cast i64 (primitive/alloc-static i8)))))

(defn bytes-request [(count i64) (align i64)] (-> (Option AllocRequest))
  (if (or (<= count 0)
          (or (<= align 0) (!= (primitive/iand align (primitive/isub align 1)) 0)))
      (None)
      (Some (AllocRequest :type-id 0 :count count :bytes count :align align))))

; `coil.slice` imports this module, so these private constructors avoid an import cycle.
(defn alloc-slice-new [T] [(data (ptr T)) (len i64)] (-> (slice T))
  (primitive/llvm-ir (slice T) [data len]
                     "%s0 = insertvalue $ret undef, $t0 $0, 0\n%s1 = insertvalue $ret %s0, $t1 $1, 1\nret $ret %s1"))
(defn alloc-slice-data [T] [(s (slice T))] (-> (ptr T))
  (primitive/llvm-ir (ptr T) [s] "%d = extractvalue $t0 $0, 0\nret $ret %d"))
(defn alloc-slice-len [T] [(s (slice T))] (-> i64)
  (primitive/llvm-ir i64 [s] "%l = extractvalue $t0 $0, 1\nret $ret %l"))

;; Typed allocation is the default API. Even `[u8]` has a real type ID; only the
;; explicitly byte-oriented API below sends ID 0.
(defn alloc [T] [(a (dyn Allocator)) (count i64)] (-> (Option (slice T)))
  (if (= count 0)
      (Some (alloc-slice-new (primitive/cast (ptr T) 0) 0))
      (match (request [T] count)
        (None [] (None))
        (Some [r]
          (match (raw-alloc a r)
            (None [] (None))
            (Some [p] (Some (alloc-slice-new (primitive/cast (ptr T) p) count))))))))

(defn alloc-bytes [(a (dyn Allocator)) (count i64) (align i64)] (-> (Option (slice u8)))
  (if (= count 0)
      (Some (alloc-slice-new (primitive/cast (ptr u8) 0) 0))
      (match (bytes-request count align)
        (None [] (None))
        (Some [r]
          (match (raw-alloc a r)
            (None [] (None))
            (Some [p] (Some (alloc-slice-new (primitive/cast (ptr u8) p) count))))))))

; Migration-only compatibility for the old create + unwrap-ptr spelling. Keeping
; these two tiny adapters lets `coil lint --fix` type-check legacy source and replace
; the full allocate/store sequence with `box!`; new code should use `alloc` or `box`.
(defn create [T] [(a (dyn Allocator))] (-> (Option (ptr T)))
  (match (alloc [T] a 1)
    (None [] (None [(ptr T)]))
    (Some [memory] (Some (alloc-slice-data memory)))))

(defn unwrap-ptr [T] [(value (Option (ptr T)))] (-> (ptr T))
  (match value
    (None [] (primitive/cast (ptr T) 0))
    (Some [p] p)))

(defn free [T] [(a (dyn Allocator)) (memory (slice T))] (-> i64)
  (let [n (alloc-slice-len memory)]
    (if (= n 0)
        0
        (match (request [T] n)
          (None [] 0)
          (Some [r] (raw-free a (primitive/cast (ptr i8) (alloc-slice-data memory)) r))))))

(defn free-bytes [(a (dyn Allocator)) (memory (slice u8)) (align i64)] (-> i64)
  (let [n (alloc-slice-len memory)]
    (if (= n 0)
        0
        (match (bytes-request n align)
          (None [] 0)
          (Some [r] (raw-free a (primitive/cast (ptr i8) (alloc-slice-data memory)) r))))))

(defn resize [T] [(a (dyn Allocator)) (memory (slice T)) (new-count i64)] (-> (Option (slice T)))
  (let [old-count (alloc-slice-len memory)]
    (if (= new-count 0)
        (do (free [T] a memory) (Some (alloc-slice-new (primitive/cast (ptr T) 0) 0)))
        (if (= old-count 0)
            (alloc [T] a new-count)
            (match (request [T] old-count)
              (None [] (None))
              (Some [old]
                (match (request [T] new-count)
                  (None [] (None))
                  (Some [new]
                    (if (raw-resize a (primitive/cast (ptr i8) (alloc-slice-data memory)) old new)
                        (Some (alloc-slice-new (alloc-slice-data memory) new-count))
                        (None))))))))))

(defn remap [T] [(a (dyn Allocator)) (memory (slice T)) (new-count i64)] (-> (Option (slice T)))
  (let [old-count (alloc-slice-len memory)]
    (if (= new-count 0)
        (do (free [T] a memory) (Some (alloc-slice-new (primitive/cast (ptr T) 0) 0)))
        (if (= old-count 0)
            (alloc [T] a new-count)
            (match (request [T] old-count)
              (None [] (None))
              (Some [old]
                (match (request [T] new-count)
                  (None [] (None))
                  (Some [new]
                    (match (raw-remap a (primitive/cast (ptr i8) (alloc-slice-data memory)) old new)
                      (None [] (None))
                      (Some [p] (Some (alloc-slice-new (primitive/cast (ptr T) p) new-count))))))))))))

;; Guaranteed-growth convenience: remap when possible, otherwise allocate, copy, free.
(defn reallocate [T] [(a (dyn Allocator)) (memory (slice T)) (new-count i64)] (-> (Option (slice T)))
  (match (remap [T] a memory new-count)
    (Some [m] (Some m))
    (None []
      (match (alloc [T] a new-count)
        (None [] (None))
        (Some [next]
          (do
            (let [(mut i) 0
                  n (if (< (alloc-slice-len memory) new-count)
                        (alloc-slice-len memory)
                        new-count)]
              (loop (if (>= (load i) n)
                        (break)
                        (do (store! (primitive/index (alloc-slice-data next) (load i))
                                    (load (primitive/index (alloc-slice-data memory) (load i))))
                            (store! i (primitive/iadd (load i) 1))))))
            (free [T] a memory)
            (Some next)))))))

;; Allocate and initialize one value. `box!` is the intentional hard-fail spelling
;; used by code paths that cannot recover from OOM.
(defn box [(a Code) (ty Code) (value Code)] (-> Code)
  (let [memory (primitive/fresh-identifier "memory")
        pointer (primitive/fresh-identifier "pointer")]
    `(match (alloc [~ty] ~a 1)
       (None [] (None [(ptr ~ty)]))
       (Some [~memory]
         (let [~pointer (alloc-slice-data ~memory)]
           (store! ~pointer ~value)
           (Some ~pointer))))))

(defn box-oom [T] [] (-> (ptr T))
  (oom-at c"box!" (primitive/sizeof T))
  (primitive/cast (ptr T) 0))

(defn box! [(a Code) (ty Code) (value Code)] (-> Code)
  (let [result (primitive/fresh-identifier "result")]
    `(match (box ~a ~ty ~value)
       (None [] (box-oom [~ty]))
       (Some [~result] ~result))))

(defn destroy [T] [(a (dyn Allocator)) (p (ptr T))] (-> i64)
  (free [T] a (alloc-slice-new p 1)))

; ---- malloc-backed general-purpose allocator ------------------------------
(defstruct MallocAllocator [(marker i8)])

(defn malloc-allocate [(request AllocRequest)] (-> (Option (ptr i8)))
  (let [align (load (field request align))
        bytes (load (field request bytes))]
    (if (<= align 16)
        (let [p (malloc (primitive/cast isize bytes))]
          (if (= (primitive/cast i64 p) 0) (None) (Some p)))
        (let [(mut p) (primitive/cast (ptr i8) 0)]
          (if (= (posix_memalign (mut p) (primitive/cast isize align) (primitive/cast isize bytes)) 0)
              (Some (load p))
              (None))))))

(impl Allocator MallocAllocator
  (allocate [(self (ptr MallocAllocator)) (request (ref AllocRequest))] (-> (Option (ptr i8)))
    (malloc-allocate request))
  (resize [(self (ptr MallocAllocator)) (memory (ptr i8)) (old (ref AllocRequest)) (new (ref AllocRequest))] (-> bool)
    false)
  (remap [(self (ptr MallocAllocator)) (memory (ptr i8)) (old (ref AllocRequest)) (new (ref AllocRequest))] (-> (Option (ptr i8)))
    (if (> (load (field new align)) 16)
        (None)
        (let [p (realloc memory (primitive/cast isize (load (field new bytes))))]
          (if (= (primitive/cast i64 p) 0) (None) (Some p)))))
  (deallocate [(self (ptr MallocAllocator)) (memory (ptr i8)) (request (ref AllocRequest))] (-> i64)
    (primitive/free memory)))

(defn malloc-allocator [] (-> (dyn Allocator))
  (let [a (primitive/alloc-static MallocAllocator)]
    (primitive/make-dyn Allocator a)))

; Process-lifetime allocator state needs no dynamic retention, but it still uses the
; same lease representation and API as stateful allocators.
(defn malloc-lease-noop [(state (ptr i8))] (-> i64) 0)
(defn malloc-allocator-lease [] (-> AllocatorLease)
  (unsafe-allocator-lease-new (malloc-allocator)
                              (primitive/cast (ptr i8) 0)
                              (primitive/fnptr-of malloc-lease-noop)
                              (primitive/fnptr-of malloc-lease-noop)))

; ---- strict bump arena -----------------------------------------------------
(defstruct Arena [(base (ptr i8)) (off i64) (cap i64)])
(defn align-up [(x i64) (a i64)] (-> i64)
  (primitive/imul (primitive/idiv (primitive/iadd x (primitive/isub a 1)) a) a))
(defn arena-allocate [(ar (ptr Arena)) (request AllocRequest)] (-> (Option (ptr i8)))
  (let [o (align-up (load (field ar off)) (load (field request align)))
        n (load (field request bytes))]
    (if (or (> o (load (field ar cap))) (> n (primitive/isub (load (field ar cap)) o)))
        (None)
        (do (store! (field ar off) (primitive/iadd o n))
            (Some (primitive/index (load (field ar base)) o))))))
(defn arena-resize [(ar (ptr Arena)) (memory (ptr i8)) (old AllocRequest) (new AllocRequest)] (-> bool)
  (let [start (primitive/isub (primitive/cast i64 memory)
                              (primitive/cast i64 (load (field ar base))))
        old-bytes (load (field old bytes))
        new-bytes (load (field new bytes))]
    (if (and (>= start 0)
             (and (< start (load (field ar cap)))
                  (= (primitive/iadd start old-bytes) (load (field ar off)))))
        (if (> new-bytes (primitive/isub (load (field ar cap)) start))
            false
            (do (store! (field ar off) (primitive/iadd start new-bytes)) true))
        false)))

(impl Allocator Arena
  (allocate [(self (ptr Arena)) (request (ref AllocRequest))] (-> (Option (ptr i8)))
    (arena-allocate self request))
  (resize [(self (ptr Arena)) (memory (ptr i8)) (old (ref AllocRequest)) (new (ref AllocRequest))] (-> bool)
    (arena-resize self memory old new))
  (remap [(self (ptr Arena)) (memory (ptr i8)) (old (ref AllocRequest)) (new (ref AllocRequest))] (-> (Option (ptr i8)))
    (if (arena-resize self memory old new) (Some memory) (None)))
  (deallocate [(self (ptr Arena)) (memory (ptr i8)) (request (ref AllocRequest))] (-> i64) 0))

(defn arena-over-buffer [(ar (ptr Arena)) (buf (ptr i8)) (cap i64)] (-> (dyn Allocator))
  (store! (field ar base) buf)
  (store! (field ar off) 0)
  (store! (field ar cap) cap)
  (primitive/make-dyn Allocator ar))

(defn arena-allocator [(cap i64)] (-> (dyn Allocator))
  (let [ar (primitive/cast (ptr Arena) (malloc (primitive/cast isize (primitive/sizeof Arena))))]
    (arena-over-buffer ar (malloc (primitive/cast isize cap)) cap)))

; ---- bump arena with malloc overflow --------------------------------------
;; A distinct concrete type is required: a trait has exactly one implementation per
;; type, and keeping this separate also lets freestanding strict arenas dead-strip libc.
(defstruct OverflowArena [(base (ptr i8)) (off i64) (cap i64)])
(defn overflow-in-block? [(ar (ptr OverflowArena)) (memory (ptr i8))] (-> bool)
  (let [d (primitive/isub (primitive/cast i64 memory)
                          (primitive/cast i64 (load (field ar base))))]
    (and (>= d 0) (< d (load (field ar cap))))))
(defn overflow-as-arena [(ar (ptr OverflowArena))] (-> (ptr Arena))
  (primitive/cast (ptr Arena) ar))

(impl Allocator OverflowArena
  (allocate [(self (ptr OverflowArena)) (request (ref AllocRequest))] (-> (Option (ptr i8)))
    (match (arena-allocate (overflow-as-arena self) request)
      (Some [p] (Some p))
      (None [] (malloc-allocate request))))
  (resize [(self (ptr OverflowArena)) (memory (ptr i8)) (old (ref AllocRequest)) (new (ref AllocRequest))] (-> bool)
    (if (overflow-in-block? self memory)
        (arena-resize (overflow-as-arena self) memory old new)
        false))
  (remap [(self (ptr OverflowArena)) (memory (ptr i8)) (old (ref AllocRequest)) (new (ref AllocRequest))] (-> (Option (ptr i8)))
    (if (overflow-in-block? self memory)
        (if (arena-resize (overflow-as-arena self) memory old new) (Some memory) (None))
        (if (> (load (field new align)) 16)
            (None)
            (let [p (realloc memory (primitive/cast isize (load (field new bytes))))]
              (if (= (primitive/cast i64 p) 0) (None) (Some p))))))
  (deallocate [(self (ptr OverflowArena)) (memory (ptr i8)) (request (ref AllocRequest))] (-> i64)
    (if (overflow-in-block? self memory) 0 (primitive/free memory))))

(defn overflow-arena-allocator [(cap i64)] (-> (dyn Allocator))
  (let [buf (malloc (primitive/cast isize cap))]
    (if (= (primitive/cast i64 buf) 0)
        (malloc-allocator)
        (let [ar (primitive/cast (ptr OverflowArena)
                                 (malloc (primitive/cast isize (primitive/sizeof OverflowArena))))]
          (store! (field ar base) buf)
          (store! (field ar off) 0)
          (store! (field ar cap) cap)
          (primitive/make-dyn Allocator ar)))))
