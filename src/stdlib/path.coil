;;; Paths: joining and splitting them, the working directory, canonicalizing, and the
;;; glob and containment rules a project's file lists use.
(module coil.path)
(import "coil.primitive" :as primitive)
(import "coil.alloc" :use *)
(import "coil.result" :use *)
(import "coil.slice" :use *)
(import "coil.str" :use *)
(import "coil.io" :use *)
(import "coil.fs" :use [access])
(import "coil.os" :use [getcwd getenv open close])
(import "coil.cc" :as cc)

(extern realpath :cc (cc/C) [(ptr i8) (ptr i8)] (-> (ptr i8)))  ; NULL on failure

;;; `realpath`, for a path that may be relative. Every caller in the compiler goes
;;; through this one rather than through the extern.
;;;
;;; Handed a relative path, libc first has to learn the working directory, and on
;;; macOS `realpath` does not ask the kernel for it: it climbs from `.`, LISTING each
;;; parent and `stat`-ing every entry until one matches the directory below. So the
;;; cost of resolving one path is the number of siblings the working directory has.
;;; A project made by `mktemp -d` sits directly in `$TMPDIR`; with 390,000 stale
;;; entries there, every path the loader resolved cost 390,000 `stat` calls, a
;;; `coil check` of a ten-line project took two minutes, and the CLI gate two hours.
;;; `getcwd` does ask the kernel, so the path is made absolute with it first and
;;; `realpath` never needs the directory. The result is the same path either way.
;;;
;;; `out` is as for `realpath`: a buffer of PATH_MAX bytes, or null for a result the
;;; caller frees. A path too long to join falls through to `realpath` as given, which
;;; is still correct.
(defn realpath-rooted [(path (ptr i8)) (out (ptr i8))] (-> (ptr i8))
  (block :resolved
    (when (= (primitive/cast i64 (primitive/load path)) 47)
      (return-from :resolved (realpath path out)))
    (let [joined
            (primitive/cast (ptr i8) (primitive/alloc-stack (array u8 8192)))]
      (when (= (primitive/cast i64 (getcwd joined 4096)) 0)
        (return-from :resolved (realpath path out)))
      (let [(mut at) 0
            (mut from) 0]
        (loop (if (= (primitive/cast i64
                                     (primitive/load (primitive/index joined
                                                                      (primitive/load at))))
                     0)
                  (break)
                  (primitive/store! at (primitive/iadd (primitive/load at) 1))))
        (primitive/store! (primitive/index joined (primitive/load at))
                          (: 47 i8))
        (primitive/store! at (primitive/iadd (primitive/load at) 1))
        (loop (let [byte
                      (primitive/load (primitive/index path
                                                       (primitive/load from)))]
                (when (>= (primitive/load at) 8191)
                  (return-from :resolved (realpath path out)))
                (primitive/store! (primitive/index joined (primitive/load at))
                                  byte)
                (if (= (primitive/cast i64 byte) 0)
                    (break)
                    (do
                      (primitive/store! at
                                        (primitive/iadd (primitive/load at) 1))
                      (primitive/store! from
                                        (primitive/iadd (primitive/load from) 1))))))
        (realpath joined out)))))

(defn fatal-path-error [(msg (slice u8))] (-> i64)
  (let [w (stderr)]
    (print-str w "loader error: ")
    (print-str w msg)
    (print-str w "\n"))
  (abort)
  0)

(defn cwd-slice [(a (dyn Allocator))] (-> (slice u8))
  (let [buf
          (primitive/cast (ptr i8)
                          (data (match (alloc-bytes a 4096 1)
                                  (Some [s] s)
                                  (None []
                                        (do
                                          (oom-at c"compiler allocation"
                                                  4096)
                                          (slice::new (primitive/cast (ptr u8)
                                                                      0)
                                                      0))))))
        r (getcwd buf 4096)]
    (if (= (primitive/cast i64 r) 0)
        (do (fatal-path-error "getcwd failed") "")
        (from-cstr buf))))

(defn path-join [(a (dyn Allocator)) (base (slice u8)) (path (slice u8))]
  (-> (slice u8))
  (if (and (> (len path) 0)
           (= (primitive/cast i64 (get path 0)) 47))
      path
      (let [m1
              (match (concat a base "/")
                (Some [v] v)
                (None [] (oom-at c"path text" (+ (len base) 1))))]
        (match (concat a m1 path)
          (Some [v] v)
          (None [] (oom-at c"path text" (+ (len m1) (len path))))))))

(defn dirname [(p (slice u8))] (-> (slice u8))
  (let [n (len p)
        (mut idx) -1
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (when (= (primitive/cast i64 (get p (load i)))
                         47)
                  (store! idx (load i)))
                (set! i (primitive/iadd (load i) 1)))))
    (if (< (load idx) 0) "." (subslice p 0 (load idx)))))

(defn basename [(p (slice u8))] (-> (slice u8))
  (let [n (len p)
        (mut idx) -1
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (when (= (primitive/cast i64 (get p (load i)))
                         47)
                  (store! idx (load i)))
                (set! i (primitive/iadd (load i) 1)))))
    (if (< (load idx) 0)
        p
        (subslice p (primitive/iadd (load idx) 1) n))))

(defn path-readable? [(a (dyn Allocator)) (p (slice u8))] (-> bool)
  (let [fd (open (to-cstr a p) 0)]
    (if (< (primitive/cast i64 fd) 0)
        false
        (do (close fd) true))))

(defn realpath-opt [(a (dyn Allocator)) (path (slice u8))]
  (-> (Option (slice u8)))
  (let [buf
          (primitive/cast (ptr i8)
                          (data (match (alloc-bytes a 4096 1)
                                  (Some [s] s)
                                  (None []
                                        (do
                                          (oom-at c"compiler allocation"
                                                  4096)
                                          (slice::new (primitive/cast (ptr u8)
                                                                      0)
                                                      0))))))
        r (realpath-rooted (to-cstr a path) buf)]
    (if (= (primitive/cast i64 r) 0)
        (None [(slice u8)])
        (Some (from-cstr buf)))))

; `*` matches any run of bytes (directory separators included, as `find -path`
; does) and `?` one byte; everything else is literal.
(defn glob-match? [(pat (slice u8)) (s (slice u8))] (-> bool)
  (let [pn (len pat)
        sn (len s)
        (mut pi) 0
        (mut si) 0
        (mut star-p) -1
        (mut star-s) -1
        (mut fail) false]
    (loop (if (or (load fail) (>= (load si) sn))
              (break)
              (let [pc
                      (if (< (load pi) pn)
                          (primitive/cast i64 (get pat (load pi)))
                          -1)]
                (cond (= pc 42)
                        (do
                          (store! star-p (load pi))
                          (store! star-s (load si))
                          (store! pi (primitive/iadd (load pi) 1))
                          0)
                      (or (= pc 63)
                          (= pc (primitive/cast i64 (get s (load si)))))
                        (do
                          (store! pi (primitive/iadd (load pi) 1))
                          (store! si (primitive/iadd (load si) 1))
                          0)
                      (>= (load star-p) 0)
                        (do
                          (store! star-s (primitive/iadd (load star-s) 1))
                          (store! si (load star-s))
                          (store! pi (primitive/iadd (load star-p) 1))
                          0)
                      :else (do (store! fail true) 0)))))
    (loop (if (and (< (load pi) pn)
                   (= (primitive/cast i64 (get pat (load pi)))
                      42))
              (store! pi (primitive/iadd (load pi) 1))
              (break)))
    (and (not (load fail)) (= (load pi) pn))))

; One manifest `exclude` entry against one canonical source path. An entry is a
; file, a directory (which excludes everything below it), or a glob pattern.
(defn exclude-entry-matches? [(entry (slice u8)) (path (slice u8))] (-> bool)
  (let [en (len entry)
        (mut glob) false]
    (for [i 0 en]
      (let [c (primitive/cast i64 (get entry i))]
        (when (or (= c 42) (= c 63))
          (store! glob true)
          0))
      0)
    (if (load glob)
        (glob-match? entry path)
        (or (= entry path)
            (and (> (len path) en)
                 (and (= (subslice path 0 en) entry)
                      (= (primitive/cast i64 (get path en))
                         47)))))))

;;; The offset of PATH's first `/`, or -1.
(defn dep-slash [(path (slice u8))] (-> i64)
  (let [n (len path)
        (mut i) 0
        (mut found) -1]
    (loop (if (>= (load i) n)
              (break)
              (if (= (primitive/cast i64 (get path (load i)))
                     47)
                  (do (set! found (load i)) (break))
                  (set! i (primitive/iadd (load i) 1)))))
    (load found)))

;;; Whether PATH is ROOT or lies under it, compared by whole path components: link
;;; packages, the package registry and cimport headers all ask which root owns a file.
(defn dep-path-contained? [(root (slice u8)) (path (slice u8))] (-> bool)
  (let [rn (len root)
        pn (len path)
        (mut i) 0
        (mut same) (>= pn rn)]
    (loop (if (or (not (load same)) (>= (load i) rn))
              (break)
              (if (= (get root (load i)) (get path (load i)))
                  (set! i (primitive/iadd (load i) 1))
                  (set! same false))))
    (and (load same)
         (or (= pn rn)
             (and (> pn rn)
                  (or (and (= rn 1)
                           (= (primitive/cast i64 (get root 0))
                              47))
                      (= (primitive/cast i64 (get path rn))
                         47)))))))

;;; Scan PATH for `name`, the way the shell just did. "" when no entry holds it.
(defn path-in-search-path [(a (dyn Allocator)) (name (slice u8))]
  (-> (slice u8))
  (let [p (getenv (to-cstr a "PATH"))]
    (if (= (primitive/cast i64 p) 0)
        ""

        (let [path (from-cstr p)
              n (len path)
              (mut start) 0
              (mut i) 0
              (mut found) ""]
          (loop (let [at-end (>= (load i) n)
                      sep
                        (if at-end
                            true
                            (= (primitive/cast i64 (get path (load i)))
                               58))]
                  (if sep
                      ; An empty PATH entry means the working directory, as in the shell.
                      (let [entry (subslice path (load start) (load i))
                            dir
                              (if (= (len entry) 0)
                                  "."
                                  entry)
                            cand (path-join a dir name)]
                        (if (path-readable? a cand)
                            (do (set! found cand) (break))
                            (if at-end
                                (break)
                                (do
                                  (set! start (primitive/iadd (load i) 1))
                                  (set! i (primitive/iadd (load i) 1))
                                  0))))
                      (do (set! i (primitive/iadd (load i) 1)) 0))))
          (load found)))))

;;; A command name as the filesystem path of the thing it runs.
;;;
;;; A shell may keep the bare command name in argv[0] after finding the executable
;;; through PATH, so a compiler that wants to locate anything relative to ITSELF —
;;; its standard library, the native archives beside it — has to redo that lookup.
;;; realpath first (which covers absolute and cwd-relative names, and follows a
;;; symlinked `coil` to the toolchain it really belongs to), then PATH. Unresolvable
;;; names come back unchanged, so a caller never has to special-case failure.
;;;
;;; `driver.coil`'s resource paths resolve through this same function: two subtly
;;; different answers to "where am I" is how a compiler ends up finding its archives
;;; and its library in different places.
(defn resolve-command-path [(a (dyn Allocator)) (name (slice u8))]
  (-> (slice u8))
  (if (= (len name) 0)
      name
      (match (realpath-opt a name)
        (Some [p] p)
        (None []
              (match (find name "/")
                (Some [i0] name)
                (None []
                      (let [found (path-in-search-path a name)]
                        (if (= (len found) 0)
                            name
                            (match (realpath-opt a found)
                              (Some [p] p)
                              (None [] found))))))))))
