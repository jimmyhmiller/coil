(module coil.prop.show)
(import "coil.primitive" :as primitive)
(import "coil.io" :use *)
(import "coil.fmt" :use *)
(import "coil.slice" :use *)
(import "coil.arraylist" :use *)
; How a counterexample gets printed.
;
; A shrunk counterexample is only useful if you can READ it, so every type a
; property takes must know how to display itself. `PropShow` is that, as a trait —
; overridable per type, monomorphized, and derivable from a type's fields with
; `(derive PropShow T)` (see coil.prop.derive) so nobody writes it by hand.
;
; Values print as re-readable Coil-ish literals — `(1 2 3)`, `(Some 4)`, `"abc"` —
; because the first thing anyone does with a counterexample is paste it into a
; regression test.

(deftrait PropShow [Self]
  (prop-show [(x Self) (w (ptr Writer))] (-> i64)))

(impl PropShow i64
  (prop-show [(x i64) (w (ptr Writer))] (-> i64) (fmt w "{d}" x) 0))
(impl PropShow i32
  (prop-show [(x i32) (w (ptr Writer))] (-> i64) (fmt w "{d}" (primitive/cast i64 x)) 0))
(impl PropShow i16
  (prop-show [(x i16) (w (ptr Writer))] (-> i64) (fmt w "{d}" (primitive/cast i64 x)) 0))
(impl PropShow i8
  (prop-show [(x i8) (w (ptr Writer))] (-> i64) (fmt w "{d}" (primitive/cast i64 x)) 0))
(impl PropShow u64
  (prop-show [(x u64) (w (ptr Writer))] (-> i64) (fmt w "{d}" (primitive/cast i64 x)) 0))
(impl PropShow u32
  (prop-show [(x u32) (w (ptr Writer))] (-> i64) (fmt w "{d}" (primitive/cast i64 x)) 0))
(impl PropShow u16
  (prop-show [(x u16) (w (ptr Writer))] (-> i64) (fmt w "{d}" (primitive/cast i64 x)) 0))
(impl PropShow u8
  (prop-show [(x u8) (w (ptr Writer))] (-> i64) (fmt w "{d}" (primitive/cast i64 x)) 0))
(impl PropShow bool
  (prop-show [(x bool) (w (ptr Writer))] (-> i64) (print-str w (if x "true" "false")) 0))
(impl PropShow f64
  (prop-show [(x f64) (w (ptr Writer))] (-> i64) (fmt w "{f}" x) 0))
(impl PropShow f32
  (prop-show [(x f32) (w (ptr Writer))] (-> i64) (fmt w "{f}" (primitive/cast f64 x)) 0))

;; Strings print quoted, with the bytes that would otherwise be invisible escaped —
;; a counterexample containing a stray newline or a NUL must LOOK different from
;; one that does not, or the report lies about what failed.
(impl PropShow (slice u8)
  (prop-show [(x (slice u8)) (w (ptr Writer))]
             (-> i64)
             (print-str w "\"")
             (let [(mut i) 0]
               (loop (if (>= (load i) (slice-len [u8] x))
                         (break)
                         (do
                           (show-byte w (primitive/cast i64 (slice-get [u8] x (load i))))
                           (store! i (primitive/iadd (load i) 1))))))
             (print-str w "\"")
             0))

(defn show-byte [(w (ptr Writer)) (b i64)] (-> i64)
  (if (= b 34)
      (do (print-str w "\\\"") 0)
      (if (= b 92)
          (do (print-str w "\\\\") 0)
          (if (= b 10)
              (do (print-str w "\\n") 0)
              (if (= b 9)
                  (do (print-str w "\\t") 0)
                  (if (= b 13)
                      (do (print-str w "\\r") 0)
                      (if (or (< b 32) (> b 126))
                          (do (fmt w "\\x{x}" b) 0)
                          (do (write-byte w b) 0))))))))

(defn write-byte [(w (ptr Writer)) (b i64)] (-> i64)
  (let [p (primitive/alloc-stack u8)]
    (store! p (primitive/cast u8 b))
    (print-str w (slice-new [u8] p 1))
    0))

(impl [(T PropShow)] PropShow (ArrayList T)
  (prop-show [(x (ArrayList T)) (w (ptr Writer))]
             (-> i64)
             (print-str w "(")
             (let [(mut i) 0
                   n (al-len [T] x)]
               (loop (if (>= (load i) n)
                         (break)
                         (do
                           (if (> (load i) 0) (do (print-str w " ") 0) 0)
                           (prop-show (al-get [T] x (load i)) w)
                           (store! i (primitive/iadd (load i) 1))))))
             (print-str w ")")
             0))

(impl [(T PropShow)] PropShow (Option T)
  (prop-show [(x (Option T)) (w (ptr Writer))]
             (-> i64)
             (match x
               (None [] (do (print-str w "(None)") 0))
               (Some [v] (do (print-str w "(Some ") (prop-show v w) (print-str w ")") 0)))))

;; `name = value`, the shape every counterexample line takes.
(defn show-named [(T PropShow)] [(w (ptr Writer)) (name (slice u8)) (v T)] (-> i64)
  (print-str w "    ")
  (print-str w name)
  (print-str w " = ")
  (prop-show v w)
  (print-str w "\n")
  0)

;; One `name = value` counterexample line on stdout. `defprop` expands to calls of
;; this, so it lives here (next to the trait it is bounded on) rather than in
;; coil.prop, and a property's file needs no `coil.io` import of its own.
;;
;; ⚠ It repeats `show-named`'s body instead of calling it. A bounded generic
;; calling ANOTHER bounded generic with the same bound is rejected by the checker
;; ("'T' does not implement 'PropShow'") — the bound does not propagate across
;; that edge. A direct trait-method call on a bounded parameter is fine, which is
;; what this does.
(defn prop-show-arg [(T PropShow)] [(name (slice u8)) (v T)] (-> i64)
  (let [w (stdout)]
    (print-str w "    ")
    (print-str w name)
    (print-str w " = ")
    (prop-show v w)
    (print-str w "\n")
    0))
