(module coil.fs)
(import "coil.primitive" :as primitive)

; Filesystem access — the difference between a demo and a language you can script with.
; A thin, explicit LIBRARY over the POSIX file syscalls, built on the SAME capability
; values as the rest of the stdlib: an allocator threaded in for the whole-file helpers,
; and src/stdlib/io.coil's `Reader`/`Writer` for streaming. No ambient state, no compiler magic.
;
;   (import "coil.fs" :use *) (import "coil.alloc" :use *)
;   (let [a (malloc-allocator)]
;     (match (read-file a "notes.txt") (Ok [s] …) (Err [e] …))
;     (write-file a "out.txt" "hello\n"))
;
; `read`/`write` come from src/stdlib/io.coil (declared there, `:use *`d here — Coil doesn't
; dedup extern decls across modules, so each libc symbol is declared in exactly ONE
; module); `open`/`close` are declared here because no other bundled module needs them.
(import "coil.io" :use *)  ; read/write, Reader/Writer, IoError/Errno/Eof, fd-reader/fd-writer, write-all

(import "coil.result" :use *)  ; Result/Ok/Err

(import "coil.alloc" :as alloc :use *)  ; Allocator and typed allocation helpers

(import "coil.os" :as os)
(import "coil.arraylist" :use *)  ; ArrayList — accumulate a whole file, al-into-slice

(import "coil.slice" :use *)  ; slice-data/len, al-into-slice's (slice T)

(import "coil.str" :use *)  ; str->cstr — a (slice u8) path to a C string

;; `open` and `close` are declared once in `coil.os`, avoiding duplicate externs when
;; filesystem and subprocess facilities are used together.

;;; open() flags. Combine with `|`.
;;;
;;; Four of these DIFFER between Linux and macOS, so they cannot be written as
;;; plain literals: hardcoding the darwin values (as this file used to) makes
;;; every create-or-truncate open fail on Linux, because 512 means O_TRUNC there
;;; rather than O_CREAT.
;;;
;;;                    linux   darwin
;;;   O_APPEND          1024        8
;;;   O_CREAT             64      512
;;;   O_TRUNC            512     1024
;;;   O_EXCL             128     2048
;;;
;;; `(primitive/target-os)` is a comptime code op — a builtin like `target-arch`/`gensym`,
;;; so it needs no import — and it answers for the platform being COMPILED FOR,
;;; read from the resolved --target triple. That is the whole point: these are
;;; syscall arguments, so the only OS that matters is the one that will run the
;;; binary. Selecting on it inside a `const` keeps the flags true compile-time
;;; constants (one folded literal at each use, no runtime branch) while still
;;; being correct under cross-compilation.
(defn os-pick [(linux Code) (darwin Code)] (-> Code)
  (if (primitive/code-eq (primitive/target-os) `linux) linux darwin))

;;; hygiene: platform file constants intentionally enter this module's public namespace.
(defn fs--explicit-public-name [(name Code)] (-> Code)
  (primitive/syntax->datum name))

;;; `mkdir` and `creat`, declared with the target's `mode_t` (u32 on Linux, u16 on
;;; Darwin), so a program that declares the same C prototype shares these
;;; declarations. Most code calls `make-dir`/`create-file`, which take the mode as
;;; an ordinary integer.
(defn gen-mkdir [] (-> Code)
  (let [mode-t (os-pick `u32 `u16)
        mkdir (fs--explicit-public-name `mkdir)]
    `(do
       (extern ~mkdir :cc c [(ptr i8) ~mode-t] (-> i32))
       ;;; Create directory `path` (a C string) with permission bits `mode`;
       ;;; returns mkdir's result (0, or -1 with errno set).
       (defn ~(fs--explicit-public-name `make-dir) [(path (ptr i8)) (mode i64)] (-> i32)
         (~mkdir path (primitive/cast ~mode-t mode)))
       (extern ~(fs--explicit-public-name `creat) :cc c [(ptr i8) ~mode-t] (-> i32))
       ;;; Create (or truncate) file `path` for writing with permission bits `mode`;
       ;;; returns the descriptor, or a negative value on failure.
       (defn ~(fs--explicit-public-name `create-file) [(path (ptr i8)) (mode i64)] (-> i64)
         (primitive/cast i64 (~(fs--explicit-public-name `creat) path (primitive/cast ~mode-t mode))))
       (extern ~(fs--explicit-public-name `fchmod) :cc c [i32 ~mode-t] (-> i32))
       ;;; Set the permission bits of the open file `fd` to `mode`; returns fchmod's
       ;;; result (0, or -1 with errno set: EPERM when we do not own it).
       (defn ~(fs--explicit-public-name `change-mode) [(fd i32) (mode i64)] (-> i32)
         (~(fs--explicit-public-name `fchmod) fd (primitive/cast ~mode-t mode))))))

(meta (gen-mkdir))

(defn gen-open-flags [] (-> Code)
  `(do
     (const ~(fs--explicit-public-name `O_APPEND) ~(os-pick `1024 `8))
     (const ~(fs--explicit-public-name `O_CREAT) ~(os-pick `64 `512))
     (const ~(fs--explicit-public-name `O_TRUNC) ~(os-pick `512 `1024))
     (const ~(fs--explicit-public-name `O_EXCL) ~(os-pick `128 `2048))
     (const ~(fs--explicit-public-name `O_NOFOLLOW) ~(os-pick `131072 `256))
     (const ~(fs--explicit-public-name `O_DIRECTORY) ~(os-pick `65536 `1048576))
     (const ~(fs--explicit-public-name `O_CLOEXEC) ~(os-pick `524288 `16777216))))

(const O_RDONLY 0)

(const O_WRONLY 1)

(const O_RDWR 2)

(meta (gen-open-flags))

;;; a sensible default create mode (rw-r--r--) for the whole-file writer.
(const FILE_MODE_DEFAULT 420)  ; 0o644

;;; An open file is its descriptor. A one-field struct (not a bare i64) so the type
;;; distinguishes "a file handle" from "some integer" at call sites.
(defstruct File [(fd i64)])

(defn mk-file [(fd i64)] (-> File)
  (let [(mut f) (primitive/zeroed File)] (store! (field f fd) fd) (load f)))

(defn file-fd [(f (ptr File))] (-> i64)
  (load (field f fd)))

; ---- open / close ----------------------------------------------------------
;;; Open `path` (a C string) with `flags` (O_* above) and `mode` (used only when the
;;; open creates the file). `(Err (Errno …))` carries the negative return on failure.
(defn file-open [(path (ptr i8)) (flags i64) (mode i64)] (-> (Result File
                                                                       IoError))
  (let [fd (primitive/cast i64 (os/open path (primitive/cast i32 flags) mode))]
    (if (< fd (cast i64 0)) (Err (Errno (os/os-errno))) (Ok (mk-file fd)))))

(defn file-close [(f (ptr File))] (-> (Result i64 IoError))
  (let [r (primitive/cast i64 (os/close (primitive/cast i32 (file-fd f))))]
    (if (< r (cast i64 0)) (Err (Errno (os/os-errno))) (Ok r))))

; ---- streaming: a File as an io Reader / Writer ----------------------------
;;; Bridge a File to src/stdlib/io.coil's capabilities, so every Reader/Writer combinator
;;; (print-str, write-all, read-line, …) works over a file.
;;;
;;; The Reader/Writer is CALLER-OWNED: you pass in the storage, exactly as
;;; `fd-reader`/`fd-writer` require. Instance state must never come from
;;; `alloc-static` — a static here would be one shared Reader and one shared
;;; Writer for the whole program, so two files open at once would silently
;;; alias and writes would land on the wrong fd. (That is not hypothetical:
;;; stdout/stderr sharing a static is what once made `coil emit-ir f > f.ll`
;;; produce an empty file.)
;;;
;;;   (let [out (file-writer (primitive/alloc-stack Writer) f)]
;;;     (print-str out "hello\n"))
(defn file-reader [(r (ptr Reader)) (f (ptr File))] (-> (ptr Reader))
  (fd-reader r (file-fd f)))

(defn file-writer [(w (ptr Writer)) (f (ptr File))] (-> (ptr Writer))
  (fd-writer w (file-fd f)))

; ---- whole-file helpers over an allocator ----------------------------------
;;; Read the ENTIRE file at `path` into a freshly-allocated `(slice u8)` the caller owns
;;; (`free [u8]` it with `a`). Streams in 4 KiB chunks into an ArrayList, then hands over a
;;; right-sized buffer via `al-into-slice`. `(Err …)` on an open/read failure.
(defn read-file [(a (dyn Allocator)) (path (slice u8))] (-> (Result (slice u8)
                                                                    IoError))
  (let [cp (str->cstr a path)]
    (if (= (primitive/cast i64 cp) (cast i64 0))
        (Err (OutOfMemory))  ; building the C path
        (let [fd (os/open cp (primitive/cast i32 O_RDONLY) 0)
              open-errno
                (if (< (primitive/cast i64 fd) (cast i64 0)) (os/os-errno) 0)]
          (if (< fd (cast i32 0))
              (do
                (free-bytes a
                            (slice-new [u8]
                                       (primitive/cast (ptr u8) cp)
                                       (primitive/iadd (slice-len path) 1))
                            1)
                (Err (Errno open-errno)))
              (let [(mut buf) (al-new [u8] a)
                    tmp (primitive/alloc-stack (array u8 4096))
                    res
                      (block :done
                             (loop (let [n
                                           (primitive/cast i64
                                                             (read fd
                                                                   (primitive/cast (ptr i8)
                                                                                   (primitive/index tmp
                                                                                                    0))
                                                                   (primitive/cast isize
                                                                                   4096)))]
                                     (if (< n (cast i64 0))
                                         (do
                                           (al-free! (mut buf))
                                           (return-from :done
                                                          (Err [(slice u8)
                                                                IoError]
                                                               (Errno (os/os-errno)))))
                                         (if (= n (cast i64 0))
                                             (break)  ; EOF
                                             (let [(mut j) 0]
                                               (loop (if (>= (load j) n)
                                                         (break)
                                                         (do
                                                           (al-push! (mut buf)
                                                                     (load (primitive/index (primitive/index tmp
                                                                                                             0)
                                                                                            (load j))))
                                                           (store! j
                                                                   (primitive/iadd (load j)
                                                                                   1))))))))))
                             (Ok [(slice u8) IoError] (al-into-slice (mut buf))))]
                (os/close fd)
                (free-bytes a
                            (slice-new [u8]
                                       (primitive/cast (ptr u8) cp)
                                       (primitive/iadd (slice-len path) 1))
                            1)
                res))))))

;;; Write `data` to `path`, creating/truncating it (mode 0o644). Returns the byte count.
(defn write-file [(a (dyn Allocator)) (path (slice u8)) (data (slice u8))] (-> (Result i64
                                                                                         IoError))
  (let [cp (str->cstr a path)]
    (if (= (primitive/cast i64 cp) (cast i64 0))
        (Err (OutOfMemory))
        (let [fd
                (os/open cp
                         (primitive/cast i32 (| O_WRONLY (| O_CREAT O_TRUNC)))
                         FILE_MODE_DEFAULT)
              open-errno
                (if (< (primitive/cast i64 fd) (cast i64 0)) (os/os-errno) 0)
              ; the Writer is this call's own instance, on its own frame — never
              ; a static, which would alias with any other stream in flight.
              w (primitive/alloc-stack Writer)
              res
                (if (< fd (cast i32 0))
                    (Err [i64 IoError] (Errno open-errno))
                    (write-all (fd-writer w (primitive/cast i64 fd))
                               (primitive/cast (ptr i8) (slice-data data))
                               (slice-len data)))]
          (if (>= fd (cast i32 0)) (os/close fd) 0)
          (free-bytes a
                      (slice-new [u8]
                                 (primitive/cast (ptr u8) cp)
                                 (primitive/iadd (slice-len path) 1))
                      1)
          res))))

; ---- directories, renames, shared mappings ---------------------------------
(extern opendir :cc c [(ptr i8)] (-> (ptr i8)))

(extern readdir :cc c [(ptr i8)] (-> (ptr i8)))

(extern closedir :cc c [(ptr i8)] (-> i32))

(extern rename :cc c [(ptr i8) (ptr i8)] (-> i32))

(extern ftruncate :cc c [i32 i64] (-> i32))

(extern mmap :cc c [(ptr i8) i64 i32 i32 i32 i64] (-> (ptr i8)))

;;; `struct dirent` differs between the platforms before `d_name`, the only field
;;; read here. Darwin's offset is the 64-bit-inode layout, which plain `readdir`
;;; returns on arm64.
(defn gen-dirent-name-offset [] (-> Code)
  `(const ~(fs--explicit-public-name `DIRENT-NAME-OFFSET) ~(os-pick `19 `21)))

(meta (gen-dirent-name-offset))

;; The C path for `path`, or null when it could not be allocated. Free with
;; `fs--free-cstr`.
(defn fs--cstr [(a (dyn Allocator)) (path (slice u8))] (-> (ptr i8))
  (str->cstr a path))

(defn fs--free-cstr [(a (dyn Allocator)) (path (slice u8)) (cp (ptr i8))] (-> i64)
  (if (= (primitive/cast i64 cp) (cast i64 0))
      0
      (free-bytes a
                  (slice-new [u8]
                             (primitive/cast (ptr u8) cp)
                             (primitive/iadd (slice-len path) 1))
                  1)))

;;; The names in the directory at `path`, without `.` and `..`, in whatever order
;;; the filesystem returns them. Each name is an owning slice from `a`; free the
;;; list with `dir-list-free`.
(defn dir-list [(a (dyn Allocator)) (path (slice u8))] (-> (Result (ArrayList (slice u8))
                                                                   IoError))
  (let [cp (fs--cstr a path)]
    (if (= (primitive/cast i64 cp) (cast i64 0))
        (Err (OutOfMemory))
        (let [d (opendir cp)
              open-errno
                (if (= (primitive/cast i64 d) (cast i64 0)) (os/os-errno) 0)]
          (fs--free-cstr a path cp)
          (if (= (primitive/cast i64 d) (cast i64 0))
              (Err (Errno open-errno))
              (let [(mut out) (al-new [(slice u8)] a)
                    (mut read-errno) 0]
                ; readdir returns null both at the end and on error; only errno
                ; tells them apart, so clear it before each call.
                (loop (os/os-set-errno! 0)
                      (let [e (readdir d)]
                        (if (= (primitive/cast i64 e) (cast i64 0))
                            (do (store! read-errno (os/os-errno)) (break))
                            (let [nm
                                    (cstr->str (primitive/cast (ptr i8)
                                                               (primitive/index (primitive/cast (ptr u8)
                                                                                                e)
                                                                                DIRENT-NAME-OFFSET)))]
                              (if (or (= nm ".") (= nm ".."))
                                  0
                                  (let [(mut sb) (sb-new a)]
                                    (sb-push-str! (mut sb) nm)
                                    (al-push! (mut out) (sb-finish! (mut sb)))
                                    0))))))
                (closedir d)
                (if (= read-errno 0)
                    (Ok (load out))
                    (do
                      (dir-list-free a (mut out))
                      (Err (Errno read-errno))))))))))

;;; Free a list `dir-list` returned.
(defn dir-list-free [(a (dyn Allocator)) (names (mut (ArrayList (slice u8))))] (-> i64)
  (let [n (al-len (load names))
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (let [s (al-get (load names) (load i))]
                (if (= (primitive/cast i64 (slice-data s)) (cast i64 0))
                    0
                    (free-bytes a s 1))
                (store! i (primitive/iadd (load i) 1))
                0)))
    (al-free! (mut names))
    0))

;;; ---- existence ----------------------------------------------------------------
(extern access :cc c [(ptr i8) i32] (-> i32))

;;; Is there anything at `path`? `access(path, F_OK)` as a boolean flattens every
;;; failure into "no"; here only ENOENT and ENOTDIR (nothing is there, or a parent is
;;; not a directory) answer `Ok false`. Any other failure — EACCES on a parent, ELOOP,
;;; ENAMETOOLONG — is `Err`, because the path may well exist. A symbolic link is
;;; followed, so a dangling one is `Ok false`.
(defn exists? [(a (dyn Allocator)) (path (slice u8))] (-> (Result bool IoError))
  (let [cp (fs--cstr a path)]
    (if (= (primitive/cast i64 cp) (cast i64 0))
        (Err (OutOfMemory))
        (let [r (primitive/cast i64 (access cp 0))
              e (if (< r (cast i64 0)) (os/os-errno) 0)]
          (fs--free-cstr a path cp)
          (cond (= r (cast i64 0)) (Ok true)
                (or (= e 2) (= e 20)) (Ok false)
                :else (Err (Errno e)))))))

;;; ---- a directory as a handle ----------------------------------------------------
;;; `dir-list` reads a whole directory by path. A `Directory` is the open directory
;;; itself: entries stream out of it one at a time without being copied, and a file
;;; is opened RELATIVE to it, so the open cannot be redirected by a rename of a
;;; parent after the directory was opened, and it costs one path component of lookup
;;; instead of the whole path.
;;;
;;;   (match (directory-open a "src")
;;;     (Ok [dir]
;;;       (loop (match (directory-next! (mut dir))
;;;               (Ok [(Some [entry])] (use (.name entry)))
;;;               (_ (break))))
;;;       (directory-close! (mut dir))))
(extern dirfd :cc c [(ptr i8)] (-> i32))

(extern openat :cc c [i32 (ptr i8) i32 ...] (-> i32))

;;; `d_type` sits one byte before `d_name` on both layouts `DIRENT-NAME-OFFSET` names.
(defn gen-dirent-type-offset [] (-> Code)
  `(const ~(fs--explicit-public-name `DIRENT-TYPE-OFFSET) ~(os-pick `18 `20)))

(meta (gen-dirent-type-offset))

(defstruct Directory [(handle (ptr i8))])

;;; What `d_type` says an entry is. `EntryUnknown` is not an error: some filesystems
;;; do not fill it in, and then only `stat` knows.
(defsum EntryKind
  (EntryRegular)
  (EntryDirectory)
  (EntrySymlink)
  (EntryOther)
  (EntryUnknown))

;;; One entry. `name` is BORROWED from the directory stream: it is valid until the next
;;; `directory-next!` or `directory-close!` on the same `Directory`. Copy it to keep it.
(defstruct DirEntry [(name (slice u8)) (kind EntryKind)])

(defn fs--entry-kind [(d-type i64)] (-> EntryKind)
  (cond (= d-type (cast i64 8)) (EntryRegular)
        (= d-type (cast i64 4)) (EntryDirectory)
        (= d-type (cast i64 10)) (EntrySymlink)
        (= d-type (cast i64 0)) (EntryUnknown)
        :else (EntryOther)))

;;; Open the directory at `path`.
(defn directory-open [(a (dyn Allocator)) (path (slice u8))] (-> (Result Directory IoError))
  (let [cp (fs--cstr a path)]
    (if (= (primitive/cast i64 cp) (cast i64 0))
        (Err (OutOfMemory))
        (let [d (opendir cp)
              open-errno
                (if (= (primitive/cast i64 d) (cast i64 0)) (os/os-errno) 0)]
          (fs--free-cstr a path cp)
          (if (= (primitive/cast i64 d) (cast i64 0))
              (Err (Errno open-errno))
              (Ok (Directory :handle d)))))))

;;; The next entry, `Ok (None)` at the end, skipping `.` and `..`. Order is whatever the
;;; filesystem returns. `readdir` returns null both at the end and on error; only
;;; errno tells them apart, so it is cleared before each call.
(defn directory-next! [(d (ptr Directory))] (-> (Result (Option DirEntry) IoError))
  (let [(mut out) (Ok [(Option DirEntry) IoError] (None [DirEntry]))]
    (loop (os/os-set-errno! 0)
          (let [e (readdir (.handle d))]
            (if (= (primitive/cast i64 e) (cast i64 0))
                (let [err (os/os-errno)]
                  (when (!= err 0) (set! out (Err [(Option DirEntry) IoError] (Errno err))))
                  (break))
                (let [bytes (primitive/cast (ptr u8) e)
                      nm (cstr->str (primitive/cast (ptr i8)
                                                    (primitive/index bytes DIRENT-NAME-OFFSET)))]
                  (unless (or (= nm ".") (= nm ".."))
                    (set! out
                          (Ok [(Option DirEntry) IoError]
                              (Some (DirEntry
                                      :name nm
                                      :kind (fs--entry-kind
                                              (primitive/cast i64
                                                              (load (primitive/index bytes
                                                                                     DIRENT-TYPE-OFFSET))))))))
                    (break))))))
    (load out)))

;;; Open `name` (a C string) relative to `d`, with `open`'s flags and mode. An absolute
;;; `name` ignores `d`, as `openat` does.
(defn file-open-at [(d (ptr Directory)) (name (ptr i8)) (flags i64) (mode i64)] (-> (Result File
                                                                                              IoError))
  (let [fd (primitive/cast i64 (openat (dirfd (.handle d)) name (primitive/cast i32 flags) mode))]
    (if (< fd (cast i64 0)) (Err (Errno (os/os-errno))) (Ok (mk-file fd)))))

;;; Close the directory. Files opened from it stay open: they are separate descriptors.
(defn directory-close! [(d (ptr Directory))] (-> (Result i64 IoError))
  (let [r (primitive/cast i64 (closedir (.handle d)))]
    (if (< r (cast i64 0)) (Err (Errno (os/os-errno))) (Ok r))))

;;; Rename `from` to `to`, replacing `to` if it exists. Atomic within one
;;; filesystem, which is what makes "write a temporary, then rename" the way to
;;; publish a file that concurrent readers must never see half-written.
(defn rename-file [(a (dyn Allocator)) (from (slice u8)) (to (slice u8))] (-> (Result i64
                                                                                         IoError))
  (let [cf (fs--cstr a from)
        ct (fs--cstr a to)
        r
          (if (or (= (primitive/cast i64 cf) (cast i64 0))
                  (= (primitive/cast i64 ct) (cast i64 0)))
              (Err [i64 IoError] (OutOfMemory))
              (if (< (primitive/cast i64 (rename cf ct)) (cast i64 0))
                  (Err [i64 IoError] (Errno (os/os-errno)))
                  (Ok [i64 IoError] 0)))]
    (fs--free-cstr a from cf)
    (fs--free-cstr a to ct)
    r))

;;; Create (or reuse) the file at `path`, size it to exactly `size` bytes, and map
;;; it read-write and SHARED. Stores through the returned pointer reach the file
;;; with no further system call, and they survive the process: a writer that is
;;; killed mid-run leaves what it last stored for another process to read. The
;;; mapping lasts until the process exits.
(defn map-shared-file [(a (dyn Allocator)) (path (slice u8)) (size i64)] (-> (Result (ptr u8)
                                                                                         IoError))
  (let [cp (fs--cstr a path)]
    (if (= (primitive/cast i64 cp) (cast i64 0))
        (Err (OutOfMemory))
        (let [fd (os/open cp (primitive/cast i32 (| O_RDWR O_CREAT)) FILE_MODE_DEFAULT)
              open-errno
                (if (< (primitive/cast i64 fd) (cast i64 0)) (os/os-errno) 0)]
          (fs--free-cstr a path cp)
          (if (< fd (cast i32 0))
              (Err (Errno open-errno))
              (if (< (primitive/cast i64 (ftruncate fd size)) (cast i64 0))
                  (let [e (os/os-errno)]
                    (os/close fd)
                    (Err (Errno e)))
                  ; PROT_READ|PROT_WRITE = 3 and MAP_SHARED = 1 on both platforms.
                  (let [p (mmap (primitive/cast (ptr i8) 0) size 3 1 fd 0)
                        e (os/os-errno)]
                    (os/close fd)
                    (if (= (primitive/cast i64 p) (cast i64 -1))
                        (Err (Errno e))
                        (Ok (primitive/cast (ptr u8) p))))))))))
