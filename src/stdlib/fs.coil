(module coil.fs)
(export File Directory DirEntry EntryKind
        EntryRegular EntryDirectory EntrySymlink EntryOther EntryUnknown
        read-file write-file exists? rename-file map-shared-file
        open-file open-file-at create-dir make-dir create-file change-mode
        O_RDONLY O_WRONLY O_RDWR O_APPEND O_CREAT O_TRUNC O_EXCL O_NOFOLLOW
        O_DIRECTORY O_CLOEXEC FILE_MODE_DEFAULT
        opendir readdir closedir rename ftruncate mmap access dirfd openat mkdir creat fchmod DIRENT-NAME-OFFSET DIRENT-TYPE-OFFSET)
(import "coil.primitive" :as primitive)

; Filesystem access — the difference between a demo and a language you can script with.
; A thin, explicit LIBRARY over the POSIX file syscalls, built on the SAME capability
; values as the rest of the stdlib: an allocator threaded in for the whole-file helpers,
; and src/stdlib/io.coil's `Reader`/`Writer` for streaming. No ambient state, no compiler magic.
;
;   (import "coil.fs" :use *) (import "coil.alloc" :use *)
;   (let [a (malloc-allocator)]
;     (match (read-file a "notes.txt") (Ok [s] …) (Err [e] …))
;     (write-file a "out.txt" "hello\n"))
;
; `read`/`write` come from src/stdlib/io.coil (declared there, `:use *`d here — Coil doesn't
; dedup extern decls across modules, so each libc symbol is declared in exactly ONE
; module); `open`/`close` are declared here because no other bundled module needs them.
(import "coil.io" :use *)  ; read/write, Reader/Writer, IoError/Errno/Eof, write-all

(import "coil.result" :use *)  ; Result/Ok/Err

(import "coil.alloc" :as alloc :use *)  ; Allocator and typed allocation helpers

(import "coil.os" :as os)
(os/requires-os)  ; it calls the operating system
(import "coil.arraylist" :use *)  ; ArrayList — accumulate a whole file, into-slice

(import "coil.str" :use *)  ; to-cstr — a (slice u8) path to a C string
(import "coil.cc" :as cc)

;; `open` and `close` are declared once in `coil.os`, avoiding duplicate externs when
;; filesystem and subprocess facilities are used together.

;;; open() flags. Combine with `|`.
;;;
;;; Four of these DIFFER between Linux and macOS, so they cannot be written as
;;; plain literals: hardcoding the darwin values (as this file used to) makes
;;; every create-or-truncate open fail on Linux, because 512 means O_TRUNC there
;;; rather than O_CREAT.
;;;
;;;                    linux   darwin
;;;   O_APPEND          1024        8
;;;   O_CREAT             64      512
;;;   O_TRUNC            512     1024
;;;   O_EXCL             128     2048
;;;
;;; `(target-os)` is a compile-time question, like `(target-arch)`, so it needs no
;;; import, and it answers for the platform being COMPILED FOR,
;;; read from the resolved --target triple. That is the whole point: these are
;;; syscall arguments, so the only OS that matters is the one that will run the
;;; binary. Selecting on it inside a `const` keeps the flags true compile-time
;;; constants (one folded literal at each use, no runtime branch) while still
;;; being correct under cross-compilation.

;;; hygiene: platform file constants intentionally enter this module's public namespace.
(defn explicit-public-name [(name Code)] (-> Code)
  (primitive/syntax->datum name))

;;; `mkdir` and `creat`, declared with the target's `mode_t` (u32 on Linux, u16 on
;;; Darwin), so a program that declares the same C prototype shares these
;;; declarations. Most code calls `make-dir`/`create-file`, which take the mode as
;;; an ordinary integer.
(defn gen-mkdir [] (-> Code)
  (let [mode-t (os/os-pick `u32 `u16 `u16)
        mkdir (explicit-public-name `mkdir)]
    `(do
       (extern ~mkdir :cc (cc/C) [(ptr i8) ~mode-t] (-> i32))
       ;;; Create directory `path` (a C string) with permission bits `mode`;
       ;;; returns mkdir's result (0, or -1 with errno set).
       (defn ~(explicit-public-name `make-dir) [(path (ptr i8)) (mode i64)] (-> i32)
         (~mkdir path (primitive/cast ~mode-t mode)))
       (extern ~(explicit-public-name `creat) :cc (cc/C) [(ptr i8) ~mode-t] (-> i32))
       ;;; Create (or truncate) file `path` for writing with permission bits `mode`;
       ;;; returns the descriptor, close-on-exec, or a negative value on failure.
       ;;; `creat`, with the close-on-exec flag it cannot take.
       (defn ~(explicit-public-name `create-file) [(path (ptr i8)) (mode i64)] (-> i64)
         (primitive/cast i64
                         (os/open path
                                  (primitive/cast i32 (| O_WRONLY (| O_CREAT (| O_TRUNC O_CLOEXEC))))
                                  mode)))
       (extern ~(explicit-public-name `fchmod) :cc (cc/C) [i32 ~mode-t] (-> i32))
       ;;; Set the permission bits of the open file `fd` to `mode`; returns fchmod's
       ;;; result (0, or -1 with errno set: EPERM when we do not own it).
       (defn ~(explicit-public-name `change-mode) [(fd i32) (mode i64)] (-> i32)
         (~(explicit-public-name `fchmod) fd (primitive/cast ~mode-t mode))))))

(meta (gen-mkdir))

(defn gen-open-flags [] (-> Code)
  `(do
     (const ~(explicit-public-name `O_APPEND) ~(os/os-pick `1024 `8 `8))
     (const ~(explicit-public-name `O_CREAT) ~(os/os-pick `64 `512 `512))
     (const ~(explicit-public-name `O_TRUNC) ~(os/os-pick `512 `1024 `1024))
     (const ~(explicit-public-name `O_EXCL) ~(os/os-pick `128 `2048 `2048))
     (const ~(explicit-public-name `O_NOFOLLOW) ~(os/os-pick `131072 `256 `256))
     (const ~(explicit-public-name `O_DIRECTORY) ~(os/os-pick `65536 `1048576 `1048576))
     (const ~(explicit-public-name `O_CLOEXEC) ~(os/os-pick `524288 `16777216 `16777216))))

(const O_RDONLY 0)

(const O_WRONLY 1)

(const O_RDWR 2)

(meta (gen-open-flags))

;;; a sensible default create mode (rw-r--r--) for the whole-file writer.
(const FILE_MODE_DEFAULT 420)  ; 0o644

;;; An open file is its descriptor. A one-field struct (not a bare i64) so the type
;;; distinguishes "a file handle" from "some integer" at call sites.
(defstruct File [(fd i64)])

(defn mk-file [(fd i64)] (-> File)
  (let [(mut f) (primitive/zeroed File)] (store! (field f fd) fd) (load f)))

; ---- streaming: a File as an io Reader / Writer ----------------------------
;;; Bridge a File to src/stdlib/io.coil's capabilities, so every Reader/Writer combinator
;;; (print-str, write-all, read-line, …) works over a file.
;;;
;;; The Reader/Writer is CALLER-OWNED: you pass in the storage, exactly as
;;; `Reader::from-fd`/`Writer::from-fd` require. Instance state must never come from
;;; `alloc-static` — a static here would be one shared Reader and one shared
;;; Writer for the whole program, so two files open at once would silently
;;; alias and writes would land on the wrong fd. (That is not hypothetical:
;;; stdout/stderr sharing a static is what once made `coil emit-ir f > f.ll`
;;; produce an empty file.)
;;;
;;;   (let [out (File::writer (primitive/alloc-stack Writer) f)]
;;;     (print-str out "hello\n"))
(impl File
  ;;; The descriptor.
  (fd [(f (ptr File))] (-> i64)
    (load (field f fd)))

  ;;; Open `path` (a C string) with `flags` (O_* above) and `mode` (used only when
  ;;; the open creates the file). `(Err (Errno …))` carries errno on failure.
  ;;; `open-file` takes the path as a `(slice u8)`. The file is close-on-exec
  ;;; whatever `flags` say, as every descriptor this library opens is: a program
  ;;; another thread starts does not inherit it.
  (open [(path (ptr i8)) (flags i64) (mode i64)] (-> (Result File IoError))
    (let [fd (primitive/cast i64 (os/open path (primitive/cast i32 (| flags O_CLOEXEC)) mode))]
      (if (< fd 0) (Err (Errno (os/errno))) (Ok (mk-file fd)))))

  ;;; Open `name` (a C string) relative to `d`, with `open`'s flags and mode. An
  ;;; absolute `name` ignores `d`, as `openat` does. `open-file-at` takes the name
  ;;; as a `(slice u8)`. Close-on-exec, as `open` is.
  (open-at [(d (ptr Directory)) (name (ptr i8)) (flags i64) (mode i64)] (-> (Result File IoError))
    (let [fd (primitive/cast i64 (openat (dirfd (.handle d)) name (primitive/cast i32 (| flags O_CLOEXEC)) mode))]
      (if (< fd 0) (Err (Errno (os/errno))) (Ok (mk-file fd)))))

  (close [(f (ptr File))] (-> (Result i64 IoError))
    (let [r (primitive/cast i64 (os/close (primitive/cast i32 (fd f))))]
      (if (< r 0) (Err (Errno (os/errno))) (Ok r))))

  ;;; A Reader over `f` in the caller's storage `r`. The storage comes first, as
  ;;; it does for `Reader::from-fd`.
  (reader [(r (ptr Reader)) (f (ptr File))] (-> (ptr Reader))
    (Reader::from-fd r (fd f)))

  ;;; A Writer over `f` in the caller's storage `w`.
  (writer [(w (ptr Writer)) (f (ptr File))] (-> (ptr Writer))
    (Writer::from-fd w (fd f))))

; ---- whole-file helpers over an allocator ----------------------------------
;;; Read the ENTIRE file at `path` into a freshly-allocated `(slice u8)` the caller owns
;;; (`free [u8]` it with `a`). Streams in 4 KiB chunks into an ArrayList, then hands over a
;;; right-sized buffer via `into-slice`. `(Err …)` on an open/read failure.
(defn read-file [(a (dyn Allocator)) (path (slice u8))] (-> (Result (slice u8)
                                                                    IoError))
  (let [cp (to-cstr a path)]
    (if (= (primitive/cast i64 cp) 0)
        (Err (OutOfMemory))  ; building the C path
        (let [fd (os/open cp (primitive/cast i32 (| O_RDONLY O_CLOEXEC)) 0)
              open-errno
                (if (< (primitive/cast i64 fd) 0) (os/errno) 0)]
          (if (< fd (: 0 i32))
              (do
                (free-bytes a
                            (slice::new [u8]
                                        (primitive/cast (ptr u8) cp)
                                        (primitive/iadd (len path) 1))
                            1)
                (Err (Errno open-errno)))
              (let [(mut buf) (ArrayList::new [u8] a)
                    tmp (primitive/alloc-stack (array u8 4096))
                    ; the retrying fd reader: EINTR, or a non-blocking fd, is not an error
                    reader (Reader::from-fd (primitive/alloc-stack Reader)
                                            (primitive/cast i64 fd))
                    res
                      (block :done
                             (loop (let [n
                                           (match (read-some reader
                                                             (primitive/cast (ptr i8)
                                                                             (primitive/index tmp
                                                                                              0))
                                                             4096)
                                             (Ok [k] k)
                                             (Err [e]
                                                  (do
                                                    (free! (mut buf))
                                                    (return-from :done
                                                                   (Err [(slice u8)
                                                                         IoError]
                                                                        e)))))]
                                     (do
                                         (if (= n 0)
                                             (break)  ; EOF
                                             (let [(mut j) 0]
                                               (loop (if (>= (load j) n)
                                                         (break)
                                                         (do
                                                           (push! (mut buf)
                                                                  (load (primitive/index (primitive/index tmp
                                                                                                          0)
                                                                                         (load j))))
                                                           (store! j
                                                                   (primitive/iadd (load j)
                                                                                   1))))))))))
                             (Ok [(slice u8) IoError] (into-slice (mut buf))))]
                (os/close fd)
                (free-bytes a
                            (slice::new [u8]
                                        (primitive/cast (ptr u8) cp)
                                        (primitive/iadd (len path) 1))
                            1)
                res))))))

;;; Write `data` to `path`, creating/truncating it (mode 0o644). Returns the byte count.
(defn write-file [(a (dyn Allocator)) (path (slice u8)) (bytes (slice u8))] (-> (Result i64
                                                                                         IoError))
  (let [cp (to-cstr a path)]
    (if (= (primitive/cast i64 cp) 0)
        (Err (OutOfMemory))
        (let [fd
                (os/open cp
                         (primitive/cast i32 (| O_WRONLY (| O_CREAT (| O_TRUNC O_CLOEXEC))))
                         FILE_MODE_DEFAULT)
              open-errno
                (if (< (primitive/cast i64 fd) 0) (os/errno) 0)
              ; the Writer is this call's own instance, on its own frame — never
              ; a static, which would alias with any other stream in flight.
              w (primitive/alloc-stack Writer)
              res
                (if (< fd (: 0 i32))
                    (Err [i64 IoError] (Errno open-errno))
                    (write-all (Writer::from-fd w (primitive/cast i64 fd))
                               (primitive/cast (ptr i8) (data bytes))
                               (len bytes)))]
          (if (>= fd (: 0 i32)) (os/close fd) 0)
          (free-bytes a
                      (slice::new [u8]
                                  (primitive/cast (ptr u8) cp)
                                  (primitive/iadd (len path) 1))
                      1)
          res))))

; ---- directories, renames, shared mappings ---------------------------------
;;; `opendir` and `readdir`. On x86-64 Darwin the plain symbols are the legacy
;;; 32-bit-inode ABI, whose `struct dirent` has `d_name` at 8, and <dirent.h>
;;; binds the names to `opendir$INODE64` and `readdir$INODE64` instead: the
;;; layout DIRENT-NAME-OFFSET describes, and on arm64 Darwin the only one.
(defn gen-directory-externs [] (-> Code)
  (let [opendir (explicit-public-name `opendir)
        readdir (explicit-public-name `readdir)]
    (if (and (match (target-os) (Darwin [] true) (_ false))
             (match (target-arch) (X86_64 [] true) (_ false)))
        `(do
           (extern ~opendir :as "opendir$INODE64" :cc (cc/C) [(ptr i8)] (-> (ptr i8)))
           (extern ~readdir :as "readdir$INODE64" :cc (cc/C) [(ptr i8)] (-> (ptr i8))))
        `(do
           (extern ~opendir :cc (cc/C) [(ptr i8)] (-> (ptr i8)))
           (extern ~readdir :cc (cc/C) [(ptr i8)] (-> (ptr i8)))))))

(meta (gen-directory-externs))

(extern closedir :cc (cc/C) [(ptr i8)] (-> i32))

(extern rename :cc (cc/C) [(ptr i8) (ptr i8)] (-> i32))

(extern ftruncate :cc (cc/C) [i32 i64] (-> i32))

(extern mmap :cc (cc/C) [(ptr i8) i64 i32 i32 i32 i64] (-> (ptr i8)))

;;; `struct dirent` differs between the platforms before `d_name`, the only field
;;; read here. Darwin's offset is the 64-bit-inode layout, which `readdir` returns
;;; as declared above.
(defn gen-dirent-name-offset [] (-> Code)
  `(const ~(explicit-public-name `DIRENT-NAME-OFFSET) ~(os/os-pick `19 `21 `21)))

(meta (gen-dirent-name-offset))

;; The C path for `path`, or null when it could not be allocated. Free with
;; `free-path-cstr`.
(defn path-cstr [(a (dyn Allocator)) (path (slice u8))] (-> (ptr i8))
  (to-cstr a path))

(defn free-path-cstr [(a (dyn Allocator)) (path (slice u8)) (cp (ptr i8))] (-> i64)
  (if (= (primitive/cast i64 cp) 0)
      0
      (free-bytes a
                  (slice::new [u8]
                              (primitive/cast (ptr u8) cp)
                              (primitive/iadd (len path) 1))
                  1)))

;;; ---- existence ----------------------------------------------------------------
(extern access :cc (cc/C) [(ptr i8) i32] (-> i32))

;;; Is there anything at `path`? `access(path, F_OK)` as a boolean flattens every
;;; failure into "no"; here only ENOENT and ENOTDIR (nothing is there, or a parent is
;;; not a directory) answer `Ok false`. Any other failure — EACCES on a parent, ELOOP,
;;; ENAMETOOLONG — is `Err`, because the path may well exist. A symbolic link is
;;; followed, so a dangling one is `Ok false`.
(defn exists? [(a (dyn Allocator)) (path (slice u8))] (-> (Result bool IoError))
  (let [cp (path-cstr a path)]
    (if (= (primitive/cast i64 cp) 0)
        (Err (OutOfMemory))
        (let [r (primitive/cast i64 (access cp 0))
              e (if (< r 0) (os/errno) 0)]
          (free-path-cstr a path cp)
          (cond (= r 0) (Ok true)
                (or (= e 2) (= e 20)) (Ok false)
                :else (Err (Errno e)))))))

;;; ---- a directory as a handle ----------------------------------------------------
;;; `Directory::list` reads a whole directory by path. A `Directory` is the open directory
;;; itself: entries stream out of it one at a time without being copied, and a file
;;; is opened RELATIVE to it, so the open cannot be redirected by a rename of a
;;; parent after the directory was opened, and it costs one path component of lookup
;;; instead of the whole path.
;;;
;;;   (match (Directory::open a "src")
;;;     (Ok [dir]
;;;       (loop (match (next! (mut dir))
;;;               (Ok [(Some [entry])] (use (.name entry)))
;;;               (_ (break))))
;;;       (close! (mut dir))))
(extern dirfd :cc (cc/C) [(ptr i8)] (-> i32))

(extern openat :cc (cc/C) [i32 (ptr i8) i32 ...] (-> i32))

;;; `d_type` sits one byte before `d_name` on both layouts `DIRENT-NAME-OFFSET` names.
(defn gen-dirent-type-offset [] (-> Code)
  `(const ~(explicit-public-name `DIRENT-TYPE-OFFSET) ~(os/os-pick `18 `20 `20)))

(meta (gen-dirent-type-offset))

(defstruct Directory [(handle (ptr i8))])

;;; What `d_type` says an entry is. `EntryUnknown` is not an error: some filesystems
;;; do not fill it in, and then only `stat` knows.
(defsum EntryKind
  (EntryRegular)
  (EntryDirectory)
  (EntrySymlink)
  (EntryOther)
  (EntryUnknown))

;;; One entry. `name` is BORROWED from the directory stream: it is valid until the next
;;; `next!` or `close!` on the same `Directory`. Copy it to keep it.
(defstruct DirEntry [(name (slice u8)) (kind EntryKind)])

(defn entry-kind [(d-type i64)] (-> EntryKind)
  (cond (= d-type 8) (EntryRegular)
        (= d-type 4) (EntryDirectory)
        (= d-type 10) (EntrySymlink)
        (= d-type 0) (EntryUnknown)
        :else (EntryOther)))

(impl Directory
  ;;; Open the directory at `path`.
  (open [(a (dyn Allocator)) (path (slice u8))] (-> (Result Directory IoError))
    (let [cp (path-cstr a path)]
      (if (= (primitive/cast i64 cp) 0)
          (Err (OutOfMemory))
          (let [d (opendir cp)
                open-errno
                  (if (= (primitive/cast i64 d) 0) (os/errno) 0)]
            (free-path-cstr a path cp)
            (if (= (primitive/cast i64 d) 0)
                (Err (Errno open-errno))
                (Ok (Directory :handle d)))))))

  ;;; The next entry, `Ok (None)` at the end, skipping `.` and `..`. Order is whatever the
  ;;; filesystem returns. `readdir` returns null both at the end and on error; only
  ;;; errno tells them apart, so it is cleared before each call.
  (next! [(d (ptr Directory))] (-> (Result (Option DirEntry) IoError))
    (let [(mut out) (Ok [(Option DirEntry) IoError] (None [DirEntry]))]
      (loop (os/set-errno! 0)
            (let [e (readdir (.handle d))]
              (if (= (primitive/cast i64 e) 0)
                  (let [err (os/errno)]
                    (when (!= err 0) (set! out (Err [(Option DirEntry) IoError] (Errno err))))
                    (break))
                  (let [bytes (primitive/cast (ptr u8) e)
                        nm (from-cstr (primitive/cast (ptr i8)
                                                      (primitive/index bytes DIRENT-NAME-OFFSET)))]
                    (unless (or (= nm ".") (= nm ".."))
                      (set! out
                            (Ok [(Option DirEntry) IoError]
                                (Some (DirEntry
                                        :name nm
                                        :kind (entry-kind
                                                (primitive/cast i64
                                                                (load (primitive/index bytes
                                                                                       DIRENT-TYPE-OFFSET))))))))
                      (break))))))
      (load out)))

  ;;; Close the directory. Files opened from it stay open: they are separate descriptors.
  (close! [(d (ptr Directory))] (-> (Result i64 IoError))
    (let [r (primitive/cast i64 (closedir (.handle d)))]
      (if (< r 0) (Err (Errno (os/errno))) (Ok r))))

  ;;; The names in the directory at `path`, without `.` and `..`, in whatever
  ;;; order the filesystem returns them. Each name is an owning slice from `a`;
  ;;; free the list with `Directory::free-list`.
  (list [(a (dyn Allocator)) (path (slice u8))] (-> (Result (ArrayList (slice u8)) IoError))
    (let [cp (path-cstr a path)]
      (if (= (primitive/cast i64 cp) 0)
          (Err (OutOfMemory))
          (let [d (opendir cp)
                open-errno
                  (if (= (primitive/cast i64 d) 0) (os/errno) 0)]
            (free-path-cstr a path cp)
            (if (= (primitive/cast i64 d) 0)
                (Err (Errno open-errno))
                (let [(mut out) (ArrayList::new [(slice u8)] a)
                      (mut read-errno) 0]
                  ; readdir returns null both at the end and on error; only errno
                  ; tells them apart, so clear it before each call.
                  (loop (os/set-errno! 0)
                        (let [e (readdir d)]
                          (if (= (primitive/cast i64 e) 0)
                              (do (store! read-errno (os/errno)) (break))
                              (let [nm
                                      (from-cstr (primitive/cast (ptr i8)
                                                                 (primitive/index (primitive/cast (ptr u8)
                                                                                                  e)
                                                                                  DIRENT-NAME-OFFSET)))]
                                (if (or (= nm ".") (= nm ".."))
                                    0
                                    (let [(mut sb) (StrBuf::new a)]
                                      (push-str! (mut sb) nm)
                                      (push! (mut out) (finish! (mut sb)))
                                      0))))))
                  (closedir d)
                  (if (= read-errno 0)
                      (Ok (load out))
                      (do
                        (Directory::free-list a (mut out))
                        (Err (Errno read-errno))))))))))

  ;;; Free a list `Directory::list` returned, with the allocator it was given.
  (free-list [(a (dyn Allocator)) (names (mut (ArrayList (slice u8))))] (-> i64)
    (let [n (len (load names))
          (mut i) 0]
      (loop (if (>= (load i) n)
                (break)
                (let [s (get (load names) (load i))]
                  (if (= (primitive/cast i64 (data s)) 0)
                      0
                      (free-bytes a s 1))
                  (store! i (primitive/iadd (load i) 1))
                  0)))
      (free! (mut names))
      0)))

;;; Rename `from` to `to`, replacing `to` if it exists. Atomic within one
;;; filesystem, which is what makes "write a temporary, then rename" the way to
;;; publish a file that concurrent readers must never see half-written.
(defn rename-file [(a (dyn Allocator)) (from (slice u8)) (to (slice u8))] (-> (Result i64
                                                                                         IoError))
  (let [cf (path-cstr a from)
        ct (path-cstr a to)
        r
          (if (or (= (primitive/cast i64 cf) 0)
                  (= (primitive/cast i64 ct) 0))
              (Err [i64 IoError] (OutOfMemory))
              (if (< (primitive/cast i64 (rename cf ct)) 0)
                  (Err [i64 IoError] (Errno (os/errno)))
                  (Ok [i64 IoError] 0)))]
    (free-path-cstr a from cf)
    (free-path-cstr a to ct)
    r))

;;; Create (or reuse) the file at `path`, size it to exactly `size` bytes, and map
;;; it read-write and SHARED. Stores through the returned pointer reach the file
;;; with no further system call, and they survive the process: a writer that is
;;; killed mid-run leaves what it last stored for another process to read. The
;;; mapping lasts until the process exits.
(defn map-shared-file [(a (dyn Allocator)) (path (slice u8)) (size i64)] (-> (Result (ptr u8)
                                                                                         IoError))
  (let [cp (path-cstr a path)]
    (if (= (primitive/cast i64 cp) 0)
        (Err (OutOfMemory))
        (let [fd (os/open cp (primitive/cast i32 (| O_RDWR (| O_CREAT O_CLOEXEC))) FILE_MODE_DEFAULT)
              open-errno
                (if (< (primitive/cast i64 fd) 0) (os/errno) 0)]
          (free-path-cstr a path cp)
          (if (< fd (: 0 i32))
              (Err (Errno open-errno))
              (if (< (primitive/cast i64 (ftruncate fd size)) 0)
                  (let [e (os/errno)]
                    (os/close fd)
                    (Err (Errno e)))
                  ; PROT_READ|PROT_WRITE = 3 and MAP_SHARED = 1 on both platforms.
                  (let [p (mmap (primitive/cast (ptr i8) 0) size 3 1 fd 0)
                        e (os/errno)]
                    (os/close fd)
                    (if (= (primitive/cast i64 p) -1)
                        (Err (Errno e))
                        (Ok (primitive/cast (ptr u8) p))))))))))

; ---- the same calls, with (slice u8) paths ------------------------------------
;;; Open `path` with `flags` (O_* above) and `mode` (used only when the open creates
;;; the file). The C string the call needs comes from `a` and is freed before it
;;; returns.
(defn open-file [(a (dyn Allocator)) (path (slice u8)) (flags i64) (mode i64)] (-> (Result File IoError))
  (let [cp (path-cstr a path)]
    (if (= (primitive/cast i64 cp) 0)
        (Err (OutOfMemory))
        (let [r (File::open cp flags mode)]
          (free-path-cstr a path cp)
          r))))

;;; Open `name` relative to the directory `d`, as `File::open-at` does.
(defn open-file-at [(a (dyn Allocator)) (d (ptr Directory)) (name (slice u8)) (flags i64) (mode i64)] (-> (Result File IoError))
  (let [cp (path-cstr a name)]
    (if (= (primitive/cast i64 cp) 0)
        (Err (OutOfMemory))
        (let [r (File::open-at d cp flags mode)]
          (free-path-cstr a name cp)
          r))))

;;; Create the directory `path` with permission bits `mode`, as `make-dir` does. An
;;; existing directory is an error, `(Errno 17)` (EEXIST).
(defn create-dir [(a (dyn Allocator)) (path (slice u8)) (mode i64)] (-> (Result i64 IoError))
  (let [cp (path-cstr a path)]
    (if (= (primitive/cast i64 cp) 0)
        (Err (OutOfMemory))
        (let [rc (make-dir cp mode)
              e (if (< rc (: 0 i32)) (os/errno) 0)]
          (free-path-cstr a path cp)
          (if (< rc (: 0 i32)) (Err (Errno e)) (Ok 0))))))
