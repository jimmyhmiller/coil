(module coil.fixedlist)
(import "coil.primitive" :as primitive)
(import "coil.alloc" :use [debug-fail-at capacity-exceeded-at])
(import "coil.slice" :use [SliceIter subslice])

; Lists with a fixed capacity: they never allocate and never grow, so the
; capacity is a budget. Two shapes, one vocabulary:
;
;   (FixedList T)      a list over storage you provide — a `(slice T)` from an
;                      arena, a static, or a stack array. Its capacity is that
;                      slice's length, known at run time.
;   (InlineList T N)   a list that IS its storage: `N` elements inline, so it can
;                      be a struct field or a local. Its capacity is `N`.
;
;   (import "coil.fixedlist" :use *)
;   (let [(mut lights) (InlineList::new [Light 64])]
;     (push! (mut lights) light)
;     (for l lights …))
;
; Both implement Len/len, Get/get, Set/set!, Push/push!, Pop/pop! and
; Iterable/iter, plus FixedCapacity: `capacity`, `full?` and `clear!`. Each has
; the method `used`, the filled prefix as a slice. `push!` onto a full list is a
; hard error in every build — continuing would write past the storage. Reading or
; writing an index at or past `len` is checked under `--debug-checks`, as for
; ArrayList.
(export FixedList InlineList FixedCapacity capacity full? clear! storage-view)

;;; A list whose elements live in `storage`, a slice the caller owns. `len`
;;; elements are in use; the capacity is `(len storage)`.
(defstruct FixedList [T] [(storage (slice T)) (count i64)])

;;; A list of at most `N` elements stored inline. Only the first `count` slots hold
;;; values, so the storage is a `ManuallyDrop` the list's own `Drop` empties:
;;; dropping the whole array would drop slots that hold nothing.
(defstruct InlineList [T (const N i64)] [(storage (ManuallyDrop (array T N))) (count i64)])


;;; The capacity-specific operations; the rest is the ordinary collection traits.
(deftrait FixedCapacity [Self]
  (capacity [(xs Self)] (-> i64))
  (full? [(xs Self)] (-> bool))
  (clear! [(xs (mut Self))] (-> i64)))

(defn dbg-index [(i Code) (n Code) (site Code)] (-> Code)
  (if (primitive/debug-checks?)
      `(if (or (< ~i 0) (>= ~i ~n)) (debug-fail-at ~site) 0)
      `0))

; ---- FixedList ---------------------------------------------------------------
(impl [T] (FixedList T)
  ;;; An empty list over `storage`. Whatever `storage` held is ignored and will be
  ;;; overwritten by pushes.
  (new [(storage (slice T))] (-> (FixedList T))
    (FixedList :storage storage :count 0))

  ;;; The filled prefix of the list, as a slice over its storage.
  (used [(xs (FixedList T))] (-> (slice T))
    (subslice (.storage xs) 0 (.count xs)))

  ;;; Element i, lent where it lies (see the slice's `at`).
  (at [(xs (FixedList T)) (i i64)] (-> (ref T))
    (dbg-index i (.count xs) c"FixedList index out of bounds in at")
    (at (.storage xs) i)))

(impl [T] FixedCapacity (FixedList T)
  (capacity [(xs (FixedList T))] (-> i64) (len (.storage xs)))
  (full? [(xs (FixedList T))] (-> bool) (= (.count xs) (len (.storage xs))))
  (clear! [(xs (mut (FixedList T)))] (-> i64) (set! (.count xs) 0) 0))

(impl [T] Len (FixedList T)
  (len [(xs (FixedList T))] (-> i64) (.count xs)))

(impl [T] Get (FixedList T)
  ;;; A copy of element i; one that owns something is refused where it is read,
  ;;; and `(at xs i)` borrows it instead.
  (get :collection/copies-element "(at xs i)" [(xs (FixedList T)) (i i64)] (-> T)
    (dbg-index i (.count xs) c"FixedList index out of bounds in get")
    (load (primitive/index (data (.storage xs)) i))))

(impl [T] Set (FixedList T)
  (set! [(xs (mut (FixedList T))) (i i64) (v T)] (-> i64)
    (dbg-index i (.count xs) c"FixedList index out of bounds in set!")
    (set! (mut (.storage xs)) i v)))

(impl [T] Push (FixedList T)
  (push! [(xs (mut (FixedList T))) (v T)] (-> i64)
    (let [n (.count xs)]
      (when (= n (len (.storage xs)))
        (capacity-exceeded-at c"push! onto a full FixedList" n))
      ; slot n is past the list's values: it holds none to drop
      (init! (mut (.storage xs)) n v)
      (set! (.count xs) (+ n 1))
      0)))

(impl [T] Pop (FixedList T)
  (pop! [(xs (mut (FixedList T)))] (-> (Option T))
    (if (= (.count xs) 0)
        (None [T])
        (do (set! (.count xs) (- (.count xs) 1))
            ; the last value moves out; its slot is past the list's values now
            (Some (move-out! (.storage xs) (.count xs)))))))

(impl [T] Iterable (FixedList T)
  (iter [(xs (FixedList T))] (-> (SliceIter T)) (iter (used xs))))

; ---- InlineList --------------------------------------------------------------
; An inline list holds its elements, so every operation takes it by place -- a
; `(ref …)` to read, a `(mut …)` to edit -- and never as a value, which for
; elements that own something would move the whole list into the call.

;;; The list's whole storage, viewed in place: the array's address, which borrows
;;; as a slice without copying.
(defn storage-view [T (const N i64)] [(xs (ref (InlineList T N)))] (-> (slice T))
  (field (field xs storage) value))

;;; Drop the list's values, last first, and leave it empty.
(defn drop-values! [T (const N i64)] [(xs (mut (InlineList T N)))] (-> i64)
  (let [view (storage-view xs)]
    (loop (if (= (.count xs) 0)
              (break)
              (do (set! (.count xs) (- (.count xs) 1))
                  ; the value moves out of its slot and is dropped here
                  (move-out! view (.count xs))
                  0))))
  0)

(impl [T (const N i64)] (InlineList T N)
  ;;; An empty inline list: `(InlineList::new [Light 64])`.
  (new [] (-> (InlineList T N))
    (primitive/zeroed (InlineList T N)))

  ;;; The filled prefix of the list, as a slice over its inline storage. The slice
  ;;; points into the list, so it is valid only while the list stays where it is.
  (used [(xs (ref (InlineList T N)))] (-> (slice T))
    (subslice (storage-view xs) 0 (.count xs)))

  ;;; Element i, lent where it lies (see the slice's `at`).
  (at [(xs (ref (InlineList T N))) (i i64)] (-> (ref T))
    (dbg-index i (.count xs) c"InlineList index out of bounds in at")
    (at (storage-view xs) i)))

;;; Dropping a list drops the values it holds, and only those.
(impl [T (const N i64)] Drop (InlineList T N)
  (drop [(xs (mut (InlineList T N)))] (-> void)
    (drop-values! (mut xs))))

(impl [T (const N i64)] FixedCapacity (InlineList T N)
  (capacity [(xs (ref (InlineList T N)))] (-> i64) N)
  (full? [(xs (ref (InlineList T N)))] (-> bool) (= (.count xs) N))
  ;;; Drop every value and leave the list empty.
  (clear! [(xs (mut (InlineList T N)))] (-> i64) (drop-values! (mut xs))))

(impl [T (const N i64)] Len (InlineList T N)
  (len [(xs (ref (InlineList T N)))] (-> i64) (.count xs)))

(impl [T (const N i64)] Get (InlineList T N)
  ;;; A copy of element i; one that owns something is refused where it is read,
  ;;; and `(at xs i)` borrows it instead.
  (get :collection/copies-element "(at xs i)" [(xs (ref (InlineList T N))) (i i64)] (-> T)
    (dbg-index i (.count xs) c"InlineList index out of bounds in get")
    (load (primitive/index (data (storage-view xs)) i))))

(impl [T (const N i64)] Set (InlineList T N)
  ;;; Replace element i: the element it held is dropped.
  (set! [(xs (mut (InlineList T N))) (i i64) (v T)] (-> i64)
    (dbg-index i (.count xs) c"InlineList index out of bounds in set!")
    (set! (storage-view xs) i v)))

(impl [T (const N i64)] Push (InlineList T N)
  (push! [(xs (mut (InlineList T N))) (v T)] (-> i64)
    (let [n (.count xs)]
      (when (= n N)
        (capacity-exceeded-at c"push! onto a full InlineList" N))
      ; slot n is past the list's values: it holds none to drop
      (init! (storage-view xs) n v)
      (set! (.count xs) (+ n 1))
      0)))

(impl [T (const N i64)] Pop (InlineList T N)
  (pop! [(xs (mut (InlineList T N)))] (-> (Option T))
    (if (= (.count xs) 0)
        (None [T])
        (do (set! (.count xs) (- (.count xs) 1))
            ; the last value moves out; its slot is past the list's values now
            (Some (move-out! (storage-view xs) (.count xs)))))))

(impl [T (const N i64)] Iterable (InlineList T N)
  (iter [(xs (ref (InlineList T N)))] (-> (SliceIter T)) (iter (used xs))))
