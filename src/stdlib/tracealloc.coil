(module coil.tracealloc)
(import "coil.primitive" :as primitive)
(import "coil.alloc" :as alloc)
(import "coil.result" :use [Option Some None])

(export TracingAllocator
        AllocatorStats
        tracing-allocator-init
        tracing-allocator-view
        tracing-allocator-stats)

;;; Exact request-level accounting for any Allocator. `backing-bytes` is -1:
;;; a generic allocator cannot reveal reserved capacity without lying. Wrappers
;;; around allocators with that knowledge may report it separately.
(defstruct AllocatorStats
  [(allocation-calls i64)
   (requested-bytes i64)
   (current-live-bytes i64)
   (peak-live-bytes i64)
   (cumulative-bytes i64)
   (backing-bytes i64)])

(defstruct TracingAllocator
  [(inner (dyn alloc/Allocator))
   (name (slice u8))
   (stats AllocatorStats)])

(defn trace-account-growth! [(state (ptr TracingAllocator)) (delta i64)] (-> i64)
  (let [stats (field state stats)]
    (store! (field stats current-live-bytes)
            (primitive/iadd (load (field stats current-live-bytes)) delta))
    (when (> delta 0)
      (store! (field stats cumulative-bytes)
              (primitive/iadd (load (field stats cumulative-bytes)) delta))
      0)
    (when (> (load (field stats current-live-bytes)) (load (field stats peak-live-bytes)))
      (store! (field stats peak-live-bytes) (load (field stats current-live-bytes)))
      0)
    0))

(impl alloc/Allocator TracingAllocator
  (allocate [(self (ptr TracingAllocator)) (request (ref alloc/AllocRequest))]
            (-> (Option (ptr i8)))
    (match (alloc/raw-alloc (load (field self inner)) (load request))
      (None [] (None))
      (Some [p]
        (do
          (store! (field (field self stats) allocation-calls)
                  (primitive/iadd (load (field (field self stats) allocation-calls)) 1))
          (store! (field (field self stats) requested-bytes)
                  (primitive/iadd (load (field (field self stats) requested-bytes))
                                  (load (field request bytes))))
          (trace-account-growth! self (load (field request bytes)))
          (Some p)))))
  (resize [(self (ptr TracingAllocator))
           (memory (ptr i8))
           (old (ref alloc/AllocRequest))
           (new (ref alloc/AllocRequest))] (-> bool)
    (if (alloc/raw-resize (load (field self inner)) memory (load old) (load new))
        (do
          (trace-account-growth! self
                                 (primitive/isub (load (field new bytes))
                                                 (load (field old bytes))))
          true)
        false))
  (remap [(self (ptr TracingAllocator))
          (memory (ptr i8))
          (old (ref alloc/AllocRequest))
          (new (ref alloc/AllocRequest))] (-> (Option (ptr i8)))
    (match (alloc/raw-remap (load (field self inner)) memory (load old) (load new))
      (None [] (None))
      (Some [p]
        (do
          (trace-account-growth! self
                                 (primitive/isub (load (field new bytes))
                                                 (load (field old bytes))))
          (Some p)))))
  (deallocate [(self (ptr TracingAllocator))
               (memory (ptr i8))
               (request (ref alloc/AllocRequest))] (-> i64)
    (do
      (alloc/raw-free (load (field self inner)) memory (load request))
      (store! (field (field self stats) current-live-bytes)
              (primitive/isub (load (field (field self stats) current-live-bytes))
                              (load (field request bytes))))
      0)))

(defn tracing-allocator-init [(state (ptr TracingAllocator))
                              (name (slice u8))
                              (inner (dyn alloc/Allocator))] (-> (ptr TracingAllocator))
  (store! (field state inner) inner)
  (store! (field state name) name)
  (store! (field state stats) (primitive/zeroed AllocatorStats))
  (store! (field (field state stats) backing-bytes) -1)
  state)

(defn tracing-allocator-view [(state (ptr TracingAllocator))] (-> (dyn alloc/Allocator))
  (primitive/make-dyn alloc/Allocator state))

(defn tracing-allocator-stats [(state (ptr TracingAllocator))] (-> AllocatorStats)
  (load (field state stats)))
