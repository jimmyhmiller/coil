(module coil.pmap)
(import "coil.primitive" :as primitive)

; A persistent hash map `PMap[K V]`: a compressed hash-array-mapped trie whose
; nodes are reference counted and shared between maps. `assoc`/`dissoc`
; return a NEW map that shares every untouched node with the old one, so a map of
; n entries costs O(log32 n) small nodes per update and the old map stays valid
; and unchanged. That is the whole point: a value you can hand to another owner
; without copying it and without either side being able to disturb the other.
;
;   (import "coil.pmap" :use [PMap]) (import "coil.alloc" :use *)
;   (let [a (PMap::new-scalar [i64 i64] (malloc-allocator-lease))
;         b (assoc a 7 42)]              ; a is still empty
;     (match (get b 7) (Some [v] v) (None [] 0)))
;
; OWNERSHIP. A `PMap` is an owner: it implements `Drop` (release the root) and
; `Clone` (share the root — O(1), no node is copied). Keys and values are owned by
; the node that holds them: a copied node CLONES them, a freed node DROPS them, so
; `V` may itself be an owner (an `Rc`, another `PMap`, a handle whose `Drop`
; releases an external reference). Both must implement `Clone`; scalars, pointers
; and slices already do.
;
; A map outlives the scope that made it, so it holds an `AllocatorLease`, never a
; borrowed `(dyn Allocator)`. Every map derived from one ancestor carries a clone
; of the same lease, and whichever of them releases a node last frees it.
;
; IN-PLACE EDITS. `set!` (Set) and `dissoc!` take `(mut (PMap K V))` and edit nodes
; in place where that is unobservable: a node is edited only when it and every
; node above it have exactly one reference. Building a map with `set!` from a
; fresh `PMap::new` therefore never copies a node, while the same call on a map whose
; root is shared copies exactly the path. The pure forms are `clone` + the mutating
; form, so there is one implementation of each operation.
;
; NAMES. Reading goes through the collection traits: `len`, `get` (an Option),
; `iter`, and `empty?` over Len. A name ending in `!` edits the map in place
; (`set!`, `dissoc!`); one without returns a new map (`assoc`, `dissoc`), as in
; coil.pvec (`conj`, `assoc`, `pop`).
;
; HASHING reuses `coil.hashmap`'s `KeyOps` capability (hash + eq), for the reasons
; given there. Only non-owning ops are accepted: key storage is governed by
; `Clone`/`Drop` here, so `owns = 1` would free a key twice. `PMap::new` rejects it.
;
; NOT THREAD SAFE: reference counts are plain integers, as in `coil.rc`.
(import "coil.alloc" :as alloc :use *)
(import "coil.result" :use *)
(import "coil.mem" :use *)
(import "coil.control" :use *)
(import "coil.hashmap"
        :use [KeyOps scalar-keyops])

(export PMap PEntry PMapIter
        PNode)

;;; One key/value pair plus the key's full hash. Keeping the hash means a pair
;;; pushed one level down never has to be rehashed.
(defstruct PEntry [K V] [(hash i64) (key K) (val V)])

;;; A trie node. `datamap` marks the 5-bit hash fragments stored inline in
;;; `entries`; `nodemap` marks the fragments that lead to a sub-node in
;;; `children`. A fragment is never in both. Both arrays are exactly as long as
;;; their counts, in fragment order. Below the last hash fragment a node is a
;;; COLLISION node: the maps are unused and `entries` is an unordered list of
;;; pairs whose full hashes are equal.
(defstruct PNode [K V]
  [(refs i64)
   (datamap i64)
   (nodemap i64)
   (nentries i64)
   (nchildren i64)
   (entries (ptr (PEntry K V)))
   (children (ptr (ptr (PNode K V))))])

(defstruct PMap [K V]
  [(root (ptr (PNode K V)))
   (count i64)
   (lease AllocatorLease)
   (ops (ptr KeyOps))])

(defn fail [(site (ptr i8))] (-> i64)
  (oom-puts c"coil.pmap: ")
  (oom-puts site)
  (oom-puts c"\n")
  (abort)
  0)

; Thirteen fragments consume all 64 hash bits (12 of five bits, one of four).
(defn collision-level? [(shift i64)] (-> bool)
  (> shift 60))

(defn fragment-bit [(hash i64) (shift i64)] (-> i64)
  (primitive/ishl 1 (primitive/iand (primitive/ishr hash shift) 31)))

(defn rank [(bitmap i64) (bit i64)] (-> i64)
  (primitive/popcount (primitive/iand bitmap (primitive/isub bit 1))))

(defn no-node [K V] [] (-> (ptr (PNode K V)))
  (primitive/cast (ptr (PNode K V)) 0))

(defn clone-at [(T Clone)] [(p (ref T))] (-> T)
  (clone p))

;;; Clone the pair at `src` into the uninitialized slot `dst`.
(defn clone-pair [(K Clone) (V Clone)] [(dst (ptr (PEntry K V)))
                                        (src (ptr (PEntry K V)))] (-> i64)
  (set! (.hash dst) (.hash src))
  (set! (.key dst) (clone-at [K] (field src key)))
  (set! (.val dst) (clone-at [V] (field src val)))
  0)

;;; Drop the pair at `e`, leaving the slot uninitialized.
(defn drop-pair [K V] [(e (ptr (PEntry K V)))] (-> i64)
  (let [key (take! [K] (field e key))
        val (take! [V] (field e val))]
    0))

(defn node-new [K V] [(a (dyn Allocator)) (nentries i64) (nchildren i64)] (-> (ptr (PNode K
                                                                                          V)))
  (let [node
          (match (alloc [(PNode K V)] a 1)
            (Some [memory] (data memory))
            (None []
                  (do
                    (oom-at c"pmap node" (primitive/sizeof (PNode K V)))
                    (no-node [K V]))))]
    (set! (.refs node) 1)
    (set! (.datamap node) 0)
    (set! (.nodemap node) 0)
    (set! (.nentries node) nentries)
    (set! (.nchildren node) nchildren)
    (set! (.entries node)
          (if (= nentries 0)
              (primitive/cast (ptr (PEntry K V)) 0)
              (match (alloc [(PEntry K V)] a nentries)
                (Some [memory] (data memory))
                (None []
                      (do
                        (oom-at c"pmap entries"
                                (primitive/imul nentries
                                                (primitive/sizeof (PEntry K V))))
                        (primitive/cast (ptr (PEntry K V)) 0))))))
    (set! (.children node)
          (if (= nchildren 0)
              (primitive/cast (ptr (ptr (PNode K V))) 0)
              (match (alloc [(ptr (PNode K V))] a nchildren)
                (Some [memory] (data memory))
                (None []
                      (do
                        (oom-at c"pmap children"
                                (primitive/imul nchildren
                                                (primitive/sizeof (ptr (PNode K
                                                                              V)))))
                        (primitive/cast (ptr (ptr (PNode K V))) 0))))))
    node))

;;; Free a node's storage without touching what its slots hold: every pair and
;;; child reference must already have been moved out or released.
(defn node-free-shell [K V] [(a (dyn Allocator)) (node (ptr (PNode K V)))] (-> i64)
  (when (> (.nentries node) 0)
    (free [(PEntry K V)]
          a
          (slice::new (load (field node entries)) (.nentries node)))
    0)
  (when (> (.nchildren node) 0)
    (free [(ptr (PNode K V))]
          a
          (slice::new (load (field node children)) (.nchildren node)))
    0)
  (free [(PNode K V)] a (slice::new node 1))
  0)

;;; Give up one reference. The last one drops every pair, releases every child
;;; and frees the node. Depth is bounded by the 14 trie levels.
(defn node-release! [K V] [(a (dyn Allocator)) (node (ptr (PNode K V)))] (-> i64)
  (let [remaining (primitive/isub (.refs node) 1)]
    (set! (.refs node) remaining)
    (when (= remaining 0)
      (for [i 0 (.nentries node)]
        (drop-pair (primitive/index (load (field node entries)) i)))
      (for [i 0 (.nchildren node)]
        (node-release! a
                       (load (primitive/index (load (field node children)) i))))
      (node-free-shell a node)
      0)
    0))

;;; Build a node from `src` with one slot optionally removed and one optionally
;;; opened in each array. `drop-*` index the OLD array, `open-*` the NEW one; -1
;;; means none. An opened slot is left uninitialized for the caller to fill, and
;;; the bitmaps are copied unchanged for the caller to adjust.
;;;
;;; With `move` false, `src` is untouched: kept pairs are cloned and kept children
;;; retained. With `move` true, `src` is consumed: kept slots are moved bitwise and
;;; its shell is freed. The caller must already own whatever the dropped slots
;;; held, because nothing here drops or releases them.
(defn node-derive [(K Clone) (V Clone)] [(a (dyn Allocator))
                                         (src (ptr (PNode K V)))
                                         (move bool)
                                         (drop-entry i64)
                                         (drop-child i64)
                                         (open-entry i64)
                                         (open-child i64)] (-> (ptr (PNode K
                                                                           V)))
  (let [old-entries (.nentries src)
        old-children (.nchildren src)
        node
          (node-new [K V]
                    a
                    (primitive/iadd (primitive/isub old-entries
                                                    (if (>= drop-entry 0)
                                                        1
                                                        0))
                                    (if (>= open-entry 0) 1 0))
                    (primitive/iadd (primitive/isub old-children
                                                    (if (>= drop-child 0)
                                                        1
                                                        0))
                                    (if (>= open-child 0) 1 0)))
        (mut at) 0]
    (set! (.datamap node) (.datamap src))
    (set! (.nodemap node) (.nodemap src))
    (for [i 0 old-entries]
      (when (!= i drop-entry)
        (when (= (load at) open-entry) (set! at (primitive/iadd (load at) 1)) 0)
        (let [from (primitive/index (load (field src entries)) i)
              to (primitive/index (load (field node entries)) (load at))]
          (if move (copy to from 1) (clone-pair to from)))
        (set! at (primitive/iadd (load at) 1))
        0))
    (set! at 0)
    (for [i 0 old-children]
      (when (!= i drop-child)
        (when (= (load at) open-child) (set! at (primitive/iadd (load at) 1)) 0)
        (let [child (load (primitive/index (load (field src children)) i))]
          (unless move
            (set! (.refs child) (primitive/iadd (.refs child) 1))
            0)
          (set! (primitive/index (load (field node children)) (load at)) child))
        (set! at (primitive/iadd (load at) 1))
        0))
    (when move (node-free-shell a src) 0)
    node))

;;; A subtree holding exactly the two pairs at `first` and `second`, whose keys
;;; differ. Both are moved in.
(defn node-pair [K V] [(a (dyn Allocator))
                       (shift i64)
                       (first (ptr (PEntry K V)))
                       (second (ptr (PEntry K V)))] (-> (ptr (PNode K V)))
  (if (collision-level? shift)
      (let [node (node-new [K V] a 2 0)]
        (copy (load (field node entries)) first 1)
        (copy (primitive/index (load (field node entries)) 1) second 1)
        node)
      (let [first-bit (fragment-bit (.hash first) shift)
            second-bit (fragment-bit (.hash second) shift)]
        (if (= first-bit second-bit)
            (let [node (node-new [K V] a 0 1)]
              (set! (.nodemap node) first-bit)
              (set! (load (field node children))
                    (node-pair a (primitive/iadd shift 5) first second))
              node)
            ; Unsigned order: the sign bit is fragment 31 and sorts last.
            (let [node (node-new [K V] a 2 0)
                  first-leads (= (rank second-bit first-bit) 0)]
              (set! (.datamap node) (primitive/ior first-bit second-bit))
              (copy (load (field node entries))
                    (if first-leads first second)
                    1)
              (copy (primitive/index (load (field node entries)) 1)
                    (if first-leads second first)
                    1)
              node)))))

;;; Index of the pair in a collision node equal to the key at `key`, or -1.
(defn node-find [K V] [(ops (ptr KeyOps))
                       (node (ptr (PNode K V)))
                       (hash i64)
                       (key (ptr i8))] (-> i64)
  (let [(mut found) -1]
    (for [i 0 (.nentries node)]
      (let [e (primitive/index (load (field node entries)) i)]
        (when (and (< (load found) 0)
                   (and (= (.hash e) hash)
                        (eq ops (primitive/cast (ptr i8) (field e key)) key)))
          (set! found i)
          0)))
    (load found)))

(defn entry-matches? [K V] [(ops (ptr KeyOps))
                            (e (ptr (PEntry K V)))
                            (hash i64)
                            (key (ptr i8))] (-> bool)
  (and (= (.hash e) hash)
       (eq ops (primitive/cast (ptr i8) (field e key)) key)))

;;; Put `fresh` where the pair at `at` is. Owned: drop the old pair in place.
;;; Shared: derive a node with that slot reopened.
(defn node-replace [(K Clone) (V Clone)] [(a (dyn Allocator))
                                          (node (ptr (PNode K V)))
                                          (owned bool)
                                          (at i64)
                                          (fresh (ptr (PEntry K V)))] (-> (ptr (PNode K
                                                                                      V)))
  (let [target
          (if owned
              (do
                (drop-pair (primitive/index (load (field node entries)) at))
                node)
              (node-derive a node false at -1 at -1))]
    (copy (primitive/index (load (field target entries)) at) fresh 1)
    target))

;;; Swap the child at `at` for `fresh`, which the caller owns. `child-owned` says
;;; the old child was consumed by whatever produced `fresh`.
(defn node-set-child [(K Clone) (V Clone)] [(a (dyn Allocator))
                                            (node (ptr (PNode K V)))
                                            (owned bool)
                                            (child-owned bool)
                                            (at i64)
                                            (fresh (ptr (PNode K V)))] (-> (ptr (PNode K
                                                                                       V)))
  (if owned
      (let [slot (primitive/index (load (field node children)) at)]
        (unless child-owned (node-release! a (load slot)) 0)
        (set! slot fresh)
        node)
      (let [derived (node-derive a node false -1 at -1 at)]
        (set! (primitive/index (load (field derived children)) at) fresh)
        derived)))

;;; Insert or replace the pair at `fresh`, which is always consumed. `owned` means
;;; `node` and everything above it has one reference: then `node` is consumed too
;;; and the result may be the same pointer. Otherwise `node` is left intact and
;;; the result is a new node the caller owns. `added` is set when the key is new.
(defn node-assoc [(K Clone) (V Clone)] [(a (dyn Allocator))
                                        (ops (ptr KeyOps))
                                        (node (ptr (PNode K V)))
                                        (owned bool)
                                        (shift i64)
                                        (fresh (ptr (PEntry K V)))
                                        (added (ptr i64))] (-> (ptr (PNode K
                                                                           V)))
  (let [hash (.hash fresh)
        key (primitive/cast (ptr i8) (field fresh key))]
    (if (collision-level? shift)
        (let [at (node-find ops node hash key)]
          (if (>= at 0)
              (node-replace a node owned at fresh)
              (let [grown
                      (node-derive a node owned -1 -1 (.nentries node) -1)]
                (copy (primitive/index (load (field grown entries))
                                       (primitive/isub (.nentries grown) 1))
                      fresh
                      1)
                (set! added 1)
                grown)))
        (let [bit (fragment-bit hash shift)]
          (cond (!= (primitive/iand (.datamap node) bit) 0)
                  (let [at (rank (.datamap node) bit)
                        existing
                          (primitive/index (load (field node entries)) at)]
                    (if (entry-matches? ops existing hash key)
                        (node-replace a node owned at fresh)
                        ; Two keys share this fragment: both move one level down.
                        (let [displaced (primitive/alloc-stack (PEntry K V))
                              child-at (rank (.nodemap node) bit)]
                          (if owned
                              (copy displaced existing 1)
                              (clone-pair displaced existing))
                          (let [subtree
                                  (node-pair a
                                             (primitive/iadd shift 5)
                                             displaced
                                             fresh)
                                derived
                                  (node-derive a
                                               node
                                               owned
                                               at
                                               -1
                                               -1
                                               child-at)]
                            (set! (primitive/index (load (field derived
                                                                children))
                                                   child-at)
                                  subtree)
                            (set! (.datamap derived)
                                  (primitive/ixor (.datamap derived)
                                                  bit))
                            (set! (.nodemap derived)
                                  (primitive/ior (.nodemap derived)
                                                 bit))
                            (set! added 1)
                            derived))))
                (!= (primitive/iand (.nodemap node) bit) 0)
                  (let [at (rank (.nodemap node) bit)
                        child
                          (load (primitive/index (load (field node children))
                                                 at))
                        child-owned (and owned (= (.refs child) 1))
                        updated
                          (node-assoc a
                                      ops
                                      child
                                      child-owned
                                      (primitive/iadd shift 5)
                                      fresh
                                      added)]
                    (if (= updated child)
                        node
                        (node-set-child a node owned child-owned at updated)))
                :else
                  (let [at (rank (.datamap node) bit)
                        derived (node-derive a node owned -1 -1 at -1)]
                    (copy (primitive/index (load (field derived entries))
                                           at)
                          fresh
                          1)
                    (set! (.datamap derived)
                          (primitive/ior (.datamap derived) bit))
                    (set! added 1)
                    derived))))))

;;; Remove the pair at `at`. The bitmap is the caller's to clear.
(defn node-remove-entry [(K Clone) (V Clone)] [(a (dyn Allocator))
                                               (node (ptr (PNode K V)))
                                               (owned bool)
                                               (at i64)] (-> (ptr (PNode K V)))
  (when owned
    (drop-pair (primitive/index (load (field node entries)) at))
    0)
  (node-derive a node owned at -1 -1 -1))

;;; Remove the key at `key`. Ownership of `node` is as in `node-assoc`. When
;;; nothing matches, `removed` stays 0 and `node` is returned untouched. A result
;;; holding a single pair and no children is folded into its parent by the caller,
;;; which keeps the trie canonical: equal maps have equal shapes.
(defn node-dissoc [(K Clone) (V Clone)] [(a (dyn Allocator))
                                         (ops (ptr KeyOps))
                                         (node (ptr (PNode K V)))
                                         (owned bool)
                                         (shift i64)
                                         (hash i64)
                                         (key (ptr i8))
                                         (removed (ptr i64))] (-> (ptr (PNode K
                                                                              V)))
  (if (collision-level? shift)
      (let [at (node-find ops node hash key)]
        (if (< at 0)
            node
            (do (set! removed 1) (node-remove-entry a node owned at))))
      (let [bit (fragment-bit hash shift)]
        (cond (!= (primitive/iand (.datamap node) bit) 0)
                (let [at (rank (.datamap node) bit)]
                  (if (entry-matches? ops
                                      (primitive/index (load (field node
                                                                    entries))
                                                       at)
                                      hash
                                      key)
                      (let [shrunk (node-remove-entry a node owned at)]
                        (set! (.datamap shrunk)
                              (primitive/ixor (.datamap shrunk) bit))
                        (set! removed 1)
                        shrunk)
                      node))
              (!= (primitive/iand (.nodemap node) bit) 0)
                (let [at (rank (.nodemap node) bit)
                      child
                        (load (primitive/index (load (field node children)) at))
                      child-owned (and owned (= (.refs child) 1))
                      updated
                        (node-dissoc a
                                     ops
                                     child
                                     child-owned
                                     (primitive/iadd shift 5)
                                     hash
                                     key
                                     removed)]
                  (cond (= (load removed) 0) node
                        ; `updated` is now uniquely ours: either new, or edited in place
                        ; along an owned path.
                        (and (= (.nentries updated) 1)
                             (= (.nchildren updated) 0))
                          (let [survivor (primitive/alloc-stack (PEntry K V))
                                entry-at (rank (.datamap node) bit)]
                            (copy survivor (load (field updated entries)) 1)
                            (node-free-shell a updated)
                            (when (and owned (not child-owned))
                              (node-release! a child)
                              0)
                            (let [derived
                                    (node-derive a
                                                 node
                                                 owned
                                                 -1
                                                 at
                                                 entry-at
                                                 -1)]
                              (copy (primitive/index (load (field derived
                                                                  entries))
                                                     entry-at)
                                    survivor
                                    1)
                              (set! (.datamap derived)
                                    (primitive/ior (.datamap derived)
                                                   bit))
                              (set! (.nodemap derived)
                                    (primitive/ixor (.nodemap derived)
                                                    bit))
                              derived))
                        (and (= (.nentries updated) 0)
                             (= (.nchildren updated) 0))
                          (do
                            (fail c"a sub-node became empty; the trie was not canonical")
                            node)
                        (= updated child) node
                        :else
                          (node-set-child a
                                          node
                                          owned
                                          child-owned
                                          at
                                          updated)))
              :else node))))

; ---- the map ------------------------------------------------------------------

;;; The pair under `node` whose key equals the key at `key`, or null. `shift` is
;;; `node`'s level, so a lookup can start anywhere in a trie.
(defn node-lookup [K V] [(ops (ptr KeyOps))
                         (start (ptr (PNode K V)))
                         (start-shift i64)
                         (hash i64)
                         (key (ptr i8))] (-> (ptr (PEntry K V)))
  (let [(mut node) start
        (mut shift) start-shift
        (mut found) (primitive/cast (ptr (PEntry K V)) 0)]
    (loop (cond (= (load node) (no-node [K V])) (break)
                (collision-level? (load shift))
                  (let [at (node-find ops (load node) hash key)]
                    (when (>= at 0)
                      (set! found
                            (primitive/index (load (field (load node) entries))
                                             at))
                      0)
                    (break))
                :else
                  (let [bit (fragment-bit hash (load shift))
                        current (load node)]
                    (cond (!= (primitive/iand (.datamap current) bit) 0)
                            (let [e
                                    (primitive/index (load (field current
                                                                  entries))
                                                     (rank (.datamap current)
                                                           bit))]
                              (when (entry-matches? ops e hash key)
                                (set! found e)
                                0)
                              (break))
                          (!= (primitive/iand (.nodemap current) bit) 0)
                            (do
                              (set! node
                                    (load (primitive/index (load (field current
                                                                        children))
                                                           (rank (.nodemap current)
                                                                 bit))))
                              (set! shift (primitive/iadd (load shift) 5))
                              0)
                          :else (break)))))
    (load found)))

;;; Constructors and what a map answers and does besides the collection traits.
;;; Both key and value types must implement Clone (see the module comment).
(impl [(K Clone) (V Clone)] (PMap K V)
  ;;; An empty map allocating through `lease`, hashing and comparing keys with
  ;;; `ops`. `ops` must not own its keys (see the module comment).
  (new [(lease AllocatorLease) (ops (ptr KeyOps))] (-> (PMap K V))
    (unless (valid? ops) (fail c"PMap::new: invalid KeyOps vtable") 0)
    (when (owns? ops)
      (fail c"PMap::new: owning KeyOps are not supported; key storage follows Clone/Drop")
      0)
    (PMap
      :root (no-node [K V])
      :count 0
      :lease lease
      :ops ops))

  ;;; An empty map for scalar or pointer keys, where byte equality is value equality.
  (new-scalar [(lease AllocatorLease)] (-> (PMap K V))
    (PMap::new [K V] lease (scalar-keyops [K])))

  ;;; Do two maps share their whole structure? True after `clone` and until either
  ;;; side is edited; it is identity of storage, not equality of contents.
  (same? [(left (ref (PMap K V))) (right (ref (PMap K V)))] (-> bool)
    (= (load (field left root)) (load (field right root))))

  ;;; A borrowed pointer to the value stored under `key`. It is valid while this map,
  ;;; or any map sharing that node, is alive and the node is not edited in place.
  ;;; Like `get`, a lookup takes its key by value.
  (get-ptr [(m (ref (PMap K V))) (key K)] (-> (Option (ptr V)))
    (let [ops (load (field m ops))
          key-slot (primitive/alloc-stack K)
          key-stored (set! key-slot key)
          key-bytes (primitive/cast (ptr i8) key-slot)
          e
            (node-lookup ops
                         (load (field m root))
                         0
                         (hash ops key-bytes)
                         key-bytes)]
      (let [spent (take! [K] key-slot)] 0)
      (if (= e (primitive/cast (ptr (PEntry K V)) 0))
          (None [(ptr V)])
          (Some (field e val)))))

  (contains? [(m (ref (PMap K V))) (key K)] (-> bool)
    (match (get-ptr m key) (Some [_] true) (None [] false)))

  ;;; Remove `key`, editing in place wherever this map is the only owner. Returns 1
  ;;; when a pair was removed and 0 when the key was absent.
  (dissoc! [(m (mut (PMap K V))) (key K)] (-> i64)
    (let [root (load (field m root))
          key-slot (primitive/alloc-stack K)
          removed (primitive/alloc-stack i64)]
      (set! key-slot key)
      (set! removed 0)
      (unless (= root (no-node [K V]))
        (let [a (allocator-lease-borrow (field m lease))
              ops (load (field m ops))
              key-bytes (primitive/cast (ptr i8) key-slot)
              owned (= (.refs root) 1)
              updated
                (node-dissoc a
                             ops
                             root
                             owned
                             0
                             (hash ops key-bytes)
                             key-bytes
                             removed)]
          (when (= (load removed) 1)
            (unless owned (node-release! a root) 0)
            (set! (.root m)
                  (if (and (= (.nentries updated) 0)
                           (= (.nchildren updated) 0))
                      (do (node-release! a updated) (no-node [K V]))
                      updated))
            (set! (.count m) (primitive/isub (.count m) 1))
            0)
          0)
        0)
      (let [spent (take! [K] key-slot)] 0)
      (load removed)))

  ;;; A new map with `key` bound to `value`. `m` is unchanged and shares every node
  ;;; off the path to `key` with the result.
  (assoc [(m (ref (PMap K V))) (key K) (value V)] (-> (PMap K V))
    (let [(mut next) (clone m)]
      (set! (mut next) key value)
      next))

  ;;; A new map without `key`. `m` is unchanged.
  (dissoc [(m (ref (PMap K V))) (key K)] (-> (PMap K V))
    (let [(mut next) (clone m)]
      (dissoc! (mut next) key)
      next))

  ;;; Call `visit` for every key on which `before` and `after` differ: `(context,
  ;;; before-pair, after-pair)`, with a null pair on the side that lacks the key. A
  ;;; key in both is reported only when `same`, given pointers to the two values,
  ;;; says they differ. Returns the number of trie nodes examined.
  ;;;
  ;;; Subtrees the two maps SHARE are skipped without being read, so diffing a map
  ;;; against one derived from it costs what the edits between them cost, not what
  ;;; the maps hold. Both maps must use the same `KeyOps`. Pairs are borrowed: valid
  ;;; during the call, while both maps are alive.
  (diff [(before (ref (PMap K V)))
         (after (ref (PMap K V)))
         (same (fnptr c [(ptr i8) (ptr i8)] bool))
         (visit (fnptr c [(ptr i8) (ptr (PEntry K V)) (ptr (PEntry K V))] i64))
         (context (ptr i8))]
        (-> i64)
    (let [(mut d)
            (PMapDiff
              :ops (load (field before ops))
              :same same
              :visit visit
              :context context
              :nodes 0)]
      (diff-nodes (mut d)
                  (load (field before root))
                  (load (field after root))
                  0)
      (.nodes d))))

; Borrows the map: counting it leaves the caller's owner alive.
(impl [K V] Len (PMap K V)
  (len [(m (ref (PMap K V)))] (-> i64) (.count m)))

;;; The value stored under `key`, cloned out of the map, or None. Like `get-ptr`,
;;; a lookup takes its key by value.
(impl [(K Clone) (V Clone)] Get (PMap K V)
  (get [(m (ref (PMap K V))) (key K)] (-> (Option V))
    (match (get-ptr m key)
      (Some [value] (Some (clone-at [V] value)))
      (None [] (None [V])))))

;;; Insert or replace, editing in place wherever this map is the only owner.
;;; Returns 1 when the key is new and 0 when its value was replaced.
(impl [(K Clone) (V Clone)] Set (PMap K V)
  (set! [(m (mut (PMap K V))) (key K) (value V)] (-> i64)
    (let [a (allocator-lease-borrow (field m lease))
          ops (load (field m ops))
          fresh (primitive/alloc-stack (PEntry K V))
          added (primitive/alloc-stack i64)]
      (set! (.key fresh) key)
      (set! (.val fresh) value)
      (set! (.hash fresh)
            (hash ops (primitive/cast (ptr i8) (field fresh key))))
      (set! added 0)
      (let [root (load (field m root))]
        (set! (.root m)
              (if (= root (no-node [K V]))
                  (let [node (node-new [K V] a 1 0)]
                    (copy (load (field node entries)) fresh 1)
                    (set! (.datamap node)
                          (fragment-bit (.hash fresh) 0))
                    (set! added 1)
                    node)
                  (let [owned (= (.refs root) 1)
                        updated (node-assoc a ops root owned 0 fresh added)]
                    (unless owned (node-release! a root) 0)
                    updated))))
      (set! (.count m) (primitive/iadd (.count m) (load added)))
      (load added))))

(impl [K V] Clone (PMap K V)
  (clone [(self (ref (PMap K V)))]
         (-> (PMap K V))
         (let [root (load (field self root))]
           (unless (= root (no-node [K V]))
             (set! (.refs root) (primitive/iadd (.refs root) 1))
             0)
           (PMap
             :root root
             :count (.count self)
             :lease (clone (field self lease))
             :ops (load (field self ops))))))

; The lease field is dropped after this body, so the allocator outlives the nodes.
(impl [K V] Drop (PMap K V)
  (drop [(self (mut (PMap K V)))]
        (-> void)
        (let [root (load (field self root))]
          (unless (= root (no-node [K V]))
            (node-release! (allocator-lease-borrow (field self lease)) root)
            (set! (.root self) (no-node [K V]))
            0)
          0)))

; ---- difference ----------------------------------------------------------------

;;; What `diff` tells its visitor: `before` and `after` are the pair on each
;;; side, null where that side has no such key. Both non-null means the key is in
;;; both maps with values the caller's `same` said differ.
(defstruct PMapDiff [K V]
  [(ops (ptr KeyOps))
   (same (fnptr c [(ptr i8) (ptr i8)] bool))
   (visit (fnptr c [(ptr i8) (ptr (PEntry K V)) (ptr (PEntry K V))] i64))
   (context (ptr i8))
   (nodes i64)])

(defn no-entry [K V] [] (-> (ptr (PEntry K V)))
  (primitive/cast (ptr (PEntry K V)) 0))

;;; Report every pair under `node` as present on one side only, except `skip`.
(defn diff-all [K V] [(d (ptr (PMapDiff K V)))
                      (node (ptr (PNode K V)))
                      (added bool)
                      (skip (ptr (PEntry K V)))] (-> i64)
  (set! (.nodes d) (primitive/iadd (.nodes d) 1))
  (for [i 0 (.nentries node)]
    (let [e (primitive/index (load (field node entries)) i)]
      (when (!= e skip)
        (if added
            (primitive/call-ptr (.visit d) (.context d) (no-entry [K V]) e)
            (primitive/call-ptr (.visit d) (.context d) e (no-entry [K V])))
        0)))
  (for [i 0 (.nchildren node)]
    (diff-all d
              (load (primitive/index (load (field node children)) i))
              added
              skip))
  0)

;;; Two pairs with equal keys: report them if their values differ.
(defn diff-pair [K V] [(d (ptr (PMapDiff K V)))
                       (before (ptr (PEntry K V)))
                       (after (ptr (PEntry K V)))] (-> i64)
  (unless (primitive/call-ptr (.same d)
                              (primitive/cast (ptr i8) (field before val))
                              (primitive/cast (ptr i8) (field after val)))
    (primitive/call-ptr (.visit d) (.context d) before after)
    0)
  0)

;;; One side holds the single pair `lone` where the other holds the subtree
;;; `node` (at level `shift`). `lone-is-before` says which side is which.
(defn diff-lone [K V] [(d (ptr (PMapDiff K V)))
                       (lone (ptr (PEntry K V)))
                       (node (ptr (PNode K V)))
                       (shift i64)
                       (lone-is-before bool)] (-> i64)
  (let [twin
          (node-lookup (.ops d)
                       node
                       shift
                       (.hash lone)
                       (primitive/cast (ptr i8) (field lone key)))]
    (if (= twin (no-entry [K V]))
        (if lone-is-before
            (primitive/call-ptr (.visit d)
                                (.context d)
                                lone
                                (no-entry [K V]))
            (primitive/call-ptr (.visit d)
                                (.context d)
                                (no-entry [K V])
                                lone))
        (if lone-is-before
            (diff-pair d lone twin)
            (diff-pair d twin lone)))
    (diff-all d node lone-is-before twin)))

(defn diff-nodes [K V] [(d (ptr (PMapDiff K V)))
                        (before (ptr (PNode K V)))
                        (after (ptr (PNode K V)))
                        (shift i64)] (-> i64)
  (cond ; Shared storage is equal content: this is what makes a diff cost what the
        ; edits cost, not what the maps hold.
        (= before after) 0
        (= before (no-node [K V]))
          (diff-all d after true (no-entry [K V]))
        (= after (no-node [K V]))
          (diff-all d before false (no-entry [K V]))
        (collision-level? shift)
          (do
            (set! (.nodes d) (primitive/iadd (.nodes d) 2))
            (for [i 0 (.nentries before)]
              (let [e (primitive/index (load (field before entries)) i)
                    at
                      (node-find (.ops d)
                                 after
                                 (.hash e)
                                 (primitive/cast (ptr i8) (field e key)))]
                (if (< at 0)
                    (primitive/call-ptr (.visit d)
                                        (.context d)
                                        e
                                        (no-entry [K V]))
                    (diff-pair d
                               e
                               (primitive/index (load (field after entries))
                                                at)))))
            (for [i 0 (.nentries after)]
              (let [e (primitive/index (load (field after entries)) i)]
                (when (< (node-find (.ops d)
                                    before
                                    (.hash e)
                                    (primitive/cast (ptr i8) (field e key)))
                         0)
                  (primitive/call-ptr (.visit d)
                                      (.context d)
                                      (no-entry [K V])
                                      e)
                  0)))
            0)
        :else
          (do
            (set! (.nodes d) (primitive/iadd (.nodes d) 2))
            (for [fragment 0 32]
              (let [bit (primitive/ishl 1 fragment)
                    b-entry
                      (if (!= (primitive/iand (.datamap before) bit) 0)
                          (primitive/index (load (field before entries))
                                           (rank (.datamap before) bit))
                          (no-entry [K V]))
                    a-entry
                      (if (!= (primitive/iand (.datamap after) bit) 0)
                          (primitive/index (load (field after entries))
                                           (rank (.datamap after) bit))
                          (no-entry [K V]))
                    b-child
                      (if (!= (primitive/iand (.nodemap before) bit) 0)
                          (load (primitive/index (load (field before children))
                                                 (rank (.nodemap before) bit)))
                          (no-node [K V]))
                    a-child
                      (if (!= (primitive/iand (.nodemap after) bit) 0)
                          (load (primitive/index (load (field after children))
                                                 (rank (.nodemap after) bit)))
                          (no-node [K V]))
                    below (primitive/iadd shift 5)]
                (cond (and (!= b-entry (no-entry [K V]))
                           (!= a-entry (no-entry [K V])))
                        (if (entry-matches? (.ops d)
                                            a-entry
                                            (.hash b-entry)
                                            (primitive/cast (ptr i8)
                                                            (field b-entry
                                                                   key)))
                            (diff-pair d b-entry a-entry)
                            (do
                              (primitive/call-ptr (.visit d)
                                                  (.context d)
                                                  b-entry
                                                  (no-entry [K V]))
                              (primitive/call-ptr (.visit d)
                                                  (.context d)
                                                  (no-entry [K V])
                                                  a-entry)
                              0))
                      (!= b-entry (no-entry [K V]))
                        (if (= a-child (no-node [K V]))
                            (primitive/call-ptr (.visit d)
                                                (.context d)
                                                b-entry
                                                (no-entry [K V]))
                            (diff-lone d b-entry a-child below true))
                      (!= a-entry (no-entry [K V]))
                        (if (= b-child (no-node [K V]))
                            (primitive/call-ptr (.visit d)
                                                (.context d)
                                                (no-entry [K V])
                                                a-entry)
                            (diff-lone d a-entry b-child below false))
                      :else (diff-nodes d b-child a-child below))))
            0)))


; ---- iteration ----------------------------------------------------------------

;;; A depth-first cursor over a map's pairs. It borrows the map: it holds no
;;; reference, so the map must outlive it and must not be edited in place meanwhile.
;;; Order is by hash fragment, which is stable for a given set of keys.
(defstruct PMapIter [K V]
  [(nodes (array (ptr (PNode K V)) 14))
   (entry-at (array i64 14))
   (child-at (array i64 14))
   (depth i64)])

;;; A cursor over the map's pairs (PMapIter). It borrows the map.
(impl [K V] Iterable (PMap K V)
  (iter [(m (ref (PMap K V)))] (-> (PMapIter K V))
    (let [(mut it) (primitive/zeroed (PMapIter K V))
          root (load (field m root))]
      (if (= root (no-node [K V]))
          (set! (.depth it) -1)
          (do
            (set! (primitive/index (field it nodes) 0) root)
            (set! (.depth it) 0)))
      (load it))))

(impl [K V] Iterator (PMapIter K V)
  (next [(it (mut (PMapIter K V)))]
        (-> (Option (ptr (PEntry K V))))
        (loop (let [depth (.depth it)]
                (if (< depth 0)
                    (break (None))
                    (let [node (load (primitive/index (field it nodes) depth))
                          entry-at
                            (load (primitive/index (field it entry-at) depth))
                          child-at
                            (load (primitive/index (field it child-at) depth))]
                      (cond (< entry-at (.nentries node))
                              (do
                                (set! (primitive/index (field it entry-at)
                                                       depth)
                                      (primitive/iadd entry-at 1))
                                (break (Some (primitive/index (load (field node
                                                                           entries))
                                                              entry-at))))
                            (< child-at (.nchildren node))
                              (let [below (primitive/iadd depth 1)]
                                (set! (primitive/index (field it child-at)
                                                       depth)
                                      (primitive/iadd child-at 1))
                                (set! (primitive/index (field it nodes) below)
                                      (load (primitive/index (load (field node
                                                                          children))
                                                             child-at)))
                                (set! (primitive/index (field it entry-at)
                                                       below)
                                      0)
                                (set! (primitive/index (field it child-at)
                                                       below)
                                      0)
                                (set! (.depth it) below)
                                0)
                            :else
                              (do (set! (.depth it) (primitive/isub depth 1)) 0))))))))
