(module coil.leased-region)
(import "coil.primitive" :as primitive)
(import "coil.alloc" :as alloc)
(import "coil.region" :as region)
(import "coil.result" :use *)

(export new)

; This owner is intentionally separate from `Region`: ordinary Region retains its
; explicit force-close contract, while a leased region closes only after the final
; escaping allocator capability disappears.
(defstruct LeasedRegionState
  [(refs i64)
   (region region/Region)
   (parent alloc/AllocatorLease)])

(defn retain [(raw (ptr i8))] (-> i64)
  (let [state (primitive/cast (ptr LeasedRegionState) raw)]
    (store! (field state refs) (primitive/iadd (load (field state refs)) 1))
    0))

(defn release [(raw (ptr i8))] (-> i64)
  (let [state (primitive/cast (ptr LeasedRegionState) raw)
        next (primitive/isub (load (field state refs)) 1)]
    (store! (field state refs) next)
    (if (!= next 0)
        0
        (do
          ; Closing uses Region's borrowed parent while the owned parent lease is
          ; still resident. Then move that lease out before freeing its container.
          (close! (field state region))
          (let [parent (take! [alloc/AllocatorLease] (field state parent))]
            (alloc/lease-raw-free parent
                                  raw
                                  (alloc/AllocRequest
                                    :type-id (alloc/type-id [LeasedRegionState])
                                    :count 1
                                    :bytes (primitive/sizeof LeasedRegionState)
                                    :align (primitive/alignof LeasedRegionState))))))))

;;; A lease on a new Region whose storage comes from `parent`: the region closes,
;;; and `parent` is released, when the last clone of the returned lease is dropped.
;;; None when `parent` cannot hold the region's state.
(defn new [(parent alloc/AllocatorLease)] (-> (Option alloc/AllocatorLease))
  (match (alloc/lease-raw-alloc parent
                                (alloc/AllocRequest
                                  :type-id (alloc/type-id [LeasedRegionState])
                                  :count 1
                                  :bytes (primitive/sizeof LeasedRegionState)
                                  :align (primitive/alignof LeasedRegionState)))
    (None []
          (let [failed-parent parent]
            (None [alloc/AllocatorLease])))
    (Some [raw]
          (let [state (primitive/cast (ptr LeasedRegionState) raw)
                owned-parent parent]
            (store! (field state refs) 1)
            (region/Region::init (field state region)
                                 (alloc/allocator-lease-borrow owned-parent))
            (store! (field state parent) owned-parent)
            (Some (alloc/unsafe-allocator-lease-new (allocator (field state
                                                                      region))
                                                    raw
                                                    (primitive/fnptr-of retain)
                                                    (primitive/fnptr-of release)))))))
