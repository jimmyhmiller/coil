(module coil.prop.arbitrary)
(import "coil.primitive" :as primitive)
(import "coil.alloc" :as alloc :use *)
(import "coil.arraylist" :use *)
(import "coil.slice" :use *)
(import "coil.prop.source" :use *)
; `Arbitrary` — how a type says "here is how to build one of me from a Source".
;
; It is a TRAIT, so it is monomorphized (a draw is a direct call, no vtable) and
; OVERRIDABLE: `(impl Arbitrary MyType …)` replaces the default for that type
; everywhere, and a generic impl `(impl [(T Arbitrary)] Arbitrary (Box T))`
; covers a whole type constructor at once. Coil picks the most specific matching
; impl, so overriding ONE instance — say `(ArrayList u8)`, to generate realistic
; byte payloads — leaves the generic list impl in place for everything else.
;
; ⚠ THE SIGNATURE. `arbitrary` fills a caller-owned slot rather than returning
; `Self`, for two reasons:
;   1. Dispatch. Coil resolves a trait call from the type of an ARGUMENT; a
;      method with `Self` only in its return type has nothing to dispatch on.
;      (`coil.serde`'s `Deserialize/de` takes an out-pointer for the same reason.)
;   2. Cost. The caller allocates the slot ONCE, outside its loop, instead of an
;      `alloc/stack` per generated value — which in a million-case run is the
;      difference between a reused register-allocated slot and a stack leak.
;
; NOTHING here shrinks. Shrinking happens on the tape, so an `Arbitrary` impl
; gets correct minimization for free, and — the part hand-written shrinkers get
; wrong — every invariant the impl establishes survives it.

(deftrait Arbitrary [Self]
  (arbitrary [(out (mut Self)) (s (ptr Source))] (-> i64)))

; ------------------------------------------------------------------- scalars

(impl Arbitrary bool
  (arbitrary [(out (mut bool)) (s (ptr Source))]
             (-> i64)
             (store! out (draw-bool! s))
             0))

(impl Arbitrary i64
  (arbitrary [(out (mut i64)) (s (ptr Source))]
             (-> i64)
             (store! out (draw-int-any! s))
             0))

(impl Arbitrary i32
  (arbitrary [(out (mut i32)) (s (ptr Source))]
             (-> i64)
             (store! out (primitive/cast i32 (draw-int-origin! s -2147483648 2147483647 0)))
             0))

(impl Arbitrary i16
  (arbitrary [(out (mut i16)) (s (ptr Source))]
             (-> i64)
             (store! out (primitive/cast i16 (draw-int-origin! s -32768 32767 0)))
             0))

(impl Arbitrary i8
  (arbitrary [(out (mut i8)) (s (ptr Source))]
             (-> i64)
             (store! out (primitive/cast i8 (draw-int-origin! s -128 127 0)))
             0))

(impl Arbitrary u64
  (arbitrary [(out (mut u64)) (s (ptr Source))]
             (-> i64)
             (store! out (primitive/cast u64 (draw-int-any! s)))
             0))

(impl Arbitrary u32
  (arbitrary [(out (mut u32)) (s (ptr Source))]
             (-> i64)
             (store! out (primitive/cast u32 (draw-int-origin! s 0 4294967295 0)))
             0))

(impl Arbitrary u16
  (arbitrary [(out (mut u16)) (s (ptr Source))]
             (-> i64)
             (store! out (primitive/cast u16 (draw-int-origin! s 0 65535 0)))
             0))

(impl Arbitrary u8
  (arbitrary [(out (mut u8)) (s (ptr Source))]
             (-> i64)
             (store! out (primitive/cast u8 (draw-int-origin! s 0 255 0)))
             0))

(impl Arbitrary f64
  (arbitrary [(out (mut f64)) (s (ptr Source))]
             (-> i64)
             (store! out (draw-float! s))
             0))

(impl Arbitrary f32
  (arbitrary [(out (mut f32)) (s (ptr Source))]
             (-> i64)
             (store! out (primitive/cast f32 (draw-float! s)))
             0))

; ------------------------------------------------------------- the value form

;; `(arb [T] s)` — the ergonomic wrapper: draw a T by value.
;;
;; ⚠ The slot is an `alloc/stack` INSIDE this function, so it is released when the
;; function returns. Do not call it in a hot loop from a function that outlives
;; the loop; in that position take a slot yourself and call `arbitrary` directly.
;; The runner and the collection impls below do exactly that.
(defn arb [(T Arbitrary)] [(s (ptr Source))] (-> T)
  (let [p (primitive/alloc-stack T)]
    (arbitrary p s)
    (load p)))

;; Bytes from the case arena, with a diagnosis instead of a mystery.
;;
;; The arena is a fixed block reset between cases (that is what makes generation
;; allocation-free in steady state), so a case that asks for more than it holds
;; gets a null back. Without this, that null is dereferenced somewhere downstream
;; and the run reports a SEGFAULT — sending whoever reads it hunting for a memory
;; bug in their property instead of raising `COIL_PBT_ARENA`.
(defn prop-alloc [(s (ptr Source)) (bytes i64) (align i64)] (-> (ptr u8))
  (match (raw-alloc (src-alloc s) bytes align)
    (Some [p] (primitive/cast (ptr u8) p))
    (None []
          (do
            (oom-at c"coil.prop case arena exhausted — raise COIL_PBT_ARENA or lower COIL_PBT_SIZE"
                    bytes)
            (primitive/cast (ptr u8) 0)))))

; --------------------------------------------------------------- collections

;; A list whose length is drawn from the case's size budget and whose elements
;; each get their own span — so the shrinker can delete elements individually,
;; and adaptively delete runs of them.
;;
;; The element slot is hoisted out of the loop (one alloca, reused) rather than
;; taken per iteration: `alloc/stack` is not freed until the function returns, so
;; a per-iteration slot would grow the C stack by `sizeof T` per element.
(impl [(T Arbitrary)] Arbitrary (ArrayList T)
  (arbitrary [(out (mut (ArrayList T))) (s (ptr Source))]
             (-> i64)
             (let [sp (span-open! s "list" SPAN-PLAIN)
                   n (draw-len! s 0 (src-size s))
                   slot (primitive/alloc-stack T)
                   (mut l) (al-new [T] (src-alloc s))
                   (mut i) 0]
               (loop (if (>= (load i) n)
                         (break)
                         (let [esp (span-open! s "elem" SPAN-ELEM)]
                           (arbitrary slot s)
                           (al-push! [T] (mut l) (load slot))
                           (span-close! s esp)
                           (store! i (primitive/iadd (load i) 1))
                           0)))
               (store! out (load l))
               (span-close! s sp)
               0)))

;; `None` is variant 0, so a failing case shrinks toward the absent value — which
;; is almost always the simpler explanation of a bug.
(impl [(T Arbitrary)] Arbitrary (Option T)
  (arbitrary [(out (mut (Option T))) (s (ptr Source))]
             (-> i64)
             (let [sp (span-open! s "option" SPAN-PLAIN)
                   slot (primitive/alloc-stack T)]
               (if (= (draw-tag! s 2) 0)
                   (store! out (None))
                   (do
                     (arbitrary slot s)
                     (store! out (Some (load slot)))
                     0))
               (span-close! s sp)
               0)))

; -------------------------------------------------------------------- strings

;; Bytes drawn from the arena. ASCII-biased with deliberate structure: printable
;; runs are what most string code is written against, and the special bytes are
;; where it breaks.
(defn arb-bytes [(s (ptr Source)) (lo i64) (hi i64)] (-> (slice u8))
  (let [sp (span-open! s "bytes" SPAN-PLAIN)
        n (draw-len! s lo hi)
        buf (prop-alloc s (if (> n 0) n 1) 1)
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (let [esp (span-open! s "byte" SPAN-ELEM)]
                (store! (primitive/index buf (load i))
                        (primitive/cast u8 (draw-int-origin! s 0 255 97)))
                (span-close! s esp)
                (store! i (primitive/iadd (load i) 1))
                0)))
    (span-close! s sp)
    (slice-new [u8] buf n)))

;; A printable ASCII string — the default for `(slice u8)`, because a generated
;; "string" that is 90% control bytes fails every test for the wrong reason.
;; Use `arb-bytes` when you want the whole byte space.
(defn arb-string [(s (ptr Source)) (lo i64) (hi i64)] (-> (slice u8))
  (let [sp (span-open! s "string" SPAN-PLAIN)
        n (draw-len! s lo hi)
        buf (prop-alloc s (if (> n 0) n 1) 1)
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (let [esp (span-open! s "char" SPAN-ELEM)]
                (store! (primitive/index buf (load i))
                        (primitive/cast u8 (draw-int-origin! s 32 126 97)))
                (span-close! s esp)
                (store! i (primitive/iadd (load i) 1))
                0)))
    (span-close! s sp)
    (slice-new [u8] buf n)))

(impl Arbitrary (slice u8)
  (arbitrary [(out (mut (slice u8))) (s (ptr Source))]
             (-> i64)
             (store! out (arb-string s 0 (src-size s)))
             0))

; ------------------------------------------------------- bounded conveniences

;; Integers in an explicit range, shrinking toward the endpoint nearest zero.
(defn arb-int-range [(s (ptr Source)) (lo i64) (hi i64)] (-> i64)
  (draw-int! s lo hi))

;; Integers in a range with an explicit shrink target — use this when "simplest"
;; is not "smallest": a port number shrinks best toward 80, not toward 0.
(defn arb-int-toward [(s (ptr Source)) (lo i64) (hi i64) (origin i64)] (-> i64)
  (draw-int-origin! s lo hi origin))

;; Pick one of `n` alternatives, shrinking toward alternative 0, honouring the
;; case's swarm mask (see `source-swarm!`): a masked-out alternative is skipped,
;; so each case exercises a random subset of the available shapes.
(defn arb-choice [(s (ptr Source)) (n i64)] (-> i64)
  (let [(mut k) (draw-tag! s n)
        (mut tries) 0]
    (loop (if (or (src-swarm-allows? s (load k)) (>= (load tries) 4))
              (break)
              (do
                (store! k (primitive/irem (primitive/iadd (load k) 1) n))
                (store! tries (primitive/iadd (load tries) 1))
                0)))
    (load k)))

;; A list of exactly `n` elements — for the many properties that need matched
;; shapes (two vectors of equal length, a matrix, a fixed-arity record).
(defn arb-list-n [(T Arbitrary)] [(s (ptr Source)) (n i64)] (-> (ArrayList T))
  (let [sp (span-open! s "list-n" SPAN-PLAIN)
        slot (primitive/alloc-stack T)
        (mut l) (al-new [T] (src-alloc s))
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (let [esp (span-open! s "elem" SPAN-ELEM)]
                (arbitrary slot s)
                (al-push! [T] (mut l) (load slot))
                (span-close! s esp)
                (store! i (primitive/iadd (load i) 1))
                0)))
    (span-close! s sp)
    (load l)))
