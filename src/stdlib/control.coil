(module coil.control)
(import "coil.primitive" :as primitive)

; `Option` (None | Some) is the iterator protocol's `next` return type; importing
; it here means `for-in (iter …)` works without the user importing result too —
; macro hygiene qualifies the None/Some in the template to result's namespace.
(import "coil.result" :use *)

; `case` defaults to the `Eq` trait, which lives in the auto-loaded prelude — no
; import needed for it.
; Control-flow sugar — written entirely in Coil macros. `(import "coil.control")`
; then use `when`/`unless`/`|>`/`inline-for`/`for-in`. `cond` lives directly in
; `coil.core`, so it is available even without this module. Nothing in the compiler
; knows about any of these; they expand to `if`/`do`/`let` over the core.
;
; `while` and `for` are MACROS over the core `loop`/`break`/`continue` primitive
; (the 3 structured-control-flow forms in the compiler) — proof that the loop
; *features* live in userland, not the compiler. `inline-for` is the separate
; comptime-UNROLLED loop (bounds known at expand time), a pure macro needing no
; primitive at all.

; ⚠ Macro BODIES here use METAL comparison ops (primitive/icmp-*), never the
; clean `=`/`<`: the tower stages macros through a PRUNED closure that carries
; no trait impls (comptime.coil::closure-subprogram-pruned), so a clean operator
; in a macro body makes it unstageable inside other macro bodies. Templates
; (quoted output) may use clean ops freely — they expand at the use site.

; ---- conditionals ---------------------------------------------------------
;;; `(when c body...)` — evaluate body (yielding its last form) iff c is true,
;;; else 0. `(unless c body...)` is the negation.
;;; Stage-3 macros: ordinary `[Code…] -> Code` functions, expanded inline.
(defn when [(c Code) & (body Code)] (-> Code)
  `(if ~c (do ~@body) 0))

(defn unless [(c Code) & (body Code)] (-> Code)
  `(if ~c 0 (do ~@body)))

; ---- conditional matching ----------------------------------------------------
; `if-let`, `when-let` and `while-let` test one value against one refutable
; pattern, the way a `match` arm would: `(Some [x])`, `(Err [(NotFound [])])`,
; `(Ok [1])`, a nullary `(None)`, or a literal. Each is a `match` with that arm
; and a catch-all, so the pattern's names are in scope only where it matched.

;;; A `#\c` character literal, which the reader leaves as a symbol.
(defn if-let-char? [(p Code)] (-> bool)
  (if (primitive/code-sym? p)
      (let [bytes (primitive/str-bytes (primitive/code-str p))]
        (and (primitive/icmp-ge (primitive/code-count bytes) 3)
             (and (primitive/icmp-eq (primitive/code-int (primitive/code-nth bytes 0)) 35)
                  (primitive/icmp-eq (primitive/code-int (primitive/code-nth bytes 1)) 92))))
      false))

;;; The `match` arm for the `[PATTERN value]` binding of an if-let style form,
;;; with `body` (a list of forms) as its body.
(defn if-let-arm [(binding Code) (body Code)] (-> Code)
  (if (or (not (primitive/code-vector? binding))
          (not (primitive/icmp-eq (primitive/code-count binding) 2)))
      (primitive/error "if-let: expected a [pattern value] binding")
      (let [pattern (primitive/code-nth binding 0)]
        (if (and (primitive/code-list? pattern)
                 (and (primitive/icmp-ge (primitive/code-count pattern) 1)
                      (primitive/code-sym? (primitive/code-nth pattern 0))))
            (if (primitive/icmp-eq (primitive/code-count pattern) 1)
                `(~(primitive/code-nth pattern 0) [] ~@body)
                (if (and (primitive/icmp-eq (primitive/code-count pattern) 2)
                         (primitive/code-vector? (primitive/code-nth pattern 1)))
                    `(~(primitive/code-nth pattern 0) ~(primitive/code-nth pattern 1) ~@body)
                    (primitive/error "if-let: the pattern must be a variant pattern, (Variant [patterns…]) or (Variant), or a literal")))
            (if (or (primitive/code-int? pattern)
                    (or (primitive/code-string? pattern)
                        (or (primitive/code-eq pattern `true)
                            (or (primitive/code-eq pattern `false) (if-let-char? pattern)))))
                `(~pattern ~@body)
                (primitive/error "if-let: a name or struct pattern always matches; bind it with let"))))))

;;; `(if-let [PATTERN value] then else)` — evaluate `value` once; if it matches
;;; PATTERN, evaluate `then` with the pattern's names bound, otherwise `else`.
;;;
;;;     (if-let [(Some [port]) (env-port)] port 8080)
(defn if-let [(binding Code) (then Code) (else Code)] (-> Code)
  (let [arm (if-let-arm binding `[~then])]
    `(match ~(primitive/code-nth binding 1) ~arm (_ ~else))))

;;; `(when-let [PATTERN value] body...)` — evaluate body, yielding its last form,
;;; if `value` matches PATTERN; else 0, like `when`.
(defn when-let [(binding Code) & (body Code)] (-> Code)
  (let [arm (if-let-arm binding `[(do ~@body)])]
    `(match ~(primitive/code-nth binding 1) ~arm (_ 0))))

;;; `(while-let [PATTERN value] body...)` — evaluate `value` and run body while it
;;; matches PATTERN; the loop ends at the first value that does not.
;;;
;;;     (while-let [(Some [line]) (next-line (mut reader))] (handle line))
(defn while-let [(binding Code) & (body Code)] (-> Code)
  (let [arm (if-let-arm binding `[(do ~@body)])]
    `(loop (match ~(primitive/code-nth binding 1) ~arm (_ (break))))))

;;; `(case x k1 e1 k2 e2 … [default])` — evaluate `x` ONCE, then pick the first `ei`
;;; whose `(= x ki)` holds, using the `Eq` trait (auto-loaded prelude); a lone trailing
;;; clause is the default (0 if none). Flat `key body` pairs, Clojure-style. The keys'
;;; type must implement `Eq` — pass a non-`Eq` value and you get
;;; "'T' does not implement 'Eq'". Primitives (i64/bool), strings ((slice u8), via
;;; src/stdlib/str.coil), and any struct given an `Eq` impl by `(derive Eq T)`
;;; (src/stdlib/derive.coil) work out of the box; for a custom comparison (e.g. `sexp-sym-is` on
;;; a non-`Eq` type) use `case-by`.
;;; Recurse by INDEX, not (code-rest (code-rest …)): code-rest copies the whole
;;; tail, so pair-recursion over n clauses would allocate n²/4 nodes.
(defn case-arms [(v Code) (eq Code) (clauses Code) (i i64)] (-> Code)
  (if (primitive/icmp-eq (primitive/isub (primitive/code-count clauses) i) 0)
      `0
      (if (primitive/icmp-eq (primitive/isub (primitive/code-count clauses) i)
                             1)
          (primitive/code-nth clauses i)  ; lone trailing = default
          `(if (~eq ~v ~(primitive/code-nth clauses i))
               ~(primitive/code-nth clauses (primitive/iadd i 1))
               ~(case-arms v eq clauses (primitive/iadd i 2))))))

(defn case [(x Code) & (clauses Code)] (-> Code)
  (let [v (primitive/fresh-identifier "temporary")]
    `(let [~v ~x] ~(case-arms v `= clauses 0))))

;;; `(case-by x eq? k1 e1 … [default])` — like `case`, but with an explicit 2-arg
;;; equality `eq?` instead of the `Eq` trait. For keys whose type isn't `Eq`, or a
;;; domain predicate: e.g. `(case-by head sexp-sym-is "if" … default)`.
(defn case-by [(x Code) (eq Code) & (clauses Code)] (-> Code)
  (let [v (primitive/fresh-identifier "temporary")]
    `(let [~v ~x] ~(case-arms v eq clauses 0))))

; NOTE on `->`/`->>` (thread macros): deliberately NOT provided. `->` collides
; with Coil's reserved `(-> :type)` return-type marker — the macro expander runs
; before parsing and is position-insensitive, so a `->` macro would clobber every
; defn/extern return type. A threading macro would need a non-reserved name.

; ---- runtime loops (macros over the loop/break/continue primitive) --------
;;; `(while cond body...)` — repeat body while cond is true. Desugars to a `loop`
;;; that `break`s when cond goes false. `continue` re-checks cond (correct).
(defn while [(c Code) & (body Code)] (-> Code)
  `(loop (if ~c (do ~@body) (break))))

;;; `(for [i LO HI] body...)` — count i from LO to HI-1 (runtime bounds), binding i
;;; as an immutable value in body each iteration. The hidden counter is incremented
;;; at the TOP of the loop (starting LO-1), so a `continue` in body still advances
;;; the counter — matching C `for` semantics, no skipped increment.
;;;
;;; `(for x COLL body...)` — iterate a collection: `COLL` is any `Iterable`
;;; (a slice, an ArrayList, `(enumerate xs)`, …), `(iter coll)`, `(range LO HI)`
;;; or `(over ARR LEN)`, delegating to `for-in`. The binding may be a pattern, as
;;; in `let`: `(for (Indexed :index i :value x) (enumerate xs) …)` or
;;; `(for [a b] pairs …)`. A three-element vector is the counting form above.
(defn for-pattern? [(binding Code)] (-> bool)
  (if (primitive/code-vector? binding)
      (not (primitive/icmp-eq (primitive/code-count binding) 3))
      (primitive/code-list? binding)))

(defn for [(binding Code) & (body Code)] (-> Code)
  (if (or (primitive/code-sym? binding) (for-pattern? binding))
      `(for-in [~binding ~(primitive/code-nth body 0)]
               ~@(primitive/code-rest body))
      (if (not (primitive/icmp-eq (primitive/code-count binding) 3))
          (primitive/error "for: binding must be [i LO HI], or (for x COLL …) for a collection")
          (let [i (primitive/code-nth binding 0)
                lo (primitive/code-nth binding 1)
                hi (primitive/code-nth binding 2)
                idx (primitive/fresh-identifier "temporary")]
            `(let [(mut ~idx) (primitive/isub ~lo 1)]
               (loop (store! ~idx (primitive/iadd (load ~idx) 1))
                 (if (primitive/icmp-lt (load ~idx) ~hi)
                     (let [~i (load ~idx)] ~@body)
                     (break))))))))

;; `(for-in [x COLL] body...)` — iterate a collection, binding x to each element.
;; A macro over `for`/`loop`, dispatching on the collection FORM (the expander has
;; no types):
;;   (range LO HI)  — the ints LO..HI-1
;;   (over ARR LEN) — the elements of a fixed array ARR of length LEN
;;   (iter COLL) / (int COLL) — the coil.core Iterator protocol: `(iter COLL)` mints
;;     an iterator over any `Iterable` (slice/string, ArrayList, HashMap — and any
;;     type you `(impl Iterable …)`), and `(next it)` yields each element. This is
;;     the ONE protocol that replaces the old per-collection `slice-for`/`al-for`
;;     macros; `(int map)` now iterates the map's KEYS correctly instead of
;;     `get`-by-index garbage (std-4). `iter` and `in` are synonyms here.
; ⚠ `iter` is a TRAIT METHOD, so referential hygiene qualifies it to
; `coil.core.iter` when the `(iter …)` was written inside another macro's template
; — `slice-for` expands to exactly that. Matching only the bare spelling rejected
; those forms with "unsupported collection", for a form the user never wrote.
;
; Both spellings are compared with `code-eq`, which needs no string library: this
; module is deliberately dependency-free (coil.str and coil.slice import IT), so a
; byte comparison here would close an import cycle.
(defn head-name-is? [(h Code) (bare Code) (qualified Code)] (-> bool)
  (or (primitive/code-eq h bare) (primitive/code-eq h qualified)))

(defn for-in [(binding Code) & (body Code)] (-> Code)
  (if (not (primitive/icmp-eq (primitive/code-count binding) 2))
      (primitive/error "for-in: binding must be [x COLL]")
      (let [pattern (primitive/code-nth binding 0)
            coll (primitive/code-nth binding 1)]
        (if (not (primitive/code-sym? pattern))
            ; A pattern binds from a fresh item, exactly as `let` would.
            (let [item (primitive/fresh-identifier "item")]
              `(for-in [~item ~coll] (let [~pattern ~item] ~@body)))
            (for-in-simple pattern coll body)))))

; Any collection expression that is not one of the special forms below is driven
; through `Iterable`, so `(for x xs)` and `(for e (enumerate xs))` need no `iter`.
(defn for-in-iterable [(x Code) (coll Code) (body Code)] (-> Code)
  (let [it (primitive/fresh-identifier "temporary")]
    `(let [(mut ~it) (iter ~coll)]
       (loop (match (next (mut ~it))
               (None [] (break))
               (Some [~x] ~@body))))))

(defn for-in-simple [(x Code) (coll Code) (body Code)] (-> Code)
  (let [h
          (if (primitive/code-list? coll)
              (primitive/code-nth coll 0)
              `for-in-none)]
    ; `(range LO HI)` is a value: both bounds are evaluated once, in order, before
    ; the first iteration, where the counting form would re-read HI on each one.
    (if (primitive/code-eq h `range)
        (let [lo (primitive/fresh-identifier "temporary")
              hi (primitive/fresh-identifier "temporary")]
          `(let [~lo ~(primitive/code-nth coll 1)
                 ~hi ~(primitive/code-nth coll 2)]
             (for [~x ~lo ~hi]
               ~@body)))
        (if (primitive/code-eq h `over)
            (let [arr (primitive/code-nth coll 1)
                  len (primitive/code-nth coll 2)
                  i (primitive/fresh-identifier "temporary")]
              `(for [~i 0 ~len]
                 (let [~x (load (primitive/index ~arr ~i))] ~@body)))
            ; (iter COLL) / (int COLL) already produce the iterator to drive.
            ; ⚠ Compare both spellings: `iter` is a trait method, so referential
            ; hygiene qualifies it to `coil.core.iter` when the `(iter …)` was
            ; written inside another macro's template (`slice-for` does that).
            (if (or (head-name-is? h `iter `coil.core.iter)
                    (head-name-is? h `in `coil.core.in))
                (for-in-iterable x (primitive/code-nth coll 1) body)
                (for-in-iterable x coll body))))))

; ---- threading ------------------------------------------------------------
;;; Spelled `|>`/`|>>` (F#/Elixir/OCaml) rather than Clojure's `->`/`->>`: `->`
;;; collides with Coil's reserved `(-> :type)` return marker (the pre-parse,
;;; position-blind expander would otherwise clobber every defn/extern return type).
;;; `|>` is unreserved, so it's a clean macro.
;;;
;;; `(|> x (f a) g)` => `(g (f x a))` — thread x as the FIRST argument.
;;; Index recursion: `(code-rest forms)` here would copy the remaining stages on
;;; every step. The one-shot `~@(code-rest form)` inside a stage stays — that is
;;; the single irreducible copy of that stage's own arguments.
(defn thread-first [(x Code) (forms Code) (i i64)] (-> Code)
  (if (primitive/icmp-eq (primitive/isub (primitive/code-count forms) i) 0)
      x
      (thread-first (let [form (primitive/code-nth forms i)]
                      (if (primitive/code-list? form)
                          `(~(primitive/code-nth form 0) ~x
                              ~@(primitive/code-rest form))  ; (f a) → (f x a)
                          `(~form ~x)))  ; g → (g x)
                    forms
                    (primitive/iadd i 1))))

(defn |> [(x Code) & (forms Code)] (-> Code)
  (thread-first x forms 0))

;;; `(|>> x (f a) g)` => `(g (f a x))` — thread x as the LAST argument.
(defn thread-last [(x Code) (forms Code) (i i64)] (-> Code)
  (if (primitive/icmp-eq (primitive/isub (primitive/code-count forms) i) 0)
      x
      (thread-last (let [form (primitive/code-nth forms i)]
                     (if (primitive/code-list? form)
                         `(~@form ~x)  ; (f a) → (f a x)
                         `(~form ~x)))
                   forms
                   (primitive/iadd i 1))))

(defn |>> [(x Code) & (forms Code)] (-> Code)
  (thread-last x forms 0))

; ---- labeled block + early return (macros over loop/break) ----------------
;;; `(block :b body...)` evaluates body and yields its value; `(return-from :b v)`
;;; anywhere inside exits the block early with v. This is the substrate
;;; `defer`/scope guards build on.
;;;
;;; It is the core `block*`: a labelled one-pass loop whose value is delivered by
;;; `(break :b v)`, which only a LABELLED break may leave. An unlabeled `(break)` or
;;; `(continue)` written inside a block belongs to the loop around it.
(defn block [(label Code) & (body Code)] (-> Code)
  `(block* ~label ~@body))

(defn return-from [(label Code) (v Code)] (-> Code)
  `(break ~label ~v))

; ---- defer and scope ------------------------------------------------------
;;; `(defer cleanup)` guards the forms after it in the body it is written in -- the
;;; body of a function, `let`, `do`, `loop`, `block` or match arm, and so of every
;;; macro that expands to one (`when`, `for`, `while`, `scope`, ...). Once control
;;; has reached it, `cleanup` runs when control leaves that body: by falling off the
;;; end, or by any break, continue or return-from that leaves it, including the ones
;;; a macro writes, such as `try!`. Cleanups run last-registered first, an inner
;;; body's before an outer one's, interleaved with the drops of owners by where each
;;; began; a break's value is computed before they run. A defer not yet reached
;;; registers nothing.
;;;
;;; The compiler's core `defer*` does the work; see parser.coil.
(defn defer [& (body Code)] (-> Code)
  `(defer* ~@body))

;;; `(scope :s body...)` is `(block :s body...)`: a labelled body to put defers in,
;;; which `(return-from :s value)` leaves early.
(defn scope [(label Code) & (body Code)] (-> Code)
  (if (not (primitive/code-keyword? label))
      (primitive/error "scope: first argument must be a :label, e.g. (scope :s body...)")
      `(block* ~label ~@body)))

; ---- comptime-unrolled loop ----------------------------------------------
;;; `(inline-for [i LO HI] body...)` — fully unrolls `body` for i = LO..HI-1,
;;; with i a compile-time literal each iteration (zero runtime loop overhead).
;;; LO/HI MUST be literal integers (known at expansion); for runtime bounds use
;;; `for`.
;;; A growable Code list, not `(… ~@(inline-for-iters …))`: splicing the
;;; recursion's result rebuilds the suffix at every level, which is quadratic in
;;; the iteration count.
(defn inline-for-iters [(i Code) (lo i64) (hi i64) (body Code)] (-> Code)
  (let [out (primitive/code-list-new)
        (mut k) lo]
    (loop (if (primitive/icmp-lt (load k) hi)
              (do
                (primitive/code-list-push! out `(let [~i ~(load k)] ~@body))
                (store! k (primitive/iadd (load k) 1)))
              (break)))
    (primitive/code-list-done out)))

(defn inline-for [(binding Code) & (body Code)] (-> Code)
  (if (not (primitive/icmp-eq (primitive/code-count binding) 3))
      (primitive/error "inline-for: binding must be [i LO HI] with literal integer bounds")
      (let [i (primitive/code-nth binding 0)
            lo (primitive/code-int (primitive/code-nth binding 1))
            hi (primitive/code-int (primitive/code-nth binding 2))]
        `(do ~@(inline-for-iters i lo hi body)))))

;;; Compatibility spellings for variadic boolean conjunction/disjunction. Keep
;;; their expansion rooted in `if`: a macro result's outer form proceeds directly
;;; to parsing and is not reconsidered as another macro call in the same round.
(defn all [& (xs Code)] (-> Code)
  (if (primitive/icmp-eq (primitive/code-count xs) 0)
      `true
      (if (primitive/icmp-eq (primitive/code-count xs) 1)
          (primitive/code-nth xs 0)
          `(if ~(primitive/code-nth xs 0)
               (all ~@(primitive/code-rest xs))
               false))))

(defn any [& (xs Code)] (-> Code)
  (if (primitive/icmp-eq (primitive/code-count xs) 0)
      `false
      (if (primitive/icmp-eq (primitive/code-count xs) 1)
          (primitive/code-nth xs 0)
          `(if ~(primitive/code-nth xs 0) true (any ~@(primitive/code-rest xs))))))
