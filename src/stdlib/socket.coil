(module coil.socket)
(import "coil.primitive" :as primitive)
(import "coil.alloc" :as alloc)
(import "coil.str" :as str)
(import "coil.slice" :use [slice-len slice-get])
(import "coil.os" :as os)
(import "coil.io" :as io)
(import "coil.selectors" :as selectors)
(import "coil.time" :as time)
; Pulling all of netinet/in.h through clang's JSON AST made every socket-using build
; parse and retain an SDK-sized syntax tree. This is the complete ABI surface used by
; this module; keep it narrow and prove the caller-owned layouts below.
(defstruct in_addr [(s_addr u32)])
(defstruct sockaddr [(bytes (array u8 16))])

;; Platform metas define caller-visible ABI declarations. Their spellings are
;; the public C/Coil protocol, so context removal is intentional and explicit.
;; hygiene: platform ABI declaration names intentionally enter this module's public namespace.
(defn explicit-public-declaration-name [(name Code)] (-> Code)
  (primitive/syntax->datum name))

(defn gen-socket-abi [] (-> Code)
  (if (primitive/code-eq (primitive/target-os) `linux)
      `(do
         (const ~(explicit-public-declaration-name `AF_INET) 2)
         (const ~(explicit-public-declaration-name `SOCK_STREAM) 1)
         (const ~(explicit-public-declaration-name `SOL_SOCKET) 1)
         (const ~(explicit-public-declaration-name `SO_REUSEADDR) 2)
         (defstruct ~(explicit-public-declaration-name `sockaddr_in)
           [(sin_family u16)
            (sin_port u16)
            (sin_addr in_addr)
            (sin_zero (array u8 8))]))
      `(do
         (const ~(explicit-public-declaration-name `AF_INET) 2)
         (const ~(explicit-public-declaration-name `SOCK_STREAM) 1)
         (const ~(explicit-public-declaration-name `SOL_SOCKET) 65535)
         (const ~(explicit-public-declaration-name `SO_REUSEADDR) 4)
         (defstruct ~(explicit-public-declaration-name `sockaddr_in)
           [(sin_len u8)
            (sin_family u8)
            (sin_port u16)
            (sin_addr in_addr)
            (sin_zero (array u8 8))]))))
(meta (gen-socket-abi))

(static-assert (= (primitive/sizeof in_addr) 4) "in_addr ABI size")
(static-assert (= (primitive/sizeof sockaddr) 16) "sockaddr ABI size")
(static-assert (= (primitive/sizeof sockaddr_in) 16) "sockaddr_in ABI size")

;; AF_UNIX is 1 on both platforms, but sockaddr_un differs: Linux leads with a
;; 2-byte family and allows a 108-byte path, while the BSD layout macOS inherits
;; leads with a length byte and allows 104. Both are proved by size below.
(defn gen-unix-abi [] (-> Code)
  (if (primitive/code-eq (primitive/target-os) `linux)
      `(do
         (const ~(explicit-public-declaration-name `AF_UNIX) 1)
         (const ~(explicit-public-declaration-name `SUN_PATH_CAPACITY) 108)
         (defstruct ~(explicit-public-declaration-name `sockaddr_un)
           [(sun_family u16)
            (sun_path (array u8 108))]))
      `(do
         (const ~(explicit-public-declaration-name `AF_UNIX) 1)
         (const ~(explicit-public-declaration-name `SUN_PATH_CAPACITY) 104)
         (defstruct ~(explicit-public-declaration-name `sockaddr_un)
           [(sun_len u8)
            (sun_family u8)
            (sun_path (array u8 104))]))))
(meta (gen-unix-abi))

(defn gen-sockaddr-un-size-assert [] (-> Code)
  (if (primitive/code-eq (primitive/target-os) `linux)
      `(static-assert (= (primitive/sizeof sockaddr_un) 110) "sockaddr_un ABI size")
      `(static-assert (= (primitive/sizeof sockaddr_un) 106) "sockaddr_un ABI size")))
(meta (gen-sockaddr-un-size-assert))

(export TcpListener
        TcpConnection
        SocketError
        InvalidAddress
        OpenFailed
        OptionFailed
        BindFailed
        ListenFailed
        AcceptFailed
        ConnectFailed
        IoFailed
        Closed
        socket-error-code
        tcp-listen
        tcp-listener-port
        tcp-listener-watch
        tcp-accept
        tcp-accept-for
        tcp-connect
        tcp-connection-watch
        tcp-read
        tcp-write
        tcp-listener-close!
        tcp-connection-close!
        UnixListener
        UnixConnection
        SUN_PATH_CAPACITY
        unix-listen
        unix-listener-watch
        unix-accept
        unix-accept-for
        unix-connect
        unix-connection-watch
        unix-read
        unix-write
        unix-listener-close!
        unix-connection-close!)

(defsum SocketError
  (InvalidAddress)
  (OpenFailed [(code i64)])
  (OptionFailed [(code i64)])
  (BindFailed [(code i64)])
  (ListenFailed [(code i64)])
  (AcceptFailed [(code i64)])
  (ConnectFailed [(code i64)])
  (IoFailed [(code i64)])
  (Closed))

(defstruct TcpListener [(fd i32) (closed bool)])
(defstruct TcpConnection [(fd i32) (closed bool)])
(defstruct UnixListener [(fd i32) (closed bool)])
(defstruct UnixConnection [(fd i32) (closed bool)])

(defn socket-error-code [(error SocketError)] (-> i64)
  (match error
    (InvalidAddress [] 1)
    (OpenFailed [code] (+ 100 code))
    (OptionFailed [code] (+ 200 code))
    (BindFailed [code] (+ 300 code))
    (ListenFailed [code] (+ 400 code))
    (AcceptFailed [code] (+ 500 code))
    (ConnectFailed [code] (+ 600 code))
    (IoFailed [code] (+ 700 code))
    (Closed [] 2)))

(extern socket :cc c [i32 i32 i32] (-> i32))
(extern setsockopt :cc c [i32 i32 i32 (ptr i8) u32] (-> i32))
(extern send :cc c [i32 (ptr i8) isize i32] (-> isize))  ; ssize_t send(int, const void*, size_t, int)
(extern bind :cc c [i32 (ptr sockaddr) u32] (-> i32))
(extern listen :cc c [i32 i32] (-> i32))
(extern accept :cc c [i32 (ptr sockaddr) (ptr u32)] (-> i32))
(extern connect :cc c [i32 (ptr sockaddr) u32] (-> i32))
(extern getsockname :cc c [i32 (ptr sockaddr) (ptr u32)] (-> i32))
(extern htons :cc c [u16] (-> u16))
(extern ntohs :cc c [u16] (-> u16))
(extern inet_pton :cc c [i32 (ptr i8) (ptr i8)] (-> i32))

;; Writing to a socket whose peer has closed raises SIGPIPE, and the DEFAULT DISPOSITION
;; TERMINATES THE PROCESS. For a server that is catastrophic and completely remote from
;; anything the code did wrong: one client going away kills every other connection with
;; it. The fix belongs here rather than in the signal layer — making it the caller's job
;; would mean every program that writes to a socket has to install a process-global
;; signal handler before it is safe, and `coil.signals` is deliberately narrow. Suppressed
;; at the socket, the write just returns EPIPE and the existing `IoFailed` path reports it.
;;
;; The two platforms spell it differently, and neither spelling works on the other:
;;   * Darwin/BSD: SO_NOSIGPIPE (0x1022), a per-socket option set once after the fd exists.
;;   * Linux: no such option — the flag lives on the CALL, as MSG_NOSIGNAL (0x4000) to
;;     send(). So Linux needs no setsockopt and Darwin needs no flag; each does the half
;;     the other cannot.
(defn gen-nosigpipe-platform [] (-> Code)
  (if (primitive/code-eq (primitive/target-os) `linux)
      `(do
         (defn ~(explicit-public-declaration-name `send-flags) [] (-> i32)
           16384)
         ;; Linux carries it per-call; nothing to set on the socket.
         (defn ~(explicit-public-declaration-name `suppress-sigpipe!) [(fd i32)] (-> i64)
           0))
      `(do
         (const ~(explicit-public-declaration-name `SO_NOSIGPIPE) 4130)
         (defn ~(explicit-public-declaration-name `send-flags) [] (-> i32)
           0)
         (defn ~(explicit-public-declaration-name `suppress-sigpipe!) [(fd i32)] (-> i64)
           (let [enabled (alloc/stack i32)]
             (store! enabled 1)
             ;; Best-effort: a socket that rejects the option is still usable, and
             ;; failing the accept/connect over it would be a worse trade than the
             ;; SIGPIPE risk it leaves behind.
             (primitive/cast i64 (setsockopt fd SOL_SOCKET SO_NOSIGPIPE (primitive/cast (ptr i8) enabled) 4)))))))
(meta (gen-nosigpipe-platform))

;; Every connected fd — accepted or dialled — is adopted through one of these, so the
;; suppression cannot be forgotten at one of the four sites that produce one.
(defn adopt-tcp-fd! [(connection (ptr TcpConnection)) (fd i32)] (-> i64)
  (suppress-sigpipe! fd)
  (store! (field connection fd) fd)
  (store! (field connection closed) false)
  0)

(defn adopt-unix-fd! [(connection (ptr UnixConnection)) (fd i32)] (-> i64)
  (suppress-sigpipe! fd)
  (store! (field connection fd) fd)
  (store! (field connection closed) false)
  0)

(defn gen-sockaddr-platform [] (-> Code)
  (if (primitive/code-eq (primitive/target-os) `linux)
      `(defn ~(explicit-public-declaration-name `sockaddr-ipv4-init) [(address (ptr sockaddr_in))] (-> i64)
         (store! (field address sin_family) (primitive/cast u16 AF_INET))
         0)
      `(defn ~(explicit-public-declaration-name `sockaddr-ipv4-init) [(address (ptr sockaddr_in))] (-> i64)
         (store! (field address sin_len) (primitive/cast u8 (sizeof sockaddr_in)))
         (store! (field address sin_family) (primitive/cast u8 AF_INET))
         0)))
(meta (gen-sockaddr-platform))

(defn sockaddr-ipv4 [(a (ptr alloc/Allocator)) (host (slice u8)) (port i64) (address (ptr sockaddr_in))] (-> (Result i64
                                                                                                                     SocketError))
  (if (or (< port 0) (> port 65535))
      (Err (InvalidAddress))
      (let [c-host (str/str->cstr a host)]
        (if (= (primitive/cast i64 c-host) 0)
            (Err (InvalidAddress))
            (do
              (sockaddr-ipv4-init address)
              (store! (field address sin_port) (htons (primitive/cast u16 port)))
              (let [rc (inet_pton AF_INET c-host (primitive/cast (ptr i8) (field address sin_addr)))]
                (alloc/raw-free a c-host (+ (slice-len host) 1) 1)
                (if (= rc (primitive/cast i32 1)) (Ok 0) (Err (InvalidAddress)))))))))

(defn tcp-open [] (-> (Result i32 SocketError))
  (let [fd (socket AF_INET SOCK_STREAM 0)]
    (if (< fd 0) (Err (OpenFailed (os/os-errno))) (Ok fd))))

(defn tcp-listen [(a (ptr alloc/Allocator))
                  (listener (ptr TcpListener))
                  (host (slice u8))
                  (port i64)
                  (reuse-address bool)
                  (backlog i64)] (-> (Result (ptr TcpListener) SocketError))
  (match (tcp-open)
    (Err [e] (Err e))
    (Ok [fd]
        (block :done
               (when reuse-address
                 (let [enabled (alloc/stack i32)]
                   (store! enabled 1)
                   (if (< (setsockopt fd SOL_SOCKET SO_REUSEADDR (primitive/cast (ptr i8) enabled) 4) 0)
                       (do (os/close fd) (return-from :done (Err (OptionFailed (os/os-errno)))))
                       0)))
               (let [address (alloc/stack sockaddr_in)]
                 (match (sockaddr-ipv4 a host port address)
                   (Err [e] (do (os/close fd) (return-from :done (Err e))))
                   (Ok [_] 0))
                 (if (< (bind fd (primitive/cast (ptr sockaddr) address) (primitive/cast u32 (sizeof sockaddr_in))) 0)
                     (do (os/close fd) (return-from :done (Err (BindFailed (os/os-errno)))))
                     0))
               (if (< (listen fd (primitive/cast i32 backlog)) 0)
                   (do (os/close fd) (return-from :done (Err (ListenFailed (os/os-errno)))))
                   (do
                     (store! (field listener fd) fd)
                     (store! (field listener closed) false)
                     (Ok listener)))))))

(defn tcp-listener-port [(listener (ptr TcpListener))] (-> (Result i64 SocketError))
  (if (load (field listener closed))
      (Err (Closed))
      (let [address (alloc/stack sockaddr_in)
            length (alloc/stack u32)]
        (store! length (primitive/cast u32 (sizeof sockaddr_in)))
        (if (< (getsockname (load (field listener fd)) (primitive/cast (ptr sockaddr) address) length) 0)
            (Err (IoFailed (os/os-errno)))
            (Ok (primitive/cast i64 (ntohs (load (field address sin_port)))))))))

(defn tcp-listener-watch [(listener (ptr TcpListener)) (tag i64)] (-> selectors/Watch)
  (selectors/watch (load (field listener fd)) (selectors/interest-readable) tag))

(defn tcp-accept [(listener (ptr TcpListener)) (connection (ptr TcpConnection))] (-> (Result (ptr TcpConnection)
                                                                                             SocketError))
  (if (load (field listener closed))
      (Err (Closed))
      (block :done
             (loop (let [fd
                           (accept (load (field listener fd))
                                   (primitive/cast (ptr sockaddr) 0)
                                   (primitive/cast (ptr u32) 0))]
                     (if (>= fd 0)
                         (do
                           (adopt-tcp-fd! connection fd)
                           (return-from :done (Ok connection)))
                         (let [error (os/os-errno)]
                           (if (= error 4) 0 (return-from :done (Err (AcceptFailed error)))))))))))

(defn tcp-accept-for [(listener (ptr TcpListener))
                      (connection (ptr TcpConnection))
                      (duration time/Duration)] (-> (Result (ptr TcpConnection) SocketError))
  (match (selectors/wait-fd-for (load (field listener fd)) (selectors/interest-readable) duration)
    (Err [e]
         (match e
           (selectors/Timeout [] (Err (AcceptFailed 110)))
           (selectors/InvalidFd [] (Err (Closed)))
           (selectors/Syscall [code] (Err (AcceptFailed code)))))
    (Ok [_] (tcp-accept listener connection))))

(defn tcp-connect [(a (ptr alloc/Allocator))
                   (connection (ptr TcpConnection))
                   (host (slice u8))
                   (port i64)] (-> (Result (ptr TcpConnection) SocketError))
  (match (tcp-open)
    (Err [e] (Err e))
    (Ok [fd]
        (let [address (alloc/stack sockaddr_in)]
          (match (sockaddr-ipv4 a host port address)
            (Err [e] (do (os/close fd) (Err e)))
            (Ok [_]
                (if (< (connect fd (primitive/cast (ptr sockaddr) address) (primitive/cast u32 (sizeof sockaddr_in))) 0)
                    (let [error (os/os-errno)] (os/close fd) (Err (ConnectFailed error)))
                    (do (adopt-tcp-fd! connection fd) (Ok connection)))))))))

(defn tcp-connection-watch [(connection (ptr TcpConnection)) (interest selectors/Interest) (tag i64)] (-> selectors/Watch)
  (selectors/watch (load (field connection fd)) interest tag))

(defn tcp-read [(connection (ptr TcpConnection)) (buffer (ptr i8)) (length i64)] (-> (Result i64 SocketError))
  (if (load (field connection closed))
      (Err (Closed))
      (let [n (primitive/cast i64 (io/read (load (field connection fd)) buffer (primitive/cast isize length)))]
        (if (< n 0) (Err (IoFailed (os/os-errno))) (Ok n)))))

(defn tcp-write [(connection (ptr TcpConnection)) (buffer (ptr i8)) (length i64)] (-> (Result i64 SocketError))
  (if (load (field connection closed))
      (Err (Closed))
      ;; send(), not write(): MSG_NOSIGNAL is how Linux suppresses SIGPIPE, and there
      ;; is no way to pass it through write(). On Darwin the flag is 0 and the socket
      ;; option set at accept/connect does the same job.
      (let [n
              (primitive/cast i64
                              (send (load (field connection fd))
                                    buffer
                                    (primitive/cast isize length)
                                    (send-flags)))]
        (if (< n 0) (Err (IoFailed (os/os-errno))) (Ok n)))))

(defn tcp-listener-close! [(listener (ptr TcpListener))] (-> i64)
  (unless (load (field listener closed))
    (os/close (load (field listener fd)))
    (store! (field listener fd) -1)
    (store! (field listener closed) true))
  0)

(defn tcp-connection-close! [(connection (ptr TcpConnection))] (-> i64)
  (unless (load (field connection closed))
    (os/close (load (field connection fd)))
    (store! (field connection fd) -1)
    (store! (field connection closed) true))
  0)

;; ---------------------------------------------------------------------------
;; AF_UNIX stream sockets
;;
;; Same syscalls as the TCP path; only the address family and the address
;; struct differ. A unix socket is addressed by a filesystem path, so the path
;; carries the permissions -- there is no port to bind and no token to present.
;;
;; The socket file's lifecycle belongs to the caller. `bind` fails with EADDRINUSE
;; if the path already exists, including when a previous process died without
;; cleaning up, so a server that wants to rebind must remove the stale path
;; itself. This module deliberately does not unlink on the caller's behalf: it
;; cannot tell a stale socket from one a live server is serving.
;; ---------------------------------------------------------------------------

(defn gen-sockaddr-un-platform [] (-> Code)
  (if (primitive/code-eq (primitive/target-os) `linux)
      `(defn ~(explicit-public-declaration-name `sockaddr-unix-init) [(address (ptr sockaddr_un))] (-> i64)
         (store! (field address sun_family) (primitive/cast u16 AF_UNIX))
         0)
      `(defn ~(explicit-public-declaration-name `sockaddr-unix-init) [(address (ptr sockaddr_un))] (-> i64)
         (store! (field address sun_len) (primitive/cast u8 (sizeof sockaddr_un)))
         (store! (field address sun_family) (primitive/cast u8 AF_UNIX))
         0)))
(meta (gen-sockaddr-un-platform))

;; Fill `address` from `path`. The path must leave room for a NUL terminator,
;; so the usable length is one less than SUN_PATH_CAPACITY.
(defn sockaddr-unix [(path (slice u8)) (address (ptr sockaddr_un))] (-> (Result i64 SocketError))
  (let [n (slice-len path)]
    (if (or (= n 0) (>= n (- SUN_PATH_CAPACITY 1)))
        (Err (InvalidAddress))
        (do
          (sockaddr-unix-init address)
          (let [destination (primitive/cast (ptr u8) (field address sun_path))
                (mut i) 0]
            (loop (if (>= (load i) n)
                      (break)
                      (do
                        (store! (primitive/index destination (load i)) (slice-get path (load i)))
                        (store! i (+ (load i) 1)))))
            (store! (primitive/index destination n) (primitive/cast u8 0)))
          (Ok 0)))))

(defn unix-open [] (-> (Result i32 SocketError))
  (let [fd (socket AF_UNIX SOCK_STREAM 0)]
    (if (< fd 0) (Err (OpenFailed (os/os-errno))) (Ok fd))))

(defn unix-listen [(listener (ptr UnixListener))
                   (path (slice u8))
                   (backlog i64)] (-> (Result (ptr UnixListener) SocketError))
  (match (unix-open)
    (Err [e] (Err e))
    (Ok [fd]
        (block :done
               (let [address (alloc/stack sockaddr_un)]
                 (match (sockaddr-unix path address)
                   (Err [e] (do (os/close fd) (return-from :done (Err e))))
                   (Ok [_] 0))
                 (if (< (bind fd
                              (primitive/cast (ptr sockaddr) address)
                              (primitive/cast u32 (sizeof sockaddr_un)))
                        0)
                     (do (os/close fd) (return-from :done (Err (BindFailed (os/os-errno)))))
                     0))
               (if (< (listen fd (primitive/cast i32 backlog)) 0)
                   (do (os/close fd) (return-from :done (Err (ListenFailed (os/os-errno)))))
                   (do
                     (store! (field listener fd) fd)
                     (store! (field listener closed) false)
                     (Ok listener)))))))

(defn unix-listener-watch [(listener (ptr UnixListener)) (tag i64)] (-> selectors/Watch)
  (selectors/watch (load (field listener fd)) (selectors/interest-readable) tag))

(defn unix-accept [(listener (ptr UnixListener))
                   (connection (ptr UnixConnection))] (-> (Result (ptr UnixConnection) SocketError))
  (if (load (field listener closed))
      (Err (Closed))
      (block :done
             (loop (let [fd
                           (accept (load (field listener fd))
                                   (primitive/cast (ptr sockaddr) 0)
                                   (primitive/cast (ptr u32) 0))]
                     (if (>= fd 0)
                         (do
                           (adopt-unix-fd! connection fd)
                           (return-from :done (Ok connection)))
                         (let [error (os/os-errno)]
                           ;; EINTR: the accept was interrupted, not failed.
                           (if (= error 4) 0 (return-from :done (Err (AcceptFailed error)))))))))))

(defn unix-accept-for [(listener (ptr UnixListener))
                       (connection (ptr UnixConnection))
                       (duration time/Duration)] (-> (Result (ptr UnixConnection) SocketError))
  (match (selectors/wait-fd-for (load (field listener fd)) (selectors/interest-readable) duration)
    (Err [e]
         (match e
           (selectors/Timeout [] (Err (AcceptFailed 110)))
           (selectors/InvalidFd [] (Err (Closed)))
           (selectors/Syscall [code] (Err (AcceptFailed code)))))
    (Ok [_] (unix-accept listener connection))))

(defn unix-connect [(connection (ptr UnixConnection))
                    (path (slice u8))] (-> (Result (ptr UnixConnection) SocketError))
  (match (unix-open)
    (Err [e] (Err e))
    (Ok [fd]
        (let [address (alloc/stack sockaddr_un)]
          (match (sockaddr-unix path address)
            (Err [e] (do (os/close fd) (Err e)))
            (Ok [_]
                (if (< (connect fd
                                (primitive/cast (ptr sockaddr) address)
                                (primitive/cast u32 (sizeof sockaddr_un)))
                       0)
                    (let [error (os/os-errno)] (os/close fd) (Err (ConnectFailed error)))
                    (do (adopt-unix-fd! connection fd) (Ok connection)))))))))

(defn unix-connection-watch [(connection (ptr UnixConnection))
                             (interest selectors/Interest)
                             (tag i64)] (-> selectors/Watch)
  (selectors/watch (load (field connection fd)) interest tag))

(defn unix-read [(connection (ptr UnixConnection)) (buffer (ptr i8)) (length i64)] (-> (Result i64 SocketError))
  (if (load (field connection closed))
      (Err (Closed))
      (let [n (primitive/cast i64 (io/read (load (field connection fd)) buffer (primitive/cast isize length)))]
        (if (< n 0) (Err (IoFailed (os/os-errno))) (Ok n)))))

(defn unix-write [(connection (ptr UnixConnection)) (buffer (ptr i8)) (length i64)] (-> (Result i64 SocketError))
  (if (load (field connection closed))
      (Err (Closed))
      ;; send(), not write(): MSG_NOSIGNAL is how Linux suppresses SIGPIPE, and there
      ;; is no way to pass it through write(). On Darwin the flag is 0 and the socket
      ;; option set at accept/connect does the same job.
      (let [n
              (primitive/cast i64
                              (send (load (field connection fd))
                                    buffer
                                    (primitive/cast isize length)
                                    (send-flags)))]
        (if (< n 0) (Err (IoFailed (os/os-errno))) (Ok n)))))

(defn unix-listener-close! [(listener (ptr UnixListener))] (-> i64)
  (unless (load (field listener closed))
    (os/close (load (field listener fd)))
    (store! (field listener fd) -1)
    (store! (field listener closed) true))
  0)

(defn unix-connection-close! [(connection (ptr UnixConnection))] (-> i64)
  (unless (load (field connection closed))
    (os/close (load (field connection fd)))
    (store! (field connection fd) -1)
    (store! (field connection closed) true))
  0)
