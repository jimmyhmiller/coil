; MessagePack backend for coil.serde — the binary format, validating the data

; model beyond text: length-prefixed strings (no escaping), a real bytes type,
; big-endian fixed-width scalars, and minimal integer encodings.
;
;   (import "coil.serde"         :use *)
;   (import "coil.serde.msgpack" :use *)
;   (to-msgpack x w)    (to-msgpack-bytes a x)    (from-msgpack [T] a src)
;
; Mapping: struct -> map of field-name keys; variant -> fixmap1 {tag: payload
; map} (unit variant -> bare tag string); seq -> array; Option None -> nil.
; Integers use the smallest encoding; decode range-checks (a u64 with the high
; bit set does not silently become a negative i64). Decoded strings/bytes are
; zero-copy views of `src` — keep the input alive with the decoded value.
(module coil.serde.msgpack)
(import "coil.primitive" :as primitive)
(import "coil.alloc" :as alloc)
(import "coil.alloc" :use *)
(import "coil.slice" :use *)
(import "coil.str" :use *)
(import "coil.mem" :use *)
(import "coil.arraylist" :use *)
(import "coil.io" :use *)
(import "coil.serde" :use *)
(import "coil.control" :use *)
(import "coil.result" :use *)
(import "coil.try" :use *)

; ============================ serializer ====================================
(defstruct MpSer [(w (ptr Writer))])

(defn mp-io [(r (Result i64 IoError))] (-> (Result i64 SerError))
  (match r
    (Err [_] (Err (ser-err SER-E-IO)))
    (Ok [n] (Ok n))))

(defn mp-b [(p (ptr MpSer)) (b i64)] (-> (Result i64 SerError))
  (mp-io (write-byte (load (field p w)) (primitive/cast u8 b))))

(defn mp-be [(p (ptr MpSer)) (v i64) (nbytes i64)] (-> (Result i64 SerError))
  (try (do
         (let [(mut i) (- nbytes 1)]
           (while (>= (load i) (cast i64 0))
             (try! (mp-b p (primitive/iand (primitive/ishr v (* (load i) 8)) 255)))
             (store! i (- (load i) 1))))
         (Ok 0))))

;;; header for the str/bin/array/map families: fix tag when it fits, else 8/16/32
(defn mp-strhdr [(p (ptr MpSer)) (n i64)] (-> (Result i64 SerError))
  (cond (< n (cast i64 32)) (mp-b p (+ 160 n))  ; fixstr
        (< n (cast i64 256)) (try (do (try! (mp-b p 217)) (mp-be p n 1)))  ; str8
        (< n (cast i64 65536)) (try (do (try! (mp-b p 218)) (mp-be p n 2)))  ; str16
        :else (try (do (try! (mp-b p 219)) (mp-be p n 4)))))  ; str32

(defn mp-binhdr [(p (ptr MpSer)) (n i64)] (-> (Result i64 SerError))
  (cond (< n (cast i64 256)) (try (do (try! (mp-b p 196)) (mp-be p n 1)))  ; bin8
        (< n (cast i64 65536)) (try (do (try! (mp-b p 197)) (mp-be p n 2)))  ; bin16
        :else (try (do (try! (mp-b p 198)) (mp-be p n 4)))))  ; bin32

(defn mp-arrhdr [(p (ptr MpSer)) (n i64)] (-> (Result i64 SerError))
  (cond (< n (cast i64 16)) (mp-b p (+ 144 n))  ; fixarray
        (< n (cast i64 65536)) (try (do (try! (mp-b p 220)) (mp-be p n 2)))  ; array16
        :else (try (do (try! (mp-b p 221)) (mp-be p n 4)))))  ; array32

(defn mp-maphdr [(p (ptr MpSer)) (n i64)] (-> (Result i64 SerError))
  (cond (< n (cast i64 16)) (mp-b p (+ 128 n))  ; fixmap
        (< n (cast i64 65536)) (try (do (try! (mp-b p 222)) (mp-be p n 2)))  ; map16
        :else (try (do (try! (mp-b p 223)) (mp-be p n 4)))))  ; map32

(defn mp-raw [(p (ptr MpSer)) (s (slice u8))] (-> (Result i64 SerError))
  (mp-io (print-str (load (field p w)) s)))

(defn mp-wstr [(p (ptr MpSer)) (s (slice u8))] (-> (Result i64 SerError))
  (try (do
         (try! (mp-strhdr p (slice-len s)))
         (mp-raw p s))))

(defn mp-wi64 [(p (ptr MpSer)) (v i64)] (-> (Result i64 SerError))
  (if (>= v (cast i64 0))
      (cond (< v (cast i64 128)) (mp-b p v)  ; pos fixint
            (< v (cast i64 256)) (try (do (try! (mp-b p 204)) (mp-be p v 1)))  ; uint8
            (< v (cast i64 65536)) (try (do (try! (mp-b p 205)) (mp-be p v 2)))  ; uint16
            (< v (cast i64 4294967296)) (try (do (try! (mp-b p 206)) (mp-be p v 4)))  ; uint32
            :else (try (do (try! (mp-b p 211)) (mp-be p v 8))))  ; int64
      (cond (>= v (cast i64 -32)) (mp-b p (+ v 256))  ; neg fixint
            (>= v (cast i64 -128)) (try (do (try! (mp-b p 208)) (mp-be p v 1)))  ; int8
            (>= v (cast i64 -32768)) (try (do (try! (mp-b p 209)) (mp-be p v 2)))  ; int16
            (>= v (cast i64 -2147483648)) (try (do (try! (mp-b p 210)) (mp-be p v 4)))  ; int32
            :else (try (do (try! (mp-b p 211)) (mp-be p v 8))))))  ; int64

(defn mp-wu64 [(p (ptr MpSer)) (v i64)] (-> (Result i64 SerError))
  (let [uv (primitive/cast u64 v)]
    (cond (< uv (primitive/cast u64 128)) (mp-b p v)
          (< uv (primitive/cast u64 256)) (try (do (try! (mp-b p 204)) (mp-be p v 1)))
          (< uv (primitive/cast u64 65536)) (try (do (try! (mp-b p 205)) (mp-be p v 2)))
          (< uv (primitive/cast u64 4294967296)) (try (do (try! (mp-b p 206)) (mp-be p v 4)))
          :else (try (do (try! (mp-b p 207)) (mp-be p v 8))))))  ; uint64

; f64-bits comes from coil.mem (this module used to carry its own `mp-f64-bits`).
(impl Serializer MpSer
  (ser-null [(s (ptr MpSer))] (-> (Result i64 SerError)) (mp-b s 192))  ; nil
  (ser-bool [(s (ptr MpSer)) (v bool)]
            (-> (Result i64 SerError))
            (mp-b s (if v 195 194)))  ; true/false
  (ser-i64 [(s (ptr MpSer)) (v i64)] (-> (Result i64 SerError)) (mp-wi64 s v))
  (ser-u64 [(s (ptr MpSer)) (v i64)] (-> (Result i64 SerError)) (mp-wu64 s v))
  (ser-f64 [(s (ptr MpSer)) (v f64)]
           (-> (Result i64 SerError))
           (try (do
                  (try! (mp-b s 203))  ; float64
                  (mp-be s (f64-bits v) 8))))
  (ser-str [(s (ptr MpSer)) (v (slice u8))] (-> (Result i64 SerError)) (mp-wstr s v))
  (ser-bytes [(s (ptr MpSer)) (v (slice u8))]
             (-> (Result i64 SerError))
             (try (do
                    (try! (mp-binhdr s (slice-len v)))
                    (mp-raw s v))))
  (seq-begin [(s (ptr MpSer)) (len i64)] (-> (Result i64 SerError)) (mp-arrhdr s len))
  (seq-elem [(s (ptr MpSer))] (-> (Result i64 SerError)) (Ok 0))
  (seq-end [(s (ptr MpSer))] (-> (Result i64 SerError)) (Ok 0))
  (map-begin [(s (ptr MpSer)) (len i64)] (-> (Result i64 SerError)) (mp-maphdr s len))
  (map-key [(s (ptr MpSer)) (k (slice u8))] (-> (Result i64 SerError)) (mp-wstr s k))
  (map-end [(s (ptr MpSer))] (-> (Result i64 SerError)) (Ok 0))
  (struct-begin [(s (ptr MpSer)) (name (slice u8)) (nfields i64)]
                (-> (Result i64 SerError))
                (mp-maphdr s nfields))
  (field-key [(s (ptr MpSer)) (name (slice u8))] (-> (Result i64 SerError)) (mp-wstr s name))
  (struct-end [(s (ptr MpSer))] (-> (Result i64 SerError)) (Ok 0))
  (variant-unit [(s (ptr MpSer)) (sum (slice u8)) (tag (slice u8))]
                (-> (Result i64 SerError))
                (mp-wstr s tag))
  (variant-begin [(s (ptr MpSer)) (sum (slice u8)) (tag (slice u8)) (nfields i64)]
                 (-> (Result i64 SerError))
                 (try (do
                        (try! (mp-maphdr s 1))  ; {tag: payload}
                        (try! (mp-wstr s tag))
                        (mp-maphdr s nfields))))  ; the payload map
  (variant-end [(s (ptr MpSer))] (-> (Result i64 SerError)) (Ok 0)))

; ============================ deserializer ==================================
(defstruct MpDe
  [(src (slice u8)) (pos i64) (alc (dyn Allocator)) (stk (array i64 64)) (sp i64)])

(defn md-need [(p (ptr MpDe)) (k i64)] (-> (Result i64 DeError))
  (if (> (+ (load (field p pos)) k) (slice-len (load (field p src))))
      (Err (de-err DE-E-PARSE (load (field p pos)) "truncated msgpack"))
      (Ok 0)))

(defn md-peek [(p (ptr MpDe))] (-> i64)
  (primitive/cast i64 (slice-get (load (field p src)) (load (field p pos)))))

(defn md-take [(p (ptr MpDe))] (-> i64)
  (let [b (md-peek p)]
    (store! (field p pos) (+ (load (field p pos)) 1))
    b))

;;; big-endian unsigned read of n bytes
(defn md-be [(p (ptr MpDe)) (n i64)] (-> (Result i64 DeError))
  (try (do
         (try! (md-need p n))
         (let [(mut v) 0]
           (for [i 0 n]
             (store! v (primitive/ior (primitive/ishl (load v) 8) (md-take p))))
           (Ok (load v))))))

;;; sign-extend the low n bytes of v
(defn md-sext [(v i64) (nbytes i64)] (-> i64)
  (let [shift (* (- 8 nbytes) 8)]
    (primitive/ishr (primitive/ishl v shift) shift)))

;;; the length carried by a str-family tag, or -1 if `tag` is not a string
(defn md-strlen [(p (ptr MpDe)) (tag i64)] (-> (Result i64 DeError))
  (cond (and (>= tag (cast i64 160)) (<= tag (cast i64 191))) (Ok (- tag 160))
        (= tag (cast i64 217)) (md-be p 1)
        (= tag (cast i64 218)) (md-be p 2)
        (= tag (cast i64 219)) (md-be p 4)
        :else (Ok -1)))

;;; skip one complete value starting at `pos`; returns the position after it
(defn md-skip-at [(p (ptr MpDe)) (pos i64)] (-> (Result i64 DeError))
  (try (do
         (store! (field p pos) pos)
         (try! (md-need p 1))
         (let [tag (md-take p)]
           (cond (< tag (cast i64 128)) (Ok (load (field p pos)))  ; pos fixint
                 (>= tag (cast i64 224)) (Ok (load (field p pos)))  ; neg fixint
                 (and (>= tag (cast i64 128)) (<= tag (cast i64 143)))  ; fixmap
                   (let [n (- tag 128)
                         (mut at) (load (field p pos))]
                     (for [i 0 (* n 2)]
                       (store! at (try! (md-skip-at p (load at)))))
                     (Ok (load at)))
                 (and (>= tag (cast i64 144)) (<= tag (cast i64 159)))  ; fixarray
                   (let [n (- tag 144)
                         (mut at) (load (field p pos))]
                     (for [i 0 n]
                       (store! at (try! (md-skip-at p (load at)))))
                     (Ok (load at)))
                 (and (>= tag (cast i64 160)) (<= tag (cast i64 191)))  ; fixstr
                   (let [n (- tag 160)]
                     (try! (md-need p n))
                     (Ok (+ (load (field p pos)) n)))
                 (= tag (cast i64 192)) (Ok (load (field p pos)))  ; nil
                 (or (= tag (cast i64 194)) (= tag (cast i64 195))) (Ok (load (field p pos)))  ; bool
                 (= tag (cast i64 204)) (do (try! (md-need p 1)) (Ok (+ (load (field p pos)) 1)))
                 (= tag (cast i64 205)) (do (try! (md-need p 2)) (Ok (+ (load (field p pos)) 2)))
                 (= tag (cast i64 206)) (do (try! (md-need p 4)) (Ok (+ (load (field p pos)) 4)))
                 (= tag (cast i64 207)) (do (try! (md-need p 8)) (Ok (+ (load (field p pos)) 8)))
                 (= tag (cast i64 208)) (do (try! (md-need p 1)) (Ok (+ (load (field p pos)) 1)))
                 (= tag (cast i64 209)) (do (try! (md-need p 2)) (Ok (+ (load (field p pos)) 2)))
                 (= tag (cast i64 210)) (do (try! (md-need p 4)) (Ok (+ (load (field p pos)) 4)))
                 (= tag (cast i64 211)) (do (try! (md-need p 8)) (Ok (+ (load (field p pos)) 8)))
                 (= tag (cast i64 203)) (do (try! (md-need p 8)) (Ok (+ (load (field p pos)) 8)))  ; f64
                 (= tag (cast i64 202)) (do (try! (md-need p 4)) (Ok (+ (load (field p pos)) 4)))  ; f32
                 (or (= tag (cast i64 217)) (= tag (cast i64 196)))  ; str8/bin8
                   (let [n (try! (md-be p 1))]
                     (try! (md-need p n))
                     (Ok (+ (load (field p pos)) n)))
                 (or (= tag (cast i64 218)) (= tag (cast i64 197)))  ; str16/bin16
                   (let [n (try! (md-be p 2))]
                     (try! (md-need p n))
                     (Ok (+ (load (field p pos)) n)))
                 (or (= tag (cast i64 219)) (= tag (cast i64 198)))  ; str32/bin32
                   (let [n (try! (md-be p 4))]
                     (try! (md-need p n))
                     (Ok (+ (load (field p pos)) n)))
                 (= tag (cast i64 220))  ; array16
                   (let [n (try! (md-be p 2))
                         (mut at) (load (field p pos))]
                     (for [i 0 n]
                       (store! at (try! (md-skip-at p (load at)))))
                     (Ok (load at)))
                 (= tag (cast i64 221))  ; array32
                   (let [n (try! (md-be p 4))
                         (mut at) (load (field p pos))]
                     (for [i 0 n]
                       (store! at (try! (md-skip-at p (load at)))))
                     (Ok (load at)))
                 (= tag (cast i64 222))  ; map16
                   (let [n (try! (md-be p 2))
                         (mut at) (load (field p pos))]
                     (for [i 0 (* n 2)]
                       (store! at (try! (md-skip-at p (load at)))))
                     (Ok (load at)))
                 (= tag (cast i64 223))  ; map32
                   (let [n (try! (md-be p 4))
                         (mut at) (load (field p pos))]
                     (for [i 0 (* n 2)]
                       (store! at (try! (md-skip-at p (load at)))))
                     (Ok (load at)))
                 :else (Err (de-err DE-E-PARSE (- (load (field p pos)) 1) "unsupported msgpack tag")))))))

(defn md-push! [(p (ptr MpDe)) (v i64)] (-> (Result i64 DeError))
  (if (>= (load (field p sp)) (cast i64 64))
      (Err (de-err DE-E-DEPTH (load (field p pos)) "nesting too deep"))
      (do
        (store! (primitive/index (field p stk) (load (field p sp))) v)
        (store! (field p sp) (+ (load (field p sp)) 1))
        (Ok 0))))

(defn md-pop! [(p (ptr MpDe))] (-> i64)
  (store! (field p sp) (- (load (field p sp)) 1))
  (load (primitive/index (field p stk) (load (field p sp)))))

(defn md-top [(p (ptr MpDe))] (-> i64)
  (load (primitive/index (field p stk) (- (load (field p sp)) 1))))

;;; read any integer family into i64; `unsigned?` selects the u64 range rules
(defn md-int [(p (ptr MpDe)) (unsigned? bool)] (-> (Result i64 DeError))
  (try (let [off (load (field p pos))]
         (try! (md-need p 1))
         (let [tag (md-take p)
               v
                 (cond (< tag (cast i64 128)) (Ok [i64 DeError] tag)  ; pos fixint
                       (>= tag (cast i64 224)) (Ok [i64 DeError] (- tag 256))  ; neg fixint
                       (= tag (cast i64 204)) (md-be p 1)  ; uint8
                       (= tag (cast i64 205)) (md-be p 2)
                       (= tag (cast i64 206)) (md-be p 4)
                       (= tag (cast i64 207)) (md-be p 8)  ; uint64 (raw bits)
                       (= tag (cast i64 208))
                         (match (md-be p 1) (Err [e] (Err [i64 DeError] e)) (Ok [x] (Ok [i64 DeError] (md-sext x 1))))
                       (= tag (cast i64 209))
                         (match (md-be p 2) (Err [e] (Err [i64 DeError] e)) (Ok [x] (Ok [i64 DeError] (md-sext x 2))))
                       (= tag (cast i64 210))
                         (match (md-be p 4) (Err [e] (Err [i64 DeError] e)) (Ok [x] (Ok [i64 DeError] (md-sext x 4))))
                       (= tag (cast i64 211)) (md-be p 8)
                       :else (Err [i64 DeError] (de-err DE-E-EXPECTED-INT off "expected an integer")))
               x (try! v)]
           (if unsigned?
               (if (and (!= (md-tag-u64? tag) true) (< x (cast i64 0)))
                   (Err (de-err DE-E-INT-RANGE off "negative number for unsigned field"))
                   (Ok x))
               (if (and (= tag (cast i64 207)) (< x (cast i64 0)))  ; uint64 above i64 MAX
                   (Err (de-err DE-E-INT-RANGE off "integer overflows i64"))
                   (Ok x)))))))

(defn md-tag-u64? [(tag i64)] (-> bool)
  (= tag (cast i64 207)))

(impl Deserializer MpDe
  (de-kind [(d (ptr MpDe))]
           (-> i64)
           (if (>= (load (field d pos)) (slice-len (load (field d src))))
               SD-K-OTHER
               (let [tag (md-peek d)]
                 (cond (< tag (cast i64 128)) SD-K-INT  ; pos fixint
                       (>= tag (cast i64 224)) SD-K-INT  ; neg fixint
                       (and (>= tag (cast i64 128)) (<= tag (cast i64 143))) SD-K-MAP  ; fixmap
                       (and (>= tag (cast i64 144)) (<= tag (cast i64 159))) SD-K-SEQ  ; fixarray
                       (and (>= tag (cast i64 160)) (<= tag (cast i64 191))) SD-K-STR  ; fixstr
                       (= tag (cast i64 192)) SD-K-NULL
                       (or (= tag (cast i64 194)) (= tag (cast i64 195))) SD-K-BOOL
                       (or (= tag (cast i64 202)) (= tag (cast i64 203))) SD-K-FLOAT
                       (and (>= tag (cast i64 204)) (<= tag (cast i64 211))) SD-K-INT
                       (and (>= tag (cast i64 196)) (<= tag (cast i64 198))) SD-K-BYTES
                       (and (>= tag (cast i64 217)) (<= tag (cast i64 219))) SD-K-STR
                       (or (= tag (cast i64 220)) (= tag (cast i64 221))) SD-K-SEQ
                       (or (= tag (cast i64 222)) (= tag (cast i64 223))) SD-K-MAP
                       :else SD-K-OTHER))))
  (de-null? [(d (ptr MpDe))]
            (-> bool)
            (if (>= (load (field d pos)) (slice-len (load (field d src))))
                false
                (if (= (md-peek d) (cast i64 192))
                    (do (md-take d) true)
                    false)))
  (de-bool [(d (ptr MpDe))]
           (-> (Result bool DeError))
           (try (do
                  (try! (md-need d 1))
                  (let [tag (md-take d)]
                    (cond (= tag (cast i64 195)) (Ok true)
                          (= tag (cast i64 194)) (Ok false)
                          :else (Err (de-err DE-E-EXPECTED-BOOL (- (load (field d pos)) 1) "expected a boolean")))))))
  (de-i64 [(d (ptr MpDe))] (-> (Result i64 DeError)) (md-int d false))
  (de-u64 [(d (ptr MpDe))] (-> (Result i64 DeError)) (md-int d true))
  (de-f64 [(d (ptr MpDe))]
          (-> (Result f64 DeError))
          (try (do
                 (try! (md-need d 1))
                 (let [off (load (field d pos))
                       tag (md-take d)]
                   (if (= tag (cast i64 203))
                       (let [bits (try! (md-be d 8))
                             slot (primitive/alloc-stack i64)]
                         (store! slot bits)
                         (Ok (load (primitive/cast (ptr f64) slot))))
                       (Err (de-err DE-E-EXPECTED-FLOAT off "expected a float64")))))))
  (de-str [(d (ptr MpDe))]
          (-> (Result (slice u8) DeError))
          (try (do
                 (try! (md-need d 1))
                 (let [off (load (field d pos))
                       tag (md-take d)
                       n (try! (md-strlen d tag))]
                   (if (< n (cast i64 0))
                       (Err (de-err DE-E-EXPECTED-STR off "expected a string"))
                       (do
                         (try! (md-need d n))
                         (let [s (subslice (load (field d src)) (load (field d pos)) (+ (load (field d pos)) n))]
                           (store! (field d pos) (+ (load (field d pos)) n))
                           (Ok s))))))))
  (de-bytes [(d (ptr MpDe))]
            (-> (Result (slice u8) DeError))
            (try (do
                   (try! (md-need d 1))
                   (let [off (load (field d pos))
                         tag (md-take d)
                         n
                           (cond (= tag (cast i64 196)) (try! (md-be d 1))
                                 (= tag (cast i64 197)) (try! (md-be d 2))
                                 (= tag (cast i64 198)) (try! (md-be d 4))
                                 :else (return-from :try (Err (de-err DE-E-EXPECTED-STR off "expected bytes"))))]
                     (try! (md-need d n))
                     (let [s (subslice (load (field d src)) (load (field d pos)) (+ (load (field d pos)) n))]
                       (store! (field d pos) (+ (load (field d pos)) n))
                       (Ok s))))))
  (de-seq-begin [(d (ptr MpDe))]
                (-> (Result i64 DeError))
                (try (do
                       (try! (md-need d 1))
                       (let [off (load (field d pos))
                             tag (md-take d)]
                         (cond (and (>= tag (cast i64 144)) (<= tag (cast i64 159))) (Ok (- tag 144))
                               (= tag (cast i64 220)) (md-be d 2)
                               (= tag (cast i64 221)) (md-be d 4)
                               :else (Err (de-err DE-E-EXPECTED-SEQ off "expected an array")))))))
  (de-seq-end [(d (ptr MpDe))] (-> (Result i64 DeError)) (Ok 0))
  (de-map-begin [(d (ptr MpDe))]
                (-> (Result i64 DeError))
                (try (let [off (load (field d pos))
                           n (try! (md-maphdr d))]
                       (try! (md-push! d off))
                       (Ok n))))
  (de-map-key [(d (ptr MpDe)) (n i64)]
              (-> (Result (slice u8) DeError))
              (try (do
                     (try! (md-seek-pair d (md-top d) n))
                     (de-str d))))
  (de-map-value [(d (ptr MpDe)) (n i64)]
                (-> (Result i64 DeError))
                (try (do
                       (try! (md-seek-pair d (md-top d) n))
                       (let [after-key (try! (md-skip-at d (load (field d pos))))]
                         (store! (field d pos) after-key)
                         (Ok 0)))))
  (de-map-end [(d (ptr MpDe))]
              (-> (Result i64 DeError))
              (try (let [start (md-pop! d)
                         end (try! (md-skip-at d start))]
                     (store! (field d pos) end)
                     (Ok 0))))
  (de-struct-begin [(d (ptr MpDe)) (name (slice u8))]
                   (-> (Result i64 DeError))
                   (try (let [off (load (field d pos))
                              n (try! (md-maphdr d))]
                          (try! (md-push! d off))
                          (store! (field d pos) off)
                          (Ok n))))
  (de-field [(d (ptr MpDe)) (name (slice u8))]
            (-> (Result bool DeError))
            (try (let [start (md-top d)]
                   (store! (field d pos) start)
                   (let [n (try! (md-maphdr d))
                         (mut found) false]
                     (let [(mut i) 0]
                       (while (and (< (load i) n) (not (load found)))
                         (let [k (try! (de-str d))]
                           (if (str-eq k name)
                               (store! found true)
                               (let [after (try! (md-skip-at d (load (field d pos))))]
                                 (store! (field d pos) after)
                                 (store! i (+ (load i) 1))
                                 0)))))
                     (Ok (load found))))))
  (de-struct-end [(d (ptr MpDe))]
                 (-> (Result i64 DeError))
                 (try (let [start (md-pop! d)
                            end (try! (md-skip-at d start))]
                        (store! (field d pos) end)
                        (Ok 0))))
  (de-variant [(d (ptr MpDe))]
              (-> (Result (slice u8) DeError))
              (try (do
                     (try! (md-need d 1))
                     (let [off (load (field d pos))
                           tag (md-peek d)
                           sn (do (md-take d) (try! (md-strlen d tag)))]
                       (if (>= sn (cast i64 0))
                           ; a bare string: unit variant
                           (do
                             (try! (md-need d sn))
                             (let [s (subslice (load (field d src)) (load (field d pos)) (+ (load (field d pos)) sn))]
                               (store! (field d pos) (+ (load (field d pos)) sn))
                               (try! (md-push! d -1))
                               (Ok s)))
                           ; {tag: payload}
                           (do
                             (store! (field d pos) off)
                             (let [n (try! (md-maphdr d))]
                               (if (!= n (cast i64 1))
                                   (Err (de-err DE-E-EXPECTED-VARIANT off "expected exactly one variant tag"))
                                   (let [tagstr (try! (de-str d))]
                                     (try! (md-push! d off))
                                     (Ok tagstr))))))))))
  (de-variant-end [(d (ptr MpDe))]
                  (-> (Result i64 DeError))
                  (try (let [v (md-pop! d)]
                         (when (>= v (cast i64 0))
                           (let [end (try! (md-skip-at d v))]
                             (store! (field d pos) end)
                             0))
                         (Ok 0))))
  (de-alloc [(d (ptr MpDe))]
            (-> (dyn Allocator))
            (load (field d alc))))

;;; read a map header at the cursor (any width), or error
(defn md-maphdr [(p (ptr MpDe))] (-> (Result i64 DeError))
  (try (do
         (try! (md-need p 1))
         (let [off (load (field p pos))
               tag (md-take p)]
           (cond (and (>= tag (cast i64 128)) (<= tag (cast i64 143))) (Ok (- tag 128))
                 (= tag (cast i64 222)) (md-be p 2)
                 (= tag (cast i64 223)) (md-be p 4)
                 :else (Err (de-err DE-E-EXPECTED-MAP off "expected a map")))))))

;;; position the cursor at the KEY of pair `n` of the map starting at `start`
(defn md-seek-pair [(p (ptr MpDe)) (start i64) (n i64)] (-> (Result i64 DeError))
  (try (do
         (store! (field p pos) start)
         (try! (md-maphdr p))
         (let [(mut at) (load (field p pos))]
           (for [i 0 (* n 2)]
             (store! at (try! (md-skip-at p (load at)))))
           (store! (field p pos) (load at))
           (Ok 0)))))

; ============================ conveniences ==================================
;;; Serialize `x` as MessagePack to any Writer.
(defn to-msgpack [(T Serialize)] [(x T) (w (ptr Writer))] (-> (Result i64 SerError))
  (let [ms (primitive/alloc-stack MpSer)]
    (store! (field ms w) w)
    (ser x (primitive/make-dyn Serializer ms))))

;;; Serialize `x` to a byte slice allocated from `a`.
(defn to-msgpack-bytes [(T Serialize)] [(a (dyn Allocator)) (x T)] (-> (Result (slice u8) SerError))
  (let [g (primitive/alloc-stack GrowBuf)
        w (primitive/alloc-stack Writer)
        ms (primitive/alloc-stack MpSer)]
    (grow-writer w g a)
    (store! (field ms w) w)
    (match (ser x (primitive/make-dyn Serializer ms))
      (Err [e] (Err e))
      (Ok [_] (Ok (grow-str g))))))

;;; Decode one complete MessagePack value into a T.
(defn from-msgpack [(T Deserialize)] [(a (dyn Allocator)) (src (slice u8))] (-> (Result T DeError))
  (let [dd (primitive/alloc-stack MpDe)
        slot (primitive/alloc-stack T)]
    (store! dd (primitive/zeroed MpDe))
    (store! (field dd src) src)
    (store! (field dd pos) 0)
    (store! (field dd alc) a)
    (match (de slot (primitive/make-dyn Deserializer dd))
      (Err [e] (Err e))
      (Ok [_] (Ok (load slot))))))
