(module coil.async-runtime)
(import "coil.primitive" :as primitive)
(import "coil.alloc" :as alloc)

; Single-threaded hosted runtime for explicit tasks. It parks on kqueue (macOS) or epoll
; (Linux), using monotonic deadlines. The platform ABI stays in this module; applications
; work only with Runtime, Context, Parker, and Task.
(import "coil.async" :use *)
(import "coil.time" :as time :use *)
(import "coil.os" :as os)
(os/requires-os)  ; it calls the operating system
(import "coil.io" :as io)
(import "coil.fmt" :use [fmt Display display-fmt Formatter])
(import "coil.layout" :as layout)

(defsum RuntimeError
  (Backend [(errno i64)])
  (Busy [(registrations i64)]))

(derive Eq RuntimeError)

(defsum TimerError
  (InvalidDuration)
  (Clock [(error TimeError)]))

(derive Eq TimerError)

(defsum FdInterest
  (Readable)
  (Writable))

(defsum FdWaitError
  (InvalidFd)
  (Register [(errno i64)])
  (Event [(errno i64)]))

(derive Eq FdWaitError)
;; coil.async is admitted by the hermetic profile, which has no coil.io or coil.fmt,
;; so its error displays here, beside the runtime that parks tasks.
;;; `{}` is a message for a person; an errno reads as the operating system describes it.
(impl Display TaskError
  (display-fmt [(e TaskError) (f (ptr Formatter))] (-> i64)
    (let [w (writer f)]
      (match e
        (AlreadyCompleted [] (io/print-str w "task already completed"))
        (Closed [] (io/print-str w "task closed"))
        (ParkFailed [code] (do (io/print-str w "parking the task failed: ") (io/write-os-error w code)))))
    0))

;;; `{}` is a message for a person; an errno reads as the operating system describes it.
(impl Display RuntimeError
  (display-fmt [(e RuntimeError) (f (ptr Formatter))] (-> i64)
    (let [w (writer f)]
      (match e
        (Backend [code] (do (io/print-str w "the event backend failed: ") (io/write-os-error w code)))
        (Busy [registrations] (fmt w "the runtime still has {} registrations" registrations))))
    0))

;;; `{}` is a message for a person.
(impl Display TimerError
  (display-fmt [(e TimerError) (f (ptr Formatter))] (-> i64)
    (let [w (writer f)]
      (match e
        (InvalidDuration [] (io/print-str w "invalid duration"))
        (Clock [error] (fmt w "reading the clock failed: {}" error))))
    0))

;;; `{}` is a message for a person; an errno reads as the operating system describes it.
(impl Display FdWaitError
  (display-fmt [(e FdWaitError) (f (ptr Formatter))] (-> i64)
    (let [w (writer f)]
      (match e
        (InvalidFd [] (io/print-str w "invalid file descriptor"))
        (Register [code] (do (io/print-str w "registering the descriptor failed: ") (io/write-os-error w code)))
        (Event [code] (do (io/print-str w "waiting for the descriptor failed: ") (io/write-os-error w code)))))
    0))

(defstruct Runtime
  [(backend-fd i32)
   (next-deadline-ms i64)
   (deadline-armed bool)
   (registrations i64)
   (closed bool)])

(defstruct TimerState
  [(runtime (ptr Runtime))
   (deadline-ms i64)])

;;; Caller-owned state used as the stable kernel event token. It may not move or be freed
;;; between fd-wait-init and task-close.
(defstruct FdWaitState
  [(runtime (ptr Runtime))
   (fd i32)
   (interest FdInterest)
   (kernel-registered bool)
   (armed bool)
   (ready bool)
   (event-error i64)])

; Packed platform event helpers. Keeping byte offsets here prevents libc layout details
; from leaking into the public API.
(defstruct EpollEventLayout :layout (layout/Packed) [(events u32) (data u64)])

(defn epoll-event-fill [(event (ptr i8)) (events i64) (token (ptr i8))] (-> i64)
  (let [layout (primitive/cast (ptr EpollEventLayout) event)]
    (store! (field layout events) (primitive/cast u32 events))
    (store! (field layout data) (primitive/cast u64 token))
    0))

(defn epoll-event-flags [(event (ptr i8))] (-> i64)
  (primitive/cast i64
                  (load (field (primitive/cast (ptr EpollEventLayout) event)
                               events))))

(defn epoll-event-token [(event (ptr i8))] (-> (ptr i8))
  (primitive/cast (ptr i8)
                  (load (field (primitive/cast (ptr EpollEventLayout) event)
                               data))))

(defn kevent-fill [(event (ptr i8))
                   (fd i32)
                   (filter i64)
                   (flags i64)
                   (token (ptr i8))] (-> i64)
  (do
    (store! (primitive/cast (ptr u64) event) (primitive/cast u64 fd))
    (store! (primitive/cast (ptr i16) (primitive/index event 8))
            (primitive/cast i16 filter))
    (store! (primitive/cast (ptr u16) (primitive/index event 10))
            (primitive/cast u16 flags))
    (store! (primitive/cast (ptr u32) (primitive/index event 12)) 0)
    (store! (primitive/cast (ptr i64) (primitive/index event 16)) 0)
    (store! (primitive/cast (ptr (ptr i8)) (primitive/index event 24)) token)
    0))

(defn kevent-flags [(event (ptr i8))] (-> i64)
  (primitive/cast i64
                  (load (primitive/cast (ptr u16) (primitive/index event 10)))))

(defn kevent-data [(event (ptr i8))] (-> i64)
  (load (primitive/cast (ptr i64) (primitive/index event 16))))

(defn kevent-token [(event (ptr i8))] (-> (ptr i8))
  (load (primitive/cast (ptr (ptr i8)) (primitive/index event 24))))

(defn event-ready [(token (ptr i8)) (kernel-retained bool) (error i64)] (-> i64)
  (let [state (primitive/cast (ptr FdWaitState) token)
        runtime (load (field state runtime))]
    (if (load (field state armed))
        (do
          (store! (field runtime registrations)
                  (- (load (field runtime registrations)) 1))
          (store! (field state armed) false))
        0)
    (store! (field state kernel-registered) kernel-retained)
    (store! (field state event-error) error)
    (store! (field state ready) true)
    0))

;;; hygiene: selected backend declarations intentionally enter this module namespace.
(defn explicit-public-name [(name Code)] (-> Code)
  (primitive/syntax->datum name))

(defn gen-runtime-platform [] (-> Code)
  (let [darwin-form `(do
         (extern ~(explicit-public-name `kqueue) :cc c [] (-> i32))
         (extern ~(explicit-public-name `kevent)
                 :cc
                 c
                 [i32 (ptr i8) i32 (ptr i8) i32 (ptr i8)]
                 (-> i32))
         (defn ~(explicit-public-name `backend-open) [] (-> i32)
           (kqueue))
         (defn ~(explicit-public-name `backend-register) [(runtime-fd i32)
                                                          (target-fd i32)
                                                          (interest i64)
                                                          (token (ptr i8))
                                                          (known bool)] (-> i64)
           (let [event (primitive/alloc-stack (array u8 32))]
             (coil.async-runtime.kevent-fill (primitive/cast (ptr i8) event)
                                             target-fd
                                             (if (= interest 0) -1 -2)
                                             17
                                             token)
             (let [rc
                     (kevent runtime-fd
                             (primitive/cast (ptr i8) event)
                             1
                             (primitive/cast (ptr i8) 0)
                             0
                             (primitive/cast (ptr i8) 0))]
               (if (< (primitive/cast i64 rc) 0) (os/errno) 0))))
         (defn ~(explicit-public-name `backend-unregister) [(runtime-fd i32)
                                                            (target-fd i32)
                                                            (interest i64)] (-> i64)
           (let [event (primitive/alloc-stack (array u8 32))]
             (coil.async-runtime.kevent-fill (primitive/cast (ptr i8) event)
                                             target-fd
                                             (if (= interest 0) -1 -2)
                                             2
                                             (primitive/cast (ptr i8) 0))
             (let [rc
                     (kevent runtime-fd
                             (primitive/cast (ptr i8) event)
                             1
                             (primitive/cast (ptr i8) 0)
                             0
                             (primitive/cast (ptr i8) 0))]
               (if (< (primitive/cast i64 rc) 0) (os/errno) 0))))
         (defn ~(explicit-public-name `backend-park) [(fd i32)
                                                      (timeout-ms i32)] (-> i64)
           (let [timeout (primitive/alloc-stack (array i64 2))
                 event (primitive/alloc-stack (array u8 32))]
             (store! (primitive/index timeout 0)
                     (/ (primitive/cast i64 timeout-ms) 1000))
             (store! (primitive/index timeout 1)
                     (* (% (primitive/cast i64 timeout-ms) 1000) 1000000))
             (let [timeout-ptr
                     (if (< (primitive/cast i64 timeout-ms) 0)
                         (primitive/cast (ptr i8) 0)
                         (primitive/cast (ptr i8) timeout))
                   rc
                     (kevent fd
                             (primitive/cast (ptr i8) 0)
                             0
                             (primitive/cast (ptr i8) event)
                             1
                             timeout-ptr)]
               (if (< (primitive/cast i64 rc) 0)
                   (let [errno (os/errno)] (if (= errno 4) 0 errno))
                   (if (= rc 0)
                       0
                       (let [flags
                               (coil.async-runtime.kevent-flags (primitive/cast (ptr i8)
                                                                                event))
                             error
                               (if (!= (& flags 16384) 0)
                                   (coil.async-runtime.kevent-data (primitive/cast (ptr i8)
                                                                                   event))
                                   0)]
                         (coil.async-runtime.event-ready (coil.async-runtime.kevent-token (primitive/cast (ptr i8)
                                                                                                          event))
                                                         false
                                                         error))))))))]
    (os/os-pick `(do
         (extern ~(explicit-public-name `epoll_create1)
                 :cc
                 c
                 [i32]
                 (-> i32))
         (extern ~(explicit-public-name `epoll_ctl)
                 :cc
                 c
                 [i32 i32 i32 (ptr i8)]
                 (-> i32))
         (extern ~(explicit-public-name `epoll_wait)
                 :cc
                 c
                 [i32 (ptr i8) i32 i32]
                 (-> i32))
         (defn ~(explicit-public-name `backend-open) [] (-> i32)
           (epoll_create1 524288))
         (defn ~(explicit-public-name `backend-register) [(runtime-fd i32)
                                                          (target-fd i32)
                                                          (interest i64)
                                                          (token (ptr i8))
                                                          (known bool)] (-> i64)
           (let [event (primitive/alloc-stack (array u8 16))
                 events (| (if (= interest 0) 1 4) 1073741824)]
             (coil.async-runtime.epoll-event-fill (primitive/cast (ptr i8)
                                                                  event)
                                                  events
                                                  token)
             (let [rc
                     (epoll_ctl runtime-fd
                                (if known 3 1)
                                target-fd
                                (primitive/cast (ptr i8) event))]
               (if (< (primitive/cast i64 rc) 0) (os/errno) 0))))
         (defn ~(explicit-public-name `backend-unregister) [(runtime-fd i32)
                                                            (target-fd i32)
                                                            (interest i64)] (-> i64)
           (let [rc
                   (epoll_ctl runtime-fd
                              2
                              target-fd
                              (primitive/cast (ptr i8) 0))]
             (if (< (primitive/cast i64 rc) 0) (os/errno) 0)))
         (defn ~(explicit-public-name `backend-park) [(fd i32)
                                                      (timeout-ms i32)] (-> i64)
           (let [event (primitive/alloc-stack (array u8 16))
                 rc (epoll_wait fd (primitive/cast (ptr i8) event) 1 timeout-ms)]
             (if (< (primitive/cast i64 rc) 0)
                 (let [errno (os/errno)] (if (= errno 4) 0 errno))
                 (if (= rc 0)
                     0
                     (coil.async-runtime.event-ready (coil.async-runtime.epoll-event-token (primitive/cast (ptr i8)
                                                                                                           event))
                                                     true
                                                     0)))))) darwin-form darwin-form)))

(meta (gen-runtime-platform))

;;; The runtime's operations. `init`, `context` and `parker` fill storage the
;;; caller owns; `park` below is the Parker's callback.
(impl Runtime
  ;;; Initialize caller-owned runtime storage.
  (init [(runtime (ptr Runtime))] (-> (Result (ptr Runtime) RuntimeError))
    (let [fd (backend-open)]
      (if (< (primitive/cast i64 fd) 0)
          (Err (Backend (os/errno)))
          (do
            (store! (field runtime backend-fd) fd)
            (store! (field runtime next-deadline-ms) 0)
            (store! (field runtime deadline-armed) false)
            (store! (field runtime registrations) 0)
            (store! (field runtime closed) false)
            (Ok runtime)))))

  ;;; Close the platform event handle. Idempotent.
  (close [(runtime (ptr Runtime))] (-> (Result i64 RuntimeError))
    (if (load (field runtime closed))
        (Ok 0)
        (let [registrations (load (field runtime registrations))]
          (if (> registrations 0)
              (Err (Busy registrations))
              (let [rc (os/close (load (field runtime backend-fd)))]
                (if (< (primitive/cast i64 rc) 0)
                    (Err (Backend (os/errno)))
                    (do (store! (field runtime closed) true) (Ok 0))))))))

  ;;; Register a deadline for the next park. Multiple tasks may register; the earliest wins.
  (arm-deadline [(runtime (ptr Runtime)) (deadline-ms i64)] (-> i64)
    (if (or (not (load (field runtime deadline-armed)))
            (< deadline-ms (load (field runtime next-deadline-ms))))
        (do
          (store! (field runtime next-deadline-ms) deadline-ms)
          (store! (field runtime deadline-armed) true))
        0))

  ;;; How long the next park may wait for the armed deadline, in milliseconds.
  (timeout [(runtime (ptr Runtime))] (-> (Result i32 TimeError))
    (match (monotonic-now-ms)
      (Err [error] (Err error))
      (Ok [now]
          (let [remaining (- (load (field runtime next-deadline-ms)) now)]
            (if (<= remaining 0)
                (Ok 0)
                ; epoll and kevent take bounded millisecond timeout inputs here.
                (if (> remaining 2147483647)
                    (Ok 2147483647)
                    (Ok (primitive/cast i32 remaining))))))))

  ;;; Fill caller-owned Context and Parker capabilities for this runtime.
  (context [(cx (ptr Context)) (runtime (ptr Runtime))] (-> (ptr Context))
    (do (store! (field cx user) (primitive/cast (ptr i8) runtime)) cx))

  (parker [(parker (ptr Parker)) (runtime (ptr Runtime))] (-> (ptr Parker))
    (do
      (store! (field parker park-fn) (primitive/fnptr-of park))
      (store! (field parker state) (primitive/cast (ptr i8) runtime))
      parker)))

;;; Park the runtime RAW until a registered descriptor is ready or the armed
;;; deadline passes: the Parker that `Runtime::parker` fills calls it.
(defn park [(raw (ptr i8))] (-> i64)
  (let [runtime (primitive/cast (ptr Runtime) raw)]
    (if (load (field runtime closed))
        9
        (if (load (field runtime deadline-armed))
            (match (timeout runtime)
              (Err [error] (code error))
              (Ok [timeout]
                  (do
                    ; Tasks re-arm themselves when next polled. This prevents an expired
                    ; deadline from causing every later park to return immediately.
                    (store! (field runtime deadline-armed) false)
                    (backend-park (load (field runtime backend-fd))
                                  timeout))))
            (if (> (load (field runtime registrations)) 0)
                (backend-park (load (field runtime backend-fd)) -1)
                22)))))

(defn fd-interest-code [(interest FdInterest)] (-> i64)
  (match interest (Readable [] 0) (Writable [] 1)))

(defn fd-wait-poll [(raw (ptr i8)) (cx (ptr Context))] (-> (Poll (Result i64
                                                                         FdWaitError)))
  (let [state (primitive/cast (ptr FdWaitState) raw)]
    (if (load (field state ready))
        (let [error (load (field state event-error))]
          (if (= error 0) (Ready (Ok 0)) (Ready (Err (Event error)))))
        (if (load (field state armed))
            (Pending)
            (let [runtime (load (field state runtime))
                  error
                    (backend-register (load (field runtime backend-fd))
                                      (load (field state fd))
                                      (fd-interest-code (load (field state
                                                                     interest)))
                                      raw
                                      (load (field state
                                                   kernel-registered)))]
              (if (!= error 0)
                  (Ready (Err (Register error)))
                  (do
                    (store! (field state kernel-registered) true)
                    (store! (field state armed) true)
                    (store! (field runtime registrations)
                            (+ (load (field runtime registrations)) 1))
                    (Pending))))))))

(defn fd-wait-close [(raw (ptr i8)) (cancelled bool)] (-> i64)
  (let [state (primitive/cast (ptr FdWaitState) raw)
        runtime (load (field state runtime))
        (mut error) 0]
    (if (load (field state kernel-registered))
        (do
          (store! error
                  (backend-unregister (load (field runtime backend-fd))
                                      (load (field state fd))
                                      (fd-interest-code (load (field state
                                                                     interest)))))
          (store! (field state kernel-registered) false))
        0)
    (if (load (field state armed))
        (do
          (store! (field runtime registrations)
                  (- (load (field runtime registrations)) 1))
          (store! (field state armed) false))
        0)
    (load error)))

;;; Initialize a one-shot readiness task over an existing fd. The descriptor remains owned
;;; by the caller. Closing the task deregisters it but never closes the descriptor.
(defn fd-wait-init [(runtime (ptr Runtime))
                    (task (ptr (Task (Result i64 FdWaitError))))
                    (state (ptr FdWaitState))
                    (fd i32)
                    (interest FdInterest)] (-> (Result (ptr (Task (Result i64
                                                                          FdWaitError)))
                                                       FdWaitError))
  (if (< (primitive/cast i64 fd) 0)
      (Err (InvalidFd))
      (do
        (store! (field state runtime) runtime)
        (store! (field state fd) fd)
        (store! (field state interest) interest)
        (store! (field state kernel-registered) false)
        (store! (field state armed) false)
        (store! (field state ready) false)
        (store! (field state event-error) 0)
        (Ok (task-init task
                       (primitive/cast (ptr i8) state)
                       (primitive/fnptr-of fd-wait-poll)
                       (primitive/fnptr-of fd-wait-close))))))

(defn fd-readable [(runtime (ptr Runtime))
                   (task (ptr (Task (Result i64 FdWaitError))))
                   (state (ptr FdWaitState))
                   (fd i32)] (-> (Result (ptr (Task (Result i64 FdWaitError)))
                                         FdWaitError))
  (fd-wait-init runtime task state fd (Readable)))

(defn fd-writable [(runtime (ptr Runtime))
                   (task (ptr (Task (Result i64 FdWaitError))))
                   (state (ptr FdWaitState))
                   (fd i32)] (-> (Result (ptr (Task (Result i64 FdWaitError)))
                                         FdWaitError))
  (fd-wait-init runtime task state fd (Writable)))

(defn timer-poll [(raw (ptr i8)) (cx (ptr Context))] (-> (Poll (Result i64
                                                                       TimerError)))
  (let [state (primitive/cast (ptr TimerState) raw)]
    (match (monotonic-now-ms)
      (Err [error] (Ready (Err (Clock error))))
      (Ok [now]
          (if (>= now (load (field state deadline-ms)))
              (Ready (Ok 0))
              (do
                (arm-deadline (load (field state runtime))
                              (load (field state deadline-ms)))
                (Pending)))))))

(defn timer-close [(raw (ptr i8)) (cancelled bool)] (-> i64)
  0)

;;; Initialize a caller-owned monotonic timer task. TimerState and Task storage must both
;;; remain alive until task-close. Negative durations are rejected.
(defn timer-after-ms [(runtime (ptr Runtime))
                      (task (ptr (Task (Result i64 TimerError))))
                      (state (ptr TimerState))
                      (delay-ms i64)] (-> (Result (ptr (Task (Result i64
                                                                     TimerError)))
                                                  TimerError))
  (if (< delay-ms 0)
      (Err (InvalidDuration))
      (match (monotonic-now-ms)
        (Err [error] (Err (Clock error)))
        (Ok [now]
            (if (> delay-ms (- 9223372036854775807 now))
                (Err (InvalidDuration))
                (do
                  (store! (field state runtime) runtime)
                  (store! (field state deadline-ms) (+ now delay-ms))
                  (Ok (task-init task
                                 (primitive/cast (ptr i8) state)
                                 (primitive/fnptr-of timer-poll)
                                 (primitive/fnptr-of timer-close)))))))))
