(module coil.fail)
(import "coil.primitive" :as primitive)

;;; What a failure the program cannot continue from does on a target with no
;;; operating system.
;;;
;;; Hosted, such a failure -- out of memory, a fixed-capacity container asked to
;;; hold one more, a failed `--debug-checks` or `coil.safety` check, a panic --
;;; writes a report to stderr and aborts the process. With no OS there is no
;;; stderr and no process. There it calls the handler the program installed with
;;; `set-handler!`, if any, and then traps: `brk` on aarch64, `unimp` on RISC-V.
;;; The program decides how a failure is reported (over a UART, by resetting the
;;; board), and a program that installs nothing still stops at the failing site
;;; instead of running on.
;;;
;;;   (defn on-fail [(what (slice u8)) (where (slice u8))] (-> i64)
;;;     (uart-write "fatal: ") (uart-write what)
;;;     (uart-write " at ") (uart-write where)
;;;     (reset-board))
;;;
;;;   (fail/set-handler! (fnptr-of on-fail))
;;;
;;; `what` says what failed: `out of memory`, `capacity exceeded`, a check's
;;; message, or a panic's message as written, with its `{}` holes unfilled.
;;; `where` is the failing operation or a panic's `file:line:col`. The handler may
;;; halt or reset; if it returns, the failure traps.
;;;
;;; This module touches nothing outside the program, so the hermetic profile
;;; admits it.

;;; The installed handler. A static starts zeroed, which is `None`.
(defn handler [] (-> (ptr (Option (fnptr c [(slice u8) (slice u8)] i64))))
  (primitive/alloc-static (Option (fnptr c [(slice u8) (slice u8)] i64))))

;;; Install `h` to run when a failure stops a program on a target with no OS.
(defn set-handler! [(h (fnptr c [(slice u8) (slice u8)] i64))] (-> i64)
  (store! (handler) (Some h))
  0)

;;; Stop at a trap instruction: `brk` on aarch64, `unimp` on RISC-V, `ud2` on
;;; x86_64, `unreachable` on wasm. Unlike a store through a null pointer, which
;;; LLVM treats as undefined behavior and may delete together with the branch
;;; that reaches it, a trap always executes.
(defn trap! [] (-> never)
  (primitive/llvm-ir i64 [] "call void @llvm.trap()\nunreachable")
  (loop 0))

;;; Run the installed handler with `what` and `where`, then trap.
(defn fail! [(what (slice u8)) (where (slice u8))] (-> never)
  (match (load (handler))
    (Some [h] (h what where))
    (None [] 0))
  (trap!))

;;; The bytes of the NUL-terminated string `s`, for a site the caller names with
;;; a C string. It scans by hand: on a target with no OS there is no `strlen`.
(defn cstr-slice [(s (ptr i8))] (-> (slice u8))
  (let [(mut n) 0]
    (loop (if (= (primitive/cast i64 (load (primitive/index s (load n)))) 0)
              (break)
              (set! n (primitive/iadd (load n) 1))))
    ; slice::new's construction, inlined: coil.slice is not admitted under the
    ; hermetic profile, and this module is.
    (primitive/llvm-ir (slice u8)
                       [(primitive/cast (ptr u8) s) (load n)]
                       "%s0 = insertvalue $ret undef, $t0 $0, 0
%s1 = insertvalue $ret %s0, $t1 $1, 1
ret $ret %s1")))

;;; Whether the program is being compiled for a target with no OS. A compile-time
;;; question, for macros.
(defn freestanding? [] (-> bool)
  (primitive/code-eq (primitive/target-os) `none))

;;; `(freestanding-or bare hosted)`: `bare` on a target with no OS, `hosted`
;;; everywhere else. The choice is made as the program is compiled, so the other
;;; form, and whatever it calls, never reaches the object.
(defn freestanding-or [(bare Code) (hosted Code)] (-> Code)
  (if (freestanding?) bare hosted))
