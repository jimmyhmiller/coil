(module coil.lint.recursive-code-splice)
(import "coil.primitive" :as primitive)

(defn rcs-call-to? [(form Code) (name Code)] (-> bool)
  (and (primitive/code-list? form)
       (and (> (primitive/code-count form) 0)
            (primitive/code-eq (primitive/code-car form) name))))

(defn rcs-self-splice? [(form Code) (name Code)] (-> bool)
  (and (primitive/code-list? form)
       (and (= (primitive/code-count form) 2)
            (and (primitive/code-eq (primitive/code-car form) `unquote-splicing)
                 (rcs-call-to? (primitive/code-nth form 1) name)))))

(defn rcs-walk [(form Code) (name Code)] (-> Code)
  (if (primitive/code-list? form)
      (do
        (when (rcs-self-splice? form name)
          (primitive/report
            form
            "recursive-code-splice: recursive ~@ copies an expanding suffix and is O(n^2); accumulate with code-cons and reverse, or walk with code-car/code-cdr")
          0)
        (rcs-kids form name 0 (primitive/code-count form)))
    `0))

(defn rcs-kids [(form Code) (name Code) (i i64) (n i64)] (-> Code)
  (if (>= i n) `0
    (do (rcs-walk (primitive/code-nth form i) name)
        (rcs-kids form name (+ i 1) n))))

(defn rcs-definition [(form Code)] (-> Code)
  (if (and (primitive/code-from-user? form)
           (and (primitive/code-list? form)
           (and (> (primitive/code-count form) 2)
                (and (primitive/code-eq (primitive/code-car form) `defn)
                     (primitive/code-sym? (primitive/code-nth form 1))))))
      (rcs-kids form (primitive/code-nth form 1) 2 (primitive/code-count form))
    `0))

(defn rcs-module-forms [(module Code) (i i64) (n i64)] (-> Code)
  (if (>= i n) `0
    (do (rcs-definition (primitive/code-nth module i))
        (rcs-module-forms module (+ i 1) n))))

(defn rcs-modules [(modules Code) (i i64) (n i64)] (-> Code)
  (if (>= i n) `0
    (let [module (primitive/code-nth modules i)]
      (do (rcs-module-forms module 1 (primitive/code-count module))
          (rcs-modules modules (+ i 1) n)))))

(defn lint-recursive-code-splice [(modules Code)] (-> Code)
  (rcs-modules modules 0 (primitive/code-count modules)))

(checker lint-recursive-code-splice :phase before-expand)
