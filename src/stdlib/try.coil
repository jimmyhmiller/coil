(module coil.try)
(import "coil.primitive" :as primitive)
; `?`/try-style early exit for Result/Option — a PURE LIBRARY MACRO over
; block/return-from (themselves macros over loop/break). No core support: this is
; the macros-first thesis continuing into Phase-2, killing the Result/Option
; match-pyramids.
;
; Wrap a function body in `(try …)` (a `block :try`), then `(try! e)` unwraps an
; `(Ok v)` to v or short-circuits the whole `try` with `(Err e)`; `(try? e)` does
; the same for `(Some v)` / `(None)`. The function's return type is the Result/
; Option, and the try body's normal tail must produce one (e.g. end in `(Ok …)`).
;
;   (import "coil.try" :use *) (import "coil.result" :use *)
;   (defn f [...] (-> (Result i64 E))
;     (try (let [a (try! (g ...)) b (try! (h ...))] (Ok (primitive/iadd a b)))))
;
; NOTE: the block label is the fixed `:try`, so nesting two `(try …)` blocks in ONE
; function shadows (a compile error) — use one try-block per function (the common
; case; functions compose via their Result returns).

(import "coil.result"  :use *)   ; Ok / Err / Some / None
(import "coil.control" :use *)   ; block / return-from / loop / break

(defn try [& (body Code)] (-> Code)
  `(block :try ~@body))

;; Result: (Ok v) -> v ; (Err e) -> short-circuit the enclosing (try) with (Err e).
(defn try! [(e Code)] (-> Code)
  (let [v (primitive/gensym) er (primitive/gensym)]
    `(match ~e
       (Ok  [~v] ~v)
       (Err [~er] (return-from :try (Err ~er))))))

;; Option: (Some v) -> v ; (None) -> short-circuit the enclosing (try) with (None).
(defn try? [(e Code)] (-> Code)
  (let [v (primitive/gensym)]
    `(match ~e
       (Some [~v] ~v)
       (None []   (return-from :try (None))))))

;; Unwrap a Result in an arbitrary `try` block. On Err, return `fallback` from the
;; block. This is useful at CLI/test boundaries that translate rich errors to an exit
;; code instead of returning Result themselves: `(try-or! (open ...) 2)`.
(defn try-or! [(e Code) (fallback Code)] (-> Code)
  (let [v (primitive/gensym) er (primitive/gensym)]
    `(match ~e
       (Ok [~v] ~v)
       (Err [~er] (return-from :try ~fallback)))))

;; Unwrap an Option in an arbitrary `try` block, returning `fallback` for None.
(defn some-or! [(e Code) (fallback Code)] (-> Code)
  (let [v (primitive/gensym)]
    `(match ~e
       (Some [~v] ~v)
       (None [] (return-from :try ~fallback)))))

;; Require a condition in an arbitrary `try` block, otherwise return `fallback`.
(defn ensure! [(condition Code) (fallback Code)] (-> Code)
  `(if ~condition 0 (return-from :try ~fallback)))
