(module coil.debug-runtime)
(import "coil.primitive" :as primitive)
(import "coil.crash" :use *)

(export debug-runtime-install!
        debug-runtime-install-artifact!
        debug-runtime-event!
        debug-runtime-set-event-capacity!)

(defn debug-runtime-install! [] (-> i64)
  (crash-install!))

(defn debug-runtime-install-artifact! [(path (ptr i8))] (-> i64)
  (crash-install-artifact! path))

(defn debug-runtime-event! [(event (slice u8))] (-> i64)
  (crash-event! event))

(defn debug-runtime-set-event-capacity! [(capacity i64)] (-> i64)
  (crash-set-event-capacity! capacity))

; `--debug-runtime` auto-imports this module. Its semantic transform inserts one
; installation call at the start of the program's existing main function. A
; marker definition makes the rewrite converge after resolution qualifies names.
(defn dr-marker? [(form Code)] (-> bool)
  (and (primitive/code-list? form)
       (and (>= (primitive/code-count form) 2)
            (and (primitive/code-eq (primitive/code-nth form 0) `const)
                 (primitive/code-eq (primitive/code-nth form 1) `coil-debug-runtime$installed)))))

(defn dr-main? [(form Code)] (-> bool)
  (and (primitive/code-list? form)
       (and (>= (primitive/code-count form) 4)
            (and (primitive/code-eq (primitive/code-nth form 0) `defn)
                 (primitive/code-eq (primitive/code-nth form 1) `main)))))

(defn dr-module-marked? [(module Code) (i i64)] (-> bool)
  (if (>= i (primitive/code-count module))
      false
      (if (dr-marker? (primitive/code-nth module i)) true (dr-module-marked? module (+ i 1)))))

;; A growable Code list, not `(~x ~@(self …)): re-splicing the recursion's
;; result copies the suffix at every level — quadratic in the body length
;; (docs/design/META_MEMORY.md).
(defn dr-tail [(form Code) (i i64)] (-> Code)
  (let [out (primitive/code-list-new)
        (mut k) i]
    (loop (if (>= (load k) (primitive/code-count form))
              (break)
              (do (primitive/code-list-push! out (primitive/code-nth form (load k)))
                  (set! k (+ (load k) 1)))))
    (primitive/code-list-done out)))

(defn dr-rewrite-form [(form Code)] (-> Code)
  (if (dr-main? form)
      `(defn ~(primitive/code-nth form 1)
         ~(primitive/code-nth form 2)
         ~(primitive/code-nth form 3)
         (debug-runtime-install!)
         ~@(dr-tail form 4))
      form))

;; Builder loop for the same reason as dr-tail (docs/design/META_MEMORY.md).
(defn dr-rewrite-forms [(module Code) (i i64)] (-> Code)
  (let [out (primitive/code-list-new)
        (mut k) i]
    (loop (if (>= (load k) (primitive/code-count module))
              (break)
              (do (primitive/code-list-push! out (dr-rewrite-form (primitive/code-nth module (load k))))
                  (set! k (+ (load k) 1)))))
    (primitive/code-list-done out)))

(defn dr-module-has-main? [(module Code) (i i64)] (-> bool)
  (if (>= i (primitive/code-count module))
      false
      (if (dr-main? (primitive/code-nth module i)) true (dr-module-has-main? module (+ i 1)))))

(defn dr-rewrite-module [(module Code)] (-> Code)
  (if (or (dr-module-marked? module 1) (not (dr-module-has-main? module 1)))
      module
      `(~@(dr-rewrite-forms module 0) (const coil-debug-runtime$installed 1))))

;; Builder loop for the same reason as dr-tail (docs/design/META_MEMORY.md).
(defn dr-rewrite-modules [(modules Code) (i i64)] (-> Code)
  (let [out (primitive/code-list-new)
        (mut k) i]
    (loop (if (>= (load k) (primitive/code-count modules))
              (break)
              (do (primitive/code-list-push! out (dr-rewrite-module (primitive/code-nth modules (load k))))
                  (set! k (+ (load k) 1)))))
    (primitive/code-list-done out)))

(defn dr-transform [(modules Code)] (-> Code)
  `(do ~@(dr-rewrite-modules modules 0)))

(transform dr-transform)
