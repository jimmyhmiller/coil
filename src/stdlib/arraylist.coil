(module coil.arraylist)
(import "coil.primitive" :as primitive)
; A growable array — `ArrayList T` — built on slices + the allocator-as-value
; interface (src/stdlib/alloc.coil). Like everything else, an ORDINARY generic struct +
; functions/macros; the compiler has no notion of it, and there is no ambient
; heap: an ArrayList carries the `(ptr Allocator)` it grows with.
;
;   (import "coil.arraylist" :use *)
;   (let [a (malloc-allocator) (mut xs) (al-new [i64] a)]
;     (al-push! (mut xs) 10) (al-for [v xs] …) (al-free! (mut xs)))
;
; Mutating ops take `(mut (ArrayList T))` — pass `(mut xs)`. Reads take it by
; value. `al-push!` grows by doubling (initial cap 4); it tries the allocator's
; in-place `resize`, else allocates-copies-frees (so arena allocators work too),
; and HARD-ABORTS on genuine OOM (never a silent-wrong value). `--debug-checks`
; validates list headers and bounds on reads/writes; release builds remain unchecked.

(import "coil.alloc" :use *)  ; Allocator, raw-*, alloc-slice, malloc-allocator
(import "coil.result" :use *)  ; Option/Some/None for the allocator's results
(import "coil.slice" :use *)  ; (slice T) / slice-new, for al-slice + al-for
(import "coil.mem" :use *)  ; mem-copy, for the bulk al-extend! append
; OOM hard-fail routes through alloc's `oom` (a shared defn) rather than a local
; `abort` extern, so ArrayList + HashMap can be imported together (Coil doesn't
; dedup identical extern decls across modules).

(defstruct ArrayList [T]
  [(data (ptr T)) (len i64) (cap i64) (alc (ptr Allocator))])

;; Development checks are macros so release builds retain the original unchecked
;; expressions byte-for-byte. Header validation catches a corrupted/mis-tagged value
;; before its payload is used as a pointer; bounds validation names the collection
;; operation instead of leaving a later arbitrary memory fault.
(defn dbg-al-header [(l Code) (site Code)] (-> Code)
  (if (primitive/debug-checks?)
      `(if (and (>= (load (field ~l len)) 0)
                (and (>= (load (field ~l cap)) 0)
                     (and (<= (load (field ~l len)) (load (field ~l cap)))
                          (and (if (= (load (field ~l cap)) 0)
                                   (= (primitive/cast i64 (load (field ~l data))) 0)
                                   (!= (primitive/cast i64 (load (field ~l data))) 0))
                               (!= (primitive/cast i64 (load (field ~l alc))) 0)))))
           0
           (do (debug-fail-at ~site) 0))
      `0))

(defn dbg-al-index [(l Code) (i Code) (site Code)] (-> Code)
  (if (primitive/debug-checks?)
      `(do
         (dbg-al-header ~l c"ArrayList header corrupt")
         (if (or (< ~i 0) (>= ~i (load (field ~l len))))
             (do (debug-fail-at ~site) 0)
             0))
      `0))

(defn dbg-al-reserve-request [(newcap Code)] (-> Code)
  (if (primitive/debug-checks?)
      `(if (< ~newcap 0)
           (do (debug-fail-at c"negative ArrayList capacity in al-reserve!") 0)
           0)
      `0))

(defn dbg-al-extend-request [(src Code) (n Code)] (-> Code)
  (if (primitive/debug-checks?)
      `(if (or (< ~n 0) (and (> ~n 0) (= (primitive/cast i64 ~src) 0)))
           (do (debug-fail-at c"invalid source or length in al-extend!") 0)
           0)
      `0))

;; An empty list that will grow with allocator `a` (no allocation until first push).
(defn al-new [T] [(a (ptr Allocator))] (-> (ArrayList T))
  (let [(mut l) (primitive/zeroed (ArrayList T))]
    (store! (field l alc) a)
    (load l)))

(defn al-len [T] [(l (ArrayList T))] (-> i64)
  (dbg-al-header l c"ArrayList header corrupt in al-len")
  (load (field l len)))
(defn al-cap [T] [(l (ArrayList T))] (-> i64)
  (dbg-al-header l c"ArrayList header corrupt in al-cap")
  (load (field l cap)))
(defn al-empty? [T] [(l (ArrayList T))] (-> bool)
  (dbg-al-header l c"ArrayList header corrupt in al-empty?")
  (= (load (field l len)) (cast i64 0)))

(defn al-get [T] [(l (ArrayList T)) (i i64)] (-> T)
  (dbg-al-index l i c"ArrayList index out of bounds in al-get")
  (load (primitive/index (load (field l data)) i)))

;; A POINTER to element i — the live element, not a copy. Reach it through a
;; `(ptr (ArrayList T))`, which every `(mut …)` binding and struct field already is.
;;
;; This is what you want to read a FIELD out of a list of structs. `al-get` returns
;; by value, and `field` needs a place, so `(field (al-get l i) name)` cannot compile:
;;
;;   (load (field (al-elem [Rec] l i) name))     ; reads through the live element
;;   (store! (field (al-elem [Rec] l i) name) v) ; and writes to it
;;
;; ⚠ The pointer is INTERIOR: it aims at live storage, so any mutation of the list
;; between taking it and reading through it is a use-after-invalidate. Two distinct
;; ways that happens, and the second is the one that bites:
;;
;;   * anything that may REALLOCATE the buffer (`al-push!`, `al-reserve!`, …) moves
;;     the whole block, so the pointer dangles;
;;   * anything that changes WHAT LIVES AT THAT INDEX (`al-pop!`, `al-set!`, …)
;;     leaves the pointer valid as MEMORY while the element it named is no longer
;;     live. No reallocation happens, so reasoning about growth does not catch it:
;;
;;       (let [b (al-elem [Bind] l (- n 1))]
;;         (al-pop! [Bind] (mut l))
;;         (load (field b node)))            ; ⚠ reads a popped slot
;;
;;     `al-pop!` only decrements `len`, so that read returns the RIGHT value — until
;;     the next `al-push!` writes over the slot, and then it silently returns the new
;;     element instead. So this shape passes its tests and breaks later, under an
;;     unrelated change, which is the worst way for it to fail. Read what you need
;;     BEFORE mutating, or re-take the pointer after.
;;
;; Take it, use it, do not store it across any mutation. `al-get` returns by value
;; and has none of this hazard — swapping `al-get` for `al-elem` looks like a pure
;; simplification at the call site and is not.
(defn al-elem [T] [(p (ptr (ArrayList T))) (i i64)] (-> (ptr T))
  (dbg-al-index p i c"ArrayList index out of bounds in al-elem")
  (primitive/index (load (field p data)) i))
(defn al-set! [T] [(l (mut (ArrayList T))) (i i64) (v T)] (-> i64)
  (dbg-al-index l i c"ArrayList index out of bounds in al-set!")
  (store! (primitive/index (load (field l data)) i) v)
  0)

;; Grow capacity to at least `newcap`. Tries in-place resize; on failure (e.g. an
;; arena, which never resizes) allocates fresh, copies, frees the old block; a
;; genuine allocation failure aborts.
(defn al-reserve! [T] [(l (mut (ArrayList T))) (newcap i64)] (-> i64)
  (dbg-al-header l c"ArrayList header corrupt in al-reserve!")
  (dbg-al-reserve-request newcap)
  (let [oldcap (load (field l cap))
        a (load (field l alc))]
    (if (<= newcap oldcap)
        0
        (match (raw-resize a
                           (primitive/cast (ptr i8) (load (field l data)))
                           (primitive/imul oldcap (primitive/sizeof T))
                           (primitive/imul newcap (primitive/sizeof T))
                           (primitive/alignof T))
          (Some [p]
                (do
                  (store! (field l data) (primitive/cast (ptr T) p))
                  (store! (field l cap) newcap)
                  0))
          (None []
                (match (alloc-slice [T] a newcap)
                  ; out of memory — hard fail, no silent wrong. `oom-at` names the site and
                  ; the request so an exhausted arena says so instead of exiting 134 silently.
                  (None [] (do (oom-at c"arraylist al-reserve!" (primitive/imul newcap (primitive/sizeof T))) -1))
                  (Some [np]
                        (do
                          (let [(mut i) 0]
                            (loop (if (>= (load i) (load (field l len)))
                                      (break)
                                      (do
                                        (store! (primitive/index np (load i))
                                                (load (primitive/index (load (field l data)) (load i))))
                                        (store! i (primitive/iadd (load i) 1))))))
                          (if (> oldcap (cast i64 0))
                              (raw-free a
                                        (primitive/cast (ptr i8) (load (field l data)))
                                        (primitive/imul oldcap (primitive/sizeof T))
                                        (primitive/alignof T))
                              0)
                          (store! (field l data) np)
                          (store! (field l cap) newcap)
                          0))))))))

;; Append v; grows (doubling, first allocation 2) if full. Returns the new length.
;;
;; The first allocation is 2 elements, not 4. Most lists are SHORT, and a first block of 4
;; overshoots them by 2 slots of `sizeof T` that are never used — which for a big T is not
;; a rounding error. Measured on the compiler (`check src/compiler/main.coil`, ~5.8M
;; allocations): the two commonest allocation sizes in the whole process were a 4-slot
;; `(ArrayList Expr)` at 672 bytes (360k of them, 231 MiB) and a 4-slot `(ArrayList Sexp)`
;; at 256 bytes (917k, 224 MiB), while 4->8 growths were rarer than 4-slot allocations by
;; more than 20x. Almost nothing was outgrowing the first block; it was simply too big.
;;
;; Dropping it to 2 took peak RSS from 1022 MiB to 841 MiB (-18%) AND the run from 0.530s
;; to 0.495s (-30 ms, faster in 9 of 12 paired runs) — less memory touched is also less
;; memory to fault in and miss on. 1 was tried too: 811 MiB but slower than 2, so the
;; extra growth step stops paying there.
(defn al-push! [T] [(l (mut (ArrayList T))) (v T)] (-> i64)
  (dbg-al-header l c"ArrayList header corrupt in al-push!")
  (let [n (load (field l len))]
    (if (>= n (load (field l cap)))
        (al-reserve! (mut l)
                     (if (= (load (field l cap)) (cast i64 0))
                         2
                         (primitive/imul (load (field l
                                                      cap))
                                         2)))
        0)
    (store! (primitive/index (load (field l data)) n) v)
    (store! (field l len) (primitive/iadd n 1))
    (primitive/iadd n 1)))

;; Append n elements from `src` in one shot. Reserves the whole run up front and block
;; copies it — the equivalent `al-push!` loop costs a call plus a capacity test per
;; element and a realloc-and-copy at every doubling, where this pays one growth and one
;; `mem-copy`. `src` must not point into this list's own buffer (the copy is memcpy, and
;; a growth moves the buffer anyway). Returns the new length.
(defn al-extend! [T] [(l (mut (ArrayList T))) (src (ptr T)) (n i64)] (-> i64)
  (dbg-al-header l c"ArrayList header corrupt in al-extend!")
  (dbg-al-extend-request src n)
  (let [old (load (field l len))
        need (primitive/iadd old n)]
    (if (> need (load (field l cap)))
        (al-reserve! (mut l) need)
        0)
    (mem-copy [T] (primitive/index (load (field l data)) old) src n)
    (store! (field l len) need)
    need))

;; Remove and return the last element as (Some v); (None) if empty.
(defn al-pop! [T] [(l (mut (ArrayList T)))] (-> (Option T))
  (dbg-al-header l c"ArrayList header corrupt in al-pop!")
  (let [n (load (field l len))]
    (if (= n (cast i64 0))
        (None)
        (let [v (load (primitive/index (load (field l data)) (primitive/isub n 1)))]
          (store! (field l len) (primitive/isub n 1))
          (Some v)))))

;; A slice view over the current elements (shares storage; invalidated by a later
;; grow that moves the buffer).
(defn al-slice [T] [(l (ArrayList T))] (-> (slice T))
  (dbg-al-header l c"ArrayList header corrupt in al-slice")
  (slice-new (load (field l data)) (load (field l len))))

;; Free the backing buffer and reset to empty (the allocator itself is untouched).
(defn al-free! [T] [(l (mut (ArrayList T)))] (-> i64)
  (dbg-al-header l c"ArrayList header corrupt in al-free!")
  (if (> (load (field l cap)) (cast i64 0))
      (raw-free (load (field l alc))
                (primitive/cast (ptr i8) (load (field l data)))
                (primitive/imul (load (field l cap)) (primitive/sizeof T))
                (primitive/alignof T))
      0)
  (store! (field l data) (primitive/cast (ptr T) 0))
  (store! (field l len) 0)
  (store! (field l cap) 0)
  0)

;; Reset to empty WITHOUT freeing the buffer — length becomes 0 but the capacity is
;; kept for reuse (the elements are logically gone; a later push overwrites them). Use
;; `al-free!` to also release the storage.
(defn al-clear! [T] [(l (mut (ArrayList T)))] (-> i64)
  (dbg-al-header l c"ArrayList header corrupt in al-clear!")
  (store! (field l len) 0)
  0)

;; Hand over ownership of the elements as a right-sized `(slice T)`, resetting the list
;; to empty. The buffer is shrunk to exactly `len` (via the allocator's resize) so the
;; returned slice owns a freeable, dangling-capacity-free block — free it with
;; `(raw-free a (primitive/cast (ptr i8) (slice-data s)) (* (slice-len s) (primitive/sizeof T)) (primitive/alignof T))`.
;; This is the safe hand-off `al-slice` is NOT: `al-slice` returns a borrowed view that
;; the next `al-push!` can invalidate by moving the buffer, whereas this transfers the
;; storage out of the list entirely. On an empty list the result is an empty slice.
(defn al-into-slice [T] [(l (mut (ArrayList T)))] (-> (slice T))
  (dbg-al-header l c"ArrayList header corrupt in al-into-slice")
  (let [a (load (field l alc))
        n (load (field l len))
        cap (load (field l cap))
        data (load (field l data))
        final
          (if (and (> cap n) (> n (cast i64 0)))
              ; shrink to exactly n; if the allocator can't, keep the full block
              ; (the extra capacity is leaked, never a use-after-free).
              (match (raw-resize a
                                 (primitive/cast (ptr i8) data)
                                 (primitive/imul cap (primitive/sizeof T))
                                 (primitive/imul n (primitive/sizeof T))
                                 (primitive/alignof T))
                (Some [p] (primitive/cast (ptr T) p))
                (None [] data))
              data)]
    (store! (field l data) (primitive/cast (ptr T) 0))
    (store! (field l len) 0)
    (store! (field l cap) 0)
    (slice-new final n)))

;; `(al-for [x xs] body...)` — iterate the list's elements. A thin alias for the
;; unified iterator protocol `(for x (iter xs))` (gen-1): it expands to
;; `(for-in [x (iter xs)])`, driving the list's `Iterator` impl (a `SliceIter` over
;; its `al-slice` view). Kept as a convenience spelling.
(defn al-for [(binding Code) & (body Code)] (-> Code)
  (if (not (= (primitive/code-count binding) (cast i64 2)))
      (primitive/error "al-for: binding must be [x arraylist]")
      `(for-in [~(primitive/code-nth binding 0) (iter ~(primitive/code-nth binding 1))] ~@body)))

; ---- the core collection traits (coil.core) ---------------------------------
; `(len xs)` / `(get xs i)` / `(set! (mut xs) i v)` / `(push! (mut xs) v)` /
; `(pop! (mut xs))` on any (ArrayList T) — the al-* functions remain the named
; API these delegate to.
(impl [T] Len (ArrayList T)
  (len [(xs (ArrayList T))] (-> i64) (al-len xs)))
(impl [T] Get (ArrayList T)
  (get [(xs (ArrayList T)) (i i64)] (-> T) (al-get xs i)))
(impl [T] Set (ArrayList T)
  (set! [(xs (mut (ArrayList T))) (i i64) (v T)] (-> i64) (al-set! (mut xs) i v)))
(impl [T] Push (ArrayList T)
  (push! [(xs (mut (ArrayList T))) (v T)] (-> i64) (al-push! (mut xs) v)))
(impl [T] Pop (ArrayList T)
  (pop! [(xs (mut (ArrayList T)))] (-> (Option T)) (al-pop! (mut xs))))

; ---- iteration (coil.core Iterable) -----------------------------------------
; A list iterates through a `(SliceIter T)` over its `al-slice` view — the same
; iterator slices use — so `(for x (iter xs))` and `(al-for [x xs] …)` walk the
; elements identically. The view is valid for the duration of a read-only walk
; (don't push/pop the list mid-iteration, exactly as `al-slice` already warns).
(impl [T] Iterable (ArrayList T)
  (iter [(xs (ArrayList T))] (-> (SliceIter T)) (iter (al-slice xs))))
