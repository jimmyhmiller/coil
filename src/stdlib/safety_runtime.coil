(module coil.safety.runtime)
(import "coil.primitive" :as primitive)
(import "coil.safety.checked")
(import "coil.slice" :use [slice-data slice-len])

; The checks `coil.safety` inserts, and the panic they share.
;
; Every function here is `:safety/checked false`, and the generic ones do their
; arithmetic with the wrapping primitives rather than operators. Both are load
; bearing: the dialect makes `coil.core`'s integer `+ - *` impls call back into
; this module, so an operator on a type parameter here would dispatch to the check
; it is implementing and recurse. A concrete-typed operator in an unchecked
; function is lowered to its primitive by the dialect, so it is safe either way.
;
; The panic path formats its own numbers and writes with write(2): a report that
; went through `coil.fmt` would run checked code, and a check failing inside the
; report of another would never finish.

(extern write :cc c [i32 (ptr i8) isize] (-> isize))

(extern abort :cc c [] (-> void))

(defn wasm-target? [] (-> bool)
  (let [arch (primitive/target-arch)]
    (or (primitive/code-eq arch `wasm32) (primitive/code-eq arch `wasm64))))

;;; backtrace(3), declared only where it exists: it walks frame records on Darwin
;;; and DWARF CFI on Linux, and a wasm module cannot walk its own stack at all.
(defn trace-externs [] (-> Code)
  (if (wasm-target?)
      `(do)
      ; hygiene: the libc symbols the trace below calls enter this module by their C names.
      `(do (extern ~(primitive/syntax->datum `backtrace) :cc c [(ptr (ptr i8)) i32] (-> i32))
           (extern ~(primitive/syntax->datum `backtrace_symbols_fd) :cc c [(ptr (ptr i8)) i32 i32]
                   (-> void)))))
(meta (trace-externs))

;;; `trace` on a target that has backtrace(3), `0` on one that does not.
(defn on-native [(trace Code)] (-> Code)
  (if (wasm-target?) `0 trace))

;;; Write `s` to stderr.
(defn put! :safety/checked false [(s (slice u8))] (-> i64)
  (write 2 (cast (ptr i8) (slice-data s)) (cast isize (slice-len s)))
  0)

;;; Write `v` to stderr in decimal. Digits come off the low end with `%`, whose
;;; result has the sign of `v`, so each digit is made positive on its own rather
;;; than negating `v`, which would overflow at the minimum i64.
(defn put-int! :safety/checked false [(v i64)] (-> i64)
  (let [buf (primitive/alloc-stack (array u8 24))
        digits (cast (ptr u8) buf)
        (mut rest) v
        (mut at) 24]
    (loop
      (let [r (primitive/irem rest 10)
            d (if (< r 0) (primitive/isub 0 r) r)]
        (set! at (primitive/isub at 1))
        (store! (primitive/index digits at) (cast u8 (primitive/iadd d 48)))
        (set! rest (primitive/idiv rest 10))
        (when (= rest 0) (break))))
    (when (< v 0)
      (set! at (primitive/isub at 1))
      (store! (primitive/index digits at) (cast u8 45)))
    (write 2 (cast (ptr i8) (primitive/index digits at)) (cast isize (primitive/isub 24 at)))
    0))

;;; Whether a panic is already being reported. A check that fails while another
;;; failure is being reported aborts at once instead of reporting again.
(defn panicking :safety/checked false [] (-> (ptr i64))
  (primitive/alloc-static i64))

;;; Start a panic report: `panic: ` and, on a nested failure, abort.
(defn begin! :safety/checked false [] (-> i64)
  (let [flag (panicking)]
    (when (!= (load flag) 0)
      (put! "panic: a runtime safety check failed while reporting another\n")
      (abort))
    (store! flag 1)
    (put! "panic: ")
    0))

;;; Finish a panic report with where the check was, and abort. An operation on a
;;; type parameter is checked inside coil.core's impl, where no call site is known.
(defn finish! :safety/checked false [(at (slice u8))] (-> i64)
  (put! "\n")
  (if (> (slice-len at) 0)
      (do (put! "  at ") (put! at) (put! "\n") 0)
      (do (put! "  in generic code: the operation's source location is not known\n") 0))
  (put-trace!)
  (abort)
  0)

;;; Write the stack trace, innermost first, starting with this report's own frames.
(defn put-trace! :safety/checked false [] (-> i64)
  (on-native
    (let [frames (primitive/alloc-stack (array (ptr i8) 64))
          n (backtrace (cast (ptr (ptr i8)) frames) 64)]
      (when (> n 0)
        (put! "stack trace:\n")
        (backtrace_symbols_fd (cast (ptr (ptr i8)) frames) n 2)
        0)
      0)))

;;; Report a failed check whose message needs no values, and abort.
(defn fail! :safety/checked false :inline (Never) [(what (slice u8)) (at (slice u8))] (-> i64)
  (begin!)
  (put! what)
  (finish! at))

;;; Report an index outside `[0, len)`, and abort.
(defn fail-index! :safety/checked false :inline (Never) [(i i64) (n i64) (at (slice u8))] (-> i64)
  (begin!)
  (put! "index out of bounds: index ")
  (put-int! i)
  (put! ", len ")
  (put-int! n)
  (finish! at))

;;; Report a slice range `[lo, hi)` that does not fit `[0, len]`, and abort.
(defn fail-range! :safety/checked false :inline (Never)
  [(lo i64) (hi i64) (n i64) (at (slice u8))] (-> i64)
  (begin!)
  (if (> lo hi)
      (do (put! "start index ")
          (put-int! lo)
          (put! " is larger than end index ")
          (put-int! hi)
          0)
      (do (put! "index out of bounds: range ")
          (put-int! lo)
          (put! "..")
          (put-int! hi)
          (put! ", len ")
          (put-int! n)
          0))
  (finish! at))

; ---- bounds -----------------------------------------------------------------

;;; `i`, after checking that it indexes a collection of length `n`.
(defn check-index :safety/checked false :inline (Always) [(i i64) (n i64) (at (slice u8))] (-> i64)
  (when (or (< i 0) (>= i n)) (fail-index! i n at))
  i)

;;; Check that `[lo, hi)` is a range inside a collection of length `n`.
(defn check-range :safety/checked false :inline (Always)
  [(lo i64) (hi i64) (n i64) (at (slice u8))] (-> i64)
  (when (or (< lo 0) (or (> lo hi) (> hi n))) (fail-range! lo hi n at))
  0)

; ---- integer arithmetic -------------------------------------------------------
; Generic over the integer type; the overflow primitives read signedness off it.

;;; The constants the integer checks need, for each standard integer type. A
;;; generic body cannot convert a literal to an unbounded `T`; the argument only
;;; selects the type.
(deftrait CheckedInt [Self]
  (zero-like [(x Self)] (-> Self))
  (minus-one-like [(x Self)] (-> Self))
  (width-like [(x Self)] (-> Self)))

(impl CheckedInt i8
  (zero-like :safety/checked false :inline (Always) [(x i8)] (-> i8) (cast i8 0))
  (minus-one-like :safety/checked false :inline (Always) [(x i8)] (-> i8) (cast i8 -1))
  (width-like :safety/checked false :inline (Always) [(x i8)] (-> i8) (cast i8 8)))

(impl CheckedInt i16
  (zero-like :safety/checked false :inline (Always) [(x i16)] (-> i16) (cast i16 0))
  (minus-one-like :safety/checked false :inline (Always) [(x i16)] (-> i16) (cast i16 -1))
  (width-like :safety/checked false :inline (Always) [(x i16)] (-> i16) (cast i16 16)))

(impl CheckedInt i32
  (zero-like :safety/checked false :inline (Always) [(x i32)] (-> i32) (cast i32 0))
  (minus-one-like :safety/checked false :inline (Always) [(x i32)] (-> i32) (cast i32 -1))
  (width-like :safety/checked false :inline (Always) [(x i32)] (-> i32) (cast i32 32)))

(impl CheckedInt i64
  (zero-like :safety/checked false :inline (Always) [(x i64)] (-> i64) (cast i64 0))
  (minus-one-like :safety/checked false :inline (Always) [(x i64)] (-> i64) (cast i64 -1))
  (width-like :safety/checked false :inline (Always) [(x i64)] (-> i64) (cast i64 64)))

(impl CheckedInt u8
  (zero-like :safety/checked false :inline (Always) [(x u8)] (-> u8) (cast u8 0))
  (minus-one-like :safety/checked false :inline (Always) [(x u8)] (-> u8) (cast u8 -1))
  (width-like :safety/checked false :inline (Always) [(x u8)] (-> u8) (cast u8 8)))

(impl CheckedInt u16
  (zero-like :safety/checked false :inline (Always) [(x u16)] (-> u16) (cast u16 0))
  (minus-one-like :safety/checked false :inline (Always) [(x u16)] (-> u16) (cast u16 -1))
  (width-like :safety/checked false :inline (Always) [(x u16)] (-> u16) (cast u16 16)))

(impl CheckedInt u32
  (zero-like :safety/checked false :inline (Always) [(x u32)] (-> u32) (cast u32 0))
  (minus-one-like :safety/checked false :inline (Always) [(x u32)] (-> u32) (cast u32 -1))
  (width-like :safety/checked false :inline (Always) [(x u32)] (-> u32) (cast u32 32)))

(impl CheckedInt u64
  (zero-like :safety/checked false :inline (Always) [(x u64)] (-> u64) (cast u64 0))
  (minus-one-like :safety/checked false :inline (Always) [(x u64)] (-> u64) (cast u64 -1))
  (width-like :safety/checked false :inline (Always) [(x u64)] (-> u64) (cast u64 64)))

;;; Whether `T` is a signed integer type: its -1 is below its zero.
(defn signed? :safety/checked false :inline (Always) [(T CheckedInt)] [(x T)] (-> bool)
  (primitive/icmp-lt (minus-one-like x) (zero-like x)))

(defn checked-add :safety/checked false :inline (Always) [(T CheckedInt)] [(a T) (b T) (at (slice u8))] (-> T)
  (when (primitive/iadd-overflow? a b) (fail! "integer overflow" at))
  (primitive/iadd a b))

(defn checked-sub :safety/checked false :inline (Always) [(T CheckedInt)] [(a T) (b T) (at (slice u8))] (-> T)
  (when (primitive/isub-overflow? a b) (fail! "integer overflow" at))
  (primitive/isub a b))

(defn checked-mul :safety/checked false :inline (Always) [(T CheckedInt)] [(a T) (b T) (at (slice u8))] (-> T)
  (when (primitive/imul-overflow? a b) (fail! "integer overflow" at))
  (primitive/imul a b))

;;; `0 - x`, which overflows only at a signed type's minimum.
(defn checked-neg :safety/checked false :inline (Always) [(T CheckedInt)] [(x T) (at (slice u8))] (-> T)
  (when (primitive/isub-overflow? (zero-like x) x) (fail! "integer overflow" at))
  (primitive/isub (zero-like x) x))

;;; The checks every integer division shares: no zero divisor, and not the one
;;; signed quotient that does not fit, the minimum divided by -1.
(defn check-divisor :safety/checked false :inline (Always) [(T CheckedInt)] [(a T) (b T) (at (slice u8))] (-> i64)
  (when (primitive/icmp-eq b (zero-like a)) (fail! "division by zero" at))
  (when (and (signed? b)
             (and (primitive/icmp-eq b (minus-one-like a))
                  (primitive/isub-overflow? (zero-like a) a)))
    (fail! "integer overflow" at))
  0)

;;; `idiv`/`/`: signed or unsigned by the operand type.
(defn checked-div :safety/checked false :inline (Always) [(T CheckedInt)] [(a T) (b T) (at (slice u8))] (-> T)
  (check-divisor a b at)
  (primitive/idiv a b))

(defn checked-rem :safety/checked false :inline (Always) [(T CheckedInt)] [(a T) (b T) (at (slice u8))] (-> T)
  (check-divisor a b at)
  (primitive/irem a b))

;;; `udiv`/`urem`: the bits of `a` and `b` read as unsigned, so only zero fails.
(defn checked-udiv :safety/checked false :inline (Always) [(T CheckedInt)] [(a T) (b T) (at (slice u8))] (-> T)
  (when (primitive/icmp-eq b (zero-like a)) (fail! "division by zero" at))
  (primitive/udiv a b))

(defn checked-urem :safety/checked false :inline (Always) [(T CheckedInt)] [(a T) (b T) (at (slice u8))] (-> T)
  (when (primitive/icmp-eq b (zero-like a)) (fail! "division by zero" at))
  (primitive/urem a b))

;;; A shift by a negative amount, or by the width of `T` or more, has no result.
(defn check-shift :safety/checked false :inline (Always) [(T CheckedInt)] [(b T) (at (slice u8))] (-> i64)
  (when (or (primitive/icmp-lt b (zero-like b))
            (primitive/icmp-ge b (width-like b)))
    (fail! "shift amount is greater than the type size" at))
  0)

(defn checked-shl :safety/checked false :inline (Always) [(T CheckedInt)] [(a T) (b T) (at (slice u8))] (-> T)
  (check-shift b at)
  (primitive/ishl a b))

(defn checked-shr :safety/checked false :inline (Always) [(T CheckedInt)] [(a T) (b T) (at (slice u8))] (-> T)
  (check-shift b at)
  (primitive/ishr a b))

; ---- conversions ------------------------------------------------------------

;;; Check an integer conversion: the value survived the round trip back to its
;;; source type, and it kept its sign.
(defn check-int-cast :safety/checked false :inline (Always)
  [(round-trips bool) (was-negative bool) (is-negative bool) (at (slice u8))] (-> i64)
  (when (and was-negative (not is-negative))
    (fail! "attempt to cast negative value to unsigned integer" at))
  (when (or (not round-trips) (!= was-negative is-negative))
    (fail! "integer cast truncated bits" at))
  0)

;;; Check a float-to-integer conversion into an integer of `bits` bits. The value
;;; converts toward zero, so its integer part must lie in the destination's range;
;;; NaN fails every comparison and so fails the check. `2^(bits-1)` is a power of
;;; two and exact in f64 for every width up to 64.
(defn check-float-cast :safety/checked false :inline (Always)
  [(v f64) (bits i64) (signed bool) (at (slice u8))] (-> i64)
  (let [half (primitive/fsub 0.0 (cast f64 (primitive/ishl (cast i64 -1) (primitive/isub bits 1))))
        t (if (< v 0.0) (primitive/fsub 0.0 (floor-positive (primitive/fsub 0.0 v))) (floor-positive v))
        ok (if signed
               (and (>= t (primitive/fsub 0.0 half)) (< t half))
               (and (>= t 0.0) (< t (primitive/fadd half half))))]
    (unless ok (fail! "integer part of floating point value out of bounds" at))
    0))

;;; The integer part of a non-negative `v` (NaN stays NaN): `v` less its fraction,
;;; found without converting to an integer, which is the operation being checked.
(defn floor-positive :safety/checked false :inline (Always) [(v f64)] (-> f64)
  (if (>= v 4503599627370496.0)
      v
      (let [r (primitive/fsub (primitive/fadd v 4503599627370496.0) 4503599627370496.0)]
        (if (> r v) (primitive/fsub r 1.0) r))))
