(module coil.safety.runtime)
(import "coil.primitive" :as primitive)
(import "coil.safety.checked")
(import "coil.panic" :use [begin! finish! put! put-int! site-cell])

; The checks `coil.safety` inserts. A failed check reports through coil.panic,
; as `(panic …)` does, so the two look alike and share one in-progress flag.
;
; Every function here is `:safety/checked false`, and the generic ones do their
; arithmetic with the wrapping primitives rather than operators. Both are load
; bearing: the dialect makes `coil.core`'s integer `+ - *` impls call back into
; this module, so an operator on a type parameter here would dispatch to the check
; it is implementing and recurse. A concrete-typed operator in an unchecked
; function is lowered to its primitive by the dialect, so it is safe either way.
;
; The report formats its own numbers and writes with write(2) (coil.panic's put!
; and put-int!): a report that went through `coil.fmt` would run checked code, and
; a check failing inside the report of another would never finish.

;;; Record the location of the generic arithmetic about to dispatch. An operation
;;; on a type parameter is checked inside coil.core's impl, which has no call site
;;; of its own, so the generic site records itself in coil.panic's site cell just
;;; before it dispatches, and a failed check with no location reports that one.
(defn set-site! :safety/checked false :inline (Always) [(at (slice u8))] (-> i64)
  (store! (site-cell) at)
  0)

;;; Report a failed check whose message needs no values, and abort.
(defn fail! :safety/checked false :inline (Never) [(what (slice u8)) (at (slice u8))] (-> never)
  (begin!)
  (put! what)
  (finish! at))

;;; Report an index outside `[0, len)`, and abort.
(defn fail-index! :safety/checked false :inline (Never) [(i i64) (n i64) (at (slice u8))] (-> never)
  (begin!)
  (put! "index out of bounds: index ")
  (put-int! i)
  (put! ", len ")
  (put-int! n)
  (finish! at))

;;; Report a slice range `[lo, hi)` that does not fit `[0, len]`, and abort.
(defn fail-range! :safety/checked false :inline (Never)
  [(lo i64) (hi i64) (n i64) (at (slice u8))] (-> never)
  (begin!)
  (if (> lo hi)
      (do (put! "start index ")
          (put-int! lo)
          (put! " is larger than end index ")
          (put-int! hi)
          0)
      (do (put! "index out of bounds: range ")
          (put-int! lo)
          (put! "..")
          (put-int! hi)
          (put! ", len ")
          (put-int! n)
          0))
  (finish! at))

; ---- bounds -----------------------------------------------------------------

;;; `i`, after checking that it indexes a collection of length `n`.
(defn check-index :safety/checked false :inline (Always) [(i i64) (n i64) (at (slice u8))] (-> i64)
  (when (or (< i 0) (>= i n)) (fail-index! i n at))
  i)

;;; Check that `[lo, hi)` is a range inside a collection of length `n`.
(defn check-range :safety/checked false :inline (Always)
  [(lo i64) (hi i64) (n i64) (at (slice u8))] (-> i64)
  (when (or (< lo 0) (or (> lo hi) (> hi n))) (fail-range! lo hi n at))
  0)

; ---- pointers ----------------------------------------------------------------

;;; Report an address that is not a multiple of the alignment its pointer type
;;; requires, and abort.
(defn fail-align! :safety/checked false :inline (Never)
  [(addr i64) (align i64) (at (slice u8))] (-> never)
  (begin!)
  (put! "misaligned pointer: address ")
  (put-int! addr)
  (put! " is not a multiple of ")
  (put-int! align)
  (finish! at))

;;; Check that `addr` is a multiple of `align`, a power of two. Zero, the null
;;; pointer, is aligned for every type.
(defn check-align :safety/checked false :inline (Always)
  [(addr i64) (align i64) (at (slice u8))] (-> i64)
  (when (!= (primitive/iand addr (primitive/isub align 1)) 0) (fail-align! addr align at))
  0)

;;; Check pointer arithmetic: `addr + k * size` neither overflows the offset nor wraps
;;; the address space in either direction.
(defn check-ptr-index :safety/checked false :inline (Always)
  [(addr i64) (k i64) (size i64) (at (slice u8))] (-> i64)
  (when (primitive/imul-overflow? k size) (fail! "pointer arithmetic overflow" at))
  (let [off (primitive/imul k size)
        sum (primitive/iadd addr off)]
    (when (if (primitive/icmp-ge off 0)
              (primitive/icmp-lt (primitive/cast u64 sum) (primitive/cast u64 addr))
              (primitive/icmp-gt (primitive/cast u64 sum) (primitive/cast u64 addr)))
      (fail! "pointer arithmetic overflow" at)))
  0)

;;; Report a sum value whose tag names no variant, and abort.
(defn fail-tag! :safety/checked false :inline (Never) [(tag i64) (n i64) (at (slice u8))] (-> never)
  (begin!)
  (put! "invalid variant tag: ")
  (put-int! tag)
  (put! ", the type has ")
  (put-int! n)
  (put! " variants")
  (finish! at))

;;; Check the tag of a sum value about to be loaded from memory.
(defn check-tag :safety/checked false :inline (Always) [(tag i64) (n i64) (at (slice u8))] (-> i64)
  (when (or (< tag 0) (>= tag n)) (fail-tag! tag n at))
  0)

;;; Check the byte of a `bool` about to be loaded from memory: zero or one.
(defn check-bool :safety/checked false :inline (Always) [(b u8) (at (slice u8))] (-> i64)
  (when (> b 1) (fail! "invalid boolean value" at))
  0)

;;; Fill `n` bytes at `p` with 0xAA, the pattern Zig gives `undefined`: a read of
;;; storage nothing wrote yields a value that is plainly wrong, not whatever the last
;;; user of the frame left. The loop is a plain byte store, which LLVM lowers to memset.
(defn fill-undefined! :safety/checked false :inline (Always) [(p (ptr i8)) (n i64)] (-> i64)
  (let [(mut i) 0]
    (while (primitive/icmp-lt i n)
      (store! (primitive/index p i) (primitive/cast i8 170))
      (set! i (primitive/iadd i 1))))
  0)

;;; Check that a pointer about to be read or written is not null.
(defn check-nonnull :safety/checked false :inline (Always) [(addr i64) (at (slice u8))] (-> i64)
  (when (= addr 0) (fail! "null pointer dereference" at))
  0)

;;; Check the pointer and byte count of a C memory function: the count is not
;;; negative, and a pointer that is read or written for `n > 0` bytes is not null.
(defn check-bytes :safety/checked false :inline (Always)
  [(addr i64) (n i64) (at (slice u8))] (-> i64)
  (when (< n 0) (fail! "negative byte count" at))
  (when (and (> n 0) (= addr 0)) (fail! "null pointer dereference" at))
  0)

;;; Check a `memcpy` of `n` bytes from `src` to `dst`: the two ranges may not
;;; overlap, which C leaves undefined. `memmove` is the call for overlapping ranges.
(defn check-copy :safety/checked false :inline (Always)
  [(dst i64) (src i64) (n i64) (at (slice u8))] (-> i64)
  (when (and (> n 0)
             (and (< dst (primitive/iadd src n)) (< src (primitive/iadd dst n))))
    (fail! "memcpy source and destination overlap" at))
  0)

; ---- integer arithmetic -------------------------------------------------------
; Generic over the integer type; the overflow primitives read signedness off it.

;;; The constants the integer checks need, for each standard integer type. A
;;; generic body cannot convert a literal to an unbounded `T`; the argument only
;;; selects the type.
(deftrait CheckedInt [Self]
  (zero-like [(x Self)] (-> Self))
  (minus-one-like [(x Self)] (-> Self))
  (width-like [(x Self)] (-> Self)))

(impl CheckedInt i8
  (zero-like :safety/checked false :inline (Always) [(x i8)] (-> i8) (: 0 i8))
  (minus-one-like :safety/checked false :inline (Always) [(x i8)] (-> i8) (: -1 i8))
  (width-like :safety/checked false :inline (Always) [(x i8)] (-> i8) (: 8 i8)))

(impl CheckedInt i16
  (zero-like :safety/checked false :inline (Always) [(x i16)] (-> i16) (: 0 i16))
  (minus-one-like :safety/checked false :inline (Always) [(x i16)] (-> i16) (: -1 i16))
  (width-like :safety/checked false :inline (Always) [(x i16)] (-> i16) (: 16 i16)))

(impl CheckedInt i32
  (zero-like :safety/checked false :inline (Always) [(x i32)] (-> i32) (: 0 i32))
  (minus-one-like :safety/checked false :inline (Always) [(x i32)] (-> i32) (: -1 i32))
  (width-like :safety/checked false :inline (Always) [(x i32)] (-> i32) (: 32 i32)))

(impl CheckedInt i64
  (zero-like :safety/checked false :inline (Always) [(x i64)] (-> i64) 0)
  (minus-one-like :safety/checked false :inline (Always) [(x i64)] (-> i64) -1)
  (width-like :safety/checked false :inline (Always) [(x i64)] (-> i64) 64))

(impl CheckedInt u8
  (zero-like :safety/checked false :inline (Always) [(x u8)] (-> u8) (: 0 u8))
  (minus-one-like :safety/checked false :inline (Always) [(x u8)] (-> u8) (cast u8 -1))
  (width-like :safety/checked false :inline (Always) [(x u8)] (-> u8) (: 8 u8)))

(impl CheckedInt u16
  (zero-like :safety/checked false :inline (Always) [(x u16)] (-> u16) (: 0 u16))
  (minus-one-like :safety/checked false :inline (Always) [(x u16)] (-> u16) (cast u16 -1))
  (width-like :safety/checked false :inline (Always) [(x u16)] (-> u16) (: 16 u16)))

(impl CheckedInt u32
  (zero-like :safety/checked false :inline (Always) [(x u32)] (-> u32) (: 0 u32))
  (minus-one-like :safety/checked false :inline (Always) [(x u32)] (-> u32) (cast u32 -1))
  (width-like :safety/checked false :inline (Always) [(x u32)] (-> u32) (: 32 u32)))

(impl CheckedInt u64
  (zero-like :safety/checked false :inline (Always) [(x u64)] (-> u64) (: 0 u64))
  (minus-one-like :safety/checked false :inline (Always) [(x u64)] (-> u64) (cast u64 -1))
  (width-like :safety/checked false :inline (Always) [(x u64)] (-> u64) (: 64 u64)))

(impl CheckedInt i128
  (zero-like :safety/checked false :inline (Always) [(x i128)] (-> i128) (: 0 i128))
  (minus-one-like :safety/checked false :inline (Always) [(x i128)] (-> i128) (: -1 i128))
  (width-like :safety/checked false :inline (Always) [(x i128)] (-> i128) (: 128 i128)))

(impl CheckedInt u128
  (zero-like :safety/checked false :inline (Always) [(x u128)] (-> u128) (: 0 u128))
  (minus-one-like :safety/checked false :inline (Always) [(x u128)] (-> u128) (cast u128 -1))
  (width-like :safety/checked false :inline (Always) [(x u128)] (-> u128) (: 128 u128)))

;;; Whether `T` is a signed integer type: its -1 is below its zero.
(defn signed? :safety/checked false :inline (Always) [(T CheckedInt)] [(x T)] (-> bool)
  (primitive/icmp-lt (minus-one-like x) (zero-like x)))

;; Each checked operation is one expression, so a static assertion's condition
;; folds through it like through the operator it replaced (mono.coil,
;; assert-inline-body): the overflow test folds, and the failure is reached only
;; when the assertion's arithmetic does overflow.

(defn checked-add :safety/checked false :inline (Always) [(T CheckedInt)] [(a T) (b T) (at (slice u8))] (-> T)
  (if (primitive/iadd-overflow? a b) (fail! "integer overflow" at) (primitive/iadd a b)))

(defn checked-sub :safety/checked false :inline (Always) [(T CheckedInt)] [(a T) (b T) (at (slice u8))] (-> T)
  (if (primitive/isub-overflow? a b) (fail! "integer overflow" at) (primitive/isub a b)))

(defn checked-mul :safety/checked false :inline (Always) [(T CheckedInt)] [(a T) (b T) (at (slice u8))] (-> T)
  (if (primitive/imul-overflow? a b) (fail! "integer overflow" at) (primitive/imul a b)))

;;; `0 - x`, which overflows only at a signed type's minimum.
(defn checked-neg :safety/checked false :inline (Always) [(T CheckedInt)] [(x T) (at (slice u8))] (-> T)
  (if (primitive/isub-overflow? (zero-like x) x)
      (fail! "integer overflow" at)
      (primitive/isub (zero-like x) x)))

;;; The checks every integer division shares: no zero divisor, and not the one
;;; signed quotient that does not fit, the minimum divided by -1.
(defn check-divisor :safety/checked false :inline (Always) [(T CheckedInt)] [(a T) (b T) (at (slice u8))] (-> i64)
  (when (primitive/icmp-eq b (zero-like a)) (fail! "division by zero" at))
  (when (and (signed? b)
             (and (primitive/icmp-eq b (minus-one-like a))
                  (primitive/isub-overflow? (zero-like a) a)))
    (fail! "integer overflow" at))
  0)

;;; `idiv`/`/`: signed or unsigned by the operand type.
(defn checked-div :safety/checked false :inline (Always) [(T CheckedInt)] [(a T) (b T) (at (slice u8))] (-> T)
  (check-divisor a b at)
  (primitive/idiv a b))

(defn checked-rem :safety/checked false :inline (Always) [(T CheckedInt)] [(a T) (b T) (at (slice u8))] (-> T)
  (check-divisor a b at)
  (primitive/irem a b))

;;; `udiv`/`urem`: the bits of `a` and `b` read as unsigned, so only zero fails.
(defn checked-udiv :safety/checked false :inline (Always) [(T CheckedInt)] [(a T) (b T) (at (slice u8))] (-> T)
  (when (primitive/icmp-eq b (zero-like a)) (fail! "division by zero" at))
  (primitive/udiv a b))

(defn checked-urem :safety/checked false :inline (Always) [(T CheckedInt)] [(a T) (b T) (at (slice u8))] (-> T)
  (when (primitive/icmp-eq b (zero-like a)) (fail! "division by zero" at))
  (primitive/urem a b))

;;; A shift by a negative amount, or by the width of `T` or more, has no result.
(defn check-shift :safety/checked false :inline (Always) [(T CheckedInt)] [(b T) (at (slice u8))] (-> i64)
  (when (or (primitive/icmp-lt b (zero-like b))
            (primitive/icmp-ge b (width-like b)))
    (fail! "shift amount is greater than the type size" at))
  0)

(defn checked-shl :safety/checked false :inline (Always) [(T CheckedInt)] [(a T) (b T) (at (slice u8))] (-> T)
  (check-shift b at)
  (primitive/ishl a b))

(defn checked-shr :safety/checked false :inline (Always) [(T CheckedInt)] [(a T) (b T) (at (slice u8))] (-> T)
  (check-shift b at)
  (primitive/ishr a b))

; ---- conversions ------------------------------------------------------------

;;; Check an integer conversion: the value survived the round trip back to its
;;; source type, and it kept its sign. A negative value converted to a narrower
;;; signed type is truncated, not "negative to unsigned".
(defn check-int-cast :safety/checked false :inline (Always)
  [(round-trips bool) (was-negative bool) (is-negative bool) (to-unsigned bool) (at (slice u8))] (-> i64)
  (when (and (and to-unsigned was-negative) (not is-negative))
    (fail! "attempt to cast negative value to unsigned integer" at))
  (when (or (not round-trips) (!= was-negative is-negative))
    (fail! "integer cast truncated bits" at))
  0)

;;; Check a float-to-integer conversion into an integer of `bits` bits. The value
;;; converts toward zero, so its integer part must lie in the destination's range;
;;; NaN fails every comparison and so fails the check. `2^(bits-1)` is a power of
;;; two and exact in f64 for every width; an i64 holds it up to 64 bits, and 2^127
;;; is written out.
(defn check-float-cast :safety/checked false :inline (Always)
  [(v f64) (bits i64) (signed bool) (at (slice u8))] (-> i64)
  (let [half (if (= bits 128)
                 1.7014118346046923e38
                 (primitive/fsub 0.0 (cast f64 (primitive/ishl -1 (primitive/isub bits 1)))))
        t (if (< v 0.0) (primitive/fsub 0.0 (floor-positive (primitive/fsub 0.0 v))) (floor-positive v))
        ok (if signed
               (and (>= t (primitive/fsub 0.0 half)) (< t half))
               (and (>= t 0.0) (< t (primitive/fadd half half))))]
    (unless ok (fail! "integer part of floating point value out of bounds" at))
    0))

;;; The integer part of a non-negative `v` (NaN stays NaN): `v` less its fraction,
;;; found without converting to an integer, which is the operation being checked.
(defn floor-positive :safety/checked false :inline (Always) [(v f64)] (-> f64)
  (if (>= v 4503599627370496.0)
      v
      (let [r (primitive/fsub (primitive/fadd v 4503599627370496.0) 4503599627370496.0)]
        (if (> r v) (primitive/fsub r 1.0) r))))
