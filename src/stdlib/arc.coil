(module coil.arc)
(import "coil.primitive" :as primitive)
(import "coil.alloc" :as alloc)
(import "coil.atomic" :as atomic)
(import "coil.result" :use *)

; Thread-safe reference counting. Counts are sequentially consistent in the first
; implementation; weaker orderings require a separate measured correctness pass.
(defstruct ArcBlock [T]
  [(strong i64)
   (weak i64) ; includes one implicit weak reference while strong > 0
   (lease alloc/AllocatorLease)
   (value T)])

(defstruct Arc [T] [(block (ptr (ArcBlock T)))])
(defstruct Weak [T] [(block (ptr (ArcBlock T)))])

(defn arc-new-in [T] [(lease alloc/AllocatorLease) (value T)] (-> (Option (Arc T)))
  (match (alloc/lease-raw-alloc lease
                               (alloc/AllocRequest
                                 :type-id (alloc/type-id [(ArcBlock T)])
                                 :count 1
                                 :bytes (primitive/sizeof (ArcBlock T))
                                 :align (primitive/alignof (ArcBlock T))))
    (None []
      (let [failed-lease lease failed-value value]
        (None [(Arc T)])))
    (Some [raw]
      (let [block (primitive/cast (ptr (ArcBlock T)) raw)
            block-lease lease
            block-value value]
        (atomic/atomic-store (field block strong) 1)
        (atomic/atomic-store (field block weak) 1)
        (store! (field block lease) block-lease)
        (store! (field block value) block-value)
        (Some (Arc :block block))))))

(defn arc-new [T] [(value T)] (-> (Option (Arc T)))
  (arc-new-in (alloc/malloc-allocator-lease) value))

(defn arc-borrow [T] [(owner (ref (Arc T)))] (-> (ptr T))
  (field (load (field owner block)) value))

(defn arc-strong-count [T] [(owner (ref (Arc T)))] (-> i64)
  (atomic/atomic-load (field (load (field owner block)) strong)))

(defn arc-weak-count [T] [(owner (ref (Arc T)))] (-> i64)
  (primitive/isub (atomic/atomic-load (field (load (field owner block)) weak)) 1))

; Requiring the implicit weak to be the only weak prevents a concurrent upgrade
; from racing the uniqueness decision.
(defn arc-get-mut [T] [(owner (mut (Arc T)))] (-> (Option (ptr T)))
  (let [block (load (field owner block))]
    (if (and (= (atomic/atomic-load (field block strong)) 1)
             (= (atomic/atomic-load (field block weak)) 1))
        (Some (field block value))
        (None [(ptr T)]))))

(defn arc-downgrade [T] [(owner (ref (Arc T)))] (-> (Weak T))
  (let [block (load (field owner block))]
    (atomic/atomic-add (field block weak) 1)
    (Weak :block block)))

(defn weak-upgrade [T] [(owner (ref (Weak T)))] (-> (Option (Arc T)))
  (let [control (load (field owner block))
        (mut current) (atomic/atomic-load (field control strong))]
    (block :upgrade
      (loop
        (if (= (load current) 0)
            (break :upgrade (None [(Arc T)]))
            (let [observed (atomic/atomic-cas (field control strong)
                                              (load current)
                                              (primitive/iadd (load current) 1))]
              (if (= observed (load current))
                  (break :upgrade (Some (Arc :block control)))
                  (store! current observed)))))
      (None [(Arc T)]))))

(defn arc-free-block [T] [(block (ptr (ArcBlock T)))] (-> i64)
  ; The moved-out lease remains live across deallocation, then releases its own
  ; allocator state only after the block that stored it is gone.
  (let [lease (take! [alloc/AllocatorLease] (field block lease))]
    (alloc/lease-raw-free lease
                          (primitive/cast (ptr i8) block)
                          (alloc/AllocRequest
                            :type-id (alloc/type-id [(ArcBlock T)])
                            :count 1
                            :bytes (primitive/sizeof (ArcBlock T))
                            :align (primitive/alignof (ArcBlock T))))))

(defn arc-release-weak [T] [(block (ptr (ArcBlock T)))] (-> i64)
  (if (= (atomic/atomic-sub (field block weak) 1) 1)
      (arc-free-block block)
      0))

(defn arc-try-unwrap [T] [(owner (Arc T))] (-> (Result T (Arc T)))
  (let [held (manually-drop owner)
        block (load (field (field held value) block))]
    ; CAS owns the unique 1 -> 0 transition. If another thread cloned first, the
    ; original handle is returned intact.
    (if (!= (atomic/atomic-cas (field block strong) 1 0) 1)
        (Err [T (Arc T)] (manually-drop-into-inner held))
        (let [value (take! [T] (field block value))]
          (forget (arc-release-weak block))
          (forget held)
          (Ok [T (Arc T)] value)))))

(defn arc-into-inner [T] [(owner (Arc T))] (-> (Option T))
  (match (arc-try-unwrap owner)
    (Ok [value] (Some value))
    (Err [shared] (let [released shared] (None [T])))))

(defn arc-into-raw [T] [(owner (Arc T))] (-> (ptr T))
  (let [held (manually-drop owner)
        value (field (load (field (field held value) block)) value)]
    (forget held)
    value))

(defn unsafe-arc-from-raw [T] [(value (ptr T))] (-> (Arc T))
  (Arc :block (primitive/cast (ptr (ArcBlock T))
                              (primitive/isub (primitive/cast i64 value)
                                              (primitive/offsetof (ArcBlock T) value)))))

(impl [T] Clone (Arc T)
  (clone [(self (ref (Arc T)))] (-> (Arc T))
    (let [block (load (field self block))]
      (atomic/atomic-add (field block strong) 1)
      (Arc :block block))))

(impl [T] Drop (Arc T)
  (drop [(self (mut (Arc T)))] (-> void)
    (let [block (load (field self block))]
      (when (= (atomic/atomic-sub (field block strong) 1) 1)
        (let [value (take! [T] (field block value))] 0)
        (forget (arc-release-weak block))))))

(impl [T] Clone (Weak T)
  (clone [(self (ref (Weak T)))] (-> (Weak T))
    (let [block (load (field self block))]
      (atomic/atomic-add (field block weak) 1)
      (Weak :block block))))

(impl [T] Drop (Weak T)
  (drop [(self (mut (Weak T)))] (-> void)
    (forget (arc-release-weak (load (field self block))))))
