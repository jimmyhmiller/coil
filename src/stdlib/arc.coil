(module coil.arc)
(export Arc Weak
        ArcBlock)
(import "coil.primitive" :as primitive)
(import "coil.alloc" :as alloc)
(import "coil.atomic" :as atomic)
(import "coil.result" :use *)

; Thread-safe reference counting. Counts are sequentially consistent in the first
; implementation; weaker orderings require a separate measured correctness pass.
(defstruct ArcBlock [T]
  [(strong i64)
   (weak i64)  ; includes one implicit weak reference while strong > 0
   (lease alloc/AllocatorLease)
   (value T)])

(defstruct Arc [T] [(block (ptr (ArcBlock T)))])

(defstruct Weak [T] [(block (ptr (ArcBlock T)))])

(impl [T] (Arc T)
  ;;; A shared owner of `value`, allocated from `lease`, or None when the
  ;;; allocator is exhausted.
  (new-in [(lease alloc/AllocatorLease) (value T)] (-> (Option (Arc T)))
    (match (alloc/lease-raw-alloc lease
                                  (alloc/AllocRequest
                                    :type-id (alloc/type-id [(ArcBlock T)])
                                    :count 1
                                    :bytes (primitive/sizeof (ArcBlock T))
                                    :align (primitive/alignof (ArcBlock T))))
      (None []
            (let [failed-lease lease
                  failed-value value]
              (None [(Arc T)])))
      (Some [raw]
            (let [block (primitive/cast (ptr (ArcBlock T)) raw)
                  block-lease lease
                  block-value value]
              (atomic/store (field block strong) 1)
              (atomic/store (field block weak) 1)
              (store! (field block lease) block-lease)
              (store! (field block value) block-value)
              (Some (Arc :block block))))))

  ;;; `Arc::new-in` with the malloc allocator.
  (new [(value T)] (-> (Option (Arc T)))
    (Arc::new-in (alloc/malloc-allocator-lease) value))

  ;;; `Arc::new-in` for callers that cannot recover from an exhausted allocator: it
  ;;; aborts with a diagnostic instead of returning None, as `box!` does.
  (new-in! [(lease alloc/AllocatorLease) (value T)] (-> (Arc T))
    (match (Arc::new-in lease value)
      (Some [owner] owner)
      (None []
            (do
              (alloc/oom-at c"Arc::new-in!" (primitive/sizeof (ArcBlock T)))
              (Arc :block (primitive/cast (ptr (ArcBlock T)) 0))))))

  ;;; `Arc::new` that aborts on an exhausted allocator instead of returning None.
  (new! [(value T)] (-> (Arc T))
    (Arc::new-in! (alloc/malloc-allocator-lease) value))

  ;;; Adopt the strong reference `into-raw` gave up. Each pointer `into-raw`
  ;;; returned must be adopted exactly once.
  (from-raw-unsafe [(value (ptr T))] (-> (Arc T))
    (Arc :block
           (primitive/cast (ptr (ArcBlock T))
                           (primitive/isub (primitive/cast i64 value)
                                           (primitive/offsetof (ArcBlock T) value)))))

  (borrow [(owner (ref (Arc T)))] (-> (ptr T))
    (field (load (field owner block)) value))

  (strong-count [(owner (ref (Arc T)))] (-> i64)
    (atomic/read (field (load (field owner block)) strong)))

  (weak-count [(owner (ref (Arc T)))] (-> i64)
    (primitive/isub (atomic/read (field (load (field owner block)) weak))
                    1))

  ; Requiring the implicit weak to be the only weak prevents a concurrent upgrade
  ; from racing the uniqueness decision.
  (get-mut [(owner (mut (Arc T)))] (-> (Option (ptr T)))
    (let [block (load (field owner block))]
      (if (and (= (atomic/read (field block strong)) 1)
               (= (atomic/read (field block weak)) 1))
          (Some (field block value))
          (None [(ptr T)]))))

  (downgrade [(owner (ref (Arc T)))] (-> (Weak T))
    (let [block (load (field owner block))]
      (atomic/add (field block weak) 1)
      (Weak :block block)))

  (try-unwrap [(owner (Arc T))] (-> (Result T (Arc T)))
    (let [held (manually-drop owner)
          block (load (field (field held value) block))]
      ; CAS owns the unique 1 -> 0 transition. If another thread cloned first, the
      ; original handle is returned intact.
      (if (!= (atomic/cas (field block strong) 1 0) 1)
          (Err [T (Arc T)] (manually-drop-into-inner held))
          (let [value (take! [T] (field block value))]
            (forget (release-weak block))
            (forget held)
            (Ok [T (Arc T)] value)))))

  (into-inner [(owner (Arc T))] (-> (Option T))
    (match (try-unwrap owner)
      (Ok [value] (Some value))
      (Err [shared] (let [released shared] (None [T])))))

  (into-raw [(owner (Arc T))] (-> (ptr T))
    (let [held (manually-drop owner)
          value (field (load (field (field held value) block)) value)]
      (forget held)
      value)))

(impl [T] (Weak T)
  (upgrade [(owner (ref (Weak T)))] (-> (Option (Arc T)))
    (let [control (load (field owner block))
          (mut current) (atomic/read (field control strong))]
      (block :upgrade
             (loop (if (= (load current) 0)
                       (break :upgrade (None [(Arc T)]))
                       (let [observed
                               (atomic/cas (field control strong)
                                           (load current)
                                           (primitive/iadd (load current)
                                                           1))]
                         (if (= observed (load current))
                             (break :upgrade (Some (Arc :block control)))
                             (store! current observed)))))
             (None [(Arc T)])))))

(defn free-block [T] [(block (ptr (ArcBlock T)))] (-> i64)
  ; The moved-out lease remains live across deallocation, then releases its own
  ; allocator state only after the block that stored it is gone.
  (let [lease (take! [alloc/AllocatorLease] (field block lease))]
    (alloc/lease-raw-free lease
                          (primitive/cast (ptr i8) block)
                          (alloc/AllocRequest
                            :type-id (alloc/type-id [(ArcBlock T)])
                            :count 1
                            :bytes (primitive/sizeof (ArcBlock T))
                            :align (primitive/alignof (ArcBlock T))))))

(defn release-weak [T] [(block (ptr (ArcBlock T)))] (-> i64)
  (if (= (atomic/sub (field block weak) 1) 1)
      (free-block block)
      0))

(impl [T] Clone (Arc T)
  (clone [(self (ref (Arc T)))]
         (-> (Arc T))
         (let [block (load (field self block))]
           (atomic/add (field block strong) 1)
           (Arc :block block))))

(impl [T] Drop (Arc T)
  (drop [(self (mut (Arc T)))]
        (-> void)
        (let [block (load (field self block))]
          (when (= (atomic/sub (field block strong) 1) 1)
            (let [value (take! [T] (field block value))] 0)
            (forget (release-weak block))))))

(impl [T] Clone (Weak T)
  (clone [(self (ref (Weak T)))]
         (-> (Weak T))
         (let [block (load (field self block))]
           (atomic/add (field block weak) 1)
           (Weak :block block))))

(impl [T] Drop (Weak T)
  (drop [(self (mut (Weak T)))]
        (-> void)
        (forget (release-weak (load (field self block))))))
