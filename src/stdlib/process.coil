(module coil.process)
(import "coil.os" :as os)
(import "coil.subprocess" :reexport)

;; Current-process operations plus the child-process API re-exported from
;; `coil.subprocess`; both `process/id` and `process/Child` are valid.

;; Portable names for the small signal set used in ordinary process supervision.
(defsum Signal (Interrupt) (Hangup) (Terminate) (ForceKill))

(defn signal-number [(signal Signal)] (-> i32)
  (match signal
    (Interrupt [] 2)
    (Hangup [] 1)
    (Terminate [] 15)
    (ForceKill [] 9)))

;; Numeric identifier of the current process.
(defn id [] (-> i64)
  (cast i64 (os/getpid)))
;; Numeric identifier of the parent process.
(defn parent-id [] (-> i64)
  (cast i64 (os/getppid)))

;; Send a typed signal to a process. Success does not imply that the target has exited.
(defn send-signal [(pid i64) (signal Signal)] (-> (Result i64 os/OsError))
  (if (= (os/kill (cast i32 pid) (signal-number signal)) 0)
      (Ok 0)
      (Err (os/Syscall (os/os-errno)))))
