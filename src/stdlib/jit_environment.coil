;;; What a program hands a JIT session running inside it.
;;;
;;; An environment is Coil source: the program's types, generics and macros as
;;; written, a `defn` forwarding to the program's own function for each function
;;; it exposes, and a `def` for each piece of storage. A forwarding `defn` calls
;;; the program's function through its address, and a `Var` def holds the
;;; program's own cell, so the session reaches the real thing. The addresses are
;;; known only when the program runs, so the program builds the text then:
;;; `coil.meta`'s `embed-environment` adds a function that does, from the
;;; definitions marked `:jit/expose`. Nothing about the program is visible to a
;;; session unless a metaprogram puts it in this text.
(module coil.jit.environment)
(import "coil.alloc" :use [malloc-allocator box! destroy free])
(import "coil.str" :use [StrBuf sb-new sb-push-str! sb-push-i64! sb-finish!])

(export EnvironmentBuilder environment-new environment-text! environment-address!
        environment-finish environment-free!)

;;; Marks a function or `def` that a session running inside this program may use.
;;; A function is called through its address, so it must stay in the binary: the
;;; generated environment function names it, which keeps it at every optimization
;;; level. A `def` of type `Var` shares its cell with the session. Any other `def`
;;; is copied into the session as written, which is the same value because a plain
;;; `def` cannot change.
(defannotation :jit/expose bool)

;;; The text an environment function is building, one piece at a time. Each step
;;; returns the builder, so a generated function is one nested expression.
(defstruct EnvironmentBuilder [(text StrBuf)])

(defn environment-new [] (-> (ptr EnvironmentBuilder))
  (box! (malloc-allocator) EnvironmentBuilder
        (EnvironmentBuilder :text (sb-new (malloc-allocator)))))

;;; Append TEXT.
(defn environment-text! [(builder (ptr EnvironmentBuilder)) (text (slice u8))] (-> (ptr EnvironmentBuilder))
  (sb-push-str! (mut (field builder text)) text)
  builder)

;;; Append ADDRESS in decimal, the way source spells an integer.
(defn environment-address! [(builder (ptr EnvironmentBuilder)) (address (ptr i8))] (-> (ptr EnvironmentBuilder))
  (sb-push-i64! (mut (field builder text)) (cast i64 address))
  builder)

;;; The finished text, which the caller owns and releases with `environment-free!`.
(defn environment-finish [(builder (ptr EnvironmentBuilder))] (-> (slice u8))
  (let [text (sb-finish! (mut (field builder text)))]
    (destroy (malloc-allocator) builder)
    text))

(defn environment-free! [(text (slice u8))] (-> i64)
  (free [u8] (malloc-allocator) text))
