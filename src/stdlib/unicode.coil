(module coil.unicode)
(import "coil.alloc" :use [Allocator])
(import "coil.str" :as string :use [Rune String StringView Text])
(import "coil.unicode.data" :as data)

; Unicode character properties and simple case mapping for `Rune`s, from the
; tables in coil.unicode.data (generated from the Unicode Character Database by
; scripts/docs/gen-unicode-props.py). A lookup is three dependent table loads.
; This module is separate from coil.str so programs that never classify text do
; not carry the tables.
(export GeneralCategory
        UppercaseLetter
        LowercaseLetter
        TitlecaseLetter
        ModifierLetter
        OtherLetter
        NonspacingMark
        SpacingMark
        EnclosingMark
        DecimalNumber
        LetterNumber
        OtherNumber
        ConnectorPunctuation
        DashPunctuation
        OpenPunctuation
        ClosePunctuation
        InitialPunctuation
        FinalPunctuation
        OtherPunctuation
        MathSymbol
        CurrencySymbol
        ModifierSymbol
        OtherSymbol
        SpaceSeparator
        LineSeparator
        ParagraphSeparator
        Control
        Format
        Surrogate
        PrivateUse
        Unassigned
        unicode-version
        general-category
        general-category-abbrev
        letter?
        mark?
        number?
        decimal-digit?
        punctuation?
        symbol?
        control?
        alphabetic?
        numeric?
        alphanumeric?
        whitespace?
        uppercase?
        lowercase?
        to-lower
        to-upper
        to-title
        case-fold
        string-to-lower
        string-to-upper
        string-case-fold)

;;; A Unicode General_Category value (UAX #44).
(defsum GeneralCategory
  (UppercaseLetter)
  (LowercaseLetter)
  (TitlecaseLetter)
  (ModifierLetter)
  (OtherLetter)
  (NonspacingMark)
  (SpacingMark)
  (EnclosingMark)
  (DecimalNumber)
  (LetterNumber)
  (OtherNumber)
  (ConnectorPunctuation)
  (DashPunctuation)
  (OpenPunctuation)
  (ClosePunctuation)
  (InitialPunctuation)
  (FinalPunctuation)
  (OtherPunctuation)
  (MathSymbol)
  (CurrencySymbol)
  (ModifierSymbol)
  (OtherSymbol)
  (SpaceSeparator)
  (LineSeparator)
  (ParagraphSeparator)
  (Control)
  (Format)
  (Surrogate)
  (PrivateUse)
  (Unassigned))

(derive Debug Eq GeneralCategory)

;;; The Unicode version of the tables, such as "17.0.0".
(defn unicode-version [] (-> (slice u8))
  (data/unicode-version))

(defn rune-class [(r Rune)] (-> i64)
  (data/class-of (cast i64 (value r))))

(defn rune-props [(r Rune)] (-> i64)
  (data/class-props (rune-class r)))

(defn has-bit? [(r Rune) (bit i64)] (-> bool)
  (!= (& (rune-props r) bit) 0))

; The category index is the low five bits of the property word, in the order
; of `GeneralCategory` (and of data/category-abbrev).
(defn category-index [(r Rune)] (-> i64)
  (& (rune-props r) 31))

(defn category-from-index [(index i64)] (-> GeneralCategory)
  (case index 0
        (UppercaseLetter) 1
        (LowercaseLetter) 2
        (TitlecaseLetter) 3
        (ModifierLetter) 4
        (OtherLetter) 5
        (NonspacingMark) 6
        (SpacingMark) 7
        (EnclosingMark) 8
        (DecimalNumber) 9
        (LetterNumber) 10
        (OtherNumber) 11
        (ConnectorPunctuation) 12
        (DashPunctuation) 13
        (OpenPunctuation) 14
        (ClosePunctuation) 15
        (InitialPunctuation) 16
        (FinalPunctuation) 17
        (OtherPunctuation) 18
        (MathSymbol) 19
        (CurrencySymbol) 20
        (ModifierSymbol) 21
        (OtherSymbol) 22
        (SpaceSeparator) 23
        (LineSeparator) 24
        (ParagraphSeparator) 25
        (Control) 26
        (Format) 27
        (Surrogate) 28
        (PrivateUse) (Unassigned)))

;;; R's general category.
(defn general-category [(r Rune)] (-> GeneralCategory)
  (category-from-index (category-index r)))

;;; The two-letter UAX #44 abbreviation of CATEGORY, such as "Lu" or "Nd".
(defn general-category-abbrev [(category GeneralCategory)] (-> (slice u8))
  (match category
    (UppercaseLetter [] "Lu")
    (LowercaseLetter [] "Ll")
    (TitlecaseLetter [] "Lt")
    (ModifierLetter [] "Lm")
    (OtherLetter [] "Lo")
    (NonspacingMark [] "Mn")
    (SpacingMark [] "Mc")
    (EnclosingMark [] "Me")
    (DecimalNumber [] "Nd")
    (LetterNumber [] "Nl")
    (OtherNumber [] "No")
    (ConnectorPunctuation [] "Pc")
    (DashPunctuation [] "Pd")
    (OpenPunctuation [] "Ps")
    (ClosePunctuation [] "Pe")
    (InitialPunctuation [] "Pi")
    (FinalPunctuation [] "Pf")
    (OtherPunctuation [] "Po")
    (MathSymbol [] "Sm")
    (CurrencySymbol [] "Sc")
    (ModifierSymbol [] "Sk")
    (OtherSymbol [] "So")
    (SpaceSeparator [] "Zs")
    (LineSeparator [] "Zl")
    (ParagraphSeparator [] "Zp")
    (Control [] "Cc")
    (Format [] "Cf")
    (Surrogate [] "Cs")
    (PrivateUse [] "Co")
    (Unassigned [] "Cn")))

;;; True when R's general category is a letter (Lu, Ll, Lt, Lm or Lo).
(defn letter? [(r Rune)] (-> bool)
  (<= (category-index r) 4))

;;; True when R's general category is a mark (Mn, Mc or Me).
(defn mark? [(r Rune)] (-> bool)
  (let [i (category-index r)]
    (and (>= i 5) (<= i 7))))

;;; True when R's general category is a number (Nd, Nl or No).
(defn number? [(r Rune)] (-> bool)
  (let [i (category-index r)]
    (and (>= i 8) (<= i 10))))

;;; True when R is a decimal digit (general category Nd), in any script.
(defn decimal-digit? [(r Rune)] (-> bool)
  (= (category-index r) 8))

;;; True when R's general category is punctuation (Pc, Pd, Ps, Pe, Pi, Pf or Po).
(defn punctuation? [(r Rune)] (-> bool)
  (let [i (category-index r)]
    (and (>= i 11) (<= i 17))))

;;; True when R's general category is a symbol (Sm, Sc, Sk or So).
(defn symbol? [(r Rune)] (-> bool)
  (let [i (category-index r)]
    (and (>= i 18) (<= i 21))))

;;; True when R is a control character (general category Cc).
(defn control? [(r Rune)] (-> bool)
  (= (category-index r) 25))

;;; The Alphabetic property: letters, letter numbers such as Roman numerals, and
;;; the marks and other characters that behave as letters (Other_Alphabetic).
(defn alphabetic? [(r Rune)] (-> bool)
  (has-bit? r data/ALPHABETIC-BIT))

;;; The Numeric_Type property is not None: digits, and any character with a
;;; numeric value, including fractions, Roman numerals and CJK numerals.
(defn numeric? [(r Rune)] (-> bool)
  (has-bit? r data/NUMERIC-BIT))

;;; Alphabetic or numeric.
(defn alphanumeric? [(r Rune)] (-> bool)
  (has-bit? r (| data/ALPHABETIC-BIT data/NUMERIC-BIT)))

;;; The White_Space property: tab through carriage return, space, U+0085, no-break
;;; space and the other space separators, and the line and paragraph separators.
(defn whitespace? [(r Rune)] (-> bool)
  (has-bit? r data/WHITE-SPACE-BIT))

;;; The Uppercase property (Lu plus Other_Uppercase, such as circled capitals).
(defn uppercase? [(r Rune)] (-> bool)
  (has-bit? r data/UPPERCASE-BIT))

;;; The Lowercase property (Ll plus Other_Lowercase, such as ª and modifier
;;; letters).
(defn lowercase? [(r Rune)] (-> bool)
  (has-bit? r data/LOWERCASE-BIT))

(defn shift [(r Rune) (delta i64)] (-> Rune)
  (if (= delta 0)
      r
      (Rune :value (cast u32 (+ (cast i64 (value r)) delta)))))

;;; R's simple lowercase mapping, or R when it has none. Simple mappings are one
;;; code point to one code point; the multi-character mappings of
;;; SpecialCasing.txt (such as U+0130 to "i̇") are not applied.
(defn to-lower [(r Rune)] (-> Rune)
  (let [v (cast i64 (value r))]
    (if (< v 128)
        (if (and (>= v 65) (<= v 90)) (shift r 32) r)
        (shift r (data/class-lower-delta (rune-class r))))))

;;; R's simple uppercase mapping, or R when it has none (ß stays ß).
(defn to-upper [(r Rune)] (-> Rune)
  (let [v (cast i64 (value r))]
    (if (< v 128)
        (if (and (>= v 97) (<= v 122)) (shift r -32) r)
        (shift r (data/class-upper-delta (rune-class r))))))

;;; R's simple titlecase mapping: the uppercase mapping, except for digraphs
;;; such as U+01C6 (ǆ), whose titlecase form is U+01C5 (ǅ).
(defn to-title [(r Rune)] (-> Rune)
  (shift r (data/class-title-delta (rune-class r))))

;;; R's simple case folding (CaseFolding.txt statuses C and S), for caseless
;;; comparison: two runes match without regard to case when their foldings are
;;; equal. Folding mostly lowercases, but it also unifies variants such as
;;; ſ (long s) and s, or the Cherokee small letters with their capitals.
(defn case-fold [(r Rune)] (-> Rune)
  (let [v (cast i64 (value r))]
    (if (< v 128)
        (if (and (>= v 65) (<= v 90)) (shift r 32) r)
        (shift r (data/class-fold-delta (rune-class r))))))

(defsum CaseMap (Lower) (Upper) (Fold))

(defn map-runes [(T Text)] [(a (dyn Allocator)) (text T) (mapping CaseMap)] (-> String)
  (let [view (as-string-view text)
        (mut out) (string/String::new a)]
    (reserve! (mut out) (byte-len view))
    (for r
      view
      (push! (mut out)
             (match mapping
               (Lower [] (to-lower r))
               (Upper [] (to-upper r))
               (Fold [] (case-fold r)))))
    out))

;;; A new String holding TEXT with every rune's simple lowercase mapping.
;;; Mappings can change a rune's UTF-8 length, so byte lengths may differ.
(defn string-to-lower [(T Text)] [(a (dyn Allocator)) (text T)] (-> String)
  (map-runes a text (Lower)))

;;; A new String holding TEXT with every rune's simple uppercase mapping.
(defn string-to-upper [(T Text)] [(a (dyn Allocator)) (text T)] (-> String)
  (map-runes a text (Upper)))

;;; A new String holding TEXT with every rune's simple case folding. Two texts
;;; match without regard to case when their foldings are equal.
(defn string-case-fold [(T Text)] [(a (dyn Allocator)) (text T)] (-> String)
  (map-runes a text (Fold)))
