(module coil.region)
(import "coil.primitive" :as primitive)
(import "coil.alloc" :as alloc)

(export Region
        RegionError
        AlreadyClosed
        region-init
        region-new
        region-allocator
        region-close!
        region-closed?
        region-ownership-probes)

;; A thread-confined allocation scope. Every live allocation is tracked with its
;; exact size and alignment, so individual free/resize and deterministic bulk close
;; all preserve the parent allocator's contract. Synchronize externally when sharing.
(defsum RegionError (AlreadyClosed) (OutOfMemory))

(defstruct RegionNode
  [(next (ptr RegionNode))
   (previous (ptr RegionNode))
   (data (ptr i8))
   (size i64)
   (align i64)])

(defstruct Region
  [(parent (ptr alloc/Allocator))
   (head (ptr RegionNode))
   ;; Open-addressing registry: exact user pointer -> RegionNode. Empty slots are
   ;; null. Removal uses backward-shift deletion, so lookup remains valid without
   ;; tombstones and individual free/resize is expected O(1).
   (registry (ptr (ptr RegionNode)))
   (registry-cap i64)
   (registry-len i64)
   (ownership-probes i64)
   (allocator alloc/Allocator)
   (closed bool)])

(defn region-hash [(data (ptr i8))] (-> i64)
  ;; Allocation alignment leaves the low bits uninteresting. Mix the address before
  ;; masking so sequential allocations do not form long clusters.
  (let [x (primitive/udiv (primitive/cast i64 data) 8)]
    (primitive/ixor x (primitive/ishr x 17))))

(defn region-registry-slot [(region (ptr Region)) (data (ptr i8))] (-> i64)
  (let [cap (load (field region registry-cap))
        (mut i) (primitive/iand (region-hash data) (primitive/isub cap 1))]
    (block :found
           (loop (store! (field region ownership-probes)
                         (primitive/iadd (load (field region ownership-probes)) 1))
             (let [node (load (primitive/index (load (field region registry)) (load i)))]
               (if (or (= (primitive/cast i64 node) 0)
                       (= (load (field node data)) data))
                   (return-from :found (load i))
                   (store! i
                           (primitive/iand (primitive/iadd (load i) 1)
                                           (primitive/isub cap 1))))))
           0)))

(defn region-find [(region (ptr Region)) (data (ptr i8))] (-> (ptr RegionNode))
  (if (= (load (field region registry-cap)) 0)
      (primitive/cast (ptr RegionNode) 0)
      (load (primitive/index (load (field region registry))
                             (region-registry-slot region data)))))

(defn region-registry-insert-raw! [(slots (ptr (ptr RegionNode)))
                                   (cap i64)
                                   (node (ptr RegionNode))] (-> i64)
  (let [(mut i)
          (primitive/iand (region-hash (load (field node data)))
                          (primitive/isub cap 1))]
    (loop (if (= (primitive/cast i64 (load (primitive/index slots (load i)))) 0)
              (do (store! (primitive/index slots (load i)) node) (break))
              (store! i
                      (primitive/iand (primitive/iadd (load i) 1)
                                      (primitive/isub cap 1)))))
    0))

(defn region-registry-rehash! [(region (ptr Region))
                               (slots (ptr (ptr RegionNode)))
                               (cap i64)] (-> i64)
  (let [(mut node) (load (field region head))]
    (loop (if (= (primitive/cast i64 (load node)) 0)
              (break)
              (do
                (region-registry-insert-raw! slots cap (load node))
                (store! node (load (field (load node) next))))))
    0))

;; Ensure one more registry entry fits. Returns false on OOM without changing the
;; existing table, allowing region allocation to retain its Option-based failure API.
(defn region-registry-reserve-one! [(region (ptr Region))] (-> bool)
  (let [oldcap (load (field region registry-cap))
        wanted (if (= oldcap 0) 16 (primitive/imul oldcap 2))]
    (if (and (!= oldcap 0)
             (< (primitive/imul (primitive/iadd (load (field region registry-len)) 1) 4)
                (primitive/imul oldcap 3)))
        true
        (match (alloc/alloc-slice [(ptr RegionNode)] (load (field region parent)) wanted)
          (None [] false)
          (Some [slots]
                (do
                  (let [(mut i) 0]
                    (loop (if (>= (load i) wanted)
                              (break)
                              (do
                                (store! (primitive/index slots (load i))
                                        (primitive/cast (ptr RegionNode) 0))
                                (store! i (primitive/iadd (load i) 1))))))
                  (region-registry-rehash! region slots wanted)
                  (when (!= oldcap 0)
                    (alloc/raw-free (load (field region parent))
                                    (primitive/cast (ptr i8) (load (field region registry)))
                                    (primitive/imul oldcap (primitive/sizeof (ptr RegionNode)))
                                    (primitive/alignof (ptr RegionNode))))
                  (store! (field region registry) slots)
                  (store! (field region registry-cap) wanted)
                  true))))))

(defn region-registry-insert! [(region (ptr Region)) (node (ptr RegionNode))] (-> i64)
  (region-registry-insert-raw! (load (field region registry))
                               (load (field region registry-cap))
                               node)
  (store! (field region registry-len)
          (primitive/iadd (load (field region registry-len)) 1))
  0)

;; Backward-shift deletion for a linear-probing table. Reinsert the following cluster
;; into the newly empty table; no allocation is involved.
(defn region-registry-remove! [(region (ptr Region)) (data (ptr i8))] (-> i64)
  (let [slots (load (field region registry))
        cap (load (field region registry-cap))
        at (region-registry-slot region data)]
    (store! (primitive/index slots at) (primitive/cast (ptr RegionNode) 0))
    (let [(mut i) (primitive/iand (primitive/iadd at 1) (primitive/isub cap 1))]
      (loop (let [node (load (primitive/index slots (load i)))]
              (if (= (primitive/cast i64 node) 0)
                  (break)
                  (do
                    (store! (primitive/index slots (load i))
                            (primitive/cast (ptr RegionNode) 0))
                    (region-registry-insert-raw! slots cap node)
                    (store! i
                            (primitive/iand (primitive/iadd (load i) 1)
                                            (primitive/isub cap 1))))))))
    (store! (field region registry-len)
            (primitive/isub (load (field region registry-len)) 1))
    0))

(defn dbg-region-parent-check [(parent Code)] (-> Code)
  (if (primitive/debug-checks?)
      `(if (= (primitive/cast i64
                              (primitive/cast (ptr i8) (load (field ~parent free))))
              (primitive/cast i64
                              (primitive/cast (ptr i8) (primitive/fnptr-of region-free-hook))))
           (do
             (alloc/oom-puts c"coil: Region is backed by another Region allocator; use a root allocator or coil.scratch marks (--debug-checks)\n")
             0)
           0)
      `0))

(defn region-alloc-hook [(ctx (ptr i8)) (size i64) (align i64)] (-> (Option (ptr i8)))
  (let [region (primitive/cast (ptr Region) ctx)]
    (if (load (field region closed))
        (None)
        (if (not (region-registry-reserve-one! region))
            (None)
            (match (alloc/raw-alloc (load (field region parent)) size align)
              (None [] (None))
              (Some [data]
                    (match (alloc/create [RegionNode] (load (field region parent)))
                      (None []
                            (do
                              (alloc/raw-free (load (field region parent)) data size align)
                              (None)))
                      (Some [node]
                            (do
                              (store! (field node next) (load (field region head)))
                              (store! (field node previous) (primitive/cast (ptr RegionNode) 0))
                              (when (!= (primitive/cast i64 (load (field region head))) 0)
                                (store! (field (load (field region head)) previous) node))
                              (store! (field node data) data)
                              (store! (field node size) size)
                              (store! (field node align) align)
                              (store! (field region head) node)
                              (region-registry-insert! region node)
                              (Some data))))))))))

(defn region-resize-hook [(ctx (ptr i8))
                          (data (ptr i8))
                          (old i64)
                          (new i64)
                          (align i64)] (-> (Option (ptr i8)))
  (let [region (primitive/cast (ptr Region) ctx)]
    (if (load (field region closed))
        (None)
        ;; Allocator clients conventionally express their first allocation as a
        ;; zero-size resize of null. There cannot be an owned node to find in that
        ;; case, and scanning the region would make repeated collection creation
        ;; quadratic in the number of live allocations.
        (if (or (= old 0) (= data (primitive/cast (ptr i8) 0)))
            (region-alloc-hook ctx new align)
            (let [node (region-find region data)]
              (if (= (primitive/cast i64 node) 0)
                  (None)
                  (if (or (!= old (load (field node size))) (!= align (load (field node align))))
                      (None)
                      (match (alloc/raw-resize (load (field region parent)) data old new align)
                        (None [] (None))
                        (Some [resized]
                              (do
                                (when (!= resized data)
                                  (region-registry-remove! region data))
                                (store! (field node data) resized)
                                (store! (field node size) new)
                                (when (!= resized data)
                                  (region-registry-insert! region node))
                                (Some resized)))))))))))

(defn region-free-hook [(ctx (ptr i8)) (data (ptr i8)) (size i64) (align i64)] (-> i64)
  (let [region (primitive/cast (ptr Region) ctx)
        node (region-find region data)]
    (when (!= (primitive/cast i64 node) 0)
      (let [previous (load (field node previous))
            next (load (field node next))]
        (if (= (primitive/cast i64 previous) 0)
            (store! (field region head) next)
            (store! (field previous next) next))
        (when (!= (primitive/cast i64 next) 0)
          (store! (field next previous) previous))
        (region-registry-remove! region data)
        (alloc/raw-free (load (field region parent))
                        data
                        (load (field node size))
                        (load (field node align)))
        (alloc/destroy (load (field region parent)) node)))
    0))

;; Initialize caller-owned region storage.
(defn region-init [(region (ptr Region)) (parent (ptr alloc/Allocator))] (-> (ptr Region))
  (dbg-region-parent-check parent)
  (store! (field region parent) parent)
  (store! (field region head) (primitive/cast (ptr RegionNode) 0))
  (store! (field region registry) (primitive/cast (ptr (ptr RegionNode)) 0))
  (store! (field region registry-cap) 0)
  (store! (field region registry-len) 0)
  (store! (field region ownership-probes) 0)
  (store! (field region closed) false)
  (store! (field (field region allocator) alloc) (primitive/fnptr-of region-alloc-hook))
  (store! (field (field region allocator) resize) (primitive/fnptr-of region-resize-hook))
  (store! (field (field region allocator) free) (primitive/fnptr-of region-free-hook))
  (store! (field (field region allocator) ctx) (primitive/cast (ptr i8) region))
  region)

;; Allocate the Region object from `parent`; its allocations still require close.
(defn region-new [(parent (ptr alloc/Allocator))] (-> (Option (ptr Region)))
  (match (alloc/create [Region] parent)
    (None [] (None))
    (Some [region] (Some (region-init region parent)))))

(defn region-allocator [(region (ptr Region))] (-> (ptr alloc/Allocator))
  (field region allocator))

(defn region-closed? [(region (ptr Region))] (-> bool)
  (load (field region closed)))

;; Deterministic observability for allocator diagnostics and complexity regression
;; tests. Counts exact registry slots inspected by free/resize ownership lookup.
(defn region-ownership-probes [(region (ptr Region))] (-> i64)
  (load (field region ownership-probes)))

;; Release every still-live allocation. Idempotent; the Region object itself remains
;; caller-owned so code can safely observe that it is closed.
(defn region-close! [(region (ptr Region))] (-> i64)
  (unless (load (field region closed))
    (let [(mut node) (load (field region head))]
      (loop (if (= (primitive/cast i64 (load node)) 0)
                (break)
                (let [next (load (field (load node) next))]
                  (alloc/raw-free (load (field region parent))
                                  (load (field (load node) data))
                                  (load (field (load node) size))
                                  (load (field (load node) align)))
                  (alloc/destroy (load (field region parent)) (load node))
                  (store! node next))))
      (store! (field region head) (primitive/cast (ptr RegionNode) 0))
      (when (!= (load (field region registry-cap)) 0)
        (alloc/raw-free (load (field region parent))
                        (primitive/cast (ptr i8) (load (field region registry)))
                        (primitive/imul (load (field region registry-cap))
                                        (primitive/sizeof (ptr RegionNode)))
                        (primitive/alignof (ptr RegionNode))))
      (store! (field region registry) (primitive/cast (ptr (ptr RegionNode)) 0))
      (store! (field region registry-cap) 0)
      (store! (field region registry-len) 0)
      (store! (field region closed) true)))
  0)
