(module coil.region)
(import "coil.primitive" :as primitive)
(import "coil.io" :as io)
(import "coil.fmt" :use [fmt Display display-fmt Formatter formatter-writer])
(import "coil.alloc" :as alloc)

(export Region RegionError AlreadyClosed)

;;; A thread-confined allocation scope. Every live allocation is tracked with its
;;; exact size and alignment, so individual free/resize and deterministic bulk close
;;; all preserve the parent allocator's contract. Synchronize externally when sharing.
(defsum RegionError (AlreadyClosed) (OutOfMemory))

(derive Eq RegionError)

;;; `{}` is a message for a person.
(impl Display RegionError
  (display-fmt [(e RegionError) (f (ptr Formatter))] (-> i64)
    (let [w (formatter-writer f)]
      (match e
        (AlreadyClosed [] (io/print-str w "region already closed"))
        (OutOfMemory [] (io/print-str w "out of memory"))))
    0))

(defstruct RegionNode
  [(next (ptr RegionNode))
   (previous (ptr RegionNode))
   (data (ptr i8))
   (request alloc/AllocRequest)])

(defstruct Region
  [(parent (dyn alloc/Allocator))
   (head (ptr RegionNode))
   ;; Open-addressing registry: exact user pointer -> RegionNode. Empty slots are
   ;; null. Removal uses backward-shift deletion, so lookup remains valid without
   ;; tombstones and individual free/resize is expected O(1).
   (registry (ptr (ptr RegionNode)))
   (registry-cap i64)
   (registry-len i64)
   (ownership-probes i64)
   (closed bool)])

(defn request-eq [(a alloc/AllocRequest) (b alloc/AllocRequest)] (-> bool)
  (and (= (load (field a type-id)) (load (field b type-id)))
       (and (= (load (field a count)) (load (field b count)))
            (and (= (load (field a bytes)) (load (field b bytes)))
                 (= (load (field a align)) (load (field b align)))))))

;;; murmur3's fmix64 finalizer over the address. Heap addresses share their high
;;; bits and are strided by size class in the low ones, and linear probing punishes
;;; any structure that survives into the masked bits: a single xor-shift left
;;; clusters thousands of slots long at 40% load. Every address bit must reach every
;;; slot bit. Shifts are on u64 so they lower to logical shifts.
(defn address-hash [(data (ptr i8))] (-> i64)
  (let [k0 (primitive/cast u64 (primitive/cast i64 data))
        k1
          (primitive/imul (primitive/ixor k0
                                          (primitive/ishr k0
                                                          (primitive/cast u64
                                                                          33)))
                          (primitive/cast u64 -49064778989728563))
        k2
          (primitive/imul (primitive/ixor k1
                                          (primitive/ishr k1
                                                          (primitive/cast u64
                                                                          33)))
                          (primitive/cast u64 -4265267296055464877))]
    (primitive/cast i64
                    (primitive/ixor k2
                                    (primitive/ishr k2
                                                    (primitive/cast u64 33))))))

(defn registry-home [(cap i64) (data (ptr i8))] (-> i64)
  (primitive/iand (address-hash data) (primitive/isub cap 1)))

(defn registry-slot [(region (ptr Region)) (data (ptr i8))] (-> i64)
  (let [cap (load (field region registry-cap))
        (mut i) (registry-home cap data)]
    (block :found
           (loop (store! (field region ownership-probes)
                         (primitive/iadd (load (field region ownership-probes))
                                         1))
             (let [node
                     (load (primitive/index (load (field region registry))
                                            (load i)))]
               (if (or (= (primitive/cast i64 node) 0)
                       (= (load (field node data)) data))
                   (return-from :found (load i))
                   (store! i
                           (primitive/iand (primitive/iadd (load i) 1)
                                           (primitive/isub cap 1))))))
           0)))

(defn find-node [(region (ptr Region)) (data (ptr i8))] (-> (ptr RegionNode))
  (if (= (load (field region registry-cap)) 0)
      (primitive/cast (ptr RegionNode) 0)
      (load (primitive/index (load (field region registry))
                             (registry-slot region data)))))

(defn count-probes! [(region (ptr Region)) (n i64)] (-> i64)
  (store! (field region ownership-probes)
          (primitive/iadd (load (field region ownership-probes)) n))
  0)

;;; Returns the number of slots inspected.
(defn registry-insert-raw! [(slots (ptr (ptr RegionNode)))
                            (cap i64)
                            (node (ptr RegionNode))] (-> i64)
  (let [(mut i) (registry-home cap (load (field node data)))
        (mut probes) 1]
    (loop (if (= (primitive/cast i64 (load (primitive/index slots (load i)))) 0)
              (do (store! (primitive/index slots (load i)) node) (break))
              (do
                (store! i
                        (primitive/iand (primitive/iadd (load i) 1)
                                        (primitive/isub cap 1)))
                (store! probes (primitive/iadd (load probes) 1)))))
    (load probes)))

(defn registry-rehash! [(region (ptr Region))
                        (slots (ptr (ptr RegionNode)))
                        (cap i64)] (-> i64)
  (let [(mut node) (load (field region head))]
    (loop (if (= (primitive/cast i64 (load node)) 0)
              (break)
              (do
                (count-probes! region
                               (registry-insert-raw! slots
                                                     cap
                                                     (load node)))
                (store! node (load (field (load node) next))))))
    0))

;;; Ensure one more registry entry fits. Returns false on OOM without changing the
;;; existing table, allowing region allocation to retain its Option-based failure API.
(defn registry-reserve-one! [(region (ptr Region))] (-> bool)
  (let [oldcap (load (field region registry-cap))
        wanted (if (= oldcap 0) 16 (primitive/imul oldcap 2))]
    (if (and (!= oldcap 0)
             (< (primitive/imul (primitive/iadd (load (field region
                                                             registry-len))
                                                1)
                                4)
                (primitive/imul oldcap 3)))
        true
        (match (alloc/alloc-bytes (load (field region parent))
                                  (primitive/imul wanted
                                                  (primitive/sizeof (ptr RegionNode)))
                                  (primitive/alignof (ptr RegionNode)))
          (None [] false)
          (Some [storage]
                (do
                  (let [slots
                          (primitive/cast (ptr (ptr RegionNode))
                                          (data storage))]
                    (do
                      (let [(mut i) 0]
                        (loop (if (>= (load i) wanted)
                                  (break)
                                  (do
                                    (store! (primitive/index slots (load i))
                                            (primitive/cast (ptr RegionNode) 0))
                                    (store! i (primitive/iadd (load i) 1))))))
                      (registry-rehash! region slots wanted)
                      (when (!= oldcap 0)
                        (alloc/raw-free (load (field region parent))
                                        (primitive/cast (ptr i8)
                                                        (load (field region
                                                                     registry)))
                                        (alloc/AllocRequest
                                          :type-id 0
                                          :count
                                            (primitive/imul oldcap
                                                            (primitive/sizeof (ptr RegionNode)))
                                          :bytes
                                            (primitive/imul oldcap
                                                            (primitive/sizeof (ptr RegionNode)))
                                          :align
                                            (primitive/alignof (ptr RegionNode))))))
                    (store! (field region registry) slots)
                    (store! (field region registry-cap) wanted)
                    true)))))))

(defn registry-insert! [(region (ptr Region)) (node (ptr RegionNode))] (-> i64)
  (count-probes! region
                 (registry-insert-raw! (load (field region
                                                    registry))
                                       (load (field region
                                                    registry-cap))
                                       node))
  (store! (field region registry-len)
          (primitive/iadd (load (field region registry-len)) 1))
  0)

;;; Whether `x` lies in the cyclic interval (lo, hi] of the slot ring.
(defn registry-cyclic-in? [(x i64) (lo i64) (hi i64)] (-> bool)
  (if (<= lo hi)
      (and (< lo x) (<= x hi))
      (or (< lo x) (<= x hi))))

;;; Backward-shift deletion for a linear-probing table (Knuth's Algorithm R). Walk the
;;; rest of the cluster once; an entry moves into the hole unless its home lies
;;; cyclically in (hole, entry], where the hole would sit before its probe start.
;;; One home computation per entry, so removal is linear in the cluster tail.
(defn registry-remove! [(region (ptr Region)) (data (ptr i8))] (-> i64)
  (let [slots (load (field region registry))
        cap (load (field region registry-cap))
        (mut hole) (registry-slot region data)
        (mut i)
          (primitive/iand (primitive/iadd (load hole) 1)
                          (primitive/isub cap 1))
        (mut probes) 0]
    (store! (primitive/index slots (load hole))
            (primitive/cast (ptr RegionNode) 0))
    (loop (let [node (load (primitive/index slots (load i)))]
            (store! probes (primitive/iadd (load probes) 1))
            (if (= (primitive/cast i64 node) 0)
                (break)
                (do
                  (unless (registry-cyclic-in? (registry-home cap
                                                              (load (field node
                                                                           data)))
                                               (load hole)
                                               (load i))
                    (store! (primitive/index slots (load hole)) node)
                    (store! (primitive/index slots (load i))
                            (primitive/cast (ptr RegionNode) 0))
                    (store! hole (load i)))
                  (store! i
                          (primitive/iand (primitive/iadd (load i) 1)
                                          (primitive/isub cap 1)))))))
    (count-probes! region (load probes))
    (store! (field region registry-len)
            (primitive/isub (load (field region registry-len)) 1))
    0))

(defn allocate-tracked [(region (ptr Region)) (request alloc/AllocRequest)] (-> (Option (ptr i8)))
  (if (load (field region closed))
      (None)
      (if (not (registry-reserve-one! region))
          (None)
          (match (alloc/raw-alloc (load (field region parent)) request)
            (None [] (None))
            (Some [block]
                  (match (alloc/alloc-bytes (load (field region parent))
                                            (primitive/sizeof RegionNode)
                                            (primitive/alignof RegionNode))
                    (None []
                          (do
                            (alloc/raw-free (load (field region parent))
                                            block
                                            request)
                            (None)))
                    (Some [node-storage]
                          (do
                            (let [node
                                    (primitive/cast (ptr RegionNode)
                                                    (data node-storage))]
                              (do
                                (store! (field node next)
                                        (load (field region head)))
                                (store! (field node previous)
                                        (primitive/cast (ptr RegionNode) 0))
                                (when (!= (primitive/cast i64
                                                          (load (field region
                                                                       head)))
                                          0)
                                  (store! (field (load (field region head))
                                                 previous)
                                          node))
                                (store! (field node data) block)
                                (store! (field node request) request)
                                (store! (field region head) node)
                                (registry-insert! region node)
                                (Some block)))))))))))

(defn resize-tracked [(region (ptr Region))
                      (data (ptr i8))
                      (old alloc/AllocRequest)
                      (new alloc/AllocRequest)] (-> bool)
  (if (load (field region closed))
      false
      ;; Allocator clients conventionally express their first allocation as a
      ;; zero-size resize of null. There cannot be an owned node to find in that
      ;; case, and scanning the region would make repeated collection creation
      ;; quadratic in the number of live allocations.
      (let [node (find-node region data)]
        (if (= (primitive/cast i64 node) 0)
            false
            (if (and (request-eq old (load (field node request)))
                     (alloc/raw-resize (load (field region parent))
                                       data
                                       old
                                       new))
                (do (store! (field node request) new) true)
                false)))))

(defn remap-tracked [(region (ptr Region))
                     (data (ptr i8))
                     (old alloc/AllocRequest)
                     (new alloc/AllocRequest)] (-> (Option (ptr i8)))
  (if (load (field region closed))
      (None)
      (let [node (find-node region data)]
        (if (= (primitive/cast i64 node) 0)
            (None)
            (if (not (request-eq old (load (field node request))))
                (None)
                (match (alloc/raw-remap (load (field region parent))
                                        data
                                        old
                                        new)
                  (None [] (None))
                  (Some [resized]
                        (do
                          (when (!= resized data)
                            (registry-remove! region data))
                          (store! (field node data) resized)
                          (store! (field node request) new)
                          (when (!= resized data)
                            (registry-insert! region node))
                          (Some resized)))))))))

(defn free-tracked [(region (ptr Region))
                    (data (ptr i8))
                    (request alloc/AllocRequest)] (-> i64)
  (let [node (find-node region data)]
    (when (and (!= (primitive/cast i64 node) 0)
               (request-eq request (load (field node request))))
      (let [previous (load (field node previous))
            next (load (field node next))]
        (if (= (primitive/cast i64 previous) 0)
            (store! (field region head) next)
            (store! (field previous next) next))
        (when (!= (primitive/cast i64 next) 0)
          (store! (field next previous) previous))
        (registry-remove! region data)
        (alloc/raw-free (load (field region parent))
                        data
                        (load (field node request)))
        (alloc/free-bytes (load (field region parent))
                          (slice::new [u8]
                                      (primitive/cast (ptr u8) node)
                                      (primitive/sizeof RegionNode))
                          (primitive/alignof RegionNode))))
    0))

(impl alloc/Allocator Region
  (allocate [(self (ptr Region)) (request (ref alloc/AllocRequest))]
            (-> (Option (ptr i8)))
            (allocate-tracked self request))
  (resize [(self (ptr Region))
           (memory (ptr i8))
           (old (ref alloc/AllocRequest))
           (new (ref alloc/AllocRequest))]
          (-> bool)
          (resize-tracked self memory old new))
  (remap [(self (ptr Region))
          (memory (ptr i8))
          (old (ref alloc/AllocRequest))
          (new (ref alloc/AllocRequest))]
         (-> (Option (ptr i8)))
         (remap-tracked self memory old new))
  (deallocate [(self (ptr Region))
               (memory (ptr i8))
               (request (ref alloc/AllocRequest))]
              (-> i64)
              (free-tracked self memory request)))

;;; `Region::new` allocates a region from its parent and `Region::init` sets up
;;; storage the caller owns; allocate through its `allocator`, and `close!` it to
;;; release whatever is still live.
(impl Region
  ;;; Initialize caller-owned region storage.
  (init [(region (ptr Region)) (parent (dyn alloc/Allocator))] (-> (ptr Region))
    (store! (field region parent) parent)
    (store! (field region head) (primitive/cast (ptr RegionNode) 0))
    (store! (field region registry) (primitive/cast (ptr (ptr RegionNode)) 0))
    (store! (field region registry-cap) 0)
    (store! (field region registry-len) 0)
    (store! (field region ownership-probes) 0)
    (store! (field region closed) false)
    region)

  ;;; Allocate the Region object from `parent`; its allocations still require close.
  (new [(parent (dyn alloc/Allocator))] (-> (Option (ptr Region)))
    (match (alloc/alloc-bytes parent
                              (primitive/sizeof Region)
                              (primitive/alignof Region))
      (None [] (None))
      (Some [storage]
            (Some (Region::init (primitive/cast (ptr Region) (data storage))
                               parent)))))

  (allocator [(region (ptr Region))] (-> (dyn alloc/Allocator))
    (primitive/make-dyn alloc/Allocator region))

  (closed? [(region (ptr Region))] (-> bool)
    (load (field region closed)))

  ;;; Deterministic observability for allocator diagnostics and complexity regression
  ;;; tests. Counts every registry slot inspected: ownership lookup, insertion,
  ;;; rehashing on growth, and the backward shift after removal.
  (ownership-probes [(region (ptr Region))] (-> i64)
    (load (field region ownership-probes)))

  ;;; Release every still-live allocation. Idempotent; the Region object itself remains
  ;;; caller-owned so code can safely observe that it is closed.
  (close! [(region (ptr Region))] (-> i64)
    (unless (load (field region closed))
      (let [(mut node) (load (field region head))]
        (loop (if (= (primitive/cast i64 (load node)) 0)
                  (break)
                  (let [next (load (field (load node) next))]
                    (alloc/raw-free (load (field region parent))
                                    (load (field (load node) data))
                                    (load (field (load node) request)))
                    (alloc/free-bytes (load (field region parent))
                                      (slice::new [u8]
                                                  (primitive/cast (ptr u8)
                                                                  (load node))
                                                  (primitive/sizeof RegionNode))
                                      (primitive/alignof RegionNode))
                    (store! node next))))
        (store! (field region head) (primitive/cast (ptr RegionNode) 0))
        (when (!= (load (field region registry-cap)) 0)
          (alloc/raw-free (load (field region parent))
                          (primitive/cast (ptr i8) (load (field region registry)))
                          (alloc/AllocRequest
                            :type-id 0
                            :count
                              (primitive/imul (load (field region registry-cap))
                                              (primitive/sizeof (ptr RegionNode)))
                            :bytes
                              (primitive/imul (load (field region registry-cap))
                                              (primitive/sizeof (ptr RegionNode)))
                            :align (primitive/alignof (ptr RegionNode)))))
        (store! (field region registry) (primitive/cast (ptr (ptr RegionNode)) 0))
        (store! (field region registry-cap) 0)
        (store! (field region registry-len) 0)
        (store! (field region closed) true)))
    0))
