(module coil.regex)
(import "coil.primitive" :as primitive)
(import "coil.slice" :as slice)
(import "coil.mem" :as mem)

; Ahead-of-time byte regular expressions. `is-match?` is a macro: it parses and
; compiles its pattern while the caller is compiled, then emits an allocation-free
; bit-parallel Thompson state machine. The runtime program contains no parser,
; allocator, or regex object.
;
; This first engine deliberately has a hard 63-state limit. A limit is preferable
; to a hidden slow path: every accepted expression is represented by one machine
; word and has the same bounded-memory, linear-time runtime contract.
;
; The compile-time helpers intentionally use metal integer operations. Macro
; closures are pruned and carry no trait implementations, so clean operators in
; this layer would make `is-match?` unstaggable inside another macro body.
(export is-match?)

; Compile-time-only mutable storage. State opcodes are:
;   0 byte class, 1 split/epsilon, 2 accepting match.
; A byte class is four 64-bit masks. Patch records name an unresolved out edge.
(defn rx--mem [(c (mut (array i64 1280))) (i i64)] (-> i64)
  (primitive/load (primitive/index c i)))

(defn rx--put [(c (mut (array i64 1280))) (i i64) (v i64)] (-> i64)
  (primitive/store! (primitive/index c i) v)
  0)

; A fragment packs its start state and patch-list head into one i64. State and
; patch indices are non-negative; +1 reserves zero for the empty patch list.
(defn rx--frag [(start i64) (outs i64)] (-> i64)
  (primitive/ior start (primitive/ishl (primitive/iadd outs 1) 8)))

(defn rx--frag-start [(f i64)] (-> i64)
  (primitive/iand f 255))

(defn rx--frag-outs [(f i64)] (-> i64)
  (primitive/isub (primitive/ishr f 8) 1))

(defn rx--backslash-count [(bytes Code) (i i64) (count i64)] (-> i64)
  (if (primitive/icmp-lt i 0)
      count
      (if (primitive/icmp-eq (primitive/code-int (primitive/code-nth bytes i)) 92)
          (rx--backslash-count bytes (primitive/isub i 1) (primitive/iadd count 1))
          count)))

(defn rx--escaped-at? [(bytes Code) (i i64)] (-> bool)
  (not (primitive/icmp-eq (primitive/irem (rx--backslash-count bytes (primitive/isub i 1) 0) 2)
                          0)))

; Return the decoded literal bytes, or :not-literal when the expression needs
; the Thompson compiler. Keeping this recognizer separate from the full parser
; makes the fastest and most common regex shape compile to a plain search loop.
(defn rx--literal-bytes [(bytes Code) (i i64) (end i64) (out CodeBuilder)] (-> Code)
  (if (primitive/icmp-ge i end)
      (primitive/code-list-done out)
      (let [b (primitive/code-int (primitive/code-nth bytes i))]
        (if (primitive/icmp-eq b 92)
            (if (primitive/icmp-ge (primitive/iadd i 1) end)
                (primitive/error "regex: trailing escape")
                (let [e (primitive/code-int (primitive/code-nth bytes (primitive/iadd i 1)))]
                  (if (or (primitive/icmp-eq e 100)
                          (primitive/icmp-eq e 119)
                          (primitive/icmp-eq e 115))
                      `:not-literal
                      (do
                        (primitive/code-list-push! out `~(rx--escaped-byte e))
                        (rx--literal-bytes bytes (primitive/iadd i 2) end out)))))
            (if (or (primitive/icmp-eq b 46)
                    (primitive/icmp-eq b 91)
                    (primitive/icmp-eq b 40)
                    (primitive/icmp-eq b 41)
                    (primitive/icmp-eq b 124)
                    (primitive/icmp-eq b 42)
                    (primitive/icmp-eq b 43)
                    (primitive/icmp-eq b 63)
                    (primitive/icmp-eq b 94)
                    (primitive/icmp-eq b 36))
                `:not-literal
                (do
                  (primitive/code-list-push! out `~b)
                  (rx--literal-bytes bytes (primitive/iadd i 1) end out)))))))

(defn rx--literal-eq [(literal Code) (hay Code) (start Code) (i i64)] (-> Code)
  (if (primitive/icmp-ge i (primitive/code-count literal))
      `true
      (let [want (primitive/code-int (primitive/code-nth literal i))]
        `(and (primitive/icmp-eq (primitive/cast i64
                                                 (primitive/load (primitive/index (coil.slice.slice-data ~hay)
                                                                                  (primitive/iadd ~start ~i))))
                                 ~want)
              ~(rx--literal-eq literal hay start (primitive/iadd i 1))))))

(defn rx--literal-ptr-eq [(literal Code) (candidate Code) (i i64)] (-> Code)
  (if (primitive/icmp-ge i (primitive/code-count literal))
      `true
      (let [want (primitive/code-int (primitive/code-nth literal i))]
        `(and (primitive/icmp-eq (primitive/cast i64
                                                 (primitive/load (primitive/index ~candidate ~i)))
                                 ~want)
              ~(rx--literal-ptr-eq literal candidate (primitive/iadd i 1))))))

(defn rx--literal-search [(literal Code)
                          (haystack Code)
                          (start-anchor bool)
                          (end-anchor bool)] (-> Code)
  (let [width (primitive/code-count literal)
        hay (primitive/fresh-identifier "regex-haystack")
        length (primitive/fresh-identifier "regex-length")
        cursor (primitive/fresh-identifier "regex-cursor")
        candidate (primitive/fresh-identifier "regex-candidate")
        last (primitive/fresh-identifier "regex-last")
        first
          (if (primitive/icmp-eq width 0)
              0
              (primitive/code-int (primitive/code-nth literal 0)))]
    (if (primitive/icmp-eq width 0)
        `(let [~hay ~haystack]
           ~(if (and start-anchor end-anchor)
                `(primitive/icmp-eq (coil.slice.slice-len ~hay) 0)
                `true))
        `(let [~hay ~haystack
               ~length (coil.slice.slice-len ~hay)]
           (if (primitive/icmp-lt ~length ~width)
               false
               ~(if start-anchor
                    (if end-anchor
                        `(and (primitive/icmp-eq ~length ~width)
                              ~(rx--literal-eq literal hay `0 0))
                        (rx--literal-eq literal hay `0 0))
                    (if end-anchor
                        (rx--literal-eq literal hay `(primitive/isub ~length ~width) 0)
                        `(let [(mut ~cursor) (coil.slice.slice-data ~hay)
                               ~last
                                 (primitive/index (coil.slice.slice-data ~hay)
                                                  (primitive/isub ~length ~width))]
                           (loop :regex-literal-search
                             (if (> (primitive/load ~cursor) ~last)
                                 (break :regex-literal-search false)
                                 (let [~candidate
                                         (coil.mem.mem-find-byte (primitive/load ~cursor)
                                                                 (primitive/cast u8 ~first)
                                                                 (primitive/iadd (primitive/isub (primitive/cast i64
                                                                                                                 ~last)
                                                                                                 (primitive/cast i64
                                                                                                                 (primitive/load ~cursor)))
                                                                                 1))]
                                   (if (= (primitive/cast i64 ~candidate) 0)
                                       (break :regex-literal-search false)
                                       (if ~(rx--literal-ptr-eq literal candidate 1)
                                           (break :regex-literal-search true)
                                           (primitive/store! ~cursor
                                                             (primitive/index ~candidate 1)))))))))))))))

(defn rx--peek [(c (mut (array i64 1280)))] (-> i64)
  (if (primitive/icmp-ge (rx--mem (mut c) 0) (rx--mem (mut c) 1))
      -1
      (primitive/code-int (primitive/code-nth (primitive/code-from-opaque (rx--mem (mut c) 4))
                                              (rx--mem (mut c) 0)))))

(defn rx--take [(c (mut (array i64 1280)))] (-> i64)
  (let [b (rx--peek (mut c))]
    (if (primitive/icmp-ge b 0)
        (rx--put (mut c) 0 (primitive/iadd (rx--mem (mut c) 0) 1))
        0)
    b))

(defn rx--state [(c (mut (array i64 1280))) (op i64)] (-> i64)
  (let [s (rx--mem (mut c) 2)]
    (if (primitive/icmp-ge s 63)
        (primitive/error "regex: expression needs more than 63 Thompson states")
        0)
    (rx--put (mut c) 2 (primitive/iadd s 1))
    (rx--put (mut c) (primitive/iadd 16 s) op)
    (rx--put (mut c) (primitive/iadd 80 s) -1)
    (rx--put (mut c) (primitive/iadd 144 s) -1)
    (rx--put (mut c) (primitive/iadd 208 s) 0)
    (rx--put (mut c) (primitive/iadd 272 s) 0)
    (rx--put (mut c) (primitive/iadd 336 s) 0)
    (rx--put (mut c) (primitive/iadd 400 s) 0)
    s))

(defn rx--new-patch [(c (mut (array i64 1280))) (state i64) (slot i64)] (-> i64)
  (let [p (rx--mem (mut c) 3)]
    (if (primitive/icmp-ge p 256)
        (primitive/error "regex: internal patch-list capacity exceeded")
        0)
    (rx--put (mut c) 3 (primitive/iadd p 1))
    (rx--put (mut c) (primitive/iadd 512 p) state)
    (rx--put (mut c) (primitive/iadd 768 p) slot)
    (rx--put (mut c) (primitive/iadd 1024 p) -1)
    p))

(defn rx--patch-tail [(c (mut (array i64 1280))) (p i64)] (-> i64)
  (let [n (rx--mem (mut c) (primitive/iadd 1024 p))]
    (if (primitive/icmp-lt n 0) p (rx--patch-tail (mut c) n))))

(defn rx--append-patches [(c (mut (array i64 1280))) (a i64) (b i64)] (-> i64)
  (if (primitive/icmp-lt a 0)
      b
      (if (primitive/icmp-lt b 0)
          a
          (do
            (rx--put (mut c) (primitive/iadd 1024 (rx--patch-tail (mut c) a)) b)
            a))))

(defn rx--patch [(c (mut (array i64 1280))) (p i64) (target i64)] (-> i64)
  (if (primitive/icmp-lt p 0)
      0
      (let [s (rx--mem (mut c) (primitive/iadd 512 p))
            slot (rx--mem (mut c) (primitive/iadd 768 p))
            next (rx--mem (mut c) (primitive/iadd 1024 p))]
        (if (primitive/icmp-eq slot 1)
            (rx--put (mut c) (primitive/iadd 80 s) target)
            (rx--put (mut c) (primitive/iadd 144 s) target))
        (rx--patch (mut c) next target))))

(defn rx--empty [(c (mut (array i64 1280)))] (-> i64)
  (let [s (rx--state (mut c) 1)
        p (rx--new-patch (mut c) s 1)]
    (rx--frag s p)))

(defn rx--class-state [(c (mut (array i64 1280)))] (-> i64)
  (let [s (rx--state (mut c) 0)
        p (rx--new-patch (mut c) s 1)]
    (rx--frag s p)))

(defn rx--class-add [(c (mut (array i64 1280))) (s i64) (b i64)] (-> i64)
  (let [word (primitive/udiv b 64)
        bit (primitive/urem b 64)
        mask (primitive/ishl 1 bit)]
    (if (primitive/icmp-eq word 0)
        (rx--put (mut c)
                 (primitive/iadd 208 s)
                 (primitive/ior (rx--mem (mut c) (primitive/iadd 208 s)) mask))
        (if (primitive/icmp-eq word 1)
            (rx--put (mut c)
                     (primitive/iadd 272 s)
                     (primitive/ior (rx--mem (mut c) (primitive/iadd 272 s)) mask))
            (if (primitive/icmp-eq word 2)
                (rx--put (mut c)
                         (primitive/iadd 336 s)
                         (primitive/ior (rx--mem (mut c) (primitive/iadd 336 s)) mask))
                (rx--put (mut c)
                         (primitive/iadd 400 s)
                         (primitive/ior (rx--mem (mut c) (primitive/iadd 400 s)) mask)))))))

(defn rx--class-range [(c (mut (array i64 1280))) (s i64) (lo i64) (hi i64)] (-> i64)
  (let [(mut b) lo]
    (loop (if (primitive/icmp-gt (primitive/load b) hi)
              (break)
              (do
                (rx--class-add (mut c) s (primitive/load b))
                (primitive/store! b (primitive/iadd (primitive/load b) 1)))))
    0))

(defn rx--class-negate [(c (mut (array i64 1280))) (s i64)] (-> i64)
  (rx--put (mut c)
           (primitive/iadd 208 s)
           (primitive/ixor (rx--mem (mut c) (primitive/iadd 208 s)) -1))
  (rx--put (mut c)
           (primitive/iadd 272 s)
           (primitive/ixor (rx--mem (mut c) (primitive/iadd 272 s)) -1))
  (rx--put (mut c)
           (primitive/iadd 336 s)
           (primitive/ixor (rx--mem (mut c) (primitive/iadd 336 s)) -1))
  (rx--put (mut c)
           (primitive/iadd 400 s)
           (primitive/ixor (rx--mem (mut c) (primitive/iadd 400 s)) -1))
  0)

(defn rx--escape-class [(c (mut (array i64 1280))) (s i64) (b i64)] (-> bool)
  (if (primitive/icmp-eq b 100)  ; \d
      (do (rx--class-range (mut c) s 48 57) true)
      (if (primitive/icmp-eq b 119)  ; \w
          (do
            (rx--class-range (mut c) s 48 57)
            (rx--class-range (mut c) s 65 90)
            (rx--class-add (mut c) s 95)
            (rx--class-range (mut c) s 97 122)
            true)
          (if (primitive/icmp-eq b 115)  ; \s
              (do
                (rx--class-add (mut c) s 9)
                (rx--class-add (mut c) s 10)
                (rx--class-add (mut c) s 11)
                (rx--class-add (mut c) s 12)
                (rx--class-add (mut c) s 13)
                (rx--class-add (mut c) s 32)
                true)
              false))))

(defn rx--escaped-byte [(b i64)] (-> i64)
  (if (primitive/icmp-eq b 110)
      10
      (if (primitive/icmp-eq b 114)
          13
          (if (primitive/icmp-eq b 116) 9 b))))

(defn rx--class-item [(c (mut (array i64 1280))) (s i64)] (-> i64)
  (let [b (rx--take (mut c))]
    (if (primitive/icmp-lt b 0)
        (primitive/error "regex: unterminated byte class")
        0)
    (if (primitive/icmp-eq b 92)
        (let [e (rx--take (mut c))]
          (if (primitive/icmp-lt e 0)
              (primitive/error "regex: trailing escape in byte class")
              0)
          (if (rx--escape-class (mut c) s e) -2 (rx--escaped-byte e)))
        b)))

(defn rx--parse-class-items [(c (mut (array i64 1280))) (s i64) (first bool)] (-> i64)
  (let [p (rx--peek (mut c))]
    (if (primitive/icmp-lt p 0)
        (primitive/error "regex: unterminated byte class")
        0)
    (if (and (not first) (primitive/icmp-eq p 93))
        (do (rx--take (mut c)) 0)
        (let [lo (rx--class-item (mut c) s)]
          (if (primitive/icmp-eq lo -2)
              (rx--parse-class-items (mut c) s false)
              (if (and (primitive/icmp-eq (rx--peek (mut c)) 45)
                       (and (primitive/icmp-lt (primitive/iadd (rx--mem (mut c) 0) 1)
                                               (rx--mem (mut c) 1))
                            (not (primitive/icmp-eq (primitive/code-int (primitive/code-nth (primitive/code-from-opaque (rx--mem (mut c)
                                                                                                                                 4))
                                                                                            (primitive/iadd (rx--mem (mut c)
                                                                                                                     0)
                                                                                                            1)))
                                                    93))))
                  (do
                    (rx--take (mut c))
                    (let [hi (rx--class-item (mut c) s)]
                      (if (or (primitive/icmp-eq hi -2) (primitive/icmp-gt lo hi))
                          (primitive/error "regex: invalid byte-class range")
                          (rx--class-range (mut c) s lo hi)))
                    (rx--parse-class-items (mut c) s false))
                  (do
                    (rx--class-add (mut c) s lo)
                    (rx--parse-class-items (mut c) s false))))))))

(defn rx--parse-class [(c (mut (array i64 1280)))] (-> i64)
  (let [f (rx--class-state (mut c))
        neg (primitive/icmp-eq (rx--peek (mut c)) 94)]
    (if neg (rx--take (mut c)) 0)
    (rx--parse-class-items (mut c) (rx--frag-start f) true)
    (if neg (rx--class-negate (mut c) (rx--frag-start f)) 0)
    f))

(defn rx--literal [(c (mut (array i64 1280))) (b i64)] (-> i64)
  (let [f (rx--class-state (mut c))]
    (rx--class-add (mut c) (rx--frag-start f) b)
    f))

(defn rx--escaped [(c (mut (array i64 1280))) (b i64)] (-> i64)
  (let [f (rx--class-state (mut c))]
    (if (rx--escape-class (mut c) (rx--frag-start f) b)
        0
        (rx--class-add (mut c) (rx--frag-start f) (rx--escaped-byte b)))
    f))

(defn rx--parse-atom [(c (mut (array i64 1280)))] (-> i64)
  (let [b (rx--take (mut c))]
    (if (primitive/icmp-eq b 40)  ; (
        (let [f (rx--parse-alt (mut c))]
          (if (not (primitive/icmp-eq (rx--take (mut c)) 41))
              (primitive/error "regex: unmatched '('")
              0)
          f)
        (if (primitive/icmp-eq b 91)  ; [
            (rx--parse-class (mut c))
            (if (primitive/icmp-eq b 46)  ; . except newline
                (let [f (rx--class-state (mut c))]
                  (rx--class-negate (mut c) (rx--frag-start f))
                  (let [word (primitive/udiv 10 64)
                        bit (primitive/urem 10 64)
                        mask (primitive/ishl 1 bit)]
                    (if (primitive/icmp-eq word 0)
                        (rx--put (mut c)
                                 (primitive/iadd 208 (rx--frag-start f))
                                 (primitive/iand (rx--mem (mut c) (primitive/iadd 208 (rx--frag-start f)))
                                                 (primitive/ixor mask -1)))
                        0))
                  f)
                (if (primitive/icmp-eq b 92)
                    (let [e (rx--take (mut c))]
                      (if (primitive/icmp-lt e 0)
                          (primitive/error "regex: trailing escape")
                          0)
                      (rx--escaped (mut c) e))
                    (if (or (primitive/icmp-eq b 42)
                            (or (primitive/icmp-eq b 43)
                                (or (primitive/icmp-eq b 63)
                                    (or (primitive/icmp-eq b 41)
                                        (or (primitive/icmp-eq b 124)
                                            (or (primitive/icmp-eq b 94)
                                                (primitive/icmp-eq b 36)))))))
                        (primitive/error "regex: unexpected metacharacter")
                        (rx--literal (mut c) b))))))))

(defn rx--star [(c (mut (array i64 1280))) (f i64)] (-> i64)
  (let [s (rx--state (mut c) 1)]
    (rx--put (mut c) (primitive/iadd 80 s) (rx--frag-start f))
    (rx--patch (mut c) (rx--frag-outs f) s)
    (let [p (rx--new-patch (mut c) s 2)]
      (rx--frag s p))))

(defn rx--plus [(c (mut (array i64 1280))) (f i64)] (-> i64)
  (let [s (rx--state (mut c) 1)]
    (rx--put (mut c) (primitive/iadd 80 s) (rx--frag-start f))
    (rx--patch (mut c) (rx--frag-outs f) s)
    (let [p (rx--new-patch (mut c) s 2)]
      (rx--frag (rx--frag-start f) p))))

(defn rx--question [(c (mut (array i64 1280))) (f i64)] (-> i64)
  (let [s (rx--state (mut c) 1)]
    (rx--put (mut c) (primitive/iadd 80 s) (rx--frag-start f))
    (let [skip (rx--new-patch (mut c) s 2)
          outs (rx--append-patches (mut c) (rx--frag-outs f) skip)]
      (rx--frag s outs))))

(defn rx--parse-repeat [(c (mut (array i64 1280)))] (-> i64)
  (let [f (rx--parse-atom (mut c))
        q (rx--peek (mut c))]
    (if (primitive/icmp-eq q 42)
        (do (rx--take (mut c)) (rx--star (mut c) f))
        (if (primitive/icmp-eq q 43)
            (do (rx--take (mut c)) (rx--plus (mut c) f))
            (if (primitive/icmp-eq q 63)
                (do (rx--take (mut c)) (rx--question (mut c) f))
                f)))))

(defn rx--concat-end? [(b i64)] (-> bool)
  (or (primitive/icmp-lt b 0)
      (or (primitive/icmp-eq b 41) (primitive/icmp-eq b 124))))

(defn rx--parse-concat-tail [(c (mut (array i64 1280))) (left i64)] (-> i64)
  (if (rx--concat-end? (rx--peek (mut c)))
      left
      (let [right (rx--parse-repeat (mut c))]
        (rx--patch (mut c) (rx--frag-outs left) (rx--frag-start right))
        (rx--parse-concat-tail (mut c) (rx--frag (rx--frag-start left) (rx--frag-outs right))))))

(defn rx--parse-concat [(c (mut (array i64 1280)))] (-> i64)
  (if (rx--concat-end? (rx--peek (mut c)))
      (rx--empty (mut c))
      (rx--parse-concat-tail (mut c) (rx--parse-repeat (mut c)))))

(defn rx--parse-alt [(c (mut (array i64 1280)))] (-> i64)
  (let [left (rx--parse-concat (mut c))]
    (if (primitive/icmp-eq (rx--peek (mut c)) 124)
        (do
          (rx--take (mut c))
          (let [right (rx--parse-alt (mut c))
                s (rx--state (mut c) 1)]
            (rx--put (mut c) (primitive/iadd 80 s) (rx--frag-start left))
            (rx--put (mut c) (primitive/iadd 144 s) (rx--frag-start right))
            (let [outs (rx--append-patches (mut c) (rx--frag-outs left) (rx--frag-outs right))]
              (rx--frag s outs))))
        left)))

(defn rx--closure [(c (mut (array i64 1280))) (s i64) (seen i64)] (-> i64)
  (if (primitive/icmp-lt s 0)
      0
      (let [bit (primitive/ishl 1 s)]
        (if (not (primitive/icmp-eq (primitive/iand seen bit) 0))
            0
            (let [now (primitive/ior seen bit)]
              (if (primitive/icmp-eq (rx--mem (mut c) (primitive/iadd 16 s)) 1)
                  (primitive/ior (rx--closure (mut c) (rx--mem (mut c) (primitive/iadd 80 s)) now)
                                 (rx--closure (mut c) (rx--mem (mut c) (primitive/iadd 144 s)) now))
                  bit))))))

(defn rx--reachable-without? [(c (mut (array i64 1280)))
                              (state i64)
                              (accept i64)
                              (skip i64)
                              (seen i64)] (-> bool)
  (if (or (primitive/icmp-lt state 0) (primitive/icmp-eq state skip))
      false
      (if (primitive/icmp-eq state accept)
          true
          (let [bit (primitive/ishl 1 state)]
            (if (not (primitive/icmp-eq (primitive/iand seen bit) 0))
                false
                (let [now (primitive/ior seen bit)
                      op (rx--mem (mut c) (primitive/iadd 16 state))]
                  (if (primitive/icmp-eq op 1)
                      (or (rx--reachable-without? (mut c)
                                                  (rx--mem (mut c) (primitive/iadd 80 state))
                                                  accept
                                                  skip
                                                  now)
                          (rx--reachable-without? (mut c)
                                                  (rx--mem (mut c) (primitive/iadd 144 state))
                                                  accept
                                                  skip
                                                  now))
                      (rx--reachable-without? (mut c)
                                              (rx--mem (mut c) (primitive/iadd 80 state))
                                              accept
                                              skip
                                              now))))))))

(defn rx--singleton-byte [(c (mut (array i64 1280))) (state i64)] (-> i64)
  (let [m0 (rx--mem (mut c) (primitive/iadd 208 state))
        m1 (rx--mem (mut c) (primitive/iadd 272 state))
        m2 (rx--mem (mut c) (primitive/iadd 336 state))
        m3 (rx--mem (mut c) (primitive/iadd 400 state))
        count
          (primitive/iadd (primitive/iadd (primitive/popcount m0) (primitive/popcount m1))
                          (primitive/iadd (primitive/popcount m2) (primitive/popcount m3)))]
    (if (not (primitive/icmp-eq count 1))
        -1
        (if (not (primitive/icmp-eq m0 0))
            (primitive/ctz m0)
            (if (not (primitive/icmp-eq m1 0))
                (primitive/iadd 64 (primitive/ctz m1))
                (if (not (primitive/icmp-eq m2 0))
                    (primitive/iadd 128 (primitive/ctz m2))
                    (primitive/iadd 192 (primitive/ctz m3))))))))

; A singleton consuming state that dominates accept is a required byte. A
; whole-haystack memchr can reject the overwhelmingly common absent case before
; entering the state machine. This is conservative: no dominator means no filter.
(defn rx--required-byte [(c (mut (array i64 1280)))
                         (start i64)
                         (accept i64)
                         (state i64)] (-> i64)
  (if (primitive/icmp-ge state (rx--mem (mut c) 2))
      -1
      (if (primitive/icmp-eq (rx--mem (mut c) (primitive/iadd 16 state)) 0)
          (let [byte (rx--singleton-byte (mut c) state)]
            (if (and (primitive/icmp-ge byte 0)
                     (not (rx--reachable-without? (mut c) start accept state 0)))
                byte
                (rx--required-byte (mut c) start accept (primitive/iadd state 1))))
          (rx--required-byte (mut c) start accept (primitive/iadd state 1)))))

(defn rx--byte-test [(c (mut (array i64 1280))) (s i64) (byte Code)] (-> Code)
  (let [m0 (rx--mem (mut c) (primitive/iadd 208 s))
        m1 (rx--mem (mut c) (primitive/iadd 272 s))
        m2 (rx--mem (mut c) (primitive/iadd 336 s))
        m3 (rx--mem (mut c) (primitive/iadd 400 s))]
    `(let [word (primitive/udiv ~byte 64)
           bit (primitive/urem ~byte 64)
           mask
             (if (primitive/icmp-eq word 0)
                 ~m0
                 (if (primitive/icmp-eq word 1)
                     ~m1
                     (if (primitive/icmp-eq word 2) ~m2 ~m3)))]
       (not (primitive/icmp-eq (primitive/iand mask (primitive/ishl 1 bit))
                               0)))))

(defn rx--step [(c (mut (array i64 1280))) (state i64) (active Code) (byte Code)] (-> Code)
  (if (primitive/icmp-ge state (rx--mem (mut c) 2))
      `0
      (if (primitive/icmp-eq (rx--mem (mut c) (primitive/iadd 16 state)) 0)
          (let [bit (primitive/ishl 1 state)
                target (rx--mem (mut c) (primitive/iadd 80 state))
                closure (rx--closure (mut c) target 0)]
            `(primitive/ior (if (and (not (primitive/icmp-eq (primitive/iand ~active ~bit) 0))
                                     ~(rx--byte-test (mut c) state byte))
                                ~closure
                                0)
                            ~(rx--step (mut c) (primitive/iadd state 1) active byte)))
          (rx--step (mut c) (primitive/iadd state 1) active byte))))

(defn rx--compile [(pattern Code) (haystack Code)] (-> Code)
  (if (not (primitive/code-string? pattern))
      (primitive/error "regex: pattern must be a string literal")
      0)
  (let [bs (primitive/str-bytes pattern)
        n (primitive/code-count bs)]
    (let [start-anchor
            (and (primitive/icmp-gt n 0)
                 (primitive/icmp-eq (primitive/code-int (primitive/code-nth bs 0)) 94))
          end-anchor
            (and (primitive/icmp-gt n 0)
                 (and (primitive/icmp-eq (primitive/code-int (primitive/code-nth bs (primitive/isub n 1)))
                                         36)
                      (not (rx--escaped-at? bs (primitive/isub n 1)))))
          lo (if start-anchor 1 0)
          hi (if end-anchor (primitive/isub n 1) n)
          literal (rx--literal-bytes bs lo hi (primitive/code-list-new))]
      (if (not (primitive/code-eq literal `:not-literal))
          (rx--literal-search literal haystack start-anchor end-anchor)
          (let [(mut compiler) (primitive/zeroed (array i64 1280))]
            (rx--put (mut compiler) 4 (primitive/code-opaque bs))
            (rx--put (mut compiler) 0 lo)
            (rx--put (mut compiler) 1 hi)
            (let [f (rx--parse-alt (mut compiler))]
              (if (not (primitive/icmp-eq (rx--mem (mut compiler) 0) hi))
                  (primitive/error "regex: pattern did not parse completely")
                  0)
              (let [accept (rx--state (mut compiler) 2)]
                (rx--patch (mut compiler) (rx--frag-outs f) accept)
                (let [initial (rx--closure (mut compiler) (rx--frag-start f) 0)
                      required (rx--required-byte (mut compiler) (rx--frag-start f) accept 0)
                      accept-bit (primitive/ishl 1 accept)
                      hay (primitive/fresh-identifier "regex-haystack")
                      active (primitive/fresh-identifier "regex-active")
                      current (primitive/fresh-identifier "regex-current")
                      byte (primitive/fresh-identifier "regex-byte")
                      index (primitive/fresh-identifier "regex-index")]
                  `(let [~hay ~haystack
                         (mut ~active) ~initial
                         (mut ~index)
                           ~(if (primitive/icmp-ge required 0)
                                `(if (= (primitive/cast i64
                                                        (coil.mem.mem-find-byte (coil.slice.slice-data ~hay)
                                                                                (primitive/cast u8 ~required)
                                                                                (coil.slice.slice-len ~hay)))
                                        0)
                                     (coil.slice.slice-len ~hay)
                                     0)
                                `0)]
                     (loop :regex-search
                       (let [~current
                               (if ~start-anchor
                                   (primitive/load ~active)
                                   (primitive/ior (primitive/load ~active) ~initial))]
                         (if (and (not (primitive/icmp-eq (primitive/iand ~current ~accept-bit)
                                                          0))
                                  (if ~end-anchor
                                      (primitive/icmp-eq (primitive/load ~index)
                                                         (coil.slice.slice-len ~hay))
                                      true))
                             (break :regex-search true)
                             (if (primitive/icmp-ge (primitive/load ~index)
                                                    (coil.slice.slice-len ~hay))
                                 (break :regex-search false)
                                 (let [~byte
                                         (primitive/cast i64
                                                         (primitive/load (primitive/index (coil.slice.slice-data ~hay)
                                                                                          (primitive/load ~index))))]
                                   (primitive/store! ~active
                                                     ~(rx--step (mut compiler) 0 current byte))
                                   (primitive/store! ~index
                                                     (primitive/iadd (primitive/load ~index)
                                                                     1))))))))))))))))

;;; Compile PATTERN into an allocation-free byte matcher at the call site.
;;; Supported today: literals, `.`, grouping, alternation, `*`, `+`, `?`, byte
;;; classes/ranges/negation, `\d`/`\w`/`\s`, and outer `^`/`$` anchors.
(defn is-match? [(pattern Code) (haystack Code)] (-> Code)
  (rx--compile pattern haystack))
