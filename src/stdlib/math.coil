(module coil.math)
(import "coil.primitive" :as primitive)

; Scalar floating-point math for `f32` and `f64`.
;
; Each method is one LLVM math intrinsic, so the LLVM backend sees the operation
; itself: it constant-folds it, selects the instruction when the target has one
; (`fsqrt`, `frintm`, `fmin`, ...) and calls libm otherwise. The arm64, x64 and
; bytecode backends lower the same intrinsics (src/compiler/float_math.coil).

;;; Floating-point math on `f32` and `f64`, dispatched by the argument type:
;;;
;;; ```coil
;;; (module example.math)
;;; (import "coil.math" :as math)
;;;
;;; (defn main [] (-> i64)
;;;   (println "{} {}" (math/sqrt 2.0) (math/floor (: 2.5 f32)))
;;;   0)
;;; ```
;;;
;;; Rounding: `floor`, `ceil`, `trunc`, `round` (ties away from zero),
;;; `round-even` (ties to even). Arithmetic: `sqrt`, `abs`, `mul-add` (fused),
;;; `min`, `max`, `copysign`. Transcendental: `sin` `cos` `tan` `asin` `acos` `atan`
;;; `atan2` `sinh` `cosh` `tanh` `exp` `exp2` `log` `log2` `log10` `pow`. Angles
;;; are radians.
(deftrait Float [Self]
  ;; Square root; NaN for a negative argument.
  (sqrt [(x Self)] (-> Self))
  ;; Absolute value (clears the sign bit, so `(abs -0.0)` is `0.0`).
  (abs [(x Self)] (-> Self))
  ;; Largest integral value not greater than `x`.
  (floor [(x Self)] (-> Self))
  ;; Smallest integral value not less than `x`.
  (ceil [(x Self)] (-> Self))
  ;; `x` rounded toward zero to an integral value.
  (trunc [(x Self)] (-> Self))
  ;; `x` rounded to the nearest integral value, halfway cases away from zero (C `round`).
  (round [(x Self)] (-> Self))
  ;; `x` rounded to the nearest integral value, halfway cases to even (what `coil.simd/vround` does per lane).
  (round-even [(x Self)] (-> Self))
  ;; `(x * y) + z` with a single rounding (fused multiply-add).
  (mul-add [(x Self) (y Self) (z Self)] (-> Self))
  ;; The lesser of `x` and `y`. A NaN operand makes the result NaN, and `-0.0` is less than `0.0` (like `coil.simd/vmin`).
  (min [(x Self) (y Self)] (-> Self))
  ;; The greater of `x` and `y`. A NaN operand makes the result NaN, and `0.0` is greater than `-0.0` (like `coil.simd/vmax`).
  (max [(x Self) (y Self)] (-> Self))
  ;; The magnitude of `x` with the sign of `y`.
  (copysign [(x Self) (y Self)] (-> Self))
  ;; Sine of `x` radians.
  (sin [(x Self)] (-> Self))
  ;; Cosine of `x` radians.
  (cos [(x Self)] (-> Self))
  ;; Tangent of `x` radians.
  (tan [(x Self)] (-> Self))
  ;; Arcsine, in radians in [-pi/2, pi/2].
  (asin [(x Self)] (-> Self))
  ;; Arccosine, in radians in [0, pi].
  (acos [(x Self)] (-> Self))
  ;; Arctangent, in radians in [-pi/2, pi/2].
  (atan [(x Self)] (-> Self))
  ;; Angle of the point (`x`, `y`) from the positive x axis, in radians in [-pi, pi]. `y` comes first, as in C.
  (atan2 [(y Self) (x Self)] (-> Self))
  ;; Hyperbolic sine.
  (sinh [(x Self)] (-> Self))
  ;; Hyperbolic cosine.
  (cosh [(x Self)] (-> Self))
  ;; Hyperbolic tangent.
  (tanh [(x Self)] (-> Self))
  ;; e raised to `x`.
  (exp [(x Self)] (-> Self))
  ;; 2 raised to `x`.
  (exp2 [(x Self)] (-> Self))
  ;; Natural logarithm.
  (log [(x Self)] (-> Self))
  ;; Base-2 logarithm.
  (log2 [(x Self)] (-> Self))
  ;; Base-10 logarithm.
  (log10 [(x Self)] (-> Self))
  ;; `x` raised to `y`.
  (pow [(x Self) (y Self)] (-> Self)))

(impl Float f32
  (sqrt [(x f32)] (-> f32)
    (primitive/llvm-ir f32 [x] "%r = call float @llvm.sqrt.f32(float $0)\nret float %r"))
  (abs [(x f32)] (-> f32)
    (primitive/llvm-ir f32 [x] "%r = call float @llvm.fabs.f32(float $0)\nret float %r"))
  (floor [(x f32)] (-> f32)
    (primitive/llvm-ir f32 [x] "%r = call float @llvm.floor.f32(float $0)\nret float %r"))
  (ceil [(x f32)] (-> f32)
    (primitive/llvm-ir f32 [x] "%r = call float @llvm.ceil.f32(float $0)\nret float %r"))
  (trunc [(x f32)] (-> f32)
    (primitive/llvm-ir f32 [x] "%r = call float @llvm.trunc.f32(float $0)\nret float %r"))
  (round [(x f32)] (-> f32)
    (primitive/llvm-ir f32 [x] "%r = call float @llvm.round.f32(float $0)\nret float %r"))
  (round-even [(x f32)] (-> f32)
    (primitive/llvm-ir f32 [x] "%r = call float @llvm.roundeven.f32(float $0)\nret float %r"))
  (mul-add [(x f32) (y f32) (z f32)] (-> f32)
    (primitive/llvm-ir f32 [x y z] "%r = call float @llvm.fma.f32(float $0, float $1, float $2)\nret float %r"))
  (min [(x f32) (y f32)] (-> f32)
    (primitive/llvm-ir f32 [x y] "%r = call float @llvm.minimum.f32(float $0, float $1)\nret float %r"))
  (max [(x f32) (y f32)] (-> f32)
    (primitive/llvm-ir f32 [x y] "%r = call float @llvm.maximum.f32(float $0, float $1)\nret float %r"))
  (copysign [(x f32) (y f32)] (-> f32)
    (primitive/llvm-ir f32 [x y] "%r = call float @llvm.copysign.f32(float $0, float $1)\nret float %r"))
  (sin [(x f32)] (-> f32)
    (primitive/llvm-ir f32 [x] "%r = call float @llvm.sin.f32(float $0)\nret float %r"))
  (cos [(x f32)] (-> f32)
    (primitive/llvm-ir f32 [x] "%r = call float @llvm.cos.f32(float $0)\nret float %r"))
  (tan [(x f32)] (-> f32)
    (primitive/llvm-ir f32 [x] "%r = call float @llvm.tan.f32(float $0)\nret float %r"))
  (asin [(x f32)] (-> f32)
    (primitive/llvm-ir f32 [x] "%r = call float @llvm.asin.f32(float $0)\nret float %r"))
  (acos [(x f32)] (-> f32)
    (primitive/llvm-ir f32 [x] "%r = call float @llvm.acos.f32(float $0)\nret float %r"))
  (atan [(x f32)] (-> f32)
    (primitive/llvm-ir f32 [x] "%r = call float @llvm.atan.f32(float $0)\nret float %r"))
  (atan2 [(y f32) (x f32)] (-> f32)
    (primitive/llvm-ir f32 [y x] "%r = call float @llvm.atan2.f32(float $0, float $1)\nret float %r"))
  (sinh [(x f32)] (-> f32)
    (primitive/llvm-ir f32 [x] "%r = call float @llvm.sinh.f32(float $0)\nret float %r"))
  (cosh [(x f32)] (-> f32)
    (primitive/llvm-ir f32 [x] "%r = call float @llvm.cosh.f32(float $0)\nret float %r"))
  (tanh [(x f32)] (-> f32)
    (primitive/llvm-ir f32 [x] "%r = call float @llvm.tanh.f32(float $0)\nret float %r"))
  (exp [(x f32)] (-> f32)
    (primitive/llvm-ir f32 [x] "%r = call float @llvm.exp.f32(float $0)\nret float %r"))
  (exp2 [(x f32)] (-> f32)
    (primitive/llvm-ir f32 [x] "%r = call float @llvm.exp2.f32(float $0)\nret float %r"))
  (log [(x f32)] (-> f32)
    (primitive/llvm-ir f32 [x] "%r = call float @llvm.log.f32(float $0)\nret float %r"))
  (log2 [(x f32)] (-> f32)
    (primitive/llvm-ir f32 [x] "%r = call float @llvm.log2.f32(float $0)\nret float %r"))
  (log10 [(x f32)] (-> f32)
    (primitive/llvm-ir f32 [x] "%r = call float @llvm.log10.f32(float $0)\nret float %r"))
  (pow [(x f32) (y f32)] (-> f32)
    (primitive/llvm-ir f32 [x y] "%r = call float @llvm.pow.f32(float $0, float $1)\nret float %r")))

(impl Float f64
  (sqrt [(x f64)] (-> f64)
    (primitive/llvm-ir f64 [x] "%r = call double @llvm.sqrt.f64(double $0)\nret double %r"))
  (abs [(x f64)] (-> f64)
    (primitive/llvm-ir f64 [x] "%r = call double @llvm.fabs.f64(double $0)\nret double %r"))
  (floor [(x f64)] (-> f64)
    (primitive/llvm-ir f64 [x] "%r = call double @llvm.floor.f64(double $0)\nret double %r"))
  (ceil [(x f64)] (-> f64)
    (primitive/llvm-ir f64 [x] "%r = call double @llvm.ceil.f64(double $0)\nret double %r"))
  (trunc [(x f64)] (-> f64)
    (primitive/llvm-ir f64 [x] "%r = call double @llvm.trunc.f64(double $0)\nret double %r"))
  (round [(x f64)] (-> f64)
    (primitive/llvm-ir f64 [x] "%r = call double @llvm.round.f64(double $0)\nret double %r"))
  (round-even [(x f64)] (-> f64)
    (primitive/llvm-ir f64 [x] "%r = call double @llvm.roundeven.f64(double $0)\nret double %r"))
  (mul-add [(x f64) (y f64) (z f64)] (-> f64)
    (primitive/llvm-ir f64 [x y z] "%r = call double @llvm.fma.f64(double $0, double $1, double $2)\nret double %r"))
  (min [(x f64) (y f64)] (-> f64)
    (primitive/llvm-ir f64 [x y] "%r = call double @llvm.minimum.f64(double $0, double $1)\nret double %r"))
  (max [(x f64) (y f64)] (-> f64)
    (primitive/llvm-ir f64 [x y] "%r = call double @llvm.maximum.f64(double $0, double $1)\nret double %r"))
  (copysign [(x f64) (y f64)] (-> f64)
    (primitive/llvm-ir f64 [x y] "%r = call double @llvm.copysign.f64(double $0, double $1)\nret double %r"))
  (sin [(x f64)] (-> f64)
    (primitive/llvm-ir f64 [x] "%r = call double @llvm.sin.f64(double $0)\nret double %r"))
  (cos [(x f64)] (-> f64)
    (primitive/llvm-ir f64 [x] "%r = call double @llvm.cos.f64(double $0)\nret double %r"))
  (tan [(x f64)] (-> f64)
    (primitive/llvm-ir f64 [x] "%r = call double @llvm.tan.f64(double $0)\nret double %r"))
  (asin [(x f64)] (-> f64)
    (primitive/llvm-ir f64 [x] "%r = call double @llvm.asin.f64(double $0)\nret double %r"))
  (acos [(x f64)] (-> f64)
    (primitive/llvm-ir f64 [x] "%r = call double @llvm.acos.f64(double $0)\nret double %r"))
  (atan [(x f64)] (-> f64)
    (primitive/llvm-ir f64 [x] "%r = call double @llvm.atan.f64(double $0)\nret double %r"))
  (atan2 [(y f64) (x f64)] (-> f64)
    (primitive/llvm-ir f64 [y x] "%r = call double @llvm.atan2.f64(double $0, double $1)\nret double %r"))
  (sinh [(x f64)] (-> f64)
    (primitive/llvm-ir f64 [x] "%r = call double @llvm.sinh.f64(double $0)\nret double %r"))
  (cosh [(x f64)] (-> f64)
    (primitive/llvm-ir f64 [x] "%r = call double @llvm.cosh.f64(double $0)\nret double %r"))
  (tanh [(x f64)] (-> f64)
    (primitive/llvm-ir f64 [x] "%r = call double @llvm.tanh.f64(double $0)\nret double %r"))
  (exp [(x f64)] (-> f64)
    (primitive/llvm-ir f64 [x] "%r = call double @llvm.exp.f64(double $0)\nret double %r"))
  (exp2 [(x f64)] (-> f64)
    (primitive/llvm-ir f64 [x] "%r = call double @llvm.exp2.f64(double $0)\nret double %r"))
  (log [(x f64)] (-> f64)
    (primitive/llvm-ir f64 [x] "%r = call double @llvm.log.f64(double $0)\nret double %r"))
  (log2 [(x f64)] (-> f64)
    (primitive/llvm-ir f64 [x] "%r = call double @llvm.log2.f64(double $0)\nret double %r"))
  (log10 [(x f64)] (-> f64)
    (primitive/llvm-ir f64 [x] "%r = call double @llvm.log10.f64(double $0)\nret double %r"))
  (pow [(x f64) (y f64)] (-> f64)
    (primitive/llvm-ir f64 [x y] "%r = call double @llvm.pow.f64(double $0, double $1)\nret double %r")))

;;; Pi as an `f64`; `(cast f32 pi)` for an `f32`.
(def pi 3.141592653589793)

;;; Tau (2 pi) as an `f64`.
(def tau 6.283185307179586)

;;; Euler's number as an `f64`.
(def e 2.718281828459045)
