(module coil.var)

(import "coil.primitive" :as primitive)

(export Var var-new var-get var-set!)

;; A typed, replaceable value cell.  `Var` is ordinary data: it has no special
;; declaration form and can hold any type.  When T is a function pointer, the
;; Callable impl below forwards call syntax through the current field value.
(defstruct Var [T] [(value T)])

(defn var-new [T] [(value T)] (-> (Var T))
  (Var :value value))

(defn var-get [T] [(v (Var T))] (-> T)
  (load (field v value)))

(defn var-set! [T] [(v (mut (Var T))) (value T)] (-> i64)
  (store! (field v value) value)
  0)

; A specialization contains exactly the concrete argument list and result type.
; `:inline (Always)` is inherited from Callable.call, so this wrapper disappears;
; generated code loads Var.value and performs the one required indirect call.
(impl [Args... R] Callable (Var (fnptr c [Args...] R))
  (call [(self (Var (fnptr c [Args...] R))) (args Args...) ...] (-> R)
    (primitive/call-ptr (load (field self value)) args...)))
