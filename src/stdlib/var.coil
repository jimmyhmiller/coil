(module coil.var)
(import "coil.primitive" :as primitive)

(export Var var-static)

;;; A typed reference to one replaceable value. Copying a Var preserves the
;;; identity of its cell: every alias observes subsequent `set` operations.
(defstruct Var [T] [(cell (ptr T))])

(impl [T] (Var T)
  (get [(self (Var T))] (-> T)
    (load (load (field self cell))))

  (set [(self (Var T)) (value T)] (-> i64)
    (store! (load (field self cell)) value)
    0))

;;; Construct a Var whose cell has static storage duration. This is a macro so
;;; every authored occurrence owns a distinct `alloc-static` call site.
(defn var-static [(ty Code) (value Code)] (-> Code)
  `(Var :cell (primitive/alloc-static ~ty ~value)))

; A specialization contains exactly the concrete argument list and result type.
; `:inline (Always)` is inherited from Callable.call, so this wrapper disappears;
; generated code loads through Var.cell and performs the one required indirect call.
(impl [Args... R] Callable (Var (fnptr c [Args...] R))
  (call [(self (Var (fnptr c [Args...] R))) (args Args...) ...]
        (-> R)
        (primitive/call-ptr (get self) args...)))
