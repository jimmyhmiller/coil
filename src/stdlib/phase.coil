;;; When a registered metaprogram runs. A `checker` or `transform` registration
;;; with no `:phase` runs on the checked program; one with a phase names it with
;;; one of these values:
;;;
;;;     (import "coil.phase" :as phase)
;;;     (transform rename-all :phase (phase/BeforeExpand))
;;;     (checker no-floats :phase (phase/BeforeExpand))
(module coil.phase)

(defsum Phase
  ;;; Over the program as written, before any macro expands. A checker may
  ;;; register here too.
  (BeforeExpand)
  ;;; Over the expanded program, before it is checked. Its output is not
  ;;; expanded again, so it emits core forms.
  (AfterExpand)
  ;;; Over the checked program, as a transform with no `:phase` runs.
  (Ownership)
  ;;; As a reader: over an input's raw bytes, to produce its module.
  (Read))
