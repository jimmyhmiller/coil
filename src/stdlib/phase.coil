;;; When a registered metaprogram runs. A `checker` or `transform` registration
;;; with no `:phase` runs on the checked program; one with a phase names it with
;;; one of these values:
;;;
;;;     (import "coil.phase" :as phase)
;;;     (transform rename-all :phase (phase/BeforeExpand))
;;;     (checker no-floats :phase (phase/BeforeExpand))
(module coil.phase)

(defsum Phase
  ;;; Over the program as written, before any macro expands. A checker may
  ;;; register here too.
  (BeforeExpand)
  ;;; Over the expanded program, before it is checked. Its output is not
  ;;; expanded again, so it emits core forms.
  (AfterExpand)
  ;;; Over the checked program, as a transform with no `:phase` runs.
  (Ownership)
  ;;; As a reader: over an input's raw bytes, to produce its module.
  (Read))

;;; Which modules a `checker` or `transform` reads and may change, named with
;;; `:modules`:
;;;
;;;     (transform tr-run :phase (phase/AfterExpand) :modules (phase/OwnModules))
(defsum Modules
  ;;; Every module of the program, the standard library's among them. A
  ;;; registration with no `:modules` reads them all.
  (AllModules)
  ;;; Only the program's own: it reads nothing of the standard library's
  ;;; modules and leaves them as they are. A compile that builds on the saved
  ;;; library state may then run it there, where the library's modules are
  ;;; compiled already and are not handed to it; with any registration that
  ;;; reads them all, the compile starts from nothing instead.
  (OwnModules))
