(module coil.os)
(import "coil.primitive" :as primitive)

; Small hosted OS facts shared by the standard library. Keep libc's platform-specific
; errno accessor in exactly one bundled module: Coil does not deduplicate extern
; declarations across imported modules.

(defn gen-os-platform [] (-> Code)
  (if (primitive/code-eq (primitive/target-os) `linux)
      `(do
         (extern __errno_location :cc c [] (-> (ptr i32)))
         (defn os-errno [] (-> i64)
           (primitive/cast i64 (primitive/load (__errno_location)))))
      `(do
         (extern __error :cc c [] (-> (ptr i32)))
         (defn os-errno [] (-> i64)
           (primitive/cast i64 (primitive/load (__error)))))))
(meta (gen-os-platform))
