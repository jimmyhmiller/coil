(module coil.os)
(export errno set-errno! errno-message
        getenv setenv unsetenv getcwd chdir open close pipe dup2 fcntl fork execvp
        waitpid kill setpgid getpid getppid _exit
        SPAWN-FAILED spawn publish-envp! spawn-envp
        OsError Syscall OutOfMemory InvalidInput OwnedString slice-has-byte?
        get-env set-env! unset-env! current-dir change-dir
        dlsym strerror posix_spawnp errno-cell copy-c-string valid-env-name?
        os-pick os-pick-with-none requires-os)
(import "coil.primitive" :as primitive)
(import "coil.io" :as io)
(import "coil.fmt" :use [fmt Display display-fmt Formatter])
(import "coil.alloc" :as alloc)
(import "coil.str" :as str)
(import "coil.fail" :as fail)

; ---- choosing per operating system ------------------------------------------
; The standard library supports three operating systems, and a definition that
; differs between them names each one: there is no "every other OS" default,
; which silently gave wasm and bare-metal builds Darwin's numbers.
;
; Wasm has no OS of its own: a module calls functions its host provides (Node, a
; page, the bootstrap's src/bootstrap/runtime.c). Coil's wasm host interface
; numbers open(2) flags, clock ids and directory entries as Darwin does; hosts
; translate (see docs/reference/WASM.md).
;
; A bare-metal target (`*-none`) has no OS at all. A module that only makes sense
; with one begins with `(os/requires-os)`; one every program loads, like this
; one, gives bare metal its own definition with `os-pick-with-none`.

;;; `(os-pick linux darwin wasm)`: the form for the operating system of the code
;;; being produced. Any other target, bare metal included, is a compile error here.
(defn os-pick [(linux Code) (darwin Code) (wasm Code)] (-> Code)
  (let [os (primitive/target-os)]
    (cond (primitive/code-eq os `linux) linux
          (primitive/code-eq os `darwin) darwin
          (primitive/code-eq os `wasm) wasm
          :else (primitive/error (primitive/code-str "this definition has a form for linux, darwin and wasm, and none for the target's operating system, `" os "`")))))

;;; `os-pick` with a fourth form for a bare-metal (`*-none`) target.
(defn os-pick-with-none [(linux Code) (darwin Code) (wasm Code) (none Code)] (-> Code)
  (if (primitive/code-eq (primitive/target-os) `none)
      none
      (os-pick linux darwin wasm)))

;;; A top-level `(os/requires-os)`: the module calls the operating system, so a
;;; bare-metal (`*-none`) program cannot load it, as Rust has no `std::fs` there.
(defn requires-os [] (-> Code)
  (if (primitive/code-eq (primitive/target-os) `none)
      (primitive/error (primitive/code-str (primitive/code-file (primitive/code-call-site))
                                           " needs an operating system, and a bare-metal (`*-none`) target has none; use the hermetic standard library (`stdlib = \"hermetic\"`) or a platform layer of your own"))
      `(do)))

; Small hosted OS facts shared by the standard library. Keep libc's platform-specific
; errno accessor in exactly one bundled module: Coil does not deduplicate extern
; declarations across imported modules.

; `errno` has to satisfy three constraints at once:
;   1. NOT `(meta …)`-generated — staged macro sub-programs (the tower; any
;      comptime code that prints) are cut BEFORE stage3, so neither meta
;      generators nor top-level macro output exist in them, and io.coil — in
;      every staged printer's closure — calls errno.
;   2. Only symbols that exist on the RUNNING platform may be `extern`-declared —
;      the metaprogram JIT dlsym-resolves every declared extern eagerly, so a
;      dual declaration of __errno_location AND __error fails off-platform.
;   3. Cross-compilation must pick the TARGET's symbol, not the build host's.
; The one shape that satisfies all three: a plain defn that dlsym-resolves the
; target's errno accessor at runtime (dlsym itself is portable), with the symbol
; NAME and the RTLD_DEFAULT handle chosen by expression macros on target-os —
; inlined by normal expansion before any sub-program is cut. The resolved
; function pointer is cached in a static.
(extern dlsym :cc c [(ptr i8) (ptr i8)] (-> (ptr i8)))

; WASM hosts expose errno as a linear-memory cell. A native symbol address
; cannot be used as a WASM function-table index, so import the accessor directly.
; It exists only there, so it is exported only there: an export list naming it
; on another target would name nothing.
(defn wasm-errno-import [(name Code)] (-> Code)
  ; hygiene: Remove the macro argument context to declare the stable caller-visible OS errno accessor.
  (let [import `(do (extern ~(primitive/syntax->datum name)
                      :as "__error" :cc c [] (-> (ptr i32)))
                    (export ~(primitive/syntax->datum name)))]
    (os-pick-with-none `(do) `(do) import `(do))))
(wasm-errno-import wasm-errno)

;;; The errno accessor NAME, found with dlsym through HANDLE (the C library's
;;; RTLD_DEFAULT) and cached.
(defn dlsym-errno-cell [(name (ptr i8)) (handle (ptr i8))] (-> (ptr i32))
  (let [cache (primitive/alloc-static (ptr i8))]
    (if (= (primitive/cast i64 (load cache)) 0)
        (store! cache (dlsym handle name))
        0)
    (primitive/call-ptr (primitive/cast (fnptr c [] (ptr i32)) (load cache)))))

;;; This thread's errno cell.
(defn errno-cell [] (-> (ptr i32))
  (os-pick-with-none
    (dlsym-errno-cell c"__errno_location" (primitive/cast (ptr i8) 0))  ; glibc/musl
    (dlsym-errno-cell c"__error" (primitive/cast (ptr i8) -2))  ; Darwin
    (wasm-errno)
    (fail/fail! "errno" "this target has no operating system")))

;;; This thread's errno.
(defn errno [] (-> i64)
  (primitive/cast i64 (load (errno-cell))))

(extern strerror :cc c [i32] (-> (ptr i8)))

;;; The C library's description of errno `code`, such as "No such file or
;;; directory" for 2. The text is the C library's own storage: copy it before the
;;; next `errno-message` call on this thread if it must outlive that.
(defn errno-message [(code i64)] (-> (slice u8))
  (str/from-cstr (strerror (primitive/cast i32 code))))

;;; Set errno, typically to 0 before a call such as `readdir` that reports an
;;; error only through errno.
(defn set-errno! [(code i64)] (-> void)
  (store! (errno-cell) (primitive/cast i32 code)))

(extern getenv :cc c [(ptr i8)] (-> (ptr i8)))

(extern setenv :cc c [(ptr i8) (ptr i8) i32] (-> i32))

(extern unsetenv :cc c [(ptr i8)] (-> i32))

(extern getcwd :cc c [(ptr i8) isize] (-> (ptr i8)))

(extern chdir :cc c [(ptr i8)] (-> i32))

(extern open :cc c [(ptr i8) i32 ...] (-> i32))

(extern close :cc c [i32] (-> i32))

(extern pipe :cc c [(ptr i32)] (-> i32))

(extern dup2 :cc c [i32 i32] (-> i32))

(extern fcntl :cc c [i32 i32 ...] (-> i32))

(extern fork :cc c [] (-> i32))

(extern execvp :cc c [(ptr i8) (ptr (ptr i8))] (-> i32))

(extern waitpid :cc c [i32 (ptr i32) i32] (-> i32))

(extern kill :cc c [i32 i32] (-> i32))

(extern setpgid :cc c [i32 i32] (-> i32))

(extern getpid :cc c [] (-> i32))

(extern getppid :cc c [] (-> i32))

(extern _exit :cc c [i32] (-> never))

; ── making a child process ───────────────────────────────────────────────────
;
; `posix_spawn` lives here, in the one module that owns the process externs, and
; NOT beside each caller: extern declarations are not deduplicated across modules,
; so a second declaration anywhere in a linked program breaks the link. Both the
; test runner and the property runner need it, which is what forced the move.
;
; It is also the only child-making primitive in this library that is safe in a
; process that has THREADS, and a hosted program has more of those than it looks:
; a linked Go c-archive, CoreFoundation, a sanitizer runtime, or anything the user
; started. `fork` hands such a child an address space whose locks are held by
; threads that do not exist in it, and on macOS libSystem's own atfork handler is
; the first thing to walk into that:
;
;   fork -> libSystem_atfork_child -> _notify_fork_child -> _os_alloc_once
;        -> _os_once_gate_wait -> _os_once_gate_corruption_abort   (SIGKILL)
;
; The quieter half of the same hazard is worse, because it looks like a bug in the
; program under test: a child that inherits a HELD lock DEADLOCKS on its first call
; into the runtime that owns it. `posix_spawn` has neither problem — it builds a
; fresh process image and runs no atfork handlers at all.
(extern posix_spawnp
        :cc
        c
        [(ptr i32) (ptr i8) (ptr i8) (ptr i8) (ptr (ptr i8)) (ptr (ptr i8))]
        (-> i32))

;;; Returned by `spawn` instead of a pid when the spawn itself failed. Negative, so
;;; it can never collide with a real pid or with a wait status.
(const SPAWN-FAILED -1)

;;; Start `path` with `argv` and `env` in a new process; return its pid, or
;;; SPAWN-FAILED. `path` is looked up on PATH when it has no slash (posix_spawnp),
;;; which is what lets a program re-exec itself with the argv[0] it was started as.
(defn spawn [(path (ptr i8)) (argv (ptr (ptr i8))) (env (ptr (ptr i8)))] (-> i64)
  (let [pidp (primitive/alloc-stack i32)]
    (store! pidp 0)
    (if (= (posix_spawnp pidp
                         path
                         (primitive/cast (ptr i8) 0)
                         (primitive/cast (ptr i8) 0)
                         argv
                         env)
           (primitive/cast i32 0))
        (primitive/cast i64 (load pidp))
        SPAWN-FAILED)))

;;; The environment this process was started with, for handing to `spawn`.
;;;
;;; `posix_spawn` takes the child environment explicitly, and a re-exec'd child that
;;; loses the environment loses every knob CI set for it. `main`'s third C argument
;;; is the portable way to get it; reaching for `environ` is a per-platform special
;;; case. Whoever owns `main` publishes it here once, so any library that spawns can
;;; find it without threading it through every call.
(defstruct EnvBox [(envp (ptr (ptr i8)))])

(defn envp-cell [] (-> (ptr EnvBox))
  (primitive/alloc-static EnvBox))

(defn publish-envp! [(envp (ptr (ptr i8)))] (-> i64)
  (store! (field (envp-cell) envp) envp)
  0)

;;; NULL when nobody published one — `spawn` then gives the child an empty
;;; environment, which is a degraded child rather than a failure.
(defn spawn-envp [] (-> (ptr (ptr i8)))
  (load (field (envp-cell) envp)))

;;; Errors from hosted operating-system queries. `code` is the positive errno captured
;;; immediately after the failing libc call; `OutOfMemory` is allocator failure.
(defsum OsError
  (Syscall [(code i64)])
  (OutOfMemory)
  (InvalidInput))

(derive Eq OsError)

;;; `{}` is a message for a person; an errno reads as the operating system describes it.
(impl Display OsError
  (display-fmt [(e OsError) (f (ptr Formatter))] (-> i64)
    (let [w (writer f)]
      (match e
        (Syscall [code] (io/write-os-error w code))
        (OutOfMemory [] (io/print-str w "out of memory"))
        (InvalidInput [] (io/print-str w "invalid input"))))
    0))

;;; Allocator-owned bytes returned by OS queries. The slice is not NUL-terminated.
;;; Release it with `OwnedString::free!` and the allocator passed to the query.
(defstruct OwnedString
  [(bytes (slice u8))
   (capacity i64)])

(defn owned-string [(p (ptr i8)) (len i64) (capacity i64)] (-> OwnedString)
  (let [out (primitive/alloc-stack OwnedString)]
    (store! (field out bytes) (slice::new (primitive/cast (ptr u8) p) len))
    (store! (field out capacity) capacity)
    (load out)))

(impl OwnedString
  ;;; Borrow the owned value as an ordinary byte slice. Valid until
  ;;; `OwnedString::free!`.
  (slice [(s OwnedString)] (-> (slice u8))
    (load (field s bytes)))

  ;;; Release an owned OS string with the allocator the query was given. Calling
  ;;; this twice on the same object is safe.
  (free! [(a (dyn alloc/Allocator)) (s (ptr OwnedString))] (-> i64)
    (let [cap (load (field s capacity))]
      (if (> cap 0)
          (alloc/free-bytes a
                            (slice::new (data (load (field s bytes))) cap)
                            1)
          0)
      (store! (field s bytes) (slice::new (primitive/cast (ptr u8) 0) 0))
      (store! (field s capacity) 0)
      0)))

(defn copy-c-string [(a (dyn alloc/Allocator)) (p (ptr i8))] (-> (Result OwnedString
                                                                         OsError))
  (let [len (str/length-of-cstr p)
        cap (if (= len 0) 1 len)]
    (match (alloc/alloc-bytes a cap 1)
      (None [] (Err (OutOfMemory)))
      (Some [memory]
            (let [out (primitive/cast (ptr i8) (data memory))
                  (mut i) 0]
              (loop (if (>= (load i) len)
                        (break)
                        (do
                          (store! (primitive/index out (load i))
                                  (load (primitive/index p (load i))))
                          (store! i (+ (load i) 1)))))
              (Ok (owned-string out len cap)))))))

(defn slice-has-byte? [(s (slice u8)) (needle u8)] (-> bool)
  (let [(mut i) 0]
    (block :found
           (loop (if (>= (load i) (len s))
                     (break)
                     (if (= (load (primitive/index (data s) (load i)))
                            needle)
                         (return-from :found true)
                         (store! i (+ (load i) 1)))))
           false)))

(defn valid-env-name? [(name (slice u8))] (-> bool)
  (and (> (len name) 0)
       (and (not (slice-has-byte? name (primitive/cast u8 0)))
            (not (slice-has-byte? name (primitive/cast u8 61))))))

;;; Return an allocator-owned copy of an environment variable, or `None` when absent.
;;; Unlike libc `getenv`, the result remains valid across later environment mutations.
(defn get-env [(a (dyn alloc/Allocator)) (name (slice u8))] (-> (Result (Option OwnedString)
                                                                        OsError))
  (if (not (valid-env-name? name))
      (Err (InvalidInput))
      (let [cname (str/to-cstr a name)]
        (if (= (primitive/cast i64 cname) 0)
            (Err (OutOfMemory))
            (let [value (getenv cname)]
              (alloc/free-bytes a
                                (slice::new (primitive/cast (ptr u8) cname)
                                            (+ (len name) 1))
                                1)
              (if (= (primitive/cast i64 value) 0)
                  (Ok (None))
                  (match (copy-c-string a value)
                    (Err [e] (Err e))
                    (Ok [s] (Ok (Some s))))))))))

;;; Set an environment variable. Inputs are borrowed only for the duration of the call.
;;; Environment mutation is process-global and must be synchronized by the application.
(defn set-env! [(a (dyn alloc/Allocator))
               (name (slice u8))
               (value (slice u8))
               (overwrite bool)] (-> (Result i64 OsError))
  (if (or (not (valid-env-name? name))
          (slice-has-byte? value (primitive/cast u8 0)))
      (Err (InvalidInput))
      (let [cname (str/to-cstr a name)
            cvalue (str/to-cstr a value)]
        (if (or (= (primitive/cast i64 cname) 0)
                (= (primitive/cast i64 cvalue) 0))
            (do
              (if (!= (primitive/cast i64 cname) 0)
                  (alloc/free-bytes a
                                    (slice::new (primitive/cast (ptr u8) cname)
                                                (+ (len name) 1))
                                    1)
                  0)
              (if (!= (primitive/cast i64 cvalue) 0)
                  (alloc/free-bytes a
                                    (slice::new (primitive/cast (ptr u8) cvalue)
                                                (+ (len value) 1))
                                    1)
                  0)
              (Err (OutOfMemory)))
            (let [rc (setenv cname cvalue (if overwrite 1 0))
                  error (if (= rc 0) 0 (errno))]
              (alloc/free-bytes a
                                (slice::new (primitive/cast (ptr u8) cname)
                                            (+ (len name) 1))
                                1)
              (alloc/free-bytes a
                                (slice::new (primitive/cast (ptr u8) cvalue)
                                            (+ (len value) 1))
                                1)
              (if (= rc 0) (Ok 0) (Err (Syscall error))))))))

;;; Remove an environment variable. Removing an absent name succeeds.
(defn unset-env! [(a (dyn alloc/Allocator)) (name (slice u8))] (-> (Result i64
                                                                          OsError))
  (if (not (valid-env-name? name))
      (Err (InvalidInput))
      (let [cname (str/to-cstr a name)]
        (if (= (primitive/cast i64 cname) 0)
            (Err (OutOfMemory))
            (let [rc (unsetenv cname)
                  error (if (= rc 0) 0 (errno))]
              (alloc/free-bytes a
                                (slice::new (primitive/cast (ptr u8) cname)
                                            (+ (len name) 1))
                                1)
              (if (= rc 0) (Ok 0) (Err (Syscall error))))))))

;;; Return the current working directory in allocator-owned storage. The buffer grows
;;; until libc accepts it, so paths are not limited to a fixed PATH_MAX constant.
(defn current-dir [(a (dyn alloc/Allocator))] (-> (Result OwnedString OsError))
  (let [(mut cap) 256]
    (block :done
             (loop (match (alloc/alloc-bytes a (load cap) 1)
                     (None [] (return-from :done (Err (OutOfMemory))))
                     (Some [memory]
                           (let [buf
                                   (primitive/cast (ptr i8) (data memory))
                                 result
                                   (getcwd buf
                                           (primitive/cast isize (load cap)))]
                             (if (!= (primitive/cast i64 result) 0)
                                 (return-from :done
                                                (Ok (owned-string buf
                                                                       (str/length-of-cstr buf)
                                                                       (load cap))))
                                 (let [error (errno)]
                                   (alloc/free-bytes a memory 1)
                                   (if (= error 34)
                                       (if (> (load cap) 1073741824)
                                           (return-from :done
                                                          (Err (OutOfMemory)))
                                           (store! cap (* (load cap) 2)))
                                       (return-from :done (Err (Syscall error)))))))))))))

;;; Change the process current working directory. This process-global mutation is not
;;; synchronized by the library.
(defn change-dir [(a (dyn alloc/Allocator)) (path (slice u8))] (-> (Result i64
                                                                           OsError))
  (if (slice-has-byte? path (primitive/cast u8 0))
      (Err (InvalidInput))
      (let [cpath (str/to-cstr a path)]
        (if (= (primitive/cast i64 cpath) 0)
            (Err (OutOfMemory))
            (let [rc (chdir cpath)
                  error (if (= rc 0) 0 (errno))]
              (alloc/free-bytes a
                                (slice::new (primitive/cast (ptr u8) cpath)
                                            (+ (len path) 1))
                                1)
              (if (= rc 0) (Ok 0) (Err (Syscall error))))))))
