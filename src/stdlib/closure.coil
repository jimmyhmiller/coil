(module coil.closure)
(import "coil.primitive" :as primitive)
(import "coil.alloc" :as alloc)
(import "coil.arc.auto-runtime" :as auto)

; Closure library — written entirely in Coil macros. `(import "coil.closure")`
; then `(defclosure NAME [captures] [params] RET body...)` to get a heap closure
; with NAME-new / NAME-call / NAME-set-code! / NAME-free. The generated closure
; implements core Callable, so a closure value may sit directly in call position.
; Its typed code slot can be replaced by a JIT/REPL without changing call sites.

;;; Stage-3 comptime helpers (walk by index over Code vectors of (name type) pairs).
;;; Built with growable code lists: `(~x ~@(self …)) re-splices the recursion's
;;; suffix at every level — quadratic in the param/capture count
;;; (docs/design/META_MEMORY.md).
(defn cl--param-types [(ps Code) (i i64)] (-> Code)
  (let [out (primitive/code-list-new)
        (mut k) i]
    (loop (if (= (load k) (primitive/code-count ps))
              (break)
              (do
                (primitive/code-list-push! out (primitive/code-nth (primitive/code-nth ps (load k)) 1))
                (store! k (primitive/iadd (load k) 1)))))
    (primitive/code-list-done out)))

(defn cl--param-names [(ps Code) (i i64)] (-> Code)
  (let [out (primitive/code-list-new)
        (mut k) i]
    (loop (if (= (load k) (primitive/code-count ps))
              (break)
              (do
                (primitive/code-list-push! out (primitive/code-nth (primitive/code-nth ps (load k)) 0))
                (store! k (primitive/iadd (load k) 1)))))
    (primitive/code-list-done out)))

;;; let-bindings that load each capture out of the env: name (primitive/load (primitive/field __self name)) …
(defn cl--cap-loads [(caps Code) (self Code) (i i64)] (-> Code)
  (let [out (primitive/code-list-new)
        (mut k) i]
    (loop (if (= (load k) (primitive/code-count caps))
              (break)
              (let [nm (primitive/code-nth (primitive/code-nth caps (load k)) 0)]
                (do
                  (primitive/code-list-push! out nm)
                  (primitive/code-list-push! out `(load (field ~self ~nm)))
                  (store! k (primitive/iadd (load k) 1))))))
    (primitive/code-list-done out)))

(defn cl--cap-reads [(caps Code) (self Code) (i i64)] (-> Code)
  (let [out (primitive/code-list-new)
        (mut k) i]
    (loop (if (= (load k) (primitive/code-count caps))
              (break)
              (let [nm (primitive/code-nth (primitive/code-nth caps (load k)) 0)]
                (do
                  (primitive/code-list-push! out nm)
                  (primitive/code-list-push! out `(~(primitive/code-symbol "." nm) ~self))
                  (store! k (primitive/iadd (load k) 1))))))
    (primitive/code-list-done out)))

(defn cl--arc-cap-reads [(caps Code) (self Code) (i i64)] (-> Code)
  (let [out (primitive/code-list-new)
        (mut k) i]
    (loop (if (= (load k) (primitive/code-count caps))
              (break)
              (let [nm (primitive/code-nth (primitive/code-nth caps (load k)) 0)]
                (do
                  (primitive/code-list-push! out nm)
                  ; A capture field remains owned by the environment. The
                  ; call-local binding is a new owner and must retain it.
                  (primitive/code-list-push! out
                                             `(clone (~(primitive/code-symbol "." nm) ~self)))
                  (store! k (primitive/iadd (load k) 1))))))
    (primitive/code-list-done out)))

(defn cl--cap-stores [(caps Code) (env Code) (i i64)] (-> Code)
  (let [out (primitive/code-list-new)
        (mut k) i]
    (loop (if (= (load k) (primitive/code-count caps))
              (break)
              (let [nm (primitive/code-nth (primitive/code-nth caps (load k)) 0)]
                (do
                  (primitive/code-list-push! out `(store! (field ~env ~nm) ~nm))
                  (store! k (primitive/iadd (load k) 1))))))
    (primitive/code-list-done out)))

(defn cl--named-caps [(caps Code) (i i64)] (-> Code)
  (let [out (primitive/code-list-new)
        (mut k) i]
    (loop (if (= (load k) (primitive/code-count caps))
              (break)
              (let [nm (primitive/code-nth (primitive/code-nth caps (load k)) 0)]
                (do
                  (primitive/code-list-push! out (primitive/code-symbol ":" nm))
                  (primitive/code-list-push! out nm)
                  (store! k (primitive/iadd (load k) 1))))))
    (primitive/code-list-done out)))

(defn defclosure [(name Code) (caps Code) (params Code) (ret Code) & (body Code)] (-> Code)
  (let [; These are deliberately caller-visible declarations (`adder-new`,
        ; etc.), so their use-site spelling protocol is explicit context removal.
        ; hygiene: the generated closure API intentionally enters the caller-visible namespace.
        env-name (primitive/syntax->datum (primitive/code-symbol name "-env"))
        code-name (primitive/syntax->datum (primitive/code-symbol name "-code"))
        new-name (primitive/syntax->datum (primitive/code-symbol name "-new"))
        call-name (primitive/syntax->datum (primitive/code-symbol name "-call"))
        set-code-name (primitive/syntax->datum (primitive/code-symbol name "-set-code!"))
        free-name (primitive/syntax->datum (primitive/code-symbol name "-free"))
        self-id (primitive/fresh-identifier "self")
        env-id (primitive/fresh-identifier "environment")
        closure-id (primitive/fresh-identifier "closure")
        code-id (primitive/fresh-identifier "code")]
    `(do
       (defstruct ~env-name [~@caps])
       (defn ~code-name [(~self-id (ptr ~env-name)) ~@params] (-> ~ret)
         (let [~@(cl--cap-loads caps self-id 0)] ~@body))
       (defstruct ~name
         [(code (fnptr c [(ptr ~env-name) ~@(cl--param-types params 0)] ~ret))
          (env (ptr ~env-name))])
       (defn ~new-name [~@caps] (-> (ptr ~name))
         (let [~env-id (alloc/box! (alloc/malloc-allocator) ~env-name (zeroed ~env-name))
               ~closure-id (alloc/box! (alloc/malloc-allocator) ~name (zeroed ~name))]
           ~@(cl--cap-stores caps env-id 0)
           (store! (field ~closure-id code) (primitive/fnptr-of ~code-name))
           (store! (field ~closure-id env) ~env-id)
           ~closure-id))
       (defn ~call-name [(~closure-id (ptr ~name)) ~@params] (-> ~ret)
         (primitive/call-ptr (load (field ~closure-id code))
                             (load (field ~closure-id env))
                             ~@(cl--param-names params 0)))
       (impl coil.core.Callable (ptr ~name)
         (call [(~closure-id (ptr ~name)) ~@params]
               (-> ~ret)
               (~call-name ~closure-id ~@(cl--param-names params 0))))
       (defn ~set-code-name [(~closure-id (ptr ~name))
                             (~code-id (fnptr c [(ptr ~env-name) ~@(cl--param-types params 0)] ~ret))] (-> i64)
         (do (store! (field ~closure-id code) ~code-id) 0))
       (defn ~free-name [(~closure-id (ptr ~name))] (-> i64)
         (do
           (alloc/destroy (alloc/malloc-allocator) (load (field ~closure-id env)))
           (alloc/destroy (alloc/malloc-allocator) ~closure-id))))))

;;; Ownership-neutral closure expansion used by the transparent ARC transform.
;;; It emits only ordinary values and field operations; representation lowering,
;;; capture retains, and destruction are then handled by the ownership pass.
(defn defarcclosure [(name Code) (caps Code) (params Code) (ret Code) & (body Code)] (-> Code)
  (let [; hygiene: the generated ARC closure API intentionally enters the caller-visible namespace.
        env-name (primitive/syntax->datum (primitive/code-symbol name "-env"))
        code-name (primitive/syntax->datum (primitive/code-symbol name "-code"))
        new-name (primitive/syntax->datum (primitive/code-symbol name "-new"))
        call-name (primitive/syntax->datum (primitive/code-symbol name "-call"))
        set-code-name (primitive/syntax->datum (primitive/code-symbol name "-set-code!"))
        ; hygiene: transparent ARC payload and wrapper declarations intentionally use the transformed module's stable public naming protocol.
        payload-name (primitive/syntax->datum (primitive/code-symbol "arc-auto-payload-" name))
        wrap-name (primitive/syntax->datum (primitive/code-symbol name "-auto-wrap"))
        borrow-name (primitive/syntax->datum (primitive/code-symbol name "-auto-borrow"))
        env-payload-name
          (primitive/syntax->datum (primitive/code-symbol "arc-auto-payload-" env-name))
        env-wrap-name (primitive/syntax->datum (primitive/code-symbol env-name "-auto-wrap"))
        self-id (primitive/fresh-identifier "self")
        env-id (primitive/fresh-identifier "environment")
        closure-id (primitive/fresh-identifier "closure")
        code-id (primitive/fresh-identifier "code")]
    `(do
       (defstruct ~env-name
         [~@caps (auto-lifecycle-token auto/AutoObjectToken)])
       (defn ~code-name [(~self-id (ptr ~env-name)) ~@params] (-> ~ret)
         (let [~@(cl--arc-cap-reads caps self-id 0)] ~@body))
       (defstruct ~name
         [(code (fnptr c [(ptr ~env-name) ~@(cl--param-types params 0)] ~ret))
          (env ~env-name)
          (auto-lifecycle-token auto/AutoObjectToken)])
       (defn ~new-name [~@caps] (-> ~name)
         (let [~env-id
                 (~env-wrap-name (~env-payload-name ~@(cl--named-caps caps 0)
                                    :auto-lifecycle-token
                                    (auto/auto-object-token)))]
           (~wrap-name (~payload-name
                         :code (primitive/fnptr-of ~code-name)
                         :env ~env-id
                         :auto-lifecycle-token (auto/auto-object-token)))))
       (defn ~call-name [(~closure-id (ref ~name)) ~@params] (-> ~ret)
         (let [~self-id (~borrow-name ~closure-id)]
           (primitive/call-ptr (load (field ~self-id code))
                               (field ~self-id env)
                               ~@(cl--param-names params 0))))
       (impl coil.core.Callable ~name
         (call [(~closure-id (ref ~name)) ~@params]
               (-> ~ret)
               (~call-name ~closure-id ~@(cl--param-names params 0))))
       (defn ~set-code-name [(~closure-id (mut ~name))
                             (~code-id (fnptr c [(ptr ~env-name) ~@(cl--param-types params 0)] ~ret))] (-> i64)
         (let [~self-id (~borrow-name ~closure-id)]
           (do (store! (field ~self-id code) ~code-id) 0))))))
