;;; The terminal's opt-in Var policy for retained JIT sessions.
;;; Import this module and use `(coil.repl/publish)` as the transaction entry.
;;; Only functions in that entry's module are lowered. Accepted implementations
;;; are never returned as source: Code session state contains identities only.
;;;
;;; It is also how the terminal prints: an expression it evaluates arrives after
;;; a `(coil.repl/show)` marker, and a value whose type has neither Debug nor
;;; Display is printed from its structure (see `show`).
(module coil.repl)
(import "coil.primitive" :as primitive)
(import "coil.slice" :use [subslice])
(import "coil.var" :as var)
(import "coil.jit.lifetime")
(import "coil.jit.reload" :as reload)
(import "coil.io" :as io)
(import "coil.fmt" :use [fmt print-nl])

(export publish var-module show write-address end-line elements)

;;; The transform replaces this marker with this submission's Var updates.
(defn publish [] (-> Code)
  (primitive/error "coil.repl/publish must be the direct transaction entry expression"))

;;; A source module can opt into Var-backed functions at initial load without
;;; publishing an update. Subsequent edits still use `publish` in the session.
(defn var-module [] (-> Code)
  (primitive/error "coil.repl/var-module must be a direct module marker"))

(defn publication? [(x Code)] (-> bool)
  (and (primitive/code-list? x)
       (and (= (primitive/code-count x) 1)
            (primitive/code-eq (primitive/code-nth x 0) `coil.repl/publish))))

(defn var-module-marker? [(x Code)] (-> bool)
  (and (primitive/code-list? x)
       (and (= (primitive/code-count x) 1)
            (primitive/code-eq (primitive/code-nth x 0) `coil.repl/var-module))))

(defn contains-var-module? [(m Code)] (-> bool)
  (let [(mut found) false]
    (for [i 1 (primitive/code-count m)]
      (let [f (primitive/code-nth m i)]
        (when (and (reload/rr-defn? f)
                   (and (= (primitive/code-count f) 5)
                        (var-module-marker? (primitive/code-nth f 4))))
          (set! found true)
          0)))
    (load found)))

(defn contains-publication? [(m Code)] (-> bool)
  (let [(mut found) false]
    (for [i 1 (primitive/code-count m)]
      (let [f (primitive/code-nth m i)]
        (when (and (reload/rr-defn? f)
                   (and (= (primitive/code-count f) 5)
                        (publication? (primitive/code-nth f 4))))
          (set! found true)
          0)))
    (load found)))

(defn insert-publication [(m Code) (updates Code)] (-> Code)
  (let [out (primitive/code-list-new)]
    (primitive/code-list-push! out (primitive/code-nth m 0))
    (for [i 1 (primitive/code-count m)]
      (let [f (primitive/code-nth m i)]
        (primitive/code-list-push! out
                                   (if (and (reload/rr-defn? f)
                                            (and (= (primitive/code-count f) 5)
                                                 (publication? (primitive/code-nth f
                                                                                   4))))
                                       `(~(primitive/code-nth f 0) ~(primitive/code-nth f
                                                                                        1)
                                           ~(primitive/code-nth f 2)
                                           ~(primitive/code-nth f 3)
                                           (do ~@updates 0))
                                       f))))
    (primitive/code-list-done out)))

; Declaration annotations precede the parameter vectors. Keep their span
; separate from the signature and body when lowering a published function.
(defn definition-header [(f Code)] (-> i64)
  (let [(mut at) 2]
    (loop (if (and (< (load at) (primitive/code-count f))
                   (primitive/code-keyword? (primitive/code-nth f (load at))))
              (set! at (+ (load at) 2))
              (break)))
    (load at)))

(defn generic-definition? [(f Code)] (-> bool)
  (and (reload/rr-defn? f)
       (let [at (definition-header f)]
         (and (< (+ at 1) (primitive/code-count f))
              (and (primitive/code-vector? (primitive/code-nth f at))
                   (primitive/code-vector? (primitive/code-nth f (+ at 1))))))))

(defn definition-params [(f Code)] (-> i64)
  (+ (definition-header f) (if (generic-definition? f) 1 0)))

(defn runtime-definition? [(f Code)] (-> bool)
  (and (reload/rr-defn? f)
       (and (primitive/code-eq (primitive/code-nth f 0) `defn)
            (and (not (generic-definition? f))
                 (not (primitive/code-eq (primitive/code-nth (primitive/code-nth f (+ (definition-params f) 1))
                                                             1)
                                         `Code))))))

;;; A generic runtime function: a template, specialized where it is used, so it
;;; has no single function pointer to keep in a Var. The policy gives each version
;;; of the template a fresh identity and binds the authored name to it with
;;; `defalias`; a later submission rebinds the alias. New uses specialize the
;;; accepted replacement, code accepted earlier keeps the specialization it bound,
;;; and a rejected submission leaves the prior binding in place.
(defn generic-runtime-definition? [(f Code)] (-> bool)
  (and (generic-definition? f)
       (and (primitive/code-eq (primitive/code-nth f 0) `defn)
            (not (primitive/code-eq (primitive/code-nth (primitive/code-nth f (+ (definition-params f) 1))
                                                        1)
                                    `Code)))))

(defn known? [(identities Code) (module Code) (name Code)] (-> bool)
  (let [(mut found) false]
    (for [i 0 (primitive/code-count identities)]
      (let [item (primitive/code-nth identities i)]
        (when (and (primitive/code-eq (primitive/code-nth item 0) module)
                   (primitive/bound-identifier=? (primitive/code-nth item 1)
                                                 name))
          (set! found true)
          0)))
    (load found)))

;;; Where `name` sits among the published identities, or -1. The registry only
;;; grows, so this is a Var's stable number in its session.
(defn identity-index [(identities Code) (module Code) (name Code)] (-> i64)
  (let [(mut found) -1]
    (for [i 0 (primitive/code-count identities)]
      (let [item (primitive/code-nth identities i)]
        (when (and (primitive/code-eq (primitive/code-nth item 0) module)
                   (primitive/bound-identifier=? (primitive/code-nth item 1)
                                                 name))
          (set! found i)
          0)))
    found))

;;; Does module form list M define `name` again after its form AT?
(defn redefined-later? [(m Code) (at i64) (name Code)] (-> bool)
  (let [(mut found) false]
    (for [j (+ at 1) (primitive/code-count m)]
      (let [g (primitive/code-nth m j)]
        (when (and (runtime-definition? g)
                   (primitive/bound-identifier=? (primitive/code-nth g 1) name))
          (set! found true)
          0)))
    found))

;;; The `:params` annotation recorded when `name` was first published. The
;;; Var's `def` is emitted once, so its names are fixed with its parameter types.
(defn known-params-annotation [(identities Code) (module Code) (name Code)] (-> Code)
  (let [(mut found) `()
        (mut hit) false]
    (for [i 0 (primitive/code-count identities)]
      (let [item (primitive/code-nth identities i)]
        (when (and (primitive/code-eq (primitive/code-nth item 0) module)
                   (primitive/bound-identifier=? (primitive/code-nth item 1)
                                                 name))
          (set! found (primitive/code-nth item 2))
          (set! hit true)
          0)))
    (unless (load hit)
      (primitive/error "coil.repl: no published identity for a known REPL function"))
    (load found)))

(defn parameter-types [(m Code) (params Code)] (-> Code)
  (let [out (primitive/code-list-new)]
    (for [i 0 (primitive/code-count params)]
      (let [t (reload/rr-param-type (primitive/code-nth params i))]
        (primitive/code-list-push! out
                                   (if (or (reload/rr-struct-type? m t) (struct-type? t))
                                       `(ref ~t)
                                       t))))
    (primitive/code-list-done out)))

;;; The defn in `m` that this submission publishes as `name`'s Var, or an empty
;;; list.
(defn published-defn [(m Code) (name Code)] (-> Code)
  (let [(mut found) `()]
    (for [i 1 (primitive/code-count m)]
      (let [f (primitive/code-nth m i)]
        (when (and (runtime-definition? f)
                   (primitive/free-identifier=? (primitive/code-nth f 1) name))
          (set! found f)
          0)))
    (load found)))

;;; `(export-c …)` naming a function published as a Var. The Var is a data cell,
;;; not a function, so each such item exports a trampoline under the same C
;;; symbol instead; it calls through the Var, so C callers always reach the
;;; current definition. `trampolines` receives the trampoline defns.
(defn lower-export [(m Code) (known Code) (f Code) (trampolines CodeBuilder)] (-> Code)
  (let [items (primitive/code-list-new)]
    (primitive/code-list-push! items (primitive/code-nth f 0))
    (for [i 1 (primitive/code-count f)]
      (let [item (primitive/code-nth f i)
            name (if (primitive/code-vector? item) (primitive/code-nth item 0) item)
            c-name
              (if (and (primitive/code-vector? item) (>= (primitive/code-count item) 3))
                  (primitive/code-nth item 2)
                  `~(primitive/code-str name))
            source (published-defn m name)]
        (cond (> (primitive/code-count source) 0)
                ; A distinct readable name: export-c resolves the symbol it names
                ; by spelling, and `name` itself is now the Var.
                ; hygiene: export-c names the trampoline by its module-level spelling.
                (let [entry (primitive/syntax->datum (primitive/code-symbol name "--c-export"))
                      params (primitive/code-nth source (definition-params source))
                      formals (primitive/code-list-new)
                      actuals (primitive/code-list-new)]
                  (for [k 0 (primitive/code-count params)]
                    (let [p (primitive/fresh-identifier "argument")]
                      (primitive/code-list-push! formals
                                                 `(~p ~(reload/rr-param-type (primitive/code-nth params k))))
                      (primitive/code-list-push! actuals p)
                      0))
                  (primitive/code-list-push! trampolines
                                             `(defn ~entry [~@(primitive/code-list-done formals)]
                                                ~(primitive/code-nth source (+ (definition-params source) 1))
                                                (~name ~@(primitive/code-list-done actuals))))
                  (primitive/code-list-push! items `[~entry :as ~c-name])
                  0)
              (known? known (primitive/code-nth m 0) name)
                (do
                  (primitive/report item
                                    "export-c of a REPL function published by an earlier submission: submit its defn with the export-c so the trampoline has its signature")
                  (primitive/code-list-push! items item)
                  0)
              :else (do (primitive/code-list-push! items item) 0))))
    (primitive/code-list-done items)))

;;; The function whose address `(fnptr-of NAME)` takes for a REPL function. NAME
;;; is a Var, not a function; this trampoline calls through it, so a pointer taken
;;; once keeps reaching the current definition after a redefinition.
(defn fnptr-trampoline-name [(name Code)] (-> Code)
  ; hygiene: later submissions name the trampoline by its module-level spelling.
  (primitive/syntax->datum (primitive/code-symbol name "--fnptr")))

(defn fnptr-trampoline [(name Code) (f Code)] (-> Code)
  (let [params (primitive/code-nth f (definition-params f))
        formals (primitive/code-list-new)
        actuals (primitive/code-list-new)]
    (for [k 0 (primitive/code-count params)]
      (let [p (primitive/fresh-identifier "argument")]
        (primitive/code-list-push! formals
                                   `(~p ~(reload/rr-param-type (primitive/code-nth params k))))
        (primitive/code-list-push! actuals p)
        0))
    `(defn ~(fnptr-trampoline-name name) [~@(primitive/code-list-done formals)]
       ~(primitive/code-nth f (+ (definition-params f) 1))
       (~name ~@(primitive/code-list-done actuals)))))

(defn fnptr-of-head? [(x Code)] (-> bool)
  (and (primitive/code-sym? x)
       (let [s (primitive/code-str x)
             n (len s)]
         (and (>= n 8) (= (subslice s (- n 8) n) "fnptr-of")
              (or (= n 8) (= (get s (- n 9)) (: 47 u8)))))))

(defn repl-function? [(m Code) (known Code) (publishing bool) (name Code)] (-> bool)
  (or (known? known (primitive/code-nth m 0) name)
      (and publishing (> (primitive/code-count (published-defn m name)) 0))))

;;; `f` with each `(fnptr-of NAME)` of a REPL function pointed at its trampoline.
(defn rewrite-fnptr-of [(m Code) (known Code) (publishing bool) (f Code)] (-> Code)
  (if (not (primitive/code-list? f))
      f
      (if (and (= (primitive/code-count f) 2)
               (and (fnptr-of-head? (primitive/code-nth f 0))
                    (and (primitive/code-sym? (primitive/code-nth f 1))
                         (repl-function? m known publishing (primitive/code-nth f 1)))))
          `(~(primitive/code-nth f 0) ~(fnptr-trampoline-name (primitive/code-nth f 1)))
          (let [kids (primitive/code-list-new)]
            (for [i 0 (primitive/code-count f)]
              (primitive/code-list-push! kids (rewrite-fnptr-of m known publishing (primitive/code-nth f i)))
              0)
            (primitive/code-list-like f (primitive/code-list-done kids))))))

(defn export-form? [(f Code)] (-> bool)
  (and (primitive/code-list? f)
       (> (primitive/code-count f) 0)
       (primitive/code-eq (primitive/code-nth f 0) `export-c)))

;;; `(name [params] (-> ret) body…)`: the form that ends an impl's header.
(defn impl-method-form? [(x Code)] (-> bool)
  (and (primitive/code-list? x)
       (and (>= (primitive/code-count x) 3)
            (and (reload/rr-vector? (primitive/code-nth x 1))
                 (let [ret (primitive/code-nth x 2)]
                   (and (primitive/code-list? ret)
                        (and (> (primitive/code-count ret) 0)
                             (primitive/code-eq (primitive/code-nth ret 0) `->))))))))

(defn impl-form? [(f Code)] (-> bool)
  (and (primitive/code-list? f)
       (and (> (primitive/code-count f) 2)
            (primitive/code-eq (primitive/code-nth f 0) `impl))))

;;; The retirement of the impl `f` declares. A REPL function submitted again
;;; replaces the accepted one, so an impl submitted again does too: the compiler
;;; keeps its strict duplicate-impl error, and this policy says the earlier impl is
;;; being replaced. The retirement header is the impl's own header, `[T…] Trait
;;; Type` for a trait impl and `[T…] Type` for an inherent one. Retiring an impl
;;; that was never accepted has no effect, so a first submission is unchanged.
;;; Code accepted earlier keeps the impl it bound.
(defn impl-retirement [(f Code)] (-> Code)
  (let [base (if (reload/rr-vector? (primitive/code-nth f 1)) 2 1)
        inherent (and (> (primitive/code-count f) (+ base 1))
                      (impl-method-form? (primitive/code-nth f (+ base 1))))
        end (+ base (if inherent 1 2))
        out (primitive/code-list-new)]
    (primitive/code-list-push! out (if inherent `retire-inherent `retire-impl))
    (for i (range 1 end)
      (primitive/code-list-push! out (primitive/code-nth f i))
      0)
    (primitive/code-list-done out)))

;;; ---- compile-time twins --------------------------------------------------
;;; A `const` initializer or `(comptime …)` form runs inside the compiler, which
;;; evaluates the functions it reaches from their checked bodies. A function this
;;; policy publishes is a `Var`, a runtime cell whose contents exist only once the
;;; program runs, so compile-time code cannot call it. Compile-time evaluation reads
;;; source, not a cell, so each published function of the submission that such an
;;; expression reaches (through calls, transitively) also gets a plain twin with the
;;; same body, and the expression calls the twin. A twin is an ordinary retained
;;; function, so a constant used by a later submission still evaluates. The published
;;; Var, and every runtime call through it, is unchanged.

(defn code-node? [(f Code)] (-> bool)
  (or (primitive/code-list? f) (primitive/code-vector? f)))

(defn published-name? [(m Code) (name Code)] (-> bool)
  (> (primitive/code-count (published-defn m name)) 0))

(defn name-in? [(names Code) (name Code)] (-> bool)
  (let [(mut found) false]
    (for [i 0 (primitive/code-count names)]
      (when (primitive/free-identifier=? (primitive/code-nth names i) name)
        (set! found true)
        0))
    (load found)))

(defn const-form? [(f Code)] (-> bool)
  (and (primitive/code-list? f)
       (and (>= (primitive/code-count f) 3)
            (primitive/code-eq (primitive/code-nth f 0) `const))))

(defn comptime-form? [(f Code)] (-> bool)
  (and (primitive/code-list? f)
       (and (= (primitive/code-count f) 2)
            (primitive/code-eq (primitive/code-nth f 0) `comptime))))

;;; `names` plus each published function of `m` that `f` calls, once each.
(defn call-heads [(m Code) (f Code) (names Code)] (-> Code)
  (if (not (code-node? f))
      names
      (let [(mut out) names]
        (when (and (primitive/code-list? f)
                   (and (> (primitive/code-count f) 0)
                        (and (primitive/code-sym? (primitive/code-nth f 0))
                             (and (published-name? m (primitive/code-nth f 0))
                                  (not (name-in? (load out) (primitive/code-nth f 0)))))))
          (set! out `(~@(load out) ~(primitive/code-nth f 0)))
          0)
        (for [i 0 (primitive/code-count f)]
          (set! out (call-heads m (primitive/code-nth f i) (load out)))
          0)
        (load out))))

;;; The published functions reached from a const initializer or a `(comptime …)`
;;; form anywhere in `f`.
(defn comptime-heads [(m Code) (f Code) (names Code)] (-> Code)
  (cond (not (code-node? f)) names
        (const-form? f) (call-heads m (primitive/code-nth f (- (primitive/code-count f) 1)) names)
        (comptime-form? f) (call-heads m (primitive/code-nth f 1) names)
        :else
          (let [(mut out) names]
            (for [i 0 (primitive/code-count f)]
              (set! out (comptime-heads m (primitive/code-nth f i) (load out)))
              0)
            (load out))))

;;; Every published function compile-time code of `m` reaches, transitively.
(defn twin-closure [(m Code)] (-> Code)
  (let [(mut names) `()]
    (for [i 1 (primitive/code-count m)]
      (set! names (comptime-heads m (primitive/code-nth m i) (load names)))
      0)
    (let [(mut k) 0]
      (loop (if (>= (load k) (primitive/code-count (load names)))
                (break)
                (let [f (published-defn m (primitive/code-nth (load names) (load k)))]
                  (for [j (+ (definition-params f) 2) (primitive/code-count f)]
                    (set! names (call-heads m (primitive/code-nth f j) (load names)))
                    0)
                  (set! k (+ (load k) 1))))))
    (load names)))

;;; `((name twin) …)`: one fresh identity per name.
(defn twin-table [(names Code)] (-> Code)
  (let [out (primitive/code-list-new)]
    (for [i 0 (primitive/code-count names)]
      (let [name (primitive/code-nth names i)]
        (primitive/code-list-push! out `(~name ~(primitive/fresh-identifier (primitive/code-str (primitive/code-symbol name "--comptime")))))
        0))
    (primitive/code-list-done out)))

(defn twin-has? [(twins Code) (name Code)] (-> bool)
  (let [(mut found) false]
    (for [i 0 (primitive/code-count twins)]
      (when (primitive/free-identifier=? (primitive/code-nth (primitive/code-nth twins i) 0) name)
        (set! found true)
        0))
    (load found)))

(defn twin-of [(twins Code) (name Code)] (-> Code)
  (let [(mut found) `()]
    (for [i 0 (primitive/code-count twins)]
      (let [entry (primitive/code-nth twins i)]
        (when (primitive/free-identifier=? (primitive/code-nth entry 0) name)
          (set! found (primitive/code-nth entry 1))
          0)))
    (load found)))

;;; `f` with each call to a twinned function pointed at its twin.
(defn twin-rename [(twins Code) (f Code)] (-> Code)
  (if (not (code-node? f))
      f
      (let [kids (primitive/code-list-new)]
        (for [i 0 (primitive/code-count f)]
          (let [child (primitive/code-nth f i)]
            (primitive/code-list-push!
              kids
              (if (and (= i 0)
                       (and (primitive/code-list? f)
                            (and (primitive/code-sym? child)
                                 (twin-has? twins child))))
                  (twin-of twins child)
                  (twin-rename twins child)))
            0))
        (primitive/code-list-like f (primitive/code-list-done kids)))))

;;; `f` with the calls inside its const initializers and `(comptime …)` forms
;;; pointed at twins.
(defn twin-uses [(twins Code) (f Code)] (-> Code)
  (cond (not (code-node? f)) f
        (const-form? f)
          (let [kids (primitive/code-list-new)
                last (- (primitive/code-count f) 1)]
            (for [i 0 (primitive/code-count f)]
              (primitive/code-list-push!
                kids
                (if (= i last)
                    (twin-rename twins (primitive/code-nth f i))
                    (primitive/code-nth f i)))
              0)
            (primitive/code-list-like f (primitive/code-list-done kids)))
        (comptime-form? f)
          (primitive/code-list-like f `(~(primitive/code-nth f 0)
                                        ~(twin-rename twins (primitive/code-nth f 1))))
        :else
          (let [kids (primitive/code-list-new)]
            (for [i 0 (primitive/code-count f)]
              (primitive/code-list-push! kids (twin-uses twins (primitive/code-nth f i)))
              0)
            (primitive/code-list-like f (primitive/code-list-done kids)))))

;;; The plain twin of the published function `name`.
(defn twin-defn [(m Code) (twins Code) (name Code)] (-> Code)
  (let [f (published-defn m name)
        body (primitive/code-list-new)]
    (for [j (+ (definition-params f) 2) (primitive/code-count f)]
      (primitive/code-list-push! body (twin-rename twins (primitive/code-nth f j)))
      0)
    `(defn ~(twin-of twins name)
       ~@(reload/rr-body f 2 (+ (definition-params f) 2))
       ~@(primitive/code-list-done body))))

(defn lower-module [(m Code) (identities CodeBuilder) (known Code) (retained bool)] (-> Code)
  (let [out (primitive/code-list-new)
        updates (primitive/code-list-new)
        module (primitive/code-nth m 0)
        twin-names (twin-closure m)
        twins (if (= (primitive/code-count twin-names) 0) `() (twin-table twin-names))
        (mut seen) known]
    (primitive/code-list-push! out module)
    (for [t 0 (primitive/code-count twin-names)]
      (primitive/code-list-push! out (twin-defn m twins (primitive/code-nth twin-names t)))
      0)
    (for [i 1 (primitive/code-count m)]
      (let [f (let [g (rewrite-fnptr-of m known true (primitive/code-nth m i))]
                (if (= (primitive/code-count twins) 0) g (twin-uses twins g)))]
        (if (and (reload/rr-defn? f)
                 (and (= (primitive/code-count f) 5)
                      (var-module-marker? (primitive/code-nth f 4))))
            0
        (if (export-form? f)
            (let [trampolines (primitive/code-list-new)
                  lowered (lower-export m known f trampolines)]
              (for t (iter (primitive/code-list-done trampolines))
                (primitive/code-list-push! out t)
                0)
              (primitive/code-list-push! out lowered)
              0)
        (if (generic-runtime-definition? f)
            (let [name (primitive/code-nth f 1)
                  ; Distinct from the alias that binds the published name, as the
                  ; Var implementation is (below).
                  template (primitive/fresh-identifier (primitive/code-str (primitive/code-symbol name "--template")))]
              (primitive/code-list-push! out
                                         `(defn ~template
                                            ~@(reload/rr-body f 2 (primitive/code-count f))))
              (primitive/code-list-push! out `(defalias ~name ~template))
              0)
        (if (runtime-definition? f)
            (let [name (primitive/code-nth f 1)
                  ; The implementation and the Var share the published name's
                  ; qualification, and compile-time code that reaches the name finds the
                  ; implementation's body where it means the Var. A distinct spelling
                  ; keeps the two apart.
                  implementation
                    (primitive/fresh-identifier (primitive/code-str (primitive/code-symbol name "--impl")))
                  params (primitive/code-nth f (definition-params f))
                  names (reload/rr-params-annotation params)
                  retform (primitive/code-nth f (+ (definition-params f) 1))
                  ret (primitive/code-nth retform 1)]
              ; The Var holds its current implementation at run time, where no
              ; dependency is visible, so that implementation is the Var's
              ; metadata root: numbered by the Var, newest by submission. An
              ; implementation the Var no longer holds is released.
              ; A submission that defines the name again later publishes that
              ; one; this one is never held, and a root moves once a submission.
              (if (redefined-later? m i name)
                  (primitive/code-list-push! out
                                             `(defn ~implementation
                                                ~@(reload/rr-body f 2 (definition-header f))
                                                :jit/retain false
                                                ~params
                                                ~retform
                                                ~@(reload/rr-body f
                                                                  (+ (definition-params f) 2)
                                                                  (primitive/code-count f))))
                  (let [at (identity-index (load seen) module name)
                        root (+ 1 (if (< at 0) (primitive/code-count (load seen)) at))
                        version (primitive/code-session-submission)]
                    (primitive/code-list-push! out
                                               `(defn ~implementation
                                                  ~@(reload/rr-body f 2 (definition-header f))
                                                  :jit/retain false
                                                  :jit/root ~root :jit/root-version ~version
                                                  ~params
                                                  ~retform
                                                  ~@(reload/rr-body f
                                                                    (+ (definition-params f) 2)
                                                                    (primitive/code-count f))))))
              (when (and (known? (load seen) module name)
                         (not (primitive/code-eq (known-params-annotation (load seen)
                                                                    module
                                                                    name)
                                                 names)))
                (primitive/report f
                                  "cannot redefine a REPL function with different parameter names; they are part of its published signature")
                0)
              (unless (known? (load seen) module name)
                (primitive/code-list-push! out
                                           `(def ~name
                                              ~@names
                                              (var/var-static (fnptr c
                                                                     [~@(parameter-types m
                                                                                         params)]
                                                                     ~ret)
                                                              (primitive/fnptr-of ~implementation))))
                (primitive/code-list-push! out (fnptr-trampoline name f))
                (primitive/code-list-push! identities `(~module ~name ~names))
                (set! seen `(~@(load seen) (~module ~name ~names)))
                0)
              (when retained
                (primitive/code-list-push! updates
                                           `(set ~name
                                                 (primitive/fnptr-of ~implementation)))
                0)
              0)
            (do
              (when (and (impl-form? f)
                         (> (primitive/code-count f) (if (reload/rr-vector? (primitive/code-nth f 1)) 2 1)))
                (primitive/code-list-push! out (impl-retirement f))
                0)
              (primitive/code-list-push! out f)
              0)))))))
    (insert-publication (primitive/code-list-done out)
                        (primitive/code-list-done updates))))

(defn session-transform [(modules Code)] (-> Code)
  (let [(mut active) false]
    (for [i 0 (primitive/code-count modules)]
      (when (or (contains-publication? (primitive/code-nth modules i))
                (contains-var-module? (primitive/code-nth modules i)))
        (set! active true)
        0))
    (if (not (load active))
        ; Nothing is published, but code here may still take the address of a
        ; function an earlier submission published.
        (if (primitive/code-session-active?)
            (let [known (primitive/code-session-state `())
                  out (primitive/code-list-new)]
              (for [i 0 (primitive/code-count modules)]
                (let [m (primitive/code-nth modules i)
                      forms (primitive/code-list-new)]
                  (primitive/code-list-push! forms (primitive/code-nth m 0))
                  (for [j 1 (primitive/code-count m)]
                    (primitive/code-list-push! forms (rewrite-fnptr-of m known false (primitive/code-nth m j)))
                    0)
                  (primitive/code-list-push! out (primitive/code-list-like m (primitive/code-list-done forms)))
                  0))
              `(do ~@(primitive/code-list-done out)))
            `(do ~@modules))
        (let [retained (primitive/code-session-active?)
              state (if retained (primitive/code-session-state `()) `())
              ; Collect only identities introduced by this submission. The
              ; accepted registry is immutable session state; rebuilding and
              ; staging an identical 2,000-entry Code list on a replacement is
              ; both unnecessary work and a full retained-state copy.
              identities (primitive/code-list-new)
              out (primitive/code-list-new)]
          (for [i 0 (primitive/code-count modules)]
            (let [m (primitive/code-nth modules i)]
              (primitive/code-list-push! out
                                         (if (or (contains-publication? m)
                                                 (contains-var-module? m))
                                             (lower-module m identities state retained)
                                             m))))
          (let [added (primitive/code-list-done identities)]
            (when (and retained (> (primitive/code-count added) 0))
              (primitive/code-session-stage! `(~@state ~@added))
              0))
          `(do ~@(primitive/code-list-done out))))))

(transform session-transform :phase before-expand)

; ---- printing values ---------------------------------------------------------
; The terminal prints a value through its type's Debug, or else its Display. A
; type with neither is printed here, the way `(derive Debug T)` would print it,
; from the checked type: a struct as `(Name :field value …)`, a sum as its
; variant, an array or slice as `[a b …]`. Each part with its own Debug or
; Display prints through it. A pointer prints its address as `#<(ptr T) 0x…>`
; and is never followed, and a type with no visible structure prints `#<T>`.
; Nothing is derived: the program gains no impl, so a later `(derive Debug T)`
; is not a redefinition and code bounded on Debug still rejects T.

;;; The terminal puts this marker before each expression it prints. The transform
;;; below removes it, and replaces the expression with code that prints its value
;;; when the terminal cannot print it itself.
(defn show [] (-> void)
  (panic "coil.repl/show reached run time: the terminal's print transform did not remove it"))

;;; `#<TYPE 0x…>`, for a pointer the printer does not follow.
(defn write-address [(w (ptr io/Writer)) (type (slice u8)) (address u64)] (-> i64)
  (fmt w "#<{} 0x{:x}>" type address)
  0)

;;; The printed value's line ends, and the expression is void, so the terminal
;;; prints nothing more.
(defn end-line [(w (ptr io/Writer))] (-> void)
  (print-nl w))

;;; An array local borrowed as a slice, for walking its elements.
(defn elements [T] [(s (slice T))] (-> (slice T)) s)

(defn show-marker? [(x Code)] (-> bool)
  (and (primitive/code-list? x)
       (and (= (primitive/code-count x) 1)
            (primitive/code-eq (primitive/code-nth x 0) `coil.repl/show))))

;;; The last segment of a qualified name, as `derive Debug` prints a type.
(defn bare-name [(s (slice u8))] (-> (slice u8))
  (let [(mut at) 0]
    (for [i 0 (len s)]
      (when (= (cast i64 (get s i)) 46) (set! at (+ i 1)) 0))
    (subslice s (load at) (len s))))

(defn type-text [(t Code)] (-> (slice u8))
  (if (primitive/code-list? t)
      (let [(mut out) (primitive/code-str "(")]
        (for [i 0 (primitive/code-count t)]
          (set! out (primitive/code-str (load out)
                                        (if (= i 0) "" " ")
                                        (type-text (primitive/code-nth t i))))
          0)
        (primitive/code-str (load out) ")"))
      (bare-name (primitive/code-str t))))

(defn strip-borrows [(t Code)] (-> Code)
  (if (and (primitive/code-list? t)
           (and (= (primitive/code-count t) 2)
                (or (primitive/code-eq (primitive/code-nth t 0) `mut)
                    (primitive/code-eq (primitive/code-nth t 0) `ref))))
      (strip-borrows (primitive/code-nth t 1))
      t))

(defn type-head? [(t Code) (name Code) (n i64)] (-> bool)
  (and (primitive/code-list? t)
       (and (= (primitive/code-count t) n)
            (primitive/code-eq (primitive/code-nth t 0) name))))

(defn has-trait? [(t Code) (name Code)] (-> bool)
  (match (primitive/code-type-traits t)
    (primitive/TraitsAre [traits]
      (block :found
        (for [i 0 (primitive/code-count traits)]
          (when (primitive/code-eq (primitive/code-nth traits i) name)
            (break :found true)))
        false))
    (primitive/TraitsUnknown [] false)))

;;; Is T, a reflected type, a struct?
(defn struct-type? [(t Code)] (-> bool)
  (match (primitive/code-type-shape t) (primitive/StructShape [] true) (_ false)))

;;; Is T, a reflected type, a sum?
(defn sum-type? [(t Code)] (-> bool)
  (match (primitive/code-type-shape t) (primitive/SumShape [] true) (_ false)))

;;; Can the terminal print a value of type T itself?
(defn printable? [(t Code)] (-> bool)
  (or (primitive/code-eq t `void)
      (or (primitive/code-eq t `Never)
          (or (has-trait? t `coil.fmt.Debug) (has-trait? t `coil.fmt.Display)))))

(defn write-text [(w Code) (s (slice u8))] (-> Code)
  `(coil.io.print-str ~w ~s))

;;; The value at PLACE: a local names its value, a field place is loaded.
(defn value-at [(place Code)] (-> Code)
  (if (primitive/code-sym? place) place `(load ~place)))

;;; Code that writes the value at PLACE, of type T, to formatter F over writer W.
;;; PLACE is a local or a `(field …)` chain from one, so the value is read where
;;; it lives and nothing is moved or dropped.
(defn show-value [(t Code) (place Code) (w Code) (f Code)] (-> Code)
  (cond (has-trait? t `coil.fmt.Debug) `(coil.fmt.debug-fmt ~(value-at place) ~f)
        (has-trait? t `coil.fmt.Display) `(coil.fmt.display-fmt ~(value-at place) ~f)
        (or (type-head? t `ptr 2) (type-head? t `fnptr 4))
          `(coil.repl/write-address ~w ~(type-text t)
                                    (cast u64 (cast (ptr i8) ~(value-at place))))
        (type-head? t `array 3)
          (let [et (primitive/code-nth t 1)]
            (show-elements et
                           (if (primitive/code-sym? place)
                               `(data (coil.repl/elements ~place))
                               `(cast (ptr ~et) ~place))
                           (primitive/code-nth t 2)
                           w
                           f))
        (type-head? t `slice 2)
          (let [s (primitive/fresh-identifier "elements")]
            `(let* [~s ~(value-at place)]
               ~(show-elements (primitive/code-nth t 1) `(data ~s) `(len ~s) w f)))
        (struct-type? t) (show-struct t place w f)
        (sum-type? t) (show-sum t place w f)
        :else (write-text w (primitive/code-str "#<" (type-text t) ">"))))

;;; The N elements of type ET from the pointer AT. Each is read into a local,
;;; printed there and forgotten: the local is a copy of storage it does not own,
;;; and dropping it would drop the element.
(defn show-elements [(et Code) (at Code) (n Code) (w Code) (f Code)] (-> Code)
  (let [p (primitive/fresh-identifier "first")
        i (primitive/fresh-identifier "index")
        e (primitive/fresh-identifier "element")]
    `(let* [~p ~at
            (mut ~i) 0]
       ~(write-text w "[")
       (loop (if (>= (load ~i) ~n)
                 (break)
                 (do
                   (if (> (load ~i) 0) ~(write-text w " ") 0)
                   (let* [~e (load (index ~p (load ~i)))]
                     ~(show-value et e w f)
                     (forget ~e))
                   (set! ~i (+ (load ~i) 1)))))
       ~(write-text w "]"))))

(defn show-struct [(t Code) (place Code) (w Code) (f Code)] (-> Code)
  (let [out (primitive/code-list-new)
        name (if (primitive/code-list? t) (primitive/code-nth t 0) t)]
    (primitive/code-list-push! out (write-text w (primitive/code-str "(" (type-text name))))
    (for [i 0 (primitive/code-field-count t)]
      (let [field-name (primitive/code-field-name t i)]
        (primitive/code-list-push! out
                                   (write-text w (primitive/code-str " :" field-name " ")))
        (primitive/code-list-push! out
                                   (show-value (primitive/code-field-type t i)
                                               `(field ~place ~field-name)
                                               w
                                               f))
        0))
    (primitive/code-list-push! out (write-text w ")"))
    `(do ~@(primitive/code-list-done out) 0)))

(defn show-sum [(t Code) (place Code) (w Code) (f Code)] (-> Code)
  (let [arms (primitive/code-list-new)]
    (for [v 0 (primitive/code-variant-count t)]
      (let [binds (primitive/code-list-new)
            body (primitive/code-list-new)]
        (primitive/code-list-push! body
                                   (write-text w (primitive/code-str "("
                                                                     (primitive/code-variant-name t v))))
        (for [k 0 (primitive/code-variant-fields t v)]
          (let [b (primitive/fresh-identifier "payload")]
            (primitive/code-list-push! binds b)
            (primitive/code-list-push! body
                                       (write-text w (primitive/code-str " :"
                                                                         (primitive/code-variant-field-name t v k)
                                                                         " ")))
            (primitive/code-list-push! body
                                       (show-value (primitive/code-variant-field-type t v k) b w f))
            0))
        (primitive/code-list-push! body (write-text w ")"))
        (primitive/code-list-push! arms
                                   `(~(primitive/code-variant-qname t v) [~@(primitive/code-list-done binds)]
                                       (do ~@(primitive/code-list-done body) 0)))
        0))
    `(match ~place ~@(primitive/code-list-done arms))))

;;; EXPRESSION, or code that prints its value. An expression that did not check
;;; is left for the strict check to report.
(defn show-expression [(expression Code)] (-> Code)
  (let [t (strip-borrows (primitive/type-of expression))]
    (cond (primitive/code-keyword? t) expression
          (printable? t) expression
          :else
            (let [v (primitive/fresh-identifier "value")
                  w (primitive/fresh-identifier "writer")
                  f (primitive/fresh-identifier "formatter")]
              `(let* [~v ~expression
                      ~w (coil.io.stdout)
                      ~f (primitive/alloc-stack coil.fmt.Formatter)]
                 (coil.fmt.Formatter::init ~f ~w)
                 ~(show-value t v w f)
                 (coil.repl/end-line ~w))))))

;;; The terminal's entry, `(defn* NAME [] (-> i64) (do (coil.repl/show) EXPR 0))`,
;;; without its marker; any other form unchanged.
(defn show-entry [(form Code)] (-> Code)
  (let [body (if (and (primitive/code-list? form)
                      (and (= (primitive/code-count form) 5)
                           (primitive/code-eq (primitive/code-nth form 0) `defn*)))
                 (primitive/code-nth form 4)
                 `())]
    (if (and (primitive/code-list? body)
             (and (= (primitive/code-count body) 4)
                  (and (primitive/code-eq (primitive/code-nth body 0) `do)
                       (show-marker? (primitive/code-nth body 1)))))
        (primitive/code-list-like form
                                  `(~@(primitive/code-slice form 0 4)
                                      ~(primitive/code-list-like body
                                                                 `(do ~(show-expression (primitive/code-nth body 2))
                                                                      ~(primitive/code-nth body 3)))))
        form)))

(defn show-transform [(modules Code)] (-> Code)
  (let [out (primitive/code-list-new)]
    (for [i 0 (primitive/code-count modules)]
      (let [m (primitive/code-nth modules i)
            forms (primitive/code-list-new)]
        (primitive/code-list-push! forms (primitive/code-nth m 0))
        (for [j 1 (primitive/code-count m)]
          (primitive/code-list-push! forms (show-entry (primitive/code-nth m j)))
          0)
        (primitive/code-list-push! out (primitive/code-list-like m (primitive/code-list-done forms)))
        0))
    `(do ~@(primitive/code-list-done out))))

(transform-once show-transform)
