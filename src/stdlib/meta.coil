(module coil.meta)
(import "coil.primitive" :as primitive)
(import "coil.alloc" :as alloc)
(import "coil.meta-runtime" :as runtime)
(import "coil.result" :use [Option Some None])

(export expansion-allocator)

(defstruct MetaAllocator [])

(defn meta-allocator-state [] (-> (ptr MetaAllocator))
  (primitive/alloc-static MetaAllocator))

(impl alloc/Allocator MetaAllocator
  (allocate [(self (ptr MetaAllocator)) (request (ref alloc/AllocRequest))]
            (-> (Option (ptr i8)))
    (let [p (primitive/call-ptr (load (runtime/meta-allocate-cell))
                                (load (field request bytes))
                                (load (field request align)))]
      (if (= (primitive/cast i64 p) 0) (None) (Some p))))
  (resize [(self (ptr MetaAllocator))
           (memory (ptr i8))
           (old (ref alloc/AllocRequest))
           (new (ref alloc/AllocRequest))] (-> bool)
    (!= (primitive/call-ptr (load (runtime/meta-resize-cell))
                            memory
                            (load (field old bytes))
                            (load (field old align))
                            (load (field new bytes))
                            (load (field new align)))
        0))
  (remap [(self (ptr MetaAllocator))
          (memory (ptr i8))
          (old (ref alloc/AllocRequest))
          (new (ref alloc/AllocRequest))] (-> (Option (ptr i8)))
    (let [p (primitive/call-ptr (load (runtime/meta-remap-cell))
                                memory
                                (load (field old bytes))
                                (load (field old align))
                                (load (field new bytes))
                                (load (field new align)))]
      (if (= (primitive/cast i64 p) 0) (None) (Some p))))
  (deallocate [(self (ptr MetaAllocator))
               (memory (ptr i8))
               (request (ref alloc/AllocRequest))] (-> i64)
    (primitive/call-ptr (load (runtime/meta-deallocate-cell))
                        memory
                        (load (field request bytes))
                        (load (field request align)))))

;;; Borrow the scratch allocator for the current metaprogram invocation.
;;; The returned trait object is valid only until the reader, macro, checker, or
;;; transform returns. Values allocated through it must not escape except as
;;; returned Code, which the compiler promotes into compiler-owned storage.
(defn expansion-allocator [] (-> (dyn alloc/Allocator))
  (primitive/make-dyn alloc/Allocator (meta-allocator-state)))
