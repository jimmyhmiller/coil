(module coil.meta)
(import "coil.primitive" :as primitive)
(import "coil.alloc" :as alloc)
(import "coil.meta-runtime" :as runtime)
(import "coil.result" :use [Option Some None])
(import "coil.slice" :use [subslice])
(import "coil.str" :use [StrBuf])
(import "coil.jit.environment" :as jitenv)

(export expansion-allocator generated-unit! user-forms user-module? read-context-manifest dependencies dependents dependency-closure dependent-closure
        modules definitions definition-kind declaration annotations definition-source module-header module-impls answered toolchain
        source embed-text embed-environment transform-result
        source-modules imports import-node import-target references references-through reference-node reference-role reference-binding reference-import reference-exported-name source-binding qualify-import suggest-edits)

(defn meta-slice-data [(s (slice u8))] (-> (ptr u8))
  (primitive/llvm-ir (ptr u8) [s] "%d = extractvalue $t0 $0, 0
ret $ret %d"))

;;; Register a concrete generated module, its declaration-only interface, and its
;;; implementation. The compiler stores the sources before returning; borrowed
;;; producer storage can immediately be recycled. Interfaces are ordinary imports.
(defn generated-unit! [(name (slice u8))
                       (interface (slice u8))
                       (source (slice u8))] (-> i64)
  (let [fp (load (runtime/generated-unit-cell))]
    (when (not (load (runtime/generated-unit-ready-cell)))
      (primitive/error "generated-unit! requires an active compiler metaprogram runtime")
      0)
    (if (= (primitive/call-ptr fp
                               (meta-slice-data name)
                               (len name)
                               (meta-slice-data interface)
                               (len interface)
                               (meta-slice-data source)
                               (len source))
           0)
        (primitive/error "generated-unit! rejected the module; see the generated-session diagnostic")
        0)))

(defstruct MetaAllocator [])

(defn meta-allocator-state [] (-> (ptr MetaAllocator))
  (primitive/alloc-static MetaAllocator))

(impl alloc/Allocator MetaAllocator
  (allocate [(self (ptr MetaAllocator)) (request (ref alloc/AllocRequest))]
            (-> (Option (ptr i8)))
            (let [p
                    (primitive/call-ptr (load (runtime/meta-allocate-cell))
                                        (load (field request bytes))
                                        (load (field request align)))]
              (if (= (primitive/cast i64 p) 0) (None) (Some p))))
  (resize [(self (ptr MetaAllocator))
           (memory (ptr i8))
           (old (ref alloc/AllocRequest))
           (new (ref alloc/AllocRequest))]
          (-> bool)
          (!= (primitive/call-ptr (load (runtime/meta-resize-cell))
                                  memory
                                  (load (field old bytes))
                                  (load (field old align))
                                  (load (field new bytes))
                                  (load (field new align)))
              0))
  (remap [(self (ptr MetaAllocator))
          (memory (ptr i8))
          (old (ref alloc/AllocRequest))
          (new (ref alloc/AllocRequest))]
         (-> (Option (ptr i8)))
         (let [p
                 (primitive/call-ptr (load (runtime/meta-remap-cell))
                                     memory
                                     (load (field old bytes))
                                     (load (field old align))
                                     (load (field new bytes))
                                     (load (field new align)))]
           (if (= (primitive/cast i64 p) 0) (None) (Some p))))
  (deallocate [(self (ptr MetaAllocator))
               (memory (ptr i8))
               (request (ref alloc/AllocRequest))]
              (-> i64)
              (primitive/call-ptr (load (runtime/meta-deallocate-cell))
                                  memory
                                  (load (field request bytes))
                                  (load (field request align)))))

;;; Borrow the scratch allocator for the current metaprogram invocation.
;;; The returned trait object is valid only until the reader, macro, checker, or
;;; transform returns. Values allocated through it must not escape except as
;;; returned Code, which the compiler promotes into compiler-owned storage.
(defn expansion-allocator [] (-> (dyn alloc/Allocator))
  (primitive/make-dyn alloc/Allocator (meta-allocator-state)))

;;; Every top-level form the user wrote, across all modules, as one Code list. A
;;; checker or transform receives the whole program, standard library included;
;;; this is the part a lint usually cares about. Import and export forms count as
;;; user forms only when they were written by the user.
(defn user-forms [(modules Code)] (-> Code)
  (let [(mut out) (primitive/code-list-new)]
    (for m (iter modules)
      (for i (range 1 (len m))
        (let [form (get m i)]
          (when (primitive/code-from-user? form) (push! (mut out) form) 0))))
    (primitive/code-list-done (load out))))

;;; Does this module record `(name form…)` contain any form the user wrote? A
;;; transform uses it to leave standard-library modules untouched.
(defn user-module? [(module Code)] (-> bool)
  (let [(mut found) false]
    (for i (range 1 (len module))
      (when (primitive/code-from-user? (get module i)) (set! found true)))
    found))

;;; The Coil.toml of the package that owns the file a reader is reading: the
;;; `(read-package MANIFEST)` element of its read-context, "" outside a project.
;;; A dependency's file gets the dependency's manifest, not the importer's, so a
;;; provider configured by manifest sections reads its own package's sections
;;; and resolves their relative paths against that manifest's directory.
(defn read-context-manifest [(context Code)] (-> (slice u8))
  (let [(mut found) ""]
    (for i (range 1 (len context))
      (let [item (get context i)]
        (when (and (primitive/code-list? item)
                   (and (> (len item) 1)
                        (primitive/code-eq (get item 0) `read-package)))
          (set! found (primitive/code-str (get item 1))))))
    found))

;;; Direct declarations used by NAME, as sorted fully qualified Code symbols: a
;;; `primitive/ProgramAnswer` (see `answered`). Available in checkers and semantic
;;; transforms, including native JIT sessions. NAME can be a fully qualified symbol
;;; or a checked reference node. `(NotInProgram)` for a declaration the model does
;;; not have, `(NoProgram)` without a semantic model.
(defn dependencies [(name Code)] (-> primitive/ProgramAnswer) (primitive/code-dependencies name))

;;; Direct declarations that use NAME in the current compiler environment.
(defn dependents [(name Code)] (-> primitive/ProgramAnswer) (primitive/code-dependents name))

;;; All declarations reachable through dependency edges; excludes NAME itself.
(defn dependency-closure [(name Code)] (-> primitive/ProgramAnswer) (primitive/code-dependency-closure name))

;;; All declarations that directly or indirectly use NAME; excludes NAME itself.
;;; This is dependency information, not a decision to recompile those declarations.
(defn dependent-closure [(name Code)] (-> primitive/ProgramAnswer) (primitive/code-dependent-closure name))

;;; ---- asking the compiler about the program --------------------------------
;;;
;;; These queries read the checked program: call them from a checker or transform.
;;; Names are qualified symbols. Each answers with a `primitive/ProgramAnswer`:
;;; `(Answer VALUE)`, `(NotInProgram)` for a name the program does not define, or
;;; `(NoProgram)` where there is no checked program to ask. `answered` takes the
;;; VALUE of a query the program has to answer.

;;; Every module of the program, the library's included, as qualified symbols.
(defn modules [] (-> primitive/ProgramAnswer) (primitive/program-modules))

;;; MODULE's definitions as qualified symbols.
(defn definitions [(module Code)] (-> primitive/ProgramAnswer) (primitive/module-definitions module))

;;; What NAME is, a `primitive/KindAnswer`: `(KindIs KIND)` with a
;;; `primitive/DefinitionKind`, `(KindNotInProgram)` or `(KindNoProgram)`.
(defn definition-kind [(name Code)] (-> primitive/KindAnswer) (primitive/definition-kind name))

;;; The form that declares NAME to another unit, written in NAME's own module.
(defn declaration [(name Code)] (-> primitive/ProgramAnswer) (primitive/definition-declaration name))

;;; The `:key value` pairs NAME's `defn` or `def` carries, as one list; empty for a
;;; definition that carries none.
(defn annotations [(name Code)] (-> primitive/ProgramAnswer) (primitive/definition-annotations name))

;;; The form that defines NAME, as it was written.
(defn definition-source [(name Code)] (-> primitive/ProgramAnswer) (primitive/definition-source name))

;;; `(module M)` and M's own import and export forms, as a list.
(defn module-header [(module Code)] (-> primitive/ProgramAnswer) (primitive/module-header module))

;;; M's `impl` and `derive` forms, as a list.
(defn module-impls [(module Code)] (-> primitive/ProgramAnswer) (primitive/module-impls module))

;;; The VALUE of ANSWER, for a query the program must be able to answer. Anything
;;; else is a compile error naming what was missing.
(defn answered [(answer primitive/ProgramAnswer)] (-> Code)
  (match answer
    (primitive/Answer [value] value)
    (primitive/NotInProgram [] (primitive/error "coil.meta: the program defines no such name"))
    (primitive/NoProgram [] (primitive/error "coil.meta: there is no checked program to ask here"))))

;;; `(toolchain :compiler "<digest>" :target "<arch>-<os>")`: which compiler and
;;; target an environment's declarations assume.
(defn toolchain [] (-> Code) (primitive/program-toolchain))

;;; CODE as source text.
(defn source [(code Code)] (-> (slice u8)) (primitive/code-source code))

;;; ---- embedding text in the program ----------------------------------------
;;;
;;; A transform puts text in the program by adding a function that returns it as
;;; a string. (A function, not a `def`: the program can call it before the
;;; transform has added it, which an unbound variable could not.)

;;; Does module record M define NAME at its top level?
(defn module-defines? [(m Code) (name (slice u8))] (-> bool)
  (let [(mut found) false]
    (for i (range 1 (len m))
      (let [f (get m i)]
        (when (and (primitive/code-list? f)
                   (and (> (len f) 1)
                        (and (primitive/code-sym? (get f 1)) (= (primitive/code-str (get f 1)) name))))
          (set! found true))))
    found))

;;; What a transform returns for the module records MODULES: `(do record…)`.
(defn transform-result [(modules Code)] (-> Code) `(do ~@modules))

;;; MODULES (module records, as a transform receives them) with a function NAME
;;; added to module HOST that returns TEXT, unless HOST already defines NAME (a
;;; transform runs until the program stops changing). NAME is spelled in HOST's
;;; own context, so HOST's code calls it as `(NAME)`.
(defn embed-text [(modules Code) (host Code) (name (slice u8)) (text (slice u8))] (-> Code)
  (let [(mut out) (primitive/code-list-new)]
    (for m (iter modules)
      (if (and (= (primitive/code-str (get m 0)) (primitive/code-str host)) (not (module-defines? m name)))
          (let [(mut forms) (primitive/code-list-new)]
            (for f (iter m) (push! (mut forms) f))
            ; Core form: a transform's output is not expanded again.
            ; hygiene: Introduce the explicitly requested public definition name in HOST's module context.
            (push! (mut forms) `(defn* ~(primitive/datum->syntax (get m 0) name) [] (-> (slice u8)) ~text))
            (push! (mut out) (primitive/code-list-done (load forms))))
          (push! (mut out) m)))
    (primitive/code-list-done (load out))))

;;; ---- the environment a session takes --------------------------------------
;;;
;;; `embed-environment` is a helper for a metaprogram that hands some of the program
;;; to a JIT session. It adds to a host module a function that returns the
;;; environment as source text (see `coil.jit.environment`). It does nothing on its
;;; own: the metaprogram calls it, and says which modules to describe and which
;;; functions and `def`s to hand over. A type, generic, macro or impl of a described
;;; module is copied as written. A function or `def` named to be handed over is
;;; reached through its address, which only the running program knows, so the text is
;;; built when the function is called. Anything not named is left out.
;;;
;;; The host module must be able to name what it hands over, which it can when it
;;; imports their modules. Naming a function there is also what keeps it in the
;;; binary, at every optimization level.

;;; Is NAME one of the symbols in LIST?
(defn named? [(list Code) (name Code)] (-> bool)
  (let [(mut found) false]
    (for item (iter list)
      (when (= (primitive/code-str item) (primitive/code-str name)) (set! found true)))
    found))

;;; The head symbol of a list form, or "".
(defn form-head [(form Code)] (-> (slice u8))
  (if (and (primitive/code-list? form) (and (> (len form) 0) (primitive/code-sym? (get form 0))))
      (primitive/code-str (get form 0))
      ""))

;;; A parameter's type as the declaration spells it, `(ref T)` for an aggregate
;;; the function takes by reference, as the type of the source `defn`'s parameter.
(defn source-type [(ty Code)] (-> Code)
  (if (= (form-head ty) "ref") (get ty 1) ty))

(defn push-newline! [(out (mut StrBuf))] (-> i64)
  (push! (mut out) (: 10 u8)))

;;; Text up to the point a function's address belongs, written into PENDING: a
;;; `defn` with the function's own signature whose body calls the pointer.
(defn function-forwarder-head! [(pending (mut StrBuf)) (declaration Code)] (-> i64)
  (let [params (get declaration 2)
        result (get (get declaration 3) 1)]
    (push-str! (mut pending) "(defn ")
    (push-str! (mut pending) (primitive/code-source (get declaration 1)))
    (push-str! (mut pending) " [")
    (for i (range 0 (len params))
      (let [param (get params i)]
        (when (> i 0) (push! (mut pending) (: 32 u8)))
        (push-str! (mut pending) "(")
        (push-str! (mut pending) (primitive/code-source (get param 0)))
        (push-str! (mut pending) " ")
        (push-str! (mut pending) (primitive/code-source (source-type (get param 1))))
        (push-str! (mut pending) ")")))
    (push-str! (mut pending) "] (-> ")
    (push-str! (mut pending) (primitive/code-source result))
    (push-str! (mut pending) ") (let [f (cast (fnptr c [")
    (for i (range 0 (len params))
      (when (> i 0) (push! (mut pending) (: 32 u8)))
      (push-str! (mut pending) (primitive/code-source (get (get params i) 1))))
    (push-str! (mut pending) "] ")
    (push-str! (mut pending) (primitive/code-source result))
    (push-str! (mut pending) ") (cast (ptr i8) ")
    0))

;;; The rest of that `defn`, after the address: call the pointer with the parameters.
(defn function-forwarder-tail! [(pending (mut StrBuf)) (declaration Code)] (-> i64)
  (let [params (get declaration 2)]
    (push-str! (mut pending) "))] (f")
    (for i (range 0 (len params))
      (push-str! (mut pending) " ")
      (push-str! (mut pending) (primitive/code-source (get (get params i) 0))))
    (push-str! (mut pending) ")))")
    (push-newline! (mut pending))
    0))

;;; The expression, evaluated in the host when its function is called, that builds
;;; the environment text of the DESCRIBED modules. CONTEXT is a symbol of the host
;;; module, which spells the names the expression refers to.
(defn environment-expression [(described Code) (context Code) (expose Code)] (-> Code)
  (let [(mut expr) `(jitenv/EnvironmentBuilder::new)
        (mut pending) (StrBuf::new (expansion-allocator))]
    (push-str! (mut pending) (primitive/code-source (primitive/program-toolchain)))
    (push-newline! (mut pending))
    (for module (iter described)
      (let [names (match (primitive/module-definitions module)
                    (primitive/Answer [names] names)
                    (_ (primitive/error "embed-environment: the program has no such module")))]
        (for f (iter (answered (primitive/module-header module)))
          (unless (= (form-head f) "export")
            (push-str! (mut pending) (primitive/code-source f))
            (push-newline! (mut pending))))
        (push-str! (mut pending) "(import \"coil.var\" :as environment-var)\n")
        (for n (iter names)
          (let [kind (match (primitive/definition-kind n)
                       (primitive/KindIs [kind] kind)
                       (_ (primitive/error "embed-environment: a module's definition has no kind")))
                ; hygiene: Spell each definition handed over in HOST's module context, so the reference the generated function makes resolves where HOST can name it.
                spelled (primitive/datum->syntax context (primitive/code-str n))]
            (match kind
              (primitive/Function []
                (if (named? expose n)
                    (let [declaration (answered (primitive/definition-declaration n))]
                      (function-forwarder-head! (mut pending) declaration)
                      (set! expr `(text! ~(load expr) ~(finish! (mut pending))))
                      (set! expr `(address! ~(load expr)
                                    (primitive/cast (ptr i8) (primitive/fnptr-of ~spelled))))
                      (function-forwarder-tail! (mut pending) declaration)
                      0)
                    0))
              (primitive/Def []
                (if (named? expose n)
                  (let [declaration (answered (primitive/definition-declaration n))
                        ty (get declaration 2)]
                    (if (= (form-head ty) "coil.var.Var")
                        (do (push-str! (mut pending) "(def ")
                            (push-str! (mut pending) (primitive/code-source (get declaration 1)))
                            (push-str! (mut pending) " (environment-var/Var :cell (cast (ptr ")
                            (push-str! (mut pending) (primitive/code-source (get ty 1)))
                            (push-str! (mut pending) ") (cast (ptr i8) ")
                            (set! expr `(text! ~(load expr) ~(finish! (mut pending))))
                            (set! expr `(address! ~(load expr)
                                          (primitive/cast (ptr i8) (.cell ~spelled))))
                            (push-str! (mut pending) "))))")
                            (push-newline! (mut pending))
                            0)
                        (do (push-str! (mut pending) (primitive/code-source (answered (primitive/definition-source n))))
                            (push-newline! (mut pending))
                            0))) 0))
              (_ (do (push-str! (mut pending) (primitive/code-source (answered (primitive/definition-declaration n))))
                     (push-newline! (mut pending))
                     0)))))
        (for f (iter (answered (primitive/module-impls module)))
          (push-str! (mut pending) (primitive/code-source f))
          (push-newline! (mut pending)))))
    `(finish (text! ~(load expr) ~(finish! (mut pending))))))

;;; MODULES with a function NAME added to module HOST that returns the environment
;;; of the modules DESCRIBED (a list of qualified module symbols), unless HOST
;;; already defines NAME (a transform runs until the program stops changing). EXPOSE
;;; is the list of qualified names of the functions and `def`s to hand over: pass
;;; `(meta/answered (meta/definitions M))` for all of a module's, or any list you
;;; build. The program
;;; gives `(NAME)` to `jit-session-set-environment!` and releases it with
;;; `coil.jit.environment/free!`. Used from a transform:
;;;   (transform-result (embed-environment modules `app.main "environment"
;;;                       `(app.core) (answered (definitions `app.core))))
(defn embed-environment [(modules Code) (host Code) (name (slice u8)) (described Code) (expose Code)] (-> Code)
  (let [(mut out) (primitive/code-list-new)]
    (for m (iter modules)
      (if (and (= (primitive/code-str (get m 0)) (primitive/code-str host)) (not (module-defines? m name)))
          (let [(mut forms) (primitive/code-list-new)]
            (for f (iter m) (push! (mut forms) f))
            ; Core form: a transform's output is not expanded again.
            ; hygiene: Introduce the explicitly requested public definition name in HOST's module context.
            (push! (mut forms) `(defn* ~(primitive/datum->syntax (get m 0) name) [] (-> (slice u8))
                                  ~(environment-expression described (get m 0) expose)))
            (push! (mut out) (primitive/code-list-done (load forms))))
          (push! (mut out) m)))
    (primitive/code-list-done (load out))))


;;; ---- authored source --------------------------------------------------------
;;;
;;; Available in semantic checker profiles run by `coil lint --use`. Each answers a
;;; `primitive/SourceView`: `(SourceIs RECORDS)`, or `(SourceUnavailable)` anywhere
;;; else. Source nodes keep their authored spans and hygiene.

;;; Original module records, including import/export declarations and macro calls.
(defn source-modules [] (-> primitive/SourceView) (primitive/code-source-modules))

;;; The records of ALL that belong to MODULE, as ALL answers.
(defn records-of [(all primitive/SourceView) (module Code)] (-> primitive/SourceView)
  (match all
    (primitive/SourceIs [records]
      (let [(mut out) (primitive/code-list-new)]
        (for item (iter records)
          (when (= (get item 1) module) (push! (mut out) item) 0))
        (primitive/SourceIs (primitive/code-list-done (load out)))))
    (primitive/SourceUnavailable [] (primitive/SourceUnavailable))))

;;; Source-backed imports of MODULE. Each record is
;;; `(source-import MODULE NODE RESOLVED-TARGET)`; NODE is editable source syntax.
(defn imports [(module Code)] (-> primitive/SourceView)
  (records-of (primitive/code-source-imports) module))

;;; Authored reference occurrences of MODULE, including macro heads and named
;;; types. A record holds the node, its role, and the imported facade and its
;;; exported spelling when it resolved through one. Unknown/ambiguous evidence is
;;; never guessed by name.
(defn references [(module Code)] (-> primitive/SourceView)
  (records-of (primitive/code-source-references) module))

;;; Editable import declaration and its resolved module namespace.
(defn import-node [(import Code)] (-> Code) (get import 2))
(defn import-target [(import Code)] (-> Code) (get import 3))

;;; References that actually resolved through IMPORT's facade in its module.
;;; Uses compiler-recorded provenance, including renamed and reexported names.
(defn references-through [(import Code)] (-> primitive/SourceView)
  (match (references (get import 1))
    (primitive/SourceIs [all]
      (let [(mut out) (primitive/code-list-new)]
        (for reference (iter all)
          (match (reference-import reference)
            (Some [via] (when (= via (import-target import)) (push! (mut out) reference) 0))
            (None [] 0)))
        (primitive/SourceIs (primitive/code-list-done (load out)))))
    (primitive/SourceUnavailable [] (primitive/SourceUnavailable))))

;;; The editable authored identifier in a reference record.
(defn reference-node [(reference Code)] (-> Code) (get reference 2))

;;; Authored syntax role, such as :call, :value, :type or :macro.
(defn reference-role [(reference Code)] (-> Code) (get reference 3))

;;; How the reference binds, a `primitive/SourceBinding` (see `source-binding`).
(defn reference-binding [(reference Code)] (-> primitive/SourceBinding)
  (primitive/code-source-binding (reference-node reference)))

;;; The imported facade through which this occurrence resolved, if it did.
(defn reference-import [(reference Code)] (-> (Option Code))
  (if (> (len reference) 4) (Some (get reference 4)) (None [Code])))

;;; The name that facade exports, before any importing :rename, if it resolved
;;; through one.
(defn reference-exported-name [(reference Code)] (-> (Option Code))
  (if (> (len reference) 5) (Some (get reference 5)) (None [Code])))

;;; Strict authored-occurrence lookup, a `primitive/SourceBinding`:
;;; `(BindsGlobal QUALIFIED-NAME)`, `(BindsLocal ID)`, `(LocalUnknown)` or
;;; `(LocalAmbiguous)` for a local lacking a unique checked identity, and
;;; `(BindingUnknown)` or `(BindingAmbiguous)`. This never falls back to
;;; declaration-name search; arbitrary symbols and syntax data are BindingUnknown.
(defn source-binding [(node Code)] (-> primitive/SourceBinding) (primitive/code-source-binding node))

;;; Build a reviewable qualification plan for an import returned by imports, a
;;; `primitive/ImportPlan`: `(PlanEdits EDITS)` or `(PlanRefused REASON)`.
;;; Refuses incomplete binding evidence, alias conflicts, macro-inspected names,
;;; repeated imports of one target, and reexports. No source is changed here.
(defn qualify-import [(import Code) (alias Code) (mode Code)] (-> primitive/ImportPlan)
  (primitive/code-qualify-import import alias mode))

;;; Publish a plan's EDITS as one coordinated lint suggestion group, a
;;; `primitive/Suggestion`: `(Suggested)`, or `(SuggestionRefused)` when an edit has
;;; no editable authored source. All edits are accepted or withheld together by lint
;;; conflict/comment filtering. Actual writing remains `coil lint --fix`.
(defn suggest-edits [(edits Code) (message (slice u8))] (-> primitive/Suggestion)
  (primitive/code-suggest-edits edits message))
