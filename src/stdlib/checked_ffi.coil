(module coil.checked-ffi)
(import "coil.primitive" :as primitive)
(import "coil.alloc" :as alloc :use *)

(export CheckedOut
        checked-out-new
        checked-out-ptr
        checked-out-size
        checked-out-check!
        checked-out-free!
        with-checked-out)

; A checked foreign output buffer owns its complete allocation separately from
; the exactly-sized, exactly-aligned pointer passed to C. Sixteen-byte canaries
; surround the foreign-visible range, catching APIs that write the wrong ABI
; layout immediately after the extern returns.
(defstruct CheckedOut
  [(base (ptr i8))
   (data (ptr i8))
   (size i64)
   (alignment i64)
   (total i64)
   (allocator (ptr Allocator))])

(defn checked-out-fail [(message (ptr i8))] (-> i64)
  (debug-fail-at message))

(defn checked-out-valid-alignment? [(alignment i64)] (-> bool)
  (and (> alignment 0)
       (= (primitive/iand alignment (primitive/isub alignment 1)) 0)))

(defn checked-out-fill [(p (ptr i8)) (count i64) (value i8)] (-> i64)
  (let [(mut i) 0]
    (loop (if (>= (load i) count)
              (break)
              (do
                (store! (primitive/index p (load i)) value)
                (store! i (+ (load i) 1)))))
    0))

(defn checked-out-canary-valid? [(p (ptr i8))] (-> bool)
  (let [(mut i) 0
        (mut valid) true]
    (loop (if (>= (load i) 16)
              (break)
              (do
                (when (!= (load (primitive/index p (load i))) (primitive/cast i8 167))
                  (store! valid false)
                  (break))
                (store! i (+ (load i) 1)))))
    (load valid)))

;; Allocate an output buffer using size and alignment values obtained from
;; `cimport :probe` (`sizeof(T)` and `_Alignof(T)`). The C-visible range is
;; exactly `size` bytes; the surrounding storage remains private diagnostics
;; metadata.
(defn checked-out-new [(allocator (ptr Allocator)) (size i64) (alignment i64)] (-> CheckedOut)
  (when (<= size 0)
    (checked-out-fail c"checked FFI out-parameter has a non-positive probed size")
    0)
  (when (not (checked-out-valid-alignment? alignment))
    (checked-out-fail c"checked FFI out-parameter has an invalid probed alignment")
    0)
  (let [total (+ size (+ alignment 32))
        base (unwrap-ptr [i8] (raw-alloc allocator total alignment))]
    (when (= (primitive/cast i64 base) 0)
      (oom-at c"checked FFI out-parameter" total)
      0)
    (let [candidate (+ (primitive/cast i64 base) 16)
          aligned (* (primitive/udiv (+ candidate (- alignment 1)) alignment) alignment)
          data (primitive/cast (ptr i8) aligned)
          prefix (primitive/index data -16)
          suffix (primitive/index data size)
          out (alloc/stack CheckedOut)]
      (checked-out-fill prefix 16 (primitive/cast i8 167))
      (checked-out-fill data size (primitive/cast i8 205))
      (checked-out-fill suffix 16 (primitive/cast i8 167))
      (store! (field out base) base)
      (store! (field out data) data)
      (store! (field out size) size)
      (store! (field out alignment) alignment)
      (store! (field out total) total)
      (store! (field out allocator) allocator)
      (load out))))

(defn checked-out-ptr [(out (ptr CheckedOut))] (-> (ptr i8))
  (load (field out data)))

(defn checked-out-size [(out (ptr CheckedOut))] (-> i64)
  (load (field out size)))

;; Validate both canaries. Call this on the first instruction after the foreign
;; function returns so the diagnostic identifies the actual ABI boundary.
(defn checked-out-check! [(out (ptr CheckedOut))] (-> i64)
  (let [data (load (field out data))]
    (when (not (checked-out-canary-valid? (primitive/index data -16)))
      (checked-out-fail c"foreign call wrote before its checked out-parameter")
      0)
    (when (not (checked-out-canary-valid? (primitive/index data (load (field out size)))))
      (checked-out-fail c"foreign call wrote past its checked out-parameter")
      0)
    0))

(defn checked-out-free! [(out (ptr CheckedOut))] (-> i64)
  (checked-out-check! out)
  (raw-free (load (field out allocator))
            (load (field out base))
            (load (field out total))
            (load (field out alignment)))
  (store! (field out base) (primitive/cast (ptr i8) 0))
  (store! (field out data) (primitive/cast (ptr i8) 0))
  0)

;; `(with-checked-out A SIZE ALIGN PTR CALL)` evaluates CALL with PTR bound to
;; the exact foreign-visible range, validates canaries immediately afterward,
;; frees the storage, and yields CALL's result.
(defn with-checked-out [(allocator Code)
                        (size Code)
                        (alignment Code)
                        (pointer-name Code)
                        (call Code)] (-> Code)
  (let [buffer-name (primitive/gensym)
        result-name (primitive/gensym)]
    `(let [(mut ~buffer-name) (checked-out-new ~allocator ~size ~alignment)
           ~pointer-name (checked-out-ptr (mut ~buffer-name))
           ~result-name ~call]
       (checked-out-check! (mut ~buffer-name))
       (checked-out-free! (mut ~buffer-name))
       ~result-name)))
