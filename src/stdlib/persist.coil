;;; Deep copies of owned data into an allocator: `(derive Persist T)`.
;;;
;;;   (import "coil.persist" :use *)
;;;   (defsum Tree (Leaf [(v i64)]) (Node [(l (ptr Tree)) (r (ptr Tree))]))
;;;   (derive Persist Tree)
;;;   (persist-clone tree a)   ; a Tree sharing no memory with `tree`
;;;
;;; A type that derives Persist owns everything it reaches: a slice owns its
;;; elements, a `(ptr T)` owns the T it points to, an `ArrayList`, `HashMap` or
;;; `Option` owns its contents. `persist-clone` copies all of it into the
;;; allocator it is given, so the copy outlives whatever memory the original lives
;;; in. That is the whole mechanism for keeping a value past the arena that built
;;; it: no walker is written per type.
;;;
;;; What cannot be owned is refused where the derive is written, naming the
;;; field: an opaque pointer (`(ptr i8)`, `(ptr u8)`, `(ptr void)`), a `dyn`, a
;;; `fnptr`, a borrow (`ref`, `mut`), and shared ownership (`Rc`, `Arc`). Such a
;;; field has to become data before its type can persist.
;;;
;;; A field that belongs to the computation that built the value, not to the
;;; value, is left out of the copy, which holds it zeroed:
;;;
;;;   (derive (Persist (field memo (skip))) Entry)
;;;
;;; `persist-clone-sharing` copies what is not already where the copy is going:
;;; memory its `shared?` says is there is reused, not copied. A value that
;;; extends an earlier copy (a new state that keeps most of an old one) is then
;;; copied in proportion to what is new. What is shared must stay unchanged for
;;; as long as both live; the memory it is in must outlive both.
;;;
;;; `persist-save` writes a value as bytes and `persist-load` reads it back into
;;; an allocator, through the same derive: each field in order, a pointer's
;;; target where the pointer is, a container's length before its elements. The
;;; bytes are the value's layout as this build of the program sees it, with no
;;; names or types in them, so only the same build reads them back; whoever keeps
;;; them names the build beside them (the compiler keeps its toolchain digest).
;;;
;;; `persist-footprint` measures what a value owns, by the path of fields that
;;; reaches each block: `(footprint-report fp a 3)` lists, three fields deep, how
;;; many bytes sit under `loader`, `loader.sources`, `loader.sources.text`. A
;;; container's elements are measured under the container's path, so every
;;; element's `text` adds to one line.
;;;
;;; Persistent data must be trees. Two fields pointing at one value are copied
;;; twice, which is correct for values. A cycle would never finish; under
;;; --debug-checks the copy stops at the first pointer it re-enters.
(module coil.persist)
(import "coil.primitive" :as primitive)
(import "coil.cc" :as cc)
(import "coil.derive" :use [derive-impl derive-type-param?] :reexport)
(import "coil.alloc" :use *)
(import "coil.arraylist" :use *)
(import "coil.slice" :use *)
(import "coil.hashmap" :use *)
(import "coil.str" :use [keyops keyops-borrowed])
(import "coil.mem" :as mem)
(import "coil.panic" :use [panic])
(import "coil.control" :use *)

(export Persist PersistCx PersistWriter PersistReader PersistMeter Footprint
        persist-into persist-write persist-read persist-measure
        persist-clone persist-clone-sharing persist-pointee persist-save persist-load
        persist-footprint footprint-total footprint-report)

;;; Where a copy goes: the allocator, and under --debug-checks the addresses of
;;; the pointers being copied, outermost first, to find a cycle.
(defstruct PersistCx
  [(alc (dyn Allocator))
   (path (ArrayList i64))
   ; when `sharing`, memory `shared?` (given `shared-cx`) says is already where
   ; the copy goes is reused
   (sharing bool)
   (shared? (fnptr (cc/C) [(ptr i8) (ptr i8)] bool))
   (shared-cx (ptr i8))])

;;; Where `persist-save` writes, and under --debug-checks the pointers being
;;; written, as in PersistCx.
(defstruct PersistWriter [(bytes (ArrayList u8)) (path (ArrayList i64))])

;;; What `persist-load` reads from: the bytes, how far it has read, and where what
;;; it reads is allocated. `failed` once the bytes ran out or said something no
;;; value of the type could have written.
(defstruct PersistReader
  [(bytes (slice u8))
   (at i64)
   (alc (dyn Allocator))
   (failed bool)])

;;; One field path of a footprint: the bytes of the blocks reached through it
;;; (not counting those under its children), and the paths one field longer.
(defstruct Footprint
  [(name (slice u8))
   (bytes i64)
   (parent (ptr Footprint))
   (first-child (ptr Footprint))
   (next-sibling (ptr Footprint))])

;;; Where `persist-measure` records: the path it is at, how deep that is, and the
;;; depth past which a path is not lengthened (a recursive type's nodes all count
;;; at the depth it reaches).
(defstruct PersistMeter
  [(alc (dyn Allocator))
   (at (ptr Footprint))
   (depth i64)
   (limit i64)])

;;; A type whose values can be deep-copied into an allocator, written and read
;;; back as bytes, and measured. Derive it. `persist-read` returns the value R
;;; holds next; its SELF only says which type that is, and is not read.
;;; `persist-measure` records in M the blocks SELF owns, not SELF itself.
(deftrait Persist [Self]
  (persist-into [(self (ref Self)) (cx (ptr PersistCx))] (-> Self))
  (persist-write [(self (ref Self)) (w (ptr PersistWriter))] (-> i64))
  (persist-read [(self (ref Self)) (r (ptr PersistReader))] (-> Self))
  (persist-measure [(self (ref Self)) (m (ptr PersistMeter))] (-> i64)))

;;; A copy of X that shares no memory with it, allocated from A.
(defn persist-clone [(T Persist)] [(x (ref T)) (a (dyn Allocator))] (-> T)
  (let [(mut cx) (PersistCx :alc a :path (ArrayList::new [i64] (malloc-allocator))
                            :sharing false :shared? (fnptr-of persist--never) :shared-cx (primitive/cast (ptr i8) 0))
        out (persist-into x (mut cx))]
    (free! (mut (.path cx)))
    out))

;;; A copy of X in A that reuses the memory SHARED? (given SHARED-CX) says is
;;; already there, and copies the rest.
(defn persist-clone-sharing [(T Persist)] [(x (ref T))
                                           (a (dyn Allocator))
                                           (shared? (fnptr (cc/C) [(ptr i8) (ptr i8)] bool))
                                           (shared-cx (ptr i8))] (-> T)
  (let [(mut cx) (PersistCx :alc a :path (ArrayList::new [i64] (malloc-allocator))
                            :sharing true :shared? shared? :shared-cx shared-cx)
        out (persist-into x (mut cx))]
    (free! (mut (.path cx)))
    out))

;;; X as bytes, allocated from A: what `persist-load` reads back.
(defn persist-save [(T Persist)] [(x (ref T)) (a (dyn Allocator))] (-> (slice u8))
  (let [(mut w) (PersistWriter :bytes (ArrayList::new [u8] a)
                               :path (ArrayList::new [i64] (malloc-allocator)))]
    (persist-write x (mut w))
    (free! (mut (.path w)))
    (slice (.bytes w))))

;;; The value BYTES hold, in A, or None when they are not exactly one value of T.
(defn persist-load [(T Persist)] [(bytes (slice u8)) (a (dyn Allocator))] (-> (Option T))
  (let [(mut r) (PersistReader :bytes bytes :at 0 :alc a :failed false)
        slot (primitive/alloc-stack T)
        v (persist--read-value [T] slot (mut r))]
    (if (or (.failed r) (!= (.at r) (len bytes)))
        (None [T])
        (Some v))))

;;; What X owns, by field path, in A, paths at most LIMIT fields long (deeper
;;; blocks count at the path LIMIT fields down). The root path is "", and holds
;;; what X's own containers hold directly.
(defn persist-footprint [(T Persist)] [(x (ref T)) (a (dyn Allocator)) (limit i64)] (-> (ptr Footprint))
  (let [root (match (create [Footprint] a) (Some [p] p) (None [] (oom)))
        (mut m) (PersistMeter :alc a :at root :depth 0 :limit limit)]
    (store! root (primitive/zeroed Footprint))
    (persist-measure x (mut m))
    root))

;;; The bytes under FP: its own and every longer path's.
(defn footprint-total [(fp (ptr Footprint))] (-> i64)
  (let [(mut n) (.bytes fp)
        (mut child) (.first-child fp)]
    (loop (if (= (primitive/cast i64 (load child)) 0)
              (break)
              (do (store! n (+ (load n) (footprint-total (load child))))
                  (store! child (.next-sibling (load child))))))
    (load n)))

;;; FP as text in A, one line per path down to DEPTH fields, largest first, with
;;; the bytes under each.
(defn footprint-report [(fp (ptr Footprint)) (a (dyn Allocator)) (depth i64)] (-> (slice u8))
  (let [(mut out) (ArrayList::new [u8] a)]
    (persist--footprint-lines! (mut out) fp "" depth a)
    (slice out)))

(defn persist--text! [(out (mut (ArrayList u8))) (text (slice u8))] (-> i64)
  (unless (= (len text) 0) (extend! (mut out) (data text) (len text)) 0)
  0)

(defn persist--int! [(out (mut (ArrayList u8))) (n i64)] (-> i64)
  (if (< n 10)
      (push! (mut out) (primitive/cast u8 (+ 48 n)))
      (do (persist--int! (mut out) (/ n 10))
          (push! (mut out) (primitive/cast u8 (+ 48 (% n 10))))))
  0)

(defn persist--footprint-lines! [(out (mut (ArrayList u8))) (fp (ptr Footprint)) (path (slice u8))
                                 (depth i64) (a (dyn Allocator))] (-> i64)
  (persist--int! (mut out) (footprint-total fp))
  (persist--text! (mut out) "	")
  (persist--text! (mut out) (if (= (len path) 0) "(all)" path))
  (persist--text! (mut out) "
")
  (when (> depth 0)
    ; children largest first
    (let [(mut kids) (ArrayList::new [(ptr Footprint)] a)
          (mut child) (.first-child fp)]
      (loop (if (= (primitive/cast i64 (load child)) 0)
                (break)
                (do (push! (mut kids) (load child)) (store! child (.next-sibling (load child))))))
      (for [i 0 (len kids)]
        (let [(mut best) i]
          (for [j (+ i 1) (len kids)]
            (when (> (footprint-total (get kids j)) (footprint-total (get kids (load best))))
              (store! best j)))
          (let [t (get kids i)]
            (set! (mut kids) i (get kids (load best)))
            (set! (mut kids) (load best) t))
          (let [k (get kids i)
                (mut sub) (ArrayList::new [u8] a)]
            (persist--text! (mut sub) path)
            (unless (= (len path) 0) (persist--text! (mut sub) ".") 0)
            (persist--text! (mut sub) (.name k))
            (persist--footprint-lines! (mut out) k (slice sub) (- depth 1) a))))
      0))
  0)

;;; Count N bytes at M's path.
(defn persist--meter-add! [(m (ptr PersistMeter)) (n i64)] (-> i64)
  (set! (.bytes (.at m)) (+ (.bytes (.at m)) n))
  0)

;;; Go down to field NAME, unless M is as deep as it goes.
(defn persist--meter-enter! [(m (ptr PersistMeter)) (name (slice u8))] (-> i64)
  (when (< (.depth m) (.limit m))
    (let [at (.at m)
          (mut child) (.first-child at)]
      (loop (if (or (= (primitive/cast i64 (load child)) 0) (= (.name (load child)) name))
                (break)
                (store! child (.next-sibling (load child)))))
      (when (= (primitive/cast i64 (load child)) 0)
        (let [fresh (match (create [Footprint] (.alc m)) (Some [p] p) (None [] (oom)))]
          (store! fresh (Footprint :name name :bytes 0 :parent at
                                   :first-child (.first-child at)
                                   :next-sibling (primitive/cast (ptr Footprint) 0)))
          (set! (.first-child fresh) (primitive/cast (ptr Footprint) 0))
          (set! (.next-sibling fresh) (.first-child at))
          (set! (.first-child at) fresh)
          (store! child fresh)))
      (set! (.at m) (load child))))
  (set! (.depth m) (+ (.depth m) 1))
  0)

(defn persist--meter-leave! [(m (ptr PersistMeter))] (-> i64)
  (set! (.depth m) (- (.depth m) 1))
  (when (< (.depth m) (.limit m))
    (set! (.at m) (.parent (.at m))))
  0)

;;; Measure the T a pointer owns: a `(ptr T)` passes as the `(ref T)` this takes.
(defn persist--measure-pointee [(T Persist)] [(x (ref T)) (m (ptr PersistMeter))] (-> i64)
  (persist-measure x m))

;;; The T R holds next. X says which type that is; a `(ptr T)` passes as the
;;; `(ref T)` this takes.
(defn persist--read-value [(T Persist)] [(x (ref T)) (r (ptr PersistReader))] (-> T)
  (persist-read x r))

;;; The bytes of the value at X.
(defn persist--put [T] [(w (ptr PersistWriter)) (x (ref T))] (-> i64)
  (extend! (mut (.bytes w)) (primitive/cast (ptr u8) x) (primitive/sizeof T))
  0)

(defn persist--put-value [T] [(w (ptr PersistWriter)) (v T)] (-> i64)
  (let [slot (primitive/alloc-stack T)]
    (store! slot v)
    (extend! (mut (.bytes w)) (primitive/cast (ptr u8) slot) (primitive/sizeof T))
    0))

;;; Read a T's bytes into OUT; zeroes, and the reader failed, past the end.
(defn persist--get [T] [(r (ptr PersistReader)) (out (ptr T))] (-> i64)
  (let [n (primitive/sizeof T)]
    (if (> (+ (.at r) n) (len (.bytes r)))
        (do (set! (.failed r) true)
            (set! (.at r) (len (.bytes r)))
            (store! out (zeroed T)))
        (do (mem/copy (primitive/cast (ptr u8) out) (primitive/index (data (.bytes r)) (.at r)) n)
            (set! (.at r) (+ (.at r) n))
            0))))

(defn persist--get-value [T] [(r (ptr PersistReader))] (-> T)
  (let [slot (primitive/alloc-stack T)]
    (persist--get r slot)
    (load slot)))

(defn persist--get-i64 [(r (ptr PersistReader))] (-> i64)
  (persist--get-value [i64] r))

;;; A count of elements to read. A count larger than the bytes left is not one
;;; any value wrote (every element the derive writes takes a byte or more), so
;;; the reader fails rather than allocate for it.
(defn persist--get-count [(r (ptr PersistReader))] (-> i64)
  (let [n (persist--get-i64 r)]
    (if (or (< n 0) (> n (- (len (.bytes r)) (.at r))))
        (do (set! (.failed r) true) 0)
        n)))

(defn persist--never [(cx (ptr i8)) (p (ptr i8))] (-> bool) false)

;;; Is the memory at P already where CX copies to?
(defn persist--shared? [(cx (ptr PersistCx)) (p (ptr i8))] (-> bool)
  (and (.sharing cx) (call-ptr (.shared? cx) (.shared-cx cx) p)))

;;; The T a pointer owns, copied: a `(ptr T)` passes as the `(ref T)` this takes.
(defn persist-pointee [(T Persist)] [(x (ref T)) (cx (ptr PersistCx))] (-> T)
  (persist-into x cx))

(defn persist--alloc-one [T] [(cx (ptr PersistCx))] (-> (ptr T))
  (match (create [T] (.alc cx)) (Some [p] p) (None [] (oom))))

(defn persist--alloc-n [T] [(cx (ptr PersistCx)) (n i64)] (-> (slice T))
  (match (alloc [T] (.alc cx) n) (Some [s] s) (None [] (oom))))

;;; Under --debug-checks: refuse to enter pointer P again while copying what it
;;; points to.
(defn persist--enter [(cx Code) (p Code)] (-> Code)
  (if (primitive/debug-checks?)
      `(let [address (primitive/cast i64 ~p)]
         (for [i 0 (len (.path ~cx))]
           (when (= (get (.path ~cx) i) address)
             (debug-fail-at c"persist-clone: a pointer reaches itself while it is copied; persistent data must be trees")))
         (push! (mut (.path ~cx)) address))
      `0))

(defn persist--leave [(cx Code)] (-> Code)
  (if (primitive/debug-checks?)
      `(pop! (mut (.path ~cx)))
      `0))

; ---- scalars: copied ---------------------------------------------------------
(defn persist--scalar-impls [& (types Code)] (-> Code)
  (let [out (primitive/code-list-new)]
    (for [i 0 (primitive/code-count types)]
      (let [t (primitive/code-nth types i)]
        (primitive/code-list-push! out
                                   `(impl Persist ~t
                                      (persist-into [(self (ref ~t)) (cx (ptr PersistCx))] (-> ~t)
                                        self)
                                      (persist-write [(self (ref ~t)) (w (ptr PersistWriter))] (-> i64)
                                        (persist--put w self))
                                      (persist-read [(self (ref ~t)) (r (ptr PersistReader))] (-> ~t)
                                        (persist--get-value [~t] r))
                                      (persist-measure [(self (ref ~t)) (m (ptr PersistMeter))] (-> i64)
                                        0)))))
    `(do ~@(primitive/code-list-done out))))

(persist--scalar-impls i8 i16 i32 i64 u8 u16 u32 u64 f32 f64 bool)

; ---- owned memory ------------------------------------------------------------
;;; A `(ptr T)` owns one T. A null pointer stays null.
(impl [(T Persist)] Persist (ptr T)
  (persist-into [(self (ref (ptr T))) (cx (ptr PersistCx))] (-> (ptr T))
    (let [p (load self)]
      (if (or (= (primitive/cast i64 p) 0) (persist--shared? cx (primitive/cast (ptr i8) p)))
          p
          (let [out (persist--alloc-one [T] cx)]
            (persist--enter cx p)
            (store! out (persist-pointee [T] p cx))
            (persist--leave cx)
            out))))
  (persist-write [(self (ref (ptr T))) (w (ptr PersistWriter))] (-> i64)
    (let [p (load self)]
      (if (= (primitive/cast i64 p) 0)
          (persist--put-value w false)
          (do (persist--put-value w true)
              (persist--enter w p)
              (persist--write-pointee [T] p w)
              (persist--leave w)
              0))))
  (persist-read [(self (ref (ptr T))) (r (ptr PersistReader))] (-> (ptr T))
    (if (persist--get-value [bool] r)
        (let [p (match (create [T] (.alc r)) (Some [p] p) (None [] (oom)))]
          (store! p (persist--read-value [T] p r))
          p)
        (primitive/cast (ptr T) 0)))
  (persist-measure [(self (ref (ptr T))) (m (ptr PersistMeter))] (-> i64)
    (let [p (load self)]
      (unless (= (primitive/cast i64 p) 0)
        (persist--meter-add! m (primitive/sizeof T))
        (persist--measure-pointee [T] p m)
        0)
      0)))

;;; Write the T a pointer owns: a `(ptr T)` passes as the `(ref T)` this takes.
(defn persist--write-pointee [(T Persist)] [(x (ref T)) (w (ptr PersistWriter))] (-> i64)
  (persist-write x w))

;;; A slice owns its elements. An empty slice stays empty and allocates nothing.
(impl [(T Persist)] Persist (slice T)
  (persist-into [(self (ref (slice T))) (cx (ptr PersistCx))] (-> (slice T))
    (let [n (len self)]
      (cond (= n 0) (slice::new (primitive/cast (ptr T) 0) 0)
            (persist--shared? cx (primitive/cast (ptr i8) (data (load self)))) (load self)
            :else
          (let [(mut out) (persist--alloc-n [T] cx n)]
            (for [i 0 n]
              (init! (mut out) i (persist-into (at self i) cx)))
            out))))
  (persist-write [(self (ref (slice T))) (w (ptr PersistWriter))] (-> i64)
    (persist--put-value w (len self))
    (for [i 0 (len self)]
      (persist-write (at self i) w))
    0)
  (persist-read [(self (ref (slice T))) (r (ptr PersistReader))] (-> (slice T))
    (let [n (persist--get-count r)]
      (if (= n 0)
          (slice::new (primitive/cast (ptr T) 0) 0)
          (let [(mut items) (match (alloc [T] (.alc r) n) (Some [s] s) (None [] (oom)))]
            (for [i 0 n]
              (init! (mut items) i (persist--read-value [T] (primitive/index (data items) i) r)))
            items))))
  (persist-measure [(self (ref (slice T))) (m (ptr PersistMeter))] (-> i64)
    (persist--meter-add! m (* (len self) (primitive/sizeof T)))
    (for [i 0 (len self)]
      (persist-measure (at self i) m))
    0))

;;; A list owns its elements; the copy holds exactly them and grows in the
;;; allocator it was copied into.
(impl [(T Persist)] Persist (ArrayList T)
  (persist-into [(self (ref (ArrayList T))) (cx (ptr PersistCx))] (-> (ArrayList T))
    (if (and (> (len self) 0)
             (persist--shared? cx (primitive/cast (ptr i8) (data (slice (load self))))))
        (load self)
        (let [n (len self)
              (mut out) (ArrayList::new [T] (.alc cx))]
          (reserve! (mut out) n)
          (for [i 0 n]
            (push! (mut out) (persist-into (at self i) cx)))
          out)))
  (persist-write [(self (ref (ArrayList T))) (w (ptr PersistWriter))] (-> i64)
    (persist--put-value w (len self))
    (for [i 0 (len self)]
      (persist-write (at self i) w))
    0)
  (persist-read [(self (ref (ArrayList T))) (r (ptr PersistReader))] (-> (ArrayList T))
    (let [n (persist--get-count r)
          (mut items) (ArrayList::new [T] (.alc r))
          slot (primitive/alloc-stack T)]
      (reserve! (mut items) n)
      (for [i 0 n]
        (push! (mut items) (persist--read-value [T] slot r)))
      (load items)))
  (persist-measure [(self (ref (ArrayList T))) (m (ptr PersistMeter))] (-> i64)
    (persist--meter-add! m (* (load (field self cap)) (primitive/sizeof T)))
    (for [i 0 (len self)]
      (persist-measure (at self i) m))
    0))

;;; A map owns its keys and values, and keeps its key operations (static code).
;;; A map whose operations own their keys copies each key itself on insert.
(impl [(K Persist) (V Persist)] Persist (HashMap K V)
  (persist-into [(self (ref (HashMap K V))) (cx (ptr PersistCx))] (-> (HashMap K V))
    (if (and (> (cap (load self)) 0)
             (persist--shared? cx (primitive/cast (ptr i8) (load (field self slots)))))
        (load self)
        (let [ops (load (field self ops))
              owns (owns? ops)
              (mut out) (HashMap::new [K V] (.alc cx) ops)]
          (for-entries [k v self]
            (set! (mut out)
                  (if owns (load k) (persist-into k cx))
                  (persist-into v cx)))
          out)))
  ;; A map is written as its slot table, tombstones and all: read back, it is
  ;; the same table, so it is not hashed again and writes the same bytes.
  (persist-write [(self (ref (HashMap K V))) (w (ptr PersistWriter))] (-> i64)
    (let [cap (load (field self cap))
          slots (load (field self slots))]
      (persist--put-value w (persist--keyops-tag [K] (load (field self ops))))
      (persist--put-value w cap)
      (persist--put-value w (load (field self len)))
      (persist--put-value w (load (field self tombs)))
      (for [i 0 cap]
        (let [e (primitive/index slots i)
              state (load (field e state))]
          (persist--put-value w state)
          (when (= state 1)
            (persist--put-value w (load (field e hash)))
            (persist--write-pointee [K] (field e key) w)
            (persist--write-pointee [V] (field e val) w)
            0)))
      0))
  (persist-read [(self (ref (HashMap K V))) (r (ptr PersistReader))] (-> (HashMap K V))
    (let [ops (persist--keyops [K] r (persist--get-i64 r))
          cap (persist--get-count r)
          n (persist--get-i64 r)
          tombs (persist--get-i64 r)
          (mut m) (HashMap::new [K V] (.alc r) ops)
          (mut full) 0]
      (when (> cap 0)
        (let [slots (match (alloc [(Entry K V)] (.alc r) cap) (Some [s] s) (None [] (oom)))]
          (mem/zero (data slots) cap)
          (for [i 0 cap]
            (let [e (primitive/index (data slots) i)
                  state (persist--get-value [i32] r)]
              (store! (field e state) state)
              (cond (= state 1)
                      (do (store! (field e hash) (persist--get-value [i32] r))
                          (store! (field e key) (persist--read-value [K] (field e key) r))
                          (store! (field e val) (persist--read-value [V] (field e val) r))
                          (store! full (+ (load full) 1)))
                    (or (= state 0) (= state 2)) 0
                    :else (do (set! (.failed r) true) 0))))
          (store! (field m slots) (data slots))
          (store! (field m cap) cap)
          (store! (field m len) n)
          (store! (field m tombs) tombs)
          0))
      ; a table no map could have: refused, and an empty map in its place
      (if (and (= (load full) n) (HashMap::header-valid? [K V] (load m)))
          (load m)
          (do (set! (.failed r) true)
              (HashMap::new [K V] (.alc r) ops)))))
  (persist-measure [(self (ref (HashMap K V))) (m (ptr PersistMeter))] (-> i64)
    (persist--meter-add! m (* (load (field self cap)) (primitive/sizeof (Entry K V))))
    (for-entries [k v self]
      (persist-measure k m)
      (persist-measure v m))
    0))

;;; Which of the key operations a map can be read back with OPS are. They are
;;; code, so the bytes name them; key operations of another kind cannot be saved.
(defn persist--keyops-tag [K] [(ops (ptr KeyOps))] (-> i64)
  (cond (= (primitive/cast i64 ops) (primitive/cast i64 (i64-keyops))) 1
        (= (primitive/cast i64 ops) (primitive/cast i64 (keyops))) 2
        (= (primitive/cast i64 ops) (primitive/cast i64 (keyops-borrowed))) 3
        (= (primitive/cast i64 ops) (primitive/cast i64 (scalar-keyops [K]))) 4
        :else (panic "persist-save: a map's key operations are not i64-keyops, keyops, keyops-borrowed or scalar-keyops, so the map cannot be written")))

(defn persist--keyops [K] [(r (ptr PersistReader)) (tag i64)] (-> (ptr KeyOps))
  (cond (= tag 1) (i64-keyops)
        (= tag 2) (keyops)
        (= tag 3) (keyops-borrowed)
        (= tag 4) (scalar-keyops [K])
        :else (do (set! (.failed r) true) (i64-keyops))))

(impl [(T Persist)] Persist (Option T)
  (persist-into [(self (ref (Option T))) (cx (ptr PersistCx))] (-> (Option T))
    (match self
      (None [] (None [T]))
      (Some [v] (Some [T] (persist-into v cx)))))
  (persist-write [(self (ref (Option T))) (w (ptr PersistWriter))] (-> i64)
    (match self
      (None [] (persist--put-value w false))
      (Some [v] (do (persist--put-value w true) (persist-write v w)))))
  (persist-read [(self (ref (Option T))) (r (ptr PersistReader))] (-> (Option T))
    (if (persist--get-value [bool] r)
        (let [v (primitive/alloc-stack T)]
          (Some [T] (persist--read-value [T] v r)))
        (None [T])))
  (persist-measure [(self (ref (Option T))) (m (ptr PersistMeter))] (-> i64)
    (match self
      (None [] 0)
      (Some [v] (persist-measure v m)))))

(impl [(T Persist) (E Persist)] Persist (Result T E)
  (persist-into [(self (ref (Result T E))) (cx (ptr PersistCx))] (-> (Result T E))
    (match self
      (Ok [v] (Ok [T E] (persist-into v cx)))
      (Err [e] (Err [T E] (persist-into e cx)))))
  (persist-write [(self (ref (Result T E))) (w (ptr PersistWriter))] (-> i64)
    (match self
      (Ok [v] (do (persist--put-value w true) (persist-write v w)))
      (Err [e] (do (persist--put-value w false) (persist-write e w)))))
  (persist-read [(self (ref (Result T E))) (r (ptr PersistReader))] (-> (Result T E))
    (if (persist--get-value [bool] r)
        (let [v (primitive/alloc-stack T)]
          (Ok [T E] (persist--read-value [T] v r)))
        (let [e (primitive/alloc-stack E)]
          (Err [T E] (persist--read-value [E] e r)))))
  (persist-measure [(self (ref (Result T E))) (m (ptr PersistMeter))] (-> i64)
    (match self
      (Ok [v] (persist-measure v m))
      (Err [e] (persist-measure e m)))))

; ---- the derive ----------------------------------------------------------------
(defn persist--scalar? [(ty Code)] (-> bool)
  (and (primitive/code-sym? ty)
       (or (primitive/code-eq ty `i8) (primitive/code-eq ty `i16)
           (primitive/code-eq ty `i32) (primitive/code-eq ty `i64)
           (primitive/code-eq ty `u8) (primitive/code-eq ty `u16)
           (primitive/code-eq ty `u32) (primitive/code-eq ty `u64)
           (primitive/code-eq ty `f32) (primitive/code-eq ty `f64)
           (primitive/code-eq ty `bool))))

;;; Whether a reflected type name is a trait object: reflection spells
;;; `(dyn Allocator)` as the struct the compiler represents it with,
;;; `coil.alloc.Allocator-dyn`.
(defn persist--dyn-name? [(name (slice u8))] (-> bool)
  (let [n (len name)]
    (and (> n 4) (= (subslice name (- n 4) n) "-dyn"))))

;;; Why a field of type TY cannot be owned, or "" when it can. Looks through
;;; type arguments: `(ArrayList (ptr i8))` is refused for its elements.
(defn persist--refusal [(ty Code)] (-> (slice u8))
  (if (not (primitive/code-list? ty))
      (cond (primitive/code-eq ty `coil.rc.Rc) "shared ownership has no single owner to copy"
            (primitive/code-eq ty `coil.arc.Arc) "shared ownership has no single owner to copy"
            (persist--dyn-name? (primitive/code-str ty)) "a dyn is code and state the copy cannot see into"
            :else "")
      (let [n (primitive/code-count ty)
            head (if (> n 0) (primitive/code-nth ty 0) `())]
        (cond (= n 0) ""
              (primitive/code-eq head `dyn) "a dyn is code and state the copy cannot see into"
              (primitive/code-eq head `fnptr) "a function pointer is process state, not data"
              (primitive/code-eq head `ref) "a borrow does not own what it points to"
              (primitive/code-eq head `mut) "a borrow does not own what it points to"
              (and (primitive/code-eq head `ptr)
                   (= n 2)
                   (let [inner (primitive/code-nth ty 1)]
                     (or (primitive/code-eq inner `i8)
                         (primitive/code-eq inner `u8)
                         (primitive/code-eq inner `void))))
                "an opaque pointer does not say what it owns"
              :else
                (let [(mut why) ""]
                  (for [i 0 n]
                    (when (= (len (load why)) 0)
                      (store! why (persist--refusal (primitive/code-nth ty i)))))
                  (load why))))))

;;; Type syntax as it is written: `(ptr i8)`.
(defn persist--type-text [(ty Code)] (-> (slice u8))
  (if (primitive/code-list? ty)
      (let [(mut text) "("]
        (for [i 0 (primitive/code-count ty)]
          (store! text (if (= i 0)
                           (primitive/code-str (load text) (persist--type-text (primitive/code-nth ty i)))
                           (primitive/code-str (load text) " " (persist--type-text (primitive/code-nth ty i))))))
        (primitive/code-str (load text) ")"))
      (let [name (primitive/code-str ty)]
        (if (persist--dyn-name? name)
            (primitive/code-str "(dyn " (subslice name 0 (- (len name) 4)) ")")
            name))))

(defn persist--check [(tname Code) (fname Code) (ty Code)] (-> i64)
  (let [why (persist--refusal ty)]
    (if (= (len why) 0)
        0
        (primitive/code-int
          (primitive/error (primitive/code-str "derive Persist: field '" fname "' of "
                                               tname " has type " (persist--type-text ty) ": " why
                                               "; make it data"))))))

;;; Is TY a sum none of whose variants carries a value, an enumeration? Its
;;; values own nothing, so they are copied as they are.
(defn persist--enum? [(ty Code)] (-> bool)
  (and (primitive/code-sym? ty)
       (match (primitive/code-type-shape ty)
         (primitive/SumShape []
           (let [(mut plain) true]
             (for [i 0 (primitive/code-variant-count ty)]
               (when (> (primitive/code-variant-fields ty i) 0)
                 (store! plain false)))
             (load plain)))
         (_ false))))

;;; Is a field of type TY copied as it is: a scalar or an enumeration, and not
;;; one of the target's type parameters?
(defn persist--plain? [(tname Code) (ty Code)] (-> bool)
  (and (not (derive-type-param? tname ty))
       (or (persist--scalar? ty) (persist--enum? ty))))

;;; The copy of the value in PLACE, of type TY.
(defn persist--value [(tname Code) (ty Code) (place Code) (cx Code)] (-> Code)
  (if (persist--plain? tname ty)
      `(load ~place)
      `(persist-into ~place ~cx)))

;;; The fields OPTS skips, after checking each option names a field of TNAME.
;;; An option is `(field NAME (skip))`.
(defn persist--skips [(tname Code) (opts Code)] (-> Code)
  (let [out (primitive/code-list-new)
        n (primitive/code-field-count tname)]
    (for [i 0 (primitive/code-count opts)]
      (let [o (primitive/code-nth opts i)]
        (unless (and (primitive/code-list? o)
                     (= (primitive/code-count o) 3)
                     (primitive/code-eq (primitive/code-nth o 0) `field)
                     (primitive/code-list? (primitive/code-nth o 2))
                     (= (primitive/code-count (primitive/code-nth o 2)) 1)
                     (primitive/code-eq (primitive/code-nth (primitive/code-nth o 2) 0) `skip))
          (primitive/error "derive Persist: an option is (field NAME (skip))"))
        (let [(mut found) false]
          (for [k 0 n]
            (when (primitive/code-eq (primitive/code-field-name tname k) (primitive/code-nth o 1))
              (store! found true)))
          (unless (load found)
            (primitive/error (primitive/code-str "derive Persist: " tname " has no field '"
                                                 (primitive/code-nth o 1) "' to skip"))))
        (primitive/code-list-push! out (primitive/code-nth o 1))))
    (primitive/code-list-done out)))

(defn persist--skipped? [(skips Code) (fname Code)] (-> bool)
  (let [(mut found) false]
    (for [i 0 (primitive/code-count skips)]
      (when (primitive/code-eq (primitive/code-nth skips i) fname)
        (store! found true)))
    (load found)))

(defn persist--struct [(tname Code) (opts Code)] (-> Code)
  (let [self (primitive/fresh-identifier "self")
        cx (primitive/fresh-identifier "cx")
        w (primitive/fresh-identifier "w")
        r (primitive/fresh-identifier "r")
        m (primitive/fresh-identifier "m")
        n (primitive/code-field-count tname)
        skips (persist--skips tname opts)
        args (primitive/code-list-new)
        writes (primitive/code-list-new)
        reads (primitive/code-list-new)
        read-args (primitive/code-list-new)
        measures (primitive/code-list-new)]
    (for [i 0 n]
      (let [fname (primitive/code-field-name tname i)
            ty (primitive/code-field-type tname i)
            v (primitive/fresh-identifier (primitive/code-symbol "read$" fname))]
        (primitive/code-list-push! args (primitive/code-symbol ":" fname))
        (primitive/code-list-push! read-args (primitive/code-symbol ":" fname))
        (primitive/code-list-push! read-args v)
        (primitive/code-list-push! reads v)
        (if (persist--skipped? skips fname)
            (do (primitive/code-list-push! args `(zeroed ~ty))
                (primitive/code-list-push! reads `(zeroed ~ty)))
            (do (persist--check tname fname ty)
                (primitive/code-list-push! args (persist--value tname ty `(field ~self ~fname) cx))
                (primitive/code-list-push! writes (if (persist--plain? tname ty)
                                                      (persist--write tname ty `(load (field ~self ~fname)) w)
                                                      `(persist-write (field ~self ~fname) ~w)))
                (primitive/code-list-push! reads (persist--read tname ty `(field ~self ~fname) r))
                (unless (persist--plain? tname ty)
                  (primitive/code-list-push! measures (persist--measure-field fname `(field ~self ~fname) m))
                  0)))))
    (let [fields (primitive/code-list-done args)
          ctor (if (primitive/code-list? tname)
                   `(~(primitive/code-nth tname 0) [~@(persist--targs tname)] ~@fields)
                   `(~tname ~@fields))
          read-fields (primitive/code-list-done read-args)
          read-ctor (if (primitive/code-list? tname)
                        `(~(primitive/code-nth tname 0) [~@(persist--targs tname)] ~@read-fields)
                        `(~tname ~@read-fields))]
      (derive-impl `Persist
                   tname
                   `((persist-into [(~self (ref ~tname)) (~cx (ptr PersistCx))] (-> ~tname)
                       ~ctor)
                     (persist-write [(~self (ref ~tname)) (~w (ptr PersistWriter))] (-> i64)
                       ~@(primitive/code-list-done writes)
                       0)
                     ; the fields in order: a let reads them in the order written
                     (persist-read [(~self (ref ~tname)) (~r (ptr PersistReader))] (-> ~tname)
                       (let [~@(primitive/code-list-done reads)]
                         ~read-ctor))
                     (persist-measure [(~self (ref ~tname)) (~m (ptr PersistMeter))] (-> i64)
                       ~@(primitive/code-list-done measures)
                       0))))))

;;; Measure the field FNAME at PLACE under its own path.
(defn persist--measure-field [(fname Code) (place Code) (m Code)] (-> Code)
  `(do (persist--meter-enter! ~m ~(primitive/code-str fname))
       (persist-measure ~place ~m)
       (persist--meter-leave! ~m)))

;;; Write VALUE, of type TY, to W: a scalar as its bytes, an enumeration as the
;;; position of its variant (its bytes would include padding), anything else
;;; through its Persist.
(defn persist--write [(tname Code) (ty Code) (value Code) (w Code)] (-> Code)
  (cond (persist--enum? ty)
          (let [arms (primitive/code-list-new)]
            (for [vi 0 (primitive/code-variant-count ty)]
              (primitive/code-list-push! arms `(~(primitive/code-variant-qname ty vi) [] ~vi)))
            `(persist--put-value ~w (match ~value ~@(primitive/code-list-done arms))))
        (persist--plain? tname ty) `(persist--put-value ~w ~value)
        :else `(persist-write ~value ~w)))

;;; The TY R holds next; WITNESS is a place of that type.
(defn persist--read [(tname Code) (ty Code) (witness Code) (r Code)] (-> Code)
  (cond (persist--enum? ty)
          (let [tag (primitive/fresh-identifier "tag")
                arms (primitive/code-list-new)]
            (for [vi 0 (primitive/code-variant-count ty)]
              (primitive/code-list-push! arms `(= ~tag ~vi))
              (primitive/code-list-push! arms `(~(primitive/code-variant-qname ty vi))))
            `(let [~tag (persist--get-i64 ~r)]
               (cond ~@(primitive/code-list-done arms)
                     :else (do (set! (.failed ~r) true) (~(primitive/code-variant-qname ty 0))))))
        (persist--plain? tname ty) `(persist--get-value [~ty] ~r)
        :else `(persist-read ~witness ~r)))

(defn persist--targs [(tname Code)] (-> Code)
  (let [out (primitive/code-list-new)]
    (for [i 1 (primitive/code-count tname)]
      (primitive/code-list-push! out (primitive/code-nth tname i)))
    (primitive/code-list-done out)))

;;; A sum is written as its variant's position, then the variant's fields.
(defn persist--sum [(tname Code)] (-> Code)
  (let [self (primitive/fresh-identifier "self")
        cx (primitive/fresh-identifier "cx")
        w (primitive/fresh-identifier "w")
        r (primitive/fresh-identifier "r")
        tag (primitive/fresh-identifier "tag")
        m (primitive/fresh-identifier "m")
        arms (primitive/code-list-new)
        write-arms (primitive/code-list-new)
        read-arms (primitive/code-list-new)
        measure-arms (primitive/code-list-new)]
    (for [vi 0 (primitive/code-variant-count tname)]
      (let [vq (primitive/code-variant-qname tname vi)
            nf (primitive/code-variant-fields tname vi)
            binds (primitive/code-list-new)
            values (primitive/code-list-new)
            writes (primitive/code-list-new)
            slots (primitive/code-list-new)
            loads (primitive/code-list-new)
            measures (primitive/code-list-new)]
        (for [fi 0 nf]
          (let [fname (primitive/code-variant-field-name tname vi fi)
                ty (primitive/code-variant-field-type tname vi fi)
                b (primitive/fresh-identifier (primitive/code-symbol "persist$" fname))
                slot (primitive/fresh-identifier (primitive/code-symbol "slot$" fname))]
            (persist--check tname fname ty)
            (primitive/code-list-push! binds b)
            (primitive/code-list-push! values (if (persist--plain? tname ty)
                                                  b
                                                  `(persist-into ~b ~cx)))
            (primitive/code-list-push! writes (persist--write tname ty b w))
            (primitive/code-list-push! slots slot)
            (primitive/code-list-push! slots `(primitive/alloc-stack ~ty))
            (primitive/code-list-push! slots b)
            (primitive/code-list-push! slots (if (persist--plain? tname ty)
                                                 (persist--read tname ty slot r)
                                                 `(persist--read-value [~ty] ~slot ~r)))
            (primitive/code-list-push! loads b)
            (unless (persist--plain? tname ty)
              (primitive/code-list-push! measures (persist--measure-field fname b m))
              0)))
        (let [bs (primitive/code-list-done binds)
              vs (primitive/code-list-done values)
              made (primitive/code-list-done loads)]
          (primitive/code-list-push! arms
                                     `(~vq [~@bs]
                                        ~(if (primitive/code-list? tname)
                                             `(~vq [~@(persist--targs tname)] ~@vs)
                                             `(~vq ~@vs))))
          (primitive/code-list-push! write-arms
                                     `(~vq [~@bs]
                                        (do (persist--put-value ~w ~vi)
                                            ~@(primitive/code-list-done writes)
                                            0)))
          (primitive/code-list-push! measure-arms
                                     `(~vq [~@bs] (do ~@(primitive/code-list-done measures) 0)))
          (primitive/code-list-push! read-arms `(= ~tag ~vi))
          (primitive/code-list-push! read-arms
                                     `(let [~@(primitive/code-list-done slots)]
                                        ~(if (primitive/code-list? tname)
                                             `(~vq [~@(persist--targs tname)] ~@made)
                                             `(~vq ~@made)))))))
    (derive-impl `Persist
                 tname
                 `((persist-into [(~self (ref ~tname)) (~cx (ptr PersistCx))] (-> ~tname)
                     (match ~self ~@(primitive/code-list-done arms)))
                   (persist-write [(~self (ref ~tname)) (~w (ptr PersistWriter))] (-> i64)
                     (match ~self ~@(primitive/code-list-done write-arms)))
                   (persist-read [(~self (ref ~tname)) (~r (ptr PersistReader))] (-> ~tname)
                     (let [~tag (persist--get-i64 ~r)]
                       (cond ~@(primitive/code-list-done read-arms)
                             :else (do (set! (.failed ~r) true) (zeroed ~tname)))))
                   (persist-measure [(~self (ref ~tname)) (~m (ptr PersistMeter))] (-> i64)
                     (match ~self ~@(primitive/code-list-done measure-arms)))))))

(defderive Persist
           (struct [tname & opts] (persist--struct tname opts))
           (sum [tname & opts]
                (if (> (primitive/code-count opts) 0)
                    (primitive/error "derive Persist: (field NAME (skip)) applies to a struct's fields")
                    (persist--sum tname))))
