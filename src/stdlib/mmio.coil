; Memory-mapped I/O device registers as a typed bitfield — a PURE MACRO. The §7
; capstone: "expressiveness through macros" at its hardest domain (hardware device
; registers), with ZERO core feature. `defmmio-reg` takes a register spec (name,
; MMIO address, and named bit-fields) and GENERATES — entirely via the macro system —
; a volatile-load reader, a volatile-store writer, and a shift+mask getter per field,
; over typed volatile memory operations + `iand`/`ishr`/`ishl` primitives.
;
;   (defmmio-reg UARTFR 150994968        ; 0x09000018 — PL011 flag register
;     [(rxfe 4 1) (txff 5 1)])           ; (field, bit-offset, width)
; expands to:
;   UARTFR-read  []        -> i32        ; volatile load the 32-bit register
;   UARTFR-write [(v i32)] -> i64        ; volatile store
;   UARTFR-rxfe  []        -> i32        ; (read >> 4) & 1
;   UARTFR-txff  []        -> i32        ; (read >> 5) & 1
(module coil.mmio)
(import "coil.primitive" :as primitive)

;; one shift+mask getter per field. The mask `(1 << width) - 1`
;; is emitted as ordinary code (LLVM const-folds it), so no macro-time bit ops.
;; Built with a growable Code list, not `(~getter ~@(self …)): splicing the
;; recursion's result re-copies the suffix per field, which is quadratic in the
;; field count (docs/design/META_MEMORY.md).
(defn defmmio--fields [(name Code) (fields Code) (i i64)] (-> Code)
  (let [out (primitive/code-list-new)
        (mut k) i]
    (loop (if (= (load k) (primitive/code-count fields))
              (break)
              (let [f (primitive/code-nth fields (load k))
                    fname (primitive/code-nth f 0)
                    offset (primitive/code-nth f 1)
                    width (primitive/code-nth f 2)]
                (do (primitive/code-list-push! out
                      `(defn ~(primitive/code-symbol name "-" fname) [] (-> u32)
                         (primitive/iand (primitive/ishr (~(primitive/code-symbol name "-read")) ~offset)
                                         (primitive/isub (primitive/ishl 1 ~width) 1))))
                    (store! k (primitive/iadd (load k) 1))))))
    (primitive/code-list-done out)))

(defn defmmio-reg [(name Code) (addr Code) (fields Code)] (-> Code)
  `(do
     ; Registers are UNSIGNED (u32), so field extraction uses a logical shift.
     (defn ~(primitive/code-symbol name "-read") [] (-> u32)
       (primitive/volatile-load u32 (primitive/cast (ptr u32) ~addr)))
     (defn ~(primitive/code-symbol name "-write") [(v u32)] (-> i64)
       (primitive/volatile-store! (primitive/cast (ptr u32) ~addr) v))
     ~@(defmmio--fields name fields 0)))
