(module coil.mmio)
(import "coil.primitive" :as primitive)

;;; A readable register. Reading performs one volatile load and returns a snapshot.
;;; Volatile accesses are not CPU/device memory barriers.
(deftrait Readable [Self Value]
  (read! [(register Self)] (-> Value)))

;;; A writable register. Writing performs one volatile store of the raw value.
;;; No implicit read-modify-write, reserved-bit handling, or snapshot conversion.
(deftrait Writable [Self Value]
  (write! [(register Self) (value Value)] (-> i64)))

;;; What a program may do with a register.
(defsum Access
  ;;; `read!` only.
  (ReadOnly)
  ;;; `write!` only.
  (WriteOnly)
  ;;; Both.
  (ReadWrite))

;;; The Access the constructor call ACCESS names where it was written,
;;; `(mmio/ReadOnly)` under `(import "coil.mmio" :as mmio)`.
(defn mmio-access [(access Code)] (-> Access)
  (if (not (and (primitive/code-list? access)
                (= (primitive/code-count access) 1)
                (primitive/code-sym? (primitive/code-nth access 0))))
      (primitive/error "defmmio-reg: :access takes a coil.mmio.Access, such as (mmio/ReadOnly), (mmio/WriteOnly) or (mmio/ReadWrite)")
      0)
  (let [q (primitive/code-str (primitive/code-variant-ref (primitive/code-nth access 0)) "")]
    (cond (= q "coil.mmio.ReadOnly") (ReadOnly)
          (= q "coil.mmio.WriteOnly") (WriteOnly)
          (= q "coil.mmio.ReadWrite") (ReadWrite)
          :else
            (do
              (primitive/error "defmmio-reg: :access takes a coil.mmio.Access, such as (mmio/ReadOnly), (mmio/WriteOnly) or (mmio/ReadWrite)")
              (ReadOnly)))))

(defn mmio-name [(name Code) (suffix (slice u8))] (-> Code)
  ; hygiene: generated register API types intentionally enter the caller namespace.
  (primitive/syntax->datum (primitive/code-symbol name suffix)))

(defn mmio-width [(type Code)] (-> i64)
  (cond (= type `u8) 8
        (= type `u16) 16
        (= type `u32) 32
        (= type `u64) 64
        :else
          (do
            (primitive/error "defmmio-reg: :type must be u8, u16, u32 or u64")
            0)))

(defn mmio-fields [(snapshot Code) (type Code) (fields Code)] (-> Code)
  (let [out (primitive/code-list-new)
        bits (mmio-width type)
        (mut i) 0]
    (if (not (primitive/code-vector? fields))
        (primitive/error "defmmio-reg: expected a vector of field declarations")
        0)
    (loop (if (= i (primitive/code-count fields))
              (break)
              (let [field (primitive/code-nth fields i)
                    n
                      (if (primitive/code-list? field)
                          (primitive/code-count field)
                          0)]
                (if (or (not (primitive/code-list? field)) (not (= n 3)))
                    (primitive/error "defmmio-reg: expected (name :bit offset) or (name :bits [offset width])")
                    0)
                (let [[name kind spec] field
                      offset
                        (if (= kind `:bit)
                            spec
                            (if (and (= kind `:bits)
                                     (primitive/code-vector? spec)
                                     (= (primitive/code-count spec) 2))
                                (primitive/code-nth spec 0)
                                (do
                                  (primitive/error "defmmio-reg: invalid field specification")
                                  `0)))
                      width (if (= kind `:bit) `1 (primitive/code-nth spec 1))]
                  (if (or (not (primitive/code-sym? name)) (= name `bits))
                      (primitive/error "defmmio-reg: field must be an identifier other than bits")
                      0)
                  (if (not (and (primitive/code-int? offset)
                                (primitive/code-int? width)))
                      (primitive/error "defmmio-reg: field offset and width must be integer literals")
                      0)
                  (let [lo (primitive/code-int offset)
                        size (primitive/code-int width)
                        (mut j) 0]
                    (if (or (< lo 0)
                            (<= size 0)
                            (> size bits)
                            (> lo (- bits size)))
                        (primitive/error "defmmio-reg: field is outside the register width")
                        0)
                    (loop (if (= j i)
                              (break)
                              (do
                                (if (= name
                                       (primitive/code-nth (primitive/code-nth fields
                                                                               j)
                                                           0))
                                    (primitive/error "defmmio-reg: duplicate field name")
                                    0)
                                (set! j (+ j 1)))))
                    (let [target (primitive/fresh-identifier "mmio-snapshot")
                          key (primitive/code-symbol ":" name)
                          value
                            `(primitive/iand (primitive/ishr (.bits ~target)
                                                             ~offset)
                                             (primitive/ishr (primitive/cast ~type
                                                                             -1)
                                                             ~(- bits size)))
                          result (if (= kind `:bit) `bool type)
                          body
                            (if (= kind `:bit)
                                `(not (= ~value (: 0 ~type)))
                                value)]
                      (primitive/code-list-push! out
                                                 `(impl FieldGet (Field ~snapshot
                                                                        ~key)
                                                    (get-field [(self (Field ~snapshot
                                                                             ~key))
                                                                (~target ~snapshot)]
                                                      (-> ~result)
                                                      ~body))))))
                (set! i (+ i 1)))))
    (primitive/code-list-done out)))

;;; Declare a fixed-address register and computed snapshot fields:
;;; (defmmio-reg GPIO_IN :address 0x6000403C :type u32 :access (mmio/ReadOnly)
;;;   [(boot-button :bit 9) (mode :bits [12 3])])
;;; Generates GPIO_IN-Register (address: ptr u32), GPIO_IN-Snapshot (bits: u32),
;;; and GPIO_IN, a descriptor. Access is a coil.mmio.Access: ReadOnly, WriteOnly or
;;; ReadWrite.
;;; (.boot-button (read! GPIO_IN)) is bool; .mode is u32. .bits is the raw snapshot.
;;; Aliased fields may overlap. No computed snapshot setters are generated.
(defn defmmio-reg [(name Code) & (options Code)] (-> Code)
  (if (not (= (primitive/code-count options) 7))
      (primitive/error "defmmio-reg: expected NAME :address ADDRESS :type TYPE :access ACCESS [FIELDS]; migrate old readers to (read! NAME), writers to (write! NAME value), and getters to (.field (read! NAME))")
      0)
  (let [[address-key address type-key type access-key access-value fields] options
        _keys (if (not (and (= address-key `:address) (= type-key `:type) (= access-key `:access)))
                  (primitive/error "defmmio-reg: expected :address ADDRESS :type TYPE :access ACCESS")
                  0)
        register (mmio-name name "-Register")
        snapshot (mmio-name name "-Snapshot")
        bits (mmio-width type)
        access (mmio-access access-value)
        readable (match access (WriteOnly [] false) (_ true))
        writable (match access (ReadOnly [] false) (_ true))]
    (if (primitive/code-int? address)
        (if (or (< (primitive/code-int address) 0)
                (not (= (% (primitive/code-int address) (/ bits 8)) 0)))
            (primitive/error "defmmio-reg: address must be nonnegative and naturally aligned")
            0)
        0)
    `(do
       (defstruct ~register [(address (ptr ~type))])
       (defstruct ~snapshot [(bits ~type)])
       (def ~name (~register :address (primitive/cast (ptr ~type) ~address)))
       ~@(if readable
             `((impl Readable ~register
                 (read! [(reg ~register)] (-> ~snapshot)
                   (~snapshot
                     :bits (primitive/volatile-load ~type (.address reg))))))
             `())
       ~@(if writable
             `((impl Writable ~register
                 (write! [(reg ~register) (value ~type)] (-> i64)
                   (primitive/volatile-store! (.address reg) value))))
             `())
       ~@(mmio-fields snapshot type fields))))
