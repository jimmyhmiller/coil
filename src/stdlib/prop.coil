(module coil.prop)
(import "coil.primitive" :as primitive)
(import "coil.io" :as io)
(import "coil.alloc" :use [abort])

;; This module sees all of the property engine: `defprop`'s template refers to
;; its operations here, at its definition site, so an expansion never depends on
;; what the caller imported.
(import "coil.prop.source" :use *)
(import "coil.prop.arbitrary" :use *)
(import "coil.debug" :use *)
(import "coil.prop.runner" :use *)
(import "coil.prop.gen" :use *)
(import "coil.prop.derive" :use *)
(import "coil.prop.stateful" :use *)
(import "coil.prop.cov" :use *)

;; `(import "coil.prop" :use *)` hands a test file only what writing properties
;; needs: the macros below, `Arbitrary` and its helpers, the drawing operations a
;; hand-written generator uses, generator values, and `defprop-stateful`. The
;; engine's own machinery (tapes, spans, the runner, coverage) stays behind its
;; modules, so a test file's own `record!` or `Span` does not collide with it;
;; import `coil.prop.source` and friends directly to work on the engine.
(import "coil.prop.source"
        :use [Source src-alloc src-size src-depth src-max-depth src-fuel src-spend-fuel!
              src-restore-fuel! src-reject! src-target! src-showing? span-open! span-close!
              draw-int! draw-int-origin! draw-int-any! draw-len! draw-tag! draw-bool!
              draw-bool-p! draw-float!]
        :reexport)
(import "coil.prop.arbitrary" :use * :reexport)
(import "coil.prop.gen"
        :use [Gen GenAlt GenMark mk-gen gen-draw gen-env gen-mark gen-rewind! gen-int
              gen-int-toward gen-bool-p gen-bool gen-const gen-elem-of gen-map gen-list-map
              gen-filter gen-list-filter gen-alts gen-alt! gen-one-of gen-list-of
              defgen-const defgen-elem-of defgen-map defgen-filter defgen-one-of
              defgen-list-of]
        :reexport)
(import "coil.prop.stateful" :use [defprop-stateful] :reexport)

; PROPERTY-BASED TESTING — state a law, let the machine hunt for a counterexample,
; and get the SMALLEST input that breaks it.
;
;   (import "coil.prop" :use *)
;
;   (defprop reverse-involutive [(xs (ArrayList i64))]
;     (list-eq (reverse (reverse xs)) xs))
;
;   $ coil test list_test.coil
;
; The body is an expression that must yield `bool` — true means the property held
; for those inputs. Arguments are generated by each type's `Arbitrary` impl, so
; there is nothing to wire up; `coil test` discovers a `defprop` exactly like a
; `deftest`, because that is what it expands into.
;
; WHEN IT FAILS you get the shrunk counterexample, not the random one that
; happened to trip it:
;
;   FAILED after 37 cases (12 shrinks, 96 shrink calls)
;
;     counterexample:
;       xs = (0 1)
;
;     property reverse-involutive
;          at tests/list_test.coil:7
;
;     reproduce:  --seed=8134 --cases=200 coil test tests/list_test.coil
;
; Nobody writes a shrinker. Shrinking happens on the RECORDED CHOICES rather than
; on the value (coil.prop.source), so it composes through every generator and
; preserves every invariant a generator establishes — the failure mode that makes
; hand-written shrinkers produce counterexamples that were never valid inputs.
;
; Knobs, all optional, all environment variables:
;   --cases   cases per property (default 200)
;   --seed    the seed (default: derived from the property's name, so runs
;                    are reproducible and different properties differ)
;   --size    maximum size budget a case may reach (default 60)
;   --shrink  shrink call budget (default 20000)

;;; The parameter names of `[(a T) (b U)]`, as a Code list.
;;;
;;; The walkers below build with code-list-new/push! instead of
;;; `(~x ~@(self …)) — that shape re-splices the recursion's suffix at every
;;; level, which is quadratic in the parameter count (docs/design/META_MEMORY.md).
(defn prop--names [(ps Code) (i i64)] (-> Code)
  (let [out (primitive/code-list-new)
        (mut k) i]
    (loop (if (>= (load k) (primitive/code-count ps))
              (break)
              (do
                (primitive/code-list-push! out
                                           (primitive/code-nth (primitive/code-nth ps
                                                                                   (load k))
                                                               0))
                (store! k (primitive/iadd (load k) 1)))))
    (primitive/code-list-done out)))

;;; Allocate slot identifiers once; rebuilding equal spellings in each emitter
;;; would be implicit capture across independently evaluated templates.
(defn prop--slot-ids [(ps Code)] (-> Code)
  (let [out (primitive/code-list-new)
        (mut i) 0]
    (loop (if (>= (load i) (primitive/code-count ps))
              (break)
              (let [nm (primitive/code-nth (primitive/code-nth ps (load i)) 0)]
                (do
                  (primitive/code-list-push! out
                                             (primitive/fresh-identifier (primitive/code-symbol "slot$"
                                                                                                nm)))
                  (store! i (primitive/iadd (load i) 1))))))
    (primitive/code-list-done out)))

;; The parameter `defprop-stateful`'s body reads its Source through. The context
;; removal is explicit and therefore visible to the hygiene audit.
; hygiene: __src is the protocol name defprop-stateful's body reads.
(defn prop--source-id [] (-> Code)
  (primitive/syntax->datum (primitive/fresh-identifier "__src")))

;; The Source of the property running now, or null between properties. A property
;; function sets it for the length of its call, so `(prop-src)` finds the Source
;; from the body and from any function the body calls.
(defn prop--source-cell [] (-> (ptr (ptr Source)))
  (primitive/alloc-static (ptr Source)))

;;; Make `s` the running property's Source; returns the one it replaces.
(defn prop-enter-source! [(s (ptr Source))] (-> (ptr Source))
  (let [cell (prop--source-cell)
        previous (load cell)]
    (store! cell s)
    previous))

;;; The Source the running property draws from. Calling it when no property is
;;; running is a bug in the caller, and aborts with a message saying so.
(defn prop-current-source [] (-> (ptr Source))
  (let [s (load (prop--source-cell))]
    (when (= s (cast (ptr Source) 0))
      (io/print-str (io/stderr) "coil.prop: (prop-src) used while no property is running\n")
      (abort))
    s))

;; The reporting mode `defprop` threads into the generated property function.
;; `defprop-stateful` builds a body that reads it, and that body is a DIFFERENT
;; template in a different module, so the two halves connect only through this
;; published protocol name -- exactly like `__src` above.
; hygiene: __mode is a documented property-body protocol identifier.
(defn prop--mode-id [] (-> Code)
  (primitive/syntax->datum (primitive/fresh-identifier "__mode")))

;;; One mutable slot per argument, zero-initialized, filled by `arbitrary`.
;;;
;;; A `let`-bound mutable local rather than an explicit `alloc/stack`: it is one
;;; stack slot per ARGUMENT (not per generated value), it needs no import in the
;;; caller's file, and `(mut slot$x)` coerces to the `(ptr Self)` the trait method
;;; takes. `arbitrary` fills a caller-owned slot precisely so this is possible.
(defn prop--slots [(ps Code) (slots Code) (i i64)] (-> Code)
  (let [out (primitive/code-list-new)
        (mut k) i]
    (loop (if (>= (load k) (primitive/code-count ps))
              (break)
              (let [p (primitive/code-nth ps (load k))
                    nm (primitive/code-nth p 0)
                    ty (primitive/code-nth p 1)]
                (do
                  (primitive/code-list-push! out
                                             `(mut ~(primitive/code-nth slots
                                                                        (load k))))
                  (primitive/code-list-push! out `(zeroed ~ty))
                  (store! k (primitive/iadd (load k) 1))))))
    (primitive/code-list-done out)))

;;; `(arbitrary (mut slot$NAME) __src)` per argument, in declaration order — which
;;; is also the order their choices land on the tape.
(defn prop--draws [(ps Code) (slots Code) (source-id Code) (i i64)] (-> Code)
  (let [out (primitive/code-list-new)
        (mut k) i]
    (loop (if (>= (load k) (primitive/code-count ps))
              (break)
              (let [nm (primitive/code-nth (primitive/code-nth ps (load k)) 0)]
                (do
                  (primitive/code-list-push! out
                                             `(arbitrary (mut ~(primitive/code-nth slots
                                                                                   (load k)))
                                                         ~source-id))
                  (store! k (primitive/iadd (load k) 1))))))
    (primitive/code-list-done out)))

;;; The counterexample print, one `name = value` line per argument.
(defn prop--shows [(ps Code) (slots Code) (i i64)] (-> Code)
  (let [out (primitive/code-list-new)
        (mut k) i]
    (loop (if (>= (load k) (primitive/code-count ps))
              (break)
              (let [nm (primitive/code-nth (primitive/code-nth ps (load k)) 0)]
                (do
                  (primitive/code-list-push! out
                                             `(debug-arg ~(primitive/code-str nm)
                                                         (load ~(primitive/code-nth slots
                                                                                    (load k)))))
                  (store! k (primitive/iadd (load k) 1))))))
    (primitive/code-list-done out)))

;;; `let` bindings that expose each slot to the body under its plain name.
(defn prop--binds [(ps Code) (slots Code) (i i64)] (-> Code)
  (let [out (primitive/code-list-new)
        (mut k) i]
    (loop (if (>= (load k) (primitive/code-count ps))
              (break)
              (let [nm (primitive/code-nth (primitive/code-nth ps (load k)) 0)]
                (do
                  (primitive/code-list-push! out nm)
                  (primitive/code-list-push! out
                                             `(load ~(primitive/code-nth slots
                                                                         (load k))))
                  (store! k (primitive/iadd (load k) 1))))))
    (primitive/code-list-done out)))

;;; `(defprop NAME [(arg Type) …] body…)` — the whole surface.
;;;
;;; Expands to two functions: `prop$NAME`, which draws the arguments and evaluates
;;; the body (and, when asked, prints the arguments), and `coil-test$NAME`, which
;;; `coil test` discovers and which hands `prop$NAME` to the runner. The `$` names
;;; are unspellable by users, so neither can collide with anything in the file.
(defn defprop [(name Code) (params Code) & (body Code)] (-> Code)
  (let [slots (prop--slot-ids params)
        source-id (prop--source-id)
        mode-id (prop--mode-id)
        result (primitive/fresh-identifier "result")
        previous (primitive/fresh-identifier "previous")
        ; These two declarations are intentionally discovered/called by their
        ; stable caller-visible names, so strip context explicitly.
        ; hygiene: property and test declarations intentionally enter discovery's public namespace.
        prop-name (primitive/syntax->datum (primitive/code-symbol "prop$" name))
        test-name
          (primitive/syntax->datum (primitive/code-symbol "coil-test$" name))]
    `(do
       (defn ~prop-name [(~source-id (ptr Source)) (~mode-id i64)] (-> bool)
         ; `prop-note` values print in the same modes the arguments do
         (source-showing! ~source-id (or (= ~mode-id 1) (= ~mode-id 3)))
         (let [~previous (prop-enter-source! ~source-id)
               ~result
                 (let [~@(prop--slots params slots 0)]
                   ~@(prop--draws params slots source-id 0)
                   ; mode 1 (SHOW) and 3 (DRAW-SHOW) print the arguments; 2 and 3 stop
                   ; before the body, which is how a CRASHING counterexample can be
                   ; reported at all — running the body again would kill the reporter.
                   (if (or (= ~mode-id 1) (= ~mode-id 3))
                       (do ~@(prop--shows params slots 0) 0)
                       0)
                   (if (>= ~mode-id 2)
                       true
                       (let [~@(prop--binds params slots 0)]
                         ; the body lives in a named block so `assume` can leave it early
                         ; without every property having to thread a result through by hand.
                         (block :prop-body ~@body))))]
           (prop-enter-source! ~previous)
           ~result))
       (defn ~test-name [] (-> i64)
         (prop-run ~(primitive/code-str name)
                   ~(primitive/code-file name)
                   ~(primitive/code-line name)
                   (fnptr-of ~prop-name))))))

;;; `(assume COND)` — this case does not satisfy the property's precondition, so it
;;; is not a test of anything: discard it and move on.
;;;
;;; Use it sparingly. A precondition that rejects most of what is generated makes a
;;; suite that looks green while testing almost nothing, so the runner counts
;;; rejections and warns when they dominate. Generating valid inputs directly
;;; always beats filtering invalid ones.
(defn assume [(c Code)] (-> Code)
  `(if ~c
       true
       (do
         (src-reject! (prop-current-source))
         (return-from :prop-body true))))

;;; `(prop-target! EXPR)` — report a number the search should MAXIMIZE (targeted
;;; property-based testing, Löscher & Sagonas). Steers generation toward the
;;; interesting end of the input space instead of sampling it uniformly.
(defn prop-target! [(e Code)] (-> Code)
  `(src-target! (prop-current-source) ~e))

;;; `(prop-note "label" EXPR)` — EXPR's value, printed as `label = …` under the
;;; arguments when this case is a counterexample being reported. Values a property
;;; draws for itself inside its body are otherwise invisible in a report: the
;;; arguments are printed, and a hand-built input is not one. Evaluates to EXPR, so
;;; it wraps a draw in place:
;;;
;;;   (let [text (prop-note "text" (arb-bytes (prop-src) 0 64))] …)
;;;
;;; For a crash the body cannot run while the report is printed, so a noted value
;;; appears in the final re-run of the minimized input instead, just before the
;;; crash it leads to.
(defn prop-note [(label Code) (e Code)] (-> Code)
  `(prop-note-value! (prop-current-source) ~label ~e))

(defn prop-note-value! [(T Debug)] [(s (ptr Source)) (label (slice u8)) (v T)] (-> T)
  (if (src-showing? s) (debug-arg label v) 0)
  v)

;;; `(prop-draw T "label")` — draw a value of any `Arbitrary` type inside the body,
;;; noted under `label`: `(prop-note label (arb [T] (prop-src)))`.
(defn prop-draw [(T Code) (label Code)] (-> Code)
  `(prop-note-value! (prop-current-source) ~label (arb [~T] (prop-current-source))))

;;; `(prop-src)` — the Source this case is drawing from, for hand-written
;;; generation in a property body or in any function it calls while it runs.
(defn prop-src [] (-> Code)
  `(prop-current-source))

;;; `(classify "label" COND)` — record how often a condition holds, and yield it.
;;;
;;; Use it on anything you are ASSUMING about the generated data: "list is empty",
;;; "both arguments negative", "the key was already present". The run prints the
;;; distribution under `--verbose=1`, and warns on its own when one label
;;; covers almost every case — the state in which a suite looks green because it
;;; tested one shape ten thousand times.
(defn classify [(label Code) (c Code)] (-> Code)
  `(prop-classify! ~label ~c))

;;; `(collect "label" EXPR)` — record a number's min/mean/max across the run, and
;;; yield it. The cheapest way to find out that your "lists up to 60 elements"
;;; generator has been producing lists of 0 and 1 all along.
(defn collect [(label Code) (e Code)] (-> Code)
  `(prop-collect! ~label ~e))
