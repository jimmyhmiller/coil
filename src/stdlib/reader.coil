; THE s-expression reader — one implementation, used by the Coil compiler itself
; and available to any program. `read-all` turns `(slice u8)` source into a tree of
; `Sexp`; that is the same call, and the same tree, the compiler's own front end
; reads your file with.
;
;   (import "coil.reader" :use *)
;   (match (read-all a "(define x 10) (+ x 1)" 0)   ; -> (ptr (ArrayList Sexp))
;     (Ok [forms] …)
;     (Err [d] …))                                  ; Diag carries the span
;
; It handles what a Lisp reader is expected to handle, because the compiler needs
; all of it: `;`-to-end-of-line comments, `[` `]` as real delimiters distinct from
; `(` `)`, string literals with escapes (`\n \t \r \0 \xHH \" \\`, unknown escapes
; rejected), c-strings, character literals, keywords, integers and floats, and the
; `'`/`` ` ``/`~`/`~@` prefixes. Every node carries a source span (`lo`/`hi`/`source`)
; and a unique `nid`, so a consumer can report errors that point at real source.
;
; This module replaced `coil.sexp`, which re-derived a weaker set of rules — no
; strings, no brackets, no comments — and got all three wrong. (`coil.serde.sexp`
; also tokenizes s-expressions but is NOT a Coil reader: it is a wire format with
; its own escape set and `#"…"` byte literals. See its header.)
(module coil.reader)
(import "coil.primitive" :as primitive)

(import "coil.alloc" :as alloc :use *)
(import "coil.result" :use *)
(import "coil.slice" :use *)
(import "coil.str" :use *)
(import "coil.mem" :use *)
(import "coil.arraylist" :use *)
(import "coil.io" :use *)
(import "coil.control" :use *)
(import "coil.try" :use *)
; No compiler-module imports: the reader is STANDALONE. It used to import `ast`
; for constructors of its OWN types (which made the two modules import each other)
; and `ffi` for the one extern below. `ast` imports the reader, not the reverse.

; Float literals. Declared here rather than imported so the reader depends on no
; compiler module; coil.serde and coil.serde.json declare the same signature the
; same way (an identical redeclaration is fine — only a CONFLICTING one is an error).
(extern strtod :cc c [(ptr i8) (ptr (ptr i8))] (-> f64))

(defsum SexpKind
  (KInt [(v i64)])
  (KFloat [(bits i64)])
  (KSym [(s (slice u8))])
  (KKw [(s (slice u8))])
  (KStr [(s (slice u8))])
  (KCStr [(s (slice u8))])
  (KList [(items (ptr (ArrayList Sexp)))])
  (KVec [(items (ptr (ArrayList Sexp)))]))

; `nid` = a stable, unique NODE ID assigned at construction (see next-nid / mk-sexp).
; It is NEVER emitted by the canonical dumper, so the oracle stays byte-exact; it lets
; a metaprogram key on node IDENTITY (exact `type-of`) rather than the source span,
; which macro-duplicated subtrees can share.
(defstruct Sexp [(kind SexpKind) (lo i64) (hi i64) (source i64) (ctxt i64) (nid i64)])

(defsum TokKind
  (TOpen [(c i64)])
  (TClose [(c i64)])
  (TPrefix [(s (slice u8))])
  (TStr [(s (slice u8))])
  (TCStr [(s (slice u8))])
  (TChar [(v i64)])
  (TAtom [(s (slice u8))]))

(defstruct Tok [(kind TokKind) (lo i64) (hi i64)])
(defstruct Parser [(toks (ptr (ArrayList Tok))) (pos i64)])
(defstruct StrRead [(s (slice u8)) (end i64)])

; A parse/read diagnostic; dummy span = -1.
(defstruct Diag [(lo i64) (hi i64) (msg (slice u8)) (source i64) (ctxt i64)])

; ============================ small constructors =============================
; Monotonic node-id counter. Every Sexp gets a unique nid at construction (starting at
; 1; 0 means "no id"). Deterministic — the same source produces the same nids in the
; same order, so the rebootstrap fixpoint holds.
(defstruct NidCell [(n i64)])
(defn nid-cell [] (-> (ptr NidCell))
  (alloc/static NidCell))
(defn next-nid [] (-> i64)
  (let [c (nid-cell)
        v (primitive/iadd (load (field c n)) 1)]
    (store! (field c n) v)
    v))

(defn mk-sexp [(kind SexpKind) (lo i64) (hi i64)] (-> Sexp)
  (let [p (alloc/stack Sexp)]
    (store! (field p kind) kind)
    (store! (field p lo) lo)
    (store! (field p hi) hi)
    (store! (field p source) (if (< lo (primitive/cast i64 0)) (do -1) 0))
    (store! (field p ctxt) 0)
    (store! (field p nid) (next-nid))
    (load p)))
(defn mk-sexp-src [(kind SexpKind) (orig (ptr Sexp))] (-> Sexp)
  (let [p (alloc/stack Sexp)]
    (store! (field p kind) kind)
    (store! (field p lo) (load (field orig lo)))
    (store! (field p hi) (load (field orig hi)))
    (store! (field p source) (load (field orig source)))
    (store! (field p ctxt) (load (field orig ctxt)))
    (store! (field p nid) (next-nid))
    (load p)))
(defn mk-tok [(kind TokKind) (lo i64) (hi i64)] (-> Tok)
  (let [p (alloc/stack Tok)]
    (store! (field p kind) kind)
    (store! (field p lo) lo)
    (store! (field p hi) hi)
    (load p)))
; source = -1 means "not yet attributed to a file"; the span is file-relative, so
; it is meaningless until a caller stamps the source that `lo`/`hi` are offsets
; into (dwspan / diag-with-source). Defaulting to 0 instead would silently claim
; every diagnostic came from the entry file, rendering the right offsets against
; the wrong source text.
(defn mk-diag [(lo i64) (hi i64) (msg (slice u8))] (-> Diag)
  (let [p (alloc/stack Diag)]
    (store! (field p lo) lo)
    (store! (field p hi) hi)
    (store! (field p msg) msg)
    (store! (field p source) -1)
    (store! (field p ctxt) 0)
    (load p)))
(defn mk-diag-src [(source i64) (lo i64) (hi i64) (msg (slice u8))] (-> Diag)
  (let [p (alloc/stack Diag)]
    (store! p (mk-diag lo hi msg))
    (store! (field p source) source)
    (load p)))
(defn mk-strread [(s (slice u8)) (end i64)] (-> StrRead)
  (let [p (alloc/stack StrRead)]
    (store! (field p s) s)
    (store! (field p end) end)
    (load p)))

(defn box-items [(a (ptr Allocator)) (items (ArrayList Sexp))] (-> (ptr (ArrayList Sexp)))
  (let [p (unwrap-ptr [(ArrayList Sexp)] (create [(ArrayList Sexp)] a))]
    (store! p items)
    p))
(defn box-sexp [(a (ptr Allocator)) (s Sexp)] (-> (ptr Sexp))
  (let [p (unwrap-ptr [Sexp] (create [Sexp] a))] (store! p s) p))

(defn looks-numeric [(s (slice u8))] (-> bool)
  (let [n (slice-len s)]
    (if (= n (primitive/cast i64 0))
        false
        (let [c0 (primitive/cast i64 (slice-get s 0))]
          (if (and (>= c0 (primitive/cast i64 48)) (<= c0 (primitive/cast i64 57)))
              true
              (if (and (or (= c0 (primitive/cast i64 45))
                           (or (= c0 (primitive/cast i64 43)) (= c0 (primitive/cast i64 46))))
                       (>= n
                           (primitive/cast i64
                                           2)))
                  (let [c1 (primitive/cast i64 (slice-get s 1))]
                    (and (>= c1 (primitive/cast i64 48)) (<= c1 (primitive/cast i64 57))))
                  false))))))

(defn parse-int [(s (slice u8))] (-> (Option i64))
  (let [n (slice-len s)]
    (let [dec
            (if (= n (primitive/cast i64 0))
                (None [i64])
                (let [(mut i) 0
                      (mut neg) false]
                  (let [c0 (primitive/cast i64 (slice-get s 0))]
                    (if (= c0 (primitive/cast i64 45))
                        (do (store! neg true) (store! i 1))
                        (when (= c0 (primitive/cast i64 43)) (store! i 1))))
                  (if (>= (load i) n)
                      (None [i64])
                      (let [(mut mag) 0
                            (mut ok) true
                            (mut overflow) false
                            maxrem (if (load neg) 8 7)]
                        (loop (if (>= (load i) n)
                                  (break)
                                  (let [c (primitive/cast i64 (slice-get s (load i)))]
                                    (if (and (>= c (primitive/cast i64 48)) (<= c (primitive/cast i64 57)))
                                        (let [d (primitive/isub c 48)]
                                          (if (or (> (load mag) (primitive/cast i64 922337203685477580))
                                                  (and (= (load mag) (primitive/cast i64 922337203685477580))
                                                       (> d
                                                          maxrem)))
                                              (do (store! overflow true) (break))
                                              (do
                                                (store! mag (primitive/iadd (primitive/imul (load mag) 10) d))
                                                (store! i (primitive/iadd (load i) 1)))))
                                        (do (store! ok false) (break))))))
                        (if (or (not (load ok)) (load overflow))
                            (None [i64])
                            (Some (if (load neg) (primitive/isub 0 (load mag)) (load mag))))))))]
      (match dec
        (Some [v] (Some v))
        (None []
              (if (= n (primitive/cast i64 0))
                  (None [i64])
                  (let [(mut neg2) false
                        (mut bstart) 0]
                    (let [c0 (primitive/cast i64 (slice-get s 0))]
                      (if (= c0 (primitive/cast i64 45))
                          (do (store! neg2 true) (store! bstart 1))
                          (when (= c0 (primitive/cast i64 43)) (store! bstart 1))))
                    (let [blen (primitive/isub n (load bstart))
                          (mut radix) 0
                          (mut dstart) (load bstart)]
                      (when (and (>= blen (primitive/cast i64 2))
                                 (= (primitive/cast i64 (slice-get s (load bstart)))
                                    (primitive/cast i64 48)))
                        (let [c1 (primitive/cast i64 (slice-get s (primitive/iadd (load bstart) 1)))]
                          (cond (or (= c1 (primitive/cast i64 120)) (= c1 (primitive/cast i64 88)))
                                  (do (store! radix 16) (store! dstart (primitive/iadd (load bstart) 2)))
                                (or (= c1 (primitive/cast i64 98)) (= c1 (primitive/cast i64 66)))
                                  (do (store! radix 2) (store! dstart (primitive/iadd (load bstart) 2)))
                                (or (= c1 (primitive/cast i64 111)) (= c1 (primitive/cast i64 79)))
                                  (do (store! radix 8) (store! dstart (primitive/iadd (load bstart) 2)))
                                :else 0)))
                      (when (= (load radix) (primitive/cast i64 0))
                        (let [body (subslice s (load bstart) n)
                              has-us
                                (do
                                  (let [(mut f) false
                                        (mut j) (load bstart)]
                                    (loop (if (>= (load j) n)
                                              (break)
                                              (do
                                                (when (= (primitive/cast i64 (slice-get s (load j)))
                                                         (primitive/cast i64 95))
                                                  (store! f true)
                                                  0)
                                                (store! j (primitive/iadd (load j) 1)))))
                                    (load f)))]
                          (when (and has-us (looks-numeric body)) (store! radix 10) (store! dstart (load bstart)))))
                      (if (= (load radix) (primitive/cast i64 0))
                          (None [i64])
                          (let [(mut mag) 0
                                (mut count) 0
                                (mut bad) false
                                (mut ovf) false
                                (mut j) (load dstart)
                                rr (load radix)]
                            (loop (if (>= (load j) n)
                                      (break)
                                      (let [c (primitive/cast i64 (slice-get s (load j)))]
                                        (store! j (primitive/iadd (load j) 1))
                                        (unless (= c (primitive/cast i64 95))
                                          (let [dv
                                                  (let [v0
                                                          (cond (and (>= c (primitive/cast i64 48))
                                                                     (<= c (primitive/cast i64 57)))
                                                                  (primitive/isub c 48)
                                                                (and (>= c (primitive/cast i64 97))
                                                                     (<= c
                                                                         (primitive/cast i64 122)))
                                                                  (primitive/iadd (primitive/isub c 97) 10)
                                                                (and (>= c (primitive/cast i64 65))
                                                                     (<= c (primitive/cast i64 90)))
                                                                  (primitive/iadd (primitive/isub c 65) 10)
                                                                :else -1)]
                                                    (if (or (< v0 (primitive/cast i64 0)) (>= v0 rr)) -1 v0))]
                                            (if (< dv (primitive/cast i64 0))
                                                (do (store! bad true) (break))
                                                (let [maxdiv (primitive/udiv -1 rr)
                                                      maxrem (primitive/urem -1 rr)]
                                                  (if (or (> (primitive/cast u64 (load mag))
                                                             (primitive/cast u64 maxdiv))
                                                          (and (= (load mag) maxdiv)
                                                               (> (primitive/cast u64 dv)
                                                                  (primitive/cast u64 maxrem))))
                                                      (do (store! ovf true) (break))
                                                      (do
                                                        (store! mag
                                                                (primitive/iadd (primitive/imul (load mag) rr) dv))
                                                        (store! count (primitive/iadd (load count) 1)))))))))))
                            (if (or (load bad) (or (load ovf) (= (load count) (primitive/cast i64 0))))
                                (None [i64])
                                (Some (if (load neg2) (primitive/isub 0 (load mag)) (load mag))))))))))))))

; Takes the caller's allocator rather than grabbing `malloc-allocator` itself: the
; `str->cstr` below is a per-token scratch C string for `strtod`, so it belongs to
; whatever allocator the compile is running on. Grabbing the global one here put it on
; malloc no matter what the pipeline was threading.
(defn atom [(a (ptr Allocator)) (s (slice u8))] (-> SexpKind)
  (let [n (slice-len s)]
    (if (and (> n (primitive/cast i64 0)) (= (primitive/cast i64 (slice-get s 0)) (primitive/cast i64 58)))
        (KKw (subslice s 1 n))
        (match (parse-int s)
          (Some [v] (KInt v))
          (None []
                (if (and (looks-numeric s)
                         (do
                           (let [(mut f) false
                                 (mut j) 0]
                             (loop (if (>= (load j) n)
                                       (break)
                                       (do
                                         (let [c (primitive/cast i64 (slice-get s (load j)))]
                                           (when (or (= c (primitive/cast i64 46))
                                                     (or (= c (primitive/cast i64 101))
                                                         (= c
                                                            (primitive/cast i64
                                                                            69))))
                                             (store! f true)
                                             0))
                                         (store! j (primitive/iadd (load j) 1)))))
                             (load f))))
                    (let [buf (str->cstr a s)
                          ep (alloc/stack (ptr i8))
                          x (strtod buf ep)
                          consumed (primitive/isub (primitive/cast i64 (load ep)) (primitive/cast i64 buf))]
                      (if (and (> n (primitive/cast i64 0)) (= consumed n)) (KFloat (f64-bits x)) (KSym s)))
                    (KSym s)))))))

; ---- string escapes ----------------------------------------------------
; The recognized set is `\n \t \r \0 \" \\` plus `\xHH`. An UNRECOGNIZED escape
; is an error, not the escaped character: dropping the backslash silently turned
; every `"\r\n"` in this tree into the letters `rn`, which is exactly the kind of
; mistake a wire protocol never announces — it just fails somewhere else.
(defn str-escape-code [(e i64)] (-> i64)
  (cond (= e (primitive/cast i64 110)) 10  ; \n
        (= e (primitive/cast i64 116)) 9  ; \t
        (= e (primitive/cast i64 114)) 13  ; \r
        (= e (primitive/cast i64 48)) 0  ; \0
        (= e (primitive/cast i64 34)) 34  ; \"
        (= e (primitive/cast i64 92)) 92  ; \\
        :else -1))

(defn read-string-body [(a (ptr Allocator)) (src (slice u8)) (open-off i64) (i i64)] (-> (Result StrRead Diag))
  (let [n (slice-len src)
        (mut buf) (al-new [u8] a)
        (mut k) i
        (mut out) (primitive/zeroed (Result StrRead Diag))]
    (loop (if (>= (load k) n)
              (do (store! out (Err (mk-diag open-off n "unterminated string literal"))) (break))
              (let [c (primitive/cast i64 (slice-get src (load k)))]
                (store! k (primitive/iadd (load k) 1))
                (if (= c (primitive/cast i64 34))
                    (do (store! out (Ok (mk-strread (al-slice [u8] (load buf)) (load k)))) (break))
                    (if (= c (primitive/cast i64 92))
                        (if (>= (load k) n)
                            (do (store! out (Err (mk-diag open-off n "unterminated string escape"))) (break))
                            (let [esc-off (primitive/isub (load k) 1)
                                  e (primitive/cast i64 (slice-get src (load k)))]
                              (store! k (primitive/iadd (load k) 1))
                              (if (= e (primitive/cast i64 120))
                                  ; \xHH — two hex digits, one byte
                                  (if (> (primitive/iadd (load k) 1) (primitive/isub n 1))
                                      (do
                                        (store! out (Err (mk-diag esc-off n "\\x escape needs two hex digits")))
                                        (break))
                                      (let [hi (sh-hex-digit (primitive/cast i64 (slice-get src (load k))))
                                            lo
                                              (sh-hex-digit (primitive/cast i64
                                                                            (slice-get src (primitive/iadd (load k) 1))))]
                                        (if (or (< hi 0) (< lo 0))
                                            (do
                                              (store! out
                                                      (Err (mk-diag esc-off
                                                                    (primitive/iadd (load k) 2)
                                                                    "\\x escape needs two hex digits")))
                                              (break))
                                            (do
                                              (store! k (primitive/iadd (load k) 2))
                                              (al-push! (mut buf)
                                                        (primitive/cast u8 (primitive/iadd (primitive/imul hi 16) lo)))
                                              0))))
                                  (let [code (str-escape-code e)]
                                    (if (< code 0)
                                        (do
                                          (store! out
                                                  (Err (mk-diag esc-off
                                                                (load k)
                                                                "unknown string escape (known: \\n \\t \\r \\0 \\\" \\\\ \\xHH)")))
                                          (break))
                                        (do (al-push! (mut buf) (primitive/cast u8 code)) 0))))))
                        (al-push! (mut buf) (primitive/cast u8 c)))))))
    (load out)))

; ---- character literals: \a \) \newline \space \tab A -------------------
; A `\` starts a char literal. A single char after it (\a, \), \") is that byte;
; an alphabetic run is a name (\newline \space \tab \return \nul \backspace
; \formfeed) or \uHEX. Lexes to a plain integer literal (KInt), so it is just
; sugar: `(= (primitive/cast i64 byte) \a)` needs no new type machinery.
(defn sh-is-alpha [(c i64)] (-> bool)
  (or (and (>= c (primitive/cast i64 97)) (<= c (primitive/cast i64 122)))
      (and (>= c (primitive/cast i64 65)) (<= c (primitive/cast i64 90)))))
(defn sh-is-alnum [(c i64)] (-> bool)
  (or (sh-is-alpha c) (and (>= c (primitive/cast i64 48)) (<= c (primitive/cast i64 57)))))
(defn sh-hex-digit [(c i64)] (-> i64)
  (cond (and (>= c (primitive/cast i64 48)) (<= c (primitive/cast i64 57))) (primitive/isub c 48)
        (and (>= c (primitive/cast i64 97)) (<= c (primitive/cast i64 102))) (primitive/iadd (primitive/isub c 97) 10)
        (and (>= c (primitive/cast i64 65)) (<= c (primitive/cast i64 70))) (primitive/iadd (primitive/isub c 65) 10)
        :else -1))
(defn char-name-code [(s (slice u8))] (-> i64)
  (cond (= s "space") 32
        (= s "newline") 10
        (= s "tab") 9
        (= s "return") 13
        (= s "nul") 0
        (= s "null") 0
        (= s "backspace") 8
        (= s "formfeed") 12
        :else  ; \uHEX
          (let [n (slice-len s)]
            (if (and (>= n (primitive/cast i64 2)) (= (primitive/cast i64 (slice-get s 0)) (primitive/cast i64 117)))
                (let [(mut v) 0
                      (mut j) 1
                      (mut ok) true]
                  (loop (if (>= (load j) n)
                            (break)
                            (let [d (sh-hex-digit (primitive/cast i64 (slice-get s (load j))))]
                              (if (< d (primitive/cast i64 0))
                                  (do (store! ok false) (break))
                                  (do
                                    (store! v (primitive/iadd (primitive/imul (load v) 16) d))
                                    (store! j (primitive/iadd (load j) 1)))))))
                  (if (load ok) (load v) -1))
                -1))))

(defn tokenize [(a (ptr Allocator)) (src (slice u8))] (-> (Result (ptr (ArrayList Tok)) Diag))
  (let [n (slice-len src)
        (mut toks) (al-new [Tok] a)
        (mut i) 0
        (mut out) (primitive/zeroed (Result (ptr (ArrayList Tok)) Diag))
        (mut done) false]
    (loop (if (>= (load i) n)
              (break)
              (let [c (primitive/cast i64 (slice-get src (load i)))]
                (cond (or (= c (primitive/cast i64 32))
                          (or (= c (primitive/cast i64 9))
                              (or (= c (primitive/cast i64 10))
                                  (or (= c (primitive/cast i64 13))
                                      (or (= c
                                             (primitive/cast i64
                                                             11))
                                          (= c
                                             (primitive/cast i64
                                                             12)))))))
                        (store! i (primitive/iadd (load i) 1))
                      (= c (primitive/cast i64 59))
                        (loop (if (>= (load i) n)
                                  (break)
                                  (let [ch (primitive/cast i64 (slice-get src (load i)))]
                                    (store! i (primitive/iadd (load i) 1))
                                    (when (= ch (primitive/cast i64 10)) (break)))))
                      (or (= c (primitive/cast i64 40)) (= c (primitive/cast i64 91)))
                        (do
                          (al-push! (mut toks) (mk-tok (TOpen c) (load i) (primitive/iadd (load i) 1)))
                          (store! i (primitive/iadd (load i) 1)))
                      (or (= c (primitive/cast i64 41)) (= c (primitive/cast i64 93)))
                        (do
                          (al-push! (mut toks) (mk-tok (TClose c) (load i) (primitive/iadd (load i) 1)))
                          (store! i (primitive/iadd (load i) 1)))
                      (= c (primitive/cast i64 39))
                        (do
                          (al-push! (mut toks) (mk-tok (TPrefix "quote") (load i) (primitive/iadd (load i) 1)))
                          (store! i (primitive/iadd (load i) 1)))
                      (= c (primitive/cast i64 96))
                        (do
                          (al-push! (mut toks)
                                    (mk-tok (TPrefix "quasiquote") (load i) (primitive/iadd (load i) 1)))
                          (store! i (primitive/iadd (load i) 1)))
                      (= c (primitive/cast i64 126))
                        (let [istart (load i)]
                          (store! i (primitive/iadd (load i) 1))
                          (if (and (< (load i) n)
                                   (= (primitive/cast i64 (slice-get src (load i))) (primitive/cast i64 64)))
                              (do
                                (al-push! (mut toks)
                                          (mk-tok (TPrefix "unquote-splicing")
                                                  istart
                                                  (primitive/iadd (load i) 1)))
                                (store! i (primitive/iadd (load i) 1)))
                              (al-push! (mut toks)
                                        (mk-tok (TPrefix "unquote") istart (primitive/iadd istart 1)))))
                      (= c (primitive/cast i64 92))
                        (let [cstart (load i)]
                          (store! i (primitive/iadd (load i) 1))
                          (if (>= (load i) n)
                              (do
                                (store! out (Err (mk-diag cstart n "unterminated character literal")))
                                (store! done true)
                                (break))
                              (let [first (primitive/cast i64 (slice-get src (load i)))]
                                (store! i (primitive/iadd (load i) 1))
                                (let [(mut nend) (load i)]
                                  (when (sh-is-alpha first)
                                    (loop (if (>= (load i) n)
                                              (break)
                                              (let [cc (primitive/cast i64 (slice-get src (load i)))]
                                                (if (sh-is-alnum cc)
                                                    (do
                                                      (store! i (primitive/iadd (load i) 1))
                                                      (store! nend (load i)))
                                                    (break))))))
                                  (let [nlen (primitive/isub (load nend) (primitive/iadd cstart 1))
                                        v
                                          (if (= nlen (primitive/cast i64 1))
                                              first
                                              (char-name-code (subslice src
                                                                        (primitive/iadd cstart 1)
                                                                        (load nend))))]
                                    (if (< v (primitive/cast i64 0))
                                        (do
                                          (store! out
                                                  (Err (mk-diag cstart
                                                                (load nend)
                                                                "unknown character literal")))
                                          (store! done true)
                                          (break))
                                        (al-push! (mut toks)
                                                  (mk-tok (TChar v) cstart (load nend)))))))))
                      (= c (primitive/cast i64 34))
                        (let [istart (load i)]
                          (store! i (primitive/iadd (load i) 1))
                          (match (read-string-body a src istart (load i))
                            (Err [d] (do (store! out (Err d)) (store! done true) (break)))
                            (Ok [sr]
                                (let [srp (alloc/stack StrRead)]
                                  (store! srp sr)
                                  (al-push! (mut toks)
                                            (mk-tok (TStr (load (field srp s)))
                                                    istart
                                                    (load (field srp end))))
                                  (store! i (load (field srp end)))))))
                      :else
                        (let [start (load i)
                              (mut end) (load i)]
                          (loop (if (>= (load i) n)
                                    (break)
                                    (let [cc (primitive/cast i64 (slice-get src (load i)))]
                                      (if (or (or (= cc (primitive/cast i64 32))
                                                  (or (= cc (primitive/cast i64 9))
                                                      (or (= cc (primitive/cast i64 10))
                                                          (or (= cc (primitive/cast i64 13))
                                                              (or (= cc (primitive/cast i64 11))
                                                                  (= cc (primitive/cast i64 12)))))))
                                              (or (= cc (primitive/cast i64 40))
                                                  (or (= cc (primitive/cast i64 41))
                                                      (or (= cc (primitive/cast i64 91))
                                                          (or (= cc (primitive/cast i64 93))
                                                              (or (= cc (primitive/cast i64 59))
                                                                  (or (= cc (primitive/cast i64 39))
                                                                      (or (= cc (primitive/cast i64 96))
                                                                          (or (= cc (primitive/cast i64 126))
                                                                              (= cc (primitive/cast i64 34)))))))))))
                                          (break)
                                          (do
                                            (store! i (primitive/iadd (load i) 1))
                                            (store! end (load i)))))))
                          (let [stok (subslice src start (load end))]
                            (if (and (and (= (primitive/isub (load end) start) (primitive/cast i64 1))
                                          (= (primitive/cast i64 (slice-get src start)) (primitive/cast i64 99)))
                                     (and (< (load i) n)
                                          (= (primitive/cast i64 (slice-get src (load i))) (primitive/cast i64 34))))
                                (do
                                  (store! i (primitive/iadd (load i) 1))
                                  (match (read-string-body a src start (load i))
                                    (Err [d]
                                         (do
                                           (store! out (Err d))
                                           (store! done true)
                                           (break)))
                                    (Ok [sr]
                                        (let [srp (alloc/stack StrRead)]
                                          (store! srp sr)
                                          (al-push! (mut toks)
                                                    (mk-tok (TCStr (load (field srp s)))
                                                            start
                                                            (load (field srp end))))
                                          (store! i (load (field srp end)))))))
                                (al-push! (mut toks) (mk-tok (TAtom stok) start (load end))))))))))
    (if (load done)
        (load out)
        (Ok (let [bp (unwrap-ptr [(ArrayList Tok)] (create [(ArrayList Tok)] a))] (store! bp (load toks)) bp)))))

(defn parse-one [(p (ptr Parser)) (a (ptr Allocator))] (-> (Result Sexp Diag))
  (let [toks (load (field p toks))
        ntok (al-len [Tok] (load toks))
        pos (load (field p pos))]
    (if (>= pos ntok)
        (Err (mk-diag -1 -1 "unexpected end of input"))
        (let [tok (alloc/stack Tok)]
          (store! tok (al-get [Tok] (load toks) pos))
          (store! (field p pos) (primitive/iadd pos 1))
          (let [tlo (load (field tok lo))
                thi (load (field tok hi))]
            (match (load (field tok kind))
              (TStr [s] (Ok (mk-sexp (KStr s) tlo thi)))
              (TCStr [s] (Ok (mk-sexp (KCStr s) tlo thi)))
              (TChar [v] (Ok (mk-sexp (KInt v) tlo thi)))
              (TAtom [s] (Ok (mk-sexp (atom a s) tlo thi)))
              (TClose [c]
                      (let [cs
                              (slice-new [u8]
                                         (let [cb (primitive/cast (ptr u8) (unwrap-ptr [i8] (raw-alloc a 1 1)))]
                                           (store! (primitive/index cb 0) (primitive/cast u8 c))
                                           cb)
                                         1)
                            m1 (match (str-concat a "unexpected '" cs) (Some [v] v) (None [] ""))
                            m2 (match (str-concat a m1 "'") (Some [v] v) (None [] ""))]
                        (Err (mk-diag tlo thi m2))))
              (TPrefix [sym]
                       (match (parse-one p a)
                         (Err [d] (Err d))
                         (Ok [inner]
                             (let [ip (alloc/stack Sexp)]
                               (store! ip inner)
                               (let [ihi (load (field ip hi))
                                     (mut kids) (al-new [Sexp] a)]
                                 (al-push! (mut kids) (mk-sexp (KSym sym) tlo thi))
                                 (al-push! (mut kids) (load ip))
                                 (Ok (mk-sexp (KList (box-items a (load kids))) tlo ihi)))))))
              (TOpen [open]
                     (let [close (if (= open (primitive/cast i64 40)) 41 93)
                           (mut items) (al-new [Sexp] a)
                           (mut out) (primitive/zeroed (Result Sexp Diag))]
                       (loop (let [cpos (load (field p pos))]
                               (if (>= cpos ntok)
                                   (do
                                     (let [cs
                                             (slice-new [u8]
                                                        (let [cb
                                                                (primitive/cast (ptr u8)
                                                                                (unwrap-ptr [i8] (raw-alloc a 1 1)))]
                                                          (store! (primitive/index cb 0) (primitive/cast u8 open))
                                                          cb)
                                                        1)
                                           m1 (match (str-concat a "unclosed '" cs) (Some [v] v) (None [] ""))
                                           m2 (match (str-concat a m1 "'") (Some [v] v) (None [] ""))]
                                       (store! out (Err (mk-diag tlo thi m2))))
                                     (break))
                                   (let [nt (alloc/stack Tok)]
                                     (store! nt (al-get [Tok] (load toks) cpos))
                                     (let [cdelim
                                             (match (load (field nt kind))
                                               (TClose [cc] cc)
                                               (TOpen [_] -1)
                                               (TPrefix [_] -1)
                                               (TStr [_] -1)
                                               (TCStr [_] -1)
                                               (TChar [_] -1)
                                               (TAtom [_] -1))]
                                       (if (>= cdelim (primitive/cast i64 0))
                                           (if (!= cdelim close)
                                               (do
                                                 (let [os
                                                         (slice-new [u8]
                                                                    (let [cb
                                                                            (primitive/cast (ptr u8)
                                                                                            (unwrap-ptr [i8]
                                                                                                        (raw-alloc a
                                                                                                                   1
                                                                                                                   1)))]
                                                                      (store! (primitive/index cb 0)
                                                                              (primitive/cast u8 open))
                                                                      cb)
                                                                    1)
                                                       ds
                                                         (slice-new [u8]
                                                                    (let [cb
                                                                            (primitive/cast (ptr u8)
                                                                                            (unwrap-ptr [i8]
                                                                                                        (raw-alloc a
                                                                                                                   1
                                                                                                                   1)))]
                                                                      (store! (primitive/index cb 0)
                                                                              (primitive/cast u8 cdelim))
                                                                      cb)
                                                                    1)
                                                       m1
                                                         (match (str-concat a "mismatched delimiters: '" os)
                                                           (Some [v] v)
                                                           (None [] ""))
                                                       m2 (match (str-concat a m1 "' .. '") (Some [v] v) (None [] ""))
                                                       m3 (match (str-concat a m2 ds) (Some [v] v) (None [] ""))
                                                       m4 (match (str-concat a m3 "'") (Some [v] v) (None [] ""))]
                                                   (store! out
                                                           (Err (mk-diag (load (field nt lo))
                                                                         (load (field nt
                                                                                      hi))
                                                                         m4))))
                                                 (break))
                                               (do
                                                 (store! (field p pos) (primitive/iadd cpos 1))
                                                 (store! out
                                                         (Ok (mk-sexp (if (= open (primitive/cast i64 40))
                                                                          (KList (box-items a (load items)))
                                                                          (KVec (box-items a (load items))))
                                                                      tlo
                                                                      (load (field nt hi)))))
                                                 (break)))
                                           (match (parse-one p a)
                                             (Ok [child] (do (al-push! (mut items) child) 0))
                                             (Err [d] (do (store! out (Err d)) (break))))))))))
                       (load out)))))))))

; Recursively stamp `source` on a node + descendants (int place); ctxt untouched.
(defn stamp-source-list [(items (ptr (ArrayList Sexp))) (source i64)] (-> i64)
  (let [n (al-len [Sexp] (load items))
        (mut i) 0
        data (load (field items data))]
    (loop (if (>= (load i) n)
              (break)
              (do (stamp-source-node (primitive/index data (load i)) source) (store! i (primitive/iadd (load i) 1))))))
  0)
(defn stamp-source-node [(x (ptr Sexp)) (source i64)] (-> i64)
  (store! (field x source) source)
  (match (load (field x kind))
    (KList [items] (stamp-source-list items source))
    (KVec [items] (stamp-source-list items source))
    (KInt [v] 0)
    (KFloat [b] 0)
    (KSym [s] 0)
    (KKw [s] 0)
    (KStr [s] 0)
    (KCStr [s] 0))
  0)
(defn diag-with-source [(d Diag) (source i64)] (-> Diag)
  (let [p (alloc/stack Diag)]
    (store! p d)
    (when (>= (load (field p lo)) (primitive/cast i64 0)) (store! (field p source) source))
    (load p)))

(defn read-all [(a (ptr Allocator)) (src (slice u8)) (source i64)] (-> (Result (ptr (ArrayList Sexp)) Diag))
  (match (tokenize a src)
    (Err [d] (Err (diag-with-source d source)))
    (Ok [toks]
        (let [p (alloc/stack Parser)
              (mut out) (al-new [Sexp] a)
              (mut err) (primitive/zeroed Diag)
              (mut failed) false]
          (store! (field p toks) toks)
          (store! (field p pos) 0)
          (loop (if (>= (load (field p pos)) (al-len [Tok] (load toks)))
                    (break)
                    (match (parse-one p a)
                      (Ok [s] (do (al-push! (mut out) s) 0))
                      (Err [d] (do (store! err d) (store! failed true) (break))))))
          (if (load failed)
              (Err (diag-with-source (load err) source))
              (let [forms (box-items a (load out))] (stamp-source-list forms source) (Ok forms)))))))

; ============================ accessors =====================================
;; An extractor was called on the wrong variant. That is a CALLER bug, so it
;; aborts loudly rather than returning a sentinel — `coil.sexp`'s accessors
;; returned 0 / "" here, which reads as a valid number or an empty symbol and
;; turns a type confusion into wrong output somewhere far away.
(defn sexp-wrong-variant [T] [(site (ptr i8))] (-> T)
  (oom-puts c"coil.reader: ")
  (oom-puts site)
  (oom-puts c"\n")
  (abort)
  (primitive/zeroed T))

; So a consumer never has to `match` on `SexpKind` for the ordinary questions.
; The compiler matches directly (it cares about all eight variants); everyone else
; wants these. A `?`-predicate is false for the wrong variant rather than an error,
; but the EXTRACTORS take `(ptr Sexp)` you have already tested — asking for the
; symbol of a number is a caller bug, so they hard-error instead of returning a
; sentinel that would silently read as valid data (an empty string, a 0).

(defn sexp-int? [(x (ptr Sexp))] (-> bool)
  (match (load (field x kind)) (KInt [_] true) (_ false)))
(defn sexp-float? [(x (ptr Sexp))] (-> bool)
  (match (load (field x kind)) (KFloat [_] true) (_ false)))
(defn sexp-sym? [(x (ptr Sexp))] (-> bool)
  (match (load (field x kind)) (KSym [_] true) (_ false)))
(defn sexp-kw? [(x (ptr Sexp))] (-> bool)
  (match (load (field x kind)) (KKw [_] true) (_ false)))
(defn sexp-str? [(x (ptr Sexp))] (-> bool)
  (match (load (field x kind)) (KStr [_] true) (_ false)))
(defn sexp-list? [(x (ptr Sexp))] (-> bool)
  (match (load (field x kind)) (KList [_] true) (_ false)))
(defn sexp-vec? [(x (ptr Sexp))] (-> bool)
  (match (load (field x kind)) (KVec [_] true) (_ false)))

(defn sexp-int [(x (ptr Sexp))] (-> i64)
  (match (load (field x kind))
    (KInt [v] v)
    (_ (sexp-wrong-variant c"sexp-int: not an integer (test with sexp-int? first)"))))
(defn sexp-sym [(x (ptr Sexp))] (-> (slice u8))
  (match (load (field x kind))
    (KSym [s] s)
    (_ (sexp-wrong-variant c"sexp-sym: not a symbol (test with sexp-sym? first)"))))
(defn sexp-str [(x (ptr Sexp))] (-> (slice u8))
  (match (load (field x kind))
    (KStr [s] s)
    (_ (sexp-wrong-variant c"sexp-str: not a string (test with sexp-str? first)"))))
(defn sexp-kw [(x (ptr Sexp))] (-> (slice u8))
  (match (load (field x kind))
    (KKw [s] s)
    (_ (sexp-wrong-variant c"sexp-kw: not a keyword (test with sexp-kw? first)"))))

;; The children of a list OR a vector — `(f x)` and `[f x]` both have two.
(defn sexp-items [(x (ptr Sexp))] (-> (ptr (ArrayList Sexp)))
  (match (load (field x kind))
    (KList [items] items)
    (KVec [items] items)
    (_ (sexp-wrong-variant c"sexp-items: not a list or vector"))))
;; Number of children; 0 for an atom, so it is safe to call on anything.
(defn sexp-count [(x (ptr Sexp))] (-> i64)
  (if (or (sexp-list? x) (sexp-vec? x)) (al-len [Sexp] (load (sexp-items x))) 0))
;; Child i as a pointer INTO the list — valid while the list is unmodified.
(defn sexp-nth [(x (ptr Sexp)) (i i64)] (-> (ptr Sexp))
  (al-elem [Sexp] (sexp-items x) i))

;; The common dispatch test: this node is the symbol `lit`.
(defn sexp-sym-is [(x (ptr Sexp)) (lit (slice u8))] (-> bool)
  (and (sexp-sym? x) (= (sexp-sym x) lit)))

; ============================ canonical dump entry ==========================
; Emits the `(error@source:lo:hi:ctxt "msg")` shape on a read/parse error.
