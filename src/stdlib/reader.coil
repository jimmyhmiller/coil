; THE s-expression reader — one implementation, used by the Coil compiler itself
; and available to any program. `read-all` turns `(slice u8)` source into a tree of
; `Sexp`; that is the same call, and the same tree, the compiler's own front end
; reads your file with.
;
;   (import "coil.reader" :use *)
;   (match (read-all a "(define x 10) (+ x 1)" 0)   ; -> (ptr (ArrayList Sexp))
;     (Ok [forms] …)
;     (Err [d] …))                                  ; Diag carries the span
;
; It handles what a Lisp reader is expected to handle, because the compiler needs
; all of it: `;`-to-end-of-line comments, `[` `]` as real delimiters distinct from
; `(` `)`, string literals with escapes (`\n \t \r \0 \xHH \" \\`, unknown escapes
; rejected), c-strings, character literals, keywords, integers and floats, and the
; `'`/`` ` ``/`~`/`~@` prefixes. Every node carries a source span (`lo`/`hi`/`source`)
; and a unique `node-id`, so a consumer can report errors that point at real source.
;
; This module replaced `coil.sexp`, which re-derived a weaker set of rules — no
; strings, no brackets, no comments — and got all three wrong. (`coil.serde.sexp`
; also tokenizes s-expressions but is NOT a Coil reader: it is a wire format with
; its own escape set and `#"…"` byte literals. See its header.)
(module coil.reader)
(import "coil.primitive" :as primitive)
(import "coil.alloc" :as alloc :use *)
(import "coil.result" :use *)
(import "coil.slice" :use *)
(import "coil.str" :use *)
(import "coil.mem" :use *)
(import "coil.arraylist" :use *)
(import "coil.io" :use *)
(import "coil.control" :use *)
(import "coil.try" :use *)

; No compiler-module imports: the reader is STANDALONE. It used to import `ast`
; for constructors of its OWN types (which made the two modules import each other)
; and `ffi` for the one extern below. `ast` imports the reader, not the reverse.

; Float literals. Declared here rather than imported so the reader depends on no
; compiler module; coil.serde and coil.serde.json declare the same signature the
; same way (an identical redeclaration is fine — only a CONFLICTING one is an error).
(extern strtod :cc c [(ptr i8) (ptr (ptr i8))] (-> f64))

(defsum SexpKind
  (KInt [(v i64)])
  (KFloat [(bits i64)])
  (KSym [(s (slice u8))])
  (KKw [(s (slice u8))])
  (KStr [(s (slice u8))])
  (KCStr [(s (slice u8))])
  (KList [(items (ptr (ArrayList Sexp)))])
  (KVec [(items (ptr (ArrayList Sexp)))])
  ; An O(1) VIEW of a suffix/slice of another list's items — what `code-rest`
  ; and `code-slice` return, so cdr-style metaprogram recursion stops copying
  ; the tail (docs/design/META_MEMORY.md phase 5). Views exist ONLY while a
  ; metaprogram executes: the code-op layer (comptime/metahost) reads them
  ; through view-aware accessors, and promotion at the expansion boundary
  ; flattens them to KList — the parser, checker, and codegen never see one.
  ; Appended last so every existing discriminant stays stable.
  (KView [(items (ptr (ArrayList Sexp))) (off i64) (len i64)]))

; `hyg` is lexical syntax identity/provenance. Zero means ordinary source syntax;
; positive values identify syntax introduced by one quasiquote evaluation. It is
; deliberately separate from `ctxt`, which is expansion/diagnostic provenance.
; The scope-aware expander/resolver consumes `hyg`; diagnostics consume `ctxt`.
;
; `node-id` = a stable, unique NODE ID assigned at construction (see next-node-id / mk-sexp).
; It is NEVER emitted by the canonical dumper, so the oracle stays byte-exact; it lets
; a metaprogram key on node IDENTITY (exact `type-of`) rather than the source span,
; which macro-duplicated subtrees can share.
(defstruct Sexp
  [(kind SexpKind)
   (lo i64)
   (hi i64)
   (source i64)
   (ctxt i64)
   (hyg i64)
   (hmod (slice u8))
   (horigin i64)
   (hflags i64)  ; bit 0: transported syntax; bit 1: lexical call head (expander -> parser)
   (node-id i64)])

(defsum TokKind
  (TOpen [(c i64)])
  (TClose [(c i64)])
  (TPrefix [(s (slice u8))])
  (TStr [(s (slice u8))])
  (TCStr [(s (slice u8))])
  (TChar [(v i64)])
  (TAtom [(s (slice u8))]))

(defstruct Tok [(kind TokKind) (lo i64) (hi i64)])

;;; `frames` is parse-one's explicit stack, kept for the whole read and emptied per
;;; form: one allocation per file rather than one per top-level form.
(defstruct Parser [(toks (ptr (ArrayList Tok))) (pos i64) (frames (ArrayList PFrame))])

(defstruct StrRead [(s (slice u8)) (end i64)])

;;; Reader punctuation is data, not a dialect test buried in the tokenizer.
;;; `read-all` uses the native defaults; frontend read metaprograms can wrap it
;;; through `read-all-with` and choose different prefix characters per source.
(defstruct ReaderConfig
  [(unquote i64)
   (alternate-unquote i64)
   (unquote-splicing i64)])

(defn default-reader-config [] (-> ReaderConfig)
  (ReaderConfig
    :unquote #\~
    :alternate-unquote #\,
    :unquote-splicing #\@))

(defn scheme-reader-config [] (-> ReaderConfig)
  (ReaderConfig
    :unquote #\,
    :alternate-unquote -1
    :unquote-splicing #\@))

; A parse/read diagnostic; dummy span = -1.
(defstruct Diag [(lo i64) (hi i64) (msg (slice u8)) (source i64) (ctxt i64)])

; ============================ small constructors =============================
; Monotonic node-id counter. Every Sexp gets a unique node-id at construction (starting at
; 1; 0 means "no id"). Deterministic — the same source produces the same node-ids in the
; same order, so the rebootstrap fixpoint holds.
(defstruct NodeIdCell [(n i64)])

(defn node-id-scope-cell [] (-> (ptr (ptr NodeIdCell)))
  (primitive/alloc-static (ptr NodeIdCell)))

(defn node-id-cell [] (-> (ptr NodeIdCell))
  (let [p (load (node-id-scope-cell))]
    (if (= (primitive/cast i64 p) 0) (primitive/alloc-static NodeIdCell) p)))

; A compiler session can supply an independent identity domain. The prior domain
; must be restored before releasing its replacement; ordinary readers need not
; bind a scope and retain their existing monotonic process domain.
(defn node-id-bind! [(next (ptr NodeIdCell))] (-> (ptr NodeIdCell))
  (let [prior (node-id-cell)] (set! (node-id-scope-cell) next) prior))

(defn next-node-id [] (-> i64)
  (let [c (node-id-cell)
        v (primitive/iadd (load (field c n)) 1)]
    (store! (field c n) v)
    v))

(defn mk-sexp [(kind SexpKind) (lo i64) (hi i64)] (-> Sexp)
  (let [p (primitive/alloc-stack Sexp)]
    (store! (field p kind) kind)
    (store! (field p lo) lo)
    (store! (field p hi) hi)
    (store! (field p source) (if (< lo (primitive/cast i64 0)) (do -1) 0))
    (store! (field p ctxt) 0)
    (store! (field p hyg) 0)
    (store! (field p hmod) "")
    (store! (field p horigin) 0)
    (store! (field p hflags) 0)
    (store! (field p node-id) (next-node-id))
    (load p)))

(defn mk-sexp-src [(kind SexpKind) (orig (ptr Sexp))] (-> Sexp)
  (let [p (primitive/alloc-stack Sexp)]
    (store! (field p kind) kind)
    (store! (field p lo) (load (field orig lo)))
    (store! (field p hi) (load (field orig hi)))
    (store! (field p source) (load (field orig source)))
    (store! (field p ctxt) (load (field orig ctxt)))
    (store! (field p hyg) (load (field orig hyg)))
    (store! (field p hmod) (load (field orig hmod)))
    (store! (field p horigin) (load (field orig horigin)))
    (store! (field p hflags) (load (field orig hflags)))
    (store! (field p node-id) (next-node-id))
    (load p)))

(defn mk-tok [(kind TokKind) (lo i64) (hi i64)] (-> Tok)
  (let [p (primitive/alloc-stack Tok)]
    (store! (field p kind) kind)
    (store! (field p lo) lo)
    (store! (field p hi) hi)
    (load p)))

; source = -1 means "not yet attributed to a file"; the span is file-relative, so
; it is meaningless until a caller stamps the source that `lo`/`hi` are offsets
; into (dwspan / diag-with-source). Defaulting to 0 instead would silently claim
; every diagnostic came from the entry file, rendering the right offsets against
; the wrong source text.
(defn mk-diag [(lo i64) (hi i64) (msg (slice u8))] (-> Diag)
  (let [p (primitive/alloc-stack Diag)]
    (store! (field p lo) lo)
    (store! (field p hi) hi)
    (store! (field p msg) msg)
    (store! (field p source) -1)
    (store! (field p ctxt) 0)
    (load p)))

(defn mk-diag-src [(source i64) (lo i64) (hi i64) (msg (slice u8))] (-> Diag)
  (let [p (primitive/alloc-stack Diag)]
    (store! p (mk-diag lo hi msg))
    (store! (field p source) source)
    (load p)))

(defn mk-strread [(s (slice u8)) (end i64)] (-> StrRead)
  (let [p (primitive/alloc-stack StrRead)]
    (store! (field p s) s)
    (store! (field p end) end)
    (load p)))

(defn box-items [(a (dyn Allocator)) (items (ArrayList Sexp))] (-> (ptr (ArrayList Sexp)))
  (box! a (ArrayList Sexp) items))

(defn box-sexp [(a (dyn Allocator)) (s Sexp)] (-> (ptr Sexp))
  (box! a Sexp s))

(defn looks-numeric [(s (slice u8))] (-> bool)
  (let [n (slice-len s)]
    (if (= n (primitive/cast i64 0))
        false
        (let [c0 (primitive/cast i64 (slice-get s 0))]
          (if (and (>= c0 (primitive/cast i64 48))
                   (<= c0 (primitive/cast i64 57)))
              true
              (if (and (or (= c0 (primitive/cast i64 45))
                           (or (= c0 (primitive/cast i64 43))
                               (= c0 (primitive/cast i64 46))))
                       (>= n
                           (primitive/cast i64
                                           2)))
                  (let [c1 (primitive/cast i64 (slice-get s 1))]
                    (and (>= c1 (primitive/cast i64 48))
                         (<= c1 (primitive/cast i64 57))))
                  false))))))

(defn parse-int [(s (slice u8))] (-> (Option i64))
  (let [n (slice-len s)]
    (let [dec
            (if (= n (primitive/cast i64 0))
                (None [i64])
                (let [(mut i) 0
                      (mut neg) false]
                  (let [c0 (primitive/cast i64 (slice-get s 0))]
                    (if (= c0 (primitive/cast i64 45))
                        (do (store! neg true) (store! i 1))
                        (when (= c0 (primitive/cast i64 43)) (store! i 1))))
                  (if (>= (load i) n)
                      (None [i64])
                      (let [(mut mag) 0
                            (mut ok) true
                            (mut overflow) false
                            maxrem (if (load neg) 8 7)]
                        (loop (if (>= (load i) n)
                                  (break)
                                  (let [c
                                          (primitive/cast i64
                                                          (slice-get s (load i)))]
                                    (if (and (>= c (primitive/cast i64 48))
                                             (<= c (primitive/cast i64 57)))
                                        (let [d (primitive/isub c 48)]
                                          (if (or (> (load mag)
                                                     (primitive/cast i64
                                                                     922337203685477580))
                                                  (and (= (load mag)
                                                          (primitive/cast i64
                                                                          922337203685477580))
                                                       (> d
                                                          maxrem)))
                                              (do
                                                (store! overflow true)
                                                (break))
                                              (do
                                                (store! mag
                                                        (primitive/iadd (primitive/imul (load mag)
                                                                                        10)
                                                                        d))
                                                (store! i
                                                        (primitive/iadd (load i)
                                                                        1)))))
                                        (do (store! ok false) (break))))))
                        (if (or (not (load ok)) (load overflow))
                            (None [i64])
                            (Some (if (load neg)
                                      (primitive/isub 0 (load mag))
                                      (load mag))))))))]
      (match dec
        (Some [v] (Some v))
        (None []
              (if (= n (primitive/cast i64 0))
                  (None [i64])
                  (let [(mut neg2) false
                        (mut bstart) 0]
                    (let [c0 (primitive/cast i64 (slice-get s 0))]
                      (if (= c0 (primitive/cast i64 45))
                          (do (store! neg2 true) (store! bstart 1))
                          (when (= c0 (primitive/cast i64 43))
                            (store! bstart 1))))
                    (let [blen (primitive/isub n (load bstart))
                          (mut radix) 0
                          (mut dstart) (load bstart)]
                      (when (and (>= blen (primitive/cast i64 2))
                                 (= (primitive/cast i64
                                                    (slice-get s (load bstart)))
                                    (primitive/cast i64 48)))
                        (let [c1
                                (primitive/cast i64
                                                (slice-get s
                                                           (primitive/iadd (load bstart)
                                                                           1)))]
                          (cond (or (= c1 (primitive/cast i64 120))
                                    (= c1 (primitive/cast i64 88)))
                                  (do
                                    (store! radix 16)
                                    (store! dstart
                                            (primitive/iadd (load bstart) 2)))
                                (or (= c1 (primitive/cast i64 98))
                                    (= c1 (primitive/cast i64 66)))
                                  (do
                                    (store! radix 2)
                                    (store! dstart
                                            (primitive/iadd (load bstart) 2)))
                                (or (= c1 (primitive/cast i64 111))
                                    (= c1 (primitive/cast i64 79)))
                                  (do
                                    (store! radix 8)
                                    (store! dstart
                                            (primitive/iadd (load bstart) 2)))
                                :else 0)))
                      (when (= (load radix) (primitive/cast i64 0))
                        (let [body (subslice s (load bstart) n)
                              has-us
                                (do
                                  (let [(mut f) false
                                        (mut j) (load bstart)]
                                    (loop (if (>= (load j) n)
                                              (break)
                                              (do
                                                (when (= (primitive/cast i64
                                                                         (slice-get s
                                                                                    (load j)))
                                                         (primitive/cast i64 95))
                                                  (store! f true)
                                                  0)
                                                (store! j
                                                        (primitive/iadd (load j)
                                                                        1)))))
                                    (load f)))]
                          (when (and has-us (looks-numeric body))
                            (store! radix 10)
                            (store! dstart (load bstart)))))
                      (if (= (load radix) (primitive/cast i64 0))
                          (None [i64])
                          (let [(mut mag) 0
                                (mut count) 0
                                (mut bad) false
                                (mut ovf) false
                                (mut j) (load dstart)
                                rr (load radix)]
                            (loop (if (>= (load j) n)
                                      (break)
                                      (let [c
                                              (primitive/cast i64
                                                              (slice-get s
                                                                         (load j)))]
                                        (store! j (primitive/iadd (load j) 1))
                                        ; `_` only BETWEEN digits: `1_000`, not
                                        ; `1_`, `1__0` or `0x_FF`. It used to be
                                        ; skipped wherever it stood.
                                        (when (and (= c (primitive/cast i64 95))
                                                   (or (= (primitive/isub (load j) 1)
                                                          (load dstart))
                                                       (or (>= (load j) n)
                                                           (= (primitive/cast i64
                                                                              (slice-get s
                                                                                         (load j)))
                                                              (primitive/cast i64 95)))))
                                          (store! bad true)
                                          (break))
                                        (unless (= c (primitive/cast i64 95))
                                          (let [dv
                                                  (let [v0
                                                          (cond (and (>= c
                                                                         (primitive/cast i64
                                                                                         48))
                                                                     (<= c
                                                                         (primitive/cast i64
                                                                                         57)))
                                                                  (primitive/isub c
                                                                                  48)
                                                                (and (>= c
                                                                         (primitive/cast i64
                                                                                         97))
                                                                     (<= c
                                                                         (primitive/cast i64
                                                                                         122)))
                                                                  (primitive/iadd (primitive/isub c
                                                                                                  97)
                                                                                  10)
                                                                (and (>= c
                                                                         (primitive/cast i64
                                                                                         65))
                                                                     (<= c
                                                                         (primitive/cast i64
                                                                                         90)))
                                                                  (primitive/iadd (primitive/isub c
                                                                                                  65)
                                                                                  10)
                                                                :else -1)]
                                                    (if (or (< v0
                                                               (primitive/cast i64
                                                                               0))
                                                            (>= v0 rr))
                                                        -1
                                                        v0))]
                                            (if (< dv (primitive/cast i64 0))
                                                (do (store! bad true) (break))
                                                (let [maxdiv
                                                        (primitive/udiv -1 rr)
                                                      maxrem
                                                        (primitive/urem -1 rr)]
                                                  (if (or (> (primitive/cast u64
                                                                             (load mag))
                                                             (primitive/cast u64
                                                                             maxdiv))
                                                          (and (= (load mag)
                                                                  maxdiv)
                                                               (> (primitive/cast u64
                                                                                  dv)
                                                                  (primitive/cast u64
                                                                                  maxrem))))
                                                      (do
                                                        (store! ovf true)
                                                        (break))
                                                      (do
                                                        (store! mag
                                                                (primitive/iadd (primitive/imul (load mag)
                                                                                                rr)
                                                                                dv))
                                                        (store! count
                                                                (primitive/iadd (load count)
                                                                                1)))))))))))
                            (if (or (load bad)
                                    (or (load ovf)
                                        (or (= (load count) (primitive/cast i64 0))
                                            ; A '-' sign admits magnitudes up to 2^63;
                                            ; unsigned decimal only up to 2^63-1. Only
                                            ; unsigned 0x/0b/0o may use the full u64
                                            ; range (bit patterns such as 0xFFFF_FFFF_FFFF_FFFF).
                                            (if (load neg2)
                                                (> (primitive/cast u64 (load mag))
                                                   (primitive/cast u64 -9223372036854775808))
                                                (and (= rr (primitive/cast i64 10))
                                                     (< (load mag) (primitive/cast i64 0)))))))
                                (None [i64])
                                (Some (if (load neg2)
                                          (primitive/isub 0 (load mag))
                                          (load mag))))))))))))))

; Takes the caller's allocator rather than grabbing `malloc-allocator` itself: the
; `str->cstr` below is a per-token scratch C string for `strtod`, so it belongs to
; whatever allocator the compile is running on. Grabbing the global one here put it on
; malloc no matter what the pipeline was threading.
(defn atom [(a (dyn Allocator)) (s (slice u8))] (-> SexpKind)
  (let [n (slice-len s)]
    (if (and (> n (primitive/cast i64 0))
             (= (primitive/cast i64 (slice-get s 0)) (primitive/cast i64 58)))
        (KKw (subslice s 1 n))
        (match (parse-int s)
          (Some [v] (KInt v))
          (None []
                (if (and (looks-numeric s)
                         (do
                           (let [(mut f) false
                                 (mut j) 0]
                             (loop (if (>= (load j) n)
                                       (break)
                                       (do
                                         (let [c
                                                 (primitive/cast i64
                                                                 (slice-get s
                                                                            (load j)))]
                                           (when (or (= c
                                                        (primitive/cast i64 46))
                                                     (or (= c
                                                            (primitive/cast i64
                                                                            101))
                                                         (= c
                                                            (primitive/cast i64
                                                                            69))))
                                             (store! f true)
                                             0))
                                         (store! j (primitive/iadd (load j) 1)))))
                             (load f))))
                    (let [buf (str->cstr a s)
                          ep (primitive/alloc-stack (ptr i8))
                          x (strtod buf ep)
                          consumed
                            (primitive/isub (primitive/cast i64 (load ep))
                                            (primitive/cast i64 buf))]
                      ; a literal past the f64 range (`1e400`) is not a number:
                      ; strtod saturates it to infinity, which read as a silent
                      ; `inf` in place of what was written
                      (if (and (and (> n (primitive/cast i64 0)) (= consumed n))
                               (and (primitive/fcmp-le x 1.7976931348623157e308)
                                    (primitive/fcmp-ge x -1.7976931348623157e308)))
                          (KFloat (f64-bits x))
                          (KSym s)))
                    (KSym s)))))))

; ---- string escapes ----------------------------------------------------
; The recognized set is `\n \t \r \0 \" \\` plus `\xHEX;`. An UNRECOGNIZED escape
; is an error, not the escaped character: dropping the backslash silently turned
; every `"\r\n"` in this tree into the letters `rn`, which is exactly the kind of
; mistake a wire protocol never announces — it just fails somewhere else.
(defn str-escape-code [(e i64)] (-> i64)
  (cond (= e (primitive/cast i64 110)) 10  ; \n
        (= e (primitive/cast i64 116)) 9  ; \t
        (= e (primitive/cast i64 114)) 13  ; \r
        (= e (primitive/cast i64 48)) 0  ; \0
        (= e (primitive/cast i64 34)) 34  ; \"
        (= e (primitive/cast i64 92)) 92  ; \\
        :else -1))

(defn str-utf8-push! [(buf (mut (ArrayList u8))) (cp i64)] (-> i64)
  (cond (< cp 128) (al-push! (mut buf) (primitive/cast u8 cp))
        (< cp 2048)
          (do
            (al-push! (mut buf)
                      (primitive/cast u8 (+ 192 (primitive/ishr cp 6))))
            (al-push! (mut buf)
                      (primitive/cast u8 (+ 128 (primitive/iand cp 63)))))
        (< cp 65536)
          (do
            (al-push! (mut buf)
                      (primitive/cast u8 (+ 224 (primitive/ishr cp 12))))
            (al-push! (mut buf)
                      (primitive/cast u8
                                      (+ 128
                                         (primitive/iand (primitive/ishr cp 6)
                                                         63))))
            (al-push! (mut buf)
                      (primitive/cast u8 (+ 128 (primitive/iand cp 63)))))
        :else
          (do
            (al-push! (mut buf)
                      (primitive/cast u8 (+ 240 (primitive/ishr cp 18))))
            (al-push! (mut buf)
                      (primitive/cast u8
                                      (+ 128
                                         (primitive/iand (primitive/ishr cp 12)
                                                         63))))
            (al-push! (mut buf)
                      (primitive/cast u8
                                      (+ 128
                                         (primitive/iand (primitive/ishr cp 6)
                                                         63))))
            (al-push! (mut buf)
                      (primitive/cast u8 (+ 128 (primitive/iand cp 63)))))))

(defn read-string-body [(a (dyn Allocator))
                        (src (slice u8))
                        (open-off i64)
                        (i i64)
                        (byte-limit i64)] (-> (Result StrRead
                                                      Diag))
  (let [n (slice-len src)
        (mut buf) (al-new [u8] a)
        (mut k) i
        (mut out) (primitive/zeroed (Result StrRead Diag))]
    (loop (if (>= (load k) n)
              (do
                (store! out
                        (Err (mk-diag open-off n "unterminated string literal")))
                (break))
              (let [c (primitive/cast i64 (slice-get src (load k)))]
                (store! k (primitive/iadd (load k) 1))
                (if (= c (primitive/cast i64 34))
                    (do
                      (store! out
                              (Ok (mk-strread (al-slice [u8] (load buf))
                                              (load k))))
                      (break))
                    (if (= c (primitive/cast i64 92))
                        (if (>= (load k) n)
                            (do
                              (store! out
                                      (Err (mk-diag open-off
                                                    n
                                                    "unterminated string escape")))
                              (break))
                            (let [esc-off (primitive/isub (load k) 1)
                                  e
                                    (primitive/cast i64
                                                    (slice-get src (load k)))]
                              (store! k (primitive/iadd (load k) 1))
                              (if (= e (primitive/cast i64 120))
                                  (let [(mut cp) 0
                                        (mut digits) 0
                                        (mut done) false]
                                    (loop (if (>= (load k) n)
                                              (break)
                                              (let [hc
                                                      (primitive/cast i64
                                                                      (slice-get src
                                                                                 (load k)))]
                                                (if (= hc 59)
                                                    (do
                                                      (store! done true)
                                                      (store! k
                                                              (primitive/iadd (load k)
                                                                              1))
                                                      (break))
                                                    (let [d (sh-hex-digit hc)]
                                                      (if (< d 0)
                                                          (break)
                                                          (do
                                                            (store! cp
                                                                    (if (> (load cp)
                                                                           1114111)
                                                                        1114112
                                                                        (+ (* (load cp)
                                                                              16)
                                                                           d)))
                                                            (store! digits
                                                                    (+ (load digits)
                                                                       1))
                                                            (store! k
                                                                    (primitive/iadd (load k)
                                                                                    1)))))))))
                                    (if (= (load digits) 0)
                                        (do
                                          (store! out
                                                  (Err (mk-diag esc-off
                                                                (load k)
                                                                "\\x escape needs at least one hex digit before ';'")))
                                          (break))
                                        (if (not (load done))
                                            (do
                                              (store! out
                                                      (Err (mk-diag esc-off
                                                                    (load k)
                                                                    "\\x escape must end with ';'")))
                                              (break))
                                            (if (or (> (load cp) 1114111)
                                                    (and (>= (load cp) 55296)
                                                         (<= (load cp) 57343)))
                                                (do
                                                  (store! out
                                                          (Err (mk-diag esc-off
                                                                        (load k)
                                                                        "\\x escape is not a valid Unicode scalar")))
                                                  (break))
                                                (if (= byte-limit 0)
                                                    (str-utf8-push! (mut buf)
                                                                    (load cp))
                                                    (if (> (load cp) byte-limit)
                                                        (do
                                                          (store! out
                                                                  (Err (mk-diag esc-off
                                                                                (load k)
                                                                                "C-string \\x escape exceeds one byte")))
                                                          (break))
                                                        (al-push! (mut buf)
                                                                  (primitive/cast u8
                                                                                  (load cp)))))))))
                                  (let [code (str-escape-code e)]
                                    (if (< code 0)
                                        (do
                                          (store! out
                                                  (Err (mk-diag esc-off
                                                                (load k)
                                                                "unknown string escape (known: \\n \\t \\r \\0 \\\" \\\\ \\xHEX;)")))
                                          (break))
                                        (do
                                          (al-push! (mut buf)
                                                    (primitive/cast u8 code))
                                          0))))))
                        (al-push! (mut buf) (primitive/cast u8 c)))))))
    (load out)))

; ---- character literals: #\a #\) #\newline #\space #\tab ----------------
; A `\` starts a char literal. A single char after it (\a, \), \") is that byte;
; an alphabetic run is a name (\newline \space \tab \return \nul \backspace
; \formfeed) or \uHEX. Lexes to a plain integer literal (KInt), so it is just
; sugar: `(= (primitive/cast i64 byte) #\a)` needs no new type machinery.
(defn sh-is-alpha [(c i64)] (-> bool)
  (or (and (>= c (primitive/cast i64 97)) (<= c (primitive/cast i64 122)))
      (and (>= c (primitive/cast i64 65)) (<= c (primitive/cast i64 90)))))

(defn sh-is-alnum [(c i64)] (-> bool)
  (or (sh-is-alpha c)
      (and (>= c (primitive/cast i64 48)) (<= c (primitive/cast i64 57)))))

(defn sh-hex-digit [(c i64)] (-> i64)
  (cond (and (>= c (primitive/cast i64 48)) (<= c (primitive/cast i64 57)))
          (primitive/isub c 48)
        (and (>= c (primitive/cast i64 97)) (<= c (primitive/cast i64 102)))
          (primitive/iadd (primitive/isub c 97) 10)
        (and (>= c (primitive/cast i64 65)) (<= c (primitive/cast i64 70)))
          (primitive/iadd (primitive/isub c 65) 10)
        :else -1))

(defn char-name-code [(s (slice u8))] (-> i64)
  (cond (= s "space") 32
        (= s "newline") 10
        (= s "tab") 9
        (= s "return") 13
        (= s "nul") 0
        (= s "null") 0
        (= s "backspace") 8
        (= s "formfeed") 12
        :else  ; \uHEX
          (let [n (slice-len s)]
            (if (and (>= n (primitive/cast i64 2))
                     (= (primitive/cast i64 (slice-get s 0))
                        (primitive/cast i64 117)))
                (let [(mut v) 0
                      (mut j) 1
                      (mut ok) true]
                  (loop (if (>= (load j) n)
                            (break)
                            (let [d
                                    (sh-hex-digit (primitive/cast i64
                                                                  (slice-get s
                                                                             (load j))))]
                              (if (< d (primitive/cast i64 0))
                                  (do (store! ok false) (break))
                                  (do
                                    (store! v
                                            (if (> (load v) 1114111)
                                                1114112  ; saturate: never wrap
                                                (primitive/iadd (primitive/imul (load v)
                                                                                16)
                                                                d)))
                                    (store! j (primitive/iadd (load j) 1)))))))
                  (if (and (load ok)
                           (<= (load v) 1114111)
                           (not (and (>= (load v) 55296) (<= (load v) 57343))))
                      (load v)
                      -1))
                -1))))

;;; Length of the UTF-8 sequence a lead byte announces (1 for anything that is
;;; not a multi-byte lead: ASCII, a stray continuation, an invalid byte).
(defn utf8-need [(b i64)] (-> i64)
  (cond (and (>= b 194) (<= b 223)) 2
        (and (>= b 224) (<= b 239)) 3
        (and (>= b 240) (<= b 244)) 4
        :else 1))

;;; Index just past up to `need - 1` continuation bytes starting at `i`.
(defn utf8-tail-end [(src (slice u8)) (i i64) (need i64)] (-> i64)
  (let [(mut k) i
        stop (primitive/iadd i (primitive/isub need 1))]
    (loop (if (or (>= (load k) stop) (>= (load k) (slice-len src)))
              (break)
              (let [c (primitive/cast i64 (slice-get src (load k)))]
                (if (and (>= c 128) (<= c 191))
                    (store! k (primitive/iadd (load k) 1))
                    (break)))))
    (load k)))

;;; The scalar value of one complete, shortest-form UTF-8 sequence; -1 otherwise.
(defn utf8-decode [(s (slice u8))] (-> i64)
  (let [n (slice-len s)
        b0 (primitive/cast i64 (slice-get s 0))
        need (utf8-need b0)]
    (if (!= n need)
        -1
        (let [(mut cp) (primitive/iand b0 (case need 2 31 3 15 7))
              (mut j) 1]
          (loop (if (>= (load j) n)
                    (break)
                    (do
                      (store! cp (primitive/ior (primitive/imul (load cp) 64)
                                                (primitive/iand (primitive/cast i64 (slice-get s (load j))) 63)))
                      (store! j (primitive/iadd (load j) 1)))))
          (if (or (< (load cp) (case need 2 128 3 2048 65536))
                  (> (load cp) 1114111)
                  (and (>= (load cp) 55296) (<= (load cp) 57343)))
              -1
              (load cp))))))

(defn tokenize-with [(a (dyn Allocator))
                     (src (slice u8))
                     (config ReaderConfig)] (-> (Result (ptr (ArrayList Tok))
                                                        Diag))
  (let [n (slice-len src)
        cfg (primitive/alloc-stack ReaderConfig)
        (mut toks) (al-new [Tok] a)
        (mut i) 0
        (mut out) (primitive/zeroed (Result (ptr (ArrayList Tok)) Diag))
        (mut done) false]
    (store! cfg config)
    (loop (if (>= (load i) n)
              (break)
              (let [c (primitive/cast i64 (slice-get src (load i)))]
                (cond (or (= c (primitive/cast i64 32))
                          (or (= c (primitive/cast i64 9))
                              (or (= c (primitive/cast i64 10))
                                  (or (= c (primitive/cast i64 13))
                                      (or (= c
                                             (primitive/cast i64
                                                             11))
                                          (= c
                                             (primitive/cast i64
                                                             12)))))))
                        (store! i (primitive/iadd (load i) 1))
                      (= c (primitive/cast i64 59))
                        (loop (if (>= (load i) n)
                                  (break)
                                  (let [ch
                                          (primitive/cast i64
                                                          (slice-get src
                                                                     (load i)))]
                                    (store! i (primitive/iadd (load i) 1))
                                    (when (= ch (primitive/cast i64 10))
                                      (break)))))
                      (or (= c (primitive/cast i64 40))
                          (= c (primitive/cast i64 91)))
                        (do
                          (al-push! (mut toks)
                                    (mk-tok (TOpen c)
                                            (load i)
                                            (primitive/iadd (load i) 1)))
                          (store! i (primitive/iadd (load i) 1)))
                      ; R5RS vector opener `#(`. Reuse TOpen with sentinel 35:
                      ; parse-one closes it with `)` and constructs KVec.
                      (and (= c (primitive/cast i64 35))
                           (and (< (primitive/iadd (load i) 1) n)
                                (= (primitive/cast i64
                                                   (slice-get src
                                                              (primitive/iadd (load i)
                                                                              1)))
                                   (primitive/cast i64 40))))
                        (do
                          (al-push! (mut toks)
                                    (mk-tok (TOpen 35)
                                            (load i)
                                            (primitive/iadd (load i) 2)))
                          (store! i (primitive/iadd (load i) 2)))
                      ; `#'F` reads as (syntax F) — procedural-macro template
                      ; sugar (Chez/R6RS). A plain `#` symbol never followed
                      ; `'` in valid source, so the prefix is unambiguous.
                      (and (= c (primitive/cast i64 35))
                           (and (< (primitive/iadd (load i) 1) n)
                                (= (primitive/cast i64
                                                   (slice-get src
                                                              (primitive/iadd (load i)
                                                                              1)))
                                   (primitive/cast i64 39))))
                        (do
                          (al-push! (mut toks)
                                    (mk-tok (TPrefix "syntax")
                                            (load i)
                                            (primitive/iadd (load i) 2)))
                          (store! i (primitive/iadd (load i) 2)))
                      ; Canonical character syntax. A delimiter immediately after
                      ; `#\` belongs to the literal, so recognize it first.
                      (and (= c (primitive/cast i64 35))
                           (and (< (primitive/iadd (load i) 1) n)
                                (= (primitive/cast i64
                                                   (slice-get src
                                                              (primitive/iadd (load i)
                                                                              1)))
                                   (primitive/cast i64 92))))
                        (let [cstart (load i)]
                          (store! i (primitive/iadd (load i) 2))
                          (if (>= (load i) n)
                              (do
                                (store! out
                                        (Err (mk-diag cstart
                                                      n
                                                      "unterminated character literal")))
                                (store! done true)
                                (break))
                              (let [first
                                      (primitive/cast i64
                                                      (slice-get src (load i)))]
                                (store! i (primitive/iadd (load i) 1))
                                ; a character is a whole UTF-8 sequence, not its lead byte
                                (store! i (utf8-tail-end src (load i) (utf8-need first)))
                                (let [(mut nend) (load i)]
                                  (when (sh-is-alpha first)
                                    (loop (if (>= (load i) n)
                                              (break)
                                              (let [cc
                                                      (primitive/cast i64
                                                                      (slice-get src
                                                                                 (load i)))]
                                                (if (sh-is-alnum cc)
                                                    (do
                                                      (store! i
                                                              (primitive/iadd (load i)
                                                                              1))
                                                      (store! nend (load i)))
                                                    (break))))))
                                  ; Keep the spelling intact for dialect consumers.
                                  ; Coil's typed parser validates and lowers it below;
                                  ; a dialect may define additional named characters.
                                  (al-push! (mut toks)
                                            (mk-tok (TAtom (subslice src
                                                                     cstart
                                                                     (load nend)))
                                                    cstart
                                                    (load nend)))))))
                      (or (= c (primitive/cast i64 41))
                          (= c (primitive/cast i64 93)))
                        (do
                          (al-push! (mut toks)
                                    (mk-tok (TClose c)
                                            (load i)
                                            (primitive/iadd (load i) 1)))
                          (store! i (primitive/iadd (load i) 1)))
                      (= c (primitive/cast i64 39))
                        (do
                          (al-push! (mut toks)
                                    (mk-tok (TPrefix "quote")
                                            (load i)
                                            (primitive/iadd (load i) 1)))
                          (store! i (primitive/iadd (load i) 1)))
                      (= c (primitive/cast i64 96))
                        (do
                          (al-push! (mut toks)
                                    (mk-tok (TPrefix "quasiquote")
                                            (load i)
                                            (primitive/iadd (load i) 1)))
                          (store! i (primitive/iadd (load i) 1)))
                      (or (= c (load (field cfg unquote)))
                          (= c (load (field cfg alternate-unquote))))
                        (let [istart (load i)]
                          (store! i (primitive/iadd (load i) 1))
                          (if (and (< (load i) n)
                                   (= (primitive/cast i64
                                                      (slice-get src (load i)))
                                      (load (field cfg unquote-splicing))))
                              (do
                                (al-push! (mut toks)
                                          (mk-tok (TPrefix "unquote-splicing")
                                                  istart
                                                  (primitive/iadd (load i) 1)))
                                (store! i (primitive/iadd (load i) 1)))
                              (al-push! (mut toks)
                                        (mk-tok (TPrefix "unquote")
                                                istart
                                                (primitive/iadd istart 1)))))
                      (= c (primitive/cast i64 92))
                        (let [cstart (load i)]
                          (store! i (primitive/iadd (load i) 1))
                          (if (>= (load i) n)
                              (do
                                (store! out
                                        (Err (mk-diag cstart
                                                      n
                                                      "unterminated character literal")))
                                (store! done true)
                                (break))
                              (let [first
                                      (primitive/cast i64
                                                      (slice-get src (load i)))]
                                (store! i (primitive/iadd (load i) 1))
                                ; a character is a whole UTF-8 sequence, not its lead byte
                                (store! i (utf8-tail-end src (load i) (utf8-need first)))
                                (let [(mut nend) (load i)]
                                  (when (sh-is-alpha first)
                                    (loop (if (>= (load i) n)
                                              (break)
                                              (let [cc
                                                      (primitive/cast i64
                                                                      (slice-get src
                                                                                 (load i)))]
                                                (if (sh-is-alnum cc)
                                                    (do
                                                      (store! i
                                                              (primitive/iadd (load i)
                                                                              1))
                                                      (store! nend (load i)))
                                                    (break))))))
                                  (let [nlen
                                          (primitive/isub (load nend)
                                                          (primitive/iadd cstart
                                                                          1))
                                        v
                                          (cond (= nlen (primitive/cast i64 1)) first
                                                (>= first (primitive/cast i64 128))
                                                  (utf8-decode (subslice src
                                                                         (primitive/iadd cstart 1)
                                                                         (load nend)))
                                                :else
                                                  (char-name-code (subslice src
                                                                            (primitive/iadd cstart
                                                                                            1)
                                                                            (load nend))))]
                                    (if (< v (primitive/cast i64 0))
                                        (do
                                          (store! out
                                                  (Err (mk-diag cstart
                                                                (load nend)
                                                                "unknown character literal")))
                                          (store! done true)
                                          (break))
                                        (al-push! (mut toks)
                                                  (mk-tok (TChar v)
                                                          cstart
                                                          (load nend)))))))))
                      (= c (primitive/cast i64 34))
                        (let [istart (load i)]
                          (store! i (primitive/iadd (load i) 1))
                          (match (read-string-body a src istart (load i) 0)
                            (Err [d]
                                 (do
                                   (store! out (Err d))
                                   (store! done true)
                                   (break)))
                            (Ok [sr]
                                (let [srp (primitive/alloc-stack StrRead)]
                                  (store! srp sr)
                                  (al-push! (mut toks)
                                            (mk-tok (TStr (load (field srp s)))
                                                    istart
                                                    (load (field srp end))))
                                  (store! i (load (field srp end)))))))
                      :else
                        (let [start (load i)
                              (mut end) (load i)]
                          (loop (if (>= (load i) n)
                                    (break)
                                    (let [cc
                                            (primitive/cast i64
                                                            (slice-get src
                                                                       (load i)))]
                                      (if (or (or (= cc (primitive/cast i64 32))
                                                  (or (= cc
                                                         (primitive/cast i64 9))
                                                      (or (= cc
                                                             (primitive/cast i64
                                                                             10))
                                                          (or (= cc
                                                                 (primitive/cast i64
                                                                                 13))
                                                              (or (= cc
                                                                     (primitive/cast i64
                                                                                     11))
                                                                  (= cc
                                                                     (primitive/cast i64
                                                                                     12)))))))
                                              (or (= cc (primitive/cast i64 40))
                                                  (or (= cc
                                                         (primitive/cast i64 41))
                                                      (or (= cc
                                                             (primitive/cast i64
                                                                             91))
                                                          (or (= cc
                                                                 (primitive/cast i64
                                                                                 93))
                                                              (or (= cc
                                                                     (primitive/cast i64
                                                                                     59))
                                                                  (or (= cc
                                                                         (primitive/cast i64
                                                                                         39))
                                                                      (or (= cc
                                                                             (primitive/cast i64
                                                                                             96))
                                                                          (or (= cc
                                                                                 (load (field cfg
                                                                                              unquote)))
                                                                              (or (= cc
                                                                                     (load (field cfg
                                                                                                  alternate-unquote)))
                                                                                  (= cc
                                                                                     (primitive/cast i64
                                                                                                     34))))))))))))
                                          (break)
                                          (do
                                            (store! i
                                                    (primitive/iadd (load i) 1))
                                            (store! end (load i)))))))
                          (let [stok (subslice src start (load end))]
                            (if (and (and (= (primitive/isub (load end) start)
                                             (primitive/cast i64 1))
                                          (= (primitive/cast i64
                                                             (slice-get src
                                                                        start))
                                             (primitive/cast i64 99)))
                                     (and (< (load i) n)
                                          (= (primitive/cast i64
                                                             (slice-get src
                                                                        (load i)))
                                             (primitive/cast i64 34))))
                                (do
                                  (store! i (primitive/iadd (load i) 1))
                                  (match (read-string-body a
                                                           src
                                                           start
                                                           (load i)
                                                           255)
                                    (Err [d]
                                         (do
                                           (store! out (Err d))
                                           (store! done true)
                                           (break)))
                                    (Ok [sr]
                                        (let [srp
                                                (primitive/alloc-stack StrRead)]
                                          (store! srp sr)
                                          (al-push! (mut toks)
                                                    (mk-tok (TCStr (load (field srp
                                                                                s)))
                                                            start
                                                            (load (field srp
                                                                         end))))
                                          (store! i (load (field srp end)))))))
                                (al-push! (mut toks)
                                          (mk-tok (TAtom stok) start (load end))))))))))
    (if (load done)
        (load out)
        (Ok (box! a (ArrayList Tok) (load toks))))))

; ── parse-one: iterative, over an explicit stack ─────────────────────────────
;
; Nesting depth costs heap, not C stack: the recursive version needed about a
; kilobyte of stack per level, so ~8000 unclosed `(` overflowed an 8 MB thread —
; any caller of `read-all`, on input it did not write.

;;; What an open frame is waiting for.
(defsum Open
  (OpenBracket [(opener i64)])  ; `(`, `[`, or `#` for `#(`: waiting for its closer
  (OpenPrefix [(sym (slice u8))]))  ; `'` `` ` `` `~` …: waiting for its one form

(defstruct PFrame [(open Open) (lo i64) (hi i64) (items (ArrayList Sexp))])

;;; What one token did to the parse.
(defsum Step
  (Produced [(val Sexp)])  ; a complete form, to hand to the enclosing frame
  (Pushed [])  ; opened a frame
  (Failed [(d Diag)]))

(defn byte-str [(a (dyn Allocator)) (c i64)] (-> (slice u8))
  (slice-new [u8] (box! a u8 (primitive/cast u8 c)) 1))

(defn cat2 [(a (dyn Allocator)) (x (slice u8)) (y (slice u8))] (-> (slice u8))
  (match (str-concat a x y)
    (Some [v] v)
    (None [] "")))

;;; How an opener is spelled in a message.
(defn opener-text [(a (dyn Allocator)) (opener i64)] (-> (slice u8))
  (if (= opener (primitive/cast i64 35)) "#(" (byte-str a opener)))

(defn closer-of [(opener i64)] (-> i64)
  (if (= opener (primitive/cast i64 91)) 93 41))

;;; `'<x>'`
(defn quoted [(a (dyn Allocator)) (x (slice u8))] (-> (slice u8))
  (cat2 a (cat2 a "'" x) "'"))

;;; A closer with nothing open for it. Built only when it is the answer: every
;;; closing delimiter of every file the compiler reads goes through `parse-close`,
;;; and a message built up front for each was ~44 MB of allocation per build.
(defn parse-unexpected [(a (dyn Allocator)) (c i64) (tlo i64) (thi i64)] (-> Step)
  (Failed (mk-diag tlo thi (cat2 a "unexpected " (quoted a (byte-str a c))))))

(defn parse-close [(a (dyn Allocator))
                   (stack (mut (ArrayList PFrame)))
                   (c i64)
                   (tlo i64)
                   (thi i64)] (-> Step)
  (let [d (al-len [PFrame] (load stack))]
    (if (= d (primitive/cast i64 0))
        (parse-unexpected a c tlo thi)
        (let [top (al-elem [PFrame] stack (primitive/isub d 1))
              lo (load (field top lo))
              items (load (field top items))]
          (match (load (field top open))
            (OpenPrefix [_] (parse-unexpected a c tlo thi))
            (OpenBracket [o]
                         (if (!= c (closer-of o))
                             (Failed (mk-diag tlo
                                              thi
                                              (cat2 a
                                                    (cat2 a
                                                          "mismatched delimiters: "
                                                          (quoted a (opener-text a o)))
                                                    (cat2 a " .. " (quoted a (byte-str a c))))))
                             (do
                               (al-pop! (mut stack))
                               (Produced (mk-sexp (if (= o (primitive/cast i64 40))
                                                      (KList (box-items a items))
                                                      (KVec (box-items a items)))
                                                  lo
                                                  thi))))))))))

(defn parse-step [(a (dyn Allocator)) (stack (mut (ArrayList PFrame))) (tok Tok)] (-> Step)
  (let [tlo (load (field tok lo))
        thi (load (field tok hi))]
    (match (load (field tok kind))
      (TStr [s] (Produced (mk-sexp (KStr s) tlo thi)))
      (TCStr [s] (Produced (mk-sexp (KCStr s) tlo thi)))
      (TChar [v] (Produced (mk-sexp (KInt v) tlo thi)))
      (TAtom [s] (Produced (mk-sexp (atom a s) tlo thi)))
      (TOpen [o]
             (do
               (al-push! (mut stack)
                         (PFrame :open (OpenBracket o)
                                 :lo tlo
                                 :hi thi
                                 :items (al-new [Sexp] a)))
               (Pushed)))
      (TPrefix [sym]
               (do
                 (al-push! (mut stack)
                           (PFrame :open (OpenPrefix sym)
                                   :lo tlo
                                   :hi thi
                                   :items (al-new [Sexp] a)))
                 (Pushed)))
      (TClose [c] (parse-close a (mut stack) c tlo thi)))))

;;; Hand a finished form to the frames above it: every prefix waiting on it wraps
;;; it and is finished in turn, until a bracket takes it as an element (None) or
;;; the stack empties and it is the result (Some).
(defn parse-deliver [(a (dyn Allocator)) (stack (mut (ArrayList PFrame))) (v Sexp)] (-> (Option Sexp))
  (let [(mut val) (load v)
        (mut result) (None [Sexp])]
    (loop (let [d (al-len [PFrame] (load stack))]
            (if (= d (primitive/cast i64 0))
                (do (store! result (Some (load val))) (break))
                (let [top (al-elem [PFrame] stack (primitive/isub d 1))]
                  (match (load (field top open))
                    (OpenBracket [_]
                                 (do (al-push! (mut (field top items)) (load val)) (break)))
                    (OpenPrefix [sym]
                                (let [plo (load (field top lo))
                                      (mut kids) (al-new [Sexp] a)]
                                  (al-push! (mut kids) (mk-sexp (KSym sym) plo (load (field top hi))))
                                  (al-push! (mut kids) (load val))
                                  (store! val
                                          (mk-sexp (KList (box-items a (load kids)))
                                                   plo
                                                   (load (field val hi))))
                                  (al-pop! (mut stack))
                                  0)))))))
    (load result)))

;;; The error for input that ends inside a form: at the innermost open frame, or
;;; with no location at all when nothing was open (the caller had no form left).
(defn parse-eof-diag [(a (dyn Allocator)) (stack (mut (ArrayList PFrame)))] (-> Diag)
  (let [d (al-len [PFrame] (load stack))]
    (if (= d (primitive/cast i64 0))
        (mk-diag -1 -1 "unexpected end of input")
        (let [top (al-elem [PFrame] stack (primitive/isub d 1))
              lo (load (field top lo))
              hi (load (field top hi))]
          (match (load (field top open))
            (OpenPrefix [_] (mk-diag lo hi "expected a form after reader prefix"))
            (OpenBracket [o] (mk-diag lo hi (cat2 a "unclosed " (quoted a (opener-text a o))))))))))

(defn parse-one [(p (ptr Parser)) (a (dyn Allocator))] (-> (Result Sexp Diag))
  (let [toks (load (field p toks))
        ntok (al-len [Tok] (load toks))
        stack (field p frames)
        (mut out) (primitive/zeroed (Result Sexp Diag))]
    (al-clear! [PFrame] stack)
    (loop (let [pos (load (field p pos))]
            (if (>= pos ntok)
                (do (store! out (Err (parse-eof-diag a stack))) (break))
                (do
                  (store! (field p pos) (primitive/iadd pos 1))
                  (match (parse-step a stack (al-get [Tok] (load toks) pos))
                    (Failed [d] (do (store! out (Err d)) (break)))
                    (Pushed [] 0)
                    (Produced [v]
                              (match (parse-deliver a stack v)
                                (Some [form] (do (store! out (Ok form)) (break)))
                                (None [] 0))))))))
    (load out)))

; Stamp `source` on nodes + descendants (int place); ctxt untouched. Iterative
; (explicit worklist of lists) for the same reason as parse-one.
(defn stamp-source-list [(items (ptr (ArrayList Sexp))) (source i64)] (-> i64)
  (let [a (malloc-allocator)
        (mut work) (al-new [(ptr (ArrayList Sexp))] a)]
    (al-push! (mut work) items)
    (loop (if (= (al-len [(ptr (ArrayList Sexp))] (load work)) (primitive/cast i64 0))
              (break)
              (let [l (al-get [(ptr (ArrayList Sexp))] (load work)
                              (primitive/isub (al-len [(ptr (ArrayList Sexp))] (load work)) 1))
                    n (al-len [Sexp] (load l))
                    data (load (field l data))
                    (mut i) 0]
                (al-pop! (mut work))
                (loop (if (>= (load i) n)
                          (break)
                          (let [x (primitive/index data (load i))]
                            (store! (field x source) source)
                            (match (load (field x kind))
                              (KList [its] (do (al-push! (mut work) its) 0))
                              (KVec [its] (do (al-push! (mut work) its) 0))
                              (KView [its off len] (do (al-push! (mut work) its) 0))
                              (_ 0))
                            (store! i (primitive/iadd (load i) 1))))))))
    (al-free! (mut work))
    0))

(defn stamp-source-node [(x (ptr Sexp)) (source i64)] (-> i64)
  (store! (field x source) source)
  (match (load (field x kind))
    (KList [items] (stamp-source-list items source))
    (KVec [items] (stamp-source-list items source))
    (KView [items off len] (stamp-source-list items source))
    (KInt [v] 0)
    (KFloat [b] 0)
    (KSym [s] 0)
    (KKw [s] 0)
    (KStr [s] 0)
    (KCStr [s] 0))
  0)

(defn diag-with-source [(d Diag) (source i64)] (-> Diag)
  (let [p (primitive/alloc-stack Diag)]
    (store! p d)
    (when (>= (load (field p lo)) (primitive/cast i64 0))
      (store! (field p source) source))
    (load p)))

(defn read-all-with [(a (dyn Allocator))
                     (src (slice u8))
                     (source i64)
                     (config ReaderConfig)] (-> (Result (ptr (ArrayList Sexp))
                                                        Diag))
  (match (tokenize-with a src config)
    (Err [d] (Err (diag-with-source d source)))
    (Ok [toks]
        (let [p (primitive/alloc-stack Parser)
              (mut out) (al-new [Sexp] a)
              (mut err) (primitive/zeroed Diag)
              (mut failed) false]
          (store! (field p toks) toks)
          (store! (field p pos) 0)
          (store! (field p frames) (al-new [PFrame] a))
          (loop (if (>= (load (field p pos)) (al-len [Tok] (load toks)))
                    (break)
                    (match (parse-one p a)
                      (Ok [s] (do (al-push! (mut out) s) 0))
                      (Err [d] (do (store! err d) (store! failed true) (break))))))
          (if (load failed)
              (Err (diag-with-source (load err) source))
              (let [forms (box-items a (load out))]
                (stamp-source-list forms source)
                (Ok forms)))))))

(defn read-all [(a (dyn Allocator)) (src (slice u8)) (source i64)] (-> (Result (ptr (ArrayList Sexp))
                                                                               Diag))
  (read-all-with a src source (default-reader-config)))

; ============================ accessors =====================================
;;; An extractor was called on the wrong variant. That is a CALLER bug, so it
;;; aborts loudly rather than returning a sentinel — `coil.sexp`'s accessors
;;; returned 0 / "" here, which reads as a valid number or an empty symbol and
;;; turns a type confusion into wrong output somewhere far away.
(defn sexp-wrong-variant [T] [(site (ptr i8))] (-> T)
  (oom-puts c"coil.reader: ")
  (oom-puts site)
  (oom-puts c"\n")
  (abort)
  (primitive/zeroed T))

; So a consumer never has to `match` on `SexpKind` for the ordinary questions.
; The compiler matches directly (it cares about all eight variants); everyone else
; wants these. A `?`-predicate is false for the wrong variant rather than an error,
; but the EXTRACTORS take `(ptr Sexp)` you have already tested — asking for the
; symbol of a number is a caller bug, so they hard-error instead of returning a
; sentinel that would silently read as valid data (an empty string, a 0).
(defn sexp-int? [(x (ptr Sexp))] (-> bool)
  (match (load (field x kind)) (KInt [_] true) (_ false)))

(defn sexp-float? [(x (ptr Sexp))] (-> bool)
  (match (load (field x kind)) (KFloat [_] true) (_ false)))

(defn sexp-sym? [(x (ptr Sexp))] (-> bool)
  (match (load (field x kind)) (KSym [_] true) (_ false)))

(defn sexp-kw? [(x (ptr Sexp))] (-> bool)
  (match (load (field x kind)) (KKw [_] true) (_ false)))

(defn sexp-str? [(x (ptr Sexp))] (-> bool)
  (match (load (field x kind)) (KStr [_] true) (_ false)))

(defn sexp-list? [(x (ptr Sexp))] (-> bool)
  (match (load (field x kind)) (KList [_] true) (_ false)))

(defn sexp-vec? [(x (ptr Sexp))] (-> bool)
  (match (load (field x kind)) (KVec [_] true) (_ false)))

(defn sexp-int [(x (ptr Sexp))] (-> i64)
  (match (load (field x kind))
    (KInt [v] v)
    (_ (sexp-wrong-variant c"sexp-int: not an integer (test with sexp-int? first)"))))

(defn sexp-sym [(x (ptr Sexp))] (-> (slice u8))
  (match (load (field x kind))
    (KSym [s] s)
    (_ (sexp-wrong-variant c"sexp-sym: not a symbol (test with sexp-sym? first)"))))

(defn sexp-str [(x (ptr Sexp))] (-> (slice u8))
  (match (load (field x kind))
    (KStr [s] s)
    (_ (sexp-wrong-variant c"sexp-str: not a string (test with sexp-str? first)"))))

(defn sexp-kw [(x (ptr Sexp))] (-> (slice u8))
  (match (load (field x kind))
    (KKw [s] s)
    (_ (sexp-wrong-variant c"sexp-kw: not a keyword (test with sexp-kw? first)"))))

;;; The children of a list OR a vector — `(f x)` and `[f x]` both have two.
(defn sexp-items [(x (ptr Sexp))] (-> (ptr (ArrayList Sexp)))
  (match (load (field x kind))
    (KList [items] items)
    (KVec [items] items)
    (_ (sexp-wrong-variant c"sexp-items: not a list or vector"))))

;;; Number of children; 0 for an atom, so it is safe to call on anything.
(defn sexp-count [(x (ptr Sexp))] (-> i64)
  (if (or (sexp-list? x) (sexp-vec? x)) (al-len [Sexp] (load (sexp-items x))) 0))

;;; Child i as a pointer INTO the list — valid while the list is unmodified.
(defn sexp-nth [(x (ptr Sexp)) (i i64)] (-> (ptr Sexp))
  (al-elem [Sexp] (sexp-items x) i))

;;; The common dispatch test: this node is the symbol `lit`.
(defn sexp-sym-is [(x (ptr Sexp)) (lit (slice u8))] (-> bool)
  (and (sexp-sym? x) (= (sexp-sym x) lit)))

; ============================ canonical dump entry ==========================
; Emits the `(error@source:lo:hi:ctxt "msg")` shape on a read/parse error.
