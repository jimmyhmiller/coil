(module coil.str)
(import "coil.primitive" :as primitive)
; Strings are `(slice u8)` VIEWS (UTF-8 bytes) — see src/stdlib/slice.coil. A `"…"`
; literal is one, borrowing static bytes. These are the content operations over
; that view: equality, hashing, search, and an allocator-aware concatenation.
; Owned, growable strings are `StrBuf` (a library over ArrayList<u8>) at the
; bottom of this file. Nothing here is compiler magic — it is all library over
; the core `(slice u8)` type, the allocator value, and src/stdlib/mem.
;
;   (import "coil.str" :use *) (import "coil.slice" :use *)

(import "coil.slice" :use *)  ; slice-len/data/get, subslice, slice-new
(import "coil.mem" :use *)  ; mem-eql, mem-copy
(import "coil.result" :use *)  ; Option/Some/None for find / fallible alloc
(import "coil.alloc" :as alloc :use *)  ; Allocator, raw-alloc — for concat / StrBuf
(import "coil.arraylist" :use *)  ; ArrayList — owned StrBuf is a library over it
(import "coil.hashmap" :use *)  ; KeyOps — for str-keyops (string-keyed maps)

; ---- validated UTF-8 text --------------------------------------------------
;; `StringView` is a borrowed, immutable view of valid UTF-8. `String` owns a
;; growable UTF-8 buffer and follows ArrayList's explicit allocator/free model.
;; Existing `(slice u8)` string APIs remain below for compatibility and for code
;; that deliberately treats text as bytes.
(defstruct StringView [(raw (slice u8))])
(defstruct String [(bytes (ArrayList u8))])
(defstruct Rune [(value u32)])
(defstruct StringIndex [(byte_offset i64)])
(defstruct Utf8Error [(offset i64) (error_len i64)])

(defn rune-value [(r Rune)] (-> u32)
  (.value r))
(defn string-index-byte-offset [(index StringIndex)] (-> i64)
  (.byte_offset index))
(defn utf8-error-offset [(error Utf8Error)] (-> i64)
  (.offset error))
(defn utf8-error-len [(error Utf8Error)] (-> i64)
  (.error_len error))

;; `(sv "literal")` constructs a StringView without runtime validation. The reader
;; has already guaranteed that an ordinary literal is valid UTF-8. Requiring a
;; literal keeps this convenience from becoming an unchecked arbitrary-byte cast.
(defn sv [(literal Code)] (-> Code)
  (if (primitive/code-string? literal)
      `(coil.str.string-view-unchecked ~literal)
      (primitive/error "sv: expected a string literal")))

(defn utf8-cont? [(b u8)] (-> bool)
  (let [v (primitive/cast i64 b)]
    (and (>= v (cast i64 128)) (<= v (cast i64 191)))))

;; Validate one complete UTF-8 buffer. The error offset identifies the first
;; invalid leading byte (or truncated sequence); error_len is currently one.
(defn string-view-from-utf8 [(bytes (slice u8))] (-> (Result StringView Utf8Error))
  (let [n (slice-len bytes)
        (mut i) 0
        (mut bad) -1]
    (loop (if (>= (load i) n)
              (break)
              (let [b0 (primitive/cast i64 (slice-get bytes (load i)))]
                (if (<= b0 (cast i64 127))
                    (store! i (primitive/iadd (load i) 1))
                    (if (and (>= b0 (cast i64 194)) (<= b0 (cast i64 223)))
                        (if (and (< (primitive/iadd (load i) 1) n)
                                 (utf8-cont? (slice-get bytes (primitive/iadd (load i) 1))))
                            (store! i (primitive/iadd (load i) 2))
                            (do (store! bad (load i)) (break)))
                        (if (and (>= b0 (cast i64 224)) (<= b0 (cast i64 239)))
                            (if (>= (primitive/iadd (load i) 2) n)
                                (do (store! bad (load i)) (break))
                                (let [b1 (primitive/cast i64 (slice-get bytes (primitive/iadd (load i) 1)))
                                      b2 (slice-get bytes (primitive/iadd (load i) 2))
                                      second-ok
                                        (if (= b0 (cast i64 224))
                                            (and (>= b1 (cast i64 160)) (<= b1 (cast i64 191)))
                                            (if (= b0 (cast i64 237))
                                                (and (>= b1 (cast i64 128)) (<= b1 (cast i64 159)))
                                                (and (>= b1 (cast i64 128)) (<= b1 (cast i64 191)))))]
                                  (if (and second-ok (utf8-cont? b2))
                                      (store! i (primitive/iadd (load i) 3))
                                      (do (store! bad (load i)) (break)))))
                            (if (and (>= b0 (cast i64 240)) (<= b0 (cast i64 244)))
                                (if (>= (primitive/iadd (load i) 3) n)
                                    (do (store! bad (load i)) (break))
                                    (let [b1 (primitive/cast i64 (slice-get bytes (primitive/iadd (load i) 1)))
                                          b2 (slice-get bytes (primitive/iadd (load i) 2))
                                          b3 (slice-get bytes (primitive/iadd (load i) 3))
                                          second-ok
                                            (if (= b0 (cast i64 240))
                                                (and (>= b1 (cast i64 144)) (<= b1 (cast i64 191)))
                                                (if (= b0 (cast i64 244))
                                                    (and (>= b1 (cast i64 128)) (<= b1 (cast i64 143)))
                                                    (and (>= b1 (cast i64 128)) (<= b1 (cast i64 191)))))]
                                      (if (and second-ok (and (utf8-cont? b2) (utf8-cont? b3)))
                                          (store! i (primitive/iadd (load i) 4))
                                          (do (store! bad (load i)) (break)))))
                                (do (store! bad (load i)) (break)))))))))
    (if (>= (load bad) (cast i64 0))
        (Err (Utf8Error :offset (load bad) :error_len 1))
        (Ok (StringView :raw bytes)))))

;; Trusted constructor for literals and buffers already validated by construction.
(defn string-view-unchecked [(bytes (slice u8))] (-> StringView)
  (StringView :raw bytes))

(defn string-view-bytes [(text StringView)] (-> (slice u8))
  (load (field text raw)))
(defn string-view-byte-len [(text StringView)] (-> i64)
  (slice-len (string-view-bytes text)))
(defn string-view-empty? [(text StringView)] (-> bool)
  (= (string-view-byte-len text) (cast i64 0)))

(defn string-view-start [(text StringView)] (-> StringIndex)
  (StringIndex :byte_offset 0))
(defn string-view-end [(text StringView)] (-> StringIndex)
  (StringIndex :byte_offset (string-view-byte-len text)))

(defn string-index-at-byte [(text StringView) (offset i64)] (-> (Option StringIndex))
  (let [n (string-view-byte-len text)]
    (if (or (< offset (cast i64 0)) (> offset n))
        (None)
        (if (or (= offset n)
                (not (utf8-cont? (slice-get (string-view-bytes text) offset))))
            (Some (StringIndex :byte_offset offset))
            (None)))))

(defn string-view-slice [(text StringView) (lo StringIndex) (hi StringIndex)] (-> StringView)
  (string-view-unchecked (subslice (string-view-bytes text)
                                   (load (field lo byte_offset))
                                   (load (field hi byte_offset)))))

(defn string-view-next-rune-index [(text StringView) (index StringIndex)] (-> (Option StringIndex))
  (let [offset (string-index-byte-offset index)
        n (string-view-byte-len text)]
    (if (>= offset n)
        (None)
        (Some (StringIndex :byte_offset
                             (primitive/iadd offset
                                             (utf8-scalar-width (slice-get (string-view-bytes text) offset))))))))

(defn string-view-starts-with? [(text StringView) (prefix StringView)] (-> bool)
  (starts-with (string-view-bytes text) (string-view-bytes prefix)))

(defn string-view-ends-with? [(text StringView) (suffix StringView)] (-> bool)
  (let [n (string-view-byte-len text)
        m (string-view-byte-len suffix)]
    (and (<= m n)
         (= (subslice (string-view-bytes text) (primitive/isub n m) n)
            (string-view-bytes suffix)))))

(defn string-view-find [(text StringView) (needle StringView)] (-> (Option StringIndex))
  (match (str-find (string-view-bytes text) (string-view-bytes needle))
    (None [] (None))
    (Some [offset] (Some (StringIndex :byte_offset offset)))))

(defn string-view-contains? [(text StringView) (needle StringView)] (-> bool)
  (match (string-view-find text needle) (None [] false) (Some [_] true)))

(defn string-view-trim-ascii [(text StringView)] (-> StringView)
  (string-view-unchecked (str-trim (string-view-bytes text))))

;; Allocation-free splitting. Each yielded StringView aliases the input. An empty
;; separator yields the entire input once, matching the existing `str-split` rule.
(defstruct StringSplitIter
  [(text StringView) (separator StringView) (offset i64) (done bool)])

(defn string-view-split [(text StringView) (separator StringView)] (-> StringSplitIter)
  (StringSplitIter
    :text text
    :separator separator
    :offset 0
    :done false))

(impl Iterator StringSplitIter
  (next [(it (mut StringSplitIter))]
        (-> (Option StringView))
        (if (load (field it done))
            (None)
            (let [text (load (field it text))
                  separator (load (field it separator))
                  offset (load (field it offset))
                  n (string-view-byte-len text)
                  m (string-view-byte-len separator)]
              (if (= m (cast i64 0))
                  (do (store! (field it done) true) (Some text))
                  (match (str-find (subslice (string-view-bytes text) offset n)
                                   (string-view-bytes separator))
                    (None []
                          (do
                            (store! (field it done) true)
                            (Some (string-view-unchecked (subslice (string-view-bytes text) offset n)))))
                    (Some [relative]
                          (let [found (primitive/iadd offset relative)
                                piece (string-view-unchecked (subslice (string-view-bytes text) offset found))]
                            (store! (field it offset) (primitive/iadd found m))
                            (Some piece)))))))))

(defn rune-valid? [(value u32)] (-> bool)
  (let [v (primitive/cast i64 value)]
    (and (<= v (cast i64 1114111))
         (or (< v (cast i64 55296)) (> v (cast i64 57343))))))

(defn rune-new [(value u32)] (-> (Option Rune))
  (if (rune-valid? value) (Some (Rune :value value)) (None)))

;; Decode at a known scalar boundary in a validated view.
(defn string-view-rune-at [(text StringView) (offset i64)] (-> Rune)
  (let [s (string-view-bytes text)
        b0 (primitive/cast i64 (slice-get s offset))]
    (if (<= b0 (cast i64 127))
        (Rune :value (primitive/cast u32 b0))
        (if (<= b0 (cast i64 223))
            (let [b1 (primitive/cast i64 (slice-get s (primitive/iadd offset 1)))]
              (Rune :value
                      (primitive/cast u32
                                      (primitive/iadd (primitive/imul (primitive/isub b0 192) 64)
                                                      (primitive/isub b1 128)))))
            (if (<= b0 (cast i64 239))
                (let [b1 (primitive/cast i64 (slice-get s (primitive/iadd offset 1)))
                      b2 (primitive/cast i64 (slice-get s (primitive/iadd offset 2)))]
                  (Rune :value
                          (primitive/cast u32
                                          (primitive/iadd (primitive/imul (primitive/isub b0 224) 4096)
                                                          (primitive/iadd (primitive/imul (primitive/isub b1 128) 64)
                                                                          (primitive/isub b2 128))))))
                (let [b1 (primitive/cast i64 (slice-get s (primitive/iadd offset 1)))
                      b2 (primitive/cast i64 (slice-get s (primitive/iadd offset 2)))
                      b3 (primitive/cast i64 (slice-get s (primitive/iadd offset 3)))]
                  (Rune :value
                          (primitive/cast u32
                                          (primitive/iadd (primitive/imul (primitive/isub b0 240) 262144)
                                                          (primitive/iadd (primitive/imul (primitive/isub b1 128) 4096)
                                                                          (primitive/iadd (primitive/imul (primitive/isub b2
                                                                                                                          128)
                                                                                                          64)
                                                                                          (primitive/isub b3 128))))))))))))

(defn utf8-scalar-width [(leading u8)] (-> i64)
  (let [b (primitive/cast i64 leading)]
    (if (<= b (cast i64 127)) 1 (if (<= b (cast i64 223)) 2 (if (<= b (cast i64 239)) 3 4)))))

(defstruct RuneIter [(view StringView) (offset i64)])
(impl Iterable StringView
  (iter [(text StringView)]
        (-> RuneIter)
        (RuneIter :view text :offset 0)))
(impl Iterator RuneIter
  (next [(it (mut RuneIter))]
        (-> (Option Rune))
        (let [offset (load (field it offset))
              text (load (field it view))]
          (if (>= offset (string-view-byte-len text))
              (None)
              (let [r (string-view-rune-at text offset)
                    width (utf8-scalar-width (slice-get (string-view-bytes text) offset))]
                (store! (field it offset) (primitive/iadd offset width))
                (Some r))))))

; ---- owned validated string ------------------------------------------------
(defn string-new [(a (dyn Allocator))] (-> String)
  (String :bytes (al-new [u8] a)))

(defn string-as-view [(text String)] (-> StringView)
  (string-view-unchecked (al-slice [u8] (load (field text bytes)))))

(defn string-from-view [(a (dyn Allocator)) (text StringView)] (-> String)
  (let [(mut out) (string-new a)
        s (string-view-bytes text)]
    (al-extend! [u8] (mut (field out bytes)) (slice-data s) (slice-len s))
    (load out)))

(defn string-from-utf8 [(a (dyn Allocator)) (bytes (slice u8))] (-> (Result String Utf8Error))
  (match (string-view-from-utf8 bytes)
    (Err [error] (Err error))
    (Ok [view] (Ok (string-from-view a view)))))

(defn string-clone [(a (dyn Allocator)) (text String)] (-> String)
  (string-from-view a (string-as-view text)))

(defn string-free! [(text (mut String))] (-> i64)
  (al-free! [u8] (mut (field text bytes))))

(defn string-clear! [(text (mut String))] (-> i64)
  (al-clear! [u8] (mut (field text bytes))))

;; Transfer the allocation to the result and replace `text` with a fresh empty
;; owner using the same allocator. The returned String is the only owner to free.
(defn string-take! [(text (mut String))] (-> String)
  (let [out (load text)
        a (load (field (field text bytes) alc))]
    (store! text (string-new a))
    out))

;; Transfer the allocation as a right-sized byte slice. The caller frees the
;; returned slice with the allocator originally used by this String.
(defn string-into-bytes! [(text (mut String))] (-> (slice u8))
  (al-into-slice [u8] (mut (field text bytes))))

(defn string-byte-len [(text String)] (-> i64)
  (al-len [u8] (load (field text bytes))))

(defn string-capacity [(text String)] (-> i64)
  (al-cap [u8] (load (field text bytes))))

(defn string-reserve! [(text (mut String)) (capacity i64)] (-> i64)
  (al-reserve! [u8] (mut (field text bytes)) capacity))

(defn string-truncate! [(text (mut String)) (end StringIndex)] (-> i64)
  (let [offset (string-index-byte-offset end)]
    (if (> offset (string-byte-len (load text)))
        -1
        (do
          (store! (field (field text bytes) len) offset)
          offset))))

(defn string-remove! [(text (mut String)) (lo StringIndex) (hi StringIndex)] (-> i64)
  (let [start (string-index-byte-offset lo)
        end (string-index-byte-offset hi)
        n (string-byte-len (load text))]
    (if (or (< start (cast i64 0)) (or (> end n) (> start end)))
        -1
        (let [(mut source) end
              (mut destination) start]
          (loop (if (>= (load source) n)
                    (break)
                    (do
                      (al-set! [u8]
                               (mut (field text bytes))
                               (load destination)
                               (al-get [u8] (load (field text bytes)) (load source)))
                      (store! source (+ (load source) 1))
                      (store! destination (+ (load destination) 1)))))
          (store! (field (field text bytes) len) (load destination))
          (load destination)))))

(defn string-pop-rune! [(text (mut String))] (-> (Option Rune))
  (let [n (string-byte-len (load text))]
    (if (= n (cast i64 0))
        (None)
        (let [(mut start) (- n 1)
              bytes (al-slice [u8] (load (field text bytes)))]
          (loop (if (and (> (load start) (cast i64 0))
                         (utf8-cont? (slice-get bytes (load start))))
                    (store! start (- (load start) 1))
                    (break)))
          (let [rune (string-view-rune-at (string-view-unchecked bytes) (load start))]
            (store! (field (field text bytes) len) (load start))
            (Some rune))))))

(defn string-push-view! [(text (mut String)) (suffix StringView)] (-> i64)
  (let [s (string-view-bytes suffix)]
    (al-extend! [u8] (mut (field text bytes)) (slice-data s) (slice-len s))))

(defn string-push-rune! [(text (mut String)) (r Rune)] (-> i64)
  (let [v (primitive/cast i64 (load (field r value)))]
    (if (<= v (cast i64 127))
        (al-push! [u8] (mut (field text bytes)) (primitive/cast u8 v))
        (if (<= v (cast i64 2047))
            (do
              (al-push! [u8] (mut (field text bytes)) (primitive/cast u8 (primitive/iadd 192 (primitive/udiv v 64))))
              (al-push! [u8] (mut (field text bytes)) (primitive/cast u8 (primitive/iadd 128 (primitive/urem v 64)))))
            (if (<= v (cast i64 65535))
                (do
                  (al-push! [u8]
                            (mut (field text bytes))
                            (primitive/cast u8 (primitive/iadd 224 (primitive/udiv v 4096))))
                  (al-push! [u8]
                            (mut (field text bytes))
                            (primitive/cast u8 (primitive/iadd 128 (primitive/urem (primitive/udiv v 64) 64))))
                  (al-push! [u8]
                            (mut (field text bytes))
                            (primitive/cast u8 (primitive/iadd 128 (primitive/urem v 64)))))
                (do
                  (al-push! [u8]
                            (mut (field text bytes))
                            (primitive/cast u8 (primitive/iadd 240 (primitive/udiv v 262144))))
                  (al-push! [u8]
                            (mut (field text bytes))
                            (primitive/cast u8 (primitive/iadd 128 (primitive/urem (primitive/udiv v 4096) 64))))
                  (al-push! [u8]
                            (mut (field text bytes))
                            (primitive/cast u8 (primitive/iadd 128 (primitive/urem (primitive/udiv v 64) 64))))
                  (al-push! [u8]
                            (mut (field text bytes))
                            (primitive/cast u8 (primitive/iadd 128 (primitive/urem v 64))))))))))

(deftrait TextWrite [Self]
  (write-view! [(out (mut Self)) (text StringView)] (-> i64))
  (write-rune! [(out (mut Self)) (rune Rune)] (-> i64)))
(impl TextWrite String
  (write-view! [(out (mut String)) (text StringView)]
               (-> i64)
               (string-push-view! (mut out) text))
  (write-rune! [(out (mut String)) (rune Rune)]
               (-> i64)
               (string-push-rune! (mut out) rune)))

(deftrait Text [Self]
  (as-string-view [(text Self)] (-> StringView)))
(impl Text StringView
  (as-string-view [(text StringView)] (-> StringView) text))
(impl Text String
  (as-string-view [(text String)] (-> StringView) (string-as-view text)))

(impl Eq StringView
  (= [(a StringView) (b StringView)]
     (-> bool)
     (str-eq (string-view-bytes a) (string-view-bytes b))))
(impl Ord StringView
  (< [(a StringView) (b StringView)] (-> bool) (< (str-cmp (string-view-bytes a) (string-view-bytes b)) (cast i64 0)))
  (<= [(a StringView) (b StringView)] (-> bool) (<= (str-cmp (string-view-bytes a) (string-view-bytes b)) (cast i64 0)))
  (> [(a StringView) (b StringView)] (-> bool) (> (str-cmp (string-view-bytes a) (string-view-bytes b)) (cast i64 0)))
  (>= [(a StringView) (b StringView)] (-> bool) (>= (str-cmp (string-view-bytes a) (string-view-bytes b)) (cast i64 0))))
(impl Hash StringView
  (hash [(text StringView)] (-> i64) (str-hash (string-view-bytes text))))
(impl Eq String
  (= [(a String) (b String)] (-> bool) (= (string-as-view a) (string-as-view b))))
(impl Ord String
  (< [(a String) (b String)] (-> bool) (< (string-as-view a) (string-as-view b)))
  (<= [(a String) (b String)] (-> bool) (<= (string-as-view a) (string-as-view b)))
  (> [(a String) (b String)] (-> bool) (> (string-as-view a) (string-as-view b)))
  (>= [(a String) (b String)] (-> bool) (>= (string-as-view a) (string-as-view b))))
(impl Hash String
  (hash [(text String)] (-> i64) (hash (string-as-view text))))
(impl Iterable String
  (iter [(text String)] (-> RuneIter) (iter (string-as-view text))))
(impl Push String
  (push! [(text (mut String)) (r Rune)] (-> i64) (string-push-rune! (mut text) r)))

; ---- the everyday view operations -----------------------------------------
(defn str-len [(s (slice u8))] (-> i64)
  (slice-len s))
(defn char-at [(s (slice u8)) (i :i64)] (-> :u8)
  (slice-get s i))
(defn substr [(s (slice u8)) (lo :i64) (hi :i64)] (-> (slice u8))
  (subslice s lo hi))

; ---- C-string bridge -------------------------------------------------------
;; FFI hands back NUL-terminated `(ptr i8)` strings; the everyday Coil string is a
;; length-carrying `(slice u8)`. These convert between the two. `cstr-len` scans to
;; the terminator (no libc `strlen` extern, so importing this module never collides
;; with io.coil's `strlen` declaration).
(defn cstr-len [(p (ptr i8))] (-> :i64)
  (let [(mut i) 0]
    (loop (if (= (primitive/cast :i64 (load (primitive/index p (load i)))) (cast i64 0))
              (break)
              (store! i (primitive/iadd (load i) 1))))
    (load i)))
;; A `(slice u8)` VIEW over a C string's bytes (excludes the NUL) — no copy, aliases
;; the C storage.
(defn cstr->str [(p (ptr i8))] (-> (slice u8))
  (slice-new (primitive/cast (ptr u8) p) (cstr-len p)))
;; A freshly-allocated NUL-terminated copy of `s` (what a C API wants). The result
;; owns its `len+1` bytes; free it with the same allocator. Null on OOM (the same
;; descriptive-not-safe contract as `unwrap-ptr`/`box`).
(defn str->cstr [(a (dyn Allocator)) (s (slice u8))] (-> (ptr i8))
  (let [n (slice-len s)]
    (match (alloc-bytes a (primitive/iadd n 1) 1)
      (None [] (primitive/cast (ptr i8) 0))
      (Some [memory]
            (let [p (primitive/cast (ptr i8) (slice-data memory))]
              (do
                (mem-copy [u8] (primitive/cast (ptr u8) p) (slice-data s) n)
                (store! (primitive/index p n) (primitive/cast i8 0))
                p))))))

;; Content equality: same length and same bytes.
(defn str-eq [(a (slice u8)) (b (slice u8))] (-> bool)
  (let [la (slice-len a)]
    (if (!= la (slice-len b))
        false
        (mem-eql [u8] (slice-data a) (slice-data b) la))))

;; FNV-1a over the bytes (matches src/stdlib/hashmap's bytewise-hash, so a content hash).
(defn str-hash [(s (slice u8))] (-> :i64)
  (let [(mut h) -3750763034362895579  ; FNV-1a offset basis
        (mut i) 0
        n (slice-len s)]
    (loop (if (>= (load i) n)
              (break)
              (do
                (store! h
                        (primitive/imul (primitive/ixor (load h) (primitive/cast :i64 (slice-get s (load i))))
                                        1099511628211))
                (store! i (primitive/iadd (load i) 1)))))
    (load h)))

;; Lexicographic byte comparison: negative if a<b, 0 if equal, positive if a>b.
;; Compares byte-by-byte over the shared prefix, then breaks the tie by length —
;; the ordering `str-eq`/`str-hash` are the equality/hash for, and what the `Ord`
;; impl below (so `<`/`sort` on strings) is built over.
(defn str-cmp [(a (slice u8)) (b (slice u8))] (-> :i64)
  (let [la (slice-len a)
        lb (slice-len b)
        n (if (< la lb) la lb)
        (mut i) 0
        (mut d) 0]
    (loop (if (>= (load i) n)
              (break)
              (let [ca (primitive/cast :i64 (slice-get a (load i)))
                    cb (primitive/cast :i64 (slice-get b (load i)))]
                (if (!= ca cb)
                    (do (store! d (primitive/isub ca cb)) (break))
                    (store! i (primitive/iadd (load i) 1))))))
    (if (!= (load d) (cast i64 0)) (load d) (primitive/isub la lb))))

(defn starts-with [(s (slice u8)) (prefix (slice u8))] (-> bool)
  (let [lp (slice-len prefix)]
    (if (> lp (slice-len s))
        false
        (= (subslice s 0 lp) prefix))))

;; First index of `needle` in `hay`, or `(None)` — tail-recursive (TCO'd to a loop).
(defn str-find-from [(hay (slice u8)) (needle (slice u8)) (i :i64)] (-> (Option :i64))
  (if (> (primitive/iadd i (slice-len needle)) (slice-len hay))
      (None)
      (if (= (subslice hay i (primitive/iadd i (slice-len needle))) needle)
          (Some i)
          (str-find-from hay needle (primitive/iadd i 1)))))
(defn str-find [(hay (slice u8)) (needle (slice u8))] (-> (Option :i64))
  (str-find-from hay needle 0))

; ---- trimming, parsing, splitting ------------------------------------------
;; ASCII whitespace test (space, tab, newline, carriage return, vertical tab, form feed).
(defn str-ws? [(b :u8)] (-> bool)
  (let [c (primitive/cast :i64 b)]
    (any (= c (cast i64 \space))
         (= c (cast i64 \tab))
         (= c (cast i64 \newline))
         (= c (cast i64 \return))
         (= c (cast i64 11))
         (= c (cast i64 \formfeed)))))

;; A VIEW with leading/trailing ASCII whitespace removed (no copy; shares storage).
(defn str-trim [(s (slice u8))] (-> (slice u8))
  (let [(mut lo) 0
        (mut hi) (slice-len s)]
    (loop (if (and (< (load lo) (load hi)) (str-ws? (slice-get s (load lo))))
              (store! lo (primitive/iadd (load lo) 1))
              (break)))
    (loop (if (and (< (load lo) (load hi)) (str-ws? (slice-get s (primitive/isub (load hi) 1))))
              (store! hi (primitive/isub (load hi) 1))
              (break)))
    (subslice s (load lo) (load hi))))

;; Parse a base-10 signed integer, `(Some n)` or `(None)` on any non-digit / empty /
;; lone-sign input. No allocation, no overflow check (wraps like the metal `imul`).
(defn str-parse-int [(s (slice u8))] (-> (Option :i64))
  (let [n (slice-len s)]
    (if (= n (cast i64 0))
        (None)
        (let [neg (= (primitive/cast :i64 (slice-get s 0)) (cast i64 45))  ; 45 = '-'
              (mut i) (if neg 1 0)
              (mut acc) 0
              (mut ok) (< (if neg 1 0) n)]  ; a lone "-" is invalid
          (loop (if (>= (load i) n)
                    (break)
                    (let [c (primitive/cast :i64 (slice-get s (load i)))]
                      (if (and (>= c (cast i64 \0)) (<= c (cast i64 \9)))
                          (do
                            (store! acc (primitive/iadd (primitive/imul (load acc) 10) (primitive/isub c \0)))
                            (store! i (primitive/iadd (load i) 1)))
                          (do (store! ok false) (break))))))
          (if (load ok)
              (Some (if neg (primitive/isub 0 (load acc)) (load acc)))
              (None))))))

;; Split `s` on every (non-overlapping) occurrence of `sep`, returning an
;; `(ArrayList (slice u8))` of the pieces (each a VIEW into `s`). An empty `sep`
;; yields the whole string as one piece. The caller owns the list — `al-free!` it
;; (the piece slices alias `s`, so `s` must outlive them). Allocator-aware.
(defn str-split [(a (dyn Allocator)) (s (slice u8)) (sep (slice u8))] (-> (ArrayList (slice u8)))
  (let [(mut out) (al-new [(slice u8)] a)
        sl (slice-len sep)
        n (slice-len s)]
    (if (= sl (cast i64 0))
        (do (al-push! (mut out) s) 0)
        (let [(mut start) 0]
          (loop (match (str-find (subslice s (load start) n) sep)
                  (None []
                        (do (al-push! (mut out) (subslice s (load start) n)) (break)))
                  (Some [rel]
                        (let [idx (primitive/iadd (load start) rel)]
                          (al-push! (mut out) (subslice s (load start) idx))
                          (store! start (primitive/iadd idx sl))))))))
    (load out)))

;; Concatenate into freshly-allocated bytes; `(None)` on OOM. The result owns its
;; buffer (allocated from `a`); free it with the same allocator when done.
(defn str-concat [(a (dyn Allocator)) (x (slice u8)) (y (slice u8))] (-> (Option (slice u8)))
  (let [lx (slice-len x)
        ly (slice-len y)]
    (match (alloc [u8] a (primitive/iadd lx ly))
      (None [] (None))
      (Some [memory]
            (let [p (slice-data memory)]
              (mem-copy [u8] p (slice-data x) lx)
              (mem-copy [u8] (primitive/index p lx) (slice-data y) ly)
              (Some memory))))))

; ---- string-keyed HashMap: a KeyOps whose hash/eq read the slice's bytes ----
;; The map stores the (slice u8) key value in its slot; these deref that slot to
;; the fat pointer, then hash/compare the pointed-to CONTENT (not the 16 raw bytes
;; of the fat pointer, which would compare addresses).
(defn str-key-hash [(slot (ptr i8)) (n :i64)] (-> :i64)
  (str-hash (load (primitive/cast (ptr (slice u8)) slot))))
(defn str-key-eq [(a (ptr i8)) (b (ptr i8)) (n :i64)] (-> bool)
  (= (load (primitive/cast (ptr (slice u8)) a)) (load (primitive/cast (ptr (slice u8)) b))))

;; std-3 — take ownership of a string key IN PLACE: read the (borrowed) slice at
;; `slot`, allocate a private copy of its bytes from `a`, and overwrite the slot with
;; a slice VIEW onto that owned copy. An empty key needs no storage (its data pointer
;; is never dereferenced — str-eq/str-hash short-circuit on length 0), so it is left
;; as-is. OOM aborts (the same descriptive-not-safe contract as the rest of src/stdlib/str).
(defn str-key-copy [(ap (ptr (dyn Allocator))) (slot (ptr i8))] (-> :i64)
  (let [s (load (primitive/cast (ptr (slice u8)) slot))
        n (slice-len s)
        a (load ap)]
    (if (> n (cast i64 0))
        (match (alloc [u8] a n)
          (None [] (oom-at c"str-key-copy" n))
          (Some [memory]
                (do
                  (mem-copy [u8] (slice-data memory) (slice-data s) n)
                  (store! (primitive/cast (ptr (slice u8)) slot) memory)
                  0)))
        0)
    0))
;; Release an owned string key's bytes. Mirrors str-key-copy: an empty key owns no
;; storage, so it is skipped (never frees the borrowed pointer of a length-0 slice).
(defn str-key-free [(ap (ptr (dyn Allocator))) (slot (ptr i8))] (-> :i64)
  (let [s (load (primitive/cast (ptr (slice u8)) slot))
        n (slice-len s)]
    (if (> n (cast i64 0))
        (free [u8] (load ap) s)
        0)))

;; The default string KeyOps now OWNS its keys (std-3): every inserted key is copied
;; into the map's allocator and freed on remove/clear/free, so a key never aliases
;; caller storage. This is the safe default — reach for `str-keyops-borrowed` only
;; when you can guarantee the key bytes outlive the map (e.g. static literals).
(defn str-keyops [] (-> (ptr KeyOps))
  (let [o (primitive/alloc-static KeyOps)]
    (store! (field o hash) (primitive/fnptr-of str-key-hash))
    (store! (field o eq) (primitive/fnptr-of str-key-eq))
    (store! (field o size) (primitive/sizeof (slice u8)))
    (store! (field o copy) (primitive/fnptr-of str-key-copy))
    (store! (field o free) (primitive/fnptr-of str-key-free))
    (store! (field o owns) 1)
    o))

;; OPT-IN, UNSAFE: keys are BORROWED — the map stores the (slice u8) view verbatim
;; and never copies or frees the pointed-to bytes. The caller MUST guarantee every
;; key's storage outlives the map and is not mutated for the map's lifetime; two keys
;; built over one reused buffer will alias (the std-3 footgun). Correct for keys that
;; are static literals or otherwise pinned. `copy`/`free`/`owns` are left zero (the
;; alloc-static zero-init), so `ko-owns?` is false and no ownership hook ever runs.
(defn str-keyops-borrowed [] (-> (ptr KeyOps))
  (let [o (primitive/alloc-static KeyOps)]
    (store! (field o hash) (primitive/fnptr-of str-key-hash))
    (store! (field o eq) (primitive/fnptr-of str-key-eq))
    (store! (field o size) (primitive/sizeof (slice u8)))
    o))

; ---- validated text HashMap keys -------------------------------------------
(defn string-view-key-hash [(slot (ptr i8)) (n i64)] (-> i64)
  (hash (load (primitive/cast (ptr StringView) slot))))
(defn string-view-key-eq [(a (ptr i8)) (b (ptr i8)) (n i64)] (-> bool)
  (= (load (primitive/cast (ptr StringView) a))
     (load (primitive/cast (ptr StringView) b))))
(defn string-view-key-copy [(allocator (ptr (dyn Allocator))) (slot (ptr i8))] (-> i64)
  (let [target (primitive/cast (ptr StringView) slot)
        view (load target)
        bytes (string-view-bytes view)
        n (slice-len bytes)]
    (if (= n (cast i64 0))
        0
        (match (alloc [u8] (load allocator) n)
          (None [] (oom-at c"string-view-key-copy" n))
          (Some [memory]
                (do
                  (mem-copy [u8] (slice-data memory) (slice-data bytes) n)
                  (store! target (string-view-unchecked memory))
                  0))))))
(defn string-view-key-free [(allocator (ptr (dyn Allocator))) (slot (ptr i8))] (-> i64)
  (let [view (load (primitive/cast (ptr StringView) slot))
        bytes (string-view-bytes view)]
    (if (= (slice-len bytes) (cast i64 0))
        0
        (free [u8] (load allocator) bytes))))

;; Safe default: copy each view's bytes into map-owned storage.
(defn string-view-keyops [] (-> (ptr KeyOps))
  (let [ops (primitive/alloc-static KeyOps)]
    (store! (field ops hash) (primitive/fnptr-of string-view-key-hash))
    (store! (field ops eq) (primitive/fnptr-of string-view-key-eq))
    (store! (field ops size) (primitive/sizeof StringView))
    (store! (field ops copy) (primitive/fnptr-of string-view-key-copy))
    (store! (field ops free) (primitive/fnptr-of string-view-key-free))
    (store! (field ops owns) 1)
    ops))

(defn string-view-keyops-borrowed [] (-> (ptr KeyOps))
  (let [ops (primitive/alloc-static KeyOps)]
    (store! (field ops hash) (primitive/fnptr-of string-view-key-hash))
    (store! (field ops eq) (primitive/fnptr-of string-view-key-eq))
    (store! (field ops size) (primitive/sizeof StringView))
    ops))

(defn string-key-hash [(slot (ptr i8)) (n i64)] (-> i64)
  (hash (load (primitive/cast (ptr String) slot))))
(defn string-key-eq [(a (ptr i8)) (b (ptr i8)) (n i64)] (-> bool)
  (= (load (primitive/cast (ptr String) a))
     (load (primitive/cast (ptr String) b))))
(defn string-key-copy [(allocator (ptr (dyn Allocator))) (slot (ptr i8))] (-> i64)
  (let [target (primitive/cast (ptr String) slot)]
    (store! target (string-from-view (load allocator) (string-as-view (load target))))
    0))
(defn string-key-free [(allocator (ptr (dyn Allocator))) (slot (ptr i8))] (-> i64)
  (string-free! (primitive/cast (ptr String) slot)))

;; A map of owned String keys clones each key into the map allocator. The caller
;; still owns and frees the String value passed to hm-put!.
(defn string-keyops-owned [] (-> (ptr KeyOps))
  (let [ops (primitive/alloc-static KeyOps)]
    (store! (field ops hash) (primitive/fnptr-of string-key-hash))
    (store! (field ops eq) (primitive/fnptr-of string-key-eq))
    (store! (field ops size) (primitive/sizeof String))
    (store! (field ops copy) (primitive/fnptr-of string-key-copy))
    (store! (field ops free) (primitive/fnptr-of string-key-free))
    (store! (field ops owns) 1)
    ops))

; ---- owned, growable string: a LIBRARY over ArrayList<u8> ------------------
;; `StrBuf` is just an `(ArrayList u8)`; appending pushes bytes, and `sb-str` hands
;; back a `(slice u8)` VIEW over the current contents (no copy, invalidated by a
;; later growth that moves the buffer — same contract as al-slice).
(defstruct StrBuf [(bytes (ArrayList u8))])

(defn sb-new [(a (dyn Allocator))] (-> StrBuf)
  (let [(mut sb) (primitive/zeroed StrBuf)]
    (store! (field sb bytes) (al-new [u8] a))
    (load sb)))

;; Append a (slice u8); returns the new length.
(defn sb-push-str! [(sb (mut StrBuf)) (s (slice u8))] (-> :i64)
  (let [(mut i) 0
        n (slice-len s)]
    (loop (if (>= (load i) n)
              (break)
              (do
                (al-push! (mut (field sb bytes)) (slice-get s (load i)))
                (store! i (primitive/iadd (load i) 1)))))
    (al-len (field sb bytes))))

(defn sb-push-byte! [(sb (mut StrBuf)) (b :u8)] (-> :i64)
  (al-push! (mut (field sb bytes)) b))

;; The unsigned magnitude, most significant digit first. Reads the bits as UNSIGNED
;; (udiv/urem), which is what lets `sb-push-i64!` print i64-min without negating it.
(defn sb--udec! [(sb (mut StrBuf)) (n :i64)] (-> :i64)
  (if (= n (cast i64 0))
      0
      (do
        (sb--udec! (mut sb) (primitive/udiv n 10))
        (sb-push-byte! (mut sb) (primitive/cast :u8 (primitive/iadd (primitive/urem n 10) 48))))))

;; Append `v` in decimal; returns the new length. The counterpart of `str-parse-int`,
;; and the way to get a number into a path, a filename, or a child's argv without a
;; Writer — `coil.fmt` only ever prints to one.
;;
;; The sign is emitted separately and the magnitude printed through the unsigned
;; path, never by negating: `(isub 0 i64-min)` wraps back to itself, and a formatter
;; that negates first prints i64-min as `-0`. coil.fmt::print-i carries the same
;; note, and the bug it describes was real.
(defn sb-push-i64! [(sb (mut StrBuf)) (v :i64)] (-> :i64)
  (if (= v (cast i64 0))
      (sb-push-byte! (mut sb) (primitive/cast :u8 48))  ; "0"
      (if (< v (cast i64 0))
          (do
            (sb-push-byte! (mut sb) (primitive/cast :u8 45))  ; '-'
            (sb--udec! (mut sb) (primitive/isub 0 v)))
          (sb--udec! (mut sb) v))))

;; A (slice u8) view over the current contents (shares storage with the StrBuf).
(defn sb-str [(sb StrBuf)] (-> (slice u8))
  (al-slice (field sb bytes)))

(defn sb-free! [(sb (mut StrBuf))] (-> :i64)
  (al-free! (mut (field sb bytes))))

;; Finish building: hand back an OWNING `(slice u8)` shrunk to the exact length, and
;; reset the StrBuf to empty. Unlike `sb-str` (a borrowed view that a later push can
;; invalidate), the returned slice owns a right-sized buffer the caller frees with the
;; same allocator — no use-after-free, no dangling capacity. Over `al-into-slice`.
(defn sb-finish! [(sb (mut StrBuf))] (-> (slice u8))
  (al-into-slice (mut (field sb bytes))))

; ---- the core collection traits (coil.core) ---------------------------------
; Strings are `(slice u8)` — so equality (`=`/`case`), ordering (`< <= > >=`, hence
; `sort`), and hashing (a HashMap key) come from these impls over the byte content.
; (The generic `Len`/`Get`/`Set` for any `(slice T)` live in src/stdlib/slice.coil.)
(impl Eq (slice u8)
  (= [(a (slice u8)) (b (slice u8))] (-> bool) (str-eq a b)))
(impl Ord (slice u8)
  (< [(a (slice u8)) (b (slice u8))] (-> bool) (< (str-cmp a b) (cast i64 0)))
  (<= [(a (slice u8)) (b (slice u8))] (-> bool) (<= (str-cmp a b) (cast i64 0)))
  (> [(a (slice u8)) (b (slice u8))] (-> bool) (> (str-cmp a b) (cast i64 0)))
  (>= [(a (slice u8)) (b (slice u8))] (-> bool) (>= (str-cmp a b) (cast i64 0))))
(impl Hash (slice u8)
  (hash [(x (slice u8))] (-> i64) (str-hash x)))

; A StrBuf is a byte collection: `(len sb)` / `(get sb i)` / `(push! (mut sb) b)`.
; (Strings themselves are (slice u8) — their Len/Get impls are src/stdlib/slice.coil's.)
(impl Len StrBuf
  (len [(sb StrBuf)] (-> i64) (al-len (load (field sb bytes)))))
(impl Get StrBuf
  (get [(sb StrBuf) (i i64)] (-> :u8) (al-get (load (field sb bytes)) i)))
(impl Push StrBuf
  (push! [(sb (mut StrBuf)) (b :u8)] (-> i64) (sb-push-byte! (mut sb) b)))
