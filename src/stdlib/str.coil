(module coil.str)
(import "coil.primitive" :as primitive)

; Strings are `(slice u8)` VIEWS (UTF-8 bytes) — see src/stdlib/slice.coil. A `"…"`
; literal is one, borrowing static bytes. These are the content operations over
; that view: equality and hashing (`=`, `hash`), search (`find`), trimming,
; parsing, splitting, and an allocator-aware concatenation.
; Owned, growable strings are `StrBuf` (a library over ArrayList<u8>) at the
; bottom of this file. Nothing here is compiler magic — it is all library over
; the core `(slice u8)` type, the allocator value, and src/stdlib/mem.
;
;   (import "coil.str" :use *) (import "coil.slice" :use *)
(import "coil.slice" :use *)  ; subslice, SliceIter

(import "coil.mem" :use *)  ; eql, copy

(import "coil.result" :use *)  ; Option/Some/None for find / fallible alloc

(import "coil.alloc" :as alloc :use *)  ; Allocator, raw-alloc — for concat / StrBuf

(import "coil.arraylist" :use *)  ; ArrayList — owned StrBuf is a library over it

(import "coil.hashmap" :use *)  ; KeyOps — for keyops (string-keyed maps)

(import "coil.cc" :as cc)  ; the KeyOps hook types, for the null hooks of borrowed keys

(import "coil.io" :use [Writer IoError])  ; StrBuf::writer: formatting into a StrBuf

(import "coil.fmt" :use [fmt Display display-fmt Debug debug-fmt Formatter])

; Only the public API is exported: the KeyOps callbacks and StrBuf's digit and
; Writer helpers stay private.
(export StringView String Rune StringIndex Utf8Error StringSplitIter RuneIter
        Text as-string-view TextWrite write-view! write-rune!
        StrBuf format!
        sv continuation-byte? scalar-width
        char-at substr starts-with cmp ws? trim parse-int split concat concat3 key-hash
        keyops keyops-borrowed
        length-of-cstr from-cstr to-cstr free-cstr
        keyword-name)

; ---- validated UTF-8 text --------------------------------------------------
;;; `StringView` is a borrowed, immutable view of valid UTF-8. `String` owns a
;;; growable UTF-8 buffer and follows ArrayList's explicit allocator/free model.
;;; The `(slice u8)` string functions below are for code that deliberately treats
;;; text as bytes.
(defstruct StringView [(raw (slice u8))])

(defstruct String [(bytes (ArrayList u8))])

(defstruct Rune [(value u32)])

(defstruct StringIndex [(byte_offset i64)])

(defstruct Utf8Error [(offset i64) (error_len i64)])

(derive Eq Utf8Error)

(impl Rune
  ;;; A Rune for VALUE, or `(None)` when it is not a Unicode scalar value.
  (new [(value u32)] (-> (Option Rune))
    (if (Rune::valid? value) (Some (Rune :value value)) (None)))

  ;;; Is VALUE a Unicode scalar value: at most U+10FFFF and not a surrogate?
  (valid? [(value u32)] (-> bool)
    (let [v (primitive/cast i64 value)]
      (and (<= v 1114111)
           (or (< v 55296) (> v 57343)))))

  (value [(r Rune)] (-> u32)
    (.value r))

  ;;; Write the UTF-8 encoding of `r` (one to four bytes) at `out`, which has room
  ;;; for four, and return how many bytes it took.
  (encode-utf8 [(r Rune) (out (ptr u8))] (-> i64)
    (let [v (primitive/cast i64 (load (field r value)))]
      (cond (<= v 127)
              (do (store! (index out 0) (primitive/cast u8 v)) 1)
            (<= v 2047)
              (do (store! (index out 0) (primitive/cast u8 (primitive/iadd 192 (primitive/udiv v 64))))
                  (store! (index out 1) (primitive/cast u8 (primitive/iadd 128 (primitive/urem v 64))))
                  2)
            (<= v 65535)
              (do (store! (index out 0) (primitive/cast u8 (primitive/iadd 224 (primitive/udiv v 4096))))
                  (store! (index out 1)
                          (primitive/cast u8 (primitive/iadd 128 (primitive/urem (primitive/udiv v 64) 64))))
                  (store! (index out 2) (primitive/cast u8 (primitive/iadd 128 (primitive/urem v 64))))
                  3)
            :else
              (do (store! (index out 0) (primitive/cast u8 (primitive/iadd 240 (primitive/udiv v 262144))))
                  (store! (index out 1)
                          (primitive/cast u8 (primitive/iadd 128 (primitive/urem (primitive/udiv v 4096) 64))))
                  (store! (index out 2)
                          (primitive/cast u8 (primitive/iadd 128 (primitive/urem (primitive/udiv v 64) 64))))
                  (store! (index out 3) (primitive/cast u8 (primitive/iadd 128 (primitive/urem v 64))))
                  4)))))

(impl StringIndex
  (byte-offset [(index StringIndex)] (-> i64)
    (.byte_offset index)))

(impl Utf8Error
  ;;; Where the first invalid leading byte (or truncated sequence) starts.
  (offset [(error Utf8Error)] (-> i64)
    (.offset error))

  ;;; How many bytes the invalid sequence spans; currently always one.
  (error-len [(error Utf8Error)] (-> i64)
    (.error_len error)))

;;; `(sv "literal")` constructs a StringView without runtime validation. The reader
;;; has already guaranteed that an ordinary literal is valid UTF-8. Requiring a
;;; literal keeps this convenience from becoming an unchecked arbitrary-byte cast.
(defn sv [(literal Code)] (-> Code)
  (if (primitive/code-string? literal)
      `(StringView::unchecked ~literal)
      (primitive/error "sv: expected a string literal")))

;;; Is `b` a UTF-8 continuation byte (0b10xxxxxx)?
(defn continuation-byte? [(b u8)] (-> bool)
  (let [v (primitive/cast i64 b)]
    (and (>= v 128) (<= v 191))))

;;; How many bytes the UTF-8 sequence that `leading` starts takes.
(defn scalar-width [(leading u8)] (-> i64)
  (let [b (primitive/cast i64 leading)]
    (if (<= b 127)
        1
        (if (<= b 223) 2 (if (<= b 239) 3 4)))))

;;; Allocation-free splitting. Each yielded StringView aliases the input. An empty
;;; separator yields the entire input once, matching the `split` rule.
(defstruct StringSplitIter
  [(text StringView) (separator StringView) (offset i64) (done bool)])

(impl StringView
  ;;; Validate one complete UTF-8 buffer. The error offset identifies the first
  ;;; invalid leading byte (or truncated sequence); error_len is currently one.
  (from-utf8 [(bytes (slice u8))] (-> (Result StringView Utf8Error))
    (let [n (len bytes)
          (mut i) 0
          (mut bad) -1]
      (loop (if (>= (load i) n)
                (break)
                (let [b0 (primitive/cast i64 (get bytes (load i)))]
                  (if (<= b0 127)
                      (store! i (primitive/iadd (load i) 1))
                      (if (and (>= b0 194) (<= b0 223))
                          (if (and (< (primitive/iadd (load i) 1) n)
                                   (continuation-byte? (get bytes
                                                            (primitive/iadd (load i)
                                                                            1))))
                              (store! i (primitive/iadd (load i) 2))
                              (do (store! bad (load i)) (break)))
                          (if (and (>= b0 224) (<= b0 239))
                              (if (>= (primitive/iadd (load i) 2) n)
                                  (do (store! bad (load i)) (break))
                                  (let [b1
                                          (primitive/cast i64
                                                          (get bytes
                                                               (primitive/iadd (load i)
                                                                               1)))
                                        b2
                                          (get bytes
                                               (primitive/iadd (load i) 2))
                                        second-ok
                                          (if (= b0 224)
                                              (and (>= b1 160)
                                                   (<= b1 191))
                                              (if (= b0 237)
                                                  (and (>= b1 128)
                                                       (<= b1 159))
                                                  (and (>= b1 128)
                                                       (<= b1 191))))]
                                    (if (and second-ok (continuation-byte? b2))
                                        (store! i (primitive/iadd (load i) 3))
                                        (do (store! bad (load i)) (break)))))
                              (if (and (>= b0 240)
                                       (<= b0 244))
                                  (if (>= (primitive/iadd (load i) 3) n)
                                      (do (store! bad (load i)) (break))
                                      (let [b1
                                              (primitive/cast i64
                                                              (get bytes
                                                                   (primitive/iadd (load i)
                                                                                   1)))
                                            b2
                                              (get bytes
                                                   (primitive/iadd (load i)
                                                                   2))
                                            b3
                                              (get bytes
                                                   (primitive/iadd (load i)
                                                                   3))
                                            second-ok
                                              (if (= b0 240)
                                                  (and (>= b1 144)
                                                       (<= b1 191))
                                                  (if (= b0 244)
                                                      (and (>= b1 128)
                                                           (<= b1 143))
                                                      (and (>= b1 128)
                                                           (<= b1 191))))]
                                        (if (and second-ok
                                                 (and (continuation-byte? b2)
                                                      (continuation-byte? b3)))
                                            (store! i (primitive/iadd (load i) 4))
                                            (do (store! bad (load i)) (break)))))
                                  (do (store! bad (load i)) (break)))))))))
      (if (>= (load bad) 0)
          (Err (Utf8Error :offset (load bad) :error_len 1))
          (Ok (StringView :raw bytes)))))

  ;;; Trusted constructor for literals and buffers already validated by construction.
  (unchecked [(bytes (slice u8))] (-> StringView)
    (StringView :raw bytes))

  (bytes [(text StringView)] (-> (slice u8))
    (load (field text raw)))

  (byte-len [(text StringView)] (-> i64)
    (len (bytes text)))

  (empty? [(text StringView)] (-> bool)
    (= (byte-len text) 0))

  (start [(text StringView)] (-> StringIndex)
    (StringIndex :byte_offset 0))

  (end [(text StringView)] (-> StringIndex)
    (StringIndex :byte_offset (byte-len text)))

  ;;; The index of byte `offset` when a scalar value starts there (or it is the end).
  (index-at-byte [(text StringView) (offset i64)] (-> (Option StringIndex))
    (let [n (byte-len text)]
      (if (or (< offset 0) (> offset n))
          (None)
          (if (or (= offset n)
                  (not (continuation-byte? (get (bytes text) offset))))
              (Some (StringIndex :byte_offset offset))
              (None)))))

  (slice [(text StringView) (lo StringIndex) (hi StringIndex)] (-> StringView)
    (StringView::unchecked (subslice (bytes text)
                                     (load (field lo byte_offset))
                                     (load (field hi byte_offset)))))

  (next-rune-index [(text StringView) (index StringIndex)] (-> (Option StringIndex))
    (let [offset (byte-offset index)
          n (byte-len text)]
      (if (>= offset n)
          (None)
          (Some (StringIndex :byte_offset
                               (primitive/iadd offset
                                               (scalar-width (get (bytes text)
                                                                  offset))))))))

  (starts-with? [(text StringView) (prefix StringView)] (-> bool)
    (starts-with (bytes text) (bytes prefix)))

  (ends-with? [(text StringView) (suffix StringView)] (-> bool)
    (let [n (byte-len text)
          m (byte-len suffix)]
      (and (<= m n)
           (= (subslice (bytes text) (primitive/isub n m) n)
              (bytes suffix)))))

  (find [(text StringView) (needle StringView)] (-> (Option StringIndex))
    (match (find (bytes text) (bytes needle))
      (None [] (None))
      (Some [offset] (Some (StringIndex :byte_offset offset)))))

  (contains? [(text StringView) (needle StringView)] (-> bool)
    (match (find text needle) (None [] false) (Some [_] true)))

  (trim-ascii [(text StringView)] (-> StringView)
    (StringView::unchecked (trim (bytes text))))

  ;;; The pieces between occurrences of `separator`, as a StringSplitIter.
  (split [(text StringView) (separator StringView)] (-> StringSplitIter)
    (StringSplitIter
      :text text
      :separator separator
      :offset 0
      :done false))

  ;;; Decode at a known scalar boundary in a validated view.
  (rune-at [(text StringView) (offset i64)] (-> Rune)
    (let [s (bytes text)
          b0 (primitive/cast i64 (get s offset))]
      (if (<= b0 127)
          (Rune :value (primitive/cast u32 b0))
          (if (<= b0 223)
              (let [b1
                      (primitive/cast i64 (get s (primitive/iadd offset 1)))]
                (Rune :value
                        (primitive/cast u32
                                        (primitive/iadd (primitive/imul (primitive/isub b0
                                                                                        192)
                                                                        64)
                                                        (primitive/isub b1 128)))))
              (if (<= b0 239)
                  (let [b1
                          (primitive/cast i64
                                          (get s (primitive/iadd offset 1)))
                        b2
                          (primitive/cast i64
                                          (get s (primitive/iadd offset 2)))]
                    (Rune :value
                            (primitive/cast u32
                                            (primitive/iadd (primitive/imul (primitive/isub b0
                                                                                            224)
                                                                            4096)
                                                            (primitive/iadd (primitive/imul (primitive/isub b1
                                                                                                            128)
                                                                                            64)
                                                                            (primitive/isub b2
                                                                                            128))))))
                  (let [b1
                          (primitive/cast i64
                                          (get s (primitive/iadd offset 1)))
                        b2
                          (primitive/cast i64
                                          (get s (primitive/iadd offset 2)))
                        b3
                          (primitive/cast i64
                                          (get s (primitive/iadd offset 3)))]
                    (Rune :value
                            (primitive/cast u32
                                            (primitive/iadd (primitive/imul (primitive/isub b0
                                                                                            240)
                                                                            262144)
                                                            (primitive/iadd (primitive/imul (primitive/isub b1
                                                                                                            128)
                                                                                            4096)
                                                                            (primitive/iadd (primitive/imul (primitive/isub b2
                                                                                                                            128)
                                                                                                            64)
                                                                                            (primitive/isub b3
                                                                                                            128))))))))))))

  ;;; KeyOps for a map keyed by StringView. The safe default: each key's bytes are
  ;;; copied into map-owned storage.
  (keyops [] (-> (ptr KeyOps))
    (primitive/alloc-static KeyOps
                            (KeyOps :hash (primitive/fnptr-of string-view-key-hash)
                                    :eq (primitive/fnptr-of string-view-key-eq)
                                    :size (primitive/sizeof StringView)
                                    :copy (primitive/fnptr-of string-view-key-copy)
                                    :free (primitive/fnptr-of string-view-key-free)
                                    :owns 1)))

  ;;; KeyOps that borrow each key's bytes, as `keyops-borrowed` does for a
  ;;; `(slice u8)` key: they must outlive the map.
  (keyops-borrowed [] (-> (ptr KeyOps))
    (primitive/alloc-static KeyOps
                            (KeyOps :hash (primitive/fnptr-of string-view-key-hash)
                                    :eq (primitive/fnptr-of string-view-key-eq)
                                    :size (primitive/sizeof StringView)
                                    :copy (primitive/zeroed (fnptr (cc/C) [(ptr (dyn Allocator)) (ptr i8)] i64))
                                    :free (primitive/zeroed (fnptr (cc/C) [(ptr (dyn Allocator)) (ptr i8)] i64))
                                    :owns 0))))

(impl Iterator StringSplitIter
  (next [(it (mut StringSplitIter))]
        (-> (Option StringView))
        (if (load (field it done))
            (None)
            (let [text (load (field it text))
                  separator (load (field it separator))
                  offset (load (field it offset))
                  n (byte-len text)
                  m (byte-len separator)]
              (if (= m 0)
                  (do (store! (field it done) true) (Some text))
                  (match (find (subslice (bytes text) offset n)
                                (bytes separator))
                    (None []
                          (do
                            (store! (field it done) true)
                            (Some (StringView::unchecked (subslice (bytes text)
                                                                   offset
                                                                   n)))))
                    (Some [relative]
                          (let [found (primitive/iadd offset relative)
                                piece
                                  (StringView::unchecked (subslice (bytes text)
                                                                   offset
                                                                   found))]
                            (store! (field it offset) (primitive/iadd found m))
                            (Some piece)))))))))

(defstruct RuneIter [(view StringView) (offset i64)])

(impl Iterable StringView
  (iter [(text StringView)]
        (-> RuneIter)
        (RuneIter :view text :offset 0)))

(impl Iterator RuneIter
  (next [(it (mut RuneIter))]
        (-> (Option Rune))
        (let [offset (load (field it offset))
              text (load (field it view))]
          (if (>= offset (byte-len text))
              (None)
              (let [r (rune-at text offset)
                    width
                      (scalar-width (get (bytes text)
                                         offset))]
                (store! (field it offset) (primitive/iadd offset width))
                (Some r))))))

; ---- owned validated string ------------------------------------------------
(impl String
  (new [(a (dyn Allocator))] (-> String)
    (String :bytes (ArrayList::new [u8] a)))

  (from-view [(a (dyn Allocator)) (text StringView)] (-> String)
    (let [(mut out) (String::new a)
          s (bytes text)]
      (extend! (mut (field out bytes)) (data s) (len s))
      (load out)))

  (from-utf8 [(a (dyn Allocator)) (bytes (slice u8))] (-> (Result String Utf8Error))
    (match (StringView::from-utf8 bytes)
      (Err [error] (Err error))
      (Ok [view] (Ok (String::from-view a view)))))

  ;;; A copy of `text` in storage from `a`.
  (clone [(a (dyn Allocator)) (text String)] (-> String)
    (String::from-view a (as-string-view text)))

  (free! [(text (mut String))] (-> i64)
    (free! (mut (field text bytes))))

  (clear! [(text (mut String))] (-> i64)
    (clear! (mut (field text bytes))))

  ;;; Transfer the allocation to the result and replace `text` with a fresh empty
  ;;; owner using the same allocator. The returned String is the only owner to free.
  ;;; (Core's `take!` moves out of a place and leaves it uninitialized instead.)
  (take-all! [(text (mut String))] (-> String)
    (let [out (load text)
          a (load (field (field text bytes) alc))]
      (store! text (String::new a))
      out))

  ;;; Transfer the allocation as a right-sized byte slice. The caller frees the
  ;;; returned slice with the allocator originally used by this String.
  (into-bytes! [(text (mut String))] (-> (slice u8))
    (into-slice (mut (field text bytes))))

  (byte-len [(text String)] (-> i64)
    (len (load (field text bytes))))

  (capacity [(text String)] (-> i64)
    (cap (load (field text bytes))))

  (reserve! [(text (mut String)) (capacity i64)] (-> i64)
    (reserve! (mut (field text bytes)) capacity))

  ;;; True when `offset` is a scalar boundary of `text`'s current contents.
  (boundary? [(text String) (offset i64)] (-> bool)
    (let [n (byte-len text)]
      (and (>= offset 0)
           (<= offset n)
           (or (= offset n)
               (not (continuation-byte? (get (load (field text bytes)) offset)))))))

  (truncate! [(text (mut String)) (end StringIndex)] (-> i64)
    (let [offset (byte-offset end)]
      (if (not (boundary? (load text) offset))
          -1
          (do
            (store! (field (field text bytes) len) offset)
            offset))))

  (remove! [(text (mut String)) (lo StringIndex) (hi StringIndex)] (-> i64)
    (let [start (byte-offset lo)
          end (byte-offset hi)
          n (byte-len (load text))]
      (if (or (> start end)
              (or (not (boundary? (load text) start))
                  (not (boundary? (load text) end))))
          -1
          (let [(mut source) end
                (mut destination) start]
            (loop (if (>= (load source) n)
                      (break)
                      (do
                        (set! (mut (field text bytes))
                              (load destination)
                              (get (load (field text bytes))
                                   (load source)))
                        (store! source (+ (load source) 1))
                        (store! destination (+ (load destination) 1)))))
            (store! (field (field text bytes) len) (load destination))
            (load destination)))))

  ;;; KeyOps for a map keyed by String: each key is cloned into the map allocator.
  ;;; The caller still owns and frees the String value passed to `set!`.
  (keyops [] (-> (ptr KeyOps))
    (primitive/alloc-static KeyOps
                            (KeyOps :hash (primitive/fnptr-of string-key-hash)
                                    :eq (primitive/fnptr-of string-key-eq)
                                    :size (primitive/sizeof String)
                                    :copy (primitive/fnptr-of string-key-copy)
                                    :free (primitive/fnptr-of string-key-free)
                                    :owns 1))))

(deftrait TextWrite [Self]
  (write-view! [(out (mut Self)) (text StringView)] (-> i64))
  (write-rune! [(out (mut Self)) (rune Rune)] (-> i64)))

(impl TextWrite String
  (write-view! [(out (mut String)) (text StringView)]
               (-> i64)
               (let [s (bytes text)]
                 (extend! (mut (field out bytes)) (data s) (len s))))
  (write-rune! [(out (mut String)) (rune Rune)]
               (-> i64)
               (push! (mut out) rune)))

(deftrait Text [Self]
  (as-string-view [(text Self)] (-> StringView)))

(impl Text StringView
  (as-string-view [(text StringView)] (-> StringView) text))

(impl Text String
  (as-string-view [(text String)] (-> StringView)
    (StringView::unchecked (slice (load (field text bytes))))))

(impl Eq StringView
  (= [(a StringView) (b StringView)]
     (-> bool)
     (= (bytes a) (bytes b))))

(impl Ord StringView
  (< [(a StringView) (b StringView)]
     (-> bool)
     (< (cmp (bytes a) (bytes b)) 0))
  (<= [(a StringView) (b StringView)]
      (-> bool)
      (<= (cmp (bytes a) (bytes b)) 0))
  (> [(a StringView) (b StringView)]
     (-> bool)
     (> (cmp (bytes a) (bytes b)) 0))
  (>= [(a StringView) (b StringView)]
      (-> bool)
      (>= (cmp (bytes a) (bytes b)) 0)))

(impl Hash StringView
  (hash [(text StringView)] (-> i64) (hash (bytes text))))

(impl Eq String
  (= [(a String) (b String)]
     (-> bool)
     (= (as-string-view a) (as-string-view b))))

(impl Ord String
  (< [(a String) (b String)]
     (-> bool)
     (< (as-string-view a) (as-string-view b)))
  (<= [(a String) (b String)]
      (-> bool)
      (<= (as-string-view a) (as-string-view b)))
  (> [(a String) (b String)]
     (-> bool)
     (> (as-string-view a) (as-string-view b)))
  (>= [(a String) (b String)]
      (-> bool)
      (>= (as-string-view a) (as-string-view b))))

(impl Hash String
  (hash [(text String)] (-> i64) (hash (as-string-view text))))

(impl Iterable String
  (iter [(text String)] (-> RuneIter) (iter (as-string-view text))))

; Text prints as its characters (`{}`) or as a quoted literal (`{:?}`), exactly as
; the same bytes do as a `(slice u8)`; width and precision count characters.
(impl Display StringView
  (display-fmt [(text StringView) (f (ptr Formatter))] (-> i64)
    (display-fmt (bytes text) f)))

(impl Debug StringView
  (debug-fmt [(text StringView) (f (ptr Formatter))] (-> i64)
    (debug-fmt (bytes text) f)))

(impl Display String
  (display-fmt [(text String) (f (ptr Formatter))] (-> i64)
    (display-fmt (as-string-view text) f)))

; A rune prints as its character, the bytes of its UTF-8 encoding, with the same
; width handling as text.
(impl Display Rune
  (display-fmt [(r Rune) (f (ptr Formatter))] (-> i64)
    (let [(mut buf) (zeroed (array u8 4))
          n (encode-utf8 r (cast (ptr u8) (mut buf)))]
      (display-fmt (slice::new [u8] (cast (ptr u8) (mut buf)) n) f))))

(derive Eq Hash Rune)

(impl Debug String
  (debug-fmt [(text String) (f (ptr Formatter))] (-> i64)
    (debug-fmt (as-string-view text) f)))

; `(push! (mut s) r)` appends a rune's UTF-8 encoding; `(pop! (mut s))` removes
; the last rune and returns it.
(impl Push String
  (push! [(text (mut String)) (r Rune)]
         (-> i64)
         (let [(mut buf) (zeroed (array u8 4))
               n (encode-utf8 r (cast (ptr u8) (mut buf)))]
           (extend! (mut (field text bytes)) (cast (ptr u8) (mut buf)) n))))

(impl Pop String
  (pop! [(text (mut String))]
        (-> (Option Rune))
        (let [n (byte-len (load text))]
          (if (= n 0)
              (None)
              (let [(mut start) (- n 1)
                    bytes (slice (load (field text bytes)))]
                (loop (if (and (> (load start) 0)
                               (continuation-byte? (get bytes (load start))))
                          (store! start (- (load start) 1))
                          (break)))
                (let [rune
                        (rune-at (StringView::unchecked bytes)
                                 (load start))]
                  (store! (field (field text bytes) len) (load start))
                  (Some rune)))))))

; ---- the everyday view operations -----------------------------------------
(defn char-at [(s (slice u8)) (i i64)] (-> u8)
  (get s i))

(defn substr [(s (slice u8)) (lo i64) (hi i64)] (-> (slice u8))
  (subslice s lo hi))

; ---- C-string bridge -------------------------------------------------------
;;; FFI hands back NUL-terminated `(ptr i8)` strings; the everyday Coil string is a
;;; length-carrying `(slice u8)`. These convert between the two. `length-of-cstr`
;;; scans to the terminator (no libc `strlen` extern, so importing this module never
;;; collides with io.coil's `strlen` declaration).
(defn length-of-cstr [(p (ptr i8))] (-> i64)
  (let [(mut i) 0]
    (loop (if (= (primitive/cast i64 (load (primitive/index p (load i))))
                 0)
              (break)
              (store! i (primitive/iadd (load i) 1))))
    (load i)))

;;; A `(slice u8)` VIEW over a C string's bytes (excludes the NUL) — no copy, aliases
;;; the C storage.
(defn from-cstr [(p (ptr i8))] (-> (slice u8))
  (slice::new (primitive/cast (ptr u8) p) (length-of-cstr p)))

;;; A freshly-allocated NUL-terminated copy of `s` (what a C API wants). The result
;;; owns its `len+1` bytes; free it with `free-cstr` and the same allocator. Null on
;;; OOM (the same descriptive-not-safe contract as `unwrap-ptr`/`box`). C reads the
;;; string only up to its first NUL, so `s` should contain none.
(defn to-cstr [(a (dyn Allocator)) (s (slice u8))] (-> (ptr i8))
  (let [n (len s)]
    (match (alloc-bytes a (primitive/iadd n 1) 1)
      (None [] (primitive/cast (ptr i8) 0))
      (Some [memory]
            (let [p (primitive/cast (ptr i8) (data memory))]
              (do
                (copy [u8] (primitive/cast (ptr u8) p) (data s) n)
                (store! (primitive/index p n) (: 0 i8))
                p))))))

;;; Free a C string `to-cstr` made with `a`: its bytes up to the NUL, and the NUL.
;;; Null is ignored. The size freed is the C string's length, so `free-cstr` agrees
;;; with `to-cstr` only for text with no NUL byte inside it.
(defn free-cstr [(a (dyn Allocator)) (p (ptr i8))] (-> i64)
  (if (= (primitive/cast i64 p) 0)
      0
      (free-bytes a (slice::new (primitive/cast (ptr u8) p) (primitive/iadd (length-of-cstr p) 1)) 1)))

;;; Lexicographic byte comparison: negative if a<b, 0 if equal, positive if a>b.
;;; Compares byte-by-byte over the shared prefix, then breaks the tie by length —
;;; the ordering `=` and `hash` on strings are the equality and hash for, and what
;;; the `Ord` impl below (so `<`/`sort` on strings) is built over.
(defn cmp [(a (slice u8)) (b (slice u8))] (-> i64)
  (let [la (len a)
        lb (len b)
        n (if (< la lb) la lb)
        (mut i) 0
        (mut d) 0]
    (loop (if (>= (load i) n)
              (break)
              (let [ca (primitive/cast i64 (get a (load i)))
                    cb (primitive/cast i64 (get b (load i)))]
                (if (!= ca cb)
                    (do (store! d (primitive/isub ca cb)) (break))
                    (store! i (primitive/iadd (load i) 1))))))
    (if (!= (load d) 0) (load d) (primitive/isub la lb))))

(defn starts-with [(s (slice u8)) (prefix (slice u8))] (-> bool)
  (let [lp (len prefix)]
    (if (> lp (len s))
        false
        (= (subslice s 0 lp) prefix))))

;;; Searching for a run of elements: `(find hay needle)` is the first index where
;;; `needle` occurs in `hay`, or `(None)`; `(find-from hay needle i)` starts looking
;;; at `i`. Elements compare with `=`, so on strings this is a byte search.
(impl [(T Eq)] (slice T)
  (find-from [(hay (slice T)) (needle (slice T)) (i i64)] (-> (Option i64))
    (if (> (primitive/iadd i (len needle)) (len hay))
        (None)
        (if (= (subslice hay i (primitive/iadd i (len needle))) needle)
            (Some i)
            (find-from hay needle (primitive/iadd i 1)))))

  (find [(hay (slice T)) (needle (slice T))] (-> (Option i64))
    (find-from hay needle 0)))

; ---- trimming, parsing, splitting ------------------------------------------
;;; ASCII whitespace test (space, tab, newline, carriage return, vertical tab, form feed).
(defn ws? [(b u8)] (-> bool)
  (let [c (primitive/cast i64 b)]
    (any (= c (cast i64 #\space))
         (= c (cast i64 #\tab))
         (= c (cast i64 #\newline))
         (= c (cast i64 #\return))
         (= c 11)
         (= c (cast i64 #\formfeed)))))

;;; A VIEW with leading/trailing ASCII whitespace removed (no copy; shares storage).
(defn trim [(s (slice u8))] (-> (slice u8))
  (let [(mut lo) 0
        (mut hi) (len s)]
    (loop (if (and (< (load lo) (load hi)) (ws? (get s (load lo))))
              (store! lo (primitive/iadd (load lo) 1))
              (break)))
    (loop (if (and (< (load lo) (load hi))
                   (ws? (get s (primitive/isub (load hi) 1))))
              (store! hi (primitive/isub (load hi) 1))
              (break)))
    (subslice s (load lo) (load hi))))

;;; Parse a base-10 signed integer, `(Some n)` or `(None)` on any non-digit / empty /
;;; lone-sign input, or a value outside the i64 range. No allocation.
(defn parse-int [(s (slice u8))] (-> (Option i64))
  (let [n (len s)
        neg (and (> n 0) (= (primitive/cast i64 (get s 0)) 45))  ; '-'
        start (if neg 1 0)]
    (if (>= start n)
        (None)  ; empty, or a lone "-"
        ; Accumulate the NEGATED value: i64's range reaches one further below zero
        ; than above it, so -9223372036854775808 parses without overflowing.
        (let [(mut acc) 0
              (mut ok) true]
          (for i (range start n)
            (let [c (primitive/cast i64 (get s i))]
              (if (and ok (and (>= c (cast i64 #\0)) (<= c (cast i64 #\9))))
                  (if (or (primitive/imul-overflow? acc 10)
                          (primitive/isub-overflow? (primitive/imul acc 10) (primitive/isub c #\0)))
                      (set! ok false)
                      (set! acc (primitive/isub (primitive/imul acc 10) (primitive/isub c #\0))))
                  (set! ok false))))
          (cond (not ok) (None)
                neg (Some acc)
                ; the magnitude of i64's minimum has no positive i64
                (primitive/isub-overflow? 0 acc) (None)
                :else (Some (primitive/isub 0 acc)))))))

;;; Split `s` on every (non-overlapping) occurrence of `sep`, returning an
;;; `(ArrayList (slice u8))` of the pieces (each a VIEW into `s`). An empty `sep`
;;; yields the whole string as one piece. The caller owns the list — `free!` it
;;; (the piece slices alias `s`, so `s` must outlive them). Allocator-aware.
(defn split [(a (dyn Allocator)) (s (slice u8)) (sep (slice u8))] (-> (ArrayList (slice u8)))
  (let [(mut out) (ArrayList::new [(slice u8)] a)
        sl (len sep)
        n (len s)]
    (if (= sl 0)
        (do (push! (mut out) s) 0)
        (let [(mut start) 0]
          (loop (match (find (subslice s (load start) n) sep)
                  (None []
                        (do
                          (push! (mut out) (subslice s (load start) n))
                          (break)))
                  (Some [rel]
                        (let [idx (primitive/iadd (load start) rel)]
                          (push! (mut out) (subslice s (load start) idx))
                          (store! start (primitive/iadd idx sl))))))))
    (load out)))

;;; Concatenate into freshly-allocated bytes; `(None)` on OOM. The result owns its
;;; buffer (allocated from `a`); free it with the same allocator when done.
(defn concat [(a (dyn Allocator)) (x (slice u8)) (y (slice u8))] (-> (Option (slice u8)))
  (let [lx (len x)
        ly (len y)]
    (match (alloc [u8] a (primitive/iadd lx ly))
      (None [] (None))
      (Some [memory]
            (let [p (data memory)]
              (copy [u8] p (data x) lx)
              (copy [u8] (primitive/index p lx) (data y) ly)
              (Some memory))))))

;;; `x`, `y` and `z` joined in one allocation.
(defn concat3 [(a (dyn Allocator)) (x (slice u8)) (y (slice u8)) (z (slice u8))] (-> (Option (slice u8)))
  (let [lx (len x)
        ly (len y)
        lz (len z)]
    (match (alloc [u8] a (primitive/iadd lx (primitive/iadd ly lz)))
      (None [] (None))
      (Some [memory]
            (let [p (data memory)]
              (copy [u8] p (data x) lx)
              (copy [u8] (primitive/index p lx) (data y) ly)
              (copy [u8] (primitive/index p (primitive/iadd lx ly)) (data z) lz)
              (Some memory))))))

; ---- string-keyed HashMap: a KeyOps whose hash/eq read the slice's bytes ----
;;; The map stores the (slice u8) key value in its slot; these deref that slot to
;;; the fat pointer, then hash/compare the pointed-to CONTENT (not the 16 raw bytes
;;; of the fat pointer, which would compare addresses).
;;; `x` shifted right by `k` with zeros coming in at the top. `primitive/ishr` on a
;;; signed operand is arithmetic, which would smear the sign bit through the mix.
(defn key-hash-shr [(x i64) (k i64)] (-> i64)
  (primitive/cast i64
                  (primitive/ishr (primitive/cast u64 x) (primitive/cast u64 k))))

;;; The hash a string-keyed map places its keys by. It is NOT a string's `hash`:
;;; that one is FNV-1a, a byte at a time, and its values are written down (cache directory
;;; names, replay seeds), so it cannot change. This one is never stored anywhere, so
;;; it is free to be fast: it takes the bytes eight at a time, which matters because
;;; the keys a compiler hashes are qualified names of forty bytes and more, hashed
;;; again by every pass that indexes a program. A map masks off the low bits of the
;;; hash to find a slot, so the final mix folds the high bits down into them.
(defn key-hash [(s (slice u8))] (-> i64)
  (let [n (len s)
        base (data s)
        (mut h) (primitive/ixor -7046029254386353131 (primitive/imul n -4417276706812531889))
        (mut i) 0]
    (loop (if (> (primitive/iadd (load i) 8) n)
              (break)
              (let [word (load (primitive/cast (ptr i64) (primitive/index base (load i))))
                    mixed (primitive/imul (primitive/ixor (load h) word) -7070675565921424023)]
                (store! h (primitive/ixor mixed (key-hash-shr mixed 29)))
                (store! i (primitive/iadd (load i) 8)))))
    ; The last one to seven bytes, gathered into a word of their own.
    (when (< (load i) n)
      (let [(mut word) 0
            (mut shift) 0]
        (loop (if (>= (load i) n)
                  (break)
                  (do
                    (store! word
                            (primitive/ior (load word)
                                           (primitive/ishl (primitive/cast i64
                                                                           (get s (load i)))
                                                           (load shift))))
                    (store! shift (primitive/iadd (load shift) 8))
                    (store! i (primitive/iadd (load i) 1)))))
        (let [mixed (primitive/imul (primitive/ixor (load h) (load word)) -7070675565921424023)]
          (store! h (primitive/ixor mixed (key-hash-shr mixed 29)))))
      0)
    (let [folded (primitive/imul (primitive/ixor (load h) (key-hash-shr (load h) 32))
                                 -4417276706812531889)]
      (primitive/ixor folded (key-hash-shr folded 29)))))

(defn str-key-hash [(slot (ptr i8)) (n i64)] (-> i64)
  (key-hash (load (primitive/cast (ptr (slice u8)) slot))))

(defn str-key-eq [(a (ptr i8)) (b (ptr i8)) (n i64)] (-> bool)
  (= (load (primitive/cast (ptr (slice u8)) a))
     (load (primitive/cast (ptr (slice u8)) b))))

;;; std-3 — take ownership of a string key IN PLACE: read the (borrowed) slice at
;;; `slot`, allocate a private copy of its bytes from `a`, and overwrite the slot with
;;; a slice VIEW onto that owned copy. An empty key needs no storage (its data pointer
;;; is never dereferenced — `=` and `hash` short-circuit on length 0), so it is left
;;; as-is. OOM aborts (the same descriptive-not-safe contract as the rest of src/stdlib/str).
(defn str-key-copy [(ap (ptr (dyn Allocator))) (slot (ptr i8))] (-> i64)
  (let [s (load (primitive/cast (ptr (slice u8)) slot))
        n (len s)
        a (load ap)]
    (if (> n 0)
        (match (alloc [u8] a n)
          (None [] (oom-at c"str-key-copy" n))
          (Some [memory]
                (do
                  (copy [u8] (data memory) (data s) n)
                  (store! (primitive/cast (ptr (slice u8)) slot) memory)
                  0)))
        0)
    0))

;;; Release an owned string key's bytes. Mirrors str-key-copy: an empty key owns no
;;; storage, so it is skipped (never frees the borrowed pointer of a length-0 slice).
(defn str-key-free [(ap (ptr (dyn Allocator))) (slot (ptr i8))] (-> i64)
  (let [s (load (primitive/cast (ptr (slice u8)) slot))
        n (len s)]
    (if (> n 0)
        (free [u8] (load ap) s)
        0)))

;;; The default string KeyOps now OWNS its keys (std-3): every inserted key is copied
;;; into the map's allocator and freed on remove/clear/free, so a key never aliases
;;; caller storage. This is the safe default — reach for `keyops-borrowed` only
;;; when you can guarantee the key bytes outlive the map (e.g. static literals).
(defn keyops [] (-> (ptr KeyOps))
  (primitive/alloc-static KeyOps
                          (KeyOps :hash (primitive/fnptr-of str-key-hash)
                                  :eq (primitive/fnptr-of str-key-eq)
                                  :size (primitive/sizeof (slice u8))
                                  :copy (primitive/fnptr-of str-key-copy)
                                  :free (primitive/fnptr-of str-key-free)
                                  :owns 1)))

;;; OPT-IN, UNSAFE: keys are BORROWED — the map stores the (slice u8) view verbatim
;;; and never copies or frees the pointed-to bytes. The caller MUST guarantee every
;;; key's storage outlives the map and is not mutated for the map's lifetime; two keys
;;; built over one reused buffer will alias (the std-3 footgun). Correct for keys that
;;; are static literals or otherwise pinned. `copy`/`free`/`owns` are zero, so
;;; `owns?` is false and no ownership hook ever runs.
(defn keyops-borrowed [] (-> (ptr KeyOps))
  (primitive/alloc-static KeyOps
                          (KeyOps :hash (primitive/fnptr-of str-key-hash)
                                  :eq (primitive/fnptr-of str-key-eq)
                                  :size (primitive/sizeof (slice u8))
                                  :copy (primitive/zeroed (fnptr (cc/C) [(ptr (dyn Allocator)) (ptr i8)] i64))
                                  :free (primitive/zeroed (fnptr (cc/C) [(ptr (dyn Allocator)) (ptr i8)] i64))
                                  :owns 0)))

; ---- validated text HashMap keys -------------------------------------------
(defn string-view-key-hash [(slot (ptr i8)) (n i64)] (-> i64)
  (hash (load (primitive/cast (ptr StringView) slot))))

(defn string-view-key-eq [(a (ptr i8)) (b (ptr i8)) (n i64)] (-> bool)
  (= (load (primitive/cast (ptr StringView) a))
     (load (primitive/cast (ptr StringView) b))))

(defn string-view-key-copy [(allocator (ptr (dyn Allocator))) (slot (ptr i8))] (-> i64)
  (let [target (primitive/cast (ptr StringView) slot)
        view (load target)
        content (bytes view)
        n (len content)]
    (if (= n 0)
        0
        (match (alloc [u8] (load allocator) n)
          (None [] (oom-at c"string-view-key-copy" n))
          (Some [memory]
                (do
                  (copy [u8] (data memory) (data content) n)
                  (store! target (StringView::unchecked memory))
                  0))))))

(defn string-view-key-free [(allocator (ptr (dyn Allocator))) (slot (ptr i8))] (-> i64)
  (let [view (load (primitive/cast (ptr StringView) slot))
        content (bytes view)]
    (if (= (len content) 0)
        0
        (free [u8] (load allocator) content))))

(defn string-key-hash [(slot (ptr i8)) (n i64)] (-> i64)
  (hash (load (primitive/cast (ptr String) slot))))

(defn string-key-eq [(a (ptr i8)) (b (ptr i8)) (n i64)] (-> bool)
  (= (load (primitive/cast (ptr String) a))
     (load (primitive/cast (ptr String) b))))

(defn string-key-copy [(allocator (ptr (dyn Allocator))) (slot (ptr i8))] (-> i64)
  (let [target (primitive/cast (ptr String) slot)]
    (store! target
            (String::from-view (load allocator) (as-string-view (load target))))
    0))

(defn string-key-free [(allocator (ptr (dyn Allocator))) (slot (ptr i8))] (-> i64)
  (free! (primitive/cast (ptr String) slot)))

; ---- owned, growable string: a LIBRARY over ArrayList<u8> ------------------
;;; `StrBuf` is just an `(ArrayList u8)`; appending pushes bytes, and `str` hands
;;; back a `(slice u8)` VIEW over the current contents (no copy, invalidated by a
;;; later growth that moves the buffer — same contract as an ArrayList's `slice`).
;;; `(len sb)`, `(get sb i)` and `(push! (mut sb) b)` are the collection traits.
(defstruct StrBuf [(bytes (ArrayList u8))])

;;; The unsigned magnitude, most significant digit first. Reads the bits as UNSIGNED
;;; (udiv/urem), which is what lets `push-i64!` print i64-min without negating it.
(defn push-udec! [(sb (mut StrBuf)) (n i64)] (-> i64)
  (if (= n 0)
      0
      (do
        (push-udec! (mut sb) (primitive/udiv n 10))
        (push! (mut sb)
               (primitive/cast u8
                               (primitive/iadd (primitive/urem n 10)
                                               48))))))

;;; The Writer behind `StrBuf::writer`: appends every write to the StrBuf. It never
;;; fails; like `push-str!`, running out of memory aborts.
(defn strbuf-write [(ctx (ptr i8)) (buf (ptr i8)) (n i64)] (-> (Result i64 IoError))
  (let [sb (primitive/cast (ptr StrBuf) ctx)]
    (extend! (mut (field sb bytes)) (primitive/cast (ptr u8) buf) n)
    (Ok n)))

(impl StrBuf
  (new [(a (dyn Allocator))] (-> StrBuf)
    (let [(mut sb) (primitive/zeroed StrBuf)]
      (store! (field sb bytes) (ArrayList::new [u8] a))
      (load sb)))

  ;;; Append a (slice u8) in one copy; returns the new length. `s` must not be a view
  ;;; of this StrBuf's own bytes (`str`): growing moves them.
  (push-str! [(sb (mut StrBuf)) (s (slice u8))] (-> i64)
    (extend! (mut (field sb bytes)) (data s) (len s)))

  ;;; Append `v` in decimal; returns the new length. The counterpart of `parse-int`,
  ;;; and the way to get a number into a path, a filename, or a child's argv without a
  ;;; Writer — `coil.fmt` only ever prints to one.
  ;;;
  ;;; The sign is emitted separately and the magnitude printed through the unsigned
  ;;; path, never by negating: `(isub 0 i64-min)` wraps back to itself, and a formatter
  ;;; that negates first prints i64-min as `-0`. coil.fmt::print-i carries the same
  ;;; note, and the bug it describes was real.
  (push-i64! [(sb (mut StrBuf)) (v i64)] (-> i64)
    (if (= v 0)
        (push! (mut sb) (: 48 u8))  ; "0"
        (if (< v 0)
            (do
              (push! (mut sb) (: 45 u8))  ; '-'
              (push-udec! (mut sb) (primitive/isub 0 v)))
            (push-udec! (mut sb) v))))

  ;;; A (slice u8) view over the current contents (shares storage with the StrBuf).
  (str [(sb StrBuf)] (-> (slice u8))
    (slice (field sb bytes)))

  (free! [(sb (mut StrBuf))] (-> i64)
    (free! (mut (field sb bytes))))

  ;;; Finish building: hand back an OWNING `(slice u8)` shrunk to the exact length, and
  ;;; reset the StrBuf to empty. Unlike `str` (a borrowed view that a later push can
  ;;; invalidate), the returned slice owns a right-sized buffer the caller frees with
  ;;; the same allocator — no use-after-free, no dangling capacity. Over `into-slice`.
  (finish! [(sb (mut StrBuf))] (-> (slice u8))
    (into-slice (mut (field sb bytes))))

  ;;; Initialize the caller-owned Writer `w` to append to `sb`, and return it, so
  ;;; anything that prints to a Writer can print into a string:
  ;;; `(fmt (StrBuf::writer (mut w) (mut sb)) "x={}" x)`. Do not write `sb`'s own
  ;;; contents (`str`) through it: a growth moves the bytes being copied.
  ;;; `format!` is the one-line form.
  (writer [(w (ptr Writer)) (sb (ptr StrBuf))] (-> (ptr Writer))
    (store! (field w write-fn) (primitive/fnptr-of strbuf-write))
    (store! (field w ctx) (primitive/cast (ptr i8) sb))
    w))

;;; `(format! (mut sb) "fmt" args…)` appends formatted text to a StrBuf, with
;;; the format strings of `fmt`/`println`. To build a fresh string:
;;;
;;;     (let [(mut sb) (StrBuf::new a)]
;;;       (format! (mut sb) "{}-{}" name n)
;;;       (finish! (mut sb)))   ; an owned (slice u8), freed with `a`
(defn format! [(sb Code) (format Code) & (args Code)] (-> Code)
  (let [w (primitive/fresh-identifier "writer")]
    `(let [(mut ~w) (zeroed Writer)]
       (fmt (StrBuf::writer (mut ~w) ~sb) ~format ~@args))))

; ---- the core collection traits (coil.core) ---------------------------------
; Strings are `(slice u8)` — so equality (`=`/`case`), ordering (`< <= > >=`, hence
; `sort`), and hashing (a HashMap key) come from these impls over the byte content.
; (The generic `Len`/`Get`/`Set` for any `(slice T)` live in src/stdlib/slice.coil.)
;;; Content equality: same length and same bytes.
(impl Eq (slice u8)
  (= [(a (slice u8)) (b (slice u8))] (-> bool)
     (let [la (len a)]
       (if (!= la (len b))
           false
           (eql [u8] (data a) (data b) la)))))

(impl Ord (slice u8)
  (< [(a (slice u8)) (b (slice u8))] (-> bool) (< (cmp a b) 0))
  (<= [(a (slice u8)) (b (slice u8))] (-> bool) (<= (cmp a b) 0))
  (> [(a (slice u8)) (b (slice u8))] (-> bool) (> (cmp a b) 0))
  (>= [(a (slice u8)) (b (slice u8))] (-> bool) (>= (cmp a b) 0)))

;;; FNV-1a over the bytes (matches src/stdlib/hashmap's bytewise-hash, so a content
;;; hash). Its values are written down (cache directory names, replay seeds), so it
;;; cannot change.
(impl Hash (slice u8)
  (hash [(s (slice u8))] (-> i64)
    (let [(mut h) -3750763034362895579  ; FNV-1a offset basis
          (mut i) 0
          n (len s)]
      (loop (if (>= (load i) n)
                (break)
                (do
                  (store! h
                          (primitive/imul (primitive/ixor (load h)
                                                          (primitive/cast i64
                                                                            (get s
                                                                                 (load i))))
                                          1099511628211))
                  (store! i (primitive/iadd (load i) 1)))))
      (load h))))

; A Keyword is its name, so keywords compare and hash by that text.
(defn keyword-name [(k Keyword)] (-> (slice u8))
  (match k (KeywordValue [name] name)))

(impl Eq Keyword
  (= [(a Keyword) (b Keyword)] (-> bool) (= (keyword-name a) (keyword-name b))))

(impl Hash Keyword
  (hash [(k Keyword)] (-> i64) (hash (keyword-name k))))

; A StrBuf is a byte collection: `(len sb)` / `(get sb i)` / `(push! (mut sb) b)`.
; (Strings themselves are (slice u8) — their Len/Get impls are src/stdlib/slice.coil's.)
(impl Len StrBuf
  (len [(sb StrBuf)] (-> i64) (len (load (field sb bytes)))))

(impl Get StrBuf
  (get [(sb StrBuf) (i i64)] (-> u8) (get (load (field sb bytes)) i)))

(impl Push StrBuf
  (push! [(sb (mut StrBuf)) (b u8)] (-> i64) (push! (mut (field sb bytes)) b)))
