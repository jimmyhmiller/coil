; The serde DOM: a dynamic value type for data whose shape is unknown until
; runtime — the coil.serde analogue of serde_json::Value, format-agnostic like
; everything else in the framework.
;
;   (import "coil.serde"       :use *)
;   (import "coil.serde.value" :use *)
;   (import "coil.serde.json"  :use *)
;   (match (from-json [JVal] a src)                    ; ANY valid document decodes
;     (Ok [v] (jv-int (jv-get v "version")))
;     (Err [_] …))
;
; Decoding is driven by the Deserializer's `de-kind` peek, so the same JVal
; works through JSON, sexp, and msgpack. Notes: integers land in JInt (an i64 —
; a u64 above i64 MAX errors with DE-E-INT-RANGE); sexp bare symbols read as
; JStr; a sexp struct form (Tag f v) reads as a plain list (its tag is element
; 0). Children live in `de-alloc` memory, per the module's borrow contract.
(module coil.serde.value)
(import "coil.primitive" :as primitive)
(import "coil.alloc" :as alloc)
(import "coil.alloc" :use *)
(import "coil.slice" :use *)
(import "coil.str" :use *)
(import "coil.arraylist" :use *)
(import "coil.hashmap" :use *)
(import "coil.serde" :use *)
(import "coil.control" :use *)
(import "coil.result" :use *)
(import "coil.try" :use *)

(defsum JVal
  (JNull)
  (JBool [(b bool)])
  (JInt [(n i64)])
  (JFloat [(x f64)])
  (JStr [(s (slice u8))])
  (JBytes [(bs (slice u8))])
  (JArr [(a (ptr (ArrayList JVal)))])
  (JObj [(o (ptr (HashMap (slice u8) JVal)))]))

; ---- Serialize --------------------------------------------------------------
(impl Serialize JVal
  (ser [(x JVal) (s (dyn Serializer))]
       (-> (Result i64 SerError))
       (match x
         (JNull [] (ser-null s))
         (JBool [b] (ser-bool s b))
         (JInt [n] (ser-i64 s n))
         (JFloat [f] (ser-f64 s f))
         (JStr [st] (ser-str s st))
         (JBytes [bs] (ser-bytes s bs))
         (JArr [l]
               (try (let [n (al-len [JVal] (load l))]
                      (try! (seq-begin s n))
                      (for [i 0 n]
                        (do
                          (try! (seq-elem s))
                          (try! (ser (al-get [JVal] (load l) i) s))
                          0))
                      (seq-end s))))
         (JObj [m]
               (try (do
                      (try! (map-begin s (hm-len [(slice u8) JVal] (load m))))
                      (let [cap (hm-cap [(slice u8) JVal] (load m))
                            slots (load (field m slots))]
                        (for [i 0 cap]
                          (let [e (primitive/index slots i)]
                            (when (= (load (field e state)) (cast i64 1))
                              (try! (map-key s (load (field e key))))
                              (try! (ser (load (field e val)) s))
                              0)
                            0)))
                      (map-end s)))))))

; ---- Deserialize ------------------------------------------------------------
(impl Deserialize JVal
  (de [(out (ptr JVal)) (d (dyn Deserializer))]
      (-> (Result i64 DeError))
      (let [k (de-kind d)]
        (cond (= k SD-K-NULL)
                (do
                  (de-null? d)  ; consumes (kind already peeked)
                  (store! out (JNull))
                  (Ok 0))
              (= k SD-K-BOOL) (try (do (store! out (JBool (try! (de-bool d)))) (Ok 0)))
              (= k SD-K-INT) (try (do (store! out (JInt (try! (de-i64 d)))) (Ok 0)))
              (= k SD-K-FLOAT) (try (do (store! out (JFloat (try! (de-f64 d)))) (Ok 0)))
              (= k SD-K-STR) (try (do (store! out (JStr (try! (de-str d)))) (Ok 0)))
              (= k SD-K-BYTES) (try (do (store! out (JBytes (try! (de-bytes d)))) (Ok 0)))
              (= k SD-K-SEQ)
                (try (let [n (try! (de-seq-begin d))
                           (mut l) (al-new [JVal] (de-alloc d))
                           slot (alloc/stack JVal)]
                       (for [i 0 n]
                         (do
                           (try! (de slot d))
                           (al-push! (mut l) (load slot))
                           0))
                       (try! (de-seq-end d))
                       (store! out (JArr (box (de-alloc d) (ArrayList JVal) (load l))))
                       (Ok 0)))
              (= k SD-K-MAP)
                (try (let [n (try! (de-map-begin d))
                           (mut m) (hm-new [(slice u8) JVal] (de-alloc d) (str-keyops-borrowed))
                           slot (alloc/stack JVal)]
                       (for [i 0 n]
                         (do
                           (let [key (try! (de-map-key d i))]
                             (try! (de-map-value d i))
                             (try! (de slot d))
                             (hm-put! (mut m) key (load slot))
                             0)))
                       (try! (de-map-end d))
                       (store! out (JObj (box (de-alloc d) (HashMap (slice u8) JVal) (load m))))
                       (Ok 0)))
              :else (Err (de-err DE-E-PARSE -1 "value has no data-model kind"))))))

; ---- queries ---------------------------------------------------------------
;; object member by key, or JNull
(defn jv-get [(v JVal) (key (slice u8))] (-> JVal)
  (match v
    (JObj [m]
          (match (hm-get [(slice u8) JVal] (load m) key)
            (Some [x] x)
            (None [] (JNull))))
    (JNull [] (JNull))
    (JBool [_] (JNull))
    (JInt [_] (JNull))
    (JFloat [_] (JNull))
    (JStr [_] (JNull))
    (JBytes [_] (JNull))
    (JArr [_] (JNull))))
;; array element by index, or JNull
(defn jv-nth [(v JVal) (i i64)] (-> JVal)
  (match v
    (JArr [l]
          (if (and (>= i (cast i64 0)) (< i (al-len [JVal] (load l))))
              (al-get [JVal] (load l) i)
              (JNull)))
    (JNull [] (JNull))
    (JBool [_] (JNull))
    (JInt [_] (JNull))
    (JFloat [_] (JNull))
    (JStr [_] (JNull))
    (JBytes [_] (JNull))
    (JObj [_] (JNull))))
;; the integer view: JInt itself, JBool as 0/1, anything else 0
(defn jv-int [(v JVal)] (-> i64)
  (match v
    (JInt [n] n)
    (JBool [b] (if b 1 0))
    (JNull [] 0)
    (JFloat [_] 0)
    (JStr [_] 0)
    (JBytes [_] 0)
    (JArr [_] 0)
    (JObj [_] 0)))
(defn jv-float [(v JVal)] (-> f64)
  (match v
    (JFloat [x] x)
    (JInt [n] (primitive/cast f64 n))
    (JNull [] 0.0)
    (JBool [_] 0.0)
    (JStr [_] 0.0)
    (JBytes [_] 0.0)
    (JArr [_] 0.0)
    (JObj [_] 0.0)))
(defn jv-str [(v JVal)] (-> (slice u8))
  (match v
    (JStr [s] s)
    (JNull [] "")
    (JBool [_] "")
    (JInt [_] "")
    (JFloat [_] "")
    (JBytes [_] "")
    (JArr [_] "")
    (JObj [_] "")))
;; element / member count (arrays and objects; 0 otherwise)
(defn jv-len [(v JVal)] (-> i64)
  (match v
    (JArr [l] (al-len [JVal] (load l)))
    (JObj [m] (hm-len [(slice u8) JVal] (load m)))
    (JNull [] 0)
    (JBool [_] 0)
    (JInt [_] 0)
    (JFloat [_] 0)
    (JStr [_] 0)
    (JBytes [_] 0)))
(defn jv-null? [(v JVal)] (-> bool)
  (match v
    (JNull [] true)
    (JBool [_] false)
    (JInt [_] false)
    (JFloat [_] false)
    (JStr [_] false)
    (JBytes [_] false)
    (JArr [_] false)
    (JObj [_] false)))
