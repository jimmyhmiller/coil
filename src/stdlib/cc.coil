;;; How a calling convention becomes machine code. A `defcc` names its lowering
;;; with one of these values:
;;;
;;;     (import "coil.cc" :as cc)
;;;     (defcc fast2 :params [rax rdx] :ret rax :lower (cc/Shim))
;;;     (defcc reset :lower (cc/Reset))
;;;     (defcc tailish :lower (cc/Native (cc/Tail)))
(module coil.cc)

;;; A convention LLVM already implements.
(defsum NativeCc
  ;;; The platform's C convention.
  (C)
  ;;; LLVM's `fastcc`: arguments in as many registers as the target allows.
  (Fast)
  ;;; LLVM's `coldcc`: the caller keeps as few registers live as it can.
  (Cold)
  ;;; LLVM's `tailcc`: every call in tail position is a guaranteed tail call.
  (Tail)
  ;;; LLVM's `swifttailcc`: Swift's convention with guaranteed tail calls.
  (SwiftTail))

;;; The lowering a `defcc` gives its convention.
(defsum Lowering
  ;;; An LLVM convention. LLVM places the arguments itself: `:params`, `:ret`
  ;;; and `:clobber` are recorded as the convention's description, not used.
  (Native [(cc NativeCc)])
  ;;; The registers `:params`, `:ret` and `:clobber` name. A function under it
  ;;; is compiled for the C convention and reached through a trampoline that
  ;;; moves its arguments and result.
  (Shim)
  ;;; A freestanding reset entry: the function is published as `_start`, with
  ;;; the register setup the target needs before Coil code runs.
  (Reset))
