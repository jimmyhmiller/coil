(module coil.prop.cov)
(import "coil.primitive" :as primitive)
(import "coil.alloc" :as alloc)
; EDGE COVERAGE — the feedback channel that turns property testing into fuzzing.
;
; Random generation is blind: it produces inputs and learns nothing from what they
; did. A coverage-guided search watches which basic blocks each input reached and
; keeps the ones that reached somewhere new, so the corpus accumulates inputs that
; between them cover the program — and a bug behind three nested conditions gets
; found by three lucky guesses in sequence instead of one impossible one
; (Lampropoulos et al., "Coverage Guided, Property Based Testing", OOPSLA 2019).
;
; ── HOW THE COVERAGE GETS HERE ────────────────────────────────────────────────
;
; clang's `-fsanitize-coverage=trace-pc-guard` inserts, at the top of every basic
; block, a call to `__sanitizer_cov_trace_pc_guard` with the address of a unique
; 32-bit guard, plus one call to `__sanitizer_cov_trace_pc_guard_init` per module
; naming the range of guards it owns. Those two symbols are normally supplied by a
; C runtime. Here they are ordinary Coil functions, exported under those names.
;
; That choice is what makes this feature cost nothing when it is off:
;
;   * a NORMAL build links fine — the symbols are defined, nothing calls them, and
;     every query below answers "no coverage";
;   * an INSTRUMENTED build (`coil emit-ir prop_test.coil` piped through clang with
;     the flag) calls them, and the same queries answer with real edges.
;
; No C file, no weak symbols, no conditional compilation, and no change to the
; Coil compiler — `emit-ir` already emits complete, linkable IR for a whole
; program, so instrumentation is a step in a build script. `coil fuzz`
; is that script.
;
; ⚠ THESE FUNCTIONS MUST NOT BE INSTRUMENTED. `-fsanitize-coverage` would insert a
; call to `cov-guard` at the top of `cov-guard`, which is an infinite recursion and
; a hung build. The script excludes them with `-fsanitize-coverage-ignorelist`; the
; re-entrancy flag below is the belt to that suspenders, because a hang is a much
; worse failure than a lost edge and the ignorelist is a file that can be forgotten.

; 2^20 single-byte slots. One megabyte of BSS, untouched (and therefore unmapped)
; in a build that is not instrumented, and enough for programs far larger than a
; test binary. Collisions past that degrade the search, they do not break it: two
; edges sharing a slot means the second one looks already-seen.
(const COV-SLOTS 1048576)
(const COV-MASK 1048575)

(defn cov-bitmap [] (-> (ptr u8))
  (primitive/cast (ptr u8) (primitive/alloc-static (array u8 1048576))))
(defn cov-fresh-cell [] (-> (ptr i64))
  (primitive/alloc-static i64))
(defn cov-total-cell [] (-> (ptr i64))
  (primitive/alloc-static i64))
(defn cov-guards-cell [] (-> (ptr i64))
  (primitive/alloc-static i64))
(defn cov-busy-cell [] (-> (ptr bool))
  (primitive/alloc-static bool))

;;; `__sanitizer_cov_trace_pc_guard_init` — called once per instrumented module,
;;; before `main`, with the half-open range of guards that module owns.
;;;
;;; Guards start zeroed and are numbered here, densely, from 1. Zero therefore
;;; means "not a real guard", which is what lets the callback ignore a range that
;;; some other init already claimed (clang emits one init call per module and the
;;; runtime is expected to be idempotent).
(defn cov-init [(start (ptr u32)) (stop (ptr u32))] (-> i64)
  (if (or (>= start stop) (!= (primitive/cast i64 (load start)) 0))
      0
      (let [(mut p) start
            (mut n) (load (cov-guards-cell))]
        (loop (if (>= (load p) stop)
                  (break)
                  (do
                    (store! n (primitive/iadd (load n) 1))
                    (store! (load p) (primitive/cast u32 (load n)))
                    (store! p (primitive/index (load p) 1)))))
        (store! (cov-guards-cell) (load n))
        0)))

;;; `__sanitizer_cov_trace_pc_guard` — called at the top of every instrumented
;;; basic block. This is the hottest function in an instrumented binary, so it does
;;; the least it can: one load, one mask, one byte test, and on the rare new-edge
;;; path two increments.
(defn cov-guard [(guard (ptr u32))] (-> i64)
  (if (load (cov-busy-cell))
      0
      (let [id (primitive/cast i64 (load guard))]
        (if (= id 0)
            0
            (let [slot (primitive/index (cov-bitmap) (primitive/iand id COV-MASK))]
              (if (= (primitive/cast i64 (load slot)) 0)
                  (do
                    (store! (cov-busy-cell) true)
                    (store! slot (primitive/cast u8 1))
                    (store! (cov-fresh-cell) (primitive/iadd (load (cov-fresh-cell)) 1))
                    (store! (cov-total-cell) (primitive/iadd (load (cov-total-cell)) 1))
                    (store! (cov-busy-cell) false)
                    0)
                  0))))))

(export-c [cov-init :as "__sanitizer_cov_trace_pc_guard_init"])
(export-c [cov-guard :as "__sanitizer_cov_trace_pc_guard"])

; ---------------------------------------------------------------- the queries

;;; Is this binary actually instrumented? Everything above is inert otherwise, and
;;; a fuzz loop that does not know the difference is just a slower random search
;;; that reports coverage numbers of zero — so the runner asks, and says so.
(defn cov-instrumented? [] (-> bool)
  (> (load (cov-guards-cell)) 0))

;;; How many instrumented basic blocks exist. The denominator for "how much of the
;;; program has this corpus reached".
(defn cov-guards [] (-> i64)
  (load (cov-guards-cell)))

;;; Distinct edges seen since the process started.
(defn cov-total [] (-> i64)
  (load (cov-total-cell)))

;;; Edges seen for the FIRST time since the last call, and reset. This is the whole
;;; feedback signal: run a case, ask, and keep the input if the answer is nonzero.
(defn cov-take-fresh [] (-> i64)
  (let [f (load (cov-fresh-cell))]
    (store! (cov-fresh-cell) 0)
    f))

;;; Forget everything. Only for a caller that wants per-case coverage rather than
;;; the cumulative picture — the fuzz loop wants cumulative, because "new" has to
;;; mean new to the whole run and not new to this case.
(defn cov-clear! [] (-> i64)
  (let [(mut i) 0
        b (cov-bitmap)]
    (loop (if (>= (load i) COV-SLOTS)
              (break)
              (do
                (store! (primitive/index b (load i)) (primitive/cast u8 0))
                (store! i (primitive/iadd (load i) 1)))))
    (store! (cov-fresh-cell) 0)
    (store! (cov-total-cell) 0)
    0))

; ═══════════════════════════════════════════════ comparison feedback (trace-cmp)
;
; Edge coverage tells the search WHERE it got to. It does not tell it what to
; try next, so a comparison against a magic value is climbed one byte at a time:
; each correct byte opens a branch, the input is kept, and the next byte is
; guessed. Four bytes cost four rounds of guessing — better than the product, but
; still guessing.
;
; `-fsanitize-coverage=trace-cmp` closes that gap. clang calls one of these on
; every integer comparison with BOTH OPERANDS, so a failed `byte == 'F'` hands us
; the 70 we needed. Feeding those observed constants back into the mutator turns
; "guess a byte, 1 in 95" into "use the value the program just asked for" — which
; is libFuzzer's auto-dictionary, and the reason it solves magic values in one
; step rather than one byte per step.
;
; The tape makes the trick unusually direct. A byte-level fuzzer has to guess
; WHERE in the input the wanted value belongs; here the mutator is already choosing
; a specific `Choice` to change, and every choice carries the range it must lie in,
; so a dictionary value is either in range for that choice or is skipped.
;
; ⚠ SIGNAL, NOT VOLUME. Every integer comparison in the program calls in here,
; millions of times a second, and almost all of them are the engine comparing loop
; counters. Two things keep the dictionary meaningful:
;   * the build ignorelists `coil.prop.*`, so only the code under test reports;
;   * only FAILED comparisons are recorded — an equality that already holds is not
;     something the search needs help reaching.
; What is left is small enough that a 64-entry ring holds a useful window, and the
; ring never scans or deduplicates: one store and one increment, because this runs
; on a path hotter than anything else in the process.

(const DICT-SLOTS 64)
(const DICT-MASK 63)

; 64 pairs, stored interleaved: values[2i] is what the input held, values[2i+1]
; what the comparison wanted.
(defn dict-values [] (-> (ptr i64))
  (primitive/cast (ptr i64) (primitive/alloc-static (array i64 128))))
(defn dict-write-cell [] (-> (ptr i64))
  (primitive/alloc-static i64))
(defn dict-count-cell [] (-> (ptr i64))
  (primitive/alloc-static i64))
(defn dict-on-cell [] (-> (ptr bool))
  (primitive/alloc-static bool))

;;; Record a failed comparison as the PAIR of what was there and what was wanted.
;;;
;;; Storing the operands as a pair, rather than as two loose values, is what makes
;;; the feedback precise. A flat dictionary can only say "70 was interesting
;;; somewhere" and leaves the mutator to guess which of the input's choices should
;;; become 70 — and it fills up with the runtime side of every comparison, which is
;;; whatever the input happened to hold and is pure noise. A pair says "wherever
;;; you see THIS value, the program wanted THAT one", so the substitution is
;;; directed by the input's own contents. That correspondence is the idea behind
;;; Redqueen's input-to-state substitution and libFuzzer's table of recent
;;; comparisons; it is the difference between a hint and an answer.
(defn dict-push-pair! [(a i64) (b i64)] (-> i64)
  (if (or (not (load (dict-on-cell))) (= a b))
      0
      (let [w (primitive/iand (load (dict-write-cell)) DICT-MASK)]
        (store! (primitive/index (dict-values) (primitive/imul w 2)) a)
        (store! (primitive/index (dict-values) (primitive/iadd (primitive/imul w 2) 1)) b)
        (store! (dict-write-cell) (primitive/iadd (load (dict-write-cell)) 1))
        (if (< (load (dict-count-cell)) DICT-SLOTS)
            (store! (dict-count-cell) (primitive/iadd (load (dict-count-cell)) 1))
            0)
        0)))

;;; The mutator turns recording on around the property call and off again, so the
;;; dictionary describes the code under test rather than the loop that drives it.
(defn cov-cmp-record! [(on bool)] (-> i64)
  (store! (dict-on-cell) on)
  0)

;;; How many pairs are held, and each side of one.
(defn cov-dict-count [] (-> i64)
  (load (dict-count-cell)))
(defn cov-dict-lhs [(i i64)] (-> i64)
  (if (or (< i 0) (>= i (load (dict-count-cell))))
      0
      (load (primitive/index (dict-values) (primitive/imul (primitive/iand i DICT-MASK) 2)))))
(defn cov-dict-rhs [(i i64)] (-> i64)
  (if (or (< i 0) (>= i (load (dict-count-cell))))
      0
      (load (primitive/index (dict-values)
                             (primitive/iadd (primitive/imul (primitive/iand i DICT-MASK) 2) 1)))))

;;; The value the program wanted where `current` was found, or `current` when
;;; nothing in the window mentions it.
;;;
;;; A linear scan of 64 pairs, and it runs once per mutated choice rather than once
;;; per comparison, so it is nowhere near a hot path — the hot path is
;;; `dict-push-pair!`, which is a masked index and two stores.
(defn cov-dict-counterpart [(current i64)] (-> i64)
  (let [n (load (dict-count-cell))
        (mut i) 0
        (mut found) current]
    (loop (if (or (>= (load i) n) (!= (load found) current))
              (break)
              (do
                (if (= (cov-dict-lhs (load i)) current)
                    (store! found (cov-dict-rhs (load i)))
                    (if (= (cov-dict-rhs (load i)) current) (store! found (cov-dict-lhs (load i))) 0))
                (store! i (primitive/iadd (load i) 1)))))
    (load found)))

; ── the callbacks ────────────────────────────────────────────────────────────
;
; `trace_const_cmpN` is emitted when one operand is a compile-time constant, and
; the CONSTANT IS THE FIRST ARGUMENT — that is the interesting one, because it is
; the value the input needed to be. `trace_cmpN` compares two runtime values, so
; either might be what the other wanted and both are recorded.

; Both callback families record the same thing — the two operands of a comparison
; that did not hold — because with pairs it does not matter which side is the
; constant. `trace_const_cmp` documents the constant as the first argument, but
; nothing here has to rely on that.
(defn cmp-const [(a i64) (b i64)] (-> i64)
  (dict-push-pair! a b))
(defn cmp-both [(a i64) (b i64)] (-> i64)
  (dict-push-pair! a b))

(defn cov-const-cmp1 [(a u8) (b u8)] (-> i64)
  (cmp-const (primitive/cast i64 a) (primitive/cast i64 b)))
(defn cov-const-cmp2 [(a u16) (b u16)] (-> i64)
  (cmp-const (primitive/cast i64 a) (primitive/cast i64 b)))
(defn cov-const-cmp4 [(a u32) (b u32)] (-> i64)
  (cmp-const (primitive/cast i64 a) (primitive/cast i64 b)))
(defn cov-const-cmp8 [(a u64) (b u64)] (-> i64)
  (cmp-const (primitive/cast i64 a) (primitive/cast i64 b)))

(defn cov-cmp1 [(a u8) (b u8)] (-> i64)
  (cmp-both (primitive/cast i64 a) (primitive/cast i64 b)))
(defn cov-cmp2 [(a u16) (b u16)] (-> i64)
  (cmp-both (primitive/cast i64 a) (primitive/cast i64 b)))
(defn cov-cmp4 [(a u32) (b u32)] (-> i64)
  (cmp-both (primitive/cast i64 a) (primitive/cast i64 b)))
(defn cov-cmp8 [(a u64) (b u64)] (-> i64)
  (cmp-both (primitive/cast i64 a) (primitive/cast i64 b)))

;;; A `switch`'s case labels are magic values with a different spelling. The layout
;;; is fixed by the instrumentation: cases[0] is how many there are, cases[1] the
;;; operand's bit width, and the labels follow.
(defn cov-switch [(val u64) (cases (ptr u64))] (-> i64)
  (if (not (load (dict-on-cell)))
      0
      (let [n (primitive/cast i64 (load cases))
            (mut i) 0]
        (loop (if (or (>= (load i) n) (>= (load i) 64))
                  (break)
                  (do
                    (dict-push-pair! (primitive/cast i64 val)
                                     (primitive/cast i64
                                                     (load (primitive/index cases
                                                                            (primitive/iadd (load i)
                                                                                            2)))))
                    (store! i (primitive/iadd (load i) 1)))))
        0)))

(export-c [cov-const-cmp1 :as "__sanitizer_cov_trace_const_cmp1"])
(export-c [cov-const-cmp2 :as "__sanitizer_cov_trace_const_cmp2"])
(export-c [cov-const-cmp4 :as "__sanitizer_cov_trace_const_cmp4"])
(export-c [cov-const-cmp8 :as "__sanitizer_cov_trace_const_cmp8"])
(export-c [cov-cmp1 :as "__sanitizer_cov_trace_cmp1"])
(export-c [cov-cmp2 :as "__sanitizer_cov_trace_cmp2"])
(export-c [cov-cmp4 :as "__sanitizer_cov_trace_cmp4"])
(export-c [cov-cmp8 :as "__sanitizer_cov_trace_cmp8"])
(export-c [cov-switch :as "__sanitizer_cov_trace_switch"])
