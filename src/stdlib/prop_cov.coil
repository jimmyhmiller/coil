(module coil.prop.cov)
(import "coil.primitive" :as primitive)
(import "coil.alloc" :as alloc)
; EDGE COVERAGE — the feedback channel that turns property testing into fuzzing.
;
; Random generation is blind: it produces inputs and learns nothing from what they
; did. A coverage-guided search watches which basic blocks each input reached and
; keeps the ones that reached somewhere new, so the corpus accumulates inputs that
; between them cover the program — and a bug behind three nested conditions gets
; found by three lucky guesses in sequence instead of one impossible one
; (Lampropoulos et al., "Coverage Guided, Property Based Testing", OOPSLA 2019).
;
; ── HOW THE COVERAGE GETS HERE ────────────────────────────────────────────────
;
; clang's `-fsanitize-coverage=trace-pc-guard` inserts, at the top of every basic
; block, a call to `__sanitizer_cov_trace_pc_guard` with the address of a unique
; 32-bit guard, plus one call to `__sanitizer_cov_trace_pc_guard_init` per module
; naming the range of guards it owns. Those two symbols are normally supplied by a
; C runtime. Here they are ordinary Coil functions, exported under those names.
;
; That choice is what makes this feature cost nothing when it is off:
;
;   * a NORMAL build links fine — the symbols are defined, nothing calls them, and
;     every query below answers "no coverage";
;   * an INSTRUMENTED build (`coil emit-ir prop_test.coil` piped through clang with
;     the flag) calls them, and the same queries answer with real edges.
;
; No C file, no weak symbols, no conditional compilation, and no change to the
; Coil compiler — `emit-ir` already emits complete, linkable IR for a whole
; program, so instrumentation is a step in a build script. `scripts/tests/prop-fuzz.sh`
; is that script.
;
; ⚠ THESE FUNCTIONS MUST NOT BE INSTRUMENTED. `-fsanitize-coverage` would insert a
; call to `cov-guard` at the top of `cov-guard`, which is an infinite recursion and
; a hung build. The script excludes them with `-fsanitize-coverage-ignorelist`; the
; re-entrancy flag below is the belt to that suspenders, because a hang is a much
; worse failure than a lost edge and the ignorelist is a file that can be forgotten.

; 2^20 single-byte slots. One megabyte of BSS, untouched (and therefore unmapped)
; in a build that is not instrumented, and enough for programs far larger than a
; test binary. Collisions past that degrade the search, they do not break it: two
; edges sharing a slot means the second one looks already-seen.
(const COV-SLOTS 1048576)
(const COV-MASK 1048575)

(defn cov-bitmap [] (-> (ptr u8))
  (primitive/cast (ptr u8) (alloc/static (array u8 1048576))))
(defn cov-fresh-cell [] (-> (ptr i64))
  (alloc/static i64))
(defn cov-total-cell [] (-> (ptr i64))
  (alloc/static i64))
(defn cov-guards-cell [] (-> (ptr i64))
  (alloc/static i64))
(defn cov-busy-cell [] (-> (ptr bool))
  (alloc/static bool))

;; `__sanitizer_cov_trace_pc_guard_init` — called once per instrumented module,
;; before `main`, with the half-open range of guards that module owns.
;;
;; Guards start zeroed and are numbered here, densely, from 1. Zero therefore
;; means "not a real guard", which is what lets the callback ignore a range that
;; some other init already claimed (clang emits one init call per module and the
;; runtime is expected to be idempotent).
(defn cov-init [(start (ptr u32)) (stop (ptr u32))] (-> i64)
  (if (or (>= start stop) (!= (primitive/cast i64 (primitive/load start)) 0))
      0
      (let [(mut p) start
            (mut n) (load (cov-guards-cell))]
        (loop (if (>= (load p) stop)
                  (break)
                  (do
                    (store! n (primitive/iadd (load n) 1))
                    (primitive/store! (load p) (primitive/cast u32 (load n)))
                    (store! p (primitive/index (load p) 1)))))
        (store! (cov-guards-cell) (load n))
        0)))

;; `__sanitizer_cov_trace_pc_guard` — called at the top of every instrumented
;; basic block. This is the hottest function in an instrumented binary, so it does
;; the least it can: one load, one mask, one byte test, and on the rare new-edge
;; path two increments.
(defn cov-guard [(guard (ptr u32))] (-> i64)
  (if (load (cov-busy-cell))
      0
      (let [id (primitive/cast i64 (primitive/load guard))]
        (if (= id 0)
            0
            (let [slot (primitive/index (cov-bitmap) (primitive/iand id COV-MASK))]
              (if (= (primitive/cast i64 (primitive/load slot)) 0)
                  (do
                    (store! (cov-busy-cell) true)
                    (primitive/store! slot (primitive/cast u8 1))
                    (store! (cov-fresh-cell) (primitive/iadd (load (cov-fresh-cell)) 1))
                    (store! (cov-total-cell) (primitive/iadd (load (cov-total-cell)) 1))
                    (store! (cov-busy-cell) false)
                    0)
                  0))))))

(export-c [cov-init :as "__sanitizer_cov_trace_pc_guard_init"])
(export-c [cov-guard :as "__sanitizer_cov_trace_pc_guard"])

; ---------------------------------------------------------------- the queries

;; Is this binary actually instrumented? Everything above is inert otherwise, and
;; a fuzz loop that does not know the difference is just a slower random search
;; that reports coverage numbers of zero — so the runner asks, and says so.
(defn cov-instrumented? [] (-> bool)
  (> (load (cov-guards-cell)) 0))

;; How many instrumented basic blocks exist. The denominator for "how much of the
;; program has this corpus reached".
(defn cov-guards [] (-> i64)
  (load (cov-guards-cell)))

;; Distinct edges seen since the process started.
(defn cov-total [] (-> i64)
  (load (cov-total-cell)))

;; Edges seen for the FIRST time since the last call, and reset. This is the whole
;; feedback signal: run a case, ask, and keep the input if the answer is nonzero.
(defn cov-take-fresh [] (-> i64)
  (let [f (load (cov-fresh-cell))]
    (store! (cov-fresh-cell) 0)
    f))

;; Forget everything. Only for a caller that wants per-case coverage rather than
;; the cumulative picture — the fuzz loop wants cumulative, because "new" has to
;; mean new to the whole run and not new to this case.
(defn cov-clear! [] (-> i64)
  (let [(mut i) 0
        b (cov-bitmap)]
    (loop (if (>= (load i) COV-SLOTS)
              (break)
              (do
                (primitive/store! (primitive/index b (load i)) (primitive/cast u8 0))
                (store! i (primitive/iadd (load i) 1)))))
    (store! (cov-fresh-cell) 0)
    (store! (cov-total-cell) 0)
    0))
