(module coil.prop.cov)
(import "coil.primitive" :as primitive)
(import "coil.alloc" :as alloc)

; EDGE COVERAGE — the feedback channel that turns property testing into fuzzing.
;
; Random generation is blind: it produces inputs and learns nothing from what they
; did. A coverage-guided search watches which edges each input reached, and how
; often, and keeps the ones that did something new, so the corpus accumulates
; inputs that between them cover the program — and a bug behind three nested
; conditions gets found by three lucky guesses in sequence instead of one
; impossible one (Lampropoulos et al., "Coverage Guided, Property Based Testing",
; OOPSLA 2019).
;
; ── HOW THE COVERAGE GETS HERE ────────────────────────────────────────────────
;
; clang's `-fsanitize-coverage=trace-pc-guard` inserts, on every edge, a call to
; `__sanitizer_cov_trace_pc_guard` with the address of a unique 32-bit guard, plus
; one call to `__sanitizer_cov_trace_pc_guard_init` per module naming the range of
; guards it owns. Those two symbols are normally supplied by a C runtime. Here they
; are ordinary Coil functions, exported under those names.
;
; That choice is what makes this feature cost nothing when it is off:
;
;   * a NORMAL build links fine — the symbols are defined, nothing calls them, and
;     every query below answers "no coverage";
;   * an INSTRUMENTED build (`coil fuzz`) calls them, and the same queries answer
;     with real edges.
;
; ⚠ THESE FUNCTIONS MUST NOT BE INSTRUMENTED. `-fsanitize-coverage` would insert a
; call to `cov-guard` at the top of `cov-guard`, an infinite recursion before a
; single line of the body runs — so no flag inside the body could guard against
; it. `coil fuzz` excludes all of `coil.prop.*` with
; `-fsanitize-coverage-ignorelist`, and that list is the only defence.
;
; ── WHAT COUNTS AS NEW ───────────────────────────────────────────────────────
;
; An edge being reached at all is not enough signal. A parser whose stack
; overflows at depth five takes the same `[` edge at depth one and at depth four,
; so "seen / not seen" makes every nesting depth look identical and the search
; has nothing to climb. Each case therefore COUNTS its hits per edge, and a count
; is classified into AFL's buckets — 1, 2, 3, 4-7, 8-15, 16-31, 32-127, 128+. A
; FEATURE is an (edge, bucket) pair; a case is interesting when it produces a
; feature no earlier case did. Buckets rather than raw counts, because a loop
; that ran 1000 times rather than 999 is not a new behaviour, and treating it as
; one floods the corpus.
;
; The count array is only ever touched where a case actually went: the first hit
; on an edge appends it to a TOUCHED list, and classification walks that list and
; zeroes what it read. A case therefore costs in proportion to the edges it
; executed, not to the size of the program.

; 2^20 slots. Untouched (and therefore unmapped) BSS in a build that is not
; instrumented, and enough for programs far larger than a test binary. Collisions
; past that degrade the search, they do not break it: two edges sharing a slot
; share a counter.
(const COV-SLOTS 1048576)

(const COV-MASK 1048575)

; How many distinct edges one case may touch before classification falls back to
; scanning every guard. A fallback, not a limit: nothing is lost past it.
(const TOUCH-CAP 65536)

;;; Per-case hit counters, saturating at 255.
(defn cov-counters [] (-> (ptr u8))
  (primitive/cast (ptr u8) (primitive/alloc-static (array u8 1048576))))

;;; Every bucket bit ever seen, per edge: the run's accumulated coverage.
(defn cov-virgin [] (-> (ptr u8))
  (primitive/cast (ptr u8) (primitive/alloc-static (array u8 1048576))))

(defn cov-touched [] (-> (ptr u32))
  (primitive/cast (ptr u32) (primitive/alloc-static (array u32 65536))))

(defn cov-touched-cell [] (-> (ptr i64))
  (primitive/alloc-static i64))

(defn cov-overflow-cell [] (-> (ptr bool))
  (primitive/alloc-static bool))

(defn cov-edges-cell [] (-> (ptr i64))
  (primitive/alloc-static i64))

(defn cov-features-cell [] (-> (ptr i64))
  (primitive/alloc-static i64))

(defn cov-case-edges-cell [] (-> (ptr i64))
  (primitive/alloc-static i64))

(defn cov-guards-cell [] (-> (ptr i64))
  (primitive/alloc-static i64))

;;; `__sanitizer_cov_trace_pc_guard_init` — called once per instrumented module,
;;; before `main`, with the half-open range of guards that module owns.
;;;
;;; Guards start zeroed and are numbered here, densely, from 1. Zero therefore
;;; means "not a real guard", which is what lets the callback ignore a range that
;;; some other init already claimed (clang emits one init call per module and the
;;; runtime is expected to be idempotent).
(defn cov-init [(start (ptr u32)) (stop (ptr u32))] (-> i64)
  (if (or (>= start stop) (!= (primitive/cast i64 (load start)) 0))
      0
      (let [(mut p) start
            (mut n) (load (cov-guards-cell))]
        (store! (cov-last-range-cell) (primitive/iadd (load n) 1))
        (loop (if (>= (load p) stop)
                  (break)
                  (do
                    (store! n (primitive/iadd (load n) 1))
                    (store! (load p) (primitive/cast u32 (load n)))
                    (store! p (primitive/index (load p) 1)))))
        (store! (cov-guards-cell) (load n))
        0)))

;;; `__sanitizer_cov_trace_pc_guard` — called on every instrumented edge. The
;;; hottest function in an instrumented binary: a load, a mask, and a byte
;;; increment; the first hit of a case also appends to the touched list.
(defn cov-guard [(guard (ptr u32))] (-> i64)
  (let [id (primitive/cast i64 (load guard))]
    (if (= id 0)
        0
        (let [slot (primitive/iand id COV-MASK)
              p (primitive/index (cov-counters) slot)
              c (primitive/cast i64 (load p))]
          (if (= c 0)
              (do
                (store! p (primitive/cast u8 1))
                (let [n (load (cov-touched-cell))]
                  (if (< n TOUCH-CAP)
                      (do
                        (store! (primitive/index (cov-touched) n)
                                (primitive/cast u32 slot))
                        (store! (cov-touched-cell) (primitive/iadd n 1))
                        0)
                      (do (store! (cov-overflow-cell) true) 0))))
              (if (< c 255)
                  (do (store! p (primitive/cast u8 (primitive/iadd c 1))) 0)
                  0))))))

;;; The PC TABLE (`-fsanitize-coverage=pc-table`): for each module, one (pc, flags)
;;; pair per guard, in guard order, flag bit 0 marking a function's entry block.
;;; Kept so a campaign can say WHICH code it never reached — the only way to tell a
;;; good fuzz target from one that exercises a tenth of what it claims to.
;;;
;;; clang emits the pc table right after the guards' init, module by module, so the
;;; n-th table belongs to the n-th guard range and its first entry to that range's
;;; first guard id.
(const PC-MODULES 64)

(defstruct PcTable [(first-id i64) (pcs (ptr u64)) (count i64)])

(defn cov-pc-tables [] (-> (ptr PcTable))
  (primitive/cast (ptr PcTable) (primitive/alloc-static (array PcTable 64))))

(defn cov-pc-table-count-cell [] (-> (ptr i64))
  (primitive/alloc-static i64))

;;; The first guard id of the range the most recent `cov-init` numbered.
(defn cov-last-range-cell [] (-> (ptr i64))
  (primitive/alloc-static i64))

;;; `__sanitizer_cov_pcs_init`.
(defn cov-pcs-init [(beg (ptr u64)) (end (ptr u64))] (-> i64)
  (let [n (load (cov-pc-table-count-cell))]
    (if (>= n PC-MODULES)
        0
        (let [t (primitive/index (cov-pc-tables) n)]
          (store! (field t first-id) (load (cov-last-range-cell)))
          (store! (field t pcs) beg)
          (store! (field t count)
                  (primitive/udiv (primitive/isub (primitive/cast i64 end)
                                                  (primitive/cast i64 beg))
                                  16))
          (store! (cov-pc-table-count-cell) (primitive/iadd n 1))
          0))))

(export-c [cov-pcs-init :as "__sanitizer_cov_pcs_init"])

;;; The code address of guard `id`, and whether it is a function's entry. 0 and
;;; false when no pc table covers the id (a build without `pc-table`).
(defn cov-pc-entry [(id i64)] (-> (ptr u64))
  (let [n (load (cov-pc-table-count-cell))
        (mut i) 0
        (mut hit) (primitive/cast (ptr u64) 0)]
    (loop (if (or (>= (load i) n) (!= (primitive/cast i64 (load hit)) 0))
              (break)
              (let [t (primitive/index (cov-pc-tables) (load i))
                    k (primitive/isub id (load (field t first-id)))]
                (if (and (>= k 0) (< k (load (field t count))))
                    (store! hit (primitive/index (load (field t pcs)) (primitive/imul k 2)))
                    0)
                (store! i (primitive/iadd (load i) 1))
                0)))
    (load hit)))

(defn cov-pc-of [(id i64)] (-> i64)
  (let [e (cov-pc-entry id)]
    (if (= (primitive/cast i64 e) 0) 0 (primitive/cast i64 (load e)))))

(defn cov-function-entry? [(id i64)] (-> bool)
  (let [e (cov-pc-entry id)]
    (if (= (primitive/cast i64 e) 0)
        false
        (!= (primitive/iand (primitive/cast i64 (load (primitive/index e 1))) 1) 0))))

;;; Has the run reached guard `id` at all?
(defn cov-reached? [(id i64)] (-> bool)
  (!= (primitive/cast i64 (load (primitive/index (cov-virgin) (primitive/iand id COV-MASK))))
      0))

(export-c [cov-init :as "__sanitizer_cov_trace_pc_guard_init"])

(export-c [cov-guard :as "__sanitizer_cov_trace_pc_guard"])

; ---------------------------------------------------------------- the queries

;;; Is this binary actually instrumented? Everything above is inert otherwise, and
;;; a fuzz loop that does not know the difference is just a slower random search
;;; that reports coverage numbers of zero — so the runner asks, and says so.
(defn cov-instrumented? [] (-> bool)
  (> (load (cov-guards-cell)) 0))

;;; How many instrumented edges exist. The denominator for "how much of the
;;; program has this corpus reached".
(defn cov-guards [] (-> i64)
  (load (cov-guards-cell)))

;;; Distinct edges seen since the process started.
(defn cov-edges [] (-> i64)
  (load (cov-edges-cell)))

;;; Distinct (edge, hit-count bucket) features seen since the process started.
(defn cov-features [] (-> i64)
  (load (cov-features-cell)))

;;; How many distinct edges the last classified case executed.
(defn cov-case-edges [] (-> i64)
  (load (cov-case-edges-cell)))

;;; The bucket bit for a hit count: 1, 2, 3, 4-7, 8-15, 16-31, 32-127, 128+.
(defn cov-bucket [(c i64)] (-> i64)
  (cond (<= c 3) (primitive/ishl 1 (primitive/isub c 1))
        (<= c 7) 8
        (<= c 15) 16
        (<= c 31) 32
        (<= c 127) 64
        :else 128))

;; What classifying one slot found, folded into the running result: 0 nothing
;; new, 1 a new hit-count bucket on a known edge, 2 an edge never seen before.
(defn cov-classify-slot [(slot i64) (level i64)] (-> i64)
  (let [p (primitive/index (cov-counters) slot)
        c (primitive/cast i64 (load p))]
    (if (= c 0)
        level
        (let [bit (cov-bucket c)
              vp (primitive/index (cov-virgin) slot)
              v (primitive/cast i64 (load vp))]
          (store! p (primitive/cast u8 0))
          (store! (cov-case-edges-cell)
                  (primitive/iadd (load (cov-case-edges-cell)) 1))
          (if (!= (primitive/iand v bit) 0)
              level
              (do
                (store! vp (primitive/cast u8 (primitive/ior v bit)))
                (store! (cov-features-cell)
                        (primitive/iadd (load (cov-features-cell)) 1))
                (if (= v 0)
                    (do
                      (store! (cov-edges-cell)
                              (primitive/iadd (load (cov-edges-cell)) 1))
                      2)
                    (if (> level 1) level 1))))))))

;;; Classify everything since the last call, fold it into the run's coverage, and
;;; zero the counters for the next case. Returns 2 if the case reached an edge
;;; nothing had reached before, 1 if it only reached a new hit-count bucket, 0 if
;;; it did nothing new. The whole feedback signal: run a case, ask, and keep the
;;; input if the answer is nonzero.
(defn cov-case-end! [] (-> i64)
  (store! (cov-case-edges-cell) 0)
  (let [(mut level) 0]
    (if (load (cov-overflow-cell))
        (let [n (load (cov-guards-cell))
              (mut i) 1]
          (loop (if (or (> (load i) n) (>= (load i) COV-SLOTS))
                    (break)
                    (do
                      (store! level (cov-classify-slot (load i) (load level)))
                      (store! i (primitive/iadd (load i) 1)))))
          0)
        (let [n (load (cov-touched-cell))
              (mut i) 0]
          (loop (if (>= (load i) n)
                    (break)
                    (do
                      (store! level
                              (cov-classify-slot (primitive/cast i64
                                                                 (load (primitive/index (cov-touched)
                                                                                        (load i))))
                                                 (load level)))
                      (store! i (primitive/iadd (load i) 1)))))
          0))
    (store! (cov-touched-cell) 0)
    (store! (cov-overflow-cell) false)
    (load level)))

;;; Throw away whatever was counted since the last classification without folding
;;; it into the run's coverage. Called before a case, so that edges the harness
;;; itself executed between cases are not credited to the input.
(defn cov-case-begin! [] (-> i64)
  (if (load (cov-overflow-cell))
      (let [(mut i) 0]
        (loop (if (>= (load i) COV-SLOTS)
                  (break)
                  (do
                    (store! (primitive/index (cov-counters) (load i))
                            (primitive/cast u8 0))
                    (store! i (primitive/iadd (load i) 1)))))
        0)
      (let [n (load (cov-touched-cell))
            (mut i) 0]
        (loop (if (>= (load i) n)
                  (break)
                  (do
                    (store! (primitive/index (cov-counters)
                                             (primitive/cast i64
                                                             (load (primitive/index (cov-touched)
                                                                                    (load i)))))
                            (primitive/cast u8 0))
                    (store! i (primitive/iadd (load i) 1)))))
        0))
  (store! (cov-touched-cell) 0)
  (store! (cov-overflow-cell) false)
  0)

;;; Forget the run's accumulated coverage as well as the current case. For
;;; corpus minimization, which replays the corpus against a clean slate.
(defn cov-clear! [] (-> i64)
  (cov-case-begin!)
  (let [(mut i) 0
        b (cov-virgin)]
    (loop (if (>= (load i) COV-SLOTS)
              (break)
              (do
                (store! (primitive/index b (load i)) (primitive/cast u8 0))
                (store! i (primitive/iadd (load i) 1)))))
    (store! (cov-edges-cell) 0)
    (store! (cov-features-cell) 0)
    0))

; ═══════════════════════════════════════════════ comparison feedback (trace-cmp)
;
; Edge coverage tells the search WHERE it got to. It does not tell it what to
; try next, so a comparison against a magic value is climbed one byte at a time:
; each correct byte opens a branch, the input is kept, and the next byte is
; guessed. Four bytes cost four rounds of guessing — better than the product, but
; still guessing.
;
; `-fsanitize-coverage=trace-cmp` closes that gap. clang calls one of these on
; every integer comparison with BOTH OPERANDS, so a failed `byte == 'F'` hands us
; the 70 we needed. Feeding those observed constants back into the mutator turns
; "guess a byte, 1 in 95" into "use the value the program just asked for" — which
; is libFuzzer's auto-dictionary, and the reason it solves magic values in one
; step rather than one byte per step.
;
; The tape makes the trick unusually direct. A byte-level fuzzer has to guess
; WHERE in the input the wanted value belongs; here the mutator is already choosing
; a specific `Choice` to change, and every choice carries the range it must lie in,
; so a dictionary value is either in range for that choice or is skipped.
;
; ⚠ SIGNAL, NOT VOLUME. Every integer comparison in the program calls in here,
; millions of times a second, and almost all of them are the engine comparing loop
; counters. Two things keep the dictionary meaningful:
;   * the build ignorelists `coil.prop.*`, so only the code under test reports;
;   * only FAILED comparisons are recorded — an equality that already holds is not
;     something the search needs help reaching.
; What is left is small enough that a 64-entry ring holds a useful window, and the
; ring never scans or deduplicates: one store and one increment, because this runs
; on a path hotter than anything else in the process.
(const DICT-SLOTS 64)

(const DICT-MASK 63)

; 64 pairs, stored interleaved: values[2i] is what the input held, values[2i+1]
; what the comparison wanted.
(defn dict-values [] (-> (ptr i64))
  (primitive/cast (ptr i64) (primitive/alloc-static (array i64 128))))

(defn dict-write-cell [] (-> (ptr i64))
  (primitive/alloc-static i64))

(defn dict-count-cell [] (-> (ptr i64))
  (primitive/alloc-static i64))

(defn dict-on-cell [] (-> (ptr bool))
  (primitive/alloc-static bool))

;;; Record a failed comparison as the PAIR of what was there and what was wanted.
;;;
;;; Storing the operands as a pair, rather than as two loose values, is what makes
;;; the feedback precise. A flat dictionary can only say "70 was interesting
;;; somewhere" and leaves the mutator to guess which of the input's choices should
;;; become 70 — and it fills up with the runtime side of every comparison, which is
;;; whatever the input happened to hold and is pure noise. A pair says "wherever
;;; you see THIS value, the program wanted THAT one", so the substitution is
;;; directed by the input's own contents. That correspondence is the idea behind
;;; Redqueen's input-to-state substitution and libFuzzer's table of recent
;;; comparisons; it is the difference between a hint and an answer.
(defn dict-push-pair! [(a i64) (b i64)] (-> i64)
  (if (or (not (load (dict-on-cell))) (= a b))
      0
      (let [w (primitive/iand (load (dict-write-cell)) DICT-MASK)]
        (store! (primitive/index (dict-values) (primitive/imul w 2)) a)
        (store! (primitive/index (dict-values)
                                 (primitive/iadd (primitive/imul w 2) 1))
                b)
        (store! (dict-write-cell) (primitive/iadd (load (dict-write-cell)) 1))
        (if (< (load (dict-count-cell)) DICT-SLOTS)
            (store! (dict-count-cell)
                    (primitive/iadd (load (dict-count-cell)) 1))
            0)
        0)))

;;; The mutator turns recording on around the property call and off again, so the
;;; dictionary describes the code under test rather than the loop that drives it.
(defn cov-cmp-record! [(on bool)] (-> i64)
  (store! (dict-on-cell) on)
  0)

;;; How many pairs are held, and each side of one.
(defn cov-dict-count [] (-> i64)
  (load (dict-count-cell)))

(defn cov-dict-lhs [(i i64)] (-> i64)
  (if (or (< i 0) (>= i (load (dict-count-cell))))
      0
      (load (primitive/index (dict-values)
                             (primitive/imul (primitive/iand i DICT-MASK) 2)))))

(defn cov-dict-rhs [(i i64)] (-> i64)
  (if (or (< i 0) (>= i (load (dict-count-cell))))
      0
      (load (primitive/index (dict-values)
                             (primitive/iadd (primitive/imul (primitive/iand i
                                                                             DICT-MASK)
                                                             2)
                                             1)))))

;;; The value the program wanted where `current` was found, or `current` when
;;; nothing in the window mentions it.
;;;
;;; A linear scan of 64 pairs, and it runs once per mutated choice rather than once
;;; per comparison, so it is nowhere near a hot path — the hot path is
;;; `dict-push-pair!`, which is a masked index and two stores.
(defn cov-dict-counterpart [(current i64)] (-> i64)
  (let [n (load (dict-count-cell))
        (mut i) 0
        (mut found) current]
    (loop (if (or (>= (load i) n) (!= (load found) current))
              (break)
              (do
                (if (= (cov-dict-lhs (load i)) current)
                    (store! found (cov-dict-rhs (load i)))
                    (if (= (cov-dict-rhs (load i)) current)
                        (store! found (cov-dict-lhs (load i)))
                        0))
                (store! i (primitive/iadd (load i) 1)))))
    (load found)))

; ── the callbacks ────────────────────────────────────────────────────────────
;
; `trace_const_cmpN` is emitted when one operand is a compile-time constant, and
; the CONSTANT IS THE FIRST ARGUMENT — that is the interesting one, because it is
; the value the input needed to be. `trace_cmpN` compares two runtime values, so
; either might be what the other wanted and both are recorded.

; Both callback families record the same thing — the two operands of a comparison
; that did not hold — because with pairs it does not matter which side is the
; constant. `trace_const_cmp` documents the constant as the first argument, but
; nothing here has to rely on that.
(defn cmp-const [(a i64) (b i64)] (-> i64)
  (dict-push-pair! a b))

(defn cmp-both [(a i64) (b i64)] (-> i64)
  (dict-push-pair! a b))

(defn cov-const-cmp1 [(a u8) (b u8)] (-> i64)
  (cmp-const (primitive/cast i64 a) (primitive/cast i64 b)))

(defn cov-const-cmp2 [(a u16) (b u16)] (-> i64)
  (cmp-const (primitive/cast i64 a) (primitive/cast i64 b)))

(defn cov-const-cmp4 [(a u32) (b u32)] (-> i64)
  (cmp-const (primitive/cast i64 a) (primitive/cast i64 b)))

(defn cov-const-cmp8 [(a u64) (b u64)] (-> i64)
  (cmp-const (primitive/cast i64 a) (primitive/cast i64 b)))

(defn cov-cmp1 [(a u8) (b u8)] (-> i64)
  (cmp-both (primitive/cast i64 a) (primitive/cast i64 b)))

(defn cov-cmp2 [(a u16) (b u16)] (-> i64)
  (cmp-both (primitive/cast i64 a) (primitive/cast i64 b)))

(defn cov-cmp4 [(a u32) (b u32)] (-> i64)
  (cmp-both (primitive/cast i64 a) (primitive/cast i64 b)))

(defn cov-cmp8 [(a u64) (b u64)] (-> i64)
  (cmp-both (primitive/cast i64 a) (primitive/cast i64 b)))

;;; A `switch`'s case labels are magic values with a different spelling. The layout
;;; is fixed by the instrumentation: cases[0] is how many there are, cases[1] the
;;; operand's bit width, and the labels follow.
(defn cov-switch [(val u64) (cases (ptr u64))] (-> i64)
  (if (not (load (dict-on-cell)))
      0
      (let [n (primitive/cast i64 (load cases))
            (mut i) 0]
        (loop (if (or (>= (load i) n) (>= (load i) 64))
                  (break)
                  (do
                    (dict-push-pair! (primitive/cast i64 val)
                                     (primitive/cast i64
                                                     (load (primitive/index cases
                                                                            (primitive/iadd (load i)
                                                                                            2)))))
                    (store! i (primitive/iadd (load i) 1)))))
        0)))

(export-c [cov-const-cmp1 :as "__sanitizer_cov_trace_const_cmp1"])

(export-c [cov-const-cmp2 :as "__sanitizer_cov_trace_const_cmp2"])

(export-c [cov-const-cmp4 :as "__sanitizer_cov_trace_const_cmp4"])

(export-c [cov-const-cmp8 :as "__sanitizer_cov_trace_const_cmp8"])

(export-c [cov-cmp1 :as "__sanitizer_cov_trace_cmp1"])

(export-c [cov-cmp2 :as "__sanitizer_cov_trace_cmp2"])

(export-c [cov-cmp4 :as "__sanitizer_cov_trace_cmp4"])

(export-c [cov-cmp8 :as "__sanitizer_cov_trace_cmp8"])

(export-c [cov-switch :as "__sanitizer_cov_trace_switch"])
