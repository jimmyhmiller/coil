; REPL lowering. In a `replsession` module, every ordinary defn is
; replaced by a private implementation. The public name is represented by one
; alloc-static Var cell, and calls through that name load the cell first.
(module coil.jit.reload)

(import "coil.primitive" :as primitive)
(import "coil.control" :use *)
(import "coil.str" :as str)

(defn rr-sym? [(x Code) (s Code)] (-> bool)
  (and (primitive/code-sym? x) (primitive/code-eq x s)))

(defn rr-defn? [(f Code)] (-> bool)
  (and (primitive/code-list? f)
       (and (>= (primitive/code-count f) 5)
            (and (rr-sym? (primitive/code-nth f 0) `defn)
                 (primitive/code-sym? (primitive/code-nth f 1))))))

(defn rr-vector? [(x Code)] (-> bool)
  (and (primitive/code-list? x) (str/starts-with (primitive/code-src x) "[")))

(defn rr-generic-defn? [(f Code)] (-> bool)
  (and (rr-defn? f)
       (and (>= (primitive/code-count f) 6)
            (and (rr-vector? (primitive/code-nth f 2))
                 (rr-vector? (primitive/code-nth f 3))))))

(defn rr-internal-name? [(name Code)] (-> bool)
  (let [s (primitive/code-str name)]
    (or (= s "__repl_init")
        (or (= s "__repl_eval")
            (or (= s "__repl_probe")
                (or (= s "main")
                ; gensym spellings and generated cell accessors must survive
                ; the transform's next fixpoint round unchanged.
                (or (str/starts-with s "$g")
                    (match (str/str-find s "--repl-")
                      (Some [_] true)
                      (None [] false)))))))))

(defn rr-reload-defn? [(f Code)] (-> bool)
  (and (rr-defn? f)
       (and (not (rr-generic-defn? f))
            (not (rr-internal-name? (primitive/code-nth f 1))))))

(defn rr-generated-defn? [(f Code)] (-> bool)
  (if (rr-defn? f)
      (let [s (primitive/code-str (primitive/code-nth f 1))]
        (or (str/starts-with s "$g")
            (match (str/str-find s "--repl-")
              (Some [_] true)
              (None [] false))))
      false))

(defn rr-module? [(m Code)] (-> bool)
  (and (> (primitive/code-count m) 0)
       (= (primitive/code-str (primitive/code-nth m 0)) "replsession")))

(defn rr-name-defined? [(m Code) (name Code) (i i64) (n i64)] (-> bool)
  (if (>= i n)
      false
      (let [f (primitive/code-nth m i)]
        (if (and (rr-reload-defn? f)
                 (primitive/code-eq (primitive/code-nth f 1) name))
            true
            (rr-name-defined? m name (primitive/iadd i 1) n)))))

(defn rr-compatible-before? [(m Code) (f Code) (i i64)] (-> bool)
  (if (<= i 1)
      true
      (let [prev (primitive/code-nth m (primitive/isub i 1))]
        (if (and (rr-reload-defn? prev)
                 (primitive/code-eq (primitive/code-nth prev 1)
                                    (primitive/code-nth f 1)))
            (and (primitive/code-eq (primitive/code-nth prev 2)
                                    (primitive/code-nth f 2))
                 (primitive/code-eq (primitive/code-nth prev 3)
                                    (primitive/code-nth f 3)))
            (rr-compatible-before? m f (primitive/isub i 1))))))

(defn rr-first-def [(m Code) (name Code) (i i64) (n i64)] (-> Code)
  (if (>= i n)
      name
      (let [f (primitive/code-nth m i)]
        (if (and (rr-reload-defn? f)
                 (primitive/code-eq (primitive/code-nth f 1) name))
            f
            (rr-first-def m name (primitive/iadd i 1) n)))))

; Rewrite a reloadable function value to its stable Var, and rewrite calls
; through that Var. This is what makes `(let [f twice] (f x))` reload too.
(defn rr-value [(name Code)] (-> Code)
  (let [cell (primitive/code-symbol name "--repl-cell")]
    `(load (~cell))))

(defn rr-bound? [(bound Code) (name Code) (i i64) (n i64)] (-> bool)
  (if (>= i n)
      false
      (if (primitive/code-eq (primitive/code-nth bound i) name)
          true
          (rr-bound? bound name (primitive/iadd i 1) n))))

(defn rr-binding-name [(x Code)] (-> Code)
  (if (primitive/code-sym? x) x (primitive/code-nth x 1)))

(defn rr-binding-names [(bindings Code) (i i64) (n i64)] (-> Code)
  (if (>= i n)
      `()
      `(~(rr-binding-name (primitive/code-nth bindings i))
        ~@(rr-binding-names bindings (primitive/iadd i 2) n))))

(defn rr-param-names [(params Code) (i i64) (n i64)] (-> Code)
  (if (>= i n)
      `()
      `(~(primitive/code-nth (primitive/code-nth params i) 0)
        ~@(rr-param-names params (primitive/iadd i 1) n))))

(defn rr-let-bindings [(bindings Code) (m Code) (bound Code) (i i64) (n i64)] (-> Code)
  (if (>= i n)
      `()
      `(~(primitive/code-nth bindings i)
        ~(if (< (primitive/iadd i 1) n)
             (rr-expr (primitive/code-nth bindings (primitive/iadd i 1)) m bound)
             (primitive/code-nth bindings i))
        ~@(rr-let-bindings bindings m bound (primitive/iadd i 2) n))))

(defn rr-expr [(x Code) (m Code) (bound Code)] (-> Code)
  ; code-list? intentionally includes vectors. The committed bootstrap predates
  ; code-vector?, so preserve bracketed nodes by their original source spelling.
  (if (and (primitive/code-list? x)
           (str/starts-with (primitive/code-src x) "["))
      x
      (if (primitive/code-list? x)
      (if (and (> (primitive/code-count x) 1)
               (rr-sym? (primitive/code-nth x 0) `let))
          (let [bindings (primitive/code-nth x 1)]
          `(let [~@(rr-let-bindings bindings m bound 0 (primitive/code-count bindings))]
             ~@(rr-exprs x
                         m
                         `(~@(rr-binding-names bindings 0 (primitive/code-count bindings)) ~@bound)
                         2
                         (primitive/code-count x)))
          )
          (if (and (> (primitive/code-count x) 0)
               (and (primitive/code-sym? (primitive/code-nth x 0))
                    (rr-name-defined? m
                                      (primitive/code-nth x 0)
                                      1
                                      (primitive/code-count m))
                    (not (rr-bound? bound
                                    (primitive/code-nth x 0)
                                    0
                                    (primitive/code-count bound)))))
          (let [name (primitive/code-nth x 0)
                cell (primitive/code-symbol name "--repl-cell")
                callee (primitive/gensym)]
            `(let [~callee (load (~cell))]
               (~callee ~@(rr-exprs x m bound 1 (primitive/code-count x)))))
          `(~@(rr-exprs x m bound 0 (primitive/code-count x)))))
      (if (and (primitive/code-sym? x)
               (and (rr-name-defined? m x 1 (primitive/code-count m))
                    (not (rr-bound? bound x 0 (primitive/code-count bound)))))
          (rr-value x)
          x))))

(defn rr-exprs [(x Code) (m Code) (bound Code) (i i64) (n i64)] (-> Code)
  (if (>= i n)
      `()
      `(~(rr-expr (primitive/code-nth x i) m bound)
        ~@(rr-exprs x m bound (primitive/iadd i 1) n))))

(defn rr-param-types [(params Code) (i i64) (n i64)] (-> Code)
  (if (>= i n)
      `()
      `(~(primitive/code-nth (primitive/code-nth params i) 1)
        ~@(rr-param-types params (primitive/iadd i 1) n))))

(defn rr-body [(f Code) (m Code) (bound Code) (i i64) (n i64)] (-> Code)
  (if (>= i n)
      `()
      `(~(rr-expr (primitive/code-nth f i) m bound)
        ~@(rr-body f m bound (primitive/iadd i 1) n))))

(defn rr-lower-defn [(m Code) (f Code) (i i64)] (-> Code)
  (unless (rr-vector? (primitive/code-nth f 2))
    (primitive/error "repl lowering: source parameter form is not a vector"))
  (if (rr-compatible-before? m f i)
      0
      (do
        (primitive/report f "cannot redefine a REPL function with a different signature")
        0))
  (let [name (primitive/code-nth f 1)
        params (primitive/code-nth f 2)
        retform (primitive/code-nth f 3)
        first-def (rr-first-def m name 1 (primitive/code-count m))
        stable-params (primitive/code-nth first-def 2)
        stable-retform (primitive/code-nth first-def 3)
        stable-ret (primitive/code-nth stable-retform 1)
        cell (primitive/code-symbol name "--repl-cell")
        last (not (rr-name-defined? m name (primitive/iadd i 1) (primitive/code-count m)))
        impl (if last (primitive/code-symbol name "--repl-current") (primitive/gensym))]
    `((defn ~impl
        ~(primitive/code-nth f 2)
        ~(primitive/code-nth f 3)
        ~@(rr-body f
                   m
                   (rr-param-names params 0 (primitive/code-count params))
                   4
                   (primitive/code-count f)))
      ~@(if last
            `((defn ~cell []
                (-> (ptr (coil.var/Var
                           (fnptr c [~@(rr-param-types stable-params 0 (primitive/code-count stable-params))] ~stable-ret))))
                (let [slot (primitive/alloc-static
                             (coil.var/Var
                               (fnptr c [~@(rr-param-types stable-params 0 (primitive/code-count stable-params))] ~stable-ret)))]
                  ; The cell address survives JIT generations. Rebind on access
                  ; so a newly loaded generation always installs its newest body.
                  (store! slot (coil.var/var-new (primitive/fnptr-of ~impl)))
                  slot)))
            `()))))

(defn rr-forms [(m Code) (i i64) (n i64)] (-> Code)
  (if (>= i n)
      `()
      (let [f (primitive/code-nth m i)]
        (if (rr-reload-defn? f)
            `(~@(rr-lower-defn m f i)
              ~@(rr-forms m (primitive/iadd i 1) n))
            (if (rr-generated-defn? f)
                `(~f ~@(rr-forms m (primitive/iadd i 1) n))
                (if (rr-generic-defn? f)
                    `(~f ~@(rr-forms m (primitive/iadd i 1) n))
                    (if (rr-defn? f)
                    `((defn ~(primitive/code-nth f 1)
                        ~(primitive/code-nth f 2)
                        ~(primitive/code-nth f 3)
                        ~@(rr-body f
                                   m
                                   (rr-param-names (primitive/code-nth f 2)
                                                   0
                                                   (primitive/code-count (primitive/code-nth f 2)))
                                   4
                                   (primitive/code-count f)))
                      ~@(rr-forms m (primitive/iadd i 1) n))
                    `(~(rr-expr f m `())
                      ~@(rr-forms m (primitive/iadd i 1) n)))))))))

(defn rr-module [(m Code)] (-> Code)
  (if (rr-module? m)
      `(~(primitive/code-nth m 0)
        ~@(rr-forms m 1 (primitive/code-count m)))
      m))

(defn rr-modules [(mods Code) (i i64) (n i64)] (-> Code)
  (if (>= i n)
      `()
      `(~(rr-module (primitive/code-nth mods i))
        ~@(rr-modules mods (primitive/iadd i 1) n))))

(defn repl-reload-transform [(mods Code)] (-> Code)
  `(do ~@(rr-modules mods 0 (primitive/code-count mods))))

(transform repl-reload-transform :phase before-expand)
