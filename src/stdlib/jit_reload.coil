; Native reload lowering. In a `replsession` module, or an ordinary module that
; contains the `(reloadable-module)` opt-in marker, every ordinary defn is
; replaced by a private implementation. The public name is represented by one
; alloc-static Var cell, and calls through that name load the cell first.
(module coil.jit.reload)

(import "coil.primitive" :as primitive)
(import "coil.alloc" :use [malloc-allocator])
(import "coil.control" :use *)
(import "coil.str" :as str)
(import "coil.var" :as var)

(defn rr-sym? [(x Code) (s Code)] (-> bool)
  (and (primitive/code-sym? x) (primitive/code-eq x s)))

(defn rr-defn? [(f Code)] (-> bool)
  (and (primitive/code-list? f)
       (and (>= (primitive/code-count f) 5)
            (and (rr-sym? (primitive/code-nth f 0) `defn)
                 (primitive/code-sym? (primitive/code-nth f 1))))))

(defn rr-vector? [(x Code)] (-> bool)
  (and (primitive/code-list? x) (str/starts-with (primitive/code-src x) "[")))

(defn rr-generic-defn? [(f Code)] (-> bool)
  (and (rr-defn? f)
       (and (>= (primitive/code-count f) 6)
            (and (rr-vector? (primitive/code-nth f 2))
                 (rr-vector? (primitive/code-nth f 3))))))

(defn rr-internal-name? [(name Code)] (-> bool)
  (let [s (primitive/code-str name)]
    (or (= s "__repl_init")
        (or (= s "__repl_eval")
            (or (= s "__repl_probe")
                (or (= s "main")
                ; gensym spellings and generated cell accessors must survive
                ; the transform's next fixpoint round unchanged.
                (or (str/starts-with s "$g")
                    (match (str/str-find s "--repl-")
                      (Some [_] true)
                      (None [] false)))))))))

(defn rr-reload-defn? [(f Code)] (-> bool)
  (and (rr-defn? f)
       (and (not (rr-generic-defn? f))
            (not (rr-internal-name? (primitive/code-nth f 1))))))

(defn rr-generated-defn? [(f Code)] (-> bool)
  (if (rr-defn? f)
      (let [s (primitive/code-str (primitive/code-nth f 1))]
        (or (str/starts-with s "$g")
            (match (str/str-find s "--repl-")
              (Some [_] true)
              (None [] false))))
      false))

(defn rr-marker? [(f Code)] (-> bool)
  (and (primitive/code-list? f)
       (and (= (primitive/code-count f) 1)
            (rr-sym? (primitive/code-nth f 0) `reloadable-module))))

; Compiler-owned declaration installed from the last accepted checked Program.
; A one-definition submission intentionally does not repeat its surrounding
; struct declarations, but reload-cell lowering still needs their native ABI.
(defn rr-struct-marker? [(f Code)] (-> bool)
  (and (primitive/code-list? f)
       (and (= (primitive/code-count f) 2)
            (rr-sym? (primitive/code-nth f 0) `reload-struct))))

; Compiler-owned signature retained from an accepted REPL definition.  It gives
; a one-definition submission enough surface to resolve/check calls without
; replaying the old implementation through expansion, mono, and codegen.
(defn rr-function-marker? [(f Code)] (-> bool)
  (and (primitive/code-list? f)
       (and (= (primitive/code-count f) 4)
            (and (rr-sym? (primitive/code-nth f 0) `reload-function)
                 (primitive/code-sym? (primitive/code-nth f 1))))))

(defn rr-function-form? [(f Code)] (-> bool)
  (or (rr-reload-defn? f) (rr-function-marker? f)))

(defn rr-has-marker? [(m Code) (i i64)] (-> bool)
  (if (>= i (primitive/code-count m))
      false
      (if (rr-marker? (primitive/code-nth m i))
          true
          (rr-has-marker? m (+ i 1)))))

(defn rr-module? [(m Code)] (-> bool)
  (and (> (primitive/code-count m) 0)
       (or (= (primitive/code-str (primitive/code-nth m 0)) "replsession")
           (rr-has-marker? m 1))))

(defn rr-name-defined? [(m Code) (name Code) (i i64) (n i64)] (-> bool)
  (if (>= i n)
      false
      (let [f (primitive/code-nth m i)]
        (if (and (rr-function-form? f)
                 (primitive/code-eq (primitive/code-nth f 1) name))
            true
            (rr-name-defined? m name (primitive/iadd i 1) n)))))

(defn rr-compatible-before? [(m Code) (f Code) (i i64)] (-> bool)
  (if (<= i 1)
      true
      (let [prev (primitive/code-nth m (primitive/isub i 1))]
        (if (and (rr-reload-defn? prev)
                 (primitive/code-eq (primitive/code-nth prev 1)
                                    (primitive/code-nth f 1)))
            (and (primitive/code-eq (primitive/code-nth prev 2)
                                    (primitive/code-nth f 2))
                 (primitive/code-eq (primitive/code-nth prev 3)
                                    (primitive/code-nth f 3)))
            (rr-compatible-before? m f (primitive/isub i 1))))))

(defn rr-first-def [(m Code) (name Code) (i i64) (n i64)] (-> Code)
  (if (>= i n)
      name
      (let [f (primitive/code-nth m i)]
        (if (and (rr-function-form? f)
                 (primitive/code-eq (primitive/code-nth f 1) name))
            f
            (rr-first-def m name (primitive/iadd i 1) n)))))

(defn rr-code-hash [(node Code) (seed i64)] (-> i64)
  (if (primitive/code-list? node)
      (let [(mut h) (+ (* seed 1099511628211) (primitive/code-count node))]
        (for [i 0 (primitive/code-count node)]
          (set! h (rr-code-hash (primitive/code-nth node i) (load h))))
        (load h))
      (+ (* seed 1099511628211) (str/str-hash (primitive/code-str node)))))

(defn rr-signature-suffix [(f Code) (label (slice u8))] (-> (slice u8))
  (let [(mut out) (str/sb-new (malloc-allocator))
        hash (rr-code-hash (primitive/code-nth f 3)
               (rr-code-hash (primitive/code-nth f 2) 1469598103934665603))]
    (str/sb-push-str! (mut out) label)
    (str/sb-push-i64! (mut out) hash)
    (str/sb-finish! (mut out))))

(defn rr-cell-name [(f Code)] (-> Code)
  ; hygiene: reload cells are stable public declarations shared across JIT generations.
  (primitive/syntax->datum
    (primitive/code-symbol (primitive/code-nth f 1)
                           (rr-signature-suffix f "--repl-cell-"))))

(defn rr-cell-init-name [(f Code)] (-> Code)
  ; hygiene: reload initialization declarations intentionally share their stable caller-visible names across generations.
  (primitive/syntax->datum
    (primitive/code-symbol (primitive/code-nth f 1)
                           (rr-signature-suffix f "--repl-cell-init-"))))

(defn rr-binder-name [(f Code)] (-> Code)
  ; hygiene: reload binders are stable public declarations addressed by later generations.
  (primitive/syntax->datum
    (primitive/code-symbol (primitive/code-nth f 1)
                           (rr-signature-suffix f "--repl-bind-"))))

(defn rr-trampoline-name [(f Code)] (-> Code)
  ; hygiene: ABI trampolines intentionally retain stable public identity across implementations.
  (primitive/syntax->datum
    (primitive/code-symbol (primitive/code-nth f 1)
                           (rr-signature-suffix f "--repl-trampoline-"))))

(defn rr-trampoline-cell-name [(f Code)] (-> Code)
  ; hygiene: trampoline cells intentionally retain stable public identity across implementations.
  (primitive/syntax->datum
    (primitive/code-symbol (primitive/code-nth f 1)
                           (rr-signature-suffix f "--repl-trampoline-cell-"))))

(defn rr-trampoline-init-name [(f Code)] (-> Code)
  ; hygiene: trampoline initialization declarations intentionally retain stable public identity.
  (primitive/syntax->datum
    (primitive/code-symbol (primitive/code-nth f 1)
                           (rr-signature-suffix f "--repl-trampoline-init-"))))

; A reloadable function value is its permanent ABI-specific trampoline pointer.
; Coil function pointers are invoked explicitly with `call-ptr`; direct named
; calls below continue to use the typed Var implementation cell.
(defn rr-value [(name Code) (m Code)] (-> Code)
  ; The REPL transform and later reloads communicate through stable public
  ; declaration spellings; make that context removal explicit.
  ; hygiene: reload cells intentionally use stable caller-visible declaration names.
  (let [f (rr-first-def m name 1 (primitive/code-count m))
        cell (rr-trampoline-cell-name f)]
    `(load (~cell))))

(defn rr-bound? [(bound Code) (name Code) (i i64) (n i64)] (-> bool)
  (if (>= i n)
      false
      (if (primitive/code-eq (primitive/code-nth bound i) name)
          true
          (rr-bound? bound name (primitive/iadd i 1) n))))

(defn rr-binding-name [(x Code)] (-> Code)
  (if (primitive/code-sym? x) x (primitive/code-nth x 1)))

;; The list walkers below build with a growable Code list, not `(~x ~@(self …)):
;; splicing the recursion's result rebuilds the suffix at every level, which is
;; quadratic in the element count (docs/design/META_MEMORY.md).
(defn rr-binding-names [(bindings Code) (i i64) (n i64)] (-> Code)
  (let [out (primitive/code-list-new)
        (mut k) i]
    (loop (if (>= (load k) n)
              (break)
              (do (primitive/code-list-push! out (rr-binding-name (primitive/code-nth bindings (load k))))
                  (store! k (primitive/iadd (load k) 2)))))
    (primitive/code-list-done out)))

(defn rr-param-names [(params Code) (i i64) (n i64)] (-> Code)
  (let [out (primitive/code-list-new)
        (mut k) i]
    (loop (if (>= (load k) n)
              (break)
              (do (primitive/code-list-push! out (primitive/code-nth (primitive/code-nth params (load k)) 0))
                  (store! k (primitive/iadd (load k) 1)))))
    (primitive/code-list-done out)))

(defn rr-let-bindings [(bindings Code) (m Code) (bound Code) (i i64) (n i64)] (-> Code)
  (let [out (primitive/code-list-new)
        (mut k) i]
    (loop (if (>= (load k) n)
              (break)
              (do (primitive/code-list-push! out (primitive/code-nth bindings (load k)))
                  (primitive/code-list-push! out
                    (if (< (primitive/iadd (load k) 1) n)
                        (rr-expr (primitive/code-nth bindings (primitive/iadd (load k) 1)) m bound)
                        (primitive/code-nth bindings (load k))))
                  (store! k (primitive/iadd (load k) 2)))))
    (primitive/code-list-done out)))

(defn rr-expr [(x Code) (m Code) (bound Code)] (-> Code)
  ; code-list? intentionally includes vectors. The committed bootstrap predates
  ; code-vector?, so preserve bracketed nodes by their original source spelling.
  (if (and (primitive/code-list? x)
           (str/starts-with (primitive/code-src x) "["))
      x
      (if (primitive/code-list? x)
      (if (and (> (primitive/code-count x) 1)
               (rr-sym? (primitive/code-nth x 0) `let))
          (let [bindings (primitive/code-nth x 1)]
          `(let [~@(rr-let-bindings bindings m bound 0 (primitive/code-count bindings))]
             ~@(rr-exprs x
                         m
                         `(~@(rr-binding-names bindings 0 (primitive/code-count bindings)) ~@bound)
                         2
                         (primitive/code-count x)))
          )
          (if (and (> (primitive/code-count x) 0)
               (and (primitive/code-sym? (primitive/code-nth x 0))
                    (rr-name-defined? m
                                      (primitive/code-nth x 0)
                                      1
                                      (primitive/code-count m))
                    (not (rr-bound? bound
                                    (primitive/code-nth x 0)
                                    0
                                    (primitive/code-count bound)))))
          (let [name (primitive/code-nth x 0)
                ; hygiene: rewritten calls intentionally target the stable caller-visible reload cell.
                first-def (rr-first-def m name 1 (primitive/code-count m))
                cell (rr-cell-name first-def)
                callee (primitive/fresh-identifier "temporary")]
            `(let [~callee (load (~cell))]
               (~callee ~@(rr-exprs x m bound 1 (primitive/code-count x)))))
          `(~@(rr-exprs x m bound 0 (primitive/code-count x)))))
      (if (and (primitive/code-sym? x)
               (and (rr-name-defined? m x 1 (primitive/code-count m))
                    (not (rr-bound? bound x 0 (primitive/code-count bound)))))
          (rr-value x m)
          x))))

(defn rr-exprs [(x Code) (m Code) (bound Code) (i i64) (n i64)] (-> Code)
  (let [out (primitive/code-list-new)
        (mut k) i]
    (loop (if (>= (load k) n)
              (break)
              (do (primitive/code-list-push! out (rr-expr (primitive/code-nth x (load k)) m bound))
                  (store! k (primitive/iadd (load k) 1)))))
    (primitive/code-list-done out)))

(defn rr-struct-type? [(m Code) (t Code)] (-> bool)
  (let [(mut i) 1 (mut found) false]
    (loop (if (or (load found) (>= (load i) (primitive/code-count m)))
              (break)
              (let [f (primitive/code-nth m (load i))]
                (if (and (primitive/code-list? f)
                         (and (>= (primitive/code-count f) 2)
                              (and (or (rr-sym? (primitive/code-nth f 0) `defstruct)
                                       (rr-struct-marker? f))
                                   (primitive/code-eq (primitive/code-nth f 1) t))))
                    (set! found true)
                    (set! i (primitive/iadd (load i) 1))))))
    (load found)))

; Checked Coil passes nominal structs by reference. The reload cell describes
; the post-check native ABI, not merely the surface spelling of the parameter.
(defn rr-abi-param-type [(m Code) (t Code)] (-> Code)
  (if (rr-struct-type? m t) `(ref ~t) t))

(defn rr-param-types [(m Code) (params Code) (i i64) (n i64)] (-> Code)
  (let [out (primitive/code-list-new)
        (mut k) i]
    (loop (if (>= (load k) n)
              (break)
              (do (primitive/code-list-push! out
                    (rr-abi-param-type m
                      (primitive/code-nth (primitive/code-nth params (load k)) 1)))
                  (store! k (primitive/iadd (load k) 1)))))
    (primitive/code-list-done out)))

(defn rr-body [(f Code) (m Code) (bound Code) (i i64) (n i64)] (-> Code)
  (let [out (primitive/code-list-new)
        (mut k) i]
    (loop (if (>= (load k) n)
              (break)
              (do (primitive/code-list-push! out (rr-expr (primitive/code-nth f (load k)) m bound))
                  (store! k (primitive/iadd (load k) 1)))))
    (primitive/code-list-done out)))

(defn rr-lower-defn [(m Code) (f Code) (i i64)] (-> Code)
  (unless (rr-vector? (primitive/code-nth f 2))
    (primitive/error "repl lowering: source parameter form is not a vector"))
  (if (rr-compatible-before? m f i)
      0
      (do
        (primitive/report f "cannot redefine a REPL function with a different signature")
        0))
  (let [name (primitive/code-nth f 1)
        params (primitive/code-nth f 2)
        retform (primitive/code-nth f 3)
        first-def (rr-first-def m name 1 (primitive/code-count m))
        stable-params (primitive/code-nth first-def 2)
        stable-retform (primitive/code-nth first-def 3)
        stable-ret (primitive/code-nth stable-retform 1)
        ; hygiene: reload implementations and cells intentionally use stable public names.
        cell (rr-cell-name first-def)
        cell-init (rr-cell-init-name first-def)
        binder (rr-binder-name first-def)
        trampoline (rr-trampoline-name first-def)
        trampoline-cell (rr-trampoline-cell-name first-def)
        trampoline-init (rr-trampoline-init-name first-def)
        last (not (rr-name-defined? m name (primitive/iadd i 1) (primitive/code-count m)))
        ; hygiene: the latest implementation intentionally publishes the stable generation-facing implementation name.
        impl (if last
                 (primitive/syntax->datum (primitive/code-symbol name "--repl-current"))
                 (primitive/fresh-identifier "temporary"))]
    `((defn ~impl
        ~(primitive/code-nth f 2)
        ~(primitive/code-nth f 3)
        ~@(rr-body f
                   m
                   (rr-param-names params 0 (primitive/code-count params))
                   4
                   (primitive/code-count f)))
      ~@(if last
            `((defn ~cell-init [] (-> (ptr bool))
                (primitive/alloc-static bool))
              (defn ~cell []
                (-> (ptr (var/Var
                           (fnptr c [~@(rr-param-types m stable-params 0 (primitive/code-count stable-params))] ~stable-ret))))
                (let [slot (primitive/alloc-static
                             (var/Var
                               (fnptr c [~@(rr-param-types m stable-params 0 (primitive/code-count stable-params))] ~stable-ret)))]
                  ; Initialization is one-time. Candidate publication invokes
                  ; the generated binder before user entry; an old accessor may
                  ; read this cell but can never reinstall an old implementation.
                  (if (not (load (~cell-init)))
                      (do (store! slot (var/var-new (primitive/fnptr-of ~impl)))
                          (store! (~cell-init) true)) 0)
                  slot))
              (defn ~binder [] (-> i64)
                (store! (~cell) (var/var-new (primitive/fnptr-of ~impl)))
                (store! (~cell-init) true)
                0)
              (defn ~trampoline
                ~stable-params
                ~stable-retform
                ~(if (primitive/code-eq stable-ret `void)
                     `(do
                        (let [callee (load (~cell))]
                          (callee ~@(rr-param-names stable-params 0
                                      (primitive/code-count stable-params))))
                        (primitive/llvm-ir void [] "ret void"))
                     `(let [callee (load (~cell))]
                        (callee ~@(rr-param-names stable-params 0
                                    (primitive/code-count stable-params))))))
              (defn ~trampoline-init [] (-> (ptr bool))
                (primitive/alloc-static bool))
              (defn ~trampoline-cell []
                (-> (ptr (fnptr c
                           [~@(rr-param-types m stable-params 0 (primitive/code-count stable-params))]
                           ~stable-ret)))
                (let [slot (primitive/alloc-static
                             (fnptr c
                               [~@(rr-param-types m stable-params 0 (primitive/code-count stable-params))]
                               ~stable-ret))]
                  (if (not (load (~trampoline-init)))
                      (do (store! slot (primitive/fnptr-of ~trampoline))
                          (store! (~trampoline-init) true)) 0)
                  slot)))
            `()))))

; Materialize only the stable accessors for an accepted implementation owned by
; an older JIT generation.  Their alloc-static storage is remapped to the first
; generation's address by the backend.  No body, binder, or trampoline is
; regenerated, so an incremental submission cannot accidentally republish old
; code.  A marker shadowed by a new defn emits nothing; rr-lower-defn emits the
; complete replacement surface using this marker as its stable signature.
(defn rr-lower-function-marker [(m Code) (f Code) (i i64)] (-> Code)
  (let [name (primitive/code-nth f 1)]
    (if (rr-name-defined? m name (primitive/iadd i 1) (primitive/code-count m))
        `()
        (let [params (primitive/code-nth f 2)
              retform (primitive/code-nth f 3)
              ret (primitive/code-nth retform 1)
              cell (rr-cell-name f)
              trampoline-cell (rr-trampoline-cell-name f)]
          `((defn ~cell []
              (-> (ptr (var/Var
                         (fnptr c [~@(rr-param-types m params 0 (primitive/code-count params))] ~ret))))
              (primitive/alloc-static
                (var/Var
                  (fnptr c [~@(rr-param-types m params 0 (primitive/code-count params))] ~ret))))
            (defn ~trampoline-cell []
              (-> (ptr (fnptr c
                         [~@(rr-param-types m params 0 (primitive/code-count params))]
                         ~ret)))
              (primitive/alloc-static
                (fnptr c
                  [~@(rr-param-types m params 0 (primitive/code-count params))]
                  ~ret))))))))

(defn rr-binder-calls [(m Code)] (-> Code)
  (let [out (primitive/code-list-new)]
    (for [i 1 (primitive/code-count m)]
      (let [f (primitive/code-nth m i)]
        (if (and (rr-reload-defn? f)
                 (not (rr-name-defined? m (primitive/code-nth f 1)
                                        (+ i 1) (primitive/code-count m))))
            (do (primitive/code-list-push! out `(~(rr-binder-name f))) 0) 0)))
    (primitive/code-list-done out)))

(defn rr-main-defn? [(f Code)] (-> bool)
  (and (rr-defn? f) (= (primitive/code-str (primitive/code-nth f 1)) "main")))

;; Append every element of list `xs` onto the growable list `out` — how rr-forms
;; splices rr-lower-defn's one-or-two forms without re-splicing its own recursion
;; (docs/design/META_MEMORY.md).
(defn rr-push-each [(out CodeBuilder) (xs Code)] (-> CodeBuilder)
  (let [(mut i) 0]
    (loop (if (>= (load i) (primitive/code-count xs))
              (break)
              (do (primitive/code-list-push! out (primitive/code-nth xs (load i)))
                  (store! i (primitive/iadd (load i) 1)))))
    out))

(defn rr-forms [(m Code) (i i64) (n i64)] (-> Code)
  (let [out (primitive/code-list-new)
        (mut k) i]
    (loop (if (>= (load k) n)
              (break)
              (let [f (primitive/code-nth m (load k))
                    _p (if (or (rr-marker? f) (rr-struct-marker? f))
                           out
                           (if (rr-function-marker? f)
                               (rr-push-each out (rr-lower-function-marker m f (load k)))
                           (if (rr-reload-defn? f)
                           (rr-push-each out (rr-lower-defn m f (load k)))
                           (if (rr-generated-defn? f)
                               (primitive/code-list-push! out f)
                               (if (rr-generic-defn? f)
                                   (primitive/code-list-push! out f)
                                   (if (rr-main-defn? f)
                                       (primitive/code-list-push! out
                                         `(defn ~(primitive/code-nth f 1)
                                            ~(primitive/code-nth f 2)
                                            ~(primitive/code-nth f 3)
                                            ~@(rr-binder-calls m)
                                            ~@(rr-body f m
                                                       (rr-param-names (primitive/code-nth f 2)
                                                                       0
                                                                       (primitive/code-count (primitive/code-nth f 2)))
                                                       4
                                                       (primitive/code-count f))))
                                   (if (rr-defn? f)
                                       (primitive/code-list-push! out
                                         `(defn ~(primitive/code-nth f 1)
                                            ~(primitive/code-nth f 2)
                                            ~(primitive/code-nth f 3)
                                            ~@(rr-body f
                                                       m
                                                       (rr-param-names (primitive/code-nth f 2)
                                                                       0
                                                                       (primitive/code-count (primitive/code-nth f 2)))
                                                       4
                                                       (primitive/code-count f))))
                                       (primitive/code-list-push! out (rr-expr f m `())))))))))]
                (store! k (primitive/iadd (load k) 1)))))
    (primitive/code-list-done out)))

(defn rr-module [(m Code)] (-> Code)
  (if (rr-module? m)
      `(~(primitive/code-nth m 0)
        ~@(rr-forms m 1 (primitive/code-count m)))
      m))

(defn rr-modules [(mods Code) (i i64) (n i64)] (-> Code)
  (let [out (primitive/code-list-new)
        (mut k) i]
    (loop (if (>= (load k) n)
              (break)
              (do (primitive/code-list-push! out (rr-module (primitive/code-nth mods (load k))))
                  (store! k (primitive/iadd (load k) 1)))))
    (primitive/code-list-done out)))

(defn repl-reload-transform [(mods Code)] (-> Code)
  `(do ~@(rr-modules mods 0 (primitive/code-count mods))))

(transform repl-reload-transform :phase before-expand)
