;; Syntax-only runtime support for ordinary metaprograms. Compiler reflection is
;; deliberately absent: it belongs to a separate optional CodeContext capability.
(module coil.meta.runtime)
(import "coil.primitive" :as primitive)
(import "coil.alloc" :as alloc :use *)
(import "coil.arraylist" :use *)
(import "coil.fmt" :use *)
(import "coil.io" :use *)
(import "coil.reader" :use *)
(import "coil.slice" :use *)
(import "coil.str" :use *)

(defstruct CodeContext
  [(final (ptr Allocator))
   (configured bool)
   (fallback_used bool)
   (source_names (ArrayList (slice u8)))
   (source_texts (ArrayList (slice u8)))])
(defn context [] (-> (ptr CodeContext)) (alloc/static CodeContext))
(defn context-set-final! [(a (ptr Allocator))] (-> i64)
  (let [c (context)]
    (store! (field c final) a)
    (store! (field c configured) true)
    (store! (field c fallback_used) false)
    (store! (field c source_names) (al-new [(slice u8)] a))
    (store! (field c source_texts) (al-new [(slice u8)] a))
    0))
(defn context-clear! [] (-> i64)
  (let [c (context)]
    (store! (field c final) (primitive/cast (ptr Allocator) 0))
    (store! (field c configured) false)
    0))
(defn context-fallback? [] (-> bool) (load (field (context) fallback_used)))
(defn context-add-source! [(name (slice u8)) (text (slice u8))] (-> i64)
  (let [c (context) i (al-len [(slice u8)] (load (field c source_names)))]
    (al-push! (mut (field c source_names)) name)
    (al-push! (mut (field c source_texts)) text)
    i))
(defn active-allocator [] (-> (ptr Allocator))
  (let [c (context)]
    (if (load (field c configured))
        (load (field c final))
        (do (store! (field c fallback_used) true) (malloc-allocator)))))

(defn fail [(msg (slice u8))] (-> i64)
  (fmt (stderr) "metaprogram error: {s}\n" msg)
  (abort))
(defn tag [(c (ptr Sexp))] (-> i64)
  (match (load (field c kind))
    (KInt [_] 0) (KFloat [_] 1) (KSym [_] 2) (KKw [_] 3)
    (KStr [_] 4) (KCStr [_] 5) (KNil [] 6) (KPair [_] 6) (KVec [_] 7)))
(defn ival [(c (ptr Sexp))] (-> i64)
  (match (load (field c kind)) (KInt [v] v) (KFloat [v] v) (_ 0)))
(defn sval [(c (ptr Sexp))] (-> (slice u8))
  (match (load (field c kind))
    (KSym [v] v) (KKw [v] v) (KStr [v] v) (KCStr [v] v) (_ "")))
(defn source-valid? [(c (ptr Sexp))] (-> bool)
  (let [sid (load (field c source)) n (al-len [(slice u8)] (load (field (context) source_names)))]
    (and (>= sid 0) (< sid n))))
(defn code-file [(c (ptr Sexp))] (-> (slice u8))
  (if (source-valid? c)
      (al-get [(slice u8)] (load (field (context) source_names)) (load (field c source)))
      ""))
(defn code-src [(c (ptr Sexp))] (-> (slice u8))
  (if (not (source-valid? c)) ""
      (let [src (al-get [(slice u8)] (load (field (context) source_texts)) (load (field c source)))
            lo (load (field c lo)) hi (load (field c hi)) n (slice-len [u8] src)]
        (if (or (< lo 0) (or (< hi lo) (> hi n))) "" (subslice [u8] src lo hi)))))
(defn code-line [(c (ptr Sexp))] (-> i64)
  (if (not (source-valid? c)) 0
      (let [src (al-get [(slice u8)] (load (field (context) source_texts)) (load (field c source)))
            end (load (field c lo)) (mut i) 0 (mut line) 1]
        (loop (if (or (>= (load i) end) (>= (load i) (slice-len [u8] src))) (break)
                  (do (when (= (primitive/cast i64 (slice-get [u8] src (load i))) 10)
                        (store! line (primitive/iadd (load line) 1)) 0)
                      (store! i (primitive/iadd (load i) 1)))))
        (load line))))
(defn code-col [(c (ptr Sexp))] (-> i64)
  (if (not (source-valid? c)) 0
      (let [src (al-get [(slice u8)] (load (field (context) source_texts)) (load (field c source)))
            end (load (field c lo)) (mut i) 0 (mut col) 1]
        (loop (if (or (>= (load i) end) (>= (load i) (slice-len [u8] src))) (break)
                  (do (if (= (primitive/cast i64 (slice-get [u8] src (load i))) 10)
                          (store! col 1) (store! col (primitive/iadd (load col) 1)))
                      (store! i (primitive/iadd (load i) 1)))))
        (load col))))
(defn code-from-user? [(c (ptr Sexp))] (-> bool)
  (let [name (code-file c)]
    (and (> (slice-len [u8] name) 0)
         (!= (primitive/cast i64 (slice-get [u8] name 0)) 60))))
(defn code-macro? [(c (ptr Sexp))] (-> bool) (!= (load (field c ctxt)) 0))
(defn proper-list? [(c (ptr Sexp))] (-> bool)
  (match (load (field c kind))
    (KNil [] true)
    (KPair [p] (proper-list? (field p tail)))
    (_ false)))

(defn code-list? [(c (ptr Sexp))] (-> bool) (proper-list? c))
(defn code-vector? [(c (ptr Sexp))] (-> bool) (= (tag c) 7))
(defn code-float? [(c (ptr Sexp))] (-> bool) (= (tag c) 1))
(defn code-float-bits [(c (ptr Sexp))] (-> i64)
  (if (= (tag c) 1) (ival c) (fail "code-float-bits expects a float")))
(defn code-sym? [(c (ptr Sexp))] (-> bool) (= (tag c) 2))
(defn code-int? [(c (ptr Sexp))] (-> bool) (= (tag c) 0))
(defn code-keyword? [(c (ptr Sexp))] (-> bool) (= (tag c) 3))
(defn code-string? [(c (ptr Sexp))] (-> bool) (= (tag c) 4))
(defn code-count [(c (ptr Sexp))] (-> i64)
  (match (load (field c kind))
    (KVec [xs] (al-len [Sexp] (load xs)))
    (_ (if (proper-list? c)
           (let [(mut cur) c (mut n) 0 (mut done) false]
             (loop (if (load done) (break)
                       (match (load (field (load cur) kind))
                         (KNil [] (store! done true))
                         (KPair [p] (do (store! n (primitive/iadd (load n) 1))
                                        (store! cur (field p tail))))
                         (_ (store! done true)))))
             (load n))
           (fail "code-count expects a proper list/vector")))))
(defn code-sym [(c (ptr Sexp))] (-> (slice u8))
  (if (= (tag c) 2) (sval c) (do (fail "code-sym expects a symbol") "")))
(defn code-int [(c (ptr Sexp))] (-> i64)
  (if (= (tag c) 0) (ival c) (fail "code-int expects an integer")))
(defn list-nth [(c (ptr Sexp)) (i i64)] (-> (ptr Sexp))
  (match (load (field c kind))
    (KPair [p] (if (= i 0) (field p head) (list-nth (field p tail) (primitive/isub i 1))))
    (_ (do (fail "code-nth index out of range") (primitive/cast (ptr Sexp) 0)))))
(defn code-nth [(c (ptr Sexp)) (i i64)] (-> (ptr Sexp))
  (if (or (< i 0) (>= i (code-count c)))
      (do (fail "code-nth index out of range") (primitive/cast (ptr Sexp) 0))
      (match (load (field c kind))
        (KVec [xs] (al-elem [Sexp] xs i))
        (_ (list-nth c i)))))
(defn code-rest [(c (ptr Sexp))] (-> (ptr Sexp))
  (match (load (field c kind))
    (KPair [p] (field p tail)) (KNil [] c)
    (_ (do (fail "code-rest expects a list") (primitive/cast (ptr Sexp) 0)))))
(defn code-null? [(c (ptr Sexp))] (-> bool)
  (match (load (field c kind)) (KNil [] true) (_ false)))
(defn code-pair? [(c (ptr Sexp))] (-> bool)
  (match (load (field c kind)) (KPair [_] true) (_ false)))
(defn code-car [(c (ptr Sexp))] (-> (ptr Sexp))
  (match (load (field c kind)) (KPair [p] (field p head))
    (_ (do (fail "code-car expects a pair") (primitive/cast (ptr Sexp) 0)))))
(defn code-cdr [(c (ptr Sexp))] (-> (ptr Sexp))
  (match (load (field c kind)) (KPair [p] (field p tail))
    (_ (do (fail "code-cdr expects a pair") (primitive/cast (ptr Sexp) 0)))))

(defn code-cons-like [(prototype (ptr Sexp)) (head (ptr Sexp)) (tail (ptr Sexp))] (-> (ptr Sexp))
  (let [a (active-allocator)
        pair (unwrap-ptr [SexpPair] (create [SexpPair] a))
        out (unwrap-ptr [Sexp] (create [Sexp] a))]
    (store! (field pair head) (load head))
    (store! (field pair tail) (load tail))
    (store! (field pair owner) a)
    (store! (field pair flat) (primitive/zeroed (ptr (ArrayList Sexp))))
    (store! out (mk-sexp-src (KPair pair) prototype))
    out))
(defn code-cons [(head (ptr Sexp)) (tail (ptr Sexp))] (-> (ptr Sexp))
  (let [p (code-cons-like head head tail)]
    (store! (field p lo) -1) (store! (field p hi) -1)
    (store! (field p source) -1) (store! (field p ctxt) 0) p))
(defn code-append [(prefix (ptr Sexp)) (tail (ptr Sexp))] (-> (ptr Sexp))
  (if (not (proper-list? prefix))
      (do (fail "code splice expects a proper list") (primitive/cast (ptr Sexp) 0))
      (let [a (active-allocator) out (unwrap-ptr [Sexp] (create [Sexp] a))]
        (store! out (sexp-linked-from-items-tail a (sexp-linked-items prefix) (load tail) -1 -1))
        out)))
(defn code-nil-like [(prototype (ptr Sexp))] (-> (ptr Sexp))
  (let [a (active-allocator) out (unwrap-ptr [Sexp] (create [Sexp] a))]
    (store! out (mk-sexp-src (KNil) prototype)) out))

(defn code-set-nth! [(container (ptr Sexp)) (i i64) (value (ptr Sexp))] (-> (ptr Sexp))
  (match (sexp-set-nth! container i (load value))
    (Some [_] container)
    (None [] (do (fail "code-set-nth! index out of range or container is not a list/vector") container))))

(defn code-set-car! [(container (ptr Sexp)) (value (ptr Sexp))] (-> (ptr Sexp))
  (match (load (field container kind))
    (KPair [pair]
      (do (sexp-clear-flat! pair) (store! (field pair head) (load value)) container))
    (_ (do (fail "code-set-car! expects a pair") container))))

(defn code-prepend! [(container (ptr Sexp)) (value (ptr Sexp))] (-> (ptr Sexp))
  (match (load (field container kind))
    (KPair [pair]
      (let [a (active-allocator)
            newpair (unwrap-ptr [SexpPair] (create [SexpPair] a))]
        (sexp-clear-flat! pair)
        (store! (field newpair head) (load (field pair head)))
        (store! (field newpair tail) (load (field pair tail)))
        (store! (field newpair owner) a)
        (store! (field newpair flat) (primitive/zeroed (ptr (ArrayList Sexp))))
        (store! (field pair head) (load value))
        (store! (field pair tail) (mk-sexp-src (KPair newpair) container))
        container))
    (_ (do (fail "code-prepend! expects a non-empty list") container))))

(defn code-consume! [(container (ptr Sexp))] (-> (ptr Sexp)) container)

(defn code-eq [(x (ptr Sexp)) (y (ptr Sexp))] (-> bool)
  (let [tx (tag x) ty (tag y)]
    (if (!= tx ty) false
      (cond (or (= tx 0) (= tx 1)) (= (ival x) (ival y))
            (or (= tx 2) (or (= tx 3) (or (= tx 4) (= tx 5))))
              (= (sval x) (sval y))
            (= tx 6) (code-list-eq x y)
            (= tx 7) (code-list-eq x y)
            true))))
(defn code-list-eq [(x (ptr Sexp)) (y (ptr Sexp))] (-> bool)
  (let [nx (code-count x) ny (code-count y) (mut i) 0 (mut same) (= nx ny)]
    (loop (if (or (not (load same)) (>= (load i) nx)) (break)
              (do (unless (code-eq (code-nth x (load i)) (code-nth y (load i)))
                    (store! same false))
                  (store! i (primitive/iadd (load i) 1)))))
    (load same)))

(defn mk-atom [(kind SexpKind)] (-> (ptr Sexp))
  (let [a (active-allocator) out (unwrap-ptr [Sexp] (create [Sexp] a))]
    (store! out (mk-sexp kind -1 -1)) out))
(defn code-mk-int [(v i64)] (-> (ptr Sexp)) (mk-atom (KInt v)))
(defn code-mk-float-bits [(v i64)] (-> (ptr Sexp)) (mk-atom (KFloat v)))
(defn code-mk-sym [(v (slice u8))] (-> (ptr Sexp)) (mk-atom (KSym v)))
(defn code-mk-keyword [(v (slice u8))] (-> (ptr Sexp)) (mk-atom (KKw v)))
(defn code-mk-str [(v (slice u8))] (-> (ptr Sexp)) (mk-atom (KStr v)))
(defn code-mk-cstr [(v (slice u8))] (-> (ptr Sexp)) (mk-atom (KCStr v)))
(defn code-mk-nil [] (-> (ptr Sexp)) (mk-atom (KNil)))
(defn code-vector-from-list [(xs (ptr Sexp))] (-> (ptr Sexp))
  (mk-atom (KVec (sexp-linked-items xs))))

;; Variadic code-symbol/code-str lowering uses this typed builder chain. The
;; compiler selects an append operation from each checked argument type.
(defstruct CodeText [(a (ptr Allocator)) (bytes (ArrayList u8))])
(defn text-new [] (-> (ptr CodeText))
  (let [a (active-allocator) p (unwrap-ptr [CodeText] (create [CodeText] a))]
    (store! (field p a) a)
    (store! (field p bytes) (al-new [u8] a))
    p))
(defn text-append-slice! [(p (ptr CodeText)) (s (slice u8))] (-> i64)
  (let [n (slice-len [u8] s) (mut i) 0]
    (loop (if (>= (load i) n) (break)
              (do (al-push! (mut (field p bytes)) (slice-get [u8] s (load i)))
                  (store! i (primitive/iadd (load i) 1)))))
    0))
(defn text-append-positive! [(p (ptr CodeText)) (v i64)] (-> i64)
  (when (>= v 10) (text-append-positive! p (primitive/idiv v 10)) 0)
  (al-push! (mut (field p bytes)) (primitive/cast u8 (primitive/iadd 48 (primitive/irem v 10))))
  0)
(defn text-append-int! [(p (ptr CodeText)) (v i64)] (-> i64)
  (if (= v 0)
      (do (al-push! (mut (field p bytes)) (primitive/cast u8 48)) 0)
      (if (< v 0)
          (do (al-push! (mut (field p bytes)) (primitive/cast u8 45))
              (text-append-positive! p (primitive/isub 0 v)))
          (text-append-positive! p v))))
(defn text-code [(p (ptr CodeText)) (c (ptr Sexp))] (-> (ptr CodeText))
  (let [t (tag c)]
    (cond (or (= t 2) (= t 4)) (text-append-slice! p (sval c))
          (= t 0) (text-append-int! p (ival c))
          :else (fail "code-symbol/str Code part must be a symbol, string, or integer"))
    p))
(defn text-int [(p (ptr CodeText)) (v i64)] (-> (ptr CodeText))
  (text-append-int! p v)
  p)
(defn text-str [(p (ptr CodeText)) (v (slice u8))] (-> (ptr CodeText))
  (text-append-slice! p v)
  p)
(defn text-symbol-done [(p (ptr CodeText))] (-> (ptr Sexp))
  (code-mk-sym (al-slice [u8] (load (field p bytes)))))
(defn text-str-done [(p (ptr CodeText))] (-> (slice u8))
  (al-slice [u8] (load (field p bytes))))
