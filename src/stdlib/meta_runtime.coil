(module coil.meta-runtime)
(import "coil.primitive" :as primitive)

; Backend-neutral callback cells installed by the compiler's metaprogram shim.
; The callbacks always target the allocator in the active CtCtx; keeping the
; proxy object inside the metaprogram avoids sending trait-object vtables across
; the native/wasm/interpreter boundary.
(defn meta-allocate-cell [] (-> (ptr (fnptr c [i64 i64] (ptr i8))))
  (primitive/alloc-static (fnptr c [i64 i64] (ptr i8))))

(defn meta-resize-cell [] (-> (ptr (fnptr c [(ptr i8) i64 i64 i64 i64] i64)))
  (primitive/alloc-static (fnptr c [(ptr i8) i64 i64 i64 i64] i64)))

(defn meta-remap-cell [] (-> (ptr (fnptr c [(ptr i8) i64 i64 i64 i64] (ptr i8))))
  (primitive/alloc-static (fnptr c [(ptr i8) i64 i64 i64 i64] (ptr i8))))

(defn meta-deallocate-cell [] (-> (ptr (fnptr c [(ptr i8) i64 i64] i64)))
  (primitive/alloc-static (fnptr c [(ptr i8) i64 i64] i64)))

(defn generated-unit-cell [] (-> (ptr (fnptr c [(ptr u8) i64 (ptr u8) i64 (ptr u8) i64] i64)))
  (primitive/alloc-static (fnptr c [(ptr u8) i64 (ptr u8) i64 (ptr u8) i64] i64)))

(defn generated-unit-ready-cell [] (-> (ptr bool))
  (primitive/alloc-static bool))

(defn meta-runtime-install! [(allocate (fnptr c [i64 i64] (ptr i8)))
                             (resize (fnptr c [(ptr i8) i64 i64 i64 i64] i64))
                             (remap (fnptr c [(ptr i8) i64 i64 i64 i64] (ptr i8)))
                             (deallocate (fnptr c [(ptr i8) i64 i64] i64))
                             (generated-unit (fnptr c [(ptr u8) i64 (ptr u8) i64 (ptr u8) i64] i64))] (-> i64)
  (store! (coil.meta-runtime.meta-allocate-cell) allocate)
  (store! (coil.meta-runtime.meta-resize-cell) resize)
  (store! (coil.meta-runtime.meta-remap-cell) remap)
  (store! (coil.meta-runtime.meta-deallocate-cell) deallocate)
  (store! (coil.meta-runtime.generated-unit-cell) generated-unit)
  (store! (coil.meta-runtime.generated-unit-ready-cell) true)
  0)
