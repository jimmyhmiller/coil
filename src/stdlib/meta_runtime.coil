(module coil.meta-runtime)
(import "coil.primitive" :as primitive)
(import "coil.cc" :as cc)

; Backend-neutral callback cells installed by the compiler's metaprogram shim.
; The callbacks always target the allocator in the active CtCtx; keeping the
; proxy object inside the metaprogram avoids sending trait-object vtables across
; the native/wasm/interpreter boundary.
(defn* meta-allocate-cell [] (-> (ptr (fnptr (cc/C) [i64 i64] (ptr i8))))
  (primitive/alloc-static (fnptr (cc/C) [i64 i64] (ptr i8))))

(defn* meta-resize-cell [] (-> (ptr (fnptr (cc/C) [(ptr i8) i64 i64 i64 i64] i64)))
  (primitive/alloc-static (fnptr (cc/C) [(ptr i8) i64 i64 i64 i64] i64)))

(defn* meta-remap-cell [] (-> (ptr (fnptr (cc/C) [(ptr i8) i64 i64 i64 i64] (ptr i8))))
  (primitive/alloc-static (fnptr (cc/C) [(ptr i8) i64 i64 i64 i64] (ptr i8))))

(defn* meta-deallocate-cell [] (-> (ptr (fnptr (cc/C) [(ptr i8) i64 i64] i64)))
  (primitive/alloc-static (fnptr (cc/C) [(ptr i8) i64 i64] i64)))

(defn* generated-unit-cell [] (-> (ptr (fnptr (cc/C)
                                              [(ptr u8)
                                               i64
                                               (ptr u8)
                                               i64
                                               (ptr u8)
                                               i64]
                                              i64)))
  (primitive/alloc-static (fnptr (cc/C) [(ptr u8) i64 (ptr u8) i64 (ptr u8) i64] i64)))

(defn* generated-unit-ready-cell [] (-> (ptr bool))
  (primitive/alloc-static bool))

(defn* meta-runtime-install! [(allocate (fnptr (cc/C) [i64 i64] (ptr i8)))
                              (resize (fnptr (cc/C) [(ptr i8) i64 i64 i64 i64] i64))
                              (remap (fnptr (cc/C)
                                            [(ptr i8) i64 i64 i64 i64]
                                            (ptr i8)))
                              (deallocate (fnptr (cc/C) [(ptr i8) i64 i64] i64))
                              (generated-unit (fnptr (cc/C)
                                                     [(ptr u8)
                                                      i64
                                                      (ptr u8)
                                                      i64
                                                      (ptr u8)
                                                      i64]
                                                     i64))] (-> i64)
  (primitive/store! (coil.meta-runtime.meta-allocate-cell) allocate)
  (primitive/store! (coil.meta-runtime.meta-resize-cell) resize)
  (primitive/store! (coil.meta-runtime.meta-remap-cell) remap)
  (primitive/store! (coil.meta-runtime.meta-deallocate-cell) deallocate)
  (primitive/store! (coil.meta-runtime.generated-unit-cell) generated-unit)
  (primitive/store! (coil.meta-runtime.generated-unit-ready-cell) true)
  0)
