(module coil.pvec)
(import "coil.primitive" :as primitive)

; A persistent vector `PVec[T]`: a 32-way trie of reference-counted nodes with a
; separate tail, indexed by position. `pv-push`/`pv-set`/`pv-pop` return a NEW
; vector sharing every untouched node with the old one; the old vector stays valid
; and unchanged. Indexing walks at most seven levels for any length that fits in
; memory, and appending usually touches only the tail.
;
;   (import "coil.pvec" :use *) (import "coil.alloc" :use *)
;   (let [a (pv-new [i64] (malloc-allocator-lease))
;         b (pv-push a 10)               ; a is still empty
;         c (pv-set b 0 11)]             ; b still holds 10
;     (match (pv-get c 0) (Some [v] v) (None [] 0)))
;
; OWNERSHIP follows `coil.pmap`, which explains it at length: a `PVec` is an owner
; (`Drop` releases it, `Clone` shares it in O(1)); elements are owned by the leaf
; holding them, cloned when a leaf is copied and dropped when it is freed, so `T`
; must implement `Clone` and may itself be an owner; storage comes from an
; `AllocatorLease` every derived vector shares.
;
; IN-PLACE EDITS. The `!` forms take `(mut (PVec T))` and edit a node in place only
; when it and every node above it have exactly one reference, which is when no
; other vector can observe the edit. The pure forms are `clone` + the `!` form.
;
; NOT THREAD SAFE: reference counts are plain integers, as in `coil.rc`.
(import "coil.alloc" :as alloc :use *)
(import "coil.result" :use *)
(import "coil.mem" :use *)
(import "coil.slice" :use [slice-new slice-data])
(import "coil.control" :use *)

;;; A trie node. A LEAF has `items` (room for `cap` elements, `count` of them
;;; live) and no `children`; an INTERNAL node has 32 `children` slots, `count` of
;;; them live, and no `items`. Only the tail is ever a leaf with `cap` below 32:
;;; it grows by doubling, so a short vector does not pay for a full leaf.
(defstruct PVNode [T]
  [(refs i64)
   (count i64)
   (cap i64)
   (items (ptr T))
   (children (ptr (ptr (PVNode T))))])

;;; `shift` is the root's level: 5 when the root's children are leaves.
(defstruct PVec [T]
  [(root (ptr (PVNode T)))
   (tail (ptr (PVNode T)))
   (count i64)
   (shift i64)
   (lease AllocatorLease)])

(defn pv-no-node [T] [] (-> (ptr (PVNode T)))
  (primitive/cast (ptr (PVNode T)) 0))

(defn pv-clone-at [(T Clone)] [(p (ref T))] (-> T)
  (clone p))

(defn pv-drop-at [T] [(p (ptr T))] (-> i64)
  (let [spent (take! [T] p)] 0))

(defn pv-node-shell [T] [(a (dyn Allocator))] (-> (ptr (PVNode T)))
  (let [node
          (match (alloc [(PVNode T)] a 1)
            (Some [memory] (slice-data memory))
            (None []
                  (do
                    (oom-at c"pvec node" (primitive/sizeof (PVNode T)))
                    (pv-no-node [T]))))]
    (set! (.refs node) 1)
    (set! (.count node) 0)
    (set! (.cap node) 0)
    (set! (.items node) (primitive/cast (ptr T) 0))
    (set! (.children node) (primitive/cast (ptr (ptr (PVNode T))) 0))
    node))

(defn pv-leaf-new [T] [(a (dyn Allocator)) (cap i64)] (-> (ptr (PVNode T)))
  (let [node (pv-node-shell [T] a)]
    (set! (.cap node) cap)
    (set! (.items node)
          (match (alloc [T] a cap)
            (Some [memory] (slice-data memory))
            (None []
                  (do
                    (oom-at c"pvec leaf"
                            (primitive/imul cap (primitive/sizeof T)))
                    (primitive/cast (ptr T) 0)))))
    node))

(defn pv-internal-new [T] [(a (dyn Allocator))] (-> (ptr (PVNode T)))
  (let [node (pv-node-shell [T] a)]
    (set! (.cap node) 32)
    (set! (.children node)
          (match (alloc [(ptr (PVNode T))] a 32)
            (Some [memory] (slice-data memory))
            (None []
                  (do
                    (oom-at c"pvec children"
                            (primitive/imul 32
                                            (primitive/sizeof (ptr (PVNode T)))))
                    (primitive/cast (ptr (ptr (PVNode T))) 0)))))
    node))

(defn pv-leaf? [T] [(node (ptr (PVNode T)))] (-> bool)
  (!= (load (field node items)) (primitive/cast (ptr T) 0)))

(defn pv-node-retain [T] [(node (ptr (PVNode T)))] (-> (ptr (PVNode T)))
  (set! (.refs node) (primitive/iadd (.refs node) 1))
  node)

;;; Give up one reference. The last one drops a leaf's elements or releases an
;;; internal node's children, then frees the node.
(defn pv-node-release! [T] [(a (dyn Allocator)) (node (ptr (PVNode T)))] (-> i64)
  (let [remaining (primitive/isub (.refs node) 1)]
    (set! (.refs node) remaining)
    (when (= remaining 0)
      (if (pv-leaf? node)
          (do
            (for [i 0 (.count node)]
              (pv-drop-at (primitive/index (load (field node items)) i)))
            (free [T] a (slice-new (load (field node items)) (.cap node)))
            0)
          (do
            (for [i 0 (.count node)]
              (pv-node-release! a
                                (load (primitive/index (load (field node
                                                                    children))
                                                       i))))
            (free [(ptr (PVNode T))]
                  a
                  (slice-new (load (field node children)) 32))
            0))
      (free [(PVNode T)] a (slice-new node 1))
      0)
    0))

;;; A fresh node equal to `node`: a leaf's elements cloned into room for `cap`, or
;;; an internal node's children retained. `node` is untouched.
(defn pv-node-copy [(T Clone)] [(a (dyn Allocator))
                                (node (ptr (PVNode T)))
                                (cap i64)] (-> (ptr (PVNode T)))
  (let [count (.count node)]
    (if (pv-leaf? node)
        (let [copy (pv-leaf-new [T] a cap)]
          (for [i 0 count]
            (set! (primitive/index (load (field copy items)) i)
                  (pv-clone-at [T]
                               (primitive/index (load (field node items)) i))))
          (set! (.count copy) count)
          copy)
        (let [copy (pv-internal-new [T] a)]
          (for [i 0 count]
            (set! (primitive/index (load (field copy children)) i)
                  (pv-node-retain (load (primitive/index (load (field node
                                                                      children))
                                                         i)))))
          (set! (.count copy) count)
          copy))))

;;; `node` itself when it may be edited in place, else a copy the caller owns.
(defn pv-node-editable [(T Clone)] [(a (dyn Allocator))
                                    (node (ptr (PVNode T)))
                                    (owned bool)] (-> (ptr (PVNode T)))
  (if owned node (pv-node-copy a node (.cap node))))

;;; Point slot `at` of an internal node at `child`, whose reference the caller
;;; hands over. Whatever the slot held before loses the slot's reference.
(defn pv-node-set-child! [T] [(a (dyn Allocator))
                              (node (ptr (PVNode T)))
                              (at i64)
                              (child (ptr (PVNode T)))] (-> i64)
  (let [slot (primitive/index (load (field node children)) at)]
    (if (< at (.count node))
        (let [previous (load slot)]
          (set! slot child)
          (when (!= previous child) (pv-node-release! a previous) 0)
          0)
        (do (set! slot child) (set! (.count node) (primitive/iadd at 1)) 0))))

;;; A chain of single-child internal nodes from `level` down to `leaf`.
(defn pv-new-path [T] [(a (dyn Allocator)) (level i64) (leaf (ptr (PVNode T)))] (-> (ptr (PVNode T)))
  (if (= level 0)
      leaf
      (let [node (pv-internal-new [T] a)]
        (pv-node-set-child! a
                            node
                            0
                            (pv-new-path a (primitive/isub level 5) leaf))
        node)))

;;; Hang the full leaf `tail` under `node` as the rightmost leaf of a vector that
;;; has `count` elements once it is there. Returns `node` when `owned`, else a copy.
(defn pv-push-tail [(T Clone)] [(a (dyn Allocator))
                                (node (ptr (PVNode T)))
                                (owned bool)
                                (level i64)
                                (count i64)
                                (tail (ptr (PVNode T)))] (-> (ptr (PVNode T)))
  (let [at (primitive/iand (primitive/ishr (primitive/isub count 1) level) 31)
        target (pv-node-editable a node owned)]
    (pv-node-set-child! a
                        target
                        at
                        (cond (= level 5) tail
                              (< at (.count node))
                                (let [child
                                        (load (primitive/index (load (field node
                                                                            children))
                                                               at))]
                                  (pv-push-tail a
                                                child
                                                (and owned (= (.refs child) 1))
                                                (primitive/isub level 5)
                                                count
                                                tail))
                              :else
                                (pv-new-path a (primitive/isub level 5) tail)))
    target))

;;; Detach the rightmost leaf of a trie holding `count` elements. Returns the
;;; edited node, or null when nothing would be left under it; `node` is then
;;; untouched and the caller drops its slot.
(defn pv-pop-tail [(T Clone)] [(a (dyn Allocator))
                               (node (ptr (PVNode T)))
                               (owned bool)
                               (level i64)
                               (count i64)] (-> (ptr (PVNode T)))
  (let [at (primitive/iand (primitive/ishr (primitive/isub count 1) level) 31)]
    (if (> level 5)
        (let [child (load (primitive/index (load (field node children)) at))
              below
                (pv-pop-tail a
                             child
                             (and owned (= (.refs child) 1))
                             (primitive/isub level 5)
                             count)]
          (cond (and (= below (pv-no-node [T])) (= at 0)) (pv-no-node [T])
                (= below (pv-no-node [T]))
                  (let [target (pv-node-editable a node owned)]
                    (pv-node-release! a
                                      (load (primitive/index (load (field target
                                                                          children))
                                                             at)))
                    (set! (.count target) at)
                    target)
                :else
                  (let [target (pv-node-editable a node owned)]
                    (pv-node-set-child! a target at below)
                    target)))
        (if (= at 0)
            (pv-no-node [T])
            (let [target (pv-node-editable a node owned)]
              (pv-node-release! a
                                (load (primitive/index (load (field target
                                                                    children))
                                                       at)))
              (set! (.count target) at)
              target)))))

;;; Replace element `index`, which lies in the trie under `node`.
(defn pv-node-set [(T Clone)] [(a (dyn Allocator))
                               (node (ptr (PVNode T)))
                               (owned bool)
                               (level i64)
                               (index i64)
                               (value (ptr T))] (-> (ptr (PVNode T)))
  (let [target (pv-node-editable a node owned)]
    (if (= level 0)
        (let [slot
                (primitive/index (load (field target items))
                                 (primitive/iand index 31))]
          (pv-drop-at slot)
          (mem-copy slot value 1)
          0)
        (let [at (primitive/iand (primitive/ishr index level) 31)
              child (load (primitive/index (load (field node children)) at))]
          (pv-node-set-child! a
                              target
                              at
                              (pv-node-set a
                                           child
                                           (and owned (= (.refs child) 1))
                                           (primitive/isub level 5)
                                           index
                                           value))))
    target))

; ---- the vector -----------------------------------------------------------------

;;; An empty vector allocating through `lease`.
(defn pv-new [T] [(lease AllocatorLease)] (-> (PVec T))
  (PVec
    :root (pv-no-node [T])
    :tail (pv-no-node [T])
    :count 0
    :shift 5
    :lease lease))

(defn pv-len [T] [(v (ref (PVec T)))] (-> i64)
  (.count v))

(defn pv-empty? [T] [(v (ref (PVec T)))] (-> bool)
  (= (.count v) 0))

;;; Do two vectors share their whole structure? True after `clone` and until
;;; either side is edited; it is identity of storage, not equality of contents.
(defn pv-same? [T] [(left (ref (PVec T))) (right (ref (PVec T)))] (-> bool)
  (and (= (load (field left root)) (load (field right root)))
       (= (load (field left tail)) (load (field right tail)))))

;;; Index of the first element held in the tail.
(defn pv-tail-offset [T] [(v (ref (PVec T)))] (-> i64)
  (let [count (.count v)]
    (if (< count 32)
        0
        (primitive/ishl (primitive/ishr (primitive/isub count 1) 5) 5))))

;;; The trie leaf holding element `index`, which must lie below the tail.
(defn pv-trie-leaf [T] [(root (ptr (PVNode T))) (shift i64) (index i64)] (-> (ptr (PVNode T)))
  (let [(mut node) root
        (mut level) shift]
    (while (> (load level) 0)
      (set! node
            (load (primitive/index (load (field (load node) children))
                                   (primitive/iand (primitive/ishr index
                                                                   (load level))
                                                   31))))
      (set! level (primitive/isub (load level) 5)))
    (load node)))

;;; The leaf holding element `index`, which must be in range.
(defn pv-leaf-for [T] [(v (ref (PVec T))) (index i64)] (-> (ptr (PVNode T)))
  (if (>= index (pv-tail-offset v))
      (load (field v tail))
      (pv-trie-leaf (load (field v root)) (.shift v) index)))

;;; A borrowed pointer to element `index`, or None when out of range. It is valid
;;; while this vector, or any vector sharing that leaf, is alive and the leaf is
;;; not edited in place.
(defn pv-get-ptr [T] [(v (ref (PVec T))) (index i64)] (-> (Option (ptr T)))
  (if (or (< index 0) (>= index (.count v)))
      (None [(ptr T)])
      (Some (primitive/index (load (field (pv-leaf-for v index) items))
                             (primitive/iand index 31)))))

;;; Element `index`, cloned out of the vector.
(defn pv-get [(T Clone)] [(v (ref (PVec T))) (index i64)] (-> (Option T))
  (match (pv-get-ptr v index)
    (Some [slot] (Some (pv-clone-at [T] slot)))
    (None [] (None [T]))))

;;; Make the tail editable with room for one more element. The tail must not be
;;; a full leaf.
(defn pv-tail-for-append! [(T Clone)] [(v (mut (PVec T)))] (-> (ptr (PVNode T)))
  (let [a (allocator-lease-borrow (field v lease))
        tail (load (field v tail))]
    (if (= tail (pv-no-node [T]))
        (let [fresh (pv-leaf-new [T] a 4)]
          (set! (.tail v) fresh)
          fresh)
        (let [count (.count tail)
              cap (.cap tail)
              owned (= (.refs tail) 1)
              wanted (if (< count cap) cap (primitive/imul cap 2))]
          (cond (and owned (= wanted cap)) tail
                owned
                  (match (reallocate [T]
                                     a
                                     (slice-new (load (field tail items)) cap)
                                     wanted)
                    (Some [memory]
                          (do
                            (set! (.items tail) (slice-data memory))
                            (set! (.cap tail) wanted)
                            tail))
                    (None []
                          (do
                            (oom-at c"pvec tail"
                                    (primitive/imul wanted (primitive/sizeof T)))
                            tail)))
                :else
                  (let [copy (pv-node-copy a tail wanted)]
                    (pv-node-release! a tail)
                    (set! (.tail v) copy)
                    copy))))))

;;; Append, editing in place wherever this vector is the only owner. Returns the
;;; new length.
(defn pv-push! [(T Clone)] [(v (mut (PVec T))) (value T)] (-> i64)
  (let [a (allocator-lease-borrow (field v lease))
        count (.count v)
        tail (load (field v tail))]
    (when (and (!= tail (pv-no-node [T])) (= (.count tail) 32))
      ; The tail is a full leaf: it becomes the trie's rightmost leaf, keeping
      ; the reference the vector held on it.
      (let [root (load (field v root))
            shift (.shift v)]
        (cond (= root (pv-no-node [T]))
                (let [fresh (pv-internal-new [T] a)]
                  (pv-node-set-child! a fresh 0 tail)
                  (set! (.root v) fresh)
                  0)
              ; The root is full at this height: grow a level.
              (> (primitive/ishr count 5) (primitive/ishl 1 shift))
                (let [fresh (pv-internal-new [T] a)]
                  (pv-node-set-child! a fresh 0 root)
                  (pv-node-set-child! a fresh 1 (pv-new-path a shift tail))
                  (set! (.root v) fresh)
                  (set! (.shift v) (primitive/iadd shift 5))
                  0)
              :else
                (let [owned (= (.refs root) 1)
                      updated (pv-push-tail a root owned shift count tail)]
                  (unless owned (pv-node-release! a root) 0)
                  (set! (.root v) updated)
                  0))
        (set! (.tail v) (pv-no-node [T]))
        0)
      0)
    (let [target (pv-tail-for-append! (mut v))
          at (.count target)]
      (set! (primitive/index (load (field target items)) at) value)
      (set! (.count target) (primitive/iadd at 1))
      (set! (.count v) (primitive/iadd count 1))
      (primitive/iadd count 1))))

;;; Replace element `index`, editing in place wherever this vector is the only
;;; owner. Returns 1, or 0 when `index` is out of range (and `value` is dropped).
(defn pv-set! [(T Clone)] [(v (mut (PVec T))) (index i64) (value T)] (-> i64)
  (let [slot (primitive/alloc-stack T)]
    (set! slot value)
    (if (or (< index 0) (>= index (.count v)))
        (do (pv-drop-at slot) 0)
        (let [a (allocator-lease-borrow (field v lease))
              in-tail (>= index (pv-tail-offset v))
              node (if in-tail (load (field v tail)) (load (field v root)))
              owned (= (.refs node) 1)
              updated
                (pv-node-set a node owned (if in-tail 0 (.shift v)) index slot)]
          (unless owned (pv-node-release! a node) 0)
          (if in-tail (set! (.tail v) updated) (set! (.root v) updated))
          1))))

;;; Remove and return the last element, editing in place wherever this vector is
;;; the only owner. None when the vector is empty.
(defn pv-pop! [(T Clone)] [(v (mut (PVec T)))] (-> (Option T))
  (let [count (.count v)]
    (if (= count 0)
        (None [T])
        (let [a (allocator-lease-borrow (field v lease))
              shared (load (field v tail))
              tail (pv-node-editable a shared (= (.refs shared) 1))
              last-at (primitive/isub (.count tail) 1)
              value
                (take! [T] (primitive/index (load (field tail items)) last-at))]
          (when (!= tail shared) (pv-node-release! a shared) 0)
          (set! (.count tail) last-at)
          (set! (.tail v) tail)
          (set! (.count v) (primitive/isub count 1))
          (when (= last-at 0)
            ; The tail emptied: the trie's rightmost leaf becomes the new tail.
            (pv-node-release! a tail)
            (if (= count 1)
                (set! (.tail v) (pv-no-node [T]))
                (let [root (load (field v root))
                      shift (.shift v)
                      trie-count (primitive/isub count 1)
                      owned (= (.refs root) 1)]
                  (set! (.tail v)
                        (pv-node-retain (pv-trie-leaf root
                                                      shift
                                                      (primitive/isub trie-count
                                                                      1))))
                  (let [updated (pv-pop-tail a root owned shift trie-count)]
                    (cond (= updated (pv-no-node [T]))
                            (do
                              (pv-node-release! a root)
                              (set! (.root v) updated)
                              0)
                          ; A root with one child is one level too tall.
                          (and (> shift 5) (= (.count updated) 1))
                            (let [only
                                    (pv-node-retain (load (load (field updated
                                                                       children))))]
                              (when (!= updated root)
                                (pv-node-release! a root)
                                0)
                              (pv-node-release! a updated)
                              (set! (.root v) only)
                              (set! (.shift v) (primitive/isub shift 5))
                              0)
                          :else
                            (do
                              (when (!= updated root)
                                (pv-node-release! a root)
                                0)
                              (set! (.root v) updated)
                              0)))))
            0)
          (Some value)))))

;;; A new vector with `value` appended. `v` is unchanged.
(defn pv-push [(T Clone)] [(v (ref (PVec T))) (value T)] (-> (PVec T))
  (let [(mut next) (clone v)]
    (pv-push! (mut next) value)
    next))

;;; A new vector with element `index` replaced; an out-of-range `index` yields an
;;; unchanged copy. `v` is unchanged.
(defn pv-set [(T Clone)] [(v (ref (PVec T))) (index i64) (value T)] (-> (PVec T))
  (let [(mut next) (clone v)]
    (pv-set! (mut next) index value)
    next))

;;; A new vector without the last element. `v` is unchanged.
(defn pv-pop [(T Clone)] [(v (ref (PVec T)))] (-> (PVec T))
  (let [(mut next) (clone v)]
    (let [dropped (pv-pop! (mut next))] 0)
    next))

(impl [T] Clone (PVec T)
  (clone [(self (ref (PVec T)))]
         (-> (PVec T))
         (let [root (load (field self root))
               tail (load (field self tail))]
           (unless (= root (pv-no-node [T])) (pv-node-retain root) 0)
           (unless (= tail (pv-no-node [T])) (pv-node-retain tail) 0)
           (PVec
             :root root
             :tail tail
             :count (.count self)
             :shift (.shift self)
             :lease (clone (field self lease))))))

; The lease field is dropped after this body, so the allocator outlives the nodes.
(impl [T] Drop (PVec T)
  (drop [(self (mut (PVec T)))]
        (-> void)
        (let [a (allocator-lease-borrow (field self lease))
              root (load (field self root))
              tail (load (field self tail))]
          (unless (= root (pv-no-node [T])) (pv-node-release! a root) 0)
          (unless (= tail (pv-no-node [T])) (pv-node-release! a tail) 0)
          (set! (.root self) (pv-no-node [T]))
          (set! (.tail self) (pv-no-node [T]))
          0)))

; ---- iteration ----------------------------------------------------------------

;;; A cursor over a vector's elements in index order, yielding borrowed pointers.
;;; It borrows the vector: it holds no reference, so the vector must outlive it and
;;; must not be edited in place meanwhile. One trie walk per 32 elements.
(defstruct PVecIter [T]
  [(root (ptr (PVNode T)))
   (tail (ptr (PVNode T)))
   (leaf (ptr (PVNode T)))
   (count i64)
   (shift i64)
   (tail-offset i64)
   (at i64)])

(defn pv-iter [T] [(v (ref (PVec T)))] (-> (PVecIter T))
  (PVecIter
    :root (load (field v root))
    :tail (load (field v tail))
    :leaf (pv-no-node [T])
    :count (.count v)
    :shift (.shift v)
    :tail-offset (pv-tail-offset v)
    :at 0))

(impl [T] Iterator (PVecIter T)
  (next [(it (mut (PVecIter T)))]
        (-> (Option (ptr T)))
        (let [at (.at it)]
          (if (>= at (.count it))
              (None [(ptr T)])
              (do
                (when (= (primitive/iand at 31) 0)
                  (if (>= at (.tail-offset it))
                      (set! (.leaf it) (load (field it tail)))
                      (set! (.leaf it)
                            (pv-trie-leaf (load (field it root))
                                          (.shift it)
                                          at)))
                  0)
                (set! (.at it) (primitive/iadd at 1))
                (Some (primitive/index (load (field (load (field it leaf))
                                                    items))
                                       (primitive/iand at 31))))))))

(impl [T] Len (PVec T)
  (len [(v (PVec T))] (-> i64) (pv-len v)))
