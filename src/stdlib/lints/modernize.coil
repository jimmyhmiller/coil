(module coil.lint.modernize)
(import "coil.primitive" :as primitive)

; Name resolution — see the header of names.coil. Every rule below that names a
; function from an imported module goes through `ln-is?` with ONE fully-qualified
; name; `mz-head?` is only for core/ambient spellings.
(import "coil.lint.names" :as names)

; Project-default modernization lint. These rewrites preserve types and evaluation
; order: integer Eq/Ord is implemented for every width, and load/store!/field are
; direct coil.core aliases of the same lowering operations.
(defn mz-head? [(f Code) (name Code)] (-> bool)
  (and (primitive/code-list? f)
       (and (not (primitive/code-vector? f))
            (and (> (primitive/code-count f) 0)
                 (primitive/code-eq (primitive/code-nth f 0) name)))))

; A metal comparison contextually types integer literals to the other operand's
; width, and so an operation on literals alone (names/ln-context-typed?). Trait
; dispatch happens before that coercion, so preserve the inferred width explicitly
; when translating `icmp-*` to a clean operator. A literal already defaulting to
; i64 needs nothing; the ascription is `:`, so the rewrite does not keep the
; module tied to coil.primitive.
(defn mz-cmp-arg [(arg Code) (ty Code) (env Code)] (-> Code)
  (if (or (= ty `:unknown) (= ty `i64) (not (names/ln-context-typed? arg env)))
      arg
      (mz-ascribe-lead arg ty)))

;;; A context-typed operation with its LEADING literal ascribed `ty`:
;;; `(primitive/ishl 1 3)` as `(primitive/ishl (: 1 u32) 3)`, which types the whole
;;; operation, rather than an ascription wrapped around it that would outlast the
;;; operation's own rewrite to `<<`.
(defn mz-ascribe-lead [(arg Code) (ty Code)] (-> Code)
  (if (primitive/code-list? arg)
      `(~(get arg 0) ~(mz-ascribe-lead (get arg 1) ty) ~(get arg 2))
      `(: ~arg ~ty)))

;;; A cast of a literal is an ascription. `(cast u32 126)`, `(primitive/cast u32
;;; 126)` and `(: 126 u32)` check to the same conversion of the same literal
;;; (check.coil's `coerce-lit`), but only the ascription refuses a literal its type
;;; cannot hold. So the rewrite is made only where the cast keeps the value: an
;;; integer literal in the range of a standard integer type, or a float literal to
;;; f32 or f64. There the conversion cannot truncate, nor fail coil.safety's
;;; checked `cast`. `(primitive/cast u8 -1)`, which is a cast for its truncation,
;;; keeps it; so does an integer literal cast to a float, which wants a float
;;; literal instead. A cast to the literal's own default type, `(cast i64 5)` or
;;; `(cast f64 1.5)`, is the bare literal: wherever that cast compiles, the
;;; literal alone takes the same type. `_` when `f` is not such a cast.
(defn mz-literal-cast-replacement [(f Code) (head (slice u8)) (env Code)] (-> Code)
  (if (and (= (primitive/code-count f) 3)
           (or (names/ln-is? head env "coil.core/cast")
               (names/ln-is? head env "coil.primitive/cast")))
      (let [ty (primitive/code-nth f 1)
            x (primitive/code-nth f 2)]
        (cond (not (mz-literal-keeps-value? x ty)) `_
              (= ty (if (primitive/code-int? x) `i64 `f64)) x
              :else `(: ~x ~ty)))
      `_))

(defn mz-literal-keeps-value? [(x Code) (ty Code)] (-> bool)
  (cond (primitive/code-int? x) (mz-int-in-range? (primitive/code-int x) ty)
        (primitive/code-float? x) (or (= ty `f32) (= ty `f64))
        :else false))

(defn mz-int-in-range? [(n i64) (ty Code)] (-> bool)
  (cond (= ty `i8) (and (>= n -128) (<= n 127))
        (= ty `i16) (and (>= n -32768) (<= n 32767))
        (= ty `i32) (and (>= n -2147483648) (<= n 2147483647))
        (or (= ty `i64) (= ty `i128)) true
        (= ty `u8) (and (>= n 0) (<= n 255))
        (= ty `u16) (and (>= n 0) (<= n 65535))
        (= ty `u32) (and (>= n 0) (<= n 4294967295))
        (or (= ty `u64) (= ty `u128)) (>= n 0)
        :else false))

;;; The type the checker inferred for F, if it inferred one.
(defn mz-type-of [(f Code)] (-> (Option Code))
  (match (primitive/type-of f)
    (primitive/TypeIs [t] (Some t))
    (primitive/TypeUnknown [] (None [Code]))))

;;; The type an integer comparison compares: its first operand that is not
;;; context-typed (a literal takes its width from the other side).
(defn mz-cmp-type [(f Code) (env Code)] (-> (Option Code))
  (let [a (get f 1)]
    (mz-type-of (if (names/ln-context-typed? a env) (get f 2) a))))

(defn mz-std-int? [(ty Code)] (-> bool)
  (or (= ty `i8) (= ty `i16)
      (= ty `i32) (= ty `i64)
      (= ty `u8) (= ty `u16)
      (= ty `u32) (= ty `u64)))

;;; Does the operator the comparison `kind` (1-6) becomes exist for `ty`? The
;;; prelude implements Eq and Ord for the eight standard integer widths and for
;;; pointers, and Eq for bool; an `i7` or `i128` compare has no operator and keeps
;;; its primitive. (A suggestion that does not compile reverts the whole round.)
(defn mz-cmp-supported? [(kind i64) (ty Code)] (-> bool)
  (or (mz-std-int? ty)
      (mz-head? ty `ptr)
      (and (<= kind 2) (= ty `bool))))

;;; Inside `(impl Eq i8 (= … (icmp-eq a b)))` the primitive IS `=` on i8.
(defn mz-defines-cmp? [(impl-form Code) (ty Code)] (-> bool)
  (and (mz-head? impl-form `impl)
       (let [at (if (primitive/code-vector? (get impl-form 1)) 2 1)
             trait (get impl-form at)]
         (and (or (= trait `Eq) (= trait `Ord))
              (< (+ at 1) (len impl-form))
              (= (get impl-form (+ at 1)) ty)))))

; 1-6 are the integer comparisons. (coil.str's `str-eq` was the seventh; it was
; removed for `=`, and `coil lint --fix`'s preflight migrates it from
; src/compiler/api_renames.coil.)
(defn mz-compare-kind [(head (slice u8)) (env Code)] (-> i64)
  (cond (names/ln-is? head env "coil.primitive/icmp-eq") 1
        (names/ln-is? head env "coil.primitive/icmp-ne") 2
        (names/ln-is? head env "coil.primitive/icmp-lt") 3
        (names/ln-is? head env "coil.primitive/icmp-le") 4
        (names/ln-is? head env "coil.primitive/icmp-gt") 5
        (names/ln-is? head env "coil.primitive/icmp-ge") 6
        :else 0))

;;; The operator a comparison rewrite inserts, and the spellings that can say it,
;;; plainest first (see `names/ln-spelling-at`).
(defn mz-compare-target [(kind i64)] (-> (slice u8))
  (cond (= kind 2) "coil.core.!="
        (= kind 3) "coil.core.<"
        (= kind 4) "coil.core.<="
        (= kind 5) "coil.core.>"
        (= kind 6) "coil.core.>="
        :else "coil.core.="))

(defn mz-compare-spellings [(kind i64)] (-> Code)
  (cond (= kind 2) `(!= coil.core.!=)
        (= kind 3) `(< Ord::< coil.core.<)
        (= kind 4) `(<= Ord::<= coil.core.<=)
        (= kind 5) `(> Ord::> coil.core.>)
        (= kind 6) `(>= Ord::>= coil.core.>=)
        :else `(= Eq::= coil.core.=)))

;;; `_` when no spelling of the operator reaches it at `f`.
(defn mz-replacement [(f Code) (kind i64) (env Code)] (-> Code)
  (let [op (names/ln-spelling-at f (mz-compare-spellings kind) (mz-compare-target kind))]
    (if (= op `_)
        `_
        (match (mz-cmp-type f env)
          (Some [ty]
            `(~op ~(mz-cmp-arg (primitive/code-nth f 1) ty env)
                  ~(mz-cmp-arg (primitive/code-nth f 2) ty env)))
          (None [] `_)))))

; The collection traits are the public vocabulary; the representation-specific
; functions remain available for implementing those traits and for low-level
; code that genuinely needs a representation operation. Calls may carry an
; explicit type-argument vector, so take operands from the tail instead of from
; fixed positions. (Library names that were removed outright, such as
; coil.arraylist's `al-len` and coil.slice's `slice-len`, are migrated by
; `coil lint --fix`'s preflight from src/compiler/api_renames.coil, not here.)
(defn mz-collection-kind [(head (slice u8)) (env Code)] (-> i64)
  (cond ; Len
        (names/ln-is? head env "coil.primitive/code-count") 1
        ; Get
        (names/ln-is? head env "coil.primitive/code-nth") 3
        ; Code equality has the same whole-tree equality semantics as Eq Code.
        (names/ln-is? head env "coil.primitive/code-eq") 7
        :else 0))

; `code-list-push!` deliberately is not a leaf rewrite. It mutates through a
; by-value handle, while Push requires a mutable place; changing the call alone
; would reject an immutable binding.
(defn mz-tail-arg [(f Code) (from-end i64)] (-> Code)
  (primitive/code-nth f (- (primitive/code-count f) from-end)))

;;; The trait method (or function) a collection rewrite inserts, and the spellings
;;; that can say it, plainest first (see `names/ln-spelling-at`).
(defn mz-collection-target [(kind i64)] (-> (slice u8))
  (cond (= kind 1) "coil.core.len"
        (= kind 3) "coil.core.get"
        :else "coil.core.="))

(defn mz-collection-spellings [(kind i64)] (-> Code)
  (cond (= kind 1) `(len Len::len)
        (= kind 3) `(get Get::get)
        :else `(= Eq::=)))

;;; `_` when no spelling of the method reaches it at `f`.
(defn mz-collection-replacement [(f Code) (kind i64)] (-> Code)
  (let [op (names/ln-spelling-at f (mz-collection-spellings kind) (mz-collection-target kind))]
    (cond (= op `_) `_
          (= kind 1) `(~op ~(mz-tail-arg f 1))
          (= kind 3) `(~op ~(mz-tail-arg f 2) ~(mz-tail-arg f 1))
          :else `(~op ~(mz-tail-arg f 2) ~(mz-tail-arg f 1)))))

; These names were briefly auto-referred from coil.core. Static storage is now an
; explicitly low-level primitive; stack storage needs the whole-expression migration
; below, and heap ownership needs box/typed allocation rather than a token rewrite.
(defn mz-ambient-replacement [(f Code)] (-> Code)
  (cond (mz-alloc-head? f `static)
          `(primitive/alloc-static ~(primitive/code-nth f 1))
        (mz-head? f `iand)
          `(primitive/iand ~(primitive/code-nth f 1) ~(primitive/code-nth f 2))
        (mz-head? f `ior)
          `(primitive/ior ~(primitive/code-nth f 1) ~(primitive/code-nth f 2))
        (mz-head? f `ixor)
          `(primitive/ixor ~(primitive/code-nth f 1) ~(primitive/code-nth f 2))
        (mz-head? f `ishl)
          `(primitive/ishl ~(primitive/code-nth f 1) ~(primitive/code-nth f 2))
        (mz-head? f `ishr)
          `(primitive/ishr ~(primitive/code-nth f 1) ~(primitive/code-nth f 2))
        (mz-head? f `udiv)
          `(primitive/udiv ~(primitive/code-nth f 1) ~(primitive/code-nth f 2))
        (mz-head? f `urem)
          `(primitive/urem ~(primitive/code-nth f 1) ~(primitive/code-nth f 2))
        (mz-head? f `fcmp-eq)
          `(primitive/fcmp-eq ~(primitive/code-nth f 1)
                              ~(primitive/code-nth f 2))
        (mz-head? f `fcmp-ne)
          `(primitive/fcmp-ne ~(primitive/code-nth f 1)
                              ~(primitive/code-nth f 2))
        (mz-head? f `fcmp-lt)
          `(primitive/fcmp-lt ~(primitive/code-nth f 1)
                              ~(primitive/code-nth f 2))
        (mz-head? f `fcmp-le)
          `(primitive/fcmp-le ~(primitive/code-nth f 1)
                              ~(primitive/code-nth f 2))
        (mz-head? f `fcmp-gt)
          `(primitive/fcmp-gt ~(primitive/code-nth f 1)
                              ~(primitive/code-nth f 2))
        (mz-head? f `fcmp-ge)
          `(primitive/fcmp-ge ~(primitive/code-nth f 1)
                              ~(primitive/code-nth f 2))
        :else `0))

; `(stack T)` / `(static T)` / `(heap T)` take exactly ONE argument, so a form with
; any other arity is not the ambient allocator being called and must not be rewritten.
; Without this, `(heap)` — an ordinary zero-arg call to a function someone named
; `heap` — was rewritten to `(alloc/heap u8)`, silently turning a bump-arena base
; address into a fresh one-byte allocation and SIGBUS-ing at run time
; (src/experiments/gc-dialect/arena.coil).
(defn mz-alloc-head? [(f Code) (name Code)] (-> bool)
  (and (mz-head? f name) (= (primitive/code-count f) 2)))

(defn mz-ambient? [(f Code)] (-> bool)
  (or (mz-alloc-head? f `static)
      (or (mz-head? f `iand)
          (mz-head? f `ior)
          (mz-head? f `ixor)
          (mz-head? f `ishl)
          (mz-head? f `ishr)
          (mz-head? f `udiv)
          (mz-head? f `urem)
          (mz-head? f `fcmp-eq)
          (mz-head? f `fcmp-ne)
          (mz-head? f `fcmp-lt)
          (mz-head? f `fcmp-le)
          (mz-head? f `fcmp-gt)
          (mz-head? f `fcmp-ge))))

; Serde's original four derive entry points were replaced by the registry-backed
; `(derive Trait... Type)` form. Keep this migration in the default lint profile:
; otherwise an old derive is unknown during lint's post-fix validation, which makes
; the transactional fixer roll back the repair that would have made it valid.
;
; Spelling-matched on purpose, not an oversight of the resolver above: these macros
; no longer exist in any module, so there is no owner for `ln-is?` to resolve them
; against. The only thing left to recognize is the old text.
(defn mz-legacy-derive? [(f Code)] (-> bool)
  (and (primitive/code-list? f)
       (and (>= (primitive/code-count f) 2)
            (or (mz-head? f `derive-serde)
                (or (mz-head? f `derive-serde-sum)
                    (or (mz-head? f `derive-serialize)
                        (mz-head? f `derive-deserialize)))))))

;;; A growable Code list, not `(~x ~@(self …)): re-splicing the recursion's
;;; result copies the suffix at every level — quadratic in the tail length
;;; (docs/design/META_MEMORY.md).
(defn mz-code-tail [(f Code) (i i64) (n i64)] (-> Code)
  (let [out (primitive/code-list-new)
        (mut k) i]
    (loop (if (>= (load k) n)
              (break)
              (do
                (primitive/code-list-push! out (primitive/code-nth f (load k)))
                (store! k (primitive/iadd (load k) 1)))))
    (primitive/code-list-done out)))

;;; `or` is a variadic short-circuiting syntax form. Nested `or` operands preserve
;;; exactly the same left-to-right evaluation order when spliced into their parent,
;;; so collapse the whole connected tree in one suggestion instead of making the
;;; transactional fixer rediscover one binary layer per round.
(defn mz-nested-or? [(f Code)] (-> bool)
  (and (mz-head? f `or)
       (mz-or-child? f 1 (primitive/code-count f))))

(defn mz-or-child? [(f Code) (i i64) (n i64)] (-> bool)
  (if (>= i n)
      false
      (or (mz-head? (primitive/code-nth f i) `or)
          (mz-or-child? f (+ i 1) n))))

(defn mz-flatten-or-into [(f Code) (out CodeBuilder)] (-> CodeBuilder)
  (mz-flatten-or-tail f out 1 (primitive/code-count f)))

(defn mz-flatten-or-tail [(f Code) (out CodeBuilder) (i i64) (n i64)] (-> CodeBuilder)
  (if (>= i n)
      out
      (let [operand (primitive/code-nth f i)]
        (do
          (if (mz-head? operand `or)
              (mz-flatten-or-into operand out)
              (primitive/code-list-push! out operand))
          (mz-flatten-or-tail f out (+ i 1) n)))))

(defn mz-flatten-or [(f Code)] (-> Code)
  (let [out (primitive/code-list-new)]
    ; The one final splice is semantically important as well as linear-time: it
    ; marks the reused operands as transported author syntax, so suggestion
    ; rendering preserves spellings such as `` `icmp-lt `` verbatim.
    `(or ~@(primitive/code-list-done (mz-flatten-or-into f out)))))

;;; The bitwise operators are variadic too (`(| a b c)` folds to `(| (| a b) c)`),
;;; and on the standard integer types they are associative, so a nested chain of
;;; one of them is the same value flattened, its operands evaluated in the same
;;; order. Not `+ - *`: `-` is not associative, and under coil.safety `+` and `*`
;;; check each intermediate result, so regrouping changes which one can overflow.
;;; Nor a user type's `BitOr`, which promises no associativity.
;;; The core operator `f` calls (`coil.core.|`, `&` or `^`), in any spelling that
;;; reaches it, or `_`.
(defn mz-bitwise-op [(f Code)] (-> Code)
  (let [head (names/ln-head-text f)
        n (len head)]
    (if (or (= n 0)
            (not (or (= (get head (- n 1)) (: 124 u8))      ; |
                     (= (get head (- n 1)) (: 38 u8))       ; &
                     (= (get head (- n 1)) (: 94 u8)))))    ; ^
        `_
        (match (primitive/resolve-at f (primitive/code-nth f 0))
          (primitive/ResolvesTo [r]
            (if (or (= r `coil.core.|) (= r `coil.core.&) (= r `coil.core.^)) r `_))
          (_ `_)))))

;;; Does `f` call a bitwise operator on a standard integer type with an operand
;;; that calls the same one?
(defn mz-nested-bitwise? [(f Code)] (-> bool)
  (let [op (mz-bitwise-op f)]
    (and (not (= op `_))
         (match (mz-type-of f) (Some [t] (mz-std-int? t)) (None [] false))
         (block :found
           (for [i 1 (primitive/code-count f)]
             (let [x (primitive/code-nth f i)]
               (when (and (primitive/code-list? x)
                          (not (primitive/code-macro? x))
                          (= (mz-bitwise-op x) op))
                 (break :found true))))
           false))))

(defn mz-flatten-bitwise-into [(f Code) (op Code) (out CodeBuilder)] (-> CodeBuilder)
  (for [i 1 (primitive/code-count f)]
    (let [x (primitive/code-nth f i)]
      (if (and (primitive/code-list? x)
               (not (primitive/code-macro? x))
               (= (mz-bitwise-op x) op))
          (mz-flatten-bitwise-into x op out)
          (primitive/code-list-push! out x))))
  out)

(defn mz-flatten-bitwise [(f Code)] (-> Code)
  (let [out (primitive/code-list-new)]
    `(~(primitive/code-nth f 0)
      ~@(primitive/code-list-done (mz-flatten-bitwise-into f (mz-bitwise-op f) out)))))

(defn mz-trait-spec [(trait Code) (f Code)] (-> Code)
  (let [n (primitive/code-count f)]
    (if (= n 2) trait `(~trait ~@(mz-code-tail f 2 n)))))

(defn mz-derive-replacement [(f Code)] (-> Code)
  (let [target (primitive/code-nth f 1)]
    (cond (or (mz-head? f `derive-serde) (mz-head? f `derive-serde-sum))
            `(derive ~(mz-trait-spec `Serialize f)
                     ~(mz-trait-spec `Deserialize f)
                     ~target)
          (mz-head? f `derive-serialize)
            `(derive ~(mz-trait-spec `Serialize f) ~target)
          :else `(derive ~(mz-trait-spec `Deserialize f) ~target))))

; `impl-form` — the enclosing `(impl …)` form, or `_` outside one: inside
; `(impl Eq i8 (= … (icmp-eq a b)))` the primitive IS `=` on i8 (mz-defines-cmp?).
; Declaration positions contain `(name Type)` binders, not calls. In particular,
; `(static (ref T))` in a function parameter list must not be rewritten as an
; allocation. Walk function and method bodies, but skip their parameter vectors.
; Struct and sum declarations contain only binders, so skip those entirely.
(defn mz-binder-form? [(f Code)] (-> bool)
  (or (mz-head? f `defstruct) (mz-head? f `defsum)))

;;; Stack cells: `(alloc/stack T)` is the legacy spelling of `primitive/alloc-stack`,
;;; and both migrate to a mutable local (see the general stack-cell migration below).
;;; One rewrite per fixer round keeps binding identity and source spans simple; the
;;; transactional fixer recompiles before applying the next one.
(defn mz-legacy-stack-call? [(f Code) (env Code)] (-> bool)
  (and (primitive/code-list? f)
       (= (primitive/code-count f) 2)
       (names/ln-is? (names/ln-head-text f) env "coil.alloc/stack")))

(defn mz-stack-call? [(f Code) (env Code)] (-> bool)
  (or (mz-legacy-stack-call? f env)
      (and (primitive/code-list? f)
           (= (primitive/code-count f) 2)
           (names/ln-is? (names/ln-head-text f)
                         env
                         "coil.primitive/alloc-stack"))))

(defn mz-allocator-ptr? [(f Code) (env Code)] (-> bool)
  (and (mz-head? f `ptr)
       (= (primitive/code-count f) 2)
       (names/ln-names? (primitive/code-nth f 1) env "coil.alloc/Allocator")))

; `set!` and `store!` are core names — auto-referred into every module — so their
; spelling is universal and needs no environment; only the coil.primitive spelling
; has to resolve.
(defn mz-store? [(f Code) (env Code)] (-> bool)
  (and (primitive/code-list? f)
       (= (primitive/code-count f) 3)
       (or (mz-head? f `set!)
           (mz-head? f `store!)
           (names/ln-is? (names/ln-head-text f) env "coil.primitive/store!"))))

(defn mz-mentions-binding? [(f Code) (target Code) (bid i64)] (-> bool)
  (if (primitive/code-sym? f)
      (or (and (!= bid 0) (= (primitive/binding-of f) bid))
          (primitive/code-eq f target))
      (if (primitive/code-list? f)
          (mz-kid-mentions-binding? f target bid 0 (primitive/code-count f))
          false)))

(defn mz-kid-mentions-binding? [(f Code)
                                (target Code)
                                (bid i64)
                                (i i64)
                                (n i64)] (-> bool)
  (if (>= i n)
      false
      (if (mz-mentions-binding? (primitive/code-nth f i) target bid)
          true
          (mz-kid-mentions-binding? f target bid (+ i 1) n))))

(defn mz-target-symbol? [(f Code) (target Code) (bid i64)] (-> bool)
  (and (primitive/code-sym? f)
       (if (!= bid 0)
           (= (primitive/binding-of f) bid)
           (primitive/code-eq f target))))

;;; ---- general stack-cell migration -------------------------------------------
;;;
;;;   (let [… x (primitive/alloc-stack T) …] (store! x v) body…)
;;;   -> (let [… (mut x) v …] body′…)
;;;
;;; A mutable local IS frame storage with an address, so a stack cell becomes one
;;; whenever every use of the cell has a local spelling: `(load x)` is `x`, a store
;;; is `(set! x v)`, field access `(.f x)` reads the local in place, and handing
;;; the cell to a function or extern is `(mut x)`, which passes the local's address
;;; as the pointer. Without an initializing store the local starts `(zeroed T)`.
;;; Any other use (the cell as a value, in `field`/`index`, as a direct macro or
;;; special-form operand, captured by a `fn`, inside a template) keeps the cell.
;;;
;;; A cell never runs Drop and a local does, so a type that owns anything keeps its
;;; cell: one that implements Drop, holds a field or variant that does, or that
;;; the lint cannot see into (asked of the checked program via code-type-traits).

(defn mz-scalar-type? [(ty Code)] (-> bool)
  (and (primitive/code-sym? ty)
       (let [s (primitive/code-sym ty)]
         (or (= s "bool") (= s "isize") (= s "usize")
             (and (> (len s) 1)
                  (let [c (cast i64 (get s 0))]
                    (or (= c 105) (= c 117) (= c 102))))))))  ; i… u… f…

(defn mz-traits-have? [(traits Code) (name (slice u8))] (-> bool)
  (let [(mut found) false]
    (when (primitive/code-list? traits)
      (for [i 0 (len traits)]
        (when (and (primitive/code-sym? (get traits i))
                   (= (primitive/code-sym (get traits i)) name))
          (set! found true))))
    found))

;;; May a value of type `ty` (a type as type-of reports it) own something?
;;; Unknown answers yes.
(defn mz-owner? [(ty Code) (depth i64)] (-> bool)
  (cond (> depth 8) true
        (mz-scalar-type? ty) false
        (and (primitive/code-list? ty) (> (len ty) 0)
             (or (mz-head? ty `ptr) (mz-head? ty `slice) (mz-head? ty `fnptr)
                 (mz-head? ty `ref) (mz-head? ty `mut)))
          false
        (and (mz-head? ty `array) (= (len ty) 3)) (mz-owner? (get ty 1) (+ depth 1))
        :else
          (match (primitive/code-type-traits ty)
            (primitive/TraitsUnknown [] true)
            (primitive/TraitsAre [traits]
              (cond (mz-traits-have? traits "coil.core.Drop") true
                    (mz-traits-have? traits "coil.core.Copy") false
                    (not (primitive/code-sym? ty)) true
                    :else
                      (match (primitive/code-type-shape ty)
                        (primitive/StructShape []
                          (let [(mut owns) false]
                            (for [i 0 (primitive/code-field-count ty)]
                              (when (mz-owner? (primitive/code-field-qtype ty i) (+ depth 1))
                                (set! owns true)))
                            owns))
                        (primitive/SumShape []
                          (let [(mut owns) false]
                            (for [v 0 (primitive/code-variant-count ty)]
                              (for [i 0 (primitive/code-variant-fields ty v)]
                                (when (mz-owner? (primitive/code-variant-field-type ty v i) (+ depth 1))
                                  (set! owns true))))
                            owns))
                        (primitive/UnknownShape [] true)))))))

(defn mz-special-form? [(f Code)] (-> bool)
  (or (mz-head? f `if) (mz-head? f `do) (mz-head? f `when) (mz-head? f `unless)
      (mz-head? f `cond) (mz-head? f `case) (mz-head? f `let) (mz-head? f `let*)
      (mz-head? f `loop) (mz-head? f `while) (mz-head? f `for) (mz-head? f `block)
      (mz-head? f `return-from) (mz-head? f `break) (mz-head? f `continue)
      (mz-head? f `and) (mz-head? f `or) (mz-head? f `not) (mz-head? f `match)
      (mz-head? f `scope) (mz-head? f `defer) (mz-head? f `set!) (mz-head? f `:)
      (mz-head? f `quote) (mz-head? f `mut) (mz-head? f `defn) (mz-head? f `defn*)))

(defn mz-field-access? [(f Code)] (-> bool)
  (and (primitive/code-list? f) (not (primitive/code-vector? f)) (> (len f) 1)
       (primitive/code-sym? (get f 0))
       (let [s (primitive/code-sym (get f 0))]
         (and (> (len s) 1) (= (cast i64 (get s 0)) 46)))))  ; `.f` / `..`

;;; `f` with its children from `from` rewritten. A form none of whose children
;;; mention the cell comes back as the original syntax, untouched, so the fix
;;; rebuilds only the path down to each use.
(defn mz-symbols-of [(pattern Code) (out CodeBuilder)] (-> i64)
  (cond (primitive/code-sym? pattern) (do (primitive/code-list-push! out pattern) 0)
        (primitive/code-list? pattern)
          (do (for [i 0 (len pattern)] (mz-symbols-of (get pattern i) out)) 0)
        :else 0))

(defn mz-mentions-spelling? [(f Code) (name Code)] (-> bool)
  (cond (primitive/code-sym? f) (= f name)
        (primitive/code-list? f)
          (let [(mut found) false]
            (for [i 0 (len f)] (when (mz-mentions-spelling? (get f i) name) (set! found true)))
            found)
        :else false))

;;; Does `value` mention a name that a binder at `from`, `from + 2`, … introduces?
(defn mz-mentions-later-binder? [(value Code) (binds Code) (from i64)] (-> bool)
  (let [names (primitive/code-list-new)
        (mut j) from]
    (while (< j (len binds))
      (mz-symbols-of (get binds j) names)
      (set! j (+ j 2)))
    (let [done (primitive/code-list-done names)
          (mut found) false]
      (for [i 0 (len done)]
        (when (mz-mentions-spelling? value (get done i)) (set! found true)))
      found)))

(defn mz-cell-rewrite-kids [(f Code) (env Code) (target Code) (bid i64)
                            (ok (ptr bool)) (from i64) (as-call bool)] (-> Code)
  (if (not (mz-mentions-binding? f target bid))
      f
      (let [out (primitive/code-list-new)]
        (for [i 0 (len f)]
          (let [kid (get f i)]
            (primitive/code-list-push! out
              (cond (< i from) kid
                    (mz-target-symbol? kid target bid)
                      (if as-call `(mut ~target) (do (store! ok false) kid))
                    :else (mz-cell-rewrite kid env target bid ok)))))
        (let [done (primitive/code-list-done out)]
          (if (primitive/code-vector? f) `[~@done] `(~@done))))))

;;; `f` with every use of the cell `target` in its local spelling; clears `ok` at
;;; a use that has none.
(defn mz-cell-rewrite [(f Code) (env Code) (target Code) (bid i64) (ok (ptr bool))] (-> Code)
  (cond (mz-target-symbol? f target bid) (do (store! ok false) f)
        (not (primitive/code-list? f)) f
        (primitive/code-vector? f) (mz-cell-rewrite-kids f env target bid ok 0 false)
        (or (mz-head? f `quasiquote) (mz-head? f `fn))
          (do (when (mz-mentions-binding? f target bid) (store! ok false)) f)
        (and (= (len f) 2)
             (or (mz-head? f `load) (names/ln-is? (names/ln-head-text f) env "coil.primitive/load"))
             (mz-target-symbol? (get f 1) target bid))
          target
        (and (mz-store? f env) (mz-target-symbol? (get f 1) target bid))
          `(set! ~target ~(mz-cell-rewrite (get f 2) env target bid ok))
        (and (mz-field-access? f) (mz-target-symbol? (get f 1) target bid))
          (mz-cell-rewrite-kids f env target bid ok 2 false)
        (or (mz-head? f `field) (mz-head? f `index)
            (names/ln-is? (names/ln-head-text f) env "coil.primitive/field")
            (names/ln-is? (names/ln-head-text f) env "coil.primitive/index"))
          (mz-cell-rewrite-kids f env target bid ok 1 false)
        (or (primitive/code-macro-call? f) (mz-special-form? f)
            (not (primitive/code-sym? (get f 0))))
          (mz-cell-rewrite-kids f env target bid ok 0 false)
        ; A function or extern parameter takes `(mut x)` as the pointer; so does
        ; `cast`. `call-ptr`, a constructor, a trait method, a macro (a `defn`
        ; returning Code, whose expansion decides what the operand becomes) or
        ; anything the checker did not resolve does not, so the cell stays.
        :else
          (mz-cell-rewrite-kids f env target bid ok 1
                                (match (primitive/code-decl f)
                                  (primitive/Declared [_ kind qname signature]
                                    (match kind
                                      (primitive/FunctionDecl [] (not (= (get signature 1) `code)))
                                      (primitive/ExternDecl [] true)
                                      (primitive/PrimitiveDecl [] (= qname `coil.primitive.cast))
                                      (_ false)))
                                  (_ false)))))

;;; Does `value`, bound alone, have type `ty`? Its checked type is no answer: in
;;; the store it was typed by the cell, so `[1 2]` stored into an `(array u32 2)`
;;; checked as one, and bound alone it is `(array i64 2)`. Literals, arithmetic,
;;; `if` and generic calls all take their type from context like that; a local
;;; does not, and a bare literal has its default type.
(defn mz-type-standalone? [(value Code) (ty Code)] (-> bool)
  (cond (primitive/code-int? value) (primitive/code-eq ty `i64)
        (primitive/code-float? value) (primitive/code-eq ty `f64)
        (primitive/code-sym? value)
          (and (mz-local-at? value value)
               (match (mz-type-of value) (Some [t] (= t ty)) (None [] false)))
        :else false))

;;; The migration of the let `f` whose binding `bi` is a stack cell, or `_`.
(defn mz-migrate-cell [(f Code) (env Code) (binds Code) (bi i64)] (-> Code)
  (match (mz-type-of (get binds (+ bi 1)))
    (None [] `_)
    (Some [cell-type] (mz-migrate-cell-of f env binds bi cell-type))))

(defn mz-migrate-cell-of [(f Code) (env Code) (binds Code) (bi i64) (cell-type Code)] (-> Code)
  (let [target (get binds bi)
        bid (primitive/binding-of target)
        alloc (get binds (+ bi 1))]
    (if (or (not (mz-head? cell-type `ptr)) (mz-owner? (get cell-type 1) 0)
            (not (primitive/code-sym? target)))
        `_
        (let [elem-type (get cell-type 1)
              written (get alloc 1)
              first (get f 2)
              ; the store's value becomes the cell's binding, so it may not read
              ; the cell, nor a name bound after the cell in this let
              initialized (and (mz-store? first env)
                               (mz-target-symbol? (get first 1) target bid)
                               (not (mz-mentions-binding? (get first 2) target bid))
                               (not (mz-mentions-later-binder? (get first 2) binds (+ bi 2))))
              value (if initialized (get first 2) `_)
              init (cond (not initialized) `(zeroed ~written)
                         (mz-type-standalone? value elem-type) value
                         :else `(: ~value ~written))
              (mut ok) true
              out-binds (primitive/code-list-new)]
          (for [i 0 (len binds)]
            (primitive/code-list-push! out-binds
              (cond (= i bi) `(mut ~target)
                    (= i (+ bi 1)) init
                    (and (> i (+ bi 1)) (= (% (- i bi) 2) 1))
                      (mz-cell-rewrite (get binds i) env target bid (mut ok))
                    :else (get binds i))))
          (let [body (primitive/code-list-new)]
            (for [i (if initialized 3 2) (len f)]
              (primitive/code-list-push! body (mz-cell-rewrite (get f i) env target bid (mut ok))))
            (if ok
                `(~(get f 0) [~@(primitive/code-list-done out-binds)]
                  ~@(primitive/code-list-done body))
                `_))))))

(defn mz-stack-binding-index [(binds Code) (env Code) (i i64) (n i64)] (-> i64)
  (if (>= (+ i 1) n)
      -1
      (if (and (primitive/code-sym? (primitive/code-nth binds i))
               (mz-stack-call? (primitive/code-nth binds (+ i 1)) env))
          i
          (mz-stack-binding-index binds env (+ i 2) n))))

;;; Is NAME, written as a call head at NODE, a local there?
(defn mz-local-at? [(node Code) (name Code)] (-> bool)
  (match (primitive/resolve-at node name)
    (primitive/ResolvesLocal [] true)
    (_ false)))

;;; Is `f`'s head a local here? The import-based recognition above cannot see one,
;;; and a call through a local named `code-count` is not a call of coil.primitive's.
(defn mz-head-local? [(f Code)] (-> bool)
  (mz-local-at? f (primitive/code-nth f 0)))

;;; A template's text is data; only its holes are code (see names/ln-template-holes).
(defn mz-walk [(f Code) (env Code) (impl-form Code)] (-> i64)
  (if (names/ln-quasiquote? f)
      (do
        (for hole (names/ln-template-holes f) (mz-walk hole env impl-form))
        0)
      (mz-walk-form f env impl-form)))

(defn mz-walk-form [(f Code) (env Code) (impl-form Code)] (-> i64)
  (let [in-impl (mz-head? impl-form `impl)
        head (names/ln-head-text f)
        collection-kind (mz-collection-kind head env)
        compare-kind (mz-compare-kind head env)
        nested-or-fix
        ; Own the entire connected `or` tree in one suggestion. Descending after
        ; this would register overlapping child edits for the same source span.
        (if (mz-nested-or? f)
            (do
              (names/ln-suggest f
                                 "`or` is variadic; flatten nested disjunctions"
                                 (mz-flatten-or f))
              true)
            false)
        nested-bitwise-fix
        ; The same for a chain of one bitwise operator.
        (if (and (not nested-or-fix) (mz-nested-bitwise? f))
            (do
              (names/ln-suggest f
                                 "bitwise operators are variadic; flatten the nested chain"
                                 (mz-flatten-bitwise f))
              true)
            false)
          stack-fix
        ; Unlike leaf suggestions, this intentionally targets the source `let`
        ; macro itself so the allocation and its initializing store can be
        ; replaced transactionally as one expression.
        (if (and (or (mz-head? f `let) (mz-head? f `let*))
                 (>= (primitive/code-count f) 3))
            (let [binds (primitive/code-nth f 1)]
              (if (primitive/code-vector? binds)
                  (let [bi
                          (mz-stack-binding-index binds
                                                  env
                                                  0
                                                  (primitive/code-count binds))]
                    (if (>= bi 0)
                        (let [replacement (mz-migrate-cell f env binds bi)]
                          (if (= replacement `_)
                              false
                              (do
                                (names/ln-suggest f
                                                   "a stack cell whose every use has a local spelling is a mutable local"
                                                   replacement)
                                true)))
                        false))
                  false))
            false)]
    (if (and (primitive/code-list? f) (not (mz-binder-form? f)))
        (do
          (when (and (not (primitive/code-macro? f)) (mz-ambient? f))
            (names/ln-suggest f
                               "qualify the operation from its owning module"
                               (mz-ambient-replacement f))
            0)
          (when (and (not (primitive/code-macro? f))
                     (!= compare-kind 0)
                     (not (mz-head-local? f))
                     (match (mz-cmp-type f env)
                       (Some [ty]
                         (and (mz-cmp-supported? compare-kind ty)
                              (not (mz-defines-cmp? impl-form ty))))
                       (None [] false)))
            (let [replacement (mz-replacement f compare-kind env)]
              (unless (= replacement `_)
                (names/ln-suggest f "use the clean integer comparison operator" replacement)
                0))
            0)
          (when (and (not in-impl)
                     (and (not (primitive/code-macro? f))
                          (and (!= collection-kind 0) (not (mz-head-local? f)))))
            (let [replacement (mz-collection-replacement f collection-kind)]
              (unless (= replacement `_)
                (names/ln-suggest f "use the collection trait method" replacement)
                0))
            0)
          (when (mz-legacy-derive? f)
            (names/ln-suggest f
                               "use the registry-backed derive form"
                               (mz-derive-replacement f))
            0)
          (when (mz-allocator-ptr? f env)
            (names/ln-suggest f
                               "allocators are object-safe trait values"
                               `(dyn ~(primitive/code-nth f 1)))
            0)
          (when (not (primitive/code-macro? f))
            (let [replacement (mz-literal-cast-replacement f head env)]
              (unless (= replacement `_)
                (names/ln-suggest f "a literal its type holds needs no cast" replacement)
                0))
            0)
          (if (or stack-fix nested-or-fix nested-bitwise-fix)
              0
              (do
                (when (and (primitive/code-from-user? f)
                           (mz-legacy-stack-call? f env))
                  (names/ln-suggest f
                                     "legacy alloc/stack could not be migrated to an initialized local safely; preserve it only as explicit unsafe primitive storage"
                                     `(primitive/alloc-stack ~(primitive/code-nth f
                                                                                  1)))
                  0)
                (cond (or (mz-head? f `defn) (mz-head? f `defn*))
                        (mz-kids f env (mz-body-start f 2 3) (primitive/code-count f) impl-form)
                      (mz-head? f `fn)
                        (mz-kids f env 2 (primitive/code-count f) impl-form)
                      (or (mz-head? f `impl) (mz-head? f `deftrait))
                        (mz-method-kids f env)
                      :else
                        (mz-kids f env 0 (primitive/code-count f) impl-form)))))
        0)))

(defn mz-body-start [(f Code) (i i64) (fallback i64)] (-> i64)
  (if (>= i (primitive/code-count f)) fallback
      (if (mz-head? (primitive/code-nth f i) `->)
          (+ i 1)
          (mz-body-start f (+ i 1) fallback))))

(defn mz-method-kids [(f Code) (env Code)] (-> i64)
  (let [(mut i) 1]
    (loop (if (>= (load i) (primitive/code-count f))
              (break)
              (do
                (let [child (primitive/code-nth f (load i))
                      at (names/ln-method-params-at child)]
                  (when (>= at 0)
                    (mz-kids child env (mz-body-start child (+ at 1) (+ at 1))
                             (primitive/code-count child) (if (mz-head? f `impl) f `_))
                    0))
                (store! i (+ (load i) 1)))))
    0))

(defn mz-kids [(f Code) (env Code) (i i64) (n i64) (impl-form Code)] (-> i64)
  (let [(mut k) i]
    (loop (if (>= (load k) n)
              (break)
              (do
                (mz-walk (primitive/code-nth f (load k)) env impl-form)
                (store! k (primitive/iadd (load k) 1)))))
    0))

;;; Is any form in this module the user's own source? Modules assembled from the
;;; stdlib carry no user forms and must not be linted; the user's module must be.
;;;
;;; ⚠ THIS ASKS ABOUT THE WHOLE MODULE, NOT ABOUT FORM 1, AND THAT IS THE POINT.
;;; It used to test `(code-from-user? (code-nth m 1))` — element 1 alone, on the
;;; assumption that the first form after the module name is user code. That
;;; assumption was true only because the loader CONSUMED `import` forms and
;;; dropped them.
;;;
;;; Once the loader started keeping imports so metaprograms could see them, form 1
;;; of a module that imports anything became the `(import …)` — which is not user
;;; source — so this returned false and the ENTIRE module was skipped. Every
;;; checker finding vanished for any file with an import, which is nearly every
;;; file. `coil lint --fix` then reported success and changed nothing: no
;;; diagnostics, exit 0, byte-identical file.
;;;
;;; That silent-success shape is the worst failure mode a linter has, so the test
;;; is now positional-independent. A module qualifies if it contains user source
;;; ANYWHERE, which is what the question was always meant to be.
(defn mz-user-module? [(m Code) (i i64) (n i64)] (-> bool)
  (if (>= i n)
      false
      (if (primitive/code-from-user? (primitive/code-nth m i))
          true
          (mz-user-module? m (primitive/iadd i 1) n))))

(defn mz-module [(m Code) (prelude Code)] (-> i64)
  (if (and (> (primitive/code-count m) 1)
           (mz-user-module? m 1 (primitive/code-count m)))
      (mz-module-forms m
                       (names/ln-env prelude m)
                       1
                       (primitive/code-count m))
      0))

(defn mz-module-forms [(m Code) (env Code) (i i64) (n i64)] (-> i64)
  (let [(mut k) i]
    (loop (if (>= (load k) n)
              (break)
              (do
                (mz-walk (primitive/code-nth m (load k)) env `_)
                (store! k (primitive/iadd (load k) 1)))))
    0))

(defn mz-modules [(modules Code) (i i64) (n i64) (prelude Code)] (-> i64)
  (let [(mut k) i]
    (loop (if (>= (load k) n)
              (break)
              (do
                (mz-module (primitive/code-nth modules (load k)) prelude)
                (store! k (primitive/iadd (load k) 1)))))
    0))

(defn modernize-core-ops [(modules Code)] (-> Code)
  (do
    (mz-modules modules
                0
                (primitive/code-count modules)
                (names/ln-prelude modules 0 (primitive/code-count modules)))
    `0))

(checker modernize-core-ops)
