(module coil.lint.field-syntax)
(import "coil.primitive" :as primitive)
(import "coil.slice" :use [slice-get slice-len])

; Migrate low-level memory spelling to the value-oriented `.` field surface and
; generalized two-argument `set!` place assignment. This checker deliberately only
; rewrites a `field` form when its surrounding operation proves whether the author
; wanted its value (`load`) or its place (`store!`/`mut`). A standalone field place
; can be passed to pointer-taking code, so rewriting that to value-oriented `.` would
; silently change its type.
(defn fs-form? [(f Code) (n i64)] (-> bool)
  (and (primitive/code-list? f) (= (primitive/code-count f) n)))

(defn fs-head? [(f Code) (head Code)] (-> bool)
  (and (primitive/code-list? f)
       (and (> (primitive/code-count f) 0)
            (primitive/code-eq (primitive/code-nth f 0) head))))

(defn fs-head-either? [(f Code) (surface Code) (resolved Code)] (-> bool)
  (or (fs-head? f surface) (fs-head? f resolved)))

(defn fs-accessor? [(f Code)] (-> bool)
  (and (fs-form? f 2)
       (let [h (primitive/code-nth f 0)]
         (if (not (primitive/code-sym? h))
             false
             (let [name (primitive/code-sym h)]
               (and (> (slice-len name) 1)
                    (and (= (primitive/cast i64 (slice-get name 0)) 46)
                         (not (= (primitive/cast i64 (slice-get name 1)) 46)))))))))

(defn fs-macro-def? [(f Code)] (-> bool)
  (and (primitive/code-list? f)
       (and (> (primitive/code-count f) 3)
            (and (fs-head? f `defn)
                 (let [ret (primitive/code-nth f 3)]
                   (and (fs-form? ret 2)
                        (and (fs-head? ret `->)
                             (primitive/code-eq (primitive/code-nth ret 1) `Code))))))))

; `code-decl` is populated from the checked AST, including dedicated primitive
; nodes. The record is stable across `:as` aliases and refuses lookalike user
; functions: `(decl coil.primitive primitive NAME)`.
(defn fs-import-as [(f Code) (i i64) (n i64)] (-> Code)
  (if (>= i n)
      `:none
      (if (and (primitive/code-eq (primitive/code-nth f i) `:as) (< (+ i 1) n))
          (primitive/code-nth f (+ i 1))
          (fs-import-as f (+ i 1) n))))

(defn fs-primitive-aliases [(m Code) (i i64) (n i64)] (-> Code)
  (if (>= i n)
      `[]
      (let [f (primitive/code-nth m i)
            rest (fs-primitive-aliases m (+ i 1) n)]
        (if (and (fs-form? f (primitive/code-count f))
                 (and (> (primitive/code-count f) 1)
                      (and (fs-head? f `import)
                           (primitive/code-eq (primitive/code-nth f 1) `"coil.primitive"))))
            (let [alias (fs-import-as f 2 (primitive/code-count f))]
              (if (primitive/code-sym? alias) `[~alias ~@rest] rest))
            rest))))

(defn fs-alias-head? [(f Code) (name Code) (aliases Code) (i i64) (n i64)] (-> bool)
  (if (>= i n)
      false
      (let [alias (primitive/code-nth aliases i)]
        (if (and (primitive/code-sym? alias)
                 (fs-head? f (primitive/code-symbol (primitive/code-sym alias) "/" (primitive/code-sym name))))
            true
            (fs-alias-head? f name aliases (+ i 1) n)))))

(defn fs-primitive? [(f Code) (name Code) (aliases Code)] (-> bool)
  (let [d (primitive/code-decl f)]
    (or (and (primitive/code-list? d)
             (and (= (primitive/code-count d) 4)
                  (and (primitive/code-eq (primitive/code-nth d 0) `decl)
                       (and (primitive/code-eq (primitive/code-nth d 1) `coil.primitive)
                            (and (primitive/code-eq (primitive/code-nth d 2) `primitive)
                                 (primitive/code-eq (primitive/code-nth d 3)
                                                    (primitive/code-symbol "coil.primitive." (primitive/code-sym name))))))))
        (or (fs-head? f name)
            (fs-alias-head? f name aliases 0 (primitive/code-count aliases))))))

(defn fs-field? [(f Code) (aliases Code)] (-> bool)
  (and (fs-form? f 3) (fs-primitive? f `field aliases)))

(defn fs-unquote-symbol? [(f Code)] (-> bool)
  (if (not (primitive/code-sym? f))
      false
      (let [s (primitive/code-sym f)]
        (and (>= (slice-len s) 9)
             (and (= (primitive/cast i64 (slice-get s 0)) 117)
                  (and (= (primitive/cast i64 (slice-get s 1)) 110)
                       (and (= (primitive/cast i64 (slice-get s 2)) 113)
                            (and (= (primitive/cast i64 (slice-get s 3)) 117)
                                 (and (= (primitive/cast i64 (slice-get s 4)) 111)
                                      (and (= (primitive/cast i64 (slice-get s 5)) 116)
                                           (and (= (primitive/cast i64 (slice-get s 6)) 101)
                                                (and (= (primitive/cast i64 (slice-get s 7)) 95)
                                                     (= (primitive/cast i64 (slice-get s 8)) 95)))))))))))))

(defn fs-static-field? [(f Code) (aliases Code)] (-> bool)
  (and (fs-field? f aliases)
       (and (primitive/code-sym? (primitive/code-nth f 2))
            (not (fs-unquote-symbol? (primitive/code-nth f 2))))))

(defn fs-store? [(f Code) (aliases Code)] (-> bool)
  (and (fs-form? f 3) (fs-primitive? f `store! aliases)))

(defn fs-load? [(f Code) (aliases Code)] (-> bool)
  (and (fs-form? f 2) (fs-primitive? f `load aliases)))

(defn fs-pointer-type? [(f Code)] (-> bool)
  (let [ty (primitive/type-of f)]
    (and (primitive/code-list? ty)
         (and (> (primitive/code-count ty) 0)
              (let [h (primitive/code-nth ty 0)]
                (or (primitive/code-eq h `ptr) (primitive/code-eq h `mut)))))))

(defn fs-accessor-place [(f Code) (aliases Code)] (-> Code)
  (if (fs-static-field? f aliases)
      `(~(primitive/code-symbol "." (primitive/code-nth f 2)) ~(fs-accessor-place (primitive/code-nth f 1) aliases))
      f))

(defn fs-safe-value-tree? [(f Code) (i i64)] (-> bool)
  (if (not (primitive/code-list? f))
      true
      (if (or (primitive/code-macro? f) (primitive/code-macro-call? f))
          false
          (if (>= i (primitive/code-count f))
              true
              (and (fs-safe-value-tree? (primitive/code-nth f i) 1)
                   (fs-safe-value-tree? f (+ i 1)))))))

(defn fs-walk [(f Code) (aliases Code)] (-> Code)
  (if (primitive/code-list? f)
      (if (or (fs-macro-def? f)
              (or (primitive/code-macro? f) (primitive/code-macro-call? f)))
          `0
          (if (and (fs-form? f 3) (fs-head-either? f `set! `coil.core/set!))
              (fs-walk (primitive/code-nth f 2) aliases)
              (if (and (fs-store? f aliases)
                       (and (not (fs-head-either? f `set! `coil.core/set!))
                            (fs-safe-value-tree? (primitive/code-nth f 2) 1)))
                  (let [place (primitive/code-nth f 1)
                        value (primitive/code-nth f 2)]
                    (do
                      (primitive/suggest f
                                         "use generalized `set!` instead of the low-level store primitive"
                                         (if (fs-static-field? place aliases)
                                             `(set! ~(fs-accessor-place place aliases) ~value)
                                             `(set! ~place ~value)))
                      `0))
                  (if (and (fs-load? f aliases)
                           (and (not (fs-accessor? f))
                                (not (fs-pointer-type? f))))
                      (let [place (primitive/code-nth f 1)]
                        (if (fs-static-field? place aliases)
                            (do
                              (primitive/suggest f
                                                 "field access reads implicitly; use `.`"
                                                 (fs-accessor-place place aliases))
                              `0)
                            (if (fs-head-either? f `load `coil.core/load)
                                `0
                                (do
                                  (primitive/suggest f
                                                     "use the ambient `load` spelling outside low-level primitive code"
                                                     `(load ~place))
                                  `0))))
                      (if (and (fs-form? f 2) (fs-head? f `mut))
                          (let [place (primitive/code-nth f 1)]
                            (if (and (fs-static-field? place aliases) (not (fs-accessor? place)))
                                (do
                                  (primitive/suggest f
                                                     "use `.` for a field place borrowed with `mut`"
                                                     `(mut ~(fs-accessor-place place aliases)))
                                  `0)
                                `0))
                          (if (and (fs-field? f aliases)
                                   (not (or (fs-accessor? f)
                                            (fs-head-either? f `field `coil.core/field))))
                              (do
                                (primitive/suggest f
                                                   "use the ambient `field` spelling for an explicit field place"
                                                   `(field ~(primitive/code-nth f 1) ~(primitive/code-nth f 2)))
                                `0)
                              (fs-kids f aliases 0 (primitive/code-count f))))))))
      `0))

(defn fs-kids [(f Code) (aliases Code) (i i64) (n i64)] (-> Code)
  (if (>= i n)
      `0
      (do (fs-walk (primitive/code-nth f i) aliases) (fs-kids f aliases (+ i 1) n))))

(defn fs-module-forms [(m Code) (aliases Code) (i i64) (n i64)] (-> Code)
  (if (>= i n)
      `0
      (do
        (let [form (primitive/code-nth m i)]
          (if (primitive/code-from-user? form) (fs-walk form aliases) `0))
        (fs-module-forms m aliases (+ i 1) n))))

(defn fs-module [(m Code)] (-> Code)
  (let [aliases (fs-primitive-aliases m 1 (primitive/code-count m))]
    (fs-module-forms m aliases 1 (primitive/code-count m))))

(defn fs-modules [(modules Code) (i i64) (n i64)] (-> Code)
  (do (for item (iter (primitive/code-slice modules i n)) (fs-module item)) `0))

(defn lint-field-syntax [(modules Code)] (-> Code)
  (fs-modules modules 0 (primitive/code-count modules)))

(checker lint-field-syntax)
