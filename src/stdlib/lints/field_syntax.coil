(module coil.lint.field-syntax)
(import "coil.primitive" :as primitive)
(import "coil.slice" :use [slice-get slice-len])

; Name resolution — one fully-qualified name per rule; see names.coil.
(import "coil.lint.names" :as names)

; Migrate low-level memory spelling to the value-oriented `.` field surface and
; generalized two-argument `set!` place assignment. This checker deliberately only
; rewrites a `field` form when its surrounding operation proves whether the author
; wanted its value (`load`) or its place (`store!`/`mut`). A standalone field place
; can be passed to pointer-taking code, so rewriting that to value-oriented `.` would
; silently change its type.
(defn fs-form? [(f Code) (n i64)] (-> bool)
  (and (primitive/code-list? f) (= (primitive/code-count f) n)))

(defn fs-head? [(f Code) (head Code)] (-> bool)
  (and (primitive/code-list? f)
       (and (> (primitive/code-count f) 0)
            (primitive/code-eq (primitive/code-nth f 0) head))))

(defn fs-core? [(f Code) (env Code) (qname (slice u8))] (-> bool)
  (names/ln-is? (names/ln-head-text f) env qname))

(defn fs-accessor? [(f Code)] (-> bool)
  (and (fs-form? f 2)
       (let [h (primitive/code-nth f 0)]
         (if (not (primitive/code-sym? h))
             false
             (let [name (primitive/code-sym h)]
               (and (> (slice-len name) 1)
                    (and (= (primitive/cast i64 (slice-get name 0)) 46)
                         (not (= (primitive/cast i64 (slice-get name 1)) 46)))))))))

(defn fs-macro-def? [(f Code)] (-> bool)
  (and (primitive/code-list? f)
       (and (> (primitive/code-count f) 3)
            (and (fs-head? f `defn)
                 (let [ret (primitive/code-nth f 3)]
                   (and (fs-form? ret 2)
                        (and (fs-head? ret `->)
                             (primitive/code-eq (primitive/code-nth ret 1)
                                                `Code))))))))

; `code-decl` is populated from the checked AST, including dedicated primitive
; nodes. The record is stable across `:as` aliases and refuses lookalike user
; functions: `(decl coil.primitive primitive NAME)`. It is the authoritative answer
; and is tried first.
;
; It does not always answer: `cop-decl` (src/compiler/comptime.coil) builds a record
; for sum-variant constructors and for `coil.primitive`'s `field`/`load`/`store!`, and
; returns `:unresolved` for everything else. This file used to cover the gap with its
; own coil.primitive-only alias scan; that job now belongs to coil.lint.names, which
; every checker shares and which handles `:use`/`:exclude`/`:rename` as well as `:as`.
;;; `prim`/`core` are the two fully-qualified spellings, passed as literals: this
;;; runs on every node, and building them with `code-str` here allocated twice per
;;; node in the metaprogram arena and made a single-file lint tens of times slower.
(defn fs-primitive? [(f Code)
                     (name Code)
                     (prim (slice u8))
                     (core (slice u8))
                     (env Code)] (-> bool)
  (let [d (primitive/code-decl f)]
    (or (and (primitive/code-list? d)
             (and (= (primitive/code-count d) 4)
                  (and (primitive/code-eq (primitive/code-nth d 0) `decl)
                       (and (primitive/code-eq (primitive/code-nth d 1)
                                               `coil.primitive)
                            (and (primitive/code-eq (primitive/code-nth d 2)
                                                    `primitive)
                                 (primitive/code-eq (primitive/code-nth d 3)
                                                    (primitive/code-symbol "coil.primitive."
                                                                           (primitive/code-sym name))))))))
        (let [head (names/ln-head-text f)]
          ; TWO owners, deliberately. The prelude re-exports these primitives as core
          ; names (`(def load primitive/load)` in src/compiler/prelude.coil), so the
          ; bare `load` a module writes without importing anything is
          ; `coil.core/load`, while `primitive/load` is `coil.primitive/load`. Asking
          ; only about coil.primitive answered "no" to every bare spelling and lost
          ; 458 findings across the compiler's own source.
          (or (names/ln-is? head env prim) (names/ln-is? head env core))))))

(defn fs-field? [(f Code) (env Code)] (-> bool)
  (and (fs-form? f 3)
       (fs-primitive? f `field "coil.primitive/field" "coil.core/field" env)))

(defn fs-unquote-symbol? [(f Code)] (-> bool)
  (if (not (primitive/code-sym? f))
      false
      (let [s (primitive/code-sym f)]
        (and (>= (slice-len s) 9)
             (and (= (primitive/cast i64 (slice-get s 0)) 117)
                  (and (= (primitive/cast i64 (slice-get s 1)) 110)
                       (and (= (primitive/cast i64 (slice-get s 2)) 113)
                            (and (= (primitive/cast i64 (slice-get s 3)) 117)
                                 (and (= (primitive/cast i64 (slice-get s 4))
                                         111)
                                      (and (= (primitive/cast i64
                                                              (slice-get s 5))
                                              116)
                                           (and (= (primitive/cast i64
                                                                   (slice-get s
                                                                              6))
                                                   101)
                                                (and (= (primitive/cast i64
                                                                        (slice-get s
                                                                                   7))
                                                        95)
                                                     (= (primitive/cast i64
                                                                        (slice-get s
                                                                                   8))
                                                        95)))))))))))))

(defn fs-static-field? [(f Code) (env Code)] (-> bool)
  (and (fs-field? f env)
       (and (primitive/code-sym? (primitive/code-nth f 2))
            (not (fs-unquote-symbol? (primitive/code-nth f 2))))))

(defn fs-store? [(f Code) (env Code)] (-> bool)
  (and (fs-form? f 3)
       (fs-primitive? f
                      `store!
                      "coil.primitive/store!"
                      "coil.core/store!"
                      env)))

(defn fs-load? [(f Code) (env Code)] (-> bool)
  (and (fs-form? f 2)
       (fs-primitive? f
                      `load
                      "coil.primitive/load"
                      "coil.core/load"
                      env)))

(defn fs-pointer-type? [(f Code)] (-> bool)
  (let [ty (primitive/type-of f)]
    (and (primitive/code-list? ty)
         (and (> (primitive/code-count ty) 0)
              (let [h (primitive/code-nth ty 0)]
                (or (primitive/code-eq h `ptr) (primitive/code-eq h `mut)))))))

(defn fs-accessor-receiver [(f Code) (env Code)] (-> Code)
  ; Low-level pointer-valued chains spell the intermediate read explicitly:
  ; `(field (load (field owner child)) value)`. Dot accessors carry that read
  ; contextually, so the complete modern spelling is `(.value (.child owner))`.
  (if (and (fs-load? f env)
           (fs-static-field? (primitive/code-nth f 1) env))
      (fs-accessor-place (primitive/code-nth f 1) env)
      (fs-accessor-place f env)))

(defn fs-accessor-place [(f Code) (env Code)] (-> Code)
  (if (fs-static-field? f env)
      `(~(primitive/code-symbol "." (primitive/code-nth f 2)) ~(fs-accessor-receiver (primitive/code-nth f
                                                                                                         1)
                                                                                     env))
      f))

(defn fs-safe-value-tree? [(f Code) (i i64)] (-> bool)
  (if (not (primitive/code-list? f))
      true
      (if (or (primitive/code-macro? f) (primitive/code-macro-call? f))
          false
          (if (>= i (primitive/code-count f))
              true
              (and (fs-safe-value-tree? (primitive/code-nth f i) 1)
                   (fs-safe-value-tree? f (+ i 1)))))))

(defn fs-walk [(f Code) (env Code)] (-> Code)
  (if (primitive/code-list? f)
      (if (or (fs-macro-def? f)
              (or (primitive/code-macro? f) (primitive/code-macro-call? f)))
          `0
          (if (and (fs-form? f 3) (fs-core? f env "coil.core/set!"))
              (fs-walk (primitive/code-nth f 2) env)
              (if (and (fs-store? f env)
                       (and (not (fs-core? f env "coil.core/set!"))
                            (fs-safe-value-tree? (primitive/code-nth f 2) 1)))
                  (let [place (primitive/code-nth f 1)
                        value (primitive/code-nth f 2)]
                    (do
                      (primitive/suggest f
                                         "use generalized `set!` instead of the low-level store primitive"
                                         (if (fs-static-field? place env)
                                             `(set! ~(fs-accessor-place place
                                                                        env)
                                                    ~value)
                                             `(set! ~place ~value)))
                      `0))
                  (if (and (fs-load? f env)
                           (and (not (fs-accessor? f))
                                (not (fs-pointer-type? f))))
                      (let [place (primitive/code-nth f 1)]
                        (if (fs-static-field? place env)
                            (do
                              (primitive/suggest f
                                                 "field access reads implicitly; use `.`"
                                                 (fs-accessor-place place
                                                                    env))
                              `0)
                            (if (fs-core? f env "coil.core/load")
                                `0
                                (do
                                  (primitive/suggest f
                                                     "use the ambient `load` spelling outside low-level primitive code"
                                                     `(load ~place))
                                  `0))))
                      (if (and (fs-form? f 2) (fs-head? f `mut))
                          (let [place (primitive/code-nth f 1)]
                            (if (and (fs-static-field? place env)
                                     (not (fs-accessor? place)))
                                (do
                                  (primitive/suggest f
                                                     "use `.` for a field place borrowed with `mut`"
                                                     `(mut ~(fs-accessor-place place
                                                                               env)))
                                  `0)
                                `0))
                          (if (and (fs-field? f env)
                                   (not (or (fs-accessor? f)
                                            (fs-core? f
                                                      env
                                                      "coil.core/field"))))
                              (do
                                (primitive/suggest f
                                                   "use the ambient `field` spelling for an explicit field place"
                                                   `(field ~(primitive/code-nth f
                                                                                1)
                                                           ~(primitive/code-nth f
                                                                                2)))
                                `0)
                              (fs-kids f env 0 (primitive/code-count f))))))))
      `0))

(defn fs-kids [(f Code) (env Code) (i i64) (n i64)] (-> Code)
  (if (>= i n)
      `0
      (do
        (fs-walk (primitive/code-nth f i) env)
        (fs-kids f env (+ i 1) n))))

(defn fs-module-forms [(m Code) (env Code) (i i64) (n i64)] (-> Code)
  (if (>= i n)
      `0
      (do
        (let [form (primitive/code-nth m i)]
          (if (primitive/code-from-user? form) (fs-walk form env) `0))
        (fs-module-forms m env (+ i 1) n))))

(defn fs-module [(m Code) (prelude Code)] (-> Code)
  (let [env (names/ln-env prelude m)]
    (fs-module-forms m env 1 (primitive/code-count m))))

(defn fs-modules [(modules Code) (prelude Code) (i i64) (n i64)] (-> Code)
  (do
    (for item
      (iter (primitive/code-slice modules i n))
      (fs-module item prelude))
    `0))

(defn lint-field-syntax [(modules Code)] (-> Code)
  (fs-modules modules
              (names/ln-prelude modules 0 (primitive/code-count modules))
              0
              (primitive/code-count modules)))

(checker lint-field-syntax)
