(module coil.lint.field-syntax)
(import "coil.primitive" :as primitive)
(import "coil.alloc" :as alloc)
(import "coil.str" :use *)
(import "coil.hashmap" :use *)

; Where to look and what a name resolves to — see names.coil.
(import "coil.lint.names" :as names)

; Migrate low-level memory spelling to the value-oriented `.` field surface and
; generalized two-argument `set!` place assignment. This checker deliberately only
; rewrites a `field` form when its surrounding operation proves whether the author
; wanted its value (`load`) or its place (`store!`/`mut`). A standalone field place
; can be passed to pointer-taking code, so rewriting that to value-oriented `.` would
; silently change its type.
;
; It does not walk the program. The forms it rewrites are calls of coil.primitive's
; `store!`, `load` and `field` — in any spelling — and the `mut` borrows of a field,
; and the compiler answers where each of those was written (names/ln-calls-of).
; A rule fires on the outermost form it applies to: one around another candidate
; already rewrites it, as the walk this replaced stopped at its first rewrite.

(defn fs-form? [(f Code) (n i64)] (-> bool)
  (and (primitive/code-list? f) (not (primitive/code-vector? f)) (= (primitive/code-count f) n)))

(defn fs-head? [(f Code) (head Code)] (-> bool)
  (and (primitive/code-list? f)
       (and (> (primitive/code-count f) 0)
            (primitive/code-eq (primitive/code-nth f 0) head))))

(defn fs-accessor? [(f Code)] (-> bool)
  (and (fs-form? f 2)
       (let [h (primitive/code-nth f 0)]
         (if (not (primitive/code-sym? h))
             false
             (let [name (primitive/code-sym h)]
               (and (> (len name) 1)
                    (and (= (primitive/cast i64 (get name 0)) 46)
                         (not (= (primitive/cast i64 (get name 1)) 46)))))))))

;;; A macro: a `defn` whose return type is Code. Its body builds syntax rather
;;; than computing with fields, and is left alone.
(defn fs-macro-def? [(f Code)] (-> bool)
  (and (primitive/code-list? f)
       (and (> (primitive/code-count f) 3)
            (and (or (fs-head? f `defn) (fs-head? f `defn*))
                 (let [ret (primitive/code-nth f 3)]
                   (and (fs-form? ret 2)
                        (and (fs-head? ret `->)
                             (primitive/code-eq (primitive/code-nth ret 1)
                                                `Code))))))))

(defn fs-field? [(f Code)] (-> bool)
  (and (fs-form? f 3) (names/ln-calls? f "coil.primitive.field")))

;;; A name an unquote splices in when the template is filled: not a field name yet.
(defn fs-unquote-symbol? [(f Code)] (-> bool)
  (and (primitive/code-sym? f) (starts-with (primitive/code-sym f) "unquote__")))

(defn fs-static-field? [(f Code)] (-> bool)
  (and (fs-field? f)
       (and (primitive/code-sym? (primitive/code-nth f 2))
            (not (fs-unquote-symbol? (primitive/code-nth f 2))))))

;;; `(store! P V)`, written with coil.primitive's store! — not the two-argument
;;; `set!` that replaced it, which the parser checks as the same operation.
(defn fs-store? [(f Code)] (-> bool)
  (and (fs-form? f 3)
       (names/ln-calls? f "coil.primitive.store!")
       (not (= (names/ln-head-text f) "set!"))))

(defn fs-load? [(f Code)] (-> bool)
  (and (fs-form? f 2) (names/ln-calls? f "coil.primitive.load")))

(defn fs-pointer-type? [(f Code)] (-> bool)
  (match (primitive/type-of f)
    (primitive/TypeIs [ty]
      (and (primitive/code-list? ty)
           (and (> (primitive/code-count ty) 0)
                (let [h (primitive/code-nth ty 0)]
                  (or (primitive/code-eq h `ptr) (primitive/code-eq h `mut))))))
    (primitive/TypeUnknown [] false)))

(defn fs-accessor-receiver [(f Code)] (-> Code)
  ; Low-level pointer-valued chains spell the intermediate read explicitly:
  ; `(field (load (field owner child)) value)`. Dot accessors carry that read
  ; contextually, so the complete modern spelling is `(.value (.child owner))`.
  (if (and (fs-load? f) (fs-static-field? (primitive/code-nth f 1)))
      (fs-accessor-place (primitive/code-nth f 1))
      (fs-accessor-place f)))

(defn fs-accessor-place [(f Code)] (-> Code)
  (if (fs-static-field? f)
      `(~(primitive/code-symbol "." (primitive/code-nth f 2)) ~(fs-accessor-receiver (primitive/code-nth f 1)))
      f))

;;; Can VALUE move into a `set!` unchanged? Not when it holds a call of a macro
;;; other than a binding form: the macro decides what its operands are.
(defn fs-safe-value-tree? [(f Code)] (-> bool)
  (cond (not (primitive/code-list? f)) true
        (and (names/ln-macro-call? f) (not (names/ln-binder-call? f))) false
        :else
          (block :all
            (for i (range (if (primitive/code-vector? f) 0 1) (primitive/code-count f))
              (unless (fs-safe-value-tree? (primitive/code-nth f i)) (return-from :all false)))
            true)))

;;; The rewrite this rule makes of F, as `(MESSAGE REPLACEMENT)`, or `()`.
(defn fs-rewrite [(f Code)] (-> Code)
  (cond
    (and (fs-store? f) (fs-safe-value-tree? (primitive/code-nth f 2)))
      (let [place (primitive/code-nth f 1)
            value (primitive/code-nth f 2)]
        `(~"use generalized `set!` instead of the low-level store primitive"
          ~(if (fs-static-field? place)
               `(set! ~(fs-accessor-place place) ~value)
               `(set! ~place ~value))))
    (and (fs-load? f) (not (fs-accessor? f)) (not (fs-pointer-type? f)))
      (let [place (primitive/code-nth f 1)]
        (cond (fs-static-field? place)
                `(~"field access reads implicitly; use `.`" ~(fs-accessor-place place))
              ; the core `load` is coil.primitive's under its everyday name
              (= (names/ln-head-text f) "load") `()
              :else `(~"use the ambient `load` spelling outside low-level primitive code"
                      (load ~place))))
    (and (fs-form? f 2) (fs-head? f `mut))
      (let [place (primitive/code-nth f 1)]
        (if (and (fs-static-field? place) (not (fs-accessor? place)))
            `(~"use `.` for a field place borrowed with `mut`" (mut ~(fs-accessor-place place)))
            `()))
    (and (fs-field? f) (not (fs-accessor? f)) (not (= (names/ln-head-text f) "field")))
      `(~"use the ambient `field` spelling for an explicit field place"
        (field ~(primitive/code-nth f 1) ~(primitive/code-nth f 2)))
    :else `()))

;;; Is F's rewrite someone else's: a form around it that this rule rewrites (which
;;; rewrites F with it), the place of a `set!` (which stays a place), or a macro's
;;; body? Its path answers.
(defn fs-covered? [(f Code)] (-> bool)
  (block :found
    (for step (iter (names/ln-path f))
      (let [up (primitive/code-nth step 0)
            index (primitive/code-int (primitive/code-nth step 1))]
        (when (or (fs-macro-def? up)
                  ; every form this rule rewrites has two or three elements
                  (and (<= (primitive/code-count up) 3)
                       (> (primitive/code-count (fs-rewrite up)) 0))
                  (and (fs-form? up 3) (= (names/ln-head-text up) "set!") (= index 1)))
          (return-from :found true))))
    false))

;;; Where F was written: the one place it is, however many questions lead to it.
(defn fs-position [(f Code)] (-> (slice u8))
  (let [(mut sb) (StrBuf::new (alloc/malloc-allocator))]
    (push-str! (mut sb) (primitive/code-file f))
    (push-str! (mut sb) ":")
    (push-i64! (mut sb) (primitive/code-line f))
    (push-str! (mut sb) ":")
    (push-i64! (mut sb) (primitive/code-col f))
    (str sb)))

(defn fs-consider! [(f Code) (seen (mut (HashMap (slice u8) i64)))] (-> i64)
  (let [at (fs-position f)]
    (unless (contains? seen at)
      (set! (mut seen) at 1)
      (let [r (fs-rewrite f)]
        (when (and (= (primitive/code-count r) 2) (not (fs-covered? f)))
          (names/ln-suggest f (primitive/code-str (primitive/code-nth r 0)) (primitive/code-nth r 1))
          0))))
  0)

(defn lint-field-syntax [(modules Code)] (-> Code)
  (let [(mut seen) (HashMap::new [(slice u8) i64] (alloc/malloc-allocator) (keyops))]
    (for f (iter (names/ln-calls-of `coil.primitive.store!)) (fs-consider! f (mut seen)))
    (for f (iter (names/ln-calls-of `coil.primitive.load)) (fs-consider! f (mut seen)))
    (for f (iter (names/ln-calls-of `coil.primitive.field))
      (fs-consider! f (mut seen))
      ; a field borrowed with `mut` is rewritten as the borrow
      (let [up (names/ln-parent f)]
        (when (and (fs-form? up 2) (fs-head? up `mut)) (fs-consider! up (mut seen)) 0)))
    `0))

(checker lint-field-syntax)
