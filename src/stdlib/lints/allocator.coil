(module coil.lint.allocator)
(import "coil.primitive" :as primitive)
(import "coil.lint.names" :as names)

;; High-confidence allocator-composition lint. It uses resolved declarations, so
;; aliases and renamed imports are handled without matching source spellings.
;;; Does `call` resolve to coil.region's function or method `qualified`? A method's
;;; answer names it with its module, `coil.region.allocator`, as a function's does.
(defn al-region-call? [(call Code) (qualified Code)] (-> bool)
  (and (primitive/code-list? call)
       (match (primitive/code-decl call)
         (primitive/Declared [module kind name _]
           (and (match kind
                  (primitive/FunctionDecl [] true)
                  (primitive/MethodDecl [] true)
                  (_ false))
                (and (= module `coil.region) (= name qualified))))
         (_ false))))

;;; At a typechecked allocator argument, a call to Region's `allocator` method.
(defn al-region-allocator-call? [(form Code)] (-> bool)
  (and (= (len form) 2)
       (al-region-call? form `coil.region.allocator)))

(defn al-warn-nested-region [(parent Code)] (-> i64)
  (primitive/warn parent
                  "Region is backed by another Region allocator; use a root allocator for the child or ScratchArena marks for nested scratch lifetimes")
  0)

;;; `(Region::init storage parent)` and `(Region::new parent)`: the parent is the
;;; last argument. Each call is one the compiler resolved to that constructor
;;; (names/ln-calls-of), however it is spelled; nothing else is looked at.
(defn allocator-lint [(modules Code)] (-> Code)
  (for entry (iter `((coil.region.Region::init 3) (coil.region.Region::new 2)))
    (for form (iter (names/ln-calls-of (get entry 0)))
      (when (= (len form) (primitive/code-int (get entry 1)))
        (let [parent (get form (- (len form) 1))]
          (when (al-region-allocator-call? parent) (al-warn-nested-region parent) 0)))))
  `0)

(checker allocator-lint)
