(module coil.lint.result-flow)
(import "coil.primitive" :as primitive)
(import "coil.try" :as result-try)
(import "coil.lint.names" :as names)
(import "coil.meta" :as meta)

; Lint and autofix the mechanically safe Result match pyramid:
;
;   (match EXPR                         (result-try/try
;     (Err [_] FALLBACK)        =>        (let [value (result-try/try-or! EXPR FALLBACK)]
;     (Ok [value] BODY))                    BODY))
;
; The Err binder must be `_`. If the error value participates in FALLBACK, the match
; carries real domain logic and is intentionally left alone. One outer match is fixed
; per pass; `coil lint --fix` then discovers the next nested layer without generating
; overlapping edits.
;
; An aggregate Ok binder is a value, and a value can be rebound mutably as a fresh
; copy. A `let` of an aggregate is an immutable place instead, which cannot be
; rebound mutably, so `(Ok [value] (let [(mut owned) value] …))` needs care:
;
;   * If that rebinding is BODY's first binding and `value` is used nowhere else,
;     bind `(mut owned)` to the `try-or!` directly: the same move, without the
;     intermediate immutable name.
;   * If BODY rebinds `value` mutably anywhere else, there is no suggestion.
;
; An Ok binder of `_` unwraps nothing, and `try-or!` would only bind `_` to the
; value to drop it. Such a match is a question about which variant it is: one
; that answers `true` for Ok and `false` for Err is `(ok? EXPR)` (`err?` the other
; way round) when that name is in scope, and any other is left alone.
(defn rl-form? [(form Code) (head Code) (count i64)] (-> bool)
  (and (primitive/code-list? form)
       (and (= (primitive/code-count form) count)
            (primitive/code-eq (primitive/code-nth form 0) head))))

(defn rl-one-binder? [(clause Code) (variant Code)] (-> bool)
  (and (rl-form? clause variant 3)
       (let [binders (primitive/code-nth clause 1)]
         (and (primitive/code-list? binders)
              (= (primitive/code-count binders) 1)))))

(defn rl-ignored-error? [(clause Code)] (-> bool)
  (and (rl-one-binder? clause `Err)
       (primitive/code-eq (primitive/code-nth (primitive/code-nth clause 1) 0)
                          `_)))

(defn rl-result-match? [(form Code)] (-> bool)
  (if (rl-form? form `match 4)
      (let [a (primitive/code-nth form 2)
            b (primitive/code-nth form 3)]
        (and (or (and (rl-ignored-error? a) (rl-one-binder? b `Ok))
                 (and (rl-one-binder? a `Ok) (rl-ignored-error? b)))
             (let [ok (rl-ok-clause form)
                   value (rl-ok-value ok)
                   body (primitive/code-nth ok 2)]
               (if (primitive/code-eq value `_)
                   (rl-predicate? form)
                   (or (rl-fusable-rebind? body value)
                       (not (rl-mut-rebinds? body value)))))))
      false))

;;; An Ok arm of `_` whose arms answer `true`/`false` (or `false`/`true`).
(defn rl-predicate? [(form Code)] (-> bool)
  (let [body (primitive/code-nth (rl-ok-clause form) 2)
        fallback (primitive/code-nth (rl-err-clause form) 2)]
    (or (and (primitive/code-eq body `true) (primitive/code-eq fallback `false))
        (and (primitive/code-eq body `false) (primitive/code-eq fallback `true)))))

(defn rl-ok-value [(ok Code)] (-> Code)
  (primitive/code-nth (primitive/code-nth ok 1) 0))

;;; Does `sym` occur anywhere in `form`?
(defn rl-mentions? [(form Code) (sym Code)] (-> bool)
  (if (primitive/code-list? form)
      (let [(mut hit) false]
        (for kid (iter form) (when (rl-mentions? kid sym) (set! hit true)))
        hit)
      (primitive/code-eq form sym)))

;;; Does a binding vector anywhere in `form` bind `(mut name)` to exactly `sym`?
(defn rl-mut-rebinds? [(form Code) (sym Code)] (-> bool)
  (if (primitive/code-list? form)
      (or (and (primitive/code-vector? form) (rl-vector-mut-rebinds? form sym 0))
          (let [(mut hit) false]
            (for kid (iter form) (when (rl-mut-rebinds? kid sym) (set! hit true)))
            hit))
      false))

(defn rl-vector-mut-rebinds? [(v Code) (sym Code) (i i64)] (-> bool)
  (if (>= (+ i 1) (primitive/code-count v))
      false
      (or (and (rl-form? (primitive/code-nth v i) `mut 2)
               (primitive/code-eq (primitive/code-nth v (+ i 1)) sym))
          (rl-vector-mut-rebinds? v sym (+ i 2)))))

;;; Is `body` `(let [(mut owned) sym …] …)` with `sym` used nowhere else?
(defn rl-fusable-rebind? [(body Code) (sym Code)] (-> bool)
  (and (primitive/code-list? body)
       (not (primitive/code-vector? body))
       (> (primitive/code-count body) 1)
       (or (= (names/ln-head-text body) "let*")
           (names/ln-calls? body "coil.binding.let"))
       (let [binds (primitive/code-nth body 1)]
         (and (primitive/code-vector? binds)
              (>= (primitive/code-count binds) 2)
              (rl-form? (primitive/code-nth binds 0) `mut 2)
              (primitive/code-eq (primitive/code-nth binds 1) sym)
              (let [(mut used) false]
                (for i (range 2 (primitive/code-count binds))
                  (when (rl-mentions? (primitive/code-nth binds i) sym)
                    (set! used true)))
                (for i (range 2 (primitive/code-count body))
                  (when (rl-mentions? (primitive/code-nth body i) sym)
                    (set! used true)))
                (not used))))))

(defn rl-err-clause [(form Code)] (-> Code)
  (let [a (primitive/code-nth form 2)]
    (if (rl-ignored-error? a) a (primitive/code-nth form 3))))

(defn rl-ok-clause [(form Code)] (-> Code)
  (let [a (primitive/code-nth form 2)]
    (if (rl-one-binder? a `Ok) a (primitive/code-nth form 3))))

;;; The replacement, or `_` when one of the names it inserts would not reach its
;;; definition there (names/ln-spelling-at). All three land in the scope the
;;; match's scrutinee is evaluated in, so that is where they are asked about: the
;;; `match` form itself is a macro call the resolver never sees.
(defn rl-replacement [(form Code)] (-> Code)
  (let [ok (rl-ok-clause form)
        err (rl-err-clause form)
        value (rl-ok-value ok)
        body (primitive/code-nth ok 2)
        scrutinee (primitive/code-nth form 1)
        try-head (names/ln-spelling-at scrutinee `(try coil.try.try) "coil.try.try")
        let-head (names/ln-spelling-at scrutinee `(let coil.binding.let) "coil.binding.let")
        or-head (names/ln-spelling-at scrutinee `(try-or! coil.try.try-or!) "coil.try.try-or!")
        unwrap `(~or-head ~scrutinee
                          ~(primitive/code-nth err 2))]
    (cond (primitive/code-eq value `_)
            (let [ok? (primitive/code-eq body `true)
                  head (if ok?
                           (names/ln-spelling-at scrutinee `(ok?) "coil.result.ok?")
                           (names/ln-spelling-at scrutinee `(err?) "coil.result.err?"))]
              (if (= head `_) `_ `(~head ~scrutinee)))
          (or (= try-head `_) (or (= let-head `_) (= or-head `_))) `_
          (rl-fusable-rebind? body value)
            (let [binds (primitive/code-nth body 1)]
              `(~try-head (~let-head [~(primitive/code-nth binds 0)
                                       ~unwrap
                                     ~@(primitive/code-rest (primitive/code-rest binds))]
                            ~@(primitive/code-rest (primitive/code-rest body)))))
          :else `(~try-head (~let-head [~value ~unwrap] ~body)))))

(defn rl-try-form? [(form Code)] (-> bool)
  (and (primitive/code-list? form)
       (and (> (primitive/code-count form) 0)
            (or (primitive/code-eq (primitive/code-nth form 0) `try)
                ; After expansion, `try` is a labelled control form. Recognize the
                ; expansion as well as its surface spelling so generated fixes never
                ; introduce a second `:try` label inside it.
                (and (> (primitive/code-count form) 1)
                     (primitive/code-eq (primitive/code-nth form 1) `:try))))))

;;; Is FORM inside a `try`, or inside a match this rule rewrites? A fix lands one
;;; layer per pass: the outer match first, and `lint --fix` finds the next layer
;;; in the rewritten program. Its path answers both.
(defn rl-covered? [(form Code)] (-> bool)
  (block :found
    (for up (iter (names/ln-ancestors form))
      (when (or (rl-try-form? up) (rl-result-match? up)) (return-from :found true)))
    false))

;;; Every candidate is a `match` with an `(Err [_] …)` arm: the arms this rule looks
;;; at are the authored patterns of Result's Err (names/ln-calls-of reaches calls;
;;; patterns are references in role `:pattern`), and the match is the form around
;;; each arm.
(defn lint-result-flow [(modules Code)] (-> Code)
  (do
    (for r (iter (names/ln-view (meta/references-to `coil.core.Err)))
      (when (= (meta/reference-role r) `:pattern)
        (match (meta/reference-form r)
          (primitive/Answer [arm]
            (let [form (names/ln-parent arm)]
              (when (and (rl-result-match? form) (not (rl-covered? form)))
                (let [replacement (rl-replacement form)]
                  (unless (= replacement `_)
                    (names/ln-suggest form
                                      (if (primitive/code-eq (rl-ok-value (rl-ok-clause form)) `_)
                                          "Result match only asks which variant it is; use ok? or err?"
                                          "Result match only unwraps Ok and returns a fallback; use try-or!")
                                      replacement)
                    0))
                0)))
          (_ 0))
        0))
    `0))

(checker lint-result-flow)
