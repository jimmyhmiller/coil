(module coil.lint.result-flow)
(import "coil.primitive" :as primitive)
(import "coil.try" :as result-try)

; Lint and autofix the mechanically safe Result match pyramid:
;
;   (match EXPR                         (result-try/try
;     (Err [_] FALLBACK)        =>        (let [value (result-try/try-or! EXPR FALLBACK)]
;     (Ok [value] BODY))                    BODY))
;
; The Err binder must be `_`. If the error value participates in FALLBACK, the match
; carries real domain logic and is intentionally left alone. One outer match is fixed
; per pass; `coil lint --fix` then discovers the next nested layer without generating
; overlapping edits.
(defn rl-form? [(form Code) (head Code) (count i64)] (-> bool)
  (and (primitive/code-list? form)
       (and (= (primitive/code-count form) count)
            (primitive/code-eq (primitive/code-nth form 0) head))))

(defn rl-one-binder? [(clause Code) (variant Code)] (-> bool)
  (and (rl-form? clause variant 3)
       (let [binders (primitive/code-nth clause 1)]
         (and (primitive/code-list? binders) (= (primitive/code-count binders) 1)))))

(defn rl-ignored-error? [(clause Code)] (-> bool)
  (and (rl-one-binder? clause `Err)
       (primitive/code-eq (primitive/code-nth (primitive/code-nth clause 1) 0) `_)))

(defn rl-result-match? [(form Code)] (-> bool)
  (if (and (not (primitive/code-macro? form)) (rl-form? form `match 4))
      (let [a (primitive/code-nth form 2)
            b (primitive/code-nth form 3)]
        (or (and (rl-ignored-error? a) (rl-one-binder? b `Ok))
            (and (rl-one-binder? a `Ok) (rl-ignored-error? b))))
      false))

(defn rl-err-clause [(form Code)] (-> Code)
  (let [a (primitive/code-nth form 2)] (if (rl-ignored-error? a) a (primitive/code-nth form 3))))

(defn rl-ok-clause [(form Code)] (-> Code)
  (let [a (primitive/code-nth form 2)] (if (rl-one-binder? a `Ok) a (primitive/code-nth form 3))))

(defn rl-replacement [(form Code)] (-> Code)
  (let [ok (rl-ok-clause form)
        err (rl-err-clause form)
        value (primitive/code-nth (primitive/code-nth ok 1) 0)]
    `(try (let [~value (try-or! ~(primitive/code-nth form 1) ~(primitive/code-nth err 2))]
            ~(primitive/code-nth ok 2)))))

(defn rl-try-form? [(form Code)] (-> bool)
  (and (primitive/code-list? form)
       (and (> (primitive/code-count form) 0)
            (or (primitive/code-eq (primitive/code-nth form 0) `try)
                ; After expansion, `try` is a labelled control form. Recognize the
                ; expansion as well as its surface spelling so generated fixes never
                ; introduce a second `:try` label inside it.
                (and (> (primitive/code-count form) 1)
                     (primitive/code-eq (primitive/code-nth form 1) `:try))))))

(defn rl-walk [(form Code) (in-try bool)] (-> Code)
  (if (primitive/code-list? form)
      ; Generated macro trees can be enormous and contain implementation matches
      ; that have no authored span worth fixing. More importantly, walking a `try`
      ; expansion after introducing another `try` made each fixpoint round grow
      ; exponentially. Authored forms are still visited through their ordinary
      ; source nodes; generated subtrees stop here.
      (if (or (primitive/code-macro? form) (primitive/code-macro-call? form))
          `0
          (if (and (not in-try) (rl-result-match? form))
              (do
                (primitive/suggest form
                                   "Result match only unwraps Ok and returns a fallback; use try-or!"
                                   (rl-replacement form))
                `0)
              (rl-kids form 0 (primitive/code-count form) (or in-try (rl-try-form? form)))))
      `0))

(defn rl-kids [(form Code) (i i64) (n i64) (in-try bool)] (-> Code)
  (if (>= i n)
      `0
      (do (rl-walk (primitive/code-nth form i) in-try) (rl-kids form (+ i 1) n in-try))))

;;; Does this module contain user source ANYWHERE? See the long note in
;;; `modernize.coil`'s `mz-user-module?`: testing element 1 alone silently
;;; disabled this checker for every module with an `import`, once the loader
;;; began keeping import forms so metaprograms could see them.
(defn rl-user-module? [(module Code) (i i64) (n i64)] (-> bool)
  (if (>= i n)
      false
      (if (primitive/code-from-user? (primitive/code-nth module i))
          true
          (rl-user-module? module (+ i 1) n))))

(defn rl-module [(module Code)] (-> Code)
  (if (and (> (primitive/code-count module) 1)
           (rl-user-module? module 1 (primitive/code-count module)))
      (rl-module-forms module 1 (primitive/code-count module))
      `0))

(defn rl-module-forms [(module Code) (i i64) (n i64)] (-> Code)
  (if (>= i n) `0 (do (rl-walk (primitive/code-nth module i) false) (rl-module-forms module (+ i 1) n))))

(defn rl-modules [(modules Code) (i i64) (n i64)] (-> Code)
  (if (>= i n)
      `0
      (do (rl-module (primitive/code-nth modules i)) (rl-modules modules (+ i 1) n))))

(defn lint-result-flow [(modules Code)] (-> Code)
  (rl-modules modules 0 (primitive/code-count modules)))

(checker lint-result-flow)
