(module coil.lint.string)
(import "coil.primitive" :as primitive)
(import "coil.str" :use [starts-with])

; Annotation-driven migration inventory for `(slice u8)` text APIs.
;
;     ;; string
;     (defn greet [(name (slice u8))] (-> (slice u8)) ...)
;
; This first phase is intentionally report-only. A declaration-level rewrite can
; change every statically resolved caller, so a local suggestion would fail lint's
; post-fix typecheck and roll back. The inventory identifies marked declarations
; and distinguishes declarations with byte mutation, which cannot be migrated as
; text without human review.
(defn sm-doc-marked? [(form Code)] (-> bool)
  (let [doc (primitive/code-doc form)]
    (or (= doc "string") (starts-with doc "string\n"))))

(defn sm-head? [(form Code) (name Code)] (-> bool)
  (and (primitive/code-list? form)
       (and (> (primitive/code-count form) 0)
            (primitive/code-eq (primitive/code-nth form 0) name))))

(defn sm-slice-u8? [(form Code)] (-> bool)
  (and (primitive/code-list? form)
       (and (= (primitive/code-count form) 2)
            (and (primitive/code-eq (primitive/code-nth form 0) `slice)
                 (primitive/code-eq (primitive/code-nth form 1) `u8)))))

(defn sm-count-slice-u8 [(form Code)] (-> i64)
  (if (not (primitive/code-list? form))
      0
      (if (sm-slice-u8? form)
          1
          (sm-count-kids form 0 (primitive/code-count form)))))

(defn sm-count-kids [(form Code) (index i64) (count i64)] (-> i64)
  (if (>= index count)
      0
      (+ (sm-count-slice-u8 (primitive/code-nth form index))
         (sm-count-kids form (+ index 1) count))))

(defn sm-byte-mutation? [(form Code)] (-> bool)
  (if (not (primitive/code-list? form))
      false
      (if (> (primitive/code-count form) 0)
          (let [head (primitive/code-nth form 0)]
            (if (or (primitive/code-eq head `slice-set!)
                    (or (primitive/code-eq head `set!)
                        (or (primitive/code-eq head `mem-copy)
                            (primitive/code-eq head `mem-set))))
                true
                (sm-byte-mutation-kids form 0 (primitive/code-count form))))
          false)))

(defn sm-byte-mutation-kids [(form Code) (index i64) (count i64)] (-> bool)
  (if (>= index count)
      false
      (or (sm-byte-mutation? (primitive/code-nth form index))
          (sm-byte-mutation-kids form (+ index 1) count))))

(defn sm-check-declaration [(form Code)] (-> i64)
  (if (not (sm-doc-marked? form))
      0
      (let [positions (sm-count-slice-u8 form)]
        (cond (= positions 0)
                (do
                  (primitive/warn form
                                  "string migration: marker has no `(slice u8)` positions")
                  0)
              (sm-byte-mutation? form)
                (do
                  (primitive/warn form
                                  "string migration: ambiguous — declaration mutates or copies bytes; review before converting to StringView")
                  0)
              :else
                (do
                  (primitive/warn form
                                  "string migration: propagation required — marked text positions can become StringView after all callers are classified")
                  0)))))

(defn sm-user-module? [(module Code) (index i64) (count i64)] (-> bool)
  (if (>= index count)
      false
      (or (primitive/code-from-user? (primitive/code-nth module index))
          (sm-user-module? module (+ index 1) count))))

(defn sm-module-forms [(module Code) (index i64) (count i64)] (-> i64)
  (if (>= index count)
      0
      (do
        (sm-check-declaration (primitive/code-nth module index))
        (sm-module-forms module (+ index 1) count))))

(defn sm-module [(module Code)] (-> i64)
  (let [count (primitive/code-count module)]
    (if (and (> count 1) (sm-user-module? module 1 count))
        (sm-module-forms module 1 count)
        0)))

(defn sm-modules [(modules Code) (index i64) (count i64)] (-> i64)
  (if (>= index count)
      0
      (do
        (sm-module (primitive/code-nth modules index))
        (sm-modules modules (+ index 1) count))))

(defn lint-string-migration [(modules Code)] (-> Code)
  (do (sm-modules modules 0 (primitive/code-count modules)) `0))

(checker lint-string-migration :phase before-expand)
