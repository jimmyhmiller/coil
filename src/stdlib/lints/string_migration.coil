(module coil.lint.string)
(import "coil.primitive" :as primitive)
(import "coil.str" :use [starts-with])

; Name resolution — one fully-qualified name per rule; see names.coil.
(import "coil.lint.names" :as names)

; Annotation-driven migration inventory for `(slice u8)` text APIs.
;
;     ;; string
;     (defn greet [(name (slice u8))] (-> (slice u8)) ...)
;
; This first phase is intentionally report-only. A declaration-level rewrite can
; change every statically resolved caller, so a local suggestion would fail lint's
; post-fix typecheck and roll back. The inventory identifies marked declarations
; and distinguishes declarations with byte mutation, which cannot be migrated as
; text without human review.
(defn sm-doc-marked? [(form Code)] (-> bool)
  (let [doc (primitive/code-doc form)]
    (or (= doc "string") (starts-with doc "string\n"))))

(defn sm-head? [(form Code) (name Code)] (-> bool)
  (and (primitive/code-list? form)
       (and (> (len form) 0)
            (= (get form 0) name))))

(defn sm-slice-u8? [(form Code)] (-> bool)
  (and (primitive/code-list? form)
       (and (= (len form) 2)
            (and (= (get form 0) `slice)
                 (= (get form 1) `u8)))))

(defn sm-count-slice-u8 [(form Code)] (-> i64)
  (if (not (primitive/code-list? form))
      0
      (if (sm-slice-u8? form)
          1
          (sm-count-kids form 0 (len form)))))

(defn sm-count-kids [(form Code) (index i64) (count i64)] (-> i64)
  (if (>= index count)
      0
      (+ (sm-count-slice-u8 (get form index))
         (sm-count-kids form (+ index 1) count))))

; `set!` is a core name and universal; the other three belong to modules the file
; imports under a name of its own choosing, so they resolve rather than compare. Only
; the bare spellings were listed before, which meant the ordinary `mem/mem-copy` and
; `slice/slice-set!` — the way these are actually written — never matched.
(defn sm-byte-mutation? [(form Code) (env Code)] (-> bool)
  (if (not (primitive/code-list? form))
      false
      (if (> (len form) 0)
          (let [head (names/ln-head-text form)]
            (if (or (= (get form 0) `set!)
                    (names/ln-is? head env "coil.slice/slice-set!")
                    (names/ln-is? head env "coil.mem/mem-copy")
                    (names/ln-is? head env "coil.mem/mem-set"))
                true
                (sm-byte-mutation-kids form env 0 (len form))))
          false)))

(defn sm-byte-mutation-kids [(form Code)
                             (env Code)
                             (index i64)
                             (count i64)] (-> bool)
  (if (>= index count)
      false
      (or (sm-byte-mutation? (get form index) env)
          (sm-byte-mutation-kids form env (+ index 1) count))))

(defn sm-check-declaration [(form Code) (env Code)] (-> i64)
  (if (not (sm-doc-marked? form))
      0
      (let [positions (sm-count-slice-u8 form)]
        (cond (= positions 0)
                (do
                  (primitive/warn form
                                  "string migration: marker has no `(slice u8)` positions")
                  0)
              (sm-byte-mutation? form env)
                (do
                  (primitive/warn form
                                  "string migration: ambiguous — declaration mutates or copies bytes; review before converting to StringView")
                  0)
              :else
                (do
                  (primitive/warn form
                                  "string migration: propagation required — marked text positions can become StringView after all callers are classified")
                  0)))))

(defn sm-user-module? [(module Code) (index i64) (count i64)] (-> bool)
  (if (>= index count)
      false
      (or (primitive/code-from-user? (get module index))
          (sm-user-module? module (+ index 1) count))))

(defn sm-module-forms [(module Code)
                       (env Code)
                       (index i64)
                       (count i64)] (-> i64)
  (do
    (for item
      (iter (primitive/code-slice module index count))
      (sm-check-declaration item env))
    0))

(defn sm-module [(module Code) (prelude Code)] (-> i64)
  (let [count (len module)]
    (if (and (> count 1) (sm-user-module? module 1 count))
        (sm-module-forms module (names/ln-env prelude module) 1 count)
        0)))

(defn sm-modules [(modules Code)
                  (prelude Code)
                  (index i64)
                  (count i64)] (-> i64)
  (do
    (for item
      (iter (primitive/code-slice modules index count))
      (sm-module item prelude))
    0))

(defn lint-string-migration [(modules Code)] (-> Code)
  (do
    (sm-modules modules
                (names/ln-prelude modules 0 (len modules))
                0
                (len modules))
    `0))

(checker lint-string-migration :phase before-expand)
