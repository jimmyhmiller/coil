(module coil.lint.stack-return)
(import "coil.primitive" :as primitive)
(import "coil.alloc" :as alloc)
(import "coil.str" :use *)
(import "coil.hashmap" :use *)

; Name resolution — one fully-qualified name per rule; see names.coil.
(import "coil.lint.names" :as names)
(import "coil.meta" :as meta)

; A bundled `--debug-checks` lint (mem-8): warn when a function returns a POINTER to a
; STACK local — a `primitive/alloc-stack` slot, which dangles the moment the frame is popped.
; clang warns on the identical C by default; Coil was silent. The driver auto-applies
; this checker under --debug-checks (cli-use-add); with the flag off it is never loaded,
; so it costs nothing. It is a WARNING (not a hard error) — it matches clang and never
; breaks a build on a heuristic — and it looks ONLY at user code (`code-from-user?`).
;
; It is a `(checker …)` metaprogram — Coil over Coil, the macro-power thesis — not a
; compiler pass: the syntactic "returns a just-alloc-stack'd local" case needs no
; analysis the checker API doesn't already give.

;;; It does not walk the program. Each stack slot is a call the compiler resolved to
;;; `alloc-stack` or `alloc-stack-bytes` (names/ln-calls-of); the function it can
;;; dangle out of is the `defn` around it (names/ln-ancestors).

;;; head symbol of a list form equals `name`?
(defn sl-head-is? [(e Code) (name Code)] (-> bool)
  (and (primitive/code-list? e)
       (and (> (len e) 0)
            (and (primitive/code-sym? (get e 0)) (= (get e 0) name)))))

;;; the value a body ultimately RETURNS: peel `let`/`do` down to their last (tail) form.
;;; `if` is left as-is (a value from either branch — not the clear syntactic case).
(defn sl-peel-tail [(e Code)] (-> Code)
  (if (or (sl-head-is? e `let) (sl-head-is? e `let*) (sl-head-is? e `do))
      (sl-peel-tail (get e (- (len e) 1)))
      e))

;;; index of the (-> RET) element in a defn form, or -1.
(defn sl-arrow-idx [(f Code)] (-> i64)
  (block :found
    (for i (range 0 (len f))
      (when (sl-head-is? (get f i) `->) (break :found i)))
    -1))

;;; What F, a `defn`, returns when its declared result is a (ptr …) / (mut …) — a
;;; reference the returned value can borrow from the frame — or `()`.
(defn sl-pointer-tail [(f Code)] (-> Code)
  (let [ai (sl-arrow-idx f)]
    (if (and (>= ai 0)
             (>= (len (get f ai)) 2)
             (let [ret (get (get f ai) 1)] (or (sl-head-is? ret `ptr) (sl-head-is? ret `mut))))
        (sl-peel-tail (get f (- (len f) 1)))
        `())))

;;; The `defn` around X, or `()`.
(defn sl-defn-around [(x Code)] (-> Code)
  (block :found
    (for up (iter (names/ln-ancestors x))
      (when (or (sl-head-is? up `defn) (sl-head-is? up `defn*)) (break :found up)))
    `()))

;;; The name a `let` binds to X, when X is a binding's value there, or `()`.
(defn sl-bound-name [(x Code)] (-> Code)
  (let [up (names/ln-enclosing x)]
    (if (and (= (len up) 2)
             (primitive/code-vector? (get up 0))
             (= (% (primitive/code-int (get up 1)) 2) 1)
             (let [outer (names/ln-parent (get up 0))]
               (or (sl-head-is? outer `let) (sl-head-is? outer `let*))))
        (get (get up 0) (- (primitive/code-int (get up 1)) 1))
        `())))

;;; Is the returned TAIL the local NAME binds? The local each one names answers
;;; (meta/source-binding: a `let` binder answers the local it introduces); where
;;; either has none, the spelling does.
(defn sl-same-local? [(tail Code) (name Code)] (-> bool)
  (match (meta/source-binding tail)
    (primitive/BindsLocal [t]
      (match (meta/source-binding name)
        (primitive/BindsLocal [n] (= t n))
        (_ (= tail name))))
    (_ (= tail name))))

(defn sl-warn-dangling [(node Code)] (-> i64)
  (primitive/warn node
                  "returns a pointer to a stack local; it dangles once this function returns (--debug-checks)")
  0)

;;; The stack slot X dangles when its `defn` returns a pointer and that pointer is
;;; X itself, or the local a `let` binds X to.
(defn sl-check-slot! [(x Code) (warned (mut (HashMap (slice u8) i64)))] (-> i64)
  (let [f (sl-defn-around x)]
    (when (> (len f) 0)
      (let [tail (sl-pointer-tail f)
            name (sl-bound-name x)
            dangling (cond (= tail `()) false
                           (primitive/code-eq tail x) true
                           (and (primitive/code-sym? tail) (primitive/code-sym? name))
                             (sl-same-local? tail name)
                           :else false)]
        ; one warning per returned form, however many slots reach it
        (when dangling
          (let [at (sl-position tail)]
            (unless (contains? warned at)
              (set! (mut warned) at 1)
              (sl-warn-dangling tail)
              0))
          0))
      0))
  0)

;;; Where NODE was written, as one key.
(defn sl-position [(node Code)] (-> (slice u8))
  (let [(mut sb) (StrBuf::new (alloc/malloc-allocator))]
    (push-str! (mut sb) (primitive/code-file node))
    (push-str! (mut sb) ":")
    (push-i64! (mut sb) (primitive/code-line node))
    (push-str! (mut sb) ":")
    (push-i64! (mut sb) (primitive/code-col node))
    (str sb)))

(defn sl-check [(modules Code)] (-> Code)
  (let [(mut warned) (HashMap::new [(slice u8) i64] (alloc/malloc-allocator) (keyops))]
    (for qname (iter `(coil.primitive.alloc-stack coil.primitive.alloc-stack-bytes))
      (for x (iter (names/ln-calls-of qname)) (sl-check-slot! x (mut warned))))
    `0))

(checker sl-check)
