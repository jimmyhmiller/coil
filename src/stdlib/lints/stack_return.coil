(module coil.lint.stack-return)
(import "coil.primitive" :as primitive)
(import "coil.alloc" :as alloc)

; Name resolution — one fully-qualified name per rule; see names.coil.
(import "coil.lint.names" :as names)

; A bundled `--debug-checks` lint (mem-8): warn when a function returns a POINTER to a
; STACK local — a `primitive/alloc-stack` slot, which dangles the moment the frame is popped.
; clang warns on the identical C by default; Coil was silent. The driver auto-applies
; this checker under --debug-checks (cli-use-add); with the flag off it is never loaded,
; so it costs nothing. It is a WARNING (not a hard error) — it matches clang and never
; breaks a build on a heuristic — and it looks ONLY at user code (`code-from-user?`).
;
; It is a `(checker …)` metaprogram — Coil over Coil, the macro-power thesis — not a
; compiler pass: the syntactic "returns a just-alloc-stack'd local" case needs no
; analysis the checker API doesn't already give.

;;; the form `(primitive/alloc-stack …)`?
; The typed-allocator change renamed this, and missing the rename is why the whole
; module was once deleted rather than updated -- the test for it (mem-8) and three
; guide references outlived it, so the lint silently stopped existing while the docs
; still promised it. It then spelled the new name FOUR ways by hand, which is the same
; failure one level down: `primitive/` and `coil.primitive/` were listed, a bare
; `alloc-stack` under `:use` and any other `:as` alias were not. `ln-is?` resolves the
; spelling instead of enumerating it.
(defn sl-is-alloc-stack? [(e Code) (env Code)] (-> bool)
  (let [head (names/ln-head-text e)]
    (or (names/ln-is? head env "coil.primitive/alloc-stack")
        (names/ln-is? head env "coil.primitive/alloc-stack-bytes"))))

;;; head symbol of a list form equals `name`?
(defn sl-head-is? [(e Code) (name Code)] (-> bool)
  (and (primitive/code-list? e)
       (and (> (len e) (primitive/cast i64 0))
            (and (primitive/code-sym? (get e 0)) (= (get e 0) name)))))

;;; the value a body ultimately RETURNS: peel `let`/`do` down to their last (tail) form.
;;; `if` is left as-is (a value from either branch — not the clear syntactic case).
(defn sl-peel-tail [(e Code)] (-> Code)
  (if (or (sl-head-is? e `let) (sl-head-is? e `do))
      (sl-peel-tail (get e (primitive/isub (len e) 1)))
      e))

;;; walk a `let` binding vector [k0 v0 k1 v1 …] pairwise: is `sym` bound to (primitive/alloc-stack …)?
(defn sl-binds-loop [(sym Code) (env Code) (binds Code) (i i64) (n i64)] (-> bool)
  (if (>= (primitive/iadd i 1) n)
      false
      (if (and (= (get binds i) sym)
               (sl-is-alloc-stack? (get binds (primitive/iadd i 1)) env))
          true
          (sl-binds-loop sym env binds (primitive/iadd i 2) n))))

;;; does THIS form directly bind `sym` to (alloc/stack …) as a `let`? (kept in a plain
;;; `if` so the closure walk seeds sl-binds-loop — see sl-check-defn's note on and/or.)
(defn sl-let-here? [(sym Code) (env Code) (scope Code)] (-> bool)
  (if (sl-head-is? scope `let)
      (if (> (len scope) (primitive/cast i64 1))
          (sl-binds-loop sym env (get scope 1) 0 (len (get scope 1)))
          false)
      false))

;;; anywhere in `scope`, is `sym` bound to (alloc/stack …) by a `let`? (a syntactic search)
(defn sl-binds-stack? [(sym Code) (env Code) (scope Code)] (-> bool)
  (if (primitive/code-list? scope)
      (if (sl-let-here? sym env scope)
          true
          (sl-scan-kids sym env scope 0 (len scope)))
      false))

(defn sl-scan-kids [(sym Code) (env Code) (scope Code) (i i64) (n i64)] (-> bool)
  (if (>= i n)
      false
      (if (sl-binds-stack? sym env (get scope i))
          true
          (sl-scan-kids sym env scope (primitive/iadd i 1) n))))

;;; index of the (-> RET) element in a defn form, or -1.
(defn sl-arrow-idx [(f Code) (i i64) (n i64)] (-> i64)
  (if (>= i n)
      -1
      (if (sl-head-is? (get f i) `->) i (sl-arrow-idx f (primitive/iadd i 1) n))))

;;; RET is a (ptr …) / (mut …) — a reference the returned value borrows from the frame.
(defn sl-ret-is-ptr? [(ret Code)] (-> bool)
  (or (sl-head-is? ret `ptr) (sl-head-is? ret `mut)))

;;; check one (defn …) form: does it return a stack-local pointer? warn if so.
(defn sl-check-defn [(f Code) (env Code)] (-> i64)
  (let [n (len f)
        ai (sl-arrow-idx f 0 n)]
    (if (< ai (primitive/cast i64 0))
        0
        (let [arrow (get f ai)]
          (if (< (len arrow) (primitive/cast i64 2))
              0
              (if (not (sl-ret-is-ptr? (get arrow 1)))
                  0
                  ; nested `if` (not and/or): the closure walk that builds the metaprogram
                  ; dylib does not follow a user-function call nested inside an expanded
                  ; and/or, so `sl-binds-stack?` must sit in a plain branch to ride along.
                  (let [tail (sl-peel-tail (get f (primitive/isub n 1)))]
                    (if (sl-is-alloc-stack? tail env)
                        (do (sl-warn-dangling tail) 0)
                        (if (primitive/code-sym? tail)
                            (if (sl-binds-stack? tail env f)
                                (do (sl-warn-dangling tail) 0)
                                0)
                            0)))))))))

(defn sl-warn-dangling [(node Code)] (-> i64)
  (primitive/warn node
                  "returns a pointer to a stack local; it dangles once this function returns (--debug-checks)")
  0)

;;; a top-level form: lint only USER `defn`s (skip the bundled stdlib and this module).
(defn sl-check-form [(f Code) (env Code)] (-> i64)
  (if (and (sl-head-is? f `defn) (primitive/code-from-user? f))
      (sl-check-defn f env)
      0))

(defn sl-check-mod-forms [(m Code) (env Code) (i i64) (n i64)] (-> i64)
  (do (for item (iter (primitive/code-slice m i n)) (sl-check-form item env)) 0))

(defn sl-check-mod [(m Code) (prelude Code)] (-> i64)
  (sl-check-mod-forms m (names/ln-env prelude m) 1 (len m)))  ; 0 = module name

(defn sl-check-mods [(ms Code) (prelude Code) (i i64) (n i64)] (-> i64)
  (do
    (for item (iter (primitive/code-slice ms i n)) (sl-check-mod item prelude))
    0))

(defn sl-check [(modules Code)] (-> Code)
  (do
    (sl-check-mods modules
                   (names/ln-prelude modules 0 (len modules))
                   0
                   (len modules))
    `0))

(checker sl-check)
