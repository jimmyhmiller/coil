(module coil.lint.default)

; Coil's standard, mechanically safe lint/fix profile. `coil lint` loads this
; module automatically; keeping the suite as an ordinary bundled module makes
; the policy visible, composable, and independently testable.
(import "coil.lint.modernize" :as modernize)
(import "coil.lint.field-syntax" :as field-syntax)
(import "coil.lint.match-else" :as match-else)
(import "coil.lint.result-flow" :as result-flow)
(import "coil.lint.named-constructor" :as named-constructor)
