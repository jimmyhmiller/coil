(module coil.lint.no-star-imports)
(import "coil.primitive" :as primitive)
(import "coil.lint.names" :as names)
(import "coil.phase" :as phase)

; Opt-in import hygiene:
;   coil lint app.coil --use coil.lint.no-star-imports [--fix|--diff]
; Checkers see the source-spanned import/export declarations in addition to the
; checked forms. Expanding a wildcard to every exported name is conservative: it
; remains correct for macro imports whose original calls are gone after expansion.
(defn si-head? [(f Code) (head Code)] (-> bool)
  (and (primitive/code-list? f)
       (and (> (len f) 0) (= (get f 0) head))))

(defn si-member? [(xs Code) (x Code) (i i64) (n i64)] (-> bool)
  (if (>= i n)
      false
      (if (= (get xs i) x) true (si-member? xs x (+ i 1) n))))

(defn si-add-name [(xs Code) (x Code)] (-> Code)
  (if (or (not (primitive/code-sym? x)) (si-member? xs x 0 (len xs)))
      xs
      `(~@xs ~x)))

(defn si-add-range [(xs Code) (f Code) (i i64) (n i64)] (-> Code)
  (if (>= i n) xs (si-add-range (si-add-name xs (get f i)) f (+ i 1) n)))

(defn si-explicit-exports [(m Code) (i i64) (n i64) (xs Code)] (-> Code)
  (if (>= i n)
      xs
      (let [f (get m i)]
        (si-explicit-exports m
                             (+ i 1)
                             n
                             (if (si-head? f `export)
                                 (si-add-range xs f 1 (len f))
                                 xs)))))

(defn si-has-export? [(m Code) (i i64) (n i64)] (-> bool)
  (if (>= i n)
      false
      (if (si-head? (get m i) `export) true (si-has-export? m (+ i 1) n))))

(defn si-declaration? [(f Code)] (-> bool)
  (or (or (si-head? f `defn) (si-head? f `defn*))
      (or (si-head? f `defmacro)
          (or (si-head? f `defstruct)
              (or (si-head? f `defsum)
                  (or (si-head? f `deftrait)
                      (or (si-head? f `const)
                          (or (si-head? f `extern)
                              (or (si-head? f `def) (si-head? f `defprimitive))))))))))

(defn si-default-exports [(m Code) (i i64) (n i64) (xs Code)] (-> Code)
  (if (>= i n)
      xs
      (let [f (get m i)]
        (si-default-exports m
                            (+ i 1)
                            n
                            (if (and (si-declaration? f) (> (len f) 1))
                                (si-add-name xs (get f 1))
                                xs)))))

(defn si-find-module [(modules Code) (name Code) (i i64) (n i64)] (-> Code)
  (if (>= i n)
      `()
      (let [m (get modules i)]
        (if (and (> (len m) 0) (= (get m 0) name))
            m
            (si-find-module modules name (+ i 1) n)))))

(defn si-form-has? [(f Code) (needle Code) (i i64) (n i64)] (-> bool)
  (if (>= i n)
      false
      (if (= (get f i) needle) true (si-form-has? f needle (+ i 1) n))))

(defn si-merge [(xs Code) (ys Code) (i i64)] (-> Code)
  (if (>= i (len ys))
      xs
      (si-merge (si-add-name xs (get ys i)) ys (+ i 1))))

; An `(export …)` list is the module's whole interface, re-exported names
; included; without one, the module exports its declarations and what it re-exports.
(defn si-module-exports [(modules Code) (name Code) (depth i64)] (-> Code)
  (if (<= depth 0)
      `()
      (let [m (si-find-module modules name 0 (len modules))]
        (cond (= (len m) 0) `()
              (si-has-export? m 1 (len m)) (si-explicit-exports m 1 (len m) `())
              :else (si-reexports modules
                                  m
                                  1
                                  (len m)
                                  depth
                                  (si-default-exports m 1 (len m) `()))))))

;;; The value after KEY among an import's clauses, or `()` when it has none.
(defn si-clause [(f Code) (key Code) (i i64) (n i64)] (-> Code)
  (cond (>= (+ i 1) n) `()
        (= (get f i) key) (get f (+ i 1))
        :else (si-clause f key (+ i 1) n)))

;;; XS without the names in DROP.
(defn si-without [(xs Code) (drop Code) (i i64) (out Code)] (-> Code)
  (if (>= i (len xs))
      out
      (si-without xs
                  drop
                  (+ i 1)
                  (if (si-member? drop (get xs i) 0 (len drop))
                      out
                      (si-add-name out (get xs i))))))

;;; Column K of a `:rename` vector's `[from to]` pairs.
(defn si-rename-column [(pairs Code) (k i64) (i i64) (out Code)] (-> Code)
  (if (>= i (len pairs))
      out
      (let [pair (get pairs i)]
        (si-rename-column pairs
                          k
                          (+ i 1)
                          (if (and (primitive/code-vector? pair) (= (len pair) 2))
                              (si-add-name out (get pair k))
                              out)))))

;;; What the `:reexport` import F publishes: the names its `:use` list gives, or
;;; every export of its target, less `:exclude`, with each `:rename`'s `from`
;;; replaced by its `to`. The compiler's `use-refers` is the same rule.
(defn si-reexported [(modules Code) (f Code) (depth i64)] (-> Code)
  (let [n (len f)
        use-spec (si-clause f `:use 2 n)
        renames (si-clause f `:rename 2 n)
        base (if (primitive/code-vector? use-spec)
                 (si-add-range `() use-spec 0 (len use-spec))
                 (si-module-exports modules
                                    (primitive/code-symbol (get f 1) "")
                                    (- depth 1)))]
    (si-merge (si-without (si-without base (si-clause f `:exclude 2 n) 0 `())
                          (si-rename-column renames 0 0 `())
                          0
                          `())
              (si-rename-column renames 1 0 `())
              0)))

(defn si-reexports [(modules Code)
                    (m Code)
                    (i i64)
                    (n i64)
                    (depth i64)
                    (xs Code)] (-> Code)
  (if (>= i n)
      xs
      (let [f (get m i)]
        (si-reexports modules
                      m
                      (+ i 1)
                      n
                      depth
                      (if (and (si-head? f `import)
                               (and (> (len f) 1)
                                    (si-form-has? f `:reexport 2 (len f))))
                          (si-merge xs (si-reexported modules f depth) 0)
                          xs)))))

(defn si-star-use? [(f Code) (i i64) (n i64)] (-> bool)
  (and (< (+ i 1) n)
       (and (= (get f i) `:use)
            (= (get f (+ i 1)) `*))))

;;; The import's clause list, with a `:use *` replaced by `:use [name ...]`.
;;;
;;; A builder in an index loop, not a recursive splice: splicing a direct recursive call
;;; rebuilds the suffix at every level, and the compiler's own metaprogram lint says so --
;;; it fired on THIS checker, twice, on every run, so anyone who opted in got two warnings
;;; about the linter before any warning about their code.
(defn si-rewrite-tail [(f Code) (i i64) (n i64) (names Code)] (-> Code)
  (let [(mut b) (primitive/code-list-new)
        (mut k) i]
    (loop (if (>= (load k) n)
              (break)
              (if (si-star-use? f (load k) n)
                  (let [chunk `(:use [~@names])]
                    (set! b (primitive/code-list-push! (load b) (get chunk 0)))
                    (set! b (primitive/code-list-push! (load b) (get chunk 1)))
                    (set! k (primitive/iadd (load k) 2))
                    0)
                  (do
                    (set! b
                          (primitive/code-list-push! (load b) (get f (load k))))
                    (set! k (primitive/iadd (load k) 1))
                    0))))
    (primitive/code-list-done (load b))))

(defn si-fix-import [(modules Code) (f Code)] (-> Code)
  (let [names
          (si-module-exports modules (primitive/code-symbol (get f 1) "") 32)]
    `(import ~@(si-rewrite-tail f 1 (len f) names))))

(defn si-check-form [(modules Code) (f Code)] (-> i64)
  (if (and (primitive/code-from-user? f)
           (and (si-head? f `import) (si-form-has? f `* 2 (len f))))
      (do
        (names/ln-suggest f
                           "wildcard import; list the exported names explicitly"
                           (si-fix-import modules f))
        0)
      0))

(defn si-check-module [(modules Code) (m Code) (i i64) (n i64)] (-> i64)
  (do
    (for item (iter (primitive/code-slice m i n)) (si-check-form modules item))
    0))

(defn si-check-modules [(modules Code) (i i64) (n i64)] (-> Code)
  (if (>= i n)
      `0
      (let [m (get modules i)]
        (do
          (si-check-module modules m 1 (len m))
          (si-check-modules modules (+ i 1) n)))))

(defn lint-no-star-imports [(modules Code)] (-> Code)
  (si-check-modules modules 0 (len modules)))

;; `:phase (phase/BeforeExpand)` -- this lints AUTHORED import syntax, so it belongs in the
;; syntax phase, which is also the only phase handed the import declarations.
(checker lint-no-star-imports :phase (phase/BeforeExpand))
