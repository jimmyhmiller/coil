(module coil.lint.import-aliases)
(import "coil.primitive" :as primitive)
(import "coil.meta" :as meta)
(import "coil.slice" :use [subslice])

(defn ia-star? [(form Code)] (-> bool)
  (let [(mut found) false]
    (for i
      (range 2 (- (len form) 1))
      (when (and (= (get form i) `:use) (= (get form (+ i 1)) `*))
        (set! found true)
        0))
    (load found)))

(defn ia-existing-alias [(form Code)] (-> (Option Code))
  (let [(mut alias) (None [Code])]
    (for i
      (range 2 (- (len form) 1))
      (when (= (get form i) `:as) (set! alias (Some (get form (+ i 1)))) 0))
    (load alias)))

(defn ia-leaf [(name (slice u8))] (-> (slice u8))
  (let [(mut start) 0]
    (for i
      (range 0 (len name))
      (when (= (primitive/cast i64 (get name i)) 46) (set! start (+ i 1)) 0))
    (subslice name (load start) (len name))))

(defn ia-alias [(imports Code) (import Code)] (-> Code)
  (let [name (primitive/code-sym (get import 3))
        leaf (ia-leaf name)
        (mut collision) false]
    (match (ia-existing-alias (get import 2))
      (Some [existing] existing)
      (None []
        (do
          (for other
            (iter imports)
            (when (!= (get other 3) (get import 3))
              (when (or (= (ia-leaf (primitive/code-sym (get other 3))) leaf)
                        (match (ia-existing-alias (get other 2))
                          (Some [alias] (= alias (primitive/code-symbol leaf)))
                          (None [] false)))
                (set! collision true)
                0)
              0))
          ; An ambiguous leaf gets its full namespace as a slash qualifier.
          ; The compiler validates conflicts against the actual import environment.
          (primitive/code-symbol (if (load collision) name leaf)))))))

;;; `--lint-param coil.lint.import-aliases.assume-no-shadow=true` also rewrites the
;;; imported names a quasiquote template writes, on the assumption that no template
;;; binds a local with the same spelling. Without it such a template refuses the fix,
;;; because nothing records how a template's bare name binds.
(defn ia-mode [] (-> Code)
  (if (= (primitive/lint-param "coil.lint.import-aliases.assume-no-shadow" "false") "true")
      `assume-no-shadow
      `strict))

;;; Replace wildcard imports with aliases and qualify their authored references.
;;; Binding analysis and coordinated edits belong to coil.meta. This policy only
;;; selects wildcard imports and deterministic aliases; refusals remain advice.
(defn lint-import-aliases [(modules Code)] (-> Code)
  (do
    (match (meta/source-modules)
      (primitive/SourceIs [source]
        (for module
          (iter source)
          (match (meta/imports (get module 0))
            (primitive/SourceIs [imports]
              (for import
                (iter imports)
                (let [form (get import 2)]
                  (when (and (primitive/code-from-user? form) (ia-star? form))
                    (match (meta/qualify-import import (ia-alias imports import) (ia-mode))
                      (primitive/PlanRefused [reason]
                        (do (primitive/warn form (primitive/code-str reason)) 0))
                      (primitive/PlanEdits [edits]
                        (do (meta/suggest-edits edits "use an import alias") 0)))
                    0))))
            (primitive/SourceUnavailable [] 0))))
      (primitive/SourceUnavailable [] 0))
    `0))

(checker lint-import-aliases)
