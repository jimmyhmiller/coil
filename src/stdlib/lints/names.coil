(module coil.lint.names)
(import "coil.primitive" :as primitive)
(import "coil.meta" :as meta)
(import "coil.slice" :use [subslice])

; Eq for (slice u8): resolution compares symbol text.
(import "coil.str" :as str)

;;; How a checker says which function a form calls, and where to look.
;;;
;;; Every rule states the name once, fully qualified, and asks the compiler: the
;;; calls the user wrote of it (`ln-calls-of`, `coil.primitive.load`), or whether
;;; one form calls it (`ln-calls?`). The answer is the checker's own resolution,
;;; filed once in the source index (docs/design/PROGRAM_FACTS.md), so every
;;; spelling — an alias, a `:use`, a `:rename` — answers alike.
;;;
;;; The alternative — what the lints once did — is for each rule to guess the
;;; spellings itself:
;;;
;;;   (or (head? f `trim) (head? f `str/trim) (head? f `coil.str/trim))
;;;
;;; which is a guess about the READER's import line, silently wrong for every alias
;;; the guess missed. When a rule guessed the spellings of coil.arraylist's functions
;;; that way, `coil.arraylist :as al` matched none of them, so ~700 calls in one
;;; project produced no findings and `coil lint --fix` reported success having
;;; changed nothing.
;;;
;;; Code that runs before the program is checked has no resolution to ask: a
;;; `(phase/BeforeExpand)` checker, and a transform such as coil.safety. For it,
;;;
;;;   (ln-is? (ln-head-text f) env "coil.str/trim")
;;;
;;; reconstructs the answer from the module's own import forms, which the loader
;;; keeps in the syntax it sees (`ln-env`). A spelling comparison is correct for
;;; exactly one thing: CORE syntax (`let`, `impl`, `defn`, `set!`, `or`), which no
;;; import changes.
(defn ln-head-sym? [(f Code) (name Code)] (-> bool)
  (and (primitive/code-list? f)
       (not (primitive/code-vector? f))
       (> (primitive/code-count f) 0)
       (primitive/code-eq (primitive/code-nth f 0) name)))

(defn ln-byte? [(s (slice u8)) (i i64) (c i64)] (-> bool)
  (= (primitive/cast i64 (get s i)) c))

; The compiler's own name shape (`find-slash` in src/compiler/resolve.coil,
; `decl-simple-name` in src/compiler/comptime.coil): an optional alias before the
; FIRST `/`, then an optionally dot-qualified module path, then the simple name.
; 47 is `/` and 46 is `.`.
;;; LOOPS, not recursion. These run several times per node of every module being
;;; linted, and a metaprogram call is expensive enough that the recursive spelling
;;; cost roughly one extra call per character scanned — measurably slower on the
;;; compiler's own source than the whole rest of the checker.
(defn ln-first-slash [(s (slice u8)) (i i64) (n i64)] (-> i64)
  (let [(mut k) i
        (mut at) -1]
    (loop (if (>= (load k) n)
              (break)
              (if (ln-byte? s (load k) 47)
                  (do (store! at (load k)) (break))
                  (store! k (primitive/iadd (load k) 1)))))
    (load at)))

(defn ln-last-dot [(s (slice u8)) (i i64)] (-> i64)
  (let [(mut k) i
        (mut at) -1]
    (loop (if (< (load k) 0)
              (break)
              (if (ln-byte? s (load k) 46)
                  (do (store! at (load k)) (break))
                  (store! k (primitive/isub (load k) 1)))))
    (load at)))

(defn ln-alias-part [(s (slice u8))] (-> (slice u8))
  (let [sl (ln-first-slash s 0 (len s))]
    (if (< sl 0) "" (subslice s 0 sl))))

(defn ln-after-alias [(s (slice u8))] (-> (slice u8))
  (let [sl (ln-first-slash s 0 (len s))]
    (if (< sl 0) s (subslice s (+ sl 1) (len s)))))

(defn ln-simple-part [(s (slice u8))] (-> (slice u8))
  (let [r (ln-after-alias s)
        d (ln-last-dot r (- (len r) 1))]
    (if (< d 0) r (subslice r (+ d 1) (len r)))))

(defn ln-module-part [(s (slice u8))] (-> (slice u8))
  (let [r (ln-after-alias s)
        d (ln-last-dot r (- (len r) 1))]
    (if (< d 0) "" (subslice r 0 d))))

; ---- the import environment -------------------------------------------------
; `(import "path" [:as A] [:use * | [names]] [:exclude [names]]
;  [:rename [[from to] …]] [:reexport])` — every clause but `:reexport` takes one
; value, which is what makes a single forward scan enough (loader.coil parses the
; same grammar this way).
(defn ln-import? [(f Code)] (-> bool)
  (and (ln-head-sym? f `import)
       (> (primitive/code-count f) 1)
       (primitive/code-string? (primitive/code-nth f 1))))

;;; An env ENTRY is `(MODULE-SYMBOL IMPORT-FORM)`. The module name is normalized to a
;;; symbol once, when the environment is built, because reading it back out of the
;;; import's STRING node needs `code-str` — the allocating concat — and this is read
;;; for every entry on every query. Doing that per query allocated on the order of
;;; ninety short-lived strings per node of the module being linted and drove a
;;; single-file lint of the compiler to 2.6 GB.
(defn ln-entry-module [(e Code)] (-> (slice u8))
  (primitive/code-sym (primitive/code-nth e 0)))

(defn ln-entry-import [(e Code)] (-> Code)
  (primitive/code-nth e 1))

(defn ln-clause-at [(f Code) (kw Code) (i i64) (n i64)] (-> i64)
  (if (>= i n)
      -1
      (let [it (primitive/code-nth f i)]
        (cond (primitive/code-eq it kw) i
              (primitive/code-eq it `:reexport) (ln-clause-at f kw (+ i 1) n)
              (primitive/code-keyword? it) (ln-clause-at f kw (+ i 2) n)
              :else (ln-clause-at f kw (+ i 1) n)))))

(defn ln-has-clause? [(f Code) (kw Code)] (-> bool)
  (>= (ln-clause-at f kw 2 (primitive/code-count f)) 0))

; The value a keyword clause carries. Only ask after `ln-has-clause?`; `:reexport`
; carries none.
(defn ln-clause [(f Code) (kw Code)] (-> Code)
  (let [n (primitive/code-count f)
        at (ln-clause-at f kw 2 n)]
    (if (or (< at 0) (>= (+ at 1) n)) `[] (primitive/code-nth f (+ at 1)))))

; Every import registers the module's own name as an alias of itself — `mi-add-alias!`
; in loader.coil defaults the alias to the module name — which is why
; `coil.str/trim` resolves in a file that wrote no `:as` at all.
(defn ln-entry-alias [(e Code)] (-> (slice u8))
  (let [f (ln-entry-import e)]
    (if (ln-has-clause? f `:as)
        (primitive/code-sym (ln-clause f `:as))
        (ln-entry-module e))))

(defn ln-vec-has? [(v Code) (i i64) (n i64) (name (slice u8))] (-> bool)
  (let [(mut k) i
        (mut found) false]
    (loop (if (>= (load k) n)
              (break)
              (let [el (primitive/code-nth v (load k))]
                (if (and (primitive/code-sym? el)
                         (= (primitive/code-sym el) name))
                    (do (store! found true) (break))
                    (store! k (primitive/iadd (load k) 1))))))
    (load found)))

; The bare spelling `:rename [[from to] …]` gives `from`, or "" when it renames nothing.
(defn ln-rename-of [(v Code) (i i64) (n i64) (name (slice u8))] (-> (slice u8))
  (if (>= i n)
      ""
      (let [pair (primitive/code-nth v i)]
        (if (and (>= (primitive/code-count pair) 2)
                 (primitive/code-sym? (primitive/code-nth pair 0))
                 (= (primitive/code-sym (primitive/code-nth pair 0)) name))
            (primitive/code-sym (primitive/code-nth pair 1))
            (ln-rename-of v (+ i 1) n name)))))

(defn ln-use-covers? [(f Code) (local (slice u8))] (-> bool)
  (if (not (ln-has-clause? f `:use))
      false
      (let [u (ln-clause f `:use)]
        (if (primitive/code-vector? u)
            (ln-vec-has? u 0 (primitive/code-count u) local)
            (and (primitive/code-sym? u) (= (primitive/code-sym u) "*"))))))

; Does THIS import make `local` readable bare, and under which spelling?
; A `:reexport` with no `:use` counts because the prelude's reexports are
; auto-referred everywhere and such a reexport publishes every name of its module;
; with a `:use`, a reexport publishes what the list covers and nothing more.
; A name reaching this module through someone ELSE's `:reexport` — module X reexports
; coil.arraylist and this file `:use *`s X — is not modelled, so such a spelling goes
; unmatched. That is the safe direction: a rule that reports nothing, never one that
; rewrites a call it misidentified.
(defn ln-import-refers? [(f Code) (spelling (slice u8)) (local (slice u8))] (-> bool)
  (let [renamed
          (if (ln-has-clause? f `:rename)
              (let [v (ln-clause f `:rename)]
                (ln-rename-of v 0 (primitive/code-count v) local))
              "")
        excluded
          (and (ln-has-clause? f `:exclude)
               (let [v (ln-clause f `:exclude)]
                 (ln-vec-has? v 0 (primitive/code-count v) local)))]
    (and (= spelling (if (> (len renamed) 0) renamed local))
         (not excluded)
         (if (ln-has-clause? f `:use)
             (ln-use-covers? f local)
             (ln-has-clause? f `:reexport)))))

(defn ln-env-alias? [(env Code) (i i64) (alias (slice u8)) (m (slice u8))] (-> bool)
  (or (= alias m) (ln-entries-alias? (ln-env-entries env) i alias m)))

(defn ln-entries-alias? [(entries Code) (i i64) (alias (slice u8)) (m (slice u8))] (-> bool)
  (if (>= i (primitive/code-count entries))
      false
      (let [e (primitive/code-nth entries i)]
        (if (and (= (ln-entry-module e) m) (= (ln-entry-alias e) alias))
            true
            (ln-entries-alias? entries (+ i 1) alias m)))))

; Core is auto-referred into every module with no import form to read, so its names
; are ambient by definition; every other module has to say `:use`.
(defn ln-env-refers? [(env Code)
                      (i i64)
                      (spelling (slice u8))
                      (m (slice u8))
                      (local (slice u8))] (-> bool)
  (if (= m "coil.core")
      (= spelling local)
      (ln-entries-refer? (ln-env-entries env) i spelling m local)))

(defn ln-entries-refer? [(entries Code)
                         (i i64)
                         (spelling (slice u8))
                         (m (slice u8))
                         (local (slice u8))] (-> bool)
  (if (>= i (primitive/code-count entries))
      false
      (let [e (primitive/code-nth entries i)]
        (if (and (= (ln-entry-module e) m)
                 (ln-import-refers? (ln-entry-import e) spelling local))
            true
            (ln-entries-refer? entries (+ i 1) spelling m local)))))

; ---- the one thing a rule calls ---------------------------------------------
;;; The text of the symbol a form is called through, or "" for a form that is not
;;; such a call. Taken once per node and handed to the rules.
;;; `code-sym` and NOT `code-str`: code-sym hands back the symbol's existing slice
;;; (`CStr (sx-sval code)` in comptime.coil), while code-str is the variadic CONCAT
;;; and allocates a fresh copy in the metaprogram arena every call. This runs on every
;;; node of every module; taking the allocating one made a single-file lint tens of
;;; times slower.
(defn ln-head-text [(f Code)] (-> (slice u8))
  (if (and (primitive/code-list? f)
           (not (primitive/code-vector? f))
           (> (primitive/code-count f) 0)
           (primitive/code-sym? (primitive/code-nth f 0)))
      (primitive/code-sym (primitive/code-nth f 0))
      ""))

;;; Does the spelling `s` name `qname` here? `qname` is the rule's whole answer: one
;;; fully-qualified name, written as a literal so it costs nothing to compare
;;; against.
(defn ln-resolves? [(s (slice u8)) (env Code) (qname (slice u8))] (-> bool)
  ; Rules ask this of every call head, against dozens of names each, and nearly
  ; every answer is no. Rejecting on the spelling's last bytes first keeps that no
  ; from splitting the rule's name and walking the import environment: those were
  ; most of the time `coil lint` spent in its rules.
  (if (and (not (ln-ends-in-local? s qname)) (not (ln-env-renames? env)))
      false
      (let [m (ln-alias-part qname)
            local (ln-after-alias qname)]
        (if (= (len m) 0)
            (ln-unqualified-rule-name!)
            (let [alias (ln-alias-part s)
                  simple (ln-simple-part s)
                  modpart (ln-module-part s)]
              (cond (> (len alias) 0)
                      (and (= simple local) (ln-env-alias? env 0 alias m))
                    (> (len modpart) 0) (and (= simple local) (= modpart m))
                    :else (ln-env-refers? env 0 simple m local)))))))

;;; The point of this API is that a rule cannot quietly match nothing, so a rule name
;;; written without its module is a hard error, not a silent miss.
(defn ln-unqualified-rule-name! [] (-> bool)
  (primitive/error "modernize: name a rule's module — \"coil.str/trim\", not \"trim\""))

;;; Can `ln-resolves?` accept spelling S for rule name QNAME? Every way it accepts
;;; one requires S to end in QNAME's own part (what follows its FIRST `/`) — S is
;;; that part, or has it right after an alias's `/` or a module path's `.` — except
;;; a bare spelling an import's `:rename` binds, which `ln-env-renames?` covers.
;;; Compared from the end, so a spelling that cannot match costs a byte or two, not
;;; a scan of QNAME. A QNAME with no `/` reaching the comparison is the unqualified
;;; rule name `ln-resolves?` refuses: every spelling ending in it would have matched.
(defn ln-ends-in-local? [(s (slice u8)) (qname (slice u8))] (-> bool)
  (let [(mut i) (- (len s) 1)
        (mut j) (- (len qname) 1)
        (mut out) false]
    (loop (cond (< (load j) 0)
                  (do (store! out (ln-unqualified-rule-name!)) (break))
                (and (ln-byte? qname (load j) 47) (< (ln-first-slash qname 0 (load j)) 0))
                  (do (store! out (or (< (load i) 0)
                                      (ln-byte? s (load i) 47)
                                      (ln-byte? s (load i) 46)))
                      (break))
                (or (< (load i) 0) (!= (get s (load i)) (get qname (load j))))
                  (break)
                :else
                  (do (store! i (- (load i) 1))
                      (store! j (- (load j) 1)))))
    (load out)))

(defn ln-is? [(head (slice u8)) (env Code) (qname (slice u8))] (-> bool)
  (and (> (len head) 0) (ln-resolves? head env qname)))

;;; ---- building the environment ----------------------------------------------
;;; The import forms one module resolves names in: its own, plus the prelude's. The
;;; prelude's `(import "coil.primitive" :as primitive)` is why every module can write
;;; `primitive/…` having imported nothing.
(defn ln-collect-imports! [(m Code) (out CodeBuilder)] (-> i64)
  (let [(mut k) 0
        n (primitive/code-count m)]
    (loop (if (>= (load k) n)
              (break)
              (do
                (when (ln-import? (primitive/code-nth m (load k)))
                  (let [f (primitive/code-nth m (load k))
                        modsym (primitive/code-symbol (primitive/code-nth f 1))]
                    (primitive/code-list-push! out `(~modsym ~f)))
                  0)
                (store! k (primitive/iadd (load k) 1)))))
    0))

;;; Element 0 of a module Code is the module's NAME SYMBOL — not a `(module …)`
;;; form. Reading it as a form returned "" for every module, so `ln-prelude` never
;;; found coil.core, the prelude's `(import "coil.primitive" :as primitive)` never
;;; reached any environment, and every rule naming a coil.primitive function stopped
;;; matching in the modules that rely on that ambient alias instead of importing it
;;; themselves — 458 findings silently lost across the compiler's own source.
(defn ln-module-name [(m Code)] (-> (slice u8))
  (if (and (> (primitive/code-count m) 0)
           (primitive/code-sym? (primitive/code-nth m 0)))
      (primitive/code-sym (primitive/code-nth m 0))
      ""))

;;; The prelude is the module `coil.core` (loader.coil's `implicit-prelude-name`).
;;; `COIL_PRELUDE` can name a replacement, which a checker has no way to ask about;
;;; not finding it costs the aliases that prelude would have made ambient, so such a
;;; program under-matches rather than mis-matching.
(defn ln-prelude [(modules Code) (i i64) (n i64)] (-> Code)
  (if (>= i n)
      (primitive/code-list-done (primitive/code-list-new))
      (if (= (ln-module-name (primitive/code-nth modules i)) "coil.core")
          (primitive/code-nth modules i)
          (ln-prelude modules (+ i 1) n))))

;;; Build once per module and thread it through the walk.
;;; The environment is `(ENTRIES RENAMES)`: the entries, and `:renames` when any of
;;; their imports has a `:rename` clause (`:plain` otherwise), which is the one way a
;;; bare spelling can name something whose own name it does not end in.
(defn ln-env [(prelude Code) (m Code)] (-> Code)
  (let [out (primitive/code-list-new)]
    (ln-collect-imports! prelude out)
    (ln-collect-imports! m out)
    (let [entries (primitive/code-list-done out)]
      (if (ln-entries-rename? entries 0) `(~entries :renames) `(~entries)))))

(defn ln-env-entries [(env Code)] (-> Code)
  (primitive/code-nth env 0))

;;; Whether an import of this module `:rename`s something, read off the env's length:
;;; asked on nearly every rejected spelling, so it is one count, not a comparison.
(defn ln-env-renames? [(env Code)] (-> bool)
  (> (primitive/code-count env) 1))

(defn ln-entries-rename? [(entries Code) (i i64)] (-> bool)
  (and (< i (primitive/code-count entries))
       (or (ln-has-clause? (ln-entry-import (primitive/code-nth entries i)) `:rename)
           (ln-entries-rename? entries (+ i 1)))))

;;; ---- where a rule looks ----------------------------------------------------
;;; A rule does not walk the program. It asks the compiler where to look — the
;;; calls of the names it rewrites (`ln-calls-of`), a module's forms headed by the
;;; core syntax it rewrites (`meta/forms-headed`) — and around each place it finds
;;; (`ln-enclosing`, `ln-path`). Every answer is a fact the compiler filed once, under the key
;;; it is asked by (docs/design/PROGRAM_FACTS.md), and every node is the author's
;;; own: `type-of`, `resolve-at` and `binding-of` answer for it.

(defn ln-view [(view primitive/SourceView)] (-> Code)
  (match view
    (primitive/SourceIs [records] records)
    (primitive/SourceUnavailable [] `())))

(defn ln-answer [(answer primitive/ProgramAnswer)] (-> Code)
  (match answer
    (primitive/Answer [value] value)
    (_ `())))

;;; The user's own modules, as symbols.
(defn ln-user-modules [] (-> Code)
  (let [out (primitive/code-list-new)]
    (for record (iter (ln-view (meta/source-modules)))
      (when (meta/user-module? record) (primitive/code-list-push! out (primitive/code-nth record 0)) 0))
    (primitive/code-list-done out)))

;;; Every call of QNAME (a qualified symbol, `coil.primitive.load`) the user wrote:
;;; each form headed by a reference that resolves to it, however it is spelled.
(defn ln-calls-of [(qname Code)] (-> Code)
  (let [out (primitive/code-list-new)]
    (for r (iter (ln-view (meta/references-to qname)))
      (let [role (meta/reference-role r)]
        (when (or (= role `:call) (= role `:primitive) (= role `:macro))
          (match (meta/reference-form r)
            (primitive/Answer [f] (do (primitive/code-list-push! out f) 0))
            (_ 0))
          0)))
    (primitive/code-list-done out)))

;;; Does the authored form F call QNAME ("coil.primitive.field")? Its head is a
;;; reference the compiler resolved there.
(defn ln-calls? [(f Code) (qname (slice u8))] (-> bool)
  (and (primitive/code-list? f)
       (not (primitive/code-vector? f))
       (> (primitive/code-count f) 0)
       (primitive/code-sym? (primitive/code-nth f 0))
       (match (meta/source-binding (primitive/code-nth f 0))
         (primitive/BindsGlobal [q] (= (primitive/code-sym q) qname))
         (_ false))))

;;; Does F call a macro? Its head resolves to a declaration of kind Macro.
(defn ln-macro-call? [(f Code)] (-> bool)
  (and (primitive/code-list? f)
       (not (primitive/code-vector? f))
       (> (primitive/code-count f) 0)
       (primitive/code-sym? (primitive/code-nth f 0))
       (match (meta/source-binding (primitive/code-nth f 0))
         (primitive/BindsGlobal [q]
           (match (meta/definition-kind q)
             (primitive/KindIs [k] (match k (primitive/Macro [] true) (_ false)))
             (_ false)))
         (_ false))))

;;; Does F bind names around authored code: `let`, `fn`, `defn`, or their core
;;; forms? Such a macro's body is the author's code.
(defn ln-binder-call? [(f Code)] (-> bool)
  (let [head (ln-head-text f)]
    (or (= head "let*") (= head "fn*") (= head "defn*")
        (ln-calls? f "coil.binding.let") (ln-calls? f "coil.binding.fn")
        (ln-calls? f "coil.binding.defn"))))

;;; `(FORM INDEX)`: the authored form directly containing NODE, and NODE's index in
;;; it; `()` for a top-level form.
(defn ln-enclosing [(node Code)] (-> Code)
  (ln-answer (meta/enclosing node)))

;;; The form directly containing NODE, or `()`.
(defn ln-parent [(node Code)] (-> Code)
  (let [e (ln-enclosing node)]
    (if (= (primitive/code-count e) 2) (primitive/code-nth e 0) `())))

;;; The forms around NODE, innermost first, up to its top-level form, each as
;;; `(FORM INDEX)` with the index of the step toward NODE: its path, which costs
;;; its depth.
(defn ln-path [(node Code)] (-> Code)
  (let [steps (ln-answer (meta/path node))
        out (primitive/code-list-new)]
    (for i (range 0 (primitive/code-count steps))
      (primitive/code-list-push! out (primitive/code-nth steps (- (- (primitive/code-count steps) 1) i))))
    (primitive/code-list-done out)))

;;; The forms around NODE, innermost first.
(defn ln-ancestors [(node Code)] (-> Code)
  (let [out (primitive/code-list-new)]
    (for step (iter (ln-path node)) (primitive/code-list-push! out (primitive/code-nth step 0)))
    (primitive/code-list-done out)))

;;; Is the operation F context-typed: a numeric literal, or a binary arithmetic or
;;; bitwise primitive on context-typed operands? Its type is the one its context
;;; gives it, which `type-of` answers.
(defn ln-literal-typed? [(f Code)] (-> bool)
  (or (primitive/code-int? f)
      (primitive/code-float? f)
      (and (primitive/code-list? f)
           (not (primitive/code-vector? f))
           (= (primitive/code-count f) 3)
           (ln-primitive-binop-call? f)
           (ln-literal-typed? (primitive/code-nth f 1))
           (ln-literal-typed? (primitive/code-nth f 2)))))

;;; Does F call a binary arithmetic or bitwise primitive, one whose result has its
;;; operands' type?
(defn ln-primitive-binop-call? [(f Code)] (-> bool)
  (match (if (and (> (primitive/code-count f) 0) (primitive/code-sym? (primitive/code-nth f 0)))
             (meta/source-binding (primitive/code-nth f 0))
             (primitive/BindingUnknown))
    (primitive/BindsGlobal [q]
      (let [n (primitive/code-sym q)]
        (or (= n "coil.primitive.iadd") (= n "coil.primitive.isub") (= n "coil.primitive.imul")
            (= n "coil.primitive.idiv") (= n "coil.primitive.irem") (= n "coil.primitive.udiv")
            (= n "coil.primitive.urem") (= n "coil.primitive.iand") (= n "coil.primitive.ior")
            (= n "coil.primitive.ixor") (= n "coil.primitive.ishl") (= n "coil.primitive.ishr")
            (= n "coil.primitive.rotl") (= n "coil.primitive.rotr") (= n "coil.primitive.mulhi")
            (= n "coil.primitive.fadd") (= n "coil.primitive.fsub") (= n "coil.primitive.fmul")
            (= n "coil.primitive.fdiv") (= n "coil.primitive.frem"))))
    (_ false)))

;;; ---- inserting a name ------------------------------------------------------
;;; Recognizing the call is half of a rewrite. The name the rewrite INSERTS has to
;;; mean, where it lands, what the rule means by it. A local binding shadows it:
;;; inside `(let [len (code-count body)] …)`, `(code-count xs)` cannot become
;;; `(len xs)`. So does the module's own definition of the name, and that one
;;; compiles and calls the wrong function. `primitive/resolve-at` is the compiler's
;;; answer: the declaration a call headed by a spelling reaches at a node, or that a
;;; local does.
;;;
;;; A rule lists the spellings that can say its target, plainest first, and inserts
;;; the first that reaches it. When none does it has no correct rewrite there and
;;; offers none. Core syntax (`load`, `field`, two-argument `set!`, `cast`,
;;; `zeroed`, `call-ptr`) is recognized by the parser, which no local can shadow,
;;; and needs no check.

;;; Does SPELLING, written as a call head at NODE, reach the declaration QNAME
;;; ("coil.core.len", as `resolve-at` and `code-decl` spell it)?
(defn ln-reaches? [(node Code) (spelling Code) (qname (slice u8))] (-> bool)
  (match (primitive/resolve-at node spelling)
    (primitive/ResolvesTo [r] (= (primitive/code-sym r) qname))
    (_ false)))

;;; The first of SPELLINGS that reaches QNAME as a call head at NODE, or `_` when
;;; none does.
(defn ln-spelling-at [(node Code) (spellings Code) (qname (slice u8))] (-> Code)
  (block :found
    (for s spellings
      (when (ln-reaches? node s qname) (break :found s)))
    `_))

;;; `primitive/suggest` as a transaction of its own, for a checker whose suggestions
;;; do not depend on each other: `lint --fix` then drops one that does not compile,
;;; or that would drop a comment, without the rest (`primitive/suggest-transaction`).
(defn ln-suggest [(node Code) (msg (slice u8)) (replacement Code)] (-> i64)
  (primitive/suggest-transaction)
  (primitive/suggest node msg replacement)
  0)

;;; ---- quasiquote templates --------------------------------------------------
;;; A template's text is data. Its symbols mean whatever the metaprogram that fills
;;; it makes them mean: they can be renamed, spliced somewhere else, or bound by a
;;; scope the template only completes. No rule can say what a call written there
;;; will reach, and a rewrite can turn a working generator into one that emits
;;; broken code. thecount's `define-specialized-counters` renames every `len` it
;;; emits to one fresh local, so `(slice-len bytes)` → `(len bytes)` in its template
;;; became a call to that local.
;;;
;;; The code under `~` and `~@` is different: it runs when the template is filled,
;;; as ordinary code of the metaprogram, and is linted like any other. The source
;;; index files the references and forms of the holes and none of the text, so a
;;; rule that starts from them never lands in a template. A walk — a transform's —
;;; has to recognize one itself.

(defn ln-quasiquote? [(f Code)] (-> bool)
  (and (= (ln-head-text f) "quasiquote") (= (primitive/code-count f) 2)))
