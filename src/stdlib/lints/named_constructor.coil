(module coil.lint.named-constructor)
(import "coil.primitive" :as primitive)
(import "coil.alloc" :as alloc)

; Name resolution — one fully-qualified name per rule; see names.coil.
(import "coil.lint.names" :as names)

; Require positional aggregate constructors with at least three payload fields to
; use the named form. Struct construction is already named-only in the language;
; this checker catches the remaining positional surface: sum variants. It also
; collapses complete, declaration-ordered initialization of a zeroed struct local
; into the named constructor that expresses the same value directly.
(defn nc-head-is? [(form Code) (head Code)] (-> bool)
  (and (primitive/code-list? form)
       (and (> (primitive/code-count form) 0)
            (primitive/code-eq (primitive/code-nth form 0) head))))

; `zeroed`/`store!`/`field`/`load` are core aliases of the primitives, so the BARE
; spelling is universal and compares directly. The qualified spelling belongs to
; coil.primitive and therefore resolves: listing `primitive/…` by hand was right only
; for a file that happens to use the prelude's alias for it.
(defn nc-primitive? [(form Code) (env Code) (arity i64) (qname (slice u8))] (-> bool)
  (and (primitive/code-list? form)
       (= (primitive/code-count form) arity)
       (names/ln-is? (names/ln-head-text form) env qname)))

(defn nc-zeroed? [(form Code) (env Code)] (-> bool)
  (or (and (primitive/code-list? form)
           (= (primitive/code-count form) 2)
           (nc-head-is? form `zeroed))
      (nc-primitive? form env 2 "coil.primitive/zeroed")))

(defn nc-store? [(form Code) (env Code)] (-> bool)
  (or (and (primitive/code-list? form)
           (= (primitive/code-count form) 3)
           (nc-head-is? form `store!))
      (nc-primitive? form env 3 "coil.primitive/store!")))

(defn nc-field? [(form Code) (env Code)] (-> bool)
  (or (and (primitive/code-list? form)
           (= (primitive/code-count form) 3)
           (nc-head-is? form `field))
      (nc-primitive? form env 3 "coil.primitive/field")))

(defn nc-load? [(form Code) (env Code)] (-> bool)
  (or (and (primitive/code-list? form)
           (= (primitive/code-count form) 2)
           (nc-head-is? form `load))
      (nc-primitive? form env 2 "coil.primitive/load")))

(defn nc-mut-name [(form Code)] (-> Code)
  (if (and (primitive/code-list? form)
           (and (= (primitive/code-count form) 2) (nc-head-is? form `mut)))
      (primitive/code-nth form 1)
      `:unknown))

(defn nc-place-name [(form Code)] (-> Code)
  (if (primitive/code-sym? form) form (nc-mut-name form)))

; Was a bare/alias/qualified triple per call site — the same guess about the reader's
; import line that this file's siblings made. One qualified name now, resolved.
(defn nc-alloc-head? [(form Code) (env Code) (qname (slice u8))] (-> bool)
  (names/ln-is? (names/ln-head-text form) env qname))

(defn nc-one-type-arg? [(args Code)] (-> bool)
  (and (primitive/code-vector? args) (= (primitive/code-count args) 1)))

; The replacement must be spelled the way THIS file can resolve it, so mirror the
; qualifier the call being replaced already used: a bare `unwrap-ptr` means coil.alloc
; is referred bare here, an `A/unwrap-ptr` means `A/box!` names the same module.
(defn nc-box-head [(unwrap-call Code)] (-> Code)
  (let [head (primitive/code-nth unwrap-call 0)
        alias (names/ln-alias-part (primitive/code-str head))]
    (if (= (len alias) 0)
        `box!
        (primitive/code-symbol alias "/box!"))))

(defn nc-same-binding? [(ref Code) (bid i64)] (-> bool)
  (and (primitive/code-sym? ref) (= (primitive/binding-of ref) bid)))

(defn nc-mentions-binding? [(form Code) (bid i64)] (-> bool)
  (if (primitive/code-sym? form)
      (= (primitive/binding-of form) bid)
      (if (primitive/code-list? form)
          (nc-kid-mentions-binding? form bid 0 (primitive/code-count form))
          false)))

(defn nc-kid-mentions-binding? [(form Code) (bid i64) (i i64) (n i64)] (-> bool)
  (if (>= i n)
      false
      (if (nc-mentions-binding? (primitive/code-nth form i) bid)
          true
          (nc-kid-mentions-binding? form bid (+ i 1) n))))

(defn nc-manual-box-check [(form Code) (env Code)] (-> bool)
  (if (and (not (primitive/code-macro? form))
           (and (or (nc-head-is? form `let) (nc-head-is? form `let*))
                (= (primitive/code-count form) 4)))
      (let [binds (primitive/code-nth form 1)]
        (if (and (primitive/code-vector? binds)
                 (= (primitive/code-count binds) 2))
            (let [name (primitive/code-nth binds 0)
                  init (primitive/code-nth binds 1)
                  store (primitive/code-nth form 2)
                  final (primitive/code-nth form 3)]
              (if (and (primitive/code-sym? name)
                       (and (nc-alloc-head? init env "coil.alloc/unwrap-ptr")
                            (and (= (primitive/code-count init) 3)
                                 (nc-one-type-arg? (primitive/code-nth init 1)))))
                  (let [create-call (primitive/code-nth init 2)]
                    (if (and (nc-alloc-head? create-call
                                             env
                                             "coil.alloc/create")
                             (and (= (primitive/code-count create-call) 3)
                                  (nc-one-type-arg? (primitive/code-nth create-call
                                                                        1))))
                        (let [T
                                (primitive/code-nth (primitive/code-nth init 1)
                                                    0)
                              create-T
                                (primitive/code-nth (primitive/code-nth create-call
                                                                        1)
                                                    0)
                              final-name (nc-place-name final)
                              bid
                                (primitive/binding-of (nc-place-name (primitive/code-nth store
                                                                                         1)))]
                          (if (and (> bid 0)
                                   (and (primitive/code-eq T create-T)
                                        (and (nc-store? store env)
                                             (and (nc-same-binding? (nc-place-name (primitive/code-nth store
                                                                                                       1))
                                                                    bid)
                                                  (not (nc-mentions-binding? (primitive/code-nth store
                                                                                                 2)
                                                                             bid))))))
                              (do
                                (primitive/suggest form
                                                   "manual-box: replace create + unwrap-ptr + store! with box!"
                                                   (let [replacement
                                                           `(~(nc-box-head init) ~(primitive/code-nth create-call
                                                                                                      2)
                                                               ~T
                                                               ~(primitive/code-nth store
                                                                                    2))]
                                                     (if (nc-same-binding? final-name
                                                                           bid)
                                                         replacement
                                                         `(let [~name
                                                                  ~replacement]
                                                            ~final))))
                                true)
                              false))
                        false))
                  false))
            false))
      false))

(defn nc-struct-decl? [(type-node Code)] (-> bool)
  (let [d (primitive/code-decl type-node)]
    (and (primitive/code-list? d)
         (and (>= (primitive/code-count d) 3)
              (primitive/code-eq (primitive/code-nth d 2) `struct)))))

; Field reflection resolves names in the checker's module, not in the source module
; that owns `type-node`. Rebuild the explicit type operand with the authoritative
; qualified name from code-decl, preserving any generic arguments.
(defn nc-reflect-struct-type [(type-node Code)] (-> Code)
  (let [d (primitive/code-decl type-node)
        qname (primitive/code-nth d 3)]
    (if (primitive/code-sym? type-node)
        qname
        (let [out (primitive/code-list-new)
              n (primitive/code-count type-node)
              (mut i) 1]
          (primitive/code-list-push! out qname)
          (loop (if (>= (load i) n)
                    (break)
                    (do
                      (primitive/code-list-push! out
                                                 (primitive/code-nth type-node
                                                                     (load i)))
                      (store! i (+ (load i) 1)))))
          (primitive/code-list-done out)))))

(defn nc-complete-store? [(store Code)
                          (env Code)
                          (T Code)
                          (fi i64)
                          (bid i64)] (-> bool)
  (if (nc-store? store env)
      (let [target (primitive/code-nth store 1)]
        (if (nc-field? target env)
            (let [base (nc-place-name (primitive/code-nth target 1))
                  field-name (primitive/code-nth target 2)
                  value (primitive/code-nth store 2)]
              (and (nc-same-binding? base bid)
                   (and (primitive/code-eq field-name
                                           (primitive/code-field-name T fi))
                        (not (nc-mentions-binding? value bid)))))
            false))
      false))

(defn nc-complete-stores? [(form Code)
                           (env Code)
                           (T Code)
                           (bid i64)
                           (i i64)
                           (nf i64)] (-> bool)
  (if (>= i nf)
      true
      (if (nc-complete-store? (primitive/code-nth form (+ i 2)) env T i bid)
          (nc-complete-stores? form env T bid (+ i 1) nf)
          false)))

(defn nc-final-binding? [(form Code) (env Code) (bid i64)] (-> bool)
  (let [ref (if (nc-load? form env) (primitive/code-nth form 1) form)]
    (nc-same-binding? (nc-place-name ref) bid)))

(defn nc-final-bid [(form Code) (env Code)] (-> i64)
  (let [ref (if (nc-load? form env) (primitive/code-nth form 1) form)
        name (nc-place-name ref)]
    (if (primitive/code-sym? name) (primitive/binding-of name) 0)))

;;; A growable Code list, not `(~k ~v ~@(self …)): re-splicing the recursion's
;;; result copies the suffix at every level — quadratic in the field count
;;; (docs/design/META_MEMORY.md).
(defn nc-struct-pairs [(T Code) (form Code) (i i64) (nf i64)] (-> Code)
  (let [out (primitive/code-list-new)
        (mut f) i]
    (loop (if (>= (load f) nf)
              (break)
              (let [keyword
                      (primitive/code-symbol ":"
                                             (primitive/code-field-name T
                                                                        (load f)))
                    store (primitive/code-nth form (+ (load f) 2))]
                (do
                  (primitive/code-list-push! out keyword)
                  (primitive/code-list-push! out (primitive/code-nth store 2))
                  (store! f (+ (load f) 1))))))
    (primitive/code-list-done out)))

(defn nc-complete-zeroed-check [(form Code) (env Code)] (-> bool)
  (if (and (or (nc-head-is? form `let) (nc-head-is? form `let*))
           (>= (primitive/code-count form) 3))
      (let [binds (primitive/code-nth form 1)]
        (if (and (primitive/code-vector? binds)
                 (= (primitive/code-count binds) 2))
            (let [name (nc-mut-name (primitive/code-nth binds 0))
                  init (primitive/code-nth binds 1)]
              (if (and (primitive/code-sym? name) (nc-zeroed? init env))
                  (let [T-node (primitive/code-nth init 1)]
                    (if (nc-struct-decl? T-node)
                        (let [T (nc-reflect-struct-type T-node)
                              nf (primitive/code-field-count T)]
                          (if (and (> nf 0)
                                   (= (primitive/code-count form) (+ nf 3)))
                              (let [final (primitive/code-nth form (+ nf 2))
                                    bid (nc-final-bid final env)]
                                (if (and (> bid 0)
                                         (and (nc-complete-stores? form
                                                                   env
                                                                   T
                                                                   bid
                                                                   0
                                                                   nf)
                                              (nc-final-binding? final env bid)))
                                    (do
                                      (primitive/suggest form
                                                         (primitive/code-str "complete-zeroed-init: all fields of "
                                                                             T
                                                                             " are assigned exactly once; use a named constructor")
                                                         `(~T-node ~@(nc-struct-pairs T
                                                                                      form
                                                                                      0
                                                                                      nf)))
                                      true)
                                    false))
                              false))
                        false))
                  false))
            false))
      false))

(defn nc-sum-construction? [(form Code)] (-> bool)
  (let [d (primitive/code-decl form)]
    (and (primitive/code-list? d)
         (and (= (primitive/code-count d) (primitive/cast i64 4))
              (primitive/code-eq (primitive/code-nth d 2) `sum)))))

(defn nc-positional-candidate? [(form Code)] (-> bool)
  (and (primitive/code-list? form)
       (and (>= (primitive/code-count form) (primitive/cast i64 4))
            (and (primitive/code-sym? (primitive/code-nth form 0))
                 (not (primitive/code-keyword? (primitive/code-nth form 1)))))))

; Reflection describes a generic sum by its declaration symbol, while type-of
; returns the instantiated spelling `(Result T E)`. Strip only that application
; layer; anything else is not a reflectable sum and must be ignored safely.
(defn nc-sum-type [(T Code)] (-> Code)
  (if (primitive/code-sym? T)
      T
      (if (and (primitive/code-list? T)
               (and (> (primitive/code-count T) 0)
                    (primitive/code-sym? (primitive/code-nth T 0))))
          (primitive/code-nth T 0)
          `:unknown)))

(defn nc-find-variant [(T Code) (qname Code) (i i64) (n i64)] (-> i64)
  (if (>= i n)
      -1
      (if (primitive/code-eq (primitive/code-variant-qname T i) qname)
          i
          (nc-find-variant T qname (+ i 1) n))))

;;; Builder loop for the same reason as nc-struct-pairs (docs/design/META_MEMORY.md).
(defn nc-pairs [(T Code) (vi i64) (form Code) (argi i64) (fi i64) (n i64)] (-> Code)
  (let [out (primitive/code-list-new)
        (mut a) argi
        (mut f) fi]
    (loop (if (>= (load f) n)
              (break)
              (let [keyword
                      (primitive/code-symbol ":"
                                             (primitive/code-variant-field-name T
                                                                                vi
                                                                                (load f)))]
                (do
                  (primitive/code-list-push! out keyword)
                  (primitive/code-list-push! out
                                             (primitive/code-nth form (load a)))
                  (store! a (+ (load a) 1))
                  (store! f (+ (load f) 1))))))
    (primitive/code-list-done out)))

(defn nc-replacement [(T Code) (vi i64) (form Code) (nf i64)] (-> Code)
  `(~(primitive/code-nth form 0) ~@(nc-pairs T vi form 1 0 nf)))

(defn nc-check [(form Code)] (-> bool)
  (if (and (nc-positional-candidate? form) (nc-sum-construction? form))
      (let [T (primitive/type-of form)
            sum-type (nc-sum-type T)
            d (primitive/code-decl form)
            vi
              (if (primitive/code-eq sum-type `:unknown)
                  -1
                  (nc-find-variant sum-type
                                   (primitive/code-nth d 3)
                                   0
                                   (primitive/code-variant-count sum-type)))]
        (if (< vi (primitive/cast i64 0))
            false
            (let [nf (primitive/code-variant-fields sum-type vi)]
              ; Count equality excludes already-named calls and explicit type-argument
              ; forms, whose type vector cannot simply be discarded by an autofix.
              (if (and (>= nf (primitive/cast i64 3))
                       (= (primitive/code-count form) (+ nf 1)))
                  (do
                    (primitive/suggest form
                                       "constructors with 3 or more fields must use named arguments"
                                       (nc-replacement sum-type vi form nf))
                    true)
                  false))))
      false))

(defn nc-walk [(form Code) (env Code)] (-> Code)
  (if (primitive/code-list? form)
      (if (nc-manual-box-check form env)
          `0
          (if (nc-complete-zeroed-check form env)
              `0
              (if (nc-check form)
                  `0
                  (nc-kids form env 0 (primitive/code-count form)))))
      `0))

(defn nc-kids [(form Code) (env Code) (i i64) (n i64)] (-> Code)
  (do
    (for item (iter (primitive/code-slice form i n)) (nc-walk item env))
    `0))

(defn nc-user-module? [(m Code) (i i64) (n i64)] (-> bool)
  (if (>= i n)
      false
      (if (primitive/code-from-user? (primitive/code-nth m i))
          true
          (nc-user-module? m (+ i 1) n))))

(defn nc-module [(m Code) (prelude Code)] (-> Code)
  (if (nc-user-module? m 1 (primitive/code-count m))
      (nc-forms m (names/ln-env prelude m) 1 (primitive/code-count m))
      `0))

(defn nc-forms [(m Code) (env Code) (i i64) (n i64)] (-> Code)
  (do (for item (iter (primitive/code-slice m i n)) (nc-walk item env)) `0))

(defn nc-modules [(modules Code) (prelude Code) (i i64) (n i64)] (-> Code)
  (do
    (for item
      (iter (primitive/code-slice modules i n))
      (nc-module item prelude))
    `0))

(defn lint-named-constructors [(modules Code)] (-> Code)
  (nc-modules modules
              (names/ln-prelude modules 0 (primitive/code-count modules))
              0
              (primitive/code-count modules)))

(checker lint-named-constructors)
