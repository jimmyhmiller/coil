(module coil.lint.unused)
(import "coil.primitive" :as primitive)
(import "coil.alloc" :as alloc)
(import "coil.slice" :use [subslice])
(import "coil.str" :use *)
(import "coil.arraylist" :use *)
(import "coil.hashmap" :use *)
(import "coil.meta" :as meta)

; Dead-code elimination for SOURCE. Every top-level definition the program cannot
; reach from its roots is reported, and `coil lint --fix` deletes it outright,
; comment block and all, repeating until nothing more is unreachable.
;
; This is deliberately NOT part of `coil.lint.default`. Every other bundled rule
; rewrites a form into an equivalent one; this one removes code, and no analysis
; that reads only the compilation unit in front of it can know that nothing outside
; that unit wanted it. It is opt-in, per invocation:
;
;   coil lint app.coil --use coil.lint.unused          report what is unreachable
;   coil lint app.coil --use coil.lint.unused --diff   show the deletions
;   coil lint app.coil --use coil.lint.unused --fix    make them
;   coil lint --use coil.lint.unused                   every program of a package
;
; Follow `--fix` with `coil fmt --write`. Deletions are byte-exact and leave the
; whitespace their neighbours were laid out around — a blank line at a seam, an
; indent where a `let` binding used to be. The formatter closes those; nothing else
; needs to.
;
; ── the rule asks; it does not walk ────────────────────────────────────────────
; Nothing here decides what a name refers to, and nothing here walks the program.
; Every fact is the compiler's, and every question is a lookup the size of its
; answer (docs/design/PROGRAM_FACTS.md):
;
;   * definitions — the declaration graph (`meta/dependencies`) from the roots:
;     `main`, each module's own `main`, the tests, and what each module uses at top
;     level (`meta/module-uses`). The form to delete is `meta/definition-form`.
;   * variants — a variant is constructed when the checker resolved a use of it
;     (`meta/resolved-uses`, generated code included); a match pattern is no such
;     use. Its arms are the references to it in role `:pattern`, and each arm is
;     the form its pattern heads (`meta/reference-form`).
;   * imports — the references that resolved through them, and the declarations
;     the module depends on.
;   * `let` bindings — no read resolves to the local a binder introduces
;     (`meta/binders`, `meta/references-to`).
;   * fields — the fields the checker resolved each use of (`meta/field-uses`).
;
; Only the user's own modules are judged: the ones `meta/source-modules` holds the
; user-written records of. Everything else is the toolchain, which this program can
; neither see into nor delete from.
;
; Dead means dead in the program `coil lint` checked, for its one target. Code a
; macro writes only for another target — a branch on `(target-os)` — is not in that
; program: lint every target you ship (`coil lint --target …`), and delete only what
; all of them report.
;
; ── EXECUTABLE OR LIBRARY ──────────────────────────────────────────────────────
; In Coil `export` is optional and a module without one exposes EVERYTHING
; (docs/reference/NAMESPACING.md: "default: all public"). So the unit's SHAPE
; decides what is a root, the same distinction the language already makes with
; `main`:
;
;   * The program defines `main` — it is an EXECUTABLE. Its modules are that
;     program's private implementation, nothing outside links against them, and
;     reachability from `main` is the whole truth. Unreachable is dead.
;   * The program defines no `main` — it is a LIBRARY. Its callers are not here to
;     be seen. A module that declares an export list is taken at its word and only
;     those names are rooted; a module that declares none exposes all of its
;     definitions, so all of them are rooted and nothing in it is provably dead.
;
; `--lint-param unused-roots=VALUE` overrides the choice: `exports` forces the
; executable reading (root only `main` and explicit exports — this is what to use to
; clean out a library's own internals, when you know who the callers are), `public`
; forces the library reading, and the default `auto` picks by the rule above.

;;; A set of names.
(defn ul-names [(a (dyn alloc/Allocator))] (-> (HashMap (slice u8) i64))
  (HashMap::new [(slice u8) i64] a (keyops)))

;;; VALUE of a program query, or the empty list when the program has none.
(defn ul-answer [(answer primitive/ProgramAnswer)] (-> Code)
  (match answer
    (primitive/Answer [value] value)
    (_ `())))

;;; The records of a source query, or the empty list outside `coil lint`.
(defn ul-view [(view primitive/SourceView)] (-> Code)
  (match view
    (primitive/SourceIs [records] records)
    (primitive/SourceUnavailable [] `())))

;;; `MODULE.NAME`, the qualified identity of NAME declared in MODULE.
(defn ul-qualify [(a (dyn alloc/Allocator)) (module (slice u8)) (name (slice u8))] (-> (slice u8))
  (let [(mut sb) (StrBuf::new a)]
    (push-str! (mut sb) module)
    (push-str! (mut sb) ".")
    (push-str! (mut sb) name)
    (str sb)))

;;; The module part of the qualified name Q: everything before its last `.`.
(defn ul-module-of [(q (slice u8))] (-> (slice u8))
  (let [(mut cut) -1]
    (for [i 0 (len q)]
      (when (= (primitive/cast i64 (get q i)) 46) (set! cut i) 0))
    (if (< cut 0) "" (subslice q 0 cut))))

(defn ul-sym-text [(c Code)] (-> (slice u8))
  (if (primitive/code-sym? c) (primitive/code-sym c) ""))

;;; The head symbol of the list F, or "" (a vector has no head).
(defn ul-head-text [(f Code)] (-> (slice u8))
  (if (and (primitive/code-list? f) (not (primitive/code-vector? f)) (> (len f) 0))
      (ul-sym-text (get f 0))
      ""))

;;; The global a symbol resolved to, as written, or "".
(defn ul-global [(node Code)] (-> (slice u8))
  (match (meta/source-binding node)
    (primitive/BindsGlobal [q] (primitive/code-sym q))
    (_ "")))

;;; Is NAME a definition of KIND: "struct", "sum" or "extern"?
(defn ul-kind? [(name Code) (kind (slice u8))] (-> bool)
  (match (meta/definition-kind name)
    (primitive/KindIs [k]
      (= kind (match k
                (primitive/Struct [] "struct")
                (primitive/Sum [] "sum")
                (primitive/Extern [] "extern")
                (_ ""))))
    (_ false)))

;;; Where F was written, `FILE:LINE:COL`: the identity of an authored form.
(defn ul-position [(f Code) (a (dyn alloc/Allocator))] (-> (slice u8))
  (let [(mut sb) (StrBuf::new a)]
    (push-str! (mut sb) (primitive/code-file f))
    (push-str! (mut sb) ":")
    (push-i64! (mut sb) (primitive/code-line f))
    (push-str! (mut sb) ":")
    (push-i64! (mut sb) (primitive/code-col f))
    (str sb)))

;;; Delete NODE as a fix of its own: one that cannot be applied must not hold the
;;; rest back, and the rest must not hold it back.
(defn ul-delete-alone [(node Code) (message (slice u8))] (-> i64)
  (primitive/suggest-transaction)
  (primitive/delete node message)
  (primitive/suggest-transaction)
  0)

; ── the program ────────────────────────────────────────────────────────────────

;;; The authored records of the user's own modules, `(MODULE FORM…)`.
(defn ul-sources [] (-> Code)
  (let [(mut out) (primitive/code-list-new)]
    (for record (iter (ul-view (meta/source-modules)))
      (when (meta/user-module? record) (push! (mut out) record) 0))
    (primitive/code-list-done (load out))))

;;; The user's modules, and every definition they declare, by qualified name.
(defn ul-own! [(sources Code)
               (modules (mut (HashMap (slice u8) i64)))
               (owned (mut (HashMap (slice u8) i64)))] (-> i64)
  (for record (iter sources)
    (let [m (get record 0)]
      (set! (mut modules) (primitive/code-sym m) 1)
      (for d (iter (ul-answer (meta/definitions m)))
        (set! (mut owned) (primitive/code-sym d) 1))))
  0)

;;; Does module M declare an `export` list?
(defn ul-has-export-list? [(m Code)] (-> bool)
  (block :found
    (for f (iter (ul-answer (meta/module-header m)))
      (when (= (ul-head-text f) "export") (return-from :found true)))
    false))

;;; The executable reading roots `main` and the explicit exports; the library
;;; reading roots every definition of a module without an export list. `auto`
;;; (default) reads the shape — a program defines `main`, or, in a package that
;;; holds several programs, one of its modules does; `exports` and `public` pin it.
(defn ul-library? [(sources Code) (owned (mut (HashMap (slice u8) i64)))] (-> bool)
  (let [mode (primitive/lint-param "unused-roots" "auto")]
    (cond (= mode "exports") false
          (= mode "public") true
          :else (and (match (meta/definition-kind `main)
                       (primitive/KindIs [_] false)
                       (_ true))
                     (block :none
                       (for record (iter sources)
                         (when (contains? owned (ul-qualify (alloc/malloc-allocator)
                                                            (primitive/code-sym (get record 0)) "main"))
                           (return-from :none false)))
                       true)))))

; ── definitions ────────────────────────────────────────────────────────────────
; Marking from roots over the compiler's declaration graph. A pair of mutually
; recursive dead functions keep each other alive under a mention count; from the
; roots, neither is reached.
;
; ROOTS: `main` and each module's own `main` (a package can hold several programs);
; every test, which `coil test` calls from outside the program the way the runtime
; calls `main` — `deftest` and `defprop` mint `coil-test$NAME` (assert.coil,
; prop.coil) and the harness finds them by that prefix; and what each user module
; uses at top level (`meta/module-uses`). Without the tests a whole-project run
; proposed deleting a function and the only test of it in the same round, which
; compiles precisely because both halves went.
;
; Marking expands the user's own names and the roots. A library declaration never
; depends on one of the program's, so the toolchain's part of the graph is left
; unwalked.

(defn ul-root! [(name (slice u8)) (roots (mut (HashMap (slice u8) i64)))] (-> i64)
  (set! (mut roots) name 1)
  0)

(defn ul-roots! [(sources Code)
                 (owned (mut (HashMap (slice u8) i64)))
                 (library bool)
                 (roots (mut (HashMap (slice u8) i64)))] (-> i64)
  (match (meta/definition-kind `main)
    (primitive/KindIs [_] (ul-root! "main" (mut roots)))
    (_ 0))
  (for record (iter sources)
    (let [q (ul-qualify (alloc/malloc-allocator) (primitive/code-sym (get record 0)) "main")]
      (when (contains? owned q) (ul-root! q (mut roots)) 0)))
  (for name (iter owned)
    (match (find name "coil-test$")
      (Some [_] (ul-root! name (mut roots)))
      (None [] 0)))
  (for record (iter sources)
    (let [m (get record 0)]
      (for u (iter (ul-answer (meta/module-uses m)))
        (ul-root! (primitive/code-sym u) (mut roots)))
      (when (and library (not (ul-has-export-list? m)))
        (for d (iter (ul-answer (meta/definitions m)))
          (ul-root! (primitive/code-sym d) (mut roots))))
      0))
  0)

;;; The declarations NAME depends on, asked of the compiler once.
(defn ul-deps [(probe Code)
               (name (slice u8))
               (a (dyn alloc/Allocator))
               (cache (mut (HashMap (slice u8) (ArrayList (slice u8)))))] (-> (ArrayList (slice u8)))
  (match (get cache name)
    (Some [ds] ds)
    (None []
      (let [(mut ds) (ArrayList::new [(slice u8)] a)]
        (for d (iter (ul-answer (meta/dependencies (primitive/code-symbol name))))
          (push! (mut ds) (primitive/code-sym d)))
        (set! (mut cache) name ds)
        ds))))

;;; Mark everything reachable from ROOTS into LIVE.
(defn ul-mark! [(probe Code)
                (a (dyn alloc/Allocator))
                (modules (mut (HashMap (slice u8) i64)))
                (owned (mut (HashMap (slice u8) i64)))
                (roots (mut (HashMap (slice u8) i64)))
                (live (mut (HashMap (slice u8) i64)))
                (cache (mut (HashMap (slice u8) (ArrayList (slice u8)))))] (-> i64)
  (let [(mut queue) (ArrayList::new [(slice u8)] a)
        (mut at) 0]
    (for r (iter roots)
      (unless (contains? live r)
        (set! (mut live) r 1)
        (push! (mut queue) r) 0))
    (loop
      (when (>= at (len queue)) (break))
      (let [name (get queue at)]
        (set! at (+ at 1))
        (for dn (iter (ul-deps probe name a (mut cache)))
          (when (and (not (contains? live dn))
                     (or (contains? owned dn) (contains? modules (ul-module-of dn))))
            (set! (mut live) dn 1)
            (push! (mut queue) dn) 0))))
    0))

;;; Delete the authored form of each definition the program owns and did not reach.
;;; One form can make several definitions (a `deftrait` makes its vtable too, a
;;; macro can define more than one name), so a form goes only when none of what it
;;; defines is reached.
(defn ul-report-definitions [(probe Code)
                             (a (dyn alloc/Allocator))
                             (owned (mut (HashMap (slice u8) i64)))
                             (live (mut (HashMap (slice u8) i64)))] (-> i64)
  (let [(mut live-at) (ul-names a)
        (mut gone) (ul-names a)]
    (for q (iter owned)
      (when (contains? live q)
        (match (meta/definition-form (primitive/code-symbol q))
          (primitive/Answer [f] (do (set! (mut live-at) (ul-position f a) 1) 0))
          (_ 0))
        0))
    (for q (iter owned)
      (unless (contains? live q)
        (match (meta/definition-form (primitive/code-symbol q))
          (primitive/Answer [f]
            (let [at (ul-position f a)]
              (unless (or (contains? live-at at) (contains? gone at) (not (primitive/code-from-user? f)))
                (set! (mut gone) at 1)
                (primitive/delete f "unused: nothing reachable from this program's roots refers to this")
                0)))
          (_ 0))
        0)))
  0)

; ── unused sum variants ────────────────────────────────────────────────────────
; A variant nothing ever CONSTRUCTS, together with the `match` arms that handle it.
;
; A variant is constructed when the checker resolved a use of it — a call, a
; function pointer — written or generated (`meta/resolved-uses`). A `match` pattern
; is a reference to the variant, in role `:pattern`, but no use the checker
; resolves: handling a variant is not making one.
;
; Deleting the variant alone would leave arms referring to a variant that no longer
; exists, so the arms go with it: the references to it in role `:pattern`, each
; deleted as the arm it heads (`meta/reference-form`). That is not a behaviour
; change: an arm for a variant nothing constructs cannot run, and exhaustiveness
; still holds over what remains.
;
; A sum none of whose variants anything here constructs is left whole: its values
; come from somewhere this program cannot see, and an empty `defsum` is a different
; type, not a smaller one.
;
; SKIPPED ENTIRELY under the library reading. A library's variants are its API — its
; callers construct them and are not present to be seen.

;;; Does anything construct the variant Q?
(defn ul-constructed? [(q Code)] (-> bool)
  (or (match (meta/resolved-uses q)
        (primitive/Answer [n] (> (primitive/code-int n) 0))
        (_ true))
      (block :found
        (for r (iter (ul-view (meta/references-to q)))
          (unless (= (meta/reference-role r) `:pattern) (return-from :found true)))
        false)))

;;; Delete the variant V, named Q, and every arm matching it.
(defn ul-delete-variant [(v Code) (q Code)] (-> i64)
  (primitive/delete v "unused: nothing constructs this variant")
  (for r (iter (ul-view (meta/references-to q)))
    (when (= (meta/reference-role r) `:pattern)
      (match (meta/reference-form r)
        (primitive/Answer [arm]
          (do (primitive/delete arm "unused: nothing constructs this variant, so this arm cannot run") 0))
        (_ 0)))
    0)
  0)

(defn ul-variants [(probe Code)
                   (a (dyn alloc/Allocator))
                   (owned (mut (HashMap (slice u8) i64)))
                   (live (mut (HashMap (slice u8) i64)))] (-> i64)
  (for s (iter owned)
    (let [sum (primitive/code-symbol s)]
      (when (and (contains? live s) (ul-kind? sum "sum"))
        (match (meta/definition-form sum)
          (primitive/Answer [f]
            (when (and (= (ul-head-text f) "defsum") (primitive/code-from-user? f))
              (let [module (ul-module-of s)
                    (mut unbuilt) (ArrayList::new [i64] a)
                    (mut variants) 0]
                (for i (range 2 (len f))
                  ; a generic sum's parameter vector `[T]` is no variant
                  (let [vn (ul-head-text (get f i))]
                    (when (> (len vn) 0)
                      (set! variants (+ variants 1))
                      (unless (ul-constructed? (primitive/code-symbol (ul-qualify a module vn)))
                        (push! (mut unbuilt) i) 0))
                    0))
                (when (< (len unbuilt) variants)
                  (for i (iter unbuilt)
                    (let [v (get f i)]
                      (ul-delete-variant v (primitive/code-symbol (ul-qualify a module (ul-head-text v))))))
                  0))
              0))
          (_ 0))
        0)))
  0)

; ── unused imports ─────────────────────────────────────────────────────────────
; An import is used when the module refers to something through it, or depends on
; something its module declares, or the import itself does something:
;
;   * a reference resolved through it — the compiler records the facade every
;     authored reference went through (`meta/references-through`);
;   * a dependency of one of the module's definitions, or of its top-level uses, on
;     a declaration of the imported module — that covers what no reference names:
;     an impl's method (a trait call, an `=` on slices), a convention, a macro's
;     expansion;
;   * an AMBIENT effect: the imported module registers a checker or transform, or
;     does anything else at top level beyond publishing its exports and impls —
;     "a dialect is a single import" is exactly an import nothing refers to;
;   * a template (a quasiquote) of the module names something through it: a
;     template's text resolves where it expands, so no reference records it.
;
; A `:use [a b]` item is used when a reference resolved through the import under
; its exported name, or the module depends on the declaration it names. An import
; that `:reexport`s publishes its names to the module's importers, and using them
; here was never the point, so it is never judged.

;;; Facts about an imported module, asked once however many modules import it.
;;; PROVIDER maps each declaration a module uses at top level — its impls'
;;; methods, its exports — to that module; AMBIENT holds the modules that do
;;; something at top level beyond publishing exports and providing impls: a use
;;; of one of their own definitions their export list does not explain, such as a
;;; registered checker or transform, an assertion, a top-level macro call.
(defn ul-learn-target! [(t Code)
                        (a (dyn alloc/Allocator))
                        (learned (mut (HashMap (slice u8) i64)))
                        (provider (mut (HashMap (slice u8) (slice u8))))
                        (ambient (mut (HashMap (slice u8) i64)))] (-> i64)
  (let [module (primitive/code-sym t)]
    (unless (contains? learned module)
      (set! (mut learned) module 1)
      (let [(mut exported) (ul-names a)
            (mut declared) (ul-names a)]
        (for f (iter (ul-answer (meta/module-header t)))
          (when (= (ul-head-text f) "export")
            (for i (range 1 (len f))
              (let [n (get f i)]
                (when (primitive/code-sym? n)
                  (set! (mut exported) (ul-qualify a module (primitive/code-sym n)) 1) 0))))
          0)
        (for d (iter (ul-answer (meta/definitions t)))
          (set! (mut declared) (primitive/code-sym d) 1))
        (for u (iter (ul-answer (meta/module-uses t)))
          (let [q (primitive/code-sym u)]
            (set! (mut provider) q module)
            (when (and (contains? declared q) (not (contains? exported q)))
              (set! (mut ambient) module 1) 0))))
      0))
  0)

;;; Everything module M's definitions and top-level uses depend on, into DEPS, and
;;; the modules those declarations belong to or are provided by, into TOUCHED.
(defn ul-module-dependencies! [(m Code)
                               (a (dyn alloc/Allocator))
                               (cache (mut (HashMap (slice u8) (ArrayList (slice u8)))))
                               (provider (mut (HashMap (slice u8) (slice u8))))
                               (deps (mut (HashMap (slice u8) i64)))
                               (touched (mut (HashMap (slice u8) i64)))] (-> i64)
  (let [(mut names) (ArrayList::new [(slice u8)] a)]
    (for u (iter (ul-answer (meta/module-uses m)))
      (set! (mut deps) (primitive/code-sym u) 1)
      (push! (mut names) (primitive/code-sym u)))
    (for n (iter (ul-answer (meta/definitions m))) (push! (mut names) (primitive/code-sym n)))
    (for n (iter names)
      (for d (iter (ul-deps m n a (mut cache))) (set! (mut deps) d 1))))
  (for d (iter deps)
    (set! (mut touched) (ul-module-of d) 1)
    (match (get provider d)
      (Some [module] (do (set! (mut touched) module 1) 0))
      (None [] 0)))
  0)

;;; The element after keyword KW in import form F, or `()`.
(defn ul-import-arg [(f Code) (kw Code)] (-> Code)
  (block :found
    (for [i 1 (- (len f) 1)]
      (when (= (get f i) kw) (return-from :found (get f (+ i 1)))))
    `()))

(defn ul-import-has? [(f Code) (kw Code)] (-> bool)
  (block :found
    (for e (iter f) (when (= e kw) (return-from :found true)))
    false))

;;; Every symbol spelled in F, a template (a quasiquote) or a part of one, into
;;; OUT. A template's text is resolved where it expands, so no reference records
;;; it, yet the import it names is what lets that expansion resolve.
(defn ul-template-symbols! [(f Code) (out (mut (HashMap (slice u8) i64)))] (-> i64)
  (cond (primitive/code-sym? f) (do (set! (mut out) (primitive/code-sym f) 1) 0)
        (or (primitive/code-list? f) (primitive/code-vector? f))
          (do (for e (iter f) (ul-template-symbols! e (mut out))) 0)
        :else 0))

;;; Does a template of the module (its symbols, SPELLED) name something through
;;; import NODE of MODULE: a name qualified by its alias, one of its `:use` names,
;;; or anything at all when it is a `:use *`?
(defn ul-template-names? [(node Code) (module (slice u8)) (spelled (mut (HashMap (slice u8) i64)))] (-> bool)
  (let [alias (ul-import-arg node `:as)
        q (if (primitive/code-sym? alias) (primitive/code-sym alias) module)
        use-spec (ul-import-arg node `:use)
        (mut found) false]
    (for name (iter spelled)
      (when (and (> (len name) (len q))
                 (= (subslice name 0 (len q)) q)
                 (= (get name (len q)) (: 47 u8)))
        (set! found true)))
    (when (primitive/code-vector? use-spec)
      (for e (iter use-spec)
        (when (and (primitive/code-sym? e) (contains? spelled (primitive/code-sym e)))
          (set! found true))))
    (when (and (primitive/code-sym? use-spec) (= (primitive/code-sym use-spec) "*") (> (len spelled) 0))
      (set! found true))
    found))

(defn ul-report-import [(import Code)
                        (a (dyn alloc/Allocator))
                        (deps (mut (HashMap (slice u8) i64)))
                        (touched (mut (HashMap (slice u8) i64)))
                        (ambient (mut (HashMap (slice u8) i64)))
                        (spelled (mut (HashMap (slice u8) i64)))] (-> i64)
  (let [node (meta/import-node import)
        module (primitive/code-sym (meta/import-target import))
        use-spec (ul-import-arg node `:use)
        refs (ul-view (meta/references-through import))
        (mut through) (ul-names a)]
    ; the names references resolved under through it
    (for r (iter refs)
      (match (meta/reference-exported-name r)
        (Some [n] (do (set! (mut through) (primitive/code-sym n) 1) 0))
        (None [] 0)))
    (unless (or (not (primitive/code-from-user? node)) (ul-import-has? node `:reexport))
      (if (or (> (len refs) 0) (contains? touched module) (contains? ambient module)
              (ul-template-names? node module (mut spelled)))
          ; used: drop the `:use` items that are not
          (when (primitive/code-vector? use-spec)
            (for e (iter use-spec)
              (when (primitive/code-sym? e)
                (let [n (primitive/code-sym e)]
                  (unless (or (contains? through n) (contains? deps (ul-qualify a module n))
                              (contains? spelled n))
                    (ul-delete-alone e "unused: nothing in the module refers to this imported name"))))
              0)
            0)
          (ul-delete-alone node "unused: this import binds nothing the module refers to"))
      0))
  0)

(defn ul-imports [(sources Code)
                  (a (dyn alloc/Allocator))
                  (cache (mut (HashMap (slice u8) (ArrayList (slice u8)))))] (-> i64)
  (let [(mut learned) (ul-names a)
        (mut ambient) (ul-names a)
        (mut provider) (HashMap::new [(slice u8) (slice u8)] a (keyops))]
    (for record (iter sources)
      (for import (iter (ul-view (meta/imports (get record 0))))
        (ul-learn-target! (meta/import-target import) a (mut learned) (mut provider) (mut ambient))))
    (for record (iter sources)
      (let [m (get record 0)
            (mut deps) (ul-names a)
            (mut touched) (ul-names a)
            (mut spelled) (ul-names a)]
        (ul-module-dependencies! m a (mut cache) (mut provider) (mut deps) (mut touched))
        (for template (iter (ul-view (meta/forms-headed m `quasiquote)))
          (ul-template-symbols! template (mut spelled)))
        (for import (iter (ul-view (meta/imports m)))
          (ul-report-import import a (mut deps) (mut touched) (mut ambient) (mut spelled))))))
  0)

; ── unused let bindings ────────────────────────────────────────────────────────
; `(let [k v …] body…)` where nothing reads `k`. Two conditions, and the second is
; the one that decides how much of this is safe to do at all:
;
;   * No read resolves to the local `k` introduces. The compiler answers both: each
;     binder with the local's identity (`meta/binders`), and the authored reads
;     that resolve to that identity (`meta/references-to`), so a shadowing `k` or a
;     global named `k` is a different local, not a read.
;   * `v` cannot have an effect. A binding is only dead weight if evaluating its
;     initializer was pointless; `(let [x (write! …)] …)` still has to run the write.
;     Purity is not decidable here, so this asks for a PROOF from a small whitelist
;     — a literal, a local, a stack/static reservation, a size query, a cast or a
;     field or load of something already proven pure — and refuses everything else.
;     A call is assumed to have effects. The whitelist is of primitives, by the
;     qualified name the head resolved to.
;
; The binding is two adjacent nodes and both go, as two deletions of the same round.

(defn ul-pure-primitive? [(q (slice u8))] (-> bool)
  (or (= q "coil.primitive.alloc-stack") (= q "coil.primitive.alloc-static")
      (= q "coil.primitive.sizeof") (= q "coil.primitive.alignof")
      (= q "coil.primitive.offsetof") (= q "coil.primitive.cast")
      (= q "coil.primitive.field") (= q "coil.primitive.load")))

;;; Evaluating E provably cannot do anything but produce a value.
(defn ul-pure? [(e Code)] (-> bool)
  (cond (not (primitive/code-list? e)) true
        (= (len e) 0) true
        :else
          (let [head (get e 0)
                spelled (ul-sym-text head)]
            (cond
              ; `(.field e)`: a field read, pure when its base is
              (and (> (len spelled) 1) (= (primitive/cast i64 (get spelled 0)) 46) (= (len e) 2))
                (ul-pure? (get e 1))
              (ul-pure-primitive? (ul-global head))
                (block :all
                  (for i (range 1 (len e))
                    (unless (ul-pure? (get e i)) (return-from :all false)))
                  true)
              :else false))))

(defn ul-lets [(sources Code)] (-> i64)
  (for record (iter sources)
    (for b (iter (ul-view (meta/binders (get record 0))))
      (let [form (meta/binder-form b)
            value (meta/binder-value b)]
        (when (and (primitive/code-from-user? form)
                   (= (len (ul-view (meta/references-to (meta/binder-id b)))) 0)
                   (ul-pure? value))
          (primitive/delete form "unused: this binding is never read")
          (primitive/delete value "unused: this binding is never read")
          0))))
  0)

; ── unused struct fields ───────────────────────────────────────────────────────
; A `defstruct` field that nothing ever reads, writes, or takes the offset of.
;
; ⚠ THIS IS THE ONE DELETION THE COMPILE GATE CANNOT CHECK. Removing a function or
; an import that something needed stops the build, and `--fix` reverts the round.
; Removing a FIELD changes the struct's size and every later field's offset, and a
; program that only ever crossed that layout to C, or memcpy'd it, or hashed its
; bytes, still compiles — and is now wrong at run time. So the guards here are
; deliberately heavier than anywhere else in this file, and a field is deleted only
; when the layout provably belongs to Coil alone:
;
;   * No `extern` depends on the struct. That is the edge across which a layout
;     stops being ours to change.
;   * The struct is never either end of a POINTER CAST (`meta/cast-structs`). This is
;     the guard the other ones do not imply, and `src/apps/clox` is why it exists.
;     It does C-style struct inheritance: every heap object begins with an `(obj
;     Obj)` header, and code reaches that header by casting `(ptr ObjString)` to
;     `(ptr Obj)` rather than by naming the field. Nothing does `(field s obj)`, so
;     the header looked dead in all eight object types; deleting it compiled cleanly
;     and took the VM from 246 passing tests to 246 failing ones. A struct that is
;     cast through is a struct whose layout something is relying on.
;   * A field a generic body reads through a type parameter is attributed to no
;     struct, so a field of that name is kept in every struct (`meta/field-uses _`).
;   * A `cimport`ed struct is generated, not written, so `cop-record-fix` refuses to
;     edit it before any of this is consulted.
;
; Uses are the checker's, across the WHOLE program — bundled code included, which
; reads the user's structs through generic and derived helpers — and keyed by the
; struct's qualified name, so two modules' `P` are two structs.
;
; Even with all of that, this pass is OFF unless you ask for it:
; `--lint-param unused-fields=on`. The guards above are a list of the layout
; escapes anyone has thought of, and a list like that is never finished — a
; `(ptr u8)` round trip, a `mem-cmp` over a struct's bytes, and a hand-written
; offset all defeat it, and all of them fail at run time rather than at build time.
; Every other deletion in this file is checked by the compiler before it is kept;
; this one is not, so it is the one you opt into.

;;; Does an `extern` depend on the struct Q?
(defn ul-crosses-abi? [(q Code)] (-> bool)
  (block :found
    (for d (iter (ul-answer (meta/dependents q)))
      (when (ul-kind? d "extern") (return-from :found true)))
    false))

(defn ul-symbols! [(names Code) (out (mut (HashMap (slice u8) i64)))] (-> i64)
  (for n (iter names) (set! (mut out) (ul-sym-text n) 1))
  0)

(defn ul-fields [(probe Code)
                 (a (dyn alloc/Allocator))
                 (owned (mut (HashMap (slice u8) i64)))
                 (live (mut (HashMap (slice u8) i64)))] (-> i64)
  (when (= (primitive/lint-param "unused-fields" "off") "on")
    (let [(mut cast) (ul-names a)
          (mut generic) (ul-names a)]
      (ul-symbols! (ul-answer (meta/cast-structs)) (mut cast))
      (ul-symbols! (ul-answer (meta/field-uses `_)) (mut generic))
      (for s (iter owned)
        (let [struct (primitive/code-symbol s)]
          (when (and (contains? live s) (not (contains? cast s)) (ul-kind? struct "struct")
                     (not (ul-crosses-abi? struct)))
            (match (meta/definition-form struct)
              (primitive/Answer [f]
                (when (and (= (ul-head-text f) "defstruct") (primitive/code-from-user? f))
                  (let [(mut used) (ul-names a)]
                    (ul-symbols! (ul-answer (meta/field-uses struct)) (mut used))
                    (for v (iter f)
                      ; a one-field struct keeps its field: an empty `defstruct` is a
                      ; different type, not a smaller one
                      (when (and (primitive/code-vector? v) (> (len v) 1))
                        (for b (iter v)
                          (let [fname (ul-head-text b)]
                            (when (and (> (len fname) 0)
                                       (not (contains? used fname))
                                       (not (contains? generic fname)))
                              (primitive/delete b "unused: this field is never read or written")
                              0)))
                        0)))
                  0))
              (_ 0))
            0)))
      0))
  0)

; ── the checker ────────────────────────────────────────────────────────────────
(defn unused-code [(modules Code)] (-> Code)
  (let [a (alloc/malloc-allocator)
        sources (ul-sources)
        (mut user) (ul-names a)
        (mut owned) (ul-names a)
        (mut roots) (ul-names a)
        (mut live) (ul-names a)
        (mut deps) (HashMap::new [(slice u8) (ArrayList (slice u8))] a (keyops))]
    (ul-own! sources (mut user) (mut owned))
    (let [library (ul-library? sources (mut owned))]
      (ul-roots! sources (mut owned) library (mut roots))
      (ul-mark! `main a (mut user) (mut owned) (mut roots) (mut live) (mut deps))
      (ul-report-definitions `main a (mut owned) (mut live))
      (unless library (ul-variants `main a (mut owned) (mut live)) 0)
      (ul-imports sources a (mut deps))
      (ul-lets sources)
      (ul-fields `main a (mut owned) (mut live)))
    `0))

(checker unused-code)
