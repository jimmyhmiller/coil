(module coil.lint.unused)
(import "coil.primitive" :as primitive)
(import "coil.alloc" :as alloc)
(import "coil.slice" :use [subslice])
(import "coil.str" :use *)
(import "coil.arraylist" :use *)
(import "coil.hashmap" :use *)
(import "coil.meta" :as meta)

; Dead-code elimination for SOURCE. Every top-level definition the program cannot
; reach from its roots is reported, and `coil lint --fix` deletes it outright,
; comment block and all, repeating until nothing more is unreachable.
;
; This is deliberately NOT part of `coil.lint.default`. Every other bundled rule
; rewrites a form into an equivalent one; this one removes code, and no analysis
; that reads only the compilation unit in front of it can know that nothing outside
; that unit wanted it. It is opt-in, per invocation:
;
;   coil lint app.coil --use coil.lint.unused          report what is unreachable
;   coil lint app.coil --use coil.lint.unused --diff   show the deletions
;   coil lint app.coil --use coil.lint.unused --fix    make them
;
; Follow `--fix` with `coil fmt --write`. Deletions are byte-exact and leave the
; whitespace their neighbours were laid out around — a blank line at a seam, an
; indent where a `let` binding used to be. The formatter closes those; nothing else
; needs to.
;
; ── every judgement is the compiler's ──────────────────────────────────────────
; Nothing here decides what a name refers to. A spelling is not an identity: two
; modules may both define `helper`, a local may share a global's name, a library
; may define the same name as the program. So every question is put to the
; compiler, which answers with what it resolved:
;
;   * definitions — the declaration graph (`meta/dependencies`): calls, function
;     pointers, types, traits, constants, globals, conventions and macro
;     expansions, all by qualified name;
;   * roots — `main`, the tests, and what each module uses outside its own
;     declarations (`meta/module-uses`): its exports, `export-c`s, impls,
;     assertions, `meta` forms, registered checkers and transforms, and top-level
;     macro calls;
;   * variants — the constructions the checker resolved;
;   * imports — the references that resolved through them, and the declarations
;     the module depends on;
;   * `let` bindings — the local each binder introduces and the locals each read
;     resolves to (`meta/source-binding`);
;   * fields — the checked type of every access.
;
; Only the user's own modules are judged: the ones `meta/source-modules` holds the
; authored source of. Everything else is the toolchain, which this program can
; neither see into nor delete from.
;
; ── EXECUTABLE OR LIBRARY ──────────────────────────────────────────────────────
; In Coil `export` is optional and a module without one exposes EVERYTHING
; (docs/reference/NAMESPACING.md: "default: all public"). So the unit's SHAPE
; decides what is a root, the same distinction the language already makes with
; `main`:
;
;   * The program defines `main` — it is an EXECUTABLE. Its modules are that
;     program's private implementation, nothing outside links against them, and
;     reachability from `main` is the whole truth. Unreachable is dead.
;   * The program defines no `main` — it is a LIBRARY. Its callers are not here to
;     be seen. A module that declares an export list is taken at its word and only
;     those names are rooted; a module that declares none exposes all of its
;     definitions, so all of them are rooted and nothing in it is provably dead.
;
; `--lint-param unused-roots=VALUE` overrides the choice: `exports` forces the
; executable reading (root only `main` and explicit exports — this is what to use to
; clean out a library's own internals, when you know who the callers are), `public`
; forces the library reading, and the default `auto` picks by the rule above.

;;; A set of qualified names.
(defn ul-names [(a (dyn alloc/Allocator))] (-> (HashMap (slice u8) i64))
  (HashMap::new [(slice u8) i64] a (keyops)))

;;; VALUE of a program query, or the empty list when the program has none.
(defn ul-answer [(answer primitive/ProgramAnswer)] (-> Code)
  (match answer
    (primitive/Answer [value] value)
    (_ `())))

;;; The authored records of the user's own modules, `(MODULE FORM…)`: the ones
;;; whose forms the compiler says the user wrote. The toolchain's records are
;;; there too, and nothing in them is this program's to judge. Empty outside
;;; `coil lint`, where no source model is kept.
(defn ul-sources [] (-> Code)
  (match (meta/source-modules)
    (primitive/SourceIs [records]
      (let [(mut out) (primitive/code-list-new)]
        (for record (iter records)
          (when (meta/user-module? record) (push! (mut out) record) 0))
        (primitive/code-list-done (load out))))
    (primitive/SourceUnavailable [] `())))

;;; `MODULE.NAME`, the qualified identity of NAME declared in MODULE.
(defn ul-qualify [(a (dyn alloc/Allocator)) (module (slice u8)) (name (slice u8))] (-> (slice u8))
  (let [(mut sb) (StrBuf::new a)]
    (push-str! (mut sb) module)
    (push-str! (mut sb) ".")
    (push-str! (mut sb) name)
    (str sb)))

;;; The module part of the qualified name Q: everything before its last `.`.
(defn ul-module-of [(q (slice u8))] (-> (slice u8))
  (let [(mut cut) -1]
    (for [i 0 (len q)]
      (when (= (primitive/cast i64 (get q i)) 46) (set! cut i) 0))
    (if (< cut 0) "" (subslice q 0 cut))))

(defn ul-sym-text [(c Code)] (-> (slice u8))
  (if (primitive/code-sym? c) (primitive/code-sym c) ""))

;;; The head symbol of the list F, or "" (a vector has no head).
(defn ul-head-text [(f Code)] (-> (slice u8))
  (if (and (primitive/code-list? f) (not (primitive/code-vector? f)) (> (len f) 0))
      (ul-sym-text (get f 0))
      ""))

;;; The name a top-level authored form declares: its first symbol after the head,
;;; past a generic parameter vector. "" when it has none.
(defn ul-form-name [(f Code)] (-> (slice u8))
  (cond (not (and (primitive/code-list? f) (> (len f) 1))) ""
        (primitive/code-sym? (get f 1)) (primitive/code-sym (get f 1))
        (and (> (len f) 2) (primitive/code-vector? (get f 1))) (ul-sym-text (get f 2))
        :else ""))

;;; The struct or sum a checked type names through any number of `ptr`/`mut`/`ref`
;;; wrappers, qualified: `ui.P` for `(ref ui.P)`, `coil.arraylist.ArrayList` for
;;; `(coil.arraylist.ArrayList i64)`.
(defn ul-nominal-of [(t Code)] (-> (slice u8))
  (cond (primitive/code-sym? t) (primitive/code-sym t)
        (and (primitive/code-list? t) (= (len t) 2)
             (or (= (ul-head-text t) "ptr") (= (ul-head-text t) "mut") (= (ul-head-text t) "ref")))
          (ul-nominal-of (get t 1))
        (and (primitive/code-list? t) (> (len t) 0)) (ul-head-text t)
        :else ""))

;;; The global a symbol resolved to, as written, or "".
(defn ul-global [(node Code)] (-> (slice u8))
  (match (meta/source-binding node)
    (primitive/BindsGlobal [q] (primitive/code-sym q))
    (_ "")))

;;; Delete NODE as a fix of its own: one that cannot be applied must not hold the
;;; rest back, and the rest must not hold it back.
(defn ul-delete-alone [(node Code) (message (slice u8))] (-> i64)
  (primitive/suggest-transaction)
  (primitive/delete node message)
  (primitive/suggest-transaction)
  0)

; ── the program ────────────────────────────────────────────────────────────────

;;; The user's modules, and every definition they declare, by qualified name.
(defn ul-own! [(sources Code)
               (modules (mut (HashMap (slice u8) i64)))
               (owned (mut (HashMap (slice u8) i64)))] (-> i64)
  (for record (iter sources)
    (let [m (get record 0)]
      (set! (mut modules) (primitive/code-sym m) 1)
      (for d (iter (ul-answer (meta/definitions m)))
        (set! (mut owned) (primitive/code-sym d) 1))))
  0)

;;; Does module M declare an `export` list?
(defn ul-has-export-list? [(m Code)] (-> bool)
  (block :found
    (for f (iter (ul-answer (meta/module-header m)))
      (when (= (ul-head-text f) "export") (return-from :found true)))
    false))

;;; The executable reading roots `main` and the explicit exports; the library
;;; reading roots every definition of a module without an export list. `auto`
;;; (default) reads the shape; `exports` and `public` pin it.
(defn ul-library? [(probe Code)] (-> bool)
  (let [mode (primitive/lint-param "unused-roots" "auto")]
    (cond (= mode "exports") false
          (= mode "public") true
          :else (match (meta/definition-kind `main)
                  (primitive/KindIs [_] false)
                  (_ true)))))

; ── definitions ────────────────────────────────────────────────────────────────
; Marking from roots over the compiler's declaration graph. A pair of mutually
; recursive dead functions keep each other alive under a mention count; from the
; roots, neither is reached.
;
; ROOTS: `main`; every test, which `coil test` calls from outside the program the
; way the runtime calls `main` — `deftest` and `defprop` mint `coil-test$NAME`
; (assert.coil, prop.coil) and the harness finds them by that prefix; and what
; each user module uses at top level (`meta/module-uses`). Without the tests a
; whole-project run proposed deleting a function and the only test of it in the
; same round, which compiles precisely because both halves went.
;
; Marking expands the user's own names and the roots. A library declaration never
; depends on one of the program's, so the toolchain's part of the graph is left
; unwalked.

(defn ul-root! [(name (slice u8)) (queue (mut (HashMap (slice u8) i64)))] (-> i64)
  (set! (mut queue) name 1)
  0)

(defn ul-roots! [(sources Code)
                 (owned (mut (HashMap (slice u8) i64)))
                 (library bool)
                 (roots (mut (HashMap (slice u8) i64)))] (-> i64)
  (match (meta/definition-kind `main)
    (primitive/KindIs [_] (ul-root! "main" (mut roots)))
    (_ 0))
  (for name (iter owned)
    (match (find name "coil-test$")
      (Some [_] (ul-root! name (mut roots)))
      (None [] 0)))
  (for record (iter sources)
    (let [m (get record 0)]
      (for u (iter (ul-answer (meta/module-uses m)))
        (ul-root! (primitive/code-sym u) (mut roots)))
      (when (and library (not (ul-has-export-list? m)))
        (for d (iter (ul-answer (meta/definitions m)))
          (ul-root! (primitive/code-sym d) (mut roots))))
      0))
  0)

;;; Mark everything reachable from ROOTS into LIVE.
(defn ul-mark! [(probe Code)
                (a (dyn alloc/Allocator))
                (modules (mut (HashMap (slice u8) i64)))
                (owned (mut (HashMap (slice u8) i64)))
                (roots (mut (HashMap (slice u8) i64)))
                (live (mut (HashMap (slice u8) i64)))] (-> i64)
  (let [(mut queue) (ArrayList::new [(slice u8)] a)
        (mut at) 0]
    (for r (iter roots)
      (unless (contains? live r)
        (set! (mut live) r 1)
        (push! (mut queue) r) 0))
    (loop
      (when (>= at (len queue)) (break))
      (let [name (get queue at)]
        (set! at (+ at 1))
        (for d (iter (ul-answer (meta/dependencies (primitive/code-symbol name))))
          (let [dn (primitive/code-sym d)]
            (when (and (not (contains? live dn))
                       (or (contains? owned dn) (contains? modules (ul-module-of dn))))
              (set! (mut live) dn 1)
              (push! (mut queue) dn) 0)))))
    0))

;;; A core form that declares the name after its head. `do` is walked into: a macro
;;; splices several definitions into one.
(defn ul-defining? [(f Code)] (-> bool)
  (let [h (ul-head-text f)]
    (or (= h "defn*") (= h "defstruct") (= h "defsum") (= h "deftrait") (= h "const")
        (= h "def") (= h "extern") (= h "defalias") (= h "declare"))))

;;; Where F was written: its file, line and column. A definition a macro made is
;;; written where the macro was called, so this is the call the author wrote.
(defn ul-position [(f Code) (a (dyn alloc/Allocator))] (-> (slice u8))
  (let [(mut sb) (StrBuf::new a)]
    (push-str! (mut sb) (primitive/code-file f))
    (push-str! (mut sb) ":")
    (push-i64! (mut sb) (primitive/code-line f))
    (push-str! (mut sb) ":")
    (push-i64! (mut sb) (primitive/code-col f))
    (str sb)))

;;; Sort each definition the expanded form F makes in MODULE by where it was
;;; written: DEAD when the program owns it and did not reach it, LIVE otherwise.
(defn ul-place-definitions! [(f Code)
                             (module (slice u8))
                             (a (dyn alloc/Allocator))
                             (owned (mut (HashMap (slice u8) i64)))
                             (live (mut (HashMap (slice u8) i64)))
                             (dead-at (mut (HashMap (slice u8) i64)))
                             (live-at (mut (HashMap (slice u8) i64)))] (-> i64)
  (cond (= (ul-head-text f) "do")
          (do (for e (iter (primitive/code-slice f 1 (len f)))
                (ul-place-definitions! e module a (mut owned) (mut live) (mut dead-at) (mut live-at)))
              0)
        (ul-defining? f)
          (let [q (ul-qualify a module (ul-form-name f))
                at (ul-position f a)]
            (if (and (contains? owned q) (not (contains? live q)))
                (set! (mut dead-at) at 1)
                (set! (mut live-at) at 1))
            0)
        :else 0))

;;; Delete each authored form whose definitions the program owns and none of which
;;; it reached. The names come from the expanded program, where every definition is
;;; a core form whatever macro wrote it, and the form deleted is the one the author
;;; wrote at the same place: a `defn`, or the call of a macro that defined it.
(defn ul-report-definitions [(modules Code)
                             (sources Code)
                             (a (dyn alloc/Allocator))
                             (user (mut (HashMap (slice u8) i64)))
                             (owned (mut (HashMap (slice u8) i64)))
                             (live (mut (HashMap (slice u8) i64)))] (-> i64)
  (let [(mut dead-at) (ul-names a)
        (mut live-at) (ul-names a)]
    (for m (iter modules)
      (let [module (ul-sym-text (get m 0))]
        (when (contains? user module)
          (for f (iter (primitive/code-slice m 1 (len m)))
            (ul-place-definitions! f module a (mut owned) (mut live) (mut dead-at) (mut live-at)))
          0)))
    (for record (iter sources)
      (for f (iter (primitive/code-slice record 1 (len record)))
        (let [at (ul-position f a)]
          (when (and (contains? dead-at at) (not (contains? live-at at))
                     (primitive/code-from-user? f))
            (primitive/delete f "unused: nothing reachable from this program's roots refers to this")
            0)))))
  0)

; ── unused sum variants ────────────────────────────────────────────────────────
; A variant nothing ever CONSTRUCTS, together with the `match` arms that handle it.
;
; The declaration graph cannot tell the two apart — a `match` that handles a
; variant depends on it exactly as a construction does — so this asks for
; constructions alone. An authored construction is a reference the compiler
; resolved to the variant; a pattern is no reference at all. A construction a macro
; generated is a call the checker resolved to the variant (`code-decl`), asked only
; of generated code and never of a pattern.
;
; Deleting the variant alone would leave arms referring to a variant that no longer
; exists, so the arms go with it. That is not a behaviour change: an arm for a variant
; nothing constructs cannot run, and exhaustiveness still holds over what remains.
; An arm is matched to its variant through the checked type of the `match`'s
; scrutinee, which names the sum and so the module its variants are declared in.
;
; SKIPPED ENTIRELY under the library reading. A library's variants are its API — its
; callers construct them and are not present to be seen.

(defn ul-construction-role? [(role Code)] (-> bool)
  (or (= role `:call) (= role `:value) (= role `:fnptr)))

;;; Authored constructions: references in the user's modules that resolved to a
;;; declaration as a value or call.
(defn ul-authored-constructions! [(sources Code) (built (mut (HashMap (slice u8) i64)))] (-> i64)
  (for record (iter sources)
    (match (meta/references (get record 0))
      (primitive/SourceIs [refs]
        (for r (iter refs)
          (when (ul-construction-role? (meta/reference-role r))
            (let [q (ul-global (meta/reference-node r))]
              (when (> (len q) 0) (set! (mut built) q 1) 0)))
          0))
      (primitive/SourceUnavailable [] 0)))
  0)

;;; Generated constructions in F: a generated call the checker resolved to a
;;; variant. A `match` arm's pattern is not walked, nor a `defsum`'s declarations.
(defn ul-generated-constructions! [(f Code) (built (mut (HashMap (slice u8) i64)))] (-> i64)
  (when (or (primitive/code-list? f) (primitive/code-vector? f))
    (let [head (ul-head-text f)]
      (cond (= head "defsum") 0
            (and (= head "match") (> (len f) 1))
              (do
                (ul-generated-constructions! (get f 1) (mut built))
                (for arm (iter (primitive/code-slice f 2 (len f)))
                  (if (and (primitive/code-list? arm) (> (len arm) 0))
                      (for e (iter (primitive/code-slice arm 1 (len arm)))
                        (ul-generated-constructions! e (mut built)))
                      0))
                0)
              :else
              (do
                (when (and (primitive/code-list? f) (primitive/code-macro? f))
                  (match (primitive/code-decl f)
                    (primitive/Declared [_ kind name _]
                      (match kind
                        (primitive/VariantDecl [] (do (set! (mut built) (primitive/code-sym name) 1) 0))
                        (_ 0)))
                    (_ 0))
                  0)
                (for e (iter f) (ul-generated-constructions! e (mut built)))
                0))))
  0)

;;; Delete every arm of a `match` in F that handles a variant in DEAD.
(defn ul-dead-arms [(f Code) (a (dyn alloc/Allocator)) (dead (mut (HashMap (slice u8) i64)))] (-> i64)
  (when (or (primitive/code-list? f) (primitive/code-vector? f))
    (when (and (= (ul-head-text f) "match") (> (len f) 1))
      (match (primitive/type-of (get f 1))
        (primitive/TypeIs [t]
          (let [module (ul-module-of (ul-nominal-of t))]
            (for arm (iter (primitive/code-slice f 2 (len f)))
              (let [v (ul-head-text arm)]
                (when (and (> (len v) 0) (> (len module) 0)
                           (contains? dead (ul-qualify a module v)))
                  (primitive/delete arm "unused: nothing constructs this variant, so this arm cannot run")
                  0)))))
        (primitive/TypeUnknown [] 0))
      0)
    (for e (iter f) (ul-dead-arms e a (mut dead))))
  0)

(defn ul-variants [(modules Code)
                   (sources Code)
                   (a (dyn alloc/Allocator))
                   (user (mut (HashMap (slice u8) i64)))
                   (live (mut (HashMap (slice u8) i64)))] (-> i64)
  (let [(mut built) (ul-names a)
        (mut dead) (ul-names a)]
    (ul-authored-constructions! sources (mut built))
    (for m (iter modules)
      (when (contains? user (ul-sym-text (get m 0)))
        (for f (iter (primitive/code-slice m 1 (len m))) (ul-generated-constructions! f (mut built))))
      0)
    (for record (iter sources)
      (let [module (primitive/code-sym (get record 0))]
        (for f (iter (primitive/code-slice record 1 (len record)))
          ; a sum keeps its last variant: an empty `defsum` is a different type, not
          ; a smaller one; and a sum that is going takes its variants with it
          (when (and (= (ul-head-text f) "defsum") (> (len f) 3)
                     (primitive/code-from-user? f)
                     (contains? live (ul-qualify a module (ul-form-name f))))
            (for v (iter (primitive/code-slice f 2 (len f)))
              ; a generic sum's parameter vector `[T]` is no variant
              (let [vn (if (primitive/code-vector? v) "" (ul-head-text v))]
                (when (> (len vn) 0)
                  (let [q (ul-qualify a module vn)]
                    (unless (contains? built q)
                      (primitive/delete v "unused: nothing constructs this variant")
                      (set! (mut dead) q 1) 0)))
                0)))
          0)))
    (for m (iter modules)
      (when (contains? user (ul-sym-text (get m 0)))
        (for f (iter (primitive/code-slice m 1 (len m)))
          (when (primitive/code-from-user? f) (ul-dead-arms f a (mut dead)) 0)))
      0))
  0)

; ── unused imports ─────────────────────────────────────────────────────────────
; An import is used when the module refers to something through it, or depends on
; something its module declares, or the import itself does something:
;
;   * a reference resolved through it — the compiler records the facade every
;     authored reference went through (`meta/references-through`);
;   * a dependency of one of the module's definitions, or of its top-level uses, on
;     a declaration of the imported module — that covers what no reference names:
;     an impl's method (a trait call, an `=` on slices), a convention, a macro's
;     expansion;
;   * an AMBIENT effect: the imported module registers a checker or transform, or
;     does anything else at top level beyond publishing its exports and impls —
;     "a dialect is a single import" is exactly an import nothing refers to.
;
; A `:use [a b]` item is used when a reference resolved through the import under
; its exported name, or the module depends on the declaration it names. An import
; that `:reexport`s publishes its names to the module's importers, and using them
; here was never the point, so it is never judged.

;;; Everything module M's definitions and top-level uses depend on.
(defn ul-module-dependencies! [(m Code) (deps (mut (HashMap (slice u8) i64)))] (-> i64)
  (for u (iter (ul-answer (meta/module-uses m)))
    (set! (mut deps) (primitive/code-sym u) 1)
    (for d (iter (ul-answer (meta/dependencies u))) (set! (mut deps) (primitive/code-sym d) 1)))
  (for n (iter (ul-answer (meta/definitions m)))
    (for d (iter (ul-answer (meta/dependencies n))) (set! (mut deps) (primitive/code-sym d) 1)))
  0)

;;; Does the module T do anything at top level beyond publishing its exports and
;;; providing impls: a use of one of its own definitions that its export list does
;;; not explain — a registered checker or transform, an assertion, a top-level
;;; macro call.
(defn ul-ambient? [(t Code) (a (dyn alloc/Allocator))] (-> bool)
  (let [module (primitive/code-sym t)
        (mut exported) (ul-names a)
        (mut declared) (ul-names a)]
    (for f (iter (ul-answer (meta/module-header t)))
      (when (= (ul-head-text f) "export")
        (for n (iter (primitive/code-slice f 1 (len f)))
          (when (primitive/code-sym? n)
            (set! (mut exported) (ul-qualify a module (primitive/code-sym n)) 1) 0)))
      0)
    (for d (iter (ul-answer (meta/definitions t)))
      (set! (mut declared) (primitive/code-sym d) 1))
    (block :found
      (for u (iter (ul-answer (meta/module-uses t)))
        (let [q (primitive/code-sym u)]
          (when (and (contains? declared q) (not (contains? exported q)))
            (return-from :found true))))
      false)))

;;; Does the module depend on something T declares or provides?
(defn ul-depends-on-module? [(t Code) (deps (mut (HashMap (slice u8) i64)))] (-> bool)
  (let [module (primitive/code-sym t)]
    (block :found
      (for d (iter deps)
        (when (= (ul-module-of d) module) (return-from :found true)))
      (for u (iter (ul-answer (meta/module-uses t)))
        (when (contains? deps (primitive/code-sym u)) (return-from :found true)))
      false)))

;;; The element after keyword KW in import form F, or `()`.
(defn ul-import-arg [(f Code) (kw Code)] (-> Code)
  (block :found
    (for [i 1 (- (len f) 1)]
      (when (= (get f i) kw) (return-from :found (get f (+ i 1)))))
    `()))

(defn ul-import-has? [(f Code) (kw Code)] (-> bool)
  (block :found
    (for e (iter f) (when (= e kw) (return-from :found true)))
    false))

;;; The exported names references resolved under through IMPORT.
(defn ul-through-names! [(import Code) (through (mut (HashMap (slice u8) i64)))] (-> i64)
  (match (meta/references-through import)
    (primitive/SourceIs [refs]
      (for r (iter refs)
        (set! (mut through) "" 1)
        (match (meta/reference-exported-name r)
          (Some [n] (do (set! (mut through) (primitive/code-sym n) 1) 0))
          (None [] 0)))
      0)
    (primitive/SourceUnavailable [] 0))
  0)

(defn ul-report-import [(import Code)
                        (a (dyn alloc/Allocator))
                        (deps (mut (HashMap (slice u8) i64)))] (-> i64)
  (let [node (meta/import-node import)
        target (meta/import-target import)
        module (primitive/code-sym target)
        use-spec (ul-import-arg node `:use)
        (mut through) (ul-names a)]
    (ul-through-names! import (mut through))
    (unless (or (not (primitive/code-from-user? node)) (ul-import-has? node `:reexport))
      (if (or (> (len through) 0) (ul-depends-on-module? target (mut deps)) (ul-ambient? target a))
          ; used: drop the `:use` items that are not
          (when (primitive/code-vector? use-spec)
            (for e (iter use-spec)
              (when (primitive/code-sym? e)
                (let [n (primitive/code-sym e)]
                  (unless (or (contains? through n) (contains? deps (ul-qualify a module n)))
                    (ul-delete-alone e "unused: nothing in the module refers to this imported name"))))
              0)
            0)
          (ul-delete-alone node "unused: this import binds nothing the module refers to"))
      0))
  0)

(defn ul-imports [(sources Code) (a (dyn alloc/Allocator))] (-> i64)
  (for record (iter sources)
    (let [m (get record 0)
          (mut deps) (ul-names a)]
      (ul-module-dependencies! m (mut deps))
      (match (meta/imports m)
        (primitive/SourceIs [imports]
          (for import (iter imports) (ul-report-import import a (mut deps))))
        (primitive/SourceUnavailable [] 0))))
  0)

; ── unused let bindings ────────────────────────────────────────────────────────
; `(let [k v …] body…)` where nothing reads `k`. Two conditions, and the second is
; the one that decides how much of this is safe to do at all:
;
;   * No read resolves to the local `k` introduces. The compiler answers both: the
;     binder's identity, and the identity each authored read resolved to, so a
;     shadowing `k` or a global named `k` is a different local, not a read.
;   * `v` cannot have an effect. A binding is only dead weight if evaluating its
;     initializer was pointless; `(let [x (write! …)] …)` still has to run the write.
;     Purity is not decidable here, so this asks for a PROOF from a small whitelist
;     — a literal, a local, a stack/static reservation, a size query, a cast or a
;     field or load of something already proven pure — and refuses everything else.
;     A call is assumed to have effects. The whitelist is of primitives, by the
;     qualified name the head resolved to.
;
; The binding is two adjacent nodes and both go, as two deletions of the same round.

(defn ul-pure-primitive? [(q (slice u8))] (-> bool)
  (or (= q "coil.primitive.alloc-stack") (= q "coil.primitive.alloc-static")
      (= q "coil.primitive.sizeof") (= q "coil.primitive.alignof")
      (= q "coil.primitive.offsetof") (= q "coil.primitive.cast")
      (= q "coil.primitive.field") (= q "coil.primitive.load")))

;;; Evaluating E provably cannot do anything but produce a value.
(defn ul-pure? [(e Code)] (-> bool)
  (cond (not (primitive/code-list? e)) true
        (= (len e) 0) true
        :else
          (let [head (get e 0)
                spelled (ul-sym-text head)]
            (cond
              ; `(.field e)`: a field read, pure when its base is
              (and (> (len spelled) 1) (= (primitive/cast i64 (get spelled 0)) 46) (= (len e) 2))
                (ul-pure? (get e 1))
              (ul-pure-primitive? (ul-global head))
                (block :all
                  (for x (iter (primitive/code-slice e 1 (len e)))
                    (unless (ul-pure? x) (return-from :all false)))
                  true)
              :else false))))

;;; The local identity BINDER introduces, or "" when the compiler recorded none.
(defn ul-binder-id [(binder Code)] (-> (slice u8))
  (let [name (cond (primitive/code-sym? binder) binder
                   (and (primitive/code-list? binder) (= (len binder) 2)) (get binder 1)
                   :else `())]
    (if (primitive/code-sym? name)
        (match (meta/source-binding name)
          (primitive/BindsLocal [id] (meta/source id))
          (_ ""))
        "")))

(defn ul-let? [(f Code)] (-> bool)
  (and (primitive/code-list? f) (> (len f) 1) (primitive/code-vector? (get f 1))
       (or (= (ul-global (get f 0)) "coil.binding.let") (= (ul-head-text f) "let*"))))

(defn ul-lets [(f Code) (reads (mut (HashMap (slice u8) i64)))] (-> i64)
  (when (or (primitive/code-list? f) (primitive/code-vector? f))
    (when (ul-let? f)
      (let [v (get f 1)]
        (for [i 0 (/ (len v) 2)]
          (let [b (get v (* i 2))
                init (get v (+ (* i 2) 1))
                id (ul-binder-id b)]
            (when (and (> (len id) 0) (not (contains? reads id)) (ul-pure? init))
              (primitive/delete b "unused: this binding is never read")
              (primitive/delete init "unused: this binding is never read")
              0)))))
    (for e (iter f) (ul-lets e (mut reads))))
  0)

(defn ul-lets-program [(sources Code) (a (dyn alloc/Allocator))] (-> i64)
  (for record (iter sources)
    (let [(mut reads) (ul-names a)]
      (match (meta/references (get record 0))
        (primitive/SourceIs [refs]
          (for r (iter refs)
            (match (meta/reference-binding r)
              (primitive/BindsLocal [id] (do (set! (mut reads) (meta/source id) 1) 0))
              (_ 0))))
        (primitive/SourceUnavailable [] 0))
      (for f (iter (primitive/code-slice record 1 (len record)))
        (when (primitive/code-from-user? f) (ul-lets f (mut reads)) 0))))
  0)

; ── unused struct fields ───────────────────────────────────────────────────────
; A `defstruct` field that nothing ever reads, writes, or takes the offset of.
;
; ⚠ THIS IS THE ONE DELETION THE COMPILE GATE CANNOT CHECK. Removing a function or
; an import that something needed stops the build, and `--fix` reverts the round.
; Removing a FIELD changes the struct's size and every later field's offset, and a
; program that only ever crossed that layout to C, or memcpy'd it, or hashed its
; bytes, still compiles — and is now wrong at run time. So the guards here are
; deliberately heavier than anywhere else in this file, and a field is deleted only
; when the layout provably belongs to Coil alone:
;
;   * No `extern` depends on the struct. That is the edge across which a layout
;     stops being ours to change.
;   * The struct is never either end of a POINTER CAST. This is the guard the other
;     ones do not imply, and `src/apps/clox` is why it exists. It does C-style
;     struct inheritance: every heap object begins with an `(obj Obj)` header, and
;     code reaches that header by casting `(ptr ObjString)` to `(ptr Obj)` rather
;     than by naming the field. Nothing does `(field s obj)`, so the header looked
;     dead in all eight object types; deleting it compiled cleanly and took the VM
;     from 246 passing tests to 246 failing ones. A struct that is cast through is a
;     struct whose layout something is relying on.
;   * The checker typed the base of EVERY field access in the program. One access
;     it could not type might be of any struct, so then no field is judged at all.
;   * A `cimport`ed struct is generated, not written, so `cop-record-fix` refuses to
;     edit it before any of this is consulted.
;
; Uses are collected across the WHOLE program — bundled code included, which reads
; the user's structs through generic and derived helpers — and keyed by the
; struct's qualified name, so two modules' `P` are two structs.
;
; Even with all of that, this pass is OFF unless you ask for it:
; `--lint-param unused-fields=on`. The guards above are a list of the layout
; escapes anyone has thought of, and a list like that is never finished — a
; `(ptr u8)` round trip, a `mem-cmp` over a struct's bytes, and a hand-written
; offset all defeat it, and all of them fail at run time rather than at build time.
; Every other deletion in this file is checked by the compiler before it is kept;
; this one is not, so it is the one you opt into.


;;; `Struct/field`, a key no qualified name can collide with.
(defn ul-field-key [(a (dyn alloc/Allocator)) (struct (slice u8)) (field (slice u8))] (-> (slice u8))
  (let [(mut sb) (StrBuf::new a)]
    (push-str! (mut sb) struct)
    (push-str! (mut sb) "/")
    (push-str! (mut sb) field)
    (str sb)))

;;; Record what F reads: field uses as `Struct/field`, cast-through structs by
;;; name, and "" when an access's base has no checked type. A quasiquoted template
;;; is data, not code — its expansions are typed where they land — so only what is
;;; outside every template, or unquoted back out of one, is read. DEPTH counts the
;;; templates F is inside.
(defn ul-fields-walk [(f Code) (depth i64) (a (dyn alloc/Allocator)) (uses (mut (HashMap (slice u8) i64)))] (-> i64)
  (let [head (ul-head-text f)]
    (cond (and (= depth 0) (= head "quote")) 0
          (= head "quasiquote")
            (do (for e (iter f) (ul-fields-walk e (+ depth 1) a (mut uses))) 0)
          (and (> depth 0) (or (= head "unquote") (= head "unquote-splicing")))
            (do (for e (iter f) (ul-fields-walk e (- depth 1) a (mut uses))) 0)
          (> depth 0)
            (do (when (or (primitive/code-list? f) (primitive/code-vector? f))
                  (for e (iter f) (ul-fields-walk e depth a (mut uses))))
                0)
          :else (ul-field-uses! f a (mut uses)))))

(defn ul-field-uses! [(f Code) (a (dyn alloc/Allocator)) (uses (mut (HashMap (slice u8) i64)))] (-> i64)
  (when (or (primitive/code-list? f) (primitive/code-vector? f))
    (when (and (primitive/code-list? f) (> (len f) 1))
      (let [head (ul-head-text f)
            accessor (and (= (len f) 2) (> (len head) 1) (= (primitive/cast i64 (get head 0)) 46))]
        (cond accessor (ul-field-use! (get f 1) (subslice head 1 (len head)) a (mut uses))
              (and (> (len f) 2) (or (= head "field") (= head "primitive/field")))
                (ul-field-use! (get f 1) (ul-sym-text (get f 2)) a (mut uses))
              (and (> (len f) 2) (or (= head "offsetof") (= head "primitive/offsetof")))
                (match (primitive/type-of (get f 1))
                  (primitive/TypeIs [t] (do (set! (mut uses) (ul-field-key a (ul-nominal-of t) (ul-sym-text (get f 2))) 1) 0))
                  (primitive/TypeUnknown [] (do (set! (mut uses) "" 1) 0)))
              (and (> (len f) 2) (or (= head "cast") (= head "primitive/cast")))
                (do
                  (match (primitive/type-of f)
                    (primitive/TypeIs [t] (do (set! (mut uses) (ul-nominal-of t) 1) 0))
                    (primitive/TypeUnknown [] 0))
                  (match (primitive/type-of (get f 2))
                    (primitive/TypeIs [t] (do (set! (mut uses) (ul-nominal-of t) 1) 0))
                    (primitive/TypeUnknown [] 0))
                  0)
              :else 0)))
    (for e (iter f) (ul-fields-walk e 0 a (mut uses))))
  0)

(defn ul-field-use! [(base Code) (field (slice u8)) (a (dyn alloc/Allocator))
                     (uses (mut (HashMap (slice u8) i64)))] (-> i64)
  (match (primitive/type-of base)
    (primitive/TypeIs [t] (do (set! (mut uses) (ul-field-key a (ul-nominal-of t) field) 1) 0))
    (primitive/TypeUnknown [] (do (set! (mut uses) "" 1) 0))))

;;; Does an `extern` depend on the struct Q?
(defn ul-crosses-abi? [(q Code)] (-> bool)
  (block :found
    (for d (iter (ul-answer (meta/dependents q)))
      (match (meta/definition-kind d)
        (primitive/KindIs [k] (match k (primitive/Extern [] (return-from :found true)) (_ 0)))
        (_ 0)))
    false))

(defn ul-fields [(modules Code) (sources Code) (a (dyn alloc/Allocator))] (-> i64)
  (when (= (primitive/lint-param "unused-fields" "off") "on")
    (let [(mut uses) (ul-names a)]
      (for m (iter modules)
        (for f (iter (primitive/code-slice m 1 (len m)))
          (ul-fields-walk f 0 a (mut uses))))
      (unless (contains? uses "")
        (for record (iter sources)
          (let [module (primitive/code-sym (get record 0))]
            (for f (iter (primitive/code-slice record 1 (len record)))
              (when (and (= (ul-head-text f) "defstruct") (primitive/code-from-user? f))
                (let [q (ul-qualify a module (ul-form-name f))]
                  (unless (or (contains? uses q) (ul-crosses-abi? (primitive/code-symbol q)))
                    (for v (iter f)
                      ; a one-field struct keeps its field: an empty `defstruct` is a
                      ; different type, not a smaller one
                      (when (and (primitive/code-vector? v) (> (len v) 1))
                        (for b (iter v)
                          (when (and (primitive/code-list? b) (> (len b) 0) (primitive/code-sym? (get b 0)))
                            (unless (contains? uses (ul-field-key a q (primitive/code-sym (get b 0))))
                              (primitive/delete b "unused: this field is never read or written")
                              0)
                            0))
                        0))
                    0)))
                0))))
      0))
  0)

; ── the checker ────────────────────────────────────────────────────────────────
(defn unused-code [(modules Code)] (-> Code)
  (let [a (alloc/malloc-allocator)
        sources (ul-sources)
        library (ul-library? `main)
        (mut user) (ul-names a)
        (mut owned) (ul-names a)
        (mut roots) (ul-names a)
        (mut live) (ul-names a)]
    (ul-own! sources (mut user) (mut owned))
    (ul-roots! sources (mut owned) library (mut roots))
    (ul-mark! `main a (mut user) (mut owned) (mut roots) (mut live))
    (ul-report-definitions modules sources a (mut user) (mut owned) (mut live))
    (unless library (ul-variants modules sources a (mut user) (mut live)) 0)
    (ul-imports sources a)
    (ul-lets-program sources a)
    (ul-fields modules sources a)
    `0))

(checker unused-code)
