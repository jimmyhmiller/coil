(module coil.lint.unused)
(import "coil.primitive" :as primitive)
(import "coil.alloc" :as alloc)
(import "coil.slice" :use *)
(import "coil.str" :use *)
(import "coil.arraylist" :use *)
(import "coil.hashmap" :use *)
(import "coil.io" :use *)

; Dead-code elimination for SOURCE. Every top-level definition the program cannot
; reach from its roots is reported, and `coil lint --fix` deletes it outright,
; comment block and all, repeating until nothing more is unreachable.
;
; This is deliberately NOT part of `coil.lint.default`. Every other bundled rule
; rewrites a form into an equivalent one; this one removes code, and no analysis
; that reads only the compilation unit in front of it can know that nothing outside
; that unit wanted it. It is opt-in, per invocation:
;
;   coil lint app.coil --use coil.lint.unused          report what is unreachable
;   coil lint app.coil --use coil.lint.unused --diff   show the deletions
;   coil lint app.coil --use coil.lint.unused --fix    make them
;
; Follow `--fix` with `coil fmt --write`. Deletions are byte-exact and leave the
; whitespace their neighbours were laid out around — a blank line at a seam, an
; indent where a `let` binding used to be. The formatter closes those; nothing else
; needs to.
;
; ── the analysis ───────────────────────────────────────────────────────────────
; Reachability over a name graph, not a per-definition "is this name mentioned
; anywhere" count. The distinction matters: a mention-counting pass keeps every
; recursive function alive on its own recursive call, and keeps a pair of mutually
; recursive dead functions alive on each other. Marking from roots does not.
;
; A node is a BARE name — the symbol with any `alias/` qualifier stripped — so a
; definition and every way of referring to it across modules collapse to one node.
; That deliberately over-approximates: two modules that both define `helper` share a
; node, and a local variable named after a global marks that global used. Both errors
; run in the KEEP direction, which is the only direction a deleting tool may err in.
;
; ROOTS are `main` plus every name mentioned by a top-level form that is not itself a
; named definition — `impl`, `meta`, `static-assert`, and, the one that carries the
; policy, `export` / `export-c`. Nothing special is needed to make an export a root:
; the export form names the thing, so walking it marks the name.
;
; ── EXECUTABLE OR LIBRARY ──────────────────────────────────────────────────────
; That is not enough on its own, because in Coil `export` is optional and a module
; without one exposes EVERYTHING (docs/reference/NAMESPACING.md: "default: all
; public"). Read literally, "explicit exports are the roots" would mean a module that
; declares no exports has no roots — and linting `src/compiler/astdump.coil` on its
; own proposed deleting 110 of its definitions, every one of them called from the
; compiler that this compilation unit does not contain.
;
; So the unit's SHAPE decides, which is the same distinction the language already
; makes with `main`:
;
;   * The program defines `main` — it is an EXECUTABLE. Its modules are that
;     program's private implementation, nothing outside links against them, and
;     reachability from `main` is the whole truth. Unreachable is dead.
;   * The program defines no `main` — it is a LIBRARY. Its callers are not here to
;     be seen. A module that declares an export list is taken at its word and only
;     those names are rooted; a module that declares none exposes all of its
;     definitions, so all of them are rooted and nothing in it is provably dead.
;
; `--lint-param unused-roots=VALUE` overrides the choice: `exports` forces the
; executable reading (root only `main` and explicit exports — this is what to use to
; clean out a library's own internals, when you know who the callers are), `public`
; forces the library reading, and the default `auto` picks by the rule above.
;
; The whole program is scanned, imports and bundled stdlib included, but only forms
; in the user's own files are ever proposed for deletion — `code-from-user?` here,
; and the compiler's own filter in `cop-record-fix` behind it.

;;; One top-level definition, and the slice of `edges` holding the names its body
;;; mentions. `next` chains definitions that share a bare name (different modules may).
(defstruct UlDef
  [(name (slice u8))
   (mi i64)
   (fi i64)
   (estart i64)
   (ecount i64)
   (next i64)])

(defstruct UlState
  [(defs (ptr (ArrayList UlDef)))
   (edges (ptr (ArrayList (slice u8))))
   (byname (ptr (HashMap (slice u8) i64)))
   (roots (ptr (ArrayList (slice u8))))
   (reach (ptr (HashMap (slice u8) i64)))])

; ── names ──────────────────────────────────────────────────────────────────────

;;; The last `/`-separated component: `alias/foo`, `coil.alloc/foo` and `foo` all name
;;; the node `foo`. Qualifiers vary with the importer's spelling, bare names do not.
(defn ul-bare [(s (slice u8))] (-> (slice u8))
  (let [n (slice-len s)
        (mut cut) 0
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (when (= (primitive/cast i64 (slice-get s (load i))) (primitive/cast i64 47))
                  (store! cut (primitive/iadd (load i) 1))
                  0)
                (store! i (primitive/iadd (load i) 1)))))
    (subslice s (load cut) n)))

(defn ul-head-is? [(f Code) (name Code)] (-> bool)
  (if (primitive/code-list? f)
      (if (> (primitive/code-count f) 0)
          (primitive/code-eq (primitive/code-nth f 0) name)
          false)
      false))

;;; The symbol at index `i`, as text, or "" when that element is not a symbol.
(defn ul-name-at [(f Code) (i i64)] (-> (slice u8))
  (if (> (primitive/code-count f) i)
      (let [e (primitive/code-nth f i)]
        (if (primitive/code-sym? e) (primitive/code-sym e) ""))
      ""))

; ── walking: what does a form MENTION? ─────────────────────────────────────────
; Every symbol counts as a mention except the ones that are the definition being
; introduced: a form must not keep itself alive. That is why each definition head
; gets its own walk instead of one generic recursion — the positions to skip are the
; binder positions, and only the grammar knows where those are.
(defn ul-mention! [(st (ptr UlState)) (s Code)] (-> i64)
  (when (primitive/code-sym? s)
    (al-push! [(slice u8)] (load (field st edges)) (ul-bare (primitive/code-sym s)))
    0)
  0)

(defn ul-walk [(st (ptr UlState)) (f Code)] (-> i64)
  (if (primitive/code-list? f)
      (ul-walk-kids st f 0 (primitive/code-count f))
      (if (primitive/code-vector? f)
          (ul-walk-kids st f 0 (primitive/code-count f))
          (ul-mention! st f))))

(defn ul-walk-kids [(st (ptr UlState)) (f Code) (i i64) (n i64)] (-> i64)
  (if (>= i n)
      0
      (do
        (ul-walk st (primitive/code-nth f i))
        (ul-walk-kids st f (primitive/iadd i 1) n))))

;;; A binder vector `[(name Type) …]`: the names are being INTRODUCED, the types are
;;; mentions. Anything else in the vector (a generic parameter list `[K V]`) is walked
;;; whole — treating `K` as a mention only ever keeps something alive.
(defn ul-walk-binders [(st (ptr UlState)) (v Code) (i i64) (n i64)] (-> i64)
  (if (>= i n)
      0
      (do
        (let [b (primitive/code-nth v i)]
          (if (primitive/code-list? b)
              (if (> (primitive/code-count b) 1)
                  (ul-walk-kids st b 1 (primitive/code-count b))
                  (ul-walk st b))
              (ul-walk st b)))
        (ul-walk-binders st v (primitive/iadd i 1) n))))

;;; `(V)` / `(V [(f T) …])` — a sum variant introduces its own name and its payload
;;; field names, and mentions the payload types.
(defn ul-walk-variant [(st (ptr UlState)) (v Code)] (-> i64)
  (if (primitive/code-list? v)
      (ul-walk-variant-kids st v 1 (primitive/code-count v))
      0))

(defn ul-walk-variant-kids [(st (ptr UlState)) (v Code) (i i64) (n i64)] (-> i64)
  (if (>= i n)
      0
      (do
        (let [e (primitive/code-nth v i)]
          (if (primitive/code-vector? e)
              (ul-walk-binders st e 0 (primitive/code-count e))
              (ul-walk st e)))
        (ul-walk-variant-kids st v (primitive/iadd i 1) n))))

(defn ul-walk-variants [(st (ptr UlState)) (f Code) (i i64) (n i64)] (-> i64)
  (if (>= i n)
      0
      (do
        (ul-walk-variant st (primitive/code-nth f i))
        (ul-walk-variants st f (primitive/iadd i 1) n))))

;;; `defstruct` tail: each vector is either a field list or a generic parameter list.
(defn ul-walk-struct-tail [(st (ptr UlState)) (f Code) (i i64) (n i64)] (-> i64)
  (if (>= i n)
      0
      (do
        (let [e (primitive/code-nth f i)]
          (if (primitive/code-vector? e)
              (ul-walk-binders st e 0 (primitive/code-count e))
              (ul-walk st e)))
        (ul-walk-struct-tail st f (primitive/iadd i 1) n))))

;;; Record every name a top-level form mentions, skipping the name it defines.
;;; Returns nothing; the caller reads `edges` between the marks it took.
(defn ul-scan-form [(st (ptr UlState)) (f Code)] (-> i64)
  (let [n (primitive/code-count f)]
    (cond (ul-head-is? f `defsum) (do (ul-walk-variants st f 2 n) 0)
          (ul-head-is? f `defstruct) (do (ul-walk-struct-tail st f 2 n) 0)
          (ul-head-is? f `deftrait)
          ; each method spec `(name [params] (-> R))` introduces the method name
          (do (ul-walk-variants st f 2 n) 0) :else
          ; defn / const / extern: element 1 is the name, the rest is ordinary code
          (do (ul-walk-kids st f 2 n) 0))))

; ── classifying a top-level form ───────────────────────────────────────────────

;;; The name a form defines, or "" when the form defines nothing deletable.
;;;
;;; `defcc` and `defannotation` are named but excluded: a convention is named in a
;;; `:cc` keyword and an annotation in its own keyword syntax, neither of which is a
;;; symbol this walk can see, so they would always look unreachable.
;;;
;;; A `defn` returning `Code` is excluded too, and for a sharper reason: checkers run
;;; on the EXPANDED program, where a macro's call sites have already been replaced by
;;; what they expanded into. A macro is therefore mentioned nowhere by the time this
;;; rule looks, and would be deleted out of a file that uses it on every line.
(defn ul-defined-name [(f Code)] (-> (slice u8))
  (if (primitive/code-list? f)
      (if (> (primitive/code-count f) 1)
          (cond (ul-head-is? f `defn) (if (ul-macro? f) "" (ul-name-at f 1))
                (ul-head-is? f `const) (ul-name-at f 1)
                (ul-head-is? f `extern) (ul-name-at f 1)
                (ul-head-is? f `defstruct) (ul-name-at f 1)
                (ul-head-is? f `defsum) (ul-name-at f 1)
                (ul-head-is? f `deftrait) (ul-name-at f 1)
                :else "")
          "")
      ""))

;;; Index of the `(-> RET)` element, or -1.
(defn ul-arrow-idx [(f Code) (i i64) (n i64)] (-> i64)
  (if (>= i n)
      -1
      (if (ul-head-is? (primitive/code-nth f i) `->)
          i
          (ul-arrow-idx f (primitive/iadd i 1) n))))

(defn ul-macro? [(f Code)] (-> bool)
  (let [ai (ul-arrow-idx f 0 (primitive/code-count f))]
    (if (< ai 0)
        false
        (let [arrow (primitive/code-nth f ai)]
          (if (> (primitive/code-count arrow) 1)
              (primitive/code-eq (primitive/code-nth arrow 1) `Code)
              false)))))

; ── building the graph ─────────────────────────────────────────────────────────
(defn ul-add-def! [(st (ptr UlState)) (name (slice u8)) (mi i64) (fi i64) (estart i64) (ecount i64)] (-> i64)
  (let [d (primitive/alloc-stack UlDef)
        idx (al-len [UlDef] (load (load (field st defs))))]
    (store! (field d name) name)
    (store! (field d mi) mi)
    (store! (field d fi) fi)
    (store! (field d estart) estart)
    (store! (field d ecount) ecount)
    (store! (field d next)
            (match (hm-get [(slice u8) i64] (load (load (field st byname))) name)
              (Some [prev] prev)
              (None [] -1)))
    (al-push! [UlDef] (load (field st defs)) (load d))
    (hm-put! (load (field st byname)) name idx)
    0))

(defn ul-collect-form [(st (ptr UlState)) (m Code) (mi i64) (fi i64)] (-> i64)
  (let [f (primitive/code-nth m fi)]
    ; `import` binds names, it does not use them; walking it would make every
    ; `:use [a b]` item look referenced from the import alone.
    (if (ul-head-is? f `import)
        0
        (let [start (al-len [(slice u8)] (load (load (field st edges))))
              name (ul-defined-name f)]
          (if (= (slice-len name) 0)
              (do (ul-walk st f) (ul-roots-from! st start))
              (let [count
                      (do
                        (ul-scan-form st f)
                        (primitive/isub (al-len [(slice u8)] (load (load (field st edges)))) start))]
                (ul-add-def! st name mi fi start count)
                ; A sum is referred to by its VARIANTS at least as often as by its own
                ; name — `(Red)` names no sum anywhere. Each variant therefore gets its
                ; own node over the same edge range, so constructing a variant both
                ; keeps the sum alive and marks the payload types it mentions.
                (if (ul-head-is? f `defsum)
                    (ul-alias-variants! st f 2 (primitive/code-count f) mi fi start count)
                    0)))))))

(defn ul-alias-variants! [(st (ptr UlState))
                          (f Code)
                          (i i64)
                          (n i64)
                          (mi i64)
                          (fi i64)
                          (start i64)
                          (count i64)] (-> i64)
  (if (>= i n)
      0
      (do
        (let [v (primitive/code-nth f i)]
          (if (primitive/code-list? v)
              (let [vn (ul-name-at v 0)]
                (if (= (slice-len vn) 0) 0 (ul-add-def! st vn mi fi start count)))
              0))
        (ul-alias-variants! st f (primitive/iadd i 1) n mi fi start count))))

;;; Everything a non-definition top-level form mentions is a root.
(defn ul-roots-from! [(st (ptr UlState)) (start i64)] (-> i64)
  (let [n (al-len [(slice u8)] (load (load (field st edges))))
        (mut i) start]
    (loop (if (>= (load i) n)
              (break)
              (do
                (al-push! [(slice u8)]
                          (load (field st roots))
                          (al-get [(slice u8)] (load (load (field st edges))) (load i)))
                (store! i (primitive/iadd (load i) 1)))))
    0))

(defn ul-collect-module [(st (ptr UlState)) (m Code) (mi i64) (fi i64) (n i64)] (-> i64)
  (if (>= fi n)
      0
      (do
        (ul-collect-form st m mi fi)
        (ul-collect-module st m mi (primitive/iadd fi 1) n))))

(defn ul-collect [(st (ptr UlState)) (ms Code) (mi i64) (n i64)] (-> i64)
  (if (>= mi n)
      0
      (do
        (let [m (primitive/code-nth ms mi)]
          (ul-collect-module st m mi 1 (primitive/code-count m)))
        (ul-collect st ms (primitive/iadd mi 1) n))))

; ── marking ────────────────────────────────────────────────────────────────────
; A worklist over `roots`, which doubles as the queue: names discovered while
; expanding a definition are pushed onto the same list the loop is walking.
(defn ul-mark [(st (ptr UlState))] (-> i64)
  (let [(mut i) 0]
    (loop (if (>= (load i) (al-len [(slice u8)] (load (load (field st roots)))))
              (break)
              (do
                (let [nm (al-get [(slice u8)] (load (load (field st roots))) (load i))]
                  (match (hm-get [(slice u8) i64] (load (load (field st reach))) nm)
                    (Some [_] 0)
                    (None []
                          (do
                            (hm-put! (load (field st reach)) nm 1)
                            (ul-expand st
                                       (match (hm-get [(slice u8) i64]
                                                      (load (load (field st byname)))
                                                      nm)
                                         (Some [d] d)
                                         (None [] -1)))))))
                (store! i (primitive/iadd (load i) 1)))))
    0))

;;; Enqueue everything the definitions named by this node mention.
(defn ul-expand [(st (ptr UlState)) (di i64)] (-> i64)
  (if (< di 0)
      0
      (let [d (primitive/alloc-stack UlDef)]
        (store! d (al-get [UlDef] (load (load (field st defs))) di))
        (let [start (load (field d estart))
              stop (primitive/iadd start (load (field d ecount)))
              (mut i) start]
          (loop (if (>= (load i) stop)
                    (break)
                    (do
                      (al-push! [(slice u8)]
                                (load (field st roots))
                                (al-get [(slice u8)] (load (load (field st edges))) (load i)))
                      (store! i (primitive/iadd (load i) 1))))))
        (ul-expand st (load (field d next))))))

; ── reporting ──────────────────────────────────────────────────────────────────
(defn ul-reachable? [(st (ptr UlState)) (name (slice u8))] (-> bool)
  (match (hm-get [(slice u8) i64] (load (load (field st reach))) name)
    (Some [_] true)
    (None [] false)))

;;; A form survives if ANY of the nodes it owns was marked — its own name, or, for a
;;; sum, any of its variant names.
(defn ul-form-reachable? [(st (ptr UlState)) (f Code) (name (slice u8))] (-> bool)
  (if (ul-reachable? st name)
      true
      (if (ul-head-is? f `defsum)
          (ul-any-variant-reachable? st f 2 (primitive/code-count f))
          false)))

(defn ul-any-variant-reachable? [(st (ptr UlState)) (f Code) (i i64) (n i64)] (-> bool)
  (if (>= i n)
      false
      (let [v (primitive/code-nth f i)
            vn (if (primitive/code-list? v) (ul-name-at v 0) "")]
        (if (ul-reachable? st vn)
            true
            (ul-any-variant-reachable? st f (primitive/iadd i 1) n)))))

(defn ul-report-form [(st (ptr UlState)) (m Code) (fi i64)] (-> i64)
  (let [f (primitive/code-nth m fi)
        name (ul-defined-name f)]
    (if (= (slice-len name) 0)
        0
        (if (primitive/code-from-user? f)
            (if (ul-form-reachable? st f name)
                0
                (do
                  (primitive/delete f "unused: nothing reachable from this program's roots refers to this")
                  0))
            0))))

(defn ul-report-module [(st (ptr UlState)) (m Code) (fi i64) (n i64)] (-> i64)
  (if (>= fi n)
      0
      (do
        (ul-report-form st m fi)
        (ul-report-module st m (primitive/iadd fi 1) n))))

(defn ul-report [(st (ptr UlState)) (ms Code) (mi i64) (n i64)] (-> i64)
  (if (>= mi n)
      0
      (do
        (let [m (primitive/code-nth ms mi)]
          (ul-report-module st m 1 (primitive/code-count m)))
        (ul-report st ms (primitive/iadd mi 1) n))))

; ── executable or library ──────────────────────────────────────────────────────
(defn ul-defines-main? [(m Code) (i i64) (n i64)] (-> bool)
  (if (>= i n)
      false
      (let [f (primitive/code-nth m i)]
        (if (ul-head-is? f `defn)
            (if (= (ul-name-at f 1) "main") true (ul-defines-main? m (primitive/iadd i 1) n))
            (ul-defines-main? m (primitive/iadd i 1) n)))))

(defn ul-program-has-main? [(ms Code) (i i64) (n i64)] (-> bool)
  (if (>= i n)
      false
      (let [m (primitive/code-nth ms i)]
        (if (ul-defines-main? m 1 (primitive/code-count m))
            true
            (ul-program-has-main? ms (primitive/iadd i 1) n)))))

(defn ul-module-has-export? [(m Code) (i i64) (n i64)] (-> bool)
  (if (>= i n)
      false
      (if (ul-head-is? (primitive/code-nth m i) `export)
          true
          (ul-module-has-export? m (primitive/iadd i 1) n))))

;;; The library reading: a module that declares no export list exposes every name it
;;; defines, so every one of them is a root.
(defn ul-root-public [(st (ptr UlState)) (ms Code) (i i64) (n i64)] (-> i64)
  (if (>= i n)
      0
      (do
        (let [m (primitive/code-nth ms i)]
          (if (ul-module-has-export? m 1 (primitive/code-count m))
              0
              (ul-root-module st m 1 (primitive/code-count m))))
        (ul-root-public st ms (primitive/iadd i 1) n))))

(defn ul-root-module [(st (ptr UlState)) (m Code) (i i64) (n i64)] (-> i64)
  (if (>= i n)
      0
      (do
        (let [nm (ul-defined-name (primitive/code-nth m i))]
          (if (= (slice-len nm) 0) 0 (do (al-push! [(slice u8)] (load (field st roots)) nm) 0)))
        (ul-root-module st m (primitive/iadd i 1) n))))

;;; Every test entry point is a root. The prefix IS the contract: `coil test` finds
;;; its suites by scanning for it, so a `coil-test$…` function is called by the
;;; harness the way `main` is called by the runtime — from outside the program text.
(defn ul-root-tests [(st (ptr UlState)) (ms Code) (i i64) (n i64)] (-> i64)
  (if (>= i n)
      0
      (do
        (let [m (primitive/code-nth ms i)]
          (ul-root-tests-module st m 1 (primitive/code-count m)))
        (ul-root-tests st ms (primitive/iadd i 1) n))))

(defn ul-root-tests-module [(st (ptr UlState)) (m Code) (i i64) (n i64)] (-> i64)
  (if (>= i n)
      0
      (do
        (let [nm (ul-defined-name (primitive/code-nth m i))]
          (if (starts-with nm "coil-test$")
              (do (al-push! [(slice u8)] (load (field st roots)) nm) 0)
              0))
        (ul-root-tests-module st m (primitive/iadd i 1) n))))

;;; `auto` (default) reads the shape; `exports` and `public` pin it.
(defn ul-root-everything? [(ms Code)] (-> bool)
  (let [mode (primitive/lint-param "unused-roots" "auto")]
    (cond (= mode "exports") false
          (= mode "public") true
          :else (not (ul-program-has-main? ms 0 (primitive/code-count ms))))))

; ── unused imports ─────────────────────────────────────────────────────────────
; A separate pass, because an import is used or not used WITHIN ONE MODULE, while a
; definition is used or not used by the whole program. It needs the per-module
; picture the reachability pass deliberately throws away.
;
; Two ways to spell a use, and one that cannot be judged at all:
;   `:as alias`   — used when `alias/` appears as a qualifier somewhere in the module
;   `:use [a b]`  — used when one of the named items appears
;   `:use *`      — NEVER touched. The names arrive unqualified, so a mention is
;                   indistinguishable from a mention of anything else with that name.
;
; And one thing an import carries that no mention records: AMBIENT declarations. A
; trait impl is in scope wherever its module is loaded, so `(import "coil.str" :as str)`
; can be what makes `(= a b)` compile on slices while `str/` appears nowhere. Same for
; a module registering a checker or a calling convention — the "a dialect is a single
; import" idiom is exactly an import with no mentions. So before proposing to remove
; one, the imported module is inspected: if it holds any top-level form that is not a
; plain named definition, the import stays.

;;; Every bare name and every `qual/` prefix mentioned in one module.
(defstruct UlLocal
  [(names (ptr (HashMap (slice u8) i64)))
   (quals (ptr (HashMap (slice u8) i64)))])

;;; A QUALIFIED mention uses the `:as` alias; an UNQUALIFIED one uses whatever
;;; `:use [...]` binding put the bare name in scope. They are recorded separately
;;; because they answer different questions, and conflating them made
;;; `(import "x" :use [helper])` look used by an unrelated `x/helper` call.
(defn ul-local-note! [(lo (ptr UlLocal)) (s Code)] (-> i64)
  (when (primitive/code-sym? s)
    (let [txt (primitive/code-sym s)
          q (ul-qual txt)]
      (if (= (slice-len q) 0)
          (do (hm-put! (load (field lo names)) txt 1) 0)
          (do (hm-put! (load (field lo quals)) q 1) 0)))
    0)
  0)

;;; The part before the last `/`, or "" when the symbol is unqualified.
(defn ul-qual [(s (slice u8))] (-> (slice u8))
  (let [n (slice-len s)
        (mut cut) -1
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (when (= (primitive/cast i64 (slice-get s (load i))) (primitive/cast i64 47))
                  (store! cut (load i))
                  0)
                (store! i (primitive/iadd (load i) 1)))))
    (if (< (load cut) 0) "" (subslice s 0 (load cut)))))

(defn ul-local-walk [(lo (ptr UlLocal)) (f Code)] (-> i64)
  (if (primitive/code-list? f)
      (if (ul-head-is? f `import)
          0  ; an import BINDS these names; it does not use them
          (ul-local-kids lo f 0 (primitive/code-count f)))
      (if (primitive/code-vector? f)
          (ul-local-kids lo f 0 (primitive/code-count f))
          (ul-local-note! lo f))))

(defn ul-local-kids [(lo (ptr UlLocal)) (f Code) (i i64) (n i64)] (-> i64)
  (if (>= i n)
      0
      (do
        (ul-local-walk lo (primitive/code-nth f i))
        (ul-local-kids lo f (primitive/iadd i 1) n))))

(defn ul-has? [(m (ptr (HashMap (slice u8) i64))) (k (slice u8))] (-> bool)
  (match (hm-get [(slice u8) i64] (load m) k)
    (Some [_] true)
    (None [] false)))

;;; The element after keyword `kw`, or a nil Code when the import does not carry it.
(defn ul-import-arg [(f Code) (kw Code) (i i64) (n i64)] (-> Code)
  (if (>= (primitive/iadd i 1) n)
      `()
      (if (primitive/code-eq (primitive/code-nth f i) kw)
          (primitive/code-nth f (primitive/iadd i 1))
          (ul-import-arg f kw (primitive/iadd i 1) n))))

(defn ul-import-has-kw? [(f Code) (kw Code) (i i64) (n i64)] (-> bool)
  (if (>= i n)
      false
      (if (primitive/code-eq (primitive/code-nth f i) kw)
          true
          (ul-import-has-kw? f kw (primitive/iadd i 1) n))))

;;; Does the module named `ns` declare anything an import brings in AMBIENTLY — an
;;; `impl`, a convention, an annotation, a generator, a registration? Anything that is
;;; not a plain named definition, an import or an export counts, because a mention of
;;; it is not a symbol this walk could ever have seen.
(defn ul-ns-ambient? [(ms Code) (ns (slice u8)) (i i64) (n i64)] (-> bool)
  (if (>= i n)
      true  ; namespace not in the program: assume the worst and keep the import
      (let [m (primitive/code-nth ms i)]
        (if (= (ul-name-at m 0) ns)
            (ul-module-ambient? m 1 (primitive/code-count m))
            (ul-ns-ambient? ms ns (primitive/iadd i 1) n)))))

(defn ul-module-ambient? [(m Code) (i i64) (n i64)] (-> bool)
  (if (>= i n)
      false
      (let [f (primitive/code-nth m i)]
        (if (ul-plain-decl? f)
            (ul-module-ambient? m (primitive/iadd i 1) n)
            true))))

(defn ul-plain-decl? [(f Code)] (-> bool)
  (if (> (slice-len (ul-defined-name f)) 0)
      true
      (if (ul-head-is? f `import)
          true
          (if (ul-head-is? f `export)
              true
              ; a macro is a `defn` too — `ul-defined-name` declines to name it, but
              ; it is still reached by an ordinary qualified call
              (ul-head-is? f `defn)))))

;;; Is this import referred to? Also answers "yes, keep it" for the shapes this pass
;;; declines to judge at all.
(defn ul-import-live? [(f Code) (lo (ptr UlLocal))] (-> bool)
  (let [n (primitive/code-count f)
        use-spec (ul-import-arg f `:use 1 n)
        alias (ul-import-arg f `:as 1 n)]
    (if (primitive/code-vector? use-spec)
        ; `:use [a b]` — live if any named item is mentioned, or if an alias alongside
        ; it is used as a qualifier
        (if (ul-use-list-used? use-spec lo 0 (primitive/code-count use-spec))
            true
            (ul-alias-live? alias lo))
        (if (ul-import-has-kw? f `:use 1 n)
            true  ; `:use *` — names arrive unqualified and cannot be attributed
            (if (primitive/code-sym? alias)
                (ul-alias-live? alias lo)
                true)))))  ; neither `:as` nor `:use`: a shape this pass does not model

(defn ul-alias-live? [(alias Code) (lo (ptr UlLocal))] (-> bool)
  (if (primitive/code-sym? alias)
      (ul-has? (load (field lo quals)) (primitive/code-sym alias))
      false))

(defn ul-use-list-used? [(v Code) (lo (ptr UlLocal)) (i i64) (n i64)] (-> bool)
  (if (>= i n)
      false
      (let [e (primitive/code-nth v i)]
        (if (primitive/code-sym? e)
            (if (ul-has? (load (field lo names)) (ul-bare (primitive/code-sym e)))
                true
                (ul-use-list-used? v lo (primitive/iadd i 1) n))
            true))))

(defn ul-report-import [(f Code) (lo (ptr UlLocal)) (ms Code)] (-> i64)
  (if (not (primitive/code-from-user? f))
      0
      (let [n (primitive/code-count f)
            target (if (> n 1) (primitive/code-str (primitive/code-nth f 1)) "")]
        (if (ul-import-live? f lo)
            0
            (if (ul-ns-ambient? ms target 0 (primitive/code-count ms))
                0
                (do
                  (primitive/delete f "unused: this import binds nothing the module refers to")
                  0))))))

(defn ul-imports-module [(ms Code) (m Code) (lo (ptr UlLocal)) (i i64) (n i64)] (-> i64)
  (if (>= i n)
      0
      (do
        (let [f (primitive/code-nth m i)]
          (if (ul-head-is? f `import) (ul-report-import f lo ms) 0))
        (ul-imports-module ms m lo (primitive/iadd i 1) n))))

(defn ul-imports [(ms Code) (a (dyn alloc/Allocator)) (mi i64) (n i64)] (-> i64)
  (if (>= mi n)
      0
      (do
        (let [m (primitive/code-nth ms mi)
              lo (primitive/alloc-stack UlLocal)
              names (primitive/alloc-stack (HashMap (slice u8) i64))
              quals (primitive/alloc-stack (HashMap (slice u8) i64))]
          (store! names (hm-new [(slice u8) i64] a (str-keyops)))
          (store! quals (hm-new [(slice u8) i64] a (str-keyops)))
          (store! (field lo names) names)
          (store! (field lo quals) quals)
          (ul-local-kids lo m 1 (primitive/code-count m))
          (ul-imports-module ms m lo 1 (primitive/code-count m)))
        (ul-imports ms a (primitive/iadd mi 1) n))))

; ── unused let bindings ────────────────────────────────────────────────────────
; `(let [k v …] body…)` where `k` is never read. Two conditions, and the second is
; the one that decides how much of this is safe to do at all:
;
;   * `k` is not mentioned in the body, nor in any LATER initializer in the same
;     vector (`let` binds sequentially, so `k` is in scope for those).
;   * `v` cannot have an effect. A binding is only dead weight if evaluating its
;     initializer was pointless; `(let [x (write! …)] …)` still has to run the write.
;     Purity is not decidable here, so this asks for a syntactic PROOF from a small
;     whitelist — a literal, another name, a stack/static reservation, a size query,
;     a cast or field projection of something already proven pure — and refuses
;     everything else. An unrecognised call is assumed to have effects.
;
; The binding is two adjacent nodes and both go, as two deletions of the same round.
(defn ul-binder-name [(b Code)] (-> (slice u8))
  (if (primitive/code-sym? b)
      (primitive/code-sym b)
      ; `(mut i)` — a mutable binding still introduces one name
      (if (primitive/code-list? b)
          (if (> (primitive/code-count b) 1) (ul-name-at b 1) "")
          "")))

;;; Is `name` mentioned anywhere in `f`?
(defn ul-mentions? [(f Code) (name (slice u8))] (-> bool)
  (if (primitive/code-sym? f)
      (= (ul-bare (primitive/code-sym f)) name)
      (if (primitive/code-list? f)
          (ul-mentions-kids? f name 0 (primitive/code-count f))
          (if (primitive/code-vector? f)
              (ul-mentions-kids? f name 0 (primitive/code-count f))
              false))))

(defn ul-mentions-kids? [(f Code) (name (slice u8)) (i i64) (n i64)] (-> bool)
  (if (>= i n)
      false
      (if (ul-mentions? (primitive/code-nth f i) name)
          true
          (ul-mentions-kids? f name (primitive/iadd i 1) n))))

;;; Evaluating this expression provably cannot do anything but produce a value.
(defn ul-pure? [(e Code)] (-> bool)
  (if (primitive/code-list? e)
      (if (= (primitive/code-count e) 0)
          true
          (ul-pure-call? e))
      true))  ; a literal, a symbol, a keyword, a vector of them

(defn ul-pure-call? [(e Code)] (-> bool)
  (cond ; a reservation, not a computation: dropping it frees the slot
        (ul-head-is? e `alloc/stack) true
        (ul-head-is? e `alloc/static) true
        (ul-head-is? e `primitive/alloc-stack) true
        (ul-head-is? e `primitive/alloc-static) true
        ; compile-time queries
        (ul-head-is? e `sizeof) true
        (ul-head-is? e `alignof) true
        (ul-head-is? e `offsetof) true
        ; value projections, pure when what they project from is
        (ul-head-is? e `primitive/cast) (ul-pure-args? e 2 (primitive/code-count e))
        (ul-head-is? e `field) (ul-pure? (primitive/code-nth e 1))
        (ul-head-is? e `primitive/field) (ul-pure? (primitive/code-nth e 1))
        (ul-head-is? e `load) (ul-pure-args? e 1 (primitive/code-count e))
        (ul-head-is? e `primitive/load) (ul-pure-args? e 1 (primitive/code-count e))
        ; anything else is a call, and a call is assumed to have effects
        :else false))

(defn ul-pure-args? [(e Code) (i i64) (n i64)] (-> bool)
  (if (>= i n)
      true
      (if (ul-pure? (primitive/code-nth e i))
          (ul-pure-args? e (primitive/iadd i 1) n)
          false)))

;;; Is `name` read after position `i` in the binding vector, or in the body?
(defn ul-bound-read? [(f Code) (v Code) (name (slice u8)) (i i64)] (-> bool)
  (if (ul-mentions-kids? v name (primitive/iadd i 2) (primitive/code-count v))
      true
      (ul-mentions-kids? f name 2 (primitive/code-count f))))

(defn ul-scan-let [(f Code) (v Code) (i i64) (n i64)] (-> i64)
  (if (>= (primitive/iadd i 1) n)
      0
      (do
        (let [b (primitive/code-nth v i)
              init (primitive/code-nth v (primitive/iadd i 1))
              name (ul-binder-name b)]
          (if (= (slice-len name) 0)
              0
              (if (ul-bound-read? f v name i)
                  0
                  (if (not (ul-pure? init))
                      0
                      (do
                        (primitive/delete b "unused: this binding is never read")
                        (primitive/delete init "unused: this binding is never read")
                        0)))))
        (ul-scan-let f v (primitive/iadd i 2) n))))

(defn ul-lets [(f Code)] (-> i64)
  (if (primitive/code-list? f)
      (do
        (if (ul-head-is? f `let)
            (let [v (primitive/code-nth f 1)]
              (if (primitive/code-vector? v) (ul-scan-let f v 0 (primitive/code-count v)) 0))
            0)
        (ul-lets-kids f 0 (primitive/code-count f)))
      (if (primitive/code-vector? f)
          (ul-lets-kids f 0 (primitive/code-count f))
          0)))

(defn ul-lets-kids [(f Code) (i i64) (n i64)] (-> i64)
  (if (>= i n)
      0
      (do
        (ul-lets (primitive/code-nth f i))
        (ul-lets-kids f (primitive/iadd i 1) n))))

(defn ul-lets-module [(m Code) (i i64) (n i64)] (-> i64)
  (if (>= i n)
      0
      (do
        (let [f (primitive/code-nth m i)]
          (if (primitive/code-from-user? f) (ul-lets f) 0))
        (ul-lets-module m (primitive/iadd i 1) n))))

(defn ul-lets-program [(ms Code) (i i64) (n i64)] (-> i64)
  (if (>= i n)
      0
      (do
        (let [m (primitive/code-nth ms i)]
          (ul-lets-module m 1 (primitive/code-count m)))
        (ul-lets-program ms (primitive/iadd i 1) n))))

; ── unused struct fields ───────────────────────────────────────────────────────
; A `defstruct` field that nothing ever reads, writes, or takes the offset of.
;
; ⚠ THIS IS THE ONE DELETION THE COMPILE GATE CANNOT CHECK. Removing a function or
; an import that something needed stops the build, and `--fix` reverts the round.
; Removing a FIELD changes the struct's size and every later field's offset, and a
; program that only ever crossed that layout to C, or memcpy'd it, or hashed its
; bytes, still compiles — and is now wrong at run time. So the guards here are
; deliberately heavier than anywhere else in this file, and a field is deleted only
; when the layout provably belongs to Coil alone:
;
;   * The struct is never named by an `extern` declaration. That is the syntactic
;     edge across which a layout stops being ours to change.
;   * The struct is never either end of a POINTER CAST. This is the guard the other
;     ones do not imply, and `src/apps/clox` is why it exists. It does C-style
;     struct inheritance: every heap object begins with an `(obj Obj)` header, and
;     code reaches that header by casting `(ptr ObjString)` to `(ptr Obj)` rather
;     than by naming the field. Nothing does `(field s obj)`, so the header looked
;     dead in all eight object types; deleting it compiled cleanly and took the VM
;     from 246 passing tests to 246 failing ones. A struct that is cast through is a
;     struct whose layout something is relying on.
;   * `type-of` resolved the base of EVERY `(field … name)` in the program. One
;     unresolved base and the name is treated as used in every struct, because an
;     unattributed read is indistinguishable from a read of this one.
;   * A `cimport`ed struct is generated, not written, so `cop-record-fix` refuses to
;     edit it before any of this is consulted.
;
; The named-constructor syntax `(Moved :x 1 :y 2)` names fields by keyword rather
; than by symbol, which this walk could not see. It does not have to: checkers run
; after expansion, by which point the construction is field stores, and those are
; exactly the `(field …)` forms counted here.
;
; Even with all of that, this pass is OFF unless you ask for it:
; `--lint-param unused-fields=on`. The guards above are a list of the layout
; escapes anyone has thought of, and a list like that is never finished — a
; `(ptr u8)` round trip, a `mem-cmp` over a struct's bytes, and a hand-written
; offset all defeat it, and all of them fail at run time rather than at build time.
; Every other deletion in this file is checked by the compiler before it is kept;
; this one is not, so it is the one you opt into.

;;; `(ptr Live)` / `(mut Live)` / `Live` -> `Live`; anything else -> "".
;;;
;;; The last component is what comes back, because the two ends of this comparison
;;; are spelled differently: `type-of` answers with the type's FULLY QUALIFIED name
;;; (`fieldtest.P`), while the `defstruct` being judged is named by its bare `P`. Left
;;; unreconciled, no field use ever matched the struct that owned it and every field
;;; in the program looked dead.
(defn ul-type-name [(t Code)] (-> (slice u8))
  (if (primitive/code-sym? t)
      (ul-last-component (primitive/code-sym t))
      (if (primitive/code-list? t)
          (if (= (primitive/code-count t) 2)
              (ul-type-name (primitive/code-nth t 1))
              "")
          "")))

;;; After the last `/` or `.` — a type name is qualified with either.
(defn ul-last-component [(s (slice u8))] (-> (slice u8))
  (let [n (slice-len s)
        (mut cut) 0
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (let [c (primitive/cast i64 (slice-get s (load i)))]
                  (when (or (= c (primitive/cast i64 47)) (= c (primitive/cast i64 46)))
                    (store! cut (primitive/iadd (load i) 1))
                    0))
                (store! i (primitive/iadd (load i) 1)))))
    (subslice s (load cut) n)))

;;; Record a use of field `fname`, attributed to struct `sname` — or, when the base
;;; type did not resolve, to every struct at once via the unattributed set.
(defn ul-field-use! [(lo (ptr UlLocal)) (sname (slice u8)) (fname (slice u8))] (-> i64)
  (if (= (slice-len fname) 0)
      0
      (if (= (slice-len sname) 0)
          (do (hm-put! (load (field lo names)) fname 1) 0)
          (do (hm-put! (load (field lo quals)) (ul-field-key sname fname) 1) 0))))

;;; `Struct/field` — the same shape a qualified symbol has, which is why the same map
;;; can hold it: no bare field name can collide with one.
(defn ul-field-key [(sname (slice u8)) (fname (slice u8))] (-> (slice u8))
  (let [a (alloc/malloc-allocator)]
    (match (str-concat a sname "/")
      (None [] (ul-oom))
      (Some [prefix]
            (match (str-concat a prefix fname)
              (None [] (ul-oom))
              (Some [key] key))))))

;;; Out of memory while building a key. There is no value to return that would not be
;;; a WRONG one — any fallback string collides with some real key and marks the wrong
;;; field live — so this stops instead of guessing.
;;;
;;; ⚠ `(primitive/error …)` is the natural way to say this and CANNOT be used here.
;;; Only functions with `Code` in their signature become part of the metaprogram
;;; sub-program; every other helper in this module, this one included, is compiled as
;;; ordinary runtime code, where a comptime-only op is "code operation 9 reached mono
;;; (compiler bug)" for anyone who merely IMPORTS the namespace. libc's `abort` says
;;; the same thing in a way that survives being compiled.
(extern abort :cc c [] (-> i64))

(defn ul-oom [] (-> (slice u8))
  (write-line (stderr) "coil.lint.unused: out of memory building a field key")
  (abort)
  "")

(defn ul-fields-walk [(lo (ptr UlLocal)) (f Code)] (-> i64)
  (if (primitive/code-list? f)
      (do (ul-fields-note! lo f) (ul-fields-kids lo f 0 (primitive/code-count f)))
      (if (primitive/code-vector? f)
          (ul-fields-kids lo f 0 (primitive/code-count f))
          0)))

;;; Compared on the BARE head name, not on a quoted symbol. `field` reaches a checker
;;; spelled however the expansion that produced it spelled it — `field`,
;;; `primitive/field`, or module-qualified — and matching one spelling silently
;;; recorded no field uses at all, which made every field look dead.
(defn ul-head-name [(f Code)] (-> (slice u8))
  (if (> (primitive/code-count f) 0)
      (let [h (primitive/code-nth f 0)]
        (if (primitive/code-sym? h) (ul-bare (primitive/code-sym h)) ""))
      ""))

;;; The ACCESSOR spelling of a field read, `(.name e)`. Two things hid it: it is a
;;; two-element list, so the `field`/`offsetof` shapes below (which need three)
;;; returned early, and `ul-head-name` runs the head through `ul-bare`, which
;;; strips everything up to the last `.` -- so `.x` arrived here already looking
;;; like a plain `x`. Every field a program reads through an accessor therefore
;;; looked dead.
;;;
;;; That went unnoticed until field_syntax_lint began rewriting `(load (field p
;;; x))` into `(.x p)`: with both lints on, the first --fix round rewrote the
;;; reads and the next one deleted the fields those reads were reaching, so the
;;; round stopped compiling and the whole fix was reverted.
(defn ul-raw-head [(f Code)] (-> (slice u8))
  (if (> (primitive/code-count f) 0)
      (let [h (primitive/code-nth f 0)]
        (if (primitive/code-sym? h) (primitive/code-sym h) ""))
      ""))

(defn ul-accessor-name [(f Code)] (-> (slice u8))
  (if (= (primitive/code-count f) 2)
      (let [h (ul-raw-head f)]
        (if (and (> (slice-len h) 1)
                 (= (primitive/cast i64 (slice-get h 0)) 46))
            (subslice h 1 (slice-len h))
            ""))
      ""))

(defn ul-fields-note! [(lo (ptr UlLocal)) (f Code)] (-> i64)
  (let [head (ul-head-name f)
        acc (ul-accessor-name f)]
    (if (= head "cast")
        (ul-note-cast! lo f)
        (if (> (slice-len acc) 0)
            ;; an unresolved base type records the name unattributed, which marks it
            ;; live for every struct -- the conservative direction
            (ul-field-use! lo
                           (ul-type-name (primitive/type-of (primitive/code-nth f 1)))
                           acc)
            (if (< (primitive/code-count f) 3)
                0
                (cond (= head "field")
                        (ul-field-use! lo
                                       (ul-type-name (primitive/type-of (primitive/code-nth f 1)))
                                       (ul-name-at f 2))
                      (= head "offsetof") (ul-field-use! lo (ul-type-name (primitive/code-nth f 1)) (ul-name-at f 2))
                      :else 0))))))

;;; `(cast (ptr S) e)` — both S and whatever `e` already pointed at have their layouts
;;; tied together by this cast. Record each as layout-critical.
(defn ul-note-cast! [(lo (ptr UlLocal)) (f Code)] (-> i64)
  (if (< (primitive/code-count f) 3)
      0
      (do
        (ul-note-pointee! lo (primitive/code-nth f 1))
        (ul-note-pointee! lo (primitive/type-of (primitive/code-nth f 2))))))

;;; If `t` is `(ptr S)` / `(mut S)`, mark S.
(defn ul-note-pointee! [(lo (ptr UlLocal)) (t Code)] (-> i64)
  (if (primitive/code-list? t)
      (if (= (primitive/code-count t) 2)
          (let [head (ul-head-name t)]
            (if (or (= head "ptr") (= head "mut"))
                (let [s (ul-type-name (primitive/code-nth t 1))]
                  (if (= (slice-len s) 0) 0 (do (hm-put! (load (field lo quals)) s 1) 0)))
                0))
          0)
      0))

;;; Recorded by `ul-note-pointee!` under the struct's bare name, which cannot collide
;;; with the `Struct/field` keys sharing the map.
(defn ul-layout-critical? [(lo (ptr UlLocal)) (sname (slice u8))] (-> bool)
  (ul-has? (load (field lo quals)) sname))

(defn ul-fields-kids [(lo (ptr UlLocal)) (f Code) (i i64) (n i64)] (-> i64)
  (if (>= i n)
      0
      (do
        (ul-fields-walk lo (primitive/code-nth f i))
        (ul-fields-kids lo f (primitive/iadd i 1) n))))

;;; Is this struct named by an `extern` anywhere? Then its layout crosses to C and is
;;; not ours to change.
(defn ul-struct-is-abi? [(ms Code) (sname (slice u8)) (i i64) (n i64)] (-> bool)
  (if (>= i n)
      false
      (let [m (primitive/code-nth ms i)]
        (if (ul-module-externs? m sname 1 (primitive/code-count m))
            true
            (ul-struct-is-abi? ms sname (primitive/iadd i 1) n)))))

(defn ul-module-externs? [(m Code) (sname (slice u8)) (i i64) (n i64)] (-> bool)
  (if (>= i n)
      false
      (let [f (primitive/code-nth m i)]
        (if (ul-head-is? f `extern)
            (if (ul-mentions? f sname) true (ul-module-externs? m sname (primitive/iadd i 1) n))
            (ul-module-externs? m sname (primitive/iadd i 1) n)))))

(defn ul-report-fields [(ms Code) (lo (ptr UlLocal)) (f Code)] (-> i64)
  (let [sname (ul-name-at f 1)]
    (if (= (slice-len sname) 0)
        0
        (if (ul-layout-critical? lo sname)
            0
            (if (ul-struct-is-abi? ms sname 0 (primitive/code-count ms))
                0
                (ul-field-vectors ms lo f sname 2 (primitive/code-count f)))))))

(defn ul-field-vectors [(ms Code) (lo (ptr UlLocal)) (f Code) (sname (slice u8)) (i i64) (n i64)] (-> i64)
  (if (>= i n)
      0
      (do
        (let [v (primitive/code-nth f i)]
          (if (primitive/code-vector? v)
              (ul-field-each lo v sname 0 (primitive/code-count v))
              0))
        (ul-field-vectors ms lo f sname (primitive/iadd i 1) n))))

;;; A one-field struct keeps its field: an empty `defstruct` is a different type, not
;;; a smaller one.
(defn ul-field-each [(lo (ptr UlLocal)) (v Code) (sname (slice u8)) (i i64) (n i64)] (-> i64)
  (if (>= i n)
      0
      (do
        (if (<= n 1)
            0
            (let [b (primitive/code-nth v i)]
              (if (primitive/code-list? b)
                  (let [fname (ul-name-at b 0)]
                    (if (= (slice-len fname) 0)
                        0
                        (if (ul-has? (load (field lo names)) fname)
                            0
                            (if (ul-has? (load (field lo quals)) (ul-field-key sname fname))
                                0
                                (do
                                  (primitive/delete b "unused: this field is never read or written")
                                  0)))))
                  0)))
        (ul-field-each lo v sname (primitive/iadd i 1) n))))

(defn ul-fields-module [(ms Code) (lo (ptr UlLocal)) (m Code) (i i64) (n i64)] (-> i64)
  (if (>= i n)
      0
      (do
        (let [f (primitive/code-nth m i)]
          (if (ul-head-is? f `defstruct)
              (if (primitive/code-from-user? f) (ul-report-fields ms lo f) 0)
              0))
        (ul-fields-module ms lo m (primitive/iadd i 1) n))))

(defn ul-fields-program [(ms Code) (lo (ptr UlLocal)) (i i64) (n i64)] (-> i64)
  (if (>= i n)
      0
      (do
        (let [m (primitive/code-nth ms i)]
          (ul-fields-module ms lo m 1 (primitive/code-count m)))
        (ul-fields-program ms lo (primitive/iadd i 1) n))))

;;; Collect field uses across the WHOLE program — including bundled code, which reads
;;; the user's structs through generic and derived helpers — then judge.
(defn ul-fields [(ms Code) (a (dyn alloc/Allocator))] (-> i64)
  (if (!= (primitive/lint-param "unused-fields" "off") "on")
      0
      (let [lo (primitive/alloc-stack UlLocal)
            names (primitive/alloc-stack (HashMap (slice u8) i64))
            quals (primitive/alloc-stack (HashMap (slice u8) i64))]
        (store! names (hm-new [(slice u8) i64] a (str-keyops)))
        (store! quals (hm-new [(slice u8) i64] a (str-keyops)))
        (store! (field lo names) names)
        (store! (field lo quals) quals)
        (ul-fields-kids lo ms 0 (primitive/code-count ms))
        (ul-fields-program ms lo 0 (primitive/code-count ms)))))

; ── unused sum variants ────────────────────────────────────────────────────────
; A variant nothing ever CONSTRUCTS, together with the `match` arms that handle it.
;
; The distinction that makes this possible is pattern versus construction. `match`
; survives expansion, so every arm head is a live symbol by the time a checker looks,
; and a plain mention count therefore says every variant of every matched sum is used
; — a variant is named by the very code that exists only to handle it. Counting only
; NON-pattern occurrences asks the question that matters: does anything ever make one?
;
; Deleting the variant alone would leave arms referring to a variant that no longer
; exists, so the arms go with it. That is not a behaviour change: an arm for a variant
; nothing constructs cannot run, and exhaustiveness still holds over what remains.
; Both edits are ordinary node deletions, and if the enclosing `defn` is being deleted
; too the containment filter in `lint-edits` drops these in favour of the wider one.
;
; SKIPPED ENTIRELY under the library reading. A library's variants are its API — its
; callers construct them and are not present to be seen — so "nothing here builds one"
; means nothing at all. Under the executable reading nothing outside links against
; these modules, so it means what it says.

;;; Record every mention EXCEPT a `match` arm head, which is a pattern.
(defn ul-ctor-walk [(lo (ptr UlLocal)) (f Code)] (-> i64)
  (if (primitive/code-list? f)
      (if (ul-match-form? f)
          (do
            (ul-ctor-walk lo (primitive/code-nth f 1))
            (ul-ctor-arms lo f 2 (primitive/code-count f)))
          ; the `defsum` INTRODUCES these names; counting them would make every
          ; variant its own constructor and the pass could never fire
          (if (ul-head-is? f `defsum)
              (ul-ctor-decls lo f 2 (primitive/code-count f))
              (ul-ctor-kids lo f 0 (primitive/code-count f))))
      (if (primitive/code-vector? f)
          (ul-ctor-kids lo f 0 (primitive/code-count f))
          (do
            (when (primitive/code-sym? f)
              (hm-put! (load (field lo names)) (ul-bare (primitive/code-sym f)) 1)
              0)
            0))))

(defn ul-match-form? [(f Code)] (-> bool)
  (if (>= (primitive/code-count f) 2) (= (ul-head-name f) "match") false))

;;; A variant declaration `(V [(f T) …])` introduces `V` and its field names; only
;;; the payload TYPES are mentions.
(defn ul-ctor-decls [(lo (ptr UlLocal)) (f Code) (i i64) (n i64)] (-> i64)
  (if (>= i n)
      0
      (do
        (let [v (primitive/code-nth f i)]
          (if (primitive/code-list? v)
              (ul-ctor-payload lo v 1 (primitive/code-count v))
              0))
        (ul-ctor-decls lo f (primitive/iadd i 1) n))))

(defn ul-ctor-payload [(lo (ptr UlLocal)) (v Code) (i i64) (n i64)] (-> i64)
  (if (>= i n)
      0
      (do
        (let [e (primitive/code-nth v i)]
          (if (primitive/code-vector? e)
              (ul-ctor-binders lo e 0 (primitive/code-count e))
              (ul-ctor-walk lo e)))
        (ul-ctor-payload lo v (primitive/iadd i 1) n))))

(defn ul-ctor-binders [(lo (ptr UlLocal)) (v Code) (i i64) (n i64)] (-> i64)
  (if (>= i n)
      0
      (do
        (let [b (primitive/code-nth v i)]
          (if (primitive/code-list? b)
              (ul-ctor-kids lo b 1 (primitive/code-count b))
              (ul-ctor-walk lo b)))
        (ul-ctor-binders lo v (primitive/iadd i 1) n))))

(defn ul-ctor-kids [(lo (ptr UlLocal)) (f Code) (i i64) (n i64)] (-> i64)
  (if (>= i n)
      0
      (do
        (ul-ctor-walk lo (primitive/code-nth f i))
        (ul-ctor-kids lo f (primitive/iadd i 1) n))))

;;; An arm is `(Variant [binds] body…)`; element 0 is the pattern and is skipped.
(defn ul-ctor-arms [(lo (ptr UlLocal)) (f Code) (i i64) (n i64)] (-> i64)
  (if (>= i n)
      0
      (do
        (let [arm (primitive/code-nth f i)]
          (if (primitive/code-list? arm)
              (ul-ctor-kids lo arm 1 (primitive/code-count arm))
              (ul-ctor-walk lo arm)))
        (ul-ctor-arms lo f (primitive/iadd i 1) n))))

;;; Delete every arm handling a variant in the dead set (`quals`).
(defn ul-arm-walk [(lo (ptr UlLocal)) (f Code)] (-> i64)
  (if (primitive/code-list? f)
      (do
        (if (ul-match-form? f) (ul-dead-arms lo f 2 (primitive/code-count f)) 0)
        (ul-arm-kids lo f 0 (primitive/code-count f)))
      (if (primitive/code-vector? f)
          (ul-arm-kids lo f 0 (primitive/code-count f))
          0)))

(defn ul-arm-kids [(lo (ptr UlLocal)) (f Code) (i i64) (n i64)] (-> i64)
  (if (>= i n)
      0
      (do
        (ul-arm-walk lo (primitive/code-nth f i))
        (ul-arm-kids lo f (primitive/iadd i 1) n))))

(defn ul-dead-arms [(lo (ptr UlLocal)) (f Code) (i i64) (n i64)] (-> i64)
  (if (>= i n)
      0
      (do
        (let [arm (primitive/code-nth f i)]
          (if (primitive/code-list? arm)
              (let [h (ul-name-at arm 0)]
                (if (= (slice-len h) 0)
                    0
                    (if (ul-has? (load (field lo quals)) (ul-bare h))
                        (do
                          (primitive/delete arm
                                            "unused: nothing constructs this variant, so this arm cannot run")
                          0)
                        0)))
              0))
        (ul-dead-arms lo f (primitive/iadd i 1) n))))

;;; A sum keeps its last variant: an empty `defsum` is a different type, not a
;;; smaller one — the same reason a one-field struct keeps its field.
(defn ul-report-variants [(st (ptr UlState)) (lo (ptr UlLocal)) (f Code)] (-> i64)
  (let [n (primitive/code-count f)]
    (if (<= n 3)
        0
        (if (not (ul-form-reachable? st f (ul-name-at f 1)))
            0  ; the whole sum is going; no need to report its parts
            (ul-variant-each st lo f 2 n)))))

(defn ul-variant-each [(st (ptr UlState)) (lo (ptr UlLocal)) (f Code) (i i64) (n i64)] (-> i64)
  (if (>= i n)
      0
      (do
        (let [v (primitive/code-nth f i)]
          (if (primitive/code-list? v)
              (let [vn (ul-name-at v 0)]
                (if (= (slice-len vn) 0)
                    0
                    (if (ul-has? (load (field lo names)) vn)
                        0
                        (do
                          (primitive/delete v "unused: nothing constructs this variant")
                          (hm-put! (load (field lo quals)) vn 1)
                          0))))
              0))
        (ul-variant-each st lo f (primitive/iadd i 1) n))))

(defn ul-variants-module [(st (ptr UlState)) (lo (ptr UlLocal)) (m Code) (i i64) (n i64)] (-> i64)
  (if (>= i n)
      0
      (do
        (let [f (primitive/code-nth m i)]
          (if (ul-head-is? f `defsum)
              (if (primitive/code-from-user? f) (ul-report-variants st lo f) 0)
              0))
        (ul-variants-module st lo m (primitive/iadd i 1) n))))

(defn ul-variants-scan [(st (ptr UlState)) (lo (ptr UlLocal)) (ms Code) (i i64) (n i64)] (-> i64)
  (if (>= i n)
      0
      (do
        (let [m (primitive/code-nth ms i)]
          (ul-variants-module st lo m 1 (primitive/code-count m)))
        (ul-variants-scan st lo ms (primitive/iadd i 1) n))))

(defn ul-variants [(st (ptr UlState)) (ms Code) (a (dyn alloc/Allocator)) (root-all bool)] (-> i64)
  (if root-all
      0
      (let [lo (primitive/alloc-stack UlLocal)
            names (primitive/alloc-stack (HashMap (slice u8) i64))
            dead (primitive/alloc-stack (HashMap (slice u8) i64))]
        (store! names (hm-new [(slice u8) i64] a (str-keyops)))
        (store! dead (hm-new [(slice u8) i64] a (str-keyops)))
        (store! (field lo names) names)
        (store! (field lo quals) dead)
        (ul-ctor-kids lo ms 0 (primitive/code-count ms))
        (ul-variants-scan st lo ms 0 (primitive/code-count ms))
        (ul-arm-kids lo ms 0 (primitive/code-count ms)))))

; ── the checker ────────────────────────────────────────────────────────────────
(defn unused-code [(modules Code)] (-> Code)
  (let [a (alloc/malloc-allocator)
        st (primitive/alloc-stack UlState)
        defs (primitive/alloc-stack (ArrayList UlDef))
        edges (primitive/alloc-stack (ArrayList (slice u8)))
        byname (primitive/alloc-stack (HashMap (slice u8) i64))
        roots (primitive/alloc-stack (ArrayList (slice u8)))
        reach (primitive/alloc-stack (HashMap (slice u8) i64))]
    (store! defs (al-new [UlDef] a))
    (store! edges (al-new [(slice u8)] a))
    (store! byname (hm-new [(slice u8) i64] a (str-keyops)))
    (store! roots (al-new [(slice u8)] a))
    (store! reach (hm-new [(slice u8) i64] a (str-keyops)))
    (store! (field st defs) defs)
    (store! (field st edges) edges)
    (store! (field st byname) byname)
    (store! (field st roots) roots)
    (store! (field st reach) reach)
    (ul-collect st modules 0 (primitive/code-count modules))
    ; the entry point is a root by definition — nothing in the program names it
    (al-push! [(slice u8)] roots "main")
    ; …and so is every TEST. `deftest` and `defprop` mint `coil-test$NAME`
    ; (assert.coil:77, prop.coil:123), which `coil test` discovers by that prefix
    ; exactly as the linker discovers `main`. Nothing in the program CALLS them, so
    ; without this they are unreachable — and worse, so is everything they are the
    ; only caller of. A whole-project run then proposed deleting a function and the
    ; test covering it in the same round, which compiles cleanly precisely because
    ; both halves went, so the `--fix` loop's revert-on-broken could not catch it.
    (ul-root-tests st modules 0 (primitive/code-count modules))
    (if (ul-root-everything? modules)
        (ul-root-public st modules 0 (primitive/code-count modules))
        0)
    (ul-mark st)
    (ul-report st modules 0 (primitive/code-count modules))
    (ul-variants st modules a (ul-root-everything? modules))
    (ul-imports modules a 0 (primitive/code-count modules))
    (ul-lets-program modules 0 (primitive/code-count modules))
    (ul-fields modules a)
    `0))

(checker unused-code)
