(module coil.lint.meta)
(import "coil.primitive" :as primitive)

; Quadratic metaprogram idioms — the shapes that made a 20,000-form scope body
; cost 27 GiB to expand (docs/design/META_MEMORY.md):
;
;   1. cdr-recursion: (F … (primitive/code-rest xs) …) inside F itself.
;      code-rest COPIES the whole tail, so walking an n-form list this way
;      allocates n²/2 nodes.
;   2. append-by-resplice: an accumulator that grows through a quasiquote
;      re-splice. Three spellings of the same mistake:
;        a. `(~@acc ~x) passed back into F's own parameter,
;        b. (let [rest (F …)] `(item ~@rest)) — the recursion's result
;           re-spliced at every level,
;        c. `(item ~@(F …)) — the same, without the intermediate binding.
;
; Every rule fires only on SELF-recursion. A one-shot code-rest, or a single
; splice of a finished list into a template, is the irreducible copy and is
; deliberately not flagged.
;
; The canonical read-only `(xs, i, n)` walker is autofixed atomically: its body
; becomes a `for` over the O(1) `code-slice xs i n` view. Its public signature is
; preserved, so callers and mutually layered walkers remain valid throughout the
; fixpoint. Less regular recursion and builder-producing rewrites remain warnings.
;
;     coil lint FILE --use coil.lint.meta

;; ---- small Code accessors ---------------------------------------------------
(defn ml--head [(f Code)] (-> Code)
  (if (and (primitive/code-list? f) (> (len f) 0))
      (get f 0)
      `ml$not-a-head))

(defn ml--head-is? [(f Code) (name Code)] (-> bool)
  (= (ml--head f) name))

;;; a defn form: (defn name … )
(defn ml--defn? [(f Code)] (-> bool)
  (and (ml--head-is? f `defn) (> (len f) 2)))

;;; the plain name a binder position names: x -> x, (mut x) -> x, (x Type) -> x
(defn ml--binder-sym [(bp Code)] (-> Code)
  (if (primitive/code-sym? bp)
      bp
      (if (and (primitive/code-list? bp) (> (len bp) 0))
          (if (= (get bp 0) `mut)
              (if (> (len bp) 1) (get bp 1) `ml$none)
              (get bp 0))
          `ml$none)))

(defn ml--member? [(x Code) (xs Code) (i i64)] (-> bool)
  (if (>= i (len xs))
      false
      (if (= x (get xs i))
          true
          (ml--member? x xs (primitive/iadd i 1)))))

;; ---- canonical index-walker autofix ----------------------------------------
; Accepted shape (and no broader):
;   (defn F [(xs Code) (i i64) (n i64)] RET
;     (if (>= i n) BASE (do ACTION (F xs (+ i 1) n))))
; ACTION may use i only as `(code-nth xs i)`. Keeping this narrow makes the
; replacement mechanical and semantics-preserving.
(defn ml--pair-name [(params Code) (i i64)] (-> Code)
  (if (>= i (len params))
      `ml$none
      (ml--binder-sym (get params i))))

(defn ml--binary? [(f Code) (head Code) (a Code) (b Code)] (-> bool)
  (and (primitive/code-list? f)
       (and (= (len f) 3)
            (and (= (get f 0) head)
                 (and (= (get f 1) a)
                      (= (get f 2) b))))))

(defn ml--inc? [(f Code) (i Code)] (-> bool)
  (or (ml--binary? f `+ i `1) (ml--binary? f `primitive/iadd i `1)))

(defn ml--same-prefix? [(call Code) (params Code) (i i64) (n i64)] (-> bool)
  (if (>= i n)
      true
      (if (= (get call (+ i 1)) (ml--pair-name params i))
          (ml--same-prefix? call params (+ i 1) n)
          false)))

(defn ml--nth? [(f Code) (xs Code) (i Code)] (-> bool)
  (or (ml--binary? f `get xs i) (ml--binary? f `code-nth xs i) (ml--binary? f `primitive/code-nth xs i)))

;;; Replace `(code-nth xs i)` with ITEM. Return `ml$unsafe` if i or n occurs in
;;; any other position, so the caller refuses the autofix rather than guessing.
(defn ml--walker-action [(f Code) (xs Code) (i Code) (n Code) (item Code)] (-> Code)
  (if (ml--nth? f xs i)
      item
      (if (primitive/code-sym? f)
          (if (or (= f i) (= f n)) `ml$unsafe f)
          (if (primitive/code-vector? f)
              (let [parts (ml--walker-action-list f xs i n item 0 (primitive/code-list-new))]
                (if (= parts `ml$unsafe) `ml$unsafe `[~@parts]))
              (if (primitive/code-list? f)
                  (ml--walker-action-list f xs i n item 0 (primitive/code-list-new))
                  f)))))

(defn ml--walker-action-list [(f Code)
                              (xs Code)
                              (i Code)
                              (n Code)
                              (item Code)
                              (at i64)
                              (out CodeBuilder)] (-> Code)
  (if (>= at (len f))
      (primitive/code-list-done out)
      (let [part (ml--walker-action (get f at) xs i n item)]
        (if (= part `ml$unsafe)
            `ml$unsafe
            (do
              (primitive/code-list-push! out part)
              (ml--walker-action-list f xs i n item (+ at 1) out))))))

;;; Return the iterator replacement defn, or `ml$none when F is not the exact
;;; safe shape above. Defns are intentionally restricted to the ordinary
;;; five-element spelling; generics/attributes need an explicit human rewrite.
(defn ml--walker-replacement [(f Code)] (-> Code)
  (if (and (= (len f) 5) (primitive/code-vector? (get f 2)))
      (let [params (get f 2)]
        (if (>= (len params) 3)
            (let [prefix (- (len params) 3)
                  xs (ml--pair-name params prefix)
                  i (ml--pair-name params (+ prefix 1))
                  n (ml--pair-name params (+ prefix 2))
                  body (get f 4)]
              (if (and (primitive/code-list? body)
                       (and (= (len body) 4)
                            (= (get body 0) `if)))
                  (let [cond (get body 1)
                        base (get body 2)
                        step (get body 3)]
                    (if (and (or (ml--binary? cond `>= i n) (ml--binary? cond `primitive/icmp-ge i n))
                             (and (primitive/code-list? step)
                                  (and (= (len step) 3) (= (get step 0) `do))))
                        (let [action (get step 1)
                              recur (get step 2)
                              item (primitive/fresh-identifier "item")]
                          (if (and (primitive/code-list? recur)
                                   (and (= (len recur) (+ (len params) 1))
                                        (and (= (get recur 0) (get f 1))
                                             (and (ml--same-prefix? recur params 0 prefix)
                                                  (and (= (get recur (+ prefix 1)) xs)
                                                       (and (ml--inc? (get recur (+ prefix 2)) i)
                                                            (= (get recur (+ prefix 3)) n)))))))
                              (let [clean (ml--walker-action action xs i n item)]
                                (if (= clean `ml$unsafe)
                                    `ml$none
                                    `(defn ~(primitive/syntax->datum (get f 1))
                                           ~(get f 2)
                                           ~(get f 3)
                                       (do
                                         (for ~item (iter (primitive/code-slice ~xs ~i ~n)) ~clean)
                                         ~base))))
                              `ml$none))
                        `ml$none))
                  `ml$none))
            `ml$none))
      `ml$none))

;; ---- rule 1: code-rest fed to a self-recursive call -------------------------
(defn ml--code-rest-call? [(arg Code)] (-> bool)
  (if (and (primitive/code-list? arg) (> (len arg) 0))
      (if (= (get arg 0) `primitive/code-rest)
          true
          (= (get arg 0) `code-rest))
      false))

(defn ml--check-self-call-args [(call Code) (i i64) (n i64)] (-> i64)
  (if (>= i n)
      0
      (do
        (when (ml--code-rest-call? (get call i))
          (primitive/warn (get call i)
                          "quadratic metaprogram: code-rest inside its own recursion copies the whole tail every step — use (for item (iter code) ...) or iterate by index instead; see docs/design/META_MEMORY.md")
          0)
        (ml--check-self-call-args call (primitive/iadd i 1) n))))

;; ---- rule 2: an accumulator grown by re-splicing ----------------------------

;;; does the template list `tpl` contain (unquote-splicing S) with S a bare
;;; symbol in `names`? (`(~@x …) reads as (quasiquote ((unquote-splicing x) …)))
(defn ml--splices-name? [(tpl Code) (names Code) (i i64)] (-> bool)
  (if (>= i (len tpl))
      false
      (let [el (get tpl i)]
        (if (and (primitive/code-list? el)
                 (and (= (len el) 2)
                      (and (= (get el 0) `unquote-splicing)
                           (primitive/code-sym? (get el 1)))))
            (if (ml--member? (get el 1) names 0)
                true
                (ml--splices-name? tpl names (primitive/iadd i 1)))
            (ml--splices-name? tpl names (primitive/iadd i 1))))))

;;; does the template list `tpl` contain (unquote-splicing (fname …)) — the
;;; recursion's result spliced directly, no intermediate binding?
(defn ml--splices-selfcall? [(tpl Code) (fname Code) (i i64)] (-> bool)
  (if (>= i (len tpl))
      false
      (let [el (get tpl i)]
        (if (and (primitive/code-list? el)
                 (and (= (len el) 2)
                      (and (= (get el 0) `unquote-splicing)
                           (ml--head-is? (get el 1) fname))))
            true
            (ml--splices-selfcall? tpl fname (primitive/iadd i 1))))))

;;; is `f` a quasiquote template that re-splices one of `names`?
(defn ml--resplice-of? [(f Code) (names Code)] (-> bool)
  (if (and (primitive/code-list? f)
           (and (= (len f) 2)
                (= (get f 0) `quasiquote)))
      (let [tpl (get f 1)]
        (if (primitive/code-list? tpl) (ml--splices-name? tpl names 0) false))
      false))

;;; is `f` a quasiquote template that splices a direct call to fname?
(defn ml--resplice-selfcall? [(f Code) (fname Code)] (-> bool)
  (if (and (primitive/code-list? f)
           (and (= (len f) 2)
                (= (get f 0) `quasiquote)))
      (let [tpl (get f 1)]
        (if (primitive/code-list? tpl) (ml--splices-selfcall? tpl fname 0) false))
      false))

;;; does `f` (or anything nested in it — an if-wrapped accumulator counts) hold a
;;; quasiquote that re-splices one of `names`?
(defn ml--contains-resplice? [(f Code) (names Code)] (-> bool)
  (if (ml--resplice-of? f names)
      true
      (if (primitive/code-list? f)
          (ml--contains-resplice-kids? f names 0)
          false)))

(defn ml--contains-resplice-kids? [(f Code) (names Code) (i i64)] (-> bool)
  (if (>= i (len f))
      false
      (if (ml--contains-resplice? (get f i) names)
          true
          (ml--contains-resplice-kids? f names (primitive/iadd i 1)))))

;;; POSITIONAL: argument j is an accumulator exactly when it re-splices the
;;; parameter it feeds (param j). Splicing some OTHER, invariant parameter into
;;; a self-call argument rebuilds a constant-size form per level — linear, not
;;; compounding — so it must not fire.
(defn ml--check-accum-args [(call Code) (params Code) (i i64) (n i64)] (-> i64)
  (if (>= i n)
      0
      (do
        (when (and (< (primitive/isub i 1) (len params))
                   (ml--contains-resplice? (get call i)
                                           `(~(get params (primitive/isub i 1)))))
          (primitive/warn (get call i)
                          "quadratic metaprogram: re-splicing the accumulator copies it once per element — build with (primitive/code-list-new) + code-list-push! and splice ONCE at the end; see docs/design/META_MEMORY.md")
          0)
        (ml--check-accum-args call params (primitive/iadd i 1) n))))

;; ---- rule 2b: a local bound to the recursion, then re-spliced ---------------
;; The shape:  (let [rest (F … (iadd i 1) …)] `(item ~@rest))
;; Every level splices the suffix built by the levels below it.

;;; push every let-bound name whose init is a call to fname onto `out`
(defn ml--collect-binding-pairs [(binds Code) (fname Code) (out CodeBuilder) (i i64)] (-> i64)
  (if (>= (primitive/iadd i 1) (len binds))
      0
      (let [nm (ml--binder-sym (get binds i))
            init (get binds (primitive/iadd i 1))]
        (do
          (when (and (primitive/code-sym? nm)
                     (and (primitive/code-list? init) (ml--head-is? init fname)))
            (primitive/code-list-push! out nm)
            0)
          (ml--collect-binding-pairs binds fname out (primitive/iadd i 2))))))

(defn ml--collect-self-locals [(f Code) (fname Code) (out CodeBuilder)] (-> i64)
  (if (not (primitive/code-list? f))
      0
      (do
        (when (and (ml--head-is? f `let)
                   (and (> (len f) 1)
                        (primitive/code-vector? (get f 1))))
          (ml--collect-binding-pairs (get f 1) fname out 0)
          0)
        (ml--collect-self-locals-kids f fname out 0))))

(defn ml--collect-self-locals-kids [(f Code) (fname Code) (out CodeBuilder) (i i64)] (-> i64)
  (if (>= i (len f))
      0
      (do
        (ml--collect-self-locals (get f i) fname out)
        (ml--collect-self-locals-kids f fname out (primitive/iadd i 1)))))

;;; warn on every quasiquote in `f` that splices a name from `locals` (2b) or a
;;; direct self-call (2c)
(defn ml--flag-local-resplice [(f Code) (fname Code) (locals Code)] (-> i64)
  (if (not (primitive/code-list? f))
      0
      (do
        (when (ml--resplice-of? f locals)
          (primitive/warn f
                          "quadratic metaprogram: splicing the recursive result rebuilds the suffix at every level — build with (primitive/code-list-new) + code-list-push! in an index loop; see docs/design/META_MEMORY.md")
          0)
        (when (ml--resplice-selfcall? f fname)
          (primitive/warn f
                          "quadratic metaprogram: splicing a direct recursive call rebuilds the suffix at every level — build with (primitive/code-list-new) + code-list-push! in an index loop; see docs/design/META_MEMORY.md")
          0)
        (ml--flag-local-resplice-kids f fname locals 0))))

(defn ml--flag-local-resplice-kids [(f Code) (fname Code) (locals Code) (i i64)] (-> i64)
  (if (>= i (len f))
      0
      (do
        (ml--flag-local-resplice (get f i) fname locals)
        (ml--flag-local-resplice-kids f fname locals (primitive/iadd i 1)))))

;; ---- the walk over one defn -------------------------------------------------

;;; push every binder in vec `v` onto `out`, skipping the variadic `&` marker so
;;; positions line up with call arguments
(defn ml--vec-binders [(v Code) (out CodeBuilder) (i i64)] (-> i64)
  (if (>= i (len v))
      0
      (do
        (when (and (primitive/code-sym? (ml--binder-sym (get v i)))
                   (not (= (ml--binder-sym (get v i)) `&)))
          (primitive/code-list-push! out (ml--binder-sym (get v i)))
          0)
        (ml--vec-binders v out (primitive/iadd i 1)))))

;;; the defn's PARAMETER vec: the vector right before the (-> …) return marker —
;;; a leading generics vec must not shift the positional param/argument pairing.
(defn ml--param-names [(f Code) (out CodeBuilder) (i i64)] (-> i64)
  (if (>= (primitive/iadd i 1) (len f))
      0
      (let [el (get f i)
            next (get f (primitive/iadd i 1))]
        (if (and (primitive/code-vector? el)
                 (and (primitive/code-list? next)
                      (and (> (len next) 0)
                           (= (get next 0) `->))))
            (ml--vec-binders el out 0)
            (ml--param-names f out (primitive/iadd i 1))))))

;;; walk the body: at every self-call, run rules 1 and 2a
(defn ml--walk-body [(f Code) (fname Code) (params Code)] (-> i64)
  (if (not (primitive/code-list? f))
      0
      (do
        (when (ml--head-is? f fname)
          (ml--check-self-call-args f 1 (len f))
          (ml--check-accum-args f params 1 (len f))
          0)
        (ml--walk-body-kids f fname params 0))))

(defn ml--walk-body-kids [(f Code) (fname Code) (params Code) (i i64)] (-> i64)
  (if (>= i (len f))
      0
      (do
        (ml--walk-body (get f i) fname params)
        (ml--walk-body-kids f fname params (primitive/iadd i 1)))))

(defn ml--check-defn [(f Code)] (-> i64)
  (let [fname (get f 1)]
    (if (primitive/code-sym? fname)
        (let [pb (primitive/code-list-new)
              lb (primitive/code-list-new)]
          (do
            (ml--param-names f pb 2)
            (ml--collect-self-locals f fname lb)
            ; freeze before the read-side walks: builders are write-only until
            ; code-list-done (docs/design/META_MEMORY.md phase 4)
            (let [params (primitive/code-list-done pb)
                  locals (primitive/code-list-done lb)]
              (do
                (ml--walk-body f fname params)
                (ml--flag-local-resplice f fname locals)))))
        0)))

;; ---- module plumbing (same shape as coil.lint.match-else) -------------------
(defn ml--user-module? [(m Code) (i i64) (n i64)] (-> bool)
  (if (>= i n)
      false
      (if (primitive/code-from-user? (get m i))
          true
          (ml--user-module? m (primitive/iadd i 1) n))))

(defn ml--module-forms [(m Code) (i i64) (n i64)] (-> i64)
  (if (>= i n)
      0
      (let [form (get m i)]
        (if (ml--defn? form)
            (let [replacement (ml--walker-replacement form)]
              (if (= replacement `ml$none)
                  (do
                    (ml--check-defn form)
                    (ml--module-forms m (primitive/iadd i 1) n))
                  (do
                    (primitive/suggest form "replace recursive index/count Code walker with iterator loop" replacement)
                    (ml--module-forms m (primitive/iadd i 1) n))))
            (ml--module-forms m (primitive/iadd i 1) n)))))

(defn ml--module [(m Code)] (-> i64)
  (if (and (> (len m) 1)
           (ml--user-module? m 1 (len m)))
      (ml--module-forms m 1 (len m))
      0))

(defn ml--modules [(modules Code) (i i64) (n i64)] (-> i64)
  (if (>= i n)
      0
      (do
        (ml--module (get modules i))
        (ml--modules modules (primitive/iadd i 1) n))))

(defn lint-meta-memory [(modules Code)] (-> Code)
  (do (ml--modules modules 0 (len modules)) `0))

(checker lint-meta-memory :phase before-expand)
