(module coil.lint.primitives)
(import "coil.primitive" :as primitive)
(import "coil.lint.names" :as names)

; Ordinary code should not need `coil.primitive`. Most `primitive/…` calls in
; application code have an everyday spelling with the same meaning, and this
; checker rewrites them to it; when a module has nothing left that needs the
; namespace, its `(import "coil.primitive" …)` goes too. Part of the default lint
; profile, so `coil lint --fix` always applies it.
;
; Two kinds of rewrite, both exact:
;
;   * Aliases. coil.core defines `index`, `sizeof`, `alignof`, … as `(def index
;     primitive/index)` — the same operation under a bare name. The rewrite only
;     changes the spelling, so it is withheld wherever the bare name could mean
;     something else: a module that defines or imports that name, or a form that
;     mentions it as anything but a call head (a local named `index`, say).
;
;   * Not `iadd`, `isub`, `imul` or `cast`. They are the WRAPPING arithmetic and the
;     RAW conversion, and under coil.safety `+ - *` and `cast` are checked while
;     these never are, so the everyday spelling would change what the code does.
;     (A cast of a literal its type holds is no conversion at all: coil.lint.modernize
;     writes it as an ascription.)
;
;   * Operators. The arithmetic, bitwise and float-ordering traits are
;     implemented in the prelude as one inlined primitive per standard type —
;     `(impl BitAnd u8 (& … (primitive/iand a b)))` — so `(primitive/iand a b)` on
;     u8 IS `(& a b)`. The rewrite is driven by the checked operand type and
;     happens only for types that have those impls (the eight standard integer
;     widths, f32, f64); an `i7` or `i128` operation keeps its primitive. `udiv`
;     and `urem` become `/` and `%` only on unsigned types, where they are the
;     same instruction. `fcmp-eq` is `=` on floats; `fcmp-ne` (ordered: false
;     when either side is NaN) and `frem` have no operator and stay primitive.
;     An operation on literals alone, `(primitive/ishl 3 30)`, has the type of
;     where it stands, which the checker does not report; it is rewritten where
;     the lint knows that type: a const initializer, an ascription, a function's
;     value (its declared return type), or an operand beside one whose type the
;     checker does report.
;
; Not touched: the text of quasiquoted templates (they expand in another module,
; whose names this module cannot vouch for; the code under `~` is linted), code a
; macro generated, and an operator on the
; very type whose impl DEFINES it — rewriting `(primitive/iand a b)` inside
; `(impl BitAnd i64 (& …))` would make `&` call itself. (The same primitive on
; another type in that impl, say `(impl Add V2 …)` adding f32 fields, is fine.)

; ---- shapes ----------------------------------------------------------------
(defn pr-head? [(f Code) (name Code)] (-> bool)
  (and (primitive/code-list? f)
       (not (primitive/code-vector? f))
       (> (len f) 0)
       (= (get f 0) name)))

(defn pr-tail [(f Code) (from i64)] (-> Code)
  (let [out (primitive/code-list-new)
        n (len f)
        (mut k) from]
    (while (< k n)
      (primitive/code-list-push! out (get f k))
      (set! k (+ k 1)))
    (primitive/code-list-done out)))

; ---- aliases ---------------------------------------------------------------
;;; The coil.core alias for `primitive/<name>`, or `_` when there is none.
;;; `load`, `store!` and `field` are aliases too, but coil.lint.field-syntax
;;; already rewrites those (to `set!` and `.field` where it can), and two
;;; checkers editing one form would collide.
(defn pr-alias [(head (slice u8)) (env Code)] (-> Code)
  (cond (names/ln-is? head env "coil.primitive/index") `index
        (names/ln-is? head env "coil.primitive/sizeof") `sizeof
        (names/ln-is? head env "coil.primitive/alignof") `alignof
        (names/ln-is? head env "coil.primitive/offsetof") `offsetof
        (names/ln-is? head env "coil.primitive/zeroed") `zeroed
        (names/ln-is? head env "coil.primitive/fnptr-of") `fnptr-of
        (names/ln-is? head env "coil.primitive/call-ptr") `call-ptr
        :else `_))

;;; Does `f` mention the bare symbol `name` other than as the head of a call?
;;; A binder (`[index 3]`), an argument or a value reference all count.
(defn pr-mentions-value? [(f Code) (name (slice u8))] (-> bool)
  (cond (primitive/code-sym? f) (= (primitive/code-sym f) name)
        (primitive/code-list? f)
          (let [n (len f)
                call (not (primitive/code-vector? f))
                (mut found) false
                (mut k) 0]
            (while (and (not found) (< k n))
              (let [kid (get f k)]
                (when (if (and call (= k 0) (primitive/code-sym? kid))
                          false
                          (pr-mentions-value? kid name))
                  (set! found true)))
              (set! k (+ k 1)))
            found)
        :else false))

(defn pr-def-head? [(f Code)] (-> bool)
  (or (pr-head? f `defn) (pr-head? f `defn*) (pr-head? f `def)
      (pr-head? f `const) (pr-head? f `extern) (pr-head? f `defstruct)
      (pr-head? f `defsum) (pr-head? f `deftrait)))

;;; Does the module form `m` define `name` at top level?
(defn pr-module-defines? [(m Code) (name (slice u8))] (-> bool)
  (let [(mut found) false
        (mut k) 1]
    (while (and (not found) (< k (len m)))
      (let [f (get m k)]
        (when (and (pr-def-head? f)
                   (> (len f) 1)
                   (primitive/code-sym? (get f 1))
                   (= (primitive/code-sym (get f 1)) name))
          (set! found true)))
      (set! k (+ k 1)))
    found))

(defn pr-find-module [(modules Code) (name (slice u8))] (-> Code)
  (let [(mut found) `()
        (mut k) 0]
    (while (< k (len modules))
      (let [m (get modules k)]
        (when (= (names/ln-module-name m) name) (set! found m)))
      (set! k (+ k 1)))
    found))

;;; Could the bare `name` in module `m` mean something other than coil.core's
;;; alias? True when the module defines it, names it in a `:use [...]`, or
;;; star-imports a module that defines it (or that is not in the program).
(defn pr-module-shadows? [(modules Code) (m Code) (name (slice u8))] (-> bool)
  (if (pr-module-defines? m name)
      true
      (let [(mut found) false
            (mut k) 1]
        (while (and (not found) (< k (len m)))
          (let [f (get m k)]
            (when (names/ln-import? f)
              (let [uses (names/ln-clause f `:use)]
                (cond (primitive/code-vector? uses)
                        (when (pr-mentions-value? uses name) (set! found true))
                      (and (primitive/code-sym? uses) (= (primitive/code-sym uses) "*"))
                        (let [target (pr-find-module modules
                                                     (primitive/code-str (get f 1)))]
                          (when (or (= (len target) 0)
                                    (pr-module-defines? target name))
                            (set! found true)))
                      :else 0))))
          (set! k (+ k 1)))
        found)))

; ---- operators -------------------------------------------------------------
(defn pr-int-type? [(ty Code)] (-> bool)
  (or (= ty `i8) (= ty `i16)
      (= ty `i32) (= ty `i64)
      (pr-unsigned-type? ty)))

(defn pr-unsigned-type? [(ty Code)] (-> bool)
  (or (= ty `u8) (= ty `u16)
      (= ty `u32) (= ty `u64)))

(defn pr-float-type? [(ty Code)] (-> bool)
  (or (= ty `f32) (= ty `f64)))

;;; What family of operand an operation takes: 1 = standard integer, 2 =
;;; unsigned integer only, 3 = f32/f64.
(defstruct PrOp [(operator Code) (family i64) (trait Code)])

(defn pr-op [(operator Code) (family i64) (trait Code)] (-> (Option PrOp))
  (Some (PrOp :operator operator :family family :trait trait)))

(defn pr-operator [(head (slice u8)) (env Code)] (-> (Option PrOp))
  (cond (names/ln-is? head env "coil.primitive/idiv") (pr-op `/ 1 `Div)
        (names/ln-is? head env "coil.primitive/irem") (pr-op `% 1 `Rem)
        (names/ln-is? head env "coil.primitive/iand") (pr-op `& 1 `BitAnd)
        (names/ln-is? head env "coil.primitive/ior") (pr-op `| 1 `BitOr)
        (names/ln-is? head env "coil.primitive/ixor") (pr-op `^ 1 `BitXor)
        (names/ln-is? head env "coil.primitive/ishl") (pr-op `<< 1 `Shl)
        (names/ln-is? head env "coil.primitive/ishr") (pr-op `>> 1 `Shr)
        (names/ln-is? head env "coil.primitive/udiv") (pr-op `/ 2 `Div)
        (names/ln-is? head env "coil.primitive/urem") (pr-op `% 2 `Rem)
        (names/ln-is? head env "coil.primitive/fadd") (pr-op `+ 3 `Add)
        (names/ln-is? head env "coil.primitive/fsub") (pr-op `- 3 `Sub)
        (names/ln-is? head env "coil.primitive/fmul") (pr-op `* 3 `Mul)
        (names/ln-is? head env "coil.primitive/fdiv") (pr-op `/ 3 `Div)
        (names/ln-is? head env "coil.primitive/fcmp-lt") (pr-op `< 3 `Ord)
        (names/ln-is? head env "coil.primitive/fcmp-le") (pr-op `<= 3 `Ord)
        (names/ln-is? head env "coil.primitive/fcmp-gt") (pr-op `> 3 `Ord)
        (names/ln-is? head env "coil.primitive/fcmp-ge") (pr-op `>= 3 `Ord)
        ; fcmp-ne is the ORDERED not-equal (false when either side is NaN), while
        ; `!=` is `(not (= a b))`, true then; so only fcmp-eq has an operator.
        (names/ln-is? head env "coil.primitive/fcmp-eq") (pr-op `= 3 `Eq)
        :else (None [PrOp])))

(defn pr-family? [(family i64) (ty Code)] (-> bool)
  (cond (= family 1) (pr-int-type? ty)
        (= family 2) (pr-unsigned-type? ty)
        :else (pr-float-type? ty)))

;;; A numeric literal itself; the operator rewrite leaves one as it is.
(defn pr-literal? [(f Code)] (-> bool)
  (or (primitive/code-int? f) (primitive/code-float? f)))

;;; The type the operands of `f` share, or `_`. The primitives demand equal operand
;;; types, and so do the operator traits, so any operand whose type the checker
;;; knows decides: the first one that is not context-typed (names/ln-context-typed?,
;;; whose reported type is its default, not the one the context gave it) and has a
;;; type at all (a macro call, for one, may have none).
(defn pr-operand-type [(f Code) (env Code)] (-> Code)
  (let [(mut ty) `_
        (mut k) 1]
    (while (and (= ty `_) (< k (len f)))
      (let [x (get f k)]
        (unless (names/ln-context-typed? x env)
          (match (primitive/type-of x)
            (primitive/TypeIs [t] (do (set! ty t) 0))
            (primitive/TypeUnknown [] 0))))
      (set! k (+ k 1)))
    ty))

;;; A trait method dispatches on its FIRST operand before a literal takes its
;;; width from context, so `(& 255 x)` with an i32 `x` would pick i64's `&`. A
;;; leading context-typed operand (a literal, or an operation left as a primitive)
;;; of a type other than the literal default is therefore ascribed.
(defn pr-first-operand [(a Code) (ty Code)] (-> Code)
  (if (= ty (if (pr-float-type? ty) `f64 `i64)) a `(: ~a ~ty)))

;;; The operator spelled so that it reaches its trait method at NODE: bare, then
;;; trait-qualified (`Add::+`), then module-qualified; `_` when none does
;;; (names/ln-spelling-at).
(defn pr-operator-at [(node Code) (op PrOp)] (-> Code)
  (let [o (.operator op)
        name (primitive/code-sym o)]
    (names/ln-spelling-at node
                          `(~o ~(primitive/code-symbol (primitive/code-symbol (.trait op) "::") name)
                               ~(primitive/code-symbol "coil.core." name))
                          (primitive/code-str "coil.core." name))))

;;; Is `op` on `ty` an operator call here? Not for a type without the impls, and
;;; not on the very type whose impl DEFINES it: inside `(impl Add i64 (+ …))` the
;;; primitive IS `+` on i64, and `+` there would call itself.
(defn pr-rewritable? [(cx PrCx) (op PrOp) (ty Code)] (-> bool)
  (and (pr-family? (.family op) ty)
       (not (and (= (.trait op) (.operator-trait cx))
                 (= ty (.operator-type cx))))))

;;; The operator spelling of the operation `f`, whose operands have type `ty`, or
;;; `_` when its operator cannot be spelled at NODE. Its context-typed operands are
;;; rewritten ALL THE WAY DOWN in the same replacement: the fixer drops an inner
;;; edit that overlaps an outer one, and the outer operator needs a leading
;;; context-typed operand already spelled (and ascribed) to dispatch on `ty`. Other
;;; operands are kept as they are; the next round finds their own rewrites.
(defn pr-operator-rewrite [(cx PrCx) (node Code) (f Code) (ty Code)] (-> Code)
  (match (pr-operator (names/ln-head-text f) (.env cx))
    (Some [op]
      (if (pr-rewritable? cx op ty)
          (let [head (pr-operator-at node op)
                a (get f 1)
                a2 (pr-operand-rewrite cx node a ty)
                b2 (pr-operand-rewrite cx node (get f 2) ty)
                ; an operator call on `ty` needs no ascription; a context-typed
                ; operand left as it is does
                lead (if (and (= a2 a) (names/ln-context-typed? a (.env cx)))
                         (pr-first-operand a ty)
                         a2)]
            (if (= head `_) `_ `(~head ~lead ~b2)))
          f))
    (None [] f)))

;;; A context-typed operand of an operator rewrite, spelled with operators where
;;; it can be; one whose operation has no operator for `ty`, or cannot spell it
;;; here, stays as it is.
(defn pr-operand-rewrite [(cx PrCx) (node Code) (x Code) (ty Code)] (-> Code)
  (if (or (pr-literal? x) (not (names/ln-context-typed? x (.env cx))))
      x
      (let [r (pr-operator-rewrite cx node x ty)]
        (if (= r `_) x r))))

;;; Is `f` a call of one of coil.core's operators, `(| a b …)`, in any spelling
;;; that reaches it? Their operands share one type, as the primitives' do.
(defn pr-core-operator? [(f Code)] (-> bool)
  (let [head (get f 0)
        text (names/ln-head-text f)]
    ; every spelling ends in the operator; most call heads end in a letter
    (block :found
      (unless (and (> (len text) 0) (pr-operator-byte? (get text (- (len text) 1))))
        (break :found false))
      (for entry `((+ Add) (- Sub) (* Mul) (/ Div) (% Rem) (& BitAnd) (| BitOr)
                   (^ BitXor) (<< Shl) (>> Shr) (< Ord) (<= Ord) (> Ord) (>= Ord) (= Eq))
        (let [o (get entry 0)
              name (primitive/code-sym o)]
          (when (or (= head o)
                    (= head (primitive/code-symbol (primitive/code-symbol (get entry 1) "::") name))
                    (= head (primitive/code-symbol "coil.core." name)))
            (break :found (names/ln-reaches? f head (primitive/code-str "coil.core." name))))))
      false)))

(defn pr-operator-byte? [(b u8)] (-> bool)
  (let [bytes "+-*/%&|^<>="
        (mut found) false
        (mut k) 0]
    (while (and (not found) (< k (len bytes)))
      (when (= (get bytes k) b) (set! found true))
      (set! k (+ k 1)))
    found))

(defn pr-primitive-compare? [(head (slice u8)) (env Code)] (-> bool)
  (or (names/ln-is? head env "coil.primitive/icmp-eq")
      (names/ln-is? head env "coil.primitive/icmp-ne")
      (names/ln-is? head env "coil.primitive/icmp-lt")
      (names/ln-is? head env "coil.primitive/icmp-le")
      (names/ln-is? head env "coil.primitive/icmp-gt")
      (names/ln-is? head env "coil.primitive/icmp-ge")
      (names/ln-is? head env "coil.primitive/fcmp-eq")
      (names/ln-is? head env "coil.primitive/fcmp-ne")
      (names/ln-is? head env "coil.primitive/fcmp-lt")
      (names/ln-is? head env "coil.primitive/fcmp-le")
      (names/ln-is? head env "coil.primitive/fcmp-gt")
      (names/ln-is? head env "coil.primitive/fcmp-ge")))

;;; The type a context-typed operand of `f` takes, when `f` is an operation whose
;;; operands share one type and the lint can tell which; `_` otherwise. A
;;; context-typed operation passes down its own context's type; any other takes
;;; it from the operands the checker typed, so in
;;; `(| (primitive/ishl 3 30) (<< rs 16))` the shift is on `rs`'s type.
(defn pr-operand-context [(cx PrCx) (f Code)] (-> Code)
  (if (or (primitive/code-vector? f) (< (len f) 3))
      `_
      (let [head (names/ln-head-text f)
            env (.env cx)]
        (cond (and (= (len f) 3) (names/ln-primitive-binop? head env))
                (if (names/ln-context-typed? f env)
                    (.literal-type cx)
                    (pr-operand-type f env))
              (and (= (len f) 3) (pr-primitive-compare? head env))
                (pr-operand-type f env)
              (pr-core-operator? f) (pr-operand-type f env)
              :else `_))))

; ---- the walk --------------------------------------------------------------
(defstruct PrCx
  [(modules Code)
   (module Code)
   (env Code)
   (top Code)  ; the top-level form being walked, for the shadow check
   (operator-trait Code)  ; the operator trait an enclosing impl defines, or `_`
   (operator-type Code)  ; the type that impl is for
   ; the type this position gives a context-typed form, when the lint can know
   ; it: a `(const NAME TYPE …)` initializer, an ascription, and the operands of
   ; an operation whose operand type is known (pr-operand-context). `_` elsewhere.
   (literal-type Code)])

(defn pr-with-literal-type [(cx PrCx) (ty Code)] (-> PrCx)
  (PrCx :modules (.modules cx) :module (.module cx) :env (.env cx) :top (.top cx)
        :operator-trait (.operator-trait cx) :operator-type (.operator-type cx)
        :literal-type ty))

;;; Suggest `f`'s everyday spelling. True when it suggested an operator rewrite,
;;; whose replacement already spells `f`'s context-typed operands.
(defn pr-suggest! [(cx PrCx) (f Code)] (-> bool)
  (let [head (names/ln-head-text f)
        alias (pr-alias head (.env cx))]
    (if (not (= alias `_))
        (let [name (primitive/code-sym alias)]
          (unless (or (pr-mentions-value? (.top cx) name)
                      (pr-module-shadows? (.modules cx) (.module cx) name))
            (names/ln-suggest f
                               "coil.core spells this without coil.primitive"
                               `(~alias ~@(pr-tail f 1)))
            0)
          false)
        (match (pr-operator head (.env cx))
          (Some [op]
            (and (= (len f) 3)
                 (let [ty (if (names/ln-context-typed? f (.env cx))
                              (.literal-type cx)
                              (pr-operand-type f (.env cx)))]
                   (and (pr-rewritable? cx op ty)
                        (let [replacement (pr-operator-rewrite cx f f ty)]
                          (and (not (= replacement `_))
                               (do (names/ln-suggest f
                                                     "use the operator; for this type it is the same operation"
                                                     replacement)
                                   true)))))))
          (None [] false)))))

;;; Where an `(impl …)` form names its trait: after the optional type-parameter
;;; vector. Its type follows.
(defn pr-impl-trait-at [(f Code)] (-> i64)
  (if (primitive/code-vector? (get f 1)) 2 1))

;;; The type an `(impl Trait Type …)` form is for, or `_`.
(defn pr-impl-type [(f Code)] (-> Code)
  (let [at (+ (pr-impl-trait-at f) 1)]
    (if (< at (len f)) (get f at) `_)))

;;; The operator trait an `(impl …)` form implements, or `_`.
(defn pr-impl-trait [(f Code)] (-> Code)
  (let [trait (get f (pr-impl-trait-at f))]
    (if (and (primitive/code-sym? trait)
             (or (= trait `Add) (= trait `Sub)
                 (= trait `Mul) (= trait `Div)
                 (= trait `Rem) (= trait `BitAnd)
                 (= trait `BitOr) (= trait `BitXor)
                 (= trait `Shl) (= trait `Shr)
                 (= trait `Ord) (= trait `Eq)))
        trait
        `_)))

(defn pr-body-start [(f Code) (i i64) (fallback i64)] (-> i64)
  (if (>= i (len f))
      fallback
      (if (pr-head? (get f i) `->)
          (+ i 1)
          (pr-body-start f (+ i 1) fallback))))

;;; A template's text is data; only its holes are code (names/ln-template-holes).
(defn pr-walk [(cx PrCx) (f Code)] (-> i64)
  (if (names/ln-quasiquote? f)
      (do (for hole (names/ln-template-holes f) (pr-walk cx hole)) 0)
      (pr-walk-form cx f)))

(defn pr-walk-form [(cx PrCx) (f Code)] (-> i64)
  (when (and (primitive/code-list? f)
             (not (pr-head? f `defstruct))
             (not (pr-head? f `defsum))
             (not (names/ln-import? f)))
    (let [covered (and (not (primitive/code-vector? f))
                       (not (primitive/code-macro? f))
                       (pr-suggest! cx f))
          operand-type (pr-operand-context cx f)]
      (cond ; `(const NAME TYPE INIT)`: INIT is typed by the declaration
            (and (pr-head? f `const) (= (len f) 4))
              (pr-walk (pr-with-literal-type cx (get f 2)) (get f 3))
            ; `(: X TYPE)` states X's type
            (and (pr-head? f `:) (= (len f) 3))
              (pr-walk (pr-with-literal-type cx (get f 2)) (get f 1))
            ; an operation whose operands share a type the lint knows gives it to
            ; its context-typed operands, unless its own replacement spells them
            (not (= operand-type `_))
              (pr-operands cx f operand-type covered)
            (or (pr-head? f `defn) (pr-head? f `defn*))
              (let [start (pr-body-start f 2 3)]
                (pr-body cx f start (pr-return-type f start)))
            (pr-head? f `fn) (pr-kids cx f 2)
            (pr-head? f `impl)
              (pr-methods (PrCx :modules (.modules cx) :module (.module cx) :env (.env cx)
                                :top (.top cx) :operator-trait (pr-impl-trait f)
                                :operator-type (pr-impl-type f) :literal-type `_)
                          f)
            (pr-head? f `deftrait) (pr-methods cx f)
            :else (pr-kids cx f 0))))
  0)

;;; The operands of an operation whose operands have type `ty`. A context-typed
;;; one takes `ty`; when the operation's own replacement already spells it
;;; (`covered`) it is not walked at all.
(defn pr-operands [(cx PrCx) (f Code) (ty Code) (covered bool)] (-> i64)
  (let [(mut k) 1]
    (while (< k (len f))
      (let [x (get f k)]
        (if (names/ln-context-typed? x (.env cx))
            (unless covered (pr-walk (pr-with-literal-type cx ty) x) 0)
            (pr-walk (pr-with-literal-type cx `_) x)))
      (set! k (+ k 1))))
  0)

;;; Walk `f`'s children from `from`. A child is not a const initializer or a
;;; context-typed operand, so nothing is known about its literal type.
(defn pr-kids [(cx PrCx) (f Code) (from i64)] (-> i64)
  (let [inner (pr-with-literal-type cx `_)
        (mut k) from]
    (while (< k (len f))
      (pr-walk inner (get f k))
      (set! k (+ k 1))))
  0)

;;; Methods of an impl or trait: `(name annotations… [params] (-> R) body…)`,
;;; parameters skipped.
(defn pr-methods [(cx PrCx) (f Code)] (-> i64)
  (let [(mut k) 1]
    (while (< k (len f))
      (let [m (get f k)
            at (names/ln-method-params-at m)]
        (when (>= at 0)
          (let [start (pr-body-start m (+ at 1) (+ at 1))]
            (pr-body cx m start (pr-return-type m start)))))
      (set! k (+ k 1))))
  0)

;;; The `T` of the `(-> T)` form a body starts after, or `_` when there is none.
(defn pr-return-type [(f Code) (start i64)] (-> Code)
  (let [arrow (get f (- start 1))]
    (if (and (pr-head? arrow `->) (= (len arrow) 2)) (get arrow 1) `_)))

;;; A body: `f`'s children from `from`, the last of which is its value, of type
;;; `ty` (or `_`).
(defn pr-body [(cx PrCx) (f Code) (from i64) (ty Code)] (-> i64)
  (let [inner (pr-with-literal-type cx `_)
        (mut k) from]
    (while (< k (len f))
      (if (= k (- (len f) 1))
          (pr-value cx (get f k) ty)
          (pr-walk inner (get f k)))
      (set! k (+ k 1))))
  0)

;;; A form whose value is the value of a body of type `ty`, so a context-typed one
;;; has that type: `(defn nop [] (-> i64) (primitive/ior 3 4))`. The value of an
;;; `if`, a `do` or a `let` is in tail position too.
(defn pr-value [(cx PrCx) (f Code) (ty Code)] (-> i64)
  (let [head (names/ln-head-text f)
        env (.env cx)]
    (cond (= ty `_) (pr-walk (pr-with-literal-type cx `_) f)
          (and (= head "if") (= (len f) 4))
            (do (pr-walk (pr-with-literal-type cx `_) (get f 1))
                (pr-value cx (get f 2) ty)
                (pr-value cx (get f 3) ty))
          (= head "do") (pr-body cx f 1 ty)
          (or (= head "let*") (names/ln-is? head env "coil.core/let")
              (names/ln-is? head env "coil.binding/let"))
            (pr-body cx f 1 ty)
          :else (pr-walk (pr-with-literal-type cx ty) f))))

; ---- the import ------------------------------------------------------------
;;; The alias a `(import "coil.primitive" :as alias)` binds, or "" for any other
;;; import (including one with `:use`, whose names this checker does not track).
(defn pr-primitive-alias [(f Code)] (-> (slice u8))
  (if (and (names/ln-import? f)
           (= (primitive/code-str (get f 1)) "coil.primitive")
           (not (names/ln-has-clause? f `:use)))
      (if (names/ln-has-clause? f `:as)
          (primitive/code-sym (names/ln-clause f `:as))
          "coil.primitive")
      ""))

;;; Does `f` mention any symbol qualified by `alias/`?
(defn pr-mentions-qualifier? [(f Code) (alias (slice u8))] (-> bool)
  (cond (primitive/code-sym? f) (= (names/ln-alias-part (primitive/code-sym f)) alias)
        (primitive/code-list? f)
          (let [(mut found) false
                (mut k) 0]
            (while (and (not found) (< k (len f)))
              (when (pr-mentions-qualifier? (get f k) alias)
                (set! found true))
              (set! k (+ k 1)))
            found)
        :else false))

;;; Delete a coil.primitive import nothing in the module uses any more. The
;;; rewrites above land first; the fixer's next round finds the import idle.
(defn pr-import! [(m Code)] (-> i64)
  (let [(mut k) 1]
    (while (< k (len m))
      (let [f (get m k)
            alias (pr-primitive-alias f)]
        (when (and (> (len alias) 0) (primitive/code-from-user? f))
          (let [(mut used) false
                (mut j) 1]
            (while (and (not used) (< j (len m)))
              (let [g (get m j)]
                (when (and (not (names/ln-import? g)) (pr-mentions-qualifier? g alias))
                  (set! used true)))
              (set! j (+ j 1)))
            (unless used
              (primitive/delete f "nothing in this module needs coil.primitive any more")
              0))))
      (set! k (+ k 1))))
  0)

; ---- entry -----------------------------------------------------------------
(defn pr-user-module? [(m Code)] (-> bool)
  (let [(mut found) false
        (mut k) 1]
    (while (and (not found) (< k (len m)))
      (when (primitive/code-from-user? (get m k)) (set! found true))
      (set! k (+ k 1)))
    found))

(defn pr-module! [(modules Code) (prelude Code) (m Code)] (-> i64)
  (when (and (> (len m) 1) (pr-user-module? m))
    (let [env (names/ln-env prelude m)
          (mut k) 1]
      (while (< k (len m))
        (let [f (get m k)]
          (pr-walk (PrCx :modules modules :module m :env env :top f
                         :operator-trait `_ :operator-type `_ :literal-type `_) f))
        (set! k (+ k 1)))
      (pr-import! m)))
  0)

(defn no-unneeded-primitives [(modules Code)] (-> Code)
  (let [prelude (names/ln-prelude modules 0 (len modules))
        (mut k) 0]
    (while (< k (len modules))
      (pr-module! modules prelude (get modules k))
      (set! k (+ k 1)))
    `0))

(checker no-unneeded-primitives)
