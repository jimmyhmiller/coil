(module coil.lint.primitives)
(import "coil.primitive" :as primitive)
(import "coil.meta" :as meta)
(import "coil.lint.names" :as names)

; Ordinary code should not need `coil.primitive`. Most `primitive/…` calls in
; application code have an everyday spelling with the same meaning, and this
; checker rewrites them to it; when a module has nothing left that needs the
; namespace, its `(import "coil.primitive" …)` goes too. Part of the default lint
; profile, so `coil lint --fix` always applies it.
;
; Two kinds of rewrite, both exact:
;
;   * Aliases. coil.core defines `index`, `sizeof`, `alignof`, … as `(def index
;     primitive/index)` — the same operation under a bare name. The rewrite only
;     changes the spelling, so it is withheld wherever the bare name could mean
;     something else: a module that defines or imports that name, or a form that
;     mentions it as anything but a call head (a local named `index`, say).
;
;   * Not `iadd`, `isub`, `imul` or `cast`. They are the WRAPPING arithmetic and the
;     RAW conversion, and under coil.safety `+ - *` and `cast` are checked while
;     these never are, so the everyday spelling would change what the code does.
;     (A cast of a literal its type holds is no conversion at all: coil.lint.modernize
;     writes it as an ascription.)
;
;   * Operators. The arithmetic, bitwise and float-ordering traits are
;     implemented in the prelude as one inlined primitive per standard type —
;     `(impl BitAnd u8 (& … (primitive/iand a b)))` — so `(primitive/iand a b)` on
;     u8 IS `(& a b)`. The rewrite is driven by the checked operand type and
;     happens only for types that have those impls (the eight standard integer
;     widths, f32, f64); an `i7` or `i128` operation keeps its primitive. `udiv`
;     and `urem` become `/` and `%` only on unsigned types, where they are the
;     same instruction. `fcmp-eq` is `=` on floats; `fcmp-ne` (ordered: false
;     when either side is NaN) and `frem` have no operator and stay primitive.
;     An operation on literals alone, `(primitive/ishl 3 30)`, has the type of
;     where it stands, and `type-of` answers that type.
;
; Not touched: the text of quasiquoted templates (they expand in another module,
; whose names this module cannot vouch for; the code under `~` is linted), code a
; macro generated, and an operator on the
; very type whose impl DEFINES it — rewriting `(primitive/iand a b)` inside
; `(impl BitAnd i64 (& …))` would make `&` call itself. (The same primitive on
; another type in that impl, say `(impl Add V2 …)` adding f32 fields, is fine.)
;
; It does not walk the program. The forms it rewrites are the calls the compiler
; resolved to each coil.primitive operation it knows a spelling for
; (names/ln-calls-of), and what it needs to know about one — the type it operates
; on, the impl around it, whether a bare name reaches coil.core there — it asks
; about that call.

; ---- shapes ----------------------------------------------------------------
(defn pr-head? [(f Code) (name Code)] (-> bool)
  (and (primitive/code-list? f)
       (not (primitive/code-vector? f))
       (> (len f) 0)
       (= (get f 0) name)))

(defn pr-tail [(f Code) (from i64)] (-> Code)
  (let [out (primitive/code-list-new)
        n (len f)
        (mut k) from]
    (while (< k n)
      (primitive/code-list-push! out (get f k))
      (set! k (+ k 1)))
    (primitive/code-list-done out)))

; ---- aliases ---------------------------------------------------------------
;;; The coil.primitive operations coil.core spells without it, each with its
;;; coil.core alias. `load`, `store!` and `field` are aliases too, but
;;; coil.lint.field-syntax already rewrites those (to `set!` and `.field` where it
;;; can), and two checkers editing one form would collide.
(defn pr-aliases [] (-> Code)
  `((coil.primitive.index index) (coil.primitive.sizeof sizeof)
    (coil.primitive.alignof alignof) (coil.primitive.offsetof offsetof)
    (coil.primitive.zeroed zeroed) (coil.primitive.fnptr-of fnptr-of)
    (coil.primitive.call-ptr call-ptr)))

;;; Does the bare ALIAS, as a call head at F, mean the operation F calls? Not
;;; where a local, the module's own definition or an import binds that name
;;; (names/ln-reaches?): `resolve-at` answers what the parser would take it for.
(defn pr-alias-reaches? [(f Code) (alias Code) (qname Code)] (-> bool)
  (names/ln-reaches? f alias (primitive/code-sym qname)))

(defn pr-alias! [(f Code) (alias Code) (qname Code)] (-> i64)
  ; already the everyday spelling
  (unless (or (= (names/ln-head-text f) (primitive/code-sym alias))
              (not (pr-alias-reaches? f alias qname)))
    (names/ln-suggest f "coil.core spells this without coil.primitive" `(~alias ~@(pr-tail f 1)))
    0)
  0)

; ---- operators -------------------------------------------------------------
(defn pr-int-type? [(ty Code)] (-> bool)
  (or (= ty `i8) (= ty `i16)
      (= ty `i32) (= ty `i64)
      (pr-unsigned-type? ty)))

(defn pr-unsigned-type? [(ty Code)] (-> bool)
  (or (= ty `u8) (= ty `u16)
      (= ty `u32) (= ty `u64)))

(defn pr-float-type? [(ty Code)] (-> bool)
  (or (= ty `f32) (= ty `f64)))

;;; What family of operand an operation takes: 1 = standard integer, 2 =
;;; unsigned integer only, 3 = f32/f64.
(defstruct PrOp [(operator Code) (family i64) (trait Code)])

;;; The operator of every coil.primitive operation that has one, by qualified name.
(defn pr-operators [] (-> Code)
  `((coil.primitive.idiv / 1 Div) (coil.primitive.irem % 1 Rem)
    (coil.primitive.iand & 1 BitAnd) (coil.primitive.ior | 1 BitOr)
    (coil.primitive.ixor ^ 1 BitXor) (coil.primitive.ishl << 1 Shl)
    (coil.primitive.ishr >> 1 Shr) (coil.primitive.udiv / 2 Div)
    (coil.primitive.urem % 2 Rem) (coil.primitive.fadd + 3 Add)
    (coil.primitive.fsub - 3 Sub) (coil.primitive.fmul * 3 Mul)
    (coil.primitive.fdiv / 3 Div) (coil.primitive.fcmp-lt < 3 Ord)
    (coil.primitive.fcmp-le <= 3 Ord) (coil.primitive.fcmp-gt > 3 Ord)
    (coil.primitive.fcmp-ge >= 3 Ord)
    ; fcmp-ne is the ORDERED not-equal (false when either side is NaN), while
    ; `!=` is `(not (= a b))`, true then; so only fcmp-eq has an operator.
    (coil.primitive.fcmp-eq = 3 Eq)))

(defn pr-entry-op [(entry Code)] (-> PrOp)
  (PrOp :operator (get entry 1) :family (primitive/code-int (get entry 2)) :trait (get entry 3)))

;;; The operator of the operation F calls, if it has one.
(defn pr-operator [(f Code)] (-> (Option PrOp))
  (block :found
    (when (and (primitive/code-list? f) (not (primitive/code-vector? f)) (> (len f) 0)
               (primitive/code-sym? (get f 0)))
      (match (meta/source-binding (get f 0))
        (primitive/BindsGlobal [q]
          (for entry (pr-operators)
            (when (= (get entry 0) q) (break :found (Some (pr-entry-op entry))))))
        (_ 0)))
    (None [PrOp])))

;;; Does the operation F compare (its operands share a type its result does not)?
(defn pr-compare? [(op PrOp)] (-> bool)
  (or (= (.trait op) `Ord) (= (.trait op) `Eq)))

(defn pr-family? [(family i64) (ty Code)] (-> bool)
  (cond (= family 1) (pr-int-type? ty)
        (= family 2) (pr-unsigned-type? ty)
        :else (pr-float-type? ty)))

;;; A numeric literal itself; the operator rewrite leaves one as it is.
(defn pr-literal? [(f Code)] (-> bool)
  (or (primitive/code-int? f) (primitive/code-float? f)))

;;; The type the operands of the operation F share, or `_`. An arithmetic or
;;; bitwise operation has its operands' type, so `type-of` F answers it — the type
;;; its context gives it when its operands are literals. A comparison's operands
;;; take it from each other: the first one whose type the checker reports.
(defn pr-operand-type [(f Code) (op PrOp)] (-> Code)
  (if (not (pr-compare? op))
      (match (primitive/type-of f)
        (primitive/TypeIs [t] t)
        (primitive/TypeUnknown [] `_))
      (block :found
        (for k (range 1 (len f))
          (match (primitive/type-of (get f k))
            (primitive/TypeIs [t] (break :found t))
            (primitive/TypeUnknown [] 0)))
        `_)))

;;; A trait method dispatches on its FIRST operand before a literal takes its
;;; width from context, so `(& 255 x)` with an i32 `x` would pick i64's `&`. A
;;; leading context-typed operand (a literal, or an operation left as a primitive)
;;; of a type other than the literal default is therefore ascribed.
(defn pr-first-operand [(a Code) (ty Code)] (-> Code)
  (if (= ty (if (pr-float-type? ty) `f64 `i64)) a `(: ~a ~ty)))

;;; The operator spelled so that it reaches its trait method at NODE: bare, then
;;; trait-qualified (`Add::+`), then module-qualified; `_` when none does
;;; (names/ln-spelling-at).
(defn pr-operator-at [(node Code) (op PrOp)] (-> Code)
  (let [o (.operator op)
        name (primitive/code-sym o)]
    (names/ln-spelling-at node
                          `(~o ~(primitive/code-symbol (primitive/code-symbol (.trait op) "::") name)
                               ~(primitive/code-symbol "coil.core." name))
                          (primitive/code-str "coil.core." name))))

;;; Is `op` on `ty` an operator call here? Not for a type without the impls, and
;;; not on the very type whose impl DEFINES it: inside `(impl Add i64 (+ …))` the
;;; primitive IS `+` on i64, and `+` there would call itself.
(defn pr-rewritable? [(f Code) (op PrOp) (ty Code)] (-> bool)
  (and (pr-family? (.family op) ty)
       (not (pr-defining-impl? f (.trait op) ty))))

;;; Is F inside `(impl TRAIT TY …)`?
(defn pr-defining-impl? [(f Code) (trait Code) (ty Code)] (-> bool)
  (block :found
    (for up (iter (names/ln-ancestors f))
      (when (pr-head? up `impl)
        (break :found (and (= (pr-impl-trait up) trait) (= (pr-impl-type up) ty)))))
    false))

;;; Does X have its type whatever stands around it: a name, a field read, an
;;; ascription, or a call of a function? A literal does not, and neither does a form that yields one — `(when
;;; c 1)`, an `if`, a macro's expansion — so as an operator's first operand, whose
;;; type picks the operator's method, it is ascribed.
(defn pr-self-typed? [(x Code)] (-> bool)
  (cond (primitive/code-sym? x) true
        (or (not (primitive/code-list? x)) (primitive/code-vector? x) (= (len x) 0)) false
        (not (primitive/code-sym? (get x 0))) false
        (names/ln-literal-typed? x) false
        ; a field read `(.f x)` and an ascription `(: x T)`
        (let [h (names/ln-head-text x)]
          (or (= h ":") (and (> (len h) 1) (= (get h 0) (get "." 0)))))
          true
        :else
          (match (meta/source-binding (get x 0))
            (primitive/BindsGlobal [_] (not (names/ln-macro-call? x)))
            (_ false))))

;;; The operator spelling of the operation F, whose operands have type TY, or
;;; `_` when its operator cannot be spelled at NODE. Its context-typed operands are
;;; rewritten ALL THE WAY DOWN in the same replacement: the fixer drops an inner
;;; edit that overlaps an outer one, and the outer operator needs a leading
;;; context-typed operand already spelled (and ascribed) to dispatch on TY. Other
;;; operands are kept as they are; their own calls are rewritten on their own.
(defn pr-operator-rewrite [(node Code) (f Code) (ty Code)] (-> Code)
  (match (pr-operator f)
    (Some [op]
      (if (and (= (len f) 3) (pr-rewritable? node op ty))
          (let [head (pr-operator-at node op)
                a (get f 1)
                a2 (pr-operand-rewrite node a ty)
                b2 (pr-operand-rewrite node (get f 2) ty)
                ; an operator call on TY needs no ascription; an operand left as
                ; it is does unless it has a type of its own
                lead (if (and (= a2 a) (not (pr-self-typed? a)))
                         (pr-first-operand a ty)
                         a2)]
            (if (= head `_) `_ `(~head ~lead ~b2)))
          f))
    (None [] f)))

;;; A context-typed operand of an operator rewrite, spelled with operators where
;;; it can be; one whose operation has no operator for TY, or cannot spell it
;;; here, stays as it is.
(defn pr-operand-rewrite [(node Code) (x Code) (ty Code)] (-> Code)
  (if (or (pr-literal? x) (not (names/ln-literal-typed? x)))
      x
      (let [r (pr-operator-rewrite node x ty)]
        (if (= r `_) x r))))

;;; The rewrite of the operation F to its operator, or `_`.
(defn pr-operator-replacement [(f Code) (op PrOp)] (-> Code)
  (if (= (len f) 3)
      (let [ty (pr-operand-type f op)]
        (if (pr-rewritable? f op ty) (pr-operator-rewrite f f ty) `_))
      `_))

;;; Does a rewrite around F already spell it? A context-typed operation is
;;; rewritten as an operand of the operation it stands in, when that one is.
(defn pr-covered? [(f Code)] (-> bool)
  (and (names/ln-literal-typed? f)
       (let [up (names/ln-parent f)]
         (match (pr-operator up)
           (Some [op] (or (not (= (pr-operator-replacement up op) `_)) (pr-covered? up)))
           (None [] false)))))

(defn pr-operator! [(f Code) (op PrOp)] (-> i64)
  (unless (pr-covered? f)
    (let [replacement (pr-operator-replacement f op)]
      (unless (= replacement `_)
        (names/ln-suggest f "use the operator; for this type it is the same operation" replacement)
        0)))
  0)

;;; Where an `(impl …)` form names its trait: after the optional type-parameter
;;; vector. Its type follows.
(defn pr-impl-trait-at [(f Code)] (-> i64)
  (if (primitive/code-vector? (get f 1)) 2 1))

;;; The type an `(impl Trait Type …)` form is for, or `_`.
(defn pr-impl-type [(f Code)] (-> Code)
  (let [at (+ (pr-impl-trait-at f) 1)]
    (if (< at (len f)) (get f at) `_)))

;;; The operator trait an `(impl …)` form implements, or `_`.
(defn pr-impl-trait [(f Code)] (-> Code)
  (let [trait (get f (pr-impl-trait-at f))]
    (if (and (primitive/code-sym? trait)
             (or (= trait `Add) (= trait `Sub)
                 (= trait `Mul) (= trait `Div)
                 (= trait `Rem) (= trait `BitAnd)
                 (= trait `BitOr) (= trait `BitXor)
                 (= trait `Shl) (= trait `Shr)
                 (= trait `Ord) (= trait `Eq)))
        trait
        `_)))

; ---- the import ------------------------------------------------------------
;;; The alias a `(import "coil.primitive" :as alias)` binds, or "" for any other
;;; import (including one with `:use`, whose names this checker does not track).
(defn pr-primitive-alias [(f Code)] (-> (slice u8))
  (if (and (names/ln-import? f)
           (= (primitive/code-str (get f 1)) "coil.primitive")
           (not (names/ln-has-clause? f `:use)))
      (if (names/ln-has-clause? f `:as)
          (primitive/code-sym (names/ln-clause f `:as))
          "coil.primitive")
      ""))

;;; Does `f` mention any symbol qualified by `alias/`?
(defn pr-mentions-qualifier? [(f Code) (alias (slice u8))] (-> bool)
  (cond (primitive/code-sym? f) (= (names/ln-alias-part (primitive/code-sym f)) alias)
        (primitive/code-list? f)
          (let [(mut found) false
                (mut k) 0]
            (while (and (not found) (< k (len f)))
              (when (pr-mentions-qualifier? (get f k) alias)
                (set! found true))
              (set! k (+ k 1)))
            found)
        :else false))

;;; Delete a coil.primitive import nothing in the module uses any more: no
;;; reference resolved through it (meta/references-through), and no template of the
;;; module names it — a template's text is resolved where it expands, so it is no
;;; reference here. The rewrites above land first; the fixer's next round finds the
;;; import idle.
(defn pr-imports! [(m Code)] (-> i64)
  (for record (iter (names/ln-view (meta/imports m)))
    (let [f (meta/import-node record)
          alias (pr-primitive-alias f)]
      (when (and (> (len alias) 0)
                 (= (len (names/ln-view (meta/references-through record))) 0)
                 (not (block :named
                        (for template (iter (names/ln-view (meta/forms-headed m `quasiquote)))
                          (when (pr-mentions-qualifier? template alias) (break :named true)))
                        false)))
        (primitive/delete f "nothing in this module needs coil.primitive any more")
        0)))
  0)

; ---- entry -----------------------------------------------------------------
(defn no-unneeded-primitives [(modules Code)] (-> Code)
  (for entry (pr-aliases)
    (for f (iter (names/ln-calls-of (get entry 0)))
      (pr-alias! f (get entry 1) (get entry 0))))
  (for entry (pr-operators)
    (let [op (pr-entry-op entry)]
      (for f (iter (names/ln-calls-of (get entry 0)))
        (pr-operator! f op))))
  (for m (iter (names/ln-user-modules)) (pr-imports! m))
  `0)

(checker no-unneeded-primitives)
