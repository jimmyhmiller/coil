(module coil.debug-allocator)
(import "coil.primitive" :as primitive)

; A debug allocator in the manner of Zig's `DebugAllocator` (mem-2) — the
; `--debug-checks` build mode's answer to "use-after-free / double-free are bare
; signals with zero diagnostic, below C". It wraps any allocator and
;
;   * records the stack of every allocation and of every free, so a double free or a
;     leak says where the block came from (and, for a double free, where it was first
;     freed);
;   * poisons freed blocks and quarantines them, up to a byte limit (64 MiB by
;     default, `debug-allocator-set-quarantine-limit!`; 0 means unbounded), so a
;     double free or a stray free is caught while the block is held and memory
;     stays bounded;
;   * guards every block with canaries before and after it;
;   * reports leaks, with allocation stacks, when torn down, and for the
;     process-wide instance (`debug-allocator-global`) when the program exits.
;
;   (import "coil.debug-allocator" :use *)
;   (let [a (debug-allocator (malloc-allocator))] …)   ; wrap ANY allocator
;
; The explicit init/view/deinit API is a Zig-style stateful allocator: wrap any backing
; allocator, pass its ordinary Allocator view through existing APIs, then deinit to
; reclaim quarantine and obtain a live-leak count. `(debug-allocator inner)` is the
; zero-cost convenience macro: with --debug-checks OFF it is exactly `inner`; ON it
; creates the same registry-backed wrapper without requiring explicit teardown.
; It lives in its OWN module (not src/stdlib/alloc.coil) so the always-loaded core allocator
; stays byte-for-byte unchanged in release builds — the debug hooks are concrete C-ABI
; functions that mono cannot dead-strip, so bundling them into alloc.coil would emit
; them into every allocating program. This module is loaded only when imported.
(export DebugAllocator
        debug-allocator-init
        debug-allocator-view
        debug-allocator-deinit!
        debug-allocator-set-quarantine-limit!
        debug-allocator-report-leaks!
        debug-allocator-global
        debug-allocator)

(import "coil.alloc" :as alloc :use *)  ; Allocator, raw-alloc/raw-free, create, abort

(import "coil.atomic" :use [atomic-cas atomic-store])
(import "coil.slice" :use *)  ; slice-data / slice-len for the diagnostic message

(import "coil.hashmap" :use [HashMap hm-new-scalar hm-put! hm-get hm-remove! hm-free!])

;;; write(2) for the diagnostic. Kept module-private (only `debug-allocator` is exported)
;;; so it never collides with io.coil's `write` through a `:use *` re-export.
(extern write :cc c [i32 (ptr i8) isize] (-> isize))  ; ssize_t write(int fd, const void*, size_t)

;;; backtrace(3), declared only where it exists: a wasm module cannot walk its own
;;; stack, so there the traces are empty.
(defn dbg-wasm-target? [] (-> bool)
  (let [arch (primitive/target-arch)]
    (or (primitive/code-eq arch `wasm32) (primitive/code-eq arch `wasm64))))

(defn dbg-trace-externs [] (-> Code)
  (if (dbg-wasm-target?)
      `(do)
      ; hygiene: the libc symbols the traces call enter this module by their C names.
      `(do (extern ~(primitive/syntax->datum `backtrace) :cc c [(ptr (ptr i8)) i32] (-> i32))
           (extern ~(primitive/syntax->datum `backtrace_symbols_fd) :cc c [(ptr (ptr i8)) i32 i32]
                   (-> void)))))
(meta (dbg-trace-externs))

(defn dbg-native [(code Code)] (-> Code)
  (if (dbg-wasm-target?) `0 code))

;;; mprotect(2), to make a freed block's whole pages inaccessible: a read or write
;;; through a stale pointer then faults at the access instead of reading poison.
(defn dbg-memory-externs [] (-> Code)
  (if (dbg-wasm-target?)
      `(do)
      ; hygiene: the libc symbols the page protection below calls enter this module by their C names.
      `(do (extern ~(primitive/syntax->datum `mprotect) :cc c [(ptr i8) isize i32] (-> i32))
           (extern ~(primitive/syntax->datum `getpagesize) :cc c [] (-> i32)))))
(meta (dbg-memory-externs))

;;; Frames kept per allocation and per free, and how many of the innermost are the
;;; allocator's own and so not worth printing.
(defn dbg-trace-depth [] (-> i64)
  12)

(defn dbg-trace-skip [] (-> i64)
  2)

;;; A live block's header magic (0xDEADBEEF) and a freed block's (0xDEADDEAD). Chosen to be
;;; wildly improbable as real leading payload words, and to make a freed block obvious.
(defn dbg-magic-live [] (-> i64)
  3735928559)  ; 0xDEADBEEF

(defn dbg-magic-dead [] (-> i64)
  3735936685)  ; 0xDEADFDED

;;; Metadata is kept separately from user storage. Free first finds the exact
;;; payload in this allocator-owned registry, so an arbitrary or interior pointer
;;; is diagnosed without dereferencing memory derived from that pointer.
(defstruct DbgRecord
  [(next (ptr DbgRecord))
   (prev (ptr DbgRecord))  ; the list of every record, live or quarantined
   (qnext (ptr DbgRecord))  ; the quarantine, oldest first
   (alloc-depth i64)
   (free-depth i64)
   (alloc-frames (array (ptr i8) 12))
   (free-frames (array (ptr i8) 12))
   (base (ptr i8))
   (payload (ptr i8))
   (total i64)
   (type-id i64)
   (count i64)
   (size i64)
   (alignment i64)
   (magic i64)])

(defstruct DebugAllocator
  [(inner (dyn alloc/Allocator))
   (head (ptr DbgRecord))
   ; payload address -> its record, live or quarantined. A quarantined block is
   ; never handed back to `inner`, so an address names one record for the whole
   ; life of the allocator, and a free is a lookup rather than a walk over every
   ; allocation ever made — which made a free-heavy program quadratic.
   (index (HashMap i64 (ptr DbgRecord)))
   (lock i64)
   (live-allocations i64)
   (quarantined-bytes i64)
   (quarantine-limit i64)
   (qhead (ptr DbgRecord))
   (qtail (ptr DbgRecord))])

(defn dbg-prefix-bytes [] (-> i64)
  32)

(defn dbg-tail-bytes [] (-> i64)
  16)

(defn dbg-front-byte [] (-> i8)
  (primitive/cast i8 205))  ; 0xCD

(defn dbg-tail-byte [] (-> i8)
  (primitive/cast i8 171))  ; 0xAB

(defn dbg-report! [(msg (slice u8))] (-> i64)
  (write 2
         (primitive/cast (ptr i8) (slice-data msg))
         (primitive/cast isize (slice-len msg)))
  (abort)
  0)

;;; Fill `frames` with the current stack, innermost first, and return how many.
(defn dbg-capture [(frames (ptr (ptr i8)))] (-> i64)
  (dbg-native (primitive/cast i64 (backtrace frames (primitive/cast i32 (dbg-trace-depth))))))

;;; Print `label` and the frames of one stack, skipping the allocator's own.
(defn dbg-put-trace! [(label (slice u8)) (frames (ptr (ptr i8))) (depth i64)] (-> i64)
  (write 2
         (primitive/cast (ptr i8) (slice-data label))
         (primitive/cast isize (slice-len label)))
  (if (> depth (dbg-trace-skip))
      (dbg-native (do (backtrace_symbols_fd (primitive/index frames (dbg-trace-skip))
                                           (primitive/cast i32 (primitive/isub depth (dbg-trace-skip)))
                                           2)
                      0))
      (write 2 (primitive/cast (ptr i8) c"  (no stack was recorded)\n") 27))
  0)

;;; Report a misuse of `record`, with where it was allocated and, if it was freed,
;;; where, and abort.
(defn dbg-report-record! [(msg (slice u8)) (record (ptr DbgRecord))] (-> i64)
  (write 2
         (primitive/cast (ptr i8) (slice-data msg))
         (primitive/cast isize (slice-len msg)))
  (when (= (load (field record magic)) (dbg-magic-dead))
    (dbg-put-trace! "first freed at:\n"
                    (primitive/cast (ptr (ptr i8)) (field record free-frames))
                    (load (field record free-depth))))
  (dbg-put-trace! "allocated at:\n"
                  (primitive/cast (ptr (ptr i8)) (field record alloc-frames))
                  (load (field record alloc-depth)))
  (abort)
  0)

;;; Make the whole pages inside a block's payload inaccessible (`prot` 0) or
;;; accessible again (`prot` 3). A block that holds no whole page is only poisoned.
(defn dbg-protect! [(record (ptr DbgRecord)) (prot i32)] (-> i64)
  (dbg-native
    (let [page (primitive/cast i64 (getpagesize))
          payload (primitive/cast i64 (load (field record payload)))
          base (primitive/cast i64 (load (field record base)))
          own-pages (= (primitive/isub payload base) page)
          start (if own-pages payload (dbg-align-up payload page))
          finish (if own-pages
                     (primitive/iadd base (load (field record total)))
                     (primitive/imul (primitive/udiv (primitive/iadd payload (load (field record size))) page)
                                     page))]
      (when (> finish start)
        (mprotect (primitive/cast (ptr i8) start)
                  (primitive/cast isize (primitive/isub finish start))
                  prot)
        0)
      0)))

;;; Overwrite n payload bytes with 0xDE (a manual loop — no memset extern to collide).
(defn dbg-poison! [(p (ptr i8)) (n i64)] (-> i64)
  (let [(mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (store! (primitive/index p (load i)) (primitive/cast i8 222))  ; 0xDE
                (store! i (primitive/iadd (load i) 1))))))
  0)

(defn dbg-fill! [(p (ptr i8)) (n i64) (value i8)] (-> i64)
  (let [(mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (store! (primitive/index p (load i)) value)
                (store! i (primitive/iadd (load i) 1))))))
  0)

(defn dbg-align-up [(address i64) (alignment i64)] (-> i64)
  (primitive/imul (primitive/udiv (primitive/iadd address
                                                  (primitive/isub alignment 1))
                                  alignment)
                  alignment))

(defn dbg-lock! [(state (ptr DebugAllocator))] (-> i64)
  (loop (if (= (atomic-cas (field state lock) 0 1) 0)
            (break)
            0))
  0)

(defn dbg-unlock! [(state (ptr DebugAllocator))] (-> i64)
  (atomic-store (field state lock) 0))

(defn dbg-find-record [(state (ptr DebugAllocator)) (payload (ptr i8))] (-> (ptr DbgRecord))
  (match (hm-get [i64 (ptr DbgRecord)] (load (field state index)) (primitive/cast i64 payload))
    (Some [record] record)
    (None [] (primitive/cast (ptr DbgRecord) 0))))

;; Only for diagnosing a free that matched no record, so a linear walk is fine.

(defn dbg-find-containing-record [(state (ptr DebugAllocator))
                                  (payload (ptr i8))] (-> (ptr DbgRecord))
  (let [(mut current) (load (field state head))
        address (primitive/cast i64 payload)
        (mut found) (primitive/cast (ptr DbgRecord) 0)]
    (loop (if (= (primitive/cast i64 (load current)) 0)
              (break)
              (let [start
                      (primitive/cast i64 (load (field (load current) payload)))
                    finish
                      (primitive/iadd start (load (field (load current) size)))]
                (if (and (> address start) (< address finish))
                    (do (store! found (load current)) (break))
                    (store! current (load (field (load current) next)))))))
    (load found)))

(defn dbg-prefix-valid? [(record (ptr DbgRecord))] (-> bool)
  (let [base (load (field record base))
        n
          (primitive/isub (primitive/cast i64 (load (field record payload)))
                          (primitive/cast i64 base))
        (mut i) 0
        (mut valid) true]
    (loop (if (>= (load i) n)
              (break)
              (do
                (when (!= (load (primitive/index base (load i)))
                          (dbg-front-byte))
                  (store! valid false)
                  (break))
                (store! i (primitive/iadd (load i) 1)))))
    (load valid)))

(defn dbg-tail-valid? [(payload (ptr i8)) (size i64)] (-> bool)
  (let [(mut i) 0
        (mut valid) true]
    (loop (if (>= (load i) (dbg-tail-bytes))
              (break)
              (do
                (when (!= (load (primitive/index payload
                                                 (primitive/iadd size (load i))))
                          (dbg-tail-byte))
                  (store! valid false)
                  (break))
                (store! i (primitive/iadd (load i) 1)))))
    (load valid)))

; ---- Allocator implementation -------------------------------------------------------
;;; The system page size, or 0 where there is no memory protection to use.
(defn dbg-page-size [] (-> i64)
  (dbg-native (primitive/cast i64 (getpagesize))))

(defn dbg-round-up [(n i64) (unit i64)] (-> i64)
  (dbg-align-up n unit))

(defn dbg-alloc [(state (ptr DebugAllocator)) (request AllocRequest)] (-> (Option (ptr i8)))
  (let [size (load (field request bytes))
        align (load (field request align))
        inner (load (field state inner))
        page (dbg-page-size)
        ; A block of a page or more gets whole pages of its own, so that once freed
        ; every page of it can be made inaccessible and a stale access faults.
        big (and (> page 0) (>= size page))
        prefix (if big page (dbg-prefix-bytes))
        align-to (if (and big (> page align)) page align)
        total
          (if big
              (primitive/iadd page (dbg-round-up (primitive/iadd size (dbg-tail-bytes)) page))
              (primitive/iadd (primitive/iadd size prefix)
                              (primitive/iadd (dbg-tail-bytes)
                                              (primitive/isub align 1))))]
    (let [backing
            (AllocRequest
              :type-id 0
              :count total
              :bytes total
              :align (if big page 8))]
      (match (raw-alloc inner backing)
        (None [] (None))
        (Some [base]
              (match (alloc-bytes inner
                                  (primitive/sizeof DbgRecord)
                                  (primitive/alignof DbgRecord))
                (None [] (do (raw-free inner base backing) (None)))
                (Some [record-memory]
                      (let [record
                              (primitive/cast (ptr DbgRecord)
                                              (slice-data record-memory))
                            payload
                              (primitive/cast (ptr i8)
                                              (dbg-align-up (primitive/iadd (primitive/cast i64
                                                                                            base)
                                                                            prefix)
                                                            align-to))
                            prefix
                              (primitive/isub (primitive/cast i64 payload)
                                              (primitive/cast i64 base))]
                        (dbg-fill! base prefix (dbg-front-byte))
                        (dbg-fill! (primitive/index payload size)
                                   (dbg-tail-bytes)
                                   (dbg-tail-byte))
                        (store! (field record base) base)
                        (store! (field record payload) payload)
                        (store! (field record total) total)
                        (store! (field record type-id)
                                (load (field request type-id)))
                        (store! (field record count)
                                (load (field request count)))
                        (store! (field record size) size)
                        (store! (field record alignment) align)
                        (store! (field record magic) (dbg-magic-live))
                        (store! (field record qnext) (primitive/cast (ptr DbgRecord) 0))
                        (store! (field record free-depth) 0)
                        (store! (field record alloc-depth)
                                (dbg-capture (primitive/cast (ptr (ptr i8)) (field record alloc-frames))))
                        (dbg-lock! state)
                        (store! (field record next) (load (field state head)))
                        (store! (field record prev) (primitive/cast (ptr DbgRecord) 0))
                        (when (!= (primitive/cast i64 (load (field state head))) 0)
                          (store! (field (load (field state head)) prev) record)
                          0)
                        (store! (field state head) record)
                        (hm-put! [i64 (ptr DbgRecord)]
                                 (mut (field state index))
                                 (primitive/cast i64 payload)
                                 record)
                        (store! (field state live-allocations)
                                (primitive/iadd (load (field state
                                                             live-allocations))
                                                1))
                        (dbg-unlock! state)
                        (Some payload)))))))))

(defn dbg-resize [(state (ptr DebugAllocator))
                  (p (ptr i8))
                  (old AllocRequest)
                  (new AllocRequest)] (-> bool)
  false)  ; no in-place resize: the caller alloc-copy-frees, which re-checks the header

(defn dbg-remap [(state (ptr DebugAllocator))
                 (p (ptr i8))
                 (old AllocRequest)
                 (new AllocRequest)] (-> (Option (ptr i8)))
  (None))

;;; free() QUARANTINES the block — it marks the header dead, poisons the payload, and
;;; does NOT return the memory to the inner allocator. That is what makes detection
;;; reliable: if the block were freed back, `malloc` would overwrite our header with its
;;; own free-list bookkeeping, so a later double-free would read garbage (an imprecise
;;; "corruption"), and a use-after-free could read a re-handed-out live value. Holding the
;;; block keeps the DEAD magic and the 0xDE poison intact — a debug allocator trades
;;; memory for detection (like ASan's quarantine). This is a DEBUG build only.
(defn dbg-free [(state (ptr DebugAllocator))
                (payload (ptr i8))
                (request AllocRequest)] (-> i64)
  (let [size (load (field request bytes))
        align (load (field request align))]
    (dbg-lock! state)
    (let [record (dbg-find-record state payload)]
      (when (= (primitive/cast i64 record) 0)
        (let [containing (dbg-find-containing-record state payload)]
          (if (!= (primitive/cast i64 containing) 0)
              (dbg-report! "coil: interior pointer passed to debug-allocator free (--debug-checks)\n")
              (dbg-report! "coil: invalid free in debug-allocator (--debug-checks)\n")))
        0)
      (if (= (load (field record magic)) (dbg-magic-dead))
          (dbg-report-record! "coil: double free in debug-allocator (--debug-checks)\n" record)
          (if (!= (load (field record magic)) (dbg-magic-live))
              (dbg-report! "coil: corrupt allocation record in debug-allocator (--debug-checks)\n")
              0))
      (when (!= size (load (field record size)))
        (dbg-report-record! "coil: allocation size mismatch in debug-allocator (--debug-runtime)\n" record)
        0)
      (when (!= (load (field request type-id)) (load (field record type-id)))
        (dbg-report-record! "coil: allocation type mismatch in debug-allocator (--debug-runtime)\n" record)
        0)
      (when (!= (load (field request count)) (load (field record count)))
        (dbg-report-record! "coil: allocation count mismatch in debug-allocator (--debug-runtime)\n" record)
        0)
      (when (!= align (load (field record alignment)))
        (dbg-report-record! "coil: allocation alignment mismatch in debug-allocator (--debug-runtime)\n" record)
        0)
      (when (not (dbg-prefix-valid? record))
        (dbg-report-record! "coil: buffer underrun in debug-allocator (--debug-runtime)\n" record)
        0)
      (when (not (dbg-tail-valid? payload (load (field record size))))
        (dbg-report-record! "coil: buffer overflow in debug-allocator (--debug-runtime)\n" record)
        0)
      (store! (field record magic) (dbg-magic-dead))
      (store! (field record free-depth)
              (dbg-capture (primitive/cast (ptr (ptr i8)) (field record free-frames))))
      (dbg-poison! payload (load (field record size)))
      (dbg-protect! record 0)
      (store! (field state live-allocations)
              (primitive/isub (load (field state live-allocations)) 1))
      (store! (field state quarantined-bytes)
              (primitive/iadd (load (field state quarantined-bytes))
                              (load (field record total))))
      (dbg-quarantine-push! state record)
      (dbg-quarantine-trim! state)
      (dbg-unlock! state)
      0)))

;;; Append `record` to the quarantine, oldest first.
(defn dbg-quarantine-push! [(state (ptr DebugAllocator)) (record (ptr DbgRecord))] (-> i64)
  (store! (field record qnext) (primitive/cast (ptr DbgRecord) 0))
  (if (= (primitive/cast i64 (load (field state qtail))) 0)
      (store! (field state qhead) record)
      (store! (field (load (field state qtail)) qnext) record))
  (store! (field state qtail) record)
  0)

;;; Return the oldest quarantined blocks to the inner allocator until the quarantine
;;; fits its limit. A released block is forgotten: freeing it again is then reported
;;; as an invalid free rather than a double free. The lock is held.
(defn dbg-quarantine-trim! [(state (ptr DebugAllocator))] (-> i64)
  (let [limit (load (field state quarantine-limit))
        inner (load (field state inner))]
    (when (> limit 0)
      (loop (if (or (<= (load (field state quarantined-bytes)) limit)
                    (= (primitive/cast i64 (load (field state qhead))) 0))
                (break)
                (let [record (load (field state qhead))
                      next (load (field record next))
                      prev (load (field record prev))
                      total (load (field record total))]
                  (store! (field state qhead) (load (field record qnext)))
                  (when (= (primitive/cast i64 (load (field state qhead))) 0)
                    (store! (field state qtail) (primitive/cast (ptr DbgRecord) 0))
                    0)
                  (if (= (primitive/cast i64 prev) 0)
                      (store! (field state head) next)
                      (store! (field prev next) next))
                  (when (!= (primitive/cast i64 next) 0)
                    (store! (field next prev) prev)
                    0)
                  (hm-remove! [i64 (ptr DbgRecord)]
                              (mut (field state index))
                              (primitive/cast i64 (load (field record payload))))
                  (store! (field state quarantined-bytes)
                          (primitive/isub (load (field state quarantined-bytes)) total))
                  (dbg-protect! record 3)
                  (raw-free inner
                            (load (field record base))
                            (AllocRequest :type-id 0 :count total :bytes total :align 8))
                  (free-bytes inner
                              (alloc-slice-new (primitive/cast (ptr u8) record)
                                               (primitive/sizeof DbgRecord))
                              (primitive/alignof DbgRecord))))))
    0))

(impl alloc/Allocator DebugAllocator
  (allocate [(self (ptr DebugAllocator)) (request (ref AllocRequest))]
            (-> (Option (ptr i8)))
            (dbg-alloc self request))
  (resize [(self (ptr DebugAllocator))
           (memory (ptr i8))
           (old (ref AllocRequest))
           (new (ref AllocRequest))]
          (-> bool)
          (dbg-resize self memory old new))
  (remap [(self (ptr DebugAllocator))
          (memory (ptr i8))
          (old (ref AllocRequest))
          (new (ref AllocRequest))]
         (-> (Option (ptr i8)))
         (dbg-remap self memory old new))
  (deallocate [(self (ptr DebugAllocator))
               (memory (ptr i8))
               (request (ref AllocRequest))]
              (-> i64)
              (dbg-free self memory request)))

;;; Construct a stateful debug allocator over any backing allocator. The returned
;;; object owns the tracking registry; pass `(debug-allocator-view debug)` anywhere
;;; an ordinary `(dyn Allocator)` is expected.
(defn debug-allocator-init [(inner (dyn alloc/Allocator))] (-> (ptr DebugAllocator))
  (match (alloc-bytes inner
                      (primitive/sizeof DebugAllocator)
                      (primitive/alignof DebugAllocator))
    (None []
          (do
            (oom-at c"debug-allocator-init" (primitive/sizeof DebugAllocator))
            (primitive/cast (ptr DebugAllocator) 0)))
    (Some [state-memory]
          (let [state
                  (primitive/cast (ptr DebugAllocator)
                                  (slice-data state-memory))]
            (store! (field state inner) inner)
            (store! (field state head) (primitive/cast (ptr DbgRecord) 0))
            (store! (field state index) (hm-new-scalar [i64 (ptr DbgRecord)] inner))
            (store! (field state lock) 0)
            (store! (field state live-allocations) 0)
            (store! (field state quarantined-bytes) 0)
            (store! (field state quarantine-limit) 67108864)
            (store! (field state qhead) (primitive/cast (ptr DbgRecord) 0))
            (store! (field state qtail) (primitive/cast (ptr DbgRecord) 0))
            state))))

;;; Bound the memory held back for use-after-free and double-free detection to
;;; `bytes`; 0 holds every freed block for the life of the allocator.
(defn debug-allocator-set-quarantine-limit! [(state (ptr DebugAllocator)) (bytes i64)] (-> i64)
  (dbg-lock! state)
  (store! (field state quarantine-limit) bytes)
  (dbg-quarantine-trim! state)
  (dbg-unlock! state)
  0)

(defn debug-allocator-view [(state (ptr DebugAllocator))] (-> (dyn alloc/Allocator))
  (primitive/make-dyn alloc/Allocator state))

;;; Print every live allocation, with its size and where it was allocated, and
;;; return how many there were. This is what a leak check is: nothing is freed.
(defn debug-allocator-report-leaks! [(state (ptr DebugAllocator))] (-> i64)
  (let [(mut current) (load (field state head))
        (mut found) 0]
    (loop (if (= (primitive/cast i64 (load current)) 0)
              (break)
              (let [record (load current)]
                (when (= (load (field record magic)) (dbg-magic-live))
                  (store! found (primitive/iadd (load found) 1))
                  (oom-puts c"coil: leaked ")
                  (oom-putd (load (field record size)))
                  (oom-puts c" byte(s)\n")
                  (dbg-put-trace! "allocated at:\n"
                                  (primitive/cast (ptr (ptr i8)) (field record alloc-frames))
                                  (load (field record alloc-depth)))
                  0)
                (store! current (load (field record next))))))
    (load found)))

;;; Release registry metadata and every still-quarantined/live backing block.
;;; Returns the number of allocations that were still live, matching Zig's
;;; deinit leak check. Call only after all threads have stopped using the view.
(defn debug-allocator-deinit! [(state (ptr DebugAllocator))] (-> i64)
  (let [inner (load (field state inner))
        leaks (debug-allocator-report-leaks! state)
        (mut current) (load (field state head))]
    (loop (if (= (primitive/cast i64 (load current)) 0)
              (break)
              (let [record (load current)
                    next (load (field record next))]
                (let [total (load (field record total))]
                  (when (= (load (field record magic)) (dbg-magic-dead))
                    (dbg-protect! record 3)
                    0)
                  (raw-free inner
                            (load (field record base))
                            (AllocRequest
                              :type-id 0
                              :count total
                              :bytes total
                              :align 8)))
                (free-bytes inner
                            (alloc-slice-new (primitive/cast (ptr u8) record)
                                             (primitive/sizeof DbgRecord))
                            (primitive/alignof DbgRecord))
                (store! current next))))
    (hm-free! [i64 (ptr DbgRecord)] (mut (field state index)))
    (free-bytes inner
                (alloc-slice-new (primitive/cast (ptr u8) state)
                                 (primitive/sizeof DebugAllocator))
                (primitive/alignof DebugAllocator))
    leaks))

(defn debug-allocator-on [(inner (dyn alloc/Allocator))] (-> (dyn alloc/Allocator))
  (debug-allocator-view (debug-allocator-init inner)))

;;; The process-wide debug allocator, over the C heap, created on first use. It is
;;; what `malloc-allocator` becomes under `coil.safety`: one registry, so a block
;;; allocated through one call of `malloc-allocator` and freed through another is
;;; one block. Its leaks are reported when the program exits.
(defn dbg-global-cell [] (-> (ptr i64))
  (primitive/alloc-static i64))

(defn dbg-global-exit [] (-> i64)
  (let [state (primitive/cast (ptr DebugAllocator) (load (dbg-global-cell)))]
    (if (= (primitive/cast i64 state) 0)
        0
        (do (debug-allocator-report-leaks! state) 0))))

(extern atexit :cc c [(fnptr c [] i64)] (-> i32))

(defn debug-allocator-global [] (-> (dyn alloc/Allocator))
  (let [cell (dbg-global-cell)
        current (load cell)]
    (if (!= current 0)
        (debug-allocator-view (primitive/cast (ptr DebugAllocator) current))
        (let [state (debug-allocator-init (alloc/malloc-allocator))
              bits (primitive/cast i64 state)
              seen (atomic-cas cell 0 bits)]
          (if (= seen 0)
              (do (atexit (primitive/fnptr-of dbg-global-exit))
                  (debug-allocator-view state))
              (do (debug-allocator-deinit! state)
                  (debug-allocator-view (primitive/cast (ptr DebugAllocator) seen))))))))

;;; `(debug-allocator inner)` — the surface. A macro so `(primitive/debug-checks?)` decides at
;;; expansion time: OFF it is just `inner` (byte-identical, zero cost); ON it wraps.
(defn debug-allocator [(inner Code)] (-> Code)
  (if (primitive/debug-checks?)
      `(debug-allocator-on ~inner)
      inner))
