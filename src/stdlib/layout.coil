;;; How a `defstruct` lays out its fields. A struct names its layout with one of
;;; these values; with none it is `C`:
;;;
;;;     (import "coil.layout" :as layout)
;;;     (defstruct Header :layout (layout/Packed) [(tag u8) (len u32)])
;;;     (defstruct Line :layout (layout/Align 64) [(a i64) (b i64)])
;;;     (defstruct Reg :layout (layout/Explicit) :size 16 :align 8
;;;       [(id i32 :at 0) (data i64 :at 8)])
;;;     (defstruct Rgb565 :layout (layout/Bits) :backing u16
;;;       [(b :bits 5) (g :bits 6) (r :bits 5)])
(module coil.layout)

(defsum Layout
  ;;; The target C ABI's layout: fields in order, each at its natural alignment.
  (C)
  ;;; Fields in order with no padding between them.
  (Packed)
  ;;; Each field at the byte offset its `:at` gives. The struct may also give
  ;;; its `:size` and `:align`.
  (Explicit)
  ;;; Bitfields, `(name :bits N)` or `(name :bits iN|uN)`, packed from the low
  ;;; bit of one integer: the struct's `:backing` type, or the smallest integer
  ;;; of 8, 16, 32 or 64 bits that holds them.
  (Bits)
  ;;; The C layout, aligned to BYTES, a power of two.
  (Align [(bytes i64)]))
