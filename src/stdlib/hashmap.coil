(module coil.hashmap)
(import "coil.primitive" :as primitive)

; An open-addressing hash map `HashMap[K V]` — a generic-struct LIBRARY over the
; allocator interface + src/stdlib/mem; no compiler support, no ambient heap (the map
; carries its `(dyn Allocator)`).
;
; HASHING & EQUALITY ARE EXPLICIT CAPABILITY VALUES — a `KeyOps` vtable (hash + eq
; fn pointers + the key size), threaded like the allocator and IO. This is correct
; for EVERY key type and avoids the silent footgun of a byte-wise default (two
; "equal" struct values with different uninitialized padding would silently fail
; to match). It also handles content-keyed strings today (supply a content hash).
;
; Convenience: `scalar-keyops [K]` supplies the byte-wise hash/eq SAFELY — but only
; for SCALAR/POINTER keys, where byte-equality provably IS value-equality (no
; padding). A struct/string key MUST supply its own KeyOps (so correctness can't
; be gotten silently wrong). `HashMap::new-scalar` wires the scalar ops in for you.
;
;   (import "coil.hashmap" :use [HashMap]) (import "coil.alloc" :use *)
;   (let [(mut m) (HashMap::new-scalar [i64 i64] (malloc-allocator))]
;     (set! (mut m) 7 42)
;     (match (get m 7) (Some [v] v) (None [] 0)))
;
; Application code uses the collection traits: Len/len, Get/get, Set/set!, and
; Iterable/iter. Methods on the map construct it (`HashMap::new`), query it
; (`contains?`, `cap`), remove from it, clear it, and release it (`free!`).
(export KeyOps
        HashMap
        Entry
        MapIter
        bytewise-hash
        bytewise-eq
        scalar-keyops
        i64-key-hash
        i64-key-eq
        i64-keyops
        for-entries
        entry-key
        entry-val)

(import "coil.alloc" :as alloc :use *)
(import "coil.result" :use *)
(import "coil.mem" :use *)
(import "coil.control" :use *)  ; `for` — used by the for-entries iteration macro
(import "coil.fmt" :use [Debug Formatter debug-fmt DebugIndentWriter])
(import "coil.io" :use [Writer print-str])
(import "coil.cc" :as cc)

;;; The key capability: hash a key, compare two keys; `size` is sizeof K (handed to
;;; the byte-wise helpers; a custom hash/eq may ignore it). Type-erased over (ptr i8)
;;; so one KeyOps shape serves any K. NOT generic — the map stores it by value.
;;;
;;; std-3 — OWNING keys. When `owns` is 1 the map treats stored keys as OWNED: on a
;;; genuine insert it deep-copies the key into the map's own allocator (`copy`), and
;;; on remove/clear/free it releases that storage (`free`). So a string key never
;;; aliases caller memory (the footgun a `(slice u8)` key otherwise is: two keys built
;;; over one reused buffer both read the buffer's *latest* bytes). When `owns` is 0 —
;;; and `copy`/`free` are null — keys are stored purely by value and never copied or
;;; freed. That is
;;; the old borrow behavior, and it is correct for scalar/pointer keys (whose value
;;; carries no external storage) and for the deliberate opt-in `keyops-borrowed`.
;;; `copy`/`free` both take (allocator, key-slot) and act IN PLACE on the slot.
(defstruct KeyOps
  [(hash (fnptr (cc/C) [(ptr i8) i64] i64))
   (eq (fnptr (cc/C) [(ptr i8) (ptr i8) i64] bool))
   (size i64)
   (copy (fnptr (cc/C) [(ptr (dyn Allocator)) (ptr i8)] i64))
   (free (fnptr (cc/C) [(ptr (dyn Allocator)) (ptr i8)] i64))
   (owns i64)])

;;; Safe byte-wise ops — sound ONLY where byte-equality == value-equality.
(defn bytewise-hash [(p (ptr i8)) (n i64)] (-> i64)
  (let [(mut h) -3750763034362895579  ; FNV-1a offset basis
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (store! h
                        (primitive/imul (primitive/ixor (load h)
                                                        (primitive/cast i64
                                                                          (load (primitive/index p
                                                                                                 (load i)))))
                                        1099511628211))
                (store! i (primitive/iadd (load i) 1)))))
    (load h)))

(defn bytewise-eq [(a (ptr i8)) (b (ptr i8)) (n i64)] (-> bool)
  (eql a b n))  ; eql [i8] compares n bytes

;;; Build the safe scalar/pointer-key ops for K (uses sizeof K). The vtable is
;;; constant static data, initialized at load time and never written, so any number
;;; of threads may ask for it at once; it is handed around by pointer (like the
;;; allocator). Do NOT use
;;; for struct keys with padding — define an explicit KeyOps instead.
(defn scalar-keyops [K] [] (-> (ptr KeyOps))
  (primitive/alloc-static KeyOps
                          (KeyOps :hash (primitive/fnptr-of bytewise-hash)
                                  :eq (primitive/fnptr-of bytewise-eq)
                                  :size (primitive/sizeof K)
                                  :copy (primitive/zeroed (fnptr (cc/C) [(ptr (dyn Allocator)) (ptr i8)] i64))
                                  :free (primitive/zeroed (fnptr (cc/C) [(ptr (dyn Allocator)) (ptr i8)] i64))
                                  :owns 0)))

; Integer-heavy compiler tables (node ids, revisions, binding ids) need not run
; FNV one byte at a time. HashMap masks the result by its power-of-two capacity;
; an i64 value is already a sound hash for integer equality, and sequential ids
; occupy distinct buckets until the table wraps.
(defn i64-key-hash [(p (ptr i8)) (n i64)] (-> i64)
  ; Fibonacci hashing: multiplication by an odd 64-bit constant is a permutation
  ; modulo 2^64, and its low bits therefore remain suitable when HashMap masks by
  ; a power-of-two capacity. It disperses sequential/structured ids without the
  ; six dependent operations of a cryptographic-style avalanche finalizer.
  (primitive/imul (load (primitive/cast (ptr i64) p)) -7046029254386353131))

(defn i64-key-eq [(a (ptr i8)) (b (ptr i8)) (n i64)] (-> bool)
  (= (load (primitive/cast (ptr i64) a))
     (load (primitive/cast (ptr i64) b))))

(defn i64-keyops [] (-> (ptr KeyOps))
  (primitive/alloc-static KeyOps
                          (KeyOps :hash (primitive/fnptr-of i64-key-hash)
                                  :eq (primitive/fnptr-of i64-key-eq)
                                  :size (primitive/sizeof i64)
                                  :copy (primitive/zeroed (fnptr (cc/C) [(ptr (dyn Allocator)) (ptr i8)] i64))
                                  :free (primitive/zeroed (fnptr (cc/C) [(ptr (dyn Allocator)) (ptr i8)] i64))
                                  :owns 0)))

;;; state: 0 empty, 1 occupied, 2 tombstone. `hash` is the low 32 bits of the
;;; occupied key's hash. A probe compares it before the key, so it calls the key
;;; vtable's `eq` only on a key that is almost certainly the one it wants, and a
;;; rehash places each entry from it without hashing the key again. Both halves
;;; fit the 8 bytes `state` alone used to take.
(defstruct Entry [K V] [(state i32) (hash i32) (key K) (val V)])

;;; The 32 bits of a key's hash an entry keeps.
(defn entry-hash [(h i64)] (-> i32)
  (primitive/cast i32 h))

;;; The slot a hash's probe starts from in a table of `cap` slots (a power of
;;; two). It reads only the bits an entry keeps, so a rehash, which knows only
;;; those, places an entry where a lookup will look for it.
(defn probe-start [(h i32) (cap i64)] (-> i64)
  (primitive/iand (primitive/cast i64 (primitive/cast u32 h)) (primitive/isub cap 1)))

(defstruct HashMap [K V]
  [(slots (ptr (Entry K V)))
   (cap i64)
   (len i64)
   (tombs i64)
   (alc (dyn Allocator))
   (ops (ptr KeyOps))])

(defn hash-fn-address [(fp (fnptr (cc/C) [(ptr i8) i64] i64))] (-> i64)
  (primitive/cast i64 (primitive/cast (ptr i8) fp)))

(defn eq-fn-address [(fp (fnptr (cc/C) [(ptr i8) (ptr i8) i64] bool))] (-> i64)
  (primitive/cast i64 (primitive/cast (ptr i8) fp)))

(defn own-fn-address [(fp (fnptr (cc/C) [(ptr (dyn Allocator)) (ptr i8)] i64))] (-> i64)
  (primitive/cast i64 (primitive/cast (ptr i8) fp)))

;;; The key vtable's operations. `valid?` checks that every entry the map will call
;;; is filled in; `hash` and `eq` call the vtable on type-erased key slots.
;;;
;;; std-3 owning-key hooks. `owns?` gates every copy/free at the call sites (so a
;;; borrowed/scalar map pays nothing). `copy-key!` replaces the borrowed key at
;;; `slot` with an allocator-owned deep copy; `free-key!` releases that storage.
(impl KeyOps
  (valid? [(ops (ptr KeyOps))] (-> bool)
    (and (!= (primitive/cast i64 ops) 0)
         (and (!= (hash-fn-address (load (field ops hash))) 0)
              (and (!= (eq-fn-address (load (field ops eq))) 0)
                   (and (> (load (field ops size)) 0)
                        (or (= (load (field ops owns)) 0)
                            (and (= (load (field ops owns)) 1)
                                 (and (!= (own-fn-address (load (field ops copy)))
                                          0)
                                      (!= (own-fn-address (load (field ops free)))
                                          0)))))))))

  (hash [(opsp (ptr KeyOps)) (kp (ptr i8))] (-> i64)
    (primitive/call-ptr (load (field opsp hash)) kp (load (field opsp size))))

  (eq [(opsp (ptr KeyOps)) (a (ptr i8)) (b (ptr i8))] (-> bool)
    (primitive/call-ptr (load (field opsp eq)) a b (load (field opsp size))))

  (owns? [(opsp (ptr KeyOps))] (-> bool)
    (= (load (field opsp owns)) 1))

  (copy-key! [(opsp (ptr KeyOps)) (a (dyn Allocator)) (slot (ptr i8))] (-> i64)
    (let [allocator (primitive/alloc-stack (dyn Allocator))]
      (store! allocator a)
      (primitive/call-ptr (load (field opsp copy)) allocator slot)))

  (free-key! [(opsp (ptr KeyOps)) (a (dyn Allocator)) (slot (ptr i8))] (-> i64)
    (let [allocator (primitive/alloc-stack (dyn Allocator))]
      (store! allocator a)
      (primitive/call-ptr (load (field opsp free)) allocator slot))))

(defn debug-check-header [(m Code) (site Code)] (-> Code)
  (if (primitive/debug-checks?)
      `(if (header-valid? ~m)
           0
           (do (debug-fail-at ~site) 0))
      `0))

; Only the KeyOps vtable is checked. This once also tested `(!= (cast i64 a) 0)`,
; back when the allocator was a `(ptr Allocator)` and that was a real null test;
; `(dyn Allocator)` is a fat trait-object VALUE, so casting it to i64 is not
; meaningful — and left `!=` with no inferable type argument, which made every
; --debug-checks build fail inside HashMap::new.
(defn debug-check-keyops [(ops Code)] (-> Code)
  (if (primitive/debug-checks?)
      `(if (valid? ~ops)
           0
           (do (debug-fail-at c"invalid HashMap KeyOps vtable") 0))
      `0))

;;; Insert (key-at kp, v) into raw slots (power-of-two cap), linear probing via the
;;; key vtable `opsp`. Probes THROUGH tombstones to find an existing key (so an
;;; update lands on the real entry, never duplicating it), remembering the first
;;; tombstone to reuse on a confirmed-absent insert. Returns:
;;;   0 = updated an existing key   1 = filled an empty slot   2 = reused a tombstone
;;; (1 and 2 both add a key; 2 additionally consumes a tombstone). Terminates because
;;; the caller keeps at least one empty slot (tombstones counted toward resize).
;;; `own` = 1 for a genuine caller insert (copy the key if the map owns keys); 0 for a
;;; rehash MOVE (`grow!`), where the key is already owned and only its fat pointer is
;;; relocated — copying again would leak, freeing the old array must not free the key.
;;; `h` is the key's entry-hash.
(defn insert-raw [K V] [(opsp (ptr KeyOps))
                        (slots (ptr (Entry K V)))
                        (cap i64)
                        (kp (ptr K))
                        (h i32)
                        (v V)
                        (a (dyn Allocator))
                        (own i64)] (-> i64)
  (let [kpi (primitive/cast (ptr i8) kp)
        (mut i) (probe-start h cap)
        (mut tomb) -1  ; index of the first tombstone seen, -1 = none yet
        (mut found) -1  ; index of the entry holding an equal key, -1 = none
        (mut done) false]
    ; Find where the pair goes, moving nothing: an equal key's entry, else the first
    ; tombstone or the empty slot that ends the probe.
    (loop (if (load done)
              (break)
              (let [e (primitive/index slots (load i))
                    st (load (field e state))]
                (cond (= st 0) (set! done true)
                      ; a rehash moves distinct keys: none is already here
                      (and (= st 1)
                           (and (= own 1)
                                (and (= (load (field e hash)) h)
                                     (eq opsp (primitive/cast (ptr i8) (field e key)) kpi))))
                        (do (set! found (load i)) (set! done true))
                      :else
                        (do
                          (when (and (= st 2) (< (load tomb) 0)) (set! tomb (load i)) 0)
                          (set! i (primitive/iand (primitive/iadd (load i) 1)
                                                  (primitive/isub cap 1))))))))
    (if (>= (load found) 0)
        ; update: the value is replaced, and the one it replaces is dropped once
        ; `v` is in place; the map keeps its own key, so the caller's is dropped
        (let [e (primitive/index slots (load found))
              replaced (load (field e val))
              spent (load kp)]
          (store! (field e val) v)
          0)
        ; empty ⇒ key is absent. Insert at the first tombstone if we saw one, else
        ; at the empty slot.
        (let [target (if (>= (load tomb) 0) (load tomb) (load i))
              te (primitive/index slots target)]
          (store! (field te state) 1)
          (store! (field te hash) h)
          (store! (field te key) (load kp))
          ; a new key entered the map — take ownership (deep-copy in place) iff this
          ; is a genuine insert into an owning map (never a rehash).
          (if (and (= own 1) (owns? opsp))
              (copy-key! opsp a (primitive/cast (ptr i8) (field te key)))
              0)
          (store! (field te val) v)
          (if (>= (load tomb) 0) 2 1)))))

(defn valid-cap [(requested i64) (entries i64)] (-> i64)
  ; Probing masks with cap-1, so the physical capacity must be a power of two.
  ; Also retain at least one empty slot when a caller asks to shrink a populated
  ; table. `grow!` is public; enforcing the invariant here prevents one invalid
  ; reservation from turning every later lookup into a non-terminating probe.
  (let [need
          (if (> requested (primitive/imul entries 2))
              requested
              (primitive/imul entries 2))
        (mut cap) 8]
    (loop (if (>= (load cap) need)
              (break)
              (set! cap (primitive/imul (load cap) 2))))
    (load cap)))

;;; Release what one occupied entry holds: an OWNED key's copy (std-3), then the key
;;; and the value themselves, each dropped once -- read out of the slot, which is
;;; left holding nothing.
(defn drop-entry! [K V] [(opsp (ptr KeyOps)) (a (dyn Allocator)) (e (ptr (Entry K V)))] (-> i64)
  (if (owns? opsp)
      (free-key! opsp a (primitive/cast (ptr i8) (field e key)))
      0)
  (let [key (load (field e key))
        value (load (field e val))]
    0))

;;; Release every entry still occupying a slot (state 1). Tombstones (state 2) were
;;; released by `remove!`, and empty slots (state 0) hold nothing -- so only state-1
;;; entries are released (a tombstone's would be released twice).
(defn drop-entries! [K V] [(m (mut (HashMap K V)))] (-> i64)
  (let [opsp (load (field m ops))
        a (load (field m alc))
        slots (load (field m slots))
        cap (load (field m cap))
        (mut i) 0]
    (loop (if (>= (load i) cap)
              (break)
              (do
                (let [e (primitive/index slots (load i))]
                  (if (= (load (field e state)) 1)
                      (drop-entry! [K V] opsp a e)
                      0))
                (store! i (primitive/iadd (load i) 1)))))
    0))

(impl [K V] (HashMap K V)
  (new [(a (dyn Allocator)) (ops (ptr KeyOps))] (-> (HashMap K V))
    (debug-check-keyops ops)
    (let [(mut m) (primitive/zeroed (HashMap K V))]
      (store! (field m alc) a)
      (store! (field m ops) ops)  ; both vtables held by pointer (scalar stores)
      (load m)))

  ;;; Convenience for scalar/pointer keys: wires in the safe byte-wise ops.
  (new-scalar [(a (dyn Allocator))] (-> (HashMap K V))
    (HashMap::new [K V] a (scalar-keyops [K])))

  ;;; The header's invariants: counts in range, a power-of-two capacity, slots
  ;;; present exactly when the capacity is non-zero, and a valid key vtable.
  (header-valid? [(m (HashMap K V))] (-> bool)
    (let [cap (load (field m cap))
          len (load (field m len))
          tombs (load (field m tombs))
          slots (load (field m slots))]
      (and (>= cap 0)
           (and (>= len 0)
                (and (>= tombs 0)
                     (and (<= (+ len tombs) cap)
                          (and (or (= cap 0) (= (primitive/iand cap (- cap 1)) 0))
                               (and (if (= cap 0)
                                        (= (primitive/cast i64 slots) 0)
                                        (!= (primitive/cast i64 slots) 0))
                                    (valid? (load (field m ops)))))))))))

  ;;; The number of slots, occupied or not.
  (cap [(m (HashMap K V))] (-> i64)
    (debug-check-header m c"HashMap header corrupt in cap")
    (load (field m cap)))

  ;;; Rehash into `newcap` slots, rounded up to a power of two that leaves room for
  ;;; every entry. Returns 0, or -1 when the allocation fails.
  (grow! [(m (mut (HashMap K V))) (newcap i64)] (-> i64)
    (debug-check-header (load m) c"HashMap header corrupt in grow!")
    (let [a (load (field m alc))
          oldslots (load (field m slots))
          oldcap (load (field m cap))
          cap (valid-cap newcap (load (field m len)))]
      (match (alloc [(Entry K V)] a cap)
        (None []
              (do
                (oom-at c"hashmap grow!"
                        (primitive/imul cap (primitive/sizeof (Entry K V))))
                -1))
        (Some [ns]
              (do
                (zero [(Entry K V)] (data ns) cap)
                (let [(mut j) 0]
                  (loop (if (>= (load j) oldcap)
                            (break)
                            (do
                              (let [e (primitive/index oldslots (load j))]
                                (if (= (load (field e state)) 1)
                                    (insert-raw [K V]
                                                (load (field m ops))
                                                (data ns)
                                                cap
                                                (field e key)
                                                (load (field e hash))
                                                (load (field e val))
                                                a
                                                0)  ; MOVE
                                    0))
                              (store! j (primitive/iadd (load j) 1))))))
                (if (> oldcap 0)
                    (free [(Entry K V)] a (slice::new oldslots oldcap))
                    0)
                (store! (field m slots) (data ns))
                (store! (field m cap) cap)
                (store! (field m tombs) 0)  ; rehash dropped all tombstones
                0)))))

  (contains? [(m (HashMap K V)) (k K)] (-> bool)
    (match (get-ptr m k) (None [] false) (Some [_] true)))

  ;;; The value stored under `k`, where it lies, or None: a pointer into the map,
  ;;; valid until the map is next edited (Zig's `getPtr`). The way to read a value
  ;;; that owns something, which `get` would copy.
  (get-ptr [(m (HashMap K V)) (k K)] (-> (Option (ptr V)))
    (debug-check-header m c"HashMap header corrupt in get-ptr")
    (let [cap (load (field m cap))]
      (if (= cap 0)
          (let [spent k] (None))  ; nothing to find; the lookup key is dropped
          (let [slots (load (field m slots))
                opsp (load (field m ops))
                kp (primitive/alloc-stack K)]
            (store! kp k)
            (let [kpi (primitive/cast (ptr i8) kp)
                  h (entry-hash (hash opsp kpi))
                  (mut i) (probe-start h cap)]
              (loop (let [e (primitive/index slots (load i))
                          st (load (field e state))]
                      (if (= st 0)
                          (break)
                          (if (and (= st 1)
                                   (and (= (load (field e hash)) h)
                                        (eq opsp
                                            (primitive/cast (ptr i8) (field e key))
                                            kpi)))
                              (break)
                              (store! i
                                      (primitive/iand (primitive/iadd (load i) 1)
                                                      (primitive/isub cap 1)))))))
              ; the lookup key was moved into `kp`; it is dropped here
              (let [e (primitive/index slots (load i))
                    spent (load kp)]
                (if (= (load (field e state)) 1)
                    (Some (field e val))
                    (None))))))))

  ;;; Remove `k`. Returns 1 when a key was removed and 0 when it was absent.
  (remove! [(m (mut (HashMap K V))) (k K)] (-> i64)
    (debug-check-header (load m) c"HashMap header corrupt in remove!")
    (let [cap (load (field m cap))]
      (if (= cap 0)
          (let [spent k] 0)  ; nothing to remove; the lookup key is dropped
          (let [slots (load (field m slots))
                opsp (load (field m ops))
                a (load (field m alc))
                kp (primitive/alloc-stack K)
                (mut res) 0]
            (store! kp k)
            (let [kpi (primitive/cast (ptr i8) kp)
                  h (entry-hash (hash opsp kpi))
                  (mut i) (probe-start h cap)]
              (loop (let [e (primitive/index slots (load i))
                          st (load (field e state))]
                      (if (= st 0)
                          (break)
                          (if (and (= st 1)
                                   (and (= (load (field e hash)) h)
                                        (eq opsp
                                            (primitive/cast (ptr i8) (field e key))
                                            kpi)))
                              (do
                                ; the key and value leave the map: release them
                                (drop-entry! [K V] opsp a e)
                                (store! (field e state) 2)  ; tombstone
                                (store! (field m len)
                                        (primitive/isub (load (field m len)) 1))
                                (store! (field m tombs)
                                        (primitive/iadd (load (field m tombs)) 1))
                                (store! res 1)
                                (break))
                              (store! i
                                      (primitive/iand (primitive/iadd (load i) 1)
                                                      (primitive/isub cap 1))))))))
            ; the lookup key was moved into `kp`; it is dropped here
            (let [spent (load kp)] 0)
            (load res)))))

  ;;; Empty the map WITHOUT releasing its storage: release every key and value, mark
  ;;; every slot empty and reset the counts, keeping the allocated slot array for
  ;;; reuse. (`free!` also frees.) Zeroing the slots restores state 0 = empty
  ;;; everywhere, dropping every tombstone.
  (clear! [(m (mut (HashMap K V)))] (-> i64)
    (debug-check-header (load m) c"HashMap header corrupt in clear!")
    (if (> (load (field m cap)) 0)
        (do
          (drop-entries! (mut m))
          (zero (load (field m slots)) (load (field m cap))))
        0)
    (store! (field m len) 0)
    (store! (field m tombs) 0)
    0)

  ;;; Release every key and value, then the slot array, leaving an empty map.
  (free! [(m (mut (HashMap K V)))] (-> i64)
    (debug-check-header (load m) c"HashMap header corrupt in free!")
    (if (> (load (field m cap)) 0)
        (do
          (drop-entries! (mut m))
          (free [(Entry K V)]
                (load (field m alc))
                (slice::new (load (field m slots)) (load (field m cap)))))
        0)
    (store! (field m slots) (primitive/cast (ptr (Entry K V)) 0))
    (store! (field m cap) 0)
    (store! (field m len) 0)
    (store! (field m tombs) 0)
    0))

;;; The key and the value of an occupied entry, lent where they lie.
(defn entry-key [K V] [(e (ref (Entry K V)))] (-> (ref K)) (field e key))
(defn entry-val [K V] [(e (ref (Entry K V)))] (-> (ref V)) (field e val))

;;; `(for-entries [k v map-ptr] body…)` — iterate the OCCUPIED entries of a map,
;;; binding `k`/`v` to each key/value, lent where they lie (`(ref K)`/`(ref V)`), so a
;;; key or value that owns something is never copied. `map-ptr` is a `(ptr (HashMap K V))` (K V
;;; inferred); order is unspecified (slot order). A macro over `for` + the slot array —
;;; the map iteration the JSON dogfood wanted (you could query a map but not walk it).
(defn for-entries [(binding Code) & (body Code)] (-> Code)
  (if (not (= (primitive/code-count binding) 3))
      (primitive/error "for-entries: binding must be [key val map-ptr]")
      (let [k (primitive/code-nth binding 0)
            v (primitive/code-nth binding 1)
            mp (primitive/code-nth binding 2)
            m (primitive/fresh-identifier "temporary")
            i (primitive/fresh-identifier "temporary")
            e (primitive/fresh-identifier "temporary")]
        `(let [~m ~mp]
           (for [~i 0 (cap (load ~m))]
             (let [~e (primitive/index (load (field ~m slots)) ~i)]
               (if (= (load (field ~e state)) 1)
                   (let [~k (entry-key ~e)
                         ~v (entry-val ~e)]
                     ~@body)
                   0)))))))

; ---- the core collection traits (coil.core) ---------------------------------
; `(len m)` / `(get m k)` / `(set! (mut m) k v)` on any (HashMap K V). `get`
; returns (Option V) — a map's E is optional by nature; `set!` inserts or updates.
(impl [K V] Len (HashMap K V)
  (len [(m (HashMap K V))] (-> i64)
    (debug-check-header m c"HashMap header corrupt in len")
    (load (field m len))))

(impl [K V] Get (HashMap K V)
  ;;; A copy of the value stored under `k`, or None. A value that owns something is
  ;;; refused where it is read; `(get-ptr m k)` reaches it instead.
  (get :collection/copies-element "(get-ptr m k)" [(m (HashMap K V)) (k K)] (-> (Option V))
    (match (get-ptr m k)
      (Some [p] (Some (load p)))
      (None [] (None)))))

;;; Insert or update. Returns the SIGNAL `insert-raw` computes:
;;;   0 = updated an existing key   1 = inserted into an empty slot
;;;   2 = inserted, reusing a tombstone
;;; so `(= r 0)` means "the key was already present".
(impl [K V] Set (HashMap K V)
  (set! [(m (mut (HashMap K V))) (k K) (v V)] (-> i64)
    (debug-check-header (load m) c"HashMap header corrupt in set!")
    ; Resize when occupied + tombstones would pass 0.75 — counting tombstones keeps a
    ; free slot (probe termination). Grow only if genuinely >half full; otherwise
    ; rehash same-size to clear tombstones (so delete/insert churn can't grow forever).
    (let [cap (load (field m cap))]
      (if (>= (primitive/imul (primitive/iadd (primitive/iadd (load (field m len))
                                                              (load (field m
                                                                           tombs)))
                                              1)
                              4)
              (primitive/imul cap 3))
          (grow! (mut m)
                 (if (= cap 0)
                     8
                     (if (>= (primitive/imul (load (field m len)) 2) cap)
                         (primitive/imul cap 2)
                         cap)))
          0))
    (let [kp (primitive/alloc-stack K)]
      (store! kp k)
      (let [r
              (insert-raw [K V]
                          (load (field m ops))
                          (load (field m slots))
                          (load (field m
                                       cap))
                          kp
                          (entry-hash (hash (load (field m ops)) (primitive/cast (ptr i8) kp)))
                          v
                          (load (field m alc))
                          1)]
        (if (>= r 1)  ; added a new key
            (do
              (store! (field m len) (primitive/iadd (load (field m len)) 1))
              (if (= r 2)  ; ...reusing a tombstone
                  (store! (field m tombs)
                          (primitive/isub (load (field m tombs)) 1))
                  0))
            0)
        r))))

; ---- iteration (coil.core Iterator/Iterable) --------------------------------
;;; A map iterates its KEYS (`Item = K`): `(for k (iter m))` visits each occupied
;;; key in slot order; recover the value with `(get m k)`. This is
;;; what makes `(for-in [x (int map)])` correct — std-4 was `get`-by-index on a map
;;; (garbage, since a map's `get` takes a KEY, not a slot index). A `(MapIter K V)`
;;; holds a copy of the map header (its `slots` pointer is shared, so the walk sees
;;; the live table) plus a slot cursor. `for-entries` remains the direct key+value walk.
(defstruct MapIter [K V] [(m (HashMap K V)) (pos i64)])

(impl [K V] Iterable (HashMap K V)
  (iter [(m (HashMap K V))]
        (-> (MapIter K V))
        (let [it (primitive/alloc-stack (MapIter K V))]
          (store! (field it m) m)
          (store! (field it pos) 0)
          (load it))))

(impl [K V] Iterator (MapIter K V)
  ;;; A copy of each key. A key that owns something is refused where the loop is:
  ;;; `for-entries` lends each key and value instead.
  (next :collection/copies-element "(for-entries [k v (mut m)] …)" [(it (mut (MapIter K V)))]
        (-> (Option K))
        (let [slot-count (cap (load (field it m)))]
          (loop (let [p (load (field it pos))]
                  (if (>= p slot-count)
                      (break (None))
                      (let [e
                              (primitive/index (load (field (field it m) slots))
                                               p)]
                        (store! (field it pos) (primitive/iadd p 1))
                        (if (= (load (field e state)) 1)
                            (break (Some (load (field e key))))
                            0))))))))

;;; Hash maps are Debug exactly when both their keys and values are Debug. Slot
;;; order is deliberately unspecified, matching iteration order. The shape is a
;;; Coil-styled constructor rather than pretending the language has a map literal.
(impl [(K Debug) (V Debug)] Debug (HashMap K V)
  (debug-fmt [(x (HashMap K V)) (f (ptr Formatter))]
             (-> i64)
             (disarm! f)
             (let [w (writer f)
                   (mut at) 0
                   (mut written) 0
                   slot-count (cap x)
                   slots (load (field x slots))
                   indent (primitive/alloc-stack DebugIndentWriter)
                   nested-w (primitive/alloc-stack Writer)
                   nested-f (primitive/alloc-stack Formatter)]
               (if (pretty? f)
                   (do
                     (DebugIndentWriter::init indent nested-w w)
                     (Formatter::init nested-f nested-w)
                     (set-alternate! nested-f true))
                   (do (Formatter::init nested-f w) 0))
               (print-str w "(HashMap")
               (loop (if (>= (load at) slot-count)
                         (break)
                         (let [entry (primitive/index slots (load at))]
                           (when (= (load (field entry state)) 1)
                             (if (pretty? f)
                                 (print-str w "\n  (")
                                 (print-str w " ("))
                             (debug-fmt (entry-key entry) nested-f)
                             (print-str w " ")
                             (debug-fmt (entry-val entry) nested-f)
                             (print-str w ")")
                             (store! written (primitive/iadd (load written) 1))
                             0)
                           (store! at (primitive/iadd (load at) 1)))))
               (when (and (pretty? f) (> (load written) 0))
                 (print-str w "\n")
                 0)
               (print-str w ")")
               0)))
