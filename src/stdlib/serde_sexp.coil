; S-expression backend for coil.serde — the second text format, proving the
; data model against a different surface syntax.
;
;   (import "coil.serde"      :use *)
;   (import "coil.serde.sexp" :use *)
;   (to-sexp x (stdout))    (to-sexp-str a x)    (from-sexp [T] a src)
;
; The format:
;   null            nil
;   bool            true / false
;   number          42  -7  1.5  1e30        (int vs float decided by the TYPE)
;   f64 specials    nan / inf / -inf         (unlike JSON, fully representable)
;   string          "…"  escapes: \" \\ \n \t \r
;   bytes           #"…" hex pairs, e.g. #"DEADBEEF"
;   seq             (1 2 3)
;   map             (map "k" 1 "j" 2)
;   struct          (User name "ada" age 36)      ; head symbol, then name/value pairs
;   variant         Point  /  (Circle r 1.5)      ; externally tagged, struct-shaped
;
; Decoded strings borrow the input when escape-free, else the decode allocator.
;
; NOT the Coil reader, and deliberately not built on it. The `sxp-*` tokenizer below
; looks like duplication of coil.reader and is not: this is a WIRE FORMAT that merely
; borrows s-expression surface syntax. It has its own smaller escape set (no \0, no
; \xHH — changing that would change the format), `#"…"` hex-byte literals that are not
; Coil syntax, `nan`/`inf`/`-inf` literals, and it emits a flat token TAPE whose kinds
; are serde categories (nil/bool/number/string/list/symbol/bytes) rather than a tree —
; which is what lets a decoded string borrow the input instead of being allocated.
; Rebuilding it on coil.reader would pull format extensions into the language's reader
; and lose the borrow. Leave it alone.
(module coil.serde.sexp)
(import "coil.primitive" :as primitive)
(import "coil.alloc" :as alloc)
(import "coil.alloc" :use *)
(import "coil.slice" :use *)
(import "coil.str" :use *)
(import "coil.arraylist" :use *)
(import "coil.io" :use *)
(import "coil.fmt" :use *)
(import "coil.serde" :use *)
(import "coil.control" :use *)
(import "coil.result" :use *)
(import "coil.try" :use *)

; ============================ serializer ====================================
;; sep[d] = 1 -> the next item at depth d needs a ' ' first
(defstruct SexpSer [(w (ptr Writer)) (depth i64) (sep (array u8 66))])

(defn sx-io [(r (Result i64 IoError))] (-> (Result i64 SerError))
  (match r
    (Err [_] (Err (ser-err SER-E-IO)))
    (Ok [n] (Ok n))))
(defn sx-byte [(p (ptr SexpSer)) (b i64)] (-> (Result i64 SerError))
  (sx-io (write-byte (load (field p w)) (primitive/cast u8 b))))
(defn sx-put [(p (ptr SexpSer)) (s (slice u8))] (-> (Result i64 SerError))
  (sx-io (print-str (load (field p w)) s)))

;; head? = the level starts non-empty (a head symbol was just written)
(defn sx-open [(p (ptr SexpSer)) (head? bool)] (-> (Result i64 SerError))
  (if (>= (load (field p depth)) (cast i64 64))
      (Err (ser-err SER-E-DEPTH))
      (try
        (do (try! (sx-byte p \())
            (store! (field p depth) (+ (load (field p depth)) 1))
            (store! (primitive/index (field p sep) (load (field p depth)))
                    (primitive/cast u8 (if head? 1 0)))
            (Ok 0)))))
(defn sx-close [(p (ptr SexpSer))] (-> (Result i64 SerError))
  (try
    (do (try! (sx-byte p \)))
        (store! (field p depth) (- (load (field p depth)) 1))
        (Ok 0))))
(defn sx-sep [(p (ptr SexpSer))] (-> (Result i64 SerError))
  (let [slot (primitive/index (field p sep) (load (field p depth)))]
    (if (= (primitive/cast i64 (load slot)) (cast i64 1))
        (sx-byte p \space)
        (do (store! slot (primitive/cast u8 1)) (Ok 0)))))

(defn sx-esc [(p (ptr SexpSer)) (s (slice u8))] (-> (Result i64 SerError))
  (try
    (do (try! (sx-byte p \"))
        (let [n (slice-len s)]
          (for [i 0 n]
            (let [c (primitive/cast i64 (slice-get s i))]
              (cond (= c (cast i64 34)) (do (try! (sx-byte p \\)) (try! (sx-byte p \")) 0)
                    (= c (cast i64 92)) (do (try! (sx-byte p \\)) (try! (sx-byte p \\)) 0)
                    (= c (cast i64 10)) (do (try! (sx-byte p \\)) (try! (sx-byte p \n)) 0)
                    (= c (cast i64 9))  (do (try! (sx-byte p \\)) (try! (sx-byte p \t)) 0)
                    (= c (cast i64 13)) (do (try! (sx-byte p \\)) (try! (sx-byte p \r)) 0)
                    :else (do (try! (sx-byte p c)) 0)))))
        (sx-byte p \"))))

(defn sx-hexdig [(n i64)] (-> i64)
  (if (< n (cast i64 10)) (+ n 48) (+ n 55)))   ; 0-9 A-F
(defn sx-finite? [(x f64)] (-> bool)
  (if (primitive/fcmp-eq x 0.0) true (not (primitive/fcmp-eq (primitive/fdiv 1.0 x) 0.0))))

(impl Serializer SexpSer
  (ser-null [(s (ptr SexpSer))] (-> (Result i64 SerError)) (sx-put s "nil"))
  (ser-bool [(s (ptr SexpSer)) (v bool)] (-> (Result i64 SerError))
    (sx-put s (if v "true" "false")))
  (ser-i64 [(s (ptr SexpSer)) (v i64)] (-> (Result i64 SerError))
    (sx-io (print-i (load (field s w)) v)))
  (ser-u64 [(s (ptr SexpSer)) (v i64)] (-> (Result i64 SerError))
    (sx-io (print-u (load (field s w)) v)))
  (ser-f64 [(s (ptr SexpSer)) (v f64)] (-> (Result i64 SerError))
    (if (not (primitive/fcmp-eq v v))
        (sx-put s "nan")
        (if (not (sx-finite? v))
            (sx-put s (if (primitive/fcmp-gt v 0.0) "inf" "-inf"))
            (let [buf (alloc/stack (array i8 40))
                  n (primitive/cast i64 (snprintf (primitive/cast (ptr i8) buf) 40 c"%.17g" v))]
              (sx-io (write-all (load (field s w)) (primitive/cast (ptr i8) buf) n))))))
  (ser-str [(s (ptr SexpSer)) (v (slice u8))] (-> (Result i64 SerError)) (sx-esc s v))
  (ser-bytes [(s (ptr SexpSer)) (v (slice u8))] (-> (Result i64 SerError))
    (try
      (do (try! (sx-byte s \#))
          (try! (sx-byte s \"))
          (let [n (slice-len v)]
            (for [i 0 n]
              (let [b (primitive/cast i64 (slice-get v i))]
                (do (try! (sx-byte s (sx-hexdig (primitive/ishr b 4))))
                    (try! (sx-byte s (sx-hexdig (primitive/iand b 15))))
                    0))))
          (sx-byte s \"))))
  (seq-begin [(s (ptr SexpSer)) (len i64)] (-> (Result i64 SerError)) (sx-open s false))
  (seq-elem [(s (ptr SexpSer))] (-> (Result i64 SerError)) (sx-sep s))
  (seq-end [(s (ptr SexpSer))] (-> (Result i64 SerError)) (sx-close s))
  (map-begin [(s (ptr SexpSer)) (len i64)] (-> (Result i64 SerError))
    (try
      (do (try! (sx-open s false))
          (try! (sx-put s "map"))
          (store! (primitive/index (field s sep) (load (field s depth))) (primitive/cast u8 1))
          (Ok 0))))
  (map-key [(s (ptr SexpSer)) (k (slice u8))] (-> (Result i64 SerError))
    (try
      (do (try! (sx-sep s))
          (try! (sx-esc s k))
          (sx-byte s \space))))
  (map-end [(s (ptr SexpSer))] (-> (Result i64 SerError)) (sx-close s))
  (struct-begin [(s (ptr SexpSer)) (name (slice u8)) (nfields i64)] (-> (Result i64 SerError))
    (try
      (do (try! (sx-open s false))
          (try! (sx-put s name))
          (store! (primitive/index (field s sep) (load (field s depth))) (primitive/cast u8 1))
          (Ok 0))))
  (field-key [(s (ptr SexpSer)) (name (slice u8))] (-> (Result i64 SerError))
    (try
      (do (try! (sx-sep s))
          (try! (sx-put s name))
          (sx-byte s \space))))
  (struct-end [(s (ptr SexpSer))] (-> (Result i64 SerError)) (sx-close s))
  (variant-unit [(s (ptr SexpSer)) (sum (slice u8)) (tag (slice u8))] (-> (Result i64 SerError))
    (sx-put s tag))
  (variant-begin [(s (ptr SexpSer)) (sum (slice u8)) (tag (slice u8)) (nfields i64)] (-> (Result i64 SerError))
    (try
      (do (try! (sx-open s false))
          (try! (sx-put s tag))
          (store! (primitive/index (field s sep) (load (field s depth))) (primitive/cast u8 1))
          (Ok 0))))
  (variant-end [(s (ptr SexpSer))] (-> (Result i64 SerError)) (sx-close s)))

; ============================ reader: a preorder token tape =================
; kinds: 0 nil, 1 bool (aux = value), 2 number (text span), 3 string (content
; span; aux = 1 when it contains escapes), 4 list (aux = DIRECT child count,
; head symbol included), 5 symbol (text span), 6 bytes (hex content span)
(defstruct SxTok [(kind i64) (start i64) (end i64) (aux i64)])
(defstruct SxDoc [(source (slice u8)) (toks (ArrayList SxTok))])
(defstruct SxParser [(src (slice u8)) (pos i64) (status i64) (toks (ArrayList SxTok))])

(defn sxp-end? [(p (ptr SxParser))] (-> bool)
  (>= (load (field p pos)) (slice-len (load (field p src)))))
(defn sxp-peek [(p (ptr SxParser))] (-> i64)
  (if (sxp-end? p) -1 (primitive/cast i64 (slice-get (load (field p src)) (load (field p pos))))))
(defn sxp-adv [(p (ptr SxParser))] (-> i64)
  (store! (field p pos) (+ (load (field p pos)) 1)))
(defn sxp-fail [(p (ptr SxParser))] (-> i64)
  (if (= (load (field p status)) (cast i64 0)) (store! (field p status) 1) 0))
(defn sxp-ws? [(c i64)] (-> bool)
  (or (= c (cast i64 32)) (or (= c (cast i64 10)) (or (= c (cast i64 9)) (= c (cast i64 13))))))
(defn sxp-skip-ws [(p (ptr SxParser))] (-> i64)
  (loop (if (sxp-ws? (sxp-peek p)) (sxp-adv p) (break)))
  0)
(defn sxp-delim? [(c i64)] (-> bool)
  (or (= c (cast i64 -1)) (or (sxp-ws? c) (or (= c (cast i64 40)) (= c (cast i64 41))))))
(defn sxp-digit? [(c i64)] (-> bool) (and (>= c (cast i64 48)) (<= c (cast i64 57))))

(defn sxp-add [(p (ptr SxParser)) (kind i64) (start i64) (end i64) (aux i64)] (-> i64)
  (let [(mut t) (primitive/zeroed SxTok)
        idx (al-len [SxTok] (load (field p toks)))]
    (store! (field t kind) kind)
    (store! (field t start) start)
    (store! (field t end) end)
    (store! (field t aux) aux)
    (al-push! (mut (field p toks)) (load t))
    idx))

(defn sxp-string [(p (ptr SxParser)) (kind i64)] (-> i64)
  (do (sxp-adv p)   ; opening quote
      (let [start (load (field p pos))
            (mut esc) 0
            (mut done) false]
        (loop
          (let [c (sxp-peek p)]
            (cond (= c (cast i64 -1)) (do (sxp-fail p) (break))
                  (= c (cast i64 34)) (do (store! done true) (break))
                  (= c (cast i64 92))
                    (do (store! esc 1) (sxp-adv p)
                        (if (= (sxp-peek p) (cast i64 -1)) (do (sxp-fail p) (break)) (sxp-adv p)))
                  :else (sxp-adv p))))
        (if (load done)
            (let [end (load (field p pos))]
              (sxp-adv p)
              (sxp-add p kind start end (load esc)))
            -1))))

(defn sxp-value [(p (ptr SxParser))] (-> i64)
  (sxp-skip-ws p)
  (let [c (sxp-peek p)]
    (cond
      (= c (cast i64 40))   ; '(' list
        (let [open (load (field p pos))
              idx (sxp-add p 4 open 0 0)
              (mut count) 0]
          (sxp-adv p)
          (loop
            (sxp-skip-ws p)
            (cond (!= (load (field p status)) (cast i64 0)) (break)
                  (= (sxp-peek p) (cast i64 41)) (do (sxp-adv p) (break))
                  (= (sxp-peek p) (cast i64 -1)) (do (sxp-fail p) (break))
                  :else (do (sxp-value p) (store! count (+ (load count) 1)) 0)))
          (when (= (load (field p status)) (cast i64 0))
            (store! (field (primitive/index (load (field (field p toks) data)) idx) end)
                    (load (field p pos)))
            (store! (field (primitive/index (load (field (field p toks) data)) idx) aux)
                    (load count))
            0)
          idx)
      (= c (cast i64 34)) (sxp-string p 3)   ; string
      (= c (cast i64 35))                    ; '#' -> #"hex"
        (do (sxp-adv p)
            (if (= (sxp-peek p) (cast i64 34))
                (sxp-string p 6)
                (do (sxp-fail p) -1)))
      (or (= c (cast i64 45)) (sxp-digit? c))   ; number (or the symbol '-inf')
        (let [start (load (field p pos))
              minus-inf (and (= c (cast i64 45))
                             (and (< (+ start 1) (slice-len (load (field p src))))
                                  (= (primitive/cast i64 (slice-get (load (field p src)) (+ start 1)))
                                     (cast i64 105))))]
          (loop (if (sxp-delim? (sxp-peek p)) (break) (sxp-adv p)))
          (sxp-add p (if minus-inf 5 2) start (load (field p pos)) 0))
      (= c (cast i64 -1)) (do (sxp-fail p) -1)
      (= c (cast i64 41)) (do (sxp-fail p) -1)
      :else   ; symbol: nil / true / false / a tag / -inf / nan
        (let [start (load (field p pos))]
          (loop (if (sxp-delim? (sxp-peek p)) (break) (sxp-adv p)))
          (let [text (subslice (load (field p src)) start (load (field p pos)))]
            (cond (str-eq text "nil") (sxp-add p 0 start (load (field p pos)) 0)
                  (str-eq text "true") (sxp-add p 1 start (load (field p pos)) 1)
                  (str-eq text "false") (sxp-add p 1 start (load (field p pos)) 0)
                  :else (sxp-add p 5 start (load (field p pos)) 0)))))))

;; Parse ONE complete sexp document. Err payload = byte offset.
(defn sx-parse [(a (ptr Allocator)) (src (slice u8))] (-> (Result SxDoc i64))
  (let [p (alloc/stack SxParser)]
    (store! (field p src) src)
    (store! (field p pos) 0)
    (store! (field p status) 0)
    (store! (field p toks) (al-new [SxTok] a))
    (sxp-value p)
    (sxp-skip-ws p)
    (if (and (= (load (field p status)) (cast i64 0)) (sxp-end? p))
        (let [(mut d) (primitive/zeroed SxDoc)]
          (store! (field d source) src)
          (store! (field d toks) (load (field p toks)))
          (Ok (load d)))
        (Err (load (field p pos))))))

; ============================ deserializer ==================================
(defstruct SexpDe
  [(doc SxDoc) (at i64) (alc (ptr Allocator)) (stk (array i64 64)) (sp i64)])

(defn sd-tok [(p (ptr SexpDe))] (-> SxTok)
  (al-get [SxTok] (load (field (field p doc) toks)) (load (field p at))))
(defn sd-tok-at [(p (ptr SexpDe)) (i i64)] (-> SxTok)
  (al-get [SxTok] (load (field (field p doc) toks)) i))
(defn sd-off [(p (ptr SexpDe))] (-> i64)
  (let [t (sd-tok p)] (load (field t start))))
(defn sd-text [(p (ptr SexpDe)) (t SxTok)] (-> (slice u8))
  (subslice (load (field (field p doc) source)) (load (field t start)) (load (field t end))))

(defn sd-skip [(p (ptr SexpDe)) (i i64)] (-> i64)
  (let [t (sd-tok-at p i)]
    (if (= (load (field t kind)) (cast i64 4))
        (let [(mut at) (+ i 1)
              total (load (field t aux))]
          (for [n 0 total]
            (store! at (sd-skip p (load at))))
          (load at))
        (+ i 1))))
(defn sd-adv! [(p (ptr SexpDe))] (-> i64)
  (store! (field p at) (sd-skip p (load (field p at)))))
;; index of direct child n of the list at `li`
(defn sd-child [(p (ptr SexpDe)) (li i64) (n i64)] (-> i64)
  (let [(mut at) (+ li 1)]
    (for [i 0 n]
      (store! at (sd-skip p (load at))))
    (load at)))

(defn sd-push! [(p (ptr SexpDe)) (v i64)] (-> (Result i64 DeError))
  (if (>= (load (field p sp)) (cast i64 64))
      (Err (de-err DE-E-DEPTH (sd-off p) "nesting too deep"))
      (do (store! (primitive/index (field p stk) (load (field p sp))) v)
          (store! (field p sp) (+ (load (field p sp)) 1))
          (Ok 0))))
(defn sd-pop! [(p (ptr SexpDe))] (-> i64)
  (store! (field p sp) (- (load (field p sp)) 1))
  (load (primitive/index (field p stk) (load (field p sp)))))
(defn sd-top [(p (ptr SexpDe))] (-> i64)
  (load (primitive/index (field p stk) (- (load (field p sp)) 1))))

;; unescape a string token's content (zero-copy when escape-free)
(defn sd-unescape [(p (ptr SexpDe)) (t SxTok)] (-> (Result (slice u8) DeError))
  (let [raw (sd-text p t)]
    (if (= (load (field t aux)) (cast i64 0))
        (Ok raw)
        (let [n (slice-len raw)
              (mut l) (al-new [u8] (load (field p alc)))
              (mut i) 0]
          (while (< (load i) n)
            (let [c (primitive/cast i64 (slice-get raw (load i)))]
              (if (!= c (cast i64 92))
                  (do (al-push! (mut l) (slice-get raw (load i)))
                      (store! i (+ (load i) 1)))
                  (let [e (primitive/cast i64 (slice-get raw (+ (load i) 1)))]
                    (cond (= e (cast i64 110)) (al-push! (mut l) (primitive/cast u8 10))
                          (= e (cast i64 116)) (al-push! (mut l) (primitive/cast u8 9))
                          (= e (cast i64 114)) (al-push! (mut l) (primitive/cast u8 13))
                          :else (al-push! (mut l) (primitive/cast u8 e)))   ; \" \\ and any other byte
                    (store! i (+ (load i) 2))))))
          (Ok (slice-new [u8] (load (field l data)) (al-len [u8] (load l))))))))

;; strict i64 over a number token's text ('.'/'e' reject; overflow errors)
(defn sd-int [(text (slice u8)) (off i64)] (-> (Result i64 DeError))
  (try
    (let [n (slice-len text)
          neg (= (primitive/cast i64 (slice-get text 0)) (cast i64 45))
          (mut acc) 0
          (mut i) (if (= (primitive/cast i64 (slice-get text 0)) (cast i64 45)) 1 0)]
      (when (>= (load i) n)   ; a lone '-'
        (return-from :try (Err (de-err DE-E-EXPECTED-INT off "number is not an integer"))))
      (while (< (load i) n)
        (let [c (primitive/cast i64 (slice-get text (load i)))]
          (if (and (>= c (cast i64 48)) (<= c (cast i64 57)))
              (let [d (- c 48)]
                (if (< (load acc) (primitive/idiv (+ -9223372036854775808 d) 10))
                    (return-from :try (Err (de-err DE-E-INT-RANGE off "integer overflows i64")))
                    (do (store! acc (- (* (load acc) 10) d))
                        (store! i (+ (load i) 1))
                        0)))
              (return-from :try (Err (de-err DE-E-EXPECTED-INT off "number is not an integer"))))))
      (if neg
          (Ok (load acc))
          (if (= (load acc) -9223372036854775808)
              (Err (de-err DE-E-INT-RANGE off "integer overflows i64"))
              (Ok (- 0 (load acc))))))))
(defn sd-uint [(text (slice u8)) (off i64)] (-> (Result i64 DeError))
  (try
    (let [n (slice-len text)
          (mut acc) 0
          (mut i) 0]
      (when (= (primitive/cast i64 (slice-get text 0)) (cast i64 45))
        (return-from :try (Err (de-err DE-E-INT-RANGE off "negative number for unsigned field"))))
      (while (< (load i) n)
        (let [c (primitive/cast i64 (slice-get text (load i)))]
          (if (and (>= c (cast i64 48)) (<= c (cast i64 57)))
              (let [d (- c 48)
                    limit (primitive/udiv (primitive/isub -1 d) 10)]
                (if (> (primitive/cast u64 (load acc)) (primitive/cast u64 limit))
                    (return-from :try (Err (de-err DE-E-INT-RANGE off "integer overflows u64")))
                    (do (store! acc (+ (* (load acc) 10) d))
                        (store! i (+ (load i) 1))
                        0)))
              (return-from :try (Err (de-err DE-E-EXPECTED-INT off "number is not an integer"))))))
      (Ok (load acc)))))

(defn sd-float [(p (ptr SexpDe)) (text (slice u8))] (-> f64)
  (let [n (slice-len text)
        buf (unwrap-ptr [i8] (raw-alloc (load (field p alc)) (+ n 1) 1))]
    (for [i 0 n]
      (store! (primitive/index buf i) (primitive/cast i8 (slice-get text i))))
    (store! (primitive/index buf n) (primitive/cast i8 0))
    (strtod buf (primitive/cast (ptr (ptr i8)) 0))))

(defn sd-hexval [(c i64)] (-> i64)
  (cond (and (>= c (cast i64 48)) (<= c (cast i64 57))) (- c 48)
        (and (>= c (cast i64 97)) (<= c (cast i64 102))) (- c 87)
        (and (>= c (cast i64 65)) (<= c (cast i64 70))) (- c 55)
        :else -1))

;; the list at the cursor must have a head symbol equal to `name`
(defn sd-expect-headed [(d (ptr SexpDe)) (name (slice u8)) (code i64)] (-> (Result i64 DeError))
  (let [t (sd-tok d)]
    (if (!= (load (field t kind)) (cast i64 4))
        (Err (de-err code (sd-off d) name))
        (if (< (load (field t aux)) (cast i64 1))
            (Err (de-err code (sd-off d) name))
            (let [h (sd-tok-at d (+ (load (field d at)) 1))]
              (if (!= (load (field h kind)) (cast i64 5))
                  (Err (de-err code (sd-off d) name))
                  (if (str-eq (sd-text d h) name)
                      (Ok 0)
                      (Err (de-err code (sd-off d) name)))))))))

(defn sd-int-text? [(s (slice u8))] (-> bool)
  (let [n (slice-len s)
        (mut isint) true]
    (for [i 0 n]
      (let [c (primitive/cast i64 (slice-get s i))]
        (when (or (= c (cast i64 46)) (or (= c (cast i64 101)) (= c (cast i64 69))))
          (store! isint false)
          0)))
    (load isint)))

(impl Deserializer SexpDe
  (de-kind [(d (ptr SexpDe))] (-> i64)
    (let [t (sd-tok d)
          k (load (field t kind))]
      (cond (= k (cast i64 0)) SD-K-NULL
            (= k (cast i64 1)) SD-K-BOOL
            (= k (cast i64 2)) (if (sd-int-text? (sd-text d t)) SD-K-INT SD-K-FLOAT)
            (= k (cast i64 3)) SD-K-STR
            (= k (cast i64 6)) SD-K-BYTES
            (= k (cast i64 4))
              ; a (map …)-headed list is a map; any other list is a seq
              (if (>= (load (field t aux)) (cast i64 1))
                  (let [h (sd-tok-at d (+ (load (field d at)) 1))]
                    (if (and (= (load (field h kind)) (cast i64 5))
                             (str-eq (sd-text d h) "map"))
                        SD-K-MAP
                        SD-K-SEQ))
                  SD-K-SEQ)
            (= k (cast i64 5))
              ; nan/inf/-inf are floats; any other bare symbol reads as a string
              (let [text (sd-text d t)]
                (if (or (str-eq text "nan") (or (str-eq text "inf") (str-eq text "-inf")))
                    SD-K-FLOAT
                    SD-K-STR))
            :else SD-K-OTHER)))
  (de-null? [(d (ptr SexpDe))] (-> bool)
    (let [t (sd-tok d)]
      (if (= (load (field t kind)) (cast i64 0))
          (do (sd-adv! d) true)
          false)))
  (de-bool [(d (ptr SexpDe))] (-> (Result bool DeError))
    (let [t (sd-tok d)]
      (if (= (load (field t kind)) (cast i64 1))
          (do (sd-adv! d) (Ok (!= (load (field t aux)) (cast i64 0))))
          (Err (de-err DE-E-EXPECTED-BOOL (sd-off d) "expected true/false")))))
  (de-i64 [(d (ptr SexpDe))] (-> (Result i64 DeError))
    (try
      (let [t (sd-tok d)]
        (if (!= (load (field t kind)) (cast i64 2))
            (Err (de-err DE-E-EXPECTED-INT (sd-off d) "expected a number"))
            (let [v (try! (sd-int (sd-text d t) (load (field t start))))]
              (sd-adv! d)
              (Ok v))))))
  (de-u64 [(d (ptr SexpDe))] (-> (Result i64 DeError))
    (try
      (let [t (sd-tok d)]
        (if (!= (load (field t kind)) (cast i64 2))
            (Err (de-err DE-E-EXPECTED-INT (sd-off d) "expected a number"))
            (let [v (try! (sd-uint (sd-text d t) (load (field t start))))]
              (sd-adv! d)
              (Ok v))))))
  (de-f64 [(d (ptr SexpDe))] (-> (Result f64 DeError))
    (let [t (sd-tok d)]
      (cond (= (load (field t kind)) (cast i64 2))
              (let [v (sd-float d (sd-text d t))]
                (sd-adv! d)
                (Ok v))
            (= (load (field t kind)) (cast i64 5))   ; nan / inf / -inf
              (let [text (sd-text d t)]
                (cond (str-eq text "nan") (do (sd-adv! d) (Ok (primitive/fdiv 0.0 0.0)))
                      (str-eq text "inf") (do (sd-adv! d) (Ok (primitive/fdiv 1.0 0.0)))
                      (str-eq text "-inf") (do (sd-adv! d) (Ok (primitive/fdiv -1.0 0.0)))
                      :else (Err (de-err DE-E-EXPECTED-FLOAT (sd-off d) "expected a number"))))
            :else (Err (de-err DE-E-EXPECTED-FLOAT (sd-off d) "expected a number")))))
  (de-str [(d (ptr SexpDe))] (-> (Result (slice u8) DeError))
    ; bare symbols also read as strings (struct keys and DOM decoding need it)
    (try
      (let [t (sd-tok d)]
        (cond (= (load (field t kind)) (cast i64 3))
                (let [s (try! (sd-unescape d t))]
                  (sd-adv! d)
                  (Ok s))
              (= (load (field t kind)) (cast i64 5))
                (let [s (sd-text d t)]
                  (sd-adv! d)
                  (Ok s))
              :else (Err (de-err DE-E-EXPECTED-STR (sd-off d) "expected a string"))))))
  (de-bytes [(d (ptr SexpDe))] (-> (Result (slice u8) DeError))
    (let [t (sd-tok d)]
      (if (!= (load (field t kind)) (cast i64 6))
          (Err (de-err DE-E-EXPECTED-STR (sd-off d) "expected #\"hex\" bytes"))
          (let [raw (sd-text d t)
                n (slice-len raw)]
            (if (!= (primitive/irem n 2) (cast i64 0))
                (Err (de-err DE-E-BAD-STRING (sd-off d) "odd hex digit count"))
                (let [(mut l) (al-new [u8] (load (field d alc)))
                      (mut bad) false]
                  (for [i 0 (primitive/idiv n 2)]
                    (let [hi (sd-hexval (primitive/cast i64 (slice-get raw (* i 2))))
                          lo (sd-hexval (primitive/cast i64 (slice-get raw (+ (* i 2) 1))))]
                      (if (or (< hi (cast i64 0)) (< lo (cast i64 0)))
                          (store! bad true)
                          (do (al-push! (mut l) (primitive/cast u8 (+ (* hi 16) lo))) 0))))
                  (if (load bad)
                      (Err (de-err DE-E-BAD-STRING (sd-off d) "invalid hex digit"))
                      (do (sd-adv! d)
                          (Ok (slice-new [u8] (load (field l data)) (al-len [u8] (load l))))))))))))
  (de-seq-begin [(d (ptr SexpDe))] (-> (Result i64 DeError))
    (let [t (sd-tok d)]
      (if (!= (load (field t kind)) (cast i64 4))
          (Err (de-err DE-E-EXPECTED-SEQ (sd-off d) "expected a list"))
          (do (store! (field d at) (+ (load (field d at)) 1))
              (Ok (load (field t aux)))))))
  (de-seq-end [(d (ptr SexpDe))] (-> (Result i64 DeError))
    (Ok 0))
  (de-map-begin [(d (ptr SexpDe))] (-> (Result i64 DeError))
    (try
      (do (try! (sd-expect-headed d "map" DE-E-EXPECTED-MAP))
          (let [t (sd-tok d)]
            (try! (sd-push! d (load (field d at))))
            (Ok (primitive/idiv (- (load (field t aux)) 1) 2))))))
  (de-map-key [(d (ptr SexpDe)) (n i64)] (-> (Result (slice u8) DeError))
    ; string keys (maps) and symbol keys (struct frames) both answer
    (let [ki (sd-child d (sd-top d) (+ 1 (* n 2)))
          kt (sd-tok-at d ki)]
      (cond (= (load (field kt kind)) (cast i64 3)) (sd-unescape d kt)
            (= (load (field kt kind)) (cast i64 5)) (Ok (sd-text d kt))
            :else (Err (de-err DE-E-EXPECTED-STR (load (field kt start)) "expected a key")))))
  (de-map-value [(d (ptr SexpDe)) (n i64)] (-> (Result i64 DeError))
    (do (store! (field d at) (sd-child d (sd-top d) (+ 2 (* n 2))))
        (Ok 0)))
  (de-map-end [(d (ptr SexpDe))] (-> (Result i64 DeError))
    (do (store! (field d at) (sd-skip d (sd-pop! d)))
        (Ok 0)))
  (de-struct-begin [(d (ptr SexpDe)) (name (slice u8))] (-> (Result i64 DeError))
    (try
      (do (try! (sd-expect-headed d name DE-E-EXPECTED-OBJECT))
          (let [t (sd-tok d)]
            (try! (sd-push! d (load (field d at))))
            (Ok (primitive/idiv (- (load (field t aux)) 1) 2))))))
  (de-field [(d (ptr SexpDe)) (name (slice u8))] (-> (Result bool DeError))
    (let [li (sd-top d)
          t (sd-tok-at d li)
          pairs (primitive/idiv (- (load (field t aux)) 1) 2)
          (mut found) false]
      (for [i 0 pairs]
        (when (not (load found))
          (let [ni (sd-child d li (+ 1 (* i 2)))
                nt (sd-tok-at d ni)]
            (when (and (= (load (field nt kind)) (cast i64 5))
                       (str-eq (sd-text d nt) name))
              (store! (field d at) (sd-skip d ni))
              (store! found true)
              0))
          0))
      (Ok (load found))))
  (de-struct-end [(d (ptr SexpDe))] (-> (Result i64 DeError))
    (do (store! (field d at) (sd-skip d (sd-pop! d)))
        (Ok 0)))
  (de-variant [(d (ptr SexpDe))] (-> (Result (slice u8) DeError))
    (let [t (sd-tok d)]
      (cond (= (load (field t kind)) (cast i64 5))   ; bare tag = unit variant
              (try
                (do (try! (sd-push! d -1))
                    (let [tag (sd-text d t)]
                      (sd-adv! d)
                      (Ok tag))))
            (= (load (field t kind)) (cast i64 4))   ; (Tag …): leave cursor for de-struct-begin
              (if (< (load (field t aux)) (cast i64 1))
                  (Err (de-err DE-E-EXPECTED-VARIANT (sd-off d) "expected a variant"))
                  (let [h (sd-tok-at d (+ (load (field d at)) 1))]
                    (if (!= (load (field h kind)) (cast i64 5))
                        (Err (de-err DE-E-EXPECTED-VARIANT (sd-off d) "expected a variant tag symbol"))
                        (try
                          (do (try! (sd-push! d -1))
                              (Ok (sd-text d h)))))))
            :else (Err (de-err DE-E-EXPECTED-VARIANT (sd-off d) "expected a variant")))))
  (de-variant-end [(d (ptr SexpDe))] (-> (Result i64 DeError))
    (do (sd-pop! d)
        (Ok 0)))
  (de-alloc [(d (ptr SexpDe))] (-> (ptr Allocator))
    (load (field d alc))))

; ============================ conveniences ==================================
;; Serialize `x` as an s-expression to any Writer.
(defn to-sexp [(T Serialize)] [(x T) (w (ptr Writer))] (-> (Result i64 SerError))
  (let [ss (alloc/stack SexpSer)]
    (store! ss (primitive/zeroed SexpSer))
    (store! (field ss w) w)
    (ser x (primitive/make-dyn Serializer ss))))

;; Serialize `x` to a string allocated from `a`.
(defn to-sexp-str [(T Serialize)] [(a (ptr Allocator)) (x T)] (-> (Result (slice u8) SerError))
  (let [g (alloc/stack GrowBuf)
        w (alloc/stack Writer)
        ss (alloc/stack SexpSer)]
    (grow-writer w g a)
    (store! ss (primitive/zeroed SexpSer))
    (store! (field ss w) w)
    (match (ser x (primitive/make-dyn Serializer ss))
      (Err [e] (Err e))
      (Ok [_] (Ok (grow-str g))))))

;; Parse + decode one complete sexp document into a T.
(defn from-sexp [(T Deserialize)] [(a (ptr Allocator)) (src (slice u8))] (-> (Result T DeError))
  (match (sx-parse a src)
    (Err [off] (Err (de-err DE-E-PARSE off "invalid s-expression")))
    (Ok [doc]
      (let [dd (alloc/stack SexpDe)
            slot (alloc/stack T)]
        (store! dd (primitive/zeroed SexpDe))
        (store! (field dd doc) doc)
        (store! (field dd at) 0)
        (store! (field dd alc) a)
        (match (de slot (primitive/make-dyn Deserializer dd))
          (Err [e] (Err e))
          (Ok [_] (Ok (load slot))))))))
