(module coil.sync)
(import "coil.primitive" :as primitive)
(import "coil.alloc" :as alloc)
(import "coil.slice" :use [slice-new slice-data])
(import "coil.time" :as time)

; Opaque pthread storage for the two hosted ABIs Coil supports. Keep the choice
; compile-time so importing synchronization never launches a C compiler.
(defn sync-os-pick [(linux Code) (darwin Code)] (-> Code)
  (if (primitive/code-eq (primitive/target-os) `linux) linux darwin))
; hygiene: platform-layout declarations intentionally use stable public names
(defn sync-public-name [(name Code)] (-> Code)
  (primitive/syntax->datum name))
(defn sync-pthread-layout [] (-> Code)
  `(do
     (const ~(sync-public-name `PTHREAD_MUTEX_SIZE) ~(sync-os-pick `40 `64))
     (const ~(sync-public-name `PTHREAD_MUTEX_ALIGN) 8)
     (const ~(sync-public-name `PTHREAD_COND_SIZE) 48)
     (const ~(sync-public-name `PTHREAD_COND_ALIGN) 8)))
(meta (sync-pthread-layout))

(extern pthread_mutex_init :cc c [(ptr i8) (ptr i8)] (-> i32))
(extern pthread_mutex_lock :cc c [(ptr i8)] (-> i32))
(extern pthread_mutex_trylock :cc c [(ptr i8)] (-> i32))
(extern pthread_mutex_unlock :cc c [(ptr i8)] (-> i32))
(extern pthread_mutex_destroy :cc c [(ptr i8)] (-> i32))
(extern pthread_cond_init :cc c [(ptr i8) (ptr i8)] (-> i32))
(extern pthread_cond_wait :cc c [(ptr i8) (ptr i8)] (-> i32))
(extern pthread_cond_timedwait :cc c [(ptr i8) (ptr i8) (ptr time/Timespec)] (-> i32))
(extern pthread_cond_signal :cc c [(ptr i8)] (-> i32))
(extern pthread_cond_broadcast :cc c [(ptr i8)] (-> i32))
(extern pthread_cond_destroy :cc c [(ptr i8)] (-> i32))

(export Mutex
        Condition
        Once
        Event
        SyncError
        InitFailed
        LockFailed
        UnlockFailed
        WaitFailed
        NotifyFailed
        DestroyFailed
        Timeout
        WaitResult
        Notified
        mutex-init
        mutex-init-with-allocator
        mutex-lock!
        mutex-try-lock!
        mutex-unlock!
        mutex-destroy!
        condition-init
        condition-init-with-allocator
        condition-wait!
        condition-wait-for!
        condition-notify-one!
        condition-notify-all!
        condition-destroy!
        once-init
        once-init-with-allocator
        once-call!
        once-destroy!
        event-init
        event-init-with-allocator
        event-new
        event-generation
        event-notify-all!
        event-wait!
        event-wait-for!
        event-destroy!)

(defsum SyncError
  (InitFailed [(code i64)])
  (LockFailed [(code i64)])
  (UnlockFailed [(code i64)])
  (WaitFailed [(code i64)])
  (NotifyFailed [(code i64)])
  (DestroyFailed [(code i64)]))

(defsum WaitResult (Notified [(generation i64)]) (Timeout))

(defstruct Mutex [(raw (ptr i8)) (allocator (dyn alloc/Allocator)) (initialized bool)])
(defstruct Condition [(raw (ptr i8)) (allocator (dyn alloc/Allocator)) (initialized bool)])
; Once is implemented over the same portable mutex primitive.  This avoids depending
; on PTHREAD_ONCE_INIT's platform-specific byte pattern while preserving retry-on-error.
(defstruct Once [(mutex Mutex) (completed bool) (initialized bool)])
(defstruct Event [(mutex Mutex) (condition Condition) (generation i64) (initialized bool)])

(defn null-bytes [] (-> (ptr i8))
  (primitive/cast (ptr i8) 0))

(defn mutex-init-with-allocator [(mutex (ptr Mutex)) (a (dyn alloc/Allocator))] (-> (Result (ptr Mutex) SyncError))
  (match (alloc/alloc-bytes a PTHREAD_MUTEX_SIZE PTHREAD_MUTEX_ALIGN)
    (None [] (Err (InitFailed 12)))
    (Some [memory]
          (let [raw (primitive/cast (ptr i8) (slice-data memory))
                rc (pthread_mutex_init raw (null-bytes))]
            (if (= rc 0)
                (do
                  (set! (.raw mutex) raw)
                  (set! (.allocator mutex) a)
                  (set! (.initialized mutex) true)
                  (Ok mutex))
                (do
                  (alloc/free-bytes a memory PTHREAD_MUTEX_ALIGN)
                  (Err (InitFailed (primitive/cast i64 rc)))))))))

(defn mutex-init [(mutex (ptr Mutex))] (-> (Result (ptr Mutex) SyncError))
  (mutex-init-with-allocator mutex (alloc/malloc-allocator)))

(defn mutex-lock! [(mutex (ptr Mutex))] (-> (Result i64 SyncError))
  (let [rc (pthread_mutex_lock (load (field mutex raw)))]
    (if (= rc 0) (Ok 0) (Err (LockFailed (primitive/cast i64 rc))))))

(defn mutex-try-lock! [(mutex (ptr Mutex))] (-> (Result bool SyncError))
  (let [rc (pthread_mutex_trylock (load (field mutex raw)))]
    (cond (= rc 0) (Ok true)
          ; EBUSY is 16 on the supported POSIX targets.
          (= rc 16) (Ok false)
          :else (Err (LockFailed (primitive/cast i64 rc))))))

(defn mutex-unlock! [(mutex (ptr Mutex))] (-> (Result i64 SyncError))
  (let [rc (pthread_mutex_unlock (load (field mutex raw)))]
    (if (= rc 0) (Ok 0) (Err (UnlockFailed (primitive/cast i64 rc))))))

(defn mutex-destroy! [(mutex (ptr Mutex))] (-> (Result i64 SyncError))
  (if (not (.initialized mutex))
      (Ok 0)
      (let [rc (pthread_mutex_destroy (load (field mutex raw)))]
        (if (= rc 0)
            (do
              (alloc/free-bytes (.allocator mutex)
                                (slice-new (primitive/cast (ptr u8) (load (field mutex raw))) PTHREAD_MUTEX_SIZE)
                                PTHREAD_MUTEX_ALIGN)
              (set! (.initialized mutex) false)
              (set! (.raw mutex) (null-bytes))
              (Ok 0))
            (Err (DestroyFailed (primitive/cast i64 rc)))))))

(defn condition-init-with-allocator [(condition (ptr Condition)) (a (dyn alloc/Allocator))] (-> (Result (ptr Condition)
                                                                                                        SyncError))
  (match (alloc/alloc-bytes a PTHREAD_COND_SIZE PTHREAD_COND_ALIGN)
    (None [] (Err (InitFailed 12)))
    (Some [memory]
          (let [raw (primitive/cast (ptr i8) (slice-data memory))
                rc (pthread_cond_init raw (null-bytes))]
            (if (= rc 0)
                (do
                  (set! (.raw condition) raw)
                  (set! (.allocator condition) a)
                  (set! (.initialized condition) true)
                  (Ok condition))
                (do
                  (alloc/free-bytes a memory PTHREAD_COND_ALIGN)
                  (Err (InitFailed (primitive/cast i64 rc)))))))))

(defn condition-init [(condition (ptr Condition))] (-> (Result (ptr Condition) SyncError))
  (condition-init-with-allocator condition (alloc/malloc-allocator)))

(defn condition-wait! [(condition (ptr Condition)) (mutex (ptr Mutex))] (-> (Result i64 SyncError))
  (let [rc (pthread_cond_wait (load (field condition raw)) (load (field mutex raw)))]
    (if (= rc 0) (Ok 0) (Err (WaitFailed (primitive/cast i64 rc))))))

(defn wall-deadline-timespec [(duration time/Duration) (out (ptr time/Timespec))] (-> (Result i64 SyncError))
  (match (time/wall-now)
    (Err [e] (Err (WaitFailed (time/time-error-code e))))
    (Ok [now]
        (let [(mut nowp) now]
             (let [sum (+ (.nsec nowp) (.nsec duration))
                   carry (/ sum 1000000000)]
               (set! (.sec out) (+ (+ (.sec nowp) (.sec duration)) carry))
               (set! (.nsec out) (% sum 1000000000))
               (Ok 0))))))

(defn condition-wait-for! [(condition (ptr Condition)) (mutex (ptr Mutex)) (duration time/Duration)] (-> (Result WaitResult
                                                                                                                 SyncError))
  (let [deadline (primitive/alloc-stack time/Timespec)]
    (match (wall-deadline-timespec duration deadline)
      (Err [e] (Err e))
      (Ok [_]
          (let [rc
                  (pthread_cond_timedwait (load (field condition raw))
                                          (load (field mutex raw))
                                          deadline)]
            (cond (= rc 0) (Ok (Notified 0))
                  ; Darwin and Linux ETIMEDOUT values.
                  (or (= rc 60) (= rc 110)) (Ok (Timeout))
                  :else (Err (WaitFailed (primitive/cast i64 rc)))))))))

(defn condition-notify-one! [(condition (ptr Condition))] (-> (Result i64 SyncError))
  (let [rc (pthread_cond_signal (load (field condition raw)))]
    (if (= rc 0) (Ok 0) (Err (NotifyFailed (primitive/cast i64 rc))))))

(defn condition-notify-all! [(condition (ptr Condition))] (-> (Result i64 SyncError))
  (let [rc (pthread_cond_broadcast (load (field condition raw)))]
    (if (= rc 0) (Ok 0) (Err (NotifyFailed (primitive/cast i64 rc))))))

(defn condition-destroy! [(condition (ptr Condition))] (-> (Result i64 SyncError))
  (if (not (.initialized condition))
      (Ok 0)
      (let [rc (pthread_cond_destroy (load (field condition raw)))]
        (if (= rc 0)
            (do
              (alloc/free-bytes (.allocator condition)
                                (slice-new (primitive/cast (ptr u8) (load (field condition raw))) PTHREAD_COND_SIZE)
                                PTHREAD_COND_ALIGN)
              (set! (.initialized condition) false)
              (set! (.raw condition) (null-bytes))
              (Ok 0))
            (Err (DestroyFailed (primitive/cast i64 rc)))))))

(defn once-init-with-allocator [(once (ptr Once)) (a (dyn alloc/Allocator))] (-> (Result (ptr Once) SyncError))
  (match (mutex-init-with-allocator (field once mutex) a)
    (Err [e] (Err e))
    (Ok [_]
        (do
          (set! (.completed once) false)
          (set! (.initialized once) true)
          (Ok once)))))

(defn once-init [(once (ptr Once))] (-> (Result (ptr Once) SyncError))
  (once-init-with-allocator once (alloc/malloc-allocator)))

(defn once-call! [(once (ptr Once)) (body (fnptr c [] i64))] (-> (Result i64 SyncError))
  (match (mutex-lock! (field once mutex))
    (Err [e] (Err e))
    (Ok [_]
        (let [rc
                (if (.completed once)
                    0
                    (primitive/call-ptr body))]
          (when (= rc 0) (store! (field once completed) true))
          (match (mutex-unlock! (field once mutex))
            (Err [e] (Err e))
            (Ok [_]
                (if (= rc 0) (Ok 0) (Err (InitFailed rc)))))))))

(defn once-destroy! [(once (ptr Once))] (-> (Result i64 SyncError))
  (if (not (.initialized once))
      (Ok 0)
      (match (mutex-destroy! (field once mutex))
        (Err [e] (Err e))
        (Ok [_]
            (do (set! (.initialized once) false) (Ok 0))))))

(defn event-init-with-allocator [(event (ptr Event)) (a (dyn alloc/Allocator))] (-> (Result (ptr Event) SyncError))
  (match (mutex-init-with-allocator (field event mutex) a)
    (Err [e] (Err e))
    (Ok [_]
        (match (condition-init-with-allocator (field event condition) a)
          (Err [e] (do (mutex-destroy! (field event mutex)) (Err e)))
          (Ok [_]
              (do
                (set! (.generation event) 0)
                (set! (.initialized event) true)
                (Ok event)))))))

(defn event-init [(event (ptr Event))] (-> (Result (ptr Event) SyncError))
  (event-init-with-allocator event (alloc/malloc-allocator)))

(defn event-new [(a (dyn alloc/Allocator))] (-> (Result (ptr Event) SyncError))
  (match (alloc/alloc [Event] a 1)
    (None [] (Err (InitFailed 12)))
    (Some [memory] (event-init-with-allocator (slice-data memory) a))))

(defn event-generation [(event (ptr Event))] (-> (Result i64 SyncError))
  (match (mutex-lock! (field event mutex))
    (Err [e] (Err e))
    (Ok [_]
        (let [generation (.generation event)]
          (match (mutex-unlock! (field event mutex))
            (Err [e] (Err e))
            (Ok [_] (Ok generation)))))))

(defn event-notify-all! [(event (ptr Event))] (-> (Result i64 SyncError))
  (match (mutex-lock! (field event mutex))
    (Err [e] (Err e))
    (Ok [_]
        (do
          (set! (.generation event) (+ (.generation event) 1))
          (let [notified (condition-notify-all! (field event condition))]
            (match (mutex-unlock! (field event mutex))
              (Err [e] (Err e))
              (Ok [_] notified)))))))

(defn event-wait! [(event (ptr Event)) (observed i64)] (-> (Result WaitResult SyncError))
  (match (mutex-lock! (field event mutex))
    (Err [e] (Err e))
    (Ok [_]
        (block :done
               (loop (if (!= (load (field event generation)) observed)
                         (let [generation (load (field event generation))]
                           (mutex-unlock! (field event mutex))
                           (return-from :done (Ok (Notified generation))))
                         (match (condition-wait! (field event condition) (field event mutex))
                           (Err [e]
                                (do (mutex-unlock! (field event mutex)) (return-from :done (Err e))))
                           (Ok [_] 0))))))))

(defn event-wait-for! [(event (ptr Event)) (observed i64) (duration time/Duration)] (-> (Result WaitResult SyncError))
  (match (mutex-lock! (field event mutex))
    (Err [e] (Err e))
    (Ok [_]
        (if (!= (.generation event) observed)
            (let [generation (.generation event)]
              (mutex-unlock! (field event mutex))
              (Ok (Notified generation)))
            (match (condition-wait-for! (field event condition) (field event mutex) duration)
              (Err [e] (do (mutex-unlock! (field event mutex)) (Err e)))
              (Ok [result]
                  (let [generation (.generation event)]
                    (mutex-unlock! (field event mutex))
                    (if (!= generation observed) (Ok (Notified generation)) (Ok result)))))))))

(defn event-destroy! [(event (ptr Event))] (-> (Result i64 SyncError))
  (if (not (.initialized event))
      (Ok 0)
      (match (condition-destroy! (field event condition))
        (Err [e] (Err e))
        (Ok [_]
            (match (mutex-destroy! (field event mutex))
              (Err [e] (Err e))
              (Ok [_] (do (set! (.initialized event) false) (Ok 0))))))))
