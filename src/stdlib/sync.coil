(module coil.sync)
(import "coil.primitive" :as primitive)
(import "coil.io" :as io)
(import "coil.fmt" :use [fmt Display display-fmt Formatter formatter-writer])
(import "coil.alloc" :as alloc)
(import "coil.time" :as time)

; Opaque pthread storage for the two hosted ABIs Coil supports. Keep the choice
; compile-time so importing synchronization never launches a C compiler.
(defn os-pick [(linux Code) (darwin Code)] (-> Code)
  (if (primitive/code-eq (primitive/target-os) `linux) linux darwin))

; hygiene: platform-layout declarations intentionally use stable public names
(defn public-name [(name Code)] (-> Code)
  (primitive/syntax->datum name))

(defn pthread-layout [] (-> Code)
  `(do
     (const ~(public-name `PTHREAD_MUTEX_SIZE) ~(os-pick `40 `64))
     (const ~(public-name `PTHREAD_MUTEX_ALIGN) 8)
     (const ~(public-name `PTHREAD_COND_SIZE) 48)
     (const ~(public-name `PTHREAD_COND_ALIGN) 8)))

(meta (pthread-layout))

(extern pthread_mutex_init :cc c [(ptr i8) (ptr i8)] (-> i32))

(extern pthread_mutex_lock :cc c [(ptr i8)] (-> i32))

(extern pthread_mutex_trylock :cc c [(ptr i8)] (-> i32))

(extern pthread_mutex_unlock :cc c [(ptr i8)] (-> i32))

(extern pthread_mutex_destroy :cc c [(ptr i8)] (-> i32))

(extern pthread_cond_init :cc c [(ptr i8) (ptr i8)] (-> i32))

(extern pthread_cond_wait :cc c [(ptr i8) (ptr i8)] (-> i32))

(extern pthread_cond_timedwait
        :cc
        c
        [(ptr i8) (ptr i8) (ptr time/Timespec)]
        (-> i32))

(extern pthread_cond_signal :cc c [(ptr i8)] (-> i32))

(extern pthread_cond_broadcast :cc c [(ptr i8)] (-> i32))

(extern pthread_cond_destroy :cc c [(ptr i8)] (-> i32))

(export Mutex
        Condition
        Once
        Event
        SyncError
        InitFailed
        LockFailed
        UnlockFailed
        WaitFailed
        NotifyFailed
        DestroyFailed
        Timeout
        WaitResult
        Notified)

(defsum SyncError
  (InitFailed [(code i64)])
  (LockFailed [(code i64)])
  (UnlockFailed [(code i64)])
  (WaitFailed [(code i64)])
  (NotifyFailed [(code i64)])
  (DestroyFailed [(code i64)]))

(derive Eq SyncError)

;;; `{}` is a message for a person; an errno reads as the operating system describes it.
(impl Display SyncError
  (display-fmt [(e SyncError) (f (ptr Formatter))] (-> i64)
    (let [w (formatter-writer f)]
      (match e
        (InitFailed [code] (do (io/print-str w "initializing failed: ") (io/write-os-error w code)))
        (LockFailed [code] (do (io/print-str w "locking failed: ") (io/write-os-error w code)))
        (UnlockFailed [code] (do (io/print-str w "unlocking failed: ") (io/write-os-error w code)))
        (WaitFailed [code] (do (io/print-str w "waiting failed: ") (io/write-os-error w code)))
        (NotifyFailed [code] (do (io/print-str w "notifying failed: ") (io/write-os-error w code)))
        (DestroyFailed [code] (do (io/print-str w "destroying failed: ") (io/write-os-error w code)))))
    0))

(defsum WaitResult (Notified [(generation i64)]) (Timeout))

(defstruct Mutex
  [(raw (ptr i8)) (allocator (dyn alloc/Allocator)) (initialized bool)])

(defstruct Condition
  [(raw (ptr i8)) (allocator (dyn alloc/Allocator)) (initialized bool)])

; Once is implemented over the same portable mutex primitive.  This avoids depending
; on PTHREAD_ONCE_INIT's platform-specific byte pattern while preserving retry-on-error.
(defstruct Once [(mutex Mutex) (completed bool) (initialized bool)])

(defstruct Event
  [(mutex Mutex) (condition Condition) (generation i64) (initialized bool)])

(defn null-bytes [] (-> (ptr i8))
  (primitive/cast (ptr i8) 0))

(impl Mutex
  ;;; Initialize the mutex at `mutex`, its pthread storage taken from `a`.
  (init-with-allocator [(mutex (ptr Mutex)) (a (dyn alloc/Allocator))] (-> (Result (ptr Mutex)
                                                                                   SyncError))
    (match (alloc/alloc-bytes a PTHREAD_MUTEX_SIZE PTHREAD_MUTEX_ALIGN)
      (None [] (Err (InitFailed 12)))
      (Some [memory]
            (let [raw (primitive/cast (ptr i8) (data memory))
                  rc (pthread_mutex_init raw (null-bytes))]
              (if (= rc 0)
                  (do
                    (set! (.raw mutex) raw)
                    (set! (.allocator mutex) a)
                    (set! (.initialized mutex) true)
                    (Ok mutex))
                  (do
                    (alloc/free-bytes a memory PTHREAD_MUTEX_ALIGN)
                    (Err (InitFailed (primitive/cast i64 rc)))))))))

  ;;; Initialize the mutex at `mutex`, its pthread storage taken from the heap.
  (init [(mutex (ptr Mutex))] (-> (Result (ptr Mutex) SyncError))
    (Mutex::init-with-allocator mutex (alloc/malloc-allocator)))

  (lock! [(mutex (ptr Mutex))] (-> (Result i64 SyncError))
    (let [rc (pthread_mutex_lock (load (field mutex raw)))]
      (if (= rc 0) (Ok 0) (Err (LockFailed (primitive/cast i64 rc))))))

  ;;; Take the lock if it is free: `(Ok false)` when another thread holds it.
  (try-lock! [(mutex (ptr Mutex))] (-> (Result bool SyncError))
    (let [rc (pthread_mutex_trylock (load (field mutex raw)))]
      (cond (= rc 0) (Ok true)
            ; EBUSY is 16 on the supported POSIX targets.
            (= rc 16) (Ok false)
            :else (Err (LockFailed (primitive/cast i64 rc))))))

  (unlock! [(mutex (ptr Mutex))] (-> (Result i64 SyncError))
    (let [rc (pthread_mutex_unlock (load (field mutex raw)))]
      (if (= rc 0) (Ok 0) (Err (UnlockFailed (primitive/cast i64 rc))))))

  ;;; Destroy the mutex and free its pthread storage. Destroying one that is not
  ;;; initialized does nothing.
  (destroy! [(mutex (ptr Mutex))] (-> (Result i64 SyncError))
    (if (not (.initialized mutex))
        (Ok 0)
        (let [rc (pthread_mutex_destroy (load (field mutex raw)))]
          (if (= rc 0)
              (do
                (alloc/free-bytes (.allocator mutex)
                                  (slice::new (primitive/cast (ptr u8)
                                                              (load (field mutex
                                                                           raw)))
                                              PTHREAD_MUTEX_SIZE)
                                  PTHREAD_MUTEX_ALIGN)
                (set! (.initialized mutex) false)
                (set! (.raw mutex) (null-bytes))
                (Ok 0))
              (Err (DestroyFailed (primitive/cast i64 rc))))))))

(defn wall-deadline-timespec [(duration time/Duration)
                              (out (ptr time/Timespec))] (-> (Result i64
                                                                     SyncError))
  (match (time/wall-now)
    (Err [e] (Err (WaitFailed (code e))))
    (Ok [now]
        (let [(mut nowp) now]
          (let [sum (+ (.nsec nowp) (.nsec duration))
                carry (/ sum 1000000000)]
            (set! (.sec out) (+ (+ (.sec nowp) (.sec duration)) carry))
            (set! (.nsec out) (% sum 1000000000))
            (Ok 0))))))

(impl Condition
  ;;; Initialize the condition variable at `condition`, its pthread storage taken
  ;;; from `a`.
  (init-with-allocator [(condition (ptr Condition)) (a (dyn alloc/Allocator))] (-> (Result (ptr Condition)
                                                                                           SyncError))
    (match (alloc/alloc-bytes a PTHREAD_COND_SIZE PTHREAD_COND_ALIGN)
      (None [] (Err (InitFailed 12)))
      (Some [memory]
            (let [raw (primitive/cast (ptr i8) (data memory))
                  rc (pthread_cond_init raw (null-bytes))]
              (if (= rc 0)
                  (do
                    (set! (.raw condition) raw)
                    (set! (.allocator condition) a)
                    (set! (.initialized condition) true)
                    (Ok condition))
                  (do
                    (alloc/free-bytes a memory PTHREAD_COND_ALIGN)
                    (Err (InitFailed (primitive/cast i64 rc)))))))))

  ;;; Initialize the condition variable at `condition`, its pthread storage taken
  ;;; from the heap.
  (init [(condition (ptr Condition))] (-> (Result (ptr Condition) SyncError))
    (Condition::init-with-allocator condition (alloc/malloc-allocator)))

  ;;; Release `mutex`, which the caller holds, and wait for a notification.
  (wait! [(condition (ptr Condition)) (mutex (ptr Mutex))] (-> (Result i64 SyncError))
    (let [rc
            (pthread_cond_wait (load (field condition raw))
                               (load (field mutex raw)))]
      (if (= rc 0) (Ok 0) (Err (WaitFailed (primitive/cast i64 rc))))))

  ;;; `wait!` for at most `duration`.
  (wait-for! [(condition (ptr Condition))
              (mutex (ptr Mutex))
              (duration time/Duration)] (-> (Result WaitResult SyncError))
    (let [deadline (primitive/alloc-stack time/Timespec)]
      (match (wall-deadline-timespec duration deadline)
        (Err [e] (Err e))
        (Ok [_]
            (let [rc
                    (pthread_cond_timedwait (load (field condition raw))
                                            (load (field mutex raw))
                                            deadline)]
              (cond (= rc 0) (Ok (Notified 0))
                    ; Darwin and Linux ETIMEDOUT values.
                    (or (= rc 60) (= rc 110)) (Ok (Timeout))
                    :else (Err (WaitFailed (primitive/cast i64 rc)))))))))

  (notify-one! [(condition (ptr Condition))] (-> (Result i64 SyncError))
    (let [rc (pthread_cond_signal (load (field condition raw)))]
      (if (= rc 0) (Ok 0) (Err (NotifyFailed (primitive/cast i64 rc))))))

  (notify-all! [(condition (ptr Condition))] (-> (Result i64 SyncError))
    (let [rc (pthread_cond_broadcast (load (field condition raw)))]
      (if (= rc 0) (Ok 0) (Err (NotifyFailed (primitive/cast i64 rc))))))

  ;;; Destroy the condition variable and free its pthread storage. Destroying one
  ;;; that is not initialized does nothing.
  (destroy! [(condition (ptr Condition))] (-> (Result i64 SyncError))
    (if (not (.initialized condition))
        (Ok 0)
        (let [rc (pthread_cond_destroy (load (field condition raw)))]
          (if (= rc 0)
              (do
                (alloc/free-bytes (.allocator condition)
                                  (slice::new (primitive/cast (ptr u8)
                                                              (load (field condition
                                                                           raw)))
                                              PTHREAD_COND_SIZE)
                                  PTHREAD_COND_ALIGN)
                (set! (.initialized condition) false)
                (set! (.raw condition) (null-bytes))
                (Ok 0))
              (Err (DestroyFailed (primitive/cast i64 rc))))))))

(impl Once
  ;;; Initialize the once-cell at `once`, its mutex's storage taken from `a`.
  (init-with-allocator [(once (ptr Once)) (a (dyn alloc/Allocator))] (-> (Result (ptr Once)
                                                                                 SyncError))
    (match (Mutex::init-with-allocator (field once mutex) a)
      (Err [e] (Err e))
      (Ok [_]
          (do
            (set! (.completed once) false)
            (set! (.initialized once) true)
            (Ok once)))))

  ;;; Initialize the once-cell at `once`, its mutex's storage taken from the heap.
  (init [(once (ptr Once))] (-> (Result (ptr Once) SyncError))
    (Once::init-with-allocator once (alloc/malloc-allocator)))

  ;;; Run `body` unless a call has already completed: one that returned 0. A body
  ;;; that fails is `(Err (InitFailed rc))`, and the next call runs it again.
  (call! [(once (ptr Once)) (body (fnptr c [] i64))] (-> (Result i64 SyncError))
    (match (lock! (field once mutex))
      (Err [e] (Err e))
      (Ok [_]
          (let [rc
                  (if (.completed once)
                      0
                      (primitive/call-ptr body))]
            (when (= rc 0) (store! (field once completed) true))
            (match (unlock! (field once mutex))
              (Err [e] (Err e))
              (Ok [_]
                  (if (= rc 0) (Ok 0) (Err (InitFailed rc)))))))))

  (destroy! [(once (ptr Once))] (-> (Result i64 SyncError))
    (if (not (.initialized once))
        (Ok 0)
        (match (destroy! (field once mutex))
          (Err [e] (Err e))
          (Ok [_]
              (do (set! (.initialized once) false) (Ok 0)))))))

(impl Event
  ;;; Initialize the event at `event`, its pthread storage taken from `a`.
  (init-with-allocator [(event (ptr Event)) (a (dyn alloc/Allocator))] (-> (Result (ptr Event)
                                                                                   SyncError))
    (match (Mutex::init-with-allocator (field event mutex) a)
      (Err [e] (Err e))
      (Ok [_]
          (match (Condition::init-with-allocator (field event condition) a)
            (Err [e] (do (destroy! (field event mutex)) (Err e)))
            (Ok [_]
                (do
                  (set! (.generation event) 0)
                  (set! (.initialized event) true)
                  (Ok event)))))))

  ;;; Initialize the event at `event`, its pthread storage taken from the heap.
  (init [(event (ptr Event))] (-> (Result (ptr Event) SyncError))
    (Event::init-with-allocator event (alloc/malloc-allocator)))

  ;;; A new event allocated from `a`, with its pthread storage.
  (new [(a (dyn alloc/Allocator))] (-> (Result (ptr Event) SyncError))
    (match (alloc/alloc [Event] a 1)
      (None [] (Err (InitFailed 12)))
      (Some [memory] (Event::init-with-allocator (data memory) a))))

  ;;; How many times the event has been notified. Pass it to `wait!` or `wait-for!`
  ;;; to wait for the next notification.
  (generation [(event (ptr Event))] (-> (Result i64 SyncError))
    (match (lock! (field event mutex))
      (Err [e] (Err e))
      (Ok [_]
          (let [observed (.generation event)]
            (match (unlock! (field event mutex))
              (Err [e] (Err e))
              (Ok [_] (Ok observed)))))))

  (notify-all! [(event (ptr Event))] (-> (Result i64 SyncError))
    (match (lock! (field event mutex))
      (Err [e] (Err e))
      (Ok [_]
          (do
            (set! (.generation event) (+ (.generation event) 1))
            (let [notified (notify-all! (field event condition))]
              (match (unlock! (field event mutex))
                (Err [e] (Err e))
                (Ok [_] notified)))))))

  ;;; Wait until the event's generation is no longer `observed`.
  (wait! [(event (ptr Event)) (observed i64)] (-> (Result WaitResult SyncError))
    (match (lock! (field event mutex))
      (Err [e] (Err e))
      (Ok [_]
          (block :done
                   (loop (if (!= (load (field event generation)) observed)
                             (let [current (load (field event generation))]
                               (unlock! (field event mutex))
                               (return-from :done (Ok (Notified current))))
                             (match (wait! (field event condition)
                                           (field event mutex))
                               (Err [e]
                                    (do
                                      (unlock! (field event mutex))
                                      (return-from :done (Err e))))
                               (Ok [_] 0))))))))

  ;;; `wait!` for at most `duration`.
  (wait-for! [(event (ptr Event))
              (observed i64)
              (duration time/Duration)] (-> (Result WaitResult SyncError))
    (match (lock! (field event mutex))
      (Err [e] (Err e))
      (Ok [_]
          (if (!= (.generation event) observed)
              (let [current (.generation event)]
                (unlock! (field event mutex))
                (Ok (Notified current)))
              (match (wait-for! (field event condition)
                                (field event mutex)
                                duration)
                (Err [e] (do (unlock! (field event mutex)) (Err e)))
                (Ok [result]
                    (let [current (.generation event)]
                      (unlock! (field event mutex))
                      (if (!= current observed)
                          (Ok (Notified current))
                          (Ok result)))))))))

  (destroy! [(event (ptr Event))] (-> (Result i64 SyncError))
    (if (not (.initialized event))
        (Ok 0)
        (match (destroy! (field event condition))
          (Err [e] (Err e))
          (Ok [_]
              (match (destroy! (field event mutex))
                (Err [e] (Err e))
                (Ok [_] (do (set! (.initialized event) false) (Ok 0)))))))))
