(module coil.brainfuck.reader)

(import "coil.primitive" :as primitive)
(import "coil.slice" :use [slice-len slice-get])

;; Compile one Brainfuck command to Coil syntax. `cells` and `dp` are bindings in
;; the generated main function, not values captured by this metaprogram.
(defn bf-command [(op i64)] (-> Code)
  (cond (= op #\>)
          `(if (= (load dp) 29999)
             (return-from :program 2)
             (store! dp (+ (load dp) 1)))
        (= op #\<)
          `(if (= (load dp) 0)
             (return-from :program 3)
             (store! dp (- (load dp) 1)))
        (= op #\+)
          `(let [cell (primitive/index cells (load dp))]
             (store! cell (primitive/cast u8 (+ (primitive/cast i64 (load cell)) 1))))
        (= op #\-)
          `(let [cell (primitive/index cells (load dp))]
             (store! cell (primitive/cast u8 (- (primitive/cast i64 (load cell)) 1))))
        (= op #\.)
          `(putchar (primitive/cast i32 (load (primitive/index cells (load dp)))))
        (= op #\,)
          `(let [c (getchar)]
             (store! (primitive/index cells (load dp))
                     (if (< c 0) (primitive/cast u8 0) (primitive/cast u8 c))))
        :else `0))

;; Parse commands until EOF or the closing bracket for a nested sequence.
;; The result is Code shaped as (FORMS NEXT-INDEX). Building FORMS here means
;; every Brainfuck opcode disappears before Coil's ordinary checker sees it.
(defn bf-compile-seq [(source (slice u8)) (i i64) (nested bool) (forms Code)] (-> Code)
  (if (>= i (slice-len source))
      (if nested
          (primitive/error "brainfuck reader: unmatched '['")
          `(~forms ~i))
      (let [op (primitive/cast i64 (slice-get source i))]
        (cond (= op #\])
                (if nested `(~forms ~(+ i 1))
                  (primitive/error "brainfuck reader: unmatched ']'"))
              (= op #\[)
                (let [body-result (bf-compile-seq source (+ i 1) true `())
                      body (primitive/code-nth body-result 0)
                      next (primitive/code-int (primitive/code-nth body-result 1))
                      loop-form
                        `(loop
                           (when (= (load (primitive/index cells (load dp)))
                                    (primitive/cast u8 0))
                             (break)
                             0)
                           ~@body)]
                  (bf-compile-seq source next nested `(~@forms ~loop-form)))
              (or (= op #\>) (= op #\<) (= op #\+) (= op #\-)
                  (= op #\.) (= op #\,))
                (bf-compile-seq source (+ i 1) nested `(~@forms ~(bf-command op)))
              :else (bf-compile-seq source (+ i 1) nested forms)))))

;; Turn an arbitrary raw `.bf` file directly into a Coil program. The generated
;; program has native operations and native loops; it contains no BF bytecode,
;; program counter, opcode dispatch, or evaluator.
(defn read-brainfuck [(context Code)] (-> Code)
  (let [source (primitive/code-str (primitive/code-nth context 2))
        result (bf-compile-seq source 0 false `())
        forms (primitive/code-nth result 0)]
    `(do
       (module brainfuck-program)
       (import "coil.primitive" :as primitive)
       (import "coil.alloc" :as alloc)
       (import "coil.mem" :use [mem-zero])
       (import "coil.control" :use [scope return-from])
       (extern putchar :cc c [i32] (-> i32))
       (extern getchar :cc c [] (-> i32))
       (defn main [] (-> i64)
         (let [tape (alloc/stack (array u8 30000))
               cells (primitive/cast (ptr u8) tape)
               _zero (mem-zero [u8] cells 30000)
               (mut dp) 0]
           (scope :program
             ~@forms
             0))))))
