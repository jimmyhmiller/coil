(module coil.brainfuck.reader)

; A whole program crosses this reader in ONE invocation, so its working set
; scales with the input (~3 KiB per source byte); the default 64 MiB expansion
; budget covers ~20k operations. Declaring the raise HERE is the point of the
; budget design: a memory-hungry metaprogram is a reviewable line of source,
; never a runtime surprise (docs/design/META_MEMORY.md phase 6).
(meta-budget read-brainfuck 1024)

(import "coil.primitive" :as primitive)
(import "coil.slice" :use [slice-len slice-get])
(import "coil.alloc" :use [malloc-allocator])
(import "coil.str" :as str)

;; Compile one Brainfuck command to direct Coil tape operations. `cells` and
;; `dp` are bindings in the generated main function.
(defn bf-command [(op i64)] (-> Code)
  (cond (= op #\>)
          `(if (= (load dp) 29999)
             (return-from :program 2)
             (store! dp (+ (load dp) 1)))
        (= op #\<)
          `(if (= (load dp) 0)
             (return-from :program 3)
             (store! dp (- (load dp) 1)))
        (= op #\+)
          `(let [cell (primitive/index cells (load dp))]
             (store! cell (primitive/cast u8 (+ (primitive/cast i64 (load cell)) 1))))
        (= op #\-)
          `(let [cell (primitive/index cells (load dp))]
             (store! cell (primitive/cast u8 (- (primitive/cast i64 (load cell)) 1))))
        (= op #\.)
          `(putchar (primitive/cast i32 (load (primitive/index cells (load dp)))))
        (= op #\,)
          `(let [c (getchar)]
             (store! (primitive/index cells (load dp))
                     (if (< c 0) (primitive/cast u8 0) (primitive/cast u8 c))))
        :else `0))

(defn bf-error-message [(context Code) (at i64) (problem (slice u8))] (-> (slice u8))
  (let [(mut message) (str/sb-new (malloc-allocator))]
    (str/sb-push-str! (mut message) "brainfuck reader: ")
    (str/sb-push-str! (mut message) problem)
    (str/sb-push-str! (mut message) " in ")
    (str/sb-push-str! (mut message)
                      (primitive/code-str (primitive/code-nth context 1)))
    (str/sb-push-str! (mut message) " at byte ")
    (str/sb-push-i64! (mut message) at)
    (str/sb-finish! (mut message))))

;; Parse one balanced sequence. A growable Code list makes flat input linear:
;; each command is pushed once instead of repeatedly suffix-splicing an array.
;; Recursion is only for native loop nesting and is capped for a useful failure.
(defn bf-compile-seq [(context Code) (source (slice u8)) (start i64)
                      (nested bool) (depth i64)] (-> Code)
  (if (> depth 1024)
      (primitive/error
        (bf-error-message context start "loop nesting exceeds 1024"))
      (let [forms (primitive/code-list-new)
            (mut i) start
            (mut done) false]
        (loop
          (if (or (load done) (>= (load i) (slice-len source)))
              (break)
              (let [op (primitive/cast i64 (slice-get source (load i)))]
                (cond (= op #\])
                        (if nested
                            (do (store! i (+ (load i) 1)) (store! done true) 0)
                            (primitive/error
                              (bf-error-message context (load i) "unmatched ']'")))
                      (= op #\[)
                        (let [body-result (bf-compile-seq context source (+ (load i) 1)
                                                          true (+ depth 1))
                              body (primitive/code-nth body-result 0)
                              next (primitive/code-int (primitive/code-nth body-result 1))]
                          (primitive/code-list-push!
                            forms
                            `(loop
                               (when (= (load (primitive/index cells (load dp)))
                                        (primitive/cast u8 0))
                                 (break)
                                 0)
                               ~@body))
                          (store! i next))
                      (or (= op #\>) (= op #\<) (= op #\+) (= op #\-)
                          (= op #\.) (= op #\,))
                        (do (primitive/code-list-push! forms (bf-command op))
                            (store! i (+ (load i) 1))
                            0)
                      :else (do (store! i (+ (load i) 1)) 0)))))
        (if (and nested (not (load done)))
            (primitive/error
              (bf-error-message context start "unmatched '['"))
            `(~forms ~(load i))))))

;; Read raw Brainfuck at compile time and emit a complete ordinary Coil module.
;; The result has direct operations and native loops: no opcode stream, program
;; counter, dispatch loop, evaluator, or runtime Brainfuck dependency.
(defn read-brainfuck [(context Code)] (-> Code)
  (let [source (primitive/code-str (primitive/code-nth context 2))
        result (bf-compile-seq context source 0 false 0)
        forms (primitive/code-nth result 0)]
    `(do
       (module brainfuck-program)
       (import "coil.primitive" :as primitive)
       (import "coil.alloc" :as alloc)
       (import "coil.mem" :use [mem-zero])
       (import "coil.control" :use [scope return-from])
       (extern putchar :cc c [i32] (-> i32))
       (extern getchar :cc c [] (-> i32))
       (defn main [] (-> i64)
         (let [tape (alloc/stack (array u8 30000))
               cells (primitive/cast (ptr u8) tape)
               _zero (mem-zero [u8] cells 30000)
               (mut dp) 0]
           (scope :program
             ~@forms
             0))))))
