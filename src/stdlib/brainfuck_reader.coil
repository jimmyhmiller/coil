(module coil.brainfuck.reader)

(import "coil.primitive" :as primitive)

;; Turn an arbitrary raw `.bf` file into a normal Coil module. This does not ask
;; the s-expression reader to parse the target at all: it returns the complete
;; syntax tree that the loader, checker, and native backend consume next.
(defn read-brainfuck [(context Code)] (-> Code)
  (let [source (primitive/code-nth context 2)]
    `(do
       (module brainfuck-program)
       (import "coil.brainfuck.runtime" :as brainfuck)
       (defn main [] (-> i64) (brainfuck/run ~source)))))
