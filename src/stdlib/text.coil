;;; Small text helpers that treat running out of memory as fatal, for tools and the
;;; compiler alike.
(module coil.text)
(import "coil.primitive" :as primitive)
(import "coil.alloc" :use *)
(import "coil.arraylist" :use *)
(import "coil.slice" :use *)
(import "coil.str" :use *)

(defn box-al [T] [(a (dyn Allocator)) (l (ArrayList T))]
  (-> (ptr (ArrayList T)))
  (box! a (ArrayList T) l))

(defn sconcat [(a (dyn Allocator)) (x (slice u8)) (y (slice u8))]
  (-> (slice u8))
  (match (concat a x y)
    (Some [v] v)
    (None [] (oom-at c"compiler text" (+ (len x) (len y))))))

(defn sconcat3 [(a (dyn Allocator))
                (x (slice u8))
                (y (slice u8))
                (z (slice u8))] (-> (slice u8))
  (match (concat3 a x y z)
    (Some [v] v)
    (None [] (oom-at c"compiler text" (+ (len x) (+ (len y) (len z)))))))

;;; The decimal digits of N, read as unsigned, onto BUF. Negating the smallest i64
;;; leaves it negative, and read unsigned it is the right magnitude.
(defn push-mag [(buf (mut (ArrayList u8))) (n i64)] (-> i64)
  (if (and (>= n 0) (< n 10))
      (push! (mut buf) (primitive/cast u8 (primitive/iadd n 48)))
      (do
        (push-mag (mut buf) (primitive/udiv n 10))
        (push! (mut buf)
               (primitive/cast u8 (primitive/iadd (primitive/urem n 10) 48))))))

;;; N in decimal, in one allocation of its exact length.
(defn i64->str [(a (dyn Allocator)) (n i64)] (-> (slice u8))
  (let [digits (primitive/cast (ptr u8) (primitive/alloc-stack (array u8 20)))
        neg (< n 0)
        ; the smallest i64 stays negative; udiv and urem read it as 2^63
        (mut m) (if neg (primitive/isub 0 n) n)
        (mut at) 20]
    (loop (do
            (set! at (primitive/isub (load at) 1))
            (set! (primitive/index digits (load at))
                  (primitive/cast u8
                                  (primitive/iadd (primitive/urem (load m) 10)
                                                  48)))
            (set! m (primitive/udiv (load m) 10))
            (when (= (load m) 0) (break))
            0))
    (let [sign (if neg 1 0)
          total (primitive/iadd sign (primitive/isub 20 (load at)))
          out
            (primitive/cast (ptr u8)
                            (primitive/cast (ptr i8)
                                            (data (match (alloc-bytes a total 1)
                                                    (Some [s] s)
                                                    (None []
                                                          (do
                                                            (oom-at c"compiler allocation"
                                                                    total)
                                                            (slice::new (primitive/cast (ptr u8)
                                                                                        0)
                                                                        0)))))))]
      (when neg (set! (primitive/index out 0) (: 45 u8)) 0)
      (for [i 0 (primitive/isub 20 (load at))]
        (set! (primitive/index out (primitive/iadd sign i))
              (load (primitive/index digits (primitive/iadd (load at) i)))))
      (slice::new [u8] out total))))

(defn append-bytes! [(buf (mut (ArrayList u8))) (s (slice u8))] (-> i64)
  (let [n (len s)
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (push! (mut buf) (get s (load i)))
                (set! i (primitive/iadd (load i) 1))))))
  0)

(defn sconcat5 [(a (dyn Allocator))
                (v (slice u8))
                (w (slice u8))
                (x (slice u8))
                (y (slice u8))
                (z (slice u8))] (-> (slice u8))
  (sconcat3 a (sconcat3 a v w x) y z))
