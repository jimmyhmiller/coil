; Format-agnostic serialization — the data model serde-style: data structures
; implement Serialize/Deserialize ONCE; formats implement Serializer/Deserializer
; ONCE; the two meet through (dyn …) trait objects, so N types × M formats costs
; N + M impls. Derive the type-side impls with coil.serde.derive; format backends
; live in coil.serde.json / coil.serde.sexp / coil.serde.msgpack.
;
;   (import "coil.serde" :use *)
;   (impl Serialize MyType (ser [(x MyType) (s (dyn Serializer))] … ))
;
; Decoded values may BORROW the input buffer and the deserializer's allocator
; (`de-alloc`) — the recommended pattern is an arena per decode.
(module coil.serde)
(import "coil.primitive" :as primitive)
(import "coil.alloc" :as alloc)
(import "coil.alloc" :use *)
(import "coil.slice" :use *)
(import "coil.str" :use *)
(import "coil.arraylist" :use *)
(import "coil.hashmap" :use *)
(import "coil.io" :use *)
(import "coil.control" :use *)
(import "coil.result" :use *)
(import "coil.try" :use *)

; The format backends need these two libc functions; they are declared HERE,
; once, because extern declarations are not deduped across modules. A program
; using coil.serde must not redeclare snprintf/strtod (import them from here).
(extern snprintf :cc c [(ptr i8) i64 (ptr i8) ...] (-> i32))
(extern strtod :cc c [(ptr i8) (ptr (ptr i8))] (-> f64))

; ---- errors -----------------------------------------------------------------
; SerError codes
(const SER-E-IO 1)  ; the underlying writer failed
(const SER-E-DEPTH 2)  ; nesting exceeded the backend's depth stack
(const SER-E-UNSUPPORTED 3)  ; the format cannot represent this event

; DeError codes
(const DE-E-EXPECTED-NULL 1)
(const DE-E-EXPECTED-BOOL 2)
(const DE-E-EXPECTED-INT 3)
(const DE-E-EXPECTED-FLOAT 4)
(const DE-E-EXPECTED-STR 5)
(const DE-E-EXPECTED-SEQ 6)
(const DE-E-EXPECTED-MAP 7)
(const DE-E-EXPECTED-OBJECT 8)
(const DE-E-EXPECTED-VARIANT 9)
(const DE-E-MISSING-FIELD 10)
(const DE-E-UNKNOWN-VARIANT 11)
(const DE-E-INT-RANGE 12)
(const DE-E-BAD-NUMBER 13)
(const DE-E-DEPTH 14)
(const DE-E-PARSE 15)  ; the input is not valid in this format
(const DE-E-TRAILING 16)  ; bytes after one complete document
(const DE-E-UNSUPPORTED 17)
(const DE-E-BAD-STRING 18)  ; invalid escape / string encoding
(const DE-E-UNKNOWN-FIELD 19)  ; input field not in the struct ((deny-unknown) only)

; de-kind's model-kind tags (what kind of value the input is positioned on)
(const SD-K-NULL 0)
(const SD-K-BOOL 1)
(const SD-K-INT 2)
(const SD-K-FLOAT 3)
(const SD-K-STR 4)
(const SD-K-BYTES 5)
(const SD-K-SEQ 6)
(const SD-K-MAP 7)
(const SD-K-OTHER 8)

(defstruct SerError [(code i64)])
;; `offset` is the input byte offset when the backend knows it (-1 otherwise);
;; `ctx` is a static context string (a field name, "expected number", …).
(defstruct DeError [(code i64) (offset i64) (ctx (slice u8))])

(defn ser-err [(code i64)] (-> SerError)
  (let [(mut e) (primitive/zeroed SerError)]
    (store! (field e code) code)
    (load e)))

(defn de-err [(code i64) (offset i64) (ctx (slice u8))] (-> DeError)
  (let [(mut e) (primitive/zeroed DeError)]
    (store! (field e code) code)
    (store! (field e offset) offset)
    (store! (field e ctx) ctx)
    (load e)))

; ---- the format side --------------------------------------------------------
;; A format's OUTPUT driver. Events mirror the data model: scalars, str/bytes,
;; seq, map, struct (named fields, known count), externally tagged variants.
;; `seq-elem` / `map-key` / `field-key` are called BEFORE each element (that is
;; where a text format writes its separator). Narrow integer widths travel as
;; i64 (`ser-u64` interprets the bits unsigned).
(deftrait Serializer [Self]
  (ser-null [(s (ptr Self))] (-> (Result i64 SerError)))
  (ser-bool [(s (ptr Self)) (v bool)] (-> (Result i64 SerError)))
  (ser-i64 [(s (ptr Self)) (v i64)] (-> (Result i64 SerError)))
  (ser-u64 [(s (ptr Self)) (v i64)] (-> (Result i64 SerError)))
  (ser-f64 [(s (ptr Self)) (v f64)] (-> (Result i64 SerError)))
  (ser-str [(s (ptr Self)) (v (slice u8))] (-> (Result i64 SerError)))
  (ser-bytes [(s (ptr Self)) (v (slice u8))] (-> (Result i64 SerError)))
  (seq-begin [(s (ptr Self)) (len i64)] (-> (Result i64 SerError)))
  (seq-elem [(s (ptr Self))] (-> (Result i64 SerError)))
  (seq-end [(s (ptr Self))] (-> (Result i64 SerError)))
  (map-begin [(s (ptr Self)) (len i64)] (-> (Result i64 SerError)))
  (map-key [(s (ptr Self)) (k (slice u8))] (-> (Result i64 SerError)))
  (map-end [(s (ptr Self))] (-> (Result i64 SerError)))
  (struct-begin [(s (ptr Self)) (name (slice u8)) (nfields i64)] (-> (Result i64 SerError)))
  (field-key [(s (ptr Self)) (name (slice u8))] (-> (Result i64 SerError)))
  (struct-end [(s (ptr Self))] (-> (Result i64 SerError)))
  (variant-unit [(s (ptr Self)) (sum (slice u8)) (tag (slice u8))] (-> (Result i64 SerError)))
  (variant-begin [(s (ptr Self)) (sum (slice u8)) (tag (slice u8)) (nfields i64)] (-> (Result i64 SerError)))
  (variant-end [(s (ptr Self))] (-> (Result i64 SerError))))

;; A format's INPUT driver — pull-based and type-directed: the caller asks for
;; what its type expects, the backend errors (located, when it can) on mismatch.
;; Every de-* consumes the value it decodes. Contracts:
;;   de-null?     — true (and CONSUMES the null) iff positioned on null.
;;   de-str       — the decoded bytes; may borrow the input or `de-alloc` memory.
;;   de-seq-begin — element count; then decode exactly that many elements.
;;   de-map-key/-value — entries MUST be visited in order n = 0,1,2,….
;;   de-struct-begin — enters the struct frame; returns the INPUT's field count
;;                  (so (deny-unknown) can enumerate keys via de-map-key).
;;   de-field     — seek to the named field's value; Ok(false) = absent.
;;   de-variant   — the tag; positions on the payload for a non-unit variant.
;;   de-kind      — NON-consuming peek: the SD-K-* tag of the current value
;;                  (SD-K-OTHER when unclassifiable). Drives coil.serde.value.
;;   de-alloc     — the decode allocator (what decoded values may borrow).
(deftrait Deserializer [Self]
  (de-kind [(d (ptr Self))] (-> i64))
  (de-null? [(d (ptr Self))] (-> bool))
  (de-bool [(d (ptr Self))] (-> (Result bool DeError)))
  (de-i64 [(d (ptr Self))] (-> (Result i64 DeError)))
  (de-u64 [(d (ptr Self))] (-> (Result i64 DeError)))
  (de-f64 [(d (ptr Self))] (-> (Result f64 DeError)))
  (de-str [(d (ptr Self))] (-> (Result (slice u8) DeError)))
  (de-bytes [(d (ptr Self))] (-> (Result (slice u8) DeError)))
  (de-seq-begin [(d (ptr Self))] (-> (Result i64 DeError)))
  (de-seq-end [(d (ptr Self))] (-> (Result i64 DeError)))
  (de-map-begin [(d (ptr Self))] (-> (Result i64 DeError)))
  (de-map-key [(d (ptr Self)) (n i64)] (-> (Result (slice u8) DeError)))
  (de-map-value [(d (ptr Self)) (n i64)] (-> (Result i64 DeError)))
  (de-map-end [(d (ptr Self))] (-> (Result i64 DeError)))
  (de-struct-begin [(d (ptr Self)) (name (slice u8))] (-> (Result i64 DeError)))
  (de-field [(d (ptr Self)) (name (slice u8))] (-> (Result bool DeError)))
  (de-struct-end [(d (ptr Self))] (-> (Result i64 DeError)))
  (de-variant [(d (ptr Self))] (-> (Result (slice u8) DeError)))
  (de-variant-end [(d (ptr Self))] (-> (Result i64 DeError)))
  (de-alloc [(d (ptr Self))] (-> (ptr Allocator))))

; ---- the type side ----------------------------------------------------------
;; Implemented per type (usually by coil.serde.derive). `ser` walks the value,
;; driving the serializer; `de` fills a caller-owned slot from the deserializer.
(deftrait Serialize [Self]
  (ser [(x Self) (s (dyn Serializer))] (-> (Result i64 SerError))))
(deftrait Deserialize [Self]
  (de [(out (ptr Self)) (d (dyn Deserializer))] (-> (Result i64 DeError))))

; ---- impls: scalars ---------------------------------------------------------
(impl Serialize bool
  (ser [(x bool) (s (dyn Serializer))] (-> (Result i64 SerError)) (ser-bool s x)))
(impl Deserialize bool
  (de [(out (ptr bool)) (d (dyn Deserializer))]
      (-> (Result i64 DeError))
      (try (do (store! out (try! (de-bool d))) (Ok 0)))))

(impl Serialize i64
  (ser [(x i64) (s (dyn Serializer))] (-> (Result i64 SerError)) (ser-i64 s x)))
(impl Deserialize i64
  (de [(out (ptr i64)) (d (dyn Deserializer))]
      (-> (Result i64 DeError))
      (try (do (store! out (try! (de-i64 d))) (Ok 0)))))

(impl Serialize u64
  (ser [(x u64) (s (dyn Serializer))]
       (-> (Result i64 SerError))
       (ser-u64 s (primitive/cast i64 x))))
(impl Deserialize u64
  (de [(out (ptr u64)) (d (dyn Deserializer))]
      (-> (Result i64 DeError))
      (try (do (store! out (primitive/cast u64 (try! (de-u64 d)))) (Ok 0)))))

(impl Serialize f64
  (ser [(x f64) (s (dyn Serializer))] (-> (Result i64 SerError)) (ser-f64 s x)))
(impl Deserialize f64
  (de [(out (ptr f64)) (d (dyn Deserializer))]
      (-> (Result i64 DeError))
      (try (do (store! out (try! (de-f64 d))) (Ok 0)))))

;; Narrow widths travel as i64; decode RANGE-CHECKS and errors (DE-E-INT-RANGE)
;; rather than truncate. Emitted per width by this macro.
(defn serde--int-impls [(W Code) (lo Code) (hi Code)] (-> Code)
  `(do
     (impl Serialize ~W
       (ser [(x ~W) (s (dyn Serializer))]
            (-> (Result i64 SerError))
            (ser-i64 s (primitive/cast i64 x))))
     (impl Deserialize ~W
       (de [(out (ptr ~W)) (d (dyn Deserializer))]
           (-> (Result i64 DeError))
           (try (let [v (try! (de-i64 d))]
                  (if (and (>= v ~lo) (<= v ~hi))
                      (do (store! out (primitive/cast ~W v)) (Ok 0))
                      (Err (de-err DE-E-INT-RANGE -1 "integer out of range for field width")))))))))

(serde--int-impls i8 -128 127)
(serde--int-impls i16 -32768 32767)
(serde--int-impls i32 -2147483648 2147483647)
(serde--int-impls u8 0 255)
(serde--int-impls u16 0 65535)
(serde--int-impls u32 0 4294967295)

; ---- impls: strings ---------------------------------------------------------
(impl Serialize (slice u8)
  (ser [(x (slice u8)) (s (dyn Serializer))] (-> (Result i64 SerError)) (ser-str s x)))
(impl Deserialize (slice u8)
  (de [(out (ptr (slice u8))) (d (dyn Deserializer))]
      (-> (Result i64 DeError))
      (try (do (store! out (try! (de-str d))) (Ok 0)))))

;; Store None into an Option slot, inferring the payload type from the slot.
;; Derived code uses this for absent optional fields — field-type reflection
;; reports a generic field type as its bare head symbol, so the element type is
;; recovered from the place instead.
(defn opt-none! [T] [(slot (ptr (Option T)))] (-> i64)
  (store! slot (None [T])))

;; `(field f (boxed))` support: serialize through a (ptr T) field, and decode
;; one by allocating the pointee from the deserializer's allocator. The decoded
;; pointer's storage follows the decode-allocator contract like everything else.
(defn boxed-ser [(T Serialize)] [(p (ptr T)) (s (dyn Serializer))] (-> (Result i64 SerError))
  (ser (load p) s))
(defn boxed-de! [(T Deserialize)] [(slot (ptr (ptr T))) (d (dyn Deserializer))] (-> (Result i64 DeError))
  (try (let [p (unwrap-ptr [T] (create [T] (de-alloc d)))]
         (try! (de p d))
         (store! slot p)
         (Ok 0))))

;; `(deny-unknown)` support: enumerate the input's keys (0..n-1, the count from
;; de-struct-begin) and error on any key not in `known`.
(defn deny-unknown-check [(d (dyn Deserializer)) (n i64) (known (slice (slice u8)))] (-> (Result i64 DeError))
  (try (do
         (let [(mut i) 0]
           (while (< (load i) n)
             (let [k (try! (de-map-key d (load i)))
                   (mut hit) false]
               (let [kn (slice-len known)]
                 (for [j 0 kn]
                   (when (= k (slice-get known j))
                     (store! hit true)
                     0)))
               (unless (load hit)
                 (return-from :try (Err (de-err DE-E-UNKNOWN-FIELD -1 "unknown field"))))
               (store! i (+ (load i) 1)))))
         (Ok 0))))

; ---- impls: Option (null <-> None) ------------------------------------------
(impl [(T Serialize)] Serialize (Option T)
  (ser [(x (Option T)) (s (dyn Serializer))]
       (-> (Result i64 SerError))
       (match x
         (None [] (ser-null s))
         (Some [v] (ser v s)))))
(impl [(T Deserialize)] Deserialize (Option T)
  (de [(out (ptr (Option T))) (d (dyn Deserializer))]
      (-> (Result i64 DeError))
      (if (de-null? d)
          (do (store! out (None [T])) (Ok 0))
          (try (let [slot (alloc/stack T)]
                 (try! (de slot d))
                 (store! out (Some (load slot)))
                 (Ok 0))))))

; ---- impls: ArrayList <-> seq -----------------------------------------------
(impl [(T Serialize)] Serialize (ArrayList T)
  (ser [(x (ArrayList T)) (s (dyn Serializer))]
       (-> (Result i64 SerError))
       (try (let [n (al-len [T] x)]
              (try! (seq-begin s n))
              (for [i 0 n]
                (do
                  (try! (seq-elem s))
                  (try! (ser (al-get [T] x i) s))
                  0))
              (seq-end s)))))
(impl [(T Deserialize)] Deserialize (ArrayList T)
  (de [(out (ptr (ArrayList T))) (d (dyn Deserializer))]
      (-> (Result i64 DeError))
      (try (let [n (try! (de-seq-begin d))
                 (mut l) (al-new [T] (de-alloc d))
                 slot (alloc/stack T)]
             (for [i 0 n]
               (do
                 (try! (de slot d))
                 (al-push! (mut l) (load slot))
                 0))
             (try! (de-seq-end d))
             (store! out (load l))
             (Ok 0)))))

; ---- impls: HashMap with string keys <-> map --------------------------------
(impl [(V Serialize)] Serialize (HashMap (slice u8) V)
  (ser [(x (HashMap (slice u8) V)) (s (dyn Serializer))]
       (-> (Result i64 SerError))
       (try (do
              (try! (map-begin s (hm-len [(slice u8) V] x)))
              (let [cap (hm-cap [(slice u8) V] x)
                    slots (load (field x slots))]
                (for [i 0 cap]
                  (let [e (primitive/index slots i)]
                    (when (= (load (field e state)) (cast i64 1))
                      (try! (map-key s (load (field e key))))
                      (try! (ser (load (field e val)) s))
                      0)
                    0)))
              (map-end s)))))
;; Decoded keys BORROW deserializer memory (str-keyops-borrowed) — they live as
;; long as the decode allocator/input, per this module's borrow contract.
(impl [(V Deserialize)] Deserialize (HashMap (slice u8) V)
  (de [(out (ptr (HashMap (slice u8) V))) (d (dyn Deserializer))]
      (-> (Result i64 DeError))
      (try (let [n (try! (de-map-begin d))
                 (mut m) (hm-new [(slice u8) V] (de-alloc d) (str-keyops-borrowed))
                 slot (alloc/stack V)]
             (for [i 0 n]
               (do
                 (let [k (try! (de-map-key d i))]
                   (try! (de-map-value d i))
                   (try! (de slot d))
                   (hm-put! (mut m) k (load slot))
                   0)))
             (try! (de-map-end d))
             (store! out (load m))
             (Ok 0)))))

; ---- growable in-memory Writer sink (shared by the text backends) -----------
(defstruct GrowBuf [(buf (ArrayList u8))])
(defn grow-write [(ctx (ptr i8)) (buf (ptr i8)) (len i64)] (-> (Result i64 IoError))
  (let [g (primitive/cast (ptr GrowBuf) ctx)]
    (for [i 0 len]
      (al-push! (mut (field g buf)) (primitive/cast u8 (load (primitive/index buf i)))))
    (Ok len)))
;; initialize caller-owned Writer + GrowBuf cells (io's fd-writer ownership rule)
(defn grow-writer [(w (ptr Writer)) (g (ptr GrowBuf)) (a (ptr Allocator))] (-> (ptr Writer))
  (store! (field g buf) (al-new [u8] a))
  (store! (field w write-fn) (primitive/fnptr-of grow-write))
  (store! (field w ctx) (primitive/cast (ptr i8) g))
  w)
(defn grow-str [(g (ptr GrowBuf))] (-> (slice u8))
  (slice-new [u8] (load (field (field g buf) data)) (al-len [u8] (load (field g buf)))))
