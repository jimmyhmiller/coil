(module coil.prop.runner)
(import "coil.primitive" :as primitive)
(import "coil.alloc" :as alloc :use *)
(import "coil.arraylist" :use *)
(import "coil.slice" :use *)
(import "coil.io" :use *)
(import "coil.fmt" :use *)
(import "coil.str" :as str)
(import "coil.os" :as os)
(import "coil.args" :use *)
(import "coil.prop.rng" :use *)
(import "coil.prop.source" :use *)
(import "coil.prop.shrink" :use *)
(import "coil.prop.db" :use *)
(import "coil.prop.cov" :use *)
(import "coil.prop.fuzz" :use *)
(import "coil.time" :as time)
(import "coil.signals" :use [SignalSubscription signal-subscribe signal-read signal-close!])

; THE RUNNER — what `(defprop …)` expands into a call to.
;
; The loop is deliberately boring: generate a case, run the property, and if it
; fails, stop generating and start shrinking. Everything interesting is in the
; phases around it.
;
;   PHASE 1  replay — re-run the counterexample this property failed on last time,
;            first, before spending any budget on new cases. A bug you have
;            already found should fail in the first millisecond, not the last.
;   PHASE 2  generate — random cases, with the size budget ramping from tiny to
;            full over the run, so shallow bugs surface early and deep ones still
;            get their chance.
;   PHASE 3  shrink — greedy fixpoint over the tape (coil.prop.shrink).
;   PHASE 4  report — the minimal counterexample, the seed, and the exact command
;            to reproduce it.
;
; A property that fails ABORTS, because that is what `coil test`'s forked child
; runner counts as a failure. The report is written to stdout first, and io's
; Writer is unbuffered, so the message is on the terminal before the abort.
(defstruct PropConfig
  [(cases i64)
   (seed i64)
   (max-size i64)
   (shrink-budget i64)
   (max-rejects i64)
   (arena-bytes i64)
   (verbose i64)])

(defstruct PropStats
  [(cases i64)
   (rejected i64)
   (shrink-calls i64)
   (shrinks i64)])

(defstruct RunCtx
  [(src (ptr Source))
   (prop (fnptr c [(ptr Source) i64] bool))
   (size i64)
   (crash-code i64)  ; 128+signal when shrinking a crash, -1 otherwise
   (cand-timeout i64)  ; seconds allowed to one spawned shrink candidate
   (name (slice u8))  ; the property, to select it in a spawned worker
   (cand-path (slice u8))  ; where a candidate tape is handed over, "" if unused
   (cand-stage-path (slice u8))  ; where a candidate's worker stages what it drew
   (cand-stage (ptr i64))])  ; that stage, mapped (null if it could not be)

(defn prop-config [(name (slice u8))] (-> PropConfig)
  (let [c (primitive/alloc-stack PropConfig)]
    (store! (field c cases) (args-int "--cases" 200))
    (store! (field c seed)
            (args-int "--seed" (primitive/ior (str/str-hash name) 1)))
    ; a campaign runs millions of cases and can afford bigger ones than a test run;
    ; the size bounds collection lengths and recursion, so it bounds what the
    ; fuzzer can build at all.
    (store! (field c max-size)
            (args-int "--size" (if (args-has? "--fuzz") 256 60)))
    (store! (field c shrink-budget) (args-int "--shrink" 20000))
    ; Ten rejections per case is already a suite in trouble; past that, keep
    ; generating and the run is just burning time on inputs it throws away.
    (store! (field c max-rejects)
            (args-int "--max-rejects"
                      (primitive/imul (args-int "--cases" 200) 10)))
    (store! (field c arena-bytes) (args-int "--arena" 8388608))
    (store! (field c verbose) (args-level "--verbose" 0))
    (load c)))

; ------------------------------------------------------------------ statistics
;
; The most common way a property suite lies is by generating the same trivial
; input ten thousand times and reporting ten thousand passes. `classify` and
; `collect` make the distribution visible, and the runner refuses to stay quiet
; when one bucket swallows the run.
(const STAT-FLAG 0)  ; a boolean classification: how often did this hold?

(const STAT-VALUE 1)  ; a numeric observation: min / mean / max

(defstruct StatEntry
  [(name (slice u8))
   (kind i64)
   (hits i64)
   (total i64)
   (lo i64)
   (hi i64)])

(defn stat-table [] (-> (ptr (ArrayList StatEntry)))
  (let [cell (primitive/alloc-static (ArrayList StatEntry))
        init (primitive/alloc-static bool)]
    (if (load init)
        0
        (do
          (store! cell (al-new [StatEntry] (malloc-allocator)))
          (store! init true)
          0))
    cell))

;;; Statistics are gathered during GENERATION only. Counting shrink candidates
;;; would report the distribution of the search, not of the test suite — and the
;;; search deliberately concentrates on one failing input.
(defn stat-collecting [] (-> (ptr bool))
  (primitive/alloc-static bool))

(defn stat-reset! [] (-> i64)
  (store! (field (stat-table) len) 0)
  0)

(defn stat-find [(name (slice u8))] (-> i64)
  (let [t (stat-table)
        n (al-len [StatEntry] (load t))
        (mut i) 0
        (mut found) -1]
    (loop (if (or (>= (load i) n) (>= (load found) 0))
              (break)
              (do
                (if (str/str-eq (load (field (al-elem [StatEntry] t (load i))
                                             name))
                                name)
                    (store! found (load i))
                    0)
                (store! i (primitive/iadd (load i) 1)))))
    (load found)))

(defn stat-entry! [(name (slice u8)) (kind i64)] (-> i64)
  (let [existing (stat-find name)]
    (if (>= existing 0)
        existing
        (let [t (stat-table)
              e (primitive/alloc-stack StatEntry)]
          (store! (field e name) name)
          (store! (field e kind) kind)
          (store! (field e hits) 0)
          (store! (field e total) 0)
          (store! (field e lo) 9223372036854775807)
          (store! (field e hi) -9223372036854775808)
          (al-push! [StatEntry] (mut t) (load e))
          (primitive/isub (al-len [StatEntry] (load t)) 1)))))

;;; `(classify "label" COND)` — record how often a condition held. Returns the
;;; condition, so it composes inside a property body.
(defn prop-classify! [(name (slice u8)) (c bool)] (-> bool)
  (if (load (stat-collecting))
      (let [i (stat-entry! name STAT-FLAG)
            e (al-elem [StatEntry] (stat-table) i)]
        (store! (field e total) (primitive/iadd (load (field e total)) 1))
        (if c
            (store! (field e hits) (primitive/iadd (load (field e hits)) 1))
            0)
        0)
      0)
  c)

;;; `(collect "label" EXPR)` — record a number's range and mean across the run.
;;; Returns the value, so it wraps an expression in place.
(defn prop-collect! [(name (slice u8)) (v i64)] (-> i64)
  (if (load (stat-collecting))
      (let [i (stat-entry! name STAT-VALUE)
            e (al-elem [StatEntry] (stat-table) i)]
        (store! (field e total) (primitive/iadd (load (field e total)) 1))
        (store! (field e hits) (primitive/iadd (load (field e hits)) v))
        (if (< v (load (field e lo))) (store! (field e lo) v) 0)
        (if (> v (load (field e hi))) (store! (field e hi) v) 0)
        0)
      0)
  v)

;;; Print the distribution, and — the part that matters — WARN when one
;;; classification covers almost every case. A property whose input is 97% "empty
;;; list" has not been tested on non-empty lists, however green it looks.
(defn stat-report [(w (ptr Writer)) (verbose i64)] (-> i64)
  (let [t (stat-table)
        n (al-len [StatEntry] (load t))
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (let [e (al-elem [StatEntry] t (load i))
                    total (load (field e total))
                    hits (load (field e hits))]
                (if (= (load (field e kind)) STAT-FLAG)
                    (let [pct
                            (if (> total 0)
                                (primitive/udiv (primitive/imul hits 100) total)
                                0)]
                      (if (> verbose 0)
                          (do
                            (fmt w
                                 "    {}: {}% ({}/{})\n"
                                 (load (field e name))
                                 pct
                                 hits
                                 total)
                            0)
                          0)
                      (if (and (>= pct 90) (> total 20))
                          (do
                            (fmt w
                                 "\nWARNING: '{}' held in {}% of cases — the generator is barely exploring the other branch.\n"
                                 (load (field e name))
                                 pct)
                            0)
                          0)
                      0)
                    (if (> verbose 0)
                        (do
                          (fmt w
                               "    {}: min {}, mean {}, max {} (n={})\n"
                               (load (field e name))
                               (load (field e lo))
                               (if (> total 0) (primitive/idiv hits total) 0)
                               (load (field e hi))
                               total)
                          0)
                        0))
                (store! i (primitive/iadd (load i) 1))
                0)))
    0))

;;; The size budget for case i of n: a ramp from 1 to `max`, so the first cases are
;;; tiny (fast, and they catch the shallow bugs) and the last are full size.
(defn size-for [(i i64) (n i64) (max i64)] (-> i64)
  (if (<= n 1)
      max
      (let [s (primitive/iadd 1 (primitive/udiv (primitive/imul i max) n))]
        (if (> s max) max s))))

;;; Replay one candidate tape and report whether the property STILL fails on it.
;;; A rejected case (an `assume` that did not hold) is not a failure — treating it
;;; as one would let the shrinker "minimize" into inputs the property never claimed
;;; anything about, which is the classic way a shrinker produces a lie.
(defn run-candidate [(ctx (ptr i8)) (tape (ptr (ArrayList Choice)))] (-> bool)
  (let [rc (primitive/cast (ptr RunCtx) ctx)
        s (load (field rc src))]
    (source-begin-replay! s tape (load (field rc size)))
    (let [held (primitive/call-ptr (load (field rc prop)) s PROP-MODE-RUN)]
      (if (= (src-status s) ST-REJECTED)
          false
          (not held)))))

;;; One shared Source per process: the tape, the span table and the arena are all
;;; reused across cases, so a run of a million cases performs a handful of
;;; allocations in total rather than a handful per case.
(defn prop-source [(bytes i64)] (-> (ptr Source))
  (let [cell (primitive/alloc-static (ptr Source))]
    (if (= (primitive/cast i64 (load cell)) 0)
        (let [s (source-new (malloc-allocator) bytes 1)]
          ; `--alloc-tracked` gives every generated value its own real
          ; allocation instead of a slice of the arena. Much slower, and the only
          ; way a sanitizer can see a one-byte overrun on generated data — inside
          ; the arena that read lands on the next value and nothing complains.
          (if (= (if (args-has? "--alloc-tracked") 1 0) 0)
              0
              (source-alloc-mode! s 1 (malloc-allocator)))
          (store! cell s)
          0)
        0)
    (load cell)))

; ------------------------------------------------------------- the generate loop

;;; Run cases [0, limit) and return the index of the first one that FAILED, or -1.
;;;
;;; Always from case 0: the RNG advances case by case, so a case's input is a
;;; function of (seed, index) only when the whole prefix has been drawn. That is
;;; what makes the bisection below sound.
(defn run-cases [(s (ptr Source))
                 (prop (fnptr c [(ptr Source) i64] bool))
                 (cfg PropConfig)
                 (st (ptr PropStats))
                 (limit i64)] (-> i64)
  (let [mem (malloc-allocator)
        (mut i) 0
        (mut bad) -1
        (mut targeted) false
        (mut best-score) 0.0
        (mut best-tape) (al-new [Choice] mem)
        (mut best-size) (load (field cfg max-size))]
    (source-seed! s (load (field cfg seed)))
    (loop (if (or (>= (load bad) 0)
                  (or (>= (load i) limit)
                      ; Give up rather than spin: a precondition that rejects
                      ; everything is a broken test, and it should say so at the
                      ; end of a bounded run instead of burning the budget.
                      (> (load (field st rejected))
                         (load (field cfg max-rejects)))))
              (break)
              (let [size
                      (size-for (load i)
                                (load (field cfg cases))
                                (load (field cfg max-size)))]
                (source-begin-generate! s size)
                (source-stage-case! s (load i))
                ; each case gets its own swarm mask: a random SUBSET of the
                ; alternatives a generator offers. Feature-omission diversity
                ; finds bugs that "every feature, every case" never reaches.
                (source-swarm! s (case-swarm-mask s (load i)))
                (let [held (primitive/call-ptr prop s PROP-MODE-RUN)]
                  (if (= (src-status s) ST-REJECTED)
                      (store! (field st rejected)
                              (primitive/iadd (load (field st rejected)) 1))
                      (do
                        (store! (field st cases)
                                (primitive/iadd (load (field st cases)) 1))
                        (if held 0 (store! bad (load i)))
                        ; remember the highest-scoring case seen, to start the
                        ; targeted search from something better than random.
                        (if (src-targeted? s)
                            (do
                              (if (or (not (load targeted))
                                      (primitive/fcmp-gt (src-target s)
                                                         (load best-score)))
                                  (do
                                    (store! targeted true)
                                    (store! best-score (src-target s))
                                    (store! best-tape
                                            (tape-clone mem (src-tape s)))
                                    (store! best-size size)
                                    0)
                                  0)
                              0)
                            0)
                        0)))
                (store! i (primitive/iadd (load i) 1))
                0)))
    ; A property that reported a target has asked to be SEARCHED, not sampled.
    ; The extra budget is spent only for those properties, and only when plain
    ; generation found nothing.
    (if (and (load targeted) (< (load bad) 0))
        ; Twenty steps per case of ordinary budget. Search needs ITERATIONS —
        ; Löscher & Sagonas measure the benefit in thousands of steps — and a
        ; step is a replay plus a property call, i.e. microseconds. Only
        ; properties that opted in by calling `prop-target!` pay it.
        (if (target-phase s
                          prop
                          cfg
                          st
                          (mut best-tape)
                          (load best-score)
                          (load best-size)
                          (args-int "--target-steps"
                                    (primitive/imul (load (field cfg cases)) 20)))
            (store! bad (load (field cfg cases)))
            0)
        0)
    (load bad)))

; ---------------------------------------------------------- targeted search
;
; TARGETED PROPERTY-BASED TESTING (Löscher & Sagonas, ISSTA'17). When a property
; calls `prop-target!` with a number — queue depth, tree height, bytes allocated,
; distance from a boundary — the runner stops sampling uniformly and starts
; SEARCHING for inputs that maximize it. Their result: counterexamples that
; uniform random generation needs orders of magnitude more cases to reach.
;
; The neighbourhood function is the part that is usually hard to write, and on a
; tape it is free: a neighbour is the same tape with a few choices perturbed.
; That is the payoff of representing an input as its choices rather than as a
; value — the search operates on every generator ever written, with no per-type
; mutation code and no risk of producing a value the generator could not.
;
; The acceptance rule is THRESHOLD ACCEPTING (Dueck & Scheuer, 1990): take any
; neighbour that is not worse than (best - threshold), with the threshold
; decreasing to zero over the run. It is simulated annealing's deterministic
; cousin, chosen here because it needs no exponential — the standard Metropolis
; rule would drag libm into the standard library's test path for nothing.

;;; A neighbour of `src`: the same tape with a few choices moved. Perturbing one
;;; to three choices keeps a step local (a mutation that rewrites everything is a
;;; restart, not a step) while still letting a length choice change the shape.
;;; What the code under test wanted where this choice's current value was found.
;;;
;;; This is the substitution that makes comparison feedback worth having: the
;;; choice holds some byte, the program was seen comparing that byte against 70 and
;;; failing, so the mutation is "70" and not "some value that was interesting
;;; somewhere". No guessing about WHICH choice should take the magic value — the
;;; input's own contents pick it out.
;;;
;;; Out-of-range counterparts are dropped rather than clamped. Clamping 12345 into a
;;; byte's 32..126 gives 126, which is not a magic value and is already the endpoint
;;; mutation — it would turn a precise signal into noise that looks like progress.
(defn dict-mutation [(rng (ptr Rng)) (lo i64) (hi i64) (current i64)] (-> i64)
  (let [v (cov-dict-counterpart current)]
    (if (and (!= v current) (and (>= v lo) (<= v hi)))
        v
        (rng-range! (mut rng) lo hi))))

(defn mutate-tape [(a (dyn Allocator))
                   (rng (ptr Rng))
                   (src (ptr (ArrayList Choice)))] (-> (ArrayList Choice))
  (mutate-tape-sized a rng src 0))

;;; The same, but allowed to GROW a collection past the length it was recorded with.
;;;
;;; ⚠ WITHOUT THIS A CORPUS CANNOT GROW ITS INPUTS, and the failure is silent. A
;;; choice carries the constraints of the case that produced it, and the size
;;; budget RAMPS over a run — so the early cases, which are exactly the ones that
;;; discover the most coverage and therefore dominate the corpus, recorded lengths
;;; bounded by a size of one or two. Clamping a mutation to that recorded bound
;;; means every mutant of them is just as short, forever: a fuzzer that cannot
;;; reach a four-byte input no matter how long it runs. Measured: with the clamp,
;;; 20 000 iterations on the magic-bytes demo grew the corpus by zero.
;;;
;;; `size-hint` is the budget the candidate will actually be REPLAYED at, so a
;;; length choice may be proposed anywhere up to it. Proposing out of range is
;;; safe in general — `record!` clamps every replayed value against the live
;;; constraints — so the only thing this widens is what the search can imagine.
(defn mutate-tape-sized [(a (dyn Allocator))
                         (rng (ptr Rng))
                         (src (ptr (ArrayList Choice)))
                         (size-hint i64)] (-> (ArrayList Choice))
  (let [(mut out) (tape-clone a src)
        n (al-len [Choice] (load out))]
    (if (= n 0)
        (load out)
        (let [k (primitive/iadd 1 (rng-below! (mut rng) 3))
              (mut m) 0]
          (loop (if (>= (load m) k)
                    (break)
                    (let [idx (rng-below! (mut rng) n)
                          e (al-elem [Choice] (mut out) idx)
                          lo (load (field e lo))
                          hi
                            (if (and (= (load (field e kind)) CK-LEN)
                                     (> size-hint (load (field e hi))))
                                size-hint
                                (load (field e hi)))]
                      ; Four kinds of step, because one is never enough. A uniform
                      ; jump escapes a local optimum; a small nudge walks a
                      ; gradient the jump steps over; a snap to an endpoint crosses
                      ; the whole range in one move, which is what a monotone
                      ; objective (a sum, a length, a depth) actually needs — a
                      ; random walk of ±1 gets there far too slowly to matter
                      ; inside a test run.
                      ;
                      ; The fourth changes the complexity class rather than the
                      ; constant: a value the code under test was just seen
                      ; comparing against and FAILING, straight from
                      ; `coil.prop.cov`'s dictionary. Guessing a magic byte is 1 in
                      ; 95 and a four-byte magic value is four such guesses in the
                      ; right order; using the byte the comparison asked for is 1
                      ; in (dictionary size), and the dictionary is small because
                      ; only failed comparisons in the code under test reach it.
                      (case (rng-below! (mut rng) 5) 0
                            (store! (field e value)
                                    (rng-range! (mut rng) lo hi))
                              1
                            (store! (field e value)
                                    (choice-minimal lo
                                                    hi
                                                    (primitive/iadd (load (field e
                                                                                 value))
                                                                    (primitive/isub (rng-below! (mut rng)
                                                                                                17)
                                                                                    8))))
                              2
                            (store! (field e value) hi) 3
                            (store! (field e value) lo)
                              (store! (field e value)
                                      (dict-mutation rng
                                                     lo
                                                     hi
                                                     (load (field e value)))))
                      (store! m (primitive/iadd (load m) 1))
                      0)))
          (load out)))))

;;; Hill-climb the target for `budget` iterations. Returns true if the property
;;; failed on some neighbour — a targeted run that finds a counterexample has done
;;; its job and stops immediately.
(defn target-phase [(s (ptr Source))
                    (prop (fnptr c [(ptr Source) i64] bool))
                    (cfg PropConfig)
                    (st (ptr PropStats))
                    (seed-tape (ptr (ArrayList Choice)))
                    (seed-score f64)
                    (size i64)
                    (budget i64)] (-> bool)
  (let [mem (malloc-allocator)
        (mut best) (tape-clone mem seed-tape)
        (mut best-score) seed-score
        (mut failed) false
        (mut i) 0]
    (loop (if (or (load failed) (>= (load i) budget))
              (break)
              (let [(mut cand) (mutate-tape mem (field s rng) (mut best))]
                (source-begin-replay! s (mut cand) size)
                (let [held (primitive/call-ptr prop s PROP-MODE-RUN)]
                  (if (= (src-status s) ST-REJECTED)
                      (store! (field st rejected)
                              (primitive/iadd (load (field st rejected)) 1))
                      (do
                        (store! (field st cases)
                                (primitive/iadd (load (field st cases)) 1))
                        (if held
                            ; the threshold starts at a tenth of the current best
                            ; and closes linearly, so early steps may go downhill
                            ; and late ones may not.
                            (let [score (src-target s)
                                  slack
                                    (primitive/fmul (target-threshold (load best-score))
                                                    (primitive/cast f64
                                                                    (primitive/isub budget
                                                                                    (load i))))
                                  bar
                                    (primitive/fsub (load best-score)
                                                    (primitive/fdiv slack
                                                                    (primitive/cast f64
                                                                                    budget)))]
                              (if (primitive/fcmp-ge score bar)
                                  (do
                                    (store! best (tape-clone mem (src-tape s)))
                                    (if (primitive/fcmp-gt score
                                                           (load best-score))
                                        (store! best-score score)
                                        0)
                                    0)
                                  0)
                              0)
                            (store! failed true))
                        0)))
                (store! i (primitive/iadd (load i) 1))
                0)))
    (load failed)))

;;; The initial downhill tolerance: a tenth of the score's own magnitude, so the
;;; schedule works whether the objective is measured in bytes or in tree levels.
;;; A fixed absolute threshold would be either a free-for-all or a no-op depending
;;; on nothing but the unit the user happened to report in.
(defn target-threshold [(best f64)] (-> f64)
  (let [m (if (primitive/fcmp-ge best 0.0) best (primitive/fsub 0.0 best))]
    (if (primitive/fcmp-gt m 0.0) (primitive/fmul m 0.1) 1.0)))

;;; Regenerate case `k`'s tape WITHOUT running the property body on it. Cases
;;; before `k` are run normally (they passed once, so they are safe to repeat);
;;; case `k` is drawn in DRAW-ONLY mode. This is how the parent recovers the input
;;; of a case that killed its child: generation is pure, only the body crashes.
(defn regenerate-case [(s (ptr Source))
                       (prop (fnptr c [(ptr Source) i64] bool))
                       (cfg PropConfig)
                       (k i64)] (-> i64)
  (let [(mut i) 0]
    (source-seed! s (load (field cfg seed)))
    (loop (if (> (load i) k)
              (break)
              (let [size
                      (size-for (load i)
                                (load (field cfg cases))
                                (load (field cfg max-size)))]
                (source-begin-generate! s size)
                (source-swarm! s (case-swarm-mask s (load i)))
                (primitive/call-ptr prop
                                    s
                                    (if (= (load i) k)
                                        PROP-MODE-DRAW
                                        PROP-MODE-RUN))
                (store! i (primitive/iadd (load i) 1))
                0)))
    0))

; -------------------------------------------------------------- worker running
;
; Every property phase that runs the property BODY outside this process runs it in
; a process that was EXEC'D, not forked: the runner starts its own binary again
; with hidden flags saying which property to run and what to do with it. That is
; what buys the thing no in-process property testing library has — when a case does
; not merely return false but SEGFAULTS, the run survives to minimize it — and in a
; systems language that is not an exotic case, it is the most valuable class of bug
; the tool can find.
;
; It used to fork, which is far cheaper (~100µs against ~2-12ms) and wrong. `fork`
; in a process that has THREADS hands the child an address space whose locks are
; held by threads that do not exist in it; the child then deadlocks on its first
; call into whatever owns one — a linked Go c-archive, CoreFoundation, a sanitizer
; runtime, anything the program under test started — or is SIGKILLed outright by
; libSystem's atfork handler on macOS. The failure is especially cruel HERE, because
; the watchdog below turns that deadlock into a `TIMED OUT on case 0` report against
; a property that is perfectly true: the tool invents a bug in the user's code out
; of its own process handling. `coil test` hit the same hazard first and now spawns
; a process per test (coil.os::spawn); a property is the NESTED case — a fork inside
; a test process — and needs the same answer for the same reason.
;
; What an exec costs is shared memory: a worker inherits no Source, no tape, no
; statistics. Everything it needs is therefore either on its command line or in the
; tape database, which is what the flags below are for. Generation is deterministic
; in (seed, case index), so "run cases [0, N)" fully describes a generation phase; a
; shrink candidate is a tape, so it travels as a file.
;
; The worker reports through its exit status alone:
;   0        every case passed
;   2        some case returned false (an ordinary counterexample)
;   3        the worker could not do what it was asked (see CHILD-BROKEN)
;   killed   a case crashed; the signal is the diagnosis
(const CHILD-OK 0)

(const CHILD-FAILED 2)

;;; The worker ran nothing — it could not read the tape it was pointed at. Distinct
;;; from CHILD-FAILED because the property said NOTHING: a broken hand-off must not
;;; be read as a case that held, nor as one that failed.
(const CHILD-BROKEN 3)

;;; Returned instead of a wait code when the spawn itself failed. Negative, so it can
;;; never collide with a real status (0..255, or 128+signal).
(const CHILD-SPAWN-FAILED -1)

; The hidden flags that select a worker. Deliberately absent from `coil test
; --help`: they are a protocol between a runner and its own children, not a user
; interface, and every one of them is meaningless without the others.
(const PROP-CHILD-FLAG "--coil-prop-child")  ; the property this process is for

(const PROP-CASES-FLAG "--coil-prop-cases")  ; run cases [0, N)

(const PROP-REPLAY-FLAG "--coil-prop-replay")  ; replay the tape at this path

(const PROP-SIZE-FLAG "--coil-prop-size")  ; the size to replay at

(const PROP-ALARM-FLAG "--coil-prop-alarm")  ; watchdog seconds; 0 disables it

(const PROP-REPORT-FLAG "--coil-prop-report")  ; print the success report

(const PROP-QUIET-FLAG "--coil-prop-quiet")  ; discard the worker's own output

(const PROP-SHOW-FLAG "--coil-prop-show")  ; replay in SHOW mode: print what it drew

(const PROP-STAGE-FLAG "--coil-prop-stage")  ; mirror every choice into this file

;;; A watchdog for the child. An infinite loop in a property is a bug the tool
;;; should REPORT, not a reason for `coil test` to hang until someone notices;
;;; SIGALRM turns it into an ordinary crash, which the machinery below already
;;; knows how to bisect and minimize. Pass `--timeout 0` to disable, or
;;; higher for a genuinely long run.
;;;
;;; `alarm` is declared here and nowhere else in the standard library — externs
;;; are not deduplicated across modules, so a second declaration anywhere would
;;; break linking.
(extern alarm :cc c [u32] (-> u32))

;;; Decode a waitpid status the way the rest of this repo does: a terminating
;;; signal in the low 7 bits, else the exit code in the high byte.
;;; Seconds one run of a saved or candidate input may take before the watchdog
;;; calls it a hang: a campaign's `--input-timeout`, otherwise `--timeout`.
(defn watchdog-secs [] (-> i64)
  (if (args-has? "--fuzz")
      (args-int "--input-timeout" 10)
      (args-int "--timeout" 60)))

(defn wait-code [(status i64)] (-> i64)
  (let [sig (primitive/iand status 127)]
    (if (!= sig 0)
        (primitive/iadd 128 sig)
        (primitive/iand (primitive/udiv status 256) 255))))

; ── the worker command line ──────────────────────────────────────────────────
;
; A worker's argv is THIS process's argv plus the flags that say what it is for.
; Carrying the whole original command line is not tidiness: `--cases`, `--seed`,
; `--size`, `--db` and the rest are read from argv by parent and worker alike, and
; a worker that regenerated cases under different settings would be bisecting a
; different run. It also carries `coil test`'s own `--coil-test-only N`, which is
; what makes the new process run THIS test and no other.
;
; The storage is static and rebuilt per spawn: an argv must stay alive across the
; spawn call, spawns never overlap (the runner waits for each worker), and a
; property that is already reporting a crash is the last place to want an allocator.
(const PROP-ARGV-CAP 64)  ; argv entries, including argv[0] and the NULL

(const PROP-ARGV-BYTES 1024)  ; scratch for the flags this adds

(defstruct PropArgv [(n i64) (used i64)])

(defn prop-argv-state [] (-> (ptr PropArgv))
  (primitive/alloc-static PropArgv))

(defn prop-argv-slots [] (-> (ptr (array (ptr i8) 64)))
  (primitive/alloc-static (array (ptr i8) 64)))

(defn prop-argv-scratch [] (-> (ptr (array u8 1024)))
  (primitive/alloc-static (array u8 1024)))

;;; Refusing to spawn beats spawning a TRUNCATED command line: a worker missing its
;;; `--coil-prop-cases` would run the whole property again and report a nonsense
;;; verdict to a parent that is in the middle of bisecting a crash.
(defn prop-argv-overflow [(what (slice u8)) (limit i64)] (-> i64)
  (let [w (stderr)]
    (fmt w
         "coil prop: cannot spawn a worker: more than {} {} on this command line\n"
         limit
         what))
  (abort)
  0)

;;; Append one already-NUL-terminated argument.
(defn prop-argv-push! [(p (ptr i8))] (-> i64)
  (let [st (prop-argv-state)
        av (primitive/cast (ptr (ptr i8)) (prop-argv-slots))
        n (load (field st n))]
    (if (>= n PROP-ARGV-CAP) (prop-argv-overflow "arguments" PROP-ARGV-CAP) 0)
    (store! (primitive/index av n) p)
    (store! (field st n) (primitive/iadd n 1))
    0))

;;; Copy `s` into the scratch as a C string. The strings that come from argv are
;;; already NUL-terminated in place and are handed over uncopied; these are the ones
;;; this runner builds (a property name, a path, a number).
(defn prop-argv-cstr [(s (slice u8))] (-> (ptr i8))
  (let [st (prop-argv-state)
        buf (primitive/cast (ptr u8) (prop-argv-scratch))
        at (load (field st used))
        n (slice-len [u8] s)]
    (if (> (primitive/iadd (primitive/iadd at n) 1) PROP-ARGV-BYTES)
        (prop-argv-overflow "argument bytes" PROP-ARGV-BYTES)
        0)
    (let [(mut i) 0]
      (loop (if (>= (load i) n)
                (break)
                (do
                  (store! (primitive/index buf (primitive/iadd at (load i)))
                          (slice-get [u8] s (load i)))
                  (store! i (primitive/iadd (load i) 1))))))
    (store! (primitive/index buf (primitive/iadd at n)) (primitive/cast u8 0))
    (store! (field st used) (primitive/iadd (primitive/iadd at n) 1))
    (primitive/cast (ptr i8) (primitive/index buf at))))

;;; Start a fresh worker command line: this process's own argv, and nothing yet.
(defn prop-argv-begin! [] (-> i64)
  (let [st (prop-argv-state)
        n (args-count)
        (mut i) 0]
    (store! (field st n) 0)
    (store! (field st used) 0)
    (loop (if (>= (load i) n)
              (break)
              (do
                (prop-argv-push! (primitive/cast (ptr i8)
                                                 (slice-data [u8]
                                                             (args-nth (load i)))))
                (store! i (primitive/iadd (load i) 1)))))
    0))

(defn prop-argv-flag! [(flag (slice u8)) (value (slice u8))] (-> i64)
  (prop-argv-push! (prop-argv-cstr flag))
  (prop-argv-push! (prop-argv-cstr value)))

(defn prop-argv-int! [(flag (slice u8)) (v i64)] (-> i64)
  (let [a (malloc-allocator)
        (mut sb) (str/sb-new a)]
    (str/sb-push-i64! (mut sb) v)
    (let [s (str/sb-finish! (mut sb))]
      (prop-argv-flag! flag s)
      (db-free-bytes a s)
      0)))

;;; Terminate the command line and hand it back for `os/spawn`.
(defn prop-argv-finish! [] (-> (ptr (ptr i8)))
  (prop-argv-push! (primitive/cast (ptr i8) 0))
  (primitive/cast (ptr (ptr i8)) (prop-argv-slots)))

;;; Start a worker and wait for it; return its wait code (0 / 2 / 3 / 128+signal), or
;;; CHILD-SPAWN-FAILED. argv[0] is the name this process was started as, so a runner
;;; re-execs itself the same way `coil test` does.
(defn prop-spawn-wait [(av (ptr (ptr i8)))] (-> i64)
  (let [pid (os/spawn (load (primitive/index av 0)) av (os/spawn-envp))]
    (if (< pid 0)
        CHILD-SPAWN-FAILED
        (let [stp (primitive/alloc-stack i32)]
          (store! stp 0)
          (os/waitpid (primitive/cast i32 pid) stp 0)
          (wait-code (primitive/cast i64 (load stp)))))))

;;; Run cases [0, limit) in a worker and return its wait code. `report` asks the
;;; worker to print the success report, which only the phase that ran the WHOLE
;;; property wants — a bisection probe re-runs a prefix and must stay silent.
(defn spawn-run-cases [(name (slice u8)) (limit i64) (report bool)] (-> i64)
  (spawn-run-cases-staged name limit report "" (primitive/cast (ptr i64) 0)))

;;; The same, with the worker mirroring every choice into the stage file at
;;; `stage-path` (none when empty), so that if a case kills it, the file holds that
;;; case's tape — including values the property drew inside its body.
(defn spawn-run-cases-staged [(name (slice u8))
                              (limit i64)
                              (report bool)
                              (stage-path (slice u8))
                              (stage (ptr i64))] (-> i64)
  (prop-argv-begin!)
  (prop-argv-flag! PROP-CHILD-FLAG name)
  (prop-argv-int! PROP-CASES-FLAG limit)
  ; staged, the parent watches each case (`--timeout` per case); otherwise the
  ; worker's own alarm bounds the whole run
  (if (> (slice-len stage-path) 0)
      (prop-argv-flag! PROP-STAGE-FLAG stage-path)
      (prop-argv-int! PROP-ALARM-FLAG (args-int "--timeout" 60)))
  (if report (prop-argv-push! (prop-argv-cstr PROP-REPORT-FLAG)) 0)
  (prop-spawn-watch (prop-argv-finish!) stage (args-int "--timeout" 60)))

;;; Replay the tape stored at `path` in a worker, under a `secs` watchdog.
(defn spawn-replay [(name (slice u8)) (path (slice u8)) (size i64) (secs i64)] (-> i64)
  (spawn-replay-quietly name path size secs false))

;;; Replay in a worker that prints what the case draws — its arguments and every
;;; `prop-note` — on the way to whatever it does. For a crash, the one run that can
;;; show values drawn inside the body.
(defn spawn-replay-showing [(name (slice u8)) (path (slice u8)) (size i64) (secs i64)] (-> i64)
  (prop-argv-begin!)
  (prop-argv-flag! PROP-CHILD-FLAG name)
  (prop-argv-flag! PROP-REPLAY-FLAG path)
  (prop-argv-int! PROP-SIZE-FLAG size)
  (prop-argv-int! PROP-ALARM-FLAG secs)
  (prop-argv-push! (prop-argv-cstr PROP-SHOW-FLAG))
  (prop-spawn-wait (prop-argv-finish!)))

;;; The same, optionally with the worker's stdout and stderr discarded. Shrinking a
;;; crash runs a worker per candidate, and every one that crashes prints the
;;; runtime's report — a sanitizer's register dump, a backtrace — so an unquiet
;;; shrink buries the one report that matters under hundreds of copies.
(defn spawn-replay-quietly [(name (slice u8))
                            (path (slice u8))
                            (size i64)
                            (secs i64)
                            (quiet bool)] (-> i64)
  (spawn-replay-staged name path size secs quiet ""))

(defn spawn-replay-staged [(name (slice u8))
                           (path (slice u8))
                           (size i64)
                           (secs i64)
                           (quiet bool)
                           (stage-path (slice u8))] (-> i64)
  (prop-argv-begin!)
  (prop-argv-flag! PROP-CHILD-FLAG name)
  (prop-argv-flag! PROP-REPLAY-FLAG path)
  (prop-argv-int! PROP-SIZE-FLAG size)
  (prop-argv-int! PROP-ALARM-FLAG secs)
  (if quiet (prop-argv-push! (prop-argv-cstr PROP-QUIET-FLAG)) 0)
  (if (> (slice-len stage-path) 0) (prop-argv-flag! PROP-STAGE-FLAG stage-path) 0)
  (prop-spawn-wait (prop-argv-finish!)))

; ── the worker side ──────────────────────────────────────────────────────────

;;; Is this process a worker spawned for property `name`? A binary holding several
;;; properties runs every one of them in a worker too, so the name — not merely the
;;; presence of the flags — is what selects.
(defn prop-child? [(name (slice u8))] (-> bool)
  (str/str-eq (args-value PROP-CHILD-FLAG) name))

;;; A worker's whole life: do the one thing its flags asked for, then leave. Never
;;; returns. `_exit`, not `exit`: no atexit handlers, no flushing of a stream the
;;; parent also holds.
(defn prop-child-run [(name (slice u8))
                      (file (slice u8))
                      (line i64)
                      (prop (fnptr c [(ptr Source) i64] bool))] (-> i64)
  (let [cfg (prop-config name)
        s (prop-source (load (field cfg arena-bytes)))
        st (primitive/alloc-stack PropStats)
        secs (args-int PROP-ALARM-FLAG 0)
        limit (args-int PROP-CASES-FLAG -1)]
    (store! (field st cases) 0)
    (store! (field st rejected) 0)
    (store! (field st shrink-calls) 0)
    (store! (field st shrinks) 0)
    (stat-reset!)
    (store! (stat-collecting) true)
    ; The watchdog (see `alarm` above). Armed HERE and only here: it exists to keep
    ; a hung property from stalling the run, and a parent that armed one would kill
    ; the process that is supposed to report the hang.
    (if (> secs 0) (do (alarm (primitive/cast u32 secs)) 0) 0)
    (if (args-has? PROP-QUIET-FLAG)
        (let [null (os/open c"/dev/null" (primitive/cast i32 1) 0)]
          (if (>= null (primitive/cast i32 0))
              (do (os/dup2 null 1) (os/dup2 null 2) (os/close null) 0)
              0))
        0)
    (cond (args-has? PROP-FUZZ-WORKER-FLAG)
            (fuzz-worker-run s
                             prop
                             name
                             (args-int PROP-FUZZ-WORKER-FLAG 0)
                             (load (field cfg seed))
                             (load (field cfg cases))
                             (load (field cfg max-size))
                             (args-int "--fuzz" 0))
          (args-has? PROP-FUZZ-CMIN-FLAG)
            (fuzz-minimize-run s prop name (load (field cfg max-size)))
          (args-has? PROP-SHRINK-FLAG)
            (do
              (prop-child-attach-stage! s)
              (prop-child-shrink s prop cfg st name file line))
          (>= limit 0)
            (prop-child-cases s prop cfg st name limit)
          :else
            (prop-child-replay s prop cfg))
    0))

;;; Under `--coil-prop-stage PATH`, mirror every choice this worker draws into that
;;; file, and sign it with our pid so the parent can tell the stage was written.
(defn prop-child-attach-stage! [(s (ptr Source))] (-> i64)
  (if (args-has? PROP-STAGE-FLAG)
      (let [stage (stage-map (malloc-allocator) (args-value PROP-STAGE-FLAG))]
        (if (= (primitive/cast i64 stage) 0)
            0
            (do
              (stage-set! stage STAGE-PID (primitive/cast i64 (os/getpid)))
              (source-stage! s stage STAGE-CAP)
              0)))
      0))

(defn prop-child-cases [(s (ptr Source))
                        (prop (fnptr c [(ptr Source) i64] bool))
                        (cfg PropConfig)
                        (st (ptr PropStats))
                        (name (slice u8))
                        (limit i64)] (-> i64)
  (prop-child-attach-stage! s)
  (let [bad (run-cases s prop cfg st limit)]
    (if (>= bad 0)
        (do (os/_exit (primitive/cast i32 CHILD-FAILED)) 0)
        ; The success report is written HERE, in the worker, because this is where
        ; the cases ran and therefore where the counts and the distribution live.
        ; The parent has never seen a case of this run.
        (do
          (if (args-has? PROP-REPORT-FLAG)
              (report-success (stdout) name cfg st)
              0)
          (os/_exit (primitive/cast i32 CHILD-OK))
          0))))

(defn prop-child-replay [(s (ptr Source))
                         (prop (fnptr c [(ptr Source) i64] bool))
                         (cfg PropConfig)] (-> i64)
  (prop-child-attach-stage! s)
  (let [a (malloc-allocator)
        path (args-value PROP-REPLAY-FLAG)
        size (args-int PROP-SIZE-FLAG (load (field cfg max-size)))]
    (match (db-load-tape a path)
      (Err [e] (prop-child-broken path))
      (Ok [o]
          (match o
            (None [] (prop-child-broken path))
            (Some [t]
                  ; through `replay-here`, the same code `--no-fork` runs, so a
                  ; verdict cannot depend on which side of the spawn it came from.
                  (let [(mut tape) t
                        code (replay-here-at s prop (mut tape) size)]
                    (os/_exit (primitive/cast i32 code))
                    0)))))))

;;; A worker pointed at a tape it cannot read has to SAY SO and exit with a code that
;;; is not a verdict. Exiting 0 would report the input as passing — which is how a
;;; shrinker quietly stops shrinking, and how a reuse phase quietly stops reusing.
(defn prop-child-broken [(path (slice u8))] (-> i64)
  (let [w (stderr)]
    (fmt w "coil prop: worker could not read the tape at {}\n" path))
  (os/_exit (primitive/cast i32 CHILD-BROKEN))
  0)

; ── the phases that use them ─────────────────────────────────────────────────

;;; The index of the first case that CRASHES, found by bisection over the case
;;; count: each probe runs a prefix in a worker and asks whether that prefix
;;; survives. log2(cases) spawns — eight for a default run — and, decisively, zero
;;; cost on the happy path, where nothing crashes and nothing is bisected.
(defn find-crashing-case [(name (slice u8)) (cases i64)] (-> i64)
  (let [(mut lo) 0  ; a prefix length known to survive
        (mut hi) cases]  ; a prefix length known to die
    (loop (if (<= (primitive/isub (load hi) (load lo)) 1)
              (break)
              (let [mid
                      (primitive/iadd (load lo)
                                      (primitive/udiv (primitive/isub (load hi)
                                                                      (load lo))
                                                      2))
                    code (spawn-run-cases name mid false)]
                (if (> code 128)
                    (store! hi mid)
                    (store! lo mid))
                0)))
    ; prefix `hi` dies and prefix `lo` = hi-1 does not, so case hi-1 is the one.
    (primitive/isub (load hi) 1)))

;;; Replay one candidate tape IN A WORKER, for shrinking a crash. "Still failing"
;;; means the worker died from the same signal as the original crash — not merely
;;; that it died. A reducer that accepts any crash happily minimizes one bug into
;;; a different one and reports the wrong counterexample; requiring the signal to
;;; match is the cheapest guard against that slippage. (CHILD-BROKEN is not a signal
;;; and so can never match, which is what a failed hand-off should mean.)
(defn run-candidate-spawned [(ctx (ptr i8)) (tape (ptr (ArrayList Choice)))] (-> bool)
  (let [rc (primitive/cast (ptr RunCtx) ctx)
        s (load (field rc src))
        mem (malloc-allocator)
        path (load (field rc cand-path))
        code
          (if (db-save-tape mem path tape)
              (do
                (let [cs (load (field rc cand-stage))]
                  (if (= (primitive/cast i64 cs) 0) 0 (stage-reset! cs)))
                (spawn-replay-staged (load (field rc name))
                                     path
                                     (load (field rc size))
                                     (load (field rc cand-timeout))
                                     true
                                     (if (= (primitive/cast i64 (load (field rc cand-stage))) 0)
                                         ""
                                         (load (field rc cand-stage-path)))))
              CHILD-BROKEN)]
    ; The shrinker keeps the CANONICAL tape a run produced (replay clamps and fills
    ; in minima). Only the worker ran the whole property, so its staged tape is
    ; the canonical one; a DRAW replay here — the body must not run in this
    ; process — would record the arguments and drop everything the body drew,
    ; and the shrinker would carry on from an input that no longer crashes. The
    ; DRAW replay still supplies the arguments' spans.
    (source-begin-replay! s tape (load (field rc size)))
    (primitive/call-ptr (load (field rc prop)) s PROP-MODE-DRAW)
    (let [cs (load (field rc cand-stage))]
      (if (and (!= (primitive/cast i64 cs) 0) (!= (stage-get cs STAGE-PID) 0))
          (let [(mut staged) (stage-tape mem cs)
                canon (src-tape s)
                n (al-len [Choice] (load staged))
                (mut i) 0]
            (al-clear! [Choice] canon)
            (loop (if (>= (load i) n)
                      (break)
                      (do
                        (al-push! [Choice] canon (al-get [Choice] (load staged) (load i)))
                        (store! i (primitive/iadd (load i) 1)))))
            (al-free! [Choice] (mut staged))
            0)
          0))
    (= code (load (field rc crash-code)))))

; ------------------------------------------------------- fuzzing campaigns
;
; Under `--fuzz` (which `coil fuzz` passes to an instrumented build), a property is
; not run here at all. This process SUPERVISES a campaign: it starts worker
; processes (coil.prop.fuzz), watches them, and acts on how they end.
;
; Each worker mirrors the input it is running into its own stage file, so the
; supervisor needs nothing from a worker but its exit status and that file. That
; is what the old design lacked: it ran the campaign inside one generation worker
; and, on a crash, bisected over GENERATION cases — which cannot reach an input the
; mutation phase produced, so a crash the fuzzer found was reported against an
; unrelated random input.
;
; The supervisor is also the watchdog. A worker's stage counts executions; one
; whose count has not moved for `--input-timeout` seconds is stuck on its current
; input, and it is SIGKILLed and reported as a hang on exactly that input. And it is
; the clock: at `--fuzz-time` it asks every worker to stop, through the stage.

(const PROP-FUZZ-WORKER-FLAG "--coil-prop-fuzz-worker")  ; this process is worker N

(const PROP-FUZZ-CMIN-FLAG "--coil-prop-fuzz-cmin")  ; minimize the corpus

;;; The status a hung input is reported with: what the watchdog's SIGALRM produces
;;; in a spawned shrink candidate, so the hang shrinks and reports like one.
(const FUZZ-HANG-CODE 142)

(extern usleep :cc c [u32] (-> i32))

(defstruct FuzzWorker
  [(pid i64)
   (stage (ptr i64))
   (alive bool)
   (seen i64)  ; the exec count at the last check
   (moved i64)])  ; when it last changed, in ms

;;; How a campaign ended: 0 when every worker finished, else the failing worker's
;;; status (CHILD-FAILED, 128+signal, FUZZ-HANG-CODE, CHILD-BROKEN, or an exit code)
;;; and which worker it was.
(defstruct FuzzOutcome [(code i64) (worker i64) (execs i64)])

(defn spawn-fuzz-worker [(name (slice u8)) (flag (slice u8)) (i i64)] (-> i64)
  (prop-argv-begin!)
  (prop-argv-flag! PROP-CHILD-FLAG name)
  (prop-argv-int! flag i)
  (prop-argv-int! FUZZ-CAMPAIGN-FLAG (primitive/cast i64 (os/getpid)))
  (let [av (prop-argv-finish!)]
    (os/spawn (load (primitive/index av 0)) av (os/spawn-envp))))

(defn fuzz-now-ms [] (-> i64)
  (match (time/monotonic-now-ms)
    (Ok [t] t)
    (Err [e] 0)))

;;; Ask every worker to finish after its current input.
(defn fuzz-stop-all! [(ws (ptr (ArrayList FuzzWorker)))] (-> i64)
  (let [n (al-len [FuzzWorker] (load ws))
        (mut k) 0]
    (loop (if (>= (load k) n)
              (break)
              (do
                (stage-set! (load (field (al-elem [FuzzWorker] ws (load k)) stage))
                            STAGE-STOP
                            1)
                (store! k (primitive/iadd (load k) 1)))))
    0))

;;; Route SIGINT and SIGTERM to a pipe this supervisor polls, instead of killing it.
;;; False if they could not be subscribed (another subscription owns them), in which
;;; case a Ctrl-C ends the campaign the ordinary way.
(defn fuzz-subscribe-interrupts! [(sub (ptr SignalSubscription))] (-> bool)
  (let [nums (primitive/alloc-stack (array i32 2))]
    (store! (primitive/index (primitive/cast (ptr i32) nums) 0) (primitive/cast i32 2))
    (store! (primitive/index (primitive/cast (ptr i32) nums) 1) (primitive/cast i32 15))
    (match (signal-subscribe sub (slice-new [i32] (primitive/cast (ptr i32) nums) 2))
      (Ok [_]
          (do
            ; polled from the watchdog loop, so a read must not block
            (os/fcntl (load (field sub read-fd)) 4 (fuzz-nonblocking-flag))
            true))
      (Err [e] false))))

(defn fuzz--explicit-public-name [(name Code)] (-> Code)
  (primitive/syntax->datum name))

;;; O_NONBLOCK: 2048 on Linux, 4 on Darwin.
(defn gen-fuzz-nonblocking [] (-> Code)
  (if (primitive/code-eq (primitive/target-os) `linux)
      `(defn ~(fuzz--explicit-public-name `fuzz-nonblocking-flag) [] (-> i32) 2048)
      `(defn ~(fuzz--explicit-public-name `fuzz-nonblocking-flag) [] (-> i32) 4)))

(meta (gen-fuzz-nonblocking))

;;; Kill every worker still running and reap it.
(defn fuzz-kill-all! [(ws (ptr (ArrayList FuzzWorker)))] (-> i64)
  (let [n (al-len [FuzzWorker] (load ws))
        stp (primitive/alloc-stack i32)
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (let [wk (al-elem [FuzzWorker] ws (load i))]
                (if (load (field wk alive))
                    (do
                      (os/kill (primitive/cast i32 (load (field wk pid))) 9)
                      (os/waitpid (primitive/cast i32 (load (field wk pid))) stp 0)
                      (store! (field wk alive) false)
                      0)
                    0)
                (store! i (primitive/iadd (load i) 1))
                0)))
    0))

;;; One status line: totals across workers (executions add up; coverage and corpus
;;; are per worker, and because workers share their finds the best one stands for
;;; the campaign).
(defn fuzz-status [(w (ptr Writer))
                   (ws (ptr (ArrayList FuzzWorker)))
                   (elapsed-ms i64)
                   (last bool)] (-> i64)
  (let [n (al-len [FuzzWorker] (load ws))
        (mut execs) 0
        (mut corpus) 0
        (mut edges) 0
        (mut features) 0
        (mut guards) 0
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (let [st (load (field (al-elem [FuzzWorker] ws (load i)) stage))]
                (store! execs (primitive/iadd (load execs) (stage-get st STAGE-EXECS)))
                (if (> (stage-get st STAGE-CORPUS) (load corpus))
                    (store! corpus (stage-get st STAGE-CORPUS))
                    0)
                (if (> (stage-get st STAGE-EDGES) (load edges))
                    (store! edges (stage-get st STAGE-EDGES))
                    0)
                (if (> (stage-get st STAGE-FEATURES) (load features))
                    (store! features (stage-get st STAGE-FEATURES))
                    0)
                (if (> (stage-get st STAGE-GUARDS) (load guards))
                    (store! guards (stage-get st STAGE-GUARDS))
                    0)
                (store! i (primitive/iadd (load i) 1))
                0)))
    (let [secs (primitive/udiv elapsed-ms 1000)
          rate
            (if (> elapsed-ms 0)
                (primitive/udiv (primitive/imul (load execs) 1000) elapsed-ms)
                0)]
      (fmt w
           "  {} {}s: {} execs ({}/s), corpus {}, {} of {} edges, {} features\n"
           (if last "done" "#")
           secs
           (load execs)
           rate
           (load corpus)
           (load edges)
           (load guards)
           (load features)))
    (load execs)))

;;; Run a campaign for property `name` and report how it ended.
(defn fuzz-supervise [(name (slice u8)) (w (ptr Writer))] (-> FuzzOutcome)
  (let [a (malloc-allocator)
        cmin (args-has? "--fuzz-minimize")
        jobs0 (args-int "--fuzz-jobs" 1)
        jobs (if cmin 1 (if (< jobs0 1) 1 jobs0))
        limit-ms (primitive/imul (args-int "--fuzz-time" 0) 1000)
        timeout-ms (primitive/imul (args-int "--input-timeout" 10) 1000)
        status-ms (primitive/imul (args-int "--status-every" 10) 1000)
        dir (fuzz-dir a name)
        campaign (primitive/cast i64 (os/getpid))
        (mut ws) (al-new [FuzzWorker] a)
        out (primitive/alloc-stack FuzzOutcome)
        stp (primitive/alloc-stack i32)
        start (fuzz-now-ms)
        sub (primitive/alloc-stack SignalSubscription)
        subscribed (fuzz-subscribe-interrupts! sub)
        (mut interrupts) 0
        (mut stopping) false
        (mut last-status) start
        (mut done) false]
    (store! (field out code) 0)
    (store! (field out worker) -1)
    (store! (field out execs) 0)
    (db-mkdir-p a dir)
    (fuzz-clean-stale! a dir)
    (if (not cmin)
        (do
          (fmt w
               "\n  fuzzing {} with {} worker{}, {}; corpus {}\n"
               name
               jobs
               (if (= jobs 1) "" "s")
               (if (> limit-ms 0) "for a time budget" "until stopped or out of iterations")
               (fuzz-corpus-dir a dir))
          0)
        0)
    (let [(mut i) 0]
      (loop (if (or (load done) (>= (load i) jobs))
                (break)
                (let [path (fuzz-stage-path a dir campaign (load i))
                      st (stage-map a path)]
                  (if (= (primitive/cast i64 st) 0)
                      (do
                        (store! (field out code) CHILD-BROKEN)
                        (store! done true)
                        0)
                      (let [wk (primitive/alloc-stack FuzzWorker)]
                        (stage-reset! st)
                        (store! (field wk stage) st)
                        (store! (field wk pid)
                                (spawn-fuzz-worker name
                                                   (if cmin
                                                       PROP-FUZZ-CMIN-FLAG
                                                       PROP-FUZZ-WORKER-FLAG)
                                                   (load i)))
                        (store! (field wk alive) (>= (load (field wk pid)) 0))
                        (store! (field wk seen) 0)
                        (store! (field wk moved) start)
                        (al-push! [FuzzWorker] (mut ws) (load wk))
                        (if (< (load (field wk pid)) 0)
                            (do
                              (fmt w "coil fuzz: could not start worker {}\n" (load i))
                              (store! (field out code) CHILD-BROKEN)
                              (store! done true)
                              0)
                            0)))
                  (db-free-bytes a path)
                  (store! i (primitive/iadd (load i) 1))
                  0))))
    (loop (if (load done)
              (break)
              (do
                (usleep (primitive/cast u32 50000))
                (let [now (fuzz-now-ms)
                      n (al-len [FuzzWorker] (load ws))
                      (mut alive) 0
                      (mut i) 0]
                  (loop (if (or (load done) (>= (load i) n))
                            (break)
                            (let [wk (al-elem [FuzzWorker] (mut ws) (load i))]
                              (if (load (field wk alive))
                                  (let [pid (load (field wk pid))
                                        r
                                          (primitive/cast i64
                                                          (os/waitpid (primitive/cast i32 pid)
                                                                      stp
                                                                      1))]
                                    (if (= r pid)
                                        (let [code
                                                (wait-code (primitive/cast i64
                                                                           (load stp)))]
                                          (store! (field wk alive) false)
                                          (if (= code 0)
                                              0
                                              (do
                                                (store! (field out code) code)
                                                (store! (field out worker) (load i))
                                                (store! done true)
                                                0)))
                                        (let [execs (stage-get (load (field wk stage))
                                                               STAGE-EXECS)]
                                          (store! alive (primitive/iadd (load alive) 1))
                                          (if (!= execs (load (field wk seen)))
                                              (do
                                                (store! (field wk seen) execs)
                                                (store! (field wk moved) now)
                                                0)
                                              (if (and (> timeout-ms 0)
                                                       (> (primitive/isub now
                                                                          (load (field wk moved)))
                                                          timeout-ms))
                                                  ; stuck on one input: that input hangs
                                                  (do
                                                    (os/kill (primitive/cast i32 pid) 9)
                                                    (os/waitpid (primitive/cast i32 pid)
                                                                stp
                                                                0)
                                                    (store! (field wk alive) false)
                                                    (store! (field out code) FUZZ-HANG-CODE)
                                                    (store! (field out worker) (load i))
                                                    (store! done true)
                                                    0)
                                                  0))
                                          0)))
                                  0)
                              (store! i (primitive/iadd (load i) 1))
                              0)))
                  ; Ctrl-C / SIGTERM: the first stops the campaign the way its
                  ; time budget would, so it still reports what it covered; a
                  ; second abandons it
                  (if (and subscribed (not (load done)))
                      (match (signal-read sub)
                        (Ok [sig]
                            (do
                              (store! interrupts (primitive/iadd (load interrupts) 1))
                              (if (= (load interrupts) 1)
                                  (do
                                    (print-str w "\n  interrupted: stopping the workers (interrupt again to abandon the campaign)\n")
                                    (store! stopping true)
                                    (fuzz-stop-all! (mut ws))
                                    0)
                                  (do (fuzz-kill-all! (mut ws)) (store! done true) 0))))
                        (Err [e] 0))
                      0)
                  (if (load done)
                      0
                      (do
                        (if (= (load alive) 0) (store! done true) 0)
                        (if (and (> limit-ms 0)
                                 (and (not (load stopping))
                                      (>= (primitive/isub now start) limit-ms)))
                            (let [(mut k) 0]
                              (store! stopping true)
                              (loop (if (>= (load k) n)
                                        (break)
                                        (do
                                          (stage-set! (load (field (al-elem [FuzzWorker]
                                                                            (mut ws)
                                                                            (load k))
                                                                   stage))
                                                      STAGE-STOP
                                                      1)
                                          (store! k (primitive/iadd (load k) 1)))))
                              0)
                            0)
                        (if (and (not cmin)
                                 (and (> status-ms 0)
                                      (>= (primitive/isub now (load last-status))
                                          status-ms)))
                            (do
                              (fuzz-status w
                                           (mut ws)
                                           (primitive/isub now start)
                                           false)
                              (store! last-status now)
                              0)
                            0)
                        0))
                  0))))
    (fuzz-kill-all! (mut ws))
    (if subscribed (do (signal-close! sub) 0) 0)
    (fuzz-default-sigint!)
    ; the stages are scratch for this campaign; a failing worker's is read (and
    ; removed) by `fuzz-campaign`
    (let [(mut k) 0]
      (loop (if (>= (load k) (al-len [FuzzWorker] (load ws)))
                (break)
                (do
                  (if (= (load k) (load (field out worker)))
                      0
                      (let [pth (fuzz-stage-path a dir campaign (load k))]
                        (db-remove-tape a pth)
                        (db-free-bytes a pth)
                        0))
                  (store! k (primitive/iadd (load k) 1))))))
    (if cmin
        0
        (do
          (store! (field out execs)
                  (fuzz-status w (mut ws) (primitive/isub (fuzz-now-ms) start) true))
          (let [st0 (load (field (al-elem [FuzzWorker] (mut ws) 0) stage))]
            (if (and (= (load (field out code)) 0) (> (stage-get st0 STAGE-FUNCS) 0))
                (let [path (db-join a dir "coverage.txt")]
                  (fmt w
                       "  functions entered: {} of {} in the binary, which holds every property in the file (never-entered ones are listed in {})\n"
                       (stage-get st0 STAGE-FUNCS-HIT)
                       (stage-get st0 STAGE-FUNCS)
                       path)
                  (db-free-bytes a path)
                  0)
                0))
          0))
    (db-free-bytes a dir)
    (load out)))

;;; The campaign phase of `prop-run`: supervise, and if a worker failed, rebuild its
;;; input from its stage and hand it to the same shrinker and report as any other
;;; counterexample.
(defn fuzz-campaign [(name (slice u8))
                     (file (slice u8))
                     (line i64)
                     (prop (fnptr c [(ptr Source) i64] bool))
                     (s (ptr Source))
                     (cfg PropConfig)
                     (st (ptr PropStats))
                     (w (ptr Writer))] (-> i64)
  (let [o (fuzz-supervise name w)
        code (load (field o code))
        a (malloc-allocator)]
    (cond (= code 0) 0
          (= code CHILD-BROKEN)
            (do
              (fmt w "\nFAILED: the fuzzing campaign for {} could not run (see above)\n" name)
              (abort)
              0)
          :else
            (let [dir (fuzz-dir a name)
                  path (fuzz-stage-path a dir (primitive/cast i64 (os/getpid)) (load (field o worker)))
                  stage (stage-map a path)]
              (if (= (primitive/cast i64 stage) 0)
                  (do (abort) 0)
                  (let [(mut tape) (stage-tape a stage)
                        size (stage-get stage STAGE-SIZE)
                        _ (db-remove-tape a path)]
                    (store! (stat-collecting) false)
                    (store! (field st cases) (load (field o execs)))
                    (source-begin-replay! s (mut tape) size)
                    (let [log (fuzz-log-path a dir (primitive/cast i64 (os/getpid)) (load (field o worker)))]
                      (fmt w "\n  the failing worker's output is in {}\n" log)
                      (db-free-bytes a log))
                    (if (= code CHILD-FAILED)
                        ; an ordinary false: minimized in a worker, which also
                        ; says so if the input does not fail again
                        (do
                          (fmt w "\nFAILED while fuzzing\n")
                          (report-false-in-worker w
                                                  name
                                                  file
                                                  line
                                                  prop
                                                  s
                                                  cfg
                                                  st
                                                  (mut tape)
                                                  size
                                                  (stage-get stage STAGE-SWARM)
                                                  (load (field o execs))))
                        (do
                          ; a crash, a hang, or an exit: never run the body here
                          (source-swarm! s (stage-get stage STAGE-SWARM))
                          (source-begin-replay! s (mut tape) size)
                          (primitive/call-ptr prop s PROP-MODE-DRAW)
                          (if (= code FUZZ-HANG-CODE)
                              (fmt w
                                   "\nTIMED OUT while fuzzing: an input ran for more than {}s\n"
                                   (args-int "--input-timeout" 10))
                              (if (> code 128)
                                  (fmt w "\nCRASHED (signal {}) while fuzzing\n" (primitive/isub code 128))
                                  (fmt w "\nEXITED with code {} while fuzzing\n" code)))
                          (report-failure-tape w name file line prop s cfg st code (mut tape))))))))))

; ------------------------------------------------------------- the reuse phase
;
; A property that failed yesterday must fail in the first millisecond today, not
; after another two hundred random cases have been generated in the hope of
; stumbling onto the same input. The minimal counterexample is saved to
; `.coil/pbt/<property>/failing` and replayed FIRST on the next run — Hypothesis's
; "reuse" phase, and the single feature that makes a property suite feel like a
; regression suite.
;
; The replay gets its own worker process, because the saved input is by definition
; one that broke something, and a saved SEGFAULT must not take down the process
; that was about to minimize it. The worker reads the tape from the database file
; directly — the parent decodes the same bytes for its own report, but there is no
; need to hand across what is already on disk under a name both processes derive.
;
; ⚠ UNLESS `--no-fork`. This phase runs BEFORE the generation loop, so while a
; saved counterexample exists it is the only phase that runs at all — and it used
; to fork whatever the flag said. The two effects were exactly the ones that make
; the flag look broken rather than partly applied: a property under a debugger
; never stopped in the debugger, and `--seed` appeared to be ignored, because the
; seed steers generation and generation was never reached. Both read as bugs in
; other features. Replaying in-process is also what the flag ASKS for: the saved
; input is the one you most want to stop on, and `--no-fork`'s stated trade is
; crash minimization for a usable backtrace.

;;; Replay a saved tape, in a child or (under `--no-fork`) in this process. Returns
;;; the wait code, or CHILD-OK if there is nothing saved (and prints why, if the file
;;; exists but is unusable — a silently ignored corrupt database is
;;; indistinguishable from a healthy one).
(defn try-saved-failure [(s (ptr Source))
                         (prop (fnptr c [(ptr Source) i64] bool))
                         (cfg PropConfig)
                         (name (slice u8))
                         (w (ptr Writer))
                         (out (ptr (ArrayList Choice)))
                         (nofork bool)] (-> i64)
  (let [a (malloc-allocator)]
    (match (db-load-failure a name)
      (Err [e] (report-bad-db w e))
      (Ok [o]
          (match o
            (None [] CHILD-OK)
            (Some [t]
                  (let [(mut tape) t]
                    (store! out (tape-clone a (mut tape)))
                    (if nofork
                        (replay-here s prop cfg out)
                        (let [path (db-path a name)
                              code
                                (spawn-replay name
                                              path
                                              (load (field cfg max-size))
                                              (watchdog-secs))]
                          (db-free-bytes a path)
                          ; A worker that could not read the tape established NOTHING —
                          ; not that the property fails, and not that it holds. Say so
                          ; and leave the phase where it was: `out` goes back to empty,
                          ; which is what "there was nothing to reuse" looks like
                          ; everywhere else, so the saved entry is neither reported as
                          ; a failure nor deleted as fixed.
                          (if (= code CHILD-BROKEN)
                              (do
                                (print-str w
                                           "  note: the saved counterexample could not be replayed — keeping it, and generating.\n")
                                (store! out (al-new [Choice] a))
                                CHILD-OK)
                              code))))))))))

;;; The in-process half of the replay. No `alarm` here, deliberately: the watchdog a
;;; worker arms protects the parent from a hung child, and there is no child to be
;;; separate from — arming it would have SIGALRM kill the very process the caller
;;; asked to keep. The no-fork generation path declines it for the same reason. A
;;; saved input that crashes now takes this process down, which is the whole point of
;;; asking for no fork.
(defn replay-here [(s (ptr Source))
                   (prop (fnptr c [(ptr Source) i64] bool))
                   (cfg PropConfig)
                   (tape (ptr (ArrayList Choice)))] (-> i64)
  (replay-here-at s prop tape (load (field cfg max-size))))

;;; The same replay at an explicit size, which is what a spawned worker has: it is
;;; told the size on its command line rather than deriving it from a config the
;;; parent may have shrunk against. One function so that no verdict can depend on
;;; which side of a spawn produced it.
(defn replay-here-at [(s (ptr Source))
                      (prop (fnptr c [(ptr Source) i64] bool))
                      (tape (ptr (ArrayList Choice)))
                      (size i64)] (-> i64)
  (source-begin-replay! s tape size)
  (let [held
          (primitive/call-ptr prop
                              s
                              (if (args-has? PROP-SHOW-FLAG)
                                  PROP-MODE-SHOW
                                  PROP-MODE-RUN))]
    (if (or held (= (src-status s) ST-REJECTED)) CHILD-OK CHILD-FAILED)))

;;; A database file that exists but cannot be read is worth one line of output: a
;;; silently skipped reuse phase looks exactly like a healthy first run, so the
;;; feature would quietly stop working and nobody would know.
(defn report-bad-db [(w (ptr Writer)) (e TapeError)] (-> i64)
  (print-str w "  note: saved counterexample unusable — ")
  (tape-error-print w e)
  (print-str w "\n")
  CHILD-OK)

;;; Run one property to completion. Returns 0; a failure prints its report and
;;; aborts, which is what `coil test`'s runner records as a failure.
(defn prop-run [(name (slice u8))
                (file (slice u8))
                (line i64)
                (prop (fnptr c [(ptr Source) i64] bool))] (-> i64)
  ; A WORKER never reaches the phases below: it does the one thing its flags asked
  ; for and exits inside this call. It has to be the first thing tested, because a
  ; worker that fell through to the reuse phase would replay a saved counterexample
  ; its parent is in the middle of minimizing.
  (if (prop-child? name) (prop-child-run name file line prop) 0)
  ; read ONCE, for the whole run. It used to be read inside the generation phase
  ; and nowhere else, which is how the reuse phase came to ignore it.
  (let [nofork (args-has? "--no-fork")
        cfg (prop-config name)
        s (prop-source (load (field cfg arena-bytes)))
        w (stdout)
        st (primitive/alloc-stack PropStats)]
    (store! (field st cases) 0)
    (store! (field st rejected) 0)
    (store! (field st shrink-calls) 0)
    (store! (field st shrinks) 0)
    (stat-reset!)
    (store! (stat-collecting) true)
    ; PHASE 1 — reuse. Nothing below runs if yesterday's counterexample still
    ; fails: it is minimized already, so the fastest possible red is the right
    ; answer. A saved input that now PASSES is deleted, which is how a property
    ; stops carrying a fixed bug's corpse around forever.
    (let [(mut saved) (al-new [Choice] (malloc-allocator))
          reuse (try-saved-failure s prop cfg name w (mut saved) nofork)]
      (if (= reuse CHILD-OK)
          (do
            (if (> (al-len [Choice] (load saved)) 0)
                (do (db-clear (malloc-allocator) name) 0)
                0)
            0)
          (do
            (store! (stat-collecting) false)
            (print-str w "\n(replaying the saved counterexample)\n")
            ; an ordinary failure shrinks in a worker (see report-false-in-worker)
            (if (and (= reuse CHILD-FAILED) (not nofork))
                (report-false-in-worker w
                                        name
                                        file
                                        line
                                        prop
                                        s
                                        cfg
                                        st
                                        (mut saved)
                                        (load (field cfg max-size))
                                        -1
                                        0)
                0)
            (source-begin-replay! s (mut saved) (load (field cfg max-size)))
            (primitive/call-ptr prop
                                s
                                (if (> reuse 128) PROP-MODE-DRAW PROP-MODE-RUN))
            ; from the SAVED tape: a crash's DRAW replay above records only the
            ; arguments, and the saved tape also holds what the body drew
            (report-failure-tape w
                                 name
                                 file
                                 line
                                 prop
                                 s
                                 cfg
                                 st
                                 (if (> reuse 128) reuse -1)
                                 (mut saved))
            0)))
    ; PHASE 2 — generation. The crash branches below (`find-crashing-case`, and
    ; `run-candidate-spawned` inside `report-failure`) spawn unconditionally, and do
    ; not need to consult `nofork`: under it, `code` is only ever CHILD-OK or
    ; CHILD-FAILED, because a crashing case took this process with it rather than
    ; returning a signal from a worker. They are unreachable, not ungated.
    (if (args-has? "--fuzz")
        ; PHASE 2, fuzzing: a supervised campaign replaces generation.
        (fuzz-campaign name file line prop s cfg st w)
      (let [stage-path (prop-stage-path name nofork)
            stage (prop-stage-open stage-path)
            staged (!= (primitive/cast i64 stage) 0)
            code
              (if nofork
                  ; opting out: run in this process, where a debugger can see
                  ; the crash. Trades crash minimization for a usable backtrace.
                  (if (>= (run-cases s prop cfg st (load (field cfg cases))) 0)
                      CHILD-FAILED
                      CHILD-OK)
                  (spawn-run-cases-staged name
                                          (load (field cfg cases))
                                          true
                                          (if staged stage-path "")
                                          stage))
            ; did the worker leave the tape of the case it stopped on?
            have-tape (and staged (!= (stage-get stage STAGE-PID) 0))]
        (cond (= code CHILD-OK)
                (do
                  (prop-stage-remove! stage-path)
                  ; when we spawned, the worker already printed the counts it
                  ; owns; only the no-fork path still has to report from here.
                  (if nofork (report-success w name cfg st) 0))
              (and (= code CHILD-FAILED) have-tape)
                ; An ordinary counterexample: the stage holds the failing case.
                ; Minimize it in a worker, so a smaller input that crashes cannot
                ; take this process down with the report unwritten.
                (let [a (malloc-allocator)
                      (mut tape) (stage-tape a stage)
                      size (stage-get stage STAGE-SIZE)
                      swarm (stage-get stage STAGE-SWARM)
                      k (stage-get stage STAGE-CASE)]
                  (prop-stage-remove! stage-path)
                  (report-false-in-worker w name file line prop s cfg st (mut tape) size swarm k))
              (or (= code CHILD-FAILED) (< code 0))
                ; No stage (--no-fork, or no writable database) or no worker at
                ; all: re-run to the failing case in this process — generation is
                ; deterministic — and shrink here.
                (do
                  (prop-stage-remove! stage-path)
                  (store! (stat-collecting) false)
                  (run-cases s prop cfg st (load (field cfg cases)))
                  (report-failure w name file line prop s cfg st -1))
              (and (> code 128) have-tape)
                ; A crash, or a case the watchdog gave up on: the stage holds it.
                (report-staged-crash w name file line prop s cfg st code stage stage-path)
              (> code 128)
                ; No stage: find the case by bisection and rebuild it without
                ; running the body — which loses anything the body itself drew.
                (do
                  (store! (stat-collecting) false)
                  (let [k (find-crashing-case name (load (field cfg cases)))]
                    (regenerate-case s prop cfg k)
                    ; the bisection re-ran prefixes, so the case counter is
                    ; whatever the last probe left behind; the number that
                    ; means anything is which case crashed.
                    (store! (field st cases) k)
                    (fmt w
                         "\n{} (signal {}) on case {}\n"
                         (failure-kind code)
                         (primitive/isub code 128)
                         k)
                    (report-failure w name file line prop s cfg st code)))
              :else
                ; The property called exit() or otherwise ended the process.
                (do
                  (prop-stage-remove! stage-path)
                  (fmt w
                       "\nFAILED: the property's process exited with code {}\n"
                       code)
                  (abort)
                  0))))
    0))

;;; Where a property's generation worker stages its cases: `<db>/<property>/stage`,
;;; or "" under `--no-fork`, where there is no worker. Owning.
(defn prop-stage-path [(name (slice u8)) (nofork bool)] (-> (slice u8))
  (if nofork
      ""
      (let [a (malloc-allocator)
            d (db-dir a name)
            p (db-join a d "stage")]
        (db-free-bytes a d)
        p)))

;;; Delete a stage file. It is scratch for one run: a stage outliving its run is a
;;; 5 MB file (sparse, but not to every tool) left in someone's checkout.
(defn prop-stage-remove! [(path (slice u8))] (-> i64)
  (if (> (slice-len path) 0) (db-remove-tape (malloc-allocator) path) 0))

;;; Map a fresh stage file at `path` for a generation worker, or null when there is
;;; no path (`--no-fork`) or the file cannot be made — the caller then falls back to
;;; finding a crashing case by bisection.
(defn prop-stage-open [(path (slice u8))] (-> (ptr i64))
  (if (= (slice-len path) 0)
      (primitive/cast (ptr i64) 0)
      (let [a (malloc-allocator)
            dir (db-dir-of-path a path)]
        (db-mkdir-p a dir)
        (db-free-bytes a dir)
        (let [st (stage-map a path)]
          (if (= (primitive/cast i64 st) 0) 0 (stage-reset! st))
          st))))

;;; `path` followed by `suffix`. Owning.
(defn cat-path [(a (dyn Allocator)) (path (slice u8)) (suffix (slice u8))] (-> (slice u8))
  (let [(mut sb) (str/sb-new a)]
    (str/sb-push-str! (mut sb) path)
    (str/sb-push-str! (mut sb) suffix)
    (str/sb-finish! (mut sb))))

;;; `path` without its last component. Owning.
(defn db-dir-of-path [(a (dyn Allocator)) (path (slice u8))] (-> (slice u8))
  (let [(mut cut) (slice-len path)]
    (loop (if (or (<= (load cut) 0)
                  (= (primitive/cast i64 (slice-get path (primitive/isub (load cut) 1))) 47))
              (break)
              (store! cut (primitive/isub (load cut) 1))))
    (let [(mut sb) (str/sb-new a)]
      (str/sb-push-str! (mut sb) (subslice path 0 (if (> (load cut) 0) (primitive/isub (load cut) 1) 0)))
      (str/sb-finish! (mut sb)))))

;;; Report a case that killed its generation worker, rebuilt from the stage.
(defn report-staged-crash [(w (ptr Writer))
                           (name (slice u8))
                           (file (slice u8))
                           (line i64)
                           (prop (fnptr c [(ptr Source) i64] bool))
                           (s (ptr Source))
                           (cfg PropConfig)
                           (st (ptr PropStats))
                           (code i64)
                           (stage (ptr i64))
                           (stage-path (slice u8))] (-> i64)
  (let [a (malloc-allocator)
        (mut tape) (stage-tape a stage)
        k (stage-get stage STAGE-CASE)
        swarm (stage-get stage STAGE-SWARM)
        size (stage-get stage STAGE-SIZE)]
    (prop-stage-remove! stage-path)
    (store! (stat-collecting) false)
    ; the swarm mask steers which alternatives a generator may take, on replay too
    (source-swarm! s swarm)
    (source-begin-replay! s (mut tape) size)
    ; DRAW: the arguments' spans and display, without running the body
    (primitive/call-ptr prop s PROP-MODE-DRAW)
    (store! (field st cases) k)
    ; a shrink worker's stage names no generated case: the input came from shrinking
    (if (= (stage-get stage STAGE-CASE) -1)
        (fmt w
             "\n{} (signal {}) on an input found while shrinking\n"
             (failure-kind code)
             (primitive/isub code 128))
        (fmt w
             "\n{} (signal {}) on case {}\n"
             (failure-kind code)
             (primitive/isub code 128)
             k))
    (report-failure-tape w name file line prop s cfg st code (mut tape))))

; ── minimizing an ordinary failure in a worker ────────────────────────────────
;
; An ordinary counterexample (the property returned false) shrinks with every
; candidate run in-process: a candidate costs ~100ns there, and a process each
; would cost milliseconds. It used to run in-process in the RUNNER, and a smaller
; candidate that crashed — common: shrink an input and you reach the edge cases —
; took the runner down with it. No report, nothing saved; the property just died.
;
; So the shrink runs in ONE worker, with its Source staged. The worker prints the
; report and saves the minimized tape itself, then exits CHILD-REPORTED. If a
; candidate crashes or hangs, the worker dies and the stage holds that candidate:
; a smaller input that does something worse than return false, which is then
; reported — and minimized — as the crash it is.

(const PROP-SHRINK-FLAG "--coil-prop-shrink")  ; minimize the ordinary failure at this path

(const PROP-SWARM-FLAG "--coil-prop-swarm")  ; the swarm mask the failing case ran under

(const PROP-COUNT-FLAG "--coil-prop-count")  ; cases run before the failure, for the report

;;; A shrink worker printed and saved its report.
(const CHILD-REPORTED 4)

;;; Minimize the ordinary failure `tape` in a worker (see above). Never returns.
(defn report-false-in-worker [(w (ptr Writer))
                              (name (slice u8))
                              (file (slice u8))
                              (line i64)
                              (prop (fnptr c [(ptr Source) i64] bool))
                              (s (ptr Source))
                              (cfg PropConfig)
                              (st (ptr PropStats))
                              (tape (ptr (ArrayList Choice)))
                              (size i64)
                              (swarm i64)
                              (count i64)] (-> i64)
  (let [a (malloc-allocator)
        dir (db-dir a name)
        tpath (db-join a dir "to-shrink")
        spath (db-join a dir "shrink-stage")]
    (db-mkdir-p a dir)
    (let [stage (prop-stage-open spath)
          code
            (if (db-save-tape a tpath tape)
                (do
                  (prop-argv-begin!)
                  (prop-argv-flag! PROP-CHILD-FLAG name)
                  (prop-argv-flag! PROP-SHRINK-FLAG tpath)
                  (prop-argv-int! PROP-SIZE-FLAG size)
                  (prop-argv-int! PROP-SWARM-FLAG swarm)
                  (prop-argv-int! PROP-COUNT-FLAG count)
                  (if (= (primitive/cast i64 stage) 0)
                      (prop-argv-int! PROP-ALARM-FLAG (watchdog-secs))
                      (prop-argv-flag! PROP-STAGE-FLAG spath))
                  (prop-spawn-watch (prop-argv-finish!) stage (watchdog-secs)))
                CHILD-SPAWN-FAILED)]
      (db-remove-tape a tpath)
      (cond (= code CHILD-REPORTED)
              (do (prop-stage-remove! spath) (abort) 0)
            (= code CHILD-OK)
              ; the worker replayed the input and it PASSED
              (do
                (prop-stage-remove! spath)
                (print-str w
                           "\nFAILED, but the failing input passes when replayed in a fresh process: the property depends on something other than its input (time, global state, uninitialized memory — try --sanitize=address).\n")
                (abort)
                0)
            (and (>= code 0)
                 (and (!= (primitive/cast i64 stage) 0) (!= (stage-get stage STAGE-PID) 0)))
              (do
                (fmt w
                     "\n  while minimizing that failure, a smaller input {}: minimizing that instead\n"
                     (if (= code FUZZ-HANG-CODE) "never finished" "crashed the property"))
                (report-staged-crash w name file line prop s cfg st code stage spath))
            :else
              ; no worker could be started: shrink here, as before workers
              (do
                (prop-stage-remove! spath)
                (source-swarm! s swarm)
                (source-begin-replay! s tape size)
                (primitive/call-ptr prop s PROP-MODE-RUN)
                (store! (field st cases) count)
                (report-failure-tape w name file line prop s cfg st -1 tape))))))

;;; The shrink worker's side. Never returns.
(defn prop-child-shrink [(s (ptr Source))
                         (prop (fnptr c [(ptr Source) i64] bool))
                         (cfg PropConfig)
                         (st (ptr PropStats))
                         (name (slice u8))
                         (file (slice u8))
                         (line i64)] (-> i64)
  (let [a (malloc-allocator)
        path (args-value PROP-SHRINK-FLAG)
        size (args-int PROP-SIZE-FLAG (load (field cfg max-size)))
        w (stdout)]
    (store! (stat-collecting) false)
    (source-swarm! s (args-int PROP-SWARM-FLAG -1))
    (store! (field st cases) (args-int PROP-COUNT-FLAG 0))
    (source-stage-case! s -1)
    (match (db-load-tape a path)
      (Err [e] (prop-child-broken path))
      (Ok [o]
          (match o
            (None [] (prop-child-broken path))
            (Some [t]
                  (let [(mut tape) t]
                    (source-begin-replay! s (mut tape) size)
                    (let [held (primitive/call-ptr prop s PROP-MODE-RUN)]
                      (if (or held (= (src-status s) ST-REJECTED))
                          (do (os/_exit (primitive/cast i32 CHILD-OK)) 0)
                          (report-failure-tape w name file line prop s cfg st -1 (mut tape)))))))))))

;;; Spawn the worker whose argv was just built and wait for it, WATCHING its stage:
;;; a worker whose case counter has not moved for `secs` seconds is stuck in one
;;; case, and is killed and reported as a hang on that case (FUZZ-HANG-CODE). With
;;; no stage there is nothing to watch, and the worker's own alarm is the watchdog.
(defn prop-spawn-watch [(av (ptr (ptr i8))) (stage (ptr i64)) (secs i64)] (-> i64)
  (if (= (primitive/cast i64 stage) 0)
      (prop-spawn-wait av)
      (let [pid (os/spawn (load (primitive/index av 0)) av (os/spawn-envp))]
        (if (< pid 0)
            CHILD-SPAWN-FAILED
            (let [stp (primitive/alloc-stack i32)
                  (mut seen) (stage-get stage STAGE-EXECS)
                  (mut moved) (fuzz-now-ms)
                  (mut nap) 1000
                  (mut code) CHILD-SPAWN-FAILED]
              (store! stp 0)
              (loop (let [r
                            (primitive/cast i64
                                            (os/waitpid (primitive/cast i32 pid) stp 1))]
                      (if (= r pid)
                          (do (store! code (wait-code (primitive/cast i64 (load stp)))) (break))
                          (let [e (stage-get stage STAGE-EXECS)
                                now (fuzz-now-ms)]
                            (if (!= e (load seen))
                                (do (store! seen e) (store! moved now) 0)
                                (if (and (> secs 0)
                                         (> (primitive/isub now (load moved))
                                            (primitive/imul secs 1000)))
                                    (do
                                      (os/kill (primitive/cast i32 pid) 9)
                                      (os/waitpid (primitive/cast i32 pid) stp 0)
                                      (store! code FUZZ-HANG-CODE)
                                      (break))
                                    0))
                            (usleep (primitive/cast u32 (load nap)))
                            ; poll fast at first — most workers are done in
                            ; milliseconds — and back off to 50 ms
                            (if (< (load nap) 50000)
                                (store! nap (primitive/imul (load nap) 2))
                                0)
                            0))))
              (load code))))))

;;; Swarm masks: the all-ones mask for every eighth case (so no alternative is ever
;;; unreachable), random subsets otherwise. Groce et al. found omission diversity
;;; beats uniform generation because features compete for room inside one case.
;;;
;;; The mask is drawn from the case's own RNG — so it replays with the seed — but
;;; is deliberately NOT recorded on the tape: it is a property of the SEARCH, not
;;; of the value, and recording it would make every shrink candidate change shape.
(defn case-swarm-mask [(s (ptr Source)) (i i64)] (-> i64)
  (if (= (primitive/irem i 8) 0)
      -1
      (primitive/ior (primitive/cast i64 (rng-next! (mut (field s rng)))) 1)))

(defn report-success [(w (ptr Writer))
                      (name (slice u8))
                      (cfg PropConfig)
                      (st (ptr PropStats))] (-> i64)
  (if (> (load (field cfg verbose)) 0)
      (do
        (fmt w
             "  {}: {} cases passed ({} rejected)\n"
             name
             (load (field st cases))
             (load (field st rejected)))
        0)
      0)
  ; A property that throws away MOST of what it generates is not testing what its
  ; author thinks it is. Say so rather than reporting a green run that examined a
  ; handful of inputs — an unnoticed `assume` that rejects almost everything is
  ; the quietest way for a property suite to stop working.
  ;
  ; The bar is "more discarded than kept", not something tighter: a precondition
  ; that halves the input space is ordinary and useful, and a warning that fires
  ; on ordinary code is a warning people learn to skip past.
  (let [rej (load (field st rejected))
        total (primitive/iadd (load (field st cases)) rej)]
    (if (and (> rej 0) (> rej (load (field st cases))))
        (do
          (fmt w
               "\nWARNING: {} rejected {} of {} generated cases ({}%).\n"
               name
               rej
               total
               (primitive/udiv (primitive/imul rej 100) total))
          (print-str w
                     "  The precondition is too sparse — generate valid inputs directly instead of filtering.\n")
          0)
        0))
  0)

;;; How many candidates the shrinker may run, given how expensive one is here.
;;;
;;; In-process a candidate costs ~100ns, so twenty thousand of them are free. A
;;; candidate that needs its own PROCESS costs an exec — a few milliseconds for an
;;; ordinary test binary, over ten for one that initialises a language runtime at
;;; startup — so the crash budget is two orders of magnitude smaller: two hundred
;;; candidates is well under a second, and past that the shrinker is spending more
;;; time than the last few bytes of the input are worth. (It was a twentieth back
;;; when a candidate was a ~100µs fork; the exec is what moved it.) A candidate that
;;; has to be TIMED OUT costs whole seconds, so that budget collapses to a few dozen:
;;; with a hang, the shrinker's job is to produce a small input quickly, not the
;;; smallest input eventually.
;;; Did this failure end a PROCESS rather than return false? 128+signal for a crash,
;;; and — from a fuzzing worker, whose every exit is observed — any other exit
;;; status too: AddressSanitizer, for one, reports and then exits 1 unless told to
;;; abort. Such a failure can only be reproduced in a worker, so it is shrunk the
;;; same way a crash is. -1 means an ordinary false.
(defn crash-failure? [(crash-code i64)] (-> bool)
  (>= crash-code 0))

(defn shrink-budget-for [(cfg PropConfig) (crash-code i64)] (-> i64)
  (if (= crash-code 142)
      64
      (if (crash-failure? crash-code)
          (primitive/udiv (load (field cfg shrink-budget)) 100)
          (load (field cfg shrink-budget)))))

;;; The budget for shrinking a CRASH, once it is known that a candidate can actually
;;; be handed to a worker: every candidate travels as a FILE, so a database that
;;; cannot be written means not one candidate can be evaluated. Say so once and
;;; report the input as it was found, rather than burning the budget on candidates
;;; that are all rejected for a reason that has nothing to do with the property.
(defn crash-shrink-budget [(w (ptr Writer))
                           (a (dyn Allocator))
                           (path (slice u8))
                           (tape (ptr (ArrayList Choice)))
                           (budget i64)] (-> i64)
  (if (db-save-tape a path tape)
      budget
      (do
        (fmt w
             "\n  note: cannot write shrink candidates to {} — reporting this input unminimized.\n"
             path)
        0)))

;;; SIGALRM means the watchdog fired: the property did not crash, it never
;;; finished. Saying "signal 14" instead makes the reader look up a signal number
;;; to learn something the runner already knew.
(defn failure-kind [(crash-code i64)] (-> (slice u8))
  (if (= crash-code 142) "TIMED OUT" "CRASHED"))

;;; Shrink the tape the Source is currently holding, then print it and abort.
;;; `crash-code` is 128+signal when the failure was a crash (in which case every
;;; candidate is evaluated in its own process) and -1 for an ordinary counterexample.
(defn report-failure [(w (ptr Writer))
                      (name (slice u8))
                      (file (slice u8))
                      (line i64)
                      (prop (fnptr c [(ptr Source) i64] bool))
                      (s (ptr Source))
                      (cfg PropConfig)
                      (st (ptr PropStats))
                      (crash-code i64)] (-> i64)
  (report-failure-tape w name file line prop s cfg st crash-code (src-tape s)))

;;; The same, shrinking from an explicit tape rather than the one the Source last
;;; recorded. A crashed case's tape comes from its worker's stage: replaying it here
;;; in DRAW mode (the body must not run) records only the arguments' choices, and
;;; shrinking from that would drop every value the body drew — the crash would
;;; vanish and the "minimized" input would be a different one. The Source's spans
;;; from that replay still describe the arguments, which is what they are for.
(defn report-failure-tape [(w (ptr Writer))
                           (name (slice u8))
                           (file (slice u8))
                           (line i64)
                           (prop (fnptr c [(ptr Source) i64] bool))
                           (s (ptr Source))
                           (cfg PropConfig)
                           (st (ptr PropStats))
                           (crash-code i64)
                           (tape (ptr (ArrayList Choice)))] (-> i64)
  (let [mem (malloc-allocator)
        rc (box! mem RunCtx (zeroed RunCtx))
        (mut failing) (tape-clone mem tape)
        (mut failing-spans) (spans-clone mem (src-spans s))]
    (store! (field rc src) s)
    (store! (field rc prop) prop)
    (store! (field rc size) (src-size s))
    (store! (field rc crash-code) crash-code)
    ; A campaign already said how long an input may run: shrinking its hang with a
    ; different limit would wait the wrong amount on every candidate.
    (store! (field rc cand-timeout)
            (args-int "--candidate-timeout"
                      (if (args-has? "--fuzz") (args-int "--input-timeout" 10) 5)))
    (store! (field rc name) name)
    (store! (field rc cand-path) "")
    ; Only a crash hands candidates to workers, and only then is there a directory
    ; to prepare: an ordinary counterexample is shrunk entirely in this process.
    (if (crash-failure? crash-code)
        (let [dir (db-dir mem name)]
          (db-mkdir-p mem dir)
          (db-free-bytes mem dir)
          (store! (field rc cand-path) (db-candidate-path mem name))
          (let [sp (cat-path mem (load (field rc cand-path)) ".stage")]
            (store! (field rc cand-stage-path) sp)
            (store! (field rc cand-stage) (prop-stage-open sp)))
          0)
        (do
          (store! (field rc cand-stage-path) "")
          (store! (field rc cand-stage) (primitive/cast (ptr i64) 0))
          0))
    (let [runner
            (if (crash-failure? crash-code)
                (primitive/fnptr-of run-candidate-spawned)
                (primitive/fnptr-of run-candidate))
          budget
            (if (crash-failure? crash-code)
                (crash-shrink-budget w
                                     mem
                                     (load (field rc cand-path))
                                     (mut failing)
                                     (shrink-budget-for cfg crash-code))
                (shrink-budget-for cfg crash-code))
          sc (shrink-ctx-new mem s runner (primitive/cast (ptr i8) rc) budget)]
      (sc-seed-best! sc (mut failing) (mut failing-spans))
      (shrink-run! sc)
      (store! (field st shrink-calls) (sc-calls sc))
      (store! (field st shrinks) (sc-accepted sc))
      ; Save the MINIMIZED tape, not the one that happened to fail: tomorrow's
      ; reuse phase should replay the small input, and it should not have to
      ; re-derive it. A database that cannot be written (read-only checkout, no
      ; permission) is not a test failure and is deliberately silent.
      (db-save-failure mem name (sc-best sc))
      (fmt w
           "\nFAILED after {} cases ({} shrinks, {} shrink calls)\n"
           (load (field st cases))
           (sc-accepted sc)
           (sc-calls sc))
      (print-str w "\n  counterexample:\n")
      ; Re-run the minimal tape with printing on. For a CRASH the body must NOT
      ; run here: printing the input is the whole point, and the body would end
      ; the process before the values reached the terminal.
      (source-begin-replay! s (sc-best sc) (load (field rc size)))
      (primitive/call-ptr prop
                          s
                          (if (crash-failure? crash-code)
                              PROP-MODE-DRAW-SHOW
                              PROP-MODE-SHOW))
      (if (crash-failure? crash-code)
          (do
            (if (= crash-code 142)
                (fmt w
                     "\n  the property NEVER FINISHED on this input (watchdog fired after {}s).\n"
                     (watchdog-secs))
                (if (> crash-code 128)
                    (fmt w
                         "\n  the property CRASHED on this input (signal {}).\n"
                         (primitive/isub crash-code 128))
                    (fmt w
                         "\n  the property's process EXITED with code {} on this input.\n"
                         crash-code)))
            0)
          0)
      ; Every candidate ran quietly. Run the MINIMIZED input once more with its
      ; output shown, so the backtrace or sanitizer report on the terminal is the
      ; one for the input being reported.
      (if (crash-failure? crash-code)
          (do
            ; (a hang has no report to show: its re-run would only wait out the
            ; watchdog again)
            (if (and (!= crash-code 142)
                     (db-save-tape mem (load (field rc cand-path)) (sc-best sc)))
                (do
                  (print-str w "\n  the minimized input, run once more:\n")
                  (spawn-replay-showing name
                                        (load (field rc cand-path))
                                        (load (field rc size))
                                        (load (field rc cand-timeout)))
                  0)
                0)
            (db-remove-tape mem (load (field rc cand-path)))
            (if (> (slice-len (load (field rc cand-stage-path))) 0)
                (db-remove-tape mem (load (field rc cand-stage-path)))
                0))
          0)
      (fmt w "\n  property {}\n       at {}:{}\n" name file line)
      ; A fuzzing campaign's input is not a function of the seed — it came out of a
      ; corpus and a mutation history — so the seed would reproduce nothing. The
      ; minimized tape was saved above, and `coil test` replays a saved
      ; counterexample before it generates anything.
      (if (args-has? "--fuzz")
          (fmt w
               "\n  reproduce:  coil test {}{}   (replays the counterexample saved in the property database)\n\n"
               (if (args-has? "--alloc-tracked")
                   "--sanitize=address --alloc-tracked "
                   "")
               file)
          (fmt w
               "\n  reproduce:  coil test {} --seed {} --cases {}\n\n"
               file
               (load (field cfg seed))
               (load (field cfg cases))))
      ; a shrink worker's parent does the aborting, once it knows the report is out
      (if (args-has? PROP-SHRINK-FLAG)
          (do (os/_exit (primitive/cast i32 CHILD-REPORTED)) 0)
          (do (abort) 0))
      1)))
