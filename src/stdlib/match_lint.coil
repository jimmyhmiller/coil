(module coil.lint.match-else)
(import "coil.primitive" :as primitive)

; `match-else` → `match`.
;
; `match-else` was a library macro that faked a catch-all arm: it read the sum off the
; first arm by comptime reflection and expanded `(_ default)` into one explicit arm per
; uncovered variant, copying `default` into every one. `match` now understands `(_ …)`
; itself — the checker treats it as covering whatever the explicit arms left out, so the
; exhaustiveness rule is unchanged — which leaves the macro as pure indirection.
;
; The rewrite is therefore a head swap: same scrutinee, same arms, same order, same
; catch-all, and one copy of the default instead of one per uncovered variant.
;
;     coil lint FILE --use coil.lint.match-else          ; report + `help: try:` lines
;     coil lint FILE --use coil.lint.match-else --diff    ; the patch; writes nothing
;     coil lint FILE --use coil.lint.match-else --fix     ; apply it
;
; It runs BEFORE expansion. By the time an ordinary checker sees the program the macro
; call is gone and only the arms it generated are left — nothing to rewrite, and nothing
; to point a diagnostic at.

;; is `arm` the catch-all `(_ body…)`?
(defn me-wild-arm? [(arm Code)] (-> bool)
  (and (primitive/code-list? arm)
       (and (> (primitive/code-count arm) 1) (primitive/code-eq (primitive/code-nth arm 0) `_))))

;; `(match-else scrut arm… (_ default))` — the head, a scrutinee, and at least the
;; catch-all. Requiring the last arm to be `_` keeps the rule off anything that merely
;; borrows the name: only a form the macro itself would have accepted is one `match` can
;; take over unchanged.
(defn me-call? [(f Code)] (-> bool)
  (and (primitive/code-list? f)
       (and (> (primitive/code-count f) 2)
            (and (primitive/code-eq (primitive/code-nth f 0) `match-else)
                 (me-wild-arm? (primitive/code-nth f (primitive/isub (primitive/code-count f) 1)))))))

(defn me-walk [(f Code)] (-> Code)
  (if (primitive/code-list? f)
      (do
        (when (me-call? f)
          (primitive/suggest f
                             "`match` takes a `_` arm now — `match-else` is the old workaround"
                             `(match ~@(primitive/code-rest f)))
          0)
        (me-kids f 0 (primitive/code-count f)))
      `0))

(defn me-kids [(f Code) (i i64) (n i64)] (-> Code)
  (if (>= i n) `0 (do (me-walk (primitive/code-nth f i)) (me-kids f (primitive/iadd i 1) n))))

;; Does this module contain user source ANYWHERE? See the long note in
;; `modernize.coil`'s `mz-user-module?`: testing element 1 alone silently
;; disabled this checker for every module with an `import`, once the loader
;; began keeping import forms so metaprograms could see them.
(defn me-user-module? [(m Code) (i i64) (n i64)] (-> bool)
  (if (>= i n)
      false
      (if (primitive/code-from-user? (primitive/code-nth m i))
          true
          (me-user-module? m (primitive/iadd i 1) n))))

(defn me-module [(m Code)] (-> Code)
  (if (and (> (primitive/code-count m) 1) (me-user-module? m 1 (primitive/code-count m)))
      (me-module-forms m 1 (primitive/code-count m))
      `0))

(defn me-module-forms [(m Code) (i i64) (n i64)] (-> Code)
  (if (>= i n) `0 (do (me-walk (primitive/code-nth m i)) (me-module-forms m (primitive/iadd i 1) n))))

(defn me-modules [(modules Code) (i i64) (n i64)] (-> Code)
  (if (>= i n)
      `0
      (do (me-module (primitive/code-nth modules i)) (me-modules modules (primitive/iadd i 1) n))))

(defn lint-match-else [(modules Code)] (-> Code)
  (me-modules modules 0 (primitive/code-count modules)))

(checker lint-match-else :phase before-expand)
