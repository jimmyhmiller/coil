(module coil.lint.named-constructor)
(import "coil.primitive" :as primitive)

; Require positional aggregate constructors with at least three payload fields to
; use the named form. Struct construction is already named-only in the language;
; this checker catches the remaining positional surface: sum variants.

(defn nc-sum-construction? [(form Code)] (-> bool)
  (let [d (primitive/code-decl form)]
    (and (primitive/code-list? d)
         (and (= (primitive/code-count d) (primitive/cast i64 4))
              (primitive/code-eq (primitive/code-nth d 2) `sum)))))

(defn nc-positional-candidate? [(form Code)] (-> bool)
  (and (primitive/code-list? form)
       (and (>= (primitive/code-count form) (primitive/cast i64 4))
            (and (primitive/code-sym? (primitive/code-nth form 0))
                 (not (primitive/code-keyword? (primitive/code-nth form 1)))))))

; Reflection describes a generic sum by its declaration symbol, while type-of
; returns the instantiated spelling `(Result T E)`. Strip only that application
; layer; anything else is not a reflectable sum and must be ignored safely.
(defn nc-sum-type [(T Code)] (-> Code)
  (if (primitive/code-sym? T)
      T
      (if (and (primitive/code-list? T)
               (and (> (primitive/code-count T) 0)
                    (primitive/code-sym? (primitive/code-nth T 0))))
          (primitive/code-nth T 0)
          `:unknown)))

(defn nc-find-variant [(T Code) (qname Code) (i i64) (n i64)] (-> i64)
  (if (>= i n)
      -1
      (if (primitive/code-eq (primitive/code-variant-qname T i) qname)
          i
          (nc-find-variant T qname (+ i 1) n))))

(defn nc-pairs [(T Code) (vi i64) (form Code) (argi i64) (fi i64) (n i64)] (-> Code)
  (if (>= fi n)
      `()
      (let [keyword (primitive/code-symbol ":" (primitive/code-variant-field-name T vi fi))]
        `(~keyword ~(primitive/code-nth form argi)
          ~@(nc-pairs T vi form (+ argi 1) (+ fi 1) n)))))

(defn nc-replacement [(T Code) (vi i64) (form Code) (nf i64)] (-> Code)
  `(~(primitive/code-nth form 0) ~@(nc-pairs T vi form 1 0 nf)))

(defn nc-check [(form Code)] (-> bool)
  (if (and (nc-positional-candidate? form) (nc-sum-construction? form))
      (let [T (primitive/type-of form)
            sum-type (nc-sum-type T)
            d (primitive/code-decl form)
            vi (if (primitive/code-eq sum-type `:unknown)
                   -1
                   (nc-find-variant sum-type
                                    (primitive/code-nth d 3)
                                    0
                                    (primitive/code-variant-count sum-type)))]
        (if (< vi (primitive/cast i64 0))
            false
            (let [nf (primitive/code-variant-fields sum-type vi)]
              ; Count equality excludes already-named calls and explicit type-argument
              ; forms, whose type vector cannot simply be discarded by an autofix.
              (if (and (>= nf (primitive/cast i64 3))
                       (= (primitive/code-count form) (+ nf 1)))
                  (do
                    (primitive/suggest form
                                       "constructors with 3 or more fields must use named arguments"
                                       (nc-replacement sum-type vi form nf))
                    true)
                  false))))
      false))

(defn nc-walk [(form Code)] (-> Code)
  (if (primitive/code-list? form)
      (if (nc-check form) `0 (nc-kids form 0 (primitive/code-count form)))
      `0))

(defn nc-kids [(form Code) (i i64) (n i64)] (-> Code)
  (if (>= i n) `0 (do (nc-walk (primitive/code-nth form i)) (nc-kids form (+ i 1) n))))

(defn nc-user-module? [(m Code) (i i64) (n i64)] (-> bool)
  (if (>= i n)
      false
      (if (primitive/code-from-user? (primitive/code-nth m i)) true (nc-user-module? m (+ i 1) n))))

(defn nc-module [(m Code)] (-> Code)
  (if (nc-user-module? m 1 (primitive/code-count m))
      (nc-forms m 1 (primitive/code-count m))
      `0))

(defn nc-forms [(m Code) (i i64) (n i64)] (-> Code)
  (if (>= i n) `0 (do (nc-walk (primitive/code-nth m i)) (nc-forms m (+ i 1) n))))

(defn nc-modules [(modules Code) (i i64) (n i64)] (-> Code)
  (if (>= i n)
      `0
      (do (nc-module (primitive/code-nth modules i)) (nc-modules modules (+ i 1) n))))

(defn lint-named-constructors [(modules Code)] (-> Code)
  (nc-modules modules 0 (primitive/code-count modules)))

(checker lint-named-constructors)
