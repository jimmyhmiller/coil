(module coil.scratch)
(import "coil.primitive" :as primitive)
(import "coil.alloc" :as alloc)

; ScratchSegment is public because ScratchArena's layout names it.
(export ScratchArena ScratchMark ScratchSegment)

;;; An owned segmented bump allocator for request/turn/compiler-pass scratch memory.
;;; Individual free is deliberately a no-op; reset/close release whole segments.
(defstruct ScratchSegment
  [(previous (ptr ScratchSegment))
   (data (ptr i8))
   (cap i64)
   (off i64)
   ; Requested bytes, excluding alignment gaps. Segment offsets include padding
   ; and cannot be subtracted from the arena's requested-byte live counter.
   (live i64)])

(defstruct ScratchArena
  [(parent (dyn alloc/Allocator))
   (current (ptr ScratchSegment))
   (initial-cap i64)
   (closed bool)
   ; Monotonic bytes handed out (allocs + in-place growth), never decremented by
   ; reset/free. Two consumers: COIL_MTRACE=mem attributes per-metaprogram
   ; allocation by differencing it around each expansion, and the expansion
   ; budget (docs/design/META_MEMORY.md) enforces its cap against it.
   (total i64)
   ; Bytes currently reachable from allocations not discarded by reset/recycle.
   (live i64)
   ; Maximum live bytes since initialization or the last recycle.
   (peak i64)
   ; Monotonic backing-segment bytes requested from the parent. This differs
   ; from `total`: rewound pooled storage serves new allocations without
   ; increasing it.
   (reserved i64)])

(defstruct ScratchMark
  [(segment (ptr ScratchSegment))
   (off i64)
   (segment-live i64)])

;;; `x` rounded up to a multiple of `align`, a power of two (valid-request? holds
;;; every request to that), so a mask does it without a division.
(defn align-up [(x i64) (align i64)] (-> i64)
  (primitive/iand (primitive/iadd x (primitive/isub align 1))
                  (primitive/isub 0 align)))

(defn new-segment! [(arena (ptr ScratchArena)) (minimum i64)] (-> (Option (ptr ScratchSegment)))
  (let [current (load (field arena current))
        prior-cap
          (if (= (primitive/cast i64 current) 0)
              0
              (load (field current cap)))
        doubled
          (if (= prior-cap 0)
              (load (field arena initial-cap))
              (primitive/imul prior-cap 2))
        ; Geometric growth avoids tiny-segment churn, but doubling without a
        ; ceiling makes a long-lived compiler arena reserve 1 GiB, then 2 GiB,
        ; even when the next live allocation needs only a few MiB. Large single
        ; requests still get an exact-size segment through `minimum` below.
        grown (if (> doubled 16777216) 16777216 doubled)
        cap (if (> minimum grown) minimum grown)
        parent (load (field arena parent))]
    (match (alloc/alloc-bytes parent
                              (primitive/sizeof ScratchSegment)
                              (primitive/alignof ScratchSegment))
      (None [] (None))
      (Some [segment-storage]
            (let [segment
                    (primitive/cast (ptr ScratchSegment)
                                    (data segment-storage))]
              (match (alloc/alloc-bytes parent cap 16)
                (None []
                      (do
                        (alloc/free-bytes parent
                                          segment-storage
                                          (primitive/alignof ScratchSegment))
                        (None)))
                (Some [data]
                      (do
                        (store! (field segment previous) current)
                        (store! (field segment data)
                                (primitive/cast (ptr i8)
                                                (slice::data data)))
                        (store! (field segment cap) cap)
                        (store! (field segment off) 0)
                        (store! (field segment live) 0)
                        (store! (field arena current) segment)
                        (store! (field arena reserved)
                                (primitive/iadd (load (field arena reserved))
                                                cap))
                        (Some segment)))))))))

(defn bump [(arena (ptr ScratchArena)) (request alloc/AllocRequest)] (-> (Option (ptr i8)))
  (let [size (load (field request bytes))
        align (load (field request align))]
    (if (load (field arena closed))
        (None)
        (let [current (load (field arena current))]
          (if (= (primitive/cast i64 current) 0)
              (match (new-segment! arena (primitive/iadd size align))
                (None [] (None))
                (Some [_] (bump arena request)))
              (let [off (align-up (load (field current off)) align)
                    end (primitive/iadd off size)]
                (if (<= end (load (field current cap)))
                    (do
                      (store! (field current off) end)
                      (store! (field arena total)
                              (primitive/iadd (load (field arena total)) size))
                      (store! (field arena live)
                              (primitive/iadd (load (field arena live)) size))
                      (store! (field current live)
                              (primitive/iadd (load (field current live)) size))
                      (when (> (load (field arena live))
                               (load (field arena peak)))
                        (store! (field arena peak) (load (field arena live)))
                        0)
                      (Some (primitive/index (load (field current data)) off)))
                    (match (new-segment! arena
                                         (primitive/iadd size align))
                      (None [] (None))
                      (Some [_] (bump arena request))))))))))

(defn resize-in-place [(arena (ptr ScratchArena))
                       (data (ptr i8))
                       (old alloc/AllocRequest)
                       (new alloc/AllocRequest)] (-> bool)
  (let [old-size (load (field old bytes))
        new-size (load (field new bytes))]
    (if (load (field arena closed))
        false
        (let [current (load (field arena current))]
          (if (= (primitive/cast i64 current) 0)
              false
              (let [base (load (field current data))
                    start
                      (primitive/isub (primitive/cast i64 data)
                                      (primitive/cast i64 base))]
                (if (and (>= start 0)
                         (and (= (primitive/iadd start old-size)
                                 (load (field current off)))
                              (<= (primitive/iadd start new-size)
                                  (load (field current cap)))))
                    (do
                      (store! (field current off)
                              (primitive/iadd start new-size))
                      (when (> new-size old-size)
                        (store! (field arena total)
                                (primitive/iadd (load (field arena total))
                                                (primitive/isub new-size
                                                                old-size)))
                        0)
                      (store! (field arena live)
                              (primitive/iadd (load (field arena live))
                                              (primitive/isub new-size old-size)))
                      (store! (field current live)
                              (primitive/iadd (load (field current live))
                                              (primitive/isub new-size old-size)))
                      (when (> (load (field arena live))
                               (load (field arena peak)))
                        (store! (field arena peak) (load (field arena live)))
                        0)
                      true)
                    ; Any other block can SHRINK in place: individual free is a
                    ; no-op here, so the given-up tail is simply not reused (and
                    ; the live counters keep counting it, which only ever
                    ; overstates). Refusing would make `into-slice` copy into
                    ; a fresh block — pure growth in an arena.
                    (<= new-size old-size))))))))

(impl alloc/Allocator ScratchArena
  (allocate [(self (ptr ScratchArena)) (request (ref alloc/AllocRequest))]
            (-> (Option (ptr i8)))
            (bump self request))
  (resize [(self (ptr ScratchArena))
           (memory (ptr i8))
           (old (ref alloc/AllocRequest))
           (new (ref alloc/AllocRequest))]
          (-> bool)
          (resize-in-place self memory old new))
  (remap [(self (ptr ScratchArena))
          (memory (ptr i8))
          (old (ref alloc/AllocRequest))
          (new (ref alloc/AllocRequest))]
         (-> (Option (ptr i8)))
         (if (resize-in-place self memory old new) (Some memory) (None)))
  (deallocate [(self (ptr ScratchArena))
               (memory (ptr i8))
               (request (ref alloc/AllocRequest))]
              (-> i64)
              0))

;;; Initialize caller-owned storage with `ScratchArena::init` (or
;;; `init-with-capacity`), allocate through its `allocator`, and give memory back
;;; with `reset-to!` a `mark`, `reset!`, `recycle!` or `close!`.
(impl ScratchArena
  ;;; Initialize caller-owned state. `initial-cap` is clamped to 256 bytes so a zero or
  ;;; accidental tiny hint cannot create one backing allocation per small object.
  (init-with-capacity [(arena (ptr ScratchArena))
                       (parent (dyn alloc/Allocator))
                       (initial-cap i64)] (-> (ptr ScratchArena))
    (store! (field arena parent) parent)
    (store! (field arena current) (primitive/cast (ptr ScratchSegment) 0))
    (store! (field arena initial-cap) (if (< initial-cap 256) 256 initial-cap))
    (store! (field arena closed) false)
    (store! (field arena total) 0)
    (store! (field arena live) 0)
    (store! (field arena peak) 0)
    (store! (field arena reserved) 0)
    arena)

  (init [(arena (ptr ScratchArena))
         (parent (dyn alloc/Allocator))] (-> (ptr ScratchArena))
    (ScratchArena::init-with-capacity arena parent 4096))

  (allocator [(arena (ptr ScratchArena))] (-> (dyn alloc/Allocator))
    (primitive/make-dyn alloc/Allocator arena))

  ;;; Whether an address belongs to any live backing segment. Promotion boundaries
  ;;; use this to copy arena-owned containers while sharing already-persistent
  ;;; subtrees passed into a scratch computation.
  (owns-address? [(arena (ptr ScratchArena)) (p (ptr i8))] (-> bool)
    (let [address (primitive/cast i64 p)
          (mut segment) (load (field arena current))
          (mut found) false]
      (loop (if (= (primitive/cast i64 (load segment)) 0)
                (break)
                (let [base (primitive/cast i64 (load (field (load segment) data)))
                      end (primitive/iadd base (load (field (load segment) cap)))]
                  (if (and (>= address base) (< address end))
                      (do (store! found true) (break))
                      (store! segment (load (field (load segment) previous)))))))
      (load found)))

  (mark [(arena (ptr ScratchArena))] (-> ScratchMark)
    (let [mark (primitive/alloc-stack ScratchMark)
          segment (load (field arena current))]
      (store! (field mark segment) segment)
      (store! (field mark off)
              (if (= (primitive/cast i64 segment) 0) 0 (load (field segment off))))
      (store! (field mark segment-live)
              (if (= (primitive/cast i64 segment) 0)
                  0
                  (load (field segment live))))
      (load mark)))

  ;;; Release everything allocated after `mark`. Marks are arena-specific and become
  ;;; invalid when their segment is released by an earlier reset.
  (reset-to! [(arena (ptr ScratchArena)) (mark ScratchMark)] (-> i64)
    (unless (load (field arena closed))
      (let [target (load (field mark segment))]
        (loop (if (= (load (field arena current)) target)
                  (break)
                  (if (= (primitive/cast i64 (load (field arena current))) 0)
                      (break)
                      (release-current! arena))))
        (when (!= (primitive/cast i64 target) 0)
          (store! (field arena live)
                  (primitive/isub (load (field arena live))
                                  (primitive/isub (load (field target live))
                                                  (load (field mark segment-live)))))
          (store! (field target live) (load (field mark segment-live)))
          (store! (field target off) (load (field mark off))))))
    0)

  (reset! [(arena (ptr ScratchArena))] (-> i64)
    (unless (load (field arena closed))
      (loop (if (= (primitive/cast i64 (load (field arena current))) 0)
                (break)
                (release-current! arena))))
    0)

  ;;; Prepare a long-lived arena for reuse while retaining only its newest
  ;;; segment. Older growth segments are returned to the parent, bounding the
  ;;; retained pool to one high-water allocation.
  (recycle! [(arena (ptr ScratchArena))] (-> i64)
    (unless (load (field arena closed))
      (let [keep (load (field arena current))]
        (when (!= (primitive/cast i64 keep) 0)
          (store! (field arena current) (load (field keep previous)))
          (store! (field keep previous) (primitive/cast (ptr ScratchSegment) 0))
          (loop (if (= (primitive/cast i64 (load (field arena current))) 0)
                    (break)
                    (release-current! arena)))
          (store! (field keep off) 0)
          (store! (field keep live) 0)
          (store! (field arena current) keep)
          (store! (field arena live) 0)
          (store! (field arena peak) 0)
          0)))
    0)

  (close! [(arena (ptr ScratchArena))] (-> i64)
    (unless (load (field arena closed))
      (reset! arena)
      (store! (field arena closed) true))
    0)

  (closed? [(arena (ptr ScratchArena))] (-> bool)
    (load (field arena closed)))

  ;;; Monotonic bytes handed out over the arena's lifetime. Differencing this
  ;;; around a region of work attributes that region's allocation without any
  ;;; per-call wrapper; reset/close never decrease it.
  (total [(arena (ptr ScratchArena))] (-> i64)
    (load (field arena total)))

  ;;; Backing bytes currently reserved by live segments. Unlike `total`,
  ;;; this measures allocator pressure rather than bytes handed to callers.
  (capacity [(arena (ptr ScratchArena))] (-> i64)
    (let [(mut segment) (load (field arena current))
          (mut total) 0]
      (loop (if (= (primitive/cast i64 (load segment)) 0)
                (break)
                (do
                  (set! total
                        (primitive/iadd (load total)
                                        (load (field (load segment) cap))))
                  (set! segment (load (field (load segment) previous))))))
      (load total)))

  (reserved-total [(arena (ptr ScratchArena))] (-> i64)
    (load (field arena reserved)))

  (live [(arena (ptr ScratchArena))] (-> i64)
    (load (field arena live)))

  (peak [(arena (ptr ScratchArena))] (-> i64)
    (load (field arena peak))))

(defn release-current! [(arena (ptr ScratchArena))] (-> i64)
  (let [segment (load (field arena current))]
    (when (!= (primitive/cast i64 segment) 0)
      (store! (field arena live)
              (primitive/isub (load (field arena live))
                              (load (field segment live))))
      (store! (field arena current) (load (field segment previous)))
      (alloc/free-bytes (load (field arena parent))
                        (slice::new (primitive/cast (ptr u8)
                                                    (load (field segment
                                                                 data)))
                                    (load (field segment cap)))
                        16)
      (alloc/free-bytes (load (field arena parent))
                        (slice::new (primitive/cast (ptr u8) segment)
                                    (primitive/sizeof ScratchSegment))
                        (primitive/alignof ScratchSegment)))
    0))
