(module coil.brainfuck.runtime)

(import "coil.primitive" :as primitive)
(import "coil.alloc" :as alloc)
(import "coil.mem" :use [mem-zero])
(import "coil.slice" :use [slice-len slice-get])

(extern putchar :cc c [i32] (-> i32))
(extern getchar :cc c [] (-> i32))

(defn bf-byte [(program (slice u8)) (i i64)] (-> i64)
  (primitive/cast i64 (slice-get program i)))

;; Find the instruction after the `]` paired with the `[` at `pc`.
(defn bf-skip-forward [(program (slice u8)) (pc i64)] (-> i64)
  (let [n (slice-len program) (mut i) (+ pc 1) (mut depth) 1]
    (loop
      (if (>= (load i) n) (break)
        (let [op (bf-byte program (load i))]
          (if (= op #\[) (store! depth (+ (load depth) 1))
            (when (= op #\]) (store! depth (- (load depth) 1)) 0))
          (store! i (+ (load i) 1))
          (when (= (load depth) 0) (break) 0))))
    (if (= (load depth) 0) (load i) -1)))

;; Find the instruction after the `[` paired with the `]` at `pc`.
(defn bf-skip-backward [(program (slice u8)) (pc i64)] (-> i64)
  (let [(mut i) (- pc 1) (mut depth) 1]
    (loop
      (if (< (load i) 0) (break)
        (let [op (bf-byte program (load i))]
          (if (= op #\]) (store! depth (+ (load depth) 1))
            (when (= op #\[) (store! depth (- (load depth) 1)) 0))
          (if (= (load depth) 0) (break)
            (store! i (- (load i) 1))))))
    (if (= (load depth) 0) (+ (load i) 1) -1)))

;; Reject unbalanced brackets before execution, including unmatched brackets in
;; branches that the program never happens to enter.
(defn bf-validate [(program (slice u8))] (-> i64)
  (let [n (slice-len program) (mut i) 0 (mut depth) 0 (mut status) 0]
    (loop
      (if (or (>= (load i) n) (!= (load status) 0)) (break)
        (let [op (bf-byte program (load i))]
          (if (= op #\[) (store! depth (+ (load depth) 1))
            (when (= op #\])
              (if (= (load depth) 0) (store! status 5)
                (store! depth (- (load depth) 1)))
              0))
          (store! i (+ (load i) 1)))))
    (if (!= (load status) 0) (load status)
      (if (= (load depth) 0) 0 4))))

;; Execute raw Brainfuck as native Coil code. Non-command bytes are comments.
;; Returns nonzero for an unmatched bracket or tape-pointer under/overflow.
(defn run [(program (slice u8))] (-> i64)
  (let [(mut status) (bf-validate program)
        tape (alloc/stack (array u8 30000))
        cells (primitive/cast (ptr u8) tape)
        _zero (mem-zero [u8] cells 30000)
        n (slice-len program)
        (mut pc) 0
        (mut dp) 0]
    (loop
      (if (or (>= (load pc) n) (!= (load status) 0)) (break)
        (let [op (bf-byte program (load pc))
              cell (primitive/index cells (load dp))]
          (cond (= op #\>)
                  (if (= (load dp) 29999) (store! status 2)
                    (store! dp (+ (load dp) 1)))
                (= op #\<)
                  (if (= (load dp) 0) (store! status 3)
                    (store! dp (- (load dp) 1)))
                (= op #\+)
                  (store! cell (primitive/cast u8 (+ (primitive/cast i64 (load cell)) 1)))
                (= op #\-)
                  (store! cell (primitive/cast u8 (- (primitive/cast i64 (load cell)) 1)))
                (= op #\.) (do (putchar (primitive/cast i32 (load cell))) 0)
                (= op #\,)
                  (let [c (getchar)]
                    (store! cell (if (< c 0) 0 (primitive/cast u8 c))))
                (= op #\[)
                  (when (= (load cell) (primitive/cast u8 0))
                    (let [next (bf-skip-forward program (load pc))]
                      (if (< next 0) (store! status 4)
                        (store! pc (- next 1))))
                    0)
                (= op #\])
                  (when (!= (load cell) (primitive/cast u8 0))
                    (let [next (bf-skip-backward program (load pc))]
                      (if (< next 0) (store! status 5)
                        (store! pc (- next 1))))
                    0)
                :else 0)
          (store! pc (+ (load pc) 1)))))
    (load status)))

(export run)
