(module coil.modernize)
(import "coil.primitive" :as primitive)

; Project-default modernization lint. These rewrites preserve types and evaluation
; order: integer Eq/Ord is implemented for every width, and load/store!/field are
; direct coil.core aliases of the same lowering operations.
(defn mz-head? [(f Code) (name Code)] (-> bool)
  (and (primitive/code-list? f)
       (and (not (primitive/code-vector? f))
            (and (> (primitive/code-count f) 0)
                 (primitive/code-eq (primitive/code-nth f 0) name)))))

; A metal comparison contextually types integer literals to the other operand's
; width. Trait dispatch happens before that coercion, so preserve the inferred width
; explicitly when translating `icmp-*` to a clean operator.
(defn mz-cmp-arg [(arg Code) (other Code)] (-> Code)
  (let [ty (primitive/type-of other)]
    (if (and (primitive/code-int? arg) (not (primitive/code-eq ty `:unknown)))
        `(primitive/cast ~ty ~arg)
        arg)))

(defn mz-left [(f Code)] (-> Code)
  (mz-cmp-arg (primitive/code-nth f 1) (primitive/code-nth f 2)))
(defn mz-right [(f Code)] (-> Code)
  (mz-cmp-arg (primitive/code-nth f 2) (primitive/code-nth f 1)))

(defn mz-replacement [(f Code)] (-> Code)
  (cond (mz-head? f `primitive/icmp-eq) `(= ~(mz-left f) ~(mz-right f))
        (mz-head? f `primitive/icmp-ne) `(!= ~(mz-left f) ~(mz-right f))
        (mz-head? f `primitive/icmp-lt) `(< ~(mz-left f) ~(mz-right f))
        (mz-head? f `primitive/icmp-le) `(<= ~(mz-left f) ~(mz-right f))
        (mz-head? f `primitive/icmp-gt) `(> ~(mz-left f) ~(mz-right f))
        (mz-head? f `primitive/icmp-ge) `(>= ~(mz-left f) ~(mz-right f))
        ; `str-eq` is a redundant spelling of `=`: coil.str defines
        ; `(impl Eq (slice u8))`, and a trait impl is visible wherever its module is
        ; loaded — so `(= "a" "a")` compiles with NO import at all. `str-eq` only
        ; accepts `(slice u8)`, so the rewrite is always type-preserving.
        ;
        ; NOT rewritten inside coil.str itself: the Eq impl there is DEFINED as
        ; `(str-eq a b)`, so rewriting it would make `=` call itself forever. The
        ; `code-from-user?` guard in `mz-module` keeps the checker off bundled
        ; stdlib text, which is what makes that safe.
        (mz-head? f `str-eq) `(= ~(primitive/code-nth f 1) ~(primitive/code-nth f 2))
        :else `0))

; These names were briefly auto-referred from coil.core. Static storage is now an
; explicitly low-level primitive; stack storage needs the whole-expression migration
; below, and heap ownership needs box/typed allocation rather than a token rewrite.
(defn mz-ambient-replacement [(f Code)] (-> Code)
  (cond (mz-alloc-head? f `static) `(primitive/alloc-static ~(primitive/code-nth f 1))
        (mz-head? f `iand) `(primitive/iand ~(primitive/code-nth f 1) ~(primitive/code-nth f 2))
        (mz-head? f `ior) `(primitive/ior ~(primitive/code-nth f 1) ~(primitive/code-nth f 2))
        (mz-head? f `ixor) `(primitive/ixor ~(primitive/code-nth f 1) ~(primitive/code-nth f 2))
        (mz-head? f `ishl) `(primitive/ishl ~(primitive/code-nth f 1) ~(primitive/code-nth f 2))
        (mz-head? f `ishr) `(primitive/ishr ~(primitive/code-nth f 1) ~(primitive/code-nth f 2))
        (mz-head? f `udiv) `(primitive/udiv ~(primitive/code-nth f 1) ~(primitive/code-nth f 2))
        (mz-head? f `urem) `(primitive/urem ~(primitive/code-nth f 1) ~(primitive/code-nth f 2))
        (mz-head? f `fcmp-eq) `(primitive/fcmp-eq ~(primitive/code-nth f 1) ~(primitive/code-nth f 2))
        (mz-head? f `fcmp-ne) `(primitive/fcmp-ne ~(primitive/code-nth f 1) ~(primitive/code-nth f 2))
        (mz-head? f `fcmp-lt) `(primitive/fcmp-lt ~(primitive/code-nth f 1) ~(primitive/code-nth f 2))
        (mz-head? f `fcmp-le) `(primitive/fcmp-le ~(primitive/code-nth f 1) ~(primitive/code-nth f 2))
        (mz-head? f `fcmp-gt) `(primitive/fcmp-gt ~(primitive/code-nth f 1) ~(primitive/code-nth f 2))
        (mz-head? f `fcmp-ge) `(primitive/fcmp-ge ~(primitive/code-nth f 1) ~(primitive/code-nth f 2))
        :else `0))

; `(stack T)` / `(static T)` / `(heap T)` take exactly ONE argument, so a form with
; any other arity is not the ambient allocator being called and must not be rewritten.
; Without this, `(heap)` — an ordinary zero-arg call to a function someone named
; `heap` — was rewritten to `(alloc/heap u8)`, silently turning a bump-arena base
; address into a fresh one-byte allocation and SIGBUS-ing at run time
; (src/experiments/gc-dialect/arena.coil).
(defn mz-alloc-head? [(f Code) (name Code)] (-> bool)
  (and (mz-head? f name) (= (primitive/code-count f) (cast i64 2))))

(defn mz-ambient? [(f Code)] (-> bool)
  (or (mz-alloc-head? f `static)
      (or (mz-head? f `iand)
      (mz-head? f `ior)
      (mz-head? f `ixor)
      (mz-head? f `ishl)
      (mz-head? f `ishr)
      (mz-head? f `udiv)
      (mz-head? f `urem)
      (mz-head? f `fcmp-eq)
      (mz-head? f `fcmp-ne)
      (mz-head? f `fcmp-lt)
      (mz-head? f `fcmp-le)
      (mz-head? f `fcmp-gt)
      (mz-head? f `fcmp-ge))))

(defn mz-message [(f Code)] (-> (slice u8))
  (cond (mz-head? f `str-eq) "strings compare with `=` — coil.str implements Eq for (slice u8)"
        :else "use the clean integer comparison operator"))

(defn mz-fixable? [(f Code)] (-> bool)
  (or (mz-head? f `str-eq)
      (or (mz-head? f `primitive/icmp-eq)
          (or (mz-head? f `primitive/icmp-ne)
              (or (mz-head? f `primitive/icmp-lt)
                  (or (mz-head? f `primitive/icmp-le)
                      (or (mz-head? f `primitive/icmp-gt)
                          (mz-head? f `primitive/icmp-ge))))))))

; Serde's original four derive entry points were replaced by the registry-backed
; `(derive Trait... Type)` form. Keep this migration in the default lint profile:
; otherwise an old derive is unknown during lint's post-fix validation, which makes
; the transactional fixer roll back the repair that would have made it valid.
(defn mz-legacy-derive? [(f Code)] (-> bool)
  (and (primitive/code-list? f)
       (and (>= (primitive/code-count f) (cast i64 2))
            (or (mz-head? f `derive-serde)
                (or (mz-head? f `derive-serde-sum)
                    (or (mz-head? f `derive-serialize)
                        (mz-head? f `derive-deserialize)))))))

;; A growable Code list, not `(~x ~@(self …)): re-splicing the recursion's
;; result copies the suffix at every level — quadratic in the tail length
;; (docs/design/META_MEMORY.md).
(defn mz-code-tail [(f Code) (i i64) (n i64)] (-> Code)
  (let [out (primitive/code-list-new)
        (mut k) i]
    (loop (if (>= (load k) n)
              (break)
              (do (primitive/code-list-push! out (primitive/code-nth f (load k)))
                  (store! k (primitive/iadd (load k) 1)))))
    (primitive/code-list-done out)))

(defn mz-trait-spec [(trait Code) (f Code)] (-> Code)
  (let [n (primitive/code-count f)]
    (if (= n (cast i64 2)) trait `(~trait ~@(mz-code-tail f 2 n)))))

(defn mz-derive-replacement [(f Code)] (-> Code)
  (let [target (primitive/code-nth f 1)]
    (cond (or (mz-head? f `derive-serde) (mz-head? f `derive-serde-sum))
            `(derive ~(mz-trait-spec `Serialize f) ~(mz-trait-spec `Deserialize f) ~target)
          (mz-head? f `derive-serialize) `(derive ~(mz-trait-spec `Serialize f) ~target)
          :else `(derive ~(mz-trait-spec `Deserialize f) ~target))))

; `in-impl` — we are somewhere inside an `(impl …)` form. The str-eq rule is
; suppressed there, because inside `(impl Eq (slice u8) (= [a b] … (str-eq a b)))`
; the `str-eq` IS the definition of `=`; rewriting it makes `=` call itself forever.
; `code-from-user?` alone is not enough: it excludes coil.str when it is loaded as a
; dependency, but not when someone runs `coil lint --fix src/stdlib/str.coil` directly.
; Every other rule still fires inside an impl.
; A `defstruct`/`defsum` body is a list of BINDERS — `(name Type)` pairs — not
; expressions, and this walk has no grammar knowledge to tell the two apart. It
; rewrote `(stack (array i64 16384))`, a field DECLARATION, into
; `(alloc/stack (array i64 16384))`, renaming the field to `alloc/stack` and breaking
; every `(field vm stack)` in the program (src/apps/clox, src/apps/chip8 — both
; shipped broken). Nothing inside these forms is ever modernizable, so do not descend.
(defn mz-binder-form? [(f Code)] (-> bool)
  (or (mz-head? f `defstruct) (mz-head? f `defsum)))

;; Safe storage-duration migration:
;;
;;   (let [p (alloc/stack T)] (store! p value) body...)
;;   -> (let [(mut p) value] body...)
;;
;; The first store must be unconditional and its value must not mention the still-
;; uninitialized slot. One rewrite per fixer round keeps binding identity and source
;; spans simple; the transactional fixer recompiles before applying the next one.
(defn mz-legacy-stack-call? [(f Code)] (-> bool)
  (and (primitive/code-list? f)
       (and (= (primitive/code-count f) 2)
            (or (mz-head? f `alloc/stack) (mz-head? f `coil.alloc/stack)))))

(defn mz-stack-call? [(f Code)] (-> bool)
  (or (mz-legacy-stack-call? f)
      (and (primitive/code-list? f)
           (and (= (primitive/code-count f) 2)
                (mz-head? f `primitive/alloc-stack)))))

(defn mz-allocator-ptr? [(f Code)] (-> bool)
  (and (mz-head? f `ptr)
       (and (= (primitive/code-count f) 2)
            (let [ty (primitive/code-nth f 1)]
              (or (primitive/code-eq ty `Allocator)
                  (or (primitive/code-eq ty `alloc/Allocator)
                      (or (primitive/code-eq ty `alloc.Allocator)
                          (or (primitive/code-eq ty `coil.alloc/Allocator)
                              (primitive/code-eq ty `coil.alloc.Allocator)))))))))

(defn mz-store? [(f Code)] (-> bool)
  (and (primitive/code-list? f)
       (and (= (primitive/code-count f) 3)
            (or (mz-head? f `set!)
                (or (mz-head? f `store!) (mz-head? f `primitive/store!))))))

(defn mz-mentions-binding? [(f Code) (target Code) (bid i64)] (-> bool)
  (if (primitive/code-sym? f)
      (or (and (!= bid 0) (= (primitive/binding-of f) bid))
          (primitive/code-eq f target))
      (if (primitive/code-list? f)
          (mz-kid-mentions-binding? f target bid 0 (primitive/code-count f))
          false)))

(defn mz-kid-mentions-binding? [(f Code) (target Code) (bid i64) (i i64) (n i64)] (-> bool)
  (if (>= i n)
      false
      (if (mz-mentions-binding? (primitive/code-nth f i) target bid)
          true
          (mz-kid-mentions-binding? f target bid (+ i 1) n))))

(defn mz-target-symbol? [(f Code) (target Code) (bid i64)] (-> bool)
  (and (primitive/code-sym? f)
       (if (!= bid 0)
           (= (primitive/binding-of f) bid)
           (primitive/code-eq f target))))

; A stack cell can become a mutable local only while every remaining use is a
; value read or write. Passing its address, casting it, indexing it, or taking a
; field requires real storage even when the first operation happened to initialize
; the cell. This check is intentionally conservative: uncertain syntax keeps the
; explicit primitive allocation.
(defn mz-local-uses-safe? [(f Code) (target Code) (bid i64)] (-> bool)
  (if (primitive/code-sym? f)
      (not (mz-target-symbol? f target bid))
      (if (primitive/code-list? f)
          (let [n (primitive/code-count f)]
            (if (and (= n 2)
                     (and (or (mz-head? f `load) (mz-head? f `primitive/load))
                          (mz-target-symbol? (primitive/code-nth f 1) target bid)))
                true
                (if (and (= n 3)
                         (and (mz-store? f)
                              (mz-target-symbol? (primitive/code-nth f 1) target bid)))
                    (mz-local-uses-safe? (primitive/code-nth f 2) target bid)
                    (mz-local-kids-safe? f target bid 0 n))))
          true)))

(defn mz-local-kids-safe? [(f Code) (target Code) (bid i64) (i i64) (n i64)] (-> bool)
  (if (>= i n)
      true
      (and (mz-local-uses-safe? (primitive/code-nth f i) target bid)
           (mz-local-kids-safe? f target bid (+ i 1) n))))

(defn mz-local-tail-safe? [(f Code) (target Code) (bid i64) (i i64) (n i64)] (-> bool)
  (if (>= i n)
      true
      (and (mz-local-uses-safe? (primitive/code-nth f i) target bid)
           (mz-local-tail-safe? f target bid (+ i 1) n))))

(defn mz-stack-binding-index [(binds Code) (i i64) (n i64)] (-> i64)
  (if (>= (+ i 1) n)
      -1
      (if (and (primitive/code-sym? (primitive/code-nth binds i))
               (mz-stack-call? (primitive/code-nth binds (+ i 1))))
          i
          (mz-stack-binding-index binds (+ i 2) n))))

(defn mz-rewritten-binds [(binds Code) (replace i64) (value Code)] (-> Code)
  (let [out (primitive/code-list-new)
        (mut i) 0
        n (primitive/code-count binds)]
    (loop (if (>= (load i) n)
              (break)
              (do
                (if (= (load i) replace)
                    (do (primitive/code-list-push! out `(mut ~(primitive/code-nth binds (load i))))
                        (primitive/code-list-push! out value))
                    (do (primitive/code-list-push! out (primitive/code-nth binds (load i)))
                        (primitive/code-list-push! out (primitive/code-nth binds (+ (load i) 1)))))
                (store! i (+ (load i) 2)))))
    (primitive/code-list-done out)))

(defn mz-walk [(f Code) (in-impl bool)] (-> Code)
  (let [stack-fix
          ; Unlike leaf suggestions, this intentionally targets the source `let`
          ; macro itself so the allocation and its initializing store can be
          ; replaced transactionally as one expression.
          (if (and (mz-head? f `let) (>= (primitive/code-count f) 4))
              (let [binds (primitive/code-nth f 1)]
                (if (primitive/code-vector? binds)
                    (let [bi (mz-stack-binding-index binds 0 (primitive/code-count binds))
                          first (primitive/code-nth f 2)]
                      (if (>= bi 0)
                          (let [target (primitive/code-nth binds bi)
                                bid (primitive/binding-of target)]
                            (if (mz-store? first)
                                (let [value (primitive/code-nth first 2)]
                                  (if (and (primitive/code-sym? (primitive/code-nth first 1))
                                           (and (or (= (primitive/binding-of (primitive/code-nth first 1)) bid)
                                                    (primitive/code-eq
                                                      (primitive/code-nth first 1)
                                                      target))
                                                (and (not (mz-head? (primitive/type-of value) `ptr))
                                                     (and (primitive/code-int? value)
                                                          (and (not (mz-mentions-binding? value target bid))
                                                               (mz-local-tail-safe?
                                                                 f
                                                                 target
                                                                 bid
                                                                 3
                                                                 (primitive/code-count f)))))))
                                      (do
                                        (primitive/suggest
                                          f
                                          "initialized stack storage is a mutable local"
                                          `(let [~@(mz-rewritten-binds binds bi value)]
                                             ~@(mz-code-tail f 3 (primitive/code-count f))))
                                        true)
                                      false))
                                false))
                          false))
                    false))
              false)]
  (if (and (primitive/code-list? f) (not (mz-binder-form? f)))
      (do
        (when (and (not (primitive/code-macro? f)) (mz-ambient? f))
          (primitive/suggest f
                             "qualify the operation from its owning module"
                             (mz-ambient-replacement f))
          0)
        (when (and (not (primitive/code-macro? f))
                   (and (mz-fixable? f)
                        (not (and in-impl (mz-head? f `str-eq)))))
          (primitive/suggest f (mz-message f) (mz-replacement f))
          0)
        (when (mz-legacy-derive? f)
          (primitive/suggest f
                             "use the registry-backed derive form"
                             (mz-derive-replacement f))
          0)
        (when (mz-allocator-ptr? f)
          (primitive/suggest
            f
            "allocators are object-safe trait values"
            `(dyn ~(primitive/code-nth f 1)))
          0)
        (if stack-fix
            `0
            (do
              (when (and (primitive/code-from-user? f) (mz-legacy-stack-call? f))
                (primitive/suggest
                  f
                  "legacy alloc/stack could not be migrated to an initialized local safely; preserve it only as explicit unsafe primitive storage"
                  `(primitive/alloc-stack ~(primitive/code-nth f 1)))
                0)
              (mz-kids f 0 (primitive/code-count f) (or in-impl (mz-head? f `impl))))))
      `0)))

(defn mz-kids [(f Code) (i i64) (n i64) (in-impl bool)] (-> Code)
  (if (>= i n)
      `0
      (do
        (mz-walk (primitive/code-nth f i) in-impl)
        (mz-kids f (primitive/iadd i 1) n in-impl))))

;; Is any form in this module the user's own source? Modules assembled from the
;; stdlib carry no user forms and must not be linted; the user's module must be.
;;
;; ⚠ THIS ASKS ABOUT THE WHOLE MODULE, NOT ABOUT FORM 1, AND THAT IS THE POINT.
;; It used to test `(code-from-user? (code-nth m 1))` — element 1 alone, on the
;; assumption that the first form after the module name is user code. That
;; assumption was true only because the loader CONSUMED `import` forms and
;; dropped them.
;;
;; Once the loader started keeping imports so metaprograms could see them, form 1
;; of a module that imports anything became the `(import …)` — which is not user
;; source — so this returned false and the ENTIRE module was skipped. Every
;; checker finding vanished for any file with an import, which is nearly every
;; file. `coil lint --fix` then reported success and changed nothing: no
;; diagnostics, exit 0, byte-identical file.
;;
;; That silent-success shape is the worst failure mode a linter has, so the test
;; is now positional-independent. A module qualifies if it contains user source
;; ANYWHERE, which is what the question was always meant to be.
(defn mz-user-module? [(m Code) (i i64) (n i64)] (-> bool)
  (if (>= i n)
      false
      (if (primitive/code-from-user? (primitive/code-nth m i))
          true
          (mz-user-module? m (primitive/iadd i 1) n))))

(defn mz-module [(m Code)] (-> Code)
  (if (and (> (primitive/code-count m) 1)
           (mz-user-module? m 1 (primitive/code-count m)))
      (mz-module-forms m 1 (primitive/code-count m))
      `0))

(defn mz-module-forms [(m Code) (i i64) (n i64)] (-> Code)
  (if (>= i n)
      `0
      (do (mz-walk (primitive/code-nth m i) false) (mz-module-forms m (primitive/iadd i 1) n))))

(defn mz-modules [(modules Code) (i i64) (n i64)] (-> Code)
  (if (>= i n)
      `0
      (do
        (mz-module (primitive/code-nth modules i))
        (mz-modules modules (primitive/iadd i 1) n))))

(defn modernize-core-ops [(modules Code)] (-> Code)
  (mz-modules modules 0 (primitive/code-count modules)))

(checker modernize-core-ops)
