(module coil.selectors)
(import "coil.primitive" :as primitive)
(import "coil.alloc" :as alloc)
(import "coil.slice" :use [slice-data slice-len slice-get])
(import "coil.os" :as os)
(import "coil.time" :as time)

(export Interest
        ReadyEvents
        SelectorError
        Timeout
        InvalidFd
        Syscall
        interest-readable
        interest-writable
        interest-read-write
        Watch
        Selection
        watch
        wait-many
        wait-many-for
        wait-many-until
        wait-fd
        wait-fd-for
        wait-fd-until)

;;; Combinable readiness interests. Construct with the helpers below rather than relying
;;; on libc's private numeric event values.
(defstruct Interest [(readable bool) (writable bool)])

;;; Advisory readiness reported by the host. Hangup is separate from readable, although
;;; callers should normally attempt a read after either to observe buffered data or EOF.
(defstruct ReadyEvents
  [(readable bool)
   (writable bool)
   (hangup bool)
   (error bool)])

(defsum SelectorError
  (Timeout)
  (InvalidFd)
  (Syscall [(code i64)]))

(defstruct PollFd [(fd i32) (events i16) (revents i16)])

(extern poll :cc c [(ptr PollFd) u64 i32] (-> i32))

;;; One selectable descriptor and its caller-defined token. A Selection returns both
;;; the stable input index and token, avoiding descriptor-to-owner reconstruction.
(defstruct Watch [(fd i32) (interest Interest) (token i64)])

(defstruct Selection [(index i64) (token i64) (ready ReadyEvents)])

(defn watch [(fd i32) (interest Interest) (token i64)] (-> Watch)
  (let [out (primitive/alloc-stack Watch)]
    (store! (field out fd) fd)
    (store! (field out interest) interest)
    (store! (field out token) token)
    (load out)))

(defn selection-make [(index i64) (item Watch) (flags i64)] (-> Selection)
  (let [out (primitive/alloc-stack Selection)]
    (store! (field out index) index)
    (store! (field out token) (load (field item token)))
    (store! (field out ready) (ready-make flags))
    (load out)))

(defn wait-many-poll [(a (dyn alloc/Allocator)) (watches (slice Watch)) (timeout-ms i32)] (-> (Result Selection
                                                                                                      SelectorError))
  (let [count (slice-len watches)]
    (if (= count 0)
        (Err (InvalidFd))
        (match (alloc/alloc [PollFd] a count)
          (None [] (Err (Syscall 12)))
          (Some [entries]
                (let [entries-data (slice-data entries)
                      (mut i) 0]
                  (loop (if (>= (load i) count)
                            (break)
                            (let [item (slice-get watches (load i))
                                  entry (primitive/index entries-data (load i))]
                              (store! (field entry fd) (load (field item fd)))
                              (store! (field entry events) (interest-flags (load (field item interest))))
                              (store! (field entry revents) 0)
                              (store! i (+ (load i) 1)))))
                  (let [rc (poll entries-data (primitive/cast u64 count) timeout-ms)]
                    (if (< rc 0)
                        (do
                          (alloc/free [PollFd] a entries)
                          (Err (Syscall (os/os-errno))))
                        (if (= rc 0)
                            (do
                              (alloc/free [PollFd] a entries)
                              (Err (Timeout)))
                            (block :done
                                   (store! i 0)
                                   (loop (if (>= (load i) count)
                                             (break)
                                             (let [flags
                                                     (primitive/cast i64
                                                                     (load (field (primitive/index entries-data
                                                                                                   (load i))
                                                                                  revents)))]
                                               (if (!= flags 0)
                                                   (let [item (slice-get watches (load i))]
                                                     (alloc/free [PollFd] a entries)
                                                     (if (!= (& flags 32) 0)
                                                         (return-from :done (Err (InvalidFd)))
                                                         (return-from :done (Ok (selection-make (load i) item flags)))))
                                                   (store! i (+ (load i) 1))))))
                                   (alloc/free [PollFd] a entries)
                                   (Err (InvalidFd))))))))))))

;;; Wait for any descriptor. EINTR retries without changing an absolute deadline.
(defn wait-many [(a (dyn alloc/Allocator)) (watches (slice Watch))] (-> (Result Selection SelectorError))
  (block :done
           (loop (match (wait-many-poll a watches -1)
                   (Ok [selected] (return-from :done (Ok selected)))
                   (Err [error]
                        (match error
                          (Syscall [code] (if (= code 4) 0 (return-from :done (Err error))))
                          (Timeout [] (return-from :done (Err error)))
                          (InvalidFd [] (return-from :done (Err error)))))))))

(defn wait-many-until [(a (dyn alloc/Allocator)) (watches (slice Watch)) (deadline time/Instant)] (-> (Result Selection
                                                                                                              SelectorError))
  (block :done
           (loop (match (time/deadline-remaining deadline)
                   (Err [error] (return-from :done (Err (Syscall (time/time-error-code error)))))
                   (Ok [remaining]
                       (match (wait-many-poll a watches (duration-timeout-ms remaining))
                         (Ok [selected] (return-from :done (Ok selected)))
                         (Err [error]
                              (match error
                                (Syscall [code] (if (= code 4) 0 (return-from :done (Err error))))
                                (Timeout [] (return-from :done (Err error)))
                                (InvalidFd [] (return-from :done (Err error)))))))))))

(defn wait-many-for [(a (dyn alloc/Allocator)) (watches (slice Watch)) (duration time/Duration)] (-> (Result Selection
                                                                                                             SelectorError))
  (match (time/deadline-after duration)
    (Err [error] (Err (Syscall (time/time-error-code error))))
    (Ok [deadline] (wait-many-until a watches deadline))))

(defn interest-make [(readable bool) (writable bool)] (-> Interest)
  (let [out (primitive/alloc-stack Interest)]
    (store! (field out readable) readable)
    (store! (field out writable) writable)
    (load out)))

;;; Wait for read readiness.
(defn interest-readable [] (-> Interest)
  (interest-make true false))

;;; Wait for write readiness.
(defn interest-writable [] (-> Interest)
  (interest-make false true))

;;; Wait for either read or write readiness.
(defn interest-read-write [] (-> Interest)
  (interest-make true true))

(defn ready-make [(flags i64)] (-> ReadyEvents)
  (let [out (primitive/alloc-stack ReadyEvents)]
    (store! (field out readable) (!= (& flags 1) 0))
    (store! (field out writable) (!= (& flags 4) 0))
    (store! (field out error) (!= (& flags 8) 0))
    (store! (field out hangup) (!= (& flags 16) 0))
    (load out)))

(defn interest-flags [(interest Interest)] (-> i16)
  (primitive/cast i16
                  (| (if (load (field interest readable)) 1 0)
                     (if (load (field interest writable)) 4 0))))

(defn duration-timeout-ms [(duration time/Duration)] (-> i32)
  (let [sec (load (field duration sec))
        nsec (load (field duration nsec))]
    (if (> sec 2147483)
        2147483647
        (primitive/cast i32 (+ (* sec 1000) (/ (+ nsec 999999) 1000000))))))

(defn wait-poll [(fd i32) (interest Interest) (timeout-ms i32)] (-> (Result ReadyEvents SelectorError))
  (let [entry (primitive/alloc-stack PollFd)]
    (store! (field entry fd) fd)
    (store! (field entry events) (interest-flags interest))
    (store! (field entry revents) 0)
    (let [rc (poll entry 1 timeout-ms)]
      (if (< rc 0)
          (Err (Syscall (os/os-errno)))
          (if (= rc 0)
              (Err (Timeout))
              (let [flags (primitive/cast i64 (load (field entry revents)))]
                (if (!= (& flags 32) 0)
                    (Err (InvalidFd))
                    (Ok (ready-make flags)))))))))

;;; Wait indefinitely for readiness. Signals are retried.
(defn wait-fd [(fd i32) (interest Interest)] (-> (Result ReadyEvents SelectorError))
  (block :done
           (loop (match (wait-poll fd interest -1)
                   (Ok [ready] (return-from :done (Ok ready)))
                   (Err [error]
                        (match error
                          (Syscall [code] (if (= code 4) 0 (return-from :done (Err error))))
                          (Timeout [] 0)
                          (InvalidFd [] (return-from :done (Err error)))))))))

;;; Wait until an absolute monotonic deadline. EINTR recomputes from that same deadline,
;;; so repeated signals cannot extend the timeout.
(defn wait-fd-until [(fd i32) (interest Interest) (deadline time/Instant)] (-> (Result ReadyEvents SelectorError))
  (block :done
           (loop (match (time/deadline-remaining deadline)
                   (Err [error] (return-from :done (Err (Syscall (time/time-error-code error)))))
                   (Ok [remaining]
                       (match (wait-poll fd interest (duration-timeout-ms remaining))
                         (Ok [ready] (return-from :done (Ok ready)))
                         (Err [error]
                              (match error
                                (Syscall [code] (if (= code 4) 0 (return-from :done (Err error))))
                                (Timeout [] (return-from :done (Err error)))
                                (InvalidFd [] (return-from :done (Err error)))))))))))

;;; Wait for readiness for a relative duration.
(defn wait-fd-for [(fd i32) (interest Interest) (duration time/Duration)] (-> (Result ReadyEvents SelectorError))
  (match (time/deadline-after duration)
    (Err [error] (Err (Syscall (time/time-error-code error))))
    (Ok [deadline] (wait-fd-until fd interest deadline))))
