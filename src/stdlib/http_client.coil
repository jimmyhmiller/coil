; Blocking outbound HTTP client backed by libcurl. The public surface keeps curl's
; variadic, option-number API private: callers provide typed Coil values and own the
; returned body through the allocator passed to `request`.
(module coil.http.client)
(import "coil.primitive" :as primitive)

(import "coil.alloc" :as alloc)
(import "coil.arraylist" :as arraylist)
(import "coil.cancellation" :as cancellation)
(import "coil.result" :use *)
(import "coil.slice" :as slice)
(import "coil.str" :as str)
(import "coil.mem" :as mem)

(export Header
        Request
        Response
        HttpError
        ; the variants too: an exported sum whose variants stay private cannot be
        ; matched on by the module that receives it, which is the only useful
        ; thing to do with an error value.
        InvalidRequest
        OutOfMemory
        Transport
        request
        response-free
        response-status
        response-body
        response-header-count
        response-header-at
        BodySink
        StreamingResponse
        request-stream
        request-stream-cancellable
        error-timeout?
        streaming-response-status
        streaming-response-stopped
        streaming-response-header-count
        streaming-response-header-at
        streaming-response-free
        BODY-CONTINUE
        BODY-STOP)

(extern curl_easy_init :cc c [] (-> (ptr i8)))
(extern curl_easy_cleanup :cc c [(ptr i8)] (-> void))
(extern curl_easy_perform :cc c [(ptr i8)] (-> i32))
(extern curl_easy_setopt :cc c [(ptr i8) i32 ...] (-> i32))
(extern curl_easy_getinfo :cc c [(ptr i8) i32 ...] (-> i32))
(extern curl_easy_strerror :cc c [i32] (-> (ptr i8)))
(extern curl_slist_append :cc c [(ptr i8) (ptr i8)] (-> (ptr i8)))
(extern curl_slist_free_all :cc c [(ptr i8)] (-> void))
(extern curl_multi_init :cc c [] (-> (ptr i8)))
(extern curl_multi_add_handle :cc c [(ptr i8) (ptr i8)] (-> i32))
(extern curl_multi_remove_handle :cc c [(ptr i8) (ptr i8)] (-> i32))
(extern curl_multi_perform :cc c [(ptr i8) (ptr i32)] (-> i32))
(extern curl_multi_poll :cc c [(ptr i8) (ptr i8) i32 i32 (ptr i32)] (-> i32))
(extern curl_multi_info_read :cc c [(ptr i8) (ptr i32)] (-> (ptr i8)))
(extern curl_multi_cleanup :cc c [(ptr i8)] (-> i32))

; Stable values from curl/curl.h. They are part of libcurl's public ABI. Keeping them
; here (behind typed helpers) prevents application code from depending on them.
(const CURLOPT_WRITEDATA 10001)
(const CURLOPT_URL 10002)
(const CURLOPT_WRITEFUNCTION 20011)
(const CURLOPT_POSTFIELDS 10015)
(const CURLOPT_HTTPHEADER 10023)
(const CURLOPT_CUSTOMREQUEST 10036)
(const CURLOPT_FOLLOWLOCATION 52)
(const CURLOPT_NOSIGNAL 99)
(const CURLOPT_POSTFIELDSIZE_LARGE 30120)
(const CURLOPT_TIMEOUT_MS 155)
(const CURLOPT_CONNECTTIMEOUT_MS 156)
(const CURLOPT_HEADERFUNCTION 20079)
(const CURLOPT_HEADERDATA 10029)
(const CURLOPT_NOPROGRESS 43)
(const CURLOPT_XFERINFODATA 10057)
(const CURLOPT_XFERINFOFUNCTION 20219)
(const CURLE_ABORTED_BY_CALLBACK 42)
(const CURLM_OK 0)
(const CURLMSG_DONE 1)
(const CURL_WAIT_POLLIN 1)
(const CURLINFO_RESPONSE_CODE 2097154)
; CURLE_OPERATION_TIMEDOUT — both the connect and the total timeout surface as this
; one code, which is what `error-timeout?` reads.
(const CURLE_OPERATION_TIMEDOUT 28)

;;; What a body consumer asks the transfer to do next: keep delivering, or stop.
(const BODY-CONTINUE 0)
(const BODY-STOP 1)

(defstruct Header [(name (slice u8)) (value (slice u8))])
(defstruct Request
  [(method (slice u8))
   (url (slice u8))
   (headers (slice Header))
   (body (slice u8))
   (connect-timeout-ms i64)
   (timeout-ms i64)
   (follow-redirects bool)])
(defstruct Response [(status i64) (headers (slice Header)) (body (slice u8))])

;;; A typed consumer for response-body bytes. `consume` is called with each chunk as it
;;; arrives, in order, with arbitrary boundaries — a UTF-8 scalar or a protocol record may
;;; be split across two calls, so a consumer that needs whole records must buffer them
;;; itself. It returns BODY-CONTINUE or BODY-STOP.
;;;
;;; The bytes are TRANSPORT-OWNED and valid only for the duration of the call: copy
;;; anything you need to keep. They never become part of the returned response.
;;;
;;; `context` is yours; `request-stream` passes it through untouched and does not retain
;;; it after returning.
(defstruct BodySink
  [(context (ptr i8))
   (consume (fnptr c [(ptr u8) i64 (ptr i8)] i64))])

;;; A streamed response: the status and headers, which are meaningful for every response
;;; including non-2xx, plus whether the consumer asked to stop early. The body is not here
;;; — it went to the sink.
(defstruct StreamingResponse
  [(status i64) (headers (slice Header)) (stopped bool)])

;;; The write-callback context. `stopped` is the discriminator that separates a deliberate
;;; consumer stop from a genuine transport failure: our trampoline is the only thing that
;;; ever short-counts, and it only does so after the sink said BODY-STOP.
(defstruct StreamState [(sink BodySink) (stopped bool)])
(defstruct CurlWaitFd [(fd i32) (events i16) (revents i16)])
(defstruct CurlMessage [(kind i32) (easy (ptr i8)) (result i32)])

(defstruct HeaderCapture
  [(a (dyn alloc/Allocator)) (headers (arraylist/ArrayList Header))])
(defsum HttpError
  (InvalidRequest)
  (OutOfMemory)
  (Transport [(code i64) (message (slice u8))]))

(defn curl-ok? [(code i32)] (-> bool)
  (= (primitive/cast i64 code) (cast i64 0)))
(defn curl-set-ptr [(easy (ptr i8)) (option i32) (value (ptr i8))] (-> i32)
  (curl_easy_setopt easy option value))
(defn curl-set-i64 [(easy (ptr i8)) (option i32) (value i64)] (-> i32)
  (curl_easy_setopt easy option value))
(defn curl-set-write-fn [(easy (ptr i8))
                         (value (fnptr c [(ptr i8) isize isize (ptr i8)] isize))] (-> i32)
  (curl_easy_setopt easy CURLOPT_WRITEFUNCTION value))
(defn curl-set-write-data [(easy (ptr i8)) (value (ptr i8))] (-> i32)
  (curl_easy_setopt easy CURLOPT_WRITEDATA value))
(defn curl-set-header-fn [(easy (ptr i8))
                          (value (fnptr c [(ptr i8) isize isize (ptr i8)] isize))] (-> i32)
  (curl_easy_setopt easy CURLOPT_HEADERFUNCTION value))
(defn curl-set-header-data [(easy (ptr i8)) (value (ptr HeaderCapture))] (-> i32)
  (curl_easy_setopt easy CURLOPT_HEADERDATA (primitive/cast (ptr i8) value)))

(defn curl-cancellation-progress [(context (ptr i8))
                                  (download-total i64)
                                  (download-now i64)
                                  (upload-total i64)
                                  (upload-now i64)] (-> i32)
  (if (cancellation/cancellation-requested? (primitive/cast (ptr cancellation/Cancellation) context))
      1
      0))

;;; Drive a cancellable easy handle through curl's poll-based multi interface.
;;; The cancellation pipe is an extra poll fd, so requesting cancellation wakes
;;; a transfer even when the network peer is completely silent.
(defn curl-perform-cancellable [(easy (ptr i8))
                                (cancel (ptr cancellation/Cancellation))] (-> i32)
  (let [multi (curl_multi_init)]
    (if (= (primitive/cast i64 multi) (cast i64 0))
        (cast i32 CURLE_ABORTED_BY_CALLBACK)
        (let [(mut running) (cast i32 0)
              (mut messages) (cast i32 0)
              (mut result) (cast i32 CURLE_ABORTED_BY_CALLBACK)
              wait-fd (primitive/alloc-stack CurlWaitFd)
              (mut ready) (cast i32 0)]
          (store! (field wait-fd fd) (load (field cancel read-fd)))
          (store! (field wait-fd events) (cast i16 CURL_WAIT_POLLIN))
          (store! (field wait-fd revents) (cast i16 0))
          (if (!= (curl_multi_add_handle multi easy) (cast i32 CURLM_OK))
              (store! running 0)
              (do
                (curl_multi_perform multi (mut running))
                (loop (if (<= (load running) 0)
                          (break)
                          (do
                            (curl_multi_poll multi
                                             (primitive/cast (ptr i8) wait-fd)
                                             1
                                             1000
                                             (mut ready))
                            (if (cancellation/cancellation-requested? cancel)
                                (break)
                                (curl_multi_perform multi (mut running))))))))
          (when (= (load running) 0)
            (let [message (primitive/cast (ptr CurlMessage)
                                          (curl_multi_info_read multi (mut messages)))]
              (when (and (!= (primitive/cast i64 message) (cast i64 0))
                         (= (load (field message kind)) (cast i32 CURLMSG_DONE)))
                (store! result (load (field message result)))
                0))
            0)
          (curl_multi_remove_handle multi easy)
          (curl_multi_cleanup multi)
          (load result)))))
(defn curl-response-code [(easy (ptr i8)) (value (ptr i64))] (-> i32)
  (curl_easy_getinfo easy CURLINFO_RESPONSE_CODE value))

(defn curl-cstr-len [(p (ptr i8))] (-> i64)
  (let [(mut n) 0]
    (loop (if (= (primitive/cast i64 (load (primitive/index p (load n)))) (cast i64 0))
              (break)
              (store! n (primitive/iadd (load n) 1))))
    (load n)))
(defn curl-cstr-slice [(p (ptr i8))] (-> (slice u8))
  (slice/slice-new [u8] (primitive/cast (ptr u8) p) (curl-cstr-len p)))

; curl's write callback: hand the chunk straight to the sink, no buffering.
;
; Returning a count other than the one curl offered is how a write callback aborts a
; transfer; curl then fails the perform with CURLE_WRITE_ERROR. That is the only way to
; stop a blocking transfer from inside the callback, so a consumer's BODY-STOP is
; delivered as a short count and remembered in `stopped`, which lets the caller tell a
; deliberate stop from a real write failure.
(defn curl-stream-body [(data (ptr i8)) (size isize) (count isize) (ctx (ptr i8))] (-> isize)
  (let [n (primitive/imul (primitive/cast i64 size) (primitive/cast i64 count))
        st (primitive/cast (ptr StreamState) ctx)]
    (if (or (load (field st stopped)) (= n (cast i64 0)))
        ; nothing to deliver, or we are already unwinding a stop
        (primitive/cast isize n)
        (let [consume (load (field (field st sink) consume))
              context (load (field (field st sink) context))]
          (if (= (primitive/call-ptr consume (primitive/cast (ptr u8) data) n context) BODY-STOP)
              (do (store! (field st stopped) true) (primitive/cast isize 0))
              (primitive/cast isize n))))))

; the sink `request` uses to rebuild its buffered body
(defn collect-body-chunk [(data (ptr u8)) (n i64) (ctx (ptr i8))] (-> i64)
  (let [out (primitive/cast (ptr (arraylist/ArrayList u8)) ctx)]
    (arraylist/al-extend! [u8] (mut out) data n)
    BODY-CONTINUE))

(defn owned-copy [(a (dyn alloc/Allocator)) (s (slice u8))] (-> (slice u8))
  (let [n (slice/slice-len s)]
    (if (= n (cast i64 0))
        (slice/slice-new [u8] (primitive/cast (ptr u8) 0) 0)
        (match (alloc/alloc [u8] a n)
          (None [] (slice/slice-new [u8] (primitive/cast (ptr u8) 0) 0))
          (Some [memory]
                (do
                  (mem/mem-copy [u8] (slice/slice-data memory) (slice/slice-data s) n)
                  memory))))))

(defn free-header! [(a (dyn alloc/Allocator)) (h Header)] (-> i64)
  (let [name (load (field h name))
        value (load (field h value))]
    (if (> (slice/slice-len name) (cast i64 0))
        (alloc/free [u8] a name)
        0)
    (if (> (slice/slice-len value) (cast i64 0))
        (alloc/free [u8] a value)
        0)))

(defn clear-captured-headers! [(capture (ptr HeaderCapture))] (-> i64)
  (let [(mut i) 0
        hs (load (field capture headers))]
    (loop (if (>= (load i) (arraylist/al-len [Header] hs))
              (break)
              (do
                (free-header! (load (field capture a)) (arraylist/al-get [Header] hs (load i)))
                (store! i (primitive/iadd (load i) 1)))))
    (arraylist/al-free! [Header] (mut (field capture headers)))
    (store! (field capture headers) (arraylist/al-new [Header] (load (field capture a))))
    0))

(defn curl-header-line [(data (ptr i8)) (size isize) (count isize) (ctx (ptr i8))] (-> isize)
  (let [n (primitive/imul (primitive/cast i64 size) (primitive/cast i64 count))
        capture (primitive/cast (ptr HeaderCapture) ctx)
        raw (slice/slice-new [u8] (primitive/cast (ptr u8) data) n)]
    ; A new status line begins the final-or-redirect response. Discard the prior
    ; block so Response.headers always describes the response whose status we return.
    (if (and (>= n (cast i64 5)) (str/str-eq (slice/subslice raw 0 5) "HTTP/"))
        (clear-captured-headers! capture)
        (let [(mut colon) -1
              (mut i) 0]
          (loop (if (>= (load i) n)
                    (break)
                    (if (= (primitive/cast i64 (slice/slice-get raw (load i))) (cast i64 58))
                        (do (store! colon (load i)) (break))
                        (store! i (primitive/iadd (load i) 1)))))
          (when (> (load colon) (cast i64 0))
            (let [(mut end) n
                  (mut start) (primitive/iadd (load colon) 1)]
              (loop (if (and (> (load end) (load start))
                             (or (= (primitive/cast i64 (slice/slice-get raw (primitive/isub (load end) 1)))
                                    (cast i64 13))
                                 (= (primitive/cast i64 (slice/slice-get raw (primitive/isub (load end) 1)))
                                    (cast i64 10))))
                        (store! end (primitive/isub (load end) 1))
                        (break)))
              (loop (if (and (< (load start) (load end))
                             (or (= (primitive/cast i64 (slice/slice-get raw (load start))) (cast i64 32))
                                 (= (primitive/cast i64 (slice/slice-get raw (load start))) (cast i64 9))))
                        (store! start (primitive/iadd (load start) 1))
                        (break)))
              (let [hp (primitive/alloc-stack Header)]
                (store! (field hp name) (owned-copy (load (field capture a)) (slice/subslice raw 0 (load colon))))
                (store! (field hp value)
                        (owned-copy (load (field capture a)) (slice/subslice raw (load start) (load end))))
                (arraylist/al-push! [Header] (mut (field capture headers)) (load hp)))))))
    (primitive/cast isize n)))

(defn append-header [(a (dyn alloc/Allocator)) (list (ptr i8)) (h Header)] (-> (ptr i8))
  (let [(mut b) (str/sb-new a)]
    (str/sb-push-str! (mut b) (load (field h name)))
    (str/sb-push-str! (mut b) ": ")
    (str/sb-push-str! (mut b) (load (field h value)))
    (let [line (str/sb-str b)
          c-line (str/str->cstr a line)
          appended (curl_slist_append list c-line)]
      (alloc/free-bytes a (slice/slice-new [u8] (primitive/cast (ptr u8) c-line) (primitive/iadd (slice/slice-len line) 1)) 1)
      (str/sb-free! (mut b))
      appended)))

(defn build-headers [(a (dyn alloc/Allocator)) (hs (slice Header))] (-> (ptr i8))
  (let [(mut list) (primitive/cast (ptr i8) 0)
        (mut i) 0]
    (loop (if (>= (load i) (slice/slice-len hs))
              (break)
              (do
                (store! list (append-header a (load list) (slice/slice-get hs (load i))))
                (store! i (primitive/iadd (load i) 1)))))
    (load list)))

(defn transport-error [(code i32)] (-> HttpError)
  (Transport (primitive/cast i64 code) (curl-cstr-slice (curl_easy_strerror code))))

;;; True when this error was a connect or total timeout rather than another transport
;;; failure. Both surface as one curl code, so the two timeouts are not distinguished from
;;; each other — the request's own `connect-timeout-ms`/`timeout-ms` say which applied.
;;;
;;; This is a predicate rather than a new `HttpError` variant on purpose: adding a variant
;;; would break every existing exhaustive `match` on `HttpError`.
(defn error-timeout? [(e HttpError)] (-> bool)
  (match e (Transport [code message] (= code CURLE_OPERATION_TIMEDOUT)) (_ false)))

;;; Perform one blocking request, delivering response-body bytes to `sink` as they arrive
;;; instead of buffering them. The returned `StreamingResponse` carries the status and
;;; headers — meaningful for every response, including non-2xx — and must be released with
;;; `streaming-response-free`.
;;;
;;; SYNCHRONOUS: the transfer runs on the calling thread and `sink.consume` is called from
;;; it, so the sink needs no locking and `request-stream` has not returned while the sink
;;; runs. A nested `request` or `request-stream` from inside the sink is permitted — each
;;; call allocates its own curl easy handle and this module keeps no shared state — but it
;;; blocks the outer transfer for its whole duration.
;;;
;;; The four failure modes stay distinguishable:
;;;   * consumer stop      -> `(Ok r)` with `streaming-response-stopped` true
;;;   * timeout            -> `(Err e)` with `error-timeout?` true
;;;   * allocation failure -> `(Err (OutOfMemory))`
;;;   * transport failure  -> `(Err (Transport code message))`
;;; An HTTP error status is not a failure: it is an `Ok` with that status.
(defn request-stream-cancellable [(a (dyn alloc/Allocator))
                                  (req (ptr Request))
                                  (sink BodySink)
                                  (cancel (ptr cancellation/Cancellation))] (-> (Result StreamingResponse HttpError))
  (let [easy (curl_easy_init)]
    (if (= (primitive/cast i64 easy) (cast i64 0))
        (Err (OutOfMemory))
        (let [st (primitive/alloc-stack StreamState)
              capture (primitive/alloc-stack HeaderCapture)
              url (str/str->cstr a (load (field req url)))
              method (str/str->cstr a (load (field req method)))
              hs (build-headers a (load (field req headers)))
              body (load (field req body))
              (mut code) 0]
          (store! (field st sink) sink)
          (store! (field st stopped) false)
          (store! (field capture a) a)
          (store! (field capture headers) (arraylist/al-new [Header] a))
          (curl-set-ptr easy CURLOPT_URL url)
          (curl-set-ptr easy CURLOPT_CUSTOMREQUEST method)
          (curl-set-ptr easy CURLOPT_HTTPHEADER hs)
          (curl-set-ptr easy CURLOPT_POSTFIELDS (primitive/cast (ptr i8) (slice/slice-data body)))
          (curl-set-i64 easy CURLOPT_POSTFIELDSIZE_LARGE (slice/slice-len body))
          (curl-set-write-fn easy (primitive/fnptr-of curl-stream-body))
          (curl-set-write-data easy (primitive/cast (ptr i8) st))
          (curl-set-header-fn easy (primitive/fnptr-of curl-header-line))
          (curl-set-header-data easy capture)
          (if (= cancel (primitive/cast (ptr cancellation/Cancellation) 0))
              0
              (do
                (curl-set-i64 easy CURLOPT_NOPROGRESS 0)
                (curl-set-ptr easy CURLOPT_XFERINFODATA (primitive/cast (ptr i8) cancel))
                (curl_easy_setopt easy
                                  CURLOPT_XFERINFOFUNCTION
                                  (primitive/fnptr-of curl-cancellation-progress))
                0))
          (curl-set-i64 easy CURLOPT_NOSIGNAL 1)
          (curl-set-i64 easy CURLOPT_FOLLOWLOCATION (if (load (field req follow-redirects)) 1 0))
          (curl-set-i64 easy CURLOPT_CONNECTTIMEOUT_MS (load (field req connect-timeout-ms)))
          (curl-set-i64 easy CURLOPT_TIMEOUT_MS (load (field req timeout-ms)))
          (let [performed (if (= cancel (primitive/cast (ptr cancellation/Cancellation) 0))
                              (curl_easy_perform easy)
                              (curl-perform-cancellable easy cancel))
                stopped (load (field st stopped))]
            (alloc/free-bytes a (slice/slice-new [u8] (primitive/cast (ptr u8) url) (primitive/iadd (slice/slice-len (load (field req url))) 1)) 1)
            (alloc/free-bytes a (slice/slice-new [u8] (primitive/cast (ptr u8) method) (primitive/iadd (slice/slice-len (load (field req method))) 1)) 1)
            ; A stop aborts the transfer with CURLE_WRITE_ERROR, but the status line and
            ; headers arrived before any body byte did, so they are still valid and the
            ; caller asked for this. Report it as success with `stopped` set.
            (if (or (curl-ok? performed) stopped)
                (do
                  (curl-response-code easy (mut code))
                  (let [p (primitive/alloc-stack StreamingResponse)]
                    (store! (field p status) (load code))
                    (store! (field p headers) (arraylist/al-into-slice [Header] (mut (field capture headers))))
                    (store! (field p stopped) stopped)
                    (curl_slist_free_all hs)
                    (curl_easy_cleanup easy)
                    (Ok (load p))))
                (do
                  (clear-captured-headers! capture)
                  (arraylist/al-free! [Header] (mut (field capture headers)))
                  (curl_slist_free_all hs)
                  (curl_easy_cleanup easy)
                  (Err (transport-error performed)))))))))

(defn request-stream [(a (dyn alloc/Allocator))
                      (req (ptr Request))
                      (sink BodySink)] (-> (Result StreamingResponse HttpError))
  (request-stream-cancellable a
                              req
                              sink
                              (primitive/cast (ptr cancellation/Cancellation) 0)))

;;; Perform one blocking request. The response body is allocator-owned and must be
;;; released with `response-free`. HTTP error statuses are successful responses;
;;; only request construction and transport failures produce `HttpError`.
;;;
;;; Buffering is the only difference from `request-stream`: this collects the same chunks
;;; into an allocator-owned body. Sharing one implementation keeps the two from drifting
;;; in timeout, TLS, redirect or cleanup behavior.
(defn request [(a (dyn alloc/Allocator)) (req (ptr Request))] (-> (Result Response HttpError))
  (let [bytes (primitive/alloc-stack (arraylist/ArrayList u8))
        sink (primitive/alloc-stack BodySink)]
    (store! bytes (arraylist/al-new [u8] a))
    (store! (field sink context) (primitive/cast (ptr i8) bytes))
    (store! (field sink consume) (primitive/fnptr-of collect-body-chunk))
    (match (request-stream a req (load sink))
      (Err [e]
           (do
             (arraylist/al-free! [u8] bytes)
             (Err [Response HttpError] e)))
      (Ok [sr]
          ; a match binding is a value; spill it so `field` has a place to work from
          (let [srp (primitive/alloc-stack StreamingResponse)
                p (primitive/alloc-stack Response)]
            (store! srp sr)
            (store! (field p status) (load (field srp status)))
            (store! (field p headers) (load (field srp headers)))
            (store! (field p body) (arraylist/al-into-slice [u8] bytes))
            (Ok [Response HttpError] (load p)))))))

(defn response-status [(response Response)] (-> i64)
  (load (field response status)))
(defn response-body [(response Response)] (-> (slice u8))
  (load (field response body)))

;;; Release the allocator-owned response body and headers.
(defn response-header-count [(response Response)] (-> i64)
  (slice/slice-len (load (field response headers))))

(defn response-header-at [(response Response) (index i64)] (-> Header)
  (slice/slice-get (load (field response headers)) index))

(defn streaming-response-status [(response StreamingResponse)] (-> i64)
  (load (field response status)))

;;; True when the consumer asked to stop before the body was fully delivered. The status
;;; and headers are still valid; the transfer was simply cut short on purpose.
(defn streaming-response-stopped [(response StreamingResponse)] (-> bool)
  (load (field response stopped)))

(defn streaming-response-header-count [(response StreamingResponse)] (-> i64)
  (slice/slice-len (load (field response headers))))

(defn streaming-response-header-at [(response StreamingResponse) (index i64)] (-> Header)
  (slice/slice-get (load (field response headers)) index))

;;; Release the allocator-owned headers. There is no body to free — those bytes were
;;; transport-owned and never became part of the response.
(defn streaming-response-free [(a (dyn alloc/Allocator)) (response StreamingResponse)] (-> i64)
  (free-headers! a (load (field response headers))))

(defn free-headers! [(a (dyn alloc/Allocator)) (hs (slice Header))] (-> i64)
  (let [(mut i) 0]
    (loop (if (>= (load i) (slice/slice-len hs))
              (break)
              (do
                (free-header! a (slice/slice-get hs (load i)))
                (store! i (primitive/iadd (load i) 1)))))
    (if (> (slice/slice-len hs) (cast i64 0))
        (alloc/free [Header] a hs)
        0)))

(defn response-free [(a (dyn alloc/Allocator)) (response Response)] (-> i64)
  (let [body (load (field response body))]
    (free-headers! a (load (field response headers)))
    (alloc/free [u8] a body)))
