(module min)
(import "coil.primitive" :as primitive)
(import "gcrun" :use *)
(import "gcauto" :use *)
(defn build [(k i64) (i i64)] (-> Pair)
  (if (>= i k)
      (nil)
      (cons i (build k (+ i 1)))))
(defn sum [(xs Pair)] (-> i64)
  (if (nil? xs) 0 (+ (car xs) (sum (cdr xs)))))
(defn main [] (-> :i64)
  (sum (build 5 0)))
