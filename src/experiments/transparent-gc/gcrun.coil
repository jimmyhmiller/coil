(module gcrun)
(import "coil.primitive" :as primitive)
(import "coil.alloc" :as alloc)
; The runtime a GC'd program ASSUMES exists — cons/car/cdr/nil over a precise
; mark-sweep heap. User code never sees any of this; it just writes cons-lists.
; Pointers, allocation, and rooting are the transform's job (gcauto.coil).
(import "coil.control" :use *)
(extern malloc :cc c [i64] (-> (ptr u8)))
(extern free :cc c [(ptr u8)] (-> i64))

; a cons cell: car is a value, cdr is a managed reference
(defstruct Pair [(car i64) (cdr (ptr Pair))])

(defstruct GcHeader [(next (ptr GcHeader)) (mark i64)])
(defn g-list [] (-> (ptr (ptr GcHeader)))
  (alloc/static (ptr GcHeader)))
(defn g-roots [] (-> (ptr (array (ptr u8) 65536)))
  (alloc/static (array (ptr u8) 65536)))
(defn g-rtop [] (-> (ptr i64))
  (alloc/static i64))
(defn g-live [] (-> (ptr i64))
  (alloc/static i64))
(defn g-peak [] (-> (ptr i64))
  (alloc/static i64))
(defn g-ncol [] (-> (ptr i64))
  (alloc/static i64))
(defn g-total [] (-> (ptr i64))
  (alloc/static i64))

(defn hdr-of [(payload (ptr u8))] (-> (ptr GcHeader))
  (primitive/cast (ptr GcHeader) (- (primitive/cast i64 payload) (primitive/sizeof GcHeader))))

; --- the root stack primitives the TRANSFORM emits ---
(defn gc-sp [] (-> i64)
  (load (g-roots-top)))
(defn g-roots-top [] (-> (ptr i64))
  (g-rtop))
(defn gc-sp-set [(n i64)] (-> i64)
  (set! (g-rtop) n)
  0)
(defn gc-root [(p (ptr Pair))] (-> i64)
  (let [t (load (g-rtop))]
    (set! (primitive/index (g-roots) t) (primitive/cast (ptr u8) p))
    (set! (g-rtop) (+ t 1))
    0))

; --- mark / sweep ---
(defn gc-mark [(payload (ptr u8))] (-> i64)
  (if (= (primitive/cast i64 payload) 0)
      0
      (let [h (hdr-of payload)]
        (if (= (.mark h) 1)
            0
            (do
              (set! (.mark h) 1)
              (gc-mark (primitive/cast (ptr u8) (load (field (primitive/cast (ptr Pair) payload) cdr)))))))))
(defn gc-collect [] (-> i64)
  (let [top (load (g-rtop))]
    (for [i 0 top] (gc-mark (load (primitive/index (g-roots) i)))))
  ; sweep: rebuild the all-objects list from the survivors. `cur`/`newhead` are
  ; pointer muts, so cast/field/store take (primitive/load …) explicitly (mut auto-deref is
  ; only for clean operators and function args, not these special forms).
  (let [(mut cur) (load (g-list))
        (mut newhead) (primitive/cast (ptr GcHeader) 0)]
    (loop (if (= (primitive/cast i64 (load cur)) 0)
              (break)
              (let [nxt (load (field (load cur) next))]
                (if (= (.mark (load cur)) 1)
                    (do
                      (set! (.mark (load cur)) 0)
                      (set! (.next (load cur)) (load newhead))
                      (set! newhead (load cur))
                      0)
                    (do
                      (primitive/free (primitive/cast (ptr u8) (load cur)))
                      (set! (g-live) (- (load (g-live)) 1))
                      0))
                (set! cur nxt))))
    (set! (g-list) (load newhead)))
  (set! (g-ncol) (+ (load (g-ncol)) 1))
  0)

; --- the prims a Scheme-ish program uses (allocation is IMPLICIT in cons) ---
(defn nil [] (-> (ptr Pair))
  (primitive/cast (ptr Pair) 0))
(defn nil? [(p (ptr Pair))] (-> bool)
  (= (primitive/cast i64 p) 0))
(defn cons [(a i64) (d (ptr Pair))] (-> (ptr Pair))
  (if (>= (load (g-live)) 32) (gc-collect) 0)
  (let [raw (malloc (+ (primitive/sizeof GcHeader) (primitive/sizeof Pair)))
        h (primitive/cast (ptr GcHeader) raw)
        p (primitive/cast (ptr Pair) (+ (primitive/cast i64 raw) (primitive/sizeof GcHeader)))]
    (set! (.next h) (load (g-list)))
    (set! (.mark h) 0)
    (set! (g-list) h)
    (set! (g-total) (+ (load (g-total)) 1))
    (set! (g-live) (+ (load (g-live)) 1))
    (if (> (load (g-live)) (load (g-peak))) (set! (g-peak) (load (g-live))) 0)
    (set! (.car p) a)
    (set! (.cdr p) d)
    p))
(defn car [(p (ptr Pair))] (-> i64)
  (.car p))
(defn cdr [(p (ptr Pair))] (-> (ptr Pair))
  (.cdr p))

(defn gc-peak [] (-> i64)
  (load (g-peak)))
(defn gc-collections [] (-> i64)
  (load (g-ncol)))
(defn gc-total [] (-> i64)
  (load (g-total)))
