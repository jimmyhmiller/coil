(module app)
(import "coil.primitive" :as primitive)
(import "coil.io" :use *)
(import "coil.fmt" :use *)

;; ┌─────────────────────────────────────────────────────────────────────┐
;; │  THE DIALECT LINE — swap between these two and nothing else changes: │
;; │    (import "arena" :use *)   ; never frees                           │
;; │    (import "gc"    :use *)   ; mark-sweep, bounded memory            │
;; └─────────────────────────────────────────────────────────────────────┘
;; This used to read (import "DIALECT" :use *), with the README telling you to
;; `cp arena.coil DIALECT.coil` first. Imports name NAMESPACES now, not files, so
;; the copy resolved to whatever `(module …)` the copied file declared — still
;; `arena` — and the import failed outright. Swapping the line IS the swap.
(import "arena" :use *)

(defstruct Node [(val :i64) (next (ptr Node))])
(gctype Node)

(defn build-list [(k :i64) (i :i64)] (-> (ptr Node))
  (if (>= i k)
      (primitive/cast (ptr Node) 0)
      (gc-let rest
              (build-list k (primitive/iadd i 1))
              (let [node (new Node)]
                (fset node val i)
                (store! (field node next) rest)
                node))))

(defn sum-list [(h (ptr Node))] (-> :i64)
  (let [(mut cur) h
        (mut acc) 0]
    (loop (if (= (primitive/cast i64 (load cur)) (primitive/cast i64 0))
              (break (load acc))
              (do
                (store! acc (primitive/iadd (load acc) (load (field (load cur) val))))
                (store! cur (load (field (load cur) next))))))))

(defn once [(k :i64)] (-> :i64)
  (gc-let head
          (build-list k 0)
          (sum-list head)))

(defn main [] (-> :i64)
  (let [(mut total) 0
        (mut m) 0]
    (loop (if (>= (load m) (primitive/cast i64 100))
              (break 0)
              (do
                (store! total (primitive/iadd (load total) (once 50)))
                (store! m (primitive/iadd (load m) 1)))))
    (fmt (stdout)
         "total_sum={d}  objects_ever={d}  peak_live={d}  collections={d}\n"
         (load total)
         (objects-ever)
         (peak-live)
         (num-collections))
    0))
