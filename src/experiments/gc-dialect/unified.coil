(module app)
(import "coil.primitive" :as primitive)
(import "coil.io"  :use *)
(import "coil.fmt" :use *)

;; ┌─────────────────────────────────────────────────────────────────────┐
;; │  THE DIALECT LINE — swap between these two and nothing else changes: │
;; │    (import "arena" :use *)   ; never frees                           │
;; │    (import "gc"    :use *)   ; mark-sweep, bounded memory            │
;; └─────────────────────────────────────────────────────────────────────┘
;; This used to read (import "DIALECT" :use *), with the README telling you to
;; `cp arena.coil DIALECT.coil` first. Imports name NAMESPACES now, not files, so
;; the copy resolved to whatever `(module …)` the copied file declared — still
;; `arena` — and the import failed outright. Swapping the line IS the swap.
(import "arena" :use *)

(defstruct Node [(val :i64) (next (ptr Node))])
(gctype Node)

(defn build-list [(k :i64) (i :i64)] (-> (ptr Node))
  (if (primitive/icmp-ge i k)
      (primitive/cast (ptr Node) 0)
      (gc-let rest (build-list k (primitive/iadd i 1))
        (let [node (new Node)]
          (fset node val i)
          (primitive/store! (primitive/field node next) rest)
          node))))

(defn sum-list [(h (ptr Node))] (-> :i64)
  (let [(mut cur) h (mut acc) 0]
    (loop
      (if (primitive/icmp-eq (primitive/cast i64 (primitive/load cur)) 0)
          (break (primitive/load acc))
          (do
            (primitive/store! acc (primitive/iadd (primitive/load acc) (primitive/load (primitive/field (primitive/load cur) val))))
            (primitive/store! cur (primitive/load (primitive/field (primitive/load cur) next))))))))

(defn once [(k :i64)] (-> :i64)
  (gc-let head (build-list k 0)
    (sum-list head)))

(defn main [] (-> :i64)
  (let [(mut total) 0 (mut m) 0]
    (loop
      (if (primitive/icmp-ge (primitive/load m) 100) (break 0)
          (do (primitive/store! total (primitive/iadd (primitive/load total) (once 50)))
              (primitive/store! m (primitive/iadd (primitive/load m) 1)))))
    (fmt (stdout) "total_sum={d}  objects_ever={d}  peak_live={d}  collections={d}\n"
         (primitive/load total) (objects-ever) (peak-live) (num-collections))
    0))
