(module app)
(import "coil.primitive" :as primitive)
(import "coil.io" :use *)
(import "coil.fmt" :use *)
(import "arena" :use *)  ; ← the ONLY line that picks the dialect

(defstruct Point [(x :i64) (y :i64)])

; `build` allocates Points but takes NO Allocator. Allocation is implicit.
(defn build [(n :i64)] (-> :i64)
  (let [(mut i) 0
        (mut acc) 0]
    (loop (if (>= (load i) n)
              (break (load acc))
              (do
                (let [p (new Point)]
                  (fset p x (load i))
                  (fset p y (primitive/imul (load i) 2))
                  (store! acc (primitive/iadd (load acc) (primitive/iadd (fget p x) (fget p y)))))
                (store! i (primitive/iadd (load i) 1)))))))

(defn main [] (-> :i64)
  (let [s (build 5)]
    (fmt (stdout) "sum={d}  objects_allocated={d}\n" s (live-objs))
    0))
