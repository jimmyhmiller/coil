(module app)
(import "coil.primitive" :as primitive)
(import "coil.io"  :use *)
(import "coil.fmt" :use *)
(import "arena" :use *)          ; ← the ONLY line that picks the dialect

(defstruct Point [(x :i64) (y :i64)])

; `build` allocates Points but takes NO Allocator. Allocation is implicit.
(defn build [(n :i64)] (-> :i64)
  (let [(mut i) 0 (mut acc) 0]
    (loop
      (if (primitive/icmp-ge (primitive/load i) n)
          (break (primitive/load acc))
          (do
            (let [p (new Point)]
              (fset p x (primitive/load i))
              (fset p y (primitive/imul (primitive/load i) 2))
              (primitive/store! acc (primitive/iadd (primitive/load acc) (primitive/iadd (fget p x) (fget p y)))))
            (primitive/store! i (primitive/iadd (primitive/load i) 1)))))))

(defn main [] (-> :i64)
  (let [s (build 5)]
    (fmt (stdout) "sum={d}  objects_allocated={d}\n" s (live-objs))
    0))
