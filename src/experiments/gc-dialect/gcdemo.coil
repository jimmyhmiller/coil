(module app)
(import "coil.primitive" :as primitive)
(import "coil.io"  :use *)
(import "coil.fmt" :use *)
(import "gc"  :use *)

(defstruct Point [(x :i64) (y :i64)])
(gctype Point)                         ; generate Point's tracer (no ptr fields → no-op)

(defn run [(n :i64)] (-> :i64)
  (let [(mut i) 0 (mut acc) 0]
    (loop
      (if (primitive/icmp-ge (primitive/load i) n)
          (break (primitive/load acc))
          (do
            (gc-let p (new Point)
              (fset p x (primitive/load i))
              (fset p y (primitive/imul (primitive/load i) 2))
              (primitive/store! acc (primitive/iadd (primitive/load acc) (primitive/iadd (fget p x) (fget p y)))))
            (primitive/store! i (primitive/iadd (primitive/load i) 1)))))))

(defn main [] (-> :i64)
  (let [s (run 100000)]
    (fmt (stdout) "flat:  allocated=100000  sum={d}  peak_live={d}  collections={d}\n"
         s (peak-live) (num-collections))
    0))
