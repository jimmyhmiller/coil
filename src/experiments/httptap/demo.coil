; The httptap demo. Build it twice from the SAME source and compare:
;
;   coil build demo.coil -o demo                  # no tap; nothing is rewritten
;   coil build demo.coil -o demo --use httptap    # every request is reported
;
;   COIL_HTTP_TAP=file:///tmp/http.jsonl ./demo
;   COIL_HTTP_TAP=har:///tmp/demo.har    ./demo
;   COIL_HTTP_TAP=cdp://127.0.0.1:9229   ./demo
;
; It talks to example.com, so there is nothing to set up and nothing to run
; alongside it. Pass a different base URL as argv[1] to point it elsewhere.
;
; Note that this file imports neither httptap nor anything it depends on, and
; that the requests are issued from `tapdemo.api` rather than from here — the
; reports name that module and the function inside it.
(module tapdemo)
(import "coil.primitive" :as primitive)
(import "coil.alloc" :as alloc :use *)
(import "coil.slice" :use *)
(import "coil.str" :use *)
(import "coil.io" :as io :use *)
(import "coil.fmt" :use *)
(import "tapdemo.api" :as api)

(defn join [(a (ptr alloc/Allocator)) (base (slice u8)) (path (slice u8))] (-> (slice u8))
  (match (str-concat a base path) (None [] base) (Some [s] s)))

(defn main [(argc i32) (argv (ptr (ptr i8)))] (-> i64)
  (let [a (malloc-allocator)
        base
          (if (> (primitive/cast i64 argc) 1)
              (cstr->str (load (primitive/index argv 1)))
              "http://example.com")
        w (stdout)]
    (fmt w "GET  /          -> {d}\n" (api/get-status a (join a base "/")))
    (fmt w "POST /          -> {d}\n" (api/post-echo a (join a base "/") "hello from coil"))
    (fmt w "GET  /nope      -> {d}\n" (api/get-status a (join a base "/nope")))
    (fmt w "GET  / streamed -> {d} bytes\n" (api/stream-count a (join a base "/")))
    ; A request that cannot connect at all. The tap reports this as a failure
    ; rather than as a response with a made-up status.
    (fmt w "GET  unreachable-> {d}\n" (api/get-status a "http://127.0.0.1:1/nope"))
    0))
