; ── httptap: choosing a destination at run time ───────────────────────────
; The transform decides WHAT is captured; this decides WHERE it goes, and it
; decides it when the program runs rather than when it is built. One binary can
; write a HAR on one run and drive a live DevTools window on the next.
;
;   COIL_HTTP_TAP=file:///tmp/http.jsonl    one JSON object per request
;   COIL_HTTP_TAP=har:///tmp/session.har    a HAR to open in DevTools
;   COIL_HTTP_TAP=cdp://127.0.0.1:9229      live: DevTools attaches to the program
;   COIL_HTTP_TAP unset                     no tap; requests run untouched
;
;   COIL_HTTP_TAP_MAX_BODY=N   bytes of each body to keep (default 65536)
;   COIL_HTTP_TAP_WAIT=1       cdp only: block at start-up until DevTools attaches
;
; A destination that cannot be brought up is a HARD failure, reported and fatal.
; A tracing tool that silently records nothing is worse than no tracing tool: it
; answers "there were no requests" when the truth is "I never looked".
(module httptap.boot)
(import "coil.primitive" :as primitive)
(import "coil.alloc" :as alloc :use *)
(import "coil.slice" :use *)
(import "coil.str" :use *)
(import "coil.io" :as io :use *)
(import "coil.fmt" :use *)
(import "coil.os" :as os)
(import "httptap.rt" :as rt)
(import "httptap.jsonl" :as jsonl)
(import "httptap.har" :as har)
(import "httptap.cdp" :as cdp)

(defstruct BootState [(done i64)])
(defn boot-state [] (-> (ptr BootState))
  (alloc/static BootState))

(defn tap-fail [(msg (slice u8)) (detail (slice u8))] (-> i64)
  (do
    (fmt (stderr) "httptap: {s}: {s}\n" msg detail)
    (fmt (stderr) "httptap: refusing to run untraced when COIL_HTTP_TAP asked for a tap\n")
    (os/_exit 70)
    0))

;; Split `scheme:rest` at the first colon. A `//` right after the colon is
;; skipped, so `file:/tmp/x` and `file:///tmp/x` name the same file.
(defn scheme-of [(s (slice u8))] (-> (slice u8))
  (let [n (slice-len s)
        (mut i) 0
        (mut at) -1]
    (loop (if (if (>= (load i) n) true (>= (load at) 0))
              (break)
              (do
                (if (= (primitive/cast i64 (slice-get s (load i))) 58) (store! at (load i)) 0)
                (store! i (+ (load i) 1)))))
    (if (< (load at) 0) s (subslice s 0 (load at)))))

(defn target-of [(s (slice u8))] (-> (slice u8))
  (let [n (slice-len s)
        (mut i) 0
        (mut at) -1]
    (loop (if (if (>= (load i) n) true (>= (load at) 0))
              (break)
              (do
                (if (= (primitive/cast i64 (slice-get s (load i))) 58) (store! at (load i)) 0)
                (store! i (+ (load i) 1)))))
    (if (< (load at) 0)
        ""
        (let [rest (subslice s (+ (load at) 1) n)]
          (if (starts-with rest "//") (subslice rest 2 (slice-len rest)) rest)))))

(defn env-str [(a (ptr alloc/Allocator)) (name (slice u8))] (-> (slice u8))
  (match (os/env-get a name)
    (Err [e] "")
    (Ok [o] (match o (None [] "") (Some [v] (os/owned-string-slice v))))))

(defn env-int [(a (ptr alloc/Allocator)) (name (slice u8)) (fallback i64)] (-> i64)
  (let [v (env-str a name)]
    (if (= (slice-len v) 0)
        fallback
        (match (str-parse-int v) (None [] fallback) (Some [n] n)))))

;; Bring up the destination named by the environment. Injected at the top of
;; `main` by the transform, so it runs before the program's first request — the
;; live sink needs its server listening by then. Idempotent.
(defn tap-boot! [] (-> i64)
  (let [st (boot-state)]
    (if (!= (load (field st done)) 0)
        0
        (do
          (store! (field st done) 1)
          ; Initialize unconditionally, before looking at the spec: an untapped
          ; program still runs rewritten call sites, and they need a real (null)
          ; sink to dispatch through.
          (rt/tap-init! 65536)
          (let [a (malloc-allocator)
                spec (env-str a "COIL_HTTP_TAP")]
            (if (= (slice-len spec) 0)
                0
                (do
                  (rt/tap-set-max-body! (env-int a "COIL_HTTP_TAP_MAX_BODY" 65536))
                  (let [scheme (scheme-of spec)
                        target (target-of spec)]
                    (cond (if (= scheme "file") true (= scheme "jsonl"))
                            (if (jsonl/jsonl-install! a target) 0 (tap-fail "cannot open trace file" target))
                          (= scheme "har")
                            (if (har/har-install! a target) 0 (tap-fail "no path given for the HAR file" spec))
                          (= scheme "cdp")
                            (if (cdp/cdp-install! a target (= (env-int a "COIL_HTTP_TAP_WAIT" 0) 1))
                                0
                                (tap-fail "cannot start the DevTools endpoint on" target))
                          :else (tap-fail "unknown COIL_HTTP_TAP scheme (want file:, har: or cdp:)" scheme))))))))))
