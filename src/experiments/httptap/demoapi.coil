; A stand-in for the library layer of an application: the module that actually
; talks HTTP. It imports `coil.http.client` and knows nothing about httptap.
;
; That is the point of the demo. Under `--use httptap` the calls BELOW get
; rewritten, and every report names `tapdemo.api` and the function here — not
; `main`, and not some wrapper the author had to remember to route through.
(module tapdemo.api)
(import "coil.primitive" :as primitive)
(import "coil.alloc" :as alloc :use *)
(import "coil.slice" :use *)
(import "coil.str" :use *)
(import "coil.io" :as io :use *)
(import "coil.fmt" :use *)
(import "coil.http.client" :as http)

(defn fill-request [(req (ptr http/Request))
                    (method (slice u8))
                    (url (slice u8))
                    (headers (slice http/Header))
                    (body (slice u8))] (-> i64)
  (do
    (set! (.method req) method)
    (set! (.url req) url)
    (set! (.headers req) headers)
    (set! (.body req) body)
    (set! (.connect-timeout-ms req) 2000)
    (set! (.timeout-ms req) 5000)
    (set! (.follow-redirects req) true)
    0))

(defn no-headers [] (-> (slice http/Header))
  (slice-new (primitive/cast (ptr http/Header) 0) 0))

;; A plain GET. Returns the status, or -1 if the request never completed.
(defn get-status [(a (ptr alloc/Allocator)) (url (slice u8))] (-> i64)
  (let [req (alloc/stack http/Request)]
    (fill-request req "GET" url (no-headers) "")
    (match (http/request a req)
      (Err [e] -1)
      (Ok [r] (let [s (http/response-status r)] (http/response-free a r) s)))))

;; A POST with a body and a header, so the tap has something to show on the
;; request side too.
(defn post-echo [(a (ptr alloc/Allocator)) (url (slice u8)) (body (slice u8))] (-> i64)
  (let [req (alloc/stack http/Request)
        hs (alloc/stack (array http/Header 1))]
    (set! (.name (primitive/index hs 0)) "X-Coil-Demo")
    (set! (.value (primitive/index hs 0)) "httptap")
    (fill-request req "POST" url (slice-new (primitive/index hs 0) 1) body)
    (match (http/request a req)
      (Err [e] -1)
      (Ok [r] (let [s (http/response-status r)] (http/response-free a r) s)))))

; ---- a streaming consumer ---------------------------------------------------
; The tap interposes on this too: the counter below still sees every byte, and
; the report still gets the body prefix and the true total.
(defstruct Counter [(bytes i64)])

(defn count-chunk [(data (ptr u8)) (n i64) (ctx (ptr i8))] (-> i64)
  (let [c (primitive/cast (ptr Counter) ctx)]
    (set! (.bytes c) (+ (.bytes c) n))
    0))

;; Streams a response past a consumer that only counts it. Returns the byte
;; count, or -1 on failure.
(defn stream-count [(a (ptr alloc/Allocator)) (url (slice u8))] (-> i64)
  (let [req (alloc/stack http/Request)
        counter (alloc/stack Counter)
        sink (alloc/stack http/BodySink)]
    (fill-request req "GET" url (no-headers) "")
    (set! (.bytes counter) 0)
    (set! (.context sink) (primitive/cast (ptr i8) counter))
    (set! (.consume sink) (primitive/fnptr-of count-chunk))
    (match (http/request-stream a req (load sink))
      (Err [e] -1)
      (Ok [r] (do (http/streaming-response-free a r) (.bytes counter))))))
