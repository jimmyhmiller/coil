; ── httptap sink: JSON Lines ──────────────────────────────────────────────
; One JSON object per request, one per line, written as each request finishes.
;
;   COIL_HTTP_TAP=file:///tmp/http.jsonl ./app
;
; The plainest destination there is, and the one to reach for when the consumer
; is a script rather than a viewer: `jq`, a log shipper, a diff between two runs.
; Lines are flushed at `on-finish`, so a crashed program still leaves behind
; every request that had completed.
(module httptap.jsonl)
(import "coil.primitive" :as primitive)
(import "coil.alloc" :as alloc :use *)
(import "coil.slice" :use *)
(import "coil.str" :use *)
(import "coil.io" :as io :use *)
(import "coil.os" :as os)
(import "httptap.rt" :as rt :use *)

; Open flags differ per OS, so they are chosen at COMPILE time for the target
; being built for — the same reason `coil.fs` does it this way. A runtime probe
; here would bake the build host's constants into a cross-compiled binary.
(defn flag-pick [(linux Code) (darwin Code)] (-> Code)
  (if (primitive/code-eq (primitive/target-os) `linux) linux darwin))

(defn gen-open-flags [] (-> Code)
  `(do
     (const TAP_O_WRONLY 1)
     (const TAP_O_CREAT ~(flag-pick `64 `512))
     (const TAP_O_TRUNC ~(flag-pick `512 `1024))))
(meta (gen-open-flags))

(defstruct JsonlSink [(fd i64) (a (ptr alloc/Allocator))])

(defn jsonl-start [(ctx (ptr i8)) (ev (ptr rt/TapEvent))] (-> i64)
  0)

;; The record. Everything the event carries, flat, with the call site nested
;; under `site` — that block is the part no HTTP-level tracer can produce.
(defn jsonl-finish [(ctx (ptr i8)) (ev (ptr rt/TapEvent))] (-> i64)
  (let [s (primitive/cast (ptr JsonlSink) ctx)
        a (load (field s a))
        sb (alloc/stack StrBuf)
        w (alloc/stack io/Writer)]
    (store! sb (sb-new a))
    (sb-push-str! sb "{")
    (json-kv-int! sb "id" (load (field ev id)))
    (sb-push-str! sb ",")
    (json-kv-int! sb "startedMs" (load (field ev start-wall-ms)))
    (sb-push-str! sb ",")
    (json-kv-int! sb "durationNs" (- (load (field ev end-mono-ns)) (load (field ev start-mono-ns))))
    (sb-push-str! sb ",\"site\":")
    (json-site! sb (field ev site))
    (sb-push-str! sb ",")
    (json-kv-str! sb "method" (load (field ev method)))
    (sb-push-str! sb ",")
    (json-kv-str! sb "url" (load (field ev url)))
    (sb-push-str! sb ",\"requestHeaders\":")
    (json-headers! sb (load (field ev req-headers)))
    (sb-push-str! sb ",")
    (json-kv-str! sb "requestBody" (tap-capped (load (field ev req-body))))
    (sb-push-str! sb ",")
    (json-kv-int! sb "status" (load (field ev status)))
    (sb-push-str! sb ",\"responseHeaders\":")
    (json-headers! sb (load (field ev resp-headers)))
    (sb-push-str! sb ",")
    (json-kv-str! sb "responseBody" (load (field ev resp-body)))
    (sb-push-str! sb ",")
    (json-kv-int! sb "responseBodyLength" (load (field ev body-len)))
    (sb-push-str! sb ",")
    (json-kv-bool! sb "truncated" (load (field ev truncated)))
    (sb-push-str! sb ",")
    (json-kv-bool! sb "streamed" (load (field ev streamed)))
    (sb-push-str! sb ",")
    (json-kv-bool! sb "consumerStopped" (load (field ev stopped)))
    (sb-push-str! sb ",")
    (json-kv-bool! sb "failed" (load (field ev failed)))
    (sb-push-str! sb ",")
    (json-kv-str! sb "error" (load (field ev error)))
    (sb-push-str! sb ",")
    (json-kv-int! sb "errorCode" (load (field ev error-code)))
    (sb-push-str! sb ",")
    (json-kv-int! sb "connectTimeoutMs" (load (field ev connect-timeout-ms)))
    (sb-push-str! sb ",")
    (json-kv-int! sb "timeoutMs" (load (field ev timeout-ms)))
    (sb-push-str! sb ",")
    (json-kv-bool! sb "followRedirects" (load (field ev follow-redirects)))
    (sb-push-str! sb "}\n")
    (print-str (io/fd-writer w (load (field s fd))) (sb-str (load sb)))
    (sb-free! sb)
    0))

(defn jsonl-close [(ctx (ptr i8))] (-> i64)
  (let [s (primitive/cast (ptr JsonlSink) ctx)]
    (os/close (primitive/cast i32 (load (field s fd))))
    0))

;; Open `path` fresh (truncating any previous run) and install the sink. Returns
;; false when the file cannot be opened — the caller reports that; failing to
;; open a trace file must never look like "no requests happened".
(defn jsonl-install! [(a (ptr alloc/Allocator)) (path (slice u8))] (-> bool)
  (let [cpath (str->cstr a path)
        fd
          (os/open cpath
                   (primitive/cast i32 (primitive/ior TAP_O_WRONLY (primitive/ior TAP_O_CREAT TAP_O_TRUNC)))
                   420)]
    (if (< (primitive/cast i64 fd) 0)
        false
        (let [s (alloc/static JsonlSink)
              sink (alloc/stack rt/TapSink)]
          (store! (field s fd) (primitive/cast i64 fd))
          (store! (field s a) a)
          (store! (field sink context) (primitive/cast (ptr i8) s))
          (store! (field sink on-start) (primitive/fnptr-of jsonl-start))
          (store! (field sink on-finish) (primitive/fnptr-of jsonl-finish))
          (store! (field sink on-close) (primitive/fnptr-of jsonl-close))
          (rt/tap-set-sink! (load sink))
          true))))
