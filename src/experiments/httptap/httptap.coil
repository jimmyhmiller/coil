; ── DIALECT: httptap ──────────────────────────────────────────────────────
; Every HTTP request the program makes, sent somewhere to be looked at.
;
;   coil build app.coil -o app --use httptap
;   COIL_HTTP_TAP=har:///tmp/session.har ./app
;
; No source edits, no wrapper library, no import in the application. This is a
; whole-program TRANSFORM: it reads the compiler's own checked model of the
; program, finds every call that resolves to `coil.http.client/request` or
; `request-stream` — through any alias, in any module, including inside
; libraries the author did not write — and rewrites it to the traced stand-in in
; `httptap.rt`, carrying a compile-time constant description of the call site.
;
; Matching is SEMANTIC, not textual. `code-decl` gives the exact entity the
; type-checker resolved the head to, so `(http/request …)`, `(h/request …)` and
; a `request` referred bare all match, and a local function that merely happens
; to be called `request` does not.
;
; What the destination learns, per request: the module, function, file, line and
; column that issued it; method, URL, headers and body; status, response headers
; and body; whether it was streamed, whether the body was truncated, and the
; elapsed time. Where that goes is a run-time choice — see `httptap.boot`.
(module httptap)
(import "coil.primitive" :as primitive)
(import "coil.slice" :use *)
(import "httptap.rt" :use *)
(import "httptap.boot" :use *)

; ---- small string helpers ---------------------------------------------------
; A metaprogram may call imported functions, but keeping these local makes the
; transform readable as one unit.
(defn seg-start [(s (slice u8))] (-> i64)
  (let [n (slice-len s)
        (mut i) 0
        (mut at) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (let [c (primitive/cast i64 (slice-get s (load i)))]
                  (if (if (= c 47) true (= c 46)) (set! at (+ (load i) 1)) 0))
                (set! i (+ (load i) 1)))))
    (load at)))

;; The last `/`- or `.`-separated segment of a qualified name: `http/request` and
;; `coil.http.client.request` both yield `request`.
(defn last-segment [(s (slice u8))] (-> (slice u8))
  (subslice s (seg-start s) (slice-len s)))

(defn str-same? [(a (slice u8)) (b (slice u8))] (-> bool)
  (if (!= (slice-len a) (slice-len b))
      false
      (let [n (slice-len a)
            (mut i) 0
            (mut ok) true]
        (loop (if (if (>= (load i) n) true (not (load ok)))
                  (break)
                  (do
                    (if (= (slice-get a (load i)) (slice-get b (load i))) 0 (do (set! ok false) 0))
                    (set! i (+ (load i) 1)))))
        (load ok))))

(defn has-prefix? [(s (slice u8)) (p (slice u8))] (-> bool)
  (if (< (slice-len s) (slice-len p)) false (str-same? (subslice s 0 (slice-len p)) p)))

; ---- recognizing an HTTP call -----------------------------------------------
(defn decl-module-is-http? [(d Code)] (-> bool)
  (and (primitive/code-list? d)
       (and (>= (primitive/code-count d) 2)
            (primitive/code-eq (primitive/code-nth d 1) `coil.http.client))))

;; 1 for `request`, 2 for `request-stream`, 0 for anything else. The decl check
;; comes first so a same-named local function is never mistaken for the real one.
(defn http-call-kind [(f Code)] (-> i64)
  (if (not (and (primitive/code-list? f) (> (primitive/code-count f) 0)))
      0
      (let [h (primitive/code-nth f 0)]
        (if (not (primitive/code-sym? h))
            0
            (if (not (decl-module-is-http? (primitive/code-decl h)))
                0
                (let [nm (last-segment (primitive/code-str h))]
                  (if (str-same? nm "request")
                      (if (= (primitive/code-count f) 3) 1 0)
                      (if (str-same? nm "request-stream")
                          (if (= (primitive/code-count f) 4) 2 0)
                          0))))))))

(defn contains-http-call? [(f Code)] (-> bool)
  (if (> (http-call-kind f) 0)
      true
      (if (primitive/code-list? f)
          (contains-http-call-kids? f 0 (primitive/code-count f))
          false)))

(defn contains-http-call-kids? [(f Code) (i i64) (n i64)] (-> bool)
  (if (>= i n)
      false
      (if (contains-http-call? (primitive/code-nth f i))
          true
          (contains-http-call-kids? f (+ i 1) n))))

; ---- the rewrite ------------------------------------------------------------
;; The call site, frozen into literals. `mk-site` and `tap-request` are written
;; unqualified on purpose: referential hygiene resolves a template's symbols in
;; THIS module's namespace, so they bind to `httptap.rt` even though the module
;; being rewritten imports nothing of the sort.
(defn site-of [(f Code) (mod-name (slice u8)) (fn-name (slice u8))] (-> Code)
  `(mk-site ~mod-name
            ~fn-name
            ~(primitive/code-file f)
            ~(primitive/code-line f)
            ~(primitive/code-col f)))

(defn rewrite [(f Code) (mod-name (slice u8)) (fn-name (slice u8))] (-> Code)
  (let [kind (http-call-kind f)]
    (if (= kind 1)
        `(tap-request ~(site-of f mod-name fn-name)
                      ~(rewrite (primitive/code-nth f 1) mod-name fn-name)
                      ~(rewrite (primitive/code-nth f 2) mod-name fn-name))
        (if (= kind 2)
            `(tap-request-stream ~(site-of f mod-name fn-name)
                                 ~(rewrite (primitive/code-nth f 1) mod-name fn-name)
                                 ~(rewrite (primitive/code-nth f 2) mod-name fn-name)
                                 ~(rewrite (primitive/code-nth f 3) mod-name fn-name))
            ; Subtrees with nothing to rewrite are returned UNTOUCHED rather than
            ; rebuilt, so untapped code keeps its original nodes (and with them its
            ; source spans, which every later diagnostic points at).
            (if (and (primitive/code-list? f) (contains-http-call? f))
                `(~@(rewrite-kids f 0 (primitive/code-count f) mod-name fn-name))
                f)))))

(defn rewrite-kids [(f Code) (i i64) (n i64) (mod-name (slice u8)) (fn-name (slice u8))] (-> Code)
  (if (>= i n)
      `()
      `(~(rewrite (primitive/code-nth f i) mod-name fn-name) ~@(rewrite-kids f (+ i 1) n mod-name fn-name))))

; ---- boot injection ---------------------------------------------------------
; `main` gets one extra binding so the configured destination is up before the
; program's first request — which matters for the live DevTools sink, where a
; viewer has to be able to attach.
(defn is-defn? [(f Code)] (-> bool)
  (and (primitive/code-list? f)
       (and (>= (primitive/code-count f) 5)
            (and (primitive/code-sym? (primitive/code-nth f 0))
                 (primitive/code-eq (primitive/code-nth f 0) `defn)))))

(defn is-main? [(f Code)] (-> bool)
  (and (is-defn? f) (primitive/code-eq (primitive/code-nth f 1) `main)))

(defn forms-from [(f Code) (i i64) (n i64) (mod-name (slice u8)) (fn-name (slice u8))] (-> Code)
  (if (>= i n)
      `()
      `(~(rewrite (primitive/code-nth f i) mod-name fn-name) ~@(forms-from f (+ i 1) n mod-name fn-name))))

;; Transforms run to a FIXPOINT, so every rewrite must be recognizable as already
;; done. Rewritten call sites are self-evident — they no longer call the real
;; client — but an injected boot is not, so it announces itself with a binding
;; name no one else would write.
(defn boot-injected? [(f Code)] (-> bool)
  (let [b (primitive/code-nth f 4)]
    (if (and (primitive/code-list? b)
             (and (> (primitive/code-count b) 1) (primitive/code-eq (primitive/code-nth b 0) `let)))
        (let [bv (primitive/code-nth b 1)]
          (and (primitive/code-list? bv)
               (and (> (primitive/code-count bv) 0)
                    (primitive/code-eq (primitive/code-nth bv 0) `__httptap_boot__))))
        false)))

(defn xf-defn [(f Code) (mod-name (slice u8))] (-> Code)
  (let [fn-name (primitive/code-str (primitive/code-nth f 1))
        n (primitive/code-count f)]
    (if (and (is-main? f) (not (boot-injected? f)))
        `(defn ~(primitive/code-nth f 1)
           ~(primitive/code-nth f 2)
           ~(primitive/code-nth f 3)
           (let [__httptap_boot__ (tap-boot!)]
             ~@(forms-from f 4 n mod-name fn-name)))
        (if (contains-http-call? f)
            `(defn ~(primitive/code-nth f 1)
               ~(primitive/code-nth f 2)
               ~(primitive/code-nth f 3)
               ~@(forms-from f 4 n mod-name fn-name))
            f))))

(defn xf-form [(f Code) (mod-name (slice u8))] (-> Code)
  (if (is-defn? f)
      (xf-defn f mod-name)
      ; Anything else (an `impl` block, a `const`, a generated form) still gets
      ; walked; it just has no enclosing function name to report.
      (rewrite f mod-name "")))

(defn xf-forms [(m Code) (i i64) (n i64) (mod-name (slice u8))] (-> Code)
  (if (>= i n)
      `()
      `(~(xf-form (primitive/code-nth m i) mod-name) ~@(xf-forms m (+ i 1) n mod-name))))

; ---- module selection -------------------------------------------------------
;; Skip the tap's own modules. They call the real client on purpose, and
;; rewriting those calls would make the tap tap itself, forever.
(defn own-module? [(m Code)] (-> bool)
  (has-prefix? (primitive/code-str (primitive/code-nth m 0)) "httptap"))

(defn process-module? [(m Code)] (-> bool)
  (if (<= (primitive/code-count m) 1)
      false
      (if (own-module? m)
          false
          (primitive/code-from-user? (primitive/code-nth m 1)))))

(defn xf-module [(m Code)] (-> Code)
  (if (process-module? m)
      `(~(primitive/code-nth m 0) ~@(xf-forms m
                                              1
                                              (primitive/code-count m)
                                              (primitive/code-str (primitive/code-nth m 0))))
      m))

(defn xf-modules [(ms Code) (i i64) (n i64)] (-> Code)
  (if (>= i n)
      `()
      `(~(xf-module (primitive/code-nth ms i)) ~@(xf-modules ms (+ i 1) n))))

(defn httptap-transform [(mods Code)] (-> Code)
  `(do ~@(xf-modules mods 0 (primitive/code-count mods))))

(transform httptap-transform)
