; ── httptap: the WebSocket bits ───────────────────────────────────────────
; SHA-1 and RFC 6455 framing — the two things standing between a TCP socket and
; a Chrome DevTools window. Nothing here is httptap-specific.
;
; Only what the DevTools frontend actually exercises is implemented: the opening
; handshake, unmasking client frames, and writing server text frames. Control
; frames are recognized (close and ping are answered); continuation frames are
; not, because the frontend never splits a protocol message across them.
(module httptap.ws)
(import "coil.primitive" :as primitive)
(import "coil.alloc" :as alloc :use *)
(import "coil.slice" :use *)
(import "coil.str" :use *)
(import "httptap.rt" :as rt :use *)

(const WS-GUID "258EAFA5-E914-47DA-95CA-C5AB0DC85B11")
(const U32 4294967295)

;; Opcodes, as they appear in the low nibble of a frame's first byte.
(const WS-CONTINUATION 0)
(const WS-TEXT 1)
(const WS-BINARY 2)
(const WS-CLOSE 8)
(const WS-PING 9)
(const WS-PONG 10)

; ---- SHA-1 ------------------------------------------------------------------
; Present only because the handshake demands it: the accept key is
; base64(sha1(client-key + GUID)). Every value is masked back to 32 bits after
; every operation, since the machine word here is 64-bit.
(defn m32 [(x i64)] (-> i64)
  (primitive/iand x U32))

(defn rotl32 [(v i64) (n i64)] (-> i64)
  (m32 (primitive/ior (primitive/ishl v n) (primitive/ishr (m32 v) (- 32 n)))))

(defn sha1-f [(t i64) (b i64) (c i64) (d i64)] (-> i64)
  (cond (< t 20) (primitive/ior (primitive/iand b c) (primitive/iand (m32 (primitive/inot b)) d))
        (< t 40) (primitive/ixor b (primitive/ixor c d))
        (< t 60) (primitive/ior (primitive/iand b c) (primitive/ior (primitive/iand b d) (primitive/iand c d)))
        :else (primitive/ixor b (primitive/ixor c d))))

(defn sha1-k [(t i64)] (-> i64)
  (cond (< t 20) 1518500249
        (< t 40) 1859775393
        (< t 60) 2400959708
        :else 3395469782))

;; The byte at `i` of the padded message: the message itself, then 0x80, then
;; zeroes, then the bit length big-endian in the last eight bytes. Materializing
;; the padding as a function rather than a buffer keeps this allocation-free.
(defn padded-byte [(msg (slice u8)) (total i64) (i i64)] (-> i64)
  (let [n (slice-len msg)]
    (cond (< i n) (primitive/cast i64 (slice-get msg i))
          (= i n) 128
          (< i (- total 8)) 0
          :else (primitive/iand (primitive/ishr (* n 8) (* 8 (- (- total 1) i))) 255))))

(defn sha1-word [(msg (slice u8)) (total i64) (at i64)] (-> i64)
  (primitive/ior (primitive/ishl (padded-byte msg total at) 24)
                 (primitive/ior (primitive/ishl (padded-byte msg total (+ at 1)) 16)
                                (primitive/ior (primitive/ishl (padded-byte msg total (+ at 2)) 8)
                                               (padded-byte msg total (+ at 3))))))

;; Write the 20-byte digest of `msg` to `out`.
(defn sha1 [(msg (slice u8)) (out (ptr u8))] (-> i64)
  (let [n (slice-len msg)
        total (* (/ (+ n 72) 64) 64)  ; n + 1 + 8 rounded up to a block
        w (alloc/stack (array i64 80))
        h (alloc/stack (array i64 5))
        (mut block) 0]
    (store! (primitive/index h 0) 1732584193)
    (store! (primitive/index h 1) 4023233417)
    (store! (primitive/index h 2) 2562383102)
    (store! (primitive/index h 3) 271733878)
    (store! (primitive/index h 4) 3285377520)
    (loop (if (>= (load block) total)
              (break)
              (do
                (let [(mut i) 0]
                  (loop (if (>= (load i) 16)
                            (break)
                            (do
                              (store! (primitive/index w (load i))
                                      (sha1-word msg total (+ (load block) (* (load i) 4))))
                              (store! i (+ (load i) 1)))))
                  (loop (if (>= (load i) 80)
                            (break)
                            (do
                              (store! (primitive/index w (load i))
                                      (rotl32 (primitive/ixor (primitive/ixor (load (primitive/index w (- (load i) 3)))
                                                                              (load (primitive/index w (- (load i) 8))))
                                                              (primitive/ixor (load (primitive/index w (- (load i) 14)))
                                                                              (load (primitive/index w (- (load i) 16)))))
                                              1))
                              (store! i (+ (load i) 1))))))
                (let [(mut a) (load (primitive/index h 0))
                      (mut b) (load (primitive/index h 1))
                      (mut c) (load (primitive/index h 2))
                      (mut d) (load (primitive/index h 3))
                      (mut e) (load (primitive/index h 4))
                      (mut t) 0]
                  (loop (if (>= (load t) 80)
                            (break)
                            (do
                              (let [tmp
                                      (m32 (+ (+ (+ (+ (rotl32 (load a) 5)
                                                       (sha1-f (load t) (load b) (load c) (load d)))
                                                    (load e))
                                                 (sha1-k (load t)))
                                              (load (primitive/index w (load t)))))]
                                (store! e (load d))
                                (store! d (load c))
                                (store! c (rotl32 (load b) 30))
                                (store! b (load a))
                                (store! a tmp))
                              (store! t (+ (load t) 1)))))
                  (store! (primitive/index h 0) (m32 (+ (load (primitive/index h 0)) (load a))))
                  (store! (primitive/index h 1) (m32 (+ (load (primitive/index h 1)) (load b))))
                  (store! (primitive/index h 2) (m32 (+ (load (primitive/index h 2)) (load c))))
                  (store! (primitive/index h 3) (m32 (+ (load (primitive/index h 3)) (load d))))
                  (store! (primitive/index h 4) (m32 (+ (load (primitive/index h 4)) (load e)))))
                (store! block (+ (load block) 64)))))
    (let [(mut i) 0]
      (loop (if (>= (load i) 20)
                (break)
                (do
                  (store! (primitive/index out (load i))
                          (primitive/cast u8
                                          (primitive/iand (primitive/ishr (load (primitive/index h (/ (load i) 4)))
                                                                          (* 8 (- 3 (% (load i) 4))))
                                                          255)))
                  (store! i (+ (load i) 1))))))
    0))

;; The `Sec-WebSocket-Accept` value for a client's `Sec-WebSocket-Key`, appended
;; to `out`.
(defn accept-key! [(out (ptr StrBuf)) (a (ptr alloc/Allocator)) (key (slice u8))] (-> i64)
  (let [joined (alloc/stack StrBuf)
        digest (alloc/stack (array u8 20))]
    (store! joined (sb-new a))
    (sb-push-str! joined key)
    (sb-push-str! joined WS-GUID)
    (sha1 (sb-str (load joined)) (primitive/index digest 0))
    (b64-into! out (slice-new (primitive/index digest 0) 20))
    (sb-free! joined)
    0))

; ---- frames -----------------------------------------------------------------
;; Append `payload` as one complete unmasked text frame. Server frames are never
;; masked, which is what RFC 6455 requires and what the frontend expects.
(defn frame-text! [(out (ptr StrBuf)) (payload (slice u8))] (-> i64)
  (let [n (slice-len payload)]
    (sb-push-byte! out (primitive/cast u8 (primitive/ior 128 WS-TEXT)))
    (cond (< n 126) (sb-push-byte! out (primitive/cast u8 n))
          (< n 65536)
            (do
              (sb-push-byte! out (primitive/cast u8 126))
              (sb-push-byte! out (primitive/cast u8 (primitive/iand (primitive/ishr n 8) 255)))
              (sb-push-byte! out (primitive/cast u8 (primitive/iand n 255))))
          :else
            (do
              (sb-push-byte! out (primitive/cast u8 127))
              (let [(mut i) 7]
                (loop (if (< (load i) 0)
                          (break)
                          (do
                            (sb-push-byte! out
                                           (primitive/cast u8 (primitive/iand (primitive/ishr n (* 8 (load i))) 255)))
                            (store! i (- (load i) 1))))))))
    (sb-push-str! out payload)
    0))

(defn frame-control! [(out (ptr StrBuf)) (opcode i64)] (-> i64)
  (do
    (sb-push-byte! out (primitive/cast u8 (primitive/ior 128 opcode)))
    (sb-push-byte! out (primitive/cast u8 0))
    0))

;; What `decode-frame` found. `consumed` is 0 when the buffer does not yet hold a
;; whole frame — the caller reads more and tries again rather than guessing.
(defstruct Frame
  [(opcode i64)
   (payload (slice u8))
   (consumed i64)])

;; Decode one client frame from the front of `buf`, unmasking in place. In-place
;; is safe and deliberate: `buf` is the connection's own read buffer, and the
;; masked bytes have no other reader.
(defn decode-frame [(out (ptr Frame)) (buf (slice u8))] (-> i64)
  (let [n (slice-len buf)]
    (store! (field out consumed) 0)
    (if (< n 2)
        0
        (let [b0 (primitive/cast i64 (slice-get buf 0))
              b1 (primitive/cast i64 (slice-get buf 1))
              opcode (primitive/iand b0 15)
              masked (= (primitive/iand b1 128) 128)
              len7 (primitive/iand b1 127)
              (mut len) len7
              (mut at) 2]
          (if (= len7 126)
              (if (< n 4)
                  (store! len -1)
                  (do
                    (store! len
                            (primitive/ior (primitive/ishl (primitive/cast i64 (slice-get buf 2)) 8)
                                           (primitive/cast i64 (slice-get buf 3))))
                    (store! at 4)))
              (if (= len7 127)
                  (if (< n 10)
                      (store! len -1)
                      (do
                        (let [(mut v) 0
                              (mut k) 0]
                          (loop (if (>= (load k) 8)
                                    (break)
                                    (do
                                      (store! v
                                              (primitive/ior (primitive/ishl (load v) 8)
                                                             (primitive/cast i64 (slice-get buf (+ 2 (load k))))))
                                      (store! k (+ (load k) 1)))))
                          (store! len (load v)))
                        (store! at 10)))
                  0))
          (if (< (load len) 0)
              0
              (let [mask-len (if masked 4 0)
                    need (+ (+ (load at) mask-len) (load len))]
                (if (< n need)
                    0
                    (do
                      (if masked
                          (let [(mut i) 0]
                            (loop (if (>= (load i) (load len))
                                      (break)
                                      (do
                                        (slice-set! buf
                                                    (+ (+ (load at) 4) (load i))
                                                    (primitive/cast u8
                                                                    (primitive/ixor (primitive/cast i64
                                                                                                    (slice-get buf
                                                                                                               (+ (+ (load at)
                                                                                                                     4)
                                                                                                                  (load i))))
                                                                                    (primitive/cast i64
                                                                                                    (slice-get buf
                                                                                                               (+ (load at)
                                                                                                                  (% (load i)
                                                                                                                     4)))))))
                                        (store! i (+ (load i) 1))))))
                          0)
                      (store! (field out opcode) opcode)
                      (store! (field out payload)
                              (subslice buf (+ (load at) mask-len) need))
                      (store! (field out consumed) need)
                      0))))))))
