; ── httptap sink: live Chrome DevTools ────────────────────────────────────
; The program becomes something Chrome DevTools can attach to, and its HTTP
; requests appear in the Network panel as they happen.
;
;   COIL_HTTP_TAP=cdp://127.0.0.1:9229 ./app
;   # open the URL the program prints, in Chrome
;
; This is the same trick the Node inspector plays: DevTools does not care that
; there is no browser on the other end of the socket, only that something speaks
; the Chrome DevTools Protocol over a WebSocket. So this serves the `/json`
; discovery endpoints, performs the RFC 6455 handshake, and emits the three
; `Network` events the panel is built around:
;
;   Network.requestWillBeSent   when the request goes out   (on-start)
;   Network.responseReceived    when the status is known    (on-finish)
;   Network.loadingFinished     immediately after
;
; and answers `Network.getResponseBody`, which is what makes clicking a request
; and reading its body work.
;
; THREADING. One background thread owns accept and reads; the application thread
; writes events straight down the socket from inside the sink callbacks. Writes
; from both threads are serialized by `write-lock`. Events raised before anyone
; has attached are queued, and the queue is flushed at handshake — so a program
; that finishes before you can open DevTools still shows you everything, as long
; as it is still alive to serve the socket.
(module httptap.cdp)
(import "coil.primitive" :as primitive)
(import "coil.alloc" :as alloc :use *)
(import "coil.slice" :use *)
(import "coil.str" :use *)
(import "coil.arraylist" :use *)
(import "coil.io" :as io :use *)
(import "coil.fmt" :use *)
(import "coil.socket" :as sock)
(import "coil.sync" :as sync)
(import "coil.thread" :as thread)
(import "coil.time" :as time)
(import "coil.http.server" :as hsrv)
(import "httptap.rt" :as rt :use *)
(import "httptap.ws" :as ws)

(defn nap-ms [(ms i64)] (-> i64)
  (match (time/duration-millis ms)
    (Err [e] 0)
    (Ok [d] (match (time/sleep d) (Err [e2] 0) (Ok [n] n)))))

(const READ-CHUNK 8192)

(defstruct BodyRecord [(id i64) (body (slice u8))])

(defstruct CdpSink
  [(a (ptr alloc/Allocator))
   (host (slice u8))
   (port i64)
   (listener sock/TcpListener)
   (conn sock/TcpConnection)
   (attached bool)
   (write-lock sync/Mutex)
   (state-lock sync/Mutex)
   (pending StrBuf)  ; frames raised before anyone attached
   (bodies (ArrayList BodyRecord))  ; for Network.getResponseBody
   (started-ns i64)])

(defn cdp-sink [] (-> (ptr CdpSink))
  (alloc/static CdpSink))

; ---- time in the protocol's units -------------------------------------------
; CDP timestamps are seconds as a decimal number: `timestamp` is monotonic and
; only differences matter, `wallTime` is a real epoch time.
(defn json-secs! [(sb (ptr StrBuf)) (ns i64)] (-> i64)
  (let [n (if (< ns 0) 0 ns)]
    (json-int! sb (/ n 1000000000))
    (sb-push-str! sb ".")
    (let [frac (% n 1000000000)
          (mut d) 100000000]
      (loop (if (<= (load d) 0)
                (break)
                (do
                  (sb-push-byte! sb (primitive/cast u8 (+ 48 (% (/ frac (load d)) 10))))
                  (set! d (/ (load d) 10))))))
    0))

(defn json-ms-secs! [(sb (ptr StrBuf)) (ms i64)] (-> i64)
  (do
    (json-int! sb (/ ms 1000))
    (sb-push-str! sb ".")
    (sb-push-byte! sb (primitive/cast u8 (+ 48 (% (/ ms 100) 10))))
    (sb-push-byte! sb (primitive/cast u8 (+ 48 (% (/ ms 10) 10))))
    (sb-push-byte! sb (primitive/cast u8 (+ 48 (% ms 10))))
    0))

;; One header line, CRLF-terminated.
(defn line! [(sb (ptr StrBuf)) (text (slice u8))] (-> i64)
  (do (sb-push-str! sb text) (sb-push-str! sb "\r\n") 0))

; ---- socket helpers ---------------------------------------------------------
(defn send-raw [(s (ptr CdpSink)) (bytes (slice u8))] (-> i64)
  (let [n (slice-len bytes)
        (mut off) 0
        (mut fail) 0]
    (loop (if (if (>= (load off) n) true (!= (load fail) 0))
              (break)
              (match (sock/tcp-write (field s conn)
                                     (primitive/cast (ptr i8) (primitive/index (slice-data bytes) (load off)))
                                     (- n (load off)))
                (Err [e] (do (set! fail 1) 0))
                (Ok [wrote]
                    (if (<= wrote 0)
                        (do (set! fail 1) 0)
                        (do (set! off (+ (load off) wrote)) 0))))))
    (load fail)))

;; Send one CDP message, or queue it if DevTools has not attached yet. The lock
;; covers the attached test AND the send, so a message can never slip between a
;; handshake flushing the queue and the flag being set.
(defn cdp-send! [(s (ptr CdpSink)) (json (slice u8))] (-> i64)
  (do
    (sync/mutex-lock! (field s write-lock))
    (if (.attached s)
        (let [frame (alloc/stack StrBuf)]
          (set! frame (sb-new (load (field s a))))
          (ws/frame-text! frame json)
          (send-raw s (sb-str (load frame)))
          (sb-free! frame)
          0)
        (ws/frame-text! (field s pending) json))
    (sync/mutex-unlock! (field s write-lock))
    0))

; ---- events -----------------------------------------------------------------
(defn request-id! [(sb (ptr StrBuf)) (id i64)] (-> i64)
  (do (sb-push-str! sb "\"") (json-int! sb id) (sb-push-str! sb "\"") 0))

(defn cdp-start [(ctx (ptr i8)) (ev (ptr rt/TapEvent))] (-> i64)
  (let [s (primitive/cast (ptr CdpSink) ctx)
        sb (alloc/stack StrBuf)]
    (set! sb (sb-new (load (field s a))))
    (sb-push-str! sb "{\"method\":\"Network.requestWillBeSent\",\"params\":{\"requestId\":")
    (request-id! sb (.id ev))
    (sb-push-str! sb ",\"loaderId\":\"httptap\",\"documentURL\":")
    (json-str! sb (.url ev))
    (sb-push-str! sb ",\"request\":{")
    (json-kv-str! sb "url" (.url ev))
    (sb-push-str! sb ",")
    (json-kv-str! sb "method" (.method ev))
    (sb-push-str! sb ",\"headers\":")
    (json-header-object! sb (.req-headers ev))
    (if (> (slice-len (.req-body ev)) 0)
        (do
          (sb-push-str! sb ",")
          (json-kv-str! sb "postData" (tap-capped (.req-body ev))))
        0)
    (sb-push-str! sb ",\"initialPriority\":\"Medium\",\"referrerPolicy\":\"no-referrer\"}")
    (sb-push-str! sb ",\"timestamp\":")
    (json-secs! sb (- (.start-mono-ns ev) (.started-ns s)))
    (sb-push-str! sb ",\"wallTime\":")
    (json-ms-secs! sb (.start-wall-ms ev))
    ; The initiator is where the provenance goes. DevTools shows this column,
    ; so the module, function and line the request came from are visible in the
    ; panel itself rather than buried in a custom field.
    (sb-push-str! sb ",\"initiator\":{\"type\":\"other\",\"url\":")
    (json-str! sb (.file (.site ev)))
    (sb-push-str! sb ",\"lineNumber\":")
    (json-int! sb (- (.line (.site ev)) 1))
    (sb-push-str! sb ",\"columnNumber\":")
    (json-int! sb (- (.col (.site ev)) 1))
    (sb-push-str! sb "},\"type\":\"XHR\",\"_coil\":")
    (json-site! sb (field ev site))
    (sb-push-str! sb "}}")
    (cdp-send! s (sb-str (load sb)))
    (sb-free! sb)
    0))

;; Keep the body so `Network.getResponseBody` can answer later. It is copied
;; because the event's slice dies with the call that produced it.
(defn remember-body! [(s (ptr CdpSink)) (id i64) (body (slice u8))] (-> i64)
  (let [a (load (field s a))
        rec (alloc/stack BodyRecord)
        n (slice-len body)]
    (match (raw-alloc a (if (> n 0) n 1) 1)
      (None [] 0)
      (Some [p]
            (do
              (let [(mut i) 0]
                (loop (if (>= (load i) n)
                          (break)
                          (do
                            (set! (primitive/index (primitive/cast (ptr u8) p) (load i)) (slice-get body (load i)))
                            (set! i (+ (load i) 1))))))
              (set! (.id rec) id)
              (set! (.body rec) (slice-new (primitive/cast (ptr u8) p) n))
              (sync/mutex-lock! (field s state-lock))
              (al-push! (field s bodies) (load rec))
              (sync/mutex-unlock! (field s state-lock))
              0)))))

(defn find-body [(s (ptr CdpSink)) (id i64)] (-> (slice u8))
  (let [n (al-len (.bodies s))
        (mut i) 0
        (mut found) ""]
    (loop (if (>= (load i) n)
              (break)
              (do
                (let [r (alloc/stack BodyRecord)]
                  (set! r (al-get (.bodies s) (load i)))
                  (if (= (.id r) id) (do (set! found (.body r)) 0) 0))
                (set! i (+ (load i) 1)))))
    (load found)))

(defn cdp-finish [(ctx (ptr i8)) (ev (ptr rt/TapEvent))] (-> i64)
  (let [s (primitive/cast (ptr CdpSink) ctx)
        sb (alloc/stack StrBuf)
        t (- (.end-mono-ns ev) (.started-ns s))]
    (remember-body! s (.id ev) (.resp-body ev))
    (set! sb (sb-new (load (field s a))))
    ; A transport failure is `loadingFailed`, not a response. Reporting it as a
    ; response with status 0 would put a fake row in the panel and hide the
    ; reason it failed.
    (if (.failed ev)
        (do
          (sb-push-str! sb "{\"method\":\"Network.loadingFailed\",\"params\":{\"requestId\":")
          (request-id! sb (.id ev))
          (sb-push-str! sb ",\"timestamp\":")
          (json-secs! sb t)
          (sb-push-str! sb ",\"type\":\"XHR\",\"errorText\":")
          (json-str! sb (.error ev))
          (sb-push-str! sb ",\"canceled\":false}}")
          (cdp-send! s (sb-str (load sb))))
        (do
          (sb-push-str! sb "{\"method\":\"Network.responseReceived\",\"params\":{\"requestId\":")
          (request-id! sb (.id ev))
          (sb-push-str! sb ",\"loaderId\":\"httptap\",\"timestamp\":")
          (json-secs! sb t)
          (sb-push-str! sb ",\"type\":\"XHR\",\"response\":{")
          (json-kv-str! sb "url" (.url ev))
          (sb-push-str! sb ",")
          (json-kv-int! sb "status" (.status ev))
          (sb-push-str! sb ",\"statusText\":\"\",\"headers\":")
          (json-header-object! sb (.resp-headers ev))
          (sb-push-str! sb ",")
          (json-kv-str! sb "mimeType" (header-value (.resp-headers ev) "content-type"))
          (sb-push-str! sb ",\"connectionReused\":false,\"connectionId\":0,")
          (json-kv-int! sb "encodedDataLength" (.body-len ev))
          (sb-push-str! sb ",\"fromDiskCache\":false,\"fromServiceWorker\":false,")
          (json-kv-str! sb "protocol" "")
          (sb-push-str! sb ",\"securityState\":\"unknown\"}}}")
          (cdp-send! s (sb-str (load sb)))
          (sb-free! sb)
          (set! sb (sb-new (load (field s a))))
          (sb-push-str! sb "{\"method\":\"Network.loadingFinished\",\"params\":{\"requestId\":")
          (request-id! sb (.id ev))
          (sb-push-str! sb ",\"timestamp\":")
          (json-secs! sb t)
          (sb-push-str! sb ",")
          (json-kv-int! sb "encodedDataLength" (.body-len ev))
          (sb-push-str! sb "}}")
          (cdp-send! s (sb-str (load sb)))))
    (sb-free! sb)
    0))

; ---- the protocol server ----------------------------------------------------
(defn header-of [(req (ptr hsrv/Request)) (name (slice u8))] (-> (slice u8))
  (hsrv/header (load req) name))

(defn send-http [(s (ptr CdpSink)) (status (slice u8)) (ctype (slice u8)) (body (slice u8))] (-> i64)
  (let [sb (alloc/stack StrBuf)]
    (set! sb (sb-new (load (field s a))))
    (sb-push-str! sb "HTTP/1.1 ")
    (line! sb status)
    (sb-push-str! sb "Content-Type: ")
    (line! sb ctype)
    (sb-push-str! sb "Content-Length: ")
    (json-int! sb (slice-len body))
    (sb-push-str! sb "\r\n")
    (line! sb "Connection: close")
    (sb-push-str! sb "\r\n")
    (sb-push-str! sb body)
    (send-raw s (sb-str (load sb)))
    (sb-free! sb)
    0))

;; The `/json/*` endpoints Chrome uses to discover a target. Chrome's own
;; `chrome://inspect` list is populated from these; attaching by URL does not
;; need them, but a target that cannot be discovered is much harder to find.
(defn send-targets [(s (ptr CdpSink))] (-> i64)
  (let [sb (alloc/stack StrBuf)]
    (set! sb (sb-new (load (field s a))))
    (sb-push-str! sb
                  "[{\"description\":\"coil httptap\",\"id\":\"httptap\",\"title\":\"coil httptap\",\"type\":\"node\",\"url\":\"\",\"webSocketDebuggerUrl\":\"ws://")
    (sb-push-str! sb (.host s))
    (sb-push-str! sb ":")
    (json-int! sb (.port s))
    (sb-push-str! sb "/httptap\"}]")
    (send-http s "200 OK" "application/json; charset=UTF-8" (sb-str (load sb)))
    (sb-free! sb)
    0))

(defn send-version [(s (ptr CdpSink))] (-> i64)
  (send-http s
             "200 OK"
             "application/json; charset=UTF-8"
             "{\"Browser\":\"coil-httptap/1.0\",\"Protocol-Version\":\"1.3\"}"))

;; Complete the RFC 6455 handshake and release everything queued so far, under
;; the write lock so the application thread cannot interleave a frame into the
;; middle of the flush.
(defn do-handshake [(s (ptr CdpSink)) (key (slice u8))] (-> i64)
  (let [sb (alloc/stack StrBuf)]
    (set! sb (sb-new (load (field s a))))
    (line! sb "HTTP/1.1 101 Switching Protocols")
    (line! sb "Upgrade: websocket")
    (line! sb "Connection: Upgrade")
    (sb-push-str! sb "Sec-WebSocket-Accept: ")
    (ws/accept-key! sb (load (field s a)) key)
    (sb-push-str! sb "\r\n\r\n")
    (sync/mutex-lock! (field s write-lock))
    (send-raw s (sb-str (load sb)))
    (send-raw s (sb-str (.pending s)))
    (sb-free! (field s pending))
    (set! (.pending s) (sb-new (load (field s a))))
    (set! (.attached s) true)
    (sync/mutex-unlock! (field s write-lock))
    (sb-free! sb)
    (fmt (stderr) "httptap: DevTools attached\n")
    0))

;; The integer value of a top-level `"key": <number>` or `"key": "<number>"`,
;; or -1 when absent. Scanning past the separator rather than matching a fixed
;; `"key":"` string matters: JSON permits whitespace around `:`, and a client
;; that pretty-prints its commands would otherwise read as having no fields at
;; all — silently, since every value would come back 0.
(defn field-int [(msg (slice u8)) (key (slice u8))] (-> i64)
  (match (str-find msg key)
    (None [] -1)
    (Some [at]
          (let [n (slice-len msg)
                (mut i) (+ at (slice-len key))
                (mut v) -1]
            ; skip the separator run: whitespace, the colon, an opening quote
            (loop (if (>= (load i) n)
                      (break)
                      (let [c (primitive/cast i64 (slice-get msg (load i)))]
                        (if (if (= c 58) true (if (= c 32) true (if (= c 34) true (if (= c 9) true (= c 10)))))
                            (do (set! i (+ (load i) 1)) 0)
                            (break)))))
            (loop (if (>= (load i) n)
                      (break)
                      (let [c (primitive/cast i64 (slice-get msg (load i)))]
                        (if (if (>= c 48) (<= c 57) false)
                            (do
                              (set! v (+ (* (if (< (load v) 0) 0 (load v)) 10) (- c 48)))
                              (set! i (+ (load i) 1))
                              0)
                            (break)))))
            (load v)))))

(defn contains? [(msg (slice u8)) (needle (slice u8))] (-> bool)
  (match (str-find msg needle) (None [] false) (Some [at] true)))

;; Answer one protocol command. Every command gets a reply — DevTools waits on
;; the ids it sent, and an unanswered one stalls the panel — so anything this
;; endpoint does not implement returns an empty result rather than nothing.
(defn handle-command [(s (ptr CdpSink)) (msg (slice u8))] (-> i64)
  (let [sb (alloc/stack StrBuf)
        id (field-int msg "\"id\"")
        body-req (contains? msg "Network.getResponseBody")]
    (if (< id 0)
        0
        (do
          (set! sb (sb-new (load (field s a))))
          (sb-push-str! sb "{\"id\":")
          (json-int! sb id)
          (if body-req
              (let [rid (field-int msg "\"requestId\"")]
                (sync/mutex-lock! (field s state-lock))
                (let [body (find-body s rid)]
                  (sb-push-str! sb ",\"result\":{\"base64Encoded\":")
                  (if (utf8-ok? body)
                      (do
                        (sb-push-str! sb "false,\"body\":")
                        (json-str! sb body))
                      (do
                        (sb-push-str! sb "true,\"body\":\"")
                        (b64-into! sb body)
                        (sb-push-str! sb "\"")))
                  (sb-push-str! sb "}}"))
                (sync/mutex-unlock! (field s state-lock))
                0)
              (sb-push-str! sb ",\"result\":{}}"))
          (cdp-send! s (sb-str (load sb)))
          (sb-free! sb)
          0))))

;; Read frames until the socket closes. Blocking reads are fine here: this
;; thread never writes on its own initiative, and the application thread writes
;; independently under the write lock.
(defn serve-frames [(s (ptr CdpSink))] (-> i64)
  (let [a (load (field s a))
        buf (alloc/stack StrBuf)
        chunk (alloc/stack (array i8 8192))
        frame (alloc/stack ws/Frame)
        (mut running) true]
    (set! buf (sb-new a))
    (loop (if (not (load running))
              (break)
              (match (sock/tcp-read (field s conn) (primitive/index chunk 0) READ-CHUNK)
                (Err [e] (do (set! running false) 0))
                (Ok [n]
                    (if (<= n 0)
                        (do (set! running false) 0)
                        (do
                          (let [(mut i) 0]
                            (loop (if (>= (load i) n)
                                      (break)
                                      (do
                                        (sb-push-byte! buf (primitive/cast u8 (load (primitive/index chunk (load i)))))
                                        (set! i (+ (load i) 1))))))
                          ; Drain every complete frame the buffer now holds; a read can
                          ; deliver several, and DevTools pipelines its commands.
                          (let [(mut more) true]
                            (loop (if (not (load more))
                                      (break)
                                      (do
                                        (ws/decode-frame frame (sb-str (load buf)))
                                        (if (= (.consumed frame) 0)
                                            (do (set! more false) 0)
                                            (do
                                              (let [op (.opcode frame)]
                                                (cond (= op ws/WS-TEXT) (handle-command s (load (field frame payload)))
                                                      (= op ws/WS-PING)
                                                        (let [pong (alloc/stack StrBuf)]
                                                          (store! pong (sb-new a))
                                                          (ws/frame-control! pong ws/WS-PONG)
                                                          (sync/mutex-lock! (field s write-lock))
                                                          (send-raw s (sb-str (load pong)))
                                                          (sync/mutex-unlock! (field s write-lock))
                                                          (sb-free! pong)
                                                          0)
                                                      (= op ws/WS-CLOSE)
                                                        (do (store! running false) (store! more false) 0)
                                                      :else 0))
                                              (let [rest
                                                      (subslice (sb-str (load buf))
                                                                (.consumed frame)
                                                                (slice-len (sb-str (load buf))))
                                                    next (alloc/stack StrBuf)]
                                                (set! next (sb-new a))
                                                (sb-push-str! next rest)
                                                (sb-free! buf)
                                                (set! buf (load next))
                                                0)
                                              0))))))
                          0))))))
    (sb-free! buf)
    0))

;; One connection, from the first byte to either an upgraded WebSocket or a
;; `/json` reply.
(defn serve-connection [(s (ptr CdpSink))] (-> i64)
  (let [a (load (field s a))
        buf (alloc/stack StrBuf)
        chunk (alloc/stack (array i8 8192))
        (mut reading) true
        (mut ok) false]
    (set! buf (sb-new a))
    (loop (if (not (load reading))
              (break)
              (match (sock/tcp-read (field s conn) (primitive/index chunk 0) READ-CHUNK)
                (Err [e] (do (set! reading false) 0))
                (Ok [n]
                    (if (<= n 0)
                        (do (set! reading false) 0)
                        (do
                          (let [(mut i) 0]
                            (loop (if (>= (load i) n)
                                      (break)
                                      (do
                                        (sb-push-byte! buf (primitive/cast u8 (load (primitive/index chunk (load i)))))
                                        (set! i (+ (load i) 1))))))
                          ; Headers end at the blank line; the body of a discovery GET is
                          ; empty and an upgrade has no body at all.
                          (match (str-find (sb-str (load buf)) "\r\n\r\n")
                            (None [] 0)
                            (Some [at] (do (set! reading false) (set! ok true) 0)))
                          0))))))
    (if (load ok)
        (match (hsrv/parse-request a (sb-str (load buf)))
          (Err [e] 0)
          (Ok [req]
              (let [rp (alloc/stack hsrv/Request)]
                (set! rp req)
                (let [key (header-of rp "sec-websocket-key")
                      target (hsrv/target req)]
                  (cond (> (slice-len key) 0) (do (do-handshake s key) (serve-frames s) 0)
                        (= target "/json/version") (send-version s)
                        :else (send-targets s))))))
        0)
    (sb-free! buf)
    (sock/tcp-connection-close! (field s conn))
    0))

(defn server-thread [(arg (ptr i8))] (-> (ptr i8))
  (let [s (primitive/cast (ptr CdpSink) arg)
        (mut running) true]
    (loop (if (not (load running))
              (break)
              (match (sock/tcp-accept (field s listener) (field s conn))
                (Err [e] (do (set! running false) 0))
                (Ok [c]
                    (do
                      (serve-connection s)
                      (sync/mutex-lock! (field s write-lock))
                      (set! (.attached s) false)
                      (sync/mutex-unlock! (field s write-lock))
                      0)))))
    (primitive/cast (ptr i8) 0)))

;; Nothing to flush — events went out as they happened. What this does is hold
;; the process open when asked, because a program that exits the moment its last
;; request finishes gives you nothing to look at.
(defn cdp-close [(ctx (ptr i8))] (-> i64)
  (let [s (primitive/cast (ptr CdpSink) ctx)]
    (if (.attached s)
        (do
          (fmt (stderr) "httptap: program finished; DevTools still attached, Ctrl-C to exit\n")
          (let [(mut waiting) true]
            (loop (if (not (load waiting))
                      (break)
                      (do
                        (nap-ms 200)
                        (if (.attached s) 0 (do (set! waiting false) 0))))))
          0)
        0)))

;; `spec` is `PORT` or `HOST:PORT`. Binding failure is reported by returning
;; false: a live tap that never came up must not be mistaken for a quiet one.
(defn split-host [(spec (slice u8))] (-> (slice u8))
  (match (str-find spec ":") (None [] "127.0.0.1") (Some [at] (subslice spec 0 at))))

(defn split-port [(spec (slice u8))] (-> i64)
  (let [text
          (match (str-find spec ":")
            (None [] spec)
            (Some [at] (subslice spec (+ at 1) (slice-len spec))))]
    (match (str-parse-int text) (None [] 0) (Some [p] p))))

(defn cdp-install! [(a (ptr alloc/Allocator)) (spec (slice u8)) (wait bool)] (-> bool)
  (let [s (cdp-sink)
        host (split-host spec)
        port (split-port spec)]
    (if (<= port 0)
        false
        (do
          (set! (.a s) a)
          (set! (.host s) host)
          (set! (.port s) port)
          (set! (.attached s) false)
          (set! (.pending s) (sb-new a))
          (set! (.bodies s) (al-new [BodyRecord] a))
          (set! (.started-ns s) (rt/mono-ns))
          (sync/mutex-init (field s write-lock))
          (sync/mutex-init (field s state-lock))
          (match (sock/tcp-listen a (field s listener) host port true 4)
            (Err [e] false)
            (Ok [l]
                (let [th (alloc/stack thread/Thread)
                      sink (alloc/stack rt/TapSink)]
                  (if (!= (primitive/cast i64
                                          (thread/thread-spawn th
                                                               (primitive/fnptr-of server-thread)
                                                               (primitive/cast (ptr i8) s)))
                          0)
                      false
                      (do
                        (fmt (stderr) "httptap: DevTools endpoint on ws://{s}:{d}/httptap\n" host port)
                        (fmt (stderr)
                             "httptap: open devtools://devtools/bundled/inspector.html?ws={s}:{d}/httptap\n"
                             host
                             port)
                        (set! (.context sink) (primitive/cast (ptr i8) s))
                        (set! (.on-start sink) (primitive/fnptr-of cdp-start))
                        (set! (.on-finish sink) (primitive/fnptr-of cdp-finish))
                        (set! (.on-close sink) (primitive/fnptr-of cdp-close))
                        (rt/tap-set-sink! (load sink))
                        (if wait
                            (do
                              (fmt (stderr) "httptap: waiting for DevTools to attach...\n")
                              (let [(mut w) true]
                                (loop (if (not (load w))
                                          (break)
                                          (do
                                            (nap-ms 100)
                                            (if (.attached s) (do (set! w false) 0) 0))))))
                            0)
                        true)))))))))
