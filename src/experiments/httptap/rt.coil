; ── DIALECT: httptap — runtime core ───────────────────────────────────────
; The part of the HTTP tap that exists at RUN time: what an intercepted call
; records, where it gets sent, and the plumbing in between.
;
; The compile-time half lives in `httptap.coil` (the transform). It rewrites
; every call to `coil.http.client/request` / `request-stream` into a call to
; `tap-request` / `tap-request-stream` here, passing a `Site` describing where in
; the program the call came from. Nothing here knows about the transform, and
; nothing here is specific to a destination: a destination is a `TapSink` —
; three function pointers and a context — installed once at start-up.
; `httptap.boot` picks one from the environment; anyone can install their own
; with `tap-set-sink!`.
(module httptap.rt)
(import "coil.primitive" :as primitive)
(import "coil.alloc" :as alloc :use *)
(import "coil.slice" :use *)
(import "coil.str" :use *)
(import "coil.io" :as io :use *)
(import "coil.fmt" :use *)
(import "coil.time" :as time)
(import "coil.http.client" :as http)

(extern atexit :cc c [(fnptr c [] i64)] (-> i32))

;; Where in the program an intercepted call came from. Every field is a compile
;; time constant baked in by the transform, so recording it costs nothing at run
;; time and cannot drift from the source.
(defstruct Site
  [(module (slice u8))
   (func (slice u8))
   (file (slice u8))
   (line i64)
   (col i64)])

;; One intercepted HTTP request and whatever came back. The slices BORROW the
;; caller's memory and are valid only for the duration of the sink callback: a
;; sink that keeps an event past `on-finish` must copy what it needs.
;;
;; `failed` separates a transport or allocation failure (`error` says which) from
;; an HTTP error status, which is a perfectly successful request that happens to
;; carry a 4xx/5xx `status`. `body-len` is the FULL body length even when `body`
;; was truncated to the capture cap, so a report can say how much it dropped.
(defstruct TapEvent
  [(id i64)
   (site Site)
   (method (slice u8))
   (url (slice u8))
   (req-headers (slice http/Header))
   (req-body (slice u8))
   (connect-timeout-ms i64)
   (timeout-ms i64)
   (follow-redirects bool)
   (streamed bool)
   (start-mono-ns i64)
   (end-mono-ns i64)
   (start-wall-ms i64)
   (status i64)
   (resp-headers (slice http/Header))
   (resp-body (slice u8))
   (body-len i64)
   (truncated bool)
   (stopped bool)
   (failed bool)
   ; The transport's own code, kept apart from `status`. Putting a curl errno in
   ; `status` would render as an HTTP status in every viewer downstream.
   (error-code i64)
   (error (slice u8))])

;; A destination for tapped requests. `on-start` fires before the request goes
;; out (the response fields are still empty); `on-finish` fires once it has
;; completed or failed; `on-close` fires once at process exit, which is where a
;; sink that batches gets to write its file. `context` is the sink's own state,
;; handed back to every callback untouched.
;;
;; The start/finish split is what lets one interface serve both kinds of
;; destination: a live viewer wants to show a request while it is in flight, a
;; file format wants one finished record.
(defstruct TapSink
  [(context (ptr i8))
   (on-start (fnptr c [(ptr i8) (ptr TapEvent)] i64))
   (on-finish (fnptr c [(ptr i8) (ptr TapEvent)] i64))
   (on-close (fnptr c [(ptr i8)] i64))])

(defstruct TapState
  [(inited i64)
   (closed i64)
   (sink TapSink)
   (next-id i64)
   (max-body i64)])

(defn tap-state [] (-> (ptr TapState))
  (alloc/static TapState))

; ---- the sink that does nothing ---------------------------------------------
; Installed until `tap-set-sink!` replaces it, so an untapped build costs one
; predictable indirect call per request instead of a null test at every use.
(defn noop-start [(ctx (ptr i8)) (ev (ptr TapEvent))] (-> i64)
  0)
(defn noop-finish [(ctx (ptr i8)) (ev (ptr TapEvent))] (-> i64)
  0)
(defn noop-close [(ctx (ptr i8))] (-> i64)
  0)

(defn tap-null-sink [] (-> TapSink)
  (let [s (alloc/stack TapSink)]
    (set! (.context s) (primitive/cast (ptr i8) 0))
    (set! (.on-start s) (primitive/fnptr-of noop-start))
    (set! (.on-finish s) (primitive/fnptr-of noop-finish))
    (set! (.on-close s) (primitive/fnptr-of noop-close))
    (load s)))

;; Run the installed sink's `on-close`. Registered with `atexit` the first time
;; the tap initializes, so a batching sink flushes even when the program never
;; asks it to. Idempotent: a second call does nothing.
(defn tap-close! [] (-> i64)
  (let [st (tap-state)]
    (if (= (.closed st) 0)
        (do
          (set! (.closed st) 1)
          (primitive/call-ptr (.on-close (.sink st))
                              (load (field (field st sink) context)))
          0)
        0)))

;; Bring the tap up with the null sink, cap body capture at `max-body` bytes and
;; arrange for `tap-close!` at exit. Idempotent; `httptap.boot` calls it before
;; installing whichever sink the environment asked for.
(defn tap-init! [(max-body i64)] (-> i64)
  (let [st (tap-state)]
    (if (= (.inited st) 0)
        (do
          (set! (.inited st) 1)
          (set! (.next-id st) 1)
          (set! (.max-body st) max-body)
          (set! (.sink st) (tap-null-sink))
          (atexit (primitive/fnptr-of tap-close!))
          0)
        0)))

;; Install a destination. Replaces whatever was there; the previous sink is NOT
;; closed, because two sinks at once is not a supported configuration and
;; quietly closing one would hide the mistake.
(defn tap-set-sink! [(s TapSink)] (-> i64)
  (do
    (tap-init! 65536)
    (set! (.sink (tap-state)) s)
    0))

;; The body-capture cap in bytes. Sinks truncate to this and report `body-len`
;; separately so a truncated body is never mistaken for a short one.
(defn tap-max-body [] (-> i64)
  (.max-body (tap-state)))

(defn tap-set-max-body! [(n i64)] (-> i64)
  (do (set! (.max-body (tap-state)) n) 0))

(defn tap-next-id [] (-> i64)
  (let [st (tap-state)
        id (.next-id st)]
    (set! (.next-id st) (+ id 1))
    id))

; ---- clocks -----------------------------------------------------------------
(defn mono-ns [] (-> i64)
  (match (time/monotonic-now)
    (Err [e] 0)
    (Ok [i]
        (let [p (alloc/stack time/Instant)]
          (set! p i)
          (+ (* (.sec p) 1000000000) (.nsec p))))))

(defn wall-ms [] (-> i64)
  (match (time/wall-now-ms) (Err [e] 0) (Ok [ms] ms)))

; ---- a Writer that appends to a StrBuf --------------------------------------
; Gives every sink the whole of `coil.fmt` for building JSON in memory, rather
; than a hand-rolled integer formatter per sink.
(defn sb-write [(ctx (ptr i8)) (buf (ptr i8)) (len i64)] (-> (Result i64 io/IoError))
  (let [sb (primitive/cast (ptr StrBuf) ctx)
        (mut i) 0]
    (loop (if (>= (load i) len)
              (break)
              (do
                (sb-push-byte! sb (primitive/cast u8 (load (primitive/index buf (load i)))))
                (set! i (+ (load i) 1)))))
    (Ok len)))

(defn sb-writer [(w (ptr io/Writer)) (sb (ptr StrBuf))] (-> (ptr io/Writer))
  (set! (.write-fn w) (primitive/fnptr-of sb-write))
  (set! (.ctx w) (primitive/cast (ptr i8) sb))
  w)

; ---- JSON emission ----------------------------------------------------------
(defn hex-digit [(n i64)] (-> u8)
  (if (< n 10) (primitive/cast u8 (+ n 48)) (primitive/cast u8 (+ n 87))))

;; Append `s` as a complete JSON string literal, quotes included. Escapes what
;; RFC 8259 requires and \u-escapes every other control byte. Bytes >= 0x80 pass
;; through unchanged, so a body that is valid UTF-8 stays readable; deciding
;; whether it IS valid is `utf8-ok?`'s job, not this function's.
(defn json-escape-byte! [(sb (ptr StrBuf)) (c i64)] (-> i64)
  (cond (= c 34) (sb-push-str! sb "\\\"")
        (= c 92) (sb-push-str! sb "\\\\")
        (= c 10) (sb-push-str! sb "\\n")
        (= c 13) (sb-push-str! sb "\\r")
        (= c 9) (sb-push-str! sb "\\t")
        (= c 8) (sb-push-str! sb "\\b")
        (= c 12) (sb-push-str! sb "\\f")
        (< c 32)
          (do
            (sb-push-str! sb "\\u00")
            (sb-push-byte! sb (hex-digit (/ c 16)))
            (sb-push-byte! sb (hex-digit (% c 16))))
        :else (sb-push-byte! sb (primitive/cast u8 c))))

(defn json-str! [(sb (ptr StrBuf)) (s (slice u8))] (-> i64)
  (let [n (slice-len s)
        (mut i) 0]
    (sb-push-byte! sb (primitive/cast u8 34))
    (loop (if (>= (load i) n)
              (break)
              (do
                (json-escape-byte! sb (primitive/cast i64 (slice-get s (load i))))
                (set! i (+ (load i) 1)))))
    (sb-push-byte! sb (primitive/cast u8 34))))

(defn json-int! [(sb (ptr StrBuf)) (n i64)] (-> i64)
  (let [w (alloc/stack io/Writer)]
    (print-i (sb-writer w sb) n)
    0))

;; `"key":<int>`. The separating comma is the caller's business, which keeps
;; every emitter honest about trailing commas instead of guessing.
(defn json-kv-int! [(sb (ptr StrBuf)) (key (slice u8)) (n i64)] (-> i64)
  (do (json-str! sb key) (sb-push-str! sb ":") (json-int! sb n) 0))

(defn json-kv-str! [(sb (ptr StrBuf)) (key (slice u8)) (v (slice u8))] (-> i64)
  (do (json-str! sb key) (sb-push-str! sb ":") (json-str! sb v) 0))

(defn json-kv-bool! [(sb (ptr StrBuf)) (key (slice u8)) (v bool)] (-> i64)
  (do
    (json-str! sb key)
    (sb-push-str! sb ":")
    (sb-push-str! sb (if v "true" "false"))
    0))

;; Headers as a JSON array of `{"name":…,"value":…}` — the shape HAR wants, and
;; one repeated header stays one entry per occurrence.
(defn json-headers! [(sb (ptr StrBuf)) (hs (slice http/Header))] (-> i64)
  (let [n (slice-len hs)
        (mut i) 0]
    (sb-push-str! sb "[")
    (loop (if (>= (load i) n)
              (break)
              (do
                (if (> (load i) 0) (sb-push-str! sb ",") 0)
                (let [h (alloc/stack http/Header)]
                  (set! h (slice-get hs (load i)))
                  (sb-push-str! sb "{")
                  (json-kv-str! sb "name" (.name h))
                  (sb-push-str! sb ",")
                  (json-kv-str! sb "value" (.value h))
                  (sb-push-str! sb "}"))
                (set! i (+ (load i) 1)))))
    (sb-push-str! sb "]")))

;; Headers as a DevTools-protocol header OBJECT (`{"name":"value",…}`) rather
;; than an array. Repeated names collapse, which is what that protocol specifies.
(defn json-header-object! [(sb (ptr StrBuf)) (hs (slice http/Header))] (-> i64)
  (let [n (slice-len hs)
        (mut i) 0]
    (sb-push-str! sb "{")
    (loop (if (>= (load i) n)
              (break)
              (do
                (if (> (load i) 0) (sb-push-str! sb ",") 0)
                (let [h (alloc/stack http/Header)]
                  (set! h (slice-get hs (load i)))
                  (json-kv-str! sb (.name h) (.value h)))
                (set! i (+ (load i) 1)))))
    (sb-push-str! sb "}")))

;; A duration in nanoseconds, printed as fractional milliseconds with three
;; decimals — the unit HAR and the DevTools protocol both use. Integer
;; milliseconds would round every fast local request to 0 and make a timing
;; column useless exactly where it is most interesting.
(defn json-ms! [(sb (ptr StrBuf)) (ns i64)] (-> i64)
  (let [n (if (< ns 0) 0 ns)
        whole (/ n 1000000)
        frac (/ (% n 1000000) 1000)]
    (json-int! sb whole)
    (sb-push-str! sb ".")
    (sb-push-byte! sb (primitive/cast u8 (+ 48 (/ frac 100))))
    (sb-push-byte! sb (primitive/cast u8 (+ 48 (% (/ frac 10) 10))))
    (sb-push-byte! sb (primitive/cast u8 (+ 48 (% frac 10))))
    0))

(defn ascii-lower [(c i64)] (-> i64)
  (if (if (>= c 65) (<= c 90) false) (+ c 32) c))

(defn header-name-eq? [(a (slice u8)) (b (slice u8))] (-> bool)
  (if (!= (slice-len a) (slice-len b))
      false
      (let [n (slice-len a)
            (mut i) 0
            (mut ok) true]
        (loop (if (if (>= (load i) n) true (not (load ok)))
                  (break)
                  (do
                    (if (= (ascii-lower (primitive/cast i64 (slice-get a (load i))))
                           (ascii-lower (primitive/cast i64 (slice-get b (load i)))))
                        0
                        (do (set! ok false) 0))
                    (set! i (+ (load i) 1)))))
        (load ok))))

;; Case-insensitive header lookup; an empty slice when absent. Header names are
;; case-insensitive on the wire, so a sink that string-compares `Content-Type`
;; will miss a server that sends `content-type`.
(defn header-value [(hs (slice http/Header)) (name (slice u8))] (-> (slice u8))
  (let [n (slice-len hs)
        (mut i) 0
        (mut found) ""]
    (loop (if (>= (load i) n)
              (break)
              (do
                (let [h (alloc/stack http/Header)]
                  (set! h (slice-get hs (load i)))
                  (if (header-name-eq? (.name h) name)
                      (do (set! found (.value h)) 0)
                      0))
                (set! i (+ (load i) 1)))))
    (load found)))

;; The provenance block. This is the whole reason the tap is a metaprogram
;; rather than a curl wrapper: the destination learns which module, function,
;; file and line issued the request.
(defn json-site! [(sb (ptr StrBuf)) (s (ptr Site))] (-> i64)
  (do
    (sb-push-str! sb "{")
    (json-kv-str! sb "module" (.module s))
    (sb-push-str! sb ",")
    (json-kv-str! sb "function" (.func s))
    (sb-push-str! sb ",")
    (json-kv-str! sb "file" (.file s))
    (sb-push-str! sb ",")
    (json-kv-int! sb "line" (.line s))
    (sb-push-str! sb ",")
    (json-kv-int! sb "column" (.col s))
    (sb-push-str! sb "}")
    0))

; ---- base64 -----------------------------------------------------------------
; Earns its place twice: HAR carries a non-text body as base64, and the
; WebSocket handshake's accept key is base64 of a SHA-1 digest.
(defn b64-char [(n i64)] (-> u8)
  (if (< n 26)
      (primitive/cast u8 (+ n 65))
      (if (< n 52)
          (primitive/cast u8 (+ n 71))
          (if (< n 62)
              (primitive/cast u8 (- n 4))
              (if (= n 62) (primitive/cast u8 43) (primitive/cast u8 47))))))

(defn b64-into! [(sb (ptr StrBuf)) (s (slice u8))] (-> i64)
  (let [n (slice-len s)
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (let [i0 (load i)
                    rem (- n i0)
                    b0 (primitive/cast i64 (slice-get s i0))
                    b1 (if (> rem 1) (primitive/cast i64 (slice-get s (+ i0 1))) 0)
                    b2 (if (> rem 2) (primitive/cast i64 (slice-get s (+ i0 2))) 0)]
                (sb-push-byte! sb (b64-char (primitive/ishr b0 2)))
                (sb-push-byte! sb
                               (b64-char (primitive/ior (primitive/iand (primitive/ishl b0 4) 63)
                                                        (primitive/ishr b1 4))))
                (if (> rem 1)
                    (sb-push-byte! sb
                                   (b64-char (primitive/ior (primitive/iand (primitive/ishl b1 2) 63)
                                                            (primitive/ishr b2 6))))
                    (sb-push-byte! sb (primitive/cast u8 61)))
                (if (> rem 2)
                    (sb-push-byte! sb (b64-char (primitive/iand b2 63)))
                    (sb-push-byte! sb (primitive/cast u8 61)))
                (set! i (+ i0 3)))))
    0))

;; True when `s` is well-formed UTF-8, i.e. safe to drop into a JSON string
;; as-is. A sink asks this to choose between a text body and a base64 one;
;; guessing wrong produces a file no viewer will open.
(defn utf8-cont-ok? [(s (slice u8)) (at i64) (need i64)] (-> bool)
  (let [(mut k) 1
        (mut ok) true]
    (loop (if (if (> (load k) need) true (not (load ok)))
              (break)
              (do
                (if (= (primitive/iand (primitive/cast i64 (slice-get s (+ at (load k)))) 192) 128)
                    0
                    (do (set! ok false) 0))
                (set! k (+ (load k) 1)))))
    (load ok)))

(defn utf8-need [(c i64)] (-> i64)
  (if (< c 128)
      0
      (if (< c 194)
          -1
          (if (< c 224)
              1
              (if (< c 240)
                  2
                  (if (< c 245) 3 -1))))))

(defn utf8-ok? [(s (slice u8))] (-> bool)
  (let [n (slice-len s)
        (mut i) 0
        (mut ok) true]
    (loop (if (if (>= (load i) n) true (not (load ok)))
              (break)
              (let [need (utf8-need (primitive/cast i64 (slice-get s (load i))))]
                (if (< need 0)
                    (do (set! ok false) 0)
                    (if (> (+ (load i) need) (- n 1))
                        (do (set! ok false) 0)
                        (if (utf8-cont-ok? s (load i) need)
                            (do (set! i (+ (load i) need)) 0)
                            (do (set! ok false) 0))))
                (set! i (+ (load i) 1)))))
    (load ok)))

;; The body a sink should record: the first `tap-max-body` bytes. Pair it with
;; the event's `body-len` to know whether anything was dropped.
(defn tap-capped [(s (slice u8))] (-> (slice u8))
  (let [cap (tap-max-body)
        n (slice-len s)]
    (if (> n cap) (subslice s 0 cap) s)))

; ---- the intercept ----------------------------------------------------------
(defn mk-site [(mod-name (slice u8)) (fn-name (slice u8)) (file (slice u8)) (line i64) (col i64)] (-> Site)
  (let [s (alloc/stack Site)]
    (set! (.module s) mod-name)
    (set! (.func s) fn-name)
    (set! (.file s) file)
    (set! (.line s) line)
    (set! (.col s) col)
    (load s)))

(defn event-from-request [(ev (ptr TapEvent)) (site Site) (req (ptr http/Request)) (streamed bool)] (-> i64)
  (do
    (set! ev (primitive/zeroed TapEvent))
    (set! (.id ev) (tap-next-id))
    (set! (.site ev) site)
    (set! (.method ev) (.method req))
    (set! (.url ev) (.url req))
    (set! (.req-headers ev) (.headers req))
    (set! (.req-body ev) (.body req))
    (set! (.connect-timeout-ms ev) (.connect-timeout-ms req))
    (set! (.timeout-ms ev) (.timeout-ms req))
    (set! (.follow-redirects ev) (.follow-redirects req))
    (set! (.streamed ev) streamed)
    (set! (.start-wall-ms ev) (wall-ms))
    (set! (.start-mono-ns ev) (mono-ns))
    0))

; The `inited` guard is not belt-and-braces: the transform rewrites call sites,
; and a rewritten call can run before `main` does (a static initializer, a
; constructor in linked C). Until the state has a sink in it, the vtable is all
; zeroes, and dispatching through it would turn "no tap configured" into a null
; call. Untapped programs take this path on every request.
(defn fire-start [(ev (ptr TapEvent))] (-> i64)
  (let [st (tap-state)]
    (if (= (.inited st) 0)
        0
        (primitive/call-ptr (.on-start (.sink st))
                            (load (field (field st sink) context))
                            ev))))

(defn fire-finish [(ev (ptr TapEvent))] (-> i64)
  (let [st (tap-state)]
    (set! (.end-mono-ns ev) (mono-ns))
    (if (= (.inited st) 0)
        0
        (primitive/call-ptr (.on-finish (.sink st))
                            (load (field (field st sink) context))
                            ev))))

(defn error-message [(e http/HttpError)] (-> (slice u8))
  (match e
    (http/InvalidRequest [] "invalid request")
    (http/OutOfMemory [] "out of memory")
    (http/Transport [code message] message)))

(defn error-code [(e http/HttpError)] (-> i64)
  (match e (http/InvalidRequest [] -1) (http/OutOfMemory [] -2) (http/Transport [code message] code)))

;; The traced stand-in for `coil.http.client/request`. Same arguments, same
;; result, same ownership rules — the response is still the caller's to free.
;; The transform rewrites call sites to this; nothing else should call it.
(defn tap-request [(site Site) (a (ptr alloc/Allocator)) (req (ptr http/Request))] (-> (Result http/Response
                                                                                               http/HttpError))
  (let [ev (alloc/stack TapEvent)]
    (event-from-request ev site req false)
    (fire-start ev)
    (match (http/request a req)
      (Err [e]
           (do
             (set! (.failed ev) true)
             (set! (.error-code ev) (error-code e))
             (set! (.error ev) (error-message e))
             (fire-finish ev)
             (Err e)))
      (Ok [r]
          (do
            (set! (.status ev) (http/response-status r))
            (let [rp (alloc/stack http/Response)]
              (set! rp r)
              (set! (.resp-headers ev) (.headers rp)))
            (let [body (http/response-body r)
                  cap (tap-capped body)]
              (set! (.resp-body ev) cap)
              (set! (.body-len ev) (slice-len body))
              (set! (.truncated ev) (> (slice-len body) (slice-len cap))))
            (fire-finish ev)
            (Ok r))))))

; ---- streaming --------------------------------------------------------------
; `request-stream` never buffers the body, so the tap cannot read it afterwards.
; It interposes its own sink between curl and the caller's: every chunk is
; forwarded unchanged and a prefix is copied aside for the report, so the
; caller's contract — including its BODY-STOP — is preserved exactly.
(defstruct StreamTap
  [(inner http/BodySink)
   (buf (ptr u8))
   (kept i64)
   (total i64)])

(defn stream-trampoline [(data (ptr u8)) (n i64) (ctx (ptr i8))] (-> i64)
  (let [t (primitive/cast (ptr StreamTap) ctx)
        cap (tap-max-body)
        kept (.kept t)
        room (- cap kept)
        take (if (< n room) n room)]
    (set! (.total t) (+ (.total t) n))
    (if (> take 0)
        (do
          (let [(mut i) 0]
            (loop (if (>= (load i) take)
                      (break)
                      (do
                        (set! (primitive/index (load (field t buf)) (+ kept (load i)))
                              (load (primitive/index data (load i))))
                        (set! i (+ (load i) 1))))))
          (set! (.kept t) (+ kept take))
          0)
        0)
    (primitive/call-ptr (.consume (.inner t))
                        data
                        n
                        (load (field (field t inner) context)))))

;; The traced stand-in for `coil.http.client/request-stream`. The caller's sink
;; still sees every byte, in order, with the same chunk boundaries; the tap keeps
;; only the first `tap-max-body` of them.
(defn tap-request-stream [(site Site) (a (ptr alloc/Allocator)) (req (ptr http/Request)) (sink http/BodySink)] (-> (Result http/StreamingResponse
                                                                                                                           http/HttpError))
  (let [ev (alloc/stack TapEvent)
        t (alloc/stack StreamTap)
        wrapper (alloc/stack http/BodySink)
        cap (tap-max-body)]
    (event-from-request ev site req true)
    (match (raw-alloc a cap 1)
      (None []
            (do
              (set! (.failed ev) true)
              (set! (.error ev) "httptap: out of memory capturing stream")
              (fire-start ev)
              (fire-finish ev)
              (http/request-stream a req sink)))
      (Some [raw]
            (let [buf (primitive/cast (ptr u8) raw)]
              (set! (.inner t) sink)
              (set! (.buf t) buf)
              (set! (.kept t) 0)
              (set! (.total t) 0)
              (set! (.context wrapper) (primitive/cast (ptr i8) t))
              (set! (.consume wrapper) (primitive/fnptr-of stream-trampoline))
              (fire-start ev)
              (match (http/request-stream a req (load wrapper))
                (Err [e]
                     (do
                       (set! (.failed ev) true)
                       (set! (.error-code ev) (error-code e))
                       (set! (.error ev) (error-message e))
                       (set! (.body-len ev) (.total t))
                       (fire-finish ev)
                       (raw-free a raw cap 1)
                       (Err e)))
                (Ok [r]
                    (do
                      (set! (.status ev) (http/streaming-response-status r))
                      (let [rp (alloc/stack http/StreamingResponse)]
                        (set! rp r)
                        (set! (.resp-headers ev) (.headers rp)))
                      (set! (.stopped ev) (http/streaming-response-stopped r))
                      (set! (.body-len ev) (.total t))
                      (set! (.truncated ev) (> (.total t) (.kept t)))
                      (set! (.resp-body ev) (slice-new buf (.kept t)))
                      (fire-finish ev)
                      (raw-free a raw cap 1)
                      (Ok r)))))))))
