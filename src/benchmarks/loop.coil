(module benchmark.loop)
(import "coil.primitive" :as primitive)
(import "coil.cc" :as cc)

; Tight integer loop, expressed as tail recursion (becomes a loop after TCO).
; Multiply-accumulate so the optimizer can't close-form the reduction.
(extern printf :cc (cc/C) [(ptr i8) ...] (-> i32))

(defn run [(i u64) (n u64) (acc u64)] (-> u64)
  (if (>= i n)
      acc
      (run (primitive/iadd i 1)
           n
           (primitive/iadd (primitive/imul acc 1000003) i))))

(defn main [] (-> i64)
  (do (printf c"%lu\n" (run 0 300000000 0)) 0))
