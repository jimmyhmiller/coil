(module benchmark.json-tape)
(import "coil.alloc" :as alloc)
(import "coil.fs" :as fs)
(import "coil.json" :as json)
(import "coil.str" :as str)
(import "coil.io" :as io)
(import "coil.fmt" :as fmt)

; Parse one already-loaded fixture repeatedly. The checksum makes every parse observable
; and gives the harness a correctness value to compare before timing.
(defn parse-many [(a (ptr alloc/Allocator)) (input (slice u8)) (iterations i64)] (-> i64)
  (let [(mut i) 0
        (mut checksum) 0
        (mut failed) false]
    (loop
      (if (>= (load i) iterations)
          (break)
          (match (json/parse a input)
            (Err [e]
              (do
                (println "json parse failed")
                (store! failed true)
                (break)))
            (Ok [doc]
              (let [(mut owned-doc) doc]
                (store! checksum (+ (load checksum) (json/token-count doc)))
                (json/doc-free! (mut owned-doc))
                (store! i (+ (load i) 1)))))))
    (if (load failed) -1 (load checksum))))

(defn main [(argc i32) (argv (ptr (ptr i8)))] (-> i64)
  (if (!= argc (cast i32 3))
      (do (println "usage: json_tape FIXTURE ITERATIONS") 2)
      (let [a (alloc/malloc-allocator)
            path (str/cstr->str (load (index argv 1)))
            iterations-opt (str/str-parse-int (str/cstr->str (load (index argv 2))))]
        (match iterations-opt
          (None [] (do (println "invalid iteration count") 2))
          (Some [iterations]
            (match (fs/read-file a path)
              (Err [e] (do (println "could not read fixture") 2))
              (Ok [input]
                (let [result (parse-many a input iterations)]
                  (if (< result 0)
                      1
                      (do
                        (fmt/fmt (io/stdout) "{d}\n" result)
                        0))))))))))
