(module benchmark.regex-literal)
(import "coil.regex" :as regex)
(import "coil.slice" :use [slice-new])
(import "coil.primitive" :as primitive)

(extern malloc :cc c [i64] (-> (ptr i8)))

(extern free :cc c [(ptr i8)] (-> void))

(extern printf :cc c [(ptr i8) ...] (-> i32))

(defn fill [(p (ptr u8)) (n i64)] (-> i64)
  (let [(mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (set! (index p (load i)) (cast u8 #\x))
                (set! i (+ (load i) 1)))))
    0))

(defn scan [(haystack (slice u8)) (rounds i64)] (-> i64)
  (let [(mut i) 0
        (mut matches) 0]
    (loop (if (>= (load i) rounds)
              (break)
              (do
                (when (regex/is-match? "Sherlock" haystack)
                  (set! matches (+ (load matches) 1)))
                (set! i (+ (load i) 1)))))
    (load matches)))

(defn main [] (-> i64)
  (let [n 16777216
        raw (malloc n)
        bytes (primitive/cast (ptr u8) raw)]
    (fill bytes n)
    (let [matches (scan (slice-new bytes n) 32)]
      (printf c"%lld\n" matches)
      (free raw)
      0)))
