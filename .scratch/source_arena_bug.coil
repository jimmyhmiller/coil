(module scratch.source-arena-bug)
(import "coil.primitive" :as primitive)
(import "coil.alloc" :as alloc :use *)
(import "coil.arraylist" :use *)
(import "coil.slice" :use *)
(import "coil.prop.source" :use *)
; REPRO: `source-new` turns the CALLER'S allocator into the case arena.
;
;   (defn source-new [(mem (ptr Allocator)) …]
;     (let [… a (arena-over-buffer ar mem buf arena-cap)]      ; <-- `mem`
;       (store! (field s tape)   (al-new [Choice] mem))
;       (store! (field s replay) (al-new [Choice] mem))
;       (store! (field s spans)  (al-new [Span]  mem))
;
; `arena-over-buffer` OVERWRITES the `Allocator` struct it is handed (alloc.coil:278),
; so after that binding `*mem` IS the arena — and the tape, the replay tape and the
; span table are then created over that same pointer. They allocate out of the case
; arena, and `source-reset!` rewinds the arena between cases, so the next generator
; that asks the arena for memory is handed the replay tape's storage.
;
; Below: replay the SAME tape twice. The first replay reproduces the value; the second
; sees a Choice whose kind has been overwritten by a generated value, degrades to
; ST-OVERRUN, and silently produces the minimum instead. Anything that replays a tape
; more than once — every shrink pass — is built on this. Driving `shrink-run!` on such
; a Source segfaults (its `seen` HashMap also ends up in the arena).
;
; Fix, in `source-new`: give the arena its own Allocator cell.
;   aa (unwrap-ptr [Allocator] (create [Allocator] mem))
;   a  (arena-over-buffer ar aa buf arena-cap)

(defn zero-bytes [(p (ptr u8)) (n i64)] (-> i64)
  (let [(mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do (store! (primitive/index p (load i)) (primitive/cast u8 0))
                  (store! i (primitive/iadd (load i) 1)))))
    0))

(defn prop [(s (ptr Source))] (-> i64)
  ; anything that allocates from the case arena will do; this is the shape of the
  ; stock `(impl [(T Arbitrary)] Arbitrary (ArrayList T))`
  (let [; an arena allocation BEFORE the first draw — a generator environment, or
        ; any generator that reserves storage up front. This is what lands on top
        ; of the replay tape.
        scratch (unwrap-ptr [u8] (alloc-slice [u8] (src-alloc s) 64))
        _init (zero-bytes scratch 64)
        sp (span-open! s "list" SPAN-PLAIN)
        n (draw-len! s 0 8)
        (mut l) (al-new [i64] (src-alloc s))
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (let [esp (span-open! s "elem" SPAN-ELEM)]
                (al-push! [i64] (mut l) (draw-int! s 0 1000))
                (span-close! s esp)
                (store! i (primitive/iadd (load i) 1))
                0)))
    (span-close! s sp)
    (al-len [i64] (load l))))

(defn main [] (-> i64)
  (let [mem (malloc-allocator)
        s (source-new mem 1048576 12345)]
    (source-begin-generate! s 30)
    (prop s)
    (let [(mut t) (tape-clone mem (src-tape s))]
      (println "generated: {d} choices" (al-len [Choice] (load t)))
      (source-begin-replay! s (mut t) 30)
      (println "replay 1:  {d} elements, status={d}" (prop s) (src-status s))
      (source-begin-replay! s (mut t) 30)
      (println "replay 2:  {d} elements, status={d}   <-- same tape, different value"
               (prop s) (src-status s)))
    0))
