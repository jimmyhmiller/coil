(module scratch.g8)
(import "coil.primitive" :as primitive)
(import "coil.alloc" :as alloc :use *)
(import "coil.arraylist" :use *)
(import "coil.slice" :use *)
(import "coil.prop.source" :use *)
(import "coil.prop.arbitrary" :use *)
(import "coil.prop.shrink" :use *)

(defstruct GenShrinkCtx [(src (ptr Source))])

;; the same span shape as gen-list-of: a "list" span with the length choice inside
;; it and one SPAN-ELEM per element — this is the stock ArrayList Arbitrary impl.
(defn shrink-prop [(s (ptr Source))] (-> bool)
  (let [sp (span-open! s "list" SPAN-PLAIN)
        n (draw-len! s 0 8)
        (mut sum) 0
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (let [esp (span-open! s "elem" SPAN-ELEM)]
                (store! sum (primitive/iadd (load sum) (draw-int! s 0 1000)))
                (span-close! s esp)
                (store! i (primitive/iadd (load i) 1))
                0)))
    (span-close! s sp)
    (< (load sum) 50)))

(defn shrink-candidate [(ctx (ptr i8)) (tape (ptr (ArrayList Choice)))] (-> bool)
  (let [c (primitive/cast (ptr GenShrinkCtx) ctx)
        s (load (field c src))]
    (source-begin-replay! s tape 30)
    (let [held (shrink-prop s)]
      (if (= (src-status s) ST-REJECTED) false (not held)))))

(defn main [] (-> i64)
  (let [mem (malloc-allocator)
        s (source-new mem 8388608 20260809)
        ctx (primitive/alloc-stack GenShrinkCtx)
        (mut found) false
        (mut i) 0]
    (store! (field ctx src) s)
    (loop (if (or (load found) (>= (load i) 2000))
              (break)
              (do (source-begin-generate! s 30)
                  (source-swarm! s -1)
                  (if (shrink-prop s) 0 (store! found true))
                  (store! i (primitive/iadd (load i) 1)))))
    (println "found={d} after {d} cases, tape={d}" (if (load found) 1 0) (load i)
             (al-len [Choice] (load (src-tape s))))
    (let [(mut failing) (tape-clone mem (src-tape s))
          (mut failing-spans) (spans-clone mem (src-spans s))
          sc (shrink-ctx-new mem s (primitive/fnptr-of shrink-candidate)
                             (primitive/cast (ptr i8) ctx) 20000)]
      (sc-seed-best! sc (mut failing) (mut failing-spans))
      (shrink-run! sc)
      (println "shrunk: calls={d} accepted={d} best={d}" (sc-calls sc) (sc-accepted sc)
               (al-len [Choice] (load (sc-best sc)))))
    0))
