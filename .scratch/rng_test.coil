(module rng_test)
(import "coil.prop.rng" :use *)
(import "coil.assert" :use *)
(import "coil.primitive" :as primitive)

(deftest rng-deterministic
  (let [(mut a) (rng-seed 12345)
        (mut b) (rng-seed 12345)]
    (assert-eq (primitive/cast i64 (rng-next! (mut a))) (primitive/cast i64 (rng-next! (mut b))))))

(deftest rng-below-in-range
  (let [(mut r) (rng-seed 99)
        (mut i) 0
        (mut ok) true]
    (loop (if (>= (load i) 10000)
              (break)
              (do (let [v (rng-below! (mut r) 10)]
                    (if (and (>= v 0) (< v 10)) 0 (store! ok false)))
                  (store! i (primitive/iadd (load i) 1)))))
    (assert (load ok))))

(deftest rng-covers-range
  (let [(mut r) (rng-seed 7)
        (mut seen) 0
        (mut i) 0]
    (loop (if (>= (load i) 2000)
              (break)
              (do (store! seen (primitive/ior (load seen)
                                              (primitive/ishl 1 (rng-below! (mut r) 8))))
                  (store! i (primitive/iadd (load i) 1)))))
    (assert-eq (load seen) 255)))

(deftest rng-split-differs
  (let [(mut a) (rng-seed 4)
        (mut b) (rng-split! (mut a))]
    (assert (!= (primitive/cast i64 (rng-next! (mut a))) (primitive/cast i64 (rng-next! (mut b)))))))
