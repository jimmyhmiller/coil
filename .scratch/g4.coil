(module scratch.g4)
(import "coil.primitive" :as primitive)
(import "coil.alloc" :as alloc :use *)
(import "coil.arraylist" :use *)
(import "coil.slice" :use *)
(import "coil.assert" :use *)
(import "coil.prop.source" :use *)
(import "coil.prop.gen" :use *)

(defn even? [(x (ptr i64))] (-> bool)
  (= (primitive/irem (load x) 2) 0))

(deftest smoke
  (let [a (malloc-allocator)
        s (source-new a 65536 7)]
    (source-begin-generate! s 30)
    (let [g (gen-int s 3 9)
          f (gen-filter s g (fnptr-of even?) 20)
          lg (gen-list-of s g 2 5)
          v (gen-draw g s)
          w (gen-draw f s)
          l (gen-draw lg s)]
      (assert (>= v 3))
      (assert-eq (primitive/irem w 2) 0)
      (assert (>= (al-len [i64] l) 2)))))
