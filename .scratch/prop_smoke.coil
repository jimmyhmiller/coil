(module prop_smoke)
(import "coil.prop" :use *)
(import "coil.arraylist" :use *)
(import "coil.primitive" :as primitive)

(defprop addition-commutes [(a i64) (b i64)]
  (= (primitive/iadd a b) (primitive/iadd b a)))

(defprop list-len-nonnegative [(xs (ArrayList i64))]
  (>= (al-len [i64] xs) 0))

; a property that is FALSE: sum of a list is never 3. Used to exercise shrinking.
(defprop no-list-sums-to-three [(xs (ArrayList i64))]
  (let [(mut total) 0
        (mut i) 0]
    (loop (if (>= (load i) (al-len [i64] xs))
              (break)
              (do (store! total (primitive/iadd (load total) (al-get [i64] xs (load i))))
                  (store! i (primitive/iadd (load i) 1)))))
    (!= (load total) 3)))
