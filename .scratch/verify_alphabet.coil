(module tests.prop.verify_alphabet)
(import "coil.primitive" :as primitive)
(import "coil.prop" :use *)
(import "coil.slice" :use *)
(import "coil.str" :use *)

; Does the (slice u8) generator ever emit a '-' (45) byte at all?
(defprop canary-string-contains-minus [(s (slice u8))]
  (let [(mut hit) false]
    (for [i 0 (str-len s)]
      (when (= (primitive/cast i64 (char-at s i)) 45) (store! hit true) 0))
    (not (load hit))))

; Does it ever emit the exact one-byte string "-"?
(defprop canary-string-is-lone-minus [(s (slice u8))]
  (not (and (= (str-len s) 1) (= (primitive/cast i64 (char-at s 0)) 45))))

; Does it ever emit a string that is a '-' followed only by digits?
(defprop canary-string-is-signed-number [(s (slice u8))]
  (let [n (str-len s)
        (mut alldig) (> n 1)]
    (for [i 1 n]
      (let [c (primitive/cast i64 (char-at s i))]
        (when (or (< c 48) (> c 57)) (store! alldig false) 0)))
    (not (and (> n 1) (= (primitive/cast i64 (char-at s 0)) 45) (load alldig)))))
