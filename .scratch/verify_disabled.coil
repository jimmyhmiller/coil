(module tests.prop.verify_disabled)
(import "coil.primitive" :as primitive)
(import "coil.prop" :use *)
(import "coil.serde" :use *)
(import "coil.serde.sexp" :use *)

(defprop sexp-i64-roundtrips-every-value [(n i64)]
  (let [a (src-alloc (prop-src))]
    (match (to-sexp-str [i64] a n)
      (Err [_] false)
      (Ok [text]
          (match (from-sexp [i64] a text)
            (Err [_] false)
            (Ok [back] (= back n)))))))
