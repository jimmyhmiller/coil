(module minfix_test)
(import "coil.alloc" :as alloc :use *)
(import "coil.assert" :use *)
(import "coil.serde" :use *)
(import "coil.serde.sexp" :use *)
(import "coil.str" :use *)
(import "coil.print" :use *)

(deftest i64-min-sexp-roundtrip
  (let [a (malloc-allocator)]
    (match (to-sexp-str [i64] a -9223372036854775808)
      (Err [_] (assert false))
      (Ok [s]
          (do (println "MIN encodes as {s}" s)
              (match (from-sexp [i64] a s)
                (Err [_] (assert false))
                (Ok [v] (assert-eq v -9223372036854775808))))))))

(deftest boundary-values-roundtrip
  (let [a (malloc-allocator)]
    (assert (sexp-roundtrips a -9223372036854775808))
    (assert (sexp-roundtrips a -9223372036854775807))
    (assert (sexp-roundtrips a -1))
    (assert (sexp-roundtrips a 0))
    (assert (sexp-roundtrips a 1))
    (assert (sexp-roundtrips a 9223372036854775807))))

(defn sexp-roundtrips [(a (ptr Allocator)) (n i64)] (-> bool)
  (match (to-sexp-str [i64] a n)
    (Err [_] false)
    (Ok [s] (match (from-sexp [i64] a s)
              (Err [_] false)
              (Ok [v] (= v n))))))
