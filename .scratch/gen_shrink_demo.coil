(module scratch.gen-shrink-demo)
(import "coil.primitive" :as primitive)
(import "coil.alloc" :as alloc :use *)
(import "coil.arraylist" :use *)
(import "coil.slice" :use *)
(import "coil.prop" :use *)
(import "coil.prop.gen" :use *)

; A deliberately FAILING property, to look at the counterexample the runner prints.
; The minimal counterexample is the one-element list [50].

(defprop sum-of-a-short-list-is-small []
  (let [s (prop-src)
        xs (gen-draw (gen-list-of s (gen-int s 0 1000) 0 8) s)
        n (al-len [i64] xs)
        (mut sum) 0
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do (store! sum (primitive/iadd (load sum) (al-get [i64] xs (load i))))
                  (store! i (primitive/iadd (load i) 1)))))
    (< (load sum) 50)))
