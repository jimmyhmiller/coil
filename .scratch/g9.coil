(module scratch.g9)
(import "coil.primitive" :as primitive)
(import "coil.alloc" :as alloc :use *)
(import "coil.arraylist" :use *)
(import "coil.slice" :use *)
(import "coil.prop.source" :use *)
(import "coil.prop.gen" :use *)

(defn prop [(s (ptr Source))] (-> bool)
  (let [sp (span-open! s "list" SPAN-PLAIN)
        n (draw-len! s 0 8)
        (mut sum) 0
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (let [esp (span-open! s "elem" SPAN-ELEM)]
                (store! sum (primitive/iadd (load sum) (draw-int! s 0 1000)))
                (span-close! s esp)
                (store! i (primitive/iadd (load i) 1))
                0)))
    (span-close! s sp)
    (< (load sum) 50)))

(defn tape-ok? [(t (ptr (ArrayList Choice)))] (-> bool)
  (let [n (al-len [Choice] (load t))
        (mut ok) true
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (let [c (al-get [Choice] (load t) (load i))]
                (if (or (< (load (field c kind)) 0) (> (load (field c kind)) 4))
                    (store! ok false)
                    0)
                (store! i (primitive/iadd (load i) 1))
                0)))
    (load ok)))

(defn dump [(t (ptr (ArrayList Choice))) (tag (slice u8))] (-> i64)
  (let [n (al-len [Choice] (load t))
        (mut i) 0]
    (println "  {s}: n={d}" tag n)
    (loop (if (>= (load i) n)
              (break)
              (let [c (al-get [Choice] (load t) (load i))]
                (println "    [{d}] kind={d} lo={d} hi={d} origin={d} value={d}"
                         (load i) (load (field c kind)) (load (field c lo)) (load (field c hi))
                         (load (field c origin)) (load (field c value)))
                (store! i (primitive/iadd (load i) 1))
                0)))
    0))

(defn main [] (-> i64)
  (let [mem (malloc-allocator)
        s (source-new mem 8388608 20260809)
        (mut found) false
        (mut i) 0]
    (loop (if (or (load found) (>= (load i) 2000))
              (break)
              (do (source-begin-generate! s 30)
                  (if (prop s) 0 (store! found true))
                  (store! i (primitive/iadd (load i) 1)))))
    (println "found={d} tape={d} ok={d}" (if (load found) 1 0)
             (al-len [Choice] (load (src-tape s)))
             (if (tape-ok? (src-tape s)) 1 0))
    (dump (src-tape s) "generated")
    (let [(mut best) (tape-clone mem (src-tape s))
          (mut k) 0]
      (loop (if (>= (load k) 200)
                (break)
                (do (let [(mut cand) (tape-clone mem (mut best))]
                      (source-begin-replay! s (mut cand) 30)
                      (if (< (load k) 4)
                          (println "  after begin-replay: replay-len={d} cursor={d} mode={d}"
                                   (al-len [Choice] (load (field s replay)))
                                   (load (field s cursor)) (load (field s mode)))
                          (println ""))
                      (let [held (prop s)]
                        (if (< (load k) 4)
                            (println "iter {d}: in={d} held={d} out={d} status={d}" (load k)
                                     (al-len [Choice] (load cand)) (if held 1 0)
                                     (al-len [Choice] (load (src-tape s))) (src-status s))
                            (println ".")))
                      (if (< (load k) 2) (dump (src-tape s) "produced") 0)
                      (store! best (tape-clone mem (src-tape s))))
                    (if (tape-ok? (mut best))
                        0
                        (do (println "CORRUPT at iteration {d}, len={d}" (load k)
                                     (al-len [Choice] (load best)))
                            (break)))
                    (store! k (primitive/iadd (load k) 1)))))
      (println "done k={d} len={d} ok={d}" (load k) (al-len [Choice] (load best))
               (if (tape-ok? (mut best)) 1 0)))
    0))
