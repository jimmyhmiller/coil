(module scratch.ga)
(import "coil.primitive" :as primitive)
(import "coil.alloc" :as alloc :use *)
(import "coil.arraylist" :use *)
(import "coil.slice" :use *)
(import "coil.prop.source" :use *)
(import "coil.prop.gen" :use *)

(defn probe [(s (ptr Source)) (tag (slice u8))] (-> i64)
  (println "  {s}: cursor={d} replay-len={d} mode={d} status={d} replay-data={x} arena-base={x} arena-off={d}"
           tag (load (field s cursor))
           (al-len [Choice] (load (field s replay)))
           (load (field s mode)) (load (field s status))
           (primitive/cast i64 (load (field (field s replay) data)))
           (primitive/cast i64 (load (field (load (field s arena-state)) base)))
           (load (field (load (field s arena-state)) off)))
  0)

(defn prop [(s (ptr Source)) (verbose bool)] (-> bool)
  (let [g (gen-int s 0 1000)
        lg (gen-list-of s g 0 8)]
    (if verbose (probe s "before draw") 0)
    (let [xs (gen-draw lg s)
          n (al-len [i64] xs)
          (mut sum) 0
          (mut i) 0]
      (loop (if (>= (load i) n)
                (break)
                (do (store! sum (primitive/iadd (load sum) (al-get [i64] xs (load i))))
                    (store! i (primitive/iadd (load i) 1)))))
      (< (load sum) 50))))

(defn main [] (-> i64)
  (let [mem (malloc-allocator)
        s (source-new mem 8388608 20260809)
        (mut found) false
        (mut i) 0]
    (loop (if (or (load found) (>= (load i) 2000))
              (break)
              (do (source-begin-generate! s 30)
                  (if (prop s false) 0 (store! found true))
                  (store! i (primitive/iadd (load i) 1)))))
    (println "found={d} tape={d}" (if (load found) 1 0) (al-len [Choice] (load (src-tape s))))
    (let [(mut best) (tape-clone mem (src-tape s))
          (mut k) 0]
      (loop (if (>= (load k) 3)
                (break)
                (do (let [(mut cand) (tape-clone mem (mut best))]
                      (source-begin-replay! s (mut cand) 30)
                      (probe s "after begin-replay")
                      (let [held (prop s true)]
                        (probe s "after prop")
                        (println "iter {d}: held={d} out={d}" (load k) (if held 1 0)
                                 (al-len [Choice] (load (src-tape s)))))
                      (store! best (tape-clone mem (src-tape s))))
                    (store! k (primitive/iadd (load k) 1))))))
    0))
