(module scratch.g1)
(import "coil.primitive" :as primitive)
(import "coil.assert" :use *)

(defstruct Box [T] [(v T) (f (fnptr c [T] T))])

(defn idf [T] [(x T)] (-> T) x)

(defn mkbox [T] [(x T)] (-> (Box T))
  (let [(mut b) (zeroed (Box T))]
    (store! (field (mut b) v) x)
    (store! (field (mut b) f) (primitive/fnptr-of idf))
    (load b)))

(deftest fnptr-generic
  (let [b (mkbox [i64] 7)]
    (assert-eq (load (field b v)) 7)
    (assert-eq (primitive/call-ptr (load (field b f)) 5) 5)))
