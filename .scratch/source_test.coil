(module source_test)
(import "coil.prop.source" :use *)
(import "coil.arraylist" :use *)
(import "coil.alloc" :as alloc :use *)
(import "coil.assert" :use *)
(import "coil.primitive" :as primitive)

(defn mk [] (-> (ptr Source))
  (source-new (malloc-allocator) 1048576 42))

(deftest draws-in-range
  (let [s (mk)
        (mut ok) true
        (mut i) 0]
    (source-begin-generate! s 30)
    (loop (if (>= (load i) 5000)
              (break)
              (do (let [v (draw-int! s 3 17)]
                    (if (and (>= v 3) (<= v 17)) 0 (store! ok false)))
                  (store! i (primitive/iadd (load i) 1)))))
    (assert (load ok))))

(deftest tape-records-every-draw
  (let [s (mk)]
    (source-begin-generate! s 30)
    (draw-int! s 0 100)
    (draw-bool! s)
    (draw-len! s 0 10)
    (assert-eq (al-len [Choice] (load (src-tape s))) 3)))

(deftest replay-reproduces-values
  (let [s (mk)]
    (source-begin-generate! s 30)
    (let [a (draw-int! s 0 1000000)
          b (draw-int! s 0 1000000)
          (mut saved) (tape-clone (malloc-allocator) (src-tape s))]
      (source-begin-replay! s (mut saved) 30)
      (assert-eq (draw-int! s 0 1000000) a)
      (assert-eq (draw-int! s 0 1000000) b))))

(deftest empty-tape-gives-minimum
  (let [s (mk)
        (mut empty) (al-new [Choice] (malloc-allocator))]
    (source-begin-replay! s (mut empty) 30)
    (assert-eq (draw-int! s 5 99) 5)
    (assert-eq (draw-int-origin! s -100 100 7) 7)
    (assert-eq (if (draw-bool! s) 1 0) 0)
    (assert-eq (src-status s) 1)))

(deftest spans-nest
  (let [s (mk)]
    (source-begin-generate! s 30)
    (let [outer (span-open! s "outer" 0)]
      (draw-int! s 0 10)
      (let [inner (span-open! s "inner" 1)]
        (draw-int! s 0 10)
        (span-close! s inner))
      (span-close! s outer))
    (let [sp (load (src-spans s))]
      (assert-eq (al-len [Span] sp) 2)
      (assert-eq (load (field (al-elem [Span] (src-spans s) 1) parent)) 0)
      (assert-eq (load (field (al-elem [Span] (src-spans s) 1) depth)) 1)
      (assert-eq (load (field (al-elem [Span] (src-spans s) 0) end)) 2))))

(deftest float-bits-roundtrip
  (assert (primitive/fcmp-eq (bits->f64 (f64->bits 3.25)) 3.25)))

(deftest tape-compare-shortlex
  (let [a (malloc-allocator)
        s (mk)]
    (source-begin-generate! s 30)
    (draw-int! s 0 100)
    (let [(mut one) (tape-clone a (src-tape s))]
      (draw-int! s 0 100)
      (let [(mut two) (tape-clone a (src-tape s))]
        (assert (< (tape-compare (mut one) (mut two)) 0))))))
