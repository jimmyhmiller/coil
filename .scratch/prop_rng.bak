(module coil.prop.rng)
(import "coil.primitive" :as primitive)
; Deterministic, splittable pseudo-randomness for property-based testing.
;
; xoshiro256++ (Blackman & Vigna) seeded through splitmix64. Chosen over an LCG or
; a hash-based PRNG for three properties a PBT engine needs:
;
;   * SPEED — five shifts/adds per draw, no division, no memory beyond the state.
;   * SPLITTABILITY — `rng-split!` derives an independent stream from an existing
;     one, so N parallel workers explore disjoint, individually reproducible
;     sequences from a single seed.
;   * REPRODUCIBILITY — the state is four integers with no hidden inputs, so a
;     seed replays a run exactly, on any platform, forever.
;
; Everything is `u64`: shifts must be LOGICAL (`primitive/ishr` lowers to `lshr`
; only when its operands are unsigned), and wrap-around on add/multiply is the
; intended arithmetic, not an overflow bug.

;; The generator state. Never all-zero — `rng-seed` guarantees that.
(defstruct Rng [(s0 u64) (s1 u64) (s2 u64) (s3 u64)])

;; Rotate left, the primitive xoshiro is built from.
(defn rotl64 [(x u64) (k u64)] (-> u64)
  (primitive/ior (primitive/ishl x k)
                 (primitive/ishr x (primitive/isub (primitive/cast u64 64) k))))

;; One splitmix64 step: a strong mixing function used to expand a single seed
;; into a full xoshiro state (seeding xoshiro directly from a small integer
;; leaves it correlated for the first few outputs).
(defn splitmix64 [(z u64)] (-> u64)
  (let [a (primitive/iadd z (primitive/cast u64 -7046029254386353131))
        b (primitive/imul (primitive/ixor a (primitive/ishr a (primitive/cast u64 30)))
                          (primitive/cast u64 -4658895280553007687))
        c (primitive/imul (primitive/ixor b (primitive/ishr b (primitive/cast u64 27)))
                          (primitive/cast u64 -7723592293110705685))]
    (primitive/ixor c (primitive/ishr c (primitive/cast u64 31)))))

;; Build a state from one seed. Distinct seeds give unrelated streams.
(defn rng-seed [(seed i64)] (-> Rng)
  (let [(mut z) (primitive/cast u64 seed)
        r (primitive/alloc-stack Rng)]
    (store! z (primitive/iadd (load z) (primitive/cast u64 -7046029254386353131)))
    (store! (field r s0) (splitmix64 (load z)))
    (store! z (primitive/iadd (load z) (primitive/cast u64 -7046029254386353131)))
    (store! (field r s1) (splitmix64 (load z)))
    (store! z (primitive/iadd (load z) (primitive/cast u64 -7046029254386353131)))
    (store! (field r s2) (splitmix64 (load z)))
    (store! z (primitive/iadd (load z) (primitive/cast u64 -7046029254386353131)))
    (store! (field r s3) (splitmix64 (load z)))
    ; an all-zero state is a fixed point of xoshiro; splitmix64 makes it
    ; astronomically unlikely, but "astronomically unlikely" is not "impossible".
    (if (and (= (load (field r s0)) (primitive/cast u64 0))
             (and (= (load (field r s1)) (primitive/cast u64 0))
                  (and (= (load (field r s2)) (primitive/cast u64 0))
                       (= (load (field r s3)) (primitive/cast u64 0)))))
        (store! (field r s0) (primitive/cast u64 -7046029254386353131))
        0)
    (load r)))

;; The next 64 bits. xoshiro256++: output = rotl(s0 + s3, 23) + s0.
(defn rng-next! [(r (mut Rng))] (-> u64)
  (let [a (load (field r s0))
        b (load (field r s1))
        c (load (field r s2))
        d (load (field r s3))
        out (primitive/iadd (rotl64 (primitive/iadd a d) (primitive/cast u64 23)) a)
        t (primitive/ishl b (primitive/cast u64 17))]
    (let [c2 (primitive/ixor c a)
          d2 (primitive/ixor d b)
          b2 (primitive/ixor b c2)
          a2 (primitive/ixor a d2)
          c3 (primitive/ixor c2 t)
          d3 (rotl64 d2 (primitive/cast u64 45))]
      (store! (field r s0) a2)
      (store! (field r s1) b2)
      (store! (field r s2) c3)
      (store! (field r s3) d3))
    out))

;; A fresh, independent stream. Used to give each worker (and each forked shrink
;; candidate) its own reproducible sequence without sharing mutable state.
(defn rng-split! [(r (mut Rng))] (-> Rng)
  (let [a (rng-next! (mut r))
        b (rng-next! (mut r))
        s (primitive/alloc-stack Rng)]
    (store! (field s s0) (splitmix64 a))
    (store! (field s s1) (splitmix64 (primitive/ixor a b)))
    (store! (field s s2) (splitmix64 b))
    (store! (field s s3) (splitmix64 (primitive/iadd a b)))
    (load s)))

;; A uniform value in [0, n), by Lemire's multiply-shift: one 128-bit multiply,
;; no division, no modulo bias. `n <= 0` yields 0.
;;
;; The 128-bit product is formed from two 64-bit halves because Coil integers are
;; fixed-width; `(cast u128 …)` would be the direct spelling if it existed. The
;; rejection branch (`lo < n`) runs with probability < n/2^64 — never, in
;; practice, for the ranges a generator asks for.
(defn rng-below! [(r (mut Rng)) (n i64)] (-> i64)
  (if (<= n (cast i64 0))
      0
      (let [un (primitive/cast u64 n)
            x (rng-next! (mut r))
            hi (umulhi x un)
            lo (primitive/imul x un)]
        (if (primitive/icmp-lt (primitive/cast u64 lo) un)
            ; the biased tail: redraw until the product's low half clears the
            ; threshold. Loops with probability < 2^-32 for any realistic n.
            (let [(mut h) hi
                  (mut done) false]
              (loop (if (load done)
                        (break)
                        (let [x2 (rng-next! (mut r))
                              hi2 (umulhi x2 un)
                              lo2 (primitive/imul x2 un)]
                          (store! h hi2)
                          (if (primitive/icmp-lt (primitive/cast u64 lo2) un) 0 (store! done true))
                          0)))
              (primitive/cast i64 (load h)))
            (primitive/cast i64 hi)))))

;; The high 64 bits of a 64x64 unsigned product, by 32-bit limbs.
(defn umulhi [(a u64) (b u64)] (-> u64)
  (let [mask (primitive/cast u64 4294967295)
        a-lo (primitive/iand a mask)
        a-hi (primitive/ishr a (primitive/cast u64 32))
        b-lo (primitive/iand b mask)
        b-hi (primitive/ishr b (primitive/cast u64 32))
        t (primitive/imul a-lo b-lo)
        w0 (primitive/iand t mask)
        k (primitive/ishr t (primitive/cast u64 32))
        t2 (primitive/iadd (primitive/imul a-hi b-lo) k)
        w1 (primitive/iand t2 mask)
        w2 (primitive/ishr t2 (primitive/cast u64 32))
        t3 (primitive/iadd (primitive/imul a-lo b-hi) w1)
        k2 (primitive/ishr t3 (primitive/cast u64 32))]
    (primitive/iadd (primitive/iadd (primitive/imul a-hi b-hi) w2) k2)))

;; A uniform value in [lo, hi] inclusive. `hi < lo` yields `lo`.
(defn rng-range! [(r (mut Rng)) (lo i64) (hi i64)] (-> i64)
  (if (< hi lo)
      lo
      (primitive/iadd lo (rng-below! (mut r) (primitive/iadd (primitive/isub hi lo) 1)))))

;; True with probability `num`/`den`.
(defn rng-chance! [(r (mut Rng)) (num i64) (den i64)] (-> bool)
  (if (<= den (cast i64 0)) false (< (rng-below! (mut r) den) num)))
