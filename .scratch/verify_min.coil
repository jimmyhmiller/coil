(module tests.prop.verify_min)
(import "coil.primitive" :as primitive)
(import "coil.assert" :use *)
(import "coil.serde" :use *)
(import "coil.serde.sexp" :use *)
(import "coil.serde.json" :use *)
(import "coil.alloc" :use *)
(import "coil.io" :use *)

(deftest min-roundtrip
  (let [a (malloc-allocator)]
    (match (to-sexp-str [i64] a -9223372036854775808)
      (Err [_] (println "sexp encode ERR"))
      (Ok [t] (do (print-str (stdout) "sexp text = ") (print-str (stdout) t) (println "")
                  (match (from-sexp [i64] a t)
                    (Err [_] (println "decode ERR"))
                    (Ok [b] (println "decoded = {d}" b))))))
    (match (to-json-str [i64] a -9223372036854775808)
      (Err [_] (println "json encode ERR"))
      (Ok [t] (do (print-str (stdout) "json text = ") (print-str (stdout) t) (println ""))))
    (match (to-sexp-str [i64] a -9223372036854775807)
      (Err [_] (println "err"))
      (Ok [t] (do (print-str (stdout) "min+1 text = ") (print-str (stdout) t) (println ""))))
    (assert true)))
