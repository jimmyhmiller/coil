(module tests.prop.srcbug)
(import "coil.primitive" :as primitive)
(import "coil.alloc" :as alloc :use *)
(import "coil.arraylist" :use *)
(import "coil.slice" :use *)
(import "coil.assert" :use *)
(import "coil.prop.source" :use *)

(deftest source-new-clobbers-caller-allocator
  (let [a (malloc-allocator)
        s (source-new a 65536 12345)]
    ; if the bug is present, the caller's allocator IS the source's arena
    (assert-eq (primitive/cast i64 a) (primitive/cast i64 (src-alloc s)))
    0))
