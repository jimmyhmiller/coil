(module scratch.verify-arena-probe)
(import "coil.primitive" :as primitive)
(import "coil.alloc" :as alloc :use *)
(import "coil.arraylist" :use *)
(import "coil.prop.source" :use *)
(import "coil.prop.gen" :use *)

; Does the gen_test.coil workaround leave the case arena in use at all?

(defn probe [(label (slice u8)) (s (ptr Source))] (-> i64)
  (source-begin-generate! s 30)
  (let [g (gen-list-of s (gen-int s 0 1000) 4 8)
        xs (gen-draw g s)]
    (println "{s}: {d} elements, arena off = {d}"
             label
             (al-len [i64] xs)
             (load (field (load (field s arena-state)) off)))
    0))

(defn main [] (-> i64)
  ; exactly what tests/prop/gen_test.coil's `test-source` does
  (let [s1 (source-new (malloc-allocator) 262144 20260809)]
    (malloc-allocator)
    (probe "with the gen_test workaround" s1))
  ; and without it
  (let [s2 (source-new (malloc-allocator) 262144 20260809)]
    (probe "without the workaround   " s2))
  0)
