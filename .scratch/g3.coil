(module scratch.g3)
(import "coil.primitive" :as primitive)
(import "coil.alloc" :as alloc :use *)
(import "coil.arraylist" :use *)
(import "coil.slice" :use *)
(import "coil.assert" :use *)
(import "coil.prop.source" :use *)

(defstruct Gen [T]
  [(run (fnptr c [(ptr Source) (ptr i8)] T))
   (env (ptr i8))])

(defn mk-gen [T] [(run (fnptr c [(ptr Source) (ptr i8)] T)) (env (ptr i8))] (-> (Gen T))
  (let [(mut g) (zeroed (Gen T))]
    (store! (field (mut g) run) run)
    (store! (field (mut g) env) env)
    (load g)))

(defn gen-draw [T] [(g (Gen T)) (s (ptr Source))] (-> T)
  (primitive/call-ptr (load (field g run)) s (load (field g env))))

(defn gen-env [E] [(s (ptr Source))] (-> (ptr E))
  (unwrap-ptr [E] (create [E] (src-alloc s))))

(defstruct IntEnv [(lo i64) (hi i64)])
(defn gen-int--run [(s (ptr Source)) (env (ptr i8))] (-> i64)
  (let [e (primitive/cast (ptr IntEnv) env)]
    (draw-int! s (load (field e lo)) (load (field e hi)))))
(defn gen-int [(s (ptr Source)) (lo i64) (hi i64)] (-> (Gen i64))
  (let [e (gen-env [IntEnv] s)]
    (store! (field e lo) lo)
    (store! (field e hi) hi)
    (mk-gen [i64] (fnptr-of gen-int--run) (primitive/cast (ptr i8) e))))

; ---- list-of: a run fn returning a STRUCT (ArrayList i64) through the fnptr
(defstruct ListEnv [T] [(elem (Gen T)) (lo i64) (hi i64)])

(defn gen-list-run [T] [(s (ptr Source)) (env (ptr i8))] (-> (ArrayList T))
  (let [e (primitive/cast (ptr (ListEnv T)) env)
        n (draw-len! s (load (field e lo)) (load (field e hi)))
        (mut l) (al-new [T] (src-alloc s))
        (mut i) 0]
    (loop (if (>= (load i) n) (break)
              (do (al-push! [T] (mut l) (gen-draw [T] (load (field e elem)) s))
                  (store! i (primitive/iadd (load i) 1)))))
    (load l)))

(defn gen-list-make [T] [(s (ptr Source)) (elem (Gen T)) (lo i64) (hi i64)
                         (run (fnptr c [(ptr Source) (ptr i8)] (ArrayList T)))] (-> (Gen (ArrayList T)))
  (let [e (gen-env [(ListEnv T)] s)]
    (store! (field e elem) elem)
    (store! (field e lo) lo)
    (store! (field e hi) hi)
    (mk-gen [(ArrayList T)] run (primitive/cast (ptr i8) e))))

; ---- macro that mints the monomorphic shim + constructor
(defn defgen-list-of [(name Code) (T Code)] (-> Code)
  (let [runname (primitive/code-symbol name "--run")]
    `(do
       (defn ~runname [(s (ptr Source)) (env (ptr i8))] (-> (ArrayList ~T))
         (gen-list-run [~T] s env))
       (defn ~name [(s (ptr Source)) (elem (Gen ~T)) (lo i64) (hi i64)] (-> (Gen (ArrayList ~T)))
         (gen-list-make [~T] s elem lo hi (fnptr-of ~runname))))))

(defgen-list-of gen-list-of i64)

; ---- (ptr A) callbacks
(defstruct MapEnv [A B] [(inner (Gen A)) (f (fnptr c [(ptr A)] B))])
(defn gen-map-run [A B] [(s (ptr Source)) (env (ptr i8))] (-> B)
  (let [e (primitive/cast (ptr (MapEnv A B)) env)
        slot (primitive/alloc-stack A)]
    (store! slot (gen-draw [A] (load (field e inner)) s))
    (primitive/call-ptr (load (field e f)) slot)))
(defn gen-map-make [A B] [(s (ptr Source)) (inner (Gen A)) (f (fnptr c [(ptr A)] B))
                          (run (fnptr c [(ptr Source) (ptr i8)] B))] (-> (Gen B))
  (let [e (gen-env [(MapEnv A B)] s)]
    (store! (field e inner) inner)
    (store! (field e f) f)
    (mk-gen [B] run (primitive/cast (ptr i8) e))))

(defn defgen-map [(name Code) (A Code) (B Code)] (-> Code)
  (let [runname (primitive/code-symbol name "--run")]
    `(do
       (defn ~runname [(s (ptr Source)) (env (ptr i8))] (-> ~B)
         (gen-map-run [~A ~B] s env))
       (defn ~name [(s (ptr Source)) (inner (Gen ~A)) (f (fnptr c [(ptr ~A)] ~B))] (-> (Gen ~B))
         (gen-map-make [~A ~B] s inner f (fnptr-of ~runname))))))

(defgen-map gen-map i64 i64)
(defgen-map gen-list-map (ArrayList i64) (ArrayList i64))

(defn dbl [(x (ptr i64))] (-> i64) (primitive/imul (load x) 2))
(defn rev [(xs (ptr (ArrayList i64)))] (-> (ArrayList i64))
  (let [n (al-len [i64] (load xs))
        (mut o) (al-new [i64] (load (field xs alc)))
        (mut i) 0]
    (loop (if (>= (load i) n) (break)
              (do (al-push! [i64] (mut o) (al-get [i64] (load xs) (primitive/isub (primitive/isub n 1) (load i))))
                  (store! i (primitive/iadd (load i) 1)))))
    (load o)))

(deftest gen-list
  (let [a (malloc-allocator)
        s (source-new a 65536 7)]
    (source-begin-generate! s 30)
    (let [g (gen-int s 3 9)
          lg (gen-list-of s g 2 5)
          l (gen-draw [(ArrayList i64)] lg s)
          m (gen-map s g (fnptr-of dbl))
          rg (gen-list-map s lg (fnptr-of rev))
          r (gen-draw [(ArrayList i64)] rg s)]
      (assert (>= (al-len [i64] l) 2))
      (assert (<= (al-len [i64] l) 5))
      (assert (>= (al-get [i64] l 0) 3))
      (let [w (gen-draw [i64] m s)]
        (assert (>= w 6)))
      (assert (>= (al-len [i64] r) 2)))))
