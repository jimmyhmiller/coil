(module scratch.g2)
(import "coil.primitive" :as primitive)
(import "coil.alloc" :as alloc :use *)
(import "coil.arraylist" :use *)
(import "coil.slice" :use *)
(import "coil.assert" :use *)
(import "coil.prop" :use *)

(defstruct Gen [T]
  [(run (fnptr c [(ptr Source) (ptr i8)] T))
   (env (ptr i8))])

(defstruct IntEnv [(lo i64) (hi i64)])

(defn mk-gen [T] [(run (fnptr c [(ptr Source) (ptr i8)] T)) (env (ptr i8))] (-> (Gen T))
  (let [(mut g) (zeroed (Gen T))]
    (store! (field (mut g) run) run)
    (store! (field (mut g) env) env)
    (load g)))

(defn gen-draw [T] [(g (Gen T)) (s (ptr Source))] (-> T)
  (primitive/call-ptr (load (field g run)) s (load (field g env))))

(defn gen-env [E] [(s (ptr Source))] (-> (ptr E))
  (unwrap-ptr [E] (create [E] (src-alloc s))))

(defn gen-int--run [(s (ptr Source)) (env (ptr i8))] (-> i64)
  (let [e (primitive/cast (ptr IntEnv) env)]
    (draw-int! s (load (field e lo)) (load (field e hi)))))

(defn gen-int [(s (ptr Source)) (lo i64) (hi i64)] (-> (Gen i64))
  (let [e (gen-env [IntEnv] s)]
    (store! (field e lo) lo)
    (store! (field e hi) hi)
    (mk-gen [i64] (fnptr-of gen-int--run) (primitive/cast (ptr i8) e))))

; --- generic helper called from a monomorphic shim (the fnptr-of workaround)
(defstruct MapEnv [A B] [(inner (Gen A)) (f (fnptr c [A] B))])

(defn gen-map-run [A B] [(s (ptr Source)) (env (ptr i8))] (-> B)
  (let [e (primitive/cast (ptr (MapEnv A B)) env)]
    (primitive/call-ptr (load (field e f)) (gen-draw [A] (load (field e inner)) s))))

(defn gen-map-make [A B] [(s (ptr Source))
                          (inner (Gen A))
                          (f (fnptr c [A] B))
                          (run (fnptr c [(ptr Source) (ptr i8)] B))] (-> (Gen B))
  (let [e (gen-env [(MapEnv A B)] s)]
    (store! (field e inner) inner)
    (store! (field e f) f)
    (mk-gen [B] run (primitive/cast (ptr i8) e))))

; the shim a macro would mint
(defn my-map--run [(s (ptr Source)) (env (ptr i8))] (-> i64)
  (gen-map-run [i64 i64] s env))
(defn my-map [(s (ptr Source)) (inner (Gen i64)) (f (fnptr c [i64] i64))] (-> (Gen i64))
  (gen-map-make [i64 i64] s inner f (fnptr-of my-map--run)))

(defn dbl [(x i64)] (-> i64) (primitive/imul x 2))

; --- struct-typed callback param
(defn sum-list [(xs (ArrayList i64))] (-> i64)
  (let [(mut t) 0 (mut i) 0 n (al-len [i64] xs)]
    (loop (if (>= (load i) n) (break)
              (do (store! t (primitive/iadd (load t) (al-get [i64] xs (load i))))
                  (store! i (primitive/iadd (load i) 1)))))
    (load t)))

(defn take-cb [(f (fnptr c [(ArrayList i64)] i64)) (xs (ArrayList i64))] (-> i64)
  (primitive/call-ptr f xs))

(deftest gen-basic
  (let [a (malloc-allocator)
        s (source-new a 65536 7)]
    (source-begin-generate! s 30)
    (let [g (gen-int s 3 9)
          v (gen-draw [i64] g s)
          m (my-map s g (fnptr-of dbl))
          w (gen-draw [i64] m s)]
      (assert (>= v 3))
      (assert (<= v 9))
      (assert (>= w 6))
      (assert (<= w 18))
      (let [(mut l) (al-new [i64] a)]
        (al-push! [i64] (mut l) 4)
        (al-push! [i64] (mut l) 5)
        (assert-eq (take-cb (fnptr-of sum-list) (load l)) 9)))))
