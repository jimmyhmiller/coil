(module arb_test)
(import "coil.prop.source" :use *)
(import "coil.prop.arbitrary" :use *)
(import "coil.arraylist" :use *)
(import "coil.alloc" :as alloc :use *)
(import "coil.slice" :use *)
(import "coil.assert" :use *)
(import "coil.primitive" :as primitive)

(defn mk [] (-> (ptr Source))
  (source-new (malloc-allocator) 4194304 7))

(deftest arb-scalars
  (let [s (mk)]
    (source-begin-generate! s 30)
    (let [b (arb [bool] s)
          i (arb [i64] s)
          c (arb [u8] s)]
      (assert (or (= b true) (= b false)))
      (assert (and (>= (primitive/cast i64 c) 0) (<= (primitive/cast i64 c) 255)))
      (assert (or (>= i 0) (< i 0))))))

(deftest arb-list-has-spans
  (let [s (mk)]
    (source-begin-generate! s 12)
    (let [l (arb [(ArrayList i64)] s)]
      (assert (<= (al-len [i64] l) 12))
      (assert (> (al-len [Span] (load (src-spans s))) 0)))))

(deftest arb-option-minimal-is-none
  (let [s (mk)
        (mut empty) (al-new [Choice] (malloc-allocator))]
    (source-begin-replay! s (mut empty) 30)
    (let [o (arb [(Option i64)] s)]
      (assert (match o (None [] true) (Some [v] false))))))

(deftest arb-list-minimal-is-empty
  (let [s (mk)
        (mut empty) (al-new [Choice] (malloc-allocator))]
    (source-begin-replay! s (mut empty) 30)
    (let [l (arb [(ArrayList i64)] s)]
      (assert-eq (al-len [i64] l) 0))))

(deftest arb-string-printable
  (let [s (mk)
        (mut ok) true
        (mut n) 0]
    (source-begin-generate! s 20)
    (loop (if (>= (load n) 200)
              (break)
              (do (let [str (arb-string s 0 20)
                        (mut i) 0]
                    (loop (if (>= (load i) (slice-len [u8] str))
                              (break)
                              (do (let [c (primitive/cast i64 (slice-get [u8] str (load i)))]
                                    (if (and (>= c 32) (<= c 126)) 0 (store! ok false)))
                                  (store! i (primitive/iadd (load i) 1))))))
                  (store! n (primitive/iadd (load n) 1)))))
    (assert (load ok))))

(deftest arb-replays-identically
  (let [s (mk)]
    (source-begin-generate! s 25)
    (let [l1 (arb [(ArrayList i64)] s)
          (mut saved) (tape-clone (malloc-allocator) (src-tape s))]
      (source-begin-replay! s (mut saved) 25)
      (let [l2 (arb [(ArrayList i64)] s)
            (mut i) 0
            (mut ok) (= (al-len [i64] l1) (al-len [i64] l2))]
        (loop (if (or (>= (load i) (al-len [i64] l1)) (not (load ok)))
                  (break)
                  (do (if (= (al-get [i64] l1 (load i)) (al-get [i64] l2 (load i)))
                          0
                          (store! ok false))
                      (store! i (primitive/iadd (load i) 1)))))
        (assert (load ok))))))
