(module show_test)
(import "coil.prop.show" :use *)
(import "coil.io" :use *)
(import "coil.arraylist" :use *)
(import "coil.alloc" :as alloc :use *)
(import "coil.assert" :use *)

(deftest show-prints
  (let [w (stdout)
        (mut l) (al-new [i64] (malloc-allocator))]
    (al-push! [i64] (mut l) 1)
    (al-push! [i64] (mut l) 2)
    (show-named w "xs" (load l))
    (show-named w "s" "hi\nthere")
    (show-named w "b" true)
    (show-named w "o" (Some 3))
    (assert true)))
