; Canary properties: each ASSERTS THE NEGATION of an "interesting input"
; condition. A canary that FAILS fast proves the generator reaches that shape; a
; canary that PASSES all cases proves the corresponding real property is vacuous.
(module tests.prop.verify_canary)
(import "coil.primitive" :as primitive)
(import "coil.prop" :use *)
(import "coil.arraylist" :use *)
(import "coil.slice" :use *)
(import "coil.str" :use *)

(defn imin2 [(a i64) (b i64)] (-> i64) (if (< a b) a b))

(defprop canary-al-len-ge-4 [(xs (ArrayList i64))]
  (< (al-len [i64] xs) 4))

(defprop canary-churn-n-ge-5 [(kinds (ArrayList bool)) (ks (ArrayList u8)) (vs (ArrayList i64))]
  (< (imin2 (al-len [bool] kinds) (imin2 (al-len [u8] ks) (al-len [i64] vs))) 5))

(defprop canary-hay-len-ge-4 [(hay (slice u8))]
  (< (str-len hay) 4))

(defprop canary-embedded-needle-ge-2 [(hay (slice u8)) (a u8) (b u8)]
  (let [n (str-len hay)
        p (primitive/irem (primitive/cast i64 a) (primitive/iadd n 1))
        q (primitive/irem (primitive/cast i64 b) (primitive/iadd n 1))
        lo (imin2 p q)
        hi (if (< p q) q p)]
    (< (primitive/isub hi lo) 2)))

(defprop canary-i64-min-drawn [(n i64)]
  (!= n -9223372036854775808))

(defprop canary-random-string-parses-as-int [(s (slice u8))]
  (match (str-parse-int s) (None [] true) (Some [_] false)))
