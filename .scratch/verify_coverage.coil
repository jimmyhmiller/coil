(module tests.prop.verify_coverage)
(import "coil.primitive" :as primitive)
(import "coil.prop" :use *)
(import "coil.arraylist" :use *)
(import "coil.slice" :use *)
(import "coil.str" :use *)

(defn imin2 [(a i64) (b i64)] (-> i64) (if (< a b) a b))

; Does the ArrayList generator actually make non-trivial lists?
(defprop cov-arraylist [(xs (ArrayList i64))]
  (do (prop-collect! "al-len" (al-len [i64] xs))
      (prop-classify! "al-empty" (= (al-len [i64] xs) 0))
      (prop-classify! "al-ge3" (>= (al-len [i64] xs) 3))
      true))

; The 3-list churn property takes min of three lengths. How often is that 0?
(defprop cov-churn [(kinds (ArrayList bool)) (ks (ArrayList u8)) (vs (ArrayList i64))]
  (let [n (imin2 (al-len [bool] kinds) (imin2 (al-len [u8] ks) (al-len [i64] vs)))]
    (prop-collect! "churn-n" n)
    (prop-classify! "churn-zero" (= n 0))
    (prop-classify! "churn-ge5" (>= n 5))
    true))

; Strings: how often non-empty, and how often does a random needle ever hit?
(defprop cov-str [(hay (slice u8)) (needle (slice u8))]
  (do (prop-collect! "hay-len" (str-len hay))
      (prop-classify! "hay-empty" (= (str-len hay) 0))
      (prop-classify! "needle-empty" (= (str-len needle) 0))
      (prop-classify! "random-needle-found"
                      (match (str-find hay needle) (None [] false) (Some [_] true)))
      true))

; The embedded-needle property cuts the needle out of the haystack. Is it
; usually a non-trivial (non-empty, shorter-than-whole) needle?
(defprop cov-embedded [(hay (slice u8)) (a u8) (b u8)]
  (let [n (str-len hay)
        p (primitive/irem (primitive/cast i64 a) (primitive/iadd n 1))
        q (primitive/irem (primitive/cast i64 b) (primitive/iadd n 1))
        lo (imin2 p q)
        hi (if (< p q) q p)]
    (prop-collect! "needle-k" (primitive/isub hi lo))
    (prop-classify! "embedded-nonempty" (> (primitive/isub hi lo) 0))
    true))

; Does the i64 generator actually draw i64::MIN / edge values?
(defprop cov-i64 [(n i64)]
  (do (prop-classify! "is-i64-min" (= n -9223372036854775808))
      (prop-classify! "is-small" (and (>= n -100) (<= n 100)))
      (prop-classify! "is-negative" (< n 0))
      true))

; str-parse-int-agrees: how often is a random string actually a valid number?
(defprop cov-parse [(s (slice u8))]
  (do (prop-classify! "parses-as-int"
                      (match (str-parse-int s) (None [] false) (Some [_] true)))
      true))
