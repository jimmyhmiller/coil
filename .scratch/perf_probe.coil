(module perf_probe)
(import "coil.prop" :use *)
(import "coil.arraylist" :use *)
(import "coil.alloc" :as alloc :use *)
(import "coil.time" :as time)
(import "coil.print" :use *)
(import "coil.primitive" :as primitive)

(defn now-ns [] (-> i64)
  (match (time/monotonic-now)
    (Ok [t] (let [(mut i) t]
              (primitive/iadd (primitive/imul (load (field (mut i) sec)) 1000000000)
                              (load (field (mut i) nsec)))))
    (Err [_] 0)))

(defn bench-draws [(n i64)] (-> i64)
  (let [s (source-new (malloc-allocator) 8388608 99)
        t0 (now-ns)
        (mut i) 0
        (mut acc) 0]
    (loop (if (>= (load i) n)
              (break)
              (do (if (= (primitive/irem (load i) 64) 0) (source-begin-generate! s 30) 0)
                  (store! acc (primitive/iadd (load acc) (draw-int! s 0 1000)))
                  (store! i (primitive/iadd (load i) 1)))))
    (let [dt (primitive/isub (now-ns) t0)]
      (println "draws: {d} in {d} ns = {d} ns/draw" n dt (primitive/idiv dt n)))
    (load acc)))

(defn bench-cases [(n i64)] (-> i64)
  (let [s (source-new (malloc-allocator) 8388608 7)
        t0 (now-ns)
        (mut i) 0
        (mut acc) 0]
    (loop (if (>= (load i) n)
              (break)
              (do (source-begin-generate! s 30)
                  (let [a (arb [i64] s)
                        b (arb [i64] s)]
                    (if (= (primitive/iadd a b) (primitive/iadd b a))
                        (store! acc (primitive/iadd (load acc) 1))
                        0))
                  (store! i (primitive/iadd (load i) 1)))))
    (let [dt (primitive/isub (now-ns) t0)]
      (println "scalar cases: {d} in {d} ns = {d} ns/case ({d}/sec)"
               n dt (primitive/idiv dt n) (primitive/idiv 1000000000 (primitive/idiv dt n))))
    (load acc)))

(defn bench-list-cases [(n i64)] (-> i64)
  (let [s (source-new (malloc-allocator) 33554432 11)
        t0 (now-ns)
        (mut i) 0
        (mut acc) 0]
    (loop (if (>= (load i) n)
              (break)
              (do (source-begin-generate! s 32)
                  (store! acc (primitive/iadd (load acc) (al-len [i64] (arb [(ArrayList i64)] s))))
                  (store! i (primitive/iadd (load i) 1)))))
    (let [dt (primitive/isub (now-ns) t0)]
      (println "list cases:   {d} in {d} ns = {d} ns/case ({d}/sec)"
               n dt (primitive/idiv dt n) (primitive/idiv 1000000000 (primitive/idiv dt n))))
    (load acc)))

(defn main [] (-> i64)
  (bench-draws 5000000)
  (bench-cases 1000000)
  (bench-list-cases 200000)
  0)
