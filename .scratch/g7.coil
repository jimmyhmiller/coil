(module scratch.g7)
(import "coil.primitive" :as primitive)
(import "coil.alloc" :as alloc :use *)
(import "coil.prop.source" :use *)

(defstruct C1 [(src (ptr Source))])

(defn main [] (-> i64)
  (let [mem (malloc-allocator)
        a (unwrap-ptr [C1] (create [C1] mem))
        b (unwrap-ptr [C1] (create [C1] mem))
        s (source-new mem 262144 1)
        c (unwrap-ptr [C1] (create [C1] mem))]
    (println "sizeof={d} a={x} b={x} c={x} s={x}"
             (primitive/sizeof C1)
             (primitive/cast i64 a) (primitive/cast i64 b)
             (primitive/cast i64 c) (primitive/cast i64 s))
    (store! (field a src) s)
    (store! (field b src) s)
    (store! (field c src) s)
    (println "a.src={x} b.src={x} c.src={x}"
             (primitive/cast i64 (load (field a src)))
             (primitive/cast i64 (load (field b src)))
             (primitive/cast i64 (load (field c src))))
    0))
