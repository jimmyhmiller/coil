(module arena_check)
(import "coil.prop" :use *)
(import "coil.arraylist" :use *)
(import "coil.alloc" :as alloc :use *)
(import "coil.print" :use *)
(import "coil.primitive" :as primitive)

; Does the tape's backing store live inside the per-case arena? It must NOT: the
; arena is rewound between cases, so a tape allocated from it would be handed out
; again as the next case's generated data.

(defn in-arena? [(s (ptr Source)) (p (ptr i8))] (-> bool)
  (let [ar (load (field s arena-state))
        base (load (field ar base))
        cap (load (field ar cap))]
    (and (>= p base) (< p (primitive/index base cap)))))

(defn main [] (-> i64)
  (let [s (source-new (malloc-allocator) 1048576 5)]
    (source-begin-generate! s 40)
    ; force the tape and span table to allocate, and generate a list so the arena
    ; is used too.
    (arb [(ArrayList i64)] s)
    (arb [(ArrayList i64)] s)
    (let [tape-buf (primitive/cast (ptr i8) (load (field (field s tape) data)))
          span-buf (primitive/cast (ptr i8) (load (field (field s spans) data)))
          ar (load (field s arena-state))]
      (println "tape inside arena? {d}   spans inside arena? {d}"
               (if (in-arena? s tape-buf) 1 0)
               (if (in-arena? s span-buf) 1 0))
      (println "arena bytes used by one case: {d}" (load (field ar off)))
      (println "malloc-allocator still malloc? {d}"
               (if (= (primitive/cast i64 (load (field (malloc-allocator) ctx)))
                      (primitive/cast i64 (malloc-allocator)))
                   1
                   0))
      (if (or (in-arena? s tape-buf) (in-arena? s span-buf))
          (do (println "FAIL: long-lived buffers live in the per-case arena") 1)
          (if (= (load (field ar off)) 0)
              (do (println "FAIL: the arena was never used — generated values are being malloc'd") 1)
              (do (println "OK") 0))))))
