(module gaps.emission-runner)
(import "tpde.cir" :as cir)
(import "tpde.asm" :as asm)
(import "tpde.buf" :as buf)
(import "stogir.jit.darwin" :as jit)
(import "coil.primitive" :as p)
(import "coil.cc" :as cc)
(import "coil.result" :use [Ok Err])
(extern gap_emit_function [(ptr cir/Func) (ptr asm/Asm) u32] (-> i64))

(defn expected [(x u64) (y u64) (size i64)] (-> u64)
  (let [(mut value) x]
    (for [i 0 size]
      (set! value (case (% i 4) 0 (+ value y) 1 (^ value y)
                        2 (* value (: 3 u64)) (- value y))))
    value))

(defn main [] (-> i64)
  (for size [(: 32 i64) 128 512]
    (let [(mut function) (cir/Func::new)
          fp (p/cast (ptr cir/Func) (mut function))
          (mut expected-size) (: 0 i64) (mut expected-hash) (: 0 u64)]
      (set! (.name function) "emission.linear-mixed")
      (cir/set-block! fp (cir/new-block! fp))
      (let [x (cir/arg! fp cir/T-I64 false)
            y (cir/arg! fp cir/T-I64 false)
            three (cir/iconst! fp 3)
            (mut value) x]
        (for [i 0 size]
          (set! value (cir/op2! fp
            (case (% i 4) 0 cir/OP-ADD 1 cir/OP-XOR 2 cir/OP-MUL cir/OP-SUB)
            cir/T-I64 value (if (= (% i 4) 2) three y) 0 0)))
        (cir/ret1! fp value))
      (cir/finish! fp)
      (for [iteration 0 513]
        (let [(mut assembler) (asm/Asm::new)
              ap (p/cast (ptr asm/Asm) (mut assembler))
              symbol (asm/sym-add-def! ap "emission" -2 0 0 asm/BIND-LOCAL)
              count (gap_emit_function fp ap symbol)]
          (assert (> count 0))
          (let [(mut hash) (: 1469598103934665603 u64)]
            (for byte (buf/as-slice (asm/sect-buf ap asm/SEC-TEXT))
              (set! hash (* (^ hash (cast u64 byte)) 1099511628211)))
            (if (= iteration 0) (set! expected-hash hash)
                (assert (= expected-hash hash))))
          (if (= iteration 0)
              (do
                (set! expected-size count)
                (match (jit/map-text (buf/as-slice (asm/sect-buf ap asm/SEC-TEXT)))
                  (Err [message] (panic "{}" message))
                  (Ok [mapped]
                    (let [(mut image) mapped
                          f (p/cast (fnptr (cc/C) [u64 u64] u64) (.base image))]
                      (for x [(: 0 u64) 1 7 0x8000000000000000 0xFFFFFFFFFFFFFFFF]
                        (for y [(: 0 u64) 1 7 0x8000000000000000 0xFFFFFFFFFFFFFFFF]
                          (assert (= (call-ptr f x y) (expected x y size)))))
                      (jit/release! (mut image))))))
              (assert (= count expected-size)))
          (asm/asm-free! ap)))
      (println "CIR operations {}: text {} bytes, 513 emissions, 25 execution answers, hash {}" size expected-size expected-hash)
      (cir/func-free! fp)))
  0)
