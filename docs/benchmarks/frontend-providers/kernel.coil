(module gaps.provider-kernel)
(import "gaps.provider-context" :use [Context])
(import "coil.compiler.resolve" :as resolve)
(import "coil.alloc" :use *)
(import "coil.scratch" :as scratch)
(import "coil.compiler.loader" :use [ImpEntry ExpEntry ModImports Use UAll UNames Alias Rename empty-names empty-renames])
(import "coil.reader" :use [Sexp])
(import "coil.avec" :use [avec-new])
(import "coil.arraylist" :use [ArrayList])
(import "coil.compiler.parser" :use [sconcat i64->str])
(import "coil.primitive" :as p)
(import "coil.cc" :as cc)

;;; Real resolver operation; all graph inputs belong to an opaque LLVM caller.
(defn kernel :cc (cc/C) :inline (Never) [(context (ptr Context))] (-> i64)
  (let [(mut count) 0]
    (for [i 0 (.repetitions context)]
      (let [name (if (= (& i 1) 0) "primitive" "missing")
            (mut providers) (resolve/primitive-providers-in (malloc-allocator)
                               (field context imports) (field context exports) "base" name)]
        (for provider providers (assert (= (.name provider) name)))
        (set! count (+ count (len providers)))
        (free! (mut providers))))
    count))
(export-c [kernel :as "gap_provider_kernel"])

;;; One object owns its typed inputs. Construction is outside the timed query.
(defn create-context :cc (cc/C) [(modules i64) (facades i64) (repetitions i64)] (-> (ptr Context))
  (assert (and (> modules 0) (>= facades 0) (<= facades modules) (> repetitions 0)))
  (let [work (box! (malloc-allocator) scratch/ScratchArena (zeroed scratch/ScratchArena))]
    (scratch/ScratchArena::init-with-capacity work (malloc-allocator) 65536)
    (let [a (allocator work)
          context (box! a Context (Context :arena work :imports (avec-new [ImpEntry] a)
                                    :exports (avec-new [ExpEntry] a) :repetitions repetitions))
          selected (empty-names a)
          exclude (empty-names a) renames (empty-renames a)]
      (push! selected "primitive")
      (for [i 0 modules]
        (let [(mut edges) (ArrayList::new [Use] a)
              core (Use :target "coil.core" :spec (UAll) :exclude exclude :renames renames)]
          (push! (mut edges) (Use :target (if (< i facades) "base" "unrelated")
                               :spec (UNames selected) :exclude exclude :renames renames))
          (push! (mut (.imports context))
            (ImpEntry :name (sconcat a "module-" (i64->str a i)) :edit 0
              :imp (ModImports :aliases (ArrayList::new [Alias] a)
                     :uses (ArrayList::new [Use] a) :reexports edges :core core
                     :core_set false :forms (ArrayList::new [Sexp] a))))))
      context)))

(defn release-context :cc (cc/C) [(context (ptr Context))] (-> void)
  (let [work (.arena context)]
    (close! work)
    (destroy (malloc-allocator) work)))
(export-c [create-context :as "gap_provider_create"] [release-context :as "gap_provider_release"])
