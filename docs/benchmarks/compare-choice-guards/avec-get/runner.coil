(module gaps.avec-get-runner)
(import "coil.primitive" :as p)
(import "coil.alloc" :use [malloc-allocator])
(import "coil.scratch" :as scratch)
(import "coil.avec" :use [AVec avec-new])

(defstruct Node [(header u32) (op1 i32) (op2 i32) (op3 i32)])

(extern kernel :as "gap_avec_get" [(ptr u8) i64] (-> i64))

; One LLVM-built opaque caller for every backend. Use enough elements to cross
; trie levels; all vector storage is reclaimed with the owning scratch arena.
(defn main [] (-> i64)
  (let [arena (p/alloc-stack scratch/ScratchArena)
        _
          (scratch/ScratchArena::init-with-capacity arena
                                                    (malloc-allocator)
                                                    65536)
        (mut rows) (avec-new [Node] (scratch/ScratchArena::allocator arena))
        (mut total) 0]
    (for [i 0 4096]
      (push! (mut rows)
             (Node
               :header (cast u32 i)
               :op1 (cast i32 (* i 3))
               :op2 (cast i32 (+ (* i 7) 1))
               :op3 (cast i32 (- (* i 11) 9)))))
    (for [i 0 20000000]
      (set! total (+ total (kernel (p/cast (ptr u8) (mut rows)) (& i 4095)))))
    (scratch/ScratchArena::close! arena)
    (if (= total 859763163008) 0 1)))
