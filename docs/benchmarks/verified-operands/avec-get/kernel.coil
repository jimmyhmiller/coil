(module gaps.avec-get)
(import "coil.cc" :as cc)
(import "coil.primitive" :as p)
(import "coil.avec" :use [AVec avec-at])

(defstruct Node [(header u32) (op1 i32) (op2 i32) (op3 i32)])

; Profiled compiler work: checked arena-vector access through its trie.
(defn kernel :cc (cc/C) :inline (Never) [(rows (ptr (AVec Node)))
                                         (index i64)] (-> i64)
  (let [node (p/load (avec-at rows index))]
    (+ (cast i64 (.op1 node)) (cast i64 (.op2 node)) (cast i64 (.op3 node)))))

(export-c [kernel :as "gap_avec_get"])
