(module gaps.emission-kernel)
(import "coil.compiler.codegen_stogir" :as backend)
(import "coil.compiler.macho" :use [MTextData])
(import "tpde.cir" :as cir)
(import "tpde.asm" :as asm)
(import "tpde.buf" :as buf)
(import "coil.primitive" :as p)
(import "coil.cc" :as cc)
(import "coil.alloc" :use [malloc-allocator])
(import "coil.arraylist" :use [ArrayList])

;;; Opaque, caller-owned CIR. This measures the real backend without frontend work.
(defn kernel :cc (cc/C) :inline (Never)
  [(function (ptr cir/Func)) (assembler (ptr asm/Asm)) (symbol u32)] (-> i64)
  (let [(mut data) (ArrayList::new [MTextData] (malloc-allocator))]
    (backend/compile! function assembler symbol
      (p/cast (ptr (ArrayList MTextData)) (mut data)) 3)
    (assert (= (len data) 0))
    (free! (mut data))
    (len (buf/as-slice (asm/sect-buf assembler asm/SEC-TEXT)))))
(export-c [kernel :as "gap_emit_function"])
