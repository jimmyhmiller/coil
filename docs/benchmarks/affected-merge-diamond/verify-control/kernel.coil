(module gaps.verify-graph)
(import "stogir.graph" :as g)
(import "stogir.verify" :as verify)
(import "coil.cc" :as cc)
(import "coil.result" :use [Ok Err])

; The opaque caller constructs both valid and invalid inputs at runtime.
(defn kernel :cc (cc/C) :inline (Never) [(graph (ptr g/Graph))] (-> i64)
  (match (verify/integer-operations-target (load graph) 8)
    (Err [_] -1)
    (Ok [_] (len (.instructions (load graph))))))
(export-c [kernel :as "gap_verify_graph"])
