(module gaps.allocation-verify)
(import "stogir.allocation" :as a)
(import "stogir.allocation-check" :as check)
(import "stogir.interval" :as r)
(import "coil.arraylist" :use [ArrayList])
(import "coil.alloc" :use [malloc-allocator])
(import "coil.time" :use [monotonic-now])
(import "coil.result" :use [Ok Err])

(defn ticks [] (-> i64)
  (match (monotonic-now)
    (Ok [t] (+ (* (.sec t) 1000000000) (.nsec t)))
    (Err [_] (panic "clock failed"))))

(defn run [(count i64)] (-> void)
  (let [allocator (malloc-allocator)
        (mut parts) (ArrayList::new [a/Part] allocator)]
    ; Reverse input order and lifetime holes exercise actual range ordering.
    (for [j 0 count]
      (let [i (- (- count j) 1)
            (mut part) (a/create (cast i32 (% i 31)) allocator)]
        (set! (.allowed part) 3)
        (set! (.register part) (cast i32 (% i 2)))
        (for [k 0 4]
          (r/add! (mut (.ranges part))
                  (+ (* i 16) (* k 3))
                  (+ (* i 16) (* k 3) 2)))
        (push! (mut parts) part)))
    (let [before (ticks)]
      (for [i 0 3]
        (match (check/verify parts 2 3)
          (Err [e] (panic "{}" e))
          (Ok [n] (assert (= (cast i64 n) count)))))
      (println "{} {}" count (/ (- (ticks) before) 3)))
    (for [i 0 (len parts)] (a/release! (elem (mut parts) i)))
    (free! (mut parts))))

(defn main [] (-> i64)
  (for n [128 512 2048 8192] (run n))
  0)
