(module gaps.scalar-wrapper)
(import "coil.cc" :as cc)

; Ordinary source policy: a small helper that LLVM will normally inline.
(defn affine [(x i64)] (-> i64)
  (& (+ (* x 7) 3) 65535))

(defn kernel :cc (cc/C) :inline (Never) [(seed i64)] (-> i64)
  (let [(mut x) seed]
    (for [i 0 100] (set! x (affine x)))
    x))

(export-c [kernel :as "gap_scalar_wrapper"])

(defn main [] (-> i64)
  (let [(mut sum) 0]
    (for [i 0 1000000] (set! sum (+ sum (kernel (& i 65535)))))
    (println "{}" sum)
    0))
