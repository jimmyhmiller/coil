(module gaps.aggregate-local)
(import "coil.primitive" :as p)
(import "coil.cc" :as cc)

(defstruct Pair [(left i64) (right i64)])

; The public kernel accepts dynamic input; its arithmetic cannot be folded away.
(defn kernel :cc (cc/C) :inline (Never) [(x i64) (y i64)] (-> i64)
  (let [pair (Pair :left (+ x 3) :right (* y 7))]
    (+ (.left pair) (.right pair))))

(export-c [kernel :as "gap_aggregate_local"])

(defn main [] (-> i64)
  (let [(mut total) 0]
    (for [i 0 200000000]
      (set! total (+ total (kernel i (& i 15)))))
    (if (= total 20000011000000000) 0 1)))
