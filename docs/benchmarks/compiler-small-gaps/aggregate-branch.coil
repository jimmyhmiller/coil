(module gaps.aggregate-branch)
(import "coil.cc" :as cc)

(defstruct Pair [(left i64) (right i64)])

; The final field reads require values from different control predecessors.
(defn kernel :cc (cc/C) :inline (Never) [(x i64) (y i64) (odd bool)] (-> i64)
  (let [(mut pair) (Pair :left x :right y)]
    (if odd
        (set! (.left pair) (+ (.left pair) 7))
        (set! (.right pair) (* (.right pair) 3)))
    (+ (.left pair) (.right pair))))

(export-c [kernel :as "gap_aggregate_branch"])

(defn main [] (-> i64)
  (let [(mut total) 0]
    (for [i 0 200000000]
      (set! total (+ total (kernel i (& i 15) (!= (& i 1) 0)))))
    (if (= total 20000003500000000) 0 1)))
