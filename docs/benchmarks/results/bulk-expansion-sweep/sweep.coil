(module gaps.bulk-size-sweep)
(import "coil.cc" :as cc)
(import "coil.primitive" :as p)

(defstruct Wide64 [(head u64) (payload (array u64 6)) (tail u64)])
(defn project64 [(value Wide64)] (-> u64) (+ (* (.head value) 3) (.tail value)))
(defn kernel64 :cc (cc/C) :inline (Never) [(row (ptr Wide64))] (-> u64)
  (let [value (p/load row)] (project64 value)))

(defstruct Wide72 [(head u64) (payload (array u64 7)) (tail u64)])
(defn project72 [(value Wide72)] (-> u64) (+ (* (.head value) 3) (.tail value)))
(defn kernel72 :cc (cc/C) :inline (Never) [(row (ptr Wide72))] (-> u64)
  (let [value (p/load row)] (project72 value)))

