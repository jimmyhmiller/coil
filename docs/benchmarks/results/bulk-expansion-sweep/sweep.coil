(defn kernel512 :cc (cc/C) :inline (Never) [(row (ptr Wide512))] (-> u64)
  (let [value (p/load row)] (project512 value)))

(export-c [kernel64 :as "gap_bulk_64"] [kernel72 :as "gap_bulk_72"] [kernel80 :as "gap_bulk_80"] [kernel96 :as "gap_bulk_96"] [kernel128 :as "gap_bulk_128"] [kernel136 :as "gap_bulk_136"] [kernel256 :as "gap_bulk_256"] [kernel512 :as "gap_bulk_512"])
