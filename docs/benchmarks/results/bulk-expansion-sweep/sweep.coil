(defn kernel136 :cc (cc/C) :inline (Never) [(row (ptr Wide136))] (-> u64)
  (let [value (p/load row)] (project136 value)))

(defstruct Wide256 [(head u64) (payload (array u64 30)) (tail u64)])
(defn project256 [(value Wide256)] (-> u64) (+ (* (.head value) 3) (.tail value)))
(defn kernel256 :cc (cc/C) :inline (Never) [(row (ptr Wide256))] (-> u64)
