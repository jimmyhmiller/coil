(module gaps.zext-power)
(import "coil.cc" :as cc)
(defn quotient :cc (cc/C) :inline (Never) [(x u32)] (-> i64)
  (/ (cast i64 x) 4))
(defn remainder :cc (cc/C) :inline (Never) [(x u32)] (-> i64)
  (% (cast i64 x) 4))
(export-c [quotient :as "gap_zext_quotient"] [remainder :as "gap_zext_remainder"])
