(module gaps.inline-switch-selector)
(import "coil.cc" :as cc)
(import "coil.primitive" :as p)
(defsum Kind
  (K0 [(payload u64)]) (K1 [(payload u64)])
  (K2 [(payload u64)]) (K3 [(payload u64)])
  (K4 [(payload u64)]) (K5 [(payload u64)])
  (K6 [(payload u64)]) (K7 [(payload u64)])
  (K8 [(payload (array u64 3))]) (K9 [(payload (array u64 3))]))
(defstruct Aggregate [(kind Kind) (metadata (array u64 9))])
(defn tag [(value Aggregate)] (-> i64)
  (match (.kind value)
    (K0 [_] 0) (K1 [_] 1) (K2 [_] 2) (K3 [_] 3) (K4 [_] 4)
    (K5 [_] 5) (K6 [_] 6) (K7 [_] 7) (K8 [_] 8) (K9 [_] 6)))
(defn kernel :cc (cc/C) :inline (Never) [(value (ptr Aggregate))] (-> i64)
  (tag (load value)))
(defn size :cc (cc/C) [] (-> i64) (p/sizeof Aggregate))
(export-c [kernel :as "gap_inline_switch_selector"] [size :as "gap_inline_switch_size"])
