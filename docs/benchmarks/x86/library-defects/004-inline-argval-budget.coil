;;; Library defect 004 (in the fix of 001, library 9cb940a): expanding a call
;;; whose ARGVAL argument needs a private copy adds the copy's nodes (a frame
;;; object and a block move in the caller) to the clone, but the inliner's
;;; preflight counts only the callee's cells. With a budget between the two
;;; sizes the expansion passes the preflight and then fails the whole
;;; optimization with "inline cloning exceeded preflight budget" instead of
;;; declining the site.
;;;
;;; The callee stores through its MEMORY parameter, so the copy is needed.
;;; Every budget from 1 to 64 must give Ok (expanded or declined).
;;;
;;; Copy to the library's tests/ and run with tools/x86/remote-test.sh.
(module stogir.tests.x64-inline-argval-budget)
(import "stogir.graph" :as g)
(import "stogir.builder" :as b)
(import "stogir.calls" :as calls)
(import "stogir.symbols" :as symbols)
(import "stogir.call-inline" :as inlining)
(import "stogir.sccp-rewrite" :as rewrite)
(import "coil.alloc" :use [malloc-allocator Allocator])
(import "coil.result" :use [Result Ok Err Some None])

(defn require [(value (Result i32 (slice u8)))] (-> i32)
  (match value (Ok [r] r) (Err [message] (panic "{}" message))))

(defn bump-prototype [(a (dyn Allocator))] (-> calls/Prototype)
  (match (calls/create 8 11 [(: 6 u8)] a)
    (Err [message] (panic "prototype: {}" message))
    (Ok [owned]
        (let [(mut prototype) owned]
          (require (calls/memory-parameter! (mut prototype) 0 16 8))
          prototype))))

(defstruct Built [(graph g/Graph) (entry i32) (ret i32) (call i32)])

(defn bump-graph [(a (dyn Allocator))] (-> Built)
  (let [(mut graph) (g/create a)
        start (require (b/emit! (mut graph) 104 0 [(: 0 i32)]))
        p (require (b/emit! (mut graph) 71 6 [start (: 0 i32) 0]))
        one (require (b/scalar-constant! (mut graph) 11 1 8))
        v (require (b/emit! (mut graph) 91 11 [start p]))
        sum (require (b/emit! (mut graph) 26 11 [v one]))
        stored (require (b/emit! (mut graph) 93 0 [v p sum]))
        again (require (b/emit! (mut graph) 91 11 [stored p]))
        (mut own) (bump-prototype a)]
    (require (calls/function! (mut graph) own a))
    (calls/release! (mut own))
    (let [ret (require (b/emit! (mut graph) 120 11 [again again (: 0 i32)]))]
      (Built :graph graph :entry start :ret ret :call 0))))

(defn caller-graph [(a (dyn Allocator))] (-> Built)
  (let [(mut graph) (g/create a)
        start (require (b/emit! (mut graph) 104 0 [(: 0 i32)]))
        x (require (b/emit! (mut graph) 71 11 [start (: 0 i32) 0]))
        size (require (b/scalar-constant! (mut graph) 5 16 8))
        thousand (require (b/scalar-constant! (mut graph) 11 1000 8))
        frame (require (b/frame-object! (mut graph) start size 8))
        stored (require (b/emit! (mut graph) 93 0 [frame frame x]))
        copy (require (b/argument-value! (mut graph) frame 16 8))
        function (require (symbols/function! (mut graph) "_mem_bump" 0))
        (mut callee) (bump-prototype a)
        call (require (calls/emit! (mut graph) callee stored function [copy] a))
        after (require (b/emit! (mut graph) 91 11 [call frame]))
        scaled (require (b/emit! (mut graph) 28 11 [call thousand]))
        value (require (b/emit! (mut graph) 26 11 [scaled after]))
        own (match (calls/create 8 11 [(: 11 u8)] a)
              (Err [message] (panic "caller prototype: {}" message))
              (Ok [owned] owned))]
    (calls/release! (mut callee))
    (require (calls/function! (mut graph) own a))
    (let [ret (require (b/emit! (mut graph) 120 11 [after value (: 0 i32)]))]
      (Built :graph graph :entry start :ret ret :call call))))

(defn main [] (-> i64)
  (let [a (malloc-allocator)
        bump (bump-graph a)
        target (inlining/Callee :name "_mem_bump" :graph (.graph bump) :entry (.entry bump)
                                :roots [(.ret bump)] :observed [(.ret bump)]
                                :never false :always false :sparse false)
        (mut failures) 0]
    (for [budget 1 65]
      (let [caller (caller-graph a)]
        (match (inlining/optimize-sites-if-changed (.graph caller) [(.ret caller)]
                                                   [(inlining/Site :reference (.call caller)
                                                                   :target target)]
                                                   8 (cast i32 budget) a)
          (Err [message]
               (do (println "FAILED: budget {}: {}" budget message)
                   (set! failures (+ failures 1))))
          (Ok [_] 0))))
    (println "inline ARGVAL budgets: {} failures" failures)
    failures))
