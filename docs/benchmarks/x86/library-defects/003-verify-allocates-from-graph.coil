;;; Library defect 003: native-input verification allocates scratch memory
;;; from the allocator of the graph it is given (`verify.coil`: `argval/verify
;;; graph (.alc (.instructions graph))`, likewise switch/verify and
;;; terminal/verify-chains), not from the allocator the compile entry point
;;; was called with. A graph that only borrows its storage (an embedder's
;;; module arena shared by many graphs) is then written to by every thread
;;; compiling one of those graphs.
;;;
;;; The check, without threads: a graph with one ARGVAL call lives in a scratch
;;; arena; compiling it with another allocator must not allocate from the arena.
;;; Today the arena's allocation total grows.
;;;
;;; Copy to the library's tests/ and run with tools/x86/remote-test.sh.
(module stogir.tests.x64-verify-borrowed-graph)
(import "stogir.graph" :as g)
(import "stogir.builder" :as b)
(import "stogir.calls" :as calls)
(import "stogir.symbols" :as symbols)
(import "stogir.native.compile" :as compile)
(import "coil.scratch" :as scratch)
(import "coil.primitive" :as p)
(import "coil.alloc" :use [malloc-allocator Allocator allocator])
(import "coil.result" :use [Result Ok Err Some None])

(defn require [(value (Result i32 (slice u8)))] (-> i32)
  (match value (Ok [r] r) (Err [message] (panic "{}" message))))

(defn main [] (-> i64)
  (let [arena (p/alloc-stack scratch/ScratchArena)
        _ (scratch/ScratchArena::init-with-capacity arena (malloc-allocator) 65536)
        a (allocator arena)
        (mut graph) (g/create a)
        start (require (b/emit! (mut graph) 104 0 [(: 0 i32)]))
        x (require (b/emit! (mut graph) 71 11 [start (: 0 i32) 0]))
        size (require (b/scalar-constant! (mut graph) 5 16 8))
        frame (require (b/frame-object! (mut graph) start size 8))
        stored (require (b/emit! (mut graph) 93 0 [frame frame x]))
        copy (require (b/argument-value! (mut graph) frame 16 8))
        function (require (symbols/function! (mut graph) "_mem_bump" 0))
        (mut callee) (match (calls/create 8 11 [(: 6 u8)] a)
                       (Err [message] (panic "prototype: {}" message))
                       (Ok [owned] owned))
        _ (require (calls/memory-parameter! (mut callee) 0 16 8))
        call (require (calls/emit! (mut graph) callee stored function [copy] a))
        own (match (calls/create 8 11 [(: 11 u8)] a)
              (Err [message] (panic "caller prototype: {}" message))
              (Ok [owned] owned))
        _ (require (calls/function! (mut graph) own a))
        ret (require (b/emit! (mut graph) 120 11 [call call (: 0 i32)]))
        before (.total arena)]
    (match (compile/image graph start [ret] "_mem_caller" (malloc-allocator))
      (Err [message] (do (println "FAILED: does not compile: {}" message) 1))
      (Ok [_]
          (if (= (.total arena) before)
              (do (println "the graph's allocator was not used: ok") 0)
              (do (println "FAILED: compiling allocated {} bytes from the graph's own allocator"
                           (- (.total arena) before))
                  1))))))
