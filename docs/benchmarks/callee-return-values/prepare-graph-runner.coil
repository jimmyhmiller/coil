(module gaps.prepare-graph-runner)
(import "stogir.graph" :as g)
(import "stogir.node" :as n)
(import "coil.alloc" :use [malloc-allocator])
(import "coil.result" :use [Option Some None])
(import "coil.primitive" :as p)

(extern gap_prepare_graph [(ptr g/Graph) i32 i32] (-> u64))

(defn require [(value (Option i32))] (-> i32)
  (match value (Some [r] r) (None [] (panic "graph storage exhausted"))))

(defn main [] (-> i64)
  (let [a (malloc-allocator)
        (mut graph) (g/create a)
        start (require (g/append-inputs! (mut graph) 104 0 [(: 0 i32)]))
        input (require (g/append-inputs! (mut graph) 71 5 [start (: 0 i32) 0]))
        literal (require (g/intern-scalar! (mut graph) 5 7))
        (mut previous) input]
    (for [i 0 2048]
      (set! previous (require (g/append-inputs! (mut graph) (case (% i 4) 0 26 1 48 2 49 47)
                                      5 [previous literal])))
      (when (= (% i 16) 0)
        (let [condition (require (g/append-inputs! (mut graph) 14 1 [previous literal]))]
          (set! previous (require (g/append-inputs! (mut graph) 60 5 [condition previous literal]))))))
    (let [returned (require (g/append-inputs! (mut graph) 120 5 [start previous (: 0 i32)]))
          pointer (p/cast (ptr g/Graph) (mut graph))
          count (cast u64 returned)
          expected (/ (* count (+ count 1)) 2)
          original (get (.instructions graph) 3)]
      (assert (= (gap_prepare_graph pointer start returned) expected))
      ; Each backend must really validate, including layout, reference and type.
      (set! (mut (.arities graph)) 3 1)
      (assert (= (gap_prepare_graph pointer start returned) 0))
      (set! (mut (.arities graph)) 3 2)
      (let [(mut invalid) original]
        (set! (.op1 invalid) 999999)
        (set! (mut (.instructions graph)) 3 invalid)
        (assert (= (gap_prepare_graph pointer start returned) 0)))
      (set! (mut (.instructions graph)) 3 original)
      (assert (= (gap_prepare_graph pointer start 2147483647) 0))
      (let [(mut sum) (: 0 u64)]
        (for [i 0 1024] (set! sum (+ sum (gap_prepare_graph pointer start returned))))
        (assert (= sum (* expected 1024)))))
    (g/release! (mut graph))
    0))
