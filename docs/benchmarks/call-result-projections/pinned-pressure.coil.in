(module stogir.tests.jit-result-projections)
(import "stogir.graph" :as g)
(import "stogir.builder" :as b)
(import "stogir.calls" :as calls)
(import "stogir.call-results" :as results)
(import "stogir.pipeline" :as pipeline)
(import "stogir.a64.match" :as matching)
(import "stogir.matched-uses" :as machine)
(import "stogir.register-live" :as live)
(import "stogir.live-ranges" :as ranges)
(import "stogir.interval" :as interval)
(import "stogir.a64.constraints" :as constraints)
(import "stogir.a64.compile" :as compile)
(import "stogir.options" :as options)
(import "stogir.image" :as image)
(import "stogir.aot.macho" :as macho)
(import "coil.fs" :as fs)
(import "stogir.jit.darwin" :as jit)
(import "coil.alloc" :use [malloc-allocator])
(import "coil.arraylist" :use [ArrayList])
(import "coil.primitive" :as p)
(import "coil.cc" :as cc)
(import "coil.result" :use [Result Ok Err])

(defstruct Pair [(a u64) (b u64)])
(defn target :cc (cc/C) [(x u64)] (-> Pair)
  (Pair :a (^ x 0x123456789ABCDEF0) :b (+ x 17)))
(defn clobber :cc (cc/C) [(x u64)] (-> u64)
  (+ (* x 7) 31))
(defn require [(r (Result i32 (slice u8)))] (-> i32)
  (match r (Ok [v] v) (Err [e] (panic "{}" e))))

(defn fixture [(mode i32) (level i32)] (-> void)
  (let [a (malloc-allocator) (mut graph) (g/create a)
        start (require (b/emit! (mut graph) 104 0 [(: 0 i32)]))
        callee (require (b/emit! (mut graph) 71 6 [start (: 0 i32) 0]))
        other (require (b/emit! (mut graph) 71 6 [start (: 0 i32) 1]))
        x (require (b/emit! (mut graph) 71 5 [start (: 0 i32) 2]))
        destination (require (b/emit! (mut graph) 71 6 [start (: 0 i32) 3]))
        size (require (b/scalar-constant! (mut graph) 5 16 8))
        buffer (require (if (= mode 6)
                            (b/emit! (mut graph) 81 6 [start size (: 0 i32)])
                            (b/frame-object! (mut graph) start size 16)))
        offset (require (b/scalar-constant! (mut graph) 5 8 8))
        second (if (= mode 7) (: 0 i32) (require (b/emit! (mut graph) 26 6 [buffer offset])))
        piece-count (if (= mode 7) (: 1 i32) (: 2 i32))
        piece-type (if (= mode 8) (: 11 u8) (: 5 u8))
        selected? (or (< mode 2) (= mode 7) (= mode 8))
        (mut call) (: 0 i32) (mut first) (: 0 i32) (mut last) (: 0 i32)
        (mut control) buffer (mut saved) (ArrayList::new [i32] a)]
    ; Many independent values live across both calls exercise spills/splits.
    (for [i 0 36]
      (let [k (require (b/scalar-constant! (mut graph) 5 (cast u64 (+ 16 (* i 8))) 8))
            address (require (b/emit! (mut graph) 26 6 [destination k]))]
        (set! control (require (b/emit! (mut graph) 91 5 [control address])))
        (push! (mut saved) control)))
    (match (if (= mode 10)
               (calls/create-result 9 [(: 6 u8) 5 6] [] (results/pieces piece-type piece-count) a)
               (calls/create-result 9 [(: 6 u8) 5] [] (results/pieces piece-type piece-count) a))
      (Err [e] (panic "{}" e))
      (Ok [proto]
          (let [(mut proto) proto]
            (when (= mode 5)
              (set! control (require (calls/emit! (mut graph) proto control callee [buffer x] a))))
            (set! call (require (if (= mode 10)
                                      (calls/emit! (mut graph) proto control callee [buffer x buffer] a)
                                      (calls/emit! (mut graph) proto control callee [buffer x] a))))
            (calls/release! (mut proto)))))
    (set! first (require (b/emit! (mut graph) (if (= mode 4) 92 91) (cast i32 piece-type)
                                   [(if (= mode 11)
                                        (require (b/emit! (mut graph) 93 0 [call destination x])) call)
                                    (if (= mode 1) second buffer)])))
    (set! last (if (= mode 7) first
                   (require (b/emit! (mut graph) 91 (cast i32 piece-type)
                                     [first (if (= mode 1) buffer second)]))))
    (set! control last)
    (when (= mode 2)
      (set! control (require (b/emit! (mut graph) 93 0 [control buffer x]))))
    (when (= mode 3)
      (set! control (require (b/emit! (mut graph) 91 5 [control buffer]))))
    (let [first-bits (if (= mode 8) (require (b/conversion! (mut graph) 36 5 8 first)) first)
          last-bits (if (= mode 8) (require (b/conversion! (mut graph) 36 5 8 last)) last)
          (mut sum) (require (b/emit! (mut graph) 26 5 [first-bits last-bits]))]
      (match (calls/create 9 5 [(: 5 u8)] a)
        (Err [e] (panic "{}" e))
        (Ok [proto]
            (let [(mut proto) proto]
              (set! control (require (calls/emit! (mut graph) proto control other [x] a)))
              (calls/release! (mut proto)))))
      (set! sum (require (b/emit! (mut graph) 26 5 [sum control])))
      (set! control (require (b/emit! (mut graph) 93 0 [control destination first-bits])))
      (let [address (require (b/emit! (mut graph) 26 6 [destination offset]))]
        (set! control (require (b/emit! (mut graph) 93 0 [control address last-bits]))))
      (for value saved (set! sum (require (b/emit! (mut graph) 26 5 [sum value]))))
      (let [ret (require (b/emit! (mut graph) 120 5 [control sum (: 0 i32)]))
            (mut roots) (ArrayList::new [i32] a)]
        (push! (mut roots) ret)
        (when (= mode 9) (push! (mut roots) first))
        (match (pipeline/prepare graph start (slice roots) a)
          (Err [e] (panic "{}" e))
          (Ok [owned]
              (let [(mut prepared) owned]
                (match (matching/build graph (.schedule prepared) (slice roots) true a)
                  (Err [e] (panic "{}" e))
                  (Ok [owned]
                      (let [(mut plan) owned
                            outputs (machine/output-range (.operands plan) call)]
                        (assert (= (.count outputs) (if selected? (cast i64 piece-count) 0)))
                        (assert (= (machine/definition-count (.operands plan) call) (if selected? (cast i64 piece-count) 0)))
                        (assert (= (machine/definition-count (.operands plan) first) (if selected? 0 1)))
                        (assert (= (machine/defining-reference (.operands plan) last) (if selected? call last)))
                        (assert (= (get (.omitted (.operands plan)) (cast i64 first)) selected?))
                        (assert (= (get (.omitted (.operands plan)) (cast i64 last)) selected?))
                        ; Rejected groups cannot partially mutate metadata.
                        (when selected?
                          (let [before (len (.outputs (.operands plan)))]
                          (assert (not (machine/define-outputs! (mut (.operands plan)) control [first last])))
                          (assert (= before (len (.outputs (.operands plan)))))))
                        (when selected?
                          (let [(mut analysis) (live/analyze-matched graph (.blocks prepared)
                                                        (.schedule prepared) (.order prepared)
                                                        (.operands plan) a)
                                (mut intervals) (ranges/build-matched graph (.schedule prepared)
                                                        analysis (.order prepared) (.operands plan) a)
                                (mut birth) (: -1 i64)]
                            (for [i 0 (len (.nodes (.schedule prepared)))]
                              (when (= (get (.nodes (.schedule prepared)) i) call)
                                (set! birth (+ (* i 2) 1))))
                            (for value saved
                              (assert (interval/covers? (.ranges (get intervals (cast i64 value))) birth)))
                            (for output [first last]
                              (assert (> (len (.ranges (get intervals (cast i64 output)))) 0))
                              (assert (= (.start (get (.ranges (get intervals (cast i64 output))) 0)) birth)))
                            (match (constraints/build-matched graph (.schedule prepared) plan a)
                              (Err [e] (panic "{}" e))
                              (Ok [owned]
                                  (let [(mut req) owned]
                                    (for [piece 0 (cast i64 piece-count)]
                                      (let [output (machine/definition-at (.operands plan) call piece)
                                            (mut found) false]
                                        (for use (.uses (get req (cast i64 output)))
                                          (when (and (= (.position use) birth) (= (.kind use) 2)
                                                     (= (.register use) (cast i32 piece)))
                                            (set! found true)))
                                        (assert found)))
                                    (constraints/release! (mut req)))))
                            (ranges/release! (mut intervals))
                            (live/release-analysis! (mut analysis))))
                        (matching/release! (mut plan)))))
                (pipeline/release! (mut prepared)))))
        (match (compile/image-with-options graph start (slice roots) "_result_projection"
                                           (options/Options :level level) a)
          (Err [e] (panic "{}" e))
          (Ok [owned]
              (let [(mut output) owned]
                (when (and selected? (= level 3))
                  (match (macho/image-object output a)
                    (Err [e] (panic "{}" e))
                    (Ok [owned]
                        (let [(mut object) owned
                              path (match mode
                                     (0 "/tmp/coil-stogir-result-projections.o")
                                     (1 "/tmp/coil-stogir-result-projections-reverse.o")
                                     (7 "/tmp/coil-stogir-result-projections-one.o")
                                     (_ "/tmp/coil-stogir-result-projections-signed.o"))]
                          (match (fs/write-file a path (slice object))
                            (Err [_] (panic "projection object write failed")) (Ok [_] 0))
                          (free! (mut object))))))
                ; Exercise relocation/image lifetime independent of the graph.
                (g/release! (mut graph))
                (match (jit/map-image output a)
                  (Err [e] (panic "{}" e))
                  (Ok [owned]
                      (let [(mut mapped) owned
                            f (p/cast (fnptr (cc/C) [u64 u64 u64 (ptr u64)] u64)
                                       (p/cast (ptr u8) (get (.addresses mapped) 0)))
                            target-address (p/cast u64 (p/cast (ptr u8) (fnptr-of target)))
                            other-address (p/cast u64 (p/cast (ptr u8) (fnptr-of clobber)))]
                        (for x [(: 0 u64) 1 17 0x8000000000000000 0xFFFFFFFFFFFFFFFF]
                          (let [pair (target x) (mut observed) (ArrayList::new [u64] a)
                                (mut expected) (+ (.a pair) (if (= mode 7) (.a pair) (.b pair)) (clobber x))]
                            (for [i 0 36] (set! expected (+ expected (* x (cast u64 (+ i 3))))))
                            (for [i 0 40] (push! (mut observed) 0xAABBCCDDEEFF0011))
                            (for [i 0 36] (set! (mut observed) (+ i 3) (* x (cast u64 (+ i 3)))))
                            (assert (= (f target-address other-address x
                                           (p/index (.data observed) 1)) expected))
                            (assert (= (get observed 0) 0xAABBCCDDEEFF0011))
                            (assert (= (get observed 39) 0xAABBCCDDEEFF0011))
                            (assert (= (get observed 1) (if (= mode 1) (.b pair) (.a pair))))
                            (assert (= (get observed 2) (if (or (= mode 1) (= mode 7)) (.a pair) (.b pair))))
                            (for [i 0 36]
                              (assert (= (get observed (+ i 3)) (* x (cast u64 (+ i 3))))))
                            (free! (mut observed))))
                        (jit/release-image! (mut mapped)))))
                (image/release! (mut output)))))
        (free! (mut roots))))
    (free! (mut saved))))

(defn main [] (-> i64)
  (for level [(: 1 i32) 3]
    (for [mode 0 12] (fixture (cast i32 mode) level)))
  (println "result projection native pressure:120 answers passed, O1/O3")
  0)
