(module demo)
(import "coil.scheme" :use *)
(define (square x) (let [$g68 (gc-sp)] (gc-root x) (do (gc-sp-set! $g68) (* x x))))
(define (fact n) (let [$g69 (gc-sp)] (gc-root n) (if (truthy? (= n (mk-fixnum 0))) (do (gc-sp-set! $g69) (mk-fixnum 1)) (let [$g71 (let [$g70 (- n (mk-fixnum 1))] (gc-root $g70) (fact $g70))] (gc-root $g71) (do (gc-sp-set! $g69) (* n $g71))))))
(define (sum-to n) (let [$g72 (gc-sp)] (gc-root n) (let [$g73 (let [$g74 (let [$g75 (closure-fnptr3 $g67)] (gc-root $g75) (let [$g76 (list n)] (gc-root $g76) (make-closure $g75 $g76 3)))] (gc-root $g74) (scm-let (($g34 $g74)) (let [$g77 (list (mk-fixnum 0) (mk-fixnum 0))] (gc-root $g77) (apply $g34 $g34 $g77))))] (gc-sp-set! $g72) $g73)))
(defn main [] (-> i64) (let [$g78 (gc-sp)] (let [$g79 (square (mk-fixnum 7))] (gc-root $g79) (display $g79)) (newline) (let [$g80 (fact (mk-fixnum 10))] (gc-root $g80) (display $g80)) (newline) (let [$g81 (sum-to (mk-fixnum 100))] (gc-root $g81) (display $g81)) (newline) (do (gc-sp-set! $g78) (fixnum-value (mk-fixnum 0)))))
(defn $g66 [(env i64) (i i64) (acc i64)] (-> i64) (let [$g82 (gc-sp)] (gc-root env) (gc-root i) (gc-root acc) (let [$g87 (let [$g83 (env-ref env 0)] (gc-root $g83) (let [$g84 (env-ref env 0)] (gc-root $g84) (let [$g86 (let [$g85 (list i acc)] (gc-root $g85) (scm-list-args $g85))] (gc-root $g86) (list $g83 $g84 $g86))))] (gc-root $g87) (do (gc-sp-set! $g82) (scm-tail-request-apply-args $g87)))))
(defn $g67 [(env i64) ($g35 i64) (i i64) (acc i64)] (-> i64) (let [$g88 (gc-sp)] (gc-root env) (gc-root $g35) (gc-root i) (gc-root acc) (let [$g89 (let [$g90 (let [$g91 (closure-fnptr2 $g66)] (gc-root $g91) (let [$g92 (list $g35)] (gc-root $g92) (make-closure $g91 $g92 2)))] (gc-root $g90) (scm-let ((loop $g90)) (if (truthy? (let [$g94 (let [$g93 (env-ref env 0)] (gc-root $g93) (list i $g93))] (gc-root $g94) (scm-gt-args $g94))) acc (let [$g95 (+ i (mk-fixnum 1))] (gc-root $g95) (let [$g96 (+ acc i)] (gc-root $g96) (coil.scheme.stdproc.call--2 loop $g95 $g96))))))] (gc-sp-set! $g88) $g89)))
