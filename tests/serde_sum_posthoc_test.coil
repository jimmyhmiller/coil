; Post-hoc sum derive: an already-defined defsum derives via
; the code-variant-field-* reflection ops — needs a compiler that has them.
(module serde-sum-posthoc-tests)
(import "coil.primitive" :as primitive)
(import "coil.alloc" :as alloc)
(import "coil.alloc" :use *)
(import "coil.slice" :use *)
(import "coil.str" :use *)
(import "coil.arraylist" :use *)
(import "coil.serde" :use *)
(import "coil.serde.derive" :use *)
(import "coil.serde.json" :use *)
(import "coil.serde.msgpack" :use *)

; plain defsum FIRST; derive comes later, like coil.derive's post-hoc Eq/Hash
(defstruct Pt [(x i64) (y i64)])
(derive Serialize Deserialize Pt)

(defsum Ev
  (Boot)
  (Click [(at Pt) (button u8)])
  (Note [(text (slice u8)) (tag (Option (slice u8)))]))

(derive (Serialize (field button (default 1)))
        (Deserialize (field button (default 1)))
        Ev)

(defn ev-eq [(a Ev) (b Ev)] (-> bool)
  (match a
    (Boot [] (match b (Boot [] true) (Click [_ _] false) (Note [_ _] false)))
    (Click [ap ab]
           (match b
             (Click [bp bb]
                    (let [pa (alloc/stack Pt)
                          pb (alloc/stack Pt)]
                      (set! pa ap)
                      (set! pb bp)
                      (and (and (= (.x pa) (.x pb))
                                (= (.y pa) (.y pb)))
                           (= (primitive/cast i64 ab) (primitive/cast i64 bb)))))
             (Boot [] false)
             (Note [_ _] false)))
    (Note [at atag]
          (match b
            (Note [bt btag]
                  (and (= at bt)
                       (match atag
                         (None [] (match btag (None [] true) (Some [_] false)))
                         (Some [av] (match btag (None [] false) (Some [bv] (= av bv)))))))
            (Boot [] false)
            (Click [_ _] false)))))

(deftest posthoc-sum-roundtrip
         (let [a (malloc-allocator)
               (mut p) (primitive/zeroed Pt)]
           (store! (field p x) 3)
           (store! (field p y) 4)
           ; struct-payload variant with a nested derived struct + narrow int
           (match (to-json-str a (Click (load p) (primitive/cast u8 2)))
             (Err [_] (assert false))
             (Ok [s]
                 (do
                   (assert (= s "{\"Click\":{\"at\":{\"x\":3,\"y\":4},\"button\":2}}"))
                   (match (from-json [Ev] a s)
                     (Err [_] (assert false))
                     (Ok [e] (assert (ev-eq e (Click (load p) (primitive/cast u8 2)))))))))
           ; unit variant
           (match (from-json [Ev] a "\"Boot\"")
             (Err [_] (assert false))
             (Ok [e] (assert (ev-eq e (Boot)))))
           ; Option payload field: absent -> None; option (default …) honored
           (match (from-json [Ev] a "{\"Note\":{\"text\":\"hi\"}}")
             (Err [_] (assert false))
             (Ok [e] (assert (ev-eq e (Note "hi" (None [(slice u8)]))))))
           (match (from-json [Ev] a "{\"Click\":{\"at\":{\"x\":3,\"y\":4}}}")
             (Err [_] (assert false))
             (Ok [e] (assert (ev-eq e (Click (load p) (primitive/cast u8 1))))))))

(deftest posthoc-sum-msgpack
         (let [a (malloc-allocator)]
           (match (to-msgpack-bytes a (Note "n" (Some "t")))
             (Err [_] (assert false))
             (Ok [b]
                 (match (from-msgpack [Ev] a b)
                   (Err [_] (assert false))
                   (Ok [e] (assert (ev-eq e (Note "n" (Some "t"))))))))))
