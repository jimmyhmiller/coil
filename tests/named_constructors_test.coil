(module coil.tests.named-constructors)
(import "coil.primitive" :as primitive)
(import "coil.assert" :use *)
(import "coil.debug" :use *)
(import "coil.io" :as io)
(import "coil.str" :as str)
(import "coil.slice" :use [slice-new])

(defstruct Point [(x i64) (y i64)])
(derive Debug Point)

(defstruct Line [(start Point) (end Point)])
(derive Debug Line)

(defstruct Pair [A B] [(first A) (second B)])

; Deliberately has no Debug impl. A skipped field must disappear from the
; generated implementation, not merely be hidden after Debug dispatch.
(defstruct Secret [(raw i64)])
(defstruct Account [(name (slice u8)) (secret Secret) (active bool)])
(derive (Debug (field secret (skip))) Account)

(defsum Shape
  (Dot)
  (Circle [(radius i64)])
  (Rect [(width i64) (height i64)]))
(derive Debug Shape)

(defsum Notice
  (Empty)
  (Message [(text (slice u8)) (secret Secret)]))
(derive (Debug (variant Message (field secret (skip)))) Notice)

(defn rendered [(x Code) (buf Code) (cap Code)] (-> Code)
  (let [fb (primitive/fresh-identifier "fix-buffer")
        w (primitive/fresh-identifier "writer")
        b (primitive/fresh-identifier "buffer")
        c (primitive/fresh-identifier "capacity")]
    `(let [~fb (primitive/alloc-stack io/FixBuf)
           ~w (primitive/alloc-stack io/Writer)
           ~b ~buf
           ~c ~cap]
       (store! (field ~fb data) ~b)
       (store! (field ~fb cap) ~c)
       (store! (field ~fb len) 0)
       (io/fixed-buffer-writer ~w ~fb)
       (debug-write ~x ~w)
       (slice-new [u8] (primitive/cast (ptr u8) ~b) (load (field ~fb len))))))

(deftest named-struct-fields-are-order-independent
         (let [p (Point :y 20 :x 10)]
           (assert-eq (load (field p x)) 10)
           (assert-eq (load (field p y)) 20)))

(deftest named-structs-nest
         (let [line
                 (Line :end
                       (Point :y 4 :x 3)
                       :start
                       (Point :x 1 :y 2))]
           (assert-eq (load (field (field line start) x)) 1)
           (assert-eq (load (field (field line end) y)) 4)))

(deftest generic-struct-fields-infer-type-arguments
         (let [pair (Pair :second true :first 42)]
           (assert-eq (load (field pair first)) 42)
           (assert (load (field pair second)))))

(deftest named-sum-payloads-are-order-independent
         (match (Rect :height 7 :width 6)
           (Rect [w h] (do (assert-eq w 6) (assert-eq h 7)))
           (_ (assert false))))

(deftest derived-debug-is-a-pasteable-constructor
         (let [buf (primitive/alloc-stack (array u8 256))
               line
                 (Line :end
                       (Point :y 4 :x 3)
                       :start
                       (Point :x 1 :y 2))]
           (assert (str/str-eq (rendered line (primitive/cast (ptr i8) buf) 256)
                               "(Line\n  :start (Point\n    :x 1\n    :y 2\n  )\n  :end (Point\n    :x 3\n    :y 4\n  )\n)"))))

(deftest derived-sum-debug-is-a-pasteable-constructor
         (let [buf (primitive/alloc-stack (array u8 128))]
           (assert (str/str-eq (rendered (Rect :height 7 :width 6) (primitive/cast (ptr i8) buf) 128)
                               "(Rect\n  :width 6\n  :height 7\n)"))))

(deftest derived-debug-can-skip-a-struct-field
         (let [buf (primitive/alloc-stack (array u8 128))
               account (Account :name "Ada" :secret (Secret :raw 8675309) :active true)]
           (assert (str/str-eq (rendered account (primitive/cast (ptr i8) buf) 128)
                               "(Account\n  :name \"Ada\"\n  :active true\n)"))))

(deftest derived-debug-can-skip-one-variants-field
         (let [buf (primitive/alloc-stack (array u8 128))
               notice (Message :text "hello" :secret (Secret :raw 8675309))]
           (assert (str/str-eq (rendered notice (primitive/cast (ptr i8) buf) 128)
                               "(Message\n  :text \"hello\"\n)"))))
