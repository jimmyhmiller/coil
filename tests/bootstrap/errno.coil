(module bootstrap_errno)
(import "coil.os" :as os)
(import "coil.primitive" :as p)
(extern write :cc c [i32 (ptr u8) isize] (-> isize))
(defn main [] (-> i64)
  (os/os-set-errno! 73)
  (if (!= (os/os-errno) 73) 1
    (do
      (let [result (write (p/cast i32 -1) (p/cast (ptr u8) 0) 0)]
        (if (!= result (p/cast isize -1)) 2
          (if (!= (os/os-errno) 9) 3
            (do (os/os-set-errno! 0) (if (= (os/os-errno) 0) 0 4))))))))
