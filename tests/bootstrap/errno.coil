(module bootstrap_errno)
(import "coil.os" :as os)
(import "coil.primitive" :as p)
(import "coil.cc" :as cc)
(import "native.buf" :as buf)

(extern write :cc (cc/C) [i32 (ptr u8) isize] (-> isize))

;;; The compiler's byte storage must work through the portable wasm backend,
;;; including unaligned words. It must not require the LLVM-IR memory parser.
(defn buffer-roundtrip [] (-> bool)
  (let [(mut bytes) (buf/Buf::new)]
    (buf/emit8! (mut bytes) (: 0xaa u8))
    (buf/emit16! (mut bytes) (: 0x1234 u16))
    (buf/emit32! (mut bytes) (: 0x89abcdef u32))
    (buf/emit64! (mut bytes) (: 0xfedcba9876543210 u64))
    (let [ok
            (and (= (buf/read16 (mut bytes) 1) (: 0x1234 u16))
                 (= (buf/read32 (mut bytes) 3) (: 0x89abcdef u32))
                 (= (buf/read64 (mut bytes) 7) (: 0xfedcba9876543210 u64)))]
      (buf/patch32! (mut bytes) 1 (: 0x10203040 u32))
      (let [patched (= (buf/read32 (mut bytes) 1) (: 0x10203040 u32))]
        (buf/buf-free! (mut bytes))
        (and ok patched)))))

(defn main [] (-> i64)
  (if (not (buffer-roundtrip)) 5 (check-errno)))

(defn check-errno [] (-> i64)
  (os/set-errno! 73)
  (if (!= (os/errno) 73)
      1
      (do
        (let [result (write (: -1 i32) (p/cast (ptr u8) 0) 0)]
          (if (!= result (p/cast isize -1))
              2
              (if (!= (os/errno) 9)
                  3
                  (do (os/set-errno! 0) (if (= (os/errno) 0) 0 4))))))))
