(module subprocess-test)
(import "coil.primitive" :as primitive)
(import "coil.alloc" :as alloc)
(import "coil.slice" :use [slice-new])
(import "coil.str" :as str)
(import "coil.io" :as io)
(import "coil.subprocess" :as subprocess)
(import "coil.time" :as time)
(import "coil.try" :use [try try-or! some-or! ensure!])

(defn exited-zero? [(status subprocess/ExitStatus)] (-> bool)
  (match status (subprocess/Exited [code] (= code 0)) (subprocess/Signaled [_] false)))

(defn pipe-roundtrip [(a (dyn alloc/Allocator))] (-> i64)
  (try (let [child (primitive/alloc-stack subprocess/Child)
             no-args (slice-new (primitive/cast (ptr (slice u8)) 0) 0)
             writer (primitive/alloc-stack io/Writer)
             reader (primitive/alloc-stack io/Reader)]
         (try-or! (subprocess/spawn a
                                    child
                                    "/bin/cat"
                                    no-args
                                    (subprocess/pipe-stdio)
                                    (subprocess/pipe-stdio)
                                    (subprocess/inherit-stdio))
                  10)
         (some-or! (subprocess/child-stdin-writer writer child) 11)
         (some-or! (subprocess/child-stdout-reader reader child) 12)
         (try-or! (io/write-line writer "round trip") 13)
         (subprocess/child-close-stdin child)
         (let [line (try-or! (io/read-line-alloc a reader 128) 14)
               linep (primitive/alloc-stack io/OwnedBytes)]
           (store! linep line)
           (ensure! (str/str-eq (io/owned-bytes-slice line) "round trip") 15)
           (io/owned-bytes-free a linep))
         (ensure! (exited-zero? (try-or! (subprocess/child-wait child) 16)) 17)
         (try-or! (subprocess/child-close child) 18)
         0)))

(defn exact-argv [(a (dyn alloc/Allocator))] (-> i64)
  (try
    (let [child (primitive/alloc-stack subprocess/Child)
          args (primitive/alloc-stack (array (slice u8) 3))
          reader (primitive/alloc-stack io/Reader)]
      (store! (primitive/index args 0) "<%s><%s>\n")
      (store! (primitive/index args 1) "a b;*$HOME")
      (store! (primitive/index args 2) "")
      (try-or! (subprocess/spawn a
                                 child
                                 "/usr/bin/printf"
                                 (slice-new (primitive/index args 0) 3)
                                 (subprocess/inherit-stdio)
                                 (subprocess/pipe-stdio)
                                 (subprocess/null-stdio))
               30)
      (some-or! (subprocess/child-stdout-reader reader child) 31)
      (let [line (try-or! (io/read-line-alloc a reader 128) 32)
            linep (primitive/alloc-stack io/OwnedBytes)]
        (store! linep line)
        (ensure! (str/str-eq (io/owned-bytes-slice line) "<a b;*$HOME><>") 33)
        (io/owned-bytes-free a linep))
      (ensure! (exited-zero? (try-or! (subprocess/child-wait child) 34)) 35)
      (ensure! (exited-zero? (try-or! (subprocess/child-wait child) 36)) 37)
      (try-or! (subprocess/child-close child) 38)
      (try-or! (subprocess/child-close child) 39)
      0)))

(defn timeout-and-terminate [(a (dyn alloc/Allocator))] (-> i64)
  (try (let [child (primitive/alloc-stack subprocess/Child)
             args (primitive/alloc-stack (array (slice u8) 1))]
         (store! (primitive/index args 0) "1")
         (try-or! (subprocess/spawn a
                                    child
                                    "/bin/sleep"
                                    (slice-new (primitive/index args 0) 1)
                                    (subprocess/inherit-stdio)
                                    (subprocess/inherit-stdio)
                                    (subprocess/inherit-stdio))
                  20)
         (match (try-or! (subprocess/child-try-wait child) 21)
           (Some [_] (return-from :try 22))
           (None [] 0))
         (let [duration (try-or! (time/duration-millis 20) 23)
               deadline (try-or! (time/deadline-after duration) 24)]
           (match (subprocess/child-wait-until child deadline)
             (Ok [_] (return-from :try 25))
             (Err [error]
                  (match error
                    (subprocess/Timeout [] 0)
                    (subprocess/InvalidCommand [] (return-from :try 26))
                    (subprocess/OutOfMemory [] (return-from :try 26))
                    (subprocess/PipeFailed [_] (return-from :try 26))
                    (subprocess/SpawnFailed [_] (return-from :try 26))
                    (subprocess/WaitFailed [_] (return-from :try 26))
                    (subprocess/SignalFailed [_] (return-from :try 26))
                    (subprocess/StillRunning [] (return-from :try 26))
                    (subprocess/AlreadyClosed [] (return-from :try 26))))))
         (try-or! (subprocess/child-terminate child) 27)
         (match (try-or! (subprocess/child-wait child) 28)
           (subprocess/Signaled [signal] (ensure! (= signal 15) 29))
           (subprocess/Exited [_] (return-from :try 29)))
         (try-or! (subprocess/child-close child) 29)
         0)))

(defn main [] (-> i64)
  (try (let [a (alloc/malloc-allocator)
             child (primitive/alloc-stack subprocess/Child)
             args (primitive/alloc-stack (array (slice u8) 1))]
         (store! (primitive/index args 0) "hello world")
         (try-or! (subprocess/spawn a
                                    child
                                    "/bin/echo"
                                    (slice-new (primitive/index args 0) 1)
                                    (subprocess/inherit-stdio)
                                    (subprocess/pipe-stdio)
                                    (subprocess/inherit-stdio))
                  1)
         (let [reader (primitive/alloc-stack io/Reader)]
           (some-or! (subprocess/child-stdout-reader reader child) 2)
           (let [line (try-or! (io/read-line-alloc a reader 128) 3)
                 linep (primitive/alloc-stack io/OwnedBytes)]
             (store! linep line)
             (ensure! (str/str-eq (io/owned-bytes-slice line) "hello world") 4)
             (io/owned-bytes-free a linep)))
         (ensure! (exited-zero? (try-or! (subprocess/child-wait child) 5)) 6)
         (try-or! (subprocess/child-close child) 7)
         
         ; Missing executables are synchronous spawn errors, never exit status 127.
         (let [missing (primitive/alloc-stack subprocess/Child)
               no-args (slice-new (primitive/cast (ptr (slice u8)) 0) 0)]
           (match (subprocess/spawn a
                                    missing
                                    "/definitely/not/a/coil/executable"
                                    no-args
                                    (subprocess/inherit-stdio)
                                    (subprocess/inherit-stdio)
                                    (subprocess/inherit-stdio))
             (Ok [_] 8)
             (Err [_]
                  (let [roundtrip (pipe-roundtrip a)]
                    (if (!= roundtrip 0)
                        roundtrip
                        (let [argv-result (exact-argv a)]
                          (if (!= argv-result 0) argv-result (timeout-and-terminate a)))))))))))
