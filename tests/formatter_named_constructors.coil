(module formatter-named-constructors)

(defstruct Point [(x i64) (y i64) (z i64)])

(defstruct Line [(start Point) (end Point)])

(defn example [] (-> Point)
  (Point
    :x 1
    :y (+ 1 1)
    :z 3))

(defn nested [] (-> Line)
  (Line
    :start
      (Point
        :x 1
        :y 2
        :z 3)
    :end
      (Point
        :x 4
        :y 5
        :z 6)))
