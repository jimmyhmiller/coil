(module fs-dir-list-test)
(import "coil.fs" :as fs)
(import "coil.io" :use [Errno OutOfMemory])
(import "coil.alloc" :use [malloc-allocator arena-allocator])

(deftest dir-list-reads-a-directory
  (let [a (malloc-allocator)]
    (match (fs/dir-list a "src/stdlib")
      (Ok [names]
        (let [(mut found) false (mut owned) names]
          (for name names (when (= name "fs.coil") (set! found true)))
          (fs/dir-list-free a (mut owned))
          (assert found)))
      (Err [_] (assert false)))))

(deftest dir-list-reports-errno-for-a-missing-directory
  (match (fs/dir-list (malloc-allocator) "/nonexistent/coil-test")
    (Err [(Errno [code])] (assert (> code 0)))
    (_ (assert false))))

(deftest dir-list-reports-out-of-memory-for-the-path
  (match (fs/dir-list (arena-allocator 0) "src/stdlib")
    (Err [(OutOfMemory [])] (assert true))
    (_ (assert false))))
