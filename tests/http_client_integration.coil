(module http-client-integration)
(import "coil.primitive" :as primitive)
(import "coil.http.client" :as http)
(import "coil.alloc" :as alloc)
(import "coil.slice" :as slice)
(import "coil.str" :as str)

(defn main [] (-> i64)
  (let [a (alloc/malloc-allocator)
        req (alloc/stack http/Request)]
    (store! (field req method) "POST")
    (store! (field req url) "http://127.0.0.1:38473/echo")
    (store! (field req headers) (slice/slice-new [http/Header] (primitive/cast (ptr http/Header) 0) 0))
    (store! (field req body) "coil-body")
    (store! (field req connect-timeout-ms) 1000)
    (store! (field req timeout-ms) 3000)
    (store! (field req follow-redirects) false)
    (match (http/request a req)
      (Err [e] 10)
      (Ok [response]
          (let [ok
                  (and (= (http/response-status response) (primitive/cast i64 418))
                       (and (str/str-eq (http/response-body response) "coil-body")
                            (>= (http/response-header-count response) (primitive/cast i64 6))))]
            (http/response-free a response)
            (if (not ok)
                11
                (do
                  (store! (field req url) "http://127.0.0.1:1/unreachable")
                  (store! (field req body) "")
                  (match (http/request a req)
                    (Err [e] 0)
                    (Ok [unexpected]
                        (do (http/response-free a unexpected) 12))))))))))
