(module http-client-integration)
(import "coil.primitive" :as primitive)
(import "coil.http.client" :as http)
(import "coil.alloc" :as alloc)
(import "coil.slice" :as slice)
(import "coil.str" :as str)

(defn main [] (-> i64)
  (let [a (alloc/malloc-allocator)
        req (primitive/alloc-stack http/Request)]
    (set! (.method req) "POST")
    (set! (.url req) "http://127.0.0.1:38473/echo")
    (set! (.headers req) (slice/slice-new [http/Header] (primitive/cast (ptr http/Header) 0) 0))
    (set! (.body req) "coil-body")
    (set! (.connect-timeout-ms req) 1000)
    (set! (.timeout-ms req) 3000)
    (set! (.follow-redirects req) false)
    (match (http/request a req)
      (Err [e] 10)
      (Ok [response]
          (let [ok
                  (and (= (http/response-status response) (primitive/cast i64 418))
                       (and (str/str-eq (http/response-body response) "coil-body")
                            (>= (http/response-header-count response) (primitive/cast i64 6))))]
            (http/response-free a response)
            (if (not ok)
                11
                (do
                  (set! (.url req) "http://127.0.0.1:1/unreachable")
                  (set! (.body req) "")
                  (match (http/request a req)
                    (Err [e] 0)
                    (Ok [unexpected]
                        (do (http/response-free a unexpected) 12))))))))))
