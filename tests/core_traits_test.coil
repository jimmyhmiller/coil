(module coil.tests.core-traits)
(import "coil.alloc" :use [malloc-allocator])
(import "coil.arraylist" :use [al-new al-free!])
(import "coil.math" :as math)
(import "coil.str" :use [sb-new sb-format! sb-str sb-free!])

(defstruct Point [(x i64) (y i64)])
(derive Eq Point)

(defsum Token (End) (Number [(value (Option i64))]))
(derive Eq Token)

(deftest option-equality-compares-variant-and-payload
  (assert-eq (Some 1) (Some 1))
  (assert-ne (Some 1) (Some 2))
  (assert-ne (Some 1) (: (None) (Option i64)))
  (assert-eq (: (None) (Option i64)) (: (None) (Option i64)))
  (assert-eq (Some (Some "ab")) (Some (Some "ab")))
  (assert-eq (Some (Point :x 1 :y 2)) (Some (Point :x 1 :y 2))))

(deftest result-equality-compares-variant-and-payload
  (let [ok1 (: (Ok 1) (Result i64 (slice u8)))
        err-a (: (Err "a") (Result i64 (slice u8)))]
    (assert-eq ok1 (: (Ok 1) (Result i64 (slice u8))))
    (assert-ne ok1 (: (Ok 2) (Result i64 (slice u8))))
    (assert-ne ok1 err-a)
    (assert-eq err-a (: (Err "a") (Result i64 (slice u8))))
    (assert-ne err-a (: (Err "b") (Result i64 (slice u8))))))

(deftest a-popped-element-compares-with-some
  (let [(mut xs) (al-new [i64] (malloc-allocator))]
    (push! (mut xs) 1)
    (assert-eq (pop! (mut xs)) (Some 1))
    (assert-eq (pop! (mut xs)) (: (None) (Option i64)))
    (al-free! (mut xs))))

(deftest derived-eq-sees-option-fields
  (assert-eq (Number (Some 3)) (Number (Some 3)))
  (assert-ne (Number (Some 3)) (Number (None)))
  (assert-ne (Number (Some 3)) (End)))

(deftest slices-compare-elementwise
  (let [a (: [1 2 3] (slice i64))
        b (: [1 2 3] (slice i64))
        shorter (: [1 2] (slice i64))
        other (: [1 2 4] (slice i64))]
    (assert-eq a b)
    (assert-ne a shorter)
    (assert-ne a other)
    (assert-eq (: [(Point :x 1 :y 2)] (slice Point)) (: [(Point :x 1 :y 2)] (slice Point)))
    (assert-eq (: ["a" "b"] (slice (slice u8))) (: ["a" "b"] (slice (slice u8))))
    (assert-eq [1 2] [1 2])))

(deftest min-and-max-cover-integers-and-floats
  (assert-eq (math/min 3 7) 3)
  (assert-eq (math/max 3 7) 7)
  (assert-eq (math/min (: -5 i32) (: 2 i32)) (: -5 i32))
  ; unsigned compares unsigned
  (assert-eq (math/max (: 0xFFFFFFFFFFFFFFFF u64) (: 1 u64)) (: 0xFFFFFFFFFFFFFFFF u64))
  (assert-eq (math/max (: 200 u8) (: 3 u8)) (: 200 u8))
  (assert-eq (math/min 1.5 -2.0) -2.0)
  (assert-eq (math/max (: 1.5 f32) (: 2.5 f32)) (: 2.5 f32)))

(deftest i128-and-u128-have-arithmetic-comparison-and-display
  (let [a (: 5000000000 i128)
        big (* a a)
        (mut sb) (sb-new (malloc-allocator))]
    (assert (< a big))
    (assert-eq (/ big a) a)
    (assert-eq (- (+ a (: 7 i128)) (: 7 i128)) a)
    (assert-eq (% big (: 7 i128)) (: 4 i128))
    (assert-eq (- a) (- (: 0 i128) a))
    (assert-eq (>> (<< (: 1 i128) (: 100 i128)) (: 100 i128)) (: 1 i128))
    (assert-eq (math/max a big) big)
    (sb-format! (mut sb) "{} {} [{:>6}] {}" big (- big) (: 42 i128) (- (: 0 u128) (: 1 u128)))
    (assert-eq (sb-str sb)
               "25000000000000000000 -25000000000000000000 [    42] 340282366920938463463374607431768211455")
    (sb-free! (mut sb))))
