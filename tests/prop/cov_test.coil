(module cov_test)
(import "coil.prop.cov" :use *)
(import "coil.assert" :use *)
(import "coil.primitive" :as primitive)
; What `coil.prop.cov` must be true of in an ORDINARY (uninstrumented) build.
;
; The interesting behaviour needs instrumentation, which needs a different build
; — `scripts/tests/prop-fuzz.sh` builds it and `tests/prop/demos/fuzz_demo.coil`
; exercises it. What this file pins down is the half that has to hold everywhere:
; the callbacks are linkable, they are safe to call, and with no instrumentation
; every query answers "nothing", because the fuzz loop branches on exactly that
; and must not mistake an uninstrumented build for a fully-covered one.

(deftest uninstrumented-build-reports-no-coverage
         (assert (not (cov-instrumented?)))
         (assert-eq (cov-guards) 0)
         (assert-eq (cov-total) 0)
         (assert-eq (cov-take-fresh) 0))

;; Called by hand, the callbacks behave exactly as they would under
;; instrumentation. This is the closest an ordinary build can get to testing the
;; hot path, and it is worth having: a mistake in the id arithmetic would
;; otherwise only show up in a build that CI does not run.
(deftest guards-are-numbered-and-counted
         (let [guards (primitive/alloc-stack (array u32 4))
               start (primitive/cast (ptr u32) guards)
               stop (primitive/index start 4)
               (mut i) 0]
           (loop (if (>= (load i) 4)
                     (break)
                     (do
                       (primitive/store! (primitive/index start (load i)) (primitive/cast u32 0))
                       (store! i (primitive/iadd (load i) 1)))))
           (cov-init start stop)
           (assert-eq (cov-guards) 4)
           ; dense, from 1 — zero is reserved for "not a guard"
           (assert-eq (primitive/cast i64 (primitive/load start)) 1)
           (assert-eq (primitive/cast i64 (primitive/load (primitive/index start 3))) 4)
           (assert (cov-instrumented?))
           ; a second init over the SAME range must not renumber: clang emits one
           ; init per module and the runtime has to be idempotent.
           (cov-init start stop)
           (assert-eq (cov-guards) 4)))

(deftest hitting-a-guard-is-new-exactly-once
         (let [guards (primitive/alloc-stack (array u32 2))
               start (primitive/cast (ptr u32) guards)
               stop (primitive/index start 2)]
           (primitive/store! start (primitive/cast u32 0))
           (primitive/store! (primitive/index start 1) (primitive/cast u32 0))
           (cov-init start stop)
           (cov-take-fresh)
           (let [before (cov-total)]
             (cov-guard start)
             (assert-eq (cov-take-fresh) 1)
             ; the same edge again is not news
             (cov-guard start)
             (assert-eq (cov-take-fresh) 0)
             ; a different edge is
             (cov-guard (primitive/index start 1))
             (assert-eq (cov-take-fresh) 1)
             (assert-eq (cov-total) (primitive/iadd before 2)))))

;; A guard still holding zero is not a guard. Instrumented modules whose init has
;; not run yet would otherwise all collide on slot 0 and report one enormous edge.
(deftest an-unnumbered-guard-is-ignored
         (let [g (primitive/alloc-stack u32)]
           (primitive/store! g (primitive/cast u32 0))
           (cov-take-fresh)
           (cov-guard g)
           (assert-eq (cov-take-fresh) 0)))
