(module cov_test)
(import "coil.prop.cov" :use *)
(import "coil.assert" :use *)
(import "coil.primitive" :as primitive)

; What `coil.prop.cov` must be true of in an ORDINARY (uninstrumented) build.
;
; The interesting behaviour needs instrumentation, which needs a different build
; — `coil fuzz` builds it and `tests/prop/demos/fuzz_demo.coil`
; exercises it. What this file pins down is the half that has to hold everywhere:
; the callbacks are linkable, they are safe to call, and with no instrumentation
; every query answers "nothing", because the fuzz loop branches on exactly that
; and must not mistake an uninstrumented build for a fully-covered one.
(deftest uninstrumented-build-reports-no-coverage
         (assert (not (cov-instrumented?)))
         (assert-eq (cov-guards) 0)
         (assert-eq (cov-total) 0)
         (assert-eq (cov-take-fresh) 0))

;; Called by hand, the callbacks behave exactly as they would under
;; instrumentation. This is the closest an ordinary build can get to testing the
;; hot path, and it is worth having: a mistake in the id arithmetic would
;; otherwise only show up in a build that CI does not run.
(deftest guards-are-numbered-and-counted
         (let [guards (primitive/alloc-stack (array u32 4))
               start (primitive/cast (ptr u32) guards)
               stop (primitive/index start 4)
               (mut i) 0]
           (loop (if (>= (load i) 4)
                     (break)
                     (do
                       (store! (primitive/index start (load i)) (primitive/cast u32 0))
                       (store! i (primitive/iadd (load i) 1)))))
           (cov-init start stop)
           (assert-eq (cov-guards) 4)
           ; dense, from 1 — zero is reserved for "not a guard"
           (assert-eq (primitive/cast i64 (load start)) 1)
           (assert-eq (primitive/cast i64 (load (primitive/index start 3))) 4)
           (assert (cov-instrumented?))
           ; a second init over the SAME range must not renumber: clang emits one
           ; init per module and the runtime has to be idempotent.
           (cov-init start stop)
           (assert-eq (cov-guards) 4)))

(deftest hitting-a-guard-is-new-exactly-once
         (let [guards (primitive/alloc-stack (array u32 2))
               start (primitive/cast (ptr u32) guards)
               stop (primitive/index start 2)]
           (store! start (primitive/cast u32 0))
           (store! (primitive/index start 1) (primitive/cast u32 0))
           (cov-init start stop)
           (cov-take-fresh)
           (let [before (cov-total)]
             (cov-guard start)
             (assert-eq (cov-take-fresh) 1)
             ; the same edge again is not news
             (cov-guard start)
             (assert-eq (cov-take-fresh) 0)
             ; a different edge is
             (cov-guard (primitive/index start 1))
             (assert-eq (cov-take-fresh) 1)
             (assert-eq (cov-total) (primitive/iadd before 2)))))

;; A guard still holding zero is not a guard. Instrumented modules whose init has
;; not run yet would otherwise all collide on slot 0 and report one enormous edge.
(deftest an-unnumbered-guard-is-ignored
         (let [g (primitive/alloc-stack u32)]
           (store! g (primitive/cast u32 0))
           (cov-take-fresh)
           (cov-guard g)
           (assert-eq (cov-take-fresh) 0)))

; ─────────────────────────────────────────────── comparison feedback (trace-cmp)

;; The callbacks record a failed comparison as a PAIR, and the mutator asks for
;; "what did the program want where this value was" — so the substitution is
;; directed by what the input already holds rather than guessed.
(deftest a-failed-comparison-becomes-a-substitution
         (cov-cmp-record! true)
         ; the program compared a byte 97 against the constant 70 and did not match
         (cov-const-cmp8 (primitive/cast u64 70) (primitive/cast u64 97))
         (cov-cmp-record! false)
         (assert (> (cov-dict-count) 0))
         ; wherever 97 appears, 70 is what was wanted — and symmetrically
         (assert-eq (cov-dict-counterpart 97) 70)
         (assert-eq (cov-dict-counterpart 70) 97)
         ; a value nothing was compared against is returned unchanged, which is how
         ; the mutator knows to fall back to a random step
         (assert-eq (cov-dict-counterpart 12345) 12345))

;; A comparison that HELD is not recorded. The dictionary exists to say what the
;; search still has to reach; an equality already satisfied is not that, and
;; recording it would evict entries that are.
(deftest a-successful-comparison-is-not-recorded
         (cov-cmp-record! true)
         (cov-const-cmp8 (primitive/cast u64 4242) (primitive/cast u64 4242))
         (cov-cmp-record! false)
         (assert-eq (cov-dict-counterpart 4242) 4242))

;; Recording is gated. Every integer comparison in the process calls in here,
;; and only the ones made by the code under test are worth keeping — so a
;; comparison outside the property's own execution must leave no trace.
(deftest comparisons-outside-the-property-are-ignored
         (cov-cmp-record! false)
         (cov-cmp1 (primitive/cast u8 200) (primitive/cast u8 201))
         (assert-eq (cov-dict-counterpart 200) 200)
         (assert-eq (cov-dict-counterpart 201) 201))
