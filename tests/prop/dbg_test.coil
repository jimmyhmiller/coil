(module coil.tests.prop.dbg)
(import "coil.primitive" :as primitive)
(import "coil.assert" :use *)
(import "coil.alloc" :use *)
(import "coil.arraylist" :use *)
(import "coil.slice" :use *)
(import "coil.io" :as io)
(import "coil.fmt" :use *)
(import "coil.prop" :use *)
(import "coil.prop.derive" :use *)

(defsum Tree (Leaf [(v i64)]) (Node [(l (ptr Tree)) (r (ptr Tree))]))

(impl Arbitrary Tree
  (arbitrary [(out (mut Tree)) (s (ptr Source))] (-> i64)
    (let [sp (span-open! s "Tree" SPAN-NODE)
          tag (if (> (src-fuel s) 0) (draw-tag! s 2) (do (draw-tag! s 1) 0))]
      (if (= tag 0)
          (let [(mut v) (zeroed i64)]
            (arbitrary (mut v) s)
            (store! out (Leaf (load v)))
            0)
          (do (src-spend-fuel! s 1)
              (let [l (prop-child [Tree] s)
                    r (prop-child [Tree] s)
                    _z (if (or (= (primitive/cast i64 l) 0) (= (primitive/cast i64 r) 0))
                           (do (io/print-str (io/stdout) "NULL CHILD\n") 1) 0)]
                (arbitrary l s)
                (arbitrary r s)
                (store! out (Node l r))
                0)))
      (span-close! s sp)
      0)))

(defn tree-size [(t Tree)] (-> i64)
  (match t
    (Leaf [v] 1)
    (Node [l r] (primitive/iadd 1 (primitive/iadd (tree-size (load l)) (tree-size (load r)))))))

(deftest dbg
  (let [s (source-new (malloc-allocator) 8388608 12345)
        (mut t) (zeroed Tree)
        (mut i) 0
        w (io/stdout)]
    (loop (if (>= (load i) 60)
              (break)
              (do (source-begin-generate! s 60)
                  (fmt w "case {d} start\n" (load i))
                  (arbitrary (mut t) s)
                  (fmt w "case {d} drawn choices {d} arena-off {d}\n" (load i) (al-len [Choice] (load (src-tape s))) 0)
                  (fmt w "case {d} size {d}\n" (load i) (tree-size (load t)))
                  (store! i (primitive/iadd (load i) 1))
                  0)))
    (assert true)))
