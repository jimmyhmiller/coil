(module json_fuzz_demo)
(import "coil.prop" :use *)
(import "coil.json" :as json)
(import "coil.alloc" :as alloc :use *)
(import "coil.slice" :use *)
(import "coil.primitive" :as primitive)

; FUZZING A REAL PARSER — `coil.json`, the bundled JSON reader.
;
;   coil test tests/prop/demos/json_fuzz_demo.coil            ; blind
;   coil fuzz tests/prop/demos/json_fuzz_demo.coil
;
; A parser is the shape coverage guidance is best at, for a reason worth stating:
; almost every input is rejected immediately, so a blind search spends its whole
; budget on the first branch. `{` is 1 byte in 95; `{"a":1}` is 95^7. Feedback
; changes what the search is doing — an input that got one token further is KEPT,
; and the next mutation starts from there, so depth is reached by accumulation
; instead of by coincidence.
;
; The two properties below are the two things worth asserting about any parser,
; and neither one needs a single expected output written by hand.

;; 1. IT DOES NOT CRASH. The weakest possible claim, and the one that finds memory
;; bugs: whatever bytes arrive, `parse` returns Ok or Err rather than reading off
;; the end of the buffer. Pair with `coil test --sanitize=address --alloc-tracked`
;; and this becomes a real memory-safety check over arbitrary input.
(defprop parse-never-crashes
         [(s (slice u8))]
         (let [a (src-alloc (prop-src))]
           (match (json/parse a s)
             (Err [e] true)
             (Ok [d] (>= (json/token-count d) 0)))))

;; 2. A SUCCESSFUL PARSE IS SELF-CONSISTENT. Accepting the input is a claim, and
;; the claim has to hold together: the root token must exist, be one of the six
;; kinds (0..5, null through object), and report a span inside its own input. A parser that
;; accepts garbage usually fails this before it fails anything else.
(defprop accepted-input-has-a-coherent-root
         [(s (slice u8))]
         (let [a (src-alloc (prop-src))]
           (match (json/parse a s)
             (Err [e] true)
             (Ok [d]
                 (if (= (json/token-count d) 0)
                     false
                     (let [r (json/root d)
                           k (json/kind r)]
                       (and (>= k 0) (<= k 5))))))))

;;; 3. FRAGMENTS OF VALID JSON. Random printable bytes essentially never reach the
;;; parser's interesting states, so this one BUILDS its input out of JSON's own
;;; alphabet — the structural characters, the digits, the keyword letters. It is the
;;; same law as above; only the distribution differs, and the distribution is what
;;; decides whether the law is ever tested. (Under fuzzing this matters less, since
;;; the corpus discovers the alphabet on its own — but a blind `coil test` run has
;;; only the generator to go on.)
(defn json-alphabet [] (-> (slice u8))
  "{}[]\",:0123456789.-+eE truefalsn\\/ux")

(defn draw-jsonish [(s (ptr Source)) (n i64)] (-> (slice u8))
  (let [alpha (json-alphabet)
        buf (prop-alloc s (if (> n 0) n 1) 1)
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (let [sp (span-open! s "ch" SPAN-ELEM)]
                (store! (primitive/index buf (load i))
                        (slice-get [u8] alpha (draw-int! s 0 (primitive/isub (slice-len [u8] alpha) 1))))
                (span-close! s sp)
                (store! i (primitive/iadd (load i) 1))
                0)))
    (slice-new [u8] buf n)))

(defprop jsonish-input-parses-or-errors
         [(seed i64)]
         (let [src (prop-src)
               n (draw-len! src 0 40)
               text (draw-jsonish src n)
               a (src-alloc src)]
           (match (json/parse a text)
             (Err [e] true)
             (Ok [d] (>= (json/token-count d) 0)))))
