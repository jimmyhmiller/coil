(module memory_bug_demo)
(import "coil.prop" :use *)
(import "coil.slice" :use *)
(import "coil.primitive" :as primitive)
; A REAL memory bug — an off-by-one loop bound — found and minimized.
;
;   coil test --sanitize=address --alloc-tracked tests/prop/demos/memory_bug_demo.coil
;
;   ==NNNNN==ERROR: AddressSanitizer: heap-buffer-overflow
;   0 bytes after 1-byte region [0x602000000450,0x602000000451)
;
;     counterexample:
;       s = "a"
;
; The property says nothing about memory. It says the byte sum of a string is
; non-negative, which is true of every correct implementation. The sanitizer
; turns the out-of-bounds read into a signal, the runner's crash path turns the
; signal into a counterexample, and shrinking turns the counterexample into the
; shortest input that reaches the bug: a one-byte string.
;
; ⚠ BOTH FLAGS ARE REQUIRED. Without `--sanitize=address` the read lands on a
; harmless neighbouring byte and the property passes. Without `--alloc-tracked=1`
; the sanitizer sees nothing either: generated values come from the per-case
; ARENA, one big allocation, so reading past a generated string is still inside
; it. `--alloc-tracked=1` gives each value its own allocation with its own redzone.
; That is the whole reason the mode exists, and it is why "the property passed"
; is not evidence about memory unless you asked for it to be.

;; ⚠ `(> i n)` should be `(>= i n)`: the loop runs one iteration too many and
;; reads `s[n]`, one byte past the end of the slice.
(defn byte-sum [(s (slice u8))] (-> i64)
  (let [(mut total) 0
        (mut i) 0
        n (slice-len [u8] s)]
    (loop (if (> (load i) n)
              (break)
              (do
                (store! total (primitive/iadd (load total) (primitive/cast i64 (slice-get [u8] s (load i)))))
                (store! i (primitive/iadd (load i) 1)))))
    (load total)))

(defprop byte-sum-is-never-negative [(s (slice u8))]
  (>= (byte-sum s) 0))
