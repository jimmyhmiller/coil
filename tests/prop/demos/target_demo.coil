(module prop_target)
(import "coil.prop" :use *)
(import "coil.arraylist" :use *)
(import "coil.primitive" :as primitive)

; The sum of up to 60 bytes never exceeds 12000. It CAN (60*255 = 15300), but
; uniform sampling essentially never gets there: it needs a mean element of 200+
; across a full-length list. Reporting the sum as the target turns the search
; from sampling into hill climbing, which walks straight up to it.
(defprop sum-stays-below-12000 [(xs (ArrayList u8))]
  (let [(mut total) 0
        (mut i) 0]
    (loop (if (>= (load i) (al-len [u8] xs))
              (break)
              (do (store! total (primitive/iadd (load total) (primitive/cast i64 (al-get [u8] xs (load i)))))
                  (store! i (primitive/iadd (load i) 1)))))
    (prop-target! (primitive/cast f64 (load total)))
    (< (load total) 12000)))
