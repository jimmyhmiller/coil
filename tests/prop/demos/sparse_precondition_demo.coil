(module prop_reject)
(import "coil.prop" :use *)
(import "coil.primitive" :as primitive)

; A precondition almost nothing satisfies. The property is true, so the run is
; green — but it examined a handful of inputs, and the runner must say so.
(defprop needle-in-a-haystack [(a i64)]
  (assume (= (primitive/iand a 4095) 0))
  (= (primitive/iand a 4095) 0))
