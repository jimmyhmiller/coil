(module prop_fail)
(import "coil.prop" :use *)
(import "coil.arraylist" :use *)
(import "coil.primitive" :as primitive)

; Deliberately false: every integer is less than 100. Minimal counterexample: 100.
(defprop all-ints-small [(a i64)]
  (< a 100))

; Deliberately false: no list has 3 or more elements. Minimal counterexample: (0 0 0).
(defprop lists-are-short [(xs (ArrayList i64))]
  (< (al-len [i64] xs) 3))

; Deliberately false: the sum of a list never reaches 5.
(defprop sums-never-five [(xs (ArrayList u8))]
  (let [(mut total) 0
        (mut i) 0]
    (loop (if (>= (load i) (al-len [u8] xs))
              (break)
              (do (store! total (primitive/iadd (load total) (primitive/cast i64 (al-get [u8] xs (load i)))))
                  (store! i (primitive/iadd (load i) 1)))))
    (< (load total) 5)))
