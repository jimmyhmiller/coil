(module fuzz_demo)
(import "coil.prop" :use *)
(import "coil.slice" :use *)
(import "coil.primitive" :as primitive)
; COVERAGE-GUIDED FUZZING — a bug that random generation cannot reach.
;
;   coil test tests/prop/demos/fuzz_demo.coil          ; passes: never finds it
;   coil fuzz tests/prop/demos/fuzz_demo.coil
;
; `handle` rejects everything except a string beginning "FUZZ", and mishandles
; that one. Finding it by sampling means drawing four specific printable bytes in
; order: about 95^4 ≈ 81 million strings, so a 200-case run — or a 20,000-case run
; — will never see it. The property below is true of every input a blind search
; will ever generate.
;
; Coverage guidance turns that product into a sum. Each correct byte opens a
; branch nothing has taken before, so the input that got one byte right is KEPT,
; and the next mutation starts from it. Four independent 1-in-95 guesses instead
; of one 1-in-81-million guess. This is the classic demonstration of why coverage
; feedback matters, and it is the reason FuzzChick found in seconds what QuickChick
; could not find in an hour (Lampropoulos et al., OOPSLA 2019).
;
; The bytes are compared one at a time, through nested branches, on purpose: a
; single 4-byte comparison would be ONE edge and there would be no ladder to
; climb. Real parsers are written this way; a fuzzer's leverage on them comes from
; exactly that shape.

(defn at [(s (slice u8)) (i i64)] (-> i64)
  (primitive/cast i64 (slice-get [u8] s i)))

;;; How far the parser got. A real parser accumulates state as it consumes; this
;;; one only records its progress, which is enough.
;;;
;;; ⚠ WITHOUT THIS THE DEMO DOES NOT WORK, and the reason is worth knowing. A
;;; chain of `if` that only ever yields `true` or `false` is a pure boolean
;;; expression, and LLVM compiles it to `and`/`select` with NO BRANCHES. Branchless
;;; code has no basic blocks to distinguish, so it has no edges, so coverage
;;; guidance has nothing to guide with — the first version of this file was written
;;; that way and the fuzzer wandered for 300 000 iterations. Doing something
;;; observable on the taken path is what makes each rung a block of its own.
(defn progress [] (-> (ptr i64))
  (primitive/alloc-static i64))

(defn reached [(n i64)] (-> i64)
  (store! (progress) n)
  n)

;;; Returns false only for the one input it mishandles.
(defn handle [(s (slice u8))] (-> bool)
  (if (< (slice-len [u8] s) 4)
      true
      (if (!= (at s 0) \F)
          true
          (do
            (reached 1)
            (if (!= (at s 1) \U)
                true
                (do
                  (reached 2)
                  (if (!= (at s 2) \Z)
                      true
                      (do
                        (reached 3)
                        (if (!= (at s 3) \Z)
                            true
                            ; the bug
                            (do (reached 4) false))))))))))

(defprop handles-every-input
         [(s (slice u8))]
         (handle s))
