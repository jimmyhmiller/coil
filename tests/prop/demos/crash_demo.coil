(module prop_crash)
(import "coil.prop" :use *)
(import "coil.os" :as os)
(import "coil.primitive" :as primitive)

; Dies by SIGSEGV when a >= 10. The minimal crashing input is exactly 10, and
; getting that report at all requires surviving the child's death.
(defprop no-crash-on-big-ints [(a i64)]
  (if (>= a 10)
      (do (os/kill (os/getpid) 11) true)
      true))
