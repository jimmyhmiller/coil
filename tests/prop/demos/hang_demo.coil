(module prop_hang)
(import "coil.prop" :use *)
(import "coil.os" :as os)
(import "coil.primitive" :as primitive)

(defn spin-cell [] (-> (ptr i64)) (primitive/alloc-static i64))

; Loops forever when a >= 10. With the watchdog, that is a reportable failure
; rather than a test run that never returns. The loop writes to a global so the
; optimizer cannot delete it — an infinite loop with no observable effect is
; genuinely removable at -O3, and a "hang test" that gets optimized away tests
; nothing.
(defprop no-hang-on-big-ints [(a i64)]
  (if (>= a 10)
      (let [c (spin-cell)]
        (loop (if (< (load c) 0) (break) (store! c (primitive/iadd (load c) 1))))
        true)
      true))
