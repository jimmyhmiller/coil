(module tests.prop.db-test)
(import "coil.primitive" :as primitive)
(import "coil.alloc" :as alloc :use *)
(import "coil.arraylist" :use *)
(import "coil.slice" :use *)
(import "coil.str" :as str)
(import "coil.os" :as os)
(import "coil.fs" :as fs)
(import "coil.io" :use *)
(import "coil.assert" :use *)
(import "coil.prop.source" :use *)
(import "coil.prop.db" :use *)

; ---------------------------------------------------------------- test helpers

(defn mkc [(kind i64) (flags i64) (span i64) (lo i64) (hi i64) (origin i64) (value i64)] (-> Choice)
  (let [c (primitive/alloc-stack Choice)]
    (store! (field c kind) kind)
    (store! (field c flags) flags)
    (store! (field c span) span)
    (store! (field c lo) lo)
    (store! (field c hi) hi)
    (store! (field c origin) origin)
    (store! (field c value) value)
    (load c)))

(defn choice-eq? [(x Choice) (y Choice)] (-> bool)
  (and (and (= (load (field x kind)) (load (field y kind)))
            (and (= (load (field x flags)) (load (field y flags)))
                 (= (load (field x span)) (load (field y span)))))
       (and (and (= (load (field x lo)) (load (field y lo)))
                 (= (load (field x hi)) (load (field y hi))))
            (and (= (load (field x origin)) (load (field y origin)))
                 (= (load (field x value)) (load (field y value)))))))

(defn tapes-eq? [(a (ptr (ArrayList Choice))) (b (ptr (ArrayList Choice)))] (-> bool)
  (if (!= (al-len [Choice] (load a)) (al-len [Choice] (load b)))
      false
      (let [n (al-len [Choice] (load a))
            (mut ok) true
            (mut i) 0]
        (loop (if (>= (load i) n)
                  (break)
                  (do
                    (if (choice-eq? (al-get [Choice] (load a) (load i))
                                    (al-get [Choice] (load b) (load i)))
                        0
                        (store! ok false))
                    (store! i (primitive/iadd (load i) 1)))))
        (load ok))))

(defn bytes-eq? [(x (slice u8)) (y (slice u8))] (-> bool)
  (if (!= (slice-len x) (slice-len y))
      false
      (let [n (slice-len x)
            (mut ok) true
            (mut i) 0]
        (loop (if (>= (load i) n)
                  (break)
                  (do
                    (if (= (primitive/cast i64 (slice-get x (load i)))
                           (primitive/cast i64 (slice-get y (load i))))
                        0
                        (store! ok false))
                    (store! i (primitive/iadd (load i) 1)))))
        (load ok))))

;; Little-endian i64 store, so a test can corrupt a field and then re-seal the
;; checksum — otherwise every corruption test would only ever reach the checksum
;; check and the structural validation would go untested.
(defn put-le! [(b (slice u8)) (off i64) (v i64)] (-> i64)
  (let [(mut k) 0]
    (loop (if (>= (load k) 8)
              (break)
              (do
                (slice-set! b
                            (primitive/iadd off (load k))
                            (primitive/cast u8
                                            (primitive/iand (primitive/cast i64
                                                                            (primitive/ishr (primitive/cast u64 v)
                                                                                            (primitive/cast u64
                                                                                                            (primitive/imul (load k)
                                                                                                                            8))))
                                                            255)))
                (store! k (primitive/iadd (load k) 1)))))
    0))

(defn has-text? [(hay (slice u8)) (needle (slice u8))] (-> bool)
  (match (str/str-find hay needle) (Some [i] true) (None [] false)))

(defn reseal! [(b (slice u8))] (-> i64)
  (let [end (primitive/isub (slice-len b) 8)]
    (put-le! b end (tape-checksum b 0 end))))

;; A small integer per rejection reason, so an assertion can name the exact
;; reason rather than settling for "some error happened".
(const E-OK -1)
(const E-TRUNCATED 1)
(const E-MAGIC 2)
(const E-VERSION 3)
(const E-RESERVED 4)
(const E-COUNT 5)
(const E-LENGTH 6)
(const E-CHECKSUM 7)
(const E-CHOICE 8)
(const E-IO 9)

(defn decode-code [(a (ptr Allocator)) (b (slice u8))] (-> i64)
  (match (tape-decode a b)
    (Ok [t] E-OK)
    (Err [e]
         (match e
           (TapeTruncated [need got] E-TRUNCATED)
           (TapeBadMagic [] E-MAGIC)
           (TapeBadVersion [found] E-VERSION)
           (TapeBadReserved [] E-RESERVED)
           (TapeBadCount [count] E-COUNT)
           (TapeBadLength [want got] E-LENGTH)
           (TapeBadChecksum [want got] E-CHECKSUM)
           (TapeBadChoice [index] E-CHOICE)
           (TapeIo [errno] E-IO)))))

(defn load-code [(r (Result (Option (ArrayList Choice)) TapeError))] (-> i64)
  (match r
    (Ok [o] (match o (None [] 0) (Some [t] 1)))
    (Err [e]
         (match e
           (TapeTruncated [need got] E-TRUNCATED)
           (TapeBadMagic [] E-MAGIC)
           (TapeBadVersion [found] E-VERSION)
           (TapeBadReserved [] E-RESERVED)
           (TapeBadCount [count] E-COUNT)
           (TapeBadLength [want got] E-LENGTH)
           (TapeBadChecksum [want got] E-CHECKSUM)
           (TapeBadChoice [index] E-CHOICE)
           (TapeIo [errno] E-IO)))))

;; A tape that hits every choice kind at the values that break naive codecs: both
;; i64 extremes, and the float bit patterns whose `f64` equality is a lie (NaN,
;; -0.0). Note that i64 MIN does NOT distinguish an arithmetic from a logical
;; shift in `tape--push-i64!` — the byte mask hides the difference — so this
;; catches a sign bug only once someone widens the chunk size. See the comment on
;; that function.
(defn extreme-tape [(a (ptr Allocator))] (-> (ArrayList Choice))
  (let [(mut t) (al-new [Choice] a)]
    (al-push! [Choice] (mut t) (mkc CK-INT 0 -1 -9223372036854775808 9223372036854775807 0 -9223372036854775808))
    (al-push! [Choice] (mut t) (mkc CK-INT 0 0 -9223372036854775808 9223372036854775807 0 9223372036854775807))
    (al-push! [Choice] (mut t) (mkc CK-INT 3 1 -9223372036854775808 9223372036854775807 -9223372036854775808 -1))
    (al-push! [Choice] (mut t) (mkc CK-INT 0 2 -128 127 0 -128))
    (al-push! [Choice] (mut t) (mkc CK-BOOL 0 2 0 1 0 0))
    (al-push! [Choice] (mut t) (mkc CK-BOOL 0 2 0 1 0 1))
    (al-push! [Choice] (mut t) (mkc CK-TAG 0 3 0 7 0 7))
    (al-push! [Choice] (mut t) (mkc CK-LEN 0 3 0 1000000 0 999999))
    ; every special float, by bit pattern: +0.0, -0.0, +inf, -inf, NaN, 1.0
    (let [(mut k) 0]
      (loop (if (>= (load k) 6)
                (break)
                (do
                  (al-push! [Choice]
                            (mut t)
                            (mkc CK-FLOAT
                                 0
                                 4
                                 -9223372036854775808
                                 9223372036854775807
                                 0
                                 (float-special-bits (load k))))
                  (store! k (primitive/iadd (load k) 1))))))
    ; pi, and the smallest positive subnormal — written as bit patterns so the
    ; test depends on the CODEC, not on how the reader rounds a decimal literal
    (al-push! [Choice] (mut t) (mkc CK-FLOAT 0 4 -9223372036854775808 9223372036854775807 0 4614256656552045848))
    (al-push! [Choice] (mut t) (mkc CK-FLOAT 0 4 -9223372036854775808 9223372036854775807 0 1))
    (load t)))

;; The draws whose values a replayed tape must reproduce exactly. One function so
;; the generate pass and the replay pass are provably the same sequence.
(defn draw-sequence [(s (ptr Source)) (out (ptr (ArrayList i64)))] (-> i64)
  (let [sp (span-open! s "seq" SPAN-PLAIN)]
    (al-push! [i64] out (draw-int! s 0 1000))
    (al-push! [i64] out (if (draw-bool! s) 1 0))
    (al-push! [i64] out (draw-tag! s 5))
    (al-push! [i64] out (draw-len! s 0 40))
    (al-push! [i64] out (draw-int-any! s))
    (al-push! [i64] out (f64->bits (draw-float! s)))
    (al-push! [i64] out (draw-int-origin! s -50 50 -50))
    (span-close! s sp)))

(defn i64s-eq? [(x (ptr (ArrayList i64))) (y (ptr (ArrayList i64)))] (-> bool)
  (if (!= (al-len [i64] (load x)) (al-len [i64] (load y)))
      false
      (let [n (al-len [i64] (load x))
            (mut ok) true
            (mut i) 0]
        (loop (if (>= (load i) n)
                  (break)
                  (do
                    (if (= (al-get [i64] (load x) (load i)) (al-get [i64] (load y) (load i)))
                        0
                        (store! ok false))
                    (store! i (primitive/iadd (load i) 1)))))
        (load ok))))

; ------------------------------------------------------------------ encoding

(deftest tape-roundtrip-extremes
         (let [a (malloc-allocator)
               (mut t) (extreme-tape a)
               n (al-len [Choice] (load t))
               bytes (tape-encode a (mut t))]
           ; the format is fixed-width, so its size is a closed form and any drift in
           ; the encoder shows up here rather than as a mysterious decode failure.
           (assert-eq (slice-len bytes) (primitive/iadd 24 (primitive/imul 56 n)))
           (assert-eq (decode-code a bytes) E-OK)
           (match (tape-decode a bytes)
             (Err [e] (assert false))
             (Ok [d]
                 (let [(mut d2) d]
                   (assert-eq (al-len [Choice] (load (mut d2))) n)
                   (assert (tapes-eq? (mut t) (mut d2)))
                   ; re-encoding a decoded tape must reproduce the same bytes:
                   ; the encoding is canonical, so a tape has ONE file.
                   (assert (bytes-eq? bytes (tape-encode a (mut d2))))
                   0)))
           0))

(deftest tape-roundtrip-empty
         (let [a (malloc-allocator)
               (mut t) (al-new [Choice] a)
               bytes (tape-encode a (mut t))]
           (assert-eq (slice-len bytes) 24)
           (match (tape-decode a bytes)
             (Err [e] (assert false))
             (Ok [d] (let [(mut d2) d] (assert-eq (al-len [Choice] (load (mut d2))) 0) 0)))
           0))

(deftest tape-float-bits-survive
         ; NaN is not equal to itself and -0.0 compares equal to +0.0, so the only
         ; honest round-trip check for a float choice is on its BITS.
         (let [a (malloc-allocator)
               (mut t) (al-new [Choice] a)
               nan-bits (f64->bits (bits->f64 9221120237041090560))
               neg-zero (f64->bits (bits->f64 (float-special-bits 1)))]
           (al-push! [Choice] (mut t) (mkc CK-FLOAT 0 -1 -9223372036854775808 9223372036854775807 0 nan-bits))
           (al-push! [Choice] (mut t) (mkc CK-FLOAT 0 -1 -9223372036854775808 9223372036854775807 0 neg-zero))
           (match (tape-decode a (tape-encode a (mut t)))
             (Err [e] (assert false))
             (Ok [d]
                 (let [(mut d2) d]
                   (assert-eq (load (field (al-elem [Choice] (mut d2) 0) value)) nan-bits)
                   (assert-eq (load (field (al-elem [Choice] (mut d2) 1) value)) neg-zero)
                   ; -0.0 must not have decayed into +0.0 on the way through
                   (assert (!= neg-zero 0))
                   0)))
           0))

; --------------------------------------------------------------- rejections

(deftest tape-rejects-short-buffers
         (let [a (malloc-allocator)
               (mut t) (extreme-tape a)
               bytes (tape-encode a (mut t))
               n (slice-len bytes)]
           (assert-eq (decode-code a (subslice bytes 0 0)) E-TRUNCATED)
           (assert-eq (decode-code a (subslice bytes 0 23)) E-TRUNCATED)
           ; long enough to have a header, but not the length the header claims —
           ; the case a decoder without an exact-length rule would happily half-read
           (assert-eq (decode-code a (subslice bytes 0 24)) E-LENGTH)
           (assert-eq (decode-code a (subslice bytes 0 (primitive/isub n 1))) E-LENGTH)
           (assert-eq (decode-code a (subslice bytes 0 (primitive/isub n 56))) E-LENGTH)
           0))

(deftest tape-rejects-bad-header
         (let [a (malloc-allocator)
               (mut t) (extreme-tape a)]
           (let [b (tape-encode a (mut t))]
             (slice-set! b 0 (primitive/cast u8 88))
             (reseal! b)
             (assert-eq (decode-code a b) E-MAGIC))
           (let [b (tape-encode a (mut t))]
             (slice-set! b 3 (primitive/cast u8 0))
             (reseal! b)
             (assert-eq (decode-code a b) E-MAGIC))
           ; a v2 file read by a v1 build: refuse it, do not guess at the layout
           (let [b (tape-encode a (mut t))]
             (slice-set! b 4 (primitive/cast u8 2))
             (reseal! b)
             (assert-eq (decode-code a b) E-VERSION))
           (let [b (tape-encode a (mut t))]
             (slice-set! b 4 (primitive/cast u8 0))
             (reseal! b)
             (assert-eq (decode-code a b) E-VERSION))
           (let [b (tape-encode a (mut t))]
             (slice-set! b 6 (primitive/cast u8 1))
             (reseal! b)
             (assert-eq (decode-code a b) E-RESERVED))
           0))

(deftest tape-rejects-bad-count
         (let [a (malloc-allocator)
               (mut t) (extreme-tape a)]
           (let [b (tape-encode a (mut t))]
             (put-le! b 8 -1)
             (reseal! b)
             (assert-eq (decode-code a b) E-COUNT))
           ; a count large enough that `count * 56` overflows into a length that
           ; matches the file: rejected before the arithmetic, not after
           (let [b (tape-encode a (mut t))]
             (put-le! b 8 1317624576693539401)
             (reseal! b)
             (assert-eq (decode-code a b) E-COUNT))
           (let [b (tape-encode a (mut t))]
             (put-le! b 8 (primitive/isub (al-len [Choice] (load t)) 1))
             (reseal! b)
             (assert-eq (decode-code a b) E-LENGTH))
           0))

(deftest tape-rejects-corrupt-payload
         (let [a (malloc-allocator)
               (mut t) (extreme-tape a)]
           ; a single flipped bit anywhere in the payload, checksum left stale
           (let [b (tape-encode a (mut t))]
             (slice-set! b 40 (primitive/cast u8 (primitive/ixor (primitive/cast i64 (slice-get b 40)) 1)))
             (assert-eq (decode-code a b) E-CHECKSUM))
           ; a stale checksum with an otherwise perfect body
           (let [b (tape-encode a (mut t))]
             (put-le! b (primitive/isub (slice-len b) 8) 0)
             (assert-eq (decode-code a b) E-CHECKSUM))
           0))

(deftest tape-rejects-impossible-choice
         ; A checksum only proves the bytes are the ones that were written. These tapes
         ; are internally consistent and still cannot have come from `record!`, and the
         ; shrinker's passes assume they cannot exist.
         (let [a (malloc-allocator)
               (mut t) (al-new [Choice] a)]
           (al-push! [Choice] (mut t) (mkc CK-INT 0 -1 0 10 0 5))
           ; value outside [lo, hi]
           (let [b (tape-encode a (mut t))]
             (put-le! b (primitive/iadd 16 48) 99)
             (reseal! b)
             (assert-eq (decode-code a b) E-CHOICE))
           ; lo > hi
           (let [b (tape-encode a (mut t))]
             (put-le! b (primitive/iadd 16 24) 100)
             (reseal! b)
             (assert-eq (decode-code a b) E-CHOICE))
           ; a choice kind this build does not have
           (let [b (tape-encode a (mut t))]
             (put-le! b 16 42)
             (reseal! b)
             (assert-eq (decode-code a b) E-CHOICE))
           (let [b (tape-encode a (mut t))]
             (put-le! b 16 -1)
             (reseal! b)
             (assert-eq (decode-code a b) E-CHOICE))
           0))

; ------------------------------------------------------------- name mapping

(deftest db-name-sanitising
         (let [a (malloc-allocator)]
           (assert (str/str-eq (db-sanitize-name a "reverse-involutive") "reverse-involutive"))
           (assert (str/str-eq (db-sanitize-name a "Sorted_9") "Sorted_9"))
           ; the characters a Coil symbol may contain and a path may not
           (assert (str/str-eq (db-sanitize-name a "list/rev-rev?") "list%2Frev-rev%3F"))
           (assert (str/str-eq (db-sanitize-name a "a b") "a%20b"))
           (assert (str/str-eq (db-sanitize-name a "x<=y") "x%3C%3Dy"))
           ; the traversal cases: `.` is deliberately unsafe, so `..` cannot escape
           (assert (str/str-eq (db-sanitize-name a "..") "%2E%2E"))
           (assert (str/str-eq (db-sanitize-name a ".") "%2E"))
           ; injectivity: the escape character itself escapes, so a bare `%` can only
           ; be the empty name and no two names share a file
           (assert (str/str-eq (db-sanitize-name a "%") "%25"))
           (assert (str/str-eq (db-sanitize-name a "") "%"))
           (assert (str/str-eq (db-sanitize-name a "%2E%2E") "%252E%252E"))
           0))

(deftest db-path-layout
         (let [a (malloc-allocator)]
           (os/env-set a "COIL_PBT_DB" "/tmp/coil-pbt-db-test-path" true)
           (assert (str/str-eq (db-path a "list/rev-rev?")
                               "/tmp/coil-pbt-db-test-path/list%2Frev-rev%3F/failing"))
           (os/env-unset a "COIL_PBT_DB")
           (assert (str/str-eq (db-path a "p") ".coil/pbt/p/failing"))
           ; `env COIL_PBT_DB= coil test` means "unset", not "the filesystem root" —
           ; taken literally this would put the database at /p/failing
           (os/env-set a "COIL_PBT_DB" "" true)
           (assert (str/str-eq (db-path a "p") ".coil/pbt/p/failing"))
           (os/env-unset a "COIL_PBT_DB")
           0))

; ----------------------------------------------------------- the real store

(deftest db-save-load-replay
         (let [a (malloc-allocator)
               name "list/rev-rev?"]
           (os/env-set a "COIL_PBT_DB" "/tmp/coil-pbt-db-test-store" true)
           (db-clear a name)  ; a leftover from an earlier run is not this test's input
           ; nothing saved yet: a first run must be told "nothing", not "error"
           (assert-eq (load-code (db-load-failure a name)) 0)
           
           (let [s (source-new a 262144 987654321)
                 ; RE-ARM THE ALLOCATOR. `source-new` hands its `mem` argument straight
                 ; to `arena-over-buffer`, which overwrites that Allocator's vtable with
                 ; the per-case arena's — so after this call `a`, `s.mem` and `s.arena`
                 ; are one object, and `source-begin-*` rewinds the arena the tape
                 ; itself was allocated from. `malloc-allocator` rewrites its singleton
                 ; on every call, so calling it again puts the malloc vtable back.
                 ; Without this the replay tape and the span table overlap in memory and
                 ; the first draw replays as an overrun. See the report: the fix belongs
                 ; in prop_source.coil, which this agent does not own.
                 rearm (malloc-allocator)
                 (mut want) (al-new [i64] a)
                 (mut got) (al-new [i64] a)]
             (source-begin-generate! s 40)
             (draw-sequence s (mut want))
             (let [(mut saved) (tape-clone a (src-tape s))
                   saved-bytes (tape-encode a (mut saved))]
               (assert (> (al-len [Choice] (load saved)) 0))
               (assert (db-save-failure a name (mut saved)))
               
               (match (db-load-failure a name)
                 (Err [e] (assert false))
                 (Ok [o]
                     (match o
                       (None [] (assert false))
                       (Some [loaded]
                             (let [(mut l) loaded]
                               ; byte-identical, not merely equivalent
                               (assert (bytes-eq? saved-bytes (tape-encode a (mut l))))
                               (assert (tapes-eq? (mut saved) (mut l)))
                               ; and it must still MEAN the same thing: the same draws
                               ; over the loaded tape produce the same values, with no
                               ; overrun (an overrun would mean the tape was short and
                               ; the minima papered over it)
                               (source-begin-replay! s (mut l) 40)
                               (draw-sequence s (mut got))
                               (assert-eq (src-status s) ST-OK)
                               (assert (i64s-eq? (mut want) (mut got)))
                               0))))))
             0)
           
           ; a property that goes green must forget its counterexample, and saying so
           ; twice must not claim to have deleted anything twice
           (assert (db-clear a name))
           (assert-eq (load-code (db-load-failure a name)) 0)
           (assert (not (db-clear a name)))
           (os/env-unset a "COIL_PBT_DB")
           0))

(deftest db-reports-corrupt-file
         (let [a (malloc-allocator)
               name "corrupt-prop"]
           (os/env-set a "COIL_PBT_DB" "/tmp/coil-pbt-db-test-corrupt" true)
           (let [dir (db-dir a name)
                 path (db-path a name)]
             (db-mkdir-p a dir)
             (match (fs/write-file a path "this is not a tape, it is a note to self")
               (Err [e] (assert false))
               (Ok [k] 0))
             ; the file exists and is garbage: that is an ERROR, never a silent "no
             ; saved failure" — a dead reuse phase has to be visible
             (assert-eq (load-code (db-load-failure a name)) E-MAGIC)
             
             ; a tape truncated on disk (a half-written file) must not decode to a
             ; shorter tape, which would reproduce a DIFFERENT input under this name
             (let [s (source-new a 65536 4242)
                   rearm (malloc-allocator)  ; see db-save-load-replay
                   (mut sink) (al-new [i64] a)]
               (source-begin-generate! s 30)
               (draw-sequence s (mut sink))
               (let [(mut full) (tape-clone a (src-tape s))
                     bytes (tape-encode a (mut full))]
                 (match (fs/write-file a path (subslice bytes 0 (primitive/isub (slice-len bytes) 9)))
                   (Err [e] (assert false))
                   (Ok [k] 0))
                 (assert-eq (load-code (db-load-failure a name)) E-LENGTH)
                 ; and a whole one loads, proving the path itself was fine all along
                 (match (fs/write-file a path bytes)
                   (Err [e] (assert false))
                   (Ok [k] 0))
                 (assert-eq (load-code (db-load-failure a name)) 1)
                 0))
             (db-clear a name)
             (db-free-bytes a path)
             (db-free-bytes a dir))
           (os/env-unset a "COIL_PBT_DB")
           0))

;; `tape-error-print` is what a human actually SEES when the reuse phase dies —
;; the only part of this module the runner shows a user, and the only one no
;; other test here reaches. Rendering every variant into a buffer and reading the
;; bytes back catches the two ways a report goes wrong without failing anything:
;; an arm that renders nothing, and an arm that renders a number the reader will
;; mis-decode.
(deftest tape-error-print-renders-every-reason
         (let [buf (alloc/stack (array u8 4096))
               fb (alloc/stack FixBuf)
               w (alloc/stack Writer)]
           (store! (field fb data) (primitive/cast (ptr i8) (primitive/index buf 0)))
           (store! (field fb cap) 4096)
           (fixed-buffer-writer w fb)
           (tape-error-print w (TapeTruncated 24 7))
           (tape-error-print w (TapeBadMagic))
           (tape-error-print w (TapeBadVersion 2))
           (tape-error-print w (TapeBadReserved))
           (tape-error-print w (TapeBadCount -1))
           (tape-error-print w (TapeBadLength 136 80))
           (tape-error-print w (TapeBadChecksum 48879 3735928559))
           (tape-error-print w (TapeBadChoice 3))
           (tape-error-print w (TapeIo 13))
           ; errno 0 is `fs/read-file`'s "I never reached a syscall" — it must not
           ; render as an errno, because errno 0 means the call SUCCEEDED
           (tape-error-print w (TapeIo 0))
           (let [txt (slice-new (primitive/cast (ptr u8) (load (field fb data))) (load (field fb len)))
                 (mut lines) 0
                 (mut i) 0]
             ; ten reasons, ten lines — an arm that rendered nothing would slip past
             ; substring checks entirely
             (loop (if (>= (load i) (slice-len txt))
                       (break)
                       (do
                         (if (= (primitive/cast i64 (slice-get txt (load i))) 10)
                             (store! lines (primitive/iadd (load lines) 1))
                             0)
                         (store! i (primitive/iadd (load i) 1)))))
             (assert-eq (load lines) 10)
             ; the numbers a human needs to tell truncation from a version skew
             (assert (has-text? txt "need at least 24 bytes, got 7"))
             (assert (has-text? txt "unsupported tape version 2"))
             (assert (has-text? txt "impossible choice count -1"))
             (assert (has-text? txt "header describes 136 bytes, file is 80"))
             (assert (has-text? txt "choice 3 violates"))
             (assert (has-text? txt "errno 13"))
             (assert (not (has-text? txt "errno 0")))
             (assert (has-text? txt "out of memory"))
             0)))

(deftest db-save-never-fails-the-run
         ; A root that cannot be created (a path under a plain FILE) must make saving
         ; return false, not abort. A read-only checkout is not a test failure.
         (let [a (malloc-allocator)]
           (match (fs/write-file a "/tmp/coil-pbt-db-test-notadir" "x")
             (Err [e] (assert false))
             (Ok [k] 0))
           (os/env-set a "COIL_PBT_DB" "/tmp/coil-pbt-db-test-notadir/pbt" true)
           (let [(mut t) (al-new [Choice] a)]
             (al-push! [Choice] (mut t) (mkc CK-INT 0 -1 0 10 0 3))
             (assert (not (db-save-failure a "p" (mut t)))))
           ; and loading from an unusable root is "nothing saved", not an error:
           ; ENOTDIR/ENOENT both mean there is no counterexample here
           (assert-eq (load-code (db-load-failure a "p")) 0)
           (os/env-unset a "COIL_PBT_DB")
           0))
