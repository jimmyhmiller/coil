(module stateful_test)
(import "coil.primitive" :as primitive)
(import "coil.alloc" :as alloc :use *)
(import "coil.arraylist" :use *)
(import "coil.slice" :use *)
(import "coil.io" :use *)
(import "coil.fmt" :use *)
(import "coil.assert" :use *)
(import "coil.prop" :use *)
; Model-based testing of a hand-written fixed-capacity stack against an
; `(ArrayList i64)` model.
;
; The file tests coil.prop.stateful twice over. `stack-matches-model` is an
; ordinary property: the correct stack agrees with the model, and `coil test`
; fails if it ever does not. `finds-the-dropped-push` and `finds-the-deep-pop`
; are the interesting ones — they point the framework at a stack that has been
; DELIBERATELY broken and assert that (a) it finds the bug and (b) the sequence
; it hands back is a handful of commands, not the forty-odd it originally
; tripped over. Shrinking a command sequence is the entire claim of model-based
; testing; a test suite that never checks it is taking the claim on faith.

; ------------------------------------------------------------- the real system

(const CAP 8)

;; A fixed-capacity stack over an inline array — small, obvious, and (in the
;; buggy variants below) wrong in exactly one place.
(defstruct Stack [(data (array i64 8)) (len i64)])

;; Which bug this stack is carrying. One struct with a switch rather than three
;; near-identical structs, so the correct and broken systems are provably the
;; same code apart from the fault being injected.
(const BUG-NONE 0)
(const BUG-DROP-5TH 1)  ; push #5 reports success and stores nothing
(const BUG-DEEP-POP 2)  ; pop reaches one slot too far down

(defstruct Sys [(st Stack) (bug i64)])

(defn stack-slot [(s (ptr Stack)) (i i64)] (-> (ptr i64))
  (primitive/index (primitive/cast (ptr i64) (field s data)) i))

;; Push. Full is not an error the model has to model: the driver's `pre` refuses
;; to push into a full stack, so `run` never sees that case.
(defn sys-push! [(s (ptr Sys)) (v i64)] (-> i64)
  (let [st (field s st)
        n (.len st)]
    (if (>= n CAP)
        0
        (do
          (if (and (= (.bug s) BUG-DROP-5TH) (= n 4))
              ; THE BUG: the fifth element is silently not stored, but the
              ; length still moves. Nothing observable happens until something
              ; reads that slot back.
              0
              (do (set! (stack-slot st n) v) 0))
          (set! (.len st) (primitive/iadd n 1))
          0))))

(defn sys-pop! [(s (ptr Sys))] (-> (Option i64))
  (let [st (field s st)
        n (.len st)]
    (if (<= n 0)
        (None)
        (do
          (set! (.len st) (primitive/isub n 1))
          (if (and (= (.bug s) BUG-DEEP-POP) (>= n 2))
              ; THE BUG: an off-by-one reaches one slot too far down, so pop
              ; hands back the element UNDER the top. Length and contents stay
              ; perfectly consistent afterwards — only the ANSWER is wrong,
              ; which is why no invariant can catch this one and the
              ; postcondition has to.
              (Some (load (stack-slot st (primitive/isub n 2))))
              (Some (load (stack-slot st (primitive/isub n 1)))))))))

(defn sys-clear! [(s (ptr Sys))] (-> i64)
  (store! (field (field s st) len) 0)
  0)

(defn sys-len [(s (ptr Sys))] (-> i64)
  (load (field (field s st) len)))

; ------------------------------------------------------------ commands & model

;; Variant 0 is what a shrunk sequence collapses toward, so `push` — the command
;; that can start a sequence from nothing — goes first.
(defsum Cmd
  (CPush [(v i64)])
  (CPop [])
  (CClear []))

;; What `run` observed. `push` and `clear` return nothing to check, `pop` returns
;; the element; one `(Option i64)` covers all three and gives the postcondition
;; something real to compare.
(defstruct Res [(popped (Option i64))])

;; The model IS the specification: an ArrayList used as a stack, obviously
;; correct, allocated out of the case arena so it costs nothing to throw away.
(defstruct Model [(xs (ArrayList i64))])

(defn model-len [(m (ptr Model))] (-> i64)
  (al-len [i64] (.xs m)))

(defn stack-init [(m (ptr Model)) (s (ptr Sys)) (src (ptr Source))] (-> i64)
  (store! (field m xs) (al-new [i64] (src-alloc src)))
  ; the driver's system slot is an `primitive/alloc-stack`, so it arrives holding whatever
  ; the previous case left there. `init` owns making it a fresh system; forgetting
  ; a field here means the fault switch below is read from stale stack memory.
  (store! (field s bug) BUG-NONE)
  (store! (field (field s st) len) 0)
  (let [(mut i) 0]
    (loop (if (>= (load i) CAP)
              (break)
              (do
                (set! (stack-slot (field s st) (load i)) 0)
                (set! i (primitive/iadd (load i) 1))))))
  0)

;; `init` cannot set the fault — the driver owns the system slot — so each buggy
;; property gets its own init that flips the switch after the shared reset.
(defn stack-init-drop-5th [(m (ptr Model)) (s (ptr Sys)) (src (ptr Source))] (-> i64)
  (stack-init m s src)
  (store! (field s bug) BUG-DROP-5TH)
  0)

(defn stack-init-deep-pop [(m (ptr Model)) (s (ptr Sys)) (src (ptr Source))] (-> i64)
  (stack-init m s src)
  (store! (field s bug) BUG-DEEP-POP)
  0)

;; Draw a command: the tag inside the driver's per-command span, then the
;; argument. The pushed value is drawn from a small range on purpose — a stack
;; does not care what it stores, and small values make the shrunk report legible.
(defn stack-gen [(c (ptr Cmd)) (m (ptr Model)) (s (ptr Source))] (-> i64)
  (let [k (draw-tag! s 3)]
    (case k 0
          (do (store! c (CPush (draw-int! s 0 99))) 0) 1
          (do (store! c (CPop)) 0) (do (store! c (CClear)) 0))))

;; Push needs room, pop needs an element. Both are asked of the MODEL, which is
;; the whole point: a precondition that consults the system would be testing the
;; system with itself.
(defn stack-pre [(m (ptr Model)) (c (ptr Cmd))] (-> bool)
  (match (load c)
    (CPush [_] (< (model-len m) CAP))
    (CPop [] (> (model-len m) 0))
    (CClear [] true)))

(defn stack-run [(s (ptr Sys)) (c (ptr Cmd)) (r (ptr Res))] (-> i64)
  (store! (field r popped) (None))
  (match (load c)
    (CPush [v] (sys-push! s v))
    (CPop [] (do (set! (.popped r) (sys-pop! s)) 0))
    (CClear [] (sys-clear! s))))

;; Wrong ANSWERS are caught here, against the model as it was BEFORE the step: a
;; pop must return the model's current top.
(defn stack-post [(m (ptr Model)) (c (ptr Cmd)) (r (ptr Res))] (-> bool)
  (match (load c)
    (CPush [_] true)
    (CClear [] true)
    (CPop []
          (let [n (model-len m)]
            (if (<= n 0)
                ; unreachable while `pre` holds, but a postcondition that assumes its
                ; own precondition is how a framework ends up trusting itself.
                (match (.popped r) (None [] true) (Some [_] false))
                (match (.popped r)
                  (None [] false)
                  (Some [v] (= v (al-get [i64] (.xs m) (primitive/isub n 1))))))))))

(defn stack-next [(m (ptr Model)) (c (ptr Cmd)) (r (ptr Res))] (-> i64)
  (match (load c)
    (CPush [v] (al-push! [i64] (field m xs) v))
    (CPop []
          (set! (.len (.xs m)) (primitive/isub (al-len [i64] (.xs m)) 1)))
    (CClear [] (set! (.len (.xs m)) 0))))

;; Drift in the STATE is caught here: same length, same contents, bottom to top.
;; The length check alone would miss the dropped push, because the buggy stack
;; still advances its length — only the byte it failed to write gives it away.
(defn stack-inv [(m (ptr Model)) (s (ptr Sys))] (-> bool)
  (if (!= (model-len m) (sys-len s))
      false
      (let [n (model-len m)
            (mut i) 0
            (mut ok) true]
        (loop (if (or (>= (load i) n) (not (load ok)))
                  (break)
                  (do
                    (if (= (al-get [i64] (.xs m) (load i))
                           (load (stack-slot (field s st) (load i))))
                        0
                        (set! ok false))
                    (set! i (primitive/iadd (load i) 1)))))
        (load ok))))

(defn stack-show [(c (ptr Cmd)) (w (ptr Writer))] (-> i64)
  (match (load c)
    (CPush [v] (do (fmt w "(push {d})" v) 0))
    (CPop [] (do (print-str w "(pop)") 0))
    (CClear [] (do (print-str w "(clear)") 0))))

; ------------------------------------------------------------- the real property

;; The correct stack agrees with the model. This is the ordinary use of the
;; library, and it is what a user would write.
(defprop-stateful stack-matches-model
                  [Cmd Model Sys Res]
                  :init
                  stack-init
                  :gen
                  stack-gen
                  :pre
                  stack-pre
                  :run
                  stack-run
                  :post
                  stack-post
                  :next
                  stack-next
                  :inv
                  stack-inv
                  :show
                  stack-show
                  :min-cmds
                  0
                  :max-cmds
                  40)

; --------------------------------------------------- the framework, on trial

;; The two broken systems, as properties the framework is expected to REFUTE.
;; `sm-search` drives them exactly as `prop-run` would (generate, then shrink to a
;; fixpoint) but returns the verdict instead of aborting on it.
(defn buggy-drop-5th [(s (ptr Source)) (mode i64)] (-> bool)
  (let [(mut m)
          (sm-new [Cmd Model Sys Res]
                  "drop-5th"
                  0
                  40
                  (primitive/fnptr-of stack-init-drop-5th)
                  (primitive/fnptr-of stack-gen)
                  (primitive/fnptr-of stack-pre)
                  (primitive/fnptr-of stack-run)
                  (primitive/fnptr-of stack-post)
                  (primitive/fnptr-of stack-next)
                  (primitive/fnptr-of stack-inv)
                  (primitive/fnptr-of stack-show))]
    (sm-run! [Cmd Model Sys Res] (mut m) s mode)))

(defn buggy-deep-pop [(s (ptr Source)) (mode i64)] (-> bool)
  (let [(mut m)
          (sm-new [Cmd Model Sys Res]
                  "deep-pop"
                  0
                  40
                  (primitive/fnptr-of stack-init-deep-pop)
                  (primitive/fnptr-of stack-gen)
                  (primitive/fnptr-of stack-pre)
                  (primitive/fnptr-of stack-run)
                  (primitive/fnptr-of stack-post)
                  (primitive/fnptr-of stack-next)
                  (primitive/fnptr-of stack-inv)
                  (primitive/fnptr-of stack-show))]
    (sm-run! [Cmd Model Sys Res] (mut m) s mode)))

;; Run the search over several seeds and report each one.
;;
;; One seed proves nothing. "Shrinking works" is a claim about every search, not
;; about the one that happened to be in the commit, and a bound that holds for a
;; single lucky seed is exactly the kind of green test this whole module exists to
;; discredit. The `SmSearch` slot is hoisted out of the loop because an
;; `primitive/alloc-stack` inside one is never released until the function returns.
(defn scan-bug [(what (slice u8))
                (prop (fnptr c [(ptr Source) i64] bool))
                (seeds i64)
                (lo i64)
                (hi i64)] (-> bool)
  (let [w (stdout)
        (mut r) (zeroed SmSearch)
        (mut ok) true
        (mut k) 0]
    (loop (if (>= (load k) seeds)
              (break)
              (let [seed (primitive/iadd 1000003 (primitive/imul (load k) 7919))]
                (set! r (sm-search prop 400 40 seed 20000))
                (let [c (sms-commands (mut r))]
                  (fmt w
                       "  {s} seed {d}: found={d} after {d} cases, {d} commands, {d} choices, {d} shrinks\n"
                       what
                       seed
                       (if (sms-found? (mut r)) 1 0)
                       (sms-cases (mut r))
                       c
                       (sms-choices (mut r))
                       (sms-shrinks (mut r)))
                  (if (and (sms-found? (mut r)) (and (>= c lo) (<= c hi)))
                      0
                      (set! ok false))
                  ; one printed sequence is enough to read; the numbers cover the rest
                  (if (= (load k) 0) (sm-show-counterexample (mut r) prop) 0))
                (set! k (primitive/iadd (load k) 1))
                0)))
    (load ok)))

;; The dropped push needs five pushes to expose, so five is the floor: anything
;; below it would mean the shrinker "minimized" into a sequence that cannot reach
;; the fault — a counterexample that is not one. The ceiling of 8 is what proves the
;; point. Measure it by passing a shrink budget of 0: these same five seeds first
;; fail on sequences of 5, 17, 9, 5 and 14 commands, and the test goes red. (The
;; cap is 40, but `size` ramps, so a bug this easy to hit is usually caught while
;; the sequences are still short — the shrinker's job here is as much throwing away
;; the interleaved pops and clears as it is truncating.)
(deftest finds-the-dropped-push
         (assert (scan-bug "drop-5th" (primitive/fnptr-of buggy-drop-5th) 5 5 8)))

;; The deep pop needs two DIFFERENT values pushed and one pop to read the wrong
;; one back — three commands, and not two, because a stack holding one element (or
;; two equal ones) answers correctly. The invariant never fires here: length and
;; contents stay consistent, so this is the postcondition channel on its own.
(deftest finds-the-deep-pop
         (assert (scan-bug "deep-pop" (primitive/fnptr-of buggy-deep-pop) 5 3 5)))

;; The driver's own bookkeeping, and the mode contract it has to honour.
;;
;; A fixed command count makes the arithmetic checkable: six drawn, at most six
;; executed (a `pop` on an empty model is skipped), nothing failed. The second
;; half is the claim that matters for crash reporting — replaying the SAME tape in
;; draw-only mode, which never touches the system, must reconstruct the same
;; sequence, because `pre` and `run` do not draw and therefore cannot move the
;; cursor.
(deftest driver-reports-what-it-did
         (let [s (sm-source)
               (mut m)
                 (sm-new [Cmd Model Sys Res]
                         "probe"
                         6
                         6
                         (primitive/fnptr-of stack-init)
                         (primitive/fnptr-of stack-gen)
                         (primitive/fnptr-of stack-pre)
                         (primitive/fnptr-of stack-run)
                         (primitive/fnptr-of stack-post)
                         (primitive/fnptr-of stack-next)
                         (primitive/fnptr-of stack-inv)
                         (primitive/fnptr-of stack-show))]
           (source-begin-generate! s 20)
           (assert (sm-run! [Cmd Model Sys Res] (mut m) s PROP-MODE-RUN))
           (assert-eq (sm-generated [Cmd Model Sys Res] (mut m)) 6)
           (assert (<= (sm-executed [Cmd Model Sys Res] (mut m)) 6))
           (assert-eq (sm-failed-at [Cmd Model Sys Res] (mut m)) -1)
           (assert-eq (sm-failure [Cmd Model Sys Res] (mut m)) SM-OK)
           (assert-eq (sm-commands-in-last-run s) 6)
           ; clone first: `source-begin-replay!` clears the live tape before it reads the
           ; one it was handed, so replaying a Source from its own tape replays nothing.
           (let [(mut t) (tape-clone (sm-workspace) (src-tape s))]
             (source-begin-replay! s (mut t) 20)
             (assert (sm-run! [Cmd Model Sys Res] (mut m) s PROP-MODE-DRAW))
             (assert-eq (sm-commands-in-last-run s) 6))))
