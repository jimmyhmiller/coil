(module shrink_probe2)
(import "coil.primitive" :as primitive)
(import "coil.assert" :use *)
(import "coil.prop" :use *)
(import "coil.prop.shrink" :use *)
(import "coil.alloc" :as alloc :use *)
(import "coil.arraylist" :use *)
(import "coil.slice" :use *)
(import "coil.io" :use *)
(import "coil.fmt" :use *)

(defstruct TestCtx
  [(src (ptr Source))
   (prop (fnptr c [(ptr Source) i64] bool))
   (size i64)])

(defn tc-run [(ctx (ptr i8)) (tape (ptr (ArrayList Choice)))] (-> bool)
  (let [rc (primitive/cast (ptr TestCtx) ctx)
        s (load (field rc src))]
    (source-begin-replay! s tape (load (field rc size)))
    (let [held (primitive/call-ptr (load (field rc prop)) s 0)]
      (if (= (src-status s) ST-REJECTED) false (not held)))))

(defn p-int [(s (ptr Source)) (mode i64)] (-> bool)
  (< (arb-int-range s 0 1000000) 100))

(defn mk-choice [(kind i64) (v i64)] (-> Choice)
  (let [c (primitive/alloc-stack Choice)]
    (store! (field c kind) kind)
    (store! (field c flags) 0)
    (store! (field c span) -1)
    (store! (field c lo) -9223372036854775808)
    (store! (field c hi) 9223372036854775807)
    (store! (field c origin) 0)
    (store! (field c value) v)
    (load c)))

(deftest probe2
  (let [mem (malloc-allocator)
        s (source-new mem 1048576 1)
        rc (unwrap-ptr [TestCtx] (create [TestCtx] mem))
        (mut start) (al-new [Choice] mem)]
    (al-push! [Choice] (mut start) (mk-choice CK-INT 987654))
    (store! (field rc src) s)
    (store! (field rc prop) (primitive/fnptr-of p-int))
    (store! (field rc size) 30)
    (do (print-str (stdout) "A\n") 0)
    (source-begin-replay! s (mut start) 30)
    (do (print-str (stdout) "B\n") 0)
    (do (fmt (stdout) "plain={d}\n" (if (p-int s 0) 1 0)) 0)
    (source-begin-replay! s (mut start) 30)
    (let [f (load (field rc prop))]
      (do (print-str (stdout) "C\n") 0)
      (let [held (primitive/call-ptr f s 0)]
        (do (fmt (stdout) "held={d}\n" (if held 1 0)) 0)))
    (let [sc (shrink-ctx-new mem s (primitive/fnptr-of tc-run) (primitive/cast (ptr i8) rc) 100000)
          (mut failing) (tape-clone mem (src-tape s))
          (mut failing-spans) (spans-clone mem (src-spans s))
          (mut cand) (al-new [Choice] mem)]
      (sc-seed-best! sc (mut failing) (mut failing-spans))
      (do (print-str (stdout) "seeded\n") 0)
      (do (fmt (stdout) "try -> {d}\n" (if (sc-try! sc (mut cand)) 1 0)) 0))
    (assert true)))
