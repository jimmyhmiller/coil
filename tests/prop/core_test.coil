(module core_test)
(import "coil.prop" :use *)
(import "coil.io" :as io)
(import "coil.arraylist" :use *)
(import "coil.alloc" :as alloc :use *)
(import "coil.slice" :use *)
(import "coil.assert" :use *)
(import "coil.primitive" :as primitive)
; The engine's own regression suite: the tape, the draws, replay determinism, and
; the property runner end to end.
;
; Deliberately-failing properties do not live here — a suite that must be green
; cannot contain them. They live in `src/examples/property-testing.coil` and in
; `tests/prop/shrink_test.coil`, which drives the shrinker directly and asserts on
; the minimized result rather than on a process abort.

(defn mk [] (-> (ptr Source))
  (source-new (malloc-allocator) 4194304 4242))

; ------------------------------------------------------------------- the tape

(deftest tape-records-and-replays
         (let [s (mk)]
           (source-begin-generate! s 30)
           (let [a (draw-int! s 0 1000000)
                 b (draw-len! s 0 40)
                 c (draw-bool! s)
                 (mut saved) (tape-clone (malloc-allocator) (src-tape s))]
             (source-begin-replay! s (mut saved) 30)
             (assert-eq (draw-int! s 0 1000000) a)
             (assert-eq (draw-len! s 0 40) b)
             (assert-eq (if (draw-bool! s) 1 0) (if c 1 0))
             (assert-eq (src-status s) 0))))

(deftest empty-tape-yields-minima
         (let [s (mk)
               (mut empty) (al-new [Choice] (malloc-allocator))]
           (source-begin-replay! s (mut empty) 30)
           ; The floor the shrinker can always reach: every draw on an exhausted tape
           ; answers with the value closest to its origin.
           (assert-eq (draw-int! s 5 99) 5)
           (assert-eq (draw-int-origin! s -100 100 7) 7)
           (assert-eq (draw-len! s 0 50) 0)
           (assert-eq (draw-tag! s 4) 0)
           (assert-eq (if (draw-bool! s) 1 0) 0)
           (assert-eq (src-status s) 1)))

(deftest draws-respect-bounds
         (let [s (mk)
               (mut ok) true
               (mut i) 0]
           (source-begin-generate! s 30)
           (loop (if (>= (load i) 20000)
                     (break)
                     (do
                       (let [v (draw-int! s -7 23)]
                         (if (and (>= v -7) (<= v 23)) 0 (store! ok false)))
                       (let [t (draw-tag! s 5)]
                         (if (and (>= t 0) (< t 5)) 0 (store! ok false)))
                       (store! i (primitive/iadd (load i) 1)))))
           (assert (load ok))))

(deftest replayed-value-outranks-a-changed-constraint
         ; A shrunk tape often no longer fits the constraints the generator now asks
         ; for — a smaller length means a later element is never drawn, and a narrowed
         ; range means a recorded value is out of bounds. Replay must CLAMP rather than
         ; fail, or half the shrink candidates would be unrunnable.
         (let [s (mk)]
           (source-begin-generate! s 30)
           (draw-int! s 0 1000)
           (let [(mut saved) (tape-clone (malloc-allocator) (src-tape s))]
             (store! (field (al-elem [Choice] (mut saved) 0) value) 999)
             (source-begin-replay! s (mut saved) 30)
             (assert-eq (draw-int! s 0 10) 10))))

(deftest spans-nest-and-close
         (let [s (mk)]
           (source-begin-generate! s 30)
           (let [outer (span-open! s "outer" SPAN-PLAIN)]
             (draw-int! s 0 10)
             (let [inner (span-open! s "inner" SPAN-ELEM)]
               (draw-int! s 0 10)
               (span-close! s inner))
             (span-close! s outer))
           (assert-eq (al-len [Span] (load (src-spans s))) 2)
           (assert-eq (load (field (al-elem [Span] (src-spans s) 1) parent)) 0)
           (assert-eq (load (field (al-elem [Span] (src-spans s) 1) depth)) 1)
           (assert-eq (load (field (al-elem [Span] (src-spans s) 0) end)) 2)))

(deftest shortlex-orders-tapes
         (let [a (malloc-allocator)
               s (mk)]
           (source-begin-generate! s 30)
           (draw-int-origin! s 0 100 0)
           (let [(mut one) (tape-clone a (src-tape s))]
             (draw-int! s 0 100)
             (let [(mut two) (tape-clone a (src-tape s))
                   (mut zeroed) (tape-clone a (mut one))]
               ; fewer choices always wins
               (assert (< (tape-compare (mut one) (mut two)) 0))
               ; at equal length, closer to the origin wins
               (store! (field (al-elem [Choice] (mut zeroed) 0) value) 0)
               (assert (<= (tape-compare (mut zeroed) (mut one)) 0))))))

; ------------------------------------------------------------------ generation

(deftest generated-values-replay-identically
         (let [s (mk)]
           (source-begin-generate! s 25)
           (let [l1 (arb [(ArrayList i64)] s)
                 (mut saved) (tape-clone (malloc-allocator) (src-tape s))]
             (source-begin-replay! s (mut saved) 25)
             (let [l2 (arb [(ArrayList i64)] s)
                   (mut i) 0
                   (mut ok) (= (al-len [i64] l1) (al-len [i64] l2))]
               (loop (if (or (>= (load i) (al-len [i64] l1)) (not (load ok)))
                         (break)
                         (do
                           (if (= (al-get [i64] l1 (load i)) (al-get [i64] l2 (load i)))
                               0
                               (store! ok false))
                           (store! i (primitive/iadd (load i) 1)))))
               (assert (load ok))))))

(deftest minimal-values-are-empty-and-zero
         (let [s (mk)
               (mut empty) (al-new [Choice] (malloc-allocator))]
           (source-begin-replay! s (mut empty) 30)
           (assert-eq (al-len [i64] (arb [(ArrayList i64)] s)) 0)
           (assert (match (arb [(Option i64)] s) (None [] true) (Some [_] false)))
           (assert-eq (arb [i64] s) 0)
           (assert-eq (slice-len [u8] (arb [(slice u8)] s)) 0)))

(deftest edge-values-actually-appear
         ; Uniform sampling of a 64-bit range essentially never produces 0, 1 or -1, and
         ; those are where the bugs are. If this regresses, generation has silently
         ; stopped exercising the interesting inputs while every test stays green.
         (let [s (mk)
               (mut saw-zero) false
               (mut saw-one) false
               (mut saw-neg) false
               (mut i) 0]
           (source-begin-generate! s 30)
           (loop (if (>= (load i) 5000)
                     (break)
                     (let [v (arb [i64] s)]
                       (if (= v 0) (store! saw-zero true) 0)
                       (if (= v 1) (store! saw-one true) 0)
                       (if (= v -1) (store! saw-neg true) 0)
                       (store! i (primitive/iadd (load i) 1))
                       0)))
           (assert (load saw-zero))
           (assert (load saw-one))
           (assert (load saw-neg))))

(deftest lists-stay-within-the-size-budget
         (let [s (mk)
               (mut ok) true
               (mut i) 0]
           (loop (if (>= (load i) 500)
                     (break)
                     (do
                       (source-begin-generate! s 12)
                       (if (<= (al-len [i64] (arb [(ArrayList i64)] s)) 12) 0 (store! ok false))
                       (store! i (primitive/iadd (load i) 1)))))
           (assert (load ok))))

; --------------------------------------------------------------- the runner

(defprop addition-commutes
         [(a i64) (b i64)]
         (= (primitive/iadd a b) (primitive/iadd b a)))

(defprop list-length-matches-what-was-pushed
         [(xs (ArrayList i64)) (extra i64)]
         (let [(mut l) (al-new [i64] (malloc-allocator))
               (mut i) 0]
           (loop (if (>= (load i) (al-len [i64] xs))
                     (break)
                     (do
                       (al-push! [i64] (mut l) (al-get [i64] xs (load i)))
                       (store! i (primitive/iadd (load i) 1)))))
           (al-push! [i64] (mut l) extra)
           (let [n (al-len [i64] (load l))]
             (al-free! [i64] (mut l))
             (= n (primitive/iadd (al-len [i64] xs) 1)))))

(defprop strings-are-printable
         [(s (slice u8))]
         (let [(mut i) 0
               (mut ok) true]
           (loop (if (or (>= (load i) (slice-len [u8] s)) (not (load ok)))
                     (break)
                     (do
                       (let [c (primitive/cast i64 (slice-get [u8] s (load i)))]
                         (if (and (>= c 32) (<= c 126)) 0 (store! ok false)))
                       (store! i (primitive/iadd (load i) 1)))))
           (load ok)))

;; `assume` discards a case rather than failing it — and `classify` proves the
;; discarding did not leave the run testing nothing.
(defprop positive-halves-round-down
         [(n i64)]
         (assume (> n 1))
         (classify "big" (> n 1000))
         (< (primitive/udiv n 2) n))

;; Recorded observations show up in the verbose report; here they just have to
;; not disturb the property.
(defprop collect-does-not-disturb
         [(xs (ArrayList i64))]
         (>= (collect "len" (al-len [i64] xs)) 0))

; ------------------------------------------------------ allocator separation

;; The Source's long-lived buffers must NOT live in the per-case arena.
;;
;; `arena-over-buffer` rewrites the `Allocator` struct it is handed rather than
;; building a new one, so handing it the caller's allocator makes the arena and
;; that allocator the same three words — and then `source-reset!`'s rewind hands
;; the tape's own storage back out as the next case's generated values. That bug
;; was live, and every test in this file passed with it: the corruption needs a
;; case that both allocates from the arena and outlives a reset. This checks the
;; structural fact directly instead of waiting for a symptom.
(deftest tape-and-spans-live-outside-the-case-arena
         (let [s (mk)]
           (source-begin-generate! s 40)
           (arb [(ArrayList i64)] s)
           (arb [(ArrayList i64)] s)
           (let [ar (load (field s arena-state))
                 base (load (field ar base))
                 cap (load (field ar cap))
                 tape-buf (primitive/cast (ptr i8) (load (field (field s tape) data)))
                 span-buf (primitive/cast (ptr i8) (load (field (field s spans) data)))]
             (assert (not (and (>= tape-buf base) (< tape-buf (primitive/index base cap)))))
             (assert (not (and (>= span-buf base) (< span-buf (primitive/index base cap)))))
             ; and the arena is really the thing generated values come from — if this is
             ; zero, they are being malloc'd and never freed, which looks like a healthy
             ; steady state right up until the memory runs out.
             (assert (> (load (field ar off)) 0)))))

; ------------------------------------------- user-defined Eq through defprop

;;; A type whose equality is the USER's, compared inside a property body.
;;;
;;; `defprop` expands into the caller's scope and its expansion mentions `=`, so
;;; this is the one place where macro hygiene and trait dispatch have to coexist:
;;; the `=` a property body evaluates must still dispatch on the ARGUMENT TYPE at
;;; the use site, finding this impl — not resolve to something fixed at macro
;;; definition time. If a hygiene change ever qualifies that `=` in a way that
;;; freezes dispatch, every property comparing a user type silently starts
;;; comparing the wrong thing, and no existing test would notice.
;;;
;;; Deliberately NOT structural equality: `Tagged` ignores its `tag` field, so an
;;; impl-was-not-found failure cannot masquerade as a pass.
(defstruct Tagged [(v i64) (tag i64)])

(impl Eq Tagged
  (= [(a Tagged) (b Tagged)]
     (-> bool)
     (= (.v a) (.v b))))

(impl Arbitrary Tagged
  (arbitrary [(out (mut Tagged)) (s (ptr Source))]
             (-> i64)
             (store! (field out v) (draw-int! s 0 3))
             (store! (field out tag) (draw-int! s 0 1000000))
             0))

(impl Debug Tagged
  (debug-write [(x Tagged) (w (ptr io/Writer))]
               (-> i64)
               (io/print-str w "(Tagged v=")
               (debug-write (.v x) w)
               (io/print-str w " tag=")
               (debug-write (.tag x) w)
               (io/print-str w ")")
               0))

;; Two values equal under the user's `=` whenever their `v` agrees, whatever the
;; tags are. Structural equality would make this false, so a wrong-`=` regression
;; fails the property rather than passing it.
(defprop user-defined-eq-dispatches-at-the-use-site
         [(a Tagged) (b Tagged)]
         (= (= a b) (= (load (field a v)) (load (field b v)))))

;; And the same claim where the tags are FORCED to differ, so the property is
;; never satisfied by two identical structs.
(defprop user-eq-ignores-the-tag-field
         [(x Tagged)]
         (let [(mut y) (zeroed Tagged)]
           (store! (field (mut y) v) (load (field x v)))
           (store! (field (mut y) tag) (+ (load (field x tag)) 1))
           (= x (load y))))
