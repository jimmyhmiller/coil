(module shrink_probe)
(import "coil.primitive" :as primitive)
(import "coil.assert" :use *)
(import "coil.prop" :use *)
(import "coil.prop.shrink" :use *)
(import "coil.alloc" :as alloc :use *)
(import "coil.arraylist" :use *)
(import "coil.slice" :use *)
(import "coil.io" :use *)
(import "coil.fmt" :use *)
(import "coil.hashmap" :use *)

(defn mk-choice [(kind i64) (v i64)] (-> Choice)
  (let [c (primitive/alloc-stack Choice)]
    (store! (field c kind) kind)
    (store! (field c flags) 0)
    (store! (field c span) -1)
    (store! (field c lo) -9223372036854775808)
    (store! (field c hi) 9223372036854775807)
    (store! (field c origin) 0)
    (store! (field c value) v)
    (load c)))

(defn push! [(t (ptr (ArrayList Choice))) (kind i64) (v i64)] (-> i64)
  (al-push! [Choice] t (mk-choice kind v))
  0)

(defstruct TestCtx
  [(src (ptr Source))
   (prop (fnptr c [(ptr Source)] bool))
   (size i64)])

(defn tc-run [(ctx (ptr i8)) (tape (ptr (ArrayList Choice)))] (-> bool)
  (let [rc (primitive/cast (ptr TestCtx) ctx)
        s (load (field rc src))]
    (source-begin-replay! s tape (load (field rc size)))
    (let [held (primitive/call-ptr (load (field rc prop)) s)]
      (if (= (src-status s) ST-REJECTED) false (not held)))))

(defn seed-ctx [(prop (fnptr c [(ptr Source)] bool))
                (start (ptr (ArrayList Choice)))
                (size i64)
                (budget i64)] (-> (ptr ShrinkCtx))
  (let [mem (malloc-allocator)
        s (source-new mem 1048576 1)
        rc (unwrap-ptr [TestCtx] (create [TestCtx] mem))]
    (store! (field rc src) s)
    (store! (field rc prop) prop)
    (store! (field rc size) size)
    (source-begin-replay! s start size)
    (if (primitive/call-ptr prop s)
        (do (print-str (stderr) "seed tape does not fail\n") (abort) 0)
        0)
    (let [sc (shrink-ctx-new mem s (primitive/fnptr-of tc-run) (primitive/cast (ptr i8) rc) budget)
          (mut failing) (tape-clone mem (src-tape s))
          (mut failing-spans) (spans-clone mem (src-spans s))]
      (sc-seed-best! sc (mut failing) (mut failing-spans))
      (do (fmt (stdout) "seed: s={x} rc={x} ctx={x} stored-ctx={x}\n"
               (primitive/cast i64 s)
               (primitive/cast i64 rc)
               (primitive/cast i64 (primitive/cast (ptr i8) rc))
               (primitive/cast i64 (load (field sc ctx)))) 0)
      sc)))

(defn call-it [(f (fnptr c [(ptr i8) (ptr (ArrayList Choice))] bool)) (cx (ptr i8)) (cand (ptr (ArrayList Choice)))] (-> bool)
  (primitive/call-ptr f cx cand))

(defn my-try [(c (ptr ShrinkCtx)) (cand (ptr (ArrayList Choice)))] (-> bool)
  (primitive/call-ptr (load (field c run)) (load (field c ctx)) cand))

(defn dump [(label (slice u8)) (sc (ptr ShrinkCtx))] (-> i64)
  (let [w (stdout)
        t (sc-best sc)
        n (al-len [Choice] (load t))
        (mut i) 0]
    (fmt w "{s}: len={d} calls={d} accepted={d}  [" label n (sc-calls sc) (sc-accepted sc))
    (loop (if (>= (load i) n)
              (break)
              (let [ch (al-get [Choice] (load t) (load i))]
                (fmt w "{d}:{d} " (load (field ch kind)) (load (field ch value)))
                (store! i (primitive/iadd (load i) 1))
                0)))
    (print-str w "] passes:")
    0
    (store! i 0)
    (loop (if (>= (load i) 10)
              (break)
              (do (if (> (sc-pass-accepts sc (load i)) 0)
                      (do (fmt w " {s}={d}" (shrink-pass-name (load i)) (sc-pass-accepts sc (load i))) 0)
                      0)
                  (store! i (primitive/iadd (load i) 1)))))
    (print-str w "\n")
    0))

; ------------------------------------------------------------------ fixtures

(defn p-int [(s (ptr Source))] (-> bool)
  (< (arb-int-range s 0 1000000) 100))

(defn gen-small-list [(s (ptr Source))] (-> (ArrayList i64))
  (let [sp (span-open! s "list" SPAN-PLAIN)
        n (draw-len! s 0 (src-size s))
        (mut l) (al-new [i64] (src-alloc s))
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (let [esp (span-open! s "elem" SPAN-ELEM)]
                (al-push! [i64] (mut l) (arb-int-range s 0 1000))
                (span-close! s esp)
                (store! i (primitive/iadd (load i) 1))
                0)))
    (span-close! s sp)
    (load l)))

(defn p-list [(s (ptr Source))] (-> bool)
  (let [l (gen-small-list s)
        n (al-len [i64] l)
        (mut hit) false
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do (if (= (al-get [i64] l (load i)) 3) (store! hit true) 0)
                  (store! i (primitive/iadd (load i) 1)))))
    (not (load hit))))

(defn p-sum [(s (ptr Source))] (-> bool)
  (let [a (arb-int-range s 0 1000)
        b (arb-int-range s 0 1000)]
    (< (primitive/iadd a b) 100)))

(defn p-twins [(s (ptr Source))] (-> bool)
  (let [a (arb-int-range s 0 1000)
        b (arb-int-range s 0 1000)]
    (not (and (= a b) (>= a 1)))))

(defn gen-tree [(s (ptr Source))] (-> i64)
  (let [sp (span-open! s "tree" SPAN-NODE)
        deep (> (src-fuel s) 0)
        tag (draw-tag! s 2)
        (mut best) 0]
    (if (and deep (= tag 1))
        (do (src-spend-fuel! s 1)
            (let [l (gen-tree s)
                  r (gen-tree s)]
              (store! best (if (> l r) l r)))
            0)
        (store! best (arb-int-range s 0 1000)))
    (span-close! s sp)
    (load best)))

(defn p-tree [(s (ptr Source))] (-> bool)
  (< (gen-tree s) 10))

;; first element and length only
(defn p-head [(s (ptr Source))] (-> bool)
  (let [l (gen-small-list s)]
    (if (< (al-len [i64] l) 2)
        true
        (< (al-get [i64] l 0) 10))))

;; length >= 3 and some element >= 10
(defn p-any3 [(s (ptr Source))] (-> bool)
  (let [l (gen-small-list s)
        n (al-len [i64] l)
        (mut hit) false
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do (if (>= (al-get [i64] l (load i)) 10) (store! hit true) 0)
                  (store! i (primitive/iadd (load i) 1)))))
    (if (< n 3) true (not (load hit)))))

;; three bare ints, no spans; fails when the first two are both positive
(defn p-bare [(s (ptr Source))] (-> bool)
  (let [a (arb-int-range s 0 1000)
        b (arb-int-range s 0 1000)
        c (arb-int-range s 0 1000)]
    (not (and (>= a 1) (>= b 1)))))

(deftest probe
  (let [mem (malloc-allocator)]
    (do (print-str (stdout) "start\n") 0)
    (let [(mut t) (al-new [Choice] mem)]
      (push! (mut t) CK-INT 987654)
      (do (print-str (stdout) "built\n") 0)
      (let [sc (seed-ctx (primitive/fnptr-of p-int) (mut t) 30 100000)]
        (do (print-str (stdout) "seeded\n") 0)
        (let [(mut cand) (al-new [Choice] mem)
              rc2 (unwrap-ptr [TestCtx] (create [TestCtx] mem))
              s2 (source-new mem 65536 1)]
          (store! (field rc2 src) s2)
          (store! (field rc2 prop) (primitive/fnptr-of p-int))
          (store! (field rc2 size) 30)
          (do (fmt (stdout) "direct -> {d}\n" (if (tc-run (primitive/cast (ptr i8) rc2) (mut cand)) 1 0)) 0)
          (do (fmt (stdout) "hash={d} cmp={d}\n" (tape-hash (mut cand)) (tape-compare (mut cand) (sc-best sc))) 0)
          (let [(mut m) (hm-new-scalar [i64 i64] mem)]
            (do (print-str (stdout) "hm made\n") 0)
            (hm-put! [i64 i64] (mut m) 7 1)
            (do (print-str (stdout) "hm put\n") 0)
            (match (hm-get [i64 i64] (load m) 7)
              (Some [_] (do (print-str (stdout) "hm hit\n") 0))
              (None [] (do (print-str (stdout) "hm miss\n") 0))))
          (do (fmt (stdout) "seen-get={d}\n" (match (hm-get [i64 i64] (load (field sc seen)) (tape-hash (mut cand))) (Some [_] 1) (None [] 0))) 0)
          (hm-put! [i64 i64] (mut (field sc seen)) 99 1)
          (do (print-str (stdout) "seen-put ok\n") 0)
          (do (fmt (stdout) "call-it rc2 -> {d}\n" (if (call-it (primitive/fnptr-of tc-run) (primitive/cast (ptr i8) rc2) (mut cand)) 1 0)) 0)
          (let [back (primitive/cast (ptr TestCtx) (load (field sc ctx)))]
            (do (fmt (stdout) "back: src={x} size={d}\n" (primitive/cast i64 (load (field back src))) (load (field back size))) 0))
          (do (fmt (stdout) "call-it sc-ctx -> {d}\n" (if (call-it (primitive/fnptr-of tc-run) (load (field sc ctx)) (mut cand)) 1 0)) 0)
          (do (fmt (stdout) "call-it sc-run -> {d}\n" (if (call-it (load (field sc run)) (primitive/cast (ptr i8) rc2) (mut cand)) 1 0)) 0)
          (do (fmt (stdout) "my-try -> {d}\n" (if (my-try sc (mut cand)) 1 0)) 0)
          (do (fmt (stdout) "try -> {d}\n" (if (sc-try! sc (mut cand)) 1 0)) 0))
        (do (print-str (stdout) "truncated\n") 0)
        (dump "int" sc)))
    (assert true)))
