(module shrink_test)
(import "coil.primitive" :as primitive)
(import "coil.assert" :use *)
(import "coil.prop.source" :use *)
(import "coil.prop.arbitrary" :use *)
(import "coil.prop.shrink" :use *)
(import "coil.alloc" :as alloc :use *)
(import "coil.arraylist" :use *)
(import "coil.slice" :use *)
(import "coil.io" :use *)
; SHRINKER TESTS — properties whose minimal counterexample is known in advance,
; driven through the real shrink machinery, asserted on the resulting TAPE.
;
; Not through `defprop`. A test that reads a printed counterexample is testing the
; printer; these seed `ShrinkCtx` directly and assert on `sc-best` — the exact
; choices, in order — plus the number of property calls it took to get there. The
; call count is half the point: a pass that reaches the right answer with ten times
; the calls has broken the shrinker for anything real, and nothing about the
; printed result would say so.
;
; Every test starts from a HAND-BUILT tape rather than from random search. Replay
; is total (`prop_source.coil`), so any list of (kind, value) pairs is a legal
; starting point, and starting somewhere the RNG chose would make these tests a
; measurement of the RNG.

; --------------------------------------------------------------- the harness

;; A tape entry. `lo`/`hi`/`origin` are deliberately wide open: replay takes the
;; recorded VALUE and clamps it with the constraints the GENERATOR supplies, so the
;; only field that has to be right here is `kind` — a kind mismatch is what replay
;; reads as an overrun.
(defn mk-choice [(kind i64) (v i64)] (-> Choice)
  (let [c (primitive/alloc-stack Choice)]
    (set! (.kind c) kind)
    (set! (.flags c) 0)
    (set! (.span c) -1)
    (set! (.lo c) -9223372036854775808)
    (set! (.hi c) 9223372036854775807)
    (set! (.origin c) 0)
    (set! (.value c) v)
    (load c)))

(defn push! [(t (ptr (ArrayList Choice))) (kind i64) (v i64)] (-> i64)
  (al-push! [Choice] t (mk-choice kind v))
  0)

;; What the shrinker calls back into. The real runner's `RunCtx` would do, but it
;; carries the runner's mode/crash-code protocol; a property here is just
;; `Source -> bool`, so these tests depend on nothing but the tape and the passes.
(defstruct TestCtx
  [(src (ptr Source))
   (prop (fnptr c [(ptr Source)] bool))
   (size i64)])

(defn tc-run [(ctx (ptr i8)) (tape (ptr (ArrayList Choice)))] (-> bool)
  (let [rc (primitive/cast (ptr TestCtx) ctx)
        s (load (field rc src))]
    (source-begin-replay! s tape (.size rc))
    (let [held (primitive/call-ptr (.prop rc) s)]
      (if (= (src-status s) ST-REJECTED) false (not held)))))

;; Seed a shrink context on `start`, which MUST already fail the property.
;;
;; The two `malloc-allocator` calls used to be load-bearing: `source-new` handed
;; its `mem` argument to `arena-over-buffer`, which rewrites that Allocator struct
;; in place, and `malloc-allocator` hands out one process-wide static — so the
;; shrinker's own best tape came out of the arena that every replay rewinds.
;; `source-new` now allocates the arena its own cell, so this is ordinary code
;; again: one allocator for the Source's long-lived buffers, one for the harness.
(defn seed-ctx [(prop (fnptr c [(ptr Source)] bool))
                (start (ptr (ArrayList Choice)))
                (size i64)
                (budget i64)] (-> (ptr ShrinkCtx))
  (let [mem (malloc-allocator)
        s (source-new mem 1048576 1)
        rc (unwrap-ptr [TestCtx] (create [TestCtx] mem))]
    (set! (.src rc) s)
    (set! (.prop rc) prop)
    (set! (.size rc) size)
    (source-begin-replay! s start size)
    (if (primitive/call-ptr prop s)
        ; a fixture that does not fail would make every assertion below vacuous.
        (do
          (print-str (stderr) "shrink_test: the seed tape does not fail its property\n")
          (abort)
          0)
        0)
    (let [sc (shrink-ctx-new mem s (primitive/fnptr-of tc-run) (primitive/cast (ptr i8) rc) budget)
          (mut failing) (tape-clone mem (src-tape s))
          (mut failing-spans) (spans-clone mem (src-spans s))]
      (sc-seed-best! sc (mut failing) (mut failing-spans))
      sc)))

(defn tape-len [(sc (ptr ShrinkCtx))] (-> i64)
  (al-len [Choice] (load (sc-best sc))))

;; The value of the shrunk tape's choice `i`. Out of range is a broken test, not a
;; wrong answer, so it dies loudly rather than returning a sentinel that would make
;; the assertion below fail for the wrong reason.
(defn tape-val [(sc (ptr ShrinkCtx)) (i i64)] (-> i64)
  (let [t (sc-best sc)]
    (if (or (< i 0) (>= i (al-len [Choice] (load t))))
        (do (print-str (stderr) "shrink_test: tape index out of range\n") (abort) 0)
        (let [ch (al-get [Choice] (load t) i)]
          (.value ch)))))

(defn tape-kind [(sc (ptr ShrinkCtx)) (i i64)] (-> i64)
  (let [t (sc-best sc)]
    (if (or (< i 0) (>= i (al-len [Choice] (load t))))
        (do (print-str (stderr) "shrink_test: tape index out of range\n") (abort) 0)
        (let [ch (al-get [Choice] (load t) i)]
          (.kind ch)))))

; ---------------------------------------------------------------- properties

;; Fails for x >= 100 and nothing else, so the minimum is the boundary itself and
;; not a round number a lazy search could stumble onto.
(defn p-int [(s (ptr Source))] (-> bool)
  (< (arb-int-range s 0 1000000) 100))

;; A list generator shaped like the stdlib's: a length, then one span per element.
(defn gen-list [(s (ptr Source))] (-> (ArrayList i64))
  (let [sp (span-open! s "list" SPAN-PLAIN)
        n (draw-len! s 0 (src-size s))
        (mut l) (al-new [i64] (src-alloc s))
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (let [esp (span-open! s "elem" SPAN-ELEM)]
                (al-push! [i64] (mut l) (arb-int-range s 0 1000))
                (span-close! s esp)
                (set! i (primitive/iadd (load i) 1))
                0)))
    (span-close! s sp)
    (load l)))

;; Fails iff the list contains a 3. Minimum: the one-element list `[3]`, which
;; needs the length and the element to shrink TOGETHER — lowering the length alone
;; drops the 3, and blanking elements alone leaves the length untouched.
(defn p-list [(s (ptr Source))] (-> bool)
  (let [l (gen-list s)
        n (al-len [i64] l)
        (mut hit) false
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (if (= (al-get [i64] l (load i)) 3) (set! hit true) 0)
                (set! i (primitive/iadd (load i) 1)))))
    (not (load hit))))

;; Only the SUM matters, so neither number can move on its own: lower either one
;; and the sum falls under the bound. Minimum on shortlex is `(0, 100)`.
(defn p-sum [(s (ptr Source))] (-> bool)
  (let [a (arb-int-range s 0 1000)
        b (arb-int-range s 0 1000)]
    (< (primitive/iadd a b) 100)))

;; Fails only when the two draws are EQUAL and non-zero. Every single-value move
;; breaks the equality and stops the failure; only lowering both at once works.
(defn p-twins [(s (ptr Source))] (-> bool)
  (let [a (arb-int-range s 0 1000)
        b (arb-int-range s 0 1000)]
    (not (and (= a b) (>= a 1)))))

;; A recursive generator: every node opens a span with the SAME label, which is
;; what lets `pass-hoist` replace a node with one of its own subtrees.
(defn gen-tree [(s (ptr Source))] (-> i64)
  (let [sp (span-open! s "tree" SPAN-NODE)
        deep (> (src-fuel s) 0)
        tag (draw-tag! s 2)
        (mut biggest) 0]
    (if (and deep (= tag 1))
        (do
          (src-spend-fuel! s 1)
          (let [l (gen-tree s)
                r (gen-tree s)]
            (set! biggest (if (> l r) l r)))
          0)
        (set! biggest (arb-int-range s 0 1000)))
    (span-close! s sp)
    (load biggest)))

;; Fails iff some leaf is >= 10. Minimum: a single leaf holding exactly 10, i.e.
;; the two-choice tape `(tag 0, 10)` — the whole tree has to collapse.
(defn p-tree [(s (ptr Source))] (-> bool)
  (< (gen-tree s) 10))

;; Only the length and the FIRST element matter; everything after it is free, which
;; is the shape `pass-dedupe-spans` and `pass-zero-spans` exist for.
(defn p-head [(s (ptr Source))] (-> bool)
  (let [l (gen-list s)]
    (if (< (al-len [i64] l) 2)
        true
        (< (al-get [i64] l 0) 10))))

;; Order-insensitive: fails iff the list has at least three elements and any one of
;; them is >= 10. Two runs that find it should report the same permutation.
(defn p-unordered [(s (ptr Source))] (-> bool)
  (let [l (gen-list s)
        n (al-len [i64] l)
        (mut hit) false
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (if (>= (al-get [i64] l (load i)) 10) (set! hit true) 0)
                (set! i (primitive/iadd (load i) 1)))))
    (if (< n 3) true (not (load hit)))))

;; Three bare integers, no spans at all: nothing structural to delete, and the
;; third draw is ignored entirely.
(defn p-bare [(s (ptr Source))] (-> bool)
  (let [a (arb-int-range s 0 1000)
        b (arb-int-range s 0 1000)
        c (arb-int-range s 0 1000)]
    (not (and (>= a 1) (>= b 1)))))

; ------------------------------------------------- end-to-end: known minima

(deftest int-property-shrinks-to-the-exact-boundary
         (let [mem (malloc-allocator)
               (mut t) (al-new [Choice] mem)]
           (push! (mut t) CK-INT 987654)
           (let [sc (seed-ctx (primitive/fnptr-of p-int) (mut t) 30 100000)]
             (shrink-run! sc)
             (assert-eq (tape-len sc) 1)
             (assert-eq (tape-val sc 0) 100)
             ; ~64 calls would be one binary search per bit; anything near that means the
             ; whole-jump-to-origin shortcut has stopped working.
             (assert (< (sc-calls sc) 80)))))

(deftest list-property-shrinks-to-the-one-element-that-matters
         (let [mem (malloc-allocator)
               (mut t) (al-new [Choice] mem)]
           (push! (mut t) CK-LEN 6)
           (push! (mut t) CK-INT 7)
           (push! (mut t) CK-INT 2)
           (push! (mut t) CK-INT 3)
           (push! (mut t) CK-INT 19)
           (push! (mut t) CK-INT 4)
           (push! (mut t) CK-INT 11)
           (let [sc (seed-ctx (primitive/fnptr-of p-list) (mut t) 30 100000)]
             (shrink-run! sc)
             ; the list `[3]`: a length of 1 and the element that reproduces the failure.
             (assert-eq (tape-len sc) 2)
             (assert-eq (tape-kind sc 0) CK-LEN)
             (assert-eq (tape-val sc 0) 1)
             (assert-eq (tape-val sc 1) 3)
             (assert (< (sc-calls sc) 70))
             ; deleting elements is the move here; if this ever reaches zero, the answer
             ; above is being found by brute-force value minimization instead.
             (assert (> (sc-pass-accepts sc PASS-DELETE-SPANS) 0)))))

(deftest pair-property-shrinks-by-moving-mass-between-the-numbers
         (let [mem (malloc-allocator)
               (mut t) (al-new [Choice] mem)]
           (push! (mut t) CK-INT 742)
           (push! (mut t) CK-INT 615)
           (let [sc (seed-ctx (primitive/fnptr-of p-sum) (mut t) 30 100000)]
             (shrink-run! sc)
             (assert-eq (tape-len sc) 2)
             (assert-eq (tape-val sc 0) 0)
             (assert-eq (tape-val sc 1) 100)
             (assert (< (sc-calls sc) 70))
             ; binary search alone stalls at whatever pair happens to sum to 100; only
             ; redistribution reaches the canonical (0, 100).
             (assert (> (sc-pass-accepts sc PASS-REDISTRIBUTE) 0)))))

(deftest twin-property-shrinks-both-values-together
         (let [mem (malloc-allocator)
               (mut t) (al-new [Choice] mem)]
           (push! (mut t) CK-INT 371)
           (push! (mut t) CK-INT 371)
           (let [sc (seed-ctx (primitive/fnptr-of p-twins) (mut t) 30 100000)]
             (shrink-run! sc)
             (assert-eq (tape-len sc) 2)
             (assert-eq (tape-val sc 0) 1)
             (assert-eq (tape-val sc 1) 1)
             (assert (< (sc-calls sc) 160))
             ; nothing else can move here: every candidate that changes one value alone
             ; makes the property hold again.
             (assert (> (sc-pass-accepts sc PASS-LOWER-TOGETHER) 0)))))

(deftest deep-tree-shrinks-to-a-single-leaf
         (let [mem (malloc-allocator)
               (mut t) (al-new [Choice] mem)]
           ; Node(Node(Leaf 3, Leaf 47), Node(Leaf 8, Leaf 5)) — 11 choices, one of which
           ; is the 47 that actually falsifies the property.
           (push! (mut t) CK-TAG 1)
           (push! (mut t) CK-TAG 1)
           (push! (mut t) CK-TAG 0)
           (push! (mut t) CK-INT 3)
           (push! (mut t) CK-TAG 0)
           (push! (mut t) CK-INT 47)
           (push! (mut t) CK-TAG 1)
           (push! (mut t) CK-TAG 0)
           (push! (mut t) CK-INT 8)
           (push! (mut t) CK-TAG 0)
           (push! (mut t) CK-INT 5)
           (let [sc (seed-ctx (primitive/fnptr-of p-tree) (mut t) 30 100000)]
             (shrink-run! sc)
             ; `Leaf 10`: the leaf tag, then the smallest value that still falsifies.
             (assert-eq (tape-len sc) 2)
             (assert-eq (tape-kind sc 0) CK-TAG)
             (assert-eq (tape-val sc 0) 0)
             (assert-eq (tape-val sc 1) 10)
             (assert (< (sc-calls sc) 70))
             ; whittling a tree from the leaves stalls; replacing a node with one of its
             ; own subtrees is what collapses it.
             (assert (> (primitive/iadd (sc-pass-accepts sc PASS-HOIST)
                                        (sc-pass-accepts sc PASS-DELETE-SPANS))
                        0)))))

; ------------------------------------------------- one pass at a time
; Driving `shrink-run!` proves the fixpoint agrees on an answer; it cannot prove
; WHICH pass can express a given move, because ten passes are racing for it. These
; run a single pass against a tape built so that only that pass can improve it.

(deftest dedupe-spans-makes-one-value-do-the-work-of-three
         (let [mem (malloc-allocator)
               (mut t) (al-new [Choice] mem)]
           (push! (mut t) CK-LEN 3)
           (push! (mut t) CK-INT 500)
           (push! (mut t) CK-INT 900)
           (push! (mut t) CK-INT 700)
           (let [sc (seed-ctx (primitive/fnptr-of p-head) (mut t) 30 100000)]
             (assert (pass-dedupe-spans sc))
             ; the trailing elements are irrelevant, so each one copies the first: three
             ; arbitrary numbers become one number said three times.
             (assert-eq (tape-len sc) 4)
             (assert-eq (tape-val sc 0) 3)
             (assert-eq (tape-val sc 1) 500)
             (assert-eq (tape-val sc 2) 500)
             (assert-eq (tape-val sc 3) 500)
             ; two spans changed, so two property calls — the pass proposes nothing else.
             (assert-eq (sc-calls sc) 2)
             (assert-eq (sc-pass-accepts sc PASS-DEDUPE-SPANS) 2))))

(deftest sort-spans-canonicalises-the-order-of-siblings
         (let [mem (malloc-allocator)
               (mut t) (al-new [Choice] mem)]
           (push! (mut t) CK-LEN 3)
           (push! (mut t) CK-INT 900)
           (push! (mut t) CK-INT 20)
           (push! (mut t) CK-INT 500)
           (let [sc (seed-ctx (primitive/fnptr-of p-unordered) (mut t) 30 100000)]
             (assert (pass-sort-spans sc))
             ; the property does not care about order, so the elements come out ascending
             ; and two runs that find this bug report the same list.
             (assert-eq (tape-len sc) 4)
             (assert-eq (tape-val sc 1) 20)
             (assert-eq (tape-val sc 2) 500)
             (assert-eq (tape-val sc 3) 900)
             (assert-eq (sc-calls sc) 2)
             (assert-eq (sc-pass-accepts sc PASS-SORT-SPANS) 2))))

(deftest zero-spans-flattens-a-whole-span-in-one-call
         (let [mem (malloc-allocator)
               (mut t) (al-new [Choice] mem)]
           (push! (mut t) CK-LEN 2)
           (push! (mut t) CK-INT 500)
           (push! (mut t) CK-INT 900)
           (let [sc (seed-ctx (primitive/fnptr-of p-head) (mut t) 30 100000)]
             (assert (pass-zero-spans sc))
             (assert-eq (tape-len sc) 3)
             (assert-eq (tape-val sc 0) 2)
             (assert-eq (tape-val sc 1) 500)  ; load-bearing: the property reads it
             (assert-eq (tape-val sc 2) 0)  ; flattened whole, not binary-searched
             ; three spans exist (the list and its two elements) and each costs at most one
             ; candidate; a binary search on that last choice would cost ten.
             (assert (<= (sc-calls sc) 3))
             (assert-eq (sc-pass-accepts sc PASS-ZERO-SPANS) 1))))

(deftest shift-tail-deletes-a-choice-no-span-covers
         (let [mem (malloc-allocator)
               (mut t) (al-new [Choice] mem)]
           ; `p-bare` opens no spans at all, so every span-shaped deletion is a no-op and
           ; the only way to drop the middle choice is to delete it outright.
           (push! (mut t) CK-INT 9)
           (push! (mut t) CK-INT 50)
           (push! (mut t) CK-INT 3)
           (let [sc (seed-ctx (primitive/fnptr-of p-bare) (mut t) 30 100000)]
             (assert (not (pass-delete-spans sc)))
             (assert (pass-shift-tail sc))
             ; the 50 is gone and the tail slid up into its place.
             (assert-eq (tape-len sc) 3)
             (assert-eq (tape-val sc 0) 9)
             (assert-eq (tape-val sc 1) 3)
             (assert-eq (tape-val sc 2) 0)
             (assert (<= (sc-calls sc) 4))
             (assert-eq (sc-pass-accepts sc PASS-SHIFT-TAIL) 1))))

; -------------------------------------------------------------- attribution

(deftest every-accepted-shrink-is-attributed-to-exactly-one-pass
         (let [mem (malloc-allocator)
               (mut t) (al-new [Choice] mem)]
           (push! (mut t) CK-LEN 6)
           (push! (mut t) CK-INT 7)
           (push! (mut t) CK-INT 2)
           (push! (mut t) CK-INT 3)
           (push! (mut t) CK-INT 19)
           (push! (mut t) CK-INT 4)
           (push! (mut t) CK-INT 11)
           (let [sc (seed-ctx (primitive/fnptr-of p-list) (mut t) 30 100000)
                 (mut total) 0
                 (mut i) 0]
             (shrink-run! sc)
             (loop (if (>= (load i) PASS-COUNT)
                       (break)
                       (do
                         (store! total (primitive/iadd (load total) (sc-pass-accepts sc (load i))))
                         (store! i (primitive/iadd (load i) 1)))))
             ; the per-pass counters are the shrink report's only source of truth about
             ; where the work went; if they drift from the total, the report is fiction.
             (assert-eq (load total) (sc-accepted sc))
             (assert (> (sc-accepted sc) 0))
             ; and the names are wired to the right ids.
             (assert (str-eq-bytes (shrink-pass-name PASS-DEDUPE-SPANS) "dedupe-spans"))
             (assert (str-eq-bytes (shrink-pass-name PASS-SHIFT-TAIL) "shift-tail")))))

;; Byte equality, so the name table can be asserted on without pulling in coil.str.
(defn str-eq-bytes [(a (slice u8)) (b (slice u8))] (-> bool)
  (if (!= (slice-len [u8] a) (slice-len [u8] b))
      false
      (let [(mut i) 0
            (mut ok) true]
        (loop (if (or (>= (load i) (slice-len [u8] a)) (not (load ok)))
                  (break)
                  (do
                    (if (= (slice-get [u8] a (load i)) (slice-get [u8] b (load i)))
                        0
                        (set! ok false))
                    (set! i (primitive/iadd (load i) 1)))))
        (load ok))))

; ------------------------------------------------------- atomic spans

;; A generator that draws three ints inside a SPAN-ATOMIC region and one outside
;; it. The property is always false, so the shrinker will take everything it is
;; allowed to take — which is the point: what survives is exactly what the marker
;; protects.
(defn p-atomic [(s (ptr Source))] (-> bool)
  (let [sp (span-open! s "header" SPAN-ATOMIC)]
    (draw-int! s 0 1000)
    (draw-int! s 0 1000)
    (draw-int! s 0 1000)
    (span-close! s sp))
  (let [sp2 (span-open! s "body" SPAN-ELEM)]
    (draw-int! s 0 1000)
    (span-close! s sp2))
  false)

;; `(span-open! s NAME SPAN-ATOMIC)` says "this region only means anything whole",
;; and both structural passes now respect it — hoisting always did, deletion did
;; not, and a marker that stops one pass and not the other is worse than no marker
;; because it looks like it works.
;;
;; ⚠ WHAT THIS TEST CAN AND CANNOT SHOW. Replay is total, so a deleted choice is
;; re-synthesized as its minimum on the next run and the canonical tape comes back
;; the same length either way — the four-choice assertion below would hold with the
;; guard removed. What the guard actually buys is that deletion never proposes a
;; candidate that CUTS INTO the region, so a shrunk tape can never be one whose
;; later choices were read against the wrong constraints (the classic "minimized
;; into an encoding the generator could not produce" failure). That is a property
;; of which candidates are generated, not of the result, and the honest assertion
;; here is the weaker one: the region survives, and its contents still minimize.
(deftest atomic-spans-survive-deletion
         (let [a (malloc-allocator)
               (mut t) (al-new [Choice] a)]
           (push! (mut t) CK-INT 41)
           (push! (mut t) CK-INT 42)
           (push! (mut t) CK-INT 43)
           (push! (mut t) CK-INT 44)
           (let [sc (seed-ctx (primitive/fnptr-of p-atomic) (mut t) 30 100000)]
             (shrink-run! sc)
             ; the generator always draws four choices and the three atomic ones can
             ; never be deleted, so the tape cannot get shorter than four.
             (assert-eq (tape-len sc) 4)
             (assert-eq (tape-val sc 0) 0)
             (assert-eq (tape-val sc 1) 0)
             (assert-eq (tape-val sc 2) 0)
             (assert-eq (tape-val sc 3) 0))))
