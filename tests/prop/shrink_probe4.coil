(module shrink_probe4)
(import "coil.primitive" :as primitive)
(import "coil.assert" :use *)
(import "coil.alloc" :as alloc :use *)
(import "coil.io" :use *)
(import "coil.fmt" :use *)

(defstruct Box [(f (fnptr c [i64] i64)) (n i64)])

(defn double-it [(x i64)] (-> i64) (primitive/imul x 2))

(defn set-f! [(b (ptr Box)) (f (fnptr c [i64] i64))] (-> i64)
  (store! (field b f) f)
  0)

(deftest probe4
  (let [mem (malloc-allocator)
        b (unwrap-ptr [Box] (create [Box] mem))]
    (store! (field b n) 7)
    (do (print-str (stdout) "A\n") 0)
    (set-f! b (primitive/fnptr-of double-it))
    (do (print-str (stdout) "B\n") 0)
    (let [f (load (field b f))]
      (do (fmt (stdout) "f(21)={d}\n" (primitive/call-ptr f 21)) 0))
    (assert true)))
