(module coil.tests.prop.derive)
(import "coil.primitive" :as primitive)
(import "coil.assert" :use *)
(import "coil.alloc" :use *)
(import "coil.arraylist" :use *)
(import "coil.slice" :use *)
(import "coil.io" :as io)
(import "coil.str" :as str)
(import "coil.prop" :use *)
(import "coil.prop.shrink" :use *)
; What `coil.prop.derive` has to be true for: real types, derived both ways, and
; the three properties the design rests on — an empty tape is a valid value, a
; recursive generator terminates, and a failure shrinks to something readable.

; ------------------------------------------------------------------- types
(defstruct Point [(x i64) (y i64)])
(derive Arbitrary Debug Point)

; a struct whose fields are themselves derived structs: the nested impls have to
; be found through the trait, and their spans have to nest.
(defstruct Line [(a Point) (b Point)])
(derive Arbitrary Debug Line)

; every remaining field kind the trait can reach: a string, a bool, a float, and a
; nested sum that is not one of ours.
(defstruct Rec [(name (slice u8)) (flag bool) (ratio f64) (tag (Option i64))])
(derive Arbitrary Debug Rec)

(defsum Color (Red) (Green) (Blue))
(derive Arbitrary Debug Color)

; a sum whose payload is a derived STRUCT: the arm has to build the variant from
; slots filled through the struct's own impl.
(defsum Event (Nothing) (Moved [(from Point) (to Point)]))
(derive Arbitrary Debug Event)

(defsum Shape (Dot) (Circle [(r i64)]) (Rect [(w i64) (h i64)]))
(derive Arbitrary Debug Shape)

;; The one that can run away: `Node` mentions `Tree` behind a pointer, so the
;; derived generator must spend fuel and fall back to `Leaf` when it is gone.
(defsum Tree (Leaf [(v i64)]) (Node [(l (ptr Tree)) (r (ptr Tree))]))
(derive Arbitrary Debug Tree)

(defn tree-size [(t Tree)] (-> i64)
  (match t
    (Leaf [v] 1)
    (Node [l r] (primitive/iadd 1 (primitive/iadd (tree-size (load l)) (tree-size (load r)))))))

(defn tree-depth [(t Tree)] (-> i64)
  (match t
    (Leaf [v] 1)
    (Node [l r]
          (let [dl (tree-depth (load l))
                dr (tree-depth (load r))]
            (primitive/iadd 1 (if (> dl dr) dl dr))))))

; ------------------------------------------------------------------ harness

;; One Source for the whole file, as the runner keeps one per process.
;;
;; This used to repoint the tape, replay and span lists at a private heap
;; allocator, to work around `source-new` handing its caller's `Allocator` cell to
;; `arena-over-buffer` — which overwrites it in place, making the arena and the
;; caller's allocator the same three words. `prop_source.coil` now allocates the
;; arena its own cell, so the split is real and the workaround is gone.
(defn src [] (-> (ptr Source))
  (let [cell (primitive/alloc-static (ptr Source))]
    (if (= (primitive/cast i64 (load cell)) 0)
        (do (set! cell (source-new (malloc-allocator) 1048576 12345)) 0)
        0)
    (load cell)))

;; Render a value through its derived `Debug` into a caller-owned buffer, so a
;; test can assert on the exact text a counterexample report would print.
(defn shown [(T Debug)] [(v T) (buf (ptr i8)) (cap i64)] (-> (slice u8))
  (let [fb (primitive/alloc-stack io/FixBuf)
        w (primitive/alloc-stack io/Writer)]
    (set! (.data fb) buf)
    (set! (.cap fb) cap)
    (set! (.len fb) 0)
    (io/fixed-buffer-writer w fb)
    (debug-write v w)
    (slice-new [u8] (primitive/cast (ptr u8) buf) (.len fb))))

;; Replay the EMPTY tape: every draw overruns and synthesizes its own minimum, so
;; whatever comes out is the floor the shrinker is guaranteed to be able to reach.
(defn begin-minimal [(s (ptr Source))] (-> i64)
  (let [(mut empty) (al-new [Choice] (malloc-allocator))]
    (source-begin-replay! s (mut empty) 30)
    0))

; ------------------------------------------------------------------- tests
;
; ⚠ EVERY MINIMAL-TAPE TEST POISONS ITS DESTINATION FIRST, and that is not
; defensive habit — it is the only thing that makes the assertion mean anything.
; The minimum of a derived type IS its all-zero bit pattern: a zeroed `Point`
; already reads `(Point x=0 y=0)`, a zeroed `Tree` already reads `(Leaf 0)`, a
; zeroed `Color` is already `(Red)`. Assert those against a fresh `(zeroed T)` and
; the test passes with `arbitrary` deleted — it cannot tell "every field was drawn
; and each draw overran the empty tape into its own minimum" from "nothing was
; drawn at all". Writing non-minimal values in first is what turns the string
; comparison into evidence. Verified the hard way: stubbing `pd--field-fill` to
; emit nothing left the un-poisoned versions of these tests green.

(deftest struct-draws-every-field
         (let [s (src)
               (mut p) (zeroed Point)
               buf (primitive/alloc-stack (array u8 256))]
           (source-begin-generate! s 30)
           (arbitrary (mut p) s)
           ; two i64 fields = two choices, inside one span named after the type
           (assert-eq (al-len [Choice] (load (src-tape s))) 2)
           (assert-eq (al-len [Span] (load (src-spans s))) 1)
           (store! (field p x) 7)
           (store! (field p y) 9)
           (begin-minimal s)
           (arbitrary (mut p) s)
           (assert (str/str-eq (shown (load p) (primitive/cast (ptr i8) buf) 256) "(Point :x 0 :y 0)"))))

(deftest struct-minimal-tape-is-all-zero
         (let [s (src)
               (mut p) (zeroed Point)
               buf (primitive/alloc-stack (array u8 256))]
           (store! (field p x) -1)
           (store! (field p y) 12345)
           (begin-minimal s)
           (arbitrary (mut p) s)
           (assert-eq (load (field p x)) 0)
           (assert-eq (load (field p y)) 0)
           (assert (str/str-eq (shown (load p) (primitive/cast (ptr i8) buf) 256) "(Point :x 0 :y 0)"))))

(deftest nested-struct-nests-its-spans
         (let [s (src)
               (mut l) (zeroed Line)
               buf (primitive/alloc-stack (array u8 256))]
           (source-begin-generate! s 30)
           (arbitrary (mut l) s)
           (assert-eq (al-len [Choice] (load (src-tape s))) 4)
           ; the outer Line span plus one Point span per field
           (assert-eq (al-len [Span] (load (src-spans s))) 3)
           (store! (field (field l a) x) 3)
           (store! (field (field l b) y) 4)
           (begin-minimal s)
           (arbitrary (mut l) s)
           (assert (str/str-eq (shown (load l) (primitive/cast (ptr i8) buf) 256)
                               "(Line :a (Point :x 0 :y 0) :b (Point :x 0 :y 0))"))))

;; The generate half is the direction replay cannot cover: replay only proves the
;; minima are reachable, so the loop keeps going until it has SEEN each field at a
;; non-default value. A field the expansion silently skips keeps its poisoned value
;; under replay and never moves under generation — either half catches it.
(deftest mixed-field-kinds-round-through-the-trait
         (let [s (src)
               (mut r) (zeroed Rec)
               buf (primitive/alloc-stack (array u8 256))
               (mut seen) 0
               (mut i) 0]
           (store! (field r name) "poison")
           (store! (field r flag) true)
           (store! (field r ratio) 1.5)
           (store! (field r tag) (Some [i64] 7))
           (begin-minimal s)
           (arbitrary (mut r) s)
           ; empty string, false, +0.0, None — every field at its own minimum
           (assert (str/str-eq (shown (load r) (primitive/cast (ptr i8) buf) 256)
                               "(Rec :name \"\" :flag false :ratio 0.0 :tag (None))"))
           (loop (if (or (>= (load i) 500) (= (load seen) 15))
                     (break)
                     (do
                       (source-begin-generate! s 30)
                       (arbitrary (mut r) s)
                       (if (> (slice-len [u8] (load (field r name))) 0)
                           (store! seen (primitive/ior (load seen) 1))
                           0)
                       (if (load (field r flag)) (store! seen (primitive/ior (load seen) 2)) 0)
                       (if (primitive/fcmp-eq (load (field r ratio)) 0.0)
                           0
                           (store! seen (primitive/ior (load seen) 4)))
                       (match (load (field r tag))
                         (Some [v] (store! seen (primitive/ior (load seen) 8)))
                         (_ 0))
                       (store! i (primitive/iadd (load i) 1))
                       0)))
           ; all four field kinds actually drew: string, bool, float, nested sum
           (assert-eq (load seen) 15)))

(deftest sum-payload-of-derived-structs
         (let [s (src)
               (mut e) (zeroed Event)
               buf (primitive/alloc-stack (array u8 256))
               (mut moved) 0
               (mut i) 0
               (mut pt) (zeroed Point)]
           (store! (field pt x) 5)
           (store! e (Moved (load pt) (load pt)))
           (begin-minimal s)
           (arbitrary (mut e) s)
           (assert (str/str-eq (shown (load e) (primitive/cast (ptr i8) buf) 256) "(Nothing)"))
           (loop (if (or (>= (load i) 200) (> (load moved) 0))
                     (break)
                     (do
                       (source-begin-generate! s 30)
                       (arbitrary (mut e) s)
                       (match (load e) (Moved [a b] (store! moved 1)) (_ 0))
                       (store! i (primitive/iadd (load i) 1))
                       0)))
           (assert-eq (load moved) 1)
           ; the tag plus four i64s, in two nested Point spans inside the Event span
           (assert-eq (al-len [Choice] (load (src-tape s))) 5)
           (assert-eq (al-len [Span] (load (src-spans s))) 3)))

(deftest unit-enum-minimal-tape-is-variant-zero
         (let [s (src)
               (mut c) (zeroed Color)
               buf (primitive/alloc-stack (array u8 64))]
           (store! c (Blue))
           (begin-minimal s)
           (arbitrary (mut c) s)
           (assert (str/str-eq (shown (load c) (primitive/cast (ptr i8) buf) 64) "(Red)"))
           ; a unit-only sum costs exactly one choice: the tag
           (assert-eq (al-len [Choice] (load (src-tape s))) 1)))

(deftest unit-enum-reaches-every-variant
         (let [s (src)
               (mut c) (zeroed Color)
               (mut seen) 0
               (mut i) 0]
           (loop (if (>= (load i) 200)
                     (break)
                     (do
                       (source-begin-generate! s 30)
                       (arbitrary (mut c) s)
                       (store! seen
                               (primitive/ior (load seen)
                                              (primitive/ishl 1 (match (load c) (Red [] 0) (Green [] 1) (Blue [] 2)))))
                       (store! i (primitive/iadd (load i) 1))
                       0)))
           (assert-eq (load seen) 7)))

(deftest sum-payloads-are-drawn-and-shown
         (let [s (src)
               (mut sh) (zeroed Shape)
               buf (primitive/alloc-stack (array u8 256))
               (mut rects) 0
               (mut i) 0]
           (store! sh (Rect 5 6))
           (begin-minimal s)
           (arbitrary (mut sh) s)
           (assert (str/str-eq (shown (load sh) (primitive/cast (ptr i8) buf) 256) "(Dot)"))
           ; a Rect draws its tag plus both payload fields, and prints them positionally
           (loop (if (or (>= (load i) 500) (> (load rects) 0))
                     (break)
                     (do
                       (source-begin-generate! s 30)
                       (arbitrary (mut sh) s)
                       (match (load sh)
                         (Rect [w h] (store! rects 1))
                         (_ 0))
                       (store! i (primitive/iadd (load i) 1))
                       0)))
           (assert-eq (load rects) 1)
           (assert-eq (al-len [Choice] (load (src-tape s))) 3)))

;; The whole point of the fuel logic: a `Node` payload mentions `Tree`, so without
;; it this loop would never return. `size` here is far past the default.
(deftest recursive-sum-terminates-at-large-size
         (let [s (src)
               (mut t) (zeroed Tree)
               (mut biggest) 0
               (mut deepest) 0
               (mut i) 0]
           (loop (if (>= (load i) 300)
                     (break)
                     (do
                       (source-begin-generate! s 400)
                       (arbitrary (mut t) s)
                       (let [n (tree-size (load t))
                             d (tree-depth (load t))]
                         (if (> n (load biggest)) (store! biggest n) 0)
                         (if (> d (load deepest)) (store! deepest d) 0))
                       (store! i (primitive/iadd (load i) 1))
                       0)))
           ; it got somewhere — a "terminating" generator that only ever makes leaves
           ; would pass a liveness test while generating nothing worth testing
           (assert (> (load deepest) 2))
           ; and it stayed bounded: every Node spends a unit of the size budget, so the
           ; node count cannot exceed twice the fuel it started with
           (assert (<= (load biggest) 801))))

;; Poisoned with a real `Node` (both children the same heap `Leaf` — the tree is
;; only read, never freed), so `tree-size` is 3 going in. That is what makes
;; `== 1` evidence that the tag draw ran and overran into variant zero; against a
;; `(zeroed Tree)` — already `(Leaf 0)` — it would be evidence of nothing. The
;; child is heap-allocated rather than a `(mut …)` stack slot because a variant
;; payload field wants a `(ptr T)` and does not take the `(mut …)` coercion a
;; parameter would.
(deftest recursive-sum-minimal-tape-is-a-leaf
         (let [s (src)
               (mut t) (zeroed Tree)
               kid (unwrap-ptr [Tree] (create [Tree] (malloc-allocator)))
               buf (primitive/alloc-stack (array u8 256))]
           (store! kid (Leaf 42))
           (store! t (Node kid kid))
           (assert-eq (tree-size (load t)) 3)
           (begin-minimal s)
           (arbitrary (mut t) s)
           (assert-eq (tree-size (load t)) 1)
           (assert (str/str-eq (shown (load t) (primitive/cast (ptr i8) buf) 256) "(Leaf :v 0)"))))

; ---------------------------------------------------------------- shrinking
; A deliberately false property over the derived generator: "no Tree has more
; than one node". Every Node falsifies it, so the search finds one fast and the
; shrinker has to walk it back to the SMALLEST tree that still does — which is
; the two-leaf Node, printed by the derived Debug.

(defn tree-prop [(s (ptr Source))] (-> bool)
  (let [(mut t) (zeroed Tree)]
    (arbitrary (mut t) s)
    (<= (tree-size (load t)) 1)))

(defstruct TreeRun [(src (ptr Source)) (size i64)])

(defn tree-run-candidate [(ctx (ptr i8)) (tape (ptr (ArrayList Choice)))] (-> bool)
  (let [rc (primitive/cast (ptr TreeRun) ctx)
        s (load (field rc src))]
    (source-begin-replay! s tape (.size rc))
    (not (tree-prop s))))

(deftest false-property-shrinks-to-the-smallest-tree
         (let [mem (malloc-allocator)
               s (src)
               buf (primitive/alloc-stack (array u8 256))
               (mut t) (zeroed Tree)
               (mut found) false
               (mut i) 0]
           ; PHASE 1 — search, exactly as the runner does: generate until the property fails
           (loop (if (or (load found) (>= (load i) 200))
                     (break)
                     (do
                       (source-begin-generate! s (primitive/iadd 1 (load i)))
                       (if (tree-prop s) 0 (store! found true))
                       (store! i (primitive/iadd (load i) 1))
                       0)))
           (assert (load found))
           ; PHASE 2 — shrink the failing tape
           (let [rc (unwrap-ptr [TreeRun] (create [TreeRun] mem))
                 (mut failing) (tape-clone mem (src-tape s))
                 (mut failing-spans) (spans-clone mem (src-spans s))]
             (store! (field rc src) s)
             (store! (field rc size) (src-size s))
             (let [sc (shrink-ctx-new mem s (primitive/fnptr-of tree-run-candidate) (primitive/cast (ptr i8) rc) 20000)]
               (sc-seed-best! sc (mut failing) (mut failing-spans))
               (shrink-run! sc)
               ; PHASE 3 — the minimal counterexample, regenerated from the shrunk tape
               (source-begin-replay! s (sc-best sc) (load (field rc size)))
               (arbitrary (mut t) s)
               (assert-eq (tree-size (load t)) 3)
               (assert (str/str-eq (shown (load t) (primitive/cast (ptr i8) buf) 256)
                                   "(Node :l (Leaf :v 0) :r (Leaf :v 0))"))))))
