; Properties of the Coil standard library — laws, not examples.
;
; Everything here is written the way a user writes a property suite: import
; `coil.prop`, import the library under test, state a law, and let the machine
; hunt. No generator is registered, no shrinker is written; a failing case
; arrives already minimized.
;
;   COIL_STDLIB_DIR=. coil test tests/prop/stdlib_props_test.coil
;
; Each property runs 200 cases by default (COIL_PBT_CASES). Values that need an
; allocator take the case ARENA — `(src-alloc (prop-src))` — which the runner
; rewinds between cases, so nothing here frees anything and nothing leaks.
(module tests.prop.stdlib_props_test)
(import "coil.primitive" :as primitive)
(import "coil.prop" :use *)
(import "coil.arraylist" :use *)
(import "coil.slice" :use *)
(import "coil.str" :use *)
(import "coil.hashmap" :use *)
(import "coil.io" :use *)
(import "coil.serde" :use *)
(import "coil.serde.derive" :use *)
(import "coil.serde.sexp" :use *)
(import "coil.serde.json" :use *)

; ============================================================ shared helpers
; Deliberately naive: a model is only worth testing against if it is obviously
; correct, so these are all O(n²) linear scans rather than anything clever.

(defn imin2 [(a i64) (b i64)] (-> i64)
  (if (< a b) a b))

(defn list-eq-i64 [(a (ArrayList i64)) (b (ArrayList i64))] (-> bool)
  (if (!= (al-len [i64] a) (al-len [i64] b))
      false
      (let [(mut ok) true]
        (for [i 0 (al-len [i64] a)]
          (when (!= (al-get [i64] a i) (al-get [i64] b i))
            (store! ok false)
            0))
        (load ok))))

;; A fresh list holding the same elements as `xs`, built by pushing — the shape
;; every ArrayList property compares against.
(defn copy-list [(s (ptr Source)) (xs (ArrayList i64))] (-> (ArrayList i64))
  (let [(mut l) (al-new [i64] (src-alloc s))]
    (for [i 0 (al-len [i64] xs)]
      (al-push! [i64] (mut l) (al-get [i64] xs i)))
    (load l)))

;; How many times `v` occurs in `xs`. Multiset equality — which is what "is a
;; permutation" means — is this, applied to every element.
(defn count-of [(xs (ArrayList i64)) (v i64)] (-> i64)
  (let [(mut n) 0]
    (for [i 0 (al-len [i64] xs)]
      (when (= (al-get [i64] xs i) v)
        (store! n (primitive/iadd (load n) 1))
        0))
    (load n)))

;; Index of the first `k` in `ks`, or -1. The association-list model every
;; HashMap property is checked against.
(defn model-find [(ks (ArrayList i64)) (k i64)] (-> i64)
  (let [(mut r) -1]
    (for [i 0 (al-len [i64] ks)]
      (when (and (< (load r) 0) (= (al-get [i64] ks i) k))
        (store! r i)
        0))
    (load r)))

;; Drop `k` from the association-list model by shifting the tail down. The
;; HashMap it models uses tombstones and rehashes in place, so the two have
;; nothing in common structurally — which is the point of checking one against
;; the other.
(defn model-remove! [(ks (mut (ArrayList i64))) (vs (mut (ArrayList i64))) (k i64)] (-> i64)
  (let [j (model-find (load ks) k)]
    (if (< j 0)
        0
        (let [n (al-len [i64] (load ks))]
          (for [i j (primitive/isub n 1)]
            (do
              (al-set! [i64] (mut ks) i (al-get [i64] (load ks) (primitive/iadd i 1)))
              (al-set! [i64] (mut vs) i (al-get [i64] (load vs) (primitive/iadd i 1)))
              0))
          (al-pop! [i64] (mut ks))
          (al-pop! [i64] (mut vs))
          0))))

;; Index of the first string equal to `k` by CONTENT, or -1.
(defn model-find-str [(ks (ArrayList (slice u8))) (k (slice u8))] (-> i64)
  (let [(mut r) -1]
    (for [i 0 (al-len [(slice u8)] ks)]
      (when (and (< (load r) 0) (= (al-get [(slice u8)] ks i) k))
        (store! r i)
        0))
    (load r)))

(defn cmp-i64 [(a i64) (b i64)] (-> i64)
  (if (< a b) -1 (if (> a b) 1 0)))

(defn sign-of [(x i64)] (-> i64)
  (if (< x 0) -1 (if (> x 0) 1 0)))

; ================================================================= ArrayList

;; The stack law. `push` then `pop` returns exactly what went in and leaves the
;; list as it was — the single most load-bearing claim ArrayList makes, and the
;; one a reallocation-during-push bug would break.
(defprop al-push-then-pop-roundtrips
         [(xs (ArrayList i64)) (v i64)]
         (let [s (prop-src)
               (mut l) (copy-list s xs)
               n (al-len [i64] xs)]
           (al-push! [i64] (mut l) v)
           (match (al-pop! [i64] (mut l))
             (None [] false)
             (Some [w]
                   (all (= w v)
                        (= (al-len [i64] (load l)) n)
                        (list-eq-i64 (load l) xs))))))

;; `len` counts pushes minus pops, exactly, across a growth boundary. `k` is a
;; u8 so the count is a real number of elements (0–255) rather than something
;; that would time the test out.
(defprop al-len-tracks-pushes-and-pops
         [(xs (ArrayList i64)) (k u8)]
         (let [s (prop-src)
               (mut l) (copy-list s xs)
               n (al-len [i64] xs)
               extra (primitive/cast i64 k)
               (mut ok) true]
           (for [i 0 extra]
             (al-push! [i64] (mut l) i))
           (when (!= (al-len [i64] (load l)) (primitive/iadd n extra))
             (store! ok false)
             0)
           (for [i 0 extra]
             (match (al-pop! [i64] (mut l))
               (None [] (do (store! ok false) 0))
               (Some [w]
                     (when (!= w (primitive/isub (primitive/isub extra 1) i))
                       (store! ok false)
                       0))))
           (all (load ok)
                (= (al-len [i64] (load l)) n)
                (list-eq-i64 (load l) xs))))

;; `get` after `set!` returns what was set, and touches nothing else. The
;; "nothing else" half is the interesting one: an off-by-one in the element
;; address would still pass the first half.
(defprop al-get-after-set
         [(xs (ArrayList i64)) (v i64) (at u8)]
         (let [s (prop-src)
               n (al-len [i64] xs)]
           (if (= n 0)
               true
               (let [i (primitive/irem (primitive/cast i64 at) n)
                     (mut l) (copy-list s xs)
                     (mut ok) true]
                 (al-set! [i64] (mut l) i v)
                 (for [j 0 n]
                   (when (!= (al-get [i64] (load l) j)
                             (if (= j i) v (al-get [i64] xs j)))
                     (store! ok false)
                     0))
                 (all (load ok) (= (al-len [i64] (load l)) n))))))

;; Reserving capacity is invisible from the outside: same length, same elements,
;; and afterwards the capacity really is at least what was asked for. A reserve
;; that copies `cap` elements instead of `len`, or forgets to copy at all, dies
;; here.
(defprop al-reserve-never-loses-elements
         [(xs (ArrayList i64)) (extra u8)]
         (let [s (prop-src)
               (mut l) (copy-list s xs)
               want (primitive/iadd (al-len [i64] xs) (primitive/cast i64 extra))]
           (al-reserve! [i64] (mut l) want)
           (all (list-eq-i64 (load l) xs)
                (>= (al-cap [i64] (load l)) want)
                (>= (al-cap [i64] (load l)) (al-len [i64] (load l))))))

;; `extend!` is bulk `push!` and must agree with it element for element. Two
;; independent lengths, so the shrinker gets to blame whichever one is at fault.
(defprop al-extend-equals-repeated-push
         [(xs (ArrayList i64)) (ys (ArrayList i64))]
         (let [s (prop-src)
               (mut a) (copy-list s xs)
               (mut b) (copy-list s xs)
               ysl (al-slice [i64] ys)]
           (al-extend! [i64] (mut a) (slice-data [i64] ysl) (slice-len [i64] ysl))
           (for [i 0 (al-len [i64] ys)]
             (al-push! [i64] (mut b) (al-get [i64] ys i)))
           (all (list-eq-i64 (load a) (load b))
                (= (al-len [i64] (load a))
                   (primitive/iadd (al-len [i64] xs) (al-len [i64] ys))))))

;; The slice view sees the live elements and nothing past `len` — the capacity
;; slack must not leak into the view.
(defprop al-slice-views-exactly-the-elements
         [(xs (ArrayList i64)) (extra u8)]
         (let [s (prop-src)
               (mut l) (copy-list s xs)
               (mut ok) true]
           (al-reserve! [i64] (mut l) (primitive/iadd (al-len [i64] xs) (primitive/cast i64 extra)))
           (let [v (al-slice [i64] (load l))]
             (for [i 0 (slice-len [i64] v)]
               (when (!= (slice-get [i64] v i) (al-get [i64] xs i))
                 (store! ok false)
                 0))
             (all (load ok) (= (slice-len [i64] v) (al-len [i64] xs))))))

;; After `clear!` the list is empty by every measure, and still usable — the
;; capacity survives but the contents do not.
(defprop al-clear-empties-but-keeps-usable
         [(xs (ArrayList i64)) (v i64)]
         (let [s (prop-src)
               (mut l) (copy-list s xs)]
           (al-clear! [i64] (mut l))
           (let [emptied
                   (all (= (al-len [i64] (load l)) 0)
                        (al-empty? [i64] (load l))
                        (match (al-pop! [i64] (mut l)) (None [] true) (Some [_] false)))]
             (al-push! [i64] (mut l) v)
             (all emptied
                  (= (al-len [i64] (load l)) 1)
                  (= (al-get [i64] (load l) 0) v)))))

; ===================================================================== slice

;; `subslice` has the length it says and the elements it says. `lo`/`hi` are
;; folded into range rather than filtered with `assume`, so every generated case
;; is a real test.
(defprop subslice-bounds-and-elements
         [(xs (ArrayList i64)) (a u8) (b u8)]
         (let [v (al-slice [i64] xs)
               n (slice-len [i64] v)
               p (primitive/irem (primitive/cast i64 a) (primitive/iadd n 1))
               q (primitive/irem (primitive/cast i64 b) (primitive/iadd n 1))
               lo (imin2 p q)
               hi (if (< p q) q p)
               w (subslice [i64] v lo hi)
               (mut ok) true]
           (for [i 0 (slice-len [i64] w)]
             (when (!= (slice-get [i64] w i) (slice-get [i64] v (primitive/iadd lo i)))
               (store! ok false)
               0))
           (all (load ok) (= (slice-len [i64] w) (primitive/isub hi lo)))))

;; Subslicing composes: a window into a window is a window into the original at
;; the summed offset. This is the law an interior-pointer arithmetic bug breaks.
(defprop subslice-composes
         [(xs (ArrayList i64)) (a u8) (b u8) (c u8)]
         (let [v (al-slice [i64] xs)
               n (slice-len [i64] v)
               lo (primitive/irem (primitive/cast i64 a) (primitive/iadd n 1))
               w (subslice [i64] v lo n)
               m (slice-len [i64] w)
               p (primitive/irem (primitive/cast i64 b) (primitive/iadd m 1))
               q (primitive/irem (primitive/cast i64 c) (primitive/iadd m 1))
               i0 (imin2 p q)
               i1 (if (< p q) q p)
               inner (subslice [i64] w i0 i1)
               direct (subslice [i64] v (primitive/iadd lo i0) (primitive/iadd lo i1))
               (mut ok) true]
           (for [i 0 (slice-len [i64] inner)]
             (when (!= (slice-get [i64] inner i) (slice-get [i64] direct i))
               (store! ok false)
               0))
           (all (load ok)
                (= (slice-len [i64] inner) (slice-len [i64] direct))
                (= (primitive/cast i64 (slice-data [i64] inner))
                   (primitive/cast i64 (slice-data [i64] direct))))))

;; `sort` produces a sorted PERMUTATION. Sortedness alone is satisfied by a
;; function that returns zeros, so the multiset check is the half that matters.
(defprop sort-yields-sorted-permutation
         [(xs (ArrayList i64))]
         (let [s (prop-src)
               (mut l) (copy-list s xs)
               v (al-slice [i64] (load l))
               (mut ok) true]
           (sort [i64] v (primitive/fnptr-of cmp-i64))
           (for [i 1 (slice-len [i64] v)]
             (when (> (slice-get [i64] v (primitive/isub i 1)) (slice-get [i64] v i))
               (store! ok false)
               0))
           (for [i 0 (al-len [i64] xs)]
             (let [e (al-get [i64] xs i)]
               (when (!= (count-of xs e) (count-of (load l) e))
                 (store! ok false)
                 0)))
           (all (load ok) (= (al-len [i64] (load l)) (al-len [i64] xs)))))

; ======================================================================= str
; `=` on two `(slice u8)` IS `str-eq` — coil.str's `Eq` impl is a call to it —
; so the properties below test `str-eq` even though none of them names it. The
; operator is the spelling the linter wants and the one users write.

;; Splitting a string anywhere and concatenating the halves gives it back. The
;; one-line statement of "substr and concat agree about what a string is".
(defprop str-substr-halves-concat-to-whole
         [(s (slice u8)) (at u8)]
         (let [a (src-alloc (prop-src))
               n (str-len s)
               i (primitive/irem (primitive/cast i64 at) (primitive/iadd n 1))]
           (match (str-concat a (substr s 0 i) (substr s i n))
             (None [] false)
             (Some [j]
                   (all (= j s)
                        (= (str-len j) n)
                        (= (str-cmp j s) 0))))))

;; Equal strings hash equally — the contract every hash container depends on,
;; and it must hold for two strings that share no storage. The copy is what
;; makes this a real test: comparing `s` with itself would pass under a hash
;; that returned the address.
(defprop str-equal-strings-hash-equally
         [(s (slice u8))]
         (let [a (src-alloc (prop-src))
               (mut b) (sb-new a)]
           (sb-push-str! (mut b) s)
           (let [t (sb-str (load b))]
             (all (= t s)
                  (= (str-hash t) (str-hash s))
                  (= (str-cmp t s) 0)
                  (!= (primitive/cast i64 (slice-data [u8] t))
                      (primitive/cast i64 (slice-data [u8] s)))))))

;; `str-cmp` is a total order consistent with `str-eq`: antisymmetric in sign,
;; zero exactly on equal strings, and agreeing with prefix order.
(defprop str-cmp-is-antisymmetric-and-agrees-with-eq
         [(x (slice u8)) (y (slice u8))]
         (all (= (sign-of (str-cmp x y)) (primitive/isub 0 (sign-of (str-cmp y x))))
              (= (= (str-cmp x y) 0) (= x y))
              (= (str-cmp x x) 0)))

;; `str-find` returns the FIRST occurrence: the needle really is there, and it
;; is nowhere earlier. A find that returns `None` claims the needle is nowhere,
;; which is checked by the same scan.
(defprop str-find-returns-first-occurrence
         [(hay (slice u8)) (needle (slice u8))]
         (let [h (str-len hay)
               k (str-len needle)
               (mut expect) -1]
           ; a needle longer than the haystack makes this range empty, which is the
           ; right answer: `expect` stays -1 and the property demands `None`
           (for [i 0 (primitive/iadd (primitive/isub h k) 1)]
             (when (and (< (load expect) 0) (= (substr hay i (primitive/iadd i k)) needle))
               (store! expect i)
               0))
           (match (str-find hay needle)
             (None [] (< (load expect) 0))
             (Some [i]
                   (and (= i (load expect))
                        (= (substr hay i (primitive/iadd i k)) needle))))))

;; The same law, but with a needle that is guaranteed to be there — cut straight
;; out of the haystack. Random needles almost never match, so without this the
;; property above would be testing `None` and nothing else.
(defprop str-find-locates-an-embedded-needle
         [(hay (slice u8)) (a u8) (b u8)]
         (let [n (str-len hay)
               p (primitive/irem (primitive/cast i64 a) (primitive/iadd n 1))
               q (primitive/irem (primitive/cast i64 b) (primitive/iadd n 1))
               lo (imin2 p q)
               hi (if (< p q) q p)
               needle (substr hay lo hi)
               k (primitive/isub hi lo)]
           (match (str-find hay needle)
             (None [] false)
             (Some [i]
                   (all (<= i lo)
                        (= (substr hay i (primitive/iadd i k)) needle)
                        (starts-with (substr hay i n) needle))))))

;; `starts-with` is exactly "the first occurrence is at 0".
(defprop str-starts-with-iff-found-at-zero
         [(hay (slice u8)) (needle (slice u8))]
         (= (starts-with hay needle)
            (match (str-find hay needle)
              (None [] false)
              (Some [i] (= i 0)))))

;; Trimming is idempotent, never grows the string, and leaves no whitespace at
;; either end — the three claims together pin the function down.
(defprop str-trim-is-idempotent-and-tight
         [(s (slice u8))]
         (let [t (str-trim s)
               n (str-len t)]
           (all (= (str-trim t) t)
                (<= n (str-len s))
                (if (= n 0) true (not (str-ws? (char-at t 0))))
                (if (= n 0) true (not (str-ws? (char-at t (primitive/isub n 1))))))))

;; Rendering an integer and parsing it back is the identity — over the WHOLE
;; i64 range, i64::MIN included. `str-parse-int` accumulates with wrapping
;; arithmetic and negates at the end, and the wrap is exactly what makes MIN
;; come out right; the edge-case pool draws MIN deliberately, so this property
;; is really testing that.
(defprop str-parse-int-roundtrips-every-i64
         [(n i64)]
         (let [a (src-alloc (prop-src))
               (mut b) (sb-new a)
               (mut digits) (al-new [u8] a)
               (mut m) n]
           (when (< n 0) (sb-push-byte! (mut b) (primitive/cast u8 45)) 0)
           ; build the digits on the NEGATIVE side: |i64::MIN| is not representable, so
           ; a magnitude-first renderer cannot print it.
           (when (> (load m) 0) (store! m (primitive/isub 0 (load m))) 0)
           (loop (do
                   (al-push! [u8]
                             (mut digits)
                             (primitive/cast u8 (primitive/iadd 48 (primitive/isub 0 (primitive/irem (load m) 10)))))
                   (store! m (primitive/idiv (load m) 10))
                   (if (= (load m) 0) (break) 0)))
           (let [k (al-len [u8] (load digits))]
             (for [i 0 k]
               (sb-push-byte! (mut b) (al-get [u8] (load digits) (primitive/isub (primitive/isub k 1) i)))))
           (match (str-parse-int (sb-str (load b)))
             (None [] false)
             (Some [v] (= v n)))))

;; `str-parse-int` accepts exactly `-?[0-9]+` and, when it accepts, agrees with a
;; hand-rolled parser. Both halves of the judgement are claimed: `None` means the
;; hand parser also rejected, `Some` means it also accepted AND got the same
;; number, so "returns None on invalid input" is under test rather than assumed.
;;
;; The value half is only claimed for ≤18 digits, because the library documents
;; itself as having no overflow check: past that the two parsers agree only on
;; the wrap, which is not a law worth pinning.
;;
;; A function, not a property body, because two properties feed it inputs from
;; two different distributions — see the alphabet property below.
(defn parse-int-agrees? [(s (slice u8))] (-> bool)
  (let [n (str-len s)
        neg (if (= n 0) false (= (primitive/cast i64 (char-at s 0)) 45))
        start (if neg 1 0)
        (mut valid) (> n start)
        (mut acc) 0
        (mut ndigits) 0]
    (for [i start n]
      (let [c (primitive/cast i64 (char-at s i))]
        (if (and (>= c 48) (<= c 57))
            (do
              (store! acc (primitive/iadd (primitive/imul (load acc) 10) (primitive/isub c 48)))
              (store! ndigits (primitive/iadd (load ndigits) 1))
              0)
            (do (store! valid false) 0))))
    (let [want (if neg (primitive/isub 0 (load acc)) (load acc))]
      (match (str-parse-int s)
        (None [] (not (load valid)))
        (Some [v]
              (and (load valid)
                   (if (<= (load ndigits) 18) (= v want) true)))))))

(defprop str-parse-int-agrees-with-hand-parser
         [(s (slice u8))]
         (parse-int-agrees? s))

;; The same law over an alphabet of `-`, digits and one junk byte, because the
;; default `(slice u8)` generator does not reach the grammar boundary often
;; enough to be relied on. Measured: the one-byte string "-" — the input that
;; separates "a sign needs digits after it" from "a sign is a number" — shows up
;; at the default case count on roughly a third of seeds. A bug in the lone-sign
;; check is therefore invisible to the property above two runs out of three.
;;
;; Drawing bytes from a 12-symbol alphabet instead makes "-", "--", "1-2" and
;; "-0" ordinary rather than freak, so the sign rules are tested every run. The
;; junk byte is kept so rejection stays under test on this path too.
(defprop str-parse-int-grammar-over-numeric-alphabet
         [(bs (ArrayList u8))]
         (let [a (src-alloc (prop-src))
               alphabet "-0123456789x"
               (mut b) (sb-new a)]
           (for [i 0 (al-len [u8] bs)]
             (sb-push-byte! (mut b)
                            (char-at alphabet
                                     (primitive/irem (primitive/cast i64 (al-get [u8] bs i)) 12))))
           (parse-int-agrees? (sb-str (load b)))))

;; Splitting on a separator and rejoining with it reconstructs the original —
;; the round-trip that says `str-split` neither drops nor duplicates bytes,
;; including the empty pieces that adjacent separators produce.
;;
;; The separator is a byte lifted OUT of `s` whenever `s` is non-empty. A random
;; separator would almost never occur, and a split that never splits proves
;; nothing; this way most cases exercise several pieces.
(defprop str-split-then-join-roundtrips
         [(s (slice u8)) (sep u8)]
         (let [a (src-alloc (prop-src))
               (mut sepbuf) (sb-new a)
               n (str-len s)]
           (sb-push-byte! (mut sepbuf)
                          (if (= n 0)
                              (primitive/cast u8 (primitive/iadd 32 (primitive/irem (primitive/cast i64 sep) 95)))
                              (char-at s (primitive/irem (primitive/cast i64 sep) n))))
           (let [sp (sb-str (load sepbuf))
                 parts (str-split a s sp)
                 (mut out) (sb-new a)]
             (for [i 0 (al-len [(slice u8)] parts)]
               (do
                 (when (> i 0) (sb-push-str! (mut out) sp) 0)
                 (sb-push-str! (mut out) (al-get [(slice u8)] parts i))
                 0))
             (all (= (sb-str (load out)) s)
                  (>= (al-len [(slice u8)] parts) 1)))))

; =================================================================== HashMap
; Keys are folded into a small space (mod 8 or 16) on purpose. A map only gets
; interesting when keys COLLIDE and slots get reused, and 64-bit random keys
; collide never; a tight key space makes probe sequences, tombstones and
; rehash-in-place the common path rather than the rare one.

;; `put` then `get` returns the value, `len` counts DISTINCT keys, and a key
;; never inserted is absent. The last clause is what stops a map that answers
;; `Some` for everything from passing.
(defprop hm-put-then-get-and-len-counts-distinct-keys
         [(ks (ArrayList u8)) (vs (ArrayList i64))]
         (let [s (prop-src)
               a (src-alloc s)
               (mut m) (hm-new-scalar [i64 i64] a)
               (mut mk) (al-new [i64] a)
               (mut mv) (al-new [i64] a)
               n (imin2 (al-len [u8] ks) (al-len [i64] vs))
               (mut ok) true]
           (for [i 0 n]
             (let [k (primitive/irem (primitive/cast i64 (al-get [u8] ks i)) 16)
                   v (al-get [i64] vs i)]
               (hm-put! [i64 i64] (mut m) k v)
               (let [j (model-find (load mk) k)]
                 (if (< j 0)
                     (do (al-push! [i64] (mut mk) k) (al-push! [i64] (mut mv) v) 0)
                     (do (al-set! [i64] (mut mv) j v) 0)))))
           (for [i 0 (al-len [i64] (load mk))]
             (match (hm-get [i64 i64] (load m) (al-get [i64] (load mk) i))
               (None [] (do (store! ok false) 0))
               (Some [v] (when (!= v (al-get [i64] (load mv) i)) (store! ok false) 0))))
           ; keys outside the model must be absent — including the ones just outside
           ; the folded key space, where an off-by-one probe would land
           (for [k 0 20]
             (when (and (< (model-find (load mk) k) 0) (hm-contains? [i64 i64] (load m) k))
               (store! ok false)
               0))
           (all (load ok)
                (= (hm-len [i64 i64] (load m)) (al-len [i64] (load mk))))))

;; Putting the same key twice OVERWRITES: the second value wins and the length
;; does not move. A map that appended instead of replacing would still answer
;; `get` correctly if it probed in insertion order, so the length check is the
;; real assertion here.
(defprop hm-put-same-key-twice-overwrites
         [(k u8) (v1 i64) (v2 i64)]
         (let [a (src-alloc (prop-src))
               (mut m) (hm-new-scalar [i64 i64] a)
               key (primitive/cast i64 k)]
           (hm-put! [i64 i64] (mut m) key v1)
           (let [after-first (hm-len [i64 i64] (load m))]
             (hm-put! [i64 i64] (mut m) key v2)
             (all (= after-first 1)
                  (= (hm-len [i64 i64] (load m)) 1)
                  (match (hm-get [i64 i64] (load m) key)
                    (None [] false)
                    (Some [v] (= v v2)))))))

;; The one that earns its keep: a random sequence of puts and removes, checked
;; against an association list. Tombstones, probe-chain repair and the
;; rehash-same-size path that clears them are all only reachable through churn,
;; and every one of them can silently lose or resurrect an entry.
(defprop hm-matches-model-under-put-remove-churn
         [(kinds (ArrayList bool)) (ks (ArrayList u8)) (vs (ArrayList i64))]
         (let [s (prop-src)
               a (src-alloc s)
               (mut m) (hm-new-scalar [i64 i64] a)
               (mut mk) (al-new [i64] a)
               (mut mv) (al-new [i64] a)
               n (imin2 (al-len [bool] kinds) (imin2 (al-len [u8] ks) (al-len [i64] vs)))
               (mut ok) true]
           (for [i 0 n]
             (let [k (primitive/irem (primitive/cast i64 (al-get [u8] ks i)) 8)
                   v (al-get [i64] vs i)]
               (if (al-get [bool] kinds i)
                   (do
                     (hm-put! [i64 i64] (mut m) k v)
                     (let [j (model-find (load mk) k)]
                       (if (< j 0)
                           (do (al-push! [i64] (mut mk) k) (al-push! [i64] (mut mv) v) 0)
                           (do (al-set! [i64] (mut mv) j v) 0))))
                   (do
                     (hm-remove! [i64 i64] (mut m) k)
                     (model-remove! (mut mk) (mut mv) k)
                     0))
               ; check after EVERY operation, not just at the end: a shrunk
               ; counterexample then names the first op that diverged
               (for [key 0 8]
                 (let [j (model-find (load mk) key)]
                   (match (hm-get [i64 i64] (load m) key)
                     (None [] (when (>= j 0) (store! ok false) 0))
                     (Some [got]
                           (when (or (< j 0) (!= got (al-get [i64] (load mv) j)))
                             (store! ok false)
                             0)))))
               (when (!= (hm-len [i64 i64] (load m)) (al-len [i64] (load mk)))
                 (store! ok false)
                 0)))
           (load ok)))

;; Iteration visits every live key EXACTLY once, with its current value, and
;; visits nothing else. Slot-order iteration over an open-addressed table is
;; where a forgotten tombstone check shows up as a duplicate or a ghost.
(defprop hm-for-visits-every-key-exactly-once
         [(ks (ArrayList u8)) (vs (ArrayList i64))]
         (let [s (prop-src)
               a (src-alloc s)
               (mut m) (hm-new-scalar [i64 i64] a)
               (mut seen) (al-new [i64] a)
               n (imin2 (al-len [u8] ks) (al-len [i64] vs))
               (mut ok) true
               (mut visits) 0]
           (for [k 0 16]
             (al-push! [i64] (mut seen) 0))
           (for [i 0 n]
             (hm-put! [i64 i64]
                      (mut m)
                      (primitive/irem (primitive/cast i64 (al-get [u8] ks i)) 16)
                      (al-get [i64] vs i)))
           ; remove a few, so the table carries tombstones while it is walked
           (for [i 0 n]
             (when (= (primitive/irem i 3) 0)
               (hm-remove! [i64 i64]
                           (mut m)
                           (primitive/irem (primitive/cast i64 (al-get [u8] ks i)) 16))
               0))
           (hm-for [k v (mut m)]
                   (do
                     (store! visits (primitive/iadd (load visits) 1))
                     (if (or (< k 0) (>= k 16))
                         (do (store! ok false) 0)
                         (do
                           (al-set! [i64] (mut seen) k (primitive/iadd (al-get [i64] (load seen) k) 1))
                           (match (hm-get [i64 i64] (load m) k)
                             (None [] (do (store! ok false) 0))
                             (Some [got] (when (!= got v) (store! ok false) 0)))))))
           (for [k 0 16]
             (let [c (al-get [i64] (load seen) k)]
               (when (!= c (if (hm-contains? [i64 i64] (load m) k) 1 0))
                 (store! ok false)
                 0)))
           (all (load ok) (= (load visits) (hm-len [i64 i64] (load m))))))

;; String keys are OWNED: `str-keyops` deep-copies a key on insert, so the map
;; keeps working after the caller's bytes are overwritten. This is the footgun
;; the owning keyops exists to close, and the only way to test it is to actually
;; scribble on the buffer afterwards.
(defprop hm-string-keys-survive-their-buffers
         [(strs (ArrayList (slice u8)))]
         (let [s (prop-src)
               a (src-alloc s)
               (mut m) (hm-new [(slice u8) i64] a (str-keyops))
               (mut mk) (al-new [(slice u8)] a)
               (mut mv) (al-new [i64] a)
               n (al-len [(slice u8)] strs)
               (mut ok) true]
           (for [i 0 n]
             (let [orig (al-get [(slice u8)] strs i)
                   (mut b) (sb-new a)]
               (sb-push-str! (mut b) orig)
               (let [k (sb-str (load b))]
                 (hm-put! [(slice u8) i64] (mut m) k i)
                 ; the model keeps the ORIGINAL bytes; the map only ever saw the copy
                 (let [j (model-find-str (load mk) orig)]
                   (if (< j 0)
                       (do (al-push! [(slice u8)] (mut mk) orig) (al-push! [i64] (mut mv) i) 0)
                       (do (al-set! [i64] (mut mv) j i) 0)))
                 ; scribble over the bytes the caller handed in
                 (for [j 0 (slice-len [u8] k)]
                   (slice-set! [u8] k j (primitive/cast u8 33))))))
           (for [i 0 (al-len [(slice u8)] (load mk))]
             (match (hm-get [(slice u8) i64] (load m) (al-get [(slice u8)] (load mk) i))
               (None [] (do (store! ok false) 0))
               (Some [v] (when (!= v (al-get [i64] (load mv) i)) (store! ok false) 0))))
           (all (load ok)
                (= (hm-len [(slice u8) i64] (load m)) (al-len [(slice u8)] (load mk))))))

; ======================================================== serde round-trips
; `(derive-serde T)` writes the encoder and decoder; the law is that they are
; inverses. A round-trip property is the cheapest way to test a codec, because
; it needs no expected output — and it covers the cases nobody writes by hand:
; a name containing a quote, an empty list, `None`, i64::MIN.

(defstruct Rec
  [(id i64)
   (name (slice u8))
   (flag bool)
   (nick (Option i64))
   (tags (ArrayList i64))])
(derive-serde Rec)

;; The `Arbitrary` override path, exactly as a user reaches for it: one impl for
;; a user type, each field drawn through the field type's own `Arbitrary`. The
;; span makes the fields independently shrinkable, so a counterexample blames
;; one field rather than collapsing the whole record.
;;
;; Written out by hand on purpose. A derived impl is what most types will use,
;; but the hand-written one is the escape hatch every property suite eventually
;; needs, and it is the path that most needs an acceptance test — this file is
;; that test. Note the slot-filling signature: `arbitrary` writes into a
;; caller-owned slot rather than returning `Self`, so trait dispatch has an
;; argument to dispatch on.
(impl Arbitrary Rec
  (arbitrary [(out (mut Rec)) (s (ptr Source))]
             (-> i64)
             (let [sp (span-open! s "Rec" SPAN-PLAIN)
                   idp (primitive/alloc-stack i64)
                   namep (primitive/alloc-stack (slice u8))
                   flagp (primitive/alloc-stack bool)
                   nickp (primitive/alloc-stack (Option i64))
                   tagsp (primitive/alloc-stack (ArrayList i64))]
               (arbitrary idp s)
               (arbitrary namep s)
               (arbitrary flagp s)
               (arbitrary nickp s)
               (arbitrary tagsp s)
               (store! (field out id) (load idp))
               (store! (field out name) (load namep))
               (store! (field out flag) (load flagp))
               (store! (field out nick) (load nickp))
               (store! (field out tags) (load tagsp))
               (span-close! s sp)
               0)))

;; Counterexamples are only useful if they can be read back, so `Rec` prints as
;; something close to the literal that would rebuild it.
(impl PropShow Rec
  (prop-show [(x Rec) (w (ptr Writer))]
             (-> i64)
             (print-str w "(Rec id ")
             (prop-show (load (field x id)) w)
             (print-str w " name ")
             (prop-show (load (field x name)) w)
             (print-str w " flag ")
             (prop-show (load (field x flag)) w)
             (print-str w " nick ")
             (prop-show (load (field x nick)) w)
             (print-str w " tags ")
             (prop-show (load (field x tags)) w)
             (print-str w ")")
             0))

(defn rec-eq [(x Rec) (y Rec)] (-> bool)
  (all (= (load (field x id)) (load (field y id)))
       (= (load (field x name)) (load (field y name)))
       (= (load (field x flag)) (load (field y flag)))
       (match (load (field x nick))
         (None [] (match (load (field y nick)) (None [] true) (Some [_] false)))
         (Some [a] (match (load (field y nick)) (None [] false) (Some [b] (= a b)))))
       (list-eq-i64 (load (field x tags)) (load (field y tags)))))

;; The scalar round-trip, and the reason this file exists: it FAILED when it was
;; written, and the failure was a real defect. `coil.fmt/print-i` negated before
;; printing, `(isub 0 i64::MIN)` wraps back to i64::MIN, and `print-int`'s `n <
;; 10` base case then emitted one byte — so i64::MIN encoded as the two bytes
;; "-0" and decoded back as 0, in both serde backends, with no error anywhere.
;; Fixed in `src/stdlib/fmt.coil` (commit 7698159) by printing the magnitude
;; through the unsigned path; write-up in FOUND_BUGS.md #1.
;;
;; Kept as the regression test. It is the SCALAR form of the law because that is
;; the smallest statement of the bug — the derived-struct properties below found
;; it first, but they shrank to a whole `Rec` with one field at `-0`, which is a
;; much harder counterexample to read.
(defprop sexp-i64-roundtrips-every-value
         [(n i64)]
         (let [a (src-alloc (prop-src))]
           (match (to-sexp-str [i64] a n)
             (Err [_] false)
             (Ok [text]
                 (match (from-sexp [i64] a text)
                   (Err [_] false)
                   (Ok [back] (= back n)))))))

;; `from-sexp ∘ to-sexp-str = id` for a derived type. sexp is the format the
;; design intends counterexamples to be pinned in, so this round-trip is what
;; makes a saved regression fixture trustworthy.
;;
;; `r` goes in unmodified. While the i64::MIN bug was open this took a filtered
;; copy that mapped MIN to MIN+1, so the rest of the codec stayed under test
;; instead of going dark behind one broken value; that narrowing is gone now
;; that the bug is fixed, and the law is stated at full strength.
(defprop sexp-encode-then-decode-is-identity
         [(r Rec)]
         (let [a (src-alloc (prop-src))]
           (match (to-sexp-str [Rec] a r)
             (Err [_] false)
             (Ok [text]
                 (match (from-sexp [Rec] a text)
                   (Err [_] false)
                   (Ok [back] (rec-eq back r)))))))

;; The same law for JSON. Two formats over one derive: a bug in the shared
;; reflection shows up in both, a bug in one backend shows up in one.
(defprop json-encode-then-decode-is-identity
         [(r Rec)]
         (let [a (src-alloc (prop-src))]
           (match (to-json-str [Rec] a r)
             (Err [_] false)
             (Ok [text]
                 (match (from-json [Rec] a text)
                   (Err [_] false)
                   (Ok [back] (rec-eq back r)))))))

;; Encoding is a FUNCTION: equal values encode to equal bytes. Without this, a
;; round-trip can hold while the encoder leaks uninitialized padding — which is
;; exactly what makes a wire format non-reproducible.
(defprop sexp-encoding-is-deterministic
         [(r Rec)]
         (let [a (src-alloc (prop-src))]
           (match (to-sexp-str [Rec] a r)
             (Err [_] false)
             (Ok [t1]
                 (match (to-sexp-str [Rec] a r)
                   (Err [_] false)
                   (Ok [t2] (= t1 t2)))))))
