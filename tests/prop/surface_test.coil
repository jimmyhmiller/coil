(module coil.tests.prop.surface)
;; Only the names this file uses: `defprop` must not need `Source` or anything
;; else from coil.prop in scope where it expands.
(import "coil.prop" :use [defprop prop-src prop-note assume arb-int-range])
(import "coil.prop.source" :as source)

;; A generator helper outside any property body: `(prop-src)` is the running
;; property's Source wherever the property's call reaches.
(defn small [] (-> i64)
  (arb-int-range (prop-src) 0 10))

(defprop helpers-draw-from-the-running-property [(a i64)]
  (assume (> a 0))
  (let [x (small)
        y (prop-note "y" (small))]
    (and (>= x 0) (<= x 10) (>= y 0) (<= y 10))))

(defprop the-source-is-the-one-passed-in []
  (let [s (prop-src)]
    (= (source/src-size s) (source/src-size (prop-src)))))
