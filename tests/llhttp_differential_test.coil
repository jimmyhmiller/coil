(module llhttp-differential-test)
(import "../src/stdlib/llhttp.coil" :as ll :use [HTTP_REQUEST HPE_OK HPE_PAUSED])
(import "../src/stdlib/llhttp_types.coil" :as types)
(import "../src/stdlib/alloc.coil" :as alloc)
(import "../src/stdlib/str.coil" :as str)
(import "primitive.coil" :as primitive)
(import "slice.coil" :as slice)

; Native llhttp 9.4.3 is linked only into this differential oracle test.
(extern coil_llhttp_parse_request :cc c [(ptr u8) i64] (-> (ptr i8)))
(extern coil_llhttp_result_free :cc c [(ptr i8)] (-> void))
(extern coil_llhttp_status :cc c [(ptr i8)] (-> i64))
(extern coil_llhttp_error_code :cc c [(ptr i8)] (-> i64))
(extern coil_llhttp_error_offset :cc c [(ptr i8)] (-> i64))
(extern coil_llhttp_http_major :cc c [(ptr i8)] (-> i64))
(extern coil_llhttp_http_minor :cc c [(ptr i8)] (-> i64))
(extern coil_llhttp_keep_alive :cc c [(ptr i8)] (-> i64))
(extern coil_llhttp_header_count :cc c [(ptr i8)] (-> i64))
(extern coil_llhttp_method_len :cc c [(ptr i8)] (-> i64))
(extern coil_llhttp_target_len :cc c [(ptr i8)] (-> i64))
(extern coil_llhttp_body_len :cc c [(ptr i8)] (-> i64))

(defstruct Trace
  [(method-len i64)
   (target-len i64)
   (body-len i64)
   (header-count i64)
   (keep-alive i64)
   (complete i64)])

; Expand `~` markers to CRLF without relying on source string escapes.
(defn wire [(template (slice u8))] (-> (slice u8))
  (let [(mut out) (str/sb-new (alloc/malloc-allocator))
        (mut i) 0]
    (loop
      (if (primitive/icmp-ge (primitive/load i) (slice/slice-len template))
          (break)
          (do
            (let [byte (str/char-at template (primitive/load i))]
              (if (primitive/icmp-eq (primitive/cast i64 byte) 126)
                  (do
                    (str/sb-push-byte! (mut out) (primitive/cast u8 13))
                    (str/sb-push-byte! (mut out) (primitive/cast u8 10)))
                  (str/sb-push-byte! (mut out) byte)))
            (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
    (str/sb-str out)))

(defn trace-of [(p (ptr types/Parser))] (-> (ptr Trace))
  (primitive/cast (ptr Trace) (primitive/load (primitive/field p data))))

(defn on-method [(p (ptr types/Parser)) (at (ptr u8)) (len i64)] (-> i64)
  (let [t (trace-of p)]
    (primitive/store! (primitive/field t method-len)
      (primitive/iadd (primitive/load (primitive/field t method-len)) len)))
  0)

(defn on-url [(p (ptr types/Parser)) (at (ptr u8)) (len i64)] (-> i64)
  (let [t (trace-of p)]
    (primitive/store! (primitive/field t target-len)
      (primitive/iadd (primitive/load (primitive/field t target-len)) len)))
  0)

(defn on-body [(p (ptr types/Parser)) (at (ptr u8)) (len i64)] (-> i64)
  (let [t (trace-of p)]
    (primitive/store! (primitive/field t body-len)
      (primitive/iadd (primitive/load (primitive/field t body-len)) len)))
  0)

(defn on-header-value-complete [(p (ptr types/Parser))] (-> i64)
  (let [t (trace-of p)]
    (primitive/store! (primitive/field t header-count)
      (primitive/iadd (primitive/load (primitive/field t header-count)) 1)))
  0)

(defn on-headers-complete [(p (ptr types/Parser))] (-> i64)
  (primitive/store! (primitive/field (trace-of p) keep-alive)
    (if (ll/should-keep-alive? p) 1 0))
  0)

(defn on-message-complete [(p (ptr types/Parser))] (-> i64)
  (primitive/store! (primitive/field (trace-of p) complete) 1)
  HPE_PAUSED)

(defn configure [(s (ptr types/Settings))] (-> i64)
  (ll/settings-init s)
  (ll/set-span-callback! s 4 (primitive/fnptr-of on-method))
  (ll/set-span-callback! s 2 (primitive/fnptr-of on-url))
  (ll/set-span-callback! s 11 (primitive/fnptr-of on-body))
  (ll/set-simple-callback! s 19 (primitive/fnptr-of on-header-value-complete))
  (ll/set-simple-callback! s 10 (primitive/fnptr-of on-headers-complete))
  (ll/set-simple-callback! s 12 (primitive/fnptr-of on-message-complete)))

(defn parity [(input (slice u8))] (-> i64)
  (let [native (coil_llhttp_parse_request (slice/slice-data input) (slice/slice-len input))
        parser (primitive/alloc-stack types/Parser)
        settings (primitive/alloc-stack types/Settings)
        trace (primitive/alloc-stack Trace)]
    (assert (primitive/icmp-ne (primitive/cast i64 native) 0))
    (primitive/store! trace (primitive/zeroed Trace))
    (configure settings)
    (ll/init parser HTTP_REQUEST settings)
    (primitive/store! (primitive/field parser data) (primitive/cast (ptr i8) trace))
    (let [execute-error (ll/execute parser input)
          status (if (and (primitive/icmp-eq execute-error HPE_PAUSED)
                          (primitive/icmp-ne (primitive/load (primitive/field trace complete)) 0))
                     0
                     (if (primitive/icmp-eq execute-error HPE_OK) 1 2))
          error-code (if (primitive/icmp-eq status 0)
                         HPE_OK
                         (if (primitive/icmp-eq execute-error HPE_OK)
                             (ll/finish parser)
                             execute-error))
          error-pos (ll/get-error-pos parser)
          error-offset (if (primitive/icmp-eq (primitive/cast i64 error-pos) 0)
                           (slice/slice-len input)
                           (primitive/isub (primitive/cast i64 error-pos)
                             (primitive/cast i64 (slice/slice-data input))))]
      (assert-eq status (coil_llhttp_status native))
      (assert-eq error-code (coil_llhttp_error_code native))
      (assert-eq error-offset (coil_llhttp_error_offset native))
      (assert-eq (ll/get-http-major parser) (coil_llhttp_http_major native))
      (assert-eq (ll/get-http-minor parser) (coil_llhttp_http_minor native))
      (assert-eq (primitive/load (primitive/field trace keep-alive)) (coil_llhttp_keep_alive native))
      (assert-eq (primitive/load (primitive/field trace header-count)) (coil_llhttp_header_count native))
      (assert-eq (primitive/load (primitive/field trace method-len)) (coil_llhttp_method_len native))
      (assert-eq (primitive/load (primitive/field trace target-len)) (coil_llhttp_target_len native))
      (assert-eq (primitive/load (primitive/field trace body-len)) (coil_llhttp_body_len native)))
    (coil_llhttp_result_free native)
    0))

(deftest differential-content-length
  (parity (wire "POST /items HTTP/1.1~Host: example.test~Content-Length: 5~~hello")))

(deftest differential-chunked
  (parity (wire "POST /chunks HTTP/1.1~Transfer-Encoding: chunked~~4~Wiki~5~pedia~0~X-Trailer: yes~~")))

(deftest differential-incomplete
  (parity (wire "POST / HTTP/1.1~Content-Length: 4~~abc")))

(deftest differential-invalid-duplicate-length
  (parity (wire "POST / HTTP/1.1~Content-Length: 1~Content-Length: 1~~x")))
