(module rd.shape)
(import "coil.primitive" :as primitive)

(reader-provider "rd.shape" read-shape)

(defstruct Shape [(width i64) (height i64) (depth i64) (weight i64)])

;; A source provider may reflect on its own program, which a precompiled one may
;; not. A file `(NAME N)` defines NAME as N plus the number of Shape's fields.
(defn read-shape [(context Code)] (-> Code)
  (let [form (get (primitive/code-read (get context 2) `(reader-config)) 1)
        fields (primitive/code-field-count `rd.shape.Shape)]
    `(const ~(get form 0) (+ ~fields ~(get form 1)))))
