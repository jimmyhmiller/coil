(module rd.artifact)
(import "coil.primitive" :as primitive)

(defn read-source [(context Code)] (-> Code)
  (let [calls (primitive/alloc-static i64)]
    (store! calls (+ (load calls) 1))
    (when (!= (load calls) 1)
      (primitive/error "provider instance leaked between compilations"))
    ; what code-source prints, code-read reads back: a control byte included
    (let [program
            (primitive/code-read "(do (module artifact.output) (defn main [] (-> i64) (if (= (len \"a\\x01;b\") 3) 42 1)))"
                                 context)]
      (primitive/code-read (primitive/code-source program) context))))

(reader-provider "rd.artifact" read-source)
