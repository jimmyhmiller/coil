(module rd.kv)
(import "coil.primitive" :as primitive)

(reader-provider "rd.kv" read-kv)

(defn read-kv [(context Code)] (-> Code)
  (let [source (primitive/code-nth context 2)]
    (if (primitive/code-eq source `"value=3\n")
        (primitive/code-read "(const value 3)" `(reader-config))
        (primitive/code-read source `(reader-config)))))
