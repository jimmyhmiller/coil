(module rd.kv)
(import "coil.primitive" :as primitive)
(import "coil.meta" :as meta)

(reader-provider "rd.kv" read-kv)

;; A Code helper of the provider. Its argument is the value of a local, as in any
;; metaprogram body, never the syntax of the call.
(defn require-list [(form Code)] (-> Code)
  (if (primitive/code-list? form)
      form
      (primitive/error "require-list received the syntax of its argument")))

;; A macro of the provider: an argument that cannot be Code makes this a macro use.
(defn sum-with-itself [(x Code)] (-> Code)
  `(+ ~x ~x))

(defn read-kv [(context Code)] (-> Code)
  (let [source (primitive/code-nth context 2)
        three `(const value 3)]
    (when (!= (sum-with-itself 2) 4)
      (primitive/error "sum-with-itself was not expanded"))
    (if (primitive/code-eq source `"value=3\n")
        (primitive/code-read (meta/source (require-list three))
                             `(reader-config))
        (primitive/code-read source `(reader-config)))))
