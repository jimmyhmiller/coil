(module coil.tests.simd-native)
(import "coil.simd" :as v)

;; One native register's worth of lanes, of each lane size.
(deftest native-lanes-fill-one-register
  (let [bytes (v/native-vector-bytes)]
    (assert (or (= bytes 0) (= bytes 16)))
    (if (= bytes 0)
        (assert-eq (v/native-lanes u8) 1)
        (do
          (assert-eq (v/native-lanes u8) bytes)
          (assert-eq (v/native-lanes i16) (/ bytes 2))
          (assert-eq (v/native-lanes f32) (/ bytes 4))
          (assert-eq (v/native-lanes u64) (/ bytes 8))))))

(deftest native-lanes-size-a-vector-type
  (let [x (: (v/vsplat 7) (vec u8 (v/native-lanes u8)))]
    (assert-eq (v/vextract x (- (v/native-lanes u8) 1)) 7)))
