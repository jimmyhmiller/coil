(module tests.cli.stogir-capture-loop)

(defstruct Pair [(first u64) (second u64)])

; A retained aggregate-return call needs one private capture slot per call site,
; reused across iterations. It must not consume stack on every iteration.
(defn step :inline (Never) [(state (ptr u64)) (seed u64)] (-> Pair)
  (let [old (load state)]
    (store! state (+ old 1))
    (Pair :first (+ old seed) :second (^ old seed))))

(defn check-pairs [] (-> bool)
  (let [(mut state) (: 0 u64)
        (mut sum) (: 0 u64)
        (mut expected) (: 0 u64)]
    (for [i 0 1048576]
      (let [seed (cast u64 i)
            before (* seed 2)
            a (step (mut state) seed)
            b (step (mut state) (+ seed 17))]
        (set! sum (+ sum (.first a) (.second a) (.first b) (.second b)))
        (set! expected
              (+ expected
                 (+ before seed)
                 (^ before seed)
                 (+ (+ before 1) (+ seed 17))
                 (^ (+ before 1) (+ seed 17))))))
    (and (= state 2097152) (= sum expected))))

(defstruct Quad [(a f64) (b f64) (c f64) (d f64)])

(defn quad :inline (Never) [(seed f64)] (-> Quad)
  (Quad
    :a (+ seed 1.0)
    :b (+ seed 2.0)
    :c (+ seed 3.0)
    :d (+ seed 4.0)))

(defn check-quads [] (-> bool)
  (let [(mut sum) (: 0.0 f64)
        (mut expected) (: 0.0 f64)]
    (for [i 0 1048576]
      (let [seed (+ (cast f64 i) 0.5)
            result (quad seed)]
        (set! sum (+ sum (.a result) (.b result) (.c result) (.d result)))
        (set! expected (+ expected (+ (* seed 4.0) 10.0)))))
    (= sum expected)))

; Compiler-rt i128 helpers have private two-register capture objects too.
(defn check-wide [] (-> bool)
  (let [(mut good) true]
    (for [i 1 1025]
      (let [n (+ (<< (: 1 u128) 100) (cast u128 i))
            d (cast u128 (+ (% i 251) 1))
            q (/ n d)
            r (% n d)
            sn (- (: 0 i128) (cast i128 n))
            sd (cast i128 d)
            sq (/ sn sd)
            sr (% sn sd)]
        (set! good
              (and good
                   (= (+ (* q d) r) n)
                   (< r d)
                   (= (+ (* sq sd) sr) sn)
                   (<= sr 0)))))
    good))

(defn main [] (-> i64)
  (if (and (check-pairs) (check-quads) (check-wide)) 0 1))
