; A file header paragraph stays one block:
; the formatter must not split it after its first line.
(module spacing)
(import "coil.io" :use *)
(import "coil.str" :use *)

(defn one [] (-> i64)
  1)

;;; two docs lines
;;; stay with `two`
(defn two [] (-> i64)
  2)

; a new section
(const THREE 3)  ; trailing comment

(defn four [] (-> i64)
  4)
