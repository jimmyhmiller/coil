; Keep the aggregate call opaque so the backend must lower its register result.
(defstruct ResultPair [(first u64) (second u64)])
(defn pair-result :cc (cc/C) :inline (Never) [(x u64)] (-> ResultPair)
  (ResultPair :first (^ x 0x123456789ABCDEF0) :second (+ x 17)))
(defn pair-barrier :inline (Never) [(pointer (ptr u64)) (x u64)] (-> u64)
  (set! pointer (+ x 31))
  (load pointer))
(defn pair-check :inline (Never) [(pointer (ptr u64)) (x u64)] (-> bool)
  (let [pair (pair-result x)
        changed (pair-barrier pointer x)]
    (and (= (.first pair) (^ x 0x123456789ABCDEF0))
         (= (.second pair) (+ x 17))
         (= changed (+ x 31))
         (= (load pointer) changed))))

(defn readonly-pair-result :cc (cc/C)
  [(pointer (ptr u64)) (salt u64)] (-> ResultPair)
  (let [x (load pointer)]
    (ResultPair :first (^ x salt) :second (+ x salt))))
(defn readonly-pair-check :inline (Never) [(pointer (ptr u64)) (x u64)] (-> bool)
  (set! pointer x)
  (let [before (load pointer) pair (readonly-pair-result pointer 17) after (load pointer)]
    (and (= before after) (= after x) (= (.first pair) (^ x 17))
         (= (.second pair) (+ x 17)))))

; Exhaust the ordinary clone budget so qualified register-result calls remain.
(defn readonly-pair-fanout :inline (Never) [(pointer (ptr u64))] (-> u64)
  (+
    (let [pair (readonly-pair-result pointer (: 1 u64))] (+ (.first pair) (.second pair)))
    (let [pair (readonly-pair-result pointer (: 2 u64))] (+ (.first pair) (.second pair)))
    (let [pair (readonly-pair-result pointer (: 3 u64))] (+ (.first pair) (.second pair)))
