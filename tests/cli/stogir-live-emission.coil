; The raw word stays an integer even though a later cast uses it as an address.
; Both address arguments may alias; pointer metadata promises no disjointness.
(defn pointer-word-check :inline (Never) [(raw u64) (pointer (ptr u64)) (value u64)] (-> bool)
  (let [integer-use (^ raw value)
        address (primitive/cast (ptr u64) raw)]
    (set! pointer value)
    (and (= (load address) value) (= integer-use (^ raw value)))))

(defn main [] (-> i64)
  (let [(mut failures) 0]
    (for [x 0 200]
      (unless (= (kernel x) (+ (* (+ x 3) 2) (+ (* x 5) 11) (+ x 23) (& x 7)))
        (set! failures (+ failures 1))))
    (let [pointer (primitive/alloc-stack u64)]
      (for [x 0 32]
        (set! pointer (cast u64 x))
        (let [(mut expected) (: 0 u64)]
          (for [salt 1 257]
            (set! expected (+ expected (^ (* (+ (cast u64 x) (cast u64 salt)) 3) 7))))
          (unless (= (readonly-fanout pointer) expected)
            (set! failures (+ failures 1))))
        (let [before (load pointer) changed (writing-leaf pointer 13)]
          (unless (and (= changed (+ before 13)) (= (load pointer) changed))
            (set! failures (+ failures 1))))))
    (let [pointer (primitive/alloc-stack u64)]
      (for x [(: 0 u64) 1 17 0x8000000000000000 0xFFFFFFFFFFFFFFFF]
        (unless (pair-check pointer x) (set! failures (+ failures 1)))
        (unless (readonly-pair-check pointer x) (set! failures (+ failures 1)))
        (let [(mut expected) (: 0 u64)]
          (for [salt 1 257]
            (set! expected (+ expected (^ x (cast u64 salt)) (+ x (cast u64 salt)))))
          (unless (and (= (readonly-pair-fanout pointer) expected) (= (load pointer) x))
            (set! failures (+ failures 1))))))
    (let [pointer (primitive/alloc-stack u64)
          raw (primitive/cast u64 pointer)]
      (for value [(: 0 u64) 1 0x8000000000000000 0xFFFFFFFFFFFFFFFF]
        (unless (pointer-word-check raw pointer value)
          (set! failures (+ failures 1)))))
    (println "post-inline emission: {} failures" failures)
    (if (= failures 0) 0 1)))
