(module tests.cli.stogir-live-emission)
(import "coil.cc" :as cc)
(import "coil.primitive" :as primitive)

(defn leaf [(x i64)] (-> i64) (+ x 3))
(defn wrapper [(x i64)] (-> i64) (* (leaf x) 2))

; Referenced only through native data; inlining must not discard its symbol.
(defn address-only :cc (cc/C) [(x i64)] (-> i64) (+ (* x 5) 11))
(def CALLBACKS [(fnptr-of address-only)])

; This address enters the caller through an inlined helper, so the final graph
; must supply the edge even when the helper itself is no longer emitted.
(defn returned-callback :cc (cc/C) [(x i64)] (-> i64) (+ x 23))
(defn make-callback [] (-> (fnptr (cc/C) [i64] i64))
  (fnptr-of returned-callback))

; Export aliases expose a private Coil name, independently of direct calls.
(defn public-entry :cc (cc/C) [(x i64)] (-> i64) (+ x 17))
(export-c [public-entry :as "stogir_retained_entry"])

(defn recursive :inline (Never) [(x i64)] (-> i64)
  (if (<= x 0) 0 (+ 1 (recursive (- x 1)))))

; Never callers are not callee templates, but their own finalized graph can
; eliminate every reference to ordinary helpers before machine emission.
(defn kernel :inline (Never) [(x i64)] (-> i64)
  (+ (wrapper x) (call-ptr (get CALLBACKS 0) x) (call-ptr (make-callback) x) (recursive (& x 7))))

; Enough distinct calls exhaust the ordinary clone budget, retaining qualified
; calls in the large caller. The effect proof must come from the body, not names.
(defn readonly-leaf :cc (cc/C) [(pointer (ptr u64)) (salt u64)] (-> u64)
  (^ (* (+ (load pointer) salt) 3) 7))
(defn writing-leaf :cc (cc/C) [(pointer (ptr u64)) (salt u64)] (-> u64)
  (let [value (+ (load pointer) salt)] (set! pointer value) value))
(defn readonly-fanout :inline (Never) [(pointer (ptr u64))] (-> u64)
  (+
    (readonly-leaf pointer (: 1 u64))
    (readonly-leaf pointer (: 2 u64))
    (readonly-leaf pointer (: 3 u64))
    (readonly-leaf pointer (: 4 u64))
    (readonly-leaf pointer (: 5 u64))
    (readonly-leaf pointer (: 6 u64))
    (readonly-leaf pointer (: 7 u64))
    (readonly-leaf pointer (: 8 u64))
    (readonly-leaf pointer (: 9 u64))
    (readonly-leaf pointer (: 10 u64))
    (readonly-leaf pointer (: 11 u64))
    (readonly-leaf pointer (: 12 u64))
    (readonly-leaf pointer (: 13 u64))
    (readonly-leaf pointer (: 14 u64))
    (readonly-leaf pointer (: 15 u64))
    (readonly-leaf pointer (: 16 u64))
    (readonly-leaf pointer (: 17 u64))
    (readonly-leaf pointer (: 18 u64))
    (readonly-leaf pointer (: 19 u64))
    (readonly-leaf pointer (: 20 u64))
    (readonly-leaf pointer (: 21 u64))
    (readonly-leaf pointer (: 22 u64))
    (readonly-leaf pointer (: 23 u64))
    (readonly-leaf pointer (: 24 u64))
    (readonly-leaf pointer (: 25 u64))
    (readonly-leaf pointer (: 26 u64))
    (readonly-leaf pointer (: 27 u64))
    (readonly-leaf pointer (: 28 u64))
    (readonly-leaf pointer (: 29 u64))
    (readonly-leaf pointer (: 30 u64))
    (readonly-leaf pointer (: 31 u64))
    (readonly-leaf pointer (: 32 u64))
    (readonly-leaf pointer (: 33 u64))
    (readonly-leaf pointer (: 34 u64))
    (readonly-leaf pointer (: 35 u64))
    (readonly-leaf pointer (: 36 u64))
    (readonly-leaf pointer (: 37 u64))
    (readonly-leaf pointer (: 38 u64))
    (readonly-leaf pointer (: 39 u64))
    (readonly-leaf pointer (: 40 u64))
    (readonly-leaf pointer (: 41 u64))
    (readonly-leaf pointer (: 42 u64))
    (readonly-leaf pointer (: 43 u64))
    (readonly-leaf pointer (: 44 u64))
    (readonly-leaf pointer (: 45 u64))
    (readonly-leaf pointer (: 46 u64))
    (readonly-leaf pointer (: 47 u64))
    (readonly-leaf pointer (: 48 u64))
    (readonly-leaf pointer (: 49 u64))
    (readonly-leaf pointer (: 50 u64))
    (readonly-leaf pointer (: 51 u64))
    (readonly-leaf pointer (: 52 u64))
    (readonly-leaf pointer (: 53 u64))
    (readonly-leaf pointer (: 54 u64))
    (readonly-leaf pointer (: 55 u64))
    (readonly-leaf pointer (: 56 u64))
    (readonly-leaf pointer (: 57 u64))
    (readonly-leaf pointer (: 58 u64))
    (readonly-leaf pointer (: 59 u64))
    (readonly-leaf pointer (: 60 u64))
    (readonly-leaf pointer (: 61 u64))
    (readonly-leaf pointer (: 62 u64))
    (readonly-leaf pointer (: 63 u64))
    (readonly-leaf pointer (: 64 u64))
    (readonly-leaf pointer (: 65 u64))
    (readonly-leaf pointer (: 66 u64))
    (readonly-leaf pointer (: 67 u64))
    (readonly-leaf pointer (: 68 u64))
    (readonly-leaf pointer (: 69 u64))
    (readonly-leaf pointer (: 70 u64))
    (readonly-leaf pointer (: 71 u64))
    (readonly-leaf pointer (: 72 u64))
    (readonly-leaf pointer (: 73 u64))
    (readonly-leaf pointer (: 74 u64))
    (readonly-leaf pointer (: 75 u64))
    (readonly-leaf pointer (: 76 u64))
    (readonly-leaf pointer (: 77 u64))
    (readonly-leaf pointer (: 78 u64))
    (readonly-leaf pointer (: 79 u64))
    (readonly-leaf pointer (: 80 u64))
    (readonly-leaf pointer (: 81 u64))
    (readonly-leaf pointer (: 82 u64))
    (readonly-leaf pointer (: 83 u64))
    (readonly-leaf pointer (: 84 u64))
    (readonly-leaf pointer (: 85 u64))
