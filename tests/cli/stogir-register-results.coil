(module tests.cli.stogir-register-results)
(import "coil.primitive" :as p)
(import "coil.args" :as args)
(import "coil.avec" :use [AVec avec-new avec-at])
(import "coil.scratch" :as scratch)
(import "coil.alloc" :use [malloc-allocator])

(defstruct Pair [(first u64) (second u64)])

(defstruct PointerPair [(pointer (ptr u64)) (value u64)])

(defn make-pair [(seed u64)] (-> Pair)
  (Pair :first (+ seed 3) :second (^ seed 85)))

(defn wrap-pair [(seed u64)] (-> Pair)
  (make-pair seed))

(defn never-pair :inline (Never) [(seed u64)] (-> Pair)
  (make-pair seed))

(defn touch-pair [(pointer (ptr u64))] (-> Pair)
  (let [old (load pointer)]
    (store! pointer (+ old 1))
    (Pair :first old :second (load pointer))))

(defn pointer-pair [(pointer (ptr u64)) (value u64)] (-> PointerPair)
  (PointerPair :pointer pointer :value value))

; The true arm is observable control even though it cannot reach the return.
; Expanding the constructor on the false arm must not erase the infinite arm.
(defn loop-or-pair [(go bool) (seed u64)] (-> Pair)
  (if go
      (do (while true 0) (make-pair seed))
      (make-pair seed)))

; Scalar wrappers retain a Never call after their own bodies are cloned.
(defn never-step :inline (Never) [(value i64)] (-> i64)
  (+ value 7))

(defn scalar-wrapper [(value i64)] (-> i64)
  (+ (never-step value) 3))

(defn scalar-outer [(value i64)] (-> i64)
  (+ (scalar-wrapper value) 5))

(defn scalar-loop [(limit i64)] (-> i64)
  (let [(mut i) (: 0 i64)
        (mut sum) (: 0 i64)]
    (while (< i limit)
      (set! sum (+ sum (never-step i)))
      (set! i (+ i 1)))
    sum))

; Recursive templates must retain their named call, rather than recursively
; expanding during module preparation. The ordinary function remains callable.
(defn scalar-recursive [(limit i64)] (-> i64)
  (if (<= limit 0) 3 (+ limit (scalar-recursive (- limit 1)))))

(defn recursive-wrapper [(limit i64)] (-> i64)
  (+ (scalar-recursive limit) 2))

(defn mutually-even [(limit i64)] (-> i64)
  (if (<= limit 0) 5 (+ 1 (mutually-odd (- limit 1)))))

(defn mutually-odd [(limit i64)] (-> i64)
  (if (<= limit 0) 7 (+ 1 (mutually-even (- limit 1)))))

(defn checked-avec-access [(mode i32)] (-> i64)
  (let [arena (p/alloc-stack scratch/ScratchArena)
        _
          (scratch/ScratchArena::init-with-capacity arena
                                                    (malloc-allocator)
                                                    65536)
        (mut rows) (avec-new [i64] (scratch/ScratchArena::allocator arena))]
    (when (!= mode 3) (push! (mut rows) 42))
    (let [index (case mode 1 -1 2 1 0)
          answer (load (avec-at rows index))]
      (scratch/ScratchArena::close! arena)
      answer)))

(defn main [(argc i32) (argv (ptr (ptr i8)))] (-> i64)
  (args/init! argc argv)
  (when (args/has? "--avec-negative") (checked-avec-access 1))
  (when (args/has? "--avec-end") (checked-avec-access 2))
  (when (args/has? "--avec-empty") (checked-avec-access 3))
  (assert (= (checked-avec-access 0) 42))
  (for value [(: 0 i64) 1 3 8]
    (assert (= (mutually-even value) (+ value (if (= (% value 2) 0) 5 7))))
    (assert (= (mutually-odd value) (+ value (if (= (% value 2) 0) 7 5))))
    (assert (= (recursive-wrapper value) (+ 5 (/ (* value (+ value 1)) 2))))
    (assert (= (scalar-outer value) (+ value 15)))
    (assert (= (scalar-loop value) (+ (* value 7) (/ (* value (- value 1)) 2))))
    (assert (= (scalar-recursive value) (+ 3 (/ (* value (+ value 1)) 2)))))
  (let [go (args/has? "--loop")
        (mut memory) (: 73 u64)
        pointer (p/cast (ptr u64) (mut memory))]
    (for seed [(: 0 u64) 3 17 0x7FF8000000000042]
      (let [pair (wrap-pair seed)
            kept (never-pair seed)
            conditional (loop-or-pair go seed)
            returned (pointer-pair pointer seed)]
        (assert (= (.first pair) (+ seed 3)))
        (assert (= (.second pair) (^ seed 85)))
        (assert (= (.first kept) (.first pair)))
        (assert (= (.second conditional) (.second pair)))
        (assert (= (.pointer returned) pointer))
        (assert (= (.value returned) seed))))
    (let [pair (touch-pair pointer)]
      (assert (= (.first pair) 73))
      (assert (= (.second pair) 74))
      (assert (= memory 74)))
    42))
