(module safety-checks)
(import "coil.args" :as args)
(import "coil.slice" :use [subslice])
(import "coil.primitive" :as primitive)
(import "coil.safety.checked")
(import "coil.mem" :use [memcpy])

; Built with `--use coil.safety` by scripts/tests/fast/cli.sh. With no argument it runs what must
; not trap; with one it trips the check that argument names, at a known line.

;; `:safety/checked false` keeps the unchecked meaning: this wraps.
(defn wrap-add :safety/checked false [(a i64) (b i64)] (-> i64) (+ a b))

(defn sum [(T Add)] [(a T) (b T)] (-> T) (+ a b))

(defn trip [(which (slice u8)) (n i64)] (-> i64)
  (let [xs [10 20 30]
        big 9223372036854775807]
    (cond (= which "index") (get xs (+ n 3))
          (= which "add") (+ big n)
          (= which "sub") (- (- 0 big) (+ n 1))
          (= which "mul") (* big (+ n 2))
          (= which "neg") (- (- (- 0 big) n))
          (= which "div") (/ 7 (- n 1))
          (= which "min-div") (/ (- (- 0 big) 1) (- 0 n))
          (= which "shift") (<< 1 (+ n 64))
          (= which "narrow") (cast i64 (cast u8 (+ n 300)))
          (= which "unsigned") (cast i64 (cast u64 (- 0 n)))
          (= which "float") (cast i64 (* (cast f64 big) 4.0))
          (= which "slice-get") (get xs (+ n 5))
          (= which "subslice") (len (subslice xs 3 (+ n 1)))
          (= which "generic") (sum big n)
          (= which "align") (misaligned-load n)
          (= which "null-load") (null-load n)
          (= which "null-field") (null-field n)
          (= which "memcpy") (overlapping-copy n)
          :else (more-traps which n))))

(defstruct Pair [(a i64) (b i64)])

;; An i64 read from an address one byte into a buffer.
(defn misaligned-load [(n i64)] (-> i64)
  (let [(mut buf) [0 0 0 0]
        base (cast i64 (cast (ptr i8) (mut buf)))]
    (load (cast (ptr i64) (+ base n)))))

(defn null-load [(n i64)] (-> i64)
  (load (cast (ptr i64) (- n 1))))

(defn null-field [(n i64)] (-> i64)
  (.a (cast (ptr Pair) (- n 1))))

;; Copy the first eight bytes over bytes four to eleven of one buffer.
(defn overlapping-copy [(n i64)] (-> i64)
  (let [(mut buf) [0 0 0 0]
        p (cast (ptr i8) (mut buf))]
    (memcpy p (primitive/index p (+ n 3)) 8)
    0))

;; What the pointer checks must let through: an aligned cast, a null pointer that is
;; never read, a field read, and a copy between disjoint ranges.
(defn pointers-in-range [] (-> i64)
  (let [(mut buf) [7 8 9 10]
        base (cast (ptr i64) (mut buf))
        none (cast (ptr Pair) 0)
        (mut pair) (Pair :a 3 :b 4)
        pp (cast (ptr Pair) (mut pair))
        bytes (cast (ptr i8) (mut buf))]
    (memcpy bytes (primitive/index bytes 16) 16)
    (+ (load (primitive/index base 1)) (.b pp))))

(defn main [(argc i32) (argv (ptr (ptr i8)))] (-> i64)
  (args/init! argc argv)
  (let [n (args/count)]
    (if (> n 1)
        (trip (args/nth 1) 1)
        (do
          (println "in range: {} {} {}" (+ 40 2) (cast u8 255) (get [1 2 3] 2))
          (println "wrapping: {} {}"
                   (primitive/iadd 9223372036854775807 1)
                   (primitive/cast u8 300))
          (println "unchecked: {}" (wrap-add 9223372036854775807 1))
          (println "min prints: {}" (- (- 0 9223372036854775807) 1))
          (println "pointers: {}" (pointers-in-range))
          (println "undefined: {}" (read-undefined))
          0))))

;; The remaining checks. They are reached from `trip` through its `:else`, so the
;; lines of everything above stay where the gate expects them.
(defstruct Link [(next (ptr Link)) (v i64)])
(defsum Shape (Dot []) (Circle [(r i64)]) (Rect [(w i64) (h i64)]))

(defn overflow [(n i64)] (-> i64) (+ 1 (overflow (+ n 1))))

(defn more-traps [(which (slice u8)) (n i64)] (-> i64)
  (let [(mut link) (Link :next (cast (ptr Link) 0) :v 1)
        lp (cast (ptr Link) (mut link))
        (mut words) [9 0 0]
        (mut flag) (primitive/cast u8 2)
        none (cast (ptr i64) 0)
        (mut buf) [0 0 0 0]
        bp (cast (ptr i64) (mut buf))]
    (cond (= which "null-next") (.v (.next lp))
          (= which "null-volatile") (primitive/volatile-load i64 none)
          (= which "bad-tag") (match (load (cast (ptr Shape) (mut words)))
                                (Dot [] 0)
                                (Circle [r] r)
                                (Rect [w h] w))
          (= which "bad-bool") (if (load (cast (ptr bool) (mut flag))) 1 0)
          (= which "ptr-index") (cast i64 (primitive/index bp (<< 1 60)))
          (= which "memcpy-null") (do (memcpy (cast (ptr i8) 0) (cast (ptr i8) bp) 8) 0)
          (= which "unreachable") (unreachable)
          (= which "stack") (overflow n)
          :else 0)))

;; A frame is filled with the `undefined` pattern, so a read of unwritten storage
;; is plainly wrong.
(defn read-undefined [] (-> i64)
  (let [p (primitive/alloc-stack i64)]
    (load p)))
