(module cli.native-backends)
(import "coil.primitive" :as p)
(import "coil.atomic" :as atomic)
(import "coil.cc" :as cc)
(import "coil.alloc" :use [malloc-allocator])
(import "coil.arraylist" :use [ArrayList])

(defn sum :inline (Never) [(limit i64)] (-> i64)
  (let [(mut i) 0
        (mut total) 0]
    (while (< i limit)
      (set! total (+ total i))
      (set! i (+ i 1)))
    total))

(defsum Kind (A) (B) (C) (D) (E) (F) (G) (H))

(defn choose :inline (Never) [(x i64)] (-> Kind)
  (case x 0 (A) 1 (B) 2 (C) 3 (D) 4 (E) 5 (F) 6 (G) (H)))

(defn weight :inline (Never) [(x Kind)] (-> i64)
  (match x
    (A [] 3)
    (B [] 5)
    (C [] 7)
    (D [] 11)
    (E [] 13)
    (F [] 17)
    (G [] 19)
    (H [] 23)))

(defn switches [] (-> bool)
  (let [(mut total) 0]
    (for [i 0 100] (set! total (+ total (weight (choose (% i 8))))))
    (= total 1202)))

(defstruct Pair [(a i64) (b i64)])

(defn make-pair :inline (Never) [(x i64)] (-> Pair)
  (Pair :a x :b (+ x 8)))

(defn sum-pair :inline (Never) [(pair Pair)] (-> i64)
  (+ (.a pair) (.b pair)))

(defstruct Large [(a i64) (b i64) (c i64)])

(defn make-large :inline (Never) [(x i64)] (-> Large)
  (Large
    :a x
    :b (+ x 1)
    :c (+ x 2)))

(defstruct Floats [(a f32) (b f32) (c f32) (d f32)])

(defn make-floats :inline (Never) [(x f32)] (-> Floats)
  (Floats
    :a x
    :b (+ x (: 1.0 f32))
    :c (+ x (: 2.0 f32))
    :d (+ x (: 3.0 f32))))

(defn sum-floats :inline (Never) [(x Floats)] (-> f32)
  (+ (.a x) (.b x) (.c x) (.d x)))

(defn aggregates [] (-> bool)
  (let [pair (make-pair 17)
        large (make-large 13)
        floats (make-floats (: 1.0 f32))]
    (and (= (sum-pair pair) 42)
         (= (+ (.a large) (.b large) (.c large)) 42)
         (= (sum-floats floats) (: 10.0 f32)))))

(defn calculate :inline (Never) [(x f64)] (-> f64)
  (+ (* x 1.5) 0.5))

(defn narrow :inline (Never) [(x f64)] (-> f32)
  (cast f32 x))

(defn bits :inline (Never) [(raw u64)] (-> f64)
  (let [slot (p/alloc-stack u64)]
    (p/store! slot raw)
    (p/load (p/cast (ptr f64) slot))))

(defn floating [] (-> bool)
  (let [answer (calculate 2.0)
        nan (bits 0x7FF8000000001234)]
    (and (= answer 3.5)
         (= (cast i64 answer) 3)
         (= (cast f64 (narrow 3.25)) 3.25)
         (!= nan nan)
         (not (< nan 1.0))
         (not (>= nan 1.0)))))

(defn bump :inline (Never) [(data (ptr i64))] (-> i64)
  (let [(mut total) 0]
    (for [i 0 4]
      (let [value (+ (p/load (p/index data i)) (* i 7))]
        (p/store! (p/index data i) value)
        (set! total (+ total value))))
    total))

(defn memory [] (-> bool)
  (let [storage (p/alloc-stack (array i64 4))
        data (p/cast (ptr i64) storage)]
    (for [i 0 4] (p/store! (p/index data i) (+ i 1)))
    (and (= (bump data) 52) (= (p/load (p/index data 3)) 25))))

(defn atomics [] (-> bool)
  (let [(mut cell) 7
        pointer (p/cast (ptr i64) (mut cell))
        before (atomic/add pointer 5)
        cas (atomic/cas pointer 12 30)
        failed (atomic/cas pointer 12 31)
        swapped (atomic/xchg pointer 42)
        after (atomic/read pointer)]
    (and (= before 7) (= cas 12) (= failed 30) (= swapped 30) (= after 42))))

(defn callback :cc (cc/C) :inline (Never) [(value i64)] (-> i64)
  (* value 6))

(defn function-pointer [] (-> bool)
  (let [f (: (fnptr-of callback) (fnptr (cc/C) [i64] i64))]
    (= (call-ptr f 7) 42)))

(defn heap [] (-> bool)
  (let [(mut values) (ArrayList::new [i64] (malloc-allocator))
        (mut total) 0]
    (for [i 0 64] (push! (mut values) i))
    (for [i 0 (len values)] (set! total (+ total (get values i))))
    (free! (mut values))
    (= total 2016)))

(defn main [] (-> i64)
  (cond (!= (sum 100) 4950) 1
        (not (switches)) 2
        (not (aggregates)) 3
        (not (floating)) 4
        (not (memory)) 5
        (not (atomics)) 6
        (not (function-pointer)) 7
        (not (heap)) 8
        :else 42))
