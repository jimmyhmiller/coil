(module cli.native-backends)
(import "coil.primitive" :as p)
(import "coil.atomic" :as atomic)
(import "coil.cc" :as cc)
(import "coil.alloc" :use [malloc-allocator])
(import "coil.arraylist" :use [ArrayList])

(defn sum :inline (Never) [(limit i64)] (-> i64)
  (let [(mut i) 0
        (mut total) 0]
    (while (< i limit)
      (set! total (+ total i))
      (set! i (+ i 1)))
    total))

(defsum Kind (A) (B) (C) (D) (E) (F) (G) (H))

(defn choose :inline (Never) [(x i64)] (-> Kind)
  (case x 0 (A) 1 (B) 2 (C) 3 (D) 4 (E) 5 (F) 6 (G) (H)))

(defn weight :inline (Never) [(x Kind)] (-> i64)
  (match x
    (A [] 3)
    (B [] 5)
    (C [] 7)
    (D [] 11)
    (E [] 13)
    (F [] 17)
    (G [] 19)
    (H [] 23)))

(defn switches [] (-> bool)
  (let [(mut total) 0]
    (for [i 0 100] (set! total (+ total (weight (choose (% i 8))))))
    (= total 1202)))

(defstruct Pair [(a i64) (b i64)])

(defn make-pair :inline (Never) [(x i64)] (-> Pair)
  (Pair :a x :b (+ x 8)))

(defn sum-pair :inline (Never) [(pair Pair)] (-> i64)
  (+ (.a pair) (.b pair)))

(defn local-pair :inline (Never) [(x i64) (y i64)] (-> i64)
  (let [pair (Pair :a (+ x 3) :b (* y 7))]
    (+ (.a pair) (.b pair))))

(defstruct Large [(a i64) (b i64) (c i64)])

(defn make-large :inline (Never) [(x i64)] (-> Large)
  (Large
    :a x
    :b (+ x 1)
    :c (+ x 2)))

(defstruct Floats [(a f32) (b f32) (c f32) (d f32)])

(defn make-floats :inline (Never) [(x f32)] (-> Floats)
  (Floats
    :a x
    :b (+ x (: 1.0 f32))
    :c (+ x (: 2.0 f32))
    :d (+ x (: 3.0 f32))))

(defn sum-floats :inline (Never) [(x Floats)] (-> f32)
  (+ (.a x) (.b x) (.c x) (.d x)))

(defn aggregates [] (-> bool)
  (let [pair (make-pair 17)
        large (make-large 13)
        floats (make-floats (: 1.0 f32))]
    (and (= (local-pair 11 4) 42)
         (= (sum-pair pair) 42)
         (= (+ (.a large) (.b large) (.c large)) 42)
         (= (sum-floats floats) (: 10.0 f32)))))

(defn calculate :inline (Never) [(x f64)] (-> f64)
  (+ (* x 1.5) 0.5))

(defn narrow :inline (Never) [(x f64)] (-> f32)
  (cast f32 x))

(defn bits :inline (Never) [(raw u64)] (-> f64)
  (let [slot (p/alloc-stack u64)]
    (p/store! slot raw)
    (p/load (p/cast (ptr f64) slot))))

(defn floating [] (-> bool)
  (let [answer (calculate 2.0)
        nan (bits 0x7FF8000000001234)]
    (and (= answer 3.5)
         (= (cast i64 answer) 3)
         (= (cast f64 (narrow 3.25)) 3.25)
         (!= nan nan)
         (not (< nan 1.0))
         (not (>= nan 1.0)))))

(defn bump :inline (Never) [(data (ptr i64))] (-> i64)
  (let [(mut total) 0]
    (for [i 0 4]
      (let [value (+ (p/load (p/index data i)) (* i 7))]
        (p/store! (p/index data i) value)
        (set! total (+ total value))))
    total))

(defn memory [] (-> bool)
  (let [storage (p/alloc-stack (array i64 4))
        data (p/cast (ptr i64) storage)]
    (for [i 0 4] (p/store! (p/index data i) (+ i 1)))
    (and (= (bump data) 52) (= (p/load (p/index data 3)) 25))))

(defn atomics [] (-> bool)
  (let [(mut cell) 7
        pointer (p/cast (ptr i64) (mut cell))
        before (atomic/add pointer 5)
        cas (atomic/cas pointer 12 30)
        failed (atomic/cas pointer 12 31)
        swapped (atomic/xchg pointer 42)
        after (atomic/read pointer)]
    (and (= before 7) (= cas 12) (= failed 30) (= swapped 30) (= after 42))))

(defn callback :cc (cc/C) :inline (Never) [(value i64)] (-> i64)
  (* value 6))

(defn function-pointer [] (-> bool)
  (let [f (: (fnptr-of callback) (fnptr (cc/C) [i64] i64))]
    (= (call-ptr f 7) 42)))

(defn heap [] (-> bool)
  (let [(mut values) (ArrayList::new [i64] (malloc-allocator))
        (mut total) 0]
    (for [i 0 64] (push! (mut values) i))
    (for [i 0 (len values)] (set! total (+ total (get values i))))
    (free! (mut values))
    (= total 2016)))

; Exercise dynamic narrowing/sign extension, including high container bits.
(defn normalize-widths :inline (Never) [(x i64)] (-> bool)
  (let [lo8 (& x 255)
        lo16 (& x 65535)
        lo32 (& x 4294967295)]
    (and (= (cast i64 (p/cast u8 x)) lo8)
         (= (cast i64 (p/cast u16 x)) lo16)
         (= (cast i64 (p/cast u32 x)) lo32)
         (= (cast i64 (p/cast i8 x)) (if (>= lo8 128) (- lo8 256) lo8))
         (= (cast i64 (p/cast i16 x)) (if (>= lo16 32768) (- lo16 65536) lo16))
         (= (cast i64 (p/cast i32 x))
            (if (>= lo32 2147483648) (- lo32 4294967296) lo32)))))

(defn integer-normalization [] (-> bool)
  (let [(mut valid) true]
    (for x [-9223372036854775808 -4294967297 -2147483649 -32769 -129 -1 0 1 127
            128 255 256 32767 32768 65535 65536 2147483647 2147483648 4294967295
            4294967296 9223372036854775807]
      (unless (normalize-widths x) (set! valid false)))
    valid))

; Simultaneous Phi definitions with reverse use order exercise initial-owner
; spilling across a branch; all values must survive either incoming edge.
(defn phi-pressure :inline (Never) [(x i64)] (-> i64)
  (let [(mut v1) (+ x 1)
        (mut v2) (+ x 2)
        (mut v3) (+ x 3)
        (mut v4) (+ x 4)
        (mut v5) (+ x 5)
        (mut v6) (+ x 6)
        (mut v7) (+ x 7)
        (mut v8) (+ x 8)
        (mut v9) (+ x 9)
        (mut v10) (+ x 10)
        (mut v11) (+ x 11)
        (mut v12) (+ x 12)
        (mut v13) (+ x 13)
        (mut v14) (+ x 14)
        (mut v15) (+ x 15)
        (mut v16) (+ x 16)
        (mut v17) (+ x 17)
        (mut v18) (+ x 18)
        (mut v19) (+ x 19)
        (mut v20) (+ x 20)
        (mut v21) (+ x 21)
        (mut v22) (+ x 22)
        (mut v23) (+ x 23)
        (mut v24) (+ x 24)]
    (when (>= x 0)
      (set! v1 (- x 1))
      (set! v2 (- x 2))
      (set! v3 (- x 3))
      (set! v4 (- x 4))
      (set! v5 (- x 5))
      (set! v6 (- x 6))
      (set! v7 (- x 7))
      (set! v8 (- x 8))
      (set! v9 (- x 9))
      (set! v10 (- x 10))
      (set! v11 (- x 11))
      (set! v12 (- x 12))
      (set! v13 (- x 13))
      (set! v14 (- x 14))
      (set! v15 (- x 15))
      (set! v16 (- x 16))
      (set! v17 (- x 17))
      (set! v18 (- x 18))
      (set! v19 (- x 19))
      (set! v20 (- x 20))
      (set! v21 (- x 21))
      (set! v22 (- x 22))
      (set! v23 (- x 23))
      (set! v24 (- x 24)))
    (+ v24
       v23
       v22
       v21
       v20
       v19
       v18
       v17
       v16
       v15
       v14
       v13
       v12
       v11
       v10
       v9
       v8
       v7
       v6
       v5
       v4
       v3
       v2
       v1)))

(defn pressure [] (-> bool)
  (let [(mut valid) true]
    (for [x -40 41]
      (when (!= (phi-pressure x) (+ (* 24 x) (if (< x 0) 300 -300)))
        (set! valid false)))
    valid))

(defn record-value :inline (Never) [(count (ptr i64)) (value i64)] (-> i64)
  (p/store! count (+ (p/load count) 1))
  value)

(defn conditional-value :inline (Always) [(x bool) (count (ptr i64))] (-> i64)
  (if x (record-value count 7) (record-value count 9)))

(defn recursive-value :inline (Always) [(n i64)] (-> i64)
  (if (<= n 0) 0 (+ 1 (recursive-value (- n 1)))))

(defn mutual-even :inline (Always) [(n i64)] (-> bool)
  (if (= n 0) true (mutual-odd (- n 1))))

(defn mutual-odd :inline (Always) [(n i64)] (-> bool)
  (if (= n 0) false (mutual-even (- n 1))))

(defn conditional-inlining [] (-> bool)
  (let [(mut count) 0
        x 100
        first (+ (conditional-value true (mut count)) x)
        second (+ (conditional-value false (mut count)) x)]
    (and (= first 107)
         (= second 109)
         (= x 100)
         (= count 2)
         (= (recursive-value 19) 19)
         (mutual-even 20)
         (not (mutual-odd 20))
         (!= 10 11)
         (not (!= 7 7)))))

(defn main [] (-> i64)
  (cond (!= (sum 100) 4950) 1
        (not (switches)) 2
        (not (aggregates)) 3
        (not (floating)) 4
        (not (memory)) 5
        (not (atomics)) 6
        (not (function-pointer)) 7
        (not (heap)) 8
        (not (integer-normalization)) 9
        (not (pressure)) 10
        (not (conditional-inlining)) 11
        :else 42))
