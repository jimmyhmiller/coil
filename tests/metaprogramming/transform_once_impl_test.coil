(module transform-once-impl-test)
(import "coil.alloc" :use *)
(import "coil.primitive" :as primitive)

(deftrait Value [Self]
  (value [(self (ptr Self))] (-> i64)))

(defstruct Box [(n i64)])

(impl Value Box
  (value [(self (ptr Box))] (-> i64) (.n self)))

(defn shallow-copy [(form Code)] (-> Code)
  (let [(mut out) (primitive/code-list-new)
        (mut i) 0]
    (loop (if (>= (load i) (primitive/code-count form))
              (break)
              (do
                (push! (mut out) (primitive/code-nth form (load i)))
                (set! i (+ (load i) 1)))))
    (primitive/code-list-like form (primitive/code-list-done (load out)))))

(defn impl-form? [(form Code)] (-> bool)
  (and (primitive/code-list? form)
       (> (primitive/code-count form) 0)
       (= (primitive/code-str (primitive/code-nth form 0)) "impl")))

(defn copy-module [(module-form Code)] (-> Code)
  (let [(mut out) (primitive/code-list-new)
        (mut i) 0]
    (loop (if (>= (load i) (primitive/code-count module-form))
              (break)
              (do
                (let [form (primitive/code-nth module-form (load i))]
                  (push! (mut out)
                         (if (impl-form? form)
                             (shallow-copy form)
                             form)))
                (set! i (+ (load i) 1)))))
    (primitive/code-list-done (load out))))

(defn copy-program [(modules Code)] (-> Code)
  (let [(mut out) (primitive/code-list-new)
        (mut i) 0]
    (loop (if (>= (load i) (primitive/code-count modules))
              (break)
              (do
                (push! (mut out)
                       (copy-module (primitive/code-nth modules (load i))))
                (set! i (+ (load i) 1)))))
    `(do ~@(primitive/code-list-done (load out)))))

(transform-once copy-program)

(defn read-value [(item (dyn Value))] (-> i64)
  (value item))

(defn main [] (-> i64)
  (let [item (primitive/alloc-stack Box)]
    (set! (.n item) 42)
    (if (= (read-value item) 42) 0 1)))
