(module partial-model-test)
(import "coil.primitive" :as primitive)

;; A semantic transform over a program that does not check yet. The model is
;; partial: every function and statement that checks still answers `type-of`
;; and `code-decl`, and `check-error` names the nodes that fail and why.

(defstruct Handle [(ref i64)])
(defn helper [(x i64)] (-> i64) x)
(defn marker [] (-> i64) 0)

(defn handle-type? [(t Code)] (-> bool)
  (and (primitive/code-list? t)
       (and (= (primitive/code-count t) 2)
            (and (primitive/code-sym? (primitive/code-nth t 1))
                 (= (primitive/code-str (primitive/code-nth t 1)) "partial-model-test.Handle")))))

(defn rewrite [(form Code)] (-> Code)
  (cond
    ; A failing `.w` on a Handle becomes `.ref`: found through check-error, typed
    ; through the base's type-of, both from the partial model.
    (and (primitive/code-list? form)
         (and (= (primitive/code-count form) 2)
              (and (primitive/code-eq (primitive/code-nth form 0) `.w)
                   (and (primitive/code-string? (primitive/check-error form))
                        (handle-type? (primitive/type-of (primitive/code-nth form 1)))))))
      `(.ref ~(primitive/code-nth form 1))
    ; A call to `marker` resolved by code-decl becomes 42, proving declarations
    ; resolve in functions that check even while another function does not.
    (and (primitive/code-list? form)
         (and (= (primitive/code-count form) 1)
              (primitive/code-list? (primitive/code-decl form))))
      (if (= (primitive/code-str (primitive/code-nth (primitive/code-decl form) 3)) "partial-model-test.marker")
          `42 form)
    (primitive/code-vector? form)
      (let [out (primitive/code-list-new)]
        (for [i 0 (primitive/code-count form)]
          (primitive/code-list-push! out (rewrite (primitive/code-nth form i))))
        `[~@(primitive/code-list-done out)])
    (primitive/code-list? form)
      (let [out (primitive/code-list-new)]
        (for [i 0 (primitive/code-count form)]
          (primitive/code-list-push! out (rewrite (primitive/code-nth form i))))
        (primitive/code-list-like form (primitive/code-list-done out)))
    :else form))

(defn rewrite-program [(modules Code)] (-> Code)
  (let [out (primitive/code-list-new)
        partial (and (primitive/code-keyword? (primitive/model-status))
                     (= (primitive/code-keyword-name (primitive/model-status)) "partial"))]
    (for [i 0 (primitive/code-count modules)]
      (let [m (primitive/code-nth modules i)]
        (primitive/code-list-push! out
          (if (and partial (= (primitive/code-str (primitive/code-nth m 0)) "partial-model-test"))
              (rewrite m)
              m))))
    `(do ~@(primitive/code-list-done out))))

(transform-once rewrite-program)

;; Two failing accesses in separate statements of one function: one pass fixes both.
(defn width [(h Handle)] (-> i64)
  (helper (.w h))
  (+ (.w h) 1))

(defn answer [] (-> i64) (marker))

(defn main [] (-> i64)
  (let [h (Handle :ref 6)]
    (if (and (= (width h) 7) (= (answer) 42)) 0 1)))
