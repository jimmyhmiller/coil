(module app)
(import "coil.primitive" :as primitive)

; Demo for memgui.coil. Build with the inspector and run:
;   LIBRARY_PATH=/opt/homebrew/opt/raylib/lib \
;     coil build tests/metaprogramming/memgui_demo.coil -o /tmp/memgui_demo \
;       --use memgui --link-flag -lraylib
;   /tmp/memgui_demo            # runs, then the inspector window opens (close it to exit)
; It fills an ArrayList and a HashMap, frees the list, and INTENTIONALLY leaks the map —
; the inspector shows "outstanding blocks: 1" and non-zero current bytes.
(import "coil.arraylist" :use *)
(import "coil.hashmap" :use *)
(import "coil.alloc" :use *)

(defn main [] (-> i64)
  (let [a (malloc-allocator)
        (mut xs) (al-new [i64] a)
        (mut hm) (hm-new-scalar [i64 i64] a)
        (mut i) 0]
    (loop (if (>= (load i) (primitive/cast i64 2000))
              (break)
              (do
                (al-push! [i64] (mut xs) (load i))
                (hm-put! [i64 i64] (mut hm) (load i) (primitive/imul (load i) 2))
                (store! i (primitive/iadd (load i) 1)))))
    (al-free! [i64] (mut xs))  ; freed
    (al-len [i64] xs)))  ; hm left live -> shows as outstanding
