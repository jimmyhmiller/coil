(module runtime_safe_dialect)
(import "coil.primitive" :as primitive)
(import "coil.alloc" :as alloc :use *)
(import "coil.arraylist" :use *)
(import "coil.control" :use *)
(import "coil.fmt" :use *)
(import "coil.io" :use *)
(import "coil.reader" :use *)
(import "coil.scratch" :as scratch)
(import "coil.meta.runtime" :use *)
(import "safedialect" :use *)

;; Run the established safe-dialect transform as an ordinary function over a
;; reader tree. No compiler host, subprocess, or staging callback is involved.
(defn main [] (-> i64)
  (let [input-owner (alloc/stack scratch/ScratchArena)
        final-owner (alloc/stack scratch/ScratchArena)]
    (scratch/scratch-init-with-cap input-owner (malloc-allocator) 4096)
    (scratch/scratch-init-with-cap final-owner (malloc-allocator) 4096)
    (let [input-a (scratch/scratch-allocator input-owner)
          final-a (scratch/scratch-allocator final-owner)]
      (context-set-final! final-a)
      (scope :runtime-code
        (defer (scratch/scratch-close! input-owner))
        (defer (scratch/scratch-close! final-owner))
        (defer (context-clear!))
        (match (read-all input-a "(inc 41)" 0)
          (Err [_] 1)
          (Ok [forms]
              (let [input (primitive/cast Code (box-sexp input-a (al-get [Sexp] (load forms) 0)))
                    ;; desugar-inc expects the compiler transform's flat program
                    ;; list, so wrap our one form in such a list.
                    program `(single ~input)
                    output (call desugar-inc program)
                    expected `(do single (primitive/iadd 41 1))]
                (fmt (stdout)
                     "runtime safedialect: output-forms={d}, matches={d}\n"
                     (primitive/code-count output)
                     (if (primitive/code-eq output expected) 1 0))
                (if (primitive/code-eq output expected) 0 2))))))))
