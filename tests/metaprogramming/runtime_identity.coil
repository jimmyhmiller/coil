(module runtime_identity)
(import "coil.primitive" :as primitive)
(import "coil.alloc" :as alloc :use *)
(import "coil.arraylist" :use *)
(import "coil.fmt" :use *)
(import "coil.io" :use *)
(import "coil.reader" :use *)
(import "coil.scratch" :as scratch)
;; Temporary explicit dependency while the runtime Code support is brought up.
;; The compiler lowers Code operations to this ordinary Coil library.
(import "coil.meta.runtime" :use *)

;; The first normal-runtime Code entry. It is intentionally boring: the test is
;; that Code crosses an ordinary native call without a compile-time engine.
(defn identity-code [(x Code)] (-> Code) x)
(export-c [identity-code :as "identity_code"])

;; A small but genuine metaprogram-shaped computation: recursively walk syntax
;; using only the public Code vocabulary. This is the same function whether it
;; is called by staging or by an ordinary `main`.
(defn count-symbol-children [(x Code) (i i64) (n i64)] (-> i64)
  (if (>= i n)
      0
      (primitive/iadd
        (count-symbols (primitive/code-nth x i))
        (count-symbol-children x (primitive/iadd i 1) n))))
(defn count-symbols [(x Code)] (-> i64)
  (if (primitive/code-sym? x)
      1
      (if (primitive/code-list? x)
          (count-symbol-children x 0 (primitive/code-count x))
          0)))
(export-c [count-symbols :as "count_symbols"])
(defn quoted-code [] (-> Code) `(delta epsilon 9 zeta))
(export-c [quoted-code :as "quoted_code"])
(defn wrap-code [(x Code)] (-> Code) `(wrapped ~x))
(defn splice-code [(xs Code)] (-> Code) `(prefix ~@xs suffix))

(defn main [] (-> i64)
  (let [input-owner (alloc/stack scratch/ScratchArena)
        final-owner (alloc/stack scratch/ScratchArena)]
    (scratch/scratch-init-with-cap input-owner (malloc-allocator) 4096)
    (scratch/scratch-init-with-cap final-owner (malloc-allocator) 4096)
    (let [input-a (scratch/scratch-allocator input-owner)
          final-a (scratch/scratch-allocator final-owner)
          source "(alpha (beta gamma) 42)"]
      (context-set-final! final-a)
      (context-add-source! "runtime-input.coil" source)
      (scope :runtime-code
        (defer (scratch/scratch-close! input-owner))
        (defer (scratch/scratch-close! final-owner))
        (defer (context-clear!))
        (match (read-all input-a source 0)
      (Err [d] (do (fmt (stderr) "runtime Code read failed\n") 1))
      (Ok [forms]
          (let [input (box-sexp input-a (al-get [Sexp] (load forms) 0))
                output (primitive/cast (ptr Sexp)
                                       (identity-code (primitive/cast Code input)))
                code-output (primitive/cast Code output)
                runtime-count (primitive/code-count code-output)
                symbol-count (count-symbols code-output)
                ;; `call` explicitly means an ordinary function call, which is
                ;; important for a zero-argument Code-returning definition: the
                ;; shorthand `(quoted-code)` is intentionally macro syntax.
                quoted (call quoted-code)
                quoted-count (primitive/code-count quoted)
                quoted-symbols (count-symbols quoted)
                wrapped (call wrap-code quoted)
                spliced (call splice-code quoted)
                generated-name (primitive/code-symbol `item "-" 7)
                generated-text (primitive/code-str generated-name)]
            (fmt (stdout)
                 "runtime Code walk: {d} top-level items, {d} symbols, same-node={d}; quote={d}/{d}\n"
                 runtime-count
                 symbol-count
                 (if (= input output) 1 0)
                 quoted-count
                 quoted-symbols)
            (if (and (= runtime-count 3)
                     (and (= symbol-count 3)
                          (and (= input output)
                               (and (= quoted-count 4) (= quoted-symbols 3)))))
                (if (and (= (primitive/code-count wrapped) 2)
                         (and (= (primitive/code-count spliced) 6)
                              (and (= generated-text "item-7")
                                   (and (= (primitive/code-file code-output) "runtime-input.coil")
                                        (= (primitive/code-line code-output) 1)))))
                    0
                    1)
                1))))))))
