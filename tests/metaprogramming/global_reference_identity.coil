(module global-reference-identity)
(import "coil.primitive" :as p)
(import "coil.var" :as var)

(def literal 42)
(def cell (var/var-static i64 7))
(defn inspect-global [T] [(value T)] (-> i64) 0)
(defn inspect-local [(value i64)] (-> i64) value)
(defn inspect-load [(value i64)] (-> i64) value)

(defn inspect! [(form Code)] (-> i64)
  (when (and (p/code-list? form) (= (p/code-count form) 2))
    (let [head (p/code-nth form 0) arg (p/code-nth form 1)]
      (cond
        (p/code-eq head `inspect-global)
          (let [decl (p/code-decl arg)]
            (unless (and (p/code-list? decl) (= (p/code-count decl) 4))
              (p/error "global reference has no declaration") 0)
            (unless (and (p/code-eq (p/code-nth decl 1) `global-reference-identity)
                         (p/code-eq (p/code-nth decl 2) `const))
              (p/error "global reference reports its elaboration instead of its binding") 0))
        (p/code-eq head `inspect-local)
          (unless (p/code-eq (p/code-decl arg) `:unresolved)
            (p/error (p/code-str "local bid=" `~(p/binding-of arg) " declaration: " (p/code-decl arg))) 0)
        (p/code-eq head `inspect-load)
          (unless (p/code-eq (p/code-nth (p/code-decl arg) 3) `coil.primitive.load)
            (p/error "explicit load lost primitive identity") 0)
        true 0)))
  (when (p/code-list? form)
    (for [i 0 (p/code-count form)] (inspect! (p/code-nth form i))) 0)
  0)
(defn verify [(modules Code)] (-> Code)
  (inspect! modules)
  `(do ~@modules))
(transform-once verify)
(defn main [] (-> i32)
  (inspect-global literal)
  (inspect-global cell)
  (let [local-value 9]
    (assert (= (inspect-local local-value) 9)))
  (let [value (p/alloc-stack i64)]
    (store! value 13)
    (inspect-load (load value)))
  0)
