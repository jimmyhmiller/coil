(module string-migration-lint-fixture)
(import "coil.slice" :use [slice-set!])

;;; string
(defn greeting [(name (slice u8))] (-> (slice u8))
  name)

;;; string
(defn byte-editor [(bytes (mut (slice u8)))] (-> i64)
  (slice-set! (load bytes) 0 (cast u8 65)))

;;; string
(defn stale-marker [(value i64)] (-> i64)
  value)
