(module run_meta_identity)
(import "coil.primitive" :as primitive)

(defn identity [(x Code)] (-> Code) x)

(defn code-shape [(x Code)] (-> Code)
  `((proper-list ~(if (primitive/code-list? x) `yes `no))
    (pair ~(if (primitive/code-pair? x) `yes `no))))

(defn dotted-code-shape [(ignored Code)] (-> Code)
  (let [x (primitive/code-cons `head `tail)]
    `((proper-list ~(if (primitive/code-list? x) `yes `no))
      (pair ~(if (primitive/code-pair? x) `yes `no))
      (tail-symbol ~(if (primitive/code-sym? (primitive/code-cdr x)) `yes `no)))))

(defn make-dotted [(ignored Code)] (-> Code)
  (primitive/code-cons `head `tail))

(defn loaded-module-count [(program Code)] (-> Code)
  `~(primitive/code-count program))

(defn proper-code-list? [(x Code)] (-> bool)
  (if (primitive/code-null? x)
      true
      (if (primitive/code-list? x)
          (proper-code-list? (primitive/code-cdr x))
          false)))

(defn first-improper-module [(program Code)] (-> Code)
  (first-improper-module-at program 0))

(defn first-improper-module-at [(program Code) (i i64)] (-> Code)
  (if (primitive/code-null? program)
      `-1
      (if (not (primitive/code-list? program))
          `-2
          (if (proper-code-list? (primitive/code-car program))
              (first-improper-module-at (primitive/code-cdr program) (+ i 1))
              `~i))))

; This function is intentionally not registered as a macro/checker/transform.
; `coil run --meta` stages its ordinary compiler closure on demand.
