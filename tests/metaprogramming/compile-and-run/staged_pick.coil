(module staged_pick)
(import "coil.primitive" :as primitive)

;; The generic staged-metacompilation fixture (docs/design/STAGED_METACOMPILATION.md):
;; a before-expand transform mints a fresh MARKER, declares an isolated phase
;; program with `(stage MARKER ...)`, and rewrites guest-syntax uses into
;; explicit `(MARKER ENTRY ARG...)` requests. The entry `staged-pick` exists in
;; no source file, is compiled for expansion only, and never enters the runtime
;; program.
(defn pick-call? [(x Code) (i i64) (n i64)] (-> bool)
  (if (>= i n)
      false
      (if (pick-tree-call? (primitive/code-nth x i))
          true
          (pick-call? x (+ i 1) n))))

(defn pick-tree-call? [(x Code)] (-> bool)
  (if (not (primitive/code-list? x))
      false
      (if (and (> (primitive/code-count x) 0)
               (primitive/code-eq (primitive/code-nth x 0) `staged-pick))
          true
          (pick-call? x 0 (primitive/code-count x)))))

(defn pick-wrap-items [(x Code) (i i64) (n i64) (marker Code)] (-> Code)
  (if (>= i n)
      `()
      `(~(pick-wrap (primitive/code-nth x i) marker) ~@(pick-wrap-items x (+ i 1) n marker))))

(defn pick-wrap [(x Code) (marker Code)] (-> Code)
  (if (primitive/code-vector? x)
      `#(~@(pick-wrap-items x 0 (primitive/code-count x) marker))
      (if (not (primitive/code-list? x))
          x
          (if (= (primitive/code-count x) 0)
              x
              (let [head (primitive/code-nth x 0)]
                (if (primitive/code-eq head `quote)
                    x
                    (if (primitive/code-eq head `staged-pick)
                        `(~marker "staged_pick_test.staged-pick"
                            ~@(pick-wrap-items x 1 (primitive/code-count x) marker))
                        `(~@(pick-wrap-items x 0 (primitive/code-count x) marker)))))))))

(defn pick-tail [(m Code) (i i64) (n i64) (marker Code)] (-> Code)
  (if (>= i n)
      `()
      `(~(pick-wrap (primitive/code-nth m i) marker) ~@(pick-tail m (+ i 1) n marker))))

(defn pick-module [(m Code)] (-> Code)
  (if (and (> (primitive/code-count m) 0)
           (primitive/code-eq (primitive/code-nth m 0) `staged_pick_test))
      (if (not (pick-tree-call? m))
          m
          (let [marker (primitive/gensym)]
            `(~(primitive/code-nth m 0) ~@(pick-tail m 1 (primitive/code-count m) marker)
                (stage ~marker
                       (import "coil.primitive" :as primitive)
                       (defn staged-pick [(x Code)] (-> Code)
                         ;; (staged-pick A B) picks its SECOND argument at expansion time.
                         (if (primitive/code-list? x) (primitive/code-nth x 1) x))))))
      m))

(defn pick-modules [(mods Code) (i i64) (n i64)] (-> Code)
  (if (>= i n)
      `()
      `(~(pick-module (primitive/code-nth mods i)) ~@(pick-modules mods (+ i 1) n))))

(defn install-staged-pick [(mods Code)] (-> Code)
  `(do ~@(pick-modules mods 0 (primitive/code-count mods))))

(transform install-staged-pick :phase before-expand)
