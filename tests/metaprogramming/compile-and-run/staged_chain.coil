(module staged_chain)
(import "coil.primitive" :as primitive)

;; Multiround + cumulative + language-resumption fixture
;; (docs/design/STAGED_METACOMPILATION.md).
;;
;;   round 1: `(chain-a E)` is guest syntax -> declare increment 1 (helper
;;            `chain-second` + entry `chain-a-entry`) and request it. The native
;;            result is MORE guest syntax: `(chain-b E)`.
;;   round 2: the resumed `(chain-b E)` -> declare increment 2, whose entry
;;            CALLS increment 1's helper (cumulative state), and request it.
;;   round 3: nothing left to do -> fixpoint.
;;
;; `chain-b-entry` does not exist until increment 1's native result has come
;; back through the transform (multiround), and it resolves `chain-second`
;; from the earlier increment (cumulative).

(defn head-is? [(x Code) (name Code)] (-> bool)
  (and (primitive/code-list? x)
       (and (> (primitive/code-count x) 0)
            (primitive/code-eq (primitive/code-nth x 0) name))))

(defn chain-found? [(x Code) (name Code) (i i64) (n i64)] (-> bool)
  (if (>= i n) false
    (if (chain-tree-found? (primitive/code-nth x i) name)
        true
        (chain-found? x name (+ i 1) n))))

(defn chain-tree-found? [(x Code) (name Code)] (-> bool)
  (if (not (primitive/code-list? x)) false
    (if (head-is? x name) true
      (chain-found? x name 0 (primitive/code-count x)))))

(defn chain-wrap-items [(x Code) (i i64) (n i64) (name Code) (marker Code) (entry Code)] (-> Code)
  (if (>= i n) `()
    `(~(chain-wrap (primitive/code-nth x i) name marker entry)
      ~@(chain-wrap-items x (+ i 1) n name marker entry))))

(defn chain-wrap [(x Code) (name Code) (marker Code) (entry Code)] (-> Code)
  (if (not (primitive/code-list? x)) x
    (if (= (primitive/code-count x) 0) x
      (let [head (primitive/code-nth x 0)]
        (if (primitive/code-eq head `quote) x
          (if (primitive/code-eq head name)
              `(~marker ~entry
                ~@(chain-wrap-items x 1 (primitive/code-count x) name marker entry))
            `(~@(chain-wrap-items x 0 (primitive/code-count x) name marker entry))))))))

(defn chain-tail [(m Code) (i i64) (n i64) (name Code) (marker Code) (entry Code)] (-> Code)
  (if (>= i n) `()
    `(~(chain-wrap (primitive/code-nth m i) name marker entry)
      ~@(chain-tail m (+ i 1) n name marker entry))))

(defn chain-module [(m Code)] (-> Code)
  (if (not (and (> (primitive/code-count m) 0)
                (primitive/code-eq (primitive/code-nth m 0) `staged_chain_test)))
      m
    (if (chain-tree-found? m `chain-a)
        (let [marker (primitive/gensym)]
          `(~(primitive/code-nth m 0)
            ~@(chain-tail m 1 (primitive/code-count m) `chain-a marker
                          `staged_chain_test.chain-a-entry)
            (stage ~marker
              (import "coil.primitive" :as primitive)
              ;; Increment 1: a phase helper a LATER increment will call, and
              ;; the entry whose result is more guest syntax.
              (defn chain-second [(x Code)] (-> Code)
                (primitive/code-nth x 1))
              (defn chain-a-entry [(x Code)] (-> Code)
                (let [b (primitive/code-list-new)
                      b1 (primitive/code-list-push! b (primitive/code-symbol "chain-b"))
                      b2 (primitive/code-list-push! b1 x)]
                  (primitive/code-list-done b2))))))
      (if (chain-tree-found? m `chain-b)
          (let [marker (primitive/gensym)]
            `(~(primitive/code-nth m 0)
              ~@(chain-tail m 1 (primitive/code-count m) `chain-b marker
                            `staged_chain_test.chain-b-entry)
              (stage ~marker
                ;; Increment 2: compiled with increment 1 in scope. Calling
                ;; `chain-second` proves cumulative phase state.
                (defn chain-b-entry [(x Code)] (-> Code)
                  (chain-second x)))))
        m))))

(defn chain-modules [(mods Code) (i i64) (n i64)] (-> Code)
  (if (>= i n) `()
    `(~(chain-module (primitive/code-nth mods i))
      ~@(chain-modules mods (+ i 1) n))))

(defn install-staged-chain [(mods Code)] (-> Code)
  `(do ~@(chain-modules mods 0 (primitive/code-count mods))))

(transform install-staged-chain :phase before-expand)
