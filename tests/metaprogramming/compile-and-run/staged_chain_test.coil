(module staged_chain_test)
(import "staged_chain" :use *)

;;; Expansion story: (chain-a (7 42)) -> stage increment 1 runs natively and
;;; returns the GUEST syntax (chain-b (7 42)) -> the dialect resumes, declares
;;; increment 2 (which calls increment 1's helper), and its request returns 42.
(defn main [] (-> i64)
  (chain-a (7 42)))
