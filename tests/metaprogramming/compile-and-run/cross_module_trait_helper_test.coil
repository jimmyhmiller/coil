(module cross_module_trait_helper_test)
(import "coil.primitive" :as primitive)
(import "cross_module_trait_helper" :use [different-length?])

(defn lengths-differ [(a Code) (b Code)] (-> Code)
  (if (different-length? (primitive/code-str a) (primitive/code-str b))
      `true
      `false))

(defn main [] (-> i64)
  (if (lengths-differ "a" "bb") 0 1))
