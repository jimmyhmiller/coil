(module staged_scheme_bridge)
(import "coil.primitive" :as primitive)

;; The Val<->Code bridge fixture (docs/design/STAGED_METACOMPILATION.md M3):
;; a staged entry imports the full Scheme PHASE runtime (GC heap, symbols,
;; numerics, syntax objects) and round-trips a form through
;; code -> syntax object -> Scheme datum -> Scheme compute -> datum->syntax ->
;; code, all at expansion time inside the metaprogram engine.

(defn sb-found? [(x Code) (i i64) (n i64)] (-> bool)
  (if (>= i n) false
    (if (sb-tree-found? (primitive/code-nth x i))
        true
        (sb-found? x (+ i 1) n))))

(defn sb-tree-found? [(x Code)] (-> bool)
  (if (not (primitive/code-list? x)) false
    (if (and (> (primitive/code-count x) 0)
             (primitive/code-eq (primitive/code-nth x 0) `stx-bump))
        true
      (sb-found? x 0 (primitive/code-count x)))))

(defn sb-wrap-items [(x Code) (i i64) (n i64) (marker Code)] (-> Code)
  (if (>= i n) `()
    `(~(sb-wrap (primitive/code-nth x i) marker)
      ~@(sb-wrap-items x (+ i 1) n marker))))

(defn sb-wrap [(x Code) (marker Code)] (-> Code)
  (if (not (primitive/code-list? x)) x
    (if (= (primitive/code-count x) 0) x
      (let [head (primitive/code-nth x 0)]
        (if (primitive/code-eq head `quote) x
          (if (primitive/code-eq head `stx-bump)
              ;; The WHOLE use form is the single argument, syntax-case style.
              `(~marker "staged_scheme_bridge_test.stx-bump-entry" ~x)
            `(~@(sb-wrap-items x 0 (primitive/code-count x) marker))))))))

(defn sb-tail [(m Code) (i i64) (n i64) (marker Code)] (-> Code)
  (if (>= i n) `()
    `(~(sb-wrap (primitive/code-nth m i) marker)
      ~@(sb-tail m (+ i 1) n marker))))

(defn sb-module [(m Code)] (-> Code)
  (if (not (and (> (primitive/code-count m) 0)
                (primitive/code-eq (primitive/code-nth m 0) `staged_scheme_bridge_test)))
      m
    (if (not (sb-tree-found? m)) m
      (let [marker (primitive/gensym)]
        `(~(primitive/code-nth m 0)
          ~@(sb-tail m 1 (primitive/code-count m) marker)
          (stage ~marker
            (import "coil.primitive" :as primitive)
            (import "coil.scheme.phase" :use *)
            (defn stx-bump-entry [(form Code)] (-> Code)
              ;; form is the use-site list (stx-bump SYM INT). Convert the whole
              ;; form to a Scheme datum, pull the fixnum out with Scheme pairs,
              ;; bump it, and reify the result back through a syntax object.
              (let [stx (syntax-object-from-code form)
                    lst (syntax->datum stx)
                    n (fixnum-value (car (cdr (cdr lst))))
                    back (datum->syntax stx (mk-fixnum (+ n 1)))]
                (syntax-object-code back)))))))))

(defn sb-modules [(mods Code) (i i64) (n i64)] (-> Code)
  (if (>= i n) `()
    `(~(sb-module (primitive/code-nth mods i))
      ~@(sb-modules mods (+ i 1) n))))

(defn install-staged-scheme-bridge [(mods Code)] (-> Code)
  `(do ~@(sb-modules mods 0 (primitive/code-count mods))))

(transform install-staged-scheme-bridge :phase before-expand)
