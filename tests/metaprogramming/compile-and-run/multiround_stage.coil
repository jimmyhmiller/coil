(module multiround_stage)
(import "coil.primitive" :as primitive)

;; Return 1 while the first stage call is present, otherwise 2 while the second
;; is present. The source deliberately nests the second call inside the first,
;; so the second phase entry does not exist until the first native result has
;; returned to the transform on the following round.
(defn staged-call-kind [(x Code)] (-> i64)
  (if (not (primitive/code-list? x)) 0
    (if (and (> (primitive/code-count x) 0)
             (primitive/code-eq (primitive/code-nth x 0) `first-stage))
        1
      (if (and (> (primitive/code-count x) 0)
               (primitive/code-eq (primitive/code-nth x 0) `second-stage))
          2
        (if (and (> (primitive/code-count x) 0)
                 (primitive/code-eq (primitive/code-nth x 0) `redefine-stage))
            3
          (if (and (> (primitive/code-count x) 0)
                   (primitive/code-eq (primitive/code-nth x 0) `reuse-first))
              4
            (staged-child-kind x 0 (primitive/code-count x))))))))

(defn staged-child-kind [(x Code) (i i64) (n i64)] (-> i64)
  (if (>= i n) 0
    (let [kind (staged-call-kind (primitive/code-nth x i))]
      (if (!= kind 0) kind
        (staged-child-kind x (+ i 1) n)))))

(defn multiround-wrap-items [(x Code) (i i64) (n i64) (kind i64)
                             (duplicate bool)] (-> Code)
  (if (>= i n) `()
    `(~(multiround-wrap (primitive/code-nth x i) kind duplicate)
      ~@(multiround-wrap-items x (+ i 1) n kind duplicate))))

(defn multiround-wrap [(x Code) (kind i64) (duplicate bool)] (-> Code)
  (if (primitive/code-vector? x)
      `#(~@(multiround-wrap-items x 0 (primitive/code-count x) kind duplicate))
    (if (not (primitive/code-list? x)) x
      (if (= (primitive/code-count x) 0) x
        (let [head (primitive/code-nth x 0)
              target
                (if (= kind 1) `first-stage
                  (if (= kind 2) `second-stage
                    (if (= kind 3) `redefine-stage `reuse-first)))]
          (if (primitive/code-eq head `quote) x
            (if (primitive/code-eq head target)
                ;; Arguments stay raw. If one contains a call for a later stage,
                ;; the current native result returns it to the next transform
                ;; round rather than executing it under the wrong phase.
                (if (= kind 1)
                    (if duplicate
                        `(stage-call "duplicate_stage_test.first-stage"
                           ~@(multiround-raw-items x 1 (primitive/code-count x)))
                      `(stage-call "multiround_stage_test.first-stage"
                         ~@(multiround-raw-items x 1 (primitive/code-count x))))
                  (if (= kind 2)
                      `(stage-call "multiround_stage_test.second-stage"
                         ~@(multiround-raw-items x 1 (primitive/code-count x)))
                    (if (= kind 3)
                        `(stage-call "duplicate_stage_test.redefine-stage"
                           ~@(multiround-raw-items x 1 (primitive/code-count x)))
                      `(stage-call "multiround_stage_test.first-stage"
                         ~@(multiround-raw-items x 1 (primitive/code-count x))))))
              `(~@(multiround-wrap-items x 0 (primitive/code-count x) kind duplicate)))))))))

(defn multiround-raw-items [(x Code) (i i64) (n i64)] (-> Code)
  (if (>= i n) `()
    `(~(primitive/code-nth x i) ~@(multiround-raw-items x (+ i 1) n))))

(defn multiround-tail [(m Code) (i i64) (n i64) (kind i64)
                       (duplicate bool)] (-> Code)
  (if (>= i n) `()
    `(~(multiround-wrap (primitive/code-nth m i) kind duplicate)
      ~@(multiround-tail m (+ i 1) n kind duplicate))))

(defn multiround-module [(m Code)] (-> Code)
  (if (and (> (primitive/code-count m) 0)
           (or (primitive/code-eq (primitive/code-nth m 0) `multiround_stage_test)
               (primitive/code-eq (primitive/code-nth m 0) `duplicate_stage_test)))
      (let [kind (staged-call-kind m)]
        (let [duplicate
                (primitive/code-eq (primitive/code-nth m 0) `duplicate_stage_test)]
        (if (= kind 1)
            `(~(primitive/code-nth m 0)
              ~@(multiround-tail m 1 (primitive/code-count m) kind duplicate)
              (stage
                (defn first-stage [(x Code)] (-> Code) x)))
          (if (= kind 2)
              `(~(primitive/code-nth m 0)
                ~@(multiround-tail m 1 (primitive/code-count m) kind duplicate)
                (stage
                  ;; This is an ordinary native call to the entry compiled in
                  ;; the preceding stage program. Later stages compile against
                  ;; the cumulative phase program, not an isolated one-form
                  ;; snapshot.
                  (defn second-stage [(x Code)] (-> Code)
                    (first-stage x))))
            (if (= kind 3)
                `(~(primitive/code-nth m 0)
                  ~@(multiround-tail m 1 (primitive/code-count m) kind duplicate)
                  (stage
                    ;; Re-emitting an earlier phase binding must be diagnosed;
                    ;; the additive native engine may not silently retain its
                    ;; previous body.
                    (defn first-stage [(x Code)] (-> Code) `wrong)
                    (defn redefine-stage [(x Code)] (-> Code) x)))
              (if (= kind 4)
                  `(~(primitive/code-nth m 0)
                    ~@(multiround-tail m 1 (primitive/code-count m) kind duplicate))
                m))))))
    m))

(defn multiround-modules [(mods Code) (i i64) (n i64)] (-> Code)
  (if (>= i n) `()
    `(~(multiround-module (primitive/code-nth mods i))
      ~@(multiround-modules mods (+ i 1) n))))

(defn install-multiround-stages [(mods Code)] (-> Code)
  `(do ~@(multiround-modules mods 0 (primitive/code-count mods))))

(transform install-multiround-stages :phase before-expand)
