; ============================================================================
; A GUI AT COMPILE TIME — the "run a GUI at comptime" milestone from the
; compile-and-run design, made real.
;
; `(mandel-pick)` is a MACRO. When the compiler expands it, it opens a real
; Cocoa window on the process main thread and renders the Mandelbrot set,
; live: WASD pans, Z/X zooms, I/O changes the iteration budget, Q or RETURN
; accepts the current view. The macro then expands to a call carrying the
; coordinates you chose — the compiled program is parameterized by a
; compile-time GUI session. Under COIL_MANDEL_AUTO=1 the viewer drives itself
; (a scripted zoom, no focus steal) so builds are reproducible/CI-able.
;
; Build (the metaprogram dylib links the same flags as the program):
;   COIL_META_MAIN=1 coil run tests/metaprogramming/compile-and-run/mandel_test.coil \
;     --link-flag -framework --link-flag AppKit --link-flag -lobjc
;
; COIL_META_MAIN=1 routes metaprogram calls to the REAL main thread (AppKit
; requires it); the driver's main thread services them while the pipeline runs.
;
; Everything here is ordinary Coil: malloc'd framebuffers, f64 math, CoreGraphics
; and the Objective-C runtime over plain C FFI, `while`/`when`/`fmt` macros used
; INSIDE the macro's own body (the tower). None of it is special-cased — the
; metaprogram is just a program.
; ============================================================================
(module mandelbrot)
(import "coil.primitive" :as primitive)
(import "coil.alloc" :as alloc)
(import "coil.alloc" :use *)
(import "coil.slice" :use *)
(import "coil.io" :use *)
(import "coil.fmt" :use *)
(import "coil.control" :use *)

; ---- Objective-C runtime + CoreGraphics, plain C ----------------------------
(extern objc_getClass    :cc c [(ptr i8)] (-> (ptr i8)))
(extern sel_registerName :cc c [(ptr i8)] (-> (ptr i8)))
(extern objc_msgSend     :cc c [(ptr i8) (ptr i8)] (-> (ptr i8)))
(extern CGColorSpaceCreateDeviceRGB :cc c [] (-> (ptr i8)))
(extern CGBitmapContextCreate       :cc c [(ptr i8) i64 i64 i64 i64 (ptr i8) i64] (-> (ptr i8)))
(extern CGBitmapContextCreateImage  :cc c [(ptr i8)] (-> (ptr i8)))
(extern CGContextRelease            :cc c [(ptr i8)] (-> i64))
(extern CGColorSpaceRelease         :cc c [(ptr i8)] (-> i64))
(extern CGImageRelease              :cc c [(ptr i8)] (-> i64))
(extern usleep                      :cc c [i64] (-> i32))
(extern getenv                      :cc c [(ptr i8)] (-> (ptr i8)))

(defstruct CGRect [(x f64) (y f64) (w f64) (h f64)])

; the CLASSIC objc `msg` macro (src/apps/chip8/objc.coil), used INSIDE a metaprogram
; body: its type-syntax arguments ((ptr i8) returns, [CGRect i64 …] argtype
; vectors) make the raw call unparseable as an expression, which is exactly the
; tower's syntactic trigger — it expands here at definition time like anywhere else
(defn mcls [(n (ptr i8))] (-> (ptr i8)) (objc_getClass n))
(defn msel [(n (ptr i8))] (-> (ptr i8)) (sel_registerName n))
(defn msg [(ret Code) (recv Code) (selector Code) (argtypes Code) & (args Code)] (-> Code)
  `(primitive/call-ptr
     (primitive/cast (fnptr c [(ptr i8) (ptr i8) ~@argtypes] ~ret) (primitive/fnptr-of objc_msgSend))
     ~recv ~selector ~@args))

; ---- the view ----------------------------------------------------------------
(defstruct MView [(cx f64) (cy f64) (scale f64) (iters i64) (done i64)])

(const MW 480)
(const MH 320)

; escape-time iteration count for one point (iters = the budget)
(defn mandel-iter [(re f64) (im f64) (iters i64)] (-> i64)
  (let [(mut zr) 0.0 (mut zi) 0.0 (mut k) 0]
    (loop
      (if (>= (load k) iters) (break (load k))
        (let [zr2 (primitive/fmul (load zr) (load zr)) zi2 (primitive/fmul (load zi) (load zi))]
          (if (primitive/fcmp-gt (primitive/fadd zr2 zi2) 4.0) (break (load k))
            (let [nzr (primitive/fadd (primitive/fsub zr2 zi2) re)
                  nzi (primitive/fadd (primitive/fmul 2.0 (primitive/fmul (load zr) (load zi))) im)]
              (do (store! zr nzr) (store! zi nzi)
                  (store! k (primitive/iadd (load k) 1))))))))))

; render the current view into an RGBA framebuffer (malloc'd, MW*MH*4 bytes)
(defn mandel-render [(v (ptr MView)) (buf (ptr u8))] (-> i64)
  (let [scale (load (field v scale))
        left (primitive/fsub (load (field v cx)) (primitive/fdiv scale 2.0))
        aspect (primitive/fdiv (primitive/cast f64 MH) (primitive/cast f64 MW))
        top  (primitive/fsub (load (field v cy)) (primitive/fdiv (primitive/fmul scale aspect) 2.0))
        step (primitive/fdiv scale (primitive/cast f64 MW))
        iters (load (field v iters))
        (mut y) 0]
    (loop (if (>= (load y) MH) (break)
      (do (let [im (primitive/fadd top (primitive/fmul (primitive/cast f64 (load y)) step)) (mut x) 0]
            (loop (if (>= (load x) MW) (break)
              (do (let [re (primitive/fadd left (primitive/fmul (primitive/cast f64 (load x)) step))
                        k (mandel-iter re im iters)
                        o (primitive/imul (primitive/iadd (primitive/imul (load y) MW) (load x)) 4)]
                    (if (>= k iters)
                        (do (store! (primitive/index buf o) (primitive/cast u8 0))
                            (store! (primitive/index buf (primitive/iadd o 1)) (primitive/cast u8 0))
                            (store! (primitive/index buf (primitive/iadd o 2)) (primitive/cast u8 0)) 0)
                      (let [t (primitive/udiv (primitive/imul k 255) iters)
                            r (let [rr (primitive/imul t 3)] (if (> rr (primitive/cast i64 255)) 255 rr))
                            g t
                            b (primitive/isub 255 t)]
                        (do (store! (primitive/index buf o) (primitive/cast u8 r))
                            (store! (primitive/index buf (primitive/iadd o 1)) (primitive/cast u8 g))
                            (store! (primitive/index buf (primitive/iadd o 2)) (primitive/cast u8 b)) 0))))
                  (store! (primitive/index buf (primitive/iadd (primitive/imul (primitive/iadd (primitive/imul (load y) MW) (load x)) 4) 3))
                          (primitive/cast u8 255))
                  (store! x (primitive/iadd (load x) 1))))))
          (store! y (primitive/iadd (load y) 1)))))
    0))

(defn mandel-blit [(layer (ptr i8)) (buf (ptr u8))] (-> i64)
  (let [space (CGColorSpaceCreateDeviceRGB)
        ctx (CGBitmapContextCreate (primitive/cast (ptr i8) buf) MW MH 8 (primitive/imul MW 4) space 1)
        img (CGBitmapContextCreateImage ctx)]
    (msg (ptr i8) layer (msel c"setContents:") [(ptr i8)] img)
    (CGImageRelease img) (CGContextRelease ctx) (CGColorSpaceRelease space)
    0))

; keyDown handling: WASD pan, Z/X zoom, I/O iteration budget, Q or RETURN done
(defn mandel-key [(v (ptr MView)) (ev (ptr i8))] (-> i64)
  (let [chars (msg (ptr i8) ev (msel c"characters") [])]
    (if (= (primitive/cast i64 chars) (primitive/cast i64 0)) 0
      (let [utf (msg (ptr i8) chars (msel c"UTF8String") [])
            ch (primitive/cast i64 (load (primitive/cast (ptr u8) utf)))
            pan (primitive/fdiv (load (field v scale)) 8.0)]
        (cond
          (= ch (primitive/cast i64 97))  (do (store! (field v cx)
                                                      (primitive/fsub (load (field v
                                                                                        cx)) pan)) 0)   ; a
          (= ch (primitive/cast i64 100)) (do (store! (field v cx)
                                                      (primitive/fadd (load (field v
                                                                                        cx)) pan)) 0)   ; d
          (= ch (primitive/cast i64 119)) (do (store! (field v cy)
                                                      (primitive/fsub (load (field v
                                                                                        cy)) pan)) 0)   ; w
          (= ch (primitive/cast i64 115)) (do (store! (field v cy)
                                                      (primitive/fadd (load (field v
                                                                                        cy)) pan)) 0)   ; s
          (= ch (primitive/cast i64 122)) (do (store! (field v scale)
                                                      (primitive/fmul (load (field v
                                                                                        scale)) 0.7)) 0) ; z
          (= ch (primitive/cast i64 120)) (do (store! (field v scale)
                                                      (primitive/fmul (load (field v
                                                                                        scale)) 1.4)) 0) ; x
          (= ch (primitive/cast i64 105)) (do (store! (field v iters)
                                                      (primitive/iadd (load (field v
                                                                                        iters)) 32)) 0)  ; i
          (= ch (primitive/cast i64 111)) (if (> (load (field v iters)) (primitive/cast i64 48))
                               (do (store! (field v iters)
                                           (primitive/isub (load (field v
                                                                                  iters)) 32)) 0) 0) ; o
          (= ch (primitive/cast i64 113)) (do (store! (field v done) 1) 0)   ; q
          (= ch (primitive/cast i64 13))  (do (store! (field v done) 1) 0)   ; return
          0)))))

(defn mandel-pump [(app (ptr i8)) (v (ptr MView)) (mode (ptr i8))] (-> i64)
  (while 1
    (let [ev (msg (ptr i8) app (msel c"nextEventMatchingMask:untilDate:inMode:dequeue:")
                  [i64 (ptr i8) (ptr i8) i64] -1 (primitive/cast (ptr i8) 0) mode 1)]
      (if (= (primitive/cast i64 ev) (primitive/cast i64 0)) (break 0)
        (do (when (= (primitive/call-ptr (primitive/cast (fnptr c [(ptr i8) (ptr i8)] i64)
                                                         (primitive/fnptr-of objc_msgSend))
                                         ev
                                         (msel c"type"))
                     (primitive/cast i64 10)) (mandel-key v ev))
            (msg (ptr i8) app (msel c"sendEvent:") [(ptr i8)] ev)
            0)))))

; ---- THE METAPROGRAM: a GUI session at expansion time -------------------------
(defn mandel-pick [] (-> Code)
  (let [a (malloc-allocator)
        auto (!= (primitive/cast i64 (getenv c"COIL_MANDEL_AUTO")) (primitive/cast i64 0))
        v (unwrap-ptr [MView] (create [MView] a))
        buf (primitive/cast (ptr u8) (unwrap-ptr [i8] (raw-alloc a (primitive/imul (primitive/imul MW MH) 4) 1)))
        app (msg (ptr i8) (mcls c"NSApplication") (msel c"sharedApplication") [])
        rect (alloc/stack CGRect)]
    (store! (field v cx) -0.6) (store! (field v cy) 0.0)
    (store! (field v scale) 3.2) (store! (field v iters) 96) (store! (field v
                                                                                                                    done)
                                                                                         0)
    (store! (field rect x) 240.0) (store! (field rect y) 240.0)
    (store! (field rect w) (primitive/cast f64 MW)) (store! (field rect h) (primitive/cast f64 MH))
    (fmt (stderr) "[mandelbrot] compile-time viewer{s}: WASD pan, Z/X zoom, I/O iters, Q/RETURN accept\n"
         (if auto " (auto)" ""))
    (let [win (msg (ptr i8) (msg (ptr i8) (mcls c"NSWindow") (msel c"alloc") [])
                     (msel c"initWithContentRect:styleMask:backing:defer:")
                     [CGRect i64 i64 i64] (load rect) 15 2 0)
          mode (msg (ptr i8) (mcls c"NSString") (msel c"stringWithUTF8String:") [(ptr i8)] c"kCFRunLoopDefaultMode")]
      ; auto mode: accessory policy, no focus steal; interactive: regular + activate
      (msg (ptr i8) app (msel c"setActivationPolicy:") [i64] (if auto 1 0))
      (msg (ptr i8) (msg (ptr i8) win (msel c"contentView") []) (msel c"setWantsLayer:") [i64] 1)
      (msg (ptr i8) win (msel c"makeKeyAndOrderFront:") [(ptr i8)] (primitive/cast (ptr i8) 0))
      (when (not auto) (do (msg (ptr i8) app (msel c"activateIgnoringOtherApps:") [i64] 1) 0))
      (msg (ptr i8) app (msel c"finishLaunching") [])
      (let [layer (msg (ptr i8) (msg (ptr i8) win (msel c"contentView") []) (msel c"layer") [])
            (mut frame) 0]
        (while (= (load (field v done)) (primitive/cast i64 0))
          (mandel-render v buf)
          (mandel-blit layer buf)
          (mandel-pump app v mode)
          (when auto
            ; a scripted dive toward the seahorse valley, then accept
            (do (store! (field v cx)
                        (primitive/fadd (load (field v cx)) (primitive/fmul (primitive/fsub -0.7436 (load (field v
                                                                                                                                               cx))) 0.18)))
                (store! (field v cy)
                        (primitive/fadd (load (field v cy)) (primitive/fmul (primitive/fsub 0.1318 (load (field v
                                                                                                                                              cy))) 0.18)))
                (store! (field v scale) (primitive/fmul (load (field v scale)) 0.86))
                (when (>= (load frame) (primitive/cast i64 40)) (store! (field v done) 1))))
          (store! frame (primitive/iadd (load frame) 1))
          (usleep 16000))
        (msg (ptr i8) win (msel c"close") [])
        (fmt (stderr) "[mandelbrot] accepted view: center=({f}, {f}) scale={f} iters={d} after {d} frames\n"
             (load (field v cx)) (load (field v cy)) (load (field v
                                                                                                          scale)) (load (field v
                                                                                                                                                     iters)) (load frame))
        `(mandel-chosen ~(load (field v cx)) ~(load (field v cy)) ~(load (field v
                                                                                                                        scale)) ~(load (field v
                                                                                                                                                                    iters)))))))

; ---- the RUNTIME half: what the chosen constants compile into ------------------
; ASCII-render the compile-time-chosen view, so the built program carries the
; GUI session's result visibly.
(defn mandel-chosen [(cx f64) (cy f64) (scale f64) (iters i64)] (-> i64)
  (let [w 78 h 24
        left (primitive/fsub cx (primitive/fdiv scale 2.0))
        top (primitive/fsub cy (primitive/fdiv (primitive/fmul scale 0.66) 2.0))
        xstep (primitive/fdiv scale (primitive/cast f64 w))
        ystep (primitive/fdiv (primitive/fmul scale 0.66) (primitive/cast f64 h))
        ramp " .:-=+*#%@"
        (mut y) 0]
    (fmt (stdout) "view chosen in the COMPILE-TIME GUI: center=({f}, {f}) scale={f} iters={d}\n"
         cx cy scale iters)
    (loop (if (>= (load y) h) (break)
      (do (let [(mut x) 0]
            (loop (if (>= (load x) w) (break)
              (do (let [re (primitive/fadd left (primitive/fmul (primitive/cast f64 (load x)) xstep))
                        im (primitive/fadd top (primitive/fmul (primitive/cast f64 (load y)) ystep))
                        k (mandel-iter re im iters)
                        ci (if (>= k iters) 9 (primitive/udiv (primitive/imul k 9) iters))]
                    (write-byte (stdout) (slice-get ramp ci)))
                  (store! x (primitive/iadd (load x) 1))))))
          (write-byte (stdout) (primitive/cast u8 10))
          (store! y (primitive/iadd (load y) 1)))))
    0))
