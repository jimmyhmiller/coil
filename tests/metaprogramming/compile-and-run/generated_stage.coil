(module generated_stage)
(import "coil.primitive" :as primitive)

;; A before-expand metaprogram can introduce a later native stage using only
;; ordinary Coil forms. The generated definition is also the fixpoint marker.
(defn stage-installed? [(m Code) (i i64) (n i64)] (-> bool)
  (if (>= i n) false
    (let [f (primitive/code-nth m i)]
      (if (and (primitive/code-list? f)
               (and (> (primitive/code-count f) 1)
                    (primitive/code-eq (primitive/code-nth f 1) `generated-stage)))
          true
        (stage-installed? m (+ i 1) n)))))

(defn stage-tail [(m Code) (i i64) (n i64)] (-> Code)
  (if (>= i n) `()
    `(~(primitive/code-nth m i) ~@(stage-tail m (+ i 1) n))))

(defn stage-module [(m Code)] (-> Code)
  (if (and (> (primitive/code-count m) 0)
           (primitive/code-eq (primitive/code-nth m 0) `generated_stage_test))
      (if (stage-installed? m 1 (primitive/code-count m)) m
        `(~(primitive/code-nth m 0)
          ~@(stage-tail m 1 (primitive/code-count m))

          (import "coil.primitive" :as primitive)

          ;; A Code -> Code function is a staged Coil callable. Although this
          ;; definition was generated by a syntax transform, ordinary expansion
          ;; must discover it, compile it natively, and invoke it.
          (defn generated-stage [(x Code)] (-> Code)
            (if (primitive/code-list? x)
                (primitive/code-nth x 2)
              x))))
    m))

(defn stage-modules [(mods Code) (i i64) (n i64)] (-> Code)
  (if (>= i n) `()
    `(~(stage-module (primitive/code-nth mods i))
      ~@(stage-modules mods (+ i 1) n))))

(defn install-generated-stage [(mods Code)] (-> Code)
  `(do ~@(stage-modules mods 0 (primitive/code-count mods))))

(transform install-generated-stage :phase before-expand)
