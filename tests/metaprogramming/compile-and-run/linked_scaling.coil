(module linked_scaling)
(import "coil.primitive" :as primitive)

;; Deliberately retains the formerly quadratic recursive suffix-splice shape.
(defn linked-suffix [(n i64)] (-> Code)
  (if (= n 0) `()
    `(x ~@(linked-suffix (- n 1)))))

(defn linked-scale [(n Code)] (-> Code)
  `~(primitive/code-count (linked-suffix (primitive/code-int n))))

