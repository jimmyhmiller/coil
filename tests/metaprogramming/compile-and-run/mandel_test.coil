(module mandel_test)

; An ordinary program compiled unchanged after a GUI checker runs.
;
;   COIL_META_MAIN=1 coil run tests/metaprogramming/compile-and-run/mandel_test.coil \
;     --use mandelbrot \
;     --link-flag -framework --link-flag AppKit --link-flag -lobjc
;
; The build opens a Mandelbrot viewer (WASD pan, Z/X zoom, I/O iters, Q/RETURN
; close); afterward this original program runs normally.
; COIL_MANDEL_AUTO=1 scripts the session (reproducible builds / CI).
(import "coil.fmt" :use *)
(import "coil.io" :use *)

(defn main [] (-> i64)
  (do
    (fmt (stdout) "ordinary program ran unchanged\n")
    0))
