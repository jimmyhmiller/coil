(module mhost2)
(import "coil.primitive" :as primitive)
(import "coil.alloc" :use *)
(import "coil.arraylist" :use *)
(import "coil.slice" :use *)
(import "coil.io"  :use *)
(import "coil.fmt" :use *)
(import "coil.result" :use *)
(import "coil.reader" :use *)

(extern dlopen :cc c [(ptr i8) :i64] (-> (ptr i8)))
(extern dlsym  :cc c [(ptr i8) (ptr i8)] (-> (ptr i8)))

(defn mk-cstr [(a (dyn Allocator)) (s (slice u8))] (-> (ptr i8))
  (let [n (slice-len s)
        buf (primitive/cast (ptr i8)
                            (match (alloc-bytes a (primitive/iadd n 1) 1)
                              (None [] (do (oom-at c"C string" (primitive/iadd n 1))
                                           (primitive/cast (ptr u8) 0)))
                              (Some [memory] (slice-data memory))))
        (mut i) 0]
    (loop (if (>= (load i) n) (break)
      (do (store! (primitive/index buf (load i)) (primitive/cast i8 (slice-get s (load i))))
          (store! i (primitive/iadd (load i) 1)))))
    (store! (primitive/index buf n) (primitive/cast i8 0))
    buf))

(defn main [] (-> :i64)
  (let [al (malloc-allocator)]
    ; build a REAL Sexp with the compiler's real reader
    (match (read-all al "(defn f [x] (primitive/iadd x 1))" 0)
      (Err [d] (do (fmt (stdout) "read failed\n") 1))
      (Ok [forms]
        (let [sp (box! al Sexp (zeroed Sexp))
              h  (dlopen (mk-cstr al "meta2.dylib") 2)]
          (store! sp (al-get [Sexp] (load forms) 0))
          (if (= (primitive/cast :i64 h) (primitive/cast i64 0))
              (do (fmt (stdout) "dlopen FAILED\n") 1)
            (let [f (dlsym h (mk-cstr al "meta_syms"))]
              (if (= (primitive/cast :i64 f) (primitive/cast i64 0))
                  (do (fmt (stdout) "dlsym FAILED\n") 1)
                (do (do
                      (fmt (stdout) "codelib walk: syms in (defn f [x] (primitive/iadd x 1)) = {d} (expect 5)\n"
                           (primitive/call-ptr (primitive/cast (fnptr c [(ptr Sexp)] :i64) f) sp))
                      (let [g (dlsym h (mk-cstr al "meta_build"))]
                        (fmt (stdout) "codelib build: len*100 + third = {d} (expect 342)\n"
                             (primitive/call-ptr (primitive/cast (fnptr c [] :i64) g)))))
                    0)))))))))
