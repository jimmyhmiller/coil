(module linked_code_lists)
(import "coil.primitive" :as primitive)

(defn build-pairs [(n i64) (out Code)] (-> Code)
  (if (= n 0) out
    (build-pairs (- n 1) (primitive/code-cons `x out))))

; This is the historical quadratic shape. The native quasiquote builder must
; retain the recursive splice as the exact tail instead of copying it.
(defn build-spliced [(n i64)] (-> Code)
  (if (= n 0) `()
    `(x ~@(build-spliced (- n 1)))))

; Behavioral coverage for the persistent Code spine API. Construction deliberately
; avoids quasiquote splicing: every added element must be one O(1) pair allocation.
(defn linked-probe [] (-> Code)
  (let [prototype `(prototype)
        nil (primitive/code-nil-like prototype)
        c (primitive/code-cons `c nil)
        b (primitive/code-cons `b c)
        xs (primitive/code-cons-like prototype `a b)
        tail (primitive/code-cdr xs)
        dotted (primitive/code-cons `left `right)]
    `~(if (and (primitive/code-pair? xs)
               (and (not (primitive/code-null? xs))
                    (and (primitive/code-eq (primitive/code-car xs) `a)
                         (and (primitive/code-eq (primitive/code-car tail) `b)
                              (and (primitive/code-eq (primitive/code-cdr tail) c)
                                   (and (= (primitive/code-count xs) 3)
                                        (and (primitive/code-eq (primitive/code-nth xs 2) `c)
                                             (and (primitive/code-null? (primitive/code-cdr c))
                                                  (and (primitive/code-pair? dotted)
                                                       (and (primitive/code-eq (primitive/code-car dotted) `left)
                                                            (and (primitive/code-eq (primitive/code-cdr dotted) `right)
                                                                 (and (not (primitive/code-list? `#(a b)))
                                                                      (and (not (primitive/code-pair? `#(a b)))
                                                                           (= (primitive/code-line xs)
                                                                              (primitive/code-line prototype)))))))))))))))
           42
           1)))

(defn linear-probe [] (-> Code)
  `~(+ (primitive/code-count (build-pairs 10000 `()))
       (primitive/code-count (build-spliced 10000))))

(defn main [] (-> i64)
  (if (= (linked-probe) 42)
      (linear-probe)
    1))
