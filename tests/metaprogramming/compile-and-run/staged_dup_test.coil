(module staged_dup_test)
(import "staged_dup" :use *)

;;; Both guest forms are present; the transform consumes one per round and
;;; declares the same stage entry name twice. Expect a located hard error:
;;;   stage: definition 'staged_dup_test.dup-entry' was introduced more than once
(defn main [] (-> i64)
  (dup-now)
  (dup-again)
  0)
