(module tower_ordinary_code_helper)
(import "coil.primitive" :as primitive)

; A mixed-signature metaprogram helper is phase code even though it is not a
; surface macro entry itself.
(defn code-pair-width [(pair Code)] (-> i64)
  (primitive/code-count pair))

(defn code-pair-second [(pair Code)] (-> Code)
  (primitive/code-nth pair 1))
