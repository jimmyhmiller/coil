(module staged_xmod)
(import "coil.primitive" :as primitive)

;; Cross-module routing fixture: the stage declaration lands in module
;; staged_xmod_lib's record, while requests are rewritten wherever `(xpick ...)`
;; appears — including module staged_xmod_test. The marker/entry table is
;; compilation-scoped, so a request in one module resolves an entry declared
;; from another module's transform output.
(defn xp-found? [(x Code) (i i64) (n i64)] (-> bool)
  (if (>= i n)
      false
      (if (xp-tree-found? (primitive/code-nth x i))
          true
          (xp-found? x (+ i 1) n))))

(defn xp-tree-found? [(x Code)] (-> bool)
  (if (not (primitive/code-list? x))
      false
      (if (and (> (primitive/code-count x) 0)
               (primitive/code-eq (primitive/code-nth x 0) `xpick))
          true
          (xp-found? x 0 (primitive/code-count x)))))

(defn xp-wrap-items [(x Code) (i i64) (n i64) (marker Code)] (-> Code)
  (if (>= i n)
      `()
      `(~(xp-wrap (primitive/code-nth x i) marker) ~@(xp-wrap-items x (+ i 1) n marker))))

(defn xp-wrap [(x Code) (marker Code)] (-> Code)
  (if (not (primitive/code-list? x))
      x
      (if (= (primitive/code-count x) 0)
          x
          (let [head (primitive/code-nth x 0)]
            (if (primitive/code-eq head `quote)
                x
                (if (primitive/code-eq head `xpick)
                    `(~marker "staged_xmod_lib.xpick-entry"
                        ~@(xp-wrap-items x 1 (primitive/code-count x) marker))
                    `(~@(xp-wrap-items x 0 (primitive/code-count x) marker))))))))

(defn xp-tail [(m Code) (i i64) (n i64) (marker Code)] (-> Code)
  (if (>= i n)
      `()
      `(~(xp-wrap (primitive/code-nth m i) marker) ~@(xp-tail m (+ i 1) n marker))))

(defn xp-module [(m Code) (marker Code)] (-> Code)
  (if (not (xp-tree-found? m))
      m
      `(~(primitive/code-nth m 0) ~@(xp-tail m 1 (primitive/code-count m) marker))))

(defn xp-lib-module? [(m Code)] (-> bool)
  (and (> (primitive/code-count m) 0)
       (primitive/code-eq (primitive/code-nth m 0) `staged_xmod_lib)))

(defn xp-any-found? [(mods Code) (i i64) (n i64)] (-> bool)
  (if (>= i n)
      false
      (if (xp-tree-found? (primitive/code-nth mods i))
          true
          (xp-any-found? mods (+ i 1) n))))

(defn xp-modules [(mods Code) (i i64) (n i64) (marker Code) (declare bool)] (-> Code)
  (if (>= i n)
      `()
      (let [m (primitive/code-nth mods i)
            rewritten (xp-module m marker)]
        (if (and declare (xp-lib-module? m))
            `((~(primitive/code-nth rewritten 0) ~@(xp-tail rewritten 1 (primitive/code-count rewritten) marker)
                 (stage ~marker
                        (import "coil.primitive" :as primitive)
                        (defn xpick-entry [(x Code)] (-> Code)
                          (primitive/code-nth x 1)))) ~@(xp-modules mods (+ i 1) n marker declare))
            `(~rewritten ~@(xp-modules mods (+ i 1) n marker declare))))))

(defn install-staged-xmod [(mods Code)] (-> Code)
  (let [n (primitive/code-count mods)]
    (if (not (xp-any-found? mods 0 n))
        `(do ~@(xp-modules mods 0 n `nomarker false))
        (let [marker (primitive/gensym)]
          `(do ~@(xp-modules mods 0 n marker true))))))

(transform install-staged-xmod :phase before-expand)
