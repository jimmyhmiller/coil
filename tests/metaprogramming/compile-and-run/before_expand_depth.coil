(module before_expand_depth)
(import "coil.primitive" :as primitive)

; Count nested list/vector nodes. This checker deliberately needs the surface tree:
; both macros below disappear before semantic checkers normally run.
(defn syntax-depth [(node Code)] (-> i64)
  (if (primitive/code-list? node)
      (primitive/iadd 1 (syntax-depth-kids node 0 (primitive/code-count node) 0))
      0))

(defn syntax-depth-kids [(node Code) (i i64) (n i64) (best i64)] (-> i64)
  (if (>= i n)
      best
      (let [d (syntax-depth (primitive/code-nth node i))]
        (syntax-depth-kids node
                           (primitive/iadd i 1)
                           n
                           (if (> d best) d best)))))

(defn audit-depth-node [(node Code)] (-> Code)
  (if (and (primitive/code-list? node)
           (and (> (primitive/code-count node) (primitive/cast i64 0))
                (primitive/code-eq (primitive/code-nth node 0) `depth-target)))
      (if (= (syntax-depth node) (primitive/cast i64 3))
          (do (primitive/warn node "before-expand observed raw depth 3") `0)
          (do (primitive/report node "before-expand calculated the wrong raw depth") `0))
      (audit-depth-kids node 0 (if (primitive/code-list? node) (primitive/code-count node) 0))))

(defn audit-depth-kids [(node Code) (i i64) (n i64)] (-> Code)
  (if (>= i n)
      `0
      (do
        (audit-depth-node (primitive/code-nth node i))
        (audit-depth-kids node (primitive/iadd i 1) n))))

(defn audit-depth [(modules Code)] (-> Code)
  (audit-depth-kids modules 0 (primitive/code-count modules)))

(defn wrap [(x Code)] (-> Code)
  `(do ~x))
(defn depth-target [(x Code)] (-> Code)
  x)

(checker audit-depth :phase before-expand)

(defn main [] (-> i64)
  (depth-target (wrap (wrap 0))))
