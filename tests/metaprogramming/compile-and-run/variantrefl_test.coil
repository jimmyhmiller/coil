(module variantrefl_test)
(import "coil.primitive" :as primitive)
; Per-variant PAYLOAD reflection: code-variant-field-name / code-variant-field-type
; (SUM VARIANT-INDEX FIELD-INDEX). The type comes back STRUCTURED — (Option
; (slice u8)), not a bare Option head — which is what a post-hoc sum derive
; needs. Exit encodes each probe as a digit: 111111 = all six right.
(defsum Shape
  (Circle [(r f64)])
  (Rect   [(w i64) (label (slice u8)) (extra (Option (slice u8)))])
  (Point))

(defn bit [(ok bool)] (-> i64) (if ok 1 0))

(defn probe [] (-> Code)
  (let [n0 (primitive/code-variant-field-name `Shape 0 0)        ; r
        t0 (primitive/code-variant-field-type `Shape 0 0)        ; f64
        n1 (primitive/code-variant-field-name `Shape 1 1)        ; label
        t1 (primitive/code-variant-field-type `Shape 1 1)        ; (slice u8)
        t2 (primitive/code-variant-field-type `Shape 1 2)        ; qualified: (coil.core.Option (slice u8))
        nf (primitive/code-variant-fields `Shape 1)]             ; 3
    `~(primitive/iadd
        (primitive/imul 100000 (bit (primitive/code-eq n0 `r)))
        (primitive/iadd
          (primitive/imul 10000 (bit (primitive/code-eq t0 `f64)))
          (primitive/iadd
            (primitive/imul 1000 (bit (primitive/code-eq n1 `label)))
            (primitive/iadd
              (primitive/imul 100 (bit (primitive/code-eq t1 `(slice u8))))
              (primitive/iadd
                (primitive/imul 10 (bit (primitive/code-eq t2 `(coil.core.Option (slice u8)))))
                (bit (= nf (primitive/cast i64 3))))))))))

; 111111 mod 256 = exit code; assert the full value in-program instead
(defn main [] (-> :i64)
  (if (= (probe) (cast i64 111111)) 42 1))
