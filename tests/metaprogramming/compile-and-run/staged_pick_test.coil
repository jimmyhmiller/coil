(module staged_pick_test)
(import "staged_pick" :use *)

;;; `staged-pick` exists only inside a generated `(stage ...)` declaration: it is
;;; compiled for expansion and must never enter this runtime program. The request
;;; receives the raw list `(1 42 7)` and picks index 1 at expansion time; the
;;; quoted use below stays data because markers never descend into quotes.
(defn main [] (-> i64)
  (staged-pick (1 42 7)))
