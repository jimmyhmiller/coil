(module scheme_syntax_object)
(import "coil.primitive" :as primitive)

(defn syntax-object-call? [(x Code)] (-> bool)
  (if (not (primitive/code-list? x)) false
    (if (and (> (primitive/code-count x) 0)
             (primitive/code-eq (primitive/code-nth x 0) `syntax-roundtrip))
        true
      (syntax-object-call-items? x 0 (primitive/code-count x)))))

(defn syntax-object-call-items? [(x Code) (i i64) (n i64)] (-> bool)
  (if (>= i n) false
    (if (syntax-object-call? (primitive/code-nth x i)) true
      (syntax-object-call-items? x (+ i 1) n))))

(defn syntax-object-wrap-items [(x Code) (i i64) (n i64) (marker Code)] (-> Code)
  (if (>= i n) `()
    `(~(syntax-object-wrap (primitive/code-nth x i) marker)
      ~@(syntax-object-wrap-items x (+ i 1) n marker))))

(defn syntax-object-wrap [(x Code) (marker Code)] (-> Code)
  (if (primitive/code-vector? x)
      `#(~@(syntax-object-wrap-items x 0 (primitive/code-count x) marker))
    (if (not (primitive/code-list? x)) x
      (if (= (primitive/code-count x) 0) x
        (let [head (primitive/code-nth x 0)]
          (if (primitive/code-eq head `quote) x
            (if (primitive/code-eq head `syntax-roundtrip)
                `(~marker "scheme_syntax_object_test.syntax-roundtrip"
                   ~@(syntax-object-raw-items x 1 (primitive/code-count x)))
              `(~@(syntax-object-wrap-items x 0 (primitive/code-count x) marker)))))))))

(defn syntax-object-raw-items [(x Code) (i i64) (n i64)] (-> Code)
  (if (>= i n) `()
    `(~(primitive/code-nth x i)
      ~@(syntax-object-raw-items x (+ i 1) n))))

(defn syntax-object-tail [(m Code) (i i64) (n i64) (marker Code)] (-> Code)
  (if (>= i n) `()
    `(~(syntax-object-wrap (primitive/code-nth m i) marker)
      ~@(syntax-object-tail m (+ i 1) n marker))))

(defn syntax-object-module [(m Code)] (-> Code)
  (if (and (> (primitive/code-count m) 0)
           (primitive/code-eq (primitive/code-nth m 0) `scheme_syntax_object_test))
      (if (not (syntax-object-call? m)) m
        (let [marker (primitive/gensym)]
          `(~(primitive/code-nth m 0)
            ~@(syntax-object-tail m 1 (primitive/code-count m) marker)
            (stage ~marker
              (import "coil.scheme.syntax" :use *)
              (import "coil.scheme.heap" :use [car cdr])
              (defn syntax-roundtrip [(form Code)] (-> Code)
                (let [stx (syntax-object-from-code form)
                      items (syntax->list stx)
                      datum (syntax->datum (car (cdr items)))]
                  (syntax-object-code
                    (datum->syntax (car items) datum))))))))
    m))

(defn syntax-object-modules [(mods Code) (i i64) (n i64)] (-> Code)
  (if (>= i n) `()
    `(~(syntax-object-module (primitive/code-nth mods i))
      ~@(syntax-object-modules mods (+ i 1) n))))

(defn install-syntax-object-test [(mods Code)] (-> Code)
  `(do ~@(syntax-object-modules mods 0 (primitive/code-count mods))))

(transform install-syntax-object-test :phase before-expand)
