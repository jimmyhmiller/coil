(module scheme_syntax_object)
(import "coil.scheme.syntax" :use *)

;; The boundary must retain the exact Code object, not reconstruct an equal
;; datum. Source identity and hygiene ride on this pointer in real syntax-case
;; transformers.
(defn syntax-roundtrip [(form Code)] (-> Code)
  (syntax-object-code (syntax-object-from-code form)))

(defn main [] (-> i64)
  (syntax-roundtrip 42))
