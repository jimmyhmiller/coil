(module staged_dup)
(import "coil.primitive" :as primitive)

;; Negative fixture: "cumulative" must not mean accidental shadowing. The
;; transform consumes `(dup-now)` in round 1 and `(dup-again)` in round 2, each
;; time declaring a stage entry with the SAME name; the second declaration must
;; be a hard error, not a silent redefinition.
(defn dup-found? [(x Code) (name Code) (i i64) (n i64)] (-> bool)
  (if (>= i n)
      false
      (if (dup-tree-found? (primitive/code-nth x i) name)
          true
          (dup-found? x name (+ i 1) n))))

(defn dup-tree-found? [(x Code) (name Code)] (-> bool)
  (if (not (primitive/code-list? x))
      false
      (if (and (> (primitive/code-count x) 0)
               (primitive/code-eq (primitive/code-nth x 0) name))
          true
          (dup-found? x name 0 (primitive/code-count x)))))

(defn dup-wrap-items [(x Code) (i i64) (n i64) (name Code) (marker Code)] (-> Code)
  (if (>= i n)
      `()
      `(~(dup-wrap (primitive/code-nth x i) name marker) ~@(dup-wrap-items x (+ i 1) n name marker))))

(defn dup-wrap [(x Code) (name Code) (marker Code)] (-> Code)
  (if (not (primitive/code-list? x))
      x
      (if (= (primitive/code-count x) 0)
          x
          (let [head (primitive/code-nth x 0)]
            (if (primitive/code-eq head `quote)
                x
                (if (primitive/code-eq head name)
                    `(~marker staged_dup_test.dup-entry)
                    `(~@(dup-wrap-items x 0 (primitive/code-count x) name marker))))))))

(defn dup-tail [(m Code) (i i64) (n i64) (name Code) (marker Code)] (-> Code)
  (if (>= i n)
      `()
      `(~(dup-wrap (primitive/code-nth m i) name marker) ~@(dup-tail m (+ i 1) n name marker))))

(defn dup-stage [(m Code) (name Code)] (-> Code)
  (let [marker (primitive/gensym)]
    `(~(primitive/code-nth m 0) ~@(dup-tail m 1 (primitive/code-count m) name marker)
        (stage ~marker
               (defn dup-entry [] (-> Code)
                 `42)))))

(defn dup-module [(m Code)] (-> Code)
  (if (not (and (> (primitive/code-count m) 0)
                (primitive/code-eq (primitive/code-nth m 0) `staged_dup_test)))
      m
      (if (dup-tree-found? m `dup-now)
          (dup-stage m `dup-now)
          (if (dup-tree-found? m `dup-again)
              (dup-stage m `dup-again)
              m))))

(defn dup-modules [(mods Code) (i i64) (n i64)] (-> Code)
  (if (>= i n)
      `()
      `(~(dup-module (primitive/code-nth mods i)) ~@(dup-modules mods (+ i 1) n))))

(defn install-staged-dup [(mods Code)] (-> Code)
  `(do ~@(dup-modules mods 0 (primitive/code-count mods))))

(transform install-staged-dup :phase before-expand)
