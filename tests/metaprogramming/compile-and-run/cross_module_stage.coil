(module cross_module_stage)
(import "coil.primitive" :as primitive)

(defn cross-call? [(x Code)] (-> bool)
  (if (not (primitive/code-list? x)) false
    (if (and (> (primitive/code-count x) 0)
             (primitive/code-eq (primitive/code-nth x 0) `cross-pick))
        true
      (cross-call-items? x 0 (primitive/code-count x)))))

(defn cross-call-items? [(x Code) (i i64) (n i64)] (-> bool)
  (if (>= i n) false
    (if (cross-call? (primitive/code-nth x i)) true
      (cross-call-items? x (+ i 1) n))))

(defn cross-modules-call? [(mods Code) (i i64) (n i64)] (-> bool)
  (if (>= i n) false
    (if (cross-call? (primitive/code-nth mods i)) true
      (cross-modules-call? mods (+ i 1) n))))

(defn cross-wrap-items [(x Code) (i i64) (n i64) (marker Code)] (-> Code)
  (if (>= i n) `()
    `(~(cross-wrap (primitive/code-nth x i) marker)
      ~@(cross-wrap-items x (+ i 1) n marker))))

(defn cross-wrap [(x Code) (marker Code)] (-> Code)
  (if (primitive/code-vector? x)
      `#(~@(cross-wrap-items x 0 (primitive/code-count x) marker))
    (if (not (primitive/code-list? x)) x
      (if (= (primitive/code-count x) 0) x
        (let [head (primitive/code-nth x 0)]
          (if (primitive/code-eq head `quote) x
            (if (primitive/code-eq head `cross-pick)
                `(~marker "cross_module_stage.cross-pick"
                   ~@(cross-wrap-items x 1 (primitive/code-count x) marker))
              `(~@(cross-wrap-items x 0 (primitive/code-count x) marker)))))))))

(defn cross-tail [(m Code) (i i64) (n i64) (marker Code)] (-> Code)
  (if (>= i n) `()
    `(~(cross-wrap (primitive/code-nth m i) marker)
      ~@(cross-tail m (+ i 1) n marker))))

(defn cross-module [(m Code) (active bool) (marker Code)] (-> Code)
  (if (= (primitive/code-count m) 0) m
    (let [name (primitive/code-nth m 0)]
      (if (primitive/code-eq name `cross_module_stage_test)
          `(~name ~@(cross-tail m 1 (primitive/code-count m) marker))
        (if (and active (primitive/code-eq name `cross_module_stage))
            `(~@(cross-tail m 0 (primitive/code-count m) marker)
              (stage ~marker
                (defn cross-pick [(x Code)] (-> Code) x)))
          m)))))

(defn cross-modules [(mods Code) (i i64) (n i64)
                      (active bool) (marker Code)] (-> Code)
  (if (>= i n) `()
    `(~(cross-module (primitive/code-nth mods i) active marker)
      ~@(cross-modules mods (+ i 1) n active marker))))

(defn install-cross-module-stage [(mods Code)] (-> Code)
  (let [active (cross-modules-call? mods 0 (primitive/code-count mods))
        marker (primitive/gensym)]
    `(do ~@(cross-modules mods 0 (primitive/code-count mods) active marker))))

(transform install-cross-module-stage :phase before-expand)
