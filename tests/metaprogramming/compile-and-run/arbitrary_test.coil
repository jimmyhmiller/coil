(module arbitrary_test)
(import "coil.primitive" :as primitive)

; Run with the COMPILED metaprogram engine (the interpreter cannot run these
; macros — generics, HashMap, FFI, malloc at compile time):
;   COIL_META=compiled coil run tests/metaprogramming/compile-and-run/arbitrary_test.coil
; Exit code 0 = every compile-time computation matched.
(import "arbitrary" :use *)

(defn main [] (-> :i64)
  ; sum of squares 1..10 = 385, computed via a generic ArrayList in the macro
  (let [a (sum-squares 10)
        ; compile-time HashMap lookups
        b (table-lookup answer)
        c (table-lookup year)
        ; libc strlen at expansion time
        d (static-strlen "hello, metaprogram")
        ; a NAME built with StrBuf; its binder/reference share one syntax object
        e (named-value temp 3 99)]
    (if (!= a (primitive/cast i64 385))
        1
        (if (!= b (primitive/cast i64 42))
            2
            (if (!= c (primitive/cast i64 2026))
                3
                (if (!= d (primitive/cast i64 18))
                    4
                    (if (!= e (primitive/cast i64 99))
                        5
                        0)))))))
