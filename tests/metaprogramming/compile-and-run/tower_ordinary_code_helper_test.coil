(module tower_ordinary_code_helper_test)
(import "tower_ordinary_code_helper" :as helper)

; `cond` must expand at definition time. Its expansion retains the ordinary
; imported Code call in the selected branch; the tower must not reuse cond's
; diagnostic span and execute that helper as another macro.
(defn second-from-pair [(pair Code)] (-> Code)
  (cond (= (helper/code-pair-width pair) 2) (helper/code-pair-second pair)
        :else `0))

(defn main [] (-> i64)
  (if (= (second-from-pair (pair 7)) 7) 0 1))
