(module isolated_stage)
(import "coil.primitive" :as primitive)

(defn isolated-call? [(x Code) (i i64) (n i64)] (-> bool)
  (if (>= i n) false
    (if (isolated-tree-call? (primitive/code-nth x i))
        true
        (isolated-call? x (+ i 1) n))))

(defn isolated-tree-call? [(x Code)] (-> bool)
  (if (not (primitive/code-list? x)) false
    (if (and (> (primitive/code-count x) 0)
             (primitive/code-eq (primitive/code-nth x 0) `isolated-pick))
          true
        (isolated-call? x 0 (primitive/code-count x)))))

(defn isolated-tail [(m Code) (i i64) (n i64) (marker Code)] (-> Code)
  (if (>= i n) `()
    `(~(isolated-wrap (primitive/code-nth m i) marker)
      ~@(isolated-tail m (+ i 1) n marker))))

(defn isolated-wrap-items [(x Code) (i i64) (n i64) (marker Code)] (-> Code)
  (if (>= i n) `()
    `(~(isolated-wrap (primitive/code-nth x i) marker)
      ~@(isolated-wrap-items x (+ i 1) n marker))))

(defn isolated-wrap [(x Code) (marker Code)] (-> Code)
  (if (primitive/code-vector? x)
      `#(~@(isolated-wrap-items x 0 (primitive/code-count x) marker))
    (if (not (primitive/code-list? x)) x
      (if (= (primitive/code-count x) 0) x
        (let [head (primitive/code-nth x 0)]
          (if (primitive/code-eq head `quote) x
            (if (primitive/code-eq head `isolated-pick)
                `(~marker "isolated_stage_test.isolated-pick"
                   ~@(isolated-wrap-items x 1 (primitive/code-count x) marker))
              `(~@(isolated-wrap-items x 0 (primitive/code-count x) marker)))))))))

(defn isolated-module [(m Code)] (-> Code)
  (if (and (> (primitive/code-count m) 0)
           (primitive/code-eq (primitive/code-nth m 0) `isolated_stage_test))
      (if (not (isolated-tree-call? m)) m
        (let [marker (primitive/gensym)]
          `(~(primitive/code-nth m 0)
            ~@(isolated-tail m 1 (primitive/code-count m) marker)
            (stage ~marker
              (defn isolated-pick [(x Code)] (-> Code)
                x)))))
    m))

(defn isolated-modules [(mods Code) (i i64) (n i64)] (-> Code)
  (if (>= i n) `()
    `(~(isolated-module (primitive/code-nth mods i))
      ~@(isolated-modules mods (+ i 1) n))))

(defn install-isolated-stage [(mods Code)] (-> Code)
  `(do ~@(isolated-modules mods 0 (primitive/code-count mods))))

(transform install-isolated-stage :phase before-expand)
