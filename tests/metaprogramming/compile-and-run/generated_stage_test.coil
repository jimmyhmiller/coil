(module generated_stage_test)
(import "generated_stage" :use *)

;; generated-stage does not exist in the loaded source. It inspects this raw
;; `(do ...)` form and selects its third child. Exit 42 therefore proves that the
;; syntax transform generated it and the later native stage compiled and ran it.
(defn main [] (-> i64)
  (generated-stage (do 0 42)))
