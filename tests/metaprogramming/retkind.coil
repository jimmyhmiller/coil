(module retkind)
(import "coil.primitive" :as primitive)
; A SEMANTIC TRANSFORMER. `(retkind (f …))` is a marker whose wrapped call's callee
; is inspected: the transform reads f's REAL declared return type from the checked
; program (`code-decl`) and rewrites the marker to `1` if f returns a pointer, else
; `2`. This needs post-typecheck signatures — impossible for a syntactic transform —
; and the pipeline re-resolves + re-typechecks the rewritten program to a fixpoint.
; Idempotent: the `retkind` marker is removed, so a second pass changes nothing.
;
; The marker `retkind` is a real generic identity `[(x T)] -> i64` returning 0, so
; the ORIGINAL program typechecks and (un-transformed) would return 0. The transform
; makes it return a value derived from the callee's type — proof it read real work.

(defn callee-returns-ptr? [(call Code)] (-> bool)
  (if (and (primitive/code-list? call) (> (primitive/code-count call) (primitive/cast i64 0)))
      (let [head (primitive/code-car call)]
        (if (primitive/code-sym? head)
            (let [d (primitive/code-decl head)]
              (if (and (primitive/code-list? d) (and (>= (primitive/code-count d) (primitive/cast i64 5)) (primitive/code-eq (primitive/code-nth d 2) `fn)))
                  (let [ret (primitive/code-nth d 4)]
                    (and (primitive/code-list? ret) (and (> (primitive/code-count ret) (primitive/cast i64 0)) (primitive/code-eq (primitive/code-car ret) `ptr))))
                false))
          false))
    false))

; does form `f` contain a (retkind …) marker anywhere? (only rebuild subtrees that do,
; so untouched forms — and their vectors — are preserved exactly)
(defn has-marker? [(f Code)] (-> bool)
  (if (primitive/code-list? f)
      (if (and (> (primitive/code-count f) (primitive/cast i64 0)) (primitive/code-eq (primitive/code-car f) `retkind)) true
        (has-marker-kids? f 0 (primitive/code-count f)))
    false))
(defn has-marker-kids? [(f Code) (i i64) (n i64)] (-> bool)
  (if (>= i n) false (if (has-marker? (primitive/code-nth f i)) true (has-marker-kids? f (primitive/iadd i 1) n))))

(defn rewrite [(f Code)] (-> Code)
  (if (primitive/code-list? f)
      (if (and (> (primitive/code-count f) (primitive/cast i64 0)) (primitive/code-eq (primitive/code-car f) `retkind))
          (if (callee-returns-ptr? (primitive/code-nth f 1)) `1 `2)
        (if (has-marker? f) `(~@(rewrite-kids f 0 (primitive/code-count f))) f))
    f))
(defn rewrite-kids [(f Code) (i i64) (n i64)] (-> Code)
  (if (>= i n) `()
    `(~(rewrite (primitive/code-nth f i)) ~@(rewrite-kids f (primitive/iadd i 1) n))))
; MODULE-SHAPED: rewrite each module's forms (primitive/index 0 is the module name).
(defn retkind-mod [(m Code)] (-> Code)
  `(~(primitive/code-car m) ~@(rewrite-kids m 1 (primitive/code-count m))))
(defn retkind-mods [(mods Code) (i i64) (n i64)] (-> Code)
  (if (>= i n) `()
    `(~(retkind-mod (primitive/code-nth mods i)) ~@(retkind-mods mods (primitive/iadd i 1) n))))
(defn retkind-dialect [(prog Code)] (-> Code)
  `(do ~@(retkind-mods prog 0 (primitive/code-count prog))))
