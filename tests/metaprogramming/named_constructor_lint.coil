(module named-constructor-lint-test)
(import "coil.lint.named-constructor" :as named-constructor-lint)

(defsum Event
  (Moved [(x i64) (y i64) (at i64)])
  (Sized [(width i64) (height i64)]))

(defstruct Sample [(first i64) (second i64) (third i64)])

(defn main [] (-> i64)
  (let [event
          (Moved
            :x 1
            :y 2
            :at 3)
        small (Sized 4 5)
        sample
          (Sample
            :first 6
            :second 7
            :third 8)]
    (match event
      (Moved [x y at]
             (+ (+ x y)
                (+ at
                   (+ (match small
                        (Sized [w h] (+ w h))
                        (Moved [sx sy sat] (+ (+ sx sy) sat)))
                      (load (field sample first))))))
      (Sized [w h] (+ w h)))))
