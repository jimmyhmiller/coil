(module default-lint-input)
(import "coil.match" :use [match-else])
(import "coil.primitive" :as primitive)

(defsum Event
  (Moved [(x i64) (y i64) (at i64)]))

(defn fallback [(value (Result i64 i64))] (-> i64)
  (match value
    (Err [_] 7)
    (Ok [answer] answer)))

(defn persistent-head [(xs Code)] (-> Code)
  (primitive/code-nth (primitive/code-rest xs) 0))

; The operand is opaque and may be a vector, so this positional access must stay.
(defn positional-head [(xs Code)] (-> Code)
  (primitive/code-nth xs 0))

(defn empty-code? [(xs Code)] (-> bool)
  (and (primitive/code-list? xs) (= (primitive/code-count xs) 0)))

(defn nonempty-code? [(xs Code)] (-> bool)
  (and (primitive/code-list? xs) (> (primitive/code-count xs) 0)))

(defn main [] (-> i64)
  (if (primitive/icmp-ge 3 2)
      (match-else (Moved 1 2 3)
        (Moved [x y at] (+ (+ x y) at))
        (_ 0))
      1))
