(module default-lint-input)
(import "coil.match" :use [match-else])
(import "coil.primitive" :as primitive)
(import "coil.primitive" :as raw)
(import "coil.alloc" :as alloc :use [box create malloc-allocator unwrap-ptr])

(defsum Event
  (Moved [(x i64) (y i64) (at i64)]))

(defstruct Counts [(ok i64) (failed i64)])
(defstruct Box [(value i64)])
(defstruct Holder [(value (ptr i64))])

(defn bump-box! [(box (mut Box))] (-> i64)
  (raw/store! (raw/field box value)
              (+ (raw/load (raw/field box value)) 1))
  (raw/load (raw/field box value)))

; Ambient load is already canonical for arbitrary places, but a field place still
; becomes the value-oriented accessor syntax.
(defn read-box [(box (ref Box))] (-> i64)
  (load (field box value)))

(defn boxed-counts [] (-> (ptr Counts))
  (let [a (malloc-allocator)]
    (let [p (unwrap-ptr [Counts] (create [Counts] a))]
      (store! p (Counts :ok 8 :failed 1))
      p)))

(defn boxed-counts-qualified [] (-> (ptr Counts))
  (let [a (malloc-allocator)]
    (let [p (alloc/unwrap-ptr [Counts] (alloc/create [Counts] a))]
      (store! p (Counts :ok 6 :failed 3))
      p)))

; A pointer cast changes the surrounding expression, so the exact rule leaves it alone.
(defn boxed-counts-erased [] (-> (ptr i8))
  (let [a (malloc-allocator)]
    (let [p (unwrap-ptr [Counts] (create [Counts] a))]
      (store! p (Counts :ok 5 :failed 4))
      (primitive/cast (ptr i8) p))))

(defn counts [] (-> Counts)
  (let [(mut result) (zeroed Counts)]
    (store! (field (mut result) ok) 3)
    (store! (field (mut result) failed) 2)
    result))

; Declaration order is part of constructor evaluation order, so this stays manual.
(defn counts-reversed [] (-> Counts)
  (let [(mut reversed) (zeroed Counts)]
    (store! (field (mut reversed) failed) 2)
    (store! (field (mut reversed) ok) 3)
    reversed))

; Reading the local during initialization also makes the constructor rewrite unsafe.
(defn counts-dependent [] (-> Counts)
  (let [(mut dependent) (zeroed Counts)]
    (store! (field (mut dependent) ok) 3)
    (store! (field (mut dependent) failed) (+ (load (field dependent ok)) 2))
    dependent))

; A binding vector is not a call. Only the initializer is the legacy allocator
; spelling; the local named `heap` must survive unchanged.
(defn heap-binding [] (-> (ptr Box))
  (let [heap (static Box)] heap))

; The checked value is alloc/box's expansion, but a fixer must never print that
; generated body into this module and strand its private helper names here.
(defn box-field! [(dst (mut Holder)) (a (ptr alloc/Allocator))] (-> i64)
  (store! (field dst value) (alloc/box a i64 1))
  0)

(defn fallback [(value (Result i64 i64))] (-> i64)
  (match value
    (Err [_] 7)
    (Ok [answer] answer)))

(defn main [] (-> i64)
  (let [c (counts)
        _ (boxed-counts)
        _ (boxed-counts-qualified)
        _ (boxed-counts-erased)
        _ (counts-reversed)
        _ (counts-dependent)]
    (if (primitive/icmp-ge 3 2)
        (+ (load (field c ok))
           (match-else (Moved 1 2 3)
                       (Moved [x y at] (+ (+ x y) at))
                       (_ 0)))
        1)))
