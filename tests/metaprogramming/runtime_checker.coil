(module runtime_checker)
(import "coil.primitive" :as primitive)
(import "coil.alloc" :as alloc :use *)
(import "coil.control" :use *)
(import "coil.fmt" :use *)
(import "coil.io" :use *)
(import "coil.scratch" :as scratch)
(import "coil.meta.runtime" :use *)
(import "checker" :use *)

;; The repository's existing use-after-free checker, invoked as a normal
;; function. Its error branch is compiled too; this clean input exercises the
;; successful diagnostic contract without deliberately aborting the runner.
(defn main [] (-> i64)
  (let [final-owner (alloc/stack scratch/ScratchArena)]
    (scratch/scratch-init-with-cap final-owner (malloc-allocator) 4096)
    (context-set-final! (scratch/scratch-allocator final-owner))
    (scope :runtime-code
      (defer (scratch/scratch-close! final-owner))
      (defer (context-clear!))
      (let [body `(x y)
            output (call check-uaf body)
            expected `(do x y)
            same (primitive/code-eq output expected)]
        (fmt (stdout) "runtime checker: clean={d}\n" (if same 1 0))
        (if same 0 1)))))
