(module destructive.code.edit)
(import "coil.primitive" :as primitive)

;; The argument is consumed by this macro invocation. Replacing its head edits
;; the existing list spine; it does not rebuild `(placeholder 40 2)`.
(defn destructive-add [(form Code)] (-> Code)
  (primitive/code-set-nth! form 0 `primitive/iadd))

(defn destructive-add-car [(form Code)] (-> Code)
  (primitive/code-set-car! form `primitive/iadd))

(static-assert (= (destructive-add (placeholder 40 2)) 42))
(static-assert (= (destructive-add-car (placeholder 20 22)) 42))
(defn main [] (-> i64) 0)
