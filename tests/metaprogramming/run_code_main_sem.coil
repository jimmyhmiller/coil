;; The EXISTING nofloat SEMANTIC checker, unchanged, as a program: because a

;; loaded code base is expanded and checked in the same pipeline before the
;; invocation, `type-of` answers with the real inferred types of the target's
;; expressions, and `report` fails the run exactly as it fails a build.
(module runcodemainsem)
(import "coil.primitive" :as primitive)
(import "nofloat" :as nf)

(defn main [(prog Code)] (-> Code)
  (nf/check-nofloat prog))
