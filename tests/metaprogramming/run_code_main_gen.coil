;; A generator main: no input, and a `(do …)` result prints as spliced
;; top-level forms — the same convention `(meta …)` generators use — so the
;; output is a compilable file (the gate runs it and expects exit 42).
(module runcodemaingen)
(import "coil.primitive" :as primitive)
(defn main [] (-> Code)
  `(do (module hello)
       (defn main [] (-> i64) (do 42))))
