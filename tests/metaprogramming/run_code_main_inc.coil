;; Fixture for `coil run` on a code->code program: main calls the EXISTING

;; safedialect.desugar-inc metaprogram, unchanged, as an ordinary callee.
(module runcodemaininc)
(import "coil.primitive" :as primitive)
(import "safedialect" :as sd)

(defn main [(prog Code)] (-> Code)
  (sd/desugar-inc prog))
