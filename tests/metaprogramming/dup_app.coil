(module app)
(import "coil.primitive" :as primitive)
(import "coil.alloc" :as alloc)
(import "sigcheck" :use *)
(import "dupa" :as da)
(import "dupb" :as db)

(checker check-sigs)

; Both dupa and dupb define `probe`, so a NAME-based code-decl would say :ambiguous and
; MISS the policy violation. With node-identity resolution, the checker resolves each
; call exactly: da/probe → i64 (fine), db/probe → (ptr i64) (banned).
(defn main [] (-> i64)
  (let [p (primitive/alloc-stack i64)]
    (set! p 0)
    (primitive/iadd (da/probe) (load (db/probe p)))))
