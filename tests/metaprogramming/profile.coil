(module profile)
(import "coil.primitive" :as primitive)

; AUTO-PROFILER — a whole-program TRANSFORM that instruments every user function with
; entry/exit timing, plus a tiny runtime that accumulates per-function totals and prints
; a report when `main` returns. Zero source edits: turn it on with
;
;   coil run app.coil --use profile.coil
;
; and off by not passing it. Each user `(defn f …)` body B is rewritten to
;
;   (let [__prof_t0__ (prof-now)]
;     (let [__prof_r__ (do B)]
;       (prof-record "f" (primitive/isub (prof-now) __prof_t0__))
;       __prof_r__))                       ; + (prof-report) injected before main returns
;
; The function name is baked in as a string literal via `code-str` (spliced as a value).
; The rewrite is IDEMPOTENT (transforms run to a fixpoint) — an already-wrapped body is
; recognized by its `__prof_t0__` binding and left alone.
(import "coil.arraylist" :use *)
(import "coil.alloc" :as alloc :use *)
(import "coil.str" :use *)
(import "coil.io" :use *)
(import "coil.fmt" :use *)

; ---- timing runtime ---------------------------------------------------------
(defstruct Timespec [(sec i64) (nsec i64)])

(extern clock_gettime :cc c [i32 (ptr Timespec)] (-> i32))

(defn prof-now [] (-> i64)  ; monotonic nanoseconds (CLOCK_MONOTONIC = 6 on macOS)
  (let [ts (primitive/alloc-stack Timespec)]
    (clock_gettime 6 ts)
    (primitive/iadd (primitive/imul (.sec ts) 1000000000) (.nsec ts))))

; ---- accumulator table (one global cell, lazily initialized) ----------------
(defstruct ProfEntry [(name (slice u8)) (total i64) (count i64)])

(defstruct ProfTable [(entries (ArrayList ProfEntry)) (inited i64)])

(defn prof-table [] (-> (ptr ProfTable))
  (primitive/alloc-static ProfTable))

(defn prof-ensure [] (-> i64)
  (let [t (prof-table)]
    (if (= (.inited t) (primitive/cast i64 0))
        (do
          (set! (.entries t) (al-new [ProfEntry] (malloc-allocator)))
          (set! (.inited t) 1)
          0)
        0)))

(defn prof-record [(name (slice u8)) (nanos i64)] (-> i64)
  (do
    (prof-ensure)
    (let [t (prof-table)
          n (al-len [ProfEntry] (.entries t))
          (mut i) 0
          (mut found) -1]
      (loop (if (if (>= (load i) n) true (>= (load found) (primitive/cast i64 0)))
                (break)
                (do
                  (let [ev (primitive/alloc-stack ProfEntry)]
                    (set! ev (al-get [ProfEntry] (.entries t) (load i)))
                    (if (= (.name ev) name) (do (set! found (load i)) 0) 0))
                  (set! i (primitive/iadd (load i) 1)))))
      (if (>= (load found) (primitive/cast i64 0))
          (let [ev (primitive/alloc-stack ProfEntry)]
            (set! ev (al-get [ProfEntry] (.entries t) (load found)))
            (set! (.total ev) (primitive/iadd (.total ev) nanos))
            (set! (.count ev) (primitive/iadd (.count ev) 1))
            (al-set! [ProfEntry] (mut (.entries t)) (load found) (load ev))
            0)
          (let [ev (primitive/alloc-stack ProfEntry)]
            (set! (.name ev) name)
            (set! (.total ev) nanos)
            (set! (.count ev) 1)
            (al-push! [ProfEntry] (mut (.entries t)) (load ev))
            0)))))

(defn prof-report [] (-> i64)
  (do
    (prof-ensure)
    (let [t (prof-table)
          n (al-len [ProfEntry] (.entries t))
          w (stderr)
          (mut i) 0]
      (fmt w "\n=== profile: function / calls / total ns / avg ns ===\n")
      (loop (if (>= (load i) n)
                (break)
                (do
                  (let [ev (primitive/alloc-stack ProfEntry)]
                    (set! ev (al-get [ProfEntry] (.entries t) (load i)))
                    (let [c (.count ev)
                          tot (.total ev)]
                      (fmt w
                           "  {s}  calls={d}  total={d}ns  avg={d}ns\n"
                           (load (field ev name))
                           c
                           tot
                           (if (> c (primitive/cast i64 0)) (primitive/idiv tot c) 0))))
                  (set! i (primitive/iadd (load i) 1)))))
      0)))

; ---- the transform ----------------------------------------------------------
(defn is-defn? [(f Code)] (-> bool)
  (and (primitive/code-list? f)
       (and (>= (primitive/code-count f) (primitive/cast i64 5))
            (and (primitive/code-sym? (primitive/code-nth f 0)) (primitive/code-eq (primitive/code-nth f 0) `defn)))))

; body forms of a defn as a Code list (indices 4..)
(defn forms-from [(f Code) (i i64) (n i64)] (-> Code)
  (if (>= i n) `() `(~(primitive/code-nth f i) ~@(forms-from f (primitive/iadd i 1) n))))

; already wrapped? body[0] is a `let` whose first binding symbol is __prof_t0__
(defn already-wrapped? [(f Code)] (-> bool)
  (let [b (primitive/code-nth f 4)]
    (if (and (primitive/code-list? b)
             (and (> (primitive/code-count b) (primitive/cast i64 1)) (primitive/code-eq (primitive/code-nth b 0) `let)))
        (let [bv (primitive/code-nth b 1)]
          (and (primitive/code-list? bv)
               (and (> (primitive/code-count bv) (primitive/cast i64 0))
                    (primitive/code-eq (primitive/code-nth bv 0) `__prof_t0__))))
        false)))

; skip comptime functions (a Code return — macros/generators/checkers/transforms)
(defn skip-defn? [(f Code)] (-> bool)
  (let [ret (primitive/code-nth (primitive/code-nth f 3) 1)]
    (primitive/code-eq ret `Code)))

(defn wrap-defn [(f Code)] (-> Code)
  (let [name (primitive/code-nth f 1)
        params (primitive/code-nth f 2)
        arrow (primitive/code-nth f 3)
        nm (primitive/code-str name)
        body (forms-from f 4 (primitive/code-count f))
        rep (if (primitive/code-eq name `main) `((prof-report)) `())]
    `(defn ~name
       ~params
       ~arrow
       (let [__prof_t0__ (prof-now)]
         (let [__prof_r__ (do ~@body)]
           (prof-record ~nm (primitive/isub (prof-now) __prof_t0__))
           ~@rep
           __prof_r__)))))

(defn prof-form [(f Code)] (-> Code)
  (if (is-defn? f)
      (if (if (already-wrapped? f) true (skip-defn? f)) f (wrap-defn f))
      f))

(defn prof-forms [(m Code) (i i64) (n i64)] (-> Code)
  (if (>= i n) `() `(~(prof-form (primitive/code-nth m i)) ~@(prof-forms m (primitive/iadd i 1) n))))

; process a module iff it is user code and NOT this runtime module
(defn process-mod? [(m Code)] (-> bool)
  (if (> (primitive/code-count m) (primitive/cast i64 1))
      (if (primitive/code-eq (primitive/code-nth m 0) `profile)
          false
          (primitive/code-from-user? (primitive/code-nth m 1)))
      false))

(defn prof-mod [(m Code)] (-> Code)
  (if (process-mod? m) `(~(primitive/code-nth m 0) ~@(prof-forms m 1 (primitive/code-count m))) m))

(defn prof-mods [(ms Code) (i i64) (n i64)] (-> Code)
  (if (>= i n) `() `(~(prof-mod (primitive/code-nth ms i)) ~@(prof-mods ms (primitive/iadd i 1) n))))

(defn prof-transform [(mods Code)] (-> Code)
  `(do ~@(prof-mods mods 0 (primitive/code-count mods))))

(transform prof-transform)
