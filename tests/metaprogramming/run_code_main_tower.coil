;; main is a macro body: it may use macros (`cond`) like any metaprogram body.

(module runcodemaintower)
(import "coil.primitive" :as primitive)
(import "coil.control" :use *)

(defn main [(prog Code)] (-> Code)
  (cond (primitive/icmp-gt (primitive/code-count prog) 1) `(many forms)
        :else `(few forms)))
