(module user_forms_lint)
(import "coil.primitive" :as primitive)
(import "coil.meta" :use [user-forms user-module?])

;;; Warns once per user-written top-level function (a `defn*` after expansion), and counts user modules (this one
;;; and the test); the
;;; standard library's thousands of forms never reach either.
(defn count-defns [(modules Code)] (-> Code)
  (for form (iter (user-forms modules))
    (when (and (primitive/code-list? form) (= (get form 0) `defn*))
      (primitive/warn form "user defn")
      0))
  (let [(mut n) 0]
    (for m (iter modules) (when (user-module? m) (set! n (+ n 1))))
    (when (!= n 2) (primitive/report (get modules 0) "expected two user modules") 0))
  `0)

(checker count-defns)
