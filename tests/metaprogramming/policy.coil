(module policy)
(import "coil.primitive" :as primitive)
(defn has-bad? [(f Code)] (-> bool)
  (if (primitive/code-list? f)
      (if (and (> (primitive/code-count f) (primitive/cast i64 0)) (primitive/code-eq (primitive/code-car f) `forbidden-op)) true (has-bad-kids? f 0 (primitive/code-count f)))
    false))
(defn has-bad-kids? [(f Code) (i i64) (n i64)] (-> bool)
  (if (>= i n) false (if (has-bad? (primitive/code-nth f i)) true (has-bad-kids? f (primitive/iadd i 1) n))))
(defn mod-has-bad [(m Code)] (-> bool) (has-bad-kids? m 1 (primitive/code-count m)))
(defn any-mod-bad [(ms Code) (i i64) (n i64)] (-> bool)
  (if (>= i n) false (if (mod-has-bad (primitive/code-nth ms i)) true (any-mod-bad ms (primitive/iadd i 1) n))))
(defn no-forbidden-op [(modules Code)] (-> Code)
  (if (any-mod-bad modules 0 (primitive/code-count modules)) (primitive/error "policy: (forbidden-op …) is not allowed") `0))
