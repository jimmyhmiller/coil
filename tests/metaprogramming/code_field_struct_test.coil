(module code-field-struct-test)
(import "coil.primitive" :as primitive)

;;; Types that hold `Code` exist only at compile time and get no runtime layout. A
;;; function that works on one is compile-time code too, even when `Code` appears
;;; nowhere in its signature or body. It used to be kept for run time, and codegen
;;; aborted on the struct nobody had laid out (`unknown struct …State`).

(defstruct State [(mods Code) (count i64)])

;;; Holds `Code` only through `State`.
(defstruct Outer [(state State) (passes i64)])

;;; A sum with a `Code` payload, and one that reaches it through `Outer`.
(defsum Step (Emit [(form Code)]) (Skip []))
(defsum Plan (Run [(outer (ptr Outer))]) (Idle []))

;;; No `Code` in the signature: only the pointee says this is compile-time code.
(defn bump! [(s (ptr State))] (-> i64)
  (do (set! (.count s) (+ (.count s) 1)) 0))

(defn pass! [(o (ptr Outer))] (-> i64)
  (do (set! (.passes o) (+ (.passes o) 1)) (bump! (field o state))))

;;; Mentions such a type only as a local.
(defn fresh-count [] (-> i64)
  (let [(mut s) (primitive/zeroed State)] (bump! (mut s)) (.count s)))

(defn emitted? [(step (ptr Step))] (-> bool)
  (match (load step) (Emit [_] true) (Skip [] false)))

(defn planned? [(plan (ptr Plan))] (-> bool)
  (match (load plan) (Run [_] true) (Idle [] false)))

(impl State
  (total [(s (ptr State))] (-> i64) (.count s)))

(defn xf [(mods Code)] (-> Code)
  (let [o (primitive/alloc-stack Outer)
        (mut step) (Emit mods)
        (mut plan) (Idle)]
    (store! o (primitive/zeroed Outer))
    (set! plan (Run o))
    (set! (.mods (.state o)) mods)
    (pass! o)
    (if (and (emitted? (mut step))
             (and (planned? (mut plan))
                  (= (+ (total (field o state)) (fresh-count)) 2)))
        `(do ~@mods)
        `(do (static-assert false "the compile-time helpers did not run")))))

(transform-once xf)

(defn answer [] (-> i64) 42)

(deftest program-with-compile-time-only-types-builds-and-runs
  (assert (= (answer) 42)))
