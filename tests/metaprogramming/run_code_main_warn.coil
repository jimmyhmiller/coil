;; A warn-lint as a program over a LOADED code base: walks user modules only
;; (skipping itself), warns at each (defn main …) it finds — the warn's span
;; points into the target's own file, and warns exit 0.
(module runcodemainwarn)
(import "coil.primitive" :as primitive)
(defn forms [(m Code) (i i64) (n i64)] (-> Code)
  (if (primitive/icmp-ge i n) `()
      (do
        (let [f (primitive/code-nth m i)]
          (if (and (primitive/code-list? f)
                   (and (primitive/icmp-gt (primitive/code-count f) 1)
                        (and (primitive/code-eq (primitive/code-nth f 0) `defn)
                             (primitive/code-eq (primitive/code-nth f 1) `main))))
              (primitive/warn f "target has a main")
              `()))
        (forms m (primitive/iadd i 1) n))))
(defn mods [(p Code) (i i64) (n i64)] (-> Code)
  (if (primitive/icmp-ge i n) `()
      (do
        (let [m (primitive/code-nth p i)]
          (if (and (primitive/icmp-gt (primitive/code-count m) 1)
                   (and (primitive/code-from-user? (primitive/code-nth m 1))
                        (not (primitive/code-eq (primitive/code-nth m 0) `runcodemainwarn))))
              (forms m 1 (primitive/code-count m))
              `()))
        (mods p (primitive/iadd i 1) n))))
(defn main [(prog Code)] (-> Code)
  (do (mods prog 0 (primitive/code-count prog)) `(scanned)))
