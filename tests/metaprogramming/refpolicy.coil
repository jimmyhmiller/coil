(module refpolicy)
(import "coil.primitive" :as primitive)
; Bans referencing a raw-pointer-returning function — whether CALLED or taken as a
; fnptr — by running code-decl on the reference NODE. Proves resolution covers more
; than plain calls: (primitive/fnptr-of F) resolves to F exactly via node identity.
(defn is-fn-decl? [(d Code)] (-> bool)
  (and (primitive/code-list? d) (and (>= (primitive/code-count d) (primitive/cast i64 6)) (primitive/code-eq (primitive/code-nth d 2) `fn))))
(defn ret-is-ptr? [(d Code)] (-> bool)
  (let [ret (primitive/code-nth d 5)]
    (and (primitive/code-list? ret) (and (> (primitive/code-count ret) (primitive/cast i64 0)) (primitive/code-eq (primitive/code-nth ret 0) `ptr)))))
(defn check-node [(f Code)] (-> Code)
  (if (primitive/code-list? f)
      (do (if (> (primitive/code-count f) (primitive/cast i64 0))
              (let [d (primitive/code-decl f)]
                (if (and (is-fn-decl? d) (ret-is-ptr? d))
                    (do (primitive/report f "policy: references a pointer-returning function") 0)
                  0))
            0)
          (check-kids f 0 (primitive/code-count f)))
    `0))
(defn check-kids [(f Code) (i i64) (n i64)] (-> Code)
  (if (>= i n) `0 (do (check-node (primitive/code-nth f i)) (check-kids f (primitive/iadd i 1) n))))
(defn look-at? [(m Code)] (-> bool)
  (if (> (primitive/code-count m) (primitive/cast i64 1)) (primitive/code-from-user? (primitive/code-nth m 1)) false))
(defn check-forms [(m Code) (i i64) (n i64)] (-> Code)
  (if (>= i n) `0 (do (check-node (primitive/code-nth m i)) (check-forms m (primitive/iadd i 1) n))))
(defn check-mods [(ms Code) (i i64) (n i64)] (-> Code)
  (if (>= i n) `0
    (do (let [m (primitive/code-nth ms i)] (if (look-at? m) (check-forms m 1 (primitive/code-count m)) `0))
        (check-mods ms (primitive/iadd i 1) n))))
(defn check-refs [(modules Code)] (-> Code) (check-mods modules 0 (primitive/code-count modules)))
