(module alloc_trace_test)
(import "coil.alloc" :as alloc :use [malloc-allocator create destroy unwrap-ptr])
(import "coil.alloc_trace" :as trace)

(defn main [] (-> i64)
  (trace/allocation-trace-init!)
  (let [a (malloc-allocator)
        p (unwrap-ptr [i64] (create [i64] a))]
    (store! p 42)
    (destroy [i64] a p)
    (trace/allocation-trace-snapshot! "focused-test")
    (trace/allocation-trace-close!)
    0))
