;; A warn-lint as a program over a raw FRAGMENT (stdin/pipe contract): located
;; warns point into the registered input source; warns exit 0.
(module runcodemainlint)
(import "coil.primitive" :as primitive)
(defn scan [(f Code)] (-> Code)
  (if (primitive/code-list? f)
      (do
        (if (and (primitive/icmp-gt (primitive/code-count f) 0)
                 (primitive/code-eq (primitive/code-nth f 0) `icmp-gt))
            (primitive/warn f "prefer > over icmp-gt")
            `())
        (kids f 0 (primitive/code-count f)))
      `()))
(defn kids [(f Code) (i i64) (n i64)] (-> Code)
  (if (primitive/icmp-ge i n) `() (do (scan (primitive/code-nth f i)) (kids f (primitive/iadd i 1) n))))
(defn main [(prog Code)] (-> Code) (do (scan prog) `(scanned)))
