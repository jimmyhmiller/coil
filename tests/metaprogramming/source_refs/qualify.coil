(module source-probe.qualify)
(import "coil.primitive" :as p)
(import "coil.meta" :as meta)

(defn qualify [(modules Code)] (-> Code)
  (do
    (for import
      (iter (meta/imports `source-probe.main))
      (when (= (get import 3) `source-probe.lib)
        (let [plan (meta/qualify-import import `lib)]
          (if (= (get plan 0) `refused)
              (do (p/warn (get import 2) (p/code-str (get plan 1))) 0)
              (do (meta/suggest-edits plan "qualify imported references") 0)))))
    `0))

(checker qualify)
