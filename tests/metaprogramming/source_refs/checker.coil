(module source-probe.checker)
(import "coil.primitive" :as p)
(import "coil.meta" :as meta)

(defn probe [(modules Code)] (-> Code)
  (do
    (when (= (meta/source-modules) `:unavailable)
      (p/error "source unavailable")
      0)
    (unless (= (meta/source-binding `double) `:unknown)
      (p/error "synthetic symbol acquired a binding")
      0)
    (let [(mut globals) 0
          (mut locals) 0
          (mut macros) 0]
      (for reference
        (iter (meta/references `source-probe.main))
        (let [binding (meta/reference-binding reference)
              node (meta/reference-node reference)]
          (unless (= binding (meta/source-binding node))
            (p/error "reference lookup disagrees")
            0)
          (when (p/code-list? binding)
            (when (= (get binding 0) `global)
              (when (or (= (get binding 1) `source-probe.lib.Box)
                        (= (get binding 1) `source-probe.lib.double))
                (unless (= (meta/reference-import reference) `source-probe.lib)
                  (p/error "missing import provenance")
                  0)
                (set! globals (+ (load globals) 1))
                0)
              0)
            (when (= (get binding 0) `local)
              (when (= node `amount)
                (unless (p/code-int? (get binding 1))
                  (p/error "local lacks checked identity")
                  0)
                (set! locals (+ (load locals) 1))
                0)
              0)
            (when (= binding `(global source-probe.lib.measured))
              (unless (= (meta/reference-role reference) `:macro)
                (p/error "macro lost its authored role")
                0)
              (set! macros (+ (load macros) 1))
              0))
          0))
      (unless (and (= (load globals) 2)
                   (and (= (load locals) 1) (= (load macros) 1)))
        (p/error "missing authored references")
        0))
    `0))

(checker probe)
