(module app)
(import "coil.primitive" :as primitive)
(import "coil.alloc" :as alloc)
(import "sigcheck" :use *)

(checker check-sigs)

; `at` returns a raw pointer — perfectly type-correct, so it compiles and typechecks.
; The checker reads `at`'s real declared return type `(ptr i64)` and vetoes the call.
(defn at [(p (ptr i64))] (-> (ptr i64))
  p)

(defn main [] (-> i64)
  (let [p (primitive/alloc-stack i64)]
    (set! p 0)
    (load (at p))))
