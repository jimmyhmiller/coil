(module code-decl-methods-test)
(import "coil.primitive" :as primitive)

;;; `(primitive/code-decl CALL)` for a call that dispatches to an impl method. The
;;; checker has chosen exactly one method for such a call, and used to answer
;;; `:unresolved` all the same, so a whole-program transform that attaches to calls
;;; by what they reach could not see method calls at all.
;;;
;;;   (decl MODULE method QUALIFIED-NAME [PARAM-TYPE…] RET OWNER-TYPE [TRAIT])

(defstruct Job [(id i64)])
(impl Job (priority [(j Job) (boost i64)] (-> i64) (+ (.id j) boost)))
(deftrait Scored [Self] (score [(x Self)] (-> i64)))
(impl Scored Job (score [(x Job)] (-> i64) (.id x)))
(defstruct Task [(weight i64)])
(impl Scored Task (score [(x Task)] (-> i64) (.weight x)))
(defn plain [(j Job)] (-> i64) (.id j))

;;; (decl-is CALL KIND QNAME OWNER TRAIT) -> 1 when `code-decl` of CALL is a record
;;; with exactly those, else 0. OWNER and TRAIT are "" where the record has none.
(defn text-at [(record Code) (i i64)] (-> (slice u8))
  (if (< i (primitive/code-count record))
      (primitive/code-str (primitive/code-nth record i))
      ""))

(defn answer-for [(form Code)] (-> Code)
  (let [d (primitive/code-decl (primitive/code-nth form 1))]
    (if (and (primitive/code-list? d)
             (and (= (text-at d 2) (primitive/code-str (primitive/code-nth form 2)))
                  (and (= (text-at d 3) (primitive/code-str (primitive/code-nth form 3)))
                       (and (= (text-at d 6) (primitive/code-str (primitive/code-nth form 4)))
                            (= (text-at d 7) (primitive/code-str (primitive/code-nth form 5)))))))
        `1
        `0)))

(defn rewrite [(form Code)] (-> Code)
  (cond
    (and (primitive/code-list? form)
         (and (= (primitive/code-count form) 6)
              (primitive/code-eq (primitive/code-nth form 0) `decl-is)))
      (answer-for form)
    (primitive/code-vector? form)
      (let [out (primitive/code-list-new)]
        (for [i 0 (primitive/code-count form)]
          (primitive/code-list-push! out (rewrite (primitive/code-nth form i))))
        `[~@(primitive/code-list-done out)])
    (primitive/code-list? form)
      (let [out (primitive/code-list-new)]
        (for [i 0 (primitive/code-count form)]
          (primitive/code-list-push! out (rewrite (primitive/code-nth form i))))
        (primitive/code-list-like form (primitive/code-list-done out)))
    :else form))

(defn rewrite-program [(modules Code)] (-> Code)
  (let [out (primitive/code-list-new)]
    (for [i 0 (primitive/code-count modules)]
      (let [m (primitive/code-nth modules i)]
        (primitive/code-list-push! out
          (if (= (primitive/code-str (primitive/code-nth m 0)) "code-decl-methods-test")
              (rewrite m)
              m))))
    `(do ~@(primitive/code-list-done out))))

(transform-once rewrite-program)

(defn through-parameter [(T Scored)] [(x T)] (-> i64)
  (decl-is (score x) "method" "code-decl-methods-test.score" "Self" "code-decl-methods-test.Scored"))

(deftest a-plain-function-is-still-a-function
  (let [j (Job :id 3)]
    (assert (= (decl-is (plain j) "fn" "code-decl-methods-test.plain" "" "") 1))))

(deftest an-inherent-method-names-its-type
  (let [j (Job :id 3)]
    (assert (= (decl-is (priority j 4)
                        "method" "code-decl-methods-test.priority" "code-decl-methods-test.Job" "")
               1))))

(deftest a-trait-method-names-the-selected-impl
  (let [j (Job :id 3)
        t (Task :weight 5)]
    (assert (= (decl-is (score j)
                        "method" "code-decl-methods-test.score"
                        "code-decl-methods-test.Job" "code-decl-methods-test.Scored")
               1))
    (assert (= (decl-is (score t)
                        "method" "code-decl-methods-test.score"
                        "code-decl-methods-test.Task" "code-decl-methods-test.Scored")
               1))))

(deftest a-call-through-a-type-parameter-names-the-trait-method
  (assert (= (through-parameter (Job :id 3)) 1)))
