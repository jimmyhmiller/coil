;; Code-base fixture target: imports a second module and calls its

;; float-returning function; also uses a raw icmp-gt for the lint fixture.
(module runcmtargeta)
(import "coil.primitive" :as primitive)
(import "runcmtargetb" :as b)

(defn usef [] (-> f64)
  (b/getf))

(defn cmp [(x i64)] (-> bool)
  (< x 0))

(defn main [] (-> i64)
  0)
