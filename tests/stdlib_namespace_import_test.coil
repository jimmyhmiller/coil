(module stdlib-namespace-import-test)

; Public stdlib identity and source filename are both accepted. `coil.*` is the
; canonical spelling; the filename form remains a compatibility alias.
(import "coil.os" :as canonical)
(import "coil.os" :as filename)

(defn main [] (-> i64)
  (if (>= (canonical/os-errno) 0)
      (if (>= (filename/os-errno) 0) 0 1)
      1))
