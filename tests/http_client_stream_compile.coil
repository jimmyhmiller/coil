; Compile-only coverage of the streaming surface: every exported name is referenced and

; every type lines up, with no network involved. The behavior lives in
; tests/http_client_stream_integration.coil, which needs a server.
(module http-client-stream-compile)
(import "coil.primitive" :as primitive)
(import "coil.http.client" :as http)
(import "coil.alloc" :as alloc)
(import "coil.cancellation" :as cancellation)
(import "coil.slice" :as slice)

; A sink that drops everything and never stops — the minimal shape a consumer takes.
(defn drop-chunk [(data (ptr u8)) (n i64) (ctx (ptr i8))] (-> i64)
  http/BODY-CONTINUE)

; …and one that stops immediately, so BODY-STOP is exercised at the type level too.
(defn stop-at-once [(data (ptr u8)) (n i64) (ctx (ptr i8))] (-> i64)
  http/BODY-STOP)

(defn main [] (-> i64)
  (let [a (alloc/malloc-allocator)
        r (primitive/alloc-stack http/Request)
        sink (primitive/alloc-stack http/BodySink)]
    (store! (field r method) "GET")
    (store! (field r url) "https://example.com/")
    (store! (field r headers) (slice/slice-new [http/Header] (primitive/cast (ptr http/Header) 0) 0))
    (store! (field r body) "")
    (store! (field r connect-timeout-ms) 5000)
    (store! (field r timeout-ms) 10000)
    (store! (field r follow-redirects) true)
    (store! (field sink context) (primitive/cast (ptr i8) 0))
    (store! (field sink consume) (primitive/fnptr-of drop-chunk))
    ; Type-check the cancellable surface without initiating another network request.
    (if false
        (http/request-stream-cancellable a
                                         r
                                         (load sink)
                                         (primitive/cast (ptr cancellation/Cancellation) 0))
        (Err (http/InvalidRequest)))
    (match (http/request-stream a r (load sink))
      (Err [e] (if (http/error-timeout? e) 2 1))
      (Ok [response]
          (let [status (http/streaming-response-status response)
                stopped (http/streaming-response-stopped response)
                n (http/streaming-response-header-count response)]
            (when (> n (primitive/cast i64 0))
              (http/streaming-response-header-at response 0)
              0)
            (http/streaming-response-free a response)
            (if (and (= status (primitive/cast i64 200)) (not stopped)) 0 3))))))
