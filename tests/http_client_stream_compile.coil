; Compile-only coverage of the streaming surface: every exported name is referenced and
; every type lines up, with no network involved. The behavior lives in
; tests/http_client_stream_integration.coil, which needs a server.
(module http-client-stream-compile)
(import "coil.primitive" :as primitive)
(import "coil.http.client" :as http)
(import "coil.alloc" :as alloc)
(import "coil.slice" :as slice)

; A sink that drops everything and never stops — the minimal shape a consumer takes.
(defn drop-chunk [(data (ptr u8)) (n i64) (ctx (ptr i8))] (-> i64)
  BODY-CONTINUE)

; …and one that stops immediately, so BODY-STOP is exercised at the type level too.
(defn stop-at-once [(data (ptr u8)) (n i64) (ctx (ptr i8))] (-> i64)
  BODY-STOP)

(defn main [] (-> i64)
  (let [a (alloc/malloc-allocator)
        r (alloc/stack http/Request)
        sink (alloc/stack http/BodySink)]
    (primitive/store! (primitive/field r method) "GET")
    (primitive/store! (primitive/field r url) "https://example.com/")
    (primitive/store! (primitive/field r headers)
                      (slice/slice-new [http/Header] (primitive/cast (ptr http/Header) 0) 0))
    (primitive/store! (primitive/field r body) "")
    (primitive/store! (primitive/field r connect-timeout-ms) 5000)
    (primitive/store! (primitive/field r timeout-ms) 10000)
    (primitive/store! (primitive/field r follow-redirects) true)
    (primitive/store! (primitive/field sink context) (primitive/cast (ptr i8) 0))
    (primitive/store! (primitive/field sink consume) (primitive/fnptr-of drop-chunk))
    (match (http/request-stream a r (primitive/load sink))
      (Err [e] (if (http/error-timeout? e) 2 1))
      (Ok [response]
          (let [status (http/streaming-response-status response)
                stopped (http/streaming-response-stopped response)
                n (http/streaming-response-header-count response)]
            (when (primitive/icmp-gt n 0)
              (http/streaming-response-header-at response 0)
              0)
            (http/streaming-response-free a response)
            (if (and (primitive/icmp-eq status 200) (not stopped)) 0 3))))))
