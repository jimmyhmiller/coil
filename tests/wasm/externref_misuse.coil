; An externref may live in locals, parameters and results only. Each position
; that would put it in linear memory is a checker error, reported together,
; never a compiler abort in layout or codegen. (A struct field is a layout error
; on its own: externref_field.coil.)
(module test.externref-misuse)
(import "coil.cc" :as cc)
(extern js_get :cc (cc/C) [] (-> externref))
(defn pointer-case [] (-> i64) (let [p (cast (ptr externref) 0)] 0))
(defn array-case [] (-> i64) (let [a (: [(js_get)] (array externref 1))] 0))
(defn literal-case [] (-> i64) (let [a [(js_get)]] 0))
(defn generic-case [] (-> i64) (let [o (Some (js_get))] 0))
(defn main [] (-> i64) 0)
