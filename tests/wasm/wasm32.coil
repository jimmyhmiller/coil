; A wasm32 module run under node by tests/wasm/run.mjs (scripts/tests/fast/wasm.py).
; Each export returns the value the driver expects:
;
; - arraylist-record: a slice before trailing scalars exercises wasm32's
;   target-dependent aggregate layout; ArrayList indexing must use LLVM's stride.
; - dyn-aggregate-return: a trait method returning a (dyn Trait) aggregate.
; - externref: a host reference lives in locals, parameters, results and generic
;   functions without ever touching linear memory.
; - use-stack: an alloc-stack address escaping to the host puts the frame on the
;   shadow stack, so the module must export __stack_pointer for a host longjmp.
; - aliased: an extern bound to a host import by an explicit `:as` name.
;
; wasm.py also checks the module's imports: on wasm32 (ILP32) size_t and ssize_t
; are i32, so the prelude's `write` is (i32, i32, i32) -> i32.
(module test.wasm32)
(import "coil.alloc" :use [malloc-allocator])
(import "coil.arraylist" :use [ArrayList])
(import "coil.dyn" :use *)
(import "coil.primitive" :as primitive)
(import "coil.cc" :as cc)

(defstruct Record
  [(first (ptr u8))
   (second (ptr u8))
   (kind i64)
   (tail bool)])

(defn record-new [(kind i64)] (-> Record)
  (let [(mut record) (primitive/zeroed Record)]
    (set! (.second record) (primitive/cast (ptr u8) 4096))
    (set! (.kind record) kind)
    record))

(defn arraylist-record [] (-> i64)
  (let [(mut records) (ArrayList::new [Record] (malloc-allocator))]
    (push! (mut records) (record-new 1))
    (push! (mut records) (record-new 6))
    (.kind (get records 1))))

(deftrait Inner [Self] (value [(self (ptr Self))] (-> i64)))
(deftrait Outer [Self] (as-inner [(self (ptr Self))] (-> (dyn Inner))))
(defdyn Inner)
(defdyn Outer)
(defstruct Both [(n i64)])
(impl Inner Both (value [(self (ptr Both))] (-> i64) (.n self)))
(impl Outer Both (as-inner [(self (ptr Both))] (-> (dyn Inner)) self))

(defn call-through-outer [(outer (dyn Outer))] (-> i64)
  (value (as-inner outer)))

(defn dyn-aggregate-return [] (-> i64)
  (let [both (primitive/alloc-stack Both)]
    (set! (.n both) 42)
    (call-through-outer both)))

(extern js_get :cc (cc/C) [] (-> externref))
(extern js_use :cc (cc/C) [externref] (-> i32))
(defn id [T] [(x T)] (-> T) x)
(defn externref-roundtrip [] (-> i64)
  (let [(mut r) (js_get)]
    (set! r (id (js_get)))
    (cast i64 (js_use r))))

(defn externref-select [(pick bool) (left externref) (right externref)]
  (-> externref)
  (if pick left right))

(extern sink :cc (cc/C) [(ptr i8)] (-> void))
(defstruct Big [(a i64) (b i64) (c i64)])
(defn use-stack [(n i64)] (-> i64)
  (let [p (primitive/alloc-stack Big)]
    (set! (.a p) n)
    (sink (primitive/cast (ptr i8) p))
    (.a p)))

(extern safe-host :as "host.function$1" :cc (cc/C) [i64] (-> i64))
(defn aliased [] (-> i64) (safe-host 41))

(defn main [] (-> i64)
  (println "wasm32")
  0)

(export-c [externref-select :as "externref_select"]
          [arraylist-record :as "arraylist_record"]
          [dyn-aggregate-return :as "dyn_aggregate_return"]
          [externref-roundtrip :as "externref_roundtrip"]
          [use-stack :as "use_stack"]
          [aliased :as "aliased"])
