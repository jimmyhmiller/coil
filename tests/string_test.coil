(module coil.tests.string)
(import "coil.primitive" :as primitive)
(import "coil.alloc" :use [free malloc-allocator])
(import "coil.assert" :use *)
(import "coil.hashmap" :as map)
(import "coil.str" :as string)

(deftest string-view-validates-utf8
         (match (string/string-view-from-utf8 "coil \x1f603;.")
           (Err [e] (assert false))
           (Ok [view]
               (do
                 (assert-eq (string/string-view-byte-len view) 10)
                 (assert (= view (string/string-view-unchecked "coil \x1f603;.")))))))

(deftest sv-is-a-zero-validation-literal-constructor
         (let [view (string/sv "literal \x3bb;")]
           (assert (= view (string/string-view-unchecked "literal \x3bb;")))))

(deftest string-view-rejects-invalid-utf8
         (match (string/string-view-from-utf8 [(primitive/cast u8 192) (primitive/cast u8 128)])
           (Ok [view] (assert false))
           (Err [e]
                (do
                  (assert-eq (string/utf8-error-offset e) 0)
                  (assert-eq (string/utf8-error-len e) 1)))))

(deftest string-view-rejects-surrogates-and-truncation
         (do
           (match (string/string-view-from-utf8 [(primitive/cast u8 237)
                                                 (primitive/cast u8 160)
                                                 (primitive/cast u8 128)])
             (Ok [view] (assert false))
             (Err [e] (assert-eq (string/utf8-error-offset e) 0)))
           (match (string/string-view-from-utf8 [(primitive/cast u8 240)
                                                 (primitive/cast u8 159)
                                                 (primitive/cast u8 146)])
             (Ok [view] (assert false))
             (Err [e] (assert-eq (string/utf8-error-offset e) 0)))))

(deftest string-view-iterates-unicode-scalars
         (let [view (string/string-view-unchecked "A\x3bb;\x1f603;")
               (mut it) (iter view)]
           (match (next (mut it)) (None [] (assert false)) (Some [r] (assert-eq (string/rune-value r) 65)))
           (match (next (mut it)) (None [] (assert false)) (Some [r] (assert-eq (string/rune-value r) 955)))
           (match (next (mut it)) (None [] (assert false)) (Some [r] (assert-eq (string/rune-value r) 128515)))
           (match (next (mut it)) (None [] (assert true)) (Some [r] (assert false)))))

(deftest owned-string-appends-clones-and-frees
         (let [a (malloc-allocator)
               (mut text) (string/string-from-view a (string/string-view-unchecked "hello"))]
           (string/string-push-view! (mut text) (string/string-view-unchecked " "))
           (match (string/rune-new (primitive/cast u32 955))
             (None [] (assert false))
             (Some [r] (string/string-push-rune! (mut text) r)))
           (assert (= (string/string-as-view (load text))
                      (string/string-view-unchecked "hello \x3bb;")))
           (let [(mut copy) (string/string-clone a (load text))]
             (assert (= (load text) (load copy)))
             (string/string-clear! (mut text))
             (assert (string/string-view-empty? (string/string-as-view (load text))))
             (assert (= (string/string-as-view (load copy))
                        (string/string-view-unchecked "hello \x3bb;")))
             (string/string-free! (mut copy)))
           (string/string-free! (mut text))))

(deftest string-indices-only-accept-scalar-boundaries
         (let [view (string/string-view-unchecked "a\x3bb;b")]
           (match (string/string-index-at-byte view 1)
             (None [] (assert false))
             (Some [i] (assert-eq (string/string-index-byte-offset i) 1)))
           (match (string/string-index-at-byte view 2)
             (None [] (assert true))
             (Some [i] (assert false)))
           (match (string/string-index-at-byte view 3)
             (None [] (assert false))
             (Some [i] (assert-eq (string/string-index-byte-offset i) 3)))))

(deftest string-view-search-returns-boundary-indices
         (let [view (string/string-view-unchecked "a\x3bb;-coil")
               needle (string/string-view-unchecked "coil")]
           (assert (string/string-view-starts-with? view (string/string-view-unchecked "a\x3bb;")))
           (assert (string/string-view-ends-with? view needle))
           (assert (string/string-view-contains? view needle))
           (match (string/string-view-find view needle)
             (None [] (assert false))
             (Some [index]
                   (assert-eq (string/string-index-byte-offset index) 4)))))

(deftest owned-string-validates-input-and-transfers-ownership
         (let [a (malloc-allocator)]
           (match (string/string-from-utf8 a "owned")
             (Err [error] (assert false))
             (Ok [created]
                 (let [(mut source) created
                       (mut taken) (string/string-take! (mut source))]
                   (assert (string/string-view-empty? (string/string-as-view (load source))))
                   (assert (= (string/string-as-view (load taken))
                              (string/string-view-unchecked "owned")))
                   (string/write-view! (mut taken) (string/string-view-unchecked " text"))
                   (let [bytes (string/string-into-bytes! (mut taken))]
                     (assert (string/str-eq bytes "owned text"))
                     (free [u8] a bytes))
                   (string/string-free! (mut taken))
                   (string/string-free! (mut source)))))))

(deftest string-view-trim-and-split-are-borrowed
         (let [trimmed (string/string-view-trim-ascii (string/string-view-unchecked " \talpha::\x3bb;:: \n"))
               (mut parts) (string/string-view-split trimmed (string/string-view-unchecked "::"))]
           (assert (= trimmed (string/string-view-unchecked "alpha::\x3bb;::")))
           (match (next (mut parts))
             (None [] (assert false))
             (Some [part] (assert (= part (string/string-view-unchecked "alpha")))))
           (match (next (mut parts))
             (None [] (assert false))
             (Some [part] (assert (= part (string/string-view-unchecked "\x3bb;")))))
           (match (next (mut parts))
             (None [] (assert false))
             (Some [part] (assert (string/string-view-empty? part))))
           (match (next (mut parts))
             (None [] (assert true))
             (Some [part] (assert false)))))

(deftest owned-string-capacity-remove-truncate-and-pop
         (let [a (malloc-allocator)
               (mut text) (string/string-from-view a (string/sv "a\x3bb;\x1f603;z"))]
           (string/string-reserve! (mut text) 64)
           (assert (>= (string/string-capacity (load text)) 64))
           (let [view (string/string-as-view (load text))]
             (match (string/string-index-at-byte view 1)
               (None [] (assert false))
               (Some [lo]
                     (match (string/string-index-at-byte view 3)
                       (None [] (assert false))
                       (Some [hi] (assert-eq (string/string-remove! (mut text) lo hi) 6))))))
           (assert (= (string/string-as-view (load text)) (string/sv "a\x1f603;z")))
           (match (string/string-index-at-byte (string/string-as-view (load text)) 5)
             (None [] (assert false))
             (Some [end] (assert-eq (string/string-truncate! (mut text) end) 5)))
           (assert (= (string/string-as-view (load text)) (string/sv "a\x1f603;")))
           (match (string/string-pop-rune! (mut text))
             (None [] (assert false))
             (Some [rune] (assert-eq (string/rune-value rune) 128515)))
           (match (string/string-pop-rune! (mut text))
             (None [] (assert false))
             (Some [rune] (assert-eq (string/rune-value rune) 97)))
           (match (string/string-pop-rune! (mut text))
             (None [] (assert true))
             (Some [rune] (assert false)))
           (string/string-free! (mut text))))

(deftest string-view-map-keys-own-their-bytes
         (let [a (malloc-allocator)
               (mut source) (string/string-from-view a (string/sv "key"))
               (mut table) (map/hm-new [string/StringView i64] a (string/string-view-keyops))]
           (map/hm-put! [string/StringView i64] (mut table) (string/string-as-view (load source)) 42)
           (string/string-clear! (mut source))
           (match (map/hm-get [string/StringView i64] (load table) (string/sv "key"))
             (None [] (assert false))
             (Some [value] (assert-eq value 42)))
           (map/hm-free! [string/StringView i64] (mut table))
           (string/string-free! (mut source))))

(deftest owned-string-map-keys-are-cloned
         (let [a (malloc-allocator)
               (mut key) (string/string-from-view a (string/sv "owned-key"))
               (mut lookup) (string/string-from-view a (string/sv "owned-key"))
               (mut table) (map/hm-new [string/String i64] a (string/string-keyops-owned))]
           (map/hm-put! [string/String i64] (mut table) (load key) 7)
           (string/string-clear! (mut key))
           (match (map/hm-get [string/String i64] (load table) (load lookup))
             (None [] (assert false))
             (Some [value] (assert-eq value 7)))
           (map/hm-free! [string/String i64] (mut table))
           (string/string-free! (mut lookup))
           (string/string-free! (mut key))))
