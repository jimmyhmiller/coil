; Two damaged forms with an undamaged one between them. Each is repaired from its own

; indentation, and `untouched` must come out byte-for-byte identical — it is never
; analysed at all, because its delimiters already balance.
;
; This is the property a whole-file indentation pass cannot offer: after the first
; defect its running depth is wrong, so it "corrects" everything downstream against a
; baseline that is already off by one.
(module balance-two-damaged-forms)
(import "coil.primitive" :as primitive)

(defn first-broken [(n i64)] (-> i64)
  (let [(mut acc) 0]
    (loop (if (primitive/icmp-ge (primitive/load acc) n)
              (break)
              (primitive/store! acc (primitive/iadd (primitive/load acc) 1)))
      (primitive/load acc)))

  (defn untouched [(a i64) (b i64)] (-> i64)
    (cond (and (primitive/icmp-eq a 1)
               (primitive/icmp-eq b 2))
            (primitive/iadd a b)
          :else 0))

  (defn second-broken [(n i64)] (-> i64)
    (let [(mut acc) n]
      (when (primitive/icmp-gt (primitive/load acc) 0)
        (primitive/store! acc (primitive/isub (primitive/load acc) 1))
        (primitive/load acc)))))
