; The one surplus closer `balance` will delete: a `)` alone in column 0. Formatted
; Coil never puts a closer there — closers hug the end of their form's last line — so
; this one has no other reading. Every other surplus closer is reported instead.
(module balance-stray-close-column0)

(defn before [] (-> i64) 0)
)

(defn after [] (-> i64) 1)
