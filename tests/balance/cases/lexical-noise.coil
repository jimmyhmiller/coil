; Delimiters that are TEXT, not structure. This file is balanced; `balance` must say

; so and change nothing. If the scanner ever counts one of these, every repair built
; on top of it is measured against the wrong depth.
;
; A comment full of noise: ((( ]]] and an unclosed " quote
(module balance-lexical-noise)
(import "coil.primitive" :as primitive)

(defn lexical [] (-> i64)
  (let [s "a string holding ( and [ and an escaped \" quote"
        t c"a c-string holding ) and ]"
        open \(
        close \)
        nl \newline]
    (primitive/iadd open close)))
