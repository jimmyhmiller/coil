; A surplus closer inside a form. REFUSED, and this is the case that decides whether
; the tool can be trusted: the extra `)` on the `let` line closes it early, and every
; line after that is still indented deeper than what remains open, so nothing looks
; wrong. Deleting the closer the depth count trips over (the last one) balances the
; file and silently moves `tail` out of the `let`. Indentation cannot distinguish this
; from a MISSING OPENER, which wants the opposite repair, so neither is guessed at.
(module balance-stray-close-inline)
(import "coil.primitive" :as primitive)

(defn surplus [(n i64)] (-> i64)
  (let [(mut acc) 0]
    (primitive/store! acc (primitive/iadd (primitive/load acc) n))
    (primitive/load acc)))
