(module hosted-system-test)
(import "coil.primitive" :as primitive)
(import "coil.alloc" :as alloc)
(import "coil.os" :as os)
(import "coil.time" :as time)
(import "coil.selectors" :as selectors)
(import "coil.process" :as process)
(import "coil.io" :as io)
(import "coil.str" :as str)
(import "coil.try" :use [try try-or! some-or! ensure!])

(defn selector-edge-contracts [] (-> i64)
  (try
    (let [empty (alloc/stack (array i32 2))
          short (try-or! (time/duration-millis 5) 30)]
      (ensure! (= (os/pipe (primitive/cast (ptr i32) empty)) 0) 31)
      (match (selectors/wait-fd-for
               (load (primitive/index empty 0))
               (selectors/interest-readable)
               short)
        (Ok [_] (return-from :try 32))
        (Err [error]
          (match error
            (selectors/Timeout [] 0)
            (selectors/InvalidFd [] (return-from :try 33))
            (selectors/Syscall [_] (return-from :try 34)))))

      ; Closing the writer produces hangup/EOF readiness without consuming or closing
      ; the reader. A subsequent read proves the descriptor still belongs to us.
      (os/close (load (primitive/index empty 1)))
      (let [ready (try-or! (selectors/wait-fd-for
                             (load (primitive/index empty 0))
                             (selectors/interest-readable)
                             short)
                           35)
            readyp (alloc/stack selectors/ReadyEvents)
            byte (alloc/stack i8)]
        (store! readyp ready)
        (ensure! (or (load (field readyp readable)) (load (field readyp hangup))) 36)
        (ensure! (= (io/read (load (primitive/index empty 0)) byte 1) 0) 37))
      (let [closed (load (primitive/index empty 0))]
        (os/close closed)
        (match (selectors/wait-fd-for closed (selectors/interest-readable) short)
          (Ok [_] (return-from :try 38))
          (Err [error]
            (match error
              (selectors/InvalidFd [] 0)
              (selectors/Timeout [] (return-from :try 39))
              (selectors/Syscall [_] (return-from :try 40))))))
      0)))

(defn main [] (-> i64)
  (try
    (let [a (alloc/malloc-allocator)
          key "COIL_HOSTED_SYSTEM_TEST"]
      (try-or! (os/env-set a key "first" true) 1)
      (ensure! (> (process/id) 0) 25)
      (ensure! (> (process/parent-id) 0) 26)
      (let [old (some-or! (try-or! (os/env-get a key) 2) 3)
            oldp (alloc/stack os/OwnedString)]
        (store! oldp old)
        (try-or! (os/env-set a key "second" true) 4)
        (ensure! (str/str-eq (os/owned-string-slice old) "first") 5)
        (let [new (some-or! (try-or! (os/env-get a key) 6) 7)
              newp (alloc/stack os/OwnedString)]
          (store! newp new)
          (ensure! (str/str-eq (os/owned-string-slice new) "second") 8)
          (os/owned-string-free a newp))
        (os/owned-string-free a oldp))

      (let [cwd (try-or! (os/current-dir a) 9)
            cwdp (alloc/stack os/OwnedString)]
        (store! cwdp cwd)
        (try-or! (os/change-dir a "/tmp") 10)
        (try-or! (os/change-dir a (os/owned-string-slice cwd)) 11)
        (os/owned-string-free a cwdp))

      (let [delay (try-or! (time/duration-millis 20) 12)
            before (try-or! (time/monotonic-now-ms) 13)]
        (try-or! (time/sleep delay) 14)
        (let [after (try-or! (time/monotonic-now-ms) 15)]
          (ensure! (>= (- after before) 15) 16)))

      (let [fds (alloc/stack (array i32 2))
            byte (alloc/stack i8)]
        (ensure! (= (os/pipe (primitive/cast (ptr i32) fds)) 0) 17)
        (store! byte (primitive/cast i8 65))
        (ensure! (= (io/write (load (primitive/index fds 1)) byte (primitive/cast isize 1)) 1) 18)
        (let [timeout (try-or! (time/duration-millis 1000) 19)
              events (try-or! (selectors/wait-fd-for
                                (load (primitive/index fds 0))
                                (selectors/interest-readable)
                                timeout)
                              20)
              eventsp (alloc/stack selectors/ReadyEvents)]
          (store! eventsp events)
          (ensure! (or (load (field eventsp readable)) (load (field eventsp hangup))) 21))
        (os/close (load (primitive/index fds 0)))
        (os/close (load (primitive/index fds 1))))

      (try-or! (os/env-unset a key) 22)
      (match (try-or! (os/env-get a key) 23)
        (Some [_] 24)
        (None [] (selector-edge-contracts))))))
