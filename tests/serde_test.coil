; coil.serde test suite: round-trips and decode errors across all three format
; backends (JSON, sexp, msgpack), plus cross-format agreement.
(module serde-tests)
(import "coil.primitive" :as primitive)
(import "coil.alloc" :as alloc)
(import "coil.alloc" :use *)
(import "coil.slice" :use *)
(import "coil.str" :use *)
(import "coil.arraylist" :use *)
(import "coil.hashmap" :use *)
(import "coil.serde" :use *)
(import "coil.serde.derive" :use *)
(import "coil.serde.json" :use *)
(import "coil.serde.sexp" :use *)
(import "coil.serde.msgpack" :use *)

; ---- shared fixtures --------------------------------------------------------
(defstruct Address [(street (slice u8)) (zip i64)])
(derive-serde Address)

(defstruct Person
  [(name (slice u8))
   (age u8)
   (home Address)
   (nick (Option (slice u8)))
   (scores (ArrayList i64))
   (ratio f64)])
(derive-serde Person)

(defsum-serde Shape
  (Circle [(r f64)])
  (Rect   [(w i64) (h i64)])
  (Point))

(defn mk-person [(a (ptr Allocator))] (-> Person)
  (let [(mut p) (primitive/zeroed Person)
        (mut scores) (al-new [i64] a)]
    (al-push! (mut scores) 10)
    (al-push! (mut scores) -3)
    (al-push! (mut scores) 100000)
    (store! (field p name) "ada \"the\"\nfirst")
    (store! (field p age) (primitive/cast u8 36))
    (store! (field (field p home) street) "Main St")
    (store! (field (field p home) zip) 47374)
    (store! (field p nick) (Some "jo"))
    (store! (field p scores) (load scores))
    (store! (field p ratio) 0.1)
    (load p)))

;; structural equality for the fixture (Option/slice fields keep this manual)
(defn person-eq [(x Person) (y Person)] (-> bool)
  (and (and (and (str-eq (load (field x name)) (load (field y name)))
                 (= (primitive/cast i64 (load (field x age)))
                    (primitive/cast i64 (load (field y age)))))
            (and (str-eq (load (field (field x home) street)) (load (field (field y home) street)))
                 (= (load (field (field x home) zip)) (load (field (field y home) zip)))))
       (and (and (match (load (field x nick))
                   (None [] (match (load (field y nick)) (None [] true) (Some [_] false)))
                   (Some [xa] (match (load (field y nick)) (None [] false) (Some [ya] (str-eq xa ya)))))
                 (primitive/fcmp-eq (load (field x ratio)) (load (field y ratio))))
            (and (= (al-len [i64] (load (field x scores))) (al-len [i64] (load (field y scores))))
                 (let [n (al-len [i64] (load (field x scores)))
                       (mut same) true]
                   (for [i 0 n]
                     (when (!= (al-get [i64] (load (field x scores)) i)
                               (al-get [i64] (load (field y scores)) i))
                       (store! same false)
                       0))
                   (load same))))))

(defn shape-eq [(x Shape) (y Shape)] (-> bool)
  (match x
    (Circle [xr] (match y (Circle [yr] (primitive/fcmp-eq xr yr)) (Rect [_ _] false) (Point [] false)))
    (Rect [xw xh] (match y (Circle [_] false) (Rect [yw yh] (and (= xw yw) (= xh yh))) (Point [] false)))
    (Point [] (match y (Circle [_] false) (Rect [_ _] false) (Point [] true)))))

(defn de-code [(e DeError)] (-> i64)
  (let [c (alloc/stack DeError)]
    (store! c e)
    (load (field c code))))

; ============================ JSON ==========================================
(deftest json-struct-roundtrip
  (let [a (malloc-allocator)
        p (mk-person a)]
    (match (to-json-str a p)
      (Err [_] (assert false))
      (Ok [s]
        (match (from-json [Person] a s)
          (Err [_] (assert false))
          (Ok [p2] (assert (person-eq p p2))))))))

(deftest json-sum-roundtrip
  (let [a (malloc-allocator)]
    (match (to-json-str a (Rect 3 4))
      (Err [_] (assert false))
      (Ok [s]
        (do (assert (str-eq s "{\"Rect\":{\"w\":3,\"h\":4}}"))
            (match (from-json [Shape] a s)
              (Err [_] (assert false))
              (Ok [sh] (assert (shape-eq sh (Rect 3 4))))))))
    (match (to-json-str a (Point))
      (Err [_] (assert false))
      (Ok [s]
        (do (assert (str-eq s "\"Point\""))
            (match (from-json [Shape] a s)
              (Err [_] (assert false))
              (Ok [sh] (assert (shape-eq sh (Point))))))))))

(deftest json-field-order-and-unknown-fields
  (let [a (malloc-allocator)
        src "{\"extra\": [1, {\"x\": 2}], \"zip\": 7, \"street\": \"s\"}"]
    (match (from-json [Address] a src)
      (Err [_] (assert false))
      (Ok [ad]
        (let [adp (alloc/stack Address)]
          (store! adp ad)
          (assert-eq (load (field adp zip)) 7)
          (assert (str-eq (load (field adp street)) "s")))))))

(deftest json-option-and-missing-field
  (let [a (malloc-allocator)]
    ; Option field absent -> None; explicit null -> None
    (match (from-json [Person] a "{\"name\":\"n\",\"age\":1,\"home\":{\"street\":\"s\",\"zip\":1},\"scores\":[],\"ratio\":0}")
      (Err [_] (assert false))
      (Ok [p]
        (let [pp (alloc/stack Person)]
          (store! pp p)
          (assert (match (load (field pp nick)) (None [] true) (Some [_] false))))))
    ; non-Option field absent -> DE-E-MISSING-FIELD (10)
    (match (from-json [Address] a "{\"street\":\"s\"}")
      (Err [e] (assert-eq (de-code e) 10))
      (Ok [_] (assert false)))))

(deftest json-type-and-range-errors
  (let [a (malloc-allocator)]
    ; string where int expected -> DE-E-EXPECTED-INT (3)
    (match (from-json [Address] a "{\"street\":\"s\",\"zip\":\"nope\"}")
      (Err [e] (assert-eq (de-code e) 3))
      (Ok [_] (assert false)))
    ; float where int expected -> DE-E-EXPECTED-INT (3)
    (match (from-json [Address] a "{\"street\":\"s\",\"zip\":1.5}")
      (Err [e] (assert-eq (de-code e) 3))
      (Ok [_] (assert false)))
    ; u8 out of range -> DE-E-INT-RANGE (12)
    (match (from-json [Person] a "{\"name\":\"n\",\"age\":300,\"home\":{\"street\":\"s\",\"zip\":1},\"scores\":[],\"ratio\":0}")
      (Err [e] (assert-eq (de-code e) 12))
      (Ok [_] (assert false)))
    ; i64 overflow -> DE-E-INT-RANGE (12)
    (match (from-json [Address] a "{\"street\":\"s\",\"zip\":99999999999999999999}")
      (Err [e] (assert-eq (de-code e) 12))
      (Ok [_] (assert false)))
    ; unknown variant -> DE-E-UNKNOWN-VARIANT (11)
    (match (from-json [Shape] a "{\"Square\":{\"s\":1}}")
      (Err [e] (assert-eq (de-code e) 11))
      (Ok [_] (assert false)))
    ; invalid JSON -> DE-E-PARSE (15)
    (match (from-json [Address] a "{\"street\": }")
      (Err [e] (assert-eq (de-code e) 15))
      (Ok [_] (assert false)))))

(deftest json-string-unescaping
  (let [a (malloc-allocator)]
    ; \u0041 -> A ; \n \t \" \\ ; surrogate pair \ud83d\ude00 -> 4-byte UTF-8
    (match (from-json [Address] a "{\"street\":\"\\u0041\\n\\t\\\"\\\\\\ud83d\\ude00\",\"zip\":1}")
      (Err [_] (assert false))
      (Ok [ad]
        (let [adp (alloc/stack Address)]
          (store! adp ad)
          (let [s (load (field adp street))]
            (assert-eq (slice-len s) 9)
            (assert-eq (primitive/cast i64 (slice-get s 0)) 65)    ; A
            (assert-eq (primitive/cast i64 (slice-get s 1)) 10)    ; \n
            (assert-eq (primitive/cast i64 (slice-get s 2)) 9)     ; \t
            (assert-eq (primitive/cast i64 (slice-get s 3)) 34)    ; "
            (assert-eq (primitive/cast i64 (slice-get s 4)) 92)    ; backslash
            (assert-eq (primitive/cast i64 (slice-get s 5)) 240)   ; U+1F600 as UTF-8
            (assert-eq (primitive/cast i64 (slice-get s 6)) 159)
            (assert-eq (primitive/cast i64 (slice-get s 7)) 152)
            (assert-eq (primitive/cast i64 (slice-get s 8)) 128)))))
    ; lone surrogate is an error -> DE-E-BAD-STRING (18)
    (match (from-json [Address] a "{\"street\":\"\\ud83d\",\"zip\":1}")
      (Err [e] (assert-eq (de-code e) 18))
      (Ok [_] (assert false)))))

(deftest json-float-roundtrip-and-nan
  (let [a (malloc-allocator)]
    (match (to-json-str a 0.1)
      (Err [_] (assert false))
      (Ok [s]
        (match (from-json [f64] a s)
          (Err [_] (assert false))
          (Ok [v] (assert (primitive/fcmp-eq v 0.1))))))
    (match (to-json-str a 1.0e300)
      (Err [_] (assert false))
      (Ok [s]
        (match (from-json [f64] a s)
          (Err [_] (assert false))
          (Ok [v] (assert (primitive/fcmp-eq v 1.0e300))))))
    ; NaN is not representable in JSON
    (match (to-json-str a (primitive/fdiv 0.0 0.0))
      (Err [_] (assert true))
      (Ok [_] (assert false)))))

(deftest json-hashmap-roundtrip
  (let [a (malloc-allocator)
        (mut m) (hm-new [(slice u8) i64] a (str-keyops))]
    (hm-put! (mut m) "alpha" 1)
    (hm-put! (mut m) "beta" 2)
    (match (to-json-str a (load m))
      (Err [_] (assert false))
      (Ok [s]
        (match (from-json [(HashMap (slice u8) i64)] a s)
          (Err [_] (assert false))
          (Ok [m2]
            (do (assert-eq (hm-len [(slice u8) i64] m2) 2)
                (assert (match (hm-get [(slice u8) i64] m2 "alpha") (Some [v] (= v (cast i64 1))) (None [] false)))
                (assert (match (hm-get [(slice u8) i64] m2 "beta") (Some [v] (= v (cast i64 2))) (None [] false))))))))))

; ============================ sexp ==========================================
(deftest sexp-struct-roundtrip
  (let [a (malloc-allocator)
        p (mk-person a)]
    (match (to-sexp-str a p)
      (Err [_] (assert false))
      (Ok [s]
        (match (from-sexp [Person] a s)
          (Err [_] (assert false))
          (Ok [p2] (assert (person-eq p p2))))))))

(deftest sexp-sum-roundtrip
  (let [a (malloc-allocator)]
    (match (to-sexp-str a (Rect 3 4))
      (Err [_] (assert false))
      (Ok [s]
        (do (assert (str-eq s "(Rect w 3 h 4)"))
            (match (from-sexp [Shape] a s)
              (Err [_] (assert false))
              (Ok [sh] (assert (shape-eq sh (Rect 3 4))))))))
    (match (from-sexp [Shape] a "Point")
      (Err [_] (assert false))
      (Ok [sh] (assert (shape-eq sh (Point)))))))

(deftest sexp-float-specials
  (let [a (malloc-allocator)]
    ; inf round-trips (sexp, unlike JSON, can carry it)
    (match (to-sexp-str a (primitive/fdiv 1.0 0.0))
      (Err [_] (assert false))
      (Ok [s]
        (do (assert (str-eq s "inf"))
            (match (from-sexp [f64] a s)
              (Err [_] (assert false))
              (Ok [v] (assert (primitive/fcmp-eq (primitive/fdiv 1.0 v) 0.0)))))))
    ; nan round-trips to a NaN
    (match (to-sexp-str a (primitive/fdiv 0.0 0.0))
      (Err [_] (assert false))
      (Ok [s]
        (do (assert (str-eq s "nan"))
            (match (from-sexp [f64] a s)
              (Err [_] (assert false))
              (Ok [v] (assert (not (primitive/fcmp-eq v v))))))))))

(deftest sexp-errors
  (let [a (malloc-allocator)]
    ; wrong struct head -> DE-E-EXPECTED-OBJECT (8)
    (match (from-sexp [Address] a "(NotAddress street \"s\" zip 1)")
      (Err [e] (assert-eq (de-code e) 8))
      (Ok [_] (assert false)))
    ; unbalanced parens -> DE-E-PARSE (15)
    (match (from-sexp [Address] a "(Address street \"s\"")
      (Err [e] (assert-eq (de-code e) 15))
      (Ok [_] (assert false)))
    ; unknown variant -> DE-E-UNKNOWN-VARIANT (11)
    (match (from-sexp [Shape] a "(Square s 1)")
      (Err [e] (assert-eq (de-code e) 11))
      (Ok [_] (assert false)))))

; ============================ msgpack =======================================
(deftest msgpack-struct-roundtrip
  (let [a (malloc-allocator)
        p (mk-person a)]
    (match (to-msgpack-bytes a p)
      (Err [_] (assert false))
      (Ok [b]
        (match (from-msgpack [Person] a b)
          (Err [_] (assert false))
          (Ok [p2] (assert (person-eq p p2))))))))

(deftest msgpack-sum-roundtrip
  (let [a (malloc-allocator)]
    (match (to-msgpack-bytes a (Rect 3 4))
      (Err [_] (assert false))
      (Ok [b]
        (match (from-msgpack [Shape] a b)
          (Err [_] (assert false))
          (Ok [sh] (assert (shape-eq sh (Rect 3 4)))))))
    (match (to-msgpack-bytes a (Point))
      (Err [_] (assert false))
      (Ok [b]
        (match (from-msgpack [Shape] a b)
          (Err [_] (assert false))
          (Ok [sh] (assert (shape-eq sh (Point)))))))))

(deftest msgpack-integer-boundaries
  (let [a (malloc-allocator)
        (mut xs) (al-new [i64] a)]
    ; every encoding-family boundary, both sides
    (al-push! (mut xs) 0) (al-push! (mut xs) 127) (al-push! (mut xs) 128)
    (al-push! (mut xs) 255) (al-push! (mut xs) 256) (al-push! (mut xs) 65535)
    (al-push! (mut xs) 65536) (al-push! (mut xs) 4294967295) (al-push! (mut xs) 4294967296)
    (al-push! (mut xs) -1) (al-push! (mut xs) -32) (al-push! (mut xs) -33)
    (al-push! (mut xs) -128) (al-push! (mut xs) -129) (al-push! (mut xs) -32768)
    (al-push! (mut xs) -32769) (al-push! (mut xs) -2147483648) (al-push! (mut xs) -2147483649)
    (al-push! (mut xs) 9223372036854775807) (al-push! (mut xs) -9223372036854775808)
    (match (to-msgpack-bytes a (load xs))
      (Err [_] (assert false))
      (Ok [b]
        (match (from-msgpack [(ArrayList i64)] a b)
          (Err [_] (assert false))
          (Ok [ys]
            (do (assert-eq (al-len [i64] ys) (al-len [i64] (load xs)))
                (let [n (al-len [i64] ys)]
                  (for [i 0 n]
                    (assert-eq (al-get [i64] ys i) (al-get [i64] (load xs) i)))))))))))

(deftest msgpack-u64-range-check
  (let [a (malloc-allocator)]
    ; u64 MAX round-trips through a u64 field
    (match (to-msgpack-bytes a (primitive/cast u64 -1))
      (Err [_] (assert false))
      (Ok [b]
        (do
          ; ... but must NOT decode as i64 (uint64 above i64 MAX)
          (match (from-msgpack [i64] a b)
            (Err [e] (assert-eq (de-code e) 12))
            (Ok [_] (assert false)))
          (match (from-msgpack [u64] a b)
            (Err [_] (assert false))
            (Ok [v] (assert-eq (primitive/cast i64 v) -1))))))
    ; a negative int must not decode as u64
    (match (to-msgpack-bytes a -5)
      (Err [_] (assert false))
      (Ok [b]
        (match (from-msgpack [u64] a b)
          (Err [e] (assert-eq (de-code e) 12))
          (Ok [_] (assert false)))))))

(deftest msgpack-truncated-input
  (let [a (malloc-allocator)]
    (match (from-msgpack [Person] a "")
      (Err [e] (assert-eq (de-code e) 15))
      (Ok [_] (assert false)))
    ; a map header promising more than the buffer holds
    (let [(mut bad) (al-new [u8] a)]
      (al-push! (mut bad) (primitive/cast u8 130))   ; fixmap 2 pairs, then nothing
      (match (from-msgpack [Address] a (slice-new [u8] (load (field bad data)) 1))
        (Err [e] (assert-eq (de-code e) 15))
        (Ok [_] (assert false))))))

; ============================ cross-format ==================================
(deftest cross-format-agreement
  (let [a (malloc-allocator)
        p (mk-person a)]
    ; one value, three wire formats, three equal decodes
    (match (to-json-str a p)
      (Err [_] (assert false))
      (Ok [js]
        (match (to-sexp-str a p)
          (Err [_] (assert false))
          (Ok [ss]
            (match (to-msgpack-bytes a p)
              (Err [_] (assert false))
              (Ok [mb]
                (match (from-json [Person] a js)
                  (Err [_] (assert false))
                  (Ok [pj]
                    (match (from-sexp [Person] a ss)
                      (Err [_] (assert false))
                      (Ok [ps]
                        (match (from-msgpack [Person] a mb)
                          (Err [_] (assert false))
                          (Ok [pm]
                            (do (assert (person-eq p pj))
                                (assert (person-eq p ps))
                                (assert (person-eq p pm))
                                (assert (person-eq pj ps))
                                (assert (person-eq ps pm)))))))))))))))))
