; args: --target wasm32-unknown-unknown -o {out}.wasm
(module diag.wasm-extern-width)
(import "coil.cc" :as cc)

; Natively, two declarations of one C symbol may differ in integer width: each
; call is built against its own prototype. A wasm import is typed per symbol, so
; on wasm every declaration of a symbol must agree exactly.
(extern mkdir :cc (cc/C) [(ptr i8) u16] (-> i32))
(extern mkdir-wide :as "mkdir" :cc (cc/C) [(ptr i8) i64] (-> i32))

(defn main [] (-> i64)
  (+ (cast i64 (mkdir c"/tmp/a" (: 493 u16))) (cast i64 (mkdir-wide c"/tmp/b" 493))))
