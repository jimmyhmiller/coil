; args: --target arm64-apple-darwin25.5.0 -o {out}
(module diag.shim-bad-gpr)

; A :shim calling convention names q0, a vector register on aarch64, where only a
; general-purpose register can carry an integer parameter.
(defcc myc :lower shim :params [q0] :ret x0)

(defn f :cc myc [(a i64)] (-> i64)
  a)

(defn main [] (-> i64)
  0)
