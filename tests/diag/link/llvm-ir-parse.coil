(module diag.llvm-ir-parse)
(import "coil.primitive" :as primitive)

; The llvm-ir escape hatch hands its text to LLVM's parser. Invalid IR is reported
; with LLVM's message and the generated helper module, not a crash.
(defn m [(x i64)] (-> i64)
  (primitive/llvm-ir i64 [x] "%r = bogusop $t0 $0, 1
ret $ret %r"))

(defn main [] (-> i64) (m 1))
