(module diag.link-undefined-symbol)
(import "coil.cc" :as cc)

; The program compiles, but the extern it calls resolves nowhere, so the linker
; fails. Coil names the failure after the linker's own report and says how to
; link a native library.
(extern coil_diag_missing_symbol :cc (cc/C) [] (-> i64))

(defn main [] (-> i64)
  (coil_diag_missing_symbol))
