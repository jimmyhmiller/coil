(module diag.support.genexport)
; A macro that emits a definition and its export together, in one `(do …)`: a
; top-level `do` is spliced, so the export is a top-level declaration like any
; other and names.coil's :use of `made` is no error.
(import "coil.primitive" :as primitive)
(export plain)
(defn plain [] (-> i64) 1)
(defn define-exported [(name Code)] (-> Code)
  `(do (defn ~(primitive/syntax->datum name) [] (-> i64) 2)
       (export ~(primitive/syntax->datum name))))
(define-exported made)
