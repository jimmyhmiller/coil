(module diag.macro-malformed-match)

; A macro whose match has an arm with no bind vector. Before it can run, the
; macro's own body is parsed, and an unparseable match used to be normalized and
; parsed again forever, until the stack ran out. It is the arm's error instead.
(defn pick [(a Code)] (-> Code)
  (match (Some 1)
    (None [] a)
    (other a)))

(defn main [] (-> i64)
  (pick 1))
