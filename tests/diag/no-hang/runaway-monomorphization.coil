(module diag.runaway-monomorphization)

; Every call of grow instantiates grow at a deeper (Box (Box ... T)): the
; instantiation set never closes, and the compiler must say so instead of hanging.
(defstruct Box [T] [(v T)])

(defn grow [T] [(x T)] (-> i64)
  (grow (Box :v x)))

(defn main [] (-> i64) (grow 1))
