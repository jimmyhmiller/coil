(module diag.export-extern-mismatch)
(import "coil.cc" :as cc)
; An export-c symbol two externs also declare is checked against each; the first
; that disagrees with the exported function is the one reported.

(extern two :as "diag_export_two" :cc (cc/C) [i64] (-> i64))
(extern two-again :as "diag_export_two" :cc (cc/C) [i64] (-> i64))

(defn add [(x i64) (y i64)] (-> i64) (+ x y))
(export-c [add :as "diag_export_two"])

(defn main [] (-> i64) 0)
