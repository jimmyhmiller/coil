(module diag.declarations)
; A struct field's type is checked where the struct is declared. A macro is
; staged against every declaration, so a broken struct stops even `defn` from
; staging: the error is the field's, at its struct, not a call to a function
; whose definition never expanded.

(defstruct Hook [(callback (fnptr c [] i64))])

(defn width [] (-> Code) `32)

(const WIDTH (width))

(defn main [] (-> i64) WIDTH)
