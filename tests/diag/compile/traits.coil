(module diag.traits)
; Traits, bounds and impls. One `coil check` reports every unsatisfied bound.
(defstruct Opaque [(bits i64)])

; A blanket impl covers only the types its bounds admit.
(deftrait Key [Self] (key-code [(k Self)] (-> i64)))
(impl [(T Hash Eq)] Key T (key-code [(k T)] (-> i64) (hash k)))
(defn blanket-unsatisfied [] (-> i64) (key-code (Opaque :bits 1)))

; Bounds on a struct's and a sum's type parameters are checked where they are used.
(defstruct Box [(T Eq)] [(v T)])
(defsum Maybe [(T Eq)] (Nothing) (Just [(v T)]))
(defn struct-bound [] (-> i64) (let [b (coil.primitive/alloc-stack (Box Opaque))] 0))
(defn sum-bound [] (-> i64) (let [o (coil.primitive/alloc-stack (Maybe Opaque))] 0))

; An associated-type bound rejects an impl whose item type differs.
(defstruct BoolIter [(value bool)])
(impl Iterator BoolIter (next [(it (mut BoolIter))] (-> (Option bool)) (Some (.value it))))
(defn first-i64 [(I (Iterator i64))] [(source I)] (-> i64) 0)
(defn associated-mismatch [] (-> i64) (first-i64 (BoolIter :value true)))

; A type parameter can call only the methods of the traits that bound it.
(deftrait Show [Self] (show-it [(x Self)] (-> i64)))
(deftrait Peek [Self E] (peek [(c Self)] (-> (Option E))))
(defn unbounded [T] [(x T)] (-> i64) (show-it x))
(defn unbounded-parameterized [T] [(x T)] (-> i64) (match (peek x) (Some [v] 1) (None [] 0)))
; An associated type reads as <C as Trait>::Param.
(defn associated-argument [(C Get)] [(xs C)] (-> i64) (get xs 0))

; Generic calls and constructors.
(defn width [T] [(p (ptr T))] (-> i64) (cast i64 (sizeof T)))
(defn generic-call-mismatch [] (-> i64) (width "text"))
(defstruct Holder [T] [(p (ptr T))])
(defn generic-field-mismatch [] (-> i64) (let [(mut x) 5 h (Holder :p (mut x))] 0))
(defn scaled [(K Hash)] [(k K)] (-> i64) (* 2 (hash k)))
(defn uninferred-fnptr [] (-> i64) (let [f (fnptr-of scaled)] 0))

(defn main [] (-> i64) 0)
