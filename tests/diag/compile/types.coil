(module diag.types)
; Type checking: calls, returns, fields, literals, places and annotations. Every
; mistake is independent, and one `coil check` reports all of them.
(import "coil.primitive" :as primitive)
(import "coil.alloc" :use *)
(import "coil.arraylist" :use *)
(import "coil.var" :use [var-static])

(defstruct Point [(x i64) (y i64)])
(defn takes-i64 [(x i64)] (-> i64) x)
(defn add [(a i64) (b i64)] (-> i64) (+ a b))

; Calls
(defn wrong-argument [] (-> i64) (takes-i64 3.5))
(defn string-argument [] (-> i64) (takes-i64 "x"))
(defn too-few [] (-> i64) (add 1))
(defn too-many [] (-> i64) (add 1 2 3))
(defn map-argument-order [] (-> i64) (do (map (range 0 10) (primitive/fnptr-of takes-i64)) 0))
(def add-var (var-static (fnptr c [i64 i64] i64) (primitive/fnptr-of add)))
(defn named-without-params [] (-> i64) (add-var :a 1 :b 2))

; Values and returns
(defn mixed-arithmetic [] (-> i64) (primitive/iadd 1 2.0))
(defn returns-string [] (-> i64) "hello")
(defn empty-body [(n i64)] (-> i64))
(defn bare-break [] (-> bool) (loop (if true (break) false) true))
(defn untyped-empty-array [] (-> i64) (let [xs []] 0))
(defn identity [T] [(value T)] (-> T) value)
(defn write! [(t (ptr i64))] (-> void) (store! t 42))
(defn void-value [(t (ptr i64))] (-> i64) (identity (write! t)) 0)

; Literals
(defn wide-untyped [] (-> i64) (println "{}" 18446744073709551615) 0)
(defn wide-overflow [] (-> i64) (let [x (: 18446744073709551616 u64)] 0))
(defn malformed-hex [] (-> i64) 0xfoo)
(defn bad-suffix [] (-> i64) 47w)

; Fields and places
(defn no-such-field [(p Point)] (-> i64) (.z p))
(defn unknown-type [] (-> i64) (let [p (primitive/alloc-stack Nope)] 0))
(defn store-mismatch [(w (slice u8))] (-> i64)
  (let [p (primitive/alloc-stack Point)] (primitive/store! (primitive/field p x) w) 0))
(defn field-of-value [(l (ptr (ArrayList Point))) (i i64)] (-> i64)
  (load (field (get (load l) i) x)))
(defn mutable-alias [(r Point)] (-> i64) (let [(mut c) (mut r)] (set! (.x c) 99) (.x c)))
(deftrait Speak [Self] (speak [(self (ptr Self))] (-> i64)))
(impl Speak Point (speak [(self (ptr Point))] (-> i64) (.x self)))
(defn hear [(s (dyn Speak))] (-> i64) (speak s))
(defn dyn-from-borrow [(p Point)] (-> i64) (hear p))

; A macro's expansion is type-checked where it is used, with the expansion named.
(defn add-half [(x Code)] (-> Code) `(primitive/iadd ~x 1.5))
(defn macro-expansion [] (-> i64) (add-half 3))

; Annotations
(defannotation :build/id i64)
(defn unknown-annotation :does/not-exist true [] (-> i64) 0)
(defn wrong-annotation-type :build/id "not an integer" [] (-> i64) 0)
(defn duplicate-annotation :build/id 1 :build/id 2 [] (-> i64) 0)
(defn params-on-a-function :params [:a :b] [(a i64) (b i64)] (-> i64) (+ a b))

(defn main [] (-> i64) 0)
