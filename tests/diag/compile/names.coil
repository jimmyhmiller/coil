(module diag.names)
; Name resolution, imports and privacy. Every mistake here is independent of the
; others, and one `coil check` reports all of them.
(import "diag.support.middle" :use *)
(import "diag.support.tcp" :use *)
(import "diag.support.unix" :use *)
(import "diag.support.facade" :as api)
(import "diag.support.narrow" :as narrow :use *)
(import "diag.support.badlib" :use *)
(import "coil.hashmap")
(import "coil.prop" :as prop :use [Source Gen])
(import "coil.core" :use * :exclude [<])

; An export list naming nothing: a name the module never defines, and one it
; only imports (an import passes a name on only with :reexport).
(export main undefined-call no-such-export Source)

(defn undefined-call [] (-> i64) (nonexistent-fn 1 2))
(defn unbound [] (-> i64) (+ nope 1))
(defn type-param-as-value [T] [(x T)] (-> i64) T)

; Defined in a module that is loaded (through middle) but not imported here.
(defn transitive [] (-> i64) (leaf-helper))
; Both :use'd modules export SOCKET_ERROR_CLOSED.
(defn ambiguous-constant [] (-> i64) SOCKET_ERROR_CLOSED)
; The facade re-exports only `visible` from its provider.
(defn private-reexport [] (-> i64) (api/hidden))
; The narrow facade re-exports `good` renamed to `shown`, and not `secret`.
(defn renamed-reexport [] (-> i64) (+ (shown) (good)))
(defn unlisted-reexport [] (-> i64) (narrow/secret))
; It re-exports the trait Lit and not Dim, so Lit's `glow` is the one in scope.
(defn reexported-trait [] (-> i64) (glow 1))
; coil.hashmap is imported, but without :use.
(defn import-without-use [] (-> i64) (i64-key-hash (cast (ptr i8) 0) 8))
; coil.core's :exclude hides a trait method.
(defn excluded-method [] (-> i64) (if (< 1 2) 0 1))
; A local shadows the println macro in head position.
(defn shadowed-macro [] (-> i64) (let [println 5] (println 1 2)))
; Defined in a module nobody loaded.
(defn unimported-name [] (-> i64) (cmp "a" "a"))
; An error inside an imported module is reported in that module.
(defn imported-error [] (-> i64) (bad))
; A name the module, which has an export list, does not define at all.
(defn missing-qualified [] (-> i64) (coil.hashmap/no-such-name 0))
; A standard-library name that was removed, or moved to another module, says what
; replaced it wherever it is written: in a `:use` list (above: coil.prop, which has
; no export list, no longer re-exports coil.prop.gen's Gen), as a type bare or
; qualified, as the type of a `T::m` call, as a value, as a `fnptr-of` target and
; as a call. (Only `coil build` scans a project for removed names, and it does not
; reach tests/.)
(defn removed-type [] (-> i64) (sizeof Gen))
(defn removed-qualified-type [] (-> i64) (sizeof prop/GenAlt))
(defn removed-method-owner [] (-> i64) (prop/Gen::draw 1))
(defn removed-value [] (-> i64) (let [f prop/gen-bool] 0))
(defn removed-fnptr [] (-> i64) (let [f (fnptr-of coil.hashmap.hm-len)] 0))
(defn removed-call [] (-> i64) (prop/gen-int 1))

; Two traits declare `go`: an unqualified call is ambiguous, and A::nope names nothing.
(deftrait A [Self] (go [(x Self)] (-> i64)))
(deftrait B [Self] (go [(x Self)] (-> i64)))
(impl A i64 (go [(x i64)] (-> i64) 1))
(impl B i64 (go [(x i64)] (-> i64) 2))
(defn collide [] (-> i64) (go 5))
(defn no-such-method [] (-> i64) (A::nope 5))

; A call `bump!` rejects tries the method of that name on its first argument's
; type. When the method does not fit either, the note says why.
(defstruct Meter [(n i64)])
(impl Meter (bump! [(m (mut Meter)) (by i64)] (-> i64) (+ (.n m) by)))
(defn bump! [(x i64)] (-> i64) (+ x 1))
(deftrait Heavy [Self] (heft [(x Self) (scale bool)] (-> i64)))
(impl Heavy Meter (heft [(m Meter) (scale bool)] (-> i64) (.n m)))
(defn heft [(x i64) (y i64)] (-> i64) (+ x y))
(defn neither-fits [] (-> i64) (let [(mut m) (Meter :n 0)] (bump! (mut m) true)))
(defn neither-fits-trait [] (-> i64) (let [m (Meter :n 0)] (heft m 2)))

(defn main [] (-> i64) 0)
