(module diag.match-arms)
; An arm that earlier arms already cover can never run, and is an error: here the
; first Err arm takes every Err, so the (Err [(A [])]) arm is dead.
(defsum Fault (A) (B))

(defn unreachable-arm [(r (Result i64 Fault))] (-> i64)
  (match r
    (Err [_] 1)
    (Err [(A [])] 2)
    (Ok [v] v)))

(defn main [] (-> i64) 0)
