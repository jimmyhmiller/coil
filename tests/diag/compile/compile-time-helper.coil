(module diag.compile-time-helper)

; A helper a checker calls, whose body does not parse, is left out of the
; compile-time program. The error is the helper's own, at the arm it cannot read,
; not that the checker calls a function that does not exist.
(import "coil.primitive" :as primitive)

(defn look [(node Code)] (-> i64)
  (match (primitive/code-decl node)
    (primitive/Declared [module _ _ _] 1)
    _ 0))

(defn check [(prog Code)] (-> Code)
  (look prog)
  prog)

(checker check)

(defn main [] (-> i64) 0)
