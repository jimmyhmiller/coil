(module diag.ffi)
; Declarations of one C symbol may differ in integer width, but not in register
; class: the standard library declares read(int, void*, size_t), and no callee can
; take its first argument in both an integer and a float register.

(extern read :cc c [f64 (ptr i8) i64] (-> i64))

(defn go [(fd f64) (buf (ptr i8))] (-> i64)
  (read fd buf 8))

(defn main [] (-> i64) 0)
