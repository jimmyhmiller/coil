(module diag.generics)
; Compile-time value parameters and computed fields. One `coil check` reports all.
(defstruct Q [(const U Keyword)] [(v i64)])
(defstruct F [(const On bool)] [(v i64)])
(defstruct B [(const N i64)] [(v i64)])
(defstruct B8 [(const N u8)] [(v i64)])
(defstruct BU [(const N u64)] [(v i64)])
(defstruct BT [T] [(v T)])
(defn meters [(q (Q :meters))] (-> i64) (.v q))
(defn enabled [(f (F true))] (-> i64) (.v f))
(defn g [(const N i64)] [] (-> i64) 0)
(defn twice [(n i64)] (-> i64) (* n 2))
(const COMPUTED (twice 2))
(defn fixed3 [(x (array i64 3))] (-> i64) 0)
(defn pair [(const N i64)] [(x (array i64 N)) (y (array i64 N))] (-> i64) 0)

; A value parameter is part of the type.
(defn keyword-identity [] (-> i64) (let [f (: (Q :v 1) (Q :feet))] (meters f)))
(defn bool-identity [] (-> i64) (let [f (: (F :v 1) (F false))] (enabled f)))

; Arguments of the wrong kind, type or range.
(defn type-for-constant [(b (B u8))] (-> i64) (.v b))
(defn constant-for-type [(b (BT 4))] (-> i64) 0)
(defn out-of-range [(b (B8 300))] (-> i64) (.v b))
(defn negative-unsigned [(b (BU -1))] (-> i64) (.v b))
(defn keyword-for-integer [(b (B (const :x)))] (-> i64) (.v b))
(defn parameter-type-mismatch [(const M u8)] [(b (B M))] (-> i64) (.v b))
(defn parameter-as-type [(const N i64)] [(x N)] (-> i64) 0)
(defn bool-vec-width [(const N bool)] [(x (vec u8 N))] (-> i64) 0)
(defn bool-array-length [(const N bool)] [(x (array u8 N))] (-> i64) 0)
(defn explicit-type-for-constant [] (-> i64) (g [u8]))
(defn computed-constant [] (-> i64) (g [(const COMPUTED)]))

; Lengths.
(defn conflicting-lengths [] (-> i64) (pair [1 2] [1 2 3]))
(defn literal-length [(const N i64)] [] (-> i64) (let [xs (: [1 2] (array i64 N))] 0))
(defn fixed-length [(const N i64)] [(x (array i64 N))] (-> i64) (fixed3 x))
(defn parameter-in-comptime [(const N i64)] [] (-> i64) (comptime N))

; Computed fields: a field read with no impl, a write with no setter.
(defstruct Plain [(w i64)])
(defstruct Other [(v i64)])
(impl FieldGet (Field Other :computed)
  (get-field [(self (Field Other :computed)) (target Other)] (-> i64) (.v target)))
(defstruct Third [(v i64)])
(defn no-field [] (-> i64) (.missing (Plain :w 1)))
(defn read-only-field [] (-> i64) (let [(mut o) (Other :v 1)] (set! (.computed o) 2)) 0)
(defn field-of-integer [] (-> i64) (.missing 7))
(defn field-of-other-type [] (-> i64) (.computed (Third :v 1)))

(defn main [] (-> i64) 0)
