(module diag.bindings)
; Destructuring patterns in let, parameters and match arms. One `coil check`
; reports every mistake below.
(defstruct Point [(x i64)])
(defstruct Other [(x i64)])
(defstruct Owner [(value i64)])
(impl Drop Owner (drop [(self (mut Owner))] (-> void)))
(defstruct Wrapper [(owner Owner)])
(defsum Event (Wrapped [(wrapper Wrapper)]))
(defsum Box (Wrap [(value i64)]))
(defn first [([a b] (slice i64))] (-> i64) a)

(defn wrong-constructor [] (-> i64) (let [(Point :x x) (Other :x 42)] x))
(defn not-a-sequence [] (-> i64) (let [[a] 42] a))
(defn too-short [] (-> i64) (let [[a b c] [19 23]] a))
(defn named-pattern-parameter [] (-> i64) (first :a [19 23]))
(defn move-owning-element [(items (slice Owner))] (-> i64) (let [[owner] items] (.value owner)))
(defn move-owning-field [] (-> i64)
  (let [(Wrapper :owner owner) (Wrapper :owner (Owner :value 42))] (.value owner)))
(defn match-moves-owning-field [] (-> i64)
  (match (Wrapped (Wrapper :owner (Owner :value 42))) (Wrapped [(Wrapper :owner owner)] (.value owner))))
(defn arm-binding-shadows-macro [] (-> i64) (match (Wrap 5) (Wrap [when] (when 1 2))))

(defn main [] (-> i64) 0)
