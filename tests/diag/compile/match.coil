(module diag.match)
; Sum types and match: exhaustiveness looks inside nested patterns. One
; `coil check` reports every match below.
(defsum Color (Red) (Green) (Blue))
(defsum Fault (A) (B) (C [(code i64)]))

(defn missing-variant [(c Color)] (-> i64) (match c (Red [] 1) (Green [] 2)))
(defn missing-nested [(r (Result i64 Fault))] (-> i64)
  (match r (Err [(A [])] 1) (Err [(B [])] 2) (Ok [v] v)))
(defn missing-outer [(o (Option (Option i64)))] (-> i64)
  (match o (Some [(Some [v])] v) (None [] 0)))
(defn arm-without-value [(o (Option i64))] (-> i64) (match o (Some [x] x) (None [])))
(defn foreign-variant [(c Color)] (-> i64) (match c (Red [] 1) (Some [x] 2) (_ 3)))
(defn wrong-arity [(r (Result i64 Fault))] (-> i64) (match r (Ok [a b] a) (Err [_] 0)))

(defn main [] (-> i64) 0)
