; args: --target aarch64-apple-darwin
(module diag.shim-bad-gpr)
(import "coil.cc" :as cc)

; A (cc/Shim) calling convention names q0, a vector register on aarch64, where only a
; general-purpose register can carry an integer parameter.
(defcc myc :lower (cc/Shim) :params [q0] :ret x0 :clobber [x0 x1 x2 x3 x4 x5 x6 x7 x8 x9 x10 x11 x12 x13 x14 x15 x16 x17])

(defn f :cc myc [(a i64)] (-> i64)
  a)

(defn main [] (-> i64)
  0)
