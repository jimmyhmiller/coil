(module diag.simd)
; coil.simd: vector shapes and lane types are checked. One `coil check` reports
; every mistake below.
(import "coil.simd" :as v)
(import "coil.primitive" :as p)

(defn width-of-wrong-kind [] (-> i64) (do (v/vsplat [u8 f32] 1) 0))
(defn lane-of-wrong-kind [] (-> i64) (do (v/vsplat [(const 16) 4] 1) 0))
(defn lane-too-wide [] (-> i64) (do (p/vector-zero [(vec i128 4)]) 0))
(defn shapes-differ [] (-> i64) (do (v/vadd (v/vzero [u8 4]) (v/vzero [u8 8])) 0))
(defn conversion-changes-lane-count [] (-> i64) (do (p/vector-convert [(vec u16 8)] (v/vzero [u8 4])) 0))
(defn masked-load-pointer [] (-> i64)
  (do (v/vload-masked (cast (ptr u16) 0) (v/mask-low [4] 0) (v/vzero [u8 4])) 0))
(defn insert-lane-type [] (-> i64) (do (v/vinsert (v/vzero [u8 4]) 0 (cast u16 1)) 0))

(defn main [] (-> i64) 0)
