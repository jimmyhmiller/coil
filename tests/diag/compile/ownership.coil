(module diag.ownership)
; Ownership, borrows, defer and never. One `coil check` reports all of them.
(import "coil.alloc" :as alloc)
(import "coil.arc" :as arc)

(defstruct Owner [(value i64)])
(impl Drop Owner (drop [(self (mut Owner))] (-> void) (set! (.value self) 0)))
(defn consume [(o Owner)] (-> i64) (.value o))
(defstruct Pair [(a Owner) (b Owner)])

; Moves
(defn use-after-move [] (-> i64) (let [o (Owner :value 42)] (consume o) (consume o)))
(defn moved-in-one-branch [] (-> i64)
  (let [o (Owner :value 42)] (if true (do (consume o) 0) 0) (consume o)))
(defn moved-in-a-loop [(again bool)] (-> i64)
  (let [o (Owner :value 42)] (loop (consume o) (unless again (break))) 0))
(defn moved-by-one-break [(early bool)] (-> i64)
  (let [o (Owner :value 42)] (loop (when early (break)) (consume o) (break)) 0))
(defn move-out-of-field [] (-> i64)
  (let [p (Pair :a (Owner :value 1) :b (Owner :value 2))] (consume (.a p))))
(defn take-a-field [] (-> i64)
  (let [(mut p) (Pair :a (Owner :value 1) :b (Owner :value 2))] (consume (take! (mut (.a p))))))
(defn move-out-of-payload [(r (Result Owner i64))] (-> Owner)
  (match r (Ok [v] v) (Err [_] (Owner :value 0))))

; Borrows and temporaries
(defstruct Bag [(n i64)])
(impl Drop Bag (drop [(self (mut Bag))] (-> void) 0))
(impl Len Bag (len [(b Bag)] (-> i64) (.n b)))
(defn move-out-of-borrow [] (-> i64) (let [(mut b) (Bag :n 3)] (len (mut b))))
(defstruct Holder [(res Owner) (n i64)])
(defn make [] (-> Holder) (Holder :res (Owner :value 1) :n 2))
(defn move-out-of-temporary [] (-> i64) (let [r (.res (make))] (.value r)))
(defstruct Point [(x i64) (y i64)])
(defn origin [] (-> Point) (Point :x 0 :y 0))
(defn assign-to-temporary [] (-> i64) (set! (.x (origin)) 5) 0)
; An Arc outlives a borrowed allocator, so it needs a lease.
(defstruct Payload [(value i64)])
(defn borrowed-allocator-escapes [(borrowed (dyn alloc/Allocator))] (-> (Option (arc/Arc Payload)))
  (arc/Arc::new-in borrowed (Payload :value 42)))

; defer
(defn cleanup-moves [] (-> i64) (let [o (Owner :value 1)] (defer (consume o)) 0))
(defn cleanup-reads-moved [] (-> i64)
  (let [o (Owner :value 1)] (defer (println "{}" (.value o))) (consume o)))

; never
(defn gives-up [(n i64)] (-> never) (println "giving up {}" n) n)
(defn never-parameter [(x never)] (-> i64) 0)

(defn main [] (-> i64) 0)
