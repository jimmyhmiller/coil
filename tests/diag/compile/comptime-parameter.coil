(module diag.comptime-parameter)

; A parameter has no value until the function is called. A constant of its name is
; another thing, which compile-time code must not read in its place.
(const count 10)

(defn parameter-in-comptime [(count i64)] (-> i64)
  (comptime (+ count 1)))

(defn main [] (-> i64)
  (parameter-in-comptime 3))
