(module diag.compile-time-root)
; A function whose signature names no Code is compile-time code all the same when
; its body holds a quote, however deep: here in a static cell's initializer. Runtime
; code cannot call it, and the error names the chain from `main`.
(import "coil.primitive" :as primitive)

(defn default-form [] (-> i64)
  (let [cell (primitive/alloc-static Code '(+ 1 2))]
    7))

(defn main [] (-> i64) (default-form))
