; args: --target riscv32-unknown-none-elf
(module diag.machine-code)
(import "coil.primitive" :as primitive)
; Machine code is a defn's whole body: bytes for one coil.core.Arch, a whole
; number of its instructions, for the architecture being built for.

; csrr a0, mhartid
(defn hart :cc c [] (-> u32)
  (primitive/machine-code (Riscv32) 0x73 0x25 0x40 0xf1))

(defn not-the-body :cc c [] (-> u32)
  (do
    (primitive/machine-code (Riscv32) 0x73 0x25 0x40 0xf1)
    0))

(defn symbol-arch :cc c [] (-> void)
  (primitive/machine-code riscv32 0x13 0x00 0x00 0x00))

(defn computed-arch [] (-> Arch)
  (Riscv32))

(defn not-a-variant :cc c [] (-> void)
  (primitive/machine-code (computed-arch) 0x13 0x00 0x00 0x00))

(defn wasm :cc c [] (-> void)
  (primitive/machine-code (Wasm32) 0x01))

; c.ret, then the first half of a 32-bit instruction
(defn split :cc c [] (-> void)
  (primitive/machine-code (Riscv32) 0x82 0x80 0x13 0x00))

; add x0, x0, x1 is AArch64's
(defn other-arch :cc c [(a i64) (b i64)] (-> i64)
  (primitive/machine-code (Aarch64) 0x00 0x00 0x01 0x8b))

; inlined bytes need a convention naming their registers; C's does not
(defn inlined :cc c :inline (Always) [] (-> u32)
  (primitive/machine-code (Riscv32) 0x73 0x25 0x40 0xf1))

; a :shim convention does, so these are inlined
(defcc a0-only :params [a0] :ret a0 :clobber [] :lower shim)

(defn inlined-hart :cc a0-only :inline (Always) [] (-> u32)
  (primitive/machine-code (Riscv32) 0x73 0x25 0x40 0xf1))

(defn hinted-hart :cc a0-only :inline (Hint) [] (-> u32)
  (primitive/machine-code (Riscv32) 0x73 0x25 0x40 0xf1))

; a Coil body is compiled for C, which may change registers a0-only does not
; list, so a0-only may carry only machine code
(defn coil-body :cc a0-only [] (-> u32) 7)

(defn main [] (-> i64) (primitive/cast i64 (+ (hart) (+ (inlined-hart) (hinted-hart)))))
