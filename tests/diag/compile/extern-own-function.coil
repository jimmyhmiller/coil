(module diag.extern-own-function)
(import "coil.cc" :as cc)
; An extern naming the symbol of a function the program defines would be that
; definition, not an outside one.

(defn helper [(x i64)] (-> i64) x)
(extern outside :as "diag.extern-own-function.helper" :cc (cc/C) [i64] (-> i64))

(defn main [] (-> i64) 0)
