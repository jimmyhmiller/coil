(module diag.comptime)
; A const is computed by running Coil at compile time, but Code operations run only
; inside a macro: this one must be a macro that expands to the literal.
(import "coil.primitive" :as primitive)

(const DARWIN (primitive/code-eq (primitive/target-os) (quote darwin)))

(defn main [] (-> i64) (if DARWIN 1 0))
