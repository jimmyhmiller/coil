(module async-explicit-test)
(import "coil.primitive" :as primitive)
(import "coil.alloc" :as alloc)

(import "coil.async" :use *)
(import "coil.assert" :use *)

; A manually written asynchronous operation: it returns Pending twice, then Ready.
(defstruct CountState
  [(polls i64)
   (closed i64)
   (cancelled bool)])

(defn count-poll [(raw (ptr i8)) (cx (ptr Context))] (-> (Poll i64))
  (let [state (primitive/cast (ptr CountState) raw)
        polls (load (field state polls))]
    (if (< polls 2)
        (do
          (store! (field state polls) (+ polls 1))
          (Pending))
        (Ready 42))))

(defn count-close [(raw (ptr i8)) (cancelled bool)] (-> i64)
  (let [state (primitive/cast (ptr CountState) raw)]
    (store! (field state closed) (+ (load (field state closed)) 1))
    (store! (field state cancelled) cancelled)
    0))

(defstruct ParkState [(calls i64) (fail-code i64)])

(defn test-park [(raw (ptr i8))] (-> i64)
  (let [state (primitive/cast (ptr ParkState) raw)]
    (store! (field state calls) (+ (load (field state calls)) 1))
    (load (field state fail-code))))

(defn run-is-42 [(result (Result i64 TaskError))] (-> bool)
  (match result
    (Ok [value] (= value 42))
    (Err [_] false)))

(defn poll-is-completed [(result (Result (Poll i64) TaskError))] (-> bool)
  (match result
    (Ok [_] false)
    (Err [error]
         (match error
           (AlreadyCompleted [] true)
           (Closed [] false)
           (ParkFailed [_] false)))))

(defn poll-is-closed [(result (Result (Poll i64) TaskError))] (-> bool)
  (match result
    (Ok [_] false)
    (Err [error]
         (match error
           (AlreadyCompleted [] false)
           (Closed [] true)
           (ParkFailed [_] false)))))

(defn run-is-park-failed-17 [(result (Result i64 TaskError))] (-> bool)
  (match result
    (Ok [_] false)
    (Err [error]
         (match error
           (AlreadyCompleted [] false)
           (Closed [] false)
           (ParkFailed [code] (= code 17))))))

(defn main [] (-> i64)
  (let [cx (alloc/stack Context)
        state (alloc/stack CountState)
        task (alloc/stack (Task i64))
        park-state (alloc/stack ParkState)
        parker (alloc/stack Parker)]
    (store! (field cx user) (primitive/cast (ptr i8) 0))
    (store! (field state polls) 0)
    (store! (field state closed) 0)
    (store! (field state cancelled) false)
    (store! (field park-state calls) 0)
    (store! (field park-state fail-code) 0)
    (store! (field parker park-fn) (primitive/fnptr-of test-park))
    (store! (field parker state) (primitive/cast (ptr i8) park-state))
    (task-init task
               (primitive/cast (ptr i8) state)
               (primitive/fnptr-of count-poll)
               (primitive/fnptr-of count-close))
    
    (assert (run-is-42 (task-run task cx parker)))
    (assert-eq (load (field state polls)) 2)
    (assert-eq (load (field park-state calls)) 2)
    (assert (poll-is-completed (task-poll task cx)))
    (assert-eq (task-close task) 0)
    (assert-eq (load (field state closed)) 1)
    (assert-eq (load (field state cancelled)) false)
    (assert-eq (task-close task) 0)
    (assert-eq (load (field state closed)) 1)
    (assert (poll-is-closed (task-poll task cx)))
    
    ; Closing a pending task reports cancellation to its cleanup function.
    (store! (field state polls) 0)
    (store! (field state closed) 0)
    (store! (field state cancelled) false)
    (task-init task
               (primitive/cast (ptr i8) state)
               (primitive/fnptr-of count-poll)
               (primitive/fnptr-of count-close))
    (assert-eq (task-close task) 0)
    (assert-eq (load (field state cancelled)) true)
    
    ; A parker failure is typed and leaves the pending task available for cleanup.
    (store! (field state polls) 0)
    (store! (field state closed) 0)
    (store! (field state cancelled) false)
    (store! (field park-state fail-code) 17)
    (task-init task
               (primitive/cast (ptr i8) state)
               (primitive/fnptr-of count-poll)
               (primitive/fnptr-of count-close))
    (assert (run-is-park-failed-17 (task-run task cx parker)))
    (assert-eq (task-close task) 0)
    (assert-eq (load (field state cancelled)) true)
    0))
