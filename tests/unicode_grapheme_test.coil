(module coil.tests.unicode-grapheme)
(import "coil.assert" :use *)
(import "coil.str" :as string)
(import "coil.unicode.grapheme" :as grapheme)

(defn grapheme-count [(text string/StringView)] (-> i64)
  (let [(mut iterator) (iter (grapheme/chars text))
        (mut count) 0]
    (loop (match (next (mut iterator))
            (None [] (break))
            (Some [char] (store! count (+ (load count) 1)))))
    (load count)))

(deftest combining-sequence-is-one-character
         (assert-eq (grapheme-count (string/string-view-unchecked "e\x301;")) 1))

(deftest controls-and-crlf-follow-uax29
         (do
           (assert-eq (grapheme-count (string/string-view-unchecked "\r\n")) 1)
           (assert-eq (grapheme-count (string/string-view-unchecked "a\nb")) 3)))

(deftest hangul-jamo-form-one-cluster
         (assert-eq (grapheme-count (string/string-view-unchecked "\x1100;\x1161;\x11a8;")) 1))

(deftest emoji-zwj-and-modifier-sequences-form-one-cluster
         (do
           (assert-eq (grapheme-count (string/string-view-unchecked "\x1f469;\x200d;\x1f4bb;")) 1)
           (assert-eq (grapheme-count (string/string-view-unchecked "\x1f44d;\x1f3fd;")) 1)
           (assert-eq (grapheme-count (string/string-view-unchecked "\x1f468;\x200d;\x1f469;\x200d;\x1f467;\x200d;\x1f466;"))
                      1)))

(deftest regional-indicators-pair-from-the-start
         (do
           (assert-eq (grapheme-count (string/string-view-unchecked "\x1f1fa;\x1f1f8;")) 1)
           (assert-eq (grapheme-count (string/string-view-unchecked "\x1f1fa;\x1f1f8;\x1f1e8;")) 2)))

(deftest prepend-spacing-mark-and-indic-conjunct-rules
         (do
           (assert-eq (grapheme-count (string/string-view-unchecked "\x600;a")) 1)
           (assert-eq (grapheme-count (string/string-view-unchecked "\x915;\x903;")) 1)
           (assert-eq (grapheme-count (string/string-view-unchecked "\x915;\x94d;\x915;")) 1)))

(deftest character-iterator-returns-borrowed-cluster-views
         (let [text (string/string-view-unchecked "e\x301;x")
               (mut iterator) (iter (grapheme/chars text))]
           (match (next (mut iterator))
             (None [] (assert false))
             (Some [char]
                   (assert (= (grapheme/char-view char)
                              (string/string-view-unchecked "e\x301;")))))
           (match (next (mut iterator))
             (None [] (assert false))
             (Some [char]
                   (assert (= (grapheme/char-view char)
                              (string/string-view-unchecked "x")))))
           (match (next (mut iterator))
             (None [] (assert true))
             (Some [char] (assert false)))))
