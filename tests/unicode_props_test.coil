(module unicode-props-test)
(import "coil.alloc" :use [malloc-allocator])
(import "coil.str" :as string :use [Rune sv])
(import "coil.unicode" :as u)

(defn rune [(value u32)] (-> Rune)
  (Rune :value value))

(defn cat [(value u32)] (-> (slice u8))
  (u/general-category-abbrev (u/general-category (rune value))))

(defn lower [(value u32)] (-> u32)
  (string/rune-value (u/to-lower (rune value))))

(defn upper [(value u32)] (-> u32)
  (string/rune-value (u/to-upper (rune value))))

(defn title [(value u32)] (-> u32)
  (string/rune-value (u/to-title (rune value))))

(defn fold [(value u32)] (-> u32)
  (string/rune-value (u/case-fold (rune value))))

(defn same-text? [(s string/String) (expected (slice u8))] (-> bool)
  (let [ok (= (string/string-view-bytes (string/string-as-view s)) expected)]
    (when (not ok)
      (println "got {:?}, want {:?}"
               (string/string-view-bytes (string/string-as-view s))
               expected))
    ok))

(deftest version-is-recorded
         (assert (= (u/unicode-version) "17.0.0")))

(deftest general-categories-across-scripts
         (assert (= (cat 0x41) "Lu"))
         (assert (= (cat 0x61) "Ll"))
         (assert (= (cat 0x1C5) "Lt"))
         (assert (= (cat 0x2B0) "Lm"))
         (assert (= (cat 0x4E2D) "Lo"))
         (assert (= (cat 0x301) "Mn"))
         (assert (= (cat 0x903) "Mc"))
         (assert (= (cat 0x20DD) "Me"))
         (assert (= (cat 0x663) "Nd"))
         (assert (= (cat 0x216B) "Nl"))
         (assert (= (cat 0xBD) "No"))
         (assert (= (cat 0x5F) "Pc"))
         (assert (= (cat 0x2D) "Pd"))
         (assert (= (cat 0x28) "Ps"))
         (assert (= (cat 0x29) "Pe"))
         (assert (= (cat 0xAB) "Pi"))
         (assert (= (cat 0xBB) "Pf"))
         (assert (= (cat 0x21) "Po"))
         (assert (= (cat 0x2B) "Sm"))
         (assert (= (cat 0x20AC) "Sc"))
         (assert (= (cat 0x5E) "Sk"))
         (assert (= (cat 0xA9) "So"))
         (assert (= (cat 0x20) "Zs"))
         (assert (= (cat 0x2028) "Zl"))
         (assert (= (cat 0x2029) "Zp"))
         (assert (= (cat 0x7) "Cc"))
         (assert (= (cat 0x200B) "Cf"))
         (assert (= (cat 0xE000) "Co"))
         (assert (= (cat 0x378) "Cn"))
         ; Supplementary planes.
         (assert (= (cat 0x10400) "Lu"))
         (assert (= (cat 0x1D400) "Lu"))
         (assert (= (cat 0x1F600) "So"))
         (assert (= (cat 0x20000) "Lo"))
         (assert (= (cat 0xE0001) "Cf"))
         (assert (= (cat 0xF0000) "Co"))
         (assert (= (cat 0x10FFFF) "Cn"))
         (assert (= (u/general-category (rune 0x41)) (u/UppercaseLetter)))
         (assert (= (u/general-category (rune 0x10FFFF)) (u/Unassigned))))

(deftest letters-in-many-scripts
         ; The word-frequency case: one predicate instead of hand-listed ranges.
         (for value
           [0x61
            0x5A
            0xE9
            0x3B1
            0x3A9
            0x436
            0x531
            0x5D0
            0x627
            0x915
            0xE01
            0x3042
            0x30AB
            0xAC00
            0x4E2D
            0x10D0
            0x13A0
            0x1200
            0x10400
            0x1D400]
           (assert (u/letter? (rune (cast u32 value))))
           (assert (u/alphabetic? (rune (cast u32 value))))
           (assert (u/alphanumeric? (rune (cast u32 value)))))
         (for value
           [0x30 0x663 0x2D 0x20 0x21 0x1F600 0x301 0x200B 0x378]
           (assert (not (u/letter? (rune (cast u32 value))))))
         ; Alphabetic is wider than the letter categories.
         (assert (u/alphabetic? (rune 0x345)))
         (assert (not (u/letter? (rune 0x345))))
         (assert (u/alphabetic? (rune 0x216B)))
         (assert (u/mark? (rune 0x301)))
         (assert (u/punctuation? (rune 0xBF)))
         (assert (u/symbol? (rune 0x20AC)))
         (assert (u/control? (rune 0x0)))
         (assert (not (u/control? (rune 0x200B)))))

(deftest numbers-and-digits
         (for value
           [0x30 0x39 0x663 0x966 0xFF15 0x1D7CE]
           (assert (u/decimal-digit? (rune (cast u32 value))))
           (assert (u/numeric? (rune (cast u32 value))))
           (assert (u/number? (rune (cast u32 value)))))
         ; Numeric without being a decimal digit: fractions, Roman numerals, CJK numerals.
         (for value
           [0xBD 0x216B 0x4E94 0x2460]
           (assert (u/numeric? (rune (cast u32 value))))
           (assert (not (u/decimal-digit? (rune (cast u32 value))))))
         (assert (u/letter? (rune 0x4E94)))
         (assert (not (u/number? (rune 0x4E94))))
         (assert (not (u/numeric? (rune 0x41)))))

(deftest whitespace-is-the-white-space-property
         (for value
           [0x9
            0xA
            0xB
            0xC
            0xD
            0x20
            0x85
            0xA0
            0x1680
            0x2000
            0x2003
            0x200A
            0x2028
            0x2029
            0x202F
            0x205F
            0x3000]
           (assert (u/whitespace? (rune (cast u32 value)))))
         (for value
           [0x0 0x1C 0x1F 0x200B 0x180E 0xFEFF 0x41]
           (assert (not (u/whitespace? (rune (cast u32 value)))))))

(deftest uppercase-and-lowercase-properties
         (assert (u/uppercase? (rune 0x3A3)))
         (assert (u/lowercase? (rune 0x3C3)))
         (assert (u/lowercase? (rune 0x3C2)))
         (assert (u/uppercase? (rune 0x24B6)))
         (assert (u/lowercase? (rune 0xAA)))
         (assert (not (u/uppercase? (rune 0x1C5))))
         (assert (not (u/lowercase? (rune 0x1C5))))
         (assert (not (u/uppercase? (rune 0x4E2D))))
         (assert (not (u/lowercase? (rune 0x31)))))

(deftest simple-case-mappings
         (assert-eq (lower 0x41) 0x61)
         (assert-eq (upper 0x7A) 0x5A)
         (assert-eq (upper 0x31) 0x31)
         ; Greek, including final sigma.
         (assert-eq (lower 0x3A3) 0x3C3)
         (assert-eq (upper 0x3C2) 0x3A3)
         (assert-eq (upper 0x3AC) 0x386)
         ; Cyrillic, Armenian, Georgian (Mkhedruli uppercases to Mtavruli).
         (assert-eq (lower 0x416) 0x436)
         (assert-eq (upper 0x451) 0x401)
         (assert-eq (lower 0x531) 0x561)
         (assert-eq (upper 0x10D0) 0x1C90)
         (assert-eq (lower 0x1C90) 0x10D0)
         ; Cherokee and Deseret (a supplementary plane).
         (assert-eq (lower 0x13A0) 0xAB70)
         (assert-eq (lower 0x10400) 0x10428)
         (assert-eq (upper 0x10428) 0x10400)
         ; Single-code-point mappings only: SpecialCasing.txt is not applied.
         (assert-eq (lower 0x130) 0x69)
         (assert-eq (upper 0x131) 0x49)
         (assert-eq (upper 0xDF) 0xDF)
         (assert-eq (lower 0x1E9E) 0xDF)
         (assert-eq (upper 0xFF) 0x178)
         (assert-eq (upper 0xB5) 0x39C)
         ; Titlecase differs from uppercase for the digraphs.
         (assert-eq (upper 0x1C6) 0x1C4)
         (assert-eq (title 0x1C6) 0x1C5)
         (assert-eq (title 0x1C4) 0x1C5)
         (assert-eq (title 0x61) 0x41)
         ; Mappings that change the UTF-8 length.
         (assert-eq (upper 0x23F) 0x2C7E)
         (assert-eq (lower 0x2C7E) 0x23F))

(deftest case-folding
         (assert-eq (fold 0x41) 0x61)
         (assert-eq (fold 0x61) 0x61)
         (assert-eq (fold 0x3A3) 0x3C3)
         (assert-eq (fold 0x3C2) 0x3C3)
         (assert-eq (fold 0xB5) 0x3BC)
         (assert-eq (fold 0x17F) 0x73)
         (assert-eq (fold 0x212A) 0x6B)
         (assert-eq (fold 0x1E9E) 0xDF)
         (assert-eq (fold 0xAB70) 0x13A0)
         (assert-eq (fold 0x13A0) 0x13A0)
         (assert-eq (fold 0x10400) 0x10428))

(deftest round-trips
         ; Case folding is idempotent for every scalar value, and every fold target is
         ; its own fold (Unicode stability guarantees both).
         (for cp
           (range 0 0x110000)
           (match (string/rune-new (cast u32 cp))
             (None [] 0)
             (Some [r]
                   (let [f (u/case-fold r)]
                     (assert (= (string/rune-value (u/case-fold f))
                                (string/rune-value f)))
                     0))))
         ; Lowercase then uppercase returns each capital of these bicameral alphabets.
         (for range-pair
           [[0x41 0x5A]
            [0xC0 0xD6]
            [0x391 0x3A1]
            [0x3A3 0x3A9]
            [0x410 0x42F]
            [0x531 0x556]
            [0x10A0 0x10C5]
            [0x10400 0x10427]
            [0xFF21 0xFF3A]]
           (for cp
             (range (get range-pair 0) (+ (get range-pair 1) 1))
             (let [r (rune (cast u32 cp))]
               (assert (u/uppercase? r))
               (assert (u/lowercase? (u/to-lower r)))
               (assert-eq (string/rune-value (u/to-upper (u/to-lower r)))
                          (cast u32 cp))
               (assert-eq (string/rune-value (u/case-fold r))
                          (string/rune-value (u/case-fold (u/to-lower r))))))))

(deftest strings
         (let [a (malloc-allocator)]
           (let [(mut s)
                   (u/string-to-lower a
                                      (sv "Ünïcödé ΣΑΣ Привет 123"))]
             (assert (same-text? s "ünïcödé σασ привет 123"))
             (string/string-free! (mut s)))
           (let [(mut s) (u/string-to-upper a (sv "straße ǆ ȿ ı"))]
             ; ß has no single-character uppercase; ȿ grows from two bytes to three
             ; and ı shrinks from two bytes to one.
             (assert (same-text? s "STRAßE Ǆ Ȿ I"))
             (string/string-free! (mut s)))
           (let [(mut x)
                   (u/string-case-fold a
                                       (sv "ПРИВЕТ, Kelvin \x212a; ſ µ"))
                 (mut y)
                   (u/string-case-fold a (sv "привет, kelvin k s μ"))]
             (assert (= (string/string-as-view x) (string/string-as-view y)))
             (string/string-free! (mut x))
             (string/string-free! (mut y)))
           ; Any Text works, including an owned String.
           (let [(mut owned) (string/string-from-view a (sv "MiXeD"))
                 (mut s) (u/string-to-lower a owned)]
             (assert (same-text? s "mixed"))
             (string/string-free! (mut owned))
             (string/string-free! (mut s)))
           (let [(mut s) (u/string-to-upper a (sv ""))]
             (assert (same-text? s ""))
             (string/string-free! (mut s)))))
