(module coil.tests.compile-error)
(import "coil.test.compile" :use [assert-compile-error compile-errors])
(import "coil.alloc" :use [free malloc-allocator])
(import "coil.result" :use [none? some?])

;; A type error, located in this file where the bad argument is written.
(deftest a-type-error-is-the-diagnostic
  (assert-compile-error ["argument 2 to '+' has type (slice u8) but expected i64"
                         "compile_error_test.coil:11:12"]
    (defn f [] (-> i64)
      (+ 1 "two"))))

;; A macro's located error is the diagnostic, not "checker reported error(s) above".
(deftest a-macro-error-is-the-diagnostic
  (assert-compile-error "error: the argument must be positive"
    (import "coil.primitive" :as primitive)
    (defn positive [(x Code)] (-> Code)
      (if (> (primitive/code-int x) 0)
          x
          (do (primitive/report x "the argument must be positive") `0)))
    (defn g [] (-> i64)
      (positive -3))))

;; Every error of one compile is reported, not only the first.
(deftest every-error-is-reported
  (assert-compile-error ["call to undefined function 'nowhere'"
                         "call to undefined function 'elsewhere'"]
    (defn h [] (-> i64)
      (nowhere))
    (defn k [] (-> i64)
      (elsewhere))))

;; Forms that compile have no diagnostics.
(deftest code-that-compiles-has-none
  (assert (none? (compile-errors (defn fine [(x i64)] (-> i64)
                                   (* x 2))))))

;; The diagnostics are data the test can read.
(deftest compile-errors-returns-the-text
  (match (compile-errors (defn bad [] (-> i64)
                           undefined-name))
    (Some [text]
          (do
            (assert (some? (find text "undefined-name")))
            (free [u8] (malloc-allocator) text)
            0))
    (None [] (assert false))))
