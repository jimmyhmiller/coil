(module http-server-pure-test)
(import "coil.http.server" :as http)
(import "coil.alloc" :as alloc)
(import "coil.str" :as str)
(import "coil.primitive" :as primitive)
(import "coil.http.parser" :as ll)

(defn crlf [(b (mut str/StrBuf))] (-> i64)
  (str/sb-push-byte! (mut b) (primitive/cast u8 13))
  (str/sb-push-byte! (mut b) (primitive/cast u8 10)))

(defn request [] (-> (slice u8))
  (let [(mut b) (str/sb-new (alloc/malloc-allocator))]
    (str/sb-push-str! (mut b) "GET / HTTP/1.1")
    (crlf (mut b))
    (str/sb-push-str! (mut b) "Host: example.test")
    (crlf (mut b))
    (crlf (mut b))
    (str/sb-str b)))

(deftest pure-http-server
         (match (http/parse-request (alloc/malloc-allocator) (request))
           (Ok [req] (http/request-free req))
           (Err [e]
                (do
                  (println "http server error code={} offset={}"
                           (http/error-code e)
                           (http/error-offset e))
                  (assert false)))))

(defn parse-version [(input (slice u8))] (-> (slice u8))
  (match (http/parse-request (alloc/malloc-allocator) input)
    (Ok [req] (do (http/request-free req) (http/version req)))
    (Err [e]
         (do
           (println "http server error code={} offset={}"
                    (http/error-code e)
                    (http/error-offset e))
           (assert false)
           ""))))

; parse-request reports the version on the request line, for every version
; strict llhttp accepts.
(deftest version-is-the-one-on-the-wire
         (assert (str/str-eq (parse-version "GET / HTTP/0.9\r\n\r\n")
                             "HTTP/0.9"))
         (assert (str/str-eq (parse-version "GET / HTTP/1.0\r\n\r\n")
                             "HTTP/1.0"))
         (assert (str/str-eq (parse-version "GET / HTTP/1.1\r\n\r\n")
                             "HTTP/1.1"))
         (assert (str/str-eq (parse-version "GET / HTTP/2.0\r\n\r\n")
                             "HTTP/2.0")))

(defn truncated-code [(input (slice u8))] (-> i64)
  (match (http/parse-request (alloc/malloc-allocator) input)
    (Ok [req] (do (http/request-free req) (assert false) 0))
    (Err [e] (http/error-code e))))

; Input with no complete request is truncated, whether or not it stops at a
; message boundary.
(deftest truncated-input-is-invalid-eof-state
         (assert-eq (truncated-code "") ll/HPE_INVALID_EOF_STATE)
         (assert-eq (truncated-code "\r\n") ll/HPE_INVALID_EOF_STATE)
         (assert-eq (truncated-code "GET / HTTP/1.1\r\n")
                    ll/HPE_INVALID_EOF_STATE))

; A Content-Length of 2^64-1 is a (truncated) body, not an empty one: the
; request must not be accepted with the header block as its body boundary.
(deftest huge-content-length-is-truncated
         (assert-eq (truncated-code "POST / HTTP/1.1\r\nContent-Length: 18446744073709551615\r\n\r\nhello")
                    ll/HPE_INVALID_EOF_STATE))
