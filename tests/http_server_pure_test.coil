(module http-server-pure-test)
(import "coil.http.server" :as http)
(import "coil.alloc" :as alloc)
(import "coil.str" :as str)
(import "coil.primitive" :as primitive)

(defn crlf [(b (mut str/StrBuf))] (-> i64)
  (str/sb-push-byte! (mut b) (primitive/cast u8 13))
  (str/sb-push-byte! (mut b) (primitive/cast u8 10)))

(defn request [] (-> (slice u8))
  (let [(mut b) (str/sb-new (alloc/malloc-allocator))]
    (str/sb-push-str! (mut b) "GET / HTTP/1.1")
    (crlf (mut b))
    (str/sb-push-str! (mut b) "Host: example.test")
    (crlf (mut b))
    (crlf (mut b))
    (str/sb-str b)))

(deftest pure-http-server
         (match (http/parse-request (alloc/malloc-allocator) (request))
           (Ok [req] (http/request-free req))
           (Err [e]
                (do
                  (println "http server error code={} offset={}" (http/error-code e) (http/error-offset e))
                  (assert false)))))
