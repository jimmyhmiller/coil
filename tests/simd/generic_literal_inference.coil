(module test.simd.generic-literal-inference)

(defn first [T] [(a T) (b T)] (-> T) a)
(defn second [T] [(a T) (b T)] (-> T) b)
(defn identity [T] [(a T)] (-> T) a)

(defn run [] (-> i64)
  (let [byte (: 7 u8)]
    (assert-eq (first byte 42) byte)
    (assert-eq (first 42 byte) (: 42 u8))
    (assert-eq (second byte 42) (: 42 u8))
    (assert-eq (second 42 byte) byte)
    (assert-eq (identity 42) 42)
    (assert-eq (second 1 42) 42)
    0))
