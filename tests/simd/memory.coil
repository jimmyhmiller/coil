(module test.simd.memory)
(import "coil.simd" :as v)
(import "coil.primitive" :as p)

(defn run [] (-> i64)
  (let [data (p/alloc-stack (array u8 32))
        base (cast (ptr u8) data)
        fill (v/vsplat [u8 16] 99)]
    (for [i 0 32] (store! (p/index base i) (cast u8 i)))
    (for [n -1 18]
      (let [value (v/vload-partial base n fill)]
        (for [i 0 16]
          (assert-eq (v/vextract value i) (if (< i n) (cast u8 i) (: 99 u8))))))
    (v/vstore-partial (p/index base 1) 3 (v/vsplat [u8 16] 42))
    (assert-eq (load base) (: 0 u8))
    (assert-eq (load (p/index base 1)) (: 42 u8))
    (assert-eq (load (p/index base 3)) (: 42 u8))
    (assert-eq (load (p/index base 4)) (: 4 u8))
    (let [offsets (v/vinsert (v/vsplat [i32 4] 4) 3 8)
          active (v/bits->mask [4] 0xb)
          values (v/vgather base offsets active (v/vsplat [u8 4] 99))]
      (assert-eq (v/vextract values 0) (: 4 u8))
      (assert-eq (v/vextract values 2) (: 99 u8))
      (assert-eq (v/vextract values 3) (: 8 u8))
      (v/vscatter base offsets active (v/vinsert values 1 77))
      (assert-eq (load (p/index base 4)) (: 77 u8)))
    ; All-inactive memory calls accept an inaccessible pointer.
    (let [null (cast (ptr u8) 0) off (v/vsplat [i64 16] -1)
          inactive (v/bits->mask [16] 0)]
      (assert-eq (v/vextract (v/vload-masked null inactive fill) 0) (: 99 u8))
      (assert-eq (v/vextract (v/vgather null off inactive fill) 15) (: 99 u8))
      (v/vstore-masked null inactive fill)
      (v/vscatter null off inactive fill))
    0))
