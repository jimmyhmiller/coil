;; Every coil.simd operation's semantics in one program: each module under
;; tests/simd/ is a former single-feature fixture whose `run` returns 0 and asserts
;; as it goes. scripts/tests/simd.py builds this on LLVM (at -O0 and -O3, since LLVM
;; lowers compress/expand as a loop over the mask) and on the native backend.
(module test.simd.semantics)
(import "test.simd.generic-literal-inference" :as generic-literal-inference)
(import "test.simd.vector-odd-layout" :as vector-odd-layout)
(import "test.simd.generic-width" :as generic-width)
(import "test.simd.core" :as core)
(import "test.simd.arithmetic" :as arithmetic)
(import "test.simd.memory" :as memory)
(import "test.simd.permute" :as permute)
(import "test.simd.scans" :as scans)
(import "test.simd.resize" :as resize)
(import "test.simd.float-edges" :as float-edges)
(import "test.simd.guard-page" :as guard-page)
(import "test.simd.portable" :as portable)
(import "test.simd.vector-fma-single-rounding" :as vector-fma-single-rounding)
(import "test.simd.bitmap" :as bitmap)
(import "test.simd.clmul" :as clmul)
(import "test.simd.aggregate" :as aggregate)
(import "test.simd.scan-shapes" :as scan-shapes)
(import "test.simd.compress-sparse" :as compress-sparse)

(defn check [(name (slice u8)) (result i64)] (-> i64)
  (when (!= result 0) (println "FAIL {} returned {}" name result))
  result)

(defn main [] (-> i64)
  (+ 0
  (check "generic_literal_inference" (generic-literal-inference/run))
  (check "vector_odd_layout" (vector-odd-layout/run))
  (check "generic_width" (generic-width/run))
  (check "core" (core/run))
  (check "arithmetic" (arithmetic/run))
  (check "memory" (memory/run))
  (check "permute" (permute/run))
  (check "scans" (scans/run))
  (check "resize" (resize/run))
  (check "float_edges" (float-edges/run))
  (check "guard_page" (guard-page/run))
  (check "portable" (portable/run))
  (check "vector_fma_single_rounding" (vector-fma-single-rounding/run))
  (check "bitmap" (bitmap/run))
  (check "clmul" (clmul/run))
  (check "aggregate" (aggregate/run))
  (check "scan_shapes" (scan-shapes/run))
  (check "compress_sparse" (compress-sparse/run))))
