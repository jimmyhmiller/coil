;; Mask operations at lane counts on both sides of every byte boundary. A mask
;; packs its lanes one bit each, and and/or/xor/not, a select between masks,
;; any/all/none and the bitmap act on those bytes; a comparison builds them.
;; Every result is checked lane by lane against the same operation on bools,
;; and through memory, where the bits past the last lane must stay clear.
(module test.simd.mask-bytes)
(import "coil.simd" :as v)
(import "coil.primitive" :as p)

(defn mix [(x u64)] (-> u64)
  (let [a (p/imul (p/ixor x (p/ishr x (: 33 u64))) (: 0xff51afd7ed558ccd u64))
        b (p/imul (p/ixor a (p/ishr a (: 33 u64))) (: 0xc4ceb9fe1a85ec53 u64))]
    (p/ixor b (p/ishr b (: 33 u64)))))

;;; A mask of N lanes whose lane i is bit i of the stream seeded by SEED, built
;;; by a comparison so that any N works.
(defn pattern [(const N i64)] [(seed u64)] (-> (vec bool N))
  (let [(mut lanes) (v/vzero [u8 N])]
    (for [i 0 N]
      (set! lanes
            (v/vinsert lanes
                       i
                       (cast u8
                             (p/iand (p/ishr (mix (p/iadd seed
                                                          (cast u64 (/ i 64))))
                                             (cast u64 (% i 64)))
                                     (: 1 u64))))))
    (v/v= lanes (v/vsplat [u8 N] 1))))

(defn lane [(seed u64) (i i64)] (-> bool)
  (!= (p/iand (p/ishr (mix (p/iadd seed (cast u64 (/ i 64))))
                      (cast u64 (% i 64)))
              (: 1 u64))
      (: 0 u64)))

;;; The bytes a mask of N lanes occupies, read back from memory.
(defn stored-byte [(const N i64)] [(m (vec bool N)) (k i64)] (-> u8)
  (let [(mut cell) m]
    (load (p/index (p/cast (ptr u8) (mut cell)) k))))

(defn check-one [(const N i64)] [(sa u64) (sb u64) (sc u64)] (-> i64)
  (let [a (pattern [N] sa)
        b (pattern [N] sb)
        c (pattern [N] sc)
        both (v/vand a b)
        either (v/vor a b)
        differ (v/vxor a b)
        negated (v/vnot a)
        chosen (v/vselect c a b)
        (mut any-a) false
        (mut all-a) true
        (mut bits) (: 0 u64)]
    (for [i 0 N]
      (let [x (lane sa i)
            y (lane sb i)
            z (lane sc i)]
        (assert-eq (v/vextract a i) x)
        (assert-eq (v/vextract both i) (and x y))
        (assert-eq (v/vextract either i) (or x y))
        (assert-eq (v/vextract differ i) (!= x y))
        (assert-eq (v/vextract negated i) (not x))
        (assert-eq (v/vextract chosen i) (if z x y))
        (when x (set! any-a true))
        (unless x (set! all-a false))
        (when (and x (< i 64))
          (set! bits (p/ior bits (p/ishl (: 1 u64) (cast u64 i)))))))
    (assert-eq (v/mask-any? a) any-a)
    (assert-eq (v/mask-all? a) all-a)
    (assert-eq (v/mask-none? a) (not any-a))
    (assert (v/mask-all? (v/vor a negated)))
    (assert (v/mask-none? (v/vand a negated)))
    (assert (v/mask-all? (v/vxor a negated)))
    (assert (v/mask-none? (v/vxor a a)))
    (assert-eq (v/mask-any? (v/vnot (v/vor a negated))) false)
    ; packed layout: lane i is bit i%8 of byte i/8; nothing past lane N-1
    (for [k 0 (/ (+ N 7) 8)]
      (let [(mut want-a) (: 0 u8)
            (mut want-not) (: 0 u8)
            (mut want-chosen) (: 0 u8)]
        (for [j 0 8]
          (let [i (+ (* k 8) j)]
            (when (< i N)
              (let [bit (p/ishl (: 1 u8) (cast u8 j))]
                (when (lane sa i) (set! want-a (p/ior want-a bit)))
                (unless (lane sa i) (set! want-not (p/ior want-not bit)))
                (when (if (lane sc i) (lane sa i) (lane sb i))
                  (set! want-chosen (p/ior want-chosen bit)))))))
        (assert-eq (stored-byte a k) want-a)
        (assert-eq (stored-byte negated k) want-not)
        (assert-eq (stored-byte chosen k) want-chosen)
        (assert-eq (stored-byte (v/vxor a (v/vnot (v/vzero [bool N]))) k)
                   want-not)))
    0))

(defn check-bits [(const N i64)] [(seed u64)] (-> i64)
  (let [a (pattern [N] seed)
        (mut bits) (: 0 u64)]
    (for [i 0 N]
      (when (lane seed i)
        (set! bits (p/ior bits (p/ishl (: 1 u64) (cast u64 i))))))
    (assert-eq (v/mask->bits a) bits)
    (assert-eq (v/mask->bits (v/vnot a))
               (p/iand (p/ixor bits (: 0xFFFFFFFFFFFFFFFF u64))
                       (if (= N 64)
                           (: 0xFFFFFFFFFFFFFFFF u64)
                           (p/isub (p/ishl (: 1 u64) (cast u64 N)) (: 1 u64)))))
    0))

(defn check [(const N i64)] [] (-> i64)
  (for [round 0 6]
    (let [s (p/imul (cast u64 (+ (* N 131) round)) (: 0x9e3779b97f4a7c15 u64))]
      (check-one [N] s (p/iadd s (: 1000 u64)) (p/iadd s (: 2000 u64)))))
  ; all clear, all set, and one lane short of each
  (assert-eq (v/mask-any? (v/vzero [bool N])) false)
  (assert-eq (v/mask-all? (v/vzero [bool N])) (= N 0))
  (assert (v/mask-all? (v/vnot (v/vzero [bool N]))))
  (assert-eq (v/mask-all? (v/mask-low [N] (- N 1))) false)
  (assert (v/mask-any? (v/vxor (v/mask-low [N] N) (v/mask-low [N] (- N 1)))))
  0)

(defn run [] (-> i64)
  (check [(const 1)])
  (check [(const 2)])
  (check [(const 3)])
  (check [(const 4)])
  (check [(const 7)])
  (check [(const 9)])
  (check [(const 12)])
  (check [(const 17)])
  (check [(const 31)])
  (check [(const 33)])
  (check [(const 63)])
  (check [(const 65)])
  (check [(const 8)])
  (check [(const 16)])
  (check [(const 32)])
  (check [(const 64)])
  (check [(const 128)])
  (check-bits [(const 1)] 7)
  (check-bits [(const 2)] 8)
  (check-bits [(const 3)] 21)
  (check-bits [(const 4)] 9)
  (check-bits [(const 7)] 22)
  (check-bits [(const 9)] 23)
  (check-bits [(const 17)] 24)
  (check-bits [(const 31)] 25)
  (check-bits [(const 33)] 26)
  (check-bits [(const 63)] 27)
  (check-bits [(const 8)] 10)
  (check-bits [(const 16)] 11)
  (check-bits [(const 32)] 12)
  (check-bits [(const 64)] 13)
  0)
