(module test.simd.core)
(import "coil.simd" :as v)
(import "coil.primitive" :as p)

(defn classify [(const N i64)] [(bytes (vec u8 N))] (-> u64)
  (let [digits (v/vand (v/v>= bytes (v/vsplat [u8 N] 48))
                      (v/v<= bytes (v/vsplat [u8 N] 57)))]
    (v/mask->bits digits)))

(defn run [] (-> i64)
  (let [bytes (v/vloadu [u8 16] (data "a0b1c2d3e4f5g6h7"))]
    (assert-eq (classify bytes) (: 0xaaaa u64))
    (assert-eq (v/vlanes bytes) 16)
    (assert-eq (v/vextract bytes 0) (: 97 u8))
    (assert-eq (v/vextract bytes 16) (: 0 u8))
    (assert-eq (v/vextract (v/vinsert bytes 0 42) 0) (: 42 u8))
    (assert-eq (v/mask->bits (v/bits->mask [16] 0x8001)) (: 0x8001 u64))
    (assert-eq (v/vextract (v/vadd (v/vsplat [u8 16] 255) (v/vsplat [u8 16] 1)) 0)
               (: 0 u8))
    (assert (p/fcmp-eq (v/vextract (v/vmul (v/vsplat [f32 4] 2.0)
                                         (v/vsplat [f32 4] 3.0)) 3)
                      (: 6.0 f32)))
    0))
