; Misused coil.simd generics, all reported in one `coil check` pass. Each
; `reject-` function is one mistake; scripts/tests/simd.py counts the errors.
; (Misuses found later, in lowering, stop the compile at the first; simd.py
; checks those one per file.)
(module test.simd.diagnostics)
(import "coil.simd" :as v)
(import "coil.primitive" :as p)
(defn reject-width-kind [] (-> i64) (do (v/vsplat [u8 f32] 1) 0))
(defn reject-lane-kind [] (-> i64) (do (v/vsplat [(const 16) 4] 1) 0))
(defn reject-lane-wide [] (-> i64) (do (p/vector-zero [(vec i128 4)]) 0))
(defn reject-shape-mismatch [] (-> i64) (do (v/vadd (v/vzero [u8 4]) (v/vzero [u8 8])) 0))
(defn reject-convert-shape [] (-> i64) (do (p/vector-convert [(vec u16 8)] (v/vzero [u8 4])) 0))
(defn reject-masked-pointer [] (-> i64)
  (do (v/vload-masked (cast (ptr u16) 0) (v/mask-low [4] 0) (v/vzero [u8 4])) 0))
(defn reject-insert-type [] (-> i64) (do (v/vinsert (v/vzero [u8 4]) 0 (cast u16 1)) 0))
(defn main [] (-> i64) 0)
