(module test.simd-codegen)
(import "coil.simd" :as v)
(export-c [lookup16 :as "simd_lookup16"] [lookup32 :as "simd_lookup32"]
          [lookup64 :as "simd_lookup64"] [classify16 :as "simd_classify16"]
          [scan16 :as "simd_scan16"])

; Nonconstant inputs prevent the optimizer from replacing tests with constants.
; The focused SIMD gate inspects the emitted code for these functions.
(defn lookup16 :inline (Never) [(table (ptr u8)) (indices (ptr u8)) (out (ptr u8))] (-> i64)
  (v/vstoreu out (v/vtable (v/vloadu [u8 16] table) (v/vloadu [u8 16] indices))))

(defn lookup32 :inline (Never) [(table (ptr u8)) (indices (ptr u8)) (out (ptr u8))] (-> i64)
  (v/vstoreu out (v/vtable (v/vloadu [u8 32] table) (v/vloadu [u8 16] indices))))

(defn lookup64 :inline (Never) [(table (ptr u8)) (indices (ptr u8)) (out (ptr u8))] (-> i64)
  (v/vstoreu out (v/vtable (v/vloadu [u8 64] table) (v/vloadu [u8 16] indices))))

(defn classify16 :inline (Never) [(input (ptr u8))] (-> u64)
  (let [bytes (v/vloadu [u8 16] input)]
    (v/mask->bits (v/vand (v/v>= bytes (v/vsplat [u8 16] 48))
                          (v/v<= bytes (v/vsplat [u8 16] 57))))))

(defn scan16 :inline (Never) [(input (ptr u8)) (output (ptr u8))] (-> i64)
  (let [result (v/vscan-add (v/vloadu [u8 16] input) (cast u8 0))]
    (v/vstoreu output (.values result))))

(defn main [] (-> i64) 0)
