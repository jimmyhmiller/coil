;;; Loops whose bound lives in memory and whose body calls memcmp. The call
;;; writes nothing, so Stogir may read the bound once before the loop; a store
;;; in the body that can reach the bound must still be seen by the next
;;; iteration, and so must the writes of a Coil function that is merely called
;;; `memcmp`. The compared length is read from a mutable static, so every
;;; comparison stays a call of the C routine instead of being expanded inline
;;; as a compare of a known size. Exits with the number of failures.
(module tests.backend.stogir-readonly-library-calls)
(import "coil.primitive" :as primitive)
(import "coil.mem" :as mem)
(import "coil.var" :use [var-static])

(def WIDTH 4)

;;; WIDTH, where no caller can see its value.
(def compared (var-static i64 4))

(defn row [(rows (ptr u8)) (i i64)] (-> (ptr i8))
  (primitive/cast (ptr i8) (primitive/index rows (* i WIDTH))))

;;; Rows equal to KEY among the first `*limit`. Nothing in the loop writes.
(defn count-equal :inline (Never) [(limit (ptr i64)) (rows (ptr u8)) (key (ptr u8))]
  (-> i64)
  (let [(mut i) 0 (mut hits) 0 width (get compared)]
    (while (< i (load limit))
      (when (= (mem/memcmp (row rows i) (primitive/cast (ptr i8) key) width) 0)
        (set! hits (+ hits 1)))
      (set! i (+ i 1)))
    hits))

;;; As count-equal, but every hit takes one off `*budget`, which may be the
;;; limit itself.
(defn count-equal-spending :inline (Never)
  [(limit (ptr i64)) (budget (ptr i64)) (rows (ptr u8)) (key (ptr u8))] (-> i64)
  (let [(mut i) 0 (mut hits) 0 width (get compared)]
    (while (< i (load limit))
      (when (= (mem/memcmp (row rows i) (primitive/cast (ptr i8) key) width) 0)
        (store! budget (- (load budget) 1))
        (set! hits (+ hits 1)))
      (set! i (+ i 1)))
    hits))

;;; A Coil function that happens to share the C routine's name: it compares
;;; and, on equality, takes one off the cell behind its third argument.
(defn memcmp :inline (Never) [(left (ptr i8)) (right (ptr i8)) (budget (ptr i64))] (-> i32)
  (let [result (mem/memcmp left right (get compared))]
    (when (= result 0) (store! budget (- (load budget) 1)))
    result))

;;; As count-equal-spending with the store inside the namesake.
(defn count-equal-namesake :inline (Never)
  [(limit (ptr i64)) (budget (ptr i64)) (rows (ptr u8)) (key (ptr u8))] (-> i64)
  (let [(mut i) 0 (mut hits) 0]
    (while (< i (load limit))
      (when (= (memcmp (row rows i) (primitive/cast (ptr i8) key) budget) 0)
        (set! hits (+ hits 1)))
      (set! i (+ i 1)))
    hits))

;;; Small wrappers the module classifies by their bodies: the first only calls
;;; the C routine and so writes nothing; the second calls the namesake.
(defn same-row [(left (ptr i8)) (right (ptr i8))] (-> bool)
  (= (mem/memcmp left right (get compared)) 0))
(defn spend-row [(left (ptr i8)) (right (ptr i8)) (budget (ptr i64))] (-> bool)
  (= (memcmp left right budget) 0))

;;; memcmp reads memory: the same call after a store to its argument answers
;;; for the new bytes. 1 when equal before and different after.
(defn compare-around-store :inline (Never) [(cell (ptr u8)) (key (ptr u8))] (-> i64)
  (let [width (get compared)
        before (mem/memcmp (primitive/cast (ptr i8) cell) (primitive/cast (ptr i8) key) width)]
    (store! (primitive/index cell 3) (: 0x7f u8))
    (let [after (mem/memcmp (primitive/cast (ptr i8) cell) (primitive/cast (ptr i8) key) width)]
      (if (and (= before 0) (!= after 0)) 1 0))))

(defn expect [(what (slice u8)) (got i64) (wanted i64)] (-> i64)
  (if (= got wanted)
      0
      (do (println "{}: got {}, expected {}" what got wanted) 1)))

(defn main [] (-> i64)
  (let [; rows 1, 3, 4 and 6 hold the key
        (mut rows) (: [9 9 9 9  1 2 3 4  5 5 5 5  1 2 3 4
                       1 2 3 4  0 0 0 0  1 2 3 4  7 7 7 7] (array u8 32))
        (mut key) (: [1 2 3 4] (array u8 4))
        r (primitive/cast (ptr u8) (mut rows))
        k (primitive/cast (ptr u8) (mut key))
        (mut limit) 8
        (mut budget) 100
        (mut failures) 0]
    (set! failures (+ failures (expect "all rows" (count-equal (mut limit) r k) 4)))
    (set! limit 4)
    (set! failures (+ failures (expect "four rows" (count-equal (mut limit) r k) 2)))
    (set! limit 0)
    (set! failures (+ failures (expect "no rows" (count-equal (mut limit) r k) 0)))
    ; A separate budget: every row is visited.
    (set! limit 8)
    (set! failures (+ failures (expect "separate budget hits"
                                       (count-equal-spending (mut limit) (mut budget) r k) 4)))
    (set! failures (+ failures (expect "separate budget" budget 96)))
    (set! failures (+ failures (expect "separate budget limit" limit 8)))
    ; The budget is the limit: hits at rows 1, 3 and 4 leave 5 rows, and row 5
    ; is not reached.
    (set! failures (+ failures (expect "shared budget hits"
                                       (count-equal-spending (mut limit) (mut limit) r k) 3)))
    (set! failures (+ failures (expect "shared budget limit" limit 5)))
    ; The same two through the namesake.
    (set! limit 8)
    (set! budget 100)
    (set! failures (+ failures (expect "namesake separate hits"
                                       (count-equal-namesake (mut limit) (mut budget) r k) 4)))
    (set! failures (+ failures (expect "namesake separate budget" budget 96)))
    (set! failures (+ failures (expect "namesake shared hits"
                                       (count-equal-namesake (mut limit) (mut limit) r k) 3)))
    (set! failures (+ failures (expect "namesake shared limit" limit 5)))
    (set! failures (+ failures (expect "compare around a store"
                                       (compare-around-store (primitive/index r 4) k) 1)))
    (set! budget 100)
    (set! failures (+ failures (expect "wrapper equal" (if (same-row (row r 3) (row r 4)) 1 0) 1)))
    (set! failures (+ failures (expect "wrapper different" (if (same-row (row r 3) (row r 2)) 1 0) 0)))
    (set! failures (+ failures (expect "spending wrapper"
                                       (if (spend-row (row r 3) (row r 4) (mut budget)) 1 0) 1)))
    (set! failures (+ failures (expect "spending wrapper budget" budget 99)))
    (println "read-only library calls: {} failures" failures)
    failures))
