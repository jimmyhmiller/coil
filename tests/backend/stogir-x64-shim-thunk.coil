;;; The x86-64 SHIMCALL thunk (codegen_stogir shim-code-x64), run directly: the
;;; thunk's bytes are generated for a CIR SHIMCALL, mapped executable and
;;; called as the C function they are, through a probe that loads known values
;;; into rbx, rbp and r12..r15 first and checks them afterwards. Covered:
;;; pinned registers outside the C argument registers, the C argument
;;; registers in another order (the assignment is a parallel move), preserved
;;; registers as arguments, result and clobbers, eight arguments (two arrive
;;; on the stack), a called symbol whose convention pins r11 and r10, and
;;; 16-byte stack alignment where the convention's code runs (a `movaps` to
;;; the stack in every body).
;;;
;;; The probe, called as probe(function, arguments) with eight argument words:
;;;   push rbx, rbp, r12..r15 ; sub rsp, 8 ; mov rax, rdi ; mov r10, rsi
;;;   push [r10+56] ; push [r10+48] ; rdi, rsi, rdx, rcx, r8, r9 = [r10+0..40]
;;;   rbx, rbp, r12..r15 = 0x11, 0x22, 0x33, 0x44, 0x55, 0x66 ; call rax
;;;   compare the six registers (a change returns -99999)
;;;   add rsp, 24 ; pops ; ret
;;;
;;; x86-64 only; prints "skipped" elsewhere. Exits with the number of failures.
(module coil.compiler.stogir-x64-shim-thunk)
(import "coil.compiler.codegen_stogir" :as backend)
(import "tpde.cir" :as cir)
(import "stogir.target" :as machine)
(import "stogir.jit.native" :as jit)
(import "coil.primitive" :as p)
(import "coil.alloc" :use [Allocator malloc-allocator])
(import "coil.arraylist" :use [ArrayList])
(import "coil.result" :use [Ok Err])
(import "coil.cc" :as cc)

(defn mapped [(text (slice u8))] (-> (ptr u8))
  (match (jit/map-text text)
    (Err [message] (panic "cannot map text: {}" message))
    (Ok [image] (.base image))))

(defn probe [] (-> (fnptr (cc/C) [(ptr u8) (ptr i64)] i64))
  (p/cast (fnptr (cc/C) [(ptr u8) (ptr i64)] i64)
          (mapped [(: 0x53 u8) 0x55 0x41 0x54 0x41 0x55 0x41 0x56 0x41 0x57 0x48 0x83
                   0xec 0x08 0x48 0x89 0xf8 0x49 0x89 0xf2 0x41 0xff 0x72 0x38
                   0x41 0xff 0x72 0x30 0x49 0x8b 0x3a 0x49 0x8b 0x72 0x08 0x49
                   0x8b 0x52 0x10 0x49 0x8b 0x4a 0x18 0x4d 0x8b 0x42 0x20 0x4d
                   0x8b 0x4a 0x28 0xbb 0x11 0x00 0x00 0x00 0xbd 0x22 0x00 0x00
                   0x00 0x41 0xbc 0x33 0x00 0x00 0x00 0x41 0xbd 0x44 0x00 0x00
                   0x00 0x41 0xbe 0x55 0x00 0x00 0x00 0x41 0xbf 0x66 0x00 0x00
                   0x00 0xff 0xd0 0x48 0x83 0xfb 0x11 0x75 0x2d 0x48 0x83 0xfd
                   0x22 0x75 0x27 0x49 0x83 0xfc 0x33 0x75 0x21 0x49 0x83 0xfd
                   0x44 0x75 0x1b 0x49 0x83 0xfe 0x55 0x75 0x15 0x49 0x83 0xff
                   0x66 0x75 0x0f 0x48 0x83 0xc4 0x18 0x41 0x5f 0x41 0x5e 0x41
                   0x5d 0x41 0x5c 0x5d 0x5b 0xc3 0x48 0xc7 0xc0 0x61 0x79 0xfe
                   0xff 0xeb 0xe8])))

;;; The mapped thunk of a SHIMCALL with argument registers REGISTERS, result
;;; register RESULT and clobber mask CLOBBER, holding BYTES inline, or calling
;;; a symbol when CALLED (its address is then the thunk's last argument).
(defn thunk [(registers (slice u32)) (result u32) (clobber u64) (bytes (slice u8))
             (called bool)] (-> (ptr u8))
  (let [a (malloc-allocator)
        (mut func) (cir/Func::new)
        fp (p/cast (ptr cir/Func) (mut func))
        (mut arguments) (ArrayList::new [u32] a)
        (mut pinned) (ArrayList::new [u32] a)]
    (set! (.name func) "shim.caller")
    (cir/set-block! fp (cir/new-block! fp))
    (for r registers
      (push! (mut arguments) (cir/arg! fp cir/T-I64 false))
      (push! (mut pinned) r))
    (let [target (if called (: 0 u32) (cir/none))
          call (cir/shimcall! fp target
                              (p/cast (ptr (ArrayList u32)) (mut arguments))
                              (p/cast (ptr (ArrayList u32)) (mut pinned))
                              result clobber bytes cir/T-I64)
          (mut code) (backend/shim-code-x64 fp (cir/val fp call) a)
          base (mapped (slice code))]
      (free! (mut code))
      (free! (mut arguments))
      (free! (mut pinned))
      base)))

(defn expect [(what (slice u8)) (run (fnptr (cc/C) [(ptr u8) (ptr i64)] i64))
              (function (ptr u8)) (arguments (array i64 8)) (want i64)] (-> i64)
  (let [(mut words) arguments
        got (call-ptr run function (p/cast (ptr i64) (mut words)))]
    (if (= got want)
        0
        (do (println "FAILED: {}: got {}, want {}" what got want) 1))))

(defn mask [(registers (slice u32))] (-> u64)
  (let [(mut bits) (: 0 u64)]
    (for r registers (set! bits (| bits (<< (: 1 u64) (cast u64 r)))))
    bits))

(defn run [] (-> i64)
  (let [check (probe)
        ; movaps [rsp-16], xmm0 ; lea r13, [r12+rbx*2] ; zero r12, rbx, r14
        outside (thunk [(: 12 u32) 3] 13 (mask [(: 12 u32) 3 13 14])
                       [(: 0x0f u8) 0x29 0x44 0x24 0xf0 0x4d 0x8d 0x2c 0x5c
                        0x45 0x31 0xe4 0x31 0xdb 0x45 0x31 0xf6]
                       false)
        ; movaps [rsp-16], xmm0 ; mov rax, rsi ; sub rax, rdi
        swapped (thunk [(: 6 u32) 7] 0 (mask [(: 0 u32) 6 7])
                       [(: 0x0f u8) 0x29 0x44 0x24 0xf0 0x48 0x89 0xf0 0x48 0x29 0xf8]
                       false)
        ; movaps [rsp-16], xmm0 ; r9 = rax + 2 rcx + 3 rdx + 4 rbx + 5 rbp + 6 rsi
        ; + 7 rdi + 8 r8 ; zero rbx, rbp
        eight (thunk [(: 0 u32) 1 2 3 5 6 7 8] 9 (mask [(: 0 u32) 1 2 3 5 6 7 8 9])
                     [(: 0x0f u8) 0x29 0x44 0x24 0xf0
                      0x4c 0x8d 0x0c 0x48 0x48 0x8d 0x14 0x52 0x49 0x01 0xd1
                      0x4d 0x8d 0x0c 0x99 0x48 0x8d 0x6c 0xad 0x00 0x49 0x01 0xe9
                      0x48 0x6b 0xf6 0x06 0x49 0x01 0xf1 0x48 0x6b 0xff 0x07
                      0x49 0x01 0xf9 0x4f 0x8d 0x0c 0xc1 0x31 0xdb 0x31 0xed]
                     false)
        ; the called symbol: movaps [rsp-8], xmm0 ; lea rdx, [r11+r10*4] ; ret
        callee (mapped [(: 0x0f u8) 0x29 0x44 0x24 0xf8 0x4b 0x8d 0x14 0x93 0xc3])
        called (thunk [(: 11 u32) 10] 2 (mask [(: 2 u32) 10 11]) "" true)
        failures
          (+ (expect "outside the argument registers" check outside [50 8 0 0 0 0 0 0] 66)
             (expect "outside, again" check outside [-3 1000 0 0 0 0 0 0] 1997)
             (expect "argument registers swapped" check swapped [50 8 0 0 0 0 0 0] 42)
             (expect "argument registers swapped back" check swapped [8 50 0 0 0 0 0 0] -42)
             (expect "eight arguments" check eight [1 10 100 1000 10000 100000 1000000 10000000]
                     87654321)
             (expect "a called symbol" check called
                     [7 100 (p/cast i64 callee) 0 0 0 0 0] 407))]
    (println "stogir x64 shim thunk: {} failures" failures)
    failures))

(defn main [] (-> i64)
  (machine/arch-pick (do (println "stogir x64 shim thunk: skipped (not x86-64)") 0)
                     (run)))
