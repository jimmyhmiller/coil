;;; Addresses of named symbols as values: static tables defined in this
;;; program and a C library function. Stogir reaches each through a GOT-load
;;; relocation pair; the linker turns the pair into ADRP/ADD for the tables
;;; and keeps a GOT entry for the library function. Exits with the number of
;;; failures.
(module tests.backend.stogir-symbol-addresses)
(import "coil.cc" :as cc)
(import "coil.primitive" :as primitive)

(extern strlen :cc (cc/C) [(ptr i8)] (-> u64))

(def WEIGHTS (: [3 1 4 1 5 9 2 6] (array i64 8)))
(def NAMES (: [10 20 30 40] (array i64 4)))

;;; Sum of WEIGHTS[i & 7] for i below COUNT: the table's address is needed in
;;; a loop.
(defn weigh :inline (Never) [(count i64)] (-> i64)
  (let [(mut i) 0 (mut total) 0]
    (while (< i count)
      (set! total (+ total (get WEIGHTS (& i 7))))
      (set! i (+ i 1)))
    total))

;;; Two tables in one function, each addressed more than once.
(defn mix :inline (Never) [(i i64)] (-> i64)
  (+ (* (get WEIGHTS (& i 7)) (get NAMES (& i 3)))
     (get WEIGHTS (& (+ i 1) 7))
     (get NAMES (& (+ i 1) 3))))

;;; A C library function called through its address.
(defn measure :inline (Never) [(f (fnptr (cc/C) [(ptr i8)] u64)) (text (ptr i8))] (-> i64)
  (primitive/cast i64 (f text)))

(defn expect [(what (slice u8)) (got i64) (wanted i64)] (-> i64)
  (if (= got wanted)
      0
      (do (println "{}: got {}, expected {}" what got wanted) 1)))

(defn main [] (-> i64)
  (+ (expect "weigh 0" (weigh 0) 0)
     (expect "weigh 8" (weigh 8) 31)
     (expect "weigh 11" (weigh 11) 39)
     (expect "mix 0" (mix 0) (+ 30 1 20))
     (expect "mix 3" (mix 3) (+ 40 5 10))
     (expect "mix 7" (mix 7) (+ 240 3 10))
     (expect "measure" (measure (fnptr-of strlen) c"seven..") 7)))
