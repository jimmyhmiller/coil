;;; A value returned as one word of a two-register aggregate that is also used
;;; on only one path through the function. The RETURN reads the word on every
;;; path, so it must be computed where both the use and the RETURN can see it.
;;; Exits with the number of failures.
(module tests.backend.stogir-return-piece-placement)
(import "coil.primitive" :as primitive)

(defstruct Pair [(a i64) (b i64)])

(defn add-into :inline (Never) [(cell (ptr i64)) (x i64)] (-> void)
  (store! cell (+ (load cell) x)))

;;; `q` is passed to a call when c > 0 and returned always.
(defn low-on-one-path :inline (Never) [(cell (ptr i64)) (x i64) (c i64)] (-> Pair)
  (let [q (+ x 5)]
    (when (> c 0) (add-into cell q))
    (Pair :a q :b c)))

;;; The same for the second word, used when c <= 0.
(defn high-on-one-path :inline (Never) [(cell (ptr i64)) (x i64) (c i64)] (-> Pair)
  (let [q (* x 3)]
    (when (<= c 0) (add-into cell q))
    (Pair :a c :b q)))

;;; With --debug-checks slice::new tests its pointer only when the length is
;;; positive; an empty slice still carries the pointer.
(defn make :inline (Never) [(p (ptr u8)) (n i64)] (-> (slice u8))
  (slice::new p n))

;;; Leaves other values in the registers a lost word would be read from.
(defn scramble :inline (Never) [(a i64) (b i64) (c i64)] (-> i64)
  (+ (* a 3) (* b 5) (* c 7)))

(defn expect [(what (slice u8)) (got i64) (wanted i64)] (-> i64)
  (if (= got wanted)
      0
      (do (println "{}: got {}, expected {}" what got wanted) 1)))

(defn main [] (-> i64)
  (let [(mut failures) 0
        (mut seen) (: 0 i64)
        (mut byte) (: 7 u8)
        p (primitive/cast (ptr u8) (mut byte))]
    (let [junk (scramble 11 13 17)
          skipped (low-on-one-path (mut seen) 10 0)
          taken (low-on-one-path (mut seen) 20 1)]
      (set! failures (+ failures (expect "low word, call skipped" (.a skipped) 15)))
      (set! failures (+ failures (expect "low word, other word" (.b skipped) 0)))
      (set! failures (+ failures (expect "low word, call taken" (.a taken) 25)))
      (set! failures (+ failures (expect "low word, call effect" seen 25)))
      (set! failures (+ failures (expect "scramble" junk 217))))
    (set! seen 0)
    (let [junk (scramble 1 2 3)
          skipped (high-on-one-path (mut seen) -7 1)
          taken (high-on-one-path (mut seen) 9 0)]
      (set! failures (+ failures (expect "high word, call skipped" (.b skipped) -21)))
      (set! failures (+ failures (expect "high word, other word" (.a skipped) 1)))
      (set! failures (+ failures (expect "high word, call taken" (.b taken) 27)))
      (set! failures (+ failures (expect "high word, call effect" seen 27)))
      (set! failures (+ failures (expect "scramble" junk 34))))
    (let [junk (scramble 5 6 7)
          empty (make p 0)
          one (make p 1)]
      (set! failures (+ failures (expect "empty slice pointer"
                                         (primitive/cast i64 (primitive/cast u64 (data empty)))
                                         (primitive/cast i64 (primitive/cast u64 p)))))
      (set! failures (+ failures (expect "empty slice length" (len empty) 0)))
      (set! failures (+ failures (expect "one-element slice pointer"
                                         (primitive/cast i64 (primitive/cast u64 (data one)))
                                         (primitive/cast i64 (primitive/cast u64 p)))))
      (set! failures (+ failures (expect "one-element slice length" (len one) 1)))
      (set! failures (+ failures (expect "scramble" junk 94))))
    (println "return pieces used on one path: {} failures" failures)
    failures))
