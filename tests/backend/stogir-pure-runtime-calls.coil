;;; Hosted C routines that only read their arguments reach Stogir with
;;; PURE_FUNC, as LLVM's library-call knowledge has them; others do not. The
;;; routine is known by the object name of an undefined symbol (the C name
;;; behind `_`, as codegen_tpde's tl-sym records it) and its argument count.
(module coil.compiler.stogir-pure-runtime-calls)
(import "coil.compiler.codegen_stogir" :as backend)
(import "coil.compiler.macho" :use [MTextData])
(import "tpde.cir" :as cir)
(import "tpde.asm" :as asm)
(import "stogir.graph" :as graph)
(import "stogir.node" :as node)
(import "stogir.calls" :as calls)
(import "coil.primitive" :as p)
(import "coil.alloc" :use [malloc-allocator])
(import "coil.arraylist" :use [ArrayList])
(import "coil.result" :use [Ok Err])

;;; Adapt one function calling SYMBOL with ARGUMENTS arguments and report the
;;; CALL's PURE flag.
(defn pure-flag [(ta (ptr asm/Asm)) (symbol u32) (arguments i64)] (-> i32)
  (let [a (malloc-allocator)
        (mut func) (cir/Func::new)
        fp (p/cast (ptr cir/Func) (mut func))
        (mut args) (ArrayList::new [u32] a)
        (mut flags) (ArrayList::new [u32] a)
        (mut types) (ArrayList::new [u8] a)
        (mut found) (: -1 i32)]
    (set! (.name func) "pure.caller")
    (cir/set-block! fp (cir/new-block! fp))
    (let [x (cir/arg! fp cir/T-I64 false)
          eight (cir/iconst! fp 8)]
      (for [i 0 arguments]
        (push! (mut args) (if (= i 2) eight x))
        (push! (mut flags) 0))
      (push! (mut types) (cast u8 cir/T-I64))
      (let [call (cir/call! fp symbol (cir/none)
                            (p/cast (ptr (ArrayList u32)) (mut args))
                            (p/cast (ptr (ArrayList u32)) (mut flags))
                            (p/cast (ptr (ArrayList u8)) (mut types)) false)]
        (cir/ret1! fp call)))
    (cir/finish! fp)
    (let [(mut state) (zeroed backend/Adapter)
          s (p/cast (ptr backend/Adapter) (mut state))]
      (backend/adapt! s fp ta (p/cast (ptr (ArrayList MTextData)) 0) a)
      (let [g (.g s) (mut r) (: 1 i64)]
        (while (< r (len (.instructions g)))
          (let [n (get (.instructions g) r) count (get (.arities g) r)]
            (when (= (node/opcode n) 79)
              (match (calls/signature g (.op2 n) (node/type-id n) (- count 2))
                (Err [message] (println "symbol {}: {}" symbol message))
                (Ok [signature]
                    (set! found (if (= (& (.flags signature) (: 64 u8)) 0) 0 1)))))
            (set! r (+ r (/ (+ (cast i64 count) 4) 4)))))))
    (cir/func-free! fp)
    (free! (mut args)) (free! (mut flags)) (free! (mut types))
    found))

;;; 1 unless a call of undefined symbol NAME with ARGUMENTS arguments has PURE
;;; flag WANTED.
(defn wrong [(ta (ptr asm/Asm)) (name (slice u8)) (arguments i64) (wanted i32)] (-> i64)
  (if (= (pure-flag ta (asm/sym-add-undef! ta name (: 1 u8)) arguments) wanted)
      0
      (do (println "{} with {} arguments: PURE is not {}" name arguments wanted) 1)))

(defn main [] (-> i64)
  (let [(mut assembler) (asm/Asm::new)
        ta (p/cast (ptr asm/Asm) (mut assembler))
        (mut failures)
          (+ (wrong ta "_memcmp" 3 1) (wrong ta "_bcmp" 3 1) (wrong ta "_memchr" 3 1)
             (wrong ta "_strncmp" 3 1) (wrong ta "_strcmp" 2 1) (wrong ta "_strlen" 1 1)
             ; Other routines.
             (wrong ta "_memmove" 3 0) (wrong ta "_memcpy" 3 0) (wrong ta "_free" 1 0)
             (wrong ta "_write" 3 0) (wrong ta "_printf" 1 0)
             ; The names without the object prefix, with another one, or longer
             ; or shorter by a byte.
             (wrong ta "memcmp" 3 0) (wrong ta "strlen" 1 0) (wrong ta "__memcmp" 3 0)
             (wrong ta "xmemcmp" 3 0) (wrong ta "_" 1 0) (wrong ta "" 1 0)
             (wrong ta "_memcmp_l" 3 0) (wrong ta "_memcm" 3 0)
             ; The right name called with another argument count.
             (wrong ta "_memcmp" 2 0) (wrong ta "_memcmp" 4 0) (wrong ta "_strlen" 2 0)
             (wrong ta "_strlen" 0 0) (wrong ta "_strcmp" 3 0))]
    ; A symbol the program defines is never the library's, whatever it is
    ; called: tl-sym leaves those anonymous, and a named one is refused too.
    (for name ["" "_memcmp"]
      (unless (= (pure-flag ta (asm/sym-add-def! ta name -2 0 0 (: 1 u8)) 3) 0)
        (println "defined symbol '{}' call is PURE" name) (set! failures (+ failures 1))))
    (asm/asm-free! ta)
    (println "hosted pure runtime calls: {} failures" failures)
    (if (= failures 0) 0 1)))
