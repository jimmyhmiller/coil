;;; Structural ownership and debug-mark checks for aggregate snapshot fusion.
(module tests.backend.cir-aggregate-ownership)
(import "tpde.cir" :as cir)
(import "coil.primitive" :as p)

(defn check-case [(mode i64)] (-> i64)
  (let [(mut function) (cir/Func::new)
        f (p/cast (ptr cir/Func) (mut function))
        (mut failures) 0]
    (cir/set-block! f (cir/new-block! f))
    (let [destination (cir/arg! f cir/T-I64 false)
          source (cir/arg! f cir/T-I64 false)
          temporary (cir/alloca! f (if (= mode 4) 129 128) 16)
          mark (cir/dbg-mark! f)]
      (if (= mode 1)
          (cir/op1! f cir/OP-MEMZERO cir/T-VOID temporary 128 0)
          (cir/op2! f cir/OP-MEMCPY cir/T-VOID temporary source 128 0))
      (when (= mode 5) (cir/store-mem! f destination (cir/iconst! f 7) 0 8))
      (when (= mode 6)
        (let [next (cir/new-block! f)]
          (cir/br! f next)
          (cir/set-block! f next)))
      (let [copy (cir/op2! f cir/OP-MEMCPY cir/T-VOID destination temporary
                            (if (= mode 3) 127 128) 0)]
        (cond (= mode 2) (cir/ret1! f (cir/load-mem! f cir/T-I64 temporary 0 8 false))
              (= mode 7) (cir/ret1! f temporary)
              :else (cir/ret0! f))
        (cir/finish! f)
        (let [fused (< mode 2)
              expected (if fused (if (= mode 1) cir/OP-MEMSETV cir/OP-MEMMOVEV)
                                cir/OP-MEMCPY)]
          (unless (= (cast i64 (.op (cir/val f copy))) expected)
            (set! failures (+ failures 1)))
          (unless (= (len (.allocas function)) (if fused 0 1))
            (set! failures (+ failures 1)))
          (when (and fused (!= (get (.mark-insts function) (cast i64 mark)) copy))
            (set! failures (+ failures 1)))
          (when fused
            (let [value (cir/val f copy)
                  count (cir/val f (cir/operand f value 2))]
              (unless (and (= (.imm count) 128)
                           (= (cir/operand f value 0) destination))
                (set! failures (+ failures 1))))))))
    (cir/func-free! f)
    (when (> failures 0) (println "snapshot mode {}: {} failures" mode failures))
    failures))

(defn main [] (-> i64)
  (let [(mut failures) 0]
    (for [mode 0 8] (set! failures (+ failures (check-case mode))))
    (println "CIR aggregate ownership: {} failures" failures)
    (if (= failures 0) 0 1)))
