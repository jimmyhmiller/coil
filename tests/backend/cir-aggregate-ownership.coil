;;; Structural ownership and debug-mark checks for aggregate snapshot fusion.
(module tests.backend.cir-aggregate-ownership)
(import "native.cir" :as cir)
(import "native.cir-ops" :as cop)
(import "coil.primitive" :as p)

(defn check-case [(mode i64)] (-> i64)
  (let [(mut function) (cir/Func::new)
        f (p/cast (ptr cir/Func) (mut function))
        (mut failures) 0]
    (cir/set-block! f (cir/new-block! f))
    (let [destination (cir/arg! f cop/T-I64 false)
          source (cir/arg! f cop/T-I64 false)
          temporary (cir/alloca! f (if (= mode 4) 129 128) 16)
          mark (cir/dbg-mark! f)]
      (if (= mode 1)
          (cir/op1! f cop/OP-MEMZERO cop/T-VOID temporary 128 0)
          (cir/op2! f cop/OP-MEMCPY cop/T-VOID temporary source 128 0))
      (when (= mode 5) (cir/store-mem! f destination (cir/iconst! f 7) 0 8))
      (when (= mode 6)
        (let [next (cir/new-block! f)]
          (cir/br! f next)
          (cir/set-block! f next)))
      (let [copy
              (cir/op2! f
                        cop/OP-MEMCPY
                        cop/T-VOID
                        destination
                        temporary
                        (if (= mode 3) 127 128)
                        0)]
        (cond (= mode 2)
                (cir/ret1! f (cir/load-mem! f cop/T-I64 temporary 0 8 false))
              (= mode 7) (cir/ret1! f temporary)
              :else (cir/ret0! f))
        (cir/finish! f)
        (cir/fuse-snapshots! f)
        (let [fused (< mode 2)
              expected
                (if fused
                    (if (= mode 1) cop/OP-MEMSETV cop/OP-MEMMOVEV)
                    cop/OP-MEMCPY)]
          (unless (= (cast i64 (.op (cir/val f copy))) expected)
            (set! failures (+ failures 1)))
          (unless (= (len (.allocas function)) (if fused 0 1))
            (set! failures (+ failures 1)))
          (when (and fused
                     (!= (get (.mark-insts function) (cast i64 mark)) copy))
            (set! failures (+ failures 1)))
          (when fused
            (let [value (cir/val f copy)
                  count (cir/val f (cir/operand f value 2))]
              (unless (and (= (.imm count) 128)
                           (= (cir/operand f value 0) destination))
                (set! failures (+ failures 1))))))))
    (cir/func-free! f)
    (when (> failures 0)
      (println "snapshot mode {}: {} failures" mode failures))
    failures))

;;; Frame addresses, read off the operations' meanings (cir.ops): a widening
;;; or an XOR of a stack address may still be one, so storing it lets the
;;; frame escape; a comparison with one, or a select on one, is not.
(defn frame-case [(mode i64)] (-> i64)
  (let [(mut function) (cir/Func::new)
        f (p/cast (ptr cir/Func) (mut function))]
    (cir/set-block! f (cir/new-block! f))
    (let [out (cir/arg! f cop/T-I64 false)
          slot (cir/alloca! f 16 8)
          value (cond (= mode 0) (cir/op1! f cop/OP-ZEXT cop/T-I64 slot 48 0)
                      (= mode 1) (cir/op2! f cop/OP-XOR cop/T-I64 slot (cir/iconst! f 1) 0 0)
                      (= mode 2) (cir/op2! f cop/OP-ICMP cop/T-I64 slot out 0 0)
                      :else (cir/op3! f cop/OP-SELECT cop/T-I64 slot out out 0 0))
          expected (< mode 2)]
      (cir/store-mem! f out value 0 8)
      (cir/ret0! f)
      (let [derived (cir/frame-derived? f value)
            escapes (.frame-escapes f)
            failures (if (and (= derived expected) (= escapes expected))
                         0
                         (do (println "frame {}: derived {} escapes {} (want {})" mode derived escapes expected) 1))]
        (cir/func-free! f)
        failures))))

(defn main [] (-> i64)
  (let [(mut failures) 0]
    (for [mode 0 8] (set! failures (+ failures (check-case mode))))
    (for [mode 0 4] (set! failures (+ failures (frame-case mode))))
    (println "CIR aggregate ownership: {} failures" failures)
    (if (= failures 0) 0 1)))
