;;; Calls under :shim conventions through the Stogir backend, which reaches
;;; each convention through a thunk (codegen_stogir shim-thunk!): arguments
;;; pinned to registers the C convention would not use, to C argument
;;; registers in another order (the thunk's assignment is a parallel move), to
;;; preserved registers the bytes then destroy, seven arguments beside a called
;;; symbol, no result, and the same convention called from several functions.
;;; Each form is both called and held inline. AArch64 bytes only.
;;;
;;; Prints every result and exits with the number of failed checks.
(module tests.backend.stogir-shim-calls)
(import "coil.primitive" :as primitive)
(import "coil.var" :use [Var var-static])
(import "coil.cc" :as cc)

(def failures (var-static i64 0))

(defn check-eq [(what (slice u8)) (got i64) (want i64)] (-> void)
  (unless (= got want)
    (set failures (+ (get failures) 1))
    (println "FAILED: {}: got {}, want {}" what got want)))

;;; A value the compiler cannot fold, so arguments are really in registers.
(defn opaque :inline (Never) [(x i64)] (-> i64)
  (+ x (get failures)))

;; ---------------------------------------------------------------------------
;; Registers outside the C argument registers

(defcc scratch :params [x9 x10] :ret x9 :clobber [x9 x10] :lower (cc/Shim))

;; sub x9, x9, x10
(defn sub2 :cc scratch [(a i64) (b i64)] (-> i64)
  (primitive/machine-code (Aarch64) 0x29 0x01 0x0a 0xcb))

(defn sub2-inline :cc scratch :inline (Always) [(a i64) (b i64)] (-> i64)
  (primitive/machine-code (Aarch64) 0x29 0x01 0x0a 0xcb))

(defn section-scratch [] (-> void)
  (let [x (opaque 50)
        y (opaque 8)]
    (println "scratch: {} {}" (sub2 x y) (sub2-inline x y))
    (check-eq "sub2 50 8" (sub2 x y) 42)
    (check-eq "inline sub2 50 8" (sub2-inline x y) 42)
    (check-eq "sub2 8 50" (sub2 y x) -42)))

;;; The same convention and bytes from a second function: one thunk serves both.
(defn section-shared [] (-> void)
  (let [x (opaque 7)
        y (opaque 100)]
    (println "shared: {} {}" (sub2 y x) (sub2-inline y x))
    (check-eq "sub2 100 7" (sub2 y x) 93)
    (check-eq "inline sub2 100 7" (sub2-inline y x) 93)))

;; ---------------------------------------------------------------------------
;; The C argument registers in another order: every source is also a target

(defcc swapped :params [x1 x0] :ret x0 :clobber [x0 x1] :lower (cc/Shim))

;; sub x0, x1, x0 (first - second)
(defn sub-swapped :cc swapped [(a i64) (b i64)] (-> i64)
  (primitive/machine-code (Aarch64) 0x20 0x00 0x00 0xcb))

(defn sub-swapped-inline :cc swapped :inline (Always) [(a i64) (b i64)] (-> i64)
  (primitive/machine-code (Aarch64) 0x20 0x00 0x00 0xcb))

(defcc rotated :params [x2 x0 x1] :ret x0 :clobber [x0 x1 x2] :lower (cc/Shim))

;; sub x0, x2, x0; add x0, x0, x1, lsl #1 (first - second + 2 * third)
(defn mix3 :cc rotated [(a i64) (b i64) (c i64)] (-> i64)
  (primitive/machine-code (Aarch64) 0x40 0x00 0x00 0xcb 0x00 0x04 0x01 0x8b))

(defn mix3-inline :cc rotated :inline (Always) [(a i64) (b i64) (c i64)] (-> i64)
  (primitive/machine-code (Aarch64) 0x40 0x00 0x00 0xcb 0x00 0x04 0x01 0x8b))

(defn section-permuted [] (-> void)
  (let [x (opaque 50)
        y (opaque 8)
        z (opaque 1000)]
    (println "permuted: {} {} {} {}"
             (sub-swapped x y)
             (sub-swapped-inline x y)
             (mix3 x y z)
             (mix3-inline x y z))
    (check-eq "swapped 50 8" (sub-swapped x y) 42)
    (check-eq "inline swapped 50 8" (sub-swapped-inline x y) 42)
    (check-eq "rotated 50 8 1000" (mix3 x y z) 2042)
    (check-eq "inline rotated 50 8 1000" (mix3-inline x y z) 2042)))

;; ---------------------------------------------------------------------------
;; Preserved registers as arguments, result and clobbers: the caller's own
;; values in those registers survive

(defcc preserved
       :params [x19 x20]
       :ret x21
       :clobber [x19 x20 x21 x22 x23 x24 x25 x26 x27 x28]
       :lower (cc/Shim))

;; add x21, x19, x20; then zero x19, x20 and x22..x28
(defn add-wreck :cc preserved [(a i64) (b i64)] (-> i64)
  (primitive/machine-code (Aarch64)
                          0x75 0x02 0x14 0x8b 0xf3 0x03 0x1f 0xaa 0xf4 0x03 0x1f 0xaa
                          0xf6 0x03 0x1f 0xaa 0xf7 0x03 0x1f 0xaa 0xf8 0x03 0x1f 0xaa
                          0xf9 0x03 0x1f 0xaa 0xfa 0x03 0x1f 0xaa 0xfb 0x03 0x1f 0xaa
                          0xfc 0x03 0x1f 0xaa))

(defn add-wreck-inline :cc preserved :inline (Always) [(a i64) (b i64)] (-> i64)
  (primitive/machine-code (Aarch64)
                          0x75 0x02 0x14 0x8b 0xf3 0x03 0x1f 0xaa 0xf4 0x03 0x1f 0xaa
                          0xf6 0x03 0x1f 0xaa 0xf7 0x03 0x1f 0xaa 0xf8 0x03 0x1f 0xaa
                          0xf9 0x03 0x1f 0xaa 0xfa 0x03 0x1f 0xaa 0xfb 0x03 0x1f 0xaa
                          0xfc 0x03 0x1f 0xaa))

(defn section-preserved [] (-> void)
  ; ten values live across every call below
  (let [a (opaque 1) b (opaque 2) c (opaque 3) d (opaque 4) e (opaque 5)
        f (opaque 6) g (opaque 7) h (opaque 8) i (opaque 9) j (opaque 10)
        called (add-wreck a b)
        inlined (add-wreck-inline c d)
        again (add-wreck called inlined)
        sum (+ a b c d e f g h i j)]
    (println "preserved: {} {} {} {}" called inlined again sum)
    (check-eq "add-wreck 1 2" called 3)
    (check-eq "inline add-wreck 3 4" inlined 7)
    (check-eq "add-wreck 3 7" again 10)
    (check-eq "the caller's values after the calls" sum 55)))

;; ---------------------------------------------------------------------------
;; Seven arguments, the most a called symbol leaves room for

(defcc seven
       :params [x9 x10 x11 x12 x13 x14 x15]
       :ret x9
       :clobber [x9]
       :lower (cc/Shim))

;; x9 += x10 + 2*x11 + 4*x12 + 8*x13 + 16*x14 + 32*x15
(defn weigh :cc seven [(a i64) (b i64) (c i64) (d i64) (e i64) (f i64) (g i64)] (-> i64)
  (primitive/machine-code (Aarch64)
                          0x29 0x01 0x0a 0x8b 0x29 0x05 0x0b 0x8b 0x29 0x09 0x0c 0x8b
                          0x29 0x0d 0x0d 0x8b 0x29 0x11 0x0e 0x8b 0x29 0x15 0x0f 0x8b))

(defn weigh-inline :cc seven :inline (Always)
  [(a i64) (b i64) (c i64) (d i64) (e i64) (f i64) (g i64)] (-> i64)
  (primitive/machine-code (Aarch64)
                          0x29 0x01 0x0a 0x8b 0x29 0x05 0x0b 0x8b 0x29 0x09 0x0c 0x8b
                          0x29 0x0d 0x0d 0x8b 0x29 0x11 0x0e 0x8b 0x29 0x15 0x0f 0x8b))

(defn section-seven [] (-> void)
  (let [a (opaque 1) b (opaque 2) c (opaque 3) d (opaque 4)
        e (opaque 5) f (opaque 6) g (opaque 7)
        want (+ 1 2 (* 2 3) (* 4 4) (* 8 5) (* 16 6) (* 32 7))]
    (println "seven: {} {}" (weigh a b c d e f g) (weigh-inline a b c d e f g))
    (check-eq "weigh" (weigh a b c d e f g) want)
    (check-eq "inline weigh" (weigh-inline a b c d e f g) want)
    (check-eq "weigh reversed" (weigh g f e d c b a)
              (+ 7 6 (* 2 5) (* 4 4) (* 8 3) (* 16 2) (* 32 1)))))

;; ---------------------------------------------------------------------------
;; No result: the bytes store through a pinned pointer

(defcc storing :params [x9 x10] :clobber [] :lower (cc/Shim))

;; str x10, [x9]
(defn put! :cc storing [(place (ptr i64)) (value i64)] (-> void)
  (primitive/machine-code (Aarch64) 0x2a 0x01 0x00 0xf9))

(defn put-inline! :cc storing :inline (Always) [(place (ptr i64)) (value i64)] (-> void)
  (primitive/machine-code (Aarch64) 0x2a 0x01 0x00 0xf9))

(defn section-void [] (-> void)
  (let [(mut first) 0
        (mut second) 0]
    (put! (cast (ptr i64) (mut first)) (opaque 1234))
    (put-inline! (cast (ptr i64) (mut second)) (opaque 5678))
    (println "void: {} {}" first second)
    (check-eq "put!" first 1234)
    (check-eq "inline put!" second 5678)))

(defn main [] (-> i64)
  (section-scratch)
  (section-shared)
  (section-permuted)
  (section-preserved)
  (section-seven)
  (section-void)
  (println "shim calls: {} failed" (get failures))
  (get failures))
