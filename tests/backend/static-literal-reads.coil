(module tests.backend.static-literal-reads)
;;; Reads of scalar defs with relocation-free initializers lower to constants
;;; on the CIR path. Every width and signedness must keep the value a load
;;; from the def's storage produces, including negative narrow integers that
;;; are sign-extended into their container and unsigned extremes that are not.
(import "coil.var" :use [var-static])

(def I8-NEG (: -5 i8))
(def I16-NEG (: -300 i16))
(def I32-NEG (: -70000 i32))
(def I64-NEG (: -5000000000 i64))
(def U8-MAX (: 255 u8))
(def U16-MAX (: 65535 u16))
(def U32-MAX (: 4294967295 u32))
(def U64-MAX (: 18446744073709551615 u64))
(def I32-MIN (: -2147483648 i32))
(def F32-HALF (: -0.5 f32))
(def F64-BIG (: 12345.25 f64))
(def YES true)
(def NO false)
(def SIZE (sizeof i64))
(def SUM (+ (: 40 i32) (: 2 i32)))

;;; Opaque inputs keep each read from folding with its surrounding arithmetic.
(def zero (var-static i64 0))
(def one (var-static i64 1))

(defn check [(failures (mut i64)) (ok bool)] (-> void)
  (unless ok (set! failures (+ failures 1))))

(defn main [] (-> i64)
  (let [z (get zero)
        o (get one)
        (mut failures) (: 0 i64)]
    (check (mut failures) (= (+ (cast i64 I8-NEG) z) -5))
    (check (mut failures) (= (+ (cast i64 I16-NEG) z) -300))
    (check (mut failures) (= (+ (cast i64 I32-NEG) z) -70000))
    (check (mut failures) (= (+ I64-NEG z) -5000000000))
    (check (mut failures) (< (+ (cast i64 I8-NEG) z) 0))
    (check (mut failures) (= (+ (cast i64 U8-MAX) z) 255))
    (check (mut failures) (= (+ (cast i64 U16-MAX) z) 65535))
    (check (mut failures) (= (+ (cast i64 U32-MAX) z) 4294967295))
    (check (mut failures) (= (+ U64-MAX (cast u64 o)) 0))
    (check (mut failures) (= (- (cast i64 I32-MIN) o) -2147483649))
    (check (mut failures) (= (* F32-HALF (cast f32 (+ o o))) (: -1.0 f32)))
    (check (mut failures) (= (+ F64-BIG (cast f64 z)) 12345.25))
    (check (mut failures) (if (= o 1) YES NO))
    (check (mut failures) (not (if (= o 1) NO YES)))
    (check (mut failures) (= (+ (cast i64 SIZE) z) 8))
    (check (mut failures) (= (+ (cast i64 SUM) z) 42))
    ; Narrow arithmetic wraps in the def's own width, not in the container.
    (check (mut failures) (= (cast i64 (+ U8-MAX (cast u8 o))) 0))
    (check (mut failures) (= (cast i64 (- I8-NEG (cast i8 o))) -6))
    (println "static literal reads: {} failures" failures)
    failures))
