;;; What a called function does to memory, as Stogir derives it from the
;;; callee's body, and every way a caller's assumptions about a local whose
;;; address it passes could be wrong. The callees are ordinary small functions,
;;; which only a module's own bodies give effect records to; the test is built
;;; with COIL_STOGIR_EFFECTS=1 and inline expansion off (COIL_STOGIR_INLINE=budget=0) so that they stay
;;; calls, and also at defaults. Each scenario returns a value that is right only when the caller
;;; reread memory wherever a callee may have changed it. Exits with the number
;;; of failures.
(module tests.backend.stogir-call-effects)
(import "coil.primitive" :as primitive)
(import "coil.mem" :as mem)
(import "coil.cc" :as cc)
(import "coil.var" :use [var-static])

;;; Where no caller can see a value.
(def hidden (var-static i64 3))
(def kept (var-static u64 0))
(def spare (var-static i64 0))

;;; Point `kept` at static storage, so that nothing kept outlives its frame.
(defn forget :inline (Never) [] (-> void)
  (set kept (primitive/cast u64 (.cell spare))))

;;; ---- Callees ------------------------------------------------------------

;;; Only reads through its argument.
(defn weigh [(cell (ptr i64))] (-> i64)
  (* (load cell) (get hidden)))

;;; Reads two words of a record.
(defn weigh-pair [(cells (ptr i64))] (-> i64)
  (+ (load cells) (* (load (primitive/index cells 1)) 10)))

;;; Writes through its argument.
(defn bump [(cell (ptr i64))] (-> i64)
  (store! cell (+ (load cell) 100))
  7)

;;; Writes through its second argument what it reads through its first.
(defn carry [(from (ptr i64)) (to (ptr i64))] (-> i64)
  (store! to (+ (load from) 1))
  0)

;;; Keeps its argument where a later call can find it.
(defn keep [(cell (ptr i64))] (-> i64)
  (set kept (primitive/cast u64 cell))
  1)

;;; Writes through whatever was kept; its own argument is only read.
(defn bump-kept [(cell (ptr i64))] (-> i64)
  (let [target (primitive/cast (ptr i64) (get kept))]
    (store! target (+ (load target) 1000))
    (load cell)))

;;; Writes through whatever was kept and takes no argument at all.
(defn bump-kept-blind [] (-> i64)
  (let [target (primitive/cast (ptr i64) (get kept))]
    (store! target (+ (load target) 5000))
    0))

;;; Returns its argument: the caller then writes through the result.
(defn same [(cell (ptr i64))] (-> (ptr i64))
  (if (= (get hidden) 3) cell (primitive/index cell 1)))

;;; Adds DEPTH, DEPTH-1 .. 1 to the cell, calling itself. The call is not in
;;; tail position (a self tail call is lowered as a loop and is no longer a
;;; recursive callee), so the record must stay the conservative recursive one.
(defn descend [(cell (ptr i64)) (depth i64)] (-> i64)
  (if (> depth 0)
      (do (store! cell (+ (load cell) depth))
          (+ (descend cell (- depth 1)) 1))
      0))

;;; Calls whatever it is given.
(defn through [(f (fnptr (cc/C) [(ptr i64)] i64)) (cell (ptr i64))] (-> i64)
  (f cell))

;;; Hands its argument to the C library, which writes it.
(defn wipe [(cell (ptr i64))] (-> i64)
  (mem/memset (primitive/cast (ptr u8) cell) (cast i32 (get hidden)) 8)
  0)

;;; A volatile read: nothing is concluded about such a function.
(defn sample [(cell (ptr i64))] (-> i64)
  (primitive/volatile-load i64 cell))

;;; Writes the word after the one it is handed.
(defn bump-next [(cell (ptr i64))] (-> i64)
  (store! (primitive/index cell 1) 55)
  0)

;;; ---- Scenarios ----------------------------------------------------------

;;; The callee reads a local modified just before each call.
(defn reads-fresh :inline (Never) [(k i64)] (-> i64)
  (let [(mut x) k]
    (set! x (+ x 1))
    (let [first (weigh (mut x))]
      (set! x (* x 2))
      (let [second (weigh (mut x))]
        (+ first (* second 10) (* x 100))))))

;;; A counter in a local every iteration hands to a reader.
(defn reads-in-loop :inline (Never) [(k i64)] (-> i64)
  (let [(mut i) 0 (mut sum) 0]
    (while (< i k)
      (set! sum (+ sum (weigh (mut i))))
      (set! i (+ i 1)))
    (+ sum i)))

;;; The callee writes the local it is handed.
(defn written :inline (Never) [(k i64)] (-> i64)
  (let [(mut x) k
        before x
        result (bump (mut x))]
    (+ before (* x 3) result)))

;;; The loop bound is a local the body's callee writes.
(defn written-bound :inline (Never) [(k i64)] (-> i64)
  (let [(mut limit) k (mut i) 0 (mut trips) 0]
    (while (< i limit)
      (when (= i 2) (set! trips (+ trips (bump (mut limit)))))
      (set! i (+ i 7))
      (set! trips (+ trips 1)))
    (+ trips (* limit 1000))))

;;; Another local survives the call that writes its neighbour, and the two
;;; words of one record are told apart only by offset.
(defn written-beside :inline (Never) [(k i64)] (-> i64)
  (let [(mut pair) [k (* k 2)]
        (mut other) (+ k 5)
        a (get pair 0) b (get pair 1) c other
        _ (bump-next (primitive/cast (ptr i64) (mut pair)))]
    (+ a b c (get pair 0) (* (get pair 1) 3) (* other 7))))

;;; Both arguments name the same local: the write through the second is a
;;; write of the first.
(defn written-through-other :inline (Never) [(k i64)] (-> i64)
  (let [(mut x) k
        before x
        _ (carry (mut x) (mut x))]
    (+ before (* x 10))))

;;; The pointer is kept, and a later call that is not handed it writes it.
(defn kept-then-written :inline (Never) [(k i64)] (-> i64)
  (let [(mut x) k
        a (keep (mut x))
        before x
        b (bump-kept-blind)
        middle x
        (mut y) 1
        c (bump-kept (mut y))]
    (+ a b c before (* middle 3) (* x 7) y)))

;;; A reader of one local writes another whose pointer was kept earlier.
(defn kept-other :inline (Never) [(k i64)] (-> i64)
  (let [(mut x) k (mut y) (+ k 1)
        _ (keep (mut y))
        before y
        r (bump-kept (mut x))]
    (+ before (* y 3) r x)))

;;; The pointer comes back as a result and is written through.
(defn returned-then-written :inline (Never) [(k i64)] (-> i64)
  (let [(mut x) k
        alias (same (mut x))
        before x]
    (store! alias (+ (load alias) 40))
    (+ before (* x 3))))

(defn recursive :inline (Never) [(k i64)] (-> i64)
  (let [(mut x) k
        before x
        _ (descend (mut x) 4)]
    (+ before (* x 3))))

(defn indirect :inline (Never) [(k i64) (f (fnptr (cc/C) [(ptr i64)] i64))] (-> i64)
  (let [(mut x) k
        before x
        r (through f (mut x))]
    (+ before (* x 3) r)))

(defn through-library :inline (Never) [(k i64)] (-> i64)
  (let [(mut x) k
        before x
        _ (wipe (mut x))]
    (+ before (& x 0xffff))))

(defn volatile :inline (Never) [(k i64)] (-> i64)
  (let [(mut x) k]
    (set! x (+ x 2))
    (let [r (sample (mut x))]
      (set! x (+ x 1))
      (+ r (* x 10) (sample (mut x))))))

;;; A record two readers see, changed between them; its fields are read back
;;; around the calls and after a call that is handed nothing.
(defn record-of-two :inline (Never) [(k i64)] (-> i64)
  (let [(mut pair) [k (+ k 1)]
        first (weigh-pair (primitive/cast (ptr i64) (mut pair)))
        a (get pair 0)]
    (set! (mut pair) 1 (+ (get pair 1) a))
    (let [second (weigh-pair (primitive/cast (ptr i64) (mut pair)))
          _ (bump-kept-blind)]
      (+ first (* second 100) (get pair 0) (get pair 1)))))

(defn expect [(what (slice u8)) (got i64) (wanted i64)] (-> i64)
  (if (= got wanted)
      0
      (do (println "{}: got {}, expected {}" what got wanted) 1)))

(defn main [] (-> i64)
  (let [(mut failures) 0]
    ; hidden is 3 throughout.
    (for [k 0 6]
      (set! failures (+ failures (expect "reads fresh" (reads-fresh k)
                                         (+ (* (+ k 1) 3) (* (* (+ k 1) 2) 30) (* (* (+ k 1) 2) 100)))))
      (set! failures (+ failures (expect "reads in loop" (reads-in-loop k)
                                         (+ (/ (* 3 (* k (- k 1))) 2) k))))
      (set! failures (+ failures (expect "written" (written k) (+ k (* (+ k 100) 3) 7))))
      (set! failures (+ failures (expect "written beside" (written-beside k)
                                         (+ k (* k 2) (+ k 5) k 165 (* (+ k 5) 7)))))
      (set! failures (+ failures (expect "written through other" (written-through-other k)
                                         (+ k (* (+ k 1) 10)))))
      (set! failures (+ failures (expect "kept then written" (kept-then-written k)
                                         (+ 1 0 1 k (* (+ k 5000) 3) (* (+ k 6000) 7) 1))))
      (set! failures (+ failures (expect "kept other" (kept-other k)
                                         (+ (+ k 1) (* (+ k 1001) 3) k k))))
      (forget)
      (set! failures (+ failures (expect "returned then written" (returned-then-written k)
                                         (+ k (* (+ k 40) 3)))))
      (set! failures (+ failures (expect "recursive" (recursive k) (+ k (* (+ k 10) 3)))))
      (set! failures (+ failures (expect "indirect writer" (indirect k (fnptr-of bump))
                                         (+ k (* (+ k 100) 3) 7))))
      (set! failures (+ failures (expect "indirect reader" (indirect k (fnptr-of weigh))
                                         (+ k (* k 3) (* k 3)))))
      (set! failures (+ failures (expect "through library" (through-library k) (+ k 0x0303))))
      (set! failures (+ failures (expect "volatile" (volatile k)
                                         (+ (+ k 2) (* (+ k 3) 10) (+ k 3)))))
      (set! failures (+ failures (expect "record of two" (record-of-two k)
                                         (+ (+ k (* (+ k 1) 10))
                                            (* (+ k (* (+ k 1 k) 10)) 100)
                                            k (+ k 1 k))))))
    ; The bound starts at 20: i reaches 2 never (0, 7, 14, 21), so nothing is
    ; bumped; from 3 the callee is reached once i is 2.
    (set! failures (+ failures (expect "written bound untouched" (written-bound 20) (+ 3 20000))))
    (println "call effects: {} failures" failures)
    failures))
