;;; Structural checks for bottom-up CIR inlining: what is inlined, and that
;;; the caller's blocks, edges, PHIs and results stay consistent.
(module tests.backend.cir-inline)
(import "tpde.cir" :as cir)
(import "tpde.cir-inline" :as inlining)
(import "coil.arraylist" :use [ArrayList])
(import "coil.alloc" :use [malloc-allocator])
(import "coil.primitive" :as p)

(defn call-to! [(f (ptr cir/Func)) (symbol u32) (args (slice u32)) (results i64)] (-> u32)
  (let [a (malloc-allocator)
        (mut xs) (ArrayList::new [u32] a)
        (mut fs) (ArrayList::new [u32] a)
        (mut rs) (ArrayList::new [u8] a)]
    (for x args (push! (mut xs) x) (push! (mut fs) (: 0 u32)))
    (for _ (range 0 results) (push! (mut rs) (cast u8 cir/T-I64)))
    (let [v (cir/call! f symbol (cir/none) (mut xs) (mut fs) (mut rs) false)]
      (free! (mut xs)) (free! (mut fs)) (free! (mut rs))
      v)))

(defn calls-left [(f (ptr cir/Func))] (-> i64)
  (let [(mut n) 0]
    (for v (.insts f)
      (when (= (cast i64 (.op (cir/val f v))) cir/OP-CALL) (set! n (+ n 1))))
    n))

;;; Every block's instructions are its own, every edge names a real
;;; predecessor whose terminator reaches the block, and every PHI has one
;;; operand per predecessor naming that predecessor.
(defn consistent? [(f (ptr cir/Func))] (-> bool)
  (let [(mut ok) true
        nb (cir/block-count f)]
    (for b (range 0 (cir/i64-of nb))
      (let [bb (load (cir/blk f (cir/u32-of b)))]
        (when (and (> (.iend bb) (.ibegin bb))
                   (!= (get (.insts f) (- (cir/i64-of (.iend bb)) 1)) (.term bb)))
          (set! ok false))
        (let [(mut e) (.pred-first bb)]
          (while (!= e (cir/none))
            (let [edge (get (.edges f) (cir/i64-of e))
                  t (.term (cir/blk f (.from edge)))
                  x (load (cir/val f t))
                  (mut reaches) false]
              (for k (range (cir/i64-of (.nops x)) (cir/i64-of (.ntotal x)))
                (when (= (cir/operand f (cir/val f t) (cir/u32-of k)) (cir/u32-of b))
                  (set! reaches true)))
              (unless reaches (set! ok false))
              (set! e (.next edge)))))
        (for j (range (cir/i64-of (.phi-begin bb)) (cir/i64-of (+ (.phi-begin bb) (.phi-count bb))))
          (let [phi (get (.phis f) j) x (load (cir/val f phi))]
            (unless (= (.nops x) (.npred bb)) (set! ok false))))))
    ok))

;;; g(x) = x + 1 (one block); h(x) = x < 0 ? 0 - x : x (two RETs);
;;; r(x) = r(x) (recursive, never inlined into itself); caller uses all three.
(defn check [] (-> i64)
  (let [(mut gf) (cir/Func::new) g (p/cast (ptr cir/Func) (mut gf))
        (mut hf) (cir/Func::new) h (p/cast (ptr cir/Func) (mut hf))
        (mut rf) (cir/Func::new) r (p/cast (ptr cir/Func) (mut rf))
        (mut cf) (cir/Func::new) c (p/cast (ptr cir/Func) (mut cf))
        (mut failures) 0]
    (cir/set-block! g (cir/new-block! g))
    (let [x (cir/arg! g cir/T-I64 false)]
      (cir/ret1! g (cir/op2! g cir/OP-ADD cir/T-I64 x (cir/iconst! g 1) 0 0))
      (cir/finish! g))
    (let [entry (cir/new-block! h) neg (cir/new-block! h) pos (cir/new-block! h)]
      (cir/set-block! h entry)
      (let [x (cir/arg! h cir/T-I64 false)]
        (cir/condbr! h (cir/op2! h cir/OP-ICMP cir/T-I64 x (cir/iconst! h 0) cir/P-SLT 0) neg pos)
        (cir/set-block! h neg)
        (cir/ret1! h (cir/op2! h cir/OP-SUB cir/T-I64 (cir/iconst! h 0) x 0 0))
        (cir/set-block! h pos)
        (cir/ret1! h x)
        (cir/finish! h)))
    (cir/set-block! r (cir/new-block! r))
    (let [x (cir/arg! r cir/T-I64 false)]
      (cir/ret1! r (call-to! r 3 [x] 1))
      (cir/finish! r))
    (let [entry (cir/new-block! c) loop (cir/new-block! c) exit (cir/new-block! c)]
      (cir/set-block! c entry)
      (let [x (cir/arg! c cir/T-I64 false)
            one (call-to! c 1 [x] 1)
            two (call-to! c 2 [one] 1)]
        (cir/br! c loop)
        (cir/set-block! c loop)
        (let [three (call-to! c 3 [two] 1)]
          (cir/condbr! c three loop exit)
          (cir/set-block! c exit)
          (cir/ret1! c (cir/op2! c cir/OP-ADD cir/T-I64 two three 0 0))
          (cir/finish! c)
          (let [done (inlining/inline-module! [g h r c] [(: 1 u32) 2 3 4] [false false false false])]
            ; g and h inline into c; r stays a call (in r itself and in c)
            (unless (= done 3) (println "inlined {} (want 3)" done) (set! failures (+ failures 1)))
            (unless (= (calls-left c) 1) (println "caller calls {} (want 1)" (calls-left c))
              (set! failures (+ failures 1)))
            (unless (= (calls-left r) 1) (set! failures (+ failures 1)))
            (unless (consistent? c) (println "caller CFG inconsistent") (set! failures (+ failures 1)))))))
    (cir/func-free! g) (cir/func-free! h) (cir/func-free! r) (cir/func-free! c)
    failures))


;;; A two-result callee p(x) = (x, x + 1) inlined into q, which is then
;;; inlined into s: q keeps p's orphaned call result, which must not be cloned.
(defn orphaned-results [] (-> i64)
  (let [(mut pf) (cir/Func::new) pp (p/cast (ptr cir/Func) (mut pf))
        (mut qf) (cir/Func::new) q (p/cast (ptr cir/Func) (mut qf))
        (mut sf) (cir/Func::new) s (p/cast (ptr cir/Func) (mut sf))
        (mut failures) 0]
    (cir/set-block! pp (cir/new-block! pp))
    (let [x (cir/arg! pp cir/T-I64 false)
          (mut vals) (ArrayList::new [u32] (malloc-allocator))]
      (push! (mut vals) x)
      (push! (mut vals) (cir/op2! pp cir/OP-ADD cir/T-I64 x (cir/iconst! pp 1) 0 0))
      (cir/ret! pp (mut vals))
      (free! (mut vals))
      (cir/finish! pp))
    (cir/set-block! q (cir/new-block! q))
    (let [x (cir/arg! q cir/T-I64 false)
          first (call-to! q 1 [x] 2)
          second (cir/call-result q first 1)]
      (cir/ret1! q (cir/op2! q cir/OP-ADD cir/T-I64 first second 0 0))
      (cir/finish! q))
    (cir/set-block! s (cir/new-block! s))
    (let [x (cir/arg! s cir/T-I64 false)]
      (cir/ret1! s (call-to! s 2 [x] 1))
      (cir/finish! s))
    (let [done (inlining/inline-module! [pp q s] [(: 1 u32) 2 3] [false false false])]
      (unless (and (= done 2) (= (calls-left s) 0) (consistent? s))
        (println "orphaned-results: inlined {} calls left {}" done (calls-left s))
        (set! failures (+ failures 1))))
    (cir/func-free! pp) (cir/func-free! q) (cir/func-free! s)
    failures))

(defn main [] (-> i64)
  (let [failures (+ (check) (orphaned-results))]
    (println "CIR inlining: {} failures" failures)
    (if (= failures 0) 0 1)))
