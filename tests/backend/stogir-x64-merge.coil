;;; A hand-built x86-64 library image through the Stogir adapter's object path:
;;; codegen_stogir merge! (image relocations to assembler relocations),
;;; codegen_tpde tl-merge! (assembler to module object) and tl-elf-object
;;; (module object to ELF). The ELF object is written to the path given as the
;;; one argument; scripts/tests/stogir-x64-merge.py links it with a C harness,
;;; runs it and checks its relocations.
;;;
;;; The first image is `stogir_x64_entry` (text below, assembled by hand and
;;; checked against llvm-mc), with every relocation shape the x86-64 backend
;;; makes:
;;;
;;;   00  push rbx
;;;   01  mov  rbx, rdi
;;;   04  lea  rdi, [rip+msg]              PC32   msg    -4
;;;   0b  call puts                        PLT32  puts   -4
;;;   10  mov  rax, [rip+slot]             PC32   slot   -4   -> GOT load
;;;   17  mov  rax, [rax]
;;;   1a  cmp  byte [rip+seven], 7         PC32   seven  -5   (imm8 follows)
;;;   21  jne  bad
;;;   23  cmp  dword [rip+big], 0x12345678 PC32   big    -8   (imm32 follows)
;;;   2d  jne  bad
;;;   2f  test rbx, rbx
;;;   32  jne  second
;;;   34  lea  rcx, [rip+table]            PC32   table  -4
;;;   3b  jmp  [rcx]
;;;   3d  second: cmp rbx, 1
;;;   41  jne  third
;;;   43  lea  rcx, [rip+table]            PC32   table  -4
;;;   4a  jmp  [rcx+8]
;;;   4d  third: lea rcx, [rip+rel]        PC32   rel    -4
;;;   54  movsxd rdx, dword [rcx]
;;;   57  add  rcx, rdx
;;;   5a  jmp  rcx
;;;   5c  case0: add rax, 100 ; pop rbx ; ret
;;;   62  case1: add rax, 200 ; pop rbx ; ret
;;;   6a  case2: add rax, 300 ; pop rbx ; ret
;;;   72  bad:   mov rax, -1  ; pop rbx ; ret
;;;
;;; and data
;;;
;;;   00  slot:  .quad stogir_x64_value    ABS64, an undefined symbol: a slot
;;;   08  table: .quad case0               ABS64 to a label of the image
;;;   10         .quad entry + 0x62        ABS64 with an addend (case1)
;;;   18  rel:   .long case2 - .           PC32 in data, addend 0
;;;   1c  seven: .byte 7
;;;   20  big:   .long 0x12345678
;;;   24  msg:   .asciz "stogir x64 merge"
;;;
;;; The second image is `stogir_x64_forward`, whose data is one slot and is
;;; therefore not emitted: `mov rax, [rip+slot] ; jmp rax` with the slot naming
;;; the first function, a symbol this object defines.
(module coil.compiler.stogir-x64-merge)
(import "coil.compiler.codegen_stogir" :as backend)
(import "coil.compiler.codegen_tpde" :as native)
(import "coil.compiler.native_module" :use [Cga])
(import "coil.compiler.macho" :use [MTextData mobj-new mobj-add-sect! mobj-add-sym!])
(import "coil.compiler.elf" :use [elf-write])
(import "tpde.cir" :as cir)
(import "tpde.asm" :as asm)
(import "stogir.image" :as image)
(import "coil.primitive" :as p)
(import "coil.alloc" :use [Allocator malloc-allocator])
(import "coil.arraylist" :use [ArrayList])
(import "coil.result" :use [Ok Err])
(import "coil.args" :as args)
(import "coil.fs" :as fs)

(defn must [(what (slice u8)) (r (Result i32 (slice u8)))] (-> i32)
  (match r
    (Ok [v] v)
    (Err [message] (panic "{}: {}" what message))))

(defn relocate! [(source (mut image/Image)) (section i32) (offset i64) (kind i32)
                 (symbol i32) (addend i64)] (-> void)
  (unless (image/relocate! (mut source)
                           (image/Relocation :section section :offset offset :kind kind
                                             :symbol symbol :addend addend))
    (panic "the image refused a relocation at {} of section {}" offset section)))

;;; Merge SOURCE as the body of assembler symbol SYMBOL. IDS are the assembler
;;; symbols the image's undefined symbols name (import-name).
(defn merge-body! [(a (dyn Allocator)) (ta (ptr asm/Asm)) (source image/Image)
                   (symbol u32) (ids (slice u32))
                   (text-data (ptr (ArrayList MTextData)))] (-> void)
  (let [(mut func) (cir/Func::new)
        (mut state) (zeroed backend/Adapter)
        s (p/cast (ptr backend/Adapter) (mut state))]
    (set! (.name func) "stogir-x64-merge")
    (set! (.a s) a)
    (set! (.f s) (p/cast (ptr cir/Func) (mut func)))
    (set! (.ta s) ta)
    (set! (.text-data s) text-data)
    (set! (.import-ids s) (ArrayList::new [u32] a))
    (set! (.import-names s) (ArrayList::new [(slice u8)] a))
    (for id ids
      (push! (mut (.import-ids s)) id)
      (push! (mut (.import-names s)) (backend/import-name a id)))
    (backend/merge! s source symbol (p/cast (ptr backend/Module) 0))))

(defn entry-image [(a (dyn Allocator)) (puts u32) (value u32)] (-> image/Image)
  (let [(mut source) (image/create-x64 a)
        text [(: 0x53 u8)
              0x48 0x89 0xfb
              0x48 0x8d 0x3d 0 0 0 0
              0xe8 0 0 0 0
              0x48 0x8b 0x05 0 0 0 0
              0x48 0x8b 0x00
              0x80 0x3d 0 0 0 0 0x07
              0x75 0x4f
              0x81 0x3d 0 0 0 0 0x78 0x56 0x34 0x12
              0x75 0x43
              0x48 0x85 0xdb
              0x75 0x09
              0x48 0x8d 0x0d 0 0 0 0
              0xff 0x21
              0x48 0x83 0xfb 0x01
              0x75 0x0a
              0x48 0x8d 0x0d 0 0 0 0
              0xff 0x61 0x08
              0x48 0x8d 0x0d 0 0 0 0
              0x48 0x63 0x11
              0x48 0x01 0xd1
              0xff 0xe1
              0x48 0x83 0xc0 0x64 0x5b 0xc3
              0x48 0x05 0xc8 0x00 0x00 0x00 0x5b 0xc3
              0x48 0x05 0x2c 0x01 0x00 0x00 0x5b 0xc3
              0x48 0xc7 0xc0 0xff 0xff 0xff 0xff 0x5b 0xc3]
        message "stogir x64 merge"]
    (for byte text (push! (mut (.text source)) byte))
    ; slot, table (two entries), rel
    (for [i 0 28] (push! (mut (.data source)) 0))
    (push! (mut (.data source)) 7)
    (for [i 0 3] (push! (mut (.data source)) 0))
    (for byte [(: 0x78 u8) 0x56 0x34 0x12] (push! (mut (.data source)) byte))
    (for byte message (push! (mut (.data source)) byte))
    (push! (mut (.data source)) 0)
    (let [body (must "body" (image/symbol! (mut source) "_coil_stogir_body" 1 0))
          case0 (must "case0" (image/local-symbol! (mut source) "L_case0" 1 0x5c))
          case2 (must "case2" (image/local-symbol! (mut source) "L_case2" 1 0x6a))
          slot (must "slot" (image/local-symbol! (mut source) "L_slot" 2 0))
          table (must "table" (image/local-symbol! (mut source) "L_table" 2 8))
          rel (must "rel" (image/local-symbol! (mut source) "L_rel" 2 24))
          seven (must "seven" (image/local-symbol! (mut source) "L_seven" 2 28))
          big (must "big" (image/local-symbol! (mut source) "L_big" 2 32))
          msg (must "msg" (image/local-symbol! (mut source) "L_msg" 2 36))
          puts-import (must "puts" (image/symbol! (mut source) (backend/import-name a puts) 0 0))
          value-import
            (must "value" (image/symbol! (mut source) (backend/import-name a value) 0 0))]
      (relocate! (mut source) 1 0x07 image/X64-PC32 msg -4)
      (relocate! (mut source) 1 0x0c image/X64-PLT32 puts-import -4)
      (relocate! (mut source) 1 0x13 image/X64-PC32 slot -4)
      (relocate! (mut source) 1 0x1c image/X64-PC32 seven -5)
      (relocate! (mut source) 1 0x25 image/X64-PC32 big -8)
      (relocate! (mut source) 1 0x37 image/X64-PC32 table -4)
      (relocate! (mut source) 1 0x46 image/X64-PC32 table -4)
      (relocate! (mut source) 1 0x50 image/X64-PC32 rel -4)
      (relocate! (mut source) 2 0 image/ABS64 value-import 0)
      (relocate! (mut source) 2 8 image/ABS64 case0 0)
      (relocate! (mut source) 2 16 image/ABS64 body 0x62)
      (relocate! (mut source) 2 24 image/X64-PC32 case2 0))
    source))

(defn forward-image [(a (dyn Allocator)) (entry u32)] (-> image/Image)
  (let [(mut source) (image/create-x64 a)]
    (for byte [(: 0x48 u8) 0x8b 0x05 0 0 0 0 0xff 0xe0] (push! (mut (.text source)) byte))
    (for [i 0 8] (push! (mut (.data source)) 0))
    (let [body (must "body" (image/symbol! (mut source) "_coil_stogir_body" 1 0))
          slot (must "slot" (image/local-symbol! (mut source) "L_slot" 2 0))
          entry-import
            (must "entry" (image/symbol! (mut source) (backend/import-name a entry) 0 0))]
      (relocate! (mut source) 1 3 image/X64-PC32 slot -4)
      (relocate! (mut source) 2 0 image/ABS64 entry-import 0))
    source))

;;; Both images merged into one module and written as an ELF object at PATH.
(defn build-object [(a (dyn Allocator)) (path (slice u8))] (-> i64)
    (let [(mut assembler) (asm/Asm::new)
          ta (p/cast (ptr asm/Asm) (mut assembler))
          (mut module) (zeroed Cga)
          g (p/cast (ptr Cga) (mut module))
          (mut state) (zeroed native/Tl)
          tl (p/cast (ptr native/Tl) (mut state))]
      (set! (.a g) a)
      (set! (.obj g) (mobj-new a))
      (set! (.text g) (mobj-add-sect! (mut (.obj g)) "__TEXT" "__text" 4 2147484672))
      (set! (.constsec g) (mobj-add-sect! (mut (.obj g)) "__TEXT" "__const" 3 0))
      (set! (.datasec g) (mobj-add-sect! (mut (.obj g)) "__DATA" "__data" 3 0))
      (set! (.g tl) g)
      (set! (.a tl) a)
      (set! (.ta tl) ta)
      (set! (.x64 tl) true)
      (set! (.elf tl) true)
      (set! (.stogir tl) true)
      (set! (.sym-map tl) (ArrayList::new [u32] a))
      (set! (.tsym-mobj tl) (ArrayList::new [i64] a))
      (set! (.defined tl) (ArrayList::new [i64] a))
      (set! (.stogir-text-data tl) (ArrayList::new [MTextData] a))
      (let [m-puts (mobj-add-sym! (mut (.obj g)) "_puts" 0 0 true)
            m-value (mobj-add-sym! (mut (.obj g)) "_stogir_x64_value" 0 0 true)
            m-entry (mobj-add-sym! (mut (.obj g)) "_stogir_x64_entry" (.text g) 0 true)
            m-forward (mobj-add-sym! (mut (.obj g)) "_stogir_x64_forward" (.text g) 0 true)
            puts (native/tl-sym tl m-puts)
            value (native/tl-sym tl m-value)
            entry (native/tl-sym tl m-entry)
            forward (native/tl-sym tl m-forward)
            text-data (p/cast (ptr (ArrayList MTextData)) (mut (.stogir-text-data tl)))]
        (merge-body! a ta (entry-image a puts value) entry [puts value] text-data)
        (merge-body! a ta (forward-image a entry) forward [entry] text-data)
        (for pair [[m-entry (cast i64 entry)] [m-forward (cast i64 forward)]]
          (push! (mut (.defined tl)) (get pair 0))
          (push! (mut (.defined tl)) (get pair 1)))
        (native/tl-merge! tl)
        (let [(mut object) (native/tl-elf-object a (mut (.obj g)))
              bytes (elf-write (mut object))]
          (match (fs/write-file a path (slice (load bytes)))
            (Err [_] (do (eprintln "cannot write {}" path) 1))
            (Ok [_] (do (println "wrote {}" path) 0)))))))

(defn main [(argc i32) (argv (ptr (ptr i8)))] (-> i64)
  (args/init! argc argv)
  (if (!= (args/count) 2)
      (do (eprintln "usage: stogir-x64-merge OUTPUT.o") 2)
      (build-object (malloc-allocator) (args/nth 1))))
