;;; A program whose result every optimization level must agree on: recursion,
;;; a growing collection, a sum type, signed division and remainder by a
;;; variable and by constants, wrapping multiplication, a struct passed by
;;; value and a byte loop.
(module tests.backend.stogir-levels)
(import "coil.alloc" :use [malloc-allocator])
(import "coil.arraylist" :use [ArrayList])
(import "coil.primitive" :as primitive)

(defsum Shape (Square [(side i64)]) (Rect [(width i64) (height i64)]) (Empty []))
(defstruct Pair [(a i64) (b i64) (c i64) (d i64)])

(defn fib [(n i64)] (-> i64) (if (< n 2) n (+ (fib (- n 1)) (fib (- n 2)))))

(defn area [(s Shape)] (-> i64)
  (match s (Square [w] (* w w)) (Rect [w h] (* w h)) (Empty [] 0)))

(defn mix [(p Pair) (k i64)] (-> i64)
  (+ (/ (.a p) (+ k 1)) (% (.b p) 7) (primitive/imul (.c p) 2654435761) (/ (.d p) -3)))

(defn checksum [(bytes (slice u8))] (-> i64)
  (let [(mut h) (: 1469598103934665603 i64)]
    (for b bytes (set! h (primitive/imul (^ h (cast i64 b)) 1099511628211)))
    h))

(defn main [] (-> i64)
  (let [a (malloc-allocator)
        (mut values) (ArrayList::new [i64] a)
        (mut total) 0]
    (for [i 0 24] (push! (mut values) (fib i)))
    (for v values (set! total (+ total v)))
    (println "fib {}" total)
    (let [(mut areas) 0]
      (for [i 0 300]
        (set! areas (+ areas (area (cond (= (% i 3) 0) (Square i)
                                         (= (% i 3) 1) (Rect i (- 400 i))
                                         :else (Empty))))))
      (println "areas {}" areas))
    (let [(mut m) 0]
      (for [i -200 200]
        (set! m (primitive/iadd m (mix (Pair :a (* i 977) :b (- i 13) :c i :d (* i i)) (& i 15)))))
      (println "mix {}" m))
    (println "checksum {}" (checksum "the quick brown fox jumps over the lazy dog"))
    (free! (mut values))
    0))
