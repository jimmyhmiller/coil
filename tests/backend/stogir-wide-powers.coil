;;; 128-bit division, remainder and multiplication by a literal power of two
;;; (for signed division also a negated one), and shifts by a literal count,
;;; are computed inline from the two halves.
;;; Every exponent class (0, 1, 2, 63, 64, 65, 126 and, unsigned, 127) is
;;; checked on boundary values (minimum, -1, 0, 1, maximum, the powers and
;;; their neighbours) against identities that need no division: q * d + r = x
;;; with the remainder smaller than the divisor and signed like the dividend,
;;; and the same products and shifts computed with the count as a run-time
;;; value. The functions are spelled out per exponent because the divisor has
;;; to be a literal. No 128-bit division helper of the runtime is referenced
;;; (scripts/tests/stogir-wide-powers.py checks the object). Exits with the
;;; number of failures.
(module tests.backend.stogir-wide-powers)
(import "coil.cc" :as cc)
(import "coil.var" :use [var-static])
(extern exit :cc (cc/C) [i32] (-> never))

(const P0 (<< (: 1 u128) 0))
(const P1 (<< (: 1 u128) 1))
(const P2 (<< (: 1 u128) 2))
(const P63 (<< (: 1 u128) 63))
(const P64 (<< (: 1 u128) 64))
(const P65 (<< (: 1 u128) 65))
(const P126 (<< (: 1 u128) 126))
(const P127 (<< (: 1 u128) 127))
(const S0 (<< (: 1 i128) 0))
(const S1 (<< (: 1 i128) 1))
(const S2 (<< (: 1 i128) 2))
(const S63 (<< (: 1 i128) 63))
(const S64 (<< (: 1 i128) 64))
(const S65 (<< (: 1 i128) 65))
(const S126 (<< (: 1 i128) 126))
(const N0 (- 0 (<< (: 1 i128) 0)))
(const N1 (- 0 (<< (: 1 i128) 1)))
(const N2 (- 0 (<< (: 1 i128) 2)))
(const N63 (- 0 (<< (: 1 i128) 63)))
(const N64 (- 0 (<< (: 1 i128) 64)))
(const N65 (- 0 (<< (: 1 i128) 65)))
(const N126 (- 0 (<< (: 1 i128) 126)))

(defn sdiv-0 :inline (Never) [(x i128)] (-> i128) (/ x S0))
(defn srem-0 :inline (Never) [(x i128)] (-> i128) (% x S0))
(defn sdiv-1 :inline (Never) [(x i128)] (-> i128) (/ x S1))
(defn srem-1 :inline (Never) [(x i128)] (-> i128) (% x S1))
(defn sdiv-2 :inline (Never) [(x i128)] (-> i128) (/ x S2))
(defn srem-2 :inline (Never) [(x i128)] (-> i128) (% x S2))
(defn sdiv-63 :inline (Never) [(x i128)] (-> i128) (/ x S63))
(defn srem-63 :inline (Never) [(x i128)] (-> i128) (% x S63))
(defn sdiv-64 :inline (Never) [(x i128)] (-> i128) (/ x S64))
(defn srem-64 :inline (Never) [(x i128)] (-> i128) (% x S64))
(defn sdiv-65 :inline (Never) [(x i128)] (-> i128) (/ x S65))
(defn srem-65 :inline (Never) [(x i128)] (-> i128) (% x S65))
(defn sdiv-126 :inline (Never) [(x i128)] (-> i128) (/ x S126))
(defn srem-126 :inline (Never) [(x i128)] (-> i128) (% x S126))
(defn udiv-0 :inline (Never) [(x u128)] (-> u128) (/ x P0))
(defn urem-0 :inline (Never) [(x u128)] (-> u128) (% x P0))
(defn mul-0 :inline (Never) [(x u128)] (-> u128) (* x P0))
(defn lmul-0 :inline (Never) [(x u128)] (-> u128) (* P0 x))
(defn shl-0 :inline (Never) [(x u128)] (-> u128) (<< x 0))
(defn lshr-0 :inline (Never) [(x u128)] (-> u128) (>> x 0))
(defn ashr-0 :inline (Never) [(x i128)] (-> i128) (>> x 0))
(defn udiv-1 :inline (Never) [(x u128)] (-> u128) (/ x P1))
(defn urem-1 :inline (Never) [(x u128)] (-> u128) (% x P1))
(defn mul-1 :inline (Never) [(x u128)] (-> u128) (* x P1))
(defn lmul-1 :inline (Never) [(x u128)] (-> u128) (* P1 x))
(defn shl-1 :inline (Never) [(x u128)] (-> u128) (<< x 1))
(defn lshr-1 :inline (Never) [(x u128)] (-> u128) (>> x 1))
(defn ashr-1 :inline (Never) [(x i128)] (-> i128) (>> x 1))
(defn udiv-2 :inline (Never) [(x u128)] (-> u128) (/ x P2))
(defn urem-2 :inline (Never) [(x u128)] (-> u128) (% x P2))
(defn mul-2 :inline (Never) [(x u128)] (-> u128) (* x P2))
(defn lmul-2 :inline (Never) [(x u128)] (-> u128) (* P2 x))
(defn shl-2 :inline (Never) [(x u128)] (-> u128) (<< x 2))
(defn lshr-2 :inline (Never) [(x u128)] (-> u128) (>> x 2))
(defn ashr-2 :inline (Never) [(x i128)] (-> i128) (>> x 2))
(defn udiv-63 :inline (Never) [(x u128)] (-> u128) (/ x P63))
(defn urem-63 :inline (Never) [(x u128)] (-> u128) (% x P63))
(defn mul-63 :inline (Never) [(x u128)] (-> u128) (* x P63))
(defn lmul-63 :inline (Never) [(x u128)] (-> u128) (* P63 x))
(defn shl-63 :inline (Never) [(x u128)] (-> u128) (<< x 63))
(defn lshr-63 :inline (Never) [(x u128)] (-> u128) (>> x 63))
(defn ashr-63 :inline (Never) [(x i128)] (-> i128) (>> x 63))
(defn udiv-64 :inline (Never) [(x u128)] (-> u128) (/ x P64))
(defn urem-64 :inline (Never) [(x u128)] (-> u128) (% x P64))
(defn mul-64 :inline (Never) [(x u128)] (-> u128) (* x P64))
(defn lmul-64 :inline (Never) [(x u128)] (-> u128) (* P64 x))
(defn shl-64 :inline (Never) [(x u128)] (-> u128) (<< x 64))
(defn lshr-64 :inline (Never) [(x u128)] (-> u128) (>> x 64))
(defn ashr-64 :inline (Never) [(x i128)] (-> i128) (>> x 64))
(defn udiv-65 :inline (Never) [(x u128)] (-> u128) (/ x P65))
(defn urem-65 :inline (Never) [(x u128)] (-> u128) (% x P65))
(defn mul-65 :inline (Never) [(x u128)] (-> u128) (* x P65))
(defn lmul-65 :inline (Never) [(x u128)] (-> u128) (* P65 x))
(defn shl-65 :inline (Never) [(x u128)] (-> u128) (<< x 65))
(defn lshr-65 :inline (Never) [(x u128)] (-> u128) (>> x 65))
(defn ashr-65 :inline (Never) [(x i128)] (-> i128) (>> x 65))
(defn udiv-126 :inline (Never) [(x u128)] (-> u128) (/ x P126))
(defn urem-126 :inline (Never) [(x u128)] (-> u128) (% x P126))
(defn mul-126 :inline (Never) [(x u128)] (-> u128) (* x P126))
(defn lmul-126 :inline (Never) [(x u128)] (-> u128) (* P126 x))
(defn shl-126 :inline (Never) [(x u128)] (-> u128) (<< x 126))
(defn lshr-126 :inline (Never) [(x u128)] (-> u128) (>> x 126))
(defn ashr-126 :inline (Never) [(x i128)] (-> i128) (>> x 126))
(defn udiv-127 :inline (Never) [(x u128)] (-> u128) (/ x P127))
(defn urem-127 :inline (Never) [(x u128)] (-> u128) (% x P127))
(defn mul-127 :inline (Never) [(x u128)] (-> u128) (* x P127))
(defn lmul-127 :inline (Never) [(x u128)] (-> u128) (* P127 x))
(defn shl-127 :inline (Never) [(x u128)] (-> u128) (<< x 127))
(defn lshr-127 :inline (Never) [(x u128)] (-> u128) (>> x 127))
(defn ashr-127 :inline (Never) [(x i128)] (-> i128) (>> x 127))
(defn nsdiv-0 :inline (Never) [(x i128)] (-> i128) (/ x N0))
(defn nsrem-0 :inline (Never) [(x i128)] (-> i128) (% x N0))
(defn nsdiv-1 :inline (Never) [(x i128)] (-> i128) (/ x N1))
(defn nsrem-1 :inline (Never) [(x i128)] (-> i128) (% x N1))
(defn nsdiv-2 :inline (Never) [(x i128)] (-> i128) (/ x N2))
(defn nsrem-2 :inline (Never) [(x i128)] (-> i128) (% x N2))
(defn nsdiv-63 :inline (Never) [(x i128)] (-> i128) (/ x N63))
(defn nsrem-63 :inline (Never) [(x i128)] (-> i128) (% x N63))
(defn nsdiv-64 :inline (Never) [(x i128)] (-> i128) (/ x N64))
(defn nsrem-64 :inline (Never) [(x i128)] (-> i128) (% x N64))
(defn nsdiv-65 :inline (Never) [(x i128)] (-> i128) (/ x N65))
(defn nsrem-65 :inline (Never) [(x i128)] (-> i128) (% x N65))
(defn nsdiv-126 :inline (Never) [(x i128)] (-> i128) (/ x N126))
(defn nsrem-126 :inline (Never) [(x i128)] (-> i128) (% x N126))

;; Written as an expression of literals rather than a constant.
(defn sdiv-spelled :inline (Never) [(x i128)] (-> i128) (/ x (<< (: 1 i128) 65)))
(defn urem-spelled :inline (Never) [(x u128)] (-> u128) (% x (<< (: 1 u128) 127)))
;; Not a power of two: an ordinary product.
(defn mul-three :inline (Never) [(x u128)] (-> u128) (* x 3))

;; The same shifts and products with the count as a run-time value.
(defn shl-by :inline (Never) [(x u128) (n u128)] (-> u128) (<< x n))
(defn lshr-by :inline (Never) [(x u128) (n u128)] (-> u128) (>> x n))
(defn ashr-by :inline (Never) [(x i128) (n i128)] (-> i128) (>> x n))
(defn mul-by :inline (Never) [(x u128) (y u128)] (-> u128) (* x y))

(def failures (var-static i64 0))

(defn fail [(what (slice u8)) (k i64) (index i64)] (-> void)
  (println "FAIL {} exponent {} value {}" what k index)
  (set failures (+ (get failures) 1)))

;;; q and r are x / 2^k and x % 2^k truncated toward zero.
(defn check-signed [(k i64) (index i64) (x i128) (q i128) (r i128) (one i128)] (-> void)
  (let [d (ashr-by (cast i128 (shl-by (cast u128 one) (cast u128 k))) 0)]
    (unless (= (+ (cast i128 (mul-by (cast u128 q) (cast u128 d))) r) x)
      (fail "signed q * d + r" k index))
    (unless (and (< r d) (> r (- 0 d))) (fail "signed remainder range" k index))
    (unless (or (= r 0) (= (< r 0) (< x 0))) (fail "signed remainder sign" k index))))

;;; q and r are x / -(2^k) and x % -(2^k), beside the answers for 2^k. The
;;; minimum divided by -1 has no answer and is not asked for.
(defn check-negated [(k i64) (index i64) (x i128) (q i128) (r i128) (plain-q i128) (plain-r i128)
                     (one i128)]
  (-> void)
  (let [d (- 0 (cast i128 (shl-by (cast u128 one) (cast u128 k))))]
    (unless (= r plain-r) (fail "negated divisor remainder" k index))
    (unless (= q (- 0 plain-q)) (fail "negated divisor quotient" k index))
    (unless (= (+ (cast i128 (mul-by (cast u128 q) (cast u128 d))) r) x)
      (fail "negated q * d + r" k index))))

(defn check-unsigned [(k i64) (index i64) (x u128) (q u128) (r u128) (one u128)] (-> void)
  (let [d (shl-by one (cast u128 k))]
    (unless (= (+ (mul-by q d) r) x) (fail "unsigned q * d + r" k index))
    (unless (< r d) (fail "unsigned remainder range" k index))
    (unless (= q (lshr-by x (cast u128 k))) (fail "unsigned quotient is the shift" k index))))

(defn check-shapes [(k i64) (index i64) (x u128) (product u128) (left u128) (shl u128) (lshr u128)
                    (ashr i128) (one u128)]
  (-> void)
  (let [d (shl-by one (cast u128 k))]
    (unless (= product (mul-by x d)) (fail "product" k index))
    (unless (= left product) (fail "literal on the left" k index))
    (unless (= shl (shl-by x (cast u128 k))) (fail "left shift" k index))
    (unless (= shl product) (fail "left shift is the product" k index))
    (unless (= lshr (lshr-by x (cast u128 k))) (fail "logical right shift" k index))
    (unless (= ashr (ashr-by (cast i128 x) (cast i128 k))) (fail "arithmetic right shift" k index))))

(defn check-value [(index i64) (x i128) (one i128)] (-> void)
  (let [u (cast u128 x) uone (cast u128 one)]
    (check-signed 0 index x (sdiv-0 x) (srem-0 x) one)
    (check-signed 1 index x (sdiv-1 x) (srem-1 x) one)
    (check-signed 2 index x (sdiv-2 x) (srem-2 x) one)
    (check-signed 63 index x (sdiv-63 x) (srem-63 x) one)
    (check-signed 64 index x (sdiv-64 x) (srem-64 x) one)
    (check-signed 65 index x (sdiv-65 x) (srem-65 x) one)
    (check-signed 126 index x (sdiv-126 x) (srem-126 x) one)
    (check-unsigned 0 index u (udiv-0 u) (urem-0 u) uone)
    (check-shapes 0 index u (mul-0 u) (lmul-0 u) (shl-0 u) (lshr-0 u) (ashr-0 x) uone)
    (check-unsigned 1 index u (udiv-1 u) (urem-1 u) uone)
    (check-shapes 1 index u (mul-1 u) (lmul-1 u) (shl-1 u) (lshr-1 u) (ashr-1 x) uone)
    (check-unsigned 2 index u (udiv-2 u) (urem-2 u) uone)
    (check-shapes 2 index u (mul-2 u) (lmul-2 u) (shl-2 u) (lshr-2 u) (ashr-2 x) uone)
    (check-unsigned 63 index u (udiv-63 u) (urem-63 u) uone)
    (check-shapes 63 index u (mul-63 u) (lmul-63 u) (shl-63 u) (lshr-63 u) (ashr-63 x) uone)
    (check-unsigned 64 index u (udiv-64 u) (urem-64 u) uone)
    (check-shapes 64 index u (mul-64 u) (lmul-64 u) (shl-64 u) (lshr-64 u) (ashr-64 x) uone)
    (check-unsigned 65 index u (udiv-65 u) (urem-65 u) uone)
    (check-shapes 65 index u (mul-65 u) (lmul-65 u) (shl-65 u) (lshr-65 u) (ashr-65 x) uone)
    (check-unsigned 126 index u (udiv-126 u) (urem-126 u) uone)
    (check-shapes 126 index u (mul-126 u) (lmul-126 u) (shl-126 u) (lshr-126 u) (ashr-126 x) uone)
    (check-unsigned 127 index u (udiv-127 u) (urem-127 u) uone)
    (check-shapes 127 index u (mul-127 u) (lmul-127 u) (shl-127 u) (lshr-127 u) (ashr-127 x) uone)
    (check-negated 1 index x (nsdiv-1 x) (nsrem-1 x) (sdiv-1 x) (srem-1 x) one)
    (check-negated 2 index x (nsdiv-2 x) (nsrem-2 x) (sdiv-2 x) (srem-2 x) one)
    (check-negated 63 index x (nsdiv-63 x) (nsrem-63 x) (sdiv-63 x) (srem-63 x) one)
    (check-negated 64 index x (nsdiv-64 x) (nsrem-64 x) (sdiv-64 x) (srem-64 x) one)
    (check-negated 65 index x (nsdiv-65 x) (nsrem-65 x) (sdiv-65 x) (srem-65 x) one)
    (check-negated 126 index x (nsdiv-126 x) (nsrem-126 x) (sdiv-126 x) (srem-126 x) one)
    (unless (= x (cast i128 (shl-by uone 127)))
      (check-negated 0 index x (nsdiv-0 x) (nsrem-0 x) (sdiv-0 x) (srem-0 x) one))
    (unless (= (sdiv-spelled x) (sdiv-65 x)) (fail "spelled signed divisor" 65 index))
    (unless (= (urem-spelled u) (urem-127 u)) (fail "spelled unsigned divisor" 127 index))
    (unless (= (mul-three u) (+ u (mul-1 u))) (fail "product by three" 0 index))))

(defn main [(argc i32) (argv (ptr (ptr i8)))] (-> i32)
  ; `one` is not a constant to the compiler.
  (let [one (cast i128 argc)
        minimum (cast i128 (shl-by (cast u128 one) 127))
        maximum (- 0 (+ minimum 1))
        pattern (cast i128 (+ (shl-by (cast u128 0x0123456789abcdef) 64) (cast u128 0x7edcba9876543210)))
        (mut index) 0]
    (for x [minimum (+ minimum 1) (+ minimum 2) (- 0 one) (- 0 (+ one one)) (- one one) one
            (+ one one) (+ one one one) (- maximum 1) maximum pattern (- 0 pattern)
            (+ pattern minimum)]
      (check-value index x one)
      (set! index (+ index 1)))
    ; Every power of two with its neighbours, and their negations.
    (for [k 0 127]
      (let [power (cast i128 (shl-by (cast u128 one) (cast u128 k)))]
        (for x [power (- power 1) (+ power 1) (- 0 power) (- 1 power) (- (- 0 power) 1)]
          (check-value (+ 1000 k) x one))))
    ; Hand-checked answers: truncation toward zero.
    (unless (and (= (sdiv-1 -1) 0) (= (srem-1 -1) -1) (= (sdiv-1 -3) -1) (= (srem-1 -3) -1)
                 (= (sdiv-2 -7) -1) (= (srem-2 -7) -3) (= (sdiv-2 7) 1) (= (srem-2 7) 3)
                 (= (sdiv-0 -7) -7) (= (srem-0 -7) 0)
                 (= (sdiv-126 minimum) -2) (= (srem-126 minimum) 0)
                 (= (sdiv-126 maximum) 1) (= (srem-126 maximum) (- (cast i128 (shl-by (cast u128 one) 126)) 1))
                 (= (sdiv-64 (- 0 (cast i128 (shl-by (cast u128 one) 64)))) -1)
                 (= (sdiv-64 (- 1 (cast i128 (shl-by (cast u128 one) 64)))) 0)
                 (= (sdiv-63 minimum) (- 0 (cast i128 (shl-by (cast u128 one) 64))))
                 (= (udiv-127 (cast u128 minimum)) 1) (= (urem-127 (cast u128 -1)) (cast u128 maximum))
                 (= (nsdiv-1 -1) 0) (= (nsrem-1 -1) -1) (= (nsdiv-2 -7) 1) (= (nsrem-2 -7) -3)
                 (= (nsdiv-2 7) -1) (= (nsrem-2 7) 3) (= (nsdiv-0 7) -7) (= (nsrem-0 7) 0)
                 (= (nsdiv-126 minimum) 2) (= (nsdiv-126 maximum) -1)
                 (= (nsdiv-1 minimum) (cast i128 (shl-by (cast u128 one) 126))))
      (fail "hand-checked" 0 0))
    (println "stogir-wide-powers: {} failures" (get failures))
    (exit (cast i32 (get failures)))))
