;;; Structural checks for CIR aggregate copy forwarding: which copies the three
;;; rewrites remove, which they must keep, and where the operands then point.
(module tests.backend.cir-copy-forwarding)
(import "tpde.cir" :as cir)
(import "tpde.cir-copies" :as copies)
(import "coil.arraylist" :use [ArrayList])
(import "coil.alloc" :use [malloc-allocator])
(import "coil.primitive" :as p)

(defn call! [(f (ptr cir/Func)) (args (slice u32)) (flags (slice u32))] (-> u32)
  (let [a (malloc-allocator)
        (mut xs) (ArrayList::new [u32] a)
        (mut fs) (ArrayList::new [u32] a)
        (mut rs) (ArrayList::new [u8] a)]
    (for x args (push! (mut xs) x))
    (for x flags (push! (mut fs) x))
    (let [v (cir/call! f (: 7 u32) (cir/none) (mut xs) (mut fs) (mut rs) false)]
      (free! (mut xs)) (free! (mut fs)) (free! (mut rs))
      v)))

(defn copies-left [(f (ptr cir/Func))] (-> i64)
  (let [(mut n) 0]
    (for v (.insts (load f))
      (when (= (cast i64 (.op (cir/val f v))) cir/OP-MEMCPY) (set! n (+ n 1))))
    n))

(defn report [(name (slice u8)) (removed i64) (expected i64) (left i64) (want-left i64)
              (slots i64) (want-slots i64)] (-> i64)
  (if (and (= removed expected) (= left want-left) (= slots want-slots))
      0
      (do (println "{}: removed {} (want {}), copies left {} (want {}), slots {} (want {})"
                   name removed expected left want-left slots want-slots)
          1)))

(defn run [(f (ptr cir/Func))] (-> i64)
  (cir/finish! f)
  (copies/forward-copies! f))

;;; A read-only snapshot of caller memory, read once: the copy goes away.
(defn forward-heap [(interfere i64)] (-> i64)
  (let [(mut function) (cir/Func::new) f (p/cast (ptr cir/Func) (mut function))]
    (cir/set-block! f (cir/new-block! f))
    (let [source (cir/arg! f cir/T-I64 false)
          other (cir/arg! f cir/T-I64 false)
          private (cir/alloca! f 8 8)
          temporary (cir/alloca! f 64 8)]
      (cir/op2! f cir/OP-MEMCPY cir/T-VOID temporary source 64 0)
      (cond (= interfere 1) (cir/store-mem! f other (cir/iconst! f 1) 0 8)
            (= interfere 2) (cir/store-mem! f private (cir/iconst! f 1) 0 8)
            (= interfere 3) (call! f [other] [(: 0 u32)])
            :else 0)
      (let [read (cir/load-mem! f cir/T-I64 temporary 8 8 false)]
        (cir/ret1! f read)
        (let [removed (run f)
              ok (if (or (= interfere 1) (= interfere 3)) 0 1)
              failures (report "forward-heap" removed ok (copies-left f) (- 1 ok)
                               (len (.allocas function)) (if (= ok 1) 1 2))
              x (cir/val f read)
              pointed (if (and (= ok 1) (not (and (= (cir/operand f x (: 0 u32)) source)
                                                  (= (.imm x) 8))))
                          1 0)]
          (cir/func-free! f)
          (+ failures pointed))))))

;;; A write to the source after the last read of the copy, around a loop, does
;;; not end the copy's live range early: the copy still goes away.
(defn forward-loop [] (-> i64)
  (let [(mut function) (cir/Func::new) f (p/cast (ptr cir/Func) (mut function))
        entry (cir/new-block! f)
        body (cir/new-block! f)
        exit (cir/new-block! f)]
    (cir/set-block! f entry)
    (let [source (cir/arg! f cir/T-I64 false)
          temporary (cir/alloca! f 32 8)]
      (cir/br! f body)
      (cir/set-block! f body)
      (cir/op2! f cir/OP-MEMCPY cir/T-VOID temporary source 32 0)
      (let [read (cir/load-mem! f cir/T-I64 temporary 0 8 false)]
        (cir/store-mem! f source read 8 8)
        (cir/condbr! f read body exit)
        (cir/set-block! f exit)
        (cir/ret0! f)
        (let [removed (run f)
              failures (report "forward-loop" removed 1 (copies-left f) 0
                               (len (.allocas function)) 0)]
          (cir/func-free! f)
          failures)))))

;;; An indirect call argument made from a private value: moved when the value
;;; is dead after the call, copied when it is read again.
(defn move-into-call [(read-after bool)] (-> i64)
  (let [(mut function) (cir/Func::new) f (p/cast (ptr cir/Func) (mut function))]
    (cir/set-block! f (cir/new-block! f))
    (let [source (cir/arg! f cir/T-I64 false)
          value (cir/alloca! f 48 8)
          argument (cir/alloca! f 48 8)]
      (cir/op2! f cir/OP-MEMCPY cir/T-VOID value source 48 0)
      (cir/store-mem! f value (cir/iconst! f 3) 0 8)
      (cir/op2! f cir/OP-MEMCPY cir/T-VOID argument value 48 0)
      (let [call (call! f [argument] [(: cir/AF-ADDRESS u32)])]
        (if read-after
            (cir/ret1! f (cir/load-mem! f cir/T-I64 value 0 8 false))
            (cir/ret0! f))
        (let [removed (run f)
              ; the first copy of caller memory is written afterwards: kept
              failures (report (if read-after "move-read-after" "move-into-call")
                               removed (if read-after 0 1) (copies-left f)
                               (if read-after 2 1) (len (.allocas function))
                               (if read-after 2 1))
              passed (cir/operand f (cir/val f call) (: 0 u32))
              wrong (if (and (not read-after) (!= passed value)) 1 0)]
          (cir/func-free! f)
          (+ failures wrong))))))

;;; A call result copied out to this function's own sret, through a private
;;; slot, becomes the callee's sret directly. A read of the destination on a
;;; path that skips the copy keeps it.
(defn call-slot [(mode i64)] (-> i64)
  (let [(mut function) (cir/Func::new) f (p/cast (ptr cir/Func) (mut function))
        entry (cir/new-block! f)
        yes (cir/new-block! f)
        no (cir/new-block! f)]
    (cir/set-block! f entry)
    (let [result (cir/arg! f cir/T-I64 true)
          local (cir/alloca! f 64 8)
          slot (cir/alloca! f 64 8)
          destination (if (= mode 0) result local)]
      (when (!= mode 0) (cir/op1! f cir/OP-MEMZERO cir/T-VOID local 64 0))
      (let [call (call! f [slot] [(: cir/AF-SRET u32)])
            tag (cir/load-mem! f cir/T-I64 slot 0 8 false)]
        (cir/condbr! f tag yes no)
        (cir/set-block! f yes)
        (cir/op2! f cir/OP-MEMCPY cir/T-VOID destination slot 64 0)
        (if (= mode 0)
            (cir/ret0! f)
            (cir/ret1! f (cir/load-mem! f cir/T-I64 local 8 8 false)))
        (cir/set-block! f no)
        (if (= mode 2)
            (cir/ret1! f (cir/load-mem! f cir/T-I64 local 16 8 false))
            (cir/ret0! f))
        (let [removed (run f)
              ok (if (= mode 2) 0 1)
              failures (report "call-slot" removed ok (copies-left f) (- 1 ok)
                               (len (.allocas function)) (- (if (= mode 0) 2 2) ok))
              passed (cir/operand f (cir/val f call) (: 0 u32))
              wrong (if (and (= ok 1) (!= passed destination)) 1 0)]
          (cir/func-free! f)
          (+ failures wrong))))))

;;; A slot whose address is stored is never rewritten.
(defn escaped [] (-> i64)
  (let [(mut function) (cir/Func::new) f (p/cast (ptr cir/Func) (mut function))]
    (cir/set-block! f (cir/new-block! f))
    (let [source (cir/arg! f cir/T-I64 false)
          out (cir/arg! f cir/T-I64 false)
          temporary (cir/alloca! f 64 8)]
      (cir/op2! f cir/OP-MEMCPY cir/T-VOID temporary source 64 0)
      (cir/store-mem! f out temporary 0 8)
      (cir/ret1! f (cir/load-mem! f cir/T-I64 temporary 0 8 false))
      (let [removed (run f)
            failures (report "escaped" removed 0 (copies-left f) 1 (len (.allocas function)) 1)]
        (cir/func-free! f)
        failures))))

;;; sret result -> let binding -> indirect argument: every copy goes, over rounds.
(defn chain [] (-> i64)
  (let [(mut function) (cir/Func::new) f (p/cast (ptr cir/Func) (mut function))]
    (cir/set-block! f (cir/new-block! f))
    (let [first (cir/alloca! f 40 8)
          binding (cir/alloca! f 40 8)
          argument (cir/alloca! f 40 8)]
      (call! f [first] [(: cir/AF-SRET u32)])
      (cir/op2! f cir/OP-MEMCPY cir/T-VOID binding first 40 0)
      (cir/op2! f cir/OP-MEMCPY cir/T-VOID argument binding 40 0)
      (call! f [argument] [(: cir/AF-ADDRESS u32)])
      (cir/ret0! f)
      (let [removed (run f)
            failures (report "chain" removed 2 (copies-left f) 0 (len (.allocas function)) 1)]
        (cir/func-free! f)
        failures))))


;;; Each arm of a two-way choice builds its aggregate in a slot; the merged
;;; address is copied to this function's sret. The copy sinks into both arms and
;;; each arm's slot then becomes the sret itself (call slot / forwarding).
(defn sunk-choice [(conditional-arm bool)] (-> i64)
  (let [(mut function) (cir/Func::new) f (p/cast (ptr cir/Func) (mut function))
        entry (cir/new-block! f)
        left (cir/new-block! f)
        right (cir/new-block! f)
        join (cir/new-block! f)]
    (cir/set-block! f entry)
    (let [result (cir/arg! f cir/T-I64 true)
          flag (cir/arg! f cir/T-I64 false)
          a (cir/alloca! f 64 8)
          b (cir/alloca! f 64 8)
          var (cir/new-var! f cir/T-I64)]
      (cir/condbr! f flag left right)
      (cir/seal! f left) (cir/seal! f right)
      (cir/set-block! f left)
      (call! f [a] [(: cir/AF-SRET u32)])
      (cir/def-var! f var a)
      (if conditional-arm
          (cir/condbr! f flag join right)
          (cir/br! f join))
      (cir/set-block! f right)
      (cir/op1! f cir/OP-MEMZERO cir/T-VOID b 64 0)
      (cir/store-mem! f b (cir/iconst! f 9) 0 8)
      (cir/def-var! f var b)
      (cir/br! f join)
      (cir/seal! f join)
      (cir/set-block! f join)
      (cir/op2! f cir/OP-MEMCPY cir/T-VOID result (cir/use-var! f var) 64 0)
      (cir/ret0! f)
      (let [removed (run f)
            ; a conditional predecessor cannot take a sunk copy
            failures (report (if conditional-arm "sunk-conditional" "sunk-choice")
                             removed (if conditional-arm 0 2) (copies-left f)
                             (if conditional-arm 1 0) (len (.allocas function))
                             (if conditional-arm 2 0))]
        (cir/func-free! f)
        failures))))


;;; The destination is written between the source's initialization and the
;;; copy (a field stored into a zeroed record): the copy must stay, or the
;;; zeroing would erase the moved field. Regression from cte-add-fn!.
(defn clobbered-destination [] (-> i64)
  (let [(mut function) (cir/Func::new) f (p/cast (ptr cir/Func) (mut function))]
    (cir/set-block! f (cir/new-block! f))
    (let [pointer (cir/arg! f cir/T-I64 false)
          length (cir/arg! f cir/T-I64 false)
          out (cir/arg! f cir/T-I64 false)
          name (cir/alloca! f 16 8)
          zero (cir/alloca! f 184 8)
          record (cir/alloca! f 184 8)]
      (cir/store-mem! f name pointer 0 8)
      (cir/store-mem! f name length 8 8)
      (cir/op1! f cir/OP-MEMZERO cir/T-VOID zero 184 0)
      (cir/op2! f cir/OP-MEMCPY cir/T-VOID record zero 184 0)
      (let [field (cir/op2! f cir/OP-MEMCPY cir/T-VOID record name 16 0)]
        (cir/op2! f cir/OP-MEMCPY cir/T-VOID out record 184 0)
        (cir/ret0! f)
        (let [removed (run f)
              kept (= (& (.flags (cir/val f field)) (: 8 u8)) (: 0 u8))
              failures (if kept 0 (do (println "clobbered-destination: field copy removed") 1))]
          (cir/func-free! f)
          failures)))))

(defn main [] (-> i64)
  (let [(mut failures) 0]
    (for mode [(: 0 i64) 1 2 3]
      (set! failures (+ failures (forward-heap mode))))
    (set! failures (+ failures (forward-loop)))
    (set! failures (+ failures (move-into-call false)))
    (set! failures (+ failures (move-into-call true)))
    (for mode [(: 0 i64) 1 2]
      (set! failures (+ failures (call-slot mode))))
    (set! failures (+ failures (escaped)))
    (set! failures (+ failures (chain)))
    (set! failures (+ failures (sunk-choice false)))
    (set! failures (+ failures (sunk-choice true)))
    (set! failures (+ failures (clobbered-destination)))
    (println "CIR copy forwarding: {} failures" failures)
    (if (= failures 0) 0 1)))
