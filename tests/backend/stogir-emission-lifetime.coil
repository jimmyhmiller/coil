;;; Direct backend lifetime regression: no frontend executes in the test host.
(module coil.compiler.stogir-emission-lifetime)
(import "coil.compiler.codegen_stogir" :as backend)
(import "coil.compiler.macho" :use [MTextData])
(import "tpde.cir" :as cir)
(import "tpde.asm" :as asm)
(import "tpde.buf" :as buf)
(import "stogir.jit.darwin" :as jit)
(import "coil.primitive" :as p)
(import "coil.cc" :as cc)
(import "coil.alloc" :use [malloc-allocator allocator close!])
(import "coil.scratch" :as scratch)
(import "coil.arraylist" :use [ArrayList])
(import "coil.result" :use [Ok Err])

(defn main [] (-> i64)
  (let [a (malloc-allocator)
        storage (p/alloc-stack scratch/ScratchArena)
        (mut assembler) (asm/Asm::new)
        ta (p/cast (ptr asm/Asm) (mut assembler))
        (mut leaf) (cir/Func::new)
        fp (p/cast (ptr cir/Func) (mut leaf))
        leaf-symbol (asm/sym-add-def! ta "leaf" -2 0 0 asm/BIND-LOCAL)
        (mut offsets) (ArrayList::new [i64] a)
        (mut text-data) (ArrayList::new [MTextData] a)
        (mut failures) 0]
    (scratch/ScratchArena::init-with-capacity storage a 65536)
    (set! (.name leaf) "lifetime.leaf")
    (cir/set-block! fp (cir/new-block! fp))
    (let [x (cir/arg! fp cir/T-I64 false)
          seven (cir/iconst! fp 7)
          result (cir/op2! fp cir/OP-ADD cir/T-I64 x seven 0 0)]
      (cir/ret1! fp result))
    (cir/finish! fp)
    (let [(mut module) (backend/module-create (allocator storage) false)
          mp (p/cast (ptr backend/Module) (mut module))]
      (backend/module-prepare! mp fp ta leaf-symbol false)
      (backend/module-finish! mp)
      (for [i 0 32]
        (let [(mut caller) (cir/Func::new)
              cp (p/cast (ptr cir/Func) (mut caller))
              symbol (asm/sym-add-def! ta "caller" -2 0 0 asm/BIND-LOCAL)
              (mut args) (ArrayList::new [u32] a)
              (mut flags) (ArrayList::new [u32] a)
              (mut types) (ArrayList::new [u8] a)
              (mut references) (ArrayList::new [u32] a)]
          (set! (.name caller) "lifetime.caller")
          (cir/set-block! cp (cir/new-block! cp))
          (push! (mut args) (cir/arg! cp cir/T-I64 false))
          (push! (mut flags) 0) (push! (mut types) (cast u8 cir/T-I64))
          (let [call (cir/call! cp leaf-symbol (cir/none)
                                (p/cast (ptr (ArrayList u32)) (mut args))
                                (p/cast (ptr (ArrayList u32)) (mut flags))
                                (p/cast (ptr (ArrayList u8)) (mut types)) false)
                result (cir/op2! cp cir/OP-ADD cir/T-I64 call (cir/iconst! cp i) 0 0)]
            (cir/ret1! cp result))
          (cir/finish! cp)
          (backend/prepare-emission-body! mp cp ta symbol 3)
          (unless (backend/reference-symbols! mp cp symbol (mut references))
            (set! failures (+ failures 1)))
          (when (!= (len references) 0) (set! failures (+ failures 1)))
          (backend/compile-with-module! cp ta symbol
                                        (p/cast (ptr (ArrayList MTextData)) (mut text-data)) 3 mp)
          (push! (mut offsets) (.off (asm/sym-at ta symbol)))
          (backend/release-emission-body! mp symbol)
          (backend/release-emission-body! mp symbol)
          (cir/func-free! cp)
          (free! (mut args)) (free! (mut flags)) (free! (mut types))
          (free! (mut references))))
      ; Execute only after every raw caller arena has been released and the
      ; body array has grown several times. Text and fixups must own their bytes.
      (match (jit/map-text (buf/as-slice (asm/sect-buf ta asm/SEC-TEXT)))
        (Err [message] (println "{}" message) (set! failures (+ failures 1)))
        (Ok [mapped]
          (let [(mut image) mapped]
            (for [i 0 (len offsets)]
              (let [f (p/cast (fnptr (cc/C) [i64] i64)
                             (p/index (.base image) (get offsets i)))]
                (for [x -100 101]
                  (when (!= (call-ptr f x) (+ x 7 i))
                    (set! failures (+ failures 1))))))
            (jit/release! (mut image)))))
      (backend/module-release-callees! mp))
    (cir/func-free! fp)
    (asm/asm-free! ta)
    (free! (mut offsets)) (free! (mut text-data))
    (close! storage)
    (println "deferred Stogir graph lifetime: {} failures" failures)
    (if (= failures 0) 0 1)))
