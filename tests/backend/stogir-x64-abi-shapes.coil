;;; System V shapes of CIR the Stogir adapter gives the library on x86-64:
;;;   - a function with an indirect result returns its result pointer in CIR
;;;     (`ret` of the sret parameter); the library's indirect result does that
;;;     itself, so the adapted RETURN carries no value;
;;;   - a MEMORY-class argument (BYVAL with its size) is the library's ARGVAL of
;;;     that size, 8-aligned, typed as an address in the prototype.
;;; Only the adaptation is checked (the graph the library receives), not code.
;;;
;;; x86-64 only; prints "skipped" elsewhere. Exits with the number of failures.
(module coil.compiler.stogir-x64-abi-shapes)
(import "coil.compiler.codegen_stogir" :as backend)
(import "coil.compiler.macho" :use [MTextData])
(import "tpde.cir" :as cir)
(import "tpde.asm" :as asm)
(import "stogir.target" :as machine)
(import "stogir.graph" :as graph)
(import "stogir.node" :as node)
(import "stogir.calls" :as calls)
(import "coil.primitive" :as p)
(import "coil.alloc" :use [malloc-allocator])
(import "coil.arraylist" :use [ArrayList])
(import "coil.result" :use [Ok Err])

;;; How many nodes of G have OPCODE, and the last one found.
(defstruct Found [(count i64) (last node/Node)])

(defn find [(g graph/Graph) (opcode u8)] (-> Found)
  (let [(mut found) (Found :count 0 :last (get (.instructions g) 0))
        (mut r) (: 1 i64)]
    (while (< r (len (.instructions g)))
      (let [n (get (.instructions g) r)
            count (get (.arities g) r)]
        (when (= (node/opcode n) opcode)
          (set! (.count found) (+ (.count found) 1))
          (set! (.last found) n))
        (set! r (+ r (/ (+ (cast i64 count) 4) 4)))))
    found))

(defn wrong [(what (slice u8)) (good bool)] (-> i64)
  (if good 0 (do (println "FAILED: {}" what) 1)))

;;; (defn f [sret x] ...) storing x through sret and returning sret.
(defn indirect-result [(ta (ptr asm/Asm))] (-> i64)
  (let [a (malloc-allocator)
        (mut func) (cir/Func::new)
        fp (p/cast (ptr cir/Func) (mut func))
        (mut state) (zeroed backend/Adapter)
        s (p/cast (ptr backend/Adapter) (mut state))]
    (set! (.name func) "shapes.indirect")
    (cir/set-block! fp (cir/new-block! fp))
    (let [result (cir/arg! fp cir/T-I64 true)
          x (cir/arg! fp cir/T-I64 false)]
      (cir/store-mem! fp result x 0 8)
      (cir/ret1! fp result))
    (cir/finish! fp)
    (backend/adapt! s fp ta (p/cast (ptr (ArrayList MTextData)) 0) a)
    (let [returns (find (.g s) 120)
          failures
            (+ (wrong "the function has an indirect result" (.indirect-result s))
               (wrong "one RETURN" (= (.count returns) 1))
               (wrong "the RETURN is void" (= (node/type-id (.last returns)) 0))
               (wrong "the RETURN carries no value" (= (.op2 (.last returns)) 0))
               (wrong "the prototype has an indirect result"
                      (match (calls/function-result (.g s))
                        (Ok [spec] (= (.kind spec) 2))
                        (Err [_] false))))]
      (cir/func-free! fp)
      failures)))

;;; A call passing a 24-byte MEMORY-class aggregate and one word.
(defn memory-argument [(ta (ptr asm/Asm))] (-> i64)
  (let [a (malloc-allocator)
        (mut func) (cir/Func::new)
        fp (p/cast (ptr cir/Func) (mut func))
        (mut args) (ArrayList::new [u32] a)
        (mut flags) (ArrayList::new [u32] a)
        (mut types) (ArrayList::new [u8] a)
        (mut state) (zeroed backend/Adapter)
        s (p/cast (ptr backend/Adapter) (mut state))
        callee (asm/sym-add-undef! ta "_shapes_callee" (: 1 u8))]
    (set! (.name func) "shapes.memory")
    (cir/set-block! fp (cir/new-block! fp))
    (let [aggregate (cir/arg-flagged! fp cir/T-I64 false (p/cast u32 cir/AF-ADDRESS))
          x (cir/arg! fp cir/T-I64 false)]
      (push! (mut args) aggregate)
      (push! (mut flags) (cir/af-byval 24))
      (push! (mut args) x)
      (push! (mut flags) 0)
      (push! (mut types) (cast u8 cir/T-I64))
      (let [call (cir/call! fp callee (cir/none)
                            (p/cast (ptr (ArrayList u32)) (mut args))
                            (p/cast (ptr (ArrayList u32)) (mut flags))
                            (p/cast (ptr (ArrayList u8)) (mut types)) false)]
        (cir/ret1! fp call)))
    (cir/finish! fp)
    (backend/adapt! s fp ta (p/cast (ptr (ArrayList MTextData)) 0) a)
    (let [copies (find (.g s) 70)
          call (find (.g s) 79)
          failures
            (+ (wrong "one ARGVAL" (= (.count copies) 1))
               (wrong "the ARGVAL copies 24 bytes" (= (.op2 (.last copies)) 24))
               (wrong "the ARGVAL is 8-aligned" (= (.op3 (.last copies)) 8))
               (wrong "one CALL" (= (.count call) 1)))]
      (cir/func-free! fp)
      (free! (mut args)) (free! (mut flags)) (free! (mut types))
      failures)))

(defn run [] (-> i64)
  (let [(mut assembler) (asm/Asm::new)
        ta (p/cast (ptr asm/Asm) (mut assembler))
        failures (+ (indirect-result ta) (memory-argument ta))]
    (asm/asm-free! ta)
    (println "stogir x64 abi shapes: {} failures" failures)
    failures))

(defn main [] (-> i64)
  (machine/arch-pick (do (println "stogir x64 abi shapes: skipped (not x86-64)") 0)
                     (run)))
