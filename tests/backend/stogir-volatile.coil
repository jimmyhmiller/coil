;;; Volatile accesses must reach machine code one for one. Each function below
;;; is compiled out of line; scripts/tests/stogir-volatile.py counts the loads
;;; and stores in its body, and main checks the values.
(module tests.backend.stogir-volatile)
(import "coil.primitive" :as primitive)

(defstruct Device [(status i64) (data i64) (control i64) (wide i128)])

;;; A device register polled n times: one load each time round.
(defn poll :inline (Never) [(device (ptr Device)) (n i64)] (-> i64)
  (let [(mut seen) 0]
    (for [i 0 n]
      (set! seen (+ seen (primitive/volatile-load i64 (primitive/field device status)))))
    seen))

;;; Spinning until the register is nonzero: one load each time round.
(defn spin :inline (Never) [(device (ptr Device))] (-> i64)
  (let [(mut turns) 0]
    (while (= (primitive/volatile-load i64 (primitive/field device status)) 0)
      (set! turns (+ turns 1)))
    turns))

;;; Two reads of one register: two loads.
(defn twice :inline (Never) [(device (ptr Device))] (-> i64)
  (let [first (primitive/volatile-load i64 (primitive/field device data))
        second (primitive/volatile-load i64 (primitive/field device data))]
    (+ first second)))

;;; Reads of neighbouring registers: two loads, not one paired load.
(defn neighbours :inline (Never) [(device (ptr Device))] (-> i64)
  (+ (primitive/volatile-load i64 (primitive/field device status))
     (primitive/volatile-load i64 (primitive/field device data))))

;;; A read whose value is not used: one load.
(defn acknowledge :inline (Never) [(device (ptr Device))] (-> i64)
  (primitive/volatile-load i64 (primitive/field device status))
  5)

;;; A volatile store and then an ordinary one to the same register: two stores.
(defn command :inline (Never) [(device (ptr Device)) (value i64)] (-> void)
  (primitive/volatile-store! (primitive/field device control) value)
  (set! (.control device) (+ value 1)))

;;; Two volatile stores to one register: two stores.
(defn pulse :inline (Never) [(device (ptr Device)) (value i64)] (-> void)
  (primitive/volatile-store! (primitive/field device control) value)
  (primitive/volatile-store! (primitive/field device control) 0))

;;; Volatile stores to neighbouring registers: two stores, not one paired store.
(defn configure :inline (Never) [(device (ptr Device)) (value i64)] (-> void)
  (primitive/volatile-store! (primitive/field device data) value)
  (primitive/volatile-store! (primitive/field device control) (+ value 1)))

;;; Written and read back: one store and one load, the value not forwarded.
(defn echo :inline (Never) [(device (ptr Device)) (value i64)] (-> i64)
  (primitive/volatile-store! (primitive/field device data) value)
  (primitive/volatile-load i64 (primitive/field device data)))

;;; Read only when asked: the load is not made ahead of the test.
(defn maybe :inline (Never) [(device (ptr Device)) (ask bool)] (-> i64)
  (if ask (primitive/volatile-load i64 (primitive/field device status)) 7))

;;; A 128-bit register: both halves loaded each time, and both stored.
(defn wide-twice :inline (Never) [(device (ptr Device))] (-> i128)
  (+ (primitive/volatile-load i128 (primitive/field device wide))
     (primitive/volatile-load i128 (primitive/field device wide))))

(defn wide-set :inline (Never) [(device (ptr Device)) (value i128)] (-> void)
  (primitive/volatile-store! (primitive/field device wide) value)
  (primitive/volatile-store! (primitive/field device wide) (+ value 1)))

;;; A callee that reads a register is called each time: its reads are not
;;; taken for repeatable.
(defn status-of :inline (Never) [(device (ptr Device))] (-> i64)
  (primitive/volatile-load i64 (primitive/field device status)))

(defn called-twice :inline (Never) [(device (ptr Device))] (-> i64)
  (+ (status-of device) (status-of device)))

;;; The same reads inlined into a loop stay in the loop.
(defn status-inline :inline (Always) [(device (ptr Device))] (-> i64)
  (primitive/volatile-load i64 (primitive/field device status)))

(defn poll-inlined :inline (Never) [(device (ptr Device)) (n i64)] (-> i64)
  (let [(mut seen) 0]
    (for [i 0 n] (set! seen (+ seen (status-inline device))))
    seen))

(defn expect [(label (slice u8)) (got i64) (want i64)] (-> i64)
  (if (= got want)
      0
      (do (println "{}: got {}, expected {}" label got want) 1)))

(defn main [] (-> i64)
  (let [(mut registers) (Device :status 3 :data 11 :control 0 :wide 5)
        device (primitive/cast (ptr Device) (mut registers))
        (mut failures) 0]
    (set! failures (+ failures (expect "poll" (poll device 10) 30)))
    (set! failures (+ failures (expect "poll none" (poll device 0) 0)))
    (set! failures (+ failures (expect "spin" (spin device) 0)))
    (set! failures (+ failures (expect "twice" (twice device) 22)))
    (set! failures (+ failures (expect "neighbours" (neighbours device) 14)))
    (set! failures (+ failures (expect "acknowledge" (acknowledge device) 5)))
    (command device 40)
    (set! failures (+ failures (expect "command" (.control device) 41)))
    (pulse device 9)
    (set! failures (+ failures (expect "pulse" (.control device) 0)))
    (configure device 60)
    (set! failures (+ failures (expect "configure data" (.data device) 60)))
    (set! failures (+ failures (expect "configure control" (.control device) 61)))
    (set! failures (+ failures (expect "echo" (echo device 77) 77)))
    (set! failures (+ failures (expect "maybe yes" (maybe device true) 3)))
    (set! failures (+ failures (expect "maybe no" (maybe (primitive/cast (ptr Device) 0) false) 7)))
    (set! failures (+ failures (expect "wide twice" (cast i64 (wide-twice device)) 10)))
    (wide-set device (<< (: 1 i128) 70))
    (set! failures (+ failures (expect "wide set low" (cast i64 (.wide device)) 1)))
    (set! failures (+ failures (expect "wide set high" (cast i64 (>> (.wide device) 64)) 64)))
    (set! failures (+ failures (expect "called twice" (called-twice device) 6)))
    (set! failures (+ failures (expect "poll inlined" (poll-inlined device 7) 21)))
    (println "stogir volatile: {} failures" failures)
    failures))
