(module synctest)
(import "coil.primitive" :as primitive)
(import "coil.alloc" :as alloc)
(import "coil.sync" :as sync)
(import "coil.time" :as time)

(defn once-body [] (-> i64)
  (let [calls (primitive/alloc-static i64)]
    (store! calls (+ (load calls) 1))
    (if (= (load calls) 1) 0 99)))

(defn main [(argc i32) (argv (ptr (ptr i8)))] (-> i64)
  (let [event (primitive/alloc-stack sync/Event)]
    (match (sync/event-init event)
      (Err [_] 1)
      (Ok [_]
          (match (sync/event-generation event)
            (Err [_] 2)
            (Ok [observed]
                (match (time/duration-millis 1)
                  (Err [_] 3)
                  (Ok [short]
                      (match (sync/event-wait-for! event observed short)
                        (Err [_] 4)
                        (Ok [first]
                            (match first
                              (sync/Notified [_] 5)
                              (sync/Timeout []
                                            (match (sync/event-notify-all! event)
                                              (Err [_] 6)
                                              (Ok [_]
                                                  (match (sync/event-wait-for! event observed short)
                                                    (Err [_] 7)
                                                    (Ok [second]
                                                        (let [result
                                                                (match second
                                                                  (sync/Timeout [] 8)
                                                                  (sync/Notified [generation]
                                                                                 (if (= generation (+ observed 1)) 0 9)))]
                                                          (sync/event-destroy! event)
                                                          (if (!= result 0)
                                                              result
                                                              (let [once (primitive/alloc-stack sync/Once)]
                                                                (match (sync/once-init once)
                                                                  (Err [_] 10)
                                                                  (Ok [_]
                                                                      (match (sync/once-call! once
                                                                                              (primitive/fnptr-of once-body))
                                                                        (Err [_] 11)
                                                                        (Ok [_]
                                                                            (match (sync/once-call! once
                                                                                                    (primitive/fnptr-of once-body))
                                                                              (Err [_] 12)
                                                                              (Ok [_]
                                                                                  (do
                                                                                    (sync/once-destroy! once)
                                                                                    0))))))))))))))))))))))))))
