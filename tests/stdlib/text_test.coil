(module stdlib-tests.text)
(import "coil.primitive" :as primitive)
(import "coil.alloc" :use [free malloc-allocator])
(import "coil.assert" :use *)
(import "coil.hashmap" :as map)
(import "coil.str" :as string :use [Rune sv])
(import "coil.regex" :as re)
(import "coil.unicode" :as u)
(import "stdlib-tests.unicode-conformance" :as ucd)

; ==== UTF-8 views, owned strings and string-keyed maps ====

(deftest string-view-validates-utf8
  (match (string/string-view-from-utf8 "coil \x1f603;.")
    (Err [e] (assert false))
    (Ok [view]
        (do
          (assert-eq (string/string-view-byte-len view) 10)
          (assert (= view
                     (string/string-view-unchecked "coil \x1f603;.")))))))

(deftest sv-is-a-zero-validation-literal-constructor
  (let [view (string/sv "literal \x3bb;")]
    (assert (= view (string/string-view-unchecked "literal \x3bb;")))))

(deftest string-view-rejects-invalid-utf8
  (match (string/string-view-from-utf8 [(primitive/cast u8 192)
                                        (primitive/cast u8 128)])
    (Ok [view] (assert false))
    (Err [e]
         (do
           (assert-eq (string/utf8-error-offset e) 0)
           (assert-eq (string/utf8-error-len e) 1)))))

(deftest string-view-rejects-surrogates-and-truncation
  (do
    (match (string/string-view-from-utf8 [(primitive/cast u8 237)
                                          (primitive/cast u8 160)
                                          (primitive/cast u8 128)])
      (Ok [view] (assert false))
      (Err [e] (assert-eq (string/utf8-error-offset e) 0)))
    (match (string/string-view-from-utf8 [(primitive/cast u8 240)
                                          (primitive/cast u8 159)
                                          (primitive/cast u8 146)])
      (Ok [view] (assert false))
      (Err [e] (assert-eq (string/utf8-error-offset e) 0)))))

(deftest string-view-iterates-unicode-scalars
  (let [view (string/string-view-unchecked "A\x3bb;\x1f603;")
        (mut it) (iter view)]
    (match (next (mut it))
      (None [] (assert false))
      (Some [r] (assert-eq (string/rune-value r) 65)))
    (match (next (mut it))
      (None [] (assert false))
      (Some [r] (assert-eq (string/rune-value r) 955)))
    (match (next (mut it))
      (None [] (assert false))
      (Some [r] (assert-eq (string/rune-value r) 128515)))
    (match (next (mut it))
      (None [] (assert true))
      (Some [r] (assert false)))))

(deftest owned-string-appends-clones-and-frees
  (let [a (malloc-allocator)
        (mut text)
          (string/string-from-view a
                                   (string/string-view-unchecked "hello"))]
    (string/string-push-view! (mut text)
                              (string/string-view-unchecked " "))
    (match (string/rune-new (primitive/cast u32 955))
      (None [] (assert false))
      (Some [r] (string/string-push-rune! (mut text) r)))
    (assert (= (string/string-as-view (load text))
               (string/string-view-unchecked "hello \x3bb;")))
    (let [(mut copy) (string/string-clone a (load text))]
      (assert (= (load text) (load copy)))
      (string/string-clear! (mut text))
      (assert (string/string-view-empty? (string/string-as-view (load text))))
      (assert (= (string/string-as-view (load copy))
                 (string/string-view-unchecked "hello \x3bb;")))
      (string/string-free! (mut copy)))
    (string/string-free! (mut text))))

(deftest string-indices-only-accept-scalar-boundaries
  (let [view (string/string-view-unchecked "a\x3bb;b")]
    (match (string/string-index-at-byte view 1)
      (None [] (assert false))
      (Some [i] (assert-eq (string/string-index-byte-offset i) 1)))
    (match (string/string-index-at-byte view 2)
      (None [] (assert true))
      (Some [i] (assert false)))
    (match (string/string-index-at-byte view 3)
      (None [] (assert false))
      (Some [i] (assert-eq (string/string-index-byte-offset i) 3)))))

(deftest string-view-search-returns-boundary-indices
  (let [view (string/string-view-unchecked "a\x3bb;-coil")
        needle (string/string-view-unchecked "coil")]
    (assert (string/string-view-starts-with? view
                                             (string/string-view-unchecked "a\x3bb;")))
    (assert (string/string-view-ends-with? view needle))
    (assert (string/string-view-contains? view needle))
    (match (string/string-view-find view needle)
      (None [] (assert false))
      (Some [index]
            (assert-eq (string/string-index-byte-offset index) 4)))))

(deftest owned-string-validates-input-and-transfers-ownership
  (let [a (malloc-allocator)]
    (match (string/string-from-utf8 a "owned")
      (Err [error] (assert false))
      (Ok [created]
          (let [(mut source) created
                (mut taken) (string/string-take! (mut source))]
            (assert (string/string-view-empty? (string/string-as-view (load source))))
            (assert (= (string/string-as-view (load taken))
                       (string/string-view-unchecked "owned")))
            (string/write-view! (mut taken)
                                (string/string-view-unchecked " text"))
            (let [bytes (string/string-into-bytes! (mut taken))]
              (assert (string/str-eq bytes "owned text"))
              (free [u8] a bytes))
            (string/string-free! (mut taken))
            (string/string-free! (mut source)))))))

(deftest string-view-trim-and-split-are-borrowed
  (let [trimmed
          (string/string-view-trim-ascii (string/string-view-unchecked " \talpha::\x3bb;:: \n"))
        (mut parts)
          (string/string-view-split trimmed
                                    (string/string-view-unchecked "::"))]
    (assert (= trimmed (string/string-view-unchecked "alpha::\x3bb;::")))
    (match (next (mut parts))
      (None [] (assert false))
      (Some [part]
            (assert (= part (string/string-view-unchecked "alpha")))))
    (match (next (mut parts))
      (None [] (assert false))
      (Some [part]
            (assert (= part (string/string-view-unchecked "\x3bb;")))))
    (match (next (mut parts))
      (None [] (assert false))
      (Some [part] (assert (string/string-view-empty? part))))
    (match (next (mut parts))
      (None [] (assert true))
      (Some [part] (assert false)))))

(deftest owned-string-capacity-remove-truncate-and-pop
  (let [a (malloc-allocator)
        (mut text) (string/string-from-view a (string/sv "a\x3bb;\x1f603;z"))]
    (string/string-reserve! (mut text) 64)
    (assert (>= (string/string-capacity (load text)) 64))
    (let [view (string/string-as-view (load text))]
      (match (string/string-index-at-byte view 1)
        (None [] (assert false))
        (Some [lo]
              (match (string/string-index-at-byte view 3)
                (None [] (assert false))
                (Some [hi]
                      (assert-eq (string/string-remove! (mut text) lo hi)
                                 6))))))
    (assert (= (string/string-as-view (load text))
               (string/sv "a\x1f603;z")))
    (match (string/string-index-at-byte (string/string-as-view (load text))
                                        5)
      (None [] (assert false))
      (Some [end] (assert-eq (string/string-truncate! (mut text) end) 5)))
    (assert (= (string/string-as-view (load text))
               (string/sv "a\x1f603;")))
    (match (string/string-pop-rune! (mut text))
      (None [] (assert false))
      (Some [rune] (assert-eq (string/rune-value rune) 128515)))
    (match (string/string-pop-rune! (mut text))
      (None [] (assert false))
      (Some [rune] (assert-eq (string/rune-value rune) 97)))
    (match (string/string-pop-rune! (mut text))
      (None [] (assert true))
      (Some [rune] (assert false)))
    (string/string-free! (mut text))))

(deftest string-view-map-keys-own-their-bytes
  (let [a (malloc-allocator)
        (mut source) (string/string-from-view a (string/sv "key"))
        (mut table)
          (map/HashMap::new [string/StringView i64]
                            a
                            (string/string-view-keyops))]
    (set! (mut table)
          (string/string-as-view (load source))
          42)
    (string/string-clear! (mut source))
    (match (get (load table)
                (string/sv "key"))
      (None [] (assert false))
      (Some [value] (assert-eq value 42)))
    (free! (mut table))
    (string/string-free! (mut source))))

(deftest owned-string-map-keys-are-cloned
  (let [a (malloc-allocator)
        (mut key) (string/string-from-view a (string/sv "owned-key"))
        (mut lookup) (string/string-from-view a (string/sv "owned-key"))
        (mut table)
          (map/HashMap::new [string/String i64] a (string/string-keyops-owned))]
    (set! (mut table) (load key) 7)
    (string/string-clear! (mut key))
    (match (get (load table) (load lookup))
      (None [] (assert false))
      (Some [value] (assert-eq value 7)))
    (free! (mut table))
    (string/string-free! (mut lookup))
    (string/string-free! (mut key))))

; ==== compile-time regex: is-match? syntax, flags and anchors ====

(defn regex-counted [(calls (ptr i64))] (-> (slice u8))
  (store! calls (+ (load calls) 1))
  "xxabbbczz")

(defn regex-main [] (-> i64)
  (assert (re/is-match? "abc" "--abc--"))
  (assert (re/is-match? "dws" "--dws--"))
  (assert (re/is-match? "\\$" "cost: $5"))
  (assert (not (re/is-match? "abc" "ab")))
  (assert (re/is-match? "^abc$" "abc"))
  (assert (not (re/is-match? "^abc$" "xabc")))
  (assert (re/is-match? "b|c" "b"))
  (assert (re/is-match? "b|c" "c"))
  (assert (re/is-match? "(b|c)+" "bcbc"))
  (assert (re/is-match? "a(b|c)+d" "abcd"))
  (assert (re/is-match? "a(b|c)+d" "abcbcd"))
  (assert (re/is-match? "a(b|c)+d" "--abcbcd--"))
  (assert (re/is-match? "colou?r" "color"))
  (assert (re/is-match? "colou?r" "colour"))
  (assert (re/is-match? "[A-Za-z_][A-Za-z0-9_]*" "__coil42"))
  (assert (not (re/is-match? "^[^0-9]+$" "abc7")))
  (assert (re/is-match? "^\\d+\\s\\w+$" "42 coil_7"))
  (assert (re/is-match? "a.*z" "a line z"))
  (assert (not (re/is-match? "a.*z" "a\nz")))
  (assert (re/is-match? "(?:ab|cd)+" "--abcdab--"))
  (assert (re/is-match? "a{3}" "--aaa--"))
  (assert (not (re/is-match? "^a{3}$" "aa")))
  (assert (re/is-match? "^(ab){2,4}$" "ababab"))
  (assert (not (re/is-match? "^(ab){2,4}$" "ab")))
  (assert (re/is-match? "^a{2,}$" "aaaaa"))
  (assert (re/is-match? "^a{0}$" ""))
  (assert (re/is-match? "^a{0,2}$" "aa"))
  (assert (re/is-match? "a+?b" "--aaab--"))
  (assert (re/is-match? "a{2,4}?b" "--aaaab--"))
  (assert (re/is-match? "\\x41\\x42" "--AB--"))
  (assert (re/is-match? "[\\x41-\\x43]+" "--ABC--"))
  (assert (re/is-match? "^\\D+\\S$" "coil!"))
  (assert (not (re/is-match? "^\\W+$" "not_all_punctuation")))
  (assert (re/is-match? "(^abc|xyz$)" "--xyz"))
  (assert (re/is-match? "(^abc|xyz$)" "abc--"))
  (assert (not (re/is-match? "a(^b)" "ab")))
  (assert (re/is-match? "\\bcat\\b" "a cat!"))
  (assert (not (re/is-match? "\\bcat\\b" "scatter")))
  (assert (re/is-match? "\\Bcat\\B" "scatter"))
  (assert (re/is-match? "(?i:coil)" "--CoIl--"))
  (assert (re/is-match? "(?i:[a-f]+)" "--AbCdEf--"))
  (assert (not (re/is-match? "(?i:coil)" "cold")))
  (assert (re/is-match? "(?s:a.*z)" "a\nz"))
  (assert (re/is-match? "(?m:^coil$)" "before\ncoil\nafter"))
  (assert (re/is-match? "(?is:^a.*z$)" "A\nZ"))
  ; Required-byte analysis must not mistake a byte on only one alternative for
  ; a byte that every successful path consumes.
  (assert (re/is-match? "aZ|bY" "--bY--"))
  (assert (re/is-match? "Z?abc" "--abc--"))
  (assert (not (re/is-match? "[A-Za-z]+Z" "onlyletters")))
  (assert (re/is-match? "a*" ""))
  ; `^` and `$` at the ends of the pattern bind to their own alternative only.
  (assert (re/is-match? "^a|b" "xb"))
  (assert (re/is-match? "a|b$" "ax"))
  (assert (not (re/is-match? "^a|b$" "xax")))
  (assert (re/is-match? "^$" ""))
  (assert (not (re/is-match? "^$" "x")))
  (let [(mut calls) 0]
    (assert (re/is-match? "ab+c" (regex-counted (mut calls))))
    (assert-eq (load calls) 1))
  0)

(deftest regex-is-match-syntax-flags-and-anchors
  (assert-eq (regex-main) 0))

; ==== compile-time regex: find, captures and their iterators ====

;; Compile-time regex: each `re/...` call compiles its pattern while the program
;; is compiled, into a matcher specialized for it. find and captures expand to
;; tens of KB per call site, so these cases are the representative ones; the
;; differential test against a reference matcher (regex_reference_test.coil)
;; covers the semantics in depth in the comprehensive tier.

(defn span [(start i64) (end i64)] (-> (Option re/Span))
  (Some (re/Span :start start :end end)))

(defn same? [(got (Option re/Span)) (want (Option re/Span))] (-> bool)
  (let [ok
          (match got
            (Some [g]
                  (match want
                    (Some [w] (= g w))
                    (None [] false)))
            (None []
                  (match want
                    (Some [w] false)
                    (None [] true))))]
    (when (not ok) (println "got {:?}, want {:?}" got want))
    ok))

(defn group-of [(const N i64)] [(caps (Option (re/Captures N))) (i i64)]
  (-> (Option re/Span))
  (match caps
    (Some [c] (re/group c i))
    (None [] (None))))

(defn counted [(calls (ptr i64))] (-> (slice u8))
  (store! calls (+ (load calls) 1))
  "xxabbbczz")

(defn unwrap [(o (Option (slice u8)))] (-> (slice u8))
  (match o
    (Some [b] b)
    (None [] "<none>")))

(deftest find-literals-anchors-and-offsets
  (assert (same? (re/find "abc" "--abc--abc") (span 2 5)))
  (assert (same? (re/find "abc" "--ab-") (None)))
  (assert (same? (re/find "^ab" "xab") (None)))
  (assert (same? (re/find "ab$" "abab") (span 2 4)))
  (assert (same? (re/find-at "abc" "abcabc" 1) (span 3 6)))
  (assert (same? (re/find-at "" "abc" 4) (None))))

(deftest find-is-leftmost-first
  ; Leftmost-first (Perl, RE2, Rust), not leftmost-longest (POSIX).
  (assert (same? (re/find "a|ab" "ab") (span 0 1)))
  (assert (same? (re/find "ab|a" "ab") (span 0 2)))
  ; The leftmost start wins over a longer match further right.
  (assert (same? (re/find "b+|aaaa" "xbaaaa") (span 1 2)))
  ; Greedy and lazy quantifiers select different spans.
  (assert (same? (re/find "<.*>" "<a><b>") (span 0 6)))
  (assert (same? (re/find "<.*?>" "<a><b>") (span 0 3)))
  (assert (same? (re/find "a{2,4}?" "aaaaa") (span 0 2))))

(deftest find-assertions-and-flags
  (assert (same? (re/find "\\bcat\\b" "concat cat") (span 7 10)))
  (assert (same? (re/find "(?m:^\\w+$)" "one\ntwo") (span 0 3)))
  (assert (same? (re/find "(?i:hello)" "say HeLLo") (span 4 9)))
  (assert (same? (re/find "(?s:a.c)" "a\nc abc") (span 0 3)))
  ; `\b` looks at the byte before the start offset.
  (assert (same? (re/find-at "\\Bcat" "concat cat" 3) (span 3 6))))

(deftest find-past-the-bit-parallel-limit
  ; is-match? keeps one state per bit of a word; find allows 256 states.
  (assert (same? (re/find "x{100}"
                          "--xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx--")
                 (span 2 102))))

(deftest find-evaluates-the-haystack-once
  (let [(mut calls) 0]
    (assert (same? (re/find "ab+c" (counted (mut calls))) (span 2 7)))
    (assert-eq (load calls) 1)
    (assert (same? (group-of (re/captures "(b)" (counted (mut calls))) 1)
                   (span 3 4)))
    (assert-eq (load calls) 2)))

(deftest captures-number-groups-and-track-participation
  ; Groups are numbered by their opening parenthesis; (d)? did not take part.
  (let [caps (re/captures "((a)(b))(?:c)(d)?" "abc")]
    (assert (same? (group-of caps 0) (span 0 3)))
    (assert (same? (group-of caps 1) (span 0 2)))
    (assert (same? (group-of caps 3) (span 1 2)))
    (assert (same? (group-of caps 4) (None))))
  ; A repeated group reports its last iteration.
  (assert (same? (group-of (re/captures "(a|b)+" "abab") 1) (span 3 4)))
  ; Leftmost-first alternation chooses which groups participate.
  (let [caps (re/captures "(a|ab)(c|bcd)(d*)" "abcd")]
    (assert (same? (group-of caps 1) (span 0 1)))
    (assert (same? (group-of caps 2) (span 1 4)))
    (assert (same? (group-of caps 3) (span 4 4))))
  ; A loop iteration that matches empty is not taken (RE2's rule).
  (assert (same? (group-of (re/captures "(a*)*" "b") 1) (None))))

(deftest captures-split-a-log-line
  (let [line
          "10.0.0.7 - - [11/Oct/2026:10:00:00 +0000] \"GET /index.html HTTP/1.1\" 200 512 0.003"
        caps
          (re/captures "^(\\S+) - - \\[([^\\]]+)\\] \"(\\S+) (\\S+) (\\S+)\" (\\d+) (\\d+) ([\\d.]+)$"
                       line)]
    (match caps
      (Some [c]
            (do
              (assert-eq (re/group-count c) 9)
              (assert (= (unwrap (re/group-bytes c line 1)) "10.0.0.7"))
              (assert (= (unwrap (re/group-bytes c line 2))
                         "11/Oct/2026:10:00:00 +0000"))
              (assert (= (unwrap (re/group-bytes c line 4))
                         "/index.html"))
              (assert (= (unwrap (re/group-bytes c line 8)) "0.003"))
              (assert (same? (re/group c 9) (None)))))
      (None [] (assert false)))))

(deftest find-iter-is-non-overlapping-and-skips-abutting-empty-matches
  (let [(mut it) (re/find-iter "\\d+" "a1 22 333 b")]
    (assert (same? (next (mut it)) (span 1 2)))
    (assert (same? (next (mut it)) (span 3 5)))
    (assert (same? (next (mut it)) (span 6 9)))
    (assert (same? (next (mut it)) (None))))
  (assert-eq (fold (fn [acc s] (+ acc (re/span-len s)))
                   0
                   (re/find-iter "[a-z]+" "ab cde f"))
             6)
  ; After an empty match the search resumes one byte later (RE2, Go, Rust).
  (let [(mut it) (re/find-iter "a*" "baaab")]
    (assert (same? (next (mut it)) (span 0 0)))
    (assert (same? (next (mut it)) (span 1 4)))
    (assert (same? (next (mut it)) (span 5 5)))
    (assert (same? (next (mut it)) (None)))))

(deftest captures-iter-yields-each-match-with-its-groups
  (let [hay "x=1 y= z=33"
        (mut it) (re/captures-iter "(\\w+)=(\\d+)?" hay)]
    (match (next (mut it))
      (Some [c] (assert (same? (re/group c 2) (span 2 3))))
      (None [] (assert false)))
    (match (next (mut it))
      (Some [c] (assert (same? (re/group c 2) (None))))
      (None [] (assert false)))
    (match (next (mut it))
      (Some [c] (assert (same? (re/group c 2) (span 9 11))))
      (None [] (assert false)))
    (assert (match (next (mut it)) (Some [c] false) (None [] true)))))

; ==== Unicode properties, case mapping and folding ====

(defn rune [(value u32)] (-> Rune)
  (Rune :value value))

(defn cat [(value u32)] (-> (slice u8))
  (u/general-category-abbrev (u/general-category (rune value))))

(defn lower [(value u32)] (-> u32)
  (string/rune-value (u/to-lower (rune value))))

(defn upper [(value u32)] (-> u32)
  (string/rune-value (u/to-upper (rune value))))

(defn title [(value u32)] (-> u32)
  (string/rune-value (u/to-title (rune value))))

(defn folded [(value u32)] (-> u32)
  (string/rune-value (u/case-fold (rune value))))

(defn same-text? [(s string/String) (expected (slice u8))] (-> bool)
  (let [ok (= (string/string-view-bytes (string/string-as-view s)) expected)]
    (when (not ok)
      (println "got {:?}, want {:?}"
               (string/string-view-bytes (string/string-as-view s))
               expected))
    ok))

(deftest version-is-recorded
  (assert (= (u/unicode-version) "17.0.0")))

(deftest general-categories-across-scripts
  (assert (= (cat 0x41) "Lu"))
  (assert (= (cat 0x61) "Ll"))
  (assert (= (cat 0x1C5) "Lt"))
  (assert (= (cat 0x2B0) "Lm"))
  (assert (= (cat 0x4E2D) "Lo"))
  (assert (= (cat 0x301) "Mn"))
  (assert (= (cat 0x903) "Mc"))
  (assert (= (cat 0x20DD) "Me"))
  (assert (= (cat 0x663) "Nd"))
  (assert (= (cat 0x216B) "Nl"))
  (assert (= (cat 0xBD) "No"))
  (assert (= (cat 0x5F) "Pc"))
  (assert (= (cat 0x2D) "Pd"))
  (assert (= (cat 0x28) "Ps"))
  (assert (= (cat 0x29) "Pe"))
  (assert (= (cat 0xAB) "Pi"))
  (assert (= (cat 0xBB) "Pf"))
  (assert (= (cat 0x21) "Po"))
  (assert (= (cat 0x2B) "Sm"))
  (assert (= (cat 0x20AC) "Sc"))
  (assert (= (cat 0x5E) "Sk"))
  (assert (= (cat 0xA9) "So"))
  (assert (= (cat 0x20) "Zs"))
  (assert (= (cat 0x2028) "Zl"))
  (assert (= (cat 0x2029) "Zp"))
  (assert (= (cat 0x7) "Cc"))
  (assert (= (cat 0x200B) "Cf"))
  (assert (= (cat 0xE000) "Co"))
  (assert (= (cat 0x378) "Cn"))
  ; Supplementary planes.
  (assert (= (cat 0x10400) "Lu"))
  (assert (= (cat 0x1D400) "Lu"))
  (assert (= (cat 0x1F600) "So"))
  (assert (= (cat 0x20000) "Lo"))
  (assert (= (cat 0xE0001) "Cf"))
  (assert (= (cat 0xF0000) "Co"))
  (assert (= (cat 0x10FFFF) "Cn"))
  (assert (= (u/general-category (rune 0x41)) (u/UppercaseLetter)))
  (assert (= (u/general-category (rune 0x10FFFF)) (u/Unassigned))))

(deftest letters-in-many-scripts
  ; The word-frequency case: one predicate instead of hand-listed ranges.
  (for value [0x61 0x5A 0xE9 0x3B1 0x3A9 0x436 0x531 0x5D0 0x627 0x915 0xE01
              0x3042 0x30AB 0xAC00 0x4E2D 0x10D0 0x13A0 0x1200 0x10400 0x1D400]
    (assert (u/letter? (rune (cast u32 value))))
    (assert (u/alphabetic? (rune (cast u32 value))))
    (assert (u/alphanumeric? (rune (cast u32 value)))))
  (for value [0x30 0x663 0x2D 0x20 0x21 0x1F600 0x301 0x200B 0x378]
    (assert (not (u/letter? (rune (cast u32 value))))))
  ; Alphabetic is wider than the letter categories.
  (assert (u/alphabetic? (rune 0x345)))
  (assert (not (u/letter? (rune 0x345))))
  (assert (u/alphabetic? (rune 0x216B)))
  (assert (u/mark? (rune 0x301)))
  (assert (u/punctuation? (rune 0xBF)))
  (assert (u/symbol? (rune 0x20AC)))
  (assert (u/control? (rune 0x0)))
  (assert (not (u/control? (rune 0x200B)))))

(deftest numbers-and-digits
  (for value [0x30 0x39 0x663 0x966 0xFF15 0x1D7CE]
    (assert (u/decimal-digit? (rune (cast u32 value))))
    (assert (u/numeric? (rune (cast u32 value))))
    (assert (u/number? (rune (cast u32 value)))))
  ; Numeric without being a decimal digit: fractions, Roman numerals, CJK numerals.
  (for value [0xBD 0x216B 0x4E94 0x2460]
    (assert (u/numeric? (rune (cast u32 value))))
    (assert (not (u/decimal-digit? (rune (cast u32 value))))))
  (assert (u/letter? (rune 0x4E94)))
  (assert (not (u/number? (rune 0x4E94))))
  (assert (not (u/numeric? (rune 0x41)))))

(deftest whitespace-is-the-white-space-property
  (for value [0x9 0xA 0xB 0xC 0xD 0x20 0x85 0xA0 0x1680 0x2000 0x2003 0x200A
              0x2028 0x2029 0x202F 0x205F 0x3000]
    (assert (u/whitespace? (rune (cast u32 value)))))
  (for value [0x0 0x1C 0x1F 0x200B 0x180E 0xFEFF 0x41]
    (assert (not (u/whitespace? (rune (cast u32 value)))))))

(deftest uppercase-and-lowercase-properties
  (assert (u/uppercase? (rune 0x3A3)))
  (assert (u/lowercase? (rune 0x3C3)))
  (assert (u/lowercase? (rune 0x3C2)))
  (assert (u/uppercase? (rune 0x24B6)))
  (assert (u/lowercase? (rune 0xAA)))
  (assert (not (u/uppercase? (rune 0x1C5))))
  (assert (not (u/lowercase? (rune 0x1C5))))
  (assert (not (u/uppercase? (rune 0x4E2D))))
  (assert (not (u/lowercase? (rune 0x31)))))

(deftest simple-case-mappings
  (assert-eq (lower 0x41) 0x61)
  (assert-eq (upper 0x7A) 0x5A)
  (assert-eq (upper 0x31) 0x31)
  ; Greek, including final sigma.
  (assert-eq (lower 0x3A3) 0x3C3)
  (assert-eq (upper 0x3C2) 0x3A3)
  (assert-eq (upper 0x3AC) 0x386)
  ; Cyrillic, Armenian, Georgian (Mkhedruli uppercases to Mtavruli).
  (assert-eq (lower 0x416) 0x436)
  (assert-eq (upper 0x451) 0x401)
  (assert-eq (lower 0x531) 0x561)
  (assert-eq (upper 0x10D0) 0x1C90)
  (assert-eq (lower 0x1C90) 0x10D0)
  ; Cherokee and Deseret (a supplementary plane).
  (assert-eq (lower 0x13A0) 0xAB70)
  (assert-eq (lower 0x10400) 0x10428)
  (assert-eq (upper 0x10428) 0x10400)
  ; Single-code-point mappings only: SpecialCasing.txt is not applied.
  (assert-eq (lower 0x130) 0x69)
  (assert-eq (upper 0x131) 0x49)
  (assert-eq (upper 0xDF) 0xDF)
  (assert-eq (lower 0x1E9E) 0xDF)
  (assert-eq (upper 0xFF) 0x178)
  (assert-eq (upper 0xB5) 0x39C)
  ; Titlecase differs from uppercase for the digraphs.
  (assert-eq (upper 0x1C6) 0x1C4)
  (assert-eq (title 0x1C6) 0x1C5)
  (assert-eq (title 0x1C4) 0x1C5)
  (assert-eq (title 0x61) 0x41)
  ; Mappings that change the UTF-8 length.
  (assert-eq (upper 0x23F) 0x2C7E)
  (assert-eq (lower 0x2C7E) 0x23F))

(deftest case-folding
  (assert-eq (folded 0x41) 0x61)
  (assert-eq (folded 0x61) 0x61)
  (assert-eq (folded 0x3A3) 0x3C3)
  (assert-eq (folded 0x3C2) 0x3C3)
  (assert-eq (folded 0xB5) 0x3BC)
  (assert-eq (folded 0x17F) 0x73)
  (assert-eq (folded 0x212A) 0x6B)
  (assert-eq (folded 0x1E9E) 0xDF)
  (assert-eq (folded 0xAB70) 0x13A0)
  (assert-eq (folded 0x13A0) 0x13A0)
  (assert-eq (folded 0x10400) 0x10428))

(deftest round-trips
  ; Case folding is idempotent for every scalar value, and every fold target is
  ; its own fold (Unicode stability guarantees both).
  (for cp (range 0 0x110000)
    (match (string/rune-new (cast u32 cp))
      (None [] 0)
      (Some [r]
            (let [f (u/case-fold r)]
              (assert (= (string/rune-value (u/case-fold f))
                         (string/rune-value f)))
              0))))
  ; Lowercase then uppercase returns each capital of these bicameral alphabets.
  (for range-pair [[0x41 0x5A]
                   [0xC0 0xD6]
                   [0x391 0x3A1]
                   [0x3A3 0x3A9]
                   [0x410 0x42F]
                   [0x531 0x556]
                   [0x10A0 0x10C5]
                   [0x10400 0x10427]
                   [0xFF21 0xFF3A]]
    (for cp (range (get range-pair 0) (+ (get range-pair 1) 1))
      (let [r (rune (cast u32 cp))]
        (assert (u/uppercase? r))
        (assert (u/lowercase? (u/to-lower r)))
        (assert-eq (string/rune-value (u/to-upper (u/to-lower r)))
                   (cast u32 cp))
        (assert-eq (string/rune-value (u/case-fold r))
                   (string/rune-value (u/case-fold (u/to-lower r))))))))

(deftest strings
  (let [a (malloc-allocator)]
    (let [(mut s)
            (u/string-to-lower a
                               (sv "Ünïcödé ΣΑΣ Привет 123"))]
      (assert (same-text? s "ünïcödé σασ привет 123"))
      (string/string-free! (mut s)))
    (let [(mut s) (u/string-to-upper a (sv "straße ǆ ȿ ı"))]
      ; ß has no single-character uppercase; ȿ grows from two bytes to three
      ; and ı shrinks from two bytes to one.
      (assert (same-text? s "STRAßE Ǆ Ȿ I"))
      (string/string-free! (mut s)))
    (let [(mut x)
            (u/string-case-fold a
                                (sv "ПРИВЕТ, Kelvin \x212a; ſ µ"))
          (mut y) (u/string-case-fold a (sv "привет, kelvin k s μ"))]
      (assert (= (string/string-as-view x) (string/string-as-view y)))
      (string/string-free! (mut x))
      (string/string-free! (mut y)))
    ; Any Text works, including an owned String.
    (let [(mut owned) (string/string-from-view a (sv "MiXeD"))
          (mut s) (u/string-to-lower a owned)]
      (assert (same-text? s "mixed"))
      (string/string-free! (mut owned))
      (string/string-free! (mut s)))
    (let [(mut s) (u/string-to-upper a (sv ""))]
      (assert (same-text? s ""))
      (string/string-free! (mut s)))))

; ==== every scalar value against the UCD ====
; The expected block hashes come from the UCD itself, through
; scripts/docs/gen-unicode-props.py, which generates unicode_conformance.coil.

(deftest unicode-properties-match-the-ucd-for-every-scalar-value
  (let [expected (ucd/expected-block-hashes)
        (mut bad) 0]
    (assert-eq (len expected) 272)
    (for block (range 0 (len expected))
      (when (!= (ucd/block-hash block) (get expected block))
        (set! bad (+ bad 1))
        (println "block U+{:x}..U+{:x} differs from the UCD"
                 (* block ucd/BLOCK-SIZE)
                 (- (* (+ block 1) ucd/BLOCK-SIZE) 1))))
    (assert-eq bad 0)))
