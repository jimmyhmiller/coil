(module stdlib-tests.system)
(import "coil.fs" :as fs)
(import "coil.io" :as io :use [Errno OutOfMemory])
(import "coil.alloc"
        :as
        alloc
        :use
        [malloc-allocator arena-allocator Allocator])
(import "coil.debug-allocator"
        :use
        [debug-allocator-init debug-allocator-view debug-allocator-deinit!])
(import "coil.str" :as str)
(import "coil.temp" :as temp)
(import "coil.slice" :use [subslice])
(import "coil.os.linux" :as linux)
(import "coil.os" :as os)
(import "coil.thread" :as thread)
(import "coil.primitive" :as primitive)
(import "coil.time" :as time)
(import "coil.selectors" :as selectors)
(import "coil.process" :as process)
(import "coil.try" :use [try try-or! some-or! ensure!])
(import "coil.cancellation" :as cancellation)
(import "coil.subprocess" :as subprocess)
(import "coil.socket" :as socket)
(import "coil.signals" :as signals)

; ==== listing a directory ====

(deftest dir-list-reads-a-directory
  (let [a (malloc-allocator)]
    (match (fs/Directory::list a "src/stdlib")
      (Ok [names]
          (let [(mut found) false
                (mut owned) names]
            (for name names (when (= name "fs.coil") (set! found true)))
            (fs/Directory::free-list a (mut owned))
            (assert found)))
      (Err [_] (assert false)))))

(deftest dir-list-reports-errno-for-a-missing-directory
  (match (fs/Directory::list (malloc-allocator) "/nonexistent/coil-test")
    (Err [(Errno [code])] (assert (> code 0)))
    (_ (assert false))))

(deftest dir-list-reports-out-of-memory-for-the-path
  (match (fs/Directory::list (arena-allocator 0) "src/stdlib")
    (Err [(OutOfMemory [])] (assert true))
    (_ (assert false))))

; ==== directory handles, existence, relative opens ====

(deftest exists-is-true-for-a-file-and-a-directory
  (let [a (malloc-allocator)]
    (match (fs/exists? a "src/stdlib/fs.coil")
      (Ok [yes] (assert yes))
      (Err [_] (assert false)))
    (match (fs/exists? a "src/stdlib")
      (Ok [yes] (assert yes))
      (Err [_] (assert false)))))

(deftest exists-is-false-for-nothing-and-for-a-file-used-as-a-directory
  (let [a (malloc-allocator)]
    (match (fs/exists? a "/nonexistent/coil-test")
      (Ok [yes] (assert (not yes)))
      (Err [_] (assert false)))
    (match (fs/exists? a "src/stdlib/fs.coil/below")
      (Ok [yes] (assert (not yes)))
      (Err [_] (assert false)))))

(deftest exists-reports-out-of-memory-for-the-path
  (match (fs/exists? (arena-allocator 0) "src/stdlib")
    (Err [(OutOfMemory [])] (assert true))
    (_ (assert false))))

(defn kind-regular? [(k fs/EntryKind)] (-> bool)
  (match k
    (fs/EntryRegular [] true)
    (_ false)))

(defn kind-directory? [(k fs/EntryKind)] (-> bool)
  (match k
    (fs/EntryDirectory [] true)
    (_ false)))

;; Walk src/stdlib and report what was seen as bits: 1 fs.coil as a regular file,
;; 2 lints as a directory, 4 a "." or ".." entry, 8 an error.
(defn scan-stdlib [] (-> i64)
  (match (fs/Directory::open (malloc-allocator) "src/stdlib")
    (Err [_] 8)
    (Ok [dir]
        (let [(mut d) dir
              (mut bits) 0]
          (loop (match (next! (mut d))
                  (Err [_] (do (set! bits (+ (load bits) 8)) (break)))
                  (Ok [step]
                      (match step
                        (None [] (break))
                        (Some [entry]
                              (do
                                (when (and (= (.name entry) "fs.coil")
                                           (kind-regular? (.kind entry)))
                                  (set! bits (+ (load bits) 1)))
                                (when (and (= (.name entry) "lints")
                                           (kind-directory? (.kind entry)))
                                  (set! bits (+ (load bits) 2)))
                                (when (or (= (.name entry) ".")
                                          (= (.name entry) ".."))
                                  (set! bits (+ (load bits) 4)))))))))
          (close! (mut d))
          (load bits)))))

(deftest a-directory-streams-its-entries-with-their-kinds
  (assert (= (scan-stdlib) 3)))

(deftest a-missing-directory-reports-errno
  (match (fs/Directory::open (malloc-allocator) "/nonexistent/coil-test")
    (Err [(Errno [code])] (assert (> code 0)))
    (_ (assert false))))

(deftest a-file-opens-relative-to-its-directory
  (match (fs/Directory::open (malloc-allocator) "src/stdlib")
    (Err [_] (assert false))
    (Ok [dir]
        (let [(mut d) dir]
          (match (fs/File::open-at (mut d) c"fs.coil" 0 0)
            (Ok [f]
                (let [(mut file) f]
                  (fs/File::close (mut file))
                  (assert true)))
            (Err [_] (assert false)))
          (match (fs/File::open-at (mut d) c"no-such-file.coil" 0 0)
            (Err [(Errno [code])] (assert (> code 0)))
            (_ (assert false)))
          (close! (mut d))
          0))))

(deftest a-file-opens-from-a-slice-path
  (let [a (malloc-allocator)]
    (match (fs/open-file a "src/stdlib/fs.coil" fs/O_RDONLY 0)
      (Ok [f] (let [(mut file) f] (fs/File::close (mut file)) (assert true)))
      (Err [_] (assert false)))
    (match (fs/open-file a "/nonexistent/coil-test" fs/O_RDONLY 0)
      (Err [(Errno [code])] (assert-eq code 2))
      (_ (assert false)))
    (match (fs/open-file (arena-allocator 0) "src/stdlib/fs.coil" fs/O_RDONLY 0)
      (Err [(OutOfMemory [])] (assert true))
      (_ (assert false)))
    (match (fs/Directory::open a "src/stdlib")
      (Err [_] (assert false))
      (Ok [dir]
          (let [(mut d) dir]
            (match (fs/open-file-at a (mut d) "fs.coil" fs/O_RDONLY 0)
              (Ok [f]
                  (let [(mut file) f] (fs/File::close (mut file)) (assert true)))
              (Err [_] (assert false)))
            (close! (mut d))
            0)))))

(deftest a-directory-is-created-from-a-slice-path
  (let [a (malloc-allocator)
        path (match (temp/path "made") (Ok [p] p) (Err [_] ""))]
    (assert (> (len path) 0))
    (assert-eq (match (fs/create-dir a path 448) (Ok [_] 0) (Err [_] 1)) 0)
    (match (fs/exists? a path) (Ok [yes] (assert yes)) (Err [_] (assert false)))
    ; a second create reports EEXIST
    (match (fs/create-dir a path 448)
      (Err [(Errno [code])] (assert-eq code 17))
      (_ (assert false)))
    (temp/free path)))

;; cstr-free releases exactly what str->cstr allocated: a debug allocator reports
;; a size mismatch or a leak.
(deftest a-c-string-is-freed-with-cstr-free
  (let [debug (debug-allocator-init (malloc-allocator))
        a (debug-allocator-view debug)
        p (str/to-cstr a "hello")]
    (assert-eq (str/from-cstr p) "hello")
    (str/free-cstr a p)
    (str/free-cstr a (cast (ptr i8) 0))
    (assert-eq (debug-allocator-deinit! debug) 0)))

; ==== buffered readers ====

;; A Reader over fixed bytes that hands out at most `chunk` bytes per read and
;; counts its calls.
(defstruct Source [(bytes (slice u8)) (at i64) (chunk i64) (reads i64)])

(defn source-read [(ctx (ptr i8)) (buf (ptr i8)) (size i64)]
  (-> (Result i64 io/IoError))
  (let [s (cast (ptr Source) ctx)
        left (- (len (.bytes s)) (.at s))
        n
          (cond (< size left) (if (< size (.chunk s)) size (.chunk s))
                (< left (.chunk s)) left
                :else (.chunk s))]
    (set! (.reads s) (+ (.reads s) 1))
    (for i (range 0 n)
      (store! (index buf i) (cast i8 (get (.bytes s) (+ (.at s) i)))))
    (set! (.at s) (+ (.at s) n))
    (Ok n)))

(defn source-reader [(r (ptr io/Reader)) (s (ptr Source))] (-> (ptr io/Reader))
  (store! (field r read-fn) (fnptr-of source-read))
  (store! (field r ctx) (cast (ptr i8) s))
  r)

(defn count-of [(r (Result i64 io/IoError))] (-> i64)
  (match r (Ok [n] n) (Err [_] -1)))

(defn line-of [(buf (ptr i8)) (n i64)] (-> (slice u8))
  (slice::new (cast (ptr u8) buf) n))

;; Read every line with `read-line` into a cap-byte buffer, joining them with "|"
;; and marking a cap-length piece with "+": the same text whichever reader is used.
(defn all-lines [(r (ptr io/Reader)) (cap i64) (out (ptr (array u8 256)))]
  (-> (slice u8))
  (let [(mut buf) (zeroed (array i8 64))
        (mut used) 0]
    (loop (match (io/read-line r (cast (ptr i8) (mut buf)) cap)
            (Err [_] (break))
            (Ok [n]
                (do
                  (for i (range 0 n)
                    (store! (index (cast (ptr u8) out) used)
                            (cast u8 (get buf i)))
                    (set! used (+ used 1)))
                  (store! (index (cast (ptr u8) out) used)
                          (if (= n cap) (: 43 u8) (: 124 u8)))
                  (set! used (+ used 1))))))
    (slice::new (cast (ptr u8) out) used)))

(def text "alpha\nbe\n\ngamma-delta\nlast")

(deftest buffered-lines-match-unbuffered-lines
  (for chunk [1 3 64]
    (for cap [4 6 32]
      (let [(mut plain-src)
              (Source
                :bytes text
                :at 0
                :chunk chunk
                :reads 0)
            (mut plain-r) (zeroed io/Reader)
            (mut plain-out) (zeroed (array u8 256))
            (mut src)
              (Source
                :bytes text
                :at 0
                :chunk chunk
                :reads 0)
            (mut inner) (zeroed io/Reader)
            (mut r) (zeroed io/Reader)
            (mut state) (zeroed io/BufferedReader)
            (mut storage) (zeroed (array i8 8))
            (mut out) (zeroed (array u8 256))]
        (let [expected
                (all-lines (source-reader (mut plain-r) (mut plain-src))
                           cap
                           (mut plain-out))
              got
                (all-lines (io/BufferedReader::init (mut r)
                                                    (mut state)
                                                    (source-reader (mut inner)
                                                                   (mut src))
                                                    (cast (ptr i8) (mut storage))
                                                    8)
                           cap
                           (mut out))]
          (assert-eq got expected))))))

(deftest buffered-reading-calls-the-source-once-per-buffer
  (let [(mut src)
          (Source
            :bytes text
            :at 0
            :chunk 1000
            :reads 0)
        (mut inner) (zeroed io/Reader)
        (mut input) (zeroed io/BufferedInput)
        (mut out) (zeroed (array u8 256))
        r
          (io/BufferedInput::init (mut input)
                                  (source-reader (mut inner) (mut src)))]
    (assert-eq (all-lines r 32 (mut out)) "alpha|be||gamma-delta|last|")
    ; one read returns everything; the final line and the Eof after it each see the end
    (assert-eq (.reads src) 3)))

(defn error-name [(e io/IoError)] (-> (slice u8))
  (match e
    (io/Eof [] "eof")
    (io/Errno [_] "errno")
    (io/LineTooLong [] "too long")
    (io/OutOfMemory [] "oom")
    (io/InvalidLimit [] "limit")
    (io/WriteZero [] "write zero")
    (io/BufferFull [] "full")))

;; The next line's text, or the error's name; owned lines are released.
(defn next-line [(a (dyn Allocator))
                 (r (ptr io/Reader))
                 (limit i64)
                 (out (ptr (array u8 64)))] (-> (slice u8))
  (match (io/read-line-alloc a r limit)
    (Err [e] (error-name e))
    (Ok [line]
        (let [(mut owned) line
              bytes (slice owned)]
          (for i (range 0 (len bytes))
            (store! (index (cast (ptr u8) out) i) (get bytes i)))
          (io/OwnedBytes::free a (mut owned))
          (slice::new (cast (ptr u8) out) (len bytes))))))

(deftest buffered-read-line-alloc-matches-unbuffered
  (let [a (malloc-allocator)]
    (for limit [0 2 5 11 64]
      (let [(mut plain-src)
              (Source
                :bytes text
                :at 0
                :chunk 2
                :reads 0)
            (mut plain-r) (zeroed io/Reader)
            (mut src)
              (Source
                :bytes text
                :at 0
                :chunk 2
                :reads 0)
            (mut inner) (zeroed io/Reader)
            (mut r) (zeroed io/Reader)
            (mut state) (zeroed io/BufferedReader)
            (mut storage) (zeroed (array i8 4))
            (mut x-out) (zeroed (array u8 64))
            (mut y-out) (zeroed (array u8 64))
            plain (source-reader (mut plain-r) (mut plain-src))
            buffered
              (io/BufferedReader::init (mut r)
                                       (mut state)
                                       (source-reader (mut inner) (mut src))
                                       (cast (ptr i8) (mut storage))
                                       4)
            (mut done) false]
        (while (not done)
          (let [x (next-line a plain limit (mut x-out))
                y (next-line a buffered limit (mut y-out))]
            (assert-eq x y)
            (when (= x "eof") (set! done true))))))))

(deftest buffered-reads-serve-partial-requests
  (let [(mut src)
          (Source
            :bytes "0123456789"
            :at 0
            :chunk 100
            :reads 0)
        (mut inner) (zeroed io/Reader)
        (mut r) (zeroed io/Reader)
        (mut state) (zeroed io/BufferedReader)
        (mut storage) (zeroed (array i8 4))
        (mut got) (zeroed (array i8 16))
        br
          (io/BufferedReader::init (mut r)
                                   (mut state)
                                   (source-reader (mut inner) (mut src))
                                   (cast (ptr i8) (mut storage))
                                   4)]
    (assert-eq (count-of (io/read-exact br (cast (ptr i8) (mut got)) 3)) 3)
    (assert-eq (count-of (io/read-fill br (index (cast (ptr i8) (mut got)) 3) 7))
               7)
    (assert-eq (line-of (cast (ptr i8) (mut got)) 10) "0123456789")
    (assert-eq (count-of (io/read-some br (cast (ptr i8) (mut got)) 4)) 0)))

; ==== temporary paths and their cleanup ====

(defn exists? [(path (slice u8))] (-> bool)
  (match (fs/exists? (malloc-allocator) path)
    (Ok [yes] yes)
    (Err [_] false)))

(defn path-of [(r (Result (slice u8) temp/TempError))] (-> (slice u8))
  (match r
    (Ok [path] path)
    (Err [e] (do (println "temp failed: {}" e) ""))))

;; Each path is the caller's to free; freeing it leaves the file alone.
(deftest temp-paths-are-distinct-and-freeable
  (let [a (path-of (temp/path "x.txt"))
        b (path-of (temp/path "x.txt"))]
    (assert (!= a b))
    (assert-eq (written (fs/write-file (malloc-allocator) a "hi")) 2)
    (temp/free b)
    (assert (exists? a))
    (temp/free a)))

;; A sibling's returned path can be freed at once: the cleanup keeps its own copy.
(deftest a-freed-sibling-is-still-cleaned-up
  (let [dir (path-of (temp/dir))
        dest (path-of (temp/path "dest"))
        sibling (path-of (temp/sibling dest))
        (mut kept) (zeroed (array u8 512))]
    (assert (exists? dir))
    (fs/write-file (malloc-allocator) sibling "partial")
    (for i (range 0 (len sibling)) (set! (mut kept) i (get sibling i)))
    (let [copy (subslice (: kept (slice u8)) 0 (len sibling))]
      (temp/free sibling)
      (assert (exists? copy))
      (temp/cleanup!)
      (assert (not (exists? copy)))
      (assert (not (exists? dir))))
    (temp/free dest)
    (temp/free dir)))

(defn written [(r (Result i64 io/IoError))] (-> i64)
  (match r (Ok [n] n) (Err [_] -1)))

; ==== per-thread descriptor tables (Linux only; refused elsewhere) ====

(extern fcntl :cc c [i32 i32 ...] (-> i32))

(extern close :cc c [i32] (-> i32))

;; Off Linux the call is unimplemented, and says so.
(deftest unshare-files-is-enosys-off-linux
  (match (linux/unshare-files!)
    (Ok [_] (assert (= (fs/os-pick 1 0) 1)))
    (Err [(os/Syscall [code])] (assert (= code 78)))
    (Err [_] (assert false))))

(defn closes-stdin-in-its-own-table [(arg (ptr i8))] (-> (ptr i8))
  (match (linux/unshare-files!)
    (Ok [_] (close 0))
    (Err [_] 0))
  arg)

;; A thread that unshared and then closes descriptor 0 closes only its own copy:
;; the descriptor is still open here. Without the unshare this would close it for
;; everyone. Only meaningful, and only run, on Linux.
(deftest a-thread-with-its-own-table-leaves-the-shared-one-alone
  (when (= (fs/os-pick 1 0) 1)
    (let [(mut th) (zeroed thread/Thread)]
      (assert (= (thread/Thread::spawn (mut th)
                                       (fnptr-of closes-stdin-in-its-own-table)
                                       (cast (ptr i8) 0))
                 0))
      (join (mut th))
      (assert (>= (fcntl 0 1) 0)))))

; ==== environment, working directory, clocks, pipes and selectors ====

(defn selector-edge-contracts [] (-> i64)
  (try (let [empty (primitive/alloc-stack (array i32 2))
             short (try-or! (time/Duration::millis 5) 30)]
         (ensure! (= (os/pipe (primitive/cast (ptr i32) empty)) 0) 31)
         (match (selectors/wait-fd-for (load (primitive/index empty 0))
                                       (selectors/interest-readable)
                                       short)
           (Ok [_] (return-from :try 32))
           (Err [error]
                (match error
                  (selectors/Timeout [] 0)
                  (selectors/InvalidFd [] (return-from :try 33))
                  (selectors/Syscall [_] (return-from :try 34)))))

         ; Closing the writer produces hangup/EOF readiness without consuming or closing
         ; the reader. A subsequent read proves the descriptor still belongs to us.
         (os/close (load (primitive/index empty 1)))
         (let [ready
                 (try-or! (selectors/wait-fd-for (load (primitive/index empty 0))
                                                 (selectors/interest-readable)
                                                 short)
                          35)
               readyp (primitive/alloc-stack selectors/ReadyEvents)
               byte (primitive/alloc-stack i8)]
           (store! readyp ready)
           (ensure! (or (load (field readyp readable))
                        (load (field readyp hangup)))
                    36)
           (ensure! (= (io/read (load (primitive/index empty 0)) byte 1) 0) 37))
         (let [closed (load (primitive/index empty 0))]
           (os/close closed)
           (match (selectors/wait-fd-for closed
                                         (selectors/interest-readable)
                                         short)
             (Ok [_] (return-from :try 38))
             (Err [error]
                  (match error
                    (selectors/InvalidFd [] 0)
                    (selectors/Timeout [] (return-from :try 39))
                    (selectors/Syscall [_] (return-from :try 40))))))
         0)))

(defn hosted-main [] (-> i64)
  (try (let [a (alloc/malloc-allocator)
             key "COIL_HOSTED_SYSTEM_TEST"]
         (try-or! (os/set-env! a key "first" true) 1)
         (ensure! (> (process/id) 0) 25)
         (ensure! (> (process/parent-id) 0) 26)
         (let [old (some-or! (try-or! (os/get-env a key) 2) 3)
               oldp (primitive/alloc-stack os/OwnedString)]
           (store! oldp old)
           (try-or! (os/set-env! a key "second" true) 4)
           (ensure! (= (slice old) "first") 5)
           (let [new (some-or! (try-or! (os/get-env a key) 6) 7)
                 newp (primitive/alloc-stack os/OwnedString)]
             (store! newp new)
             (ensure! (= (slice new) "second") 8)
             (os/OwnedString::free! a newp))
           (os/OwnedString::free! a oldp))

         (let [cwd (try-or! (os/current-dir a) 9)
               cwdp (primitive/alloc-stack os/OwnedString)]
           (store! cwdp cwd)
           (try-or! (os/change-dir a "/tmp") 10)
           (try-or! (os/change-dir a (slice cwd)) 11)
           (os/OwnedString::free! a cwdp))

         (let [delay (try-or! (time/Duration::millis 20) 12)
               before (try-or! (time/monotonic-now-ms) 13)]
           (try-or! (time/sleep delay) 14)
           (let [after (try-or! (time/monotonic-now-ms) 15)]
             (ensure! (>= (- after before) 15) 16)))

         (let [fds (primitive/alloc-stack (array i32 2))
               byte (primitive/alloc-stack i8)]
           (ensure! (= (os/pipe (primitive/cast (ptr i32) fds)) 0) 17)
           (store! byte (primitive/cast i8 65))
           (ensure! (= (io/write (load (primitive/index fds 1))
                                 byte
                                 (primitive/cast isize 1))
                       1)
                    18)
           (let [timeout (try-or! (time/Duration::millis 1000) 19)
                 events
                   (try-or! (selectors/wait-fd-for (load (primitive/index fds 0))
                                                   (selectors/interest-readable)
                                                   timeout)
                            20)
                 eventsp (primitive/alloc-stack selectors/ReadyEvents)]
             (store! eventsp events)
             (ensure! (or (load (field eventsp readable))
                          (load (field eventsp hangup)))
                      21))
           (os/close (load (primitive/index fds 0)))
           (os/close (load (primitive/index fds 1))))

         (try-or! (os/unset-env! a key) 22)
         (match (try-or! (os/get-env a key) 23)
           (Some [_] 24)
           (None [] (selector-edge-contracts))))))

(deftest hosted-env-cwd-time-pipes-and-selectors
  (assert-eq (hosted-main) 0))

; ==== cancellation tokens wake selectors ====

(defn selectors-many-main [] (-> i64)
  (let [token (primitive/alloc-stack cancellation/Cancellation)]
    (match (cancellation/Cancellation::init token)
      (Err [_] 1)
      (Ok [_]
          (if (or (= (primitive/iand (os/fcntl (.read-fd token) 1 0) 1) 0)
                  (= (primitive/iand (os/fcntl (.write-fd token) 1 0) 1) 0))
              (do (close! token) 4)
              (do
                (request! token)
                (let [items (primitive/alloc-stack (array selectors/Watch 1))]
                  (store! (primitive/index items 0)
                          (watch token 77))
                  (let [result
                          (selectors/wait-many (alloc/malloc-allocator)
                                               (slice::new [selectors/Watch]
                                                           (primitive/cast (ptr selectors/Watch)
                                                                           items)
                                                           1))]
                    (close! token)
                    (match result
                      (Err [_] 2)
                      (Ok [selected]
                          (let [selectedp
                                  (primitive/alloc-stack selectors/Selection)]
                            (store! selectedp selected)
                            (if (= (load (field selectedp token)) 77) 0 3))))))))))))

(deftest cancellation-wakes-a-selector-and-its-fds-are-cloexec
  (assert-eq (selectors-many-main) 0))

; ==== subprocess run: capture limits, deadlines, cancellation ====

(defn normal-run [] (-> i64)
  (let [args (primitive/alloc-stack (array (slice u8) 2))
        result (primitive/alloc-stack subprocess/RunResult)]
    (store! (primitive/index args 0) "-c")
    (store! (primitive/index args 1)
            "pwd; (yes o | head -c 100000) & (yes e | head -c 100000 >&2) & wait")
    (match (time/Duration::seconds 5)
      (Err [_] 1)
      (Ok [timeout]
          (match (time/Instant::from-now timeout)
            (Err [_] 2)
            (Ok [deadline]
                (match (time/Duration::millis 50)
                  (Err [_] 3)
                  (Ok [grace]
                      (let [options
                              (subprocess/RunOptions::new "/bin/sh"
                                                          (slice::new [(slice u8)]
                                                                      (primitive/cast (ptr (slice u8))
                                                                                      args)
                                                                      2)
                                                          "/tmp"
                                                          4
                                                          4
                                                          (Some deadline)
                                                          (primitive/cast (ptr cancellation/Cancellation)
                                                                          0)
                                                          grace)]
                        (match (subprocess/run (alloc/malloc-allocator)
                                               result
                                               options)
                          (Err [_] 4)
                          (Ok [_]
                              (let [status-ok
                                      (match (load (field result status))
                                        (subprocess/Exited [code] (= code 0))
                                        (subprocess/Signaled [_] false))
                                    valid
                                      (and status-ok
                                           (and (= (len (load (field result
                                                                     stdout)))
                                                   4)
                                                (and (= (len (load (field result
                                                                          stderr)))
                                                        4)
                                                     (and (= (primitive/cast i64
                                                                             (load (primitive/cast (ptr u8)
                                                                                                   (data (load (field result
                                                                                                                      stdout))))))
                                                             47)
                                                          (and (load (field result
                                                                            stdout-truncated))
                                                               (load (field result
                                                                            stderr-truncated)))))))]
                                (subprocess/RunResult::free (alloc/malloc-allocator)
                                                            result)
                                (if valid 0 5)))))))))))))

(defn timeout-run [] (-> i64)
  (let [args (primitive/alloc-stack (array (slice u8) 2))
        result (primitive/alloc-stack subprocess/RunResult)]
    (store! (primitive/index args 0) "-c")
    (store! (primitive/index args 1) "sleep 5")
    (match (time/Duration::millis 30)
      (Err [_] 10)
      (Ok [timeout]
          (match (time/Instant::from-now timeout)
            (Err [_] 11)
            (Ok [deadline]
                (match (time/Duration::millis 20)
                  (Err [_] 12)
                  (Ok [grace]
                      (let [options
                              (subprocess/RunOptions::new "/bin/sh"
                                                          (slice::new [(slice u8)]
                                                                      (primitive/cast (ptr (slice u8))
                                                                                      args)
                                                                      2)
                                                          ""
                                                          16
                                                          16
                                                          (Some deadline)
                                                          (primitive/cast (ptr cancellation/Cancellation)
                                                                          0)
                                                          grace)]
                        (match (subprocess/run (alloc/malloc-allocator)
                                               result
                                               options)
                          (Err [_] 13)
                          (Ok [_]
                              (let [valid (load (field result timed-out))]
                                (subprocess/RunResult::free (alloc/malloc-allocator)
                                                            result)
                                (if valid 0 14)))))))))))))

(defn capture-growth-run [] (-> i64)
  (let [args (primitive/alloc-stack (array (slice u8) 2))
        result (primitive/alloc-stack subprocess/RunResult)]
    (store! (primitive/index args 0) "-c")
    (store! (primitive/index args 1) "yes x | head -c 100000")
    (match (time/Duration::seconds 5)
      (Err [_] 30)
      (Ok [timeout]
          (match (time/Instant::from-now timeout)
            (Err [_] 31)
            (Ok [deadline]
                (match (time/Duration::millis 50)
                  (Err [_] 32)
                  (Ok [grace]
                      (let [options
                              (subprocess/RunOptions::new "/bin/sh"
                                                          (slice::new [(slice u8)]
                                                                      (primitive/cast (ptr (slice u8))
                                                                                      args)
                                                                      2)
                                                          ""
                                                          100000
                                                          16
                                                          (Some deadline)
                                                          (primitive/cast (ptr cancellation/Cancellation)
                                                                          0)
                                                          grace)]
                        (match (subprocess/run (alloc/malloc-allocator)
                                               result
                                               options)
                          (Err [_] 33)
                          (Ok [_]
                              (let [status-ok
                                      (match (load (field result status))
                                        (subprocess/Exited [code] (= code 0))
                                        (subprocess/Signaled [_] false))
                                    first-byte
                                      (primitive/cast i64
                                                      (load (primitive/cast (ptr u8)
                                                                            (data (load (field result
                                                                                               stdout))))))
                                    valid
                                      (and status-ok
                                           (and (= (len (load (field result
                                                                     stdout)))
                                                   100000)
                                                (and (not (load (field result
                                                                       stdout-truncated)))
                                                     (= first-byte 120))))]
                                (subprocess/RunResult::free (alloc/malloc-allocator)
                                                            result)
                                (if valid 0 34)))))))))))))

(defn cancellation-run [] (-> i64)
  (let [args (primitive/alloc-stack (array (slice u8) 2))
        result (primitive/alloc-stack subprocess/RunResult)
        token (primitive/alloc-stack cancellation/Cancellation)]
    (store! (primitive/index args 0) "-c")
    (store! (primitive/index args 1) "sleep 5")
    (match (cancellation/Cancellation::init token)
      (Err [_] 20)
      (Ok [_]
          (do
            (request! token)
            (match (time/Duration::millis 20)
              (Err [_] 21)
              (Ok [grace]
                  (let [options
                          (subprocess/RunOptions::new "/bin/sh"
                                                      (slice::new [(slice u8)]
                                                                  (primitive/cast (ptr (slice u8))
                                                                                  args)
                                                                  2)
                                                      ""
                                                      16
                                                      16
                                                      (None [time/Instant])
                                                      token
                                                      grace)]
                    (match (subprocess/run (alloc/malloc-allocator)
                                           result
                                           options)
                      (Err [_] 22)
                      (Ok [_]
                          (let [valid (load (field result cancelled))]
                            (subprocess/RunResult::free (alloc/malloc-allocator)
                                                        result)
                            (close! token)
                            (if valid 0 23))))))))))))

(defn request-later :cc c [(raw (ptr i8))] (-> (ptr i8))
  (match (time/Duration::millis 50)
    (Err [_] 0)
    (Ok [pause]
        (do
          (time/sleep pause)
          (request! (primitive/cast (ptr cancellation/Cancellation)
                                    raw))
          0)))
  raw)

(defn closed-output-run [(cancel bool)] (-> i64)
  (let [args (primitive/alloc-stack (array (slice u8) 2))
        result (primitive/alloc-stack subprocess/RunResult)
        token (primitive/alloc-stack cancellation/Cancellation)
        worker (primitive/alloc-stack thread/Thread)]
    (store! (primitive/index args 0) "-c")
    (store! (primitive/index args 1) "exec 1>&- 2>&-; sleep 5")
    (match (cancellation/Cancellation::init token)
      (Err [_] 40)
      (Ok [_]
          (match (time/Duration::millis 150)
            (Err [_] 41)
            (Ok [timeout]
                (match (time/Instant::from-now timeout)
                  (Err [_] 42)
                  (Ok [deadline]
                      (match (time/Duration::millis 20)
                        (Err [_] 43)
                        (Ok [grace]
                            (let [started
                                    (if cancel
                                        (thread/Thread::spawn worker
                                                              (primitive/fnptr-of request-later)
                                                              (primitive/cast (ptr i8)
                                                                              token))
                                        0)]
                              (if (!= started 0)
                                  44
                                  (let [options
                                          (subprocess/RunOptions::new "/bin/sh"
                                                                      (slice::new [(slice u8)]
                                                                                  (primitive/cast (ptr (slice u8))
                                                                                                  args)
                                                                                  2)
                                                                      ""
                                                                      16
                                                                      16
                                                                      (Some deadline)
                                                                      (if cancel
                                                                          token
                                                                          (primitive/cast (ptr cancellation/Cancellation)
                                                                                          0))
                                                                      grace)
                                        outcome
                                          (subprocess/run (alloc/malloc-allocator)
                                                          result
                                                          options)]
                                    (if cancel (join worker) 0)
                                    (close! token)
                                    (match outcome
                                      (Err [_] 45)
                                      (Ok [_]
                                          (let [valid
                                                  (if cancel
                                                      (load (field result
                                                                   cancelled))
                                                      (load (field result
                                                                   timed-out)))]
                                            (subprocess/RunResult::free (alloc/malloc-allocator)
                                                                        result)
                                            (if valid 0 46)))))))))))))))))

(deftest run-captures-bounded-output-and-the-exit-status
  (assert-eq (normal-run) 0))

(deftest run-stops-a-child-at-its-deadline
  (assert-eq (timeout-run) 0))

(deftest run-grows-its-capture-to-the-limit
  (assert-eq (capture-growth-run) 0))

(deftest run-honors-a-cancellation-requested-before-it-starts
  (assert-eq (cancellation-run) 0))

(deftest run-honors-the-deadline-after-the-child-closes-its-output
  (assert-eq (closed-output-run false) 0))

(deftest run-honors-cancellation-after-the-child-closes-its-output
  (assert-eq (closed-output-run true) 0))

; ==== TCP sockets ====

(defn tcp-cloexec? [(fd i32)] (-> bool)
  (= (primitive/iand (os/fcntl fd 1) 1) 1))

(defn tcp-timeout-code [] (-> Code)
  (if (primitive/code-eq (primitive/target-os) `linux) `610 `560))

(defn tcp-main [] (-> i64)
  (let [listener (primitive/alloc-stack socket/TcpListener)
        client (primitive/alloc-stack socket/TcpConnection)
        server (primitive/alloc-stack socket/TcpConnection)]
    (match (socket/TcpListener::listen (alloc/malloc-allocator)
                                       listener
                                       "127.0.0.1"
                                       0
                                       true
                                       8)
      (Err [error] (code error))
      (Ok [_]
          (match (port listener)
            (Err [_] 2)
            (Ok [port]
                (match (socket/TcpConnection::connect (alloc/malloc-allocator)
                                                      client
                                                      "127.0.0.1"
                                                      port)
                  (Err [_] 3)
                  (Ok [_]
                      (match (time/Duration::seconds 1)
                        (Err [_] 4)
                        (Ok [duration]
                            (match (accept-for listener
                                               server
                                               duration)
                              (Err [_] 5)
                              (Ok [_]
                                  (let [out (primitive/alloc-stack i8)
                                        input (primitive/alloc-stack i8)]
                                    (store! out (primitive/cast i8 42))
                                    (match (write client out 1)
                                      (Err [_] 6)
                                      (Ok [_]
                                          (match (read server
                                                       input
                                                       1)
                                            (Err [_] 7)
                                            (Ok [count]
                                                (let [timeout-ok
                                                        (match (time/Duration::millis 10)
                                                          (Err [_] false)
                                                          (Ok [short]
                                                              (match (accept-for listener
                                                                                 server
                                                                                 short)
                                                                (Err [error]
                                                                     (and (accept-timeout? error)
                                                                          (= (code error)
                                                                             (tcp-timeout-code))))
                                                                (Ok [_] false))))
                                                      result
                                                        (if (and (= count 1)
                                                                 (= (primitive/cast i64
                                                                                    (load input))
                                                                    42)
                                                                 (tcp-cloexec? (load (field listener
                                                                                            fd)))
                                                                 (tcp-cloexec? (load (field client
                                                                                            fd)))
                                                                 (tcp-cloexec? (load (field server
                                                                                            fd))))
                                                            (if timeout-ok 0 9)
                                                            8)]
                                                  (close! server)
                                                  (close! client)
                                                  (close! listener)
                                                  result))))))))))))))))))

(deftest tcp-sockets-are-cloexec-and-timed-accepts-time-out
  (assert-eq (tcp-main) 0))

; ==== Unix-domain sockets ====

(defn unix-cloexec? [(fd i32)] (-> bool)
  (= (primitive/iand (os/fcntl fd 1) 1) 1))

(defn unix-timeout-code [] (-> Code)
  (if (primitive/code-eq (primitive/target-os) `linux) `610 `560))

;;; The stdlib deliberately does not unlink socket paths (it cannot tell a stale
;;; socket from a live one), so the test owns the path's lifecycle. Declaring the
;;; extern here rather than in coil.socket also keeps it out of any binary that
;;; already declares `unlink` -- externs are not deduped across modules.
(extern unlink :cc c [(ptr i8)] (-> i32))

(const UNIX-SOCKET-PATH "/tmp/coil-unix-socket-test.sock")

(defn unix-remove-stale-path [] (-> i64)
  (let [allocator (alloc/malloc-allocator)
        c-path (str/to-cstr allocator UNIX-SOCKET-PATH)]
    (if (= (primitive/cast i64 c-path) 0)
        1
        (do
          (unlink c-path)
          0))))

(defn unix-main [] (-> i64)
  (let [listener (primitive/alloc-stack socket/UnixListener)
        client (primitive/alloc-stack socket/UnixConnection)
        server (primitive/alloc-stack socket/UnixConnection)]
    (unix-remove-stale-path)
    (match (socket/UnixListener::listen listener UNIX-SOCKET-PATH 8)
      (Err [error] (code error))
      (Ok [_]
          (match (socket/UnixConnection::connect client UNIX-SOCKET-PATH)
            (Err [_] 3)
            (Ok [_]
                (match (time/Duration::seconds 1)
                  (Err [_] 4)
                  (Ok [duration]
                      (match (accept-for listener server duration)
                        (Err [_] 5)
                        (Ok [_]
                            (let [out (primitive/alloc-stack i8)
                                  input (primitive/alloc-stack i8)]
                              (store! out (primitive/cast i8 42))
                              (match (write client out 1)
                                (Err [_] 6)
                                (Ok [_]
                                    (match (read server input 1)
                                      (Err [_] 7)
                                      (Ok [count]
                                          (let [timeout-ok
                                                  (match (time/Duration::millis 10)
                                                    (Err [_] false)
                                                    (Ok [short]
                                                        (match (accept-for listener
                                                                           server
                                                                           short)
                                                          (Err [error]
                                                               (and (accept-timeout? error)
                                                                    (= (code error)
                                                                       (unix-timeout-code))))
                                                          (Ok [_] false))))
                                                result
                                                  (if (and (= count 1)
                                                           (= (primitive/cast i64
                                                                              (load input))
                                                              42)
                                                           (unix-cloexec? (load (field listener
                                                                                       fd)))
                                                           (unix-cloexec? (load (field client
                                                                                       fd)))
                                                           (unix-cloexec? (load (field server
                                                                                       fd))))
                                                      (if timeout-ok 0 9)
                                                      8)]
                                            (close! server)
                                            (close! client)
                                            (close! listener)
                                            (unix-remove-stale-path)
                                            result))))))))))))))))

(deftest unix-sockets-are-cloexec-and-timed-accepts-time-out
  (assert-eq (unix-main) 0))

; ==== a closed peer is an error, not SIGPIPE ====

;; Writing to a socket whose peer has closed must FAIL, not kill the process.
;;
;; The default disposition of SIGPIPE terminates, so before coil.socket suppressed it
;; this test did not fail — it died, taking the whole suite with it (signal 13). One
;; disconnecting client was enough to bring down a server and every other connection
;; it was holding, which is why this is a regression test and not a unit test: the
;; thing being asserted is that the process is still alive to return a value at all.
;;
;; Darwin gets there via SO_NOSIGPIPE on the accepted/connected fd, Linux via
;; MSG_NOSIGNAL on send(). Both must surface the same way here: an ordinary error.

;;; See unix_socket_test.coil: the stdlib cannot tell a stale socket from a live one,
;;; so the path's lifecycle belongs to the test.
; unlink is declared once, with the Unix socket test above.

(const SIGPIPE-SOCKET-PATH "/tmp/coil-unix-socket-sigpipe-test.sock")

(defn sigpipe-remove-stale-path [] (-> i64)
  (let [allocator (alloc/malloc-allocator)
        c-path (str/to-cstr allocator SIGPIPE-SOCKET-PATH)]
    (if (= (primitive/cast i64 c-path) 0) 1 (do (unlink c-path) 0))))

;;; Write until the closed peer is actually noticed. The first write after a close
;;; usually lands in the socket buffer and "succeeds" — the RST comes back before the
;;; second. Bounded so a platform that reports it immediately still terminates.
(defn write-until-error [(server (ptr socket/UnixConnection)) (attempts i64)]
  (-> i64)
  (let [out (primitive/alloc-stack i8)
        (mut i) 0
        (mut result) 0]
    (store! out (primitive/cast i8 42))
    (loop (if (>= (load i) attempts)
              (break)
              (do
                (match (write server out 1)
                  ;; the point of the test: an error value, reached alive
                  (Err [_] (do (store! result 1) (break)))
                  (Ok [_] 0))
                (store! i (primitive/iadd (load i) 1)))))
    (load result)))

(defn sigpipe-main [] (-> i64)
  (let [listener (primitive/alloc-stack socket/UnixListener)
        client (primitive/alloc-stack socket/UnixConnection)
        server (primitive/alloc-stack socket/UnixConnection)]
    (sigpipe-remove-stale-path)
    (match (socket/UnixListener::listen listener SIGPIPE-SOCKET-PATH 8)
      (Err [error] (code error))
      (Ok [_]
          (match (socket/UnixConnection::connect client SIGPIPE-SOCKET-PATH)
            (Err [_] 3)
            (Ok [_]
                (match (time/Duration::seconds 1)
                  (Err [_] 4)
                  (Ok [duration]
                      (match (accept-for listener server duration)
                        (Err [_] 5)
                        (Ok [_]
                            ;; hang up the client, then keep writing at the server end
                            (do
                              (close! client)
                              (let [errored (write-until-error server 64)
                                    result (if (= errored 1) 0 6)]
                                (close! server)
                                (close! listener)
                                (sigpipe-remove-stale-path)
                                result))))))))))))

(deftest writing-to-a-closed-unix-peer-fails-instead-of-sigpipe
  (assert-eq (sigpipe-main) 0))

; ==== signal subscriptions ====

(defn signals-main [] (-> i64)
  (let [subscription (primitive/alloc-stack signals/SignalSubscription)
        numbers (primitive/alloc-stack (array i32 1))]
    (store! (primitive/index numbers 0) (primitive/cast i32 10))
    (match (signals/SignalSubscription::subscribe subscription
                                                  (slice::new [i32]
                                                              (primitive/cast (ptr i32)
                                                                              numbers)
                                                              1))
      (Err [_] 1)
      (Ok [_]
          (do
            (os/kill (os/getpid) 10)
            (match (time/Duration::seconds 1)
              (Err [_] 2)
              (Ok [duration]
                  (let [watches
                          (primitive/alloc-stack (array selectors/Watch 1))]
                    (store! (primitive/index watches 0)
                            (watch subscription 99))
                    (match (selectors/wait-many-for (alloc/malloc-allocator)
                                                    (slice::new [selectors/Watch]
                                                                (primitive/cast (ptr selectors/Watch)
                                                                                watches)
                                                                1)
                                                    duration)
                      (Err [_] 3)
                      (Ok [_]
                          (match (read subscription)
                            (Err [_] 4)
                            (Ok [number]
                                (let [result (if (= number 10) 0 5)]
                                  (close! subscription)
                                  result)))))))))))))

(deftest a-subscribed-signal-is-read-through-a-selector
  (assert-eq (signals-main) 0))
