(module stdlib-tests.parsers)
(import "coil.primitive" :as primitive)
(import "coil.json" :as json)
(import "coil.alloc" :as alloc)
(import "coil.str" :as str)
(import "coil.slice" :as slice)

(deftest json-flat-tape-and-lookup
  (let [parsed
          (json/parse (alloc/malloc-allocator)
                      "{\"name\":\"coil\",\"values\":[1,-2.5e3,true,null]}")]
    (match parsed
      (Err [e] (assert false))
      (Ok [doc]
          (do
            (assert (json/is-object? (json/root doc)))
            (assert-eq (json/child-count (json/root doc)) 2)
            (assert-eq (json/next-index doc 0) (json/token-count doc))
            (let [name-index (json/object-get doc 0 "name")
                  values-index (json/object-get doc 0 "values")]
              (assert (= (json/string-text doc
                                           (json/token doc
                                                       name-index))
                         "coil"))
              (assert (json/is-array? (json/token doc values-index)))
              (assert (= (json/number-text doc
                                           (json/token doc
                                                       (json/array-nth doc
                                                                       values-index
                                                                       1)))
                         "-2.5e3"))))))))

(deftest json-rejects-invalid-input
  (match (json/parse (alloc/malloc-allocator) "[1,]")
    (Err [e] (assert (> (json/error-code e) 0)))
    (Ok [doc] (assert false))))

(defn decode-nth [(a (dyn alloc/Allocator)) (doc json/Doc) (i i64)]
  (-> (Result (slice u8) json/Error))
  (json/string-decode a doc (json/token doc (json/array-nth doc 0 i))))

(deftest json-string-decode
  (let [a (alloc/malloc-allocator)
        src "[\"plain\",\"a\\nb\\u00e9\\\"\",\"\\ud83d\\ude00\",\"\\ud800x\"]"]
    (match (json/parse a src)
      (Err [_] (assert false))
      (Ok [doc]
          (do
            (match (decode-nth a doc 0)
              (Ok [s] (assert (= s "plain")))
              (Err [_] (assert false)))
            (match (decode-nth a doc 1)
              (Ok [s] (assert (= s "a\nb\xe9;\"")))
              (Err [_] (assert false)))
            (match (decode-nth a doc 2)
              (Ok [s] (assert (= s "\x1f600;")))
              (Err [_] (assert false)))
            (match (decode-nth a doc 3)
              (Ok [_] (assert false))
              (Err [e] (assert-eq (json/error-code e) 13))))))))

;; Every entry's value is a 200-element array. Looking up the last key must not
;; re-walk the earlier values (it used to be quadratic in the document size).
(deftest json-object-get-skips-subtrees
  (let [a (alloc/malloc-allocator)
        (mut b) (str/StrBuf::new a)
        entries 3000]
    (push-str! (mut b) "{")
    (for i (range 0 entries)
      (when (> i 0) (push-str! (mut b) ","))
      (push-str! (mut b) "\"k")
      (push-i64! (mut b) i)
      (push-str! (mut b) "\":[")
      (for j (range 0 200)
        (when (> j 0) (push-str! (mut b) ","))
        (push-str! (mut b) "1"))
      (push-str! (mut b) "]"))
    (push-str! (mut b) "}")
    (match (json/parse a (str b))
      (Err [_] (assert false))
      (Ok [doc]
          (let [(mut found) 0]
            (for _ (range 0 200)
              (when (>= (json/object-get doc 0 "k2999") 0)
                (set! found (+ found 1))))
            (assert-eq found 200)
            (assert-eq (json/next-index doc 0) (json/token-count doc))
            (assert-eq (json/object-get doc 0 "missing") -1))))))

;; Every i64 parses, and nothing outside the range does: it is an error, not a
;; wrapped value.
(deftest str-parse-int-rejects-overflow
  (assert-eq (str/parse-int "9223372036854775807")
             (Some 9223372036854775807))
  (assert-eq (str/parse-int "-9223372036854775808")
             (Some -9223372036854775808))
  (assert-eq (str/parse-int "-0") (Some 0))
  (assert-eq (str/parse-int "9223372036854775808") (: (None) (Option i64)))
  (assert-eq (str/parse-int "-9223372036854775809") (: (None) (Option i64)))
  (assert-eq (str/parse-int "99999999999999999999") (: (None) (Option i64)))
  (assert-eq (str/parse-int "-") (: (None) (Option i64)))
  (assert-eq (str/parse-int "") (: (None) (Option i64)))
  (assert-eq (str/parse-int "12x") (: (None) (Option i64))))

