(module regionregistrycomplexitytest)
(import "coil.primitive" :as primitive)
(import "coil.alloc" :as alloc)
(import "coil.region" :as region)
(import "coil.slice" :use [slice-data])

;; Registry cost on real allocator addresses. Heap addresses share their high bits
;; and are strided by size class in the low ones; a hash that lets that structure
;; reach the masked slot bits forms clusters thousands of slots long, and every
;; insert and removal then walks them. Mixed sizes from malloc produce exactly those
;; strides. The probe count covers insertion and rehashing as well as lookup and the
;; removal shift, so neither half of the cost can hide from this bound.
(defn rng-next [(s (ptr i64))] (-> i64)
  (store! s
          (primitive/iadd (primitive/imul (load s) 6364136223846793005)
                          1442695040888963407))
  (primitive/udiv (load s) 8589934592))

(defn size-for [(r i64)] (-> i64)
  (let [k (primitive/urem r 16)]
    (if (< k 4)
        16
        (if (< k 7)
            24
            (if (< k 9)
                32
                (if (< k 11) 48 (if (< k 13) 64 (if (< k 15) 160 1024))))))))

(defn req [(n i64)] (-> alloc/AllocRequest)
  (alloc/AllocRequest
    :type-id 0
    :count n
    :bytes n
    :align 8))

(defn main [] (-> i64)
  (let [r (primitive/alloc-stack region/Region)
        a (region/region-allocator r)
        n 200000
        seed (primitive/alloc-stack i64)]
    (region/region-init r (alloc/malloc-allocator))
    (store! seed 42)
    (match (alloc/alloc-bytes (alloc/malloc-allocator) (* n 16) 8)
      (None [] 1)
      (Some [storage]
            (let [ptrs (primitive/cast (ptr i64) (slice-data storage))
                  code
                    (block :done
                           (for [i 0 n]
                             (let [size (size-for (rng-next seed))]
                               (match (alloc/raw-alloc a (req size))
                                 (None [] (return-from :done 2))
                                 (Some [p]
                                       (do
                                         (store! (primitive/index ptrs
                                                                  (* i 2))
                                                 (primitive/cast i64 p))
                                         (store! (primitive/index ptrs
                                                                  (+ (* i 2)
                                                                     1))
                                                 size)
                                         0))))
                             0)
                           (let [inserted (region/region-ownership-probes r)]
                             (for [i 0 n]
                               (when (= (primitive/urem i 2) 0)
                                 (alloc/raw-free a
                                                 (primitive/cast (ptr i8)
                                                                 (load (primitive/index ptrs
                                                                                        (* i
                                                                                           2))))
                                                 (req (load (primitive/index ptrs
                                                                             (+ (* i
                                                                                   2)
                                                                                1))))))
                               0)
                             (let [removed
                                     (- (region/region-ownership-probes r)
                                        inserted)]
                               ;; Measured: about 6 probes per insert (rehash
                               ;; included) and 4 per removal. The former
                               ;; xor-shift hash measured 1200 and 67.
                               (if (>= inserted (* n 16))
                                   3
                                   (if (>= removed (* (/ n 2) 16)) 4 0)))))]
              (region/region-close! r)
              code)))))
