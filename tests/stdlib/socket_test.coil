(module sockettest)
(import "coil.primitive" :as primitive)
(import "coil.alloc" :as alloc)
(import "coil.socket" :as socket)
(import "coil.time" :as time)
(import "coil.os" :as os)

(defn close-on-exec? [(fd i32)] (-> bool)
  (= (primitive/iand (os/fcntl fd 1) 1) 1))

(defn expected-timeout-error-code [] (-> Code)
  (if (primitive/code-eq (primitive/target-os) `linux) `610 `560))

(defn main [(argc i32) (argv (ptr (ptr i8)))] (-> i64)
  (let [listener (primitive/alloc-stack socket/TcpListener)
        client (primitive/alloc-stack socket/TcpConnection)
        server (primitive/alloc-stack socket/TcpConnection)]
    (match (socket/tcp-listen (alloc/malloc-allocator)
                              listener
                              "127.0.0.1"
                              0
                              true
                              8)
      (Err [error] (socket/socket-error-code error))
      (Ok [_]
          (match (socket/tcp-listener-port listener)
            (Err [_] 2)
            (Ok [port]
                (match (socket/tcp-connect (alloc/malloc-allocator)
                                           client
                                           "127.0.0.1"
                                           port)
                  (Err [_] 3)
                  (Ok [_]
                      (match (time/duration-seconds 1)
                        (Err [_] 4)
                        (Ok [duration]
                            (match (socket/tcp-accept-for listener
                                                          server
                                                          duration)
                              (Err [_] 5)
                              (Ok [_]
                                  (let [out (primitive/alloc-stack i8)
                                        input (primitive/alloc-stack i8)]
                                    (store! out (primitive/cast i8 42))
                                    (match (socket/tcp-write client out 1)
                                      (Err [_] 6)
                                      (Ok [_]
                                          (match (socket/tcp-read server
                                                                  input
                                                                  1)
                                            (Err [_] 7)
                                            (Ok [count]
                                                (let [timeout-ok
                                                        (match (time/duration-millis 10)
                                                          (Err [_] false)
                                                          (Ok [short]
                                                              (match (socket/tcp-accept-for listener server short)
                                                                (Err [error]
                                                                     (and (socket/socket-accept-timeout? error)
                                                                          (= (socket/socket-error-code error)
                                                                             (expected-timeout-error-code))))
                                                                (Ok [_] false))))
                                                      result
                                                        (if (and (= count 1)
                                                                 (= (primitive/cast i64
                                                                                    (load input))
                                                                    42)
                                                                 (close-on-exec? (load (field listener fd)))
                                                                 (close-on-exec? (load (field client fd)))
                                                                 (close-on-exec? (load (field server fd))))
                                                            (if timeout-ok 0 9)
                                                            8)]
                                                  (socket/tcp-connection-close! server)
                                                  (socket/tcp-connection-close! client)
                                                  (socket/tcp-listener-close! listener)
                                                  result))))))))))))))))))
