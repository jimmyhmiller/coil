(module stdlib-tests.persist)
(import "coil.primitive" :as primitive)
(import "coil.alloc" :use *)
(import "coil.slice" :use *)
(import "coil.str" :use *)
(import "coil.arraylist" :use *)
(import "coil.hashmap" :use *)
(import "coil.persist" :use *)
(import "coil.scratch" :as scratch)

; A recursive sum, a struct over it with every owning container, and a generic
; struct: a copy shares no memory with its original, so changing every byte of
; the original leaves the copy as it was.
(defsum Tree
  (Leaf [(v i64)])
  (Node [(l (ptr Tree)) (r (ptr Tree)) (tags (slice i64))]))
(derive Persist Tree)

(defstruct Rec
  [(name (slice u8))
   (n i32)
   (weight f64)
   (kids (ArrayList Tree))
   (best (Option (ptr Tree)))
   (index (HashMap (slice u8) i64))
   (scratch (ptr Tree))])
(derive Persist Rec)

(defstruct Pair [A B] [(a A) (b B)])
(derive Persist (Pair A B))

(defn bytes-of [(a (dyn Allocator)) (text (slice u8))] (-> (slice u8))
  (let [(mut out) (match (alloc [u8] a (len text)) (Some [s] s) (None [] (oom)))]
    (for [i 0 (len text)] (set! out i (get text i)))
    out))

(defn ints [(a (dyn Allocator)) (x i64) (y i64)] (-> (slice i64))
  (let [(mut out) (match (alloc [i64] a 2) (Some [s] s) (None [] (oom)))]
    (set! out 0 x)
    (set! out 1 y)
    out))

(defn tree [(a (dyn Allocator)) (depth i64) (base i64)] (-> (ptr Tree))
  (if (= depth 0)
      (box! a Tree (Leaf base))
      (box! a Tree (Node (tree a (- depth 1) (* base 2))
                         (tree a (- depth 1) (+ (* base 2) 1))
                         (ints a depth base)))))

(defn tree-sum [(t (ptr Tree))] (-> i64)
  (match (load t)
    (Leaf [v] v)
    (Node [l r tags] (+ (+ (tree-sum l) (tree-sum r)) (+ (get tags 0) (get tags 1))))))

;;; Overwrite every value the tree holds, so a copy that shared any of it shows it.
(defn smash! [(t (ptr Tree))] (-> i64)
  (match (load t)
    (Leaf [_] (do (store! t (Leaf -1000)) 0))
    (Node [l r tags] (do (smash! l) (smash! r) (set! tags 0 -1000) (set! tags 1 -1000) 0))))

(deftest a-copied-tree-shares-no-memory
  (let [a (malloc-allocator)
        t (tree a 4 1)
        before (tree-sum t)
        c (persist-clone t a)]
    (assert (!= (primitive/cast i64 c) (primitive/cast i64 t)))
    (assert-eq (tree-sum c) before)
    (smash! t)
    (assert (!= (tree-sum t) before))
    (assert-eq (tree-sum c) before)))

;;; Element I of a list, in place.
(defn kid [(l (ref (ArrayList Tree))) (i i64)] (-> (ptr Tree))
  (elem (primitive/cast (ptr (ArrayList Tree)) l) i))

(deftest a-record-copies-every-container
  (let [a (malloc-allocator)
        (mut kids) (ArrayList::new [Tree] a)
        (mut index) (HashMap::new [(slice u8) i64] a (keyops))
        name (bytes-of a "record")]
    (push! (mut kids) (Leaf 7))
    (push! (mut kids) (load (tree a 2 3)))
    (set! (mut index) (bytes-of a "seven") 7)
    (set! (mut index) (bytes-of a "eight") 8)
    (let [r (Rec :name name :n (: 5 i32) :weight 2.5 :kids kids
                 :best (Some (tree a 1 9)) :index index
                 :scratch (primitive/cast (ptr Tree) 0))
          c (persist-clone r a)]
      (assert (= (.name c) "record"))
      (assert (!= (primitive/cast i64 (data (.name c))) (primitive/cast i64 (data name))))
      (assert-eq (.n c) (: 5 i32))
      (assert (= (.weight c) 2.5))
      (assert-eq (len (.kids c)) 2)
      (assert-eq (primitive/cast i64 (.scratch c)) 0)
      (let [best-before (match (.best r) (Some [t] (tree-sum t)) (None [] 0))]
        (set! name 0 (: 88 u8))
        (smash! (kid (field r kids) 1))
        (match (.best r) (Some [t] (smash! t)) (None [] 0))
        (assert (= (.name c) "record"))
        (assert-eq (tree-sum (kid (field c kids) 1)) (tree-sum (tree a 2 3)))
        (match (.best c)
          (Some [t] (assert-eq (tree-sum t) best-before))
          (None [] (assert false))))
      (assert-eq (len (.index c)) 2)
      (assert-eq (get (.index c) "seven") (Some 7))
      (assert-eq (get (.index c) "eight") (Some 8)))))

(deftest a-map-without-owned-keys-copies-them
  (let [a (malloc-allocator)
        key (bytes-of a "k")
        (mut m) (HashMap::new [(slice u8) (ptr Tree)] a (keyops-borrowed))]
    (set! (mut m) key (tree a 1 4))
    (let [c (persist-clone m a)]
      (set! key 0 (: 122 u8))
      (assert-eq (len c) 1)
      (match (get c "k")
        (Some [t] (assert-eq (tree-sum t) (tree-sum (tree a 1 4))))
        (None [] (assert false))))))

(deftest generic-results-and-empty-slices-copy
  (let [a (malloc-allocator)
        p (Pair :a (bytes-of a "left") :b (Some (ints a 1 2)))
        c (persist-clone p a)
        ok (: (Ok (bytes-of a "fine")) (Result (slice u8) i64))
        e (: (Err 3) (Result (slice u8) i64))
        empty (slice::new (primitive/cast (ptr i64) 0) 0)]
    (assert (= (.a c) "left"))
    (match (.b c) (Some [xs] (assert-eq (get xs 1) 2)) (None [] (assert false)))
    (match (persist-clone ok a) (Ok [s] (assert (= s "fine"))) (Err [_] (assert false)))
    (match (persist-clone e a) (Err [n] (assert-eq n 3)) (Ok [_] (assert false)))
    (assert-eq (len (persist-clone empty a)) 0)))

; A field the computation that built a value keeps for itself is left out of the
; copy, which holds it zeroed.
; An enumeration owns nothing and needs no Persist of its own.
(defsum Shade (Light) (Dark))
(defstruct Memo [(key (slice u8)) (shade Shade) (scratch (ptr i8))])
(derive (Persist (field scratch (skip))) Memo)

(deftest a-skipped-field-is-zeroed
  (let [a (malloc-allocator)
        m (Memo :key (bytes-of a "k") :shade (Dark) :scratch (primitive/cast (ptr i8) (tree a 0 1)))
        c (persist-clone m a)]
    (assert (= (.key c) "k"))
    (match (.shade c) (Dark [] 0) (Light [] (assert false)))
    (assert-eq (primitive/cast i64 (.scratch c)) 0)))

; A copy that extends an earlier one reuses what is already where it goes and
; copies only the rest.
(defn in-arena? [(cx (ptr i8)) (p (ptr i8))] (-> bool)
  (scratch/ScratchArena::owns-address? (primitive/cast (ptr scratch/ScratchArena) cx) p))

(deftest a-sharing-copy-copies-only-what-is-new
  (let [a (malloc-allocator)
        dest (primitive/alloc-stack scratch/ScratchArena)]
    (scratch/ScratchArena::init dest a)
    (let [d (scratch/ScratchArena::allocator dest)
          kept (persist-clone (tree a 3 1) d)
          fresh (tree a 2 5)
          pair (Pair :a kept :b fresh)
          c (persist-clone-sharing pair d (fnptr-of in-arena?) (primitive/cast (ptr i8) dest))]
      (assert-eq (primitive/cast i64 (.a c)) (primitive/cast i64 kept))
      (assert (!= (primitive/cast i64 (.b c)) (primitive/cast i64 fresh)))
      (assert (in-arena? (primitive/cast (ptr i8) dest) (primitive/cast (ptr i8) (.b c))))
      (assert-eq (tree-sum (.b c)) (tree-sum fresh))
      (scratch/ScratchArena::close! dest))))

; Saved bytes read back as the value they were written from, in another
; allocator, and say it again byte for byte; a cut or padded copy of them is
; refused.
(defn same-bytes? [(x (slice u8)) (y (slice u8))] (-> bool)
  (and (= (len x) (len y))
       (let [(mut same) true]
         (for [i 0 (len x)]
           (when (!= (get x i) (get y i)) (store! same false)))
         (load same))))

(defn refused? [(r (Option Rec))] (-> bool)
  (match r (None [] true) (Some [_] false)))

(deftest saved-bytes-load-back
  (let [a (malloc-allocator)
        (mut kids) (ArrayList::new [Tree] a)
        (mut index) (HashMap::new [(slice u8) i64] a (keyops))
        (mut ids) (HashMap::new [i64 i64] a (i64-keyops))]
    (push! (mut kids) (load (tree a 2 3)))
    (set! (mut index) (bytes-of a "seven") 7)
    (for [k 0 40] (set! (mut ids) k (* k 3)))
    (for [k 0 40] (when (= (% k 3) 0) (remove! (mut ids) k) 0))
    (set! (mut ids) 40 41)
    (let [r (Rec :name (bytes-of a "saved") :n (: -2 i32) :weight 0.25 :kids kids
                 :best (None [(ptr Tree)]) :index index
                 :scratch (tree a 0 6))
          m (Memo :key (bytes-of a "m") :shade (Dark) :scratch (primitive/cast (ptr i8) a))
          bytes (persist-save r a)
          loaded (persist-load [Rec] bytes a)]
      (match loaded
        (None [] (assert false))
        (Some [read]
          (let [c read]
            (assert (= (.name c) "saved"))
            (assert-eq (.n c) (: -2 i32))
            (assert (= (.weight c) 0.25))
            (assert-eq (tree-sum (kid (field c kids) 0)) (tree-sum (tree a 2 3)))
            (match (.best c) (None [] 0) (Some [_] (assert false)))
            (assert-eq (get (.index c) "seven") (Some 7))
            (assert-eq (tree-sum (.scratch c)) 6)
            (assert (same-bytes? (persist-save c a) bytes)))))
      (assert (refused? (persist-load [Rec] (subslice bytes 0 (- (len bytes) 1)) a)))
      (let [(mut padded) (ArrayList::new [u8] a)]
        (extend! (mut padded) (data bytes) (len bytes))
        (push! (mut padded) (: 0 u8))
        (assert (refused? (persist-load [Rec] (slice padded) a))))
      ; a map reads back as the same slot table, removed entries and all
      (let [saved (persist-save ids a)]
        (match (persist-load [(HashMap i64 i64)] saved a)
          (Some [read]
            (let [c read]
              (assert-eq (get c 40) (Some 41))
              (assert-eq (get c 7) (Some 21))
              (assert (match (get c 9) (None [] true) (Some [_] false)))
              (assert-eq (len c) (len ids))
              (assert (same-bytes? (persist-save c a) saved))))
          (None [] (assert false))))
      (match (persist-load [Memo] (persist-save m a) a)
        (Some [c] (do (assert (= (.key c) "m"))
                      (match (.shade c) (Dark [] 0) (Light [] (assert false)))
                      (assert-eq (primitive/cast i64 (.scratch c)) 0)))
        (None [] (assert false))))))

; What a value owns is measured by the path of fields that reaches it.
(deftest a-footprint-names-what-each-field-owns
  (let [a (malloc-allocator)
        (mut kids) (ArrayList::new [Tree] a)
        (mut index) (HashMap::new [(slice u8) i64] a (keyops))]
    (reserve! (mut kids) 4)
    (push! (mut kids) (Leaf 1))
    (set! (mut index) (bytes-of a "k") 1)
    (let [r (Rec :name (bytes-of a "twelve bytes") :n (: 0 i32) :weight 0.0 :kids kids
                 :best (None [(ptr Tree)]) :index index :scratch (tree a 1 0))
          fp (persist-footprint r a 4)
          report (footprint-report fp a 2)]
      ; the name's twelve bytes, the list's buffer of four trees, the map's slots
      ; and its key, and the scratch tree's three nodes and its tags
      (assert-eq (footprint-total fp)
                 (+ (+ 12 (* 4 (primitive/sizeof Tree)))
                    (+ (+ (* (load (field (field r index) cap)) (primitive/sizeof (Entry (slice u8) i64))) 1)
                       (+ (* 3 (primitive/sizeof Tree)) 16))))
      (assert (match (find report "\tname\n") (Some [_] true) (None [] false)))
      (assert (match (find report "\tscratch\n") (Some [_] true) (None [] false))))))
