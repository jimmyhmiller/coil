(module scratchtest)
(import "coil.primitive" :as primitive)
(import "coil.alloc" :as alloc)
(import "coil.scratch" :as scratch)

(extern abort :cc c [] (-> void))

(defn demand [(good bool)] (-> i64)
  (if good 0 (do (abort) 0)))

(defn request [(n i64) (alignment i64)] (-> alloc/AllocRequest)
  (alloc/AllocRequest
    :type-id 0
    :count n
    :bytes n
    :align alignment))

(defn take [(a (dyn alloc/Allocator)) (n i64) (alignment i64)] (-> (ptr i8))
  (match (alloc/raw-alloc a (request n alignment))
    (Some [p] p)
    (None [] (do (abort) (primitive/cast (ptr i8) 0)))))

(defn accounting [] (-> i64)
  (let [arena (primitive/alloc-stack scratch/ScratchArena)]
    (scratch/scratch-init-with-cap arena (alloc/malloc-allocator) 256)
    (let [a (scratch/scratch-allocator arena)
          empty (scratch/scratch-mark arena)
          first (take a 1 1)
          mark (scratch/scratch-mark arena)]
      (take a 1 64)
      (demand (= (scratch/scratch-live arena) 2))
      (scratch/scratch-reset-to! arena mark)
      (demand (= (scratch/scratch-live arena) 1))
      (take a 1 64)
      (take a 400 64)
      (demand (= (scratch/scratch-live arena) 402))
      (scratch/scratch-reset-to! arena mark)
      (demand (= (scratch/scratch-live arena) 1))
      (demand (scratch/scratch-resize arena first (request 1 1) (request 17 1)))
      (demand (= (scratch/scratch-live arena) 17))
      (demand (scratch/scratch-resize arena first (request 17 1) (request 3 1)))
      (demand (= (scratch/scratch-live arena) 3))
      (scratch/scratch-reset-to! arena empty)
      (demand (= (scratch/scratch-live arena) 0))
      (for [i 0 16]
        (take a 1 1)
        (take a 1 64)
        (take a 1024 128)
        (demand (= (scratch/scratch-live arena) 1026))
        (scratch/scratch-reset! arena)
        (demand (= (scratch/scratch-live arena) 0)))
      (take a 1 1)
      (take a 1 64)
      (take a 1024 128)
      (scratch/scratch-recycle! arena)
      (demand (= (scratch/scratch-live arena) 0))
      (take a 1 64)
      (demand (= (scratch/scratch-live arena) 1))
      (scratch/scratch-close! arena)
      (demand (= (scratch/scratch-live arena) 0))
      (scratch/scratch-close! arena)
      (demand (= (scratch/scratch-live arena) 0)))))

(defn main [(argc i32) (argv (ptr (ptr i8)))] (-> i64)
  (accounting)
  (let [arena (primitive/alloc-stack scratch/ScratchArena)]
    (scratch/scratch-init-with-cap arena (alloc/malloc-allocator) 256)
    (let [a (scratch/scratch-allocator arena)]
      (match (alloc/raw-alloc a
                              (alloc/AllocRequest
                                :type-id 0
                                :count 64
                                :bytes 64
                                :align 8))
        (None [] 1)
        (Some [first]
              (let [mark (scratch/scratch-mark arena)]
                (match (alloc/raw-alloc a
                                        (alloc/AllocRequest
                                          :type-id 0
                                          :count 400
                                          :bytes 400
                                          :align 16))
                  (None [] 2)
                  (Some [later]
                        (do
                          (store! first (primitive/cast i8 11))
                          (store! later (primitive/cast i8 22))
                          (scratch/scratch-reset-to! arena mark)
                          (match (alloc/raw-remap a
                                                  first
                                                  (alloc/AllocRequest
                                                    :type-id 0
                                                    :count 64
                                                    :bytes 64
                                                    :align 8)
                                                  (alloc/AllocRequest
                                                    :type-id 0
                                                    :count 80
                                                    :bytes 80
                                                    :align 8))
                            (None [] 3)
                            (Some [grown]
                                  (do
                                    (store! grown (primitive/cast i8 33))
                                    (scratch/scratch-reset! arena)
                                    (match (alloc/raw-alloc a
                                                            (alloc/AllocRequest
                                                              :type-id 0
                                                              :count 32
                                                              :bytes 32
                                                              :align 8))
                                      (None [] 4)
                                      (Some [_]
                                            (do
                                              (scratch/scratch-close! arena)
                                              (scratch/scratch-close! arena)
                                              (if (scratch/scratch-closed? arena)
                                                  0
                                                  5))))))))))))))))
