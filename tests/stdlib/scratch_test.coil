(module scratchtest)
(import "coil.primitive" :as primitive)
(import "coil.alloc" :as alloc)
(import "coil.scratch" :as scratch)

(defn main [(argc i32) (argv (ptr (ptr i8)))] (-> i64)
  (let [arena (alloc/stack scratch/ScratchArena)]
    (scratch/scratch-init-with-cap arena (alloc/malloc-allocator) 256)
    (let [a (scratch/scratch-allocator arena)]
      (match (alloc/raw-alloc a 64 8)
        (None [] 1)
        (Some [first]
              (let [mark (scratch/scratch-mark arena)]
                (match (alloc/raw-alloc a 400 16)
                  (None [] 2)
                  (Some [later]
                        (do
                          (store! first (primitive/cast i8 11))
                          (store! later (primitive/cast i8 22))
                          (scratch/scratch-reset-to! arena mark)
                          (match (alloc/raw-resize a first 64 80 8)
                            (None [] 3)
                            (Some [grown]
                                  (do
                                    (store! grown (primitive/cast i8 33))
                                    (scratch/scratch-reset! arena)
                                    (match (alloc/raw-alloc a 32 8)
                                      (None [] 4)
                                      (Some [_]
                                            (do
                                              (scratch/scratch-close! arena)
                                              (scratch/scratch-close! arena)
                                              (if (scratch/scratch-closed? arena) 0 5))))))))))))))))
