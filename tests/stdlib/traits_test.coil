; ==== Eq, Ord and arithmetic across core types ====

(defstruct Point [(x i64) (y i64)])

(derive Eq Debug Point)

(defsum Token (End) (Number [(value (Option i64))]))

(derive Eq Token)

(deftest option-equality-compares-variant-and-payload
  (assert-eq (Some 1) (Some 1))
  (assert-ne (Some 1) (Some 2))
  (assert-ne (Some 1) (: (None) (Option i64)))
  (assert-eq (: (None) (Option i64)) (: (None) (Option i64)))
  (assert-eq (Some (Some "ab")) (Some (Some "ab")))
  (assert-eq (Some (Point :x 1 :y 2)) (Some (Point :x 1 :y 2))))

(deftest result-equality-compares-variant-and-payload
  (let [ok1 (: (Ok 1) (Result i64 (slice u8)))
        err-a (: (Err "a") (Result i64 (slice u8)))]
    (assert-eq ok1 (: (Ok 1) (Result i64 (slice u8))))
    (assert-ne ok1 (: (Ok 2) (Result i64 (slice u8))))
    (assert-ne ok1 err-a)
    (assert-eq err-a (: (Err "a") (Result i64 (slice u8))))
    (assert-ne err-a (: (Err "b") (Result i64 (slice u8))))))

(deftest a-popped-element-compares-with-some
  (let [(mut xs) (al-new [i64] (malloc-allocator))]
    (push! (mut xs) 1)
    (assert-eq (pop! (mut xs)) (Some 1))
    (assert-eq (pop! (mut xs)) (: (None) (Option i64)))
    (al-free! (mut xs))))

(deftest derived-eq-sees-option-fields
  (assert-eq (Number (Some 3)) (Number (Some 3)))
  (assert-ne (Number (Some 3)) (Number (None)))
  (assert-ne (Number (Some 3)) (End)))

(deftest slices-compare-elementwise
  (let [a (: [1 2 3] (slice i64))
        b (: [1 2 3] (slice i64))
        shorter (: [1 2] (slice i64))
        other (: [1 2 4] (slice i64))]
    (assert-eq a b)
    (assert-ne a shorter)
    (assert-ne a other)
    (assert-eq (: [(Point :x 1 :y 2)] (slice Point))
               (: [(Point :x 1 :y 2)] (slice Point)))
    (assert-eq (: ["a" "b"] (slice (slice u8)))
               (: ["a" "b"] (slice (slice u8))))
    (assert-eq [1 2] [1 2])))

(deftest min-and-max-cover-integers-and-floats
  (assert-eq (math/min 3 7) 3)
  (assert-eq (math/max 3 7) 7)
  (assert-eq (math/min (: -5 i32) (: 2 i32)) (: -5 i32))
  ; unsigned compares unsigned
  (assert-eq (math/max (: 0xFFFFFFFFFFFFFFFF u64) (: 1 u64))
             (: 0xFFFFFFFFFFFFFFFF u64))
  (assert-eq (math/max (: 200 u8) (: 3 u8)) (: 200 u8))
  (assert-eq (math/min 1.5 -2.0) -2.0)
  (assert-eq (math/max (: 1.5 f32) (: 2.5 f32)) (: 2.5 f32)))

(deftest i128-and-u128-have-arithmetic-comparison-and-display
  (let [a (: 5000000000 i128)
        big (* a a)
        (mut sb) (sb-new (malloc-allocator))]
    (assert (< a big))
    (assert-eq (/ big a) a)
    (assert-eq (- (+ a (: 7 i128)) (: 7 i128)) a)
    (assert-eq (% big (: 7 i128)) (: 4 i128))
    (assert-eq (- a) (- (: 0 i128) a))
    (assert-eq (>> (<< (: 1 i128) (: 100 i128)) (: 100 i128)) (: 1 i128))
    (assert-eq (math/max a big) big)
    (sb-format! (mut sb)
                "{} {} [{:>6}] {}"
                big
                (- big)
                (: 42 i128)
                (- (: 0 u128) (: 1 u128)))
    (assert-eq (sb-str sb)
               "25000000000000000000 -25000000000000000000 [    42] 340282366920938463463374607431768211455")
    (sb-free! (mut sb))))

; ==== Display, Debug and format specs ====

; Point is defined above, with Debug derived beside Eq.

(defstruct Greeting [(name (slice u8))])

(impl Display Greeting
  (display-fmt [(x Greeting) (f (ptr Formatter))]
    (-> i64)
    (io/print-str (formatter-writer f) "hello, ")
    (display-fmt (.name x) f)
    0))

(defn rendered [(format Code) (value Code) (buf Code) (cap Code)] (-> Code)
  (let [fb (primitive/fresh-identifier "fix-buffer")
        w (primitive/fresh-identifier "writer")
        b (primitive/fresh-identifier "buffer")
        c (primitive/fresh-identifier "capacity")]
    `(let [~fb (primitive/alloc-stack io/FixBuf)
           ~w (primitive/alloc-stack io/Writer)
           ~b ~buf
           ~c ~cap]
       (store! (field ~fb data) ~b)
       (store! (field ~fb cap) ~c)
       (store! (field ~fb len) 0)
       (io/fixed-buffer-writer ~w ~fb)
       (fmt ~w ~format ~value)
       (slice-new [u8] (primitive/cast (ptr u8) ~b) (load (field ~fb len))))))

(deftest display-is-type-directed
  (let [buf (primitive/alloc-stack (array u8 128))]
    (assert (str/str-eq (rendered "{}"
                                  (Greeting :name "Coil")
                                  (primitive/cast (ptr i8) buf)
                                  128)
                        "hello, Coil"))))

(deftest debug-has-compact-and-pretty-coil-syntax
  (let [compact-buf (primitive/alloc-stack (array u8 128))
        pretty-buf (primitive/alloc-stack (array u8 128))
        p (Point :x 10 :y 20)]
    (assert (str/str-eq (rendered "{:?}"
                                  p
                                  (primitive/cast (ptr i8) compact-buf)
                                  128)
                        "(Point :x 10 :y 20)"))
    (assert (str/str-eq (rendered "{:#?}"
                                  p
                                  (primitive/cast (ptr i8) pretty-buf)
                                  128)
                        "(Point\n  :x 10\n  :y 20\n)"))))

(deftest strings-display-raw-and-debug-escaped
  (let [display-buf (primitive/alloc-stack (array u8 128))
        debug-buf (primitive/alloc-stack (array u8 128))]
    (assert (str/str-eq (rendered "{}"
                                  "a\nb"
                                  (primitive/cast (ptr i8) display-buf)
                                  128)
                        "a\nb"))
    (assert (str/str-eq (rendered "{:?}"
                                  "a\nb"
                                  (primitive/cast (ptr i8) debug-buf)
                                  128)
                        "\"a\\nb\""))))

(deftest unsigned-display-and-radix-preserve-bits
  (let [decimal-buf (primitive/alloc-stack (array u8 128))
        hex-buf (primitive/alloc-stack (array u8 128))
        n (cast u64 -1)]
    (assert (str/str-eq (rendered "{}"
                                  n
                                  (primitive/cast (ptr i8) decimal-buf)
                                  128)
                        "18446744073709551615"))
    (assert (str/str-eq (rendered "{:#x}"
                                  n
                                  (primitive/cast (ptr i8) hex-buf)
                                  128)
                        "0xffffffffffffffff"))))

(deftest collections-are-debug-when-their-members-are-debug
  (let [(mut xs) (al-new [Point] (malloc-allocator))
        list-buf (primitive/alloc-stack (array u8 256))
        list-pretty-buf (primitive/alloc-stack (array u8 256))
        (mut map) (hm-new-scalar [i64 Point] (malloc-allocator))
        map-buf (primitive/alloc-stack (array u8 256))]
    (al-push! [Point] (mut xs) (Point :x 1 :y 2))
    (al-push! [Point] (mut xs) (Point :x 3 :y 4))
    (assert (str/str-eq (rendered "{:?}"
                                  (load xs)
                                  (primitive/cast (ptr i8) list-buf)
                                  256)
                        "((Point :x 1 :y 2) (Point :x 3 :y 4))"))
    (assert (str/str-eq (rendered "{:#?}"
                                  (load xs)
                                  (primitive/cast (ptr i8)
                                                  list-pretty-buf)
                                  256)
                        "(\n  (Point\n    :x 1\n    :y 2\n  )\n  (Point\n    :x 3\n    :y 4\n  )\n)"))
    (hm-put! [i64 Point] (mut map) 7 (Point :x 8 :y 9))
    (assert (str/str-eq (rendered "{:?}"
                                  (load map)
                                  (primitive/cast (ptr i8) map-buf)
                                  256)
                        "(HashMap (7 (Point :x 8 :y 9)))"))
    (hm-free! [i64 Point] (mut map))
    (al-free! [Point] (mut xs))))

;; Debug of a float is the shortest text that reads back as the same value, so a
;; printed struct is exact source; width and an explicit precision still apply.
(deftest float-debug-is-shortest-round-trip
  (let [b1 (primitive/alloc-stack (array u8 64))
        b2 (primitive/alloc-stack (array u8 64))
        b3 (primitive/alloc-stack (array u8 64))
        b4 (primitive/alloc-stack (array u8 64))
        b5 (primitive/alloc-stack (array u8 64))
        b6 (primitive/alloc-stack (array u8 64))
        b7 (primitive/alloc-stack (array u8 64))
        b8 (primitive/alloc-stack (array u8 64))]
    (assert (str/str-eq (rendered "{:?}" 0.1 (primitive/cast (ptr i8) b1) 64)
                        "0.1"))
    (assert (str/str-eq (rendered "{:?}" 1.5e-7 (primitive/cast (ptr i8) b2) 64)
                        "1.5e-7"))
    (assert (str/str-eq (rendered "{:?}"
                                  (primitive/fsub 0.0 1.0e21)
                                  (primitive/cast (ptr i8) b3)
                                  64)
                        "-1.0e21"))
    (assert (str/str-eq (rendered "{:?}"
                                  (: 0.1 f32)
                                  (primitive/cast (ptr i8) b4)
                                  64)
                        "0.1"))
    (assert (str/str-eq (rendered "{:>8?}" 2.5 (primitive/cast (ptr i8) b5) 64)
                        "     2.5"))
    (assert (str/str-eq (rendered "{:08?}"
                                  (primitive/fsub 0.0 2.5)
                                  (primitive/cast (ptr i8) b6)
                                  64)
                        "-00002.5"))
    (assert (str/str-eq (rendered "{:.3?}" 0.1 (primitive/cast (ptr i8) b7) 64)
                        "0.100"))
    (assert (str/str-eq (rendered "{:?}"
                                  (primitive/fdiv 0.0 0.0)
                                  (primitive/cast (ptr i8) b8)
                                  64)
                        "NaN"))))

;; Every argument that is a form is evaluated, in order, before the first byte is
;; written, so an argument that itself prints comes out entirely before the line
;; that shows it. A name is read where it prints -- it is lent, not moved, so an
;; owner survives being formatted -- and a later argument that changes it shows.
(deftest arguments-are-evaluated-before-output
  (let [(mut sb) (str/sb-new (malloc-allocator))
        (mut n) 1]
    (str/sb-format! (mut sb)
                    "outer {}"
                    (do (str/sb-format! (mut sb) "inner ") 42))
    (assert-eq (str/sb-str sb) "inner outer 42")
    (str/sb-free! (mut sb))
    (set! sb (str/sb-new (malloc-allocator)))
    (str/sb-format! (mut sb) "{} {}" n (do (set! n 2) n))
    (assert-eq (str/sb-str sb) "2 2")
    (str/sb-free! (mut sb))))

;; Width counts characters, not bytes.
(deftest width-counts-characters
  (let [(mut sb) (str/sb-new (malloc-allocator))]
    (str/sb-format! (mut sb)
                    "[{:<6}][{:>6}][{:^7}][{:.2}]"
                    "café"
                    "café"
                    "café"
                    "héllo")
    (assert-eq (str/sb-str sb) "[café  ][  café][ café  ][hé]")
    (str/sb-free! (mut sb))))

;; The fill is any one character, however many bytes its UTF-8 takes.
(deftest fill-is-any-character
  (let [(mut sb) (str/sb-new (malloc-allocator))]
    (str/sb-format! (mut sb)
                    "[{:─<6}][{:é>5}][{:😀^5}][{:─>4}]"
                    "ab"
                    7
                    "x"
                    -3)
    (assert-eq (str/sb-str sb)
               "[ab────][éééé7][😀😀x😀😀][──-3]")
    (str/sb-free! (mut sb))))

;; `*` takes the width, and `.*` the precision, from the arguments before the value.
(deftest width-and-precision-from-arguments
  (let [(mut sb) (str/sb-new (malloc-allocator))
        w 6]
    (str/sb-format! (mut sb)
                    "[{:>*}][{:<*}][{:-^*}][{:.*}][{:*.*}][{:>*?}][{:*}]"
                    w
                    "ab"
                    4
                    "x"
                    5
                    "y"
                    2
                    3.14159
                    8
                    3
                    2.5
                    w
                    "q"
                    -1
                    "none")
    (assert-eq (str/sb-str sb)
               "[    ab][x   ][--y--][3.14][   2.500][   \"q\"][none]")
    (str/sb-free! (mut sb))))

;; StringView and String format like the bytes they hold.
(deftest text-types-display-and-debug
  (let [a (malloc-allocator)
        (mut sb) (str/sb-new a)
        (mut owned) (str/string-from-view a (str/sv "owned"))]
    (str/sb-format! (mut sb)
                    "{} [{:>7}] {:?} {}"
                    (str/sv "view")
                    (str/sv "café")
                    (str/sv "q\"")
                    owned)
    (assert-eq (str/sb-str sb) "view [   café] \"q\\\"\" owned")
    (str/string-free! (mut owned))
    (str/sb-free! (mut sb))))

;; A StrBuf is a Writer, so anything that formats can format into a string.
(deftest strbuf-is-a-format-destination
  (let [(mut sb) (str/sb-new (malloc-allocator))
        (mut w) (zeroed io/Writer)]
    (for i (range 0 3) (str/sb-format! (mut sb) "[{:>2}]" i))
    (fmt (str/sb-writer (mut w) (mut sb)) " {:?}" (Some (Point :x 1 :y 2)))
    (assert-eq (str/sb-str sb) "[ 0][ 1][ 2] (Some (Point :x 1 :y 2))")
    (let [owned (str/sb-finish! (mut sb))]
      (assert-eq owned "[ 0][ 1][ 2] (Some (Point :x 1 :y 2))")
      (free [u8] (malloc-allocator) owned))))



(defstruct Pair [K V] [(key K) (value V)])

(defsum Maybe [T] (Nothing) (Just [(value T)]))

(derive Debug (Pair K V))

(derive Debug (Maybe T))

;; A derived Debug of a generic type asks each type parameter for Debug.
(deftest generic-types-derive-debug
  (let [(mut sb) (str/sb-new (malloc-allocator))]
    (str/sb-format! (mut sb) "{:?} {:?}" (Pair :key 1 :value "a") (: (Just 3) (Maybe i64)))
    (assert-eq (str/sb-str sb) "(Pair :key 1 :value \"a\") (Just :value 3)")
    (str/sb-free! (mut sb))))

; ==== every standard error type displays ====

;; The text of `{}` for one value.
(defn shown [(value Code) (expected Code)] (-> Code)
  `(let [(mut sb) (sb-new (malloc-allocator))]
     (sb-format! (mut sb) "{}" ~value)
     (assert-eq (sb-str sb) ~expected)
     (sb-free! (mut sb))))

;; Errnos 2, 13, 22, 24 and 28 have the same number and text on Linux and macOS.
(deftest errno-reads-as-the-os-describes-it
  (assert-eq (os/errno-message 2) "No such file or directory")
  (shown (io/Errno 2) "No such file or directory (os error 2)")
  (shown (os/Syscall 13) "Permission denied (os error 13)")
  (shown (time/Syscall 22) "Invalid argument (os error 22)")
  (shown (temp/TempUnavailable "creating the temporary directory" 28)
         "creating the temporary directory: No space left on device (os error 28)")
  (shown (socket/ConnectFailed 13)
         "connecting failed: Permission denied (os error 13)"))

(deftest io-errors-without-errno-have-messages
  (shown (io/Eof) "unexpected end of input")
  (shown (io/WriteZero) "write accepted no bytes")
  (shown (io/BufferFull) "buffer full")
  (shown (io/LineTooLong) "line too long"))

(deftest every-standard-error-displays
  (shown (time/TimeOverflow) "time value out of range")
  (shown (async/Closed) "task closed")
  (shown (rt/Busy 2) "the runtime still has 2 registrations")
  (shown (rt/Clock (time/InvalidTimeDuration))
         "reading the clock failed: invalid duration")
  (shown (rt/InvalidFd) "invalid file descriptor")
  (shown (signals/InvalidSignal 99) "invalid signal 99")
  (shown (sync/LockFailed 22) "locking failed: Invalid argument (os error 22)")
  (shown (cancellation/PipeFailed 24)
         "creating the cancellation pipe failed: Too many open files (os error 24)")
  (shown (subprocess/Timeout) "the process timed out")
  (shown (selectors/InvalidFd) "invalid file descriptor")
  (shown (region/AlreadyClosed) "region already closed"))



; ==== arena allocators ====

(deftest an-arena-allocates-until-full-and-is-released
  (let [ar (arena-new 64)
        a (arena-view ar)]
    (assert (some? (alloc/alloc [i64] a 4)))
    (assert (some? (alloc/alloc [i64] a 4)))
    ; 64 bytes are spent
    (assert (none? (alloc/alloc [i64] a 1)))
    (arena-release! ar)))

(deftest collections-grow-inside-a-released-arena
  (let [ar (arena-new 4096)
        (mut xs) (al-new [i64] (arena-view ar))]
    (for i (range 0 100) (push! (mut xs) i))
    (assert-eq (len xs) 100)
    (assert-eq (get xs 99) 99)
    (arena-release! ar)))

(deftest an-empty-arena-refuses-everything
  (let [ar (arena-new 0)]
    (assert (none? (alloc/alloc [u8] (arena-view ar) 1)))
    (arena-release! ar)))

(defn some? [T] [(o (Option T))] (-> bool)
  (match o (Some [_] true) (None [] false)))

(defn none? [T] [(o (Option T))] (-> bool)
  (not (some? o)))

; ==== a user-defined Allocator ====

(defstruct Empty [])

(defstruct Recorder
  [(parent (dyn alloc/Allocator))
   (last alloc/AllocRequest)])

(impl alloc/Allocator Recorder
  (allocate [(self (ptr Recorder)) (request (ref alloc/AllocRequest))]
    (-> (Option (ptr i8)))
    (set! (.last self) request)
    (alloc/raw-alloc (.parent self) request))
  (resize [(self (ptr Recorder))
           (memory (ptr i8))
           (old (ref alloc/AllocRequest))
           (new (ref alloc/AllocRequest))]
    (-> bool)
    (set! (.last self) new)
    (alloc/raw-resize (.parent self) memory old new))
  (remap [(self (ptr Recorder))
          (memory (ptr i8))
          (old (ref alloc/AllocRequest))
          (new (ref alloc/AllocRequest))]
    (-> (Option (ptr i8)))
    (set! (.last self) new)
    (alloc/raw-remap (.parent self) memory old new))
  (deallocate [(self (ptr Recorder))
               (memory (ptr i8))
               (request (ref alloc/AllocRequest))]
    (-> i64)
    (set! (.last self) request)
    (alloc/raw-free (.parent self) memory request)))

(defn alloc-trait-main [] (-> i64)
  (if (or (= (alloc/type-id [Empty]) 0)
          (or (= (alloc/type-id [u8]) 0)
              (or (!= (alloc/type-id [u8]) (alloc/type-id [u8]))
                  (= (alloc/type-id [u8]) (alloc/type-id [i64])))))
      1
      ; Erasure needs a stable address for its borrowed implementation object.
      (let [recorder (primitive/alloc-stack Recorder)]
        (set! (.parent recorder) (alloc/malloc-allocator))
        (set! (.last recorder)
              (alloc/AllocRequest
                :type-id 0
                :count 1
                :bytes 1
                :align 1))
        (let [a (primitive/make-dyn alloc/Allocator recorder)]
          (match (alloc/alloc [u8] a 3)
            (None [] 2)
            (Some [typed]
                  (if (or (= (.type-id (.last recorder)) 0)
                          (or (!= (.type-id (.last recorder))
                                  (alloc/type-id [u8]))
                              (or (!= (.count (.last recorder)) 3)
                                  (!= (.bytes (.last recorder)) 3))))
                      3
                      (do
                        (alloc/free [u8] a typed)
                        (match (alloc/alloc-bytes a 17 64)
                          (None [] 4)
                          (Some [bytes]
                                (let [aligned
                                        (= (primitive/urem (primitive/cast i64
                                                                           (slice-data bytes))
                                                           64)
                                           0)
                                      untyped (= (.type-id (.last recorder)) 0)]
                                  (alloc/free-bytes a bytes 64)
                                  (if (and aligned untyped) 0 5))))))))))))

(deftest a-custom-allocator-sees-typed-and-aligned-requests
  (assert-eq (alloc-trait-main) 0))

; ==== regions ====

(defn region-main [] (-> i64)
  (let [scope (primitive/alloc-stack region/Region)]
    (region/region-init scope (alloc/malloc-allocator))
    (let [a (region/region-allocator scope)]
      (match (alloc/raw-alloc a
                              (alloc/AllocRequest
                                :type-id 0
                                :count 13
                                :bytes 13
                                :align 8))
        (None [] 1)
        (Some [p]
              (match (alloc/raw-remap a
                                      p
                                      (alloc/AllocRequest
                                        :type-id 0
                                        :count 13
                                        :bytes 13
                                        :align 8)
                                      (alloc/AllocRequest
                                        :type-id 0
                                        :count 29
                                        :bytes 29
                                        :align 8))
                (None [] 2)
                (Some [q]
                      (do
                        (store! q (primitive/cast i8 42))
                        ;; Empty typed storage grows through the typed API rather
                        ;; than smuggling allocation through resize(NULL, ...).
                        (match (alloc/alloc-bytes a 17 8)
                          (None [] 3)
                          (Some [initial]
                                (do
                                  (store! (slice-data initial)
                                          (primitive/cast u8 7))
                                  (region/region-close! scope)
                                  (region/region-close! scope)
                                  (if (region/region-closed? scope) 0 4))))))))))))

(deftest a-region-remaps-allocates-and-closes-twice
  (assert-eq (region-main) 0))

; ==== nested regions close in linear time ====

(defn allocate-many [(a (dyn alloc/Allocator)) (n i64)] (-> i64)
  (block
    :done
      (let [(mut i) 0]
        (loop (if (>= (load i) n)
                  (break)
                  (match (alloc/raw-alloc a
                                          (alloc/AllocRequest
                                            :type-id 0
                                            :count 24
                                            :bytes 24
                                            :align 8))
                    (None [] (return-from :done -1))
                    (Some [_] (store! i (+ (load i) 1))))))
        0)))

(defn region-nested-main [] (-> i64)
  (let [parent (primitive/alloc-stack region/Region)
        child (primitive/alloc-stack region/Region)]
    (region/region-init parent (alloc/malloc-allocator))
    (region/region-init child (region/region-allocator parent))
    (if (!= (allocate-many (region/region-allocator child) 2048) 0)
        1
        (let [before (region/region-ownership-probes parent)]
          (region/region-close! child)
          (let [probes (- (region/region-ownership-probes parent) before)]
            (region/region-close! parent)
            ;; Child close performs two parent removals per leaf (payload + node),
            ;; plus a bounded number for registry tables. Linear probing may inspect
            ;; several slots, but must stay comfortably linear for this deterministic
            ;; address set; the former linked-list implementation was ~O(n^2).
            (if (< probes (* 2048 16)) 0 2))))))

(deftest closing-a-child-region-is-linear-in-its-allocations
  (assert-eq (region-nested-main) 0))

; ==== region ownership under allocation churn ====

;; Random allocate/free/remap churn against a side table of live pointers. Removal
;; shifts later cluster entries backward, so after every batch each live allocation
;; must still be found by ownership lookup (a same-size remap fails on a miss) and
;; the registry count must equal the side table's.
(defn req [(n i64)] (-> alloc/AllocRequest)
  (alloc/AllocRequest
    :type-id 0
    :count n
    :bytes n
    :align 8))

(defn rng-next [(s (ptr i64))] (-> i64)
  (store! s
          (primitive/iadd (primitive/imul (load s) 6364136223846793005)
                          1442695040888963407))
  (primitive/udiv (load s) 8589934592))

(defn i64-buf [(n i64)] (-> (Option (ptr i64)))
  (match (alloc/alloc-bytes (alloc/malloc-allocator) (* n 8) 8)
    (None [] (None))
    (Some [s] (Some (primitive/cast (ptr i64) (slice-data s))))))

;;; 0 when every live allocation is still owned; otherwise the failing check's code.
(defn verify [(r (ptr region/Region))
              (ptrs (ptr i64))
              (sizes (ptr i64))
              (live i64)] (-> i64)
  (block :bad
    (for [k 0 live]
      (let [size (load (primitive/index sizes k))]
        (match (alloc/raw-remap (region/region-allocator r)
                                (primitive/cast (ptr i8)
                                                (load (primitive/index ptrs
                                                                       k)))
                                (req size)
                                (req size))
          (None [] (return-from :bad 10))
          (Some [q]
                (do
                  (store! (primitive/index ptrs k) (primitive/cast i64 q))
                  0))))
      0)
    (if (= (load (field r registry-len)) live) 0 11)))

(defn region-stress-main [] (-> i64)
  (let [r (primitive/alloc-stack region/Region)
        a (region/region-allocator r)
        cap 20000
        seed (primitive/alloc-stack i64)
        (mut live) 0]
    (region/region-init r (alloc/malloc-allocator))
    (store! seed 7)
    (match (i64-buf cap)
      (None [] 1)
      (Some [ptrs]
            (match (i64-buf cap)
              (None [] 1)
              (Some [sizes]
                    (let [code
                            (block :done
                              (for [step 0 200000]
                                (let [op (primitive/urem (rng-next seed) 4)]
                                  (if (or (= (load live) 0)
                                          (and (< op 2)
                                               (< (load live) cap)))
                                      (let [size
                                              (primitive/iadd 8
                                                              (primitive/urem (rng-next seed)
                                                                              200))]
                                        (match (alloc/raw-alloc a
                                                                (req size))
                                          (None [] (return-from :done 2))
                                          (Some [p]
                                                (do
                                                  (store! (primitive/index ptrs
                                                                           (load live))
                                                          (primitive/cast i64
                                                                          p))
                                                  (store! (primitive/index sizes
                                                                           (load live))
                                                          size)
                                                  (store! live
                                                          (+ (load live) 1))
                                                  0))))
                                      (let [k
                                              (primitive/urem (rng-next seed)
                                                              (load live))
                                            p
                                              (primitive/cast (ptr i8)
                                                              (load (primitive/index ptrs
                                                                                     k)))
                                            size
                                              (load (primitive/index sizes
                                                                     k))]
                                        (if (< op 3)
                                            (do
                                              (alloc/raw-free a
                                                              p
                                                              (req size))
                                              (store! live
                                                      (- (load live) 1))
                                              (store! (primitive/index ptrs
                                                                       k)
                                                      (load (primitive/index ptrs
                                                                             (load live))))
                                              (store! (primitive/index sizes
                                                                       k)
                                                      (load (primitive/index sizes
                                                                             (load live))))
                                              0)
                                            (let [grown
                                                    (primitive/iadd size
                                                                    (primitive/urem (rng-next seed)
                                                                                    300))]
                                              (match (alloc/raw-remap a
                                                                      p
                                                                      (req size)
                                                                      (req grown))
                                                (None []
                                                      (return-from :done 3))
                                                (Some [q]
                                                      (do
                                                        (store! (primitive/index ptrs
                                                                                 k)
                                                                (primitive/cast i64
                                                                                q))
                                                        (store! (primitive/index sizes
                                                                                 k)
                                                                grown)
                                                        0))))))))
                                (when (= (primitive/urem step 5000) 0)
                                  (let [bad (verify r ptrs sizes (load live))]
                                    (when (!= bad 0)
                                      (return-from :done bad))))
                                0)
                              (verify r ptrs sizes (load live)))]
                      (region/region-close! r)
                      code)))))))

(deftest region-ownership-survives-random-churn
  (assert-eq (region-stress-main) 0))

; ==== scratch arenas ====

(extern abort :cc c [] (-> void))

(defn scratch-demand [(good bool)] (-> i64)
  (if good 0 (do (abort) 0)))

(defn scratch-request [(n i64) (alignment i64)] (-> alloc/AllocRequest)
  (alloc/AllocRequest
    :type-id 0
    :count n
    :bytes n
    :align alignment))

(defn scratch-take [(a (dyn alloc/Allocator)) (n i64) (alignment i64)]
  (-> (ptr i8))
  (match (alloc/raw-alloc a (scratch-request n alignment))
    (Some [p] p)
    (None [] (do (abort) (primitive/cast (ptr i8) 0)))))

(defn scratch-accounting [] (-> i64)
  (let [arena (primitive/alloc-stack scratch/ScratchArena)]
    (scratch/scratch-init-with-cap arena (alloc/malloc-allocator) 256)
    (let [a (scratch/scratch-allocator arena)
          empty (scratch/scratch-mark arena)
          first (scratch-take a 1 1)
          mark (scratch/scratch-mark arena)]
      (scratch-take a 1 64)
      (scratch-demand (= (scratch/scratch-live arena) 2))
      (scratch/scratch-reset-to! arena mark)
      (scratch-demand (= (scratch/scratch-live arena) 1))
      (scratch-take a 1 64)
      (scratch-take a 400 64)
      (scratch-demand (= (scratch/scratch-live arena) 402))
      (scratch/scratch-reset-to! arena mark)
      (scratch-demand (= (scratch/scratch-live arena) 1))
      (scratch-demand (scratch/scratch-resize arena
                                              first
                                              (scratch-request 1 1)
                                              (scratch-request 17 1)))
      (scratch-demand (= (scratch/scratch-live arena) 17))
      (scratch-demand (scratch/scratch-resize arena
                                              first
                                              (scratch-request 17 1)
                                              (scratch-request 3 1)))
      (scratch-demand (= (scratch/scratch-live arena) 3))
      (scratch/scratch-reset-to! arena empty)
      (scratch-demand (= (scratch/scratch-live arena) 0))
      (for [i 0 16]
        (scratch-take a 1 1)
        (scratch-take a 1 64)
        (scratch-take a 1024 128)
        (scratch-demand (= (scratch/scratch-live arena) 1026))
        (scratch/scratch-reset! arena)
        (scratch-demand (= (scratch/scratch-live arena) 0)))
      (scratch-take a 1 1)
      (scratch-take a 1 64)
      (scratch-take a 1024 128)
      (scratch/scratch-recycle! arena)
      (scratch-demand (= (scratch/scratch-live arena) 0))
      (scratch-take a 1 64)
      (scratch-demand (= (scratch/scratch-live arena) 1))
      (scratch/scratch-close! arena)
      (scratch-demand (= (scratch/scratch-live arena) 0))
      (scratch/scratch-close! arena)
      (scratch-demand (= (scratch/scratch-live arena) 0)))))

(defn scratch-main [] (-> i64)
  (scratch-accounting)
  (let [arena (primitive/alloc-stack scratch/ScratchArena)]
    (scratch/scratch-init-with-cap arena (alloc/malloc-allocator) 256)
    (let [a (scratch/scratch-allocator arena)]
      (match (alloc/raw-alloc a
                              (alloc/AllocRequest
                                :type-id 0
                                :count 64
                                :bytes 64
                                :align 8))
        (None [] 1)
        (Some [first]
              (let [mark (scratch/scratch-mark arena)]
                (match (alloc/raw-alloc a
                                        (alloc/AllocRequest
                                          :type-id 0
                                          :count 400
                                          :bytes 400
                                          :align 16))
                  (None [] 2)
                  (Some [later]
                        (do
                          (store! first (primitive/cast i8 11))
                          (store! later (primitive/cast i8 22))
                          (scratch/scratch-reset-to! arena mark)
                          (match (alloc/raw-remap a
                                                  first
                                                  (alloc/AllocRequest
                                                    :type-id 0
                                                    :count 64
                                                    :bytes 64
                                                    :align 8)
                                                  (alloc/AllocRequest
                                                    :type-id 0
                                                    :count 80
                                                    :bytes 80
                                                    :align 8))
                            (None [] 3)
                            (Some [grown]
                                  (do
                                    (store! grown (primitive/cast i8 33))
                                    (scratch/scratch-reset! arena)
                                    (match (alloc/raw-alloc a
                                                            (alloc/AllocRequest
                                                              :type-id 0
                                                              :count 32
                                                              :bytes 32
                                                              :align 8))
                                      (None [] 4)
                                      (Some [_]
                                            (do
                                              (scratch/scratch-close! arena)
                                              (scratch/scratch-close! arena)
                                              (if (scratch/scratch-closed? arena)
                                                  0
                                                  5))))))))))))))))

(deftest scratch-marks-resets-and-recycles
  (assert-eq (scratch-main) 0))

; ==== iterator adapters over every collection, with closures ====

(defclosure offsetter
            [(offset i64)]
            [(value i64)]
            i64
            (+ value offset))

(defclosure above
            [(threshold i64)]
            [(value i64)]
            bool
            (> value threshold))

(defclosure bonus-sum
            [(bonus i64)]
            [(total i64) (value i64)]
            i64
            (+ (+ total value) bonus))

(defn iter-double [(x i64)] (-> i64)
  (* x 2))

(defn iter-even? [(x i64)] (-> bool)
  (= (% x 2) 0))

(defn iter-under-ten? [(x i64)] (-> bool)
  (< x 10))

(defn iter-add [(a i64) (b i64)] (-> i64)
  (+ a b))

(defn iter-main [] (-> i64)
  (let [(mut values) [10 11 12 13]
        view (slice-new [i64] (primitive/index (mut values) 0) 4)]
    ; Every bundled collection reaches adapters through Iterable; a slice proves
    ; this is not a Range-specific implementation.
    (assert-eq (fold (primitive/fnptr-of iter-add)
                     0
                     (map (primitive/fnptr-of iter-double) view))
               92)
    ; Non-capturing anonymous functions infer their parameter and return types
    ; from Callable bounds, including through lazy adapter composition.
    (assert-eq (fold (fn [total value] (+ total value))
                     0
                     (map (fn [x] (+ x 2)) (range 0 10)))
               65)
    (assert-eq (count (filter (fn [x] (= (% x 2) 0)) (range 0 10))) 5)
    ; Infinite-capable composition remains bounded because take stops pulling.
    (assert-eq (fold (primitive/fnptr-of iter-add)
                     0
                     (take 3
                           (filter (primitive/fnptr-of iter-even?)
                                   (range 0 100))))
               6)
    (assert-eq (count (skip 3 (range 0 8))) 5)
    (assert-eq (count (chain (range 0 2) (range 5 8))) 5)
    (assert-eq (count (zip (range 0 10) (range 0 3))) 3)
    (assert-eq (count (enumerate view)) 4)
    (assert (any? (primitive/fnptr-of iter-even?) view))
    (assert (all? (primitive/fnptr-of iter-under-ten?) (range 0 10)))
    (match (find (primitive/fnptr-of iter-even?) view)
      (Some [value] (assert-eq value 10))
      (None [] (assert false)))
    ; Callback parameters are ordinary Callable values. Heap closures prove that
    ; captures work for unary lazy adapters, predicates, and binary consumers.
    (let [offset (offsetter-new 10)
          threshold (above-new 2)
          reducer (bonus-sum-new 1)]
      (assert-eq (fold (primitive/fnptr-of iter-add)
                       0
                       (map offset (range 0 3)))
                 33)
      (assert-eq (count (filter threshold (range 0 6))) 3)
      (assert-eq (fold reducer 0 (range 0 3)) 6)
      (offsetter-free offset)
      (above-free threshold)
      (bonus-sum-free reducer))
    ; The other bundled collection implementations use the same adapter entry.
    (let [allocator (malloc-allocator)
          (mut list) (al-new [i64] allocator)
          (mut table) (hm-new-scalar [i64 i64] allocator)]
      (push! (mut list) 1)
      (push! (mut list) 2)
      (push! (mut list) 3)
      (assert-eq (fold (primitive/fnptr-of iter-add) 0 list) 6)
      (set! (mut table) 7 70)
      (set! (mut table) 8 80)
      (assert-eq (count table) 2)
      (al-free! [i64] (mut list))
      (hm-free! [i64 i64] (mut table)))
    0))

(deftest iterator-adapters-reach-every-collection-and-closure
  (assert-eq (iter-main) 0))

; ==== grapheme clusters (UAX #29); the cluster iterator is an Iterable ====

;; Extended grapheme clusters (UAX #29): the number of user-perceived characters.
(defn grapheme-count [(bytes (slice u8))] (-> i64)
  (let [(mut it) (iter (grapheme/chars (string/string-view-unchecked bytes)))
        (mut count) 0]
    (loop (match (next (mut it))
            (None [] (break))
            (Some [_] (set! count (+ count 1)))))
    count))

(deftest grapheme-clusters-follow-uax29
  (assert-eq (grapheme-count "e\x301;") 1)  ; combining mark
  (assert-eq (grapheme-count "\r\n") 1)  ; CR LF
  (assert-eq (grapheme-count "a\nb") 3)  ; a control breaks
  (assert-eq (grapheme-count "\x1100;\x1161;\x11a8;") 1)  ; Hangul L V T
  (assert-eq (grapheme-count "\x1f468;\x200d;\x1f469;\x200d;\x1f467;") 1)  ; ZWJ sequence
  (assert-eq (grapheme-count "\x1f44d;\x1f3fd;") 1)  ; emoji modifier
  (assert-eq (grapheme-count "\x1f1fa;\x1f1f8;\x1f1e8;") 2)  ; flags pair from the start
  (assert-eq (grapheme-count "\x915;\x94d;\x915;") 1))

; Indic conjunct

(deftest grapheme-iterator-yields-borrowed-cluster-views
  (let [(mut it)
          (iter (grapheme/chars (string/string-view-unchecked "e\x301;x")))]
    (match (next (mut it))
      (None [] (assert false))
      (Some [c]
            (assert (= (grapheme/char-view c)
                       (string/string-view-unchecked "e\x301;")))))
    (match (next (mut it))
      (None [] (assert false))
      (Some [c]
            (assert (= (grapheme/char-view c)
                       (string/string-view-unchecked "x")))))
    (match (next (mut it))
      (None [] (assert true))
      (Some [_] (assert false)))))
