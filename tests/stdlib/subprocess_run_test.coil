(module subprocessruntest)
(import "coil.primitive" :as primitive)
(import "coil.alloc" :as alloc)
(import "coil.slice" :use [slice-new slice-len slice-data])
(import "coil.subprocess" :as subprocess)
(import "coil.cancellation" :as cancellation)
(import "coil.time" :as time)

(defn normal-run [] (-> i64)
  (let [args (primitive/alloc-stack (array (slice u8) 2))
        result (primitive/alloc-stack subprocess/RunResult)]
    (store! (primitive/index args 0) "-c")
    (store! (primitive/index args 1)
            "pwd; (yes o | head -c 100000) & (yes e | head -c 100000 >&2) & wait")
    (match (time/duration-seconds 5)
      (Err [_] 1)
      (Ok [timeout]
          (match (time/deadline-after timeout)
            (Err [_] 2)
            (Ok [deadline]
                (match (time/duration-millis 50)
                  (Err [_] 3)
                  (Ok [grace]
                      (let [options
                              (subprocess/run-options "/bin/sh"
                                                      (slice-new [(slice u8)]
                                                                 (primitive/cast (ptr (slice u8)) args)
                                                                 2)
                                                      "/tmp"
                                                      4
                                                      4
                                                      (Some deadline)
                                                      (primitive/cast (ptr cancellation/Cancellation) 0)
                                                      grace)]
                        (match (subprocess/run (alloc/malloc-allocator) result options)
                          (Err [_] 4)
                          (Ok [_]
                              (let [status-ok
                                      (match (load (field result status))
                                        (subprocess/Exited [code] (= code 0))
                                        (subprocess/Signaled [_] false))
                                    valid
                                      (and status-ok
                                           (and (= (slice-len (load (field result stdout))) 4)
                                                (and (= (slice-len (load (field result stderr))) 4)
                                                     (and (= (primitive/cast i64
                                                                             (load (primitive/cast (ptr u8)
                                                                                                   (slice-data (load (field result
                                                                                                                            stdout))))))
                                                             47)
                                                          (and (load (field result stdout-truncated))
                                                               (load (field result stderr-truncated)))))))]
                                (subprocess/run-result-free (alloc/malloc-allocator) result)
                                (if valid 0 5)))))))))))))

(defn timeout-run [] (-> i64)
  (let [args (primitive/alloc-stack (array (slice u8) 2))
        result (primitive/alloc-stack subprocess/RunResult)]
    (store! (primitive/index args 0) "-c")
    (store! (primitive/index args 1) "sleep 5")
    (match (time/duration-millis 30)
      (Err [_] 10)
      (Ok [timeout]
          (match (time/deadline-after timeout)
            (Err [_] 11)
            (Ok [deadline]
                (match (time/duration-millis 20)
                  (Err [_] 12)
                  (Ok [grace]
                      (let [options
                              (subprocess/run-options "/bin/sh"
                                                      (slice-new [(slice u8)]
                                                                 (primitive/cast (ptr (slice u8)) args)
                                                                 2)
                                                      ""
                                                      16
                                                      16
                                                      (Some deadline)
                                                      (primitive/cast (ptr cancellation/Cancellation) 0)
                                                      grace)]
                        (match (subprocess/run (alloc/malloc-allocator) result options)
                          (Err [_] 13)
                          (Ok [_]
                              (let [valid (load (field result timed-out))]
                                (subprocess/run-result-free (alloc/malloc-allocator) result)
                                (if valid 0 14)))))))))))))

(defn cancellation-run [] (-> i64)
  (let [args (primitive/alloc-stack (array (slice u8) 2))
        result (primitive/alloc-stack subprocess/RunResult)
        token (primitive/alloc-stack cancellation/Cancellation)]
    (store! (primitive/index args 0) "-c")
    (store! (primitive/index args 1) "sleep 5")
    (match (cancellation/cancellation-init token)
      (Err [_] 20)
      (Ok [_]
          (do
            (cancellation/cancellation-request! token)
            (match (time/duration-millis 20)
              (Err [_] 21)
              (Ok [grace]
                  (let [options
                          (subprocess/run-options "/bin/sh"
                                                  (slice-new [(slice u8)]
                                                             (primitive/cast (ptr (slice u8)) args)
                                                             2)
                                                  ""
                                                  16
                                                  16
                                                  (None [time/Instant])
                                                  token
                                                  grace)]
                    (match (subprocess/run (alloc/malloc-allocator) result options)
                      (Err [_] 22)
                      (Ok [_]
                          (let [valid (load (field result cancelled))]
                            (subprocess/run-result-free (alloc/malloc-allocator) result)
                            (cancellation/cancellation-close! token)
                            (if valid 0 23))))))))))))

(defn main [(argc i32) (argv (ptr (ptr i8)))] (-> i64)
  (let [a (normal-run)]
    (if (!= a 0)
        a
        (let [b (timeout-run)]
          (if (!= b 0) b (cancellation-run))))))
