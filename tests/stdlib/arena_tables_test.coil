(module stdlib-tests.arena-tables)
(import "coil.primitive" :as primitive)
(import "coil.alloc" :use *)
(import "coil.str" :use *)
(import "coil.slice" :use *)
(import "coil.arraylist" :use *)
(import "coil.hashmap" :use *)
(import "coil.persist" :use *)
(import "coil.scratch" :as scratch)
(import "coil.avec" :use *)
(import "coil.cc" :as cc)
(import "coil.amap" :use *)

(defn name-of [(a (dyn Allocator)) (k i64)] (-> (slice u8))
  (let [(mut b) (StrBuf::new a)]
    (push-str! (mut b) "key-")
    (push-i64! (mut b) k)
    (str b)))

(defn same-bytes? [(x (slice u8)) (y (slice u8))] (-> bool)
  (and (= (len x) (len y))
       (let [(mut same) true]
         (for [i 0 (len x)]
           (when (!= (get x i) (get y i)) (store! same false)))
         (load same))))

; A vector extended or changed through an edit leaves the one it was made from
; as it was, across every level of the trie.
(deftest a-vector-edit-leaves-the-original
  (let [a (malloc-allocator)
        (mut v) (avec-new [i64] a)]
    (for [i 0 3000] (push! (mut v) (* i 2)))
    (assert-eq (len v) 3000)
    (for [i 0 3000] (assert-eq (load (avec-at v i)) (* i 2)))
    (let [(mut w) (avec-edit v a)]
      (for [i 0 100] (push! (mut w) i))
      (set! (mut w) 0 -1)
      (set! (mut w) 1500 -2)
      (set! (mut w) 3050 -3)
      (assert-eq (len w) 3100)
      (assert-eq (load (avec-at w 0)) -1)
      (assert-eq (load (avec-at w 1500)) -2)
      (assert-eq (load (avec-at w 3050)) -3)
      (assert-eq (len v) 3000)
      (assert-eq (load (avec-at v 0)) 0)
      (assert-eq (load (avec-at v 1500)) 3000)
      (assert-eq (load (avec-at v 2999)) 5998)))
  ; a short vector's tail is short: an edit that grows it past its room, or
  ; past a whole leaf, leaves the short one as it was
  (let [a (malloc-allocator)
        (mut v) (avec-new [i64] a)]
    (for [i 0 3] (push! (mut v) i))
    (let [(mut w) (avec-edit v a)]
      (for [i 3 40] (push! (mut w) i))
      (set! (mut w) 1 -1)
      (assert-eq (len w) 40)
      (for [i 0 40] (assert-eq (load (avec-at w i)) (if (= i 1) -1 i)))
      (push! (mut v) 9)
      (assert-eq (len v) 4)
      (assert-eq (load (avec-at v 1)) 1)
      (assert-eq (load (avec-at v 3)) 9)
      (assert-eq (load (avec-at w 3)) 3)))
  ; popping back through a level and a leaf, and an edit's pops leaving the
  ; vector it was made from as it was
  (let [a (malloc-allocator)
        (mut v) (avec-new [i64] a)]
    (for [i 0 1100] (push! (mut v) i))
    (let [(mut w) (avec-edit v a)]
      (for [k 0 1100]
        (assert-eq (pop! (mut w)) (Some (- 1099 k)))
        (when (= (% k 97) 0)
          (assert-eq (len w) (- 1099 k))
          (for [i 0 (len w)] (assert-eq (load (avec-at w i)) i))))
      (assert-eq (pop! (mut w)) (None [i64]))
      (push! (mut w) 7)
      (assert-eq (load (avec-at w 0)) 7)
      (assert-eq (len v) 1100)
      (for [i 0 1100] (assert-eq (load (avec-at v i)) i)))))

; A map holds every key it was given, the last value of each, and forgets a
; removed one; an edit leaves the map it was made from as it was.
(deftest a-map-edit-leaves-the-original
  (let [a (malloc-allocator)
        (mut m) (amap-new [(slice u8) i64] (keyops) a)]
    (for [k 0 2000] (set! (mut m) (name-of a k) k))
    (set! (mut m) (name-of a 7) 70)
    (assert-eq (len m) 2000)
    (assert-eq (get m (name-of a 7)) (Some 70))
    (assert-eq (get m (name-of a 1999)) (Some 1999))
    (assert (match (get m "missing") (None [] true) (Some [_] false)))
    (let [(mut e) (amap-edit m a)]
      (for [k 0 2000] (when (= (% k 2) 0) (assert (remove! (mut e) (name-of a k))) 0))
      (assert (not (remove! (mut e) "missing")))
      (set! (mut e) (name-of a 1) 11)
      (assert-eq (len e) 1000)
      (assert (match (get e (name-of a 4)) (None [] true) (Some [_] false)))
      (assert-eq (get e (name-of a 1)) (Some 11))
      (assert-eq (len m) 2000)
      (assert-eq (get m (name-of a 4)) (Some 4))
      (assert-eq (get m (name-of a 1)) (Some 1)))))

(defn in-arena? [(cx (ptr i8)) (p (ptr i8))] (-> bool)
  (scratch/ScratchArena::owns-address? (primitive/cast (ptr scratch/ScratchArena) cx) p))

(defstruct Tables [(v (AVec i64)) (m (AMap (slice u8) i64))])
(derive Persist Tables)

; Copied back where the tables it was extended from live, an extended table
; shares every node it did not change.
(deftest a-sharing-copy-copies-only-the-edited-nodes
  (let [a (malloc-allocator)
        dest (primitive/alloc-stack scratch/ScratchArena)]
    (scratch/ScratchArena::init dest a)
    (let [d (scratch/ScratchArena::allocator dest)
          (mut v) (avec-new [i64] a)
          (mut m) (amap-new [(slice u8) i64] (keyops) a)]
      (for [i 0 1000] (push! (mut v) i))
      (for [k 0 500] (set! (mut m) (name-of a k) k))
      (let [kept (persist-clone (Tables :v v :m m) d)
            (mut v2) (avec-edit (field kept v) a)
            (mut m2) (amap-edit (field kept m) a)]
        (push! (mut v2) 1000)
        (set! (mut m2) "new" 1)
        (let [back (persist-clone-sharing (Tables :v v2 :m m2) d (fnptr-of in-arena?)
                                          (primitive/cast (ptr i8) dest))]
          ; the trie under the tail is the same nodes
          (assert-eq (primitive/cast i64 (.root (.v back))) (primitive/cast i64 (.root (.v kept))))
          (assert-eq (len (.v back)) 1001)
          (assert-eq (load (avec-at (field back v) 1000)) 1000)
          (assert-eq (get (field back m) "new") (Some 1))
          (assert-eq (get (field back m) (name-of a 499)) (Some 499))
          ; the copy lives where it was sent
          (assert (in-arena? (primitive/cast (ptr i8) dest) (primitive/cast (ptr i8) (.root (.m back))))))
        (scratch/ScratchArena::close! dest)))))

; Saved bytes depend on the entries, not on how the tables were made: a map
; that had keys removed writes what a map made with only the rest writes.
(deftest saved-tables-load-back-the-same
  (let [a (malloc-allocator)
        (mut v) (avec-new [i64] a)
        (mut m) (amap-new [(slice u8) i64] (keyops) a)
        (mut fresh) (amap-new [(slice u8) i64] (keyops) a)]
    (for [i 0 70] (push! (mut v) (* i i)))
    (for [k 0 300] (set! (mut m) (name-of a k) k))
    (for [k 0 300] (when (= (% k 3) 0) (remove! (mut m) (name-of a k)) 0))
    (for [k 0 300] (unless (= (% k 3) 0) (set! (mut fresh) (name-of a k) k) 0))
    (let [t (Tables :v v :m m)
          bytes (persist-save t a)]
      (assert (same-bytes? bytes (persist-save (Tables :v v :m fresh) a)))
      (match (persist-load [Tables] bytes a)
        (None [] (assert false))
        (Some [read]
          (let [c read]
            (assert-eq (len (.v c)) 70)
            (assert-eq (load (avec-at (field c v) 69)) (* 69 69))
            (assert-eq (len (.m c)) 200)
            (assert-eq (get (field c m) (name-of a 2)) (Some 2))
            (assert (match (get (field c m) (name-of a 3)) (None [] true) (Some [_] false)))
            (assert (same-bytes? (persist-save c a) bytes)))))
      (assert (match (persist-load [Tables] (subslice bytes 0 (- (len bytes) 1)) a)
                (None [] true) (Some [_] false))))))

; Twenty thousand puts and removes of a narrow key range, against a HashMap
; doing the same; a snapshot taken half way still holds what it held then.
(deftest a-map-agrees-with-a-hashmap
  (let [a (malloc-allocator)
        (mut m) (amap-new [i64 i64] (i64-keyops) a)
        (mut h) (HashMap::new [i64 i64] a (i64-keyops))
        (mut seed) 12345
        (mut snapshot) (amap-new [i64 i64] (i64-keyops) a)
        (mut at-snapshot) (HashMap::new [i64 i64] a (i64-keyops))]
    (for [step 0 20000]
      (store! seed (% (+ (* (load seed) 1103515245) 12345) 2147483648))
      (let [k (% (load seed) 3000)
            put (!= (% (primitive/ishr (load seed) 12) 3) 0)]
        (if put
            (do (set! (mut m) k step) (set! (mut h) k step) 0)
            (do (assert-eq (remove! (mut m) k) (contains? h k))
                (remove! (mut h) k)
                0)))
      (when (= step 10000)
        (store! snapshot (load m))
        (store! m (amap-edit (mut snapshot) a))
        (for [k 0 3000]
          (match (get h k) (Some [v] (set! (mut at-snapshot) k v)) (None [] 0)))
        0))
    (assert-eq (len m) (len h))
    (for [k 0 3000]
      (assert-eq (get m k) (get h k))
      (assert-eq (get snapshot k) (get at-snapshot k)))))

; Keys whose hashes collide (seven hashes for all of them): collision nodes,
; a collision node moved under a bitmap node, and removal from both, against a
; HashMap doing the same.
(defn seven-hash [(p (ptr i8)) (n i64)] (-> i64)
  (% (load (primitive/cast (ptr i64) p)) 7))

(defn seven-keyops [] (-> (ptr KeyOps))
  (primitive/alloc-static KeyOps
                          (KeyOps :hash (primitive/fnptr-of seven-hash)
                                  :eq (primitive/fnptr-of bytewise-eq)
                                  :size (primitive/sizeof i64)
                                  :copy (primitive/zeroed (fnptr (cc/C) [(ptr (dyn Allocator)) (ptr i8)] i64))
                                  :free (primitive/zeroed (fnptr (cc/C) [(ptr (dyn Allocator)) (ptr i8)] i64))
                                  :owns 0)))

(deftest colliding-keys-agree-with-a-hashmap
  (let [a (malloc-allocator)
        (mut m) (amap-new [i64 i64] (seven-keyops) a)
        (mut h) (HashMap::new [i64 i64] a (i64-keyops))
        (mut seed) 99]
    (for [step 0 4000]
      (store! seed (% (+ (* (load seed) 1103515245) 12345) 2147483648))
      (let [k (% (load seed) 200)]
        (if (!= (% (primitive/ishr (load seed) 12) 3) 0)
            (do (set! (mut m) k step) (set! (mut h) k step) 0)
            (do (assert-eq (remove! (mut m) k) (contains? h k))
                (remove! (mut h) k)
                0))))
    (assert-eq (len m) (len h))
    (assert-eq (len (amap-entries m a)) (len h))
    (for [k 0 200] (assert-eq (get m k) (get h k)))))

; A vector reads and is written as a list is: `get` copies, `at` and `elem` lend,
; iteration lends each element in order, and `elem-mut` writes an element of an
; edit without changing the vector it was made from.
(defstruct Cell [(n i64)])

(deftest a-vector-reads-and-writes-as-a-list
  (let [a (malloc-allocator)
        (mut v) (avec-new [Cell] a)]
    (for [i 0 100] (push! (mut v) (Cell :n i)))
    (assert-eq (.n (get v 40)) 40)
    (assert-eq (.n (at v 41)) 41)
    (assert-eq (.n (elem v 42)) 42)
    (let [(mut sum) 0]
      (for (ref c) v (store! sum (+ (load sum) (.n c))))
      (assert-eq (load sum) 4950))
    (let [(mut w) (avec-edit v a)]
      (set! (.n (elem-mut (mut w) 7)) 700)
      (set! (mut w) 8 (Cell :n 800))
      (assert-eq (.n (at w 7)) 700)
      (assert-eq (.n (at w 8)) 800)
      (assert-eq (.n (at v 7)) 7)
      (assert-eq (.n (at v 8)) 8))))
