(module stdlib-tests.arena-tables)
(import "coil.primitive" :as primitive)
(import "coil.alloc" :use *)
(import "coil.str" :use *)
(import "coil.slice" :use *)
(import "coil.arraylist" :use *)
(import "coil.hashmap" :use *)
(import "coil.persist" :use *)
(import "coil.scratch" :as scratch)
(import "coil.avec" :use *)
(import "coil.amap" :use *)

(defn name-of [(a (dyn Allocator)) (k i64)] (-> (slice u8))
  (let [(mut b) (StrBuf::new a)]
    (push-str! (mut b) "key-")
    (push-i64! (mut b) k)
    (str b)))

(defn same-bytes? [(x (slice u8)) (y (slice u8))] (-> bool)
  (and (= (len x) (len y))
       (let [(mut same) true]
         (for [i 0 (len x)]
           (when (!= (get x i) (get y i)) (store! same false)))
         (load same))))

; A vector extended or changed through an edit leaves the one it was made from
; as it was, across every level of the trie.
(deftest a-vector-edit-leaves-the-original
  (let [a (malloc-allocator)
        (mut v) (avec-new [i64])]
    (for [i 0 3000] (avec-push! (mut v) a (* i 2)))
    (assert-eq (len v) 3000)
    (for [i 0 3000] (assert-eq (load (avec-at v i)) (* i 2)))
    (let [(mut w) (avec-edit v)]
      (for [i 0 100] (avec-push! (mut w) a i))
      (avec-set! (mut w) a 0 -1)
      (avec-set! (mut w) a 1500 -2)
      (avec-set! (mut w) a 3050 -3)
      (assert-eq (len w) 3100)
      (assert-eq (load (avec-at w 0)) -1)
      (assert-eq (load (avec-at w 1500)) -2)
      (assert-eq (load (avec-at w 3050)) -3)
      (assert-eq (len v) 3000)
      (assert-eq (load (avec-at v 0)) 0)
      (assert-eq (load (avec-at v 1500)) 3000)
      (assert-eq (load (avec-at v 2999)) 5998))))

; A map holds every key it was given, the last value of each, and forgets a
; removed one; an edit leaves the map it was made from as it was.
(deftest a-map-edit-leaves-the-original
  (let [a (malloc-allocator)
        (mut m) (amap-new [(slice u8) i64] (keyops))]
    (for [k 0 2000] (amap-put! (mut m) a (name-of a k) k))
    (amap-put! (mut m) a (name-of a 7) 70)
    (assert-eq (len m) 2000)
    (assert-eq (amap-get m (name-of a 7)) (Some 70))
    (assert-eq (amap-get m (name-of a 1999)) (Some 1999))
    (assert (match (amap-get m "missing") (None [] true) (Some [_] false)))
    (let [(mut e) (amap-edit m)]
      (for [k 0 2000] (when (= (% k 2) 0) (assert (amap-remove! (mut e) a (name-of a k))) 0))
      (assert (not (amap-remove! (mut e) a "missing")))
      (amap-put! (mut e) a (name-of a 1) 11)
      (assert-eq (len e) 1000)
      (assert (match (amap-get e (name-of a 4)) (None [] true) (Some [_] false)))
      (assert-eq (amap-get e (name-of a 1)) (Some 11))
      (assert-eq (len m) 2000)
      (assert-eq (amap-get m (name-of a 4)) (Some 4))
      (assert-eq (amap-get m (name-of a 1)) (Some 1)))))

(defn in-arena? [(cx (ptr i8)) (p (ptr i8))] (-> bool)
  (scratch/ScratchArena::owns-address? (primitive/cast (ptr scratch/ScratchArena) cx) p))

(defstruct Tables [(v (AVec i64)) (m (AMap (slice u8) i64))])
(derive Persist Tables)

; Copied back where the tables it was extended from live, an extended table
; shares every node it did not change.
(deftest a-sharing-copy-copies-only-the-edited-nodes
  (let [a (malloc-allocator)
        dest (primitive/alloc-stack scratch/ScratchArena)]
    (scratch/ScratchArena::init dest a)
    (let [d (scratch/ScratchArena::allocator dest)
          (mut v) (avec-new [i64])
          (mut m) (amap-new [(slice u8) i64] (keyops))]
      (for [i 0 1000] (avec-push! (mut v) a i))
      (for [k 0 500] (amap-put! (mut m) a (name-of a k) k))
      (let [kept (persist-clone (Tables :v v :m m) d)
            (mut v2) (avec-edit (field kept v))
            (mut m2) (amap-edit (field kept m))]
        (avec-push! (mut v2) a 1000)
        (amap-put! (mut m2) a "new" 1)
        (let [back (persist-clone-sharing (Tables :v v2 :m m2) d (fnptr-of in-arena?)
                                          (primitive/cast (ptr i8) dest))]
          ; the trie under the tail is the same nodes
          (assert-eq (primitive/cast i64 (.root (.v back))) (primitive/cast i64 (.root (.v kept))))
          (assert-eq (len (.v back)) 1001)
          (assert-eq (load (avec-at (field back v) 1000)) 1000)
          (assert-eq (amap-get (field back m) "new") (Some 1))
          (assert-eq (amap-get (field back m) (name-of a 499)) (Some 499))
          ; the copy lives where it was sent
          (assert (in-arena? (primitive/cast (ptr i8) dest) (primitive/cast (ptr i8) (.root (.m back))))))
        (scratch/ScratchArena::close! dest)))))

; Saved bytes depend on the entries, not on how the tables were made: a map
; that had keys removed writes what a map made with only the rest writes.
(deftest saved-tables-load-back-the-same
  (let [a (malloc-allocator)
        (mut v) (avec-new [i64])
        (mut m) (amap-new [(slice u8) i64] (keyops))
        (mut fresh) (amap-new [(slice u8) i64] (keyops))]
    (for [i 0 70] (avec-push! (mut v) a (* i i)))
    (for [k 0 300] (amap-put! (mut m) a (name-of a k) k))
    (for [k 0 300] (when (= (% k 3) 0) (amap-remove! (mut m) a (name-of a k)) 0))
    (for [k 0 300] (unless (= (% k 3) 0) (amap-put! (mut fresh) a (name-of a k) k) 0))
    (let [t (Tables :v v :m m)
          bytes (persist-save t a)]
      (assert (same-bytes? bytes (persist-save (Tables :v v :m fresh) a)))
      (match (persist-load [Tables] bytes a)
        (None [] (assert false))
        (Some [read]
          (let [c read]
            (assert-eq (len (.v c)) 70)
            (assert-eq (load (avec-at (field c v) 69)) (* 69 69))
            (assert-eq (len (.m c)) 200)
            (assert-eq (amap-get (field c m) (name-of a 2)) (Some 2))
            (assert (match (amap-get (field c m) (name-of a 3)) (None [] true) (Some [_] false)))
            (assert (same-bytes? (persist-save c a) bytes)))))
      (assert (match (persist-load [Tables] (subslice bytes 0 (- (len bytes) 1)) a)
                (None [] true) (Some [_] false))))))

; Twenty thousand puts and removes of a narrow key range, against a HashMap
; doing the same; a snapshot taken half way still holds what it held then.
(deftest a-map-agrees-with-a-hashmap
  (let [a (malloc-allocator)
        (mut m) (amap-new [i64 i64] (i64-keyops))
        (mut h) (HashMap::new [i64 i64] a (i64-keyops))
        (mut seed) 12345
        (mut snapshot) (amap-new [i64 i64] (i64-keyops))
        (mut at-snapshot) (HashMap::new [i64 i64] a (i64-keyops))]
    (for [step 0 20000]
      (store! seed (% (+ (* (load seed) 1103515245) 12345) 2147483648))
      (let [k (% (load seed) 3000)
            put (!= (% (primitive/ishr (load seed) 12) 3) 0)]
        (if put
            (do (amap-put! (mut m) a k step) (set! (mut h) k step) 0)
            (do (assert-eq (amap-remove! (mut m) a k) (contains? h k))
                (remove! (mut h) k)
                0)))
      (when (= step 10000)
        (store! snapshot (load m))
        (store! m (amap-edit (mut snapshot)))
        (for [k 0 3000]
          (match (get h k) (Some [v] (set! (mut at-snapshot) k v)) (None [] 0)))
        0))
    (assert-eq (len m) (len h))
    (for [k 0 3000]
      (assert-eq (amap-get m k) (get h k))
      (assert-eq (amap-get snapshot k) (get at-snapshot k)))))
