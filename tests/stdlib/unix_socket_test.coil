(module unixsockettest)
(import "coil.primitive" :as primitive)
(import "coil.alloc" :as alloc)
(import "coil.socket" :as socket)
(import "coil.str" :as str)
(import "coil.time" :as time)
(import "coil.os" :as os)

(defn close-on-exec? [(fd i32)] (-> bool)
  (= (primitive/iand (os/fcntl fd 1) 1) 1))

(defn expected-timeout-error-code [] (-> Code)
  (if (primitive/code-eq (primitive/target-os) `linux) `610 `560))

;;; The stdlib deliberately does not unlink socket paths (it cannot tell a stale
;;; socket from a live one), so the test owns the path's lifecycle. Declaring the
;;; extern here rather than in coil.socket also keeps it out of any binary that
;;; already declares `unlink` -- externs are not deduped across modules.
(extern unlink :cc c [(ptr i8)] (-> i32))

(const SOCKET_PATH "/tmp/coil-unix-socket-test.sock")

(defn remove-stale-path [] (-> i64)
  (let [allocator (alloc/malloc-allocator)
        c-path (str/str->cstr allocator SOCKET_PATH)]
    (if (= (primitive/cast i64 c-path) 0)
        1
        (do
          (unlink c-path)
          0))))

(defn main [(argc i32) (argv (ptr (ptr i8)))] (-> i64)
  (let [listener (primitive/alloc-stack socket/UnixListener)
        client (primitive/alloc-stack socket/UnixConnection)
        server (primitive/alloc-stack socket/UnixConnection)]
    (remove-stale-path)
    (match (socket/unix-listen listener SOCKET_PATH 8)
      (Err [error] (socket/socket-error-code error))
      (Ok [_]
          (match (socket/unix-connect client SOCKET_PATH)
            (Err [_] 3)
            (Ok [_]
                (match (time/duration-seconds 1)
                  (Err [_] 4)
                  (Ok [duration]
                      (match (socket/unix-accept-for listener server duration)
                        (Err [_] 5)
                        (Ok [_]
                            (let [out (primitive/alloc-stack i8)
                                  input (primitive/alloc-stack i8)]
                              (store! out (primitive/cast i8 42))
                              (match (socket/unix-write client out 1)
                                (Err [_] 6)
                                (Ok [_]
                                    (match (socket/unix-read server input 1)
                                      (Err [_] 7)
                                      (Ok [count]
                                          (let [timeout-ok
                                                  (match (time/duration-millis 10)
                                                    (Err [_] false)
                                                    (Ok [short]
                                                        (match (socket/unix-accept-for listener server short)
                                                          (Err [error]
                                                               (and (socket/socket-accept-timeout? error)
                                                                    (= (socket/socket-error-code error)
                                                                       (expected-timeout-error-code))))
                                                          (Ok [_] false))))
                                                result
                                                  (if (and (= count 1)
                                                           (= (primitive/cast i64
                                                                              (load input))
                                                              42)
                                                           (close-on-exec? (load (field listener fd)))
                                                           (close-on-exec? (load (field client fd)))
                                                           (close-on-exec? (load (field server fd))))
                                                      (if timeout-ok 0 9)
                                                      8)]
                                            (socket/unix-connection-close! server)
                                            (socket/unix-connection-close! client)
                                            (socket/unix-listener-close! listener)
                                            (remove-stale-path)
                                            result))))))))))))))))
