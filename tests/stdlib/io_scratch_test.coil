(module io-scratch-test)
(import "coil.primitive" :as primitive)
(import "coil.alloc" :as alloc)
(import "coil.io" :as io)
(import "coil.scratch" :as scratch)
(import "coil.slice" :use [slice-len slice-data])
(import "coil.str" :as str)

(defstruct MemoryReader
  [(bytes (slice u8))
   (pos i64)
   (intervening-allocator (dyn alloc/Allocator))
   (intervening-at i64)])

(defn memory-read [(ctx (ptr i8)) (buf (ptr i8)) (len i64)] (-> (Result i64 io/IoError))
  (let [state (primitive/cast (ptr MemoryReader) ctx)
        pos (load (field state pos))
        bytes (load (field state bytes))]
    (if (>= pos (slice-len bytes))
        (Ok 0)
        (do
          (when (= pos (load (field state intervening-at)))
            (match (alloc/raw-alloc (load (field state intervening-allocator))
                                    (alloc/AllocRequest :type-id 0 :count 8 :bytes 8 :align 1))
              (None [] 0)
              (Some [p] (store! p (primitive/cast i8 99)))))
          (store! buf (primitive/cast i8 (load (primitive/index (slice-data bytes) pos))))
          (store! (field state pos) (primitive/iadd pos 1))
          (Ok 1)))))

(defn init-reader [(reader (ptr io/Reader))
                   (state (ptr MemoryReader))
                   (bytes (slice u8))
                   (a (dyn alloc/Allocator))
                   (intervening-at i64)] (-> i64)
  (store! (field state bytes) bytes)
  (store! (field state pos) 0)
  (store! (field state intervening-allocator) a)
  (store! (field state intervening-at) intervening-at)
  (store! (field reader read-fn) (primitive/fnptr-of memory-read))
  (store! (field reader ctx) (primitive/cast (ptr i8) state))
  0)

(defn check-line [(text (slice u8)) (intervening-at i64) (expected (slice u8))] (-> i64)
  (let [arena (primitive/alloc-stack scratch/ScratchArena)
        reader (primitive/alloc-stack io/Reader)
        state (primitive/alloc-stack MemoryReader)]
    (scratch/scratch-init-with-cap arena (alloc/malloc-allocator) 256)
    (let [a (scratch/scratch-allocator arena)]
      (init-reader reader state text a intervening-at)
      (match (io/read-line-alloc a reader 512)
        (Err [e]
             (let [code
                     (match e
                       (io/Eof [] 1)
                       (io/Errno [_] 2)
                       (io/LineTooLong [] 3)
                       (io/OutOfMemory [] 4)
                       (io/InvalidLimit [] 5))]
               (scratch/scratch-close! arena)
               code))
        (Ok [line]
            (let [linep (primitive/alloc-stack io/OwnedBytes)
                  actual (io/owned-bytes-slice line)]
              (store! linep line)
              (let [ok (str/str-eq actual expected)]
                (io/owned-bytes-free a linep)
                (scratch/scratch-close! arena)
                (if ok 0 2))))))))

(defn check-limit [] (-> i64)
  (let [arena (primitive/alloc-stack scratch/ScratchArena)
        reader (primitive/alloc-stack io/Reader)
        state (primitive/alloc-stack MemoryReader)]
    (scratch/scratch-init-with-cap arena (alloc/malloc-allocator) 256)
    (let [a (scratch/scratch-allocator arena)]
      (init-reader reader state "abcdef" a -1)
      (let [result
              (match (io/read-line-alloc a reader 5)
                (Err [e]
                     (match e
                       (io/LineTooLong [] 0)
                       (io/Eof [] 1)
                       (io/Errno [_] 1)
                       (io/OutOfMemory [] 1)
                       (io/InvalidLimit [] 1)))
                (Ok [line]
                    (let [linep (primitive/alloc-stack io/OwnedBytes)]
                      (store! linep line)
                      (io/owned-bytes-free a linep)
                      2)))]
        (scratch/scratch-close! arena)
        result))))

(defstruct FailingAllocator
  [(buffer (array i8 64)) (allocated bool)])

(defn failing-alloc [(ctx (ptr i8)) (size i64) (align i64)] (-> (Option (ptr i8)))
  (let [state (primitive/cast (ptr FailingAllocator) ctx)]
    (if (or (load (field state allocated)) (> size 64))
        (None)
        (do
          (store! (field state allocated) true)
          (Some (primitive/cast (ptr i8) (field state buffer)))))))

(defn failing-resize [(ctx (ptr i8))
                      (data (ptr i8))
                      (old i64)
                      (new i64)
                      (align i64)] (-> (Option (ptr i8)))
  (None))

(defn failing-free [(ctx (ptr i8)) (data (ptr i8)) (size i64) (align i64)] (-> i64)
  0)

(defn check-oom [] (-> i64)
  (let [a (primitive/alloc-stack alloc/Allocator)
        allocator-state (primitive/alloc-stack FailingAllocator)
        reader (primitive/alloc-stack io/Reader)
        state (primitive/alloc-stack MemoryReader)]
    (store! (field allocator-state allocated) false)
    (store! (field a alloc) (primitive/fnptr-of failing-alloc))
    (store! (field a resize) (primitive/fnptr-of failing-resize))
    (store! (field a free) (primitive/fnptr-of failing-free))
    (store! (field a ctx) (primitive/cast (ptr i8) allocator-state))
    (init-reader reader
                 state
                 "this line is longer than sixty-four bytes so resize and replacement allocation both fail"
                 a
                 -1)
    (match (io/read-line-alloc a reader 128)
      (Err [e]
           (match e
             (io/OutOfMemory [] 0)
             (io/Eof [] 1)
             (io/Errno [_] 1)
             (io/LineTooLong [] 1)
             (io/InvalidLimit [] 1)))
      (Ok [line]
          (let [linep (primitive/alloc-stack io/OwnedBytes)]
            (store! linep line)
            (io/owned-bytes-free a linep)
            2)))))

(defn main [(argc i32) (argv (ptr (ptr i8)))] (-> i64)
  (let [long-line
          ""
        tail-result (check-line long-line -1 long-line)]
    (if (!= tail-result 0)
        tail-result
        (let [non-tail-line
                "preserved across non-tail growth even when the original allocation has another live allocation after it"
              non-tail-result (check-line non-tail-line 1 non-tail-line)]
          (if (!= non-tail-result 0)
              (primitive/iadd 10 non-tail-result)
              (let [limit-result (check-limit)]
                (if (!= limit-result 0)
                    (primitive/iadd 20 limit-result)
                    (let [oom-result (check-oom)]
                      (if (!= oom-result 0) (primitive/iadd 30 oom-result) 0)))))))))
