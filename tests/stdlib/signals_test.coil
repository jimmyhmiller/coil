(module signalstest)
(import "coil.primitive" :as primitive)
(import "coil.alloc" :as alloc)
(import "coil.slice" :use [slice-new])
(import "coil.os" :as os)
(import "coil.selectors" :as selectors)
(import "coil.signals" :as signals)
(import "coil.time" :as time)

(defn main [(argc i32) (argv (ptr (ptr i8)))] (-> i64)
  (let [subscription (alloc/stack signals/SignalSubscription)
        numbers (alloc/stack (array i32 1))]
    (store! (primitive/index numbers 0) (primitive/cast i32 10))
    (match (signals/signal-subscribe subscription
                                     (slice-new [i32] (primitive/cast (ptr i32) numbers) 1))
      (Err [_] 1)
      (Ok [_]
          (do
            (os/kill (os/getpid) 10)
            (match (time/duration-seconds 1)
              (Err [_] 2)
              (Ok [duration]
                  (let [watches (alloc/stack (array selectors/Watch 1))]
                    (store! (primitive/index watches 0) (signals/signal-watch subscription 99))
                    (match (selectors/wait-many-for (alloc/malloc-allocator)
                                                    (slice-new [selectors/Watch]
                                                               (primitive/cast (ptr selectors/Watch) watches)
                                                               1)
                                                    duration)
                      (Err [_] 3)
                      (Ok [_]
                          (match (signals/signal-read subscription)
                            (Err [_] 4)
                            (Ok [number]
                                (let [result (if (= number 10) 0 5)]
                                  (signals/signal-close! subscription)
                                  result)))))))))))))
