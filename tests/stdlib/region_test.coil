(module regiontest)
(import "coil.primitive" :as primitive)
(import "coil.alloc" :as alloc)
(import "coil.region" :as region)
(import "coil.slice" :use [slice-data])

(defn main [(argc i32) (argv (ptr (ptr i8)))] (-> i64)
  (let [scope (primitive/alloc-stack region/Region)]
    (region/region-init scope (alloc/malloc-allocator))
    (let [a (region/region-allocator scope)]
      (match (alloc/raw-alloc a (alloc/AllocRequest :type-id 0 :count 13 :bytes 13 :align 8))
        (None [] 1)
        (Some [p]
              (match (alloc/raw-remap a p
                                      (alloc/AllocRequest :type-id 0 :count 13 :bytes 13 :align 8)
                                      (alloc/AllocRequest :type-id 0 :count 29 :bytes 29 :align 8))
                (None [] 2)
                (Some [q]
                      (do
                        (store! q (primitive/cast i8 42))
                        ;; Empty typed storage grows through the typed API rather
                        ;; than smuggling allocation through resize(NULL, ...).
                        (match (alloc/alloc-bytes a 17 8)
                          (None [] 3)
                          (Some [initial]
                                (do
                                  (store! (slice-data initial) (primitive/cast u8 7))
                                  (region/region-close! scope)
                                  (region/region-close! scope)
                                  (if (region/region-closed? scope) 0 4))))))))))))
