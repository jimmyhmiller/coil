(module regiontest)
(import "coil.primitive" :as primitive)
(import "coil.alloc" :as alloc)
(import "coil.region" :as region)

(defn main [(argc i32) (argv (ptr (ptr i8)))] (-> i64)
  (let [scope (alloc/stack region/Region)]
    (region/region-init scope (alloc/malloc-allocator))
    (let [a (region/region-allocator scope)]
      (match (alloc/raw-alloc a 13 8)
        (None [] 1)
        (Some [p]
              (match (alloc/raw-resize a p 13 29 8)
                (None [] 2)
                (Some [q]
                      (do
                        (store! q (primitive/cast i8 42))
                        ;; Growable collections request their initial storage with
                        ;; resize(NULL, 0, size). Region must treat that as an
                        ;; allocation rather than looking for a nonexistent owner.
                        (match (alloc/raw-resize a (primitive/cast (ptr i8) 0) 0 17 8)
                          (None [] 3)
                          (Some [initial]
                                (do
                                  (store! initial (primitive/cast i8 7))
                                  (region/region-close! scope)
                                  (region/region-close! scope)
                                  (if (region/region-closed? scope) 0 4))))))))))))
