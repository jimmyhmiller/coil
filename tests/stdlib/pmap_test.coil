(module pmaptest)
(import "coil.primitive" :as primitive)
(import "coil.alloc" :as alloc :use *)
(import "coil.result" :use *)
(import "coil.hashmap" :use *)
(import "coil.dbgalloc" :use *)
(import "coil.pmap" :use *)

; ---- a value that counts its own lifetime ---------------------------------------
(defn live-tokens [] (-> (ptr i64))
  (primitive/alloc-static i64))

(defstruct Token [(id i64)])

(defn token [(id i64)] (-> Token)
  (set! (live-tokens) (+ (load (live-tokens)) 1))
  (Token :id id))

(impl Clone Token
  (clone [(self (ref Token))] (-> Token) (token (.id self))))

(impl Drop Token
  (drop [(self (mut Token))]
        (-> void)
        (set! (live-tokens) (- (load (live-tokens)) 1))))

; ---- a leak-checked lease ------------------------------------------------------
(defn lease-noop [(state (ptr i8))] (-> i64)
  0)

; The debug allocator outlives every map in a test, so its lease needs no state.
(defn checked-lease [(debug (ptr DebugAllocator))] (-> AllocatorLease)
  (unsafe-allocator-lease-new (debug-allocator-view debug)
                              (primitive/cast (ptr i8) 0)
                              (primitive/fnptr-of lease-noop)
                              (primitive/fnptr-of lease-noop)))

; Every key hashes alike, so every key collides on all thirteen fragments.
(defn colliding-hash [(p (ptr i8)) (n i64)] (-> i64)
  7)

; Only the low five bits vary: keys share every fragment but the first.
(defn shallow-hash [(p (ptr i8)) (n i64)] (-> i64)
  (primitive/iand (load (primitive/cast (ptr i64) p)) 31))

(defn keyops-with [(hash (fnptr c [(ptr i8) i64] i64))] (-> (ptr KeyOps))
  (let [ops (primitive/alloc-static KeyOps)]
    (set! (.hash ops) hash)
    (set! (.eq ops) (primitive/fnptr-of i64-key-eq))
    (set! (.size ops) (primitive/sizeof i64))
    ops))

(defn value-of [(m (ref (PMap i64 i64))) (key i64)] (-> i64)
  (match (pm-get m key) (Some [v] v) (None [] -1)))

; A deterministic generator, so a failure reproduces.
(defn step [(state (ptr i64))] (-> i64)
  (let [next
          (primitive/iadd (primitive/imul (load state) 6364136223846793005)
                          1442695040888963407)]
    (set! state next)
    (primitive/iand (primitive/ishr next 33) 1073741823)))

;;; Drive a PMap and a HashMap with the same edits and demand they agree, then
;;; demand that a snapshot taken halfway still holds exactly what it held.
(defn agrees-with-hashmap [(ops (ptr KeyOps)) (key-space i64) (edits i64)] (-> i64)
  (let [debug (debug-allocator-init (malloc-allocator))]
    (let [(mut m) (pm-new [i64 i64] (checked-lease debug) ops)
          (mut model) (hm-new-scalar [i64 i64] (malloc-allocator))
          (mut frozen-model) (hm-new-scalar [i64 i64] (malloc-allocator))
          (mut frozen) (clone m)
          state (primitive/alloc-stack i64)]
      (set! state 12345)
      (for [i 0 edits]
        (let [key (% (step state) key-space)]
          (when (= i (/ edits 2))
            (set! frozen (clone m))
            (hm-for [k v (mut model)] (set! (mut frozen-model) k v))
            0)
          (if (= (% (step state) 3) 0)
              (assert-eq (pm-dissoc! (mut m) key) (hm-remove! (mut model) key))
              (let [value (step state)
                    fresh (if (hm-contains? model key) 0 1)]
                (assert-eq (pm-assoc! (mut m) key value) fresh)
                (set! (mut model) key value)
                0))
          (assert-eq (pm-len m) (len model))))
      (for [key 0 key-space]
        (assert-eq (value-of m key)
                   (match (get model key) (Some [v] v) (None [] -1)))
        (assert-eq (value-of frozen key)
                   (match (get frozen-model key) (Some [v] v) (None [] -1))))
      (assert-eq (pm-len frozen) (len frozen-model))
      (let [(mut it) (pm-iter m)
            (mut seen) 0]
        (loop (match (next (mut it))
                (None [] (break))
                (Some [e]
                      (do
                        (assert-eq (.val e)
                                   (match (get model (.key e))
                                     (Some [v] v)
                                     (None [] -1)))
                        (set! seen (+ (load seen) 1))
                        0))))
        (assert-eq (load seen) (pm-len m)))
      (hm-free! (mut model))
      (hm-free! (mut frozen-model))
      0)
    (assert-eq (debug-allocator-deinit! debug) 0)
    0))

(deftest agrees-with-hashmap-under-a-real-hash
         (agrees-with-hashmap (i64-keyops) 4096 40000))

(deftest agrees-with-hashmap-when-every-key-collides
         (agrees-with-hashmap (keyops-with (primitive/fnptr-of colliding-hash))
                              40
                              4000))

(deftest agrees-with-hashmap-when-only-one-fragment-varies
         (agrees-with-hashmap (keyops-with (primitive/fnptr-of shallow-hash))
                              300
                              8000))

(deftest an-update-leaves-the-old-map-alone
         (let [a (pm-new-scalar [i64 i64] (malloc-allocator-lease))
               b (pm-assoc a 7 42)
               c (pm-assoc b 7 43)
               d (pm-dissoc c 7)]
           (assert-eq (pm-len a) 0)
           (assert-eq (value-of a 7) -1)
           (assert-eq (value-of b 7) 42)
           (assert-eq (value-of c 7) 43)
           (assert-eq (pm-len c) 1)
           (assert-eq (value-of d 7) -1)
           (assert (pm-empty? d))))

(deftest a-clone-shares-until-edited
         (let [(mut a) (pm-new-scalar [i64 i64] (malloc-allocator-lease))]
           (for [i 0 1000] (pm-assoc! (mut a) i (* i 2)))
           (let [(mut b) (clone a)]
             (assert (pm-same? a b))
             (pm-assoc! (mut b) 500 -5)
             (assert (not (pm-same? a b)))
             (assert-eq (value-of a 500) 1000)
             (assert-eq (value-of b 500) -5)
             (assert-eq (pm-dissoc! (mut b) 123456) 0)
             (assert-eq (pm-len b) 1000))))

;;; One update to a shared map of n entries allocates a path, not a map.
(deftest an-update-copies-only-a-path
         (let [debug (debug-allocator-init (malloc-allocator))]
           (let [(mut a) (pm-new [i64 i64] (checked-lease debug) (i64-keyops))]
             (for [i 0 20000] (pm-assoc! (mut a) i i))
             (let [before (.live-allocations debug)
                   b (pm-assoc a 77 -1)
                   grown (- (.live-allocations debug) before)]
               ; At most 14 levels, each a node plus its two arrays.
               (assert (> grown 0))
               (assert (<= grown 42))
               (assert-eq (value-of a 77) 77)
               (assert-eq (value-of b 77) -1)))
           (assert-eq (debug-allocator-deinit! debug) 0)))

;;; Owned values are cloned by a copied node and dropped by a freed one, exactly
;;; once each, through every structural case.
(defn values-balance [(ops (ptr KeyOps))] (-> i64)
  (let [debug (debug-allocator-init (malloc-allocator))]
    (set! (live-tokens) 0)
    (let [(mut a) (pm-new [i64 Token] (checked-lease debug) ops)]
      (for [i 0 200] (pm-assoc! (mut a) i (token i)))
      (assert-eq (load (live-tokens)) 200)
      (for [i 0 100] (pm-assoc! (mut a) i (token (+ i 1000))))
      (assert-eq (load (live-tokens)) 200)
      (let [(mut b) (clone a)]
        (assert-eq (load (live-tokens)) 200)
        (for [i 0 200] (when (= (% i 2) 0) (pm-dissoc! (mut b) i) 0))
        (for [i 200 260] (pm-assoc! (mut b) i (token i)))
        (assert-eq (pm-len a) 200)
        (assert-eq (pm-len b) 160)
        (match (pm-get-ptr a 4)
          (Some [value] (assert-eq (.id value) 1004))
          (None [] (assert false)))
        (assert (not (pm-contains? b 4)))
        0)
      ; b is gone: only a's two hundred remain, however many nodes they shared.
      (assert-eq (load (live-tokens)) 200)
      (for [i 0 200] (pm-dissoc! (mut a) i))
      (assert-eq (load (live-tokens)) 0)
      (assert (pm-empty? a))
      0)
    (assert-eq (load (live-tokens)) 0)
    (assert-eq (debug-allocator-deinit! debug) 0)
    0))

(deftest owned-values-balance-under-a-real-hash (values-balance (i64-keyops)))

(deftest owned-values-balance-when-every-key-collides
         (values-balance (keyops-with (primitive/fnptr-of colliding-hash))))

(deftest owned-values-balance-when-only-one-fragment-varies
         (values-balance (keyops-with (primitive/fnptr-of shallow-hash))))

; ---- pm-diff --------------------------------------------------------------------
(defn same-i64 [(left (ptr i8)) (right (ptr i8))] (-> bool)
  (= (load (primitive/cast (ptr i64) left))
     (load (primitive/cast (ptr i64) right))))

;;; What a diff reported, as three maps the brute-force answer can be compared to.
(defstruct Reported
  [(added (HashMap i64 i64))
   (removed (HashMap i64 i64))
   (changed (HashMap i64 i64))
   (calls i64)])

(defn record-difference [(context (ptr i8))
                         (before (ptr (PEntry i64 i64)))
                         (after (ptr (PEntry i64 i64)))] (-> i64)
  (let [r (primitive/cast (ptr Reported) context)
        none (primitive/cast (ptr (PEntry i64 i64)) 0)]
    (set! (.calls r) (+ (.calls r) 1))
    (cond (= before none) (set! (mut (.added r)) (.key after) (.val after))
          (= after none) (set! (mut (.removed r)) (.key before) (.val before))
          :else
            (do
              (assert-eq (.key before) (.key after))
              (assert-ne (.val before) (.val after))
              (set! (mut (.changed r)) (.key after) (.val after))))
    0))

;;; Derive two maps from one ancestor by independent random edits, then demand the
;;; diff says exactly what comparing their models key by key says, each key once.
(defn diff-agrees-with-models [(ops (ptr KeyOps)) (key-space i64) (edits i64)] (-> i64)
  (let [(mut left) (pm-new [i64 i64] (malloc-allocator-lease) ops)
        (mut left-model) (hm-new-scalar [i64 i64] (malloc-allocator))
        (mut right-model) (hm-new-scalar [i64 i64] (malloc-allocator))
        state (primitive/alloc-stack i64)]
    (set! state 777)
    (for [i 0 edits]
      (let [key (% (step state) key-space)
            value (step state)]
        (pm-assoc! (mut left) key value)
        (set! (mut left-model) key value)
        (set! (mut right-model) key value)))
    (let [(mut right) (clone left)]
      (for [i 0 (/ edits 4)]
        (let [key (% (step state) key-space)
              which (% (step state) 4)
              value (step state)]
          (cond (= which 0)
                  (do
                    (pm-dissoc! (mut left) key)
                    (hm-remove! (mut left-model) key)
                    0)
                (= which 1)
                  (do
                    (pm-dissoc! (mut right) key)
                    (hm-remove! (mut right-model) key)
                    0)
                (= which 2)
                  (do
                    (pm-assoc! (mut left) key value)
                    (set! (mut left-model) key value)
                    0)
                :else
                  (do
                    (pm-assoc! (mut right) key value)
                    (set! (mut right-model) key value)
                    0))))
      (let [r (primitive/alloc-stack Reported)
            (mut expected) 0]
        (set! r
              (Reported
                :added (hm-new-scalar [i64 i64] (malloc-allocator))
                :removed (hm-new-scalar [i64 i64] (malloc-allocator))
                :changed (hm-new-scalar [i64 i64] (malloc-allocator))
                :calls 0))
        (pm-diff left
                 right
                 (primitive/fnptr-of same-i64)
                 (primitive/fnptr-of record-difference)
                 (primitive/cast (ptr i8) r))
        (for [key 0 key-space]
          (match (get left-model key)
            (Some [was]
                  (match (get right-model key)
                    (Some [now]
                          (when (!= was now)
                            (assert-eq (match (get (.changed r) key)
                                         (Some [v] v)
                                         (None [] -1))
                                       now)
                            (set! expected (+ (load expected) 1))
                            0))
                    (None []
                          (do
                            (assert-eq (match (get (.removed r) key)
                                         (Some [v] v)
                                         (None [] -1))
                                       was)
                            (set! expected (+ (load expected) 1))
                            0))))
            (None []
                  (match (get right-model key)
                    (Some [now]
                          (do
                            (assert-eq (match (get (.added r) key)
                                         (Some [v] v)
                                         (None [] -1))
                                       now)
                            (set! expected (+ (load expected) 1))
                            0))
                    (None [] 0)))))
        ; Nothing extra, and nothing reported twice.
        (assert-eq (.calls r) (load expected))
        (assert-eq (+ (len (.added r))
                      (+ (len (.removed r)) (len (.changed r))))
                   (load expected))
        (assert (> (load expected) 0))
        (hm-free! (mut (.added r)))
        (hm-free! (mut (.removed r)))
        (hm-free! (mut (.changed r)))
        0))
    (hm-free! (mut left-model))
    (hm-free! (mut right-model))
    0))

(deftest diff-agrees-under-a-real-hash
         (diff-agrees-with-models (i64-keyops) 3000 12000))

(deftest diff-agrees-when-every-key-collides
         (diff-agrees-with-models (keyops-with (primitive/fnptr-of colliding-hash))
                                  40
                                  400))

; Few fragments vary, so a key often sits inline on one side and a level down on
; the other: the lone-pair-against-subtree cases.
(deftest diff-agrees-when-only-one-fragment-varies
         (diff-agrees-with-models (keyops-with (primitive/fnptr-of shallow-hash))
                                  200
                                  1200))

(deftest diff-agrees-on-a-sparse-map
         (diff-agrees-with-models (i64-keyops) 100000 600))

(defn count-difference [(context (ptr i8))
                        (before (ptr (PEntry i64 i64)))
                        (after (ptr (PEntry i64 i64)))] (-> i64)
  (let [calls (primitive/cast (ptr i64) context)]
    (set! calls (+ (load calls) 1))
    0))

;;; Diffing a big map against one edit of it reads a path, not the map.
(deftest a-diff-skips-what-is-shared
         (let [(mut a) (pm-new [i64 i64] (malloc-allocator-lease) (i64-keyops))
               calls (primitive/alloc-stack i64)]
           (for [i 0 50000] (pm-assoc! (mut a) i i))
           (let [b (pm-assoc a 4242 -1)
                 c (pm-dissoc b 31337)
                 unchanged (clone a)]
             (set! calls 0)
             (assert-eq (pm-diff a
                                 unchanged
                                 (primitive/fnptr-of same-i64)
                                 (primitive/fnptr-of count-difference)
                                 (primitive/cast (ptr i8) calls))
                        0)
             (assert-eq (load calls) 0)
             (let [examined
                     (pm-diff a
                              c
                              (primitive/fnptr-of same-i64)
                              (primitive/fnptr-of count-difference)
                              (primitive/cast (ptr i8) calls))]
               (assert-eq (load calls) 2)
               ; Two paths of at most 14 levels, both sides of each.
               (assert (<= examined 56))))))

(deftest a-diff-against-empty-reports-everything
         (let [empty (pm-new [i64 i64] (malloc-allocator-lease) (i64-keyops))
               (mut full) (clone empty)
               calls (primitive/alloc-stack i64)]
           (for [i 0 500] (pm-assoc! (mut full) i i))
           (set! calls 0)
           (pm-diff empty
                    full
                    (primitive/fnptr-of same-i64)
                    (primitive/fnptr-of count-difference)
                    (primitive/cast (ptr i8) calls))
           (assert-eq (load calls) 500)
           (set! calls 0)
           (pm-diff full
                    empty
                    (primitive/fnptr-of same-i64)
                    (primitive/fnptr-of count-difference)
                    (primitive/cast (ptr i8) calls))
           (assert-eq (load calls) 500)))
