(module selectorsmanytest)
(import "coil.primitive" :as primitive)
(import "coil.alloc" :as alloc)
(import "coil.slice" :use [slice-new])
(import "coil.cancellation" :as cancellation)
(import "coil.selectors" :as selectors)

(defn main [(argc i32) (argv (ptr (ptr i8)))] (-> i64)
  (let [token (primitive/alloc-stack cancellation/Cancellation)]
    (match (cancellation/cancellation-init token)
      (Err [_] 1)
      (Ok [_]
          (do
            (cancellation/cancellation-request! token)
            (let [items (primitive/alloc-stack (array selectors/Watch 1))]
              (store! (primitive/index items 0) (cancellation/cancellation-watch token 77))
              (let [result
                      (selectors/wait-many (alloc/malloc-allocator)
                                           (slice-new [selectors/Watch]
                                                      (primitive/cast (ptr selectors/Watch) items)
                                                      1))]
                (cancellation/cancellation-close! token)
                (match result
                  (Err [_] 2)
                  (Ok [selected]
                      (let [selectedp (primitive/alloc-stack selectors/Selection)]
                        (store! selectedp selected)
                        (if (= (load (field selectedp token)) 77) 0 3)))))))))))
