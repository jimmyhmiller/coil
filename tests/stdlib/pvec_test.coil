(module pvectest)
(import "coil.primitive" :as primitive)
(import "coil.alloc" :as alloc :use *)
(import "coil.result" :use *)
(import "coil.arraylist" :use *)
(import "coil.dbgalloc" :use *)
(import "coil.pvec" :use *)

; ---- a value that counts its own lifetime ---------------------------------------
(defn live-tokens [] (-> (ptr i64))
  (primitive/alloc-static i64))

(defstruct Token [(id i64)])

(defn token [(id i64)] (-> Token)
  (set! (live-tokens) (+ (load (live-tokens)) 1))
  (Token :id id))

(impl Clone Token
  (clone [(self (ref Token))] (-> Token) (token (.id self))))

(impl Drop Token
  (drop [(self (mut Token))]
        (-> void)
        (set! (live-tokens) (- (load (live-tokens)) 1))))

(defn lease-noop [(state (ptr i8))] (-> i64)
  0)

; The debug allocator outlives every vector in a test, so its lease needs no state.
(defn checked-lease [(debug (ptr DebugAllocator))] (-> AllocatorLease)
  (unsafe-allocator-lease-new (debug-allocator-view debug)
                              (primitive/cast (ptr i8) 0)
                              (primitive/fnptr-of lease-noop)
                              (primitive/fnptr-of lease-noop)))

(defn popped-from [(model (mut (ArrayList i64)))] (-> i64)
  (match (pop! (mut model)) (Some [x] x) (None [] -1)))

(defn value-at [(v (ref (PVec i64))) (index i64)] (-> i64)
  (match (pv-get v index) (Some [x] x) (None [] -1)))

; A deterministic generator, so a failure reproduces.
(defn step [(state (ptr i64))] (-> i64)
  (let [next
          (primitive/iadd (primitive/imul (load state) 6364136223846793005)
                          1442695040888963407)]
    (set! state next)
    (primitive/iand (primitive/ishr next 33) 1073741823)))

(defn same-contents [(v (ref (PVec i64))) (model (ref (ArrayList i64)))] (-> i64)
  (assert-eq (pv-len v) (len model))
  (let [(mut it) (pv-iter v)
        (mut at) 0]
    (loop (match (next (mut it))
            (None [] (break))
            (Some [slot]
                  (do
                    (assert-eq (load slot) (get model (load at)))
                    (assert-eq (value-at v (load at)) (get model (load at)))
                    (set! at (+ (load at) 1))
                    0))))
    (assert-eq (load at) (len model)))
  (assert-eq (value-at v (len model)) -1)
  (assert-eq (value-at v -1) -1)
  0)

;;; Drive a PVec and an ArrayList with the same edits and demand they agree, with
;;; snapshots taken along the way still holding exactly what they held.
;;; `push-share` percent of the edits are pushes, 15 percent are sets and the rest
;;; are pops, so a share above 43 climbs through the trie heights and one near it
;;; hovers around the tail/trie boundary.
(defn agrees-with-arraylist [(edits i64) (push-share i64)] (-> i64)
  (let [debug (debug-allocator-init (malloc-allocator))]
    (let [(mut v) (pv-new [i64] (checked-lease debug))
          (mut model) (al-new [i64] (malloc-allocator))
          (mut early) (clone v)
          (mut early-model) (al-new [i64] (malloc-allocator))
          (mut late) (clone v)
          (mut late-model) (al-new [i64] (malloc-allocator))
          state (primitive/alloc-stack i64)]
      (set! state 99)
      (for [i 0 edits]
        (when (= i (/ edits 3))
          (set! early (clone v))
          (for [j 0 (len model)] (push! (mut early-model) (get model j)))
          0)
        (when (= i (/ (* edits 2) 3))
          (set! late (clone v))
          (for [j 0 (len model)] (push! (mut late-model) (get model j)))
          0)
        (let [choice (% (step state) 100)
              value (step state)]
          (cond (< choice push-share)
                  (do
                    (assert-eq (pv-push! (mut v) value)
                               (push! (mut model) value))
                    0)
                (< choice (+ push-share 15))
                  (if (= (len model) 0)
                      (do (assert-eq (pv-set! (mut v) 0 value) 0) 0)
                      (let [at (% (step state) (len model))]
                        (assert-eq (pv-set! (mut v) at value) 1)
                        (set! (mut model) at value)
                        0))
                :else
                  (match (pv-pop! (mut v))
                    (None [] (do (assert-eq (len model) 0) 0))
                    (Some [popped]
                          (do (assert-eq popped (popped-from (mut model))) 0))))))
      (same-contents v model)
      (same-contents early early-model)
      (same-contents late late-model)
      ; Drain it, through every tail refill and root collapse.
      (loop (match (pv-pop! (mut v))
              (None [] (break))
              (Some [popped]
                    (do (assert-eq popped (popped-from (mut model))) 0))))
      (assert (pv-empty? v))
      (same-contents early early-model)
      (al-free! (mut model))
      (al-free! (mut early-model))
      (al-free! (mut late-model))
      0)
    (assert-eq (debug-allocator-deinit! debug) 0)
    0))

(deftest agrees-with-arraylist-while-growing (agrees-with-arraylist 60000 70))

(deftest agrees-with-arraylist-while-hovering (agrees-with-arraylist 60000 45))

;;; Past 32 * 32 * 32 elements the trie is three levels tall.
(deftest grows-and-shrinks-through-three-levels
         (let [debug (debug-allocator-init (malloc-allocator))]
           (let [(mut v) (pv-new [i64] (checked-lease debug))
                 total 40000]
             (for [i 0 total] (pv-push! (mut v) (* i 3)))
             (assert-eq (pv-len v) total)
             (for [i 0 total] (assert-eq (value-at v i) (* i 3)))
             (let [snapshot (clone v)]
               (for [i 0 total]
                 (match (pv-pop! (mut v))
                   (Some [x] (assert-eq x (* (- (- total 1) i) 3)))
                   (None [] (assert false))))
               (assert (pv-empty? v))
               (assert-eq (pv-len snapshot) total)
               (assert-eq (value-at snapshot 39999) 119997)
               (assert-eq (value-at snapshot 1024) 3072)))
           (assert-eq (debug-allocator-deinit! debug) 0)))

(deftest an-update-leaves-the-old-vector-alone
         (let [a (pv-new [i64] (malloc-allocator-lease))
               b (pv-push a 10)
               c (pv-set b 0 11)
               d (pv-pop c)
               e (pv-set c 5 99)]
           (assert-eq (pv-len a) 0)
           (assert-eq (value-at b 0) 10)
           (assert-eq (value-at c 0) 11)
           (assert (pv-empty? d))
           (assert-eq (pv-len e) 1)
           (assert-eq (value-at e 0) 11)))

(deftest a-clone-shares-until-edited
         (let [(mut a) (pv-new [i64] (malloc-allocator-lease))]
           (for [i 0 5000] (pv-push! (mut a) i))
           (let [(mut b) (clone a)]
             (assert (pv-same? a b))
             (pv-set! (mut b) 2500 -1)
             (assert (not (pv-same? a b)))
             (assert-eq (value-at a 2500) 2500)
             (assert-eq (value-at b 2500) -1)
             (pv-push! (mut b) 7)
             (assert-eq (pv-len a) 5000)
             (assert-eq (pv-len b) 5001))))

;;; One update to a shared vector allocates a path, not a vector.
(deftest an-update-copies-only-a-path
         (let [debug (debug-allocator-init (malloc-allocator))]
           (let [(mut a) (pv-new [i64] (checked-lease debug))]
             (for [i 0 40000] (pv-push! (mut a) i))
             (let [before (.live-allocations debug)
                   b (pv-set a 12345 -1)
                   grown (- (.live-allocations debug) before)]
               ; Three internal levels and a leaf, each a node plus its array.
               (assert (> grown 0))
               (assert (<= grown 8))
               (assert-eq (value-at a 12345) 12345)
               (assert-eq (value-at b 12345) -1)))
           (assert-eq (debug-allocator-deinit! debug) 0)))

;;; Owned elements are cloned by a copied leaf and dropped by a freed one, exactly
;;; once each.
(deftest owned-elements-balance
         (let [debug (debug-allocator-init (malloc-allocator))]
           (set! (live-tokens) 0)
           (let [(mut a) (pv-new [Token] (checked-lease debug))]
             (for [i 0 3000] (pv-push! (mut a) (token i)))
             (assert-eq (load (live-tokens)) 3000)
             (for [i 0 3000]
               (when (= (% i 7) 0) (pv-set! (mut a) i (token (- 0 i))) 0))
             (assert-eq (load (live-tokens)) 3000)
             (assert-eq (pv-set! (mut a) 3000 (token 1)) 0)
             (assert-eq (load (live-tokens)) 3000)
             (let [(mut b) (clone a)]
               (assert-eq (load (live-tokens)) 3000)
               (for [i 0 1500]
                 (match (pv-pop! (mut b))
                   (Some [popped]
                         (assert-eq (.id popped)
                                    (let [at (- 2999 i)]
                                      (if (= (% at 7) 0) (- 0 at) at))))
                   (None [] (assert false))))
               (for [i 0 40] (pv-push! (mut b) (token i)))
               (pv-set! (mut b) 3 (token 3))
               (assert-eq (pv-len a) 3000)
               (assert-eq (pv-len b) 1540)
               (match (pv-get-ptr a 14)
                 (Some [slot] (assert-eq (.id slot) -14))
                 (None [] (assert false)))
               0)
             ; b is gone: only a's elements remain, however many leaves they shared.
             (assert-eq (load (live-tokens)) 3000)
             (loop (match (pv-pop! (mut a)) (None [] (break)) (Some [popped] 0)))
             (assert-eq (load (live-tokens)) 0)
             0)
           (assert-eq (load (live-tokens)) 0)
           (assert-eq (debug-allocator-deinit! debug) 0)))
