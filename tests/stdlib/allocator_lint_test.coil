(module allocatorlinttest)
(import "coil.alloc" :as alloc)
(import "coil.region" :as region)

(defn main [] (-> i64)
  (let [parent (alloc/stack region/Region)
        child (alloc/stack region/Region)]
    (region/region-init parent (alloc/malloc-allocator))
    ;; lint: this exact composition formerly made child teardown quadratic.
    (region/region-init child (region/region-allocator parent))
    (region/region-close! child)
    (region/region-close! parent)
    0))
