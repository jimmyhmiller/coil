(module http-client-compile)
(import "coil.primitive" :as primitive)
(import "coil.http.client" :as http)
(import "coil.alloc" :as alloc)
(import "coil.slice" :as slice)

(defn main [] (-> i64)
  (let [r (alloc/stack http/Request)]
    (store! (field r method) "GET")
    (store! (field r url) "https://example.com/")
    (store! (field r headers) (slice/slice-new [http/Header] (primitive/cast (ptr http/Header) 0) 0))
    (store! (field r body) "")
    (store! (field r connect-timeout-ms) 5000)
    (store! (field r timeout-ms) 10000)
    (store! (field r follow-redirects) true)
    (match (http/request (alloc/malloc-allocator) r)
      (Err [e] 1)
      (Ok [response]
        (do
          (http/response-free (alloc/malloc-allocator) response)
          0)))))
