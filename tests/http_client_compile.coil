(module http-client-compile)
(import "coil.primitive" :as primitive)
(import "coil.http.client" :as http)
(import "coil.alloc" :as alloc)
(import "coil.slice" :as slice)

(defn main [] (-> i64)
  (let [r (primitive/alloc-stack http/Request)]
    (set! (.method r) "GET")
    (set! (.url r) "https://example.com/")
    (set! (.headers r) (slice/slice-new [http/Header] (primitive/cast (ptr http/Header) 0) 0))
    (set! (.body r) "")
    (set! (.connect-timeout-ms r) 5000)
    (set! (.timeout-ms r) 10000)
    (set! (.follow-redirects r) true)
    (match (http/request (alloc/malloc-allocator) r)
      (Err [e] 1)
      (Ok [response]
          (do
            (http/response-free (alloc/malloc-allocator) response)
            0)))))
