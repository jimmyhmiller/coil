(module compiler.features.jit-before-expand-const-replacement)
(import "coil.alloc" :use [malloc-allocator])
(import "coil.jit" :as jit)

(defn main [] (-> i64)
  (let [(mut session) (jit/jit-session-new (malloc-allocator))]
    (cond (!= (jit/jit-compile-with-entry! (mut session)
                                           "(module const-policy)
         (import \"coil.primitive\" :as p)
         (import \"coil.phase\" :as phase)
         (defn rewrite-one [(form Code) (version i64)] (-> Code)
           (if (and (p/code-list? form) (and (= (p/code-count form) 3)
             (and (p/code-eq (p/code-nth form 0) `const)
               (p/code-eq (p/code-nth form 1) `VALUE))))
             `(const VALUE-physical ~version)
             form))
         (defn version-const [(modules Code)] (-> Code)
           (let [version (+ (p/code-int (p/code-session-state `0)) 1)
                 out (p/code-list-new)]
             (for [mi 0 (p/code-count modules)]
               (let [module (p/code-nth modules mi) next (p/code-list-new)]
                 (for [fi 0 (p/code-count module)]
                   (p/code-list-push! next (rewrite-one (p/code-nth module fi) version)))
                 (p/code-list-push! out (p/code-list-done next))))
             (p/code-session-stage! `~version)
             `(do ~@(p/code-list-done out))))
         (transform version-const :phase (phase/BeforeExpand))
         (const VALUE 1)"
                                           "0")
              0)
            1
          (!= (jit/jit-compile-with-entry! (mut session)
                                           "(module const-policy) (const VALUE 2)"
                                           "0")
              0)
            2
          (!= (jit/jit-reset! (mut session)) 0) 3
          ; A transform may also replace a function a compile-time expression
          ; reached. The submission that defines it again is staged as written,
          ; before the transform runs, so the candidate holds the accepted
          ; function and the new one under one name: the compile-time closure
          ; reads both bodies for the impls they select. Reading only the first,
          ; it checked the new body, which multiplies, without `Mul` for i64.
          (!= (jit/jit-compile-with-entry! (mut session)
                                           "(module redefine-policy)
         (import \"coil.primitive\" :as p)
         (import \"coil.phase\" :as phase)
         (defn later-scale [(form Code) (known bool)] (-> Code)
           (if (and known
                    (and (p/code-list? form)
                         (and (= (p/code-count form) 5)
                              (and (p/code-eq (p/code-nth form 0) `defn)
                                   (p/code-eq (p/code-nth form 1) `scale)))))
               `(defn ~(p/syntax->datum `scale-next) ~(p/code-nth form 2) ~(p/code-nth form 3) ~(p/code-nth form 4))
               form))
         (defn rename-later [(modules Code)] (-> Code)
           (let [known (= (p/code-int (p/code-session-state `0)) 1)
                 out (p/code-list-new)]
             (for [mi 0 (p/code-count modules)]
               (let [module (p/code-nth modules mi) next (p/code-list-new)]
                 (for [fi 0 (p/code-count module)]
                   (p/code-list-push! next (later-scale (p/code-nth module fi) known)))
                 (p/code-list-push! out (p/code-list-done next))))
             (p/code-session-stage! `1)
             `(do ~@(p/code-list-done out))))
         (transform rename-later :phase (phase/BeforeExpand))
         (defn scale [(x i64)] (-> i64) x)
         (const TWO i64 (comptime (scale 2)))"
                                           "(if (= TWO 2) 0 1)")
              0)
            4
          (!= (jit/jit-compile-with-entry! (mut session)
                                           "(module redefine-policy) (defn scale [(x i64)] (-> i64) (* x 5))"
                                           "(if (and (= (scale-next 2) 10) (= (scale 2) 2)) 0 1)")
              0)
            5
          :else (jit/jit-reset! (mut session)))))
