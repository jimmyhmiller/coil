(module compiler.features.jit-deferred-publication)
(import "coil.primitive" :as p)
(import "coil.alloc" :use [malloc-allocator])
(import "coil.jit" :as jit)
(defn main [] (-> i64)
  (let [(mut session) (jit/jit-session-new (malloc-allocator))]
    (assert (= (jit/jit-prepare! (mut session)
      "(defn value [] (-> i64) 41) (export-c [value :as \"deferred_value\"])") 0))
    (assert (= (jit/jit-publish-prepared! (mut session)) 0))
    (assert (jit/jit-finalization-pending? (mut session)))
    (assert (not (jit/jit-prepared? (mut session))))
    (assert (= (jit/jit-epoch (mut session)) 1))
    (let [token (jit/jit-generation-retain-current! (mut session))
          address (jit/jit-symbol-address (mut session) "deferred_value")]
      (assert (> token 0))
      (assert (!= (p/cast i64 address) 0))
      (assert (= (p/call-ptr (p/cast (fnptr c [] i64) address)) 41))
      ; Acceptance is final, even before compaction.
      (assert (= (jit/jit-abort-prepared! (mut session)) 0))
      (assert (jit/jit-finalization-pending? (mut session)))
      (assert (= (jit/jit-reset! (mut session)) -1))
      ; A following prepare finishes maintenance before reading the accepted world.
      (assert (= (jit/jit-prepare! (mut session) "(defn next [] (-> i64) (+ (value) 1))") 0))
      (assert (not (jit/jit-finalization-pending? (mut session))))
      (assert (= (p/call-ptr (p/cast (fnptr c [] i64) address)) 41))
      (assert (= (jit/jit-abort-prepared! (mut session)) 0))
      (assert (= (jit/jit-finalize-published! (mut session)) 0))
      (assert (= (jit/jit-generation-release-token! (mut session) token) 0)))
    (assert (= (jit/jit-prepare! (mut session) "(defn tail [] (-> i64) 3)") 0))
    (assert (= (jit/jit-publish-prepared! (mut session)) 0))
    ; Reset also drains a published revision that has no external leases.
    (assert (= (jit/jit-reset! (mut session)) 0))
    (assert (not (jit/jit-finalization-pending? (mut session))))
    (assert (= (jit/jit-generation-count (mut session)) 0))
    0))
