(module compiler.features.jit-meta-main)
(import "coil.alloc" :use [malloc-allocator])
(import "coil.thread" :use [Thread ThreadConfig thread-spawn-configured thread-join])
(import "coil.jit" :as jit)
(import "coil.var" :use [var-static])
(import "coil.slice" :use [subslice])

;; Run with COIL_META_MAIN=1. That asks for metaprograms on the process main
;; thread, which only the coil command line services for another thread. An
;; embedding host compiling on its main thread runs them in place; compiling on
;; another thread is a clear diagnostic, not a crash.
(def worker-result (var-static i64 -1))

(defn source [] (-> (slice u8))
  "(module meta-main.m)
   (defn twice [(e Code)] (-> Code) `(+ ~e ~e))
   (defn four [] (-> i64) (twice 2))")

(defn compile-on-worker [(arg (ptr i8))] (-> (ptr i8))
  (let [(mut session) (jit/jit-session-new (malloc-allocator))
        rc (jit/jit-compile! (mut session) (source))
        message (jit/jit-diagnostic (mut session))
        (mut found) false]
    (for i (range 0 (- (len message) 14))
      (when (= (subslice message i (+ i 15)) "COIL_META_MAIN=") (set! found true)))
    (set worker-result (if (and (!= rc 0) found) 0 1))
    (cast (ptr i8) 0)))


(defn main [] (-> i64)
  (let [(mut session) (jit/jit-session-new (malloc-allocator))
        (mut worker) (Thread :handle (cast (ptr i8) 0))]
    (cond
      (!= (jit/jit-compile-with-entry! (mut session) (source) "(if (= (meta-main.m.four) 4) 0 1)") 0) 1
      (!= (thread-spawn-configured (cast (ptr Thread) (mut worker)) (fnptr-of compile-on-worker)
            (cast (ptr i8) 0) (ThreadConfig :stack-size 536870912 :guard-size 0)) (: 0 i32)) 2
      (!= (thread-join (cast (ptr Thread) (mut worker))) (: 0 i32)) 3
      (!= (get worker-result) 0) 4
      :else 0)))
