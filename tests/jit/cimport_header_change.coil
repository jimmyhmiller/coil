(module compiler.features.jit-cimport-header-change)
(import "coil.alloc" :use [malloc-allocator])
(import "coil.primitive" :as primitive)
(import "coil.fs" :as fs)
(import "coil.slice" :use [slice-new])
(import "coil.str" :use [sb-new sb-push-str! sb-push-i64! sb-str str->cstr])
(import "coil.jit" :as jit)

;; A process keeps the bindings each cimport generates, so loading a program again
;; does not run clang again: `lint --fix` loads the program once per analysis. A
;; kept result is reused only while every file it was generated from still holds
;; the same bytes, so a change to the header, or to a header it includes, reaches
;; the next compilation in the same process.

(extern mkdtemp :cc c [(ptr i8)] (-> (ptr i8)))
(extern unlink :cc c [(ptr i8)] (-> i32))
(extern rmdir :cc c [(ptr i8)] (-> i32))

(defn join [(a (slice u8)) (b (slice u8))] (-> (slice u8))
  (let [(mut out) (sb-new (malloc-allocator))]
    (sb-push-str! (mut out) a)
    (sb-push-str! (mut out) b)
    (sb-str (load out))))

(defn write! [(path (slice u8)) (text (slice u8))] (-> bool)
  (match (fs/write-file (malloc-allocator) path text) (Ok [_] true) (Err [_] false)))

;; 0 when a fresh session compiling a cimport of HEADER sees COIL_HEADER_VALUE = EXPECTED.
(defn compile-sees [(header (slice u8)) (expected i64)] (-> i64)
  (let [(mut session) (jit/jit-session-new (malloc-allocator))
        source (join (join "(module header-change) (cimport \"" header)
                     "\" :use [COIL_HEADER_VALUE]) (defn value [] (-> i64) COIL_HEADER_VALUE)")
        entry (let [(mut out) (sb-new (malloc-allocator))]
                (sb-push-str! (mut out) "(if (= (header-change.value) ")
                (sb-push-i64! (mut out) expected)
                (sb-push-str! (mut out) ") 0 1)")
                (sb-str (load out)))
        result (jit/jit-compile-with-entry! (mut session) source entry)]
    (jit/jit-session-free! (mut session))
    result))

(defn main [] (-> i64)
  (let [template (primitive/alloc-stack (array u8 64))
        pattern "/tmp/coil-cimport-change-XXXXXX"]
    (for [i 0 (len pattern)] (store! (index (cast (ptr u8) template) i) (get pattern i)))
    (store! (index (cast (ptr u8) template) (len pattern)) 0)
    (if (= (cast i64 (mkdtemp (cast (ptr i8) template))) 0)
        1
        (let [dir (slice-new (cast (ptr u8) template) (len pattern))
              header (join dir "/value.h")
              included (join dir "/included.h")
              result
                (cond (not (write! header "#define COIL_HEADER_VALUE 1\n")) 2
                      (!= (compile-sees header 1) 0) 3
                      ; unchanged: served again, and still right
                      (!= (compile-sees header 1) 0) 4
                      (not (write! header "#define COIL_HEADER_VALUE 2\n")) 5
                      (!= (compile-sees header 2) 0) 6
                      ; the value moves into a header the first one includes
                      (not (write! included "#define COIL_HEADER_VALUE 3\n")) 7
                      (not (write! header "#include \"included.h\"\n")) 8
                      (!= (compile-sees header 3) 0) 9
                      ; only the included header changes
                      (not (write! included "#define COIL_HEADER_VALUE 4\n")) 10
                      (!= (compile-sees header 4) 0) 11
                      :else 0)]
          (unlink (str->cstr (malloc-allocator) header))
          (unlink (str->cstr (malloc-allocator) included))
          (rmdir (cast (ptr i8) template))
          result))))
