(module compiler.features.jit-dependency-facts)
(import "coil.alloc" :use [malloc-allocator])
(import "coil.slice" :use *)
(import "coil.str" :use *)
(import "coil.jit" :as jit)

; A compiler state says what each definition depends on: the declarations the
; checker looked up while checking it. The facts are part of the state, so they
; answer for every submission a session accepted, for a host and for a
; metaprogram (a before-expand one too), and they are saved and loaded with it.
; Retiring a definition forgets what it depended on; what depended on a retired
; declaration still says so.

(defn has? [(text (slice u8)) (part (slice u8))] (-> bool)
  (match (find text part) (Some [_] true) (None [] false)))

(defn main [] (-> i64)
  (let [a (malloc-allocator)
        (mut s) (jit/jit-session-new a)]
    (jit/jit-session-set-quiet! (mut s) true)
    (assert (= (jit/jit-compile! (mut s)
                                 "(module facts)
       (defstruct P [(x i64) (y i64)])
       (defstruct Pair [(first P) (second (ptr P))])
       (defsum Shape (Circle [(r i64)]) (Rect [(w i64) (h i64)]))
       (def limit i64 100)
       (const twice i64 (* limit 2))
       (defn F [(x i64)] (-> bool) (> x limit))
       (defn G [] (-> bool) (F 2))
       (defn py [(p (ptr P))] (-> i64) (.y p))
       (defn area [(s Shape)] (-> i64) (match s (Circle [r] r) (Rect [w h] (* w h))))
       (defn mk [] (-> Shape) (Rect :w 1 :h 2))")
               0))
    (let [e (jit/jit-env-current (mut s))]
      ; a call, a constant, a field and the struct it is a field of
      (assert (= (jit/jit-env-dependencies (mut s) e "facts.G" a)
                 "((function facts.F body))"))
      (assert (= (jit/jit-env-dependencies (mut s) e "facts.py" a)
                 "((struct facts.P declaration body) (field facts.P y body))"))
      (assert (= (jit/jit-env-dependencies (mut s) e "facts.Pair" a)
                 "((struct facts.P declaration))"))
      ; a match names the variants of its arms, a construction the one it builds
      (let [area (jit/jit-env-dependencies (mut s) e "facts.area" a)]
        (assert (has? area "(sum facts.Shape declaration body)"))
        (assert (has? area "(variant facts.Circle body)"))
        (assert (has? area "(variant facts.Rect body)")))
      (assert (has? (jit/jit-env-dependencies (mut s) e "facts.twice" a)
                    "(const facts.limit body)"))
      ; and the other way round
      (assert (= (jit/jit-env-dependents (mut s) e "facts.F" a)
                 "((facts.G function body))"))
      (assert (= (jit/jit-env-field-dependents (mut s) e "facts.P" "y" a)
                 "((facts.py field body))"))
      (assert (= (jit/jit-env-field-dependents (mut s) e "facts.P" "x" a) "()"))
      (let [p (jit/jit-env-dependents (mut s) e "facts.P" a)]
        (assert (has? p "(facts.Pair struct declaration)"))
        (assert (has? p "(facts.py struct declaration body)")))
      (let [rect (jit/jit-env-dependents (mut s) e "facts.Rect" a)]
        (assert (has? rect "(facts.mk variant body)"))
        (assert (has? rect "(facts.area variant body)")))
      (let [limit (jit/jit-env-dependents (mut s) e "facts.limit" a)]
        (assert (has? limit "(facts.F const body)"))
        (assert (has? limit "(facts.twice const body)")))
      ; nothing recorded a name the state does not define
      (assert (= (jit/jit-env-dependencies (mut s) e "facts.missing" a) ""))
      (assert (= (jit/jit-env-dependents (mut s) e "facts.missing" a) "()"))
      (jit/jit-env-release! (mut s) e))

    ; A later submission's definitions are added to what the earlier ones left,
    ; and a metaprogram asks about all of them: after checking, and before
    ; expansion, where the program it asks about is the one accepted so far.
    (assert (= (jit/jit-compile! (mut s)
                                 "(module facts.policy)
       (import \"coil.primitive\" :as primitive)
       (import \"coil.meta\" :as meta)
       (import \"coil.phase\" :as phase)
       (import \"coil.str\" :use *)
       (defn names? [(answer primitive/ProgramAnswer) (part (slice u8))] (-> bool)
         (match answer
           (primitive/Answer [records]
             (match (find (primitive/code-source records) part) (Some [_] true) (None [] false)))
           (_ false)))
       (defn accepted-facts [(modules Code)] (-> Code)
         (unless (names? (meta/dependents `facts.F) \"(facts.G function body)\")
           (primitive/error \"before expansion: facts.G is not a dependent of facts.F\"))
         (unless (names? (meta/dependencies `facts.py) \"(field facts.P y body)\")
           (primitive/error \"before expansion: facts.py does not depend on the field y\"))
         `(do ~@modules))
       (transform accepted-facts :phase (phase/BeforeExpand))
       (defn checked-facts [(modules Code)] (-> Code)
         (unless (names? (meta/dependents `(facts.P y)) \"(facts.py field body)\")
           (primitive/error \"after checking: facts.py is not a dependent of the field y\"))
         `0)
       (checker checked-facts)")
               0))
    (assert (= (jit/jit-compile! (mut s)
                                 "(module facts) (defn H [] (-> bool) (and (G) (F 5)))")
               0))
    (let [e (jit/jit-env-current (mut s))
          f (jit/jit-env-dependents (mut s) e "facts.F" a)]
      (assert (has? f "(facts.G function body)"))
      (assert (has? f "(facts.H function body)"))

      ; saved and loaded with the state
      (let [loaded (jit/jit-env-load (mut s) (jit/jit-env-save (mut s) e a))]
        (assert (jit/jit-env-valid? loaded))
        (assert (= (jit/jit-env-dependencies (mut s) loaded "facts.G" a)
                   "((function facts.F body))"))
        (assert (= (jit/jit-env-dependents (mut s) loaded "facts.F" a) f))
        (jit/jit-env-release! (mut s) loaded))
      (jit/jit-env-release! (mut s) e))

    ; F is retired and defined again with another signature. What it depended on
    ; is forgotten with it, and the new F reads no constant. G and H were checked
    ; against the F that is gone and still say they depend on that name: they are
    ; what to check again.
    (assert (= (jit/jit-compile! (mut s)
                                 "(module facts) (retire-defn F) (defn F [(x i64) (y i64)] (-> bool) (> x y))")
               0))
    (let [e (jit/jit-env-current (mut s))]
      (assert (= (jit/jit-env-dependents (mut s) e "facts.limit" a)
                 "((facts.twice const body))"))
      (assert (has? (jit/jit-env-dependencies (mut s) e "facts.twice" a)
                    "(const facts.limit body)"))
      (let [f (jit/jit-env-dependents (mut s) e "facts.F" a)]
        (assert (has? f "(facts.G function body)"))
        (assert (has? f "(facts.H function body)")))
      (jit/jit-env-release! (mut s) e))

    ; G is retired and defined again against the new F; H is only retired.
    (assert (= (jit/jit-compile! (mut s)
                                 "(module facts) (retire-defn G) (retire-defn H) (defn G [] (-> bool) (F 2 3))")
               0))
    (let [e (jit/jit-env-current (mut s))]
      (assert (= (jit/jit-env-dependents (mut s) e "facts.F" a)
                 "((facts.G function body))"))
      (assert (= (jit/jit-env-dependencies (mut s) e "facts.H" a) ""))
      (assert (= (jit/jit-env-dependents (mut s) e "facts.G" a) "()"))
      (jit/jit-env-release! (mut s) e))
    ; A definition a metaprogram named with a fresh identifier is answered as
    ; that identifier: spelled as it was written, never as the resolver's key
    ; for it. (A metaprogram that kept the identifier tells it from a namesake
    ; with bound-identifier=?.)
    (assert (= (jit/jit-compile! (mut s)
                                 "(module facts)
       (import \"coil.primitive\" :as primitive)
       (defn make-hidden [] (-> Code)
         (let [name (primitive/fresh-identifier \"hidden\")]
           `(defn ~name [] (-> bool) (F 1 2))))
       (make-hidden)")
               0))
    (let [e (jit/jit-env-current (mut s))
          f (jit/jit-env-dependents (mut s) e "facts.F" a)]
      (assert (has? f "(facts.hidden function body)"))
      (assert (not (has? f "$scope")))
      (jit/jit-env-release! (mut s) e))
    (assert (= (jit/jit-reset! (mut s)) 0))
    0))
