(module compiler.features.jit-repl-second-submission)
(import "coil.alloc" :use [malloc-allocator])
(import "coil.str" :use [str-find])
(import "coil.jit" :as jit)

; A metaprogram that a later submission loads reaches accepted functions (and
; prelude impl methods such as `Mul i64`) that no earlier closure needed.
; export-c of a Var-published function exports a trampoline that follows the
; Var, and an entry that rejects is reported as a rejection.
(defn mentions? [(text (slice u8)) (needle (slice u8))] (-> bool)
  (match (str-find text needle) (Some [_] true) (None [] false)))

(defn main [] (-> i64)
  (let [(mut session) (jit/jit-session-new (malloc-allocator))]
    (cond (!= (jit/jit-compile! (mut session) "(defn base [] (-> i64) 40)") 0) 1
          (!= (jit/jit-compile-with-entry! (mut session)
                                           "(import \"coil.repl\")
                                            (defn answer [] (-> i64) 42)
                                            (export-c [answer :as \"coil_second_answer\"])"
                                           "(coil.repl/publish)")
              0)
            2
          :else
            (let [first (jit/jit-symbol-address (mut session) "coil_second_answer")]
              (cond (= (cast i64 first) 0) 3
                    (!= (call-ptr (cast (fnptr c [] i64) first)) 42) 4
                    (!= (jit/jit-compile-with-entry! (mut session)
                                                     "(defn answer [] (-> i64) 7)"
                                                     "(coil.repl/publish)")
                        0)
                      5
                    (!= (call-ptr (cast (fnptr c [] i64) first)) 7) 6
                    (= (jit/jit-compile-with-entry! (mut session) "(defn nope [] (-> i64) 1)" "3") 0) 7
                    (not (mentions? (jit/jit-diagnostic (mut session)) "entry rejected the candidate")) 8
                    :else 0)))))
