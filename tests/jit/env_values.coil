(module compiler.features.jit-env-values)
(import "coil.alloc" :use [malloc-allocator])
(import "coil.slice" :use *)
(import "coil.str" :use *)
(import "coil.arraylist" :use *)
(import "coil.jit" :as jit)

; Compiler states are values: two edits of one base are both alive, and a state
; saved as bytes reads back as a state to build on, in this process or another
; of the same toolchain, its metaprograms built again where they are called.
; Bytes that are not such a state are refused, saying why.

(defn same-bytes? [(x (slice u8)) (y (slice u8))] (-> bool)
  (and (= (len x) (len y))
       (let [(mut same) true]
         (for [i 0 (len x)]
           (when (!= (get x i) (get y i)) (store! same false)))
         (load same))))

(defn says? [(s (ptr jit/JitSession)) (part (slice u8))] (-> bool)
  (match (find (jit/jit-diagnostic s) part) (Some [_] true) (None [] false)))

(defn main [] (-> i64)
  (let [a (malloc-allocator)
        (mut s) (jit/jit-checked-session-new a)
        base (jit/jit-env-check (mut s) (jit/jit-env-empty)
                                "(module values) (defn area [(w i64) (h i64)] (-> i64) (* w h))")
        square (jit/jit-env-check (mut s) base
                                  "(module values) (defn square [(w i64)] (-> i64) (area w w))")
        twice (jit/jit-env-check (mut s) base
                                 "(module values) (defn twice [(w i64)] (-> i64) (area w 2))")]
    (assert (jit/jit-env-valid? square))
    (assert (jit/jit-env-valid? twice))
    (assert (jit/jit-env-defines? (mut s) square "values.square"))
    (assert (not (jit/jit-env-defines? (mut s) square "values.twice")))
    (assert (not (jit/jit-env-defines? (mut s) base "values.square")))

    ; saved, read back, and built on as the state it was saved from
    (let [bytes (jit/jit-env-save (mut s) square a)
          loaded (jit/jit-env-load (mut s) bytes)]
      (assert (> (len bytes) 0))
      (assert (jit/jit-env-valid? loaded))
      (assert (jit/jit-env-defines? (mut s) loaded "values.square"))
      (assert (jit/jit-env-defines? (mut s) loaded "values.area"))
      (assert (= (jit/jit-env-definition-source (mut s) loaded "values.area")
                 "(defn area [(w i64) (h i64)] (-> i64) (* w h))"))
      (assert (same-bytes? (jit/jit-env-save (mut s) loaded a) bytes))
      (let [cube (jit/jit-env-check (mut s) loaded
                                    "(module values) (defn cube [(w i64)] (-> i64) (* w (square w)))")
            wrong (jit/jit-env-check (mut s) loaded
                                     "(module values) (defn bad [] (-> i64) (square true))")]
        (assert (jit/jit-env-valid? cube))
        (assert (not (jit/jit-env-valid? wrong)))
        (jit/jit-env-release! (mut s) cube))

      ; bytes that are not a state, a cut one, and one another toolchain wrote
      (assert (not (jit/jit-env-valid? (jit/jit-env-load (mut s) "not a state"))))
      (assert (says? (mut s) "not a saved compiler state"))
      (assert (not (jit/jit-env-valid? (jit/jit-env-load (mut s) (subslice bytes 0 (- (len bytes) 9))))))
      (assert (says? (mut s) "damaged"))
      (let [(mut other) (ArrayList::new [u8] a)
            header "coil saved compiler state 1\n"]
        (extend! (mut other) (data header) (len header))
        (extend! (mut other) (data "another-toolchain\n") 18)
        (extend! (mut other) (data bytes) (len bytes))
        (assert (not (jit/jit-env-valid? (jit/jit-env-load (mut s) (slice other)))))
        (assert (says? (mut s) "another-toolchain")))
      (jit/jit-env-release! (mut s) loaded))

    ; the metaprograms a state defined are rebuilt where it is read back
    (let [macro (jit/jit-env-check (mut s) base
                                   "(module values) (defn twice-of [(x Code)] (-> Code) `(* 2 ~x)) (defn eight [] (-> i64) (twice-of 4))")
          loaded (jit/jit-env-load (mut s) (jit/jit-env-save (mut s) macro a))
          uses (jit/jit-env-check (mut s) loaded
                                  "(module values) (defn sixteen [] (-> i64) (let [(mut n) 0] (for [i 0 2] (set! n (+ n (twice-of 4)))) n))")]
      (assert (jit/jit-env-valid? macro))
      (assert (jit/jit-env-valid? loaded))
      (assert (jit/jit-env-valid? uses))
      (jit/jit-env-release! (mut s) uses)
      (jit/jit-env-release! (mut s) loaded)
      (jit/jit-env-release! (mut s) macro))

    (jit/jit-env-release! (mut s) twice)
    (jit/jit-env-release! (mut s) square)
    (jit/jit-env-release! (mut s) base)
    (jit/jit-session-free! (mut s))
    0))
