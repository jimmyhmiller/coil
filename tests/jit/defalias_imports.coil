(module compiler.features.jit-defalias-imports)
(import "coil.alloc" :use [malloc-allocator])
(import "coil.jit" :as jit)

;; Run from the project written by scripts/tests/jit-static-session.py.
(defn main [] (-> i64)
  (let [(mut session) (jit/jit-session-new (malloc-allocator))]
    (cond
      (!= (jit/jit-session-load-project! (mut session)) 0) 1
      (!= (jit/jit-compile-with-entry! (mut session)
        "(module boot) (import \"project-host.user\")"
        "(if (= (project-host.user.old) 41) 0 1)") 0) 2
      (!= (jit/jit-compile-with-entry! (mut session)
        "(module project-dependency.shapes)
         (defstruct P-v2 [(x i64) (y i64)])
         (defalias P P-v2)
         (defn get-v2 [(p P)] (-> i64) (+ (.x p) (.y p)))
         (defalias get get-v2)"
        "0") 0) 3
      (!= (jit/jit-compile-with-entry! (mut session)
        "(module project-host.user)
         (defn new [] (-> i64) (shapes/get (P :x 1 :y 2)))"
        "(if (and (= (project-host.user.new) 3) (= (project-host.user.old) 41)) 0 1)") 0) 4
      :else (jit/jit-reset! (mut session)))))
