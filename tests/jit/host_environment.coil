(module compiler.features.host-environment)
(import "coil.alloc" :use [malloc-allocator])
(import "coil.jit" :as jit)
(import "coil.jit.environment" :as env)
(import "compiler.features.host-environment-app" :as app)
(import "compiler.features.host-environment-types" :as types)
(import "compiler.features.host-environment-embed" :use [embed-environments])

; Adds `environment` and `types-only` to this module at build time, each
; returning an environment as text built when it is called.
(transform embed-environments)

;;; A program that gives one of its modules to a JIT session running inside it. At
;;; build time a transform (host_environment_embed.coil) calls `meta/embed-environment`
;;; with the functions and `def`s to hand over, which adds a function that builds the
;;; module's environment: its types, generic and macro as written, and for each
;;; function and `def` named a definition holding the real address. At run time a session takes that text as its environment: code
;;; it compiles calls the program's own functions, reads and writes its own `def`,
;;; and uses its types, generic and macro.

(defn main [] (-> i64)
  (let [(mut session) (jit/jit-session-new (malloc-allocator))
        text (environment)
        adopted (jit/jit-session-set-environment! (mut session) text)]
    (env/environment-free! text)
    (cond
      (!= adopted 0) (do (println "environment {}: {}" adopted (jit/jit-diagnostic (mut session))) 1)
      ; The session calls the program's own functions and changes its own `def`.
      (!= (jit/jit-compile-with-entry! (mut session)
            "(module compiler.features.host-environment-app)
             (defn session-fn [] (-> i64)
               (bump!)
               (+ (helper (twice 3)) (+ (area (Point :x 2 :y 3)) (+ (id (get counter)) (assist 0)))))"
            "(if (= (compiler.features.host-environment-app.session-fn) 68) 0 1)") 0) 2
      (!= (get app/counter) 42) 3
      ; A function that takes and returns a record, and a plain def.
      (!= (jit/jit-compile-with-entry! (mut session)
            "(module compiler.features.host-environment-app)
             (defn moved [] (-> i64) (.x (shift (Point :x 1 :y 2) 10)))"
            "(if (and (= (compiler.features.host-environment-app.moved) 11) (= limit 100)) 0 1)") 0) 4
      ; Once started, a session takes no environment.
      (!= (jit/jit-session-set-environment! (mut session) (types-only)) -1) 5
      :else
        (let [(mut other) (jit/jit-session-new (malloc-allocator))
              other-text (types-only)
              ; Only types: the record and generic are there ...
              adopted2 (jit/jit-session-set-environment! (mut other) other-text)
              typed (jit/jit-compile-with-entry! (mut other)
                      "(module compiler.features.host-environment-types)
                       (defn use-types [] (-> i64) (let [p (Pair :a 3 :b 4)] (id2 (+ (.a p) (.b p)))))"
                      "(if (= (compiler.features.host-environment-types.use-types) 7) 0 1)")
              ; ... and `hidden` is not.
              missing (jit/jit-compile! (mut other)
                        "(module compiler.features.host-environment-types) (defn no-hidden [] (-> i64) (hidden 1))")]
          (env/environment-free! other-text)
          (jit/jit-reset! (mut other))
          (jit/jit-reset! (mut session))
          (cond (!= adopted2 0) 6
                (!= typed 0) 7
                (= missing 0) 8
                :else 0)))))
