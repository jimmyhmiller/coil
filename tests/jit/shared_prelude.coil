(module compiler.features.jit-shared-prelude)
(import "coil.alloc" :use [malloc-allocator])
(import "coil.jit" :as jit)

;; Sessions build on one shared checked prelude and stay independent: the same
;; name means different things in each, a reset session starts over on the shared
;; prelude, and freeing one leaves the other working. Under COIL_JIT_PROTECT a
;; session writing into the shared state faults.
(defn main [] (-> i64)
  (let [(mut left) (jit/jit-session-new (malloc-allocator))
        (mut right) (jit/jit-session-new (malloc-allocator))]
    (cond
      (!= (jit/jit-compile-with-entry! (mut left)
            "(module shared.m) (defn value [] (-> i64) (fold (fn [a b] (+ a b)) 0 (range 0 4)))"
            "(if (= (value) 6) 0 1)") 0) 1
      (!= (jit/jit-compile-with-entry! (mut right)
            "(module shared.m) (defn value [] (-> i64) (* 6 7))"
            "(if (= (value) 42) 0 1)") 0) 2
      (!= (jit/jit-reset! (mut left)) 0) 3
      (!= (jit/jit-compile-with-entry! (mut left)
            "(module shared.m) (defn value [] (-> i64) (len \"four\"))"
            "(if (= (value) 4) 0 1)") 0) 4
      (!= (jit/jit-compile-with-entry! (mut right) "" "(if (= (value) 42) 0 1)") 0) 5
      (!= (jit/jit-session-free! (mut left)) 0) 6
      (!= (jit/jit-compile-with-entry! (mut right)
            "(module shared.n) (import \"shared.m\" :as m) (defn twice [] (-> i64) (* 2 (m/value)))"
            "(if (= (twice) 84) 0 1)") 0) 7
      (!= (jit/jit-session-free! (mut right)) 0) 8
      :else 0)))
