(module compiler.features.jit-qualified-names)
(import "coil.alloc" :use [malloc-allocator])
(import "coil.jit" :as jit)
(defn main [] (-> i64)
  (let [(mut session) (jit/jit-session-new (malloc-allocator))]
    (cond
      (!= (jit/jit-compile! (mut session) "(module aa.mid) (defn two [] (-> i64) 2)") 0) 1
      (!= (jit/jit-compile! (mut session) "(module aa.user) (import \"aa.mid\") (defn f [] (-> i64) (aa.mid/two))") 0) 2
      (!= (jit/jit-compile! (mut session) "(module aa.user2) (import \"aa.mid\" :as m) (defn h [] (-> i64) (m/two))") 0) 3
      (!= (jit/jit-evaluate! (mut session) "(aa.mid/two)") 0) 4
      :else (do (jit/jit-reset! (mut session)) 0))))
