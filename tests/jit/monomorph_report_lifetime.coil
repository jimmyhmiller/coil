(module compiler.features.jit-monomorph-report-lifetime)
(import "coil.alloc" :as a)
(import "coil.jit" :as jit)
(import "coil.str" :as str)
(import "coil.primitive" :as p)

(defn main [] (-> i64)
  (let [allocator (a/malloc-allocator)
        (mut session) (jit/jit-session-new allocator)]
    (assert (= (jit/jit-compile-with-entry! (mut session)
      "(import \"coil.jit.lifetime\")
       (import \"coil.primitive\" :as p)
       (defn stage [] (-> Code) (do (p/code-session-stage! `0) `0))
       (defn identity-artifacts [] (-> Code)
         (let [report (p/code-session-monomorphs) (mut count) 0]
           (for [i 1 (p/code-count report)]
             (let [item (p/code-nth report i)]
               (when (and (= (p/code-str (p/code-nth item 0)) \"monomorph\")
                          (= (p/code-str (p/code-nth item 2)) \"identity\"))
                 (set! count (+ (load count) 1)))))
           (let [n (load count)] `~n)))
       (defn identity [T] [(x T)] (-> T) x)
       (defn permanent [] (-> i64) (identity 42))" "(stage)") 0))
    ; Only this source generic is counted: unrelated startup artifacts may
    ; legitimately retire, and new scalar operators may specialize independently.
    (assert (= (jit/jit-compile-with-entry! (mut session) ""
      "(do (stage) (if (= (identity-artifacts) 1) 0 99))") 0))
    (for [i 0 12]
      (let [(mut source) (str/sb-new allocator)]
        (str/sb-push-str! (mut source) "(defstruct Temporary")
        (str/sb-push-i64! (mut source) i)
        (str/sb-push-str! (mut source) " :jit/retain false [(value i64)]) (defn transient :jit/retain false [] (-> i64) (let [x (identity (Temporary")
        (str/sb-push-i64! (mut source) i)
        (str/sb-push-str! (mut source) " :value 9))] (.value x)))")
        (assert (= (jit/jit-compile-with-entry! (mut session) (str/sb-str (load source)) "(do (stage) (- (transient) 9))") 0))
        (str/sb-free! (mut source))
        ; The next authoritative native table contains no transient specialization.
        (assert (= (jit/jit-compile-with-entry! (mut session) "" "(stage)") 0))
        (assert (= (jit/jit-compile-with-entry! (mut session) ""
          "(do (stage) (if (and (= (identity-artifacts) 1) (= (permanent) 42)) 0 99))") 0))))
    (assert (= (jit/jit-reset! (mut session)) 0)))
  0)
