;;; A focused compiler regression, independent of the live POC transform.
;;; Exit 1 means an impl kept an otherwise unreachable submission-only type alive.
(module compiler.features.jit-impl-lifetime)
(import "coil.alloc" :as a)
(import "coil.jit" :as jit)
(import "coil.primitive" :as p)
(import "coil.str" :as str)

;;; Preparation checks availability without installing a new retaining caller.
(defn type-available? [(session (ptr jit/JitSession)) (source (slice u8))] (-> bool)
  (let [status (jit/jit-prepare! session source)]
    (if (= status 0)
      (do (assert (= (jit/jit-abort-prepared! session) 0)) true)
      false)))

(defn main [] (-> i64)
  (let [toolchain "coil" (mut failure) 0]
    ; Control: an unreferenced ephemeral nominal declaration disappears.
    (let [(mut session) (jit/jit-session-new-with-toolchain (a/malloc-allocator) toolchain)]
      (assert (= (jit/jit-compile! (mut session)
        "(import \"coil.jit.lifetime\")
         (defstruct Gone :jit/retain false [(value i64)])") 0))
      (assert (!= (jit/jit-compile! (mut session)
        "(defn unexpected [(x Gone)] (-> i64) (.value x))") 0))
      (assert (= (jit/jit-reset! (mut session)) 0)))
    ; An impl is a capability of its target, not an independent root of that type.
    (let [(mut session) (jit/jit-session-new-with-toolchain (a/malloc-allocator) toolchain)]
      (assert (= (jit/jit-compile! (mut session)
        "(import \"coil.jit.lifetime\")
         (deftrait Read [Self] (read-value [(self Self)] (-> i64)))
         (defstruct Gone :jit/retain false [(value i64)])
         (impl Read Gone (read-value [(self Gone)] (-> i64) (.value self)))") 0))
      (when (= (jit/jit-compile! (mut session)
        "(defn unexpected [(x Gone)] (-> i64) (read-value x))") 0)
        (println "FAIL: an unused impl roots Gone")
        (set! failure 1))
      (assert (= (jit/jit-reset! (mut session)) 0)))
    ; A real retained consumer must keep the type and its selected method alive.
    ; Replacing its versioned root must release metadata without breaking a lease.
    (let [(mut session) (jit/jit-session-new-with-toolchain (a/malloc-allocator) toolchain)]
      (assert (= (jit/jit-compile! (mut session)
        "(import \"coil.jit.lifetime\")
         (deftrait Read [Self] (read-value [(self Self)] (-> i64)))
         (defstruct Held :jit/retain false [(value i64)])
         (impl Read Held (read-value [(self Held)] (-> i64) (.value self)))
         (defn first :jit/retain false :jit/root 1 :jit/root-version 1 [] (-> i64)
           (read-value (Held :value 42)))
         (export-c [first :as \"held_body\"])") 0))
      (let [lease (jit/jit-generation-retain-current! (mut session))
            address (jit/jit-symbol-address (mut session) "held_body")]
        (assert (> lease 0))
        (assert (!= (p/cast i64 address) 0))
        (assert (= (jit/jit-compile-with-entry! (mut session) ""
          "(if (= (read-value (Held :value 7)) 7) 0 99)") 0))
        (assert (= (jit/jit-compile! (mut session)
          "(defn second :jit/retain false :jit/root 1 :jit/root-version 2 [] (-> i64) 8)") 0))
        (when (= (jit/jit-compile! (mut session)
          "(defn unexpected [(x Held)] (-> i64) (read-value x))") 0)
          (println "FAIL: a superseded root's impl keeps Held")
          (set! failure 1))
        (assert (= (p/call-ptr (p/cast (fnptr c [] i64) address)) 42))
        (assert (>= (jit/jit-generation-release-token! (mut session) lease) 0)))
      (assert (= (jit/jit-reset! (mut session)) 0)))
    ; Associated type keys must not make New retain Old without a selected edge.
    (let [(mut session) (jit/jit-session-new-with-toolchain (a/malloc-allocator) toolchain)]
      (assert (= (jit/jit-compile! (mut session)
        "(import \"coil.jit.lifetime\")
         (deftrait Convert [Self Old] (convert [(self Self) (old Old)] (-> i64)))
         (defstruct Old :jit/retain false [(value i64)])
         (defstruct New :jit/retain false [(value i64)])
         (impl Convert New (convert [(self New) (old Old)] (-> i64) (+ (.value self) (.value old))))
         (defn both :jit/retain false :jit/root 1 :jit/root-version 1 [] (-> i64)
           (convert (New :value 2) (Old :value 3)))") 0))
      (assert (type-available? (mut session) "(defn availability [(x Old)] (-> i64) 0)"))
      (assert (type-available? (mut session) "(defn availability [(x New)] (-> i64) 0)"))
      (assert (= (jit/jit-compile-with-entry! (mut session) "" "(- (both) 5)") 0))
      (assert (= (jit/jit-compile! (mut session)
        "(defn only-new :jit/retain false :jit/root 1 :jit/root-version 2 [] (-> i64)
           (let [x (New :value 7)] (.value x)))") 0))
      (assert (not (type-available? (mut session) "(defn availability [(x Old)] (-> i64) 0)")))
      (assert (type-available? (mut session) "(defn availability [(x New)] (-> i64) 0)"))
      (assert (= (jit/jit-compile-with-entry! (mut session) "" "(- (only-new) 7)") 0))
      (assert (= (jit/jit-reset! (mut session)) 0)))
    ; Inherent methods and generic impls obey the same conditional ownership.
    (let [(mut session) (jit/jit-session-new-with-toolchain (a/malloc-allocator) toolchain)]
      (assert (= (jit/jit-compile! (mut session)
        "(import \"coil.jit.lifetime\")
         (defstruct Inherent :jit/retain false [(value i64)])
         (impl Inherent (read-value [(self Inherent)] (-> i64) (.value self)))
         (deftrait GetValue [Self] (get-value [(self Self)] (-> i64)))
         (defstruct Box :jit/retain false [T] [(value T)])
         (impl [T] GetValue (Box T) (get-value [(self (Box T))] (-> i64) 9))
         (defstruct UnusedBox :jit/retain false [T] [(value T)])
         (impl [T] GetValue (UnusedBox T) (get-value [(self (UnusedBox T))] (-> i64) 0))
         (defn selected [] (-> i64) (get-value (Box [i64] :value 12)))") 0))
      (assert (not (type-available? (mut session) "(defn availability [(x Inherent)] (-> i64) 0)")))
      (assert (not (type-available? (mut session) "(defn availability [(x (UnusedBox i64))] (-> i64) 0)")))
      (assert (type-available? (mut session) "(defn availability [(x (Box i64))] (-> i64) 0)"))
      (assert (= (jit/jit-compile-with-entry! (mut session) "" "(- (selected) 9)") 0))
      (assert (= (jit/jit-reset! (mut session)) 0)))
    (load failure)))
