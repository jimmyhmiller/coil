(module compiler.features.jit-reader-keeps-type)
(import "coil.alloc" :use [malloc-allocator])
(import "coil.jit" :as jit)

; A type marked `:jit/retain false` lives while something retained reads it, even
; when that reader was accepted in an earlier submission and so is absent from the
; program a later prune walks. The unrelated `Held` submission below runs a full
; prune; afterwards a body-only use, a generic template and a generic instance
; must all still find their types. A retired struct stops reading its field type,
; so that type is released with it. Run on every backend this host has: an LLVM
; session declares every accepted function again, so it also faults on an
; instance whose type was released.

(defn exercise [(session (mut jit/JitSession))] (-> i64)
  (assert (= (jit/jit-compile! (mut session)
    "(import \"coil.jit.lifetime\")
     (defstruct Inner :jit/retain false [(value i64)])
     (defn use-inner [(x i64)] (-> i64) (let [s (Inner :value x)] (.value s)))
     (defstruct Generic :jit/retain false [T] [(value T)])
     (defn keep-generic [T] [(x T)] (-> (Generic T)) (Generic [T] :value x))
     (defstruct Slot :jit/retain false [(value i64)])
     (defstruct Old [(slot Slot)])") 0))
  (assert (= (jit/jit-compile-with-entry! (mut session) "" "(let [g (keep-generic 3)] (- (.value g) 3))") 0))
  (assert (= (jit/jit-compile! (mut session)
    "(defstruct Held :jit/retain false [(value i64)])
     (defn first-root :jit/retain false :jit/root 1 :jit/root-version 1 [] (-> i64)
       (let [v (Held :value 23)] (.value v)))
     (defn holds-old-root [] (-> i64) (first-root))") 0))
  (assert (= (jit/jit-compile-with-entry! (mut session) "" "(- (use-inner 5) 5)") 0))
  (assert (= (jit/jit-compile-with-entry! (mut session) "" "(let [s (Inner :value 4)] (- (.value s) 4))") 0))
  (assert (= (jit/jit-compile-with-entry! (mut session) "" "(let [g (keep-generic 6)] (- (.value g) 6))") 0))
  (assert (= (jit/jit-compile-with-entry! (mut session) "" "(let [g (keep-generic true)] (if (.value g) 0 1))") 0))
  (assert (= (jit/jit-compile-with-entry! (mut session) "" "(let [f (Slot :value 2)] (- (.value f) 2))") 0))
  (assert (= (jit/jit-compile! (mut session) "(retire-struct Old)") 0))
  (assert (!= (jit/jit-compile-with-entry! (mut session) "" "(let [f (Slot :value 2)] (- (.value f) 2))") 0))
  (assert (= (jit/jit-reset! (mut session)) 0))
  0)

(defn on-backend [(backend jit/JitBackend)] (-> i64)
  (match (jit/jit-session-new-with-options (malloc-allocator)
           (jit/JitOptions :toolchain (.toolchain (jit/jit-default-options)) :backend backend :opt-level 0))
    (Ok [s] (let [(mut session) s] (exercise (mut session))))
    ; A host without this backend has nothing to run here.
    (Err [_] 0)))

(defn main [] (-> i64)
  (on-backend (jit/Native))
  (on-backend (jit/Llvm))
  0)
