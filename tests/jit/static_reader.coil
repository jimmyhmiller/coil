(module compiler.features.jit-static-reader)
(import "coil.alloc" :use [malloc-allocator])
(import "coil.jit" :as jit)

(defn main [] (-> i64)
  (let [(mut s) (jit/jit-session-new (malloc-allocator))]
    (cond (!= (jit/jit-session-set-source-provider! (mut s)
                                                    "retained.provider"
                                                    "read-source"
                                                    ""
                                                    "(defstruct Point [(x i64)])")
              0)
            1
          (!= (jit/jit-compile! (mut s)
                                "(do (module retained.read) (defn original [] (-> Point) (Point :x 42)))")
              0)
            2
          (!= (jit/jit-compile-with-entry! (mut s)
                                           "(defn later [] (-> i64) (let [p (original)] (.x p)))"
                                           "(if (= (later) 42) 0 90)")
              0)
            3
          :else (jit/jit-reset! (mut s)))))
