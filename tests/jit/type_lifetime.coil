(module compiler.features.jit-type-lifetime)
(import "coil.alloc" :use [malloc-allocator])
(import "coil.jit" :as jit)
(import "coil.primitive" :as p)

(defn main [] (-> i64)
  (let [(mut session) (jit/jit-session-new (malloc-allocator))]
    (assert (= (jit/jit-compile! (mut session)
      "(import \"coil.jit.lifetime\")
       (defstruct Gone :jit/retain false [(value i64)])
       (defsum GoneSum :jit/retain false (GoneValue [(value i64)]))
       (defn native :jit/retain false [] (-> i64)
         (let [x (Gone :value 41)] (match (GoneValue :value (.value x)) (GoneValue [n] (+ n 1)))))
       (export-c [native :as \"leased_type_body\"])") 0))
    (let [lease (jit/jit-generation-retain-current! (mut session))
          native (jit/jit-symbol-address (mut session) "leased_type_body")]
      (assert (> lease 0))
      (assert (!= (p/cast i64 native) 0))
      (assert (!= (jit/jit-compile! (mut session) "(defn missing [] (-> Gone) (Gone :value 7))") 0))
      (assert (!= (jit/jit-compile! (mut session) "(defn missing [] (-> i64) (match (GoneValue :value 7) (GoneValue [n] n)))") 0))
      (assert (= (p/call-ptr (p/cast (fnptr c [] i64) native)) 42))
      (assert (= (jit/jit-compile! (mut session)
        "(defstruct Leaf :jit/retain false [(value i64)])
         (defstruct Branch :jit/retain false [(leaf Leaf)])
         (defsum Choice :jit/retain false (Selected [(branch Branch)]) (Empty))
         (defn retained :jit/retain false :jit/root 1 :jit/root-version 1 [] (-> i64)
           (match (Selected :branch (Branch :leaf (Leaf :value 19)))
             (Selected [branch] (let [b branch leaf (.leaf b)] (.value leaf))) (Empty [] 0)))") 0))
      (assert (= (jit/jit-compile-with-entry! (mut session) "" "(if (= (retained) 19) 0 99)") 0))
      (assert (= (jit/jit-compile! (mut session) "(defn typed :jit/retain false :jit/root 2 :jit/root-version 1 [(x Leaf)] (-> i64) (.value x))") 0))
      (assert (!= (jit/jit-compile! (mut session)
        "(defn stale :jit/retain false :jit/root 1 :jit/root-version 1 [] (-> i64) 0)") 0))
      (assert (!= (jit/jit-compile! (mut session)
        "(defn twice1 :jit/retain false :jit/root 1 :jit/root-version 2 [] (-> i64) 0)
         (defn twice2 :jit/retain false :jit/root 1 :jit/root-version 3 [] (-> i64) 0)") 0))
      (assert (!= (jit/jit-compile! (mut session)
        "(defn bad :jit/retain false :jit/root 1 :jit/root-version 2 [] (-> i64) true)") 0))
      (assert (= (jit/jit-compile-with-entry! (mut session) "" "(if (= (retained) 19) 0 99)") 0))
      (assert (= (jit/jit-compile! (mut session) "(defn retained2 :jit/retain false :jit/root 1 :jit/root-version 2 [] (-> i64) 20) (defn typed2 :jit/retain false :jit/root 2 :jit/root-version 2 [(x i64)] (-> i64) x)") 0))
      (assert (!= (jit/jit-compile! (mut session) "(defn missing [] (-> Branch) (Branch :leaf (Leaf :value 7)))") 0))
      (assert (!= (jit/jit-compile! (mut session) "(defn missing [] (-> Leaf) (Leaf :value 7))") 0))
      (assert (!= (jit/jit-compile! (mut session) "(defn missing [] (-> Choice) (Empty))") 0))
      (assert (= (jit/jit-compile! (mut session)
        "(defstruct Persistent [(value i64)])
         (defstruct Generic :jit/retain false [T] [(value T)])
         (defn keep-generic [T] [(x T)] (-> (Generic T)) (Generic [T] :value x))") 0))
      (assert (= (jit/jit-compile-with-entry! (mut session) "" "(let [g (keep-generic 3) p (Persistent :value -3)] (+ (.value g) (.value p)))") 0))
      (assert (!= (jit/jit-compile! (mut session) "(defstruct Invalid :jit/retain 1 [(value i64)])") 0))
      (assert (!= (jit/jit-compile! (mut session) "(defsum Invalid :jit/retain 1 (InvalidValue))") 0))
      (assert (= (jit/jit-compile! (mut session)
        "(defstruct Held :jit/retain false [(value i64)])
         (defn first-root :jit/retain false :jit/root 3 :jit/root-version 1 [] (-> i64)
           (let [v (Held :value 23)] (.value v)))
         (defn holds-old-root [] (-> i64) (first-root))") 0))
      (assert (= (jit/jit-compile! (mut session)
        "(defn second-root :jit/retain false :jit/root 3 :jit/root-version 2 [] (-> i64) 8)") 0))
      (assert (= (jit/jit-compile-with-entry! (mut session) ""
        "(let [v (Held :value 23)] (- (holds-old-root) (.value v)))") 0))
      (assert (= (p/call-ptr (p/cast (fnptr c [] i64) native)) 42))
      (assert (>= (jit/jit-generation-release-token! (mut session) lease) 0)))
    (assert (= (jit/jit-reset! (mut session)) 0)))
  0)
