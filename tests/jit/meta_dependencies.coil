(module compiler.features.jit-meta-dependencies)
(import "coil.alloc" :use [malloc-allocator])
(import "coil.jit" :as jit)
(import "coil.io" :use [print-str stderr])

(defn exercise [(session (mut jit/JitSession))] (-> i64)
    (let [first (jit/jit-compile! (mut session)
      "(module dependency_test)
       (import \"coil.primitive\" :as p)
       (defn leaf [(x i64)] (-> i64) (+ x 1))
       (defalias alias leaf)
       (const K 3)
       (const K2 (+ K 1))
       (defstruct Inner [(x i64)])
       (defalias IA Inner)
       (defstruct Outer [(inner IA)])
       (defn read-outer [(x (ptr Outer))] (-> i64) (.x (.inner x)))
       (defn identity [T] [(x T)] (-> T) x)
       (defn generic-user [] (-> i64) (identity 2))
       (defn twice [(x Code)] (-> Code) `(+ ~x ~x))
       (defn caller [] (-> i64) (twice (+ (alias K) 1)))")]
      (if (!= first 0)
          (do (print-str (stderr) (jit/jit-diagnostic (mut session))) 1)
          (let [second (jit/jit-compile! (mut session)
            "(module dependency_test)
             (defn contains? [(names Code) (name Code)] (-> bool)
               (let [(mut found) false]
                 (for item (iter names) (when (= item name) (set! found true))) found))
             (defn inspect [(modules Code)] (-> Code)
               (let [deps (p/code-dependencies `dependency_test.caller)]
                 (unless (contains? deps `dependency_test.leaf) (p/error \"missing retained call\") 0)
                 (unless (contains? deps `dependency_test.alias) (p/error \"missing retained alias\") 0)
                 (unless (contains? deps `dependency_test.K) (p/error \"missing retained constant\") 0)
                 (unless (contains? deps `dependency_test.twice) (p/error \"missing retained macro\") 0))
               (unless (contains? (p/code-dependents `dependency_test.leaf) `dependency_test.caller)
                 (p/error \"missing retained dependent\") 0)
               (unless (contains? (p/code-dependent-closure `dependency_test.IA) `dependency_test.read-outer)
                 (p/error \"missing retained schema alias\") 0)
               (unless (contains? (p/code-dependent-closure `dependency_test.Inner) `dependency_test.read-outer)
                 (p/error \"missing retained nested type\") 0)
               (unless (contains? (p/code-dependents `dependency_test.identity) `dependency_test.generic-user)
                 (p/error \"missing retained generic template\") 0)
               (unless (contains? (p/code-dependents `dependency_test.K) `dependency_test.K2)
                 (p/error \"missing retained constant initializer\") 0)
               `0)
             (checker inspect)
             (defn entry [] (-> i64) (caller))")]
            (if (!= second 0)
                (do (print-str (stderr) (jit/jit-diagnostic (mut session))) 2)
                0)))))

(defn main [] (-> i64)
  (let [(mut native) (jit/jit-session-new (malloc-allocator))
        (mut checked) (jit/jit-checked-session-new (malloc-allocator))
        native-result (exercise (mut native))
        checked-result (exercise (mut checked))
        native-free (jit/jit-session-free! (mut native))
        checked-free (jit/jit-session-free! (mut checked))]
    (cond (!= native-result 0) native-result
          (!= checked-result 0) (+ 10 checked-result)
          (!= native-free 0) 20
          (!= checked-free 0) 21
          :else 0)))
