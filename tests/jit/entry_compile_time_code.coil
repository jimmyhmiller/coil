(module compiler.features.jit-entry-compile-time-code)
(import "coil.alloc" :use [malloc-allocator])
(import "coil.jit" :as jit)

; A transaction entry that reaches a function taking Code is rejected with a
; diagnostic naming that function, instead of being dropped with the other
; compile-time code and failing at publication.
(defn main [] (-> i64)
  (let [(mut session) (jit/jit-session-new (malloc-allocator))]
    (cond
      (!= (jit/jit-compile! (mut session)
            "(module demo) (import \"coil.primitive\" :as p) (defn helper [(x Code)] (-> bool) true)") 0) 1
      (= (jit/jit-compile-with-entry! (mut session) ""
            "(if (= (p/cast i64 (p/cast (ptr i8) (p/fnptr-of helper))) 0) 1 0)") 0) 2
      ; A later function that reaches the accepted helper is compile-time code:
      ; it is accepted and dropped with it, not emitted with a dangling reference.
      (!= (jit/jit-compile! (mut session)
            "(module demo) (defn uses [] (-> i64) (if (= (p/cast i64 (p/cast (ptr i8) (p/fnptr-of helper))) 0) 1 0))") 0) 3
      ; ...and an entry that reaches it through that function names it.
      (= (jit/jit-compile-with-entry! (mut session) "" "(uses)") 0) 4
      :else (do (jit/jit-reset! (mut session)) 0))))
