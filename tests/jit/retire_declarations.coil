(module compiler.features.jit-retire-declarations)
(import "coil.alloc" :use [malloc-allocator])
(import "coil.slice" :use *)
(import "coil.str" :use *)
(import "coil.jit" :as jit)

;; A retained session may retire accepted aliases, traits and impls, then
;; declare replacements under the same names. Accepted code keeps what it bound.
(defn main [] (-> i64)
  (let [(mut session) (jit/jit-session-new (malloc-allocator))]
    (cond (!= (jit/jit-compile-with-entry! (mut session)
                                           "(module retire.m)
         (defsum Light-v1 (Red-v1) (Amber-v1))
         (defalias Light Light-v1)
         (defalias Red Red-v1)
         (defalias Amber Amber-v1)
         (deftrait Shape [Self] (area [(self Self)] (-> i64)))
         (defstruct Sq [(side i64)])
         (defstruct Box [T] [(item T)])
         (impl Shape Sq (area [(self Sq)] (-> i64) (* (.side self) (.side self))))
         (deftrait Size [Self] (size [(self Self)] (-> i64)))
         (impl [T] Size (Box T) (size [(self (Box T))] (-> i64) 1))
         (impl Sq (twice [(self Sq)] (-> i64) (* 2 (.side self))))
         (defn old-area [] (-> i64) (area (Sq :side 3)))
         (defn old-size [] (-> i64) (size (Box :item 5)))
         (defn old-twice [] (-> i64) (twice (Sq :side 4)))"
                                           "(if (and (= (retire.m.old-area) 9) (and (= (retire.m.old-size) 1) (= (retire.m.old-twice) 8))) 0 1)")
              0)
            1
          ; A retired alias no longer resolves.
          (= (jit/jit-compile-with-entry! (mut session)
                                          "(module retire.m) (retire-alias Amber) (defn uses-amber [] (-> i64) (match (Amber) (Red [] 1) (Amber [] 2)))"
                                          "0")
             0)
            2
          (!= (jit/jit-compile-with-entry! (mut session)
                                           "(module retire.m) (retire-alias Amber)"
                                           "0")
              0)
            3
          (= (jit/jit-compile-with-entry! (mut session)
                                          "(module retire.m) (defn later-amber [] (-> retire.m.Light) (Amber))"
                                          "0")
             0)
            4
          ; A retired trait is replaced, with its impls; old callers keep theirs.
          (!= (jit/jit-compile-with-entry! (mut session)
                                           "(module retire.m)
         (retire-trait Shape)
         (deftrait Shape [Self] (area [(self Self)] (-> i64)) (perimeter [(self Self)] (-> i64)))
         (impl Shape Sq (area [(self Sq)] (-> i64) (.side self)) (perimeter [(self Sq)] (-> i64) (* 4 (.side self))))
         (defn new-area [] (-> i64) (+ (area (Sq :side 3)) (perimeter (Sq :side 3))))"
                                           "(if (and (= (retire.m.new-area) 15) (= (retire.m.old-area) 9)) 0 1)")
              0)
            5
          ; A generic trait impl is replaced.
          (!= (jit/jit-compile-with-entry! (mut session)
                                           "(module retire.m)
         (retire-impl [T] Size (Box T))
         (impl [T] Size (Box T) (size [(self (Box T))] (-> i64) (+ 1 (sizeof T))))
         (defn new-size [] (-> i64) (size (Box :item 5)))"
                                           "(if (and (= (retire.m.new-size) 9) (= (retire.m.old-size) 1)) 0 1)")
              0)
            6
          ; An inherent impl is replaced with a different signature.
          (!= (jit/jit-compile-with-entry! (mut session)
                                           "(module retire.m)
         (retire-inherent Sq)
         (impl Sq (twice [(self Sq) (extra i64)] (-> i64) (+ extra (* 2 (.side self)))))
         (defn new-twice [] (-> i64) (twice (Sq :side 4) 1))"
                                           "(if (and (= (retire.m.new-twice) 9) (= (retire.m.old-twice) 8)) 0 1)")
              0)
            7
          ; A rejected retirement leaves the accepted declarations in place.
          (= (jit/jit-compile-with-entry! (mut session)
                                          "(module retire.m) (retire-trait Shape) (defn broken [] (-> i64) true)"
                                          "0")
             0)
            8
          (!= (jit/jit-compile-with-entry! (mut session)
                                           "(module retire.m) (defn still [] (-> i64) (perimeter (Sq :side 2)))"
                                           "(if (= (retire.m.still) 8) 0 1)")
              0)
            9
          ; A macro, and a `comptime`, compiled against a struct: the compiler
          ; builds its metaprograms again for a later submission, and one that
          ; names a field the struct no longer has is not built with them.
          (!= (jit/jit-compile-with-entry! (mut session)
                                           "(module retire.m)
         (import \"coil.primitive\" :as primitive)
         (defstruct Pt [(x i64) (y i64)])
         (defn* where-y [(at Code)] (-> Code)
           (let [n (primitive/cast i64 (primitive/offsetof Pt y))] `~n))
         (const Y-AT (comptime (primitive/cast i64 (primitive/offsetof Pt y))))
         (defn ys [] (-> i64) (+ Y-AT (where-y 0)))"
                                           "(- (retire.m.ys) 16)")
              0)
            10
          (!= (jit/jit-compile-with-entry! (mut session)
                                           "(module retire.m)
         (retire-struct Pt)
         (defstruct Pt [(x i64)])
         (defn* two [(at Code)] (-> Code) `2)
         (defn twos [] (-> i64) (two 0))"
                                           "(- (+ (retire.m.twos) (retire.m.ys)) 18)")
              0)
            11
          ; in the submission after it as well
          (!= (jit/jit-compile-with-entry! (mut session)
                                           "(module retire.m)
         (defn* three [(at Code)] (-> Code) `3)
         (defn threes [] (-> i64) (three 0))"
                                           "(- (retire.m.threes) 3)")
              0)
            12
          ; and a call of that macro says what became of it
          (= (jit/jit-compile-with-entry! (mut session)
                                          "(module retire.m) (defn again [] (-> i64) (where-y 0))"
                                          "0")
             0)
            13
          (match (find (jit/jit-diagnostic (mut session)) "define the macro again")
            (Some [_] false)
            (None [] true))
            14
          ; A static assertion of a later submission is decided against the
          ; program as it is now, its operators folded as the first one's are.
          (!= (jit/jit-compile-with-entry! (mut session)
                                           "(module retire.m)
         (static-assert (= (sizeof Pt) 8) \"Pt is one word\")
         (defn asserted [] (-> i64) 4)"
                                           "(- (retire.m.asserted) 4)")
              0)
            15
          ; One that does not hold rejects its submission and says so; the
          ; session goes on.
          (= (jit/jit-compile-with-entry! (mut session)
                                          "(module retire.m)
         (static-assert (= (sizeof Pt) 16) \"Pt is two words\")
         (defn unasserted [] (-> i64) 5)"
                                          "0")
             0)
            16
          (match (find (jit/jit-diagnostic (mut session))
                       "static assertion failed: Pt is two words")
            (Some [_] false)
            (None [] true))
            17
          (!= (jit/jit-compile-with-entry! (mut session)
                                           "(module retire.m) (defn after [] (-> i64) (asserted))"
                                           "(- (retire.m.after) 4)")
              0)
            18
          ; A blanket impl an earlier submission declared is selected in a
          ; later one.
          (!= (jit/jit-compile-with-entry! (mut session)
                                           "(module retire.m)
         (deftrait Weigh [Self] (weigh [(self (ptr Self))] (-> i64)))
         (impl [T] Weigh T
           (weigh [(self (ptr T))] (-> i64) (primitive/cast i64 (primitive/sizeof T))))
         (defn weighed [] (-> i64) 1)"
                                           "(- (retire.m.weighed) 1)")
              0)
            19
          (!= (jit/jit-compile-with-entry! (mut session)
                                           "(module retire.m)
         (defn weight [] (-> i64) (let [(mut n) 5] (weigh (mut n))))"
                                           "(- (retire.m.weight) 8)")
              0)
            20
          ; A struct retired and declared again at another size: an instance
          ; of a generic made for the size it was is not an instance of it, and
          ; a static cell of it is not the cell it was.
          (!= (jit/jit-compile-with-entry! (mut session)
                                           "(module retire.m)
         (import \"coil.var\" :use [Var])
         (defstruct Wide [(a i64)])
         (defstruct Held [T] [(item T) (after i64)])
         (defn after-of [T] [(h (ptr (Held T)))] (-> i64) (.after h))
         (def wide (Var :cell (primitive/alloc-static Wide)))
         (defn wide-at [] (-> i64) (primitive/cast i64 (.cell wide)))
         (defn afters [] (-> i64)
           (let [(mut h) (Held :item (Wide :a 1) :after 7)] (after-of (mut h))))"
                                           "(- (retire.m.afters) 7)")
              0)
            21
          (!= (jit/jit-compile-with-entry! (mut session)
                                           "(module retire.m)
         (retire-struct Wide)
         (defstruct Wide [(a i64) (b i64) (c i64)])
         (retire-def wide)
         (def wide (Var :cell (primitive/alloc-static Wide)))
         (defn wider [] (-> i64)
           (let [(mut h) (Held :item (Wide :a 1 :b 2 :c 3) :after 9)]
             (+ (after-of (mut h))
                (if (= (primitive/cast i64 (.cell wide)) (wide-at)) 100 0))))"
                                           "(- (retire.m.wider) 9)")
              0)
            22
          ; A generic struct retired and declared again: an instance made of
          ; it as it was is not an instance of it.
          (!= (jit/jit-compile-with-entry! (mut session)
                                           "(module retire.m)
         (retire-struct Held)
         (defstruct Held [T] [(before i64) (item T) (after i64)])
         (defn held-again [] (-> i64)
           (let [(mut h) (Held :before 4 :item (Wide :a 1 :b 2 :c 3) :after 9)]
             (+ (.before h) (.after h))))"
                                           "(- (retire.m.held-again) 13)")
              0)
            23
          :else (jit/jit-reset! (mut session)))))
