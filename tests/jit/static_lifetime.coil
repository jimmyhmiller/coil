(module probe.life)
(import "coil.alloc" :use [malloc-allocator])
(import "coil.jit" :as jit)

; Public leases must not expose or release the compiler's own generation roots.
(defn check-leases [(s (ptr jit/JitSession))] (-> i64)
  (let [token (jit/jit-generation-retain-current! s)
        second (jit/jit-generation-retain-current! s)]
    (cond (<= token 0) 20
          (!= token second) 21
          (!= (jit/jit-generation-token-leases s) 2) 22
          (!= (jit/jit-reset! s) -1) 23
          (!= (jit/jit-generation-release-token! s token) 1) 24
          (!= (jit/jit-generation-release-token! s token) 0) 25
          (!= (jit/jit-generation-release-token! s token) -1) 26
          (!= (jit/jit-generation-token-leases s) 0) 27
          :else 0)))

(defn main [] (-> i64)
  (let [(mut s) (jit/jit-session-new (malloc-allocator))]
    (cond (!= (jit/jit-compile! (mut s) "(defn old [] (-> i64) 7)") 0) 1
          (!= (jit/jit-compile! (mut s) "(defn unrelated [] (-> i64) 2)") 0) 2
          (!= (jit/jit-reclaim-retired! (mut s)) 0) 3
          (!= (jit/jit-compile-with-entry! (mut s) "" "(if (= (old) 7) 0 90)")
              0)
            4
          (!= (jit/jit-generation-token-leases (mut s)) 0) 5
          (= (jit/jit-compile-with-entry! (mut s)
                                          "(defn rejected [] (-> i64) 5)"
                                          "42")
             0)
            6
          (!= (jit/jit-compile-with-entry! (mut s)
                                           "(defn rejected [] (-> i64) 6)"
                                           "(if (= (rejected) 6) 0 91)")
              0)
            7
          (!= (check-leases (mut s)) 0) 12
          (!= (jit/jit-reset! (mut s)) 0) 8
          (!= (jit/jit-generation-count (mut s)) 0) 9
          (!= (jit/jit-compile! (mut s) "(defn old [] (-> bool) true)") 0) 10
          (!= (jit/jit-reset! (mut s)) 0) 11
          :else 0)))
