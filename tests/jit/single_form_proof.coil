(module compiler.features.jit-single-form-proof)
(import "coil.alloc" :use [malloc-allocator])
(import "coil.jit" :as jit)
(import "coil.primitive" :as primitive)
(import "coil.cc" :as cc)

(defn main [] (-> i64)
  (let [(mut session) (jit/jit-session-new (malloc-allocator))]
    (if (!= (jit/jit-compile! (mut session)
                              "(module proof.sdk)
        (import \"coil.primitive\" :as primitive)
        (defn once [] (-> Code)
          (if (= (primitive/code-int (primitive/code-session-state `0)) 0)
              (do (primitive/code-session-stage! `1) `42)
              (primitive/error \"an accepted macro invocation was replayed\")))
        (defn original [] (-> i64) (once))
        (export-c [original :as \"proof_original\"])")
            0)
        1
        (let [before (jit/jit-symbol-address (mut session) "proof_original")]
          (cond (= (primitive/cast i64 before) 0) 2
                (!= (jit/jit-compile-with-entry! (mut session)
                                                 "(defn later [] (-> i64) (+ (original) 1))"
                                                 "(if (= (later) 43) 0 90)")
                    0)
                  3
                (!= (primitive/cast i64 before)
                    (primitive/cast i64
                                    (jit/jit-symbol-address (mut session)
                                                            "proof_original")))
                  4
                (!= (primitive/call-ptr (primitive/cast (fnptr (cc/C) [] i64)
                                                        before))
                    42)
                  5
                ; An address inside a function the session loaded is in that
                ; function's symbol, which begins where the function does; the
                ; host's own code is no symbol of the session's.
                (let [(mut start) (primitive/cast (ptr i8) 0)
                      name
                        (jit/jit-symbol-at (mut session)
                                           (primitive/cast (ptr i8)
                                                           (+ (primitive/cast i64 before) 4))
                                           (mut start))]
                  (or (= (len name) 0)
                      (!= (primitive/cast i64 start) (primitive/cast i64 before))))
                  6
                (let [(mut start) (primitive/cast (ptr i8) 0)]
                  (!= (len (jit/jit-symbol-at (mut session)
                                              (primitive/cast (ptr i8) (primitive/fnptr-of main))
                                              (mut start)))
                      0))
                  7
                :else (jit/jit-reset! (mut session)))))))
