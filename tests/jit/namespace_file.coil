(module ns.app)
(import "coil.alloc" :use [malloc-allocator])
(import "coil.slice" :use *)
(import "coil.str" :use *)
(import "coil.fs" :as fs)
(import "coil.jit" :as jit)

; Built in a project of its own with `--emit-state STATE`, then run with STATE
; and the path of a module file (`ns.helper`) written into that project after
; the build, from another working directory and with no project environment:
; the state finds namespaces where its build's loader did, in the roots the
; build scanned, so the new file is found. jit-static-session.py runs it.

(defn main [(argc i32) (argv (ptr (ptr i8)))] (-> i64)
  (if (< (cast i64 argc) 3)
      1
      (let [a (malloc-allocator)
            (mut session) (jit/jit-session-new a)
            bytes
              (match (fs/read-file a (from-cstr (load (index argv 1))))
                (Ok [b] b)
                (Err [_] ""))
            helper (from-cstr (load (index argv 2)))]
        (jit/jit-session-set-quiet! (mut session) true)
        (if (!= (jit/jit-session-adopt! (mut session) bytes) 0)
            2
            (let [env (jit/jit-env-current (mut session))
                  own (jit/jit-env-namespace-file (mut session) env "ns.app" a)
                  added (jit/jit-env-namespace-file (mut session) env "ns.helper" a)
                  library (jit/jit-env-namespace-file (mut session) env "coil.str" a)
                  missing (jit/jit-env-namespace-file (mut session) env "ns.missing" a)
                  status
                    (cond (or (= (len (.path own)) 0) (.library own)) 3
                          (!= (.path added) helper) 4
                          (or (not (.library library)) (!= (.path library) "")) 5
                          (or (!= (.path missing) "")
                              (= (len (.diagnostic missing)) 0))
                            6
                          :else 0)]
              (jit/jit-env-release! (mut session) env)
              status)))))
