(module compiler.features.jit-metadata-lifetime)
(import "coil.alloc" :use [malloc-allocator])
(import "coil.jit" :as jit)
(import "coil.primitive" :as p)

(defn main [] (-> i64)
  (block :test
    (let [(mut session) (jit/jit-session-new (malloc-allocator))]
      (when (!= (jit/jit-compile! (mut session)
        "(import \"coil.jit.lifetime\")
         (defn temporary :jit/retain false [] (-> i64) 42)
         (export-c [temporary :as \"captured\"])") 0)
        (return-from :test 1))
      (let [address (jit/jit-symbol-address (mut session) "captured")
            lease (jit/jit-generation-retain-current! (mut session))]
        (when (= (p/cast i64 address) 0) (return-from :test 2))
        (when (= (jit/jit-compile! (mut session) "(defn invalid [] (-> i64) (temporary))") 0)
          (return-from :test 3))
        (when (!= (jit/jit-compile! (mut session) "(defn independent [] (-> i64) 7)") 0)
          (return-from :test 4))
        (when (!= (p/call-ptr (p/cast (fnptr c [] i64) address)) 42)
          (return-from :test 5))
        (when (!= (jit/jit-reset! (mut session)) -1) (return-from :test 6))
        (jit/jit-generation-release-token! (mut session) lease))
      (when (!= (jit/jit-compile! (mut session)
        "(defn helper :jit/retain false [] (-> i64) 11)
         (defn caller [] (-> i64) (helper))") 0)
        (return-from :test 7))
      (when (!= (jit/jit-compile-with-entry! (mut session) "" "(if (= (caller) 11) 0 99)") 0)
        (return-from :test 8))
      (when (= (jit/jit-compile! (mut session)
        "(defn generic :jit/retain false [T] [(x T)] (-> T) x)") 0)
        (return-from :test 9))
      (when (!= (jit/jit-reset! (mut session)) 0) (return-from :test 10))
      0)))
