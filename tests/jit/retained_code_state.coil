(module compiler.features.jit-retained-code-state)
(import "coil.alloc" :use [malloc-allocator])
(import "coil.jit" :as jit)

(defn main [] (-> i64)
  (let [(mut session) (jit/jit-session-new (malloc-allocator))]
    (cond (!= (jit/jit-compile! (mut session)
                                "(module retained.state)
       (import \"coil.primitive\" :as primitive)
       (defn retain [(next Code)] (-> Code)
         (let [accepted (primitive/code-session-state `0)]
           (do (primitive/code-session-stage! next) accepted)))
       (defn prior-monomorph-count [] (-> Code)
         (let [report (primitive/code-session-monomorphs) count (- (primitive/code-count report) 1)] `~count))
       (defn rejected [] (-> Code) (primitive/code-session-rejected-state `-1))
       (defstruct Held [A] [(a A)])
       (defn nest [] (-> i64)
         (let [(mut h) (Held :a (Some 41))] (match (.a h) (Some [v] v) (None [] 0))))
       (defn nested-argument [] (-> Code)
         (let [report (primitive/code-session-monomorphs) (mut found) 0]
           (for [i 1 (primitive/code-count report)]
             (let [item (primitive/code-nth report i)]
               (when (and (primitive/code-list? item)
                          (>= (primitive/code-count item) 4)
                          (= (primitive/code-source (primitive/code-nth item 3))
                             \"[(coil.core.Option i64)]\"))
                 (set! found 1)
                 0)))
           `~(load found)))
       (defn identity [T] [(value T)] (-> T) value)
       (defn instantiate [] (-> i64) (identity 41))")
              0)
            1
          (!= (jit/jit-prepare-with-entry! (mut session)
                                           ""
                                           "(if (= (retain 1) 0) 0 20)")
              0)
            2
          (!= (jit/jit-commit-prepared! (mut session)) 0) 3
          (= (jit/jit-prepare-with-entry! (mut session)
                                          "(defn reject-candidate [] (-> Code)
            (do (primitive/code-session-stage! `2) (primitive/code-session-condition! 7) (primitive/error \"structured rejection\")))
          (reject-candidate)"
                                          "0")
             0)
            4
          (!= (jit/jit-condition-kind (mut session)) 7) 5
          (!= (jit/jit-prepare-with-entry! (mut session)
                                           ""
                                           "(if (and (> (prior-monomorph-count) 0)
                                                     (and (= (nested-argument) 1)
                                                          (and (= (rejected) 2) (= (retain 3) 1))))
                                                0
                                                23)")
              0)
            6
          (!= (jit/jit-commit-prepared! (mut session)) 0) 7
          (!= (jit/jit-prepare-with-entry! (mut session) "" "(do (retain 4) 0)")
              0)
            8
          (!= (jit/jit-abort-prepared! (mut session)) 0) 9
          (!= (jit/jit-prepare-with-entry! (mut session)
                                           ""
                                           "(if (= (retain 5) 3) 0 21)")
              0)
            10
          (!= (jit/jit-commit-prepared! (mut session)) 0) 11
          (!= (jit/jit-prepare-with-entry! (mut session)
                                           ""
                                           "(if (= (retain 6) 5) 0 22)")
              0)
            12
          (!= (jit/jit-abort-prepared! (mut session)) 0) 13
          :else (jit/jit-reset! (mut session)))))
