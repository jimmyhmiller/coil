(import "coil.jit" :as jit)

(defn main [] (-> i64)
  (let [(mut s) (jit/jit-session-new (malloc-allocator))]
    (cond (!= (jit/jit-compile-with-entry! (mut s)
                                           "(module persistent.policy)
(import \"coil.primitive\" :as primitive)
(import \"coil.phase\" :as phase)
; Each submission after the first also declares, in a module it does not
; write, a struct again and its impl: the impl declared is the one a later
; submission finds, though the transform's forms there have one place in the
; source.
(defn plain [(form Code) (at Code)] (-> Code)
 (cond (primitive/code-sym? form) (primitive/datum->syntax at (primitive/code-source form))
       (or (primitive/code-list? form) (primitive/code-vector? form))
        (let [out (primitive/code-list-new)]
         (for [i 0 (primitive/code-count form)]
          (primitive/code-list-push! out (plain (primitive/code-nth form i) at)))
         (if (primitive/code-vector? form)
             (primitive/code-nth `([~@(primitive/code-list-done out)]) 0)
             (primitive/code-list-done out)))
       :else form))
(defn aside [(next i64) (at Code)] (-> Code)
 (let [weight (primitive/code-symbol \"weight\" (primitive/int->str next))]
  (plain
   `(persistent.aside
     (retire-struct Held)
     (defstruct Held [(n i64) (m i64)])
     (impl Weigh Held (weigh [(self (ptr Held))] (-> i64) ~next))
     (defn ~weight [] (-> i64) (let [(mut h) (Held :n 1 :m 2)] (weigh (mut h)))))
   at)))
(defn track [(forms Code)] (-> Code)
 (let [next (+ (primitive/code-int (primitive/code-session-state `0)) 1)]
  (primitive/code-session-stage! `~next)
  ; a transform runs again on what it answered, until that is what it is given
  (let [(mut there) false]
   (for [i 0 (primitive/code-count forms)]
    (when (= (primitive/code-source (primitive/code-nth (primitive/code-nth forms i) 0))
             \"persistent.aside\")
     (set! there true)
     0))
   (if (and (> next 1) (not (load there)))
       `(do ~@forms ~(aside next forms))
       `(do ~@forms)))))
(transform track :phase (phase/BeforeExpand))
(defn count [] (-> Code) (primitive/code-session-state `0))
(defstruct Box [T] [(value T)])
(defn wrap [T] [(x T)] (-> (Box T)) (Box :value x))
(defn boxed [] (-> (Box i64)) (wrap 7))
(module persistent.aside)
(defstruct Held [(n i64)])
(deftrait Weigh [Self] (weigh [(self (ptr Self))] (-> i64)))
(impl [T] Weigh T (weigh [(self (ptr T))] (-> i64) 0))
"
                                           "0")
              0)
            1
