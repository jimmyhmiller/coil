                                           "(if (and (= (count) 1) (= (persistent.aside.weight2) 2)) 0 91)")
              0)
            2
          (!= (jit/jit-compile-with-entry! (mut s)
                                           "(defn use-new [] (-> bool) (let [box (wrap true)] (.value box)))"
                                           "(if (and (use-new)
                                                     (and (= (use-box) 7)
                                                          (and (= (count) 2) (= (persistent.aside.weight3) 3))))
                                                0
                                                92)")
              0)
            3
          :else (jit/jit-reset! (mut s)))))
