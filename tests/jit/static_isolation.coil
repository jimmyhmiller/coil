(module compiler.features.jit-static-isolation)
(import "coil.alloc" :use [malloc-allocator])
(import "coil.jit" :as jit)

(defn main [] (-> i64)
  (let [(mut first) (jit/jit-session-new (malloc-allocator))
        (mut second) (jit/jit-session-new (malloc-allocator))]
    (cond (!= (jit/jit-compile! (mut first)
                                "(module isolated) (defstruct Value [(n i64)])
              (defn value [] (-> i64) 7)")
              0)
            1
          (!= (jit/jit-compile! (mut second)
                                "(module isolated) (defstruct Value [(n bool)])
              (defn value [] (-> bool) true)")
              0)
            2
          (!= (jit/jit-compile-with-entry! (mut first)
                                           "(defn read [] (-> i64) (let [v (Value :n (value))] (.n v)))"
                                           "(if (= (read) 7) 0 90)")
              0)
            3
          (!= (jit/jit-compile-with-entry! (mut second)
                                           "(defn read [] (-> bool) (let [v (Value :n (value))] (.n v)))"
                                           "(if (read) 0 91)")
              0)
            4
          (!= (jit/jit-reset! (mut first)) 0) 5
          (!= (jit/jit-compile-with-entry! (mut second)
                                           ""
                                           "(if (read) 0 92)")
              0)
            6
          :else (jit/jit-reset! (mut second)))))
