(module compiler.features.jit-before-expand-sum-replacement)
(import "coil.alloc" :use [malloc-allocator])
(import "coil.jit" :as jit)

(defn main [] (-> i64)
  (let [(mut session) (jit/jit-session-new (malloc-allocator))]
    (cond (!= (jit/jit-compile-with-entry! (mut session)
                                           "(module sum-policy)
         (import \"coil.primitive\" :as p)
         (import \"coil.phase\" :as phase)
         (defn rewrite-one [(form Code) (version i64)] (-> Code)
           (if (and (p/code-list? form) (and (> (p/code-count form) 1)
             (and (p/code-eq (p/code-nth form 0) `defsum)
               (p/code-eq (p/code-nth form 1) `Choice))))
             (if (= version 1)
               `(defsum Choice-physical-v1 (First-physical-v1))
               `(defsum Choice-physical-v2 (First-physical-v2) (Second-physical-v2)))
             form))
         (defn version-sum [(modules Code)] (-> Code)
           (let [version (+ (p/code-int (p/code-session-state `0)) 1)
                 out (p/code-list-new)]
             (for [mi 0 (p/code-count modules)]
               (let [module (p/code-nth modules mi) next (p/code-list-new)]
                 (for [fi 0 (p/code-count module)]
                   (p/code-list-push! next (rewrite-one (p/code-nth module fi) version)))
                 (p/code-list-push! out (p/code-list-done next))))
             (p/code-session-stage! `~version)
             `(do ~@(p/code-list-done out))))
         (transform version-sum :phase (phase/BeforeExpand))
         (defsum Choice (First))"
                                           "0")
              0)
            1
          (!= (jit/jit-compile-with-entry! (mut session)
                                           "(module sum-policy) (defsum Choice (First) (Second))"
                                           "0")
              0)
            2
          ; A struct the transform changes is the struct: code a later
          ; submission runs as it compiles sees what the transform made, as the
          ; code it compiles does.
          (!= (jit/jit-compile-with-entry! (mut session)
                                           "(module sum-policy)
         (import \"coil.primitive\" :as primitive)
         (defn widen-one [(form Code)] (-> Code)
           (if (and (p/code-list? form) (and (> (p/code-count form) 1)
             (and (p/code-eq (p/code-nth form 0) `defstruct)
               (and (p/code-eq (p/code-nth form 1) `Narrow)
                 (= (p/code-count (p/code-nth form 2)) 1)))))
             `(defstruct ~(p/code-nth form 1) [~@(p/code-nth form 2) (room i64)])
             form))
         (defn widen [(modules Code)] (-> Code)
           (let [out (p/code-list-new)]
             (for [mi 0 (p/code-count modules)]
               (let [module (p/code-nth modules mi) next (p/code-list-new)]
                 (for [fi 0 (p/code-count module)]
                   (p/code-list-push! next (widen-one (p/code-nth module fi))))
                 (p/code-list-push! out (p/code-list-done next))))
             `(do ~@(p/code-list-done out))))
         (transform widen :phase (phase/BeforeExpand))
         (defstruct Narrow [(a i64)])"
                                           "(- (primitive/cast i64 (primitive/sizeof Narrow)) 16)")
              0)
            3
          (!= (jit/jit-compile-with-entry! (mut session)
                                           "(module sum-policy)
         (const WIDTH (comptime (primitive/cast i64 (primitive/sizeof Narrow))))"
                                           "(- (+ WIDTH (primitive/cast i64 (primitive/sizeof Narrow))) 32)")
              0)
            4
          ; A struct a transform declares beside an impl it writes is one of
          ; the application's types, and a method of that impl may be compiled
          ; for a macro to run: the macro's expansion calls a function named as
          ; the method is, which selects the impl. The struct comes with it.
          (!= (jit/jit-compile-with-entry! (mut session)
                                           "(module sum-helper) (defn odd? [(x i64)] (-> bool) (= (% x 2) 1)) (defn odd-one? [] (-> bool) (odd? 1))"
                                           "0")
              0)
            5
          (!= (jit/jit-compile-with-entry! (mut session)
                                           "(module sum-policy)
         (import \"sum-helper\" :as helper)
         (deftrait Peek [Self] (peek [(self (ptr Self))] (-> i64)) (odd? [(self (ptr Self))] (-> bool)))
         (defn shadow [(modules Code)] (-> Code)
           (let [out (p/code-list-new)]
             (for [mi 0 (p/code-count modules)]
               (let [module (p/code-nth modules mi) next (p/code-list-new)]
                 (for [fi 0 (p/code-count module)]
                   (let [form (p/code-nth module fi)]
                     (if (and (p/code-list? form) (and (= (p/code-count form) 2) (p/code-eq (p/code-nth form 0) `shadowed)))
                         (let [was (p/datum->syntax (p/code-nth form 1) \"Narrow-shadow\")]
                           (p/code-list-push! next `(defstruct ~was [(a i64)]))
                           (p/code-list-push! next `(impl Peek Narrow
                                                      (peek [(self (ptr Narrow))] (-> i64) (.a (p/cast (ptr ~was) self)))
                                                      (odd? [(self (ptr Narrow))] (-> bool) true)))
                           0)
                         (do (p/code-list-push! next form) 0))))
                 (p/code-list-push! out (p/code-list-done next))))
             `(do ~@(p/code-list-done out))))
         (transform shadow :phase (phase/BeforeExpand))"
                                           "0")
              0)
            6
          (!= (jit/jit-compile-with-entry! (mut session)
                                           "(module sum-policy) (shadowed Narrow)"
                                           "0")
              0)
            7
          (!= (jit/jit-compile-with-entry! (mut session)
                                           "(module sum-policy) (defn pick [(c Code)] (-> Code) (if (helper/odd-one?) c c)) (defn picked [] (-> i64) (pick 4))"
                                           "(- (sum-policy.picked) 4)")
              0)
            8
          :else (jit/jit-reset! (mut session)))))
