(module compiler.features.jit-meta-generator-later)
(import "coil.alloc" :use [malloc-allocator])
(import "coil.jit" :as jit)

;; A `(meta …)` generator lowers to calls into the metaprogram shim. A session
;; whose earlier submissions already hold part of the shim must still give a
;; later generator the rest of it.
(defn main [] (-> i64)
  (let [(mut session) (jit/jit-session-new (malloc-allocator))]
    (cond
      (!= (jit/jit-compile! (mut session) "(defn x [] (-> i64) (let [y 1] y))") 0) 1
      (!= (jit/jit-compile-with-entry! (mut session)
            "(module later) (defn make [] (-> Code) `(defn* generated [] (-> i64) 9)) (meta (make))"
            "0") 0) 2
      :else 0)))
