(module jit-project-manifest-error)
(import "coil.alloc" :as a)
(import "coil.jit" :as jit)
;; A malformed Coil.toml is an error the session reports and survives: loading
;; it answers -3, and the session goes on compiling without the project.
(defn main [] (-> i64)
  (let [(mut compiler) (jit/jit-session-new (a/malloc-allocator))]
    (assert (= (jit/jit-session-load-project! (mut compiler)) -3))
    (assert (= (jit/jit-compile-with-entry! (mut compiler) "(module session)" "(if (= (+ 40 2) 42) 0 1)") 0))
    (assert (= (jit/jit-reset! (mut compiler)) 0))
    0))
