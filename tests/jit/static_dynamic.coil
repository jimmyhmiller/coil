(module probe.dynamic)
(import "coil.alloc" :use [malloc-allocator])
(import "coil.jit" :as jit)
(import "coil.primitive" :as primitive)

(defn main [] (-> i64)
  (let [(mut s) (jit/jit-session-new (malloc-allocator))]
    (cond (!= (jit/jit-compile! (mut s)
                                "(module dynamic.example)
(import \"coil.primitive\" :as primitive)
(import \"coil.var\" :use [Var var-static])
(defn initial [] (-> i64) 7)
(defn slot [] (-> (Var (fnptr c [] i64))) (var-static (fnptr c [] i64) (primitive/fnptr-of initial)))
(defn invoke [] (-> i64) (let [f (slot)] (f)))
(defn version [(installer Code) (value Code)] (-> Code)
 (let [implementation (primitive/gensym)]
  `(do
    (defn ~implementation [] (-> i64) ~value)
    (defn ~installer [] (-> i64) (set (slot) (primitive/fnptr-of ~implementation))))))
(export-c [initial :as \"frozen\"])
")
              0)
            1
          (!= (jit/jit-compile-with-entry! (mut s)
                                           "(version install-one 10)"
                                           "(do (install-one) (if (= (invoke) 10) 0 90))")
              0)
            2
          (!= (jit/jit-compile-with-entry! (mut s)
                                           "(version install-two 20)"
                                           "(do (install-two) (if (and (= (invoke) 20) (= (initial) 7)) 0 91))")
              0)
            3
          (!= (jit/jit-evaluate! (mut s) "(invoke)") 0) 4
          :else
            (let [address (jit/jit-symbol-address (mut s) "frozen")]
              (if (= (primitive/cast i64 address) 0)
                  5
                  (let [f (primitive/cast (fnptr c [] i64) address)
                        value (primitive/call-ptr f)]
                    (jit/jit-reset! (mut s))
                    (if (= value 7) 0 6)))))))
