(module compiler.features.host-environment-embed)
(import "coil.meta" :as meta)

;;; Build-time tooling for host_environment.coil, which registers `embed-environments`
;;; as a transform. Nothing is handed to a session unless this says so: it describes
;;; the application module and hands over every function and `def` of it, which is
;;; the list `(meta/definitions M)` answers, and it describes a second module and
;;; hands over none of its functions, so only its types, generics and macros come
;;; along. A program that wants another set builds another list.
(defn embed-environments [(modules Code)] (-> Code)
  (let [host `compiler.features.host-environment
        app `compiler.features.host-environment-app]
    (meta/transform-result
      (meta/embed-environment
        (meta/embed-environment modules host "environment" `(~app) (meta/definitions app))
        host "types-only" `(compiler.features.host-environment-types) `()))))
