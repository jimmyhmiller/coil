(module compiler.features.jit-import-tolerant-helper)
(import "coil.alloc" :use [malloc-allocator])
(import "coil.jit" :as jit)

(defn main [] (-> i64)
  (let [(mut session) (jit/jit-session-new (malloc-allocator))
        result
          (jit/jit-prepare-with-entry! (mut session)
                                       "(module helper_user)
             (import \"compiler.features.jit-import-tolerant-helper-lib\" :use [entry])
             (defn value [] (-> i64) 3)"
                                       "0")]
    (when (= result 0)
      (assert (= (jit/jit-abort-prepared! (mut session)) 0)))
    (assert (= (jit/jit-session-free! (mut session)) 0))
    result))
