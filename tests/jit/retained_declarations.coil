(module compiler.features.jit-retained-declarations)
(import "coil.alloc" :use [malloc-allocator])
(import "coil.jit" :as jit)
(import "coil.io" :use [print-str stderr])

;;; A session keeps the source of every definition it accepted, so a description
;;; query in a later submission can copy a generic record, a trait, an impl, a
;;; generic function or a constant an earlier one wrote.
(defn main [] (-> i64)
  (let [(mut session) (jit/jit-session-new (malloc-allocator))
        first
          (jit/jit-compile! (mut session)
                            "(module r)
                 (defstruct Box [T] [(item T)])
                 (deftrait Area [Self] (area [(self Self)] (-> i64)))
                 (defstruct Sq [(side i64)])
                 (impl Area Sq (area [(self Sq)] (-> i64) (* (.side self) (.side self))))
                 (defn id [T] [(v T)] (-> T) v)
                 (const K 7)")
        second
          (jit/jit-compile! (mut session)
                            "(module q)
                  (import \"coil.primitive\" :as p)
                  (import \"coil.meta\" :as meta)
                  (defn expect [(name Code) (want (slice u8))] (-> i64)
                    (unless (= (meta/source (meta/answered (meta/declaration name))) want)
                      (p/error (meta/source (meta/answered (meta/declaration name))))) 0)
                  (defn verify [(modules Code)] (-> Code)
                    (expect `r.Box \"(defstruct Box [T] [(item T)])\")
                    (expect `r.Area \"(deftrait Area [Self] (area [(self Self)] (-> i64)))\")
                    (expect `r.id \"(defn id [T] [(v T)] (-> T) v)\")
                    (expect `r.K \"(const K 7)\")
                    (expect `r.Sq \"(defstruct Sq [(side i64)])\")
                    (unless (= (len (meta/answered (meta/module-impls `r))) 1) (p/error \"the impl of the earlier submission is missing\"))
                    `0)
                  (checker verify)")]
    (when (!= second 0) (print-str (stderr) (jit/jit-diagnostic (mut session))))
    ; An anonymous function is its own function in every submission: one a later
    ; submission writes is not the one an earlier submission wrote, though each
    ; is the first of its submission.
    (let [third
            (jit/jit-compile! (mut session)
                              "(module r)
                  (import \"coil.primitive\" :as p)
                  (import \"coil.cc\" :as cc)
                  (defn tens [] (-> (fnptr (cc/C) [i64] i64)) (fn [x] (* 10 x)))")
          fourth
            (jit/jit-compile-with-entry! (mut session)
                                         "(module r)
                  (defn hundreds [] (-> (fnptr (cc/C) [i64] i64)) (fn [x] (* 100 x)))"
                                         "(if (and (= (p/call-ptr (hundreds) 1) 100) (= (p/call-ptr (tens) 1) 10)) 0 1)")]
      (when (!= fourth 0) (print-str (stderr) (jit/jit-diagnostic (mut session))))
      ; A struct keeps its hidden fields and their initializers: a later
      ; submission's construction fills them, and its code reaches them.
      (let [fifth
              (jit/jit-compile! (mut session)
                                "(module r)
                  (defstruct Stamp [(version i64)])
                  (defstruct Stamped :hidden [(stamp Stamp (Stamp :version 7))] [(x i64)])")
            sixth
              (jit/jit-compile-with-entry! (mut session)
                                           "(module r)
                  (defn version [(s (ptr Stamped))] (-> i64) (.version (hidden s stamp)))"
                                           "(let [(mut s) (Stamped :x 1)] (- (+ (version (mut s)) (.x s)) 8))")]
        (when (!= sixth 0) (print-str (stderr) (jit/jit-diagnostic (mut session))))
        (jit/jit-reset! (mut session))
        (cond (!= first 0) 1
              (!= second 0) 2
              (!= third 0) 3
              (!= fourth 0) 4
              (!= fifth 0) 5
              (!= sixth 0) 6
              :else 0)))))
