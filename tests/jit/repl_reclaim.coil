(module compiler.features.jit-repl-reclaim)
(import "coil.alloc" :use [malloc-allocator])
(import "coil.jit" :as jit)

; A coil.repl Var holds its current implementation at run time, where the compiler
; sees no dependency, so each implementation is the Var's metadata root. Reclaiming
; releases the implementations the Var no longer holds and keeps the one it does,
; however many submissions later.
(defn main [] (-> i64)
  (let [(mut s) (jit/jit-session-new (malloc-allocator))]
    (assert (= (jit/jit-compile-with-entry! (mut s) "(module policy.example)
         (import \"coil.repl\")
         (defn f [] (-> i64) 15)
         (defn caller [] (-> i64) (f))" "(coil.repl/publish)") 0))
    (assert (= (jit/jit-compile-with-entry! (mut s) "(defn f [] (-> i64) 20)" "(coil.repl/publish)") 0))
    (assert (= (jit/jit-compile-with-entry! (mut s) "(defn f [] (-> i64) 30)" "(coil.repl/publish)") 0))
    (assert (= (jit/jit-generation-count (mut s)) 3))
    ; The second version is released; the first holds the Vars and `caller`.
    (assert (= (jit/jit-reclaim-retired! (mut s)) 1))
    (assert (= (jit/jit-compile-with-entry! (mut s) "" "(if (= (caller) 30) 0 1)") 0))
    ; Later submissions do not make the current implementation reclaimable.
    (for [i 0 4]
      (assert (= (jit/jit-compile-with-entry! (mut s) "" "(if (= (f) 30) 0 1)") 0))
      (assert (>= (jit/jit-reclaim-retired! (mut s)) 0))
      (assert (= (jit/jit-compile-with-entry! (mut s) "" "(if (= (caller) 30) 0 1)") 0)))
    (assert (= (jit/jit-reset! (mut s)) 0))
    0))
