(module compiler.features.jit-repl-import-var)
(import "coil.alloc" :use [malloc-allocator])
(import "coil.jit" :as jit)

(defn main [] (-> i64)
  (let [(mut session) (jit/jit-session-new (malloc-allocator))]
    (assert (= (jit/jit-session-load-project! (mut session)) 0))
    (let [result
      (cond
        (!= (jit/jit-compile-with-entry! (mut session)
          "(module project-host.test)
           (import \"coil.repl\")
           (import \"project-dependency.live-color\" :as color)
           (defn retained [] (-> i64) (color/value))"
          "0") 0) 1
        (!= (jit/jit-compile-with-entry! (mut session)
          "" "(if (= (retained) 41) 0 90)") 0) 2
        (!= (jit/jit-compile-with-entry! (mut session)
          "(module project-dependency.live-color)
           (defn value [] (-> i64) 99)"
          "(coil.repl/publish)") 0) 3
        (!= (jit/jit-compile-with-entry! (mut session)
          "(module project-host.test)" "(if (= (retained) 99) 0 91)") 0) 4
        (= (jit/jit-compile-with-entry! (mut session)
          "(module project-dependency.live-color)
           (defn value [] (-> bool) true)"
          "(coil.repl/publish)") 0) 5
        (!= (jit/jit-compile-with-entry! (mut session)
          "(module project-host.test)" "(if (= (retained) 99) 0 92)") 0) 6
        :else 0)]
      (jit/jit-reset! (mut session))
      result)))
