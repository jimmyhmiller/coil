(module compiler.features.jit-adopted-state)
(import "coil.alloc" :use [malloc-allocator])
(import "coil.slice" :use *)
(import "coil.str" :use *)
(import "coil.fs" :as fs)
(import "coil.primitive" :as primitive)
(import "coil.var" :use [var-static])
(import "coil.jit" :as jit)

; A program built with `coil build --emit-state STATE` is compiled as the first
; submission of a session, and STATE is the compiler state that session then
; serves. Run with STATE as its argument, the program gives it to a session of
; its own (`jit-session-adopt!`), and the session continues where the build
; stopped: what it compiles is checked against this program's definitions and
; linked to the ones already running in this process, and its metaprograms
; read what they kept during the build.

(defstruct Point [(x i64) (y i64)])

(deftrait Scaled [Self] (scaled [(self (ptr Self)) (by i64)] (-> i64)))

(impl Scaled Point
  (scaled [(self (ptr Point)) (by i64)] (-> i64)
    (* by (+ (.x self) (.y self)))))

(defn area [(p (ptr Point))] (-> i64)
  (* (.x p) (.y p)))

(defn pick [T] [(first T) (second T)] (-> T)
  second)

;;; Storage of this program, which the code a session compiles also reads.
(defn calls [] (-> (ptr i64))
  (primitive/alloc-static i64 0))

(defn counted-area [(p (ptr Point))] (-> i64)
  (store! (calls) (+ (load (calls)) 1))
  (area p))

;;; A global of this program: a `def`, which code a session compiles names too.
(def hits (var-static i64 0))

;;; Keep NEXT as the session's state and answer what was kept before.
(defn keep [(next Code)] (-> Code)
  (let [kept (primitive/code-session-state `0)]
    (primitive/code-session-stage! next)
    kept))

;;; How many submissions the session compiling this has begun.
(defn submission [] (-> Code)
  (let [n (primitive/code-session-submission)] `~n))

(defn main [(argc i32) (argv (ptr (ptr i8)))] (-> i64)
  (let [a (malloc-allocator)
        (mut session) (jit/jit-session-new a)
        (mut p) (Point :x 3 :y 4)
        ; the build is submission 1, and keeps 41
        built (+ (keep 41) (submission))
        bytes
          (if (< (cast i64 argc) 2)
              ""
              (match (fs/read-file a (from-cstr (load (index argv 1))))
                (Ok [b] b)
                (Err [_] "")))]
    (jit/jit-session-set-quiet! (mut session) true)
    (cond (!= built 1) 1
          (= (len bytes) 0) 2
          (!= (pick 1 2) 2) 3
          (!= (counted-area (mut p)) 12) 4
          ; bytes that are not a state are refused, and the session is as it was
          (!= (jit/jit-session-adopt! (mut session) "not a state") -2) 5
          (!= (jit/jit-session-adopt! (mut session) bytes) 0) 6
          ; a state is adopted once, before anything is compiled
          (!= (jit/jit-session-adopt! (mut session) bytes) -1) 7
          ; New code names the program's struct, function, trait method and
          ; generic (an instance the program made, and one it did not), and is
          ; linked to the running definitions: the static it bumps is ours.
          (!= (jit/jit-compile-with-entry! (mut session)
                                           "(module compiler.features.jit-adopted-state)
               (defn measure [(p (ptr Point))] (-> i64)
                 (+ (counted-area p) (scaled p 2) (pick 100 200) (if (pick false true) 1000 0)))"
                                           "(let [(mut p) (Point :x 3 :y 4)] (- (measure (mut p)) 1226))")
              0)
            8
          (!= (load (calls)) 2) 9
          ; and so is the global: the session reads what the program set, and
          ; the program reads what the session's code set
          (!= (do
                (set hits 5)
                (jit/jit-compile-with-entry! (mut session)
                                             "(module compiler.features.jit-adopted-state)"
                                             "(let [seen (get hits)] (set hits 9) (- seen 5))"))
              0)
            14
          (!= (get hits) 9) 15
          ; the session's metaprograms continue: the build kept 41 and was
          ; submission 1, and this is the session's third, so submission 4
          (!= (jit/jit-compile-with-entry! (mut session)
                                           "(module compiler.features.jit-adopted-state)"
                                           "(- (+ (keep 42) (submission)) 45)")
              0)
            10
          (!= (jit/jit-compile-with-entry! (mut session)
                                           "(module compiler.features.jit-adopted-state)"
                                           "(- (keep 43) 42)")
              0)
            11
          ; what the program defines is defined: a second definition is refused
          (= (jit/jit-compile! (mut session)
                               "(module compiler.features.jit-adopted-state)
               (defn area [(p (ptr Point))] (-> i64) 0)")
             0)
            12
          ; the facts of the build answer for the adopted state
          (!= (let [e (jit/jit-env-current (mut session))
                    answer
                      (jit/jit-env-dependents (mut session)
                                              e
                                              "compiler.features.jit-adopted-state.area"
                                              a)]
                (jit/jit-env-release! (mut session) e)
                (if (= answer
                       "((compiler.features.jit-adopted-state.counted-area function body))")
                    0
                    1))
              0)
            13
          :else 0)))
