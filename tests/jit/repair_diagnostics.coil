(module jit-repair-diagnostics)
(import "coil.primitive" :as p)
(import "coil.alloc" :as a)
(import "coil.jit" :as jit)
(import "coil.result" :use *)
(import "coil.str" :use *)

(defn says? [(s (ptr jit/JitSession)) (part (slice u8))] (-> bool)
  (match (find (jit/jit-diagnostic s) part) (Some [_] true) (None [] false)))

(defn main [] (-> i32)
  (let [session (p/alloc-stack jit/JitSession)]
    (store! session (jit/jit-session-new (a/malloc-allocator)))
    (assert (= (jit/jit-compile-with-entry! session
                                            "(module demo) (defannotation :client/definition i64) (defn* good [] (-> i64) 1)"
                                            "0")
               0))
    (assert (!= (jit/jit-prepare-with-entry! session
                                             "(module demo) (defn* bad :client/definition 77 [] (-> i64) true)"
                                             "0")
                0))
    (assert (= (jit/jit-repair-count session) 1))
    (assert (= (jit/jit-repair-function session 0) "demo.bad"))
    (let [(mut identity) -1]
      (assert (jit/jit-repair-annotation-i64! session
                                              0
                                              "client/definition"
                                              (mut identity)))
      (assert (= (load identity) 77))
      (assert (not (jit/jit-repair-annotation-i64! session
                                                   0
                                                   "other/key"
                                                   (mut identity))))
      (assert (= (load identity) 77)))
    (assert (!= (jit/jit-repair-diagnostic session 0) ""))
    ; Churn candidate-sized allocations after its compiler arena has closed.
    (for [i 0 64]
      (match (a/alloc [u8] (a/malloc-allocator) 4096)
        (Some [memory] (a/free (a/malloc-allocator) memory))
        (None [] (assert false))))
    (assert (= (jit/jit-repair-function session 0) "demo.bad"))
    (let [(mut identity) -1]
      (assert (jit/jit-repair-annotation-i64! session
                                              0
                                              "client/definition"
                                              (mut identity)))
      (assert (= (load identity) 77))
      (assert (not (jit/jit-repair-annotation-i64! session
                                                   0
                                                   "other/key"
                                                   (mut identity))))
      (assert (= (load identity) 77)))
    (assert (!= (jit/jit-repair-diagnostic session 0) ""))
    (assert (!= (jit/jit-prepare-with-entry! session "(module demo) (defn*" "0")
                0))
    (assert (= (jit/jit-repair-count session) 0))
    (assert (= (jit/jit-compile-with-entry! session
                                            "(module demo) (defn* bad [] (-> i64) 2)"
                                            "0")
               0))
    (assert (= (jit/jit-repair-count session) 0))
    ; A submission is reported where it sits in the file it is named after: its
    ; first line is the origin's line, and only that line takes the origin's
    ; column. Naming the source again puts its text back at the file's start.
    (jit/jit-session-set-source-origin! session "src/app.coil" 40 1)
    (assert (!= (jit/jit-prepare! session "(module demo)\n(defn* off [] (-> i64)\n  (+ 1 true))")
                0))
    (assert (says? session "--> src/app.coil:42:8"))
    (jit/jit-session-set-source-origin! session "src/app.coil" 7 5)
    (assert (!= (jit/jit-prepare! session "(module demo) (defn* off [] (-> i64) (+ 1 true))")
                0))
    (assert (says? session "--> src/app.coil:7:47"))
    (assert (!= (jit/jit-prepare! session "(module demo)\n  (defn* off [] (-> i64) (+ 1 true))")
                0))
    (assert (says? session "--> src/app.coil:8:31"))
    (jit/jit-session-set-source-name! session "src/app.coil")
    (assert (!= (jit/jit-prepare! session "(module demo)\n(defn* off [] (-> i64)\n  (+ 1 true))")
                0))
    (assert (says? session "--> src/app.coil:3:8"))
    (assert (= (jit/jit-reset! session) 0)))
  0)
