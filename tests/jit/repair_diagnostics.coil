(module jit-repair-diagnostics)
(import "coil.primitive" :as p)
(import "coil.alloc" :as a)
(import "coil.jit" :as jit)
(import "coil.result" :use *)
(import "coil.str" :use *)

(defn says? [(s (ptr jit/JitSession)) (part (slice u8))] (-> bool)
  (match (find (jit/jit-diagnostic s) part) (Some [_] true) (None [] false)))

(defn main [] (-> i32)
  (let [session (p/alloc-stack jit/JitSession)]
    (store! session (jit/jit-session-new (a/malloc-allocator)))
    (assert (= (jit/jit-compile-with-entry! session
                                            "(module demo) (defannotation :client/definition i64) (defn* good [] (-> i64) 1)"
                                            "0")
               0))
    (assert (!= (jit/jit-prepare-with-entry! session
                                             "(module demo) (defn* bad :client/definition 77 [] (-> i64) true)"
                                             "0")
                0))
    (assert (= (jit/jit-repair-count session) 1))
    (assert (= (jit/jit-repair-function session 0) "demo.bad"))
    (let [(mut identity) -1]
      (assert (jit/jit-repair-annotation-i64! session
                                              0
                                              "client/definition"
                                              (mut identity)))
      (assert (= (load identity) 77))
      (assert (not (jit/jit-repair-annotation-i64! session
                                                   0
                                                   "other/key"
                                                   (mut identity))))
      (assert (= (load identity) 77)))
    (assert (!= (jit/jit-repair-diagnostic session 0) ""))
    ; Churn candidate-sized allocations after its compiler arena has closed.
    (for [i 0 64]
      (match (a/alloc [u8] (a/malloc-allocator) 4096)
        (Some [memory] (a/free (a/malloc-allocator) memory))
        (None [] (assert false))))
    (assert (= (jit/jit-repair-function session 0) "demo.bad"))
    (let [(mut identity) -1]
      (assert (jit/jit-repair-annotation-i64! session
                                              0
                                              "client/definition"
                                              (mut identity)))
      (assert (= (load identity) 77))
      (assert (not (jit/jit-repair-annotation-i64! session
                                                   0
                                                   "other/key"
                                                   (mut identity))))
      (assert (= (load identity) 77)))
    (assert (!= (jit/jit-repair-diagnostic session 0) ""))
    (assert (!= (jit/jit-prepare-with-entry! session "(module demo) (defn*" "0")
                0))
    (assert (= (jit/jit-repair-count session) 0))
    (assert (= (jit/jit-compile-with-entry! session
                                            "(module demo) (defn* bad [] (-> i64) 2)"
                                            "0")
               0))
    (assert (= (jit/jit-repair-count session) 0))
    ; From its origin's offset on, a submission is reported where it sits in
    ; the file the origin names; the client's own text before the offset keeps
    ; the submission's name and lines. Only the offset's line takes the
    ; origin's column.
    (jit/jit-session-set-source-name! session "<client>")
    (jit/jit-session-set-source-origin! session "src/app.coil" 40 1 14)
    (assert (!= (jit/jit-prepare! session "(module demo)\n(defn* off [] (-> i64)\n  (+ 1 true))")
                0))
    (assert (says? session "--> src/app.coil:41:8"))
    (jit/jit-session-set-source-origin! session "src/app.coil" 1 5 14)
    (assert (!= (jit/jit-prepare! session "(module demo)\n(defn* off [] (-> i64) (+ 1 true))")
                0))
    (assert (says? session "--> src/app.coil:1:33"))
    (assert (!= (jit/jit-prepare! session "(module demo) (defn* off [] (-> i64)\n  (+ 1 true))")
                0))
    (assert (says? session "--> src/app.coil:2:8"))
    (assert (!= (jit/jit-prepare! session "(module demo)") 0))
    (assert (says? session "is past the end of a submission of 13 bytes"))
    (assert (= (jit/jit-diagnostic-count session) 1))
    (assert (= (jit/jit-diagnostic-offset session 0) -1))
    (jit/jit-session-set-source-origin! session "src/app.coil" 40 1 21)
    (assert (!= (jit/jit-prepare! session "(module demo)\n(oops)\n(defn* off [] (-> i64) 1)")
                0))
    (assert (says? session "--> <client>:2:"))
    (assert (not (says? session "src/app.coil")))
    (jit/jit-session-clear-source-origins! session)
    (assert (!= (jit/jit-prepare! session "(module demo)\n(defn* off [] (-> i64)\n  (+ 1 true))")
                0))
    (assert (says? session "--> <client>:3:8"))
    ; One submission of two forms from two files, each with its own origin and
    ; its own error: each diagnostic is reported in its file, and says which
    ; byte of the submission it points at.
    (let [prefix "(module demo)\n"
          first "(defn* f1 [] (-> i64) (+ 1 true))"
          second "(defn* f2 [] (-> i64)\n  (+ 2 false))"
          a (len prefix)
          b (+ a (+ (len first) 1))]
      (jit/jit-session-add-source-origin! session "shapes.coil" 10 1 a (+ a (len first)))
      (jit/jit-session-add-source-origin! session "app.coil" 33 3 b (+ b (len second)))
      (assert (!= (jit/jit-prepare! session
                                    "(module demo)\n(defn* f1 [] (-> i64) (+ 1 true))\n(defn* f2 [] (-> i64)\n  (+ 2 false))\n")
                  0))
      (assert (= (jit/jit-diagnostic-count session) 2))
      (assert (jit/jit-diagnostic-error? session 0))
      (assert (jit/jit-diagnostic-error? session 1))
      (let [o0 (jit/jit-diagnostic-offset session 0)
            o1 (jit/jit-diagnostic-offset session 1)]
        (assert (and (>= o0 a) (< o0 (+ a (len first)))))
        (assert (and (>= o1 b) (< o1 (+ b (len second))))))
      (assert (match (find (jit/jit-diagnostic-text session 0) "--> shapes.coil:10:")
                (Some [_] true)
                (None [] false)))
      (assert (match (find (jit/jit-diagnostic-text session 1) "--> app.coil:34:8")
                (Some [_] true)
                (None [] false)))
      (assert (match (find (jit/jit-diagnostic-text session 0) "app.coil")
                (Some [_] false)
                (None [] true))))
    (jit/jit-session-clear-source-origins! session)
    (assert (= (jit/jit-reset! session) 0)))
  0)
