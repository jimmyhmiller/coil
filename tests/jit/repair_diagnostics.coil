(module jit-repair-diagnostics)
(import "coil.primitive" :as p)
(import "coil.alloc" :as a)
(import "coil.jit" :as jit)
(import "coil.result" :use *)

(defn main [] (-> i32)
  (let [session (p/alloc-stack jit/JitSession)]
    (store! session (jit/jit-session-new (a/malloc-allocator)))
    (assert (= (jit/jit-compile-with-entry! session "(module demo) (defannotation :client/definition i64) (defn* good [] (-> i64) 1)" "0") 0))
    (assert (!= (jit/jit-prepare-with-entry! session "(module demo) (defn* bad :client/definition 77 [] (-> i64) true)" "0") 0))
    (assert (= (jit/jit-repair-count session) 1))
    (assert (= (jit/jit-repair-function session 0) "demo.bad"))
    (let [(mut identity) -1]
      (assert (jit/jit-repair-annotation-i64! session 0 "client/definition" (mut identity)))
      (assert (= (load identity) 77))
      (assert (not (jit/jit-repair-annotation-i64! session 0 "other/key" (mut identity))))
      (assert (= (load identity) 77)))
    (assert (!= (jit/jit-repair-diagnostic session 0) ""))
    ; Churn candidate-sized allocations after its compiler arena has closed.
    (for [i 0 64]
      (match (a/alloc [u8] (a/malloc-allocator) 4096)
        (Some [memory] (a/free (a/malloc-allocator) memory))
        (None [] (assert false))))
    (assert (= (jit/jit-repair-function session 0) "demo.bad"))
    (let [(mut identity) -1]
      (assert (jit/jit-repair-annotation-i64! session 0 "client/definition" (mut identity)))
      (assert (= (load identity) 77))
      (assert (not (jit/jit-repair-annotation-i64! session 0 "other/key" (mut identity))))
      (assert (= (load identity) 77)))
    (assert (!= (jit/jit-repair-diagnostic session 0) ""))
    (assert (!= (jit/jit-prepare-with-entry! session "(module demo) (defn*" "0") 0))
    (assert (= (jit/jit-repair-count session) 0))
    (assert (= (jit/jit-compile-with-entry! session "(module demo) (defn* bad [] (-> i64) 2)" "0") 0))
    (assert (= (jit/jit-repair-count session) 0))
    (assert (= (jit/jit-reset! session) 0)))
  0)
