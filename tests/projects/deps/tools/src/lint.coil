(module pftools.lint)
(import "coil.primitive" :as primitive)
(import "coil.meta" :use [user-forms])

;;; Flags `(+ x 0)` and offers `x`.
(defn adds-zero? [(f Code)] (-> bool)
  (and (primitive/code-list? f)
       (= (len f) 3)
       (= (get f 0) `+)
       (= (get f 2) `0)))

(defn walk [(f Code)] (-> void)
  (when (adds-zero? f)
    (primitive/suggest f "adding zero does nothing" (get f 1)))
  (when (primitive/code-list? f)
    (for child f (walk child))))

(defn adds-zero [(modules Code)] (-> Code)
  (for form (user-forms modules) (walk form))
  `0)

(checker adds-zero)
