(module pftools.kv)
(import "coil.primitive" :as primitive)
(import "coil.slice" :use [subslice])

(reader-provider "pftools.kv" read-kv)

;;; One `name=digits` line as `(const name value)`.
(defn kv-const [(line (slice u8))] (-> Code)
  (let [(mut eq) 0
        (mut value) 0]
    (while (!= (get line eq) #\=) (set! eq (+ eq 1)))
    (for i (range (+ eq 1) (len line))
      (set! value (+ (* value 10) (- (cast i64 (get line i)) #\0))))
    `(const ~(primitive/syntax->datum (primitive/code-symbol (subslice line
                                                                       0
                                                                       eq)))
            ~value)))

;;; Reads a file of `name=digits` lines as a module of constants.
(defn read-kv [(context Code)] (-> Code)
  (let [source (primitive/code-str (get context 2))
        (mut forms) (primitive/code-list-new)
        (mut start) 0]
    (for i (range 0 (len source))
      (when (= (get source i) #\newline)
        (when (> i start)
          (push! (mut forms) (kv-const (subslice source start i))))
        (set! start (+ i 1))))
    `(do ~@forms)))
