;;; Built as a unit beside units/mathlib.coil: a module with no export list that
;;; re-exports another's names, less three, with one renamed. A consumer of the unit
;;; sees what it would see from source: `twice`, mathlib's names under the names
;;; this import gives them, and not `bump!`, `count`, mathlib's `main` or `combine`. Every name the
;;; module declares is public, whatever declared it: a function its `meta`
;;; generates, a C function, the variants of a generic sum, a derive generator,
;;; constants (one computed by calling the module's own function at compile
;;; time, one its `meta` generates), and its `main`, which in a unit is no process
;;; entry but an ordinary function, as in any imported module; and a function
;;; keeps its parameters' names, so a named call reaches it.
(module pfunit.facade)
(import "coil.primitive" :as primitive)
(import "pfunit.mathlib" :use * :exclude [count bump! main] :rename [[combine comb]] :reexport)
(import "coil.cc" :as cc)

(defn twice [(x i64)] (-> i64)
  (add x x))

(defn gen-sixteen [] (-> Code)
  `(do (defn ~(primitive/syntax->datum `sixteen) [] (-> i64) 16)
       (const ~(primitive/syntax->datum `SEVENTEEN) 17)))
(meta (gen-sixteen))

(const ANSWER (twice 21))
(const SMALL u8 7)

(extern labs :cc (cc/C) [i64] (-> i64))

(defsum Pick [T] (Neither) (One [(value T)]))

(deftrait Width [Self] (width [(x Self)] (-> i64)))
(defderive Width
  (struct [T]
    `(impl Width ~T (width [(x ~T)] (-> i64) ~(primitive/code-field-count T)))))

(defn main [] (-> i64)
  (twice 4))
