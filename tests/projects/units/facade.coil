;;; Built as a unit beside units/mathlib.coil: a module with no export list that
;;; re-exports another's names, less two, with one renamed. A consumer of the unit
;;; sees what it would see from source: `twice`, mathlib's names under the names
;;; this import gives them, and not `bump!`, `count` or `combine`.
(module pfunit.facade)
(import "pfunit.mathlib" :use * :exclude [count bump!] :rename [[combine comb]] :reexport)

(defn twice [(x i64)] (-> i64)
  (add x x))
