(module pfunit.facade-consumer)
(import "pfunit.facade" :use *)

(defstruct Triple [(a i64) (b i64) (c i64)])
(derive Width Triple)

(defn main [] (-> i64)
  (if (and (= (twice :x 21) 42)
           (= (add 40 2) 42)
           (= (comb (Point :x 6 :y 7)) 42)
           (= (sixteen) 16)
           (= (labs -5) 5)
           (= (match (: (One 4) (Pick i64)) (One [v] v) (Neither [] 0)) 4)
           (= (width (Triple :a 1 :b 2 :c 3)) 3))
      0
      1))
