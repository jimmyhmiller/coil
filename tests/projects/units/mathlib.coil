;;; Built ahead of time with `coil build-unit` and linked into units/consumer.coil:
;;; a struct, module state, a generic, a generic-local static shared across the
;;; unit boundary, aggregates whose passing differs between backends, impls, an
;;; exported `main`: in a unit, or imported from source (facade's consumer
;;; compiles this module so), it is an ordinary function, never the process entry;
;;; and runtime `def`s: an exported one whose storage the unit holds and the
;;; consumer shares, a private one an exported generic reads, and coil.math's,
;;; which the unit embeds privately while the consumer compiles its own.
(module pfunit.mathlib)
(import "coil.primitive" :as primitive)
(import "coil.alloc" :use *)
(import "coil.var" :use [var-static])
(import "coil.math" :as math)
(import "coil.layout" :as layout)

; `BigV`/`BigNone` are variants: exporting them is exporting `Big`.
(export Point
        Vec2
        add
        combine
        make-vec
        bump!
        count
        ident
        slot
        lib-slot-bump!
        straddle
        Big
        BigV
        BigNone
        mk-big
        big-total
        main
        tally
        tally-read
        tally-bump!
        hidden-plus
        circle-area)

(defstruct Point [(x i64) (y i64)])

(defstruct Vec2 :layout (layout/Explicit) :size 8 :align 4
  [(x f32 :at 0) (y f32 :at 4)])

(defn add [(x i64) (y i64)] (-> i64)
  (+ x y))

(defn combine [(p Point)] (-> i64)
  (* (.x p) (.y p)))

(defn make-vec [] (-> Vec2)
  (Vec2 :x 123.0 :y 77.0))

(defn counter [] (-> (ptr i64))
  (primitive/alloc-static i64))

(defn bump! [] (-> i64)
  (let [c (counter)] (store! c (+ (load c) 1)) (load c)))

(defn count [] (-> i64)
  (load (counter)))

(defn ident [T] [(x T)] (-> T)
  x)

(defn slot [T] [] (-> (ptr i64))
  (primitive/alloc-static i64))

(defn lib-slot-bump! [] (-> i64)
  (let [s (slot [i64])] (store! s (+ (load s) 10)) (load s)))

; Aggregate arguments whose passing differs between Coil's backends: the fifth
; argument is a slice straddling the last integer argument register, and Big is a
; 32-byte sum passed and returned by value. Each crashes or reads garbage when a
; unit and its consumer come from different backends.
(defn straddle [(n i64)
                (s1 (slice u8))
                (s2 (slice u8))
                (s3 (slice u8))
                (s4 (slice u8))] (-> i64)
  (+ n
     (+ (len s1)
        (+ (len s2) (+ (len s3) (* 100 (len s4)))))))

(defsum Big (BigV [(x i64) (y i64) (z i64)]) (BigNone))

; Impls travel with the unit: a trait impl reaching a private helper, an inherent
; impl, and a derived one. The consumer dispatches to each.
(defn point-key [(p Point)] (-> i64)
  (+ (* 1000 (.x p)) (.y p)))

(impl Eq Point
  (= [(a Point) (b Point)] (-> bool)
    (= (point-key a) (point-key b))))

(impl Point
  (norm1 [(p Point)] (-> i64)
    (+ (.x p) (.y p))))

(derive Hash Point)

(defn mk-big [(x i64)] (-> Big)
  (BigV x (+ x 1) (+ x 2)))

(defn big-total [(b Big) (t i64)] (-> i64)
  (match b
    (BigV [x y z] (+ (+ x (* 10 y)) (+ (* 100 z) t)))
    (BigNone [] -1)))

(defn main [] (-> i64)
  (+ (count) 100))

; One copy of this state: the unit's object holds it, its interface declares it.
(def tally (var-static i64 5))

(defn tally-read [] (-> i64)
  (get tally))

(defn tally-bump! [] (-> i64)
  (set tally (+ (get tally) 1))
  (get tally))

; Private, but read by a generic the consumer instantiates.
(def hidden 40)

(defn hidden-plus [T] [(x i64)] (-> i64)
  (+ hidden x))

(defn circle-area [(r f64)] (-> f64)
  (* math/pi (* r r)))
