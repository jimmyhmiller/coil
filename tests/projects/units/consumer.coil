(module pfunit.consumer)
(import "pfunit.mathlib" :as mathlib :use *)
(import "coil.math" :as math)

(defn main [] (-> i64)
  (bump!)
  (bump!)
  (lib-slot-bump!)
  (store! (slot [i64]) (+ (load (slot [i64])) 1))
  ; The consumer writes the unit's def and the unit reads it, and back.
  (set tally 9)
  (if (or (!= (straddle 1 "ab" "cde" "f" "ghij") 407)
          (!= (big-total (mk-big 1) 5) 326)
          (!= (big-total (BigNone) 5) -1)
          (not (= (Point :x 1 :y 2) (Point :x 1 :y 2)))
          (= (Point :x 1 :y 2) (Point :x 2 :y 1))
          (!= (norm1 (Point :x 3 :y 4)) 7)
          (!= (hash (Point :x 1 :y 2)) (hash (Point :x 1 :y 2)))
          (!= (tally-read) 9)
          (!= (tally-bump!) 10)
          (!= (get tally) 10)
          (!= (hidden-plus [i64] 2) 42)
          (!= (cast i64 (circle-area 1.0)) 3)
          (!= (cast i64 math/tau) 6))
      2
      (if (and (= (add 40 2) 42)
               (and (= (combine (Point :x 40 :y 2)) 80)
                    (and (= (count) 2)
                         (= (mathlib/main) 102)
                         (and (= (ident [i64] 42) 42)
                              (and (= (lib-slot-bump!) 21)
                                   (let [v (make-vec)]
                                     (and (= (cast i64 (.x v)) 123)
                                          (= (cast i64 (.y v)) 77))))))))
          0
          1)))
