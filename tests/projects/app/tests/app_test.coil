(module pfapp.app-test)
(import "pfapp.clamp" :use [clamp])
(import "pfpath.geometry" :as geometry)
(import "coil.cc" :as cc)

(extern app_native_answer :cc (cc/C) [] (-> i64))

(deftest clamp-bounds
  (assert-eq (clamp -5 0 10) 0)
  (assert-eq (clamp 5 0 10) 5))

(deftest native-and-dependency-link
  (assert-eq (app_native_answer) 42)
  (assert-eq (geometry/area 2 3) 6))

(deftest the-project-transform-applies-to-tests
  (assert-eq (inc 1) 2))
