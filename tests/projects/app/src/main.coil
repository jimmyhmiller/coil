(module pfapp.main)
(import "coil.args" :as args)
(import "pfapp.clamp" :use [clamp])
(import "pfapp.settings" :as settings)
(import "pfpath.geometry" :as geometry)
(import "pfgit.version" :as version)
(import "pfengine" :use [tick! ticks])

(extern app_native_answer :cc c [] (-> i64))

(extern sqrt :cc c [f64] (-> f64))

(defn report [] (-> i64)
  (println "clamp {}" (clamp 99 0 10))
  (println "settings {}x{}" settings/width settings/height)
  (println "path {}" (geometry/area 6 7))
  (println "git {}" (version/version))
  (tick!)
  (tick!)
  (println "engine {}" (ticks))
  (println "native {}" (app_native_answer))
  (println "libm {}" (cast i64 (sqrt 1764.0)))
  (println "dialect {}" (inc (inc 40)))
  0)

(defn main [(argc i32) (argv (ptr (ptr i8)))] (-> i64)
  (args/args-set! argc argv)
  (if (= (args/args-nth 1) "overflow")
      (do
        (println "{}" (+ 9223372036854775807 (args/args-count)))
        0)
      (report)))
