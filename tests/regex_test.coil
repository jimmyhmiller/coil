(module regex_test)
(import "coil.regex" :as re)
(import "coil.assert" :use [assert assert-eq])

(defn counted [(calls (ptr i64))] (-> (slice u8))
  (store! calls (+ (load calls) 1))
  "xxabbbczz")

(defn main [] (-> i64)
  (assert (re/is-match? "abc" "--abc--"))
  (assert (re/is-match? "dws" "--dws--"))
  (assert (re/is-match? "\\$" "cost: $5"))
  (assert (not (re/is-match? "abc" "ab")))
  (assert (re/is-match? "^abc$" "abc"))
  (assert (not (re/is-match? "^abc$" "xabc")))
  (assert (re/is-match? "b|c" "b"))
  (assert (re/is-match? "b|c" "c"))
  (assert (re/is-match? "(b|c)+" "bcbc"))
  (assert (re/is-match? "a(b|c)+d" "abcd"))
  (assert (re/is-match? "a(b|c)+d" "abcbcd"))
  (assert (re/is-match? "a(b|c)+d" "--abcbcd--"))
  (assert (re/is-match? "colou?r" "color"))
  (assert (re/is-match? "colou?r" "colour"))
  (assert (re/is-match? "[A-Za-z_][A-Za-z0-9_]*" "__coil42"))
  (assert (not (re/is-match? "^[^0-9]+$" "abc7")))
  (assert (re/is-match? "^\\d+\\s\\w+$" "42 coil_7"))
  (assert (re/is-match? "a.*z" "a line z"))
  (assert (not (re/is-match? "a.*z" "a\nz")))
  ; Required-byte analysis must not mistake a byte on only one alternative for
  ; a byte that every successful path consumes.
  (assert (re/is-match? "aZ|bY" "--bY--"))
  (assert (re/is-match? "Z?abc" "--abc--"))
  (assert (not (re/is-match? "[A-Za-z]+Z" "onlyletters")))
  (assert (re/is-match? "a*" ""))
  (let [(mut calls) 0]
    (assert (re/is-match? "ab+c" (counted (mut calls))))
    (assert-eq (load calls) 1))
  0)
