; Streaming-client acceptance tests against tests/http_client_stream_server.py.
;
; Each check returns a distinct exit code so a failure names itself. 0 = all passed.
;
; The load-bearing one is `check-streams-incrementally`: the server flushes three
; fragments 300ms apart, and the test asserts the FIRST callback ran well before the
; transfer finished. Feeding a fully buffered body through several callbacks would
; satisfy every other check here but fail that one.
(module httpclientstreamintegration)
(import "coil.primitive" :as primitive)
(import "coil.http.client" :as http)
(import "coil.alloc" :as alloc)
(import "coil.arraylist" :as arraylist)
(import "coil.cancellation" :as cancellation)
(import "coil.slice" :as slice)
(import "coil.str" :as str)
(import "coil.thread" :as thread)
(import "coil.time" :as time)
(import "coil.fs" :use [os-pick])

; ---- a monotonic clock, for the streaming proof -------------------------------
; timespec is {i64 tv_sec, i64 tv_nsec} on both platforms; only the clock id differs.
(defstruct TimeSpec [(sec i64) (nsec i64)])
(extern clock_gettime :cc c [i32 (ptr TimeSpec)] (-> i32))
(const CLOCK_MONOTONIC (os-pick 1 6))

(defn now-ms [] (-> i64)
  (let [ts (alloc/stack TimeSpec)]
    (clock_gettime (primitive/cast i32 CLOCK_MONOTONIC) ts)
    (primitive/iadd (primitive/imul (.sec ts) 1000)
                    (primitive/idiv (.nsec ts) 1000000))))

; ---- the shared accumulator every sink writes through -------------------------
(defstruct Acc
  [(buf (arraylist/ArrayList u8))
   (calls i64)
   (started-ms i64)
   (first-call-ms i64)
   (stop-after i64)])   ; 0 = never stop
(defn acc [] (-> (ptr Acc))
  (alloc/static Acc))

(defn acc-reset! [(a (ptr alloc/Allocator)) (stop-after i64)] (-> i64)
  (let [s (acc)]
    (set! (.buf s) (arraylist/al-new [u8] a))
    (set! (.calls s) 0)
    (set! (.started-ms s) (now-ms))
    (set! (.first-call-ms s) -1)
    (set! (.stop-after s) stop-after)
    0))

(defn acc-body [] (-> (slice u8))
  (arraylist/al-slice [u8] (.buf (acc))))

;; The sink. Records when it was first called, appends the chunk, and asks to stop once
;; `stop-after` bytes have arrived.
(defn acc-consume [(data (ptr u8)) (n i64) (ctx (ptr i8))] (-> i64)
  (let [s (primitive/cast (ptr Acc) ctx)]
    (when (= (load (field s calls)) (primitive/cast i64 0))
      (store! (field s first-call-ms) (now-ms)))
    (set! (.calls s) (primitive/iadd (.calls s) 1))
    (arraylist/al-extend! [u8] (mut (.buf s)) data n)
    (let [stop-after (.stop-after s)]
      (if (and (> stop-after (primitive/cast i64 0))
               (>= (arraylist/al-len [u8] (.buf s)) stop-after))
          http/BODY-STOP
          http/BODY-CONTINUE))))

(defn mk-sink [] (-> http/BodySink)
  (let [p (alloc/stack http/BodySink)]
    (set! (.context p) (primitive/cast (ptr i8) (acc)))
    (set! (.consume p) (primitive/fnptr-of acc-consume))
    (load p)))

(defn mk-get [(req (ptr http/Request)) (url (slice u8)) (timeout-ms i64)] (-> i64)
  (store! (field req method) "GET")
  (store! (field req url) url)
  (store! (field req headers) (slice/slice-new [http/Header] (primitive/cast (ptr http/Header) 0) 0))
  (store! (field req body) "")
  (store! (field req connect-timeout-ms) 1000)
  (store! (field req timeout-ms) timeout-ms)
  (store! (field req follow-redirects) false)
  0)

; ---- the checks ---------------------------------------------------------------
; Each returns 0 on success or its own nonzero code.

;; 1 + THE STREAMING PROOF: three fragments 300ms apart arrive in order, and the first
;; callback runs long before the transfer ends.
(defn check-streams-incrementally [(a (ptr alloc/Allocator))] (-> i64)
  (let [req (alloc/stack http/Request)]
    (mk-get req "http://127.0.0.1:38474/slow" 10000)
    (acc-reset! a 0)
    (match (http/request-stream a req (mk-sink))
      (Err [e] 10)
      (Ok [r]
          (let [s (acc)
                done-ms (now-ms)
                started (.started-ms s)
                first-at (primitive/isub (.first-call-ms s) started)
                total (primitive/isub done-ms started)
                body (acc-body)]
            (http/streaming-response-free a r)
            (cond
              (not (str/str-eq body "alphabravocharlie")) 11
              (< (load (field s calls)) (primitive/cast i64 2)) 12
              ; the server took >=600ms to finish; a buffered client cannot have seen
              ; the first byte before that.
              (< total (primitive/cast i64 400)) 13
              (>= first-at (primitive/isub total 200)) 14
              :else 0))))))

;; 2: a record torn across three flushes reassembles in order.
(defn check-split-record [(a (ptr alloc/Allocator))] (-> i64)
  (let [req (alloc/stack http/Request)]
    (mk-get req "http://127.0.0.1:38474/split" 10000)
    (acc-reset! a 0)
    (match (http/request-stream a req (mk-sink))
      (Err [e] 20)
      (Ok [r]
          (do
            (http/streaming-response-free a r)
            (if (str/str-eq (acc-body) "<<<record>>>") 0 21))))))

;; 3: empty and single-chunk bodies.
(defn check-empty-and-single [(a (ptr alloc/Allocator))] (-> i64)
  (let [req (alloc/stack http/Request)]
    (mk-get req "http://127.0.0.1:38474/empty" 5000)
    (acc-reset! a 0)
    (match (http/request-stream a req (mk-sink))
      (Err [e] 30)
      (Ok [r]
          (do
            (http/streaming-response-free a r)
            (if (!= (slice/slice-len (acc-body)) (primitive/cast i64 0))
                31
                (do
                  (mk-get req "http://127.0.0.1:38474/single" 5000)
                  (acc-reset! a 0)
                  (match (http/request-stream a req (mk-sink))
                    (Err [e2] 32)
                    (Ok [r2]
                        (do
                          (http/streaming-response-free a r2)
                          (if (str/str-eq (acc-body) "one-shot") 0 33)))))))))))

;; 4: binary bytes survive — a NUL, a lone 0xFF, a truncated multi-byte sequence.
(defn check-binary-body [(a (ptr alloc/Allocator))] (-> i64)
  (let [req (alloc/stack http/Request)]
    (mk-get req "http://127.0.0.1:38474/binary" 5000)
    (acc-reset! a 0)
    (match (http/request-stream a req (mk-sink))
      (Err [e] 40)
      (Ok [r]
          (let [body (acc-body)]
            (http/streaming-response-free a r)
            (cond
              (!= (slice/slice-len body) (primitive/cast i64 9)) 41
              (!= (primitive/cast i64 (slice/slice-get body 0)) (primitive/cast i64 0)) 42
              (!= (primitive/cast i64 (slice/slice-get body 2)) (primitive/cast i64 255)) 43
              (!= (primitive/cast i64 (slice/slice-get body 4)) (primitive/cast i64 0)) 44
              (!= (primitive/cast i64 (slice/slice-get body 8)) (primitive/cast i64 127)) 45
              :else 0))))))

;; 5: a non-2xx response still streams its body and exposes its headers.
(defn check-non-2xx [(a (ptr alloc/Allocator))] (-> i64)
  (let [req (alloc/stack http/Request)]
    (mk-get req "http://127.0.0.1:38474/teapot" 5000)
    (acc-reset! a 0)
    (match (http/request-stream a req (mk-sink))
      (Err [e] 50)
      (Ok [r]
          (let [status (http/streaming-response-status r)
                nheaders (http/streaming-response-header-count r)
                body (acc-body)]
            (http/streaming-response-free a r)
            (cond
              (!= status (primitive/cast i64 418)) 51
              (not (str/str-eq body "short and stout")) 52
              (< nheaders (primitive/cast i64 2)) 53
              :else 0))))))

;; 6 + 10: the consumer stops after a partial body. That is an Ok with `stopped` set —
;; not a transport error — the status is still there, and nothing leaks.
(defn check-consumer-stop [(a (ptr alloc/Allocator))] (-> i64)
  (let [req (alloc/stack http/Request)]
    (mk-get req "http://127.0.0.1:38474/big" 20000)
    (acc-reset! a 2048)
    (match (http/request-stream a req (mk-sink))
      (Err [e] 60)
      (Ok [r]
          (let [stopped (http/streaming-response-stopped r)
                status (http/streaming-response-status r)
                n (slice/slice-len (acc-body))]
            (http/streaming-response-free a r)
            (cond
              (not stopped) 61
              (!= status (primitive/cast i64 200)) 62
              (< n (primitive/cast i64 2048)) 63
              ; it must have stopped EARLY — the full body is 64 KiB
              (>= n (primitive/cast i64 65536)) 64
              :else 0))))))

;; 7: the total timeout fires after partial delivery, and reports as a timeout rather
;; than an unexplained transport failure.
(defn check-timeout-after-partial [(a (ptr alloc/Allocator))] (-> i64)
  (let [req (alloc/stack http/Request)]
    (mk-get req "http://127.0.0.1:38474/hang" 1200)
    (acc-reset! a 0)
    (match (http/request-stream a req (mk-sink))
      (Ok [r] (do (http/streaming-response-free a r) 70))
      (Err [e]
           (cond
             (not (http/error-timeout? e)) 71
             ; the first fragment did arrive before the timeout
             (not (str/str-eq (acc-body) "begin")) 72
             :else 0)))))

;; 7b: a connect timeout to a black-hole address is also a timeout.
;;     198.51.100.0/24 is TEST-NET-2 (RFC 5737) and is not routable.
(defn check-connect-timeout [(a (ptr alloc/Allocator))] (-> i64)
  (let [req (alloc/stack http/Request)]
    (mk-get req "http://198.51.100.1:38474/never" 4000)
    (set! (.connect-timeout-ms req) 700)
    (acc-reset! a 0)
    (match (http/request-stream a req (mk-sink))
      (Ok [r] (do (http/streaming-response-free a r) 75))
      (Err [e] (if (http/error-timeout? e) 0 76)))))

;; 8: a connection refused before any header is a transport failure, not a timeout.
(defn check-connect-refused [(a (ptr alloc/Allocator))] (-> i64)
  (let [req (alloc/stack http/Request)]
    (mk-get req "http://127.0.0.1:1/unreachable" 3000)
    (acc-reset! a 0)
    (match (http/request-stream a req (mk-sink))
      (Ok [r] (do (http/streaming-response-free a r) 80))
      (Err [e]
           (cond
             (http/error-timeout? e) 81
             (!= (slice/slice-len (acc-body)) (primitive/cast i64 0)) 82
             :else 0)))))

;; 8b: the server disconnects mid-body. The bytes already delivered stay delivered, and
;; the call reports the failure rather than a truncated success.
(defn check-disconnect-mid-body [(a (ptr alloc/Allocator))] (-> i64)
  (let [req (alloc/stack http/Request)]
    (mk-get req "http://127.0.0.1:38474/cut" 5000)
    (acc-reset! a 0)
    (match (http/request-stream a req (mk-sink))
      ; curl may report this either way depending on how the peer closed; what must NOT
      ; happen is losing the bytes that did arrive.
      (Ok [r] (do (http/streaming-response-free a r) (if (str/str-eq (acc-body) "begin") 0 85)))
      (Err [e] (if (str/str-eq (acc-body) "begin") 0 86)))))

;; 9: repeated requests do not leak. Run the streaming path many times; a leak of the
;; per-request curl handle or header block shows up as a climbing RSS or an fd exhaustion
;; failure partway through.
(defn check-repeated [(a (ptr alloc/Allocator))] (-> i64)
  (let [req (alloc/stack http/Request)
        (mut i) 0
        (mut bad) 0]
    (loop (if (or (>= (load i) (primitive/cast i64 50)) (!= (load bad) (primitive/cast i64 0)))
              (break)
              (do
                (mk-get req "http://127.0.0.1:38474/single" 5000)
                (acc-reset! a 0)
                (match (http/request-stream a req (mk-sink))
                  (Err [e] (set! bad 90))
                  (Ok [r]
                      (do
                        (http/streaming-response-free a r)
                        (when (not (str/str-eq (acc-body) "one-shot"))
                          (store! bad 91)))))
                (set! i (primitive/iadd (load i) 1)))))
    (load bad)))

; ---- reentrancy ---------------------------------------------------------------
; The docs claim a nested request from inside a sink is permitted. That claim has to be
; tested, not asserted: each call allocates its own curl easy handle and this module keeps
; no shared state, but "should be fine" is not evidence.
(defstruct Reent [(rc i64) (done bool)])
(defn reent [] (-> (ptr Reent))
  (alloc/static Reent))

(defn reentrant-consume [(data (ptr u8)) (n i64) (ctx (ptr i8))] (-> i64)
  (let [s (primitive/cast (ptr Reent) ctx)]
    (when (not (load (field s done)))
      (store! (field s done) true)
      (let [a (alloc/malloc-allocator)
            req (alloc/stack http/Request)]
        (mk-get req "http://127.0.0.1:38474/single" 5000)
        (match (http/request a req)
          (Err [e] (store! (field s rc) 101))
          (Ok [r]
              (do
                (when (not (str/str-eq (http/response-body r) "one-shot"))
                  (store! (field s rc) 102)
                  0)
                (http/response-free a r)
                0))))
      0)
    http/BODY-CONTINUE))

; ---- cancellation ------------------------------------------------------------
(defn request-cancellation [(arg (ptr i8))] (-> (ptr i8))
  (try (let [delay (try-or! (time/duration-millis 200) 0)] (match (time/sleep delay) (Err [_] 0) (Ok [_] 0))))
  (cancellation/cancellation-request!
    (primitive/cast (ptr cancellation/Cancellation) arg))
  (primitive/cast (ptr i8) 0))

;; Cancellation wakes a transfer whose peer has gone silent. The request timeout is
;; deliberately long, so returning promptly proves the cancellation fd woke curl's poll.
(defn check-cancellation [(a (ptr alloc/Allocator))] (-> i64)
  (let [req (alloc/stack http/Request)
        token (alloc/stack cancellation/Cancellation)
        worker (alloc/stack thread/Thread)]
    (mk-get req "http://127.0.0.1:38474/hang" 10000)
    (acc-reset! a 0)
    (try (let [_ (try-or! (cancellation/cancellation-init token) 110)]
              (let [started (now-ms)
                    spawned (thread/thread-spawn worker
                                                 (primitive/fnptr-of request-cancellation)
                                                 (primitive/cast (ptr i8) token))]
                (if (!= spawned (primitive/cast i32 0))
                    (do (cancellation/cancellation-close! token) 111)
                    (let [outcome (http/request-stream-cancellable a req (mk-sink) token)
                          elapsed (primitive/isub (now-ms) started)
                          joined (thread/thread-join worker)]
                      (cancellation/cancellation-close! token)
                      (match outcome
                        (Ok [r] (do (http/streaming-response-free a r) 112))
                        (Err [_]
                             (cond
                               (!= joined (primitive/cast i32 0)) 113
                               (> elapsed (primitive/cast i64 2000)) 114
                               (not (str/str-eq (acc-body) "begin")) 115
                               :else 0))))))))))

;; A whole nested request runs inside the outer transfer's callback, and both complete.
(defn check-reentrant-request [(a (ptr alloc/Allocator))] (-> i64)
  (let [req (alloc/stack http/Request)
        sink (alloc/stack http/BodySink)
        s (reent)]
    (set! (.rc s) 0)
    (set! (.done s) false)
    (set! (.context sink) (primitive/cast (ptr i8) s))
    (set! (.consume sink) (primitive/fnptr-of reentrant-consume))
    (mk-get req "http://127.0.0.1:38474/slow" 15000)
    (match (http/request-stream a req (load sink))
      (Err [e] 100)
      (Ok [r]
          (do
            (http/streaming-response-free a r)
            (cond
              (!= (load (field s rc)) (primitive/cast i64 0))
                (load (field s rc))
              ; the nested request must actually have run
              (not (load (field s done))) 103
              :else 0))))))

;; The buffered `request` is implemented on top of `request-stream` now, so it has to
;; keep behaving exactly as before.
(defn check-buffered-still-works [(a (ptr alloc/Allocator))] (-> i64)
  (let [req (alloc/stack http/Request)]
    (mk-get req "http://127.0.0.1:38474/teapot" 5000)
    (match (http/request a req)
      (Err [e] 95)
      (Ok [r]
          (let [ok (and (= (http/response-status r) (primitive/cast i64 418))
                        (and (str/str-eq (http/response-body r) "short and stout")
                             (>= (http/response-header-count r) (primitive/cast i64 2))))]
            (http/response-free a r)
            (if ok 0 96))))))

(defn main [] (-> i64)
  (let [a (alloc/malloc-allocator)
        (mut rc) 0]
    (set! rc (check-streams-incrementally a))
    (when (= (load rc) (primitive/cast i64 0)) (store! rc (check-split-record a)))
    (when (= (load rc) (primitive/cast i64 0)) (store! rc (check-empty-and-single a)))
    (when (= (load rc) (primitive/cast i64 0)) (store! rc (check-binary-body a)))
    (when (= (load rc) (primitive/cast i64 0)) (store! rc (check-non-2xx a)))
    (when (= (load rc) (primitive/cast i64 0)) (store! rc (check-consumer-stop a)))
    (when (= (load rc) (primitive/cast i64 0)) (store! rc (check-timeout-after-partial a)))
    (when (= (load rc) (primitive/cast i64 0)) (store! rc (check-connect-timeout a)))
    (when (= (load rc) (primitive/cast i64 0)) (store! rc (check-connect-refused a)))
    (when (= (load rc) (primitive/cast i64 0)) (store! rc (check-disconnect-mid-body a)))
    (when (= (load rc) (primitive/cast i64 0)) (store! rc (check-repeated a)))
    (when (= (load rc) (primitive/cast i64 0)) (store! rc (check-reentrant-request a)))
    (when (= (load rc) (primitive/cast i64 0)) (store! rc (check-cancellation a)))
    (when (= (load rc) (primitive/cast i64 0)) (store! rc (check-buffered-still-works a)))
    (load rc)))
