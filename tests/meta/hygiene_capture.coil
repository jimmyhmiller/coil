(module mt.hygiene-capture)
(import "coil.primitive" :as primitive)

;;; Macro hygiene, the half where names must NOT connect. Equal display spelling
;;; is never a binding relationship, so each generated function below refers to a
;;; name that only LOOKS bound, and `coil check` must report every one of them as
;;; an unbound variable in a single run.

; 1. A reference made by one template, a binder made by another.
(defn operation [] (-> Code)
  `(primitive/iadd state 1))

; hygiene: the generated function is named so the program can call it.
(defn cross-template [] (-> Code)
  (let [name (primitive/syntax->datum (primitive/fresh-identifier "cross-template-capture"))]
    `(defn ~name [] (-> i64)
       (let [state 41]
         ~(operation)))))

(meta (cross-template))

; 2. Two independent evaluations of `'hidden` are two identifiers, not one.
(defn binder [] (-> Code)
  'hidden)

(defn reference [] (-> Code)
  'hidden)

; hygiene: the generated function is named so the program can call it.
(defn quoted-twice [] (-> Code)
  (let [name (primitive/syntax->datum (primitive/fresh-identifier "quote-capture"))]
    `(defn ~name [] (-> i64)
       (let [~(binder) 42] ~(reference)))))

(meta (quoted-twice))

; 3. A macro's template binder cannot capture a name written at the use site.
(defn with-total [(body Code)] (-> Code)
  `(let [total 40]
     ~body))

(defn use-site [] (-> i64)
  (with-total (primitive/iadd total 2)))

(defn main [] (-> i64)
  (primitive/iadd (cross-template-capture) (primitive/iadd (quote-capture) (use-site))))
