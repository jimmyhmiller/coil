(module mt_transforms_test)
(import "coil.primitive" :as primitive)
(import "coil.control" :use *)
; Two transforms over one program: `mt_addforms` emits a new top-level defn
; `the-answer` and rewrites the `(gen-answer)` marker to call it, so without the
; transform the program does not compile; `mt_identity` returns the module list
; it was handed, unchanged, and must not disturb that.
(import "mt_addforms" :use *)
(import "mt_identity")

; MACROS IN A MACRO BODY (the tower):
; - `when` as a statement (both branches i64)
; - `cond` in Code-tail position (all branches Code)
; - a Code->Code helper called WITH a Code argument stays a FUNCTION call
(defn wrap2 [(c Code)] (-> Code)
  `(do ~c ~c))

(defn dbl [(c Code)] (-> Code)
  (let [(mut n) 0]
    (when (primitive/code-int? c) (store! n (primitive/code-int c)))
    `~(primitive/imul (load n) 2)))

(defn pick [(c Code)] (-> Code)
  (cond (primitive/code-int? c) (wrap2 `1)
        (primitive/code-sym? c) `2
        `3))

;;; 42 when both hold: the tower gives dbl 21 + pick 9 + pick foo = 42 + 1 + 2,
;;; and the emitted `the-answer` gives 42. Otherwise the failing half's number.
;;; (The marker stays out of binding vectors: add-answer rebuilds the lists on
;;; the path to it, and a vector would come back as a list.)
(defn main [] (-> i64)
  (cond (!= (primitive/iadd (dbl 21) (primitive/iadd (pick 9) (pick foo))) 45) 1
        (!= (gen-answer) 42) 2
        :else 42))
