;; A Code -> Code program over a loaded, checked code base: what its `main`
;; depends on, and what depends on two of its types, from the dependency facts
;; the checker recorded as it checked each definition.
(module mt_runcodemaindeps)
(import "coil.primitive" :as primitive)
(import "coil.meta" :as meta)

(defn main [(prog Code)] (-> Code)
  `((main ~(meta/answered (meta/dependencies `mt_runcmmethods.main))) (Fd ~(meta/answered (meta/dependents `mt_runcmmethods.Fd)))
      (Fd.open ~(meta/answered (meta/dependents `(mt_runcmmethods.Fd open))))
      (Cell ~(meta/answered (meta/dependents `mt_runcmmethods.Cell)))))
