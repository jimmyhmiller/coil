(module mt_source_roundtrip)
(import "coil.primitive" :as p)
(import "coil.phase" :as phase)
(import "coil.arraylist" :use [ArrayList])
(import "coil.alloc" :use [malloc-allocator])

(defn generate-record [(record Code)] (-> Code)
  (let [(mut found) false]
    (for form record
      (if (and (p/code-list? form) (= (len form) 1)
               (p/code-eq (get form 0) `fresh-source-example))
        (set! found true) 0))
    (if (not (load found)) record
      (let [left (p/datum->syntax (p/fresh-identifier "recognizer") "private-rule")
            right (p/datum->syntax (p/fresh-identifier "recognizer") "private-rule")
            main-name (p/datum->syntax (get record 0) "main")
            (mut bytes) (ArrayList::new [u8] (malloc-allocator))]
        (for i (range 0 256) (push! (mut bytes) (cast u8 i)))
        (let [mask (p/code-str (slice (load bytes)))]
          `(~(get record 0)
            (import "coil.primitive" :as p)
            (defn ~left [] (-> i64) 20)
            (defn ~right [] (-> i64) 22)
            (defn ~main-name [] (-> i64)
              (let [bytes ~mask (mut valid) true]
                (for i (range 0 256)
                  (if (!= (get bytes i) (cast u8 i)) (set! valid false) 0))
                (if (load valid) (+ (~left) (~right)) 1)))))))))

(defn generate [(modules Code)] (-> Code)
  (let [out (p/code-list-new)]
    (for record modules (p/code-list-push! out (generate-record record)))
    `(do ~@(p/code-list-done out))))
(transform generate :phase (phase/BeforeExpand))
