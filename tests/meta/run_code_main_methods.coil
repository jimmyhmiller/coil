;; Declaration-record target: method calls on a generic library type, a generic
;; type of this module and a plain one. Its binding lists (a field `(open bool)`,
;; a parameter `(pipe i64)`) and the impl's method definition `(value …)` are
;; not calls, so they declare nothing.
(module mt_runcmmethods)
(import "coil.alloc" :use [malloc-allocator])
(import "coil.arraylist" :use [ArrayList])

(defstruct Cell [T] [(v T)])
(impl [T] (Cell T) (peek [(c (Cell T))] (-> T) (.v c)))
(defstruct Plain [(v i64)])
(impl Plain (value [(p Plain)] (-> i64) (.v p)))

(defstruct Fd [(open bool)])
(defn use-pipe [(pipe i64) (fd Fd)] (-> i64) (if (.open fd) pipe 0))

(defn main [] (-> i64)
  (let [(mut xs) (ArrayList::new [i64] (malloc-allocator))]
    (push! (mut xs) (peek (Cell :v 1)))
    (free! (mut xs))
    (use-pipe (value (Plain :v 0)) (Fd :open false))))
