(module mt_early_macro)
(import "coil.primitive" :as primitive)

;; `total` cannot be compiled until `(each …)` is expanded, since it calls what
;; that defines. So `each` is compiled early, while `total` still waits, and the
;; library functions `each` reaches by walking its arguments are checked then:
;; for the first time since the library state resolved them.
(defn each [& (names Code)] (-> Code)
  (let [(mut defs) (primitive/code-list-new)]
    (for name names
      (push! (mut defs) `(defn ~name [(n i64)] (-> i64) (+ n 1))))
    `(do ~@defs)))

(each first-of second-of)

(defn total [] (-> Code)
  `~(+ (first-of 3) (second-of 4)))

(defn main [] (-> i64)
  (println "{}" (total))
  0)
