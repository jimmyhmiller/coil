;; A Code -> Code program over a checked code base: `code-source` of the type
;; each trait method call's receiver is declared with, and what `code-decl`
;; answers for each trait a bound names. The target's trait is declared by a
;; macro, so its `Self` is an identifier of the macro's template; as source text
;; it is still spelled `Self`. It shares its name with coil.core's `Get`, and the
;; bound names the target's own.
(module mt_runcodemainspelled)
(import "coil.primitive" :as primitive)
(import "coil.meta" :as meta)

(defn receivers [(f Code) (out (mut CodeBuilder))] (-> void)
  (when (and (primitive/code-list? f) (> (len f) 0))
    (match (primitive/code-decl f)
      (primitive/Declared [_ kind _ signature]
                          (match kind
                            (primitive/MethodDecl []
                                                  (let [text (meta/source (get (get signature 0) 0))]
                                                    (push! (mut out) `~text)
                                                    0))
                            (_ 0)))
      (_ 0))
    (when (and (> (len f) 2) (= (meta/source (get f 0)) "defn*"))
      ; the type parameter vector: the one the parameter vector follows
      (for [i 1 (- (len f) 1)]
        (when (and (primitive/code-vector? (get f i)) (primitive/code-vector? (get f (+ i 1))))
          (for p (iter (get f i))
            (when (and (primitive/code-list? p) (= (len p) 2) (primitive/code-sym? (get p 1)))
              (match (primitive/code-decl (get p 1))
                (primitive/Declared [_ _ q _] (push! (mut out) q))
                (_ (push! (mut out) `unresolved))))))))
    (for child f (receivers child (mut out)))))

(defn main [(prog Code)] (-> Code)
  (let [(mut out) (primitive/code-list-new)]
    (for m prog
      (when (= (get m 0) `mt_runcmspelled)
        (for form (primitive/code-rest m) (receivers form (mut out)))))
    `(~@out)))
