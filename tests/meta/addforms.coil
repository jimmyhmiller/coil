(module mt_addforms)
(import "coil.primitive" :as primitive)

; A transform that ADDS TOP-LEVEL FORMS — the capability a GC dialect needs (emit
; a per-type `trace-T`, a runtime import, a root table). Here, minimally: for each
; user module containing a `(gen-answer)` marker, EMIT a new top-level function
; `the-answer` returning 42, into that same module, and rewrite the marker to a
; call `(the-answer)`. Without the transform, `the-answer` is undefined and the
; program does not compile — so a green build proves a real top-level defn was
; added by the metaprogram.
;
; The transform is MODULE-SHAPED: it receives ((name form…) …) and returns the
; same shape, so an emitted form is tagged with the module it names.
(import "coil.control" :use *)
(import "coil.phase" :as phase)

; does form `f` contain a (gen-answer) marker anywhere?
(defn has-gen? [(f Code)] (-> bool)
  (if (primitive/code-list? f)
      (if (and (> (primitive/code-count f) 0)
               (primitive/code-eq (primitive/code-nth f 0) `gen-answer))
          true
          (has-gen-kids? f 0 (primitive/code-count f)))
      false))

(defn has-gen-kids? [(f Code) (i i64) (n i64)] (-> bool)
  (if (>= i n)
      false
      (if (has-gen? (primitive/code-nth f i))
          true
          (has-gen-kids? f (primitive/iadd i 1) n))))

; rewrite (gen-answer) -> (the-answer); leave marker-free subtrees exactly as-is
(defn rw [(f Code) (answer Code)] (-> Code)
  (if (primitive/code-list? f)
      (if (and (> (primitive/code-count f) 0)
               (primitive/code-eq (primitive/code-nth f 0) `gen-answer))
          `(~answer)
          (if (has-gen? f) `(~@(rw-kids f 0 (primitive/code-count f) answer)) f))
      f))

(defn rw-kids [(f Code) (i i64) (n i64) (answer Code)] (-> Code)
  (if (>= i n)
      `()
      `(~(rw (primitive/code-nth f i) answer) ~@(rw-kids f
                                                         (primitive/iadd i 1)
                                                         n
                                                         answer))))

; does this module (name form…) use the marker? (idempotence: after we rewrite it
; away AND add the-answer, a second pass finds no marker and adds nothing)
(defn mod-uses-gen? [(m Code) (i i64) (n i64)] (-> bool)
  (if (>= i n)
      false
      (if (has-gen? (primitive/code-nth m i))
          true
          (mod-uses-gen? m (primitive/iadd i 1) n))))

; already has a `the-answer` defn? (don't add twice)
(defn defines-answer? [(m Code) (i i64) (n i64)] (-> bool)
  (if (>= i n)
      false
      (let [f (primitive/code-nth m i)]
        (if (and (primitive/code-list? f)
                 (and (>= (primitive/code-count f) 2)
                      (and (primitive/code-eq (primitive/code-nth f 0) `defn*)
                           (primitive/code-eq (primitive/code-nth f 1)
                                              `the-answer))))
            true
            (defines-answer? m (primitive/iadd i 1) n)))))

; rewrite a module's forms; if it used the marker and doesn't yet define the-answer,
; APPEND the new top-level defn
(defn xform-mod [(m Code)] (-> Code)
  ; hygiene: this declaration intentionally belongs to the transformed target
  ; module, so derive its context from that module's transported name syntax.
  (let [answer (primitive/datum->syntax (primitive/code-nth m 0) "the-answer")
        rewritten
          `(~(primitive/code-nth m 0) ~@(rw-kids m
                                                 1
                                                 (primitive/code-count m)
                                                 answer))]
    (if (and (mod-uses-gen? m 1 (primitive/code-count m))
             (not (defines-answer? m 1 (primitive/code-count m))))
        `(~@rewritten (defn* ~answer [] (-> i64)
                        42))
        rewritten)))

(defn xform-mods [(ms Code) (i i64) (n i64)] (-> Code)
  (if (>= i n)
      `()
      `(~(xform-mod (primitive/code-nth ms i)) ~@(xform-mods ms
                                                             (primitive/iadd i
                                                                             1)
                                                             n))))

; the first (gen-answer) marker under f, or ()
(defn marker-in [(f Code)] (-> Code)
  (cond (not (primitive/code-list? f)) `()
        (and (> (primitive/code-count f) 0)
             (primitive/code-eq (primitive/code-nth f 0) `gen-answer)) f
        :else (marker-in-kids f 0 (primitive/code-count f))))

(defn marker-in-kids [(f Code) (i i64) (n i64)] (-> Code)
  (if (>= i n)
      `()
      (let [found (marker-in (primitive/code-nth f i))]
        (if (> (primitive/code-count found) 0)
            found
            (marker-in-kids f (primitive/iadd i 1) n)))))

; The model this transform reads: while the marker is there `the-answer` is
; undefined, so the program checks only in part and the marker is where it fails;
; once the marker is rewritten the program checks.
(defn verify-model [(modules Code)] (-> i64)
  (let [marker (marker-in modules)]
    (if (> (primitive/code-count marker) 0)
        (do
          (match (primitive/model-status)
            (primitive/ModelPartial [] 0)
            (_ (primitive/error "model-status: a program that does not check is not ModelPartial")))
          (match (primitive/check-error marker)
            (primitive/FailsAt [message] (if (primitive/code-string? message) 0
                                             (primitive/error "check-error: FailsAt carries no message")))
            (primitive/ChecksClean [] (primitive/error "check-error: the marker that does not check is ChecksClean"))))
        (do
          (match (primitive/model-status)
            (primitive/ModelComplete [] 0)
            (_ (primitive/error "model-status: a program that checks is not ModelComplete")))
          (match (primitive/check-error (primitive/code-nth modules 0))
            (primitive/ChecksClean [] 0)
            (primitive/FailsAt [_] (primitive/error "check-error: a node that checks is FailsAt")))))))

(defn add-answer [(modules Code)] (-> Code)
  (verify-model modules)
  `(do ~@(xform-mods modules 0 (primitive/code-count modules))))

(transform add-answer)

; A before-expand transform that ADDS AN IMPORT: a module calling
; `thread/current-id` gets `(import "coil.thread" :as thread)`. The module it
; loads defines `current-id` through `(meta …)`, so that output must exist as if
; the import had been written by hand. Idempotent: a module that already imports
; coil.thread is left as it is.
(defn mentions? [(f Code) (name Code)] (-> bool)
  (if (primitive/code-list? f)
      (let [(mut found) false]
        (for [i 0 (primitive/code-count f)]
          (when (mentions? (primitive/code-nth f i) name)
            (set! found true)))
        found)
      (primitive/code-eq f name)))

(defn imports-thread? [(m Code)] (-> bool)
  (let [(mut found) false]
    (for [i 1 (primitive/code-count m)]
      (let [f (primitive/code-nth m i)]
        (when (and (primitive/code-list? f)
                   (and (> (primitive/code-count f) 1)
                        (and (primitive/code-eq (primitive/code-nth f 0) `import)
                             (primitive/code-eq (primitive/code-nth f 1) `"coil.thread"))))
          (set! found true))))
    found))

(defn add-thread-import [(modules Code)] (-> Code)
  (let [out (primitive/code-list-new)]
    (for [mi 0 (primitive/code-count modules)]
      (let [m (primitive/code-nth modules mi)]
        (primitive/code-list-push! out
          (if (and (mentions? m `thread/current-id) (not (imports-thread? m)))
              `(~(primitive/code-nth m 0)
                (import "coil.thread" :as thread)
                ~@(primitive/code-rest m))
              m))))
    `(do ~@(primitive/code-list-done out))))

(transform add-thread-import :phase (phase/BeforeExpand))
